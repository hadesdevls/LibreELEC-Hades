+{
+    SSL_CTX *sctx = NULL, *cctx = NULL;
+    SSL *server = NULL, *client = NULL;
+    SSL_CONNECTION *sc;
+    unsigned char discard[2048], buf;
+    uint64_t epoch_before;
+    int ret, dropped, testresult = 0;
