From 847af34ab958fa27aa593150aae7f7014b1ff14a Mon Sep 17 00:00:00 2001
From: 609bob <1850029304@qq.com>
Date: Thu, 22 Oct 2026 20:41:05 +0800
Subject: [PATCH] crypto/asn1/d2i_pr.c: fix a dangling pointer in
 d2i_PrivateKey_legacy()

Fixes: b2952366dd02 "Fix d2i_PrivateKey_ex() to work as documented"
Reviewed-by: Frederik Wedel-Heinen <fwh.openssl@gmail.com>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Merge-date: Tue Nov 24 06:10:26 2026
Merged-from: https://github.com/openssl/openssl/pull/33317
(cherry picked from commit 12eb88d98117f26aabd72dd9da2b4fdc964378ad)
---
 crypto/asn1/d2i_pr.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/crypto/asn1/d2i_pr.c b/crypto/asn1/d2i_pr.c
index 59ba8f9..df7dd6c 100644
--- a/crypto/asn1/d2i_pr.c
+++ b/crypto/asn1/d2i_pr.c
@@ -133,6 +133,8 @@ ossl_d2i_PrivateKey_legacy(int keytype, EVP_PKEY **a, const unsigned char **pp,
                 goto err;
             }
             EVP_PKEY_free(ret);
+            if (a != NULL)
+                *a = NULL;
             ret = tmp;
             ERR_pop_to_mark();
             if (EVP_PKEY_type(keytype) != EVP_PKEY_get_base_id(ret))
-- 
2.53.0

