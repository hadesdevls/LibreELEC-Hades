diff --git a/ssl/d1_lib.c b/ssl/d1_lib.c
index c5bc0ce..7ba6317 100644
--- a/ssl/d1_lib.c
+++ b/ssl/d1_lib.c
@@ -222,12 +222,23 @@ void dtls1_clear_sent_buffer(SSL_CONNECTION *s, int keep_unacked_msgs)
                 || (SSL_CONNECTION_IS_DTLS13(s)
                     && (msg_type == SSL3_MT_FINISHED
                         || msg_type == SSL3_MT_SERVER_HELLO
-                        || msg_type == SSL3_MT_KEY_UPDATE)))
+                        || msg_type == SSL3_MT_KEY_UPDATE))
+                /*
+                 * A ClientHello followed by early data. SSL3_MT_CLIENT_HELLO
+                 * has the same value as SSL3_MT_CCS, which is recorded as the
+                 * message type of a CCS, so the record type has to be checked
+                 * as well to tell the two apart. The other message types
+                 * above do not clash with anything.
+                 */
+                || (record_type == SSL3_RT_HANDSHAKE
+                    && msg_type == SSL3_MT_CLIENT_HELLO))
             && sent_msg->saved_retransmit_state.wrlmethod != NULL
             && s->rlayer.wrl != sent_msg->saved_retransmit_state.wrl) {
             /*
-             * If we're freeing the CCS then we're done with the old wrl and it
-             * can bee freed
+             * This message was the last one sent with its write record layer
+             * before the keys changed, and the record layer was kept only so
+             * that the message could be retransmitted. Now that the message
+             * is being dropped, the record layer can be freed too.
              */
             sent_msg->saved_retransmit_state.wrlmethod->free(sent_msg->saved_retransmit_state.wrl);
         }
@@ -264,6 +275,24 @@ void dtls1_clear_current_wrl_from_sent_buffer(SSL_CONNECTION *s)
     }
 }
 
+/*
+ * Returns 1 if a message in the sent_messages queue was sent with the current
+ * write record layer, which then has to be kept for retransmissions.
+ */
+int dtls1_sent_buffer_uses_current_wrl(SSL_CONNECTION *s)
+{
+    pitem *item;
+    piterator iter = pqueue_iterator(&s->d1->sent_messages);
+
+    while ((item = pqueue_next(&iter)) != NULL) {
+        dtls_sent_msg *sent_msg = (dtls_sent_msg *)item->data;
+
+        if (sent_msg->saved_retransmit_state.wrl == s->rlayer.wrl)
+            return 1;
+    }
+    return 0;
+}
+
 int dtls_any_sent_messages_are_missing_acknowledge(SSL_CONNECTION *s)
 {
     pitem *item;
diff --git a/ssl/record/rec_layer_s3.c b/ssl/record/rec_layer_s3.c
index ef7b469..80a5dc0 100644
--- a/ssl/record/rec_layer_s3.c
+++ b/ssl/record/rec_layer_s3.c
@@ -73,6 +73,17 @@ int RECORD_LAYER_reset(RECORD_LAYER *rl)
 {
     int ret;
 
+    /*
+     * Buffered DTLS messages belong to the handshake being abandoned, and
+     * may reference the write record layer that is about to be freed, such
+     * as a ClientHello when SSL_set_connect_state() is called while waiting
+     * for the server's response. Drop them first, and cancel the
+     * retransmission timer along with them so that the application is not
+     * told to keep servicing a timer that has nothing left to retransmit.
+     */
+    if (rl->s->d1 != NULL)
+        dtls1_stop_timer(rl->s);
+
     ret = RECORD_LAYER_clear(rl);
 
     /* We try and reset both record layers even if one fails */
@@ -1580,10 +1591,12 @@ int ssl_set_new_record_layer(SSL_CONNECTION *s, int version,
 
     /*
      * Free the old record layer if we have one except in the case of DTLS when
-     * writing and there are still buffered sent messages in our queue. In that
-     * case the record layer is still referenced by those buffered messages for
-     * potential retransmit. Only when those buffered messages get freed do we
-     * free the record layer object (see dtls1_hm_fragment_free)
+     * writing and buffered sent messages in our queue were sent with it. In
+     * that case the record layer is still referenced by those buffered
+     * messages for potential retransmit. Only when those buffered messages get
+     * freed do we free the record layer object (see dtls1_clear_sent_buffer).
+     * A record layer that no buffered message was sent with, such as the one
+     * for DTLS 1.3 early data, is freed straight away.
      *
      * For a DTLS 1.3 read layer, hand the old one to the new one for
      * retention instead of freeing it: a retransmission of the message that
@@ -1601,7 +1614,7 @@ int ssl_set_new_record_layer(SSL_CONNECTION *s, int version,
         }
     } else if (!SSL_CONNECTION_IS_DTLS(s)
         || direction == OSSL_RECORD_DIRECTION_READ
-        || pqueue_peek(&s->d1->sent_messages) == NULL) {
+        || !dtls1_sent_buffer_uses_current_wrl(s)) {
         if (*thismethod != NULL && !(*thismethod)->free(*thisrl)) {
             SSLfatal(s, SSL_AD_INTERNAL_ERROR, ERR_R_INTERNAL_ERROR);
             return 0;
diff --git a/ssl/ssl_local.h b/ssl/ssl_local.h
index 8f87f72..812e324 100644
--- a/ssl/ssl_local.h
+++ b/ssl/ssl_local.h
@@ -3119,6 +3119,7 @@ void dtls1_start_timer(SSL_CONNECTION *s);
 void dtls1_stop_timer(SSL_CONNECTION *s);
 __owur int dtls1_is_timer_expired(SSL_CONNECTION *s);
 void dtls1_clear_current_wrl_from_sent_buffer(SSL_CONNECTION *s);
+int dtls1_sent_buffer_uses_current_wrl(SSL_CONNECTION *s);
 __owur int dtls_raw_hello_verify_request(WPACKET *pkt, unsigned char *cookie,
