@@ -867,7 +867,14 @@ int tls13_change_cipher_state(SSL_CONNECTION *s, int which)
         if (direction == OSSL_RECORD_DIRECTION_READ)
             dtls1_clear_received_buffer(s);
 
-        dtls1_clear_sent_buffer(s, 1);
