From d8521c3f8b426f442093db2cf249d18823ea9f1f Mon Sep 17 00:00:00 2001
From: Alexandr Nedvedicky <sashan@openssl.org>
Date: Thu, 19 Nov 2026 12:41:04 +0100
Subject: [PATCH] test/radix/quic_tests.c: add corrupted version negotiation
 check

Add a test that verifies that the reception of a QUIC protocol version
negotiation packet does not abort client connection attempt.
The connection attempt must time out even if the invalid version
negotiation packet is received.  The invalid packet comes
with wrong/unexpected destination connection id.

Original-Commit: d8b4072cadf3 "test/radix/quic_tests.c: add corrupted version negotiation check"
Original-PR: https://github.com/openssl/openssl/pull/33490
References: Anthropic's OSS Scanner (finding ANT-2026-6CXTP19B)
Co-authored-by: Andrew Dinh <andrewd@openssl.org>
Reviewed-by: Neil Horman <nhorman@openssl.org>
Reviewed-by: Andrew Dinh <andrewd@openssl.org>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Merge-date: Mon Nov 23 14:02:05 2026
Merged-from: https://github.com/openssl/openssl/pull/33533
---
 include/internal/quic_channel.h |  6 ++++++
 ssl/quic/quic_channel.c         |  5 +++++
 test/radix/quic_tests.c         | 35 +++++++++++++++++++++++++++++++++
 3 files changed, 46 insertions(+)

diff --git a/include/internal/quic_channel.h b/include/internal/quic_channel.h
index aa3b335..2ae0f84 100644
--- a/include/internal/quic_channel.h
+++ b/include/internal/quic_channel.h
@@ -556,6 +556,12 @@ uint64_t ossl_quic_channel_get_path_response_count(const QUIC_CHANNEL *ch);
  * of NEW_CONNECTION_ID.
  */
 uint64_t ossl_quic_channel_get_on_new_conn_id_handled(const QUIC_CHANNEL *ch);
+/**
+ * ossl_quic_channel_get_init_dcid() is just for testing purposes
+ * @param ch pointer to channel which initial connection id is to be retrieved
+ * @returns pointer to initial destination connection id used by connect()
+ */
+const QUIC_CONN_ID *ossl_quic_channel_get_init_dcid(const QUIC_CHANNEL *ch);
 #endif
 
 #endif
diff --git a/ssl/quic/quic_channel.c b/ssl/quic/quic_channel.c
index 3717f8c..926645e 100644
--- a/ssl/quic/quic_channel.c
+++ b/ssl/quic/quic_channel.c
@@ -4432,3 +4432,8 @@ uint64_t ossl_quic_channel_get_on_new_conn_id_handled(const QUIC_CHANNEL *ch)
 {
     return ch->on_new_conn_id_handled;
 }
+
+const QUIC_CONN_ID *ossl_quic_channel_get_init_dcid(const QUIC_CHANNEL *ch)
+{
+    return &ch->init_dcid;
+}
diff --git a/test/radix/quic_tests.c b/test/radix/quic_tests.c
index 34873bb..3e50ba6 100644
--- a/test/radix/quic_tests.c
+++ b/test/radix/quic_tests.c
@@ -4073,6 +4073,40 @@ DEF_SCRIPT(new_connid_retrans, "verify remote peer ignores retransmitted NEW_CON
     OP_WRITE_B(S, "banana");
 }
 
+DEF_FUNC(corrupt_dcid)
+{
+    static QUIC_CONN_ID corrupt_dcid;
+
+    memcpy(&corrupt_dcid, init_dcid, sizeof(QUIC_CONN_ID));
+    corrupt_dcid.id[0] = corrupt_dcid.id[0] ^ 0x55;
+    init_dcid = &corrupt_dcid;
+
+    return 1;
+}
+
+DEF_SCRIPT(ver_neg_check_dcid, "version negotiation must come with matching dcid")
+{
+    OP_NEW_SSL_L_LISTEN(L);
+
+    OP_SELECT_SSL(0, L);
+    OP_FUNC(script_75_arm_version_neg);
+
+    OP_NEW_SSL_C(C);
+    OP_SELECT_SSL(0, C);
+    OP_FUNC(get_init_dcid);
+    OP_FUNC(corrupt_dcid);
+    OP_SET_PEER_ADDR_FROM(C, L);
+    OP_CONNECT_WAIT(C);
+    OP_SET_DEFAULT_STREAM_MODE(C, SSL_DEFAULT_STREAM_MODE_NONE);
+
+    OP_ACCEPT_CONN_WAIT_ND(L, S, 0);
+
+    OP_NEW_STREAM(C, Ca, 0);
+    OP_WRITE(Ca, "apple", 5);
+    OP_ACCEPT_STREAM_WAIT(S, Sa, 0);
+    OP_READ_EXPECT(Sa, "apple", 5);
+}
+
 /*
  * List of Test Scripts
  * ============================================================================
@@ -4195,4 +4229,5 @@ static SCRIPT_INFO *const scripts[] = {
     USE(script_106),
     USE(new_connid),
     USE(new_connid_retrans),
+    USE(ver_neg_check_dcid),
 };
