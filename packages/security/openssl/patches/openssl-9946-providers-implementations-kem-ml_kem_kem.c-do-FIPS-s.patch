From c2a545beaad8e9f2f0ea7f9c70ed12fe894f7b47 Mon Sep 17 00:00:00 2001
From: Nicky Mouha <nicky@mouha.be>
Date: Wed, 28 Oct 2026 11:36:16 -0400
Subject: [PATCH] providers/implementations/kem/ml_kem_kem.c: do FIPS self-test
 before context allocation

Do the FIPS self-test before context allocation in ml_kem_newctx()
to avoid leaking the allocated context in case of self-check failure,
replace OPENSSL_malloc() with OPENSSL_zalloc() to avoid leaving
entropy_buf[] uninitialized, and add a missing ossl_prov_is_running()
check.

Fixes: 40240719507c "Switch FIPS self tests to deferred execution"
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Reviewed-by: Neil Horman <nhorman@openssl.org>
Merge-date: Tue Nov 10 15:47:25 2026
Merged-from: https://github.com/openssl/openssl/pull/33437
(cherry picked from commit 8a7d94bd83570fedac86d80e0dc37b09990a6a4b)
---
 providers/implementations/kem/ml_kem_kem.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/providers/implementations/kem/ml_kem_kem.c b/providers/implementations/kem/ml_kem_kem.c
index 2d38e8c..e6e4bcd 100644
--- a/providers/implementations/kem/ml_kem_kem.c
+++ b/providers/implementations/kem/ml_kem_kem.c
@@ -49,7 +49,7 @@ static void *ml_kem_newctx(void *provctx)
 {
     PROV_ML_KEM_CTX *ctx;
 
-    if ((ctx = OPENSSL_malloc(sizeof(*ctx))) == NULL)
+    if (!ossl_prov_is_running())
         return NULL;
 
 #ifdef FIPS_MODULE
@@ -58,11 +58,7 @@ static void *ml_kem_newctx(void *provctx)
         return NULL;
 #endif
 
-    ctx->key = NULL;
-    ctx->entropy = NULL;
-    ctx->op = 0;
-    ctx->test_entropy_used = 0;
-    return ctx;
+    return OPENSSL_zalloc(sizeof(*ctx));
 }
 
 static void ml_kem_freectx(void *vctx)
