From 0996f978dc33a1271b4517c74c809de56543a051 Mon Sep 17 00:00:00 2001
From: Igor Ustinov <igus68@gmail.com>
Date: Mon, 15 Dec 2025 15:13:42 +0100
Subject: [PATCH] ssl/bio_ssl.c: report EOF on SSL BIOs after receiving
 close_notify

BIO_get_line() can consume the final line of a TLS stream
and return 0 if the line doesn't end with a newline.  After reading
close_notify, libssl doesn't read from the socket again.
Even if the peer has closed the socket, the socket BIO hasn't observed
EOF when the SSL BIO forwards BIO_eof() to it.

Backport the SSL BIO part of #29401. Record EOF
when SSL_get_error() reports SSL_ERROR_ZERO_RETURN for a read so callers
can see the clean TLS shutdown through BIO_eof().

Resolves: https://github.com/openssl/openssl/issues/33913
Original-Commit: f17230ae6c9f "Fix of EOF and retry handling in BIO implementations"
Original-PR: https://github.com/openssl/openssl/pull/29401
Reviewed-by: Tomas Mraz <tomas@openssl.foundation>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Merge-date: Tue Nov 24 19:08:02 2026
Merged-from: https://github.com/openssl/openssl/pull/33918
Upstream: https://github.com/openssl/openssl/commit/0996f978dc33a1271b4517c74c809de56543a051
---
 ssl/bio_ssl.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/ssl/bio_ssl.c b/ssl/bio_ssl.c
index dd016ff..e93738f 100644
--- a/ssl/bio_ssl.c
+++ b/ssl/bio_ssl.c
@@ -107,6 +107,7 @@ static int ssl_read(BIO *b, char *buf, size_t size, size_t *readbytes)
     ssl = sb->ssl;
 
     BIO_clear_retry_flags(b);
+    BIO_clear_flags(b, BIO_FLAGS_IN_EOF);
 
     ret = ssl_read_internal(ssl, buf, size, readbytes);
 
@@ -151,9 +152,11 @@ static int ssl_read(BIO *b, char *buf, size_t size, size_t *readbytes)
         BIO_set_retry_special(b);
         retry_reason = BIO_RR_CONNECT;
         break;
+    case SSL_ERROR_ZERO_RETURN:
+        BIO_set_flags(b, BIO_FLAGS_IN_EOF);
+        break;
     case SSL_ERROR_SYSCALL:
     case SSL_ERROR_SSL:
-    case SSL_ERROR_ZERO_RETURN:
     default:
         break;
     }
@@ -406,6 +409,11 @@ static long ssl_ctrl(BIO *b, int cmd, long num, void *ptr)
         if (!SSL_get_wpoll_descriptor(ssl, (BIO_POLL_DESCRIPTOR *)ptr))
             ret = 0;
         break;
+    case BIO_CTRL_EOF:
+        ret = BIO_test_flags(b, BIO_FLAGS_IN_EOF)
+            ? 1
+            : BIO_ctrl(SSL_get_rbio(ssl), cmd, num, ptr);
+        break;
     default:
         ret = BIO_ctrl(SSL_get_rbio(ssl), cmd, num, ptr);
         break;
