From 9a6a8b6e2c92576a151203be5eb277412c3767e4 Mon Sep 17 00:00:00 2001
From: Alexandr Nedvedicky <sashan@openssl.org>
Date: Fri, 6 Nov 2026 00:10:20 +0100
Subject: [PATCH] Do not check revocation on self-signed certificates

The change is cherry-picked from #20945.

If the trust anchor is represented by a self-signed certificate,
you're asking the CA if it has revoked itself, which isn't meaningful.

Reviewed-by: Tomas Mraz <tomas@openssl.foundation>
Reviewed-by: Andrew Dinh <andrewd@openssl.org>
Reviewed-by: Nikola Pajkovsky <nikolap@openssl.org>
Merge-date: Thu Nov 12 14:42:48 2026
Merged-from: https://github.com/openssl/openssl/pull/33567
---
 crypto/x509/x509_vfy.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/crypto/x509/x509_vfy.c b/crypto/x509/x509_vfy.c
index 091c153..c269b0a 100644
--- a/crypto/x509/x509_vfy.c
+++ b/crypto/x509/x509_vfy.c
@@ -1074,6 +1074,9 @@ static int check_cert(X509_STORE_CTX *ctx)
     ctx->current_crl_score = 0;
     ctx->current_reasons = 0;
 
+    /* skip if cert is apparently self-signed */
+    if (ctx->current_cert->ex_flags & EXFLAG_SS)
+        return 1;
     if ((x->ex_flags & EXFLAG_PROXY) != 0)
         return 1;
 
