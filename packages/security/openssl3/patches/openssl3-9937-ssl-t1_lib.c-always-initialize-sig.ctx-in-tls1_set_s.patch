From 3ee6f9bc5c17189c86999b3730239fde1f0c4556 Mon Sep 17 00:00:00 2001
From: "Dailey, Alaric" <alaricd@pengdows.com>
Date: Sat, 7 Nov 2026 06:56:44 -0600
Subject: [PATCH] ssl/t1_lib.c: always initialize sig.ctx in
 tls1_set_sigalgs_list()

Always initialize the ctx field in the sig argument for the sig_cb()
signature algorithm configuration parser callback, including
when syntax is checked without an SSL_CTX.  This prevents sig_cb()
from reading an uninitialized pointer while preserving the built-in
algorithm lookup for syntax-only checks.

Resolves: https://github.com/openssl/openssl/issues/33563
Fixes: 4169d58c8557 "Allow provider sigalgs in SignatureAlgorithms conf"
Assisted-by: ChatGPT:gpt-6
Reviewed-by: Nikola Pajkovsky <nikolap@openssl.org>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Merge-date: Tue Nov 10 14:11:01 2026
Merged-from: https://github.com/openssl/openssl/pull/33593
(cherry picked from commit c02973aa85b973de3f702566f48d31be17e54c7b)
---
 ssl/t1_lib.c      |  4 +---
 test/sslapitest.c | 25 +++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/ssl/t1_lib.c b/ssl/t1_lib.c
index ef11141..2b77c82 100644
--- a/ssl/t1_lib.c
+++ b/ssl/t1_lib.c
@@ -3792,9 +3792,7 @@ int tls1_set_sigalgs_list(SSL_CTX *ctx, CERT *c, const char *str, int client)
 {
     sig_cb_st sig;
     sig.sigalgcnt = 0;
-
-    if (ctx != NULL)
-        sig.ctx = ctx;
+    sig.ctx = ctx;
     if (!CONF_parse_list(str, ':', 1, sig_cb, &sig))
         return 0;
     if (sig.sigalgcnt == 0) {
diff --git a/test/sslapitest.c b/test/sslapitest.c
index 250fc09..0fd4d27 100644
--- a/test/sslapitest.c
+++ b/test/sslapitest.c
@@ -14758,6 +14758,30 @@ err:
 }
 #endif
 
+static int test_ssl_conf_sigalgs_without_ctx(void)
+{
+    SSL_CONF_CTX *cctx = NULL;
+    int ret = 0;
+
+    if (!TEST_ptr(cctx = SSL_CONF_CTX_new()))
+        goto err;
+    if (!TEST_uint_eq(SSL_CONF_CTX_set_flags(cctx,
+                          SSL_CONF_FLAG_CMDLINE | SSL_CONF_FLAG_CLIENT),
+            SSL_CONF_FLAG_CMDLINE | SSL_CONF_FLAG_CLIENT))
+        goto err;
+    if (!TEST_int_eq(SSL_CONF_cmd(cctx, "-sigalgs", "RSA+SHA256"), 2)
+        || !TEST_int_eq(SSL_CONF_cmd(cctx, "-client_sigalgs",
+                            "rsa_pss_rsae_sha256"),
+            2))
+        goto err;
+
+    ret = 1;
+
+err:
+    SSL_CONF_CTX_free(cctx);
+    return ret;
+}
+
 /*
  * Test that SSL_CTX_set1_groups() when called with a list where the first
  * entry is unsupported, will send a key_share that uses the next usable entry.
@@ -15219,6 +15243,7 @@ int setup_tests(void)
         ADD_TEST(test_ssl_trace);
 #endif
     ADD_ALL_TESTS(test_ssl_set_groups_unsupported_keyshare, 2);
+    ADD_TEST(test_ssl_conf_sigalgs_without_ctx);
     ADD_ALL_TESTS(test_http_verbs, 3);
     return 1;
 
