From 0a57eaff260dc4517de2d259fcd7c54eb04148c3 Mon Sep 17 00:00:00 2001
From: Kron Kastrati <kronkastrati900@gmail.com>
Date: Tue, 3 Nov 2026 12:28:25 +0100
Subject: [PATCH] crypto/x509/x_attrib.c: print INTEGER attribute values in
 decimal

ossl_print_attribute_value() handled V_ASN1_INTEGER
and V_ASN1_ENUMERATED in a shared case using
ASN1_ENUMERATED_get_int64(), which rejects INTEGERs.  INTEGER attribute
values therefore fell back to hex of the unsigned magnitude, dropping
the sign, and left a "wrong integer type" error on the error queue.
Use the getter that matches the value's type.

Add a test certificate with positive and negative INTEGER subject
directory attributes, and update the existing attributeMappings
expectation, whose INTEGER localityName value is now printed as 830
instead of 03:3E.

Resolves: https://github.com/openssl/openssl/issues/33425
Fixes: 41c1b6f0a549 "ossl_print_attribute_value(): Multiple minor fixes for style and other errors"
Reviewed-by: Nikola Pajkovsky <nikolap@openssl.org>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Merge-date: Fri Nov  6 03:49:51 2026
Merged-from: https://github.com/openssl/openssl/pull/33509
(cherry picked from commit 674760c25dba6337c88ebf26484ca4a301e0c728)
---
 crypto/x509/x_attrib.c                               | 12 +++++++++---
 .../certs/ext-subjectDirectoryAttributes-integer.pem |  9 +++++++++
 test/recipes/25-test_x509.t                          | 12 ++++++++++--
 3 files changed, 28 insertions(+), 5 deletions(-)
 create mode 100644 test/certs/ext-subjectDirectoryAttributes-integer.pem

diff --git a/crypto/x509/x_attrib.c b/crypto/x509/x_attrib.c
index f4c225a..b47b99d 100644
--- a/crypto/x509/x_attrib.c
+++ b/crypto/x509/x_attrib.c
@@ -93,15 +93,21 @@ int ossl_print_attribute_value(BIO *out,
         }
 
     case V_ASN1_INTEGER:
-    case V_ASN1_ENUMERATED:
         if (BIO_printf(out, "%*s", indent, "") < 0)
             return 0;
-        if (ASN1_ENUMERATED_get_int64(&int_val, av->value.integer) > 0) {
+        if (ASN1_INTEGER_get_int64(&int_val, av->value.integer) > 0)
             return BIO_printf(out, "%lld", (long long int)int_val) > 0;
-        }
         str = av->value.integer;
         return ossl_bio_print_hex(out, str->data, str->length);
 
+    case V_ASN1_ENUMERATED:
+        if (BIO_printf(out, "%*s", indent, "") < 0)
+            return 0;
+        if (ASN1_ENUMERATED_get_int64(&int_val, av->value.enumerated) > 0)
+            return BIO_printf(out, "%lld", (long long int)int_val) > 0;
+        str = av->value.enumerated;
+        return ossl_bio_print_hex(out, str->data, str->length);
+
     case V_ASN1_BIT_STRING:
         if (BIO_printf(out, "%*s", indent, "") < 0)
             return 0;
