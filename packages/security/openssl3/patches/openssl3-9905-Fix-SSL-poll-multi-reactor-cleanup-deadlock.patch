     QUIC_REACTOR *rtor;
@@ -5430,7 +5431,7 @@ void ossl_quic_leave_blocking_section(SSL *ssl, QUIC_REACTOR_WAIT_CTX *wctx)
 
     qctx_lock(&ctx);
     rtor = ossl_quic_obj_get0_reactor(ctx.obj);
-    ossl_quic_reactor_wait_ctx_leave(wctx, rtor);
