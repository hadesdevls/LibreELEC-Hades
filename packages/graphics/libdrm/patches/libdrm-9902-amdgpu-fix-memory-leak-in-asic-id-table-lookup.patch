From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flora Cui <flora.cui@amd.com>
Date: Tue, 27 Oct 2026 14:41:24 +0800
Subject: [PATCH] amdgpu: fix memory leak in ASIC ID table lookup

Signed-off-by: Flora Cui <flora.cui@amd.com>
---
 amdgpu/amdgpu_asic_id.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/amdgpu/amdgpu_asic_id.c b/amdgpu/amdgpu_asic_id.c
index d39e8dc..29f0db3 100644
--- a/amdgpu/amdgpu_asic_id.c
+++ b/amdgpu/amdgpu_asic_id.c
@@ -396,6 +396,7 @@ static char *find_asic_id_table(void)
 			found_path = full_path;
 			break;
 		}
+		free(full_path);
 	}
 	split_env_var_free(paths);
 	return found_path;
