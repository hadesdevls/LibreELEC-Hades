From e221de71aa52c46d11b8dc04a319fb92fb30f8b3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 02:34:39 +0000
Subject: [PATCH] modetest: open a device by the path of its node

A device is named to the test programs by its driver (-M), which opens
the first device of that driver, or by its bus id (-D), which the
kernel tells only to the DRM master of a device (the id is set by
DRM_IOCTL_SET_VERSION, a master-only request). On a machine with two
devices of one driver, such as a laptop with an AMD processor and an
AMD graphics card, the second one cannot be listed by its driver; and
while a compositor or a media player is the master of a device, it
cannot be opened by its bus id either.

-D /dev/dri/card1 now opens that node, whatever -M says, and refuses a
file that is no KMS device (the lines that follow would read the
version of a driver that it does not have). Everything else is as it
was: a name that does not start with a slash is a bus id.
---
 tests/util/kms.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/tests/util/kms.c b/tests/util/kms.c
index 5c66da3..d6729e3 100644
--- a/tests/util/kms.c
+++ b/tests/util/kms.c
@@ -103,7 +103,23 @@ int util_open(const char *device, const char *module)
 	int fd = -1;
 	drmVersionPtr version;
 
-	if (module || device) {
+	if (device && device[0] == '/') {
+		/* The node of a device, as in /dev/dri/card1. A device can be named by its
+		 * driver, which gives the first one of that driver, or by its bus id, which
+		 * only its DRM master can ask for: neither opens the second of two devices of
+		 * one driver while something else drives it. */
+		fd = open(device, O_RDWR | O_CLOEXEC);
+		if (fd < 0) {
+			fprintf(stderr, "failed to open device '%s': %s\n",
+				device, strerror(errno));
+			return -errno;
+		}
+		if (!drmIsKMS(fd)) {
+			fprintf(stderr, "'%s' is not a KMS device\n", device);
+			close(fd);
+			return -ENODEV;
+		}
+	} else if (module || device) {
 		fd = drmOpen(module, device);
 		if (fd < 0) {
 			fprintf(stderr, "failed to open device '%s' with busid '%s': %s\n",
