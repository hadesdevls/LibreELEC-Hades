From 0342cc2b836e6b8b392826a705d66b0f0e864852 Mon Sep 17 00:00:00 2001
From: nussaibah shaikh <nussaibah@bugqore.com>
Date: Mon, 23 Nov 2026 18:38:23 +0530
Subject: [PATCH] Clamp instanced glyf coordinates before integer conversion
 (#6887)

When instancing a TrueType variable font, the glyf subsetter
re-encodes each glyph's gvar-shifted points, component offsets and
phantom metrics by converting the float coordinate straight to an
integer. gvar deltas are unbounded (int16 WORD or int32 LONGS runs
summed in float), so a pinned axis can push a coordinate past the
destination integer range. That float-to-integer conversion is
undefined behavior (UBSan float-cast-overflow).

CompositeGlyphRecord::compile_with_point writes the WORD component
offset to int16 and the byte-branch value to int;
SimpleGlyph::compile_bytes_with_deltas converts each point to int
before delta encoding; Glyph::update_mtx converts the phantom-derived
advances and side bearings. A spec-legal 16-bit offset of 30000 plus
a 10000 delta already overflows the int16 cast; the int sites need a
32-bit LONGS delta, which the gvar decoder accepts.

Clamp each conversion with hb_clamp_to, the same idiom the
cvar/MVAR/hmtx instancer paths already use. For valid fonts every
coordinate is well within range, so the clamp is a no-op and instanced
output is byte-identical (verified across several in-tree variable
fonts at multiple pins).

Reached from hb_subset_or_fail with an axis pinned away from its
default. Added a regression test that instances a crafted font which
triggers all four sites; it aborts under the asan-ubsan CI job without
the fix and passes with it. Full meson test suite passes under ASan
and UBSan.

[Hades: backport to 15.2.0 of the src/ part only. Upstream's regression
test instances a crafted binary font (test/api/fonts/glyf-instance-coord-
overflow.ttf, made by a generator script in the same commit) and is not
carried: the image does not build HarfBuzz's tests and binary files are
not carried in patches. The clamps are self-contained: hb_clamp_to<>
exists in 15.2.0 and is what the cvar/MVAR/hmtx instancer paths already
use.]

Upstream: https://github.com/harfbuzz/harfbuzz/commit/0342cc2b836e6b8b392826a705d66b0f0e864852
---
 src/OT/glyf/CompositeGlyph.hh | 8 ++++----
 src/OT/glyf/Glyph.hh          | 8 ++++----
 src/OT/glyf/SimpleGlyph.hh    | 4 ++--
 3 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/src/OT/glyf/CompositeGlyph.hh b/src/OT/glyf/CompositeGlyph.hh
index 60a9053..39086d6 100644
--- a/src/OT/glyf/CompositeGlyph.hh
+++ b/src/OT/glyf/CompositeGlyph.hh
@@ -168,13 +168,13 @@ struct CompositeGlyphRecord
       hb_memcpy (out, this, len);
 
       HBINT16 *o = reinterpret_cast<HBINT16 *> (out + len_before_val);
-      o[0] = roundf (point.x);
-      o[1] = roundf (point.y);
+      o[0] = hb_clamp_to<int16_t> (roundf (point.x));
+      o[1] = hb_clamp_to<int16_t> (roundf (point.y));
     }
     else
     {
-      int new_x = roundf (point.x);
-      int new_y = roundf (point.y);
+      int new_x = hb_clamp_to<int16_t> (roundf (point.x));
+      int new_y = hb_clamp_to<int16_t> (roundf (point.y));
       if (new_x <= 127 && new_x >= -128 &&
           new_y <= 127 && new_y >= -128)
       {
diff --git a/src/OT/glyf/Glyph.hh b/src/OT/glyf/Glyph.hh
index cb44cce..17c855e 100644
--- a/src/OT/glyf/Glyph.hh
+++ b/src/OT/glyf/Glyph.hh
@@ -159,17 +159,17 @@ struct Glyph
 
     uint32_t hash = hb_hash (new_gid);
 
-    signed hori_aw = roundf (rightSideX - leftSideX);
+    signed hori_aw = hb_clamp_to<int> (roundf (rightSideX - leftSideX));
     if (hori_aw < 0) hori_aw = 0;
-    int lsb = roundf (xMin - leftSideX);
+    int lsb = hb_clamp_to<int> (roundf (xMin - leftSideX));
     plan->hmtx_map.set_with_hash (new_gid, hash, hb_pair ((unsigned) hori_aw, lsb));
     //flag value should be computed using non-empty glyphs
     if (type != EMPTY && lsb != xMin)
       plan->head_maxp_info.allXMinIsLsb = false;
 
-    signed vert_aw = roundf (topSideY - bottomSideY);
+    signed vert_aw = hb_clamp_to<int> (roundf (topSideY - bottomSideY));
     if (vert_aw < 0) vert_aw = 0;
-    int tsb = roundf (topSideY - yMax);
+    int tsb = hb_clamp_to<int> (roundf (topSideY - yMax));
     plan->vmtx_map.set_with_hash (new_gid, hash, hb_pair ((unsigned) vert_aw, tsb));
   }
 
diff --git a/src/OT/glyf/SimpleGlyph.hh b/src/OT/glyf/SimpleGlyph.hh
index 1f51a6c..5b5573f 100644
--- a/src/OT/glyf/SimpleGlyph.hh
+++ b/src/OT/glyf/SimpleGlyph.hh
@@ -301,8 +301,8 @@ struct SimpleGlyph
       unsigned flag = all_points.arrayZ[i].flag;
       flag &= FLAG_ON_CURVE | FLAG_OVERLAP_SIMPLE | FLAG_CUBIC;
 
-      int cur_x = roundf (all_points.arrayZ[i].x);
-      int cur_y = roundf (all_points.arrayZ[i].y);
+      int cur_x = hb_clamp_to<int16_t> (roundf (all_points.arrayZ[i].x));
+      int cur_y = hb_clamp_to<int16_t> (roundf (all_points.arrayZ[i].y));
       encode_coord (cur_x - prev_x, flag, FLAG_X_SHORT, FLAG_X_SAME, x_coords);
       encode_coord (cur_y - prev_y, flag, FLAG_Y_SHORT, FLAG_Y_SAME, y_coords);
       encode_flag (flag, repeat, lastflag, flags);
