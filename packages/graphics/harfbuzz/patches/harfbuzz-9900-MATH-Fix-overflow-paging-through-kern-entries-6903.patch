From ccd51c226931148469b8c9f7c38b2add5cfd31d5 Mon Sep 17 00:00:00 2001
From: Behdad Esfahbod <behdad@behdad.org>
Date: Tue, 24 Nov 2026 16:27:04 -0600
Subject: [PATCH] [MATH] Fix overflow paging through kern entries (#6903)

MathKern::get_entries() clamped the caller's count by hand:

  end = hb_min (start + *entries_count, entriesCount);
  *entries_count = end - start;

start + *entries_count overflows for a large count with a non-zero
start.  end then comes out below start, and the count that comes out
of the subtraction is the one the caller passed: more than what is
there.  The loop runs that many times, reading past the table and
writing past the caller's array.

Page the kern values through hb_array_t::sub_array() instead, as the
other paged getters do.  It clamps the count without the addition, so
no overflow check of its own is left in the function.

Only a count within 65536 of UINT_MAX can do this.  A caller has to
have memory for whatever count it passes, so such a count overstates
the capacity of its array and is not a sensible call.  The bug is
there all the same.

The other two MATH getters, of glyph variants and of assembly parts,
already page through sub_array(), and nothing else in
hb-ot-math-table.hh pages by hand.

Testing: the new test-ot-math case passes a count of UINT_MAX, which
sets the overflow off, at every offset from zero to past the end, with
an array sized from the total.  It checks that the count comes back as
what is left, that the entries are the tail of what a start_offset of
zero returns, and that the rest of the array is not written.  Without
the fix it crashes at start_offset 1, where valgrind reports a write
past the end of the array.

Co-authored-by: Claude Fable 5.2 <noreply@anthropic.com>
Upstream: https://github.com/harfbuzz/harfbuzz/commit/ccd51c226931148469b8c9f7c38b2add5cfd31d5
---
 src/hb-ot-math-table.hh | 10 +++----
 test/api/test-ot-math.c | 61 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 65 insertions(+), 6 deletions(-)

diff --git a/src/hb-ot-math-table.hh b/src/hb-ot-math-table.hh
index 326bbd0..3cf0f43 100644
--- a/src/hb-ot-math-table.hh
+++ b/src/hb-ot-math-table.hh
@@ -425,12 +425,10 @@ struct MathKern
 
     if (entries_count && kern_entries)
     {
-      unsigned int start = hb_min (start_offset, entriesCount);
-      unsigned int end = hb_min (start + *entries_count, entriesCount);
-      *entries_count = end - start;
+      auto kerns = hb_array (kernValue, entriesCount).sub_array (start_offset, entries_count);
 
-      for (unsigned int i = 0; i < *entries_count; i++) {
-	unsigned int j = start + i;
+      for (unsigned int i = 0; i < kerns.length; i++) {
+	unsigned int j = start_offset + i;
 
 	hb_position_t max_height;
 	if (j == heightCount) {
@@ -439,7 +437,7 @@ struct MathKern
 	  max_height = correctionHeight[j].get_y_value (font, this);
 	}
 
-	kern_entries[i] = {max_height, kernValue[j].get_x_value (font, this)};
+	kern_entries[i] = {max_height, kerns[i].get_x_value (font, this)};
       }
     }
     return entriesCount;
diff --git a/test/api/test-ot-math.c b/test/api/test-ot-math.c
index b661c1f..4b98724 100644
--- a/test/api/test-ot-math.c
+++ b/test/api/test-ot-math.c
@@ -415,6 +415,66 @@ test_get_glyph_kernings (void)
   hb_face_destroy (face);
 }
 
+/* The getter clamps the count to the entries left from the offset.  With a
+ * non-zero offset, a count large enough overflowed that clamp.  UINT_MAX is
+ * such a count.  It overstates the capacity of the array, which is sized from
+ * the total, so it is not a call to make: it is only what sets the overflow
+ * off. */
+static void
+test_get_glyph_kernings_from_offset (void)
+{
+  hb_face_t *face = hb_test_open_font_file ("fonts/MathTestFontFull.otf");
+  hb_font_t *font = hb_font_create (face);
+  hb_codepoint_t glyph;
+  hb_ot_math_kern_entry_t *all, *page;
+  unsigned int total, count;
+
+  hb_font_set_scale (font, 2000, 1000);
+  g_assert_true (hb_font_get_glyph_from_name (font, "I", -1, &glyph));
+
+  total = hb_ot_math_get_glyph_kernings (font, glyph, HB_OT_MATH_KERN_TOP_RIGHT, 0, NULL, NULL);
+  g_assert_cmpuint (total, ==, 10);
+  all = (hb_ot_math_kern_entry_t *) malloc (total * sizeof (all[0]));
+  page = (hb_ot_math_kern_entry_t *) malloc (total * sizeof (page[0]));
+
+  count = total;
+  g_assert_cmpuint (hb_ot_math_get_glyph_kernings (font, glyph, HB_OT_MATH_KERN_TOP_RIGHT,
+						   0, &count, all), ==, total);
+  g_assert_cmpuint (count, ==, total);
+
+  for (unsigned int start_offset = 0; start_offset <= total + 1; start_offset++)
+  {
+    unsigned int left = start_offset < total ? total - start_offset : 0;
+
+    for (unsigned int i = 0; i < total; i++)
+      page[i].max_correction_height = page[i].kern_value = -1;
+    count = (unsigned int) -1;
+    g_assert_cmpuint (hb_ot_math_get_glyph_kernings (font, glyph, HB_OT_MATH_KERN_TOP_RIGHT,
+						     start_offset, &count, page), ==, total);
+    g_assert_cmpuint (count, ==, left);
+    for (unsigned int i = 0; i < left; i++)
+    {
+      g_assert_cmpint (page[i].max_correction_height, ==, all[start_offset + i].max_correction_height);
+      g_assert_cmpint (page[i].kern_value, ==, all[start_offset + i].kern_value);
+    }
+    for (unsigned int i = left; i < total; i++)
+    {
+      g_assert_cmpint (page[i].max_correction_height, ==, -1);
+      g_assert_cmpint (page[i].kern_value, ==, -1);
+    }
+  }
+
+  count = (unsigned int) -1;
+  g_assert_cmpuint (hb_ot_math_get_glyph_kernings (font, glyph, HB_OT_MATH_KERN_TOP_RIGHT,
+						   (unsigned int) -1, &count, page), ==, total);
+  g_assert_cmpuint (count, ==, 0);
+
+  free (all);
+  free (page);
+  hb_font_destroy (font);
+  hb_face_destroy (face);
+}
+
 
 static hb_position_t
 get_glyph_assembly_italics_correction (hb_font_t *font,
@@ -846,6 +906,7 @@ main (int argc, char **argv)
   hb_test_add (test_is_glyph_extended_shape);
   hb_test_add (test_get_glyph_kerning);
   hb_test_add (test_get_glyph_kernings);
+  hb_test_add (test_get_glyph_kernings_from_offset);
   hb_test_add (test_get_glyph_assembly_italics_correction);
   hb_test_add (test_get_min_connector_overlap);
   hb_test_add (test_get_glyph_variants);
