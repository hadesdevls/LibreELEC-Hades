From 4eb2586a1951fc81123e56b78471ac734bc7e426 Mon Sep 17 00:00:00 2001
From: waugustus <wangdw.augustus@qq.com>
Date: Fri, 24 Jul 2026 12:16:09 +0800
Subject: [PATCH] Harden public raw multiplication overflow cases

(cherry picked from commit 4eb2586a1951fc81123e56b78471ac734bc7e426)
---
 libtiff/tif_color.c    |  9 ++++++++-
 libtiff/tif_dirwrite.c | 30 ++++++++++++++--------------
 libtiff/tif_ojpeg.c    | 30 ++++++++++++++++++++++------
 libtiff/tif_read.c     | 27 ++++++++++++++++++++++++--
 tools/tiff2bw.c        | 44 ++++++++++++++++++++++++++----------------
 tools/tiff2ps.c        |  3 +++
 tools/tiffcrop.c       |  9 +++++++--
 7 files changed, 110 insertions(+), 42 deletions(-)

diff --git a/libtiff/tif_color.c b/libtiff/tif_color.c
index 4a17914..52f5afe 100644
--- a/libtiff/tif_color.c
+++ b/libtiff/tif_color.c
@@ -40,10 +40,17 @@
 /*
  * Convert color value from the CIE L*a*b* 1976 space to CIE XYZ.
  */
+TIFF_NOSANITIZE_UNSIGNED_INT_OVERFLOW
 void TIFFCIELabToXYZ(TIFFCIELabToRGB *cielab, uint32_t l, int32_t a, int32_t b,
                      float *X, float *Y, float *Z)
 {
-    TIFFCIELab16ToXYZ(cielab, l * 257, a * 256, b * 256, X, Y, Z);
+    /*
+     * Keep the historical signed a * 256 and b * 256 scaling. Out-of-range
+     * callers may trigger UBSan signed-overflow reports here, but this
+     * per-pixel path intentionally does not add extra handling; see !926 for
+     * details.
+     */
+    TIFFCIELab16ToXYZ(cielab, l * 257U, a * 256, b * 256, X, Y, Z);
 }
 
