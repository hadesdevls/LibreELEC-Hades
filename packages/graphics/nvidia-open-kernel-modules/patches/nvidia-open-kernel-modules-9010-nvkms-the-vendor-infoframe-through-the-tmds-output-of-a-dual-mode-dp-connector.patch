+/*
+ * Decisions of the Hades changes to NVKMS, on plain values, so that a host
+ * test can run them (nvkms-hades-test.c of the Hades tree runs every case).
+ */
+
+#ifndef __NVKMS_HADES_H__
+#define __NVKMS_HADES_H__
+
+#include "nvtypes.h"
+
+/*
+ * Whether a vendor-specific InfoFrame that a client gives (HDMI VSIF
+ * metadata) can go out through a connector.
+ *
+ * On an HDMI connector, as before. On a DisplayPort connector, only through
+ * its TMDS output (a dual-mode port: the display table of the board has a
+ * TMDS output of the GPU for that connector, as well as its DisplayPort one)
+ * and only while that output drives an HDMI sink: the DisplayPort library
+ * does not drive it, and the display takes HDMI InfoFrames. On the
+ * DisplayPort output of the same connector no vendor InfoFrame goes out.
+ */
+static inline NvBool nvHadesVsifOnConnector(NvBool hdmiConnector,
+                                            NvBool dpConnector,
+                                            NvBool tmdsSignal,
+                                            NvBool usesDpLib,
+                                            NvBool hdmiSink)
+{
+    if (hdmiConnector) {
+        return NV_TRUE;
+    }
+    return dpConnector && tmdsSignal && !usesDpLib && hdmiSink;
+}
+
+#endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/src/nvkms-hw-flip.c b/src/nvidia-modeset/src/nvkms-hw-flip.c
index bd65888..eab9957 100644
--- a/src/nvidia-modeset/src/nvkms-hw-flip.c
+++ b/src/nvidia-modeset/src/nvkms-hw-flip.c
@@ -41,6 +41,8 @@
 #include "nvkms-sync.h"
 
 #include "nvkms-difr.h"
+#include "nvkms-hdmi.h"
+#include "nvkms-hades.h"
 
 static void SchedulePostFlipIMPTimer(NVDevEvoPtr pDevEvo);
 
@@ -1891,6 +1893,33 @@ static NvBool ValidateColorPassthroughFlipState(const NVDevEvoRec *pDevEvo,
     return TRUE;
 }
 
+/*
+ * Hades: whether the vendor InfoFrame of the client can go out through
+ * pConnectorEvo: an HDMI connector, or the TMDS output of a dual-mode
+ * DisplayPort connector while it drives an HDMI sink (nvHadesVsifOnConnector()).
+ * The static dpy of a connector has the display ID of the connector.
+ */
+static NvBool HdmiVsifConnector(const NVConnectorEvoRec *pConnectorEvo)
+{
+    const NVDpyEvoRec *pDpyEvo = NULL;
+    const NvBool tmdsDp =
+        (pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP) &&
+        (pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS) &&
+        !nvConnectorUsesDPLib(pConnectorEvo);
+
+    if (tmdsDp) {
+        pDpyEvo = nvGetDpyEvoFromDispEvo(pConnectorEvo->pDispEvo,
+                                         pConnectorEvo->displayId);
+    }
+
+    return nvHadesVsifOnConnector(
+        pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_HDMI,
+        pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP,
+        pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS,
+        nvConnectorUsesDPLib(pConnectorEvo),
+        (pDpyEvo != NULL) && nvDpyIsHdmiEvo(pDpyEvo));
+}
+
 static NvBool ValidateHdmiVsif(const NVDevEvoRec *pDevEvo,
                                const NvU32 head,
                                const NVFlipEvoHwState *pFlipState,
@@ -1898,7 +1927,7 @@ static NvBool ValidateHdmiVsif(const NVDevEvoRec *pDevEvo,
 {
     if (pFlipState->hdmiVsifMetadata.payloadSize != 0) {
         if ((pConnectorEvo == NULL) ||
-            (pConnectorEvo->type != NVKMS_CONNECTOR_TYPE_HDMI)) {
+            !HdmiVsifConnector(pConnectorEvo)) {
             return FALSE;
         }
         /* Prevent HDR + VSIF when both infoframes can't be sent simultaneously. */
