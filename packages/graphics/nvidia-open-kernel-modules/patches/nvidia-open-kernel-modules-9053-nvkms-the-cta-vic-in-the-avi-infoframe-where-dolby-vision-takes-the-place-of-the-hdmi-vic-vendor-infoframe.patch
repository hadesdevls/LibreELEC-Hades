diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 4ef85d8..cbe1d83 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -556,13 +556,20 @@ static NvBool HdmiDolbyLowLatencyAvi(const struct NvKmsHdmiVsifMetadata *pVsif,
     return TRUE;
 }
 
-static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
-                                     const NvU32 head,
-                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
-                                     const NVT_EDID_INFO *pEdidInfo);
+static NvU32 HadesAviCtaVic(const NVDispEvoRec *pDispEvo,
+                            const NvU32 head,
+                            const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                            const NVT_EDID_INFO *pEdidInfo,
+                            NvBool *pDolby);
 static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
                                const NvU32 head,
-                               NvU32 ctaVic);
+                               NvU32 ctaVic,
+                               NvBool dolby);
+static void HadesLogDolbyHdmiVic(const NVDispEvoRec *pDispEvo,
+                                 const NvU32 head,
+                                 const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                 const NVT_EDID_INFO *pEdidInfo,
+                                 NvU32 ctaVic);
 
 /*
  * SendVideoInfoFrame() - Construct video infoframe using provided EDID and call
@@ -627,14 +634,18 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
 
     /*
      * Hades: HDR10+ in a mode that NVKMS signals by its HDMI_VIC, where the HAL
-     * has no generic shared InfoFrames: the AVI InfoFrame carries the CTA VIC
-     * of the mode (nvHadesHdr10PlusAviCtaVic()), as it does for that CTA mode.
+     * has no generic shared InfoFrames, and Dolby Vision in such a mode on
+     * every HAL: the AVI InfoFrame carries the CTA VIC of the mode
+     * (nvHadesHdr10PlusAviCtaVic(), nvHadesDolbyAviCtaVic()), as it does for
+     * that CTA mode.
      */
-    if (!pDevEvo->caps.supportsGenericSharedInfoFrames) {
+    {
+        NvBool dolby;
         const NvU32 ctaVic =
-            HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+            HadesAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo, &dolby);
 
-        HadesKeepAviCtaVic(pDispEvo, head, ctaVic);
+        HadesKeepAviCtaVic(pDispEvo, head, ctaVic, dolby);
+        HadesLogDolbyHdmiVic(pDispEvo, head, pInfoFrameState, pEdidInfo, ctaVic);
         if (ctaVic != 0) {
             videoCtrl.video_format_id = ctaVic;
             if (nvHadesCtaVicAspectNoData(ctaVic)) {
@@ -858,21 +869,128 @@ static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
                                    pHeadState->timings.pixelClock));
 }
 
+/* Hades: the HDMI_VIC of NVKMS's own vendor InfoFrame of the head (1 to 4), or 0 */
+static NvU32 HadesOwnHdmiVic(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState)
+{
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pVendor =
+        &pInfoFrameState->vendorSpecificCtrl;
+
+    return (pVendor->Enable &&
+            (pVendor->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_EXT)) ?
+        pVendor->HDMI_VIC : 0;
+}
+
+/* Hades: the client's vendor InfoFrame of the head is a Dolby one */
+static NvBool HadesDolbyVsifOn(const NVDispHeadStateEvoRec *pHeadState)
+{
+    return (pHeadState->hdmiVsifMetadata.payloadSize != 0) &&
+           nvHadesIsDolbyVsif(pHeadState->hdmiVsifMetadata.payload,
+                              pHeadState->hdmiVsifMetadata.payloadSize);
+}
+
+/*
+ * Hades: the CTA VIC that the AVI InfoFrame of an HDMI head carries in a mode
+ * that NVKMS signals by its HDMI_VIC: for HDR10+ where the HAL has no generic
+ * shared InfoFrames (HadesHdr10PlusAviCtaVic()), or else for Dolby Vision, on
+ * every HAL (nvHadesDolbyAviCtaVic()); 0 for the VIC that NVKMS puts there.
+ * *pDolby says that it is the one of Dolby Vision.
+ */
+static NvU32 HadesAviCtaVic(const NVDispEvoRec *pDispEvo,
+                            const NvU32 head,
+                            const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                            const NVT_EDID_INFO *pEdidInfo,
+                            NvBool *pDolby)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pHeadState->hdmiVsifMetadata;
+    const NvU32 hdr10Plus =
+        HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+    const NvU32 ownHdmiVic = HadesOwnHdmiVic(pInfoFrameState);
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const NvU32 sd = pDispEvo->displayOwner;
+    const NvBool dolbyVsif = HadesDolbyVsifOn(pHeadState);
+    NvU32 vic;
+
+    *pDolby = NV_FALSE;
+    if (hdr10Plus != 0) {
+        return hdr10Plus;
+    }
+    if (ctaVic == 0) {
+        return 0;
+    }
+
+    vic = nvHadesDolbyAviCtaVic(
+        ownHdmiVic,
+        dolbyVsif,
+        (pVsif->payloadSize != 0) && !dolbyVsif &&
+            !nvHadesIsHdr10PlusVsif(pVsif->payload, pVsif->payloadSize),
+        pEdidInfo->hdmiForumInfo.scdc_present != 0,
+        HadesVdbListsVic(pEdidInfo, ctaVic),
+        (pEdidInfo->ext861.valid.dv_static_metadata != 0) ||
+            (pEdidInfo->ext861_2.valid.dv_static_metadata != 0),
+        nvHadesHdr10PlusCtaVicKept(pDevEvo->hadesAviCtaVic[sd][head],
+                                   pDevEvo->hadesAviCtaClock[sd][head],
+                                   ctaVic,
+                                   pHeadState->timings.pixelClock));
+    *pDolby = (vic != 0);
+    return vic;
+}
+
+/*
+ * Hades: the kernel log says, once each time it starts, that the head sends
+ * Dolby Vision in a mode that NVKMS names by its HDMI_VIC with an AVI
+ * InfoFrame of VIC 0 and no vendor InfoFrame that names the format
+ * (nvHadesDolbyAviCtaVic() 0, ctaVic the VIC that the AVI InfoFrame carries),
+ * and why.
+ */
+static void HadesLogDolbyHdmiVic(const NVDispEvoRec *pDispEvo,
+                                 const NvU32 head,
+                                 const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                 const NVT_EDID_INFO *pEdidInfo,
+                                 NvU32 ctaVic)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    NvU8 *pLogged = &pDevEvo->hadesDolbyVicLogged[pDispEvo->displayOwner][head];
+    const NvU32 ownHdmiVic = HadesOwnHdmiVic(pInfoFrameState);
+    const NvU32 modeCtaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const NvBool now = (modeCtaVic != 0) && (ctaVic == 0) &&
+                       HadesDolbyVsifOn(&pDispEvo->headState[head]);
+
+    if (now && (*pLogged == 0)) {
+        if (pEdidInfo->hdmiForumInfo.scdc_present == 0) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that is not HDMI 2.0 (no SCDC_Present in its HF-VSDB), whose AVI InfoFrame does not name it by its CTA VIC %u: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
+                         head, ownHdmiVic, modeCtaVic);
+        } else {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that lists no CTA VIC %u in its video data blocks: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
+                         head, ownHdmiVic, modeCtaVic);
+        }
+    }
+    *pLogged = now ? 1 : 0;
+}
+
 /*
- * Hades: the AVI InfoFrame of the head goes out with ctaVic for HDR10+ from
- * here (0: with the VIC NVKMS puts there), at the pixel clock of its mode; the
- * kernel log says when that changes.
+ * Hades: the AVI InfoFrame of the head goes out with ctaVic for HDR10+ or for
+ * Dolby Vision (dolby) from here (0: with the VIC NVKMS puts there), at the
+ * pixel clock of its mode; the kernel log says when that changes.
  */
 static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
                                const NvU32 head,
-                               NvU32 ctaVic)
+                               NvU32 ctaVic,
+                               NvBool dolby)
 {
     NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
     const NvU32 sd = pDispEvo->displayOwner;
     NvU8 *pVic = &pDevEvo->hadesAviCtaVic[sd][head];
 
     if (*pVic != (NvU8)ctaVic) {
-        if (ctaVic != 0) {
+        if ((ctaVic != 0) && dolby) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u: the AVI InfoFrame says VIC %u for the format of the mode, which NVKMS names by its HDMI_VIC, because the Dolby Vision vendor InfoFrame takes the place of NVKMS's own (which goes out in no slot while the AVI InfoFrame says it)",
+                         head, ctaVic);
+        } else if (ctaVic != 0) {
             nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
                          "Hades: head %u: the AVI InfoFrame says VIC %u for the format of the mode, which NVKMS names by its HDMI_VIC, so that HDR10+ takes the generic InfoFrame slot (NVKMS's own vendor InfoFrame goes out in none while it does)",
                          head, ctaVic);
@@ -1239,7 +1357,8 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
      * enabled, or if HDMI 3D is requested but not supported by the monitor.
      *
      * Hades: and while the AVI InfoFrame carries the CTA VIC of the mode for
-     * HDR10+ (nvHadesHdr10PlusAviCtaVic()), as for that CTA mode.
+     * HDR10+ or Dolby Vision (nvHadesHdr10PlusAviCtaVic(),
+     * nvHadesDolbyAviCtaVic()), as for that CTA mode.
      */
     if (!vendorCtrl.Enable ||
         ((vendorCtrl.HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) &&
@@ -1383,9 +1502,11 @@ void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
          * changes its VIC (nvHadesHdr10PlusAviCtaVic(); one that ends keeps it
          * until the next change of mode)
          */
+        NvBool dolby;
+
         if ((pDpyColor != NULL) &&
-            (HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState,
-                                     &pDpyEvo->parsedEdid.info) !=
+            (HadesAviCtaVic(pDispEvo, head, pInfoFrameState,
+                            &pDpyEvo->parsedEdid.info, &dolby) !=
              pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head])) {
             SendVideoInfoFrame(pDispEvo,
                                head,
-- 
