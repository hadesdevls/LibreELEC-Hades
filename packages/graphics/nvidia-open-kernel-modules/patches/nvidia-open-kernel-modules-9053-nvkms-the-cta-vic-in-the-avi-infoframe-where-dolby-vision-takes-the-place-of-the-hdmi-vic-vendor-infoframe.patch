From 2de19ba8164f389f8d8490095a5a29b37c18ad6d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 19:45:58 +0000
Subject: [PATCH] nvkms: the CTA VIC in the AVI InfoFrame where Dolby Vision
 takes the place of the HDMI_VIC vendor InfoFrame

In a mode that NVKMS signals by its HDMI_VIC (3840x2160 at 24, 25 and 30 Hz
and 4096x2160 at 24 Hz from the HDMI VSDB of a display without UHD_VIC, their
1000/1001 rates too) the AVI InfoFrame carries VIC 0 and NVKMS's own vendor
InfoFrame names the format. A client's Dolby vendor InfoFrame (Dolby Vision
Standard, or Low-Latency over the tunnel) goes out in the vendor-specific slot
in place of that one, on every HAL (SendVendorSpecificInfoFrame()): with Dolby
Vision the display was told no format at all, only the timing. Hades' 580 for
Pascal refused that mode set outright: a GTX 1060 with an LG TV (a Dolby
Vision VSVDB of version 1, 12 bytes) never had Dolby Vision at 3840x2160 at
23.976 Hz, through an AVR or straight to the TV ("the HDMI vendor InfoFrame
of head 0 is refused: the mode needs NVKMS's own HDMI vendor InfoFrame", 275
times).

There the AVI InfoFrame now carries the CTA VIC of the format (95, 94 and 93
for 3840x2160 at 30, 25 and 24 Hz, 98 for 4096x2160 at 24 Hz, with no picture
aspect for 98), as 9050 does for HDR10+, as Linux names these formats to an
HDMI 2.0 sink (drm_mode_cea_vic() and drm_mode_hdmi_vic() give such a sink no
HDMI_VIC) and as NVKMS itself names them to a display that says UHD_VIC; and
NVKMS's own vendor InfoFrame goes out in no slot while it does, so that the AVI
InfoFrame and a vendor InfoFrame never name two formats
(nvHadesDolbyAviCtaVic()). Only:
- with the client's Dolby vendor InfoFrame (IEEE OUI 00-D0-46): the Dolby
  Vision signalling of HDMI 1.4b (9045) names the HDMI_VIC in its own
  InfoFrame and keeps doing so, and a 3D vendor InfoFrame keeps its own;
- to an HDMI 2.0 sink (SCDC_Present in its HF-VSDB) that lists that CTA VIC
  in a video data block, the sink of the rule of 9050;
- on every HAL: the Dolby vendor InfoFrame takes the vendor-specific slot on
  all of them, Blackwell included;
- kept as 9050 keeps it: where the AVI InfoFrame of the head carries that CTA
  VIC already in the same mode (the same VIC at the same pixel clock) and the
  display declares Dolby Vision (a Dolby Vision VSVDB that NVKMS parsed), the
  end of Dolby Vision changes nothing of the signalling until the next change
  of mode, so the AVI InfoFrame does not change in the middle of a mode. A
  Dolby Vision start in a mode where HDR10+ had the CTA VIC already keeps it
  too: before, the AVI InfoFrame went back to VIC 0 with it.
Elsewhere the mode goes out exactly as before, with VIC 0 next to the Dolby
vendor InfoFrame, and the kernel log says it once each time it starts ("Hades:
head N: Dolby Vision in a mode that NVKMS names by HDMI_VIC H, to a display
that is not HDMI 2.0 ... / that lists no CTA VIC V in its video data blocks:
the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as
before"). When the CTA VIC starts, the line of 9050 names Dolby Vision: "Hades:
head N: the AVI InfoFrame says VIC V for the format of the mode, which NVKMS
names by its HDMI_VIC, because the Dolby Vision vendor InfoFrame takes the
place of NVKMS's own (which goes out in no slot while the AVI InfoFrame says
it)".

The LG C5 (UHD_VIC: NVKMS names its 3840x2160 modes by their CTA VIC) is
unchanged at 3840x2160; a mode of 4096x2160 at 24 Hz, which NVKMS names by
HDMI_VIC 4 there too, now carries VIC 98 with Dolby Vision.

Not run on a GPU; a Dolby Vision display without UHD_VIC at 4K 24, 25 or
30 Hz is what can show it.

Checked with the host test of 9050 (nvUpdateHdmiInfoFrames() and
nvHadesUpdateHdmiHdr10Plus() of the tree with the HALs and the HDMI packet
library on a register file) extended with Dolby Vision steps and three
displays made from the EDID of a Samsung S90H without UHD_VIC with a Dolby
Vision VSVDB (as it is, without SCDC, without VIC 93): the AVI VIC with Dolby
Vision and after it, the vendor-specific slot, NVKMS's vendor InfoFrame in no
slot, and the kernel log; against the tree before, every step outside Dolby
Vision in such a mode the same.
---
 src/nvidia-modeset/include/nvkms-hades.h |  49 +++++++
 src/nvidia-modeset/include/nvkms-types.h |  13 +-
 src/nvidia-modeset/src/nvkms-hdmi.c      | 157 ++++++++++++++++++++---
 3 files changed, 198 insertions(+), 21 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 15d429c..c7760a6 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -688,6 +688,55 @@ static inline NvBool nvHadesHdr10PlusCtaVicKept(NvU32 heldVic,
     return (ctaVic != 0) && (heldVic == ctaVic) && (heldClockKHz == clockKHz);
 }
 
+/*
+ * Dolby Vision in a mode that NVKMS signals by its HDMI_VIC (4K at 24, 25 and
+ * 30 Hz from the HDMI VSDB of a display without UHD_VIC, 4096x2160 at 24 Hz;
+ * their 1000/1001 rates too). The client's Dolby vendor InfoFrame (Standard,
+ * or Low-Latency over the tunnel: IEEE OUI 00-D0-46, nvHadesIsDolbyVsif())
+ * goes out in the vendor-specific slot in place of NVKMS's own vendor
+ * InfoFrame, the one that names the format, on every HAL
+ * (SendVendorSpecificInfoFrame()), next to an AVI InfoFrame with VIC 0: the
+ * display was told no format at all. There the AVI InfoFrame carries the CTA
+ * VIC of the format instead (95, 94 and 93 for 3840x2160 at 30, 25 and 24 Hz,
+ * 98 for 4096x2160 at 24 Hz), as for HDR10+ (nvHadesHdr10PlusAviCtaVic()), as
+ * Linux names these formats to an HDMI 2.0 sink (drm_mode_cea_vic() gives no
+ * HDMI_VIC to one), and as NVKMS itself names them to a display whose HF-VSDB
+ * says UHD_VIC; and NVKMS's own vendor InfoFrame goes out in no slot while it
+ * does, so that the two never both name the format. Only:
+ *  - to an HDMI 2.0 sink (hdmi2: SCDC_Present in its HF-VSDB) that lists that
+ *    CTA VIC in a video data block (listed), as for HDR10+;
+ *  - with the client's Dolby vendor InfoFrame on the head (dolbyVsif), and no
+ *    other client's vendor InfoFrame (otherVsif: the one of the Dolby Vision
+ *    signalling of HDMI 1.4b names the HDMI_VIC itself,
+ *    nvHadesIsDolbyHdmi14bVsif(), and one of 3D its own format); or, with none
+ *    (or an HDR10+ one), where the AVI InfoFrame of the head carries that CTA
+ *    VIC already in the same mode (kept, nvHadesHdr10PlusCtaVicKept()) and the
+ *    display declares Dolby Vision (declares: a Dolby Vision VSVDB that NVKMS
+ *    parsed): the end of Dolby Vision changes nothing of the signalling until
+ *    the next change of mode, as for HDR10+, so that the AVI InfoFrame does not
+ *    change in the middle of a mode.
+ * 0 elsewhere: the mode goes out exactly as before, with VIC 0 next to the
+ * Dolby vendor InfoFrame, and the kernel log says why.
+ */
+static inline NvU32 nvHadesDolbyAviCtaVic(NvU32 ownHdmiVic,
+                                          NvBool dolbyVsif,
+                                          NvBool otherVsif,
+                                          NvBool hdmi2,
+                                          NvBool listed,
+                                          NvBool declares,
+                                          NvBool kept)
+{
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+
+    if ((ctaVic == 0) || otherVsif || !hdmi2 || !listed) {
+        return 0;
+    }
+    if (dolbyVsif) {
+        return ctaVic;
+    }
+    return (declares && kept) ? ctaVic : 0;
+}
+
 /*
  * The picture aspect ratio of the AVI InfoFrame with that CTA VIC: VIC 98 is
  * 256:135, which M1M0 cannot say, so no data, as NVKMS builds the AVI
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index cae15b5..c57b0ae 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1354,12 +1354,19 @@ typedef struct _NVEvoDevRec {
 
     /*
      * Hades: the CTA VIC that the AVI InfoFrame of a head carries for HDR10+
-     * in place of the HDMI_VIC of its mode, per display owner and head (0 for
-     * none), and the pixel clock of that mode, in kHz
-     * (nvHadesHdr10PlusAviCtaVic())
+     * or Dolby Vision in place of the HDMI_VIC of its mode, per display owner
+     * and head (0 for none), and the pixel clock of that mode, in kHz
+     * (nvHadesHdr10PlusAviCtaVic(), nvHadesDolbyAviCtaVic())
      */
     NvU8 hadesAviCtaVic[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
     NvU32 hadesAviCtaClock[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+
+    /*
+     * Hades: the kernel log said that the head sends Dolby Vision in a mode
+     * that NVKMS names by its HDMI_VIC with an AVI InfoFrame of VIC 0
+     * (nvHadesDolbyAviCtaVic() 0), per display owner and head
+     */
+    NvU8 hadesDolbyVicLogged[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
 } NVDevEvoRec;
 
