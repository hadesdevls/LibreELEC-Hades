+     * sends decides which goes where (nvHadesHdmiSlots()).
      */
-    if (pInfo->HDMI3DSupported) {
-        return FALSE;
-    }
 
     // Sink should support ST2084 EOTF.
     if (!pHdrInfo->supported_eotf.smpte_st_2084_eotf) {
diff --git a/src/nvidia-modeset/src/nvkms-evo1.c b/src/nvidia-modeset/src/nvkms-evo1.c
index 0ac155a..0919bee 100644
--- a/src/nvidia-modeset/src/nvkms-evo1.c
+++ b/src/nvidia-modeset/src/nvkms-evo1.c
@@ -126,12 +126,17 @@ static NVHDMIPKT_TC EvoInfoFrameToHdmiLibTransmitCtrl(
     return hdmiLibTransmitCtrl;
 }
 
-void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
-                             const NvU32 head,
-                             const NvEvoInfoFrameTransmitControl *transmitCtrl,
-                             const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
-                             const NvU32 infoframeSize,
-                             NvBool needChecksum)
+/*
+ * Hades: hadesGeneric sends the InfoFrame through the generic InfoFrame slot of
+ * the head instead of the slot of its type (nvHadesEvo1SendHdmiGenericInfoFrame())
+ */
+static void Evo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
+                                  const NvU32 head,
+                                  const NvEvoInfoFrameTransmitControl *transmitCtrl,
+                                  const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                                  const NvU32 infoframeSize,
+                                  NvBool needChecksum,
+                                  NvBool hadesGeneric)
 {
     NVHDMIPKT_TC hdmiLibTransmitCtrl =
         EvoInfoFrameToHdmiLibTransmitCtrl(transmitCtrl, needChecksum);
@@ -168,6 +173,10 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
             break;
     }
 
+    if (hadesGeneric) {
+        hdmiLibType = NVHDMIPKT_TYPE_GENERIC;
+    }
+
     if (!nvEvo1NvtToHdmiInfoFramePacketType(pInfoFrameHeader->type,
                                             &hdmiPacketType)) {
         return;
@@ -242,6 +251,34 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
     nvFree(infoframe);
 }
 
+void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
+                             const NvU32 head,
+                             const NvEvoInfoFrameTransmitControl *transmitCtrl,
+                             const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                             const NvU32 infoframeSize,
+                             NvBool needChecksum)
+{
+    Evo1SendHdmiInfoFrame(pDispEvo, head, transmitCtrl, pInfoFrameHeader,
+                          infoframeSize, needChecksum, FALSE);
+}
+
+/*
+ * Hades: an InfoFrame through the generic InfoFrame slot of the head, every
+ * frame, with its checksum: the vendor InfoFrame that the HDR InfoFrame takes
+ * the vendor-specific slot from (nvHadesHdmiSlots()).
+ */
+void nvHadesEvo1SendHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
+                                         const NvU32 head,
+                                         const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                                         const NvU32 infoframeSize)
+{
+    NvEvoInfoFrameTransmitControl transmitCtrl = { 0 };
+
+    transmitCtrl.frequency = NV_EVO_INFOFRAME_TRANSMIT_FREQUENCY_EVERY_FRAME;
+    Evo1SendHdmiInfoFrame(pDispEvo, head, &transmitCtrl, pInfoFrameHeader,
+                          infoframeSize, TRUE, TRUE);
+}
+
 void nvEvo1DisableHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
                                 const NvEvoInfoFrameTransmitControl *transmitCtrl,
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index b2a0203..cadaf27 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -31,6 +31,7 @@
 #include "nvkms-hdmi.h"
 #include "nvkms-hades.h"
 #include "nvkms-evo.h"
+#include "nvkms-evo1.h" // nvHadesEvo1SendHdmiGenericInfoFrame() (Hades)
 #include "nvkms-modepool.h"
 #include "nvkms-rmapi.h"
 #include "nvkms-types.h"
@@ -649,6 +650,179 @@ NvBool nvHadesHdmiVrrEmp(const NVDispHeadStateEvoRec *pHeadState)
            nvIsAdaptiveSyncDpyVrrType(pHeadState->timings.vrr.type);
 }
 
+/*
+ * Hades: RM keeps the generic InfoFrame slot for its ACR workaround (GA10x;
+ * nvHadesHdr10PlusRoutes())
+ */
+NvBool nvHadesHdmiRmGeneric(const NVDevEvoRec *pDevEvo)
+{
+    return NV0073_CTRL_SYSTEM_GET_CAP(pDevEvo->commonCapsBits,
+               NV0073_CTRL_SYSTEM_CAPS_HDMI21_SW_ACR_BUG_3275257) != 0;
+}
+
+/*
+ * Hades: the vendor InfoFrame of the head, as nvHadesHdmiSlots() names it: the
+ * client's (an HDR10+ one is not: it has a slot of its own), or else NVKMS's
+ * own, as SendVendorSpecificInfoFrame() sends it.
+ */
+static NvU32 HadesHdmiVendor(const NVDispHeadStateEvoRec *pHeadState,
+                             const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                             const NVT_EDID_INFO *pEdidInfo)
+{
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pHeadState->hdmiVsifMetadata;
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pCtrl =
+        &pInfoFrameState->vendorSpecificCtrl;
+
+    if ((pVsif->payloadSize != 0) &&
+        !nvHadesIsHdr10PlusVsif(pVsif->payload, pVsif->payloadSize)) {
+        return nvHadesIsDolbyVsif(pVsif->payload, pVsif->payloadSize) ?
+            NV_HADES_VENDOR_DOLBY : NV_HADES_VENDOR_CLIENT;
+    }
+    if (!pCtrl->Enable) {
+        return NV_HADES_VENDOR_NONE;
+    }
+    if (pCtrl->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) {
+        return pEdidInfo->HDMI3DSupported ?
+            NV_HADES_VENDOR_FRAME_PACKING : NV_HADES_VENDOR_NONE;
+    }
+    return NV_HADES_VENDOR_NVKMS_2D;
+}
+
+/*
+ * Hades: what the two InfoFrame slots of an HDMI head carry where the HAL has
+ * no generic shared InfoFrames (nvHadesHdmiSlots()).
+ */
+static struct NvHadesHdmiSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
+                                                const NvU32 head,
+                                                const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                                const NVT_EDID_INFO *pEdidInfo,
+                                                NvU32 *pVendor)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
+    const NvU32 vendor = HadesHdmiVendor(pHeadState, pInfoFrameState, pEdidInfo);
+
+    if (pVendor != NULL) {
+        *pVendor = vendor;
+    }
+    return nvHadesHdmiSlots(vendor,
+                            nvHadesIsHdr10PlusVsif(pHeadState->hdmiVsifMetadata.payload,
+                                                   pHeadState->hdmiVsifMetadata.payloadSize),
+                            pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
