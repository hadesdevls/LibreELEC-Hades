+/*
+ * Whether a client's vendor-specific InfoFrame is one of Dolby (IEEE OUI
+ * 00-D0-46, least significant byte first): Dolby Vision, Standard or
+ * Low-Latency.
+ */
+static inline NvBool nvHadesIsDolbyVsif(const NvU8 *payload, NvU32 size)
+{
+    return (size >= 3) && (payload != NULL) &&
+           (payload[0] == 0x46) && (payload[1] == 0xD0) && (payload[2] == 0x00);
+}
+
+/*
+ * The two InfoFrame slots of an HDMI head on the HALs without generic shared
+ * InfoFrames (Turing, Ampere, Ada). Their HAL (nvEvo1SendHdmiInfoFrame()) sends
+ * the HDR InfoFrame through the vendor-specific slot, the slot of the vendor
+ * InfoFrame. The generic InfoFrame slot carries the EMP of HDMI VRR when it is
+ * on, is RM's on GA10x for its ACR workaround (nvHadesHdr10PlusRoutes()), and
+ * is otherwise free: the HDR10+ InfoFrame of nvHadesHdr10PlusHdmiSlot() goes
+ * there.
+ *
+ * NVKMS refused HDR to a display that declared HDMI 3D (its HDMI VSDB says
+ * 3D_present), whether anything 3D was sent or not: nvDpyIsHDRCapable() said
+ * no, so a flip or a mode set with HDR was refused on every GPU, and on these
+ * HALs the HDR InfoFrame was left out besides. An RTX 20 to 50 sent no HDR10 at
+ * all to a TV that declares 3D, an LG OLED of 2016 for one. Here what the head
+ * sends decides, by its vendor InfoFrame (vendor):
+ *  - DOLBY, the client's of Dolby Vision: in the vendor-specific slot, with no
+ *    HDR InfoFrame, as before;
+ *  - CLIENT, another client's (the HDMI 1.4 one of 3D side by side or top and
+ *    bottom), and FRAME_PACKING, NVKMS's own of a frame-packed mode: in the
+ *    vendor-specific slot with no SDR HDR InfoFrame over it, as NVKMS sent
+ *    them; with HDR (the HDR InfoFrame enabled, not the SDR one of a
+ *    transition), the HDR InfoFrame takes the vendor-specific slot and the
+ *    vendor one goes in the generic slot, unless the EMP of HDMI VRR or RM
+ *    holds it: then the vendor one keeps its slot and no HDR InfoFrame goes
+ *    out (hdrLeftOut; a flip with HDR and a CLIENT one is refused then,
+ *    nvkms-hw-flip.c);
+ *  - NVKMS_2D, NVKMS's own of a 2D mode (one named by an HDMI_VIC: 4K at 24,
+ *    25 or 30 Hz from the HDMI VSDB of a display without UHD_VIC), and NONE:
+ *    the HDR InfoFrame, where the display takes it (hdrSink), in the
+ *    vendor-specific slot and over the vendor one, as NVKMS sends it to every
+ *    display that does not declare 3D.
+ * An HDR10+ InfoFrame goes in its slot (nvHadesHdr10PlusHdmiSlot()), where a
+ * vendor InfoFrame in the generic slot holds that slot as the EMP does:
+ * shared generic slot 2 on AD10x, none on Turing and Ampere; and in none
+ * where no HDR InfoFrame goes out with it. The HDR InfoFrame is never left out
+ * for it.
+ *
+ * To a display that does not declare HDMI 3D (no FRAME_PACKING then: NVKMS
+ * does not send it) this is what NVKMS sent, slot by slot, with one addition:
+ * the HDR InfoFrame next to a CLIENT vendor InfoFrame, which no flip could
+ * carry before.
+ */
+#define NV_HADES_VENDOR_NONE          0
+#define NV_HADES_VENDOR_DOLBY         1
+#define NV_HADES_VENDOR_CLIENT        2
+#define NV_HADES_VENDOR_FRAME_PACKING 3
+#define NV_HADES_VENDOR_NVKMS_2D      4
+
+struct NvHadesHdmiSlots {
+    NvBool hdr;              /* the HDR InfoFrame, in the vendor-specific slot */
+    NvBool vendorGeneric;    /* the vendor InfoFrame, in the generic slot */
+    NvBool hdrLeftOut;       /* HDR that does not go out: the generic slot is held */
+    NvU32 hdr10PlusSlot;     /* NV_HADES_HDR10PLUS_SLOT_* of an HDR10+ InfoFrame */
+    NvU32 hdr10PlusRefusal;  /* why it has none (NV_HADES_HDR10PLUS_*) */
+};
+
+static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
+                                                       NvBool hdr10Plus,
+                                                       NvBool hdrSink,
+                                                       NvBool hdrEnabled,
+                                                       NvBool hdmiVrrEmp,
+                                                       NvBool rmGeneric,
+                                                       NvBool adaSharedGenerics)
+{
+    struct NvHadesHdmiSlots s;
+
+    s.hdr = hdrSink;
+    s.vendorGeneric = NV_FALSE;
+    s.hdrLeftOut = NV_FALSE;
+    s.hdr10PlusSlot = NV_HADES_HDR10PLUS_SLOT_NONE;
+    s.hdr10PlusRefusal = NV_HADES_HDR10PLUS_ALLOWED;
+
+    switch (vendor) {
+    case NV_HADES_VENDOR_DOLBY:
+        s.hdr = NV_FALSE;
+        break;
+    case NV_HADES_VENDOR_CLIENT:
+    case NV_HADES_VENDOR_FRAME_PACKING:
+        if (!hdrSink || !hdrEnabled) {
+            s.hdr = NV_FALSE;
+        } else if (!hdmiVrrEmp && !rmGeneric) {
+            s.vendorGeneric = NV_TRUE;
+        } else {
+            s.hdr = NV_FALSE;
+            s.hdrLeftOut = NV_TRUE;
+        }
+        break;
+    default:
+        break;
+    }
+
+    if (hdr10Plus) {
+        if (s.hdrLeftOut) {
+            s.hdr10PlusRefusal = NV_HADES_HDR10PLUS_3D_NO_HDR;
+        } else {
+            s.hdr10PlusSlot = nvHadesHdr10PlusHdmiSlot(NV_FALSE, adaSharedGenerics,
+                                                       hdmiVrrEmp || s.vendorGeneric);
+            if (s.hdr10PlusSlot == NV_HADES_HDR10PLUS_SLOT_NONE) {
+                s.hdr10PlusRefusal = s.vendorGeneric ?
+                    NV_HADES_HDR10PLUS_3D_GENERIC : NV_HADES_HDR10PLUS_HDMI_VRR;
+            }
+        }
+    }
+    return s;
+}
+
 /*
  * Whether a change of the client's vendor InfoFrame, from (fromSize bytes) to
  * (toSize), each empty or not, is a change of HDR10+ metadata only: a flip
diff --git a/src/nvidia-modeset/include/nvkms-hdmi.h b/src/nvidia-modeset/include/nvkms-hdmi.h
index 7fe45d8..0fef776 100644
