--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1343,6 +1343,14 @@ typedef struct _NVEvoDevRec {
      * and head (NV_HADES_HDR10PLUS_*; 0 since one was allowed)
      */
     NvU8 hadesHdr10PlusRefusalLogged[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+
+    /*
+     * Hades: whether the vendor InfoFrame of a head goes out in its generic
+     * InfoFrame slot, per display owner and head (nvHadesHdmiSlots()), and the
+     * case of the two slots last logged (HadesLogSlots() of nvkms-hdmi.c)
+     */
+    NvU8 hadesVendorGeneric[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+    NvU8 hadesSlotsLogged[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
 } NVDevEvoRec;
 
 /*
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 9f9aae7..045709a 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -4040,12 +4040,12 @@ NvBool nvDpyIsHDRCapable(const NVDpyEvoRec *pDpyEvo)
     }
 
     /*
-     * XXX HDR is not supported with HDMI 3D due to both using VSI
-     * infoframes.
+     * Hades: a display that declares HDMI 3D takes HDR too. NVKMS refused it
+     * HDR here, on every GPU, because the HDR InfoFrame and the vendor one of
+     * HDMI 3D share a slot where the HAL has no generic shared InfoFrames;
