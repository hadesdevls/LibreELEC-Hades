+/*
+ * Hades: the vendor InfoFrame of the head into the generic InfoFrame slot,
+ * every frame, where nvHadesHdmiSlots() puts it there; or the slot turned off
+ * where it no longer does, unless the EMP of HDMI VRR or the HDR10+
+ * InfoFrame takes the slot over. Only that slot.
+ */
+static void HadesSendVendorGeneric(const NVDispEvoRec *pDispEvo,
+                                   const NvU32 head,
+                                   const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                   NVT_EDID_INFO *pEdidInfo,
+                                   const struct NvHadesHdmiSlots *pSlots)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    NvU8 *pInGeneric = &pDevEvo->hadesVendorGeneric[pDispEvo->displayOwner][head];
+    NVT_VENDOR_SPECIFIC_INFOFRAME frame;
+
+    if (pSlots->vendorGeneric &&
+        HadesVendorInfoFrame(pHeadState, pInfoFrameState, pEdidInfo, &frame)) {
+        nvHadesEvo1SendHdmiGenericInfoFrame(pDispEvo, head, &frame.Header,
+                                            sizeof(frame.Header) +
+                                            frame.Header.length);
+        *pInGeneric = 1;
+        return;
+    }
+
+    if (*pInGeneric != 0) {
+        *pInGeneric = 0;
+        if (!nvHadesHdmiVrrEmp(pHeadState) &&
+            (pSlots->hdr10PlusSlot != NV_HADES_HDR10PLUS_SLOT_GENERIC)) {
+            const NVHDMIPKT_RESULT ret =
+                NvHdmiPkt_PacketCtrl(pDevEvo->hdmiLib.handle,
+                                     pDispEvo->displayOwner,
+                                     pHeadState->activeRmId,
+                                     head,
+                                     NVHDMIPKT_TYPE_GENERIC,
+                                     NVHDMIPKT_TRANSMIT_CONTROL_DISABLE);
+            if (ret != NVHDMIPKT_SUCCESS) {
+                nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                             "Hades: the vendor InfoFrame of head %u could not be turned off in the generic InfoFrame slot",
+                             head);
+            }
+        }
+    }
+}
