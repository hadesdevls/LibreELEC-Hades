+++ b/src/nvidia-modeset/include/nvkms-hdmi.h
@@ -51,6 +51,7 @@ NvU32 nvHadesConnectorHdr10PlusRoutes(const NVConnectorEvoRec *pConnectorEvo);
 NvBool nvHadesHdr10PlusInOwnSlot(const NVDevEvoRec *pDevEvo,
                                  const NVDispHeadStateEvoRec *pHeadState);
 NvBool nvHadesHdmiVrrEmp(const NVDispHeadStateEvoRec *pHeadState);
+NvBool nvHadesHdmiRmGeneric(const NVDevEvoRec *pDevEvo);
 NvBool nvHadesHdr10PlusSetSlot(const NVDispEvoRec *pDispEvo,
                                const NvU32 head,
                                NvU32 slot);
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
