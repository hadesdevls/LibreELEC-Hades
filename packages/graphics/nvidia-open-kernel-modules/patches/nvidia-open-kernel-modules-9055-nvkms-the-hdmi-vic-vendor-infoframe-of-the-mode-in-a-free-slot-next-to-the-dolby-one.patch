From 1ec8fb1ea0e5b0fac5333c4b714b3c21af615ce6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:24:37 +0000
Subject: [PATCH] nvkms: the HDMI_VIC vendor InfoFrame of the mode in a free
 slot next to the Dolby one

9053 names a mode that NVKMS signals by its HDMI_VIC by its CTA VIC in the AVI
InfoFrame, with Dolby Vision, to an HDMI 2.0 sink that lists that VIC. To any
other display (one that is not HDMI 2.0, or does not list the VIC) Dolby
Vision still went out with an AVI InfoFrame of VIC 0 and the Dolby vendor
InfoFrame in the slot of NVKMS's own, so no InfoFrame named the format.

There NVKMS's own vendor InfoFrame, the HDMI_VIC one, now goes in a free slot
next to the Dolby one, as 9043 puts it next to HDR10: the display is told the
format by its HDMI_VIC, as HDMI 1.4b has it, and Dolby Vision by its own
InfoFrame (NV_HADES_VENDOR_DOLBY_HDMI_VIC of nvHadesHdmiSlots()):
- on Turing, Ampere and Ada, in the generic slot, where it is free: not where
  the EMP of HDMI VRR holds it (Adaptive-Sync timings) or RM does (the HDMI
  2.1 ACR workaround of GA10x). No HDR InfoFrame goes out with Dolby Vision,
  and no HDR10+ one (the client's vendor InfoFrame is one or the other), so
  nothing else wants that slot then;
- on Blackwell (the HALs with generic shared InfoFrames), in shared generic
  slot 9, the slot of HDR10+ (9049), laid out and sent as HDR10+ is there
  (HadesSendOwnVsifShared()), and turned off as HDR10+'s is.
Where no slot is free the mode goes out as before, AVI VIC 0, and the line of
9053 says what holds the slot ("Hades: head N: Dolby Vision in a mode that
NVKMS names by HDMI_VIC H, to a display that ..., and the generic InfoFrame
slot, where NVKMS's HDMI_VIC vendor InfoFrame would go next to the Dolby one,
is held by the EMP of HDMI VRR / RM (its HDMI 2.1 ACR workaround): the AVI
InfoFrame keeps VIC 0 ..."). Where it goes out, once each time it starts:
"Hades: head N sends the Dolby Vision vendor InfoFrame in the vendor-specific
slot, and NVKMS's HDMI_VIC vendor InfoFrame of the mode in the generic
InfoFrame slot (in shared generic slot 9), so that the display is told the
format". The end of Dolby Vision gives the slot back as 9043 does.

The rule of 9053 (the CTA VIC where the display reads it) is unchanged; this
is only the case that it leaves with VIC 0. Whether the GSP of Blackwell uses
shared generic slot 9: not verified, as for 9049.

Not run on a GPU; a Dolby Vision display without UHD_VIC that is not HDMI 2.0
or does not list the CTA VIC, at 4K 24, 25 or 30 Hz, is what can show it.

Checked with the host test of 9050 and 9053 on the HALs and the HDMI packet
library of the tree on a register file: the slots, the AVI VIC and the kernel
log at the start and the end of Dolby Vision, with the slot free and held by
each of the two (the EMP of HDMI VRR, RM), on Turing, Ampere, Ampere with the
ACR workaround, Ada and Blackwell; against the tree before, every step outside
that case the same.
---
 src/nvidia-modeset/include/nvkms-hades.h |  19 +++
 src/nvidia-modeset/src/nvkms-hdmi.c      | 159 +++++++++++++++++++++--
 2 files changed, 169 insertions(+), 9 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index c7760a6..094cbbf 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -546,6 +546,19 @@ static inline NvBool nvHadesDolbyHdmi14bAviVic0(const NvU8 *payload,
 #define NV_HADES_VENDOR_CLIENT        2
 #define NV_HADES_VENDOR_FRAME_PACKING 3
 #define NV_HADES_VENDOR_NVKMS_2D      4
+/*
+ * DOLBY_HDMI_VIC: the client's Dolby vendor InfoFrame (IEEE OUI 00-D0-46) in a
+ * mode that NVKMS names by its HDMI_VIC where the AVI InfoFrame does not carry
+ * the CTA VIC of the format (nvHadesDolbyAviCtaVic() 0: the display is not
+ * HDMI 2.0, or does not list that VIC). The Dolby one in the vendor-specific
+ * slot, with no HDR InfoFrame, as DOLBY; and NVKMS's own vendor InfoFrame, the
+ * HDMI_VIC one that names the format, in the generic slot where it is free
+ * (no EMP of HDMI VRR, not RM's), as for HDR next to it (NVKMS_2D): the
+ * display is told the format by its HDMI_VIC, as HDMI 1.4b has it, and Dolby
+ * Vision by its own InfoFrame. Where the generic slot is held, as before: the
+ * AVI InfoFrame says VIC 0 and no vendor InfoFrame names the format.
+ */
+#define NV_HADES_VENDOR_DOLBY_HDMI_VIC 5
 
 struct NvHadesHdmiSlots {
     NvBool hdr;              /* the HDR InfoFrame, in the vendor-specific slot */
@@ -577,6 +590,12 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
     case NV_HADES_VENDOR_DOLBY:
         s.hdr = NV_FALSE;
         break;
+    case NV_HADES_VENDOR_DOLBY_HDMI_VIC:
+        s.hdr = NV_FALSE;
+        if (!hdmiVrrEmp && !rmGeneric) {
+            s.vendorGeneric = NV_TRUE;
+        }
+        break;
     case NV_HADES_VENDOR_CLIENT:
     case NV_HADES_VENDOR_FRAME_PACKING:
         if (!hdrSink || !hdrEnabled) {
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index db628fc..8bdc6f6 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -865,6 +865,10 @@ NvBool nvHadesHdmiRmGeneric(const NVDevEvoRec *pDevEvo)
  * client's (an HDR10+ one is not: it has a slot of its own), or else NVKMS's
  * own, as SendVendorSpecificInfoFrame() sends it.
  */
+static NvBool HadesDolbyHdmiVicMode(const NVDispEvoRec *pDispEvo,
+                                    const NvU32 head,
+                                    const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState);
+
 static NvU32 HadesHdmiVendor(const NVDispHeadStateEvoRec *pHeadState,
                              const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
                              const NVT_EDID_INFO *pEdidInfo)
@@ -901,7 +905,13 @@ static struct NvHadesHdmiSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
     const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
     const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
     const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
-    const NvU32 vendor = HadesHdmiVendor(pHeadState, pInfoFrameState, pEdidInfo);
+    /*
+     * the Dolby one in a mode named by NVKMS's HDMI_VIC that the AVI InfoFrame
+     * does not name (NV_HADES_VENDOR_DOLBY_HDMI_VIC)
+     */
+    const NvU32 vendor = HadesDolbyHdmiVicMode(pDispEvo, head, pInfoFrameState) ?
+        NV_HADES_VENDOR_DOLBY_HDMI_VIC :
+        HadesHdmiVendor(pHeadState, pInfoFrameState, pEdidInfo);
 
     if (pVendor != NULL) {
         *pVendor = vendor;
@@ -1017,6 +1027,44 @@ static NvBool HadesDolbyVsifOn(const NVDispHeadStateEvoRec *pHeadState)
                               pHeadState->hdmiVsifMetadata.payloadSize);
 }
 
+/*
+ * Hades: the head sends the client's Dolby vendor InfoFrame in a mode that
+ * NVKMS names by its HDMI_VIC, and its AVI InfoFrame does not carry the CTA
+ * VIC of the format (NV_HADES_VENDOR_DOLBY_HDMI_VIC): NVKMS's own HDMI_VIC
+ * vendor InfoFrame goes in a free slot next to the Dolby one
+ */
+static NvBool HadesDolbyHdmiVicMode(const NVDispEvoRec *pDispEvo,
+                                    const NvU32 head,
+                                    const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState)
+{
+    return HadesDolbyVsifOn(&pDispEvo->headState[head]) &&
+           (nvHadesCtaVicOfHdmiVic(HadesOwnHdmiVic(pInfoFrameState)) != 0) &&
+           (pDispEvo->pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] == 0);
+}
+
+/*
+ * Hades: what holds the slot where NVKMS's HDMI_VIC vendor InfoFrame would go
+ * next to a Dolby one (NULL: it is free): the generic slot on the HALs without
+ * generic shared InfoFrames (nvHadesHdmiSlots()), shared generic slot 9 on the
+ * others, the slot of HDR10+, which never goes out with Dolby Vision
+ */
+static const char *HadesDolbyHdmiVicSlotHolder(const NVDispEvoRec *pDispEvo,
+                                               const NvU32 head)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+
+    if (pDevEvo->caps.supportsGenericSharedInfoFrames) {
+        return NULL;
+    }
+    if (nvHadesHdmiVrrEmp(&pDispEvo->headState[head])) {
+        return "the EMP of HDMI VRR";
+    }
+    if (nvHadesHdmiRmGeneric(pDevEvo)) {
+        return "RM (its HDMI 2.1 ACR workaround)";
+    }
+    return NULL;
+}
+
 /*
  * Hades: the CTA VIC that the AVI InfoFrame of an HDMI head carries in a mode
  * that NVKMS signals by its HDMI_VIC: for HDR10+ where the HAL has no generic
@@ -1083,18 +1131,20 @@ static void HadesLogDolbyHdmiVic(const NVDispEvoRec *pDispEvo,
     NvU8 *pLogged = &pDevEvo->hadesDolbyVicLogged[pDispEvo->displayOwner][head];
     const NvU32 ownHdmiVic = HadesOwnHdmiVic(pInfoFrameState);
     const NvU32 modeCtaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const char *holder = HadesDolbyHdmiVicSlotHolder(pDispEvo, head);
     const NvBool now = (modeCtaVic != 0) && (ctaVic == 0) &&
-                       HadesDolbyVsifOn(&pDispEvo->headState[head]);
+                       HadesDolbyVsifOn(&pDispEvo->headState[head]) &&
+                       (holder != NULL);
 
     if (now && (*pLogged == 0)) {
         if (pEdidInfo->hdmiForumInfo.scdc_present == 0) {
             nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
-                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that is not HDMI 2.0 (no SCDC_Present in its HF-VSDB), whose AVI InfoFrame does not name it by its CTA VIC %u: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
-                         head, ownHdmiVic, modeCtaVic);
+                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that is not HDMI 2.0 (no SCDC_Present in its HF-VSDB), whose AVI InfoFrame does not name it by its CTA VIC %u, and the generic InfoFrame slot, where NVKMS's HDMI_VIC vendor InfoFrame would go next to the Dolby one, is held by %s: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
+                         head, ownHdmiVic, modeCtaVic, holder);
         } else {
             nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
-                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that lists no CTA VIC %u in its video data blocks: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
-                         head, ownHdmiVic, modeCtaVic);
+                         "Hades: head %u: Dolby Vision in a mode that NVKMS names by HDMI_VIC %u, to a display that lists no CTA VIC %u in its video data blocks, and the generic InfoFrame slot, where NVKMS's HDMI_VIC vendor InfoFrame would go next to the Dolby one, is held by %s: the AVI InfoFrame keeps VIC 0 and no vendor InfoFrame names the format, as before",
+                         head, ownHdmiVic, modeCtaVic, holder);
         }
     }
     *pLogged = now ? 1 : 0;
@@ -1148,8 +1198,13 @@ static NvBool HadesVendorInfoFrame(const NVDispHeadStateEvoRec *pHeadState,
 
     nvkms_memset(pFrame, 0, sizeof(*pFrame));
 
+    /*
+     * (next to the client's Dolby one, the one that goes in the generic slot is
+     * NVKMS's own: NV_HADES_VENDOR_DOLBY_HDMI_VIC)
+     */
     if ((pVsif->payloadSize != 0) &&
-        !nvHadesIsHdr10PlusVsif(pVsif->payload, pVsif->payloadSize)) {
+        !nvHadesIsHdr10PlusVsif(pVsif->payload, pVsif->payloadSize) &&
+        !nvHadesIsDolbyVsif(pVsif->payload, pVsif->payloadSize)) {
         ct_assert(sizeof(pFrame->Data) >= sizeof(pVsif->payload));
         pFrame->Header.type = NVT_INFOFRAME_TYPE_VENDOR_SPECIFIC;
         pFrame->Header.version = NVT_VIDEO_INFOFRAME_VERSION_1;
@@ -1223,14 +1278,19 @@ static void HadesLogSlots(const NVDispEvoRec *pDispEvo,
 {
     NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
     NvU8 *pLogged = &pDevEvo->hadesSlotsLogged[pDispEvo->displayOwner][head];
-    const NvU8 now = pSlots->vendorGeneric ? 1 : (pSlots->hdrLeftOut ? 2 : 0);
+    const NvU8 now = (pSlots->vendorGeneric && (vendor == NV_HADES_VENDOR_DOLBY_HDMI_VIC)) ? 3 :
+                     pSlots->vendorGeneric ? 1 : (pSlots->hdrLeftOut ? 2 : 0);
     const char *what = (vendor == NV_HADES_VENDOR_FRAME_PACKING) ?
         "the 3D vendor InfoFrame of the frame-packed mode" :
         (vendor == NV_HADES_VENDOR_NVKMS_2D) ?
         "the HDMI_VIC vendor InfoFrame of the mode" :
         "the client's vendor InfoFrame";
 
-    if ((now == 1) && (*pLogged != 1)) {
+    if ((now == 3) && (*pLogged != 3)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: head %u sends the Dolby Vision vendor InfoFrame in the vendor-specific slot, and NVKMS's HDMI_VIC vendor InfoFrame of the mode in the generic InfoFrame slot, so that the display is told the format",
+                     head);
+    } else if ((now == 1) && (*pLogged != 1)) {
         nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
                      "Hades: head %u sends the HDR InfoFrame in the vendor-specific slot, and %s in the generic InfoFrame slot",
                      head, what);
@@ -1426,6 +1486,83 @@ static void HadesSendHdr10PlusShared(const NVDispEvoRec *pDispEvo,
     }
 }
 
+/*
+ * Hades: on the HALs with generic shared InfoFrames, NVKMS's own HDMI_VIC
+ * vendor InfoFrame of the mode next to the client's Dolby one
+ * (NV_HADES_VENDOR_DOLBY_HDMI_VIC), in shared generic slot 9, the slot of
+ * HDR10+, which never goes out with Dolby Vision (the client's vendor
+ * InfoFrame is one or the other), laid out and sent as HDR10+ is there
+ * (HadesSendHdr10PlusShared()). The slot is turned off as HDR10+'s is
+ * (nvHadesHdr10PlusSetSlot()). A write that fails turns it off, and the kernel
+ * log says it.
+ */
+static void HadesSendOwnVsifShared(const NVDispEvoRec *pDispEvo,
+                                   const NvU32 head,
+                                   const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                   NVT_EDID_INFO *pEdidInfo)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL vendorCtrl = pInfoFrameState->vendorSpecificCtrl;
+    NVT_VENDOR_SPECIFIC_INFOFRAME frame;
+    NvU8 packet[NV_HADES_HDR10PLUS_DP_SLOT_SIZE];
+    ADVANCED_INFOFRAME advancedInfoFrame = { };
+    const NvU8 *pData = (const NvU8 *)&frame.Data;
+    NVHDMIPKT_RESULT ret;
+    NvU32 i, len;
+    NvU8 sum;
+
+    nvkms_memset(&frame, 0, sizeof(frame));
+    if ((NvTiming_ConstructVendorSpecificInfoframe(pEdidInfo, &vendorCtrl, &frame) !=
+         NVT_STATUS_SUCCESS) ||
+        (frame.Header.length > (sizeof(packet) - 5))) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: NVKMS's HDMI_VIC vendor InfoFrame of head %u could not be made for shared generic slot 9",
+                     head);
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+
+    /* HB0-HB2, HB3 0, PB0 the checksum, then the payload */
+    len = frame.Header.length;
+    nvkms_memset(packet, 0, sizeof(packet));
+    packet[0] = 0x81;
+    packet[1] = frame.Header.version;
+    packet[2] = (NvU8)len;
+    sum = (NvU8)(packet[0] + packet[1] + packet[2]);
+    for (i = 0; i < len; i++) {
+        packet[5 + i] = pData[i];
+        sum = (NvU8)(sum + pData[i]);
+    }
+    packet[4] = (NvU8)(0x100 - sum);
+
+    advancedInfoFrame.location = INFOFRAME_CTRL_LOC_VSYNC;
+    advancedInfoFrame.hwChecksum = TRUE;
+    advancedInfoFrame.runMode = INFOFRAME_CTRL_RUN_MODE_ALWAYS;
+    advancedInfoFrame.packetLen = sizeof(packet);
+    advancedInfoFrame.pPacket = packet;
+
+    ret = NvHdmiPkt_SetupAdvancedInfoframe(pDevEvo->hdmiLib.handle,
+                                           pDispEvo->displayOwner,
+                                           head,
+                                           NVHDMIPKT_TYPE_SHARED_GENERIC9,
+                                           &advancedInfoFrame);
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: NVKMS's HDMI_VIC vendor InfoFrame of head %u could not be written in shared generic slot 9: the AVI InfoFrame says VIC 0 and no vendor InfoFrame names the format",
+                     head);
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+    nvHadesLogHdmiPacket(pDispEvo, head, NVHDMIPKT_TYPE_SHARED_GENERIC9,
+                         NVHDMIPKT_TYPE_SHARED_GENERIC9, packet, 5 + len, 5);
+    if (nvHadesHdr10PlusSetSlot(pDispEvo, head,
+                                NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: head %u sends the Dolby Vision vendor InfoFrame in the vendor-specific slot, and NVKMS's HDMI_VIC vendor InfoFrame of the mode in shared generic slot 9, so that the display is told the format",
+                     head);
+    }
+}
+
 /*
  * SendVendorSpecificInfoFrame() - Construct vendor specific infoframe using
  * provided EDID and call ->SendHdmiInfoFrame() to send it to RM.
@@ -1459,6 +1596,10 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
         HadesLogSlots(pDispEvo, head, vendor, &slots);
         HadesSendVendorGeneric(pDispEvo, head, pInfoFrameState, pEdidInfo, &slots);
         HadesSendHdr10PlusHdmi(pDispEvo, head, hdr10PlusGeneric, &slots);
+    } else if (!hdr10PlusGeneric &&
+               HadesDolbyHdmiVicMode(pDispEvo, head, pInfoFrameState)) {
+        /* Hades: NVKMS's HDMI_VIC one in shared generic slot 9 (HadesSendOwnVsifShared()) */
+        HadesSendOwnVsifShared(pDispEvo, head, pInfoFrameState, pEdidInfo);
     } else {
         /* Hades: shared generic slot 9 (HadesSendHdr10PlusShared()) */
         HadesSendHdr10PlusShared(pDispEvo, head, hdr10PlusGeneric);
-- 
2.53.0

