From 1aff91e340e09b1cde191d0342168ee74258cf05 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:27:57 +0000
Subject: [PATCH] nvkms: the HDMI_VIC vendor InfoFrame next to HDR, in the
 generic slot

A display whose HDMI 1.4b VSDB lists the 4K formats by HDMI_VIC (3840x2160
at 23.976 to 30 Hz, 4096x2160 at 24) and whose HF-VSDB does not set
UHD_VIC gets those modes from NVKMS by their HDMI_VIC timing:
prioritizeEdidHDMIExtTiming() puts them first in the list of the EDID and
nvFindEdidNVT_TIMING() takes the CTA ones first only with UHD_VIC. The AVI
InfoFrame then says VIC 0 (NvTiming_ConstructVideoInfoframeCtrl(): "for
HDMI_EXT timing, AVI VIC should be 0") and NVKMS sends its HDMI vendor
InfoFrame with the HDMI_VIC (ConstructVSInfoFrameCtrl()). On Turing,
Ampere and Ada the HDR InfoFrame goes through the same vendor-specific slot
(nvEvo1SendHdmiInfoFrame()), so with HDR10 it overwrites that vendor
InfoFrame: the display gets VIC 0 and no HDMI_VIC at all, only the timing.
Of 461 HDR EDIDs at hand, 430 are such displays.

With the HDR InfoFrame enabled (not the SDR one of a transition), that
vendor InfoFrame now goes in the generic InfoFrame slot, where it is free:
not while HDMI VRR sends its EMP there, not where RM keeps it for its ACR
workaround (GA10x), and not while an HDR10+ InfoFrame needs it, which keeps
it as before (9020); a flip of the HDR10+ InfoFrame alone gives the slot
back to it when it ends. The display then gets what NVKMS sends it on the
HALs with generic shared InfoFrames (Blackwell), and what Linux sends it
from i915 and amdgpu: AVI VIC 0, the HDMI vendor InfoFrame with the
HDMI_VIC, and the HDR InfoFrame (drm_mode_cea_vic() and
drm_hdmi_vendor_infoframe_from_display_mode() of drm_edid.c; separate
packets in intel_hdmi.c and dc_resource.c).

Nothing else changes: the vendor-specific slot and the AVI InfoFrame carry
the same bytes as before in every case, as do SDR, the SDR transition,
HDR10+, Dolby Vision and every mode with a CTA VIC; a display with UHD_VIC
(which takes the UHD formats by their CTA VIC, and for which NVKMS matches
those first) is left exactly as it was, the LG C5 included, also at
4096x2160 at 24.000 Hz, the one mode it gets by HDMI_VIC. The kernel log
says when it starts ("Hades: head N sends the HDR InfoFrame in the
vendor-specific slot, and the HDMI_VIC vendor InfoFrame of the mode in the
generic InfoFrame slot").
---
 src/nvidia-modeset/include/nvkms-hades.h | 24 +++++++++++++++++++-----
 src/nvidia-modeset/src/nvkms-hdmi.c      | 17 ++++++++++++++---
 src/nvidia-modeset/src/nvkms-hw-flip.c   |  6 ++++--
 3 files changed, 37 insertions(+), 10 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 7683601..d601e05 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -323,7 +323,15 @@ static inline NvBool nvHadesIsDolbyVsif(const NvU8 *payload, NvU32 size)
  *    25 or 30 Hz from the HDMI VSDB of a display without UHD_VIC), and NONE:
  *    the HDR InfoFrame, where the display takes it (hdrSink), in the
  *    vendor-specific slot and over the vendor one, as NVKMS sends it to every
- *    display that does not declare 3D.
+ *    display that does not declare 3D; and, for NVKMS_2D with HDR to a display
+ *    without UHD_VIC (uhdVic: the HF-VSDB says it takes the UHD formats by
+ *    their CTA VIC, which NVKMS then matches first: nvFindEdidNVT_TIMING()),
+ *    the vendor one in the generic slot where it is free and no HDR10+
+ *    InfoFrame needs it (else as before: the HDR InfoFrame over it). That is
+ *    what such a display gets from NVKMS on the HALs with generic shared
+ *    InfoFrames, and from Linux: an AVI VIC of 0, the HDMI vendor InfoFrame
+ *    with the HDMI_VIC, and the HDR InfoFrame (drm_mode_cea_vic(),
+ *    drm_hdmi_vendor_infoframe_from_display_mode()).
  * An HDR10+ InfoFrame goes in its slot (nvHadesHdr10PlusHdmiSlot()), where a
  * vendor InfoFrame in the generic slot holds that slot as the EMP does:
  * shared generic slot 2 on AD10x, none on Turing and Ampere; and in none
@@ -331,9 +339,9 @@ static inline NvBool nvHadesIsDolbyVsif(const NvU8 *payload, NvU32 size)
  * for it.
  *
  * To a display that does not declare HDMI 3D (no FRAME_PACKING then: NVKMS
- * does not send it) this is what NVKMS sent, slot by slot, with one addition:
- * the HDR InfoFrame next to a CLIENT vendor InfoFrame, which no flip could
- * carry before.
+ * does not send it) this is what NVKMS sent, slot by slot, with two
+ * additions: the HDR InfoFrame next to a CLIENT vendor InfoFrame, which no
+ * flip could carry before, and the HDMI_VIC one in the generic slot with HDR.
  */
 #define NV_HADES_VENDOR_NONE          0
 #define NV_HADES_VENDOR_DOLBY         1
@@ -355,7 +363,8 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
                                                        NvBool hdrEnabled,
                                                        NvBool hdmiVrrEmp,
                                                        NvBool rmGeneric,
-                                                       NvBool adaSharedGenerics)
+                                                       NvBool adaSharedGenerics,
+                                                       NvBool uhdVic)
 {
     struct NvHadesHdmiSlots s;
 
@@ -380,6 +389,11 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
             s.hdrLeftOut = NV_TRUE;
         }
         break;
+    case NV_HADES_VENDOR_NVKMS_2D:
+        if (hdrSink && hdrEnabled && !uhdVic && !hdmiVrrEmp && !rmGeneric && !hdr10Plus) {
+            s.vendorGeneric = NV_TRUE;
+        }
+        break;
     default:
         break;
     }
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index cadaf27..a952cdb 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -715,7 +715,8 @@ static struct NvHadesHdmiSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
                                 NVKMS_HDR_INFOFRAME_STATE_ENABLED,
                             nvHadesHdmiVrrEmp(pHeadState),
                             nvHadesHdmiRmGeneric(pDevEvo),
-                            pDevEvo->dispClass == NVC770_DISPLAY);
+                            pDevEvo->dispClass == NVC770_DISPLAY,
+                            pEdidInfo->hdmiForumInfo.uhd_vic != 0);
 }
 
 /*
@@ -807,6 +808,8 @@ static void HadesLogSlots(const NVDispEvoRec *pDispEvo,
     const NvU8 now = pSlots->vendorGeneric ? 1 : (pSlots->hdrLeftOut ? 2 : 0);
     const char *what = (vendor == NV_HADES_VENDOR_FRAME_PACKING) ?
         "the 3D vendor InfoFrame of the frame-packed mode" :
+        (vendor == NV_HADES_VENDOR_NVKMS_2D) ?
+        "the HDMI_VIC vendor InfoFrame of the mode" :
         "the client's vendor InfoFrame";
 
     if ((now == 1) && (*pLogged != 1)) {
@@ -1148,12 +1151,20 @@ void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
     if (!pDevEvo->caps.supportsGenericSharedInfoFrames) {
         /*
          * the slot of nvHadesHdmiSlots(); a flip of the HDR10+ InfoFrame alone
-         * changes neither the vendor InfoFrame nor the HDR one
+         * changes neither the vendor InfoFrame nor the HDR one, but it can take
+         * the generic slot from the HDMI_VIC one and give it back
          */
+        NvU32 vendor;
         const struct NvHadesHdmiSlots slots =
             HadesHdmiSlotsOf(pDispEvo, head, pInfoFrameState,
-                             &pDpyEvo->parsedEdid.info, NULL);
+                             &pDpyEvo->parsedEdid.info, &vendor);
 
+        if ((pDevEvo->hadesVendorGeneric[pDispEvo->displayOwner][head] != 0) !=
+            slots.vendorGeneric) {
+            HadesLogSlots(pDispEvo, head, vendor, &slots);
+            HadesSendVendorGeneric(pDispEvo, head, pInfoFrameState,
+                                   &pDpyEvo->parsedEdid.info, &slots);
+        }
         HadesSendHdr10PlusHdmi(pDispEvo, head,
             nvHadesHdr10PlusInOwnSlot(pDevEvo, &pDispEvo->headState[head]),
             &slots);
diff --git a/src/nvidia-modeset/src/nvkms-hw-flip.c b/src/nvidia-modeset/src/nvkms-hw-flip.c
index 3ad5587..fca5fbf 100644
--- a/src/nvidia-modeset/src/nvkms-hw-flip.c
+++ b/src/nvidia-modeset/src/nvkms-hw-flip.c
@@ -1961,7 +1961,8 @@ static NvBool HadesHdr10PlusAllowed(const NVDevEvoRec *pDevEvo,
                                    NV_TRUE, NV_TRUE, NV_TRUE,
                                    nvIsAdaptiveSyncDpyVrrType(pTimings->vrr.type),
                                    nvHadesHdmiRmGeneric(pDevEvo),
-                                   pDevEvo->dispClass == NVC770_DISPLAY).hdr10PlusRefusal;
+                                   pDevEvo->dispClass == NVC770_DISPLAY,
+                                   NV_FALSE).hdr10PlusRefusal;
     }
 
     if ((head < NV_MAX_HEADS) &&
@@ -2037,7 +2038,8 @@ static NvBool ValidateHdmiVsif(const NVDevEvoRec *pDevEvo,
                                   (pTimings != NULL) &&
                                       nvIsAdaptiveSyncDpyVrrType(pTimings->vrr.type),
                                   nvHadesHdmiRmGeneric(pDevEvo),
-                                  pDevEvo->dispClass == NVC770_DISPLAY).vendorGeneric) {
+                                  pDevEvo->dispClass == NVC770_DISPLAY,
+                                  NV_FALSE).vendorGeneric) {
                 return FALSE;
             }
         }
-- 
