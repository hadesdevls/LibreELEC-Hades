From e5d32c01783973d3914c7be1f4be61e2438848a6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:26:14 +0000
Subject: [PATCH] nvidia-drm: NV_HDMI_DV_LOW_LATENCY on dual-mode DisplayPort
 connectors too

A DisplayPort connector with a TMDS output of the GPU (a dual-mode port,
the HDMI port of some laptops) gets the HDMI properties of nvidia-drm when
its TMDS encoder is added (nv_drm_connector_add_dual_mode_tmds(),
nvidia-open-kernel-modules-9011): NV_HDMI_VSIF_METADATA and "max bpc",
and NV_HDMI_DV_HDMI14B (9045). NV_HDMI_DV_LOW_LATENCY (9030) was attached
in the HDMI connectors' path only, so on such a connector the atomic check
refused the Low-Latency Dolby VSIF (it needs the property, and the property
could not be set), while everything else Low-Latency needs is there: NVKMS
sends a client's VSIF through that TMDS output (9010) and the AVI InfoFrame
of a head that drives it, Low-Latency's included, through the same
nvUpdateHdmiInfoFrames() as on an HDMI connector; on its DisplayPort output
NVKMS refuses any client VSIF, so the property is refused there with it.
Kodi offers Low-Latency on the NVIDIA backend where the connector has the
property (CDVBridgeState::SupportsLowLatency()), and takes a dual-mode
connector as that backend while NV_DUAL_MODE_TMDS is 1. The 580 port
(nvidia-legacy-open-9052) attaches it there already.

The property is attached there too, next to the other two; HDMI connectors,
and DisplayPort connectors without a TMDS output, are not changed.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index a11c0ed..4d586d6 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1452,6 +1452,12 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
         drm_object_attach_property(&nv_connector->base.base,
                                    nv_dev->nv_connector_hdmi_vsif_metadata_property,
                                    0);
+        /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel */
+        if (nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+            drm_object_attach_property(&nv_connector->base.base,
+                                       nv_dev->nv_connector_hdmi_dv_low_latency_property,
+                                       0);
+        }
         /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
         if (nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
             drm_object_attach_property(&nv_connector->base.base,
