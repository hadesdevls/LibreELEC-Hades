From 677d634a588fcdbd096eccb157a7d27c980dd4c0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:01:44 +0000
Subject: [PATCH] nvidia-drm: no Dolby Vision VSIF left on for the console

When Kodi dies in a Dolby Vision video (a crash, kill -9), the fbdev console
of nvidia-drm (nvidia-drm.fbdev=1, the default) takes the display back with
a commit of the in-kernel client, made of a duplicate of every connector
state. NV_HDMI_VSIF_METADATA still holds the Dolby VSIF of the tunnel (and
NV_HDMI_DV_LOW_LATENCY, HDR10PLUS_VSIF what Kodi set), so the console goes
out next to it, as a tunnel the display cannot read, until Kodi starts again.

Hades' Linux 7.3 calls &drm_connector_funcs.atomic_client_restore on the new
state of every connector of such a commit (drm_client_modeset.c), as i915
and amdgpu use it for DVBRIDGE_DV_STANDARD_LAB. nvidia-drm drops the user
VSIF, HDR10+ and Low-Latency there, and says so in the kernel log; dithering
and "max bpc", which only keep the console exact, stay. Built only where the
kernel has the hook (DRM_CONNECTOR_HAS_ATOMIC_CLIENT_RESTORE); nothing
changes while user space holds the display.

On hardware: in a Dolby Vision video, kill -9 the Kodi process; the TV
leaves Dolby Vision for the console, the kernel log has the line, and
modetest -c shows NV_HDMI_VSIF_METADATA 0 on the connector.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 71ec939..8f501d8 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -499,6 +499,41 @@ static int nv_drm_connector_atomic_get_property(
     return -EINVAL;
 }
 
+
+#if defined(DRM_CONNECTOR_HAS_ATOMIC_CLIENT_RESTORE)
+/*
+ * Hades: the in-kernel client (the fbdev console of nvidia-drm.fbdev=1, the
+ * default) takes the display back with a commit made of a duplicate of every
+ * connector state (&drm_connector_funcs.atomic_client_restore, in Hades'
+ * Linux). When Kodi dies in a Dolby Vision video, that state still has the
+ * Dolby VSIF of the tunnel in NV_HDMI_VSIF_METADATA (and Low-Latency, or
+ * HDR10+): the console would go out next to it, as a tunnel the display
+ * cannot read. They are dropped from the state of the client's commit;
+ * dithering and "max bpc", which only make the console exact, stay.
+ */
+static void nv_drm_connector_atomic_client_restore(
+    struct drm_connector *connector,
+    struct drm_connector_state *state)
+{
+    struct nv_drm_connector_state *s = to_nv_drm_connector_state(state);
+
+    if (s->hdmi_vsif_metadata != NULL || s->hdr10plus_vsif != NULL ||
+        s->hdmi_dv_low_latency) {
+        drm_info(connector->dev,
+                 "[CONNECTOR:%d:%s] the console takes the display: "
+                 "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s, "
+                 "NV_HDMI_DV_LOW_LATENCY %d dropped\n",
+                 connector->base.id, connector->name,
+                 s->hdmi_vsif_metadata != NULL ? "set" : "none",
+                 s->hdr10plus_vsif != NULL ? "set" : "none",
+                 s->hdmi_dv_low_latency);
+    }
+    drm_property_replace_blob(&s->hdmi_vsif_metadata, NULL);
+    drm_property_replace_blob(&s->hdr10plus_vsif, NULL);
+    s->hdmi_dv_low_latency = false;
+}
+#endif
+
 static struct drm_connector_funcs nv_connector_funcs = {
     .destroy                = nv_drm_connector_destroy,
 #if defined(NV_DRM_CONNECTOR_FUNCS_HAS_ATOMIC_CREATE_STATE)
@@ -513,6 +548,10 @@ static struct drm_connector_funcs nv_connector_funcs = {
     .atomic_destroy_state   = nv_drm_connector_atomic_destroy_state,
     .atomic_set_property    = nv_drm_connector_atomic_set_property,
     .atomic_get_property    = nv_drm_connector_atomic_get_property,
+#if defined(DRM_CONNECTOR_HAS_ATOMIC_CLIENT_RESTORE)
+    /* Hades: no Dolby Vision VSIF left on for the console */
+    .atomic_client_restore  = nv_drm_connector_atomic_client_restore,
+#endif
 };
 
 /*
