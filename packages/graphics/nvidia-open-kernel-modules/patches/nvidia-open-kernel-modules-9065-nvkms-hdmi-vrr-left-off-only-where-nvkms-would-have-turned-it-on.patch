From 27edd001ee5dc1ee0fbbe9a701d59d5ef899fd59 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:00:00 +0000
Subject: [PATCH 3/3] nvkms: "HDMI VRR left off" only where NVKMS would have
 turned it on

nvidia-open-kernel-modules-9051 says in the kernel log, at each mode set of an
HDMI head whose client left HDMI VRR off (NV_HDMI_VRR_OFF), that VRR was left
off where it would have been on; "would have been on" was a VRR type for the
mode (nvGetAllowedDpyVrrType(): an Adaptive-Sync display, 50 Hz and 720 lines
up). But NVKMS gives the timings VRR only where their refresh rate is also at
least 110 % of the display's VRR minimum (nvAdjustHwModeTimingsForVrrEvo()):
a display whose HDMI VRR starts at 48 Hz has it at 59.94 and 60 Hz (52.8 Hz
and up), and not at 50 Hz. The line came at 50 Hz on such a display, where
nothing was left off, and that is the one rate that tells it apart (issue 4 of
Hades: Dolby Vision that the TV took at 3840x2160 and 50 Hz and not at 60 Hz;
its EDID declares VRR from 48 to 120 Hz). Kodi now leaves HDMI VRR off during
native Dolby Vision too, so the line's reason ("so that HDR10+ has the generic
InfoFrame slot") was not always the one.

The minimum of nvAdjustHwModeTimingsForVrrEvo() (the EDID's, or the client's
override where an Adaptive-Sync display allows one) is taken out into
GetVrrMinRefreshRate() as it was, and nvHadesVrrWouldEngage() asks the same
110 % of it; the line comes only where both say VRR would have been on, and
names NV_HDMI_VRR_OFF and both of its uses. What goes out does not change: the
mode set of 9051 and the timings of nvAdjustHwModeTimingsForVrrEvo() are the
same.

Checked with a host test that builds GetVrrMinRefreshRate(),
nvHadesVrrWouldEngage() and nvAdjustHwModeTimingsForVrrEvo() of nvkms-vrr.c,
AdjustHwModeTimingsForVrr() of nvkms-modeset.c and nvkms-hades.h, as the tree
has them, and nvAdjustHwModeTimingsForVrrEvo() of the tree before this change:
the same timings from both for every VRR minimum, refresh rate, VRR type and
override, gaming and media VRR, of a grid of 1920, nvHadesVrrWouldEngage() saying yes exactly where
they give VRR, and the line at 59.94 and 60 Hz and not at 50 or 23.976 Hz on a
display with VRR from 48 Hz, at 50 Hz on one from 40 Hz (3858 checks; 2 fail
on the tree before this change); 6 mutations, each caught. The five modules
build against Linux 7.3.4 with the compiler of the image. Not run on a GPU.
---
 src/nvidia-modeset/include/nvkms-vrr.h |  3 ++
 src/nvidia-modeset/src/nvkms-modeset.c | 12 ++++--
 src/nvidia-modeset/src/nvkms-vrr.c     | 53 +++++++++++++++++++++++---
 3 files changed, 59 insertions(+), 9 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-vrr.h b/src/nvidia-modeset/include/nvkms-vrr.h
index 9718ddd..9a5eab6 100644
--- a/src/nvidia-modeset/include/nvkms-vrr.h
+++ b/src/nvidia-modeset/include/nvkms-vrr.h
@@ -37,6 +37,9 @@ nvGetAllowedDpyVrrType(const NVDpyEvoRec *pDpyEvo,
                        enum NvKmsStereoMode stereoMode,
                        const NvBool allowGsync,
                        const enum NvKmsAllowAdaptiveSync allowAdaptiveSync);
+NvBool nvHadesVrrWouldEngage(const NVDpyEvoRec *pDpyEvo,
+                             const NvU32 vrrOverrideMinRefreshRate,
+                             const NVHwModeTimingsEvo *pTimings);
 void nvAdjustHwModeTimingsForVrrEvo(
     const NVDpyEvoRec *pDpyEvo,
     const enum NvKmsRequestedVrrType vrrType,
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index 812770b..5b51e87 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -653,7 +653,11 @@ static NvBool AdjustHwModeTimingsForVrr(const NVDispEvoRec *pDispEvo,
     /*
      * Hades: HDMI VRR left off where it would have been on
      * (nvHadesHdmiVrrLeftOff(); what it would have been is asked only where
-     * Adaptive-Sync was not allowed)
+     * Adaptive-Sync was not allowed): a VRR type for the mode
+     * (nvGetAllowedDpyVrrType(): 50 Hz and 720 lines up) and a refresh rate of
+     * at least 110 % of the display's VRR minimum, without which
+     * nvAdjustHwModeTimingsForVrrEvo() gives the timings no VRR either
+     * (nvHadesVrrWouldEngage())
      */
     if (pRequestHead->allowAdaptiveSync == NVKMS_ALLOW_ADAPTIVE_SYNC_DISABLED) {
         const NvBool hdmiDpy = nvDpyIsHdmiEvo(pDpyEvo) &&
@@ -667,7 +671,9 @@ static NvBool AdjustHwModeTimingsForVrr(const NVDispEvoRec *pDispEvo,
                                        &pRequestHead->mode.timings,
                                        pRequestHead->modeValidationParams.stereoMode,
                                        allowGsync,
-                                       NVKMS_ALLOW_ADAPTIVE_SYNC_ALL)));
+                                       NVKMS_ALLOW_ADAPTIVE_SYNC_ALL)) &&
+            nvHadesVrrWouldEngage(pDpyEvo, vrrOverrideMinRefreshRate,
+                                  pTimings));
     }
 
     if (dpyVrrType == NVKMS_DPY_VRR_TYPE_NONE) {
@@ -3335,7 +3341,7 @@ ApplyProposedModeSetHwStateOneHeadPreUpdate(
                 /* Hades: HDMI VRR left off (nvHadesHdmiVrrLeftOff()) */
                 if (pProposedApiHead->hadesHdmiVrrLeftOff) {
                     nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
-                                 "Hades: head %u: HDMI VRR left off in this mode set so that HDR10+ has the generic InfoFrame slot",
+                                 "Hades: head %u: HDMI VRR left off in this mode set, where it would have been on, as its client asked (NV_HDMI_VRR_OFF: the generic InfoFrame slot for HDR10+, or Dolby Vision without the VRR packet)",
                                  head);
                 }
             }
diff --git a/src/nvidia-modeset/src/nvkms-vrr.c b/src/nvidia-modeset/src/nvkms-vrr.c
index c6b8fb8..2154067 100644
--- a/src/nvidia-modeset/src/nvkms-vrr.c
+++ b/src/nvidia-modeset/src/nvkms-vrr.c
@@ -265,11 +265,16 @@ static NvBool GetEdidMinRefreshRate(
     return TRUE;
 }
 
-/*! Adjust mode timings as necessary for VRR. */
-void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
-                                    const enum NvKmsRequestedVrrType vrrType,
-                                    const NvU32 vrrOverrideMinRefreshRate,
-                                    NVHwModeTimingsEvoPtr pTimings)
+/*
+ * The VRR minimum refresh rate of these timings on this display: the EDID's,
+ * or the client's override where an Adaptive-Sync display allows one; FALSE
+ * where VRR is not possible (Hades: taken out of
+ * nvAdjustHwModeTimingsForVrrEvo() as it was, for nvHadesVrrWouldEngage()).
+ */
+static NvBool GetVrrMinRefreshRate(const NVDpyEvoRec *pDpyEvo,
+                                   const NvU32 vrrOverrideMinRefreshRate,
+                                   const NVHwModeTimingsEvo *pTimings,
+                                   NvU32 *pMinRefreshRate)
 {
     NvU32 minRefreshRate;
     NvU32 edidMinRefreshRate;
@@ -277,7 +282,7 @@ void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
     if (!GetEdidMinRefreshRate(pDpyEvo,
                                pTimings,
                                &edidMinRefreshRate)) {
-        return;
+        return FALSE;
     }
 
     // Allow overriding the EDID min refresh rate on Adaptive-Sync
@@ -303,6 +308,42 @@ void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
         minRefreshRate = edidMinRefreshRate;
     }
 
+    *pMinRefreshRate = minRefreshRate;
+    return TRUE;
+}
+
+/*
+ * Hades: whether nvAdjustHwModeTimingsForVrrEvo() gives these timings VRR on
+ * this display: VRR is possible on it and the refresh rate is at least 110 %
+ * of its VRR minimum (a display whose HDMI VRR starts at 48 Hz has it at
+ * 59.94 Hz, not at 50). For the kernel log (nvHadesHdmiVrrLeftOff()).
+ */
+NvBool nvHadesVrrWouldEngage(const NVDpyEvoRec *pDpyEvo,
+                             const NvU32 vrrOverrideMinRefreshRate,
+                             const NVHwModeTimingsEvo *pTimings)
+{
+    NvU32 minRefreshRate;
+
+    if (!GetVrrMinRefreshRate(pDpyEvo, vrrOverrideMinRefreshRate, pTimings,
+                              &minRefreshRate)) {
+        return FALSE;
+    }
+    return nvGetRefreshRatex10K(pTimings) >= ((NvU64) 11000 * minRefreshRate);
+}
+
+/*! Adjust mode timings as necessary for VRR. */
+void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
+                                    const enum NvKmsRequestedVrrType vrrType,
+                                    const NvU32 vrrOverrideMinRefreshRate,
+                                    NVHwModeTimingsEvoPtr pTimings)
+{
+    NvU32 minRefreshRate;
+
+    if (!GetVrrMinRefreshRate(pDpyEvo, vrrOverrideMinRefreshRate, pTimings,
+                              &minRefreshRate)) {
+        return;
+    }
+
     pTimings->vrr.minRefreshRate = minRefreshRate;
 
     // Disallow VRR if the refresh rate is less than 110% of the VRR minimum
-- 
2.53.0

