 kernel-open/common/inc/nvkms-kapi.h           |  30 +++++
 kernel-open/nvidia-drm/nvidia-drm-connector.c |  29 ++++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  26 ++++
 kernel-open/nvidia-drm/nvidia-drm-modeset.c   |  10 ++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |   3 +
 src/nvidia-modeset/interface/nvkms-api.h      |  20 +++
 .../kapi/interface/nvkms-kapi.h               |  30 +++++
 src/nvidia-modeset/kapi/src/nvkms-kapi.c      |  64 +++++++++
 src/nvidia-modeset/src/nvkms-attributes.c     | 124 ++++++++++++++++++
 9 files changed, 336 insertions(+)

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index c8de646..29968a7 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -1772,6 +1772,36 @@ struct NvKmsKapiFunctionsTable {
         NvU32 *bpc
     );
 
+    /*!
+     * Hades: the I2C port of the DDC of a display's connector
+     * (NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT): the index of the adapter
+     * "NVIDIA i2c adapter <index> at <bus>:<slot>.<fn>" of the nvidia module;
+     * 255 where there is none.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayDdcI2cPort)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *port
+    );
+
+    /*!
+     * Hades: how NVKMS drives a display now
+     * (NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK): 0 where no head drives it;
+     * bits 0-7 1 TMDS, 2 TMDS scrambled, 3 HDMI FRL, 4 DisplayPort; bits 8-15
+     * the FRL rate; bits 16-23 0 RGB, 1 YCbCr 4:4:4, 2 4:2:2, 3 4:2:0.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayOutputLink)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *link
+    );
+
     /*!
      * Hades: where an HDR10+ vendor InfoFrame can go out through the connector
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 345b751..16f6446 100644
