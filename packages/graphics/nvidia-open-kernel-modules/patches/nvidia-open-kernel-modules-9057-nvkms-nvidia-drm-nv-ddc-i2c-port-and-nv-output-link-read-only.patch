     nv_connector->nv_detected_encoder = nv_detected_encoder;
 
+    /*
+     * Hades: NV_DDC_I2C_PORT, the I2C port of the DDC of the display found
+     * (NVKMS, from RM); it stays when the display goes
+     */
+    if (nv_dev->nv_connector_ddc_i2c_port_property) {
+        NvU32 port = 255;
+
+        if (!nvKms->getDisplayDdcI2cPort(nv_dev->pDevice,
+                                         nv_detected_encoder->hDisplay, &port) ||
+            (port > 255)) {
+            port = 255;
+        }
+        drm_object_property_set_value(&connector->base,
+                                      nv_dev->nv_connector_ddc_i2c_port_property,
+                                      port);
+    }
+
     if (nv_connector->type == NVKMS_CONNECTOR_TYPE_DVI_I) {
         drm_object_property_set_value(
             &connector->base,
@@ -1575,6 +1592,18 @@ nv_drm_connector_new(struct drm_device *dev,
                                    0);
     }
 
+    /* Hades: the I2C port of the DDC (NV_DDC_I2C_PORT), and the link (NV_OUTPUT_LINK) */
+    if (nv_dev->nv_connector_ddc_i2c_port_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_ddc_i2c_port_property,
+                                   255);
+    }
+    if (nv_dev->nv_connector_output_link_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_output_link_property,
+                                   0);
+    }
+
     /* Attach dithering mode property */
     if (nv_dev->nv_connector_dithering_mode_property) {
         drm_object_attach_property(&nv_connector->base.base,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 72665d3..b1c2bad 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -764,6 +764,32 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, on every connector. NV_DDC_I2C_PORT: the index of the
+     * I2C adapter of the DDC of its display, "NVIDIA i2c adapter <index> at
+     * <bus>:<slot>.<fn>" of the nvidia module, set when a display is detected
+     * there; 255 for none or not known. NV_OUTPUT_LINK: how NVKMS drives its
+     * display (NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK: bits 0-7 1 TMDS, 2 TMDS
+     * scrambled, 3 HDMI FRL, 4 DisplayPort; bits 8-15 the FRL rate; bits 16-23
+     * 0 RGB, 1 YCbCr 4:4:4, 2 4:2:2, 3 4:2:0), as of the last mode set
+     * committed through this device, as NV_OUTPUT_BPC; 0 while the connector
+     * drives nothing or when NVKMS does not say.
+     */
+    nv_dev->nv_connector_ddc_i2c_port_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_DDC_I2C_PORT", 0, 255);
+    if (nv_dev->nv_connector_ddc_i2c_port_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create NV_DDC_I2C_PORT property");
+        return -ENOMEM;
+    }
+    nv_dev->nv_connector_output_link_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_OUTPUT_LINK", 0, 0xffffffffULL);
+    if (nv_dev->nv_connector_output_link_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create NV_OUTPUT_LINK property");
+        return -ENOMEM;
+    }
+
     // Color Pipeline Passthrough Properties
     nv_dev->nv_plane_color_passthrough_property =
         drm_property_create_bool(nv_dev->dev, 0,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-modeset.c b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
index c005aab..a2e310b 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-modeset.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
@@ -526,6 +526,7 @@ nv_drm_atomic_apply_modeset_config(struct drm_device *dev,
 
         for_each_new_connector_in_state(state, connector, connector_state, j) {
             NvU32 bpc = 0;
+            NvU32 link = 0; /* Hades: NV_OUTPUT_LINK */
             struct drm_crtc *head_crtc = connector_state->crtc;
 
             if (head_crtc != NULL && head_crtc->state != NULL &&
@@ -549,11 +550,20 @@ nv_drm_atomic_apply_modeset_config(struct drm_device *dev,
                                                nv_encoder->hDisplay, &bpc)) {
                     bpc = 0;
                 }
+                if (!nvKms->getDisplayOutputLink(nv_dev->pDevice,
+                                                 nv_encoder->hDisplay, &link)) {
