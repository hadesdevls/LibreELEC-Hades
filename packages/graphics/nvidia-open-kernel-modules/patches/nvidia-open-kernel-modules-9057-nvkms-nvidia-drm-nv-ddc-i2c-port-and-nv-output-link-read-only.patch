diff --git a/src/nvidia-modeset/interface/nvkms-api.h b/src/nvidia-modeset/interface/nvkms-api.h
index 96d57e3..b1eacee 100644
--- a/src/nvidia-modeset/interface/nvkms-api.h
+++ b/src/nvidia-modeset/interface/nvkms-api.h
@@ -2828,6 +2828,26 @@ enum NvKmsDpyAttribute {
      * connector of the dpy, a mask: 0x1 HDMI, 0x2 DisplayPort. Read-only.
      */
     NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS,
+
+    /*
+     * Hades: the I2C port of the DDC of the dpy's connector: ddcPortId - 1 of
+     * NV0073_CTRL_CMD_SPECIFIC_GET_I2C_PORTID (whose ddcPortId counts from 1,
+     * 0 for none), the index under which the nvidia module registers the I2C
+     * adapter of that port, "NVIDIA i2c adapter <index> at <bus>:<slot>.<fn>"
+     * (RmI2cAddGpuPorts(), rm_i2c_add_adapter(), nv_i2c_add_adapter()), where
+     * it registers one. 255 where there is no port or RM does not say.
+     * Read-only.
+     */
+    NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT,
+
+    /*
+     * Hades: how the head that drives the dpy sends it now; 0 where no head
+     * drives it. Bits 0-7: 1 TMDS not scrambled, 2 TMDS scrambled (a TMDS
+     * character rate above 340 MHz), 3 HDMI FRL, 4 DisplayPort; bits 8-15: the
+     * HDMI_FRL_DATA_RATE of FRL (1..6), 0 otherwise; bits 16-23: the pixel
+     * format, 0 RGB, 1 YCbCr 4:4:4, 2 YCbCr 4:2:2, 3 YCbCr 4:2:0. Read-only.
+     */
+    NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK,
 };
 
 /*
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index c8de646..29968a7 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -1772,6 +1772,36 @@ struct NvKmsKapiFunctionsTable {
         NvU32 *bpc
     );
 
+    /*!
+     * Hades: the I2C port of the DDC of a display's connector
+     * (NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT): the index of the adapter
+     * "NVIDIA i2c adapter <index> at <bus>:<slot>.<fn>" of the nvidia module;
+     * 255 where there is none.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayDdcI2cPort)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *port
+    );
+
+    /*!
+     * Hades: how NVKMS drives a display now
+     * (NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK): 0 where no head drives it;
+     * bits 0-7 1 TMDS, 2 TMDS scrambled, 3 HDMI FRL, 4 DisplayPort; bits 8-15
+     * the FRL rate; bits 16-23 0 RGB, 1 YCbCr 4:4:4, 2 4:2:2, 3 4:2:0.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayOutputLink)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *link
+    );
+
     /*!
      * Hades: where an HDR10+ vendor InfoFrame can go out through the connector
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index c8bc1eb..ba4e19a 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -1475,6 +1475,68 @@ done:
     return status;
 }
 
+/*
+ * Hades: a Hades dpy attribute of a display (nvkms-api.h), as a value of 32
+ * bits; NV_FALSE when NVKMS does not answer or the value does not fit.
+ */
+static NvBool GetHadesDpyAttribute(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    enum NvKmsDpyAttribute attribute,
+    NvU32 *value)
+{
+    struct NvKmsGetDpyAttributeParams params = { };
+
+    if (device == NULL || value == NULL) {
+        return NV_FALSE;
+    }
+
+    params.request.deviceHandle = device->hKmsDevice;
+    params.request.dispHandle   = device->hKmsDisp;
+    params.request.dpyId        = nvNvU32ToDpyId(display);
+    params.request.attribute    = attribute;
+
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+                               NVKMS_IOCTL_GET_DPY_ATTRIBUTE,
+                               &params, sizeof(params))) {
+        return NV_FALSE;
+    }
+
+    if (params.reply.value < 0 || params.reply.value > 0xffffffffLL) {
+        return NV_FALSE;
+    }
+
+    *value = (NvU32)params.reply.value;
+    return NV_TRUE;
+}
+
+/* Hades: NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT; 255 when NVKMS does not say */
+static NvBool GetDisplayDdcI2cPort(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvU32 *port)
+{
+    if (port != NULL) {
+        *port = 255;
+    }
+    return GetHadesDpyAttribute(device, display,
+                                NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT, port) &&
+           (*port <= 255);
+}
+
+/* Hades: NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK; 0 when NVKMS does not say */
+static NvBool GetDisplayOutputLink(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvU32 *link)
+{
+    if (link != NULL) {
+        *link = 0;
+    }
+    return GetHadesDpyAttribute(device, display,
+                                NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK, link);
+}
+
 /*
  * Hades: the bits per component at which NVKMS drives a display now, from
  * NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC (NvKmsDpyAttributeColorBpcValue is
@@ -4396,6 +4458,8 @@ NvBool nvKmsKapiGetFunctionsTableInternal
     funcsTable->unregisterVblankIntrCallback = UnregisterVblankIntrCallback;
 
     funcsTable->getDisplayColorBpc = GetDisplayColorBpc;
+    funcsTable->getDisplayDdcI2cPort = GetDisplayDdcI2cPort;
+    funcsTable->getDisplayOutputLink = GetDisplayOutputLink;
     funcsTable->getHdr10PlusRoutes = GetHdr10PlusRoutes;
 
     return NV_TRUE;
diff --git a/src/nvidia-modeset/src/nvkms-attributes.c b/src/nvidia-modeset/src/nvkms-attributes.c
index 5f33b7d..ccb7cba 100644
--- a/src/nvidia-modeset/src/nvkms-attributes.c
+++ b/src/nvidia-modeset/src/nvkms-attributes.c
@@ -34,6 +34,7 @@
 #include "nvkms-hdmi.h"
 #include "dp/nvdp-connector.h"
 
+#include <ctrl/ctrl0073/ctrl0073specific.h> /* Hades: NV0073_CTRL_CMD_SPECIFIC_GET_I2C_PORTID */
 #include <ctrl/ctrl0073/ctrl0073dp.h> // NV0073_CTRL_CMD_DP_GET_LINK_CONFIG_*
 
 /*!
@@ -1134,6 +1135,117 @@ static NvBool GetHadesHdr10Plus(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
     return TRUE;
 }
 
+/*
+ * Hades: NV_KMS_DPY_ATTRIBUTE_HADES_DDC_I2C_PORT (nvkms-api.h). The adapter of
+ * a port: the nvidia module registers one for each implemented and valid port
+ * (index = port) and adds the displays of DisplayPort to the one of
+ * ddcPortId - 1, so the index of the adapter of a connector's DDC is
+ * ddcPortId - 1 of its display; whether the module registered it (it keeps
+ * MAX_I2C_ADAPTERS) is for the reader to see in the adapter's name.
+ */
+static NvBool GetHadesDdcI2cPort(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
+{
+    const NVDispEvoRec *pDispEvo = pDpyEvo->pDispEvo;
+    NV0073_CTRL_SPECIFIC_GET_I2C_PORTID_PARAMS params = { 0 };
+
+    *pValue = 255;
+    if (pDpyEvo->pConnectorEvo == NULL) {
+        return TRUE;
+    }
+    params.subDeviceInstance = pDispEvo->displayOwner;
+    params.displayId = nvDpyIdToNvU32(pDpyEvo->pConnectorEvo->displayId);
+    if ((nvRmApiControl(nvEvoGlobal.clientHandle,
+                        pDispEvo->pDevEvo->displayCommonHandle,
+                        NV0073_CTRL_CMD_SPECIFIC_GET_I2C_PORTID,
+                        &params, sizeof(params)) == NVOS_STATUS_SUCCESS) &&
+        (params.ddcPortId != NV0073_CTRL_SPECIFIC_I2C_PORT_NONE) &&
+        (params.ddcPortId <= 255)) {
+        *pValue = params.ddcPortId - 1;
+    }
+    return TRUE;
+}
+
+/*
+ * Hades: the TMDS character rate of an HDMI mode, in kHz: RGB and YCbCr 4:4:4
+ * carry the pixel clock times bpc / 8, YCbCr 4:2:2 the pixel clock at any
+ * depth, the YCbCr 4:2:0 of the hardware half the pixel clock times bpc / 8
+ * (HDMI 2.0, 7.1 and 7.2; the rule of nvHadesLogHdmiLink() in 615). Above 340
+ * MHz the source scrambles the link (HDMI 2.0, 6.1).
+ */
+static NvU32 HadesLinkTmdsRateKHz(NvU32 pixelClockKHz, NvU32 format,
+                                  NvBool hw420, NvU32 bpc)
+{
+    NvU64 clock = pixelClockKHz;
+
+    if (format == 2) {
+        return pixelClockKHz;
+    }
+    if (hw420) {
+        clock /= 2;
+    }
+    return (NvU32)((clock * ((bpc < 8) ? 8 : bpc)) / 8);
+}
+
+/* Hades: NV_KMS_DPY_ATTRIBUTE_HADES_OUTPUT_LINK (nvkms-api.h) */
+static NvBool GetHadesOutputLink(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
+{
+    const NVDispEvoRec *pDispEvo = pDpyEvo->pDispEvo;
+    const NvU32 apiHead = pDpyEvo->apiHead;
+    const NVDispApiHeadStateEvoRec *pApiHeadState;
+    const NVDispHeadStateEvoRec *pHeadState;
+    const NVHwModeTimingsEvo *pTimings;
+    NvU32 head, kind, rate = 0, format, bpc;
+
+    *pValue = 0;
+    if (apiHead == NV_INVALID_HEAD) {
+        return TRUE;
+    }
+    head = nvGetPrimaryHwHead(pDispEvo, apiHead);
+    if (head == NV_INVALID_HEAD) {
+        return TRUE;
+    }
+    pApiHeadState = &pDispEvo->apiHeadState[apiHead];
+    pHeadState = &pDispEvo->headState[head];
+    pTimings = &pHeadState->timings;
+    if (nvDpyIdListIsEmpty(pApiHeadState->activeDpys) ||
+        (pTimings->pixelClockHz == 0)) {
+        return TRUE;
+    }
+
+    switch (pApiHeadState->attributes.color.format) {
+    case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr444: format = 1; break;
+    case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422: format = 2; break;
+    case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr420: format = 3; break;
+    default: format = 0; break;
+    }
+    if (pTimings->yuv420Mode != NV_YUV420_MODE_NONE) {
+        format = 3;
+    }
+    bpc = (NvU32)pApiHeadState->attributes.color.bpc;
+
+    switch (pTimings->protocol) {
+    case NVKMS_PROTOCOL_SOR_DP_A:
+    case NVKMS_PROTOCOL_SOR_DP_B:
+        kind = 4;
+        break;
+    case NVKMS_PROTOCOL_SOR_HDMI_FRL:
+        kind = 3;
+        rate = (NvU32)pHeadState->hdmiFrlConfig.frlRate & 0xff;
+        break;
