From 4a4c848225734bab86be4b6fa73ab6fe57aa660d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:18:20 +0000
Subject: [PATCH] nvkms: HDR10+ in shared generic slot 9 on the HALs with
 generic shared InfoFrames

On the HALs with generic shared InfoFrames (T239 and Blackwell, the RTX 50
among them) the HDR10+ InfoFrame of HDR10PLUS_VSIF went out as the client's
vendor InfoFrame, in the vendor-specific slot, in place of NVKMS's own vendor
InfoFrame. In the modes that NVKMS signals by their HDMI_VIC (3840x2160 at
24, 25 and 30 Hz and 4096x2160 at 24 Hz, to a display whose HF-VSDB does not
say UHD_VIC: 430 of the 461 HDR EDIDs of the corpus that 9043 measured) the
AVI InfoFrame says VIC 0 there, so with HDR10+ the display was told no format
at all; it also took the 3D vendor InfoFrame of a frame-packed mode (which
nvidia-drm does not let HDR10+ into).

These HALs have ten generic InfoFrames per head
(NVC971_SF_GENERIC_INFOFRAME_CTRL__SIZE_2, the same in clca71.h). NVKMS's
HDMI InfoFrames take 1 to 8, a pair for each of the AVI, the EMP, the
vendor-specific and the HDR InfoFrame (nvEvoSendHdmiInfoFrameC8()); on
DisplayPort its SDPs take 1 to 3 and the HDR10+ SDP of 9020 takes 4.
Nothing else in the open tree writes 9 or 10. The HDR10+ InfoFrame now goes
in shared generic slot 9 of its own:
- laid out as NVKMS lays out an HDMI InfoFrame in these slots
  (nvHadesHdr10PlusHdmiSharedPacket(), as ConstructAdvancedInfoFramePacket():
  the header, HB3 0, the checksum in PB0, the payload), and sent as NVKMS
  sends its own: at the vertical sync, the checksum computed by software and
  asked of the hardware (which the classes of these HALs do not read), every
  frame. Not in a pair: InfoFrames are flip-synchronized only where the HAL
  sets a core FID (T239, not an x86 GPU), and Hades never flip-synchronizes
  an HDR10+ InfoFrame (nvHadesUpdateHdr10Plus()), so NVKMS's own use one
  slot of each pair here too;
- the vendor-specific slot then does what it does without a client VSIF:
  NVKMS's own vendor InfoFrame, the HDMI_VIC with it, as without HDR10+;
- an HDR10+-only flip writes only slot 9 (it wrote the vendor-specific slot);
- the slot is kept per head (nvHadesHdr10PlusSetSlot(), new
  NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9) and turned off when HDR10+ ends or
  the head moves to DisplayPort, with the packet control of the library, as
  the HDR10+ SDP is;
- a write that the library refuses turns the slot off and says so in the
  kernel log ("Hades: the HDR10+ InfoFrame of head N could not be written in
  shared generic slot 9"); "Hades: HDR10+ InfoFrame on head N, in shared
  generic slot 9 (the vendor-specific slot keeps NVKMS's own vendor
  InfoFrame)" when it starts.
The validation of a flip is the same (the slot is never none on these HALs).
Turing, Ampere and Ada, and DisplayPort, are not changed.

What the GSP firmware does with generic InfoFrames 9 and 10 is not in the
open tree: not verified. Not run on a GPU; only a Blackwell GPU and an HDR10+
display can show it.

Checked with a host test that runs nvUpdateHdmiInfoFrames(),
nvHadesUpdateHdmiHdr10Plus(), nvEvoSendHdmiInfoFrameC8() and the HDMI packet
classes C871, C971 and CA71 of the tree on a register file: HDR10+ in generic
InfoFrame 9 with its header, checksum and payload, every frame at the vsync;
the vendor-specific pair with NVKMS's HDMI_VIC vendor InfoFrame next to it;
slot 9 off when HDR10+ ends; against the tree before, every step without
HDR10+ the same.
---
 src/nvidia-modeset/include/nvkms-hades.h | 27 ++++++--
 src/nvidia-modeset/src/nvkms-hdmi.c      | 82 ++++++++++++++++++++----
 2 files changed, 90 insertions(+), 19 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 0999609..2f08c54 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -119,7 +119,7 @@ static inline NvBool nvHadesIsHdr10PlusVsif(const NvU8 *payload, NvU32 size)
  *    On GA10x RM keeps that slot for
  *    its ACR workaround when it reports NV0073_CTRL_SYSTEM_CAPS_HDMI21_SW_ACR_BUG_3275257:
  *    then there is no HDMI route. On the HALs with generic shared InfoFrames
- *    (T239, Blackwell) the vendor-specific InfoFrame has its own slot.
+ *    (T239, Blackwell) it has a shared generic slot of its own.
  *    Also the TMDS output of a dual-mode DisplayPort connector.
  *  - DisplayPort: an InfoFrame SDP, in a shared generic slot that NVKMS does
  *    not use on DisplayPort: SHARED_GENERIC2 of AD10x (NVC771; the first one
@@ -152,8 +152,15 @@ static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
 
 /*
  * The slots of an HDR10+ InfoFrame, and the one it takes on an HDMI signal:
- *  - the HALs with generic shared InfoFrames (T239, Blackwell): the
- *    vendor-specific slot, which is apart from the HDR one there;
+ *  - the HALs with generic shared InfoFrames (T239, Blackwell): shared generic
+ *    slot 9, which NVKMS does not use. It has ten per head there
+ *    (NVC971_SF_GENERIC_INFOFRAME_CTRL__SIZE_2, the same in clca71.h); its
+ *    HDMI InfoFrames take 1 to 8, two for each of the AVI, the EMP, the
+ *    vendor-specific and the HDR InfoFrame (the pair of a flip-synchronized
+ *    update, nvEvoSendHdmiInfoFrameC8()), and on DisplayPort its SDPs take 1
+ *    to 3 and the HDR10+ SDP 4. The vendor-specific slot then keeps NVKMS's
+ *    own vendor InfoFrame (the HDMI_VIC of 4K at 24, 25 and 30 Hz, 3D), which
+ *    the HDR10+ InfoFrame took the place of before;
  *  - Turing, Ampere and Ada: the generic InfoFrame slot, unless the EMP of
  *    HDMI VRR is in it. NVKMS turns HDMI VRR on in each mode set of a display
  *    that declares it, from 50 Hz and 720 lines up (KAPI allows Adaptive-Sync
@@ -166,17 +173,18 @@ static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
  * InfoFrames (nvHadesHdr10PlusRoutes()).
  */
 #define NV_HADES_HDR10PLUS_SLOT_NONE            0
-#define NV_HADES_HDR10PLUS_SLOT_VSI             1
+/* (1 was the vendor-specific slot of the HALs with generic shared InfoFrames) */
 #define NV_HADES_HDR10PLUS_SLOT_GENERIC         2
 #define NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2 3
 #define NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC4 4
+#define NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9 5
 
 static inline NvU32 nvHadesHdr10PlusHdmiSlot(NvBool genericSharedInfoFrames,
                                              NvBool adaSharedGenerics,
                                              NvBool hdmiVrrEmp)
 {
     if (genericSharedInfoFrames) {
-        return NV_HADES_HDR10PLUS_SLOT_VSI;
+        return NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9;
     }
     if (!hdmiVrrEmp) {
         return NV_HADES_HDR10PLUS_SLOT_GENERIC;
@@ -678,7 +686,14 @@ static inline NvU32 nvHadesHdr10PlusHdmiSharedPacket(const NvU8 *payload,
  * How a shared generic slot of AD10x sends that HDMI packet (an NVHDMIPKT_TC
  * of nvhdmipkt.h): every frame, at the vertical sync, as NVKMS sends its HDMI
  * InfoFrames through these slots on the HALs with generic shared InfoFrames
- * (nvEvoSendHdmiInfoFrameC8()), with the checksum the packet carries.
+ * (nvEvoSendHdmiInfoFrameC8()), with the checksum the packet carries. On
+ * those HALs the same packet goes in shared generic slot 9 through the
+ * advanced InfoFrame interface of the HDMI library, as NVKMS writes its own
+ * HDMI InfoFrames there: at the vertical sync, the checksum computed by
+ * software (and asked of the hardware, which the classes of these HALs do
+ * not read), every frame (RUN_MODE_ALWAYS: InfoFrames are flip-synchronized
+ * only where the HAL sets a core FID, T239, and an HDR10+ InfoFrame never is,
+ * nvHadesUpdateHdr10Plus()).
  */
 #define NV_HADES_HDR10PLUS_HDMI_SHARED_TC \
     ((NVHDMIPKT_TC)(NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME_SW_CHECKSUM | \
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index a7cbce5..461d675 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -658,15 +658,17 @@ NvU32 nvHadesConnectorHdr10PlusRoutes(const NVConnectorEvoRec *pConnectorEvo)
 
 /*
  * Hades: the client's vendor InfoFrame is an HDR10+ one, and goes out in a
- * slot of its own, apart from the vendor-specific one, through which the HAL
- * sends the HDR InfoFrame (nvHadesHdr10PlusHdmiSlot()). The flip that carried
- * it was validated for it (nvHadesHdr10PlusAllowed()).
+ * slot of its own, apart from the vendor-specific one (nvHadesHdr10PlusHdmiSlot()):
+ * where the HAL sends the HDR InfoFrame through it (Turing, Ampere, Ada), and
+ * where NVKMS's own vendor InfoFrame keeps it (the HALs with generic shared
+ * InfoFrames). The flip that carried it was validated for it
+ * (nvHadesHdr10PlusAllowed()).
  */
 NvBool nvHadesHdr10PlusInOwnSlot(const NVDevEvoRec *pDevEvo,
                                  const NVDispHeadStateEvoRec *pHeadState)
 {
-    return !pDevEvo->caps.supportsGenericSharedInfoFrames &&
-           nvHadesIsHdr10PlusVsif(pHeadState->hdmiVsifMetadata.payload,
+    (void)pDevEvo;
+    return nvHadesIsHdr10PlusVsif(pHeadState->hdmiVsifMetadata.payload,
                                   pHeadState->hdmiVsifMetadata.payloadSize);
 }
 
@@ -868,6 +870,8 @@ static NVHDMIPKT_TYPE HadesHdr10PlusPacketType(NvU32 slot)
         return NVHDMIPKT_TYPE_SHARED_GENERIC2;
     case NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC4:
         return NVHDMIPKT_TYPE_SHARED_GENERIC4;
+    case NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9:
+        return NVHDMIPKT_TYPE_SHARED_GENERIC9;
     default:
         return NVHDMIPKT_TYPE_UNDEFINED;
     }
@@ -978,6 +982,57 @@ static void HadesSendHdr10PlusHdmi(const NVDispEvoRec *pDispEvo,
     }
 }
 
+/*
+ * Hades: on the HALs with generic shared InfoFrames (T239, Blackwell), write
+ * the HDR10+ InfoFrame of the head into shared generic slot 9
+ * (nvHadesHdr10PlusHdmiSlot()), laid out and sent as NVKMS sends its own HDMI
+ * InfoFrames in these slots (NV_HADES_HDR10PLUS_HDMI_SHARED_TC), or turn that
+ * slot off. Only that slot: the vendor-specific one keeps NVKMS's own vendor
+ * InfoFrame, as without HDR10+. A write that fails turns the slot off.
+ */
+static void HadesSendHdr10PlusShared(const NVDispEvoRec *pDispEvo,
+                                     const NvU32 head,
+                                     NvBool send)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    NvU8 packet[NV_HADES_HDR10PLUS_DP_SLOT_SIZE];
+    ADVANCED_INFOFRAME advancedInfoFrame = { };
+    NVHDMIPKT_RESULT ret;
+
+    if (!send) {
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+
+    (void)nvHadesHdr10PlusHdmiSharedPacket(pHeadState->hdmiVsifMetadata.payload,
+                                           packet);
+    advancedInfoFrame.location = INFOFRAME_CTRL_LOC_VSYNC;
+    advancedInfoFrame.hwChecksum = TRUE;
+    advancedInfoFrame.runMode = INFOFRAME_CTRL_RUN_MODE_ALWAYS;
+    advancedInfoFrame.packetLen = sizeof(packet);
+    advancedInfoFrame.pPacket = packet;
+
+    ret = NvHdmiPkt_SetupAdvancedInfoframe(pDevEvo->hdmiLib.handle,
+                                           pDispEvo->displayOwner,
+                                           head,
+                                           NVHDMIPKT_TYPE_SHARED_GENERIC9,
+                                           &advancedInfoFrame);
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: the HDR10+ InfoFrame of head %u could not be written in shared generic slot 9",
+                     head);
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+    if (nvHadesHdr10PlusSetSlot(pDispEvo, head,
+                                NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC9)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR10+ InfoFrame on head %u, in shared generic slot 9 (the vendor-specific slot keeps NVKMS's own vendor InfoFrame)",
+                     head);
+    }
+}
+
 /*
  * SendVendorSpecificInfoFrame() - Construct vendor specific infoframe using
  * provided EDID and call ->SendHdmiInfoFrame() to send it to RM.
@@ -1012,6 +1067,9 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
         HadesLogSlots(pDispEvo, head, vendor, &slots);
         HadesSendVendorGeneric(pDispEvo, head, pInfoFrameState, pEdidInfo, &slots);
         HadesSendHdr10PlusHdmi(pDispEvo, head, hdr10PlusGeneric, &slots);
+    } else {
+        /* Hades: shared generic slot 9 (HadesSendHdr10PlusShared()) */
+        HadesSendHdr10PlusShared(pDispEvo, head, hdr10PlusGeneric);
     }
 
     if ((pHeadState->hdmiVsifMetadata.payloadSize != 0) && !hdr10PlusGeneric) {
@@ -1164,8 +1222,8 @@ SendHDRInfoFrame(const NVDispEvoRec *pDispEvo, const NvU32 head,
 /*
  * Hades: a flip changed only the HDR10+ InfoFrame (nvHadesVsifChangeIsHdr10Plus()):
  * write only it. In its slot of HDMI where the HAL has no generic shared
- * InfoFrames (HadesSendHdr10PlusHdmi()); through the vendor-specific one
- * elsewhere, which is its own slot.
+ * InfoFrames (HadesSendHdr10PlusHdmi()); in shared generic slot 9 elsewhere
+ * (HadesSendHdr10PlusShared()), the vendor-specific slot left as it is.
  */
 void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
@@ -1203,12 +1261,10 @@ void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
         return;
     }
 
-    SendVendorSpecificInfoFrame(pDispEvo,
-                                head,
-                                pInfoFrameState,
-                                &flipState->vendorSpecificInfoframeTransmitCtrl,
-                                newTransmitCtrl,
-                                &pDpyEvo->parsedEdid.info);
+    (void)flipState;
+    (void)newTransmitCtrl;
+    HadesSendHdr10PlusShared(pDispEvo, head,
+        nvHadesHdr10PlusInOwnSlot(pDevEvo, &pDispEvo->headState[head]));
 }
 
 /*
