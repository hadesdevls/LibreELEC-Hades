From 028ce264073796ff89f94d20ffc905885de4c4ff Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:43:51 +0000
Subject: [PATCH] nvidia: Dolby Vision for the displays that ask for the HDMI
 1.4b signalling

The Dolby Vision displays of 2015 to 2018 whose Dolby VSVDB is of version
0, of version 1 in its 15-byte form, or of version 1 in its 12-byte form
without Low-Latency (the LG OLED TVs of 2016 among them) take the tunnel
of Dolby Vision Standard, told by another InfoFrame than the Dolby one: an
HDMI vendor-specific InfoFrame (IEEE OUI 00-0C-03) of 24 bytes of payload,
PB4 0x20 and PB5 the HDMI_VIC in the four 4K formats of HDMI 1.4b
(3840x2160 at 30, 25 and 24 Hz, 4096x2160 at 24 Hz, and their 1000/1001
rates), else PB4 and PB5 0, and PB6 to PB24 0; and in those four formats
an AVI InfoFrame with VIC 0, as HDMI 1.4b has it where its vendor
InfoFrame names the format (the signal of the Amlogic HDMI transmitter,
CoreELEC linux-amlogic, hdmitx_set_vsif_pkt()). The rest is the tunnel:
RGB at 8 bpc of full range, no HDR InfoFrame.

nvidia-drm sends a client's VSIF through NV_HDMI_VSIF_METADATA, and NVKMS
sends it in place of its own HDMI vendor InfoFrame
(SendVendorSpecificInfoFrame()). What is missing is the AVI VIC: NVKMS
writes VIC 0 only for a timing of the HDMI VSDB (NVT_TYPE_HDMI_EXT,
NvTiming_ConstructVideoInfoframeCtrl()); a display whose HF-VSDB sets
UHD_VIC gets the 4K modes by their CTA timing, and the AVI InfoFrame then
says VIC 93, 94 or 95.

NVKMS (the decisions in nvkms-hades.h, on plain values):
 - exactly that VSIF is one of Dolby Vision, as the Dolby one is: alone in
   the vendor-specific slot, no HDR InfoFrame, a flip with HDR refused
   where the two share that slot (nvHadesHdmiSlots()). Any other VSIF of
   OUI 00-0C-03 is a client's VSIF as before;
 - the HDMI_VIC of the mode of a head comes from its InfoFrame controls:
   NVKMS's own HDMI_VIC where the timing is one of the HDMI VSDB, else
   that of the CTA format of its AVI InfoFrame (VIC 95, 94, 93 and 98 are
   HDMI_VIC 1, 2, 3 and 4);
 - where the VSIF names that HDMI_VIC, the AVI InfoFrame carries VIC 0
   (SendVideoInfoFrame()); everything else of it, and the VSIF, are as
   NVKMS builds them;
 - the validation of each flip and mode set (ValidateHdmiVsif(), which now
   gets the InfoFrame controls of the head's mode through
   nvValidateFlipEvoHwState() and nvAssignNVFlipEvoHwState()) refuses that
   VSIF where it does not name the HDMI_VIC of the mode, or names one in a
   mode that has none, and in a frame-packed 3D mode, whose vendor
   InfoFrame is NVKMS's; the kernel log says why. nvidia-drm's atomic check
   runs that validation, so the commit is refused: the AVI InfoFrame and
   the VSIF never say two formats.

nvidia-drm: NV_HDMI_DV_HDMI14B, a boolean connector property next to
NV_HDMI_VSIF_METADATA (HDMI connectors, and dual-mode DisplayPort ones
while their TMDS output drives the display). Its presence tells user space
that the module does this; its value is the consent: the atomic check
refuses that VSIF without it, and it without that VSIF, "max bpc" 8, the
default colorimetry and no HDR metadata, as for NV_HDMI_DV_LOW_LATENCY.
The console drops it with the VSIF.

Without that VSIF, every InfoFrame NVKMS builds and every verdict of the
validation is what it was, byte for byte (a host test of NVKMS's own
functions over real EDIDs, the HALs of Turing to Blackwell and every mode
of the tunnel and others, VSIFs near that form included). Whether a
display of that class reads it so is seen on one.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 134 +++++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h |   2 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  12 ++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |   2 +
 src/nvidia-modeset/include/nvkms-hades.h      | 148 +++++++++++++++++-
 src/nvidia-modeset/include/nvkms-hw-flip.h    |   2 +
 src/nvidia-modeset/src/nvkms-flip.c           |   1 +
 src/nvidia-modeset/src/nvkms-hdmi.c           |  34 +++-
 src/nvidia-modeset/src/nvkms-hw-flip.c        |  70 ++++++++-
 src/nvidia-modeset/src/nvkms-modeset.c        |   1 +
 10 files changed, 393 insertions(+), 13 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 482fd90..a11c0ed 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -380,6 +380,8 @@ static struct drm_connector_state* nv_drm_connector_atomic_duplicate_state(struc
     }
     nv_drm_new_connector_state->hdmi_dv_low_latency =
         nv_drm_old_connector_state->hdmi_dv_low_latency;
+    nv_drm_new_connector_state->hdmi_dv_hdmi14b =
+        nv_drm_old_connector_state->hdmi_dv_hdmi14b;
 
     return &nv_drm_new_connector_state->base;
 }
@@ -459,6 +461,14 @@ static int nv_drm_connector_atomic_set_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+        if (val > 1) {
+            return -EINVAL;
+        }
+        nv_connector_state->hdmi_dv_hdmi14b = val;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -499,6 +509,11 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+        *val = nv_connector_state->hdmi_dv_hdmi14b;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -510,10 +525,11 @@ static int nv_drm_connector_atomic_get_property(
  * default) takes the display back with a commit made of a duplicate of every
  * connector state (&drm_connector_funcs.atomic_client_restore, in Hades'
  * Linux). When Kodi dies in a Dolby Vision video, that state still has the
- * Dolby VSIF of the tunnel in NV_HDMI_VSIF_METADATA (and Low-Latency, or
- * HDR10+): the console would go out next to it, as a tunnel the display
- * cannot read. They are dropped from the state of the client's commit;
- * dithering and "max bpc", which only make the console exact, stay.
+ * Dolby VSIF of the tunnel in NV_HDMI_VSIF_METADATA (and Low-Latency, the
+ * signalling of HDMI 1.4b, or HDR10+): the console would go out next to it, as
+ * a tunnel the display cannot read. They are dropped from the state of the
+ * client's commit; dithering and "max bpc", which only make the console exact,
+ * stay.
  */
 static void nv_drm_connector_atomic_client_restore(
     struct drm_connector *connector,
@@ -522,19 +538,20 @@ static void nv_drm_connector_atomic_client_restore(
     struct nv_drm_connector_state *s = to_nv_drm_connector_state(state);
 
     if (s->hdmi_vsif_metadata != NULL || s->hdr10plus_vsif != NULL ||
-        s->hdmi_dv_low_latency) {
+        s->hdmi_dv_low_latency || s->hdmi_dv_hdmi14b) {
         drm_info(connector->dev,
                  "[CONNECTOR:%d:%s] the console takes the display: "
                  "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s, "
-                 "NV_HDMI_DV_LOW_LATENCY %d dropped\n",
+                 "NV_HDMI_DV_LOW_LATENCY %d, NV_HDMI_DV_HDMI14B %d dropped\n",
                  connector->base.id, connector->name,
                  s->hdmi_vsif_metadata != NULL ? "set" : "none",
                  s->hdr10plus_vsif != NULL ? "set" : "none",
-                 s->hdmi_dv_low_latency);
+                 s->hdmi_dv_low_latency, s->hdmi_dv_hdmi14b);
     }
     drm_property_replace_blob(&s->hdmi_vsif_metadata, NULL);
     drm_property_replace_blob(&s->hdr10plus_vsif, NULL);
     s->hdmi_dv_low_latency = false;
+    s->hdmi_dv_hdmi14b = false;
 }
 #endif
 
@@ -819,6 +836,76 @@ static int nv_drm_connector_check_dv_low_latency(bool low_latency,
     return 0;
 }
 
+/*
+ * Hades: Dolby Vision for a display that asks for the signalling of HDMI 1.4b
+ * (an LG OLED of 2016): the tunnel of Dolby Vision Standard (RGB at 8 bpc),
+ * told to the display by an HDMI vendor InfoFrame of 24 bytes in place of the
+ * Dolby one: IEEE OUI 00-0C-03, then PB4 0x20 and PB5 the HDMI_VIC of one of
+ * the four 4K formats of HDMI 1.4b, or PB4 and PB5 0, and PB6 to PB24 0
+ * (nvHadesIsDolbyHdmi14bVsif() of nvkms-hades.h, of which this is a copy). In
+ * those four formats NVKMS sends the AVI InfoFrame with VIC 0 next to it, and
+ * it refuses that VSIF where it does not name the HDMI_VIC of the mode
+ * (nvkms-hw-flip.c).
+ *
+ * So that the AVI InfoFrame never says other than what user space asked for:
+ * NV_HDMI_VSIF_METADATA takes that VSIF only with NV_HDMI_DV_HDMI14B set, and
+ * NV_HDMI_DV_HDMI14B is taken only with that VSIF, "max bpc" 8, the default
+ * colorimetry and no HDR metadata: what the AVI InfoFrame of the tunnel and its
+ * RGB 8 bpc need, as for Low-Latency (dithering changes no InfoFrame, and is
+ * left to user space, as for Dolby Vision Standard). Returns 0 or -EINVAL.
+ */
+static bool nv_drm_vsif_is_dolby_hdmi14b(const uint8_t *payload, size_t size)
+{
+    size_t i;
+
+    if ((size != 24) || (payload[0] != 0x03) || (payload[1] != 0x0c) ||
+        (payload[2] != 0x00)) {
+        return false;
+    }
+    if (payload[3] == 0x20) {
+        if ((payload[4] < 1) || (payload[4] > 4)) {
+            return false;
+        }
+    } else if ((payload[3] != 0x00) || (payload[4] != 0x00)) {
+        return false;
+    }
+    for (i = 5; i < size; i++) {
+        if (payload[i] != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int nv_drm_connector_check_dv_hdmi14b(bool hdmi14b,
+                                             const uint8_t *vsif,
+                                             size_t vsif_size,
+                                             NvU32 bpc,
+                                             bool default_colorimetry,
+                                             bool hdr_metadata,
+                                             const char **why)
+{
+    const bool hdmi14b_vsif =
+        (vsif != NULL) && nv_drm_vsif_is_dolby_hdmi14b(vsif, vsif_size);
+
+    if (hdmi14b_vsif && !hdmi14b) {
+        *why = "a Dolby Vision VSIF of HDMI 1.4b needs NV_HDMI_DV_HDMI14B";
+        return -EINVAL;
+    }
+    if (!hdmi14b) {
+        return 0;
+    }
+    if (!hdmi14b_vsif) {
+        *why = "NV_HDMI_DV_HDMI14B needs the Dolby Vision VSIF of HDMI 1.4b";
+        return -EINVAL;
+    }
+    if ((bpc != 8) || !default_colorimetry || hdr_metadata) {
+        *why = "NV_HDMI_DV_HDMI14B needs \"max bpc\" 8, the default colorimetry and no HDR metadata";
+        return -EINVAL;
+    }
+    return 0;
+}
+
 static int
 __nv_drm_connector_atomic_check(struct drm_connector *connector,
                                 nv_drm_atomic_state_base_t *state)
@@ -947,6 +1034,27 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /* Hades: Dolby Vision for the signalling of HDMI 1.4b (above) */
+    {
+        const struct drm_property_blob *vsif =
+            nv_new_connector_state->hdmi_vsif_metadata;
+        const char *why = NULL;
+        int ret = nv_drm_connector_check_dv_hdmi14b(
+            nv_new_connector_state->hdmi_dv_hdmi14b,
+            (vsif && vsif->data) ? vsif->data : NULL,
+            (vsif && vsif->data) ? vsif->length : 0,
+            nv_drm_connector_requested_bpc(new_connector_state),
+            new_connector_state->colorspace == DRM_MODE_COLORIMETRY_DEFAULT,
+            new_connector_state->hdr_output_metadata != NULL,
+            &why);
+
+        if (ret != 0) {
+            NV_DRM_DEV_LOG_INFO(nv_dev, "[CONNECTOR:%d:%s] refused: %s",
+                                connector->base.id, connector->name, why);
+            return ret;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
@@ -1155,6 +1263,12 @@ nv_drm_connector_new(struct drm_device *dev,
                                            nv_dev->nv_connector_hdmi_dv_low_latency_property,
                                            0);
             }
+            /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
+            if (nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+                drm_object_attach_property(&nv_connector->base.base,
+                                           nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
+                                           0);
+            }
         }
     } else if (nv_connector->type == NVKMS_CONNECTOR_TYPE_DP) {
 #if defined(NV_DRM_MODE_CREATE_DP_COLORSPACE_PROPERTY_HAS_SUPPORTED_COLORSPACES_ARG)
@@ -1338,6 +1452,12 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
         drm_object_attach_property(&nv_connector->base.base,
                                    nv_dev->nv_connector_hdmi_vsif_metadata_property,
                                    0);
+        /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
+        if (nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+            drm_object_attach_property(&nv_connector->base.base,
+                                       nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
+                                       0);
+        }
     }
 #endif
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 659051e..2a2f6e7 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -129,6 +129,8 @@ struct nv_drm_connector_state {
        struct drm_property_blob *hdr10plus_vsif;
        /* Hades: NV_HDMI_DV_LOW_LATENCY */
        bool hdmi_dv_low_latency;
+       /* Hades: NV_HDMI_DV_HDMI14B */
+       bool hdmi_dv_hdmi14b;
 };
 
 static inline struct nv_drm_connector_state *to_nv_drm_connector_state(
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 9c37075..2fa2143 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -763,6 +763,18 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: Dolby Vision for a display that asks for the signalling of HDMI
+     * 1.4b: with it set, NV_HDMI_VSIF_METADATA takes the HDMI vendor InfoFrame
+     * of that signalling, and NVKMS sends the AVI InfoFrame with VIC 0 in the
+     * four 4K formats of HDMI 1.4b (nvkms-hades.h)
+     */
+    nv_dev->nv_connector_hdmi_dv_hdmi14b_property =
+        drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_DV_HDMI14B");
+    if (nv_dev->nv_connector_hdmi_dv_hdmi14b_property == NULL) {
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index c66d7de..f030b4e 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -207,6 +207,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdr10plus_vsif_property;
     /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel */
     struct drm_property *nv_connector_hdmi_dv_low_latency_property;
+    /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
+    struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 95778ed..0999609 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -293,6 +293,149 @@ static inline NvBool nvHadesIsDolbyVsif(const NvU8 *payload, NvU32 size)
            (payload[0] == 0x46) && (payload[1] == 0xD0) && (payload[2] == 0x00);
 }
 
+/*
+ * Dolby Vision for a display that asks for the signalling of HDMI 1.4b (its
+ * Dolby Vision VSVDB of version 0, of version 1 in its 15-byte form, or of
+ * version 1 in its 12-byte form without Low-Latency: the LG OLED TVs of 2016,
+ * and other displays of 2015 to 2018). The tunnel is that of Dolby Vision
+ * Standard: RGB at 8 bpc of full range, no HDR InfoFrame, the bytes as they
+ * are. What tells the display is not the Dolby vendor InfoFrame but an HDMI
+ * one (IEEE OUI 00-0C-03, least significant byte first) of 24 bytes of
+ * payload: PB4 0x20 and PB5 the HDMI_VIC in the four 4K formats of HDMI 1.4b
+ * (1: 3840x2160 at 30 Hz, 2: at 25 Hz, 3: at 24 Hz, 4: 4096x2160 at 24 Hz;
+ * their 1000/1001 rates too), PB4 and PB5 0 in any other mode, and PB6 to
+ * PB24 0: the signal of the Amlogic HDMI transmitter (CoreELEC linux-amlogic,
+ * hdmitx_set_vsif_pkt()). In those four formats the AVI InfoFrame carries VIC
+ * 0, as HDMI 1.4b has it where its vendor InfoFrame names the format; it is
+ * otherwise the AVI InfoFrame of the tunnel. A client gives that VSIF as its
+ * HDMI VSIF metadata (NV_HDMI_VSIF_METADATA of nvidia-drm, with
+ * NV_HDMI_DV_HDMI14B), and NVKMS sends it in place of its own HDMI vendor
+ * InfoFrame. Exactly that form is this VSIF; any other of OUI 00-0C-03 is a
+ * client's VSIF as before.
+ */
+#define NV_HADES_DV_HDMI14B_PAYLOAD_SIZE 24
+
+static inline NvBool nvHadesIsDolbyHdmi14bVsif(const NvU8 *payload, NvU32 size)
+{
+    NvU32 i;
+
+    if ((size != NV_HADES_DV_HDMI14B_PAYLOAD_SIZE) || (payload == NULL) ||
+        (payload[0] != 0x03) || (payload[1] != 0x0C) || (payload[2] != 0x00)) {
+        return NV_FALSE;
+    }
+    if (payload[3] == 0x20) {
+        if ((payload[4] < 1) || (payload[4] > 4)) {
+            return NV_FALSE;
+        }
+    } else if ((payload[3] != 0x00) || (payload[4] != 0x00)) {
+        return NV_FALSE;
+    }
+    for (i = 5; i < NV_HADES_DV_HDMI14B_PAYLOAD_SIZE; i++) {
+        if (payload[i] != 0) {
+            return NV_FALSE;
+        }
+    }
+    return NV_TRUE;
+}
+
+/* The HDMI_VIC that such a VSIF names: PB5 with PB4 0x20, else 0 */
+static inline NvU32 nvHadesDolbyHdmi14bVic(const NvU8 *payload)
+{
+    return (payload[3] == 0x20) ? payload[4] : 0;
+}
+
+/* Whether a client's VSIF is one of Dolby Vision: the Dolby one, or that of HDMI 1.4b */
+static inline NvBool nvHadesIsDolbyVisionVsif(const NvU8 *payload, NvU32 size)
+{
+    return nvHadesIsDolbyVsif(payload, size) ||
+           nvHadesIsDolbyHdmi14bVsif(payload, size);
+}
+
+/*
+ * The HDMI_VIC of the mode of a head, from its InfoFrame controls: the one of
+ * NVKMS's own HDMI vendor InfoFrame where it names one (ownVsif, ownFormat
+ * NV_HADES_HDMI_VID_FMT_EXT, ownHdmiVic: a timing of the HDMI VSDB,
+ * NVT_TYPE_HDMI_EXT, whose AVI VIC NVKMS makes 0), or else that of the CTA
+ * format that the AVI InfoFrame names (aviVic): VIC 95, 94 and 93 (3840x2160
+ * at 30, 25 and 24 Hz, 16:9) are HDMI_VIC 1, 2 and 3, VIC 98 (4096x2160 at
+ * 24 Hz, 256:135) is 4. 0 for any other mode. And whether the mode is a
+ * frame-packed 3D one (NVKMS's own vendor InfoFrame of format 3D). The formats
+ * are those of HDMI_Video_Format in the HDMI vendor InfoFrame (HDMI 1.4b, the
+ * NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_* of nvtiming.h).
+ */
+#define NV_HADES_HDMI_VID_FMT_EXT 0x01
+#define NV_HADES_HDMI_VID_FMT_3D  0x02
+
+static inline NvU32 nvHadesHdmiVicOfMode(NvU32 aviVic,
+                                         NvBool ownVsif,
+                                         NvU32 ownFormat,
+                                         NvU32 ownHdmiVic)
+{
+    if (ownVsif && (ownFormat == NV_HADES_HDMI_VID_FMT_EXT) &&
+        (ownHdmiVic >= 1) && (ownHdmiVic <= 4)) {
+        return ownHdmiVic;
+    }
+    switch (aviVic) {
+    case 95:
+        return 1;
+    case 94:
+        return 2;
+    case 93:
+        return 3;
+    case 98:
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static inline NvBool nvHadesModeIsFramePacked(NvBool ownVsif, NvU32 ownFormat)
+{
+    return ownVsif && (ownFormat == NV_HADES_HDMI_VID_FMT_3D);
+}
+
+/*
+ * Why a head may not send that VSIF with its mode: it has to name the HDMI_VIC
+ * of the mode (modeHdmiVic), or none in a mode that has none, so that the AVI
+ * InfoFrame and the VSIF never say two formats; and not in a frame-packed 3D
+ * mode, whose vendor InfoFrame is NVKMS's (the VSIF would take its place).
+ * NV_HADES_DV_HDMI14B_ALLOWED for any other VSIF.
+ */
+#define NV_HADES_DV_HDMI14B_ALLOWED 0
+#define NV_HADES_DV_HDMI14B_3D      1
+#define NV_HADES_DV_HDMI14B_VIC     2
+
+static inline NvU32 nvHadesDolbyHdmi14bRefusal(const NvU8 *payload,
+                                               NvU32 size,
+                                               NvU32 modeHdmiVic,
+                                               NvBool framePacked)
+{
+    if (!nvHadesIsDolbyHdmi14bVsif(payload, size)) {
+        return NV_HADES_DV_HDMI14B_ALLOWED;
+    }
+    if (framePacked) {
+        return NV_HADES_DV_HDMI14B_3D;
+    }
+    if (nvHadesDolbyHdmi14bVic(payload) != modeHdmiVic) {
+        return NV_HADES_DV_HDMI14B_VIC;
+    }
+    return NV_HADES_DV_HDMI14B_ALLOWED;
+}
+
+/*
+ * Whether the AVI InfoFrame of a head says VIC 0 because of that VSIF: it
+ * names an HDMI_VIC, and that is the one of the mode. Any other head keeps the
+ * VIC that NVKMS puts in it.
+ */
+static inline NvBool nvHadesDolbyHdmi14bAviVic0(const NvU8 *payload,
+                                                NvU32 size,
+                                                NvU32 modeHdmiVic)
+{
+    return nvHadesIsDolbyHdmi14bVsif(payload, size) &&
+           (nvHadesDolbyHdmi14bVic(payload) != 0) &&
+           (nvHadesDolbyHdmi14bVic(payload) == modeHdmiVic);
+}
