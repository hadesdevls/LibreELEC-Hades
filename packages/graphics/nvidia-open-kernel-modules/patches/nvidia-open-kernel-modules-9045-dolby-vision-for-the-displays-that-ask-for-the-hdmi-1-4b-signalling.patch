+/*
+ * Hades: Dolby Vision for the signalling of HDMI 1.4b (nvkms-hades.h). Its
+ * VSIF goes out only where it names the HDMI_VIC of the mode of the head (the
+ * InfoFrame controls of that mode, pInfoFrame), or none in a mode that has
+ * none, and not in a frame-packed one: else the flip, or the mode set, is
+ * refused, and the kernel log says why.
+ */
+static NvBool HadesDolbyHdmi14bAllowed(const NVConnectorEvoRec *pConnectorEvo,
+                                       const NvU32 head,
+                                       const NVHwModeTimingsEvo *pTimings,
+                                       const NVDispHeadInfoFrameStateEvoRec *pInfoFrame,
+                                       const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    NvU32 modeHdmiVic;
+    NvU32 refusal;
+
+    if (!nvHadesIsDolbyHdmi14bVsif(pVsif->payload, pVsif->payloadSize)) {
+        return TRUE;
+    }
+    if ((pInfoFrame == NULL) || (pTimings == NULL)) {
+        nvEvoLogDisp(pConnectorEvo->pDispEvo, EVO_LOG_WARN,
+                     "Hades: the Dolby Vision VSIF of HDMI 1.4b on head %u is refused: "
+                     "the mode of the head is not known here",
+                     head);
+        return FALSE;
+    }
+
+    modeHdmiVic = nvHadesHdmiVicOfMode(pInfoFrame->ctrl.video_format_id,
+                                       pInfoFrame->vendorSpecificCtrl.Enable,
+                                       pInfoFrame->vendorSpecificCtrl.HDMIFormat,
+                                       pInfoFrame->vendorSpecificCtrl.HDMI_VIC);
+    refusal = nvHadesDolbyHdmi14bRefusal(pVsif->payload, pVsif->payloadSize,
+                                         modeHdmiVic,
+                                         pTimings->hdmi3D ||
+                                             nvHadesModeIsFramePacked(
+                                                 pInfoFrame->vendorSpecificCtrl.Enable,
+                                                 pInfoFrame->vendorSpecificCtrl.HDMIFormat));
+    if (refusal == NV_HADES_DV_HDMI14B_ALLOWED) {
+        return TRUE;
+    }
+    if (refusal == NV_HADES_DV_HDMI14B_3D) {
+        nvEvoLogDisp(pConnectorEvo->pDispEvo, EVO_LOG_WARN,
+                     "Hades: the Dolby Vision VSIF of HDMI 1.4b on head %u is refused: "
+                     "the mode is a frame-packed 3D one",
+                     head);
+    } else {
+        nvEvoLogDisp(pConnectorEvo->pDispEvo, EVO_LOG_WARN,
+                     "Hades: the Dolby Vision VSIF of HDMI 1.4b on head %u is refused: "
+                     "it names HDMI_VIC %u, and the mode is HDMI_VIC %u (0: none)",
+                     head, nvHadesDolbyHdmi14bVic(pVsif->payload), modeHdmiVic);
+    }
+    return FALSE;
+}
