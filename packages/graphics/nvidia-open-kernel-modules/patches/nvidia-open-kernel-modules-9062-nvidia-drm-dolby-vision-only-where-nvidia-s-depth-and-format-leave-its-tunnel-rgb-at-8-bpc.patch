From 072e2ebfcbff71141931daeeb25b132448bfd962 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:59:35 +0000
Subject: [PATCH] nvidia-drm: Dolby Vision only where NVIDIA's depth and format
 leave its tunnel RGB at 8 bpc

Driver 620 has two connector properties of its own on HDMI connectors,
NV_CONNECTOR_OUTPUT_BPC and NV_CONNECTOR_COLOR_FORMAT, which ask NVKMS for a
depth and a format whatever "max bpc" says: nvidia-open-kernel-modules-9000
takes "max bpc" below 10 as 8 bpc only where NV_CONNECTOR_OUTPUT_BPC is
"auto". Both stay on the connector until a client changes them, and Kodi
sets NV_CONNECTOR_COLOR_FORMAT to "auto" for the tunnel but does not know
NV_CONNECTOR_OUTPUT_BPC. A value of it that another program left there
(10, say) made the head send the Dolby Vision tunnel at 10 bpc with "max
bpc" 8: the display takes the Dolby VSIF and reads bytes that are not the
tunnel's. The checks of Low-Latency and of the HDMI 1.4b signalling
(nvidia-open-kernel-modules-9030 and 9045) look at "max bpc", so they took
such a state too, and NVKMS only said in the kernel log that the head was
not RGB at 8 bpc.

A connector state that carries Dolby Vision (the Dolby VSIF, the HDMI 1.4b
one, or NV_HDMI_DV_LOW_LATENCY or NV_HDMI_DV_HDMI14B:
nv_drm_connector_state_has_dolby_vision(), now built whatever the kernel's
"Broadcast RGB") is now taken only with NV_CONNECTOR_OUTPUT_BPC "auto" or 8
and NV_CONNECTOR_COLOR_FORMAT "auto" or RGB, and refused otherwise, with the
reason in the kernel log ("[CONNECTOR:..] refused: Dolby Vision needs
NV_CONNECTOR_OUTPUT_BPC "auto" or 8"). A refused commit leaves the output as
it was, and Kodi's handover goes on without Dolby Vision. A state without
Dolby Vision is not looked at, and nothing changes where both properties are
"auto", which is what Kodi's handover sends.

Tested on the host: the helpers and the statements of
__nv_drm_connector_atomic_check() from the Low-Latency check to the HDR
metadata override, taken from nvidia-drm-connector.c as they are and built
with stand-ins for the DRM types, over 17 connector states: 17 of 17 with
this change; 7 of 17 failing on the tree before it (Standard, Low-Latency
and HDMI 1.4b states at NVIDIA 6, 10 or 12 bpc or in YCbCr taken); 5 of 5
mutations of the change caught. The five modules build against Linux 7.3.4
with the image's compiler. Not run on a GPU.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 56 ++++++++++++++++++-
 1 file changed, 54 insertions(+), 2 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 00cd7aa..b17adb7 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1084,13 +1084,13 @@ static int nv_drm_connector_check_dv_hdmi14b(bool hdmi14b,
     return 0;
 }
 
-#if NV_DRM_HADES_BROADCAST_RGB
 /*
  * Hades: the connector state carries Dolby Vision: the Dolby VSIF of the
  * tunnel (IEEE OUI 00-D0-46 first: Standard or Low-Latency), the signalling
  * of HDMI 1.4b (nv_drm_vsif_is_dolby_hdmi14b()), or a property that goes with
  * them. "Broadcast RGB" does not make the head of such a state limited range:
- * the tunnel goes out bit for bit, in full range.
+ * the tunnel goes out bit for bit, in full range; and NVIDIA's depth and
+ * format leave it RGB at 8 bpc (nv_drm_connector_check_dv_output()).
  */
 static bool nv_drm_connector_state_has_dolby_vision(
     const struct nv_drm_connector_state *s)
@@ -1109,6 +1109,42 @@ static bool nv_drm_connector_state_has_dolby_vision(
            nv_drm_vsif_is_dolby_hdmi14b(p, blob->length);
 }
 
+/*
+ * Hades: the tunnel of Dolby Vision is RGB at 8 bpc, bit for bit (Standard,
+ * Low-Latency and the signalling of HDMI 1.4b alike). NVIDIA's
+ * NV_CONNECTOR_OUTPUT_BPC and NV_CONNECTOR_COLOR_FORMAT ask NVKMS for a depth
+ * and a format whatever "max bpc" says ("max bpc" counts only where
+ * NV_CONNECTOR_OUTPUT_BPC is "auto"): a value of theirs that a client left
+ * on the connector would send the tunnel at another depth, or in YCbCr, to a
+ * display that reads it as Dolby Vision. A connector state that carries Dolby
+ * Vision is taken only with NV_CONNECTOR_OUTPUT_BPC "auto" or 8 and
+ * NV_CONNECTOR_COLOR_FORMAT "auto" or RGB, and refused otherwise, as the
+ * checks of Low-Latency and of HDMI 1.4b refuse a state whose AVI InfoFrame
+ * would not describe the tunnel. Nothing changes for a state without Dolby
+ * Vision. Returns 0 or -EINVAL.
+ */
+static int nv_drm_connector_check_dv_output(bool dolby_vision,
+                                            enum nv_drm_connector_output_bpc bpc,
+                                            enum nv_drm_connector_color_format format,
+                                            const char **why)
+{
+    if (!dolby_vision) {
+        return 0;
+    }
+    if ((bpc != NV_DRM_CONNECTOR_OUTPUT_BPC_AUTO) &&
+        (bpc != NV_DRM_CONNECTOR_OUTPUT_BPC_8)) {
+        *why = "Dolby Vision needs NV_CONNECTOR_OUTPUT_BPC \"auto\" or 8";
+        return -EINVAL;
+    }
+    if ((format != NV_DRM_CONNECTOR_COLOR_FORMAT_AUTO) &&
+        (format != NV_DRM_CONNECTOR_COLOR_FORMAT_RGB)) {
+        *why = "Dolby Vision needs NV_CONNECTOR_COLOR_FORMAT \"auto\" or RGB";
+        return -EINVAL;
+    }
+    return 0;
+}
+
+#if NV_DRM_HADES_BROADCAST_RGB
 /*
  * Hades: "Broadcast RGB" (DRM's standard property, as i915 and amdgpu have
  * it). "Limited 16:235" drives the head in limited range: NVKMS compresses
@@ -1368,6 +1404,22 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /* Hades: Dolby Vision at the depth and in the format of its tunnel (above) */
+    {
+        const char *why = NULL;
+        int ret = nv_drm_connector_check_dv_output(
+            nv_drm_connector_state_has_dolby_vision(nv_new_connector_state),
+            nv_new_connector_state->output_bpc,
+            nv_new_connector_state->color_format,
+            &why);
+
+        if (ret != 0) {
+            NV_DRM_DEV_LOG_INFO(nv_dev, "[CONNECTOR:%d:%s] refused: %s",
+                                connector->base.id, connector->name, why);
+            return ret;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
-- 
2.53.0

