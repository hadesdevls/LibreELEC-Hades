From 272f8effe76950ed54198b419fdcb8da1dbce9e8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:39:31 +0000
Subject: [PATCH] nvidia-drm: NV_HDR10PLUS_WITH_VRR, read-only: HDR10+ next to
 the EMP of HDMI VRR

NVKMS already sends the HDR10+ InfoFrame of a head where HDMI VRR is on in its
mode set wherever the GPU has a slot for it that the EMP of HDMI VRR does not
take (nvHadesHdr10PlusHdmiSlot(), nvkms-hades.h): on AD10x shared generic slot
2, next to the EMP in the generic one; on the HALs with generic shared
InfoFrames (T239, Blackwell) shared generic slot 9. Only Turing and Ampere
have the generic slot alone, and there it gives the connector the route
HDMI_VRR_OFF (nvHadesHdr10PlusRoutes()), with which a client leaves HDMI VRR off
in the mode set of an HDR10+ video. An RTX 4080 SUPER did it
with Hades 1.0: the kernel log of an HDR10+ video on a Samsung
Odyssey G60SD at 119.998 Hz said "HDR10+ InfoFrame on head 3, in shared
generic slot 2 (HDMI VRR sends its EMP in the generic one)", and the
vendor-specific InfoFrame of OUI 90-84-8B in that slot changed with the frames.

A client could not tell which of the two it has: since 9074 every connector
with a TMDS output has NV_HDMI_VRR_OFF, and Kodi left HDMI VRR off for every
HDR10+ video, also where that gained HDR10+ nothing and cost the video VRR.

NV_HDR10PLUS_WITH_VRR, an immutable property of the connector (0..1), attached
with 1 where getHdr10PlusRoutes() gives the route of HDMI without HDMI_VRR_OFF
(NVKMS_KAPI_HADES_HDR10PLUS_HDMI, new in the KAPI header, is NVKMS's
NV_HADES_HDR10PLUS_ROUTE_HDMI). Nothing that goes out changes: the slot of the
HDR10+ InfoFrame stays NVKMS's choice for each mode set, by whether the EMP is
in its timings (nvHadesHdmiVrrEmp()), and the flips write it as before
(nvHadesUpdateHdr10Plus() from the flip; HadesSendHdr10PlusHdmi() every frame).

Checked: the five modules build against Linux 7.3.5 with the compiler of
the image, with no new warning; the patch applies with --fuzz=0 after 9000
to 9081. Not in driver 580: its GPUs have no HDMI VRR. Not run on a GPU with
this property: the kernel log of an HDR10+ video at its own rate with VRR says
both packets, "extended metadata packet of HDMI VRR (VTEM: VRR on ...)" and
"HDR10+ InfoFrame on head N, in shared generic slot 2".
---
 kernel-open/common/inc/nvkms-kapi.h           |  5 +++++
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 19 +++++++++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  2 ++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 12 ++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  2 ++
 .../kapi/interface/nvkms-kapi.h               |  5 +++++
 6 files changed, 45 insertions(+)

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index 7ba5531..ea35f62 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -522,6 +522,11 @@ struct NvKmsKapiHeadModeSetConfig {
 
 /* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
 #define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+/*
+ * Hades: the route of getHdr10PlusRoutes() of HDR10+ over HDMI (NVKMS's
+ * NV_HADES_HDR10PLUS_ROUTE_HDMI)
+ */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI 0x1
 /*
  * Hades: the route of getHdr10PlusRoutes() of the HDMI connectors where the AVI
  * InfoFrame carries the CTA VIC of a mode named by an HDMI_VIC with HDR10+
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 1aea7e0..8048aea 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1972,6 +1972,25 @@ void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
         nv_connector->hdr10plus_avi_cta_vic = true;
     }
 
+    /*
+     * Hades: NV_HDR10PLUS_WITH_VRR where HDR10+ goes out over HDMI and needs no
+     * HDMI VRR off for it: the route of HDMI without HDMI_VRR_OFF, which NVKMS
+     * gives where the HDR10+ InfoFrame has a slot that the EMP of HDMI VRR does
+     * not take (nvHadesHdr10PlusRoutes(), nvHadesHdr10PlusHdmiSlot(): shared
+     * generic slot 2 of AD10x next to the EMP in the generic one, shared
+     * generic slot 9 of the HALs with generic shared InfoFrames). Not on
+     * Turing and Ampere, where the EMP takes the one slot of HDR10+.
+     */
+    if ((routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI) &&
+        !(routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF) &&
+        !nv_connector->hdr10plus_with_vrr && !dev->registered &&
+        nv_dev->nv_connector_hdr10plus_with_vrr_property != NULL) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdr10plus_with_vrr_property,
+                                   1);
+        nv_connector->hdr10plus_with_vrr = true;
+    }
+
     routes &= ~(NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF |
                 NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC);
     if (routes == 0 || nv_connector->hdr10plus ||
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index a3c6d33..6353b0b 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -60,6 +60,8 @@ struct nv_drm_connector {
     bool hdmi_frl_keep;
     /* Hades: NV_HDR10PLUS_AVI_CTA_VIC is attached (nv_drm_connector_add_hdr10plus()) */
     bool hdr10plus_avi_cta_vic;
+    /* Hades: NV_HDR10PLUS_WITH_VRR is attached */
+    bool hdr10plus_with_vrr;
     NvU32 physicalIndex;
 
     NvBool internal;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 3b20068..a0d76f2 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -985,6 +985,18 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, 1 where HDR10+ goes out over HDMI in a slot that the
+     * EMP of HDMI VRR does not take, so that a mode set with HDMI VRR keeps
+     * HDR10+ (nvidia-drm-connector.c)
+     */
+    nv_dev->nv_connector_hdr10plus_with_vrr_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_HDR10PLUS_WITH_VRR", 0, 1);
+    if (nv_dev->nv_connector_hdr10plus_with_vrr_property == NULL) {
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 04f0352..f53b2b0 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -255,6 +255,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdmi_frl_keep_property;
     /* Hades: NV_HDR10PLUS_AVI_CTA_VIC */
     struct drm_property *nv_connector_hdr10plus_avi_cta_vic_property;
+    /* Hades: NV_HDR10PLUS_WITH_VRR */
+    struct drm_property *nv_connector_hdr10plus_with_vrr_property;
 
     struct drm_property *nv_connector_allm_capable_property;
     struct drm_property *nv_connector_allm_mode_property;
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index 7ba5531..ea35f62 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -522,6 +522,11 @@ struct NvKmsKapiHeadModeSetConfig {
 
 /* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
 #define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+/*
+ * Hades: the route of getHdr10PlusRoutes() of HDR10+ over HDMI (NVKMS's
+ * NV_HADES_HDR10PLUS_ROUTE_HDMI)
+ */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI 0x1
 /*
  * Hades: the route of getHdr10PlusRoutes() of the HDMI connectors where the AVI
  * InfoFrame carries the CTA VIC of a mode named by an HDMI_VIC with HDR10+
