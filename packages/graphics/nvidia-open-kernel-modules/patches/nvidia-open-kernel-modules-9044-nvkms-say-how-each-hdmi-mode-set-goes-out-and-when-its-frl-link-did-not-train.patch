From 6058ebfe5ad30c2f577a2f92566128b32fba48de Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:13:21 +0000
Subject: [PATCH] nvkms: say how each HDMI mode set goes out, and when its FRL
 link did not train

The kernel log of NVKMS did not say how an HDMI mode goes out: over TMDS
(at what character rate, scrambled or not) or over FRL (how many lanes, at
what rate, with DSC or not), in what colour format and at what depth. A
laptop with an RTX 3070 and an LG G5 (issue #8 of the Hades tracker)
shows 1920x1080 and loses the signal at every 3840x2160 mode, 30 Hz
included, where Windows shows 3840x2160 at 60 Hz over the same cable. Its
log could not tell which of the two links failed.

What NVKMS 615 picks, as read and run on the host with its own functions
(nvDpyGetOutputColorFormatInfo(), nvHdmiIsTmdsPossible(),
nvHdmiIsFrlPossible()) and the EDID of an LG C5, with "max bpc" left to
the driver: the depth is the most that the display and
max_output_color_depth (10 unless set) allow, 10 bpc; GetDfpHdmiProtocol()
goes over FRL wherever TMDS does not carry the mode at that depth, without
lowering the depth first, and on Ampere and Ada TMDS at 10 bpc reaches a
pixel clock of 324 MHz (hdmiTmds10BpcMaxPClkMHz). So 1920x1080 at 60 Hz
goes over TMDS at 185.625 MHz, not scrambled; 3840x2160 at 24 to 30 Hz
over TMDS at 371.25 MHz, scrambled; and 3840x2160 at 50 and 60 Hz over
FRL. Windows sends 3840x2160 at 60 Hz in RGB at 8 bpc, over TMDS at 594
MHz, scrambled. A link that carries neither scrambled TMDS nor FRL from
this driver would show exactly what the issue reports; which of the two
it is cannot be told without a log that says it.

After each mode set of an HDMI head (also the TMDS output of a dual-mode
DisplayPort connector), nvHadesLogHdmiLink() writes one line:

  Hades: head 0 (DFP-1): 3840x2160, 60.000 Hz, pixel clock 594000 kHz:
  HDMI FRL, 4 lanes at 12 Gb/s, RGB at 10 bpc (TMDS takes up to 600000
  kHz to this display; TMDS would carry it in RGB at 8 bpc)

  Hades: head 0 (DFP-1): 3840x2160, 30.000 Hz, pixel clock 297000 kHz:
  HDMI TMDS at 371250 kHz, scrambled, RGB at 10 bpc (TMDS takes up to
  600000 kHz to this display; FRL up to 4 lanes at 12 Gb/s)

With TMDS it names the FRL that the link would take, or why none ("no
FRL: the connector is not an HDMI one", "the display declares none",
"the assessment of the link found none", "this GPU has none",
"nvidia-modeset.disable_hdmi_frl=1"); the limit it gives for TMDS is
maxSingleLinkPixelClockKHz, the pixel clock of RGB at 8 bpc that NVKMS
validates against (the GPU, the display and a passive DisplayPort
adapter). With FRL it gives the depth at which TMDS would carry the mode
(nvHdmiIsTmdsPossible() at 12, 10 and 8 bpc, only the depths the display
takes). nvHdmiFrlSetConfig() returns whether the link trained, and where
it did not (NVIDIA's own "HDMI FRL link training failed." comes first, as
before) a warning follows:

  Hades: the FRL link of head 0 (DFP-1) did not train at 4 lanes at 10
  Gb/s: NVKMS drives this mode over a link that is not trained, which a
  display does not show. A cable or a port that does not carry HDMI 2.1
  FRL does this; with nvidia-modeset.disable_hdmi_frl=1 every mode that
  TMDS carries goes over TMDS (TMDS would carry it in RGB at 8 bpc)

Nothing that goes out changes: what nvHdmiFrlSetConfig() does is as
before (the same tries and the same fallback link training), and the new
function only reads the head and the display. The TMDS character rate
and the threshold of scrambling are plain functions in nvkms-hades.h
(nvHadesTmdsCharacterRateKHz(), nvHadesTmdsScrambled()): RGB and YCbCr
4:4:4 at the pixel clock times bpc / 8, YCbCr 4:2:2 at the pixel clock,
the YCbCr 4:2:0 of the hardware at half of it times bpc / 8, scrambled
above 340 MHz.

Checked on the host with NVIDIA's nvkms-hdmi.c and nvkms-dpy.c of this
tree and the timing library, on the EDID of an LG C5 with the caps of
Ampere and Ada: the choice of link above, at 8, 10 and 12 bpc; the lines
for each mode, with FRL trained and not, on an HDMI and on a dual-mode
DisplayPort connector, with disable_hdmi_frl; the return value of
nvHdmiFrlSetConfig() over training that succeeds at once, after retries,
at the last try and never (83 checks; each of 10 mutations of the new
code makes one fail). Not run on a GPU.
---
 src/nvidia-modeset/include/nvkms-hades.h |  32 ++++
 src/nvidia-modeset/include/nvkms-hdmi.h  |   7 +-
 src/nvidia-modeset/src/nvkms-hdmi.c      | 226 ++++++++++++++++++++++-
 src/nvidia-modeset/src/nvkms-modeset.c   |  16 +-
 4 files changed, 277 insertions(+), 4 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index d601e05..95778ed 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -540,4 +540,36 @@ static inline NvU32 nvHadesHdr10PlusHdmiSharedPacket(const NvU8 *payload,
     ((NVHDMIPKT_TC)(NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME_SW_CHECKSUM | \
                     DRF_DEF(_HDMI_PKT, _TRANSMIT_CTRL, _LOC, _VSYNC)))
 
+/*
+ * The TMDS character rate of an HDMI mode, in kHz, for the kernel log of how
+ * an HDMI head goes out (nvHadesLogHdmiLink()): RGB and YCbCr 4:4:4 carry the
+ * pixel clock times bpc / 8 (deep colour packing), YCbCr 4:2:2 the pixel clock
+ * at any depth (up to 12 bits in the 24 of a pixel), and the YCbCr 4:2:0 of the
+ * hardware half the pixel clock times bpc / 8 (HDMI 2.0, 7.1 and 7.2). Above
+ * 340 MHz a sink takes TMDS scrambled only (HDMI 2.0, 6.1).
+ */
+#define NV_HADES_TMDS_PACKING_444 0
+#define NV_HADES_TMDS_PACKING_422 1
+#define NV_HADES_TMDS_PACKING_420 2
+
+static inline NvU32 nvHadesTmdsCharacterRateKHz(NvU32 pixelClockKHz,
+                                                NvU32 packing,
+                                                NvU32 bpc)
+{
+    NvU64 clock = pixelClockKHz;
+
+    if (packing == NV_HADES_TMDS_PACKING_422) {
+        return pixelClockKHz;
+    }
+    if (packing == NV_HADES_TMDS_PACKING_420) {
+        clock /= 2;
+    }
+    return (NvU32)((clock * bpc) / 8);
+}
+
+static inline NvBool nvHadesTmdsScrambled(NvU32 characterRateKHz)
+{
+    return characterRateKHz > 340000;
+}
+
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/include/nvkms-hdmi.h b/src/nvidia-modeset/include/nvkms-hdmi.h
index 0fef776..03bead3 100644
--- a/src/nvidia-modeset/include/nvkms-hdmi.h
+++ b/src/nvidia-modeset/include/nvkms-hdmi.h
@@ -93,7 +93,12 @@ NvBool nvHdmiFrlQueryConfigOneColorFormatAndBpc(const NVDpyEvoRec *pDpyEvo,
                                                HDMI_FRL_CONFIG *pConfig,
                                                NVDscInfoEvoRec *pDscInfo);
 void nvHdmiFrlClearConfig(NVDispEvoRec *pDispEvo, NvU32 activeRmId);
-void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head);
+NvBool nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head);
+void nvHadesLogHdmiLink(const NVDispEvoRec *pDispEvo,
+                        NvU32 head,
+                        const NVDpyEvoRec *pDpyEvo,
+                        const NVDpyAttributeColor *pColor,
+                        NvBool frlTrained);
 
 void nvHdmiDpConstructHeadAudioState(const NvU32 displayId,
                                      const NVDpyEvoRec *pDpyEvo,
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index a952cdb..732e1ea 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -3232,7 +3232,12 @@ static enum NvKmsFrlRateForce GetForceMaxFrlRateType(
     return NVKMS_FRL_RATE_FORCE_NONE;
 }
 
-void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
+/*
+ * Hades: returns whether the FRL link trained (TRUE without FRL), for the
+ * kernel log of the mode set (nvHadesLogHdmiLink()). What is done is as
+ * before.
+ */
+NvBool nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
 {
     const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
     NVDispHeadStateEvoRec *pHeadState =
@@ -3241,9 +3246,10 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
     NVHDMIPKT_RESULT ret;
     NvU32 retries = 0;
     const NvU32 MAX_RETRIES = 5;
+    NvBool trained;
 
     if (pFrlConfig->frlRate == HDMI_FRL_DATA_RATE_NONE) {
-        return;
+        return NV_TRUE;
     }
 
     nvAssert(pHeadState->activeRmId != 0);
@@ -3256,6 +3262,8 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
                                   pFrlConfig);
     } while (ret != NVHDMIPKT_SUCCESS && retries++ < MAX_RETRIES);
 
+    trained = (ret == NVHDMIPKT_SUCCESS);
+
     if (ret != NVHDMIPKT_SUCCESS) {
         nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
                      "HDMI FRL link training failed.");
@@ -3285,4 +3293,218 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
                           "HDMI FRL link training retried %d times.",
                           retries);
     }
+
+    return trained;
+}
+
+/* Hades: the lanes of an FRL rate and the Gb/s of each lane */
+static NvBool HadesFrlLanes(HDMI_FRL_DATA_RATE rate, NvU32 *pLanes, NvU32 *pGbps)
+{
+    switch (rate) {
+        case HDMI_FRL_DATA_RATE_3LANES_3GBPS:
+            *pLanes = 3; *pGbps = 3;
+            return NV_TRUE;
+        case HDMI_FRL_DATA_RATE_3LANES_6GBPS:
+            *pLanes = 3; *pGbps = 6;
+            return NV_TRUE;
+        case HDMI_FRL_DATA_RATE_4LANES_6GBPS:
+            *pLanes = 4; *pGbps = 6;
+            return NV_TRUE;
+        case HDMI_FRL_DATA_RATE_4LANES_8GBPS:
+            *pLanes = 4; *pGbps = 8;
+            return NV_TRUE;
+        case HDMI_FRL_DATA_RATE_4LANES_10GBPS:
+            *pLanes = 4; *pGbps = 10;
+            return NV_TRUE;
+        case HDMI_FRL_DATA_RATE_4LANES_12GBPS:
+            *pLanes = 4; *pGbps = 12;
+            return NV_TRUE;
+        default:
+            *pLanes = 0; *pGbps = 0;
+            return NV_FALSE;
+    }
+}
+
+static const char *HadesColorFormatName(const NVDpyAttributeColor *pColor,
+                                        const NVHwModeTimingsEvo *pTimings)
+{
+    switch (pColor->format) {
+        case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422:
+            return "YCbCr 4:2:2";
+        case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr444:
+            return "YCbCr 4:4:4";
+        case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr420:
+            return (pTimings->yuv420Mode == NV_YUV420_MODE_SW) ?
+                "YCbCr 4:2:0 (made in software: half the width and the pixel clock)" :
+                "YCbCr 4:2:0";
+        case NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB:
+        default:
+            return "RGB";
+    }
+}
+
+/*
+ * Hades: the most bits per component at which TMDS would carry these timings
+ * to this display in RGB, by NVKMS's own limit (nvHdmiIsTmdsPossible()); 0
+ * where no depth fits. Only the depths the display takes over HDMI are asked.
+ */
+static NvU32 HadesTmdsRgbBpc(const NVDpyEvoRec *pDpyEvo,
+                             const NVHwModeTimingsEvo *pTimings)
+{
+    NVHwModeTimingsEvo timings = *pTimings;
+    NVDpyAttributeColor color;
+
+    nvkms_memset(&color, 0, sizeof(color));
+    color.format = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB;
+    timings.yuv420Mode = NV_YUV420_MODE_NONE;
+
+    if (nvDpyIsHdmiDepth36Evo(pDpyEvo) || nvDpyIsHdmiHdrDepth36Evo(pDpyEvo)) {
+        color.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
+        if (nvHdmiIsTmdsPossible(pDpyEvo, &timings, &color)) {
+            return 12;
+        }
+    }
+    if (nvDpyIsHdmiDepth30Evo(pDpyEvo)) {
+        color.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_10;
+        if (nvHdmiIsTmdsPossible(pDpyEvo, &timings, &color)) {
+            return 10;
+        }
+    }
+    color.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8;
+    if (nvHdmiIsTmdsPossible(pDpyEvo, &timings, &color)) {
+        return 8;
+    }
+    return 0;
+}
+
+/* Hades: why an HDMI display gets no FRL (nvHdmiIsFrlPossible()); NULL where it can */
+static const char *HadesNoFrlReason(const NVDpyEvoRec *pDpyEvo)
+{
+    const NVDevEvoRec *pDevEvo = pDpyEvo->pDispEvo->pDevEvo;
+
+    if (nvkms_disable_hdmi_frl()) {
+        return "nvidia-modeset.disable_hdmi_frl=1";
+    }
+    if (!pDevEvo->hal->caps.supportsHDMIFRL) {
+        return "this GPU has none";
+    }
+    if (pDpyEvo->pConnectorEvo->type != NVKMS_CONNECTOR_TYPE_HDMI) {
+        return "the connector is not an HDMI one";
+    }
+    if (!pDpyEvo->parsedEdid.valid ||
+        !pDpyEvo->parsedEdid.info.hdmiForumInfo.max_FRL_Rate) {
+        return "the display declares none";
+    }
+    if (pDpyEvo->hdmi.sinkCaps.linkMaxFRLRate == HDMI_FRL_DATA_RATE_NONE) {
+        return "the assessment of the link found none";
+    }
+    return NULL;
+}
+
+/*
+ * Hades: one line in the kernel log for each mode set of an HDMI head (also
+ * the TMDS output of a dual-mode DisplayPort connector): the mode, whether it
+ * goes out over TMDS (at what character rate, scrambled or not) or over FRL
+ * (lanes, rate, DSC), the colour format and the depth, and what the link to
+ * this display takes: TMDS up to what NVKMS allows it (the pixel clock of RGB
+ * at 8 bpc), and FRL or why not. With FRL, the depth at which TMDS would carry
+ * the mode, and, where the link did not train (nvHdmiFrlSetConfig()), a
+ * warning that says so. Nothing that goes out changes.
+ *
+ * Why: with "max bpc" left to the driver, NVKMS takes the most bits per
+ * component that the display and max_output_color_depth (10 unless set)
+ * allow (nvGetDefaultDpyColor()), and goes over FRL wherever TMDS does not
+ * carry the mode at that depth (GetDfpHdmiProtocol(): it does not lower the
+ * depth first; at 10 bpc TMDS reaches a pixel clock of 324 MHz on Ampere and
+ * Ada). To an HDMI 2.1 TV with deep colour, 3840x2160 at 50 and 60 Hz goes
+ * over FRL, at 24 to 30 Hz over TMDS at 371.25 MHz, scrambled, and 1920x1080
+ * over TMDS below 340 MHz, not scrambled; Windows sends 3840x2160 at 60 Hz in
+ * RGB at 8 bpc, over TMDS at 594 MHz. A laptop that kept 1080p and lost every
+ * 2160p mode (issue #8 of the Hades tracker) does not tell from its log which
+ * link each mode took; this line does.
+ */
+void nvHadesLogHdmiLink(const NVDispEvoRec *pDispEvo,
+                        NvU32 head,
+                        const NVDpyEvoRec *pDpyEvo,
+                        const NVDpyAttributeColor *pColor,
+                        NvBool frlTrained)
+{
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const NVHwModeTimingsEvo *pTimings = &pHeadState->timings;
+    const HDMI_FRL_CONFIG *pFrlConfig = &pHeadState->hdmiFrlConfig;
+    const NvU32 bpc = (NvU32)pColor->bpc;
+    const NvU32 width = nvEvoVisibleWidth(pTimings);
+    const NvU32 height = nvEvoVisibleHeight(pTimings);
+    const NvU64 total = (NvU64)pTimings->rasterSize.x * pTimings->rasterSize.y;
+    const NvU32 mHz = (total != 0) ?
+        (NvU32)(((NvU64)pTimings->pixelClock * 1000000ULL) / total) : 0;
+    const char *format = HadesColorFormatName(pColor, pTimings);
+    const NvU32 tmdsMaxKHz = pDpyEvo->maxSingleLinkPixelClockKHz;
+    NvU32 lanes, gbps;
+
+    if ((pTimings->protocol == NVKMS_PROTOCOL_SOR_HDMI_FRL) &&
+        HadesFrlLanes(pFrlConfig->frlRate, &lanes, &gbps)) {
+        const NvU32 tmdsBpc = HadesTmdsRgbBpc(pDpyEvo, pTimings);
+        char tmds[64];
+
+        if (tmdsBpc != 0) {
+            nvkms_snprintf(tmds, sizeof(tmds),
+                           "TMDS would carry it in RGB at %u bpc", tmdsBpc);
+        } else {
+            nvkms_snprintf(tmds, sizeof(tmds),
+                           "TMDS would not carry it in RGB");
+        }
+
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: head %u (%s): %ux%u, %u.%03u Hz, pixel clock %u kHz: "
+                     "HDMI FRL, %u lanes at %u Gb/s%s, %s at %u bpc (TMDS takes up "
+                     "to %u kHz to this display; %s)",
+                     head, pDpyEvo->name, width, height, mHz / 1000, mHz % 1000,
+                     pTimings->pixelClock, lanes, gbps,
+                     pFrlConfig->dscInfo.bEnableDSC ? " with DSC" : "",
+                     format, bpc, tmdsMaxKHz, tmds);
+
+        if (!frlTrained) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: the FRL link of head %u (%s) did not train at %u "
+                         "lanes at %u Gb/s: NVKMS drives this mode over a link that "
+                         "is not trained, which a display does not show. A cable or "
+                         "a port that does not carry HDMI 2.1 FRL does this; with "
+                         "nvidia-modeset.disable_hdmi_frl=1 every mode that TMDS "
+                         "carries goes over TMDS (%s)",
+                         head, pDpyEvo->name, lanes, gbps, tmds);
+        }
+        return;
+    }
+
+    {
+        const NvU32 packing =
+            (pColor->format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422) ?
+                NV_HADES_TMDS_PACKING_422 :
+            (pTimings->yuv420Mode == NV_YUV420_MODE_HW) ?
+                NV_HADES_TMDS_PACKING_420 : NV_HADES_TMDS_PACKING_444;
+        const NvU32 rateKHz =
+            nvHadesTmdsCharacterRateKHz(pTimings->pixelClock, packing, bpc);
+        const char *noFrl = HadesNoFrlReason(pDpyEvo);
+        char frl[80];
+
+        if (noFrl != NULL) {
+            nvkms_snprintf(frl, sizeof(frl), "no FRL: %s", noFrl);
+        } else if (HadesFrlLanes(pDpyEvo->hdmi.sinkCaps.linkMaxFRLRate,
+                                 &lanes, &gbps)) {
+            nvkms_snprintf(frl, sizeof(frl), "FRL up to %u lanes at %u Gb/s",
+                           lanes, gbps);
+        } else {
+            nvkms_snprintf(frl, sizeof(frl), "FRL");
+        }
+
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: head %u (%s): %ux%u, %u.%03u Hz, pixel clock %u kHz: "
+                     "HDMI TMDS at %u kHz%s, %s at %u bpc (TMDS takes up to %u kHz "
+                     "to this display; %s)",
+                     head, pDpyEvo->name, width, height, mHz / 1000, mHz % 1000,
+                     pTimings->pixelClock, rateKHz,
+                     nvHadesTmdsScrambled(rateKHz) ? ", scrambled" : "",
+                     format, bpc, tmdsMaxKHz, frl);
+    }
 }
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index dc0bcb4..b3e55ec 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -2965,7 +2965,21 @@ ApplyProposedModeSetHwStateOneHeadPreUpdate(
                 updateState);
 
 
-    nvHdmiFrlSetConfig(pDispEvo, head);
+    {
+        /* Hades: and how an HDMI head goes out now (nvHadesLogHdmiLink()) */
+        const NvBool frlTrained = nvHdmiFrlSetConfig(pDispEvo, head);
+
+        if (isPrimaryHead) {
+            const NVDpyEvoRec *pDpyEvo =
+                nvGetOneArbitraryDpyEvo(pProposedApiHead->dpyIdList, pDispEvo);
+
+            if ((pDpyEvo != NULL) && nvDpyIsHdmiEvo(pDpyEvo)) {
+                nvHadesLogHdmiLink(pDispEvo, head, pDpyEvo,
+                                   &pProposedApiHead->attributes.color,
+                                   frlTrained);
+            }
+        }
+    }
 }
 
