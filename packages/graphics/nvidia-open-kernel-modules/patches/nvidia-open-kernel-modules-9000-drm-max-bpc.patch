From c23acef13de4b327c9ca956acf457d1e466231fd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:47:17 +0000
Subject: [PATCH] nvidia-drm: add the standard "max bpc" connector property

Dolby Vision "Standard" travels over HDMI as 8-bit RGB 4:4:4 that has to reach
the sink byte for byte, so a player must drive the link at exactly 8 bpc while
it plays Dolby Vision, and at the driver's usual depth otherwise. nvidia-drm
has no "max bpc" property, and nvidia-modeset.max_output_color_depth=8 would
lower every output, HDR10 included.

NVKMS already accepts an exact color depth per head in its modeset request
(colorBpc/colorBpcSpecified), but KAPI does not pass one. Add a colorBpc field
to the KAPI head modeset config, pass it to NVKMS, and request a modeset when
it changes. Attach the standard DRM "max bpc" property (8 to 12, default 12)
to HDMI connectors: a value below 10 drives the head at 8 bpc; 10 and above
keep the driver's choice (at most max_output_color_depth, 10 by default).
The default is also set when the connector state is reset, and a zero value
means the driver's choice, so nothing changes unless user space lowers it.

Made again for 615.78.08, which creates the connector state in a new hook
(atomic_create_state) on kernels that have it: the default is set there too.

Made again for 620.70.06, which has its own colorFormat and colorBpc in KAPI and the
NV_CONNECTOR_COLOR_FORMAT and NV_CONNECTOR_OUTPUT_BPC properties: the colorBpc field
and the flags of KAPI are NVIDIA's; "max bpc" below 10 gives 8 bpc where
NV_CONNECTOR_OUTPUT_BPC is left to the driver (AUTO), and the depth is still compared
with the head's inherited configuration.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 61 ++++++++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  3 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 13 ++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  1 +
 4 files changed, 75 insertions(+), 3 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index c830c33..ea038f6 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -342,6 +342,11 @@ nv_drm_connector_atomic_create_state(struct drm_connector *connector)
     __drm_atomic_helper_connector_state_reset(&nv_connector_state->base, connector);
 #endif
 
+    if (connector->max_bpc_property) {
+        nv_connector_state->base.max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        nv_connector_state->base.max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+    }
+
     return &nv_connector_state->base;
 }
 #else
@@ -363,6 +368,11 @@ static void nv_drm_connector_reset(struct drm_connector *connector)
     }
 
     __drm_atomic_helper_connector_reset(connector, &nv_connector_state->base);
+
+    if (connector->max_bpc_property) {
+        nv_connector_state->base.max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        nv_connector_state->base.max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+    }
 }
 #endif
 
@@ -664,6 +674,22 @@ static const NvU32 __nv_drm_connector_supported_colorspaces =
 #endif
 
 #if defined(NV_DRM_CONNECTOR_ATTACH_HDR_OUTPUT_METADATA_PROPERTY_PRESENT)
+/*
+ * Output depth requested through "max bpc": 8 below 10, otherwise 0 (let the
+ * driver choose). A zero value (a state reset before the property existed)
+ * also means the driver's choice.
+ */
+static NvU32 nv_drm_connector_requested_bpc(
+    const struct drm_connector_state *connector_state)
+{
+    if (connector_state->connector->max_bpc_property &&
+        connector_state->max_requested_bpc >= 8 &&
+        connector_state->max_requested_bpc < 10) {
+        return 8;
+    }
+    return 0;
+}
+
 static int
 __nv_drm_connector_atomic_check(struct drm_connector *connector,
                                 nv_drm_atomic_state_base_t *state)
@@ -740,14 +766,29 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
     req_config->modeSetConfig.colorFormat = nvkms_fmt;
 
     /* Handle output bpc changes */
-    req_config->flags.colorBpcChanged =
-        (nv_old_connector_state->output_bpc !=
-         nv_new_connector_state->output_bpc);
     ret = nv_drm_connector_translate_output_bpc(
         nv_new_connector_state->output_bpc, &nvkms_bpc);
     if (ret != 0) {
         return ret;
     }
+
+    /*
+     * Hades: where NV_CONNECTOR_OUTPUT_BPC leaves the choice to NVKMS, the
+     * standard "max bpc" below 10 drives the head at 8 bpc. The depth is
+     * compared with the head's inherited configuration, so that it also
+     * follows a connector moving to this head; a change needs a modeset.
+     */
+    if (nvkms_bpc == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_UNKNOWN) {
+        const NvU32 bpc = nv_drm_connector_requested_bpc(new_connector_state);
+
+        if (bpc != 0) {
+            nvkms_bpc = bpc;
+        }
+    }
+    req_config->flags.colorBpcChanged =
+        (nv_old_connector_state->output_bpc !=
+         nv_new_connector_state->output_bpc) ||
+        (req_config->modeSetConfig.colorBpc != nvkms_bpc);
     req_config->modeSetConfig.colorBpc = nvkms_bpc;
 
     /* Handle HDMI VSIF metadata changes */
@@ -1000,6 +1041,20 @@ nv_drm_connector_new(struct drm_device *dev,
     }
 #endif /* defined(NV_DRM_CONNECTOR_ATTACH_HDR_OUTPUT_METADATA_PROPERTY_PRESENT) */
 
+    /* Attach the standard "max bpc" property to HDMI connectors */
+    if ((nv_connector->type == NVKMS_CONNECTOR_TYPE_HDMI) &&
+        nv_dev->nv_connector_max_bpc_property) {
+        nv_connector->base.max_bpc_property =
+            nv_dev->nv_connector_max_bpc_property;
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_max_bpc_property,
+                                   NV_DRM_MAX_BPC_DEFAULT);
+        if (nv_connector->base.state) {
+            nv_connector->base.state->max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+            nv_connector->base.state->max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        }
+    }
+
     /* Attach dithering mode property */
     if (nv_dev->nv_connector_dithering_mode_property) {
         drm_object_attach_property(&nv_connector->base.base,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 2ab433e..31abc61 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -86,6 +86,9 @@ static inline struct nv_drm_connector *to_nv_connector(
     return container_of(connector, struct nv_drm_connector, base);
 }
 
+/* Initial value of the "max bpc" property: let the driver choose. */
+#define NV_DRM_MAX_BPC_DEFAULT 12
+
 struct nv_drm_connector_state {
        struct drm_connector_state base;
        enum nv_drm_dithering_mode dithering_mode;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index de784e2..b3c1cd6 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -725,6 +725,19 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Standard "max bpc" connector property, attached to HDMI connectors.
+     * Values below 10 drive the head at 8 bpc; 10 and above keep the
+     * driver's choice (at most nvidia-modeset.max_output_color_depth).
+     */
+    nv_dev->nv_connector_max_bpc_property =
+        drm_property_create_range(nv_dev->dev, 0, "max bpc",
+                                  8, NV_DRM_MAX_BPC_DEFAULT);
+    if (nv_dev->nv_connector_max_bpc_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create max bpc property");
+        return -ENOMEM;
+    }
+
     // Color Pipeline Passthrough Properties
     nv_dev->nv_plane_color_passthrough_property =
         drm_property_create_bool(nv_dev->dev, 0,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 6120401..a93d071 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -215,6 +215,7 @@ struct nv_drm_device {
     struct drm_property *nv_crtc_color_passthrough_property;
 
     struct drm_property *nv_connector_dithering_mode_property;
+    struct drm_property *nv_connector_max_bpc_property;
 
     struct drm_property *nv_connector_color_format_property;
     struct drm_property *nv_connector_output_bpc_property;
-- 
2.53.0

