From 61d83d8c3c583259fc4888e3bf63de7f85d77533 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:38:08 +0000
Subject: [PATCH 1/2] nvidia-drm: NV_HDMI_VRR_OFF on every connector with a
 TMDS output

NV_HDMI_VRR_OFF (nvidia-open-kernel-modules-9051) lets a client leave HDMI
VRR off in the mode set of a head: KAPI then asks NVKMS for no Adaptive-Sync,
and the display gets no EMP of HDMI VRR. It was attached only where HDR10+
needs the generic InfoFrame slot that the EMP takes
(NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF: Turing, and Ampere where RM does not
keep that slot for its ACR workaround).

Kodi uses it for more than HDR10+. Native Dolby Vision leaves HDMI VRR off
with the rest of its transport, so that the Dolby InfoFrame never goes out
beside the EMP of VRR (the tunnel is meant to go out without VRR). On Ada,
Blackwell and GA10x the property was not there, so Dolby Vision at 50 Hz and
up went out with HDMI VRR on to a display that declares it; the public
documentation said GTX 16, RTX 20 and RTX 30. And Kodi never flips with VRR
(it never sets VRR_ENABLED), yet it had no way to leave HDMI VRR off in the
mode of its menus: a black screen on the way back to 3840x2160 at 120 Hz over
FRL on an RTX 4080 SUPER, in a mode where HDMI VRR is on, makes that worth
having.

The property is now attached to every connector with a TMDS output of the
GPU (an HDMI connector, or the TMDS output of a dual-mode DisplayPort port),
on every GPU of the open modules, when the encoder of that output is created:
before the device is registered, as for the other properties of this driver.
Its default, 0, changes nothing: NVKMS turns HDMI VRR on where it did. The
HDR10+ route attaches it where it did; a connector gets it once. KAPI and
NVKMS do not change (hadesHdmiVrrOff already asks for no Adaptive-Sync on
every HAL). nvidia-legacy (driver 580) is not changed.

Checked: the five modules build against Linux 7.3.5 with the compiler of the
image; the patch applies with --fuzz=0 after the series before it, from
nvidia-open-kernel-modules-9072 to 9073. Not run on a GPU.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 67 +++++++++++++++----
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  3 +-
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  7 +-
 kernel-open/nvidia-drm/nvidia-drm-encoder.c   |  5 +-
 4 files changed, 64 insertions(+), 18 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 1b1cfbc..b5a1382 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -676,7 +676,8 @@ static int nv_drm_connector_atomic_get_property(
  * Dolby VSIF of the tunnel in NV_HDMI_VSIF_METADATA (and Low-Latency, the
  * signalling of HDMI 1.4b, or HDR10+): the console would go out next to it, as
  * a tunnel the display cannot read. They are dropped from the state of the
- * client's commit, and so is NV_HDMI_VRR_OFF, which only HDR10+ needs;
+ * client's commit, and so is NV_HDMI_VRR_OFF, which a client sets for its own
+ * mode sets;
  * dithering and "max bpc", which only make the console exact, stay.
  */
 static void nv_drm_connector_atomic_client_restore(
@@ -1305,9 +1306,11 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
 
     /*
      * Hades: NV_HDMI_VRR_OFF, HDMI VRR left off in the mode set of the head
-     * (hadesHdmiVrrOff of KAPI: Adaptive-Sync not allowed), so that HDR10+ has
-     * the generic InfoFrame slot where the EMP of HDMI VRR would take it
-     * (Turing and Ampere, the connectors it is attached to). Compared with the
+     * (hadesHdmiVrrOff of KAPI: Adaptive-Sync not allowed): no EMP of HDMI VRR,
+     * so that HDR10+ has the generic InfoFrame slot where it would take it
+     * (Turing and Ampere), and Dolby Vision, or a client that never flips with
+     * VRR, goes out without it (every connector with a TMDS output:
+     * nv_drm_connector_add_hdmi_vrr_off()). Compared with the
      * head's inherited configuration, as "max bpc" is; a change of it needs a
      * mode set, so a commit without DRM_MODE_ATOMIC_ALLOW_MODESET that changes
      * it is refused (drm_atomic_check_only()).
@@ -1829,14 +1832,57 @@ done:
  * encoders of the static displays are added before, and properties cannot be
  * attached to a registered connector.
  */
+/*
+ * Hades: NV_HDMI_VRR_OFF on a connector with a TMDS output of the GPU (an HDMI
+ * connector, or the TMDS output of a dual-mode DisplayPort one), on every GPU.
+ * NVKMS turns HDMI VRR on in every mode set of a display that declares it
+ * (nvGetAllowedDpyVrrType(): 50 Hz and 720 lines up, and 110 % of the
+ * display's VRR minimum) and sends the EMP of HDMI VRR with every frame, also
+ * to a client that never sets VRR_ENABLED and so never flips with VRR. With 1,
+ * the mode set of the head asks NVKMS for no Adaptive-Sync (hadesHdmiVrrOff of
+ * KAPI), on every HAL: no EMP of HDMI VRR goes out. A client leaves it off for
+ * native Dolby Vision, whose tunnel goes out without VRR, and may leave it off
+ * in the other mode sets it makes. It was attached only where HDR10+ needs it
+ * (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF: Turing, and Ampere where RM does
+ * not keep the generic InfoFrame slot for its ACR workaround), so that on Ada,
+ * Blackwell and GA10x Dolby Vision went out at 50 Hz and up with HDMI VRR on.
+ * Its default, 0, changes nothing. Only while the device is not registered
+ * yet: the encoders of the static displays are added before, and properties
+ * cannot be attached to a registered connector.
+ */
+void nv_drm_connector_add_hdmi_vrr_off(struct nv_drm_connector *nv_connector)
+{
+    struct drm_device *dev = nv_connector->base.dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+
+    if (nv_connector->hdmi_vrr_off ||
+        nv_dev->nv_connector_hdmi_vrr_off_property == NULL) {
+        return;
+    }
+
+    if (dev->registered) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Connector at physical index %u has a TMDS output, on which NV_HDMI_VRR_OFF is not offered",
+            nv_connector->physicalIndex);
+        return;
+    }
+
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdmi_vrr_off_property,
+                               0);
+    nv_connector->hdmi_vrr_off = true;
+}
+
 /*
  * Hades: HDR10PLUS_VSIF on a connector through which NVKMS can send an HDR10+
  * vendor InfoFrame next to the HDR one (routes, from
  * NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS of one of its displays). Its presence
  * tells a client that it can give the metadata of each frame with the commit
  * of that frame. And NV_HDMI_VRR_OFF where HDR10+ over HDMI needs HDMI VRR off
- * in a mode set where it would be on (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF):
- * its presence tells a client that it may need it. And NV_HDR10PLUS_AVI_CTA_VIC,
+ * in a mode set where it would be on (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF;
+ * every connector with a TMDS output has it anyway:
+ * nv_drm_connector_add_hdmi_vrr_off()). And NV_HDR10PLUS_AVI_CTA_VIC,
  * read-only and 1, where HDR10+ over HDMI puts the CTA VIC of a mode named by
  * an HDMI_VIC in the AVI InfoFrame (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC:
  * Turing, Ampere, Ada; not T239 nor Blackwell): there HDR10+ that starts some
@@ -1849,13 +1895,8 @@ void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
     struct drm_device *dev = nv_connector->base.dev;
     struct nv_drm_device *nv_dev = to_nv_device(dev);
 
-    if ((routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF) &&
-        !nv_connector->hdmi_vrr_off && !dev->registered &&
-        nv_dev->nv_connector_hdmi_vrr_off_property != NULL) {
-        drm_object_attach_property(&nv_connector->base.base,
-                                   nv_dev->nv_connector_hdmi_vrr_off_property,
-                                   0);
-        nv_connector->hdmi_vrr_off = true;
+    if (routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF) {
+        nv_drm_connector_add_hdmi_vrr_off(nv_connector);
     }
 
     if ((routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC) &&
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index b5e34e4..4e288f6 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -54,7 +54,7 @@ enum nv_drm_allm_mode {
 struct nv_drm_connector {
     /* Hades: HDR10PLUS_VSIF is attached (nv_drm_connector_add_hdr10plus()) */
     bool hdr10plus;
-    /* Hades: NV_HDMI_VRR_OFF is attached (nv_drm_connector_add_hdr10plus()) */
+    /* Hades: NV_HDMI_VRR_OFF is attached (nv_drm_connector_add_hdmi_vrr_off()) */
     bool hdmi_vrr_off;
     /* Hades: NV_HDR10PLUS_AVI_CTA_VIC is attached (nv_drm_connector_add_hdr10plus()) */
     bool hdr10plus_avi_cta_vic;
@@ -179,6 +179,7 @@ static inline NvU64 nv_drm_dual_mode_adaptor_value(bool tmds, bool said,
     return (said && (adaptor < 255)) ? adaptor : 255;
 }
 void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector);
+void nv_drm_connector_add_hdmi_vrr_off(struct nv_drm_connector *nv_connector);
 void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
                                     NvU32 routes);
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index f9ab0e0..3801506 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -897,9 +897,10 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
     }
 
     /*
-     * Hades: HDMI VRR left off in the mode set of the head, so that HDR10+ has
-     * the generic InfoFrame slot that the EMP of HDMI VRR would take (Turing
-     * and Ampere; nvidia-drm-connector.c)
+     * Hades: HDMI VRR left off in the mode set of the head: for HDR10+, the
+     * generic InfoFrame slot that the EMP of HDMI VRR would take (Turing and
+     * Ampere), for Dolby Vision, and for a client that never flips with VRR
+     * (every connector with a TMDS output; nvidia-drm-connector.c)
      */
     nv_dev->nv_connector_hdmi_vrr_off_property =
         drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_VRR_OFF");
diff --git a/kernel-open/nvidia-drm/nvidia-drm-encoder.c b/kernel-open/nvidia-drm/nvidia-drm-encoder.c
index ddaa105..24eeff3 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-encoder.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-encoder.c
@@ -243,10 +243,13 @@ nv_drm_add_encoder(struct drm_device *dev, NvKmsKapiDisplay hDisplay)
 
     /*
      * Hades: a TMDS output of the GPU on a DisplayPort connector makes it a
-     * dual-mode one (nv_drm_connector_add_dual_mode_tmds()).
+     * dual-mode one (nv_drm_connector_add_dual_mode_tmds()); and a connector
+     * with a TMDS output gets NV_HDMI_VRR_OFF, on every GPU
+     * (nv_drm_connector_add_hdmi_vrr_off()).
      */
     if (connectorInfo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS) {
         nv_drm_connector_add_dual_mode_tmds(nv_encoder->nv_connector);
+        nv_drm_connector_add_hdmi_vrr_off(nv_encoder->nv_connector);
     }
 
     /* Hades: HDR10PLUS_VSIF where NVKMS can send HDR10+ through this output */
-- 
2.53.0

