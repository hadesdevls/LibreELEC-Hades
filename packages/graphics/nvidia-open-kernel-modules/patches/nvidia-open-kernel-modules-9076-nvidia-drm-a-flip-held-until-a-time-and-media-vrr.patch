diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index 29968a7..3113022 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -191,6 +191,12 @@ struct NvKmsKapiDeviceResourcesInfo {
 
         NvBool supportsColorPassthrough;
 
+        /*
+         * Hades: the GPU has Media VRR, a refresh rate programmed at flip time
+         * (NVKMS supportsVirtualRefreshRate: Blackwell): hadesVrrMedia.
+         */
+        NvBool hadesSupportsVirtualRefreshRate;
+
         NvBool contiguousPhysicalMappings;
 
         /*
@@ -482,6 +488,27 @@ struct NvKmsKapiHeadModeSetConfig {
      * NV_HDMI_VRR_OFF, whose change needs a mode set.
      */
     NvBool hadesHdmiVrrOff;
+
+    /*
+     * Hades: the earliest time at which the flip of this head may be shown, in
+     * nanoseconds of CLOCK_MONOTONIC_RAW (the CPU clock of RM's GPU-CPU time
+     * correlation); 0 for none. KmsFlip() turns it into the PTIMER time of the
+     * main layer's timeStamp ("block the flip until PTIMER >= timeStamp"). With
+     * VRR active the display engine then starts the frame at that time. A time
+     * more than a second from now is not taken. nvidia-drm sets it from
+     * NV_FLIP_TIME_RAW_NS, for one commit.
+     */
+    NvU64 hadesFlipTimeRawNs;
+
+    /*
+     * Hades: Media VRR for the mode set of this head (NVKMS_REQUESTED_VRR_TYPE_MEDIA,
+     * where the GPU has it: hadesSupportsVirtualRefreshRate), from NV_VRR_MEDIA;
+     * a change of it needs a mode set. And the refresh rate that its flips ask
+     * for while VRR is active, from NV_VRR_MEDIA_TARGET: the rate in Hz shifted
+     * left by one, with bit 0 for the divider of 1.001 (0: the rate of the mode).
+     */
+    NvBool hadesVrrMedia;
+    NvU16 hadesVrrMediaTarget;
 };
 
 /* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
