         return 0;
@@ -1964,6 +1976,18 @@ static int nv_drm_atomic_crtc_set_property(
         to_nv_crtc_state(state);
     NvBool replaced = false;
 
+    /* Hades: NV_FLIP_TIME_RAW_NS, NV_VRR_MEDIA, NV_VRR_MEDIA_TARGET */
+    if (property == nv_dev->nv_crtc_hades_flip_time_property) {
