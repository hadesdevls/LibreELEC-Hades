+/*
+ * Hades: the PTIMER time of a time of CLOCK_MONOTONIC_RAW (hadesFlipTimeRawNs),
+ * by RM's GPU-CPU time correlation: the one that NVKMS takes to turn the
+ * timestamps of the raster generator into CPU time (nvUpdateGpuCpuTimeDiff(),
+ * the CPU clock of NV2080_TIMER_GPU_CPU_TIME_CPU_CLK_ID_PLATFORM_API, which RM
+ * reads with os_get_monotonic_time_ns_hr()). Read again once the time asked for
+ * is more than a second from the last reading, so that the two clocks cannot
+ * drift apart. FALSE, and no time for the flip, where the correlation cannot
+ * be read or the time is more than a second from a fresh reading: a time that
+ * far is no time a client asks for its next frames, and the flip is not held
+ * for it.
+ */
+static NvBool HadesFlipTimeToPtimer(struct NvKmsKapiDevice *device,
+                                    NvU64 rawNs,
+                                    NvU64 *pPtimer)
+{
+    const NvU64 window = 1000000000ULL;
+    NvS64 offset;
+
+    if ((device->hadesTime.cpuNs == 0) ||
+        (rawNs > device->hadesTime.cpuNs + window) ||
+        (rawNs + window < device->hadesTime.cpuNs)) {
+        NV2080_CTRL_TIMER_GET_GPU_CPU_TIME_CORRELATION_INFO_PARAMS params = { 0 };
+
+        params.cpuClkId =
+            DRF_NUM(2080, _TIMER_GPU_CPU_TIME, _CPU_CLK_ID_SOURCE,
+                    NV2080_TIMER_GPU_CPU_TIME_CPU_CLK_ID_PLATFORM_API) |
+            DRF_NUM(2080, _TIMER_GPU_CPU_TIME, _CPU_CLK_ID_PROCESSOR,
+                    NV2080_TIMER_GPU_CPU_TIME_CPU_CLK_ID_PROCESSOR_CPU);
+        params.sampleCount = 1;
+
+        if ((nvRmApiControl(device->hRmClient,
+                            device->hRmSubDevice,
