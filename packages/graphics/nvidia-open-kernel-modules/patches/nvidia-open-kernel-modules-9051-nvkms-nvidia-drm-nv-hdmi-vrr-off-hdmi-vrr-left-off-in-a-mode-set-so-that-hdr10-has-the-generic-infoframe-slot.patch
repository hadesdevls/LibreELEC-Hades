From 33b0ba3da32b4c1916c1304733664c602574a19e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:18:20 +0000
Subject: [PATCH] nvkms, nvidia-drm: NV_HDMI_VRR_OFF, HDMI VRR left off in a
 mode set so that HDR10+ has the generic InfoFrame slot

Turing and Ampere have, per head, the AVI, generic, GCP and vendor-specific
InfoFrame slots and nothing else (cl9171.h; nvhdmipkt_9171.c). The HDR
InfoFrame takes the vendor-specific one (nvEvo1SendHdmiInfoFrame()) and the
HDR10+ InfoFrame of 9020 the generic one. NVKMS turns HDMI VRR on in each mode
set of a display that declares it (KAPI allows Adaptive-Sync in all of them),
from 50 Hz and 720 lines up (nvGetAllowedDpyVrrType()), and the EMP of HDMI
VRR then takes the generic slot every frame, whether a flip uses VRR or not:
HDR10+ is refused there ("HDMI VRR sends its EMP in the generic InfoFrame
slot"). An HDR10+ video at 50 or 60 Hz on a TV with HDMI VRR went out as
HDR10. Ada has shared generic slot 2 for it, the HALs with generic shared
InfoFrames slot 9 (9049); GA10x where RM keeps the generic slot for its ACR
workaround has no HDMI route at all.

A connector property of nvidia-drm, NV_HDMI_VRR_OFF (0 or 1, 0 by default),
leaves HDMI VRR off in the mode set of its head: KAPI then asks NVKMS for
allowAdaptiveSync NVKMS_ALLOW_ADAPTIVE_SYNC_DISABLED for that head
(hadesHdmiVrrOff of NvKmsKapiHeadModeSetConfig; NVKMS_ALLOW_ADAPTIVE_SYNC_ALL
without it, as before), the timings get no VRR type, no EMP is sent, and the
generic slot is the HDR10+ InfoFrame's (nvHadesHdr10PlusHdmiSlot()). Kodi sets
it only in the mode set that a video makes anyway.
- It is attached only where it helps: the connectors with the HDMI route of
  HDR10+ on Turing and Ampere, as the new route NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF
  (0x4) of NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS says (nvHadesHdr10PlusRoutes();
  NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF for nvidia-drm, which KAPI takes now
  up to 7). Not on Ada, Blackwell or GA10x with the ACR workaround.
- A change of it needs a mode set: nvidia-drm marks the mode of the head
  changed (compared with the configuration of the head, as "max bpc" is), so
  a commit without DRM_MODE_ATOMIC_ALLOW_MODESET that changes it is refused.
- The console of nvidia-drm drops it, with the other Hades properties of a
  video (atomic_client_restore).
- The kernel log says it where it changes something: "Hades: head N: HDMI VRR
  left off in this mode set so that HDR10+ has the generic InfoFrame slot", in
  a mode set of an HDMI head whose client allows G-SYNC but not Adaptive-Sync
  (KAPI with the property; the console of NVKMS allows neither) and whose
  mode would have had HDMI VRR with Adaptive-Sync allowed
  (nvHadesHdmiVrrLeftOff()). The refusal of HDR10+ for the EMP now names the
  property.
What a display does without the VTEM of HDMI VRR in a mode set where it would
have had it: not verified (Kodi never flips with VRR; the video mode set
goes out without VRR, the next mode set of the interface with it again).

Driver 580 (Maxwell, Pascal, Volta) has no HDMI VRR on those GPUs
(supportsHDMIVRR FALSE in nvEvo94, nvEvo97 and nvEvoC3): nothing to do there.

Not run on a GPU; a Turing or Ampere GPU with an HDR10+ TV that declares HDMI
VRR, at 50 or 60 Hz, is what can show it.

Checked with a host test that runs, from the tree, NvKmsKapiRequestedModeSetConfigToKms()
and GetHdr10PlusRoutes() of KAPI, AdjustHwModeTimingsForVrr() of the mode set
with nvGetAllowedDpyVrrType() and nvAdjustHwModeTimingsForVrrEvo(), and then
the validation of a flip and the InfoFrames of the head on the EVO1 HAL, with
the EDID of a Samsung S90H that declares HDMI VRR from 40 to 120 Hz: KAPI asks
DISABLED only for the head with the property; the timings get no VRR type;
the log line only where VRR would have been on (not at 24 Hz, not for the
console, not for a display without HDMI VRR); HDR10+ validated and in the
generic slot at 50 and 60 Hz, refused as before without the property;
mutations of each of those caught. nvidia-drm.ko and nvidia-modeset.ko
compiled against Linux 7.3 with the compiler of the image.
---
 kernel-open/common/inc/nvkms-kapi.h           | 16 ++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 58 +++++++++++++++++--
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  4 ++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 11 ++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  2 +
 src/nvidia-modeset/include/nvkms-hades.h      | 37 +++++++++++-
 .../include/nvkms-modeset-types.h             |  2 +
 .../kapi/interface/nvkms-kapi.h               | 16 ++++-
 src/nvidia-modeset/kapi/src/nvkms-kapi.c      |  9 ++-
 src/nvidia-modeset/src/nvkms-modeset.c        | 42 ++++++++++++--
 10 files changed, 180 insertions(+), 17 deletions(-)

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index ba7e4dc..301cb98 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -451,8 +451,20 @@ struct NvKmsKapiHeadModeSetConfig {
      * connector property.
      */
     NvU32 colorBpc;
+
+    /*
+     * Hades: HDMI VRR left off in the mode set of this head (allowAdaptiveSync
+     * NVKMS_ALLOW_ADAPTIVE_SYNC_DISABLED; NVKMS_ALLOW_ADAPTIVE_SYNC_ALL
+     * without it), so that no EMP of HDMI VRR takes the generic InfoFrame slot
+     * that HDR10+ needs on Turing and Ampere. nvidia-drm sets it from
+     * NV_HDMI_VRR_OFF, whose change needs a mode set.
+     */
+    NvBool hadesHdmiVrrOff;
 };
 
+/* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+
 struct NvKmsKapiHeadRequestedConfig {
     struct NvKmsKapiHeadModeSetConfig modeSetConfig;
     struct {
@@ -1729,7 +1741,9 @@ struct NvKmsKapiFunctionsTable {
     /*!
      * Hades: where an HDR10+ vendor InfoFrame can go out through the connector
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
-     * DisplayPort, 0 nowhere.
+     * DisplayPort, 0 nowhere; with 0x4 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF)
+     * HDR10+ over HDMI needs HDMI VRR off where it would be on (hadesHdmiVrrOff
+     * of a mode set).
      *
      * \return NV_TRUE on success, NV_FALSE on failure.
      */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 4d586d6..cfdfcb5 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -382,6 +382,8 @@ static struct drm_connector_state* nv_drm_connector_atomic_duplicate_state(struc
         nv_drm_old_connector_state->hdmi_dv_low_latency;
     nv_drm_new_connector_state->hdmi_dv_hdmi14b =
         nv_drm_old_connector_state->hdmi_dv_hdmi14b;
+    nv_drm_new_connector_state->hdmi_vrr_off =
+        nv_drm_old_connector_state->hdmi_vrr_off;
 
     return &nv_drm_new_connector_state->base;
 }
@@ -469,6 +471,14 @@ static int nv_drm_connector_atomic_set_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_vrr_off_property) {
+        if (val > 1) {
+            return -EINVAL;
+        }
+        nv_connector_state->hdmi_vrr_off = val;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -514,6 +524,11 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_vrr_off_property) {
+        *val = nv_connector_state->hdmi_vrr_off;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -528,8 +543,8 @@ static int nv_drm_connector_atomic_get_property(
  * Dolby VSIF of the tunnel in NV_HDMI_VSIF_METADATA (and Low-Latency, the
  * signalling of HDMI 1.4b, or HDR10+): the console would go out next to it, as
  * a tunnel the display cannot read. They are dropped from the state of the
- * client's commit; dithering and "max bpc", which only make the console exact,
- * stay.
+ * client's commit, and so is NV_HDMI_VRR_OFF, which only HDR10+ needs;
+ * dithering and "max bpc", which only make the console exact, stay.
  */
 static void nv_drm_connector_atomic_client_restore(
     struct drm_connector *connector,
@@ -538,20 +553,22 @@ static void nv_drm_connector_atomic_client_restore(
     struct nv_drm_connector_state *s = to_nv_drm_connector_state(state);
 
     if (s->hdmi_vsif_metadata != NULL || s->hdr10plus_vsif != NULL ||
-        s->hdmi_dv_low_latency || s->hdmi_dv_hdmi14b) {
+        s->hdmi_dv_low_latency || s->hdmi_dv_hdmi14b || s->hdmi_vrr_off) {
         drm_info(connector->dev,
                  "[CONNECTOR:%d:%s] the console takes the display: "
                  "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s, "
-                 "NV_HDMI_DV_LOW_LATENCY %d, NV_HDMI_DV_HDMI14B %d dropped\n",
+                 "NV_HDMI_DV_LOW_LATENCY %d, NV_HDMI_DV_HDMI14B %d, "
+                 "NV_HDMI_VRR_OFF %d dropped\n",
                  connector->base.id, connector->name,
                  s->hdmi_vsif_metadata != NULL ? "set" : "none",
                  s->hdr10plus_vsif != NULL ? "set" : "none",
-                 s->hdmi_dv_low_latency, s->hdmi_dv_hdmi14b);
+                 s->hdmi_dv_low_latency, s->hdmi_dv_hdmi14b, s->hdmi_vrr_off);
     }
     drm_property_replace_blob(&s->hdmi_vsif_metadata, NULL);
     drm_property_replace_blob(&s->hdr10plus_vsif, NULL);
     s->hdmi_dv_low_latency = false;
     s->hdmi_dv_hdmi14b = false;
+    s->hdmi_vrr_off = false;
 }
 #endif
 
@@ -963,6 +980,22 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /*
+     * Hades: NV_HDMI_VRR_OFF, HDMI VRR left off in the mode set of the head
+     * (hadesHdmiVrrOff of KAPI: Adaptive-Sync not allowed), so that HDR10+ has
+     * the generic InfoFrame slot where the EMP of HDMI VRR would take it
+     * (Turing and Ampere, the connectors it is attached to). Compared with the
+     * head's inherited configuration, as "max bpc" is; a change of it needs a
+     * mode set, so a commit without DRM_MODE_ATOMIC_ALLOW_MODESET that changes
+     * it is refused (drm_atomic_check_only()).
+     */
+    if (req_config->modeSetConfig.hadesHdmiVrrOff !=
+        nv_new_connector_state->hdmi_vrr_off) {
+        req_config->modeSetConfig.hadesHdmiVrrOff =
+            nv_new_connector_state->hdmi_vrr_off;
+        crtc_state->mode_changed = true;
+    }
+
     /*
      * Hades: HDR10PLUS_VSIF, the HDR10+ vendor InfoFrame of the frame of this
      * commit (27 bytes, IEEE OUI 90-84-8B first). It goes to NVKMS as the
@@ -1400,7 +1433,10 @@ done:
  * vendor InfoFrame next to the HDR one (routes, from
  * NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS of one of its displays). Its presence
  * tells a client that it can give the metadata of each frame with the commit
- * of that frame. Only while the device is not registered yet.
+ * of that frame. And NV_HDMI_VRR_OFF where HDR10+ over HDMI needs HDMI VRR off
+ * in a mode set where it would be on (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF):
+ * its presence tells a client that it may need it. Only while the device is
+ * not registered yet.
  */
 void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
                                     NvU32 routes)
@@ -1408,6 +1444,16 @@ void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
     struct drm_device *dev = nv_connector->base.dev;
     struct nv_drm_device *nv_dev = to_nv_device(dev);
 
+    if ((routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF) &&
+        !nv_connector->hdmi_vrr_off && !dev->registered &&
+        nv_dev->nv_connector_hdmi_vrr_off_property != NULL) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdmi_vrr_off_property,
+                                   0);
+        nv_connector->hdmi_vrr_off = true;
+    }
+
+    routes &= ~NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF;
     if (routes == 0 || nv_connector->hdr10plus ||
         nv_dev->nv_connector_hdr10plus_vsif_property == NULL) {
         return;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 2a2f6e7..5725fcf 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -39,6 +39,8 @@
 struct nv_drm_connector {
     /* Hades: HDR10PLUS_VSIF is attached (nv_drm_connector_add_hdr10plus()) */
     bool hdr10plus;
+    /* Hades: NV_HDMI_VRR_OFF is attached (nv_drm_connector_add_hdr10plus()) */
+    bool hdmi_vrr_off;
     NvU32 physicalIndex;
 
     NvBool internal;
@@ -131,6 +133,8 @@ struct nv_drm_connector_state {
        bool hdmi_dv_low_latency;
        /* Hades: NV_HDMI_DV_HDMI14B */
        bool hdmi_dv_hdmi14b;
+       /* Hades: NV_HDMI_VRR_OFF */
+       bool hdmi_vrr_off;
 };
 
 static inline struct nv_drm_connector_state *to_nv_drm_connector_state(
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 2fa2143..2971e82 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -775,6 +775,17 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: HDMI VRR left off in the mode set of the head, so that HDR10+ has
+     * the generic InfoFrame slot that the EMP of HDMI VRR would take (Turing
+     * and Ampere; nvidia-drm-connector.c)
+     */
+    nv_dev->nv_connector_hdmi_vrr_off_property =
+        drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_VRR_OFF");
+    if (nv_dev->nv_connector_hdmi_vrr_off_property == NULL) {
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index f030b4e..5b72522 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -209,6 +209,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdmi_dv_low_latency_property;
     /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
     struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
+    /* Hades: NV_HDMI_VRR_OFF */
+    struct drm_property *nv_connector_hdmi_vrr_off_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 8ddc62d..402c60d 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -126,9 +126,17 @@ static inline NvBool nvHadesIsHdr10PlusVsif(const NvU8 *payload, NvU32 size)
  *    carries the Adaptive-Sync SDP), SHARED_GENERIC4 of the HALs with generic
  *    shared InfoFrames (the first three carry the HDR, VSC and Adaptive-Sync
  *    SDPs). Turing and Ampere have two generic SDPs, both in use (VSC, HDR).
+ *  - HDMI_VRR_OFF, with the HDMI route: the generic InfoFrame slot is the only
+ *    one the HDR10+ InfoFrame has, and the EMP of HDMI VRR takes it in the
+ *    mode sets where HDMI VRR is on (Turing and Ampere: no shared generic
+ *    slot; AD10x has shared generic slot 2 for it, the HALs with generic
+ *    shared InfoFrames slot 9). A client may then leave HDMI VRR off in a mode
+ *    set so that HDR10+ goes out in it (NV_HDMI_VRR_OFF of nvidia-drm,
+ *    nvHadesHdmiVrrLeftOff()).
  */
-#define NV_HADES_HDR10PLUS_ROUTE_HDMI 0x1
-#define NV_HADES_HDR10PLUS_ROUTE_DP   0x2
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI         0x1
+#define NV_HADES_HDR10PLUS_ROUTE_DP           0x2
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF 0x4
 
 static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
                                            NvBool dpConnector,
@@ -142,6 +150,9 @@ static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
     if ((hdmiConnector || (dpConnector && tmdsSignal)) &&
         (genericSharedInfoFrames || !acrWorkaround)) {
         routes |= NV_HADES_HDR10PLUS_ROUTE_HDMI;
+        if (!genericSharedInfoFrames && !adaSharedGenerics) {
+            routes |= NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF;
+        }
     }
     if (dpConnector && !tmdsSignal &&
         (genericSharedInfoFrames || adaSharedGenerics)) {
@@ -249,6 +260,26 @@ static inline NvBool nvHadesHdr10PlusAllowed(NvU32 routes,
                                    hdmiVrrEmp) == NV_HADES_HDR10PLUS_ALLOWED;
 }
 
+/*
+ * Whether a mode set leaves HDMI VRR off where it would have been on: the
+ * client allows G-SYNC but not Adaptive-Sync (allowAdaptiveSync DISABLED and
+ * allowGsync: KAPI with NV_HDMI_VRR_OFF; the console of NVKMS allows
+ * neither), to an HDMI display (not through the DisplayPort library) whose
+ * mode would have had Adaptive-Sync timings with Adaptive-Sync allowed
+ * (wouldBeAdaptiveSync: nvGetAllowedDpyVrrType() with
+ * NVKMS_ALLOW_ADAPTIVE_SYNC_ALL, which needs 50 Hz and 720 lines and a
+ * display that declares HDMI VRR). The mode set then sends no EMP of HDMI
+ * VRR, so the generic InfoFrame slot is free for HDR10+
+ * (nvHadesHdr10PlusHdmiSlot()); the kernel log says so.
+ */
+static inline NvBool nvHadesHdmiVrrLeftOff(NvBool adaptiveSyncDisabled,
+                                           NvBool allowGsync,
+                                           NvBool hdmiDpy,
+                                           NvBool wouldBeAdaptiveSync)
+{
+    return adaptiveSyncDisabled && allowGsync && hdmiDpy && wouldBeAdaptiveSync;
+}
+
 /* What the kernel log says of a refusal (nvHadesHdr10PlusRefusal()) */
 static inline const char *nvHadesHdr10PlusRefusalText(NvU32 refusal)
 {
@@ -260,7 +291,7 @@ static inline const char *nvHadesHdr10PlusRefusalText(NvU32 refusal)
     case NV_HADES_HDR10PLUS_NO_DP:
         return "no DisplayPort route on this GPU (both of its generic SDPs are in use)";
     case NV_HADES_HDR10PLUS_HDMI_VRR:
-        return "HDMI VRR sends its EMP in the generic InfoFrame slot, the only one this GPU has for it";
+        return "HDMI VRR sends its EMP in the generic InfoFrame slot, the only one this GPU has for it (NV_HDMI_VRR_OFF leaves HDMI VRR off in a mode set)";
     case NV_HADES_HDR10PLUS_3D_GENERIC:
         return "the 3D vendor InfoFrame of the frame-packed mode goes in the generic InfoFrame slot, the only one this GPU has for it";
     case NV_HADES_HDR10PLUS_3D_NO_HDR:
diff --git a/src/nvidia-modeset/include/nvkms-modeset-types.h b/src/nvidia-modeset/include/nvkms-modeset-types.h
index 071764c..be2071d 100644
--- a/src/nvidia-modeset/include/nvkms-modeset-types.h
+++ b/src/nvidia-modeset/include/nvkms-modeset-types.h
@@ -50,6 +50,8 @@ typedef struct {
     NvBool hs10bpcHint              : 1;
     NvBool hdmiVsifMetadataEnabled  : 1;
     NvBool changed                  : 1;
+    /* Hades: HDMI VRR left off where it would have been on (nvHadesHdmiVrrLeftOff()) */
+    NvBool hadesHdmiVrrLeftOff      : 1;
 } NVProposedModeSetStateOneApiHead;
 
 typedef struct {
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index ba7e4dc..301cb98 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -451,8 +451,20 @@ struct NvKmsKapiHeadModeSetConfig {
      * connector property.
      */
     NvU32 colorBpc;
+
+    /*
+     * Hades: HDMI VRR left off in the mode set of this head (allowAdaptiveSync
+     * NVKMS_ALLOW_ADAPTIVE_SYNC_DISABLED; NVKMS_ALLOW_ADAPTIVE_SYNC_ALL
+     * without it), so that no EMP of HDMI VRR takes the generic InfoFrame slot
+     * that HDR10+ needs on Turing and Ampere. nvidia-drm sets it from
+     * NV_HDMI_VRR_OFF, whose change needs a mode set.
+     */
+    NvBool hadesHdmiVrrOff;
 };
 
+/* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+
 struct NvKmsKapiHeadRequestedConfig {
     struct NvKmsKapiHeadModeSetConfig modeSetConfig;
     struct {
@@ -1729,7 +1741,9 @@ struct NvKmsKapiFunctionsTable {
     /*!
      * Hades: where an HDR10+ vendor InfoFrame can go out through the connector
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
-     * DisplayPort, 0 nowhere.
+     * DisplayPort, 0 nowhere; with 0x4 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF)
+     * HDR10+ over HDMI needs HDMI VRR off where it would be on (hadesHdmiVrrOff
+     * of a mode set).
      *
      * \return NV_TRUE on success, NV_FALSE on failure.
      */
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index b516db6..7acd8d6 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -30,6 +30,7 @@
 #include "nvkms-sync.h"
 #include "nvkms-rmapi.h"
 #include "nvkms-vrr.h"
+#include "nvkms-hades.h" /* Hades: NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF */
 
 #include "nvkms-softfloat.h"
 #include "nv-float.h"
@@ -1541,7 +1542,9 @@ static NvBool GetHdr10PlusRoutes(
         return NV_FALSE;
     }
 
