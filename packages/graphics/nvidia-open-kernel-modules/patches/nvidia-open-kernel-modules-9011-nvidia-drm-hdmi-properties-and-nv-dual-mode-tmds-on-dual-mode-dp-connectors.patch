From 3b879f190b2d1a2cb9ac86ffdc32a7e293a71904 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:10:05 +0000
Subject: [PATCH] nvidia-drm: HDMI properties and NV_DUAL_MODE_TMDS on
 dual-mode DP connectors

nvidia-drm names a connector after the type of its port, and gives the
properties that a client needs for an HDMI output (NV_HDMI_VSIF_METADATA,
and "max bpc" of nvidia-open-kernel-modules-9000) to HDMI connectors only.
On a DisplayPort connector that also has a TMDS output of the GPU (a
dual-mode port, the HDMI port of some laptops) a client cannot send the
vendor InfoFrame or fix the depth, although NVKMS drives the display there
as HDMI; and it cannot tell whether the display is driven through that TMDS
output or through the DisplayPort one.

When the encoder of a TMDS output is added to a DisplayPort connector (the
static displays are added before the device is registered), give the
connector NV_HDMI_VSIF_METADATA, "max bpc" and NV_DUAL_MODE_TMDS, a
read-only property that detection sets to 1 while the display is driven
through the TMDS output and to 0 otherwise (the DisplayPort output, or no
display). A client takes the HDMI properties of such a connector only with
NV_DUAL_MODE_TMDS at 1; NVKMS itself refuses the vendor InfoFrame on the
DisplayPort output (nvidia-open-kernel-modules-9010).

Connectors without a TMDS output, and HDMI connectors, are not changed.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 80 +++++++++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-connector.h | 24 ++++++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 12 +++
 kernel-open/nvidia-drm/nvidia-drm-encoder.c   |  9 +++
 kernel-open/nvidia-drm/nvidia-drm-encoder.h   |  6 ++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  1 +
 6 files changed, 132 insertions(+)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 2548cb3..02a047a 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -204,6 +204,7 @@ static enum drm_connector_status __nv_drm_connector_detect_internal(
     struct drm_connector *connector)
 {
     struct drm_device *dev = connector->dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
     struct nv_drm_connector *nv_connector = to_nv_connector(connector);
 
     enum drm_connector_status status = connector_status_disconnected;
@@ -271,6 +272,18 @@ done:
         nv_connector->frame_packing_advertised = false;
     }
 
+    /* Hades: which output of a dual-mode connector drives its display now */
+    if (nv_connector->dual_mode_tmds) {
+        drm_object_property_set_value(
+            &connector->base,
+            nv_dev->nv_connector_dual_mode_tmds_property,
+            nv_drm_dual_mode_tmds_value(
+                status == connector_status_connected,
+                nv_detected_encoder != NULL &&
+                nv_detected_encoder->signal_format ==
+                    NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS));
+    }
+
     return status;
 }
 
@@ -1035,6 +1048,73 @@ done:
     return connector;
 }
 
+/*
+ * Hades: a DisplayPort connector with a TMDS output of the GPU as well (the
+ * display table of the board has both for it: a dual-mode port, wired to an
+ * HDMI port of the board through a level shifter on some laptops, or a
+ * DisplayPort port that takes a passive HDMI adapter). While its display is
+ * driven through that TMDS output, NVKMS drives it as HDMI (InfoFrames, audio,
+ * deep colour), but the connector keeps the type of the port, and with it only
+ * the properties of a DisplayPort connector. Give it the HDMI properties of
+ * this driver that a client needs for that output: "max bpc" and
+ * NV_HDMI_VSIF_METADATA (NVKMS takes the vendor InfoFrame only while the TMDS
+ * output drives an HDMI sink), and NV_DUAL_MODE_TMDS, read-only, which says
+ * whether it does now. Only while the device is not registered yet: the
+ * encoders of the static displays are added before, and properties cannot be
+ * attached to a registered connector.
+ */
+void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
+{
+    struct drm_device *dev = nv_connector->base.dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+
+    if (nv_connector->type != NVKMS_CONNECTOR_TYPE_DP ||
+        nv_connector->dual_mode_tmds) {
+        return;
+    }
+
+    if (dev->registered ||
+        nv_dev->nv_connector_dual_mode_tmds_property == NULL ||
+        nv_dev->nv_connector_max_bpc_property == NULL) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Connector at physical index %u has a TMDS output, which is not offered as HDMI",
+            nv_connector->physicalIndex);
+        return;
+    }
+
+#if defined(NV_DRM_CONNECTOR_ATTACH_HDR_OUTPUT_METADATA_PROPERTY_PRESENT)
+    if (nv_dev->nv_connector_hdmi_vsif_metadata_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdmi_vsif_metadata_property,
+                                   0);
+    }
+#endif
+
+    if (nv_connector->base.max_bpc_property == NULL) {
+        nv_connector->base.max_bpc_property =
+            nv_dev->nv_connector_max_bpc_property;
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_max_bpc_property,
+                                   NV_DRM_MAX_BPC_DEFAULT);
+        if (nv_connector->base.state) {
+            nv_connector->base.state->max_requested_bpc = NV_DRM_MAX_BPC_DEFAULT;
+            nv_connector->base.state->max_bpc = NV_DRM_MAX_BPC_DEFAULT;
+        }
+    }
+
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_dual_mode_tmds_property,
+                               0);
+
+    nv_connector->dual_mode_tmds = true;
+
+    NV_DRM_DEV_LOG_INFO(
+        nv_dev,
+        "Connector at physical index %u is a dual-mode DisplayPort connector: its TMDS output is offered as HDMI",
+        nv_connector->physicalIndex);
+}
+
 /*
  * Revoke the permissions on this connector.
  */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index fd03a55..c2b9b4f 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -57,6 +57,15 @@ struct nv_drm_connector {
      */
     bool frame_packing_advertised;
 
+    /**
+     * @dual_mode_tmds:
+     *
+     * Hades: a DisplayPort connector that also has a TMDS output of the GPU
+     * (a dual-mode port), which got the HDMI properties and
+     * NV_DUAL_MODE_TMDS (nv_drm_connector_add_dual_mode_tmds()).
+     */
+    bool dual_mode_tmds;
+
     enum NvKmsContentProtection cp;
 
     atomic_t connection_status_dirty;
@@ -90,6 +99,21 @@ static inline struct nv_drm_connector *to_nv_connector(
 /* Initial value of the "max bpc" property: let the driver choose. */
 #define NV_DRM_MAX_BPC_DEFAULT 12
 
+/*
+ * Hades: the value of NV_DUAL_MODE_TMDS of a dual-mode DisplayPort connector:
+ * 1 while its display is driven through the TMDS output of the GPU (the GPU
+ * sends HDMI itself, through the level shifter of the port or a passive
+ * adapter), 0 otherwise: through its DisplayPort output (a DisplayPort display,
+ * or an active converter), or no display.
+ */
+static inline NvU64 nv_drm_dual_mode_tmds_value(bool connected,
+                                                bool tmds_encoder)
+{
+    return (connected && tmds_encoder) ? 1 : 0;
+}
+
+void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector);
+
 struct nv_drm_connector_state {
        struct drm_connector_state base;
        enum nv_drm_dithering_mode dithering_mode;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index f5fb3b0..b615c2e 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -685,6 +685,18 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, on dual-mode DisplayPort connectors: 1 while the
+     * display is driven through the TMDS output of the GPU (HDMI).
+     */
+    nv_dev->nv_connector_dual_mode_tmds_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_DUAL_MODE_TMDS", 0, 1);
+    if (nv_dev->nv_connector_dual_mode_tmds_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create NV_DUAL_MODE_TMDS property");
+        return -ENOMEM;
+    }
+
     // Color Pipeline Passthrough Properties
     nv_dev->nv_plane_color_passthrough_property =
         drm_property_create_bool(nv_dev->dev, 0,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-encoder.c b/kernel-open/nvidia-drm/nvidia-drm-encoder.c
index a4fc883..32e8edc 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-encoder.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-encoder.c
@@ -134,6 +134,7 @@ nv_drm_encoder_new(struct drm_device *dev,
     }
 
     nv_encoder->hDisplay = hDisplay;
+    nv_encoder->signal_format = format;
 
     /* Initialize the base encoder object and add it to the drm subsystem */
 
@@ -240,6 +241,14 @@ nv_drm_add_encoder(struct drm_device *dev, NvKmsKapiDisplay hDisplay)
 
     nv_encoder->nv_connector = to_nv_connector(connector);
 
+    /*
+     * Hades: a TMDS output of the GPU on a DisplayPort connector makes it a
+     * dual-mode one (nv_drm_connector_add_dual_mode_tmds()).
+     */
+    if (connectorInfo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS) {
+        nv_drm_connector_add_dual_mode_tmds(nv_encoder->nv_connector);
+    }
+
     nv_drm_connector_mark_connection_status_dirty(nv_encoder->nv_connector);
 
     mutex_unlock(&dev->mode_config.mutex);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-encoder.h b/kernel-open/nvidia-drm/nvidia-drm-encoder.h
index c572a11..c0fe6d3 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-encoder.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-encoder.h
@@ -36,6 +36,12 @@
 struct nv_drm_encoder {
     NvKmsKapiDisplay hDisplay;
 
+    /*
+     * Hades: the signal format of the output of the GPU that drives this
+     * encoder's display (TMDS or DisplayPort on a dual-mode connector).
+     */
+    NvKmsConnectorSignalFormat signal_format;
+
     struct nv_drm_connector *nv_connector;
 
     struct drm_encoder base;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 3433f74..23041ce 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -199,6 +199,7 @@ struct nv_drm_device {
 
     struct drm_property *nv_connector_dithering_mode_property;
     struct drm_property *nv_connector_max_bpc_property;
+    struct drm_property *nv_connector_dual_mode_tmds_property;
 
     struct drm_property *nv_connector_hdmi_vsif_metadata_property;
 
