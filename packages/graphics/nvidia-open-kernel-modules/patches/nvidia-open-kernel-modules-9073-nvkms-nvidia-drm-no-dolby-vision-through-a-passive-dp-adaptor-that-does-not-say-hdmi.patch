+                nv_drm_dual_mode_adaptor_value(tmds, said, adaptor));
+        }
     }
 
     return status;
@@ -1936,6 +1955,13 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
                                nv_dev->nv_connector_dual_mode_tmds_property,
                                0);
 
+    /* Hades: the passive adaptor behind the TMDS output (NV_DUAL_MODE_ADAPTOR) */
+    if (nv_dev->nv_connector_dual_mode_adaptor_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_dual_mode_adaptor_property,
+                                   0);
+    }
+
     nv_connector->dual_mode_tmds = true;
 
     /*
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index d4fd9de..b5e34e4 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -161,6 +161,23 @@ static inline bool nv_drm_connector_takes_frame_packing(
     return (hdmi_connector || dual_mode_tmds) && frame_packing_advertised;
 }
 
+
+/*
+ * Hades: the value of NV_DUAL_MODE_ADAPTOR of a dual-mode DisplayPort
+ * connector: while its display is driven through the TMDS output (tmds), the
+ * adaptor that NVKMS reported (said; NV_HADES_DUAL_MODE_ADAPTOR_* of
+ * nvkms-hades.h: 0 none, 1 and 2 an HDMI adaptor of type 1 and 2, 3 one that
+ * does not identify itself as an HDMI one), or 255 where NVKMS did not say or
+ * gave a value that does not fit; 0 otherwise.
+ */
+static inline NvU64 nv_drm_dual_mode_adaptor_value(bool tmds, bool said,
+                                                   NvU32 adaptor)
+{
+    if (!tmds) {
+        return 0;
+    }
+    return (said && (adaptor < 255)) ? adaptor : 255;
+}
 void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector);
 void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
                                     NvU32 routes);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index b1c2bad..f9ab0e0 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -750,6 +750,25 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, on dual-mode DisplayPort connectors, set where
+     * NV_DUAL_MODE_TMDS is. While the display is driven through the TMDS
+     * output, the passive DisplayPort dual-mode adaptor that NVKMS has from RM
+     * (NV_KMS_DPY_ATTRIBUTE_HADES_DUAL_MODE_ADAPTOR): 0 none reported (the
+     * HDMI port of the board, as on some laptops), 1 an HDMI adaptor of type
+     * 1, 2 one of type 2, 3 one that does not identify itself as an HDMI one,
+     * through which NVKMS refuses Dolby Vision; 255 where NVKMS did not say.
+     * 0 while the display is driven through the DisplayPort output, or there
+     * is none.
+     */
+    nv_dev->nv_connector_dual_mode_adaptor_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_DUAL_MODE_ADAPTOR", 0, 255);
+    if (nv_dev->nv_connector_dual_mode_adaptor_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create NV_DUAL_MODE_ADAPTOR property");
+        return -ENOMEM;
+    }
+
     /*
      * Hades: read-only, on every connector: the bits per component at which
      * NVKMS drives its display, as of the last mode set committed through
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
