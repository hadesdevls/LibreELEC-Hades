--- a/src/nvidia-modeset/src/nvkms-attributes.c
+++ b/src/nvidia-modeset/src/nvkms-attributes.c
@@ -1246,6 +1246,13 @@ static NvBool GetHadesOutputLink(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
     return TRUE;
 }
 
+/* Hades: NV_KMS_DPY_ATTRIBUTE_HADES_DUAL_MODE_ADAPTOR (nvkms-api.h) */
+static NvBool GetHadesDualModeAdaptor(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
+{
+    *pValue = pDpyEvo->hadesDualModeAdaptor;
+    return TRUE;
+}
+
 static const struct {
     NvBool (*set)(NVDpyEvoPtr pDpyEvo, NvS64 value);
     NvBool (*get)(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue);
@@ -1458,6 +1465,12 @@ static const struct {
         .getValidValues = NULL,
         .type           = NV_KMS_ATTRIBUTE_TYPE_INTEGER,
     },
+    [NV_KMS_DPY_ATTRIBUTE_HADES_DUAL_MODE_ADAPTOR] = {
+        .set            = NULL,
+        .get            = GetHadesDualModeAdaptor,
+        .getValidValues = NULL,
+        .type           = NV_KMS_ATTRIBUTE_TYPE_INTEGER,
+    },
 };
 
 /*!
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 19c2f68..e159f64 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -885,6 +885,67 @@ DpyGetPassiveDpDongleType(const NVDpyEvoRec *pDpyEvo,
     return passiveDpDongleType;
 }
 
+/*
+ * Hades: the passive DisplayPort dual-mode adaptor that RM reported
+ * (DpyGetPassiveDpDongleType()), as NV_HADES_DUAL_MODE_ADAPTOR_*
+ * (nvkms-hades.h). A DMS-59 breakout, which NVKMS takes as a native
+ * connection, is none here as there.
+ */
+static NvU8 HadesDualModeAdaptorOf(NVEvoPassiveDpDongleType type)
+{
+    switch (type) {
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2DVI:
+        return NV_HADES_DUAL_MODE_ADAPTOR_DVI;
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2HDMI_TYPE_1:
+        return NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE1;
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2HDMI_TYPE_2:
+        return NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE2;
+    case NV_EVO_PASSIVE_DP_DONGLE_UNUSED:
+    default:
+        return NV_HADES_DUAL_MODE_ADAPTOR_NONE;
+    }
+}
