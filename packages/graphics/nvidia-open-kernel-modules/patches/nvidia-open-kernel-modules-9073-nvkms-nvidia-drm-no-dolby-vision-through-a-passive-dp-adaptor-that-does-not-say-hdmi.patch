+/*
+ * Hades: no Dolby Vision through the TMDS output of a DisplayPort connector
+ * behind a passive dual-mode adaptor that does not identify itself as an HDMI
+ * one (nvHadesDolbyRefusedByAdaptor(); the adaptor that RM reported with the
+ * maximum pixel clock of the connector's display, nvkms-dpy.c). A flip or a
+ * mode set that asks for it is refused, and the kernel log says why once for
+ * each GPU and head until none is refused. Any other vendor InfoFrame, and
+ * Dolby Vision through an HDMI adaptor or where none is reported, are as
+ * before.
+ */
+static NvBool HadesDolbyAdaptorAllowed(const NvU32 head,
+                                       const NVConnectorEvoRec *pConnectorEvo,
+                                       const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    const NvBool dolby = (pVsif->payloadSize != 0) &&
+        nvHadesIsDolbyVisionVsif(pVsif->payload, pVsif->payloadSize);
+    const NvBool dpTmds = (pConnectorEvo != NULL) &&
+        (pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP) &&
+        (pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS) &&
+        !nvConnectorUsesDPLib(pConnectorEvo);
+    const NVDpyEvoRec *pDpyEvo = (dolby && dpTmds) ?
+        nvGetDpyEvoFromDispEvo(pConnectorEvo->pDispEvo, pConnectorEvo->displayId) :
+        NULL;
+    const NvU32 adaptor = (pDpyEvo != NULL) ?
+        pDpyEvo->hadesDualModeAdaptor : NV_HADES_DUAL_MODE_ADAPTOR_NONE;
+    const NvBool refused = nvHadesDolbyRefusedByAdaptor(dolby, dpTmds, adaptor);
+
+    if ((pConnectorEvo != NULL) && (head < NV_MAX_HEADS) &&
+        (pConnectorEvo->pDispEvo->displayOwner < NVKMS_MAX_SUBDEVICES)) {
+        NvU8 *pLogged = &pConnectorEvo->pDispEvo->pDevEvo->
+            hadesDolbyAdaptorLogged[pConnectorEvo->pDispEvo->displayOwner][head];
+
+        if (refused && (*pLogged == 0) && (pDpyEvo != NULL)) {
+            nvEvoLogDisp(pConnectorEvo->pDispEvo, EVO_LOG_INFO,
+                         "Hades: Dolby Vision on head %u refused: the display is behind %s (NV_DUAL_MODE_ADAPTOR %u, up to %u kHz); NVIDIA's driver interface says that no HDMI should go through such an adaptor, and only one that identifies itself as an HDMI one carries the tunnel",
+                         head, nvHadesDualModeAdaptorText(adaptor), adaptor,
+                         pDpyEvo->hadesDualModeAdaptorKHz);
+        }
+        *pLogged = refused ? 1 : 0;
+    }
+
+    return !refused;
+}
