+/*
+ * Hades: an HDR10+ vendor InfoFrame goes next to the HDR InfoFrame, through
+ * the route of the signal of the connector, in a slot that the EMP of HDMI
+ * VRR does not hold (nvHadesHdr10PlusRefusal()). A refusal says why in the
+ * kernel log, once for each GPU, head and reason in a row.
+ */
+static NvBool HadesHdr10PlusAllowed(const NVDevEvoRec *pDevEvo,
+                                    const NvU32 head,
+                                    const NVHwModeTimingsEvo *pTimings,
+                                    const NVConnectorEvoRec *pConnectorEvo)
+{
+    NvU32 refusal;
+
+    if (pConnectorEvo == NULL) {
+        return FALSE;
+    }
+
+    refusal = nvHadesHdr10PlusRefusal(
+        nvHadesConnectorHdr10PlusRoutes(pConnectorEvo),
+        HdmiVsifConnector(pConnectorEvo),
+        nvConnectorUsesDPLib(pConnectorEvo),
+        pDevEvo->caps.supportsGenericSharedInfoFrames,
+        pDevEvo->dispClass == NVC770_DISPLAY,
+        (pTimings != NULL) && !nvConnectorUsesDPLib(pConnectorEvo) &&
+            nvIsAdaptiveSyncDpyVrrType(pTimings->vrr.type));
+
+    if ((head < NV_MAX_HEADS) &&
+        (pConnectorEvo->pDispEvo->displayOwner < NVKMS_MAX_SUBDEVICES)) {
+        NvU8 *pLogged = &pConnectorEvo->pDispEvo->pDevEvo->
+            hadesHdr10PlusRefusalLogged[pConnectorEvo->pDispEvo->displayOwner][head];
+
+        if ((refusal != NV_HADES_HDR10PLUS_ALLOWED) && (*pLogged != refusal)) {
+            nvEvoLogDisp(pConnectorEvo->pDispEvo, EVO_LOG_INFO,
+                         "Hades: HDR10+ refused on head %u: %s",
+                         head, nvHadesHdr10PlusRefusalText(refusal));
+        }
+        *pLogged = (NvU8)refusal;
+    }
+
+    return refusal == NV_HADES_HDR10PLUS_ALLOWED;
