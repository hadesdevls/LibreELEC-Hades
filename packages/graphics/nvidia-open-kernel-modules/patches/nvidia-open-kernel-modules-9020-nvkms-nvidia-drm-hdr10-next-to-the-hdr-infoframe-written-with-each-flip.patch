+     */
+    nv_dev->nv_connector_hdr10plus_vsif_property =
+        drm_property_create(nv_dev->dev, DRM_MODE_PROP_BLOB,
+            "HDR10PLUS_VSIF", 0);
+    if (nv_dev->nv_connector_hdr10plus_vsif_property == NULL) {
