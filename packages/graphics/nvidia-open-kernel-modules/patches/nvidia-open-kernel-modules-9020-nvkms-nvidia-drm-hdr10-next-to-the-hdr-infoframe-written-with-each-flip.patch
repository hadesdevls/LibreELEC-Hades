+/*
+ * Hades: where an HDR10+ InfoFrame can go out through this connector
+ * (nvHadesHdr10PlusRoutes()).
+ */
+NvU32 nvHadesConnectorHdr10PlusRoutes(const NVConnectorEvoRec *pConnectorEvo)
+{
+    const NVDevEvoRec *pDevEvo = pConnectorEvo->pDispEvo->pDevEvo;
+
+    return nvHadesHdr10PlusRoutes(
+        pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_HDMI,
+        pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP,
+        pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS,
+        pDevEvo->caps.supportsGenericSharedInfoFrames,
+        pDevEvo->dispClass == NVC770_DISPLAY,
+        NV0073_CTRL_SYSTEM_GET_CAP(pDevEvo->commonCapsBits,
+            NV0073_CTRL_SYSTEM_CAPS_HDMI21_SW_ACR_BUG_3275257) != 0);
+}
+
+/*
+ * Hades: the client's vendor InfoFrame is an HDR10+ one, and goes out in a
+ * slot of its own, apart from the vendor-specific one, through which the HAL
+ * sends the HDR InfoFrame (nvHadesHdr10PlusHdmiSlot()). The flip that carried
+ * it was validated for it (nvHadesHdr10PlusAllowed()).
+ */
+NvBool nvHadesHdr10PlusInOwnSlot(const NVDevEvoRec *pDevEvo,
+                                 const NVDispHeadStateEvoRec *pHeadState)
+{
+    return !pDevEvo->caps.supportsGenericSharedInfoFrames &&
+           nvHadesIsHdr10PlusVsif(pHeadState->hdmiVsifMetadata.payload,
+                                  pHeadState->hdmiVsifMetadata.payloadSize);
+}
+
+/*
+ * Hades: the EMP of HDMI VRR holds the generic InfoFrame slot of the head:
+ * Adaptive-Sync timings on a connector that does not use the DisplayPort
+ * library (nvEnableVrr()).
+ */
+NvBool nvHadesHdmiVrrEmp(const NVDispHeadStateEvoRec *pHeadState)
+{
+    return (pHeadState->pConnectorEvo != NULL) &&
+           !nvConnectorUsesDPLib(pHeadState->pConnectorEvo) &&
+           nvIsAdaptiveSyncDpyVrrType(pHeadState->timings.vrr.type);
+}
+
+/* Hades: the NVHDMIPKT_TYPE of an HDR10+ slot (NV_HADES_HDR10PLUS_SLOT_*) */
+static NVHDMIPKT_TYPE HadesHdr10PlusPacketType(NvU32 slot)
+{
+    switch (slot) {
+    case NV_HADES_HDR10PLUS_SLOT_GENERIC:
+        return NVHDMIPKT_TYPE_GENERIC;
+    case NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2:
+        return NVHDMIPKT_TYPE_SHARED_GENERIC2;
+    case NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC4:
+        return NVHDMIPKT_TYPE_SHARED_GENERIC4;
+    default:
+        return NVHDMIPKT_TYPE_UNDEFINED;
+    }
+}
+
+/*
+ * Hades: from here the HDR10+ InfoFrame of the head goes out in slot
+ * (NV_HADES_HDR10PLUS_SLOT_NONE: in none), written there already: the slot it
+ * went out in before is turned off (nvHadesHdr10PlusSlotToTurnOff()), and slot
+ * is kept. True when slot is not the one before.
+ */
+NvBool nvHadesHdr10PlusSetSlot(const NVDispEvoRec *pDispEvo,
+                               const NvU32 head,
+                               NvU32 slot)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    NvU8 *pSlot = &pDevEvo->hadesHdr10PlusSlot[pDispEvo->displayOwner][head];
+    const NvU32 off = nvHadesHdr10PlusSlotToTurnOff(*pSlot, slot,
+                                                    nvHadesHdmiVrrEmp(pHeadState));
+    const NvBool changed = (*pSlot != slot);
+
+    if (off != NV_HADES_HDR10PLUS_SLOT_NONE) {
+        const NVHDMIPKT_RESULT ret =
+            NvHdmiPkt_PacketCtrl(pDevEvo->hdmiLib.handle,
+                                 pDispEvo->displayOwner,
+                                 pHeadState->activeRmId,
+                                 head,
+                                 HadesHdr10PlusPacketType(off),
+                                 NVHDMIPKT_TRANSMIT_CONTROL_DISABLE);
+        if (ret != NVHDMIPKT_SUCCESS) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: the HDR10+ InfoFrame of head %u could not be turned off",
+                         head);
+        }
+    }
+    *pSlot = (NvU8)slot;
+    return changed;
+}
+
+/*
+ * Hades: write the HDR10+ InfoFrame of the head into its slot of HDMI
+ * (nvHadesHdr10PlusHdmiSlot()), every frame, or turn off the slot NVKMS turned
+ * on for it. Only that slot: the AVI, vendor-specific and HDR InfoFrames, and
+ * the EMP of HDMI VRR, are left as they are.
+ */
+static void HadesSendHdr10PlusHdmi(const NVDispEvoRec *pDispEvo,
+                                   const NvU32 head,
+                                   NvBool send)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const NvU32 slot = send ?
+        nvHadesHdr10PlusHdmiSlot(pDevEvo->caps.supportsGenericSharedInfoFrames,
+                                 pDevEvo->dispClass == NVC770_DISPLAY,
+                                 nvHadesHdmiVrrEmp(pHeadState)) :
+        NV_HADES_HDR10PLUS_SLOT_NONE;
+    NvU8 packet[NV_HADES_HDR10PLUS_DP_SLOT_SIZE];
+    NvU32 packetSize;
+    NVHDMIPKT_TC tc;
+    NVHDMIPKT_RESULT ret;
+
+    if ((slot != NV_HADES_HDR10PLUS_SLOT_GENERIC) &&
+        (slot != NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2)) {
+        if (send) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: the HDR10+ InfoFrame of head %u has no slot: %s",
+                         head,
+                         nvHadesHdr10PlusRefusalText(NV_HADES_HDR10PLUS_HDMI_VRR));
+        }
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+
+    if (slot == NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2) {
+        packetSize =
+            nvHadesHdr10PlusHdmiSharedPacket(pHeadState->hdmiVsifMetadata.payload,
+                                             packet);
+        tc = NV_HADES_HDR10PLUS_HDMI_SHARED_TC;
+    } else {
+        nvHadesHdr10PlusHdmiPacket(pHeadState->hdmiVsifMetadata.payload, packet);
+        packetSize = NV_HADES_HDR10PLUS_HDMI_PACKET_SIZE;
+        tc = NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME;
+    }
+    ret = NvHdmiPkt_PacketWrite(pDevEvo->hdmiLib.handle,
+                                pDispEvo->displayOwner,
+                                pHeadState->activeRmId,
+                                head,
+                                HadesHdr10PlusPacketType(slot),
+                                tc,
+                                packetSize,
+                                packet);
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: the HDR10+ InfoFrame of head %u could not be written",
+                     head);
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+    if (nvHadesHdr10PlusSetSlot(pDispEvo, head, slot)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     (slot == NV_HADES_HDR10PLUS_SLOT_GENERIC) ?
+                     "Hades: HDR10+ InfoFrame on head %u, in the generic InfoFrame slot" :
+                     "Hades: HDR10+ InfoFrame on head %u, in shared generic slot 2 (HDMI VRR sends its EMP in the generic one)",
+                     head);
+    }
+}
