diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 309c16d..18e6417 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -94,4 +94,312 @@ static inline NvBool nvHadesHdrWants12Bpc(NvBool capable,
            (chosenBpc == 8);
 }
 
+/*
+ * HDR10+: the vendor-specific InfoFrame of HDR10+ Technologies (IEEE OUI
+ * 90-84-8B), whose 27 bytes of payload (PB1..PB27: the OUI, then 24 bytes) a
+ * client gives as HDMI VSIF metadata, through HDR10PLUS_VSIF of nvidia-drm. It
+ * goes out with every frame next to the HDR InfoFrame, and a flip changes it.
+ */
+#define NV_HADES_HDR10PLUS_PAYLOAD_SIZE 27
+#define NV_HADES_HDR10PLUS_HDMI_PACKET_SIZE (4 + NV_HADES_HDR10PLUS_PAYLOAD_SIZE)
+
+static inline NvBool nvHadesIsHdr10PlusVsif(const NvU8 *payload, NvU32 size)
+{
+    return (size == NV_HADES_HDR10PLUS_PAYLOAD_SIZE) && (payload != NULL) &&
+           (payload[0] == 0x8B) && (payload[1] == 0x84) && (payload[2] == 0x90);
+}
+
+/*
+ * Where an HDR10+ InfoFrame can go out (a mask, NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS):
+ *
+ *  - HDMI: on the HALs without generic shared InfoFrames (Turing, Ampere,
+ *    Ada) the HDR InfoFrame is sent through the vendor-specific slot of the
+ *    SOR, so the HDR10+ one goes through its generic InfoFrame slot, which
+ *    NVKMS uses only for the EMP of HDMI VRR (nvHadesHdr10PlusHdmiSlot()).
+ *    On GA10x RM keeps that slot for
+ *    its ACR workaround when it reports NV0073_CTRL_SYSTEM_CAPS_HDMI21_SW_ACR_BUG_3275257:
+ *    then there is no HDMI route. On the HALs with generic shared InfoFrames
+ *    (T239, Blackwell) the vendor-specific InfoFrame has its own slot.
+ *    Also the TMDS output of a dual-mode DisplayPort connector.
+ *  - DisplayPort: an InfoFrame SDP, in a shared generic slot that NVKMS does
+ *    not use on DisplayPort: SHARED_GENERIC2 of AD10x (NVC771; the first one
+ *    carries the Adaptive-Sync SDP), SHARED_GENERIC4 of the HALs with generic
+ *    shared InfoFrames (the first three carry the HDR, VSC and Adaptive-Sync
+ *    SDPs). Turing and Ampere have two generic SDPs, both in use (VSC, HDR).
+ */
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI 0x1
+#define NV_HADES_HDR10PLUS_ROUTE_DP   0x2
+
+static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
+                                           NvBool dpConnector,
+                                           NvBool tmdsSignal,
+                                           NvBool genericSharedInfoFrames,
+                                           NvBool adaSharedGenerics,
+                                           NvBool acrWorkaround)
+{
+    NvU32 routes = 0;
+
+    if ((hdmiConnector || (dpConnector && tmdsSignal)) &&
+        (genericSharedInfoFrames || !acrWorkaround)) {
+        routes |= NV_HADES_HDR10PLUS_ROUTE_HDMI;
+    }
+    if (dpConnector && !tmdsSignal &&
+        (genericSharedInfoFrames || adaSharedGenerics)) {
+        routes |= NV_HADES_HDR10PLUS_ROUTE_DP;
+    }
+    return routes;
+}
+
+/*
+ * The slots of an HDR10+ InfoFrame, and the one it takes on an HDMI signal:
+ *  - the HALs with generic shared InfoFrames (T239, Blackwell): the
+ *    vendor-specific slot, which is apart from the HDR one there;
+ *  - Turing, Ampere and Ada: the generic InfoFrame slot, unless the EMP of
+ *    HDMI VRR is in it. NVKMS turns HDMI VRR on in each mode set of a display
+ *    that declares it, from 50 Hz and 720 lines up (KAPI allows Adaptive-Sync
+ *    in all of them; nvGetAllowedDpyVrrType()), and from then sends the EMP
+ *    every frame (nvEnableVrr(), nvHdmiSetVRR()), whether flips use VRR or not;
+ *  - AD10x with that EMP: shared generic slot 2, the one of the HDR10+ SDP on
+ *    DisplayPort (a head carries one signal). Turing and Ampere have no other
+ *    slot: no HDR10+ over HDMI there while HDMI VRR is on.
+ * DisplayPort: shared generic slot 2 of AD10x, slot 4 with generic shared
+ * InfoFrames (nvHadesHdr10PlusRoutes()).
+ */
+#define NV_HADES_HDR10PLUS_SLOT_NONE            0
+#define NV_HADES_HDR10PLUS_SLOT_VSI             1
+#define NV_HADES_HDR10PLUS_SLOT_GENERIC         2
+#define NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2 3
+#define NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC4 4
+
+static inline NvU32 nvHadesHdr10PlusHdmiSlot(NvBool genericSharedInfoFrames,
+                                             NvBool adaSharedGenerics,
+                                             NvBool hdmiVrrEmp)
+{
+    if (genericSharedInfoFrames) {
+        return NV_HADES_HDR10PLUS_SLOT_VSI;
+    }
+    if (!hdmiVrrEmp) {
+        return NV_HADES_HDR10PLUS_SLOT_GENERIC;
+    }
+    if (adaSharedGenerics) {
+        return NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2;
+    }
+    return NV_HADES_HDR10PLUS_SLOT_NONE;
+}
+
+/*
+ * Why a flip may not carry an HDR10+ InfoFrame now (NV_HADES_HDR10PLUS_ALLOWED:
+ * it may), through the route of the signal that the connector carries (an
+ * HDMI sink: nvHadesVsifOnConnector(); the DisplayPort library), and on HDMI
+ * in a slot that the EMP of HDMI VRR does not hold.
+ */
+#define NV_HADES_HDR10PLUS_ALLOWED   0
+#define NV_HADES_HDR10PLUS_NO_SIGNAL 1
+#define NV_HADES_HDR10PLUS_NO_HDMI   2
+#define NV_HADES_HDR10PLUS_NO_DP     3
+#define NV_HADES_HDR10PLUS_HDMI_VRR  4
+
+static inline NvU32 nvHadesHdr10PlusRefusal(NvU32 routes,
+                                            NvBool hdmiSignal,
+                                            NvBool dpSignal,
+                                            NvBool genericSharedInfoFrames,
+                                            NvBool adaSharedGenerics,
+                                            NvBool hdmiVrrEmp)
+{
+    if (hdmiSignal) {
+        if ((routes & NV_HADES_HDR10PLUS_ROUTE_HDMI) == 0) {
+            return NV_HADES_HDR10PLUS_NO_HDMI;
+        }
+        if (nvHadesHdr10PlusHdmiSlot(genericSharedInfoFrames,
+                                     adaSharedGenerics,
+                                     hdmiVrrEmp) ==
+            NV_HADES_HDR10PLUS_SLOT_NONE) {
+            return NV_HADES_HDR10PLUS_HDMI_VRR;
+        }
+        return NV_HADES_HDR10PLUS_ALLOWED;
+    }
+    if (dpSignal) {
+        return ((routes & NV_HADES_HDR10PLUS_ROUTE_DP) != 0) ?
+            NV_HADES_HDR10PLUS_ALLOWED : NV_HADES_HDR10PLUS_NO_DP;
+    }
+    return NV_HADES_HDR10PLUS_NO_SIGNAL;
+}
+
+static inline NvBool nvHadesHdr10PlusAllowed(NvU32 routes,
+                                             NvBool hdmiSignal,
+                                             NvBool dpSignal,
+                                             NvBool genericSharedInfoFrames,
+                                             NvBool adaSharedGenerics,
+                                             NvBool hdmiVrrEmp)
+{
+    return nvHadesHdr10PlusRefusal(routes, hdmiSignal, dpSignal,
+                                   genericSharedInfoFrames,
+                                   adaSharedGenerics,
+                                   hdmiVrrEmp) == NV_HADES_HDR10PLUS_ALLOWED;
+}
+
+/* What the kernel log says of a refusal (nvHadesHdr10PlusRefusal()) */
+static inline const char *nvHadesHdr10PlusRefusalText(NvU32 refusal)
+{
+    switch (refusal) {
+    case NV_HADES_HDR10PLUS_NO_SIGNAL:
+        return "the connector carries neither an HDMI nor a DisplayPort signal";
+    case NV_HADES_HDR10PLUS_NO_HDMI:
+        return "no HDMI route on this GPU (RM keeps the generic InfoFrame slot for its ACR workaround)";
+    case NV_HADES_HDR10PLUS_NO_DP:
+        return "no DisplayPort route on this GPU (both of its generic SDPs are in use)";
+    case NV_HADES_HDR10PLUS_HDMI_VRR:
+        return "HDMI VRR sends its EMP in the generic InfoFrame slot, the only one this GPU has for it";
+    default:
+        return "";
+    }
+}
+
+/*
+ * The slot to turn off when the HDR10+ InfoFrame of a head goes out in slot
+ * to (NV_HADES_HDR10PLUS_SLOT_NONE: no more) after slot from: from, when it is
+ * another one, but not the generic slot while the EMP of HDMI VRR holds it:
+ * the EMP took that slot over, and turning it off would take the EMP away,
+ * and VRR with it.
+ */
+static inline NvU32 nvHadesHdr10PlusSlotToTurnOff(NvU32 from,
+                                                  NvU32 to,
+                                                  NvBool hdmiVrrEmp)
+{
+    if ((from == to) || (from == NV_HADES_HDR10PLUS_SLOT_NONE)) {
+        return NV_HADES_HDR10PLUS_SLOT_NONE;
+    }
+    if ((from == NV_HADES_HDR10PLUS_SLOT_GENERIC) && hdmiVrrEmp) {
+        return NV_HADES_HDR10PLUS_SLOT_NONE;
+    }
+    return from;
+}
+
+/*
+ * Whether a change of the client's vendor InfoFrame, from (fromSize bytes) to
+ * (toSize), each empty or not, is a change of HDR10+ metadata only: a flip
+ * then writes only the HDR10+ InfoFrame, and nvidia-drm asks no mode set for it.
+ */
+static inline NvBool nvHadesVsifChangeIsHdr10Plus(const NvU8 *from,
+                                                  NvU32 fromSize,
+                                                  const NvU8 *to,
+                                                  NvU32 toSize)
+{
+    return ((fromSize == 0) || nvHadesIsHdr10PlusVsif(from, fromSize)) &&
+           ((toSize == 0) || nvHadesIsHdr10PlusVsif(to, toSize));
+}
+
+/*
+ * The HDMI packet of an HDR10+ InfoFrame: type 0x81, version 1, length 27,
+ * the checksum, the payload.
+ */
+static inline void nvHadesHdr10PlusHdmiPacket(const NvU8 *payload, NvU8 *packet)
+{
+    NvU8 sum = 0;
+    NvU32 i;
+
+    packet[0] = 0x81;
+    packet[1] = 0x01;
+    packet[2] = NV_HADES_HDR10PLUS_PAYLOAD_SIZE;
+    packet[3] = 0;
+    for (i = 0; i < NV_HADES_HDR10PLUS_PAYLOAD_SIZE; i++) {
+        packet[4 + i] = payload[i];
+    }
+    for (i = 0; i < NV_HADES_HDR10PLUS_HDMI_PACKET_SIZE; i++) {
+        sum += packet[i];
+    }
+    packet[3] = (NvU8)(0x100 - sum);
+}
+
+/*
+ * The DisplayPort InfoFrame SDP of an HDR10+ InfoFrame, as NVKMS builds the
+ * one of the HDR InfoFrame (ConstructHdrInfoFrameSdp() of nvkms-dpy.c) and as
+ * i915 and amdgpu build theirs: an InfoFrame SDP of version 1.3, the one of the
+ * CTA-861 InfoFrames other than the audio one.
+ *  - HB0 0, the packet ID of a non-audio InfoFrame; HB1 0x80 plus the type of
+ *    the InfoFrame (0x81, vendor-specific); HB2 the number of data bytes less
+ *    one (30 - 1); HB3 the version of the SDP (0x13) in bits 7:2;
+ *  - DB0 the version of the InfoFrame (1), DB1 its length (27), DB2..DB28 its
+ *    payload (PB1..PB27), the other data bytes 0.
+ * An InfoFrame SDP carries no checksum of the InfoFrame: DB0 is its version.
+ * packet: the header and the 32 data bytes of a shared generic slot (36
+ * bytes). Returns the bytes in use.
+ */
+#define NV_HADES_HDR10PLUS_DP_SDP_HB1   0x81
+#define NV_HADES_HDR10PLUS_DP_SDP_HB2   (30 - 1)
+#define NV_HADES_HDR10PLUS_DP_SDP_HB3   (0x13 << 2)
+#define NV_HADES_HDR10PLUS_DP_SDP_SIZE  (4 + 2 + NV_HADES_HDR10PLUS_PAYLOAD_SIZE)
+#define NV_HADES_HDR10PLUS_DP_SLOT_SIZE 36
+
+static inline NvU32 nvHadesHdr10PlusDpSdp(const NvU8 *payload, NvU8 *packet)
+{
+    NvU32 i;
+
+    for (i = 0; i < NV_HADES_HDR10PLUS_DP_SLOT_SIZE; i++) {
+        packet[i] = 0;
+    }
+    packet[1] = NV_HADES_HDR10PLUS_DP_SDP_HB1;
+    packet[2] = NV_HADES_HDR10PLUS_DP_SDP_HB2;
+    packet[3] = NV_HADES_HDR10PLUS_DP_SDP_HB3;
+    packet[4] = 0x01;
+    packet[5] = NV_HADES_HDR10PLUS_PAYLOAD_SIZE;
+    for (i = 0; i < NV_HADES_HDR10PLUS_PAYLOAD_SIZE; i++) {
+        packet[6 + i] = payload[i];
+    }
+    return NV_HADES_HDR10PLUS_DP_SDP_SIZE;
+}
+
+/*
+ * How a shared generic slot of AD10x sends that SDP (an NVHDMIPKT_TC of
+ * nvhdmipkt.h): every frame, in the vertical blanking (LOC 0), and without the
+ * checksum of the hardware. That is the checksum of an HDMI InfoFrame, which a
+ * shared generic slot that holds one keeps in DB0, right after the header (PB0
+ * in ConstructAdvancedInfoFramePacket() of nvkms-evo3.c): where the hardware
+ * wrote it into an SDP, it would take the place of the version of the
+ * InfoFrame. Whether AD10x writes it on a DisplayPort SOR is not documented:
+ * NVKMS sends its Adaptive-Sync SDP there with it (SendAdaptiveSyncSdp() of
+ * nvkms-evo1.c), and its SDPs on the HALs with generic shared InfoFrames
+ * without it (nvEvoSendDpInfoFrameSdpC8()).
+ */
+#define NV_HADES_HDR10PLUS_DP_SDP_TC NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME_SW_CHECKSUM
+
+/*
+ * The HDMI packet of an HDR10+ InfoFrame in a shared generic slot (36 bytes),
+ * laid out as NVKMS lays out an HDMI InfoFrame in these slots on the HALs with
+ * generic shared InfoFrames (ConstructAdvancedInfoFramePacket() of
+ * nvkms-evo3.c): HB0..HB2 the type, version and length of
+ * nvHadesHdr10PlusHdmiPacket(), HB3 0, DB0 its checksum (PB0), DB1..DB27 its
+ * payload (PB1..PB27), the other data bytes 0. Returns the bytes in use.
+ */
+#define NV_HADES_HDR10PLUS_HDMI_SHARED_SIZE (4 + 1 + NV_HADES_HDR10PLUS_PAYLOAD_SIZE)
+
+static inline NvU32 nvHadesHdr10PlusHdmiSharedPacket(const NvU8 *payload,
+                                                     NvU8 *packet)
+{
+    NvU8 hdmi[NV_HADES_HDR10PLUS_HDMI_PACKET_SIZE];
+    NvU32 i;
+
+    nvHadesHdr10PlusHdmiPacket(payload, hdmi);
+    for (i = 0; i < NV_HADES_HDR10PLUS_DP_SLOT_SIZE; i++) {
+        packet[i] = 0;
+    }
+    packet[0] = hdmi[0];
+    packet[1] = hdmi[1];
+    packet[2] = hdmi[2];
+    for (i = 3; i < NV_HADES_HDR10PLUS_HDMI_PACKET_SIZE; i++) {
+        packet[1 + i] = hdmi[i];
+    }
+    return NV_HADES_HDR10PLUS_HDMI_SHARED_SIZE;
+}
+
+/*
+ * How a shared generic slot of AD10x sends that HDMI packet (an NVHDMIPKT_TC
+ * of nvhdmipkt.h): every frame, at the vertical sync, as NVKMS sends its HDMI
+ * InfoFrames through these slots on the HALs with generic shared InfoFrames
+ * (nvEvoSendHdmiInfoFrameC8()), with the checksum the packet carries.
+ */
+#define NV_HADES_HDR10PLUS_HDMI_SHARED_TC \
+    ((NVHDMIPKT_TC)(NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME_SW_CHECKSUM | \
+                    DRF_DEF(_HDMI_PKT, _TRANSMIT_CTRL, _LOC, _VSYNC)))
+
 #endif /* __NVKMS_HADES_H__ */
