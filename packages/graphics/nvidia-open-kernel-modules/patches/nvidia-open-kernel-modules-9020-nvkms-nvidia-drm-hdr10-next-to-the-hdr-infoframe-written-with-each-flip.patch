+/*
+ * Hades: a flip changed only the HDR10+ InfoFrame of the head of this dpy
+ * (nvHadesVsifChangeIsHdr10Plus()): write only it, not every InfoFrame as
+ * nvUpdateInfoFrames() does (that one also rewrites the AVI InfoFrame).
+ */
+void nvHadesUpdateHdr10Plus(NVDpyEvoRec *pDpyEvo)
+{
+    NVDispEvoRec *pDispEvo = pDpyEvo->pDispEvo;
+    NVDispApiHeadStateEvoRec *pApiHeadState;
+    NvEvoInfoFrameTransmitControl transmitCtrl = { };
+    NvU32 head;
+
+    if (pDpyEvo->apiHead == NV_INVALID_HEAD) {
+        return;
+    }
+    pApiHeadState = &pDispEvo->apiHeadState[pDpyEvo->apiHead];
+    head = nvGetPrimaryHwHead(pDispEvo, pDpyEvo->apiHead);
+    if (head == NV_INVALID_HEAD) {
+        return;
+    }
+
+    if (nvConnectorUsesDPLib(pDpyEvo->pConnectorEvo)) {
+        HadesUpdateDpHdr10Plus(pDispEvo, head);
+        return;
+    }
+
+    transmitCtrl.newFlipSynchronized = NV_FALSE;
+    transmitCtrl.newFid = pApiHeadState->coreFid;
+    nvHadesUpdateHdmiHdr10Plus(pDispEvo,
+                               head,
+                               &pApiHeadState->infoFrame,
+                               &pApiHeadState->infoFrame.flipState,
+                               &transmitCtrl,
+                               pDpyEvo);
+}
