diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index 977a8db..ba7e4dc 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -465,6 +465,8 @@ struct NvKmsKapiHeadRequestedConfig {
         NvBool olutFpNormScaleChanged          : 1;
         NvBool ditheringChanged                : 1;
         NvBool hdmiVsifMetadataChanged         : 1;
+        /* Hades: ... only as HDR10+ metadata: a flip carries it (HDR10PLUS_VSIF) */
+        NvBool hdmiVsifMetadataDynamic         : 1;
         NvBool postcompColorPassthroughChanged : 1;
         NvBool colorBpcChanged                 : 1;
     } flags;
@@ -1723,6 +1725,20 @@ struct NvKmsKapiFunctionsTable {
         NvKmsKapiDisplay display,
         NvU32 *bpc
     );
+
+    /*!
+     * Hades: where an HDR10+ vendor InfoFrame can go out through the connector
+     * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
+     * DisplayPort, 0 nowhere.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getHdr10PlusRoutes)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *routes
+    );
 };
 
 /** @} */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index f3f102a..a7573a9 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -369,6 +369,12 @@ static struct drm_connector_state* nv_drm_connector_atomic_duplicate_state(struc
         drm_property_blob_get(nv_drm_new_connector_state->hdmi_vsif_metadata);
     }
 
+    nv_drm_new_connector_state->hdr10plus_vsif =
+        nv_drm_old_connector_state->hdr10plus_vsif;
+    if (nv_drm_new_connector_state->hdr10plus_vsif) {
+        drm_property_blob_get(nv_drm_new_connector_state->hdr10plus_vsif);
+    }
+
     return &nv_drm_new_connector_state->base;
 }
 
@@ -383,6 +389,7 @@ static void nv_drm_connector_atomic_destroy_state(
     drm_property_blob_put(nv_drm_connector_state->hdcp_topology_blob);
 
     drm_property_blob_put(nv_drm_connector_state->hdmi_vsif_metadata);
+    drm_property_blob_put(nv_drm_connector_state->hdr10plus_vsif);
 
     nv_drm_free(nv_drm_connector_state);
 }
@@ -429,6 +436,15 @@ static int nv_drm_connector_atomic_set_property(
                     NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE);
     }
 
+    if (property == nv_dev->nv_connector_hdr10plus_vsif_property) {
+        return nv_drm_atomic_replace_property_blob_from_id_size_range(
+                    nv_dev->dev,
+                    &nv_connector_state->hdr10plus_vsif,
+                    val,
+                    NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE,
+                    NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE);
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -458,6 +474,12 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdr10plus_vsif_property) {
+        *val = nv_connector_state->hdr10plus_vsif ?
+            nv_connector_state->hdr10plus_vsif->base.id : 0;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -718,18 +740,44 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /*
+     * Hades: HDR10PLUS_VSIF, the HDR10+ vendor InfoFrame of the frame of this
+     * commit (27 bytes, IEEE OUI 90-84-8B first). It goes to NVKMS as the
+     * client's VSIF metadata, and NVKMS sends it next to the HDR InfoFrame
+     * (nvHadesHdr10PlusAllowed()); a change of it alone is carried by a flip,
+     * not a mode set (hdmiVsifMetadataDynamic). Not with NV_HDMI_VSIF_METADATA.
+     */
+    if (nv_new_connector_state->hdr10plus_vsif) {
+        const NvU8 *payload = nv_new_connector_state->hdr10plus_vsif->data;
+
+        if (nv_new_connector_state->hdmi_vsif_metadata ||
+            nv_new_connector_state->hdr10plus_vsif->length !=
+                NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE ||
+            payload == NULL ||
+            payload[0] != 0x8B || payload[1] != 0x84 || payload[2] != 0x90) {
+            return -EINVAL;
+        }
+    }
+
     /* Handle HDMI VSIF metadata changes */
+    req_config->flags.hdmiVsifMetadataDynamic =
+        !nv_old_connector_state->hdmi_vsif_metadata &&
+        !nv_new_connector_state->hdmi_vsif_metadata;
     req_config->flags.hdmiVsifMetadataChanged =
         !nv_drm_blobs_equal(nv_old_connector_state->hdmi_vsif_metadata,
-                            nv_new_connector_state->hdmi_vsif_metadata);
+                            nv_new_connector_state->hdmi_vsif_metadata) ||
+        !nv_drm_blobs_equal(nv_old_connector_state->hdr10plus_vsif,
+                            nv_new_connector_state->hdr10plus_vsif);
     if (req_config->flags.hdmiVsifMetadataChanged) {
-        if (nv_new_connector_state->hdmi_vsif_metadata &&
-            nv_new_connector_state->hdmi_vsif_metadata->data) {
+        struct drm_property_blob *blob =
+            nv_new_connector_state->hdmi_vsif_metadata ?
+                nv_new_connector_state->hdmi_vsif_metadata :
+                nv_new_connector_state->hdr10plus_vsif;
+
+        if (blob && blob->data) {
             struct drm_nvidia_hdmi_vsif_metadata* vsif_metadata =
-                (struct drm_nvidia_hdmi_vsif_metadata*)
-                nv_new_connector_state->hdmi_vsif_metadata->data;
-            NvU32 payload_size =
-                nv_new_connector_state->hdmi_vsif_metadata->length;
+                (struct drm_nvidia_hdmi_vsif_metadata*) blob->data;
+            NvU32 payload_size = blob->length;
             WARN_ON(payload_size < NV_DRM_HDMI_VSIF_METADATA_MIN_PAYLOAD_SIZE ||
                     payload_size > NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE);
             memcpy(req_config->modeSetConfig.hdmiVsifMetadata.payload,
@@ -1070,6 +1118,38 @@ done:
  * encoders of the static displays are added before, and properties cannot be
  * attached to a registered connector.
  */
+/*
+ * Hades: HDR10PLUS_VSIF on a connector through which NVKMS can send an HDR10+
+ * vendor InfoFrame next to the HDR one (routes, from
+ * NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS of one of its displays). Its presence
+ * tells a client that it can give the metadata of each frame with the commit
+ * of that frame. Only while the device is not registered yet.
+ */
+void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
+                                    NvU32 routes)
+{
+    struct drm_device *dev = nv_connector->base.dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+
+    if (routes == 0 || nv_connector->hdr10plus ||
+        nv_dev->nv_connector_hdr10plus_vsif_property == NULL) {
+        return;
+    }
+
+    if (dev->registered) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Connector at physical index %u can carry HDR10+, which is not offered",
+            nv_connector->physicalIndex);
+        return;
+    }
+
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdr10plus_vsif_property,
+                               0);
+    nv_connector->hdr10plus = true;
+}
+
 void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
 {
     struct drm_device *dev = nv_connector->base.dev;
