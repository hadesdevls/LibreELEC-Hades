+/*
+ * Hades: the HDR10+ InfoFrame on DisplayPort, an InfoFrame SDP built as NVKMS
+ * builds the one of the HDR InfoFrame (nvHadesHdr10PlusDpSdp(), as
+ * ConstructHdrInfoFrameSdp()), in a shared generic slot that NVKMS does not use
+ * on DisplayPort (nvHadesHdr10PlusRoutes()), without the checksum of the
+ * hardware on AD10x (NV_HADES_HDR10PLUS_DP_SDP_TC). Sent every frame while the
+ * client's vendor InfoFrame is an HDR10+ one; turned off where NVKMS turned it
+ * on.
+ */
+static void HadesUpdateDpHdr10Plus(const NVDispEvoRec *pDispEvo,
+                                   const NvU32 head)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const NvBool advanced = pDevEvo->caps.supportsGenericSharedInfoFrames;
+    const NVHDMIPKT_TYPE slot = advanced ? NVHDMIPKT_TYPE_SHARED_GENERIC4 :
+                                           NVHDMIPKT_TYPE_SHARED_GENERIC2;
+    const NvU32 hadesSlot = advanced ? NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC4 :
+                                       NV_HADES_HDR10PLUS_SLOT_SHARED_GENERIC2;
+    NvU8 packet[NV_HADES_HDR10PLUS_DP_SLOT_SIZE];
+    NvU32 packetSize;
+    NVHDMIPKT_RESULT ret;
+
+    /* the bytes and the layout of NVKMS's own InfoFrame SDP */
+    ct_assert(NV_HADES_HDR10PLUS_DP_SDP_HB1 == dp_pktType_VendorSpecInfoFrame);
+    ct_assert(NV_HADES_HDR10PLUS_DP_SDP_HB2 ==
+              (DP_INFOFRAME_SDP_V1_3_NON_AUDIO_SIZE - 1));
+    ct_assert(NV_HADES_HDR10PLUS_DP_SDP_HB3 ==
+              (DP_INFOFRAME_SDP_V1_3_VERSION <<
+               DP_INFOFRAME_SDP_V1_3_HB3_VERSION_SHIFT));
+    ct_assert(NV_HADES_HDR10PLUS_DP_SLOT_SIZE ==
+              (sizeof(((const DPSDP_DESCRIPTOR *)0)->hb) +
+               sizeof(((const DPSDP_DESCRIPTOR *)0)->db)));
+
+    if ((!advanced && (pDevEvo->dispClass != NVC770_DISPLAY)) ||
+        !nvHadesIsHdr10PlusVsif(pHeadState->hdmiVsifMetadata.payload,
+                                pHeadState->hdmiVsifMetadata.payloadSize)) {
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+
+    packetSize = nvHadesHdr10PlusDpSdp(pHeadState->hdmiVsifMetadata.payload,
+                                       packet);
+
+    if (advanced) {
+        ADVANCED_INFOFRAME advancedInfoFrame = { };
+
+        advancedInfoFrame.runMode = INFOFRAME_CTRL_RUN_MODE_ALWAYS;
+        advancedInfoFrame.location = INFOFRAME_CTRL_LOC_VBLANK;
+        advancedInfoFrame.packetLen = sizeof(packet);
+        advancedInfoFrame.pPacket = packet;
+        ret = NvHdmiPkt_SetupAdvancedInfoframe(pDevEvo->hdmiLib.handle,
+                                               pDispEvo->displayOwner,
+                                               head,
+                                               slot,
+                                               &advancedInfoFrame);
+    } else {
+        ret = NvHdmiPkt_PacketWrite(pDevEvo->hdmiLib.handle,
+                                    pDispEvo->displayOwner,
+                                    pHeadState->activeRmId,
+                                    head,
+                                    slot,
+                                    NV_HADES_HDR10PLUS_DP_SDP_TC,
+                                    packetSize,
+                                    packet);
+    }
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: the HDR10+ SDP of head %u could not be written",
+                     head);
+        (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
+        return;
+    }
+    if (nvHadesHdr10PlusSetSlot(pDispEvo, head, hadesSlot)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR10+ InfoFrame SDP on head %u", head);
+    }
+}
