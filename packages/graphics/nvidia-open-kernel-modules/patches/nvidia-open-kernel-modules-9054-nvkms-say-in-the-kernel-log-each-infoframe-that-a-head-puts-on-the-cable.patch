@@ -1203,6 +1203,9 @@ static void HadesSendVendorGeneric(const NVDispEvoRec *pDispEvo,
                 nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
                              "Hades: the vendor InfoFrame of head %u could not be turned off in the generic InfoFrame slot",
                              head);
+            } else {
+                nvHadesLogHdmiPacket(pDispEvo, head, NVHDMIPKT_TYPE_GENERIC,
