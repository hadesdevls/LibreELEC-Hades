@@ -1352,6 +1358,9 @@ static void HadesSendHdr10PlusHdmi(const NVDispEvoRec *pDispEvo,
         (void)nvHadesHdr10PlusSetSlot(pDispEvo, head, NV_HADES_HDR10PLUS_SLOT_NONE);
