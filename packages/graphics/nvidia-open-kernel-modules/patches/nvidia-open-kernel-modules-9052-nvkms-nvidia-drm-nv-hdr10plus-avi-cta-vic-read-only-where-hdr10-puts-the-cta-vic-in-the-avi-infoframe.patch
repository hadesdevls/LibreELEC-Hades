From 09495a1ca5dbf92591fcecb7e504bde8c6aaf86f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:18:32 +0000
Subject: [PATCH] nvkms, nvidia-drm: NV_HDR10PLUS_AVI_CTA_VIC, read-only, where
 HDR10+ puts the CTA VIC in the AVI InfoFrame

On Turing, Ampere and Ada the HDR10+ InfoFrame takes the generic slot of
NVKMS's HDMI_VIC vendor InfoFrame, so in a mode that NVKMS names by its
HDMI_VIC the AVI InfoFrame carries the CTA VIC of the format while HDR10+
goes out (9050). A client that starts HDR10+ some frames after the mode set
changes the AVI InfoFrame then, in the middle of the picture: a display may
take that as a new format and resynchronise. A client that knows it can put
the HDR10+ metadata in the commit of the mode instead, and the AVI InfoFrame
is right from the first frame. Kodi does that where the connector says so.
Nothing told a client where that happens: HDR10PLUS_VSIF is on the HALs with
generic shared InfoFrames too (T239, Blackwell), where HDR10+ has slot 9 of
its own and the AVI InfoFrame is not touched (9049).

A connector property of nvidia-drm, NV_HDR10PLUS_AVI_CTA_VIC, read-only
(DRM_MODE_PROP_IMMUTABLE, range 0..1, value 1), says it. It is attached with
HDR10PLUS_VSIF, only to the connectors with the HDMI route of HDR10+ on the
HALs without generic shared InfoFrames: the new route
NV_HADES_HDR10PLUS_ROUTE_HDMI_AVI_CTA_VIC (0x8) of
NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS (nvHadesHdr10PlusRoutes();
NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC for nvidia-drm, which KAPI takes
now up to 15). HDMI connectors, and DisplayPort connectors through their
TMDS output, on Turing, Ampere and Ada; not on GA10x where RM keeps the
generic slot for its ACR workaround (no HDMI route), nor on T239 and
Blackwell, nor on DisplayPort. Only while the device is not registered yet,
as the other properties of HDR10+. Whether a given mode and display get the
CTA VIC is the rule of nvHadesHdr10PlusAviCtaVic(); the property only says
that the connector can.

Nothing that NVKMS sends changes: no InfoFrame, no mode set, no flip.

Not run on a GPU.

Checked on the host: the routes of nvHadesHdr10PlusRoutes() against an
oracle over all its inputs and against 1.0 RC4 for the routes 0x1 and 0x2;
nvHadesConnectorHdr10PlusRoutes() of the tree for Turing, Ampere, GA10x with
the ACR workaround, Ada, T239 and Blackwell on HDMI, on a dual-mode
DisplayPort connector and on DisplayPort; GetHdr10PlusRoutes() of KAPI for
the values -1 to 17; and nv_drm_connector_add_hdr10plus() of the tree, fed
those routes: the property with value 1 on the HDMI connectors of Turing,
Ampere and Ada and on nothing else, once, and not after registration;
mutations of each of those caught. nvidia-drm.ko and nvidia-modeset.ko
compiled against Linux 7.3 with the compiler of the image.
---
 kernel-open/common/inc/nvkms-kapi.h           |  9 ++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 20 ++++++++++++++++---
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  2 ++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 11 ++++++++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  2 ++
 src/nvidia-modeset/include/nvkms-hades.h      | 19 +++++++++++++++---
 .../kapi/interface/nvkms-kapi.h               |  9 ++++++++-
 src/nvidia-modeset/kapi/src/nvkms-kapi.c      |  4 +++-
 8 files changed, 67 insertions(+), 9 deletions(-)

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index 301cb98..c6904ac 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -464,6 +464,11 @@ struct NvKmsKapiHeadModeSetConfig {
 
 /* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
 #define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+/*
+ * Hades: the route of getHdr10PlusRoutes() of the HDMI connectors where the AVI
+ * InfoFrame carries the CTA VIC of a mode named by an HDMI_VIC with HDR10+
+ */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC 0x8
 
 struct NvKmsKapiHeadRequestedConfig {
     struct NvKmsKapiHeadModeSetConfig modeSetConfig;
@@ -1743,7 +1748,9 @@ struct NvKmsKapiFunctionsTable {
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
      * DisplayPort, 0 nowhere; with 0x4 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF)
      * HDR10+ over HDMI needs HDMI VRR off where it would be on (hadesHdmiVrrOff
-     * of a mode set).
+     * of a mode set); with 0x8 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC)
+     * HDR10+ over HDMI puts the CTA VIC in the AVI InfoFrame of a mode named by
+     * an HDMI_VIC.
      *
      * \return NV_TRUE on success, NV_FALSE on failure.
      */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index cfdfcb5..33ce032 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1435,8 +1435,12 @@ done:
  * tells a client that it can give the metadata of each frame with the commit
  * of that frame. And NV_HDMI_VRR_OFF where HDR10+ over HDMI needs HDMI VRR off
  * in a mode set where it would be on (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF):
- * its presence tells a client that it may need it. Only while the device is
- * not registered yet.
+ * its presence tells a client that it may need it. And NV_HDR10PLUS_AVI_CTA_VIC,
+ * read-only and 1, where HDR10+ over HDMI puts the CTA VIC of a mode named by
+ * an HDMI_VIC in the AVI InfoFrame (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC:
+ * Turing, Ampere, Ada; not T239 nor Blackwell): there HDR10+ that starts some
+ * frames after the mode set changes the AVI InfoFrame then, so a client puts it
+ * in the commit of the mode. Only while the device is not registered yet.
  */
 void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
                                     NvU32 routes)
@@ -1453,7 +1457,17 @@ void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector,
         nv_connector->hdmi_vrr_off = true;
     }
 
-    routes &= ~NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF;
+    if ((routes & NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC) &&
+        !nv_connector->hdr10plus_avi_cta_vic && !dev->registered &&
+        nv_dev->nv_connector_hdr10plus_avi_cta_vic_property != NULL) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdr10plus_avi_cta_vic_property,
+                                   1);
+        nv_connector->hdr10plus_avi_cta_vic = true;
+    }
+
+    routes &= ~(NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF |
+                NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC);
     if (routes == 0 || nv_connector->hdr10plus ||
         nv_dev->nv_connector_hdr10plus_vsif_property == NULL) {
         return;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 5725fcf..063083d 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -41,6 +41,8 @@ struct nv_drm_connector {
     bool hdr10plus;
     /* Hades: NV_HDMI_VRR_OFF is attached (nv_drm_connector_add_hdr10plus()) */
     bool hdmi_vrr_off;
+    /* Hades: NV_HDR10PLUS_AVI_CTA_VIC is attached (nv_drm_connector_add_hdr10plus()) */
+    bool hdr10plus_avi_cta_vic;
     NvU32 physicalIndex;
 
     NvBool internal;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 2971e82..1066f27 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -786,6 +786,17 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, 1 where the AVI InfoFrame carries the CTA VIC of a mode
+     * named by an HDMI_VIC with HDR10+ (nvidia-drm-connector.c)
+     */
+    nv_dev->nv_connector_hdr10plus_avi_cta_vic_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_HDR10PLUS_AVI_CTA_VIC", 0, 1);
+    if (nv_dev->nv_connector_hdr10plus_avi_cta_vic_property == NULL) {
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 5b72522..0324936 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -211,6 +211,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
     /* Hades: NV_HDMI_VRR_OFF */
     struct drm_property *nv_connector_hdmi_vrr_off_property;
+    /* Hades: NV_HDR10PLUS_AVI_CTA_VIC */
+    struct drm_property *nv_connector_hdr10plus_avi_cta_vic_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 402c60d..15d429c 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -133,10 +133,20 @@ static inline NvBool nvHadesIsHdr10PlusVsif(const NvU8 *payload, NvU32 size)
  *    shared InfoFrames slot 9). A client may then leave HDMI VRR off in a mode
  *    set so that HDR10+ goes out in it (NV_HDMI_VRR_OFF of nvidia-drm,
  *    nvHadesHdmiVrrLeftOff()).
+ *  - HDMI_AVI_CTA_VIC, with the HDMI route on the HALs without generic shared
+ *    InfoFrames (Turing, Ampere, Ada): the HDR10+ InfoFrame takes the slot of
+ *    NVKMS's HDMI_VIC vendor InfoFrame there, so in a mode named by an HDMI_VIC
+ *    the AVI InfoFrame carries the CTA VIC of the format with it
+ *    (nvHadesHdr10PlusAviCtaVic()). A client that sends HDR10+ only some frames
+ *    after the mode set would see the AVI InfoFrame change then; it can put
+ *    HDR10+ in the commit of the mode instead (NV_HDR10PLUS_AVI_CTA_VIC of
+ *    nvidia-drm). Not on T239 and Blackwell, where HDR10+ has a slot of its
+ *    own (slot 9) and the AVI InfoFrame is not touched.
  */
-#define NV_HADES_HDR10PLUS_ROUTE_HDMI         0x1
-#define NV_HADES_HDR10PLUS_ROUTE_DP           0x2
-#define NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF 0x4
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI             0x1
+#define NV_HADES_HDR10PLUS_ROUTE_DP               0x2
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF     0x4
+#define NV_HADES_HDR10PLUS_ROUTE_HDMI_AVI_CTA_VIC 0x8
 
 static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
                                            NvBool dpConnector,
@@ -153,6 +163,9 @@ static inline NvU32 nvHadesHdr10PlusRoutes(NvBool hdmiConnector,
         if (!genericSharedInfoFrames && !adaSharedGenerics) {
             routes |= NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF;
         }
+        if (!genericSharedInfoFrames) {
+            routes |= NV_HADES_HDR10PLUS_ROUTE_HDMI_AVI_CTA_VIC;
+        }
     }
     if (dpConnector && !tmdsSignal &&
         (genericSharedInfoFrames || adaSharedGenerics)) {
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index 301cb98..c6904ac 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -464,6 +464,11 @@ struct NvKmsKapiHeadModeSetConfig {
 
 /* Hades: the route of getHdr10PlusRoutes() that asks for hadesHdmiVrrOff */
 #define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF 0x4
+/*
+ * Hades: the route of getHdr10PlusRoutes() of the HDMI connectors where the AVI
+ * InfoFrame carries the CTA VIC of a mode named by an HDMI_VIC with HDR10+
+ */
+#define NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC 0x8
 
 struct NvKmsKapiHeadRequestedConfig {
     struct NvKmsKapiHeadModeSetConfig modeSetConfig;
@@ -1743,7 +1748,9 @@ struct NvKmsKapiFunctionsTable {
      * of a display (NV_KMS_DPY_ATTRIBUTE_HADES_HDR10PLUS): 0x1 HDMI, 0x2
      * DisplayPort, 0 nowhere; with 0x4 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF)
      * HDR10+ over HDMI needs HDMI VRR off where it would be on (hadesHdmiVrrOff
-     * of a mode set).
+     * of a mode set); with 0x8 (NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC)
+     * HDR10+ over HDMI puts the CTA VIC in the AVI InfoFrame of a mode named by
+     * an HDMI_VIC.
      *
      * \return NV_TRUE on success, NV_FALSE on failure.
      */
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 7acd8d6..57ae631 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -1544,7 +1544,9 @@ static NvBool GetHdr10PlusRoutes(
 
     ct_assert(NVKMS_KAPI_HADES_HDR10PLUS_HDMI_VRR_OFF ==
               NV_HADES_HDR10PLUS_ROUTE_HDMI_VRR_OFF);
-    if (params.reply.value < 0 || params.reply.value > 7) {
+    ct_assert(NVKMS_KAPI_HADES_HDR10PLUS_HDMI_AVI_CTA_VIC ==
+              NV_HADES_HDR10PLUS_ROUTE_HDMI_AVI_CTA_VIC);
+    if (params.reply.value < 0 || params.reply.value > 15) {
         return NV_FALSE;
     }
 
