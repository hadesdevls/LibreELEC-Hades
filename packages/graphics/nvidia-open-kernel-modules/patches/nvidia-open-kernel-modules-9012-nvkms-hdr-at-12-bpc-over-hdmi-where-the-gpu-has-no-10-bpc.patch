From ec3aaae78ba902343b9d9e82a993d6b4301fc430 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:10:05 +0000
Subject: [PATCH] nvkms: HDR at 12 bpc over HDMI where the GPU has no 10 bpc,
 when asked for

The NVDisplay of Turing has no 10 bpc over HDMI (supportsHDMI10BPC is FALSE
for nvEvoC5, and its hdmiTmds10BpcMaxPClkMHz is 0), and 12 bpc is offered
only with nvidia-modeset.max_output_color_depth=12, a parameter that 615
added with 10 as its default: 615 is the first release with 12 bpc output
at all (610.57.04 has no nvDpyIsHdmiDepth36Evo()), and the default keeps
what 610 did; NVIDIA's changelog does not say why. So on Turing an HDR video
on an HDMI display goes out at 8 bpc with dithering, whatever the display
takes. An HP ZBook 17 G6 (Quadro RTX 4000) with a TV that takes 30, 36 and
48-bit deep colour shows it: its user reports HDR at 8 bits.

Off by default: a new parameter of nvidia-modeset, hades_turing_12bpc,
turns it on (nvidia-modeset.hades_turing_12bpc=1 on the kernel command
line). Without it NVKMS behaves here as 615.78.08 does.
max_output_color_depth=12 is another thing: it raises the depth limit of
every output on every GPU (GetMaxOutputColorBpc()), not that of HDR on
Turing alone.

With it, when a mode set signals HDR (BT.2100 colorimetry), the client fixed
no depth, NVKMS chose RGB at 8 bpc, the display takes 36-bit deep colour,
HDMI deep colour is not turned off (hdmi_deepcolor) and max_output_color_depth
is not below 10, the mode is validated at 12 bpc first, with the depth fixed:
the TMDS check then refuses a mode that does not fit (2160p at 50 or 60 Hz
on HDMI 2.0) instead of lowering the depth, and the mode is validated as
before, at 8 bpc. 2160p up to 30 Hz fits (445.5 MHz of the 600 of HDMI 2.0).

Not touched: SDR (its colorimetry is not BT.2100), Dolby Vision (it fixes 8
bpc through "max bpc", and its colorimetry is the default one), a depth that
the client fixed, YCbCr 4:2:0, and every GPU with 10 bpc over HDMI (Ampere
and later).

The kernel log says it when it happens for a display, and when the mode did
not fit; the decision is on plain values in nvkms-hades.h for a host test.
---
 .../nvidia-modeset/nvidia-modeset-linux.c     | 13 ++++
 .../nvidia-modeset-os-interface.h             |  1 +
 src/nvidia-modeset/include/nvkms-hades.h      | 40 ++++++++++++
 src/nvidia-modeset/include/nvkms-hdmi.h       |  1 +
 src/nvidia-modeset/include/nvkms-types.h      |  7 +++
 .../include/nvidia-modeset-os-interface.h     |  1 +
 src/nvidia-modeset/src/nvkms-hdmi.c           | 21 ++++++-
 src/nvidia-modeset/src/nvkms-modeset.c        | 62 +++++++++++++++++++
 8 files changed, 145 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index 62986c4..0f95b2a 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -95,6 +95,14 @@ module_param_named(hdmi_deepcolor, hdmi_deepcolor, bool, 0444);
 static unsigned int max_output_color_depth = 10;
 module_param_named(max_output_color_depth, max_output_color_depth, uint, 0444);
 
+/*
+ * Hades: HDR at 12 bpc over HDMI where the GPU has no 10 bpc (Turing), for a
+ * display that takes 36-bit deep colour (nvHadesHdmiHdr12Capable()). Off by
+ * default: NVKMS then sends HDR there at 8 bpc, as NVIDIA's driver does.
+ */
+static bool hades_turing_12bpc = false;
+module_param_named(hades_turing_12bpc, hades_turing_12bpc, bool, 0444);
+
 static bool opportunistic_display_sync = true;
 module_param_named(opportunistic_display_sync, opportunistic_display_sync, bool, 0444);
 
@@ -250,6 +258,11 @@ NvBool nvkms_hdmi_deepcolor(void)
     return hdmi_deepcolor;
 }
 
+NvBool nvkms_hades_turing_12bpc(void)
+{
+    return hades_turing_12bpc;
+}
+
 NvU32 nvkms_max_output_color_bpc(void)
 {
     switch (max_output_color_depth) {
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
index dc33314..a93a7f0 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -125,6 +125,7 @@ NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
 NvU32 nvkms_max_output_color_bpc(void);
+NvBool nvkms_hades_turing_12bpc(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
 NvBool nvkms_enable_overlay_layers(void);
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index dc79c24..309c16d 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -54,4 +54,44 @@ static inline NvBool nvHadesVsifOnConnector(NvBool hdmiConnector,
     return dpConnector && tmdsSignal && !usesDpLib && hdmiSink;
 }
 
+/*
+ * Whether HDR to this HDMI display may go out at 12 bpc in place of 8:
+ *  - asked for (nvidia-modeset.hades_turing_12bpc=1; off by default), HDMI
+ *    deep colour not turned off (hdmi_deepcolor) and max_output_color_depth
+ *    not below 10 (the user did not ask for 8);
+ *  - the display is driven as HDMI and takes 36-bit deep colour (DC_36bit of
+ *    its HDMI vendor-specific data block);
+ *  - the GPU has no 10 bpc over HDMI (supportsHDMI10BPC, the NVDisplay of
+ *    Turing): where it has, HDR gets 10 bpc as NVIDIA does it, and nothing
+ *    here applies.
+ */
+static inline NvBool nvHadesHdmiHdr12Capable(NvBool enabled, NvBool hdmiDeepColor,
+                                             NvU32 maxOutputBpc,
+                                             NvBool hdmiSink,
+                                             NvBool hdmi10BpcHw,
+                                             NvBool sink36Bit)
+{
+    return enabled && hdmiDeepColor && (maxOutputBpc >= 10) && hdmiSink &&
+           !hdmi10BpcHw && sink36Bit;
+}
+
+/*
+ * Whether a mode set is first tried at 12 bpc: the display can take it
+ * (nvHadesHdmiHdr12Capable()), the head signals HDR (BT.2100 colorimetry: an
+ * SDR or Dolby Vision output does not), the client fixed no depth (Dolby
+ * Vision fixes 8 through "max bpc"), and NVKMS chose RGB at 8 bpc without
+ * YCbCr 4:2:0. Whether the mode fits TMDS at 12 bpc is checked after this,
+ * with the mode; if it does not, the mode is set as before.
+ */
+static inline NvBool nvHadesHdrWants12Bpc(NvBool capable,
+                                          NvBool bt2100,
+                                          NvBool bpcRequested,
+                                          NvBool rgb,
+                                          NvBool yuv420,
+                                          NvU32 chosenBpc)
+{
+    return capable && bt2100 && !bpcRequested && rgb && !yuv420 &&
+           (chosenBpc == 8);
+}
+
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/include/nvkms-hdmi.h b/src/nvidia-modeset/include/nvkms-hdmi.h
index 72def96..bff85c7 100644
--- a/src/nvidia-modeset/include/nvkms-hdmi.h
+++ b/src/nvidia-modeset/include/nvkms-hdmi.h
@@ -49,6 +49,7 @@ void nvLogEdidCea861InfoEvo(NVDpyEvoPtr pDpyEvo,
 NvBool nvDpyIsHdmiEvo(const NVDpyEvoRec *pDpyEvo);
 NvBool nvDpyIsHdmiDepth30Evo(const NVDpyEvoRec *pDpyEvo);
 NvBool nvDpyIsHdmiDepth36Evo(const NVDpyEvoRec *pDpyEvo);
+NvBool nvDpyIsHdmiHdrDepth36Evo(const NVDpyEvoRec *pDpyEvo);
 
 NvBool nvHdmi204k60HzRGB444Allowed(const NVDpyEvoRec *pDpyEvo,
                                    const struct NvKmsModeValidationParams *pParams,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index f0e917d..3b521f1 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -2314,6 +2314,13 @@ typedef struct _NVDpyEvoRec {
 
     /* whether the connected dpy is HDMI capable */
     NvBool      hdmiCapable              : 1;
+
+    /*
+     * Hades: the depth of HDR (8 or 12 bpc) that the kernel log last said for
+     * this display on a GPU without 10 bpc over HDMI, 0 if none since it last
+     * left HDR.
+     */
+    NvU8        hadesHdrBpcLogged;
     NvBool      isVrHmd                  : 1;
 
     /* 
diff --git a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
index dc33314..a93a7f0 100644
--- a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
+++ b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
@@ -125,6 +125,7 @@ NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
 NvU32 nvkms_max_output_color_bpc(void);
+NvBool nvkms_hades_turing_12bpc(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
 NvBool nvkms_enable_overlay_layers(void);
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index a4e4f76..31a35e9 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -29,6 +29,7 @@
 #include "nvkms-api.h"
 #include "nvkms-dpy.h"
 #include "nvkms-hdmi.h"
+#include "nvkms-hades.h"
 #include "nvkms-evo.h"
 #include "nvkms-modepool.h"
 #include "nvkms-rmapi.h"
@@ -306,6 +307,23 @@ NvBool nvDpyIsHdmiDepth36Evo(const NVDpyEvoRec *pDpyEvo)
            (hdmiCap & CAP_HDMI_SUPPORT_MONITOR_36_BPP);
 }
 
+/*!
+ * Hades: returns whether HDR to this display may go out at 12 bpc in place of
+ * 8 on a GPU without 10 bpc over HDMI (nvHadesHdmiHdr12Capable()).
+ */
+NvBool nvDpyIsHdmiHdrDepth36Evo(const NVDpyEvoRec *pDpyEvo)
+{
+    const NVDevEvoRec *pDevEvo = pDpyEvo->pDispEvo->pDevEvo;
+    const NvU32 hdmiCap = GetHDMISupportCap(pDpyEvo);
+
+    return nvHadesHdmiHdr12Capable(
+        nvkms_hades_turing_12bpc(), nvkms_hdmi_deepcolor(),
+        nvkms_max_output_color_bpc(),
+        nvDpyIsHdmiEvo(pDpyEvo),
+        pDevEvo->hal->caps.supportsHDMI10BPC,
+        (hdmiCap & CAP_HDMI_SUPPORT_MONITOR_36_BPP) != 0);
+}
+
 /*!
  * Updates the display's HDMI 2.0 capabilities to the RM.
  */
@@ -2324,7 +2342,8 @@ static NvU32 GetMaxPossibleTmdsPixelClockKHz(
         const NvU32 adjustedMaxPixelClock =
             (pDpyEvo->maxSingleLinkPixelClockKHz * 2ULL) / 3ULL;
 
-        nvAssert(nvDpyIsHdmiDepth36Evo(pDpyEvo));
+        nvAssert(nvDpyIsHdmiDepth36Evo(pDpyEvo) ||
+                 nvDpyIsHdmiHdrDepth36Evo(pDpyEvo));
 
         return adjustedMaxPixelClock;
     }
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index f51f97b..dc0bcb4 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -81,6 +81,7 @@
 #include "nvkms-dpy.h"
 #include "nvkms-rm.h"
 #include "nvkms-hdmi.h"
+#include "nvkms-hades.h"
 #include "nvkms-hw-flip.h"
 #include "nvkms-flip.h"
 #include "nvkms-3dvision.h"
@@ -214,6 +215,67 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
         return FALSE;
     }
 
+    /*
+     * Hades: the GPU has no 10 bpc over HDMI (Turing), so HDR would go out at
+     * 8 bpc; where the display takes 36-bit deep colour and the mode fits TMDS
+     * at 12 bpc (2160p up to 30 Hz on HDMI 2.0, for one), it goes out at 12
+     * (nvHadesHdrWants12Bpc()). The mode is validated at 12 bpc with the depth
+     * fixed; if it is refused, it is validated as before, at the depth NVKMS
+     * chose. SDR, a depth the client fixed (Dolby Vision) and GPUs with 10 bpc
+     * over HDMI are not touched.
+     */
+    if (nvHadesHdrWants12Bpc(
+            nvDpyIsHdmiHdrDepth36Evo(pDpyEvo),
+            dpyColor.colorimetry == NVKMS_OUTPUT_COLORIMETRY_BT2100,
+            pRequestHead->colorBpcSpecified,
+            dpyColor.format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB,
+            pRequestHead->mode.timings.yuv420Mode != NV_YUV420_MODE_NONE,
+            dpyColor.bpc)) {
+        NVDpyAttributeColor deepColor = dpyColor;
+        NvU8 logged;
+
+        deepColor.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
+
+        if (nvValidateModeForModeset(pDpyEvo,
+                                     &pRequestHead->modeValidationParams,
+                                     &pRequestHead->mode,
+                                     &pRequestHead->viewPortSizeIn,
+                                     pRequestHead->viewPortOutSpecified ?
+                                               &pRequestHead->viewPortOut : NULL,
+                                     pRequestHead->colorFormatSpecified,
+                                     TRUE /* the depth stays 12 */,
+                                     &deepColor,
+                                     pTimings,
+                                     pInfoFrameCtrl,
+                                     pVSInfoFrameCtrl,
+                                     pEmpInfoFrameCtrl)) {
+            if (pDpyEvo->hadesHdrBpcLogged != 12) {
+                pDpyEvo->hadesHdrBpcLogged = 12;
+                nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                             "Hades: HDR on %s goes out at 12 bpc: this GPU "
+                             "has no 10 bpc over HDMI, and the display takes "
+                             "36-bit deep colour",
+                             pDpyEvo->name);
+            }
+            if (pDpyColor != NULL) {
+                *pDpyColor = deepColor;
+            }
+            return TRUE;
+        }
+
+        logged = pDpyEvo->hadesHdrBpcLogged;
+        if (logged != 8) {
+            pDpyEvo->hadesHdrBpcLogged = 8;
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: HDR on %s goes out at 8 bpc: the mode does "
+                         "not fit TMDS at 12 bpc, and this GPU has no 10 bpc "
+                         "over HDMI",
+                         pDpyEvo->name);
+        }
+    } else if (dpyColor.colorimetry != NVKMS_OUTPUT_COLORIMETRY_BT2100) {
+        pDpyEvo->hadesHdrBpcLogged = 0;
+    }
+
     if (!nvValidateModeForModeset(pDpyEvo,
                                   &pRequestHead->modeValidationParams,
                                   &pRequestHead->mode,
-- 
2.53.0

