From e181471a57617055d65e12e7694c726bfca3535e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:45:11 +0000
Subject: [PATCH] nvidia: Dolby Vision Low-Latency over the RGB 8 bpc tunnel

Some displays take Dolby Vision as Low-Latency ("player-led") only: a
Sony of 2020, and the LG C5 in its game mode (Dolby VSVDB interface 0,
YCbCr 4:2:2 at 12 bits). The player maps the picture to the display and
sends it next to the Dolby VSIF with low_latency set and an AVI
InfoFrame of YCbCr 4:2:2, limited range, BT.2020 (the Low-Latency
signal of the Amlogic HDMI transmitter, CoreELEC linux-amlogic,
hdmitx_set_vsif_pkt()).

The Dolby Vision tunnel on nvidia-drm already sends the Dolby VSIF that
user space gives NV_HDMI_VSIF_METADATA, and its RGB 8 bpc pixels carry
YCbCr 4:2:2 at 12 bits (the luma in G, the high chroma bits in R, the
low bits of both in B). What is missing is the AVI InfoFrame: NVKMS
builds it from the head's real output format
(CalculateVideoInfoFrameColorFormat()), and nothing tells it to say
YCbCr 4:2:2 over RGB.

NVKMS: a head whose user VSIF is the Low-Latency Dolby VSIF (27 bytes,
OUI 00-D0-46, then the Dolby Vision signal and low_latency set) and
that drives RGB at 8 bpc sends the AVI InfoFrame that NVKMS sends for
its own YCbCr 4:2:2 output with BT.2100 colorimetry: YCbCr 4:2:2,
BT.2020, limited range. The VSIF and the AVI InfoFrame are updated
together (nvUpdateHdmiInfoFrames()), on a flip as on a modeset, so the
two always agree. A head that sends that VSIF in another format (RGB
at 10 bpc, YCbCr 4:2:0) keeps its AVI InfoFrame, and a warning says so.
The AVI InfoFrame follows the VSIF, which NVKMS already has, instead of
a new field: the structures that carry it (NvKmsFlipCommonParams) are
those of the NVKMS ioctls that the closed user space of the same
driver uses, and are not changed.

nvidia-drm: NV_HDMI_DV_LOW_LATENCY, a boolean connector property next
to NV_HDMI_VSIF_METADATA on HDMI connectors. Its presence tells user
space that the module does this; its value is the consent: the atomic
check refuses the Low-Latency Dolby VSIF without it, and it without
that VSIF, "max bpc" 8, the default colorimetry and no HDR metadata, so
that the AVI InfoFrame never says other than what user space asked for.

The GCP NVKMS sends at 8 bpc (CD 0) is the one it sends for its own
4:2:2 output. Whether a display takes the 4:2:2 so is seen on it with a
test pattern.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 92 +++++++++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  2 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 11 +++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  2 +
 src/nvidia-modeset/src/nvkms-hdmi.c           | 43 +++++++++
 5 files changed, 150 insertions(+)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index a7573a9..71ec939 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -374,6 +374,8 @@ static struct drm_connector_state* nv_drm_connector_atomic_duplicate_state(struc
     if (nv_drm_new_connector_state->hdr10plus_vsif) {
         drm_property_blob_get(nv_drm_new_connector_state->hdr10plus_vsif);
     }
+    nv_drm_new_connector_state->hdmi_dv_low_latency =
+        nv_drm_old_connector_state->hdmi_dv_low_latency;
 
     return &nv_drm_new_connector_state->base;
 }
@@ -445,6 +447,14 @@ static int nv_drm_connector_atomic_set_property(
                     NV_DRM_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE);
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+        if (val > 1) {
+            return -EINVAL;
+        }
+        nv_connector_state->hdmi_dv_low_latency = val;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -480,6 +490,11 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+        *val = nv_connector_state->hdmi_dv_low_latency;
+        return 0;
+    }
+
     /* Unknown property - DRM core handles standard connector properties */
     return -EINVAL;
 }
@@ -683,6 +698,56 @@ static NvU32 nv_drm_connector_requested_bpc(
     return 0;
 }
 
+/*
+ * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel. The pixels of
+ * the tunnel carry YCbCr 4:2:2 at 12 bits (luma in G, the high chroma bits
+ * in R, the low bits of both in B, the HDMI 4:2:2 pixel encoding). A head
+ * that sends the Low-Latency Dolby VSIF (the OUI 00-D0-46, then the Dolby
+ * Vision signal and low_latency set: the 27-byte payload of the Amlogic HDMI
+ * transmitter's Low-Latency signal) at RGB 8 bpc has NVKMS say YCbCr 4:2:2,
+ * BT.2020, limited range in its AVI InfoFrame (nvkms-hdmi.c), which is what
+ * the sink's Low-Latency input reads those bytes as.
+ *
+ * So that the AVI InfoFrame never says other than what user space asked for:
+ * NV_HDMI_VSIF_METADATA takes that VSIF only with NV_HDMI_DV_LOW_LATENCY set,
+ * and NV_HDMI_DV_LOW_LATENCY is taken only with that VSIF, "max bpc" 8, the
+ * default colorimetry and no HDR metadata. Returns 0 or -EINVAL.
+ */
+static bool nv_drm_vsif_is_dolby_low_latency(const uint8_t *payload, size_t size)
+{
+    return (size == 27) && (payload[0] == 0x46) && (payload[1] == 0xd0) &&
+           (payload[2] == 0x00) && ((payload[3] & 0x3) == 0x3);
+}
+
+static int nv_drm_connector_check_dv_low_latency(bool low_latency,
+                                                 const uint8_t *vsif,
+                                                 size_t vsif_size,
+                                                 NvU32 bpc,
+                                                 bool default_colorimetry,
+                                                 bool hdr_metadata,
+                                                 const char **why)
+{
+    const bool ll_vsif =
+        (vsif != NULL) && nv_drm_vsif_is_dolby_low_latency(vsif, vsif_size);
+
+    if (ll_vsif && !low_latency) {
+        *why = "a Dolby Vision Low-Latency VSIF needs NV_HDMI_DV_LOW_LATENCY";
+        return -EINVAL;
+    }
+    if (!low_latency) {
+        return 0;
+    }
+    if (!ll_vsif) {
+        *why = "NV_HDMI_DV_LOW_LATENCY needs the Dolby Vision Low-Latency VSIF";
+        return -EINVAL;
+    }
+    if ((bpc != 8) || !default_colorimetry || hdr_metadata) {
+        *why = "NV_HDMI_DV_LOW_LATENCY needs \"max bpc\" 8, the default colorimetry and no HDR metadata";
+        return -EINVAL;
+    }
+    return 0;
+}
+
 static int
 __nv_drm_connector_atomic_check(struct drm_connector *connector,
                                 nv_drm_atomic_state_base_t *state)
@@ -790,6 +855,27 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel (above) */
+    {
+        const struct drm_property_blob *vsif =
+            nv_new_connector_state->hdmi_vsif_metadata;
+        const char *why = NULL;
+        int ret = nv_drm_connector_check_dv_low_latency(
+            nv_new_connector_state->hdmi_dv_low_latency,
+            (vsif && vsif->data) ? vsif->data : NULL,
+            (vsif && vsif->data) ? vsif->length : 0,
+            nv_drm_connector_requested_bpc(new_connector_state),
+            new_connector_state->colorspace == DRM_MODE_COLORIMETRY_DEFAULT,
+            new_connector_state->hdr_output_metadata != NULL,
+            &why);
+
+        if (ret != 0) {
+            NV_DRM_DEV_LOG_INFO(nv_dev, "[CONNECTOR:%d:%s] refused: %s",
+                                connector->base.id, connector->name, why);
+            return ret;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
@@ -992,6 +1078,12 @@ nv_drm_connector_new(struct drm_device *dev,
             drm_object_attach_property(&nv_connector->base.base,
                                        nv_dev->nv_connector_hdmi_vsif_metadata_property,
                                        0);
+            /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel */
+            if (nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+                drm_object_attach_property(&nv_connector->base.base,
+                                           nv_dev->nv_connector_hdmi_dv_low_latency_property,
+                                           0);
+            }
         }
     } else if (nv_connector->type == NVKMS_CONNECTOR_TYPE_DP) {
 #if defined(NV_DRM_MODE_CREATE_DP_COLORSPACE_PROPERTY_HAS_SUPPORTED_COLORSPACES_ARG)
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index fe5930d..8cc3af5 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -125,6 +125,8 @@ struct nv_drm_connector_state {
        struct drm_property_blob *hdmi_vsif_metadata;
        /* Hades: HDR10PLUS_VSIF */
        struct drm_property_blob *hdr10plus_vsif;
+       /* Hades: NV_HDMI_DV_LOW_LATENCY */
+       bool hdmi_dv_low_latency;
 };
 
 static inline struct nv_drm_connector_state *to_nv_drm_connector_state(
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index d9cb7e5..9c37075 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -752,6 +752,17 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel: with it set,
+     * NV_HDMI_VSIF_METADATA takes the Low-Latency Dolby VSIF, and NVKMS sends
+     * the AVI InfoFrame of YCbCr 4:2:2 that goes with it (nvkms-hdmi.c)
+     */
+    nv_dev->nv_connector_hdmi_dv_low_latency_property =
+        drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_DV_LOW_LATENCY");
+    if (nv_dev->nv_connector_hdmi_dv_low_latency_property == NULL) {
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index cdde346..c66d7de 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -205,6 +205,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdmi_vsif_metadata_property;
     /* Hades: HDR10PLUS_VSIF (nvidia-drm-connector.c) */
     struct drm_property *nv_connector_hdr10plus_vsif_property;
+    /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel */
+    struct drm_property *nv_connector_hdmi_dv_low_latency_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index b86e42d..f5d501a 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -521,6 +521,40 @@ static void UpdateInfoFrameFlipStatePost(NvEvoInfoFrameTransmitControl *currentT
     currentTransmitCtrl->curFlipSynchronized = currentTransmitCtrl->newFlipSynchronized;
 }
 
+/*
+ * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel (nvidia-drm,
+ * NV_HDMI_DV_LOW_LATENCY). The pixels the head sends carry YCbCr 4:2:2 at
+ * 12 bits when its user VSIF is the Low-Latency Dolby VSIF (the OUI 00-D0-46,
+ * then the Dolby Vision signal and low_latency set) and it drives RGB at
+ * 8 bpc; the AVI InfoFrame then says what NVKMS says for its own YCbCr 4:2:2
+ * output with BT.2100 colorimetry (CalculateVideoInfoFrameColorFormat()):
+ * YCbCr 4:2:2, BT.2020, limited range. nvidia-drm takes that VSIF only with
+ * the property set. Returns whether the AVI InfoFrame was changed.
+ */
+static NvBool HdmiIsDolbyLowLatencyVsif(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return (pVsif->payloadSize == 27) && (pVsif->payload[0] == 0x46) &&
+           (pVsif->payload[1] == 0xd0) && (pVsif->payload[2] == 0x00) &&
+           ((pVsif->payload[3] & 0x3) == 0x3);
+}
+
+static NvBool HdmiDolbyLowLatencyAvi(const struct NvKmsHdmiVsifMetadata *pVsif,
+                                     const NVDpyAttributeColor *pDpyColor,
+                                     NVT_VIDEO_INFOFRAME_CTRL *pCtrl)
+{
+    if (!HdmiIsDolbyLowLatencyVsif(pVsif) ||
+        (pDpyColor->format != NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB) ||
+        (pDpyColor->bpc != NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8)) {
+        return FALSE;
+    }
+
+    pCtrl->color_space = NVT_VIDEO_INFOFRAME_BYTE1_Y1Y0_YCbCr422;
+    pCtrl->colorimetry = NVT_VIDEO_INFOFRAME_BYTE2_C1C0_EXT_COLORIMETRY;
+    pCtrl->extended_colorimetry = NVT_VIDEO_INFOFRAME_BYTE3_EC_BT2020RGBYCC;
+    pCtrl->rgb_quantization_range = NVT_VIDEO_INFOFRAME_BYTE3_Q1Q0_LIMITED_RANGE;
+    return TRUE;
+}
+
 /*
  * SendVideoInfoFrame() - Construct video infoframe using provided EDID and call
  * ->SendHdmiInfoFrame() to send it to RM.
@@ -541,6 +575,15 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
 
     CalculateVideoInfoFrameColorFormat(pDpyColor, hdTimings, pEdidInfo, &videoCtrl);
 
+    /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel (above) */
+    if (HdmiIsDolbyLowLatencyVsif(&pDispEvo->headState[head].hdmiVsifMetadata) &&
+        !HdmiDolbyLowLatencyAvi(&pDispEvo->headState[head].hdmiVsifMetadata,
+                                pDpyColor, &videoCtrl)) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Dolby Vision Low-Latency VSIF on a head that is not RGB at "
+                     "8 bpc: the AVI InfoFrame says the output as it is");
+    }
+
     status = NvTiming_ConstructVideoInfoframe(pEdidInfo,
                                               &videoCtrl,
                                               NULL, &VideoInfoFrame);
-- 
2.53.0

