From 648b683a99e82c3be0cefc71e0d20666d71a67da Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:30:00 +0000
Subject: [PATCH 2/3] nvkms: each change of the VRR packet of HDMI in the
 kernel log

nvidia-open-kernel-modules-9054 says each InfoFrame that a head puts on the
cable, but counts a vendor-specific InfoFrame or an extended metadata packet
that changes within a minute of its last line, so that HDR10+ does not fill the
log. The extended metadata packet of HDMI VRR (the VTEM: HDMI 2.1,
Organization_ID 1, Data_Set_Tag 1) was counted with them, and it is the one
that tells two modes of a display apart: NVKMS turns HDMI VRR on in a mode set
of a display that declares it from 50 Hz and 720 lines up
(nvGetAllowedDpyVrrType()), but only where the refresh rate is at least 110 %
of the display's VRR minimum (nvAdjustHwModeTimingsForVrrEvo()), and sends the
VTEM with every frame from then on. A display whose VRR starts at 48 Hz has it
at 59.94 and 60 Hz (52.8 Hz and up) and not at 50 Hz, and that was the one
difference that the log could not show between Dolby Vision that a TV took at
3840x2160 and 50 Hz and Dolby Vision it did not take at 60 Hz (issue 4 of
Hades: the log said "3 changes of it since its last line were not shown").

Each change of the VTEM is said now, named with what it says: "extended
metadata packet of HDMI VRR (VTEM: VRR on, base refresh rate 60 Hz) in the
generic slot, 31 bytes: ..." (VRR_EN of MD0, and Base_Refresh_Rate of MD2 and
MD3). Bounded: at most 8 lines a minute for the VTEM of a slot, past which its
changes are counted as before and the next line says how many; the other
vendor-specific InfoFrames and extended metadata packets as before; and the
400 lines of a GPU as before. The state of each slot of each head keeps when
that minute began and its lines.

Nothing that goes out changes: only the log.

Checked with a host test that builds nvHadesLogHdmiPacket() and its helpers
of nvkms-evo1.c as the tree has them and feeds it the VTEM sequences of the
issue's kernel log (VRR on at 60 and 120 Hz, the packet that ends it, the
same bytes again), an HDR10+ InfoFrame changing with the scenes, extended
metadata packets that are not the VTEM (another Organization_ID, another
Data_Set_Tag), more than 8 changes of the VTEM in a minute, and a slot turned
off: every change of the VTEM said with its name until the eighth of the
minute, the ninth and tenth counted and said with the next line after the
minute, the others as before, nothing said for the same bytes (23 checks; 10
of them fail on the tree before this change). 10 mutations of the change,
each caught. The five modules build against Linux 7.3.4 with the compiler of
the image. Not run on a GPU.
---
 src/nvidia-modeset/include/nvkms-types.h |  4 ++
 src/nvidia-modeset/src/nvkms-evo1.c      | 50 ++++++++++++++++++++++--
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index feb94d4..ef32c6c 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1014,10 +1014,14 @@ typedef struct _NVDisplaylessWorkerRec {
 #define NV_HADES_INFOFRAME_LOG_SLOTS 16
 #define NV_HADES_INFOFRAME_LOG_BYTES 36
 #define NV_HADES_INFOFRAME_LOG_LINES 400
+/* the lines a minute that the EMP of HDMI VRR (VTEM) of one slot may have */
+#define NV_HADES_INFOFRAME_LOG_VTEM_LINES 8
 
 struct NvHadesInfoFrameLog {
     NvU64 lastUs;
+    NvU64 vtemMinuteUs; /* when the minute of the VTEM lines began */
     NvU16 notShown;
+    NvU8 vtemLines;     /* the VTEM lines of that minute */
     NvU8 on;
     NvU8 len;
     NvU8 bytes[NV_HADES_INFOFRAME_LOG_BYTES];
diff --git a/src/nvidia-modeset/src/nvkms-evo1.c b/src/nvidia-modeset/src/nvkms-evo1.c
index 6bcf23d..73cc688 100644
--- a/src/nvidia-modeset/src/nvkms-evo1.c
+++ b/src/nvidia-modeset/src/nvkms-evo1.c
@@ -139,7 +139,10 @@ static NVHDMIPKT_TC EvoInfoFrameToHdmiLibTransmitCtrl(
  * bytes change within a minute of the last line of the same one (the same
  * type and IEEE OUI) is counted, and the next line of that slot says how many
  * there were (HDR10+ changes with the scenes), while every other change is
- * shown (an AVI InfoFrame that changes its VIC right after a mode set); and
+ * shown (an AVI InfoFrame that changes its VIC right after a mode set, and the
+ * extended metadata packet of HDMI VRR, the VTEM, up to
+ * NV_HADES_INFOFRAME_LOG_VTEM_LINES lines a minute for a slot, named with
+ * whether VRR is on and its base refresh rate); and
  * at most NV_HADES_INFOFRAME_LOG_LINES lines for a GPU until nvidia-modeset is
  * loaded again. slot is the NVHDMIPKT_TYPE that
  * keys the slot, name the one it is named by (the register of the pair, on
@@ -163,9 +166,31 @@ static void HadesSlotName(NvU32 name, char *buf, NvU32 size)
     }
 }
 
+/*
+ * Hades: the packet is the extended metadata packet of HDMI VRR, the VTEM
+ * (HDMI 2.1: Organization_ID 1, Data_Set_Tag 1), with its metadata: pb1 is
+ * where PB0 is, then PB2 the Organization_ID, PB3-PB4 the Data_Set_Tag,
+ * PB7 MD0 (bit 0 VRR_EN), PB9 MD2 (bits 1-0 the high bits of
+ * Base_Refresh_Rate) and PB10 MD3 (its low bits).
+ */
+static NvBool HadesIsVrrEmp(const NvU8 *pPacket, NvU32 len, NvU32 pb1)
+{
+    return (pPacket[0] == 0x7F) && (len >= pb1 + 11) &&
+           (pPacket[pb1 + 2] == 0x01) && (pPacket[pb1 + 3] == 0x00) &&
+           (pPacket[pb1 + 4] == 0x01);
+}
+
 static void HadesPacketName(const NvU8 *pPacket, NvU32 len, NvU32 pb1,
                             char *buf, NvU32 size)
 {
+    if (HadesIsVrrEmp(pPacket, len, pb1)) {
+        nvkms_snprintf(buf, size,
+                       "extended metadata packet of HDMI VRR (VTEM: VRR %s, base refresh rate %u Hz)",
+                       (pPacket[pb1 + 7] & 0x01) ? "on" : "off",
+                       ((NvU32)(pPacket[pb1 + 9] & 0x03) << 8) | pPacket[pb1 + 10]);
+        return;
+    }
+
     switch (pPacket[0]) {
     case 0x81:
         if (len >= pb1 + 3) {
@@ -231,10 +256,11 @@ void nvHadesLogHdmiPacket(const NVDispEvoRec *pDispEvo,
     const NVConnectorEvoRec *pConnectorEvo;
     struct NvHadesInfoFrameLog *pLog;
     char where[32];
-    char what[64];
+    char what[96];
     char hex[3 * NV_HADES_INFOFRAME_LOG_BYTES + 1];
     NvU32 len, i;
     NvU64 now;
+    NvBool vtem;
 
     if ((sd >= NVKMS_MAX_SUBDEVICES) || (head >= NV_MAX_HEADS) ||
         (slot >= NV_HADES_INFOFRAME_LOG_SLOTS)) {
@@ -257,9 +283,21 @@ void nvHadesLogHdmiPacket(const NVDispEvoRec *pDispEvo,
     }
 
     now = nvkms_get_usec();
+    vtem = (pPacket != NULL) && HadesIsVrrEmp(pPacket, len, pb1);
+    if (vtem && ((now - pLog->vtemMinuteUs) >= 60000000ULL)) {
+        pLog->vtemMinuteUs = now;
+        pLog->vtemLines = 0;
+    }
     if ((pPacket != NULL) && pLog->on && HadesSameDynamicPacket(pLog, pPacket, len, pb1) &&
-        ((now - pLog->lastUs) < 60000000ULL)) {
-        /* the same vendor-specific InfoFrame again within a minute: counted */
+        (vtem ? (pLog->vtemLines >= NV_HADES_INFOFRAME_LOG_VTEM_LINES) :
+                ((now - pLog->lastUs) < 60000000ULL))) {
+        /*
+         * the same vendor-specific InfoFrame again within a minute, or a VTEM
+         * past the lines of its minute: counted. Each change of the VTEM is
+         * said otherwise: whether HDMI VRR is on is what tells two modes of a
+         * display apart (issue 4 of Hades: Dolby Vision at 60 Hz and not at
+         * 50 on a display whose VRR starts at 48 Hz).
+         */
         if (pLog->notShown < 0xFFFF) {
             pLog->notShown++;
         }
@@ -268,6 +306,10 @@ void nvHadesLogHdmiPacket(const NVDispEvoRec *pDispEvo,
         return;
     }
 
+    if (vtem) {
+        pLog->vtemLines++;
+    }
+
     if (pDevEvo->hadesInfoFrameLogLines < NV_HADES_INFOFRAME_LOG_LINES) {
         pConnectorEvo = pDispEvo->headState[head].pConnectorEvo;
         HadesSlotName(name, where, sizeof(where));
-- 
