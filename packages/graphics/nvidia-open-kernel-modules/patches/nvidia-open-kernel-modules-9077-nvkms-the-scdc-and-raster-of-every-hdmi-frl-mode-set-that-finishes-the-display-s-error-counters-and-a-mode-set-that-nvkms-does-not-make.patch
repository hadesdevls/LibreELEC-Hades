From 1bf6e3aba9d8f96e1537e81f6a824854e6b31e0f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 20:12:52 +0000
Subject: [PATCH] nvkms: the SCDC and raster of every HDMI FRL mode set that
 finishes, the display's error counters, and a mode set that NVKMS does not
 make

An RTX 4080 SUPER (driver 620.70.06, an
LG C5) hung once in seven changes of mode from the TMDS mode of a video to
3840x2160 at 120 Hz over HDMI FRL at 4 lanes of 8 Gb/s, as it did three
times in 31 with 1.0. The lines of 9072 said it: the link trained at the
first try in 180 ms, and one second and three seconds after the update
went out the raster of the head stood at line 0 while the display said
over SCDC Update_0 0x43 (Status_Update, CED_Update and RSED_Update),
FRL_Rate 4 and Status_Flags 0x5e (lanes 0 to 3 locked, FLT_ready).
Training the link again inside FRL flush mode did not bring it back. What
those registers say of a mode set that went well is not in any log, nor
what the counters of errors that CED_Update and RSED_Update point at
hold; and the next mode sets that Kodi made were refused (nvidia-drm:
"Failed to apply atomic modeset. Error code: -22"), with NVKMS's reasons
said only at debug level.

What NVKMS does in such a mode set was read in full (nvkms-modeset.c: the
head shut down in an update of its own before a mode set over FRL,
KickoffProposedModeSetStateIncompatibleApiHeadsShutDown(); the link
trained in the pre-update of the head, nvHdmiFrlSetConfig(), after its
methods are queued and before they go out; the update of the new mode
right after it, KickoffProposedModeSetHwState()). The open code has no
step that is missing or that races there: the start of the head is the
work of the display engine's supervisor, which RM handles in the part of
the driver that NVIDIA keeps closed, and no control of RM restarts a head
while its update waits. So this says more, to tell the causes apart:

- At the end of each mode set whose update the display engine finished,
  each HDMI FRL head of it gets the same line as at a stall (its raster,
  three looks 2 ms apart; what its display says over SCDC), as INFO: the
  reference that the line of a stall is read against. About 4 ms of looks
  and 16 reads of SCDC through RM, once a mode set, only over FRL.
- That line, and the line of a stall, also say Status_Update, CED_Update
  and RSED_Update of Update_0, and the display's error counters: the
  characters in error on each of lanes 0 to 3 (SCDC 0x50 to 0x57) and the
  Reed-Solomon corrections over FRL (0x59, 0x5A), each with its valid bit.
- A mode set that nvidia-drm commits and NVKMS does not make is said as a
  warning, with NVKMS's status, the disp's and each head's that has one
  (KmsSetMode() of the KAPI), or that the ioctl did not run (its power
  management lock is only tried).

The new SCDC fields are macros of nvkms-hades.h (NV_HADES_SCDC_UPDATE_0_STATUS,
_CED, _RSED, NV_HADES_SCDC_CED_COUNT, NV_HADES_SCDC_CED_VALID). A host test
built against the header of this tree (13 checks, on the Update_0 of the
C5 at the stall and on made-up counters) passes, does not build against
the header before this change, and fails on each of 6 mutations of the
macros. The five modules build against Linux 7.3.5 with the compiler of
the image, without a new warning. Not run on a GPU: nothing changes in
what the driver does, only what it says.
---
 src/nvidia-modeset/include/nvkms-hades.h | 15 +++++
 src/nvidia-modeset/kapi/src/nvkms-kapi.c | 35 ++++++++++++
 src/nvidia-modeset/src/nvkms-hdmi.c      | 72 ++++++++++++++++++++----
 3 files changed, 110 insertions(+), 12 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index b662056..93173d0 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -1205,5 +1205,20 @@ nvHadesRasterOfLooks(const NvU16 *pLines, const NvBool *pInBlanking, NvU32 looks
 #define NV_HADES_SCDC_STATUS_0_CLOCK(v)         ((v) & 1)
 #define NV_HADES_SCDC_STATUS_0_LANES_LOCKED(v)  (((v) >> 1) & 0xf)
 #define NV_HADES_SCDC_STATUS_0_FLT_READY(v)     (((v) >> 6) & 1)
+/* ... and what else Update_0 says changed: Status_Update bit 0, CED_Update bit 1, RSED_Update bit 6 */
+#define NV_HADES_SCDC_UPDATE_0_STATUS(v)        ((v) & 1)
+#define NV_HADES_SCDC_UPDATE_0_CED(v)           (((v) >> 1) & 1)
+#define NV_HADES_SCDC_UPDATE_0_RSED(v)          (((v) >> 6) & 1)
+
+/*
+ * Hades: the error counters of an HDMI display (SCDC 0x50 to 0x57: for each of
+ * lanes 0 to 3 a low byte and a high byte, 15 bits of count and, in bit 7 of the
+ * high byte, whether the count is valid; 0x58 their checksum) and its count of
+ * Reed-Solomon corrections over FRL (0x59 and 0x5A, the same way): what
+ * CED_Update and RSED_Update of Update_0 say changed. The kernel log gives them
+ * at a stall of a mode set and at the end of every HDMI FRL mode set (9077).
+ */
+#define NV_HADES_SCDC_CED_VALID(hi)             (((hi) >> 7) & 1)
+#define NV_HADES_SCDC_CED_COUNT(lo, hi)         ((((NvU32)(hi) & 0x7f) << 8) | (NvU32)(lo))
 
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 8974930..01f7b94 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -3754,6 +3754,18 @@ static NvBool KmsSetMode(
         nvKmsKapiLogDeviceDebug(
             device,
             "NVKMS_IOCTL_SET_MODE ioctl failed");
+        /*
+         * Hades: a mode set that is committed and not made is said, with why
+         * where NVKMS says it (nvidia-drm only says "Failed to apply atomic
+         * modeset", -22)
+         */
+        if (commit) {
+            nvEvoLog(EVO_LOG_WARN,
+                     "Hades: [kapi][GPU Id 0x%08x] a mode set was not made: the "
+                     "NVKMS_IOCTL_SET_MODE ioctl did not run or failed (the power "
+                     "management lock was taken, or the request was refused before "
+                     "it ran)", device->gpuId);
+        }
         goto done;
     }
 
@@ -3781,6 +3793,29 @@ static NvBool KmsSetMode(
                 i, params->reply.disp[0].head[i].status);
         }
 
+        /* Hades: ... and one that NVKMS refused, with its statuses */
+        if (commit) {
+            char heads[96];
+            int n = 0;
+
+            heads[0] = '\0';
+            for (i = 0; (i < ARRAY_LEN(params->reply.disp[0].head)) &&
+                        (n < (int)sizeof(heads) - 16); i++) {
+                if (params->reply.disp[0].head[i].status != 0) {
+                    n += nvkms_snprintf(heads + n, sizeof(heads) - n, " head %d: %d",
+                                        i, params->reply.disp[0].head[i].status);
+                }
+            }
+            nvEvoLog(EVO_LOG_WARN,
+                     "Hades: [kapi][GPU Id 0x%08x] a mode set was refused by NVKMS: "
+                     "status %d, disp 0 status %d,%s (enum NvKmsSetModeStatus, "
+                     "NvKmsSetModeOneDispStatus and NvKmsSetModeOneHeadStatus of "
+                     "nvkms-api.h)",
+                     device->gpuId, params->reply.status,
+                     params->reply.disp[0].status,
+                     heads[0] ? heads : " no head with a status");
+        }
+
         status = NV_FALSE;
     }
 
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 9f2c0d9..4c4cf04 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -4341,7 +4341,8 @@ static NvBool HadesReadScdc(const NVDpyEvoRec *pDpyEvo, NvU8 offset, NvU8 *pData
  * "why" names the moment.
  */
 static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
-                                 NvU64 waitedUsec)
+                                 NvU64 waitedUsec, NvU32 headMask,
+                                 NVEvoLogType level)
 {
     NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
     const NVDispEvoRec *pDispEvo = pWait->pDispEvo;
@@ -4351,7 +4352,7 @@ static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
         return;
     }
 
-    FOR_EACH_INDEX_IN_MASK(32, head, pWait->hdmiHeadMask) {
+    FOR_EACH_INDEX_IN_MASK(32, head, headMask) {
         const NVDpyEvoRec *pDpyEvo = pWait->pDpyEvo[head];
         const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
         const NvHadesFrlTraining *pTraining =
@@ -4359,7 +4360,8 @@ static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
         NvU16 lines[3] = { 0, 0, 0 };
         NvBool inBlanking[3] = { TRUE, TRUE, TRUE };
         char raster[64];
-        char scdc[192];
+        char scdc[224];
+        char errors[160];
         char link[96];
         NvU32 i;
 
@@ -4399,13 +4401,43 @@ static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
                 HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_STATUS_FLAGS_1, &st1) &&
                 HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_STATUS_FLAGS_2, &st2);
 
+            NvU8 ced[11];
+            NvBool cedOk = ok;
+
+            for (i = 0; cedOk && (i < 11); i++) {
+                cedOk = HadesReadScdc(pDpyEvo,
+                    (NvU8)(NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_CED_0 + i),
+                    &ced[i]);
+            }
+            if (cedOk) {
+                nvkms_snprintf(errors, sizeof(errors),
+                               "its error counters: lanes 0-3 %u%s %u%s %u%s %u%s, RS "
+                               "corrections %u%s",
+                               NV_HADES_SCDC_CED_COUNT(ced[0], ced[1]),
+                               NV_HADES_SCDC_CED_VALID(ced[1]) ? "" : " (not valid)",
+                               NV_HADES_SCDC_CED_COUNT(ced[2], ced[3]),
+                               NV_HADES_SCDC_CED_VALID(ced[3]) ? "" : " (not valid)",
+                               NV_HADES_SCDC_CED_COUNT(ced[4], ced[5]),
+                               NV_HADES_SCDC_CED_VALID(ced[5]) ? "" : " (not valid)",
+                               NV_HADES_SCDC_CED_COUNT(ced[6], ced[7]),
+                               NV_HADES_SCDC_CED_VALID(ced[7]) ? "" : " (not valid)",
+                               NV_HADES_SCDC_CED_COUNT(ced[9], ced[10]),
+                               NV_HADES_SCDC_CED_VALID(ced[10]) ? "" : " (not valid)");
+            } else {
+                nvkms_snprintf(errors, sizeof(errors),
+                               "its error counters could not be read");
+            }
             if (ok) {
                 nvkms_snprintf(scdc, sizeof(scdc),
-                               "its display says over SCDC: Update_0 0x%02x (FRL_start %u, "
-                               "FLT_update %u), FRL_Rate %u, Status_Flags 0x%02x 0x%02x 0x%02x "
+                               "its display says over SCDC: Update_0 0x%02x (Status_Update %u, "
+                               "CED_Update %u, FRL_start %u, FLT_update %u, RSED_Update %u), "
+                               "FRL_Rate %u, Status_Flags 0x%02x 0x%02x 0x%02x "
                                "(clock %u, lanes locked 0x%x, FLT_ready %u)",
-                               up0, NV_HADES_SCDC_UPDATE_0_FRL_START(up0),
+                               up0, NV_HADES_SCDC_UPDATE_0_STATUS(up0),
+                               NV_HADES_SCDC_UPDATE_0_CED(up0),
+                               NV_HADES_SCDC_UPDATE_0_FRL_START(up0),
                                NV_HADES_SCDC_UPDATE_0_FLT_UPDATE(up0),
+                               NV_HADES_SCDC_UPDATE_0_RSED(up0),
                                NV_HADES_SCDC_CONFIG_1_FRL_RATE(cfg1), st0, st1, st2,
                                NV_HADES_SCDC_STATUS_0_CLOCK(st0),
                                NV_HADES_SCDC_STATUS_0_LANES_LOCKED(st0),
@@ -4415,6 +4447,7 @@ static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
             }
         } else {
             nvkms_snprintf(scdc, sizeof(scdc), "its display has no SCDC");
+            errors[0] = '\0';
         }
 
         if (pWait->frlHeadMask & NVBIT(head)) {
@@ -4428,11 +4461,12 @@ static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
             nvkms_snprintf(link, sizeof(link), "HDMI TMDS");
         }
 
-        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+        nvEvoLogDisp(pDispEvo, level,
                      "Hades: head %u: %s, %u ms after its update went out (%s; VRR in its "
-                     "timings: %s): %s; %s",
+                     "timings: %s): %s; %s%s%s",
                      head, why, (NvU32)(waitedUsec / 1000), link,
-                     HadesVrrTypeName(pHeadState->timings.vrr.type), raster, scdc);
+                     HadesVrrTypeName(pHeadState->timings.vrr.type), raster, scdc,
+                     errors[0] ? "; " : "", errors);
     } FOR_EACH_INDEX_IN_MASK_END;
 }
 
@@ -4550,12 +4584,12 @@ void nvHadesModesetWaitStalled(NVDevEvoRec *pDevEvo, NvBool channelIdle)
         case NV_HADES_MODESET_STALL_LOOK:
             pWait->looked = TRUE;
             HadesModesetWaitLook(pDevEvo, "the display engine has not finished its mode set",
-                                 waited);
+                                 waited, pWait->hdmiHeadMask, EVO_LOG_WARN);
             return;
         case NV_HADES_MODESET_STALL_RETRAIN:
             pWait->looked = TRUE;
             HadesModesetWaitLook(pDevEvo, "the display engine has not finished its mode set",
-                                 waited);
+                                 waited, pWait->hdmiHeadMask, EVO_LOG_WARN);
             HadesModesetWaitRetrain(pDevEvo);
             pWait->retrained = TRUE;
             return;
@@ -4574,7 +4608,8 @@ void nvHadesModesetWaitLost(NVDevEvoRec *pDevEvo)
     HadesModesetWaitLook(pDevEvo,
                          "the display engine did not finish its mode set in NVIDIA's 3 s; "
                          "NVKMS goes on without it and the flips of this head may not come",
-                         nvkms_get_usec() - pWait->startUsec);
+                         nvkms_get_usec() - pWait->startUsec, pWait->hdmiHeadMask,
+                         EVO_LOG_WARN);
 }
 
 void nvHadesModesetWaitEnd(NVDispEvoRec *pDispEvo)
@@ -4595,6 +4630,19 @@ void nvHadesModesetWaitEnd(NVDispEvoRec *pDispEvo)
                          ms,
                          pWait->retrained ? ", its FRL link trained again on the way" : "");
         } FOR_EACH_INDEX_IN_MASK_END;
+
+        /*
+         * Hades: and, for each HDMI FRL head of a mode set that the display
+         * engine finished, the same look as at a stall (its raster, what its
+         * display says over SCDC, its error counters): the reference that the
+         * line of a stall is read against (9077)
+         */
+        if (!pWait->lost && (pWait->frlHeadMask != 0)) {
+            HadesModesetWaitLook(pDevEvo,
+                                 "reference: the display engine finished its mode set",
+                                 nvkms_get_usec() - pWait->startUsec,
+                                 pWait->frlHeadMask, EVO_LOG_INFO);
+        }
     }
     nvHadesModesetWaitReset(pDevEvo);
 }
