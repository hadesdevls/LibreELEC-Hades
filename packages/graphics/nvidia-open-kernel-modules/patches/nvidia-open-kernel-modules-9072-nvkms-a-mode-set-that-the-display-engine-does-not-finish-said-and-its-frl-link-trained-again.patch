diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 48619a5..be4db4c 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -1024,4 +1024,101 @@ static inline NvU32 nvHadesEdidKeptSize(const NvU8 *edid, NvU32 length, NvU32 pa
     return (eeodbSize > parsedSize) ? eeodbSize : parsedSize;
 }
 
+
+/*
+ * Hades: a mode set that the display engine is slow to finish. NVKMS waits for
+ * the core channel's completion notifier of its update (EvoCheckNotifier());
+ * with the channel's methods all fetched (GET == PUT) and no notifier after 3
+ * s, NVIDIA's driver writes the notifier itself, says "Lost display
+ * notification" and goes on as if the update were done. An RTX 4080 SUPER
+ * did that three times, each time at the mode set
+ * from a TMDS mode of a video to 3840x2160 at 120 Hz over HDMI FRL, whose link
+ * had trained; the head's window channel stopped after it and the display never
+ * came back. In 90 HDMI mode sets whose
+ * captured kernel logs time them, the InfoFrames that follow the update went out
+ * 17 to 246 ms after the link trained.
+ *
+ * At 1 s, with the channel's methods all fetched, the stall is looked at once:
+ * the raster of each HDMI head and what its display says over SCDC, and where a
+ * head drives HDMI FRL (and hades_frl_stall_retrain is on), its link is trained
+ * again inside FRL flush mode, the sequence of NVIDIA's HDMI library for a link
+ * that a head drives (performLinkTraningToAssessFRLLink() of nvhdmipkt_C671.c),
+ * with the training that RM may not skip. NVIDIA's wait of 3 s is not made
+ * longer. Before 1 s, with methods still to fetch, or once looked at: wait.
+ */
+#define NV_HADES_MODESET_STALL_USEC 1000000ULL
+
+enum NvHadesModesetStallAction {
+    NV_HADES_MODESET_STALL_WAIT = 0,
+    NV_HADES_MODESET_STALL_LOOK,
+    NV_HADES_MODESET_STALL_RETRAIN,
+};
+
+static inline enum NvHadesModesetStallAction
+nvHadesModesetStallAction(NvU64 waitedUsec,
+                          NvBool channelIdle,
+                          NvBool lookedAlready,
+                          NvBool frlHeads,
+                          NvBool retrainAllowed)
+{
+    if (lookedAlready || !channelIdle ||
+        (waitedUsec < NV_HADES_MODESET_STALL_USEC)) {
+        return NV_HADES_MODESET_STALL_WAIT;
+    }
+    return (frlHeads && retrainAllowed) ? NV_HADES_MODESET_STALL_RETRAIN :
+                                          NV_HADES_MODESET_STALL_LOOK;
+}
+
+/*
+ * Hades: how a head's raster went over three looks at the line it scans
+ * (GetScanLine of the HAL): a line that changes runs it; the same line each
+ * time stands; in blanking at each look says nothing of it.
+ */
+enum NvHadesRaster {
+    NV_HADES_RASTER_RUNS = 0,
+    NV_HADES_RASTER_STANDS,
+    NV_HADES_RASTER_IN_BLANKING,
+};
+
+static inline enum NvHadesRaster
+nvHadesRasterOfLooks(const NvU16 *pLines, const NvBool *pInBlanking, NvU32 looks)
+{
+    NvU32 i, first = looks;
+
+    for (i = 0; i < looks; i++) {
+        if (!pInBlanking[i]) {
+            if (first == looks) {
+                first = i;
+            } else if (pLines[i] != pLines[first]) {
+                return NV_HADES_RASTER_RUNS;
+            }
+        }
+    }
+    if (first == looks) {
+        return NV_HADES_RASTER_IN_BLANKING;
+    }
+    /* active at one look and in blanking at another: it moved */
+    for (i = 0; i < looks; i++) {
+        if (pInBlanking[i]) {
+            return NV_HADES_RASTER_RUNS;
+        }
+    }
+    return NV_HADES_RASTER_STANDS;
+}
+
+/*
+ * Hades: the SCDC registers of an HDMI 2.1 display that the kernel log gives at
+ * a stall (raw, and the fields named here): Update_0 (0x10: FRL_start bit 4,
+ * FLT_update bit 5), Config_1 (0x31: FRL_Rate bits 3:0), Status_Flags_0 (0x40:
+ * Clock_Detected bit 0, lanes 0 to 2 locked bits 1 to 3, lane 3 locked bit 4,
+ * FLT_ready bit 6). Linux's drm_scdc.h defines the TMDS ones (0x10, 0x40 bits 0
+ * to 3); the FRL ones are those of HDMI 2.1.
+ */
+#define NV_HADES_SCDC_UPDATE_0_FRL_START(v)     (((v) >> 4) & 1)
+#define NV_HADES_SCDC_UPDATE_0_FLT_UPDATE(v)    (((v) >> 5) & 1)
+#define NV_HADES_SCDC_CONFIG_1_FRL_RATE(v)      ((v) & 0xf)
+#define NV_HADES_SCDC_STATUS_0_CLOCK(v)         ((v) & 1)
+#define NV_HADES_SCDC_STATUS_0_LANES_LOCKED(v)  (((v) >> 1) & 0xf)
+#define NV_HADES_SCDC_STATUS_0_FLT_READY(v)     (((v) >> 6) & 1)
+
 #endif /* __NVKMS_HADES_H__ */
