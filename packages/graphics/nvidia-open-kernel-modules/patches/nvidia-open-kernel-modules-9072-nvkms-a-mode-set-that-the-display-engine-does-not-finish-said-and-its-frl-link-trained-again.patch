diff --git a/src/nvidia-modeset/src/nvkms-dma.c b/src/nvidia-modeset/src/nvkms-dma.c
index 75e2046..225235a 100644
--- a/src/nvidia-modeset/src/nvkms-dma.c
+++ b/src/nvidia-modeset/src/nvkms-dma.c
@@ -24,6 +24,7 @@
 #include <stddef.h>
 
 #include "nvkms-dma.h"
+#include "nvkms-hdmi.h" /* Hades: nvHadesModesetWaitStalled(), nvHadesModesetWaitLost() */
 #include "nvkms-utils.h"
 #include "nvkms-rmapi.h"
 #include "class/clc57d.h" // NVC57D_{PUT,GET}
@@ -216,12 +217,24 @@ static NvBool EvoCheckNotifier(const NVDispEvoRec *pDispEvo,
             return FALSE;
         }
 
+        /*
+         * Hades: the update of a mode set over HDMI that the display engine is
+         * slow to finish (nvHadesModesetStallAction() in nvkms-hades.h)
+         */
+        if (pDevEvo->hadesModesetWait.pDispEvo == pDispEvo) {
+            nvHadesModesetWaitStalled(pDevEvo, p->put_offset == EvoCoreReadGet(p));
+        }
+
         if (nvExceedsTimeoutUSec(
                 pDevEvo,
                 &startTime,
                 NV_EVO_NOTIFIER_SHORT_TIMEOUT_USEC) &&
             (p->put_offset == EvoCoreReadGet(p)))
         {
+            /* Hades: what its heads and displays looked like then */
+            if (pDevEvo->hadesModesetWait.pDispEvo == pDispEvo) {
+                nvHadesModesetWaitLost(pDevEvo);
+            }
             nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
                          "Lost display notification (%d:0x%08x); "
                          "continuing.", sd, val);
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 8bdc6f6..9f2c0d9 100644
