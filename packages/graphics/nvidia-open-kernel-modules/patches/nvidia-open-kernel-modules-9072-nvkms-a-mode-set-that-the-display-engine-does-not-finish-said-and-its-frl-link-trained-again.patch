+/*
+ * Hades: the update of a mode set that NVKMS waits for, and what is done when
+ * the display engine is slow to finish it (nvHadesModesetStallAction() in
+ * nvkms-hades.h says why and when). The heads are those whose mode set drives
+ * HDMI (nvHadesModesetWaitAddHead(), from the pre-update of the head);
+ * nvHadesModesetWaitBegin() and nvHadesModesetWaitEnd() bracket the kick-off of
+ * the update of the mode set (KickoffProposedModeSetHwState()), and
+ * EvoCheckNotifier() calls the other two while it waits in between.
+ */
+void nvHadesModesetWaitReset(NVDevEvoRec *pDevEvo)
+{
+    nvkms_memset(&pDevEvo->hadesModesetWait, 0,
+                 sizeof(pDevEvo->hadesModesetWait));
+}
+
+void nvHadesModesetWaitAddHead(NVDispEvoRec *pDispEvo, NvU32 head,
+                               const NVDpyEvoRec *pDpyEvo)
+{
+    NvHadesModesetWait *pWait = &pDispEvo->pDevEvo->hadesModesetWait;
+
+    if (head >= NV_MAX_HEADS) {
+        return;
+    }
+    if (pWait->pDispEvo != pDispEvo) {
+        nvHadesModesetWaitReset(pDispEvo->pDevEvo);
+        pWait->pDispEvo = pDispEvo;
+    }
+    pWait->pDpyEvo[head] = pDpyEvo;
+    pWait->hdmiHeadMask |= NVBIT(head);
+    if (pDispEvo->headState[head].timings.protocol ==
+            NVKMS_PROTOCOL_SOR_HDMI_FRL) {
+        pWait->frlHeadMask |= NVBIT(head);
+    }
+}
+
+void nvHadesModesetWaitBegin(NVDispEvoRec *pDispEvo)
+{
+    NvHadesModesetWait *pWait = &pDispEvo->pDevEvo->hadesModesetWait;
+
+    if (pWait->pDispEvo != pDispEvo) {
+        return;
+    }
+    pWait->startUsec = nvkms_get_usec();
+    pWait->looked = FALSE;
+    pWait->retrained = FALSE;
+    pWait->lost = FALSE;
+}
+
+static const char *HadesVrrTypeName(enum NvKmsCurrentVrrType type)
+{
+    switch (type) {
+        case NVKMS_VRR_TYPE_GAMING: return "gaming";
+        case NVKMS_VRR_TYPE_MEDIA:  return "media";
+        case NVKMS_VRR_TYPE_NONE:
+        default:                    return "none";
+    }
+}
+
+/* Hades: one SCDC register of an HDMI display, through RM; FALSE if not read */
+static NvBool HadesReadScdc(const NVDpyEvoRec *pDpyEvo, NvU8 offset, NvU8 *pData)
+{
+    const NVDispEvoRec *pDispEvo = pDpyEvo->pDispEvo;
+    NV0073_CTRL_SPECIFIC_GET_HDMI_SCDC_DATA_PARAMS params;
+
+    nvkms_memset(&params, 0, sizeof(params));
+    params.subDeviceInstance = pDispEvo->displayOwner;
+    params.displayId = nvDpyIdToNvU32(pDpyEvo->pConnectorEvo->displayId);
+    params.offset = offset;
+
+    if (nvRmApiControl(nvEvoGlobal.clientHandle,
+                       pDispEvo->pDevEvo->displayCommonHandle,
+                       NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA,
+                       &params, sizeof(params)) != NVOS_STATUS_SUCCESS) {
+        return FALSE;
+    }
+    *pData = params.data;
+    return TRUE;
+}
+
+/*
+ * Hades: one line for each HDMI head of the mode set that waits: its raster
+ * (three looks 2 ms apart) and, where its display has SCDC, what that says;
+ * "why" names the moment.
+ */
+static void HadesModesetWaitLook(NVDevEvoRec *pDevEvo, const char *why,
+                                 NvU64 waitedUsec)
+{
+    NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
+    const NVDispEvoRec *pDispEvo = pWait->pDispEvo;
+    NvU32 head;
+
+    if (pDispEvo == NULL) {
+        return;
+    }
+
+    FOR_EACH_INDEX_IN_MASK(32, head, pWait->hdmiHeadMask) {
+        const NVDpyEvoRec *pDpyEvo = pWait->pDpyEvo[head];
+        const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+        const NvHadesFrlTraining *pTraining =
+            &pDevEvo->hadesFrlTraining[pDispEvo->displayOwner][head];
+        NvU16 lines[3] = { 0, 0, 0 };
+        NvBool inBlanking[3] = { TRUE, TRUE, TRUE };
+        char raster[64];
+        char scdc[192];
+        char link[96];
+        NvU32 i;
+
+        if (pDevEvo->hal->GetScanLine != NULL) {
+            for (i = 0; i < 3; i++) {
+                pDevEvo->hal->GetScanLine(pDispEvo, head, &lines[i], &inBlanking[i]);
+                if (i < 2) {
+                    nvkms_usleep(2000);
+                }
+            }
+            switch (nvHadesRasterOfLooks(lines, inBlanking, 3)) {
+                case NV_HADES_RASTER_RUNS:
+                    nvkms_snprintf(raster, sizeof(raster), "its raster runs (lines %u, %u, %u)",
+                                   lines[0], lines[1], lines[2]);
+                    break;
+                case NV_HADES_RASTER_STANDS:
+                    nvkms_snprintf(raster, sizeof(raster), "its raster stands at line %u",
+                                   lines[0]);
+                    break;
+                case NV_HADES_RASTER_IN_BLANKING:
+                default:
+                    nvkms_snprintf(raster, sizeof(raster),
+                                   "its raster was in blanking at each of 3 looks");
+                    break;
+            }
+        } else {
+            nvkms_snprintf(raster, sizeof(raster), "its raster not looked at");
+        }
+
+        if ((pDpyEvo != NULL) && pDpyEvo->parsedEdid.valid &&
+            pDpyEvo->parsedEdid.info.hdmiForumInfo.scdc_present) {
+            NvU8 up0 = 0, cfg1 = 0, st0 = 0, st1 = 0, st2 = 0;
+            const NvBool ok =
+                HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_UPDATE_FLAGS_0, &up0) &&
+                HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_CONFIGURATION_1, &cfg1) &&
+                HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_STATUS_FLAGS_0, &st0) &&
+                HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_STATUS_FLAGS_1, &st1) &&
+                HadesReadScdc(pDpyEvo, NV0073_CTRL_CMD_SPECIFIC_GET_HDMI_SCDC_DATA_OFFSET_STATUS_FLAGS_2, &st2);
+
+            if (ok) {
+                nvkms_snprintf(scdc, sizeof(scdc),
+                               "its display says over SCDC: Update_0 0x%02x (FRL_start %u, "
+                               "FLT_update %u), FRL_Rate %u, Status_Flags 0x%02x 0x%02x 0x%02x "
+                               "(clock %u, lanes locked 0x%x, FLT_ready %u)",
+                               up0, NV_HADES_SCDC_UPDATE_0_FRL_START(up0),
+                               NV_HADES_SCDC_UPDATE_0_FLT_UPDATE(up0),
+                               NV_HADES_SCDC_CONFIG_1_FRL_RATE(cfg1), st0, st1, st2,
+                               NV_HADES_SCDC_STATUS_0_CLOCK(st0),
+                               NV_HADES_SCDC_STATUS_0_LANES_LOCKED(st0),
+                               NV_HADES_SCDC_STATUS_0_FLT_READY(st0));
+            } else {
+                nvkms_snprintf(scdc, sizeof(scdc), "its display's SCDC could not be read");
+            }
+        } else {
+            nvkms_snprintf(scdc, sizeof(scdc), "its display has no SCDC");
+        }
+
+        if (pWait->frlHeadMask & NVBIT(head)) {
+            nvkms_snprintf(link, sizeof(link),
+                           "HDMI FRL, its link trained %u ms before the update went out%s",
+                           (pTraining->doneUsec != 0 && pWait->startUsec >= pTraining->doneUsec) ?
+                               (NvU32)((pWait->startUsec - pTraining->doneUsec) / 1000) : 0,
+                           pTraining->skipped ? " (RM skipped the training)" :
+                           pTraining->fake ? " (it did not train)" : "");
+        } else {
+            nvkms_snprintf(link, sizeof(link), "HDMI TMDS");
+        }
+
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: head %u: %s, %u ms after its update went out (%s; VRR in its "
+                     "timings: %s): %s; %s",
+                     head, why, (NvU32)(waitedUsec / 1000), link,
+                     HadesVrrTypeName(pHeadState->timings.vrr.type), raster, scdc);
+    } FOR_EACH_INDEX_IN_MASK_END;
+}
+
+/* Hades: the FRL rate of a head as RM's SET_HDMI_FRL_CONFIG takes it */
+static NvU32 HadesNv0073FrlRate(HDMI_FRL_DATA_RATE rate)
+{
+    switch (rate) {
+        case HDMI_FRL_DATA_RATE_3LANES_3GBPS:  return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_3LANES_3G;
+        case HDMI_FRL_DATA_RATE_3LANES_6GBPS:  return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_3LANES_6G;
+        case HDMI_FRL_DATA_RATE_4LANES_6GBPS:  return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_4LANES_6G;
+        case HDMI_FRL_DATA_RATE_4LANES_8GBPS:  return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_4LANES_8G;
+        case HDMI_FRL_DATA_RATE_4LANES_10GBPS: return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_4LANES_10G;
+        case HDMI_FRL_DATA_RATE_4LANES_12GBPS: return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_4LANES_12G;
+        default:                               return NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_NONE;
+    }
+}
+
+static NvBool HadesFrlFlushMode(const NVDispEvoRec *pDispEvo, NvU32 displayId,
+                                NvBool enable)
+{
+    NV0073_CTRL_SPECIFIC_SET_HDMI_FRL_FLUSH_MODE_PARAMS params;
+
+    nvkms_memset(&params, 0, sizeof(params));
+    params.subDeviceInstance = pDispEvo->displayOwner;
+    params.displayId = displayId;
+    params.bEnable = enable;
+
+    return nvRmApiControl(nvEvoGlobal.clientHandle,
+                          pDispEvo->pDevEvo->displayCommonHandle,
+                          NV0073_CTRL_CMD_SPECIFIC_SET_HDMI_FRL_FLUSH_MODE,
+                          &params, sizeof(params)) == NVOS_STATUS_SUCCESS;
+}
+
+static NvBool HadesFrlTrain(const NVDispEvoRec *pDispEvo, NvU32 displayId,
+                            NvU32 rate, NvBool fake, NvBool *pSkipped)
+{
+    NV0073_CTRL_SPECIFIC_SET_HDMI_FRL_LINK_CONFIG_PARAMS params;
+
+    nvkms_memset(&params, 0, sizeof(params));
+    params.subDeviceInstance = pDispEvo->displayOwner;
+    params.displayId = displayId;
+    params.data = rate;
+    params.bFakeLt = fake;
+    params.bDoNotSkipLt = NV_TRUE;
+    params.bLinkAssessmentOnly = NV_FALSE;
+
+    if (nvRmApiControl(nvEvoGlobal.clientHandle,
+                       pDispEvo->pDevEvo->displayCommonHandle,
+                       NV0073_CTRL_CMD_SPECIFIC_SET_HDMI_FRL_CONFIG,
+                       &params, sizeof(params)) != NVOS_STATUS_SUCCESS) {
+        return FALSE;
+    }
+    *pSkipped = params.bLtSkipped;
+    return TRUE;
+}
+
+/*
+ * Hades: train the FRL link of each FRL head of the mode set that waits again,
+ * inside FRL flush mode, with the training that RM may not skip; where it does
+ * not train, the fallback of nvHdmiFrlSetConfig() (bFakeLt), at the same rate
+ */
+static void HadesModesetWaitRetrain(NVDevEvoRec *pDevEvo)
+{
+    NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
+    const NVDispEvoRec *pDispEvo = pWait->pDispEvo;
+    NvU32 head;
+
+    FOR_EACH_INDEX_IN_MASK(32, head, pWait->frlHeadMask) {
+        const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+        const NvU32 displayId = pHeadState->activeRmId;
+        const NvU32 rate = HadesNv0073FrlRate(pHeadState->hdmiFrlConfig.frlRate);
+        const NvU64 start = nvkms_get_usec();
+        NvBool flushOn, trained, fake = FALSE, flushOff, skipped = FALSE;
+
+        if ((displayId == 0) || (rate == NV0073_CTRL_HDMI_FRL_DATA_SET_FRL_RATE_NONE)) {
+            continue;
+        }
+
+        flushOn = HadesFrlFlushMode(pDispEvo, displayId, NV_TRUE);
+        trained = HadesFrlTrain(pDispEvo, displayId, rate, NV_FALSE, &skipped);
+        if (!trained) {
+            fake = HadesFrlTrain(pDispEvo, displayId, rate, NV_TRUE, &skipped);
+        }
+        flushOff = HadesFrlFlushMode(pDispEvo, displayId, NV_FALSE);
+
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: head %u: its FRL link trained again, inside FRL flush mode as "
+                     "NVIDIA's HDMI library does for a link that a head drives, in %u ms: "
+                     "flush mode %s; training %s%s; flush mode %s "
+                     "(nvidia-modeset.hades_frl_stall_retrain=0 leaves this out)",
+                     head, (NvU32)((nvkms_get_usec() - start) / 1000),
+                     flushOn ? "entered" : "refused",
+                     trained ? "done" : (fake ? "refused, forced on the GPU side (bFakeLt)" :
+                                                "refused, also forced"),
+                     (trained && skipped) ? " (RM says it skipped it)" : "",
+                     flushOff ? "left" : "not left");
+    } FOR_EACH_INDEX_IN_MASK_END;
+}
+
+void nvHadesModesetWaitStalled(NVDevEvoRec *pDevEvo, NvBool channelIdle)
+{
+    NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
+    const NvU64 waited = nvkms_get_usec() - pWait->startUsec;
+
+    if ((pWait->pDispEvo == NULL) || (pWait->hdmiHeadMask == 0) ||
+        (pWait->startUsec == 0)) {
+        return;
+    }
+
+    switch (nvHadesModesetStallAction(waited, channelIdle, pWait->looked,
+                                      pWait->frlHeadMask != 0,
+                                      nvkms_hades_frl_stall_retrain())) {
+        case NV_HADES_MODESET_STALL_WAIT:
+            return;
+        case NV_HADES_MODESET_STALL_LOOK:
+            pWait->looked = TRUE;
+            HadesModesetWaitLook(pDevEvo, "the display engine has not finished its mode set",
+                                 waited);
+            return;
+        case NV_HADES_MODESET_STALL_RETRAIN:
+            pWait->looked = TRUE;
+            HadesModesetWaitLook(pDevEvo, "the display engine has not finished its mode set",
+                                 waited);
+            HadesModesetWaitRetrain(pDevEvo);
+            pWait->retrained = TRUE;
+            return;
+    }
+}
+
+void nvHadesModesetWaitLost(NVDevEvoRec *pDevEvo)
+{
+    NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
+
+    if ((pWait->pDispEvo == NULL) || (pWait->hdmiHeadMask == 0) ||
+        (pWait->startUsec == 0) || pWait->lost) {
+        return;
+    }
+    pWait->lost = TRUE;
+    HadesModesetWaitLook(pDevEvo,
+                         "the display engine did not finish its mode set in NVIDIA's 3 s; "
+                         "NVKMS goes on without it and the flips of this head may not come",
+                         nvkms_get_usec() - pWait->startUsec);
+}
+
+void nvHadesModesetWaitEnd(NVDispEvoRec *pDispEvo)
+{
+    NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    NvHadesModesetWait *pWait = &pDevEvo->hadesModesetWait;
+    NvU32 head;
+
+    if ((pWait->pDispEvo == pDispEvo) && (pWait->startUsec != 0)) {
+        const NvU32 ms = (NvU32)((nvkms_get_usec() - pWait->startUsec) / 1000);
+
+        FOR_EACH_INDEX_IN_MASK(32, head, pWait->hdmiHeadMask) {
+            nvEvoLogDisp(pDispEvo, pWait->lost ? EVO_LOG_WARN : EVO_LOG_INFO,
+                         "Hades: head %u: %s %u ms after its update went out%s",
+                         head,
+                         pWait->lost ? "the display engine had not finished its mode set" :
+                                       "the display engine finished its mode set",
+                         ms,
+                         pWait->retrained ? ", its FRL link trained again on the way" : "");
+        } FOR_EACH_INDEX_IN_MASK_END;
+    }
+    nvHadesModesetWaitReset(pDevEvo);
+}
