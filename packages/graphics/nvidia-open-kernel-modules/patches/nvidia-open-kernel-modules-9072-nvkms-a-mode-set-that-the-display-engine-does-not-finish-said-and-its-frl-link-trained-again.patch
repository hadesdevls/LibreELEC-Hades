+void nvHadesModesetWaitReset(NVDevEvoRec *pDevEvo);
+void nvHadesModesetWaitAddHead(NVDispEvoRec *pDispEvo, NvU32 head,
+                               const NVDpyEvoRec *pDpyEvo);
+void nvHadesModesetWaitBegin(NVDispEvoRec *pDispEvo);
+void nvHadesModesetWaitEnd(NVDispEvoRec *pDispEvo);
+void nvHadesModesetWaitStalled(NVDevEvoRec *pDevEvo, NvBool channelIdle);
+void nvHadesModesetWaitLost(NVDevEvoRec *pDevEvo);
 void nvHadesLogHdmiLink(const NVDispEvoRec *pDispEvo,
                         NvU32 head,
                         const NVDpyEvoRec *pDpyEvo,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index ef32c6c..7411dad 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1017,6 +1017,36 @@ typedef struct _NVDisplaylessWorkerRec {
 /* the lines a minute that the EMP of HDMI VRR (VTEM) of one slot may have */
 #define NV_HADES_INFOFRAME_LOG_VTEM_LINES 8
 
+/*
+ * Hades: how the FRL link of a head trained in its last mode set
+ * (nvHdmiFrlSetConfig()): calls of NvHdmi_SetFRLConfig() (1 at the first try, 0
+ * without FRL), how long they took, whether RM skipped the training of the one
+ * it took, and whether none took and the fallback with bFakeLt went out
+ */
+typedef struct NvHadesFrlTraining {
+    NvU32  tries;
+    NvU32  usec;
+    NvBool skipped;
+    NvBool fake;
+    NvU64  doneUsec;
+} NvHadesFrlTraining;
+
+/*
+ * Hades: the update of a mode set that NVKMS waits for (nvHadesModesetWait*()):
+ * the disp, its heads that drive HDMI and those of them over FRL, the display
+ * of each, when the update went out, and how far its stall went
+ */
+typedef struct NvHadesModesetWait {
+    const struct _NVDispEvoRec *pDispEvo;
+    const struct _NVDpyEvoRec  *pDpyEvo[NV_MAX_HEADS];
+    NvU32  hdmiHeadMask;
+    NvU32  frlHeadMask;
+    NvU64  startUsec;
+    NvBool looked;
+    NvBool retrained;
+    NvBool lost;
+} NvHadesModesetWait;
+
 struct NvHadesInfoFrameLog {
     NvU64 lastUs;
     NvU64 vtemMinuteUs; /* when the minute of the VTEM lines began */
@@ -1408,6 +1438,13 @@ typedef struct _NVEvoDevRec {
     struct NvHadesInfoFrameLog
         hadesInfoFrameLog[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS][NV_HADES_INFOFRAME_LOG_SLOTS];
     NvU32 hadesInfoFrameLogLines;
+
+    /*
+     * Hades: how the FRL link of each head trained in its last mode set, and
+     * the update of a mode set that NVKMS waits for (nvkms-hdmi.c)
+     */
+    NvHadesFrlTraining hadesFrlTraining[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+    NvHadesModesetWait hadesModesetWait;
 } NVDevEvoRec;
 
 /*
