From c1da1c8cfc8a52c4da91a7edb847f4dfbe9f16b1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:38:08 +0000
Subject: [PATCH 2/2] nvkms: tell RM of a head that can extend its vblank only
 where its timings have VRR, as driver 615 did

At each mode set nvEnableVrr() tells RM, for each active head, whether it
drives a display that can extend its vblank (NV0073_CTRL_CMD_SYSTEM_VRR_DISPLAY_INFO),
so that RM can switch the memory clock in an extended vblank. The comment of
NVKMS there says which heads: all G-SYNC displays, but only the Adaptive-Sync
displays that the mode set put into Adaptive-Sync mode. Driver 615 did that,
by the head's timings. Driver 620 asks the display instead
(pDpyEvo->vrr.type), and so tells RM of every head of a display that declares
VRR, also where the timings of the mode set have none: below 50 Hz (every
film at 23.976 Hz, Dolby Vision or not), below 110 % of the display's VRR
minimum, or where the client left HDMI VRR off (NV_HDMI_VRR_OFF). RM's side
of it is closed; what RM does with such a head is not known.

It matters because of a fault that only driver 620 shows here: on an RTX 4080
SUPER with an LG C5, the change of mode from a TMDS video mode back to
3840x2160 at 120 Hz over FRL did not finish 3 times in 31 on one day with
620.70.06 ("Lost display notification", then "Error while waiting for GPU
progress"), and never in about 28 such returns with 615.78.08. That proves
nothing about this change, which is one of the differences between the two.

The rule of the comment is taken back (nvHadesVrrHeadForRm(): a G-SYNC
display always, an Adaptive-Sync one where the head's timings have VRR), with
a module parameter, nvidia-modeset.hades_vrr_rm_by_timings: on by default,
0 for driver 620's rule, writable by root and read at each mode set, so that
a test can tell the two apart. Where the rule leaves out a head that driver
620 would tell RM of, the kernel log says so, once per mode set of that head.
Nothing else changes: what the head sends, its timings and the EMP of HDMI
VRR are the same.

Checked with a host test of nvHadesVrrHeadForRm() (its 16 combinations
against the rule written out, and driver 620's answer with the parameter
off); each of 5 mutations of it is caught, and the header before this change
does not build the test. The five modules build against Linux 7.3.5 with the
compiler of the image; the patch applies with --fuzz=0 after the series before it, from
nvidia-open-kernel-modules-9072 to 9074. Not run on a GPU.
---
 .../nvidia-modeset/nvidia-modeset-linux.c     | 15 ++++++++++++
 .../nvidia-modeset-os-interface.h             |  1 +
 src/nvidia-modeset/include/nvkms-hades.h      | 23 +++++++++++++++++++
 .../include/nvidia-modeset-os-interface.h     |  1 +
 src/nvidia-modeset/src/nvkms-vrr.c            | 22 +++++++++++++++---
 5 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index c3fcb84..ebc046d 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -143,6 +143,16 @@ MODULE_PARM_DESC(conceal_vrr_caps,
 static bool conceal_vrr_caps = false;
 module_param_named(conceal_vrr_caps, conceal_vrr_caps, bool, 0444);
 
+/*
+ * Hades: NVKMS tells RM that a head can extend its vblank only where the
+ * timings of its mode set have VRR (or the display is a G-SYNC one), as
+ * driver 615 did and as NVKMS's own comment says (nvHadesVrrHeadForRm()).
+ * 0: as driver 620 does, every head of a display that declares VRR. On by
+ * default; writable by root, and read at each mode set.
+ */
+static bool hades_vrr_rm_by_timings = true;
+module_param_named(hades_vrr_rm_by_timings, hades_vrr_rm_by_timings, bool, 0644);
+
 MODULE_PARM_DESC(enhanced_pcon_support,
                  "Enable enhanced display protocol converter features (e.g. VRR over active DP-HDMI converters)");
 static bool enhanced_pcon_support = false;
@@ -244,6 +254,11 @@ NvBool nvkms_conceal_vrr_caps(void)
     return conceal_vrr_caps;
 }
 
+NvBool nvkms_hades_vrr_rm_by_timings(void)
+{
+    return hades_vrr_rm_by_timings;
+}
+
 NvBool nvkms_enhanced_pcon_support(void)
 {
     return enhanced_pcon_support;
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
index 97955fe..3ed7a37 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -119,6 +119,7 @@ enum NvKmsFrlRateForce {
 NvBool nvkms_test_fail_alloc_core_channel(enum NvKmsFailAllocCoreChannelMethod method);
 enum NvKmsFrlRateForce nvkms_force_frl_rate(void);
 NvBool nvkms_conceal_vrr_caps(void);
+NvBool nvkms_hades_vrr_rm_by_timings(void);
 NvBool nvkms_enhanced_pcon_support(void);
 NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 48619a5..0576d2f 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -350,6 +350,29 @@ static inline NvBool nvHadesHdmiVrrLeftOff(NvBool adaptiveSyncDisabled,
     return adaptiveSyncDisabled && allowGsync && hdmiDpy && wouldBeAdaptiveSync;
 }
 
+/*
+ * Whether NVKMS tells RM that a head drives a display that can extend its
+ * vblank (NV0073_CTRL_CMD_SYSTEM_VRR_DISPLAY_INFO, for RM's VRR-based memory
+ * clock switches; nvEnableVrr()). The comment of NVKMS there says: all G-SYNC
+ * displays, but only the Adaptive-Sync displays that the mode set put into
+ * Adaptive-Sync mode. Driver 615 did that, by the timings of the head; driver
+ * 620 tells RM of every head of a display that declares VRR (vrrDisplay),
+ * whose timings may have none (a mode under 50 Hz, under 110 % of the
+ * display's VRR minimum, or one where the client left HDMI VRR off). byTimings
+ * (nvidia-modeset.hades_vrr_rm_by_timings, on by default) takes the rule of
+ * the comment; off, the answer is driver 620's.
+ */
+static inline NvBool nvHadesVrrHeadForRm(NvBool byTimings,
+                                         NvBool gsyncDisplay,
+                                         NvBool vrrTimings,
+                                         NvBool vrrDisplay)
+{
+    if (!byTimings) {
+        return vrrDisplay;
+    }
+    return gsyncDisplay || (vrrDisplay && vrrTimings);
+}
+
 /* What the kernel log says of a refusal (nvHadesHdr10PlusRefusal()) */
 static inline const char *nvHadesHdr10PlusRefusalText(NvU32 refusal)
 {
diff --git a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
index 97955fe..3ed7a37 100644
--- a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
+++ b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
@@ -119,6 +119,7 @@ enum NvKmsFrlRateForce {
 NvBool nvkms_test_fail_alloc_core_channel(enum NvKmsFailAllocCoreChannelMethod method);
 enum NvKmsFrlRateForce nvkms_force_frl_rate(void);
 NvBool nvkms_conceal_vrr_caps(void);
+NvBool nvkms_hades_vrr_rm_by_timings(void);
 NvBool nvkms_enhanced_pcon_support(void);
 NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
diff --git a/src/nvidia-modeset/src/nvkms-vrr.c b/src/nvidia-modeset/src/nvkms-vrr.c
index 2154067..e45a2c9 100644
--- a/src/nvidia-modeset/src/nvkms-vrr.c
+++ b/src/nvidia-modeset/src/nvkms-vrr.c
@@ -29,6 +29,7 @@
 #include "nvkms-vrr.h"
 #include "dp/nvdp-connector-event-sink.h"
 #include "nvkms-dpy.h"
+#include "nvkms-hades.h"
 
 #include <ctrl/ctrl0000/ctrl0000unix.h>
 
@@ -572,9 +573,24 @@ void nvEnableVrr(NVDispEvoRec *pDispEvo, NVEvoUpdateState *updateState)
         // indicates that G-SYNC is allowed) but only Adaptive-Sync
         // displays which put the display into Adaptive-Sync mode by calling
         // nvDPLibSetAdaptiveSync above.
-        TellRMAboutVrrHead(pDispEvo,
-                           pHeadState,
-                           (pDpyEvo->vrr.type != NVKMS_DPY_VRR_TYPE_NONE));
+        //
+        // Hades: by that rule, as driver 615 did, while
+        // nvidia-modeset.hades_vrr_rm_by_timings is on (nvHadesVrrHeadForRm()).
+        {
+            const NvBool vrrDisplay =
+                (pDpyEvo->vrr.type != NVKMS_DPY_VRR_TYPE_NONE);
+            const NvBool told =
+                nvHadesVrrHeadForRm(nvkms_hades_vrr_rm_by_timings(),
+                                    DpyIsGsync(pDpyEvo), vrrEnabled,
+                                    vrrDisplay);
+
+            TellRMAboutVrrHead(pDispEvo, pHeadState, told);
+            if (told != vrrDisplay) {
+                nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                             "Hades: head %u: RM is not told that this head can extend its vblank: the display declares VRR, but the timings of this mode set have none (as driver 615 did; nvidia-modeset.hades_vrr_rm_by_timings=0 tells it, as driver 620 does)",
+                             head);
+            }
+        }
     }
 
     if (!anyEnabledVrrHeads) {
-- 
2.53.0

