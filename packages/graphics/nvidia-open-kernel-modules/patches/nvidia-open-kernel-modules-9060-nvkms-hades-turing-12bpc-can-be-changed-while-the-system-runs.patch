From 7d08be72d067890d5450cf0aec6add5804838adc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 5 Nov 2026 07:51:40 +0000
Subject: [PATCH] nvkms: hades_turing_12bpc can be changed while the system
 runs

The parameter of nvidia-open-kernel-modules-9012 (HDR at 12 bpc over HDMI
on Turing, off by default) could only be given on the kernel command
line. Kodi's setting "HDR at more than 8 bits where the card sends RGB at
8 (NVIDIA)" writes it before the mode set of each HDR video, so it is
writable by root now (0644). NVKMS reads it at each mode set, as before;
nothing else changes.
---
 kernel-open/nvidia-modeset/nvidia-modeset-linux.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index 0f95b2a..95d3e5c 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -101,7 +101,7 @@ module_param_named(max_output_color_depth, max_output_color_depth, uint, 0444);
  * default: NVKMS then sends HDR there at 8 bpc, as NVIDIA's driver does.
  */
 static bool hades_turing_12bpc = false;
-module_param_named(hades_turing_12bpc, hades_turing_12bpc, bool, 0444);
+module_param_named(hades_turing_12bpc, hades_turing_12bpc, bool, 0644);
 
 static bool opportunistic_display_sync = true;
 module_param_named(opportunistic_display_sync, opportunistic_display_sync, bool, 0444);
-- 
2.53.0

