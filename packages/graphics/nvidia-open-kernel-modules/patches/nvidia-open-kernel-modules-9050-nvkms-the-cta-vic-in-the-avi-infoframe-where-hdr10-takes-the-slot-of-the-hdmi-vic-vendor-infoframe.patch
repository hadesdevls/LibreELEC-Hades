From f28f007c2578df4175938f54bd7ed289614fdf29 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:18:20 +0000
Subject: [PATCH] nvkms: the CTA VIC in the AVI InfoFrame where HDR10+ takes
 the slot of the HDMI_VIC vendor InfoFrame

On Turing, Ampere and Ada (the HALs without generic shared InfoFrames) the
HDR InfoFrame goes in the vendor-specific slot and the HDR10+ InfoFrame in
the generic slot (9020), where 9043 puts NVKMS's HDMI_VIC vendor InfoFrame
next to HDR10. In a mode that NVKMS signals by its HDMI_VIC (3840x2160 at 24,
25 and 30 Hz, 4096x2160 at 24 Hz, to a display without UHD_VIC; with Hades'
integer-rate twins also 4096x2160 at 24.000 Hz to one with it) NVKMS's vendor
InfoFrame then went out nowhere, next to an AVI InfoFrame with VIC 0: with
HDR10+ the display was told no format at all.

There the AVI InfoFrame now carries the CTA VIC of the format (95, 94 and 93
for 3840x2160 at 30, 25 and 24 Hz, 98 for 4096x2160 at 24 Hz, with no
picture aspect for 98, which is 256:135, as NVKMS builds the AVI InfoFrame of
VIC 98), as NVKMS signals these formats to a display that says UHD_VIC, as
Hades has i915 do for HDR10+ (linux-9982) and as Amlogic sends HDR10+ next to
them; and NVKMS's own vendor InfoFrame goes out in no slot while it does, as
for that CTA mode, so that the two never both name the format
(nvHadesHdr10PlusAviCtaVic()). Only:
- in a mode of NVKMS's own vendor InfoFrame with an HDMI_VIC, with no
  client's vendor InfoFrame but an HDR10+ one (Dolby Vision, the Dolby Vision
  signalling of HDMI 1.4b and 3D keep their own signalling);
- to an HDMI 2.0 sink (SCDC_Present in its HF-VSDB) that lists that CTA VIC
  in a video data block and declares HDR10+ (an HDR10+ VSVDB of any
  application version): one that reads the 4K formats by their CTA VIC;
- while the HDR10+ InfoFrame goes out next to the HDR InfoFrame, or where the
  AVI InfoFrame of the head carries that CTA VIC already in the same mode
  (the same CTA VIC at the same pixel clock: "kept"), as i915 keeps it: the
  end of HDR10+, of HDR and of the video change nothing of the signalling
  until the next change of mode, so the AVI InfoFrame does not change in the
  middle of a video, and a video takes no change of signalling it would not
  take without HDR10+.
An HDR10+-only flip that starts HDR10+ in such a mode writes the AVI
InfoFrame too (nvHadesUpdateHdmiHdr10Plus() takes the colour of the head for
it); one that ends it writes nothing more. The kernel log says when the AVI
InfoFrame starts and stops carrying the CTA VIC ("Hades: head N: the AVI
InfoFrame says VIC V for the format of the mode, which NVKMS names by its
HDMI_VIC, so that HDR10+ takes the generic InfoFrame slot (NVKMS's own vendor
InfoFrame goes out in none while it does)"; "Hades: head N: the AVI
InfoFrame and NVKMS's vendor InfoFrame say the mode as NVKMS signals it
again").

Any other display, mode or GPU goes out exactly as before: the LG C5 (UHD_VIC,
no HDR10+) among them. On GA10x where RM keeps the generic slot for its ACR
workaround no flip carries HDR10+ (no HDMI route), so nothing changes there.
Blackwell is not concerned: 9049 keeps its vendor-specific slot for NVKMS.

Not run on a GPU; an HDMI 2.0 HDR10+ display without UHD_VIC (or 4096x2160 at
24 Hz) and Turing to Ada are what can show it.

Checked with a host test that runs nvUpdateHdmiInfoFrames() and
nvHadesUpdateHdmiHdr10Plus() of the tree with the EVO1 HAL and the HDMI packet
library on a register file, on the EDID of a Samsung S90H and five variants of
it (no UHD_VIC; VIC 93 not listed; no SCDC; HDR10+ of application version 0;
no HDR10+) and four other displays: the AVI VIC, its picture aspect, the two
slots and the vendor InfoFrame not written, step by step, kept until another
clock or Dolby Vision; against the tree before, every step without HDR10+
the same, and every step of the displays and modes that do not fit.
---
 src/nvidia-modeset/include/nvkms-hades.h |  96 ++++++++++++-
 src/nvidia-modeset/include/nvkms-hdmi.h  |   1 +
 src/nvidia-modeset/include/nvkms-types.h |   9 ++
 src/nvidia-modeset/src/nvkms-dpy.c       |   1 +
 src/nvidia-modeset/src/nvkms-hdmi.c      | 163 ++++++++++++++++++++++-
 src/nvidia-modeset/src/nvkms-hw-flip.c   |   4 +-
 6 files changed, 267 insertions(+), 7 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 2f08c54..8ddc62d 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -483,7 +483,9 @@ static inline NvBool nvHadesDolbyHdmi14bAviVic0(const NvU8 *payload,
  *    what such a display gets from NVKMS on the HALs with generic shared
  *    InfoFrames, and from Linux: an AVI VIC of 0, the HDMI vendor InfoFrame
  *    with the HDMI_VIC, and the HDR InfoFrame (drm_mode_cea_vic(),
- *    drm_hdmi_vendor_infoframe_from_display_mode()).
+ *    drm_hdmi_vendor_infoframe_from_display_mode()). Not where the AVI
+ *    InfoFrame carries the CTA VIC of the mode for HDR10+ (aviCtaVic,
+ *    nvHadesHdr10PlusAviCtaVic()): NVKMS's vendor one goes out nowhere then.
  * An HDR10+ InfoFrame goes in its slot (nvHadesHdr10PlusHdmiSlot()), where a
  * vendor InfoFrame in the generic slot holds that slot as the EMP does:
  * shared generic slot 2 on AD10x, none on Turing and Ampere; and in none
@@ -516,7 +518,8 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
                                                        NvBool hdmiVrrEmp,
                                                        NvBool rmGeneric,
                                                        NvBool adaSharedGenerics,
-                                                       NvBool uhdVic)
+                                                       NvBool uhdVic,
+                                                       NvBool aviCtaVic)
 {
     struct NvHadesHdmiSlots s;
 
@@ -542,7 +545,8 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
         }
         break;
     case NV_HADES_VENDOR_NVKMS_2D:
-        if (hdrSink && hdrEnabled && !uhdVic && !hdmiVrrEmp && !rmGeneric && !hdr10Plus) {
+        if (hdrSink && hdrEnabled && !uhdVic && !hdmiVrrEmp && !rmGeneric && !hdr10Plus &&
+            !aviCtaVic) {
             s.vendorGeneric = NV_TRUE;
         }
         break;
@@ -565,6 +569,92 @@ static inline struct NvHadesHdmiSlots nvHadesHdmiSlots(NvU32 vendor,
     return s;
 }
 
+/*
+ * HDR10+ in a mode that NVKMS signals by its HDMI_VIC (4K at 24, 25 and 30 Hz
+ * from the HDMI VSDB, 4096x2160 at 24 Hz; NV_HADES_VENDOR_NVKMS_2D), on the
+ * HALs without generic shared InfoFrames (Turing, Ampere, Ada). The HDR
+ * InfoFrame takes the vendor-specific slot and the HDR10+ one the generic
+ * slot (nvHadesHdmiSlots()), so NVKMS's own vendor InfoFrame, the one that
+ * names the format, goes out nowhere, next to an AVI InfoFrame with VIC 0:
+ * the display is told no format at all. There the AVI InfoFrame carries the
+ * CTA VIC of the format instead (95, 94 and 93 for 3840x2160 at 30, 25 and
+ * 24 Hz, 98 for 4096x2160 at 24 Hz), as NVKMS signals these formats to a
+ * display whose HF-VSDB says UHD_VIC, as Hades has i915 do for HDR10+
+ * (intel_hdr10plus_cta_vic() of linux-9982), and as Amlogic sends HDR10+ next
+ * to them; and NVKMS's own vendor InfoFrame goes out in no slot while it does,
+ * so that the two never both name the format. Only:
+ *  - in a mode of NVKMS's own vendor InfoFrame with an HDMI_VIC (ownHdmiVic, 1
+ *    to 4), with no client's vendor InfoFrame but an HDR10+ one (clientVsif:
+ *    Dolby Vision or 3D keep their own signalling, as before);
+ *  - to an HDMI 2.0 sink (hdmi2: SCDC_Present in its HF-VSDB) that lists that
+ *    CTA VIC in a video data block (listed) and declares HDR10+ (declares: its
+ *    HDR10+ vendor-specific video data block, of any application version):
+ *    one that reads the 4K formats by their CTA VIC;
+ *  - while the HDR10+ InfoFrame goes out in the generic slot next to the HDR
+ *    InfoFrame (now), or where the AVI InfoFrame of the head carries that CTA
+ *    VIC already in the same mode (kept, nvHadesHdr10PlusCtaVicKept()): the
+ *    end of HDR10+, of HDR and of the video then change nothing of the
+ *    signalling until the next change of mode, as on i915, so that the AVI
+ *    InfoFrame does not change in the middle of a video.
+ * 0 elsewhere: the mode goes out exactly as before.
+ */
+static inline NvU32 nvHadesCtaVicOfHdmiVic(NvU32 hdmiVic)
+{
+    switch (hdmiVic) {
+    case 1:
+        return 95;
+    case 2:
+        return 94;
+    case 3:
+        return 93;
+    case 4:
+        return 98;
+    default:
+        return 0;
+    }
+}
+
+static inline NvU32 nvHadesHdr10PlusAviCtaVic(NvU32 ownHdmiVic,
+                                              NvBool clientVsif,
+                                              NvBool hdmi2,
+                                              NvBool listed,
+                                              NvBool declares,
+                                              NvBool now,
+                                              NvBool kept)
+{
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+
+    if ((ctaVic == 0) || clientVsif || !hdmi2 || !listed || !declares) {
+        return 0;
+    }
+    return (now || kept) ? ctaVic : 0;
+}
+
+/*
+ * kept of nvHadesHdr10PlusAviCtaVic(): the AVI InfoFrame of the head went out
+ * with the CTA VIC heldVic for HDR10+ in a mode of pixel clock heldClockKHz,
+ * and the mode of the head has that CTA VIC and that pixel clock (the same
+ * format at the same rate: 24 and 23.976 Hz are two modes)
+ */
+static inline NvBool nvHadesHdr10PlusCtaVicKept(NvU32 heldVic,
+                                               NvU32 heldClockKHz,
+                                               NvU32 ctaVic,
+                                               NvU32 clockKHz)
+{
+    return (ctaVic != 0) && (heldVic == ctaVic) && (heldClockKHz == clockKHz);
+}
+
+/*
+ * The picture aspect ratio of the AVI InfoFrame with that CTA VIC: VIC 98 is
+ * 256:135, which M1M0 cannot say, so no data, as NVKMS builds the AVI
+ * InfoFrame of VIC 98 (NvTiming_ConstructVideoInfoframeCtrl()); NVKMS's
+ * timing of HDMI_VIC 4 says 16:9. VIC 93 to 95 keep their 16:9.
+ */
+static inline NvBool nvHadesCtaVicAspectNoData(NvU32 ctaVic)
+{
+    return ctaVic == 98;
+}
+
 /*
  * Whether a change of the client's vendor InfoFrame, from (fromSize bytes) to
  * (toSize), each empty or not, is a change of HDR10+ metadata only: a flip
diff --git a/src/nvidia-modeset/include/nvkms-hdmi.h b/src/nvidia-modeset/include/nvkms-hdmi.h
index 03bead3..8bef926 100644
--- a/src/nvidia-modeset/include/nvkms-hdmi.h
+++ b/src/nvidia-modeset/include/nvkms-hdmi.h
@@ -57,6 +57,7 @@ NvBool nvHadesHdr10PlusSetSlot(const NVDispEvoRec *pDispEvo,
                                NvU32 slot);
 void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
+                                const NVDpyAttributeColor *pDpyColor,
                                 const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
                                 NvEvoInfoframeFlipState *flipState,
                                 NvEvoInfoFrameTransmitControl *newTransmitCtrl,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index 75cf0f5..cae15b5 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1351,6 +1351,15 @@ typedef struct _NVEvoDevRec {
      */
     NvU8 hadesVendorGeneric[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
     NvU8 hadesSlotsLogged[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+
+    /*
+     * Hades: the CTA VIC that the AVI InfoFrame of a head carries for HDR10+
+     * in place of the HDMI_VIC of its mode, per display owner and head (0 for
+     * none), and the pixel clock of that mode, in kHz
+     * (nvHadesHdr10PlusAviCtaVic())
+     */
+    NvU8 hadesAviCtaVic[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+    NvU32 hadesAviCtaClock[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
 } NVDevEvoRec;
 
 /*
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 045709a..9781da7 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -3177,6 +3177,7 @@ void nvHadesUpdateHdr10Plus(NVDpyEvoRec *pDpyEvo)
     transmitCtrl.newFid = pApiHeadState->coreFid;
     nvHadesUpdateHdmiHdr10Plus(pDispEvo,
                                head,
+                               &pApiHeadState->attributes.color,
                                &pApiHeadState->infoFrame,
                                &pApiHeadState->infoFrame.flipState,
                                &transmitCtrl,
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 461d675..4ef85d8 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -556,6 +556,14 @@ static NvBool HdmiDolbyLowLatencyAvi(const struct NvKmsHdmiVsifMetadata *pVsif,
     return TRUE;
 }
 
+static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
+                                     const NvU32 head,
+                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                     const NVT_EDID_INFO *pEdidInfo);
+static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
+                               const NvU32 head,
+                               NvU32 ctaVic);
+
 /*
  * SendVideoInfoFrame() - Construct video infoframe using provided EDID and call
  * ->SendHdmiInfoFrame() to send it to RM.
@@ -617,6 +625,24 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
         }
     }
 
+    /*
+     * Hades: HDR10+ in a mode that NVKMS signals by its HDMI_VIC, where the HAL
+     * has no generic shared InfoFrames: the AVI InfoFrame carries the CTA VIC
+     * of the mode (nvHadesHdr10PlusAviCtaVic()), as it does for that CTA mode.
+     */
+    if (!pDevEvo->caps.supportsGenericSharedInfoFrames) {
+        const NvU32 ctaVic =
+            HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+
+        HadesKeepAviCtaVic(pDispEvo, head, ctaVic);
+        if (ctaVic != 0) {
+            videoCtrl.video_format_id = ctaVic;
+            if (nvHadesCtaVicAspectNoData(ctaVic)) {
+                videoCtrl.pic_aspect_ratio = NVT_VIDEO_INFOFRAME_BYTE2_M1M0_NO_DATA;
+            }
+        }
+    }
+
     status = NvTiming_ConstructVideoInfoframe(pEdidInfo,
                                               &videoCtrl,
                                               NULL, &VideoInfoFrame);
@@ -750,7 +776,115 @@ static struct NvHadesHdmiSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
                             nvHadesHdmiVrrEmp(pHeadState),
                             nvHadesHdmiRmGeneric(pDevEvo),
                             pDevEvo->dispClass == NVC770_DISPLAY,
-                            pEdidInfo->hdmiForumInfo.uhd_vic != 0);
+                            pEdidInfo->hdmiForumInfo.uhd_vic != 0,
+                            pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] != 0);
+}
+
+/* Hades: a video data block of the EDID lists the CTA VIC vic */
+static NvBool HadesVdbListsVic(const NVT_EDID_INFO *pEdidInfo, NvU32 vic)
+{
+    const NVT_EDID_CEA861_INFO *exts[2] = { &pEdidInfo->ext861, &pEdidInfo->ext861_2 };
+    NvU32 e, i;
+
+    for (e = 0; e < 2; e++) {
+        for (i = 0; (i < exts[e]->total_svd) &&
+                    (i < NVT_CEA861_VIDEO_MAX_DESCRIPTOR); i++) {
+            if (NVT_GET_CTA_8BIT_VIC(exts[e]->video[i]) == vic) {
+                return NV_TRUE;
+            }
+        }
+    }
+    return NV_FALSE;
+}
+
+/*
+ * Hades: the CTA VIC that the AVI InfoFrame of an HDMI head carries for
+ * HDR10+ in a mode that NVKMS signals by its HDMI_VIC
+ * (nvHadesHdr10PlusAviCtaVic()); 0 for the VIC that NVKMS puts there. Only
+ * where the HAL has no generic shared InfoFrames.
+ */
+static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
+                                     const NvU32 head,
+                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                     const NVT_EDID_INFO *pEdidInfo)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pHeadState->hdmiVsifMetadata;
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pVendor =
+        &pInfoFrameState->vendorSpecificCtrl;
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
+    const NvBool hdr10Plus = nvHadesIsHdr10PlusVsif(pVsif->payload, pVsif->payloadSize);
+    const NvU32 ownHdmiVic =
+        (pVendor->Enable &&
+         (pVendor->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_EXT)) ?
+        pVendor->HDMI_VIC : 0;
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const NvU32 sd = pDispEvo->displayOwner;
+    NvBool now = NV_FALSE;
+
+    if (pDevEvo->caps.supportsGenericSharedInfoFrames || (ctaVic == 0)) {
+        return 0;
+    }
+
+    /* the HDR10+ InfoFrame in the generic slot, the HDR one in the vendor-specific slot */
+    if (hdr10Plus &&
+        (pHeadState->hdrInfoFrame.state == NVKMS_HDR_INFOFRAME_STATE_ENABLED)) {
+        const struct NvHadesHdmiSlots slots =
+            nvHadesHdmiSlots(NV_HADES_VENDOR_NVKMS_2D, NV_TRUE,
+                             pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
+                                 (pHdrInfo->static_metadata_type == 1),
+                             NV_TRUE,
+                             nvHadesHdmiVrrEmp(pHeadState),
+                             nvHadesHdmiRmGeneric(pDevEvo),
+                             pDevEvo->dispClass == NVC770_DISPLAY,
+                             pEdidInfo->hdmiForumInfo.uhd_vic != 0,
+                             NV_FALSE);
+
+        now = slots.hdr && (slots.hdr10PlusSlot != NV_HADES_HDR10PLUS_SLOT_NONE);
+    }
+
+    return nvHadesHdr10PlusAviCtaVic(
+        ownHdmiVic,
+        (pVsif->payloadSize != 0) && !hdr10Plus,
+        pEdidInfo->hdmiForumInfo.scdc_present != 0,
+        HadesVdbListsVic(pEdidInfo, ctaVic),
+        (pEdidInfo->ext861.valid.hdr10Plus != 0) ||
+            (pEdidInfo->ext861_2.valid.hdr10Plus != 0),
+        now,
+        nvHadesHdr10PlusCtaVicKept(pDevEvo->hadesAviCtaVic[sd][head],
+                                   pDevEvo->hadesAviCtaClock[sd][head],
+                                   ctaVic,
+                                   pHeadState->timings.pixelClock));
+}
+
+/*
+ * Hades: the AVI InfoFrame of the head goes out with ctaVic for HDR10+ from
+ * here (0: with the VIC NVKMS puts there), at the pixel clock of its mode; the
+ * kernel log says when that changes.
+ */
+static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
+                               const NvU32 head,
+                               NvU32 ctaVic)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NvU32 sd = pDispEvo->displayOwner;
+    NvU8 *pVic = &pDevEvo->hadesAviCtaVic[sd][head];
+
+    if (*pVic != (NvU8)ctaVic) {
+        if (ctaVic != 0) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u: the AVI InfoFrame says VIC %u for the format of the mode, which NVKMS names by its HDMI_VIC, so that HDR10+ takes the generic InfoFrame slot (NVKMS's own vendor InfoFrame goes out in none while it does)",
+                         head, ctaVic);
+        } else {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u: the AVI InfoFrame and NVKMS's vendor InfoFrame say the mode as NVKMS signals it again",
+                         head);
+        }
+    }
+    *pVic = (NvU8)ctaVic;
+    pDevEvo->hadesAviCtaClock[sd][head] =
+        (ctaVic != 0) ? pDispEvo->headState[head].timings.pixelClock : 0;
 }
 
 /*
@@ -1103,10 +1237,14 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
     /*
      * Disable the vendor specific infoframe if not requested to be
      * enabled, or if HDMI 3D is requested but not supported by the monitor.
+     *
+     * Hades: and while the AVI InfoFrame carries the CTA VIC of the mode for
+     * HDR10+ (nvHadesHdr10PlusAviCtaVic()), as for that CTA mode.
      */
     if (!vendorCtrl.Enable ||
         ((vendorCtrl.HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) &&
-         !pEdidInfo->HDMI3DSupported)) {
+         !pEdidInfo->HDMI3DSupported) ||
+        (pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] != 0)) {
 
         UpdateInfoFrameFlipStatePre(currentTransmitCtrl, newTransmitCtrl,
             NV_EVO_INFOFRAME_TRANSMIT_FREQUENCY_EVERY_FRAME, NV_FALSE);
@@ -1227,6 +1365,7 @@ SendHDRInfoFrame(const NVDispEvoRec *pDispEvo, const NvU32 head,
  */
 void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
+                                const NVDpyAttributeColor *pDpyColor,
                                 const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
                                 NvEvoInfoframeFlipState *flipState,
                                 NvEvoInfoFrameTransmitControl *newTransmitCtrl,
@@ -1238,6 +1377,26 @@ void nvHadesUpdateHdmiHdr10Plus(const NVDispEvoRec *pDispEvo,
         return;
     }
 
+    if (!pDevEvo->caps.supportsGenericSharedInfoFrames) {
+        /*
+         * the AVI InfoFrame first, where the HDR10+ InfoFrame that starts
+         * changes its VIC (nvHadesHdr10PlusAviCtaVic(); one that ends keeps it
+         * until the next change of mode)
+         */
+        if ((pDpyColor != NULL) &&
+            (HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState,
+                                     &pDpyEvo->parsedEdid.info) !=
+             pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head])) {
+            SendVideoInfoFrame(pDispEvo,
