@@ -266,6 +274,11 @@ NvBool nvkms_hades_turing_12bpc(void)
     return hades_turing_12bpc;
 }
 
+NvBool nvkms_hades_hdr_ycbcr422(void)
+{
+    return hades_hdr_ycbcr422;
+}
+
 NvU32 nvkms_max_output_color_bpc(void)
 {
     switch (max_output_color_depth) {
