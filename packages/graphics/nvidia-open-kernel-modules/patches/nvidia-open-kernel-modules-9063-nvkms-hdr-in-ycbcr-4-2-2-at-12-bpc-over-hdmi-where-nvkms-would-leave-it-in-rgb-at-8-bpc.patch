diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 4588c89..b0929f4 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -94,6 +94,63 @@ static inline NvBool nvHadesHdrWants12Bpc(NvBool capable,
            (chosenBpc == 8);
 }
 
+/*
+ * Whether HDR to an HDMI display goes out in YCbCr 4:2:2 at 12 bpc in place of
+ * the RGB at 8 bpc that NVKMS chose for the mode. That choice already holds
+ * every limit of the link: NVKMS takes RGB at the most bits that the GPU, the
+ * display and max_output_color_depth allow, goes over HDMI FRL where TMDS does
+ * not carry the mode at that depth and FRL is possible (an FRL GPU, an HDMI
+ * connector and not a dual-mode DisplayPort one, a display that declares FRL:
+ * nvHdmiIsFrlPossible()), and lowers the depth only where neither carries it
+ * (nvEvoHdmiTmdsMaxPixelClockCheck(), with the TMDS limits of the connector
+ * and of the display). So RGB at 8 bpc over TMDS for HDR means that RGB cannot
+ * have more there: a GPU without 10 bpc over HDMI (Turing), a mode that TMDS
+ * does not carry at more (2160p at 50 and 60 Hz on HDMI 2.0) without FRL, or a
+ * display without deep colour. HDMI carries YCbCr 4:2:2 in the 24 bits per
+ * pixel of RGB at 8 bpc, 12 bits per component at any depth (NVKMS counts it
+ * at the pixel clock whatever its depth: GetMaxPossibleTmdsPixelClockKHz()),
+ * so the link runs at the clock it runs at now; the video is 4:2:0, so 4:2:2
+ * keeps all of its chroma, and the head converts it at 12 bits
+ * (NVKMS_PIXEL_DEPTH_24_422), no worse than at 10. All of these:
+ *  - asked for (nvidia-modeset.hades_hdr_ycbcr422=1; off by default), and HDMI
+ *    deep colour not turned off (hdmi_deepcolor);
+ *  - the head signals HDR (BT.2100 colorimetry: an SDR or Dolby Vision output
+ *    does not), and the client fixed neither the depth (Dolby Vision fixes 8
+ *    through "max bpc") nor the colour format;
+ *  - NVKMS chose RGB at 8 bpc for the mode, without YCbCr 4:2:0, over TMDS;
+ *  - the display is driven as HDMI and declares YCbCr 4:2:2 (NVKMS knows a
+ *    depth of 4:2:2 for it from its EDID).
+ * Whether the mode is taken so is checked after this, with the mode; if it is
+ * not, the mode is set as NVKMS chose it.
+ */
+static inline NvBool nvHadesHdrWantsYCbCr422At12(NvBool enabled,
+                                                 NvBool hdmiDeepColor,
+                                                 NvBool bt2100,
+                                                 NvBool bpcRequested,
+                                                 NvBool formatRequested,
+                                                 NvBool rgb,
+                                                 NvU32 chosenBpc,
+                                                 NvBool yuv420,
+                                                 NvBool tmds,
+                                                 NvBool hdmiSink,
+                                                 NvBool sink422)
+{
+    return enabled && hdmiDeepColor && bt2100 && !bpcRequested &&
+           !formatRequested && rgb && (chosenBpc == 8) && !yuv420 && tmds &&
+           hdmiSink && sink422;
+}
+
+/*
+ * What the kernel log last said of HDR to a display where a rule above chose
+ * it (NVDpyEvoRec::hadesHdrBpcLogged): it is said again when it changes, and
+ * after the display left HDR.
+ */
+#define NV_HADES_HDR_LOGGED_NONE          0
+#define NV_HADES_HDR_LOGGED_RGB8          8   /* 12 bpc did not fit */
+#define NV_HADES_HDR_LOGGED_RGB12         12
+#define NV_HADES_HDR_LOGGED_YCBCR422      22
+#define NV_HADES_HDR_LOGGED_YCBCR422_NOT  23  /* 4:2:2 refused: RGB at 8 bpc */
+
 /*
  * HDR10+: the vendor-specific InfoFrame of HDR10+ Technologies (IEEE OUI
  * 90-84-8B), whose 27 bytes of payload (PB1..PB27: the OUI, then 24 bytes) a
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index c04b0fb..feb94d4 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -2419,9 +2419,9 @@ typedef struct _NVDpyEvoRec {
     /* whether the connected dpy advertises ALLM support in EDID */
     NvBool      allmCapable              : 1;
     /*
-     * Hades: the depth of HDR (8 or 12 bpc) that the kernel log last said for
-     * this display on a GPU without 10 bpc over HDMI, 0 if none since it last
-     * left HDR.
+     * Hades: what the kernel log last said of HDR to this display where a rule
+     * of Hades chose its depth or format (NV_HADES_HDR_LOGGED_* of
+     * nvkms-hades.h), NONE if nothing since it last left HDR.
      */
     NvU8        hadesHdrBpcLogged;
     NvBool      isVrHmd                  : 1;
diff --git a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
index 38efce0..97955fe 100644
--- a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
+++ b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
@@ -126,6 +126,7 @@ NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
 NvU32 nvkms_max_output_color_bpc(void);
 NvBool nvkms_hades_turing_12bpc(void);
+NvBool nvkms_hades_hdr_ycbcr422(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
 NvBool nvkms_enable_overlay_layers(void);
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index 3ff6aa0..812770b 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -171,6 +171,61 @@ InheritPreviousModesetState(const NVDevEvoRec *pDevEvo,
                 !pDevEvo->modesetOwnerOrSubOwnerChanged;
 }
 
+/* Hades: the timings go out over TMDS (an HDMI head without FRL) */
+static NvBool HadesTmdsProtocol(enum nvKmsTimingsProtocol protocol)
+{
+    return (protocol == NVKMS_PROTOCOL_SOR_SINGLE_TMDS_A) ||
+           (protocol == NVKMS_PROTOCOL_SOR_SINGLE_TMDS_B) ||
+           (protocol == NVKMS_PROTOCOL_SOR_DUAL_TMDS);
+}
+
+/*
+ * Hades: what HDR to a display goes out as where a rule of Hades chose it
+ * (nvHadesHdrWants12Bpc(), nvHadesHdrWantsYCbCr422At12()), in the kernel log
+ * when it changes for that display (NV_HADES_HDR_LOGGED_*).
+ */
+static void HadesLogHdrOutput(const NVDispEvoRec *pDispEvo,
+                              NVDpyEvoPtr pDpyEvo,
+                              NvU8 what)
+{
+    if (pDpyEvo->hadesHdrBpcLogged == what) {
+        return;
+    }
+    pDpyEvo->hadesHdrBpcLogged = what;
+
+    switch (what) {
+    case NV_HADES_HDR_LOGGED_RGB12:
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR on %s goes out at 12 bpc: this GPU "
+                     "has no 10 bpc over HDMI, and the display takes "
+                     "36-bit deep colour",
+                     pDpyEvo->name);
+        break;
+    case NV_HADES_HDR_LOGGED_RGB8:
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR on %s goes out at 8 bpc: the mode does "
+                     "not fit TMDS at 12 bpc, and this GPU has no 10 bpc "
+                     "over HDMI",
+                     pDpyEvo->name);
+        break;
+    case NV_HADES_HDR_LOGGED_YCBCR422:
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR on %s goes out in YCbCr 4:2:2 at 12 bpc: "
+                     "RGB would stay at 8 bpc over TMDS in this mode, and "
+                     "4:2:2 runs at the same clock",
+                     pDpyEvo->name);
+        break;
+    case NV_HADES_HDR_LOGGED_YCBCR422_NOT:
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR on %s stays in RGB at 8 bpc: the mode was "
+                     "refused in YCbCr 4:2:2 at 12 bpc",
+                     pDpyEvo->name);
+        break;
+    default:
+        break;
+    }
+}
+
 /*!
  * Get the NVHwModeTimingsEvo for the mode requested by the client.
  *
@@ -204,6 +259,8 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
     NvBool colorFormatSpecified =
         (pRequestHead->colorFormatSpecified) &&
         (pRequestHead->colorFormat != NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_FORMAT_UNKNOWN);
+    NVDpyAttributeColor chosenColor; /* Hades: NVKMS's own choice, before the timings */
+    NvBool tried12Bpc;
 
     if (nvDpyIdListIsEmpty(pRequestHead->dpyIdList)) {
         return TRUE;
@@ -239,18 +296,19 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
      * at 12 bpc (2160p up to 30 Hz on HDMI 2.0, for one), it goes out at 12
      * (nvHadesHdrWants12Bpc()). The timings are constructed at 12 bpc with the
      * depth fixed; if that is refused, they are constructed as before, at the
-     * depth NVKMS chose. SDR, a depth the client fixed (Dolby Vision) and GPUs
-     * with 10 bpc over HDMI are not touched.
+     * depth NVKMS chose, and YCbCr 4:2:2 at 12 bpc may follow (below). SDR, a
+     * depth the client fixed (Dolby Vision) and GPUs with 10 bpc over HDMI are
+     * not touched.
      */
-    if (nvHadesHdrWants12Bpc(
+    tried12Bpc = nvHadesHdrWants12Bpc(
             nvDpyIsHdmiHdrDepth36Evo(pDpyEvo),
             dpyColor.colorimetry == NVKMS_OUTPUT_COLORIMETRY_BT2100,
             pRequestHead->colorBpcSpecified,
             dpyColor.format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB,
             yuv420Mode != NV_YUV420_MODE_NONE,
-            dpyColor.bpc)) {
+            dpyColor.bpc);
+    if (tried12Bpc) {
         NVDpyAttributeColor deepColor = dpyColor;
-        NvU8 logged;
 
         deepColor.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
 
@@ -269,33 +327,26 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
                                         pTimings,
                                         &pRequestHead->modeValidationParams,
                                         &dummyInfoString)) {
-            if (pDpyEvo->hadesHdrBpcLogged != 12) {
-                pDpyEvo->hadesHdrBpcLogged = 12;
-                nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
-                             "Hades: HDR on %s goes out at 12 bpc: this GPU "
-                             "has no 10 bpc over HDMI, and the display takes "
-                             "36-bit deep colour",
-                             pDpyEvo->name);
-            }
+            /*
+             * (NVKMS may take a mode in YCbCr 4:2:2 instead where the depth is
+             * fixed: only where it knows 4:2:2 at 12 bpc for the display,
+             * max_output_color_depth=12)
+             */
+            HadesLogHdrOutput(pDispEvo, pDpyEvo,
+                              (deepColor.format ==
+                               NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422) ?
+                                  NV_HADES_HDR_LOGGED_YCBCR422 :
+                                  NV_HADES_HDR_LOGGED_RGB12);
             if (pDpyColor != NULL) {
                 *pDpyColor = deepColor;
             }
             return TRUE;
         }
-
-        logged = pDpyEvo->hadesHdrBpcLogged;
-        if (logged != 8) {
-            pDpyEvo->hadesHdrBpcLogged = 8;
-            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
-                         "Hades: HDR on %s goes out at 8 bpc: the mode does "
-                         "not fit TMDS at 12 bpc, and this GPU has no 10 bpc "
-                         "over HDMI",
-                         pDpyEvo->name);
-        }
     } else if (dpyColor.colorimetry != NVKMS_OUTPUT_COLORIMETRY_BT2100) {
-        pDpyEvo->hadesHdrBpcLogged = 0;
+        pDpyEvo->hadesHdrBpcLogged = NV_HADES_HDR_LOGGED_NONE;
     }
 
+    chosenColor = dpyColor;
     nvkms_memset(pTimings, 0, sizeof(*pTimings));
 
     if (!nvConstructHwModeTimingsEvo(pDpyEvo,
@@ -314,6 +365,80 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
         return FALSE;
     }
 
+    /*
+     * Hades: HDR that NVKMS left in RGB at 8 bpc over TMDS goes out in YCbCr
+     * 4:2:2 at 12 bpc where that is asked for and the display takes 4:2:2
+     * (nvHadesHdrWantsYCbCr422At12()): the same clock, more bits. The timings
+     * are constructed so with the format and the depth fixed; if that is
+     * refused, they are constructed again as NVKMS chose them.
+     */
+    if (nvHadesHdrWantsYCbCr422At12(
+            nvkms_hades_hdr_ycbcr422(),
+            nvkms_hdmi_deepcolor(),
+            dpyColor.colorimetry == NVKMS_OUTPUT_COLORIMETRY_BT2100,
+            pRequestHead->colorBpcSpecified,
+            colorFormatSpecified,
+            dpyColor.format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_RGB,
+            dpyColor.bpc,
+            yuv420Mode != NV_YUV420_MODE_NONE,
+            HadesTmdsProtocol(pTimings->protocol),
+            nvDpyIsHdmiEvo(pDpyEvo),
+            nvDpyGetOutputColorFormatInfo(pDpyEvo).yuv422.maxBpc !=
+                NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_UNKNOWN)) {
+        NVDpyAttributeColor yuvColor = dpyColor;
+
+        yuvColor.format = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422;
+        yuvColor.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_12;
+        /* (YCbCr goes in limited range) */
+        yuvColor.range = NV_KMS_DPY_ATTRIBUTE_COLOR_RANGE_LIMITED;
+
+        nvkms_memset(pTimings, 0, sizeof(*pTimings));
+
+        if (nvConstructHwModeTimingsEvo(pDpyEvo,
+                                        &kmsMode,
+                                        yuv420Mode,
+                                        &pRequestHead->viewPortSizeIn,
+                                        pRequestHead->viewPortOutSpecified ?
+                                              &pRequestHead->viewPortOut : NULL,
+                                        dscPassThrough,
+                                        TRUE /* the format stays 4:2:2 */,
+                                        TRUE /* the depth stays 12 */,
+                                        &yuvColor,
+                                        pTimings,
+                                        &pRequestHead->modeValidationParams,
+                                        &dummyInfoString) &&
+            (yuvColor.format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_FORMAT_YCbCr422) &&
+            HadesTmdsProtocol(pTimings->protocol)) {
+            HadesLogHdrOutput(pDispEvo, pDpyEvo, NV_HADES_HDR_LOGGED_YCBCR422);
+            if (pDpyColor != NULL) {
+                *pDpyColor = yuvColor;
+            }
+            return TRUE;
+        }
+
+        dpyColor = chosenColor;
+        nvkms_memset(pTimings, 0, sizeof(*pTimings));
+
+        if (!nvConstructHwModeTimingsEvo(pDpyEvo,
+                                         &kmsMode,
+                                         yuv420Mode,
+                                         &pRequestHead->viewPortSizeIn,
+                                         pRequestHead->viewPortOutSpecified ?
+                                               &pRequestHead->viewPortOut : NULL,
+                                         dscPassThrough,
+                                         colorFormatSpecified,
+                                         pRequestHead->colorBpcSpecified,
+                                         &dpyColor,
+                                         pTimings,
+                                         &pRequestHead->modeValidationParams,
+                                         &dummyInfoString)) {
+            return FALSE;
+        }
+        HadesLogHdrOutput(pDispEvo, pDpyEvo, NV_HADES_HDR_LOGGED_YCBCR422_NOT);
+    } else if (tried12Bpc) {
+        HadesLogHdrOutput(pDispEvo, pDpyEvo, NV_HADES_HDR_LOGGED_RGB8);
+    }
+
     if (pDpyColor != NULL) {
         *pDpyColor = dpyColor;
     }
