@@ -1874,6 +1902,42 @@ void nv_drm_connector_add_hdmi_vrr_off(struct nv_drm_connector *nv_connector)
     nv_connector->hdmi_vrr_off = true;
 }
 
+/*
+ * Hades: NV_HDMI_FRL_KEEP on a connector with a TMDS output of the GPU, as
+ * NV_HDMI_VRR_OFF (nv_drm_connector_add_hdmi_vrr_off()). With 1, a mode set of
+ * the head that drives it asks NVKMS to keep HDMI FRL for a mode that TMDS
+ * would carry, where the head runs over FRL now (hadesFrlKeep of KAPI;
+ * nvHadesFrlKeepDecide() of NVKMS): the change of mode of a video goes from FRL
+ * to FRL, and the one back to the menus too, where NVKMS would go from FRL to
+ * TMDS and back. A client sets it while its menus need FRL. Its default, 0,
+ * changes nothing; where FRL does not apply (a dual-mode DisplayPort
+ * connector, a display without FRL) NVKMS leaves the mode to TMDS. Only while
+ * the device is not registered yet.
+ */
+void nv_drm_connector_add_hdmi_frl_keep(struct nv_drm_connector *nv_connector)
+{
+    struct drm_device *dev = nv_connector->base.dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+
+    if (nv_connector->hdmi_frl_keep ||
+        nv_dev->nv_connector_hdmi_frl_keep_property == NULL) {
+        return;
+    }
+
+    if (dev->registered) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Connector at physical index %u has a TMDS output, on which NV_HDMI_FRL_KEEP is not offered",
+            nv_connector->physicalIndex);
+        return;
+    }
+
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdmi_frl_keep_property,
+                               0);
+    nv_connector->hdmi_frl_keep = true;
+}
