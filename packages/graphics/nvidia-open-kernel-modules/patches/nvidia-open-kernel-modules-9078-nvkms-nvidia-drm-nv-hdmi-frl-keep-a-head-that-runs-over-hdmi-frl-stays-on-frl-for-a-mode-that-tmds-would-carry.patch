--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -1221,4 +1221,108 @@ nvHadesRasterOfLooks(const NvU16 *pLines, const NvBool *pInBlanking, NvU32 looks
 #define NV_HADES_SCDC_CED_VALID(hi)             (((hi) >> 7) & 1)
 #define NV_HADES_SCDC_CED_COUNT(lo, hi)         ((((NvU32)(hi) & 0x7f) << 8) | (NvU32)(lo))
 
+/*
+ * Hades: an HDMI head that runs over FRL stays on FRL for a mode that TMDS
+ * would carry, where its client asks for it (NV_HDMI_FRL_KEEP of nvidia-drm:
+ * NVKMS_MODE_VALIDATION_HADES_FRL_KEEP in the mode validation of the mode
+ * set). The mode then goes out over FRL at the rate the link has, without DSC
+ * (nvHdmiFrlQueryConfigOneColorFormatAndBpc(); at the lowest rate that
+ * carries it where that one does not), so that the change of mode of a video
+ * and the one back to the menus go from FRL to FRL. NVKMS goes over FRL only
+ * where TMDS does not carry the mode, or where the client prefers FRL
+ * (NVKMS_MODE_VALIDATION_PREFER_HDMI_FRL_MODE), or the display asks for it in
+ * its SCDC Source Test Configuration (FRL_Max, a test of HDMI 2.1
+ * compliance): a source may drive any mode over FRL.
+ *
+ * Why: an RTX 4080 SUPER (driver 620.70.06, with an LG C5)
+ * left the display without a picture four times in 35 changes of mode from
+ * the TMDS mode of a video back to 3840x2160 at 120 Hz over FRL
+ * (1.0 and 1.1): the link trained, the display had its four lanes locked, and the
+ * raster of the head stood at line 0. None in the 30 changes of mode from
+ * FRL to FRL (Kodi's start, 60 to 120 Hz, the same mode again), whose head
+ * NVKMS shuts down and whose link it trains again just the same
+ * (KickoffProposedModeSetStateIncompatibleApiHeadsShutDown()), nor in 39
+ * from FRL to TMDS. What differs is the change of the SOR from TMDS to FRL,
+ * which RM makes in the part of the driver that NVIDIA keeps closed.
+ *
+ * Kept on FRL only where (in this order, the first that fails says why not):
+ * the client asked; nvidia-modeset.hades_frl_keep is on (the default); the
+ * mode set does not need the boot clocks; TMDS would carry the mode (if not,
+ * it goes over FRL anyway); the display takes FRL; the display is driven over
+ * FRL now (else there is nothing to keep: TMDS, as before); the mode is not
+ * HDMI 3D frame packing; its format is not YCbCr 4:2:0, nor YCbCr 4:2:2 on a
+ * GPU that does not send it over FRL (the format never changes for this).
+ */
+enum NvHadesFrlKeep {
+    NV_HADES_FRL_KEEP_NOT_ASKED = 0,
+    NV_HADES_FRL_KEEP,
+    NV_HADES_FRL_KEEP_OFF,
+    NV_HADES_FRL_KEEP_BOOT_CLOCKS,
+    NV_HADES_FRL_KEEP_NEEDS_FRL,
+    NV_HADES_FRL_KEEP_NO_FRL,
+    NV_HADES_FRL_KEEP_NOT_ON_FRL,
+    NV_HADES_FRL_KEEP_HDMI_3D,
+    NV_HADES_FRL_KEEP_FORMAT,
+};
+
+static inline enum NvHadesFrlKeep
+nvHadesFrlKeepDecide(NvBool asked,
+                     NvBool allowed,
+                     NvBool bootClocks,
+                     NvBool tmdsPossible,
+                     NvBool frlPossible,
+                     NvBool drivenOverFrl,
+                     NvBool hdmi3D,
+                     NvBool ycbcr420,
+                     NvBool ycbcr422,
+                     NvBool ycbcr422OverFrl)
+{
+    if (!asked) {
+        return NV_HADES_FRL_KEEP_NOT_ASKED;
+    }
+    if (!allowed) {
+        return NV_HADES_FRL_KEEP_OFF;
+    }
+    if (bootClocks) {
+        return NV_HADES_FRL_KEEP_BOOT_CLOCKS;
+    }
+    if (!tmdsPossible) {
+        return NV_HADES_FRL_KEEP_NEEDS_FRL;
+    }
+    if (!frlPossible) {
+        return NV_HADES_FRL_KEEP_NO_FRL;
+    }
+    if (!drivenOverFrl) {
+        return NV_HADES_FRL_KEEP_NOT_ON_FRL;
+    }
+    if (hdmi3D) {
+        return NV_HADES_FRL_KEEP_HDMI_3D;
+    }
+    if (ycbcr420 || (ycbcr422 && !ycbcr422OverFrl)) {
+        return NV_HADES_FRL_KEEP_FORMAT;
+    }
+    return NV_HADES_FRL_KEEP;
+}
+
+/* Hades: for the kernel log of a mode set where it was asked and not kept */
+static inline const char *nvHadesFrlKeepWhyNot(enum NvHadesFrlKeep keep)
+{
+    switch (keep) {
+        case NV_HADES_FRL_KEEP_OFF:
+            return "nvidia-modeset.hades_frl_keep=0";
+        case NV_HADES_FRL_KEEP_BOOT_CLOCKS:
+            return "the mode set needs the boot clocks";
+        case NV_HADES_FRL_KEEP_NO_FRL:
+            return "the display gets no FRL";
+        case NV_HADES_FRL_KEEP_NOT_ON_FRL:
+            return "the display was not driven over FRL";
+        case NV_HADES_FRL_KEEP_HDMI_3D:
+            return "HDMI 3D frame packing";
+        case NV_HADES_FRL_KEEP_FORMAT:
+            return "its colour format";
+        default:
+            return NULL;
+    }
+}
