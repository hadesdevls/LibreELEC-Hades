+/*
+ * Hades: the FRL rate of the link of the head that drives this display now;
+ * HDMI_FRL_DATA_RATE_NONE where no head drives it, or not over FRL. Read in
+ * the validation of a mode set, before it changes anything
+ * (nvHadesFrlKeepDecide()).
+ */
+HDMI_FRL_DATA_RATE nvHadesCurrentFrlRate(const NVDpyEvoRec *pDpyEvo)
+{
+    const NVDispEvoRec *pDispEvo = pDpyEvo->pDispEvo;
+    const NvU32 apiHead = pDpyEvo->apiHead;
+    const NVDispApiHeadStateEvoRec *pApiHeadState;
+    NvU32 head;
+
+    if ((apiHead == NV_INVALID_HEAD) ||
+        (apiHead >= pDispEvo->pDevEvo->numApiHeads)) {
+        return HDMI_FRL_DATA_RATE_NONE;
+    }
+
+    pApiHeadState = &pDispEvo->apiHeadState[apiHead];
+    if ((pApiHeadState->hwHeadsMask == 0x0) ||
+        (pApiHeadState->timings.protocol != NVKMS_PROTOCOL_SOR_HDMI_FRL)) {
+        return HDMI_FRL_DATA_RATE_NONE;
+    }
+
+    head = nvGetPrimaryHwHeadFromMask(pApiHeadState->hwHeadsMask);
+    if (head == NV_INVALID_HEAD) {
+        return HDMI_FRL_DATA_RATE_NONE;
+    }
+
+    return pDispEvo->headState[head].hdmiFrlConfig.frlRate;
+}
