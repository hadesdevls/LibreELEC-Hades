+/*
+ * Add the HDMI 3D frame packed variant of a mode to the connector's
+ * probed_mode list.
+ *
+ * As everywhere else in DRM, the variant is the 2D mode with the frame packing
+ * layout in its flags: the size and the pixel clock it declares stay those of
+ * the 2D mode. Only a client that set DRM_CLIENT_CAP_STEREO_3D sees it.
+ */
+static bool
+nv_drm_connector_add_frame_packed_mode(struct drm_connector *connector,
+                                       const struct drm_display_mode *mode)
+{
+    struct drm_display_mode *stereo_mode =
+        drm_mode_duplicate(connector->dev, mode);
+
+    if (stereo_mode == NULL) {
+        return false;
+    }
+
+    stereo_mode->flags &= ~DRM_MODE_FLAG_3D_MASK;
+    stereo_mode->flags |= DRM_MODE_FLAG_3D_FRAME_PACKING;
+
+    /* A 3D mode is never the mode a client should pick by default */
+    stereo_mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+
+    drm_mode_probed_add(connector, stereo_mode);
+
+    return true;
+}
+
 static int nv_drm_connector_get_modes(struct drm_connector *connector)
 {
     struct drm_device *dev = connector->dev;
@@ -466,6 +504,7 @@ static int nv_drm_connector_get_modes(struct drm_connector *connector)
                            nv_connector->nv_detected_encoder;
     NvU32 modeIndex = 0;
