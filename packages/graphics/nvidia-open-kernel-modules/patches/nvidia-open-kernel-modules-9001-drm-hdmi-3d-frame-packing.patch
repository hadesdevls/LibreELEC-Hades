+/*
+ * Turn the configuration of a plane into what NVKMS expects on a head that is
+ * driven in an HDMI 3D frame packed mode.
+ *
+ * As for every other DRM driver, the client describes such a mode as one
+ * picture of vdisplay + vtotal lines: the left eye, an active space as tall as
+ * the vertical blanking, and the right eye. NVKMS, whose display hardware does
+ * the frame packing, wants the opposite: the head and its layer sized for one
+ * eye, and one surface per eye, flipped together.
+ *
+ * Only what maps onto that exactly is accepted: the primary plane, covering
+ * the whole picture, unscaled and unrotated, with a framebuffer from which the
+ * two per-eye surfaces can be made. Anything else fails the atomic check.
+ */
+static int
+plane_config_update_frame_packed(struct drm_plane *plane,
+                                 struct drm_plane_state *plane_state,
+                                 const struct drm_crtc_state *crtc_state,
+                                 struct NvKmsKapiLayerConfig *config)
+{
+    struct nv_drm_device *nv_dev = to_nv_device(plane->dev);
+    const struct drm_display_mode *mode = &crtc_state->mode;
+    const uint32_t eye_height = mode->vdisplay;
+    const uint32_t right_eye_row = mode->vtotal;
+    const uint32_t packed_height = eye_height + right_eye_row;
+    int ret;
+
+    if (plane->type != DRM_PLANE_TYPE_PRIMARY) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "Only the primary plane can be used in an HDMI 3D frame packed "
+            "mode");
+        return -EINVAL;
+    }
+
+    /* Source values are 16.16 fixed point */
+    if ((plane_state->src_x != 0) || (plane_state->src_y != 0) ||
+        (plane_state->src_w != ((uint32_t)mode->hdisplay << 16)) ||
+        ((plane_state->src_h & 0xffff) != 0) ||
+        ((plane_state->src_h >> 16) != packed_height) ||
+        (plane_state->crtc_x != 0) || (plane_state->crtc_y != 0) ||
+        (plane_state->crtc_w != mode->hdisplay) ||
+        (plane_state->crtc_h != packed_height)) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "In an HDMI 3D frame packed mode the primary plane has to cover "
+            "%ux%u, unscaled",
+            mode->hdisplay, packed_height);
+        return -EINVAL;
+    }
+
+    if ((plane->rotation_property != NULL) &&
+        (plane_state->rotation != DRM_MODE_ROTATE_0)) {
+        return -EINVAL;
+    }
+
+    ret = nv_drm_framebuffer_get_frame_packed_surfaces(
+              plane_state->fb,
+              eye_height,
+              right_eye_row,
+              &config->surface,
+              &config->surfaceRightEye);
+    if (ret != 0) {
+        return ret;
+    }
+
+    /* The layer of NVKMS shows one eye */
+
+    config->srcHeight = eye_height;
+    config->dstHeight = eye_height;
+
+    return 0;
+}
+
 static int
 plane_req_config_update(struct drm_plane *plane,
                         struct drm_plane_state *plane_state,
@@ -1253,6 +1327,20 @@ plane_req_config_update(struct drm_plane *plane,
     req_config->config.dstWidth  = plane_state->crtc_w;
     req_config->config.dstHeight = plane_state->crtc_h;
 
+    /*
+     * In an HDMI 3D frame packed mode the framebuffer holds both eyes, and
+     * NVKMS wants each of them as a surface of its own.
+     */
+    if (nv_drm_mode_is_frame_packed(&crtc_state->mode)) {
+        int ret = plane_config_update_frame_packed(plane,
+                                                   plane_state,
+                                                   crtc_state,
+                                                   &req_config->config);
+        if (ret != 0) {
+            return ret;
+        }
+    }
+
     req_config->config.csc = old_config.csc;
 
