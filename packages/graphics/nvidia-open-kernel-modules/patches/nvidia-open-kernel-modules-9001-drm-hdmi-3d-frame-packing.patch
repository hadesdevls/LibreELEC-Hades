             ret = cursor_plane_req_config_update(plane, plane_state,
                                                  cursor_req_config);
             if (ret != 0) {
@@ -1782,6 +1880,15 @@ static int nv_drm_plane_atomic_check(struct drm_plane *plane,
                 return ret;
             }
 
+            /*
+             * The two eyes of an HDMI 3D frame packed picture are flipped
