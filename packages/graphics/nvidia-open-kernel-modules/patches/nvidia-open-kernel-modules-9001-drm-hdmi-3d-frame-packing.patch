+
+        if (displayMode.timings.flags.hdmi3DAvailable &&
+            connector->stereo_allowed &&
+            nv_drm_connector_add_frame_packed_mode(connector, mode)) {
+
+            frame_packing_advertised = true;
+
+            count++;
+        }
     }
 
+    nv_connector->frame_packing_advertised = frame_packing_advertised;
+
     return count;
 }
 
@@ -827,6 +882,15 @@ nv_drm_connector_new(struct drm_device *dev,
             DRM_CONNECTOR_POLL_CONNECT | DRM_CONNECTOR_POLL_DISCONNECT;
