diff --git a/kernel-open/nvidia-drm/nvidia-drm-utils.c b/kernel-open/nvidia-drm/nvidia-drm-utils.c
index b14947f..87e2222 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-utils.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-utils.c
@@ -219,10 +219,34 @@ void drm_mode_to_nvkms_display_mode(const struct drm_display_mode *src,
         dst->timings.flags.vSyncNeg = NV_FALSE;
     }
 
+    /*
+     * A frame packed mode has the timings of its 2D mode: NVKMS doubles the
+     * pixel clock itself when it is told that the mode is HDMI 3D.
+     */
+    if (nv_drm_mode_is_frame_packed(src)) {
+        dst->timings.flags.hdmi3D = NV_TRUE;
+    } else {
+        dst->timings.flags.hdmi3D = NV_FALSE;
+    }
+
+    dst->timings.flags.hdmi3DAvailable = NV_FALSE;
+
     dst->timings.widthMM  = src->width_mm;
     dst->timings.heightMM = src->height_mm;
 
     memcpy(dst->name, src->name, min(sizeof(dst->name), sizeof(src->name)));
 }
 
+/*
+ * Whether the mode is an HDMI 3D frame packed mode.  The 3D layout of a DRM
+ * mode is a value in a field of its flags, not a bit.  Frame packing is the
+ * only layout NVKMS can drive; a mode with any other layout is treated as its
+ * 2D mode.
+ */
+bool nv_drm_mode_is_frame_packed(const struct drm_display_mode *mode)
+{
+    return (mode->flags & DRM_MODE_FLAG_3D_MASK) ==
+           DRM_MODE_FLAG_3D_FRAME_PACKING;
+}
