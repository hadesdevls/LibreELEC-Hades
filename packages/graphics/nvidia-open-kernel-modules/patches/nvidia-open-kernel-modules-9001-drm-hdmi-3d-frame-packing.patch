+             */
+            if (nv_drm_mode_is_frame_packed(&crtc_state->mode) &&
+                __is_async_flip_requested(plane, crtc_state)) {
+                return -EINVAL;
+            }
+
             if (__is_async_flip_requested(plane, crtc_state)) {
                 /*
                  * Async flip requests that the flip happen 'as soon as
@@ -2675,6 +2782,64 @@ static int head_modeset_config_attach_connector(
     return 0;
 }
 
+/*
+ * Check what an HDMI 3D frame packed mode needs from the connectors of its
+ * crtc: an HDMI connector, whose display advertised frame packing when its
+ * modes were last probed, and no user-provided vendor specific infoframe.
+ *
+ * NVKMS tells the display that the picture is frame packed with its own HDMI
+ * vendor specific infoframe, and the NV_HDMI_VSIF_METADATA property replaces
+ * that infoframe with the one of the client: with both, the display would get
+ * the frame packed signal without being told so. The two cannot be active
+ * together.
+ *
+ * A connector is in the atomic state whenever its crtc changes mode or one of
+ * its own properties changes, which are the two ways to get there.
+ */
+static int nv_drm_crtc_atomic_check_frame_packed(
+    struct drm_crtc *crtc,
+    struct drm_crtc_state *crtc_state)
+{
+    struct nv_drm_device *nv_dev = to_nv_device(crtc->dev);
+    struct drm_connector *connector;
+    struct drm_connector_state *connector_state;
+    int i;
+
+    /* The display hardware packs progressive frames only */
+    if ((crtc_state->mode.flags &
+         (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)) != 0) {
+        return -EINVAL;
+    }
+
+    for_each_new_connector_in_state(crtc_state->state,
+                                       connector, connector_state, i) {
+        struct nv_drm_connector *nv_connector = to_nv_connector(connector);
+
+        if (connector_state->crtc != crtc) {
+            continue;
+        }
+
+        if ((nv_connector->type != NVKMS_CONNECTOR_TYPE_HDMI) ||
+            !nv_connector->frame_packing_advertised) {
+            NV_DRM_DEV_DEBUG_DRIVER(
+                nv_dev,
+                "The display does not advertise HDMI 3D frame packing");
+            return -EINVAL;
+        }
+
+        if (to_nv_drm_connector_state(connector_state)->hdmi_vsif_metadata !=
+            NULL) {
+            NV_DRM_DEV_DEBUG_DRIVER(
+                nv_dev,
+                "NV_HDMI_VSIF_METADATA cannot be set in an HDMI 3D frame "
+                "packed mode");
+            return -EINVAL;
+        }
+    }
+
+    return 0;
+}
+
 /**
  * nv_drm_crtc_atomic_check() can fail after it has modified
  * the 'nv_drm_crtc_state::req_config', that is fine because 'nv_drm_crtc_state'
@@ -2699,6 +2864,13 @@ static int nv_drm_crtc_atomic_check(struct drm_crtc *crtc,
         &nv_crtc_state->req_config;
     int ret = 0;
 
+    if (nv_drm_mode_is_frame_packed(&crtc_state->mode)) {
+        ret = nv_drm_crtc_atomic_check_frame_packed(crtc, crtc_state);
+        if (ret != 0) {
+            return ret;
+        }
+    }
+
     if (crtc_state->mode_changed) {
         drm_mode_to_nvkms_display_mode(&crtc_state->mode,
                                        &req_config->modeSetConfig.mode);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-fb.c b/kernel-open/nvidia-drm/nvidia-drm-fb.c
index 95fd4f0..4b372eb 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-fb.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-fb.c
@@ -52,15 +52,35 @@ static void __nv_drm_framebuffer_free(struct nv_drm_framebuffer *nv_fb)
     nv_drm_free(nv_fb);
 }
 
+/*
+ * Serializes the creation of the per-eye surfaces of the framebuffers that
+ * are scanned out in an HDMI 3D frame packed mode.
+ */
+static DEFINE_MUTEX(nv_drm_frame_packed_surfaces_mutex);
+
 static void nv_drm_framebuffer_destroy(struct drm_framebuffer *fb)
 {
     struct nv_drm_device *nv_dev = to_nv_device(fb->dev);
     struct nv_drm_framebuffer *nv_fb = to_nv_framebuffer(fb);
+    uint32_t eye;
 
     /* Cleaup core framebuffer object */
 
     drm_framebuffer_cleanup(fb);
 
+    /*
+     * Free the per-eye NvKmsKapiSurfaces, if this framebuffer was scanned
+     * out in an HDMI 3D frame packed mode. Nothing can be creating them
+     * anymore: the last reference to the framebuffer is gone.
+     */
+
+    for (eye = 0; eye < ARRAY_SIZE(nv_fb->frame_packed.pSurface); eye++) {
+        if (nv_fb->frame_packed.pSurface[eye] != NULL) {
+            nvKms->destroySurface(nv_dev->pDevice,
+                                  nv_fb->frame_packed.pSurface[eye]);
+        }
+    }
+
     /* Free NvKmsKapiSurface associated with this framebuffer object */
 
     if (nv_fb->pSurface != NULL) {
@@ -324,4 +344,164 @@ struct drm_framebuffer *nv_drm_framebuffer_create(
     return &nv_fb->base;
 }
 
+/*
+ * Get the per-eye surfaces of a framebuffer that is to be scanned out in an
+ * HDMI 3D frame packed mode, creating them the first time.
+ *
+ * As for every other DRM driver, the client hands over one framebuffer that
+ * holds the whole frame packed picture: the left eye in its first eye_height
+ * lines, then the active space, then the right eye from line right_eye_row on.
+ * The display hardware does the frame packing itself, out of one surface per
+ * eye: it takes a memory offset for each eye, and the size, the pitch, the
+ * format and the memory layout of the left eye for both. So each eye becomes a
+ * surface of eye_height lines over the memory of the framebuffer, and the
+ * right eye one starts right_eye_row lines further. The lines of the active
+ * space are never read: the hardware fills that part of the signal itself.
+ *
+ * This is only possible if a line offset is a byte offset:
+ *
+ *  - the memory layout has to be pitch. In a block linear surface the lines
+ *    are stored in blocks of 8 lines or more, and the right eye does not start
+ *    on a block. Without a format modifier the layout is not known here, so
+ *    the framebuffer has to be created with DRM_FORMAT_MOD_LINEAR;
+ *
+ *  - a single plane, so that both eyes are described by one offset;
+ *
+ *  - an offset of the right eye that NVKMS accepts: it is validated, like the
+ *    rest, when the surface is registered.
+ *
+ * Returns 0 and the two surfaces, which live as long as the framebuffer, or a
+ * negative errno if the framebuffer cannot be scanned out that way.
+ */
+int nv_drm_framebuffer_get_frame_packed_surfaces(
+    struct drm_framebuffer *fb,
+    uint32_t eye_height,
+    uint32_t right_eye_row,
+    struct NvKmsKapiSurface **ppLeftSurface,
+    struct NvKmsKapiSurface **ppRightSurface)
+{
+    struct nv_drm_device *nv_dev = to_nv_device(fb->dev);
+    struct nv_drm_framebuffer *nv_fb = to_nv_framebuffer(fb);
+    struct nv_drm_gem_object *nv_gem = to_nv_gem_object(fb->obj[0]);
+    struct NvKmsKapiCreateSurfaceParams params = { };
+    struct NvKmsKapiSurface *pLeftSurface, *pRightSurface;
+    enum NvKmsSurfaceMemoryFormat format;
+    uint64_t right_eye_offset;
+    int ret = -EINVAL;
+
+    /* The framebuffer has to be one that can be scanned out at all */
+
+    if ((nv_fb->pSurface == NULL) ||
+        (nv_gem == NULL) || (nv_gem->pMemory == NULL)) {
+        return -EINVAL;
+    }
+
+    if (((fb->flags & DRM_MODE_FB_MODIFIERS) == 0) ||
+        (fb->modifier != DRM_FORMAT_MOD_LINEAR)) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "HDMI 3D frame packing needs a framebuffer created with "
+            "DRM_FORMAT_MOD_LINEAR");
+        return -EINVAL;
+    }
+
+    if ((fb->format->num_planes != 1) ||
+        nv_drm_format_is_yuv(fb->format->format) ||
+        !nv_drm_format_to_nvkms_format(fb->format->format, &format)) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "HDMI 3D frame packing needs a single plane RGB framebuffer");
+        return -EINVAL;
+    }
+
+    /* Both eyes have to lie within the framebuffer, without overlapping */
+
+    if ((eye_height == 0) ||
+        (right_eye_row < eye_height) ||
+        (((uint64_t)right_eye_row + eye_height) > fb->height)) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "Framebuffer of %u lines is too small for two eyes of %u lines, "
+            "the second one from line %u",
+            fb->height, eye_height, right_eye_row);
+        return -EINVAL;
+    }
+
+    right_eye_offset =
+        (uint64_t)fb->offsets[0] + ((uint64_t)fb->pitches[0] * right_eye_row);
+
+    if (right_eye_offset > U32_MAX) {
+        return -EINVAL;
+    }
+
+    mutex_lock(&nv_drm_frame_packed_surfaces_mutex);
+
+    if (nv_fb->frame_packed.pSurface[NVKMS_LEFT] != NULL) {
+        /*
+         * The surfaces exist already, and may be on the screen. They can only
+         * be used again for the geometry they were created for.
+         */
+        if ((nv_fb->frame_packed.eye_height == eye_height) &&
+            (nv_fb->frame_packed.right_eye_row == right_eye_row)) {
+            ret = 0;
+        }
+        goto done;
+    }
+
+    params.planes[0].memory = nv_gem->pMemory;
+    params.planes[0].offset = fb->offsets[0];
+    params.planes[0].pitch = fb->pitches[0];
+    params.width = fb->width;
+    params.height = eye_height;
+    params.format = format;
+    params.explicit_layout = true;
+    params.layout = NvKmsSurfaceMemoryLayoutPitch;
+
+    pLeftSurface = nvKms->createSurface(nv_dev->pDevice, &params);
+
+    if (pLeftSurface == NULL) {
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "Failed to create the left eye NvKmsKapiSurface");
+        goto done;
+    }
+
+    params.planes[0].offset = right_eye_offset;
+
+    pRightSurface = nvKms->createSurface(nv_dev->pDevice, &params);
+
+    if (pRightSurface == NULL) {
+        /*
+         * The usual reason: NVKMS only registers a surface at an offset
+         * that is aligned as its display hardware needs, and the right eye
+         * starts pitch * right_eye_row bytes into the framebuffer.
+         */
+        NV_DRM_DEV_DEBUG_DRIVER(
+            nv_dev,
+            "Failed to create the right eye NvKmsKapiSurface at offset %llu "
+            "(line %u, pitch %u): the offset may not be aligned as NVKMS "
+            "requires",
+            right_eye_offset, right_eye_row, fb->pitches[0]);
+        nvKms->destroySurface(nv_dev->pDevice, pLeftSurface);
+        goto done;
+    }
+
+    nv_fb->frame_packed.pSurface[NVKMS_LEFT] = pLeftSurface;
+    nv_fb->frame_packed.pSurface[NVKMS_RIGHT] = pRightSurface;
+    nv_fb->frame_packed.eye_height = eye_height;
+    nv_fb->frame_packed.right_eye_row = right_eye_row;
+
+    ret = 0;
+
+done:
+    if (ret == 0) {
+        *ppLeftSurface = nv_fb->frame_packed.pSurface[NVKMS_LEFT];
+        *ppRightSurface = nv_fb->frame_packed.pSurface[NVKMS_RIGHT];
+    }
+
+    mutex_unlock(&nv_drm_frame_packed_surfaces_mutex);
+
+    return ret;
+}
+
 #endif
