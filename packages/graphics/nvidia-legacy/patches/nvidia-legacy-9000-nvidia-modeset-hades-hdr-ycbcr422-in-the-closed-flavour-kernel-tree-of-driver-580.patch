From e7d7ceb45658d3bd2373009e1eebaa54f9f05116 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 5 Nov 2026 08:43:08 +0000
Subject: [PATCH] nvidia-modeset: hades_hdr_ycbcr422 in the closed-flavour
 kernel tree of driver 580

nvidia-legacy builds the kernel modules of driver 580 from the kernel/
tree of NVIDIA's .run, with the NVKMS core of nvidia-legacy-open. That core
asks for nvkms_hades_hdr_ycbcr422() (nvidia-legacy-open-9071), which the
kernel-open/ tree of nvidia-legacy-open defines, but the nvidia-modeset-linux.c
of kernel/ is the .run's own, which differs from the open one and is not
taken from it. This adds the same parameter and function to it:
hades_hdr_ycbcr422, a bool, off by default, writable by root (0644).
---
 kernel/nvidia-modeset/nvidia-modeset-linux.c        | 12 ++++++++++++
 kernel/nvidia-modeset/nvidia-modeset-os-interface.h |  1 +
 2 files changed, 13 insertions(+)

diff --git a/kernel/nvidia-modeset/nvidia-modeset-linux.c b/kernel/nvidia-modeset/nvidia-modeset-linux.c
index f9c52cb..0d7268c 100644
--- a/kernel/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel/nvidia-modeset/nvidia-modeset-linux.c
@@ -171,6 +171,18 @@ NvBool nvkms_hdmi_deepcolor(void)
     return hdmi_deepcolor;
 }
 
+/*
+ * Hades: HDR over HDMI in YCbCr 4:2:2 at 10 bpc where the GPU has no 10 bpc in
+ * RGB over HDMI (nvHadesHdrWantsYCbCr422() of the NVKMS core). Off by default.
+ */
+static bool hades_hdr_ycbcr422 = false;
+module_param_named(hades_hdr_ycbcr422, hades_hdr_ycbcr422, bool, 0644);
+
+NvBool nvkms_hades_hdr_ycbcr422(void)
+{
+    return hades_hdr_ycbcr422;
+}
+
 NvBool nvkms_vblank_sem_control(void)
 {
     return vblank_sem_control;
diff --git a/kernel/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel/nvidia-modeset/nvidia-modeset-os-interface.h
index 1c5783a..0c2bd82 100644
--- a/kernel/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -115,6 +115,7 @@ NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
+NvBool nvkms_hades_hdr_ycbcr422(void); /* Hades */
 NvBool nvkms_vblank_sem_control(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
-- 
2.53.0

