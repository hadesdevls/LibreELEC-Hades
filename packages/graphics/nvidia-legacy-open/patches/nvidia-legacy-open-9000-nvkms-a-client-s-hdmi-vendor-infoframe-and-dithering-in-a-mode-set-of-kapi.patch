+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+/*
+ * Hades: what nvidia-drm 615 gives Dolby Vision output on NVIDIA (a client's
+ * HDMI vendor InfoFrame, its dithering, the output depth), on the 580 release
+ * that drives Maxwell, Pascal and Volta.
+ *
+ * The ioctl API of NVKMS has no room for a client's vendor InfoFrame or
+ * dithering in a mode set in this release, and that API is shared with
+ * NVIDIA's closed user space of the same release (libnvidia-eglcore,
+ * libnvidia-allocator and libcuda open /dev/nvidia-modeset): none of its
+ * structures changes. KAPI passes them with NVKMS_HADES_IOCTL_SET_MODE, the
+ * mode set of NVKMS_IOCTL_SET_MODE with what follows it, which nvKmsIoctl()
+ * takes from kernel clients only, at its exact size.
+ */
+
+#ifndef __NVKMS_HADES_H__
+#define __NVKMS_HADES_H__
+
+#include "nvkms-api.h"
+
+/* Beyond enum NvKmsIoctlCommand; never in its dispatch table. */
+#define NVKMS_HADES_IOCTL_SET_MODE 0x48440001u
+
+struct NvKmsHadesSetModeHead {
+    /* The client's HDMI vendor InfoFrame; payloadSize 0 for none. */
+    struct NvKmsHdmiVsifMetadata hdmiVsifMetadata;
+
+    /*
+     * The dithering of the head, instead of that of the dpy (its
+     * NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING*), when specified.
+     */
+    NvBool ditheringSpecified;
+    enum NvKmsDpyAttributeRequestedDitheringValue ditheringState;
+    enum NvKmsDpyAttributeRequestedDitheringModeValue ditheringMode;
+};
+
+struct NvKmsHadesSetModeExtra {
+    struct {
+        struct NvKmsHadesSetModeHead head[NVKMS_MAX_HEADS_PER_DISP];
+    } disp[NVKMS_MAX_SUBDEVICES];
+};
+
+struct NvKmsHadesSetModeParams {
+    struct NvKmsSetModeParams setMode;
+    struct NvKmsHadesSetModeExtra extra;
+};
+
+/*
+ * The Dolby Vision vendor InfoFrame: IEEE OUI 00-D0-46, least significant
+ * byte first, as Kodi sends it through NV_HDMI_VSIF_METADATA.
+ */
+static inline NvBool nvHadesVsifIsDolby(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return (pVsif->payloadSize >= 3) &&
+           (pVsif->payload[0] == 0x46) &&
+           (pVsif->payload[1] == 0xD0) &&
+           (pVsif->payload[2] == 0x00);
+}
+
+/* What NVKMS will do with a head that sends a client's VSIF, on plain values. */
+struct NvKmsHadesVsifHead {
+    NvBool hdmi;         /* the dpy is driven as HDMI */
+    NvU32  numDpys;      /* dpys on the head */
+    NvBool hdrInfoFrame; /* an HDR (DR&M) InfoFrame is asked for */
+    NvBool bt2100;       /* BT.2100 colorimetry */
+    NvBool rgb;          /* RGB 4:4:4 */
+    NvU32  bpc;          /* enum NvKmsDpyAttributeColorBpcValue */
+    NvBool fullRange;
+    NvBool dithering;    /* the dithering NVKMS chose for the head */
+    NvBool outputTf;     /* an output transfer function */
+    NvBool ownVsif;      /* the mode needs NVKMS's own HDMI 1.4b VSIF (HDMI VIC, 3D) */
+};
+
+/*
+ * Why a head may not send the client's VSIF, or NULL when it may. Any VSIF
+ * goes out only on HDMI and to one display (Kodi's 3D output sends the one of
+ * HDMI 1.4b this way, OUI 00-0C-03, and takes it for what it says). The one of
+ * Dolby Vision goes out only with what makes its tunnel readable: 8-bit RGB
+ * 4:4:4 of full range, reaching the sink byte for byte, with nothing else in
+ * the vendor-specific slot of the SOR (the HDR InfoFrame goes through that
+ * slot on these GPUs: nvEvo1SendHdmiInfoFrame()). Dolby Vision Low-Latency
+ * (PB4 bit 0) is refused: this driver sends no YCbCr 4:2:2 AVI InfoFrame for
+ * it.
+ */
+static inline const char *nvHadesVsifRefusal(
+    const struct NvKmsHdmiVsifMetadata *pVsif,
+    const struct NvKmsHadesVsifHead *pHead)
+{
+    if (pVsif->payloadSize == 0) {
+        return NULL;
+    }
+    if ((pVsif->payloadSize < NVKMS_HDMI_VSIF_METADATA_MIN_PAYLOAD_SIZE) ||
+        (pVsif->payloadSize > NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE)) {
+        return "its size is out of range";
+    }
+    if (!pHead->hdmi) {
+        return "the display is not driven as HDMI";
+    }
+    if (pHead->numDpys != 1) {
+        return "the head does not drive exactly one display";
+    }
+    if (!nvHadesVsifIsDolby(pVsif)) {
+        return NULL;
+    }
+    if (pVsif->payloadSize != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) {
+        return "a Dolby Vision vendor InfoFrame has 27 bytes";
+    }
+    if ((pVsif->payload[3] & 0x01) != 0) {
+        return "Dolby Vision Low-Latency is not supported by this driver";
+    }
+    if (pHead->hdrInfoFrame) {
+        return "an HDR InfoFrame is asked for with Dolby Vision";
+    }
+    if (pHead->bt2100) {
+        return "BT.2100 colorimetry is asked for with Dolby Vision";
+    }
+    if (!pHead->rgb) {
+        return "the output is not RGB 4:4:4";
+    }
+    if (pHead->bpc != NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8) {
+        return "the output is not 8 bpc";
+    }
+    if (!pHead->fullRange) {
+        return "the output is not full range";
+    }
+    if (pHead->dithering) {
+        return "dithering is on";
+    }
+    if (pHead->outputTf) {
+        return "an output transfer function is set";
+    }
+    if (pHead->ownVsif) {
+        return "the mode needs NVKMS's own HDMI vendor InfoFrame (an HDMI VIC or 3D)";
+    }
+    return NULL;
+}
+
+#endif /* __NVKMS_HADES_H__ */
