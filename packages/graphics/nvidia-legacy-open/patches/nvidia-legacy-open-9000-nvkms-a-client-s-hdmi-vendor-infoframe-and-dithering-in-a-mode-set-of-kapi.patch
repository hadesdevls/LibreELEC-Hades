+/*!
+ * Hades: the mode set of KAPI, with what NvKmsSetModeParams has no room for
+ * in this release (nvkms-hades.h). Kernel clients only, at the exact size:
+ * the ioctl API of user space does not change.
+ */
+static NvBool HadesSetMode(struct NvKmsPerOpen *pOpen,
+                           const NvU64 paramsAddress,
+                           const size_t paramSize)
+{
+    struct NvKmsHadesSetModeParams *pParams;
+    struct NvKmsPerOpenDev *pOpenDev;
+    NvU32 sd, head;
+
+    if ((pOpen->clientType != NVKMS_CLIENT_KERNEL_SPACE) ||
+        (paramSize != sizeof(*pParams))) {
+        return FALSE;
+    }
+
+    pParams = nvKmsNvU64ToPointer(paramsAddress);
+
+    for (sd = 0; sd < ARRAY_LEN(pParams->extra.disp); sd++) {
+        for (head = 0; head < ARRAY_LEN(pParams->extra.disp[sd].head); head++) {
+            const struct NvKmsHadesSetModeHead *pHead =
+                &pParams->extra.disp[sd].head[head];
+            const NvU8 size = pHead->hdmiVsifMetadata.payloadSize;
+
+            if ((size != 0) &&
+                ((size < NVKMS_HDMI_VSIF_METADATA_MIN_PAYLOAD_SIZE) ||
+                 (size > NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE))) {
+                return FALSE;
+            }
+            if (pHead->ditheringSpecified &&
+                (((pHead->ditheringState !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_AUTO) &&
+                  (pHead->ditheringState !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_ENABLED) &&
+                  (pHead->ditheringState !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_DISABLED)) ||
+                 ((pHead->ditheringMode !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_MODE_AUTO) &&
+                  (pHead->ditheringMode !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_MODE_DYNAMIC_2X2) &&
+                  (pHead->ditheringMode !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_MODE_STATIC_2X2) &&
+                  (pHead->ditheringMode !=
+                       NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_MODE_TEMPORAL)))) {
+                return FALSE;
+            }
+        }
+    }
+
+    pOpenDev = GetPerOpenDev(pOpen, pParams->setMode.request.deviceHandle);
+
+    if (pOpenDev == NULL) {
+        return FALSE;
+    }
+
+    return nvHadesSetDispModeEvo(pOpenDev->pDevEvo, pOpenDev,
+                                 &pParams->setMode.request,
+                                 &pParams->setMode.reply,
+                                 &pParams->extra,
+                                 FALSE /* bypassComposition */,
+                                 TRUE /* doRasterLock */);
+}
