+ */
+enum NvKmsKapiDitheringMode {
+    NVKMS_KAPI_DITHERING_MODE_AUTO = 0,
+    NVKMS_KAPI_DITHERING_MODE_OFF,
+    NVKMS_KAPI_DITHERING_MODE_STATIC_2X2,
+    NVKMS_KAPI_DITHERING_MODE_DYNAMIC_2X2,
+    NVKMS_KAPI_DITHERING_MODE_TEMPORAL,
+    NVKMS_KAPI_DITHERING_MODE_ON,
+};
+
 struct NvKmsKapiHeadModeSetConfig {
     /*
      * DRM distinguishes between the head state "enabled" (the specified
@@ -412,6 +425,18 @@ struct NvKmsKapiHeadModeSetConfig {
     } olut;
 
     NvU32 olutFpNormScale;
+
+    /*
+     * Hades: as in nvidia-drm 615. The client's HDMI vendor InfoFrame
+     * (payloadSize 0 for none), the dithering it asks for, and the output
+     * color depth: 0 lets NVKMS choose it, any other value (from enum
+     * NvKmsDpyAttributeColorBpcValue) drives the head at exactly that depth.
+     * A change of any of them is a mode set (ApplyModeSetConfig()), which
+     * passes them to NVKMS (KmsSetMode()).
+     */
+    struct NvKmsHdmiVsifMetadata hdmiVsifMetadata;
+    enum NvKmsKapiDitheringMode dithering;
+    NvU32 colorBpc;
 };
 
 struct NvKmsKapiHeadRequestedConfig {
@@ -426,6 +451,9 @@ struct NvKmsKapiHeadRequestedConfig {
         NvBool legacyOlutChanged      : 1;
         NvBool olutChanged            : 1;
         NvBool olutFpNormScaleChanged : 1;
+        NvBool hdmiVsifMetadataChanged : 1;
+        NvBool ditheringChanged       : 1;
