+
+/* Hades: nvSetDispModeEvo() with what a kernel client adds (nvkms-hades.h) */
+NvBool nvHadesSetDispModeEvo(NVDevEvoPtr pDevEvo,
+                             struct NvKmsPerOpenDev *pOpenDev,
+                             const struct NvKmsSetModeRequest *pRequest,
+                             struct NvKmsSetModeReply *pReply,
+                             const struct NvKmsHadesSetModeExtra *pHades,
+                             NvBool bypassComposition,
+                             NvBool doRasterLock);
+
 typedef NvBool (*NVShutDownApiHeadsTestFunc)(
     const NVDispEvoRec *pDispEvo,
     const NvU32 apiHead,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index 224bdad..b3d9dd5 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1851,6 +1851,11 @@ typedef struct _NVDispHeadInfoFrameStateEvoRec {
     NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL vendorSpecificCtrl;
     NVT_EXTENDED_METADATA_PACKET_INFOFRAME_CTRL empCtrl;
     NvBool hdTimings;
+    /*
+     * Hades: a kernel client's HDMI vendor InfoFrame (nvkms-hades.h); it takes
+     * the place of vendorSpecificCtrl's while payloadSize != 0.
+     */
+    struct NvKmsHdmiVsifMetadata hdmiVsifMetadata;
 } NVDispHeadInfoFrameStateEvoRec;
 
 typedef enum _NVEvoMergeMode {
