diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index a12b06e..e371e0f 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -37,6 +37,7 @@
 #include "nvkms-kapi-private.h"
 #include "nvkms-kapi-internal.h"
 #include "nvkms-kapi-notifiers.h"
+#include "nvkms-hades.h"
 
 #include "nv_smg.h"
 
@@ -3455,11 +3456,61 @@ static NvBool NvKmsKapiRequestedModeSetConfigToKms(
 
         paramsHead->allowGsync = NV_TRUE;
         paramsHead->allowAdaptiveSync = NVKMS_ALLOW_ADAPTIVE_SYNC_ALL;
+
+        /* Hades: the depth that "max bpc" asks for (as nvidia-drm 615 + Hades) */
+        if (headModeSetConfig->colorBpc != 0) {
+            paramsHead->colorBpcSpecified = NV_TRUE;
+            paramsHead->colorBpc =
+                (enum NvKmsDpyAttributeColorBpcValue)headModeSetConfig->colorBpc;
+        }
     }
 
     return NV_TRUE;
 }
 
+/*
+ * Hades: what KmsSetMode() adds to the mode set of a head (nvkms-hades.h):
+ * the client's vendor InfoFrame, and its dithering as nvidia-drm 615 turns
+ * "dithering mode" into NVKMS's requested dithering
+ * (nv_drm_connector_translate_dither_mode()).
+ */
+static void NvKmsKapiHadesHeadToKms(
+    const struct NvKmsKapiHeadModeSetConfig *headModeSetConfig,
+    struct NvKmsHadesSetModeHead *pHead)
+{
+    pHead->hdmiVsifMetadata = headModeSetConfig->hdmiVsifMetadata;
+
+    pHead->ditheringSpecified = NV_TRUE;
+    pHead->ditheringMode = NV_KMS_DPY_ATTRIBUTE_REQUESTED_DITHERING_MODE_AUTO;
+
+    switch (headModeSetConfig->dithering) {
+    case NVKMS_KAPI_DITHERING_MODE_OFF:
