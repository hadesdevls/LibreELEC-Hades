+     * A change of any of them is a mode set (ApplyModeSetConfig()), which
+     * passes them to NVKMS (KmsSetMode()).
+     */
+    struct NvKmsHdmiVsifMetadata hdmiVsifMetadata;
+    enum NvKmsKapiDitheringMode dithering;
