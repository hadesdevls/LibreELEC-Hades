+++ b/src/nvidia-modeset/interface/nvkms-api-types.h
@@ -787,4 +787,24 @@ struct NvKmsVblankSemControlData {
     struct NvKmsVblankSemControlDataOneHead head[NV_MAX_HEADS];
 };
 
+/*
+ * Hades: the HDMI Vendor Specific InfoFrame (VSIF) metadata of a client, the
+ * type that nvidia-drm 615 has for NV_HDMI_VSIF_METADATA. The payload is up to
+ * 27 bytes: the IEEE OUI first, then the content of the InfoFrame.
+ * payloadSize == 0 means none; otherwise it is in
+ * [NVKMS_HDMI_VSIF_METADATA_MIN_PAYLOAD_SIZE,
+ *  NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE].
+ *
+ * No ioctl structure of this release carries it: only kernel clients pass it
+ * (NVKMS_HADES_IOCTL_SET_MODE, nvkms-hades.h), so the ioctl API that user
+ * space shares with NVKMS is the one of 580.196.07, byte for byte.
+ */
+#define NVKMS_HDMI_VSIF_METADATA_MIN_PAYLOAD_SIZE                     3
+#define NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE                     27
+
+struct NvKmsHdmiVsifMetadata {
+    NvU8 payloadSize;
+    NvU8 payload[NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE];
+};
+
 #endif /* NVKMS_API_TYPES_H */
