From 4d4370f8fc4fd842c2d0a62ba8d6858dcf45777a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:45:00 +0000
Subject: [PATCH] nvkms: HDR to a display that declares HDMI 3D, by what the
 head sends

580.196.07 refuses HDR to any display whose HDMI VSDB says 3D_present,
whether anything 3D is being sent or not. nvDpyIsHDRCapable() says no,
so a mode set or a flip with HDR metadata or BT.2100 colorimetry is
refused (nvkms-modeset.c, nvkms-flip.c), and SendHDRInfoFrame() leaves
the HDR InfoFrame out besides. HDR10 did not work with such a TV, an LG
OLED of 2016 for one. This is the change of Hades' 615
nvidia-open-kernel-modules-9042, for this driver.

The reason is the slots of the SOR. On the GPUs of this driver (Maxwell,
Pascal, Volta) the HAL sends InfoFrames with nvEvo1SendHdmiInfoFrame(),
which hands the HDR (DR&M) InfoFrame to the HDMI library as a
vendor-specific one: HDR and vendor InfoFrames share the VSI slot
(NV9171_SF_HDMI_INFO_IDX_VSI). The SOR has a second slot that can carry
a vendor InfoFrame, the generic one (NV9171_SF_HDMI_INFO_IDX_GENERIC_INFOFRAME,
HB0-HB2 and PB0-PB27), which NVKMS uses only for the EMP of HDMI VRR;
these HALs have no HDMI VRR (supportsHDMIVRR is FALSE for nvEvo94,
nvEvo97 and nvEvoC3), so it is free.

Now what the head sends decides (nvHadesHdmiSlots(), on plain values),
by its vendor InfoFrame:
 - a client's Dolby Vision VSIF: in the VSI slot, alone, as before;
 - another client's (the HDMI 1.4b one of Kodi's 3D) and NVKMS's own of
   a frame-packed mode: in the VSI slot with no SDR HDR InfoFrame written
   over it, as NVKMS sent them; with HDR (the HDR InfoFrame enabled, not
   the SDR one of a transition) and a display that takes it, the HDR
   InfoFrame in the VSI slot and the vendor one in the generic slot, built
   and sent every frame as nvEvo1SendHdmiInfoFrame() builds it, only with
   NVHDMIPKT_TYPE_GENERIC; without a free generic slot the vendor one
   keeps its slot and no HDR InfoFrame goes out, which the kernel log says
   ("Hades: head N sends no ...");
 - NVKMS's own of a 2D mode (one named by an HDMI_VIC) and none: the HDR
   InfoFrame, and the SDR one, over the vendor one, as NVKMS sends them
   to every display that does not declare 3D.
The generic slot is stopped only where an InfoFrame of Hades was in it.
On the HAL with a slot for each (SendHdmiInfoFrameCA()) the HDR InfoFrame
is simply no longer left out.

To a display that does not declare HDMI 3D this sends what 580.196.07
sent, packet by packet, for SDR, HDR10, Dolby Vision and the modes named
by an HDMI_VIC; the one thing added is the HDR InfoFrame next to a
client's vendor InfoFrame other than Dolby's, which NVKMS left out.
---
 src/nvidia-modeset/include/nvkms-evo1.h  |   8 +
 src/nvidia-modeset/include/nvkms-hades.h |  95 ++++++++++++
 src/nvidia-modeset/include/nvkms-types.h |   2 +
 src/nvidia-modeset/src/nvkms-dpy.c       |  10 +-
 src/nvidia-modeset/src/nvkms-evo1.c      |  78 +++++++++-
 src/nvidia-modeset/src/nvkms-hdmi.c      | 187 ++++++++++++++++++++++-
 6 files changed, 363 insertions(+), 17 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-evo1.h b/src/nvidia-modeset/include/nvkms-evo1.h
index 22fae9d..9d1d4dd 100644
--- a/src/nvidia-modeset/include/nvkms-evo1.h
+++ b/src/nvidia-modeset/include/nvkms-evo1.h
@@ -53,6 +53,14 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                              const NvU32 infoframeSize,
                              NvBool needChecksum);
 
+/* Hades: the generic InfoFrame slot (nvkms-hades.h, nvHadesHdmiSlots()) */
+void nvHadesEvo1SendHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
+                                         const NvU32 head,
+                                         const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                                         const NvU32 infoframeSize);
+void nvHadesEvo1DisableHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
+                                            const NvU32 head);
+
 void nvEvo1DisableHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
                                 const NvU8 nvtInfoFrameType);
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 031bc73..ca0a9df 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -187,4 +187,99 @@ static inline const char *nvHadesVsifRefusal(
     return NULL;
 }
 
+/*
+ * The two InfoFrame slots of the SOR that the HDR and vendor InfoFrames can
+ * use on the GPUs of this driver, whose HAL sends InfoFrames with
+ * nvEvo1SendHdmiInfoFrame() (Maxwell, Pascal and Volta): the vendor-specific
+ * one (NV9171_SF_HDMI_INFO_IDX_VSI), which takes the HDR (DR&M) InfoFrame too
+ * (that function hands it to the HDMI library as a vendor-specific one), and
+ * the generic one (NV9171_SF_HDMI_INFO_IDX_GENERIC_INFOFRAME, 31 bytes),
+ * which NVKMS uses only for the EMP of HDMI VRR, a HAL without HDMI VRR
+ * leaving it free (supportsHDMIVRR is FALSE for nvEvo94, nvEvo97 and nvEvoC3).
+ *
+ * 580.196.07 refuses HDR to a display that declares HDMI 3D (its HDMI VSDB
+ * says 3D_present), whether anything 3D is sent or not: nvDpyIsHDRCapable()
+ * says no, so a mode set or a flip with HDR is refused, and SendHDRInfoFrame()
+ * leaves the HDR InfoFrame out besides ("HDR is not supported with HDMI 3D due
+ * to both using VSI infoframes"). HDR10 did not work with such a TV. Here what
+ * the head sends decides, by its vendor InfoFrame (vendor), as Hades' 615
+ * does it (nvidia-open-kernel-modules-9042):
+ *  - DOLBY, the client's of Dolby Vision: in the vendor-specific slot, alone,
+ *    as before;
+ *  - CLIENT, another client's (the HDMI 1.4b one of Kodi's 3D), and
+ *    FRAME_PACKING, NVKMS's own of a frame-packed mode: in the vendor-specific
+ *    slot with no SDR HDR InfoFrame written over it, as NVKMS sent them; with
+ *    HDR (the HDR InfoFrame enabled, not the SDR one of a transition) and a
+ *    display that takes it, the HDR InfoFrame in the vendor-specific slot and
+ *    the vendor one in the generic slot, where it is free; where it is not,
+ *    the vendor one keeps its slot and no HDR InfoFrame goes out (dropped);
+ *  - NVKMS_2D, NVKMS's own of a 2D mode (one named by an HDMI_VIC), and NONE:
+ *    as NVKMS sends them to a display that does not declare 3D, the HDR
+ *    InfoFrame (and the SDR one) over the vendor one;
+ *  - an HDR10+ VSIF in the generic slot when it is free and no vendor
+ *    InfoFrame is there (else dropped); the HDR InfoFrame is never left out
+ *    for it.
+ * To a display that does not declare 3D this is what NVKMS sent, packet by
+ * packet, with one addition: the HDR InfoFrame next to a CLIENT vendor
+ * InfoFrame, which NVKMS left out.
+ */
+#define NVKMS_HADES_VENDOR_NONE          0
+#define NVKMS_HADES_VENDOR_DOLBY         1
+#define NVKMS_HADES_VENDOR_CLIENT        2
+#define NVKMS_HADES_VENDOR_FRAME_PACKING 3
+#define NVKMS_HADES_VENDOR_NVKMS_2D      4
+
+struct NvKmsHadesSlots {
+    NvBool hdr;              /* the HDR InfoFrame, in the vendor-specific slot */
+    NvBool vendorGeneric;    /* the vendor InfoFrame, in the generic slot */
+    NvBool hdr10PlusGeneric; /* the HDR10+ VSIF, in the generic slot */
+    const char *dropped;     /* what does not go out and would, or NULL */
+};
+
+static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
+                                                      NvBool hdr10Plus,
+                                                      NvBool hdrSink,
+                                                      NvBool hdrEnabled,
+                                                      NvBool genericFree)
+{
+    struct NvKmsHadesSlots s;
+
+    s.hdr = hdrSink;
+    s.vendorGeneric = NV_FALSE;
+    s.hdr10PlusGeneric = NV_FALSE;
+    s.dropped = NULL;
+
+    switch (vendor) {
+    case NVKMS_HADES_VENDOR_DOLBY:
+        s.hdr = NV_FALSE;
+        break;
+    case NVKMS_HADES_VENDOR_CLIENT:
+    case NVKMS_HADES_VENDOR_FRAME_PACKING:
+        if (!hdrSink || !hdrEnabled) {
+            s.hdr = NV_FALSE;
+        } else if (genericFree) {
+            s.vendorGeneric = NV_TRUE;
+        } else {
+            s.hdr = NV_FALSE;
+            s.dropped = "HDR InfoFrame: the vendor InfoFrame keeps the vendor-specific slot, and the generic one is not free";
+        }
+        break;
+    default:
+        break;
+    }
+
+    if (hdr10Plus && (s.dropped == NULL)) {
+        if (vendor == NVKMS_HADES_VENDOR_DOLBY) {
+            s.dropped = "HDR10+ InfoFrame: Dolby Vision is sent";
+        } else if (!genericFree) {
+            s.dropped = "HDR10+ InfoFrame: no free generic slot";
+        } else if (s.vendorGeneric) {
+            s.dropped = "HDR10+ InfoFrame: the generic slot carries the vendor InfoFrame";
+        } else {
+            s.hdr10PlusGeneric = NV_TRUE;
+        }
+    }
+    return s;
+}
+
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index b3d9dd5..bcbfaeb 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1961,6 +1961,8 @@ typedef struct _NVDispHeadStateEvoRec {
 
     NVEvoMergeMode mergeMode;
     NVHwHeadMultiTileConfigRec multiTileConfig;
+    /* Hades: the generic InfoFrame slot carries an InfoFrame of Hades */
+    NvBool hadesGenericInfoFrame;
 } NVDispHeadStateEvoRec;
 
 typedef struct _NVDispStereoParamsEvoRec {
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 93d7a9c..a3e99ea 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -3578,12 +3578,12 @@ NvBool nvDpyIsHDRCapable(const NVDpyEvoRec *pDpyEvo)
     }
 
     /*
-     * XXX HDR is not supported with HDMI 3D due to both using VSI
-     * infoframes.
+     * Hades: a display that declares HDMI 3D takes HDR too. NVKMS refused it
+     * HDR here because the HDR InfoFrame and the vendor one of HDMI 3D share a
+     * slot on most HALs; what a head sends now decides which goes where
+     * (nvHadesHdmiSlots()), and where the HAL gives each its own slot
+     * (SendHdmiInfoFrameCA()) there is nothing to decide.
      */
-    if (pInfo->HDMI3DSupported) {
-        return FALSE;
-    }
 
     // Sink should support ST2084 EOTF.
     if (!pHdrInfo->supported_eotf.smpte_st_2084_eotf) {
diff --git a/src/nvidia-modeset/src/nvkms-evo1.c b/src/nvidia-modeset/src/nvkms-evo1.c
index 3054769..233f2c6 100644
--- a/src/nvidia-modeset/src/nvkms-evo1.c
+++ b/src/nvidia-modeset/src/nvkms-evo1.c
@@ -609,12 +609,13 @@ static NVHDMIPKT_TC EvoInfoFrameToHdmiLibTransmitCtrl(
     return hdmiLibTransmitCtrl;
 }
 
-void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
-                             const NvU32 head,
-                             const NvEvoInfoFrameTransmitControl transmitCtrl,
-                             const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
-                             const NvU32 infoframeSize,
-                             NvBool needChecksum)
+static void Evo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
+                                  const NvU32 head,
+                                  const NvEvoInfoFrameTransmitControl transmitCtrl,
+                                  const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                                  const NvU32 infoframeSize,
+                                  NvBool needChecksum,
+                                  const NvBool hadesGeneric)
 {
     NVHDMIPKT_TC hdmiLibTransmitCtrl =
         EvoInfoFrameToHdmiLibTransmitCtrl(transmitCtrl, needChecksum);
@@ -656,6 +657,11 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
         return;
     }
 
+    /* Hades: the same InfoFrame, through the generic slot (below) */
+    if (hadesGeneric) {
+        hdmiLibType = NVHDMIPKT_TYPE_GENERIC;
+    }
+
     /*
      * These structures are weird. The NVT_VIDEO_INFOFRAME,
      * NVT_VENDOR_SPECIFIC_INFOFRAME, NVT_EXTENDED_METADATA_PACKET_INFOFRAME,
@@ -725,6 +731,66 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
     nvFree(infoframe);
 }
 
+void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
+                             const NvU32 head,
+                             const NvEvoInfoFrameTransmitControl transmitCtrl,
+                             const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                             const NvU32 infoframeSize,
+                             NvBool needChecksum)
+{
+    Evo1SendHdmiInfoFrame(pDispEvo, head, transmitCtrl, pInfoFrameHeader,
+                          infoframeSize, needChecksum, FALSE);
+}
+
+/*
+ * Hades: an InfoFrame through the generic InfoFrame slot of the SOR
+ * (NVHDMIPKT_TYPE_GENERIC: NV9171_SF_HDMI_INFO_IDX_GENERIC_INFOFRAME for the
+ * classes of the HDMI library from 9171 on, HB0-HB2 and PB0-PB27), built as
+ * nvEvo1SendHdmiInfoFrame() builds it for its own slot: packet type, version
+ * and length, the checksum, the payload; sent every frame (nvkms-hades.h,
+ * nvHadesHdmiSlots()). The slot is that of the EMP of HDMI VRR, which a HAL
+ * without HDMI VRR never sends.
+ */
+void nvHadesEvo1SendHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
+                                         const NvU32 head,
+                                         const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
+                                         const NvU32 infoframeSize)
+{
+    NVDispHeadStateEvoRec *pHeadState =
+        (NVDispHeadStateEvoRec *) &pDispEvo->headState[head];
+
+    Evo1SendHdmiInfoFrame(pDispEvo, head,
+                          NV_EVO_INFOFRAME_TRANSMIT_CONTROL_EVERY_FRAME,
+                          pInfoFrameHeader, infoframeSize,
+                          TRUE /* needChecksum */, TRUE /* hadesGeneric */);
+    /* the only state this keeps: that the slot carries something of Hades */
+    pHeadState->hadesGenericInfoFrame = TRUE;
+}
+
+/* Hades: the generic slot stops, if an InfoFrame of Hades is in it */
+void nvHadesEvo1DisableHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
+                                            const NvU32 head)
+{
+    NVDispHeadStateEvoRec *pHeadState =
+        (NVDispHeadStateEvoRec *) &pDispEvo->headState[head];
+    NVHDMIPKT_RESULT ret;
+
+    if (!pHeadState->hadesGenericInfoFrame) {
+        return;
+    }
+
+    ret = NvHdmiPkt_PacketCtrl(pDispEvo->pDevEvo->hdmiLib.handle,
+                               pDispEvo->displayOwner,
+                               pHeadState->activeRmId,
+                               head,
+                               NVHDMIPKT_TYPE_GENERIC,
+                               NVHDMIPKT_TRANSMIT_CONTROL_DISABLE);
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvAssert(ret == NVHDMIPKT_SUCCESS);
+    }
+    pHeadState->hadesGenericInfoFrame = FALSE;
+}
+
 void nvEvo1DisableHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                                 const NvU32 head,
                                 const NvU8 nvtInfoFrameType)
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 70e284a..123db0a 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -28,6 +28,8 @@
 
 #include "nvkms-dpy.h"
 #include "nvkms-hdmi.h"
+#include "nvkms-hades.h"
+#include "nvkms-evo1.h"
 #include "nvkms-evo.h"
 #include "nvkms-modepool.h"
 #include "nvkms-rmapi.h"
@@ -447,6 +449,165 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
         TRUE /* needChecksum */);
 }
 
+/*
+ * Hades: the HAL sends InfoFrames with nvEvo1SendHdmiInfoFrame(), whose HDR and
+ * vendor InfoFrames share the vendor-specific slot of the SOR; and its generic
+ * slot is free where the HAL has no HDMI VRR (nvkms-hades.h).
+ */
+static NvBool HadesHdmiSlotsShared(const NVDevEvoRec *pDevEvo)
+{
+    return pDevEvo->hal->SendHdmiInfoFrame == nvEvo1SendHdmiInfoFrame;
+}
+
+static NvBool HadesHdmiGenericSlotFree(const NVDevEvoRec *pDevEvo)
+{
+    return HadesHdmiSlotsShared(pDevEvo) && !pDevEvo->hal->caps.supportsHDMIVRR;
+}
+
+/*
+ * The vendor InfoFrame of the head, if it sends one: the client's
+ * (nvkms-hades.h), or NVKMS's own, as SendVendorSpecificInfoFrame() decides it.
+ */
+static NvBool HadesVendorInfoFrame(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                   NVT_EDID_INFO *pEdidInfo,
+                                   NVT_VENDOR_SPECIFIC_INFOFRAME *pFrame,
+                                   NvBool *pDolby)
+{
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pInfoFrameState->hdmiVsifMetadata;
+    NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL vendorCtrl = pInfoFrameState->vendorSpecificCtrl;
+
+    *pDolby = FALSE;
+    nvkms_memset(pFrame, 0, sizeof(*pFrame));
+
+    if (pVsif->payloadSize != 0) {
+        ct_assert(sizeof(pFrame->Data) >= sizeof(pVsif->payload));
+        pFrame->Header.type = NVT_INFOFRAME_TYPE_VENDOR_SPECIFIC;
+        pFrame->Header.version = NVT_VIDEO_INFOFRAME_VERSION_1;
+        pFrame->Header.length = pVsif->payloadSize;
+        nvkms_memcpy(&pFrame->Data, pVsif->payload, pVsif->payloadSize);
+        *pDolby = nvHadesVsifIsDolby(pVsif);
+        return TRUE;
+    }
+
+    if (!vendorCtrl.Enable ||
+        ((vendorCtrl.HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) &&
+         !pEdidInfo->HDMI3DSupported)) {
+        return FALSE;
+    }
+
+    return NvTiming_ConstructVendorSpecificInfoframe(pEdidInfo, &vendorCtrl,
+                                                     pFrame) == NVT_STATUS_SUCCESS;
+}
+
+/* The vendor InfoFrame of the head, as nvHadesHdmiSlots() names it */
+static NvU32 HadesHdmiVendor(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                             const NVT_EDID_INFO *pEdidInfo)
+{
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pInfoFrameState->hdmiVsifMetadata;
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pCtrl =
+        &pInfoFrameState->vendorSpecificCtrl;
+
+    if (pVsif->payloadSize != 0) {
+        return nvHadesVsifIsDolby(pVsif) ?
+            NVKMS_HADES_VENDOR_DOLBY : NVKMS_HADES_VENDOR_CLIENT;
+    }
+    if (!pCtrl->Enable) {
+        return NVKMS_HADES_VENDOR_NONE;
+    }
+    if (pCtrl->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) {
+        return pEdidInfo->HDMI3DSupported ?
+            NVKMS_HADES_VENDOR_FRAME_PACKING : NVKMS_HADES_VENDOR_NONE;
+    }
+    return NVKMS_HADES_VENDOR_NVKMS_2D;
+}
+
+static void HadesSendHdr10Plus(const NVDispEvoRec *pDispEvo, const NvU32 head,
+                               const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    NVT_VENDOR_SPECIFIC_INFOFRAME frame;
+
+    ct_assert(sizeof(frame.Data) >= sizeof(pVsif->payload));
+    nvkms_memset(&frame, 0, sizeof(frame));
+    frame.Header.type = NVT_INFOFRAME_TYPE_VENDOR_SPECIFIC;
+    frame.Header.version = NVT_VIDEO_INFOFRAME_VERSION_1;
+    frame.Header.length = pVsif->payloadSize;
+    nvkms_memcpy(&frame.Data, pVsif->payload, pVsif->payloadSize);
+    nvHadesEvo1SendHdmiGenericInfoFrame(pDispEvo, head, &frame.Header,
+                                        sizeof(frame.Header) + frame.Header.length);
+}
+
+/* The HDR10+ VSIF of the head (none before the HDR10+ change of Hades) */
+static const struct NvKmsHdmiVsifMetadata *
+HadesHdr10PlusOf(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState)
+{
+    (void) pInfoFrameState;
+    return NULL;
+}
+
+/* What the two slots of the SOR carry for the head (nvHadesHdmiSlots()) */
+static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
+                                               const NvU32 head,
+                                               const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                               const NVT_EDID_INFO *pEdidInfo,
+                                               NvU32 *pVendor)
+{
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
+    const struct NvKmsHdmiVsifMetadata *pHdr10Plus = HadesHdr10PlusOf(pInfoFrameState);
+    const NvU32 vendor = HadesHdmiVendor(pInfoFrameState, pEdidInfo);
+
+    if (pVendor != NULL) {
+        *pVendor = vendor;
+    }
+    return nvHadesHdmiSlots(vendor,
+                            (pHdr10Plus != NULL) && (pHdr10Plus->payloadSize != 0),
+                            pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
+                                (pHdrInfo->static_metadata_type == 1),
+                            pDispEvo->headState[head].hdrInfoFrame.state ==
+                                NVKMS_HDR_INFOFRAME_STATE_ENABLED,
+                            HadesHdmiGenericSlotFree(pDispEvo->pDevEvo));
+}
+
+/*
+ * Hades: the generic slot of the SOR, before the vendor-specific one is
+ * written: the vendor InfoFrame there, or the HDR10+ VSIF, every frame; or the
+ * slot stopped where an InfoFrame of Hades was in it
+ * (nvHadesEvo1DisableHdmiGenericInfoFrame()). The kernel log says what goes
+ * where NVKMS did not send it, and what does not go out.
+ */
+static void HadesSendGenericSlot(const NVDispEvoRec *pDispEvo,
+                                 const NvU32 head,
+                                 const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                 NVT_EDID_INFO *pEdidInfo)
+{
+    NvU32 vendor;
+    const struct NvKmsHadesSlots slots =
+        HadesHdmiSlotsOf(pDispEvo, head, pInfoFrameState, pEdidInfo, &vendor);
+    NVT_VENDOR_SPECIFIC_INFOFRAME frame;
+    NvBool dolby;
+
+    if (slots.vendorGeneric &&
+        HadesVendorInfoFrame(pInfoFrameState, pEdidInfo, &frame, &dolby)) {
+        nvHadesEvo1SendHdmiGenericInfoFrame(pDispEvo, head, &frame.Header,
+                                            sizeof(frame.Header) +
+                                            frame.Header.length);
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: head %u sends the HDR InfoFrame in the vendor-specific slot, and %s in the generic InfoFrame slot",
+                     head,
+                     (vendor == NVKMS_HADES_VENDOR_FRAME_PACKING) ?
