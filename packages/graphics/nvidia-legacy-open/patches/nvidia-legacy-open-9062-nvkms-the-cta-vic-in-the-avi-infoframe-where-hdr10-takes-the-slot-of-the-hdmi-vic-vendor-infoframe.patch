From 95ea007b8fdb0b2f16682f980d0de3efd30eb054 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:51:57 +0000
Subject: [PATCH] nvkms: the CTA VIC in the AVI InfoFrame where HDR10+ takes
 the slot of the HDMI_VIC vendor InfoFrame

On the GPUs of this driver (Maxwell, Pascal, Volta: nvEvo1SendHdmiInfoFrame(),
no HDMI VRR) the HDR InfoFrame goes in the vendor-specific slot and the
HDR10+ VSIF of 9055 in the generic slot, where 9057 puts NVKMS's HDMI_VIC
vendor InfoFrame next to HDR10. In a mode that NVKMS signals by its HDMI_VIC
(3840x2160 at 24, 25 and 30 Hz and 4096x2160 at 24 Hz to a display without
UHD_VIC; 4096x2160 at 24.000 Hz to one with it, by the integer-rate twins of
9002) NVKMS's vendor InfoFrame then went out nowhere, next to an AVI
InfoFrame with VIC 0: with HDR10+ the display was told no format at all. The
same as nvidia-open-kernel-modules-9050 does for 615.

There the AVI InfoFrame now carries the CTA VIC of the format (95, 94 and 93
for 3840x2160 at 30, 25 and 24 Hz, 98 for 4096x2160 at 24 Hz, with no picture
aspect for 98, as NVKMS builds the AVI InfoFrame of VIC 98), as NVKMS signals
these formats to a display that says UHD_VIC, and NVKMS's own vendor
InfoFrame goes out in no slot while it does (nvHadesHdr10PlusAviCtaVic()).
Only in a mode of NVKMS's own vendor InfoFrame with an HDMI_VIC and no kernel
client's VSIF; to an HDMI 2.0 sink (SCDC_Present) that lists that CTA VIC and
declares HDR10+ (any application version); while the HDR10+ VSIF goes out next
to the HDR InfoFrame, or where the AVI InfoFrame of the head carries that CTA
VIC already in the same mode (same CTA VIC, same pixel clock: "kept", so that
the AVI InfoFrame does not change in the middle of a video). The write of an
HDR10+ VSIF of a frame (nvHadesHdr10PlusWrite()) writes the AVI InfoFrame
first where it starts the CTA VIC. The kernel log says when it starts and
stops ("Hades: head N: the AVI InfoFrame says VIC V for the format of the
mode, which NVKMS names by its HDMI_VIC, so that HDR10+ takes the generic
InfoFrame slot (NVKMS's own vendor InfoFrame goes out in none while it does)";
"Hades: head N: the AVI InfoFrame and NVKMS's vendor InfoFrame say the mode
as NVKMS signals it again").

Any other display, mode or GPU goes out exactly as before (the LG C5 among
them). Not run on a GPU; a GTX 10 (or 9, or a Titan V) with an HDMI 2.0
HDR10+ display without UHD_VIC is what can show it.

Checked with a host test that runs nvUpdateHdmiInfoFrames() and
nvHadesHdr10PlusWrite() of the tree with the EVO1 HAL and the HDMI packet
library on a register file, on the EDID of a Samsung S90H, five variants of
it and four other displays: the AVI VIC, its aspect, the two slots and the
vendor InfoFrame not written, kept until another clock or Dolby Vision;
against the tree before, every step without HDR10+, and every step of the
displays and modes that do not fit, the same.
---
 src/nvidia-modeset/include/nvkms-hades.h |  92 ++++++++++++-
 src/nvidia-modeset/include/nvkms-types.h |   9 ++
 src/nvidia-modeset/src/nvkms-hdmi.c      | 160 ++++++++++++++++++++++-
 3 files changed, 255 insertions(+), 6 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 7d02bc4..0f59fd4 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -385,7 +385,10 @@ static inline const char *nvHadesVsifRefusal(
  *    HDR InfoFrame);
  *  - an HDR10+ VSIF in the generic slot when it is free and no vendor
  *    InfoFrame is there (else dropped); the HDR InfoFrame is never left out
- *    for it.
+ *    for it;
+ *  - NVKMS's vendor one of NVKMS_2D goes in no slot where the AVI InfoFrame
+ *    carries the CTA VIC of the mode for HDR10+ (aviCtaVic,
+ *    nvHadesHdr10PlusAviCtaVic()).
  * To a display that does not declare 3D this is what NVKMS sent, packet by
  * packet, with two additions: the HDR InfoFrame next to a CLIENT vendor
  * InfoFrame, which NVKMS left out, and the HDMI_VIC one in the generic slot
@@ -409,7 +412,8 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
                                                       NvBool hdrSink,
                                                       NvBool hdrEnabled,
                                                       NvBool genericFree,
-                                                      NvBool uhdVic)
+                                                      NvBool uhdVic,
+                                                      NvBool aviCtaVic)
 {
     struct NvKmsHadesSlots s;
 
@@ -434,7 +438,7 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
         }
         break;
     case NVKMS_HADES_VENDOR_NVKMS_2D:
-        if (hdrSink && hdrEnabled && !uhdVic && genericFree && !hdr10Plus) {
+        if (hdrSink && hdrEnabled && !uhdVic && genericFree && !hdr10Plus && !aviCtaVic) {
             s.vendorGeneric = NV_TRUE;
         }
         break;
@@ -456,6 +460,88 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
     return s;
 }
 
+/*
+ * HDR10+ in a mode that NVKMS signals by its HDMI_VIC (4K at 24, 25 and 30 Hz
+ * from the HDMI VSDB, 4096x2160 at 24 Hz; NVKMS_HADES_VENDOR_NVKMS_2D): the
+ * HDR InfoFrame takes the vendor-specific slot and the HDR10+ VSIF the generic
+ * one (nvHadesHdmiSlots()), so NVKMS's own vendor InfoFrame, the one that names
+ * the format, goes out nowhere, next to an AVI InfoFrame with VIC 0: the
+ * display is told no format at all. There the AVI InfoFrame carries the CTA
+ * VIC of the format instead (95, 94 and 93 for 3840x2160 at 30, 25 and 24 Hz,
+ * 98 for 4096x2160 at 24 Hz), as NVKMS signals these formats to a display
+ * whose HF-VSDB says UHD_VIC, as Hades' 615 does it on Turing, Ampere and Ada
+ * (nvidia-open-kernel-modules-9050) and i915 (linux-9982), and as Amlogic
+ * sends HDR10+ next to them; and NVKMS's own vendor InfoFrame goes out in no
+ * slot while it does, so that the two never both name the format. Only:
+ *  - in a mode of NVKMS's own vendor InfoFrame with an HDMI_VIC (ownHdmiVic, 1
+ *    to 4), with no kernel client's VSIF (clientVsif: Dolby Vision or 3D keep
+ *    their own signalling);
+ *  - to an HDMI 2.0 sink (hdmi2: SCDC_Present in its HF-VSDB) that lists that
+ *    CTA VIC in a video data block (listed) and declares HDR10+ (declares: its
+ *    HDR10+ vendor-specific video data block, of any application version);
+ *  - while the HDR10+ VSIF goes out in the generic slot next to the HDR
+ *    InfoFrame (now), or where the AVI InfoFrame of the head carries that CTA
+ *    VIC already in the same mode (kept, nvHadesHdr10PlusCtaVicKept()): the
+ *    end of HDR10+, of HDR and of the video then change nothing of the
+ *    signalling until the next change of mode, so that the AVI InfoFrame does
+ *    not change in the middle of a video.
+ * 0 elsewhere: the mode goes out exactly as before.
+ */
+static inline NvU32 nvHadesCtaVicOfHdmiVic(NvU32 hdmiVic)
+{
+    switch (hdmiVic) {
+    case 1:
+        return 95;
+    case 2:
+        return 94;
+    case 3:
+        return 93;
+    case 4:
+        return 98;
+    default:
+        return 0;
+    }
+}
+
+static inline NvU32 nvHadesHdr10PlusAviCtaVic(NvU32 ownHdmiVic,
+                                              NvBool clientVsif,
+                                              NvBool hdmi2,
+                                              NvBool listed,
+                                              NvBool declares,
+                                              NvBool now,
+                                              NvBool kept)
+{
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+
+    if ((ctaVic == 0) || clientVsif || !hdmi2 || !listed || !declares) {
+        return 0;
+    }
+    return (now || kept) ? ctaVic : 0;
+}
+
+/*
+ * kept of nvHadesHdr10PlusAviCtaVic(): the AVI InfoFrame of the head went out
+ * with the CTA VIC heldVic for HDR10+ in a mode of pixel clock heldClockKHz,
+ * and the mode of the head has that CTA VIC and that pixel clock
+ */
+static inline NvBool nvHadesHdr10PlusCtaVicKept(NvU32 heldVic,
+                                               NvU32 heldClockKHz,
+                                               NvU32 ctaVic,
+                                               NvU32 clockKHz)
+{
+    return (ctaVic != 0) && (heldVic == ctaVic) && (heldClockKHz == clockKHz);
+}
+
+/*
+ * The picture aspect ratio of the AVI InfoFrame with that CTA VIC: VIC 98 is
+ * 256:135, which M1M0 cannot say, so no data, as NVKMS builds the AVI
+ * InfoFrame of VIC 98; NVKMS's timing of HDMI_VIC 4 says 16:9.
+ */
+static inline NvBool nvHadesCtaVicAspectNoData(NvU32 ctaVic)
+{
+    return ctaVic == 98;
+}
+
 /*
  * HDR10+: the vendor InfoFrame of IEEE OUI 90-84-8B (least significant byte
  * first), 27 bytes, with the dynamic metadata of a frame, which goes out next
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index 3266f91..8dbc855 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1350,6 +1350,15 @@ typedef struct _NVEvoDevRec {
     struct {
         NvU32 numLayers;
     } apiHead[NVKMS_MAX_HEADS_PER_DISP];
+
+    /*
+     * Hades: the CTA VIC that the AVI InfoFrame of a head carries for HDR10+
+     * in place of the HDMI_VIC of its mode, per display owner and head (0 for
+     * none), and the pixel clock of that mode, in kHz
+     * (nvHadesHdr10PlusAviCtaVic())
+     */
+    NvU8 hadesAviCtaVic[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+    NvU32 hadesAviCtaClock[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
 } NVDevEvoRec;
 
 /*
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index b3e545c..7317c2c 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -412,6 +412,15 @@ static void SendHdmiGcp(const NVDispEvoRec *pDispEvo,
     }
 }
 
+static NvBool HadesHdmiSlotsShared(const NVDevEvoRec *pDevEvo);
+static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
+                                     const NvU32 head,
+                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                     const NVT_EDID_INFO *pEdidInfo);
+static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
+                               const NvU32 head,
+                               NvU32 ctaVic);
+
 /*
  * SendVideoInfoFrame() - Construct video infoframe using provided EDID and call
  * ->SendHdmiInfoFrame() to send it to RM.
@@ -481,6 +490,25 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
         }
     }
 
+    /*
+     * Hades: HDR10+ in a mode that NVKMS signals by its HDMI_VIC, where the HDR
+     * and vendor InfoFrames share the vendor-specific slot: the AVI InfoFrame
+     * carries the CTA VIC of the mode (nvHadesHdr10PlusAviCtaVic()), as it does
+     * for that CTA mode.
+     */
+    if (HadesHdmiSlotsShared(pDevEvo)) {
+        const NvU32 ctaVic =
+            HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+
+        HadesKeepAviCtaVic(pDispEvo, head, ctaVic);
+        if (ctaVic != 0) {
+            videoCtrl.video_format_id = ctaVic;
+            if (nvHadesCtaVicAspectNoData(ctaVic)) {
+                videoCtrl.pic_aspect_ratio = NVT_VIDEO_INFOFRAME_BYTE2_M1M0_NO_DATA;
+            }
+        }
+    }
+
     status = NvTiming_ConstructVideoInfoframe(pEdidInfo,
                                               &videoCtrl,
                                               NULL, &VideoInfoFrame);
@@ -615,7 +643,112 @@ static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
                             pDispEvo->headState[head].hdrInfoFrame.state ==
                                 NVKMS_HDR_INFOFRAME_STATE_ENABLED,
                             HadesHdmiGenericSlotFree(pDispEvo->pDevEvo),
-                            pEdidInfo->hdmiForumInfo.uhd_vic != 0);
+                            pEdidInfo->hdmiForumInfo.uhd_vic != 0,
+                            pDispEvo->pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] != 0);
+}
+
+/* Hades: a video data block of the EDID lists the CTA VIC vic */
+static NvBool HadesVdbListsVic(const NVT_EDID_INFO *pEdidInfo, NvU32 vic)
+{
+    const NVT_EDID_CEA861_INFO *exts[2] = { &pEdidInfo->ext861, &pEdidInfo->ext861_2 };
+    NvU32 e, i;
+
+    for (e = 0; e < 2; e++) {
+        for (i = 0; (i < exts[e]->total_svd) &&
+                    (i < NVT_CEA861_VIDEO_MAX_DESCRIPTOR); i++) {
+            if (NVT_GET_CTA_8BIT_VIC(exts[e]->video[i]) == vic) {
+                return NV_TRUE;
+            }
+        }
+    }
+    return NV_FALSE;
+}
+
+/*
+ * Hades: the CTA VIC that the AVI InfoFrame of an HDMI head carries for
+ * HDR10+ in a mode that NVKMS signals by its HDMI_VIC
+ * (nvHadesHdr10PlusAviCtaVic()); 0 for the VIC that NVKMS puts there.
+ */
+static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
+                                     const NvU32 head,
+                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                     const NVT_EDID_INFO *pEdidInfo)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const struct NvKmsHdmiVsifMetadata *pHdr10Plus = HadesHdr10PlusOf(pInfoFrameState);
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pVendor =
+        &pInfoFrameState->vendorSpecificCtrl;
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
+    const NvBool hdr10Plus = (pHdr10Plus != NULL) && (pHdr10Plus->payloadSize != 0);
+    const NvU32 ownHdmiVic =
+        (pVendor->Enable &&
+         (pVendor->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_EXT)) ?
+        pVendor->HDMI_VIC : 0;
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const NvU32 sd = pDispEvo->displayOwner;
+    NvBool now = NV_FALSE;
+
+    if (!HadesHdmiSlotsShared(pDevEvo) || (ctaVic == 0)) {
+        return 0;
+    }
+
+    /* the HDR10+ VSIF in the generic slot, the HDR InfoFrame in the vendor-specific one */
+    if (hdr10Plus &&
+        (pHeadState->hdrInfoFrame.state == NVKMS_HDR_INFOFRAME_STATE_ENABLED)) {
+        const struct NvKmsHadesSlots slots =
+            nvHadesHdmiSlots(NVKMS_HADES_VENDOR_NVKMS_2D, NV_TRUE,
+                             pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
+                                 (pHdrInfo->static_metadata_type == 1),
+                             NV_TRUE,
+                             HadesHdmiGenericSlotFree(pDevEvo),
+                             pEdidInfo->hdmiForumInfo.uhd_vic != 0,
+                             NV_FALSE);
+
+        now = slots.hdr && slots.hdr10PlusGeneric;
+    }
+
+    return nvHadesHdr10PlusAviCtaVic(
+        ownHdmiVic,
+        pInfoFrameState->hdmiVsifMetadata.payloadSize != 0,
+        pEdidInfo->hdmiForumInfo.scdc_present != 0,
+        HadesVdbListsVic(pEdidInfo, ctaVic),
+        (pEdidInfo->ext861.valid.hdr10Plus != 0) ||
+            (pEdidInfo->ext861_2.valid.hdr10Plus != 0),
+        now,
+        nvHadesHdr10PlusCtaVicKept(pDevEvo->hadesAviCtaVic[sd][head],
+                                   pDevEvo->hadesAviCtaClock[sd][head],
+                                   ctaVic,
+                                   pHeadState->timings.pixelClock));
+}
+
+/*
+ * Hades: the AVI InfoFrame of the head goes out with ctaVic for HDR10+ from
+ * here (0: with the VIC NVKMS puts there), at the pixel clock of its mode; the
+ * kernel log says when that changes.
+ */
+static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
+                               const NvU32 head,
+                               NvU32 ctaVic)
+{
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NvU32 sd = pDispEvo->displayOwner;
+    NvU8 *pVic = &pDevEvo->hadesAviCtaVic[sd][head];
+
+    if (*pVic != (NvU8)ctaVic) {
+        if (ctaVic != 0) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u: the AVI InfoFrame says VIC %u for the format of the mode, which NVKMS names by its HDMI_VIC, so that HDR10+ takes the generic InfoFrame slot (NVKMS's own vendor InfoFrame goes out in none while it does)",
+                         head, ctaVic);
+        } else {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u: the AVI InfoFrame and NVKMS's vendor InfoFrame say the mode as NVKMS signals it again",
+                         head);
+        }
+    }
+    *pVic = (NvU8)ctaVic;
+    pDevEvo->hadesAviCtaClock[sd][head] =
+        (ctaVic != 0) ? pDispEvo->headState[head].timings.pixelClock : 0;
 }
 
 /*
@@ -714,10 +847,14 @@ SendVendorSpecificInfoFrame(const NVDispEvoRec *pDispEvo,
     /*
      * Disable the vendor specific infoframe if not requested to be
      * enabled, or if HDMI 3D is requested but not supported by the monitor.
+     *
+     * Hades: and while the AVI InfoFrame carries the CTA VIC of the mode for
+     * HDR10+ (nvHadesHdr10PlusAviCtaVic()), as for that CTA mode.
      */
     if (!vendorCtrl.Enable ||
         ((vendorCtrl.HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_3D) &&
-         !pEdidInfo->HDMI3DSupported)) {
+         !pEdidInfo->HDMI3DSupported) ||
+        (pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] != 0)) {
         pDevEvo->hal->DisableHdmiInfoFrame(pDispEvo, head,
                                            NVT_INFOFRAME_TYPE_VENDOR_SPECIFIC);
         return;
@@ -893,7 +1030,8 @@ const char *nvHadesHdr10PlusRefusalOf(const NVDpyEvoRec *pDpyEvo,
         genericFree,
         vendor == NVKMS_HADES_VENDOR_DOLBY,
         nvHadesHdmiSlots(vendor, NV_TRUE, hdrSink, hdrEnabled, genericFree,
-                         pEdidInfo->hdmiForumInfo.uhd_vic != 0).vendorGeneric);
+                         pEdidInfo->hdmiForumInfo.uhd_vic != 0,
+                         NV_FALSE).vendorGeneric);
 }
 
 /*
@@ -915,6 +1053,22 @@ void nvHadesHdr10PlusWrite(NVDispEvoRec *pDispEvo, const NvU32 apiHead,
         return;
     }
     if (pHdr10Plus->payloadSize != 0) {
+        /*
+         * the AVI InfoFrame first, where the HDR10+ VSIF that starts changes its
+         * VIC (nvHadesHdr10PlusAviCtaVic(); one that ends keeps it until the
+         * next change of mode)
+         */
+        NVDpyEvoPtr pDpyEvo =
+            nvGetOneArbitraryDpyEvo(pApiHeadState->activeDpys, pDispEvo);
+
+        if ((pDpyEvo != NULL) && pDpyEvo->parsedEdid.valid && nvDpyIsHdmiEvo(pDpyEvo) &&
+            (HadesHdr10PlusAviCtaVic(pDispEvo, head, &pApiHeadState->infoFrame,
+                                     &pDpyEvo->parsedEdid.info) !=
+             pDispEvo->pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head])) {
+            SendVideoInfoFrame(pDispEvo, head, &pApiHeadState->attributes.color,
+                               &pApiHeadState->infoFrame,
+                               &pDpyEvo->parsedEdid.info);
+        }
         HadesSendHdr10Plus(pDispEvo, head, pHdr10Plus);
     } else {
         NVDpyEvoPtr pDpyEvo =
-- 
