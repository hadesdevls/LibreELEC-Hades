+/*!
+ * Hades: the HDR10+ VSIF of a frame (nvkms-hades.h): whether a dpy can carry
+ * one, whether a head would take one, or one written through a head. Kernel
+ * clients only, at the exact size.
+ */
+static NvBool HadesHdr10Plus(struct NvKmsPerOpen *pOpen,
+                             const NvU64 paramsAddress,
+                             const size_t paramSize)
+{
+    struct NvKmsHadesHdr10PlusParams *pParams;
+    struct NvKmsPerOpenDev *pOpenDev;
+    struct NvKmsPerOpenDisp *pOpenDisp;
+    NVDispEvoPtr pDispEvo;
+    const NVDispApiHeadStateEvoRec *pApiHeadState;
+    const NVDpyEvoRec *pDpyEvo;
+    NvU32 head;
+    const char *why;
+
+    if ((pOpen->clientType != NVKMS_CLIENT_KERNEL_SPACE) ||
+        (paramSize != sizeof(*pParams))) {
+        return FALSE;
+    }
+
+    pParams = nvKmsNvU64ToPointer(paramsAddress);
+
+    if (!GetPerOpenDevAndDisp(pOpen, pParams->deviceHandle, pParams->dispHandle,
+                              &pOpenDev, &pOpenDisp)) {
+        return FALSE;
+    }
+    pDispEvo = pOpenDisp->pDispEvo;
+
+    if (pParams->op == NVKMS_HADES_HDR10PLUS_QUERY) {
+        pDpyEvo = nvGetDpyEvoFromDispEvo(pDispEvo, pParams->dpyId);
+        pParams->supported = (pDpyEvo != NULL) && nvHadesHdr10PlusRoute(pDpyEvo);
+        return TRUE;
+    }
+
+    if (((pParams->op != NVKMS_HADES_HDR10PLUS_TEST) &&
+         (pParams->op != NVKMS_HADES_HDR10PLUS_SET)) ||
+        (pParams->apiHead >= pDispEvo->pDevEvo->numApiHeads) ||
+        !nvApiHeadIsActive(pDispEvo, pParams->apiHead)) {
+        return FALSE;
+    }
+
+    pApiHeadState = &pDispEvo->apiHeadState[pParams->apiHead];
+    pDpyEvo = nvGetOneArbitraryDpyEvo(pApiHeadState->activeDpys, pDispEvo);
+    head = nvGetPrimaryHwHead(pDispEvo, pParams->apiHead);
+    if ((pDpyEvo == NULL) || (head == NV_INVALID_HEAD)) {
+        return FALSE;
+    }
+
+    why = nvHadesHdr10PlusRefusalOf(
+        pDpyEvo,
+        nvCountDpyIdsInDpyIdList(pApiHeadState->activeDpys),
+        &pApiHeadState->infoFrame,
+        &pParams->hdr10PlusVsif,
+        pDispEvo->headState[head].hdrInfoFrame.state ==
+            NVKMS_HDR_INFOFRAME_STATE_ENABLED);
+    if (why != NULL) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                     "Hades: the HDR10+ InfoFrame of head %u is refused: %s",
+                     pParams->apiHead, why);
+        return FALSE;
+    }
+
+    if (pParams->op == NVKMS_HADES_HDR10PLUS_SET) {
+        nvHadesHdr10PlusWrite(pDispEvo, pParams->apiHead, &pParams->hdr10PlusVsif);
+    }
+    return TRUE;
+}
