+/*
+ * HDR10+: the vendor InfoFrame of IEEE OUI 90-84-8B (least significant byte
+ * first), 27 bytes, with the dynamic metadata of a frame, which goes out next
+ * to the HDR InfoFrame: on these GPUs through the generic slot
+ * (nvHadesHdmiSlots()). It changes with every frame, so besides a mode set it
+ * is written by NVKMS_HADES_IOCTL_HDR10PLUS, which KAPI makes right before the
+ * flip of that frame (KmsFlip()); like the ioctl of the mode set, kernel
+ * clients only. A write is not synchronized with the flip (InfoFrames are not
+ * on these GPUs): the packet goes out from the vertical blanking where it is
+ * written.
+ */
+static inline NvBool nvHadesVsifIsHdr10Plus(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return (pVsif->payloadSize == NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) &&
+           (pVsif->payload[0] == 0x8B) &&
+           (pVsif->payload[1] == 0x84) &&
+           (pVsif->payload[2] == 0x90);
+}
+
+#define NVKMS_HADES_IOCTL_HDR10PLUS 0x48440002u
+
+enum NvKmsHadesHdr10PlusOp {
+    NVKMS_HADES_HDR10PLUS_QUERY = 0, /* can a dpy carry it? */
+    NVKMS_HADES_HDR10PLUS_TEST,      /* would a head take this one? */
+    NVKMS_HADES_HDR10PLUS_SET,       /* send this one through a head */
+};
+
+struct NvKmsHadesHdr10PlusParams {
+    NvKmsDeviceHandle deviceHandle;
+    NvKmsDispHandle dispHandle;
+    NvU32 op;                                   /* enum NvKmsHadesHdr10PlusOp */
+    NvU32 apiHead;                              /* TEST, SET */
+    NVDpyId dpyId;                              /* QUERY */
+    struct NvKmsHdmiVsifMetadata hdr10PlusVsif; /* TEST, SET; payloadSize 0 stops it */
+    NvBool supported;                           /* out of QUERY */
+};
+
+/* Why a head may not send an HDR10+ VSIF, or NULL when it may. */
+static inline const char *nvHadesHdr10PlusRefusal(NvBool onConnector,
+                                                  NvBool genericFree,
+                                                  NvBool dolby,
+                                                  NvBool vendorInGeneric)
+{
+    if (!onConnector) {
+        return "the display is not driven as HDMI";
+    }
+    if (!genericFree) {
+        return "this GPU has no free generic InfoFrame slot";
+    }
+    if (dolby) {
+        return "Dolby Vision is sent";
+    }
+    if (vendorInGeneric) {
+        return "the generic slot carries the vendor InfoFrame";
+    }
+    return NULL;
+}
