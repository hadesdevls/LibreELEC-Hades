+/*
+ * Hades: the HDR10+ VSIF of each head of a flip whose HDR10+ changed, through
+ * NVKMS_HADES_IOCTL_HDR10PLUS (nvkms-hades.h), right before the flip: tested
+ * with the flip that only tests, written with the one that commits. One that
+ * NVKMS refuses fails the flip, so that the client learns it.
+ */
+static NvBool NvKmsKapiHadesFlipHdr10Plus(
+    struct NvKmsKapiDevice *device,
+    const struct NvKmsKapiRequestedModeSetConfig *requestedConfig,
+    const NvBool commit)
+{
+    NvU32 head;
+
+    for (head = 0;
+         head < ARRAY_LEN(requestedConfig->headRequestedConfig); head++) {
+        const struct NvKmsKapiHeadRequestedConfig *headRequestedConfig =
+            &requestedConfig->headRequestedConfig[head];
+        const struct NvKmsKapiHeadModeSetConfig *headModeSetConfig =
+            &headRequestedConfig->modeSetConfig;
+        struct NvKmsHadesHdr10PlusParams params = { };
+
+        if (((requestedConfig->headsMask & (1 << head)) == 0x0) ||
+            !headRequestedConfig->flags.hdr10PlusVsifChanged ||
+            (headModeSetConfig->numDisplays == 0) ||
+            !headModeSetConfig->bActive) {
+            continue;
+        }
+
+        params.deviceHandle = device->hKmsDevice;
+        params.dispHandle = device->hKmsDisp;
+        params.op = commit ? NVKMS_HADES_HDR10PLUS_SET : NVKMS_HADES_HDR10PLUS_TEST;
+        params.apiHead = head;
+        params.hdr10PlusVsif = headModeSetConfig->hdr10PlusVsif;
+
+        if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+                                   NVKMS_HADES_IOCTL_HDR10PLUS,
+                                   &params, sizeof(params))) {
+            return NV_FALSE;
+        }
+    }
+
+    return NV_TRUE;
+}
+
+/* Hades: getHdr10PlusSupported() of the functions table */
+static NvBool GetHdr10PlusSupported(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvBool *supported)
+{
+    struct NvKmsHadesHdr10PlusParams params = { };
+
+    if (device == NULL || supported == NULL) {
+        return NV_FALSE;
+    }
+
+    *supported = NV_FALSE;
+    params.deviceHandle = device->hKmsDevice;
+    params.dispHandle = device->hKmsDisp;
+    params.op = NVKMS_HADES_HDR10PLUS_QUERY;
+    params.dpyId = nvNvU32ToDpyId(display);
+
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen, NVKMS_HADES_IOCTL_HDR10PLUS,
+                               &params, sizeof(params))) {
+        return NV_FALSE;
+    }
+
+    *supported = params.supported;
+    return NV_TRUE;
+}
