+/*
+ * Hades: whether a dpy can carry an HDR10+ VSIF: a display driven as HDMI
+ * (nvHadesVsifOnConnector(), the display itself left to the head that drives
+ * it) on a GPU with a free generic slot.
+ */
+NvBool nvHadesHdr10PlusRoute(const NVDpyEvoRec *pDpyEvo)
+{
+    const NVConnectorEvoRec *pConnectorEvo = pDpyEvo->pConnectorEvo;
+
+    return HadesHdmiGenericSlotFree(pDpyEvo->pDispEvo->pDevEvo) &&
+           nvHadesVsifOnConnector(
+               pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_HDMI,
+               pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP,
+               pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS,
+               nvConnectorUsesDPLib(pConnectorEvo),
+               TRUE /* hdmiSink: the head checks it */);
+}
+
+/*
+ * Hades: why the HDR10+ VSIF of a mode set or of a frame would not go out, or
+ * NULL: the rules of nvHadesHdr10PlusRefusal(), on the values of the head.
+ * vendorInGeneric is whether nvHadesHdmiSlots() puts a vendor InfoFrame in
+ * the generic slot: a 3D or client's one, with the HDR InfoFrame enabled.
+ */
+const char *nvHadesHdr10PlusRefusalOf(const NVDpyEvoRec *pDpyEvo,
+                                      const NvU32 numDpys,
+                                      const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                                      const struct NvKmsHdmiVsifMetadata *pHdr10Plus,
+                                      const NvBool hdrEnabled)
+{
+    NVT_EDID_INFO *pEdidInfo = (NVT_EDID_INFO *) &pDpyEvo->parsedEdid.info;
+    const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
+    const NVConnectorEvoRec *pConnectorEvo = pDpyEvo->pConnectorEvo;
+    const NvBool genericFree = HadesHdmiGenericSlotFree(pDpyEvo->pDispEvo->pDevEvo);
+    NvU32 vendor;
+    NvBool hdrSink;
+
+    if (pHdr10Plus->payloadSize == 0) {
+        return NULL;
+    }
+    if (!nvHadesVsifIsHdr10Plus(pHdr10Plus)) {
+        return "it is not an HDR10+ vendor InfoFrame";
+    }
+    if (numDpys != 1) {
+        return "the head does not drive exactly one display";
+    }
+
+    vendor = pDpyEvo->parsedEdid.valid ?
+             HadesHdmiVendor(pInfoFrameState, pEdidInfo) : NVKMS_HADES_VENDOR_NONE;
+    hdrSink = pDpyEvo->parsedEdid.valid &&
+              pHdrInfo->supported_eotf.smpte_st_2084_eotf &&
+              (pHdrInfo->static_metadata_type == 1);
+
+    return nvHadesHdr10PlusRefusal(
+        nvHadesVsifOnConnector(
+            pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_HDMI,
+            pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP,
+            pConnectorEvo->signalFormat == NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS,
+            nvConnectorUsesDPLib(pConnectorEvo),
+            nvDpyIsHdmiEvo(pDpyEvo)),
+        genericFree,
+        vendor == NVKMS_HADES_VENDOR_DOLBY,
+        nvHadesHdmiSlots(vendor, NV_TRUE, hdrSink, hdrEnabled, genericFree).vendorGeneric);
+}
+
+/*
+ * Hades: the HDR10+ VSIF of a frame (NVKMS_HADES_IOCTL_HDR10PLUS): kept with
+ * the InfoFrame state of the api head, so that a later InfoFrame update sends
+ * it again, and written alone into the generic slot of its head, or that slot
+ * stopped, unless the vendor InfoFrame is in it (nvHadesHdmiSlots()).
+ */
+void nvHadesHdr10PlusWrite(NVDispEvoRec *pDispEvo, const NvU32 apiHead,
+                           const struct NvKmsHdmiVsifMetadata *pHdr10Plus)
+{
+    NVDispApiHeadStateEvoRec *pApiHeadState = &pDispEvo->apiHeadState[apiHead];
+    const NvU32 head = nvGetPrimaryHwHead(pDispEvo, apiHead);
+
+    pApiHeadState->infoFrame.hdr10PlusVsif = *pHdr10Plus;
+
+    if (head == NV_INVALID_HEAD) {
+        return;
+    }
+    if (pHdr10Plus->payloadSize != 0) {
+        HadesSendHdr10Plus(pDispEvo, head, pHdr10Plus);
+    } else {
+        const NVDpyEvoRec *pDpyEvo =
+            nvGetOneArbitraryDpyEvo(pApiHeadState->activeDpys, pDispEvo);
+
+        if ((pDpyEvo == NULL) || !pDpyEvo->parsedEdid.valid ||
+            !HadesHdmiSlotsOf(pDispEvo, head, &pApiHeadState->infoFrame,
+                              &pDpyEvo->parsedEdid.info, NULL).vendorGeneric) {
+            nvHadesEvo1DisableHdmiGenericInfoFrame(pDispEvo, head);
+        }
+    }
+}
