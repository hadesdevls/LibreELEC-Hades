+    drm_property_replace_blob(&nv_connector_state->hdr10plus_vsif, NULL);
 }
 #endif
 
@@ -737,6 +758,39 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /*
+     * Hades: HDR10PLUS_VSIF, the HDR10+ vendor InfoFrame of the frame of this
+     * commit (27 bytes, IEEE OUI 90-84-8B first), as Hades' 615 takes it: not
+     * with NV_HDMI_VSIF_METADATA. A change of it alone is carried by the flip
+     * of that frame (KAPI), not a mode set; NVKMS refuses what cannot go out.
+     */
+    {
+        const struct nv_drm_connector_state *nv_new_connector_state =
+            to_nv_drm_connector_state_const(new_connector_state);
+        const struct drm_property_blob *blob =
+            nv_new_connector_state->hdr10plus_vsif;
+        struct NvKmsHdmiVsifMetadata hdr10plus;
+
+        memset(&hdr10plus, 0, sizeof(hdr10plus));
+        if ((blob != NULL) && (blob->data != NULL)) {
+            const NvU8 *payload = blob->data;
+
+            if ((nv_new_connector_state->hdmi_vsif_metadata != NULL) ||
+                (blob->length != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) ||
+                (payload[0] != 0x8B) || (payload[1] != 0x84) ||
+                (payload[2] != 0x90)) {
+                return -EINVAL;
+            }
+            hdr10plus.payloadSize = blob->length;
+            memcpy(hdr10plus.payload, blob->data, blob->length);
+        }
+        if (memcmp(&req_config->modeSetConfig.hdr10PlusVsif, &hdr10plus,
+                   sizeof(hdr10plus)) != 0) {
+            req_config->modeSetConfig.hdr10PlusVsif = hdr10plus;
+            req_config->flags.hdr10PlusVsifChanged = NV_TRUE;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
@@ -1022,6 +1076,38 @@ done:
     return connector;
 }
 
+/*
+ * Hades: HDR10PLUS_VSIF on a connector through which NVKMS can send an HDR10+
+ * vendor InfoFrame next to the HDR one (getHdr10PlusSupported() of one of its
+ * displays: a display driven as HDMI on a GPU whose generic InfoFrame slot is
+ * free). Its presence tells a client that it can give the metadata of each
+ * frame with the commit of that frame. Only while the device is not
+ * registered yet.
+ */
+void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector)
+{
+    struct drm_device *dev = nv_connector->base.dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+
+    if (nv_connector->hdr10plus ||
+        nv_dev->nv_connector_hdr10plus_vsif_property == NULL) {
+        return;
+    }
+
+    if (dev->registered) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "Connector at physical index %u can carry HDR10+, which is not offered",
+            nv_connector->physicalIndex);
+        return;
+    }
+
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdr10plus_vsif_property,
+                               0);
+    nv_connector->hdr10plus = true;
+}
