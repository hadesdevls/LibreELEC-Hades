From 5aa88d2a3b6cd11b91ab22ba7222ab41c49993ec Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:30:00 +0000
Subject: [PATCH] nvidia-drm: NV_OUTPUT_BPC, the depth at which NVKMS drives a
 connector

Hades' 615 patch nvidia-open-kernel-modules-9013, made again for
580.196.07. A client cannot know at how many bits per component its display
is driven: "max bpc" fixes 8 or leaves the choice to NVKMS. On Pascal and
Maxwell that choice over HDMI is 8 bpc whatever the display takes
(supportsHDMI10BPC is FALSE for nvEvo94 and nvEvo97, nvkms-evo2.c, and 580
has no 12 bpc output), so Kodi's "up to 10" would be wrong there.

KAPI gets getDisplayColorBpc() (NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC,
through NVKMS_IOCTL_GET_DPY_ATTRIBUTE of the existing ioctl API), and every
connector a read-only NV_OUTPUT_BPC that nvidia-drm sets after each commit
that set a head again (a mode, its displays, its colorimetry, its HDR
InfoFrame, its depth, its dithering or its vendor InfoFrame changed: on 580
each of them is a mode set): the depth NVKMS drives the connector at, 0
while it drives nothing.
---
 kernel-open/common/inc/nvkms-kapi.h           | 20 ++++++++
 kernel-open/nvidia-drm/nvidia-drm-connector.c |  7 +++
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 14 ++++++
 kernel-open/nvidia-drm/nvidia-drm-modeset.c   | 50 +++++++++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  1 +
 .../kapi/interface/nvkms-kapi.h               | 20 ++++++++
 src/nvidia-modeset/kapi/src/nvkms-kapi.c      | 39 +++++++++++++++
 7 files changed, 151 insertions(+)

diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
index b9b814f..8e69845 100644
--- a/kernel-open/common/inc/nvkms-kapi.h
+++ b/kernel-open/common/inc/nvkms-kapi.h
@@ -1657,6 +1657,26 @@ struct NvKmsKapiFunctionsTable {
     (
         struct NvKmsKapiDevice *device
     );
+
+    /*!
+     * Hades: the bits per component at which NVKMS drives a display now
+     * (NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC): 6, 8, 10 or 12.
+     *
+     * \param [in]  device   A device returned by allocateDevice().
+     *
+     * \param [in]  display  A display returned by getDisplays().
+     *
+     * \param [out] bpc      The bits per component; 0 when NVKMS does not
+     *                       say.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayColorBpc)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *bpc
+    );
 };
 
 /** @} */
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index b78bf5e..52aa328 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -947,6 +947,13 @@ nv_drm_connector_new(struct drm_device *dev,
     }
 #endif /* defined(NV_DRM_CONNECTOR_ATTACH_HDR_OUTPUT_METADATA_PROPERTY_PRESENT) */
 
+    /* Hades: the depth NVKMS drives the display at (NV_OUTPUT_BPC) */
+    if (nv_dev->nv_connector_output_bpc_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_output_bpc_property,
+                                   0);
+    }
+
     /* Register connector with DRM subsystem */
 
     ret = drm_connector_register(&nv_connector->base);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index a2be5db..a83ce6f 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -695,6 +695,20 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, on every connector: the bits per component at which
+     * NVKMS drives its display, as of the last mode set committed through
+     * this device; 0 while the connector drives nothing or when NVKMS does not
+     * say.
+     */
+    nv_dev->nv_connector_output_bpc_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_OUTPUT_BPC", 0, 16);
+    if (nv_dev->nv_connector_output_bpc_property == NULL) {
+        NV_DRM_LOG_ERR("Failed to create NV_OUTPUT_BPC property");
+        return -ENOMEM;
+    }
+
     return 0;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-modeset.c b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
index 6a9c7f6..f481bb4 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-modeset.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
@@ -27,6 +27,8 @@
 #include "nvidia-drm-priv.h"
 #include "nvidia-drm-modeset.h"
 #include "nvidia-drm-crtc.h"
+#include "nvidia-drm-connector.h"
+#include "nvidia-drm-encoder.h"
 #include "nvidia-drm-os-interface.h"
 #include "nvidia-drm-helper.h"
 
@@ -494,6 +496,54 @@ nv_drm_atomic_apply_modeset_config(struct drm_device *dev,
         }
     }
 
+    /*
+     * Hades: the depth at which NVKMS drives each connector of the commit now
+     * (NV_OUTPUT_BPC): what it chose for the mode, the display and the
+     * client's "max bpc", dithering, vendor InfoFrame and colorimetry. Asked
+     * only where the head was set again (what NVKMS chooses the depth with
+     * changed: on 580 all of these are a mode set), not for every flip. 0 for a
+     * connector that drives nothing.
+     */
+    if (commit && nv_dev->nv_connector_output_bpc_property) {
+        struct drm_connector *connector;
+        struct drm_connector_state *connector_state;
+        int j;
+
+        for_each_new_connector_in_state(state, connector, connector_state, j) {
+            NvU32 bpc = 0;
+            struct drm_crtc *head_crtc = connector_state->crtc;
+
+            if (head_crtc != NULL && head_crtc->state != NULL &&
+                head_crtc->state->active &&
+                connector_state->best_encoder != NULL) {
+                const struct nv_drm_crtc_state *nv_head_state =
+                    to_nv_crtc_state(head_crtc->state);
+                struct nv_drm_encoder *nv_encoder =
+                    to_nv_encoder(connector_state->best_encoder);
+
+                if (!nv_head_state->req_config.flags.activeChanged &&
+                    !nv_head_state->req_config.flags.displaysChanged &&
+                    !nv_head_state->req_config.flags.modeChanged &&
+                    !nv_head_state->req_config.flags.colorimetryChanged &&
+                    !nv_head_state->req_config.flags.hdrInfoFrameChanged &&
+                    !nv_head_state->req_config.flags.colorBpcChanged &&
+                    !nv_head_state->req_config.flags.ditheringChanged &&
+                    !nv_head_state->req_config.flags.hdmiVsifMetadataChanged) {
+                    continue;
+                }
+
+                if (!nvKms->getDisplayColorBpc(nv_dev->pDevice,
+                                               nv_encoder->hDisplay, &bpc)) {
+                    bpc = 0;
+                }
+            }
+
+            drm_object_property_set_value(&connector->base,
+                                          nv_dev->nv_connector_output_bpc_property,
+                                          bpc);
+        }
+    }
+
     if (commit && nv_dev->supportsSyncpts) {
         /* commit is true so we check old state */
         for_each_old_crtc_in_state(state, crtc, old_crtc_state, i) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 98004dd..a31d505 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -182,6 +182,7 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdmi_vsif_metadata_property;
     struct drm_property *nv_connector_max_bpc_property;
     struct drm_property *nv_connector_dual_mode_tmds_property;
+    struct drm_property *nv_connector_output_bpc_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index b9b814f..8e69845 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -1657,6 +1657,26 @@ struct NvKmsKapiFunctionsTable {
     (
         struct NvKmsKapiDevice *device
     );
+
+    /*!
+     * Hades: the bits per component at which NVKMS drives a display now
+     * (NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC): 6, 8, 10 or 12.
+     *
+     * \param [in]  device   A device returned by allocateDevice().
+     *
+     * \param [in]  display  A display returned by getDisplays().
+     *
+     * \param [out] bpc      The bits per component; 0 when NVKMS does not
+     *                       say.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayColorBpc)
+    (
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *bpc
+    );
 };
 
 /** @} */
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 7805771..e989ce8 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -1476,6 +1476,43 @@ done:
     return status;
 }
 
+/*
+ * Hades: the bits per component at which NVKMS drives a display now, from
+ * NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC (NvKmsDpyAttributeColorBpcValue is
+ * the number of bits); 0 when NVKMS does not say.
+ */
+static NvBool GetDisplayColorBpc(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvU32 *bpc)
+{
+    struct NvKmsGetDpyAttributeParams params = { };
+
+    if (device == NULL || bpc == NULL) {
+        return NV_FALSE;
+    }
+
+    *bpc = 0;
+
+    params.request.deviceHandle = device->hKmsDevice;
+    params.request.dispHandle   = device->hKmsDisp;
+    params.request.dpyId        = nvNvU32ToDpyId(display);
+    params.request.attribute    = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC;
+
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+                               NVKMS_IOCTL_GET_DPY_ATTRIBUTE,
+                               &params, sizeof(params))) {
+        return NV_FALSE;
+    }
+
+    if (params.reply.value < 0 || params.reply.value > 16) {
+        return NV_FALSE;
+    }
+
+    *bpc = (NvU32)params.reply.value;
+    return NV_TRUE;
+}
+
 static NvBool GetDynamicDisplayInfo(
     struct NvKmsKapiDevice *device,
     struct NvKmsKapiDynamicDisplayParams *params)
@@ -4268,6 +4305,8 @@ NvBool nvKmsKapiGetFunctionsTableInternal
     funcsTable->signalVrrSemaphore = SignalVrrSemaphore;
     funcsTable->checkLutNotifier = CheckLutNotifier;
 
+
+    funcsTable->getDisplayColorBpc = GetDisplayColorBpc;
     return NV_TRUE;
 }
 
