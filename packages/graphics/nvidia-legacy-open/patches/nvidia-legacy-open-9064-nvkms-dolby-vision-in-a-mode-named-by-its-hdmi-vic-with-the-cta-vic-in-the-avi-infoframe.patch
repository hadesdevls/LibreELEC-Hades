+    {
+        NvBool dolby;
         const NvU32 ctaVic =
-            HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+            HadesAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo, &dolby);
 
-        HadesKeepAviCtaVic(pDispEvo, head, ctaVic);
+        HadesKeepAviCtaVic(pDispEvo, head, ctaVic, dolby);
         if (ctaVic != 0) {
             videoCtrl.video_format_id = ctaVic;
             if (nvHadesCtaVicAspectNoData(ctaVic)) {
@@ -648,7 +652,7 @@ static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
 }
 
 /* Hades: a video data block of the EDID lists the CTA VIC vic */
-static NvBool HadesVdbListsVic(const NVT_EDID_INFO *pEdidInfo, NvU32 vic)
+NvBool nvHadesVdbListsVic(const NVT_EDID_INFO *pEdidInfo, NvU32 vic)
 {
     const NVT_EDID_CEA861_INFO *exts[2] = { &pEdidInfo->ext861, &pEdidInfo->ext861_2 };
     NvU32 e, i;
@@ -712,7 +716,7 @@ static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
         ownHdmiVic,
         pInfoFrameState->hdmiVsifMetadata.payloadSize != 0,
         pEdidInfo->hdmiForumInfo.scdc_present != 0,
-        HadesVdbListsVic(pEdidInfo, ctaVic),
+        nvHadesVdbListsVic(pEdidInfo, ctaVic),
         (pEdidInfo->ext861.valid.hdr10Plus != 0) ||
             (pEdidInfo->ext861_2.valid.hdr10Plus != 0),
         now,
@@ -722,21 +726,85 @@ static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
                                    pHeadState->timings.pixelClock));
 }
 
+/* Hades: the HDMI_VIC of NVKMS's own vendor InfoFrame of the head (1 to 4), or 0 */
+static NvU32 HadesOwnHdmiVic(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState)
+{
+    const NVT_VENDOR_SPECIFIC_INFOFRAME_CTRL *pVendor =
+        &pInfoFrameState->vendorSpecificCtrl;
+
+    return (pVendor->Enable &&
+            (pVendor->HDMIFormat == NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_EXT)) ?
+        pVendor->HDMI_VIC : 0;
+}
+
 /*
- * Hades: the AVI InfoFrame of the head goes out with ctaVic for HDR10+ from
- * here (0: with the VIC NVKMS puts there), at the pixel clock of its mode; the
+ * Hades: the CTA VIC that the AVI InfoFrame of an HDMI head carries in a mode
+ * that NVKMS signals by its HDMI_VIC: for HDR10+ where the HDR and vendor
+ * InfoFrames share the vendor-specific slot (HadesHdr10PlusAviCtaVic()), or
+ * else for Dolby Vision, on every HAL (nvHadesDolbyAviCtaVic()); 0 for the VIC
+ * that NVKMS puts there. *pDolby says that it is the one of Dolby Vision.
+ */
+static NvU32 HadesAviCtaVic(const NVDispEvoRec *pDispEvo,
+                            const NvU32 head,
+                            const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                            const NVT_EDID_INFO *pEdidInfo,
+                            NvBool *pDolby)
+{
+    const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    const struct NvKmsHdmiVsifMetadata *pVsif = &pInfoFrameState->hdmiVsifMetadata;
+    const NvU32 hdr10Plus =
+        HadesHdr10PlusAviCtaVic(pDispEvo, head, pInfoFrameState, pEdidInfo);
+    const NvU32 ownHdmiVic = HadesOwnHdmiVic(pInfoFrameState);
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+    const NvU32 sd = pDispEvo->displayOwner;
+    const NvBool dolbyVsif = (pVsif->payloadSize != 0) && nvHadesVsifIsDolby(pVsif);
+    NvU32 vic;
+
+    *pDolby = NV_FALSE;
+    if (hdr10Plus != 0) {
+        return hdr10Plus;
+    }
+    if (ctaVic == 0) {
+        return 0;
+    }
+
+    vic = nvHadesDolbyAviCtaVic(
+        ownHdmiVic,
+        dolbyVsif,
+        (pVsif->payloadSize != 0) && !dolbyVsif,
+        pEdidInfo->hdmiForumInfo.scdc_present != 0,
+        nvHadesVdbListsVic(pEdidInfo, ctaVic),
+        (pEdidInfo->ext861.valid.dv_static_metadata != 0) ||
+            (pEdidInfo->ext861_2.valid.dv_static_metadata != 0),
+        nvHadesHdr10PlusCtaVicKept(pDevEvo->hadesAviCtaVic[sd][head],
+                                   pDevEvo->hadesAviCtaClock[sd][head],
+                                   ctaVic,
+                                   pHeadState->timings.pixelClock));
+    *pDolby = (vic != 0);
+    return vic;
+}
