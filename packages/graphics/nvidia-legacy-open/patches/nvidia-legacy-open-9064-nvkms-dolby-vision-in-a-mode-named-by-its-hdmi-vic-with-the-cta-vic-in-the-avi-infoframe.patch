+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -413,13 +413,15 @@ static void SendHdmiGcp(const NVDispEvoRec *pDispEvo,
 }
 
 static NvBool HadesHdmiSlotsShared(const NVDevEvoRec *pDevEvo);
-static NvU32 HadesHdr10PlusAviCtaVic(const NVDispEvoRec *pDispEvo,
-                                     const NvU32 head,
-                                     const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
-                                     const NVT_EDID_INFO *pEdidInfo);
+static NvU32 HadesAviCtaVic(const NVDispEvoRec *pDispEvo,
+                            const NvU32 head,
+                            const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState,
+                            const NVT_EDID_INFO *pEdidInfo,
+                            NvBool *pDolby);
 static void HadesKeepAviCtaVic(const NVDispEvoRec *pDispEvo,
                                const NvU32 head,
-                               NvU32 ctaVic);
+                               NvU32 ctaVic,
+                               NvBool dolby);
 
 /*
  * SendVideoInfoFrame() - Construct video infoframe using provided EDID and call
@@ -492,15 +494,17 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
 
     /*
      * Hades: HDR10+ in a mode that NVKMS signals by its HDMI_VIC, where the HDR
-     * and vendor InfoFrames share the vendor-specific slot: the AVI InfoFrame
-     * carries the CTA VIC of the mode (nvHadesHdr10PlusAviCtaVic()), as it does
+     * and vendor InfoFrames share the vendor-specific slot, and Dolby Vision in
+     * such a mode on every HAL: the AVI InfoFrame carries the CTA VIC of the
+     * mode (nvHadesHdr10PlusAviCtaVic(), nvHadesDolbyAviCtaVic()), as it does
      * for that CTA mode.
