 src/nvidia-modeset/include/nvkms-hades.h |  82 +++++++++++++++++
 src/nvidia-modeset/include/nvkms-hdmi.h  |   1 +
 src/nvidia-modeset/include/nvkms-types.h |   6 +-
 src/nvidia-modeset/src/nvkms-hdmi.c      | 109 +++++++++++++++++++----
 src/nvidia-modeset/src/nvkms-modeset.c   |   5 ++
 5 files changed, 181 insertions(+), 22 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 0f59fd4..ebcf061 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -261,8 +261,18 @@ struct NvKmsHadesVsifHead {
     NvBool ownVsif;      /* the mode needs NVKMS's own HDMI 1.4b VSIF (HDMI VIC, 3D) */
     NvU32  modeHdmiVic;  /* the HDMI_VIC of the mode (nvHadesHdmiVicOfMode()), 0 for none */
     NvBool framePacked;  /* the mode is a frame-packed 3D one */
+    NvBool hdmi2;        /* the display is HDMI 2.0: SCDC_Present in its HF-VSDB */
+    NvBool ctaVicListed; /* a video data block lists the CTA VIC of modeHdmiVic */
 };
 
+static inline NvU32 nvHadesDolbyAviCtaVic(NvU32 ownHdmiVic,
+                                          NvBool dolbyVsif,
+                                          NvBool otherVsif,
+                                          NvBool hdmi2,
+                                          NvBool listed,
+                                          NvBool declares,
+                                          NvBool kept);
+
 /*
  * Why a head may not send the client's VSIF, or NULL when it may. Any VSIF
  * goes out only on HDMI and to one display (Kodi's 3D output sends the one of
@@ -342,6 +352,27 @@ static inline const char *nvHadesVsifRefusal(
         return NULL;
     }
     if (pHead->ownVsif) {
+        /*
+         * the Dolby vendor InfoFrame in a mode that NVKMS names by its
+         * HDMI_VIC: the AVI InfoFrame names it by its CTA VIC where the display
+         * reads it so (nvHadesDolbyAviCtaVic()); a frame-packed 3D mode keeps
+         * its own vendor InfoFrame
+         */
+        if (!pHead->framePacked && (pHead->modeHdmiVic != 0)) {
+            if (nvHadesDolbyAviCtaVic(pHead->modeHdmiVic, NV_TRUE, NV_FALSE,
+                                      pHead->hdmi2, pHead->ctaVicListed,
+                                      NV_FALSE, NV_FALSE) != 0) {
+                return NULL;
+            }
+            if (!pHead->hdmi2) {
+                return "the mode needs NVKMS's own HDMI vendor InfoFrame (it names the mode by its HDMI_VIC), "
+                       "and the display is not HDMI 2.0 (no SCDC_Present in its HF-VSDB), so the AVI InfoFrame "
+                       "does not name the mode by its CTA VIC with Dolby Vision";
+            }
+            return "the mode needs NVKMS's own HDMI vendor InfoFrame (it names the mode by its HDMI_VIC), "
+                   "and the display lists no CTA VIC of that format in its video data blocks, so the AVI "
+                   "InfoFrame cannot name the mode with Dolby Vision";
+        }
         return "the mode needs NVKMS's own HDMI vendor InfoFrame (an HDMI VIC or 3D)";
     }
     return NULL;
@@ -532,6 +563,57 @@ static inline NvBool nvHadesHdr10PlusCtaVicKept(NvU32 heldVic,
     return (ctaVic != 0) && (heldVic == ctaVic) && (heldClockKHz == clockKHz);
 }
 
+/*
+ * Dolby Vision in a mode that NVKMS signals by its HDMI_VIC (4K at 24, 25 and
+ * 30 Hz from the HDMI VSDB of a display without UHD_VIC, 4096x2160 at 24 Hz;
+ * their 1000/1001 rates too). The client's Dolby vendor InfoFrame (Standard,
+ * or Low-Latency over the tunnel: IEEE OUI 00-D0-46, nvHadesVsifIsDolby())
+ * goes out in the vendor-specific slot in place of NVKMS's own vendor
+ * InfoFrame, the one that names the format, next to an AVI InfoFrame with VIC
+ * 0, so the mode set that asked for it was refused (nvHadesVsifRefusal(): "the
+ * mode needs NVKMS's own HDMI vendor InfoFrame"), and Dolby Vision never went
+ * out at 4K 24, 25 or 30 Hz to such a display. There the AVI InfoFrame carries
+ * the CTA VIC of the format instead (95, 94 and 93 for 3840x2160 at 30, 25 and
+ * 24 Hz, 98 for 4096x2160 at 24 Hz), as for HDR10+ (nvHadesHdr10PlusAviCtaVic()),
+ * as Hades' 615 does it (nvidia-open-kernel-modules-9053), as Linux names these
+ * formats to an HDMI 2.0 sink (drm_mode_cea_vic() gives no HDMI_VIC to one),
+ * and as NVKMS itself names them to a display whose HF-VSDB says UHD_VIC; and
+ * NVKMS's own vendor InfoFrame goes out in no slot while it does, so that the
+ * two never both name the format. Only:
+ *  - to an HDMI 2.0 sink (hdmi2: SCDC_Present in its HF-VSDB) that lists that
+ *    CTA VIC in a video data block (listed), as for HDR10+;
+ *  - with the client's Dolby vendor InfoFrame on the head (dolbyVsif), and no
+ *    other client's vendor InfoFrame (otherVsif: the one of the Dolby Vision
+ *    signalling of HDMI 1.4b names the HDMI_VIC itself,
+ *    nvHadesVsifIsDolbyHdmi14b(), and one of 3D its own format); or, with none,
+ *    where the AVI InfoFrame of the head carries that CTA VIC already in the
+ *    same mode (kept, nvHadesHdr10PlusCtaVicKept()) and the display declares
+ *    Dolby Vision (declares: a Dolby Vision VSVDB that NVKMS parsed): the end of
+ *    Dolby Vision changes nothing of the signalling until the next change of
+ *    mode, as for HDR10+, so that the AVI InfoFrame does not change in the
+ *    middle of a mode.
+ * 0 elsewhere: such a mode set is refused as before, and the kernel log says
+ * why (nvHadesVsifRefusal()).
+ */
+static inline NvU32 nvHadesDolbyAviCtaVic(NvU32 ownHdmiVic,
+                                          NvBool dolbyVsif,
+                                          NvBool otherVsif,
+                                          NvBool hdmi2,
+                                          NvBool listed,
+                                          NvBool declares,
+                                          NvBool kept)
+{
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+
+    if ((ctaVic == 0) || otherVsif || !hdmi2 || !listed) {
+        return 0;
+    }
+    if (dolbyVsif) {
+        return ctaVic;
+    }
+    return (declares && kept) ? ctaVic : 0;
+}
