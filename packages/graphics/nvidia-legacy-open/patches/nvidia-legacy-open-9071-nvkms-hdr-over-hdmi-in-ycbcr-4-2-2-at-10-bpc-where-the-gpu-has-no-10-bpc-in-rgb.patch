From b01a31b13afed5fc4bc2e33b81f7960bcf19c9a7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 5 Nov 2026 07:39:21 +0000
Subject: [PATCH] nvkms: HDR over HDMI in YCbCr 4:2:2 at 10 bpc where the GPU
 has no 10 bpc in RGB, when asked for

The display engines of Maxwell, Pascal and Volta have no 10 bpc in RGB over
HDMI (supportsHDMI10BPC is FALSE for nvEvo94, nvEvo97 and nvEvoC3, and their
hdmiTmds10BpcMaxPClkMHz is 0), and driver 580 has no 12 bpc output at all.
So on a GeForce GTX 10 card or a TITAN V, HDR on an HDMI display goes out at
8 bpc whatever the display takes: a GTX 1060 with an LG OLED65C8, straight
or through a Denon AVR, reports HDR at 8 bits.

The same engines drive YCbCr 4:2:2 at 10 bpc over HDMI
(NVKMS_PIXEL_DEPTH_20_422, which NVIDIA's own colour space requests use),
at the clock of RGB at 8 bpc, so every mode that fits in RGB fits in it, 2160p
at 60 Hz included; 4:2:2 carries more colour than the 4:2:0 of a video.

Off by default: a new parameter of nvidia-modeset, hades_hdr_ycbcr422,
turns it on: Kodi's setting "HDR at more than 8 bits where the card sends
RGB at 8 (NVIDIA)" writes it before the mode set of each HDR video (it is
writable by root, 0644), or nvidia-modeset.hades_hdr_ycbcr422=1 on the
kernel command line. Without it NVKMS behaves here as 580.196.07 does.

With it, when a mode set signals HDR (BT.2100 colorimetry), the client fixed
neither the depth nor the colour format, NVKMS chose RGB at 8 bpc without
YCbCr 4:2:0, the display is driven as HDMI, the GPU has no 10 bpc in RGB over
HDMI, its head converts with the BT.2020 matrix (supportsYUV2020) and NVKMS
offers 4:2:2 at 10 bpc for the display (its EDID), the mode is validated in
YCbCr 4:2:2 at 10 bpc, limited range, first. If it is refused, the mode is
validated as before. The colour space conversion, the range and the AVI
InfoFrame are NVKMS's own for that format.

Not touched: SDR (its colorimetry is not BT.2100), Dolby Vision (it fixes 8
bpc through "max bpc", and its colorimetry is the default one), a depth or
format that the client fixed, YCbCr 4:2:0, DisplayPort, the GeForce GTX 900
cards of gm20x, whose engine offers 4:2:2 at 8 bpc only, and every GPU with
10 bpc in RGB over HDMI (Ampere and later).

The kernel log says it at each mode set where it happens, and when the mode
was refused so; the decision is on plain values in nvkms-hades.h for a host
test.
---
 .../nvidia-modeset/nvidia-modeset-linux.c     | 12 ++++
 .../nvidia-modeset-os-interface.h             |  1 +
 src/nvidia-modeset/include/nvkms-hades.h      | 39 +++++++++++++
 .../include/nvidia-modeset-os-interface.h     |  1 +
 src/nvidia-modeset/src/nvkms-modeset.c        | 55 +++++++++++++++++++
 5 files changed, 108 insertions(+)

diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index 46427a6..2608216 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -171,6 +171,18 @@ NvBool nvkms_hdmi_deepcolor(void)
     return hdmi_deepcolor;
 }
 
+/*
+ * Hades: HDR over HDMI in YCbCr 4:2:2 at 10 bpc where the GPU has no 10 bpc in
+ * RGB over HDMI (nvHadesHdrWantsYCbCr422()). Off by default.
+ */
+static bool hades_hdr_ycbcr422 = false;
+module_param_named(hades_hdr_ycbcr422, hades_hdr_ycbcr422, bool, 0644);
+
+NvBool nvkms_hades_hdr_ycbcr422(void)
+{
+    return hades_hdr_ycbcr422;
+}
+
 NvBool nvkms_vblank_sem_control(void)
 {
     return vblank_sem_control;
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
index 1c5783a..0c2bd82 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -115,6 +115,7 @@ NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
+NvBool nvkms_hades_hdr_ycbcr422(void); /* Hades */
 NvBool nvkms_vblank_sem_control(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 5a46a39..ad5755d 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -714,4 +714,43 @@ static inline const char *nvHadesHdr10PlusRefusal(NvBool onConnector,
     return NULL;
 }
 
+/*
+ * Whether HDR on an HDMI display goes out in YCbCr 4:2:2 at 10 bpc in place
+ * of RGB at 8 bpc. The display engines of Maxwell, Pascal and Volta have no
+ * 10 bpc in RGB over HDMI (supportsHDMI10BPC, hdmiTmds10BpcMaxPClkMHz 0), so
+ * HDR there goes out at 8 bpc whatever the display takes; YCbCr 4:2:2 at 10
+ * bpc they drive (NVKMS_PIXEL_DEPTH_20_422), at the clock of RGB at 8 bpc, so
+ * a mode that fits in RGB fits in it. 4:2:2 carries more colour than the
+ * 4:2:0 of a video. All of these:
+ *  - asked for (nvidia-modeset.hades_hdr_ycbcr422=1; off by default), and HDMI
+ *    deep colour not turned off (hdmi_deepcolor);
+ *  - the head signals HDR (BT.2100 colorimetry: an SDR or Dolby Vision output
+ *    does not), and the client fixed neither the depth (Dolby Vision fixes 8
+ *    through "max bpc") nor the colour format;
+ *  - NVKMS chose RGB at 8 bpc, without YCbCr 4:2:0;
+ *  - the display is driven as HDMI, the GPU has no 10 bpc in RGB over HDMI
+ *    (where it has, HDR gets it as NVIDIA does it), its head converts to
+ *    YCbCr with the BT.2020 matrix (supportsYUV2020), and NVKMS offers 4:2:2
+ *    at 10 bpc or more for this display (its EDID).
+ * Whether the mode is taken so is checked after this, with the mode; if it is
+ * not, the mode is set as before.
+ */
+static inline NvBool nvHadesHdrWantsYCbCr422(NvBool enabled,
+                                             NvBool hdmiDeepColor,
+                                             NvBool bt2100,
+                                             NvBool bpcRequested,
+                                             NvBool formatRequested,
+                                             NvBool rgb,
+                                             NvU32 chosenBpc,
+                                             NvBool yuv420,
+                                             NvBool hdmiSink,
+                                             NvBool hdmi10BpcRgb,
+                                             NvBool yuv2020,
+                                             NvU32 yuv422MaxBpc)
+{
+    return enabled && hdmiDeepColor && bt2100 && !bpcRequested &&
+           !formatRequested && rgb && (chosenBpc == 8) && !yuv420 &&
+           hdmiSink && !hdmi10BpcRgb && yuv2020 && (yuv422MaxBpc >= 10);
+}
+
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
index 1c5783a..0c2bd82 100644
--- a/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
+++ b/src/nvidia-modeset/os-interface/include/nvidia-modeset-os-interface.h
@@ -115,6 +115,7 @@ NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
 NvBool nvkms_hdmi_deepcolor(void);
+NvBool nvkms_hades_hdr_ycbcr422(void); /* Hades */
 NvBool nvkms_vblank_sem_control(void);
 NvBool nvkms_opportunistic_display_sync(void);
 enum NvKmsDebugForceColorSpace nvkms_debug_force_color_space(void);
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index 52111f0..1cda871 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -211,6 +211,61 @@ nvGetHwModeTimings(const NVDispEvoRec *pDispEvo,
         return FALSE;
     }
 
+    /*
+     * Hades: the GPU has no 10 bpc in RGB over HDMI (Maxwell, Pascal, Volta),
+     * so HDR would go out at 8 bpc; it goes out in YCbCr 4:2:2 at 10 bpc where
+     * that is asked for and the display takes it (nvHadesHdrWantsYCbCr422()).
+     * The mode is validated so first; if it is refused, it is validated as
+     * before. SDR, a depth or format the client fixed (Dolby Vision) and GPUs
+     * with 10 bpc in RGB over HDMI are not touched.
+     */
+    if (nvHadesHdrWantsYCbCr422(
+            nvkms_hades_hdr_ycbcr422(),
+            nvkms_hdmi_deepcolor(),
+            dpyColor.colorimetry == NVKMS_OUTPUT_COLORIMETRY_BT2100,
+            pRequestHead->colorBpcSpecified,
+            pRequestHead->colorSpaceSpecified,
+            dpyColor.format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_SPACE_RGB,
+            dpyColor.bpc,
+            pRequestHead->mode.timings.yuv420Mode != NV_YUV420_MODE_NONE,
+            nvDpyIsHdmiEvo(pDpyEvo),
+            nvDpyIsHdmiDepth30Evo(pDpyEvo),
+            pDispEvo->pDevEvo->caps.supportsYUV2020,
+            nvDpyGetOutputColorFormatInfo(pDpyEvo).yuv422.maxBpc)) {
+        NVDpyAttributeColor yuvColor = dpyColor;
+
+        yuvColor.format = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_SPACE_YCbCr422;
+        yuvColor.bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_10;
+        /* (YCbCr goes in limited range) */
+        yuvColor.range = NV_KMS_DPY_ATTRIBUTE_COLOR_RANGE_LIMITED;
+
+        if (nvValidateModeForModeset(pDpyEvo,
+                                     &pRequestHead->modeValidationParams,
+                                     &pRequestHead->mode,
+                                     &pRequestHead->viewPortSizeIn,
+                                     pRequestHead->viewPortOutSpecified ?
+                                               &pRequestHead->viewPortOut : NULL,
+                                     &yuvColor,
+                                     pTimings,
+                                     pInfoFrameCtrl,
+                                     pVSInfoFrameCtrl,
+                                     pEmpInfoFrameCtrl)) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: HDR on %s goes out in YCbCr 4:2:2 at 10 bpc: "
+                         "this GPU has no 10 bpc in RGB over HDMI",
+                         pDpyEvo->name);
+            if (pDpyColor != NULL) {
+                *pDpyColor = yuvColor;
+            }
+            return TRUE;
+        }
+
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Hades: HDR on %s stays in RGB at 8 bpc: the mode was "
+                     "refused in YCbCr 4:2:2 at 10 bpc",
+                     pDpyEvo->name);
+    }
+
     if (!nvValidateModeForModeset(pDpyEvo,
                                   &pRequestHead->modeValidationParams,
                                   &pRequestHead->mode,
-- 
2.53.0

