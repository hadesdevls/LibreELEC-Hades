+/*
+ * The passive DisplayPort dual-mode adaptor (DP++) behind the TMDS output of
+ * a DisplayPort connector, as RM reports it to NVKMS with the maximum pixel
+ * clock of the display (NV0073_CTRL_CMD_DFP_GET_DISPLAYPORT_DONGLE_INFO,
+ * DpyGetPassiveDpDongleType() of nvkms-dpy.c). RM finds an adaptor through a
+ * GPIO of the port and tells its kind by the I2C address of the dual-mode
+ * adaptors (0x80): one that answers there is an HDMI one (type 1, 165 MHz;
+ * type 2, the TMDS clock of its register), one that does not is a DVI one
+ * ("_DP2DVI: no response to i2cAddr 0x80 per DP interop guidelines. clients
+ * MUST avoid outputting HDMI even if capable.", ctrl0073dfp.h). None is
+ * reported where the port has no such GPIO or saw no adaptor: the HDMI port
+ * of a laptop wired to a dual-mode output through a level shifter on its
+ * board (an HP ZBook 17 G6), which NVKMS drives as a native one. These are the
+ * values of NV_KMS_DPY_ATTRIBUTE_HADES_DUAL_MODE_ADAPTOR and of nvidia-drm's
+ * NV_DUAL_MODE_ADAPTOR.
+ */
+#define NV_HADES_DUAL_MODE_ADAPTOR_NONE       0
+#define NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE1 1
+#define NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE2 2
+#define NV_HADES_DUAL_MODE_ADAPTOR_DVI        3
+
+/*
+ * Whether a Dolby Vision vendor InfoFrame (dolbyVision:
+ * nvHadesIsDolbyVisionVsif(), the Standard and Low-Latency ones and that of
+ * HDMI 1.4b) is refused for what is behind the connector: through the TMDS
+ * output of a DisplayPort connector (dpTmds) behind an adaptor that RM reports
+ * as a DVI one, through which NVIDIA's interface says no HDMI should go, or
+ * of a kind that this does not know. Through an HDMI adaptor, or where none
+ * is reported, as before: what an adaptor limits is the TMDS clock, which the
+ * validation of the mode keeps (nvDpyProbeMaxPixelClock()). An HDMI
+ * connector, and the DisplayPort output of a connector, are not looked at
+ * here.
+ */
+static inline NvBool nvHadesDolbyRefusedByAdaptor(NvBool dolbyVision,
+                                                  NvBool dpTmds,
+                                                  NvU32 adaptor)
+{
+    if (!dolbyVision || !dpTmds) {
+        return NV_FALSE;
+    }
+    return (adaptor != NV_HADES_DUAL_MODE_ADAPTOR_NONE) &&
+           (adaptor != NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE1) &&
+           (adaptor != NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE2);
+}
+
+/* The words of the kernel log for an adaptor (NV_HADES_DUAL_MODE_ADAPTOR_*) */
+static inline const char *nvHadesDualModeAdaptorText(NvU32 adaptor)
+{
+    switch (adaptor) {
+    case NV_HADES_DUAL_MODE_ADAPTOR_NONE:
+        return "no passive DisplayPort dual-mode adaptor reported";
+    case NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE1:
+        return "a passive DisplayPort dual-mode adaptor of type 1 that identifies itself as an HDMI one";
+    case NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE2:
+        return "a passive DisplayPort dual-mode adaptor of type 2 that identifies itself as an HDMI one";
+    case NV_HADES_DUAL_MODE_ADAPTOR_DVI:
+        return "a passive DisplayPort dual-mode adaptor that does not identify itself as an HDMI one (a DVI one, or one that does not answer at its I2C address)";
+    default:
+        return "an adaptor of a kind that Hades does not know";
+    }
+}
+
 /* What NVKMS will do with a head that sends a client's VSIF, on plain values. */
 struct NvKmsHadesVsifHead {
     NvBool hdmiConnector; /* the connector is an HDMI one */
@@ -250,6 +312,8 @@ struct NvKmsHadesVsifHead {
