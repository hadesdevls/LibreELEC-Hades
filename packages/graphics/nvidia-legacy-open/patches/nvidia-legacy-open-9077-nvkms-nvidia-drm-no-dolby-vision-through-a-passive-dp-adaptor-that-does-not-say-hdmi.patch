index 0a3d809..9be95d5 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -783,6 +783,67 @@ DpyGetPassiveDpDongleType(const NVDpyEvoRec *pDpyEvo,
     return passiveDpDongleType;
 }
 
+/*
+ * Hades: the passive DisplayPort dual-mode adaptor that RM reported
+ * (DpyGetPassiveDpDongleType()), as NV_HADES_DUAL_MODE_ADAPTOR_*
+ * (nvkms-hades.h). A DMS-59 breakout, which NVKMS takes as a native
+ * connection, is none here as there.
+ */
+static NvU8 HadesDualModeAdaptorOf(NVEvoPassiveDpDongleType type)
+{
+    switch (type) {
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2DVI:
+        return NV_HADES_DUAL_MODE_ADAPTOR_DVI;
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2HDMI_TYPE_1:
+        return NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE1;
+    case NV_EVO_PASSIVE_DP_DONGLE_DP2HDMI_TYPE_2:
+        return NV_HADES_DUAL_MODE_ADAPTOR_HDMI_TYPE2;
+    case NV_EVO_PASSIVE_DP_DONGLE_UNUSED:
+    default:
+        return NV_HADES_DUAL_MODE_ADAPTOR_NONE;
+    }
+}
+
+/*
+ * Hades: keep on the dpy the adaptor that RM reported with its maximum pixel
+ * clock, and the TMDS clock that it limits the display to (0 for none), for
+ * NV_KMS_DPY_ATTRIBUTE_HADES_DUAL_MODE_ADAPTOR and the refusal of Dolby
+ * Vision through an adaptor that does not identify itself as an HDMI one
+ * (nvkms-hw-flip.c). On the TMDS output of a DisplayPort connector the kernel
+ * log says each change.
+ */
+static void HadesKeepDualModeAdaptor(NVDpyEvoPtr pDpyEvo,
+                                     NvU8 adaptor,
+                                     NvU32 maxPclkKHz)
+{
+    const NVConnectorEvoRec *pConnectorEvo = pDpyEvo->pConnectorEvo;
+    const NvBool changed =
+        (pDpyEvo->hadesDualModeAdaptor != adaptor) ||
+        (pDpyEvo->hadesDualModeAdaptorKHz != maxPclkKHz);
+
+    pDpyEvo->hadesDualModeAdaptor = adaptor;
+    pDpyEvo->hadesDualModeAdaptorKHz = maxPclkKHz;
+
+    if (!changed || (pConnectorEvo == NULL) ||
+        (pConnectorEvo->type != NVKMS_CONNECTOR_TYPE_DP) ||
+        (pConnectorEvo->signalFormat != NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS)) {
+        return;
+    }
+
+    if (adaptor == NV_HADES_DUAL_MODE_ADAPTOR_NONE) {
+        nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_INFO,
+                     "Hades: %s: %s",
+                     pDpyEvo->name, nvHadesDualModeAdaptorText(adaptor));
+        return;
+    }
+    nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_INFO,
+                 "Hades: %s: %s, up to %u kHz%s",
+                 pDpyEvo->name, nvHadesDualModeAdaptorText(adaptor), maxPclkKHz,
+                 nvHadesDolbyRefusedByAdaptor(NV_TRUE, NV_TRUE, adaptor) ?
+                     "; no Dolby Vision goes through it (NVIDIA's driver interface says that no HDMI should)" :
+                     "");
+}
+
 /*!
  * Get the maximum allowed pixel clock for pDpyEvo.
  *
@@ -824,6 +885,8 @@ void nvDpyProbeMaxPixelClock(NVDpyEvoPtr pDpyEvo)
                      "for display device %s.", pDpyEvo->name);
         pDpyEvo->maxPixelClockKHz = 100000;
         pDpyEvo->maxSingleLinkPixelClockKHz = pDpyEvo->maxPixelClockKHz;
+        /* Hades: RM said nothing of an adaptor either */
+        HadesKeepDualModeAdaptor(pDpyEvo, NV_HADES_DUAL_MODE_ADAPTOR_NONE, 0);
         return;
     }
 
@@ -948,6 +1011,11 @@ void nvDpyProbeMaxPixelClock(NVDpyEvoPtr pDpyEvo)
                                            pDpyEvo->maxPixelClockKHz);
         pDpyEvo->maxSingleLinkPixelClockKHz = pDpyEvo->maxPixelClockKHz;
     }
+
+    /* Hades: the adaptor, for NV_DUAL_MODE_ADAPTOR and Dolby Vision (above) */
+    HadesKeepDualModeAdaptor(pDpyEvo, HadesDualModeAdaptorOf(passiveDpDongleType),
+                             (passiveDpDongleType != NV_EVO_PASSIVE_DP_DONGLE_UNUSED) ?
+                                 passiveDpDongleMaxPclkKHz : 0);
 }
 
