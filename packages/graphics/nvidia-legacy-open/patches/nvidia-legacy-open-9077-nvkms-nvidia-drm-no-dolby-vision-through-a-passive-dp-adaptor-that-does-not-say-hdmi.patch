     NvBool usesDpLib;     /* the DisplayPort library drives the dpy */
     NvBool hdmiSink;      /* GPU and display take HDMI (nvDpyIsHdmiEvo()) */
+    NvU32  dualModeAdaptor; /* Hades: the adaptor behind a DisplayPort connector's TMDS output
+                               (NV_HADES_DUAL_MODE_ADAPTOR_*) */
     NvU32  numDpys;      /* dpys on the head */
     NvBool hdrInfoFrame; /* an HDR (DR&M) InfoFrame is asked for */
     NvBool bt2100;       /* BT.2100 colorimetry */
@@ -314,6 +378,17 @@ static inline const char *nvHadesVsifRefusal(
     if (!nvHadesVsifIsDolbyVision(pVsif)) {
         return NULL;
     }
+    /*
+     * Hades: no Dolby Vision through the TMDS output of a DisplayPort connector
+     * behind a passive dual-mode adaptor that does not identify itself as an
+     * HDMI one (nvHadesDolbyRefusedByAdaptor())
+     */
+    if (nvHadesDolbyRefusedByAdaptor(NV_TRUE,
+                                     pHead->dpConnector && pHead->tmdsSignal &&
+                                         !pHead->usesDpLib,
+                                     pHead->dualModeAdaptor)) {
+        return "the display is behind a passive DisplayPort dual-mode adaptor that does not identify itself as an HDMI one (a DVI one, or one that does not answer at its I2C address); NVIDIA's driver interface says that no HDMI should go through such an adaptor, and only one that identifies itself as an HDMI one carries the tunnel";
+    }
     if (nvHadesVsifIsDolby(pVsif)) {
         if (pVsif->payloadSize != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) {
             return "a Dolby Vision vendor InfoFrame has 27 bytes";
