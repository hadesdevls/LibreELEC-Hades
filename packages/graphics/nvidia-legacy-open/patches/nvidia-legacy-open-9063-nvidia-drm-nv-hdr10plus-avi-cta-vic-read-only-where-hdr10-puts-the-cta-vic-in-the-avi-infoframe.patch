From 8f8b965586103489d042e920fe5f6fd888edf3da Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:18:32 +0000
Subject: [PATCH] nvidia-drm: NV_HDR10PLUS_AVI_CTA_VIC, read-only, where HDR10+
 puts the CTA VIC in the AVI InfoFrame

The same property as nvidia-open-kernel-modules-9052. On the GPUs of this
driver where HDR10+ goes out (Maxwell, Pascal, Volta: nvEvo1SendHdmiInfoFrame()
with its generic slot free) the HDR10+ VSIF takes the generic slot of
NVKMS's HDMI_VIC vendor InfoFrame, so in a mode that NVKMS names by its
HDMI_VIC the AVI InfoFrame carries the CTA VIC of the format while HDR10+
goes out (9062). A client that starts HDR10+ some frames after the mode set
changes the AVI InfoFrame then, in the middle of the picture: a display may
take that as a new format and resynchronise. A client that knows it can put
the HDR10+ metadata in the commit of the mode instead, and Kodi does that
where the connector says so.

NV_HDR10PLUS_AVI_CTA_VIC, read-only (DRM_MODE_PROP_IMMUTABLE, range 0..1,
value 1), is attached with HDR10PLUS_VSIF: every connector of this driver
that has it is one where 9062 applies (getHdr10PlusSupported() answers TRUE
only for a display driven as HDMI on that HAL with its generic slot free,
nvHadesHdr10PlusRoute()). Whether a given mode and display get the CTA VIC
is the rule of nvHadesHdr10PlusAviCtaVic(); the property only says that the
connector can.

Nothing that NVKMS sends changes: no InfoFrame, no mode set, no flip.

Not run on a GPU.

Checked on the host: nvHadesHdr10PlusRoute() of the tree for that HAL with
and without HDMI VRR and for another HAL, on HDMI, on a dual-mode DisplayPort
connector and on DisplayPort, and nv_drm_connector_add_hdr10plus() of the
tree fed what it answers: the property with value 1 next to HDR10PLUS_VSIF
on the HDMI connectors of that HAL and on nothing else, once, and not after
registration; mutations of each of those caught. nvidia-drm.ko and
nvidia-modeset.ko compiled against Linux 7.3 with the compiler of the image.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 13 +++++++++++--
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 11 +++++++++++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  2 ++
 3 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 20ec79e..36499bb 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1283,8 +1283,12 @@ done:
  * vendor InfoFrame next to the HDR one (getHdr10PlusSupported() of one of its
  * displays: a display driven as HDMI on a GPU whose generic InfoFrame slot is
  * free). Its presence tells a client that it can give the metadata of each
- * frame with the commit of that frame. Only while the device is not
- * registered yet.
+ * frame with the commit of that frame. And NV_HDR10PLUS_AVI_CTA_VIC, read-only
+ * and 1, with it: on every such connector the AVI InfoFrame carries the CTA VIC
+ * of a mode named by an HDMI_VIC with HDR10+ (nvHadesHdr10PlusAviCtaVic()), so
+ * HDR10+ that starts some frames after the mode set changes the AVI InfoFrame
+ * then, and a client puts it in the commit of the mode. Only while the device
+ * is not registered yet.
  */
 void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector)
 {
@@ -1307,6 +1311,11 @@ void nv_drm_connector_add_hdr10plus(struct nv_drm_connector *nv_connector)
     drm_object_attach_property(&nv_connector->base.base,
                                nv_dev->nv_connector_hdr10plus_vsif_property,
                                0);
+    if (nv_dev->nv_connector_hdr10plus_avi_cta_vic_property != NULL) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdr10plus_avi_cta_vic_property,
+                                   1);
+    }
     nv_connector->hdr10plus = true;
 }
 
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 2a68721..ffebdca 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -694,6 +694,17 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, 1 where the AVI InfoFrame carries the CTA VIC of a mode
+     * named by an HDMI_VIC with HDR10+ (nvidia-drm-connector.c)
+     */
+    nv_dev->nv_connector_hdr10plus_avi_cta_vic_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_HDR10PLUS_AVI_CTA_VIC", 0, 1);
+    if (nv_dev->nv_connector_hdr10plus_avi_cta_vic_property == NULL) {
+        return -ENOMEM;
+    }
+
     /*
      * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel: with it set,
      * NV_HDMI_VSIF_METADATA takes the Low-Latency Dolby VSIF, and NVKMS sends
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 759428f..63d4504 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -184,6 +184,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_dual_mode_tmds_property;
     struct drm_property *nv_connector_output_bpc_property;
     struct drm_property *nv_connector_hdr10plus_vsif_property;
+    /* Hades: NV_HDR10PLUS_AVI_CTA_VIC */
+    struct drm_property *nv_connector_hdr10plus_avi_cta_vic_property;
     struct drm_property *nv_connector_hdmi_dv_low_latency_property;
     struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
 
-- 
2.53.0

