From 2b5253be9e00d3069f5ac28a7e7bb78e8f321374 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:45:00 +0000
Subject: [PATCH] nvidia-drm: the EDID property with every block that NVKMS
 read

nvidia-drm gives DRM the EDID that NVKMS read with
drm_connector_update_edid_property(), which takes a struct edid and counts
its size from the extension count of the base block (drm_edid_legacy_init():
"we have no choice but to trust edid size"). The blocks that only an HDMI
Forum EEODB counts were therefore cut from the connector's EDID property and
from display_info, although NVKMS reads and parses them: parseCta861HfEeodb()
takes the EEODB's count, and NvTiming_EDIDValidationMask() flags a buffer
that does not hold as many blocks as the EEODB says, so the buffer RM
returns holds them.

User space reads the Dolby Vision block of the display from that property
(Kodi's CDisplayInfo walks every block of what it is given, EEODB ones too).
A display that puts the block in a block that only the EEODB counts is then
without Dolby Vision on NVIDIA, and with it on amdgpu and i915, which give
DRM the whole EDID (drm_edid_read_ddc()). That fits a report of a Sony
Bravia 8 II in its 4K120/VRR input mode, where Kodi on an RTX 5080 read no
Dolby Vision and an Amlogic box played it; the EDID of that TV in that mode
has not been seen.

The connector keeps the size of the buffer, and the property is made with
drm_edid_alloc() and drm_edid_connector_update(), which take that size
(Linux 6.3 and later; before, as it was). An EDID without an EEODB is the
same bytes as before.

Made again for 580.196.07, the driver of Maxwell, Pascal and Volta: the same
change, placed where its connector code is (580 has no frame-packed mode of
Hades' 3D output, which was the context of the 615 patch).
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 34 ++++++++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  2 ++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 2f0f210..ccdc338 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -45,6 +45,8 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_edid.h>
 
+#include <linux/version.h>
+
 static void nv_drm_connector_destroy(struct drm_connector *connector)
 {
     struct nv_drm_connector *nv_connector = to_nv_connector(connector);
@@ -139,6 +141,7 @@ __nv_drm_detect_encoder(struct NvKmsKapiDynamicDisplayParams *pDetectParams,
                 memcpy(nv_connector->edid,
                        pDetectParams->edid.buffer,
                        pDetectParams->edid.bufferSize);
+                nv_connector->edid_size = pDetectParams->edid.bufferSize;
             } else {
                 NV_DRM_LOG_ERR("Out of Memory");
             }
@@ -170,6 +173,7 @@ static enum drm_connector_status __nv_drm_connector_detect_internal(
         nv_drm_free(nv_connector->edid);
         nv_connector->edid = NULL;
     }
+    nv_connector->edid_size = 0;
 
     if ((pDetectParams = nv_drm_calloc(
                 1,
@@ -415,6 +419,34 @@ static struct drm_connector_funcs nv_connector_funcs = {
 #endif
 };
 
+/*
+ * Hades: the EDID property with every block that NVKMS read.
+ * drm_connector_update_edid_property() takes a struct edid and counts its size
+ * from the extension count of the base block (drm_edid_legacy_init()), so the
+ * blocks that only an HDMI Forum EEODB counts were left out of the EDID
+ * property and of display_info. A display that puts its Dolby Vision block in
+ * one of them (a TV in its HDMI 2.1 input mode) was then without Dolby Vision
+ * for user space, which reads the block from the property (Kodi). NVKMS reads
+ * and parses those blocks (parseCta861HfEeodb(), and NvTiming_EDIDValidationMask()
+ * expects the buffer to hold as many as the EEODB counts); drm_edid_alloc()
+ * takes the buffer with its real size, as i915 and amdgpu give it.
+ */
+static void nv_drm_connector_update_edid(struct drm_connector *connector,
+                                         const struct nv_drm_connector *nv_connector)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
+    const struct drm_edid *drm_edid =
+        drm_edid_alloc(nv_connector->edid, nv_connector->edid_size);
+
+    if (drm_edid != NULL) {
+        drm_edid_connector_update(connector, drm_edid);
+        drm_edid_free(drm_edid);
+        return;
+    }
+#endif
+    nv_drm_connector_update_edid_property(connector, nv_connector->edid);
+}
+
 static int nv_drm_connector_get_modes(struct drm_connector *connector)
 {
     struct drm_device *dev = connector->dev;
@@ -427,7 +459,7 @@ static int nv_drm_connector_get_modes(struct drm_connector *connector)
 
 
     if (nv_connector->edid != NULL) {
-        nv_drm_connector_update_edid_property(connector, nv_connector->edid);
+        nv_drm_connector_update_edid(connector, nv_connector);
     }
 
     while (1) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index fbf35e1..c9e2181 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -46,6 +46,8 @@ struct nv_drm_connector {
 
     struct nv_drm_encoder *nv_detected_encoder;
     struct edid *edid;
+    /* Hades: the bytes of edid, every block that NVKMS read */
+    size_t edid_size;
 
     atomic_t connection_status_dirty;
 
-- 
2.53.0

