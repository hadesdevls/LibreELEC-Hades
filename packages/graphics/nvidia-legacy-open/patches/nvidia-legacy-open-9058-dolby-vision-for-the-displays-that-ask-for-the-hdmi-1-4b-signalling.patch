From 2e31dc8c64524fc6156e9c05035241c09242a068 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:43:51 +0000
Subject: [PATCH] nvidia: Dolby Vision for the displays that ask for the HDMI
 1.4b signalling

Hades' 615 patch nvidia-open-kernel-modules-9044, made again for
580.196.07, the driver of Maxwell, Pascal and Volta. The Dolby Vision
displays of 2015 to 2018 whose Dolby VSVDB is of version 0, of version 1
in its 15-byte form, or of version 1 in its 12-byte form without
Low-Latency (the LG OLED TVs of 2016 among them) take the tunnel of Dolby
Vision Standard told by an HDMI vendor-specific InfoFrame (IEEE OUI
00-0C-03) of 24 bytes of payload in place of the Dolby one: PB4 0x20 and
PB5 the HDMI_VIC in the four 4K formats of HDMI 1.4b, else PB4 and PB5 0,
PB6 to PB24 0; and in those four formats an AVI InfoFrame with VIC 0 (the
signal of the Amlogic HDMI transmitter, CoreELEC linux-amlogic,
hdmitx_set_vsif_pkt()).

NVKMS (the decisions in nvkms-hades.h, on plain values):
 - exactly that VSIF is one of Dolby Vision, as the Dolby one is: alone in
   the vendor-specific slot, no HDR InfoFrame, no HDR10+ next to it
   (nvHadesHdmiSlots()); any other VSIF of OUI 00-0C-03 is a client's VSIF
   as before;
 - the mode set takes it with the rules of the tunnel, as the Dolby VSIF
   (nvHadesVsifRefusal(): RGB 4:4:4 at 8 bpc of full range, no dithering,
   no HDR, no BT.2100, no output transfer function), where it names the
   HDMI_VIC of the mode, or none in a mode that has none, and not in a
   frame-packed 3D mode. The rule that a Dolby VSIF is refused in a mode
   that needs NVKMS's own HDMI vendor InfoFrame does not apply to it: it
   carries the HDMI_VIC itself, and NVKMS sends it in place of its own
   (SendVendorSpecificInfoFrame()). The HDMI_VIC of the mode comes from its
   InfoFrame controls: NVKMS's own HDMI_VIC where the timing is one of the
   HDMI VSDB, else that of the CTA format of its AVI InfoFrame (VIC 95,
   94, 93 and 98 are HDMI_VIC 1, 2, 3 and 4). The kernel log says why it
   refuses;
 - where the VSIF names that HDMI_VIC, the AVI InfoFrame carries VIC 0
   (SendVideoInfoFrame()); everything else of it is as NVKMS builds it.

nvidia-drm: NV_HDMI_DV_HDMI14B, a boolean property next to
NV_HDMI_VSIF_METADATA (HDMI connectors and dual-mode DisplayPort ones),
with the contract of 615: its presence tells user space that the module
does this; its value is the consent: the atomic check refuses that VSIF
without it, and it without that VSIF, "max bpc" 8, the default colorimetry
and no HDR metadata. The console drops it with the VSIF.

Without that VSIF, every InfoFrame NVKMS builds and every verdict of the
mode set is what it was, byte for byte (a host test of NVKMS's own
functions over real EDIDs and every mode of the tunnel and others, VSIFs
near that form included). Whether a display of that class reads it so is
seen on one.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 121 +++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h |   2 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  12 ++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |   1 +
 src/nvidia-modeset/include/nvkms-hades.h      | 149 +++++++++++++++++-
 src/nvidia-modeset/src/nvkms-hdmi.c           |  37 ++++-
 src/nvidia-modeset/src/nvkms-modeset.c        |   8 +
 7 files changed, 317 insertions(+), 13 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 13b0854..20ec79e 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -320,6 +320,8 @@ nv_drm_connector_atomic_duplicate_state(struct drm_connector *connector)
     }
     nv_new_connector_state->hdmi_dv_low_latency =
         nv_old_connector_state->hdmi_dv_low_latency;
+    nv_new_connector_state->hdmi_dv_hdmi14b =
+        nv_old_connector_state->hdmi_dv_hdmi14b;
 
     return &nv_new_connector_state->base;
 }
@@ -389,6 +391,14 @@ static int nv_drm_connector_atomic_set_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+        if (val > 1) {
+            return -EINVAL;
+        }
+        nv_connector_state->hdmi_dv_hdmi14b = val;
+        return 0;
+    }
+
     /* "max bpc" and the other standard properties: DRM's core */
     return -EINVAL;
 }
@@ -425,6 +435,11 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_hdmi14b_property) {
+        *val = nv_connector_state->hdmi_dv_hdmi14b;
+        return 0;
+    }
+
     return -EINVAL;
 }
 
@@ -448,19 +463,22 @@ static void nv_drm_connector_atomic_client_restore(
 
     if ((nv_connector_state->hdmi_vsif_metadata != NULL) ||
         (nv_connector_state->hdr10plus_vsif != NULL) ||
-        nv_connector_state->hdmi_dv_low_latency) {
+        nv_connector_state->hdmi_dv_low_latency ||
+        nv_connector_state->hdmi_dv_hdmi14b) {
         NV_DRM_DEV_LOG_INFO(to_nv_device(connector->dev),
                             "[CONNECTOR:%d:%s] the console takes the display: "
                             "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s, "
-                            "NV_HDMI_DV_LOW_LATENCY %d dropped",
+                            "NV_HDMI_DV_LOW_LATENCY %d, NV_HDMI_DV_HDMI14B %d dropped",
                             connector->base.id, connector->name,
                             nv_connector_state->hdmi_vsif_metadata != NULL ? "set" : "none",
                             nv_connector_state->hdr10plus_vsif != NULL ? "set" : "none",
-                            nv_connector_state->hdmi_dv_low_latency);
+                            nv_connector_state->hdmi_dv_low_latency,
+                            nv_connector_state->hdmi_dv_hdmi14b);
     }
     drm_property_replace_blob(&nv_connector_state->hdmi_vsif_metadata, NULL);
     drm_property_replace_blob(&nv_connector_state->hdr10plus_vsif, NULL);
     nv_connector_state->hdmi_dv_low_latency = false;
+    nv_connector_state->hdmi_dv_hdmi14b = false;
 }
 #endif
 
@@ -756,6 +774,73 @@ static int nv_drm_connector_check_dv_low_latency(bool low_latency,
     return 0;
 }
 
+/*
+ * Hades: Dolby Vision for a display that asks for the signalling of HDMI 1.4b,
+ * as Hades' 615 (nvidia-open-kernel-modules-9044): the tunnel of Dolby Vision
+ * Standard, told to the display by an HDMI vendor InfoFrame of 24 bytes in
+ * place of the Dolby one: IEEE OUI 00-0C-03, then PB4 0x20 and PB5 the HDMI_VIC
+ * of one of the four 4K formats of HDMI 1.4b, or PB4 and PB5 0, and PB6 to
+ * PB24 0 (nvHadesVsifIsDolbyHdmi14b() of nvkms-hades.h, of which this is a
+ * copy). In those four formats NVKMS sends the AVI InfoFrame with VIC 0 next
+ * to it, and it refuses the mode set where that VSIF does not name the
+ * HDMI_VIC of the mode. So that the AVI InfoFrame never says other than what
+ * user space asked for: NV_HDMI_VSIF_METADATA takes that VSIF only with
+ * NV_HDMI_DV_HDMI14B set, and NV_HDMI_DV_HDMI14B is taken only with that
+ * VSIF, "max bpc" 8, the default colorimetry and no HDR metadata, as for
+ * Low-Latency. Returns 0 or -EINVAL.
+ */
+static bool nv_drm_vsif_is_dolby_hdmi14b(const uint8_t *payload, size_t size)
+{
+    size_t i;
+
+    if ((size != 24) || (payload[0] != 0x03) || (payload[1] != 0x0c) ||
+        (payload[2] != 0x00)) {
+        return false;
+    }
+    if (payload[3] == 0x20) {
+        if ((payload[4] < 1) || (payload[4] > 4)) {
+            return false;
+        }
+    } else if ((payload[3] != 0x00) || (payload[4] != 0x00)) {
+        return false;
+    }
+    for (i = 5; i < size; i++) {
+        if (payload[i] != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int nv_drm_connector_check_dv_hdmi14b(bool hdmi14b,
+                                             const uint8_t *vsif,
+                                             size_t vsif_size,
+                                             NvU32 bpc,
+                                             bool default_colorimetry,
+                                             bool hdr_metadata,
+                                             const char **why)
+{
+    const bool hdmi14b_vsif =
+        (vsif != NULL) && nv_drm_vsif_is_dolby_hdmi14b(vsif, vsif_size);
+
+    if (hdmi14b_vsif && !hdmi14b) {
+        *why = "a Dolby Vision VSIF of HDMI 1.4b needs NV_HDMI_DV_HDMI14B";
+        return -EINVAL;
+    }
+    if (!hdmi14b) {
+        return 0;
+    }
+    if (!hdmi14b_vsif) {
+        *why = "NV_HDMI_DV_HDMI14B needs the Dolby Vision VSIF of HDMI 1.4b";
+        return -EINVAL;
+    }
+    if ((bpc != 8) || !default_colorimetry || hdr_metadata) {
+        *why = "NV_HDMI_DV_HDMI14B needs \"max bpc\" 8, the default colorimetry and no HDR metadata";
+        return -EINVAL;
+    }
+    return 0;
+}
+
 static int
 __nv_drm_connector_atomic_check(struct drm_connector *connector,
                                 nv_drm_atomic_state_base_t *state)
@@ -877,6 +962,29 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /* Hades: Dolby Vision for the signalling of HDMI 1.4b (above) */
+    {
+        const struct nv_drm_connector_state *nv_new_connector_state =
+            to_nv_drm_connector_state_const(new_connector_state);
+        const struct drm_property_blob *vsif =
+            nv_new_connector_state->hdmi_vsif_metadata;
+        const char *why = NULL;
+        int ret = nv_drm_connector_check_dv_hdmi14b(
+            nv_new_connector_state->hdmi_dv_hdmi14b,
+            (vsif && vsif->data) ? vsif->data : NULL,
+            (vsif && vsif->data) ? vsif->length : 0,
+            nv_drm_connector_requested_bpc(new_connector_state),
+            new_connector_state->colorspace == DRM_MODE_COLORIMETRY_DEFAULT,
+            new_connector_state->hdr_output_metadata != NULL,
+            &why);
+
+        if (ret != 0) {
+            NV_DRM_DEV_LOG_INFO(nv_dev, "[CONNECTOR:%d:%s] refused: %s",
+                                connector->base.id, connector->name, why);
+            return ret;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
@@ -1070,6 +1178,10 @@ nv_drm_connector_new(struct drm_device *dev,
         drm_object_attach_property(&nv_connector->base.base,
                                    nv_dev->nv_connector_hdmi_dv_low_latency_property,
                                    0);
+        /* Hades: Dolby Vision for the signalling of HDMI 1.4b */
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
+                                   0);
         nv_connector->base.max_bpc_property =
             nv_dev->nv_connector_max_bpc_property;
         drm_object_attach_property(&nv_connector->base.base,
@@ -1246,6 +1358,9 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
     drm_object_attach_property(&nv_connector->base.base,
                                nv_dev->nv_connector_hdmi_dv_low_latency_property,
                                0);
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
+                               0);
 #endif
 
     if (nv_connector->base.max_bpc_property == NULL) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 6fbb47a..6de114b 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -142,6 +142,8 @@ struct nv_drm_connector_state {
     struct drm_property_blob *hdr10plus_vsif;
     /* Hades: NV_HDMI_DV_LOW_LATENCY */
     bool hdmi_dv_low_latency;
+    /* Hades: NV_HDMI_DV_HDMI14B */
+    bool hdmi_dv_hdmi14b;
 };
 
 static inline struct nv_drm_connector_state *to_nv_drm_connector_state(
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 5883a20..2a68721 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -705,6 +705,18 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: Dolby Vision for a display that asks for the signalling of HDMI
+     * 1.4b: with it set, NV_HDMI_VSIF_METADATA takes the HDMI vendor InfoFrame
+     * of that signalling, and NVKMS sends the AVI InfoFrame with VIC 0 in the
+     * four 4K formats of HDMI 1.4b (nvkms-hades.h)
+     */
+    nv_dev->nv_connector_hdmi_dv_hdmi14b_property =
+        drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_DV_HDMI14B");
+    if (nv_dev->nv_connector_hdmi_dv_hdmi14b_property == NULL) {
+        return -ENOMEM;
+    }
+
     /*
      * Hades: read-only, on dual-mode DisplayPort connectors: 1 while the
      * display is driven through the TMDS output of the GPU (HDMI).
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 58e913e..759428f 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -185,6 +185,7 @@ struct nv_drm_device {
     struct drm_property *nv_connector_output_bpc_property;
     struct drm_property *nv_connector_hdr10plus_vsif_property;
     struct drm_property *nv_connector_hdmi_dv_low_latency_property;
+    struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 9300e9a..7d02bc4 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -82,6 +82,119 @@ static inline NvBool nvHadesVsifIsDolby(const struct NvKmsHdmiVsifMetadata *pVsi
            (pVsif->payload[2] == 0x00);
 }
 
+/*
+ * Dolby Vision for a display that asks for the signalling of HDMI 1.4b (Hades'
+ * 615, nvidia-open-kernel-modules-9044): its Dolby Vision VSVDB of version 0,
+ * of version 1 in its 15-byte form, or of version 1 in its 12-byte form
+ * without Low-Latency (the LG OLED TVs of 2016, and other displays of 2015 to
+ * 2018). The tunnel is that of Dolby Vision Standard (RGB 4:4:4 at 8 bpc of
+ * full range, no HDR InfoFrame, the bytes as they are); what tells the display
+ * is an HDMI vendor InfoFrame (IEEE OUI 00-0C-03, least significant byte
+ * first) of 24 bytes of payload in place of the Dolby one: PB4 0x20 and PB5 the
+ * HDMI_VIC in the four 4K formats of HDMI 1.4b (1: 3840x2160 at 30 Hz, 2: at
+ * 25 Hz, 3: at 24 Hz, 4: 4096x2160 at 24 Hz; their 1000/1001 rates too), PB4
+ * and PB5 0 in any other mode, and PB6 to PB24 0: the signal of the Amlogic
+ * HDMI transmitter (CoreELEC linux-amlogic, hdmitx_set_vsif_pkt()). In those
+ * four formats the AVI InfoFrame carries VIC 0 (nvHadesDolbyHdmi14bAviVic0()),
+ * as HDMI 1.4b has it where its vendor InfoFrame names the format; it is
+ * otherwise the AVI InfoFrame of the tunnel. Exactly that form is this VSIF;
+ * any other of OUI 00-0C-03 is a client's VSIF as before.
+ */
+#define NVKMS_HADES_DV_HDMI14B_PAYLOAD_SIZE 24
+
+static inline NvBool nvHadesVsifIsDolbyHdmi14b(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    NvU32 i;
+
+    if ((pVsif->payloadSize != NVKMS_HADES_DV_HDMI14B_PAYLOAD_SIZE) ||
+        (pVsif->payload[0] != 0x03) ||
+        (pVsif->payload[1] != 0x0C) ||
+        (pVsif->payload[2] != 0x00)) {
+        return NV_FALSE;
+    }
+    if (pVsif->payload[3] == 0x20) {
+        if ((pVsif->payload[4] < 1) || (pVsif->payload[4] > 4)) {
+            return NV_FALSE;
+        }
+    } else if ((pVsif->payload[3] != 0x00) || (pVsif->payload[4] != 0x00)) {
+        return NV_FALSE;
+    }
+    for (i = 5; i < NVKMS_HADES_DV_HDMI14B_PAYLOAD_SIZE; i++) {
+        if (pVsif->payload[i] != 0) {
+            return NV_FALSE;
+        }
+    }
+    return NV_TRUE;
+}
+
+/* The HDMI_VIC that such a VSIF names: PB5 with PB4 0x20, else 0 */
+static inline NvU32 nvHadesDolbyHdmi14bVic(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return (pVsif->payload[3] == 0x20) ? pVsif->payload[4] : 0;
+}
+
+/* Whether a client's VSIF is one of Dolby Vision: the Dolby one, or that of HDMI 1.4b */
+static inline NvBool nvHadesVsifIsDolbyVision(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return nvHadesVsifIsDolby(pVsif) || nvHadesVsifIsDolbyHdmi14b(pVsif);
+}
+
+/*
+ * The HDMI_VIC of the mode of a head, from its InfoFrame controls: the one of
+ * NVKMS's own HDMI vendor InfoFrame where it names one (ownVsif, ownFormat
+ * NV_HADES_HDMI_VID_FMT_EXT, ownHdmiVic: a timing of the HDMI VSDB,
+ * NVT_TYPE_HDMI_EXT, whose AVI VIC NVKMS makes 0), or else that of the CTA
+ * format that the AVI InfoFrame names (aviVic): VIC 95, 94 and 93 (3840x2160
+ * at 30, 25 and 24 Hz, 16:9) are HDMI_VIC 1, 2 and 3, VIC 98 (4096x2160 at
+ * 24 Hz, 256:135) is 4. 0 for any other mode. And whether the mode is a
+ * frame-packed 3D one (NVKMS's own vendor InfoFrame of format 3D). The formats
+ * are those of HDMI_Video_Format in the HDMI vendor InfoFrame (HDMI 1.4b, the
+ * NVT_HDMI_VS_BYTE4_HDMI_VID_FMT_* of nvtiming.h).
+ */
+#define NV_HADES_HDMI_VID_FMT_EXT 0x01
+#define NV_HADES_HDMI_VID_FMT_3D  0x02
+
+static inline NvU32 nvHadesHdmiVicOfMode(NvU32 aviVic,
+                                         NvBool ownVsif,
+                                         NvU32 ownFormat,
+                                         NvU32 ownHdmiVic)
+{
+    if (ownVsif && (ownFormat == NV_HADES_HDMI_VID_FMT_EXT) &&
+        (ownHdmiVic >= 1) && (ownHdmiVic <= 4)) {
+        return ownHdmiVic;
+    }
+    switch (aviVic) {
+    case 95:
+        return 1;
+    case 94:
+        return 2;
+    case 93:
+        return 3;
+    case 98:
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static inline NvBool nvHadesModeIsFramePacked(NvBool ownVsif, NvU32 ownFormat)
+{
+    return ownVsif && (ownFormat == NV_HADES_HDMI_VID_FMT_3D);
+}
+
+/*
+ * Whether the AVI InfoFrame of a head says VIC 0 because of that VSIF: it
+ * names an HDMI_VIC, and that is the one of the mode. Any other head keeps the
+ * VIC that NVKMS puts in it.
+ */
+static inline NvBool nvHadesDolbyHdmi14bAviVic0(const struct NvKmsHdmiVsifMetadata *pVsif,
+                                                NvU32 modeHdmiVic)
+{
+    return nvHadesVsifIsDolbyHdmi14b(pVsif) &&
+           (nvHadesDolbyHdmi14bVic(pVsif) != 0) &&
+           (nvHadesDolbyHdmi14bVic(pVsif) == modeHdmiVic);
+}
+
 /*
  * Whether a client's vendor InfoFrame can go out through a connector (Hades'
  * 615, nvidia-open-kernel-modules-9010): on an HDMI connector, and on a
@@ -146,6 +259,8 @@ struct NvKmsHadesVsifHead {
     NvBool dithering;    /* the dithering NVKMS chose for the head */
     NvBool outputTf;     /* an output transfer function */
     NvBool ownVsif;      /* the mode needs NVKMS's own HDMI 1.4b VSIF (HDMI VIC, 3D) */
+    NvU32  modeHdmiVic;  /* the HDMI_VIC of the mode (nvHadesHdmiVicOfMode()), 0 for none */
+    NvBool framePacked;  /* the mode is a frame-packed 3D one */
 };
 
 /*
@@ -159,6 +274,12 @@ struct NvKmsHadesVsifHead {
  * (PB4 bits 0 and 1: low_latency and the Dolby Vision signal) goes with the
  * same tunnel, and its AVI InfoFrame says YCbCr 4:2:2
  * (nvHadesDolbyLowLatencyAvi()); low_latency without the signal is refused.
+ * The HDMI one of the signalling of HDMI 1.4b (nvHadesVsifIsDolbyHdmi14b())
+ * goes with the same tunnel too, where it names the HDMI_VIC of the mode (or
+ * none in a mode that has none), so that the AVI InfoFrame and the VSIF never
+ * say two formats; in its place NVKMS sends no HDMI vendor InfoFrame of its
+ * own, and in a frame-packed 3D mode, whose vendor InfoFrame is NVKMS's, it is
+ * refused.
  */
 static inline const char *nvHadesVsifRefusal(
     const struct NvKmsHdmiVsifMetadata *pVsif,
@@ -179,14 +300,16 @@ static inline const char *nvHadesVsifRefusal(
     if (pHead->numDpys != 1) {
         return "the head does not drive exactly one display";
     }
-    if (!nvHadesVsifIsDolby(pVsif)) {
+    if (!nvHadesVsifIsDolbyVision(pVsif)) {
         return NULL;
     }
-    if (pVsif->payloadSize != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) {
-        return "a Dolby Vision vendor InfoFrame has 27 bytes";
-    }
-    if (((pVsif->payload[3] & 0x01) != 0) && ((pVsif->payload[3] & 0x02) == 0)) {
-        return "Dolby Vision Low-Latency without the Dolby Vision signal";
+    if (nvHadesVsifIsDolby(pVsif)) {
+        if (pVsif->payloadSize != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) {
+            return "a Dolby Vision vendor InfoFrame has 27 bytes";
+        }
+        if (((pVsif->payload[3] & 0x01) != 0) && ((pVsif->payload[3] & 0x02) == 0)) {
+            return "Dolby Vision Low-Latency without the Dolby Vision signal";
+        }
     }
     if (pHead->hdrInfoFrame) {
         return "an HDR InfoFrame is asked for with Dolby Vision";
@@ -209,6 +332,15 @@ static inline const char *nvHadesVsifRefusal(
     if (pHead->outputTf) {
         return "an output transfer function is set";
     }
+    if (nvHadesVsifIsDolbyHdmi14b(pVsif)) {
+        if (pHead->framePacked) {
