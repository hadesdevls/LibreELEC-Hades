From 1d7a47d291df4f92342525e103d9603c932fa5b2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:10:00 +0000
Subject: [PATCH] nvkms: the vendor InfoFrame through the TMDS output of a
 dual-mode DP connector

Hades' 615 patch nvidia-open-kernel-modules-9010, made again for 580.196.07,
the driver of Maxwell, Pascal and Volta, whose GeForce cards have
DisplayPort ports that take a passive HDMI adapter (dual-mode). Through the
TMDS output of such a connector the GPU sends HDMI itself, and NVKMS sends
AVI, HDR and audio InfoFrames there as on an HDMI connector.

The vendor InfoFrame of a client goes out on an HDMI connector, and on a
DisplayPort connector through its TMDS output, while that output drives the
display without the DisplayPort library; on the DisplayPort output of the
same connector (a DisplayPort display, an active converter) it is refused.
Unlike 615, the display has to take HDMI on an HDMI connector too
(nvDpyIsHdmiEvo()): NVKMS sends no InfoFrame to a DVI display, so a VSIF
given for one would be taken and never sent. The rule is on plain values in
nvkms-hades.h (nvHadesVsifOnConnector()), which the host test runs.
---
 src/nvidia-modeset/include/nvkms-hades.h | 34 ++++++++++++++++++++++--
 src/nvidia-modeset/src/nvkms-modeset.c   |  9 ++++++-
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index a294e3e..031bc73 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -79,9 +79,37 @@ static inline NvBool nvHadesVsifIsDolby(const struct NvKmsHdmiVsifMetadata *pVsi
            (pVsif->payload[2] == 0x00);
 }
 
+/*
+ * Whether a client's vendor InfoFrame can go out through a connector (Hades'
+ * 615, nvidia-open-kernel-modules-9010): on an HDMI connector, and on a
+ * DisplayPort connector only through its TMDS output (a dual-mode port: the
+ * display table of the board has a TMDS output of the GPU for that connector
+ * as well as its DisplayPort one, the HDMI port of some laptops behind a
+ * level shifter, or a DisplayPort port with a passive HDMI adapter), while
+ * that output drives the display, not through the DisplayPort library. Unlike
+ * 615, the display has to take HDMI on an HDMI connector too: NVKMS sends no
+ * InfoFrame to a DVI display (nvUpdateHdmiInfoFrames()), so a VSIF given for
+ * one would be taken and never sent.
+ */
+static inline NvBool nvHadesVsifOnConnector(NvBool hdmiConnector,
+                                            NvBool dpConnector,
+                                            NvBool tmdsSignal,
+                                            NvBool usesDpLib,
+                                            NvBool hdmiSink)
+{
+    if (!hdmiSink || usesDpLib) {
+        return NV_FALSE;
+    }
+    return hdmiConnector || (dpConnector && tmdsSignal);
+}
+
 /* What NVKMS will do with a head that sends a client's VSIF, on plain values. */
 struct NvKmsHadesVsifHead {
-    NvBool hdmi;         /* the dpy is driven as HDMI */
+    NvBool hdmiConnector; /* the connector is an HDMI one */
+    NvBool dpConnector;   /* the connector is a DisplayPort one */
+    NvBool tmdsSignal;    /* the output of the GPU that drives the dpy is TMDS */
+    NvBool usesDpLib;     /* the DisplayPort library drives the dpy */
+    NvBool hdmiSink;      /* GPU and display take HDMI (nvDpyIsHdmiEvo()) */
     NvU32  numDpys;      /* dpys on the head */
     NvBool hdrInfoFrame; /* an HDR (DR&M) InfoFrame is asked for */
     NvBool bt2100;       /* BT.2100 colorimetry */
@@ -115,7 +143,9 @@ static inline const char *nvHadesVsifRefusal(
         (pVsif->payloadSize > NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE)) {
         return "its size is out of range";
     }
-    if (!pHead->hdmi) {
+    if (!nvHadesVsifOnConnector(pHead->hdmiConnector, pHead->dpConnector,
+                                pHead->tmdsSignal, pHead->usesDpLib,
+                                pHead->hdmiSink)) {
         return "the display is not driven as HDMI";
     }
     if (pHead->numDpys != 1) {
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index 90faa5d..ee10338 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -2099,7 +2099,14 @@ static NvBool HadesValidateVsif(const NVDispEvoRec *pDispEvo,
         return TRUE;
     }
 
-    head.hdmi = nvDpyIsHdmiEvo(pDpyEvo);
+    head.hdmiConnector =
+        (pDpyEvo->pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_HDMI);
+    head.dpConnector =
+        (pDpyEvo->pConnectorEvo->type == NVKMS_CONNECTOR_TYPE_DP);
+    head.tmdsSignal = (pDpyEvo->pConnectorEvo->signalFormat ==
+                       NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS);
+    head.usesDpLib = nvConnectorUsesDPLib(pDpyEvo->pConnectorEvo);
+    head.hdmiSink = nvDpyIsHdmiEvo(pDpyEvo);
     head.numDpys = nvCountDpyIdsInDpyIdList(pProposedApiHead->dpyIdList);
     head.hdrInfoFrame = pProposedApiHead->hdrInfoFrameOverride ||
                         (pProposedApiHead->hdrStaticMetadataLayerMask != 0);
-- 
