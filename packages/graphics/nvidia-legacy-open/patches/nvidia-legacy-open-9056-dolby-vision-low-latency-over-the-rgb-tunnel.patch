From 606652fa205c8f166745f16d5a931e875d74ce13 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:55:00 +0000
Subject: [PATCH] nvidia: Dolby Vision Low-Latency over the RGB 8 bpc tunnel

Hades' 615 patch nvidia-open-kernel-modules-9030, made again for
580.196.07. Some displays take Dolby Vision as Low-Latency only (a Sony of
2020, the LG C5 in its game mode); the player sends the Dolby VSIF with
low_latency set and an AVI InfoFrame of YCbCr 4:2:2, BT.2020, limited range,
while the RGB 8 bpc pixels of the tunnel carry YCbCr 4:2:2 at 12 bits.

NVKMS: the Dolby VSIF with the Dolby Vision signal and low_latency (PB4
bits 1 and 0) is now taken, with the rules of the tunnel (RGB 4:4:4 at 8 bpc
of full range, no dithering, no HDR), and a head that sends it at RGB 8 bpc
sends the AVI InfoFrame that NVKMS sends for its own YCbCr 4:2:2 output with
BT.2100 colorimetry (nvHadesDolbyLowLatencyAvi(), on plain values); the VSIF
and the AVI InfoFrame are updated together, with the mode set. low_latency
without the signal is refused.

nvidia-drm: NV_HDMI_DV_LOW_LATENCY, a boolean property next to
NV_HDMI_VSIF_METADATA (HDMI connectors and dual-mode DisplayPort ones). Its
presence tells user space that the module does this (Kodi offers
Low-Latency only then); its value is the consent: the atomic check refuses
the Low-Latency Dolby VSIF without it, and it without that VSIF, "max bpc"
8, the default colorimetry and no HDR metadata. The console drops it.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 99 ++++++++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  2 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       | 11 +++
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |  1 +
 src/nvidia-modeset/include/nvkms-hades.h      | 33 ++++++-
 src/nvidia-modeset/src/nvkms-hdmi.c           | 18 ++++
 6 files changed, 157 insertions(+), 7 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 342856e..13b0854 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -318,6 +318,8 @@ nv_drm_connector_atomic_duplicate_state(struct drm_connector *connector)
     if (nv_new_connector_state->hdr10plus_vsif != NULL) {
         drm_property_blob_get(nv_new_connector_state->hdr10plus_vsif);
     }
+    nv_new_connector_state->hdmi_dv_low_latency =
+        nv_old_connector_state->hdmi_dv_low_latency;
 
     return &nv_new_connector_state->base;
 }
@@ -379,6 +381,14 @@ static int nv_drm_connector_atomic_set_property(
                    connector->dev, &nv_connector_state->hdr10plus_vsif, val);
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+        if (val > 1) {
+            return -EINVAL;
+        }
+        nv_connector_state->hdmi_dv_low_latency = val;
+        return 0;
+    }
+
     /* "max bpc" and the other standard properties: DRM's core */
     return -EINVAL;
 }
@@ -410,6 +420,11 @@ static int nv_drm_connector_atomic_get_property(
         return 0;
     }
 
+    if (property == nv_dev->nv_connector_hdmi_dv_low_latency_property) {
+        *val = nv_connector_state->hdmi_dv_low_latency;
+        return 0;
+    }
+
     return -EINVAL;
 }
 
@@ -432,16 +447,20 @@ static void nv_drm_connector_atomic_client_restore(
         to_nv_drm_connector_state(state);
 
     if ((nv_connector_state->hdmi_vsif_metadata != NULL) ||
-        (nv_connector_state->hdr10plus_vsif != NULL)) {
+        (nv_connector_state->hdr10plus_vsif != NULL) ||
+        nv_connector_state->hdmi_dv_low_latency) {
         NV_DRM_DEV_LOG_INFO(to_nv_device(connector->dev),
                             "[CONNECTOR:%d:%s] the console takes the display: "
-                            "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s dropped",
+                            "NV_HDMI_VSIF_METADATA %s, HDR10PLUS_VSIF %s, "
+                            "NV_HDMI_DV_LOW_LATENCY %d dropped",
                             connector->base.id, connector->name,
                             nv_connector_state->hdmi_vsif_metadata != NULL ? "set" : "none",
-                            nv_connector_state->hdr10plus_vsif != NULL ? "set" : "none");
+                            nv_connector_state->hdr10plus_vsif != NULL ? "set" : "none",
+                            nv_connector_state->hdmi_dv_low_latency);
     }
     drm_property_replace_blob(&nv_connector_state->hdmi_vsif_metadata, NULL);
     drm_property_replace_blob(&nv_connector_state->hdr10plus_vsif, NULL);
+    nv_connector_state->hdmi_dv_low_latency = false;
 }
 #endif
 
@@ -693,6 +712,50 @@ static enum NvKmsKapiDitheringMode nv_drm_connector_kapi_dithering(
     }
 }
 
+/*
+ * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel, as Hades' 615
+ * (nvidia-open-kernel-modules-9030). So that the AVI InfoFrame of YCbCr 4:2:2
+ * that NVKMS sends with it (nvkms-hades.h) never says other than what user
+ * space asked for: NV_HDMI_VSIF_METADATA takes the Low-Latency Dolby VSIF only
+ * with NV_HDMI_DV_LOW_LATENCY set, and NV_HDMI_DV_LOW_LATENCY is taken only
+ * with that VSIF, "max bpc" 8, the default colorimetry and no HDR metadata.
+ * Returns 0 or -EINVAL.
+ */
+static bool nv_drm_vsif_is_dolby_low_latency(const uint8_t *payload, size_t size)
+{
+    return (size == 27) && (payload[0] == 0x46) && (payload[1] == 0xd0) &&
+           (payload[2] == 0x00) && ((payload[3] & 0x3) == 0x3);
+}
+
+static int nv_drm_connector_check_dv_low_latency(bool low_latency,
+                                                 const uint8_t *vsif,
+                                                 size_t vsif_size,
+                                                 NvU32 bpc,
+                                                 bool default_colorimetry,
+                                                 bool hdr_metadata,
+                                                 const char **why)
+{
+    const bool ll_vsif =
+        (vsif != NULL) && nv_drm_vsif_is_dolby_low_latency(vsif, vsif_size);
+
+    if (ll_vsif && !low_latency) {
+        *why = "a Dolby Vision Low-Latency VSIF needs NV_HDMI_DV_LOW_LATENCY";
+        return -EINVAL;
+    }
+    if (!low_latency) {
+        return 0;
+    }
+    if (!ll_vsif) {
+        *why = "NV_HDMI_DV_LOW_LATENCY needs the Dolby Vision Low-Latency VSIF";
+        return -EINVAL;
+    }
+    if ((bpc != 8) || !default_colorimetry || hdr_metadata) {
+        *why = "NV_HDMI_DV_LOW_LATENCY needs \"max bpc\" 8, the default colorimetry and no HDR metadata";
+        return -EINVAL;
+    }
+    return 0;
+}
+
 static int
 __nv_drm_connector_atomic_check(struct drm_connector *connector,
                                 nv_drm_atomic_state_base_t *state)
@@ -791,6 +854,29 @@ __nv_drm_connector_atomic_check(struct drm_connector *connector,
         }
     }
 
+    /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel (above) */
+    {
+        const struct nv_drm_connector_state *nv_new_connector_state =
+            to_nv_drm_connector_state_const(new_connector_state);
+        const struct drm_property_blob *vsif =
+            nv_new_connector_state->hdmi_vsif_metadata;
+        const char *why = NULL;
+        int ret = nv_drm_connector_check_dv_low_latency(
+            nv_new_connector_state->hdmi_dv_low_latency,
+            (vsif && vsif->data) ? vsif->data : NULL,
+            (vsif && vsif->data) ? vsif->length : 0,
+            nv_drm_connector_requested_bpc(new_connector_state),
+            new_connector_state->colorspace == DRM_MODE_COLORIMETRY_DEFAULT,
+            new_connector_state->hdr_output_metadata != NULL,
+            &why);
+
+        if (ret != 0) {
+            NV_DRM_DEV_LOG_INFO(nv_dev, "[CONNECTOR:%d:%s] refused: %s",
+                                connector->base.id, connector->name, why);
+            return ret;
+        }
+    }
+
     /*
      * Override metadata for the entire head instead of allowing NVKMS to derive
      * it from the layers' metadata.
@@ -980,6 +1066,10 @@ nv_drm_connector_new(struct drm_device *dev,
         drm_object_attach_property(&nv_connector->base.base,
                                    nv_dev->nv_connector_dithering_mode_property,
                                    NV_DRM_DITHERING_MODE_AUTO);
+        /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel */
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdmi_dv_low_latency_property,
+                                   0);
         nv_connector->base.max_bpc_property =
             nv_dev->nv_connector_max_bpc_property;
         drm_object_attach_property(&nv_connector->base.base,
@@ -1153,6 +1243,9 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
     drm_object_attach_property(&nv_connector->base.base,
                                nv_dev->nv_connector_dithering_mode_property,
                                NV_DRM_DITHERING_MODE_AUTO);
+    drm_object_attach_property(&nv_connector->base.base,
+                               nv_dev->nv_connector_hdmi_dv_low_latency_property,
+                               0);
 #endif
 
     if (nv_connector->base.max_bpc_property == NULL) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index ac223fc..6fbb47a 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -140,6 +140,8 @@ struct nv_drm_connector_state {
     struct drm_property_blob *hdmi_vsif_metadata;
     /* Hades: HDR10PLUS_VSIF */
     struct drm_property_blob *hdr10plus_vsif;
+    /* Hades: NV_HDMI_DV_LOW_LATENCY */
+    bool hdmi_dv_low_latency;
 };
 
 static inline struct nv_drm_connector_state *to_nv_drm_connector_state(
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index 0328817..5883a20 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -694,6 +694,17 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel: with it set,
+     * NV_HDMI_VSIF_METADATA takes the Low-Latency Dolby VSIF, and NVKMS sends
+     * the AVI InfoFrame of YCbCr 4:2:2 that goes with it (nvkms-hades.h)
+     */
+    nv_dev->nv_connector_hdmi_dv_low_latency_property =
+        drm_property_create_bool(nv_dev->dev, 0, "NV_HDMI_DV_LOW_LATENCY");
+    if (nv_dev->nv_connector_hdmi_dv_low_latency_property == NULL) {
+        return -ENOMEM;
+    }
+
     /*
      * Hades: read-only, on dual-mode DisplayPort connectors: 1 while the
      * display is driven through the TMDS output of the GPU (HDMI).
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 937cc60..58e913e 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -184,6 +184,7 @@ struct nv_drm_device {
     struct drm_property *nv_connector_dual_mode_tmds_property;
     struct drm_property *nv_connector_output_bpc_property;
     struct drm_property *nv_connector_hdr10plus_vsif_property;
+    struct drm_property *nv_connector_hdmi_dv_low_latency_property;
 
     struct nv_drm_device *next;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index de0e927..41673a5 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -106,6 +106,30 @@ static inline NvBool nvHadesVsifOnConnector(NvBool hdmiConnector,
     return hdmiConnector || (dpConnector && tmdsSignal);
 }
 
+/*
+ * Dolby Vision Low-Latency over the RGB 8 bpc tunnel (Hades' 615,
+ * nvidia-open-kernel-modules-9030): the Dolby VSIF of 27 bytes with the Dolby
+ * Vision signal and low_latency set (PB4 bits 1 and 0, the Low-Latency signal
+ * of the Amlogic HDMI transmitter). The pixels of the tunnel carry YCbCr 4:2:2
+ * at 12 bits (luma in G, the high chroma bits in R, the low bits of both in
+ * B), so the AVI InfoFrame of a head that sends it at RGB 8 bpc says what
+ * NVKMS says for its own YCbCr 4:2:2 output with BT.2100 colorimetry: YCbCr
+ * 4:2:2, BT.2020, limited range. Any other head keeps its AVI InfoFrame.
+ */
+static inline NvBool nvHadesVsifIsDolbyLowLatency(const struct NvKmsHdmiVsifMetadata *pVsif)
+{
+    return (pVsif->payloadSize == NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) &&
+           nvHadesVsifIsDolby(pVsif) &&
+           ((pVsif->payload[3] & 0x3) == 0x3);
+}
+
+static inline NvBool nvHadesDolbyLowLatencyAvi(const struct NvKmsHdmiVsifMetadata *pVsif,
+                                               NvBool rgb, NvU32 bpc)
+{
+    return nvHadesVsifIsDolbyLowLatency(pVsif) && rgb &&
+           (bpc == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8);
+}
+
 /* What NVKMS will do with a head that sends a client's VSIF, on plain values. */
 struct NvKmsHadesVsifHead {
     NvBool hdmiConnector; /* the connector is an HDMI one */
@@ -132,8 +156,9 @@ struct NvKmsHadesVsifHead {
  * 4:4:4 of full range, reaching the sink byte for byte, with nothing else in
  * the vendor-specific slot of the SOR (the HDR InfoFrame goes through that
  * slot on these GPUs: nvEvo1SendHdmiInfoFrame()). Dolby Vision Low-Latency
- * (PB4 bit 0) is refused: this driver sends no YCbCr 4:2:2 AVI InfoFrame for
- * it.
+ * (PB4 bits 0 and 1: low_latency and the Dolby Vision signal) goes with the
+ * same tunnel, and its AVI InfoFrame says YCbCr 4:2:2
+ * (nvHadesDolbyLowLatencyAvi()); low_latency without the signal is refused.
  */
 static inline const char *nvHadesVsifRefusal(
     const struct NvKmsHdmiVsifMetadata *pVsif,
@@ -160,8 +185,8 @@ static inline const char *nvHadesVsifRefusal(
     if (pVsif->payloadSize != NVKMS_HDMI_VSIF_METADATA_MAX_PAYLOAD_SIZE) {
         return "a Dolby Vision vendor InfoFrame has 27 bytes";
     }
-    if ((pVsif->payload[3] & 0x01) != 0) {
-        return "Dolby Vision Low-Latency is not supported by this driver";
+    if (((pVsif->payload[3] & 0x01) != 0) && ((pVsif->payload[3] & 0x02) == 0)) {
+        return "Dolby Vision Low-Latency without the Dolby Vision signal";
     }
     if (pHead->hdrInfoFrame) {
         return "an HDR InfoFrame is asked for with Dolby Vision";
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 6a8684e..fe6ac84 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -430,6 +430,24 @@ static void SendVideoInfoFrame(const NVDispEvoRec *pDispEvo,
 
     CalculateVideoInfoFrameColorFormat(pDpyColor, hdTimings, pEdidInfo, &videoCtrl);
 
+    /* Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel (nvkms-hades.h) */
+    if (nvHadesVsifIsDolbyLowLatency(&pInfoFrameState->hdmiVsifMetadata)) {
+        if (nvHadesDolbyLowLatencyAvi(
+                &pInfoFrameState->hdmiVsifMetadata,
+                pDpyColor->format == NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_SPACE_RGB,
+                pDpyColor->bpc)) {
+            videoCtrl.color_space = NVT_VIDEO_INFOFRAME_BYTE1_Y1Y0_YCbCr422;
+            videoCtrl.colorimetry = NVT_VIDEO_INFOFRAME_BYTE2_C1C0_EXT_COLORIMETRY;
+            videoCtrl.extended_colorimetry = NVT_VIDEO_INFOFRAME_BYTE3_EC_BT2020RGBYCC;
+            videoCtrl.rgb_quantization_range =
+                NVT_VIDEO_INFOFRAME_BYTE3_Q1Q0_LIMITED_RANGE;
+        } else {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "Hades: Dolby Vision Low-Latency VSIF on a head that is not "
+                         "RGB at 8 bpc: the AVI InfoFrame says the output as it is");
+        }
+    }
+
     status = NvTiming_ConstructVideoInfoframe(pEdidInfo,
                                               &videoCtrl,
                                               NULL, &VideoInfoFrame);
-- 
2.53.0

