From 0579cdd70774f9932e481086ffc02b33353efe94 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:47:41 +0000
Subject: [PATCH] nvidia-drm: say in the kernel log what the EDID that NVKMS read holds

A display for which Kodi finds no Dolby Vision block gives two different faults:
the driver never read the block (or lost it), or the display does not offer it
in that input mode. Hades could not tell them apart from the kernel log, and a
Sony Bravia 8 II on an RTX 5080 in its "Enhanced format (Advanced)" input
(hadesdevls/LibreELEC-Hades#7) is one such case.

The same as nvidia-open-kernel-modules-9061, for driver 580 (the scan of the EDID is in
nvidia-drm-connector.c: this tree has no file of its own for it).

Each time the EDID that NVKMS read is another one, the kernel log now gives its
size and block count, the extension count of its base block, the count of its
HF-EEODB, and the number of Dolby Vision data blocks in it (the vendor-specific
video data block, extended tag 0x01, OUI 00-D0-46) with the block of the first:
"Hades: EDID of 640 bytes (5 blocks; its base block counts 3 extension(s), its
HF-EEODB 4): Dolby Vision data block: 1, the first in block 2". The scan reads
only what it has just been given, and logs once for an EDID that is the same.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 106 ++++++++++++++++++++++++++++++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-connector.h | 3 +++
 2 files changed, 108 insertions(+), 1 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index f3d8da5..889f3e4 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -515,6 +515,109 @@ static struct drm_connector_funcs nv_connector_funcs = {
 #endif
 };
 
+/*
+ * Hades: what the EDID that NVKMS read holds, on plain values: the data blocks of every CTA-861
+ * extension (revision 3) of the buffer, whatever the base block says: the Dolby Vision block is the
+ * vendor-specific video data block (tag 7, extended tag 0x01) with the OUI 00-D0-46 (46 D0 00 in the
+ * block), the HF-EEODB is the extended tag 0x78 with its count.
+ */
+struct nv_drm_hades_edid_scan {
+    unsigned int blocks;          /* whole blocks in the buffer */
+    unsigned int baseExtensions;  /* the extension count of the base block */
+    unsigned int eeodb;           /* the count of the HF-EEODB, 0 if none */
+    unsigned int dolbyCount;      /* Dolby Vision data blocks (VSVDB, OUI 00-D0-46) */
+    unsigned int dolbyFirst;      /* the block of the first one */
+};
+
+/*
+ * Walks the data blocks of every CTA-861 extension (revision 3) of the buffer, whatever the base
+ * block says: the Dolby Vision block is the vendor-specific video data block (tag 7, extended
+ * tag 0x01) with the OUI 00-D0-46 (46 D0 00 in the block), the HF-EEODB is the extended tag
+ * 0x78 with its count.
+ */
+static inline void nv_drm_hades_scan_edid(const NvU8 *edid, NvU64 size,
+                                          struct nv_drm_hades_edid_scan *scan)
+{
+    unsigned int i, p;
+
+    scan->blocks = (unsigned int)(size / 128);
+    scan->baseExtensions = (scan->blocks > 0) ? edid[126] : 0;
+    scan->eeodb = scan->dolbyCount = scan->dolbyFirst = 0;
+
+    for (i = 1; i < scan->blocks; i++) {
+        const NvU8 *block = edid + (NvU64)i * 128;
+        const unsigned int dtd = block[2];
+
+        /* a CTA-861 extension of revision 3: data blocks from byte 4 to the DTDs */
+        if (block[0] != 0x02 || block[1] < 3 || dtd < 4 || dtd > 127) {
+            continue;
+        }
+        for (p = 4; p < dtd; ) {
+            const unsigned int tag = block[p] >> 5;
+            const unsigned int len = block[p] & 0x1f;
+
+            if (p + 1 + len > dtd) {
+                break;
+            }
+            if (tag == 7 && len >= 4 && block[p + 1] == 0x01 &&
+                block[p + 2] == 0x46 && block[p + 3] == 0xD0 && block[p + 4] == 0x00) {
+                if (scan->dolbyCount++ == 0) {
+                    scan->dolbyFirst = i;
+                }
+            } else if (tag == 7 && len >= 2 && block[p + 1] == 0x78) {
+                scan->eeodb = block[p + 2];
+            }
+            p += 1 + len;
+        }
+    }
+}
+
+/*
+ * Hades: the kernel log says what the EDID that NVKMS read holds, each time it is another one:
+ * its size, the extension count of its base block, the count of its HF-EEODB, and where its
+ * Dolby Vision data block is (the vendor-specific video data block, extended tag 0x01, OUI
+ * 00-D0-46), if any. A display for which user space finds no Dolby Vision block is then told
+ * apart: a block that the driver never read or lost, from one that the display does not offer.
+ */
+static void nv_drm_connector_log_edid(struct drm_connector *connector,
+                                      struct nv_drm_connector *nv_connector)
+{
+    struct nv_drm_device *nv_dev = to_nv_device(connector->dev);
+    const NvU8 *edid = (const NvU8 *) nv_connector->edid;
+    const size_t size = nv_connector->edid_size;
+    struct nv_drm_hades_edid_scan scan;
+    NvU32 sum = 2166136261U;
+    size_t n;
+
+    /* (FNV-1a: only to tell one EDID from another) */
+    for (n = 0; n < size; n++) {
+        sum = (sum ^ edid[n]) * 16777619U;
+    }
+    if (nv_connector->hadesEdidLogged && nv_connector->hadesEdidSum == sum) {
+        return;
+    }
+    nv_connector->hadesEdidSum = sum;
+    nv_connector->hadesEdidLogged = true;
+
+    nv_drm_hades_scan_edid(edid, size, &scan);
+
+    if (scan.dolbyCount != 0) {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "[CONNECTOR:%d:%s] Hades: EDID of %zu bytes (%u blocks; its base block counts %u "
+            "extension(s), its HF-EEODB %u): Dolby Vision data block: %u, the first in block %u",
+            connector->base.id, connector->name, size, scan.blocks, scan.baseExtensions,
+            scan.eeodb, scan.dolbyCount, scan.dolbyFirst);
+    } else {
+        NV_DRM_DEV_LOG_INFO(
+            nv_dev,
+            "[CONNECTOR:%d:%s] Hades: EDID of %zu bytes (%u blocks; its base block counts %u "
+            "extension(s), its HF-EEODB %u): no Dolby Vision data block in it",
+            connector->base.id, connector->name, size, scan.blocks, scan.baseExtensions,
+            scan.eeodb);
+    }
+}
+
 /*
  * Hades: the EDID property with every block that NVKMS read.
  * drm_connector_update_edid_property() takes a struct edid and counts its size
@@ -528,8 +631,9 @@ static struct drm_connector_funcs nv_connector_funcs = {
  * takes the buffer with its real size, as i915 and amdgpu give it.
  */
 static void nv_drm_connector_update_edid(struct drm_connector *connector,
-                                         const struct nv_drm_connector *nv_connector)
+                                         struct nv_drm_connector *nv_connector)
 {
+    nv_drm_connector_log_edid(connector, nv_connector);
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
     const struct drm_edid *drm_edid =
         drm_edid_alloc(nv_connector->edid, nv_connector->edid_size);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 651ccdc..9ea0eee 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -57,6 +57,9 @@ struct nv_drm_connector {
     struct edid *edid;
     /* Hades: the bytes of edid, every block that NVKMS read */
     size_t edid_size;
+    /* Hades: what the kernel log last said of the EDID (nv_drm_connector_log_edid()) */
+    NvU32 hadesEdidSum;
+    bool hadesEdidLogged;
 
     /**
      * @frame_packing_advertised:
-- 
2.53.0

