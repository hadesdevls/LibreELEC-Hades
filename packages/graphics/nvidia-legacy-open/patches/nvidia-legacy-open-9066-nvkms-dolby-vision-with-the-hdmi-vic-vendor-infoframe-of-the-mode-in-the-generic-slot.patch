From 18c143c654a34c9dda81c55a23f1937f4d47986e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:24:37 +0000
Subject: [PATCH] nvkms: Dolby Vision with the HDMI_VIC vendor InfoFrame of the
 mode in the generic slot

9064 lets Dolby Vision go out in a mode that NVKMS names by its HDMI_VIC where
the AVI InfoFrame can name the mode by its CTA VIC (an HDMI 2.0 sink that lists
that VIC). To any other display nvHadesVsifRefusal() still refused the mode
set: the Dolby vendor InfoFrame takes the slot of NVKMS's own, and no
InfoFrame would name the format.

There NVKMS's own vendor InfoFrame, the HDMI_VIC one, now goes in the generic
slot of the SOR next to the Dolby one, as 9057 puts it next to HDR10, and the
mode set is no longer refused: the display is told the format by its
HDMI_VIC, as HDMI 1.4b has it, and Dolby Vision by its own InfoFrame
(NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC of nvHadesHdmiSlots()). Only where the
generic slot is free: the HAL of these GPUs without HDMI VRR (Maxwell, Pascal
and Volta: supportsHDMIVRR is FALSE for nvEvo94, nvEvo97 and nvEvoC3, so it is
free on all of them). No HDR InfoFrame goes out with Dolby Vision, and no
HDR10+ one, so nothing else wants the slot then. Where it is not free the mode
set is refused as before, and the reason now says so ("... and the generic
InfoFrame slot, where that vendor InfoFrame would go next to the Dolby one, is
not free (HDMI VRR)"). Where it goes out: "Hades: head N sends the Dolby
Vision vendor InfoFrame in the vendor-specific slot, and NVKMS's HDMI_VIC
vendor InfoFrame of the mode in the generic InfoFrame slot, so that the
display is told the format". The end of Dolby Vision gives the slot back as
9057 does.

The rule of 9064 (the CTA VIC where the display reads it) is unchanged; this
is only the case that it leaves refused. The generic slot test of the mode set
is the one of the InfoFrames (nvHadesHdmiGenericFree()).

Not run on a GPU; a Maxwell, Pascal or Volta GPU and a Dolby Vision display
without UHD_VIC that is not HDMI 2.0 or does not list the CTA VIC, at 4K 24,
25 or 30 Hz, are what can show it.

Checked with the host test of 9062 and 9064 on the HAL and the HDMI packet
library of the tree on a register file, with the generic slot free and not
(the same HAL with HDMI VRR), and with a test of nvHadesVsifRefusal() over all
its inputs; against the tree before, every step outside that case the same.
---
 src/nvidia-modeset/include/nvkms-hades.h | 38 +++++++++++++++++--
 src/nvidia-modeset/include/nvkms-hdmi.h  |  1 +
 src/nvidia-modeset/src/nvkms-hdmi.c      | 48 +++++++++++++++++++-----
 src/nvidia-modeset/src/nvkms-modeset.c   |  1 +
 4 files changed, 75 insertions(+), 13 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index ebcf061..5a46a39 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -263,6 +263,7 @@ struct NvKmsHadesVsifHead {
     NvBool framePacked;  /* the mode is a frame-packed 3D one */
     NvBool hdmi2;        /* the display is HDMI 2.0: SCDC_Present in its HF-VSDB */
     NvBool ctaVicListed; /* a video data block lists the CTA VIC of modeHdmiVic */
+    NvBool genericFree;  /* the generic InfoFrame slot of the SOR is free (nvHadesHdmiSlots()) */
 };
 
 static inline NvU32 nvHadesDolbyAviCtaVic(NvU32 ownHdmiVic,
@@ -364,14 +365,24 @@ static inline const char *nvHadesVsifRefusal(
                                       NV_FALSE, NV_FALSE) != 0) {
                 return NULL;
             }
+            /*
+             * else NVKMS's own HDMI_VIC vendor InfoFrame goes in the generic
+             * slot next to the Dolby one, where it is free
+             * (NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC)
+             */
+            if (pHead->genericFree) {
+                return NULL;
+            }
             if (!pHead->hdmi2) {
                 return "the mode needs NVKMS's own HDMI vendor InfoFrame (it names the mode by its HDMI_VIC), "
                        "and the display is not HDMI 2.0 (no SCDC_Present in its HF-VSDB), so the AVI InfoFrame "
-                       "does not name the mode by its CTA VIC with Dolby Vision";
+                       "does not name the mode by its CTA VIC with Dolby Vision, and the generic InfoFrame slot, "
+                       "where that vendor InfoFrame would go next to the Dolby one, is not free (HDMI VRR)";
             }
             return "the mode needs NVKMS's own HDMI vendor InfoFrame (it names the mode by its HDMI_VIC), "
                    "and the display lists no CTA VIC of that format in its video data blocks, so the AVI "
-                   "InfoFrame cannot name the mode with Dolby Vision";
+                   "InfoFrame cannot name the mode with Dolby Vision, and the generic InfoFrame slot, "
+                   "where that vendor InfoFrame would go next to the Dolby one, is not free (HDMI VRR)";
         }
         return "the mode needs NVKMS's own HDMI vendor InfoFrame (an HDMI VIC or 3D)";
     }
@@ -430,6 +441,19 @@ static inline const char *nvHadesVsifRefusal(
 #define NVKMS_HADES_VENDOR_CLIENT        2
 #define NVKMS_HADES_VENDOR_FRAME_PACKING 3
 #define NVKMS_HADES_VENDOR_NVKMS_2D      4
+/*
+ * DOLBY_HDMI_VIC: the client's Dolby vendor InfoFrame (IEEE OUI 00-D0-46) in a
+ * mode that NVKMS names by its HDMI_VIC where the AVI InfoFrame does not carry
+ * the CTA VIC of the format (nvHadesDolbyAviCtaVic() 0: the display is not
+ * HDMI 2.0, or does not list that VIC). The Dolby one in the vendor-specific
+ * slot, with no HDR InfoFrame, as DOLBY; and NVKMS's own vendor InfoFrame, the
+ * HDMI_VIC one that names the format, in the generic slot where it is free,
+ * as for HDR next to it (NVKMS_2D): the display is told the format by its
+ * HDMI_VIC, as HDMI 1.4b has it, and Dolby Vision by its own InfoFrame. Where
+ * the generic slot is not free (a HAL with HDMI VRR), nvHadesVsifRefusal()
+ * refuses the mode set, as before.
+ */
+#define NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC 5
 
 struct NvKmsHadesSlots {
     NvBool hdr;              /* the HDR InfoFrame, in the vendor-specific slot */
@@ -457,6 +481,14 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
     case NVKMS_HADES_VENDOR_DOLBY:
         s.hdr = NV_FALSE;
         break;
+    case NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC:
+        s.hdr = NV_FALSE;
+        if (genericFree) {
+            s.vendorGeneric = NV_TRUE;
+        } else {
+            s.dropped = "HDMI_VIC vendor InfoFrame of the mode next to the Dolby Vision one: the generic slot is not free";
+        }
+        break;
     case NVKMS_HADES_VENDOR_CLIENT:
     case NVKMS_HADES_VENDOR_FRAME_PACKING:
         if (!hdrSink || !hdrEnabled) {
@@ -478,7 +510,7 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
     }
 
     if (hdr10Plus && (s.dropped == NULL)) {
-        if (vendor == NVKMS_HADES_VENDOR_DOLBY) {
+        if ((vendor == NVKMS_HADES_VENDOR_DOLBY) || (vendor == NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC)) {
             s.dropped = "HDR10+ InfoFrame: Dolby Vision is sent";
         } else if (!genericFree) {
             s.dropped = "HDR10+ InfoFrame: no free generic slot";
diff --git a/src/nvidia-modeset/include/nvkms-hdmi.h b/src/nvidia-modeset/include/nvkms-hdmi.h
index 7f6f8d5..71a0e34 100644
--- a/src/nvidia-modeset/include/nvkms-hdmi.h
+++ b/src/nvidia-modeset/include/nvkms-hdmi.h
@@ -44,6 +44,7 @@ void nvLogEdidCea861InfoEvo(NVDpyEvoPtr pDpyEvo,
                             NVEvoInfoStringPtr pInfoString);
 NvBool nvDpyIsHdmiEvo(const NVDpyEvoRec *pDpyEvo);
 NvBool nvHadesVdbListsVic(const NVT_EDID_INFO *pEdidInfo, NvU32 vic);
+NvBool nvHadesHdmiGenericFree(const NVDevEvoRec *pDevEvo);
 
 /* Hades: HDR10+ (nvkms-hades.h) */
 struct NvKmsHdmiVsifMetadata;
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 777c1e8..530d92d 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -547,6 +547,12 @@ static NvBool HadesHdmiGenericSlotFree(const NVDevEvoRec *pDevEvo)
     return HadesHdmiSlotsShared(pDevEvo) && !pDevEvo->hal->caps.supportsHDMIVRR;
 }
 
+/* Hades: the same, for the check of a mode set (nvHadesVsifRefusal()) */
+NvBool nvHadesHdmiGenericFree(const NVDevEvoRec *pDevEvo)
+{
+    return HadesHdmiGenericSlotFree(pDevEvo);
+}
+
 /*
  * The vendor InfoFrame of the head, if it sends one: the client's
  * (nvkms-hades.h), or NVKMS's own, as SendVendorSpecificInfoFrame() decides it.
@@ -562,7 +568,11 @@ static NvBool HadesVendorInfoFrame(const NVDispHeadInfoFrameStateEvoRec *pInfoFr
     *pDolby = FALSE;
     nvkms_memset(pFrame, 0, sizeof(*pFrame));
 
-    if (pVsif->payloadSize != 0) {
+    /*
+     * (next to the client's Dolby one, the one that goes in the generic slot is
+     * NVKMS's own: NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC)
+     */
+    if ((pVsif->payloadSize != 0) && !nvHadesVsifIsDolby(pVsif)) {
         ct_assert(sizeof(pFrame->Data) >= sizeof(pVsif->payload));
         pFrame->Header.type = NVT_INFOFRAME_TYPE_VENDOR_SPECIFIC;
         pFrame->Header.version = NVT_VIDEO_INFOFRAME_VERSION_1;
@@ -626,6 +636,8 @@ HadesHdr10PlusOf(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState)
     return &pInfoFrameState->hdr10PlusVsif;
 }
 
+static NvU32 HadesOwnHdmiVic(const NVDispHeadInfoFrameStateEvoRec *pInfoFrameState);
+
 /* What the two slots of the SOR carry for the head (nvHadesHdmiSlots()) */
 static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
                                                const NvU32 head,
@@ -635,7 +647,17 @@ static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
 {
     const NVT_HDR_STATIC_METADATA *pHdrInfo = &pEdidInfo->hdr_static_metadata_info;
     const struct NvKmsHdmiVsifMetadata *pHdr10Plus = HadesHdr10PlusOf(pInfoFrameState);
-    const NvU32 vendor = HadesHdmiVendor(pInfoFrameState, pEdidInfo);
+    /*
+     * the Dolby one in a mode named by NVKMS's HDMI_VIC that the AVI InfoFrame
+     * does not name (NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC)
+     */
+    const NvU32 vendor =
+        ((pInfoFrameState->hdmiVsifMetadata.payloadSize != 0) &&
+         nvHadesVsifIsDolby(&pInfoFrameState->hdmiVsifMetadata) &&
+         (nvHadesCtaVicOfHdmiVic(HadesOwnHdmiVic(pInfoFrameState)) != 0) &&
+         (pDispEvo->pDevEvo->hadesAviCtaVic[pDispEvo->displayOwner][head] == 0)) ?
+        NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC :
+        HadesHdmiVendor(pInfoFrameState, pEdidInfo);
 
     if (pVendor != NULL) {
         *pVendor = vendor;
@@ -842,14 +864,20 @@ static void HadesSendGenericSlot(const NVDispEvoRec *pDispEvo,
         nvHadesEvo1SendHdmiGenericInfoFrame(pDispEvo, head, &frame.Header,
                                             sizeof(frame.Header) +
                                             frame.Header.length);
-        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
-                     "Hades: head %u sends the HDR InfoFrame in the vendor-specific slot, and %s in the generic InfoFrame slot",
-                     head,
-                     (vendor == NVKMS_HADES_VENDOR_FRAME_PACKING) ?
-                         "the 3D vendor InfoFrame of the frame-packed mode" :
-                     (vendor == NVKMS_HADES_VENDOR_NVKMS_2D) ?
-                         "the HDMI_VIC vendor InfoFrame of the mode" :
-                         "the client's vendor InfoFrame");
+        if (vendor == NVKMS_HADES_VENDOR_DOLBY_HDMI_VIC) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u sends the Dolby Vision vendor InfoFrame in the vendor-specific slot, and NVKMS's HDMI_VIC vendor InfoFrame of the mode in the generic InfoFrame slot, so that the display is told the format",
+                         head);
+        } else {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u sends the HDR InfoFrame in the vendor-specific slot, and %s in the generic InfoFrame slot",
+                         head,
+                         (vendor == NVKMS_HADES_VENDOR_FRAME_PACKING) ?
+                             "the 3D vendor InfoFrame of the frame-packed mode" :
+                         (vendor == NVKMS_HADES_VENDOR_NVKMS_2D) ?
+                             "the HDMI_VIC vendor InfoFrame of the mode" :
+                             "the client's vendor InfoFrame");
+        }
     } else if (slots.hdr10PlusGeneric) {
         HadesSendHdr10Plus(pDispEvo, head, HadesHdr10PlusOf(pInfoFrameState));
     } else {
diff --git a/src/nvidia-modeset/src/nvkms-modeset.c b/src/nvidia-modeset/src/nvkms-modeset.c
index 0dd0c76..f515402 100644
--- a/src/nvidia-modeset/src/nvkms-modeset.c
+++ b/src/nvidia-modeset/src/nvkms-modeset.c
@@ -2137,6 +2137,7 @@ static NvBool HadesValidateVsif(const NVDispEvoRec *pDispEvo,
     head.ctaVicListed = pDpyEvo->parsedEdid.valid &&
                         nvHadesVdbListsVic(&pDpyEvo->parsedEdid.info,
                                            nvHadesCtaVicOfHdmiVic(head.modeHdmiVic));
+    head.genericFree = nvHadesHdmiGenericFree(pDispEvo->pDevEvo);
 
     why = nvHadesVsifRefusal(pVsif, &head);
     if (why == NULL) {
