     /* Hades: the client's HDR10+ VSIF (nvkms-hades.h); payloadSize 0 for none */
     struct NvKmsHdmiVsifMetadata hdr10PlusVsif;
+    /*
+     * Hades: the content type that the client asked for in the mode set of
+     * the head (NV_HADES_CONTENT_TYPE_*, nvHadesAviContent()); 0 none
