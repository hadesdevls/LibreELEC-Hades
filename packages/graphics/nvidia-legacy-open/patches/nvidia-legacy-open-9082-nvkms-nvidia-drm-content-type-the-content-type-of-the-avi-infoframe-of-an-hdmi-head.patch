 } NVDispHeadInfoFrameStateEvoRec;
 
 typedef enum _NVEvoMergeMode {
diff --git a/src/nvidia-modeset/interface/nvkms-api.h b/src/nvidia-modeset/interface/nvkms-api.h
index 4dc84e2..be97129 100644
--- a/src/nvidia-modeset/interface/nvkms-api.h
+++ b/src/nvidia-modeset/interface/nvkms-api.h
@@ -363,8 +363,20 @@ enum NvKmsModeValidationOverrides {
     NVKMS_MODE_VALIDATION_NO_INTERLACED_MODES                = (1 << 18),
     NVKMS_MODE_VALIDATION_MAX_ONE_HARDWARE_HEAD              = (1 << 19),
     NVKMS_MODE_VALIDATION_PREFER_HDMI_FRL_MODE               = (1 << 20),
+    /*
+     * Hades: the content type that the AVI InfoFrame of an HDMI head says
+     * (ITC and CN1CN0 of CTA-861), a field of three bits, not a flag: 0 leaves
+     * it to NVKMS ("No Data" of DRM's "content type"), 1 Graphics, 2 Photo,
+     * 3 Cinema, 4 Game (DRM_MODE_CONTENT_TYPE_*). Asked for by the KAPI from
+     * "content type" of nvidia-drm; nvHadesAviContent() of nvkms-hades.h
+     * makes the AVI InfoFrame of it. It changes nothing but that InfoFrame.
+     */
+    NVKMS_MODE_VALIDATION_HADES_CONTENT_TYPE                 = (7 << 27),
 };
 
+/* Hades: the shift of NVKMS_MODE_VALIDATION_HADES_CONTENT_TYPE */
+#define NVKMS_MODE_VALIDATION_HADES_CONTENT_TYPE_SHIFT 27
+
 /*!
  * Frequency information used during mode validation (for HorizSync
  * and VertRefresh) can come from several possible sources.  NVKMS
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index 53603af..30773aa 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -472,6 +472,16 @@ struct NvKmsKapiHeadModeSetConfig {
      */
     NvBool hadesColorRangeLimited;
 
+    /*
+     * Hades: the content type that the AVI InfoFrame of this head says:
+     * DRM_MODE_CONTENT_TYPE_* (0 "No Data": NVKMS's own, none with Dolby
+     * Vision; 1 Graphics, 2 Photo, 3 Cinema, 4 Game), through
+     * NVKMS_MODE_VALIDATION_HADES_CONTENT_TYPE. nvidia-drm sets it from the
+     * connector's "content type". A change of it is a mode set
+     * (ApplyModeSetConfig()).
+     */
+    NvU8 hadesContentType;
+
     /*
      * Hades: the HDR10+ VSIF of the frame (IEEE OUI 90-84-8B first, 27
      * bytes; payloadSize 0 for none). Passed by a mode set, and by the flip of
@@ -496,6 +506,7 @@ struct NvKmsKapiHeadRequestedConfig {
         NvBool ditheringChanged       : 1;
         NvBool colorBpcChanged        : 1;
         NvBool hadesColorRangeChanged : 1; /* Hades: hadesColorRangeLimited */
+        NvBool hadesContentTypeChanged : 1; /* Hades: hadesContentType */
         NvBool hdr10PlusVsifChanged   : 1;
     } flags;
 
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 3374a67..009c092 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -3532,6 +3532,16 @@ static NvBool NvKmsKapiRequestedModeSetConfigToKms(
         InitNvKmsModeValidationParams(device,
                                       &paramsHead->modeValidationParams);
 
+        /*
