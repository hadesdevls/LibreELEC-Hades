From bfc1ba7d8ca8f4189e3645434b4665895d4ba699 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 07:48:06 +0000
Subject: [PATCH] nvkms, nvidia-drm: NV_HDMI_3D_AVI_CTA_VIC: the CTA VIC in the
 AVI InfoFrame next to a half 3D layout

The change of Hades' 620 (nvidia-open-kernel-modules-9086), on 580 for
Maxwell, Pascal and Volta. NVKMS names 3840x2160 at 24, 25 and 30 Hz and
4096x2160 at 24 Hz by their HDMI_VIC for a display whose HF-VSDB does
not say UHD_VIC (the EDID parser puts those timings first,
prioritizeEdidHDMIExtTiming()), with VIC 0 in the AVI InfoFrame ("for
HDMI_EXT timing, AVI VIC should be 0") and the HDMI_VIC in its own vendor
InfoFrame. A client's vendor InfoFrame from NV_HDMI_VSIF_METADATA goes
out in the place of NVKMS's own (SendVendorSpecificInfoFrame()), and one
of HDMI 1.4b with a 3D structure carries no HDMI_VIC: in those modes the
display was told a 3D structure of no format, so a client could not tell
it of side by side or top and bottom there.

Linux names the format of such a 3D mode by its CTA VIC in the AVI
InfoFrame (drm_mode_hdmi_vic() gives no HDMI_VIC to a mode with a 3D
layout, drm_mode_cea_vic() the CTA VIC, which vic_for_avi_infoframe()
keeps for a sink that lists it). NVKMS now does the same: the AVI
InfoFrame carries the CTA VIC of the format (93, 94 and 95 for 3840x2160
at 24, 25 and 30 Hz, 98 for 4096x2160 at 24 Hz, as for HDR10+ and Dolby
Vision in these modes, nvidia-legacy-open-9062 and -9064), next to the
client's vendor InfoFrame, on every HAL, only:
 - with a client's HDMI 1.4b vendor InfoFrame of side by side (half,
   3D_Ext_Data 0, as Linux sends it) or top and bottom
   (nvHadesHalfLayoutVsif());
 - to a display whose EDID declares that 3D structure for that CTA VIC as
   do_hdmi_vsdb_modes() of Linux reads it: 3D_Structure_ALL with 3D_MASK
   over the first sixteen SVDs, or a 2D_VIC_order entry with its
   3D_Structure (side by side with 3D_Detail 1), of every HDMI VSDB
   (nvHadesEdidRead3D(), nvHadesEdidDeclares3D()).
That is the rule of Linux, for a display of HDMI 1.4 as for one of HDMI
2.0: a format declared in 3D is an SVD of a video data block. The
functions of nvkms-hades.h are those of 620 (their comment also names
620). The NVEdidRec
of 580 does not say whether it holds a native DisplayID (620's
isNativeDID), so the EDID is read only where its base block starts with
the header of an EDID. Everything else is as before: other 3D
structures, frame packing (NVKMS's own HDMI 3D), 2D, Dolby Vision and
HDR10+.

The kernel log says, once in each mode set and again where it changes,
how a client's 3D vendor InfoFrame is signalled in such a mode and why,
in the words of 620.

nvidia-drm gives each connector that takes NV_HDMI_VSIF_METADATA (HDMI,
and dual-mode DisplayPort) the read-only property NV_HDMI_3D_AVI_CTA_VIC
(1), so that a client knows that it can tell such a display of a half
layout in those modes.
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c |  12 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  16 +
 kernel-open/nvidia-drm/nvidia-drm-priv.h      |   2 +
 src/nvidia-modeset/include/nvkms-hades.h      | 304 ++++++++++++++++++
 src/nvidia-modeset/include/nvkms-types.h      |  17 +-
 src/nvidia-modeset/src/nvkms-hdmi.c           | 151 +++++++--
 src/nvidia-modeset/src/nvkms-modeset.c        |   9 +
 7 files changed, 483 insertions(+), 28 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 8fb5c95..ca14944 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1434,6 +1434,12 @@ nv_drm_connector_new(struct drm_device *dev,
         drm_object_attach_property(&nv_connector->base.base,
                                    nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
                                    0);
+        /* Hades: the CTA VIC in the AVI InfoFrame next to a half 3D layout */
+        if (nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property) {
+            drm_object_attach_property(&nv_connector->base.base,
+                                       nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property,
+                                       1);
+        }
         nv_connector->base.max_bpc_property =
             nv_dev->nv_connector_max_bpc_property;
         drm_object_attach_property(&nv_connector->base.base,
@@ -1652,6 +1658,12 @@ void nv_drm_connector_add_dual_mode_tmds(struct nv_drm_connector *nv_connector)
     drm_object_attach_property(&nv_connector->base.base,
                                nv_dev->nv_connector_hdmi_dv_hdmi14b_property,
                                0);
+    /* Hades: the CTA VIC in the AVI InfoFrame next to a half 3D layout */
+    if (nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property) {
+        drm_object_attach_property(&nv_connector->base.base,
+                                   nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property,
+                                   1);
+    }
 #endif
 
     if (nv_connector->base.max_bpc_property == NULL) {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index fd6f62e..92b3375 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -723,6 +723,22 @@ static int nv_drm_create_properties(struct nv_drm_device *nv_dev)
         return -ENOMEM;
     }
 
+    /*
+     * Hades: read-only, 1 on a connector that takes NV_HDMI_VSIF_METADATA:
+     * there, with a vendor InfoFrame of HDMI 1.4b of side by side (half) or top
+     * and bottom in a mode that NVKMS names by its HDMI_VIC (3840x2160 at 24,
+     * 25 and 30 Hz, 4096x2160 at 24 Hz), NVKMS puts the CTA VIC of the mode in
+     * the AVI InfoFrame where the EDID of the display declares that layout
+     * for it, as Linux signals a 3D mode (nvHadesStereoAviCtaVic() of
+     * nvkms-hades.h), as Hades' 620 does
+     */
+    nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property =
+        drm_property_create_range(nv_dev->dev, DRM_MODE_PROP_IMMUTABLE,
+                                  "NV_HDMI_3D_AVI_CTA_VIC", 0, 1);
+    if (nv_dev->nv_connector_hdmi_3d_avi_cta_vic_property == NULL) {
+        return -ENOMEM;
+    }
+
     /*
      * Hades: Dolby Vision Low-Latency over the RGB 8 bpc tunnel: with it set,
      * NV_HDMI_VSIF_METADATA takes the Low-Latency Dolby VSIF, and NVKMS sends
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index 1f3f61c..2433fcd 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -197,6 +197,8 @@ struct nv_drm_device {
     struct drm_property *nv_connector_hdr10plus_vsif_property;
     /* Hades: NV_HDR10PLUS_AVI_CTA_VIC */
     struct drm_property *nv_connector_hdr10plus_avi_cta_vic_property;
+    /* Hades: NV_HDMI_3D_AVI_CTA_VIC */
+    struct drm_property *nv_connector_hdmi_3d_avi_cta_vic_property;
     struct drm_property *nv_connector_hdmi_dv_low_latency_property;
     struct drm_property *nv_connector_hdmi_dv_hdmi14b_property;
 
diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index cb279b7..79cb43f 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -731,6 +731,310 @@ static inline NvBool nvHadesCtaVicAspectNoData(NvU32 ctaVic)
     return ctaVic == 98;
 }
 
+/*
+ * 3D in a mode that NVKMS names by its HDMI_VIC: 3840x2160 at 24, 25 and 30
+ * Hz and 4096x2160 at 24 Hz (and their 1000/1001 rates) of the HDMI VSDB, for
+ * a display whose HF-VSDB does not say UHD_VIC. The parser of the EDID puts
+ * those timings first (prioritizeEdidHDMIExtTiming()), and ValidateModeIndexEdid()
+ * of nvkms-modepool.c looks among the CTA-861 timings first only for HDMI 3D
+ * (frame packing) or UHD_VIC; NVKMS then sends the mode with VIC 0 in its AVI
+ * InfoFrame (NvTiming_ConstructVideoInfoframeCtrl(): "for HDMI_EXT timing, AVI
+ * VIC should be 0") and the HDMI_VIC in its own vendor InfoFrame
+ * (ConstructVSInfoFrameCtrl()). A client that tells the display of a half 3D
+ * layout through NV_HDMI_VSIF_METADATA sends its HDMI vendor InfoFrame in the
+ * place of NVKMS's own (SendVendorSpecificInfoFrame()), and one of
+ * HDMI_Video_Format 3D carries no HDMI_VIC (in the vendor InfoFrame of HDMI
+ * 1.4b the HDMI_VIC and the 3D_Structure exclude each other: "only one of
+ * those can be supplied", hdmi_vendor_infoframe_check_only() of Linux): the
+ * display was told a 3D structure of no format at all.
+ *
+ * Linux names the format of such a 3D mode by its CTA VIC in the AVI InfoFrame:
+ * drm_mode_hdmi_vic() gives no HDMI_VIC to a mode with a 3D layout ("No HDMI
+ * VIC when signalling 3D video format"), so drm_mode_cea_vic() gives the CTA
+ * VIC, which vic_for_avi_infoframe() keeps for a sink that lists it in a video
+ * data block; i915 and amdgpu send the AVI and vendor InfoFrames that drm makes
+ * of the mode (drm_hdmi_avi_infoframe_from_display_mode(),
+ * drm_hdmi_vendor_infoframe_from_display_mode()). Here the AVI InfoFrame
+ * carries the CTA VIC of the format (95, 94 and 93 for 3840x2160 at 30, 25 and
+ * 24 Hz, 98 for 4096x2160 at 24 Hz: nvHadesCtaVicOfHdmiVic()) next to the
+ * client's vendor InfoFrame, as Hades' 620 does it on Turing and later
+ * (nvidia-open-kernel-modules-9086), only:
+ *  - with a client's vendor InfoFrame of HDMI 1.4b of side by side (half) or
+ *    top and bottom (nvHadesHalfLayoutVsif());
+ *  - to a display whose EDID declares that 3D structure for that CTA VIC as
+ *    Linux reads it, do_hdmi_vsdb_modes(): 3D_Structure_ALL with 3D_MASK over
+ *    the first sixteen SVDs, or a 2D_VIC_order entry with its 3D_Structure
+ *    (nvHadesEdidDeclares3D()).
+ * That is all Linux asks, of an HDMI 1.4 display as of an HDMI 2.0 one: a
+ * format declared in 3D is an SVD of a video data block, and
+ * vic_for_avi_infoframe() keeps a VIC that the sink lists there whatever the
+ * sink (it drops one above 64 only for a sink that is not HDMI 2.0 and does
+ * not list it). Everywhere else the mode goes out exactly as before, and the
+ * kernel log says why where a client's 3D vendor InfoFrame meets such a mode.
+ */
+
+/* nvHadesHalfLayoutVsif(): what a client's vendor InfoFrame says of 3D */
+#define NV_HADES_HALF_NONE           0    /* no vendor InfoFrame of HDMI 1.4b with a 3D format */
+#define NV_HADES_HALF_TOP_AND_BOTTOM 6    /* 3D_Structure 6 */
+#define NV_HADES_HALF_SIDE_BY_SIDE   8    /* 3D_Structure 8 with 3D_Ext_Data 0 */
+#define NV_HADES_HALF_OTHER          0x10 /* any other 3D structure, or one too short */
+
+/*
+ * What the payload of a client's vendor InfoFrame (from its IEEE OUI on, as
+ * NV_HDMI_VSIF_METADATA gives it) says of 3D. The one of HDMI 1.4b: IEEE OUI
+ * 00-0C-03 (least significant byte first), HDMI_Video_Format 010b (3D) in bits
+ * 7:5 of PB4, 3D_Structure in bits 7:4 of PB5 and, for side by side (half),
+ * 3D_Ext_Data in bits 7:4 of PB6, as Linux packs it
+ * (hdmi_vendor_infoframe_pack_only(): ptr[7] = 0x2 << 5, ptr[8] = s3d_struct
+ * << 4, ptr[9] = s3d_ext_data << 4, after the 4 bytes of the header) and as
+ * Kodi sends it. Side by side (half) is the one Linux sends, 3D_Ext_Data 0 in
+ * its 6 bytes (hdmi_vendor_infoframe_length(); hdmi_vendor_infoframe_init()
+ * leaves s3d_ext_data 0).
+ */
+static inline NvU32 nvHadesHalfLayoutVsif(const NvU8 *payload, NvU32 size)
+{
+    if ((size < 5) || (payload[0] != 0x03) || (payload[1] != 0x0C) ||
+        (payload[2] != 0x00) || ((payload[3] >> 5) != 2)) {
+        return NV_HADES_HALF_NONE;
+    }
+    switch (payload[4] >> 4) {
+    case 6:
+        return NV_HADES_HALF_TOP_AND_BOTTOM;
+    case 8:
+        return ((size >= 6) && ((payload[5] >> 4) == 0)) ?
+            NV_HADES_HALF_SIDE_BY_SIDE : NV_HADES_HALF_OTHER;
+    default:
+        return NV_HADES_HALF_OTHER;
+    }
+}
+
+/* the 3D structures of nvHadesEdidRead3D(), as add_3d_struct_modes() of Linux reads 3D_Structure_ALL */
+#define NV_HADES_EDID_3D_FRAME_PACKING  (1u << 0)
+#define NV_HADES_EDID_3D_TOP_AND_BOTTOM (1u << 6)
+#define NV_HADES_EDID_3D_SIDE_BY_SIDE   (1u << 8)
+
+/* What Linux reads of an EDID for nvHadesStereoAviCtaVic() */
+struct NvHadesEdid3D {
+    NvU32 svds;           /* the SVDs of every video data block, in order */
+    NvU8 vic[16];         /* the VICs of the first sixteen (0 for one Linux does not know) */
+    NvU16 structures[16]; /* NV_HADES_EDID_3D_* declared for each of them */
+};
+
+/* a VIC that Linux knows (drm_valid_cea_vic(), cea_mode_for_vic(): 1 to 127, 193 to 219) */
+static inline NvBool nvHadesKnownCtaVic(NvU32 vic)
+{
+    return ((vic >= 1) && (vic <= 127)) || ((vic >= 193) && (vic <= 219));
+}
+
+/* the VIC of an SVD as Linux reads it (svd_to_vic(): bit 7 of 1 to 64 says native) */
+static inline NvU32 nvHadesSvdVic(NvU8 svd)
+{
+    return (((svd >= 1) && (svd <= 64)) || ((svd >= 129) && (svd <= 192))) ?
+        (NvU32)(svd & 0x7F) : (NvU32)svd;
+}
+
+/*
+ * The 3D part of an HDMI VSDB (db: its header byte; len: its payload length,
+ * db[len] its last byte), as do_hdmi_vsdb_modes() of Linux reads it, with the
+ * same tests of length: 3D_Structure_ALL over the indices of 3D_MASK (or all
+ * sixteen), and each 2D_VIC_order entry with its 3D_Structure (frame packing
+ * 0, top and bottom 6, side by side 8 only with 3D_Detail 1).
+ */
+static inline void nvHadesEdidHdmiVsdb3D(const NvU8 *db, NvU32 len,
+                                         struct NvHadesEdid3D *p)
+{
+    NvU32 offset = 0, multi = 0, multiLen, vicLen, len3D, i;
+
+    if ((len < 8) || !(db[8] & 0x20)) {
+        return;
+    }
+    if (db[8] & 0x80) {
+        offset += (db[8] & 0x40) ? 4 : 2;
+    }
+    if (len < (8 + offset + 2)) {
+        return;
+    }
+    offset++;
+    if (db[8 + offset] & 0x80) {
+        multi = (db[8 + offset] & 0x60) >> 5;
+    }
+    offset++;
+    vicLen = db[8 + offset] >> 5;
+    len3D = db[8 + offset] & 0x1F;
+    offset += 1 + vicLen;
+    multiLen = (multi == 1) ? 2 : (multi == 2) ? 4 : 0;
+    if ((len < (8 + offset + len3D - 1)) || (len3D < multiLen)) {
+        return;
+    }
+    if ((multi == 1) || (multi == 2)) {
+        const NvU16 all = (NvU16)((db[8 + offset] << 8) | db[9 + offset]);
+        const NvU16 mask = (multi == 2) ?
+            (NvU16)((db[10 + offset] << 8) | db[11 + offset]) : 0xFFFF;
+
+        for (i = 0; i < 16; i++) {
+            if (mask & (1u << i)) {
+                p->structures[i] |= all & (NV_HADES_EDID_3D_FRAME_PACKING |
+                                           NV_HADES_EDID_3D_TOP_AND_BOTTOM |
+                                           NV_HADES_EDID_3D_SIDE_BY_SIDE);
+            }
+        }
+    }
+    offset += multiLen;
+    for (i = 0; i < (len3D - multiLen); i++) {
+        const NvU8 entry = db[8 + offset + i];
+        const NvBool detail = (entry & 0x0F) > 7;
+        const NvU32 index = entry >> 4;
+
+        if (detail && (i + 1 == len3D - multiLen)) {
+            break;
+        }
+        switch (entry & 0x0F) {
+        case 0:
+            p->structures[index] |= NV_HADES_EDID_3D_FRAME_PACKING;
+            break;
+        case 6:
+            p->structures[index] |= NV_HADES_EDID_3D_TOP_AND_BOTTOM;
+            break;
+        case 8:
+            if ((db[9 + offset + i] >> 4) == 1) {
+                p->structures[index] |= NV_HADES_EDID_3D_SIDE_BY_SIDE;
+            }
+            break;
+        default:
+            break;
+        }
+        if (detail) {
+            i++;
+        }
+    }
+}
+
+/*
+ * What Linux reads of an EDID (edid: all of its blocks as read, size bytes)
+ * for nvHadesStereoAviCtaVic(). The data blocks of each CTA-861 extension of
+ * revision 3 or later with a right checksum, from byte 4 to the byte that byte
+ * 2 names (4 to 127; each data block whole within them), as Linux walks them
+ * (edid_filter_invalid_blocks(), __cea_db_iter_edid_next(),
+ * cea_db_collection_size(), __cea_db_iter_current_block()), in two passes as
+ * Linux reads them: first the SVDs of the video data blocks (parse_cta_vdb(),
+ * an unknown VIC 0), then the 3D part of every HDMI VSDB of 5 bytes or more
+ * (add_cea_modes(), nvHadesEdidHdmiVsdb3D()), whose indices are those of the
+ * SVDs. The CTA data blocks of a DisplayID extension,
+ * which Linux reads as well, are not read here.
+ */
+static inline void nvHadesEdidRead3D(const NvU8 *edid, NvU32 size,
+                                     struct NvHadesEdid3D *p)
+{
+    NvU32 pass, ext, i;
+
+    for (i = 0; i < 16; i++) {
+        p->vic[i] = 0;
+        p->structures[i] = 0;
+    }
+    p->svds = 0;
+
+    if (edid == NULL) {
+        return;
+    }
+    for (pass = 0; pass < 2; pass++) {
+        for (ext = 128; (ext + 128) <= size; ext += 128) {
+            const NvU8 *b = edid + ext;
+            NvU32 sum = 0, at;
+
+            for (i = 0; i < 128; i++) {
+                sum += b[i];
+            }
+            if ((b[0] != 0x02) || (b[1] < 3) || (b[2] < 4) || (b[2] > 127) ||
+                ((sum & 0xFF) != 0)) {
+                continue;
+            }
+            for (at = 4; (at + 1) <= b[2];) {
+                const NvU8 *db = b + at;
+                const NvU32 tag = db[0] >> 5;
+                const NvU32 len = db[0] & 0x1F;
+
+                if ((at + 1 + len) > b[2]) {
+                    break;
+                }
+                if (pass == 0) {
+                    if (tag == 2) {
+                        for (i = 0; i < len; i++) {
+                            const NvU32 vic = nvHadesSvdVic(db[1 + i]);
+
+                            if (p->svds < 16) {
+                                p->vic[p->svds] = nvHadesKnownCtaVic(vic) ? (NvU8)vic : 0;
+                            }
+                            p->svds++;
+                        }
+                    }
+                } else if ((tag == 3) && (len >= 5) && (db[1] == 0x03) &&
+                           (db[2] == 0x0C) && (db[3] == 0x00)) {
+                    nvHadesEdidHdmiVsdb3D(db, len, p);
+                }
+                at += 1 + len;
+            }
+        }
+    }
+}
+
+/*
+ * The EDID declares 3D structure half (NV_HADES_HALF_*) for the CTA VIC vic:
+ * an SVD among the first sixteen of that VIC with that structure, as Linux
+ * makes a 3D mode of it (drm_display_mode_from_vic_index(): none past the SVDs
+ * read, nor of an unknown VIC)
+ */
+static inline NvBool nvHadesEdidDeclares3D(const struct NvHadesEdid3D *p,
+                                           NvU32 vic, NvU32 half)
+{
+    const NvU16 structure =
+        (half == NV_HADES_HALF_TOP_AND_BOTTOM) ? NV_HADES_EDID_3D_TOP_AND_BOTTOM :
+        (half == NV_HADES_HALF_SIDE_BY_SIDE) ? NV_HADES_EDID_3D_SIDE_BY_SIDE : 0;
+    NvU32 i;
+
+    for (i = 0; (i < 16) && (i < p->svds); i++) {
+        if ((vic != 0) && (p->vic[i] == vic) && (p->structures[i] & structure)) {
+            return NV_TRUE;
+        }
+    }
+    return NV_FALSE;
+}
+
+/* nvHadesStereoAviCtaVic(): why */
+#define NV_HADES_3D_AVI_NONE         0 /* no client's 3D vendor InfoFrame in a mode of an HDMI_VIC */
+#define NV_HADES_3D_AVI_CTA_VIC      1 /* the AVI InfoFrame carries the CTA VIC */
+#define NV_HADES_3D_AVI_OTHER_LAYOUT 2 /* a 3D structure other than the two half ones */
+#define NV_HADES_3D_AVI_UNDECLARED   3 /* the EDID does not declare that structure for that VIC */
+
+/*
+ * The CTA VIC that the AVI InfoFrame carries in a mode of NVKMS's own HDMI_VIC
+ * (ownHdmiVic, 1 to 4) with a client's vendor InfoFrame of 3D (half,
+ * nvHadesHalfLayoutVsif()) to a sink of which pEdid says what Linux reads
+ * (nvHadesEdidRead3D()); 0 for the VIC that NVKMS puts there, and *pWhy says
+ * why (NV_HADES_3D_AVI_*).
+ */
+static inline NvU32 nvHadesStereoAviCtaVic(NvU32 ownHdmiVic,
+                                           NvU32 half,
+                                           const struct NvHadesEdid3D *pEdid,
+                                           NvU32 *pWhy)
+{
+    const NvU32 ctaVic = nvHadesCtaVicOfHdmiVic(ownHdmiVic);
+
+    if ((ctaVic == 0) || (half == NV_HADES_HALF_NONE)) {
+        *pWhy = NV_HADES_3D_AVI_NONE;
+        return 0;
+    }
+    if (half == NV_HADES_HALF_OTHER) {
+        *pWhy = NV_HADES_3D_AVI_OTHER_LAYOUT;
+        return 0;
+    }
+    if (!nvHadesEdidDeclares3D(pEdid, ctaVic, half)) {
+        *pWhy = NV_HADES_3D_AVI_UNDECLARED;
+        return 0;
+    }
+    *pWhy = NV_HADES_3D_AVI_CTA_VIC;
+    return ctaVic;
+}
+
 /*
  * HDR10+: the vendor InfoFrame of IEEE OUI 90-84-8B (least significant byte
