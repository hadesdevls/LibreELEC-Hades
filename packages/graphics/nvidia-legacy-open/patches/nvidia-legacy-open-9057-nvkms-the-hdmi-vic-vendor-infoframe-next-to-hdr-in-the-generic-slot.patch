From e9ca4c57813b067c635968e8dfb17ef86f1272b4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:27:58 +0000
Subject: [PATCH] nvkms: the HDMI_VIC vendor InfoFrame next to HDR, in the
 generic slot

Hades' 615 nvidia-open-kernel-modules-9043, for this driver. A display
whose HDMI 1.4b VSDB lists the 4K formats by HDMI_VIC and whose HF-VSDB
does not set UHD_VIC gets those modes by their HDMI_VIC timing (AVI VIC 0,
NVKMS's HDMI vendor InfoFrame with the HDMI_VIC). On Maxwell, Pascal and
Volta the HDR InfoFrame shares the vendor-specific slot with it
(nvEvo1SendHdmiInfoFrame()) and overwrites it with HDR10: the display gets
VIC 0 and no HDMI_VIC.

With the HDR InfoFrame enabled, that vendor InfoFrame now goes in the
generic slot, which is free on these HALs (no HDMI VRR), unless an HDR10+
VSIF needs it (9055 keeps it then, and gives it back when the HDR10+ VSIF
of a frame stops), and never to a display with UHD_VIC: AVI VIC 0, the
HDMI vendor InfoFrame and the HDR InfoFrame, as Linux and NVKMS on the
HAL with a slot for each send them. The vendor-specific slot and the AVI
InfoFrame carry the same bytes as before in every case, as do SDR, HDR10+,
Dolby Vision and every mode with a CTA VIC.
---
 src/nvidia-modeset/include/nvkms-hades.h | 21 +++++++++++++++++----
 src/nvidia-modeset/src/nvkms-hdmi.c      | 23 ++++++++++++++++++-----
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index 41673a5..9300e9a 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -243,13 +243,20 @@ static inline const char *nvHadesVsifRefusal(
  *    the vendor one keeps its slot and no HDR InfoFrame goes out (dropped);
  *  - NVKMS_2D, NVKMS's own of a 2D mode (one named by an HDMI_VIC), and NONE:
  *    as NVKMS sends them to a display that does not declare 3D, the HDR
- *    InfoFrame (and the SDR one) over the vendor one;
+ *    InfoFrame (and the SDR one) over the vendor one; and, for NVKMS_2D with
+ *    HDR to a display without UHD_VIC (uhdVic: it takes the UHD formats by
+ *    their CTA VIC, which NVKMS then matches first), the vendor one in the
+ *    generic slot where it is free and no HDR10+ VSIF needs it: what such a
+ *    display gets from NVKMS on the HALs with a slot for each, and from Linux
+ *    (an AVI VIC of 0, the HDMI vendor InfoFrame with the HDMI_VIC, and the
+ *    HDR InfoFrame);
  *  - an HDR10+ VSIF in the generic slot when it is free and no vendor
  *    InfoFrame is there (else dropped); the HDR InfoFrame is never left out
  *    for it.
  * To a display that does not declare 3D this is what NVKMS sent, packet by
- * packet, with one addition: the HDR InfoFrame next to a CLIENT vendor
- * InfoFrame, which NVKMS left out.
+ * packet, with two additions: the HDR InfoFrame next to a CLIENT vendor
+ * InfoFrame, which NVKMS left out, and the HDMI_VIC one in the generic slot
+ * with HDR.
  */
 #define NVKMS_HADES_VENDOR_NONE          0
 #define NVKMS_HADES_VENDOR_DOLBY         1
@@ -268,7 +275,8 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
                                                       NvBool hdr10Plus,
                                                       NvBool hdrSink,
                                                       NvBool hdrEnabled,
-                                                      NvBool genericFree)
+                                                      NvBool genericFree,
+                                                      NvBool uhdVic)
 {
     struct NvKmsHadesSlots s;
 
@@ -292,6 +300,11 @@ static inline struct NvKmsHadesSlots nvHadesHdmiSlots(NvU32 vendor,
             s.dropped = "HDR InfoFrame: the vendor InfoFrame keeps the vendor-specific slot, and the generic one is not free";
         }
         break;
+    case NVKMS_HADES_VENDOR_NVKMS_2D:
+        if (hdrSink && hdrEnabled && !uhdVic && genericFree && !hdr10Plus) {
+            s.vendorGeneric = NV_TRUE;
+        }
+        break;
     default:
         break;
     }
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index fe6ac84..54a5af7 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -581,7 +581,8 @@ static struct NvKmsHadesSlots HadesHdmiSlotsOf(const NVDispEvoRec *pDispEvo,
                                 (pHdrInfo->static_metadata_type == 1),
                             pDispEvo->headState[head].hdrInfoFrame.state ==
                                 NVKMS_HDR_INFOFRAME_STATE_ENABLED,
-                            HadesHdmiGenericSlotFree(pDispEvo->pDevEvo));
+                            HadesHdmiGenericSlotFree(pDispEvo->pDevEvo),
+                            pEdidInfo->hdmiForumInfo.uhd_vic != 0);
 }
 
 /*
@@ -612,6 +613,8 @@ static void HadesSendGenericSlot(const NVDispEvoRec *pDispEvo,
                      head,
                      (vendor == NVKMS_HADES_VENDOR_FRAME_PACKING) ?
                          "the 3D vendor InfoFrame of the frame-packed mode" :
+                     (vendor == NVKMS_HADES_VENDOR_NVKMS_2D) ?
+                         "the HDMI_VIC vendor InfoFrame of the mode" :
                          "the client's vendor InfoFrame");
     } else if (slots.hdr10PlusGeneric) {
         HadesSendHdr10Plus(pDispEvo, head, HadesHdr10PlusOf(pInfoFrameState));
@@ -856,14 +859,16 @@ const char *nvHadesHdr10PlusRefusalOf(const NVDpyEvoRec *pDpyEvo,
             nvDpyIsHdmiEvo(pDpyEvo)),
         genericFree,
         vendor == NVKMS_HADES_VENDOR_DOLBY,
-        nvHadesHdmiSlots(vendor, NV_TRUE, hdrSink, hdrEnabled, genericFree).vendorGeneric);
+        nvHadesHdmiSlots(vendor, NV_TRUE, hdrSink, hdrEnabled, genericFree,
+                         pEdidInfo->hdmiForumInfo.uhd_vic != 0).vendorGeneric);
 }
 
 /*
  * Hades: the HDR10+ VSIF of a frame (NVKMS_HADES_IOCTL_HDR10PLUS): kept with
  * the InfoFrame state of the api head, so that a later InfoFrame update sends
- * it again, and written alone into the generic slot of its head, or that slot
- * stopped, unless the vendor InfoFrame is in it (nvHadesHdmiSlots()).
+ * it again, and written alone into the generic slot of its head; or, when it
+ * stops, that slot given what nvHadesHdmiSlots() puts there without it (the
+ * vendor InfoFrame, or nothing).
  */
 void nvHadesHdr10PlusWrite(NVDispEvoRec *pDispEvo, const NvU32 apiHead,
                            const struct NvKmsHdmiVsifMetadata *pHdr10Plus)
@@ -879,13 +884,21 @@ void nvHadesHdr10PlusWrite(NVDispEvoRec *pDispEvo, const NvU32 apiHead,
     if (pHdr10Plus->payloadSize != 0) {
         HadesSendHdr10Plus(pDispEvo, head, pHdr10Plus);
     } else {
-        const NVDpyEvoRec *pDpyEvo =
+        NVDpyEvoPtr pDpyEvo =
             nvGetOneArbitraryDpyEvo(pApiHeadState->activeDpys, pDispEvo);
+        NVT_VENDOR_SPECIFIC_INFOFRAME frame;
+        NvBool dolby;
 
         if ((pDpyEvo == NULL) || !pDpyEvo->parsedEdid.valid ||
             !HadesHdmiSlotsOf(pDispEvo, head, &pApiHeadState->infoFrame,
                               &pDpyEvo->parsedEdid.info, NULL).vendorGeneric) {
             nvHadesEvo1DisableHdmiGenericInfoFrame(pDispEvo, head);
+        } else if (HadesVendorInfoFrame(&pApiHeadState->infoFrame,
+                                        &pDpyEvo->parsedEdid.info, &frame, &dolby)) {
+            /* the vendor InfoFrame that the HDR10+ one took the slot from */
+            nvHadesEvo1SendHdmiGenericInfoFrame(pDispEvo, head, &frame.Header,
+                                                sizeof(frame.Header) +
+                                                frame.Header.length);
         }
     }
 }
