From a8f40a8074b7334a208af27f1ef0d290fa98bc08 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:08:26 +0000
Subject: [PATCH] nvkms: keep the EDID blocks that an HDMI Forum EEODB counts

The same as nvidia-open-kernel-modules-9070, for driver 580 (nvkms-dpy.c now
includes nvkms-hades.h, which holds nvHadesEdidKeptSize()).

PatchAndParseEdid() cuts the EDID that RM read to the size that
NvTiming_ParseEDIDInfo() counted (NVT_EDID_ACTUAL_SIZE()), and the parse takes
the count of an HDMI Forum EEODB only from an EDID whose base block is of
version 1.3 (nvt_edid.c). The blocks that only the EEODB counts were therefore
cut from an EDID of version 1.4 whose base block counts fewer extensions than
its EEODB: they never reached nvidia-drm, the connector's EDID property
(nvidia-legacy-open-9041) and user space, which reads the Dolby Vision block of
the display there (Kodi). DRM takes the EEODB of either version (drm_edid.c).

The buffer is now never cut below the blocks that the EEODB counts, read where
DRM reads it (the first data block of block 1, a CTA-861 extension of revision
3 or later; HDMI 2.1, 10.3.6), and never past what RM read. NVKMS's own parse
is unchanged; an EDID without an EEODB, of version 1.3, or whose base block
counts those blocks keeps the bytes it kept.

Checked on the host with NVIDIA's EDID library of this release and a matrix of
16 EDIDs: the EDID 1.4 with an extension count of 1, an EEODB of 3 and its
Dolby Vision block in block 3 was cut to 256 of its 512 bytes and is now kept
whole; the 15 others keep what they kept.
---
 src/nvidia-modeset/include/nvkms-hades.h | 34 ++++++++++++++++++++++++
 src/nvidia-modeset/src/nvkms-dpy.c       |  3 +++
 2 files changed, 37 insertions(+)

diff --git a/src/nvidia-modeset/include/nvkms-hades.h b/src/nvidia-modeset/include/nvkms-hades.h
index ad5755d..eb1903a 100644
--- a/src/nvidia-modeset/include/nvkms-hades.h
+++ b/src/nvidia-modeset/include/nvkms-hades.h
@@ -753,4 +753,38 @@ static inline NvBool nvHadesHdrWantsYCbCr422(NvBool enabled,
            hdmiSink && !hdmi10BpcRgb && yuv2020 && (yuv422MaxBpc >= 10);
 }
 
+/*
+ * Hades: the bytes of the EDID that NVKMS keeps of the length bytes that RM read: PatchAndParseEdid()
+ * cuts the buffer to the size that the parse counted (parsedSize, NVT_EDID_ACTUAL_SIZE()), and this
+ * is never fewer than the blocks that an HDMI Forum EEODB counts. NvTiming_ParseEDIDInfo() takes the
+ * count of the EEODB only from an EDID whose base block is of version 1.3 (nvt_edid.c), so the
+ * blocks that only the EEODB counts were cut from one of version 1.4: they never reached
+ * nvidia-drm, the connector's EDID property and user space, which reads the Dolby Vision block of
+ * the display there (Kodi). DRM (drm_edid.c) and NVIDIA's DisplayPort library (dp_edid.cpp) take
+ * the EEODB of either version. It is read where DRM reads it: the first data block of block 1, a
+ * CTA-861 extension of revision 3 or later whose data blocks take 3 bytes or more (HDMI 2.1,
+ * 10.3.6: bytes 4 to 6 of block 1), of the extended tag 0x78 with a payload of two bytes or more,
+ * with a base block that counts an extension. Only ever more than parsedSize, and never more than
+ * RM read: an EDID without an EEODB, or whose parse counted those blocks (version 1.3), keeps the
+ * bytes it kept.
+ */
+static inline NvU32 nvHadesEdidKeptSize(const NvU8 *edid, NvU32 length, NvU32 parsedSize)
+{
+    NvU32 eeodbSize;
+
+    if ((edid == NULL) || (length < 2 * 128) || (edid[126] == 0) ||
+        (edid[128] != 0x02) || (edid[129] < 3) ||
+        (edid[130] < 4 + 3) || (edid[130] > 127) ||
+        ((edid[132] >> 5) != 7) || ((edid[132] & 0x1F) < 2) || (edid[133] != 0x78)) {
+        return parsedSize;
+    }
+
+    eeodbSize = ((NvU32)edid[134] + 1) * 128;
+    if (eeodbSize > length) {
+        eeodbSize = length;
+    }
+
+    return (eeodbSize > parsedSize) ? eeodbSize : parsedSize;
+}
+
 #endif /* __NVKMS_HADES_H__ */
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index a3e99ea..0a3d809 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -40,6 +40,7 @@
 
 #include "nvkms-api.h"
 #include "nvkms-private.h"
+#include "nvkms-hades.h"
 
 #include "nvos.h"
 #include "timing/dpsdp.h"
@@ -2269,6 +2270,8 @@ static void PatchAndParseEdid(
     /* resize the EDID buffer, if necessary */
 
     edidSize = NVT_EDID_ACTUAL_SIZE(&pParsedEdid->info);
+    /* Hades: and the blocks that only an HDMI Forum EEODB counts (nvkms-hades.h) */
+    edidSize = nvHadesEdidKeptSize(pEdid->buffer, pEdid->length, edidSize);
 
     if (edidSize < pEdid->length) {
         NvU8 *pEdidData = nvAlloc(edidSize);
-- 
2.53.0

