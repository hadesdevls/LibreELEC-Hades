From 125791bdfbf9ffb1b00cb429f0c5a29f90d17a7c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 19:54:18 +0000
Subject: [PATCH] nvkms: say in the kernel log each InfoFrame that a head puts
 on the cable

NVKMS writes the InfoFrames of a head and says nothing of them, so a user's
log cannot tell what a display was sent in two modes that behave differently
(Dolby Vision at 3840x2160 at 50 Hz and not at 60 Hz through the same port,
issue 4 of Hades, on 615; the same question can come on this release).

Each InfoFrame that a head writes is now said in the kernel log when it
changes, and each slot when it is turned off, as Hades' 615 does it
(nvidia-open-kernel-modules-9054): the head, its connector, the slot, what the
packet is (with the VIC of an AVI InfoFrame and the IEEE OUI of a
vendor-specific one) and the bytes as they are written (header, checksum,
payload), e.g. "Hades: head 0 (HDMI-0): AVI InfoFrame, VIC 93, in the AVI
slot, 17 bytes: 82 02 0d ...". Through the HAL of Maxwell, Pascal and Volta
(nvEvo1SendHdmiInfoFrame(), its disable, and the generic slot that Hades
writes for HDR10+ and for the vendor InfoFrame next to HDR), for an HDMI
connector and the TMDS output of a dual-mode DisplayPort connector (9051).

Bounded, so that it can stay on: a packet written again with the same bytes
says nothing; a vendor-specific InfoFrame whose bytes change within a minute
of the last line of the same one (the same OUI: HDR10+ changes with the
scenes) is counted, and the next line of that slot says how many there were;
every other change is shown; and at most 400 lines for a GPU until
nvidia-modeset is loaded again, which the last line says.

Nothing that goes out changes: only the log.

Checked with the host test of 9062 and 9064 on the HAL and the HDMI packet
library of the tree on a register file: after every step the kernel log says
each slot as it is on the cable (HDR10+ aside), and the STATE lines of every
step are identical to those of the tree before.
---
 src/nvidia-modeset/include/nvkms-evo1.h  |   7 +
 src/nvidia-modeset/include/nvkms-types.h |  26 +++
 src/nvidia-modeset/src/nvkms-evo1.c      | 218 +++++++++++++++++++++++
 3 files changed, 251 insertions(+)

diff --git a/src/nvidia-modeset/include/nvkms-evo1.h b/src/nvidia-modeset/include/nvkms-evo1.h
index 9d1d4dd..b062205 100644
--- a/src/nvidia-modeset/include/nvkms-evo1.h
+++ b/src/nvidia-modeset/include/nvkms-evo1.h
@@ -54,6 +54,13 @@ void nvEvo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                              NvBool needChecksum);
 
 /* Hades: the generic InfoFrame slot (nvkms-hades.h, nvHadesHdmiSlots()) */
+void nvHadesLogHdmiPacket(const NVDispEvoRec *pDispEvo,
+                          const NvU32 head,
+                          const NvU32 slot,
+                          const NvU32 name,
+                          const NvU8 *pPacket,
+                          const NvU32 packetLen,
+                          const NvU32 pb1);
 void nvHadesEvo1SendHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
                                          const NvU32 head,
                                          const NVT_INFOFRAME_HEADER *pInfoFrameHeader,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index 2b77fda..8f175c2 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -1013,6 +1013,23 @@ enum NvKmsLUTState {
 };
 
 /* Device-specific EVO state (subdevice- and channel-independent) */
+/*
+ * Hades: what the kernel log last said of one InfoFrame slot of a head
+ * (nvHadesLogHdmiPacket()): whether it is on, the bytes of its packet, when
+ * that line was written, and how many changes since then it did not show.
+ */
+#define NV_HADES_INFOFRAME_LOG_SLOTS 16
+#define NV_HADES_INFOFRAME_LOG_BYTES 36
+#define NV_HADES_INFOFRAME_LOG_LINES 400
+
+struct NvHadesInfoFrameLog {
+    NvU64 lastUs;
+    NvU16 notShown;
+    NvU8 on;
+    NvU8 len;
+    NvU8 bytes[NV_HADES_INFOFRAME_LOG_BYTES];
+};
+
 typedef struct _NVEvoDevRec {
 
     NvU8                gpuLogIndex;
@@ -1359,6 +1376,15 @@ typedef struct _NVEvoDevRec {
      */
     NvU8 hadesAviCtaVic[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
     NvU32 hadesAviCtaClock[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS];
+
+    /*
+     * Hades: the InfoFrames that the kernel log said, per display owner, head
+     * and slot (an NVHDMIPKT_TYPE), and the lines it wrote for this GPU
+     * (nvHadesLogHdmiPacket())
+     */
+    struct NvHadesInfoFrameLog
+        hadesInfoFrameLog[NVKMS_MAX_SUBDEVICES][NV_MAX_HEADS][NV_HADES_INFOFRAME_LOG_SLOTS];
+    NvU32 hadesInfoFrameLogLines;
 } NVDevEvoRec;
 
 /*
diff --git a/src/nvidia-modeset/src/nvkms-evo1.c b/src/nvidia-modeset/src/nvkms-evo1.c
index de75131..274ccc0 100644
--- a/src/nvidia-modeset/src/nvkms-evo1.c
+++ b/src/nvidia-modeset/src/nvkms-evo1.c
@@ -609,6 +609,210 @@ static NVHDMIPKT_TC EvoInfoFrameToHdmiLibTransmitCtrl(
     return hdmiLibTransmitCtrl;
 }
 
+/*
+ * Hades: the kernel log says each InfoFrame that a head puts on the cable when
+ * it changes, and each slot that is turned off: the head, its connector, the
+ * slot, what the packet is (with the VIC of an AVI InfoFrame and the IEEE OUI
+ * of a vendor-specific one) and its bytes as they are written (header,
+ * checksum, payload), so that two modes, two ports or two GPUs can be compared
+ * byte for byte from a user's log (Dolby Vision through the same port at
+ * 3840x2160 at 50 Hz and not at 60 Hz, issue 4 of Hades). Bounded: a packet
+ * written again with the same bytes says nothing (a mode set writes them
+ * all); a vendor-specific InfoFrame (or an extended metadata packet) whose
+ * bytes change within a minute of the last line of the same one (the same
+ * type and IEEE OUI) is counted, and the next line of that slot says how many
+ * there were (HDR10+ changes with the scenes), while every other change is
+ * shown (an AVI InfoFrame that changes its VIC right after a mode set); and
+ * at most NV_HADES_INFOFRAME_LOG_LINES lines for a GPU until nvidia-modeset is
+ * loaded again. slot is the NVHDMIPKT_TYPE that
+ * keys the slot, name the one it is named by (the register of the pair, on
+ * the HALs with generic shared InfoFrames); pPacket NULL: the slot was turned
+ * off; pb1: where PB1 is in pPacket.
+ */
+static void HadesSlotName(NvU32 name, char *buf, NvU32 size)
+{
+    if (name == NVHDMIPKT_TYPE_GENERIC) {
+        nvkms_snprintf(buf, size, "the generic slot");
+    } else if (name == NVHDMIPKT_TYPE_AVI_INFOFRAME) {
+        nvkms_snprintf(buf, size, "the AVI slot");
+    } else if (name == NVHDMIPKT_TYPE_VENDOR_SPECIFIC_INFOFRAME) {
+        nvkms_snprintf(buf, size, "the vendor-specific slot");
+    } else if ((name >= NVHDMIPKT_TYPE_SHARED_GENERIC1) &&
+               (name <= NVHDMIPKT_TYPE_SHARED_GENERIC10)) {
+        nvkms_snprintf(buf, size, "shared generic slot %u",
+                       name - NVHDMIPKT_TYPE_SHARED_GENERIC1 + 1);
+    } else {
+        nvkms_snprintf(buf, size, "slot %u", name);
+    }
+}
+
+static void HadesPacketName(const NvU8 *pPacket, NvU32 len, NvU32 pb1,
+                            char *buf, NvU32 size)
+{
+    switch (pPacket[0]) {
+    case 0x81:
+        if (len >= pb1 + 3) {
+            nvkms_snprintf(buf, size, "vendor-specific InfoFrame of OUI %02X-%02X-%02X",
+                           pPacket[pb1 + 2], pPacket[pb1 + 1], pPacket[pb1]);
+        } else {
+            nvkms_snprintf(buf, size, "vendor-specific InfoFrame");
+        }
+        break;
+    case 0x82:
+        if (len >= pb1 + 4) {
+            nvkms_snprintf(buf, size, "AVI InfoFrame, VIC %u", pPacket[pb1 + 3]);
+        } else {
+            nvkms_snprintf(buf, size, "AVI InfoFrame");
+        }
+        break;
+    case 0x83:
+        nvkms_snprintf(buf, size, "SPD InfoFrame");
+        break;
+    case 0x84:
+        nvkms_snprintf(buf, size, "audio InfoFrame");
+        break;
+    case 0x87:
+        nvkms_snprintf(buf, size, "HDR InfoFrame (DR&M)");
+        break;
+    case 0x7F:
+        nvkms_snprintf(buf, size, "extended metadata packet");
+        break;
+    default:
+        nvkms_snprintf(buf, size, "packet of type 0x%02X", pPacket[0]);
+        break;
+    }
+}
+
+/*
+ * Hades: the packet is a vendor-specific InfoFrame or an extended metadata
+ * packet, of the type and the IEEE OUI of the one the log said last
+ */
+static NvBool HadesSameDynamicPacket(const struct NvHadesInfoFrameLog *pLog,
+                                     const NvU8 *pPacket, NvU32 len, NvU32 pb1)
+{
+    if ((pLog->len == 0) || (pLog->bytes[0] != pPacket[0])) {
+        return NV_FALSE;
+    }
+    if (pPacket[0] == 0x7F) {
+        return NV_TRUE;
+    }
+    return (pPacket[0] == 0x81) && (len >= pb1 + 3) && (pLog->len >= pb1 + 3) &&
+           (nvkms_memcmp(&pLog->bytes[pb1], &pPacket[pb1], 3) == 0);
+}
+
+void nvHadesLogHdmiPacket(const NVDispEvoRec *pDispEvo,
+                          const NvU32 head,
+                          const NvU32 slot,
+                          const NvU32 name,
+                          const NvU8 *pPacket,
+                          const NvU32 packetLen,
+                          const NvU32 pb1)
+{
+    static const char digits[] = "0123456789abcdef";
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    const NvU32 sd = pDispEvo->displayOwner;
+    const NVConnectorEvoRec *pConnectorEvo;
+    struct NvHadesInfoFrameLog *pLog;
+    char where[32];
+    char what[64];
+    char hex[3 * NV_HADES_INFOFRAME_LOG_BYTES + 1];
+    NvU32 len, i;
+    NvU64 now;
+
+    if ((sd >= NVKMS_MAX_SUBDEVICES) || (head >= NV_MAX_HEADS) ||
+        (slot >= NV_HADES_INFOFRAME_LOG_SLOTS)) {
+        return;
+    }
+    pLog = &pDevEvo->hadesInfoFrameLog[sd][head][slot];
+    len = (pPacket == NULL) ? 0 :
+          ((packetLen < NV_HADES_INFOFRAME_LOG_BYTES) ? packetLen :
+                                                        NV_HADES_INFOFRAME_LOG_BYTES);
+
+    /* nothing that changes on the cable */
+    if (pPacket == NULL) {
+        if (!pLog->on) {
+            return;
+        }
+    } else if ((len == 0) ||
+               (pLog->on && (pLog->len == len) &&
+                (nvkms_memcmp(pLog->bytes, pPacket, len) == 0))) {
+        return;
+    }
+
+    now = nvkms_get_usec();
+    if ((pPacket != NULL) && pLog->on && HadesSameDynamicPacket(pLog, pPacket, len, pb1) &&
+        ((now - pLog->lastUs) < 60000000ULL)) {
+        /* the same vendor-specific InfoFrame again within a minute: counted */
+        if (pLog->notShown < 0xFFFF) {
+            pLog->notShown++;
+        }
+        nvkms_memcpy(pLog->bytes, pPacket, len);
+        pLog->len = (NvU8)len;
+        return;
+    }
+
+    if (pDevEvo->hadesInfoFrameLogLines < NV_HADES_INFOFRAME_LOG_LINES) {
+        pConnectorEvo = pDispEvo->headState[head].pConnectorEvo;
+        HadesSlotName(name, where, sizeof(where));
+        pDevEvo->hadesInfoFrameLogLines++;
+
+        if (pPacket == NULL) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: head %u (%s): %s turned off",
+                         head,
+                         (pConnectorEvo != NULL) ? pConnectorEvo->name : "no connector",
+                         where);
+        } else {
+            for (i = 0; i < len; i++) {
+                hex[3 * i] = ' ';
+                hex[3 * i + 1] = digits[pPacket[i] >> 4];
+                hex[3 * i + 2] = digits[pPacket[i] & 0xF];
+            }
+            hex[3 * len] = '\0';
+            HadesPacketName(pPacket, len, pb1, what, sizeof(what));
+            if (pLog->on && (pLog->notShown != 0)) {
+                nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                             "Hades: head %u (%s): %s in %s, %u bytes:%s (%u changes of it since its last line were not shown)",
+                             head,
+                             (pConnectorEvo != NULL) ? pConnectorEvo->name : "no connector",
+                             what, where, len, hex, pLog->notShown);
+            } else {
+                nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                             "Hades: head %u (%s): %s in %s, %u bytes:%s",
+                             head,
+                             (pConnectorEvo != NULL) ? pConnectorEvo->name : "no connector",
+                             what, where, len, hex);
+            }
+        }
+        if (pDevEvo->hadesInfoFrameLogLines == NV_HADES_INFOFRAME_LOG_LINES) {
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "Hades: the kernel log said %u InfoFrames of this GPU: it says no more until nvidia-modeset is loaded again",
+                         NV_HADES_INFOFRAME_LOG_LINES);
+        }
+    }
+
+    pLog->on = (pPacket != NULL);
+    pLog->len = (NvU8)len;
+    if (len != 0) {
+        nvkms_memcpy(pLog->bytes, pPacket, len);
+    }
+    pLog->lastUs = now;
+    pLog->notShown = 0;
+}
+
+/* Hades: the slot of the EVO1 HAL that an InfoFrame of this type goes in */
+static NvU32 HadesEvo1Slot(NvU8 nvtInfoFrameType)
+{
+    switch (nvtInfoFrameType) {
+    case NVT_INFOFRAME_TYPE_EXTENDED_METADATA_PACKET:
+        return NVHDMIPKT_TYPE_GENERIC;
+    case NVT_INFOFRAME_TYPE_VIDEO:
+        return NVHDMIPKT_TYPE_AVI_INFOFRAME;
+    default:
+        return NVHDMIPKT_TYPE_VENDOR_SPECIFIC_INFOFRAME;
+    }
+}
+
 static void Evo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
                                   const NvU32 head,
                                   const NvEvoInfoFrameTransmitControl transmitCtrl,
@@ -734,6 +938,11 @@ static void Evo1SendHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
 
     if (ret != NVHDMIPKT_SUCCESS) {
         nvAssert(ret == NVHDMIPKT_SUCCESS);
+    } else {
+        /* Hades: what the head puts on the cable, in the kernel log */
+        nvHadesLogHdmiPacket(pDispEvo, head, hdmiLibType, hdmiLibType, infoframe,
+                             infoframeSize + (needChecksum ? sizeof(checksum) : 0),
+                             headerSize + (needChecksum ? sizeof(checksum) : 0));
     }
 
     nvFree(infoframe);
@@ -795,6 +1004,10 @@ void nvHadesEvo1DisableHdmiGenericInfoFrame(const NVDispEvoRec *pDispEvo,
                                NVHDMIPKT_TRANSMIT_CONTROL_DISABLE);
     if (ret != NVHDMIPKT_SUCCESS) {
         nvAssert(ret == NVHDMIPKT_SUCCESS);
+    } else {
+        /* Hades: the slot turned off, in the kernel log */
+        nvHadesLogHdmiPacket(pDispEvo, head, NVHDMIPKT_TYPE_GENERIC,
+                             NVHDMIPKT_TYPE_GENERIC, NULL, 0, 0);
     }
     pHeadState->hadesGenericInfoFrame = FALSE;
 }
@@ -829,6 +1042,11 @@ void nvEvo1DisableHdmiInfoFrame(const NVDispEvoRec *pDispEvo,
 
     if (ret != NVOS_STATUS_SUCCESS) {
         nvAssert(!"NV0073_CTRL_CMD_SPECIFIC_SET_OD_PACKET_CTRL failed");
+    } else {
+        /* Hades: the slot turned off, in the kernel log */
+        const NvU32 slot = HadesEvo1Slot(nvtInfoFrameType);
+
+        nvHadesLogHdmiPacket(pDispEvo, head, slot, slot, NULL, 0, 0);
     }
 }
 
-- 
2.53.0

