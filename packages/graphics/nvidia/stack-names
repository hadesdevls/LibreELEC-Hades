# The names that user space opens for NVIDIA's driver, "<dir> <name>": links that the recipe of
# nvidia makes to the files of its release, then turned into links to /run/nvidia/<name>
# (scripts/stack-functions), where kernel-overlays-setup points them at the files of the
# driver chosen at boot (scripts/stack-select, scripts/stack-links).
# EGL (10_nvidia.json of glvnd names libEGL_nvidia.so.0) and OpenGL ES
/usr/lib libEGL_nvidia.so.0
/usr/lib libEGL_nvidia.so
/usr/lib libGLESv2_nvidia.so.2
/usr/lib libGLESv2_nvidia.so
/usr/lib libnvidia-eglcore.so
/usr/lib libnvidia-glsi.so
/usr/lib libnvidia-tls.so
# GBM (the backend that Mesa's libgbm loads for nvidia-drm)
/usr/lib/gbm nvidia-drm_gbm.so
/usr/lib liballocator.so.0
# CUDA and NVDEC (nvidia-vaapi-driver opens libcuda.so.1 and libnvcuvid.so.1)
/usr/lib libcuda.so.1
/usr/lib libcuda.so
/usr/lib libnvcuvid.so.1
/usr/lib libnvcuvid.so
# NVML and nvidia-smi
/usr/lib libnvidia-ml.so.1
/usr/lib libnvidia-ml.so
/usr/bin nvidia-smi
