[Unit]
Description=Kodi waits, 20 s at most, for the DRM device of each NVIDIA card
# (nvidia-drm makes it once udev has loaded it, while the rest of the system starts; a PC without an NVIDIA display
# device is not waited for, and Kodi waits only where this has not ended by the time it would start: /usr/lib/nvidia/drm-wait)
After=systemd-udev-trigger.service
Before=kodi.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nvidia/drm-wait
TimeoutStartSec=30
# (it reads /sys and asks udev whether it has work queued: nothing else)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=kodi.service
