#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# A driver that starts after the driver of the NVIDIA card has started (modprobe.d/after-nvidia.conf: kmod runs this in
# place of loading the module, with its name and the options of the command line). Where the PC has an NVIDIA display
# device (vendor 0x10de, class 0x03xxxx, as drm-wait counts them) and the nvidia module is there to be loaded, this waits
# until nvidia has started (/sys/module/nvidia/initstate "live": its init, which starts the card itself, has returned),
# then loads the module as kmod would have (modprobe --ignore-install). Not waited for: a PC without such a device,
# an nvidia that is not there to be loaded, or one that has not begun to start 5 s after this was asked (it was left
# out); and never more than 30 s in all. Nothing else is loaded or asked of a driver.
# Why: on a PC with an RTX 5090 and an ASUS Xonar Essence STX II (C-Media CMI8788 behind an ASMedia ASM1083 PCIe-to-PCI
# bridge; snd_virtuoso), some starts stopped the whole PC about two seconds after udev began to load drivers: in each of
# the four that the diagnostics kept (1.0 RC8, 1.0, 1.1 twice; issue 14 of LibreELEC Hades), and in the two that the
# user photographed on another build, the Xonar's driver had enabled the card and the NVIDIA driver was starting the
# 5090 at the same moment, and neither had finished; without the card the PC never stopped there. The starts that
# worked had the same overlap (Xonar 1.3 s, 0.8 s of it a pause of the driver against the pop of its outputs; nvidia
# 1.16 s for the card). Started one after the other, a stop that comes back points at the card on its own, and the
# diagnostics (previous-boot/not-returned.txt) then name the Xonar's driver alone.
# The kernel log says what was done, on a line that starts with "after-nvidia:".
#
# HADES_SYSFS, HADES_KMSG, HADES_UPTIME, HADES_MODPROBE, HADES_START_LIMIT and HADES_WAIT_LIMIT stand for /sys,
# /dev/kmsg, /proc/uptime, /usr/sbin/modprobe, 5 and 30 (seconds) in a test.

SYSFS="${HADES_SYSFS:-/sys}"
KMSG="${HADES_KMSG:-/dev/kmsg}"
UPTIME="${HADES_UPTIME:-/proc/uptime}"
MODPROBE="${HADES_MODPROBE:-/usr/sbin/modprobe}"
START_LIMIT="${HADES_START_LIMIT:-5}"
LIMIT="${HADES_WAIT_LIMIT:-30}"

module="$1"
shift

say() { echo "after-nvidia: ${module}: $*" >> "${KMSG}" 2>/dev/null || echo "after-nvidia: ${module}: $*"; }
# hundredths of a second since the start of the system
cs() {
  local u
  read -r u _ < "${UPTIME}"
  echo $(( ${u%.*} * 100 + 1${u#*.} - 100 ))
}
s() { printf '%d.%d s' $(($1 / 100)) $(($1 % 100 / 10)); }
load() { exec "${MODPROBE}" --ignore-install "${module}" "$@"; }

if [ -z "${module}" ]; then
  echo "after-nvidia: no module named" >&2
  exit 1
fi

nvidia=""
for dev in "${SYSFS}"/bus/pci/devices/*; do
  [ -r "${dev}/vendor" ] && [ -r "${dev}/class" ] || continue
  read -r vendor < "${dev}/vendor" || continue
  read -r class < "${dev}/class" || continue
  [ "${vendor}" = "0x10de" ] || continue
  case "${class}" in
    0x03????) nvidia="${nvidia}${nvidia:+ }${dev##*/}" ;;
  esac
done
if [ -z "${nvidia}" ]; then
  load "$@"
fi
state() { cat "${SYSFS}/module/nvidia/initstate" 2>/dev/null || echo "not loaded"; }
if [ "$(state)" = "live" ]; then
  load "$@"
fi
if [ "$(state)" = "not loaded" ] && ! "${MODPROBE}" -q -n nvidia 2>/dev/null; then
  say "the NVIDIA card ${nvidia} has no driver to wait for (no nvidia module): started now"
  load "$@"
fi

start=$(cs)
began=""
while :; do
  st=$(state)
  t=$(( $(cs) - start ))
  case "${st}" in
    live)
      say "started after the driver of the NVIDIA card ${nvidia}, which took $(s ${t}) more to start"
      load "$@"
      ;;
    "not loaded")
      if [ -n "${began}" ]; then
        say "nvidia went away while it started (after $(s ${t}); the lines of NVRM say why): started now"
        load "$@"
      fi
      if [ ${t} -ge $(( START_LIMIT * 100 )) ]; then
        say "nvidia did not begin to start in ${START_LIMIT} s (it was left out, or it failed): started now"
        load "$@"
      fi
      ;;
    *)
      began=1
      ;;
  esac
  if [ ${t} -ge $(( LIMIT * 100 )) ]; then
    say "nvidia had not started after ${LIMIT} s (${st}): started now"
    load "$@"
  fi
  usleep 50000 2> /dev/null || sleep 1
done
