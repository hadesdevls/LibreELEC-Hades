#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# The names that user space opens for NVIDIA's driver (/usr/lib/libEGL_nvidia.so.0,
# /usr/lib/gbm/nvidia-drm_gbm.so, libcuda.so.1 and the rest: links to /run/nvidia/<name> in the
# image) are pointed here at the files of the driver that stack-select chose: the lines
# "<name> <file>" of /usr/lib/nvidia/stacks/<legacy|open>. kernel-overlays-setup runs it right
# after choosing, so modules and user space are always of the same release.
# For the 580 driver it also writes the option that keeps all of its video memory across a sleep
# (/run/modprobe.d/hades-nvidia-sleep.conf, below).
#
# usage: stack-links legacy|open. HADES_ROOT and HADES_RUN stand for / and /run in a test.

ROOT="${HADES_ROOT:-}"
RUN="${HADES_RUN:-/run}"
stack="$1"

case "${stack}" in
  legacy|open) ;;
  *) echo "NVIDIA driver: unknown driver '${stack}'" >&2; exit 1 ;;
esac

list="${ROOT}/usr/lib/nvidia/stacks/${stack}"
if [ ! -r "${list}" ]; then
  echo "NVIDIA driver: no list of files for the ${stack} driver" >&2
  exit 1
fi

mkdir -p "${RUN}/nvidia" || exit 1
count=0
while read -r name file; do
  case "${name}" in
    ""|"#"*) continue ;;
    */*|.|..) echo "NVIDIA driver: bad name '${name}' in ${list}" >&2; continue ;;
  esac
  case "${file}" in
    /usr/*) ;;
    *) echo "NVIDIA driver: bad file '${file}' in ${list}" >&2; continue ;;
  esac
  ln -sfn "${file}" "${RUN}/nvidia/${name}" && count=$((count + 1))
done < "${list}"

echo "${stack}" > "${RUN}/nvidia/driver"

# Hades: the 580 driver keeps all of the video memory across a sleep (NVreg_PreserveVideoMemoryAllocations=1), with
# NVIDIA's power management interface, which /usr/lib/systemd/system-sleep/hades-nvidia drives; without it, that driver
# keeps only what it deems essential, and Kodi's pictures and menus may come back broken. The 620 driver (open modules)
# keeps it by itself, and gets nothing here. kmod reads /run/modprobe.d when nvidia is loaded, after this.
conf="${RUN}/modprobe.d/hades-nvidia-sleep.conf"
if [ "${stack}" = "legacy" ]; then
  if mkdir -p "${RUN}/modprobe.d" &&
     echo "options nvidia NVreg_PreserveVideoMemoryAllocations=1" > "${conf}"; then
    echo "NVIDIA driver: the legacy driver keeps its video memory across a sleep" >&2
  else
    echo "NVIDIA driver: ${conf} could not be written: the legacy driver keeps only some of its video memory across a sleep" >&2
  fi
else
  rm -f "${conf}"
fi
echo "NVIDIA driver: ${count} names lead to the files of the ${stack} driver" >&2
