# The names that user space opens for NVIDIA's driver (/usr/lib/libEGL_nvidia.so.0,
# /usr/lib/gbm/nvidia-drm_gbm.so, libcuda.so.1 and the rest: links to /run/nvidia/<name> in the
# image) are pointed here at the files of the driver that stack-select chose: the lines
# "<name> <file>" of /usr/lib/nvidia/stacks/<legacy|open>. kernel-overlays-setup runs it right
# after choosing, so modules and user space are always of the same release.
#
# usage: stack-links legacy|open. HADES_ROOT and HADES_RUN stand for / and /run in a test.

ROOT="${HADES_ROOT:-}"
RUN="${HADES_RUN:-/run}"
stack="$1"

case "${stack}" in
  legacy|open) ;;
  *) echo "NVIDIA driver: unknown driver '${stack}'" >&2; exit 1 ;;
esac

list="${ROOT}/usr/lib/nvidia/stacks/${stack}"
if [ ! -r "${list}" ]; then
  echo "NVIDIA driver: no list of files for the ${stack} driver" >&2
  exit 1
fi

mkdir -p "${RUN}/nvidia" || exit 1
count=0
while read -r name file; do
  case "${name}" in
    ""|"#"*) continue ;;
    */*|.|..) echo "NVIDIA driver: bad name '${name}' in ${list}" >&2; continue ;;
  esac
  case "${file}" in
    /usr/*) ;;
    *) echo "NVIDIA driver: bad file '${file}' in ${list}" >&2; continue ;;
  esac
  ln -sfn "${file}" "${RUN}/nvidia/${name}" && count=$((count + 1))
done < "${list}"

echo "${stack}" > "${RUN}/nvidia/driver"
echo "NVIDIA driver: ${count} names lead to the files of the ${stack} driver" >&2
