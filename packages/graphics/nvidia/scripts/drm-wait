#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# Before Kodi starts (nvidia-drm-wait.service): a bounded wait for nvidia-drm to have made the DRM device of each
# NVIDIA display device of this PC. udev loads nvidia and nvidia-drm by the PCI IDs of the card, while the rest of the
# system starts, and nothing ordered Kodi after that: a Kodi that looks at the graphics devices before nvidia-drm has
# made its own finds none, or only those of another card, and shows itself on no output, or on that other card, until
# it is started again (CDRMUtils::OpenDrm() looks once; the watch of the displays that come later takes its first look
# as what it compares with, and does not compare devices that changed). The wait for the network hides this on most
# starts, but not on the first one after an installation (kodi-waitonnetwork.service needs the settings of LibreELEC),
# nor where it is turned off or the clock is set at once. In the logs of 1.0 RC8, nvidia-drm had its device 2 to 3 s
# after udev started (5 s with a GTX of the 580 driver).
# What is waited for: of each NVIDIA display device (vendor 0x10de, class 0x03xxxx, as stack-select counts them), a DRM
# device of its own (<the PCI device>/drm/card*). Not waited for any longer once nvidia-drm is loaded and has none for a
# device (it does not drive that one), once udev has had nothing to do for 2 s while nvidia-drm is not loaded (it was
# left out, or it or nvidia failed: the lines of NVRM say why), or after 20 s. A PC with no such device is not waited
# for at all, and nothing is loaded or asked of a driver here. What was done is in the kernel log, on a line that
# starts with "nvidia-drm-wait:".
#
# HADES_SYSFS, HADES_KMSG, HADES_UPTIME, HADES_UDEVADM and HADES_WAIT_LIMIT stand for /sys, /dev/kmsg, /proc/uptime,
# udevadm and 20 (seconds) in a test.

SYSFS="${HADES_SYSFS:-/sys}"
KMSG="${HADES_KMSG:-/dev/kmsg}"
UPTIME="${HADES_UPTIME:-/proc/uptime}"
UDEVADM="${HADES_UDEVADM:-udevadm}"
LIMIT="${HADES_WAIT_LIMIT:-20}"

say() { echo "nvidia-drm-wait: $*" >> "${KMSG}" 2>/dev/null || echo "nvidia-drm-wait: $*"; }
# hundredths of a second since the start of the system
cs() {
  local u
  read -r u _ < "${UPTIME}"
  echo $(( ${u%.*} * 100 + 1${u#*.} - 100 ))
}
s() { printf '%d.%d s' $(($1 / 100)) $(($1 % 100 / 10)); }

devices=""
for dev in "${SYSFS}"/bus/pci/devices/*; do
  [ -r "${dev}/vendor" ] && [ -r "${dev}/class" ] || continue
  read -r vendor < "${dev}/vendor" || continue
  read -r class < "${dev}/class" || continue
  [ "${vendor}" = "0x10de" ] || continue
  case "${class}" in
    0x03????) devices="${devices} ${dev##*/}" ;;
  esac
done
[ -n "${devices}" ] || exit 0

# the DRM devices of the PCI device $1 ("card1"), none: nothing
cards() { ls -d "${SYSFS}/bus/pci/devices/$1/drm/card"[0-9]* 2> /dev/null | sed 's|.*/||' | tr '\n' ' ' | sed 's/ $//'; }
missing() {
  local d m=""
  for d in ${devices}; do [ -n "$(cards ${d})" ] || m="${m} ${d}"; done
  echo ${m}
}
drm_live() { [ "$(cat "${SYSFS}/module/nvidia_drm/initstate" 2> /dev/null)" = "live" ]; }
# (udevadm settle --timeout=0: whether udev has events queued or being handled, without waiting for them)
udev_idle() { "${UDEVADM}" settle --timeout=0 > /dev/null 2>&1; }

start=$(cs)
idle=""
while :; do
  m=$(missing)
  t=$(( $(cs) - start ))
  if [ -z "${m}" ]; then
    seen=""
    for d in ${devices}; do seen="${seen}${seen:+, }${d}: $(cards ${d})"; done
    if [ ${t} -lt 10 ]; then
      say "the DRM device of each NVIDIA card is there (${seen}): Kodi does not wait"
    else
      say "the DRM device of each NVIDIA card is there (${seen}) after $(s ${t}): Kodi starts now"
    fi
    exit 0
  fi
  if drm_live; then
    say "nvidia-drm is loaded and has no DRM device for ${m} (after $(s ${t})): Kodi starts without it"
    exit 0
  fi
  if udev_idle; then
    [ -n "${idle}" ] || idle=$(cs)
    if [ $(( $(cs) - idle )) -ge 200 ]; then
      say "nvidia-drm is not loaded, and udev has had nothing to do for 2 s (after $(s ${t})): it was left out, or it or nvidia failed (the lines of NVRM say why); Kodi starts without ${m}"
      exit 0
    fi
  else
    idle=""
  fi
  if [ ${t} -ge $(( LIMIT * 100 )) ]; then
    say "no DRM device for ${m} after ${LIMIT} s: Kodi starts without waiting longer"
    exit 0
  fi
  usleep 100000 2> /dev/null || sleep 1
done
