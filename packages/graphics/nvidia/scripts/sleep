#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# NVIDIA's power management interface for the 580 driver (nvidia-legacy: Maxwell, Pascal, Volta), as systemd-sleep runs
# it (/usr/lib/systemd/system-sleep/hades-nvidia; $1 pre or post, $2 the kind of sleep): "suspend" (or "hibernate") is
# written to /proc/driver/nvidia/suspend just before the system sleeps, and "resume" just after it wakes or after a sleep
# that failed, as NVIDIA's README asks ("Configuring Power Management Support", the 'systemd' configuration). The 580
# driver is started with NVreg_PreserveVideoMemoryAllocations=1 (stack-links): all of the video memory that Kodi's
# pictures and menus hold is kept across a sleep, not only what the driver deems essential, and that driver refuses a
# sleep without this interface. NVIDIA's own nvidia-sleep.sh also switches the console for the X server: Hades has no X
# server, and that is left out.
# The 620 driver (open modules) keeps video memory by itself (its UseKernelSuspendNotifiers, on by default) and makes no
# /proc/driver/nvidia/suspend: then this does nothing.
# What it did goes to the journal (systemd-sleep keeps what its hooks print), on a line that starts with "hades-nvidia:".
#
# HADES_NVIDIA_SUSPEND stands for /proc/driver/nvidia/suspend in a test.

SUSPEND="${HADES_NVIDIA_SUSPEND:-/proc/driver/nvidia/suspend}"

[ -e "${SUSPEND}" ] || exit 0

case "$1:$2" in
  pre:suspend)
    what=suspend
    ;;
  pre:suspend-then-hibernate)
    # (systemd says which of the two comes now; a system without hibernation only suspends)
    if [ "${SYSTEMD_SLEEP_ACTION}" = "hibernate" ]; then what=hibernate; else what=suspend; fi
    ;;
  pre:hibernate|pre:hybrid-sleep)
    what=hibernate
    ;;
  post:*)
    what=resume
    ;;
  *)
    exit 0
    ;;
esac

if echo "${what}" > "${SUSPEND}" 2>/dev/null; then
  echo "hades-nvidia: ${1} ${2}: ${what} written to the NVIDIA driver" >&2
  exit 0
fi
echo "hades-nvidia: ${1} ${2}: the NVIDIA driver did not take ${what} (the kernel log says why)" >&2
exit 1
