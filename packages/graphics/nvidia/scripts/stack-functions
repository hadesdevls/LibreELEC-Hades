# Sourced by the recipe of nvidia. The image carries two NVIDIA drivers, chosen at boot by the
# PCI ID of the card (scripts/stack-select): this one, and nvidia-legacy (580, for Maxwell,
# Pascal and Volta). Their files carry the release in their names, but the names that user
# space opens (stack-names: "<dir> <name>") do not: those are links to /run/nvidia/<name>,
# which scripts/stack-links points at the files of the driver chosen.

# nvidia_stack_targets <install dir> <stack-names>: "<name> <file>" for each name, the file
# being where the link that the recipe made leads, every link on the way followed.
nvidia_stack_targets() {
  local install="$1" dir name real
  while read -r dir name; do
    case "${dir}" in
      ""|"#"*) continue ;;
    esac
    [ -L "${install}${dir}/${name}" ] || die "nvidia: ${dir}/${name} is not a link"
    real="$(realpath -e "${install}${dir}/${name}")" || die "nvidia: ${dir}/${name} leads nowhere"
    case "${real}" in
      "${install}"/usr/*) ;;
      *) die "nvidia: ${dir}/${name} leads out of the image" ;;
    esac
    [ -f "${real}" ] || die "nvidia: ${dir}/${name} does not lead to a file"
    echo "${name} ${real#${install}}"
  done < "$2"
}

# nvidia_stack_redirect <install dir> <stack-names>: each of those links leads to /run/nvidia.
nvidia_stack_redirect() {
  local install="$1" dir name
  while read -r dir name; do
    case "${dir}" in
      ""|"#"*) continue ;;
    esac
    ln -sfn "/run/nvidia/${name}" "${install}${dir}/${name}"
  done < "$2"
}
