#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# Which NVIDIA driver this PC gets, from the PCI IDs of its NVIDIA display devices (vendor
# 0x10de, class 0x03xxxx: VGA, XGA or 3D controller). kernel-overlays-setup runs it in the
# initramfs, before any module loads. It prints "legacy" when every such device is in the list
# of nvidia-legacy (580: Maxwell, Pascal and Volta) and that driver is in the image, "open"
# (615, the modules of base) otherwise: no NVIDIA card, a Turing or later one, an ID that no
# list has, or cards for both drivers in one PC (one nvidia.ko drives every NVIDIA card: the
# open one then, and the older card stays without a driver, as before the 580 one was in the
# image). Why, it says on stderr, with what it saw.
#
# HADES_SYSFS, HADES_ROOT and HADES_KVER stand for /sys, / and `uname -r` in a test.

SYSFS="${HADES_SYSFS:-/sys}"
ROOT="${HADES_ROOT:-}"
KVER="${HADES_KVER:-$(uname -r)}"
OVERLAY="${ROOT}/usr/lib/kernel-overlays/nvidia-legacy"
IDS="${OVERLAY}/pci-ids"

legacy=0
other=0
seen=""

for dev in "${SYSFS}"/bus/pci/devices/*; do
  [ -r "${dev}/vendor" ] && [ -r "${dev}/class" ] && [ -r "${dev}/device" ] || continue
  read -r vendor < "${dev}/vendor" || continue
  read -r class < "${dev}/class" || continue
  read -r device < "${dev}/device" || continue

  [ "${vendor}" = "0x10de" ] || continue
  case "${class}" in
    0x03????) ;;
    *) continue ;;
  esac

  id="$(echo "${device#0x}" | tr 'A-F' 'a-f')"
  case "${id}" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) id="?" ;;
  esac

  if [ "${id}" != "?" ] && [ -r "${IDS}" ] && grep -qx "${id}" "${IDS}"; then
    legacy=$((legacy + 1))
    seen="${seen} ${dev##*/}=10de:${id}(580)"
  else
    other=$((other + 1))
    seen="${seen} ${dev##*/}=10de:${id}(615)"
  fi
done

choice="open"
if [ "${legacy}" -gt 0 ] && [ "${other}" -eq 0 ]; then
  if [ -d "${OVERLAY}/lib/modules/${KVER}" ] && [ -r "${ROOT}/usr/lib/nvidia/stacks/legacy" ]; then
    choice="legacy"
    why="every NVIDIA card is Maxwell, Pascal or Volta: the 580 driver"
  else
    why="a Maxwell, Pascal or Volta card, but the 580 driver is not in the image: the 615 one"
  fi
elif [ "${legacy}" -gt 0 ]; then
  why="cards for both drivers in one PC: the 615 driver (the Maxwell, Pascal or Volta one has none)"
elif [ "${other}" -gt 0 ]; then
  why="the 615 driver"
else
  why="no NVIDIA display device: the 615 driver's files, as without the 580 one"
fi

echo "NVIDIA driver:${seen:- none} -> ${choice}: ${why}" >&2
echo "${choice}"
