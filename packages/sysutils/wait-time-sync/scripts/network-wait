#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present LibreELEC Hades

# Hades: the wait of the setting "Wait for network before starting Kodi" (kodi-waitonnetwork.service). LibreELEC makes
# it a wait for the time from the internet (wait-time-sync): Kodi then starts with the network up and the clock right,
# which the add-ons that start with it need (an address on the internet, and TLS, whose certificates are checked
# against the clock). Kodi waits for that unit (kodi.service is after network-online.target), so the whole wait is in
# the start, before the menus: 8 to 15 s on a PC, 1 to 7 s of it after the network is up, for the time alone.
#
# Where the clock of the computer is known to be right before that time comes, it adds nothing but that wait: then the
# wait ends as soon as connman has the network (connmand-wait-online, connman's own: a service in the state "ready",
# with an address and a route, or "online"), or when the time comes, whichever is first. The longest wait is the
# setting's either way. With the clock not known to be right, the wait is LibreELEC's, unchanged. The time still comes
# from the internet a moment later, and corrects the clock by the little it is off.
#
# The clock is known to be right where clock-measure found it, as a start read it, within 30 s of the time from the
# internet, and wrote so in /storage/.cache/clock-trusted (its first four lines: "trusted"; when, in seconds since 1970
# UTC; how the clock was read then, LOCAL or UTC as /etc/adjtime said; the offset of the time zone then, as date +%z
# gives it). It is used only where all of this holds:
# - it is a regular file of the storage (no link followed), and its lines are what clock-measure writes;
# - the clock now is not before that time (a clock reset by a flat battery or by the firmware is), nor more than
#   MAX_AGE after it (a clock that drifts by the 20 ppm of a common crystal moves by less than a minute in a month);
# - the clock is read the same way now (/etc/adjtime: the setting "Hardware clock", and what was measured);
# - read as local time, the time zone has the same offset now: a change of summer time, or of the time zone, while no
#   system set the clock would leave it an hour or more off.
# What was done goes to the journal (identifier hades-network-wait).
#
# usage: network-wait <seconds>     the longest wait (WAIT_NETWORK_TIME of the setting)
#        network-wait check         only say whether the clock is known to be right, and why (the diagnostics)
# Exit status: that of wait-time-sync (0 the time came; 1 the time is up, which the unit takes as a success; 2 a wrong
# use), or 0 where the network came first.

CACHE=/storage/.cache
TRUSTED=$CACHE/clock-trusted
ADJTIME=/etc/adjtime
WAIT_TIME_SYNC=/usr/bin/wait-time-sync
WAIT_ONLINE=/usr/sbin/connmand-wait-online
MAX_AGE=2678400
TAG=hades-network-wait

say() {
  logger -t $TAG -- "$*" 2>/dev/null || echo "$TAG: $*" >&2
}

# the seconds since the kernel started, to the hundredth
uptime_now() {
  cut -d' ' -f1 /proc/uptime
}

# the time between two readings of uptime_now, in seconds with one decimal
elapsed() {
  awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", b - a }'
}

# whether the clock of the computer is known to be right; WHY says why not, or what was found
clock_trusted() {
  local l1 l2 l3 l4 now mode
  if [ -L $CACHE ] || [ -L $TRUSTED ] || [ ! -f $TRUSTED ]; then
    WHY="the clock of the computer has not been found right in an earlier start ($TRUSTED)"
    return 1
  fi
  l1=$(sed -n 1p $TRUSTED 2>/dev/null)
  l2=$(sed -n 2p $TRUSTED 2>/dev/null)
  l3=$(sed -n 3p $TRUSTED 2>/dev/null)
  l4=$(sed -n 4p $TRUSTED 2>/dev/null)
  case "$l1:$l2:$l3:$l4" in
    trusted:[0-9]*:LOCAL:[+-][0-9][0-9][0-9][0-9] | trusted:[0-9]*:UTC:[+-][0-9][0-9][0-9][0-9]) ;;
    *)
      WHY="$TRUSTED is not what clock-measure writes"
      return 1
      ;;
  esac
  case "$l2" in
    *[!0-9]*)
      WHY="$TRUSTED is not what clock-measure writes"
      return 1
      ;;
  esac
  now=$(date +%s)
  if [ "$now" -lt "$l2" ]; then
    WHY="the clock of the computer says $(date -u -d @$now '+%F %T') UTC, before it was last found right ($(date -u -d @$l2 '+%F %T') UTC): it may have been reset"
    return 1
  fi
  if [ $((now - l2)) -gt $MAX_AGE ]; then
    WHY="the clock of the computer was last found right more than $((MAX_AGE / 86400)) days ago ($(date -u -d @$l2 '+%F') UTC)"
    return 1
  fi
  mode=$(sed -n 3p $ADJTIME 2>/dev/null)
  if [ "$mode" != "$l3" ]; then
    WHY="the clock of the computer is read as ${mode:-nothing} now ($ADJTIME), and was found right read as $l3"
    return 1
  fi
  if [ "$mode" = LOCAL ] && [ "$(date +%z)" != "$l4" ]; then
    WHY="the clock of the computer is read as local time, and the time zone is UTC$(date +%z) now, UTC$l4 when it was found right (a change of summer time, or of the time zone)"
    return 1
  fi
  WHY="the clock of the computer was found right $(((now - l2) / 86400)) day(s) ago, read as $l3 ($(sed -n 5p $TRUSTED 2>/dev/null))"
  return 0
}

case "${1:-}" in
  check)
    if clock_trusted; then echo "trusted: $WHY"; else echo "not trusted: $WHY"; fi
    exit 0
    ;;
  '' | *[!0-9]*)
    echo "usage: network-wait <seconds> | check" >&2
    exit 2
    ;;
esac

T=$1
if ! clock_trusted; then
  say "Kodi waits for the time from the internet, $T s at most, as in LibreELEC: $WHY"
  exec $WAIT_TIME_SYNC --timeout "$T"
fi

start=$(uptime_now)
$WAIT_TIME_SYNC --timeout "$T" &
wts=$!
$WAIT_ONLINE --timeout="$T" >/dev/null 2>&1 &
wol=$!
# whichever ends first (both end within the longest wait)
while kill -0 $wts 2>/dev/null && kill -0 $wol 2>/dev/null; do
  sleep 0.1
done
if ! kill -0 $wol 2>/dev/null; then
  wait $wol
  rc=$?
  if [ $rc = 0 ]; then
    kill $wts 2>/dev/null
    wait $wts 2>/dev/null
    say "Kodi starts as connman has the network, $(elapsed $start "$(uptime_now)") s after the wait began, before the time from the internet: $WHY"
    exit 0
  fi
  say "connmand-wait-online ended without the network (status $rc) after $(elapsed $start "$(uptime_now)") s: the wait for the time from the internet goes on"
fi
wait $wts
rc=$?
kill $wol 2>/dev/null
wait $wol 2>/dev/null
if [ $rc = 0 ]; then
  say "Kodi starts as the time came from the internet, $(elapsed $start "$(uptime_now)") s after the wait began, before connman said it had the network ($WHY)"
else
  say "neither the network nor the time came within $T s (wait-time-sync status $rc): Kodi starts, as in LibreELEC"
fi
exit $rc
