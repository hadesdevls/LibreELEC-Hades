From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:46:28 +0000
Subject: [PATCH] Makefile: take the build date from SOURCE_DATE_EPOCH

PKGBUILD, the date that keyctl, request-key and key.dns_resolver print with
their version, is the day of the build (date -u +%F), so two builds of the
same source made on different days differ. When SOURCE_DATE_EPOCH is set
(https://reproducible-builds.org/specs/source-date-epoch/), take the date
from it instead. Without it, nothing changes.
---
 Makefile | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Makefile b/Makefile
index 84a2bf5..f670517 100644
--- a/Makefile
+++ b/Makefile
@@ -109,7 +109,11 @@ all: keyctl request-key key.dns_resolver cxx
 ###############################################################################
 #RPATH = -Wl,-rpath,$(LIBDIR)
 
+ifdef SOURCE_DATE_EPOCH
+VCPPFLAGS	:= -DPKGBUILD="\"$(shell date -u -d @$(SOURCE_DATE_EPOCH) +%F)\""
+else
 VCPPFLAGS	:= -DPKGBUILD="\"$(shell date -u +%F)\""
+endif
 VCPPFLAGS	+= -DPKGVERSION="\"keyutils-$(VERSION)\""
 VCPPFLAGS	+= -DAPIVERSION="\"libkeyutils-$(APIVERSION)\""
 
