[Unit]
Description=Setup Timezone data
DefaultDependencies=no
Before=systemd-udevd.service
After=var.mount systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Environment=TIMEZONE=UTC
EnvironmentFile=-/storage/.cache/timezone
ExecStart=/bin/ln -sf /usr/share/zoneinfo/${TIMEZONE} /var/run/localtime
# /etc/localtime: kept in /storage for the next boot's early start (see tz package.mk), written only
# when the zone changes
ExecStart=-/bin/sh -c '[ "$$(readlink /storage/.cache/localtime)" = "/usr/share/zoneinfo/$$TIMEZONE" ] || ln -sfnT "/usr/share/zoneinfo/$$TIMEZONE" /storage/.cache/localtime'
RemainAfterExit=yes
StartLimitInterval=0

[Install]
WantedBy=sysinit.target
