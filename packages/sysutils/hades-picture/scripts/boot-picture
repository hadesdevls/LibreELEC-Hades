#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# The picture of the start again, once the graphics driver has its own frame buffer (hades-boot-picture.service).
#
# The init draws the picture of the start on the frame buffer that there is (ply-image): on a PC with NVIDIA graphics,
# the firmware's (efifb). nvidia-drm loads seconds later, takes that frame buffer away and has one of its own, which
# nothing has drawn on: the screen went black from then until Kodi, some fifteen seconds. Here, as soon as fb0 is the
# frame buffer of a graphics driver (DRM: amdgpu, i915, nvidia-drm, virtio-gpu...), the picture is drawn again by
# hades-picture: into that frame buffer where every display shows it at its full size (one display), or on each
# display at its own size where they differ. Where the driver had its frame buffer before the init (most AMD and Intel
# graphics), the init drew the picture with hades-picture already, each display its own where they differ, and this
# draws the same pixels again in the same place, taking over the pictures that the init left held (hades-picture,
# init_saved()).
#
# Not where the console has taken the screen (it had text to show: an error, a check of a disk, or a BIOS start, whose
# console is not deferred), nor once Kodi was started (hades-picture release). The journal says what was done.

KODI=/run/hades-picture.kodi
SPLASH=/usr/share/splash/splash

say() {
  echo "hades-boot-picture: $*"
}

# the console of the kernel is on the screen (fbcon took over: /sys/class/vtconsole has it only then)
console_shown() {
  for v in /sys/class/vtconsole/vtcon*; do
    grep -qs 'frame buffer' "${v}/name" && [ "$(cat "${v}/bind" 2>/dev/null)" = "1" ] && return 0
  done
  return 1
}

# wait for the frame buffer of a graphics driver, at most 30 s
waited=0
while :; do
  if [ -e ${KODI} ]; then
    say "Kodi was started first: nothing drawn"
    exit 0
  fi
  case "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" in
    *drmfb) break ;;
  esac
  if [ ${waited} -ge 300 ]; then
    say "fb0 is not the frame buffer of a graphics driver after 30 s ($(cat /sys/class/graphics/fb0/name 2>/dev/null || echo none)): nothing drawn"
    exit 0
  fi
  usleep 100000
  waited=$((waited + 1))
done
fb="$(cat /sys/class/graphics/fb0/name 2>/dev/null)"

if console_shown; then
  say "the console has the screen (it had text to show): left as it is"
  exit 0
fi

# the picture of the user (oemsplash on the boot partition), stretched as the init does, or the one of the build
mode=fit
picture=${SPLASH}
for s in /flash/oemsplash-*.png /flash/oemsplash.png; do
  if [ -f "${s}" ]; then
    mode=stretch
    picture=/flash/oemsplash
    break
  fi
done

connected=0
for status in /sys/class/drm/card*-*/status; do
  [ "$(cat "${status}" 2>/dev/null)" = "connected" ] && connected=$((connected + 1))
done

said="$(hades-picture show ${mode} boot ${picture})"
r=$?
if [ ${r} = 3 ]; then
  # no display is on yet (the driver lights them when its frame buffer is first shown): one display shows the
  # frame buffer at its full size; several are lit black first, and each then gets its own picture
  if [ ${connected} -ge 2 ]; then
    hades-picture fb black >/dev/null
    said="$(hades-picture show ${mode} boot ${picture})"
    r=$?
  else
    said="$(hades-picture fb ${mode} ${picture})"
    r=$?
  fi
fi
if [ ${r} != 0 ] && [ ! -e ${KODI} ] && [ -n "${said##no Kodi was started*}" ]; then
  # (as the init draws it: one picture in the frame buffer, at its size)
  said="${said}; then $(hades-picture fb ${mode} ${picture})"
fi
say "fb0 (${fb}) after $((waited / 10)) s, ${connected} connected display(s): ${said}"
exit 0
