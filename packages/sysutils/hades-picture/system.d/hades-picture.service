#
# Holds the pictures of the start on displays of different sizes until Kodi shows its own (src/hades-picture.c). It
# reads pictures and draws them on the displays that are on, in the modes they have; it changes no mode and writes
# nothing else. Stopped (at a shutdown, or for a rescue or emergency shell), it gives the displays back to the console.

[Unit]
Description=Pictures of the start on the displays
DefaultDependencies=no
Requires=hades-picture.socket
After=hades-picture.socket
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/hades-picture serve
# (the DRM master of a display needs CAP_SYS_ADMIN; nothing else is asked for)
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
