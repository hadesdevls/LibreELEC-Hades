#
# The picture of the start again, once the graphics driver has its own frame buffer (boot-picture says why). Only in a
# start of Kodi (kodi.target): not in the installer, the text mode, a factory reset, a resize or a restore, which show
# their text. Kodi does not wait for it: Kodi's start lets go of the displays, and a picture of the start asked for
# after that is not drawn.

[Unit]
Description=The picture of the start on every display, once the graphics driver has its frame buffer
DefaultDependencies=no
Wants=hades-picture.socket
After=hades-picture.socket
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/hades-picture/boot-picture
TimeoutStartSec=60

[Install]
WantedBy=kodi.target
