#
# Where the start asks hades-picture.service to show a picture on the displays, or to let go of them (hades-picture
# show, release, stop). Only root may connect. The service starts when it is asked for and ends when it holds nothing.

[Unit]
Description=Pictures of the start on the displays (socket)

[Socket]
ListenStream=/run/hades-picture.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
