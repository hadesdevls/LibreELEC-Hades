#
# What may wake the PC from sleep, by the setting "Wake from sleep" of the LibreELEC settings (System > Sleep; by
# default the receivers of remote controls). Each time a HID interface of a USB device gets its driver (bind: after
# usbhid has armed a boot keyboard by itself) or is seen at the start (add), and each time an IR receiver of rc-core
# appears, /usr/lib/hades-wake/wake.sh looks at the whole device and sets its power/wakeup as the setting says. Mice and
# game controllers are never armed; a device that is no input device is not touched.

ACTION=="add|bind", SUBSYSTEM=="hid", RUN+="/usr/lib/hades-wake/wake.sh device %p"
ACTION=="add", SUBSYSTEM=="rc", RUN+="/usr/lib/hades-wake/wake.sh device %p"

# A Bluetooth adapter appeared: the Bluetooth devices paired before this version of Hades are noted, once, so that a
# mouse or a game controller among them that could wake the PC still may (wake.sh, bt_keep_before()).
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", RUN+="/usr/lib/hades-wake/wake.sh adapter %p"
