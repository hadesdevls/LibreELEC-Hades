# After each sleep, what may wake the PC is set again as the setting "Wake from sleep" says: a USB device that came back
# as a new one, without the events of udev that set it at a start (a device that lost its power while the PC slept is
# found again), is set like the others. Nothing is said unless something changed.
case "$1" in
  post) /usr/lib/hades-wake/wake.sh apply quiet ;;
esac
exit 0
