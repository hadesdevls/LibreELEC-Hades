# Before each sleep, the Bluetooth input devices and their adapters as the setting "Wake from sleep" says (BlueZ's
# WakeAllowed of each paired input device, which BlueZ turns on by itself for one paired since; the adapter armed while
# a device of the list may wake the PC): the kernel reads them as the sleep starts (hci_suspend_sync).
# After each sleep, what may wake the PC is set again as the setting says: a USB device that came back as a new one,
# without the events of udev that set it at a start (a device that lost its power while the PC slept is found again),
# is set like the others. Nothing is said unless something changed.
case "$1" in
  pre) /usr/lib/hades-wake/wake.sh bluetooth quiet ;;
  post) /usr/lib/hades-wake/wake.sh usb quiet ;;
esac
exit 0
