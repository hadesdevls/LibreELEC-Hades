[Unit]
Description=Hades: the check of the output for Dolby Vision, asked for in the settings
# (only when the settings asked for it: otherwise the unit is not started, and Kodi does not wait)
ConditionPathExists=/storage/.cache/hades-output-check/request
Before=kodi.service
After=graphical.target hades-diag.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/hades-diag/output-check.sh
# (the check stops itself after 90 s; Kodi starts after it in any case)
TimeoutStartSec=120
# (it neither sends nor receives anything over IP; it takes the display and writes a report)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=kodi.service
