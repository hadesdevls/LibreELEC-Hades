[Unit]
Description=Hades diagnostics, saved to the boot partition while it has a file named DIAG-ON...
ConditionPathExistsGlob=/flash/[Dd][Ii][Aa][Gg]-[Oo][Nn]*
Before=kodi-autostart.service kodi.service
After=network-online.target graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/lib/hades-diag/start.sh
# (it is short, and Kodi waits for it)
TimeoutStartSec=30
# (stopped after Kodi has stopped: the logs of the session)
ExecStop=-/bin/sh /usr/lib/hades-diag/shutdown.sh
TimeoutStopSec=60
# (what it saves stays on this computer: it neither sends nor receives anything over IP, not even
# on 127.0.0.1; it reads the system and writes to the boot partition, which needs root and devices)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=kodi.service
