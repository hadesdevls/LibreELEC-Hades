[Unit]
Description=Hades: the log of the share Logfiles, through the filter of the diagnostics
# (started when the share is opened, by Samba's "root preexec" of it: report.sh open. One at a time: a start that comes
# while it runs is that run)
RequiresMountsFor=/storage

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/hades-diag/report.sh share
# (beside whatever plays: the lowest priority of the processor and of the disks)
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=900
# (what it makes stays on this computer: it neither sends nor receives anything over IP)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
