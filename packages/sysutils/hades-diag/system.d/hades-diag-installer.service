[Unit]
Description=Hades diagnostics of a start of the installer, kept on the boot partition while it has a file named DIAG-ON...
# (the boot entry "Installer" only, and from as early as the journal is there: a start that hangs in a driver is
# what this is for. Nothing else waits for it.)
ConditionKernelCommandLine=installer
ConditionPathExistsGlob=/flash/[Dd][Ii][Aa][Gg]-[Oo][Nn]*
DefaultDependencies=no
Wants=systemd-journald.service
After=systemd-journald.service
RequiresMountsFor=/flash
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/bin/sh /usr/lib/hades-diag/installer.sh
# (stopped: the script looks once more and ends; what it runs is left to finish until then)
KillMode=mixed
TimeoutStopSec=15
# (what it keeps stays on this computer: it neither sends nor receives anything over IP; it reads the journal and
# writes to the boot partition, which needs root)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=installer.target
