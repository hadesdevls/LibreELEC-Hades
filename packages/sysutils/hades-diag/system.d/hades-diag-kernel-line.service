[Unit]
Description=Hades: the kernel line of the boot menus follows the switch of the diagnostics (initcall_debug)
# (at every start, the switch on or off: one turned by hand, in Windows for example, gets its kernel line from the start
# after this one. The boot menus are written only where they do not say what the switch says, by internal-disks, under
# the lock of the writers of the boot partition: after hades-menu-once, which writes them without that lock, and before
# the diagnostics, whose start.sh clears that lock. Not in a start of the installer.)
ConditionKernelCommandLine=!installer
RequiresMountsFor=/flash
After=hades-menu-once.service
Before=hades-diag.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/hades-diag/kernel-line.sh
# (the exit status says what kernel-line.sh did; the start of the system does not depend on it. What it says goes to the
# kernel log, and its standard error, the same words, would put them in the journal twice)
SuccessExitStatus=1 10 11 14 20 21 22
StandardError=null
TimeoutStartSec=60
# (it neither sends nor receives anything over IP; it reads and writes the boot menus, which needs root)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
