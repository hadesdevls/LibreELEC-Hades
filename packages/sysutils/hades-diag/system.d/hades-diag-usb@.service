[Unit]
Description=Hades diagnostics copied to %I, where it has a folder named hades-diag at its top
# (started once the drive is mounted, by udevil-mount@.service.d/hades-diag-usb.conf; for a drive without that
# folder nothing is done)
After=udevil-mount@%i.service

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/hades-diag/to-usb.sh auto %I
# (nothing to copy is no failure: the drive gets a note that says so)
SuccessExitStatus=10
TimeoutStartSec=600
# (what it copies stays on this computer and on that drive: it neither sends nor receives anything over IP)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
