[Unit]
Description=Hades diagnostics: the kernel log copied to the storage until the journal of the start is there
# (not enabled: the init of the initramfs has systemd start it, through a drop-in of sysinit.target in /run, only while
# the switch of the diagnostics is on and it copied the kernel log before; /usr/lib/hades-diag/early-log.sh)
DefaultDependencies=no
ConditionPathExists=/run/hades-diag-early
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/bin/sh /usr/lib/hades-diag/early-log.sh
# (it reads the kernel log and writes to the storage, nothing else)
IPAddressDeny=any
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
