From 92fd26de4c3ab73e4bbc9f41dd9dcc6300876c50 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 01:38:36 +0000
Subject: [PATCH] udevil: do not use messages with device data as format
 strings

wlog(msg, NULL, ...) is called with messages already formatted with
g_strdup_printf(), which contain device data such as mount points derived
from the filesystem label, and printed them with printf-style functions
using the message as the format. The same happened with the log buffer,
the output of umount and the error of valid_mount_path(). A label with
conversion specifications (%n, %s) plugged into a machine then reaches a
format string in udevil, which runs as root to mount it.

Print those messages as plain strings; wlog() keeps formatting when a
substitution argument is given, which only happens with literal formats.
---
 src/udevil.c | 26 +++++++++++++++++++-------
 1 file changed, 19 insertions(+), 7 deletions(-)

diff --git a/src/udevil.c b/src/udevil.c
index 3e79de9..3799eb2 100644
--- a/src/udevil.c
+++ b/src/udevil.c
@@ -924,16 +924,28 @@ _parse_error:
 
 static void wlog( const char* msg, const char* sub1, int volume )
 {
+    // without sub1, msg is a complete message that may contain device data (labels, mount
+    // points): never use it as a format string
     if ( abs( volume ) >= verbose )
     {
         if ( volume >= 0 )
-            fprintf( stderr, msg, sub1 );
+        {
+            if ( sub1 )
+                fprintf( stderr, msg, sub1 );
+            else
+                fputs( msg, stderr );
+        }
         else
-            printf( msg, sub1 );
+        {
+            if ( sub1 )
+                printf( msg, sub1 );
+            else
+                fputs( msg, stdout );
+        }
     }
     if ( logfile )
     {
-        char* msgt = g_strdup_printf( msg, sub1 );
+        char* msgt = sub1 ? g_strdup_printf( msg, sub1 ) : g_strdup( msg );
         if ( logmem )
         {
             char* str = logmem;
@@ -1148,7 +1160,7 @@ static void dump_log()
     }
     if ( file )
     {
-        if ( fprintf( file, logmem, NULL ) < 1 )
+        if ( fputs( logmem, file ) == EOF )
             fail = TRUE;
         if ( fclose( file ) != 0 )
             fail = TRUE;
@@ -2103,9 +2115,9 @@ static int try_umount( const char* device_file, gboolean force, gboolean lazy )
     // success - show output
     wlog( _("udevil: success running umount as current user\n"), NULL, 1 );
     if ( sstderr )
-        fprintf( stderr, sstderr, NULL );
+        fputs( sstderr, stderr );
     if ( sstdout )
-        fprintf( stdout, sstdout, NULL );
+        fputs( sstdout, stdout );
     g_free( sstdout );
     g_free( sstderr );
     return 0;
@@ -2405,7 +2417,7 @@ static int create_media_dir( const char* path, gboolean* created )
         {
             if ( !valid_mount_path( path, &str ) )
             {
-                printf( str, NULL );
+                fputs( str, stdout );
                 g_free( str );
                 ret = 2;
             }
-- 
