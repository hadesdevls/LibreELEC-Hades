From 7823ccd0eec49d81cd0834e66918d1a32f5cd449 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 01:38:36 +0000
Subject: [PATCH] udevil: never mount on "." or ".." or on names with control
 characters

The mount point name comes from the filesystem label, truncated to 20
characters and stripped of surrounding spaces. A label "." or ".." (or ".."
followed by spaces) gives the mount point <media dir>/.., which exists, is
a directory and is not a mount point, so it passes valid_mount_path() and
the device is mounted over the parent of the media directory (/var on
LibreELEC). Labels with control characters (newlines) end up in mount
point names that other tools and generated configuration files must
handle.

Fall back to the device name (as for an empty label) in those cases.
---
 src/udevil.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/udevil.c b/src/udevil.c
index 0176375..3e79de9 100644
--- a/src/udevil.c
+++ b/src/udevil.c
@@ -2865,6 +2865,18 @@ _net_free:
     return ret;
 }
 
+static gboolean has_control_chars( const char* str )
+{
+    const unsigned char* c;
+
+    for ( c = (const unsigned char*)str; *c; c++ )
+    {
+        if ( *c < 0x20 || *c == 0x7f )
+            return TRUE;
+    }
+    return FALSE;
+}
+
 static int command_mount( CommandData* data )
 {
     int type;
@@ -4280,7 +4292,10 @@ _get_type:
         if ( mname )
         {
             g_strstrip( mname );
-            if ( mname[0] == '\0' )
+            // never use "." or ".." (the media directory itself or its parent) as the mount
+            // point name, nor a name with control characters
+            if ( mname[0] == '\0' || !strcmp( mname, "." ) || !strcmp( mname, ".." )
+                                  || has_control_chars( mname ) )
             {
                 g_free( mname );
                 mname = NULL;
-- 
