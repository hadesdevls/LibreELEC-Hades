# dont run in "installer" mode
IMPORT{cmdline}="installer"
ENV{installer}=="1", GOTO="exit"

# check for blockdevices, /dev/sd*, /dev/sr*, /dev/mmc*, and /dev/nvme*
SUBSYSTEM!="block", KERNEL!="sd*|sr*|mmc*|nvme*", GOTO="exit"

# check for special partitions we dont want mount
IMPORT{builtin}="blkid"
ENV{ID_FS_LABEL}=="EFI|BOOT|Recovery|RECOVERY|SETTINGS|boot|root0|share0", GOTO="exit"

# /dev/sd*, /dev/mmc*, and /dev/nvme* with partitions/disk and filesystems only, and /dev/sr* disks only
KERNEL=="sd*|mmc*|nvme*", ENV{DEVTYPE}=="partition|disk", ENV{ID_FS_USAGE}=="filesystem", GOTO="harddisk"
KERNEL=="sr*", ENV{DEVTYPE}=="disk", GOTO="optical"
GOTO="exit"

# mount or umount for hdds
LABEL="harddisk"
# Hades: a disk that goes has both services stopped (the one that is not running, at no cost), without asking
# what kind of disk it was: by then the place it hung from may be gone as well (a dock taken away together
# with its USB controller), and a disk on USB would be taken for an internal one.
ACTION=="remove", RUN+="/usr/bin/systemctl stop udevil-mount@/dev/%k.service", RUN+="/usr/bin/systemctl stop udevil-mount-ro@/dev/%k.service", GOTO="exit"
# Hades: internal disks (NVMe, SATA/SCSI that are neither on USB nor removable, eMMC) are
# mounted read-only
KERNEL=="nvme*", ENV{HADES_INTERNAL}="1"
# A disk is told to be on USB by where it hangs, not by ID_BUS: udev runs ata_id on a disk in a USB
# enclosure, and for one that answers (most SATA enclosures do) ID_BUS is "ata", as for an internal disk.
KERNEL=="sd*", ENV{HADES_INTERNAL}="1"
KERNEL=="sd*", SUBSYSTEMS=="usb", ENV{HADES_INTERNAL}=""
KERNEL=="sd*", ATTRS{removable}=="1", ENV{HADES_INTERNAL}=""
KERNEL=="mmcblk*", ATTRS{type}=="MMC", ENV{HADES_INTERNAL}="1"
ENV{HADES_INTERNAL}=="1", GOTO="internal"
ACTION=="add", PROGRAM="/usr/bin/sh -c '/usr/bin/grep -E ^/dev/%k\  /proc/mounts || true'", RESULT=="", RUN+="/usr/bin/systemctl restart udevil-mount@/dev/%k.service"
GOTO="exit"

# mount (read-only) or umount for internal hdds
LABEL="internal"
# Hades: a start whose entry hides the internal disks (an installation on an internal disk, and Run and Live
# from a USB drive), or one in which the list of the disks that the settings keep away cannot be read or could
# not be done in full (the init leaves this mark: see hide_other_disks, hide_from_usb and hide_chosen_disks
# there). What is left here (the partitions next to the system on its own disk, the disks of a kind that the
# init cannot take away, one that it could not let go of) is not mounted on its own. The entry "internal" of the
# menu mounts them, read-only.
TEST=="/dev/.hades_other_disks_hidden", GOTO="exit"
# Hades: the partitions that the user keeps hidden while the internal disks are shown (LibreELEC settings >
# System > Internal disks) are not mounted. /usr/lib/libreelec/internal-partitions answers "mount" only for a
# partition that is to be shown; any other answer, and a program that fails, leaves it unmounted. It is asked
# here and nowhere else: never for a disk on USB or a removable one, nor where the mark above has been left.
ACTION=="add", PROGRAM="/usr/lib/libreelec/internal-partitions decide", RESULT=="mount", GOTO="internal_shown"
GOTO="exit"
LABEL="internal_shown"
ACTION=="add", PROGRAM="/usr/bin/sh -c '/usr/bin/grep -E ^/dev/%k\  /proc/mounts || true'", RESULT=="", RUN+="/usr/bin/systemctl restart udevil-mount-ro@/dev/%k.service"
GOTO="exit"

# mount or umount for opticals
LABEL="optical"
ACTION=="add|change", RUN+="/usr/bin/systemctl restart udevil-mount@/dev/%k.service"
GOTO="exit"

# Exit
LABEL="exit"

