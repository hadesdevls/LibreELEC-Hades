# util-linux's fstrim.timer. Its stamp is kept in /storage/.cache/systemd/timers (LibreELEC's systemd), so
# a week that the computer was off is made up for at the next start. "systemctl mask fstrim.timer" turns it
# off (in /storage/.config/system.d), and "systemctl unmask fstrim.timer" on again.

[Unit]
Description=Discard unused blocks on the storage partition once a week
Documentation=man:fstrim
ConditionVirtualization=!container
ConditionPathExists=!/etc/initrd-release

[Timer]
OnCalendar=weekly
AccuracySec=1h
Persistent=true
RandomizedDelaySec=100min

[Install]
WantedBy=timers.target
