# util-linux's fstrim.service, for the storage partition alone: the other partitions that this system
# mounts are the user's (and the internal disks are mounted read-only, which a trim would not respect).

[Unit]
Description=Discard unused blocks on the storage partition
Documentation=man:fstrim(8)
ConditionVirtualization=!container
RequiresMountsFor=/storage

[Service]
Type=oneshot
# (--quiet-unsupported: a drive or a file system without discard, as many USB ones, is no error)
ExecStart=/usr/sbin/fstrim --verbose --quiet-unsupported /storage
# (out of the way of anything that is playing)
IOSchedulingClass=idle
Nice=19
PrivateDevices=no
PrivateNetwork=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@default @file-system @basic-io @system-service
