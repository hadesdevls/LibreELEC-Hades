# Hades: what the clock of the computer keeps is measured once the time has been taken from the internet in this
# start, which connman or systemd-timesyncd says with a file in /run (see /usr/lib/libreelec/clock-measure)
[Unit]
Description=Measure what the clock of the computer keeps, once the time comes from the internet
ConditionKernelCommandLine=!installer

[Path]
PathExists=/run/connman/ntp-synchronized
PathExists=/run/systemd/timesync/synchronized

[Install]
WantedBy=multi-user.target
