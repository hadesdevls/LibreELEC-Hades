# Hades: what the clock of the computer keeps, measured with the time from the internet, for the setting Hardware
# clock on Automatic (/usr/lib/libreelec/clock-measure); started by hades-clock-measure.path. It stays active once it
# has run (RemainAfterExit): the file that started it is still there, and the path unit would start it again.
[Unit]
Description=Measure what the clock of the computer keeps
ConditionKernelCommandLine=!installer
RequiresMountsFor=/storage
After=tz-data.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/lib/libreelec/clock-measure
SyslogIdentifier=hades-clock
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
