#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: the setting "show the internal disks (read-only)".
#
# The boot menus of the system have an entry that hides the disks inside the computer and locks the kernel
# down, and one that shows them, mounted read-only, with the kernel as LibreELEC has it (scripts/mkimage):
#
#                        syslinux.cfg (BIOS)    EFI/BOOT/grub.cfg (UEFI)
#   hides the disks      run                    Run
#   shows the disks      internal               Run (internal disks read-only)
#
# The setting is which of the two the menus start by themselves, and nothing else: no other file keeps it.
# The init leaves the entry that shows the disks as the default while the system is started by it, and gives
# the menus the one that hides them at any other start that names a default (hades_bootmenu_default in the
# init): choosing "run" once in the menu turns the setting off.
#
# Usage: internal-disks status   print the setting: "on", "off" or "mixed" (one menu shows and the other
#                                hides), or "unavailable" and why. After "off", the word "live" says that it
#                                cannot be turned on in this start. After "unavailable" and its reason, the
#                                word "shows" says that a menu names the entry that shows the disks as its
#                                default all the same, in a line read as loosely as a boot loader may read it.
#        internal-disks on       the menus start the entry that shows the internal disks
#        internal-disks off      the menus start the entry that hides them
#        internal-disks wait     print how long the boot menus wait before they start their default entry by
#                                themselves, in seconds: a number, "mixed" (the two menus wait differently),
#                                "other" (not a whole number of seconds, or not one line that says it), or
#                                "unavailable" and why
#        internal-disks wait N   the menus wait N seconds, 1 to 30 (the setting "Boot menu" of the settings)
#        internal-disks option NAME          print whether the menus start the system with the kernel option NAME on:
#                                "on", "off", "mixed" (on in some of the entries and not in others), "other" (a
#                                line that has the word twice, or with a value that is not 0 or 1), or
#                                "unavailable" and why. NAME: i915.hdmi_hdr_gmp or amdgpu.dvbridge_dce
#        internal-disks option NAME on|off   the menus start the system with NAME=1, or NAME=0 (the settings of
#                                Kodi's display that the kernel offers for these, videoscreen.hadeshdrgmp and
#                                videoscreen.hadesdvdce)
#
# Exit status:
#    0  status, wait, option: what was asked was told. on, off, wait N, option NAME on|off: the menus are as asked,
#       looked at again after the change
#    1  wrong usage
#   10  there is no boot menu on the boot partition
#   11  a boot menu is not one that this system makes
#   12  the entry "run" of the menus does not hide the internal disks: there is nothing to turn on or off
#   13  on: started in live mode, which has no entry that shows the internal disks
#   14  the boot partition is not mounted read-only, or something else is writing to it
#   20  the change could not be made, and the menus are as they were
#   21  the change could not be made, and the menus are not as they were, or one of them could not be put
#       back for certain ("status" tells how the kernel has them)
#   22  the boot partition could not be made read-only again
# With 10 to 14 nothing was written.
#
# A menu is changed only when it is one that this system makes: every line of it of a known kind, both
# entries there, one that hides and one that does not, for the same system; a menu that is not known is never
# written to, whatever it starts. The new menu is made and checked in RAM and copied next to the old one. The
# copy is written through to the device (fsync, whose result is looked at) and read from the device again (a
# direct read, not what the kernel keeps of the file in memory) before it takes the place of the menu by a
# rename, so the menu is never open for writing. Then the menu and its folder are written through, and the
# menu is read from the device once more. Turning the setting on is undone when it cannot be done in both
# menus.
#
# The boot partition is writable only for the change, and is made read-only again when this ends, also when a
# signal ends it (HUP, INT, QUIT, TERM, USR1, USR2, ALRM; a reader of its output that goes away does not end
# it). KILL cannot be caught: after it the partition may stay writable, with the lock and a folder of this in
# /run, until the system is started again, and until then a change is refused (exit status 14).
#
# The lock is the one of the diagnostics (packages/sysutils/hades-diag). Their two writers that run while Kodi
# runs take it (collect.sh, watch-dv.sh), so a change made from the settings never meets them. The other two do
# not: start.sh, before Kodi is started, removes any lock and writes without one, and shutdown.sh, after Kodi
# has stopped, writes when it has waited 10 s. A run of this by hand at one of those two moments can meet
# them: the one whose partition the other makes read-only fails to write (here: exit status 20 or 21, with no
# menu cut short).

# Run from Kodi, this has its environment, in which add-ons put folders of their own into PATH and
# LD_LIBRARY_PATH (kodi's profile.d), and mount is not a part of busybox: it is linked to libmount. Only what
# the system has is run, in the C locale, without the variables that the loader and the C library take from
# the environment (the list that glibc clears for privileged programs) and the ones that libmount and
# libblkid read.
PATH=/usr/bin:/usr/sbin
export PATH
LC_ALL=C
export LC_ALL
unset GCONV_PATH GETCONF_DIR GLIBC_TUNABLES HOSTALIASES LD_AUDIT LD_BIND_NOT LD_BIND_NOW LD_DEBUG \
  LD_DEBUG_OUTPUT LD_DYNAMIC_WEAK LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PRELOAD LD_PROFILE LD_PROFILE_OUTPUT \
  LD_SHOW_AUXV LD_VERBOSE LD_WARN LOCALDOMAIN LOCPATH MALLOC_ARENA_MAX MALLOC_ARENA_TEST MALLOC_MMAP_MAX_ \
  MALLOC_MMAP_THRESHOLD_ MALLOC_PERTURB_ MALLOC_TOP_PAD_ MALLOC_TRACE MALLOC_TRIM_THRESHOLD_ NIS_PATH NLSPATH \
  RESOLV_HOST_CONF RES_OPTIONS TMPDIR TZDIR \
  LIBMOUNT_DEBUG LIBMOUNT_FORCE_MOUNT2 LIBMOUNT_FSTAB LIBMOUNT_KERNEL_CMDLINE LIBMOUNT_MTAB LIBMOUNT_SWAPS \
  LIBMOUNT_UTAB LIBBLKID_DEBUG BLKID_CONF BLKID_FILE LOCK_BLOCK_DEVICE
# (a reader of what this says that goes away must not end it while the boot partition is writable)
trap '' PIPE

FLASH=/flash
SYSLINUX=$FLASH/syslinux.cfg
GRUB=$FLASH/EFI/BOOT/grub.cfg
# Other places of a boot menu: extlinux.conf, which syslinux reads in place of syslinux.cfg where it finds
# both, and the two files that the init removes when it changes a menu. With one of them there, the two
# above are not known to be the menus in use.
OTHER_MENUS="$FLASH/extlinux.conf $FLASH/EFI/BOOT/syslinux.cfg $FLASH/grub.cfg"
MOUNTS=/proc/mounts
CMDLINE=/proc/cmdline
# (the lock of packages/sysutils/hades-diag: see above for who takes it)
LOCK=/run/hades-flash.lock
WORK=/run/internal-disks.$$

HIDES_SYSLINUX="run"
SHOWS_SYSLINUX="internal"
HIDES_GRUB="Run"
SHOWS_GRUB="Run (internal disks read-only)"
# A default line that names the entry that shows the disks, read as loosely as a boot loader may read it: the
# keyword in any case, blanks around it, the line ends of Windows and, in syslinux.cfg, more words after the
# entry (syslinux starts the entry and hands them to it). (The same two patterns as in the init.)
LOOSELY_SYSLINUX="^[[:space:]]*[Dd][Ee][Ff][Aa][Uu][Ll][Tt][[:space:]]\{1,\}$SHOWS_SYSLINUX\([[:space:]].*\)\{0,1\}\$"
LOOSELY_GRUB="^[[:space:]]*\(set[[:space:]]\{1,\}\)\{0,1\}default=[\"']\{0,1\}$SHOWS_GRUB[\"']\{0,1\}[[:space:]]*\$"

# What a menu is, in one word: "on" (it starts the entry that shows the disks), "off" (it starts another
# one), "nothide" (its entry "run" does not hide them), or "unknown" and why.
# kind: syslinux or grub. hide, show: the names of the two entries. mode: the word that both must have.
# What hides the disks is the same that the init knows (HADES_ENTRY_HIDES there).
MENU='
function bad(why) { if (verdict == "") verdict = "unknown: " why }
function look(e,    n, i, w) {
  n = split(args[e], w, /[ \t]+/)
  for (i = 1; i <= n; i++) {
    if (w[i] == "") continue
    if (w[i] == mode) has_mode[e]++
    else if (w[i] == "initcall_blacklist=nvme_init,ahci_pci_driver_init" || w[i] == "hades.otherdisks=hide") hides[e]++
    else if (w[i] ~ /^initcall_blacklist=/ || w[i] ~ /^hades\.otherdisks=/) odd[e]++
    else if (w[i] == "live" || w[i] == "grub_live" || w[i] == "installer" || w[i] == "portable" || w[i] == "grub_portable") other_mode[e]++
    else if (w[i] ~ /^boot=/) { nboot[e]++; boot[e] = w[i] }
    else if (w[i] ~ /^disk=/) { ndisk[e]++; disk[e] = w[i] }
  }
}
/\r/ { bad("a carriage return on line " NR) }
kind == "syslinux" {
  # (the line that the menu of an entry shows under the list: any words, but none that a boot loader or
  # the init would read as a line of the menu)
  if (help) {
    if ($0 == "  ENDTEXT") { help = 0; next }
    if ($0 ~ /^[ \t]*([Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Ll][Aa][Bb][Ee][Ll]|[Kk][Ee][Rr][Nn][Ee][Ll]|[Aa][Pp][Pp][Ee][Nn][Dd]|[Ii][Nn][Cc][Ll][Uu][Dd][Ee])([ \t]|$)/) bad("line " NR " of a help text reads as a line of the menu")
    next
  }
  if ($0 ~ /^[ \t]*$/ || $0 ~ /^#/ || $0 ~ /^SAY( |$)/ || $0 ~ /^TIMEOUT [0-9]+$/ || $0 ~ /^PROMPT [0-9]+$/) next
  # (the look of the menu, and the name and the help text of an entry: scripts/mkimage)
  if (cur == "" && $0 == "INCLUDE /hades/menu.cfg") next
  if (cur != "" && $0 ~ /^  MENU LABEL [^\t]+$/) next
  if (cur != "" && $0 == "  TEXT HELP") { help = 1; next }
  if ($0 ~ /^DEFAULT [A-Za-z0-9_-]+$/) { ndef++; def = substr($0, 9); next }
  if ($0 ~ /^LABEL [A-Za-z0-9_-]+$/) { cur = substr($0, 7); nent[cur]++; next }
  if (cur != "" && $0 ~ /^[ \t]+KERNEL [^ \t]+$/) { nker[cur]++; kernel[cur] = $2; next }
  if (cur != "" && $0 ~ /^[ \t]+APPEND [^ \t]/) { nargs[cur]++; a = $0; sub(/^[ \t]+APPEND /, "", a); args[cur] = a; next }
  bad("line " NR " is of no known kind")
  next
}
kind == "grub" {
  if ($0 ~ /^[ \t]*$/ || $0 ~ /^#/ || $0 ~ /^set timeout="[0-9]+"$/) next
  # (the look of the menu, read where it is there: scripts/mkimage writes this line as it is)
  if (cur == "" && $0 == "if [ -f \"${prefix}/hades/theme.cfg\" ]; then source \"${prefix}/hades/theme.cfg\"; fi") next
  if ($0 ~ /^set default="[^"]+"$/) { ndef++; def = substr($0, 14, length($0) - 14); next }
  # (an entry, with the class that names its picture or, in a menu written before, without one)
  if (cur == "" && $0 ~ /^menuentry "[^"]+"( --class [a-z0-9-]+)? [{]$/) { cur = $0; sub(/^menuentry "/, "", cur); sub(/".*$/, "", cur); nent[cur]++; next }
  # (the kernel of the entry: the first /KERNEL on any disk in a menu written before, or, since 1.0 RC7, the
  # one of the system partition, by the identifier of its file system, which has to be the one of boot=)
  if (cur != "" && $0 ~ /^[ \t]+search --set -f [^ \t]+$/) next
  if (cur != "" && index($0, "\tsearch --no-floppy --fs-uuid --set=root --hint=\"${root}\" ") == 1) {
    u = substr($0, length("\tsearch --no-floppy --fs-uuid --set=root --hint=\"${root}\" ") + 1)
    if (u !~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]-[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) bad("line " NR " is of no known kind")
    nsearch[cur]++; suuid[cur] = toupper(u); next
  }
  if (cur != "" && $0 == "\tif [ ! -f /KERNEL ]; then search --set -f /KERNEL; fi") next
  # (the screen back to the mode of the firmware, before the kernel: scripts/mkimage)
  if (cur != "" && $0 == "\tterminal_output console") next
  if (cur != "" && $0 ~ /^[ \t]+linux [^ \t]+ [^ \t]/) { nargs[cur]++; nker[cur]++; kernel[cur] = $2; a = $0; sub(/^[ \t]+linux [^ \t]+ /, "", a); args[cur] = a; next }
  if (cur != "" && $0 == "}") { cur = ""; next }
  bad("line " NR " is of no known kind")
  next
}
END {
  if (NR == 0) bad("it is empty")
  if (kind == "grub" && cur != "") bad("an entry does not end")
  if (help) bad("a help text does not end")
  if (ndef != 1) bad("it does not name one default")
  for (e in nent) if (nent[e] != 1) bad("an entry is there more than once")
  if (nent[hide] != 1 || nent[show] != 1) bad("the two entries are not both there")
  if (nargs[hide] != 1 || nargs[show] != 1 || nker[hide] != 1 || nker[show] != 1) bad("an entry does not have one kernel and one command line")
  if (verdict == "" && nent[def] != 1) bad("its default is none of its entries")
  if (verdict == "") {
    look(hide)
    look(show)
    if (has_mode[hide] != 1 || has_mode[show] != 1 || other_mode[hide] || other_mode[show]) bad("the two entries do not start the system in the same mode")
    else if (odd[hide] || odd[show] || hides[show]) bad("what hides the disks is not where it is known")
    else if (nboot[hide] != 1 || nboot[show] != 1 || boot[hide] != boot[show] || ndisk[hide] != 1 || ndisk[show] != 1 || disk[hide] != disk[show] || kernel[hide] != kernel[show]) bad("the two entries are not for the same system")
    else if (nsearch[hide] > 1 || nsearch[show] > 1 || nsearch[hide] != nsearch[show] || (nsearch[hide] && (toupper(boot[hide]) != "BOOT=UUID=" suuid[hide] || toupper(boot[show]) != "BOOT=UUID=" suuid[show]))) bad("the kernel of an entry is not the one of its system")
    else if (!hides[hide]) verdict = "nothide"
    else if (def == show) verdict = "on"
    else verdict = "off"
  }
  print verdict
}
'

say() {
  echo "internal-disks: $1" >&2
}

# The state of the menu $2 ($1: syslinux or grub): absent, on, off, nothide or unknown
menu() {
  local hide show mode r
  if [ ! -e "$2" ] && [ ! -L "$2" ]; then
    echo absent
    return
  fi
  if [ ! -f "$2" ] || [ -L "$2" ] || [ ! -r "$2" ]; then
    say "$2 is not a file that can be read"
    echo unknown
    return
  fi
  # (a byte that is no text: what reads the menu line by line, here and in a boot loader, may end at it)
  if [ "$(tr -d '\000' < "$2" 2>/dev/null | wc -c)" != "$(wc -c < "$2" 2>/dev/null)" ]; then
    say "$2 is not a menu that is known (it has a NUL byte)"
    echo unknown
    return
  fi
  case "$1" in
    syslinux) hide=$HIDES_SYSLINUX; show=$SHOWS_SYSLINUX; mode=portable ;;
    grub) hide=$HIDES_GRUB; show=$SHOWS_GRUB; mode=grub_portable ;;
  esac
  r=$(awk -v kind="$1" -v hide="$hide" -v show="$show" -v mode="$mode" "$MENU" "$2" 2>/dev/null) || r="unknown: it could not be read"
  case "$r" in
    on|off|nothide)
      echo "$r"
      ;;
    *)
      say "$2 is not a menu that is known (${r#unknown: })"
      echo unknown
      ;;
  esac
}

# Whether a line of the menu $2 names the entry that shows the disks as the default, read loosely
loosely_shows() {
  case "$1" in
    syslinux) grep -q "$LOOSELY_SYSLINUX" "$2" 2>/dev/null ;;
    grub) grep -q "$LOOSELY_GRUB" "$2" 2>/dev/null ;;
  esac
}

# The state of each of the two menus, and whether one of them, known or not, starts the entry that shows
S=""
G=""
SHOWN=no
read_menus() {
  local m
  S=$(menu syslinux "$SYSLINUX")
  G=$(menu grub "$GRUB")
  for m in $OTHER_MENUS; do
    if [ -e "$m" ] || [ -L "$m" ]; then
      say "$m: a boot menu in a place that this system does not use"
      S=unknown
    fi
  done
  SHOWN=no
  if loosely_shows syslinux "$SYSLINUX" || loosely_shows grub "$GRUB"; then
    SHOWN=yes
  fi
}

# The setting, from the state of the two menus: on, off or mixed, or why it cannot be told
setting() {
  case "$S/$G" in
    absent/absent) echo no-menu ;;
    *unknown*) echo unknown-menu ;;
    *nothide*) echo not-hidden ;;
    on/on|on/absent|absent/on) echo on ;;
    off/off|off/absent|absent/off) echo off ;;
    *) echo mixed ;;
  esac
}

# Ends with the exit status of a setting that cannot be told ($1), saying why
unavailable() {
  local shows=""
  [ "$SHOWN" = yes ] && shows=" shows"
  case "$1" in
    no-menu)
      say "there is no boot menu on $FLASH"
      echo "unavailable no-menu"
      exit 10
      ;;
    unknown-menu)
      echo "unavailable unknown-menu$shows"
      exit 11
      ;;
    not-hidden)
      say "the entry of the menus that should hide the internal disks does not hide them"
      echo "unavailable not-hidden$shows"
      exit 12
      ;;
  esac
}

live() {
  grep -q -E '(^|[[:space:]])(live|grub_live)([[:space:]]|$)' "$CMDLINE" 2>/dev/null
}

# How the boot partition is mounted: ro, rw or not-mounted
flash_is() {
  awk -v m="$FLASH" '$2 == m { o = "," $4 "," } END { if (o == "") print "not-mounted"; else if (o ~ /,ro,/) print "ro"; else print "rw" }' "$MOUNTS" 2>/dev/null
}

# RW: yes from just before this asks for the boot partition to be made writable, until it is read-only
#   again; failed when it could not be made so
# LOCKED: this has the lock
# CHANGED: a menu may have been written to
# HOLD, PENDING: a signal that comes while something is done whose outcome must be known first (HOLD) is
#   only noted (PENDING), and acted on when the outcome is known
RW=no
LOCKED=no
CHANGED=no
HOLD=no
PENDING=no

read_only() {
  local n=0
  [ "$RW" = yes ] || return 0
  # (a copy that was being made when this was stopped)
  rm -f "${SYSLINUX%.cfg}.new" "${GRUB%.cfg}.new" 2>/dev/null
  # (what else may be waiting to be written there; its outcome is not told, and nothing here relies on it)
  sync -f "$FLASH" 2>/dev/null
  while ! mount -o remount,ro "$FLASH" 2>/dev/null; do
    n=$((n + 1))
    if [ $n -ge 5 ]; then
      RW=failed
      say "$FLASH could not be made read-only again"
      return 1
    fi
    sleep 1
  done
  RW=no
}

# When this ends, by itself or by a signal that can be caught: the boot partition read-only again, nothing
# left in RAM, and the lock given back
leave() {
  trap '' HUP INT QUIT TERM USR1 USR2 ALRM
  read_only
  rm -rf "$WORK"
  if [ "$LOCKED" = yes ]; then
    rmdir "$LOCK" 2>/dev/null
    LOCKED=no
  fi
  [ "$RW" = no ]
}

# Stopped by a signal: before a menu could have been written to, nothing was changed; after that, the menus
# are for "status" to tell
stopped() {
  if [ "$HOLD" = yes ]; then
    PENDING=yes
    return
  fi
  say "stopped"
  [ "$CHANGED" = no ] && exit 20
  exit 21
}

lock() {
  local n=0
  while :; do
    # (a signal that comes while the lock is being made waits until it is known whether it was made: only
    # who has the lock gives it back)
    HOLD=yes
    mkdir "$LOCK" 2>/dev/null && LOCKED=yes
    HOLD=no
    [ "$PENDING" = no ] || stopped
    [ "$LOCKED" = yes ] && return 0
    n=$((n + 1))
    [ $n -le 20 ] || return 1
    sleep 1
  done
}

# Whether two files have the same content
same() {
  local a b
  a=$(sha256sum 2>/dev/null < "$1") || return 1
  b=$(sha256sum 2>/dev/null < "$2") || return 1
  [ -n "$a" ] && [ "$a" = "$b" ]
}

# Whether the file $2 of the boot partition holds, on the device, what the file $1 holds: it is read with
# O_DIRECT, which the kernel answers from the device and not from the pages of the file that it has in memory
# (those are the ones that were just written). What leads to the file, its folder and the allocation table,
# is still the kernel's own copy. Where a file cannot be opened so, the ordinary read is used and that is
# said; dd by itself goes on with an ordinary read when a direct one is refused once the file is open.
on_device() {
  if dd if="$2" of="$WORK/read" iflag=direct bs=4096 2>/dev/null; then
    same "$1" "$WORK/read"
  else
    say "$2 could not be read from the device directly: it is compared as the kernel has it in memory"
    same "$1" "$2"
  fi
}

file_of() {
  case "$1" in
    syslinux) echo "$SYSLINUX" ;;
    grub) echo "$GRUB" ;;
  esac
}

# The entry that the menu $1 starts by itself when the setting is $2
entry_of() {
  case "$1/$2" in
    syslinux/on) echo "$SHOWS_SYSLINUX" ;;
    syslinux/off) echo "$HIDES_SYSLINUX" ;;
    grub/on) echo "$SHOWS_GRUB" ;;
    grub/off) echo "$HIDES_GRUB" ;;
  esac
}

# The lines of the menu $2 that a change of its default leaves alone ($1: syslinux or grub)
rest() {
  case "$1" in
    syslinux) grep -v -e '^DEFAULT ' -e '^SAY Wait for ' "$2" ;;
    grub) grep -v -e '^set default=' "$2" ;;
  esac
}

# In RAM: a copy of the menu $1 as it is ($WORK/$1.old) and the menu with the setting $2 ($WORK/$1.new), made
# as the init changes a default. The new one must be a menu that is known, with the setting as asked, and
# differ from the old one in nothing but its default.
make() {
  local old="$WORK/$1.old" new="$WORK/$1.new" entry
  entry=$(entry_of "$1" "$2")
  cp "$(file_of "$1")" "$old" 2>/dev/null && same "$(file_of "$1")" "$old" || return 1
  case "$1" in
    syslinux) sed -e "s/^SAY Wait for .* mode/SAY Wait for $entry mode/" -e "s/^DEFAULT .*/DEFAULT $entry/" "$old" > "$new" 2>/dev/null ;;
    grub) sed -e "s/^set default=.*/set default=\"$entry\"/" "$old" > "$new" 2>/dev/null ;;
  esac || return 1
  [ "$(menu "$1" "$new" 2>/dev/null)" = "$2" ] || return 1
  rest "$1" "$old" > "$old.rest" 2>/dev/null && rest "$1" "$new" > "$new.rest" 2>/dev/null &&
    same "$old.rest" "$new.rest" && [ "$(wc -l < "$old")" = "$(wc -l < "$new")" ]
}

# The file $1, which is in RAM, takes the place of the menu $2. A copy next to the menu: written through to
# the device (sync FILE is fsync, which on this file system ends with a flush of the device, and whose
# failure is told; sync -f is not used for it, because its outcome is not) and read from the device. Then the
# rename, the menu and its folder written through (the folder is where the rename is), and the menu read from
# the device. A copy that could not be made whole is removed, and the menu is as it was.
put() {
  local t="${2%.cfg}.new"
  rm -f "$t" 2>/dev/null
  if cp "$1" "$t" 2>/dev/null && sync "$t" 2>/dev/null && on_device "$1" "$t" &&
     mv -f "$t" "$2" 2>/dev/null && sync "$2" "${2%/*}" 2>/dev/null && on_device "$1" "$2"; then
    return 0
  fi
  rm -f "$t" 2>/dev/null
  return 1
}

do_status() {
  local s
  read_menus
  s=$(setting)
  unavailable "$s"
  if [ "$s" = off ] && live; then
    echo "off live"
  else
    echo "$s"
  fi
  exit 0
}

# $1: on or off
change() {
  local want=$1 s m todo="" changed="" failed=no unchanged=yes certain=yes

  read_menus
  s=$(setting)
  unavailable "$s"
  if [ "$s" = "$want" ]; then
    echo "$want"
    exit 0
  fi
  if [ "$want" = on ] && live; then
    say "started in live mode, which has no entry that shows the internal disks"
    exit 13
  fi

  trap 'leave || exit 22' EXIT
  trap 'stopped' HUP INT QUIT TERM USR1 USR2 ALRM
  if ! lock; then
    say "something else is writing to $FLASH"
    exit 14
  fi
  if [ "$(flash_is)" != ro ]; then
    say "$FLASH is not mounted read-only"
    exit 14
  fi
  # (with the lock: what was looked at may have been changed meanwhile)
  read_menus
  s=$(setting)
  unavailable "$s"
  if [ "$s" = "$want" ]; then
    echo "$want"
    exit 0
  fi

  if ! mkdir -m 700 "$WORK" 2>/dev/null; then
    say "$WORK could not be made"
    exit 20
  fi
  for m in syslinux grub; do
    case "$m" in
      syslinux) s=$S ;;
      grub) s=$G ;;
    esac
    [ "$s" = absent ] || [ "$s" = "$want" ] && continue
    if ! make "$m" "$want"; then
      say "the new $(file_of "$m") could not be made"
      exit 20
    fi
    todo="$todo $m"
  done

  # (told before it is asked for: a signal that comes while the partition is being made writable finds it
  # to be made read-only again)
  RW=yes
  if ! mount -o remount,rw "$FLASH" 2>/dev/null; then
    RW=no
    say "$FLASH could not be made writable"
    exit 20
  fi
  CHANGED=yes
  for m in $todo; do
    if put "$WORK/$m.new" "$(file_of "$m")"; then
      changed="$changed $m"
    else
      say "$(file_of "$m") could not be changed"
      failed=yes
      # (whatever is in its place now: a menu that is not the one that was there gets that one back)
      same "$WORK/$m.old" "$(file_of "$m")" || put "$WORK/$m.old" "$(file_of "$m")" ||
        { say "$(file_of "$m") could not be put back as it was"; certain=no; }
      # (turning it on is for both menus or for none; turning it off goes as far as it can)
      [ "$want" = on ] && break
    fi
  done
  if [ "$failed" = yes ] && [ "$want" = on ]; then
    for m in $changed; do
      put "$WORK/$m.old" "$(file_of "$m")" || { say "$(file_of "$m") could not be put back as it was"; certain=no; }
    done
  fi
  read_only

  read_menus
  s=$(setting)
  # (a menu that could not be put back as it was: the kernel may have it so and the device not, so neither
  # "done" nor "as they were" is told, whatever the menus read as now)
  if [ "$certain" = no ]; then
    say "the setting could not be turned $want, and it is not certain that the menus are as they were"
    exit 21
  fi
  if [ "$s" = "$want" ]; then
    echo "$want"
    exit 0
  fi
  for m in $todo; do
    same "$WORK/$m.old" "$(file_of "$m")" || unchanged=no
  done
  if [ "$unchanged" = yes ]; then
    say "the setting could not be turned $want: the menus are as they were"
    exit 20
  fi
  say "the setting could not be turned $want, and the menus are not as they were"
  exit 21
}

# The setting "Boot menu" (1.0 RC8): how long the boot menus wait before they start their default entry by
# themselves, 5 seconds as scripts/mkimage writes them since 1.0 (10 before). GRUB says it in seconds
# (set timeout="N"), syslinux in tenths of a second (TIMEOUT N). 0 is never written: in syslinux it is "wait for
# ever". It is written as scripts/mkimage writes it, in a form whose length does not depend on the value, so that
# the installer for Windows can carry it across an update: TIMEOUT with three digits, the seconds of GRUB with two
# (grub_strtoul() reads a leading 0 as octal only before the digits 0 to 7, so 01 to 09 are 1 to 9), and the line
# of the BIOS text menu that says it ("SAY Wait for run mode to start automatically in 5 seconds..."), which
# before 1.0 always said 10, with the number of seconds, padded with spaces to the length that it has with two
# digits. The forms of before are read as well. A wait written here is a choice, and a menu of Hades (first line
# "# hades-features:") says so with the word "boot-choices" at the end of its first line, as scripts/mkimage writes
# it since 1.0: an update keeps the wait of such menus whatever it is, 10 s as well, and brings menus without it
# that wait 10 s, the default before 1.0, to 5 s (usr/share/bootloader/update.sh, wait_update, and the installer for
# Windows). A menu is changed in those lines and that word only, with all that a change of the default has: a menu
# that this system makes, the lock, the copy written through and read back, and both menus or none. The exit
# statuses are those of on and off.
WAIT_FEATURE=boot-choices

# The tenths of a second that the menu $2 waits ($1: syslinux or grub), from its one line that says it; false
# where there is not exactly one such line
wait_of() {
  local n=""
  case "$1" in
    syslinux)
      [ "$(grep -c '^TIMEOUT [0-9][0-9]*' "$2" 2>/dev/null)" = 1 ] || return 1
      n=$(sed -n 's/^TIMEOUT 0*\([0-9][0-9]*\).*/\1/p' "$2" 2>/dev/null)
      ;;
    grub)
      [ "$(grep -c '^set timeout="[0-9][0-9]*"' "$2" 2>/dev/null)" = 1 ] || return 1
      n=$(sed -n 's/^set timeout="0*\([0-9][0-9]*\)".*/\1/p' "$2" 2>/dev/null)
      [ -n "$n" ] && n=$((n * 10))
      ;;
  esac
  [ -n "$n" ] && echo "$n"
}

# The lines of the menu $2 that a change of its wait leaves alone ($1: syslinux or grub): all but the lines of the
# wait and, in a menu of Hades, the first, which may get the word
rest_wait() {
  { if features "$2"; then sed 1d "$2"; else cat "$2"; fi; } |
    case "$1" in
      syslinux) grep -v -e '^TIMEOUT [0-9]' -e '^SAY Wait for .* mode to start automatically in ' ;;
      grub) grep -v -e '^set timeout="[0-9]' ;;
    esac
}

# Whether the first line of the menu $1 is the one of a menu of Hades, and whether it says that its wait is a choice
features() { head -n 1 "$1" 2>/dev/null | grep -q '^# hades-features:'; }
marked() { head -n 1 "$1" 2>/dev/null | grep -q -E "^# hades-features:(.* )?$WAIT_FEATURE( |\$)"; }
# The first line that the menu $1 has once a wait is written in it
first_line() {
  if features "$1" && ! marked "$1"; then
    echo "$(head -n 1 "$1") $WAIT_FEATURE"
  else
    head -n 1 "$1"
  fi
}

# The three forms of a wait of $1 seconds (1 to 30) that scripts/mkimage writes: TIMEOUT in tenths with three
# digits, GRUB with two, and the end of the line that says it, padded to the length of its form with two digits
wait_tenths() { printf '%03d' $(($1 * 10)); }
wait_seconds() { printf '%02d' "$1"; }
wait_words() {
  if [ "$1" -eq 1 ]; then
    printf '%-13s' "1 second..."
  else
    printf '%-13s' "$1 seconds..."
  fi
}

# How many lines of the menu $1 say the wait in the text menu, and how many say $2 seconds as written above
SAY_WAIT='
index($0, "SAY Wait for ") == 1 && index($0, " mode to start automatically in ") {
  n++
  e = " mode to start automatically in " w
  if (length($0) >= length(e) && substr($0, length($0) - length(e) + 1) == e) m++
}
END { print n + 0 "/" m + 0 }
'
said_waits() { awk -v w="$(wait_words "$2")" "$SAY_WAIT" "$1" 2>/dev/null; }

# Whether the menu $2 ($1: syslinux or grub) says a wait of $3 seconds in the forms above, and nowhere otherwise, and
# says that it is a choice (a menu of Hades)
wait_written() {
  local f=$2 n
  if features "$f" && ! marked "$f"; then
    return 1
  fi
  case "$1" in
    syslinux)
      [ "$(grep -c '^TIMEOUT [0-9][0-9]*$' "$f" 2>/dev/null)" = 1 ] && grep -q -x "TIMEOUT $(wait_tenths "$3")" "$f" || return 1
      n=$(said_waits "$f" "$3")
      [ "${n%/*}" = "${n#*/}" ] ;;
    grub)
      [ "$(grep -c '^set timeout="[0-9][0-9]*"$' "$f" 2>/dev/null)" = 1 ] && grep -q -x "set timeout=\"$(wait_seconds "$3")\"" "$f" ;;
  esac
}

# The tenths that the menus there wait, the same in both: a number, "mixed" or "other" (after read_menus)
waits() {
  local m t all=""
  for m in syslinux grub; do
    case "$m" in
      syslinux) [ "$S" = absent ] && continue ;;
      grub) [ "$G" = absent ] && continue ;;
    esac
    t=$(wait_of "$m" "$(file_of "$m")") || { echo other; return; }
    if [ -z "$all" ]; then
      all=$t
    elif [ "$all" != "$t" ]; then
      echo mixed
      return
    fi
  done
  echo "$all"
}

# Ends, saying why, where the wait cannot be told or changed: no menu, or one that this system does not make
wait_known() {
  if [ "$S/$G" = absent/absent ]; then
    say "there is no boot menu on $FLASH"
    echo "unavailable no-menu"
    exit 10
  fi
  if [ "$S" = unknown ] || [ "$G" = unknown ]; then
    echo "unavailable unknown-menu"
    exit 11
  fi
}

wait_status() {
  local t
  read_menus
  wait_known
  t=$(waits)
  case "$t" in
    mixed|other) echo "$t" ;;
    *[!0-9]*|'') echo other ;;
    *) if [ $((t % 10)) -eq 0 ]; then echo $((t / 10)); else echo other; fi ;;
  esac
  exit 0
}

# In RAM: the menu $1 as it is ($WORK/$1.old) and the same menu waiting $2 seconds ($WORK/$1.new), in the forms
# above, with the word in its first line. The new one must be known as the old one is (the same state), wait so,
# say so in every line of the text menu that says it, and differ from the old one in those lines and that word only.
make_wait() {
  local old="$WORK/$1.old" new="$WORK/$1.new" n first
  cp "$(file_of "$1")" "$old" 2>/dev/null && same "$(file_of "$1")" "$old" || return 1
  case "$1" in
    syslinux) sed -e "s/^TIMEOUT [0-9][0-9]*\$/TIMEOUT $(wait_tenths "$2")/" \
                  -e "s/^\(SAY Wait for .* mode to start automatically in \).*\$/\1$(wait_words "$2")/" "$old" > "$new.w" 2>/dev/null ;;
    grub) sed -e "s/^set timeout=\"[0-9][0-9]*\"\$/set timeout=\"$(wait_seconds "$2")\"/" "$old" > "$new.w" 2>/dev/null ;;
  esac || return 1
  # (the word: on the first line of a menu of Hades that does not have it; the menus have no carriage return)
  first=$(first_line "$old")
  if [ "$first" != "$(head -n 1 "$old")" ]; then
    sed -e "1s/\$/ $WAIT_FEATURE/" "$new.w" > "$new" 2>/dev/null || return 1
  else
    cp "$new.w" "$new" 2>/dev/null || return 1
  fi
  if features "$old"; then
    [ "$(head -n 1 "$new")" = "$first" ] && marked "$new" || return 1
  fi
  [ "$(menu "$1" "$new" 2>/dev/null)" = "$(menu "$1" "$old" 2>/dev/null)" ] || return 1
  [ "$(wait_of "$1" "$new")" = "$(($2 * 10))" ] && wait_written "$1" "$new" "$2" || return 1
  if [ "$1" = syslinux ]; then
    # (the lines that say it are the ones that were there)
    n=$(said_waits "$old" "$2")
    [ "$(said_waits "$new" "$2")" = "${n%/*}/${n%/*}" ] || return 1
  fi
  rest_wait "$1" "$old" > "$old.rest" 2>/dev/null && rest_wait "$1" "$new" > "$new.rest" 2>/dev/null &&
    same "$old.rest" "$new.rest" && [ "$(wc -l < "$old")" = "$(wc -l < "$new")" ]
}

# Whether every menu there waits $1 seconds, written as scripts/mkimage writes it (after read_menus): then a change
# to $1 has nothing to do. A menu of before 1.0, or one whose text menu says another number, is written anew.
waits_written() {
  local m
  for m in syslinux grub; do
    case "$m" in
      syslinux) [ "$S" = absent ] && continue ;;
      grub) [ "$G" = absent ] && continue ;;
    esac
    wait_written "$m" "$(file_of "$m")" "$1" || return 1
  done
  return 0
}

# $1: seconds, 1 to 30
wait_change() {
  local want=$(($1 * 10)) m t todo="" changed="" failed=no certain=yes

  read_menus
  wait_known
  if [ "$(waits)" = "$want" ] && waits_written "$1"; then
    echo "$1"
    exit 0
  fi

  trap 'leave || exit 22' EXIT
  trap 'stopped' HUP INT QUIT TERM USR1 USR2 ALRM
  if ! lock; then
    say "something else is writing to $FLASH"
    exit 14
  fi
  if [ "$(flash_is)" != ro ]; then
    say "$FLASH is not mounted read-only"
    exit 14
  fi
  # (with the lock: what was looked at may have been changed meanwhile)
  read_menus
  wait_known
  if [ "$(waits)" = "$want" ] && waits_written "$1"; then
    echo "$1"
    exit 0
  fi

  if ! mkdir -m 700 "$WORK" 2>/dev/null; then
    say "$WORK could not be made"
    exit 20
  fi
  for m in syslinux grub; do
    case "$m" in
      syslinux) t=$S ;;
      grub) t=$G ;;
    esac
    [ "$t" = absent ] && continue
    wait_written "$m" "$(file_of "$m")" "$1" && continue
    if ! make_wait "$m" "$1"; then
      say "the new $(file_of "$m") could not be made"
      exit 20
    fi
    todo="$todo $m"
  done

  RW=yes
  if ! mount -o remount,rw "$FLASH" 2>/dev/null; then
    RW=no
    say "$FLASH could not be made writable"
    exit 20
  fi
  CHANGED=yes
  for m in $todo; do
    if put "$WORK/$m.new" "$(file_of "$m")"; then
      changed="$changed $m"
    else
      say "$(file_of "$m") could not be changed"
      failed=yes
      same "$WORK/$m.old" "$(file_of "$m")" || put "$WORK/$m.old" "$(file_of "$m")" ||
        { say "$(file_of "$m") could not be put back as it was"; certain=no; }
      break
    fi
  done
  # (both menus or none)
  if [ "$failed" = yes ]; then
    for m in $changed; do
      put "$WORK/$m.old" "$(file_of "$m")" || { say "$(file_of "$m") could not be put back as it was"; certain=no; }
    done
  fi
  read_only

  if [ "$certain" = no ]; then
    say "the boot menus could not be made to wait $1 seconds, and it is not certain that they are as they were"
    exit 21
  fi
  read_menus
  if [ "$failed" = no ] && [ "$S" != unknown ] && [ "$G" != unknown ] && [ "$(waits)" = "$want" ] && waits_written "$1"; then
    echo "$1"
    exit 0
  fi
  for m in $todo; do
    if ! same "$WORK/$m.old" "$(file_of "$m")"; then
      say "the boot menus could not be made to wait $1 seconds, and they are not as they were"
      exit 21
    fi
  done
  say "the boot menus could not be made to wait $1 seconds: they are as they were"
  exit 20
}

# The kernel options of the boot menus (scripts/mkimage, BOOT_OPTIONS): parameters of drivers that are built into
# the kernel, which only the kernel line reaches. Kodi offers each one in its display settings where the kernel
# says that it changes the output that Kodi uses (the connector property HADES_BOOT_OPTION), and asks this to
# change the menus. An option is the word NAME=1 (on) or NAME=0 (off, the parameter's own default) on the kernel
# line of each entry that starts the system for use: run, internal and live in syslinux.cfg; Run, "Run (internal
# disks read-only)" and Live in grub.cfg; whichever of them a menu has. scripts/mkimage writes NAME=0 there; a
# menu of before 1.0 has no word, which is off, and is given the word at the end of those lines when the option is
# turned on. A menu is changed in those lines only, and only in that word, with all that a change of the wait has.
OPTIONS="i915.hdmi_hdr_gmp amdgpu.dvbridge_dce"

# The value of the option o in the menu (kind: syslinux or grub): on, off, mixed or other (also a menu without an
# entry that starts the system for use, which a menu that this system makes always has). With set (0 or 1): the menu with the option so in each of those lines, the word put
# where it was, or at the end of the line when it is turned on and was not there. With strip: the menu without
# the word in those lines (what a change of the option must leave the same).
OPTION='
function entry(line,    e) {
  if (kind == "syslinux") {
    if (line ~ /^LABEL [A-Za-z0-9_-]+$/) { cur = substr(line, 7); return 1 }
  } else if (line ~ /^menuentry "[^"]+"/) {
    e = line; sub(/^menuentry "/, "", e); sub(/".*$/, "", e); cur = e; return 1
  }
  return 0
}
function concerned(line) {
  if (kind == "syslinux") return (cur == "run" || cur == "internal" || cur == "live") && line ~ /^[ \t]+APPEND /
  return (cur == "Run" || cur == "Run (internal disks read-only)" || cur == "Live") && line ~ /^[ \t]+linux /
}
# the line with the word of the option given the value v, or without it (v empty), and every other byte as it was
# (the blank before a word that is taken out goes with it)
function rewrite(line, v,    out, i, c, tok, sep, len) {
  out = ""; tok = ""; sep = ""; len = length(line)
  for (i = 1; i <= len + 1; i++) {
    c = i <= len ? substr(line, i, 1) : ""
    if (c == " " || c == "\t" || c == "") {
      if (tok != "") {
        if (index(tok, o "=") == 1) { if (v != "") out = out sep o "=" v }
        else out = out sep tok
        tok = ""; sep = ""
      }
      sep = sep c
    } else tok = tok c
  }
  return out sep
}
function emit(l) { if (set != "" || strip) print l }
{
  line = $0
  if (entry(line)) { emit(line); next }
  if (kind == "grub" && line == "}") cur = ""
  if (!concerned(line)) { emit(line); next }
  lines++
  n = split(line, w, " ")
  words = 0; one = 0; odd = 0
  for (i = 1; i <= n; i++) {
    if (index(w[i], o "=") != 1) continue
    words++
    if (w[i] == o "=1") one++
    else if (w[i] != o "=0") odd++
  }
  if (words > 1 || odd) other = 1
  if (one) on++
  if (set != "") {
    if (words == 1) line = rewrite(line, set)
    else if (words == 0 && set == "1") line = line " " o "=1"
  } else if (strip) line = rewrite(line, "")
  emit(line)
}
END {
  if (set != "" || strip) exit
  if (other) print "other"
  else if (lines == 0) print "other"
  else if (on == lines) print "on"
  else if (on == 0) print "off"
  else print "mixed"
}
'

known_option() {
  case " $OPTIONS " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# The value of the option $3 in the menu $2 ($1: syslinux or grub)
option_of() { awk -v kind="$1" -v o="$3" -v set="" -v strip=0 "$OPTION" "$2" 2>/dev/null; }

# The value of the option $1 in the menus there (after read_menus): on, off, mixed or other
options() {
  local m t all=""
  for m in syslinux grub; do
    case "$m" in
      syslinux) [ "$S" = absent ] && continue ;;
      grub) [ "$G" = absent ] && continue ;;
    esac
    t=$(option_of "$m" "$(file_of "$m")" "$1")
    case "$t" in
      on|off) ;;
      mixed) echo mixed; return ;;
      *) echo other; return ;;
    esac
    if [ -z "$all" ]; then
      all=$t
    elif [ "$all" != "$t" ]; then
      echo mixed
      return
    fi
  done
  echo "$all"
}

option_status() {
  read_menus
  wait_known
  options "$1"
  exit 0
}

# In RAM: the menu $1 as it is ($WORK/$1.old) and the same menu with the option $2 at $3 (0 or 1) ($WORK/$1.new). The
# new one must be known as the old one is, have the option so, and differ from the old one in that word only.
make_option() {
  local old="$WORK/$1.old" new="$WORK/$1.new" want=off
  [ "$3" = 1 ] && want=on
  cp "$(file_of "$1")" "$old" 2>/dev/null && same "$(file_of "$1")" "$old" || return 1
  awk -v kind="$1" -v o="$2" -v set="$3" -v strip=0 "$OPTION" "$old" > "$new" 2>/dev/null || return 1
  [ "$(menu "$1" "$new" 2>/dev/null)" = "$(menu "$1" "$old" 2>/dev/null)" ] || return 1
  [ "$(option_of "$1" "$new" "$2")" = "$want" ] || return 1
  awk -v kind="$1" -v o="$2" -v set="" -v strip=1 "$OPTION" "$old" > "$old.rest" 2>/dev/null &&
    awk -v kind="$1" -v o="$2" -v set="" -v strip=1 "$OPTION" "$new" > "$new.rest" 2>/dev/null &&
    same "$old.rest" "$new.rest" && [ "$(wc -l < "$old")" = "$(wc -l < "$new")" ]
}

# $1: the option; $2: on or off
option_change() {
  local name=$1 want=$2 value=0 m t todo="" changed="" failed=no certain=yes
  [ "$want" = on ] && value=1

  read_menus
  wait_known
  if [ "$(options "$name")" = "$want" ]; then
    echo "$want"
    exit 0
  fi

  trap 'leave || exit 22' EXIT
  trap 'stopped' HUP INT QUIT TERM USR1 USR2 ALRM
  if ! lock; then
    say "something else is writing to $FLASH"
    exit 14
  fi
  if [ "$(flash_is)" != ro ]; then
    say "$FLASH is not mounted read-only"
    exit 14
  fi
  # (with the lock: what was looked at may have been changed meanwhile)
  read_menus
  wait_known
  if [ "$(options "$name")" = "$want" ]; then
    echo "$want"
    exit 0
  fi

  if ! mkdir -m 700 "$WORK" 2>/dev/null; then
    say "$WORK could not be made"
    exit 20
  fi
  for m in syslinux grub; do
    case "$m" in
      syslinux) t=$S ;;
      grub) t=$G ;;
    esac
    [ "$t" = absent ] && continue
    t=$(option_of "$m" "$(file_of "$m")" "$name")
    [ "$t" = "$want" ] && continue
    if ! make_option "$m" "$name" "$value"; then
      say "the new $(file_of "$m") could not be made"
      exit 20
    fi
    todo="$todo $m"
  done

  RW=yes
  if ! mount -o remount,rw "$FLASH" 2>/dev/null; then
    RW=no
    say "$FLASH could not be made writable"
    exit 20
  fi
  CHANGED=yes
  for m in $todo; do
    if put "$WORK/$m.new" "$(file_of "$m")"; then
      changed="$changed $m"
    else
      say "$(file_of "$m") could not be changed"
      failed=yes
      same "$WORK/$m.old" "$(file_of "$m")" || put "$WORK/$m.old" "$(file_of "$m")" ||
        { say "$(file_of "$m") could not be put back as it was"; certain=no; }
      break
    fi
  done
  # (both menus or none)
  if [ "$failed" = yes ]; then
    for m in $changed; do
      put "$WORK/$m.old" "$(file_of "$m")" || { say "$(file_of "$m") could not be put back as it was"; certain=no; }
    done
  fi
  read_only

  if [ "$certain" = no ]; then
    say "$name could not be turned $want in the boot menus, and it is not certain that they are as they were"
    exit 21
  fi
  read_menus
  if [ "$failed" = no ] && [ "$S" != unknown ] && [ "$G" != unknown ] && [ "$(options "$name")" = "$want" ]; then
    echo "$want"
    exit 0
  fi
  for m in $todo; do
    if ! same "$WORK/$m.old" "$(file_of "$m")"; then
      say "$name could not be turned $want in the boot menus, and they are not as they were"
      exit 21
    fi
  done
  say "$name could not be turned $want in the boot menus: they are as they were"
  exit 20
}

if [ $# -eq 1 ]; then
  case "$1" in
    status) do_status ;;
    on|off) change "$1" ;;
    wait) wait_status ;;
  esac
elif [ $# -eq 2 ] && [ "$1" = wait ]; then
  case "$2" in
    [1-9]|[12][0-9]|30) wait_change "$2" ;;
  esac
elif [ $# -eq 2 ] && [ "$1" = option ] && known_option "$2"; then
  option_status "$2"
elif [ $# -eq 3 ] && [ "$1" = option ] && known_option "$2"; then
  case "$3" in
    on|off) option_change "$2" "$3" ;;
  esac
fi
echo "usage: internal-disks status|on|off|wait [1-30]|option i915.hdmi_hdr_gmp|amdgpu.dvbridge_dce [on|off]" >&2
exit 1
