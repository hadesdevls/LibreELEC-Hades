#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present LibreELEC Hades

# Hades: what the clock of the computer (the RTC) keeps, measured once the time has been taken from the internet, for
# the setting "Hardware clock" on Automatic, its default. LibreELEC Hades reads that clock and never writes it: on a PC
# that also runs Windows, Windows keeps it in local time (/etc/adjtime of the image says LOCAL). A computer whose clock
# keeps UTC (one without Windows) then starts with its time off by the time zone until the time comes from the
# internet; with the setting on Automatic, the init reads such a clock as UTC from the next start, still never writing
# it (hades_clock_mode in its init).
#
# The clock is read as if it kept UTC (/sys/class/rtc/rtc0/since_epoch) and compared with the time of the system once
# connman (/run/connman/ntp-synchronized) or systemd-timesyncd (/run/systemd/timesync/synchronized) has set that from
# the internet: both are in /run, made anew at each start, and neither is made by a time set by hand. A clock that
# keeps UTC is then within MARGIN of the time of the system; one that keeps local time, as Windows keeps it, is within
# MARGIN of it plus an offset of the time zone: the one of now, or one that the zone had in the year before (Windows
# sets the clock at a change of summer time only while it runs, so a clock set before such a change keeps the offset
# of then; the offsets are looked at a week apart). MARGIN, 15 minutes, is room for a clock that drifts and has not
# been set for months, and a quarter of the smallest offset of a time zone that is not at UTC (one hour). Where the
# time zone is at UTC for part of the year (London, Lisbon, Reykjavik, UTC itself) both fit, and where the clock is
# further off (its date or time set wrong in the firmware) neither does: then nothing is kept and nothing changes.
#
# The verdict is kept in /storage/.cache/clock-measured, its first line "UTC" or "local", only where it is not the one
# kept there already (written beside it, then renamed over it); the init reads it at the next start. It is kept also
# while the setting is set by hand, and used only once the setting is on Automatic. Nothing is written to the clock,
# here or because of this. What was measured goes to the journal (identifier hades-clock), and a verdict that is new
# also to /run/hades/clock-changed, which the diagnostics put in results.txt.
#
# Each start that measures also says whether the clock, as this start read it (/etc/adjtime: LOCAL or UTC), was right:
# within TRUST_MARGIN of the time from the internet. That is kept in /storage/.cache/clock-trusted (trust_keep()) for
# the wait of "Wait for network before starting Kodi" (network-wait, packages/sysutils/wait-time-sync), which then
# lets Kodi start once the network is there, without waiting for the time; it is taken away where the clock was not
# right. It is written again only where it changes, or once it is TRUST_REFRESH old.
#
# usage: clock-measure          measure, keep a verdict that is new, and say it
#        clock-measure show     only say what the measurement gives, keep nothing (the diagnostics): one line, the
#                               verdict (UTC, local, none, or unmeasured), a colon, and what was measured

RTC=/sys/class/rtc/rtc0/since_epoch
CACHE=/storage/.cache
MEASURED=$CACHE/clock-measured
CHOICE=$CACHE/adjtime
CHANGED=/run/hades/clock-changed
SYNCED_CONNMAN=/run/connman/ntp-synchronized
SYNCED_TIMESYNCD=/run/systemd/timesync/synchronized
MARGIN=900
WEEK=604800
TRUSTED=$CACHE/clock-trusted
TRUST_MARGIN=30
TRUST_REFRESH=604800

# seconds east of UTC of an offset as date +%z gives it (+hhmm or -hhmm); fails on anything else
seconds() {
  case "$1" in [+-][0-9][0-9][0-9][0-9]) ;; *) return 1 ;; esac
  local h=${1#?} m=${1#???}
  h=${h%??}
  # (1$h - 100 takes a leading 0 off, which the shell would read as octal)
  local s=$(( (1$h - 100) * 3600 + (1$m - 100) * 60 ))
  [ "${1%????}" = - ] && s=$((-s))
  echo $s
}

# a number of seconds, without its sign, in hours, minutes and seconds
span() {
  local a=${1#-}
  echo "$((a / 3600)) h $((a % 3600 / 60)) min $((a % 60)) s"
}

# measure: VERDICT is UTC, local or none (measured, no verdict), and TEXT says what was measured; fails where it
# could not be measured (TEXT says why)
measure() {
  local rtc now d z o a k offs="" zones="" fu=no fl=no
  VERDICT=none
  if [ ! -e $SYNCED_CONNMAN ] && [ ! -e $SYNCED_TIMESYNCD ]; then
    TEXT="not measured: the time has not been taken from the internet in this start"
    return 1
  fi
  rtc=$(cat $RTC 2>/dev/null)
  case "$rtc" in
    '' | *[!0-9]*) TEXT="not measured: the clock of the computer cannot be read ($RTC)"; return 1 ;;
  esac
  now=$(date +%s)
  d=$((rtc - now))
  k=0
  while [ $k -le 53 ]; do
    z=$(date -d @$((now - k * WEEK)) +%z 2>/dev/null)
    if ! o=$(seconds "$z"); then
      TEXT="not measured: the offset of the time zone cannot be read ($z)"
      return 1
    fi
    case " $offs " in
      *" $o "*) ;;
      *) offs="$offs $o"; zones="${zones:+$zones, }UTC$z" ;;
    esac
    k=$((k + 1))
  done
  [ ${d#-} -le $MARGIN ] && fu=yes
  for o in $offs; do
    a=$((d - o))
    [ ${a#-} -le $MARGIN ] && fl=yes
  done
  if [ $d -ge 0 ]; then
    TEXT="the clock of the computer is $(span $d) ahead of UTC"
  else
    TEXT="the clock of the computer is $(span $d) behind UTC"
  fi
  TEXT="$TEXT, with the time from the internet; the time zone is UTC$(date +%z) (in the year before: $zones)"
  if [ $fu = yes ] && [ $fl = no ]; then
    VERDICT=UTC
    TEXT="$TEXT: it keeps UTC"
  elif [ $fl = yes ] && [ $fu = no ]; then
    VERDICT=local
    TEXT="$TEXT: it keeps local time, as Windows keeps it"
  elif [ $fu = yes ]; then
    TEXT="$TEXT: local time and UTC are the same here for part of the year, so which one it keeps cannot be told"
  else
    TEXT="$TEXT: it keeps neither UTC nor local time, within $((MARGIN / 60)) minutes (its date or time is set wrong in the firmware, or it has drifted)"
  fi
  return 0
}

# whether the clock, as this start read it, was right; kept for network-wait as said above (TEXT_TRUST says what was
# done)
trust_keep() {
  local rtc now mode off o r l2 part
  rtc=$(cat $RTC 2>/dev/null)
  now=$(date +%s)
  mode=$(sed -n 3p /etc/adjtime 2>/dev/null)
  off=$(date +%z)
  case "$rtc" in
    '' | *[!0-9]*) TEXT_TRUST="the clock of the computer cannot be read"; return 0 ;;
  esac
  case "$mode" in
    LOCAL) o=$(seconds "$off") || { TEXT_TRUST="the offset of the time zone cannot be read ($off)"; return 0; } ;;
    UTC) o=0 ;;
    *) TEXT_TRUST="/etc/adjtime says neither LOCAL nor UTC"; return 0 ;;
  esac
  # (the clock as this start read it, against the time from the internet)
  r=$((rtc - o - now))
  if [ ${r#-} -gt $TRUST_MARGIN ]; then
    if [ -e $TRUSTED ] || [ -L $TRUSTED ]; then
      rm -f $TRUSTED && sync
      TEXT_TRUST="this start read it $r s off the time from the internet: Kodi waits for that time again at the next start ($TRUSTED taken away)"
    else
      TEXT_TRUST="this start read it $r s off the time from the internet: Kodi goes on waiting for that time at each start"
    fi
    return 0
  fi
  if [ -L $CACHE ] || [ -L $TRUSTED ] || { [ -e $TRUSTED ] && [ ! -f $TRUSTED ]; }; then
    TEXT_TRUST="this start read it $r s off the time from the internet; $TRUSTED cannot be written (a link, or not a file)"
    return 0
  fi
  l2=$(sed -n 2p $TRUSTED 2>/dev/null)
  case "$l2" in '' | *[!0-9]*) l2=-1 ;; esac
  if [ "$(sed -n 1p $TRUSTED 2>/dev/null)" = trusted ] && [ "$(sed -n 3p $TRUSTED 2>/dev/null)" = "$mode" ] &&
     [ "$(sed -n 4p $TRUSTED 2>/dev/null)" = "$off" ] && [ "$l2" -ge 0 ] && [ "$l2" -le "$now" ] &&
     [ $((now - l2)) -lt $TRUST_REFRESH ]; then
    TEXT_TRUST="this start read it $r s off the time from the internet (kept from $(date -u -d @$l2 '+%F %T') UTC)"
    return 0
  fi
  part=$TRUSTED.new
  rm -f $part
  if ! { printf 'trusted\n%s\n%s\n%s\n%s\n' $now $mode "$off" \
           "$(date -u -d @$now '+%F %T') UTC: read as $mode, $r s off the time from the internet" >$part &&
         sync && mv -f $part $TRUSTED && sync; }; then
    rm -f $part
    TEXT_TRUST="this start read it $r s off the time from the internet; $TRUSTED could not be written"
    return 0
  fi
  TEXT_TRUST="this start read it $r s off the time from the internet: Kodi waits for the network, not for that time, from the next start ($TRUSTED)"
}

# the verdict kept: the first line of the file where it is a regular file of the storage (no link followed), else
# nothing (as the init reads it)
kept() {
  [ -L $CACHE ] || [ -L $MEASURED ] || [ ! -f $MEASURED ] && return 0
  dd if=$MEASURED bs=256 count=1 2>/dev/null | sed -n 1p
}

case "${1:-}" in
  show)
    # (the verdict first: UTC, local, none, or unmeasured)
    measure || VERDICT=unmeasured
    echo "$VERDICT: $TEXT"
    exit 0
    ;;
  '') ;;
  *)
    echo "usage: clock-measure [show]" >&2
    exit 2
    ;;
esac

if ! measure; then
  echo "$TEXT"
  exit 0
fi
echo "measured: $TEXT"
trust_keep
echo "the clock as read: $TEXT_TRUST"
was=$(kept)
if [ $VERDICT = none ]; then
  echo "nothing is kept, and nothing changes (kept: ${was:-nothing})"
  exit 0
fi
[ "$was" = $VERDICT ] && exit 0

# a verdict that is new: written beside the file, then renamed over it, each step on the drive before the next (a
# link or a folder where the file goes is not written through)
if [ -L $CACHE ] || { [ -d $MEASURED ] && [ ! -L $MEASURED ]; }; then
  echo "$MEASURED cannot be written (a link, or a folder): the verdict is not kept"
  exit 1
fi
part=$MEASURED.new
rm -f $part
if ! { printf '%s\n%s\n' $VERDICT "measured $(date -u '+%F %T') UTC: $TEXT" >$part && sync && mv -f $part $MEASURED && sync; }; then
  rm -f $part
  echo "$MEASURED could not be written: the verdict is not kept"
  exit 1
fi
if [ $VERDICT = UTC ]; then
  said="the clock of the computer keeps UTC: with the setting Hardware clock on Automatic, from the next start it is read as UTC, and never written"
else
  said="the clock of the computer keeps local time: with the setting Hardware clock on Automatic, from the next start it is read as local time, and never written"
fi
said="$said (kept before: ${was:-nothing})"
[ -e $CHOICE ] || [ -L $CHOICE ] &&
  said="$said; the setting is set by hand now ($CHOICE), so this is used once it is on Automatic"
echo "$said"
mkdir -p ${CHANGED%/*} && echo "$(date -u '+%F %T') UTC: $said" >$CHANGED
exit 0
