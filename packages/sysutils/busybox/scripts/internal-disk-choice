#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: the internal disks that are kept away from the kernel while the internal disks are shown.
#
# With the setting "show the internal disks (read-only)" on (internal-disks), the kernel attaches every disk
# inside the computer, and 95-udevil-mount.rules mounts their partitions read-only (internal-partitions can
# leave some of them unmounted). A partition that is not mounted is still on its disk, where a program that
# runs with full rights can read it. With this, whole disks are kept away instead: in a start whose entry
# shows the internal disks, the init detaches, before anything else runs, the NVMe controllers and the ATA
# disks that $LIST does not show, tells the kernel to attach no more of them
# (kernel.internal_disk_attach_disabled, which cannot be taken back until the next start) and locks the
# kernel down (integrity), so that no program, whatever its rights, brings them back in that start
# (hide_chosen_disks in the init). What goes for each disk is in $LIST, which the settings add-on writes with
# "save":
#
#   others shown|hidden                          for a disk that is not on the list
#   shown|hidden kind=K model=M serial=S desc=D  one disk. K is nvme (an NVMe controller, with every namespace
#                                                of it) or ata (an ATA disk: SATA or PATA). M and S are its
#                                                model and its serial number as the kernel has them, without
#                                                the blanks around them: of the NVMe controller, or, for an
#                                                ATA disk, the model of its SCSI device and the serial number
#                                                of its page 0x80 (which libata takes from the disk). D is
#                                                what the settings show of it
#
# Every value is written with the bytes other than letters, digits and . _ : - as %XX, as in the list of
# internal-partitions. A disk is told by the three together, never by the name of its device (nvme0, sda),
# which can change from one start to the next. One that has no serial number cannot be told apart from
# others, and neither can two disks of one start that have the same three (twins: cheap disks that all say
# the same serial number; one disk seen through two controllers of an NVMe subsystem has the same namespaces
# through both, and is one disk): while the list exists such a disk is kept away, whatever "others" and the
# list say, since it could be one that the list keeps away. Two lines for one disk that do not say the same
# keep it away, and so does a list that cannot be read: then every disk is kept away. Never more than the
# list shows is shown.
#
# Only NVMe controllers and ATA disks can be kept away: the ones that hide_other_disks of the init takes away
# on an internal installation. Disks on USB, removable ones and the internal disks of other kinds (SAS, RAID
# controllers, eMMC) are not kept away by this; their partitions are for internal-partitions.
#
# This script is in the initramfs too, for the init, and in the system, for the settings. It never detaches,
# attaches or mounts anything: "plan" says what goes, and the init does it.
#
# Usage:
#   internal-disk-choice plan [<list>]
#                               for the init: "list none|ok|damaged N", and with a list, one line for each
#                               NVMe controller and each ATA disk that the kernel has now (the list given: where
#                               it is at the second look of the init, under the new root):
#                                 nvme <PCI function> <controller> hide|show <why> model=M serial=S size=Z
#                                 ata <SCSI device> <block device> hide|show <why> model=M serial=S size=Z
#                               why: listed (the list names it), others (it does not), unknown (it cannot be
#                               told apart), damaged (the list cannot be read: every one is kept away); Z: its
#                               size in bytes
#   internal-disk-choice list   for the settings: "start shows|hides" (whether the entry of this start hides
#                               the internal disks), "list none|ok|damaged N", "others shown|hidden" (what goes
#                               for them now), "this none|chosen|damaged held|loose|open|unsafe" (what the init
#                               did in this start, damaged also where the list could be read at the first look
#                               and not at the second: held, what the list keeps away went, the switch is set
#                               and the kernel is locked down, or a list that could be read kept nothing away;
#                               loose, it went, but the kernel could take it back; open, some of it is still
#                               attached; unsafe, nothing went, since the disk of this system could not be told:
#                               in the last two no internal partition is mounted in this start), then "here
#                               STATE id=yes|no own=yes|no kind= model= serial= place= dev= size=" for each NVMe
#                               controller and ATA disk of this start,
#                               "hidden STATE kind= model= serial= desc=" for each one of the list that the init
#                               kept away in this start, and for each one that it kept away because the list
#                               does not name it (with desc= empty and its size= in bytes), "gone STATE kind=
#                               model= serial= desc=" for each one of the list that is not here otherwise,
#                               "twin STATE kind= model= serial= desc=" for each line of the list whose disk
#                               cannot be told apart in this start (the line as the list has it, to be kept),
#                               "fixed dev= size= model=" for each internal disk of a kind that this cannot keep
#                               away, "unknown dev=" for each one that the init kept away that cannot be told
#                               apart, and "stayed dev=" for each one that the init was to keep away and that
#                               is still attached (values written as in the list; size in bytes; dev: the block
#                               devices, with commas, or -; of "unknown" and "stayed", the name that the plan
#                               gave)
#   internal-disk-choice save   for the settings: the new list on standard input ("others" and the lines of
#                               the disks, nothing else), checked and written whole. Where it keeps nothing
#                               away, the list is taken away: that is what a system without one does
# Exit status: 0 done; 1 wrong usage; 2 (save) what came in is not a list that this reads, and nothing was
# written; 3 (save) the list could not be written, and it is as it was, or it could not be told for certain
# that it is as asked ("list" tells); 4 (plan, list) the disks of this start could not be read

# Run from Kodi or from the init: only what the system has, in the C locale, without the variables that the
# loader and the C library take from the environment (the list of internal-disks).
PATH=/usr/bin:/usr/sbin
export PATH
LC_ALL=C
export LC_ALL
unset GCONV_PATH GETCONF_DIR GLIBC_TUNABLES HOSTALIASES LD_AUDIT LD_BIND_NOT LD_BIND_NOW LD_DEBUG \
  LD_DEBUG_OUTPUT LD_DYNAMIC_WEAK LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PRELOAD LD_PROFILE LD_PROFILE_OUTPUT \
  LD_SHOW_AUXV LD_VERBOSE LD_WARN LOCALDOMAIN LOCPATH MALLOC_ARENA_MAX MALLOC_ARENA_TEST MALLOC_MMAP_MAX_ \
  MALLOC_MMAP_THRESHOLD_ MALLOC_PERTURB_ MALLOC_TOP_PAD_ MALLOC_TRACE MALLOC_TRIM_THRESHOLD_ NIS_PATH NLSPATH \
  RESOLV_HOST_CONF RES_OPTIONS TMPDIR TZDIR

LIST=/storage/.config/hades-internal-disks.conf
SYS=/sys
MOUNTS=/proc/mounts
CMDLINE=/proc/cmdline
# (the mark of hide_other_disks, and what the init left of what it did with this: hide_chosen_disks)
MARK=/dev/.hades_other_disks_hidden
STATE=/dev/.hades_internal_disks
RUNDIR=/run
# (how many disks a list may name, how long a line of it may be, and how much "save" reads)
MAX=64
LINE=2048
INMAX=65536

# One program for the four uses (MODE), so that the list is read and a disk is told by the same lines:
#   check  the file given: prints "ok", or "damaged N" for the first line N that is not of a known kind
#          (INPUT=1: it is the input of "save", which has no comments or empty lines)
#   plan   the list given (or none: HASLIST=0, DAMAGED=1 for one that cannot be read at all), then the disks
#          of the environment: the lines of "plan"
#   list   the same, then the mounts and what the init left: the lines "here", "hidden", "gone", "twin",
#          "fixed", "unknown", "stayed"
# The disks come in the environment, their values as the kernel has them: D_N, and for each i D_i_KIND (nvme,
# ata, fixed), D_i_PLACE, D_i_DEV, D_i_SIZE, D_i_MODEL, D_i_SERIAL (see disks below).
PROG='
BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
# a value as the list has it: the bytes other than letters, digits and . _ : - as %XX
function enc(v,    o, i, c) {
  o = ""
  for (i = 1; i <= length(v); i++) {
    c = substr(v, i, 1)
    if (c ~ /[A-Za-z0-9._:-]/) o = o c
    else o = o sprintf("%%%02X", ord[c])
  }
  return o
}
function trim(v) { gsub(/^[ \t]+/, "", v); gsub(/[ \t]+$/, "", v); return v }
function bad() { if (!damaged) damaged = FNR }
# the value of a field "name=value" of a line, or "\001" where it is not one
function field(f, name,    v) {
  if (substr(f, 1, length(name) + 1) != name "=") return "\001"
  v = substr(f, length(name) + 2)
  if (v !~ /^[A-Za-z0-9._:%-]*$/ || v ~ /%([^0-9A-F]|.[^0-9A-F]|.?$)/) return "\001"
  return v
}
# the value of the field "name=value" of this line, wherever it is after its first word, or "\001"
function named(name,    i, v) {
  for (i = 2; i <= NF; i++) {
    v = field($i, name)
    if (v != "\001") return v
  }
  return "\001"
}
# what goes for a key: shown or hidden. A disk that cannot be told apart is kept away while a list exists;
# FORCE: what goes for all, in "list" without a list
function verdict(k, t) {
  if (FORCE != "") return FORCE
  if (damaged) return "hidden"
  if (!t) return "hidden"
  if (k in hid) return "hidden"
  if (k in sho) return "shown"
  return others
}
function why(k, t) {
  if (damaged) return "damaged"
  if (!t) return "unknown"
  if ((k in hid) || (k in sho)) return "listed"
  return "others"
}
# a line of a list
function listline(    w, m, s, d, k) {
  if (length($0) > LINE || $0 ~ /[[:cntrl:]]/) { bad(); return }
  if (!INPUT && ($0 ~ /^#/ || $0 ~ /^[ \t]*$/)) return
  if ($1 == "others") {
    if (NF != 2 || ($2 != "shown" && $2 != "hidden") || others != "") bad()
    else others = $2
    return
  }
  if ($1 == "shown" || $1 == "hidden") {
    w = field($2, "kind"); m = field($3, "model"); s = field($4, "serial"); d = field($5, "desc")
    if (NF != 5 || (w != "nvme" && w != "ata") || m == "\001" || s == "\001" || d == "\001" || s == "") { bad(); return }
    if (++n > MAX) { bad(); return }
    k = w " " m " " s
    if ($1 == "hidden") hid[k] = 1; else sho[k] = 1
    if (!(k in seen)) { seen[k] = 1; order[++norder] = k }
    if (!(k in line) || $1 == "hidden") line[k] = $0
    return
  }
  bad()
}
function endlist() {
  if (!damaged && others == "") damaged = FNR + 1
  listdone = 1
}
# the key of the disk i of the environment (dk, dm, ds: its kind, model and serial number, written as the list
# writes them)
function keyof(i) {
  dk = ENVIRON["D_" i "_KIND"]; dm = enc(trim(ENVIRON["D_" i "_MODEL"])); ds = enc(trim(ENVIRON["D_" i "_SERIAL"]))
  return dk " " dm " " ds
}
# whether a block device of the disk i holds /flash or /storage (dev: its devices with commas)
function own(dev,    a, j, nd, x, r) {
  nd = split(dev, a, ",")
  for (x in mounted) for (j = 1; j <= nd; j++) {
    if (a[j] == "" || a[j] == "-") continue
    if (x == a[j]) return 1
    r = substr(x, length(a[j]) + 1)
    if (substr(x, 1, length(a[j])) == a[j] && r ~ /^p?[0-9]+$/) return 1
  }
  return 0
}
function disks(    i, nd, k, v, dv, tellable) {
  nd = ENVIRON["D_N"] + 0
  # first, the keys that two disks of this start have (amb), which tell neither of them apart: not one disk
  # that two controllers of an NVMe subsystem show, which has the same namespaces through both
  for (i = 1; i <= nd; i++) {
    if (ENVIRON["D_" i "_KIND"] == "fixed") continue
    k = keyof(i)
    if (ds == "") continue
    dv = ENVIRON["D_" i "_DEV"]
    if (!(k in kdev)) kdev[k] = dv
    else if (dv == "-" || dv != kdev[k]) amb[k] = 1
  }
  for (i = 1; i <= nd; i++) {
    if (ENVIRON["D_" i "_KIND"] == "fixed") {
      if (MODE == "list")
        printf "fixed dev=%s size=%s model=%s\n", enc(ENVIRON["D_" i "_DEV"]), ENVIRON["D_" i "_SIZE"],
          enc(trim(ENVIRON["D_" i "_MODEL"]))
      continue
    }
    k = keyof(i)
    tellable = (ds != "" && !(k in amb))
    if (tellable) here[k] = 1
    v = verdict(k, tellable)
    if (MODE == "plan")
      printf "%s %s %s %s %s model=%s serial=%s size=%s\n", dk, ENVIRON["D_" i "_PLACE"], ENVIRON["D_" i "_NAME"],
        v == "hidden" ? "hide" : "show", why(k, tellable), dm, ds, ENVIRON["D_" i "_SIZE"]
    else
      printf "here %s id=%s own=%s kind=%s model=%s serial=%s place=%s dev=%s size=%s\n", v, tellable ? "yes" : "no",
        own(ENVIRON["D_" i "_DEV"]) ? "yes" : "no", dk, dm, ds, enc(ENVIRON["D_" i "_PLACE"]),
        enc(ENVIRON["D_" i "_DEV"]), ENVIRON["D_" i "_SIZE"]
  }
}
MODE == "list" && FILENAME == MOUNTS {
  if (HASLIST && !listdone) endlist()
  if (($2 == "/flash" || $2 == "/storage") && substr($1, 1, 5) == "/dev/") mounted[substr($1, 6)] = 1
  next
}
# what the init left (hide_chosen_disks): the disks that it kept away ("hidden kind= model= serial= size=
# dev="), the ones that it kept away that cannot be told apart ("unknown kind= model= serial= size= dev=": of a
# twin, its key is one that tells nothing apart in this start, even where the other twin is not here now),
# and the ones that it was to keep away and that are still attached ("stayed kind= dev="). An older form of
# these lines, without size= ("unknown dev=" alone), is read too.
MODE == "list" && FILENAME == STATEF {
  if (HASLIST && !listdone) endlist()
  if ($1 == "hidden" || $1 == "unknown") {
    sk = named("kind"); sm = named("model"); ss = named("serial"); sz = named("size")
    k = sk " " sm " " ss
    if (k !~ /\001/ && ss != "") {
      if ($1 == "unknown") amb[k] = 1
      else if (!(k in kept)) {
        kept[k] = 1; kord[++nkept] = k; kkind[k] = sk; kmodel[k] = sm; kserial[k] = ss
        ksize[k] = (sz ~ /^[0-9]+$/) ? sz : ""
      }
    }
    if ($1 == "unknown" && named("dev") != "\001") unknown[++nunknown] = named("dev")
  }
  if ($1 == "stayed" && named("dev") != "\001") stayed[++nstayed] = named("dev")
  next
}
{ listline() }
END {
  if (MODE == "check") {
    endlist()
    print damaged ? "damaged " damaged : "ok"
  } else if (MODE == "plan") {
    if (HASLIST && !listdone) endlist()
    if (DAMAGED && !damaged) damaged = 1
    print "list " (damaged ? "damaged " damaged : "ok")
    disks()
  } else if (MODE == "list") {
    if (HASLIST && !listdone) endlist()
    disks()
    if (HASLIST && !damaged) {
      for (i = 1; i <= norder; i++) {
        k = order[i]
        split(line[k], f, " ")
        # (a line whose disk cannot be told apart in this start: kept on the list as it is, and not offered)
        if (k in amb) {
          printf "twin %s %s %s %s %s\n", f[1], f[2], f[3], f[4], f[5]
          continue
        }
        if (k in here) continue
        printf "%s %s %s %s %s %s\n", (k in kept) ? "hidden" : "gone", f[1], f[2], f[3], f[4], f[5]
      }
      # what the init kept away by the line for the others: offered by what it is
      for (i = 1; i <= nkept; i++) {
        k = kord[i]
        if ((k in seen) || (k in here) || (k in amb)) continue
        printf "hidden %s kind=%s model=%s serial=%s desc= size=%s\n", verdict(k, 1), kkind[k], kmodel[k], kserial[k], ksize[k]
      }
    }
    for (i = 1; i <= nunknown; i++) print "unknown dev=" unknown[i]
    for (i = 1; i <= nstayed; i++) print "stayed dev=" stayed[i]
  }
}
'

say() {
  echo "internal-disk-choice: $1" >&2
}

# The place of an entry of sysfs behind its links (the initramfs has no readlink)
sys_path() {
  ( cd -P "$1" 2>/dev/null && pwd )
}

# The size of a block device in bytes (a number, or 0)
size_of() {
  local s
  s=$(cat "$SYS/block/$1/size" 2>/dev/null)
  case "$s" in
    ''|*[!0-9]*) echo 0 ;;
    *) echo $((s * 512)) ;;
  esac
}

# What the kernel has, into the environment of the program: D_N, and for each disk i:
#   D_i_KIND    nvme: an NVMe controller that the NVMe driver has; ata: a disk of libata (type 0, or 20: zoned);
#               fixed (for "list"): any other internal disk (not on USB, not removable): SCSI behind another
#               controller, eMMC
#   D_i_PLACE   the PCI function of the controller, or the SCSI device (H:C:T:L), or -
#   D_i_NAME    what the kernel log calls it: the controller (nvme0), or the block device of the disk (sda) or,
#               while it has none, its SCSI device
#   D_i_DEV     its block devices, with commas (the namespaces of the controller, the disk), or -
#   D_i_SIZE    their size together, in bytes
#   D_i_MODEL, D_i_SERIAL   as the kernel has them, without NUL bytes; the program takes the blanks around them
#               away. The serial number of an ATA disk is its page 0x80 without the first four bytes (its
#               header: libata gives the 20 characters of the disk there)
# The same disks as hide_other_disks of the init takes, found the same way.
I=0
disk() {
  I=$((I + 1))
  export "D_${I}_KIND=$1" "D_${I}_PLACE=$2" "D_${I}_NAME=$3" "D_${I}_DEV=$4" "D_${I}_SIZE=$5" "D_${I}_MODEL=$6" \
    "D_${I}_SERIAL=$7"
}
disks() {
  local c n b q p t devs size m s
  for c in "$SYS"/bus/pci/drivers/nvme/*:*:*.*; do
    [ -e "$c" ] || continue
    for n in "$c"/nvme/nvme*; do
      [ -e "$n/serial" ] || continue
      # its namespaces: under it, or under a subsystem that links to it
      p=$(sys_path "$n")
      devs=""; size=0
      for b in "$SYS"/block/nvme*; do
        [ -e "$b" ] || continue
        q=$(sys_path "$b")
        q=${q%/*}
        if [ "$q" = "$p" ] || { case "$q" in */nvme-subsystem/*) [ -e "$q/${n##*/}" ] ;; *) false ;; esac; }; then
          devs="$devs,${b##*/}"
          size=$((size + $(size_of "${b##*/}")))
        fi
      done
      devs=${devs#,}
      m=$(tr -d '\000' < "$n/model" 2>/dev/null)
      s=$(tr -d '\000' < "$n/serial" 2>/dev/null)
      disk nvme "${c##*/}" "${n##*/}" "${devs:--}" $size "$m" "$s"
    done
  done
  for c in "$SYS"/bus/scsi/devices/[0-9]*:[0-9]*:[0-9]*:[0-9]*; do
    [ -e "$c" ] || continue
    q=$(sys_path "$c")
    case "$q" in
      */ata[0-9]*/host[0-9]*/target*) ;;
      *) continue ;;
    esac
    t=$(cat "$c/type" 2>/dev/null)
    [ "$t" = 0 ] || [ "$t" = 20 ] || continue
    devs=""; size=0
    for b in "$c"/block/*; do
      [ -e "$b" ] || continue
      devs="$devs,${b##*/}"
      size=$((size + $(size_of "${b##*/}")))
    done
    devs=${devs#,}
    m=$(tr -d '\000' < "$c/model" 2>/dev/null)
    s=$(dd if="$c/vpd_pg80" bs=4 skip=1 2>/dev/null | tr -d '\000')
    disk ata "${c##*/}" "${devs:-${c##*/}}" "${devs:--}" $size "$m" "$s"
  done
  [ "$1" = list ] || return 0
  for b in "$SYS"/block/sd* "$SYS"/block/mmcblk*; do
    [ -e "$b" ] || continue
    case "${b##*/}" in
      mmcblk*boot* | mmcblk*rpmb) continue ;;
    esac
    q=$(sys_path "$b")
    case "$q" in
      */usb[0-9]*/* | */ata[0-9]*/*) continue ;;
    esac
    case "${b##*/}" in
      sd*)
        [ "$(cat "$b/removable" 2>/dev/null)" = 1 ] && continue
        m=$(tr -d '\000' < "$b/device/model" 2>/dev/null)
        ;;
      mmcblk*)
        [ "$(cat "$b/device/type" 2>/dev/null)" = MMC ] || continue
        m=$(tr -d '\000' < "$b/device/name" 2>/dev/null)
        ;;
    esac
    disk fixed - "${b##*/}" "${b##*/}" "$(size_of "${b##*/}")" "$m" ""
  done
}

has_list() {
  [ -e "$LIST" ] || [ -L "$LIST" ]
}

# Whether the list is a file that can be read at all: a file of its own (not a link, not a folder or a device)
# of at most what "save" takes, without a NUL byte (what reads it line by line may end at one). Read with the
# applets that the initramfs has too (no wc there): at most a little more than that much of it.
list_readable() {
  local sz
  [ -f "$LIST" ] && [ ! -L "$LIST" ] && [ -r "$LIST" ] || return 1
  [ -z "$(dd if="$LIST" bs=4096 count=17 2>/dev/null | tr -d -c '\000' | tr '\000' x)" ] || return 1
  sz=$(dd if="$LIST" bs=4096 count=17 2>/dev/null | awk '{ n += length($0) + 1 } END { print n + 0 }')
  case "$sz" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$sz" -le $INMAX ]
}

do_plan() {
  disks plan
  export D_N=$I
  if ! has_list; then
    echo "list none"
    exit 0
  fi
  if list_readable; then
    awk -v MODE=plan -v HASLIST=1 -v DAMAGED=0 -v FORCE= -v LINE=$LINE -v MAX=$MAX -v INPUT=0 "$PROG" "$LIST" || exit 4
  else
    awk -v MODE=plan -v HASLIST=0 -v DAMAGED=1 -v FORCE= -v LINE=$LINE -v MAX=$MAX -v INPUT=0 "$PROG" /dev/null || exit 4
  fi
  exit 0
}

# Whether the entry of this start keeps the internal disks away (what the init knows: HADES_ENTRY_HIDES,
# hide_other_disks, hide_from_usb; the same as start_hides of internal-partitions). Their mark tells it where
# the kernel command line cannot be read; not where hide_chosen_disks left it (and its state beside it): the
# entry showed the disks then, and what the init did is in "this".
start_hides() {
  local a
  [ -e "$MARK" ] && [ ! -e "$STATE" ] && return 0
  for a in $(cat "$CMDLINE" 2>/dev/null); do
    case "$a" in
      hades.otherdisks=hide) return 0 ;;
      initcall_blacklist=*)
        case ",${a#*=}," in *,nvme_init,*|*,ahci_pci_driver_init,*) return 0 ;; esac
        ;;
    esac
  done
  return 1
}

# What the init did in this start, from what it left ($1: a copy of it): "none", "chosen" or "damaged" (also a
# list that was read at the first look and not at the second: "again unread", after which every disk was kept
# away), and "unsafe" where nothing was detached because the disk of this system could not be told ("system
# unknown"), "open" where one that was to be kept away is still attached ("stayed"), "held" where the kernel
# keeps what went (the switch is set and the kernel is locked down) or where a list that could be read kept
# nothing away in this start, else "loose"
this_start() {
  local s h
  s=$(awk 'NR == 1 && $1 == "state" && ($2 == "chosen" || $2 == "damaged") { print $2 }' "$1" 2>/dev/null)
  [ -n "$s" ] || { echo "none loose"; return; }
  grep -qx 'again unread' "$1" 2>/dev/null && s=damaged
  if grep -qx 'system unknown' "$1" 2>/dev/null; then
    h=unsafe
  elif grep -q '^stayed ' "$1" 2>/dev/null; then
    h=open
  elif grep -qx 'switch yes' "$1" 2>/dev/null && grep -qx 'lockdown yes' "$1" 2>/dev/null; then
    h=held
  elif [ "$s" = chosen ] && ! grep -qE '^(hidden|unknown) ' "$1" 2>/dev/null; then
    h=held
  else
    h=loose
  fi
  echo "$s $h"
}

# W: a folder of this run in RAM
W=""
leave() {
  [ -n "$W" ] && rm -rf "$W"
}

do_list() {
  local st others has=0 state
  trap leave EXIT
  W=$(mktemp -d "$RUNDIR/internal-disk-choice.XXXXXX" 2>/dev/null) || exit 4
  # (what the init left is read only as it is: a file of its own in /dev)
  state=$W/state
  if [ -f "$STATE" ] && [ ! -L "$STATE" ]; then head -c $INMAX "$STATE" > "$state" 2>/dev/null; else : > "$state"; fi
  disks list
  export D_N=$I
  if start_hides; then echo "start hides"; else echo "start shows"; fi
  if ! has_list; then
    st=none
  elif list_readable; then
    has=1
    st=$(awk -v MODE=check -v LINE=$LINE -v MAX=$MAX -v INPUT=0 "$PROG" "$LIST" 2>/dev/null) || st="damaged 1"
  else
    st="damaged 1"
  fi
  echo "list $st"
  case "$st" in
    none) others=shown ;;
    ok) others=$(awk '$1 == "others" { print $2 }' "$LIST" 2>/dev/null) ;;
    *) others=hidden ;;
  esac
  echo "others $others"
  echo "this $(this_start "$state")"
  # (the list is read first, so that what goes for each disk is known when it comes; without a list that can
  # be read, what goes for all is what the init does: shown without a list, hidden with a damaged one)
  if [ $has = 1 ] && [ "$st" = ok ]; then
    awk -v MODE=list -v HASLIST=1 -v DAMAGED=0 -v FORCE= -v MOUNTS="$MOUNTS" -v STATEF="$state" -v LINE=$LINE -v MAX=$MAX \
      -v INPUT=0 "$PROG" "$LIST" "$MOUNTS" "$state"
  else
    awk -v MODE=list -v HASLIST=0 -v DAMAGED=0 -v FORCE=$others -v MOUNTS="$MOUNTS" -v STATEF="$state" -v LINE=$LINE \
      -v MAX=$MAX -v INPUT=0 "$PROG" "$MOUNTS" "$state"
  fi || exit 4
  exit 0
}

# Whether two files have the same content
same() {
  local a b
  a=$(sha256sum 2>/dev/null < "$1") || return 1
  b=$(sha256sum 2>/dev/null < "$2") || return 1
  [ -n "$a" ] && [ "$a" = "$b" ]
}

do_save() {
  local r dir=${LIST%/*} new n=0
  trap leave EXIT
  W=$(mktemp -d "$RUNDIR/internal-disk-choice.XXXXXX" 2>/dev/null) || exit 3
  head -c $((INMAX + 1)) > "$W/in" 2>/dev/null || exit 2
  [ "$(wc -c < "$W/in")" -le $INMAX ] || exit 2
  r=$(awk -v MODE=check -v LINE=$LINE -v MAX=$MAX -v INPUT=1 "$PROG" "$W/in" 2>/dev/null)
  [ "$r" = ok ] || exit 2
  # (one writer at a time)
  while ! mkdir "$RUNDIR/internal-disk-choice.lock" 2>/dev/null; do
    n=$((n + 1))
    [ $n -le 10 ] || exit 3
    sleep 1
  done
  trap 'rmdir "$RUNDIR/internal-disk-choice.lock" 2>/dev/null; leave' EXIT
  # (a list that keeps nothing away says what no list says: it is taken away)
  if grep -qx 'others shown' "$W/in" && ! grep -q '^hidden ' "$W/in"; then
    has_list || exit 0
    rm -f "$LIST" 2>/dev/null
    sync "$dir" 2>/dev/null
    has_list && exit 3
    exit 0
  fi
  {
    echo "# The internal disks that are shown while the internal disks are shown (LibreELEC settings > System >"
    echo "# Internal disks). Written by /usr/lib/libreelec/internal-disk-choice, which the init asks at each start"
    echo "# that shows the internal disks: what it keeps away is detached before anything else runs, and the kernel"
    echo "# is locked down. A line that cannot be read keeps every internal disk away."
    cat "$W/in"
  } > "$W/list" || exit 3
  mkdir -p "$dir" 2>/dev/null
  new="$LIST.new"
  rm -f "$new" 2>/dev/null
  # (written through, read back, put in the place of the list by a rename, and the folder written through)
  if cp "$W/list" "$new" 2>/dev/null && sync "$new" 2>/dev/null && same "$W/list" "$new" &&
     mv -f "$new" "$LIST" 2>/dev/null && sync "$LIST" "$dir" 2>/dev/null && same "$W/list" "$LIST"; then
    exit 0
  fi
  rm -f "$new" 2>/dev/null
  exit 3
}

if [ $# -eq 2 ] && [ "$1" = plan ] && [ -n "$2" ]; then
  LIST=$2
  do_plan
fi
if [ $# -eq 1 ]; then
  case "$1" in
    plan) do_plan ;;
    list) do_list ;;
    save) do_save ;;
  esac
fi
echo "usage: internal-disk-choice plan [<list>]|list|save" >&2
exit 1
