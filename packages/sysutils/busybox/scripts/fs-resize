StartProgressLog() {
  if [ "$1" = "spinner" ]; then
    echo "*** $3" >>$LOG
  fi
  StartProgress "$@"
}

# Hades: the restart at the end comes back to this system (usr/lib/libreelec/hades-bootnext again), also on a PC
# whose boot order starts Windows first: the first start of Hades, from the boot menu of the firmware or by "Restart
# into LibreELEC Hades", would otherwise end in Windows. Its answer goes into fs-resize.log (a line "bootnext=..." or
# "error=..."), while the boot partition is still writable; it is asked once.
KEPT=""
keep_this_start() {
  [ -z "$KEPT" ] || return 0
  KEPT=yes
  if [ -n "$LOG" ]; then
    echo "hades-bootnext again: $(/bin/sh /usr/lib/libreelec/hades-bootnext again 2>&1 | tr '\n' ' ')" >>$LOG 2>/dev/null
  else
    /bin/sh /usr/lib/libreelec/hades-bootnext again >/dev/null 2>&1
  fi
}

if [ -e /storage/.please_resize_me ] ; then
  . /usr/lib/libreelec/functions

  hidecursor

  mount -o remount,rw /flash
  LOG=/flash/fs-resize.log
  date -Iseconds >>$LOG

  # this sh** was never intended to be used
  # on an already installed and running system
  if [ -d /storage/.kodi -o -d /storage/.config -o -d /storage/.cache ] ; then
    rm -f /storage/.please_resize_me
    sync
    echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
    keep_this_start
    mount -o remount,ro /flash
    StartProgress countdown "Rebooting in 15s... " 15 "NOW"
    reboot -f
  fi

  # get the disk and the number of the partition that /storage is on.
  # Hades: it need not be the 2nd one. Installed next to the data of a disk (the installer for
  # Windows makes room on it), /storage is the 4th partition or a later one, and "resizepart 2"
  # would be about a partition of the user. The kernel says which partition a block device is,
  # and of which disk; a device that is no partition is left alone, as before.
  echo $(grep "/storage " /proc/mounts) >>$LOG
  PART=$(grep "/storage " /proc/mounts | cut -d" " -f1)
  PARTNUM=$(cat /sys/class/block/${PART#/dev/}/partition 2>/dev/null)
  DISK=""
  if [ -n "$PARTNUM" ]; then
    DISK=/dev/$(basename "$(readlink -f /sys/class/block/${PART#/dev/}/..)")
  else
    PART=""
  fi

  rm -f /storage/.please_resize_me
  sync

  LABEL=$(blkid -o value -s LABEL $PART)
  UUID=$(blkid -o value -s UUID $PART)

  echo "DISK: $DISK  PART: $PART  NUMBER: $PARTNUM  LABEL: $LABEL  UUID: $UUID" >>$LOG

  # Hades: the key slot of Secure Boot (/storage/.hades-secureboot/key, packages/sysutils/hades-secureboot), which the
  # installer for Windows may have written the key of the computer into, is carried across the file system made
  # below: kept in RAM (root only) while the partition is made again, written back, read back, and the copy in RAM
  # overwritten and removed. A slot that cannot be written back is said here and in the kernel log: the system then
  # starts as it was signed, and an update in place cannot sign it until the installer gives it a key again.
  SB_SLOT=/storage/.hades-secureboot/key
  SB_KEEP=""
  if [ -f $SB_SLOT ] && [ ! -L $SB_SLOT ] && [ ! -L /storage/.hades-secureboot ] &&
     [ "$(stat -t $SB_SLOT 2>/dev/null | awk '{ print $2 }')" = 4096 ] && [ "$(head -n 1 $SB_SLOT 2>/dev/null)" = "hades-secureboot-slot 1" ]; then
    SB_KEEP=/run/hades-sb-slot
    ( umask 077 && cp $SB_SLOT $SB_KEEP ) || SB_KEEP=""
  fi

  # just in case
  if [ ! -z "$DISK" -a ! -z "$PART" -a ! -z "$UUID" ] ; then
    umount $PART

    echo "PARTITION RESIZING IN PROGRESS"
    echo ""
    echo "Please do not reboot or turn off your @DISTRONAME@ device!"
    echo ""

    # (a partition that another one follows cannot grow: its file system is made as large as it is)
    StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart $PARTNUM 100% >>$LOG 2>&1"
    StartProgressLog spinner "Creating file system... " "mke2fs -F -q -t ext4 -m 0 -L \"$LABEL\" -U \"$UUID\" $PART >>$LOG 2>&1"
    StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1"
    if [ -n "$SB_KEEP" ]; then
      SB_MNT=/run/hades-sb-mnt
      if mkdir -p $SB_MNT && mount -t ext4 $PART $SB_MNT &&
         ( umask 077 && mkdir -p $SB_MNT/.hades-secureboot && cp $SB_KEEP $SB_MNT/.hades-secureboot/key.new ) &&
         sync && [ "$(md5sum <$SB_MNT/.hades-secureboot/key.new)" = "$(md5sum <$SB_KEEP)" ] &&
         mv -f $SB_MNT/.hades-secureboot/key.new $SB_MNT/.hades-secureboot/key && sync; then
        echo "the key slot of Secure Boot is kept in the new file system" >>$LOG
      else
        echo "hades-secureboot: the key slot could not be kept in the new storage" >/dev/kmsg 2>/dev/null
        echo "the key slot of Secure Boot could not be kept in the new file system" | tee -a $LOG
      fi
      umount $SB_MNT 2>/dev/null
      dd if=/dev/zero of=$SB_KEEP bs=4096 count=1 conv=notrunc 2>/dev/null
      rm -f $SB_KEEP
    fi
    StartProgress countdown "Rebooting in 15s...     " 15 "NOW"
  else
    echo "Partition was not detected - resizing aborted."
    StartProgress countdown "Rebooting in 15s... " 15 "NOW"
  fi
  keep_this_start
  mount -o remount,ro /flash
fi
LOG=""
keep_this_start
reboot -f &>/dev/null
