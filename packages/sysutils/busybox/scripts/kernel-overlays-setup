#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2017-present Team LibreELEC (https://libreelec.tv)

SYSTEM_OVERLAYS_DIR=/usr/lib/kernel-overlays
OVERLAY_CONFIG_DIR=/storage/.cache/kernel-overlays
KVER=$(uname -r)
RUNTIME_DIR="/run/kernel-overlays"
MODULES_DIR="${RUNTIME_DIR}/modules/${KVER}"
FIRMWARE_DIR="${RUNTIME_DIR}/firmware"
USER_FIRMWARE_DIR="/storage/.config/firmware"

mkdir -p "${MODULES_DIR}"
mkdir -p "${FIRMWARE_DIR}"

log() {
  echo "kernel-overlays-setup: $@" >/dev/kmsg
}

# Hades: a locked-down kernel (the boot entries that hide the internal disks, lockdown=integrity, and a start
# that keeps internal disks away, which the init locks down through securityfs before this is run)
# loads only modules signed with the key of its build: those of the image. The modules of overlays
# from elsewhere (driver add-ons) are not signed with it; they would take the place of the system's
# modules of the same name and fail to load. securityfs is not mounted when the initramfs runs this,
# so the kernel command line tells.
locked_down() {
  if [ -r /sys/kernel/security/lockdown ]; then
    grep -qE '\[(integrity|confidentiality)\]' /sys/kernel/security/lockdown
  else
    grep -qE '(^| )lockdown=(integrity|confidentiality)( |$)' /proc/cmdline
  fi
}

image_overlay() {
  case "$1" in
    */../* | */..) return 1 ;;
    "${SYSTEM_OVERLAYS_DIR}"/*) return 0 ;;
    *) return 1 ;;
  esac
}

apply_overlay() {
  case "$1" in
    /*)
      modules_overlay_dir="${1}/lib/modules/${KVER}"
      firmware_overlay_dir="${1}/lib/firmware"
      ;;
    *)
      modules_overlay_dir="${SYSTEM_OVERLAYS_DIR}/${1}/lib/modules/${KVER}"
      firmware_overlay_dir="${SYSTEM_OVERLAYS_DIR}/${1}/lib/firmware"
      ;;
  esac

  if [ -d "${modules_overlay_dir}" ]; then
    if ! image_overlay "${modules_overlay_dir}" && locked_down; then
      log "not adding modules from $modules_overlay_dir: the kernel is locked down and loads only its own modules (boot entry without lockdown: internal, while no internal disk is kept away)"
    else
      GOT_MODULE_OVERLAY="yes"

      if cp -rfs "${modules_overlay_dir}"/* "${MODULES_DIR}"; then
        log "added modules from $modules_overlay_dir"
      else
        log "failed to add modules from $modules_overlay_dir"
      fi
    fi
  fi

  if [ -d "${firmware_overlay_dir}" ]; then
    if cp -rfs "${firmware_overlay_dir}"/* "${FIRMWARE_DIR}"; then
      log "added firmware from $firmware_overlay_dir"
    else
      log "failed to add firmware from $firmware_overlay_dir"
    fi
  fi
}

# setup system base modules

log "setup base modules"
apply_overlay base
# Hades: base comes with its modules.dep; only an overlay added below needs depmod
GOT_MODULE_OVERLAY="no"

# Hades: the NVIDIA driver for this PC, from the PCI IDs of its cards (stack-select): the 580
# one of the image overlay nvidia-legacy (Maxwell, Pascal, Volta) over the 615 one of base, or
# base as it is. The names that user space opens for NVIDIA are then pointed at the files of
# the same release (stack-links). Should the overlay not take, the 615 driver and its files.
if [ -x /usr/lib/nvidia/stack-select ]; then
  NVIDIA_DRIVER=$(/usr/lib/nvidia/stack-select 2>/dev/kmsg)
  if [ "$NVIDIA_DRIVER" = "legacy" ]; then
    apply_overlay nvidia-legacy
    case "$(readlink "${MODULES_DIR}/nvidia/nvidia.ko")" in
      "${SYSTEM_OVERLAYS_DIR}/nvidia-legacy/"*) ;;
      *)
        log "NVIDIA: the modules of nvidia-legacy did not take: the 615 driver"
        NVIDIA_DRIVER="open"
        ;;
    esac
  else
    NVIDIA_DRIVER="open"
  fi
  /usr/lib/nvidia/stack-links "$NVIDIA_DRIVER" 2>/dev/kmsg ||
    log "NVIDIA: the names of the $NVIDIA_DRIVER driver could not be set up"
fi

# apply user-configured module overlays

if [ -d "${OVERLAY_CONFIG_DIR}" ]; then
  log "adding overlays from ${OVERLAY_CONFIG_DIR}"

  for conf in "${OVERLAY_CONFIG_DIR}/"*.conf; do
    if [ -e "$conf" ]; then
      log "processing conf $conf"
      overlay=$(cat "$conf")
      [ -n "$overlay" ] && apply_overlay "$overlay"
    fi
  done
fi

if [ "yes" = "$GOT_MODULE_OVERLAY" ]; then
  log "running depmod"
  /usr/sbin/depmod -a >/dev/kmsg 2>&1
fi

if [ -d "${USER_FIRMWARE_DIR}" ] && [ -n "$(ls ${USER_FIRMWARE_DIR})" ]; then
  if cp -rfs "${USER_FIRMWARE_DIR}"/* "${FIRMWARE_DIR}"; then
    log "added firmware from ${USER_FIRMWARE_DIR}"
  else
    log "failed to add firmware from ${USER_FIRMWARE_DIR}"
  fi
fi

log "done"
