From b3df05ff7613957d0e3c439c35f2efc6317c2128 Mon Sep 17 00:00:00 2001
From: Denys Vlasenko <vda.linux@googlemail.com>
Date: Sat, 21 Nov 2026 17:23:37 +0100
Subject: [PATCH] unzip: detect integer overflow while walking CDF

function                                             old     new   delta
unzip_main                                          2706    2721     +15
.rodata                                           104928  104916     -12
------------------------------------------------------------------------------
(add/remove: 0/0 grow/shrink: 1/1 up/down: 15/-12)              Total: 3 bytes

Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>
---
 archival/libarchive/get_header_tar.c |  2 +-
 archival/unzip.c                     | 14 +++++++++-----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/archival/libarchive/get_header_tar.c b/archival/libarchive/get_header_tar.c
index 470a962..b0a99b1 100644
--- a/archival/libarchive/get_header_tar.c
+++ b/archival/libarchive/get_header_tar.c
@@ -151,7 +151,7 @@ static void process_pax_hdr(archive_handle_t *archive_handle, unsigned sz, int g
 static void die_if_bad_fnamesize(off_t sz)
 {
 	if ((uoff_t)sz > 0xfff) /* more than 4k?! no funny business please */
-		bb_simple_error_msg_and_die("bad archive");
+		bb_simple_error_msg_and_die("corrupted data");
 }
 #endif
 
diff --git a/archival/unzip.c b/archival/unzip.c
index 8a9a90f..be05a7b 100644
--- a/archival/unzip.c
+++ b/archival/unzip.c
@@ -299,6 +299,7 @@ static uint32_t find_cdf_offset(void)
 
 static uint32_t read_next_cdf(uint32_t cdf_offset, cdf_header_t *cdf)
 {
+	uint32_t next_offset, inc;
 	uint32_t magic;
 
 	if (cdf_offset == BAD_CDF_OFFSET)
@@ -329,20 +330,23 @@ static uint32_t read_next_cdf(uint32_t cdf_offset, cdf_header_t *cdf)
 	);
 //TODO: require that magic == ZIP_CDF_MAGIC?
 
-	cdf_offset += 4 + CDF_HEADER_LEN
+	inc = (4 + CDF_HEADER_LEN)
 		+ cdf->fmt.filename_len
 		+ cdf->fmt.extra_len
-		+ cdf->fmt.file_comment_length;
+		+ cdf->fmt.file_comment_length; // can't overflow: 16-bit fields
+	next_offset = cdf_offset + inc;
+	if (next_offset < cdf_offset) // overflow?
+		bb_simple_error_msg_and_die("corrupted data");
 
-	dbg("Next cdf_offset 0x%x", cdf_offset);
-	return cdf_offset;
+	dbg("Next cdf_offset 0x%x", next_offset);
+	return next_offset;
 };
 #endif
 
 static void die_if_bad_fnamesize(unsigned sz)
 {
 	if (sz > 0xfff) /* more than 4k?! no funny business please */
-		bb_simple_error_msg_and_die("bad archive");
+		bb_simple_error_msg_and_die("corrupted data");
 }
 
 static void unzip_skip(off_t skip)
-- 
2.53.0

