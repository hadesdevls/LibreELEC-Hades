From 736c303e332f40d106660d92d8078f4406717594 Mon Sep 17 00:00:00 2001
From: ducanhluu <luuducanh05051995@gmail.com>
Date: Fri, 23 Oct 2026 09:51:23 +0700
Subject: [PATCH] volume_id: clamp exFAT label length and validate
 sector/cluster shifts

The volume label entry is 32 bytes with room for 11 UTF-16 characters,
but char_count (up to 255) was passed through unchecked, so the label
conversion read past the 32-byte buffer. Also reject bytes_per_sector
and sectors_per_cluster shifts outside the spec, which made the
1 << shift computations undefined.

function                                             old     new   delta
volume_id_probe_exfat                                275     318     +43

Signed-off-by: ducanhluu <luuducanh05051995@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>
---
 util-linux/volume_id/exfat.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/util-linux/volume_id/exfat.c b/util-linux/volume_id/exfat.c
index 952b027..024368e 100644
--- a/util-linux/volume_id/exfat.c
+++ b/util-linux/volume_id/exfat.c
@@ -92,6 +92,11 @@ int FAST_FUNC volume_id_probe_exfat(struct volume_id *id /*,uint64_t off*/)
 	if (memcmp(sb->fs_name, "EXFAT   ", 8) != 0)
 		return -1;
 
+	/* spec: 512..4096 byte sectors, clusters up to 32M */
+	if (sb->bytes_per_sector < 9 || sb->bytes_per_sector > 12
+	 || sb->sectors_per_cluster > 25 - sb->bytes_per_sector
+	)
+		return -1;
 	sector_sz = 1 << sb->bytes_per_sector;
 	cluster_sz = sector_sz << sb->sectors_per_cluster;
 	// There are no clusters 0 and 1, so the first cluster is 2.
@@ -122,8 +127,12 @@ int FAST_FUNC volume_id_probe_exfat(struct volume_id *id /*,uint64_t off*/)
 		}
 		if (de->entry_type == 0x83) {
 			// Volume Label Directory Entry
+			unsigned char_count = de->type.label.char_count;
+			// at most 11 chars; more would read past the 32-byte entry
+			if (char_count > ARRAY_SIZE(de->type.label.vol_label))
+				char_count = ARRAY_SIZE(de->type.label.vol_label);
 			volume_id_set_label_unicode16(id, (uint8_t *)de->type.label.vol_label,
-						LE, 2 * de->type.label.char_count);
+						LE, 2 * char_count);
 			need_lbl_guid &= ~(1 << 0);
 		}
 		if (de->entry_type == 0xA0) {
-- 
2.53.0

