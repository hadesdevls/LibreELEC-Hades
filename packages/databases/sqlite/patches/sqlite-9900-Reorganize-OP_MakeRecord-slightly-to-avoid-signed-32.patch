From 4303eaf22199bf952a7931068a407ce5a9e50a46 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Mon, 26 Oct 2026 12:46:03 +0000
Subject: [PATCH] Reorganize OP_MakeRecord slightly to avoid signed 32-bit
 integer overflow prior to discovering an oversize error.

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where src/vdbe.c in sqlite3.c.]

FossilOrigin-Name: 8575e97c30c076d886ca8ce901a8e413d11a41308ca3494b2e196f49160c36fb
Upstream: https://sqlite.org/src/info/8575e97c30c076d886ca8ce901a8e413d11a41308ca3494b2e196f49160c36fb
---
 sqlite3.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sqlite3.c b/sqlite3.c
index ed32e29..feb631f 100644
--- a/sqlite3.c
+++ b/sqlite3.c
@@ -100045,13 +100045,13 @@ case OP_MakeRecord: {
       len = (u32)pRec->n;
       serial_type = (len*2) + 12 + ((pRec->flags & MEM_Str)!=0);
       if( pRec->flags & MEM_Zero ){
-        serial_type += (u32)pRec->u.nZero*2;
         if( nData ){
           if( sqlite3VdbeMemExpandBlob(pRec) ) goto no_mem;
           len += pRec->u.nZero;
         }else{
           nZero += pRec->u.nZero;
         }
+        serial_type += 2*(u32)pRec->u.nZero;
       }
       nData += len;
       nHdr += sqlite3VarintLen(serial_type);
