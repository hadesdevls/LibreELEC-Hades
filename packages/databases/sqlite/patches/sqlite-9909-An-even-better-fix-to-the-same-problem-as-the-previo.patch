From 45c3d6e297877cc5f39d9c4ea92a34313aa44870 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Sun, 25 Oct 2026 13:46:07 +0000
Subject: [PATCH] An even better fix to the same problem as the previous two
 check-ins.

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where ext/recover/sqlite3recover.c in shell.c.]

FossilOrigin-Name: 8f694d2a7de472eff8b3f6018085e03f8a1b68e6307e386e069c72b8af1b1f45
Upstream: https://sqlite.org/src/info/8f694d2a7de472eff8b3f6018085e03f8a1b68e6307e386e069c72b8af1b1f45
---
 shell.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/shell.c b/shell.c
index 0d17e80..0c218cd 100644
--- a/shell.c
+++ b/shell.c
@@ -23130,7 +23130,7 @@ static void recoverAddTable(
   i64 iRoot                       /* Root page of same table in INPUT db */
 ){
   sqlite3_stmt *pStmt = recoverPreparePrintf(p, p->dbOut, 
-      "PRAGMA table_xinfo(%Q)", zName
+      "PRAGMA %Q.table_xinfo(%Q)", p->zDb, zName
   );
 
   if( pStmt ){
@@ -23192,7 +23192,7 @@ static void recoverAddTable(
     recoverFinalize(p, pStmt);
 
     pStmt = recoverPreparePrintf(p, p->dbOut,
-                   "PRAGMA main.index_xinfo(%Q)", zName);
+                   "PRAGMA %Q.index_xinfo(%Q)", p->zDb, zName);
     while( pStmt && sqlite3_step(pStmt)==SQLITE_ROW ){
       int iField = sqlite3_column_int(pStmt, 0);
       int iCol = sqlite3_column_int(pStmt, 1);
