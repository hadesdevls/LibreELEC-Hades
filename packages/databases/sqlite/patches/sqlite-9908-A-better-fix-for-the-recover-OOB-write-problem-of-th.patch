From 7dcbdfa6718afb2afaf0a349e7d23a275f8377d2 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Sun, 25 Oct 2026 13:36:36 +0000
Subject: [PATCH] A better fix for the recover OOB write problem of the
 [37963c3869640f98]

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where ext/recover/sqlite3recover.c in shell.c.]

FossilOrigin-Name: fbe2d9fb82582c06d6f2b137270a085b76d415d551a704db7ab517207cf129bb
Upstream: https://sqlite.org/src/info/fbe2d9fb82582c06d6f2b137270a085b76d415d551a704db7ab517207cf129bb
---
 shell.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/shell.c b/shell.c
index 98f2d29..0d17e80 100644
--- a/shell.c
+++ b/shell.c
@@ -23191,12 +23191,13 @@ static void recoverAddTable(
 
     recoverFinalize(p, pStmt);
 
-    pStmt = recoverPreparePrintf(p, p->dbOut, "PRAGMA index_xinfo(%Q)", zName);
+    pStmt = recoverPreparePrintf(p, p->dbOut,
+                   "PRAGMA main.index_xinfo(%Q)", zName);
     while( pStmt && sqlite3_step(pStmt)==SQLITE_ROW ){
       int iField = sqlite3_column_int(pStmt, 0);
       int iCol = sqlite3_column_int(pStmt, 1);
 
-      if( iCol>=pNew->nCol ) break;
+      assert( iCol<pNew->nCol );
       pNew->aCol[iCol].iField = iField;
 
       pNew->bIntkey = 0;
