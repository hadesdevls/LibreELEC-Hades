From 4546f13d179a310ca6a890e3b4e0069e704ed709 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Sun, 25 Oct 2026 20:29:47 +0000
Subject: [PATCH] Increase the size of the Fts3Table.nPendingData field to 64
 bits to avoid any chance of ridiculous inputs causing a signed integer
 overflow.

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where ext/fts3/fts3Int.h in sqlite3.c, ext/fts3/fts3_write.c in sqlite3.c.]

FossilOrigin-Name: 56f261a67626a26d509e9c5221cfae18320e2b8654ae700adedb204191673406
Upstream: https://sqlite.org/src/info/56f261a67626a26d509e9c5221cfae18320e2b8654ae700adedb204191673406
---
 sqlite3.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/sqlite3.c b/sqlite3.c
index 8e31ea7..44fc7eb 100644
--- a/sqlite3.c
+++ b/sqlite3.c
@@ -194884,8 +194884,8 @@ struct Fts3Table {
     int nPrefix;                  /* Prefix length (0 for main terms index) */
     Fts3Hash hPending;            /* Pending terms table for this index */
   } *aIndex;
-  int nMaxPendingData;            /* Max pending data before flush to disk */
-  int nPendingData;               /* Current bytes of pending data */
+  sqlite_int64 nMaxPendingData;   /* Max pending data before flush to disk */
+  sqlite_int64 nPendingData;      /* Current bytes of pending data */
   sqlite_int64 iPrevDocid;        /* Docid of most recently inserted document */
   int iPrevLangid;                /* Langid of recently inserted document */
   int bPrevDelete;                /* True if last operation was a delete */
@@ -206150,8 +206150,8 @@ static int fts3PendingTermsAddOne(
   pList = (PendingList *)fts3HashFind(pHash, zToken, nToken);
   if( pList ){
     assert( (i64)pList->nData+(i64)nToken+(i64)sizeof(Fts3HashElem)
-             <= (i64)p->nPendingData );
-    p->nPendingData -= (int)(pList->nData + nToken + sizeof(Fts3HashElem));
+             <= p->nPendingData );
+    p->nPendingData -= pList->nData + nToken + sizeof(Fts3HashElem);
   }
   if( fts3PendingListAppend(&pList, p->iPrevDocid, iCol, iPos, &rc) ){
     if( pList==fts3HashInsert(pHash, zToken, nToken, pList) ){
@@ -206164,9 +206164,9 @@ static int fts3PendingTermsAddOne(
     }
   }
   if( rc==SQLITE_OK ){
-    assert( (i64)p->nPendingData + pList->nData + nToken
+    assert( p->nPendingData + pList->nData + nToken
              + sizeof(Fts3HashElem) <= 0x3fffffff );
-    p->nPendingData += (int)(pList->nData + nToken + sizeof(Fts3HashElem));
+    p->nPendingData += pList->nData + nToken + sizeof(Fts3HashElem);
   }
   return rc;
 }
