From 495eef2d14b1d12af567003c7a4a1bf54c3dc368 Mon Sep 17 00:00:00 2001
From: dan <Dan Kennedy>
Date: Tue, 27 Oct 2026 14:37:55 +0000
Subject: [PATCH] Fix a typo in sqlite3expert.c that could lead to a heap
 buffer overwrite in some cases. Report [bugs:/info/2026-10-27T14:08:33Z |
 2026-10-27T14:08:33Z].

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where ext/expert/sqlite3expert.c in shell.c. Not carried: ext/expert/expert1.test (tests of the source tree).]

FossilOrigin-Name: 0273cbefd497f3c0f391b6a06fcc44da6f8497f564af2234f74ea44b0e359ecc
Upstream: https://sqlite.org/src/info/0273cbefd497f3c0f391b6a06fcc44da6f8497f564af2234f74ea44b0e359ecc
---
 shell.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/shell.c b/shell.c
index 0c218cd..d3bbcc8 100644
--- a/shell.c
+++ b/shell.c
@@ -15395,7 +15395,7 @@ static IdxConstraint *idxNewConstraint(int *pRc, const char *zColl){
   int nColl = STRLEN(zColl);
 
   assert( *pRc==SQLITE_OK );
-  pNew = (IdxConstraint*)idxMalloc(pRc, sizeof(IdxConstraint) * nColl + 1);
+  pNew = (IdxConstraint*)idxMalloc(pRc, sizeof(IdxConstraint) + nColl + 1);
   if( pNew ){
     pNew->zColl = (char*)&pNew[1];
     memcpy(pNew->zColl, zColl, nColl+1);
