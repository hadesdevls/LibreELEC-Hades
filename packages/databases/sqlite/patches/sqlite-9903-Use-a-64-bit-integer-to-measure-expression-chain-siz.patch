From 862625c9aeb0ac9aba8f31b1de0b54211097afd4 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Sun, 25 Oct 2026 17:45:41 +0000
Subject: [PATCH] Use a 64-bit integer to measure expression chain size in
 dupedExprSize(), in case of crazy expressions.

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where src/expr.c in sqlite3.c.]

FossilOrigin-Name: ed78f5d2bf2042332637edf541c1295f5f5ca7b1cbb4f647492d3f2221afc781
Upstream: https://sqlite.org/src/info/ed78f5d2bf2042332637edf541c1295f5f5ca7b1cbb4f647492d3f2221afc781
---
 sqlite3.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/sqlite3.c b/sqlite3.c
index 634cb41..20553b4 100644
--- a/sqlite3.c
+++ b/sqlite3.c
@@ -114487,8 +114487,8 @@ static int dupedExprNodeSize(const Expr *p, int flags){
 ** tree formed by Expr.pLeft and Expr.pRight, but not any other
 ** substructure such as Expr.x.pList, Expr.x.pSelect, and Expr.y.pWin.
 */
-static int dupedExprSize(const Expr *p){
-  int nByte;
+static u64 dupedExprSize(const Expr *p){
+  u64 nByte;
   assert( p!=0 );
   nByte = dupedExprNodeSize(p, EXPRDUP_REDUCE);
   if( p->pLeft ) nByte += dupedExprSize(p->pLeft);
@@ -114545,7 +114545,7 @@ static Expr *exprDup(
     assert( sEdupBuf.zAlloc!=0 );
     assert( dupFlags==EXPRDUP_REDUCE );
   }else{
-    int nAlloc;
+    u64 nAlloc;
     if( dupFlags ){
       nAlloc = dupedExprSize(p);
     }else if( !ExprHasProperty(p, EP_IntValue) && p->u.zToken ){
