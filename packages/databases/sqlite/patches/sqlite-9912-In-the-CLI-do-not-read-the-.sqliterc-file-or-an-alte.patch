From ee16b84fb6b36c486cc36280e7fd026232425de9 Mon Sep 17 00:00:00 2001
From: drh <>
Date: Mon, 19 Oct 2026 16:25:28 +0000
Subject: [PATCH] In the CLI, do not read the ~/.sqliterc file or an
 alternative specified by the --init command-line option if the --safe option
 is used. [bugs:/info/2026-10-19T12:32:27Z|Bug 2026-10-19T12:32:27Z]

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where src/shell.c.in in shell.c.]

FossilOrigin-Name: f1e94b6042f056f103eaf4ac11004fc2f559499ccf2b93eae0c9283150a6e921
Upstream: https://sqlite.org/src/info/f1e94b6042f056f103eaf4ac11004fc2f559499ccf2b93eae0c9283150a6e921
---
 shell.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/shell.c b/shell.c
index 237a98f..80b0dc3 100644
--- a/shell.c
+++ b/shell.c
@@ -39304,7 +39304,7 @@ int SQLITE_CDECL main(int argc, char **argv){
     }else if( cli_strcmp(z,"-unsafe-testing")==0 ){
       ShellSetFlag(&data,SHFLG_TestingMode);
     }else if( cli_strcmp(z,"-safe")==0 ){
-      /* no-op - catch this on the second pass */
+      noInit = 1; /* --safe implies --noinit */
     }else if( cli_strcmp(z,"-escape")==0 && i+1<argc ){
       /* skip over the argument */
       i++;
