From 007df2b47771ddac7d8ed68aa8edf9fdee68484c Mon Sep 17 00:00:00 2001
From: drh <>
Date: Thu, 22 Oct 2026 11:19:52 +0000
Subject: [PATCH] Add a rootpage number lower bounds check in the "recover"
 extension. Test case in TH3.

[Hades: backport to 3.54.1 from branch-3.54. The release is the amalgamation, so the change is made where ext/recover/sqlite3recover.c in shell.c.]

FossilOrigin-Name: 4a1fd244b5ca93c6cfe1e0f8e1d087d5b99482081e4b760d09909959c258e506
Upstream: https://sqlite.org/src/info/4a1fd244b5ca93c6cfe1e0f8e1d087d5b99482081e4b760d09909959c258e506
---
 shell.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/shell.c b/shell.c
index d533830..4be10a2 100644
--- a/shell.c
+++ b/shell.c
@@ -22470,7 +22470,7 @@ static void recoverBitmapFree(RecoverBitmap *pMap){
 ** Set the bit associated with page iPg in bitvec pMap.
 */
 static void recoverBitmapSet(RecoverBitmap *pMap, i64 iPg){
-  if( iPg<=pMap->nPg ){
+  if( iPg<=pMap->nPg && iPg>0 ){
     int iElem = (iPg / 32);
     int iBit = (iPg % 32);
     pMap->aElem[iElem] |= (((u32)1) << iBit);
