#
# The Java (BD-J) menus of one Blu-ray disc, outside the player and isolated. One instance per
# connection to hades-bdj.socket, that is per disc: the player (Kodi, as root) connects, and its
# libbluray sends the disc's calls here; the disc's files come back from the player over the same
# connection, read only. When the disc closes, the connection closes, the server ends, and with it
# everything the disc started (the cgroup of the instance).
#
# What the disc's code can reach here: the files of the image (read only, /usr), its own /tmp,
# its persistent storage, and the connection. Not the player's files (/storage), the boot
# partition, /run, other processes, the network, devices or kernel interfaces. LibreELEC builds
# systemd without seccomp, so SystemCallFilter=, RestrictAddressFamilies=, RestrictNamespaces=,
# LockPersonality=, RestrictSUIDSGID=, RestrictRealtime= and MemoryDenyWriteExecute= would do
# nothing here: the server applies a seccomp filter of its own before it opens the disc
# (hades_bdj_sandbox_enter() in libbluray's src/tools), and refuses to run a JVM unless the
# kernel shows it isolated (bdj_sandbox_check()).

[Unit]
Description=Blu-ray Java menus of one disc, isolated
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/lib/hades-bdj/hades-bdj-host
StandardInput=socket
StandardOutput=journal
StandardError=journal
User=hadesbdj
Group=hadesbdj
Environment=JAVA_HOME=/usr/lib/hades-bdj/jre HOME=/var/lib/hades-bdj
UMask=0077

# ready once the server has greeted the player, before it reads anything of the disc (READY=1,
# sd_notify). Not ready within TimeoutStartSec: systemd kills the whole instance (its cgroup) at
# once. SIGKILL, because the server is PID 1 of its own PID namespace (PrivatePIDs=) and does not
# see a SIGTERM before it has a handler for it; for the same reason a stop gives it 10 s. A server
# whose player goes away (Kodi ended, crashed or restarted) ends by itself within 5 s, whatever
# the disc's code does: with Accept=yes, systemd cannot see that.
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
TimeoutStartFailureMode=kill
TimeoutStopSec=10s
KillMode=control-group

# no privileges, no other users
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked
PrivateUsers=yes
RemoveIPC=yes
KeyringMode=private

# no other processes, no network, no devices, no shared memory with others
PrivatePIDs=yes
PrivateNetwork=yes
IPAddressDeny=any
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes

# files: the image read only and nothing of the player's; code runs only from /usr
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
TemporaryFileSystem=/storage:ro /flash:ro /var:ro /run:ro /media:ro
# of /run, systemd's notification socket alone, for READY=1 (the server opens it before its own
# filter, which then refuses any datagram socket of AF_UNIX, and closes it once ready)
BindReadOnlyPaths=/run/systemd/notify
BindPaths=/storage/.cache/hades-bdj/persistent:/var/lib/hades-bdj/persistent
InaccessiblePaths=-/sys/firmware
NoExecPaths=/ /tmp -/var/tmp -/dev/shm /var/lib/hades-bdj/persistent
ExecPaths=/usr
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

# a disc may not take the machine with it; the player is killed last
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
LimitNOFILE=1024
LimitCORE=0
OOMScoreAdjust=500
# the longest a disc may stay open: a day. It cuts no real session (the longest films, a series
# disc played through, a disc paused overnight); a server stuck before it was ready, or whose
# player went away, ends long before (above)
RuntimeMaxSec=24h
