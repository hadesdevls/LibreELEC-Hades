#
# Where the player asks for the isolated Java (BD-J) menus of a disc: one connection, one
# instance of hades-bdj@.service. Only root (the player) may connect.

[Unit]
Description=Blu-ray Java menus, isolated (socket)

[Socket]
ListenStream=/run/hades-bdj/bdj.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0700
Accept=yes
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
