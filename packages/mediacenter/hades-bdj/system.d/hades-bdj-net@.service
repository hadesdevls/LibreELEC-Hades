#
# hades-bdj@.service with BD-Live: the Java (BD-J) menus of one Blu-ray disc, isolated as there,
# with a network to the Internet and nothing else. One instance per connection to
# hades-bdj-net.socket, which the player (Kodi) uses only when its setting BD-Live
# (bluray.hadesbdlive) is on; off, a disc goes to hades-bdj@.service, which has no network.
#
# Everything but the network is as in hades-bdj@.service. The network, in three walls:
# - IPAddressDeny= (a BPF filter of the kernel on the instance's cgroup): no IPv6 at all, and of
#   IPv4 none of the ranges that are not of the Internet (this network, private networks, carrier-
#   grade NAT, loopback, link-local, IETF assignments, documentation, 6to4 relays, benchmarking,
#   multicast, reserved, broadcast). The same table as libbluray's bdlive_net.c and NetAddress.java.
#   systemd starts a unit without it, with a warning, where the kernel cannot filter: the server
#   checks that the kernel refuses a datagram to loopback before it opens the disc (a TCP
#   connection to a refused address is not refused at once: its SYN is dropped and it times out).
# - the server's seccomp filter (HADES_BDJ_NETWORK=internet): AF_UNIX and TCP over IPv4 only, no
#   UDP, no IPv6, no listening.
# - libbluray's Java (BDJSocketImpl): each connection, to an address of the Internet that is
#   neither this system nor a network it is on (the server reads them before it confines itself),
#   said in kodi.log.
# No name server: names are resolved by the player, which answers only with such addresses
# (libbluray's remote/bdr_net_client.c).

[Unit]
Description=Blu-ray Java menus of one disc, isolated, with BD-Live (Internet only)
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/lib/hades-bdj/hades-bdj-host
StandardInput=socket
StandardOutput=journal
StandardError=journal
User=hadesbdj
Group=hadesbdj
Environment=JAVA_HOME=/usr/lib/hades-bdj/jre HOME=/var/lib/hades-bdj HADES_BDJ_NETWORK=internet
UMask=0077

# ready once the server has greeted the player, before it reads anything of the disc (READY=1,
# sd_notify). Not ready within TimeoutStartSec: systemd kills the whole instance (its cgroup) at
# once. SIGKILL, because the server is PID 1 of its own PID namespace (PrivatePIDs=) and does not
# see a SIGTERM before it has a handler for it; for the same reason a stop gives it 10 s. A server
# whose player goes away (Kodi ended, crashed or restarted) ends by itself within 5 s, whatever
# the disc's code does: with Accept=yes, systemd cannot see that.
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
TimeoutStartFailureMode=kill
TimeoutStopSec=10s
KillMode=control-group

# no privileges, no other users
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked
PrivateUsers=yes
RemoveIPC=yes
KeyringMode=private

# no other processes, a network to the Internet only, no devices, no shared memory with others
PrivatePIDs=yes
IPAddressDeny=::/0
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=127.0.0.0/8
IPAddressDeny=169.254.0.0/16
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.0.0.0/24
IPAddressDeny=192.0.2.0/24
IPAddressDeny=192.88.99.0/24
IPAddressDeny=192.168.0.0/16
IPAddressDeny=198.18.0.0/15
IPAddressDeny=198.51.100.0/24
IPAddressDeny=203.0.113.0/24
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes

# files: the image read only and nothing of the player's; code runs only from /usr
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=disconnected
TemporaryFileSystem=/storage:ro /flash:ro /var:ro /run:ro /media:ro
# of /run, systemd's notification socket alone, for READY=1 (the server opens it before its own
# filter, which then refuses any datagram socket of AF_UNIX, and closes it once ready)
BindReadOnlyPaths=/run/systemd/notify
BindPaths=/storage/.cache/hades-bdj/persistent:/var/lib/hades-bdj/persistent
InaccessiblePaths=-/sys/firmware
NoExecPaths=/ /tmp -/var/tmp -/dev/shm /var/lib/hades-bdj/persistent
ExecPaths=/usr
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

# a disc may not take the machine with it; the player is killed last
MemoryMax=1G
MemorySwapMax=0
TasksMax=256
LimitNOFILE=1024
LimitCORE=0
OOMScoreAdjust=500
# the longest a disc may stay open: a day. It cuts no real session (the longest films, a series
# disc played through, a disc paused overnight); a server stuck before it was ready, or whose
# player went away, ends long before (above)
RuntimeMaxSec=24h
