From f2406ceaf7ef124cb0972c5744a02bdc7f05aa45 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 01:38:36 +0000
Subject: [PATCH] Run the service add-on wrapper without a shell

LEAddonHook() built "/usr/sbin/service-addon-wrapper <context> <id> <path>"
in a 255-byte buffer and ran it with system(): the add-on id and path were
not quoted for the shell, and snprintf() silently truncated a long command.
Kodi's CUtil::Command() is not a replacement: it closes the standard
descriptors of the child and does not exit the child if exec fails.

Start the wrapper with posix_spawn() and an argument vector instead, wait
for it as system() did (retrying on EINTR), and log a failure to start it or
a non-zero exit status.
---
 xbmc/addons/Addon.cpp | 33 ++++++++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 5 deletions(-)

diff --git a/xbmc/addons/Addon.cpp b/xbmc/addons/Addon.cpp
index 8d8f901..1ae9920 100644
--- a/xbmc/addons/Addon.cpp
+++ b/xbmc/addons/Addon.cpp
@@ -33,6 +33,12 @@
 #include <dirent.h>
 #include <sys/stat.h>
 
+#include <cerrno>
+#include <spawn.h>
+#include <sys/wait.h>
+
+extern char** environ;
+
 #ifdef HAS_PYTHON
 #include "interfaces/python/XBPython.h"
 #endif
@@ -661,7 +667,6 @@ void LEAddonHook(const AddonPtr& addon, const LE_ADDON_CONTEXT context) {
 
   if (addon->Type() == AddonType::SERVICE) {
     std::string contextStr;
-    char cmd[255];
 
     switch (context) {
     case LE_ADDON_ENABLED:
@@ -681,10 +686,28 @@ void LEAddonHook(const AddonPtr& addon, const LE_ADDON_CONTEXT context) {
       break;
     }
 
-    snprintf(cmd, sizeof(cmd), "/usr/sbin/service-addon-wrapper %s %s %s",
-      contextStr.c_str(), addon->ID().c_str(), addon->Path().c_str());
-
-    system(cmd);
+    // Run the wrapper with its arguments and no shell: the add-on id and path were not quoted for
+    // one, and a fixed buffer truncated them. Wait for it, as system() did.
+    const std::string wrapper = "/usr/sbin/service-addon-wrapper";
+    const std::string id = addon->ID();
+    const std::string path = addon->Path();
+    char* const argv[] = {const_cast<char*>(wrapper.c_str()), const_cast<char*>(contextStr.c_str()),
+                          const_cast<char*>(id.c_str()), const_cast<char*>(path.c_str()), nullptr};
+    pid_t pid;
+    const int err = posix_spawn(&pid, wrapper.c_str(), nullptr, nullptr, argv, ::environ);
+    if (err != 0)
+    {
+      CLog::Log(LOGERROR, "LEAddonHook: cannot run {}: {}", wrapper, strerror(err));
+      return;
+    }
+    int status = 0;
+    pid_t ret;
+    do
+      ret = waitpid(pid, &status, 0);
+    while (ret < 0 && errno == EINTR);
+    if (ret < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
+      CLog::Log(LOGWARNING, "LEAddonHook: {} {} {} failed (status {})", wrapper, contextStr, id,
+                status);
   }
 }
 
