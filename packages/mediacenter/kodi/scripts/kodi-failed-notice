#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# When Kodi cannot start, say so on the screen. kodi.service starts Kodi again 2 s after it stops, for ever; the
# start shows the picture of the start (the console of the kernel stays off the screen until it has text to show),
# so a Kodi that stops at every start would leave that picture on the screen with nothing to say why. After the
# third stop in a row that came within a minute of its start and was not a clean exit, a notice in English and
# Spanish goes on the screen with what to do and the version of the system: the splash screen with the notice on a
# card under the name (packages/mediacenter/kodi/brand/notice, failed-on or failed-off as the diagnostics are on or
# off; the version written on it with the letters of notice/font-<height>), drawn by
# hades-picture on every display at its own size, as kodi-display-notice draws its notice; as text on the console
# (which then takes the screen whenever Kodi lets go of it), with the count and the version of the system, where the
# picture cannot be drawn. It is shown again after every such stop, and stays while Kodi tries again
# (kodi-display-notice leaves it). The journal has the count and the version in any case. A clean exit, or a Kodi
# that ran for a minute or more, starts the count again and takes the notice away: a normal start never shows it.
#   kodi-failed-notice start   (ExecStartPre: when Kodi starts)
#   kodi-failed-notice stop    (ExecStopPost: reads SERVICE_RESULT, EXIT_CODE and EXIT_STATUS from systemd)

TTY=/dev/tty1
SPLASH=/usr/share/splash/splash
NOTICE=/usr/lib/kodi/notice
STARTED=/run/kodi-failed-notice.start
COUNT=/run/kodi-failed-notice.count
SHOWN=/run/kodi-failed-notice.shown
QUICK=60
SHOW_AT=3

now() {
  awk '{ printf "%d\n", $1 }' /proc/uptime
}

if [ "$1" = "start" ]; then
  now >${STARTED}
  exit 0
fi

[ "$1" = "stop" ] || exit 0

ran=""
if [ -f ${STARTED} ]; then
  ran=$(($(now) - $(cat ${STARTED} 2>/dev/null || echo 0)))
fi
if [ "${SERVICE_RESULT:-success}" = "success" ] || [ -z "${ran}" ] || [ ${ran} -ge ${QUICK} ]; then
  rm -f ${COUNT}
  # the notice of before goes: from the frame buffer where it was drawn there (a picture held on the displays was let
  # go of when Kodi started, and Kodi has shown its own since; "kodi-display-notice clear", next, wipes the console)
  if [ -f ${SHOWN} ]; then
    [ "$(cat ${SHOWN} 2>/dev/null)" = "fb" ] && cat /dev/zero >/dev/fb0 2>/dev/null
    rm -f ${SHOWN}
    echo "kodi-failed-notice: Kodi ran, the notice that it could not start is taken away"
  fi
  exit 0
fi

n=$(($(cat ${COUNT} 2>/dev/null || echo 0) + 1))
echo ${n} >${COUNT}
. /etc/os-release
echo "kodi-failed-notice: Kodi stopped ${ran} s after it started (${SERVICE_RESULT}, ${EXIT_CODE:-?} ${EXIT_STATUS:-?}): ${n} time(s) in a row; ${PRETTY_NAME}"
[ ${n} -ge ${SHOW_AT} ] || exit 0

if ls /flash 2>/dev/null | grep -qi '^diag-on'; then
  card=failed-on
  en="The diagnostics are on: they are saved in the folder hades-diag of the boot partition (LIBREELEC)."
  es="El diagnóstico está activado: se guarda en la carpeta hades-diag de la partición de arranque (LIBREELEC)."
else
  card=failed-off
  en="To keep what happened for a report, turn on the diagnostics: on the boot partition (LIBREELEC), rename
    DIAG-OFF.TXT to DIAG-ON.TXT and start again."
  es="Para guardar lo ocurrido para un informe, activa el diagnóstico: en la partición de arranque (LIBREELEC),
    cambia el nombre de DIAG-OFF.TXT a DIAG-ON.TXT y vuelve a arrancar."
fi

# on every display at its own size, or in the console's frame buffer (hades-picture: kodi-display-notice says how),
# with the version of the system written on the card, as the text has it
said="$(hades-picture show fit kodi ${SPLASH} ${NOTICE}/${card} "text=${PRETTY_NAME}" 2>&1)"
r=$?
if [ ${r} != 0 ]; then
  said="${said}; then $(hades-picture fb fit ${SPLASH} ${NOTICE}/${card} "text=${PRETTY_NAME}" 2>&1)"
  case "${said##*; then }" in ok*) r=0 ;; esac
fi
if [ ${r} = 0 ]; then
  case "${said##*; then }" in
    "ok kms"*) echo kms >${SHOWN} ;;
    *) echo fb >${SHOWN} ;;
  esac
  echo "kodi-failed-notice: the notice is on the screen (${card}): ${said}"
  exit 0
fi
echo "kodi-failed-notice: ${said}"

{
  printf '\033[2J\033[H\n\n'
  printf '    LibreELEC Hades could not start its interface (Kodi). It stopped %s times in a row,\n' "${n}"
  printf '    and it keeps trying.\n'
  printf '    %s\n' "${en}"
  printf '    Kodi log: /storage/.kodi/temp/kodi.log\n\n'
  printf '    LibreELEC Hades no ha podido iniciar su interfaz (Kodi). Se ha detenido %s veces seguidas,\n' "${n}"
  printf '    y lo sigue intentando.\n'
  printf '    %s\n' "${es}"
  printf '    Registro de Kodi: /storage/.kodi/temp/kodi.log\n\n'
  printf '    %s\n' "${PRETTY_NAME}"
} >${TTY} 2>/dev/null
echo text >${SHOWN}
echo "kodi-failed-notice: the notice is on the console"

exit 0
