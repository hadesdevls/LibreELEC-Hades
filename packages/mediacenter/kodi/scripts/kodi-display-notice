#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# Kodi shows on one display (an HDMI output, normally the TV, when several are connected) and
# turns the other outputs off a few seconds after it starts. Before Kodi starts, say so on the
# console, which every connected display shows. "clear" wipes the notice again.

TTY=/dev/tty1

if [ "$1" = "clear" ]; then
  printf '\033[2J\033[H' >${TTY} 2>/dev/null
  exit 0
fi

# Kodi can start before the boot GPU's DRM driver has registered its outputs (Kodi waits for it on
# its own). Wait for that driver too, at most 10 s, so that its displays are counted.
waited=0
for vga in /sys/bus/pci/devices/*/boot_vga; do
  [ "$(cat "${vga}" 2>/dev/null)" = "1" ] || continue
  gpu=${vga%/boot_vga}
  while [ ${waited} -lt 40 ] && ! ls -d "${gpu}"/drm/card* >/dev/null 2>&1; do
    usleep 250000
    waited=$((waited + 1))
  done
done

connected=0
for status in /sys/class/drm/card*-*/status; do
  [ "$(cat "${status}" 2>/dev/null)" = "connected" ] && connected=$((connected + 1))
done
echo "kodi-display-notice: ${connected} connected display(s); waited $((waited / 4)) s for the boot GPU"
[ ${connected} -ge 2 ] || exit 0

{
  printf '\033[?25l\033[2J\033[H\n\n\n'
  printf '    Hades usa una sola pantalla: normalmente la TV conectada por HDMI.\n'
  printf '    Las demás pantallas se apagarán en unos segundos.\n\n'
  printf '    Hades uses a single display: normally the TV connected over HDMI.\n'
  printf '    The other displays will turn off in a few seconds.\n'
} >${TTY} 2>/dev/null

exit 0
