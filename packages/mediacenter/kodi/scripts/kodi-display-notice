#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026-present Hades

# Kodi shows on one display (an HDMI output, normally the TV, when several are connected) and
# turns the other outputs off a few seconds after it starts. Before Kodi starts, say so on every
# connected display: the splash screen of the start with the notice on a card under the name
# (packages/mediacenter/kodi/brand/notice), so that only the card appears. hades-picture draws it
# on each display at the size of that display, in the mode it has, where they differ (the console's
# frame buffer has the size of the smallest: a picture there sits small in the upper left corner of
# the others), and keeps it there until Kodi shows its own; else into that frame buffer. As text
# where neither can be done. "clear" wipes the notice again.

TTY=/dev/tty1
SPLASH=/usr/share/splash/splash
NOTICE=/usr/lib/kodi/notice
DRAWN=/run/kodi-display-notice.drawn
FAILED=/run/kodi-failed-notice.shown

if [ "$1" = "clear" ]; then
  # (the notice that Kodi cannot start is on the screen instead: kodi-failed-notice keeps it)
  [ -f ${FAILED} ] && exit 0
  # a notice still held on the displays (Kodi stopped before it took them) goes back to the console
  said="$(hades-picture stop 2>&1)"
  case "${said}" in
    "ok nothing is held"*) ;;
    *) echo "kodi-display-notice: ${said}" ;;
  esac
  printf '\033[2J\033[H' >${TTY} 2>/dev/null
  # The picture stays in the frame buffer, which the screen shows again whenever Kodi lets go of the display
  # (at its stop, and before it starts again). The console is not on that frame buffer until text is written
  # to it (the kernel's FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER), so the line above does not reach the picture:
  # the frame buffer is made black, as the console was. Only where the notice was drawn into it.
  if [ -f ${DRAWN} ]; then
    cat /dev/zero >/dev/fb0 2>/dev/null
    rm -f ${DRAWN}
    echo "kodi-display-notice: the notice cleared from the frame buffer"
  fi
  exit 0
fi

# Kodi can start before the boot GPU's DRM driver has registered its outputs (Kodi waits for it on
# its own). Wait for that driver too, at most 10 s, so that its displays are counted.
waited=0
for vga in /sys/bus/pci/devices/*/boot_vga; do
  [ "$(cat "${vga}" 2>/dev/null)" = "1" ] || continue
  gpu=${vga%/boot_vga}
  while [ ${waited} -lt 40 ] && ! ls -d "${gpu}"/drm/card* >/dev/null 2>&1; do
    usleep 250000
    waited=$((waited + 1))
  done
done

connected=0
for status in /sys/class/drm/card*-*/status; do
  [ "$(cat "${status}" 2>/dev/null)" = "connected" ] && connected=$((connected + 1))
done
echo "kodi-display-notice: ${connected} connected display(s); waited $((waited / 4)) s for the boot GPU"
[ ${connected} -ge 2 ] || exit 0

if [ -f ${FAILED} ]; then
  echo "kodi-display-notice: the notice that Kodi could not start stays on the screen"
  exit 0
fi

# each display its own picture (held until Kodi shows its own), or the console's frame buffer where they all show it
# at its full size; then the frame buffer at its size, as before (the picture of its height, or of 1080 lines)
said="$(hades-picture show fit kodi ${SPLASH} ${NOTICE}/display 2>&1)"
r=$?
if [ ${r} != 0 ]; then
  said="${said}; then $(hades-picture fb fit ${SPLASH} ${NOTICE}/display 2>&1)"
  case "${said##*; then }" in ok*) r=0 ;; esac
fi
if [ ${r} = 0 ]; then
  case "${said##*; then }" in
    "ok kms"*) ;;
    *) : >${DRAWN} ;;
  esac
  echo "kodi-display-notice: the notice drawn: ${said}"
  exit 0
fi
echo "kodi-display-notice: ${said}"

{
  printf '\033[?25l\033[2J\033[H'
  printf '\n\n\n'
  printf '    LibreELEC Hades shows on one display: normally the TV connected over HDMI.\n'
  printf '    The other displays turn off in a few seconds.\n\n'
  printf '    LibreELEC Hades se muestra en una sola pantalla: normalmente la TV conectada por HDMI.\n'
  printf '    Las demás pantallas se apagan en unos segundos.\n'
} >${TTY} 2>/dev/null
echo "kodi-display-notice: the notice written as text"

exit 0
