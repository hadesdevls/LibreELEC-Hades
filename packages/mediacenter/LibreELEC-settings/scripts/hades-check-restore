# Before Kodi starts: puts the sound settings that "Check this setup" changed for a moment back into
# guisettings.xml, when Kodi stopped while its sounds played (a crash, a power cut, a restart). The check
# writes what the settings must be into /storage/.cache/hades-check/restore.json before it changes
# anything, and removes it once they are set; hades-check-restore.service runs this only while that file
# is there. The work is hades_check.restore_guisettings() of the LibreELEC settings add-on, which its host
# tests take apart.

import os
import sys

sys.path.insert(0, '/usr/share/kodi/addons/service.libreelec.settings/resources/lib')

import hades_check  # noqa: E402

journal = os.path.join(hades_check.STATE_DIR, hades_check.JOURNAL_NAME)
try:
    done = hades_check.restore_guisettings(journal)
except OSError as e:
    print(f'hades-check-restore: the settings could not be put back, tried again at the next start: {e}')
    sys.exit(1)
if done:
    print('hades-check-restore: put back ' + ', '.join(f'{k}={"true" if v else "false"}' for k, v in sorted(done.items())))
else:
    print('hades-check-restore: nothing to put back')
