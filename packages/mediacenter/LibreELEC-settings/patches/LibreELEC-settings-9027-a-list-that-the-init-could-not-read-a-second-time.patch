From 124d3ad95a93583d947fe8cf6aae59736919017e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:36:22 +0000
Subject: [PATCH] system: a list that the init could not read a second time is
 one that could not be read

Where the init read the list at the first look and not at the second, it now
keeps every internal disk away, as for a list that cannot be read, and leaves
"again unread". At the start of Kodi and in the list that start is now one with
a list that could not be read (33162, and the offer of 33155), as
internal-disk-choice says it; before, it was taken as held.
---
 resources/lib/modules/system.py | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 6b9f47a..4d96f47 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -1601,11 +1601,12 @@ MaxRetentionSec=0
         return ', '.join(p.strip() for p in parts if p.strip())
 
     def internal_disks_left(self):
-        '''What the init left of what it did in this start with the list: "chosen" or "damaged" (or None), and
-        how it went (as INTERNAL_DISK_CHOICE says it in "list"): "unsafe" where nothing was let go of, since the
-        disk of this system could not be told; "open" where one that was to be kept away is still attached (in
-        both, no internal partition is mounted in this start); "held" where what went is held by the kernel
-        (the switch set and the kernel locked down); else "loose".'''
+        '''What the init left of what it did in this start with the list: "chosen" or "damaged" ("damaged" also
+        where the list was read at the first look and not at the second, after which every disk was kept away),
+        or None; and how it went (as INTERNAL_DISK_CHOICE says it in "list"): "unsafe" where nothing was let go
+        of, since the disk of this system could not be told; "open" where one that was to be kept away is still
+        attached (in both, no internal partition is mounted in this start); "held" where what went is held by
+        the kernel (the switch set and the kernel locked down); else "loose".'''
         try:
             with open(self.INTERNAL_DISK_LEFT, 'r', errors='replace') as f:
                 lines = f.read(65536).splitlines()
@@ -1614,6 +1615,8 @@ MaxRetentionSec=0
         state = lines[0].split(' ')[1] if lines and lines[0].startswith('state ') else None
         if state not in ('chosen', 'damaged'):
             return None, None
+        if 'again unread' in lines:
+            state = 'damaged'
         if 'system unknown' in lines:
             return state, 'unsafe'
         if any(line.startswith('stayed ') for line in lines):
-- 
2.53.0

