+msgstr ""
+
+msgctxt "#34119"
+msgid "The list of devices could not be read. Wake from sleep still holds as it is."
+msgstr ""
+
+msgctxt "#34120"
+msgid "No input device of this computer can wake it: none offers it, or none is paired."
+msgstr ""
