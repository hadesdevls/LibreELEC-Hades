+# Hades: the list of devices of "Wake from sleep" (hades-wake): one line each device that the user ticked or unticked,
+# "on usb 046d:c52b", "off usb 046d:c077 port=3-2", "on bt AA:BB:CC:DD:EE:FF". hades-wake reads it at each start, for
+# each device plugged in and before and after each sleep.
+WAKE_KEY = re.compile(r'(usb [0-9a-f]{4}:[0-9a-f]{4}( (serial|port)=[A-Za-z0-9._-]+)?|bt [0-9A-F]{2}(:[0-9A-F]{2}){5})')
+
+
+def wake_device_lines(path):
+    '''The lines of the list that hades-wake understands, as (on or off, key), in their order.'''
+    out = []
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            for line in f:
+                words = line.split(None, 1)
+                if len(words) == 2 and words[0] in ('on', 'off') and WAKE_KEY.fullmatch(words[1].strip()):
+                    out.append((words[0], words[1].strip()))
+    except OSError:
+        pass
+    return out
+
+
+def write_wake_devices(path, changes):
+    '''The list with changes ({key: 'on' or 'off'}) put in: the line of a changed key goes to the end, the others
+    stay as they were. Written beside the file and renamed over it, then read back; no file where nothing is left.
+    Raises OSError when what it says is not what was asked for.'''
+    lines = [(state, key) for state, key in wake_device_lines(path) if key not in changes]
+    lines += [(state, key) for key, state in changes.items()]
+    folder = os.path.dirname(path)
+    if not lines:
+        if os.path.islink(path) or os.path.isfile(path):
+            os.remove(path)
+    else:
+        os.makedirs(folder, exist_ok=True)
+        fd, part = tempfile.mkstemp(prefix='.hades-wake-devices.', dir=folder)
+        try:
+            with os.fdopen(fd, 'w', encoding='utf-8') as out:
+                out.write(''.join(f'{state} {key}\n' for state, key in lines))
+                out.flush()
+                os.fsync(out.fileno())
+            os.chmod(part, 0o644)
+            os.replace(part, path)
+        except BaseException:
+            try:
+                os.remove(part)
+            except OSError:
+                pass
+            raise
+    if wake_device_lines(path) != lines:
+        raise OSError(f'{path} does not say what was chosen')
+
+
+def parse_wake_list(text):
+    '''What "wake.sh list" printed, as dicts (kind usb or bt, key, state, cls, name, why, choice), the devices that can
+    wake a computer only (a USB device without power/wakeup cannot), and how many could not.'''
+    devices, cannot = [], 0
+    for line in text.splitlines():
+        f = line.split('|')
+        if len(f) != 7 or f[0] not in ('usb', 'bt'):
+            continue
+        key = f'{f[0]} {f[1]}'
+        if not WAKE_KEY.fullmatch(key):
+            continue
+        if f[2] not in ('enabled', 'disabled'):
+            cannot += 1
+            continue
+        devices.append({'kind': f[0], 'key': key, 'state': f[2], 'cls': f[3], 'name': f[4], 'why': f[5],
+                        'choice': f[6]})
+    return devices, cannot
+
+
+def wake_device_name(device):
+    '''A plain name: the make and model of a USB device ("USB <port> <IDs>" left out), the name of a Bluetooth
+    device, or its address where it has none.'''
+    words = device['name'].split()
+    if device['kind'] == 'usb':
+        rest = ' '.join(words[3:])
+        return rest or words[2] if len(words) > 2 else device['name']
+    rest = ' '.join(words[2:])
+    return rest or (words[1] if len(words) > 1 else device['name'])
+
