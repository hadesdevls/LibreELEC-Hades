+    # Hades: "Devices that may wake it": the input devices that can wake a computer, USB and Bluetooth, each ticked
+    # where it may wake it at the next sleep. What is ticked or unticked here goes into the list (WAKE_DEVICES) and is
+    # applied at once; a device left as it was keeps its line, or none.
+    WAKE_KINDS = {'remote': 34112, 'keyboard': 34113, 'kbmouse': 34114, 'pointer': 34115, 'gamepad': 34116,
+                  'other': 34117}
+
+    def wake_list(self):
+        '''hades-wake's list of the input devices, parsed; None where it could not run.'''
+        try:
+            done = subprocess.run(['/bin/sh', self.WAKE_HELPER, 'list'], stdin=subprocess.DEVNULL,
+                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60,
+                                  env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+        except (OSError, subprocess.SubprocessError) as e:
+            log.log(f'hades-wake list: {e!r}', log.ERROR)
+            return None
+        if done.returncode != 0:
+            log.log(f'hades-wake list: exit status {done.returncode}', log.ERROR)
+            return None
+        return parse_wake_list(done.stdout.decode(errors='replace'))
+
+    def wake_label(self, device):
+        bus = 'Bluetooth' if device['kind'] == 'bt' else 'USB'
+        return f'{wake_device_name(device)} ({oe._(self.WAKE_KINDS.get(device["cls"], 34117))}, {bus})'
+
+    @log.log_function()
+    def set_wake_devices(self, listItem=None):
+        if not self.WAKE_CHOICE or not self.WAKE_DEVICES or not self.WAKE_HELPER or not os.path.exists(self.WAKE_HELPER):
+            return
+        title = oe._(34109)
+        if wake_choice(self.WAKE_CHOICE) == 'button':
+            xbmcDialog.ok(title, oe._(34118))
+            return
+        found = self.wake_list()
+        if found is None:
+            xbmcDialog.ok(title, oe._(34119))
+            return
+        devices, cannot = found
+        log.log(f'hades-wake list: {len(devices)} input device(s) that can wake a computer, {cannot} that cannot', log.INFO)
+        if not devices:
+            xbmcDialog.ok(title, oe._(34120))
+            return
+        ticked = [i for i, d in enumerate(devices) if d['state'] == 'enabled']
+        chosen = xbmcDialog.multiselect(title, [self.wake_label(d) for d in devices], preselect=ticked)
+        if chosen is None:
+            return
+        changes = {}
+        for i, d in enumerate(devices):
+            want = 'on' if i in chosen else 'off'
+            if (i in ticked) != (i in chosen):
+                changes[d['key']] = want
+        if not changes:
+            return
+        try:
+            write_wake_devices(self.WAKE_DEVICES, changes)
+        except OSError as e:
+            log.log(f'{self.WAKE_DEVICES}: the list of devices was not kept: {e!r}', log.ERROR)
+            xbmcDialog.ok(title, oe._(34107))
+            return
+        for key, state in changes.items():
+            log.log(f'{self.WAKE_DEVICES}: {state} {key}', log.INFO)
+        armed = self.apply_wake()
+        if armed is None:
+            xbmcDialog.ok(title, oe._(34108))
+        else:
+            oe.notify(title, oe._(34106) % armed)
+
