+++ b/resources/lib/modules/display.py
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+# Hades: "Your display", a page of the wizard of the first start (after the network and the services, before the
+# end): what Hades found of the display, and the two things it cannot read (a projector and its peak; how HDR videos
+# go out), each a button that asks and sets (hades_display_ui.py). Going on without pressing them changes nothing.
+# The same questions are in System > Check this setup > Your display, for later. No entry of its own in the menu.
+
+import log
+import oe
+
+
+class display:
+
+    ENABLED = True
+    menu = {}
+
+    @log.log_function()
+    def __init__(self, oeMain):
+        super().__init__()
+        self.step = None
+        self.notes = []
+
+    @log.log_function()
+    def exit(self):
+        self.step = None
+
+    @log.log_function()
+    def do_wizard(self):
+        import hades_display_ui
+        self.step = hades_display_ui.DisplayStep()
+        self.notes = []
+        self.show()
+
+    def show(self):
+        S = __import__('hades_display_ui').S
+        oe.winOeMain.set_wizard_title(oe._(S['display']))
+        oe.winOeMain.set_wizard_text('[CR][CR]'.join([oe._(S['intro'])] + self.step.found_text() + self.notes))
+        oe.winOeMain.set_wizard_button_title(oe._(33917))
+        oe.winOeMain.set_wizard_button_1(self.step.kind_label(), self, 'wizard_kind')
+        if self.step.takes_hdr():
+            oe.winOeMain.set_wizard_button_2(self.step.hdr_label(), self, 'wizard_hdr')
+
+    @log.log_function()
+    def wizard_kind(self):
+        self.notes = self.step.choose_kind()
+        self.show()
+
+    @log.log_function()
+    def wizard_hdr(self):
+        self.notes = self.step.choose_hdr()
+        self.show()
