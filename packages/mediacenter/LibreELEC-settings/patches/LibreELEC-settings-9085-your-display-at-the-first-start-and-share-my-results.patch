diff --git a/resources/lib/hades_display.py b/resources/lib/hades_display.py
new file mode 100644
index 0000000..8a4232a
--- /dev/null
+++ b/resources/lib/hades_display.py
@@ -0,0 +1,447 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+'''"Your display" (the first start, and System > Check this setup) and "Share my results": what they decide, apart
+from Kodi.
+
+Hades sets the picture for a display by itself from what its EDID declares. "Your display" asks only what no EDID
+says: whether the display is a projector and how bright it is, and whether HDR videos should go out as HDR; and it
+says where the TV's remote reaches the PC over HDMI-CEC. "Share my results" makes one line of this PC, its display
+and the results of the last "Check this setup", to paste in the forum or in an issue: names of hardware and results
+only, never a serial number, an address of the network, a name of a network or of the PC.
+
+Nothing here imports Kodi's modules, so that the host tests can take it apart.
+'''
+
+import fcntl
+import glob
+import json
+import os
+import re
+import struct
+import tempfile
+
+import hades_check as hc
+
+STATE_DIR = '/storage/.cache/hades-display'
+JOURNAL_NAME = 'changed.json'
+SHARE_NAME = 'share.txt'
+KODI_LOG = '/storage/.kodi/temp/kodi.log'
+
+# ---- what an EDID says (the base block and its CTA-861 extensions)
+
+
+def cta_blocks(edid):
+    '''The data blocks of the CTA-861 extensions of an EDID: [(tag, payload)], payload without its header byte; for
+    tag 7 (extended) the extended tag is the first byte of the payload. Nothing is read past an extension.'''
+    blocks = []
+    for b in range(128, len(edid) - 127, 128):
+        e = edid[b:b + 128]
+        if e[0] != 0x02:
+            continue
+        end = e[2]
+        i = 4
+        while i < end and i < 128:
+            tag, length = e[i] >> 5, e[i] & 31
+            blocks.append((tag, bytes(e[i + 1:min(i + 1 + length, 127)])))
+            i += 1 + length
+    return blocks
+
+
+def edid_facts(edid):
+    '''What an EDID says that "Your display" and the line to share need: its name (hc.edid_name(): no serial
+    number), the HDR it takes (HDR10, HLG, from its HDR static metadata block), its Dolby Vision block (its version,
+    -1 without), its HDMI address and how many devices are between the PC and the display (-1: not known; as
+    EdidHdmiPath.h of Kodi reads it), and the sound formats it declares.'''
+    facts = {'name': hc.edid_name(edid), 'hdr': [], 'dv': -1, 'address': '', 'between': -1, 'audio': []}
+    codes = set()
+    pcm = 0
+    address = None
+    for tag, p in cta_blocks(edid):
+        if tag == 7 and len(p) >= 3 and p[0] == 6:
+            if p[1] & 0x04:
+                facts['hdr'].append('HDR10')
+            if p[1] & 0x08:
+                facts['hdr'].append('HLG')
+        elif tag == 7 and len(p) >= 5 and p[0] == 1 and p[1:4] == b'\x46\xd0\x00' and facts['dv'] < 0:
+            # (the Dolby VSVDB: its version in the top three bits of the byte after the OUI)
+            facts['dv'] = p[4] >> 5
+        elif tag == 1:
+            for k in range(0, len(p) - 2, 3):
+                code = (p[k] >> 3) & 15
+                codes.add(code)
+                if code == 1:
+                    pcm = max(pcm, (p[k] & 7) + 1)
+        elif tag == 3 and len(p) >= 5 and p[0:3] == b'\x03\x0c\x00' and address is None:
+            address = (p[3] << 8) | p[4]
+    # the formats by the names Kodi's page gives them (EdidHdmiPath::AudioText())
+    for code, name in ((12, 'TrueHD'), (10, 'DD+'), (11, 'DTS-HD'), (7, 'DTS'), (2, 'AC-3')):
+        if code in codes:
+            facts['audio'].append(name)
+    if 1 in codes and pcm:
+        facts['audio'].append(f'PCM {pcm} ch')
+    if address is not None and address != 0xFFFF:
+        nibbles = [(address >> s) & 15 for s in (12, 8, 4, 0)]
+        facts['address'] = '.'.join(f'{n:x}' for n in nibbles)
+        depth = 0
+        while depth < 4 and nibbles[depth]:
+            depth += 1
+        # (an address that says where the PC is: not 0.0.0.0, nothing after its first 0)
+        valid = depth > 0 and not any(nibbles[depth:])
+        facts['between'] = depth - 1 if valid else -1
+    return facts
+
+
+def connected_displays(root='/sys/class/drm'):
+    '''The displays connected now: [(connector, facts, enabled)], the connector as DRM names it (HDMI-A-1); enabled:
+    the output has a mode (the picture goes out there).'''
+    found = []
+    for status in sorted(glob.glob(os.path.join(root, 'card*-*', 'status'))):
+        folder = os.path.dirname(status)
+        try:
+            with open(status, encoding='utf-8', errors='replace') as f:
+                if f.read().strip() != 'connected':
+                    continue
+            with open(os.path.join(folder, 'edid'), 'rb') as f:
+                edid = f.read()
+        except OSError:
+            continue
+        facts = edid_facts(edid)
+        if not facts['name']:
+            continue
+        try:
+            with open(os.path.join(folder, 'enabled'), encoding='utf-8', errors='replace') as f:
+                enabled = f.read().strip() == 'enabled'
+        except OSError:
+            enabled = False
+        found.append((os.path.basename(folder).split('-', 1)[-1], facts, enabled))
+    return found
+
+
+# ---- HDMI-CEC: where the TV's remote reaches the PC
+
+# CEC_ADAP_G_CAPS: _IOWR('a', 0, struct cec_caps), the struct of 32 + 32 bytes and three u32 (linux/cec.h)
+CEC_CAPS = struct.Struct('32s32sIII')
+CEC_ADAP_G_CAPS = (3 << 30) | (CEC_CAPS.size << 16) | (ord('a') << 8) | 0
+# Pulse-Eight's USB-CEC adapters (libcec: 2548:1001 and 2548:1002)
+PULSE_EIGHT = ('2548:1001', '2548:1002')
+
+
+def cec_name(device, ioctl=fcntl.ioctl):
+    '''The name that the kernel gives a CEC adapter (for one on a DisplayPort or HDMI output of a graphics card: the
+    name of that output, as DRM has it, DP-2), from CEC_ADAP_G_CAPS; '' where it cannot be read. Opened without being
+    its follower or initiator: nothing is sent, and libCEC, which has it open, is not disturbed.'''
+    try:
+        fd = os.open(device, os.O_RDONLY | os.O_NONBLOCK)
+    except OSError:
+        return ''
+    try:
+        buf = bytearray(CEC_CAPS.size)
+        ioctl(fd, CEC_ADAP_G_CAPS, buf, True)
+        driver, name, _, _, _ = CEC_CAPS.unpack(bytes(buf))
+        return name.split(b'\0', 1)[0].decode('ascii', 'replace').strip()
+    except OSError:
+        return ''
+    finally:
+        os.close(fd)
+
+
+def cec_adapters(dev='/dev', usb='/sys/bus/usb/devices', ioctl=fcntl.ioctl):
+    '''The CEC adapters of this PC: [('output', name)] for each one of the kernel (/dev/cec*), name the output it is
+    on where the kernel says it, and [('usb', 'Pulse-Eight')] for each USB adapter of Pulse-Eight.'''
+    found = []
+    for device in sorted(glob.glob(os.path.join(dev, 'cec[0-9]*'))):
+        found.append(('output', cec_name(device, ioctl)))
+    for folder in sorted(glob.glob(os.path.join(usb, '*'))):
+        try:
+            with open(os.path.join(folder, 'idVendor')) as v, open(os.path.join(folder, 'idProduct')) as p:
+                ids = f'{v.read().strip()}:{p.read().strip()}'
+        except OSError:
+            continue
+        if ids in PULSE_EIGHT:
+            found.append(('usb', 'Pulse-Eight'))
+    return found
+
+
+def cec_verdict(adapters, picture):
+    '''Where the TV's remote reaches the PC: ('same', output) where an adapter is on an output that the picture goes
+    out on; ('usb', '') with a USB adapter (it is in the cable of the picture by how it is plugged in); ('other',
+    output) where the adapters are on other outputs; ('none', '') without any. picture: the outputs with a mode.'''
+    outputs = [name for kind, name in adapters if kind == 'output']
+    for name in outputs:
+        if name and name in picture:
+            return ('same', name)
+    if any(kind == 'usb' for kind, _ in adapters):
+        return ('usb', '')
+    if outputs:
+        return ('other', next((n for n in outputs if n), '?'))
+    return ('none', '')
+
+
+# ---- what the choices set (settings of Kodi, as JSON-RPC names them)
+
+KINDS = ('tv', 'projector', 'monitor')
+PEAKS = (50, 75, 100, 150, 200, 300)
+PEAK_UNKNOWN = 100
+HDR_CHOICES = ('hdr', 'hlg_sdr', 'all_sdr')
+
+SDR_TARGET = 'videoscreen.hadesdvsdrtarget'      # 2: a projector (white at 100 cd/m2)
+DV_HDR10_MAP = 'videoscreen.hadesdvhdr10map'      # 1: to this display
+DV_HDR10_PEAK = 'videoscreen.hadesdvhdr10peak'    # cd/m2, 40 to 4000 in steps of 10
+HDR10_ADAPT = 'videoscreen.hadeshdr10adapt'       # 2: automatic, only the videos brighter than the display
+HDR_AS_SDR = 'videoscreen.hadeshdrassdr'          # 0 never, 1 HLG, 2 HLG, HDR10 and HDR10+
+HDR_DISPLAY = 'winsystem.ishdrdisplay'            # Kodi's "Adjust display HDR mode"
+DV_NATIVE = 'videoscreen.hadesdvnative'
+# what the step may change, and of which type: nothing else is ever written
+STEP_TYPES = {SDR_TARGET: int, DV_HDR10_MAP: int, DV_HDR10_PEAK: int, HDR10_ADAPT: int, HDR_AS_SDR: int,
+              HDR_DISPLAY: bool, DV_NATIVE: bool}
+
+
+def projector_changes(peak, facts):
+    '''What a projector of that peak sets, by what its EDID declares (docs/settings.md, "For projectors"): with
+    HDR10 and no Dolby Vision, Hades maps Dolby Vision to it and adapts the HDR10 videos brighter than it (its own
+    dynamic tone mapping for HDR10 is then to be turned off); a projector that takes Dolby Vision maps it itself, and
+    nothing of Dolby Vision is set; every projector gets the SDR made for its white (100 cd/m2) for HDR shown as
+    SDR. Returns (settings, note): note 'hdr10', 'dv' or 'sdr'.'''
+    peak = min(4000, max(40, int(round(peak / 10.0)) * 10))
+    changes = {SDR_TARGET: 2}
+    if facts.get('dv', -1) >= 0:
+        return changes, 'dv'
+    if 'HDR10' in facts.get('hdr', []):
+        changes.update({DV_HDR10_MAP: 1, DV_HDR10_PEAK: peak, HDR10_ADAPT: 2})
+        return changes, 'hdr10'
+    return changes, 'sdr'
+
+
+def hdr_changes(choice):
+    '''What a choice of how HDR videos go out sets: as HDR (Kodi's and Hades' defaults), HLG as SDR, or every video as
+    SDR, Dolby Vision too ("Adjust display HDR mode" and "Native Dolby Vision output" off: docs/settings.md).'''
+    if choice == 'hlg_sdr':
+        return {HDR_DISPLAY: True, HDR_AS_SDR: 1}
+    if choice == 'all_sdr':
+        return {HDR_DISPLAY: False, DV_NATIVE: False}
+    return {}
+
+
+def journal_path(state_dir=STATE_DIR):
+    return os.path.join(state_dir, JOURNAL_NAME)
+
+
+def read_journal(path):
+    '''What the settings were before the step changed them ({setting: value}, {} when it changed nothing), only the
+    settings it may change with values of their type.'''
+    try:
+        with open(path, encoding='utf-8') as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return {}
+    if not isinstance(data, dict) or data.get('version') != 1 or not isinstance(data.get('before'), dict):
+        return {}
+    return {k: v for k, v in data['before'].items() if k in STEP_TYPES and type(v) is STEP_TYPES[k]}
+
+
+def write_journal(path, before):
+    folder = os.path.dirname(path)
+    os.makedirs(folder, exist_ok=True)
+    fd, part = tempfile.mkstemp(prefix='.changed.', dir=folder)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as out:
+            json.dump({'version': 1, 'before': before}, out, sort_keys=True)
+            out.write('\n')
+            out.flush()
+            os.fsync(out.fileno())
+        os.replace(part, path)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+
+
+def plan(current, journal, kind_changes, hdr):
+    '''What to set, from the settings as they are now (current: setting -> value, None where JSON-RPC does not
+    answer), what the step set before (journal: their values before that) and the changes of the choices now.
+
+    The settings that the step had changed and that the choices no longer change go back to their values before it;
+    the others take the values of the choices. Returns (to_set, journal after): to_set in an order that never sends
+    HDR as SDR and as HDR at once (the settings that go back first), and the journal with the value before the step
+    of every setting the choices change now.'''
+    wanted = dict(kind_changes)
+    wanted.update(hdr)
+    to_set = {}
+    after = {}
+    for key, value in journal.items():
+        if key not in wanted and current.get(key) is not None and current.get(key) != value:
+            to_set[key] = value
+    for key, value in wanted.items():
+        if current.get(key) is None:
+            continue
+        after[key] = journal.get(key, current[key])
+        if current[key] != value:
+            to_set[key] = value
+    return to_set, after
+
+
+# ---- the line to share
+
+
+def os_release(path='/etc/os-release'):
+    values = {}
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            for line in f:
+                key, sep, value = line.strip().partition('=')
+                if sep:
+                    values[key] = value.strip('"')
+    except OSError:
+        pass
+    return values
+
+
+def cpu_model(path='/proc/cpuinfo'):
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            for line in f:
+                if line.startswith('model name'):
+                    return re.sub(r'\s+', ' ', line.split(':', 1)[1]).strip()
+    except OSError:
+        pass
+    return ''
+
+
+def gpu_of_log(path=KODI_LOG, limit=4000):
+    '''The GPU and its driver as Kodi names them at its start (GL_RENDERER and GL_VERSION of kodi.log): "AMD Radeon
+    Graphics (radeonsi, raphael_mendocino)" and "Mesa 26.0.1", the versions of LLVM, DRM and the kernel left out
+    (as DVPathGpu() of Kodi); ('', '') where kodi.log does not say.'''
+    renderer = version = ''
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            for n, line in enumerate(f):
+                if n >= limit:
+                    break
+                m = re.search(r'GL_RENDERER = (.*)$', line)
+                if m and not renderer:
+                    renderer = m.group(1).strip()
+                m = re.search(r'GL_VERSION = (.*)$', line)
+                if m and not version:
+                    version = m.group(1).strip()
+                if renderer and version:
+                    break
+    except OSError:
+        pass
+    m = re.match(r'(.*)\(([^()]*)\)(.*)$', renderer)
+    if m:
+        keep = [i.strip() for i in m.group(2).split(',')
+                if i.strip() and not re.match(r'(\d+\.|(LLVM|DRM|ACO) \d)', i.strip())]
+        renderer = f'{m.group(1)}({", ".join(keep)}){m.group(3)}'
+    # "OpenGL ES 3.2 Mesa 26.0.1", "OpenGL ES 3.2 NVIDIA 620.73.04": the driver and its version
+    m = re.search(r'((?:Mesa|NVIDIA) [0-9][0-9A-Za-z.\-]*)', version)
+    return renderer, (m.group(1) if m else '')
+
+
+# the short words of each result, from the facts of summary.txt / last.json (hades_check.py writes them)
+FORMAT_NAMES = {'sdr': 'SDR', 'hdr10': 'HDR10', 'hlg': 'HLG', 'dv81': 'DV 8.1', 'dv5': 'DV 5'}
+
+
+def result_words(facts):
+    '''One result of a check in a few words, from its line of facts (English, hades_check.py)'''
+    m = re.match(r'picture (\w+): (.*)$', facts)
+    if m:
+        fmt, rest = m.group(1), m.group(2)
+        kv = dict(re.findall(r'(\S+?)=(\S+)', rest))
+        if 'not on this system' in rest or 'did not play' in rest:
+            return f'{FORMAT_NAMES.get(fmt, fmt)} not played'
+        head = kv.get('sum.head', '')
+        out = {'dv': 'native', 'dv_hdr10': 'as HDR10', 'dv_sdr': 'as SDR', 'hdr10': 'HDR10', 'hdr10plus': 'HDR10+',
+               'hlg': 'HLG', 'sdr': 'SDR', 'hdr_lost': 'HDR lost', 'hdr_as_sdr': 'as SDR'}.get(head, head or '?')
+        if head == 'dv' and kv.get('dv.transport') == 'lowlatency':
+            out += ' LL'
+        answer = {'right': 'ok', 'none': 'no answer'}.get(kv.get('answer', 'none'), kv.get('answer'))
+        return f'{FORMAT_NAMES.get(fmt, fmt)} {out} {answer}'
+    m = re.match(r'speakers (\S+): (.*)$', facts)
+    if m:
+        kv = dict(re.findall(r'(\S+?)=(\S+)', m.group(2)))
+        return f'speakers {m.group(1)} {({"right": "ok", "none": "no answer"}).get(kv.get("answer", "none"), kv.get("answer"))}'
+    if facts.startswith('speakers:'):
+        return 'speakers not checked'
+    m = re.match(r'passthrough: (.*?) before\[', facts)
+    if m:
+        words = {'heard': 'heard', 'not-heard': 'not heard', 'not-sent': 'not sent', 'no-answer': 'no answer',
+                 'not-set': 'not set', 'not-checkable': 'not checkable', 'skipped': 'skipped'}
+        names = {'ac3': 'AC-3', 'eac3': 'DD+', 'truehd': 'TrueHD', 'dts': 'DTS', 'dtshd': 'DTS-HD'}
+        parts = [f'{names.get(k, k)} {words.get(v, v)}' for k, v in re.findall(r'(\w+)=(\S+)', m.group(1))]
+        return 'passthrough ' + ', '.join(parts)
+    if facts.startswith('passthrough:'):
+        return 'passthrough ' + facts.split(':', 1)[1].strip()
+    m = re.match(r'dolby vision a/b: .*?chosen=(\S+)', facts)
+    if m:
+        return f'DV A/B {m.group(1).rstrip(";")}'
+    if facts.startswith('frame packing:'):
+        kv = dict(re.findall(r'(\w+)=([^;]*)', facts))
+        if 'outcome' not in kv:
+            return 'frame packing not checked'
+        return f"frame packing {kv['outcome'].strip()}, {kv.get('answer', 'none').strip()}"
+    return facts.split(':', 1)[0]
+
+
+def share_line(displays, results, when, release, cpu, gpu, driver):
+    '''The line to share: LibreELEC Hades and its version, the CPU, the GPU and its driver, each display connected
+    (its name from the EDID, without serial number; its connector; what it takes; whether a sound bar or AV receiver
+    is between), and the results of the last check with its date. Only names of hardware and results: no serial
+    number, no address of the network, no name of a network, of the PC or of a user, nothing of a path.'''
+    hades = release.get('BUILDER_VERSION', '')
+    name = release.get('BUILDER_NAME', '') or 'Hades'
+    parts = [f'LibreELEC {name}{" " + hades if hades else ""}'.strip()]
+    parts.append(cpu or 'CPU ?')
+    parts.append(f'{gpu or "GPU ?"}{", " + driver if driver else ""}')
+    for connector, facts, _ in displays:
+        takes = []
+        if facts.get('dv', -1) >= 0:
+            takes.append(f'DV v{facts["dv"]}')
+        takes += facts.get('hdr', [])
+        text = f'{facts["name"]} on {connector}'
+        if takes:
+            text += ' (' + ', '.join(takes) + ')'
+        if facts.get('between', -1) > 0:
+            text += f' via sound bar/receiver {facts["address"]}'
+        parts.append(text)
+    if not displays:
+        parts.append('no display read')
+    if results:
+        parts.append(f'check {when or "?"}: ' + '; '.join(result_words(r['facts']) for r in results))
+    else:
+        parts.append('no check made')
+    line = ' | '.join(clean(p) for p in parts)
+    return line
+
+
+def clean(text):
+    '''One line of printable ASCII, without anything that looks like an address of a network or a serial: the facts
+    are of hardware and results only, and this is the last guard'''
+    text = re.sub(r'[^\x20-\x7e]', '', text)
+    text = re.sub(r'\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b', '[mac]', text)
+    text = re.sub(r'\b(?:\d{1,3}\.){3}\d{1,3}\b(?!\.)', lambda m: m.group(0) if _version_like(m.group(0)) else '[ip]',
+                  text)
+    return re.sub(r'\s+', ' ', text).strip()
+
+
+def _version_like(text):
+    # an HDMI address (2.2.0.0, every part a hexadecimal digit) or a version is not a network address
+    return all(len(p) == 1 for p in text.split('.'))
+
+
+def write_share(line, state_dir):
+    os.makedirs(state_dir, exist_ok=True)
+    path = os.path.join(state_dir, SHARE_NAME)
+    fd, part = tempfile.mkstemp(prefix='.share.', dir=state_dir)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as out:
+            out.write(line + '\n')
+        os.replace(part, path)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+    return path
diff --git a/resources/lib/hades_display_ui.py b/resources/lib/hades_display_ui.py
new file mode 100644
index 0000000..7df7b07
--- /dev/null
+++ b/resources/lib/hades_display_ui.py
@@ -0,0 +1,257 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+'''"Your display" and "Share my results": the part that runs in Kodi (hades_display.py decides what).
+
+"Your display" is a page of the first-start wizard (modules/display.py) and a button of System > Check this setup, the
+same questions in both: what kind of display it is (a projector, and its peak), and how HDR videos go out. It says
+what Hades found by itself (the display, what it takes, whether a sound bar or receiver is between, where the TV's
+remote reaches the PC over HDMI-CEC). Nothing is asked that can be read, and going on without an answer changes
+nothing. What it changes is written to a journal first, so that another answer puts back what the one before had
+changed.
+
+"Share my results" shows one line of this PC, its display and the results of the last "Check this setup", and copies
+it to a USB drive (hades-results.txt) to paste in the forum or in an issue.
+'''
+
+import json
+import os
+import shutil
+
+import xbmc
+import xbmcgui
+
+import hades_check as hc
+import hades_display as hd
+import log
+import oe
+
+S = {
+    'share': 33880, 'share_head': 33882, 'share_copy': 33883, 'share_none': 33884, 'share_copied': 33885,
+    'share_failed': 33886,
+    'display': 33890, 'intro': 33892, 'kind_label': 33893, 'tv': 33894, 'projector': 33895, 'monitor': 33896,
+    'projector_peak': 33897, 'hdr_label': 33898, 'hdr': 33899, 'hlg_sdr': 33900, 'all_sdr': 33901,
+    'peak_question': 33902, 'peak_unknown': 33903, 'kind_question': 33904, 'hdr_question': 33905,
+    'no_display': 33906, 'takes': 33907, 'sdr_only': 33908, 'cec_same': 33909, 'cec_other': 33910,
+    'cec_usb': 33911, 'cec_none': 33912, 'note_hdr10': 33914, 'note_dv': 33915, 'note_sdr': 33916,
+    'back': 33918, 'via': 33919, 'found': 33913,
+}
+CHOICES = 'choices.json'
+
+
+def rpc(method, **params):
+    reply = json.loads(xbmc.executeJSONRPC(json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method,
+                                                       'params': params})))
+    return reply.get('result'), reply.get('error')
+
+
+def get_setting(key):
+    '''The value of a setting, None where JSON-RPC does not answer (a setting not shown for this display)'''
+    result, error = rpc('Settings.GetSettingValue', setting=key)
+    return None if error or not isinstance(result, dict) else result.get('value')
+
+
+def set_setting(key, value):
+    result, error = rpc('Settings.SetSettingValue', setting=key, value=value)
+    return error is None and result is True or get_setting(key) == value
+
+
+class DisplayStep:
+
+    def __init__(self, state_dir=hd.STATE_DIR):
+        self.state_dir = state_dir
+        self.dialog = xbmcgui.Dialog()
+        self.displays = hd.connected_displays()
+        self.choices = self.load_choices()
+
+    # ---- what was found
+
+    def main_display(self):
+        '''The display the picture goes out to (the first with a mode), else the first connected'''
+        on = [d for d in self.displays if d[2]]
+        return (on or self.displays or [None])[0]
+
+    def found_text(self):
+        '''What Hades found by itself, in lines'''
+        lines = []
+        main = self.main_display()
+        if not main:
+            lines.append(oe._(S['no_display']))
+        else:
+            connector, facts, _ = main
+            takes = ([f'Dolby Vision (v{facts["dv"]})'] if facts['dv'] >= 0 else []) + facts['hdr']
+            line = f'{facts["name"]} ({connector}). ' + (oe._(S['takes']).replace('%s', ', '.join(takes), 1)
+                                                         if takes else oe._(S['sdr_only']))
+            if facts['between'] > 0:
+                line += ' ' + oe._(S['via']).replace('%s', facts['address'], 1)
+            lines.append(line)
+        picture = [d[0] for d in self.displays if d[2]]
+        verdict, where = hd.cec_verdict(hd.cec_adapters(), picture)
+        if verdict == 'same':
+            lines.append(oe._(S['cec_same']).replace('%s', where, 1))
+        elif verdict == 'other':
+            lines.append(oe._(S['cec_other']).replace('%s', where, 1).replace('%s', ', '.join(picture) or '?', 1))
+        elif verdict == 'usb':
+            lines.append(oe._(S['cec_usb']))
+        else:
+            lines.append(oe._(S['cec_none']))
+        log.log(f'display: found {[(c, f["name"], f["dv"], f["hdr"], f["address"], e) for c, f, e in self.displays]}; '
+                f'CEC {verdict} {where}', log.INFO)
+        return lines
+
+    # ---- the choices
+
+    def load_choices(self):
+        try:
+            with open(os.path.join(self.state_dir, CHOICES), encoding='utf-8') as f:
+                data = json.load(f)
+            if isinstance(data, dict) and data.get('version') == 1:
+                kind = data.get('kind') if data.get('kind') in hd.KINDS else 'tv'
+                peak = data.get('peak') if isinstance(data.get('peak'), int) else hd.PEAK_UNKNOWN
+                hdr = data.get('hdr') if data.get('hdr') in hd.HDR_CHOICES else 'hdr'
+                return {'kind': kind, 'peak': peak, 'hdr': hdr}
+        except (OSError, ValueError):
+            pass
+        return {'kind': 'tv', 'peak': hd.PEAK_UNKNOWN, 'hdr': 'hdr'}
+
+    def save_choices(self):
+        try:
+            os.makedirs(self.state_dir, exist_ok=True)
+            with open(os.path.join(self.state_dir, CHOICES), 'w', encoding='utf-8') as f:
+                json.dump(dict(self.choices, version=1), f, sort_keys=True)
+        except OSError as e:
+            log.log(f'display: the choices could not be kept: {e}', log.ERROR)
+
+    def kind_label(self):
+        kind = self.choices['kind']
+        value = (oe._(S['projector_peak']).replace('%s', str(self.choices['peak']), 1) if kind == 'projector'
+                 else oe._(S[kind]))
+        return oe._(S['kind_label']).replace('%s', value, 1)
+
+    def hdr_label(self):
+        return oe._(S['hdr_label']).replace('%s', oe._(S[self.choices['hdr']]), 1)
+
+    def takes_hdr(self):
+        main = self.main_display()
+        return bool(main and (main[1]['hdr'] or main[1]['dv'] >= 0))
+
+    def choose_kind(self):
+        '''Asks what kind of display it is (and a projector's peak) and sets what that changes; the notes to say'''
+        # (nothing preselected: a list that something else closes answers -1, which changes nothing)
+        n = self.dialog.select(oe._(S['kind_question']), [oe._(S[k]) for k in hd.KINDS])
+        if n < 0:
+            return []
+        kind = hd.KINDS[n]
+        peak = self.choices['peak']
+        if kind == 'projector':
+            names = [f'{p} nits' for p in hd.PEAKS] + [oe._(S['peak_unknown'])]
+            m = self.dialog.select(oe._(S['peak_question']), names)
+            if m < 0:
+                return []
+            peak = hd.PEAKS[m] if m < len(hd.PEAKS) else hd.PEAK_UNKNOWN
+        self.choices.update(kind=kind, peak=peak)
+        return self.apply()
+
+    def choose_hdr(self):
+        n = self.dialog.select(oe._(S['hdr_question']), [oe._(S[c]) for c in hd.HDR_CHOICES])
+        if n < 0:
+            return []
+        self.choices['hdr'] = hd.HDR_CHOICES[n]
+        return self.apply()
+
+    def apply(self):
+        '''Sets what the choices change, the journal of what the settings were first; the notes to say'''
+        main = self.main_display()
+        facts = main[1] if main else {'hdr': [], 'dv': -1}
+        note = None
+        kind_changes = {}
+        if self.choices['kind'] == 'projector':
+            kind_changes, note = hd.projector_changes(self.choices['peak'], facts)
+        hdr = hd.hdr_changes(self.choices['hdr']) if self.takes_hdr() else {}
+        journal_path = hd.journal_path(self.state_dir)
+        journal = hd.read_journal(journal_path)
+        current = {k: get_setting(k) for k in hd.STEP_TYPES}
+        to_set, after = hd.plan(current, journal, kind_changes, hdr)
+        try:
+            # (what they were, on the drive before the first change: another answer puts them back)
+            hd.write_journal(journal_path, dict(journal, **after))
+        except OSError as e:
+            log.log(f'display: the journal could not be written: {e}', log.ERROR)
+            return []
+        failed = [k for k, v in to_set.items() if not set_setting(k, v)]
+        if not failed:
+            hd.write_journal(journal_path, after)
+        self.save_choices()
+        log.log(f'display: choices {self.choices}; set {to_set}{"; not set " + str(failed) if failed else ""}', log.INFO)
+        notes = []
+        if note:
+            notes.append(oe._(S['note_' + note]).replace('%s', str(self.choices['peak']), 1))
+        if not kind_changes and not hdr and to_set:
+            notes.append(oe._(S['back']))
+        return notes
+
+    # ---- the button of the settings
+
+    def run(self):
+        title = oe._(S['display'])
+        self.dialog.textviewer(title, '\n\n'.join([oe._(S['intro'])] + self.found_text()))
+        while True:
+            items = [self.kind_label()] + ([self.hdr_label()] if self.takes_hdr() else []) + [oe._(S['found'])]
+            n = self.dialog.select(title, items)
+            if n < 0:
+                return
+            if n == 0:
+                notes = self.choose_kind()
+            elif n == 1 and self.takes_hdr():
+                notes = self.choose_hdr()
+            else:
+                self.dialog.textviewer(title, '\n\n'.join(self.found_text()))
+                continue
+            if notes:
+                self.dialog.ok(title, '\n'.join(notes))
+
+
+# ---- "Share my results"
+
+
+def share(clips_dir, state_dir):
+    title = oe._(S['share'])
+    dialog = xbmcgui.Dialog()
+    try:
+        with open(os.path.join(state_dir, 'last.json'), encoding='utf-8') as f:
+            data = json.load(f)
+        results = data['results']
+        when = data.get('when', '')
+    except (OSError, ValueError, KeyError, TypeError):
+        dialog.ok(title, oe._(S['share_none']))
+        return
+    gpu, driver = hd.gpu_of_log()
+    line = hd.share_line(hd.connected_displays(), results, when, hd.os_release(), hd.cpu_model(), gpu, driver)
+    try:
+        hd.write_share(line, state_dir)
+    except OSError as e:
+        log.log(f'share: the line could not be kept: {e}', log.ERROR)
+    log.log(f'share: {line}', log.INFO)
+    dialog.textviewer(title, oe._(S['share_head']).replace('%s', line, 1))
+    if not dialog.yesno(title, oe._(S['share_copy']), nolabel=xbmc.getLocalizedString(222),
+                        yeslabel=xbmc.getLocalizedString(107)):
+        return
+    drives = hc.usb_drives()
+    if not drives:
+        dialog.ok(title, oe._(33804))
+        return
+    drive = drives[0]
+    if len(drives) > 1:
+        n = dialog.select(oe._(33805), [os.path.basename(d) for d in drives])
+        if n < 0:
+            return
+        drive = drives[n]
+    try:
+        dest = os.path.join(drive, 'hades-results.txt')
+        with open(dest + '.part', 'w', encoding='utf-8') as f:
+            f.write(line + '\n')
+        os.replace(dest + '.part', dest)
+        os.sync()
+    except OSError as e:
+        dialog.ok(title, oe._(S['share_failed']).replace('%s', str(e), 1))
+        return
+    dialog.ok(title, oe._(S['share_copied']).replace('%s', os.path.basename(drive), 1))
