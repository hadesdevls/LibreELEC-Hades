diff --git a/resources/lib/defaults.py b/resources/lib/defaults.py
index f4db526..bf3c441 100644
--- a/resources/lib/defaults.py
+++ b/resources/lib/defaults.py
@@ -94,6 +94,8 @@ system = {
     'JOURNALD_CONFIG_FILE': '/storage/.cache/journald.conf.d/00_settings.conf',
     # Hades: keeps the setting "show the internal disks" in the boot menus
     'INTERNAL_DISKS': '/usr/lib/libreelec/internal-disks',
+    # Hades: what copies the diagnostics (the folder hades-diag of the boot partition) to a USB drive
+    'DIAG_TO_USB': '/usr/lib/hades-diag/to-usb.sh',
     # Hades: where "Submit Log" keeps a log that is not uploaded (the folder of the share Logfiles); the
     # filter that a log goes through first, kept or uploaded: the one of the diagnostics for logs (the
     # addresses of the network, serial numbers, network names and the name of the system become markers;
diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 5c95ddd..8f970d1 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -130,6 +130,7 @@ class system(modules.Module):
     # (seconds that collecting a log may take: a command that hangs is stopped then)
     LOG_KEPT_WAIT = 120
     CLOCK_CHOICE = None
+    DIAG_TO_USB = None
     MOUNTS = '/proc/mounts'
     menu = {'1': {
         'name': 32002,
@@ -323,6 +324,15 @@ class system(modules.Module):
                         'InfoText': 32940,
                         'order': 2,
                         },
+                    # Hades: what the diagnostics saved, copied to a USB drive (do_copy_diagnostics)
+                    'diag_usb': {
+                        'name': 33100,
+                        'value': '0',
+                        'action': 'do_copy_diagnostics',
+                        'type': 'button',
+                        'InfoText': 33101,
+                        'order': 3,
+                        },
                     },
                 },
             'journal': {
@@ -452,6 +462,7 @@ class system(modules.Module):
     def load_menu(self, focusItem):
         self.load_clock()
         self.load_internal_disks()
+        self.load_diag_usb()
         oe.winOeMain.build_menu(self.struct)
 
     def get_setting(self, group, setting, allowEmpty=False):
@@ -1052,6 +1063,93 @@ class system(modules.Module):
         else:
             xbmcDialog.ok(oe._(32376), oe._(32419))
 
+    # Hades: what the diagnostics saved on the boot partition (the folder hades-diag, every file of it through
+    # their filter already), copied to a USB drive that is chosen here: the way to get them from a system on a
+    # disk inside the PC, whose boot partition Windows does not show. The copy is made by DIAG_TO_USB, the script
+    # that also copies them to a drive that is plugged in with a folder named hades-diag at its top; it reads back
+    # from the drive what it wrote before it says that it is there, and never writes over anything on it.
+    def diag_to_usb(self, *args):
+        '''Run the script. Returns its exit status and what it printed. It is given the time that it takes (it
+        waits for the diagnostics to let go of the boot partition, and a drive may be slow) and never stopped: it
+        may be writing. Not in the environment of Kodi, where add-ons put folders of their own into PATH.'''
+        try:
+            process = subprocess.Popen([self.DIAG_TO_USB] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                                       stderr=subprocess.PIPE, env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+            out, err = process.communicate()
+        except OSError as e:
+            log.log(f'to-usb {" ".join(args)}: {e}', log.ERROR)
+            return 127, ''
+        said = err.decode(errors='replace').strip()
+        log.log(f'to-usb {" ".join(args)}: exit status {process.returncode}, {said!r}', log.INFO)
+        return process.returncode, out.decode(errors='replace')
+
+    @log.log_function()
+    def load_diag_usb(self):
+        setting = self.struct['debug']['settings']['diag_usb']
+        if not self.DIAG_TO_USB or not os.path.exists(self.DIAG_TO_USB):
+            # a system without it
+            setting['hidden'] = 'true'
+        else:
+            setting.pop('hidden', None)
+
+    @staticmethod
+    def drive_room(kib):
+        '''What a drive has free: whole MB below 2 GB, whole GB from there (no decimal sign, which each
+        language writes its own way).'''
+        if kib >= 2 * 1048576:
+            return f'{kib // 1048576} GB'
+        return f'{kib // 1024} MB'
