diff --git a/resources/lib/defaults.py b/resources/lib/defaults.py
index d69debe..887bae0 100644
--- a/resources/lib/defaults.py
+++ b/resources/lib/defaults.py
@@ -119,10 +119,13 @@ system = {
     'LOG_FILTER': ['/usr/bin/sh', '/usr/lib/hades-diag/redact.sh'],
     'LOG_UPLOAD_DIR': '/run',
     'LOG_UPLOAD': '/usr/bin/pastebinit',
-    # Hades: the time that the clock of the computer keeps from the next start: UTC when this file says
-    # so on its third line (the init then puts an adjtime that says UTC over /etc/adjtime of the image);
-    # without it, local time, as Windows keeps it
+    # Hades: the setting "Hardware clock" from the next start: UTC when this file says so on its third
+    # line (the init then puts an adjtime that says UTC over /etc/adjtime of the image), local time when
+    # it says anything else, and Automatic, the default, where there is no such file
     'CLOCK_CHOICE': f'{CONFIG_CACHE}/adjtime',
+    # Hades: the verdict of the last measurement of what the clock keeps, once the time came from the
+    # internet (/usr/lib/libreelec/clock-measure), which the setting follows on Automatic
+    'CLOCK_MEASURED': f'{CONFIG_CACHE}/clock-measured',
     }
 
