index 863b38b..54f08f2 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1325,7 +1325,7 @@ msgid "Hardware clock"
 msgstr ""
 
 msgctxt "#32972"
-msgid "What the clock of the computer (the one on its board, kept going by a battery) is set to. Local time, the default, is how Windows keeps it: on a computer that also runs Windows this system reads that clock and never writes it. UTC is how Linux and most other systems keep it. On a computer without Windows, or whose Windows keeps the clock in UTC, choose UTC: otherwise the time is off by your time zone until it is taken from the internet, and wake-ups for recordings come at the wrong hour. A change takes effect from the next start."
+msgid "What the clock of the computer (the one on its board, kept going by a battery) keeps. Automatic, the default: once the time has been taken from the internet, this system compares it with that clock and, from the next start, reads the clock as what it keeps: local time, as Windows keeps it, or UTC, as Linux and most other systems keep it. It never writes the clock, so the clock of Windows is never moved. Where the time zone is at UTC for part of the year, the two cannot be told apart, and the clock is read as before. Local time and UTC set it by hand: local time is read and never written; with UTC the clock is also set from the internet, as in LibreELEC. A change takes effect from the next start."
 msgstr ""
 
 msgctxt "#32973"
@@ -1341,7 +1341,7 @@ msgid "from the next start"
 msgstr ""
 
 msgctxt "#32976"
-msgid "With UTC, from the next start:[CR][CR]- This system takes the time of the clock as UTC. It sets the clock to UTC when it takes the time from the internet, and each time the media centre starts.[CR][CR]- On a computer that also runs Windows, that moves the clock of Windows by your time zone, since Windows keeps it in local time, until Windows sets it again.[CR][CR]Choose UTC only if this computer does not run Windows, or if its Windows has been set to keep the clock in UTC. It stays so until you choose local time here or reset this system to its defaults."
+msgid "With UTC, from the next start:[CR][CR]- This system takes the time of the clock as UTC. It sets the clock to UTC when it takes the time from the internet, and each time the media centre starts.[CR][CR]- On a computer that also runs Windows, that moves the clock of Windows by your time zone, since Windows keeps it in local time, until Windows sets it again.[CR][CR]Choose UTC only if this computer does not run Windows, or if its Windows has been set to keep the clock in UTC; Automatic reads such a clock as UTC without ever writing it. It stays so until you choose another setting here or reset this system to its defaults."
 msgstr ""
 
 msgctxt "#32977"
@@ -1368,6 +1368,18 @@ msgctxt "#32982"
 msgid "local time"
 msgstr ""
 
+msgctxt "#33780"
+msgid "Automatic (measured with the time from the internet)"
+msgstr ""
+
+msgctxt "#33781"
+msgid "Automatic"
+msgstr ""
+
+msgctxt "#33782"
+msgid "Automatic from the next start"
+msgstr ""
+
