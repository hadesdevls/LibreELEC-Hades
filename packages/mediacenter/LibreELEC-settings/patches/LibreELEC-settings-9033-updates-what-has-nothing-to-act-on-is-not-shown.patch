From f9e0f0c6e76d82223c3e0871511de0a902ebb95c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:22:22 +0000
Subject: [PATCH] updates: what has nothing to act on is not shown

In a system without an update server and without an update channel of
its own (LibreELEC Hades as it is published), three entries of "Updates"
did nothing:

- "Update Channel" had no value, and opened a list with one empty line;
- "Submit Statistics" said that checking for a new version sends data to
  the update server; there is none to send it to;
- "Show Update Notifications" said that a notification would tell of a
  new version; nothing looks for one.

While that is so, they are not shown; the value of each setting is kept
as it is. Everything else stays as it was: "Automatic Updates", whose
help says that nothing is looked for and where the new versions are
published, and "Available Versions", which says how to install one (its
update file in the Update folder, or the installer for Windows). The
custom channels of LibreELEC stay too: when one gives a channel to
choose, "Update Channel" is shown again. With an update server, as in
LibreELEC, every entry is shown as before.

Tested inside the system of an image (its Python), with Kodi and the
rest of the add-on as stand-ins: 15 checks; the test fails on the
add-on without this change, and on each of 6 changes that put
back one of these entries or hide one that acts.
---
 resources/lib/modules/updates.py | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/resources/lib/modules/updates.py b/resources/lib/modules/updates.py
index 865188d..48d5a4d 100644
--- a/resources/lib/modules/updates.py
+++ b/resources/lib/modules/updates.py
@@ -321,6 +321,7 @@ class updates(modules.Module):
         self.update_json = self.build_json()
 
         self.struct['update']['settings']['Channel']['values'] = self.get_channels()
+        self.hades_hide_unused()
         self.struct['update']['settings']['Build']['values'] = self.get_available_builds()
 
         # RPi4/RPi400/RPi5 EEPROM updating
@@ -373,11 +374,29 @@ class updates(modules.Module):
             self.set_value(listItem)
         self.update_json = self.build_json()
         self.struct['update']['settings']['Channel']['values'] = self.get_channels()
+        self.hades_hide_unused()
         if self.struct['update']['settings']['Channel']['values']:
             if self.struct['update']['settings']['Channel']['value'] not in self.struct['update']['settings']['Channel']['values']:
                 self.struct['update']['settings']['Channel']['value'] = None
         self.struct['update']['settings']['Build']['values'] = self.get_available_builds()
 
+    @log.log_function()
+    def hades_hide_unused(self):
+        '''Hades: what has nothing to act on is not shown. "Update Channel" with nothing to choose (no
+        LibreELEC update server, and no custom channel that gives one): it opened a list with one empty
+        line. "Submit Statistics" without an update server, the only thing that it is sent to. "Show
+        Update Notifications" without an update server or an update channel of the system: nothing
+        would be told. Only what is shown changes: the value of each setting stays as it is kept.'''
+        settings = self.struct['update']['settings']
+        for entry, unused in (('Channel', not settings['Channel']['values']),
+                              ('SubmitStats', not self.UPDATE_REQUEST_URL),
+                              ('UpdateNotify', not self.UPDATE_REQUEST_URL
+                               and not getattr(self, 'hades_channel', None))):
+            if unused:
+                settings[entry]['hidden'] = 'true'
+            else:
+                settings[entry].pop('hidden', None)
+
     @log.log_function()
     def custom_sort_train(self, a, b):
         a_items = a.split('-')
