 msgctxt "#32918"
 msgid "@DISTRONAME@ includes a Samba server to share files with your computers through Finder or Windows Explorer. It is off by default. When you turn it on, a password is generated for it; you can look it up and change it in the Samba settings."
 msgstr ""
+
+msgctxt "#32919"
+msgid "Detect from the internet (sends your IP address to icanhazip.com and ipapi.co)"
+msgstr ""
+
+msgctxt "#32920"
+msgid "The time zone could not be detected"
+msgstr ""
