diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index feabfca..5a6dcce 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -420,19 +420,25 @@ class system(modules.Module):
     @log.log_function()
     def set_timezone(self, listItem=None):
         timezones = timezone.list_timezones()
-        guessed_timezone = timezone.guess_timezone()
-        current_timezone = self.struct['ident']['settings']['timezone']['value']
-        if current_timezone != 'UTC' and current_timezone in timezones:
-            menu_position = timezones.index(current_timezone)
-        elif guessed_timezone in timezones:
-            menu_position = timezones.index(guessed_timezone)
-        else:
-            menu_position = 0
+        # Hades: guessing the time zone sends the public IP address to icanhazip.com and
+        # ipapi.co, so it is an explicit first entry of the list instead of a query each
+        # time the list opens. The current time zone stays preselected.
+        preselected = self.struct['ident']['settings']['timezone']['value']
         xbmcDialog = xbmcgui.Dialog()
-        timezone_select = xbmcDialog.select(heading=oe._(32420), list=timezones, preselect=menu_position)
+        while True:
+            menu_position = timezones.index(preselected) + 1 if preselected in timezones else 1
+            timezone_select = xbmcDialog.select(heading=oe._(32420), list=[oe._(32919)] + timezones,
+                                                preselect=menu_position)
+            if timezone_select != 0:
+                break
+            guessed_timezone = timezone.guess_timezone()
+            if guessed_timezone in timezones:
+                preselected = guessed_timezone
+            else:
+                oe.notify(oe._(32420), oe._(32920))
         log.log(f'timezone_select: {timezone_select}', log.DEBUG)
-        if timezone_select > -1:
-            listItem = timezones[timezone_select]
+        if timezone_select > 0:
+            listItem = timezones[timezone_select - 1]
             log.log(f'listItem: {listItem}', log.DEBUG)
             self.struct['ident']['settings']['timezone']['value'] = listItem
             self.struct['ident']['settings']['timezone']['name'] = f"{oe._(32420)} ({listItem})"
