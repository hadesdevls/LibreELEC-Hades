diff --git a/resources/lib/hades_update.py b/resources/lib/hades_update.py
index b080446..b1897bd 100644
--- a/resources/lib/hades_update.py
+++ b/resources/lib/hades_update.py
@@ -32,6 +32,12 @@ signature is checked before the manifest is read. Then:
   - the signed manifest and its signature are kept next to it (keep_proof): the init of a system that starts
     with Secure Boot installs an update only when they prove it, with the client and the keys of the system
     that runs (check_kept, "hades_update.py check-kept").
+An update placed in the update folder by hand (over the network, with SSH, from Kodi's file manager) replaces the
+whole system at the next start, as the channel's does. The init of a system without Secure Boot installs it only when
+it is proven as above, or when it is the one approved on this system (check_update, "hades_update.py check-update"):
+the settings add-on asks on the screen as soon as it sees one (approve() on a yes), and the choice MANUAL_NAME = "any"
+(the setting "Ask before installing an update placed by hand" off) installs any, as LibreELEC does. Both live in
+STATE_DIR, which no share of the network serves.
 Every request is a GET with a fixed user agent and nothing else of the system: no proxy of the environment,
 no cookies, no system id. A redirect is followed only over HTTPS, at most MAX_REDIRECTS times, and only to
 the same host and port or to one of the hosts that GitHub serves the files of a release from (ASSET_HOSTS,
@@ -53,6 +59,9 @@ A manifest:
                         "sha256": "<64 lowercase hex digits>"}}}
 A signature file:
   {"format": "hades-update-signature-1", "key": "<key_id() of the key>", "signature": "<64 bytes, base64>"}
+An approval (STATE_DIR/APPROVAL_NAME):
+  {"format": "hades-update-approval-1", "files": [{"name": "<name>", "size": <bytes>, "sha256": "<hex>"}, ...]}
+  (the files that the init installs at the next start, in its order: placed())
 '''
 
 import base64
@@ -112,6 +121,20 @@ SIGNATURE_FIELDS = frozenset(('format', 'key', 'signature'))
 # (what a signed manifest gives: its release to be offered, nothing newer than this image, or a release
 # newer than this image that cannot be installed over it from here)
 OFFER, CURRENT, REINSTALL = 'offer', 'current', 'reinstall'
+# (an update placed by hand: the choice and the approval that the init reads, in the state folder of the client, which
+# no share of the network serves; the init names the same paths)
+STATE_DIR = '/storage/.cache/hades-update'
+MANUAL_NAME = 'manual-updates'
+MANUAL_ANY = 'any'
+APPROVAL_NAME = 'approved-update.json'
+APPROVAL_FORMAT = 'hades-update-approval-1'
+APPROVAL_FIELDS = frozenset(('format', 'files'))
+APPROVED_FIELDS = frozenset(('name', 'size', 'sha256'))
+APPROVAL_MAX = 4096
+# (how an update in the update folder is let through: signed by the channel, or approved on this system)
+SIGNED, APPROVED = 'signed', 'approved'
+# (what tells that the boot partition starts with Secure Boot: the init's hades_sb_installed)
+SECURE_BOOT_FILES = ('HADES-SB.CER', 'EFI/BOOT/mmx64.efi', 'EFI/BOOT/grubx64.efi')
 
 
 class ChannelError(Exception):
@@ -600,6 +623,132 @@ def _whole(f, size, sha256):
     return n == size and digest.hexdigest() == sha256
 
 
+def placed(folder):
+    '''The paths in folder of the update that the init installs at the next start, as its check_update takes it: the
+    first *.tar by name, else the first *.img.gz, else the first *.img, else KERNEL and SYSTEM when both are there.
+    [] when there is none. (Names that start with a dot are not matched by its patterns.)'''
+    try:
+        names = sorted(os.listdir(folder))
+    except OSError:
+        return []
+    for suffix in ('.tar', '.img.gz', '.img'):
+        for name in names:
+            if name.endswith(suffix) and not name.startswith('.') and os.path.isfile(os.path.join(folder, name)):
+                return [os.path.join(folder, name)]
+    both = [os.path.join(folder, n) for n in ('KERNEL', 'SYSTEM')]
+    return both if all(os.path.isfile(p) for p in both) else []
+
+
+def entries(paths):
+    '''What an approval holds of paths, in their order: the name, size and SHA-256 of each. Raises ChannelError for a
+    link or anything that is not a file.'''
+    out = []
+    for path in paths:
+        name = os.path.basename(path)
+        try:
+            if os.path.islink(path) or not os.path.isfile(path):
+                raise ChannelError(f'{name} is a link or not a file')
+            digest, n = hashlib.sha256(), 0
+            with open(path, 'rb') as f:
+                for piece in iter(lambda: f.read(1024 * 1024), b''):
+                    n += len(piece)
+                    digest.update(piece)
+        except OSError as e:
+            raise ChannelError(f'{name}: {e.strerror}') from None
+        out.append({'name': name, 'size': n, 'sha256': digest.hexdigest()})
+    return out
+
+
+def _write(path, data):
+    '''data in path, written next to it (owner only) and renamed into it.'''
+    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
+    part = f'{path}.part'
+    try:
+        os.remove(part)
+    except FileNotFoundError:
+        pass
+    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, 'wb') as f:
+        f.write(data)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(part, path)
+
+
+def approve(path, paths):
+    '''Keeps in path the approval of the update made of paths (what the person at the screen said yes to): the init of a
+    system without Secure Boot installs that update, those bytes and no others, at the next start. Returns its
+    entries. Raises ChannelError when a file cannot be read.'''
+    files = entries(paths)
+    _write(path, (json.dumps({'format': APPROVAL_FORMAT, 'files': files}) + '\n').encode())
+    return files
+
+
+def read_approval(path):
+    '''The files of the approval in path. Raises OSError (none) or ValueError (not one).'''
+    with open(path, 'rb') as f:
