From 1ee2e5ea087dd13e7f41ce5970023ce1fdfbda15 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] services: secure Samba defaults and keep the generated
 password

Samba is now off by default and password protected when enabled.
Default to SAMBA_SECURE=1 with an empty password so that
samba-config generates a random one instead of using the well-known
libreelec/libreelec, and read the generated credentials back after
enabling the service so that they are shown in the settings and not
overwritten with the empty value on the next change.
---
 resources/lib/defaults.py         | 4 ++--
 resources/lib/modules/services.py | 6 ++++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/resources/lib/defaults.py b/resources/lib/defaults.py
index f7b4bd1..77e4842 100644
--- a/resources/lib/defaults.py
+++ b/resources/lib/defaults.py
@@ -56,9 +56,9 @@ services = {
     'SAMBA_NMDB': '/usr/sbin/nmbd',
     'SAMBA_SMDB': '/usr/sbin/smbd',
     'D_SAMBA_WORKGROUP': 'WORKGROUP',
-    'D_SAMBA_SECURE': '0',
+    'D_SAMBA_SECURE': '1',
     'D_SAMBA_USERNAME': 'libreelec',
-    'D_SAMBA_PASSWORD': 'libreelec',
+    'D_SAMBA_PASSWORD': '',
     'D_SAMBA_MINPROTOCOL': 'SMB2',
     'D_SAMBA_MAXPROTOCOL': 'SMB3',
     'D_SAMBA_AUTOSHARE': '1',
diff --git a/resources/lib/modules/services.py b/resources/lib/modules/services.py
index e3378eb..1e70f95 100644
--- a/resources/lib/modules/services.py
+++ b/resources/lib/modules/services.py
@@ -396,6 +396,12 @@ class services(modules.Module):
             self.struct['samba']['settings']['samba_username']['hidden'] = True
             self.struct['samba']['settings']['samba_password']['hidden'] = True
         oe.set_service('samba', options, state)
+        if state == 1:
+            # samba-config generates credentials that are missing: show them and keep them
+            self.struct['samba']['settings']['samba_username']['value'] = self.sh_unesc_str(oe.get_service_option('samba', 'SAMBA_USERNAME',
+                    self.D_SAMBA_USERNAME).replace('"', ''))
+            self.struct['samba']['settings']['samba_password']['value'] = self.sh_unesc_str(oe.get_service_option('samba', 'SAMBA_PASSWORD',
+                    self.D_SAMBA_PASSWORD).replace('"', ''))
 
     @log.log_function()
     def initialize_ssh(self, **kwargs):
-- 
2.53.0

