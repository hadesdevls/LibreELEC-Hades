+        setting['name'] = f'{oe._(32209)} ({oe._(state)})'
+
+    # Hades: Network access. What holds now is read from the settings themselves, so that a setting changed on its
+    # own afterwards shows "Your own settings"; a choice changes only what differs, after it is shown (As in LibreELEC
+    # asks first, with "no" preselected), and each change goes to the log of Kodi.
+    NET_LABELS = {hades_netaccess.RECOMMENDED: 34144, hades_netaccess.LIBREELEC: 34145, hades_netaccess.OWN: 34146}
+    NET_WORDS = {hades_netaccess.RECOMMENDED: 'Recommended', hades_netaccess.LIBREELEC: 'As in LibreELEC',
+                 hades_netaccess.OWN: 'own settings'}
+    NET_PROFILE = None
+
+    def net_now(self):
+        samba_on = os.path.isfile(self.SAMBA_SMDB) and oe.get_service_state('samba') == '1'
+        samba_secure = oe.get_service_option('samba', 'SAMBA_SECURE', self.D_SAMBA_SECURE).replace('"', '') \
+            not in ('false', '0')
+        if oe.get_service_state('iptables') == '1':
+            firewall = ''.join(oe.get_service_option('iptables', 'RULES', 'home').split())
+        else:
+            firewall = 'none'
+        try:
+            airplay = self.kodi_setting('services.airplay')
+            airplay = airplay if isinstance(airplay, bool) else None
+        except (RuntimeError, ValueError, KeyError, TypeError):
+            airplay = None
+        return hades_netaccess.current(samba_on, samba_secure,
+                                       bool(self.NET_PROFILE) and hades_netaccess.ssh_as_libreelec(self.NET_PROFILE),
+                                       firewall, airplay)
+
+    def net_state(self):
+        return hades_netaccess.state(self.net_now())
+
+    NET_ITEMS = {'samba': 34151, 'ssh': 34155, 'firewall': 34158, 'airplay': 34159}
+    NET_VALUES = {('samba', 'off'): 34152, ('samba', 'password'): 34153, ('samba', 'open'): 34154,
+                  ('ssh', 'refuses'): 34156, ('ssh', 'accepts'): 34157,
+                  ('firewall', 'none'): 34165, ('firewall', 'home'): 34166, ('firewall', 'public'): 34167,
+                  ('firewall', 'custom'): 34168, ('airplay', True): 34160, ('airplay', False): 34152,
