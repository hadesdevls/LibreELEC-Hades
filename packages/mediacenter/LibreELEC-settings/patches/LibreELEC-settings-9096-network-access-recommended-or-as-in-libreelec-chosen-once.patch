+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+# Hades: "Network access", a page of the wizard of the first start, before the one of Samba and SSH: Recommended (safer,
+# selected) or As in LibreELEC. Choosing As in LibreELEC shows what changes and asks first; going on without touching
+# anything changes nothing. The same choice is in Settings > LibreELEC > Services > Network access, for later; what it
+# is made of is in hades_netaccess.py, and the services module applies it. No entry of its own in the menu.
+
+import hades_netaccess
+import log
+import oe
+
+
+class netaccess:
+
+    ENABLED = True
+    menu = {}
+
+    @log.log_function()
+    def __init__(self, oeMain):
+        super().__init__()
+
+    @log.log_function()
+    def exit(self):
+        pass
+
+    def services(self):
+        return oe.dictModules.get('services')
+
+    @log.log_function()
+    def do_wizard(self):
+        self.show()
+
+    def show(self):
+        services = self.services()
+        state = services.net_state() if services else hades_netaccess.RECOMMENDED
+        oe.winOeMain.set_wizard_title(oe._(34140))
+        oe.winOeMain.set_wizard_text(oe._(34142))
+        oe.winOeMain.set_wizard_button_title('')
+        oe.winOeMain.set_wizard_radiobutton_1(oe._(34144), self, 'wizard_recommended',
+                                              state == hades_netaccess.RECOMMENDED)
+        oe.winOeMain.set_wizard_radiobutton_2(oe._(34145), self, 'wizard_libreelec',
+                                              state == hades_netaccess.LIBREELEC)
+
+    @log.log_function()
+    def wizard_recommended(self):
+        services = self.services()
+        if services:
+            services.choose_net_access(hades_netaccess.RECOMMENDED)
+        self.show()
+
+    @log.log_function()
+    def wizard_libreelec(self):
+        services = self.services()
+        if services:
+            services.choose_net_access(hades_netaccess.LIBREELEC)
+        self.show()
