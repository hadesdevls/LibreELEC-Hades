diff --git a/resources/lib/hades_netaccess.py b/resources/lib/hades_netaccess.py
new file mode 100644
index 0000000..9a206bf
--- /dev/null
+++ b/resources/lib/hades_netaccess.py
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+
+# Hades: "Network access", one choice between the network settings that LibreELEC Hades recommends and LibreELEC's
+# own defaults, for what other devices of the home network can reach on this system. Read against LibreELEC (the
+# recipes and the patches of the settings add-on), Hades changed four of them; the rest of the network is the same in
+# both:
+#   file sharing (Samba)   LibreELEC: on, without a password (packages/network/samba: SAMBA_SECURE="false", and the
+#                          wizard of the first start turned it on); Hades: off until turned on, with a password then
+#   SSH                    LibreELEC: off until turned on, and then root logs in with the default password that
+#                          everyone knows; Hades: off until turned on, and password logins refused while root has
+#                          that password (sshd-default-password), keys always
+#   firewall               LibreELEC: off; Hades: on, "home network" (iptables-defaults.service)
+#   AirPlay of Kodi        LibreELEC: on (appliance.xml); Hades: off until turned on, as in Kodi
+# What each choice is made of, what holds now and what a choice would change, without anything of Kodi, so that it
+# can be tried on its own. The file of the choice says "libreelec" where SSH takes the default password as LibreELEC
+# does (sshd-default-password reads it); no file, Hades' way.
+
+import os
+import tempfile
+
+RECOMMENDED = 'recommended'
+LIBREELEC = 'libreelec'
+OWN = 'own'
+
+
+def ssh_as_libreelec(path):
+    '''Whether the file of the choice says that SSH takes root's default password, as LibreELEC does.'''
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            return f.readline().strip() == LIBREELEC
+    except OSError:
+        return False
+
+
+def write_ssh_as_libreelec(path, on):
+    '''The file of the choice: "libreelec" (written beside it, renamed over it, read back), or no file. Raises OSError
+    when it does not say what was asked for.'''
+    if on:
+        folder = os.path.dirname(path)
+        os.makedirs(folder, exist_ok=True)
+        fd, part = tempfile.mkstemp(prefix='.hades-network.', dir=folder)
+        try:
+            with os.fdopen(fd, 'w', encoding='utf-8') as out:
+                out.write(f'{LIBREELEC}\n')
+                out.flush()
+                os.fsync(out.fileno())
+            os.chmod(part, 0o644)
+            os.replace(part, path)
+        except BaseException:
+            try:
+                os.remove(part)
+            except OSError:
+                pass
+            raise
+    elif os.path.islink(path) or os.path.isfile(path):
+        os.remove(path)
+    if ssh_as_libreelec(path) != on:
+        raise OSError(f'{path} does not say what was chosen')
+
+
+def current(samba_on, samba_secure, ssh_le, firewall, airplay):
+    '''What holds now, as a dict: samba ('off', 'password' or 'open'), ssh ('refuses' or 'accepts' the default
+    password), firewall ('none', 'home', 'public' or 'custom'), airplay (True, False or None where it is not known).'''
+    return {
+        'samba': 'off' if not samba_on else ('password' if samba_secure else 'open'),
+        'ssh': 'accepts' if ssh_le else 'refuses',
+        'firewall': firewall if firewall in ('none', 'home', 'public', 'custom') else 'home',
+        'airplay': airplay,
+    }
+
+
+def target(choice, now):
+    '''What a choice makes of what holds now. Recommended: Samba keeps its switch and asks for a password, SSH refuses
+    the default password, the firewall is on (home network where it was off; a public or custom one stays), AirPlay
+    off. As in LibreELEC: Samba on without a password, SSH takes the default password, no firewall, AirPlay on.'''
+    if choice == LIBREELEC:
+        return {'samba': 'open', 'ssh': 'accepts', 'firewall': 'none', 'airplay': True}
+    return {
+        'samba': 'off' if now['samba'] == 'off' else 'password',
+        'ssh': 'refuses',
+        'firewall': 'home' if now['firewall'] == 'none' else now['firewall'],
+        'airplay': False,
+    }
+
+
+def state(now):
+    '''recommended, libreelec, or own: what holds now is neither (a setting changed by itself afterwards).'''
+    if now == target(LIBREELEC, now):
+        return LIBREELEC
+    if now == target(RECOMMENDED, now):
+        return RECOMMENDED
+    return OWN
+
+
+def changes(choice, now):
+    '''The settings that a choice would change, in order: (name, now, then).'''
+    then = target(choice, now)
+    return [(k, now[k], then[k]) for k in ('samba', 'ssh', 'firewall', 'airplay') if now[k] != then[k]]
+
+
+def summary(now):
+    '''One line for the log of Kodi and for the report, in English: "samba=password ssh=refuses firewall=home
+    airplay=off".'''
+    airplay = {True: 'on', False: 'off', None: 'unknown'}[now['airplay']]
+    return f'samba={now["samba"]} ssh={now["ssh"]} firewall={now["firewall"]} airplay={airplay}'
