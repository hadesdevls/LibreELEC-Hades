diff --git a/resources/lib/oe.py b/resources/lib/oe.py
index 8979270..68e312e 100644
--- a/resources/lib/oe.py
+++ b/resources/lib/oe.py
@@ -13,6 +13,7 @@ import os
 import re
 import sys
 import time
+import unicodedata
 import urllib.request
 import urllib.parse
 from xml.dom import minidom
@@ -258,6 +259,49 @@ class ProgressDialog:
         return self.cancelled
 
 
+# Hades: the build shows itself under its own name, not as Kodi. The texts of this add-on that name the
+# program that the user runs (the backup, the two resets, waiting for the network before it starts) are
