index 5b05f78..7562bb3 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1621,7 +1621,7 @@ msgid "Wait before the system starts (seconds)"
 msgstr ""
 
 msgctxt "#33170"
-msgid "How long the menu that is shown when the computer starts waits before it starts this system by itself: 10 seconds (the default), 3 or 1. A key pressed in that menu stops the wait, to choose another entry. It applies from the next start, on UEFI and BIOS computers alike. An update made with the installer for Windows sets it back to 10 seconds."
+msgid "How long the menu that is shown when the computer starts waits before it starts this system by itself: 5 seconds (the default), 10, 3 or 1. A key pressed in that menu stops the wait, to choose another entry. It applies from the next start, on UEFI and BIOS computers alike, and an update keeps it."
