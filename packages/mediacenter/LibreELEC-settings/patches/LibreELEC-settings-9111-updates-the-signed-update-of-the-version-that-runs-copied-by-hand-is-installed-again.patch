From 60aac0e9ef69be2cccc4e6a7d88197feedf605a0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 23:38:42 +0000
Subject: [PATCH] updates: the signed update of the version that runs, copied
 by hand, is installed again

Since an update copied to the update folder by hand is installed without
a question only when signed (9110), the .tar of the version that runs,
copied with its two hades-manifest files to repair a system whose Kodi
does not start, was refused as "not newer" and waited for the question
of the add-on, which such a system never shows; each start waited for
it. The same signed bytes put back are no step back: check_update, the
check of the init of a system without Secure Boot, now takes the release
that runs too. An older release is still refused, any other file still
needs the yes on the screen, and with Secure Boot (check_kept, which
signs the update with the key of the computer) only a newer release is
taken, as before.
---
 resources/lib/hades_update.py | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/resources/lib/hades_update.py b/resources/lib/hades_update.py
index b1897bd..cd43c64 100644
--- a/resources/lib/hades_update.py
+++ b/resources/lib/hades_update.py
@@ -34,7 +34,8 @@ signature is checked before the manifest is read. Then:
     that runs (check_kept, "hades_update.py check-kept").
 An update placed in the update folder by hand (over the network, with SSH, from Kodi's file manager) replaces the
 whole system at the next start, as the channel's does. The init of a system without Secure Boot installs it only when
-it is proven as above, or when it is the one approved on this system (check_update, "hades_update.py check-update"):
+it is proven as above (there also the release that runs: its own signed .tar put back, to repair it), or when it is the
+one approved on this system (check_update, "hades_update.py check-update"):
 the settings add-on asks on the screen as soon as it sees one (approve() on a yes), and the choice MANUAL_NAME = "any"
 (the setting "Ask before installing an update placed by hand" off) installs any, as LibreELEC does. Both live in
 STATE_DIR, which no share of the network serves.
@@ -566,14 +567,15 @@ def distro_arch(os_release='/etc/os-release'):
     return None
 
 
-def check_kept(folder, tar, channel_dir=None, os_release='/etc/os-release'):
+def check_kept(folder, tar, channel_dir=None, os_release='/etc/os-release', same=False):
     '''For the init of a system that starts with Secure Boot, before anything of an update is read or run and before
     it is signed with the key of the computer: returns the version of the release when tar is the file of a release
     that the update channel of THIS system offers to it, as the signed manifest kept next to it in folder says
     (keep_proof): the signature by a key of this system, its channel and architecture, a release newer than this one
     that can be installed over it, and the name, size and SHA-256 of tar. Raises ChannelError otherwise. The expiry
     and the newest manifest taken are not looked at: the init has no clock set over the network, and the client
-    looked at both when it downloaded the file.'''
+    looked at both when it downloaded the file. same: the release that runs is taken too (check_update), never an
+    older one.'''
     channel_dir = channel_dir or CHANNEL_DIR
     channel = read_channel(channel_dir)
     if channel is None:
@@ -593,7 +595,7 @@ def check_kept(folder, tar, channel_dir=None, os_release='/etc/os-release'):
     verify(manifest, signature, channel.keys)
     m = parse(manifest, channel.name, arch)
     r, f = m['release'], m['release']['file']
-    if r['serial'] <= channel.release_serial:
+    if r['serial'] < channel.release_serial or (r['serial'] == channel.release_serial and not same):
         raise ChannelError(f'release {r["version"]} ({r["serial"]}) is not newer than this system ({channel.release_serial})')
     if channel.release_serial < r['min_serial']:
         raise ChannelError(f'release {r["version"]} cannot be installed over this system (it needs {r["min_serial"]} '
@@ -726,13 +728,15 @@ def secure_boot(flash='/flash'):
 def check_update(folder, paths, approval, channel_dir=None, os_release='/etc/os-release'):
     '''For the init of a system without Secure Boot, before anything of an update is read or run: (SIGNED, its version)
     when paths is the .tar of a release that the update channel of this system offers to it, with its signed manifest
-    next to it (check_kept); else (APPROVED, None) when paths are the files, those bytes in that order, of the approval
-    in approval (approve). Raises ChannelError otherwise, with why.'''
+    next to it (check_kept), or of the release that runs (the same signed bytes put back to repair it are no step back:
+    an older release is refused, as the init with Secure Boot refuses the release that runs too); else (APPROVED, None)
+    when paths are the files, those bytes in that order, of the approval in approval (approve). Raises ChannelError
+    otherwise, with why.'''
     if not paths:
         raise ChannelError('no update')
     if len(paths) == 1 and paths[0].endswith('.tar'):
         try:
-            return SIGNED, check_kept(folder, paths[0], channel_dir, os_release)
+            return SIGNED, check_kept(folder, paths[0], channel_dir, os_release, same=True)
         except ChannelError as e:
             why = str(e)
     else:
