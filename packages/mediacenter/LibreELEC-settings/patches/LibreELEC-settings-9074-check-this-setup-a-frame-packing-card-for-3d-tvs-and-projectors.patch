 '''"Check this setup" (System > Check this setup): what the check decides, apart from Kodi.
 
 The check plays short clips that the build of LibreELEC Hades made (/usr/share/hades/check: the test
-card in SDR, HDR10, HLG and Dolby Vision 8.1 and 5, a soft chime in each passthrough format that
-can be made well, a walk round the speakers in PCM), reads what Kodi says of how each went out (the
+card in SDR, HDR10, HLG and Dolby Vision 8.1 and 5, a 3D clip for frame packing, a soft chime in each
+passthrough format that can be made well, a walk round the speakers in PCM), reads what Kodi says of how each went out (the
 properties that the player information publishes while the check runs: hades_check_ui.py) and says
 it in a sentence. Where the answer depends on what the user sees or hears, it asks.
 
@@ -58,9 +58,20 @@ AB_SETTINGS = (
     ('videoscreen.hadesdvavibt2020', False, True),  # no colorimetry in the AVI InfoFrame; BT.2020
 )
 AB_KEYS = tuple(k for k, _, _ in AB_SETTINGS)
+# The 3D clip plays with Kodi's 3D settings as the card needs them, and only those that are not so already are changed
+# (with the journal, and put back after): a 3D video played in the preferred mode (not "Ask"), and that mode the same
+# as the video (side by side: Kodi draws the eyes split, and LibreELEC Hades sends them in frame packing where the
+# display takes it); and the refresh rate following the video at its start and stop where it does not follow it at all
+# (frame packing is a mode of 1080p24, not the mode of the menus). Any other way of following the rate is kept.
+FP_PLAYBACK = 'videoplayer.stereoscopicplaybackmode'   # 0 ask, 1 preferred mode, 2 2D, 100 ignore
+FP_PREFERRED = 'videoscreen.preferedstereoscopicmode'  # 100: the same as the video
+FP_REFRESH = 'videoplayer.adjustrefreshrate'           # 0 off, 1 always, 2 on start and stop, 3 on start
+FP_KEYS = (FP_PLAYBACK, FP_PREFERRED, FP_REFRESH)
 # what the check may change, and so what the journal may hold, and of which type: nothing else is ever
-# written (the passthrough of the sounds, and the form of native Dolby Vision of the A/B comparison)
-JOURNAL_TYPES = dict({k: bool for k in PASSTHROUGH_KEYS}, **{k: type(d) for k, d, _ in AB_SETTINGS})
+# written (the passthrough of the sounds, the form of native Dolby Vision of the A/B comparison, and Kodi's 3D
+# settings of the frame packing card)
+JOURNAL_TYPES = dict({k: bool for k in PASSTHROUGH_KEYS}, **{k: type(d) for k, d, _ in AB_SETTINGS},
+                     **{k: int for k in FP_KEYS})
 JOURNAL_KEYS = tuple(JOURNAL_TYPES)
 # the names of the formats, the same in every language
 FORMAT_NAMES = {
@@ -863,3 +874,174 @@ def usb_drives(root='/var/media'):
     to.'''
     return [d for d in sorted(glob.glob(os.path.join(root, '*')))
             if os.path.ismount(d) and os.access(d, os.W_OK)]
+
+
+# ---- the frame packing card: whether the driver takes HDMI 3D frame packing (hades-check/clips/fpclip.py: a 3D
+# video at 1080p and 24000/1001 pictures a second, side by side, clips.json "fp")
+
+# the 3D output of LibreELEC Hades (Settings > System > Display): 0 off, 1 automatic
+FP_OUTPUT = 'videoscreen.hades3doutput'
+KODI_LOG = '/storage/.kodi/temp/kodi.log'
+# what the player information says of the 3D output (hades.out.stereo): fp, tab, sbs, overunder and sidebyside (a
+# half layout that the display is not told of), other, or nothing in 2D
+FP_INFO_KEYS = ('hades.out.stereo', 'hades.out.mode', 'hades.out.connector', 'hades.out.driver')
+FP_LAYOUT = {'tab': 33861, 'overunder': 33861, 'sbs': 33862, 'sidebyside': 33862}
+FP_ANSWERS = ('3d', 'halves', 'nopicture')
+
+
+def fp_changes(current):
+    '''What the card sets of Kodi's 3D settings, of those that are not so already (current: their values as read; one
+    that could not be read is left alone).'''
+    change = {}
+    if isinstance(current.get(FP_PLAYBACK), int) and current[FP_PLAYBACK] != 1:
+        change[FP_PLAYBACK] = 1
+    if isinstance(current.get(FP_PREFERRED), int) and current[FP_PREFERRED] != 100:
+        change[FP_PREFERRED] = 100
+    if current.get(FP_REFRESH) == 0:
+        change[FP_REFRESH] = 2
+    return change
+
+
+def edid_3d(edid):
+    '''Whether an EDID says that the display takes HDMI 3D: 3D_present in the HDMI vendor-specific data block (IEEE OUI
+    00-0C-03) of a CTA-861 extension (HDMI 1.4b, 8.3.2: after the flags of byte 8, the two bytes of each latency that it
+    says are there, then the byte of 3D_present where HDMI_Video_present is set). A display with 3D_present takes frame
+    packing at 1080p24 (one of the formats that HDMI 1.4b asks of it).'''
+    if len(edid) < 256 or edid[:8] != b'\x00\xff\xff\xff\xff\xff\xff\x00':
+        return False
+    for k in range(1, len(edid) // 128):
+        b = edid[128 * k:128 * (k + 1)]
+        if b[0] != 0x02 or b[1] < 3 or b[2] < 4:
+            continue
+        i, end = 4, min(b[2], 127)
+        while i < end:
+            tag, n = b[i] >> 5, b[i] & 31
+            block = b[i + 1:i + 1 + n]
+            if tag == 3 and n >= 5 and block[:3] == b'\x03\x0c\x00':
+                if n < 8:
+                    return False
+                flags, at = block[7], 8
+                at += 2 if flags & 0x80 else 0
+                at += 2 if flags & 0x40 else 0
+                return bool(flags & 0x20) and at < n and bool(block[at] & 0x80)
+            i += 1 + n
+    return False
+
+
+def read_3d_displays(root='/sys/class/drm'):
+    '''The displays connected now whose EDID says that they take HDMI 3D: [(connector, edid_name())].'''
+    found = []
+    for status in sorted(glob.glob(os.path.join(root, 'card*-*', 'status'))):
+        folder = os.path.dirname(status)
+        try:
+            with open(status, encoding='utf-8', errors='replace') as f:
+                if f.read().strip() != 'connected':
+                    continue
+            with open(os.path.join(folder, 'edid'), 'rb') as f:
+                edid = f.read()
+        except OSError:
+            continue
+        if edid_3d(edid):
+            found.append((os.path.basename(folder).split('-', 1)[-1], edid_name(edid)))
+    return found
+
+
+def log_size(path=KODI_LOG):
+    '''Where kodi.log ends now (0 where it cannot be read), for read_log_from().'''
+    try:
+        return os.path.getsize(path)
+    except OSError:
+        return 0
+
+
+def read_log_from(offset, path=KODI_LOG):
+    '''The lines of kodi.log written since it ended at offset (from its start where it is shorter now: a new log).'''
+    try:
+        with open(path, 'rb') as f:
+            f.seek(0, os.SEEK_END)
+            f.seek(offset if f.tell() >= offset else 0)
+            return f.read().decode('utf-8', 'replace').splitlines()
+    except OSError:
+        return []
+
+
+def kernel_lines_since(epoch, run=None):
+    '''The lines of the kernel log since a moment (seconds since 1970), as the journal has them; [] where it cannot be
+    read.'''
+    import subprocess
+    run = run or subprocess.run
+    try:
+        p = run(['journalctl', '-k', '-q', '-o', 'cat', '--no-pager', '--since', '@%d' % int(epoch)],
+                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
+        return p.stdout.decode('utf-8', 'replace').splitlines()
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+
+def fp_outcome(seen):
+    '''What became of the 3D output while the clip played, from the values of hades.out.stereo in turn: fp (frame
+    packing at the end), fallback (another 3D layout at the end: frame packing refused, or taken and then left), none
+    (no 3D output at any time), or unknown (nothing was read).'''
+    if not seen:
+        return 'unknown'
+    shown = [s for s in seen if s]
+    if not shown:
+        return 'none'
+    return 'fp' if shown[-1] == 'fp' else 'fallback'
+
+
+# what Kodi (WinSystemGbm.cpp) and the NVIDIA driver (nvidia-open-kernel-modules-9084) say of a frame packing that is
+# not used, each kind once, in order
+FP_WHY = (
+    ('kodi', re.compile(r'3D output: frame packing is not used: (.*?)\. What comes next')),
+    ('kodi', re.compile(r'3D output: none for .*?: (.*?)\. The two halves go out')),
+    ('kodi', re.compile(r'3D output: no 3D mode on \S+: (.*)$')),
+    ('driver', re.compile(r'Hades: HDMI 3D frame packing refused: (.*?)\s*$')),
+)
+
+
+def fp_reasons(kodi_lines, kernel_lines):
+    '''Why frame packing was not used, as Kodi's log and the driver's lines of the kernel log say it: [(who, text)],
+    each text once, Kodi's first.'''
+    found = []
+    for who, rx in FP_WHY:
+        for line in kodi_lines if who == 'kodi' else kernel_lines:
+            m = rx.search(line)
+            if m and (who, m.group(1)) not in found:
+                found.append((who, m.group(1)))
+    return found
+
+
+def fp_lines(outcome, mode, last, reasons, answer):
+    '''What the card says (lines of parts, as picture_lines()). outcome: fp_outcome(); mode: the mode of frame packing
+    as the player information says it; last: the 3D layout at the end (hades.out.stereo); reasons: fp_reasons();
+    answer: 3d, halves, nopicture or None.'''
+    lines = []
+    if outcome == 'fp':
+        lines.append([('f', 33853, [('t', mode or '?')])])
+    elif outcome == 'fallback':
+        lines.append([('f', 33854, [('s', FP_LAYOUT.get(last, 33863))])])
+    elif outcome == 'none':
+        lines.append([('s', 33856)])
+    else:
+        lines.append([('s', S['unknown_out'])])
+    if outcome in ('fallback', 'none'):
+        lines += [[('f', 33855, [('t', text)])] for _, text in reasons] or [[('s', 33865)]]
+    lines.append([('s', {'3d': 33867, 'halves': 33868, 'nopicture': 33869}.get(answer, S['no_answer']))])
+    return lines
+
+
+def fp_facts(displays, outcome, seen, mode, reasons, changed, answer, clip=None):
+    '''One line for the summary file (English, for a diagnostic report).'''
+    shown = []
+    for s in seen:
+        if not shown or shown[-1] != (s or '2d'):
+            shown.append(s or '2d')
+    why = ' | '.join(f'{who}: {text}' for who, text in reasons) or 'none said'
+    parts = [f"frame packing: displays with 3D {'; '.join(f'{c}: {n}' for c, n in displays) or 'none'}",
+             f'outcome={outcome}', f"stereo={','.join(shown) or 'none'}", f'mode={mode or "none"}', f'why={why}',
+             f"settings_changed={','.join(f'{k}={v}' for k, v in changed.items()) or 'none'}",
+             f'answer={answer or "none"}']
+    if clip:
+        parts.append(clip_fact(clip))
+    return '; '.join(parts)
