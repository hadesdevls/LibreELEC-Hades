 resources/language/resource.language.es_ar/strings.po | 8 ++++----
 resources/language/resource.language.es_es/strings.po | 8 ++++----
 resources/language/resource.language.es_mx/strings.po | 8 ++++----
 4 files changed, 14 insertions(+), 14 deletions(-)

