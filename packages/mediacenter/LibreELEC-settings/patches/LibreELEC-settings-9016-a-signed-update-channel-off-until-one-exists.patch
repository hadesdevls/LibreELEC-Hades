diff --git a/resources/lib/hades_update.py b/resources/lib/hades_update.py
new file mode 100644
index 0000000..8566c27
--- /dev/null
+++ b/resources/lib/hades_update.py
@@ -0,0 +1,360 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+# This file is part of LibreELEC Hades. It is not in LibreELEC's settings add-on as LibreELEC publishes it.
+
+'''The signed update channel of LibreELEC Hades, the client side.
+
+An image takes part in a channel only when its system has the three things that make one, in CHANNEL_DIR
+(read-only, in the system image itself):
+  - channel.conf: URL=<https address of the manifest> and CHANNEL=<its name>;
+  - keys/*.pub: the public keys that may sign the manifest, one Ed25519 key per file
+    ("ed25519 <the 32 bytes of the key, base64>"; lines that start with # are comments);
+  - release-serial: the serial of this release in the channel (a whole number).
+Without any of them, or with any of them malformed, there is no channel and nothing is looked for.
+
+The manifest is JSON, and its signature a small JSON file next to it (<manifest address>.sig) that names
+the key and holds the Ed25519 signature (RFC 8032) of SIGNED_PREFIX + the bytes of the manifest. The
+signature is checked before the manifest is read. Then:
+  - its channel and architecture must be this image's;
+  - its serial may not be lower than the highest that this system has taken from the channel (an older
+    manifest, served again, is refused), and it must not have expired, which needs a clock set over the
+    network: without one, nothing is taken;
+  - the release that it names is offered only when its serial is higher than this image's;
+  - the file is downloaded over HTTPS only (a redirect to anything else is refused), at most the size
+    that the manifest gives, and taken only when its size and SHA-256 are the ones of the manifest.
+Anything else, at any step, is an error (ChannelError): nothing is downloaded, kept or installed.
+'''
+
+import base64
+import binascii
+import calendar
+import hashlib
+import http.client
+import json
+import os
+import re
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+CHANNEL_DIR = '/usr/share/hades/update'
+MANIFEST_FORMAT = 'hades-update-manifest-1'
+SIGNATURE_FORMAT = 'hades-update-signature-1'
+# (what is signed is this and the manifest: a signature made for something else does not fit)
+SIGNED_PREFIX = b'hades-update-manifest-1\n'
+MANIFEST_MAX = 64 * 1024
+SIGNATURE_MAX = 4096
+FILE_MAX = 2 * 1024 ** 3
+# (what it takes to download a file: room for it and some more)
+ROOM_MARGIN = 64 * 1024 ** 2
+SYNC_FLAGS = ('/run/connman/ntp-synchronized', '/run/systemd/timesync/synchronized')
+TIME_FORMAT = '%Y-%m-%dT%H:%M:%SZ'
+FILE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,199}\.tar')
+CHANNEL_NAME = re.compile(r'[a-z0-9][a-z0-9-]{0,31}')
+
+
+class ChannelError(Exception):
+    '''Why nothing is taken from the channel (for the log).'''
+
+
+class Cancelled(ChannelError):
+    '''A download stopped by the user or by Kodi's exit.'''
+
+
+# (one download at a time: the service and the button could start one each)
+_downloading = threading.Lock()
+
+
+class Channel:
+    def __init__(self, url, name, keys, release_serial):
+        self.url = url
+        self.name = name
+        self.keys = keys
+        self.release_serial = release_serial
+
+
+def https_url(url):
+    '''True for an absolute https address with a host.'''
+    if not isinstance(url, str) or len(url) > 2048 or any(c.isspace() or ord(c) < 32 for c in url):
+        return False
+    parts = urllib.parse.urlsplit(url)
+    return parts.scheme == 'https' and bool(parts.hostname)
+
+
+def key_id(raw):
+    return hashlib.sha256(raw).hexdigest()[:16]
+
+
+def read_keys(folder):
+    keys = {}
+    try:
+        names = sorted(os.listdir(folder))
+    except OSError:
+        return keys
+    for name in names:
+        if not name.endswith('.pub'):
+            continue
+        try:
+            with open(os.path.join(folder, name), encoding='ascii') as f:
+                lines = [l.strip() for l in f.read(4096).splitlines()]
+        except (OSError, UnicodeDecodeError):
+            continue
+        for line in lines:
+            if not line or line.startswith('#'):
+                continue
+            fields = line.split()
+            if len(fields) != 2 or fields[0] != 'ed25519':
+                break
+            try:
+                raw = base64.b64decode(fields[1], validate=True)
+            except (binascii.Error, ValueError):
+                break
+            if len(raw) == 32:
+                keys[key_id(raw)] = raw
+            break
+    return keys
+
+
+def read_channel(folder=CHANNEL_DIR):
+    '''The channel of this image, or None when it has none (then nothing is looked for).'''
+    conf = {}
+    try:
+        with open(os.path.join(folder, 'channel.conf'), encoding='utf-8') as f:
+            for line in f.read(4096).splitlines():
+                line = line.strip()
+                if line and not line.startswith('#') and '=' in line:
+                    k, _, v = line.partition('=')
+                    conf[k.strip()] = v.strip()
+        with open(os.path.join(folder, 'release-serial'), encoding='ascii') as f:
+            serial_text = f.read(32).strip()
+    except (OSError, UnicodeDecodeError):
+        return None
+    url, name = conf.get('URL', ''), conf.get('CHANNEL', '')
+    if not https_url(url) or not CHANNEL_NAME.fullmatch(name) or not serial_text.isdigit():
+        return None
+    keys = read_keys(os.path.join(folder, 'keys'))
+    if not keys:
+        return None
+    return Channel(url, name, keys, int(serial_text))
+
+
+def verify(manifest, signature, keys):
+    '''Raises ChannelError unless signature is a signature of manifest by one of keys.'''
+    if len(manifest) > MANIFEST_MAX or len(signature) > SIGNATURE_MAX:
+        raise ChannelError('a manifest or a signature larger than any that the channel sends')
+    try:
+        sig = json.loads(signature.decode('utf-8'))
+        if not isinstance(sig, dict) or sig.get('format') != SIGNATURE_FORMAT:
+            raise ValueError('format')
+        name, value = sig['key'], base64.b64decode(sig['signature'], validate=True)
+        if not isinstance(name, str) or len(value) != 64:
+            raise ValueError('fields')
+    except (ValueError, KeyError, TypeError, UnicodeDecodeError, binascii.Error) as e:
+        raise ChannelError(f'the signature file is not one: {e}') from None
+    raw = keys.get(name)
+    if raw is None:
+        raise ChannelError(f'signed by key {name!r}, which this image does not trust')
+    # (pycryptodome, which the image carries; imported here, so that an image without a channel never
+    # needs it)
+    from Crypto.Signature import eddsa
+    try:
+        eddsa.new(eddsa.import_public_key(raw), 'rfc8032').verify(SIGNED_PREFIX + manifest, value)
+    except ValueError:
+        raise ChannelError('the signature does not match the manifest') from None
+
+
+def parse_time(text):
+    if not isinstance(text, str):
+        raise ValueError('time')
+    return calendar.timegm(time.strptime(text, TIME_FORMAT))
+
+
+def whole(value, low, high):
+    return isinstance(value, int) and not isinstance(value, bool) and low <= value <= high
+
+
+def parse(manifest, channel, arch):
+    '''The fields of a manifest whose signature has been checked. Raises ChannelError.'''
+    try:
+        m = json.loads(manifest.decode('utf-8'))
+        if not isinstance(m, dict) or m.get('format') != MANIFEST_FORMAT:
+            raise ValueError('not a manifest of this format')
+        if m.get('channel') != channel:
+            raise ValueError(f'for channel {m.get("channel")!r}, not {channel!r}')
+        if not whole(m.get('serial'), 1, 2 ** 53):
+            raise ValueError('serial')
+        issued, expires = parse_time(m.get('issued')), parse_time(m.get('expires'))
+        if expires <= issued:
+            raise ValueError('expires before it is issued')
+        r = m.get('release')
+        if not isinstance(r, dict):
+            raise ValueError('release')
+        if r.get('arch') != arch:
+            raise ValueError(f'for {r.get("arch")!r}, not {arch!r}')
+        version = r.get('version')
+        if not isinstance(version, str) or not 0 < len(version) <= 64 or not version.isprintable():
+            raise ValueError('version')
+        if not whole(r.get('serial'), 1, 2 ** 53):
+            raise ValueError('release serial')
+        if 'notes' in r and not https_url(r['notes']):
+            raise ValueError('notes')
+        f = r.get('file')
+        if not isinstance(f, dict):
+            raise ValueError('file')
+        if not isinstance(f.get('name'), str) or not FILE_NAME.fullmatch(f['name']):
+            raise ValueError('file name')
+        if not https_url(f.get('url')):
+            raise ValueError('file address')
+        if not whole(f.get('size'), 1, FILE_MAX):
+            raise ValueError('file size')
+        if not isinstance(f.get('sha256'), str) or not re.fullmatch(r'[0-9a-f]{64}', f['sha256']):
+            raise ValueError('file SHA-256')
+    except (ValueError, UnicodeDecodeError, OverflowError) as e:
+        raise ChannelError(f'the manifest is not a valid one: {e}') from None
+    m['issued_time'], m['expires_time'] = issued, expires
+    return m
+
+
+def decide(manifest, signature, channel, arch, now, clock_set, stored_serial):
+    '''What a signed manifest gives: (manifest, whether its release is newer than this image). The
+    signature is checked first, and the manifest only read when it holds. Raises ChannelError.'''
+    verify(manifest, signature, channel.keys)
+    m = parse(manifest, channel.name, arch)
+    if m['serial'] < stored_serial:
+        raise ChannelError(f'manifest {m["serial"]} is older than manifest {stored_serial}, taken before')
+    if not clock_set:
+        raise ChannelError('the clock has not been set over the network: whether the manifest has expired '
+                           'cannot be told')
+    if now >= m['expires_time']:
+        raise ChannelError('the manifest has expired')
+    return m, m['release']['serial'] > channel.release_serial
+
+
+def clock_set(flags=None):
+    '''Whether a client has set the clock over the network in this start (the marks that connman, with
+    Hades' patch, and systemd-timesyncd leave).'''
+    return any(os.path.exists(f) for f in (SYNC_FLAGS if flags is None else flags))
+
+
+def stored_serial(path, channel_name):
+    '''The highest manifest serial taken from the channel, 0 when there is none.'''
+    try:
+        with open(path, encoding='utf-8') as f:
+            s = json.loads(f.read(4096))
+        if isinstance(s, dict) and s.get('channel') == channel_name and whole(s.get('serial'), 0, 2 ** 53):
+            return s['serial']
+    except (OSError, ValueError, UnicodeDecodeError):
+        pass
+    return 0
+
+
+def remember(path, channel_name, serial):
+    '''Keeps serial as the highest taken from the channel (never lowers it).'''
+    if serial <= stored_serial(path, channel_name):
+        return
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    part = f'{path}.part'
+    with open(part, 'w', encoding='utf-8') as f:
+        f.write(json.dumps({'channel': channel_name, 'serial': serial}))
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(part, path)
+
+
+class _HttpsOnly(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        if not https_url(newurl):
+            raise ChannelError(f'a redirect away from HTTPS: {newurl}')
+        return super().redirect_request(req, fp, code, msg, headers, newurl)
+
+
+def _open(url, timeout, context):
+    if not https_url(url):
+        raise ChannelError(f'not an HTTPS address: {url}')
+    handlers = [_HttpsOnly()]
+    if context is not None:
+        handlers.append(urllib.request.HTTPSHandler(context=context))
+    opener = urllib.request.build_opener(*handlers)
+    try:
+        return opener.open(urllib.request.Request(url, headers={'User-Agent': 'LibreELEC-Hades-update'}),
+                           timeout=timeout)
+    except ChannelError:
+        raise
+    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
+        raise ChannelError(f'{url}: {e}') from None
+
+
+def fetch(url, limit, timeout=30, context=None):
+    '''The bytes at url, of at most limit, over HTTPS only.'''
+    with _open(url, timeout, context) as response:
+        try:
+            data = response.read(limit + 1)
+        except (OSError, http.client.HTTPException) as e:
+            raise ChannelError(f'{url}: {e}') from None
+    if len(data) > limit:
+        raise ChannelError(f'{url}: more than the {limit} bytes that it may have')
+    return data
+
+
+def download(release_file, folder, final_folder, progress=None, cancelled=None, timeout=60, context=None):
+    '''The file that a manifest names, downloaded into folder over HTTPS and moved into final_folder (the
+    same file system) only when its size and SHA-256 are the manifest's. Returns its final path.
+    progress(piece) is called with each piece as it comes; cancelled() stops it. Raises ChannelError, and
+    then leaves nothing of it.'''
+    if not _downloading.acquire(blocking=False):
+        raise ChannelError('another download of the update is running')
+    try:
+        return _download(release_file, folder, final_folder, progress, cancelled, timeout, context)
+    finally:
+        _downloading.release()
+
+
+def _download(release_file, folder, final_folder, progress, cancelled, timeout, context):
+    size, want = release_file['size'], release_file['sha256']
+    for d in (folder, final_folder):
+        os.makedirs(d, exist_ok=True)
+    st = os.statvfs(folder)
+    if st.f_bavail * st.f_frsize < size + ROOM_MARGIN:
+        raise ChannelError(f'no room for the {size} bytes of the file in {folder}')
+    part = os.path.join(folder, 'hades-update.part')
+    final = os.path.join(final_folder, release_file['name'])
+    try:
+        os.remove(part)
+    except FileNotFoundError:
+        pass
+    digest, done = hashlib.sha256(), 0
+    try:
+        with _open(release_file['url'], timeout, context) as response, \
+                open(part, 'xb') as out:
+            while True:
+                if cancelled is not None and cancelled():
+                    raise Cancelled('cancelled')
+                try:
+                    piece = response.read(min(1024 * 1024, size + 1 - done))
+                except (OSError, http.client.HTTPException) as e:
+                    raise ChannelError(f'{release_file["url"]}: {e}') from None
+                if not piece:
+                    break
+                done += len(piece)
+                if done > size:
+                    raise ChannelError('the file is larger than the manifest says')
+                digest.update(piece)
+                out.write(piece)
+                if progress is not None:
+                    progress(piece)
+            out.flush()
+            os.fsync(out.fileno())
+        if done != size:
+            raise ChannelError(f'{done} bytes, not the {size} of the manifest')
+        if digest.hexdigest() != want:
+            raise ChannelError('the SHA-256 of the file is not the one of the manifest')
+        os.replace(part, final)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+    return final
