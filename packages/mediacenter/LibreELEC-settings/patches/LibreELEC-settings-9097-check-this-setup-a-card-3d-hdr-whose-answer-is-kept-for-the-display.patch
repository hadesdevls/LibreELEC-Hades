+def hdr3d_facts(displays, outcome, snapshots, answer, verdict, kept, key, changed, clip=None):
+    '''One line for the summary file (English, for a diagnostic report).'''
+    shown = []
+    for s in snapshots:
+        v = f"{s.get('hades.out.stereo') or '2d'}/{s.get('hades.out.stereo3d') or '-'}"
+        if not shown or shown[-1] != v:
+            shown.append(v)
+    parts = [f"HDR in 3D: displays with 3D {'; '.join(f'{c}: {n}' for c, n in displays) or 'none'}",
+             f'outcome={outcome}', f"out={','.join(shown) or 'none'}", f'display={key or "unknown"}',
+             f'answer={answer or "none"}', f'kept={verdict if kept else "nothing"}',
+             f"settings_changed={','.join(f'{k}={v}' for k, v in changed.items()) or 'none'}"]
+    if clip:
+        parts.append(clip_fact(clip))
+    return '; '.join(parts)
