diff --git a/resources/lib/hades_check.py b/resources/lib/hades_check.py
index 44379f0..d1cba21 100644
--- a/resources/lib/hades_check.py
+++ b/resources/lib/hades_check.py
@@ -69,8 +69,9 @@ FP_REFRESH = 'videoplayer.adjustrefreshrate'           # 0 off, 1 always, 2 on s
 FP_KEYS = (FP_PLAYBACK, FP_PREFERRED, FP_REFRESH)
 # what the check may change, and so what the journal may hold, and of which type: nothing else is ever
 # written (the passthrough of the sounds, the form of native Dolby Vision of the A/B comparison, and Kodi's 3D
-# settings of the frame packing card)
+# settings of the frame packing card, which the card "3D: HDR" changes too, with "How 3D video goes out")
 JOURNAL_TYPES = dict({k: bool for k in PASSTHROUGH_KEYS}, **{k: type(d) for k, d, _ in AB_SETTINGS},
+                     **{'videoscreen.hades3dcolour': int},
                      **{k: int for k in FP_KEYS})
 JOURNAL_KEYS = tuple(JOURNAL_TYPES)
 # the names of the formats, the same in every language
@@ -1048,3 +1049,135 @@ def fp_facts(displays, outcome, seen, mode, reasons, changed, answer, clip=None)
     if clip:
         parts.append(clip_fact(clip))
     return '; '.join(parts)
+
+
+# ---- the card "3D: HDR": whether a display shows HDR in 3D, which nothing that a display sends tells (its EDID says what
+# it takes in 2D), kept for that display (hades-check/clips/hdr3dclip.py: a 3D video in HDR10 at 1080p and 24000/1001
+# pictures a second, side by side, clips.json "hdr3d")
+
+# how a 3D video goes out (Settings > System > Display): 0 Automatic, 1 HDR, 2 SDR in BT.2020, 3 SDR in BT.709
+HDR3D_COLOUR = 'videoscreen.hades3dcolour'
+HDR3D_KEYS = FP_KEYS + (HDR3D_COLOUR,)
+# what the 3D video went out as (hades.out.stereo3d: hdr10, hlg, sdr2020, sdr709, sdrp3) and the key of the display, its
+# make and model as Kodi says them (hades.out.displaykey)
+HDR3D_INFO_KEYS = FP_INFO_KEYS + ('hades.out.stereo3d', 'hades.out.displaykey')
+# what Kodi reads of it for each display as a 3D video starts (KODI::UTILS::STEREO3D::HDR_IN_3D_FILE): lines of
+# "key<TAB>value", value hdr (the display showed HDR in 3D), sdr (it did not) or told (Kodi told the user of this card
+# once); the displays used last are kept, at most HDR3D_LIMIT (GBM::DISPLAY_MODES::LIMIT)
+HDR3D_MEMORY = '/storage/.kodi/userdata/hades-3d-hdr.txt'
+HDR3D_LIMIT = 32
+HDR3D_ANSWERS = ('hdr', 'nohdr', 'halves', 'nopicture')
+HDR3D_LAYOUT = {'fp': 33889, 'tab': 33861, 'sbs': 33862}
+
+
+def hdr3d_changes(current):
+    '''What the card sets of Kodi's settings, of those that are not so already: those of the frame packing card (3D
+    played in the display's layout), and "How 3D video goes out" at HDR, so that HDR goes out in 3D whatever Automatic
+    would send (current: their values as read; one that could not be read is left alone).'''
+    change = fp_changes(current)
+    if isinstance(current.get(HDR3D_COLOUR), int) and current[HDR3D_COLOUR] != 1:
+        change[HDR3D_COLOUR] = 1
+    return change
+
+
+def hdr3d_outcome(snapshots):
+    '''What went out while the clip played, from the last values of the player information that said it: hdr (a 3D
+    output, the video in HDR), sdr (a 3D output, HDR did not go out), no3d (no 3D output), unknown (nothing read).'''
+    if not snapshots:
+        return 'unknown'
+    shown = [s for s in snapshots if s.get('hades.out.stereo')]
+    if not shown:
+        return 'no3d'
+    signal = shown[-1].get('hades.out.stereo3d', '')
+    return 'hdr' if signal in ('hdr10', 'hlg') else 'sdr'
+
+
+def hdr3d_verdict(outcome, answer):
+    '''What is kept for the display: hdr where HDR went out in 3D and the user saw it in 3D and in HDR, sdr where it
+    went out and the user saw anything else; None where nothing was learned (HDR did not go out in 3D, or no answer).'''
+    if outcome != 'hdr' or answer not in HDR3D_ANSWERS:
+        return None
+    return 'hdr' if answer == 'hdr' else 'sdr'
+
+
+def read_hdr3d(path=HDR3D_MEMORY):
+    '''What is kept, [(key, value)] in its order (the last used last), as Kodi reads it: a line of exactly one tab with
+    something on each side; anything else is left out.'''
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            lines = f.read().split('\n')
+    except OSError:
+        return []
+    kept = []
+    for line in lines:
+        line = line.rstrip('\r')
+        if line.count('\t') != 1:
+            continue
+        key, value = line.split('\t')
+        if key and value:
+            kept = [(k, v) for k, v in kept if k != key] + [(key, value)]
+    return kept[-HDR3D_LIMIT:]
+
+
+def remember_hdr3d(key, value, path=HDR3D_MEMORY):
+    '''Keeps value for the display key (the last used last, HDR3D_LIMIT displays at most), the file written whole and
+    then put in place; True once it is there. Another display's line is never changed.'''
+    if not key or not value or any(c in key + value for c in '\t\n\r'):
+        return False
+    kept = [(k, v) for k, v in read_hdr3d(path) if k != key] + [(key, value)]
+    text = ''.join(f'{k}\t{v}\n' for k, v in kept[-HDR3D_LIMIT:])
+    temporary = path + '.new'
+    try:
+        with open(temporary, 'w', encoding='utf-8', newline='\n') as f:
+            f.write(text)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(temporary, path)
+        _sync_folder(os.path.dirname(path))
+    except OSError as e:
+        log.log(f'check: what the card "3D: HDR" found could not be kept in {path}: {e}', log.ERROR)
+        return False
+    return dict(read_hdr3d(path)).get(key) == value
+
+
+def hdr3d_lines(outcome, layout, answer, verdict, kept, key):
+    '''What the card says (lines of parts, as picture_lines()). outcome: hdr3d_outcome(); layout: the 3D output at the
+    end (hades.out.stereo); answer: one of HDR3D_ANSWERS or None; verdict: hdr3d_verdict(); kept: it was kept for the
+    display; key: the display's key.'''
+    lines = []
+    if outcome == 'hdr':
+        lines.append([('f', 33888, [('s', HDR3D_LAYOUT.get(layout, 33863))])])
+    elif outcome == 'sdr':
+        lines.append([('s', 33874)])
+        return lines
+    elif outcome == 'no3d':
+        lines.append([('s', 33875)])
+        return lines
+    else:
+        lines.append([('s', S['unknown_out'])])
+        return lines
+    lines.append([('s', {'hdr': 33872, 'nohdr': 33873, 'halves': 33860, 'nopicture': 33864}[answer])]
+                 if answer in HDR3D_ANSWERS else [('s', 33878)])
+    if verdict and kept:
+        lines.append([('f', 33876 if verdict == 'hdr' else 33877, [('t', key)])])
+    elif verdict and not key:
