+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+'''"Check this setup" (System > Check this setup): the part that runs in Kodi.
+
+It plays the clips of /usr/share/hades/check one at a time, reads what the player information
+says of how each went out (Kodi publishes it while the Home window has the property
+hades.check.running: utils/PlayerInfoPublishing.h), asks what can only be seen or heard, and says
+the result in a sentence (hades_check.py decides what; this file only asks, plays and shows).
+
+The sounds in passthrough change Kodi's passthrough settings while they play. Before the first
+change, what the settings were is written to a journal; at the end, what they become is written
+there, set, read back, and the journal removed. If Kodi stops in between, hades-check-restore puts
+the journal back into guisettings.xml before Kodi starts again (hades-check-restore.service), so the
+settings are never left as the check had them for a moment.
+
+Nothing of it runs or plays unless the user starts it from its button.
+'''
+
+import json
+import os
+import time
+
+import xbmc
+import xbmcaddon
+import xbmcgui
+
+import hades_check as hc
+import log
+import oe
+
+HOME = 10000
+
+
+class Abort(Exception):
+    '''Kodi stops: the check ends at once, without another question.'''
+
+
+class CheckSetup:
+
+    def __init__(self, clips_dir=hc.CLIPS_DIR, state_dir=hc.STATE_DIR):
+        self.clips_dir = clips_dir
+        self.state_dir = state_dir
+        self.journal = os.path.join(state_dir, hc.JOURNAL_NAME)
+        self.dialog = xbmcgui.Dialog()
+        self.player = xbmc.Player()
+        self.home = xbmcgui.Window(HOME)
+        self.monitor = oe.xbmcm
+        self.estuary = None
+        self.clips = self.load('clips.json').get('clips', [])
+        self.sounds = self.load('sounds.json')
+        self.results = []
+
+    # ---- texts
+
+    def load(self, name):
+        try:
+            with open(os.path.join(self.clips_dir, name), encoding='utf-8') as f:
+                data = json.load(f)
+            return data if isinstance(data, dict) and data.get('version') == 1 else {}
+        except (OSError, ValueError):
+            return {}
+
+    def text(self, part):
+        kind = part[0]
+        if kind == 't':
+            return part[1]
+        if kind == 's':
+            return oe._(part[1])
+        if kind == 'k':
+            return xbmc.getLocalizedString(part[1])
+        if kind == 'e':
+            # (Estuary's strings are loaded in every skin: ApplicationSkinHandling of Kodi)
+            if self.estuary is None:
+                self.estuary = xbmcaddon.Addon('skin.estuary')
+            return self.estuary.getLocalizedString(part[1])
+        if kind == 'path':
+            return ' > '.join(xbmc.getLocalizedString(i) for i in part[1])
+        if kind == 'f':
+            text = oe._(part[1])
+            for arg in part[2]:
+                text = text.replace('%s', self.text(arg), 1)
+            return text
+        return ''
+
+    def say(self, lines):
+        return '\n'.join(''.join(self.text(p) for p in line) for line in lines)
+
+    def check_abort(self):
+        if self.monitor.abortRequested():
+            raise Abort()
+
+    # ---- settings, through JSON-RPC
+
+    @staticmethod
+    def rpc(method, **params):
+        reply = json.loads(xbmc.executeJSONRPC(json.dumps(
+            {'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params})))
+        return reply.get('result'), reply.get('error')
+
+    def get_setting(self, key):
+        '''The value of a setting of Kodi, or None where it cannot be read (JSON-RPC answers only for
+        a setting that is shown for this output).'''
+        result, error = self.rpc('Settings.GetSettingValue', setting=key)
+        if error or not isinstance(result, dict):
+            return None
+        return result.get('value')
+
+    def set_setting(self, key, value):
+        result, error = self.rpc('Settings.SetSettingValue', setting=key, value=value)
+        return error is None and result is True or self.get_setting(key) == value
+
+    # ---- playing
+
+    def play(self, path, keys, seconds, windowed=False, tick=None, step=0.5):
+        '''Plays a clip with the values of the player information published, and gives back what they
+        were every step seconds while it played. tick(seconds, values) may stop it by returning False.
+        Stops it when Back left the picture, and in any case some seconds after it should have ended.'''
+        snapshots = []
+        self.home.setProperty(hc.CHECK_PROPERTY, '1')
+        try:
+            self.player.play(path, windowed=windowed)
+            began = time.monotonic()
+            while not self.player.isPlaying():
+                if self.monitor.waitForAbort(0.1):
+                    raise Abort()
+                if time.monotonic() - began > 15:
+                    log.log(f'check: {path} did not start', log.WARNING)
+                    return snapshots
+            began = time.monotonic()
+            while self.player.isPlaying():
+                if self.monitor.waitForAbort(step):
+                    raise Abort()
+                values = hc.read_info(self.home.getProperty, keys)
+                values['decoder'] = xbmc.getInfoLabel('Player.Process(audiodecoder)')
+                try:
+                    values['time'] = self.player.getTime()
+                except RuntimeError:
+                    values['time'] = time.monotonic() - began
+                snapshots.append(values)
+                elapsed = time.monotonic() - began
+                if tick is not None and tick(values['time'], values) is False:
+                    break
+                # (Back takes the user out of the picture while it goes on playing behind the menu)
+                if not windowed and elapsed > 2 and not xbmc.getCondVisibility('Window.IsActive(fullscreenvideo)'):
+                    break
+                if elapsed > seconds + 10:
+                    break
+        finally:
+            if self.player.isPlaying():
+                self.player.stop()
+                stopped = time.monotonic()
+                while self.player.isPlaying() and time.monotonic() - stopped < 10:
+                    if self.monitor.waitForAbort(0.1):
+                        break
+            self.home.clearProperty(hc.CHECK_PROPERTY)
+        return snapshots
+
+    # ---- the pictures
+
+    def picture(self, clip, title):
+        path = os.path.join(self.clips_dir, clip.get('file', ''))
+        fmt = clip.get('format', '')
+        if not clip.get('file') or not os.path.isfile(path):
+            self.record(title, [[('s', 33672)]], f'picture {fmt}: not on this system')
+            self.dialog.textviewer(title, oe._(33672))
+            return
+        while True:
+            snapshots = self.play(path, hc.PICTURE_KEYS, float(clip.get('duration', 15)))
+            self.check_abort()
+            if not snapshots:
+                self.record(title, [[('s', 33673)]], f'picture {fmt}: did not play')
+                self.dialog.textviewer(title, oe._(33673))
+                return
+            info = hc.settled(snapshots)
+            # (closed: -1, no answer; 0 something was wrong; 1 right; 2 again)
+            seen = self.dialog.yesnocustom(oe._(33655), oe._(33656), oe._(33659), oe._(33658), oe._(33657),
+                                           defaultbutton=xbmcgui.DLG_YESNO_YES_BTN)
+            self.check_abort()
+            if seen != 2:
+                break
+        answer = {1: 'right', 0: 'wrong'}.get(seen)
+        if answer == 'wrong':
+            # (nothing preselected: a list that something else closes answers -1, no answer)
+            what = self.dialog.select(oe._(33660), [oe._(33661), oe._(33662), oe._(33663), oe._(33664)])
+            self.check_abort()
+            answer = {0: 'pink', 1: 'pale', 2: 'black', 3: 'other'}.get(what)
+        dark = light = None
+        if fmt == 'sdr':
+            counts = [oe._(i) for i in (33666, 33667, 33668, 33669, 33670)]
+            n = self.dialog.select(oe._(33665), counts)
+            self.check_abort()
+            dark = 4 - n if 0 <= n <= 4 else None
+            n = self.dialog.select(oe._(33671), counts)
+            self.check_abort()
+            light = 4 - n if 0 <= n <= 4 else None
+        lines = hc.picture_lines(fmt, info, answer, dark, light)
+        self.record(title, lines, hc.picture_facts(fmt, info, answer, dark, light))
+        self.dialog.textviewer(title, self.say(lines))
+
+    # ---- the speakers
+
+    def speakers(self, title):
+        walks = {w['layout']: w for w in self.sounds.get('speakers', [])
+                 if isinstance(w, dict) and w.get('layout') and w.get('file')}
+        if not walks:
+            self.record(title, [[('s', 33672)]], 'speakers: not on this system')
+            return
+        offered = {k: int(w.get('channels', 2)) for k, w in walks.items()}
+        layout = hc.walk_for_setting(self.get_setting('audiooutput.channels'), offered)
+        if not self.dialog.yesno(title, oe._(33680), nolabel=xbmc.getLocalizedString(222),
+                                 yeslabel=oe._(33721)):
+            # (said in the summary, so that a check of everything shows what it left out)
+            self.record(title, [[('s', 33754)]], 'speakers: not checked')
+            return
+        self.check_abort()
+        limited = None
+        while True:
+            walk = walks[layout]
+            path = os.path.join(self.clips_dir, walk['file'])
+            progress = xbmcgui.DialogProgress()
+            progress.create(title, oe._(33683))
+            state = {'sink': None, 'smaller': None, 'fewer': 0}
+            # (what the output has before the first speaker sounds may still be what played before
+            # the walk: it is not looked at)
+            first = min([float(s['from']) for s in walk.get('slots', []) if 'from' in s] or [0.0])
+
+            def tick(t, values, walk=walk, progress=progress, state=state, layout=layout, first=first):
+                if progress.iscanceled():
+                    return False
+                speaker = hc.speaker_name(hc.slot_at(walk.get('slots', []), t), layout)
+                duration = float(walk.get('duration', 1)) or 1
+                progress.update(min(100, int(100 * t / duration)),
+                                oe._(33682).replace('%s', oe._(speaker), 1) if speaker else oe._(33683))
+                if t < first or not values.get('hades.audio.path'):
+                    return True
+                state['sink'] = values
+                # the display takes fewer channels of PCM than the walk has (twice in a row): a
+                # smaller walk
+                try:
+                    channels = int(values.get('hades.audio.channels') or 0)
+                except ValueError:
+                    channels = 0
+                if values.get('hades.audio.path') == 'pcm' and 0 < channels < int(walk.get('channels', 2)):
+                    state['fewer'] += 1
+                    if state['fewer'] >= 2:
+                        state['smaller'] = channels
+                        return False
+                else:
+                    state['fewer'] = 0
+                return True
+
+            try:
+                self.play(path, hc.AUDIO_KEYS, float(walk.get('duration', 30)), windowed=True,
+                          tick=tick, step=0.25)
+            finally:
+                progress.close()
+            self.check_abort()
+            if state['smaller'] and limited is None:
+                limited = state['smaller']
+                smaller = hc.walk_for(limited, offered)
+                if smaller and smaller != layout:
+                    layout = smaller
+                    self.dialog.ok(title, oe._(33692).replace('%s', str(limited), 1))
+                    continue
+            heard = self.dialog.yesnocustom(title, oe._(33684), oe._(33687), oe._(33686), oe._(33685),
+                                            defaultbutton=xbmcgui.DLG_YESNO_YES_BTN)
+            self.check_abort()
+            if heard != 2:
+                break
+        answer = {1: 'right', 0: 'wrong'}.get(heard)
+        if answer == 'wrong':
+            what = self.dialog.select(oe._(33688), [oe._(33689), oe._(33690), oe._(33691)])
+            self.check_abort()
+            answer = {0: 'wrong', 1: 'silent', 2: 'nothing'}.get(what)
+        lines = hc.speaker_lines(state['sink'], limited, answer)
+        self.record(title, lines, hc.speaker_facts(layout, state['sink'], limited, answer))
+        self.dialog.textviewer(title, self.say(lines))
+
+    # ---- passthrough
+
+    def passthrough(self, title):
+        sounds = {s['id']: s for s in self.sounds.get('passthrough', [])
+                  if isinstance(s, dict) and s.get('id') in hc.FORMATS and s.get('file')}
+        not_checkable = [n.get('id') for n in self.sounds.get('not_checkable', [])
+                         if isinstance(n, dict) and n.get('id') in hc.FORMATS]
+        if not sounds:
+            self.record(title, [[('s', 33672)]], 'passthrough: not on this system')
+            return
+        master = self.get_setting(hc.PASSTHROUGH)
+        if not isinstance(master, bool):
+            lines = [[('s', 33729)]]
+            self.record(title, lines, 'passthrough: this output cannot send it')
+            self.dialog.textviewer(title, self.say(lines))
+            return
+        before = {hc.PASSTHROUGH: master}
+        for f in hc.FORMATS:
+            value = self.get_setting(hc.SETTING_OF[f])
+            if isinstance(value, bool):
+                before[hc.SETTING_OF[f]] = value
+        declared = set()
+        for eld in hc.read_elds():
+            declared |= eld['formats']
+        order = hc.sound_order(list(sounds), declared)
+        if not self.dialog.yesno(title, oe._(33720), nolabel=xbmc.getLocalizedString(222),
+                                 yeslabel=oe._(33721)):
+            self.record(title, [[('s', 33754)]], 'passthrough: not checked')
+            return
+        self.check_abort()
+        results = {f: hc.NOT_CHECKABLE for f in not_checkable if f not in sounds}
+        for f in order:
+            results[f] = hc.SKIPPED
+        # what the settings were, on the drive before the first change
+        hc.write_journal(self.journal, before)
+        log.log(f'check: passthrough settings before the sounds: {before}', log.INFO)
+        final = before
+        try:
+            for i, f in enumerate(order):
+                results[f] = self.one_sound(f, sounds[f], i + 1, len(order), before)
+            offers = hc.switch_off_offers(before, results)
+            switch_off = set()
+            for f in offers:
+                text = oe._(33726).replace('%s', hc.FORMAT_NAMES[f], 1)
+                # (the answer that a closed question gives, and the button that has the focus: keep it on)
+                if self.dialog.yesno(hc.FORMAT_NAMES[f], text, nolabel=oe._(33728), yeslabel=oe._(33727),
+                                     defaultbutton=xbmcgui.DLG_YESNO_NO_BTN):
+                    switch_off.add(f)
+                self.check_abort()
+            final = hc.decide_passthrough(before, results, switch_off)
+        finally:
+            settled = self.apply(final if not self.monitor.abortRequested() else before)
+        lines = hc.passthrough_lines(before, final, results, order)
+        if not settled:
+            lines.append([('s', 33741)])
+        self.record(title, lines, hc.passthrough_facts(before, final, results))
+        self.dialog.textviewer(title, self.say(lines))
+
+    def one_sound(self, f, sound, number, count, before):
+        if hc.SETTING_OF[f] not in before:
+            return hc.NOT_SET
+        for key, value in hc.test_values(f).items():
+            if not self.set_setting(key, value):
+                log.log(f'check: {key} could not be set for the sound of {f}', log.WARNING)
+                return hc.NOT_SET
+        # (the output takes the new settings: ActiveAE opens its sink again)
+        if self.monitor.waitForAbort(1):
+            raise Abort()
+        path = os.path.join(self.clips_dir, sound['file'])
+        # what the output has while the chime sounds (before it, the output may still have what played
+        # before: a bitstream that is not this one)
+        sound_from = float(sound.get('sound_from', 0))
+        sound_to = float(sound.get('sound_to', sound.get('duration', 7)))
+        while True:
+            progress = xbmcgui.DialogProgress()
+            progress.create(oe._(33722).replace('%s', hc.FORMAT_NAMES[f], 1),
+                            f'{number} / {count}')
+            state = {'cancelled': False}
+
+            def tick(t, values, progress=progress, sound=sound, state=state):
+                if progress.iscanceled():
+                    state['cancelled'] = True
+                    return False
+                duration = float(sound.get('duration', 7)) or 7
+                progress.update(min(100, int(100 * t / duration)))
+                return True
+
+            try:
+                snapshots = self.play(path, hc.AUDIO_KEYS, float(sound.get('duration', 7)), windowed=True,
+                                      tick=tick, step=0.25)
+            finally:
+                progress.close()
+            self.check_abort()
+            window = [s for s in snapshots if sound_from <= float(s.get('time', 0)) <= sound_to]
+            # sent as it is: the output opened a bitstream of its format (or the player says it
+            # passes it through), never Kodi's own decoding
+            sent = any(s.get('hades.audio.path') == 'bitstream' and
+                       s.get('hades.audio.format') == hc.SINK_FORMAT[f] for s in window) or \
+                any(s.get('decoder') and s.get('decoder') == sound.get('kodi_decoder') for s in window)
+            log.log(f'check: the sound of {f} went out {"as passthrough" if sent else "otherwise"}'
+                    f'{" (stopped)" if state["cancelled"] else ""}: '
+                    f'{window[-1] if window else snapshots[-1] if snapshots else "it did not play"}', log.INFO)
+            if not sent:
+                # (stopped before the chime was seen to go out: not checked, not "not sent")
+                return hc.SKIPPED if state['cancelled'] else hc.NOT_SENT
+            heard = self.dialog.yesnocustom(hc.FORMAT_NAMES[f], oe._(33723), oe._(33687), oe._(33725),
+                                            oe._(33724))
+            self.check_abort()
+            if heard != 2:
+                return {1: hc.HEARD, 0: hc.NOT_HEARD}.get(heard, hc.NO_ANSWER)
+
+    def apply(self, final):
+        '''Sets what the settings become, the journal first; True once they read back as set and the
+        journal is gone. Where one cannot be set, the journal stays: the next start puts it back.'''
+        try:
+            hc.write_journal(self.journal, final)
+        except (OSError, ValueError) as e:
+            log.log(f'check: the journal could not be written: {e}', log.ERROR)
+        ok = True
+        # (never a moment with passthrough on and a format on that was not heard: passthrough last
+        # where it ends on, first where it ends off)
+        formats = [k for k in hc.JOURNAL_KEYS if k != hc.PASSTHROUGH]
+        for key in formats + [hc.PASSTHROUGH] if final.get(hc.PASSTHROUGH) else [hc.PASSTHROUGH] + formats:
+            if key in final and self.get_setting(key) != final[key]:
+                if not self.set_setting(key, final[key]):
+                    ok = False
+        ok = ok and all(self.get_setting(k) == v for k, v in final.items())
+        if ok:
+            hc.remove_journal(self.journal)
+            log.log(f'check: passthrough settings after the sounds: {final}', log.INFO)
+        else:
+            log.log(f'check: the passthrough settings could not all be set to {final}: the journal stays '
+                    'for the next start', log.ERROR)
+        return ok
+
+    # ---- the whole
+
+    def record(self, title, lines, facts):
+        self.results.append({'title': title, 'lines': lines, 'facts': facts})
+        log.log(f'check: {facts}', log.INFO)
+
+    def entries(self):
+        '''What can be checked here: (title id, what to run).'''
+        found = []
+        by_format = {c.get('format'): c for c in self.clips if isinstance(c, dict)}
+        for fmt, title in (('sdr', 33647), ('hdr10', 33648), ('hlg', 33649), ('dv81', 33650), ('dv5', 33651)):
+            if fmt in by_format:
+                found.append((title, lambda c=by_format[fmt], t=title: self.picture(c, oe._(t))))
+        if self.sounds.get('speakers'):
+            found.append((33652, lambda: self.speakers(oe._(33652))))
+        if self.sounds.get('passthrough'):
+            found.append((33653, lambda: self.passthrough(oe._(33653))))
+        return found
+
+    def run(self):
+        entries = self.entries()
+        if not entries:
+            self.dialog.ok(oe._(33640), oe._(33672))
+            return
+        names = [oe._(33646)] + [oe._(t) for t, _ in entries]
+        # (nothing preselected: closed, -1, checks nothing)
+        choice = self.dialog.select(oe._(33645), names)
+        if choice < 0 or self.monitor.abortRequested():
+            return
+        chosen = entries if choice == 0 else [entries[choice - 1]]
+        if any(t in (33647, 33648, 33649, 33650, 33651) for t, _ in chosen):
+            self.dialog.ok(oe._(33640), oe._(33654))
+        stopped = False
+        try:
+            for _, run in chosen:
+                self.check_abort()
+                run()
+        except Abort:
+            stopped = True
+            log.log('check: Kodi stops: the check ends here', log.INFO)
+        finally:
+            self.save(stopped)
+        if not stopped and len(chosen) > 1 and self.results:
+            self.show(self.results)
+
+    def save(self, stopped):
+        '''The result for "Show the last result" (in the parts of its texts, said again in the
+        language of the moment), and summary.txt for a diagnostic report (in English).'''
+        if not self.results:
+            return
+        when = time.strftime('%Y-%m-%d %H:%M UTC', time.gmtime())
+        try:
+            os.makedirs(self.state_dir, exist_ok=True)
+            with open(os.path.join(self.state_dir, 'last.json'), 'w', encoding='utf-8') as f:
+                json.dump({'version': 1, 'when': when, 'stopped': stopped, 'results': self.results}, f)
+            with open(os.path.join(self.state_dir, hc.SUMMARY_NAME), 'w', encoding='utf-8') as f:
+                f.write(f'Check this setup, {when}{" (stopped)" if stopped else ""}\n')
+                for r in self.results:
+                    f.write(r['facts'] + '\n')
+        except OSError as e:
+            log.log(f'check: the result could not be saved: {e}', log.ERROR)
+
+    def show(self, results, when=None, stopped=False):
+        blocks = []
+        if when:
+            blocks.append(oe._(33753).replace('%s', when, 1))
+        for r in results:
+            blocks.append(f'[B]{r["title"]}[/B]\n{self.say(r["lines"])}')
+        if stopped:
+            blocks.append(oe._(33752))
+        self.dialog.textviewer(oe._(33750), '\n\n'.join(blocks))
+
+    def show_last(self):
+        try:
+            with open(os.path.join(self.state_dir, 'last.json'), encoding='utf-8') as f:
+                data = json.load(f)
+            results = data['results']
+        except (OSError, ValueError, KeyError, TypeError):
+            self.dialog.ok(oe._(33750), oe._(33751))
+            return
+        self.show(results, data.get('when'), data.get('stopped'))
+
+
+def check_setup():
+    CheckSetup().run()
+
+
+def show_last():
+    CheckSetup().show_last()
