diff --git a/resources/lib/hades_check.py b/resources/lib/hades_check.py
new file mode 100644
index 0000000..eb78847
--- /dev/null
+++ b/resources/lib/hades_check.py
@@ -0,0 +1,662 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+'''"Check this setup" (System > Check this setup): what the check decides, apart from Kodi.
+
+The check plays short clips that the build of LibreELEC Hades made (/usr/share/hades/check: the test
+card in SDR, HDR10, HLG and Dolby Vision 8.1 and 5, a soft chime in each passthrough format that
+can be made well, a walk round the speakers in PCM), reads what Kodi says of how each went out (the
+properties that the player information publishes while the check runs: hades_check_ui.py) and says
+it in a sentence. Where the answer depends on what the user sees or hears, it asks.
+
+This module holds what can be decided without Kodi, so that the host tests can take it apart: the
+audio data of the display (ELD), the order of the sounds, which walk of the speakers fits, what the
+passthrough settings become after the answers, the record of what they were (the journal) and how it
+is put back into guisettings.xml when Kodi stopped in the middle of the sounds, and which texts say
+each result. Nothing here imports Kodi's modules.
+'''
+
+import glob
+import json
+import os
+import re
+import tempfile
+import xml.etree.ElementTree as ET
+
+CLIPS_DIR = '/usr/share/hades/check'
+STATE_DIR = '/storage/.cache/hades-check'
+JOURNAL_NAME = 'restore.json'
+SUMMARY_NAME = 'summary.txt'
+GUISETTINGS = '/storage/.kodi/userdata/guisettings.xml'
+# the property of the Home window that makes Kodi publish the values of the player information
+# while a clip plays (utils/PlayerInfoPublishing.h of Kodi)
+CHECK_PROPERTY = 'hades.check.running'
+
+PASSTHROUGH = 'audiooutput.passthrough'
+FORMATS = ('ac3', 'eac3', 'truehd', 'dts', 'dtshd')
+SETTING_OF = {
+    'ac3': 'audiooutput.ac3passthrough',
+    'eac3': 'audiooutput.eac3passthrough',
+    'truehd': 'audiooutput.truehdpassthrough',
+    'dts': 'audiooutput.dtspassthrough',
+    'dtshd': 'audiooutput.dtshdpassthrough',
+}
+# what the check may change, and so what the journal may hold: nothing else is ever written
+JOURNAL_KEYS = (PASSTHROUGH,) + tuple(SETTING_OF[f] for f in FORMATS)
+# the names of the formats, the same in every language
+FORMAT_NAMES = {
+    'ac3': 'Dolby Digital',
+    'eac3': 'Dolby Digital Plus',
+    'truehd': 'Dolby TrueHD',
+    'dts': 'DTS',
+    'dtshd': 'DTS-HD',
+}
+# the label of each setting in Kodi (core strings: what Kodi shows, in its language)
+SETTING_LABEL = {
+    PASSTHROUGH: 348,
+    'audiooutput.ac3passthrough': 364,
+    'audiooutput.eac3passthrough': 448,
+    'audiooutput.truehdpassthrough': 349,
+    'audiooutput.dtspassthrough': 254,
+    'audiooutput.dtshdpassthrough': 347,
+}
+# the order in which the sounds play when the display declares nothing of them
+ORDER = ('ac3', 'eac3', 'truehd', 'dts')
+# what the output opens for each sound, as the player information says it (hades.audio.format)
+SINK_FORMAT = {'ac3': 'ac3', 'eac3': 'eac3', 'truehd': 'truehd', 'dts': 'dts'}
+
+# ---- the audio data of the display (ELD), as ALSA gives it in /proc/asound/card*/eld#*
+
+# CTA-861 audio format codes of a short audio descriptor
+ELD_CODING = {1: 'pcm', 2: 'ac3', 7: 'dts', 10: 'eac3', 11: 'dtshd', 12: 'truehd'}
+
+
+def parse_eld(text):
+    '''One ELD file: whether a display is there and its data valid, its name, the passthrough
+    formats it declares and the most PCM channels it takes.'''
+    fields = {}
+    for line in text.splitlines():
+        parts = line.strip().split(None, 1)
+        if len(parts) == 2:
+            fields[parts[0]] = parts[1].strip()
+        elif len(parts) == 1:
+            fields[parts[0]] = ''
+    formats = set()
+    pcm = 0
+    for key, value in fields.items():
+        m = re.fullmatch(r'sad(\d+)_coding_type', key)
+        if not m:
+            continue
+        code = re.match(r'\[0x([0-9a-fA-F]+)\]', value)
+        if not code:
+            continue
+        name = ELD_CODING.get(int(code.group(1), 16))
+        if name == 'pcm':
+            try:
+                pcm = max(pcm, int(fields.get(f'sad{m.group(1)}_channels', '0')))
+            except ValueError:
+                pass
+        elif name:
+            formats.add(name)
+    return {
+        'present': fields.get('monitor_present') == '1',
+        'valid': fields.get('eld_valid') == '1',
+        'monitor': fields.get('monitor_name', ''),
+        'formats': formats,
+        'pcm_channels': pcm,
+    }
+
+
+def read_elds(root='/proc/asound'):
+    '''The ELD of every display that is there with valid data.'''
+    found = []
+    for path in sorted(glob.glob(os.path.join(root, 'card*', 'eld#*'))):
+        try:
+            with open(path, encoding='utf-8', errors='replace') as f:
+                eld = parse_eld(f.read())
+        except OSError:
+            continue
+        if eld['present'] and eld['valid']:
+            eld['path'] = path
+            found.append(eld)
+    return found
+
+
+def sound_order(checkable, declared):
+    '''The order of the sounds: what the display declares first (it is only an order: Kodi does not
+    trust the ELD for passthrough, and neither does the check), then the rest.'''
+    first = [f for f in ORDER if f in checkable and f in declared]
+    return first + [f for f in ORDER if f in checkable and f not in first]
+
+
+# ---- the walk round the speakers
+
+def walk_for(channels, offered):
+    '''The walk that fits so many channels of output: the one with the most channels that are all
+    there (2.0, 5.1, 7.1), the smallest offered if none fits. offered: layout -> channels.'''
+    fits = [(n, layout) for layout, n in offered.items() if n <= channels]
+    if fits:
+        return max(fits)[1]
+    return min((n, layout) for layout, n in offered.items())[1] if offered else None
+
+
+def walk_for_setting(setting, offered):
+    '''The walk for Kodi's "Number of channels" (audiooutput.channels: AE_CH_LAYOUT_2_0 = 1 ...
+    AE_CH_LAYOUT_7_1 = 10): 2.0 and 2.1 walk two speakers; 3.0 to 5.1, the 5.1 walk (Kodi folds a
+    speaker that the layout lacks into the others); 7.0 and 7.1, the 7.1 walk; anything else (an
+    output without the setting, as S/PDIF), two.'''
+    if setting in (3, 4, 5, 6, 7, 8):
+        n = 6
+    elif setting in (9, 10):
+        n = 8
+    else:
+        n = 2
+    return walk_for(n, offered)
+
+
+def slot_at(slots, seconds):
+    '''The channel whose sound plays at so many seconds into a walk, or None between them.'''
+    for slot in slots:
+        if slot['from'] <= seconds < slot['to']:
+            return slot['channel']
+    return None
+
+
+# ---- passthrough: what the settings become
+
+# what came of the sound of a format
+HEARD = 'heard'                # sent as passthrough, and the user said they heard it
+NOT_HEARD = 'not-heard'        # sent as passthrough, and the user said they did not
+NO_ANSWER = 'no-answer'        # sent, and the question was closed without an answer
+NOT_SENT = 'not-sent'          # Kodi did not send it as passthrough: nothing was asked
+NOT_SET = 'not-set'            # its setting could not be set on this output: not played
+NOT_CHECKABLE = 'not-checkable'  # no sound of it could be made well: not played
+SKIPPED = 'skipped'            # the check stopped before it
+
+
+def test_values(fmt):
+    '''What the settings are while the sound of a format plays.'''
+    return {PASSTHROUGH: True, SETTING_OF[fmt]: True}
+
+
+def switch_off_offers(before, results):
+    '''The formats that the user may be offered to switch off: passthrough was on, the format was
+    on, and the user said that they did not hear it (an explicit "no", never a closed question).'''
+    if before.get(PASSTHROUGH) is not True:
+        return []
+    return [f for f in FORMATS
+            if results.get(f) == NOT_HEARD and before.get(SETTING_OF[f]) is True]
+
+
+def decide_passthrough(before, results, switch_off=()):
+    '''What the passthrough settings become: only what the user heard is turned on, nothing is
+    turned off without an explicit answer, and everything else is as it was.
+
+    before: the settings as they were (only those that could be read: the others are not touched)
+    results: format -> HEARD, NOT_HEARD, NO_ANSWER, NOT_SENT, NOT_SET, NOT_CHECKABLE or SKIPPED
+    switch_off: the formats the user asked to switch off, in answer to a question of their own
+    (switch_off_offers()); any other is ignored.
+
+    Passthrough off before means that no format went out as passthrough, whatever its own setting
+    said: turning passthrough on for a format that was heard turns on its own setting, and those of
+    the formats that were not heard are set off, so that what goes out as passthrough is exactly
+    what was heard. Passthrough on before: what was heard is turned on, the rest stays.'''
+    final = dict(before)
+    heard = [f for f in FORMATS if results.get(f) == HEARD and SETTING_OF[f] in before]
+    if not heard and not switch_off:
+        return final
+    if before.get(PASSTHROUGH) is True:
+        for f in heard:
+            final[SETTING_OF[f]] = True
+        for f in switch_off_offers(before, results):
+            if f in switch_off:
+                final[SETTING_OF[f]] = False
+    elif heard and PASSTHROUGH in before:
+        final[PASSTHROUGH] = True
+        for f in FORMATS:
+            if SETTING_OF[f] in before:
+                final[SETTING_OF[f]] = f in heard
+    return final
+
+
+def effective(values):
+    '''The formats that go out as passthrough with these settings.'''
+    if values.get(PASSTHROUGH) is not True:
+        return set()
+    return {f for f in FORMATS if values.get(SETTING_OF[f]) is True}
+
+
+# ---- the journal: what the settings were, so that they can be put back
+
+def _valid(values):
+    return (isinstance(values, dict) and values and
+            all(k in JOURNAL_KEYS and isinstance(v, bool) for k, v in values.items()))
+
+
+def write_journal(path, values):
+    '''Writes what the settings must be (beside it, then renamed over it once it is whole on the
+    drive). Raises ValueError for anything that is not one of the settings the check may change
+    with a boolean, OSError when it cannot be written.'''
+    if not _valid(values):
+        raise ValueError(f'not a journal of the check: {values!r}')
+    folder = os.path.dirname(path)
+    os.makedirs(folder, exist_ok=True)
+    fd, part = tempfile.mkstemp(prefix='.restore.', dir=folder)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as out:
+            json.dump({'version': 1, 'settings': values}, out, sort_keys=True)
+            out.write('\n')
+            out.flush()
+            os.fsync(out.fileno())
+        os.replace(part, path)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+    _sync_folder(folder)
+
+
+def read_journal(path):
+    '''The settings of a journal, or None (none, or not one the check wrote).'''
+    try:
+        with open(path, encoding='utf-8') as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return None
+    if not isinstance(data, dict) or data.get('version') != 1 or not _valid(data.get('settings')):
+        return None
+    return data['settings']
+
+
+def remove_journal(path):
+    try:
+        os.remove(path)
+    except FileNotFoundError:
+        pass
+    _sync_folder(os.path.dirname(path))
+
+
+def _sync_folder(folder):
+    try:
+        fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
+    except OSError:
+        return
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def restore_guisettings(journal, guisettings=GUISETTINGS):
+    '''Puts the settings of a journal into Kodi's guisettings.xml while Kodi is not running (before it
+    starts: hades-check-restore). Returns what it wrote ({} when there was no journal); the journal
+    is removed once the file holds them. A journal that is not the check's is removed and nothing is
+    written. Raises OSError when guisettings.xml cannot be written (the journal stays, for the next
+    start).'''
+    values = read_journal(journal)
+    if values is None:
+        if os.path.lexists(journal):
+            remove_journal(journal)
+        return {}
+    try:
+        tree = ET.parse(guisettings)
+        root = tree.getroot()
+        if root.tag != 'settings':
+            raise ValueError(f'{guisettings} is not a file of settings')
+    except FileNotFoundError:
+        # (no settings yet: Kodi takes the defaults for everything else)
+        root = ET.Element('settings', {'version': '2'})
+        tree = ET.ElementTree(root)
+    except (ET.ParseError, ValueError) as e:
+        raise OSError(f'{guisettings} cannot be read: {e}')
+    by_id = {s.get('id'): s for s in root.findall('setting')}
+    for key in sorted(values):
+        element = by_id.get(key)
+        if element is None:
+            element = ET.SubElement(root, 'setting', {'id': key})
+        # (Kodi writes default="true" beside a value that is the default, and writes it again)
+        element.attrib.pop('default', None)
+        element.text = 'true' if values[key] else 'false'
+    folder = os.path.dirname(guisettings)
+    os.makedirs(folder, exist_ok=True)
+    fd, part = tempfile.mkstemp(prefix='.guisettings.', dir=folder)
+    try:
+        with os.fdopen(fd, 'wb') as out:
+            tree.write(out, encoding='utf-8', xml_declaration=True)
+            out.flush()
+            os.fsync(out.fileno())
+        if os.path.exists(guisettings):
+            os.chmod(part, os.stat(guisettings).st_mode & 0o777)
+        os.replace(part, guisettings)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+    _sync_folder(folder)
+    remove_journal(journal)
+    return dict(values)
+
+
+# ---- what the player information says, and the texts that say it
+
+# the properties of the Home window that the check reads while a clip plays
+PICTURE_KEYS = (
+    'hades.src.hdrtype', 'hades.out.hdrtype', 'hades.out.signal', 'hades.out.mode',
+    'hades.out.depth', 'hades.out.depthkind', 'hades.out.linkformat',
+    'hades.dv.state', 'hades.dv.reason', 'hades.dv.transport', 'hades.dv.signal', 'hades.dv.display',
+    'hades.dv.mode', 'hades.dv.notshown',
+    'hades.sum.head', 'hades.sum.code', 'hades.sum.arg', 'hades.sum.todo', 'hades.sum.state',
+    'hades.play.dropped', 'hades.play.skipped', 'hades.out.ratefit',
+    'hades.video.decoding', 'hades.video.api',
+)
+AUDIO_KEYS = ('hades.audio.path', 'hades.audio.format', 'hades.audio.channels', 'hades.audio.rate',
+              'hades.audio.why')
+
+# Estuary's strings of the overview page of the player information, as its variables map the codes
+# (skin.estuary/xml/Variables.xml: HadesSumHeadVar, HadesSumSubVar, HadesDVReasonVar,
+# HadesHdrWhyVar, HadesAudioWhyVar, HadesSumTodoVar): the same words as the page. Kodi loads them
+# in every skin (ApplicationSkinHandling). The host tests compare these tables with that file.
+HEAD = {'dv': 32700, 'dv_hdr10': 32701, 'dv_sdr': 32702, 'hdr10plus': 32703, 'hdr10': 32704,
+        'hlg': 32705, 'sdr': 32706, 'hdr_lost': 32707, 'hdr_as_sdr': 32595}
+SUM = {'ok': 32710, 'dv_not_native': 32711, 'hdr_to_sdr': 32712, 'hdr_not_sent': 32713,
+       'frames_failed': 32714, 'step_down': 32715, 'fel_resync': 32716, 'rate_mismatch': 32717,
+       'audio_decoded': 32718, 'unknown_output': 32719, 'hdr_as_sdr': 32596}
+HDR_WHY = {'noprop': 32720, 'noedid': 32721, 'nostatic': 32722, 'noeotf': 32723, 'noblob': 32724,
+           'notqueued': 32724, 'setting': 32725}
+AUDIO_WHY = {'syncdisplay': 32726, 'passthroughoff': 32727, 'codecoff': 32728}
+TODO = {'tv': 32730, 'mode': 32731, 'choice': 32732, 'rate': 32733, 'hdr': 32734, 'sync': 32735,
+        'passthrough': 32738, 'codec': 32739, 'converteron': 32748, 'convertertry': 32749,
+        'port': 32729, 'system': 32736, 'ratemode': 32756, 'hdrassdr': 32597}
+DV_REASON = {
+    'settings': 31760, 'choice': 31761, 'dualhdr': 32426, 'failed': 31654, 'edid': 31688,
+    'display': 31655, 'lloff': 31926, 'lldriver': 31927, 'hdmi14bdriver': 31932, 'legacy': 31684,
+    'invalid': 31687, 'output': 31656, 'range': 31657, 'mode': 31658, 'refresh': 31940,
+    'rate': 31685, 'view': 31710, 'sdrbase': 31874, 'hlgbase': 31875, 'converter': 31890,
+    'converteroff': 32905, 'converterunlisted': 32906, 'sink': 31891, 'frl': 31892, 'link': 31893,
+    'driveredid': 31894, 'refused': 31895, 'nomode': 31896, 'noratemode': 31931, 'capture': 31930,
+    'vaapioff': 31917, 'vaapicodec': 31918, 'software': 31919, 'nodv': 41170, 'edidpart': 41171,
+}
+
+# The texts of the check itself (strings of this add-on)
+S = {
+    'unknown_out': 33700,      # what went out could not be read
+    'dv_standard': 33701,      # "Standard mode (the TV maps the picture)"
+    'dv_lowlatency': 33702,    # "Low-Latency mode (Hades maps the picture)"
+    'looked_right': 33703,
+    'pink_dv': 33704,
+    'pink_other': 33705,
+    'pale_hdr_sent': 33706,
+    'pale_hdr_lost': 33707,
+    'pale_sdr': 33708,
+    'pale_other': 33709,
+    'black': 33710,
+    'other': 33711,
+    'no_answer': 33712,
+    'dark_ok': 33713,
+    'dark_low': 33714,
+    'dark_crushed': 33715,
+    'light_ok': 33716,
+    'light_low': 33717,
+    'light_clipped': 33718,
+    'pale_hdr_as_sdr': 33719,
+}
+
+
+# where the settings are, as Kodi names its menus (core strings): Settings > System > Display, and
+# Settings > System > Audio
+DISPLAY_PATH = ('path', (5, 13000, 14220))
+AUDIO_PATH = ('path', (5, 13000, 14221))
+
+
+def read_info(get, keys=PICTURE_KEYS):
+    '''The values of the player information, through get(key) -> str.'''
+    return {k: (get(k) or '').strip() for k in keys}
+
+
+def settled(snapshots, seconds=2.0, step=0.5):
+    '''The last snapshot (taken every step seconds) after which what went out did not change for
+    so many seconds, or the last one that says something, or None. A snapshot is a dict of
+    read_info().'''
+    def said(s):
+        return bool(s.get('hades.sum.head') or s.get('hades.out.mode') or s.get('hades.out.hdrtype'))
+
+    def key(s):
+        return (s.get('hades.sum.head'), s.get('hades.out.signal'), s.get('hades.out.mode'),
+                s.get('hades.dv.state'), s.get('hades.dv.reason'), s.get('hades.sum.code'))
+
+    need = max(1, int(round(seconds / step)))
+    best = None
+    run = 0
+    for i, s in enumerate(snapshots):
+        if not said(s):
+            run = 0
+            continue
+        run = run + 1 if i > 0 and said(snapshots[i - 1]) and key(snapshots[i - 1]) == key(s) else 1
+        if run >= need:
+            best = s
+    if best is None:
+        told = [s for s in snapshots if said(s)]
+        best = told[-1] if told else None
+    return best
+
+
+def picture_lines(fmt, info, answer, dark=None, light=None):
+    '''What a picture check says: lines of parts, each part ('e', id) a string of Estuary, ('s', id)
+    one of this add-on, ('k', id) one of Kodi, ('t', text) text as it is, ('f', id, [parts]) a
+    string of this add-on whose %s are the parts, or ('path', (ids)) Kodi's names of a way through
+    its menus, joined by " > ". fmt: sdr, hdr10, hlg,
+    dv81, dv5. info: read_info() of the clip, or None when nothing could be read. answer: right,
+    pink, pale, black, other or None. dark, light: how many of the four squares were seen (SDR),
+    or None.'''
+    lines = []
+    info = info or {}
+    head = info.get('hades.sum.head', '')
+    first = [('e', HEAD[head])] if head in HEAD else [('s', S['unknown_out'])]
+    mode = info.get('hades.out.mode') or info.get('hades.dv.mode')
+    if mode:
+        first.append(('t', ' · ' + mode))
+    if head == 'dv':
+        transport = info.get('hades.dv.transport')
+        if transport == 'lowlatency':
+            first += [('t', ' · '), ('s', S['dv_lowlatency'])]
+        elif transport:
+            first += [('t', ' · '), ('s', S['dv_standard'])]
+    lines.append(first)
+
+    code = info.get('hades.sum.code', '')
+    arg = info.get('hades.sum.arg', '')
+    verdict = []
+    if code == 'dv_not_native':
+        reason = info.get('hades.dv.reason', '') or arg
+        verdict = [('e', SUM[code])] + ([('e', DV_REASON[reason])] if reason in DV_REASON else
+                                        [('t', reason)]) + [('t', '.')]
+    elif code == 'hdr_not_sent':
+        verdict = [('e', SUM[code])] + ([('e', HDR_WHY[arg])] if arg in HDR_WHY else [('t', arg)]) + \
+                  [('t', '.')]
+    elif code == 'audio_decoded':
+        # (a clip of the check has no sound: not said)
+        verdict = [('e', SUM['ok'])]
+    elif code == 'frames_failed':
+        verdict = [('t', arg + ' '), ('e', SUM[code])]
+    elif code in SUM:
+        verdict = [('e', SUM[code])]
+    elif head:
+        # (nothing worth saying: the page says so too)
+        verdict = [('e', SUM['ok'])]
+    todo = info.get('hades.sum.todo', '')
+    if verdict and todo in TODO and code != 'audio_decoded':
+        verdict += [('t', ' '), ('e', TODO[todo])]
+    if verdict:
+        lines.append(verdict)
+
+    signal = info.get('hades.out.signal', '')
+    out = info.get('hades.out.hdrtype', '')
+    if answer == 'right':
+        lines.append([('s', S['looked_right'])])
+    elif answer == 'pink':
+        lines.append([('s', S['pink_dv'] if head == 'dv' or signal == 'dv' or out == 'dolbyvision'
+                      else S['pink_other'])])
+    elif answer == 'pale':
+        if head == 'hdr_as_sdr' or code == 'hdr_as_sdr':
+            # (the user chose "Play HDR videos as SDR": that is why, said with the setting's own name)
+            lines.append([('f', S['pale_hdr_as_sdr'], [('k', 41110), DISPLAY_PATH])])
+        elif signal in ('pq', 'hlg', 'hdr10plus'):
+            lines.append([('s', S['pale_hdr_sent'])])
+        elif head == 'hdr_lost':
+            lines.append([('s', S['pale_hdr_lost'])])
+        elif fmt == 'sdr':
+            lines.append([('f', S['pale_sdr'], [('k', 36042), DISPLAY_PATH])])
+        else:
+            lines.append([('s', S['pale_other'])])
+    elif answer == 'black':
+        lines.append([('s', S['black'])])
+    elif answer == 'other':
+        lines.append([('s', S['other'])])
+    elif answer is None:
+        lines.append([('s', S['no_answer'])])
+
+    if fmt == 'sdr':
+        if dark is not None:
+            lines.append([('s', S['dark_ok'])] if dark >= 3 else
+                         [('s', S['dark_low'])] if dark == 2 else
+                         [('f', S['dark_crushed'], [('k', 36042), DISPLAY_PATH])])
+        if light is not None:
+            lines.append([('s', S['light_ok'])] if light >= 3 else
+                         [('s', S['light_low'])] if light == 2 else [('s', S['light_clipped'])])
+    return lines
+
+
+def picture_facts(fmt, info, answer, dark=None, light=None):
+    '''One line for the summary file: what went out and what the user answered (English, for a
+    diagnostic report).'''
+    info = info or {}
+    keep = ('hades.sum.head', 'hades.out.mode', 'hades.out.signal', 'hades.out.hdrtype',
+            'hades.out.depth', 'hades.out.depthkind', 'hades.out.linkformat', 'hades.dv.state',
+            'hades.dv.reason', 'hades.dv.transport', 'hades.dv.display', 'hades.sum.code',
+            'hades.sum.arg', 'hades.sum.todo', 'hades.play.dropped', 'hades.play.skipped',
+            'hades.out.ratefit', 'hades.video.decoding', 'hades.video.api')
+    # (what the window says of Dolby Vision belongs to a Dolby Vision clip: after one, it may still say
+    # what it said of it)
+    dv = fmt in ('dv81', 'dv5')
+    parts = [f'{k[6:]}={info[k]}' for k in keep if info.get(k) and (dv or not k.startswith('hades.dv.'))]
+    parts.append(f'answer={answer or "none"}')
+    if dark is not None:
+        parts.append(f'dark_squares={dark}')
+    if light is not None:
+        parts.append(f'light_squares={light}')
+    return f'picture {fmt}: ' + ' '.join(parts)
+
+
+# ---- the walk round the speakers: what it says
+
+# the names of the speakers (strings of this add-on), by the channel names of FFmpeg
+SPEAKER_NAME = {'FL': 33760, 'FR': 33761, 'FC': 33762, 'LFE': 33763, 'SL': 33764, 'SR': 33765,
+                'BL': 33766, 'BR': 33767}
+
+
+def speaker_name(channel, layout):
+    '''The string that names the speaker of a channel in a walk: the two surrounds of 5.1 are
+    "surround" whichever channels carry them (the walk of 5.1 has them as BL and BR, as FFmpeg's
+    5.1 has them); in 7.1, SL and SR are the surrounds beside the listener and BL and BR the two
+    behind. None for a channel without a name.'''
+    if layout == '5.1' and channel in ('BL', 'BR'):
+        channel = {'BL': 'SL', 'BR': 'SR'}[channel]
+    return SPEAKER_NAME.get(channel)
+SPK = {
+    'pcm': 33693, 'dolby': 33694, 'right': 33695, 'wrong': 33696, 'silent': 33697,
+    'nothing': 33698, 'limited': 33699,
+}
+
+
+def speaker_lines(sink, limited, answer):
+    '''What the walk says. sink: read_info(AUDIO_KEYS) while it played (what the output opened);
+    limited: the channels of PCM that the display takes, where the walk had to be made smaller for
+    them, else None; answer: right, wrong, silent, nothing or None.'''
+    lines = []
+    sink = sink or {}
+    path = sink.get('hades.audio.path')
+    fmt = sink.get('hades.audio.format')
+    if path == 'bitstream' and fmt in ('ac3', 'eac3'):
+        lines.append([('f', SPK['dolby'], [('t', FORMAT_NAMES[fmt])])])
+    elif path == 'pcm' and sink.get('hades.audio.channels'):
+        lines.append([('f', SPK['pcm'], [('t', sink['hades.audio.channels'])])])
+    if limited:
+        lines.append([('f', SPK['limited'], [('t', str(limited))])])
+    if answer == 'right':
+        lines.append([('s', SPK['right'])])
+    elif answer == 'wrong':
+        lines.append([('f', SPK['wrong'], [('k', 34100), AUDIO_PATH])])
+    elif answer == 'silent':
+        lines.append([('f', SPK['silent'], [('k', 34100), AUDIO_PATH])])
+    elif answer == 'nothing':
+        lines.append([('s', SPK['nothing'])])
+    else:
+        lines.append([('s', S['no_answer'])])
+    return lines
+
+
+def speaker_facts(layout, sink, limited, answer):
+    sink = sink or {}
+    parts = [f'{k[6:]}={sink[k]}' for k in AUDIO_KEYS if sink.get(k)]
+    if limited:
+        parts.append(f'pcm_limited_to={limited}')
+    parts.append(f'answer={answer or "none"}')
+    return f'speakers {layout}: ' + ' '.join(parts)
+
+
+# ---- passthrough: what it says
+
+PT = {
+    'heard_on': 33730, 'heard_now': 33731, 'not_heard_off': 33732, 'not_heard_on': 33733,
+    'switched_off': 33734, 'no_answer': 33735, 'not_sent': 33736, 'not_set': 33737,
+    'not_checkable': 33738, 'skipped': 33739, 'master_on': 33740, 'not_checkable_on': 33742,
+}
+
+
+def passthrough_lines(before, final, results, order):
+    '''What the sounds say, one line a format (in the order they played, then the others), and a
+    line when passthrough itself was turned on.'''
+    was = effective(before)
+    now = effective(final)
+    lines = []
+    for f in list(order) + [f for f in FORMATS if f not in order]:
+        r = results.get(f)
+        if r is None:
+            continue
+        name = ('t', FORMAT_NAMES[f])
+        where = [('k', SETTING_LABEL[SETTING_OF[f]]), AUDIO_PATH]
+        if r == HEARD:
+            lines.append([('f', PT['heard_on'] if f in was else PT['heard_now'], [name])])
+        elif r == NOT_HEARD:
+            if f in now:
+                lines.append([('f', PT['not_heard_on'], [name] + where)])
+            elif f in was:
+                lines.append([('f', PT['switched_off'], [name])])
+            else:
+                lines.append([('f', PT['not_heard_off'], [name])])
+        elif r == NO_ANSWER:
+            lines.append([('f', PT['no_answer'], [name])])
+        elif r == NOT_SENT:
+            lines.append([('f', PT['not_sent'], [name])])
+        elif r == NOT_SET:
+            lines.append([('f', PT['not_set'], [name])])
+        elif r == NOT_CHECKABLE:
+            # (on: a film with it may be silent where it does not pass, which is said; off: what
+            # switches it on, for a receiver that takes it)
+            lines.append([('f', PT['not_checkable_on'] if f in now else PT['not_checkable'],
+                           [name] + where)])
+        else:
+            lines.append([('f', PT['skipped'], [name])])
+    if final.get(PASSTHROUGH) is True and before.get(PASSTHROUGH) is not True:
+        lines.append([('f', PT['master_on'], [('k', SETTING_LABEL[PASSTHROUGH])])])
+    return lines
+
+
+def passthrough_facts(before, final, results):
+    def flags(v):
+        return ','.join(f'{k.split(".")[1]}={"on" if v[k] else "off"}' for k in JOURNAL_KEYS if k in v)
+    res = ' '.join(f'{f}={results[f]}' for f in FORMATS if f in results)
+    return f'passthrough: {res} before[{flags(before)}] after[{flags(final)}]'
