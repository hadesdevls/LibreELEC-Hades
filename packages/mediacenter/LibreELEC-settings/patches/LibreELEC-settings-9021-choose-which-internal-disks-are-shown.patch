         else:
             xbmcDialog.ok(title, oe._(33143))
 
+    # Hades: which internal disks are kept away from the kernel while the setting above shows them. The list
+    # is kept by INTERNAL_DISK_CHOICE (in /storage/.config); at each start that shows the internal disks the
+    # init asks the same script, detaches the NVMe controllers and the ATA disks that the list does not show
+    # before anything else runs, tells the kernel to attach no more internal disks, and locks the kernel down.
+    # What the list says, the disks of this start and what the init did with them are asked of the script
+    # each time, and nothing of it is kept here.
+    def internal_disk_choice(self, command, data=None):
+        '''Run the script with a command (and, for "save", the new list on its input). Returns its exit status
+        and the lines that it printed. Not in the environment of Kodi.'''
+        try:
+            process = subprocess.Popen([self.INTERNAL_DISK_CHOICE, command], stdin=subprocess.PIPE if data is not None
+                                       else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                       env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+            out, err = process.communicate(input=data.encode('utf-8') if data is not None else None)
+        except OSError as e:
+            log.log(f'internal-disk-choice {command}: {e}', log.ERROR)
+            return 127, []
+        lines = out.decode(errors='replace').splitlines()
+        log.log(f'internal-disk-choice {command}: exit status {process.returncode}, {len(lines)} lines, '
+                f'{err.decode(errors="replace").strip()!r}', log.INFO)
+        return process.returncode, lines
+
+    @staticmethod
+    def disk_fields(line):
+        '''The fields "name=value" of a line of "list", as a dict; its first word goes in 0, and the second in 1
+        where it is not one of them.'''
+        words = line.split(' ')
+        fields = {0: words[0]}
+        for i, word in enumerate(words[1:], 1):
+            name, eq, value = word.partition('=')
+            if eq:
+                fields[name] = value
+            elif i == 1:
+                fields[1] = word
+        return fields
+
+    def disk_text(self, fields):
+        '''What a disk of this start is called in the list: its model, its size and the end of its serial number
+        (which tells two disks of one model apart), and the names that its devices have now.'''
+        model = self.partition_dec(fields.get('model', '')) or oe._(33136)
+        size = int(fields['size']) if fields.get('size', '').isdigit() else 0
+        serial = self.partition_dec(fields.get('serial', ''))
+        devices = self.partition_dec(fields.get('dev', '')).replace(',', ', ')
+        return oe._(33148) % (model, self.partition_size(size), oe._(33135) % serial[-4:], devices)
+
+    def disk_desc(self, fields):
+        '''What is kept in the list to name a disk when it is not there: the same words, in no language, without
+        the names of its devices (which are of one start).'''
+        size = int(fields['size']) if fields.get('size', '').isdigit() else 0
+        serial = self.partition_dec(fields.get('serial', ''))
+        parts = [self.partition_dec(fields.get('model', '')), self.partition_size(size), f'...{serial[-4:]}']
+        return ', '.join(p.strip() for p in parts if p.strip())
+
+    def internal_disks_left(self):
+        '''What the init left of what it did in this start with the list: "chosen" or "damaged" (or None), and
+        whether the kernel keeps it (the switch set and the kernel locked down).'''
+        try:
+            with open(self.INTERNAL_DISK_LEFT, 'r', errors='replace') as f:
+                lines = f.read(65536).splitlines()
+        except OSError:
+            return None, False
+        state = lines[0].split(' ')[1] if lines and lines[0].startswith('state ') else None
+        if state not in ('chosen', 'damaged'):
+            return None, False
+        return state, 'switch yes' in lines and 'lockdown yes' in lines
+
+    @log.log_function()
+    def tell_internal_disk_choice(self):
+        '''At the start of Kodi: where the init could not do what the list asks, it is said once. A list that
+        could not be read keeps every internal disk away; a kernel that could not hold them off lets a program
+        with full rights bring them back.'''
+        try:
+            if not self.INTERNAL_DISK_LEFT:
+                return
+            state, held = self.internal_disks_left()
+            if state == 'damaged':
+                oe.notify(oe._(32921), oe._(33162))
+            elif state == 'chosen' and not held:
+                oe.notify(oe._(32921), oe._(33163))
+        except Exception as e:
+            log.log(f'internal disks kept away: {e}', log.ERROR)
+
+    @log.log_function()
+    def choose_internal_disks(self, listItem=None):
+        title = oe._(33145)
+        if not self.INTERNAL_DISK_CHOICE or not os.path.exists(self.INTERNAL_DISK_CHOICE):
+            return
+        status, lines = self.internal_disk_choice('list')
+        if status != 0 or len(lines) < 4:
+            xbmcDialog.ok(title, oe._(33160))
+            return
+        head = {}
+        here, hidden, gone, fixed = [], [], [], []
+        for line in lines:
+            word, _, rest = line.partition(' ')
+            if word in ('start', 'list', 'others', 'this'):
+                head[word] = rest
+            elif word == 'here':
+                here.append(self.disk_fields(line))
+            elif word == 'hidden':
+                hidden.append(self.disk_fields(line))
+            elif word == 'gone':
+                gone.append(self.disk_fields(line))
+            elif word == 'fixed':
+                fixed.append(self.disk_fields(line))
+        # a list that cannot be read keeps every internal disk away (in this start, or from the next one): the
+        # way out is to take it away, and choose again with the disks in sight
+        if head.get('list', '').startswith('damaged') or head.get('this', '').startswith('damaged'):
+            if xbmcDialog.yesno(title, oe._(33155), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN):
+                status, _ = self.internal_disk_choice('save', 'others shown\n')
+                if status == 0:
+                    oe.notify(oe._(32921), oe._(33156))
+                else:
+                    xbmcDialog.ok(title, oe._(33159))
+            return
+        if head.get('start') == 'hides':
+            xbmcDialog.ok(title, oe._(33153))
+            return
+        # (the disk that this system is on is never kept away, and is not offered)
+        told = [d for d in here if d.get('id') == 'yes' and d.get('own') != 'yes']
+        untold = [d for d in here if d.get('id') != 'yes' and d.get('own') != 'yes']
+        if not told and not hidden and not gone:
+            xbmcDialog.ok(title, oe._(33154))
+            return
+        if untold:
