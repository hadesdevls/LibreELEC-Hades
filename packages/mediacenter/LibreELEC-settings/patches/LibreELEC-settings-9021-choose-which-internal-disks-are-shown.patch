+
+msgctxt "#33148"
+msgid "%s (%s, %s), now %s"
+msgstr ""
+
+msgctxt "#33149"
+msgid "%s: kept away in this start"
+msgstr ""
+
+msgctxt "#33150"
+msgid "The internal disks are shown as chosen from the next start"
+msgstr ""
+
+msgctxt "#33151"
+msgid "These disks cannot be told apart from others (the kernel finds no serial number on them), so while any disk is kept away, they are kept away too: %s"
+msgstr ""
+
+msgctxt "#33152"
