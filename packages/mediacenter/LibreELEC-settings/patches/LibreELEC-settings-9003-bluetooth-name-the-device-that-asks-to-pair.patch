From f1dc1b4b7bfa056913bb5863fceb6abece8c1b33 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sat, 3 Oct 2026 04:21:13 +0000
Subject: [PATCH] bluetooth: name the device that asks to pair

BlueZ asks the agent to authorize a pairing that the device started (for
example a Just Works pairing). The question was "Accept pairing?", which
does not say what is asking. Name the device, by its name and address.
Hades uses JustWorksRepairing=confirm, which relies on this prompt.

The handlers themselves (request_authorization, cancel) are right in the
add-on since 43b834f; before that, this patch also renamed them.
---
 resources/language/resource.language.en_gb/strings.po |  4 ++++
 resources/language/resource.language.es_ar/strings.po |  4 ++++
 resources/language/resource.language.es_es/strings.po |  4 ++++
 resources/language/resource.language.es_mx/strings.po |  4 ++++
 resources/lib/modules/bluetooth.py                    | 11 ++++++++++-
 5 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/resources/language/resource.language.en_gb/strings.po b/resources/language/resource.language.en_gb/strings.po
index 447386b..f439762 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1135,3 +1135,7 @@ msgstr ""
 msgctxt "#32913"
 msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
 msgstr ""
+
+msgctxt "#32912"
+msgid "Accept pairing with %s?"
+msgstr ""
diff --git a/resources/language/resource.language.es_ar/strings.po b/resources/language/resource.language.es_ar/strings.po
index a60be18..ed40f08 100644
--- a/resources/language/resource.language.es_ar/strings.po
+++ b/resources/language/resource.language.es_ar/strings.po
@@ -1145,3 +1145,7 @@ msgstr "Esta actualización no se ofrece por HTTPS, así que no se descargó."
 msgctxt "#32913"
 msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
 msgstr "Mientras root tenga la contraseña por defecto, SSH solo acepta claves, no contraseñas. Establece una contraseña para entrar con ella."
+
+msgctxt "#32912"
+msgid "Accept pairing with %s?"
+msgstr "¿Aceptar el emparejamiento con %s?"
diff --git a/resources/language/resource.language.es_es/strings.po b/resources/language/resource.language.es_es/strings.po
index 50696d7..5d40021 100644
--- a/resources/language/resource.language.es_es/strings.po
+++ b/resources/language/resource.language.es_es/strings.po
@@ -1162,6 +1162,10 @@ msgctxt "#32913"
 msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
 msgstr "Mientras root tenga la contraseña por defecto, SSH solo acepta claves, no contraseñas. Establece una contraseña para entrar con ella."
 
+msgctxt "#32912"
+msgid "Accept pairing with %s?"
+msgstr "¿Aceptar el emparejamiento con %s?"
+
 #~ msgctxt "#32374"
 #~ msgid "Error: Invalid backup file. Filename must end in: .tar, .tar.gz, .tar.bz2, or .tar.xz"
 #~ msgstr "Error: archivo de copia de seguridad no válido. El nombre debe terminar en: .tar, .tar.gz, .tar.bz2 o .tar.xz"
diff --git a/resources/language/resource.language.es_mx/strings.po b/resources/language/resource.language.es_mx/strings.po
index a0175fd..15476e0 100644
--- a/resources/language/resource.language.es_mx/strings.po
+++ b/resources/language/resource.language.es_mx/strings.po
@@ -1150,6 +1150,10 @@ msgctxt "#32913"
 msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
 msgstr "Mientras root tenga la contraseña por defecto, SSH solo acepta claves, no contraseñas. Establece una contraseña para entrar con ella."
 
+msgctxt "#32912"
+msgid "Accept pairing with %s?"
+msgstr "¿Aceptar el emparejamiento con %s?"
+
 #~ msgctxt "#32308"
 #~ msgid "Hostname:"
 #~ msgstr "Nombre de host:"
diff --git a/resources/lib/modules/bluetooth.py b/resources/lib/modules/bluetooth.py
index c84e1b9..9f6859c 100644
--- a/resources/lib/modules/bluetooth.py
+++ b/resources/lib/modules/bluetooth.py
@@ -676,7 +676,7 @@ class Bluez_Agent(dbus_bluez.Agent):
     @log.log_function()
     def request_authorization(self, device):
         xbmcDialog = xbmcgui.Dialog()
-        answer = xbmcDialog.yesno('Bluetooth', 'Accept pairing?')
+        answer = xbmcDialog.yesno('Bluetooth', oe._(32912) % self.device_name(device))
         if answer == 1:
             oe.dictModules['bluetooth'].trust_device(device)
         else:
@@ -689,6 +689,15 @@ class Bluez_Agent(dbus_bluez.Agent):
         if hasattr(self.parent, 'pinkey_window'):
             self.parent.close_pinkey_window()
 
+    def device_name(self, device):
+        address = device.rsplit('/', 1)[-1].replace('dev_', '').replace('_', ':')
+        try:
+            properties = getattr(self.parent, 'dbusDevices', {}).get(device, {})
+            name = properties.get('Name') or properties.get('Alias')
+        except Exception:
+            name = None
+        return f'{name} ({address})' if name else address
+
 
 ####################################################################
 ## Obex Agent class
