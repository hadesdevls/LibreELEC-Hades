+
+    # Hades: what the remote control apps for phones (Kore, Yatse...) need, set through Kodi's own settings:
+    # its web server with a user and a password, and control from applications on other devices. Kodi asks
+    # for its own confirmations; what it refuses stays as it was. A password that there is already is kept.
+    PHONE_SETTINGS = ('services.webserver', 'services.webserverauthentication', 'services.esenabled',
+                      'services.esallinterfaces')
+
+    @staticmethod
+    def kodi_jsonrpc(method, **params):
+        reply = json.loads(xbmc.executeJSONRPC(json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method,
+                                                           'params': params})))
+        if 'error' in reply:
+            raise RuntimeError(f'{method} {params.get("setting", "")}: {reply["error"]}')
+        return reply['result']
+
+    def kodi_setting(self, setting):
+        return self.kodi_jsonrpc('Settings.GetSettingValue', setting=setting)['value']
+
+    def phone_remote_on(self):
+        return (all(self.kodi_setting(s) is True for s in self.PHONE_SETTINGS)
+                and self.kodi_setting('services.webserverpassword') != '')
+
+    @staticmethod
+    def phone_addresses():
+        try:
+            out = subprocess.run(['ip', '-4', '-o', 'addr', 'show', 'scope', 'global'], capture_output=True,
+                                 text=True, timeout=10).stdout
+        except (OSError, subprocess.SubprocessError):
+            return []
+        return re.findall(r'\binet (\d+\.\d+\.\d+\.\d+)/', out)
+
+    @log.log_function()
+    def do_phone_remote(self, listItem=None):
+        title = oe._(32987)
+        try:
+            if not self.phone_remote_on():
+                port = self.kodi_setting('services.webserverport')
+                xbmcDialog.textviewer(title, oe._(32990) % port)
+                if xbmcDialog.yesno(title, oe._(32991), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN) is not True:
+                    return
+                # (while Kodi stops, a question is not shown, and Kodi answers it with the answer that the last
+                # one got)
+                if oe.xbmcm.abortRequested():
+                    return
+                # the user and the password first: Kodi refuses its web server with authentication and no password
+                if not self.kodi_setting('services.webserverusername'):
+                    self.kodi_jsonrpc('Settings.SetSettingValue', setting='services.webserverusername', value='kodi')
+                if not self.kodi_setting('services.webserverpassword'):
+                    chars = string.ascii_letters + string.digits
+                    self.kodi_jsonrpc('Settings.SetSettingValue', setting='services.webserverpassword',
+                                      value=''.join(secrets.choice(chars) for _ in range(12)))
+                for setting in self.PHONE_SETTINGS:
+                    if self.kodi_setting(setting) is not True:
+                        self.kodi_jsonrpc('Settings.SetSettingValue', setting=setting, value=True)
+                if not self.phone_remote_on():
+                    log.log('Phone remote control: Kodi did not turn on its web server or remote control', log.INFO)
+                    xbmcDialog.ok(title, oe._(32994))
+                    return
+                log.log('Phone remote control: turned on', log.INFO)
+            addresses = self.phone_addresses()
+            text = oe._(32992) % (', '.join(addresses) if addresses else oe._(32993),
+                                  self.kodi_setting('services.webserverport'),
+                                  self.kodi_setting('services.webserverusername'),
+                                  self.kodi_setting('services.webserverpassword'))
+            if oe.get_service_state('iptables') == '1' and oe.get_service_option('iptables', 'RULES', 'home') == 'public':
+                text += '[CR][CR]' + oe._(32995) % (oe._(32399), oe._(32398))
+            xbmcDialog.textviewer(title, text)
+        except (RuntimeError, ValueError, KeyError, TypeError) as e:
+            log.log(f'Phone remote control: {e}', log.ERROR)
+            xbmcDialog.ok(title, oe._(32994))
+
     @log.log_function()
     def do_wizard(self):
         oe.winOeMain.set_wizard_title(oe._(32311))
