diff --git a/resources/lib/hades_check.py b/resources/lib/hades_check.py
index d1cba21..7c1f707 100644
--- a/resources/lib/hades_check.py
+++ b/resources/lib/hades_check.py
@@ -1051,6 +1051,70 @@ def fp_facts(displays, outcome, seen, mode, reasons, changed, answer, clip=None)
     return '; '.join(parts)
 
 
+# ---- the driver asked first, without a picture (Kodi's builtin HadesFramePackingCheck, FramePackingCheck.h of Kodi):
+# whether it takes the frame-packed mode that the display declares, with the buffers that a 3D video would go out in,
+# in test commits only. Its answer, a line of JSON, is in a property of the Home window.
+
+FP_CHECK_BUILTIN = 'HadesFramePackingCheck'
+FP_CHECK_PROPERTY = 'hades.check.fp.result'
+FP_CHECK_RESULTS = ('taken', 'refused', 'nomode', 'busy', 'notasked')
+
+
+def parse_fp_check(text):
+    '''The answer of HadesFramePackingCheck as a dict (result, declared, mode, driver, window, windowwhy, own, ownwhy,
+    draw, drawwhy); None where there is none, or it is not one.'''
+    try:
+        answer = json.loads(text) if text else None
+    except ValueError:
+        return None
+    if not isinstance(answer, dict) or answer.get('result') not in FP_CHECK_RESULTS:
+        return None
+    return answer
+
+
+def fp_check_lines(answer, driver_reasons):
+    '''What the card says of the driver's answer (lines of parts, as picture_lines()). answer: parse_fp_check(), or None
+    where Kodi gave none; driver_reasons: why the driver refused, as its kernel lines say it (fp_reasons(): those of
+    the driver), which go before what the test commit answered (its error).'''
+    if answer is None:
+        return [[('s', 34209)]]
+    result, mode = answer.get('result'), answer.get('mode') or '?'
+    if result == 'taken':
+        if answer.get('own') == 'taken' and answer.get('window') != 'taken':
+            how = 34201 if answer.get('draw') == 'gpu' else 34202
+        else:
+            how = 34203
+        return [[('f', 34200, [('t', mode)])], [('s', how)]]
+    if result == 'refused':
+        lines = [[('f', 34204, [('t', mode)])]]
+        lines += [[('f', 33855, [('t', text)])] for text in driver_reasons]
+        said = answer.get('ownwhy') or answer.get('windowwhy')
+        if not driver_reasons and said:
+            lines.append([('f', 34205, [('t', said)])])
+        elif not driver_reasons:
+            lines.append([('s', 33865)])
+        return lines
+    if result == 'nomode':
+        return [[('s', 34206 if answer.get('declared') else 33852)]]
+    if result == 'busy':
+        return [[('s', 34207)]]
+    return [[('s', 34208)]]
+
+
+def fp_check_facts(answer, driver_reasons):
+    '''The part of the summary line (English, for a diagnostic report) of what the driver answered.'''
+    if answer is None:
+        return 'driver asked: no answer from Kodi'
+    keys = ('result', 'mode', 'driver', 'window', 'own', 'draw')
+    parts = ['%s=%s' % (k, answer.get(k) or 'none') for k in keys]
+    for k in ('windowwhy', 'ownwhy', 'drawwhy'):
+        if answer.get(k):
+            parts.append('%s=%s' % (k, answer[k]))
+    if driver_reasons:
+        parts.append('kernel=' + ' | '.join(driver_reasons))
+    return 'driver asked: ' + ', '.join(parts)
+
+
 # ---- the card "3D: HDR": whether a display shows HDR in 3D, which nothing that a display sends tells (its EDID says what
 # it takes in 2D), kept for that display (hades-check/clips/hdr3dclip.py: a 3D video in HDR10 at 1080p and 24000/1001
 # pictures a second, side by side, clips.json "hdr3d")
diff --git a/resources/lib/hades_check_ui.py b/resources/lib/hades_check_ui.py
index 9fd2a9d..e956b5d 100644
--- a/resources/lib/hades_check_ui.py
+++ b/resources/lib/hades_check_ui.py
@@ -606,7 +606,13 @@ class CheckSetup:
             self.record(title, lines, 'frame packing: not checked: the 3D output of Hades is off')
             self.dialog.textviewer(title, self.say(lines))
             return
-        self.dialog.ok(title, oe._(33851))
+        # the driver asked first, without a picture: whether it takes the frame-packed mode, with the buffers that the
+        # clip would go out in (Kodi's HadesFramePackingCheck)
+        asked, asked_reasons = self.ask_frame_packing()
+        asked_lines = hc.fp_check_lines(asked, asked_reasons)
+        # (a result of its own, before the clip's: said as the clip is announced, and kept with the others)
+        self.record(title, asked_lines, 'frame packing, ' + hc.fp_check_facts(asked, asked_reasons))
+        self.dialog.ok(title, self.say(asked_lines) + '\n\n' + oe._(33851))
         self.check_abort()
         current = {k: self.get_setting(k) for k in hc.FP_KEYS}
         change = hc.fp_changes(current)
@@ -633,6 +639,10 @@ class CheckSetup:
         modes = [s.get('hades.out.mode', '') for s in snapshots if s.get('hades.out.stereo') == 'fp']
         outcome = hc.fp_outcome(seen)
         reasons = hc.fp_reasons(hc.read_log_from(offset), hc.kernel_lines_since(since - 1))
+        # (a reason of the driver that its refusal without a picture said already is not said twice, as long as
+        # another reason is left to say)
+        said = asked_reasons if asked and asked.get('result') == 'refused' else []
+        reasons = [r for r in reasons if not (r[0] == 'driver' and r[1] in said)] or reasons
         log.log(f'check: frame packing: {outcome}; seen {seen[-1:] if seen else "nothing"}; why {reasons}', log.INFO)
         answer = None
         if snapshots:
@@ -649,6 +659,22 @@ class CheckSetup:
                                               answer, played))
         self.dialog.textviewer(title, self.say(lines))
 
+    def ask_frame_packing(self, wait=10.0):
+        '''Kodi's HadesFramePackingCheck, run on Kodi's thread that draws (executebuiltin waits for it): its answer
+        (hades_check.parse_fp_check()), or None where none came within wait seconds; and the driver's reasons of a
+        refusal in the kernel lines since then (hades_check.fp_reasons()).'''
+        home = xbmcgui.Window(10000)
+        home.clearProperty(hc.FP_CHECK_PROPERTY)
+        since = time.time()
+        xbmc.executebuiltin(hc.FP_CHECK_BUILTIN, True)
+        answer = None
+        for _ in range(int(wait / 0.25)):
+            answer = hc.parse_fp_check(home.getProperty(hc.FP_CHECK_PROPERTY))
+            if answer is not None or self.monitor.waitForAbort(0.25):
+                break
+        reasons = [text for who, text in hc.fp_reasons([], hc.kernel_lines_since(since - 1)) if who == 'driver']
+        return answer, reasons
+
     def hdr_3d(self, title):
         '''Whether the display shows HDR in 3D: an HDR 3D clip in its 3D layout with HDR, a question, and the answer
         kept for that display, which "How 3D video goes out" at Automatic follows there.'''
