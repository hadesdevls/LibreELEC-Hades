diff --git a/resources/lib/modules/services.py b/resources/lib/modules/services.py
index c6621a5..43ee504 100644
--- a/resources/lib/modules/services.py
+++ b/resources/lib/modules/services.py
@@ -513,14 +513,12 @@ class services(modules.Module):
     def do_wizard(self):
         oe.winOeMain.set_wizard_title(oe._(32311))
 
-        # Enable samba
-        self.struct['samba']['settings']['samba_autostart']['value'] = '1'
-        self.initialize_samba()
-
+        # Hades: Samba keeps its real state (off by default) instead of being turned on
+        # here; the switch below still enables it, with a generated password.
         if hasattr(self, 'samba'):
-            oe.winOeMain.set_wizard_text(f'{oe._(32313)}[CR][CR]{oe._(32312)}')
+            oe.winOeMain.set_wizard_text(f'{oe._(32918)}[CR][CR]{oe._(32917)}')
         else:
-            oe.winOeMain.set_wizard_text(oe._(32312))
+            oe.winOeMain.set_wizard_text(oe._(32917))
         oe.winOeMain.set_wizard_button_title(oe._(32316))
         self.set_wizard_buttons()
 
