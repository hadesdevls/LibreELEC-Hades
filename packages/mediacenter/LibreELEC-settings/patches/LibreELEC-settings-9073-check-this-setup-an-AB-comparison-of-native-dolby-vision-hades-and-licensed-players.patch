+# ---- the A/B comparison of native Dolby Vision: what Hades sends by default, and what licensed players send
+
+# The clip is that of hades-check/clips/abclip.py (clips.json "ab"): a dark picture with black bars inside it,
+# whose trims lift the shadows (a positive trim_offset of level 2) and whose active area (level 5) says where
+# its picture is. A TV maps such a picture differently with an active area and without one (measured on an LG
+# C1 and a Hisense by fandangos, CroqueMr/libreelec-CB1 #212), and licensed players send none (a Homatics R 4K
+# Plus, measured by Hades; an OPPO UDP-203, fandangos/oppo-dv-mkv fix 24). The user looks at both on the TV to
+# be judged, in an order chosen by chance, against the TV's own player playing the same clip from a USB drive.
+# Nothing is kept unless the user says so at the end; the answer is kept with the name of the TV
+# (ab-results.json, and the summary of the check in a diagnostic report): the data for settings per TV.
+AB_RESULTS_NAME = 'ab-results.json'
+AB_RESULTS_KEEP = 50
+AB_VARIANTS = ('hades', 'licensed')
+AB_ANSWERS = ('a', 'b', 'same', 'unsure')
+# the words of a setting at a value, for the question that offers it (strings of this add-on)
+AB_WORDS = {
+    ('videoscreen.hadesdvl5form', 2): 33827, ('videoscreen.hadesdvl5form', 0): 33828,
+    ('videoscreen.hadesdvtransport', 0): 33829, ('videoscreen.hadesdvtransport', 2): 33830,
+    ('videoscreen.hadesdvlevelorder', True): 33831, ('videoscreen.hadesdvlevelorder', False): 33838,
+    ('videoscreen.hadesdvl254zero', True): 33832, ('videoscreen.hadesdvl254zero', False): 33833,
+    ('videoscreen.hadesdvl3neutral', True): 33834, ('videoscreen.hadesdvl3neutral', False): 33835,
+    ('videoscreen.hadesdvavibt2020', True): 33836, ('videoscreen.hadesdvavibt2020', False): 33837,
+}
+
+
+def ab_values(variant, available):
+    '''The values of a variant (hades: the defaults of Hades; licensed: as licensed players send it) of the
+    settings that this Kodi has.'''
+    return {k: (hades if variant == 'hades' else licensed) for k, hades, licensed in AB_SETTINGS
+            if k in available}
+
+
+def ab_order(flip):
+    '''Which variant is A and which is B: chosen by chance (flip), so that an answer is not the order's.'''
+    return ('licensed', 'hades') if flip else ('hades', 'licensed')
+
+
+def ab_choice(answer, order):
+    '''What was chosen: a variant (hades, licensed), same, unsure, or none (no answer).'''
+    if answer == 'a':
+        return order[0]
+    if answer == 'b':
+        return order[1]
+    return answer if answer in ('same', 'unsure') else 'none'
+
+
+def ab_offer(choice, current, available):
+    '''The settings that the choice would set and that are not so now ({} where there is nothing to offer: no
+    variant chosen, or the settings are that way already). Never set without the user's yes.'''
+    if choice not in AB_VARIANTS:
+        return {}
+    return {k: v for k, v in ab_values(choice, available).items() if current.get(k) != v}
+
+
+def ab_offer_words(offer):
+    '''The parts of the words of an offer, for the %s of its question: every setting's, joined by commas.'''
+    parts = []
+    for k, v in offer.items():
+        if parts:
+            parts.append(('t', ', '))
+        parts.append(('s', AB_WORDS[(k, v)]) if (k, v) in AB_WORDS else ('t', f'{k}={v}'))
+    return parts
+
+
+def edid_name(edid):
+    '''The display of an EDID (its base block): the manufacturer (PNP id), the product code and the name it
+    gives itself (the descriptor 0xFC), as "GSM 0x5B9E LG TV SSCR2"; '' where it is no EDID. The serial
+    number is not read.'''
+    if len(edid) < 128 or edid[:8] != b'\x00\xff\xff\xff\xff\xff\xff\x00':
+        return ''
+    m = (edid[8] << 8) | edid[9]
+    pnp = ''.join(chr(((m >> s) & 31) + 64) for s in (10, 5, 0))
+    product = edid[10] | (edid[11] << 8)
+    name = ''
+    for k in range(4):
+        d = edid[54 + 18 * k:72 + 18 * k]
+        if d[0] == 0 and d[1] == 0 and d[3] == 0xFC:
+            name = d[5:18].split(b'\n')[0].decode('ascii', 'replace').strip()
+    return f'{pnp} 0x{product:04X}' + (f' {name}' if name else '')
+
+
+def read_display_names(root='/sys/class/drm'):
+    '''The displays connected now: [(connector, edid_name())].'''
+    found = []
+    for status in sorted(glob.glob(os.path.join(root, 'card*-*', 'status'))):
+        folder = os.path.dirname(status)
+        try:
+            with open(status, encoding='utf-8', errors='replace') as f:
+                if f.read().strip() != 'connected':
+                    continue
+            with open(os.path.join(folder, 'edid'), 'rb') as f:
+                name = edid_name(f.read())
+        except OSError:
+            continue
+        if name:
+            found.append((os.path.basename(folder).split('-', 1)[-1], name))
+    return found
+
+
+def ab_facts(display, order, answer, choice, reference, native, available, offered, applied):
+    '''One line for the summary file (English, for a diagnostic report).'''
+    names = ','.join(k.split('.')[1] for k in available) or 'none'
+    offer = ','.join(f"{k.split('.')[1]}={v}" for k, v in offered.items()) or 'nothing'
+    shown = '/'.join('yes' if n else 'no' for n in native) or 'none'
+    return (f'dolby vision a/b: display {display or "unknown"}; A={order[0]} B={order[1]}; '
+            f'answer={answer or "none"} chosen={choice}; tv_player_compared={"yes" if reference else "no"}; '
+            f'native={shown}; settings={names}; offered={offer}; applied={"yes" if applied else "no"}')
+
+
+def ab_lines(display, choice, native, offered, applied):
+    '''What the comparison says (lines of parts, as picture_lines()).'''
+    if not native or not all(native):
+        return [[('s', 33824)]]
+    who = [('t', display or '?')]
+    lines = [[('f', {'licensed': 33818, 'hades': 33819, 'same': 33820}[choice], who)]
+             if choice in ('licensed', 'hades', 'same') else [('s', 33821)]]
+    if offered:
+        lines.append([('s', 33822 if applied else 33823)])
+    lines.append([('s', 33826)])
+    return lines
+
+
+def ab_record(path, entry, keep=AB_RESULTS_KEEP):
+    '''Adds an answer to the file of the answers (the newest last, at most keep), whole on the drive before
+    it replaces the one before.'''
+    try:
+        with open(path, encoding='utf-8') as f:
+            data = json.load(f)
+        answers = data.get('answers', []) if isinstance(data, dict) and data.get('version') == 1 else []
+    except (OSError, ValueError):
+        answers = []
+    answers = (answers + [entry])[-keep:]
+    folder = os.path.dirname(path)
+    os.makedirs(folder, exist_ok=True)
+    fd, part = tempfile.mkstemp(prefix='.ab.', dir=folder)
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as out:
+            json.dump({'version': 1, 'answers': answers}, out, indent=1, sort_keys=True)
+            out.write('\n')
+            out.flush()
+            os.fsync(out.fileno())
+        os.replace(part, path)
+    except BaseException:
+        try:
+            os.remove(part)
+        except OSError:
+            pass
+        raise
+    _sync_folder(folder)
+
+
+def usb_drives(root='/var/media'):
+    '''The drives that LibreELEC has mounted (USB drives and the like, under /var/media) that can be written
+    to.'''
+    return [d for d in sorted(glob.glob(os.path.join(root, '*')))
+            if os.path.ismount(d) and os.access(d, os.W_OK)]
