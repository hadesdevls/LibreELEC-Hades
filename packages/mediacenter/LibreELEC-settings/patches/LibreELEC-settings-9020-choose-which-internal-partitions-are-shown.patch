             return True
         return bool(xbmcDialog.yesno(oe._(32323), oe._(32935), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN))
 
+    # Hades: which partitions of the internal disks are mounted while the setting above shows them. The list
+    # is kept by INTERNAL_PARTITIONS (in /storage/.config), which 95-udevil-mount.rules asks before it mounts
+    # an internal partition, and which never mounts anything itself: a partition that is not chosen is not
+    # mounted, and nothing else changes. What the list says is asked of the script each time, as the
+    # partitions of this start are, and nothing of it is kept here.
+    PARTITION_SAFE = frozenset(b'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:-')
+
+    @classmethod
+    def partition_enc(cls, text):
+        '''A value as the list has it: the bytes other than letters, digits and . _ : - as %XX.'''
+        return ''.join(chr(b) if b in cls.PARTITION_SAFE else '%%%02X' % b for b in text.encode('utf-8'))
+
+    @staticmethod
+    def partition_dec(value, udev=False):
+        '''A value of the list as text; udev: it is written as udev writes a label (ID_FS_LABEL_ENC, where a
+        byte is a backslash, an x and two hex digits).'''
+        raw = urllib.parse.unquote_to_bytes(value)
+        if udev:
+            raw = re.sub(rb'\\x([0-9A-Fa-f]{2})', lambda m: bytes([int(m.group(1), 16)]), raw)
+        return raw.decode('utf-8', errors='replace')
+
+    def internal_partitions(self, command, data=None):
+        '''Run the script with a command (and, for "save", the new list on its input). Returns its exit status
+        and the lines that it printed. Not in the environment of Kodi.'''
+        try:
+            process = subprocess.Popen([self.INTERNAL_PARTITIONS, command], stdin=subprocess.PIPE if data is not None
+                                       else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                       env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+            out, err = process.communicate(input=data.encode('utf-8') if data is not None else None)
+        except OSError as e:
+            log.log(f'internal-partitions {command}: {e}', log.ERROR)
+            return 127, []
+        lines = out.decode(errors='replace').splitlines()
+        log.log(f'internal-partitions {command}: exit status {process.returncode}, {len(lines)} lines, '
+                f'{err.decode(errors="replace").strip()!r}', log.INFO)
+        return process.returncode, lines
+
+    @staticmethod
+    def partition_fields(line):
+        '''The fields "name=value" of a line of "list", as a dict; the first words go in 0, 1.'''
+        words = line.split(' ')
+        fields = {0: words[0], 1: words[1] if len(words) > 1 else ''}
+        for word in words[2:]:
+            name, eq, value = word.partition('=')
+            if eq:
+                fields[name] = value
+        return fields
+
+    @staticmethod
+    def partition_size(size):
+        '''A size in bytes, as disks are sold: whole MB below 2 GB, whole GB below 2 TB, whole TB from there
+        (no decimal sign, which each language writes its own way).'''
+        if size >= 2 * 10**12:
+            return f'{round(size / 10**12)} TB'
+        if size >= 2 * 10**9:
+            return f'{round(size / 10**9)} GB'
+        return f'{round(size / 10**6)} MB'
+
+    def partition_text(self, fields):
+        '''What a partition of this start is called in the list: its label, its file system and its size,
+        the disk that it is on (the model and the end of its serial number, which tells two disks of one
+        model apart) and the name that its device has now.'''
+        label = self.partition_dec(fields.get('label', ''), udev=True) or oe._(33133)
+        disk = self.partition_dec(fields.get('model', '')) or oe._(33136)
+        short = self.partition_dec(fields.get('short', ''))
+        if short:
+            disk = f'{disk} ({oe._(33135) % short[-4:]})'
+        size = int(fields['size']) if fields.get('size', '').isdigit() else 0
+        return oe._(33134) % (label, self.partition_dec(fields.get('type', '')), self.partition_size(size), disk,
+                              self.partition_dec(fields.get('dev', '')))
+
+    def partition_desc(self, fields):
+        '''What is kept in the list to name a partition when it is not there: the same words, in no language,
+        without the name of its device (which is of one start).'''
+        label = self.partition_dec(fields.get('label', ''), udev=True) or '-'
+        short = self.partition_dec(fields.get('short', ''))
+        size = int(fields['size']) if fields.get('size', '').isdigit() else 0
+        parts = [label, self.partition_dec(fields.get('type', '')), self.partition_size(size),
+                 self.partition_dec(fields.get('model', '')) + (f' ...{short[-4:]}' if short else '')]
+        return ', '.join(p.strip() for p in parts if p.strip())
+
+    @log.log_function()
+    def choose_internal_partitions(self, listItem=None):
+        title = oe._(33130)
+        if not self.INTERNAL_PARTITIONS or not os.path.exists(self.INTERNAL_PARTITIONS):
+            return
+        status, lines = self.internal_partitions('list')
+        if status != 0 or len(lines) < 3:
+            xbmcDialog.ok(title, oe._(33144))
+            return
+        head = {}
+        here, gone = [], []
+        for line in lines:
+            word, _, rest = line.partition(' ')
+            if word in ('start', 'list', 'others'):
+                head[word] = rest
+            elif word == 'here':
+                here.append(self.partition_fields(line))
+            elif word == 'gone':
+                gone.append(self.partition_fields(line))
+        if head.get('start') == 'hides':
+            xbmcDialog.ok(title, oe._(33138))
+            return
+        told = [p for p in here if p.get('id') == 'yes']
+        untold = [p for p in here if p.get('id') != 'yes']
+        if not here and not gone:
+            xbmcDialog.ok(title, oe._(33139))
+            return
+        if head.get('list', '').startswith('damaged'):
+            xbmcDialog.ok(title, oe._(33141))
+        if untold:
+            xbmcDialog.ok(title, oe._(33140) % ', '.join(self.partition_dec(p.get('dev', '')) for p in untold))
+        options = [oe._(33132)] + [self.partition_text(p) for p in told] + \
+                  [oe._(33137) % self.partition_dec(g.get('desc', '')) for g in gone]
+        # (what each one gets now, as the script says: a damaged list hides them all)
+        preselect = [0] if head.get('others') == 'shown' else []
+        preselect += [i + 1 for i, p in enumerate(told) if p[1] == 'shown']
+        preselect += [len(told) + i + 1 for i, g in enumerate(gone) if g[1] == 'shown']
+        # (a list that something else closes answers None, as cancelling does: nothing is changed)
+        chosen = xbmcDialog.multiselect(title, options, preselect=preselect)
+        if chosen is None or oe.xbmcm.abortRequested():
+            return
+        chosen = set(chosen)
+        lines = ['others ' + ('shown' if 0 in chosen else 'hidden')]
+        for i, p in enumerate(told):
+            lines.append(f"{'shown' if i + 1 in chosen else 'hidden'} wwn={p.get('wwn', '')} serial={p.get('serial', '')} "
+                         f"part={p.get('part', '')} desc={self.partition_enc(self.partition_desc(p))}")
+        for i, g in enumerate(gone):
+            lines.append(f"{'shown' if len(told) + i + 1 in chosen else 'hidden'} wwn={g.get('wwn', '')} "
+                         f"serial={g.get('serial', '')} part={g.get('part', '')} desc={g.get('desc', '')}")
+        status, _ = self.internal_partitions('save', '\n'.join(lines) + '\n')
+        if status == 0:
+            oe.notify(oe._(32921), oe._(33142))
+        else:
+            xbmcDialog.ok(title, oe._(33143))
