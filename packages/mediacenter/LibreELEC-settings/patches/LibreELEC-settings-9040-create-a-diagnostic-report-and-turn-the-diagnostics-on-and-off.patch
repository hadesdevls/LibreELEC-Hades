@@ -1216,6 +1240,216 @@ class system(modules.Module):
         # (a place to take note of and a text to read: the window that waits for the reader)
         xbmcDialog.textviewer(title, f'{oe._(33107)}\n{os.path.basename(path)}: {folder}\n\n{oe._(33108).replace("%s", files)}')
 
+    # Hades: "Create a diagnostic report": what the diagnostics collect, made now, every file of it through their
+    # filter, as one zip file in LOG_KEPT_DIR (DIAG_REPORT: report.sh now), and offered to a USB drive at once
+    # (DIAG_TO_USB: to-usb.sh file, which reads it back from the drive before it says that it is there).
+    # (seconds that making a report may take: report.sh bounds each command that it runs; one that hangs all the same
+    # is stopped then, with everything that it started)
+    DIAG_REPORT_WAIT = 600
+    # The texts for an exit status of report.sh that says why no report was made, and of to-usb.sh file that says why
+    # it was not copied
+    DIAG_REPORT_REFUSALS = {10: 33613, 11: 33614, 12: 33615, 13: 33616, 14: 33618, 15: 33617}
+    DIAG_REPORT_COPY_REFUSALS = {11: 33111, 12: 33112, 13: 33113, 14: 33114, 15: 33620, 16: 33116}
+
+    def diag_report(self):
+        '''Run report.sh now. Returns its exit status and what it printed (124 where it was stopped after
+        DIAG_REPORT_WAIT seconds). Not in the environment of Kodi, where add-ons put folders of their own into PATH;
+        in a process group of its own, so that what it started is stopped with it.'''
+        try:
+            process = subprocess.Popen([self.DIAG_REPORT, 'now'], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                                       stderr=subprocess.PIPE, env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'},
+                                       start_new_session=True)
+        except OSError as e:
+            log.log(f'report: {e}', log.ERROR)
+            return 127, ''
+        try:
+            out, err = process.communicate(timeout=self.DIAG_REPORT_WAIT)
+        except subprocess.TimeoutExpired:
+            # (TERM first: report.sh then takes away what it left in RAM and in the storage)
+            for sig, wait in ((signal.SIGTERM, 10), (signal.SIGKILL, None)):
+                try:
+                    os.killpg(process.pid, sig)
+                except OSError:
+                    pass
+                try:
+                    process.communicate(timeout=wait)
+                    break
+                except subprocess.TimeoutExpired:
+                    continue
+            log.log(f'report: not done after {self.DIAG_REPORT_WAIT} s, stopped', log.ERROR)
+            return 124, ''
+        said = err.decode(errors='replace').strip()
+        log.log(f'report: exit status {process.returncode}, {said!r}', log.INFO)
+        return process.returncode, out.decode(errors='replace')
+
+    @log.log_function()
+    def load_diag_report(self):
+        setting = self.struct['debug']['settings']['diag_report']
+        if not self.DIAG_REPORT or not os.path.exists(self.DIAG_REPORT) or not self.LOG_KEPT_DIR:
+            # a system without it
+            setting['hidden'] = 'true'
+        else:
+            setting.pop('hidden', None)
+
+    @staticmethod
+    def file_size(size):
