                 with open(self.JOURNALD_CONFIG_FILE, 'w') as config_file:
                     config_file.write(journal_config)
 
+    # Hades: the setting "show the internal disks (read-only)". It is the default entry of the
+    # boot menus and nothing else, so it is asked of the script that reads and changes them
+    # (INTERNAL_DISKS) and never remembered here: what is shown is what the menus say.
+    def internal_disks(self, command, wait=None):
+        '''Run the script with a command. Returns its exit status and the words that it printed.
+        wait: what to say when it takes long (it waits for whatever else is writing to the boot
+        partition). It is given the time that it takes and never stopped: it may be writing. So
+        what says it is the bar in a corner of the screen, which has no button, and not the
+        progress dialog, whose Cancel button would cancel nothing.'''
+        dialog = None
+        try:
+            # (not in the environment of Kodi, where add-ons put folders of their own into PATH
+            # and LD_LIBRARY_PATH: the script clears it too, but its shell is started first)
+            process = subprocess.Popen([self.INTERNAL_DISKS, command], stdin=subprocess.DEVNULL,
+                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                       env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+            try:
+                out, err = process.communicate(timeout=self.INTERNAL_DISKS_WAIT if wait else None)
+            except subprocess.TimeoutExpired:
+                dialog = xbmcgui.DialogProgressBG()
+                dialog.create(oe._(32921), wait)
+                out, err = process.communicate()
+        except OSError as e:
+            log.log(f'internal-disks {command}: {e}', log.ERROR)
+            return 127, []
+        finally:
+            if dialog is not None:
+                dialog.close()
+        words = out.decode(errors='replace').split()
+        said = err.decode(errors='replace').strip()
+        log.log(f'internal-disks {command}: exit status {process.returncode}, {words}, {said!r}', log.INFO)
+        return process.returncode, words
+
+    @log.log_function()
+    def load_internal_disks(self):
+        if not self.INTERNAL_DISKS or not os.path.exists(self.INTERNAL_DISKS):
+            # a system without it
+            self.struct['disks']['hidden'] = 'true'
+            return
+        status, words = self.internal_disks('status')
+        shown = self.internal_disks_drawn_on(status, words)
+        self.struct['disks']['settings']['internal_disks']['value'] = '1' if shown else '0'
+
+    @staticmethod
+    def internal_disks_drawn_on(status, words):
+        '''Whether the switch is drawn as on: wherever the script can tell that a boot menu
+        starts the entry that shows the disks, or that nothing hides them. "mixed": one of the
+        two menus starts that entry. "shows", after the reason for a setting that cannot be
+        told: a menu that the script does not know starts it all the same. Exit status 12: the
+        entry "run" does not hide the disks, so they are shown whatever starts. Drawn as off
+        there, the switch would say "hidden" over disks that are shown; selecting it says what
+        there is to do. It is still drawn as off for menus that the script does not know and in
+        which nothing hides the disks (the ones of the LibreELEC installer), and where there is
+        no menu at all: there the script cannot tell.'''
+        return (status == 0 and words[:1] in (['on'], ['mixed'])) or status == 12 or 'shows' in words[1:]
+
+    @staticmethod
+    def internal_disks_refusal(status):
+        '''The text for an exit status of the script that says why nothing can be changed.'''
+        return {11: 32930, 12: 32931, 13: 32932}.get(status, 32934)
+
+    @log.log_function()
+    def set_internal_disks(self, listItem=None):
+        if listItem is None:
+            return
+        title = oe._(32922)
+        # (the window has changed the value of the item already: this is what is asked for)
+        show = listItem.getProperty('value') == '1'
+        status, words = self.internal_disks('status')
+        if status != 0 or not words:
+            xbmcDialog.ok(title, oe._(self.internal_disks_refusal(status)))
+            return
+        if words[0] == ('on' if show else 'off'):
+            return
+        if show:
+            if 'live' in words[1:]:
+                xbmcDialog.ok(title, oe._(32932))
+                return
+            # what it means, to be read at the reader's pace; then the question, with "no" preselected
+            xbmcDialog.textviewer(title, oe._(32924))
+            if not xbmcDialog.yesno(title, oe._(32925), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN):
+                return
+        status, words = self.internal_disks('on' if show else 'off', wait=oe._(32936))
+        if status == 0:
+            oe.notify(oe._(32921), oe._(32926 if show else 32927))
+        elif status == 22:
+            xbmcDialog.ok(title, oe._(32933))
+        elif status in (10, 11, 12, 13, 127):
+            xbmcDialog.ok(title, oe._(self.internal_disks_refusal(status)))
+        elif show and status in (14, 20):
+            # nothing was written
+            xbmcDialog.ok(title, oe._(32928))
+        else:
+            # it could not be turned off, or the two boot menus were left differing
+            xbmcDialog.ok(title, oe._(32929))
+
+    @log.log_function()
+    def reset_internal_disks(self):
+        '''Before a reset: a system that is reset does not go on showing the internal disks. The
+        setting is in the boot menus, which a reset does not touch, so it is turned off here
+        (the script that does the reset turns it off as well, for a reset that is not asked for
+        here). Returns whether the reset goes on: where the disks would still be shown, that is
+        said, with what to do about it, and the user decides.'''
+        if not self.INTERNAL_DISKS or not os.path.exists(self.INTERNAL_DISKS):
+            return True
+        status, words = self.internal_disks('status')
+        if status == 0 and words[:1] in (['on'], ['mixed']):
+            self.internal_disks('off', wait=oe._(32936))
+            status, words = self.internal_disks('status')
+        still = (status == 0 and words[:1] in (['on'], ['mixed'])) or (status == 11 and 'shows' in words[1:])
+        if not still:
+            return True
+        return bool(xbmcDialog.yesno(oe._(32323), oe._(32935), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN))
+
