index 0000000..f338177
--- /dev/null
+++ b/resources/lib/hades_login.py
@@ -0,0 +1,20 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 Hades
+
+# Hades: what a person has to know to reach this system from another computer once Samba is on,
+# put together without anything of Kodi so that it can be tried on its own.
+
+
+def samba_login_text(full, fallback, host, user, password):
+    """The text that tells the address, the user and the password of the file sharing.
+
+    full: the text with {host}, {windows}, {user} and {password}; fallback: the text for when the generated login is
+    not known yet (it says where to look it up). Values are put in as they are, never parsed.
+    """
+    host, user, password = (str(value or '').strip() for value in (host, user, password))
+    if not user or not password:
+        return fallback
+    host = host or '?'
+    # {windows}: the address as Windows writes it (two backslashes before the name); made here because a text of
+    # the first-run wizard is read from its file by hand, and a backslash in it would show twice
+    return full.format(host=host, windows='\\\\' + host, user=user, password=password)
