+    # Hades: the setting "Hardware clock". What is chosen is the file of the choice and nothing else; what
+    # holds now is /etc/adjtime (rtc_in_local_time). Where the two differ, the list says that the choice
+    # holds from the next start.
+    @log.log_function()
+    def load_clock(self):
+        setting = self.struct['ident']['settings']['clock']
+        if not self.CLOCK_CHOICE:
+            # a system without it
+            setting['hidden'] = 'true'
+            return
+        utc = clock_choice_is_utc(self.CLOCK_CHOICE)
+        shown = oe._(32974 if utc else 32982)
+        if utc == rtc_in_local_time():
+            shown = f'{shown}, {oe._(32975)}'
+        setting['name'] = f'{oe._(32971)} ({shown})'
+        setting['value'] = 'utc' if utc else 'local'
+
+    @log.log_function()
+    def set_clock(self, listItem=None):
+        if not self.CLOCK_CHOICE:
+            return
+        title = oe._(32971)
+        utc = clock_choice_is_utc(self.CLOCK_CHOICE)
+        if self.kept_in_memory_only(os.path.dirname(self.CLOCK_CHOICE)):
+            xbmcDialog.ok(title, oe._(32981))
+            return
+        # (the entry that holds is preselected: it is what Kodi answers when something else closes the list)
+        choice = xbmcDialog.select(title, [oe._(32973), oe._(32974)], preselect=1 if utc else 0)
