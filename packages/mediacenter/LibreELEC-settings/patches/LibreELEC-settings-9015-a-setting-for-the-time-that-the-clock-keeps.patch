     return len(lines) >= 3 and lines[2] == 'LOCAL'
 
+
+# Hades: what the clock keeps from the next start. The init of the initramfs reads the same file by the same
+# rule (hades_clock_mode): UTC when it is a regular file, not a link, whose third line, in its first 256
+# bytes, is "UTC"; anything else is local time, the default, which the adjtime of the image says.
+CLOCK_UTC_TEXT = b'0.0 0 0\n0\nUTC\n'
+
+
+def clock_choice_is_utc(path):
+    '''True if the file says that the clock keeps UTC from the next start.'''
+    if not path:
+        return False
+    try:
+        # (not a link, and nothing that would block a read: a FIFO or a device)
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    except OSError:
+        return False
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            return False
+        data = os.read(fd, 256)
+    except OSError:
+        return False
+    finally:
+        os.close(fd)
+    if os.path.islink(os.path.dirname(path)):
+        return False
+    lines = data.split(b'\n')
+    return len(lines) >= 3 and lines[2] == b'UTC'
+
+
+def write_clock_choice(path, utc):
+    '''UTC: the file that says so, written beside it and renamed over it when whole and on the drive. Local
+    time: no file (a folder or anything else that is not a file is left: it says local time all the same).
+    Then the file is read back by the rule of the init. Raises OSError when what it says is not what was
+    asked for.'''
+    folder = os.path.dirname(path)
+    if utc:
+        os.makedirs(folder, exist_ok=True)
+        fd, part = tempfile.mkstemp(prefix='.adjtime.', dir=folder)
+        try:
+            with os.fdopen(fd, 'wb') as out:
+                out.write(CLOCK_UTC_TEXT)
+                out.flush()
+                os.fsync(out.fileno())
+            os.chmod(part, 0o644)
+            os.replace(part, path)
+        except BaseException:
+            try:
+                os.remove(part)
+            except OSError:
+                pass
+            raise
+    elif os.path.islink(path) or os.path.isfile(path):
+        os.remove(path)
+    # (the name is written through as well: a power cut soon after must not bring the old choice back)
+    if os.path.isdir(folder):
+        fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    if clock_choice_is_utc(path) != utc:
+        raise OSError(f'{path} does not say {"UTC" if utc else "local time"} after it was written')
+
+
