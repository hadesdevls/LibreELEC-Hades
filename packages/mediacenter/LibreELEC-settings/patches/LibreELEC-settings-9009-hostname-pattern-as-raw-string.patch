From 34069a8f6d59bbd3fb802ef0667d5c59906d201a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:18:15 +0000
Subject: [PATCH] system: write the hostname pattern as a raw string

"\." in an ordinary string literal is an invalid escape sequence: Python
3.14 warns about it at every compilation ("SyntaxWarning: invalid escape
sequence") and a future version will reject it. The raw string has the
same value: bytecode, constants, names and line numbers are identical;
only the column positions of that line move by one.
---
 resources/lib/modules/system.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 5a6dcce..290a61e 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -76,7 +76,7 @@ class system(modules.Module):
                         'value': '',
                         'action': 'set_hostname',
                         'type': 'text',
-                        'validate': '^([a-zA-Z0-9](?:[a-zA-Z0-9-\.]*[a-zA-Z0-9]))$',
+                        'validate': r'^([a-zA-Z0-9](?:[a-zA-Z0-9-\.]*[a-zA-Z0-9]))$',
                         'InfoText': 710,
                         },
                     'timezone': {
-- 
2.53.0

