From a47fc66c36e537ca24fb6854ff1a9349b5765bc0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 06:12:45 +0000
Subject: [PATCH] services: explain how SSH logins work in the help text

The help text of the SSH switch said the console is reached with root and
the default password, which Hades sshd refuses while root still has it. Say
that root logs in with an SSH key, or with a password once one is set.
---
 resources/language/resource.language.en_gb/strings.po | 4 ++++
 resources/language/resource.language.es_ar/strings.po | 4 ++++
 resources/language/resource.language.es_es/strings.po | 4 ++++
 resources/language/resource.language.es_mx/strings.po | 4 ++++
 resources/lib/modules/services.py                     | 2 +-
 5 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/resources/language/resource.language.en_gb/strings.po b/resources/language/resource.language.en_gb/strings.po
index 24348fa..c6b54ed 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1147,3 +1147,7 @@ msgstr ""
 msgctxt "#32911"
 msgid "Accept keyboards, remotes and game controllers that connect without pairing (for example clones of the PS3 controller) and re-pair devices without asking. Anyone nearby could then send key presses. Genuine PS3 controllers paired with a USB cable work without this option."
 msgstr ""
+
+msgctxt "#32916"
+msgid "Set to ON to enable the embedded SSH server. Log in as 'root' with an SSH key, or set a password first: while root has the default password, password logins are refused."
+msgstr ""
diff --git a/resources/language/resource.language.es_ar/strings.po b/resources/language/resource.language.es_ar/strings.po
