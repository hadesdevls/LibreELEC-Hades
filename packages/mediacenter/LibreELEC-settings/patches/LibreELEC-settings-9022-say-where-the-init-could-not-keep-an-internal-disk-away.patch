 .../resource.language.es_ar/strings.po        | 24 +++++++++--
 .../resource.language.es_es/strings.po        | 24 +++++++++--
 .../resource.language.es_mx/strings.po        | 24 +++++++++--
 resources/lib/modules/system.py               | 43 ++++++++++++++-----
 5 files changed, 110 insertions(+), 25 deletions(-)

