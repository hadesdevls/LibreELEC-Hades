+    # Hades: the setting "Boot menu". How long the boot menus wait is in the menus and nowhere else,
+    # so it is asked of the script that reads and changes them (INTERNAL_DISKS: wait, wait N).
+    BOOT_MENU_WAITS = ['10', '3', '1']
+
+    @log.log_function()
+    def load_boot_menu_wait(self):
+        group = self.struct['bootmenu']
+        if not self.INTERNAL_DISKS or not os.path.exists(self.INTERNAL_DISKS):
+            # a system without it
+            group['hidden'] = 'true'
+            return
+        status, words = self.internal_disks('wait')
+        if status != 0 or not words or not words[0].isdigit():
+            # no boot menu, one that this system does not make, or menus that wait differently
+            # (changed by hand): nothing that this setting can tell
+            group['hidden'] = 'true'
+            return
+        group.pop('hidden', None)
+        setting = group['settings']['boot_menu_wait']
+        # (a wait set by hand is shown as it is, among the ones offered)
+        setting['values'] = self.BOOT_MENU_WAITS + ([words[0]] if words[0] not in self.BOOT_MENU_WAITS else [])
+        setting['value'] = words[0]
+
+    @log.log_function()
+    def set_boot_menu_wait(self, listItem=None):
+        if listItem is None:
+            return
+        # (the window has changed the value of the item already: this is what is asked for)
+        seconds = listItem.getProperty('value')
+        if not seconds.isdigit():
+            return
+        status, words = self.internal_disks(['wait', seconds], wait=oe._(33171))
+        if status == 0:
+            oe.notify(oe._(33168), oe._(33172) % seconds)
+            return
+        xbmcDialog.ok(oe._(33168), oe._(33174 if status in (21, 22) else 33173))
+        # (the item shows again what the menus say)
+        status, words = self.internal_disks('wait')
+        if status == 0 and words and words[0].isdigit():
+            listItem.setProperty('value', words[0])
+
     @log.log_function()
     def reset_internal_disks(self):
