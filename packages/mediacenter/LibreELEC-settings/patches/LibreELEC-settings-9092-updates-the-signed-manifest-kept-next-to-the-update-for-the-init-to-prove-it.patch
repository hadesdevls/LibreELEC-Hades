From 4f1b8ed25d70a3dac10d6c65e9b58ade0b0b7eb8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:54:54 +0000
Subject: [PATCH] updates: the signed manifest kept next to the update, for the
 init to prove it

With Secure Boot, the init of LibreELEC Hades signs the kernel and the boot
loader of an update with the key of the computer. Until now it did that for
any .tar in /storage/.update, and before that it read and ran parts of the
update (its os-release, its canupdate.sh) with that key within reach.

The client now keeps the signed manifest and its signature, the bytes that
it checked, next to the file of the release (hades-manifest.json and
hades-manifest.json.sig, each written next to its place and renamed into
it); a download whose manifest cannot be kept is not kept either. And the
module answers the init: "hades_update.py check-kept <folder> <.tar>"
(check_kept), run by the init with the Python, the client and the keys of
the system that runs, says whether the .tar is the file of a release that
the update channel of that system offers to it: the signature by one of its
keys, its channel and architecture, a release newer than it that can be
installed over it, and the name, size and SHA-256 of the .tar. The expiry
and the newest manifest taken are not looked at there: the init has no
clock set over the network, and the client looked at both when it
downloaded the file.

Without Secure Boot nothing changes: the init does not ask, and the two
files are removed with the rest after an update.
---
 resources/lib/hades_update.py    | 106 ++++++++++++++++++++++++++++++-
 resources/lib/modules/updates.py |  18 ++++++
 2 files changed, 123 insertions(+), 1 deletion(-)

diff --git a/resources/lib/hades_update.py b/resources/lib/hades_update.py
index 767e98f..b080446 100644
--- a/resources/lib/hades_update.py
+++ b/resources/lib/hades_update.py
@@ -28,7 +28,10 @@ signature is checked before the manifest is read. Then:
     back before it is kept); and only when the storage has room for it and for what the init unpacks from it
     next to it;
   - when it is kept, no other update is left in the update folder: the init installs the first .tar there
-    by name (or an image, or KERNEL and SYSTEM), so any other one is removed, or nothing is kept.
+    by name (or an image, or KERNEL and SYSTEM), so any other one is removed, or nothing is kept;
+  - the signed manifest and its signature are kept next to it (keep_proof): the init of a system that starts
+    with Secure Boot installs an update only when they prove it, with the client and the keys of the system
+    that runs (check_kept, "hades_update.py check-kept").
 Every request is a GET with a fixed user agent and nothing else of the system: no proxy of the environment,
 no cookies, no system id. A redirect is followed only over HTTPS, at most MAX_REDIRECTS times, and only to
 the same host and port or to one of the hosts that GitHub serves the files of a release from (ASSET_HOSTS,
@@ -94,6 +97,8 @@ FETCH_DEADLINE = 60
 STALL_WINDOW = 120
 STALL_BYTES = 64 * 1024
 PART_NAME = 'hades-update.part'
+# (the signed manifest and its signature, kept next to the file of the release in the update folder: keep_proof)
+PROOF_NAMES = ('hades-manifest.json', 'hades-manifest.json.sig')
 SYNC_FLAGS = ('/run/connman/ntp-synchronized', '/run/systemd/timesync/synchronized')
 TIME_FORMAT = '%Y-%m-%dT%H:%M:%SZ'
 FILE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,199}\.tar')
@@ -505,6 +510,85 @@ def clear_others(final_folder, keep):
     return removed
 
 
+def keep_proof(final_folder, manifest, signature):
+    '''Writes the signed manifest and its signature (the bytes that were checked) next to the file of its release in
+    final_folder, as PROOF_NAMES: the init of a system that starts with Secure Boot installs an update, and signs it
+    with the key of the computer, only when they prove it (check_kept). Each is written next to its place and
+    renamed into it.'''
+    os.makedirs(final_folder, exist_ok=True)
+    for name, data in zip(PROOF_NAMES, (manifest, signature)):
+        path = os.path.join(final_folder, name)
+        part = f'{path}.part'
+        try:
+            os.remove(part)
+        except FileNotFoundError:
+            pass
+        with open(part, 'xb') as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(part, path)
+
+
+def distro_arch(os_release='/etc/os-release'):
+    '''DISTRO_ARCH of os_release (what the settings add-on calls the architecture), or None.'''
+    try:
+        with open(os_release, encoding='utf-8') as f:
+            for line in f.read(16384).splitlines():
+                k, _, v = line.partition('=')
+                if k.strip() == 'DISTRO_ARCH':
+                    return v.strip().strip('"') or None
+    except (OSError, UnicodeDecodeError):
+        pass
+    return None
+
+
+def check_kept(folder, tar, channel_dir=None, os_release='/etc/os-release'):
+    '''For the init of a system that starts with Secure Boot, before anything of an update is read or run and before
+    it is signed with the key of the computer: returns the version of the release when tar is the file of a release
+    that the update channel of THIS system offers to it, as the signed manifest kept next to it in folder says
+    (keep_proof): the signature by a key of this system, its channel and architecture, a release newer than this one
+    that can be installed over it, and the name, size and SHA-256 of tar. Raises ChannelError otherwise. The expiry
+    and the newest manifest taken are not looked at: the init has no clock set over the network, and the client
+    looked at both when it downloaded the file.'''
+    channel_dir = channel_dir or CHANNEL_DIR
+    channel = read_channel(channel_dir)
+    if channel is None:
+        raise ChannelError(f'this system has no update channel ({channel_dir}): no update of the channel can be proven')
+    arch = distro_arch(os_release)
+    if not arch:
+        raise ChannelError(f'no DISTRO_ARCH in {os_release}')
+    data = []
+    for name, limit in zip(PROOF_NAMES, (MANIFEST_MAX, SIGNATURE_MAX)):
+        try:
+            with open(os.path.join(folder, name), 'rb') as f:
+                data.append(f.read(limit + 1))
+        except OSError as e:
+            raise ChannelError(f'no signed manifest next to the update ({name}: {e.strerror}): an update made by hand, '
+                               'or one of before 1.2') from None
+    manifest, signature = data
+    verify(manifest, signature, channel.keys)
+    m = parse(manifest, channel.name, arch)
+    r, f = m['release'], m['release']['file']
+    if r['serial'] <= channel.release_serial:
+        raise ChannelError(f'release {r["version"]} ({r["serial"]}) is not newer than this system ({channel.release_serial})')
+    if channel.release_serial < r['min_serial']:
+        raise ChannelError(f'release {r["version"]} cannot be installed over this system (it needs {r["min_serial"]} '
+                           f'or newer; this is {channel.release_serial})')
+    if os.path.basename(tar) != f['name']:
+        raise ChannelError(f'the update is {os.path.basename(tar)}, the signed manifest is for {f["name"]}')
+    try:
+        if os.path.islink(tar):
+            raise ChannelError(f'{tar} is a link')
+        with open(tar, 'rb') as t:
+            whole = _whole(t, f['size'], f['sha256'])
+    except OSError as e:
+        raise ChannelError(f'{tar}: {e.strerror}') from None
+    if not whole:
+        raise ChannelError(f'{f["name"]} is not the file of the signed manifest: its size or its SHA-256 differs')
+    return r['version']
+
+
 def _whole(f, size, sha256):
     '''Whether what f reads from its start, to its end, is size bytes with that SHA-256.'''
     digest, n = hashlib.sha256(), 0
@@ -614,3 +698,23 @@ def _download(release_file, folder, final_folder, progress, cancelled, timeout,
             pass
         raise
     return final
+
+
+def main(argv):
+    '''hades_update.py check-kept <update folder> <.tar>: check_kept, for the init (exit 0 only when it holds).'''
+    if len(argv) != 4 or argv[1] != 'check-kept':
+        print('usage: hades_update.py check-kept <update folder> <.tar>')
+        return 2
+    try:
+        version = check_kept(argv[2], argv[3])
+    except ChannelError as e:
+        print(f'hades_update: not proven: {e}')
+        return 1
+    print(f'hades_update: {os.path.basename(argv[3])} is release {version} of the update channel of this system, as '
+          'its signed manifest says')
+    return 0
+
+
+if __name__ == '__main__':
+    import sys
+    sys.exit(main(sys.argv))
diff --git a/resources/lib/modules/updates.py b/resources/lib/modules/updates.py
index aebcdf8..6116ea6 100644
--- a/resources/lib/modules/updates.py
+++ b/resources/lib/modules/updates.py
@@ -752,6 +752,8 @@ class updates(modules.Module):
                                              hades_update.clock_set(),
                                              hades_update.stored_serial(self.HADES_STATE, channel.name))
             hades_update.remember(self.HADES_STATE, channel.name, m['serial'])
+            # (the bytes that were checked, kept next to the file when it is downloaded: hades_download)
+            self.hades_proof = (manifest, signature)
         except hades_update.NotYet as e:
             self.hades_retry = True
             log.log(f'Update channel {channel.name}: not asked yet: {e}; it is asked again in '
@@ -823,6 +825,22 @@ class updates(modules.Module):
                 return False
         elif not self.hades_fetch_file(release, silent):
             return False
+        # (the signed manifest and its signature next to the file: a system that starts with Secure Boot installs it
+        # only with them; without them, the file is not left either)
+        try:
+            hades_update.keep_proof(self.LOCAL_UPDATE_DIR, *self.hades_proof)
+        except (OSError, AttributeError, TypeError) as e:
+            log.log(f'Update channel: {release["file"]["name"]} is not taken: its signed manifest cannot be kept next '
+                    f'to it: {e}', log.ERROR)
+            try:
+                os.remove(os.path.join(self.LOCAL_UPDATE_DIR, release['file']['name']))
+            except OSError:
+                pass
+            if not silent:
+                xbmcgui.Dialog().ok(oe._(32013), oe._(32986))
+            if hasattr(self, 'update_in_progress'):
+                delattr(self, 'update_in_progress')
+            return False
         os.sync()
         self.hades_downloaded = True
         log.log(f'Update channel: {release["file"]["name"]} is in {self.LOCAL_UPDATE_DIR}, for the next start', log.INFO)
