+            list(self.service_properties.get('Nameservers', []))[:3]) or oe._(33206)
         for entry in sorted(self.datamap):
             for (key, value) in self.datamap[entry].items():
                 if self.struct[value]['type'] == 'Boolean':
@@ -283,7 +307,7 @@ class connmanService(object):
                 if self.struct[value]['type'] == 'Array':
                     if key in self.service_properties:
                         for setting in self.struct[value]['settings']:
-                            if int(setting) < len(self.service_properties[key]):
+                            if setting.isdigit() and int(setting) < len(self.service_properties[key]):
                                 self.struct[value]['settings'][setting]['value'] = self.service_properties[key][int(setting)]
         self.winOeCon.show()
         for strEntry in sorted(self.struct, key=lambda x: self.struct[x]['order']):
@@ -322,8 +346,44 @@ class connmanService(object):
         self.struct[listItem.getProperty('category')]['settings'][listItem.getProperty('entry')]['value'] = listItem.getProperty('value')
         self.struct[listItem.getProperty('category')]['settings'][listItem.getProperty('entry')]['changed'] = True
 
+    def nameservers_to_save(self):
+        # Hades: the connection's own nameservers, in their order. Empty means "the ones the network
+        # gives" (ConnMan then uses those, or its fallback ones).
+        root = self.struct['Nameservers']['settings']
+        nameservers = [root[key]['value'] for key in sorted((k for k in root if k.isdigit()), key=int)
+                       if root[key]['value'] != '']
+        # A connection that goes from DHCP to a manual IPv4 address, without nameservers of its own,
+        # keeps the ones it was using: those of the DHCP lease go away with it, and the fallback ones
+        # that would replace them do not resolve the names of the local network.
+        if not nameservers and not self.service_properties.get('Nameservers.Configuration') \
+                and self.service_properties.get('IPv4.Configuration', {}).get('Method') == 'dhcp' \
+                and self.struct['IPv4']['settings']['Method']['value'] == 'manual':
+            nameservers = list(self.service_properties.get('Nameservers', []))
+        return nameservers
+
+    def nameservers_usable(self, nameservers):
+        # ConnMan uses an IPv4 nameserver only while the connection has IPv4, and an IPv6 one only while
+        # it has IPv6; with nameservers of its own it does not fall back on others, so a list of which
+        # none can be used leaves the system without name resolution.
+        methods = {
+            4: self.struct['IPv4']['settings']['Method']['value'],
+            6: self.struct['IPv6']['settings']['Method']['value'],
+        }
+        for nameserver in nameservers:
+            try:
+                version = ipaddress.ip_address(nameserver).version
+            except ValueError:
+                continue
+            if methods[version] != 'off':
+                return True
+        return False
+
     @log.log_function()
     def save_network(self):
+        nameservers = self.nameservers_to_save()
+        if nameservers and not self.nameservers_usable(nameservers):
+            if not xbmcgui.Dialog().yesno(oe._(32119), oe._(33205), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN):
+                return
         try:
             def get_array(root):
                 return [root[key]['value'] for key in root.keys() if root[key]['value'] != '']
@@ -339,8 +399,7 @@ class connmanService(object):
                 get_dict(self.struct['IPv4']['settings']))
             dbus_connman.service_set_ipv6_configuration(self.servicePath,
                 get_dict(self.struct['IPv6']['settings']))
-            dbus_connman.service_set_nameservers_configuration(self.servicePath,
-                get_array(self.struct['Nameservers']['settings']))
+            dbus_connman.service_set_nameservers_configuration(self.servicePath, nameservers)
             dbus_connman.service_set_timeservers_configuration(self.servicePath,
                 get_array(self.struct['Timeservers']['settings']))
         finally:
