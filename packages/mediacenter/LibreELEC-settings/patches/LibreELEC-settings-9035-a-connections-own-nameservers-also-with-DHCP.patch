@@ -295,6 +304,39 @@ class mainWindow(xbmcgui.WindowXMLDialog):
                         selectedItem.setProperty('value', '')
                     else:
                         selectedItem.setProperty('value', returnValue)
+            elif strTyp == 'ip46':
+                # Hades: an IPv4 or an IPv6 address, or none. Kodi's number pad for addresses takes
+                # IPv4 only, so the kind is chosen first; an IPv6 address is typed on the keyboard.
+                xbmcDialog = xbmcgui.Dialog()
+                title = selectedItem.getProperty('menuname')
+                choices = [oe._(33201), oe._(33202)]
+                if strValue != '':
+                    choices.append(oe._(33203))
+                choice = xbmcDialog.select(title, choices)
+                if choice == 0:
+                    current = strValue if ip_version(strValue) == 4 else '0.0.0.0'
+                    returnValue = xbmcDialog.numeric(3, title, current)
+                    if returnValue != '':
+                        if returnValue == '0.0.0.0':
+                            selectedItem.setProperty('value', '')
+                        elif ip_version(returnValue) == 4:
+                            selectedItem.setProperty('value', str(ipaddress.ip_address(returnValue)))
+                elif choice == 1:
+                    xbmcKeyboard = xbmc.Keyboard(strValue if ip_version(strValue) == 6 else '', title)
+                    while True:
+                        xbmcKeyboard.doModal()
+                        if not xbmcKeyboard.isConfirmed():
+                            break
+                        text = xbmcKeyboard.getText().strip()
+                        if text == '':
+                            selectedItem.setProperty('value', '')
+                            break
+                        if ip_version(text) is not None:
+                            selectedItem.setProperty('value', str(ipaddress.ip_address(text)))
+                            break
+                        xbmcDialog.ok(title, oe._(33204))
+                elif choice == 2:
+                    selectedItem.setProperty('value', '')
             elif strTyp == 'num':
                 if strValue == 'None' or strValue == '':
                     strValue = '0'
