@@ -270,6 +283,17 @@ class connmanService(object):
         self.servicePath = servicePath
         oe.dictModules['connmanNetworkConfig'] = self
         self.service_properties = dbus_connman.service_get_properties(servicePath)
+        # Hades: the struct is shared by every connection that is opened, and a list that this one does
+        # not have (or has empty) leaves the fields untouched: empty them first, so that the values of
+        # the connection opened before are neither shown nor saved here.
+        for category in self.struct.values():
+            if category['type'] == 'Array':
+                for (setting, field) in category['settings'].items():
+                    if setting.isdigit():
+                        field['value'] = ''
+                        field.pop('changed', None)
