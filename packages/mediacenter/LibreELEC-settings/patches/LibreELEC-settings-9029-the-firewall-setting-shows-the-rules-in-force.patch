From 9b838485e2b3f4db6ab00836c8f0520c11cb56e9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:11:54 +0000
Subject: [PATCH] connman: the firewall setting shows the rules that are in
 force

With RULES in iptables.conf other than custom, home or public, load_values()
left nf_option_str unset, and the network settings failed to open with an
UnboundLocalError: RULES=none (which iptables_helper reads as no rules), an
empty or cut file, a value of another build. The setting now reads RULES as
iptables_helper reads it: a line end of Windows, spaces and tabs do not count,
none is Off, and any other value, or a file that cannot be read, shows Home
network, the rules that iptables_helper loads for it, with a warning in the
log that names the value.
---
 resources/lib/modules/connman.py | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/resources/lib/modules/connman.py b/resources/lib/modules/connman.py
index 037b14e..30f3b59 100644
--- a/resources/lib/modules/connman.py
+++ b/resources/lib/modules/connman.py
@@ -598,13 +598,24 @@ class connman(modules.Module):
                 break
         self.struct['advanced']['settings']['netfilter']['values'] = nf_values
         if oe.get_service_state('iptables') == '1':
-            nf_option = oe.get_service_option('iptables', 'RULES', 'home')
+            # Hades: the rules that are in force, as iptables_helper reads RULES: a line end of Windows, spaces and
+            # tabs do not count, "none" loads no rules, and any other value (none at all, an empty or cut file,
+            # one that cannot be read) gets the rules of a home network. Without this, such a value left
+            # nf_option_str unset, and the network settings failed to open.
+            try:
+                nf_option = ''.join(oe.get_service_option('iptables', 'RULES', 'home').split())
+            except (OSError, UnicodeError, ValueError, AttributeError):
+                nf_option = None
             if nf_option == "custom":
                 nf_option_str = oe._(32396)
-            elif nf_option == "home":
-                nf_option_str = oe._(32398)
             elif nf_option == "public":
                 nf_option_str = oe._(32399)
+            elif nf_option == "none":
+                nf_option_str = oe._(32397)
+            else:
+                if nf_option != "home":
+                    log.log(f'iptables: RULES {nf_option!r} is not none, public, home or custom: the rules of a home network are in force', log.WARNING)
+                nf_option_str = oe._(32398)
         else:
             nf_option_str = oe._(32397)
         self.struct['advanced']['settings']['netfilter']['value'] = nf_option_str
-- 
