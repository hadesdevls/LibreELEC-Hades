diff --git a/resources/lib/hades_login.py b/resources/lib/hades_login.py
index f338177..206c66a 100644
--- a/resources/lib/hades_login.py
+++ b/resources/lib/hades_login.py
@@ -18,3 +18,10 @@ def samba_login_text(full, fallback, host, user, password):
     # {windows}: the address as Windows writes it (two backslashes before the name); made here because a text of
     # the first-run wizard is read from its file by hand, and a backslash in it would show twice
     return full.format(host=host, windows='\\\\' + host, user=user, password=password)
+
+
+def samba_open_text(full, host):
+    """The text that tells the address of the file sharing when it takes no password: full, with {host} and
+    {windows}."""
+    host = str(host or '').strip() or '?'
+    return full.format(host=host, windows='\\\\' + host)
