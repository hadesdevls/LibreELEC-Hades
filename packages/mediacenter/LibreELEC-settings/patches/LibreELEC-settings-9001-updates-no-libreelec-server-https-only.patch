+++ b/resources/lib/modules/updates.py
@@ -42,7 +42,7 @@ class updates(modules.Module):
             'settings': {
                 'AutoUpdate': {
                     'name': 32014,
-                    'value': 'auto',
+                    'value': 'manual',  # Hades: manual by default
                     'action': 'set_auto_update',
                     'type': 'multivalue',
                     'values': ['auto', 'manual'],
@@ -51,7 +51,7 @@ class updates(modules.Module):
                 },
