@@ -208,6 +208,13 @@ class updates(modules.Module):
             return s[:-len(suffix)]
         return s
 
+    @staticmethod
+    def https_url(url):
+        """Hades: never fetch update data or images over plain HTTP."""
+        if url.startswith('http://'):
+            return f'https://{url[len("http://"):]}'
+        return url
+
     # Identify connected GPU card (card0, card1 etc.)
     @log.log_function()
     def get_gpu_card(self):
@@ -414,6 +421,9 @@ class updates(modules.Module):
         self.struct['update']['settings']['Build']['value'] = ''
         update_json = self.build_json(notify_error=True)
         if not update_json:
+            # Hades: explain how to update while there is no update channel
+            if not self.UPDATE_DOWNLOAD_URL and self.struct['update']['settings']['ShowCustomChannels']['value'] != '1':
+                xbmcgui.Dialog().ok(oe._(32013), oe._(32914))
             return
         self.update_json = update_json
         builds = self.get_available_builds()
@@ -445,9 +455,13 @@ class updates(modules.Module):
     def get_json(self, url=None):
         """Download and extract data from a releases.json file. Complete the URL if necessary."""
         if not url:
+            # Hades: no official update channel yet
+            if not self.UPDATE_DOWNLOAD_URL:
+                return {}
             url = self.UPDATE_DOWNLOAD_URL % ('releases', 'releases.json')
         if not url.startswith(('http://', 'https://', 'file://')):
             url = f'https://{url}'
+        url = self.https_url(url)
         if not url.endswith('.json'):
             url = f'{url}/releases.json'
         data = oe.load_url(url)
@@ -455,7 +469,8 @@ class updates(modules.Module):
 
     @log.log_function()
     def build_json(self, notify_error=False):
-        update_json = self.get_json()
+        # an unreachable official channel must not break the custom channels below
+        update_json = self.get_json() or {}
         if self.struct['update']['settings']['ShowCustomChannels']['value'] == '1':
             custom_urls = []
             for i in 1,2,3:
@@ -547,6 +562,10 @@ class updates(modules.Module):
 
     @log.log_function()
     def check_updates_v2(self, force=False):
+        # Hades: no official update channel yet, so there is nothing to ask
+        if not self.UPDATE_REQUEST_URL:
+            log.log('No update channel configured (exit)', log.DEBUG)
+            return
         if hasattr(self, 'update_in_progress'):
             log.log('Update in progress (exit)', log.DEBUG)
             return
@@ -580,6 +599,15 @@ class updates(modules.Module):
     @log.log_function()
     def do_autoupdate(self, listItem=None, silent=False):
         if hasattr(self, 'update_file'):
+            # Hades: updates are only downloaded over HTTPS, or from a local file
+            self.update_file = self.https_url(self.update_file)
+            if not self.update_file.startswith(('https://', 'file://')):
+                log.log(f'Refusing to download an update without HTTPS: {self.update_file}', log.ERROR)
+                if not silent:
+                    xbmcgui.Dialog().ok(oe._(32013), oe._(32915))
+                if hasattr(self, 'update_in_progress'):
+                    delattr(self, 'update_in_progress')
+                return
             if not os.path.exists(self.LOCAL_UPDATE_DIR):
                 os.makedirs(self.LOCAL_UPDATE_DIR)
             downloaded = oe.download_file(self.update_file, oe.TEMP + 'update_file', silent)
