From fb4a4ab3b2d6c7b8bbbc0522e3b5fda3ba59eefd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:23:00 +0000
Subject: [PATCH] system: do not overwrite an RTC that runs in local time

At every start the service writes the system time to the RTC as UTC
(hwclock --systohc --utc). On a PC that also runs Windows the RTC runs in
local time, which Hades declares in /etc/adjtime (third line LOCAL):
writing UTC there moves the Windows clock by the UTC offset. Leave such an
RTC untouched; the system clock is kept right by NTP.
---
 resources/lib/modules/system.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 874b70f..feabfca 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -23,6 +23,16 @@ import timezone
 
 xbmcDialog = xbmcgui.Dialog()
 
+
+def rtc_in_local_time():
+    '''True if /etc/adjtime says the RTC runs in local time (same rule as systemd).'''
+    try:
+        with open('/etc/adjtime', encoding='utf-8') as adjtime:
+            lines = adjtime.read().splitlines()
+    except OSError:
+        return False
+    return len(lines) >= 3 and lines[2] == 'LOCAL'
+
 class system(modules.Module):
 
     ENABLED = False
@@ -499,6 +509,12 @@ class system(modules.Module):
     def set_hw_clock(self):
         # does device have an RTC?
         if os.path.exists('/proc/driver/rtc'):
+            # Hades: an RTC that runs in local time (/etc/adjtime says LOCAL, as on a PC
+            # that also runs Windows) belongs to the other system: writing UTC to it would
+            # move that system's clock by the UTC offset.
+            if rtc_in_local_time():
+                log.log('RTC runs in local time (/etc/adjtime): not writing it', log.INFO)
+                return
             os_tools.execute(f'{self.SET_CLOCK_CMD} 2>/dev/null')
 
     @log.log_function()
