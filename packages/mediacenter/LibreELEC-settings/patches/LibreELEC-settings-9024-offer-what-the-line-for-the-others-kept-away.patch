From ad25e321b9f6ab3a028feb9ebc328017a1f9efdc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:37:22 +0000
Subject: [PATCH] system: offer what the line for the others kept away, and
 name what went untold

A disk that the init kept away because the list does not name it was not
offered: the only way to show it again was to show every disk that the list
does not name. internal-disk-choice now gives it with its size, and the
settings offer it by what it is (its model, its size and the end of its
serial number), as a disk of the list that was kept away. The disks without
a serial number that the init kept away are named with the ones of this start
that cannot be told apart.
---
 resources/lib/modules/system.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 6810e77..6b9f47a 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -1651,7 +1651,7 @@ MaxRetentionSec=0
             xbmcDialog.ok(title, oe._(33160))
             return
         head = {}
-        here, hidden, gone, fixed, twins, stayed = [], [], [], [], [], []
+        here, hidden, gone, fixed, twins, unknown, stayed = [], [], [], [], [], [], []
         for line in lines:
             word, _, rest = line.partition(' ')
             if word in ('start', 'list', 'others', 'this'):
@@ -1666,6 +1666,8 @@ MaxRetentionSec=0
                 twins.append(self.disk_fields(line))
             elif word == 'fixed':
                 fixed.append(self.disk_fields(line))
+            elif word == 'unknown':
+                unknown.append(self.disk_fields(line))
             elif word == 'stayed':
                 stayed.append(self.disk_fields(line))
         # what the init could not do in this start, first: the disks are attached, and no internal partition is
@@ -1691,11 +1693,16 @@ MaxRetentionSec=0
         # (the disk that this system is on is never kept away, and is not offered)
         told = [d for d in here if d.get('id') == 'yes' and d.get('own') != 'yes']
         untold = [d for d in here if d.get('id') != 'yes' and d.get('own') != 'yes']
+        # (one that the init kept away because the list does not name it is offered by what it is)
+        for d in hidden:
+            if not d.get('desc'):
+                d['desc'] = self.partition_enc(self.disk_desc(d))
         if not told and not hidden and not gone:
             xbmcDialog.ok(title, oe._(33154))
             return
-        if untold:
-            xbmcDialog.ok(title, oe._(33151) % ', '.join(self.partition_dec(d.get('dev', '')) for d in untold))
+        # (those that cannot be told apart: the ones here, and the ones that the init kept away)
+        if untold or unknown:
+            xbmcDialog.ok(title, oe._(33151) % ', '.join(self.partition_dec(d.get('dev', '')) for d in untold + unknown))
         if fixed:
             xbmcDialog.ok(title, oe._(33152) % ', '.join(self.partition_dec(d.get('dev', '')) for d in fixed))
         known = hidden + gone
-- 
2.53.0

