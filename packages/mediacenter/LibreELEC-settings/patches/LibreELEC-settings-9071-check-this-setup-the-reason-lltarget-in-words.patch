From 1b63fd29e1b57e708b4689ca41d74a38de85f0b0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:22:10 +0000
Subject: [PATCH] check this setup: the reason lltarget in words

Kodi gives a new reason why Dolby Vision is not sent natively,
"lltarget" (the display offers Dolby Vision Low-Latency only, and the
peak or colours its Dolby Vision block gives for it cannot be used), and
Estuary says it in words (61173, "DV Low-Latency only, its peak or
colours cannot be used"). The table of the check (DV_REASON) did not
have it, so a picture check on such a display would have said the code
itself after "Not sent as Dolby Vision:". It now says Estuary's words,
as the player information does.

Host test: test_estuary_tables_are_its_variables (every value of
Estuary's HadesDVReasonVar is in DV_REASON with the same string) failed
on the Kodi of this version without this change, and passes with it.
---
 resources/lib/hades_check.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/resources/lib/hades_check.py b/resources/lib/hades_check.py
index 75045cb..649de16 100644
--- a/resources/lib/hades_check.py
+++ b/resources/lib/hades_check.py
@@ -378,6 +378,7 @@ DV_REASON = {
     'converteroff': 52905, 'converterunlisted': 52906, 'sink': 51891, 'frl': 51892, 'link': 51893,
     'driveredid': 51894, 'refused': 51895, 'nomode': 51896, 'noratemode': 51931, 'capture': 51930,
     'vaapioff': 51917, 'vaapicodec': 51918, 'software': 51919, 'nodv': 61170, 'edidpart': 61171,
+    'lltarget': 61173,
 }
 
 # The texts of the check itself (strings of this add-on)
