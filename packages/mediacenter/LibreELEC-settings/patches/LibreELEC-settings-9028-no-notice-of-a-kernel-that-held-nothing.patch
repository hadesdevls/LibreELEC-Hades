From abb25754d0780427c176a88cab29dd2d50e5b8a0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:36:22 +0000
Subject: [PATCH] system: no notice of a kernel that could not hold disks off
 where none was kept away

"Disks kept away, but the kernel could not lock them out" was said where the
switch or the lockdown was missing, also where a list that could be read kept
nothing away in that start. It is said now only where a disk went.
---
 resources/lib/modules/system.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 4d96f47..77358bf 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -1606,7 +1606,8 @@ MaxRetentionSec=0
         or None; and how it went (as INTERNAL_DISK_CHOICE says it in "list"): "unsafe" where nothing was let go
         of, since the disk of this system could not be told; "open" where one that was to be kept away is still
         attached (in both, no internal partition is mounted in this start); "held" where what went is held by
-        the kernel (the switch set and the kernel locked down); else "loose".'''
+        the kernel (the switch set and the kernel locked down), or where a list that could be read kept nothing
+        away; else "loose".'''
         try:
             with open(self.INTERNAL_DISK_LEFT, 'r', errors='replace') as f:
                 lines = f.read(65536).splitlines()
@@ -1621,7 +1622,11 @@ MaxRetentionSec=0
             return state, 'unsafe'
         if any(line.startswith('stayed ') for line in lines):
             return state, 'open'
-        return state, 'held' if 'switch yes' in lines and 'lockdown yes' in lines else 'loose'
+        if 'switch yes' in lines and 'lockdown yes' in lines:
+            return state, 'held'
+        if state == 'chosen' and not any(line.startswith(('hidden ', 'unknown ')) for line in lines):
+            return state, 'held'
+        return state, 'loose'
 
     @log.log_function()
     def tell_internal_disk_choice(self):
-- 
2.53.0

