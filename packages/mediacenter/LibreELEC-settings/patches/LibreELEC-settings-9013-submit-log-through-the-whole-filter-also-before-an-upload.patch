     @log.log_function()
     def upload_logs(self, log_cmd):
+        '''Hades: uploads what the command collects after the same filter as a log that is kept on
+        this system (LibreELEC's command uploads it as it is). The command is told to print (-c),
+        what the filter prints waits in a file of LOG_UPLOAD_DIR (in memory, readable by root only)
+        and is handed to LOG_UPLOAD, and the file goes when that is done. A command or a filter that
+        fails, or prints nothing, uploads nothing. What became of the upload is said whether or not
+        Cancel was pressed meanwhile: Cancel stops nothing here, and a log that was sent is not left
+        unsaid.'''
         paste_dlg = xbmcgui.DialogProgress()
         paste_dlg.create(oe._(32376), oe._(32417))
-        result = os_tools.execute(log_cmd, get_result=True)
-        # Hades: what became of the upload is said whether or not Cancel was pressed meanwhile.
-        # Cancel stops nothing here, and a log that was sent is not left unsaid.
+        result = None
+        path = None
+        try:
+            fd, path = tempfile.mkstemp(prefix='hades-upload.', suffix='.txt', dir=self.LOG_UPLOAD_DIR)
+            with os.fdopen(fd, 'wb') as out:
+                self.collect_log(log_cmd, out)
+            if os.path.getsize(path) == 0:
+                raise OSError('nothing was collected')
+            result = os_tools.execute(f'{self.LOG_UPLOAD} {shlex.quote(path)}', get_result=True)
+        except Exception as e:
+            log.log(f'{log_cmd} -c: the log was not uploaded: {e!r}', log.ERROR)
+        finally:
