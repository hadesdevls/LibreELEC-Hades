diff --git a/resources/lib/hades_update.py b/resources/lib/hades_update.py
index 8566c27..3e8412a 100644
--- a/resources/lib/hades_update.py
+++ b/resources/lib/hades_update.py
@@ -15,24 +15,50 @@ Without any of them, or with any of them malformed, there is no channel and noth
 The manifest is JSON, and its signature a small JSON file next to it (<manifest address>.sig) that names
 the key and holds the Ed25519 signature (RFC 8032) of SIGNED_PREFIX + the bytes of the manifest. The
 signature is checked before the manifest is read. Then:
+  - it has exactly the fields of its format (none missing, none more, none twice);
   - its channel and architecture must be this image's;
   - its serial may not be lower than the highest that this system has taken from the channel (an older
     manifest, served again, is refused), and it must not have expired, which needs a clock set over the
     network: without one, nothing is taken;
-  - the release that it names is offered only when its serial is higher than this image's;
-  - the file is downloaded over HTTPS only (a redirect to anything else is refused), at most the size
-    that the manifest gives, and taken only when its size and SHA-256 are the ones of the manifest.
-Anything else, at any step, is an error (ChannelError): nothing is downloaded, kept or installed.
+  - the release that it names is offered only when its serial is higher than this image's, and installed
+    from here only when this image's serial is at least the release's min_serial (the oldest release
+    that it can be installed over: an older one is told to install it anew);
+  - the file is downloaded over HTTPS only, at most the size that the manifest gives, and taken only when
+    its size and SHA-256 are the ones of the manifest; and only when the storage has room for it and for
+    what the init unpacks from it next to it.
+Every request is a GET with a fixed user agent and nothing else of the system: no proxy of the environment,
+no cookies, no system id. A redirect is followed only over HTTPS, at most MAX_REDIRECTS times, and only to
+the same host and port or to one of the hosts that GitHub serves the files of a release from (ASSET_HOSTS,
+on the HTTPS port); anything else is refused without being asked. A manifest or its signature has to come
+whole within FETCH_DEADLINE seconds, and a download that brings less than STALL_BYTES in STALL_WINDOW
+seconds is given up (a server that sends a byte now and then holds nothing for long).
+Anything else, at any step, is an error (ChannelError): nothing is downloaded, kept or installed. NotYet
+is the error of a channel that could not be asked yet (no network, or no clock set over the network yet),
+which a later look may get past; Missing, of an address that the server says is not there (HTTP 404),
+which for the manifest is a channel with no version in it yet: nothing newer, and no error.
+
+A manifest:
+  {"format": "hades-update-manifest-1", "channel": "stable", "serial": <whole number>,
+   "issued": "<UTC, %Y-%m-%dT%H:%M:%SZ>", "expires": "<UTC>",
+   "release": {"version": "<as the system shows it>", "serial": <whole number>,
+               "min_serial": <whole number, at most the serial>, "arch": "<DISTRO_ARCH>",
+               "notes": "<https address>" (the only field that may be left out),
+               "file": {"name": "<name>.tar", "url": "<https address>", "size": <bytes>,
+                        "sha256": "<64 lowercase hex digits>"}}}
+A signature file:
+  {"format": "hades-update-signature-1", "key": "<key_id() of the key>", "signature": "<64 bytes, base64>"}
 '''
 
 import base64
 import binascii
 import calendar
+import errno
 import hashlib
 import http.client
 import json
 import os
 import re
+import socket
 import threading
 import time
 import urllib.error
@@ -47,18 +73,52 @@ SIGNED_PREFIX = b'hades-update-manifest-1\n'
 MANIFEST_MAX = 64 * 1024
 SIGNATURE_MAX = 4096
 FILE_MAX = 2 * 1024 ** 3
-# (what it takes to download a file: room for it and some more)
-ROOM_MARGIN = 64 * 1024 ** 2
+# (what it takes to download a file: room for it, for what the init unpacks from it next to it at the next
+# start - its KERNEL and SYSTEM, as large as the file - and some more, for a copy of the kernel that the init
+# signs when the system starts with Secure Boot)
+ROOM_MARGIN = 128 * 1024 ** 2
+# (where GitHub serves the files of a release from: "releases/latest/download/<name>" answers with a redirect
+# to the release on github.com, which answers with one to release-assets.githubusercontent.com; the
+# objects.githubusercontent.com of before is kept. A redirect may go to one of these on the HTTPS port, or stay
+# on its own host and port, and nowhere else)
+ASSET_HOSTS = frozenset(('github.com', 'release-assets.githubusercontent.com', 'objects.githubusercontent.com'))
+ASSET_PORT = 443
+MAX_REDIRECTS = 4
+USER_AGENT = 'LibreELEC-Hades-update'
+# (a manifest or a signature comes whole within this many seconds, or not at all)
+FETCH_DEADLINE = 60
+# (a download that brings fewer bytes than this in this many seconds has stalled)
+STALL_WINDOW = 120
+STALL_BYTES = 64 * 1024
+PART_NAME = 'hades-update.part'
 SYNC_FLAGS = ('/run/connman/ntp-synchronized', '/run/systemd/timesync/synchronized')
 TIME_FORMAT = '%Y-%m-%dT%H:%M:%SZ'
 FILE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,199}\.tar')
 CHANNEL_NAME = re.compile(r'[a-z0-9][a-z0-9-]{0,31}')
+# (the fields of each part: a manifest with one missing, one more or one twice is not one)
+MANIFEST_FIELDS = frozenset(('format', 'channel', 'serial', 'issued', 'expires', 'release'))
+RELEASE_FIELDS = frozenset(('version', 'serial', 'min_serial', 'arch', 'notes', 'file'))
+RELEASE_OPTIONAL = frozenset(('notes',))
+FILE_FIELDS = frozenset(('name', 'url', 'size', 'sha256'))
+SIGNATURE_FIELDS = frozenset(('format', 'key', 'signature'))
+# (what a signed manifest gives: its release to be offered, nothing newer than this image, or a release
+# newer than this image that cannot be installed over it from here)
+OFFER, CURRENT, REINSTALL = 'offer', 'current', 'reinstall'
 
 
 class ChannelError(Exception):
     '''Why nothing is taken from the channel (for the log).'''
 
 
+class NotYet(ChannelError):
+    '''The channel could not be asked yet: no network, or no clock set over the network yet.'''
+
+
+class Missing(ChannelError):
+    '''The server answered that the address is not there (HTTP 404): for the manifest, a channel that has no
+    version in it yet (a release published without one, or none published since the channel began).'''
+
+
 class Cancelled(ChannelError):
     '''A download stopped by the user or by Kodi's exit.'''
 
@@ -80,9 +140,35 @@ def https_url(url):
     if not isinstance(url, str) or len(url) > 2048 or any(c.isspace() or ord(c) < 32 for c in url):
         return False
     parts = urllib.parse.urlsplit(url)
+    try:
+        parts.port
+    except ValueError:
+        return False
     return parts.scheme == 'https' and bool(parts.hostname)
 
 
+def shown(url):
+    '''An address as the log shows it: without what follows the path (GitHub's addresses of files carry a
+    signed query, which says nothing of this system but is no use in a log either).'''
+    try:
+        parts = urllib.parse.urlsplit(str(url))
+        return urllib.parse.urlunsplit((parts.scheme, parts.netloc.rpartition('@')[2], parts.path, '', ''))
+    except ValueError:
+        return '(an address that cannot be read)'
+
+
+def redirect_allowed(current, new):
+    '''Whether a redirect from current to new is followed: new is HTTPS, names no user, and stays on the host
+    and port of current or goes to one of GitHub's hosts of the files of releases on the HTTPS port.'''
+    if not https_url(new):
+        return False
+    p, c = urllib.parse.urlsplit(new), urllib.parse.urlsplit(current)
+    if p.username is not None or p.password is not None:
+        return False
+    port, current_port = p.port or 443, c.port or 443
+    return (p.hostname, port) == (c.hostname, current_port) or (p.hostname in ASSET_HOSTS and port == ASSET_PORT)
+
+
 def key_id(raw):
     return hashlib.sha256(raw).hexdigest()[:16]
 
@@ -140,14 +226,51 @@ def read_channel(folder=CHANNEL_DIR):
     return Channel(url, name, keys, int(serial_text))
 
 
+def _object(pairs):
+    '''A JSON object that has no field twice.'''
+    obj = {}
+    for k, v in pairs:
+        if k in obj:
+            raise ValueError(f'the field {k!r} twice')
+        obj[k] = v
+    return obj
+
+
+def _constant(name):
+    raise ValueError(f'{name} is not a value of the channel')
+
+
+def strict_json(data):
+    '''The JSON of data (UTF-8, no field twice in an object, no NaN or infinity). Raises ValueError.'''
+    try:
+        return json.loads(data.decode('utf-8'), object_pairs_hook=_object, parse_constant=_constant)
+    except RecursionError:
+        # (arrays or objects nested deeper than Python goes: the signature file is read before anything is
+        # checked, and its 4096 bytes can nest that deep; refused as any other file that is not one)
+        raise ValueError('nested deeper than any file of the channel') from None
+
+
+def fields(obj, names, optional=frozenset(), what='the manifest'):
+    '''Raises ValueError unless obj is an object with exactly the fields names (those of optional may be
+    left out).'''
+    if not isinstance(obj, dict):
+        raise ValueError(f'{what} is not an object')
+    more, missing = set(obj) - names, names - optional - set(obj)
+    if more:
+        raise ValueError(f'{what} has fields that it may not have: {sorted(more)}')
+    if missing:
+        raise ValueError(f'{what} lacks {sorted(missing)}')
