diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 2303e3b..e30ece1 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -140,6 +140,49 @@ def write_clock_choice(path, choice):
         raise OSError(f'{path} does not say {choice} after it was written')
 
 
+# Hades: the setting "Wake from sleep" (hades-wake): what may wake the PC from sleep besides its power button
+WAKE_CHOICES = ['remotes', 'keyboards', 'button']
+
+
+def wake_choice(path):
+    '''The choice in force: the word of the file, or 'remotes' (the default) where there is none or it says
+    something else, as hades-wake reads it.'''
+    try:
+        with open(path, encoding='utf-8', errors='replace') as f:
+            word = f.readline().strip()
+    except OSError:
+        return 'remotes'
+    return word if word in WAKE_CHOICES else 'remotes'
+
+
+def write_wake_choice(path, choice):
+    '''No file for the default (remotes); otherwise its word, written beside the file and renamed over it
+    when whole and on the drive, so that hades-wake never reads half of one. Then read back. Raises OSError
+    when what it says is not what was asked for.'''
+    folder = os.path.dirname(path)
+    if choice == 'remotes':
+        if os.path.islink(path) or os.path.isfile(path):
+            os.remove(path)
+    else:
+        os.makedirs(folder, exist_ok=True)
+        fd, part = tempfile.mkstemp(prefix='.hades-wake.', dir=folder)
+        try:
+            with os.fdopen(fd, 'w', encoding='utf-8') as out:
+                out.write(f'{choice}\n')
+                out.flush()
+                os.fsync(out.fileno())
+            os.chmod(part, 0o644)
+            os.replace(part, path)
+        except BaseException:
+            try:
+                os.remove(part)
+            except OSError:
+                pass
+            raise
+    if wake_choice(path) != choice:
+        raise OSError(f'{path} does not say {choice}')
+
+
