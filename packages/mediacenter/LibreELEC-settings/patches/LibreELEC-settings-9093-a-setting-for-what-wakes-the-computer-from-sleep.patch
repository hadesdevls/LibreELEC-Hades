         if status == 0 and words and words[0].isdigit():
             listItem.setProperty('value', words[0])
 
+    # Hades: the setting "Wake from sleep". The choice is one word in WAKE_CHOICE (none: remotes), which
+    # hades-wake reads at each start (udev), for each device plugged in and after each sleep; it is applied
+    # here at once, so a change needs no restart.
+    WAKE_LABELS = {'remotes': 34103, 'keyboards': 34104, 'button': 34105}
+
+    def can_sleep(self):
+        try:
+            with open(self.SLEEP_STATES, encoding='utf-8') as f:
+                states = f.read().split()
+        except OSError:
+            return False
+        return 'mem' in states or 'freeze' in states
+
+    @log.log_function()
+    def load_wake(self):
+        group = self.struct['sleep']
+        if not self.WAKE_CHOICE or not self.WAKE_HELPER or not os.path.exists(self.WAKE_HELPER) \
+                or not self.can_sleep():
+            # a system without it, or a computer that cannot sleep
+            group['hidden'] = 'true'
+            return
+        group.pop('hidden', None)
+        setting = group['settings']['wake_from_sleep']
+        choice = wake_choice(self.WAKE_CHOICE)
+        setting['value'] = choice
+        setting['name'] = f'{oe._(34101)} ({oe._(self.WAKE_LABELS[choice])})'
+
+    def apply_wake(self):
+        '''hades-wake sets every device as the choice says, now. What it says goes to the log of Kodi.
+        Returns how many USB input devices may wake the PC, or None where it could not run.'''
+        try:
+            # (not in the environment of Kodi, where add-ons put folders of their own into PATH)
+            done = subprocess.run(['/bin/sh', self.WAKE_HELPER, 'apply'], stdin=subprocess.DEVNULL,
+                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60,
+                                  env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'})
+        except (OSError, subprocess.SubprocessError) as e:
+            log.log(f'hades-wake apply: {e!r}', log.ERROR)
+            return None
+        lines = done.stdout.decode(errors='replace').splitlines()
+        for line in lines:
+            log.log(f'hades-wake: {line}', log.INFO)
+        last = lines[-1].split() if lines else []
+        if done.returncode != 0 or len(last) != 2 or last[0] != 'armed' or not last[1].isdigit():
+            log.log(f'hades-wake apply: exit status {done.returncode}, '
+                    f'{done.stderr.decode(errors="replace").strip()!r}', log.ERROR)
+            return None
+        return int(last[1])
+
+    @log.log_function()
+    def set_wake(self, listItem=None):
+        if not self.WAKE_CHOICE or not self.WAKE_HELPER or not os.path.exists(self.WAKE_HELPER):
+            return
+        title = oe._(34101)
+        now = wake_choice(self.WAKE_CHOICE)
+        # (the entry that holds is preselected: it is what Kodi answers when something else closes the list)
+        index = xbmcDialog.select(title, [oe._(self.WAKE_LABELS[c]) for c in WAKE_CHOICES],
+                                  preselect=WAKE_CHOICES.index(now))
+        if index not in range(len(WAKE_CHOICES)) or WAKE_CHOICES[index] == now:
+            return
+        choice = WAKE_CHOICES[index]
+        try:
+            write_wake_choice(self.WAKE_CHOICE, choice)
+        except OSError as e:
+            log.log(f'{self.WAKE_CHOICE}: the choice of what wakes the PC was not kept: {e!r}', log.ERROR)
+            xbmcDialog.ok(title, oe._(34107))
+            self.load_wake()
+            return
+        log.log(f'{self.WAKE_CHOICE}: wake from sleep with {choice}', log.INFO)
+        armed = self.apply_wake()
+        if armed is None:
+            # (kept: hades-wake applies it at the next start)
+            xbmcDialog.ok(title, oe._(34108))
+        else:
+            oe.notify(f'{title}: {oe._(self.WAKE_LABELS[choice])}', oe._(34106) % armed)
+        self.load_wake()
+
     @log.log_function()
     def reset_internal_disks(self):
         '''Before a reset: a system that is reset does not go on showing the internal disks. The
