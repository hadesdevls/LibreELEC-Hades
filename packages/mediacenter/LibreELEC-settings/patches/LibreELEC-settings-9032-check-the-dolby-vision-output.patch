+            return
+        if not xbmcDialog.yesno(title, oe._(33402), defaultbutton=xbmcgui.DLG_YESNO_NO_BTN):
+            return
+        # (while Kodi stops, a question is not shown, and Kodi answers it with the answer that the last one got)
+        if oe.xbmcm.abortRequested():
