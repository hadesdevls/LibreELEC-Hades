+    # Hades: whether the graphics card passes the bytes of Dolby Vision through unchanged, measured with its own CRC
+    # of its output (hades-output-check, in the diagnostics). The measure needs the display for itself: it is made
+    # by hades-output-check.service before Kodi starts, when the file "request" is in OUTPUT_CHECK_DIR, so Kodi is
+    # started again for it. Never while a video plays, and nothing of it runs unless asked for. The report it
+    # writes (result.txt, with "new" beside it) is shown once when Kodi is back, and again from the button.
+
+    # what each result and reason of the report are told with: (headline, explanation)
+    OUTPUT_CHECK_TEXTS = {
+        'exact': (33404, 33410),
+        'not-exact': (33405, 33412),
+        'not-judged': (33406, 33414),
+        'unavailable': (33407, 33424),
+        }
+    OUTPUT_CHECK_REASONS = {
+        'unstable': 33411, 'drift': 33411, 'transformed': 33412, 'bit-lost': 33413,
+        'nvidia': 33420, 'no-tunnel': 33421, 'no-display': 33422,
+        'no-crc': 33423, 'no-debugfs': 33423, 'crc-open': 33423, 'crc-locked': 33423,
+        }
+
+    def output_check_run(self, *args):
+        '''Run the tool (only --probe from here: no change of mode, no need of the display). Returns its report as
+        a dictionary of its first lines (result, reason, summary, meaning) and the whole text.'''
+        try:
+            process = subprocess.run([self.OUTPUT_CHECK] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                                     stderr=subprocess.PIPE, env={'PATH': '/usr/bin:/usr/sbin', 'LC_ALL': 'C'},
+                                     timeout=30)
+            text = process.stdout.decode(errors='replace')
+        except (OSError, subprocess.TimeoutExpired) as e:
+            log.log(f'hades-output-check {" ".join(args)}: {e}', log.ERROR)
+            return {}, ''
+        return self.output_check_fields(text), text
+
+    @staticmethod
+    def output_check_fields(text):
+        fields = {}
+        for line in text.splitlines():
+            key, sep, value = line.partition(': ')
+            if sep and key in ('result', 'reason', 'summary', 'meaning') and key not in fields:
+                fields[key] = value.strip()
+        return fields
+
+    def output_check_text(self, fields, text):
+        '''What a report says, in the language of the interface first, then the report itself (in English).'''
+        result = fields.get('result', '')
+        reasons = fields.get('reason', '').split(',')
+        headline, explanation = self.OUTPUT_CHECK_TEXTS.get(result, (33406, 33414))
+        for reason in reasons:
+            if result in ('not-exact', 'unavailable') and reason in self.OUTPUT_CHECK_REASONS:
+                explanation = self.OUTPUT_CHECK_REASONS[reason]
+                break
+        return f'[B]{oe._(headline)}[/B]\n\n{oe._(explanation)}\n\n{oe._(33425)}\n{text.strip()}'
+
+    @log.log_function()
+    def load_output_check(self):
+        setting = self.struct['debug']['settings']['output_check']
+        if not self.OUTPUT_CHECK or not os.path.exists(self.OUTPUT_CHECK):
+            # a system without it
+            setting['hidden'] = 'true'
+        else:
+            setting.pop('hidden', None)
+
+    def output_check_last(self):
+        try:
+            with open(os.path.join(self.OUTPUT_CHECK_DIR, 'result.txt'), encoding='utf-8', errors='replace') as f:
+                text = f.read()
+        except OSError:
+            return None
+        return self.output_check_fields(text), text
+
+    @log.log_function()
+    def do_output_check(self, listItem=None):
+        title = oe._(33400)
+        if not self.OUTPUT_CHECK or not os.path.exists(self.OUTPUT_CHECK):
+            return
+        last = self.output_check_last()
+        if last and last[0].get('result'):
+            # the last report first; then whether to check again (the default answer is no)
+            xbmcDialog.textviewer(title, self.output_check_text(*last))
+        fields, text = self.output_check_run('--probe')
+        if fields.get('result') != 'ready':
