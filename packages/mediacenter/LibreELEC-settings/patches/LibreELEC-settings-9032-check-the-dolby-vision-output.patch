diff --git a/resources/language/resource.language.en_gb/strings.po b/resources/language/resource.language.en_gb/strings.po
index 5b05f78..02bd5ab 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1651,3 +1651,79 @@ msgstr ""
 msgctxt "#33177"
 msgid "File sharing (Samba) is on. Its user and password are shown in Settings > LibreELEC > Services > Samba."
 msgstr ""
+
+msgctxt "#33400"
+msgid "Check the Dolby Vision output"
+msgstr ""
+
+msgctxt "#33401"
+msgid "Measures whether the graphics card sends the pictures of Dolby Vision exactly as LibreELEC Hades draws them, with the card's own check of what leaves it (a CRC). Kodi closes, the TV shows a black or noisy picture in Dolby Vision for about ten seconds, and Kodi starts again with the result. No setting is changed. It needs a TV that takes Dolby Vision, connected now. It is not possible on NVIDIA cards, whose driver does not offer this measure. With the diagnostics on, the result goes into them too."
+msgstr ""
+
+msgctxt "#33402"
+msgid "Kodi will close for about twenty seconds while the output is checked, and the TV may show a black or noisy picture in Dolby Vision meanwhile. Then Kodi starts again and shows the result. Check it now?"
+msgstr ""
+
+msgctxt "#33404"
+msgid "Exact: the graphics card sends the bytes of Dolby Vision unchanged."
+msgstr ""
+
+msgctxt "#33405"
+msgid "Not exact: the graphics card changes the bytes of Dolby Vision on their way out."
+msgstr ""
+
+msgctxt "#33406"
+msgid "Not judged: this check cannot tell on this graphics card."
+msgstr ""
+
+msgctxt "#33407"
+msgid "Not checked."
+msgstr ""
+
+msgctxt "#33410"
+msgid "What LibreELEC Hades draws for Dolby Vision leaves the graphics card as it was drawn. The check does not test the HDMI cable or the TV: if the TV still shows no picture in Dolby Vision, the cause is after the graphics card."
+msgstr ""
+
+msgctxt "#33411"
+msgid "The output changed between frames of the same picture (a dither that changes in time, for example). A Dolby Vision TV cannot read its metadata from it, and shows black or wrong colours."
+msgstr ""
+
+msgctxt "#33412"
+msgid "The graphics card converts the bytes (a colour conversion, a curve, a range or a rounding). A Dolby Vision TV cannot read its metadata from them, and shows black or wrong colours."
+msgstr ""
+
+msgctxt "#33413"
+msgid "Some bits do not reach the output (a truncation). A Dolby Vision TV cannot read its metadata from what is left, and shows black or wrong colours."
+msgstr ""
+
+msgctxt "#33414"
+msgid "The measure of this graphics card did not behave as the check needs, or not every test picture could be measured. Nothing is known either way."
+msgstr ""
+
+msgctxt "#33420"
+msgid "NVIDIA's driver does not offer the measure this check needs (the CRC of what leaves the graphics card). On an NVIDIA card, Dolby Vision goes out through the driver's own means."
+msgstr ""
+
+msgctxt "#33421"
+msgid "No connected output offers the Dolby Vision output of LibreELEC Hades: the TV does not take Dolby Vision, or this graphics card does not offer it. On Radeon RX 400, RX 500 and Vega cards it is offered only with \"Dolby Vision on this Radeon (experimental)\" on (Settings > System > Display, Expert level)."
+msgstr ""
+
+msgctxt "#33422"
+msgid "No TV is connected that the check can use. Connect the TV that takes Dolby Vision, turn it on, and try again."
+msgstr ""
+
+msgctxt "#33423"
+msgid "This graphics driver does not offer the measure this check needs (the CRC of what leaves the graphics card)."
+msgstr ""
+
+msgctxt "#33424"
+msgid "The check could not be made. The report below says why."
+msgstr ""
+
+msgctxt "#33425"
+msgid "The report of the check (in English):"
+msgstr ""
+
+msgctxt "#33427"
+msgid "The check could not be started on this system."
+msgstr ""
