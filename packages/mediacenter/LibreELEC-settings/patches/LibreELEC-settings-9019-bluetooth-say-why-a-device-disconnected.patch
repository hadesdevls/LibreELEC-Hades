diff --git a/resources/lib/modules/bluetooth.py b/resources/lib/modules/bluetooth.py
index 9f6859c..8529028 100644
--- a/resources/lib/modules/bluetooth.py
+++ b/resources/lib/modules/bluetooth.py
@@ -490,6 +490,8 @@ class bluetooth(modules.Module):
                 for device in devices.split(','):
                     try:
                         if dbus_bluez.device_get_connected(device):
+                            # Hades: a disconnection that this add-on asks for is said as such
+                            log.log(f'Bluetooth standby: disconnecting {self.device_address(device)}', log.INFO)
                             self.disconnect_device_by_path(device)
                     except DBusError:
                         # bluez no longer knows this device, so there is nothing
@@ -497,6 +499,44 @@ class bluetooth(modules.Module):
                         log.log(f'standby_devices: skipping unknown {device}', log.DEBUG)
 
 
+    # Hades: the address of a device as BlueZ names its object (/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF), written
+    # as an address, which the filter of the diagnostics and of "Submit log" turns into a marker
+    @staticmethod
+    def device_address(path):
+        return path.rsplit('/', 1)[-1].replace('dev_', '').replace('_', ':')
+
+    # Hades: why a device disconnected, in the log (BlueZ says it in its Disconnected signal, and in its own
+    # log only when it runs with debugging). When a paired device did not accept the key that is kept for it
+    # (org.bluez.Reason.Authentication: the kernel saw "PIN or Key Missing" when it started the encryption),
+    # the device was paired again with another system since, or lost its pairing: a device keeps one key per
+    # computer, and Windows and this system on one PC are one computer to it. That is also said on the
+    # screen, once per device and session: BlueZ stops connecting to it after a few attempts, and without a
+    # word the device would just look dead or flaky. Only the address, the kind and the maker's IDs go to
+    # the log; the name, which may be a person's, only to the screen.
+    def device_disconnected(self, path, reason, message):
+        def get(name):
+            try:
+                return dbus_bluez.device_get_property(path, name)
+            except Exception:
+                return None
+        address = self.device_address(path)
+        log.log(f'Bluetooth: {address} ({get("Icon") or "no icon"}, {get("Modalias") or "no modalias"}) disconnected: '
+                f'{reason} ({message})', log.INFO)
+        if reason != 'org.bluez.Reason.Authentication' or not get('Paired'):
+            return
+        log.log(f'Bluetooth: {address} did not accept the key that this system keeps for it: it was paired again '
+                'with another system since (Windows on this PC, for example), or it lost its pairing. It works '
+                'again once it is paired again here; then it does not work with the other system until it is '
+                'paired again there, unless both systems are given the same key', log.INFO)
+        if not hasattr(self, 'key_rejected'):
+            self.key_rejected = set()
+        if address in self.key_rejected:
+            return
+        self.key_rejected.add(address)
+        name = get('Alias') or get('Name') or address
+        xbmcgui.Dialog().notification('Bluetooth', oe._(33120) % name, xbmcgui.NOTIFICATION_WARNING, 10000)
+
+
 ####################################################################
 ## Bluez Listener class
 ####################################################################
@@ -559,6 +599,10 @@ class Bluez_Listener(dbus_bluez.Listener):
             else:
                 self.parent.discover_devices()
 
+    @log.log_function()
+    def on_device_disconnected(self, path, reason, message):
+        self.parent.device_disconnected(path, reason, message)
+
 
