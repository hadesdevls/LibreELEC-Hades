 .../language/resource.language.es_ar/strings.po |  4 ++--
 .../language/resource.language.es_es/strings.po |  4 ++--
 .../language/resource.language.es_mx/strings.po |  4 ++--
 resources/lib/hades_check.py                    | 17 ++++++++++-------
 5 files changed, 17 insertions(+), 14 deletions(-)

