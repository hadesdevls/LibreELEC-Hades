     try:
-        return _download(release_file, folder, final_folder, progress, cancelled, timeout, context)
+        return _download(release_file, folder, final_folder, progress, cancelled, timeout, context, removed)
     finally:
         _downloading.release()
 
 
+def other_updates(final_folder, keep):
+    '''The names in final_folder, other than keep, that the init takes as an update at the next start
+    (packages/sysutils/busybox/scripts/init, check_update: the first *.tar by name, else an *.img.gz or *.img,
+    else KERNEL and SYSTEM). Names that start with a dot are not matched by its patterns.'''
+    try:
+        names = os.listdir(final_folder)
+    except FileNotFoundError:
+        return []
+    return sorted(n for n in names if n != keep and not n.startswith('.')
+                  and (n.endswith(('.tar', '.img', '.img.gz')) or n in ('KERNEL', 'SYSTEM')))
+
+
+def clear_others(final_folder, keep):
+    '''Removes from final_folder every other update that the init would install in place of keep, or with
+    it, so that the next start installs keep and nothing else. A link is removed, never what it points to.
+    Returns the names removed. Raises ChannelError when one cannot be removed (a folder, for one).'''
+    removed = []
+    for name in other_updates(final_folder, keep):
+        path = os.path.join(final_folder, name)
+        try:
+            if os.path.isdir(path) and not os.path.islink(path):
+                raise IsADirectoryError(errno.EISDIR, 'a folder')
+            os.remove(path)
+        except FileNotFoundError:
+            continue
+        except OSError as e:
+            raise ChannelError(f'{name} in {final_folder} would be installed in place of {keep}, and it cannot be '
+                               f'removed: {e}') from None
+        removed.append(name)
+    return removed
+
+
+def _whole(f, size, sha256):
+    '''Whether what f reads from its start, to its end, is size bytes with that SHA-256.'''
+    digest, n = hashlib.sha256(), 0
+    for piece in iter(lambda: f.read(1024 * 1024), b''):
+        n += len(piece)
+        if n > size:
+            return False
+        digest.update(piece)
+    return n == size and digest.hexdigest() == sha256
+
+
 def forget_part(folder):
     '''Removes what a download cut short by a power cut or a kill of Kodi left in folder (its part file), unless
     a download runs now. Never anything else.'''
@@ -488,16 +536,14 @@ def already_there(release_file, final_folder):
