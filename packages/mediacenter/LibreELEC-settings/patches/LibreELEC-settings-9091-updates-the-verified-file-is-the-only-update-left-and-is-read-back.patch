     window_start, window_bytes = time.monotonic(), 0
     try:
         with _open(release_file['url'], timeout, context) as response, \
-                open(part, 'xb') as out:
+                open(part, 'xb+') as out:
             while True:
                 if cancelled is not None and cancelled():
                     raise Cancelled('cancelled')
@@ -542,10 +588,24 @@ def _download(release_file, folder, final_folder, progress, cancelled, timeout,
                     window_start, window_bytes = now, 0
             out.flush()
             os.fsync(out.fileno())
-        if done != size:
-            raise ChannelError(f'{done} bytes, not the {size} of the manifest')
-        if digest.hexdigest() != want:
-            raise ChannelError('the SHA-256 of the file is not the one of the manifest')
+            if done != size:
+                raise ChannelError(f'{done} bytes, not the {size} of the manifest')
+            if digest.hexdigest() != want:
+                raise ChannelError('the SHA-256 of the file is not the one of the manifest')
+            # (what was written is read back, through the same descriptor: the file kept has to be the signed
+            # bytes, not only what came; something else that wrote into it meanwhile makes it another file)
+            out.seek(0)
+            if not _whole(out, size, want):
+                raise ChannelError('the file written is not the one that came: its size or its SHA-256 changed '
+                                   'after it was written')
+            kept = os.fstat(out.fileno())
+        names = clear_others(final_folder, release_file['name'])
+        if removed is not None:
+            removed.extend(names)
+        # (and the name moved is still that file, not another put in its place)
+        st = os.lstat(part)
+        if (st.st_dev, st.st_ino) != (kept.st_dev, kept.st_ino):
+            raise ChannelError(f'{part} is no longer the file that was downloaded and checked')
         os.replace(part, final)
     except BaseException:
         try:
