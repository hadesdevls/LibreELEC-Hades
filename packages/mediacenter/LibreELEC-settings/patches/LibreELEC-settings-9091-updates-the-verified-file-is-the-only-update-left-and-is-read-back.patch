         if os.path.islink(final) or not os.path.isfile(final) or os.path.getsize(final) != release_file['size']:
             return None
-        digest = hashlib.sha256()
         with open(final, 'rb') as f:
-            for piece in iter(lambda: f.read(1024 * 1024), b''):
-                digest.update(piece)
+            whole = _whole(f, release_file['size'], release_file['sha256'])
     except OSError:
         return None
-    return final if digest.hexdigest() == release_file['sha256'] else None
+    return final if whole else None
 
 
-def _download(release_file, folder, final_folder, progress, cancelled, timeout, context):
