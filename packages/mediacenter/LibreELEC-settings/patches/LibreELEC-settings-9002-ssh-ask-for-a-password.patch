diff --git a/resources/lib/modules/services.py b/resources/lib/modules/services.py
index 1e70f95..7ae0f2e 100644
--- a/resources/lib/modules/services.py
+++ b/resources/lib/modules/services.py
@@ -420,6 +420,20 @@ class services(modules.Module):
         else:
             state = 0
         oe.set_service('sshd', options, state)
+        # Hades: sshd refuses password logins while root has the default password, so offer to
+        # set one right away, as the first-run wizard does
+        if 'listItem' in kwargs and state == 1 and self.is_default_password():
+            self.wizard_sshpasswd()
+            if self.is_default_password():
+                xbmcDialog.ok(oe._(32209), oe._(32913))
+
+    @log.log_function()
+    def is_default_password(self):
+        # Hades: the same check sshd uses
+        try:
+            return subprocess.run(['/usr/lib/libreelec/sshd-default-password', 'check']).returncode == 0
+        except OSError:
+            return False
 
     @log.log_function()
     def initialize_avahi(self, **kwargs):
@@ -573,6 +587,10 @@ class services(modules.Module):
                 xbmcDialog.ok(oe._(32224), oe._(32225))
         else:
             log.log('User cancelled')
+        # Hades: let a running sshd pick up whether root still has the default
+        # password
+        if SSHchange:
+            subprocess.run(['systemctl', 'try-reload-or-restart', 'sshd.service'])
         return SSHchange
 
     def sh_esc_str(self, string):
