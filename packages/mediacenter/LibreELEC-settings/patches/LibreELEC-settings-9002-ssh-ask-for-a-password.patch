From 9007fc4333573099d7fecf95715067933561e775 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 01:30:15 +0000
Subject: [PATCH] services: ask for an SSH password when enabling SSH with the
 default one

Hades sshd refuses password logins while root still has the well-known
default password (SSH keys keep working). The first-run wizard already
offers to set a password when SSH is enabled; do the same when SSH is
enabled from the settings, and explain why password logins are refused
if the user keeps the default. After the password changes, a running sshd
is reloaded so that it picks up the new state without dropping sessions.
---
 .../resource.language.en_gb/strings.po         |  4 ++++
 .../resource.language.es_ar/strings.po         |  4 ++++
 .../resource.language.es_es/strings.po         |  4 ++++
 .../resource.language.es_mx/strings.po         |  4 ++++
 resources/lib/modules/services.py              | 18 ++++++++++++++++++
 5 files changed, 34 insertions(+)

diff --git a/resources/language/resource.language.en_gb/strings.po b/resources/language/resource.language.en_gb/strings.po
index 749c1a3..447386b 100644
--- a/resources/language/resource.language.en_gb/strings.po
+++ b/resources/language/resource.language.en_gb/strings.po
@@ -1131,3 +1131,7 @@ msgstr ""
 msgctxt "#32915"
 msgid "This update is not offered over HTTPS, so it was not downloaded."
 msgstr ""
+
+msgctxt "#32913"
+msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
+msgstr ""
diff --git a/resources/language/resource.language.es_ar/strings.po b/resources/language/resource.language.es_ar/strings.po
index c6589f9..a60be18 100644
--- a/resources/language/resource.language.es_ar/strings.po
+++ b/resources/language/resource.language.es_ar/strings.po
@@ -1141,3 +1141,7 @@ msgstr "Todavía no hay un canal de actualizaciones de Hades. Para actualizar, c
 msgctxt "#32915"
 msgid "This update is not offered over HTTPS, so it was not downloaded."
 msgstr "Esta actualización no se ofrece por HTTPS, así que no se descargó."
+
+msgctxt "#32913"
+msgid "While root has the default password, SSH only accepts keys, not passwords. Set a password to log in with one."
+msgstr "Mientras root tenga la contraseña por defecto, SSH solo acepta claves, no contraseñas. Establece una contraseña para entrar con ella."
