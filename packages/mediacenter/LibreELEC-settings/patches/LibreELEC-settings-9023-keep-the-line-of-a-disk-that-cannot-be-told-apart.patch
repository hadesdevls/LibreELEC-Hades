diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 83cc5a4..6810e77 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -1651,7 +1651,7 @@ MaxRetentionSec=0
             xbmcDialog.ok(title, oe._(33160))
             return
         head = {}
-        here, hidden, gone, fixed, stayed = [], [], [], [], []
+        here, hidden, gone, fixed, twins, stayed = [], [], [], [], [], []
         for line in lines:
             word, _, rest = line.partition(' ')
             if word in ('start', 'list', 'others', 'this'):
@@ -1662,6 +1662,8 @@ MaxRetentionSec=0
                 hidden.append(self.disk_fields(line))
             elif word == 'gone':
                 gone.append(self.disk_fields(line))
+            elif word == 'twin':
+                twins.append(self.disk_fields(line))
             elif word == 'fixed':
                 fixed.append(self.disk_fields(line))
             elif word == 'stayed':
@@ -1716,6 +1718,11 @@ MaxRetentionSec=0
         for i, d in enumerate(known):
             lines.append(f"{'shown' if len(told) + i + 1 in chosen else 'hidden'} kind={d.get('kind', '')} "
                          f"model={d.get('model', '')} serial={d.get('serial', '')} desc={d.get('desc', '')}")
+        # (the lines whose disk cannot be told apart in this start stay as the list has them: whatever they
+        # say, such a disk is kept away while a list exists, and the line holds again where it can be told)
+        for d in twins:
+            lines.append(f"{'shown' if d.get(1) == 'shown' else 'hidden'} kind={d.get('kind', '')} "
+                         f"model={d.get('model', '')} serial={d.get('serial', '')} desc={d.get('desc', '')}")
         keeps = 0 not in chosen or any(line.startswith('hidden ') for line in lines)
         # keeping disks away for the first time: what that means, to be read at the reader's pace; then the
         # question, with "no" preselected
