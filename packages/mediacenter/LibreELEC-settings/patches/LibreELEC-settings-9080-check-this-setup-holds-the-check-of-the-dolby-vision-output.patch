From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:17:59 +0000
Subject: [PATCH] check this setup: it holds the check of the Dolby Vision
 output; submit log: the diagnostics of Hades first

"Check the Dolby Vision output" measures whether the graphics card sends
Dolby Vision unchanged: a check of the setup, like the test clips of
"Check this setup", but it sat in "Submit Log", between the logs and the
switch of the diagnostics. It goes to "Check this setup", after its two
buttons. The category is hidden only where neither can run: on a system
without the clips of the check (they are made for x86_64 only), its two
buttons go and the check of the output stays where it can run.

In "Submit Log" the diagnostics of Hades come first, in the order in which
they are used: a report made now, the switch that saves the diagnostics at
every start, and their copy to a USB drive; then LibreELEC's two logs.

Only the place and the order change: the ids of the settings, their
actions, their texts and what they keep are as before.
---
 resources/lib/modules/system.py | 45 ++++++++++++++++++++++++-----------------
 1 file changed, 27 insertions(+), 18 deletions(-)

diff --git a/resources/lib/modules/system.py b/resources/lib/modules/system.py
index 3e2b1cd..be04859 100644
--- a/resources/lib/modules/system.py
+++ b/resources/lib/modules/system.py
@@ -196,7 +196,8 @@ class system(modules.Module):
         self.arrVariants = {}
         self.struct = {
             # Hades: "Check this setup", first: test clips made by the build, what went out and how, and
-            # the sound formats that were heard switched on (hades_check.py, hades_check_ui.py)
+            # the sound formats that were heard switched on (hades_check.py, hades_check_ui.py); and the check of
+            # the Dolby Vision output, which is a check of the setup too (it was in "Submit Log" up to 1.1)
             'check': {
                 'order': 0,
                 'name': 33640,
@@ -217,6 +218,15 @@ class system(modules.Module):
                         'InfoText': 33644,
                         'order': 2,
                         },
+                    # Hades: whether the graphics card sends Dolby Vision unchanged (do_output_check)
+                    'output_check': {
+                        'name': 33400,
+                        'value': '0',
+                        'action': 'do_output_check',
+                        'type': 'button',
+                        'InfoText': 33401,
+                        'order': 3,
+                        },
                     },
                 },
             'ident': {
@@ -393,7 +403,7 @@ class system(modules.Module):
                         'action': 'do_send_system_logs',
                         'type': 'button',
                         'InfoText': 32939,
-                        'order': 1,
+                        'order': 3,
                         },
                     'paste_crash': {
                         'name': 32938,
@@ -401,7 +411,7 @@ class system(modules.Module):
                         'action': 'do_send_crash_logs',
                         'type': 'button',
                         'InfoText': 32940,
-                        'order': 2,
+                        'order': 4,
                         },
                     # Hades: what the diagnostics saved, copied to a USB drive (do_copy_diagnostics)
                     'diag_usb': {
@@ -410,7 +420,7 @@ class system(modules.Module):
                         'action': 'do_copy_diagnostics',
                         'type': 'button',
                         'InfoText': 33101,
-                        'order': 3,
+                        'order': 2,
                         },
                     # Hades: the switch of the diagnostics of each start (set_diag_switch). The value is read
                     # from the boot partition each time the list is shown (load_diag_switch)
@@ -420,16 +430,7 @@ class system(modules.Module):
                         'action': 'set_diag_switch',
                         'type': 'bool',
                         'InfoText': 33631,
-                        'order': 5,
-                        },
-                    # Hades: whether the graphics card sends Dolby Vision unchanged (do_output_check)
-                    'output_check': {
-                        'name': 33400,
-                        'value': '0',
-                        'action': 'do_output_check',
-                        'type': 'button',
-                        'InfoText': 33401,
-                        'order': 4,
+                        'order': 1,
                         },
                     },
                 },
@@ -1583,7 +1584,7 @@ class system(modules.Module):
 
     @log.log_function()
     def load_output_check(self):
-        setting = self.struct['debug']['settings']['output_check']
+        setting = self.struct['check']['settings']['output_check']
         if not self.OUTPUT_CHECK or not os.path.exists(self.OUTPUT_CHECK):
             # a system without it
             setting['hidden'] = 'true'
@@ -1654,12 +1655,20 @@ class system(modules.Module):
     @log.log_function()
     def load_check(self):
         category = self.struct['check']
+        setup = category['settings']['check_setup']
+        last = category['settings']['check_last']
         if not self.CHECK_CLIPS or not os.path.isdir(self.CHECK_CLIPS):
-            # a system without the clips
-            category['hidden'] = 'true'
+            # a system without the clips: the category only for the check of the Dolby Vision output, where it can run
+            # (load_output_check() comes first)
+            setup['hidden'] = 'true'
+            last['hidden'] = 'true'
+            if category['settings']['output_check'].get('hidden') == 'true':
+                category['hidden'] = 'true'
+            else:
+                category.pop('hidden', None)
             return
         category.pop('hidden', None)
-        last = self.struct['check']['settings']['check_last']
+        setup.pop('hidden', None)
         if self.CHECK_STATE and os.path.exists(os.path.join(self.CHECK_STATE, 'last.json')):
             last.pop('hidden', None)
         else:
