         were every step seconds while it played. tick(seconds, values) may stop it by returning False.
-        Stops it when Back left the picture, and in any case some seconds after it should have ended.'''
+        A picture (not windowed) counts from when it came up over the whole screen, which Kodi does once
+        the streams of the clip are ready, after its change of mode and of the HDR signal: it is stopped
+        when Back left the picture, or when it had not come up hc.SHOW_LIMIT seconds after it started to
+        play. Any clip is stopped some seconds after it should have ended. Why it stopped, and when it
+        came up, are in self.last_clip (hc.clip_fact()) and in kodi.log.'''
         snapshots = []
+        self.last_clip = clip = {'stop': 'not-started', 'shown': None, 'played': 0.0}
+        name = os.path.basename(path)
         self.home.setProperty(hc.CHECK_PROPERTY, '1')
         try:
             self.player.play(path, windowed=windowed)
@@ -127,24 +135,43 @@ class CheckSetup:
                     log.log(f'check: {path} did not start', log.WARNING)
                     return snapshots
             began = time.monotonic()
+            # (when the picture came up over the whole screen; a clip in a window counts from its start)
+            shown = began if windowed else None
+            clip['stop'] = 'end'
             while self.player.isPlaying():
                 if self.monitor.waitForAbort(step):
                     raise Abort()
                 values = hc.read_info(self.home.getProperty, keys)
                 values['decoder'] = xbmc.getInfoLabel('Player.Process(audiodecoder)')
+                now = time.monotonic()
+                full = not windowed and xbmc.getCondVisibility('Window.IsActive(fullscreenvideo)')
+                if shown is None and full:
+                    shown = now
+                    clip['shown'] = now - began
                 try:
                     values['time'] = self.player.getTime()
                 except RuntimeError:
-                    values['time'] = time.monotonic() - began
+                    values['time'] = now - (shown if shown is not None else began)
                 snapshots.append(values)
-                elapsed = time.monotonic() - began
+                clip['played'] = now - began
                 if tick is not None and tick(values['time'], values) is False:
+                    clip['stop'] = 'check'
                     break
-                # (Back takes the user out of the picture while it goes on playing behind the menu)
-                if not windowed and elapsed > 2 and not xbmc.getCondVisibility('Window.IsActive(fullscreenvideo)'):
+                if shown is None:
+                    if now - began > hc.SHOW_LIMIT:
+                        clip['stop'] = 'not-shown'
+                        break
+                    continue
+                # (Back takes the user out of the picture while it goes on playing behind the menu; at
+                # its end, Kodi closes the full screen as the player stops)
+                if not windowed and not full:
+                    if self.player.isPlaying():
+                        clip['stop'] = 'back'
                     break
-                if elapsed > seconds + 10:
+                if now - shown > seconds + 10:
+                    clip['stop'] = 'limit'
                     break
+            log.log(f'check: {name}: {hc.clip_fact(clip)}', log.INFO)
         finally:
             if self.player.isPlaying():
                 self.player.stop()
@@ -166,9 +193,10 @@ class CheckSetup:
             return
         while True:
             snapshots = self.play(path, hc.PICTURE_KEYS, float(clip.get('duration', 15)))
