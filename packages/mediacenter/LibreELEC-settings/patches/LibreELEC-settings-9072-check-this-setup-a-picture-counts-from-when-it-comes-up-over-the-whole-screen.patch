             'hades.out.depth', 'hades.out.depthkind', 'hades.out.linkformat', 'hades.dv.state',
@@ -551,9 +561,24 @@ def picture_facts(fmt, info, answer, dark=None, light=None):
         parts.append(f'dark_squares={dark}')
     if light is not None:
         parts.append(f'light_squares={light}')
+    if clip:
+        parts.append(clip_fact(clip))
     return f'picture {fmt}: ' + ' '.join(parts)
 
 
+def clip_fact(clip):
+    '''How a clip played, for the summary file: clip_stop= why it stopped (end: the player stopped,
+    at the end of the clip or with Stop; back: the picture was left with Back; not-shown: it had not
+    come up over the whole screen after SHOW_LIMIT seconds; limit: it went on playing 10 seconds past
+    its length; check: the check stopped it; not-started: it did not start), clip_shown= the seconds
+    from the start of playing to the whole screen (none: it never came up; a clip played in a window
+    has none), clip_played= the seconds it played.'''
+    shown = clip.get('shown')
+    return (f"clip_stop={clip.get('stop', 'unknown')} "
+            f"clip_shown={'none' if shown is None else format(shown, '.1f') + 's'} "
+            f"clip_played={clip.get('played', 0.0):.1f}s")
+
+
 # ---- the walk round the speakers: what it says
 
 # the names of the speakers (strings of this add-on), by the channel names of FFmpeg
