+        lines = hc.picture_lines(fmt, info, answer, dark, light, shown)
+        self.record(title, lines, hc.picture_facts(fmt, info, answer, dark, light, played))
         self.dialog.textviewer(title, self.say(lines))
 
     # ---- the speakers
