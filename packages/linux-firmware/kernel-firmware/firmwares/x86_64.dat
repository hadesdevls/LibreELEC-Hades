ath10k/*
ath11k/*
ath12k/WCN7850/*
ctefx.bin
lbtf_usb.bin
mrvl/sd8897_uapsta.bin
# Hades: btusb loads the RAM patch and the NVM of a Qualcomm controller by the ROM version in its
# table (qca_devices_table): here those of linux-firmware for Rome 2.0, 2.1 and 3.0 beside 3.2,
# WCN6855 2.0 and 2.1 (QCNFA765, FastConnect 6900) and WCN785x 2.0 (QCNCM865, FastConnect 7800).
# The NVM of a controller that tells its board is nvm_usb_<rom>[_gf]_<board>.bin, with no fall back
# to the plain one: all of them come.
qca/*00000200.bin
qca/*00000201.bin
qca/*00000300.bin
qca/*00000302.bin
qca/*00130200*.bin
qca/*00130201*.bin
qca/*00190200*.bin
qca/QCA2066/*
mediatek/*MT7961*.bin
mediatek/*MT7922*.bin
# Hades: MT7902, Wi-Fi (mt7921e, mt7921u) and Bluetooth (btusb, btmtksdio)
mediatek/*MT7902*.bin
mediatek/mt7925/*.bin
mediatek/mt7927/*.bin
# Hades: the other MediaTek parts whose drivers the kernel builds: mt7915e (MT7915, MT7916; with
# the default EEPROM of a card whose efuse is empty), mt7615e (MT7615, MT7663), mt7663u, the
# Bluetooth of MT7663 and MT7668 (btusb, btmtksdio), and mt76x0u, which loads mt7610e.bin when it
# is there and mt7610u.bin when it is not
mediatek/mt7610e.bin
mediatek/mt7615_*.bin
mediatek/mt7663*.bin
mediatek/mt7668pr2h.bin
mediatek/mt7915_*.bin
mediatek/mt7916_*.bin
rt2561.bin
rt2561s.bin
rt2661.bin
rt2860.bin
rt3290.bin
# Hades: GuC, HuC, GSC and fan control of the xe driver (Lunar Lake, Battlemage, Panther Lake,
# Nova Lake S), which is a module and loads them from the system; xe does not bring a GPU up
# without its GuC. The firmware of i915 and the DMC of the displays of both drivers (i915/) are
# built into the kernel (packages/linux).
xe/*
ar3k/*.dfu
intel/dsp_fw_{bxtn,cnl,glk,kbl,release}.bin
intel/fw_sst_*.bin*
intel/ibt-*.{ddc,sfi,bseq}
intel/IntcSST2.bin
