#
# Let the SuperSpeed side of an external USB hub sleep while nothing is
# connected to it, as it does in Windows and in other Linux systems.
#
# The kernel command line of LibreELEC (usbcore.autosuspend=-1) keeps every
# USB device awake, so the SuperSpeed link of a hub stays up (and keeps
# giving off radio noise around 2.4 GHz, the band of the wireless mouse and
# keyboard receivers) even when no USB 3 device is on that hub. A hub only
# suspends when everything below it is suspended or absent, and wakes by
# itself when a device is plugged into it; a USB 2.0 side, a root hub (kernel
# name usbN) and every device that is not a hub are left as they were.
#
# To keep the hubs awake as before, put an empty file of this name in
# /storage/.config/udev.rules.d/ (the system reads that folder first).

ACTION!="add", GOTO="hades_usb3_hub_end"
SUBSYSTEM!="usb", GOTO="hades_usb3_hub_end"
ENV{DEVTYPE}!="usb_device", GOTO="hades_usb3_hub_end"
KERNEL=="usb[0-9]*", GOTO="hades_usb3_hub_end"
ATTR{bDeviceClass}!="09", GOTO="hades_usb3_hub_end"
ATTR{speed}!="5000|10000|20000", GOTO="hades_usb3_hub_end"

ATTR{power/autosuspend_delay_ms}="2000"

LABEL="hades_usb3_hub_end"
