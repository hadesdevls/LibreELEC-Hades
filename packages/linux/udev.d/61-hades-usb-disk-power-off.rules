#
# Stop a disk on USB when the system powers off, as the kernel already does by
# itself for a SATA disk.
#
# At power-off the kernel flushes the write cache of every disk, but it stops
# (spins down, heads parked) only the disks it is told to manage, and nothing
# tells it to for a disk behind a USB bridge: a hard disk in a USB enclosure
# then loses its power while it spins, and retracts its heads in an emergency
# (a count the disk keeps). manage_shutdown asks the kernel to stop the disk at
# power-off only: not at a restart, not when the system sleeps, and nothing
# changes while the system runs.
#
# A drive that says its medium is removable (a card reader, most USB sticks)
# is left as it was.
#
# To leave every USB disk as before, put an empty file of this name in
# /storage/.config/udev.rules.d/ (the system reads that folder first).

ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd*", SUBSYSTEMS=="usb", ATTR{removable}=="0", RUN+="/bin/sh -c 'for f in /sys%p/device/scsi_disk/*/manage_shutdown; do [ -w $$f ] && echo 1 > $$f; done'"
