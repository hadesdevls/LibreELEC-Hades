From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Baolin Liu <liubaolin@kylinos.cn>
Date: Wed, 23 Sep 2026 14:02:41 +0800
Subject: [PATCH] ntfs: distinguish empty EA values from removal

commit 6fba59ab89a7b0313144dbff78ed23a93cd8c7db upstream.

The EA setter identifies removal using a zero value length together with
XATTR_REPLACE. A replacement with a valid empty value is therefore
mistaken for deletion.

Use a NULL value to identify removal and keep zero-length values valid.
Reject removal or XATTR_REPLACE for an absent entry before creating
metadata, including when the file has no EA attributes.

Signed-off-by: Baolin Liu <liubaolin@kylinos.cn>
Reviewed-by: Hyunchul Lee <hyc.lee@gmail.com>
Signed-off-by: Namjae Jeon <linkinjeon@kernel.org>

[Hades: backported to 7.3.4, whose ntfs_attr_remove() takes four
 arguments; the fifth one of mainline (struct inode **, NULL here) came
 with the named-stream support (3f11c48d4f94), which Hades does not
 take. Only a context line differs; the change is the same.]
---
 fs/ntfs/ea.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/fs/ntfs/ea.c b/fs/ntfs/ea.c
index 940910c43fe5..f60947c076d1 100644
--- a/fs/ntfs/ea.c
+++ b/fs/ntfs/ea.c
@@ -244,6 +244,8 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 	if (!err != !ea_err)
 		return -EUCLEAN;
 	has_ea = !err;
+	if (!has_ea && (!value || (flags & XATTR_REPLACE)))
+		return -ENODATA;
 	if (has_ea) {
 		p_ea_info = ntfs_attr_readall(ni, AT_EA_INFORMATION, NULL, 0,
 						&ea_info_size);
@@ -307,7 +309,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 			err = -EEXIST;
 			goto out;
 		}
-		if ((flags & XATTR_REPLACE) && !val_size) {
+		if (!value) {
 			old_ea_info = *p_ea_info;
 			old_ea_buf = kvmemdup(ea_buf, all_ea_size, GFP_NOFS);
 			if (!old_ea_buf) {
@@ -317,7 +319,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 		}
 
 		/* Check the final $EA size before removing the old entry. */
-		if (val_size &&
+		if (value &&
 		    ntfs_attr_size_bounds_check(ni->vol, AT_EA,
 					ea_info_qsize - ea_size + new_ea_size)) {
 			err = -EFBIG;
@@ -326,7 +328,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 
 		p_ea = (struct ea_attr *)(ea_buf + ea_off);
 
-		if (val_size &&
+		if (value &&
 		    le16_to_cpu(p_ea->ea_value_length) == val_size &&
 		    !memcmp(p_ea->ea_name + p_ea->ea_name_length + 1, value,
 			    val_size))
@@ -341,7 +343,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 		ea_info_qsize -= ea_size;
 		p_ea_info->ea_query_length = cpu_to_le32(ea_info_qsize);
 
-		if ((flags & XATTR_REPLACE) && !val_size && !ea_info_qsize) {
+		if (!value && !ea_info_qsize) {
 			err = ntfs_attr_remove(ni, AT_EA, AT_UNNAMED, 0);
 			if (err)
 				goto out;
@@ -356,7 +358,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 			goto out;
 		}
 
-		if ((flags & XATTR_REPLACE) && !val_size) {
+		if (!value) {
 			err = ntfs_write_ea(ni, AT_EA, ea_buf, 0, ea_info_qsize,
 					true);
 			if (err) {
@@ -377,7 +379,7 @@ static int ntfs_set_ea(struct inode *inode, const char *name, size_t name_len,
 			goto out;
 		}
 	} else {
-		if (flags & XATTR_REPLACE) {
+		if (!value || (flags & XATTR_REPLACE)) {
 			err = -ENODATA;
 			goto out;
 		}
