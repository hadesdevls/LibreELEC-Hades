From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:16:56 +0000
Subject: [PATCH] efi, lockdown: the kernel locks itself down when it starts
 with Secure Boot

LibreELEC Hades can start with UEFI Secure Boot: shim of Debian 13, then GRUB and this
kernel, both signed with a key of the computer. GRUB does not check its configuration, so
whoever can write grub.cfg can take lockdown=integrity off the command line, and an
unsigned module, /dev/mem or an ACPI table could then change the running kernel: the
signed kernel would be a way around Secure Boot.

With CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT the kernel locks itself down to integrity when the
boot parameters say that Secure Boot is on, whatever the command line says. The EFI stub
fills that in (efi_get_secureboot(), which takes shim's MokSBState into account), and so
does GRUB's own Linux loader (grub_efi_get_secureboot()). It is done where setup_arch()
reads that value, before the ACPI tables are taken; the previous patch makes the lockdown
count there already. Debian and Fedora carry a patch with the same purpose ("efi: Lock
down the kernel if booted in secure boot mode").

Without Secure Boot nothing changes: the kernel locks itself down only when its command
line asks for it, as before.
---
 arch/x86/kernel/setup.c      |  5 +++++
 include/linux/security.h     |  3 +++
 security/lockdown/Kconfig    | 11 +++++++++++
 security/lockdown/lockdown.c |  9 +++++++++
 4 files changed, 28 insertions(+)

diff --git a/arch/x86/kernel/setup.c b/arch/x86/kernel/setup.c
index cda6adb..72bda84 100644
--- a/arch/x86/kernel/setup.c
+++ b/arch/x86/kernel/setup.c
@@ -23,6 +23,7 @@
 #include <linux/pci.h>
 #include <linux/random.h>
 #include <linux/root_dev.h>
+#include <linux/security.h>
 #include <linux/static_call.h>
 #include <linux/sysfb.h>
 #include <linux/swiotlb.h>
@@ -1175,6 +1176,10 @@ void __init setup_arch(char **cmdline_p)
 			break;
 		case efi_secureboot_mode_enabled:
 			pr_info("Secure boot enabled\n");
+#ifdef CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT
+			/* Hades: whatever the command line says */
+			lockdown_efi_secure_boot();
+#endif
 			break;
 		default:
 			pr_info("Secure boot could not be determined\n");
diff --git a/include/linux/security.h b/include/linux/security.h
index 8a43df3..16979f8 100644
--- a/include/linux/security.h
+++ b/include/linux/security.h
@@ -585,6 +585,9 @@ int security_locked_down(enum lockdown_reason what);
 #ifdef CONFIG_SECURITY_LOCKDOWN_LSM
 int lockdown_locked_down_early(enum lockdown_reason what);
 #endif
+#ifdef CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT
+void lockdown_efi_secure_boot(void);
+#endif
 int lsm_fill_user_ctx(struct lsm_ctx __user *uctx, u32 *uctx_len,
 		      void *val, size_t val_len, u64 id, u64 flags);
 int security_bdev_alloc(struct block_device *bdev);
diff --git a/security/lockdown/Kconfig b/security/lockdown/Kconfig
index e84ddf4..6a135f8 100644
--- a/security/lockdown/Kconfig
+++ b/security/lockdown/Kconfig
@@ -16,6 +16,17 @@ config SECURITY_LOCKDOWN_LSM_EARLY
 	  subsystem is fully initialised. If enabled, lockdown will
 	  unconditionally be called before any other LSMs.
 
+config LOCK_DOWN_IN_EFI_SECURE_BOOT
+	bool "Lock down the kernel when it starts with UEFI Secure Boot"
+	depends on EFI && X86 && SECURITY_LOCKDOWN_LSM_EARLY
+	help
+	  When the kernel starts under UEFI Secure Boot, as the EFI stub or
+	  the boot loader says in the boot parameters, it locks itself down
+	  to integrity, whatever its command line says: a boot loader reads
+	  the command line without checking it, so lockdown= on it cannot be
+	  what keeps unsigned code out of the kernel. Only signed modules
+	  load then. Debian and Fedora carry a patch with the same purpose.
+
 choice
 	prompt "Kernel default lockdown mode"
 	default LOCK_DOWN_KERNEL_FORCE_NONE
diff --git a/security/lockdown/lockdown.c b/security/lockdown/lockdown.c
index 2e3fe99..0c46ea9 100644
--- a/security/lockdown/lockdown.c
+++ b/security/lockdown/lockdown.c
@@ -37,6 +37,15 @@ static int lock_kernel_down(const char *where, enum lockdown_reason level)
 	return 0;
 }
 
+#ifdef CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT
+/* Hades: the kernel started with UEFI Secure Boot (arch/x86/kernel/setup.c) */
+void __init lockdown_efi_secure_boot(void)
+{
+	if (lock_kernel_down("EFI Secure Boot mode", LOCKDOWN_INTEGRITY_MAX))
+		pr_notice("Kernel is locked down already, at least to integrity: EFI Secure Boot mode keeps it so\n");
+}
+#endif
+
 static int __init lockdown_param(char *level)
 {
 	if (!level)
-- 
2.53.0

