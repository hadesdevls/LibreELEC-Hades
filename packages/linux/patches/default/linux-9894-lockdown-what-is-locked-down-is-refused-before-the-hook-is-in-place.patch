From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:16:55 +0000
Subject: [PATCH] lockdown: what is locked down is refused before the hook is
 in place

Since 6.12, early_security_init() runs after setup_arch() (77b644c39d6a, "init/main.c:
Initialize early LSMs after arch code, static keys and calls"). On x86, setup_arch() asks
security_locked_down() before the lockdown module has added its hook, and the answer was
"not locked down":

  - acpi_table_upgrade() takes ACPI tables from an initrd. A boot loader loads an initrd
    without checking it, and an ACPI table can write any memory, the kernel's too;
  - acpi_boot_table_init() takes the RSDP that acpi_rsdp= names.

Both went through under lockdown=integrity on the command line, and would under Secure
Boot (the next patch). The lockdown level itself was already set by then: lockdown= is an
early parameter, parsed in setup_arch().

Until the hook is in place, security_locked_down() now asks the lockdown module directly,
which answers as the hook does and says so in the kernel log. Once the hook is in place the
path is the one of before.
---
 include/linux/security.h     |  3 +++
 security/lockdown/lockdown.c | 26 ++++++++++++++++++++++++++
 security/security.c          |  7 +++++++
 3 files changed, 36 insertions(+)

diff --git a/include/linux/security.h b/include/linux/security.h
index 153e904..8a43df3 100644
--- a/include/linux/security.h
+++ b/include/linux/security.h
@@ -582,6 +582,9 @@ int security_inode_notifysecctx(struct inode *inode, void *ctx, u32 ctxlen);
 int security_inode_setsecctx(struct dentry *dentry, void *ctx, u32 ctxlen);
 int security_inode_getsecctx(struct inode *inode, struct lsm_context *cp);
 int security_locked_down(enum lockdown_reason what);
+#ifdef CONFIG_SECURITY_LOCKDOWN_LSM
+int lockdown_locked_down_early(enum lockdown_reason what);
+#endif
 int lsm_fill_user_ctx(struct lsm_ctx __user *uctx, u32 *uctx_len,
 		      void *val, size_t val_len, u64 id, u64 flags);
 int security_bdev_alloc(struct block_device *bdev);
diff --git a/security/lockdown/lockdown.c b/security/lockdown/lockdown.c
index 8d46886..2e3fe99 100644
--- a/security/lockdown/lockdown.c
+++ b/security/lockdown/lockdown.c
@@ -16,6 +16,8 @@
 #include <uapi/linux/lsm.h>
 
 static enum lockdown_reason kernel_locked_down;
+/* Hades: whether the hook below is in place yet (lockdown_locked_down_early()) */
+static bool lockdown_hooks_added __ro_after_init;
 
 static const enum lockdown_reason lockdown_levels[] = {LOCKDOWN_NONE,
 						 LOCKDOWN_INTEGRITY_MAX,
@@ -72,6 +74,29 @@ static int lockdown_is_locked_down(enum lockdown_reason what)
 	return 0;
 }
 
+/*
+ * Hades: early_security_init() runs after setup_arch() since 6.12 (77b644c39d6a, "init/main.c: Initialize early
+ * LSMs after arch code, static keys and calls"). On x86 the hook of this module is not in place yet when
+ * setup_arch() asks whether something is locked down, and security_locked_down() said no: to acpi_table_upgrade(),
+ * which takes ACPI tables from an initrd (one that a boot loader loads without checking it), and to the RSDP of
+ * acpi_rsdp= (acpi_os_get_root_pointer(), from acpi_boot_table_init()). Both went through under lockdown=integrity,
+ * and would under Secure Boot. Until the hook is in place, security_locked_down() asks this, which answers as the
+ * hook does.
+ */
+int lockdown_locked_down_early(enum lockdown_reason what)
+{
+	if (lockdown_hooks_added || what >= LOCKDOWN_CONFIDENTIALITY_MAX)
+		return 0;
+
+	if (kernel_locked_down >= what) {
+		pr_notice("Lockdown: %s is restricted early in the start; see man kernel_lockdown.7\n",
+			  lockdown_reasons[what] ? lockdown_reasons[what] : "this");
+		return -EPERM;
+	}
+
+	return 0;
+}
+
 static struct security_hook_list lockdown_hooks[] __ro_after_init = {
 	LSM_HOOK_INIT(locked_down, lockdown_is_locked_down),
 };
@@ -90,6 +115,7 @@ static int __init lockdown_lsm_init(void)
 #endif
 	security_add_hooks(lockdown_hooks, ARRAY_SIZE(lockdown_hooks),
 			   &lockdown_lsmid);
+	lockdown_hooks_added = true;
 	return 0;
 }
 
diff --git a/security/security.c b/security/security.c
index 2ee276a..5fb33f9 100644
--- a/security/security.c
+++ b/security/security.c
@@ -5491,6 +5491,13 @@ void security_bpf_token_free(struct bpf_token *token)
  */
 int security_locked_down(enum lockdown_reason what)
 {
+#ifdef CONFIG_SECURITY_LOCKDOWN_LSM
+	/* Hades: before the hook of the lockdown module is in place (lockdown_locked_down_early()) */
+	int rc = lockdown_locked_down_early(what);
+
+	if (rc)
+		return rc;
+#endif
 	return call_int_hook(locked_down, what);
 }
 EXPORT_SYMBOL(security_locked_down);
-- 
2.53.0

