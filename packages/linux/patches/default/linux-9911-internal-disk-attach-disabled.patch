From 14bb10d823c39e47e41d19c0c5358e7aaa38e138 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 11 Oct 2026 09:11:44 +0000
Subject: [PATCH] block, nvme, ata: a switch that keeps new internal disks from
 being attached

A system that is installed on an internal disk of a PC, and that must
not reach the other disks of that PC, can detach them when it starts:
unbind the NVMe controllers and delete the SCSI devices of the ATA
disks that are not its own. That does not hold. Whoever is root later
binds the controller again, rescans the PCI bus or asks the SCSI host
for a scan, and the disks are back.

kernel.internal_disk_attach_disabled closes that. Once it is set, the
NVMe driver refuses to take a controller and libata gives no SCSI
device to an ATA device. It can be set and not cleared, as
kernel.modules_disabled. What is attached stays attached; USB storage,
card readers and virtual block devices are not concerned.

The check in libata is before the loop of ata_scsi_scan_host(): after
it, a device without its SCSI device counts as a scan to be tried
again, once a second.

For the Run and Live entries of LibreELEC Hades installed on an
internal disk, whose init sets it and then detaches the other disks,
looking twice. Started from a USB drive those entries keep the two drivers from
starting at all (initcall_blacklist), which on an internal disk would
take the system's own disk away.
---
 block/genhd.c             | 37 +++++++++++++++++++++++++++++++++++++
 drivers/ata/libata-scsi.c |  8 ++++++++
 drivers/nvme/host/pci.c   |  7 +++++++
 include/linux/blkdev.h    |  1 +
 4 files changed, 53 insertions(+)

diff --git a/block/genhd.c b/block/genhd.c
index 10ca8b4..ec2488b 100644
--- a/block/genhd.c
+++ b/block/genhd.c
@@ -26,6 +26,7 @@
 #include <linux/badblocks.h>
 #include <linux/part_stat.h>
 #include <linux/blktrace_api.h>
+#include <linux/sysctl.h>
 
 #include "blk-throttle.h"
 #include "blk.h"
@@ -996,6 +997,41 @@ static const struct seq_operations partitions_op = {
 };
 #endif
 
+/*
+ * kernel.internal_disk_attach_disabled: once it is set, the drivers of the
+ * disks that are part of a computer give the system no disk that it does not
+ * have already. The NVMe driver refuses to take a controller (a rescan of the
+ * PCI bus, a bind through sysfs), and libata gives no SCSI device to an ATA
+ * device (a scan of the host asked for by user space, a hot plug, a port that
+ * is still being probed). What is attached stays, and is detached as always.
+ * USB storage, card readers and virtual block devices are not concerned.
+ *
+ * It can be set and not cleared, like kernel.modules_disabled. It is for a
+ * system that has detached the disks it must not reach and means that to hold
+ * against whoever becomes root later; with the kernel locked down (integrity)
+ * and without the means to load a driver of one's own, they stay out of reach.
+ */
+static int internal_disk_attach_disabled;
+
+bool blk_internal_disk_attach_disabled(void)
+{
+	return READ_ONCE(internal_disk_attach_disabled);
+}
+EXPORT_SYMBOL_GPL(blk_internal_disk_attach_disabled);
+
+static const struct ctl_table disk_attach_sysctl_table[] = {
+	{
+		.procname	= "internal_disk_attach_disabled",
+		.data		= &internal_disk_attach_disabled,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		/* only a transition from "0" to "1" */
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ONE,
+		.extra2		= SYSCTL_ONE,
+	},
+};
+
 static int __init genhd_device_init(void)
 {
 	int error;
@@ -1004,6 +1040,7 @@ static int __init genhd_device_init(void)
 	if (unlikely(error))
 		return error;
 	blk_dev_init();
+	register_sysctl_init("kernel", disk_attach_sysctl_table);
 
 	register_blkdev(BLOCK_EXT_MAJOR, "blkext");
 
diff --git a/drivers/ata/libata-scsi.c b/drivers/ata/libata-scsi.c
index 3559485..6bf0e92 100644
--- a/drivers/ata/libata-scsi.c
+++ b/drivers/ata/libata-scsi.c
@@ -4812,6 +4812,14 @@ void ata_scsi_scan_host(struct ata_port *ap, int sync)
 	struct ata_link *link;
 	struct ata_device *dev;
 
+	/*
+	 * See kernel.internal_disk_attach_disabled in block/genhd.c. Before
+	 * the loop: a device that is left without its SCSI device is not a
+	 * failed scan to be tried again.
+	 */
+	if (blk_internal_disk_attach_disabled())
+		return;
+
  repeat:
 	ata_for_each_link(link, ap, EDGE) {
 		ata_for_each_dev(dev, link, ENABLED) {
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 664a36e..49c74cc 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -3751,6 +3751,13 @@ static int nvme_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	struct nvme_dev *dev;
 	int result = -ENOMEM;
 
+	/* see kernel.internal_disk_attach_disabled in block/genhd.c */
+	if (blk_internal_disk_attach_disabled()) {
+		dev_info(&pdev->dev,
+			 "not attached: kernel.internal_disk_attach_disabled is set\n");
+		return -ENODEV;
+	}
+
 	dev = nvme_pci_alloc_dev(pdev, id);
 	if (IS_ERR(dev))
 		return PTR_ERR(dev);
diff --git a/include/linux/blkdev.h b/include/linux/blkdev.h
index 9213a57..496b435 100644
--- a/include/linux/blkdev.h
+++ b/include/linux/blkdev.h
@@ -1796,6 +1796,7 @@ void bd_abort_claiming(struct block_device *bdev, void *holder);
 struct block_device *I_BDEV(struct inode *inode);
 struct block_device *file_bdev(struct file *bdev_file);
 bool disk_live(struct gendisk *disk);
+bool blk_internal_disk_attach_disabled(void);
 unsigned int block_size(struct block_device *bdev);
 
 #ifdef CONFIG_BLOCK
