#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: the boot menus of a system that the installer of the image (the boot entry "Installer")
# puts on a disk, made from the menus of the medium it runs from, as the installer for Windows
# makes them from the menus of the image (tools/hades-installer, Engine.ForInternalDisk):
#   - the entries Run and Live keep the other internal disks away with hades.otherdisks=hide where
#     the medium has initcall_blacklist=nvme_init,ahci_pci_driver_init (which, on an internal disk,
#     would take away the disk of the system itself), and keep the kernel locked down
#     (lockdown=integrity): decision 0024;
#   - the entries Installer and "Run (internal disks read-only)" stay as they are;
#   - the default is Run (whatever the medium was last started with, or the setting of the
#     internal disks made the default there);
#   - boot= and disk= name @UUID_SYSTEM@ and @UUID_STORAGE@, which the installer fills in once the
#     file systems are made.
# What comes out is checked; if it is not the menus of Hades that the init and the setting of the
# internal disks know, nothing is printed and the exit status is not 0, so that the installer
# writes nothing.
#
# usage: installer-bootmenus grub|syslinux <menu of the medium>

KIND="$1"
SOURCE="$2"
HIDE_USB="initcall_blacklist=nvme_init,ahci_pci_driver_init"
HIDE_OTHERS="hades.otherdisks=hide"
LOCK="lockdown=integrity"

fail() {
  echo "installer-bootmenus: $*" >&2
  exit 1
}

case "$KIND" in
  grub|syslinux) ;;
  *) fail "usage: installer-bootmenus grub|syslinux <menu>" ;;
esac
[ -f "$SOURCE" ] || fail "$SOURCE: no such file"

OUT=$(awk -v kind="$KIND" -v hide_usb="$HIDE_USB" -v hide_others="$HIDE_OTHERS" -v lock="$LOCK" '
  # the kernel parameters of one entry; hides: an entry that keeps the other internal disks away
  function fix(line, hides,   lead, rest, n, i, w, out, has_hide, has_lock) {
    match(line, /^[ \t]*/)
    lead = substr(line, 1, RLENGTH)
    rest = substr(line, RLENGTH + 1)
    n = split(rest, w, " ")
    out = ""
    has_hide = 0
    has_lock = 0
    for (i = 1; i <= n; i++) {
      if (w[i] ~ /^boot=UUID=/) w[i] = "boot=UUID=@UUID_SYSTEM@"
      else if (w[i] ~ /^disk=UUID=/) w[i] = "disk=UUID=@UUID_STORAGE@"
      if (hides) {
        if (w[i] == hide_usb || w[i] == hide_others) {
          if (has_hide) continue
          w[i] = hide_others
          has_hide = 1
        } else if (w[i] ~ /^lockdown=/) {
          has_lock = 1
        }
      }
      out = out (out == "" ? "" : " ") w[i]
    }
    if (hides && !has_hide) out = out " " hide_others
    if (hides && !has_lock) out = out " " lock
    return lead out
  }
  kind == "grub" && /^menuentry "/ {
    e = $0
    sub(/^menuentry "/, "", e)
    sub(/".*/, "", e)
  }
  kind == "grub" && /^set default=/ { print "set default=\"Run\""; next }
  kind == "grub" && /^[ \t]*linux[ \t]/ { print fix($0, e == "Run" || e == "Live"); next }
  kind == "syslinux" && /^LABEL[ \t]/ { e = $2 }
  kind == "syslinux" && /^DEFAULT[ \t]/ { print "DEFAULT run"; next }
  kind == "syslinux" && /^SAY Wait for .* mode/ { sub(/Wait for .* mode/, "Wait for run mode") }
  kind == "syslinux" && /^[ \t]*APPEND[ \t]/ { print fix($0, e == "run" || e == "live"); next }
  { print }
' "$SOURCE") || fail "$SOURCE could not be read"

# The checks: the first line of the menus of Hades, the four entries, the default, and the
# parameters of each entry.
check() {
  printf '%s\n' "$OUT" | grep -q -E "$1" || fail "$SOURCE: $2"
}
count() {
  printf '%s\n' "$OUT" | grep -c -F -e "$1"
}

printf '%s\n' "$OUT" | head -n 1 | grep -q -E '^# hades-features:.* other-disks-hidden( |$)' ||
  fail "$SOURCE: not the boot menu of LibreELEC Hades (its first line does not say other-disks-hidden)"
if [ "$KIND" = grub ]; then
  for e in 'Installer' 'Live' 'Run' 'Run \(internal disks read-only\)'; do
    check "^menuentry \"$e\" " "no entry \"$e\""
  done
  check '^set default="Run"$' "no default"
  KERNEL_LINES=$(printf '%s\n' "$OUT" | grep -c -E '^[[:space:]]*linux[[:space:]]')
else
  for e in installer live run internal; do
    check "^LABEL $e\$" "no entry $e"
  done
  check '^DEFAULT run$' "no default"
  KERNEL_LINES=$(printf '%s\n' "$OUT" | grep -c -E '^[[:space:]]*APPEND[[:space:]]')
fi
[ "$KERNEL_LINES" = 4 ] || fail "$SOURCE: $KERNEL_LINES entries with kernel parameters, 4 expected"
[ "$(count "boot=UUID=@UUID_SYSTEM@")" = 4 ] || fail "$SOURCE: an entry does not name the system partition"
[ "$(count "disk=UUID=@UUID_STORAGE@")" = 2 ] || fail "$SOURCE: the entries Run and Run with the internal disks must name the storage"
[ "$(count "$HIDE_USB")" = 0 ] || fail "$SOURCE: an entry would hide the disk of the system itself"
[ "$(count " $HIDE_OTHERS")" = 2 ] || fail "$SOURCE: Run and Live do not both keep the other internal disks away"
[ "$(count " $LOCK")" -ge 2 ] || fail "$SOURCE: Run and Live do not both lock the kernel down"

printf '%s\n' "$OUT"
