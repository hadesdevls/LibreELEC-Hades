From ddfa2189ead17e1704d9062f62f62f9f2e3bda06 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:00:00 +0000
Subject: [PATCH] gfxterm: tell the mode it runs in

A theme of gfxmenu is laid out in pixels, so a config that has one
theme for each size of screen has to know the mode that the terminal
got. gfxterm asks for the modes of gfxmode and then for "auto", which on
EFI keeps the mode the firmware is in: taking the terminal succeeds
whether or not a mode of the list was there, and nothing says which.

Put the mode, as WIDTHxHEIGHT, in the variable gfxterm_mode once the
terminal is set up, and unset it when the mode cannot be read. Nothing
else changes: the mode is chosen as before, and nothing reads the
variable but a config that asks for it.

LibreELEC Hades reads it to pick the theme of its boot menu, and keeps
the text menu where the mode is none of those it has a theme for.
---
 grub-core/term/gfxterm.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/grub-core/term/gfxterm.c b/grub-core/term/gfxterm.c
index 3c468f4..7fec1b0 100644
--- a/grub-core/term/gfxterm.c
+++ b/grub-core/term/gfxterm.c
@@ -374,6 +374,26 @@ grub_gfxterm_fullscreen (void)
 				  font, DEFAULT_BORDER_WIDTH);
 }
 
+/* The mode that gfxterm runs in, as WIDTHxHEIGHT in the variable gfxterm_mode. gfxterm asks for
+   the modes of gfxmode and then for "auto", which keeps the mode of the firmware, so taking the
+   terminal does not tell which mode was given: a config that draws for one size of screen reads it
+   here.  */
+static void
+export_mode (void)
+{
+  struct grub_video_mode_info mode_info;
+  char buf[32];
+
+  if (grub_video_get_info (&mode_info) != GRUB_ERR_NONE)
+    {
+      grub_errno = GRUB_ERR_NONE;
+      grub_env_unset ("gfxterm_mode");
+      return;
+    }
+  grub_snprintf (buf, sizeof (buf), "%ux%u", mode_info.width, mode_info.height);
+  grub_env_set ("gfxterm_mode", buf);
+}
+
 static grub_err_t
 grub_gfxterm_term_init (struct grub_term_output *term __attribute__ ((unused)))
 {
@@ -401,6 +421,8 @@ grub_gfxterm_term_init (struct grub_term_output *term __attribute__ ((unused)))
   err = grub_gfxterm_fullscreen ();
   if (err)
     grub_video_restore ();
+  else
+    export_mode ();
 
   return err;
 }
