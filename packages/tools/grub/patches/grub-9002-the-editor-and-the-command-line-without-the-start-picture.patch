From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 27 Nov 2026 06:44:55 +0000
Subject: [PATCH] normal/menu: the editor and the command line without the
 start picture

A config that gives the terminal the picture of the start as its
background (background_image) for a quiet start (grub-9001) makes the
whole screen the terminal and that picture its background, so that the
screen goes from the menu to the picture at once when an entry starts.
The editor of an entry ("e") and the command line ("c") write their text
on the same terminal: over that picture, where light parts of it run
through the letters and the text cannot be read.

With quiet_start set to 1 and the variable start_picture naming the
picture (and start_picture_mode its mode, as background_image -m takes
it), the menu now takes the picture off the terminal before it opens the
editor or the command line, so that their text stands on the plain
background of the terminal, and puts it back with background_image when
they return to the menu. Where it cannot be put back, quiet_start is
unset and the entries start as they do without a picture, writing
"Booting" as GRUB does. Without the variables nothing changes.

A start from the editor (Ctrl-x) starts on the plain background: the
picture is the menu's.
---
 grub-core/normal/menu.c | 49 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/grub-core/normal/menu.c b/grub-core/normal/menu.c
index 7d74d9f..10093e3 100644
--- a/grub-core/normal/menu.c
+++ b/grub-core/normal/menu.c
@@ -569,6 +569,51 @@ print_countdown (struct grub_term_coordinate *pos, int n)
   grub_refresh ();
 }
 
+/* With the variable quiet_start set to 1 a config may have given the
+   terminal the picture of the start as its background (background_image)
+   and named it in the variable start_picture (and its mode, as
+   background_image -m takes it, in start_picture_mode).  The editor of an
+   entry and the command line write their text on the terminal, over that
+   picture, where it is hard to read: the picture is taken off while they
+   are shown, so that their text stands on the plain background of the
+   terminal, and put back when the menu returns.  Where it cannot be put
+   back, quiet_start is unset, and the entries start as they do without a
+   picture.  Without the variables nothing changes.  */
+static int quiet_start (void);
+
+static void
+start_picture_off (void)
+{
+  char *none[] = { NULL };
+
+  if (!quiet_start () || !grub_env_get ("start_picture"))
+    return;
+  grub_command_execute ("background_image", 0, none);
+  grub_errno = GRUB_ERR_NONE;
+}
+
+static void
+start_picture_on (void)
+{
+  const char *picture = grub_env_get ("start_picture");
+  const char *mode = grub_env_get ("start_picture_mode");
+  char *args[4];
+  int argc = 0;
+
+  if (!quiet_start () || !picture || !*picture)
+    return;
+  if (mode && *mode)
+    {
+      args[argc++] = (char *) "-m";
+      args[argc++] = (char *) mode;
+    }
+  args[argc++] = (char *) picture;
+  args[argc] = NULL;
+  if (grub_command_execute ("background_image", argc, args) != GRUB_ERR_NONE)
+    grub_env_unset ("quiet_start");
+  grub_errno = GRUB_ERR_NONE;
+}
+
 #define GRUB_MENU_PAGE_SIZE 10
 
 /* Show the menu and handle menu entry selection.  Returns the menu entry
@@ -779,16 +824,20 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 
 	    case 'c':
 	      menu_fini ();
+	      start_picture_off ();
 	      grub_cmdline_run (1, 0);
+	      start_picture_on ();
 	      goto refresh;
 
 	    case 'e':
 	      menu_fini ();
+	      start_picture_off ();
 		{
 		  grub_menu_entry_t e = grub_menu_get_entry (menu, current_entry);
 		  if (e)
 		    grub_menu_entry_run (e);
 		}
+	      start_picture_on ();
 	      goto refresh;
 
 	    case GRUB_TERM_CTRL | 'l':
