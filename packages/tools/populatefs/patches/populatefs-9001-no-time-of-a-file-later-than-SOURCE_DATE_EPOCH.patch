From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:31:56 +0000
Subject: [PATCH] debugfs: no time of a file later than SOURCE_DATE_EPOCH

populatefs gives every file and directory it copies the access, change and
modification times of its source. The change time cannot be set on the
source, so two images made from the same files differ by the time they
were made. Do what mke2fs -d does (clamped_time() in e2fsprogs'
misc/create_inode.c): when SOURCE_DATE_EPOCH is set, which libext2fs
reads into fs->now, no time is later than it. Without it, nothing
changes.
---
 src/debugfs.c | 35 +++++++++++++++++++++++------------
 1 file changed, 23 insertions(+), 12 deletions(-)

diff --git a/src/debugfs.c b/src/debugfs.c
index a80523c..52af69a 100644
--- a/src/debugfs.c
+++ b/src/debugfs.c
@@ -12,6 +12,17 @@
 static ext2_filsys fs;
 static ext2_ino_t root, cwd;
 
+/* Like clamped_time() of e2fsprogs' misc/create_inode.c: with SOURCE_DATE_EPOCH, which libext2fs
+ * reads into fs->now when it opens the file system, no time of a file is later than it. */
+static time_t clamped_time(time_t t)
+{
+#ifdef EXT2_FLAG2_USE_FAKE_TIME
+	if ((fs->flags2 & EXT2_FLAG2_USE_FAKE_TIME) && t > fs->now)
+		return fs->now;
+#endif
+	return t;
+}
+
 ext2_ino_t name_to_inode(const char *name)
 {
 	ext2_ino_t ino;
@@ -174,9 +185,9 @@ int do_mkdir(struct stat *st, const char *name)
 		if ( ext2fs_read_inode(fs, ino, &inode))
 			return 0;
 
-		inode.i_atime = st->st_atime;
-		inode.i_ctime = st->st_ctime;
-		inode.i_mtime = st->st_mtime;
+		inode.i_atime = clamped_time(st->st_atime);
+		inode.i_ctime = clamped_time(st->st_ctime);
+		inode.i_mtime = clamped_time(st->st_mtime);
 
 		if ( ext2fs_write_inode(fs, ino, &inode))
 			return 0;
@@ -307,9 +318,9 @@ int do_write(char *local_file, char *name)
 	ext2fs_inode_alloc_stats2(fs, newfile, +1, 0);
 	memset(&inode, 0, sizeof(inode));
 	inode.i_mode = (statbuf.st_mode & ~LINUX_S_IFMT) | LINUX_S_IFREG;
-	inode.i_atime = statbuf.st_atime;
-	inode.i_ctime = statbuf.st_ctime;
-	inode.i_mtime = statbuf.st_mtime;
+	inode.i_atime = clamped_time(statbuf.st_atime);
+	inode.i_ctime = clamped_time(statbuf.st_ctime);
+	inode.i_mtime = clamped_time(statbuf.st_mtime);
 	inode.i_links_count = 1;
 	inode.i_size = statbuf.st_size;
 	if (fs->super->s_feature_incompat &
@@ -425,9 +436,9 @@ int do_hardlink(struct stat *st, char *sourcename, const char *name)
 		if ( ext2fs_read_inode(fs, ino, &inode))
 			return 0;
 
-		inode.i_atime = st->st_atime;
-		inode.i_ctime = st->st_ctime;
-		inode.i_mtime = st->st_mtime;
+		inode.i_atime = clamped_time(st->st_atime);
+		inode.i_ctime = clamped_time(st->st_ctime);
+		inode.i_mtime = clamped_time(st->st_mtime);
 
 		if ( ext2fs_write_inode(fs, ino, &inode))
 			return 0;
@@ -474,9 +485,9 @@ int do_symlink(struct stat *st, char *source, char *dest)
 		if ( ext2fs_read_inode(fs, ino, &inode))
 			return 0;
 
-		inode.i_atime = st->st_atime;
-		inode.i_ctime = st->st_ctime;
-		inode.i_mtime = st->st_mtime;
+		inode.i_atime = clamped_time(st->st_atime);
+		inode.i_ctime = clamped_time(st->st_ctime);
+		inode.i_mtime = clamped_time(st->st_mtime);
 
 		if ( ext2fs_write_inode(fs, ino, &inode))
 			return 0;
