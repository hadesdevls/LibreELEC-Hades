From 0235b2aed1049006738d190e8eafa887ad7d5cf2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 03:09:59 +0000
Subject: [PATCH] ply-image: "fit" keeps the proportions of the picture

ply-image makes the picture as wide and as high as the frame buffer,
whatever its proportions. A picture of 1024 by 768 is drawn a third
wider on a laptop of 1366 by 768, and a circle in it is no circle there.

With the word "fit" after the name of the picture, the picture is made
as large as fits the screen with its own proportions (by
ply_image_resize(), as before; not at all where it has the height or the
width of the screen already and fits) and drawn in the middle, on black.
It is laid into a black picture of the size of the screen first, and
that one is drawn: the frame buffer is written as it always was, whole
and from its first pixel.

Without the word nothing changes. The init of this build says it for the
pictures of the build, not for a picture of the user (oemsplash.png),
which is stretched over the screen as it always was.
---
 ply-image.c | 79 +++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 77 insertions(+), 2 deletions(-)

diff --git a/ply-image.c b/ply-image.c
index db86ee9..443b1df 100644
--- a/ply-image.c
+++ b/ply-image.c
@@ -349,6 +349,72 @@ ply_image_rotate (ply_image_t *image,
 }
 
 
+/* Hades: the picture at the largest size of its own proportions that fits a screen (with the
+ * pixels that ply_image_resize() picks), in the middle of a black picture of the size of that
+ * screen. NULL if it cannot be made. */
+static ply_image_t *
+ply_image_fit (ply_image_t *image,
+               long         screen_width,
+               long         screen_height)
+{
+  ply_image_t *scaled, *whole;
+  long width, height, new_width, new_height, left, top, i, y;
+
+  width = ply_image_get_width (image);
+  height = ply_image_get_height (image);
+
+  if (width < 1 || height < 1 || screen_width < 1 || screen_height < 1)
+    return NULL;
+
+  if (width * screen_height > height * screen_width)
+    {
+      /* wider than the screen is: it takes the whole width */
+      new_width = screen_width;
+      new_height = height * screen_width / width;
+    }
+  else
+    {
+      new_height = screen_height;
+      new_width = width * screen_height / height;
+    }
+
+  if (new_width < 1)
+    new_width = 1;
+  if (new_height < 1)
+    new_height = 1;
+
+  whole = ply_image_new (image->filename);
+  whole->layout.address = malloc (screen_width * screen_height * 4);
+  if (whole->layout.address == NULL)
+    {
+      ply_image_free (whole);
+      return NULL;
+    }
+  whole->width = screen_width;
+  whole->height = screen_height;
+
+  for (i = 0; i < screen_width * screen_height; i++)
+    whole->layout.as_pixels[i] = 0xff000000;
+
+  if (new_width == width && new_height == height)
+    scaled = image;
+  else
+    scaled = ply_image_resize (image, new_width, new_height);
+
+  left = (screen_width - new_width) / 2;
+  top = (screen_height - new_height) / 2;
+
+  for (y = 0; y < new_height; y++)
+    memcpy (&whole->layout.as_pixels[(top + y) * screen_width + left],
+            &scaled->layout.as_pixels[y * new_width],
+            new_width * 4);
+
+  if (scaled != image)
+    ply_image_free (scaled);
+
+  return whole;
+}
+
 #include "ply-frame-buffer.h"
 
 #include <math.h>
@@ -407,7 +473,7 @@ int
 main (int    argc,
       char **argv)
 {
-  ply_image_t *image;
+  ply_image_t *image, *fitted;
   ply_frame_buffer_t *buffer;
   int exit_code;
 
@@ -438,7 +504,16 @@ main (int    argc,
       return exit_code;
     }
 
-  image = ply_image_resize(image, buffer->area.width, buffer->area.height);
+  /* Hades: with "fit" after the name of the picture, the picture keeps its proportions.
+   * Without it, it is stretched over the whole screen, as always. */
+  fitted = NULL;
+  if (argc > 2 && strcmp (argv[2], "fit") == 0)
+    fitted = ply_image_fit (image, buffer->area.width, buffer->area.height);
+
+  if (fitted != NULL)
+    image = fitted;
+  else
+    image = ply_image_resize(image, buffer->area.width, buffer->area.height);
 
   animate_at_time (buffer, image);
 
