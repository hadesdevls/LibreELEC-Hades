From 1096880224c52f9bada7a72c3514fafea513ef33 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 17 Nov 2026 22:45:00 +0000
Subject: [PATCH] ply-image: show the frame buffer once the picture is in it

ply-image writes the picture into the memory of the frame buffer and
leaves. On the frame buffer of a DRM driver (fbdev emulation: amdgpu,
i915, nvidia-drm, virtio-gpu...) that memory is on the screen only
after something has set its mode. Until now the console of the kernel
did that: it took the screen as soon as the frame buffer was there. With
its take-over deferred (FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER: the screen
keeps what is on it, the picture of the boot menu, until text is written
to the console) nothing does, and the splash screen would be drawn where
no one sees it.

After drawing, pan to where the frame buffer already is. The driver
then shows it, as the console did when it took the screen
(drm_fb_helper_pan_display commits the mode of the frame buffer); it
refuses while a program owns the display, so it never takes the screen
from one. A frame buffer that cannot pan, such as efifb, which is the
screen itself, refuses and is left as it is. What was done is said on
stderr.
---
 ply-image.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/ply-image.c b/ply-image.c
index 443b1df..8a4aa2d 100644
--- a/ply-image.c
+++ b/ply-image.c
@@ -469,6 +469,31 @@ animate_at_time (ply_frame_buffer_t *buffer,
 
 }
 
+/* Hades: shows the frame buffer, once the picture is in it. The frame buffer of a DRM driver (its
+ * fbdev emulation) is on the screen only after something has set its mode. The console of the kernel
+ * did that as it took the screen, as soon as the frame buffer was there; with that take-over deferred
+ * (the screen keeps what is on it until text is written to the console) nothing does, and the picture
+ * would be drawn where no one sees it. A pan to where the frame buffer is already makes the driver
+ * show it, as the console would have (drm_fb_helper_pan_display), and is refused while a program owns
+ * the display. A frame buffer that cannot pan, such as efifb, is the screen itself, and is left as it
+ * is. Says on stderr what was done. */
+static void
+show_frame_buffer (ply_frame_buffer_t *buffer)
+{
+  struct fb_var_screeninfo var;
+
+  if (ioctl (buffer->device_fd, FBIOGET_VSCREENINFO, &var) < 0)
+    {
+      perror ("ply-image: the frame buffer could not be read");
+      return;
+    }
+
+  if (ioctl (buffer->device_fd, FBIOPAN_DISPLAY, &var) < 0)
+    perror ("ply-image: the frame buffer was not panned");
+  else
+    fprintf (stderr, "ply-image: the frame buffer is shown\n");
+}
+
 int
 main (int    argc,
       char **argv)
@@ -516,6 +541,7 @@ main (int    argc,
     image = ply_image_resize(image, buffer->area.width, buffer->area.height);
 
   animate_at_time (buffer, image);
+  show_frame_buffer (buffer);
 
   ply_frame_buffer_close (buffer);
   ply_frame_buffer_free (buffer);
