From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:34:11 +0000
Subject: [PATCH] opengl: timer queries paused by the caller, for the frames it
 does not time

With gles_timer_queries (libplacebo-9944), every pass of every render
on OpenGL ES begins and ends a GL_TIME_ELAPSED query, and every result
that comes back is read: a cost in each frame. A caller that wants the
GPU time of its passes on any GPU, without a setting and without that
cost in every frame, times some frames only: Kodi's Dolby Vision
bridge, one frame in eight, for its player information and its log.

pl_opengl_pause_timers(gpu, paused): while paused, gl_timer_begin()
begins no query, and gl_timer_end() ends one only where its begin
began it (a timer remembers that it is open), so that a pass begun
before a change ends its query whatever the change says. The results
of the queries made before are taken as before: pl_timer_query() reads
what has come back, whatever this says. A gpu that is not OpenGL's is
left alone; the stub of a build without OpenGL does nothing.

The timers of pl_tex_upload/download that a caller gives are paused
the same way: a paused caller has asked for no time.

License: LGPL-2.1-or-later, that of libplacebo and of the files changed,
whose notices stay as they are.
---
 src/include/libplacebo/opengl.h |  8 ++++++++
 src/opengl/gpu.c                | 15 ++++++++++++++-
 src/opengl/gpu.h                |  1 +
 src/opengl/stubs.c              |  4 ++++
 4 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/include/libplacebo/opengl.h b/src/include/libplacebo/opengl.h
index 3471d4c..0f20cf1 100644
--- a/src/include/libplacebo/opengl.h
+++ b/src/include/libplacebo/opengl.h
@@ -130,6 +130,14 @@ PL_API void pl_opengl_destroy(pl_opengl *gl);
 // the underlying `pl_opengl`. Returns NULL for any other type of `gpu`.
 PL_API pl_opengl pl_opengl_get(pl_gpu gpu);
 
+// For a `pl_gpu` backed by `pl_opengl` whose passes are timed (`pl_timer`, on
+// OpenGL ES with `gles_timer_queries`): while paused, no pass begins or ends a
+// query of its time, so that a caller can time some frames and leave the
+// others without that cost. The results of the queries made before are still
+// taken. A pass already begun ends its query whatever this says. Nothing for
+// any other `gpu`.
+PL_API void pl_opengl_pause_timers(pl_gpu gpu, bool paused);
+
 struct pl_opengl_framebuffer {
     // ID of the framebuffer, or 0 to use the context's default framebuffer.
     int id;
diff --git a/src/opengl/gpu.c b/src/opengl/gpu.c
index cad13e0..b45bfaf 100644
--- a/src/opengl/gpu.c
+++ b/src/opengl/gpu.c
@@ -54,6 +54,14 @@ pl_opengl pl_opengl_get(pl_gpu gpu)
     return NULL;
 }
 
+void pl_opengl_pause_timers(pl_gpu gpu, bool paused)
+{
+    if (!pl_opengl_get(gpu))
+        return;
+    struct pl_gl *p = PL_PRIV(gpu);
+    p->timers_paused = paused;
+}
+
 static pl_handle_caps tex_handle_caps(pl_gpu gpu, bool import)
 {
     pl_handle_caps caps = 0;
@@ -558,6 +566,7 @@ struct pl_timer_t {
     uint64_t disjoint_events[QUERY_OBJECT_NUM]; // p->disjoint_events at begin
     int index_write; // next index to write to
     int index_read; // next index to read from
+    bool open; // a query was begun and not ended (pl_opengl_pause_timers)
 };
 
 static pl_timer gl_timer_create(pl_gpu gpu)
@@ -642,17 +651,21 @@ void gl_timer_begin(pl_gpu gpu, pl_timer timer)
 
     const gl_funcs *gl = gl_funcs_get(gpu);
     struct pl_gl *p = PL_PRIV(gpu);
+    if (p->timers_paused)
+        return;
     timer->disjoint_events[timer->index_write] = p->disjoint_events;
     gl->BeginQuery(GL_TIME_ELAPSED, timer->query[timer->index_write]);
+    timer->open = true;
 }
 
 void gl_timer_end(pl_gpu gpu, pl_timer timer)
 {
-    if (!timer)
+    if (!timer || !timer->open)
         return;
 
     const gl_funcs *gl = gl_funcs_get(gpu);
     gl->EndQuery(GL_TIME_ELAPSED);
+    timer->open = false;
 
     timer->index_write = (timer->index_write + 1) % QUERY_OBJECT_NUM;
     if (timer->index_write == timer->index_read) {
diff --git a/src/opengl/gpu.h b/src/opengl/gpu.h
index a7871a1..14126ee 100644
--- a/src/opengl/gpu.h
+++ b/src/opengl/gpu.h
@@ -61,6 +61,7 @@ struct pl_gl {
     bool has_queries;
     bool has_disjoint;
     bool read_disjoint; // GL_GPU_DISJOINT_EXT is read here, not by the caller
+    bool timers_paused; // no pass begins a timer query (pl_opengl_pause_timers)
     bool has_modifiers;
     bool has_readback;
     bool has_egl_storage;
diff --git a/src/opengl/stubs.c b/src/opengl/stubs.c
index 20395f9..dd165fc 100644
--- a/src/opengl/stubs.c
+++ b/src/opengl/stubs.c
@@ -39,6 +39,10 @@ pl_opengl pl_opengl_get(pl_gpu gpu)
     return NULL;
 }
 
+void pl_opengl_pause_timers(pl_gpu gpu, bool paused)
+{
+}
+
 pl_swapchain pl_opengl_create_swapchain(pl_opengl gl,
                             const struct pl_opengl_swapchain_params *params)
 {
