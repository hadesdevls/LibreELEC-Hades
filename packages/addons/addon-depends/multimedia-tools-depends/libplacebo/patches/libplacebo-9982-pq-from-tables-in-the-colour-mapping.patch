 PL_API void pl_renderer_destroy(pl_renderer *rr);
 
+// Hades: how the colour mapping of this renderer takes the PQ curves: 1 read
+// from tables made in double precision, -1 computed with pow() (the GPU
+// does not make the tables; libplacebo says why), 0 not known yet
+#define PL_RENDERER_PQ_TABLES 1
+PL_API int pl_renderer_pq_tables(pl_renderer rr);
+
