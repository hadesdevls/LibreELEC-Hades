index 707e6b6..b89428d 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -16,6 +16,7 @@
  */
 
 #include <math.h>
+#include <stdlib.h>
 
 #include "cache.h"
 #include "colorspace.h"
@@ -48,9 +49,92 @@ void pl_shader_set_alpha(pl_shader sh, struct pl_color_repr *repr,
     }
