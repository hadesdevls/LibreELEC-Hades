From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:43:02 +0000
Subject: [PATCH] dovi_ccm: the vertical passes of the layer read only the rows
 they use

The vertical passes that resample the enhancement layer (ETSI GS CCM 001
annex B.3, in the composer of libplacebo-9930, with the step-down of
libplacebo-9940) read five rows of the layer for the four-tap luma filter
and three for the two-tap chroma one, and each output row used four (two)
of them: an even row the rows n - 2 to n + 1, an odd one n - 1 to n + 2.

Now each output row chooses, by its parity, the rows that its phase of the
filter takes and their weights, and reads only those: four and two reads
instead of five and three, with the same integer sums (exact, whatever the
order).

Measured on Mesa's zink with fidbench (14 pictures of a profile 7 FEL
stream; the source transport at step-down levels 0, 1 and 2, the converted
one, and with GUI elements): the composed planes and every transport the
same bytes as before. A weight of the luma filter changed by one (a
mutation) changes them.

License: LGPL-2.1-or-later, that of libplacebo and of the file changed,
whose notice stays as it is.
---
 src/renderer.c | 28 +++++++++++++++++++---------
 1 file changed, 19 insertions(+), 9 deletions(-)

diff --git a/src/renderer.c b/src/renderer.c
index 54ddcd32..7c88f5b5 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -2109,23 +2109,33 @@ static pl_tex ccm_el_vertical(struct pass_state *pass, const struct ccm_ctx *x,
 
     const int last = (luma ? x->elh : (x->elh + 1) / 2) - 1;
     struct ccm_binds binds = {0};
+    // Hades: each output row reads only the rows of the layer that its filter
+    // takes: the four of the luma filter of annex B.3 (n - 2 to n + 1 for an
+    // even row, n - 1 to n + 2 for an odd one, as the two phases of the filter
+    // weigh them) or the two of the chroma one, chosen by the parity of the
+    // row with their weights; the same integer sums as before, which read five
+    // rows (three) and used four (two).
     GLSL("int n = p.y >> 1;                \n"
          "bool odd = (p.y & 1) != 0;       \n"
          "ivec4 r = clamp(ivec4(n - 2, n - 1, n + 1, n + 2), 0, %d); \n"
          "int r0 = clamp(n, 0, %d);        \n", last, last);
+    if (four) {
+        GLSL("ivec4 q = odd ? ivec4(r.y, r0, r.z, r.w) : ivec4(r.x, r.y, r0, r.z); \n"
+             "ivec4 w = odd ? ivec4(-9, 111, 29, -3) : ivec4(-3, 29, 111, -9);   \n");
+    } else {
+        GLSL("ivec2 q = odd ? ivec2(r0, r.z) : ivec2(r.y, r0);   \n"
+             "ivec2 w = odd ? ivec2(192, 64) : ivec2(64, 192);   \n");
+    }
     for (int k = 0; k < (luma ? 1 : 2); k++) {
         ident_t e = ccm_code(sh, &binds, &x->el[luma ? 0 : 1 + k], x->kel, "dv_el");
-        GLSL("{                                                          \n"
-             "int b = "$"(ivec2(p.x, r.y));                              \n"
-             "int c = "$"(ivec2(p.x, r0)),  d = "$"(ivec2(p.x, r.z));    \n",
-             e, e, e);
+        GLSL("{                                                          \n");
         if (four) {
-            GLSL("int a = "$"(ivec2(p.x, r.x)), f = "$"(ivec2(p.x, r.w)); \n", e, e);
-            GLSL("int v = odd ? ((-9*b + 111*c + 29*d - 3*f + 64) >> 7) \n"
-                 "            : ((-3*a + 29*b + 111*c - 9*d + 64) >> 7);\n");
+            GLSL("int v = (w.x * "$"(ivec2(p.x, q.x)) + w.y * "$"(ivec2(p.x, q.y)) \n"
+                 "       + w.z * "$"(ivec2(p.x, q.z)) + w.w * "$"(ivec2(p.x, q.w)) \n"
+                 "       + 64) >> 7;                                     \n", e, e, e, e);
         } else {
-            GLSL("int v = odd ? ((192*c + 64*d + 128) >> 8)             \n"
-                 "            : ((64*b + 192*c + 128) >> 8);             \n");
+            GLSL("int v = (w.x * "$"(ivec2(p.x, q.x)) + w.y * "$"(ivec2(p.x, q.y)) \n"
+                 "       + 128) >> 8;                                    \n", e, e);
         }
         GLSL("color[%d] = float(clamp(v, 0, 65535));                    \n"
              "}                                                          \n", k);
