From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:05:10 +0000
Subject: [PATCH] opengl: timer queries on OpenGL ES where the caller asks for
 them

libplacebo times each pass (pl_dispatch_info.samples, pl_timer) with
GL_TIME_ELAPSED queries only on desktop OpenGL 3.0 and later or with
GL_ARB_timer_query (has_queries): on OpenGL ES, which Kodi's Dolby
Vision bridge draws with (GBM and EGL), it makes no timer, and every
pass's list of times stays empty, also for an info callback. OpenGL ES
3.0 has the query objects, and GL_EXT_disjoint_timer_query their
TIME_ELAPSED target (the same token); Mesa and NVIDIA's driver have it.

A field is added at the end of pl_opengl_params, gles_timer_queries,
false by default: with it and the extension, OpenGL ES 3.0 and later
times the passes as desktop OpenGL does. Without it nothing changes: no
timer is made, no pass begins a query. On OpenGL ES the query that was
ended last is left for the next call: its result cannot have come back,
and asking for it costs time for nothing (measured on zink: about a
millisecond in each frame of the bridge's measured-bridge test).
GL_GPU_DISJOINT_EXT, which says that results were lost, is not read
here: a caller that asks for the timers reads it (Kodi does already,
every frame, for its own timer of the frame).

pl_dispatch_info gets num_total, the count of the times taken of a pass
since it was made. Its samples are the last 256: once that list is
full, its length no longer tells a caller that reads it after each run
which times are new.

Measured with Kodi's bridge on Mesa's software OpenGL ES (zink on
lavapipe): with the timers asked for, every pass of the composer of
CCM 001 and of the rendering has its times; the same bytes with and
without them in every drawing of the bridge's render test (36, the
converted transport) and of its measured-bridge test (20 frames, the
source transport); what they cost there, in the bridge's commit.

License: LGPL-2.1-or-later, that of libplacebo and of the files changed,
whose notices stay as they are.
---
 src/dispatch.c                    | 3 +++
 src/include/libplacebo/dispatch.h | 5 +++++
 src/include/libplacebo/opengl.h   | 8 ++++++++
 src/opengl/gpu.c                  | 9 ++++++++-
 4 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/dispatch.c b/src/dispatch.c
index 5df24c05..cfad71d8 100644
--- a/src/dispatch.c
+++ b/src/dispatch.c
@@ -96,6 +96,7 @@ struct pass {
     uint64_t ts_last;
     uint64_t ts_peak;
     uint64_t ts_sum;
+    uint64_t ts_total;
     uint64_t samples[PL_ARRAY_SIZE(((struct pl_dispatch_info *) NULL)->samples)];
     int ts_idx;
 };
@@ -1169,6 +1170,7 @@ static void run_pass(pl_dispatch dp, pl_shader sh, struct pass *pass)
         pass->ts_last = ts;
         pass->ts_peak = PL_MAX(pass->ts_peak, ts);
         pass->ts_sum += ts;
+        pass->ts_total++;
         pass->ts_idx = (pass->ts_idx + 1) % PL_ARRAY_SIZE(pass->samples);
 
         if (old) {
@@ -1206,6 +1208,7 @@ static void run_pass(pl_dispatch dp, pl_shader sh, struct pass *pass)
     info.last = pass->ts_last;
     info.peak = pass->ts_peak;
     info.average = pass->ts_sum / PL_MAX(info.num_samples, 1);
+    info.num_total = pass->ts_total;
     dp->info_callback(dp->info_priv, &info);
 }
 
diff --git a/src/include/libplacebo/dispatch.h b/src/include/libplacebo/dispatch.h
index 141055c2..1693f4a8 100644
--- a/src/include/libplacebo/dispatch.h
+++ b/src/include/libplacebo/dispatch.h
@@ -62,6 +62,11 @@ struct pl_dispatch_info {
     uint64_t last;
     uint64_t peak;
     uint64_t average;
+
+    // The number of execution times taken for this pass since it was made.
+    // The samples that are new since an earlier call are the last
+    // `num_total - (num_total of that call)` of `samples`, up to `num_samples`.
+    uint64_t num_total;
 };
 
 // Helper function to make a copy of `pl_dispatch_info`, while overriding
diff --git a/src/include/libplacebo/opengl.h b/src/include/libplacebo/opengl.h
index 168281e1..9d769b5d 100644
--- a/src/include/libplacebo/opengl.h
+++ b/src/include/libplacebo/opengl.h
@@ -95,6 +95,14 @@ struct pl_opengl_params {
     bool (*make_current)(void *priv);
     void (*release_current)(void *priv);
     void *priv;
+
+    // Time the passes on OpenGL ES 3.0 and later with GL_EXT_disjoint_timer_query
+    // (`pl_dispatch_info.samples`, `pl_timer`), as on desktop OpenGL. Off by
+    // default: every pass then begins and ends a query of the time it took,
+    // and reads the results that have come back (it never waits for one).
+    // The extension can lose results (GL_GPU_DISJOINT_EXT, which libplacebo
+    // does not read): a caller that asks for this reads that state itself.
+    bool gles_timer_queries;
 };
 
 // Default/recommended parameters
diff --git a/src/opengl/gpu.c b/src/opengl/gpu.c
index 0ac06967..befdc35d 100644
--- a/src/opengl/gpu.c
+++ b/src/opengl/gpu.c
@@ -268,7 +268,9 @@ pl_gpu pl_gpu_create_gl(pl_log log, pl_opengl pl_gl, const struct pl_opengl_para
                            // Work around <https://forums.developer.nvidia.com/t/373037>
                            strcmp(vendor, "NVIDIA Corporation");
     p->has_invalidate_tex = gl_test_ext(gpu, "GL_ARB_invalidate_subdata", 43, 0);
-    p->has_queries = gl_test_ext(gpu, "GL_ARB_timer_query", 30, 0);
+    p->has_queries = gl_test_ext(gpu, "GL_ARB_timer_query", 30, 0) ||
+                     (params->gles_timer_queries && p->gles_ver >= 30 &&
+                      pl_opengl_has_ext(pl_gl, "GL_EXT_disjoint_timer_query"));
     p->has_storage = gl_test_ext(gpu, "GL_ARB_shader_image_load_store", 42, 31) &&
                      gl_test_ext(gpu, "GL_ARB_texture_storage", 42, 30);
     p->has_readback = true;
@@ -583,6 +585,11 @@ static uint64_t gl_timer_query(pl_gpu gpu, pl_timer timer)
         return 0; // no more unprocessed results
 
     struct pl_gl *p = PL_PRIV(gpu);
+    // On OpenGL ES (gles_timer_queries) the query that was ended last is left
+    // for the next call: its result cannot have come back yet, and asking for
+    // it costs time for nothing (on zink, about a millisecond a frame)
+    if (p->gles_ver && (timer->index_read + 1) % QUERY_OBJECT_NUM == timer->index_write)
+        return 0;
 
     const gl_funcs *gl = gl_funcs_get(gpu);
     if (!MAKE_CURRENT())
