From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:56:05 +0000
Subject: [PATCH] shaders/colorspace: the gamut mapping table of a mapping can
 be made ahead of the shader that maps

pl_shader_color_map_ex() makes the gamut mapping table when the shader of
the first picture of a mapping is made, on the thread that makes it, which
is the thread that draws. At the size that Kodi's Dolby Vision bridge asks
for (96x64x512 entries, 24 MiB) that took 0.64 s of one core of a Ryzen 9
7950X3D, 346 ms on two of its threads, 174 ms on four, 106 ms on eight and
49 ms on all 32 (pl_gamut_map_generate() spreads it over threads of its
own). In Kodi that thread is the one of the interface, which misses that
many refreshes while the first picture of a video waits for it.

The parameters of the table are now taken by one function,
color_map_gamut(), and the table is made by another, gamut_table_make();
the shader calls both, as it did the code they hold. Two public functions
give them to a caller that knows the mapping before the first picture:
pl_color_map_gamut_table() says whether the shader of a mapping of src to
dst with these params, made as a renderer makes it (with a state object),
draws with a table on this GPU, and which one: its parameters, its texture
format, its signature as sh_lut() keys it, and its size.
pl_gamut_table_fill() makes that table, on any thread, reading nothing of
the GPU but the format. The caller gives it to the shader through
pl_color_map_params.gamut_table_source: take() is asked, with the
signature and the size of the table that the shader needs, before the
shader makes it, and fills it where it has that one; made() is told of a
table that the shader made itself, its bytes and the time it took.

Nothing changes where no source is given, the default. Where one is, the
shader draws with the same table: it is made by the same function from
parameters taken the same way, and it is taken only for the signature and
the size that the shader asks for; any other is made as before. Measured
with Kodi's bridge on Mesa's software OpenGL ES, for twelve mappings
(Dolby Vision Low-Latency to a display's own primaries; Dolby Vision and
HDR10 to HDR10 displays of BT.2020, P3 and BT.709, of 300 to 2485 cd/m2,
with the BT.2390 curve and the spline; to SDR displays; HLG to SDR; with
the gamut of the mastering display known or not; the standard and the
finer table): the table made ahead is the shader's own, byte for byte, the
shader takes it and makes none, and a mapping that needs no table gets
none either way. The first pictures of a profile 7 stream with its
enhancement layer, mapped three ways, come out the same bytes with the
table made ahead or not.

License: LGPL-2.1-or-later, that of libplacebo and of the files changed,
whose notices stay as they are.
---
 src/include/libplacebo/shaders/colorspace.h |  44 ++++
 src/shaders/colorspace.c                    | 252 ++++++++++++++------
 2 files changed, 224 insertions(+), 72 deletions(-)

diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
index 44095ad..8ce234b 100644
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -278,6 +278,21 @@ enum pl_gamut_mode {
     PL_GAMUT_MODE_COUNT,
 };
 
+// Hades: where the gamut mapping table of a mapping may come from, made ahead of
+// the shader that maps (pl_color_map_gamut_table(), pl_gamut_table_fill()).
+// `take` is asked before the shader makes a table, with the signature and the
+// size in bytes of the table it needs, and returns true where it has filled
+// `data` with that table. `made` is told of a table that the shader made itself
+// instead (its bytes, valid during the call) and of the time it took, in ms.
+// Either may be NULL. Both are called on the thread that makes the shader,
+// while it is made.
+struct pl_gamut_table_source {
+    bool (*take)(void *priv, uint64_t signature, void *data, size_t bytes);
+    void (*made)(void *priv, uint64_t signature, const void *data, size_t bytes,
+                 double ms);
+    void *priv;
+};
+
 struct pl_color_map_params {
     // --- Gamut mapping options
 
@@ -400,6 +415,11 @@ struct pl_color_map_params {
     // display can show is then shown as mastered, and only what it cannot
     // is compressed into its peak.
     bool dynamic_target;
+
+    // Hades: the gamut mapping table made ahead of the shader, where the
+    // caller has it (pl_gamut_table_source). NULL: the shader makes it, as
+    // always. Either way the table is the same, byte for byte.
+    const struct pl_gamut_table_source *gamut_table_source;
 };
 
 #define PL_COLOR_MAP_DEFAULTS                                   \
@@ -462,6 +482,30 @@ PL_API void pl_shader_color_map(pl_shader sh, const struct pl_color_map_params *
                                 struct pl_color_space src, struct pl_color_space dst,
                                 pl_shader_obj *state, bool prelinearized);
 
+// Hades: the gamut mapping table of a mapping, made ahead of the shader that
+// maps, so that a picture does not wait while it is made: on another thread,
+// before the first picture that maps is drawn. The table is the shader's own
+// (its parameters are taken the same way, and the same function makes it), and
+// the shader takes it through `pl_color_map_params.gamut_table_source`.
+struct pl_gamut_table {
+    struct pl_gamut_map_params params; // what the table is made from
+    pl_fmt fmt;                        // the texture format it is kept in
+    uint64_t signature;                // as the shader asks for it
+    size_t bytes;                      // its size in that format
+};
+
+// Whether the shader of a mapping of `src` to `dst` with `params`, made as a
+// renderer makes it (with a state object), draws with a gamut mapping table on
+// `gpu`, and if so which one, into `table`. `src` and `dst` are the color spaces
+// that the renderer maps between (those of the image and the target).
+PL_API bool pl_color_map_gamut_table(pl_gpu gpu, const struct pl_color_map_params *params,
+                                     struct pl_color_space src, struct pl_color_space dst,
+                                     struct pl_gamut_table *table);
+
+// Makes that table into `data` (`table->bytes` of it). It reads nothing of the
+// GPU but the format, and may run on any thread while the GPU exists.
+PL_API void pl_gamut_table_fill(void *data, const struct pl_gamut_table *table);
+
 // Applies a set of cone distortion parameters to `vec4 color` in a given color
 // space. This can be used to simulate color blindness. See `pl_cone_params`
 // for more information.
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 67405ff..d9ac851 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -2070,22 +2070,26 @@ static uint16_t gamut_half(float f)
     return (uint16_t) ((r - 0x38000000) >> 13);
 }
 
-static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
+// Hades: the gamut mapping table of `lut_params` into `data`, in the texture
+// format `fmt` (gamut_lut_fmt()): what fill_gamut_lut() makes for the shader,
+// and what pl_gamut_table_fill() makes ahead of it. Reads nothing of the GPU
+// but the format.
+static void gamut_table_make(void *data, pl_fmt fmt,
+                             const struct pl_gamut_map_params *lut_params)
 {
-    const struct pl_gamut_map_params *lut_params = params->priv;
-    const int lut_size = params->width * params->height * params->depth;
+    const int lut_size = lut_params->lut_size_I * lut_params->lut_size_C *
+                         lut_params->lut_size_h;
     void *tmp = pl_alloc(NULL, lut_size * sizeof(float) * lut_params->lut_stride);
     pl_gamut_map_generate(tmp, lut_params);
 
     const float *in = tmp;
     pl_assert(lut_params->lut_stride == 3);
-    pl_assert(params->comps == 4);
-    if (params->fmt->type == PL_FMT_FLOAT) {
+    if (fmt->type == PL_FMT_FLOAT) {
         // Hades: a float table (gamut_lut_fmt()) holds what a 16-bit unorm one holds,
         // within [0, 1] and with the chroma shifted by the same 32768/65535, without its
         // rounding to 16 bits (32-bit floats), or rounded to 11 significant bits (half)
         const float shift = 32768.0f / UINT16_MAX;
-        const bool half = params->fmt->component_depth[0] == 16;
+        const bool half = fmt->component_depth[0] == 16;
         float *out32 = data;
         uint16_t *out16 = data;
         for (int i = 0; i < lut_size; i++) {
@@ -2123,6 +2127,36 @@ static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
     pl_free(tmp);
 }
 
+// Hades: what the shader's gamut mapping table is made from (sh_lut()'s priv)
+struct gamut_fill {
+    const struct pl_gamut_map_params *gamut;
+    const struct pl_gamut_table_source *source; // the caller's, or NULL
+};
+
+static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
+{
+    const struct gamut_fill *fill = params->priv;
+    pl_assert(params->comps == 4);
+    pl_assert(params->width == fill->gamut->lut_size_I &&
+              params->height == fill->gamut->lut_size_C &&
+              params->depth == fill->gamut->lut_size_h);
+    // Hades: the table made ahead, where the caller has the one asked for
+    // (the same signature and size: the same parameters and format)
+    const struct pl_gamut_table_source *source = fill->source;
+    const size_t bytes = (size_t) params->width * params->height * params->depth *
+                         params->fmt->texel_size;
+    if (source && source->take &&
+        source->take(source->priv, params->signature, data, bytes))
+        return;
+
+    const pl_clock_t start = pl_clock_now();
+    gamut_table_make(data, params->fmt, fill->gamut);
+    if (source && source->made) {
+        source->made(source->priv, params->signature, data, bytes,
+                     pl_clock_diff(pl_clock_now(), start) * 1e3);
+    }
+}
+
 // Hades: the format of the gamut mapping table: 16-bit unorm with linear filtering, as
 // always; where the GPU cannot filter that (OpenGL ES without GL_EXT_texture_norm16 has no
 // 16-bit unorm texture at all), 32-bit and then 16-bit floats with linear filtering, which
@@ -2138,6 +2172,135 @@ static pl_fmt gamut_lut_fmt(pl_gpu gpu)
     return fmt;
 }
 
+// Hades: the signature of the gamut mapping table of `gamut` kept in `fmt`, as
+// the shader keys it (sh_lut(); a table in floats is not one in 16-bit unorm)
+static uint64_t gamut_table_signature(const struct pl_gamut_map_params *gamut,
+                                      pl_fmt fmt)
+{
+    return gamut_map_signature(gamut) ^
+           (fmt->type != PL_FMT_FLOAT ? 0 :
+            fmt->component_depth[0] == 16 ? 0x48616465735f6631ULL
+                                          : 0x48616465735f6632ULL);
+}
+
+// Hades: the parameters of the gamut mapping of `src` to `dst`, both as
+// pl_color_space_infer_map() left them, as pl_shader_color_map_ex() maps: with
+// a state object (`state`), or without one, which turns the advanced methods
+// off. (Where the GPU has no format for its table, the shader maps by
+// saturation instead: gamut_lut_fmt().) Taken by the shader and by
+// pl_color_map_gamut_table() alike, so that a table made ahead is the one the
+// shader asks for.
+static void color_map_gamut(const struct pl_color_map_params *params,
+                            const struct pl_color_space *src,
+                            const struct pl_color_space *dst, bool state,
+                            struct pl_gamut_map_params *gamut)
+{
+    const int *lut3d_size_def = pl_color_map_default_params.lut3d_size;
+    // Tone mapping and the gamut-mapping source extent share this space
+    const struct pl_raw_primaries *src_space = use_mastering_space(src, NULL)
+        ? &src->hdr.prim : pl_raw_primaries_get(src->primaries);
+
+    *gamut = (struct pl_gamut_map_params) {
+        .function        = PL_DEF(params->gamut_mapping, &pl_gamut_map_clip),
+        .constants       = params->gamut_constants,
+        .input_gamut     = *src_space,
+        .output_gamut    = dst->hdr.prim,
+        .lut_size_I      = PL_DEF(params->lut3d_size[0], lut3d_size_def[0]),
+        .lut_size_C      = PL_DEF(params->lut3d_size[1], lut3d_size_def[1]),
+        .lut_size_h      = PL_DEF(params->lut3d_size[2], lut3d_size_def[2]),
+        .lut_stride      = 3,
+    };
+
+    pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
+        .color      = dst,
+        .metadata   = PL_HDR_METADATA_HDR10,
+        .scaling    = PL_HDR_PQ,
+        .out_min    = &gamut->min_luma,
+        .out_max    = &gamut->max_luma,
+    ));
+
+    gamut->min_luma = pl_signal_black(gamut->min_luma, PL_HDR_PQ);
+
+    // Clip the gamut mapping output to the input gamut if disabled
+    if (!params->gamut_expansion && gamut->function->bidirectional) {
+        if (pl_primaries_compatible(&gamut->input_gamut, &gamut->output_gamut)) {
+            gamut->output_gamut = pl_primaries_clip(&gamut->output_gamut,
+                                                    &gamut->input_gamut);
+        }
+    }
+
+    // Backwards compatibility with older API
+    switch (params->gamut_mode) {
+    case PL_GAMUT_CLIP:
+        switch (params->intent) {
+        case PL_INTENT_AUTO:
+        case PL_INTENT_PERCEPTUAL:
+        case PL_INTENT_RELATIVE_COLORIMETRIC:
+            break; // leave default
+        case PL_INTENT_SATURATION:
+            gamut->function = &pl_gamut_map_saturation;
+            break;
+        case PL_INTENT_ABSOLUTE_COLORIMETRIC:
+            gamut->function = &pl_gamut_map_absolute;
+            break;
+        }
+        break;
+    case PL_GAMUT_DARKEN:
+        gamut->function = &pl_gamut_map_darken;
+        break;
+    case PL_GAMUT_WARN:
+        gamut->function = &pl_gamut_map_highlight;
+        break;
+    case PL_GAMUT_DESATURATE:
+        gamut->function = &pl_gamut_map_desaturate;
+        break;
+    case PL_GAMUT_MODE_COUNT:
+        pl_unreachable();
+    }
+
+    // No state object provided, forcibly disable advanced methods
+    if (!state && gamut->function != &pl_gamut_map_clip)
+        gamut->function = &pl_gamut_map_saturation;
+}
+
+bool pl_color_map_gamut_table(pl_gpu gpu, const struct pl_color_map_params *params,
+                              struct pl_color_space src, struct pl_color_space dst,
+                              struct pl_gamut_table *table)
+{
+    *table = (struct pl_gamut_table) {0};
+    if (!gpu)
+        return false;
+
+    // As the shader takes the two: what it adds to `src` from a measurement of
+    // the picture is its brightness, which the gamut mapping does not read
+    pl_color_space_infer_map(&src, &dst);
+    if (pl_color_space_equal(&src, &dst))
+        return false;
+
+    params = PL_DEF(params, &pl_color_map_default_params);
+    struct pl_gamut_map_params gamut;
+    color_map_gamut(params, &src, &dst, true, &gamut);
+    pl_fmt fmt = gamut_lut_fmt(gpu);
+    // The shader maps without a table where the GPU has no format for one,
+    // where the mapping changes nothing, and by saturation (unless the tables
+    // are forced)
+    if (!fmt || pl_gamut_map_params_noop(&gamut) ||
+        (gamut.function == &pl_gamut_map_saturation && !params->force_tone_mapping_lut))
+        return false;
+
+    table->params = gamut;
+    table->fmt = fmt;
+    table->signature = gamut_table_signature(&gamut, fmt);
+    table->bytes = (size_t) gamut.lut_size_I * gamut.lut_size_C * gamut.lut_size_h *
+                   fmt->texel_size;
+    return true;
+}
+
+void pl_gamut_table_fill(void *data, const struct pl_gamut_table *table)
+{
+    gamut_table_make(data, table->fmt, &table->params);
+}
+
 void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *params,
                             const struct pl_color_map_args *args)
 {
@@ -2294,23 +2457,16 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         }
     }
 
-    const int *lut3d_size_def = pl_color_map_default_params.lut3d_size;
     // Tone mapping and the gamut-mapping source extent share this space
     pl_matrix3x3 space_mat;
     const bool use_mast_space = use_mastering_space(&src, &space_mat);
     const struct pl_raw_primaries *src_space = use_mast_space
         ? &src.hdr.prim : pl_raw_primaries_get(src.primaries);
 
-    struct pl_gamut_map_params gamut = {
-        .function        = PL_DEF(params->gamut_mapping, &pl_gamut_map_clip),
-        .constants       = params->gamut_constants,
-        .input_gamut     = *src_space,
-        .output_gamut    = dst.hdr.prim,
-        .lut_size_I      = PL_DEF(params->lut3d_size[0], lut3d_size_def[0]),
-        .lut_size_C      = PL_DEF(params->lut3d_size[1], lut3d_size_def[1]),
-        .lut_size_h      = PL_DEF(params->lut3d_size[2], lut3d_size_def[2]),
-        .lut_stride      = 3,
