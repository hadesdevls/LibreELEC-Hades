+    // Hades: the parameters of the gamut mapping, as pl_color_map_gamut_table()
+    // takes them (color_map_gamut())
+    struct pl_gamut_map_params gamut;
+    color_map_gamut(params, &src, &dst, args->state, &gamut);
 
     float src_peak_static;
     pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
@@ -2320,61 +2476,13 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
         .out_max    = &src_peak_static,
     ));
 
-    pl_color_space_nominal_luma_ex(pl_nominal_luma_params(
-        .color      = &dst,
-        .metadata   = PL_HDR_METADATA_HDR10,
-        .scaling    = PL_HDR_PQ,
-        .out_min    = &gamut.min_luma,
-        .out_max    = &gamut.max_luma,
-    ));
