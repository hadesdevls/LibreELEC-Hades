From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:43:03 +0000
Subject: [PATCH] dovi_ccm: the vertical passes of the layer in half floats,
 where exact

The vertical passes that resample the enhancement layer (ETSI GS CCM 001
annex B.3) write integers from 0 up to (140 * (2^EL_bit_depth - 1) + 64) >> 7
(the positive taps of the luma filter, 29 + 111, on the largest code; the
chroma filter takes no more than its largest code): 1119 for a layer of 10
bits, the largest that the composer takes. They were written to 32-bit
float textures (16.6 MB for the luma of a 3840x2160 picture with a layer of
half its size, 8.3 MB for the chroma).

Half floats hold every integer up to 2048 exactly. Where the bound of the
layer is within that and the GPU renders to them, the two textures are of
half floats (8.3 and 4.1 MB), which the horizontal pass reads back as the
same integers; elsewhere, 32-bit floats as before.

Measured on Mesa's zink with fidbench (14 pictures of a profile 7 FEL
stream; the source transport at step-down levels 0, 1 and 2, the converted
one, and with GUI elements): the composed planes and every transport the
same bytes as before. That the half floats are in use: with 4096 added to
what the vertical pass writes and taken off where the horizontal pass
reads it (a mutation), the outputs change with them (half floats are 4
apart from 4096 on) and not with 32-bit floats.

License: LGPL-2.1-or-later, that of libplacebo and of the file changed,
whose notice stays as it is.
---
 src/renderer.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/renderer.c b/src/renderer.c
index 7c88f5b5..bbd283c1 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -1960,6 +1960,9 @@ struct ccm_ctx {
     int el_ratio;           // 0: no residual, 1: EL of the BL's size, 2: half
     int elw, elh;           // the EL picture, in luma samples
     pl_fmt fmt1, fmt2;      // r32f, rg32f
+    // Hades: the output of the vertical passes of the layer, where half floats
+    // hold it exactly (see ccm_half()), or NULL
+    pl_fmt fmt1h, fmt2h;
     pl_tex lut;
     bool rows;              // leave rows out (pl_render_params.active_rows)
     int el_linear;          // pl_render_params.dovi_ccm_el_linear
@@ -2141,7 +2144,18 @@ static pl_tex ccm_el_vertical(struct pass_state *pass, const struct ccm_ctx *x,
              "}                                                          \n", k);
     }
 
-    return ccm_end(pass, sh, luma ? x->fmt1 : x->fmt2, w, h, NULL);
+    // (Hades: in half floats where they hold it exactly)
+    return ccm_end(pass, sh, luma ? PL_DEF(x->fmt1h, x->fmt1) : PL_DEF(x->fmt2h, x->fmt2),
+                   w, h, NULL);
+}
+
+// Hades: a renderable format of n half floats, which hold every integer up to
+// 2048 exactly, or NULL
+static pl_fmt ccm_half(pl_gpu gpu, int n)
+{
+    pl_fmt f = pl_find_fmt(gpu, PL_FMT_FLOAT, n, 16, 16,
+                           PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    return f && f->component_depth[0] == 16 ? f : NULL;
 }
 
 // Annex B.3, the horizontal pass, on the output of the vertical one: an ivec2
@@ -2739,6 +2753,16 @@ static const char *ccm_check(struct pass_state *pass, struct ccm_ctx *x)
             eb->params.format->type != PL_FMT_UNORM || er->params.format->type != PL_FMT_UNORM)
             return "the planes of the enhancement layer do not hold EL_bit_depth codes";
         x->kel = ccm_code_scale(&elf, pp->el_depth);
+        // Hades: the vertical passes of annex B.3 write integers from 0 up to
+        // (140 * (2^EL_bit_depth - 1) + 64) >> 7 (the positive taps of the luma
+        // filter, 29 + 111, on the largest code; the chroma filter takes no
+        // more than its largest code): 1119 for a layer of 10 bits, which half
+        // floats hold exactly, as every integer up to 2048. Where they do not,
+        // or the GPU renders to none, 32-bit floats.
+        if (((140 * ((1 << pp->el_depth) - 1) + 64) >> 7) <= 2048) {
+            x->fmt1h = ccm_half(gpu, 1);
+            x->fmt2h = ccm_half(gpu, 2);
+        }
         x->elw = pl_rect_w(el->crop) > 0 ? (int) roundf(pl_rect_w(el->crop)) : ey->params.w;
         x->elh = pl_rect_h(el->crop) > 0 ? (int) roundf(pl_rect_h(el->crop)) : ey->params.h;
         if (el->crop.x0 || el->crop.y0 || x->elw > ey->params.w || x->elh > ey->params.h)
