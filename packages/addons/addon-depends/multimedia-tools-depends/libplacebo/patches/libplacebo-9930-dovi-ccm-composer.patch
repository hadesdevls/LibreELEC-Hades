+// false, with `out->reason` set, when the clause cannot compose this picture
+// (metadata outside its scope or outside what the shaders evaluate exactly).
+bool pl_dovi_ccm_prepare(struct pl_dovi_ccm_prep *out,
+                         const struct pl_dovi_ccm *ccm);
