+    b->tex[b->num] = tex;
+    b->id[b->num] = sh_desc(sh, (struct pl_shader_desc) {
+        .binding.object = tex,
+        .binding.address_mode = PL_TEX_ADDRESS_CLAMP,
+        .binding.sample_mode = PL_TEX_SAMPLE_NEAREST,
+        .desc = { .name = name, .type = PL_DESC_SAMPLED_TEX },
+    });
+    return b->id[b->num++];
