+        // The coefficient C of term k (k = 0 the constant, then the 7 of each
+        // order) scaled to 27 fractional bits, C' = C * 2^(23 - denom), as
+        //   q = floor(C' / 2^7) modulo 2^32, r = C' - 2^7 floor(C' / 2^7) (0..127),
+        //   f = C' / 2^27 (rounded to a float)
+        uint32_t q[8][PL_DOVI_CCM_TERMS];
+        float r[8][PL_DOVI_CCM_TERMS];
+        float f[8][PL_DOVI_CCM_TERMS];
+    } chroma[2];
+};
