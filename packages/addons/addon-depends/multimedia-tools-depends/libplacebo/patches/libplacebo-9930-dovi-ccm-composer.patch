+    int range[3][2];
+
+    struct pl_dovi_ccm_chroma {
+        int num_pieces;
+        int pivots[7];      // the interior pivots: piece = #{ i : s >= pivots[i] }
+        int mmr_mask;       // bit i: piece i is an MMR mapping
+        int terms;          // 8, 16 or 24 for the highest MMR order 1, 2 or 3;
