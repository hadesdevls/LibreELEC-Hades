+
+static bool ccm_find_channel(const struct pl_frame *frame, int channel,
+                             struct ccm_channel *out)
+{
+    for (int p = 0; p < frame->num_planes; p++) {
+        const struct pl_plane *plane = &frame->planes[p];
+        for (int c = 0; c < plane->components; c++) {
+            if (plane->component_mapping[c] != channel)
+                continue;
+            if (!plane->texture || plane->flipped)
+                return false;
+            out->plane = plane;
+            out->comp = plane->texture->params.format->sample_order[c];
+            return out->comp >= 0 && out->comp < 4;
