+// The composer of ETSI GS CCM 001 V1.1.1, clause 5.4: what its shaders need,
+// made on the CPU from the composing metadata of a picture (pl_dovi_ccm).
+//
+// Everything that depends on one sample of one component is a table, computed
+// here with the integer arithmetic of the clause: the mapping of a polynomial
+// piece (5.4.2.3.2) for every code of the base layer, and the inverse
+// quantization (5.4.3.2) for every code of the resampled enhancement layer.
+// The MMR mapping (5.4.2.3.3) depends on three samples and is evaluated in the
+// shader, exactly: its coefficients are split here for that (see dovi_ccm.c).
+
+#define PL_DOVI_CCM_LUT_W 2048 // entries of a row of the tables
+#define PL_DOVI_CCM_TERMS 24   // the 22 terms of an MMR mapping of order 3, padded to vec4
+
+struct pl_dovi_ccm_prep {
+    uint64_t signature;     // of the pl_dovi_ccm this was made from
+    const char *reason;     // why the picture cannot be composed so, or NULL
+
+    int bl_depth, el_depth, hdr_depth;
+    bool residual;          // the clause adds an inverse-quantized residual
+
+    // rows 0-2: v (5.4.2.3.2) of base layer code s of component c, where the
+    //           piece of s is a polynomial;
+    // rows 3-5: r (5.4.3.2) of resampled enhancement layer code e of
+    //           component c. Exact integers, held as floats.
+    float lut[6][PL_DOVI_CCM_LUT_W];
