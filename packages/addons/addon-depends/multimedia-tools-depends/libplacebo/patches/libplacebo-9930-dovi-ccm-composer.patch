+ */
+
+#include <math.h>
+#include <stdlib.h>
+
+#include "dovi_ccm.h"
+#include "hash.h"
+
+uint64_t pl_dovi_ccm_signature(const struct pl_dovi_ccm *ccm)
+{
+    uint64_t sig = pl_mem_hash(ccm, sizeof(*ccm));
+    return sig ? sig : 1;
+}
+
+// 5.4.2.2. The pseudo-code starts at num_pivots_minus2 + 1, one past the last
+// piece, for a sample at or above the last pivot (code 1023 when that pivot is
+// 1023), which then has no mapping: such a sample takes the last piece, whose
+// input is clamped to the last pivot by 5.4.2.3.2 and 5.4.2.3.3 in any case.
+static int pivot_index(const struct pl_dovi_ccm_curve *cv, int s)
+{
+    const int num_pivots_minus2 = cv->num_pivots - 2;
+    for (int idx = 0; idx < num_pivots_minus2 + 1; idx++) {
+        if (s < cv->pivots[idx + 1])
+            return idx;
+    }
+    return num_pivots_minus2;
+}
+
+// 5.4.2.3.2, polynomial mapping of the sample s of the BL
+static int map_poly(const struct pl_dovi_ccm *ccm,
+                    const struct pl_dovi_ccm_curve *cv, int pivot_idx, int s)
+{
+    const int last = cv->num_pivots - 1;
+    if (s < cv->pivots[0])
+        s = cv->pivots[0];
+    if (s > cv->pivots[last])
+        s = cv->pivots[last];
+
+    int64_t ss = 1, vv = 0;
+    int shift = 20; // 2 * (maximum BL_bit_depth)
+    for (int i = 0; i <= cv->poly_order[pivot_idx]; i++) {
+        vv += cv->poly_coef[pivot_idx][i] * (ss << shift);
+        ss *= s;
+        shift -= ccm->bl_bit_depth;
+    }
+
+    vv = vv < 0 ? 0 : vv;
+    int64_t v = vv >> (4 + ccm->coef_log2_denom);
+    return v > 0xffff ? 0xffff : (int) v;
+}
+
+// 5.4.3.2, NLQ_LINEAR_DZ, for the code e of the resampled EL
+static int nlq_linear_dz(const struct pl_dovi_ccm *ccm, int cmp, int e)
+{
+    const struct pl_dovi_ccm_nlq *q = &ccm->nlq[cmp];
+    const int eld = ccm->el_bit_depth;
+    const int64_t T = q->threshold, S = q->slope, R = q->hdr_in_max;
+    int64_t rr = (int64_t) e - q->offset;
+    if (rr == 0)
+        return 0;
+
+    const int64_t sign = rr < 0 ? -1 : 1;
+    rr *= 2;
+    rr -= sign;
+    rr *= (int64_t) 1 << (10 - eld);
+    int64_t dq = rr * S;
+    dq += T * ((int64_t) 1 << (10 - eld + 1)) * sign;
+    const int64_t RR = R * ((int64_t) 1 << (10 - eld + 1));
+    if (dq > RR)
+        dq = RR;
+    else if (dq < -RR)
+        dq = -RR;
+
+    // arithmetic shift, as the clause has it: floor
+    const int64_t div = (int64_t) 1 << (ccm->coef_log2_denom - 5 - eld);
+    int64_t r = dq / div;
+    if (dq % div && dq < 0)
+        r -= 1;
+    return (int) r;
+}
+
+#define FAIL(why) do { out->reason = (why); return false; } while (0)
+
+bool pl_dovi_ccm_prepare(struct pl_dovi_ccm_prep *out,
+                         const struct pl_dovi_ccm *ccm)
+{
+    const uint64_t sig = pl_dovi_ccm_signature(ccm);
+    if (out->signature == sig)
+        return !out->reason;
+
+    memset(out, 0, sizeof(*out));
+    out->signature = sig;
+
+    if (!ccm->valid)
+        FAIL("the composing metadata is not fixed-point (or was not mapped)");
+
+    // Clause 5.3.2 and annex A, main profile / ETSI profile 1
+    const int d = ccm->coef_log2_denom;
+    out->bl_depth = ccm->bl_bit_depth;
+    out->el_depth = ccm->el_bit_depth;
+    out->hdr_depth = ccm->hdr_bit_depth;
+    out->residual = !ccm->disable_residual;
+    if (out->bl_depth != 8 && out->bl_depth != 10)
+        FAIL("BL_bit_depth is not 8 or 10");
+    if (out->hdr_depth != 10 && out->hdr_depth != 12)
+        FAIL("hdr_bit_depth is not 10 or 12");
+    if (d < 1 || d > 23)
+        FAIL("coefficient_log2_denom is outside 1..23");
+    if (out->residual) {
+        if (out->el_depth != 8 && out->el_depth != 10)
+            FAIL("EL_bit_depth is not 8 or 10");
+        if (d < out->el_depth + 5)
+            FAIL("coefficient_log2_denom is below EL_bit_depth + 5");
+        if (ccm->nlq_method != 0)
+            FAIL("the inverse quantization is not NLQ_LINEAR_DZ");
+    }
+
+    const int smax = (1 << out->bl_depth) - 1;
+    for (int c = 0; c < 3; c++) {
+        const struct pl_dovi_ccm_curve *cv = &ccm->curve[c];
+        if (cv->num_pivots < 2 || cv->num_pivots > 9)
+            FAIL("a component has fewer than 2 or more than 9 pivots");
+        for (int i = 0; i < cv->num_pivots; i++) {
+            if (cv->pivots[i] > smax || (i && cv->pivots[i] <= cv->pivots[i - 1]))
+                FAIL("the pivots are not increasing codes of the BL");
+        }
+        for (int i = 0; i < cv->num_pivots - 1; i++) {
+            switch (cv->mapping_idc[i]) {
+            case 0:
+                if (cv->poly_order[i] < 1 || cv->poly_order[i] > 2)
+                    FAIL("a polynomial is not of order 1 or 2");
+                for (int k = 0; k <= cv->poly_order[i]; k++) {
+                    if (llabs(cv->poly_coef[i][k]) >= (1LL << 40))
+                        FAIL("a polynomial coefficient is out of range");
+                }
+                break;
+            case 1:
+                if (c == 0)
+                    FAIL("the luma has an MMR piece (mapping_idc[0] shall be 0)");
+                if (cv->mmr_order[i] < 1 || cv->mmr_order[i] > 3)
+                    FAIL("an MMR mapping is not of order 1 to 3");
+                break;
+            default:
+                FAIL("an unknown mapping_idc");
+            }
+        }
+        out->range[c][0] = cv->pivots[0];
+        out->range[c][1] = cv->pivots[cv->num_pivots - 1];
+    }
+
+    // The tables of the polynomial pieces, for every code of the BL
+    for (int c = 0; c < 3; c++) {
+        const struct pl_dovi_ccm_curve *cv = &ccm->curve[c];
+        for (int s = 0; s <= smax; s++) {
+            const int idx = pivot_index(cv, s);
+            if (cv->mapping_idc[idx] == 0)
+                out->lut[c][s] = map_poly(ccm, cv, idx, s);
+        }
+    }
+
+    // The tables of the inverse quantization, for every code the resampled EL
+    // can have: below 2^(EL_bit_depth + 1) (the filters of annex B.3 overshoot
+    // a 10-bit code to at most 1406)
+    if (out->residual) {
+        for (int c = 0; c < 3; c++) {
+            for (int e = 0; e < PL_DOVI_CCM_LUT_W; e++)
+                out->lut[3 + c][e] = nlq_linear_dz(ccm, c, e);
+        }
+    }
+
+    // The MMR pieces of the chroma, split for the exact evaluation in the
+    // shader: with C' = C * 2^(23 - d) and the terms tt[k] < 2^20 (tt[0] = 2^20)
+    // of 5.4.2.3.3, v = floor(sum_k C'_k tt[k] / 2^27). The shader has the low
+    // 32 bits of X = sum_k floor(C'_k / 2^7) tt[k] + floor(sum_k r_k tt[k] / 2^7)
+    // (the r_k part is below 22 * 127 * 2^20 < 2^32, exact: the shader sums it in
+    // floats as sum r_k (tt[k] >> 10) * 2^10 + sum r_k (tt[k] & 1023), whose terms
+    // and partial sums are integers below 2^22), and v = floor(X / 2^20)
+    // modulo 4096 from its bits 20..31. A float estimate of sum_k C'_k tt[k] / 2^27
+    // within 2048 of it tells which of those values it is. For
+    // S = sum_k |C'_k| tt[k] / 2^27 <= sum_k |C'_k| 2^20 / 2^27, its error is at
+    // most about 49 * 2^-24 * S in any order of the 24 products and their sums
+    // with each float operation off by at most one ulp (25 * 2^-24 * S when they
+    // round correctly), and 1 more for the floor. This is checked for every
+    // RPU: S < 2^28 keeps the error below 785, well inside 2048; an RPU that can
+    // reach S >= 2^28 for some sample is not composed here (the caller falls
+    // back to the reshaping of libplacebo for that picture).
+    for (int ci = 0; ci < 2; ci++) {
+        const struct pl_dovi_ccm_curve *cv = &ccm->curve[1 + ci];
+        struct pl_dovi_ccm_chroma *ch = &out->chroma[ci];
+        ch->num_pieces = cv->num_pivots - 1;
+        for (int i = 1; i < cv->num_pivots - 1; i++)
+            ch->pivots[i - 1] = cv->pivots[i];
+
+        int max_order = 0;
+        for (int i = 0; i < ch->num_pieces; i++) {
+            if (cv->mapping_idc[i] != 1)
+                continue;
+            ch->mmr_mask |= 1 << i;
+            max_order = PL_MAX(max_order, cv->mmr_order[i]);
+
+            int64_t coef[PL_DOVI_CCM_TERMS] = { cv->mmr_constant[i] };
+            for (int o = 0; o < cv->mmr_order[i]; o++) {
+                for (int j = 0; j < 7; j++)
+                    coef[1 + 7 * o + j] = cv->mmr_coef[i][o][j];
+            }
+
+            double bound = 0.0;
+            for (int k = 0; k < PL_DOVI_CCM_TERMS; k++) {
+                if (llabs(coef[k]) >= (1LL << 40))
+                    FAIL("an MMR coefficient is out of range");
+                const int64_t cs = coef[k] * ((int64_t) 1 << (23 - d));
+                const int64_t r = ((cs % 128) + 128) % 128;
+                const int64_t q = (cs - r) / 128;
+                ch->q[i][k] = (uint32_t) (uint64_t) q;
+                ch->r[i][k] = (float) r;
+                ch->f[i][k] = (float) ((double) cs / 134217728.0);
+                bound += fabs((double) cs) * 1048576.0 / 134217728.0;
+            }
+            if (bound >= 268435456.0)
+                FAIL("the MMR coefficients exceed what the shader evaluates exactly");
+        }
+        ch->terms = max_order * 8; // 8, 16, 24 terms (7 per order and the constant, padded)
+    }
+
+    out->reason = NULL;
+    return true;
+}
