+          "           + 2456 * DV_ELV(0) + 2456 * DV_ELV(1) - 524 * DV_ELV(2) \n"
+          "           + 94 * DV_ELV(3) + 22 * DV_ELV(4) + 2048) >> 12;      \n"
+          "        e = clamp(e, 0, 65535);                                  \n"
+          "    }                                                            \n"
+          "#undef DV_ELV                                                    \n"
+          "    return e;                                                    \n"
+          "}                                                                \n",
+          fn, tex, last);
+    return fn;
+}
+
+// h of 5.4.3.3 from v + r (`in`, an int or ivec2), into `out` as h / 2^hdr_bit_depth
+// (`type`: float or vec2); the division by a power of two is exact
+static void ccm_output(pl_shader sh, const struct pl_dovi_ccm_prep *pp,
+                       const char *in, const char *out, const char *type)
+{
+    const int d = pp->hdr_depth;
+    GLSL("%s = %s(clamp((%s + %d) >> %d, 0, %d)) / %d.0; \n",
+         out, type, in, 1 << (15 - d), 16 - d, (1 << d) - 1, 1 << d);
+}
+
+static pl_tex ccm_luma(struct pass_state *pass, const struct ccm_ctx *x,
+                       pl_tex elv, int w, int h)
+{
+    const struct pl_dovi_ccm_prep *pp = x->prep;
+    pl_shader sh = ccm_begin(pass, w, h, "DV composer: luma (CCM 001 5.4)",
+                             x->luma_rows, x->rows);
+    if (!sh)
+        return NULL;
+
+    struct ccm_binds binds = {0};
+    ident_t bly = ccm_code(sh, &binds, &x->bl[0], x->kbl, "dv_bl_y");
+    ident_t lut = ccm_tex(sh, &binds, x->lut, "dv_lut");
+    GLSL("int s = clamp("$"(p), 0, %d);                       \n"
+         "int v = int(texelFetch("$", ivec2(s, 0), 0).x);     \n",
+         bly, (1 << pp->bl_depth) - 1, lut);
+
+    if (x->el_ratio) {
+        if (x->el_ratio == 2) {
+            ident_t hf = ccm_el_horizontal(sh, &binds, elv, x->elw - 1);
+            GLSL("int e = "$"(p).x; \n", hf);
+        } else {
+            ident_t ely = ccm_code(sh, &binds, &x->el[0], x->kel, "dv_el_y");
+            GLSL("int e = "$"(p); \n", ely);
+        }
+        GLSL("v += int(texelFetch("$", ivec2(clamp(e, 0, %d), 3), 0).x); \n",
+             lut, PL_DOVI_CCM_LUT_W - 1);
+    }
+
+    ccm_output(sh, pp, "v", "color.x", "float");
+    return ccm_end(pass, sh, x->fmt1, w, h);
+}
+
+// 5.4.2.3.3 for the chroma component ci (0 = Cb, 1 = Cr), into v[ci]: the
+// piece of the sample s = sc[ci], then its MMR mapping (exact, see dovi_ccm.c)
+// or its polynomial mapping (table)
+static void ccm_mmr(struct pass_state *pass, pl_shader sh,
+                    const struct ccm_ctx *x, int ci, ident_t lut)
+{
+    const struct pl_dovi_ccm_chroma *ch = &x->prep->chroma[ci];
+    GLSL("{                \n"
+         "int s = sc[%d];  \n"
+         "int idx = 0;     \n", ci);
+    if (ch->num_pieces > 1) {
+        // (an array of one would be declared as a scalar: at least two)
+        int *pivots = pl_alloc(pass->tmp, 8 * sizeof(int));
+        for (int i = 0; i < 8; i++)
+            pivots[i] = i < ch->num_pieces - 1 ? ch->pivots[i] : INT32_MAX;
+        ident_t piv = sh_var(sh, (struct pl_shader_var) {
+            .var = {
+                .name = "dv_pivots", .type = PL_VAR_SINT,
+                .dim_v = 1, .dim_m = 1, .dim_a = PL_MAX(ch->num_pieces - 1, 2),
+            },
+            .data = pivots,
+        });
+        GLSL("for (int i = 0; i < %d; i++) \n"
+             "    idx += int(s >= "$"[i]);  \n", ch->num_pieces - 1, piv);
+    }
+
+    if (!ch->terms) {
+        GLSL("v[%d] = int(texelFetch("$", ivec2(s, %d), 0).x); \n"
+             "} \n", ci, lut, 1 + ci);
+        return;
+    }
+
+    const int nq = ch->terms / 4, n = ch->num_pieces * nq;
+    uint32_t *q = pl_alloc(pass->tmp, n * 4 * sizeof(uint32_t));
+    float *r = pl_alloc(pass->tmp, n * 4 * sizeof(float));
+    float *f = pl_alloc(pass->tmp, n * 4 * sizeof(float));
+    for (int i = 0; i < ch->num_pieces; i++) {
+        memcpy(&q[i * nq * 4], ch->q[i], nq * 4 * sizeof(uint32_t));
+        memcpy(&r[i * nq * 4], ch->r[i], nq * 4 * sizeof(float));
+        memcpy(&f[i * nq * 4], ch->f[i], nq * 4 * sizeof(float));
+    }
+
+    ident_t vq = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmr_q", .type = PL_VAR_UINT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = q,
+    });
+    ident_t vr = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmr_r", .type = PL_VAR_FLOAT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = r,
+    });
+    ident_t vf = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmr_f", .type = PL_VAR_FLOAT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = f,
+    });
+
+    bool all_mmr = ch->mmr_mask == (1 << ch->num_pieces) - 1;
+    if (!all_mmr)
+        GLSL("if (((%d >> idx) & 1) != 0) { \n", ch->mmr_mask);
+    // X = sum floor(C'/2^7) tt + floor(sum (C' mod 2^7) tt / 2^7), modulo 2^32;
+    // v = floor(X / 2^20) is known modulo 4096 from its bits 20..31, and the
+    // float estimate (within 2048 of it) picks the one it is. The second sum is
+    // exact in floats: the terms r * (tt >> 10) and r * (tt & 1023), r < 2^7,
+    // and their sums are integers below 2^22.
+    GLSL("{                                                      \n"
+         "int base = idx * %d;                                   \n"
+         "uint X = 0u;                                           \n"
+         "float rh = 0.0, rl = 0.0, est = 0.0;                   \n"
+         "for (int k = 0; k < %d; k++) {                         \n"
+         "    uvec4 a = "$"[base + k] * tt[k];                   \n"
+         "    X += a.x + a.y + a.z + a.w;                        \n"
+         "    rh += dot("$"[base + k], tth[k]);                  \n"
+         "    rl += dot("$"[base + k], ttl[k]);                  \n"
+         "    est += dot("$"[base + k], ttf[k]);                 \n"
+         "}                                                      \n"
+         "X += ((uint(rh) << 10u) + uint(rl)) >> 7u;             \n"
+         "int m = int(X >> 20u);                                 \n"
+         "int vv = m + 4096 * int(floor((est - float(m)) * (1.0/4096.0) + 0.5)); \n"
+         "v[%d] = clamp(vv, 0, 65535);                           \n"
+         "}                                                      \n",
+         nq, nq, vq, vr, vr, vf, ci);
+    if (!all_mmr) {
+        GLSL("} else {                                               \n"
+             "    v[%d] = int(texelFetch("$", ivec2(s, %d), 0).x);   \n"
+             "}                                                      \n",
+             ci, lut, 1 + ci);
+    }
+    GLSL("} \n");
+}
+
+static pl_tex ccm_chroma(struct pass_state *pass, const struct ccm_ctx *x,
+                         pl_tex elv, int w, int h)
+{
+    const struct pl_dovi_ccm_prep *pp = x->prep;
+    pl_shader sh = ccm_begin(pass, w, h, "DV composer: chroma (CCM 001 5.4)",
+                             x->chroma_rows, x->rows);
+    if (!sh)
+        return NULL;
+
+    const pl_tex ly = x->bl[0].plane->texture;
+    struct ccm_binds binds = {0};
+    ident_t bly = ccm_code(sh, &binds, &x->bl[0], x->kbl, "dv_bl_y");
+    ident_t blb = ccm_code(sh, &binds, &x->bl[1], x->kbl, "dv_bl_cb");
+    ident_t blr = ccm_code(sh, &binds, &x->bl[2], x->kbl, "dv_bl_cr");
+    ident_t lut = ccm_tex(sh, &binds, x->lut, "dv_lut");
+
+    // 5.4.2.3.3: s*_{i,j} = (((s_{2i-1,2j} + 2 s_{2i,2j} + s_{2i+1,2j} + 2) >> 2)
+    //   + ((s_{2i-1,2j+1} + 2 s_{2i,2j+1} + s_{2i+1,2j+1} + 2) >> 2) + 1) >> 1,
+    // i the column (a "(PicWidth)x(PicHeight)" block is PicWidth columns by
+    // PicHeight rows, clause 3.1), edges by replication
+    GLSL("ivec3 lx = clamp(ivec3(2*p.x - 1, 2*p.x, 2*p.x + 1), 0, %d);          \n"
+         "ivec2 ly = clamp(ivec2(2*p.y, 2*p.y + 1), 0, %d);                     \n"
+         "int da = ("$"(ivec2(lx.x, ly.x)) + 2*"$"(ivec2(lx.y, ly.x))           \n"
+         "          + "$"(ivec2(lx.z, ly.x)) + 2) >> 2;                         \n"
+         "int db = ("$"(ivec2(lx.x, ly.y)) + 2*"$"(ivec2(lx.y, ly.y))           \n"
+         "          + "$"(ivec2(lx.z, ly.y)) + 2) >> 2;                         \n"
+         "int s0 = (da + db + 1) >> 1;                                          \n"
+         "ivec2 sc = clamp(ivec2("$"(p), "$"(p)), 0, %d);                       \n"
+         "ivec2 v = ivec2(0);                                                   \n",
+         ly->params.w - 1, ly->params.h - 1, bly, bly, bly, bly, bly, bly,
+         blb, blr, (1 << pp->bl_depth) - 1);
+
+    const int terms = PL_MAX(pp->chroma[0].terms, pp->chroma[1].terms);
+    if (terms) {
+        // The terms tt[] of 5.4.2.3.3, all below 2^20 but tt[0] = 2^20. The
+        // products of two of them are shifted down with
+        //   (a*b) >> 20 = ((a*bh) >> 10) + ((((a*bh) & 1023) << 10) + a*bl) >> 20
+        // for b = bh * 2^10 + bl, exact in 32 bits.
+        ident_t mul = sh_fresh(sh, "dv_mul20");
+        GLSLH("uint "$"(uint a, uint b) {                             \n"
+              "    uint p1 = a * (b >> 10u), p0 = a * (b & 1023u);    \n"
+              "    return (p1 >> 10u) + ((((p1 & 1023u) << 10u) + p0) >> 20u); \n"
+              "}                                                      \n", mul);
+        const int sh1 = 20 - pp->bl_depth, sh2 = 20 - 2 * pp->bl_depth;
+        ident_t lo = sh_var(sh, (struct pl_shader_var) {
+            .var = pl_var_ivec3("dv_lo"),
+            .data = &(int[3]) { pp->range[0][0], pp->range[1][0], pp->range[2][0] },
+        });
+        ident_t hi = sh_var(sh, (struct pl_shader_var) {
+            .var = pl_var_ivec3("dv_hi"),
+            .data = &(int[3]) { pp->range[0][1], pp->range[1][1], pp->range[2][1] },
+        });
+        GLSL("uvec3 u = uvec3(clamp(ivec3(s0, sc), "$", "$"));                  \n"
+             "uvec4 tt[%d];                                                     \n"
+             "tt[0] = uvec4(1048576u, u << %du);                                \n"
+             "tt[1] = uvec4(uvec3(u.x*u.y, u.x*u.z, u.y*u.z) << %du, 0u);       \n"
+             "tt[1].w = "$"(tt[1].x, tt[0].w);                                  \n",
+             lo, hi, terms / 4, sh1, sh2, mul);
+        if (terms >= 16) {
+            GLSL("tt[2] = uvec4((u * u) << %du, "$"(tt[1].x, tt[1].x));         \n"
+                 "tt[3] = uvec4("$"(tt[1].y, tt[1].y), "$"(tt[1].z, tt[1].z),   \n"
+                 "              "$"(tt[1].w, tt[1].w), 0u);                     \n",
+                 sh2, mul, mul, mul, mul);
+        }
+        if (terms >= 24) {
+            GLSL("tt[3].w = "$"(tt[0].y, tt[2].x);                              \n"
+                 "tt[4] = uvec4("$"(tt[0].z, tt[2].y), "$"(tt[0].w, tt[2].z),   \n"
+                 "              "$"(tt[1].x, tt[2].w), "$"(tt[1].y, tt[3].x));  \n"
+                 "tt[5] = uvec4("$"(tt[1].z, tt[3].y), "$"(tt[1].w, tt[3].z), 0u, 0u); \n",
+                 mul, mul, mul, mul, mul, mul, mul);
+        }
+        GLSL("vec4 ttf[%d], tth[%d], ttl[%d];     \n"
+             "for (int k = 0; k < %d; k++) {      \n"
+             "    ttf[k] = vec4(tt[k]);           \n"
+             "    tth[k] = vec4(tt[k] >> 10u);    \n"
+             "    ttl[k] = vec4(tt[k] & 1023u);   \n"
+             "}                                   \n",
+             terms / 4, terms / 4, terms / 4, terms / 4);
+    }
+
+    for (int ci = 0; ci < 2; ci++)
+        ccm_mmr(pass, sh, x, ci, lut);
+
+    if (x->el_ratio) {
+        if (x->el_ratio == 2) {
+            ident_t hf = ccm_el_horizontal(sh, &binds, elv, (x->elw + 1) / 2 - 1);
+            GLSL("ivec2 e = "$"(p); \n", hf);
+        } else {
+            ident_t elb = ccm_code(sh, &binds, &x->el[1], x->kel, "dv_el_cb");
+            ident_t elr = ccm_code(sh, &binds, &x->el[2], x->kel, "dv_el_cr");
+            GLSL("ivec2 e = ivec2("$"(p), "$"(p)); \n", elb, elr);
+        }
+        GLSL("e = clamp(e, 0, %d);                                     \n"
+             "v += ivec2(int(texelFetch("$", ivec2(e.x, 4), 0).x),      \n"
+             "           int(texelFetch("$", ivec2(e.y, 5), 0).x));     \n",
+             PL_DOVI_CCM_LUT_W - 1, lut, lut);
+    }
+
+    ccm_output(sh, pp, "v", "color.xy", "vec2");
+    return ccm_end(pass, sh, x->fmt2, w, h);
+}
+
+// Why the image cannot be composed so (NULL: it can); fills `x`
+static const char *ccm_check(struct pass_state *pass, struct ccm_ctx *x)
+{
+    const struct pl_render_params *params = pass->params;
+    const struct pl_frame *image = &pass->image;
+    const struct pl_dovi_ccm_prep *pp = x->prep;
+    const struct pl_dovi_metadata *dovi = image->repr.dovi;
+    pl_gpu gpu = pass->rr->gpu;
+
+    const struct pl_glsl_version glsl = gpu->glsl;
+    if (glsl.gles ? glsl.version < 300 : glsl.version < 130)
+        return "GLSL without integer arithmetic";
+    if (image->num_planes < 2 || image->num_planes > 3)
+        return "not a planar YCbCr image";
+    for (int c = 0; c < 3; c++) {
+        if (!ccm_find_channel(image, c, &x->bl[c]))
+            return "a component of the base layer is missing";
+    }
+    pl_tex y = x->bl[0].plane->texture, cb = x->bl[1].plane->texture,
+           cr = x->bl[2].plane->texture;
+    const int cw = (y->params.w + 1) / 2, chh = (y->params.h + 1) / 2;
+    if (cb->params.w != cw || cb->params.h != chh || cr->params.w != cw || cr->params.h != chh)
+        return "the base layer is not 4:2:0 (clause 5.2.2 b)";
+    if (image->field != PL_FIELD_NONE)
+        return "an interlaced picture";
+    if (image->film_grain.type != PL_FILM_GRAIN_NONE)
+        return "film grain to apply to the base layer";
+    if (image->repr.bits.color_depth != pp->bl_depth ||
+        y->params.format->type != PL_FMT_UNORM ||
+        cb->params.format->type != PL_FMT_UNORM || cr->params.format->type != PL_FMT_UNORM)
+        return "the planes do not hold BL_bit_depth codes";
+    x->kbl = ccm_code_scale(image, pp->bl_depth);
+
+    x->fmt1 = pl_find_fmt(gpu, PL_FMT_FLOAT, 1, 32, 32,
+                          PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    x->fmt2 = pl_find_fmt(gpu, PL_FMT_FLOAT, 2, 32, 32, PL_FMT_CAP_SAMPLEABLE |
+                          PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_LINEAR);
+    if (!x->fmt2) {
+        x->fmt2 = pl_find_fmt(gpu, PL_FMT_FLOAT, 2, 32, 32,
+                              PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    }
+    if (!x->fmt1 || !x->fmt2)
+        return "no 32-bit floating-point render targets";
+
+    // the uniforms of the chroma pass: the MMR coefficients, at most
+    int comps = 64;
+    for (int ci = 0; ci < 2; ci++)
+        comps += pp->chroma[ci].num_pieces * pp->chroma[ci].terms * 3 + 8;
+    if (comps > gpu->limits.max_variable_comps)
+        return "more MMR pieces than the shader has uniforms for";
+
+    x->el_ratio = 0;
+    const struct pl_frame *el = image->enhancement_layer;
+    if (el && dovi->nlq_active && pp->residual) {
+        struct pl_frame elf = *el;
+        fix_frame(&elf);
+        for (int c = 0; c < 3; c++) {
+            if (!ccm_find_channel(el, c, &x->el[c]))
+                return "a component of the enhancement layer is missing";
+        }
+        pl_tex ey = x->el[0].plane->texture, eb = x->el[1].plane->texture,
+               er = x->el[2].plane->texture;
+        if (elf.repr.bits.color_depth != pp->el_depth ||
+            ey->params.format->type != PL_FMT_UNORM ||
+            eb->params.format->type != PL_FMT_UNORM || er->params.format->type != PL_FMT_UNORM)
+            return "the planes of the enhancement layer do not hold EL_bit_depth codes";
+        x->kel = ccm_code_scale(&elf, pp->el_depth);
+        x->elw = pl_rect_w(el->crop) > 0 ? (int) roundf(pl_rect_w(el->crop)) : ey->params.w;
+        x->elh = pl_rect_h(el->crop) > 0 ? (int) roundf(pl_rect_h(el->crop)) : ey->params.h;
+        if (el->crop.x0 || el->crop.y0 || x->elw > ey->params.w || x->elh > ey->params.h)
+            return "the enhancement layer is cropped";
+        const int ecw = (ey->params.w + 1) / 2, ech = (ey->params.h + 1) / 2;
+        if (eb->params.w != ecw || eb->params.h != ech || er->params.w != ecw || er->params.h != ech)
+            return "the enhancement layer is not 4:2:0";
+        if (ey->params.w == y->params.w && ey->params.h == y->params.h) {
+            x->el_ratio = 1;
+        } else if (2 * ey->params.w >= y->params.w && 2 * ey->params.w <= y->params.w + 1 &&
+                   2 * ey->params.h >= y->params.h && 2 * ey->params.h <= y->params.h + 1) {
+            x->el_ratio = 2;
+        } else {
+            return "the enhancement layer is neither the base layer's size nor half of it";
+        }
+    }
+
+    // Rows that nothing reads: only where a picture row is a row of the target
+    const int y0 = params->active_rows[0], y1 = params->active_rows[1];
+    x->rows = y->params.h == 2160 && y0 >= 0 && y1 <= 2160 && y0 < y1 &&
+              (y0 || y1 != 2160) && !pass->rotation &&
+              image->crop.x0 == 0 && image->crop.y0 == 0 &&
+              image->crop.x1 == y->params.w && image->crop.y1 == y->params.h &&
+              pass->dst_rect.y0 == 0 && pass->dst_rect.y1 == 2160 &&
+              pass->dst_rect.x0 == 0 && pass->dst_rect.x1 == y->params.w;
+    if (x->rows) {
+        // the luma: those rows; the chroma: the rows the scaler of the chroma
+        // reads for them (filter radius 3, an offset of up to a chroma row)
+        x->luma_rows[0] = y0;
+        x->luma_rows[1] = y1;
+        x->chroma_rows[0] = PL_MAX(y0 / 2 - 6, 0);
+        x->chroma_rows[1] = PL_MIN((y1 + 1) / 2 + 6, chh);
+    }
+
+    return NULL;
+}
+
+// Logs each reason not to compose (static strings) once a stream, and composing
+// once a stream, however often the pictures of the stream change between them.
+static void ccm_say(pl_renderer rr, struct dovi_ccm_state *st, const char *why)
+{
+    if (!why) {
+        if (!st->said_composed)
+            PL_INFO(rr, "Dolby Vision: composed as ETSI GS CCM 001 clause 5.4 does");
+        st->said_composed = true;
+        return;
+    }
+
+    for (int i = 0; i < st->num_said; i++) {
+        if (st->said[i] == why)
+            return;
+    }
+    PL_WARN(rr, "Dolby Vision: a picture is not composed as ETSI GS CCM 001 does "
+            "(%s); it is composed by the reshaping of libplacebo", why);
+    if (st->num_said < PL_ARRAY_SIZE(st->said))
+        st->said[st->num_said++] = why;
+}
+
+// Composes the image (ETSI GS CCM 001 clause 5.4) and puts the composed planes
+// in place of its planes. False, with the image untouched, when it does not.
+static bool pass_dovi_ccm(struct pass_state *pass)
+{
+    pl_renderer rr = pass->rr;
+    struct pl_frame *image = &pass->image;
+    const struct pl_dovi_metadata *dovi = image->repr.dovi;
+    if (!pass->params->dovi_ccm || image->repr.sys != PL_COLOR_SYSTEM_DOLBYVISION ||
+        !dovi || (rr->errors & PL_RENDER_ERR_DOVI_COMPOSER))
+        return false;
+
+    if (!rr->dovi_ccm)
+        rr->dovi_ccm = pl_zalloc_ptr(rr, rr->dovi_ccm);
+    struct dovi_ccm_state *st = rr->dovi_ccm;
+    struct ccm_ctx x = { .prep = &st->prep };
+    const char *why = NULL;
+    if (!pl_dovi_ccm_prepare(&st->prep, &dovi->ccm))
+        why = st->prep.reason;
+    if (!why)
+        why = ccm_check(pass, &x);
+    ccm_say(rr, st, why);
+    if (why)
+        return false;
+
+    const struct pl_dovi_ccm_prep *pp = &st->prep;
+    pl_tex y = x.bl[0].plane->texture, cb = x.bl[1].plane->texture;
+    pl_tex ly = NULL, lc = NULL, ev[2] = {0};
+
+    // the tables
+    if (!st->lut || st->lut_signature != pp->signature) {
