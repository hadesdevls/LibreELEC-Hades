From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:34:27 +0000
Subject: [PATCH] opengl: GL_RGBA32UI, sampleable

The OpenGL backend had no 32-bit integer format (its list of them is left
as a TODO). GL_RGBA32UI is a sized internal format of OpenGL 3.0 and of
OpenGL ES 3.0, sampleable with texelFetch() through a usampler2D, with no
filtering. It is added as "rgba32u", sampleable only, as libplacebo-9946
added GL_RGB10_A2: for the table of exact integers that the composer of
ETSI GS CCM 001 can read (libplacebo-9977). Nothing that libplacebo looks
for itself asks for such a format; the other 32-bit integer formats stay
out as they were.

License: LGPL-2.1-or-later, that of libplacebo and of the file changed,
whose notice stays as it is.
---
 src/opengl/formats.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/opengl/formats.c b/src/opengl/formats.c
index 76c177ed..a30d9bd1 100644
--- a/src/opengl/formats.c
+++ b/src/opengl/formats.c
@@ -216,6 +216,14 @@ static const struct gl_format formats_uint[] = {
     {GL_RGBA16UI,       RGBAI, U16, FMT("rgba16u", 16, UINT, S|F|V)},
 };
 
+// Hades: four 32-bit unsigned integers, sampleable (texelFetch() of a
+// usampler2D), for a table of exact integers (the MMR table of the composer
+// of ETSI GS CCM 001, libplacebo-9977). OpenGL 3.0 and OpenGL ES 3.0 have it;
+// the other 32-bit integer formats below stay out as they were.
+static const struct gl_format formats_uint32[] = {
+    {GL_RGBA32UI,       RGBAI, U32, FMT("rgba32u", 32, UINT, S)},
+};
+
 /* TODO
     {GL_R32UI,          RI,    U32, FMT("r32u",    32, UINT)},
     {GL_RG32UI,         RGI,   U32, FMT("rg32u",   32, UINT)},
@@ -510,6 +518,7 @@ bool gl_setup_formats(struct pl_gpu_t *gpu)
         DO_FORMATS(formats_float16);
         DO_FORMATS(formats_half16);
         DO_FORMATS(formats_uint);
+        DO_FORMATS(formats_uint32);
         DO_FORMATS(formats_rgb10a2);
         goto done;
     }
@@ -550,6 +559,7 @@ bool gl_setup_formats(struct pl_gpu_t *gpu)
         if (pl_opengl_has_ext(p->gl, "GL_EXT_texture_format_BGRA8888"))
             DO_FORMATS(formats_bgra_gles);
         DO_FORMATS(formats_uint);
+        DO_FORMATS(formats_uint32);
         DO_FORMATS(formats_rgb10a2);
         if (p->gles_ver >= 32 || pl_opengl_has_ext(p->gl, "GL_EXT_color_buffer_float")) {
             DO_FORMATS(formats_float32_gles_fbo);
