From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:23:18 +0000
Subject: [PATCH] opengl: GL_RGB10_A2 as a texture format

OpenGL 3.0 and OpenGL ES 3.0 render to and filter textures of
GL_RGB10_A2 in their core, but the OpenGL backend did not offer the
format: a caller could neither draw into a texture of 10-bit fixed-point
components in 32 bits per texel nor wrap one. It is added as "rgb10a2"
(the name of the Vulkan backend's format of the same layout, and of its
DRM fourcc), UNORM with components of 10, 10, 10 and 2 bits, sampleable,
linear and renderable, with a host representation of one 32-bit word
per texel (GL_UNSIGNED_INT_2_10_10_10_REV).

A query of a format finds it only where it asks for at most 2 bits of
alpha: the renderer's own queries do not (measured: the same bytes in
every drawing of the render test of Kodi's Dolby Vision bridge on Mesa's
zink, with and without it).

Kodi's bridge keeps a picture for output as HDR10 in it, as the 10-bit
codes of the window it is copied to: a quarter of the memory of a float
texture, and of what each copy reads.

License: LGPL-2.1-or-later, that of libplacebo and of the file changed,
whose notice stays as it is.
---
 src/opengl/formats.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/opengl/formats.c b/src/opengl/formats.c
index 9f24cae6..76c177ed 100644
--- a/src/opengl/formats.c
+++ b/src/opengl/formats.c
@@ -50,6 +50,7 @@ enum {
     I32   = GL_INT,
     FLT   = GL_FLOAT,
     HALF  = GL_HALF_FLOAT,
+    U2101010 = GL_UNSIGNED_INT_2_10_10_10_REV,
 
     // Component aliases
     R     = GL_RED,
@@ -98,6 +99,19 @@ static const struct gl_format formats_bgra8[] = {
     }},
 };
 
+// Hades: packed 10-bit RGB with 2 bits of alpha, which OpenGL 3.0 and GLES 3.0
+// render to and filter in their core. Its host representation is one 32-bit
+// word per texel, red in the low bits (GL_UNSIGNED_INT_2_10_10_10_REV).
+static const struct gl_format formats_rgb10a2[] = {
+    {GL_RGB10_A2,       RGBA,  U2101010, {
+        .name               = "rgb10a2",
+        .type               = PL_FMT_UNORM,
+        .caps               = S|L|F,
+        .sample_order       = {0, 1, 2, 3},
+        .component_depth    = {10, 10, 10, 2},
+    }},
+};
+
 // Basic 16-bit formats, excluding rgb16 (special cased below)
 static const struct gl_format formats_norm16[] = {
     {GL_R16,            R,     U16, FMT("r16",     16, UNORM, S|L|F|V)},
@@ -304,6 +318,9 @@ static void add_format(pl_gpu pgpu, const struct gl_format *gl_fmt)
     case GL_FLOAT:
         size = 4;
         break;
+    case GL_UNSIGNED_INT_2_10_10_10_REV:
+        size = 0; // Hades: packed, see below
+        break;
     default:
         pl_unreachable();
     }
@@ -313,6 +330,13 @@ static void add_format(pl_gpu pgpu, const struct gl_format *gl_fmt)
     fmt->texel_align = 1;
     for (int i = 0; i < fmt->num_components; i++)
         fmt->host_bits[i] = size * 8;
+    if (gl_fmt->type == GL_UNSIGNED_INT_2_10_10_10_REV) {
+        // Hades: one 32-bit word, components of the depths of the format
+        fmt->texel_size = 4;
+        fmt->texel_align = 4;
+        for (int i = 0; i < fmt->num_components; i++)
+            fmt->host_bits[i] = fmt->component_depth[i];
+    }
 
     // Compute internal size by summing up the depth
     int ibits = 0;
@@ -486,6 +510,7 @@ bool gl_setup_formats(struct pl_gpu_t *gpu)
         DO_FORMATS(formats_float16);
         DO_FORMATS(formats_half16);
         DO_FORMATS(formats_uint);
+        DO_FORMATS(formats_rgb10a2);
         goto done;
     }
 
@@ -525,6 +550,7 @@ bool gl_setup_formats(struct pl_gpu_t *gpu)
         if (pl_opengl_has_ext(p->gl, "GL_EXT_texture_format_BGRA8888"))
             DO_FORMATS(formats_bgra_gles);
         DO_FORMATS(formats_uint);
+        DO_FORMATS(formats_rgb10a2);
         if (p->gles_ver >= 32 || pl_opengl_has_ext(p->gl, "GL_EXT_color_buffer_float")) {
             DO_FORMATS(formats_float32_gles_fbo);
             DO_FORMATS(formats_float16_fbo);
