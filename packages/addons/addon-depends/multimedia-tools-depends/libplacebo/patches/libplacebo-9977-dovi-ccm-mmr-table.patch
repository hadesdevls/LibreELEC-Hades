 src/dovi_ccm.c                    |  57 ++++++++
 src/dovi_ccm.h                    |  15 ++
 src/include/libplacebo/renderer.h |  16 +++
 src/renderer.c                    | 231 ++++++++++++++++++++++++++----
 4 files changed, 289 insertions(+), 30 deletions(-)

diff --git a/src/dovi_ccm.c b/src/dovi_ccm.c
index 62a239e4..aeb8a9d6 100644
--- a/src/dovi_ccm.c
+++ b/src/dovi_ccm.c
@@ -17,6 +17,7 @@
 
 #include <math.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "dovi_ccm.h"
 #include "hash.h"
@@ -94,6 +95,62 @@ static int nlq_linear_dz(const struct pl_dovi_ccm *ccm, int cmp, int e)
     return (int) r;
 }
 
+// Hades: floor(a b / 2^20), as the shader's dv_mul20() has it (exact)
+static uint32_t mul20(uint32_t a, uint32_t b)
+{
+    return (uint32_t) (((uint64_t) a * b) >> 20);
+}
+
+// Hades: see dovi_ccm.h. Each entry is what the shader adds term by term for
+// the same sample, so the shader's sums are the same: q modulo 2^32 (sums of
+// products modulo 2^32 in any grouping), the two r sums as the same integers
+// (every partial sum of them is an integer below 2^22, exact in floats). The
+// estimate differs from the shader's by the rounding of a different order of
+// operations, fewer of them in floats: within the bound that dovi_ccm_prepare()
+// checks below (S < 2^28 keeps it within 785 of the true value, and 2048
+// tells the value).
+void pl_dovi_ccm_mmr_table(const struct pl_dovi_ccm_prep *pp, uint32_t *out)
+{
+    const int w = 1 << pp->bl_depth;
+    const int sh1 = 20 - pp->bl_depth, sh2 = 20 - 2 * pp->bl_depth;
+    memset(out, 0, (size_t) PL_DOVI_CCM_MMRT_ROWS * w * 4 * sizeof(*out));
+    for (int ci = 0; ci < 2; ci++) {
+        const struct pl_dovi_ccm_chroma *ch = &pp->chroma[ci];
+        for (int i = 0; i < ch->num_pieces; i++) {
+            if (!(ch->mmr_mask & (1 << i)))
+                continue;
+            for (int a = 0; a < 3; a++) {
+                uint32_t *row = out + (size_t) ((ci * 8 + i) * 3 + a) * w * 4;
+                for (int s = 0; s < w; s++) {
+                    // the terms of this sample as the shader makes them
+                    // (ccm_chroma(): u << sh1, (u * u) << sh2, and their
+                    // product by dv_mul20()), and the constant term
+                    const uint32_t t1 = (uint32_t) s << sh1;
+                    const uint32_t t2 = ((uint32_t) s * (uint32_t) s) << sh2;
+                    const uint32_t tt[4] = { 1u << 20, t1, t2, mul20(t1, t2) };
+                    const int ks[4] = { a == 0 ? 0 : -1, 1 + a, 8 + a, 15 + a };
+                    uint32_t q = 0;
+                    double rh = 0.0, rl = 0.0, est = 0.0;
+                    for (int n = 0; n < 4; n++) {
+                        const int k = ks[n];
+                        if (k < 0 || k >= ch->terms)
+                            continue;
+                        q += ch->q[i][k] * tt[n];
+                        rh += (double) ch->r[i][k] * (double) (tt[n] >> 10);
+                        rl += (double) ch->r[i][k] * (double) (tt[n] & 1023);
+                        est += (double) ch->f[i][k] * (double) tt[n];
+                    }
+                    const float frh = (float) rh, frl = (float) rl, fest = (float) est;
+                    row[4 * s + 0] = q;
+                    memcpy(&row[4 * s + 1], &frh, sizeof(frh));
+                    memcpy(&row[4 * s + 2], &frl, sizeof(frl));
+                    memcpy(&row[4 * s + 3], &fest, sizeof(fest));
+                }
+            }
+        }
+    }
+}
+
 #define FAIL(why) do { out->reason = (why); return false; } while (0)
 
 bool pl_dovi_ccm_prepare(struct pl_dovi_ccm_prep *out,
