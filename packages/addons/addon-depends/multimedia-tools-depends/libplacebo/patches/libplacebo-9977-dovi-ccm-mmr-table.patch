+// Hades: the MMR mapping of component ci with the table of the terms of one
+// sample (pl_render_params.dovi_ccm_mmr_table, pl_dovi_ccm_mmr_table()): the
+// three entries of its piece at u.x, u.y and u.z (the samples, clamped as for
+// every term), and the terms of two or three samples, dvc[] of ccm_chroma(),
+// with their coefficients, four a vec4 for each order. Then the same sums as
+// ccm_mmr() makes of all of them: the same X modulo 2^32, the same integers in
+// rh and rl, an estimate within the same bound, so the same v.
+static void ccm_mmr_table(struct pass_state *pass, pl_shader sh,
+                          const struct ccm_ctx *x, int ci, ident_t mmrt)
+{
+    const struct pl_dovi_ccm_chroma *ch = &x->prep->chroma[ci];
+    const int nq = ch->terms / 8, n = ch->num_pieces * nq;
+    uint32_t *q = pl_alloc(pass->tmp, n * 4 * sizeof(uint32_t));
+    float *r = pl_alloc(pass->tmp, n * 4 * sizeof(float));
+    float *f = pl_alloc(pass->tmp, n * 4 * sizeof(float));
+    for (int i = 0; i < ch->num_pieces; i++) {
+        for (int o = 0; o < nq; o++) {
+            // the terms of order o + 1 that are of two or three samples:
+            // (xy)^n, (xz)^n, (yz)^n, (xyz)^n, at k = 4 + 7 o .. 7 + 7 o
+            for (int j = 0; j < 4; j++) {
+                q[(i * nq + o) * 4 + j] = ch->q[i][4 + 7 * o + j];
+                r[(i * nq + o) * 4 + j] = ch->r[i][4 + 7 * o + j];
+                f[(i * nq + o) * 4 + j] = ch->f[i][4 + 7 * o + j];
+            }
+        }
+    }
+    ident_t vq = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmrc_q", .type = PL_VAR_UINT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = q,
+    });
+    ident_t vr = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmrc_r", .type = PL_VAR_FLOAT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = r,
+    });
+    ident_t vf = sh_var(sh, (struct pl_shader_var) {
+        .var = { .name = "dv_mmrc_f", .type = PL_VAR_FLOAT, .dim_v = 4, .dim_m = 1, .dim_a = n },
+        .data = f,
+    });
+    GLSL("{                                                                \n"
+         "int base = idx * %d;                                             \n"
+         "int row = (%d + idx) * 3;                                        \n"
+         "uvec4 ta = texelFetch("$", ivec2(int(u.x), row), 0);             \n"
+         "uvec4 tb = texelFetch("$", ivec2(int(u.y), row + 1), 0);         \n"
+         "uvec4 tz = texelFetch("$", ivec2(int(u.z), row + 2), 0);         \n"
+         "uint X = ta.x + tb.x + tz.x;                                     \n"
+         "float rh = uintBitsToFloat(ta.y) + uintBitsToFloat(tb.y) + uintBitsToFloat(tz.y); \n"
+         "float rl = uintBitsToFloat(ta.z) + uintBitsToFloat(tb.z) + uintBitsToFloat(tz.z); \n"
+         "float est = uintBitsToFloat(ta.w) + uintBitsToFloat(tb.w) + uintBitsToFloat(tz.w); \n"
+         "for (int k = 0; k < %d; k++) {                                   \n"
+         "    uvec4 a = "$"[base + k] * dvc[k];                            \n"
+         "    X += a.x + a.y + a.z + a.w;                                  \n"
+         "    rh += dot("$"[base + k], dvch[k]);                           \n"
+         "    rl += dot("$"[base + k], dvcl[k]);                           \n"
+         "    est += dot("$"[base + k], dvcf[k]);                          \n"
+         "}                                                                \n"
+         "X += ((uint(rh) << 10u) + uint(rl)) >> 7u;                       \n"
+         "int m = int(X >> 20u);                                           \n"
+         "int vv = m + 4096 * int(floor((est - float(m)) * (1.0/4096.0) + 0.5)); \n"
+         "v[%d] = clamp(vv, 0, 65535);                                     \n"
+         "}                                                                \n",
+         nq, ci * 8, mmrt, mmrt, mmrt, nq, vq, vr, vr, vf, ci);
+}
