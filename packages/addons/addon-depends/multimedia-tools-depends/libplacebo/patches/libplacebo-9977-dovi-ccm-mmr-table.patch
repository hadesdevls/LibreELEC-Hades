-                 "              "$"(tt[1].w, tt[1].w), 0u);                     \n",
-                 sh2, mul, mul, mul, mul);
-        }
-        if (terms >= 24) {
-            GLSL("tt[3].w = "$"(tt[0].y, tt[2].x);                              \n"
-                 "tt[4] = uvec4("$"(tt[0].z, tt[2].y), "$"(tt[0].w, tt[2].z),   \n"
-                 "              "$"(tt[1].x, tt[2].w), "$"(tt[1].y, tt[3].x));  \n"
-                 "tt[5] = uvec4("$"(tt[1].z, tt[3].y), "$"(tt[1].w, tt[3].z), 0u, 0u); \n",
-                 mul, mul, mul, mul, mul, mul, mul);
+        GLSL("uvec3 u = uvec3(clamp(ivec3(s0, sc), "$", "$"));                  \n",
+             lo, hi);
+        if (mmrt) {
+            // Hades: with the table of the terms of one sample
+            // (pl_render_params.dovi_ccm_mmr_table), the terms of two or three
+            // samples alone, from the expressions that make them in tt[]
+            // below (tt[1], tt[2].w, tt[3].xyz, tt[4].zw, tt[5].xy): dvc[o] =
+            // ((xy)^n, (xz)^n, (yz)^n, (xyz)^n) for the order n = o + 1
+            GLSL("uvec3 t1 = u << %du;                                              \n"
+                 "uvec4 dvc[%d];                                                    \n"
+                 "dvc[0] = uvec4(uvec3(u.x*u.y, u.x*u.z, u.y*u.z) << %du, 0u);      \n"
+                 "dvc[0].w = "$"(dvc[0].x, t1.z);                                   \n",
+                 sh1, terms / 8, sh2, mul);
+            if (terms >= 16) {
+                GLSL("dvc[1] = uvec4("$"(dvc[0].x, dvc[0].x), "$"(dvc[0].y, dvc[0].y), \n"
+                     "               "$"(dvc[0].z, dvc[0].z), "$"(dvc[0].w, dvc[0].w)); \n",
+                     mul, mul, mul, mul);
+            }
