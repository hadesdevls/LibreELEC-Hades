From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:35:27 +0000
Subject: [PATCH] renderer: hand the planes of the Dolby Vision composer to the
 caller

A source device that sends Dolby Vision over HDMI as ETSI GS CCM 001
V1.1.1 describes it (clause 6) sends the output picture of the composer
(clause 5.4) as it is, in the colour representation of its RPU, with DM
metadata that describes that picture (6.2.2: "If the HDR picture is the
output picture of the composing process as defined in clause 5.4, the
value of the syntax element signal_bit_depth shall be set equal to the
value of the syntax element hdr_bit_depth", and signal_color_space "equal
to the corresponding colour representation method of the associated HDR
output picture"). With pl_render_params.dovi_ccm the renderer composes that
picture already, into textures of its own that it then scales and
decodes; a caller that sends it has no way to have it.

Two parameters give it to the caller:
- dovi_ccm_planes: the composer writes the composed planes (the luma, and
  Cb and Cr at 4:2:0, as h / 2^hdr_bit_depth) into these textures of the
  caller's instead of its own, and the render goes on from them as from
  its own. They must be of the planes' sizes and of the formats that the
  composer picks; textures that do not fit are a reason not to compose
  the image so, logged like the others. dovi_ccm_composed, when set, says
  whether the image was composed into them.
- dovi_ccm_only: the image is composed into them and nothing else is
  drawn: no scaling of the chroma to 4:4:4, no decoding, nothing written
  to the target. The render fails where the image is not composed so.

Without them nothing changes: the composer's passes write to the same
kind of texture, with the same shaders, and the render goes on the same.

Measured on Mesa's software OpenGL ES (zink on lavapipe) with Kodi's
Dolby Vision renderer, on 8 pictures of a profile 7 FEL stream: its render
test gives the same bytes and hashes with this libplacebo as without it in
all its drawings; the planes composed into the caller's textures (also
with only the composition, and with the rows of the bars left out by
active_rows) are those of a C transcription of the clause, sample for
sample, in all 144 drawings compared.

License: LGPL-2.1-or-later, that of libplacebo and of the files changed,
whose notices stay as they are.
---
 src/include/libplacebo/renderer.h | 22 ++++++++++++++++
 src/renderer.c                    | 44 ++++++++++++++++++++++++++-----
 2 files changed, 59 insertions(+), 7 deletions(-)

diff --git a/src/include/libplacebo/renderer.h b/src/include/libplacebo/renderer.h
index 9091d8e..9dfee33 100644
--- a/src/include/libplacebo/renderer.h
+++ b/src/include/libplacebo/renderer.h
@@ -392,6 +392,28 @@ struct pl_render_params {
     // and the render fails instead of leaving out other rows.
     int active_rows[2];
 
+    // Where an image is composed with `dovi_ccm` (below), the composed planes
+    // are written into these textures of the caller's instead of textures of
+    // the renderer: [0] the luma, of the size of the base layer's luma plane,
+    // [1] the chroma (Cb, Cr), of the size of its chroma planes. Their formats
+    // are those that the composer picks: pl_find_fmt(gpu, PL_FMT_FLOAT, 1, 32,
+    // 32, PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE) for the luma, and with
+    // 2 components for the chroma, with PL_FMT_CAP_LINEAR as well where the
+    // GPU has such a format; both textures renderable and sampleable. After the
+    // render they hold the samples h of clause 5.4.3.3 as h / 2^hdr_bit_depth
+    // (the rows that `active_rows` leaves out excepted), and the render goes on
+    // from them as from its own. `dovi_ccm_composed`, when set, says whether
+    // the image was composed into them. Textures that do not fit are a reason
+    // not to compose the image so, logged as the others. Hades extension.
+    pl_tex dovi_ccm_planes[2];
+    bool *dovi_ccm_composed;
+
+    // Only compose: with `dovi_ccm` and `dovi_ccm_planes`, the image is
+    // composed into those textures and nothing else is drawn (the target and
+    // its overlays are left as they are). The render fails where the image is
+    // not composed so. Hades extension.
+    bool dovi_ccm_only;
+
     // Compose a Dolby Vision image (PL_COLOR_SYSTEM_DOLBYVISION, with the
     // integer composing metadata `pl_dovi_metadata.ccm`) as the composer of
     // ETSI GS CCM 001 V1.1.1, clause 5.4, does, with its arithmetic: the luma
diff --git a/src/renderer.c b/src/renderer.c
index a2def76..c265240 100644
--- a/src/renderer.c
+++ b/src/renderer.c
@@ -2002,11 +2002,12 @@ static pl_shader ccm_begin(struct pass_state *pass, int w, int h,
     return sh;
 }
 
+// (into `dst`, a texture of the caller's that ccm_check() found fit, when given)
 static pl_tex ccm_end(struct pass_state *pass, pl_shader sh, pl_fmt fmt,
-                      int w, int h)
+                      int w, int h, pl_tex dst)
 {
     GLSL("} \n");
-    pl_tex tex = get_fbo(pass, w, h, fmt, fmt->num_components, PL_DEBUG_TAG);
+    pl_tex tex = dst ? dst : get_fbo(pass, w, h, fmt, fmt->num_components, PL_DEBUG_TAG);
     if (!tex) {
         pl_dispatch_abort(pass->rr->dp, &sh);
         return NULL;
@@ -2060,7 +2061,7 @@ static pl_tex ccm_el_vertical(struct pass_state *pass, const struct ccm_ctx *x,
              "}                                                          \n", k);
     }
 
-    return ccm_end(pass, sh, luma ? x->fmt1 : x->fmt2, w, h);
+    return ccm_end(pass, sh, luma ? x->fmt1 : x->fmt2, w, h, NULL);
 }
 
 // Annex B.3, the horizontal pass, on the output of the vertical one: an ivec2
@@ -2128,7 +2129,7 @@ static pl_tex ccm_luma(struct pass_state *pass, const struct ccm_ctx *x,
     }
 
     ccm_output(sh, pp, "v", "color.x", "float");
-    return ccm_end(pass, sh, x->fmt1, w, h);
+    return ccm_end(pass, sh, x->fmt1, w, h, pass->params->dovi_ccm_planes[0]);
 }
 
 // 5.4.2.3.3 for the chroma component ci (0 = Cb, 1 = Cr), into v[ci]: the
@@ -2319,7 +2320,7 @@ static pl_tex ccm_chroma(struct pass_state *pass, const struct ccm_ctx *x,
     }
 
     ccm_output(sh, pp, "v", "color.xy", "vec2");
-    return ccm_end(pass, sh, x->fmt2, w, h);
+    return ccm_end(pass, sh, x->fmt2, w, h, pass->params->dovi_ccm_planes[1]);
 }
 
 // Why the image cannot be composed so (NULL: it can); fills `x`
@@ -2366,6 +2367,20 @@ static const char *ccm_check(struct pass_state *pass, struct ccm_ctx *x)
     if (!x->fmt1 || !x->fmt2)
         return "no 32-bit floating-point render targets";
 
+    // The caller's textures for the composed planes (pl_render_params.dovi_ccm_planes)
+    const pl_tex dl = params->dovi_ccm_planes[0], dc = params->dovi_ccm_planes[1];
+    if (dl || dc || params->dovi_ccm_only) {
+        if (!dl || !dc)
+            return "a texture of the caller's for one of the composed planes only";
+        if (dl->params.format != x->fmt1 || dc->params.format != x->fmt2 ||
+            !dl->params.renderable || !dl->params.sampleable ||
+            !dc->params.renderable || !dc->params.sampleable)
+            return "the caller's textures for the composed planes are not of the composer's formats";
+        if (dl->params.w != y->params.w || dl->params.h != y->params.h ||
+            dc->params.w != cb->params.w || dc->params.h != cb->params.h)
+            return "the caller's textures for the composed planes are not of the sizes of the planes";
+    }
+
     // the uniforms of the chroma pass: the MMR coefficients, at most
     int comps = 64;
     for (int ci = 0; ci < 2; ci++)
@@ -2454,6 +2469,8 @@ static bool pass_dovi_ccm(struct pass_state *pass)
     pl_renderer rr = pass->rr;
     struct pl_frame *image = &pass->image;
     const struct pl_dovi_metadata *dovi = image->repr.dovi;
+    if (pass->params->dovi_ccm_composed)
+        *pass->params->dovi_ccm_composed = false;
     if (!pass->params->dovi_ccm || image->repr.sys != PL_COLOR_SYSTEM_DOLBYVISION ||
         !dovi || (rr->errors & PL_RENDER_ERR_DOVI_COMPOSER))
         return false;
@@ -2523,6 +2540,8 @@ static bool pass_dovi_ccm(struct pass_state *pass)
     image->repr.bits = (struct pl_bit_encoding) { .sample_depth = 32, .color_depth = 32 };
     image->enhancement_layer = NULL;
     pass->src_ref = frame_ref(image);
+    if (pass->params->dovi_ccm_composed)
+        *pass->params->dovi_ccm_composed = true;
     return true;
 
 error:
@@ -4630,8 +4649,10 @@ bool pl_render_image(pl_renderer rr, const struct pl_frame *pimage,
     struct pl_render_params fixed;
     params = fix_params(&fixed, params);
     pl_dispatch_mark_dynamic(rr->dp, params->dynamic_constants);
+    if (params->dovi_ccm_composed)
+        *params->dovi_ccm_composed = false;
     if (!pimage)
-        return draw_empty_overlays(rr, ptarget, params);
+        return !params->dovi_ccm_only && draw_empty_overlays(rr, ptarget, params);
 
     struct pass_state pass = {
         .rr = rr,
@@ -4647,10 +4668,19 @@ bool pl_render_image(pl_renderer rr, const struct pl_frame *pimage,
     // No-op (empty crop)
     if (!pl_rect_w(pass.dst_rect) || !pl_rect_h(pass.dst_rect)) {
         pass_uninit(&pass);
-        return draw_empty_overlays(rr, ptarget, params);
+        return !params->dovi_ccm_only && draw_empty_overlays(rr, ptarget, params);
     }
 
     pass_begin_frame(&pass);
+    // Hades: only compose (pl_render_params.dovi_ccm_only)
+    if (params->dovi_ccm_only) {
+        bool composed = false;
+#ifdef PL_HAVE_DOVI
+        composed = pass_dovi_ccm(&pass);
+#endif
+        pass_uninit(&pass);
+        return composed;
+    }
     if (!pass_read_image(&pass))
         goto error;
     if (!pass_scale_main(&pass))
