From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:10:24 +0000
Subject: [PATCH] shaders/colorspace: the gamut mapping table in floats where
 16-bit unorm cannot be filtered

pl_shader_color_map_ex() keeps the table of every gamut mapping but the
saturation one (the perceptual mapping among them) in an RGBA texture of
16-bit unorm with linear filtering, and where the GPU has no such format
it replaces the mapping by the saturation mapping, without a word.
OpenGL ES has 16-bit unorm textures only with GL_EXT_texture_norm16: on
a GPU without it, a caller that asks for the perceptual mapping silently
gets another one, its colours outside the target's gamut cut by
saturation instead of being folded into it. Which GPUs lack it is not
known here; Mesa's drivers have it.

The table now goes into the first of 16-bit unorm, 32-bit floats and
16-bit floats that the GPU filters linearly (gamut_lut_fmt()). A float
table holds what the unorm one holds: the same clamp to [0, 1] and the
same shift of the chroma by 32768/65535, which the shader takes off
after the lookup; 32-bit floats without the rounding to 16 bits, half
floats rounded to their 11 significant bits, ties to even (gamut_half():
the same bits as the C compiler's conversion to _Float16 for each of the
1 065 353 217 floats within [0, 1]). A float table has a key of its own
in the cache (a half-float one is as long as a unorm one). Only without
any of the three is the mapping replaced, as before, and that is now
said once for a state object.

Measured with Kodi's Dolby Vision bridge on Mesa's zink (OpenGL ES 3.2,
which filters 16-bit unorm): where the GPU filters 16-bit unorm, every
picture is the same, to the bit (sixteen pictures mapped to SDR, to a
display of 150 cd/m2 and not mapped: profile 5, plain HDR10 and HLG,
profile 7 FEL). With the formats before it left out in a test build,
against the mapping computed exactly and against a table of 384x256x1024
entries, in thirteen mappings to SDR and to that display: 32-bit floats
as close as 16-bit unorm (within 0.01 Delta E ITP at 99.9 % of the
pixels), half floats within 0.1 of it (the largest error within 0.06);
the saturation mapping that took their place before, 0.7 to 39 at 99.9 %.

License: LGPL-2.1-or-later, that of libplacebo and of the file changed,
whose notice stays as it is.
---
 src/shaders/colorspace.c | 74 +++++++++++++++++++++++++++++++++++++---
 1 file changed, 70 insertions(+), 4 deletions(-)

diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
index 884058ff..d14a58bd 100644
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -1259,6 +1259,7 @@ struct sh_color_map_obj {
     // Gamut map state
     struct {
         pl_shader_obj lut;
+        bool said_no_fmt; // Hades: see gamut_lut_fmt()
     } gamut;
 
     // Peak detection state
@@ -1991,6 +1992,17 @@ static void fill_tone_lut(void *data, const struct sh_lut_params *params)
     pl_tone_map_generate(data, lut_params);
 }
 
+// Hades: a half float of a value within [0, 1], rounded to the nearest one
+// (ties to even), as the GPU reads a 16-bit float texel
+static uint16_t gamut_half(float f)
+{
+    union { float f; uint32_t u; } v = { .f = f };
+    if (v.u < 0x38800000) // below 2^-14, the smallest normal half: a subnormal one
+        return (uint16_t) lrintf(f * 16777216.0f); // (2^24, its unit; 1024 is the smallest normal)
+    const uint32_t r = v.u + 0x0fff + ((v.u >> 13) & 1);
+    return (uint16_t) ((r - 0x38000000) >> 13);
+}
+
 static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
 {
     const struct pl_gamut_map_params *lut_params = params->priv;
@@ -1998,11 +2010,40 @@ static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
     void *tmp = pl_alloc(NULL, lut_size * sizeof(float) * lut_params->lut_stride);
     pl_gamut_map_generate(tmp, lut_params);
 
-    // Convert to 16-bit unsigned integer for GPU texture
     const float *in = tmp;
-    uint16_t *out = data;
     pl_assert(lut_params->lut_stride == 3);
     pl_assert(params->comps == 4);
+    if (params->fmt->type == PL_FMT_FLOAT) {
+        // Hades: a float table (gamut_lut_fmt()) holds what a 16-bit unorm one holds,
+        // within [0, 1] and with the chroma shifted by the same 32768/65535, without its
+        // rounding to 16 bits (32-bit floats), or rounded to 11 significant bits (half)
+        const float shift = 32768.0f / UINT16_MAX;
+        const bool half = params->fmt->component_depth[0] == 16;
+        float *out32 = data;
+        uint16_t *out16 = data;
+        for (int i = 0; i < lut_size; i++) {
+            const float v[4] = {
+                PL_CLAMP(in[0], 0.0f, 1.0f),
+                PL_CLAMP(in[1] + shift, 0.0f, 1.0f),
+                PL_CLAMP(in[2] + shift, 0.0f, 1.0f),
+                0.0f,
+            };
+            for (int c = 0; c < 4; c++) {
+                if (half)
+                    out16[c] = gamut_half(v[c]);
+                else
+                    out32[c] = v[c];
+            }
+            in += 3;
+            out32 += 4;
+            out16 += 4;
+        }
+        pl_free(tmp);
+        return;
+    }
+
+    // Convert to 16-bit unsigned integer for GPU texture
+    uint16_t *out = data;
     for (int i = 0; i < lut_size; i++) {
         out[0] = PL_CLAMP(roundf(in[0] * UINT16_MAX), 0, UINT16_MAX);
         out[1] = PL_CLAMP(roundf(in[1] * UINT16_MAX + 32768), 0, UINT16_MAX);
@@ -2015,6 +2056,21 @@ static void fill_gamut_lut(void *data, const struct sh_lut_params *params)
     pl_free(tmp);
 }
 
+// Hades: the format of the gamut mapping table: 16-bit unorm with linear filtering, as
+// always; where the GPU cannot filter that (OpenGL ES without GL_EXT_texture_norm16 has no
+// 16-bit unorm texture at all), 32-bit and then 16-bit floats with linear filtering, which
+// hold the same table. Only without any of them is the mapping replaced (the saturation
+// mapping, which needs no table). The caller can ask the same with pl_find_fmt().
+static pl_fmt gamut_lut_fmt(pl_gpu gpu)
+{
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_UNORM, 4, 16, 16, PL_FMT_CAP_LINEAR);
+    if (!fmt)
+        fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32, PL_FMT_CAP_LINEAR);
+    if (!fmt)
+        fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 16, 16, PL_FMT_CAP_LINEAR);
+    return fmt;
+}
+
 void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *params,
                             const struct pl_color_map_args *args)
 {
@@ -2254,8 +2310,15 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
             gamut.function = &pl_gamut_map_saturation;
     }
 
-    pl_fmt gamut_fmt = pl_find_fmt(SH_GPU(sh), PL_FMT_UNORM, 4, 16, 16, PL_FMT_CAP_LINEAR);
+    pl_fmt gamut_fmt = gamut_lut_fmt(SH_GPU(sh));
     if (!gamut_fmt) {
+        // Hades: said once for a state object, not for every frame
+        if (gamut.function != &pl_gamut_map_saturation && obj && !obj->gamut.said_no_fmt) {
+            PL_WARN(sh, "No texture format with linear filtering for the gamut mapping "
+                    "table: gamut mapping '%s' replaced by 'saturation'",
+                    gamut.function->name);
+            obj->gamut.said_no_fmt = true;
+        }
         gamut.function = &pl_gamut_map_saturation;
         can_fast = true;
     }
@@ -2517,7 +2580,10 @@ void pl_shader_color_map_ex(pl_shader sh, const struct pl_color_map_params *para
             .height     = gamut.lut_size_C,
             .depth      = gamut.lut_size_h,
             .comps      = 4,
-            .signature  = gamut_map_signature(&gamut),
+            .signature  = gamut_map_signature(&gamut) ^
+                          (gamut_fmt->type != PL_FMT_FLOAT ? 0 :
+                           gamut_fmt->component_depth[0] == 16 ? 0x48616465735f6631ULL
+                                                               : 0x48616465735f6632ULL),
             .cache      = SH_CACHE(sh),
             .fill       = fill_gamut_lut,
             .priv       = &gamut,
