From 1f1981cd16bb52c43fe1c4eb9b90fda05255729c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:12:52 +0000
Subject: [PATCH] ntp: nor an RTC that is read as UTC without being written

LibreELEC Hades reads the RTC and never writes it: on a PC that also runs
Windows, Windows keeps it in local time (/etc/adjtime says LOCAL), and
connman-9000 keeps STA_UNSYNC set for that. With the setting "Hardware
clock" on Automatic, a computer whose RTC was measured to keep UTC has it
read as UTC from the next start: the init puts an adjtime that says UTC
over the one of the image, and makes /run/hades/rtc-never-written before
it, as that RTC is not to be written either.

With that file there, a successful adjustment keeps STA_UNSYNC set too,
so that the kernel's 11-minute mode never writes the RTC. It is read
once, as /etc/adjtime is: the init makes both before systemd starts.
---
 src/ntp.c | 29 ++++++++++++++++++++++++++---
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/src/ntp.c b/src/ntp.c
index 4a85ef6..d742d1f 100644
--- a/src/ntp.c
+++ b/src/ntp.c
@@ -275,6 +275,28 @@ static bool rtc_in_local_time(void)
 	return local;
 }
 
+/*
+ * Hades: the init makes /run/hades/rtc-never-written where it reads the RTC
+ * as UTC only because that is what the RTC was measured to keep (the setting
+ * "Hardware clock" on Automatic). Such an RTC is never written either, as one
+ * that runs in local time. Read once: the init makes it before systemd starts.
+ */
+static bool rtc_never_written(void)
+{
+	static int never = -1;
+
+	if (never >= 0)
+		return never;
+
+	never = rtc_in_local_time();
+	if (!never && access("/run/hades/rtc-never-written", F_OK) == 0) {
+		never = 1;
+		connman_info("ntp: RTC read as UTC without being written, it is never updated");
+	}
+
+	return never;
+}
+
 /*
  * Hades: record that the clock has been synchronized, like systemd-timesyncd's
  * /run/systemd/timesync/synchronized. With STA_UNSYNC kept set (RTC in local
@@ -435,10 +457,11 @@ static void decode_msg(struct ntp_data *nd, void *base, size_t len,
 
 	/*
 	 * An unset STA_UNSYNC enables the kernel's 11-minute mode, which writes
-	 * the system time (UTC) to the RTC. If the RTC runs in local time, never
-	 * let it be touched: same rule as systemd-timesyncd.
+	 * the system time (UTC) to the RTC. If the RTC runs in local time, or is
+	 * read as UTC without being written, never let it be touched: same rule
+	 * as systemd-timesyncd.
 	 */
-	if (rtc_in_local_time())
+	if (rtc_never_written())
 		tmx.status |= STA_UNSYNC;
 
 	if (adjtimex(&tmx) < 0) {
-- 
