From 681c5771afab80c3ee1284cd31f0ab5db131dcec Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 18:58:24 +0000
Subject: [PATCH] gdhcp: bound the DHCPv6 domain search list parser

get_domains() copied a fixed NS_MAXDNAME bytes from the DHCPv6
DOMAIN_LIST option (RFC 3646, option 24) into a stack buffer, whatever
the length of the option, and then walked the DNS labels with
"c += jump + 1" without checking that the label stayed inside the
buffer or inside the option. A DHCPv6 Reply with a DOMAIN_LIST of 1025
or more non-zero bytes makes the walk read and write past dns_name
(CVE-2026-115863, "ConnMan through 2.0"). ConnMan has no fix for this
yet: the commit that the CVE record cites is the 2013 one that added
the function.

Parse the option label by label instead: every label length is checked
against what is left of the option, against the 63 bytes that RFC 1035
allows, and against the size of dns_name; parsing stops at the first
malformed or truncated name, and the names parsed until then are kept.
An empty name (a lone root label) is skipped instead of reading the
uninitialised second byte of dns_name. Well-formed lists give the same
names as before.
---
 gdhcp/client.c | 43 +++++++++++++++++++++++++++++++++----------
 1 file changed, 33 insertions(+), 10 deletions(-)

diff --git a/gdhcp/client.c b/gdhcp/client.c
index 976773a..1ac5dcc 100644
--- a/gdhcp/client.c
+++ b/gdhcp/client.c
@@ -2210,24 +2210,47 @@ static GList *get_domains(int maxlen, unsigned char *value)
 {
 	GList *list = NULL;
 	int pos = 0;
-	unsigned char *c;
 	char dns_name[NS_MAXDNAME + 1];
 
 	if (!value || maxlen < 3)
 		return NULL;
 
+	/*
+	 * RFC 3646: the option is a list of domain names in uncompressed
+	 * DNS wire format. Every label length is checked against what is
+	 * left of the option and against the size of dns_name, and parsing
+	 * stops at the first malformed or truncated name.
+	 */
 	while (pos < maxlen) {
-		strncpy(dns_name, (char *)&value[pos], NS_MAXDNAME);
-
-		c = (unsigned char *)dns_name;
-		while (c && *c) {
-			int jump;
-			jump = *c;
-			*c = '.';
-			c += jump + 1;
+		int len = 0;
+		int complete = 0;
+
+		while (pos < maxlen) {
+			int jump = value[pos++];
+
+			if (jump == 0) {
+				complete = 1;
+				break;
+			}
+
+			if (jump > 63 || jump > maxlen - pos ||
+					len + 1 + jump > NS_MAXDNAME)
+				break;
+
+			dns_name[len++] = '.';
+			memcpy(&dns_name[len], &value[pos], jump);
+			len += jump;
+			pos += jump;
 		}
+
+		if (!complete)
+			break;
+
+		if (len == 0)
+			continue;
+
+		dns_name[len] = '\0';
 		list = g_list_prepend(list, g_strdup(&dns_name[1]));
-		pos += (char *)c - dns_name + 1;
 	}
 
 	return g_list_reverse(list);
