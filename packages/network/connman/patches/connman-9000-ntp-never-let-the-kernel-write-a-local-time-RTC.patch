From 38e7c449c4bd146318d078dee15664712d4309c7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:21:25 +0000
Subject: [PATCH] ntp: never let the kernel write an RTC that runs in local
 time

When the RTC runs in local time (the third line of /etc/adjtime is "LOCAL",
as on a PC that also runs Windows, which keeps the RTC in local time), a
successful time adjustment must not clear STA_UNSYNC: an unset STA_UNSYNC
enables the kernel's 11-minute mode, which writes the system time (UTC) to
the RTC and moves the other operating system's clock by the UTC offset.
This is the rule systemd-timesyncd applies ("In case the RTC runs in local
time, never touch the RTC").

With STA_UNSYNC kept set, adjtimex() keeps reporting TIME_ERROR, so each
successful adjustment is recorded in <statedir>/ntp-synchronized
(/run/connman on LibreELEC), like systemd-timesyncd's
/run/systemd/timesync/synchronized, for tools that wait for the clock to be
synchronized.
---
 src/ntp.c | 64 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/src/ntp.c b/src/ntp.c
index e0b6519..4a85ef6 100644
--- a/src/ntp.c
+++ b/src/ntp.c
@@ -246,6 +246,60 @@ static void reset_timeout(struct ntp_data *nd)
 	nd->retries = 0;
 }
 
+/*
+ * Hades: the RTC runs in local time when the third line of /etc/adjtime is
+ * "LOCAL", as on a PC that also runs Windows, which keeps the RTC in local
+ * time. Same rule as systemd's clock_is_localtime(); read once.
+ */
+static bool rtc_in_local_time(void)
+{
+	static int local = -1;
+	gchar *contents = NULL;
+	gchar **lines;
+
+	if (local >= 0)
+		return local;
+
+	local = 0;
+	if (g_file_get_contents("/etc/adjtime", &contents, NULL, NULL)) {
+		lines = g_strsplit(contents, "\n", 4);
+		if (g_strv_length(lines) >= 3 && g_str_equal(lines[2], "LOCAL"))
+			local = 1;
+		g_strfreev(lines);
+		g_free(contents);
+	}
+
+	if (local)
+		connman_info("ntp: RTC runs in local time, it is never updated");
+
+	return local;
+}
+
+/*
+ * Hades: record that the clock has been synchronized, like systemd-timesyncd's
+ * /run/systemd/timesync/synchronized. With STA_UNSYNC kept set (RTC in local
+ * time), adjtimex() cannot tell it any more.
+ */
+static void mark_synchronized(void)
+{
+	int fd;
+
+	if (g_mkdir_with_parents(STATEDIR, 0755) < 0) {
+		connman_warn("Cannot create %s: %s", STATEDIR, strerror(errno));
+		return;
+	}
+
+	fd = open(STATEDIR "/ntp-synchronized",
+			O_WRONLY | O_CREAT | O_CLOEXEC | O_NOCTTY, 0644);
+	if (fd < 0) {
+		connman_warn("Cannot create %s/ntp-synchronized: %s",
+						STATEDIR, strerror(errno));
+		return;
+	}
+
+	close(fd);
+}
+
 static void decode_msg(struct ntp_data *nd, void *base, size_t len,
 		struct timeval *tv, struct timespec *mrx_time)
 {
@@ -379,12 +433,22 @@ static void decode_msg(struct ntp_data *nd, void *base, size_t len,
 	else if (NTP_FLAGS_LI_DECODE(msg->flags) & NTP_FLAG_LI_DELSECOND)
 		tmx.status |= STA_DEL;
 
+	/*
+	 * An unset STA_UNSYNC enables the kernel's 11-minute mode, which writes
+	 * the system time (UTC) to the RTC. If the RTC runs in local time, never
+	 * let it be touched: same rule as systemd-timesyncd.
+	 */
+	if (rtc_in_local_time())
+		tmx.status |= STA_UNSYNC;
+
 	if (adjtimex(&tmx) < 0) {
 		connman_error("Failed to adjust time: %s (%d)", strerror(errno), errno);
 		nd->cb(false, nd->user_data);
 		return;
 	}
 
+	mark_synchronized();
+
 	DBG("interval/delta/delay/drift %fs/%+.3fs/%.3fs/%+"PRId64"ppm",
 		LOGTOD(msg->poll), offset, delay, tmx.freq / 65536);
 
-- 
2.53.0

