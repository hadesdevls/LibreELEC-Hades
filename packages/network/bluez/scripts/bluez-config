#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: generate the runtime BlueZ configuration. By default only bonded
# devices may send input (BlueZ handles cable-paired PS3 controllers) and re-pairing an already
# paired device must be confirmed by the user. BLUEZ_LEGACY_INPUT=true (bluez service file, set by
# the settings add-on) restores the LibreELEC behaviour for input devices that cannot bond.

RUN_DIR="/run/libreelec/bluetooth"

mkdir -p "${RUN_DIR}"
cp /usr/share/bluetooth/main.conf "${RUN_DIR}/main.conf.new" || exit 1
cp /usr/share/bluetooth/input.conf "${RUN_DIR}/input.conf.new" || exit 1
if [ "${BLUEZ_LEGACY_INPUT}" = "true" ]; then
  sed -e "s|^JustWorksRepairing=.*|JustWorksRepairing=always|" -i "${RUN_DIR}/main.conf.new"
  sed -e "s|^ClassicBondedOnly=.*|ClassicBondedOnly=false|" -i "${RUN_DIR}/input.conf.new"
fi
mv "${RUN_DIR}/main.conf.new" "${RUN_DIR}/main.conf"
mv "${RUN_DIR}/input.conf.new" "${RUN_DIR}/input.conf"
