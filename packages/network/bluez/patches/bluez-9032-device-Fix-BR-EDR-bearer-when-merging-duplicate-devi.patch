From f088feb4f6dd725c16f3403e582fba45ed507df2 Mon Sep 17 00:00:00 2001
From: Ye He <ye.he@amlogic.com>
Date: Sat, 10 Oct 2026 14:55:49 +0800
Subject: [PATCH] device: Fix BR/EDR bearer when merging duplicate device

A device first discovered over BR/EDR and later over LE with a private
address has two device objects until its IRK is distributed and they are
merged. device_merge_duplicate() copied dup->bredr into dev, so both
objects shared one bearer and whichever was freed second used a bearer
already destroyed by the first.

Give dev its own BR/EDR bearer instead, unless it already has one, and
inherit the paired and bonded state from dup. The connection state is not
inherited since dup still owns the link and receives its disconnection.

Fixes: d9294d644930 ("core: Add support for merging duplicate device object data")
Assisted-by: OpenCode:claude-opus-5.5
---
 src/device.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/device.c b/src/device.c
index 8fdef14..4567188 100644
--- a/src/device.c
+++ b/src/device.c
@@ -5456,9 +5456,26 @@ void device_merge_duplicate(struct btd_device *dev, struct btd_device *dup)
 {
 	GSList *l;
 
-	DBG("");
+	DBG("dev path '%s', dup dev path '%s'", dev->path, dup->path);
+
+	/* dup keeps its own bearer, which is destroyed along with it, so
+	 * dev needs a bearer of its own unless it already has one.
+	 */
+	if (!dev->bredr)
+		dev->bredr = btd_bearer_new(dev, BDADDR_BREDR);
+
+	/* Connection state stays with dup, which owns the link and gets
+	 * its disconnection, so only the pairing state is inherited.
+	 */
+	if (dup->bredr_state.paired && !dev->bredr_state.paired) {
+		dev->bredr_state.paired = true;
+		btd_bearer_paired(dev->bredr);
+	}
 
-	dev->bredr = dup->bredr;
+	if (dup->bredr_state.bonded && !dev->bredr_state.bonded) {
+		dev->bredr_state.bonded = true;
+		btd_bearer_bonded(dev->bredr);
+	}
 
 	dev->trusted = dup->trusted;
 	dev->blocked = dup->blocked;
-- 
