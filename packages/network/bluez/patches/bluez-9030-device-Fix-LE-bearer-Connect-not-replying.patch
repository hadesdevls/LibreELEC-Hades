From 7428ca2df9356363079db0f48412c20cbdb9471f Mon Sep 17 00:00:00 2001
From: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
Date: Fri, 9 Oct 2026 16:37:20 -0400
Subject: [PATCH] device: Fix LE bearer Connect not replying

If the ATT socket of an outgoing LE connection connects before the MGMT
Device Connected event is processed, att_connect_cb sets the LE state as
connected, so device_add_connection bails out as already connected and
btd_bearer_connected is never called. Bearer.LE1.Connect is then left
without a reply, the initiator flag is not set and Device1.Connected is
not emitted.

Fix it by calling device_add_connection from att_connect_cb when the LE
state is not yet connected.

Fixes: 4e21ebcaa5d0 ("bearer: Implement Connect/Disconnect methods")
Assisted-by: OpenCode:claude-opus-5.5
---
 src/device.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/device.c b/src/device.c
index 4ccafd1..8fdef14 100644
--- a/src/device.c
+++ b/src/device.c
@@ -6780,8 +6780,11 @@ static void att_connect_cb(GIOChannel *io, GError *gerr, gpointer user_data)
 		goto done;
 	}
 
-	/* Update connected state */
-	device->le_state.connected = true;
+	/* Update connected state in case the MGMT Device Connected event has
+	 * not been processed yet, the connection was locally initiated.
+	 */
+	if (!device->le_state.connected)
+		device_add_connection(device, device->bdaddr_type, BIT(3));
 
 	if (!device_attach_att(device, io))
 		goto done;
-- 
