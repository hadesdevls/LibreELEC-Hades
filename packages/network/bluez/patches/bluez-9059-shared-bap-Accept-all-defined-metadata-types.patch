From 62632c8f6060576dd424e7140280fef52fa8d213 Mon Sep 17 00:00:00 2001
From: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
Date: Wed, 28 Oct 2026 09:43:59 -0400
Subject: [PATCH] shared/bap: Accept all defined metadata types

bap_metadata_process() rejected every metadata type other than
Preferred/Streaming_Audio_Contexts, Program_Info and Language with
Unsupported Metadata, so valid LTVs such as CCID_List, which the Client
must include for content control, caused Enable and Update Metadata to
fail.

Accept all types defined in Assigned Numbers 6.12.6, and reject as
Invalid Metadata Parental_Rating, Audio_Active_State and
Assisted_Listening_Stream when their value is not 1 octet,
Broadcast_Name when its value is not 4 to 128 octets,
Broadcast_Audio_Immediate_Rendering_Flag when its value is not empty,
and Extended/Vendor_Specific when their value is shorter than the
2-octet identifier.

Assisted-by: OpenCode:claude-opus-5.5
---
 src/shared/bap.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/src/shared/bap.c b/src/shared/bap.c
index d1836afc9..10cc81a51 100644
--- a/src/shared/bap.c
+++ b/src/shared/bap.c
@@ -3443,6 +3443,39 @@ static void bap_metadata_process(size_t i, uint8_t l, uint8_t t, uint8_t *v,
 		break;
 	case BT_BAP_META_PROGRAM_INFO:
 	case BT_BAP_META_LANGUAGE:
+	case BT_BAP_META_CCID_LIST:
+	case BT_BAP_META_PROGRAM_INFO_URI:
+		break;
+	case BT_BAP_META_BROADCAST_NAME:
+		if (l < 4 || l > 128) {
+			ascs_ase_rsp_add(data->rsp, data->ep->id,
+					BT_ASCS_RSP_METADATA_INVALID, t);
+			data->err = BT_ASCS_RSP_METADATA_INVALID;
+		}
+		break;
+	case BT_BAP_META_BCAST_IMMEDIATE:
+		if (l) {
+			ascs_ase_rsp_add(data->rsp, data->ep->id,
+					BT_ASCS_RSP_METADATA_INVALID, t);
+			data->err = BT_ASCS_RSP_METADATA_INVALID;
+		}
+		break;
+	case BT_BAP_META_EXTENDED:
+	case BT_BAP_META_VENDOR:
+		if (l < sizeof(uint16_t)) {
+			ascs_ase_rsp_add(data->rsp, data->ep->id,
+					BT_ASCS_RSP_METADATA_INVALID, t);
+			data->err = BT_ASCS_RSP_METADATA_INVALID;
+		}
+		break;
+	case BT_BAP_META_PARENTAL_RATING:
+	case BT_BAP_META_AUDIO_ACTIVE_STATE:
+	case BT_BAP_META_ASSISTED_LISTENING:
+		if (l != sizeof(uint8_t)) {
+			ascs_ase_rsp_add(data->rsp, data->ep->id,
+					BT_ASCS_RSP_METADATA_INVALID, t);
+			data->err = BT_ASCS_RSP_METADATA_INVALID;
+		}
 		break;
 	default:
 		ascs_ase_rsp_add(data->rsp, data->ep->id,
