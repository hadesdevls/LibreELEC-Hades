From ebd56ce3f4eeb21aa659c9212c7ea4a2012aa3a3 Mon Sep 17 00:00:00 2001
From: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
Date: Sat, 7 Nov 2026 16:52:25 -0500
Subject: [PATCH] shared/att: Fix reference leak on signature verification
 failure

handle_notify takes a reference on the bt_att but returned without
dropping it when the signature of a Signed Write Command could not be
verified, so the bt_att was never freed.

Fixes: 051a525c ("shared/att.c: Add server signing key support")
Assisted-by: OpenCode:claude-sonnet-5.5
Upstream: https://github.com/bluez/bluez/commit/ebd56ce3f4eeb21aa659c9212c7ea4a2012aa3a3
---
 src/shared/att.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/shared/att.c b/src/shared/att.c
index e49743b..78b6d4d 100644
--- a/src/shared/att.c
+++ b/src/shared/att.c
@@ -1029,8 +1029,10 @@ static void handle_notify(struct bt_att_chan *chan, uint8_t *pdu,
 			continue;
 
 		if ((opcode & ATT_OP_SIGNED_MASK) && att->crypto) {
-			if (!handle_signed(att, pdu, pdu_len))
+			if (!handle_signed(att, pdu, pdu_len)) {
+				bt_att_unref(att);
 				return;
+			}
 			pdu_len -= BT_ATT_SIGNATURE_LEN;
 		}
 
