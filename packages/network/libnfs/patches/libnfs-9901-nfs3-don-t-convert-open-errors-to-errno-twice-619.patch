From 27d0cd054484b81d3e680b4a7c5773c712f4fe6e Mon Sep 17 00:00:00 2001
From: delysio <daniel.kozminski@gmail.com>
Date: Sat, 3 Oct 2026 04:12:12 +0200
Subject: [PATCH] nfs3: don't convert open errors to errno twice (#619)

nfs3_initial_open_cb() and nfs3_open_create_cb() are lookup callbacks,
so err is already a negative errno. Passing it through
nfsstat3_to_errno() again hits the default case and turns every failed
open, e.g. a missing file, into -ERANGE.

Co-authored-by: dely <dely@atari.org.pl>
Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/nfs_v3.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/nfs_v3.c b/lib/nfs_v3.c
index 18086881767e..3931a845fa45 100644
--- a/lib/nfs_v3.c
+++ b/lib/nfs_v3.c
@@ -4906,7 +4906,7 @@ static void nfs3_open_create_cb(int err, struct nfs_context *nfs, void *ret_data
 	struct open_cb_data *cb_data = private_data;
 
         if (err) {
-		cb_data->cb(nfsstat3_to_errno(err), nfs,
+		cb_data->cb(err, nfs,
                          nfs_get_error(nfs), cb_data->private_data);
                 free_open_cb_data(cb_data);
                 return;
@@ -5066,7 +5066,7 @@ static void nfs3_initial_open_cb(int err, struct nfs_context *nfs, void *ret_dat
                 return;
         }
         if (err) {
-                cb_data->cb(nfsstat3_to_errno(err), nfs,
+                cb_data->cb(err, nfs,
                             nfs_get_error(nfs), cb_data->private_data);
                 free_open_cb_data(cb_data);
                 return;
