From ecd49d93aa1d27aa86df0c4155dabffe0d7d0895 Mon Sep 17 00:00:00 2001
From: Pablo Neira Ayuso <pablo@netfilter.org>
Date: Tue, 1 Sep 2026 19:45:41 +0200
Subject: [PATCH] nft: use NFTNL_EXPR_RANGE_TO_DATA to fetch length

Instead of NFTNL_EXPR_RANGE_FROM_DATA, otherwise check for different
attribute length is defeated.

Fixes: 5795a1b5b611 ("nft-shared: support native tcp port range delinearize")
Signed-off-by: Pablo Neira Ayuso <pablo@netfilter.org>
---
 iptables/nft-ruleparse.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/iptables/nft-ruleparse.c b/iptables/nft-ruleparse.c
index 26a605c..965831b 100644
--- a/iptables/nft-ruleparse.c
+++ b/iptables/nft-ruleparse.c
@@ -849,7 +849,7 @@ static void nft_parse_transport_range(struct nft_xt_ctx *ctx,
 	}
 
 	nftnl_expr_get(e, NFTNL_EXPR_RANGE_FROM_DATA, &len_from);
-	nftnl_expr_get(e, NFTNL_EXPR_RANGE_FROM_DATA, &len_to);
+	nftnl_expr_get(e, NFTNL_EXPR_RANGE_TO_DATA, &len_to);
 	if (len_to != len_from || len_to != 2)
 		return;
 
