From 53c77f1bc34f92991d69a1ed8477947d49927e8f Mon Sep 17 00:00:00 2001
From: "djm@openbsd.org" <djm@openbsd.org>
Date: Fri, 30 Oct 2026 02:08:03 +0000
Subject: [PATCH] upstream: have unpriv process reject oversize DH-GEX groups

rather than just relying on the monitor to do it; improves logging

Anthropic ANT-2026-EHAZM3AZ

OpenBSD-Commit-ID: 76cd63c1381149a9298204cd18bb06c21754ff07
---
 kexgexs.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/kexgexs.c b/kexgexs.c
index 791afc2a..22232cd8 100644
--- a/kexgexs.c
+++ b/kexgexs.c
@@ -1,4 +1,4 @@
-/* $OpenBSD: kexgexs.c,v 1.51 2026/03/03 09:57:25 dtucker Exp $ */
+/* $OpenBSD: kexgexs.c,v 1.52 2026/10/30 02:08:03 djm Exp $ */
 /*
  * Copyright (c) 2000 Niels Provos.  All rights reserved.
  * Copyright (c) 2001 Markus Friedl.  All rights reserved.
@@ -91,7 +91,8 @@ input_kex_dh_gex_request(int type, uint32_t seq, struct ssh *ssh)
 	nbits = MINIMUM(DH_GRP_MAX, nbits);
 
 	if (kex->max < kex->min || kex->nbits < kex->min ||
-	    kex->max < kex->nbits || kex->max < DH_GRP_MIN) {
+	    kex->max < kex->nbits || kex->max < DH_GRP_MIN ||
+	    kex->min > DH_GRP_MAX) {
 		r = SSH_ERR_DH_GEX_OUT_OF_RANGE;
 		goto out;
 	}
