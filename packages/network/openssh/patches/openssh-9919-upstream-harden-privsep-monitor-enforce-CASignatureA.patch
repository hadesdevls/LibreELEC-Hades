From 5c5fd68bbf6a7478718c5ff82d8514a615e1ab69 Mon Sep 17 00:00:00 2001
From: "djm@openbsd.org" <djm@openbsd.org>
Date: Fri, 30 Oct 2026 03:44:02 +0000
Subject: [PATCH] upstream: harden privsep monitor: enforce
 CASignatureAlgorithms

and RequiredRSASize checks for keys received from the unpriv process during
publickey and hostbased authentication

Anthropic ANT-2026-RBFG1KXP

OpenBSD-Commit-ID: ea9bc8eddcdf3af9c26c0b0114d8c4f23e4ecb31

[Hades: backported to 10.6p1 without the hunk that updates the
$OpenBSD$ ident comment on line 1 of monitor.c: in master that line
already carries a later revision, which goes back to 9da385e24403
("upstream: Remove the SSH_OLD_SESSIONID bug compatibility bit. It"), a commit that
10.6p1 does not have, so that hunk cannot apply. The code hunks are
the commit's, unchanged.]
---
 monitor.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/monitor.c b/monitor.c
index 940dc27..2083b6c 100644
--- a/monitor.c
+++ b/monitor.c
@@ -1006,6 +1006,32 @@ key_base_type_match(const char *method, const struct sshkey *key,
 	return found;
 }
 
+/*
+ * Check that the key satisfies the CASignatureAlgorithms and
+ * RequiredRSASize policies. These are also checked in the unprivileged
+ * authentication code, but are re-checked here so that they hold
+ * regardless of what the unprivileged process sends us.
+ * Returns 1 on success, 0 otherwise.
+ */
+static int
+key_policy_match(const char *method, const struct sshkey *key)
+{
+	int r;
+
+	if ((r = sshkey_check_cert_sigtype(key,
+	    options.ca_sign_algorithms)) != 0) {
+		error_r(r, "%s certificate signature algorithm not in "
+		    "CASignatureAlgorithms", method);
+		return 0;
+	}
+	if ((r = sshkey_check_rsa_length(key,
+	    options.required_rsa_size)) != 0) {
+		error_r(r, "%s refusing %s key", method, sshkey_type(key));
+		return 0;
+	}
+	return 1;
+}
+
 int
 mm_answer_authpassword(struct ssh *ssh, int sock, struct sshbuf *m)
 {
@@ -1309,6 +1335,8 @@ mm_answer_keyallowed(struct ssh *ssh, int sock, struct sshbuf *m)
 			if (!key_base_type_match(auth_method, key,
 			    options.pubkey_accepted_algos))
 				break;
+			if (!key_policy_match(auth_method, key))
+				break;
 			allowed = user_key_allowed(ssh, authctxt->pw, key,
 			    pubkey_auth_attempt, &opts);
 			break;
@@ -1321,6 +1349,8 @@ mm_answer_keyallowed(struct ssh *ssh, int sock, struct sshbuf *m)
 			if (!key_base_type_match(auth_method, key,
 			    options.hostbased_accepted_algos))
 				break;
+			if (!key_policy_match(auth_method, key))
+				break;
 			allowed = hostbased_key_allowed(ssh, authctxt->pw,
 			    cuser, chost, key);
 			auth2_record_info(authctxt,
