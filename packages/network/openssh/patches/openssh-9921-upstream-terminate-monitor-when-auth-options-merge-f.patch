From a76fb3adab72d957cb69c1e574949febb45976a0 Mon Sep 17 00:00:00 2001
From: "djm@openbsd.org" <djm@openbsd.org>
Date: Fri, 30 Oct 2026 04:40:03 +0000
Subject: [PATCH] upstream: terminate monitor when auth options merge fails;
 avoids

NULL dereference later

Anthropic ANT-2026-UES5TKX0

OpenBSD-Commit-ID: 5ecc8e3487801e9bca855e2b5bccd64027833774

[Hades: backported to 10.6p1 without the hunk that updates the
$OpenBSD$ ident comment on line 1 of monitor.c: in master that line
already carries a later revision, which goes back to 9da385e24403
("upstream: Remove the SSH_OLD_SESSIONID bug compatibility bit. It"), a commit that
10.6p1 does not have, so that hunk cannot apply. The code hunks are
the commit's, unchanged.]
---
 monitor.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/monitor.c b/monitor.c
index 2083b6c..d8c0c21 100644
--- a/monitor.c
+++ b/monitor.c
@@ -1641,10 +1641,13 @@ mm_answer_keyverify(struct ssh *ssh, int sock, struct sshbuf *m)
 			ret = SSH_ERR_SIGNATURE_INVALID;
 		}
 	}
+	if (ret == 0 && key_blobtype == MM_USERKEY &&
+	    auth_activate_options(ssh, key_opts) != 0) {
+		debug_f("key options inconsistent with existing");
+		ret = SSH_ERR_INVALID_ARGUMENT;
+	}
 	auth2_record_key(authctxt, ret == 0, key);
 
-	if (key_blobtype == MM_USERKEY && ret == 0)
-		auth_activate_options(ssh, key_opts);
 	monitor_reset_key_state();
 
 	sshbuf_reset(m);
