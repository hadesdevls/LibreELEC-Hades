#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: sshd refuses password logins while root still has the well-known default password; SSH
# keys keep working. Enabling SSH with the "ssh" boot parameter (physical
# access to the boot entry) keeps the LibreELEC behaviour as a recovery path.
#
# Usage: sshd-default-password         write the runtime sshd settings (sshd.service start, reload)
#        sshd-default-password check   only report: exit status 0 if root has the default password

DEFAULT_PASSWORD="@ROOT_PASSWORD@"
CONF_DIR="/run/libreelec/sshd_config.d"
CONF="${CONF_DIR}/50-default-password.conf"

root_hash() {
  sed -n 's/^root:\([^:]*\):.*/\1/p' "${1}" 2>/dev/null | head -n 1
}

is_default_password() {
  local current default salt

  current="$(root_hash /storage/.cache/shadow)"
  default="$(root_hash /usr/cache/shadow)"
  [ -n "${current}" ] || return 1
  [ "${current}" = "${default}" ] && return 0
  # the default password set again gets another salt: check it with the current salt
  case "${current}" in
    '$6$'*)
      salt="${current#\$6\$}"
      salt="${salt%%\$*}"
      [ "$(cryptpw -m sha512 -S "${salt}" "${DEFAULT_PASSWORD}" 2>/dev/null)" = "${current}" ] && return 0
      ;;
  esac
  return 1
}

boot_parameter_ssh() {
  local arg

  for arg in $(cat /proc/cmdline); do
    case "${arg}" in
      ssh|ssh=*)
        return 0
        ;;
    esac
  done
  return 1
}

if [ "${1}" = "check" ]; then
  is_default_password
  exit
fi

mkdir -p "${CONF_DIR}"
rm -f "${CONF}"
if is_default_password; then
  if boot_parameter_ssh; then
    echo "WARNING: root still has the default password; password logins stay allowed because SSH was enabled with the ssh boot parameter"
  else
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' >"${CONF}"
    echo "root still has the default password: password logins are disabled until it is changed (SSH keys still work)"
  fi
fi
exit 0
