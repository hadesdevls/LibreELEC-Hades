#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present Hades

# Hades: sshd refuses password logins while root still has the well-known default password; SSH
# keys keep working. Enabling SSH with the "ssh" boot parameter (physical
# access to the boot entry) keeps the LibreELEC behaviour as a recovery path.
# While it refuses them, sshd shows a short banner before the login (sshd_config: Banner), so that
# whoever meets the refusal (an SFTP program says "No more authentication methods available") reads
# why and where to set a password. The banner says nothing that the refusal does not already tell.
#
# Usage: sshd-default-password         write the runtime sshd settings (sshd.service start, reload)
#        sshd-default-password check   only report: exit status 0 if root has the default password
# HADES_SSHD_ROOT stands for / in a test.

DEFAULT_PASSWORD="@ROOT_PASSWORD@"
ROOT="${HADES_SSHD_ROOT:-}"
CONF_DIR="${ROOT}/run/libreelec/sshd_config.d"
CONF="${CONF_DIR}/50-default-password.conf"
BANNER="${CONF_DIR}/default-password-banner.txt"

root_hash() {
  sed -n 's/^root:\([^:]*\):.*/\1/p' "${1}" 2>/dev/null | head -n 1
}

is_default_password() {
  local current default salt

  current="$(root_hash "${ROOT}/storage/.cache/shadow")"
  default="$(root_hash "${ROOT}/usr/cache/shadow")"
  [ -n "${current}" ] || return 1
  [ "${current}" = "${default}" ] && return 0
  # the default password set again gets another salt: check it with the current salt
  case "${current}" in
    '$6$'*)
      salt="${current#\$6\$}"
      salt="${salt%%\$*}"
      [ "$(cryptpw -m sha512 -S "${salt}" "${DEFAULT_PASSWORD}" 2>/dev/null)" = "${current}" ] && return 0
      ;;
  esac
  return 1
}

boot_parameter_ssh() {
  local arg

  for arg in $(cat "${ROOT}/proc/cmdline"); do
    case "${arg}" in
      ssh|ssh=*)
        return 0
        ;;
    esac
  done
  return 1
}

# Network access "As in LibreELEC" (Settings > LibreELEC > Services, or the wizard of the first start): SSH takes the
# default password as LibreELEC does; the file says libreelec
ssh_as_libreelec() {
  [ "$(head -n 1 "${ROOT}/storage/.cache/hades-network" 2>/dev/null)" = libreelec ]
}

if [ "${1}" = "check" ]; then
  is_default_password
  exit
fi

mkdir -p "${CONF_DIR}"
rm -f "${CONF}" "${BANNER}"
if is_default_password; then
  if boot_parameter_ssh; then
    echo "WARNING: root still has the default password; password logins stay allowed because SSH was enabled with the ssh boot parameter"
  elif ssh_as_libreelec; then
    echo "WARNING: root still has the default password, and password logins are allowed, as in LibreELEC: Network access is As in LibreELEC (Settings > LibreELEC > Services)"
  else
    {
      echo "LibreELEC Hades: password logins are off while root has the default password, which everyone knows."
      echo "Log in with an SSH key, or set a password in Settings > LibreELEC > Services > SSH > SSH Password."
      echo "LibreELEC Hades: el acceso con contraseña está desactivado mientras root tenga la contraseña por defecto."
      echo "Entra con una clave SSH, o pon una contraseña en Ajustes > LibreELEC > Servicios > SSH > Contraseña SSH."
    } > "${BANNER}"
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nBanner %s\n' "${BANNER#${ROOT}}" >"${CONF}"
    echo "root still has the default password: password logins are disabled until it is changed (SSH keys still work); sshd shows why before each login"
  fi
fi
exit 0
