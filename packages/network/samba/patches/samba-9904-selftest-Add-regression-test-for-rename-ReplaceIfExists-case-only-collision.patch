From 6e3e8b3846eb147c5120924427701beb8db0fb7b Mon Sep 17 00:00:00 2001
From: Volker Lendecke <vl@samba.org>
Date: Mon, 28 Sep 2026 03:50:03 +0000
Subject: [PATCH] selftest: Add regression test for rename ReplaceIfExists
 case-only collision

Add samba.tests.libsmb-basic.LibsmbTestCase.test_rename_replace_case,
which renames a temporary file over an existing target differing only
in case with ReplaceIfExists set. The existing target must be replaced,
not left in place alongside a second, duplicate directory entry.

BUG: https://bugzilla.samba.org/show_bug.cgi?id=16261

Signed-off-by: Volker Lendecke <vl@samba.org>
Reviewed-by: Anoop C S <anoopcs@samba.org>
(cherry picked from commit a798b16fc76b968d8af64409e6365791bbd62419)
---
 python/samba/tests/libsmb-basic.py | 30 ++++++++++++++++++++++++++++++
 selftest/knownfail.d/bug-16261     |  1 +
 2 files changed, 31 insertions(+)
 create mode 100644 selftest/knownfail.d/bug-16261

diff --git a/python/samba/tests/libsmb-basic.py b/python/samba/tests/libsmb-basic.py
index 20d3dd48c3c2..b7ee231f78e9 100644
--- a/python/samba/tests/libsmb-basic.py
+++ b/python/samba/tests/libsmb-basic.py
@@ -193,6 +193,36 @@ class LibsmbTestCase(samba.tests.libsmb.LibsmbTests):
         finally:
             c.deltree(testdir)
 
+    def test_rename_replace_case(self):
+        """
+        Regression test for bug 16261: Rename with ReplaceIfExists to a
+        target differing only in case must replace the existing file,
+        not create a second directory entry.
+        """
+        c = libsmb.Conn(self.server_ip, "tmp", self.lp, self.creds)
+        basedir = "test_rename_replace_case"
+
+        try:
+            c.deltree(basedir)
+        except NTSTATUSError:
+            pass
+        c.mkdir(basedir)
+
+        try:
+            c.savefile(basedir + "\\dzdz.lnk", b"old")
+            c.savefile(basedir + "\\tmpfile.tmp", b"new")
+
+            c.rename(basedir + "\\tmpfile.tmp",
+                     basedir + "\\DZDZ.lnk",
+                     replace=True)
+
+            names = [f['name'] for f in c.list(basedir)
+                     if f['name'] not in (".", "..")]
+            self.assertEqual(names, ["dzdz.lnk"])
+            self.assertEqual(c.loadfile(basedir + "\\dzdz.lnk"), b"new")
+        finally:
+            c.deltree(basedir)
+
     def test_libsmb_TortureDirCaseSensitive(self):
         c = libsmb.Conn(self.server_ip, "lowercase", self.lp, self.creds)
         c.mkdir("subdir")
diff --git a/selftest/knownfail.d/bug-16261 b/selftest/knownfail.d/bug-16261
new file mode 100644
index 000000000000..ec7a030af5a9
--- /dev/null
+++ b/selftest/knownfail.d/bug-16261
@@ -0,0 +1 @@
+test_rename_replace_case
