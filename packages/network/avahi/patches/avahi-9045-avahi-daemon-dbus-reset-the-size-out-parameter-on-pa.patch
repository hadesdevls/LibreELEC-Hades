From 6f7f7baed9c5568fc7d09c938fd93316f0238b4c Mon Sep 17 00:00:00 2001
From: Armaan Sandhu <armaan.sandhu0504@gmail.com>
Date: Sat, 17 Oct 2026 20:34:11 -0400
Subject: [PATCH] avahi-daemon/dbus: reset the size out-parameter on parse
 failure

The failure path of avahi_dbus_read_rdata() sets "size = 0", which
only clears the local pointer, so the caller's size is left
unchanged while rdata is reset to NULL. Clear *size instead.

The only caller bails out on failure, so this has no visible effect
today.
---
 avahi-daemon/dbus-util.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/avahi-daemon/dbus-util.c b/avahi-daemon/dbus-util.c
index d561302..0defb1f 100644
--- a/avahi-daemon/dbus-util.c
+++ b/avahi-daemon/dbus-util.c
@@ -348,7 +348,7 @@ fail:
     avahi_log_warn("Error parsing data");
 
     *rdata = NULL;
-    size = 0;
+    *size = 0;
     return -1;
 }
 
