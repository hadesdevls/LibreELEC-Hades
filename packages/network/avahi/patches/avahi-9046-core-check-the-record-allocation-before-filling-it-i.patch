From 3ec17dd10a583765056eea6256bd9bc8b613b06c Mon Sep 17 00:00:00 2001
From: Armaan Sandhu <armaan.sandhu0504@gmail.com>
Date: Sun, 18 Oct 2026 12:55:41 -0400
Subject: [PATCH] core: check the record allocation before filling it in

avahi_server_add_dns_server_address() writes the address into r->data right after avahi_record_new_full() and only checks r for NULL afterwards. Check it in each branch before using it, like the other record helpers in entry.c do.

With the default allocator an out-of-memory aborts before this point, but avahi_record_new_full() also returns NULL when the record name can't be normalized. The name is built in a 64 byte buffer, so a long domain name gets cut, and if the cut lands right after a backslash escape the name is invalid. For example with domain-name=my-office-network-segment\.b.example and an IPv6 DNS server to publish, the AAAA name ends in "segment\" and avahi-daemon crashes. With this change the call fails instead.
---
 avahi-core/entry.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/avahi-core/entry.c b/avahi-core/entry.c
index 06eb120..612dc47 100644
--- a/avahi-core/entry.c
+++ b/avahi-core/entry.c
@@ -987,18 +987,17 @@ int avahi_server_add_dns_server_address(
     if (address->proto == AVAHI_PROTO_INET) {
         hexstring(h, sizeof(h), &address->data, sizeof(AvahiIPv4Address));
         snprintf(n, sizeof(n), "ip-%s.%s", h, domain);
-        r = avahi_record_new_full(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_A, AVAHI_DEFAULT_TTL_HOST_NAME);
+        if (!(r = avahi_record_new_full(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_A, AVAHI_DEFAULT_TTL_HOST_NAME)))
+            return avahi_server_set_errno(s, AVAHI_ERR_NO_MEMORY);
         r->data.a.address = address->data.ipv4;
     } else {
         hexstring(h, sizeof(h), &address->data, sizeof(AvahiIPv6Address));
         snprintf(n, sizeof(n), "ip6-%s.%s", h, domain);
-        r = avahi_record_new_full(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_AAAA, AVAHI_DEFAULT_TTL_HOST_NAME);
+        if (!(r = avahi_record_new_full(n, AVAHI_DNS_CLASS_IN, AVAHI_DNS_TYPE_AAAA, AVAHI_DEFAULT_TTL_HOST_NAME)))
+            return avahi_server_set_errno(s, AVAHI_ERR_NO_MEMORY);
         r->data.aaaa.address = address->data.ipv6;
     }
 
-    if (!r)
-        return avahi_server_set_errno(s, AVAHI_ERR_NO_MEMORY);
-
     a_entry = server_add_internal(s, g, interface, protocol, AVAHI_PUBLISH_UNIQUE | AVAHI_PUBLISH_ALLOW_MULTIPLE, r);
     avahi_record_unref(r);
 
-- 
