From 5456796db28204c8dfc61b14814f52f4b3645530 Mon Sep 17 00:00:00 2001
From: Evgeny Vereshchagin <evvers@ya.ru>
Date: Mon, 22 Jun 2026 02:07:24 +0000
Subject: [PATCH] ci: add tests to make sure valid domain names can be
 normalized

The unit test makes sure the specific domain name is rejected, the fuzz
target makes sure that the invariant holds in general and the
integration test makes sure that it all actually works via D-Bus without
crashing anywhere.

Hades: the hunks for .github/workflows/smoke-tests.sh and
fuzz/fuzz-domain.c (upstream CI script and fuzz target, neither is part
of the 0.8 release tarball) are dropped. The new
avahi-common/domain-test.c check stores its result in res, which
upstream's main() has declared since commit 93b14365c1c1 ("core: no
longer supply bogus services to callbacks", not part of this series), so
the hunk also adds "int res;" to the declarations of main().
---
 avahi-common/domain-test.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/avahi-common/domain-test.c b/avahi-common/domain-test.c
index 3acc1c1..a7e081b 100644
--- a/avahi-common/domain-test.c
+++ b/avahi-common/domain-test.c
@@ -34,6 +34,7 @@ int main(AVAHI_GCC_UNUSED int argc, AVAHI_GCC_UNUSED char *argv[]) {
     const char *p;
     size_t size;
     char name[64], type[AVAHI_DOMAIN_NAME_MAX], domain[AVAHI_DOMAIN_NAME_MAX];
+    int res;
 
     printf("%s\n", s = avahi_normalize_name_strdup("foo.foo\\046."));
     avahi_free(s);
@@ -120,6 +121,15 @@ int main(AVAHI_GCC_UNUSED int argc, AVAHI_GCC_UNUSED char *argv[]) {
     assert(avahi_is_valid_domain_name("."));
     assert(avahi_is_valid_domain_name(""));
 
+    res = avahi_is_valid_domain_name(
+        "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[."
+        "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[."
+        "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[."
+        "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[."
+        "["
+    );
+    assert(!res);
+
     assert(avahi_normalize_name(".", t, sizeof(t)));
     assert(avahi_normalize_name("", t, sizeof(t)));
 
