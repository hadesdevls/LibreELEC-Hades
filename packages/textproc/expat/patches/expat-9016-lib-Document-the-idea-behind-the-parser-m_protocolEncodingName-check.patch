From ba431e267e751bfd0ed8bb608d21b0b1b52bd604 Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Sat, 17 Oct 2026 20:59:13 +0200
Subject: [PATCH] lib: Document the idea behind the
 `parser->m_protocolEncodingName` check

---
 lib/xmlparse.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/lib/xmlparse.c b/lib/xmlparse.c
index ab2d4f1e..aee6b581 100644
--- a/lib/xmlparse.c
+++ b/lib/xmlparse.c
@@ -1630,6 +1630,9 @@ XML_ParserReset(XML_Parser parser, const XML_Char *encodingName) {
   parser->m_protocolEncodingName = NULL;
   parserInit(parser, encodingName);
   dtdReset(parser->m_dtd, parser);
+
+  // NOTE: This effectively checks for `copyString` having failed during the
+  //       call to `parserInit` above
   if (encodingName && ! parser->m_protocolEncodingName) {
     parser->m_errorCode = XML_ERROR_NO_MEMORY;
     return XML_FALSE;
