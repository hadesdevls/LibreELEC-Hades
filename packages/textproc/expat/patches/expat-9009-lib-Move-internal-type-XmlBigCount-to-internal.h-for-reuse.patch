From 15df55ca8828ff2a79a8f625e716b029a1e40be2 Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Sat, 24 Oct 2026 21:50:56 +0200
Subject: [PATCH] lib: Move internal type `XmlBigCount` to `internal.h` for
 reuse

---
 lib/internal.h | 2 ++
 lib/xmlparse.c | 2 --
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/internal.h b/lib/internal.h
index de34cd7d..f41c3328 100644
--- a/lib/internal.h
+++ b/lib/internal.h
@@ -127,6 +127,8 @@ union expat_align {
 
 #  include "expat.h" // so we can use type XML_Parser below
 
+typedef unsigned long long XmlBigCount;
+
 void _INTERNAL_trim_to_complete_utf8_characters(const char *from,
                                                 const char **fromLimRef);
 
diff --git a/lib/xmlparse.c b/lib/xmlparse.c
index ee4ab7b9..cf080ae9 100644
--- a/lib/xmlparse.c
+++ b/lib/xmlparse.c
@@ -309,8 +309,6 @@ typedef struct tag {
   BINDING *bindings;
 } TAG;
 
-typedef unsigned long long XmlBigCount;
-
 typedef struct {
   const XML_Char *name;
   const XML_Char *textPtr;
