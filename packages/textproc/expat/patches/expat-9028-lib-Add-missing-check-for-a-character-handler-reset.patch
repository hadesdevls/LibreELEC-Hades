From f4ed2c1ad39cda69ee04e22ffb7174938f80e3df Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Mon, 2 Nov 2026 17:51:28 +0100
Subject: [PATCH] lib: Add missing check for a character handler reset

.. to not dereference a NULL pointer

[Hades: from libexpat master, commit f4ed2c1ad39cda69ee04e22ffb7174938f80e3df, after the release 2.10.0;
 taken on top of 2.10.0.]
---
 lib/xmlparse.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/lib/xmlparse.c b/lib/xmlparse.c
index 5b4c605..15f1bc4 100644
--- a/lib/xmlparse.c
+++ b/lib/xmlparse.c
@@ -4992,10 +4992,12 @@ doCdataSection(XML_Parser parser, const ENCODING *enc, const char **startPtr,
             const enum XML_Convert_Result convert_res = XmlConvert(
                 enc, &s, next, &dataPtr, (ICHAR *)parser->m_dataBufEnd);
             *eventEndPP = next;
-            beforeHandler(parser);
-            charDataHandler(parser->m_handlerArg, parser->m_dataBuf,
-                            (int)(dataPtr - (ICHAR *)parser->m_dataBuf));
-            afterHandler(parser);
+            if (parser->m_characterDataHandler) {
+              beforeHandler(parser);
+              charDataHandler(parser->m_handlerArg, parser->m_dataBuf,
+                              (int)(dataPtr - (ICHAR *)parser->m_dataBuf));
+              afterHandler(parser);
+            }
             if ((convert_res == XML_CONVERT_COMPLETED)
                 || (convert_res == XML_CONVERT_INPUT_INCOMPLETE))
               break;
