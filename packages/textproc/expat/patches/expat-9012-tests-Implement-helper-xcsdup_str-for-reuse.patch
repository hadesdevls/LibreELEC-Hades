From facd124e8dc8f1a0c039dda1c51a87bb3d398353 Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Mon, 26 Oct 2026 12:57:32 +0100
Subject: [PATCH] tests: Implement helper `xcsdup_str` for reuse

---
 tests/common.c | 12 ++++++++++++
 tests/common.h |  2 ++
 2 files changed, 14 insertions(+)

diff --git a/tests/common.c b/tests/common.c
index 51509a7f..2d272e12 100644
--- a/tests/common.c
+++ b/tests/common.c
@@ -339,3 +339,15 @@ portable_strndup(const char *s, size_t n) {
 
   return buffer;
 }
+
+XML_Char *
+xcsdup_str(const char *s) {
+  const size_t len = strlen(s);
+  XML_Char *const buf = calloc(len + /*terminator*/ 1, sizeof(XML_Char));
+  if (! buf)
+    return NULL;
+  XML_Char *t = buf;
+  while (*s)
+    *t++ = *s++;
+  return buf;
+}
diff --git a/tests/common.h b/tests/common.h
index a7a6bf51..2e5bd513 100644
--- a/tests/common.h
+++ b/tests/common.h
@@ -140,4 +140,6 @@ extern void *duff_reallocator(void *ptr, size_t size);
 
 extern char *portable_strndup(const char *s, size_t n);
 
+extern XML_Char *xcsdup_str(const char *s);
+
 #endif /* XML_COMMON_H */
