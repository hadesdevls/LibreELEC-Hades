From 7aa6179fc93c472c84e0e781f147147ef0501341 Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Sat, 24 Oct 2026 21:07:59 +0200
Subject: [PATCH] tests: Introduce empty test suite dedicated to internal
 entities testing

---
 CMakeLists.txt         |  1 +
 tests/Makefile.am      |  2 ++
 tests/entities_tests.c | 40 ++++++++++++++++++++++++++++++++++++++++
 tests/entities_tests.h | 41 +++++++++++++++++++++++++++++++++++++++++
 tests/runtests.c       |  2 ++
 5 files changed, 86 insertions(+)
 create mode 100644 expat/tests/entities_tests.c
 create mode 100644 expat/tests/entities_tests.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 352c9c83..acdb7c7a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -728,6 +728,7 @@ if(EXPAT_BUILD_TESTS)
         tests/dummy.c
         tests/handlers.c
         tests/hash_tests.c
+        tests/entities_tests.c
         tests/memcheck.c
         tests/minicheck.c
         tests/misc_tests.c
diff --git a/tests/Makefile.am b/tests/Makefile.am
index fcf05650..e79d58d8 100644
--- a/tests/Makefile.am
+++ b/tests/Makefile.am
@@ -50,6 +50,7 @@ runtests_SOURCES = \
     dummy.c \
     handlers.c \
     hash_tests.c \
+    entities_tests.c \
     memcheck.c \
     minicheck.c \
     misc_tests.c \
@@ -73,6 +74,7 @@ EXTRA_DIST = \
     dummy.h \
     handlers.h \
     hash_tests.h \
+    entities_tests.h \
     memcheck.h \
     minicheck.h \
     misc_tests.h \
diff --git a/tests/entities_tests.c b/tests/entities_tests.c
