From a8a0785e0d40887d451421c50947ccefa62d79c3 Mon Sep 17 00:00:00 2001
From: Sebastian Pipping <sebastian@pipping.org>
Date: Mon, 2 Nov 2026 19:43:28 +0100
Subject: [PATCH] lib: Enforce that `XML_GetInputContext*` can only be called
 from within handels

From `doc/reference.html`:
> This should only be called from within a handler during an active
> parse and the returned buffer should only be referred to from within
> the handler that made the call.

[Hades: from libexpat master, commit a8a0785e0d40887d451421c50947ccefa62d79c3, after the release 2.10.0;
 taken on top of 2.10.0.]
---
 lib/xmlparse.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/xmlparse.c b/lib/xmlparse.c
index 28f9c7b..14dd587 100644
--- a/lib/xmlparse.c
+++ b/lib/xmlparse.c
@@ -2842,7 +2842,7 @@ XML_GetCurrentByteCount(XML_Parser parser) {
 const char *XMLCALL
 XML_GetInputContext64(XML_Parser parser, int64_t *offset, uint64_t *size) {
 #if XML_CONTEXT_BYTES > 0
-  if (parser == NULL)
+  if (parser == NULL || ! isCalledFromInsideHandler(parser))
     return NULL;
   if (parser->m_eventPtr && parser->m_buffer) {
     if (offset != NULL)
@@ -2863,7 +2863,7 @@ XML_GetInputContext64(XML_Parser parser, int64_t *offset, uint64_t *size) {
 const char *XMLCALL
 XML_GetInputContext(XML_Parser parser, int *offset, int *size) {
 #if XML_CONTEXT_BYTES > 0
-  if (parser == NULL)
+  if (parser == NULL || ! isCalledFromInsideHandler(parser))
     return NULL;
 
   int64_t offset64;
