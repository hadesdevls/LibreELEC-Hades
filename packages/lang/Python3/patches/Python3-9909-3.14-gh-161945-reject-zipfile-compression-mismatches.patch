gh-161945: reject zipfile compression mismatches (GH-161948)

`ZipFile.open` now rejects a ZIP archive member whose compression fields (across the local file entry and central directory entry) disagree.
(cherry picked from commit a46c65c384b065cd596b35e93bf164e16fba68f0)

Signed-off-by: William Woodruff <william@yossarian.net>
Co-authored-by: William Woodruff <william@yossarian.net>
---
 Lib/test/test_zipfile/test_core.py                    | 11 +++++++++++
 Lib/zipfile/__init__.py                               |  7 +++++++
 .../2026-11-13-12-01-53.gh-issue-161945.X8oFTq.rst    |  3 +++
 3 files changed, 21 insertions(+)
 create mode 100644 Misc/NEWS.d/next/Library/2026-11-13-12-01-53.gh-issue-161945.X8oFTq.rst

diff --git a/Lib/test/test_zipfile/test_core.py b/Lib/test/test_zipfile/test_core.py
index 08ec019..b6759fe 100644
--- a/Lib/test/test_zipfile/test_core.py
+++ b/Lib/test/test_zipfile/test_core.py
@@ -2247,6 +2247,17 @@ class OtherTests(unittest.TestCase):
         caught."""
         self.assertRaises(NotImplementedError, zipfile.ZipFile, TESTFN, "w", -1)
 
+    def test_mismatched_compression_method(self):
+        fp = io.BytesIO()
+        with zipfile.ZipFile(fp, "w", zipfile.ZIP_STORED) as zipf:
+            zipf.writestr("foo.txt", b"hello")
+
+        fp.seek(8)  # Compression method in the local file header.
+        fp.write(struct.pack("<H", zipfile.ZIP_DEFLATED))
+        with zipfile.ZipFile(fp) as zipf:
+            with self.assertRaisesRegex(zipfile.BadZipFile, "Compression method"):
+                zipf.open("foo.txt")
+
     def test_unsupported_compression(self):
         # data is declared as shrunk, but actually deflated
         data = (b'PK\x03\x04.\x00\x00\x00\x01\x00\xe4C\xa1@\x00\x00\x00'
diff --git a/Lib/zipfile/__init__.py b/Lib/zipfile/__init__.py
index 27e2dec..7ed0a3d 100644
--- a/Lib/zipfile/__init__.py
+++ b/Lib/zipfile/__init__.py
@@ -1796,6 +1796,13 @@ class ZipFile:
                     'File name in directory %r and header %r differ.'
                     % (zinfo.orig_filename, fname))
 
+            local_method = fheader[_FH_COMPRESSION_METHOD]
+            if local_method != zinfo.compress_type:
+                raise BadZipFile(
+                    f"Compression method for {zinfo.orig_filename!r} differs "
+                    f"between the central directory ({zinfo.compress_type}) "
+                    f"and the local file header ({local_method}).")
+
             if (zinfo._end_offset is not None and
                 zef_file.tell() + zinfo.compress_size > zinfo._end_offset):
                 if zinfo._end_offset == zinfo.header_offset:
diff --git a/Misc/NEWS.d/next/Library/2026-11-13-12-01-53.gh-issue-161945.X8oFTq.rst b/Misc/NEWS.d/next/Library/2026-11-13-12-01-53.gh-issue-161945.X8oFTq.rst
new file mode 100644
index 0000000..95adcdb
--- /dev/null
+++ b/Misc/NEWS.d/next/Library/2026-11-13-12-01-53.gh-issue-161945.X8oFTq.rst
@@ -0,0 +1,3 @@
+:meth:`zipfile.ZipFile.open` now raises :exc:`~zipfile.BadZipFile` when a
+member's compression method differs between the central directory and the
+local file header.
