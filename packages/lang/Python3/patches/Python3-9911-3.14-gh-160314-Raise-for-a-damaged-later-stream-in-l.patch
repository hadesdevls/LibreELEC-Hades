diff --git a/Lib/bz2.py b/Lib/bz2.py
index eb58f4d..f4f3cda 100644
--- a/Lib/bz2.py
+++ b/Lib/bz2.py
@@ -22,6 +22,9 @@ _MODE_READ     = 1
 # Value 2 no longer used
 _MODE_WRITE    = 3
 
+# Every bzip2 stream starts with one of these, "BZh" and the block size.
+_STREAM_MAGIC = (b'BZh1', b'BZh2', b'BZh3', b'BZh4', b'BZh5', b'BZh6', b'BZh7', b'BZh8', b'BZh9')
+
 
 class BZ2File(_streams.BaseStream):
 
@@ -89,7 +92,8 @@ class BZ2File(_streams.BaseStream):
 
         if self._mode == _MODE_READ:
             raw = _streams.DecompressReader(self._fp,
-                BZ2Decompressor, trailing_error=OSError)
+                BZ2Decompressor, trailing_error=OSError,
+                stream_magic=_STREAM_MAGIC)
             self._buffer = io.BufferedReader(raw)
         else:
             self._pos = 0
@@ -340,10 +344,11 @@ def decompress(data):
         try:
             res = decomp.decompress(data)
         except OSError:
-            if results:
-                break  # Leftover data is not a valid bzip2 stream; ignore it.
-            else:
+            if not results:
                 raise  # Error on the first iteration; bail out.
+            if data.startswith(_STREAM_MAGIC):
+                raise  # Leftover data is a damaged bzip2 stream; bail out.
+            break  # Leftover data is not a valid bzip2 stream; ignore it.
         results.append(res)
         if not decomp.eof:
             raise ValueError("Compressed data ended before the "
diff --git a/Lib/compression/_common/_streams.py b/Lib/compression/_common/_streams.py
index 9f367d4..09c6550 100644
--- a/Lib/compression/_common/_streams.py
+++ b/Lib/compression/_common/_streams.py
@@ -36,7 +36,8 @@ class DecompressReader(io.RawIOBase):
     def readable(self):
         return True
 
-    def __init__(self, fp, decomp_factory, trailing_error=(), **decomp_args):
+    def __init__(self, fp, decomp_factory, trailing_error=(), *,
+                 stream_magic=(), **decomp_args):
         self._fp = fp
         self._eof = False
         self._pos = 0  # Current offset in decompressed stream
@@ -56,6 +57,11 @@ class DecompressReader(io.RawIOBase):
         # trailing data to ignore
         self._trailing_error = trailing_error
 
+        # Prefix (or tuple of prefixes) that every compressed stream starts
+        # with, if the format has one.  Data starting with it is a damaged
+        # stream rather than trailing data, so its error is not ignored.
+        self._stream_magic = stream_magic
+
     def close(self):
         self._decompressor = None
         return super().close()
@@ -90,6 +96,9 @@ class DecompressReader(io.RawIOBase):
                 try:
                     data = self._decompressor.decompress(rawblock, size)
                 except self._trailing_error:
+                    if (self._stream_magic
+                            and rawblock.startswith(self._stream_magic)):
+                        raise  # Damaged stream, not trailing data.
                     # Trailing data isn't a valid compressed stream; ignore it.
                     break
             else:
diff --git a/Lib/lzma.py b/Lib/lzma.py
index 316066d..b023c87 100644
--- a/Lib/lzma.py
+++ b/Lib/lzma.py
@@ -35,6 +35,13 @@ _MODE_READ     = 1
 _MODE_WRITE    = 3
 
 
+def _stream_magic(format):
+    # Every stream of an .xz file starts with these bytes.  The other
+    # formats, including an .lzma stream read with FORMAT_AUTO, have
+    # nothing that tells a damaged stream from trailing data.
+    return b"\xfd7zXZ\x00" if format in (FORMAT_AUTO, FORMAT_XZ) else b""
+
+
 class LZMAFile(_streams.BaseStream):
 
     """A file object providing transparent LZMA (de)compression.
@@ -128,7 +135,8 @@ class LZMAFile(_streams.BaseStream):
 
         if self._mode == _MODE_READ:
             raw = _streams.DecompressReader(self._fp, LZMADecompressor,
-                trailing_error=LZMAError, format=format, filters=filters)
+                trailing_error=LZMAError, stream_magic=_stream_magic(format),
+                format=format, filters=filters)
             self._buffer = io.BufferedReader(raw)
 
     def close(self):
@@ -345,15 +353,17 @@ def decompress(data, format=FORMAT_AUTO, memlimit=None, filters=None):
     For incremental decompression, use an LZMADecompressor instead.
     """
     results = []
+    magic = _stream_magic(format)
     while True:
         decomp = LZMADecompressor(format, memlimit, filters)
         try:
             res = decomp.decompress(data)
         except LZMAError:
-            if results:
-                break  # Leftover data is not a valid LZMA/XZ stream; ignore it.
-            else:
+            if not results:
                 raise  # Error on the first iteration; bail out.
+            if magic and data.startswith(magic):
+                raise  # Leftover data is a damaged XZ stream; bail out.
+            break  # Leftover data is not a valid LZMA/XZ stream; ignore it.
         results.append(res)
         if not decomp.eof:
             raise LZMAError("Compressed data ended before the "
diff --git a/Lib/test/test_bz2.py b/Lib/test/test_bz2.py
index 64293d7..5a6f7fe 100644
--- a/Lib/test/test_bz2.py
+++ b/Lib/test/test_bz2.py
@@ -156,6 +156,22 @@ class BZ2FileTest(BaseTest):
         with BZ2File(self.filename) as bz2f:
             self.assertEqual(bz2f.read(), self.TEXT * 5)
 
+    def testReadMultiStreamDamagedStream(self):
+        # A damaged bzip2 stream following a valid one is not trailing junk,
+        # whatever the size of the reads.
+        for pos in 4, 100, -3:
+            with self.subTest(pos=pos):
+                damaged = bytearray(self.DATA)
+                damaged[pos] ^= 1
+                self.createTempFile(suffix=damaged)
+                with BZ2File(self.filename) as bz2f:
+                    self.assertRaises(OSError, bz2f.read)
+                with BZ2File(self.filename) as bz2f:
+                    self.assertEqual(bz2f.read(len(self.TEXT)), self.TEXT)
+                    with self.assertRaises(OSError):
+                        while bz2f.read(10):
+                            pass
+
     def testRead0(self):
         self.createTempFile()
         with BZ2File(self.filename) as bz2f:
@@ -1100,6 +1116,18 @@ class CompressDecompressTest(BaseTest):
         text = bz2.decompress(self.DATA * 5 + self.BAD_DATA)
         self.assertEqual(text, self.TEXT * 5)
 
+    def testDecompressMultiStreamDamagedStream(self):
+        # A damaged bzip2 stream following a valid one is not trailing junk.
+        for pos in 4, 100, -3:
+            with self.subTest(pos=pos):
+                damaged = bytearray(self.DATA)
+                damaged[pos] ^= 1
+                self.assertRaises(OSError, bz2.decompress,
+                                  self.DATA + damaged)
+        # Not a bzip2 header: the block size digit must be 1 to 9.
+        text = bz2.decompress(self.DATA + b"BZh0" + self.BAD_DATA)
+        self.assertEqual(text, self.TEXT)
+
 
 class OpenTest(BaseTest):
     "Test the open function."
