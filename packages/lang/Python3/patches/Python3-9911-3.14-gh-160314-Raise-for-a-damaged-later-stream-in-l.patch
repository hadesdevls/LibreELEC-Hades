 Lib/compression/_common/_streams.py           | 11 ++++++-
 Lib/lzma.py                                   | 18 +++++++++---
 Lib/test/test_bz2.py                          | 28 ++++++++++++++++++
 Lib/test/test_lzma.py                         | 29 +++++++++++++++++++
