+ */
+int ff_h264_decode_subset_seq_parameter_set(GetBitContext *gb, AVCodecContext *avctx,
+                                            H264ParamSets *ps);
+
 /**
  * Decode PPS
  */
@@ -172,6 +220,20 @@ int ff_h264_decode_picture_parameter_set(GetBitContext *gb, AVCodecContext *avct
 /**
  * Uninit H264 param sets structure.
  */
+/**
+ * The subset SPS that a coded slice extension referring to @p pps activates,
+ * or NULL if there is none, cf. H.7.4.1.2.1.
+ *
+ * Resolved on use rather than cached in the PPS: a subset SPS may be replaced at
