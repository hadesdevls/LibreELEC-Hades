From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:35:47 +0000
Subject: [PATCH] avcodec/h264: read the PPS of a dependent view against its
 subset SPS

A PPS is interpreted with the SPS that it activates (H.7.4.1.2.1), and
part of what the decoder keeps of it is derived from that SPS: the
scaling matrices (where the PPS does not carry a list, the fall-back
rule depends on whether the SPS has a matrix, 7.4.2.2), the tables
made from them, the quantiser offsets of the bit depth. The series
reads a PPS against the ordinary SPS with its id where there is one,
the base view's. Where a subset SPS shares that id, as in the streams
of the reference encoder (SPS 0, subset SPS 0, one PPS for both views),
a dependent view was decoded with the base view's tables. The series
meant to leave multiview alone there when the two SPSs differ
(PPS.mvc_unsupported), but nothing reads that flag, and its test left
the fall-back rule out. The same happened where a subset SPS is
replaced (a new coded video sequence) and the PPS is not sent again:
the PPS kept what it had derived from the old one.

Now h264_init_ps() gives a dependent view its PPS read again against
the subset SPS that the view activates, when the PPS was read against
another one. The reading is the parser's own
(ff_h264_pps_for_sps(): ff_h264_decode_picture_parameter_set() on a
set of parameter sets that holds that one SPS), from the bytes that the
PPS keeps; the PPS so made is kept for the next pictures of the view,
by the thread that made it. The flag and its test go. A base view, and
a dependent view whose PPS was read against its own subset SPS (the
layout of the ITU-T conformance streams, with ids of their own), are
decoded as before.

Measured against the reference decoder (JM 19.1), with streams made on
purpose from one that the reference encoder wrote (960x540, ids
shared) and from MVCSPS-1 of the ITU-T H.264.1 conformance set; only
their parameter sets were changed. The subset SPS with the default
matrices; with an invented pair of lists; with flat lists written out,
and the PPS with a matrix that carries no list (the base view falls
back to the defaults, the dependent view to the flat lists, though the
matrices of the two SPSs compare equal); and the stream twice, its
subset SPS without a matrix in the first copy, the second copy without
its PPSs. Without this change the second view differed from JM's in
every picture of each (of the second copy, in the last), with one
thread, 2 and 8 frame threads and 8 slice threads; with it, both views
are JM's in all of them. The ITU-T streams and the two streams of the
reference encoder: unchanged.
---
diff --git a/libavcodec/h264_ps.c b/libavcodec/h264_ps.c
--- a/libavcodec/h264_ps.c
+++ b/libavcodec/h264_ps.c
@@ -849,6 +849,7 @@ static void pps_free(AVRefStructOpaque unused, void *obj)
     PPS *pps = obj;
 
     av_refstruct_unref(&pps->sps);
+    av_refstruct_unref(&pps->src);
 }
 
 int ff_h264_decode_picture_parameter_set(GetBitContext *gb, AVCodecContext *avctx,
@@ -884,11 +885,12 @@ int ff_h264_decode_picture_parameter_set(GetBitContext *gb, AVCodecContext *avct
         pps->data[pps->data_size++] = 0x80;
 
     pps->pps_id = pps_id;
+    pps->bit_length = bit_length;
     pps->sps_id = get_ue_golomb_31(gb);
     /* A PPS referenced by a coded slice extension (NAL 20) refers to a subset
-     * SPS, which lives in its own id space. As the two spaces are disjoint in
-     * practice we cannot tell from the PPS alone which one is meant, so resolve
-     * against both and let the slice header pick by NAL type. */
+     * SPS, which lives in its own id space. Nothing in the PPS says which space
+     * is meant, so resolve against both and let the slice header pick by NAL
+     * type. */
     if ((unsigned)pps->sps_id >= MAX_SPS_COUNT ||
         (!ps->sps_list[pps->sps_id] && !ps->subset_sps_list[pps->sps_id])) {
         av_log(avctx, AV_LOG_ERROR, "sps_id %u out of range\n", pps->sps_id);
@@ -902,28 +904,13 @@ int ff_h264_decode_picture_parameter_set(GetBitContext *gb, AVCodecContext *avct
                                     ps->subset_sps_list[pps->sps_id]);
     sps = pps->sps;
 
-    /* The scaling matrices and the tables derived from them below come from
-     * ::sps. When an ordinary and a subset SPS share an id the two views would
-     * need separate tables, which is not supported, so leave multiview alone for
-     * this picture parameter set rather than decode a dependent view with the
-     * base view's tables. */
-    if (ps->sps_list[pps->sps_id] && ps->subset_sps_list[pps->sps_id]) {
-        const SPS *mvc = ps->subset_sps_list[pps->sps_id];
-
-        if (mvc->bit_depth_luma    != sps->bit_depth_luma    ||
-            mvc->bit_depth_chroma  != sps->bit_depth_chroma  ||
-            mvc->chroma_format_idc != sps->chroma_format_idc ||
-            mvc->transform_bypass  != sps->transform_bypass  ||
-            memcmp(mvc->scaling_matrix4, sps->scaling_matrix4,
-                   sizeof(sps->scaling_matrix4)) ||
-            memcmp(mvc->scaling_matrix8, sps->scaling_matrix8,
-                   sizeof(sps->scaling_matrix8))) {
-            avpriv_report_missing_feature(avctx,
-                "PPS %u shared between an ordinary and an incompatible subset SPS",
-                pps_id);
-            pps->mvc_unsupported = 1;
-        }
-    }
+    /* What follows is read and derived against ::sps: the scaling matrices and
+     * their fall-back rule, the tables made from them, the quantiser offsets of
+     * the bit depth. Where an ordinary and a subset SPS share this id that is the
+     * ordinary one, the base view's. A dependent view activates the subset SPS,
+     * and h264_init_ps() gives it this PPS read again against that one
+     * (ff_h264_pps_for_sps()), as it does where the subset SPS was replaced
+     * after this PPS was read. */
 
     if (sps->bit_depth_luma > 14) {
         av_log(avctx, AV_LOG_ERROR,
@@ -1032,3 +1019,39 @@ fail:
     av_refstruct_unref(&pps);
     return ret;
 }
+
+int ff_h264_pps_for_sps(const PPS *src, const SPS *sps, AVCodecContext *avctx,
+                        const PPS **out)
+{
+    H264ParamSets tmp = { 0 };
+    GetBitContext gb;
+    PPS *pps;
+    int ret;
+
+    /* ::data holds the NAL unit from its header byte on, ::bit_length bits of
+     * it. A PPS too long to have been kept whole cannot be read again. */
+    if (src->bit_length <= 8 || src->bit_length > 8 * (int64_t)src->data_size)
+        return AVERROR_PATCHWELCOME;
+    ret = init_get_bits(&gb, src->data, src->bit_length);
+    if (ret < 0)
+        return ret;
+    skip_bits(&gb, 8);
+
+    /* The parser itself, on a set of parameter sets that holds this one SPS
+     * under the id the PPS names: the same reading, against that SPS. The SPS
+     * is lent to it, not referenced by it, and taken back before anything
+     * else could see it. */
+    tmp.sps_list[src->sps_id] = sps;
+    ret = ff_h264_decode_picture_parameter_set(&gb, avctx, &tmp, src->bit_length);
+    tmp.sps_list[src->sps_id] = NULL;
+    pps = (PPS *)tmp.pps_list[src->pps_id];
+    tmp.pps_list[src->pps_id] = NULL;
+    if (ret < 0 || !pps) {
+        av_refstruct_unref(&pps);
+        return ret < 0 ? ret : AVERROR_BUG;
+    }
+
+    pps->src = av_refstruct_ref_c(src);
+    *out = pps;
+    return 0;
+}
diff --git a/libavcodec/h264_ps.h b/libavcodec/h264_ps.h
--- a/libavcodec/h264_ps.h
+++ b/libavcodec/h264_ps.h
@@ -172,9 +172,13 @@ typedef struct PPS {
     uint32_t(*dequant8_coeff[6])[64];
 
     const SPS   *sps; ///< RefStruct reference
-    /** set when this PPS cannot serve a dependent view, see its parser */
-    int mvc_unsupported;
-
+    /** what the parser was given as the bit length of the NAL unit (data holds it) */
+    int bit_length;
+    /**
+     * RefStruct reference, set in a PPS made by ff_h264_pps_for_sps() only: the
+     * PPS of the list that this one is, read again against another SPS.
+     */
+    const struct PPS *src;
 } PPS;
 
 typedef struct H264ParamSets {
@@ -217,6 +221,20 @@ int ff_h264_decode_subset_seq_parameter_set(GetBitContext *gb, AVCodecContext *a
 int ff_h264_decode_picture_parameter_set(GetBitContext *gb, AVCodecContext *avctx,
                                          H264ParamSets *ps, int bit_length);
 
+/**
+ * The PPS @p src read again against @p sps, as a new PPS (*out, a RefStruct
+ * reference, with ::src set).
+ *
+ * A PPS is interpreted with the SPS it activates (H.7.4.1.2.1), and part of what
+ * it holds is derived from that SPS: its scaling matrices (the fall-back rule of
+ * a list it does not carry depends on whether the SPS has a matrix, 7.4.2.2),
+ * the tables made from them, the quantiser offsets of the bit depth. Where a
+ * subset SPS shares its id with an ordinary one the parser reads the PPS against
+ * the ordinary one, the base view's; a dependent view activates the subset SPS.
+ */
+int ff_h264_pps_for_sps(const PPS *src, const SPS *sps, AVCodecContext *avctx,
+                        const PPS **out);
+
 /**
  * Uninit H264 param sets structure.
  */
diff --git a/libavcodec/h264_slice.c b/libavcodec/h264_slice.c
--- a/libavcodec/h264_slice.c
+++ b/libavcodec/h264_slice.c
@@ -1356,6 +1356,32 @@ static enum AVPixelFormat non_j_pixfmt(enum AVPixelFormat a)
     }
 }
 
+/**
+ * Make the active PPS the one of a dependent view read again against @p sps,
+ * the subset SPS that view activates (see h264_init_ps()). The PPS so made is
+ * kept: where a view needs it, it needs it at every picture.
+ */
+static int view_pps(H264Context *h, const SPS *sps)
+{
+    const PPS *src = h->ps.pps->src ? h->ps.pps->src : h->ps.pps;
+
+    if (!h->view_pps || h->view_pps->src != src || h->view_pps->sps != sps) {
+        const PPS *pps;
+        int ret = ff_h264_pps_for_sps(src, sps, h->avctx, &pps);
+
+        if (ret < 0) {
+            av_log(h->avctx, AV_LOG_ERROR,
+                   "PPS %u cannot be read against the subset SPS of its view\n",
+                   src->pps_id);
+            return ret;
+        }
+        av_refstruct_unref(&h->view_pps);
+        h->view_pps = pps;
+    }
+    av_refstruct_replace(&h->ps.pps, h->view_pps);
+    return 0;
+}
+
 static int h264_init_ps(H264Context *h, const H264SliceContext *sl, int first_slice)
 {
     const SPS *sps;
@@ -1385,6 +1411,18 @@ static int h264_init_ps(H264Context *h, const H264SliceContext *sl, int first_sl
         }
 
         h->ps.sps = mvc_sps;
+
+        /* The PPS was read against another SPS than the one this view
+         * activates: the ordinary SPS that shares its id, or a subset SPS that
+         * has been replaced since. What it derives from that SPS -- the scaling
+         * matrices and their fall-back, the tables made from them -- would be
+         * the wrong ones here, so this view is decoded with the PPS read again
+         * against its own SPS (H.7.4.1.2.1). */
+        if (h->ps.pps->sps != mvc_sps) {
+            ret = view_pps(h, mvc_sps);
+            if (ret < 0)
+                return ret;
+        }
         return 0;
     }
 
@@ -2736,9 +2774,12 @@ int ff_h264_queue_decode_slice(H264Context *h, const H2645NAL *nal)
 
     if (!first_slice) {
         const PPS *pps = h->ps.pps_list[sl->pps_id];
+        /* a dependent view may be decoded with its PPS read again
+         * (view_pps()): compare what the list holds with what the list held */
+        const PPS *cur = h->ps.pps->src ? h->ps.pps->src : h->ps.pps;
 
-        if (h->ps.pps->sps_id != pps->sps_id ||
-            h->ps.pps->transform_8x8_mode != pps->transform_8x8_mode /*||
+        if (cur->sps_id != pps->sps_id ||
+            cur->transform_8x8_mode != pps->transform_8x8_mode /*||
             (h->setup_finished && h->ps.pps != pps)*/) {
             av_log(h->avctx, AV_LOG_ERROR, "PPS changed between slices\n");
             return AVERROR_INVALIDDATA;
diff --git a/libavcodec/h264dec.c b/libavcodec/h264dec.c
--- a/libavcodec/h264dec.c
+++ b/libavcodec/h264dec.c
@@ -381,6 +381,7 @@ static av_cold int h264_decode_end(AVCodecContext *avctx)
 
     ff_h264_sei_uninit(&h->sei);
     ff_h264_ps_uninit(&h->ps);
+    av_refstruct_unref(&h->view_pps);
 
     ff_h2645_packet_uninit(&h->pkt);
 
diff --git a/libavcodec/h264dec.h b/libavcodec/h264dec.h
--- a/libavcodec/h264dec.h
+++ b/libavcodec/h264dec.h
@@ -626,6 +626,13 @@ typedef struct H264Context {
      */
     const SPS *mvc_sps;
 
+    /**
+     * RefStruct reference: the last PPS that a dependent view needed read again
+     * against its subset SPS (ff_h264_pps_for_sps()), kept for the pictures
+     * after it. Of this thread's own: not handed on to the next frame thread.
+     */
+    const PPS *view_pps;
+
     /** Per-view decoding state, indexed by view order index (VOIdx). */
     H264ViewContext views[H264_MAX_MVC_VIEWS];
 
