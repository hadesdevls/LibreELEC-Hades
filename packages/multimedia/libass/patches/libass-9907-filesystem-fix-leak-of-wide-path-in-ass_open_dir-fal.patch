From 841c52561c39df6767e3948efa8e5307efb11f1f Mon Sep 17 00:00:00 2001
From: Zibran Khan <kali834x@gmail.com>
Date: Sat, 21 Nov 2026 13:49:42 +0530
Subject: [PATCH] filesystem: fix leak of wide path in ass_open_dir fallback

When the path is not valid WTF-8, ass_open_dir on Windows converts it
from the ANSI code page into a temporary WCHAR buffer for
FindFirstFileExW. That buffer was only freed if FindFirstFileExW
failed, so it leaked on success and when allocating dir->path failed.
Free it after its last use, as open_dir_wtf8 already does.

Upstream: https://github.com/libass/libass/commit/841c52561c39df6767e3948efa8e5307efb11f1f
---
 libass/ass_filesystem.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libass/ass_filesystem.c b/libass/ass_filesystem.c
index 85a8a08..57482a2 100644
--- a/libass/ass_filesystem.c
+++ b/libass/ass_filesystem.c
@@ -369,10 +369,12 @@ bool ass_open_dir(ASS_Dir *dir, const char *path)
     if (!check_add_size_wtf16to8(&size, wlen) || !check_add_size_wtf16to8(&size, wlen1) ||
             !(dir->path = malloc(size))) {
         FindClose(dir->handle);
+        free(wpath);
         return false;
     }
     dir->max_path = size;
     char *ptr = convert_wtf16to8(dir->path, wpath, wlen);
+    free(wpath);
     if (add_separator)
         *ptr++ = '\\';
     convert_wtf16to8(ptr, data.cFileName, wlen1 + 1);
