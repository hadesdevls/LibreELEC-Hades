From fe25f50686b1a6babef2f9b703abead0e97e0fec Mon Sep 17 00:00:00 2001
From: Zibran Khan <kali834x@gmail.com>
Date: Thu, 22 Oct 2026 10:44:46 +0530
Subject: [PATCH] ass: guard against size overflow in ass_read_memory copy

bufsize + 1 wraps to 0 for bufsize == SIZE_MAX, so check before
allocating space for the terminating NUL, as ass_load_file does.

Upstream: https://github.com/libass/libass/commit/fe25f50686b1a6babef2f9b703abead0e97e0fec
---
 libass/ass.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libass/ass.c b/libass/ass.c
index 94116a4..4162dce 100644
--- a/libass/ass.c
+++ b/libass/ass.c
@@ -1620,6 +1620,8 @@ ASS_Track *ass_read_memory(ASS_Library *library, char *buf,
     }
 #endif
     if (!copied) {
+        if (bufsize == SIZE_MAX)
+            return 0;
         char *newbuf = malloc(bufsize + 1);
         if (!newbuf)
             return 0;
