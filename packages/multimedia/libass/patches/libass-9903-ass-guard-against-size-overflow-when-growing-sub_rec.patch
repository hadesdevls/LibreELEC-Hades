From 1f0f8e344b30b27123bf9801d337448f68e18449 Mon Sep 17 00:00:00 2001
From: Zibran Khan <kali834x@gmail.com>
Date: Wed, 21 Oct 2026 15:07:51 +0530
Subject: [PATCH] ass: guard against size overflow when growing sub_recode
 buffer

osize + size can overflow size_t for very large inputs. Fail the
recode instead of calling realloc with a wrapped size.

Upstream: https://github.com/libass/libass/commit/1f0f8e344b30b27123bf9801d337448f68e18449
---
 libass/ass.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/libass/ass.c b/libass/ass.c
index 646ec43..94116a4 100644
--- a/libass/ass.c
+++ b/libass/ass.c
@@ -1471,7 +1471,9 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
             if (rc == (size_t) (-1)) {
                 if (errno == E2BIG) {
                     size_t offset = op - outbuf;
-                    char *nbuf = realloc(outbuf, osize + size);
+                    char *nbuf = NULL;
+                    if (size <= SIZE_MAX - osize)
+                        nbuf = realloc(outbuf, osize + size);
                     if (!nbuf) {
                         free(outbuf);
                         outbuf = 0;
