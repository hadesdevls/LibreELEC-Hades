From d4fa710425240cc1c1fcee1815041263bf83c745 Mon Sep 17 00:00:00 2001
From: Zibran Khan <kali834x@gmail.com>
Date: Tue, 20 Oct 2026 18:20:20 +0530
Subject: [PATCH] ass: fix out-of-bounds write in sub_recode on empty input

sub_recode reserved the space for the terminating NUL inside the
input-sized buffer (osize = size, oleft = size - 1). With an empty
input, e.g. a 0-byte subtitle file opened with a codepage, this
allocates zero bytes and wraps oleft to SIZE_MAX, so the final
outbuf[osize - oleft - 1] = 0 writes to outbuf[0] of a zero-byte
allocation, and iconv's state reset gets SIZE_MAX of output space.

Reserve the terminator on top of the input size instead.

Upstream: https://github.com/libass/libass/commit/d4fa710425240cc1c1fcee1815041263bf83c745
---
 libass/ass.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/libass/ass.c b/libass/ass.c
index b9ce811..646ec43 100644
--- a/libass/ass.c
+++ b/libass/ass.c
@@ -1433,7 +1433,7 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
 {
     iconv_t icdsc;
     char *tocp = "UTF-8";
-    char *outbuf;
+    char *outbuf = NULL;
     assert(codepage);
 
     if ((icdsc = iconv_open(tocp, codepage)) != (iconv_t) (-1)) {
@@ -1443,10 +1443,13 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
         return NULL;
     }
 
+    if (size == SIZE_MAX)
+        goto out;
+
     {
-        size_t osize = size;
+        size_t osize = size + 1;
         size_t ileft = size;
-        size_t oleft = size - 1;
+        size_t oleft = size;
         char *ip;
         char *op;
         size_t rc;
