                 hvc = hvcArray[i];
+            }
+        }
         return getS3DConfiguration(hvc, hvct);
     }
 
@@ -68,12 +74,16 @@ public class HVideoDevice extends HScreenDevice {
         int score = -1;
         HVideoConfiguration hvc = null;
         HVideoConfigTemplate hvct = null;
-        for (int i = 0; i < hvcArray.length; i++) 
-            for (int j = 0; j < hvcta.length; j++)
-                if (hvcta[j].match(hvcArray[i]) > score) {
+        /* Hades: the configuration that matches one of the templates best, the first on a tie */
+        for (int i = 0; i < hvcArray.length; i++)
+            for (int j = 0; j < hvcta.length; j++) {
+                int s = hvcta[j].match(hvcArray[i]);
+                if (s > score) {
+                    score = s;
                     hvc = hvcArray[i];
