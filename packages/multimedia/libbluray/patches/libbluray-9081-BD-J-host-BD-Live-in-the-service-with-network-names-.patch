+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The host's side of BD-Live (bdr_net.h, bdlive_bdj.h): only in the service with network
+ * (HADES_BDJ_NETWORK=internet, which hades-bdj-net@.service sets) and only with BD-Live on in
+ * the player. Then the JVM gets the resolver of org.videolan.hades.bdlive (a module of its own,
+ * JEP 418), whose one native method asks the player for the addresses of a name.
+ */
+
+#if HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "bdr_net.h"
+
+#include "libbluray/bdj/bdj.h"
+#include "libbluray/bdj/bdj_sandbox.h"
+#include "libbluray/bdj/bdlive_bdj.h"
+#include "util/logging.h"
+#include "util/strutl.h"
+
+#include <jni.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define BDLIVE_MODULE      "org.videolan.hades.bdlive"
+#define BDLIVE_NATIVES     "org/videolan/hades/bdlive/Natives"
+#define BDLIVE_JAR_DEFAULT "/usr/lib/hades-bdj/hades-bdlive.jar"
+
+int bdr_net_resolve(const char *name, uint8_t addr[][4], int max)
+{
+    BDR_RESOLVE_MSG m;
+    BDR_FILE_REPLY_MSG rep;
+    uint8_t *payload = NULL;
+    uint32_t len = 0;
+    size_t nlen = strlen(name) + 1;
+    int n;
+
+    if (!bdlive_host_networked() || nlen > BDR_NET_MAX_NAME) {
+        return BDR_NET_OFF;
+    }
+    m.nlen = (uint32_t)nlen;
+    if (bdr_server_ask(BDR_RESOLVE, &m, sizeof(m), name, nlen, BDR_NET_TIMEOUT_S, &payload, &len) < 0) {
+        return BDR_NET_NOT_FOUND;
+    }
+    if (len < sizeof(rep)) {
+        free(payload);
+        return BDR_NET_NOT_FOUND;
+    }
+    memcpy(&rep, payload, sizeof(rep));
+    if (rep.ret <= 0) {
+        free(payload);
+        return rep.ret < 0 && rep.ret >= BDR_NET_BUSY ? (int)rep.ret : BDR_NET_NOT_FOUND;
+    }
+    if (rep.ret > BDR_NET_MAX_ADDR || rep.dlen != rep.ret * 4 || len != sizeof(rep) + rep.dlen) {
+        free(payload);
+        return BDR_NET_NOT_FOUND;
+    }
+    n = (int)rep.ret < max ? (int)rep.ret : max;
+    memcpy(addr, payload + sizeof(rep), (size_t)n * 4);
+    free(payload);
+    return n;
+}
+
+int bdlive_host_networked(void)
+{
+    const char *net = getenv(HADES_BDJ_NETWORK_ENV);
+    return net && !strcmp(net, HADES_BDJ_NETWORK_INTERNET) && getenv("HADES_BDJ_BDLIVE_LOCAL") != NULL;
+}
+
+/* org.videolan.hades.bdlive.Natives.resolve0(String): the IPv4 addresses (4 bytes each), or null */
+static jobjectArray JNICALL _resolve0(JNIEnv *env, jclass cls, jstring jname)
+{
+    uint8_t addr[BDR_NET_MAX_ADDR][4];
+    const char *name;
+    jobjectArray result = NULL;
+    jclass bytes;
+    int n, i;
+
+    (void)cls;
+    if (!jname) {
+        return NULL;
+    }
+    name = (*env)->GetStringUTFChars(env, jname, NULL);
+    if (!name) {
+        return NULL;
+    }
+    n = bdr_net_name_ok(name, strlen(name)) ? bdr_net_resolve(name, addr, BDR_NET_MAX_ADDR) : BDR_NET_BAD_NAME;
+    (*env)->ReleaseStringUTFChars(env, jname, name);
+    if (n <= 0) {
+        return NULL;
+    }
+    bytes = (*env)->FindClass(env, "[B");
+    if (!bytes) {
+        return NULL;
+    }
+    result = (*env)->NewObjectArray(env, n, bytes, NULL);
+    for (i = 0; result && i < n; i++) {
+        jbyteArray a = (*env)->NewByteArray(env, 4);
+        if (!a) {
+            return NULL;
+        }
+        (*env)->SetByteArrayRegion(env, a, 0, 4, (const jbyte *)addr[i]);
+        (*env)->SetObjectArrayElement(env, result, i, a);
+        (*env)->DeleteLocalRef(env, a);
+    }
+    return result;
+}
+
+int bdlive_bdj_register(void *jni_env)
+{
+    JNIEnv *env = (JNIEnv *)jni_env;
+    static char name[] = "resolve0";
+    static char signature[] = "(Ljava/lang/String;)[[B";
+    JNINativeMethod methods[1];
+    jclass cls;
+
+    methods[0].name      = name;
+    methods[0].signature = signature;
+    methods[0].fnPtr     = (void *)_resolve0;
+
+    if (!bdlive_host_networked()) {
+        return 0;
+    }
+    cls = (*env)->FindClass(env, BDLIVE_NATIVES);
+    if (!cls) {
+        (*env)->ExceptionClear(env);
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the resolver of " BDLIVE_MODULE " is not in this JVM: no names "
+                 "are resolved\n");
+        return -1;
+    }
+    if ((*env)->RegisterNatives(env, cls, methods, 1) != 0) {
+        (*env)->ExceptionClear(env);
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the resolver's native method could not be registered\n");
+        return -1;
+    }
+    return 0;
+}
+
+int bdlive_bdj_jvm_options(const BDJ_CONFIG *cfg, char **opt, int max)
+{
+    const char *jar = getenv("HADES_BDJ_BDLIVE_JAR");
+    int n = 0;
+
+    if (max < 5) {
+        return 0;
+    }
+    if (!cfg->network_internet || !bdlive_host_networked()) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: off%s\n", cfg->network_internet ?
+                 " (the BD-J service of this disc has no network)" : "");
+        return 0;
+    }
+    if (!jar || !jar[0]) {
+        jar = BDLIVE_JAR_DEFAULT;
+    }
+    if (access(jar, R_OK) != 0) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: off (%s is not there)\n", jar);
+        return 0;
+    }
+    /* org.videolan.Libbluray reads it: "bluray.network.connected" is YES only then */
+    opt[n++] = str_dup("-Dorg.videolan.hades.bdlive=true");
+    /* sockets of IPv4 only (the seccomp filter of the service refuses the others) */
+    opt[n++] = str_dup("-Djava.net.preferIPv4Stack=true");
+    opt[n++] = str_printf("--module-path=%s", jar);
+    opt[n++] = str_dup("--add-modules=" BDLIVE_MODULE);
+    /* its one native method (Java 24 and later: only this module, never the disc's code) */
+    opt[n++] = str_dup("--enable-native-access=" BDLIVE_MODULE);
+    BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: on: the disc may connect to the Internet only, names resolved by the "
+             "player\n");
+    return n;
+}
