 }
+
+/* Hades, BD-Live (bdr_net_server.c): a request of the host to the player, answered with a
+   BDR_FILE_REPLY: its payload (free()) and 0, or -1 */
+int bdr_server_ask(uint16_t type, const void *p1, size_t l1, const void *p2, size_t l2,
+                   int timeout_s, uint8_t **payload, uint32_t *len)
+{
+    BDR_SERVER *s = g_srv;
+
+    *payload = NULL;
+    *len = 0;
+    if (!s) {
+        return -1;
+    }
+    return _request(s, type, BDR_FILE_REPLY, p1, l1, p2, l2, timeout_s, payload, len);
+}
