+
+/*
+ * BD-Live through the isolated BD-J host: the host has network only towards the Internet, and no
+ * name server (the name server of a home network is on that network, or on this system). Names
+ * are resolved by the player, which has both, and it answers only with addresses BD-Live may
+ * reach (bdlive_net.h): a name that leads to this system or its network gets no address at all
+ * (that is also what keeps a name that changes its address, DNS rebinding, from leading there).
+ *
+ * BDR_RESOLVE (host -> player): BDR_RESOLVE_MSG + the name; the answer is a BDR_FILE_REPLY with
+ * ret = the number of IPv4 addresses (4 bytes each, network order, in data), or a BDR_NET_* < 0.
+ */
+
+#ifndef BDR_NET_H_
+#define BDR_NET_H_
+
+#include "bdr_protocol.h"
+
+#include "util/attributes.h"
+
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define BDR_NET_MAX_NAME   254  /* a name, with its terminating NUL */
+#define BDR_NET_MAX_ADDR    16  /* addresses in an answer */
+#define BDR_NET_TIMEOUT_S   20  /* the host waits this long for an answer */
+
+/* the socket of the service with network (hades-bdj-net.socket) */
+#define BDR_NET_SOCKET_DEFAULT "/run/hades-bdj/bdj-net.sock"
+
+enum {
+    BDR_NET_OFF       = -1,  /* BD-Live is off in the player */
+    BDR_NET_NOT_FOUND = -2,  /* the name has no address */
+    BDR_NET_REFUSED   = -3,  /* the name has addresses, none that BD-Live may reach */
+    BDR_NET_BAD_NAME  = -4,  /* not a host name of the Internet */
+    BDR_NET_BUSY      = -5,  /* too many names at once */
+};
+
+typedef struct {
+    uint32_t nlen;        /* bytes of the name that follows, its NUL included */
+    /* char name[nlen] */
+} BDR_RESOLVE_MSG;
+
+/* player side (bdr_net_client.c) */
+
+typedef struct bdr_net BDR_NET;
+
+/* BD-Live is on in the settings the player gave (BLURAY_PLAYER_SETTING_BDJ_NETWORK); a BDR_RECORD */
+BD_PRIVATE int bdr_net_wanted(const void *bdr_record);
+/* the socket of the service with network, if there is one (LIBBLURAY_BDJ_HOST_NET_SOCKET) */
+BD_PRIVATE const char *bdr_net_socket(void);
+BD_PRIVATE BDR_NET *bdr_net_new(int fd, pthread_mutex_t *send_lock);
+/* a BDR_RESOLVE of the host; net NULL: BD-Live is off, refused */
+BD_PRIVATE void bdr_net_request(BDR_NET *net, int fd, pthread_mutex_t *send_lock, uint32_t id,
+                                const uint8_t *payload, uint32_t len);
+/* the connection ends: no answer is sent from now on; frees net when its lookups end */
+BD_PRIVATE void bdr_net_detach(BDR_NET *net);
+/* a valid host name of the Internet (letters, digits, '-', dots); for the tests too */
+BD_PRIVATE int bdr_net_name_ok(const char *name, size_t len);
+
+/* host side (bdr_server.c): a request to the player, answered with BDR_FILE_REPLY */
+BD_PRIVATE int bdr_server_ask(uint16_t type, const void *p1, size_t l1, const void *p2, size_t l2,
+                              int timeout_s, uint8_t **payload, uint32_t *len);
+
+/* host side (bdr_net_server.c): the addresses of a name, asked to the player; the count (> 0)
+   or a BDR_NET_* */
+BD_PRIVATE int bdr_net_resolve(const char *name, uint8_t addr[][4], int max);
+
+#endif /* BDR_NET_H_ */
diff --git a/src/libbluray/remote/bdr_net_client.c b/src/libbluray/remote/bdr_net_client.c
new file mode 100644
index 0000000..78724cb
--- /dev/null
+++ b/src/libbluray/remote/bdr_net_client.c
@@ -0,0 +1,383 @@
+/*
+ * This file is part of libbluray
+ * Copyright (C) 2026  Hades
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The player's side of BD-Live in the isolated BD-J host (bdr_net.h): the names the host asks
+ * for are resolved here, each on a thread of its own (a name server can take seconds, and the
+ * reads of the disc that the host waits for must not), and answered only with the addresses
+ * BD-Live may reach. Nothing but a host name is taken: no path, URL or address.
+ */
+
+#if HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "bdr_net.h"
+#include "bdr_client.h"
+#include "bdr_wire.h"
+
+#include "bluray.h"
+#include "libbluray/bdj/bdlive_net.h"
+#include "util/logging.h"
+
+#include <errno.h>
+#include <netdb.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+
+#define MAX_LOOKUPS        4    /* at once */
+#define MAX_PER_SECOND    20
+
+struct bdr_net {
+    pthread_mutex_t  lock;
+    int              attached;   /* the connection is there: answers may be sent */
+    int              refs;       /* the connection, and each lookup */
+    int              fd;
+    pthread_mutex_t *send_lock;
+    unsigned         running;
+    time_t           second;
+    unsigned         in_second;
+};
+
+typedef struct {
+    BDR_NET  *net;
+    uint32_t  id;
+    char      name[BDR_NET_MAX_NAME];
+} LOOKUP;
+
+int bdr_net_wanted(const void *p)
+{
+    const BDR_RECORD *rec = (const BDR_RECORD *)p;
+    unsigned i;
+    int on = 0;
+
+#ifdef BD_HAVE_BDJ_NETWORK_SETTING
+    for (i = 0; rec && i < rec->count; i++) {
+        if (!rec->items[i].is_str && rec->items[i].idx == BLURAY_PLAYER_SETTING_BDJ_NETWORK) {
+            on = rec->items[i].value == BLURAY_BDJ_NETWORK_INTERNET;   /* the last one counts */
+        }
+    }
+#else
+    (void)rec; (void)i;
+#endif
+    return on;
+}
+
+const char *bdr_net_socket(void)
+{
+    struct stat st;
+    const char *path = getenv("LIBBLURAY_BDJ_HOST_NET_SOCKET");
+
+    if (!path || !path[0]) {
+        path = BDR_NET_SOCKET_DEFAULT;
+    }
+    if (stat(path, &st) != 0 || !S_ISSOCK(st.st_mode)) {
+        return NULL;
+    }
+    return path;
+}
+
+int bdr_net_name_ok(const char *name, size_t len)
+{
+    static const char *const local[] = {
+        /* names that are never of the Internet (RFC 6761, 6762, 8375, and those homes use) */
+        "localhost", "local", "invalid", "test", "example", "home.arpa", "lan", "home", "internal",
+        "localdomain", "intranet", "corp", "private",
+    };
+    size_t i, label = 0, dots = 0, last;
+    int digits_only = 1;
+
+    if (len == 0 || len >= BDR_NET_MAX_NAME || name[len] != 0 || strlen(name) != len) {
+        return 0;
+    }
+    if (name[len - 1] == '.') {
+        len--;   /* a fully qualified name */
+    }
+    if (len == 0 || name[0] == '.' || name[0] == '-') {
+        return 0;
+    }
+    for (i = 0; i < len; i++) {
+        char ch = name[i];
+        if (ch == '.') {
+            if (label == 0 || name[i - 1] == '-') {
+                return 0;
+            }
+            label = 0;
+            dots++;
+            digits_only = 1;
+            continue;
+        }
+        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') ||
+              ch == '-')) {
+            return 0;
+        }
+        if (label == 0 && ch == '-') {
+            return 0;
+        }
+        if (ch < '0' || ch > '9') {
+            digits_only = 0;
+        }
+        if (++label > 63) {
+            return 0;
+        }
+    }
+    if (name[len - 1] == '-' || digits_only || dots == 0) {
+        /* an address written as a name, or a single label (resolved by the network's own search
+           domain, so a name of the network) */
+        return 0;
+    }
+    /* the last label, or the last two */
+    for (i = 0; i < sizeof(local) / sizeof(local[0]); i++) {
+        size_t n = strlen(local[i]);
+        if (len == n || len < n) {
+            continue;
+        }
+        last = len - n;
+        if (name[last - 1] == '.' && !strncasecmp(name + last, local[i], n)) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static void _unref(BDR_NET *net)
+{
+    int last;
+
+    pthread_mutex_lock(&net->lock);
+    last = --net->refs == 0;
+    pthread_mutex_unlock(&net->lock);
+    if (last) {
+        pthread_mutex_destroy(&net->lock);
+        free(net);
+    }
+}
+
+static void _answer(int fd, pthread_mutex_t *send_lock, uint32_t id, int64_t ret, const uint8_t *data,
+                    uint32_t dlen)
+{
+    BDR_FILE_REPLY_MSG rep;
+
+    memset(&rep, 0, sizeof(rep));
+    rep.ret  = ret;
+    rep.dlen = dlen;
+    bdr_send(fd, send_lock, BDR_FILE_REPLY, 0, id, &rep, sizeof(rep), data, dlen, NULL, 0, -1);
+}
+
+static void _answer_net(BDR_NET *net, uint32_t id, int64_t ret, const uint8_t *data, uint32_t dlen)
+{
+    pthread_mutex_lock(&net->lock);
+    if (net->attached) {
+        _answer(net->fd, net->send_lock, id, ret, data, dlen);
+    }
+    pthread_mutex_unlock(&net->lock);
+}
+
+static void *_lookup(void *p)
+{
+    LOOKUP *lk = (LOOKUP *)p;
+    BDR_NET *net = lk->net;
+    struct addrinfo hints, *res = NULL, *ai;
+    uint8_t addr[BDR_NET_MAX_ADDR][4];
+    char shown[256] = "";
+    const char *refusal = NULL;
+    char refused_addr[INET_ADDRSTRLEN] = "";
+    BDLIVE_LOCAL local;
+    int n = 0, found = 0, rc;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family   = AF_INET;          /* BD-Live: IPv4 only (bdlive_net.h) */
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags    = AI_ADDRCONFIG;
+
+    rc = getaddrinfo(lk->name, NULL, &hints, &res);
+    if (rc != 0) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s not resolved (%s)\n", lk->name, gai_strerror(rc));
+        _answer_net(net, lk->id, BDR_NET_NOT_FOUND, NULL, 0);
+        goto out;
+    }
+
+    /* this system and its networks, now (a network may have changed since the disc started) */
+    if (bdlive_local_read(&local) != 0) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s refused: the networks of this system can not be read\n",
+                 lk->name);
+        _answer_net(net, lk->id, BDR_NET_REFUSED, NULL, 0);
+        goto out;
+    }
+
+    for (ai = res; ai; ai = ai->ai_next) {
+        const struct sockaddr_in *sa = (const struct sockaddr_in *)ai->ai_addr;
+        const uint8_t *a;
+        const char *why;
+        int k, dup = 0;
+        if (ai->ai_family != AF_INET || !sa || ai->ai_addrlen < sizeof(*sa)) {
+            continue;
+        }
+        found++;
+        a = (const uint8_t *)&sa->sin_addr.s_addr;
+        why = bdlive_addr_refusal(AF_INET, a, &local);
+        if (why) {
+            if (!refusal) {
+                refusal = why;
+                inet_ntop(AF_INET, a, refused_addr, sizeof(refused_addr));
+            }
+            continue;
+        }
+        for (k = 0; k < n; k++) {
+            dup |= !memcmp(addr[k], a, 4);
+        }
+        if (!dup && n < BDR_NET_MAX_ADDR) {
+            char txt[INET_ADDRSTRLEN];
+            memcpy(addr[n++], a, 4);
+            if (inet_ntop(AF_INET, a, txt, sizeof(txt)) && strlen(shown) + strlen(txt) + 2 < sizeof(shown)) {
+                if (shown[0]) {
+                    strcat(shown, " ");
+                }
+                strcat(shown, txt);
+            }
+        }
+    }
+
+    if (n > 0) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s resolved to %s%s%s%s\n", lk->name, shown,
+                 refusal ? " (left out: " : "", refusal ? refused_addr : "", refusal ? ")" : "");
+        _answer_net(net, lk->id, n, &addr[0][0], (uint32_t)(n * 4));
+    } else if (found) {
+        /* a name of this system or of its network, or one that was made to look like one */
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s refused: it leads to %s, %s\n", lk->name, refused_addr,
+                 refusal);
+        _answer_net(net, lk->id, BDR_NET_REFUSED, NULL, 0);
+    } else {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s has no IPv4 address\n", lk->name);
+        _answer_net(net, lk->id, BDR_NET_NOT_FOUND, NULL, 0);
+    }
+
+out:
+    if (res) {
+        freeaddrinfo(res);
+    }
+    pthread_mutex_lock(&net->lock);
+    net->running--;
+    pthread_mutex_unlock(&net->lock);
+    free(lk);
+    _unref(net);
+    return NULL;
+}
+
+BDR_NET *bdr_net_new(int fd, pthread_mutex_t *send_lock)
+{
+    BDR_NET *net = calloc(1, sizeof(*net));
+
+    if (!net) {
+        return NULL;
+    }
+    pthread_mutex_init(&net->lock, NULL);
+    net->attached  = 1;
+    net->refs      = 1;
+    net->fd        = fd;
+    net->send_lock = send_lock;
+    return net;
+}
+
+void bdr_net_detach(BDR_NET *net)
+{
+    if (!net) {
+        return;
+    }
+    pthread_mutex_lock(&net->lock);
+    net->attached = 0;   /* a lookup that ends later sends nothing: the connection is closed */
+    pthread_mutex_unlock(&net->lock);
+    _unref(net);
+}
+
+void bdr_net_request(BDR_NET *net, int fd, pthread_mutex_t *send_lock, uint32_t id,
+                     const uint8_t *payload, uint32_t len)
+{
+    BDR_RESOLVE_MSG m;
+    const char *name;
+    LOOKUP *lk;
+    pthread_t th;
+    pthread_attr_t attr;
+    time_t now = time(NULL);
+    int busy = 0;
+
+    if (!net) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the BD-J host asked for a name with BD-Live off: refused\n");
+        _answer(fd, send_lock, id, BDR_NET_OFF, NULL, 0);
+        return;
+    }
+    if (len < sizeof(m)) {
+        _answer_net(net, id, BDR_NET_BAD_NAME, NULL, 0);
+        return;
+    }
+    memcpy(&m, payload, sizeof(m));
+    name = (const char *)payload + sizeof(m);
+    if (m.nlen < 2 || m.nlen != len - sizeof(m) || !bdr_net_name_ok(name, m.nlen - 1)) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the BD-J host asked for something that is not a host name of the "
+                 "Internet: refused\n");
+        _answer_net(net, id, BDR_NET_BAD_NAME, NULL, 0);
+        return;
+    }
+
+    pthread_mutex_lock(&net->lock);
+    if (net->second != now) {
+        net->second    = now;
+        net->in_second = 0;
+    }
+    if (net->running >= MAX_LOOKUPS || net->in_second >= MAX_PER_SECOND) {
+        busy = 1;
+    } else {
+        net->running++;
+        net->in_second++;
+        net->refs++;
+    }
+    pthread_mutex_unlock(&net->lock);
+    if (busy) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: name %s refused: too many names at once\n", name);
+        _answer_net(net, id, BDR_NET_BUSY, NULL, 0);
+        return;
+    }
+
+    lk = calloc(1, sizeof(*lk));
+    if (lk) {
+        lk->net = net;
+        lk->id  = id;
+        memcpy(lk->name, name, m.nlen);
+        pthread_attr_init(&attr);
+        pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+        if (pthread_create(&th, &attr, _lookup, lk) == 0) {
+            pthread_attr_destroy(&attr);
+            return;
+        }
+        pthread_attr_destroy(&attr);
+        free(lk);
+    }
+    pthread_mutex_lock(&net->lock);
+    net->running--;
+    pthread_mutex_unlock(&net->lock);
+    _answer_net(net, id, BDR_NET_BUSY, NULL, 0);
+    _unref(net);
+}
diff --git a/src/libbluray/remote/bdr_net_server.c b/src/libbluray/remote/bdr_net_server.c
new file mode 100644
index 0000000..9100775
--- /dev/null
+++ b/src/libbluray/remote/bdr_net_server.c
@@ -0,0 +1,189 @@
+/*
+ * This file is part of libbluray
+ * Copyright (C) 2026  Hades
+ *
