+#define REQ_LOG_LINES 100
+
+/* a line about a request the host may repeat without end (a path refused, a drawing outside its
+   plane): the first REQ_LOG_LINES of a connection; then how many, at the end */
+static int _req_log_ok(BDR_CLIENT *c)
+{
+    unsigned n = __atomic_fetch_add(&c->req_lines, 1, __ATOMIC_RELAXED);
+
+    if (n < REQ_LOG_LINES) {
+        return 1;
+    }
+    if (n == REQ_LOG_LINES) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-J host: more than %d of its requests refused: the rest are left out of "
+                 "the log, and counted at the end\n", REQ_LOG_LINES);
+    }
+    return 0;
+}
+
+/* a path of the host for the log: no control characters (they could forge lines), at most 200 */
+static const char *_printable(char *dst, size_t size, const char *src)
+{
+    size_t i;
+
+    for (i = 0; src[i] && i + 1 < size && i < 200; i++) {
+        unsigned char ch = (unsigned char)src[i];
+        dst[i] = (ch < 0x20 || ch == 0x7f) ? '?' : (char)ch;
+    }
+    dst[i] = 0;
+    return dst;
+}
