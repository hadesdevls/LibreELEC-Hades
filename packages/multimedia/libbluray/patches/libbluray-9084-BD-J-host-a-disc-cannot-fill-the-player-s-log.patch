+/* past LOG_LINES_TOTAL: once a minute, and at the end, how many lines of the host were left out */
+static void _host_log_over(BDR_CLIENT *c, uint64_t now, int at_end)
+{
+    if (c->log_over > c->log_told && (at_end || now - c->log_told_at >= 60000)) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-J host: %u more log lines left out (%u in all)\n",
+                 c->log_over - c->log_told, c->log_over);
+        c->log_told    = c->log_over;
+        c->log_told_at = now;
+    }
+}
