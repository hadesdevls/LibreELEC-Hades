+    pthread_mutex_t  log_lock;
+    unsigned         log_lines;   /* said */
+    unsigned         log_over;    /* left out */
+    unsigned         log_told;    /* of those, already counted in the log */
+    time_t           log_told_at;
 };
 
+/* whether a line may go to the log; past the cap, once a minute, how many did not */
+static int _log_ok(BDR_NET *net)
+{
+    time_t now = time(NULL);
+    int ok = 0;
+
+    pthread_mutex_lock(&net->log_lock);
+    if (net->log_lines < BDR_NET_LOG_LINES) {
+        net->log_lines++;
+        ok = 1;
+    } else if (net->log_over++ == 0) {
+        net->log_told_at = now;
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: more than %d lines about the names this disc asks for: the rest "
+                 "are left out, and counted here once a minute\n", BDR_NET_LOG_LINES);
+    } else if (now - net->log_told_at >= 60) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: %u more lines about names left out\n", net->log_over - net->log_told);
+        net->log_told    = net->log_over;
+        net->log_told_at = now;
+    }
+    pthread_mutex_unlock(&net->log_lock);
+    return ok;
+}
+
+#define NET_LOG(net, ...) do { if (_log_ok(net)) BD_DEBUG(DBG_BDJ | DBG_CRIT, __VA_ARGS__); } while (0)
