+
+/*
+ * A read whose host went away during it: bd_read_ext() gives the BD-J error first, as an event
+ * with no data (the player learns why), and -1 from then on.
+ */
+static int _read_failed(BDR_CLIENT *c, BD_EVENT *event)
+{
+    int r = -1;
+    pthread_mutex_lock(&c->lock);
+    if (event && c->error_event) {
+        c->error_event = 0;
+        event->event = BD_EVENT_ERROR;
+        event->param = BD_ERROR_BDJ;
+        r = 0;
+    }
+    pthread_mutex_unlock(&c->lock);
+    return r;
+}
+
+static int _read(BDR_CLIENT *c, uint32_t op, unsigned char *buf, int len, BD_EVENT *event)
+{
+    BDR_REPLY_MSG rep;
+    uint32_t want, dlen = 0;
+
+    if (event) {
+        event->event = BD_EVENT_NONE;
+        event->param = 0;
+    }
+    if (len < 0) {
+        return -1;
+    }
+    want = (uint32_t)len > BDR_MAX_DATA ? BDR_MAX_DATA : (uint32_t)len;
+    if (_call(c, op, want, 0, 0, NULL, &rep, buf, want, &dlen) < 0) {
+        return _read_failed(c, event);
+    }
+    if (rep.ret < -1 || rep.ret > (int64_t)want || (rep.ret > 0 && (uint32_t)rep.ret != dlen) ||
+        (rep.ret <= 0 && dlen)) {
+        _fail(c, "a read reply the protocol does not allow");
+        return _read_failed(c, event);
+    }
+    if (event && rep.has_event) {
+        event->event = rep.event;
+        event->param = rep.param;
+    }
+    return (int)rep.ret;
+}
+
+int bdr_read(BDR_CLIENT *c, unsigned char *buf, int len)
+{
+    return _read(c, BDR_OP_READ, buf, len, NULL);
+}
+
+int bdr_read_ext(BDR_CLIENT *c, unsigned char *buf, int len, BD_EVENT *event)
+{
+    int r;
+    pthread_mutex_lock(&c->lock);
+    if (c->error_event) {
+        c->error_event = 0;
+        pthread_mutex_unlock(&c->lock);
+        event->event = BD_EVENT_ERROR;
+        event->param = BD_ERROR_BDJ;
+        return 0;
+    }
+    pthread_mutex_unlock(&c->lock);
+    r = _read(c, BDR_OP_READ_EXT, buf, len, event);
+    return r;
+}
+
+int64_t bdr_seek(BDR_CLIENT *c, uint64_t pos)
+{
+    return _call0(c, BDR_OP_SEEK, (int64_t)pos, 0, 0, -1);
+}
+
+int64_t bdr_seek_time(BDR_CLIENT *c, uint64_t tick)
+{
+    return _call0(c, BDR_OP_SEEK_TIME, (int64_t)tick, 0, 0, -1);
+}
+
+int64_t bdr_seek_chapter(BDR_CLIENT *c, unsigned chapter)
+{
+    return _call0(c, BDR_OP_SEEK_CHAPTER, chapter, 0, 0, -1);
+}
+
+int64_t bdr_seek_mark(BDR_CLIENT *c, unsigned mark)
+{
+    return _call0(c, BDR_OP_SEEK_MARK, mark, 0, 0, -1);
+}
+
+int64_t bdr_seek_playitem(BDR_CLIENT *c, unsigned clip_ref)
+{
+    return _call0(c, BDR_OP_SEEK_PLAYITEM, clip_ref, 0, 0, -1);
+}
+
+int bdr_select_angle(BDR_CLIENT *c, unsigned angle)
+{
+    return (int)_call0(c, BDR_OP_SELECT_ANGLE, angle, 0, 0, 0);
+}
+
+void bdr_seamless_angle_change(BDR_CLIENT *c, unsigned angle)
+{
+    _call0(c, BDR_OP_SEAMLESS_ANGLE_CHANGE, angle, 0, 0, 0);
+}
+
+int bdr_select_stream(BDR_CLIENT *c, uint32_t stream_type, uint32_t stream_id, uint32_t enable_flag)
+{
+    return (int)_call0(c, BDR_OP_SELECT_STREAM, stream_type, stream_id, enable_flag, 0);
+}
+
+int64_t bdr_chapter_pos(BDR_CLIENT *c, unsigned chapter)
+{
+    return _call0(c, BDR_OP_CHAPTER_POS, chapter, 0, 0, -1);
+}
+
+uint32_t bdr_get_current_chapter(BDR_CLIENT *c)
+{
+    return (uint32_t)_call0(c, BDR_OP_GET_CURRENT_CHAPTER, 0, 0, 0, 0);
+}
+
+uint64_t bdr_get_title_size(BDR_CLIENT *c)
+{
+    int64_t r = _call0(c, BDR_OP_GET_TITLE_SIZE, 0, 0, 0, 0);
+    return r < 0 ? 0 : (uint64_t)r;
+}
+
+unsigned bdr_get_current_angle(BDR_CLIENT *c)
+{
+    return (unsigned)_call0(c, BDR_OP_GET_CURRENT_ANGLE, 0, 0, 0, 0);
+}
+
+uint64_t bdr_tell(BDR_CLIENT *c)
+{
+    int64_t r = _call0(c, BDR_OP_TELL, 0, 0, 0, 0);
+    return r < 0 ? 0 : (uint64_t)r;
+}
+
+uint64_t bdr_tell_time(BDR_CLIENT *c)
+{
+    int64_t r = _call0(c, BDR_OP_TELL_TIME, 0, 0, 0, 0);
+    return r < 0 ? 0 : (uint64_t)r;
+}
+
+int bdr_set_player_setting(BDR_CLIENT *c, uint32_t idx, uint32_t value)
+{
+    return (int)_call0(c, BDR_OP_SET_PLAYER_SETTING, idx, value, 0, 0);
+}
+
+int bdr_set_player_setting_str(BDR_CLIENT *c, uint32_t idx, const char *s)
+{
+    BDR_REPLY_MSG rep;
+    if (!s || _call(c, BDR_OP_SET_PLAYER_SETTING_STR, idx, 0, 0, s, &rep, NULL, 0, NULL) < 0) {
+        return 0;
+    }
+    return (int)rep.ret;
+}
+
+int bdr_get_event(BDR_CLIENT *c, BD_EVENT *event)
+{
+    BDR_REPLY_MSG rep;
+
+    if (!event) {
+        return 0;
+    }
+    event->event = BD_EVENT_NONE;
+    event->param = 0;
+
+    pthread_mutex_lock(&c->lock);
+    if (c->error_event) {
+        c->error_event = 0;
+        pthread_mutex_unlock(&c->lock);
+        event->event = BD_EVENT_ERROR;
+        event->param = BD_ERROR_BDJ;
+        return 1;
+    }
+    pthread_mutex_unlock(&c->lock);
+
+    if (_call(c, BDR_OP_GET_EVENT, 0, 0, 0, NULL, &rep, NULL, 0, NULL) < 0) {
+        return 0;
+    }
+    if (rep.ret && rep.has_event) {
+        event->event = rep.event;
+        event->param = rep.param;
+        return 1;
+    }
+    return 0;
+}
+
+int bdr_play(BDR_CLIENT *c)
+{
+    return (int)_call0(c, BDR_OP_PLAY, 0, 0, 0, 0);
+}
+
+int bdr_play_title(BDR_CLIENT *c, unsigned title)
+{
+    return (int)_call0(c, BDR_OP_PLAY_TITLE, title, 0, 0, 0);
+}
+
+int bdr_menu_call(BDR_CLIENT *c, int64_t pts)
+{
+    return (int)_call0(c, BDR_OP_MENU_CALL, pts, 0, 0, 0);
+}
+
+int bdr_read_skip_still(BDR_CLIENT *c)
+{
+    return (int)_call0(c, BDR_OP_READ_SKIP_STILL, 0, 0, 0, 0);
+}
+
+void bdr_set_scr(BDR_CLIENT *c, int64_t pts)
+{
+    _call0(c, BDR_OP_SET_SCR, pts, 0, 0, 0);
+}
+
+int bdr_set_rate(BDR_CLIENT *c, uint32_t rate)
+{
+    return (int)_call0(c, BDR_OP_SET_RATE, rate, 0, 0, -1);
+}
+
+int bdr_user_input(BDR_CLIENT *c, int64_t pts, uint32_t key)
+{
+    return (int)_call0(c, BDR_OP_USER_INPUT, pts, key, 0, -1);
+}
+
+int bdr_mouse_select(BDR_CLIENT *c, int64_t pts, uint16_t x, uint16_t y)
+{
+    return (int)_call0(c, BDR_OP_MOUSE_SELECT, pts, x, y, -1);
+}
+
+int bdr_start_bdj(BDR_CLIENT *c, const char *start_object)
+{
+    BDR_REPLY_MSG rep;
+    if (!start_object || _call(c, BDR_OP_START_BDJ, 0, 0, 0, start_object, &rep, NULL, 0, NULL) < 0) {
+        return 0;
+    }
+    return (int)rep.ret;
+}
+
+void bdr_stop_bdj(BDR_CLIENT *c)
+{
+    _call0(c, BDR_OP_STOP_BDJ, 0, 0, 0, 0);
+}
+
+uint32_t bdr_get_titles(BDR_CLIENT *c, uint8_t flags, uint32_t min_title_length)
+{
+    return (uint32_t)_call0(c, BDR_OP_GET_TITLES, flags, min_title_length, 0, 0);
+}
+
+struct clpi_cl *bdr_get_clpi(BDR_CLIENT *c, unsigned clip_ref)
+{
+    BDR_REPLY_MSG rep;
+    char name[6], file[11];
+    uint32_t dlen = 0, i;
+    const struct clpi_cl *cl;
+    struct clpi_cl *copy;
+
+    if (_call(c, BDR_OP_CLIP_NAME, clip_ref, 0, 0, NULL, &rep, name, 5, &dlen) < 0 || rep.ret <= 0) {
+        return NULL;
+    }
+    if (dlen != 5) {
+        _fail(c, "a clip name the protocol does not allow");
+        return NULL;
+    }
+    for (i = 0; i < 5; i++) {
+        if (name[i] < '0' || name[i] > '9') {
+            _fail(c, "a clip name the protocol does not allow");
+            return NULL;
+        }
+    }
+    name[5] = 0;
+    snprintf(file, sizeof(file), "%s.clpi", name);
+
+    cl = clpi_get(c->disc, file);
+    if (!cl) {
+        return NULL;
+    }
+    copy = clpi_copy(cl);
+    clpi_unref(&cl);
+    return copy;
+}
+
+void bdr_register_overlay_proc(BDR_CLIENT *c, void *handle, bdr_overlay_proc_f func)
+{
+    int argb;
+    pthread_mutex_lock(&c->proc_lock);
+    c->ov_handle = handle;
+    c->ov_proc   = func;
+    argb = c->argb_proc != NULL;
+    pthread_mutex_unlock(&c->proc_lock);
+    _call0(c, BDR_OP_REGISTER_OVERLAYS, func != NULL, argb, 0, 0);
+}
+
+void bdr_register_argb_overlay_proc(BDR_CLIENT *c, void *handle, bdr_argb_overlay_proc_f func,
+                                    BD_ARGB_BUFFER *buf)
+{
+    int ov;
+    pthread_mutex_lock(&c->proc_lock);
+    c->argb_handle = handle;
+    c->argb_proc   = func;
+    c->argb_buf    = buf;
+    ov = c->ov_proc != NULL;
+    pthread_mutex_unlock(&c->proc_lock);
+    _call0(c, BDR_OP_REGISTER_OVERLAYS, ov, func != NULL, 0, 0);
+}
+
+int bdr_bdj_waiting_for_playback(BDR_CLIENT *c)
+{
+    int64_t r = _call0(c, BDR_OP_BDJ_WAITING_FOR_PLAYBACK, 0, 0, 0, 0);
+    return (r < 0 || r > 2) ? 0 : (int)r;
+}
+
+void bdr_bdj_set_presentation_timing(BDR_CLIENT *c, int enable)
+{
+    _call0(c, BDR_OP_BDJ_SET_PRESENTATION_TIMING, enable, 0, 0, 0);
+}
+
+uint32_t bdr_bdj_pending_seq(BDR_CLIENT *c)
+{
+    int64_t r = _call0(c, BDR_OP_BDJ_PENDING_SEQ, 0, 0, 0, 0);
+    return (r < 0 || r > (int64_t)UINT32_MAX) ? 0 : (uint32_t)r;
+}
+
+void bdr_bdj_release(BDR_CLIENT *c, uint32_t seq)
+{
+    _call0(c, BDR_OP_BDJ_RELEASE, seq, 0, 0, 0);
+}
+
+void bdr_bdj_release_all(BDR_CLIENT *c)
+{
+    _call0(c, BDR_OP_BDJ_RELEASE_ALL, 0, 0, 0, 0);
+}
