+/*
+ * The client side of the isolated BD-J host (bdr_protocol.h): what bluray.c calls once a
+ * BLURAY has been handed over to the host.
+ */
+
+#ifndef BDR_CLIENT_H_
+#define BDR_CLIENT_H_
+
+#include "util/attributes.h"
+
+#include "bluray.h"
+
+#include <stdint.h>
+
+struct bd_disc;
+struct bd_overlay_s;
+struct bd_argb_overlay_s;
+struct bd_argb_buffer_s;
+struct clpi_cl;
+
+typedef void (*bdr_overlay_proc_f)(void *, const struct bd_overlay_s * const);
+typedef void (*bdr_argb_overlay_proc_f)(void *, const struct bd_argb_overlay_s * const);
+
+typedef struct bdr_client BDR_CLIENT;
+
+/*
+ * Player settings given before the hand-over, replayed in the host: those given before the disc
+ * was opened before it opens it there, the others after.
+ */
+typedef struct {
+    uint32_t idx;
+    uint32_t value;
+    uint8_t  is_str;
+    uint8_t  after_open;
+    char    *str;
+} BDR_REC_SETTING;
+
+typedef struct {
+    BDR_REC_SETTING *items;
+    unsigned         count;
+    unsigned         alloc;
+
+    /* the last bd_get_titles() of the player: the host builds the same title list */
+    uint8_t          titles_valid;
+    uint8_t          titles_flags;
+    uint32_t         titles_min;
+} BDR_RECORD;
+
+BD_PRIVATE void bdr_record_setting(BDR_RECORD *rec, int after_open, uint32_t idx, uint32_t value,
+                                   const char *str);
+BD_PRIVATE void bdr_record_titles(BDR_RECORD *rec, uint8_t flags, uint32_t min_title_length);
+BD_PRIVATE void bdr_record_free(BDR_RECORD *rec);
+
+/* 1 if the isolated BD-J host can be reached (its socket is there) */
+BD_PRIVATE int bdr_available(void);
+
+typedef struct {
+    struct bd_disc        *disc;        /* the player's disc: what the host reads */
+    const BDR_RECORD      *rec;
+    uint32_t               debug_mask;
+
+    void                  *ov_handle;
+    bdr_overlay_proc_f     ov_proc;
+    void                  *argb_handle;
+    bdr_argb_overlay_proc_f argb_proc;
+    struct bd_argb_buffer_s *argb_buf;
+} BDR_START;
+
+/* Start the host and open the disc there. NULL when it can not: BD-J then does not run. */
+BD_PRIVATE BDR_CLIENT *bdr_client_start(const BDR_START *start);
+
+/* Close the disc in the host and end the host (it is killed if it does not end by itself) */
+BD_PRIVATE void bdr_client_close(BDR_CLIENT **client);
+
+/*
+ * The forwarded calls: the arguments and results of their bd_*() counterparts. A host that is
+ * gone answers as libbluray does for a disc that can not play (0, -1, nothing), and
+ * bdr_get_event() gives one BD_EVENT_ERROR (BD_ERROR_BDJ) first.
+ */
+BD_PRIVATE int      bdr_select_title(BDR_CLIENT *c, uint32_t title_idx);
+BD_PRIVATE int      bdr_select_playlist(BDR_CLIENT *c, uint32_t playlist);
+BD_PRIVATE uint32_t bdr_get_current_title(BDR_CLIENT *c);
+BD_PRIVATE int      bdr_read(BDR_CLIENT *c, unsigned char *buf, int len);
+BD_PRIVATE int64_t  bdr_seek(BDR_CLIENT *c, uint64_t pos);
+BD_PRIVATE int64_t  bdr_seek_time(BDR_CLIENT *c, uint64_t tick);
+BD_PRIVATE int64_t  bdr_seek_chapter(BDR_CLIENT *c, unsigned chapter);
+BD_PRIVATE int64_t  bdr_seek_mark(BDR_CLIENT *c, unsigned mark);
+BD_PRIVATE int64_t  bdr_seek_playitem(BDR_CLIENT *c, unsigned clip_ref);
+BD_PRIVATE int      bdr_select_angle(BDR_CLIENT *c, unsigned angle);
+BD_PRIVATE void     bdr_seamless_angle_change(BDR_CLIENT *c, unsigned angle);
+BD_PRIVATE int      bdr_select_stream(BDR_CLIENT *c, uint32_t stream_type, uint32_t stream_id,
+                                      uint32_t enable_flag);
+BD_PRIVATE int64_t  bdr_chapter_pos(BDR_CLIENT *c, unsigned chapter);
+BD_PRIVATE uint32_t bdr_get_current_chapter(BDR_CLIENT *c);
+BD_PRIVATE uint64_t bdr_get_title_size(BDR_CLIENT *c);
+BD_PRIVATE unsigned bdr_get_current_angle(BDR_CLIENT *c);
+BD_PRIVATE uint64_t bdr_tell(BDR_CLIENT *c);
+BD_PRIVATE uint64_t bdr_tell_time(BDR_CLIENT *c);
+BD_PRIVATE int      bdr_set_player_setting(BDR_CLIENT *c, uint32_t idx, uint32_t value);
+BD_PRIVATE int      bdr_set_player_setting_str(BDR_CLIENT *c, uint32_t idx, const char *s);
+BD_PRIVATE int      bdr_get_event(BDR_CLIENT *c, BD_EVENT *event);
+BD_PRIVATE int      bdr_play(BDR_CLIENT *c);
+BD_PRIVATE int      bdr_play_title(BDR_CLIENT *c, unsigned title);
+BD_PRIVATE int      bdr_menu_call(BDR_CLIENT *c, int64_t pts);
+BD_PRIVATE int      bdr_read_ext(BDR_CLIENT *c, unsigned char *buf, int len, BD_EVENT *event);
+BD_PRIVATE int      bdr_read_skip_still(BDR_CLIENT *c);
+BD_PRIVATE void     bdr_set_scr(BDR_CLIENT *c, int64_t pts);
+BD_PRIVATE int      bdr_set_rate(BDR_CLIENT *c, uint32_t rate);
+BD_PRIVATE int      bdr_user_input(BDR_CLIENT *c, int64_t pts, uint32_t key);
+BD_PRIVATE int      bdr_mouse_select(BDR_CLIENT *c, int64_t pts, uint16_t x, uint16_t y);
+BD_PRIVATE int      bdr_start_bdj(BDR_CLIENT *c, const char *start_object);
+BD_PRIVATE void     bdr_stop_bdj(BDR_CLIENT *c);
+BD_PRIVATE uint32_t bdr_get_titles(BDR_CLIENT *c, uint8_t flags, uint32_t min_title_length);
+
+/* the clip of a play item of the playlist that plays in the host, parsed from the player's disc */
+BD_PRIVATE struct clpi_cl *bdr_get_clpi(BDR_CLIENT *c, unsigned clip_ref);
+
+BD_PRIVATE void     bdr_register_overlay_proc(BDR_CLIENT *c, void *handle, bdr_overlay_proc_f func);
+BD_PRIVATE void     bdr_register_argb_overlay_proc(BDR_CLIENT *c, void *handle,
+                                                   bdr_argb_overlay_proc_f func,
+                                                   struct bd_argb_buffer_s *buf);
+
+/* SamuriHL's BD-J additions (libbluray-9070...): the host answers -1 / 0 without them */
+BD_PRIVATE int      bdr_bdj_waiting_for_playback(BDR_CLIENT *c);
+BD_PRIVATE void     bdr_bdj_set_presentation_timing(BDR_CLIENT *c, int enable);
+BD_PRIVATE uint32_t bdr_bdj_pending_seq(BDR_CLIENT *c);
+BD_PRIVATE void     bdr_bdj_release(BDR_CLIENT *c, uint32_t seq);
+BD_PRIVATE void     bdr_bdj_release_all(BDR_CLIENT *c);
+
+#endif /* BDR_CLIENT_H_ */
