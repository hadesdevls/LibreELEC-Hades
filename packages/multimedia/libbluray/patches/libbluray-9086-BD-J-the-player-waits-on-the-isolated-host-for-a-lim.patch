@@ -24,20 +24,64 @@
 #include "bdr_wire.h"
 
 #include <errno.h>
+#include <poll.h>
 #include <stdlib.h>
 #include <string.h>
+#include <time.h>
 #include <sys/socket.h>
 #include <sys/uio.h>
 #include <unistd.h>
 
+static uint64_t _now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+/* wait until fd takes more, at most until deadline (ms of CLOCK_MONOTONIC): 0, or -1 with errno
+   (ETIMEDOUT: the deadline passed) */
+static int _wait_writable(int fd, uint64_t deadline)
+{
+    while (1) {
+        struct pollfd pfd;
+        uint64_t now = _now_ms(), left;
+        int r;
+
+        if (now >= deadline) {
+            errno = ETIMEDOUT;
+            return -1;
+        }
+        left = deadline - now;
+        pfd.fd      = fd;
+        pfd.events  = POLLOUT;
+        pfd.revents = 0;
+        r = poll(&pfd, 1, left > 60000 ? 60000 : (int)left);
+        if (r > 0) {
+            return 0;   /* it takes more, or has an error that the next send reports */
+        }
+        if (r < 0 && errno != EINTR) {
+            return -1;
+        }
+    }
+}
+
 int bdr_send(int fd, pthread_mutex_t *lock, uint16_t type, uint16_t flags, uint32_t id,
              const void *p1, size_t l1, const void *p2, size_t l2,
              const void *p3, size_t l3, int pass_fd)
+{
+    return bdr_send_timed(fd, lock, 0, type, flags, id, p1, l1, p2, l2, p3, l3, pass_fd);
+}
+
+int bdr_send_timed(int fd, pthread_mutex_t *lock, unsigned timeout_ms, uint16_t type,
+                   uint16_t flags, uint32_t id, const void *p1, size_t l1,
+                   const void *p2, size_t l2, const void *p3, size_t l3, int pass_fd)
 {
     BDR_HDR hdr;
     struct iovec iov[4];
-    int n_iov = 0, cur = 0, result = 0, first = 1;
+    int n_iov = 0, cur = 0, result = 0, first = 1, err = 0;
     size_t total = l1 + l2 + l3;
+    uint64_t deadline;
 
     if (fd < 0 || l1 > BDR_MAX_PAYLOAD || l2 > BDR_MAX_PAYLOAD || l3 > BDR_MAX_PAYLOAD ||
         total > BDR_MAX_PAYLOAD) {
@@ -59,6 +103,7 @@ int bdr_send(int fd, pthread_mutex_t *lock, uint16_t type, uint16_t flags, uint3
     if (l3) { iov[n_iov].iov_base = (void *)(uintptr_t)p3; iov[n_iov].iov_len = l3; n_iov++; }
 
     pthread_mutex_lock(lock);
+    deadline = _now_ms() + timeout_ms;
 
