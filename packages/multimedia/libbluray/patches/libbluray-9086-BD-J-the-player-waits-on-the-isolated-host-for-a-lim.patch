-        sent = sendmsg(fd, &msg, MSG_NOSIGNAL);
+        /* with a limit, a send never blocks: the wait for room is poll(), up to the deadline */
+        sent = sendmsg(fd, &msg, MSG_NOSIGNAL | (timeout_ms ? MSG_DONTWAIT : 0));
         if (sent < 0) {
