         struct msghdr msg;
@@ -84,11 +129,17 @@ int bdr_send(int fd, pthread_mutex_t *lock, uint16_t type, uint16_t flags, uint3
             memcpy(CMSG_DATA(cmsg), &pass_fd, sizeof(int));
