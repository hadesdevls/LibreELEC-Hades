             }
+            if (timeout_ms && (errno == EAGAIN || errno == EWOULDBLOCK) &&
+                _wait_writable(fd, deadline) == 0) {
+                continue;
+            }
+            err = errno;
             result = -1;
             break;
         }
@@ -109,6 +160,9 @@ int bdr_send(int fd, pthread_mutex_t *lock, uint16_t type, uint16_t flags, uint3
 
     pthread_mutex_unlock(lock);
 
+    if (result < 0) {
