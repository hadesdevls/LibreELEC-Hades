+                          NULL, 0, pass_fd);
+}
+
+/* a send failed (errno err): the host is ended, as one that does not answer */
+static void _send_failed(BDR_CLIENT *c, int err)
+{
+    _fail(c, err == ETIMEDOUT ? "it stopped reading what the player sends (nothing taken in "
+          BDR_STR(SEND_TIMEOUT_S) " s)" : "the connection failed");
+}
