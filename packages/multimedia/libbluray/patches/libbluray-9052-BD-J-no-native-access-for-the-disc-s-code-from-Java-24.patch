From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:13:00 +0000
Subject: [PATCH] BD-J: no native access for the disc's code from Java 24

Without a security manager, nothing in Java keeps the code of a disc from
loading a native library it carries (System.load()) or from calling native
functions through the foreign function API. From Java 24 on (JEP 472)
--illegal-native-access=deny refuses both to the unnamed module, where the
disc's classes are; libbluray's own classes are in java.base and
java.desktop, and its native methods are registered from bdj.c.

The Java version is read from JAVA_VERSION in the "release" file of the
runtime (every JDK and JRE since 8 has one), because the option is unknown
to earlier versions and the JVM would not start. Earlier Javas keep their
security manager, which refuses both.

Measured with OpenJDK 26 in the isolated service: an Xlet's System.load()
of a library from the disc throws IllegalCallerException ("Illegal native
access from an unnamed module"), and BD-J runs as before.
---
 src/libbluray/bdj/bdj.c | 48 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/libbluray/bdj/bdj.c b/src/libbluray/bdj/bdj.c
index 9808018..26f8019 100644
--- a/src/libbluray/bdj/bdj.c
+++ b/src/libbluray/bdj/bdj.c
@@ -923,6 +923,41 @@ static const char * const java_base_exports[] = {
 };
 static const size_t num_java_base_exports = sizeof(java_base_exports) / sizeof(java_base_exports[0]);
 
+/*
+ * Hades: the feature version of the Java of java_home, from JAVA_VERSION in its "release" file
+ * (every JDK and JRE since 8 has one): "1.8.0_462" is 8, "27.0.1.0.3" is 27; 0 when unknown.
+ */
+static int _java_feature_version(const char *java_home)
+{
+    char line[256];
+    int version = 0;
+    FILE *fp;
+    char *path;
+
+    if (!java_home)
+        return 0;
+    path = str_printf("%s/release", java_home);
+    if (!path)
+        return 0;
+    fp = fopen(path, "r");
+    X_FREE(path);
+    if (!fp)
+        return 0;
+    while (fgets(line, sizeof(line), fp)) {
+        if (!strncmp(line, "JAVA_VERSION=\"", 14)) {
+            const char *v = line + 14;
+            int first = atoi(v);
+            if (first == 1 && v[1] == '.')
+                version = atoi(v + 2);
+            else
+                version = first;
+            break;
+        }
+    }
+    fclose(fp);
+    return version > 0 ? version : 0;
+}
+
 static int _create_jvm(void *jvm_lib, const char *java_home, BDJ_CONFIG *cfg,
                        JNIEnv **env, JavaVM **jvm)
 {
@@ -969,6 +1004,19 @@ static int _create_jvm(void *jvm_lib, const char *java_home, BDJ_CONFIG *cfg,
     option[n++].optionString = str_dup   ("-Djava.io.tmpdir=/tmp");
     option[n++].optionString = str_dup   ("-XX:-UsePerfData");
     option[n++].optionString = str_dup   ("-XX:+DisableAttachMechanism");
+
+    /* Hades: from Java 24 on (JEP 472) the code of a disc, in the unnamed module, may neither load
+     * a native library nor call native functions; libbluray's own classes are in java.base and
+     * java.desktop, and its native methods are registered from here. Earlier Javas keep their
+     * security manager, which refuses both. */
+    {
+        int feature = _java_feature_version(java_home);
+        if (feature >= 24) {
+            option[n++].optionString = str_dup("--illegal-native-access=deny");
+        }
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "Java %d from %s%s\n", feature, java_home ? java_home : "?",
+                 feature >= 24 ? ": the disc's code gets no native access" : "");
+    }
 #ifdef HAVE_BDJ_J2ME
     option[n++].optionString = str_printf("-Djava.home=%s", java_home);
     option[n++].optionString = str_printf("-Xbootclasspath/a:%s/lib/xmlparser.jar", java_home);
-- 
