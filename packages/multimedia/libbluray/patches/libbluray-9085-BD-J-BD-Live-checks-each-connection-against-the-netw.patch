From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:30:26 +0000
Subject: [PATCH 2/2] BD-J: BD-Live checks each connection against the networks
 of this system as they are then

The Java check of a connection by address (NetAddress) took the subnets of this system's
interfaces from HADES_BDJ_BDLIVE_LOCAL, which the BD-J server reads once, before its filter takes
netlink away. A network that changes while a disc plays (an address added or moved, on a home
network of public IPv4 addresses) was then not known to it, and a connection by address to a
device there could go out: the system's filter only knows the ranges that are never the Internet.
(The player's side read the subnets afresh at each name already.)

NetAddress now asks for them at each check (localSubnetsN(), registered by the BD-J host with
BD-Live): bdlive_local_read_ioctl() reads them with SIOCGIFCONF and SIOCGIFNETMASK on an IPv4
socket, which the server's filter allows with BD-Live and which needs no netlink. Where they
cannot be read, or the native method is not there, nothing is allowed. HADES_BDJ_BDLIVE_LOCAL
stays: it says that the server could read them before the filter.

Measured in the test service: a connection to a server allowed before this system is put on that
server's network goes out; the same connection, eight seconds later and after the change, is
refused ("a network this system is on"). With the subnets of the start, the second one went out.
---
 src/libbluray/bdj/bdlive_net.c                | 50 +++++++++++++++++++
 src/libbluray/bdj/bdlive_net.h                |  4 ++
 .../bdj/java/org/videolan/NetAddress.java     | 24 +++++----
 src/libbluray/remote/bdr_net_server.c         | 33 ++++++++++++
 4 files changed, 100 insertions(+), 11 deletions(-)

diff --git a/src/libbluray/bdj/bdlive_net.c b/src/libbluray/bdj/bdlive_net.c
index a2405fd..e977f43 100644
--- a/src/libbluray/bdj/bdlive_net.c
+++ b/src/libbluray/bdj/bdlive_net.c
@@ -30,6 +30,8 @@
 #include <arpa/inet.h>
 #include <ifaddrs.h>
 #include <net/if.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
 #include <netinet/in.h>
 #include <sys/socket.h>
 #endif
@@ -136,6 +138,54 @@ int bdlive_local_read(BDLIVE_LOCAL *local)
 #endif
 }
 
+int bdlive_local_read_ioctl(BDLIVE_LOCAL *local)
+{
+    memset(local, 0, sizeof(*local));
+#ifdef __linux__
+    {
+        struct ifreq ifr[BDLIVE_MAX_LOCAL + 1];
+        struct ifconf ifc;
+        int fd, i, n, rc = 0;
+
+        fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) {
+            return -1;
+        }
+        memset(ifr, 0, sizeof(ifr));
+        ifc.ifc_len = (int)sizeof(ifr);
+        ifc.ifc_req = ifr;
+        if (ioctl(fd, SIOCGIFCONF, &ifc) != 0) {
+            close(fd);
+            return -1;
+        }
+        n = ifc.ifc_len / (int)sizeof(struct ifreq);
+        if (n > BDLIVE_MAX_LOCAL) {
+            /* more addresses than kept: one not kept would be reachable */
+            close(fd);
+            return -1;
+        }
+        for (i = 0; i < n; i++) {
+            struct ifreq mask = ifr[i];
+            const struct sockaddr_in *sa = (const struct sockaddr_in *)&ifr[i].ifr_addr;
+            if (sa->sin_family != AF_INET) {
+                continue;
+            }
+            if (ioctl(fd, SIOCGIFNETMASK, &mask) != 0) {
+                rc = -1;
+                break;
+            }
+            local->net[local->count].addr = ntohl(sa->sin_addr.s_addr);
+            local->net[local->count].mask = ntohl(((const struct sockaddr_in *)&mask.ifr_netmask)->sin_addr.s_addr);
+            local->count++;
+        }
+        close(fd);
+        return rc;
+    }
+#else
+    return -1;
+#endif
+}
+
 void bdlive_local_format(const BDLIVE_LOCAL *local, char *buf, unsigned len)
 {
     unsigned i, used = 0;
diff --git a/src/libbluray/bdj/bdlive_net.h b/src/libbluray/bdj/bdlive_net.h
index decc265..0de3d42 100644
--- a/src/libbluray/bdj/bdlive_net.h
+++ b/src/libbluray/bdj/bdlive_net.h
@@ -63,6 +63,10 @@ BD_PRIVATE const char *bdlive_addr_refusal(int family, const uint8_t *addr, cons
 /* the IPv4 subnets of this system's interfaces, from getifaddrs(): 0, or -1 if they cannot be read */
 BD_PRIVATE int bdlive_local_read(BDLIVE_LOCAL *local);
 
+/* the same through ioctl() on an IPv4 socket (SIOCGIFCONF, SIOCGIFNETMASK): what the BD-J service with
+   BD-Live can do once its filter has taken netlink away; 0, or -1 */
+BD_PRIVATE int bdlive_local_read_ioctl(BDLIVE_LOCAL *local);
+
 /* "a.b.c.d/n,..." for the environment of the JVM (HADES_BDJ_BDLIVE_LOCAL); buf of len bytes */
 BD_PRIVATE void bdlive_local_format(const BDLIVE_LOCAL *local, char *buf, unsigned len);
 
diff --git a/src/libbluray/bdj/java/org/videolan/NetAddress.java b/src/libbluray/bdj/java/org/videolan/NetAddress.java
index 7bc6b75..3d968bd 100644
--- a/src/libbluray/bdj/java/org/videolan/NetAddress.java
+++ b/src/libbluray/bdj/java/org/videolan/NetAddress.java
@@ -27,8 +27,9 @@ import java.util.StringTokenizer;
  * BD-Live: the addresses the Java code of a disc may connect to. The rule of bdlive_net.c, in
  * Java: IPv4 of the Internet only (not this network, private networks, carrier-grade NAT,
  * loopback, link-local, IETF assignments, documentation, 6to4 relays, benchmarking, multicast,
- * reserved, broadcast), and not this system or a network it is on (HADES_BDJ_BDLIVE_LOCAL, which
- * the BD-J server reads from the interfaces before it confines itself). No IPv6.
+ * reserved, broadcast), and not this system or a network it is on, read from the interfaces at the
+ * moment of each check (localSubnetsN(), registered by the BD-J host with BD-Live; a network may
+ * change while a disc plays). Where that cannot be read, nothing is allowed. No IPv6.
  */
 public final class NetAddress {
 
@@ -50,23 +51,24 @@ public final class NetAddress {
         "reserved or broadcast (240.0.0.0/4)",
     };
 
-    /* the subnets of this system: address, mask; null: they could not be read (nothing allowed) */
-    private static int[][] local;
-    private static boolean localRead;
-
     private NetAddress() {
     }
 
+    /* the subnets of this system now, "a.b.c.d/n,...", or null (BD-J host, bdr_net_server.c) */
+    private static native String localSubnetsN();
+
     private static int mask(int len) {
         return len == 0 ? 0 : (int)(0xffffffffL << (32 - len));
     }
 
-    private static synchronized int[][] local() {
-        if (!localRead) {
-            localRead = true;
-            local = parseLocal(System.getenv("HADES_BDJ_BDLIVE_LOCAL"));
+    /* the subnets of this system: address, mask; null: they could not be read (nothing allowed) */
+    private static int[][] local() {
+        try {
+            return parseLocal(localSubnetsN());
+        } catch (UnsatisfiedLinkError e) {
+            /* not the BD-J host with BD-Live */
+            return null;
         }
-        return local;
     }
 
     /* "a.b.c.d/n,..." -> {addr, mask}...; null for anything else */
diff --git a/src/libbluray/remote/bdr_net_server.c b/src/libbluray/remote/bdr_net_server.c
index 9100775..09af0a0 100644
--- a/src/libbluray/remote/bdr_net_server.c
+++ b/src/libbluray/remote/bdr_net_server.c
@@ -33,6 +33,7 @@
 #include "libbluray/bdj/bdj.h"
 #include "libbluray/bdj/bdj_sandbox.h"
 #include "libbluray/bdj/bdlive_bdj.h"
+#include "libbluray/bdj/bdlive_net.h"
 #include "util/logging.h"
 #include "util/strutl.h"
 
@@ -125,6 +126,20 @@ static jobjectArray JNICALL _resolve0(JNIEnv *env, jclass cls, jstring jname)
     return result;
 }
 
+/* org.videolan.NetAddress.localSubnetsN(): the subnets of this system now, "a.b.c.d/n,...", or null */
+static jstring JNICALL _local_subnets(JNIEnv *env, jclass cls)
+{
+    BDLIVE_LOCAL local;
+    char buf[1024];
+
+    (void)cls;
+    if (bdlive_local_read_ioctl(&local) != 0 || local.count == 0) {
+        return NULL;
+    }
+    bdlive_local_format(&local, buf, sizeof(buf));
+    return buf[0] ? (*env)->NewStringUTF(env, buf) : NULL;
+}
+
 int bdlive_bdj_register(void *jni_env)
 {
     JNIEnv *env = (JNIEnv *)jni_env;
@@ -152,6 +167,24 @@ int bdlive_bdj_register(void *jni_env)
         BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the resolver's native method could not be registered\n");
         return -1;
     }
+
+    /* the check of each connection reads the networks of this system when it is made */
+    {
+        static char lname[] = "localSubnetsN";
+        static char lsignature[] = "()Ljava/lang/String;";
+        JNINativeMethod lm[1];
+        jclass ncls = (*env)->FindClass(env, "org/videolan/NetAddress");
+
+        lm[0].name      = lname;
+        lm[0].signature = lsignature;
+        lm[0].fnPtr     = (void *)_local_subnets;
+        if (!ncls || (*env)->RegisterNatives(env, ncls, lm, 1) != 0) {
+            (*env)->ExceptionClear(env);
+            BD_DEBUG(DBG_BDJ | DBG_CRIT, "BD-Live: the networks of this system cannot be read at each connection: "
+                     "connections by address are refused\n");
+            return -1;
+        }
+    }
     return 0;
 }
 
