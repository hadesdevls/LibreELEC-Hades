diff --git a/src/libbluray/bdj/java/org/videolan/media/content/playlist/StreamControl.java b/src/libbluray/bdj/java/org/videolan/media/content/playlist/StreamControl.java
index 3fbded5..51e0ac0 100644
--- a/src/libbluray/bdj/java/org/videolan/media/content/playlist/StreamControl.java
+++ b/src/libbluray/bdj/java/org/videolan/media/content/playlist/StreamControl.java
@@ -36,6 +36,35 @@ public abstract class StreamControl implements Control {
 
     protected abstract void setStreamNumber(int num);
 
+    /*
+     * Hades: the streams of this kind of each play item of the playlist the player is set to, for a
+     * selection made before the player has a play item (it is not prefetched yet); null when it has
+     * no playlist.
+     */
+    protected StreamInfo[][] getTitleStreams() {
+        return null;
+    }
+
+    /*
+     * Hades: a stream selected before the player has a play item: the player keeps it and starts
+     * its playlist with it (as a stream number of the locator it plays). False when the player has a
+     * play item by now.
+     */
+    protected boolean setStartStreamNumber(int num) {
+        return false;
+    }
+
+    /* Hades: whether a play item of the playlist has a stream of that number */
+    protected static boolean isTitleStream(StreamInfo[][] title, int num) {
+        if ((title == null) || (num < 1))
+            return false;
+        for (int i = 0; i < title.length; i++) {
+            if ((title[i] != null) && (num <= title[i].length))
+                return true;
+        }
+        return false;
+    }
+
     protected String getDefaultLanguage() {
         return "";
     }
@@ -76,6 +105,18 @@ public abstract class StreamControl implements Control {
         if (num < 1)
             throw new StreamNotAvailableException();
         StreamInfo[] streams = getStreams();
+        if (streams == null) {
+            /* Hades: the player has no play item yet (a disc that selects its streams before the
+               playlist is prefetched): a stream that a play item of the playlist has is kept, and
+               the playlist starts with it, as with a stream number of its locator; a number that
+               no play item has is refused, as before */
+            if (!isTitleStream(getTitleStreams(), num))
+                throw new StreamNotAvailableException();
+            if (setStartStreamNumber(num))
+                return;
+            /* (prefetched meanwhile: as for a play item) */
+            streams = getStreams();
+        }
         if ((streams == null) || (num > streams.length))
             throw new StreamNotAvailableException();
         setStreamNumber(num);
@@ -111,8 +152,28 @@ public abstract class StreamControl implements Control {
     public void selectLanguage(String language)
             throws LanguageNotAvailableException, NotAuthorizedException {
         StreamInfo[] streams = getStreams();
-        if (streams == null)
-            throw new NotAuthorizedException();
+        if (streams == null) {
+            /* Hades: no play item yet: the stream of that language of the first play item of the
+               playlist that has one (selectStreamNumber() keeps it for the start) */
+            StreamInfo[][] title = getTitleStreams();
+            if (title == null)
+                throw new NotAuthorizedException();
+            for (int i = 0; i < title.length; i++) {
+                if (title[i] == null)
+                    continue;
+                for (int j = 0; j < title[i].length; j++) {
+                    if (title[i][j].getLang().equals(language)) {
+                        try {
+                            selectStreamNumber(j + 1);
+                            return;
+                        } catch (StreamNotAvailableException e) {
+                            throw new NotAuthorizedException();
+                        }
+                    }
+                }
+            }
+            throw new LanguageNotAvailableException();
+        }
         for (int i = 0; i < streams.length; i++) {
             if (streams[i].getLang().equals(language)) {
                 try {
