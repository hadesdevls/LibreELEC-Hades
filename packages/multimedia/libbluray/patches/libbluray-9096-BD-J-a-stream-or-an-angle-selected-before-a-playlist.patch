diff --git a/src/libbluray/bdj/java/org/videolan/media/content/playlist/AngleControlImpl.java b/src/libbluray/bdj/java/org/videolan/media/content/playlist/AngleControlImpl.java
index 8ec4cc1..ee157ba 100644
--- a/src/libbluray/bdj/java/org/videolan/media/content/playlist/AngleControlImpl.java
+++ b/src/libbluray/bdj/java/org/videolan/media/content/playlist/AngleControlImpl.java
@@ -54,6 +54,13 @@ public class AngleControlImpl implements AngleControl {
     }
 
     public void selectAngle(int angle) throws InvalidAngleException {
+        /* Hades: before the player is prefetched, the angle its playlist starts with (selected now,
+           it would be the angle of whatever playlist libbluray has open, if any) */
+        int start = player.setStartAngle(angle);
+        if (start > 0)
+            return;
+        if (start < 0)
+            throw new InvalidAngleException();
         if (!Libbluray.selectAngle(angle))
             throw new InvalidAngleException();
     }
