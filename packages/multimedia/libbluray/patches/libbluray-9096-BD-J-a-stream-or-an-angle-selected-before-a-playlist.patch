@@ -391,6 +400,75 @@ public class Handler extends BDHandler {
         return pi;
     }
 
+    /*
+     * Hades: the play items of the playlist the player is set to (setSource(), selectPlayList()),
+     * for a stream selected before it is prefetched; null when it has none.
+     */
+    protected TIClip[] getTitleClips() {
+        synchronized (this) {
+            if (pi == null)
+                return null;
+            return pi.getClips();
+        }
+    }
+
+    protected static final int START_AUDIO = 1;
+    protected static final int START_PG_TEXTST = 2;
+    protected static final int START_SECONDARY_AUDIO = 3;
+
+    /*
+     * Hades: a stream selected before the player is prefetched goes into the locator it starts from,
+     * as a seek before it does (PlaylistPlayerAction): doPrefetch() writes it to its register before
+     * it starts the playlist, and libbluray keeps it where the first play item has it (and otherwise
+     * chooses by language, as for any stream register at a play item). False when the player is
+     * prefetched by now: the selection is then one of a play item.
+     */
+    protected boolean setStartStream(int kind, int num) {
+        synchronized (this) {
+            int state = getState();
+            if ((state == Prefetched) || (state == Started) || (sourceLocator == null))
+                return false;
+            String what;
+            switch (kind) {
+            case START_AUDIO:
+                sourceLocator.setPrimaryAudioStreamNumber(num);
+                what = "audio";
+                break;
+            case START_PG_TEXTST:
+                sourceLocator.setPGTextStreamNumber(num);
+                what = "subtitle";
+                break;
+            case START_SECONDARY_AUDIO:
+                sourceLocator.setSecondaryAudioStreamNumber(num);
+                what = "secondary audio";
+                break;
+            default:
+                return false;
+            }
+            System.err.println("Playlist " + sourceLocator.getPlayListId() + ": " + what + " stream " + num +
+                               " selected before it starts, kept for its start");
+            return true;
+        }
+    }
+
+    /*
+     * Hades: an angle selected before the player is prefetched: 1 kept (doPrefetch() selects it
+     * once the playlist is open), -1 not an angle of the playlist, 0 the player is prefetched by now.
+     */
+    protected int setStartAngle(int angle) {
+        synchronized (this) {
+            int state = getState();
+            if ((state == Prefetched) || (state == Started))
+                return 0;
+            if ((pi == null) || (angle < 1) || (angle > pi.getAngleCount()))
+                return -1;
+            startAngle = angle;
+            System.err.println("Playlist " + pi.getPlaylist() + ": angle " + angle +
+                               " selected before it starts, kept for its start");
+            return 1;
+        }
+    }
+
     protected TIClip getCurrentClipInfo() {
         synchronized (this) {
             int state = getState();
@@ -432,6 +510,7 @@ public class Handler extends BDHandler {
             this.pi = newPi;
             this.sourceLocator = locator;
             this.currentLocator = null;
+            this.startAngle = 0;
 
             baseMediaTime = 0;
             if (state == Prefetched)
@@ -498,6 +577,8 @@ public class Handler extends BDHandler {
     private PlaylistInfo pi = null;
     private BDLocator currentLocator = null;
     private BDLocator sourceLocator = null;
+    /* Hades: the angle selected before the player was prefetched (setStartAngle()), 0 none */
+    private int startAngle = 0;
 
     private static final Logger logger = Logger.getLogger(Handler.class.getName());
 }
