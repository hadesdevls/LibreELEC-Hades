 }
 
 static int _filter(int internet)
@@ -165,6 +156,8 @@ static int _filter(int internet)
 
     if (_socket_rules(ctx, "socket", internet) || _socket_rules(ctx, "socketpair", internet))
         goto out;
+    if (internet && hades_bdj_sandbox_net_rules(ctx))
+        goto out;
 
     rc = seccomp_load(ctx);
     if (rc < 0) {
@@ -196,6 +189,10 @@ int hades_bdj_sandbox_enter(void)
         return -1;
     }
 
+    /* BD-Live: the networks of this system, read while netlink is still there */
+    if (internet && hades_bdj_sandbox_net_prepare() != 0)
+        return -1;
+
     if (_filter(internet) != 0)
         return -1;
 
@@ -206,6 +203,11 @@ int hades_bdj_sandbox_enter(void)
         return -1;
     }
 
+    if (internet && hades_bdj_sandbox_net_check(why, sizeof(why)) != 0) {
+        fprintf(stderr, "hades-bdj: BD-Live: %s\n", why);
+        return -1;
+    }
+
     if (!bdj_sandbox_check(why, sizeof(why))) {
         fprintf(stderr, "hades-bdj: not isolated: %s\n", why);
         return -1;
diff --git a/src/tools/hades_bdj_sandbox_net.c b/src/tools/hades_bdj_sandbox_net.c
new file mode 100644
index 0000000..dc786e4
--- /dev/null
+++ b/src/tools/hades_bdj_sandbox_net.c
@@ -0,0 +1,201 @@
+/*
+ * This file is part of libbluray
+ * Copyright (C) 2026  Hades
+ *
