+/* BD-Live in the BD-J server (hades_bdj_sandbox.c, with HADES_BDJ_NETWORK=internet) */
+
+#ifndef HADES_BDJ_SANDBOX_NET_H_
+#define HADES_BDJ_SANDBOX_NET_H_
+
+#include <seccomp.h>
+
+/* before the filter: the networks of this system, for the JVM (HADES_BDJ_BDLIVE_LOCAL); 0 or -1 */
+int hades_bdj_sandbox_net_prepare(void);
+
+/* the rules of socket() / socketpair() with BD-Live: AF_UNIX, and TCP over IPv4; 0 or -1 */
+int hades_bdj_sandbox_net_socket_rules(scmp_filter_ctx ctx, const char *name);
+
+/* the rest with BD-Live: no listening, no accepting; 0 or -1 */
+int hades_bdj_sandbox_net_rules(scmp_filter_ctx ctx);
+
+/* after the filter: the filters are in force (the system's on the addresses, ours on the
+   sockets); 0, or -1 and why */
+int hades_bdj_sandbox_net_check(char *why, unsigned len);
+
+#endif /* HADES_BDJ_SANDBOX_NET_H_ */
