+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * BD-Live in the BD-J server: the second and third walls below the check of libbluray's Java
+ * (NetAddress, BDJSocketImpl).
+ *
+ * - The service (hades-bdj-net@.service) reaches only addresses of the Internet: IPAddressDeny=,
+ *   a BPF program of the kernel on the cgroup of the instance. systemd starts the unit without
+ *   it, with only a warning, where the kernel cannot do it: so the server checks that a
+ *   datagram to loopback and to a documentation address is refused by the kernel (EPERM)
+ *   before it opens the disc, and ends otherwise.
+ * - This filter: sockets of AF_UNIX (the connection to the player) and TCP over IPv4 only; no
+ *   UDP (no name server, no other datagram), no IPv6, no raw sockets, no other protocol; nothing
+ *   listens or accepts.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "hades_bdj_sandbox_net.h"
+
+#include "libbluray/bdj/bdlive_net.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+static int _refused_by_system(const char *addr, char *why, unsigned len);
+
+int hades_bdj_sandbox_net_prepare(void)
+{
+    BDLIVE_LOCAL local;
+    char buf[1024];
+
+    /* the system's filter on the addresses: loopback, where the player listens, and an address
+       that would go out by the default route */
+    if (!_refused_by_system("127.0.0.1", buf, sizeof(buf)) || !_refused_by_system("192.0.2.1", buf, sizeof(buf))) {
+        fprintf(stderr, "hades-bdj: BD-Live: %s\n", buf);
+        return -1;
+    }
+
+    if (bdlive_local_read(&local) != 0 || local.count == 0) {
+        fprintf(stderr, "hades-bdj: BD-Live: the networks of this system can not be read\n");
+        return -1;
+    }
+    bdlive_local_format(&local, buf, sizeof(buf));
+    if (!buf[0] || setenv("HADES_BDJ_BDLIVE_LOCAL", buf, 1) != 0) {
+        return -1;
+    }
+    fprintf(stderr, "hades-bdj: BD-Live: never to this system or its networks: %s\n", buf);
+    return 0;
+}
+
+static int _add(scmp_filter_ctx ctx, uint32_t action, int nr, unsigned count, const struct scmp_arg_cmp *cmp)
+{
+    int rc;
+
+    if (nr == __NR_SCMP_ERROR) {
+        return 0;
+    }
+    rc = seccomp_rule_add_array(ctx, action, nr, count, cmp);
+    if (rc < 0) {
+        fprintf(stderr, "hades-bdj: seccomp rule failed: %s\n", strerror(-rc));
+        return -1;
+    }
+    return 0;
+}
+
+int hades_bdj_sandbox_net_socket_rules(scmp_filter_ctx ctx, const char *name)
+{
+    const int nr = seccomp_syscall_resolve_name(name);
+    struct scmp_arg_cmp cmp[2];
+    int type, proto;
+
+    /* families: AF_UNIX and AF_INET; every other one, AF_INET6 included */
+    cmp[0] = SCMP_A0(SCMP_CMP_EQ, AF_UNSPEC);
+    if (_add(ctx, SCMP_ACT_ERRNO(EAFNOSUPPORT), nr, 1, cmp))
+        return -1;
+    cmp[0] = SCMP_A0(SCMP_CMP_GT, AF_INET);
+    if (_add(ctx, SCMP_ACT_ERRNO(EAFNOSUPPORT), nr, 1, cmp))
+        return -1;
+
+    if (!strcmp(name, "socketpair")) {
+        cmp[0] = SCMP_A0(SCMP_CMP_EQ, AF_INET);
+        return _add(ctx, SCMP_ACT_ERRNO(EAFNOSUPPORT), nr, 1, cmp);
+    }
+
+    /* AF_INET: SOCK_STREAM only (the low four bits are the type; the others SOCK_CLOEXEC and
+       SOCK_NONBLOCK) */
+    for (type = 0; type < 16; type++) {
+        if (type == SOCK_STREAM)
+            continue;
+        cmp[0] = SCMP_A0(SCMP_CMP_EQ, AF_INET);
+        cmp[1] = SCMP_A1(SCMP_CMP_MASKED_EQ, 0xf, (unsigned)type);
+        if (_add(ctx, SCMP_ACT_ERRNO(EPROTONOSUPPORT), nr, 2, cmp))
+            return -1;
+    }
+    /* and TCP: protocol 0 or IPPROTO_TCP (6), not SCTP, MPTCP or another */
+    for (proto = 1; proto < IPPROTO_TCP; proto++) {
+        cmp[0] = SCMP_A0(SCMP_CMP_EQ, AF_INET);
+        cmp[1] = SCMP_A2(SCMP_CMP_EQ, (unsigned)proto);
+        if (_add(ctx, SCMP_ACT_ERRNO(EPROTONOSUPPORT), nr, 2, cmp))
+            return -1;
+    }
+    cmp[0] = SCMP_A0(SCMP_CMP_EQ, AF_INET);
+    cmp[1] = SCMP_A2(SCMP_CMP_GT, IPPROTO_TCP);
+    return _add(ctx, SCMP_ACT_ERRNO(EPROTONOSUPPORT), nr, 2, cmp);
+}
+
+int hades_bdj_sandbox_net_rules(scmp_filter_ctx ctx)
+{
+    static const char *const refused[] = { "listen", "accept", "accept4" };
+    size_t i;
+
+    for (i = 0; i < sizeof(refused) / sizeof(refused[0]); i++) {
+        if (_add(ctx, SCMP_ACT_ERRNO(EPERM), seccomp_syscall_resolve_name(refused[i]), 0, NULL))
+            return -1;
+    }
+    return 0;
+}
+
+/*
+ * The kernel's filter of the service's addresses (IPAddressDeny=) is in force: a datagram to addr
+ * is refused at once (EPERM). Measured: a TCP connection to a refused address is not refused at
+ * once, its SYN is dropped and connect() waits; a datagram is, and without the filter it goes. So
+ * the proof is a datagram, sent before the seccomp filter takes UDP away. 1, else 0 and why.
+ */
+static int _refused_by_system(const char *addr, char *why, unsigned len)
+{
+    struct sockaddr_in sa;
+    int fd, rc, err;
+
+    fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) {
+        snprintf(why, len, "no socket to check the filter of addresses: %s", strerror(errno));
+        return 0;
+    }
+    memset(&sa, 0, sizeof(sa));
+    sa.sin_family = AF_INET;
+    sa.sin_port   = htons(9);   /* discard */
+    inet_pton(AF_INET, addr, &sa.sin_addr);
+    rc  = (int)sendto(fd, "", 0, 0, (struct sockaddr *)&sa, sizeof(sa));
+    err = errno;
+    close(fd);
+    if (rc >= 0 || err != EPERM) {
+        snprintf(why, len, "a datagram to %s was not refused by the system (%s): the addresses of the "
+                 "service are not limited (IPAddressDeny=)", addr, rc >= 0 ? "sent" : strerror(err));
+        return 0;
+    }
+    return 1;
+}
+
+int hades_bdj_sandbox_net_check(char *why, unsigned len)
+{
+    int fd;
+
+    /* our filter on the sockets */
+    fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd >= 0 || errno != EPROTONOSUPPORT) {
+        if (fd >= 0)
+            close(fd);
+        snprintf(why, len, "a UDP socket was not refused");
+        return -1;
+    }
+    fd = socket(AF_INET6, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd >= 0 || errno != EAFNOSUPPORT) {
+        if (fd >= 0)
+            close(fd);
+        snprintf(why, len, "an IPv6 socket was not refused");
+        return -1;
+    }
+    if (listen(0, 1) == 0 || errno != EPERM) {
+        snprintf(why, len, "listen() was not refused");
+        return -1;
+    }
+    return 0;
+}
