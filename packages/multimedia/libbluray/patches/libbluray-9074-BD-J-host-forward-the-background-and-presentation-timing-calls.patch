From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:05:45 +0000
Subject: [PATCH] BD-J host: forward the background and presentation timing
 calls

bd_bdj_waiting_for_playback(), bd_bdj_set_presentation_timing(),
bd_bdj_pending_seq(), bd_bdj_release() and bd_bdj_release_all() (the
HAVi background and the presentation timing of BD-J, SamuriHL) answer
for a disc that plays in the isolated BD-J host from there, as the
other calls do since the hand-over: the protocol carries them already
(BDR_OP_BDJ_*), and only the entry points did not go there.

A player enables presentation timing before bd_play(), while the disc
is still its own: the hand-over now gives that to the host, which
would otherwise play the title without it.
---
 src/libbluray/bluray.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/libbluray/bluray.c b/src/libbluray/bluray.c
index 6326d08..1de53af 100644
--- a/src/libbluray/bluray.c
+++ b/src/libbluray/bluray.c
@@ -1965,6 +1965,9 @@ static int _bdr_hand_over(BLURAY *bd)
 {
     BDR_START start;
     BDR_CLIENT *client;
+#ifdef BD_BDJ_PRESENTATION_TIMING
+    int timing;
+#endif
 
     if (bd->remote || bd->bdj_remote_mode != BLURAY_BDJ_REMOTE_AUTO || !bd->disc ||
         !bd->disc_info.bdj_detected || !bd->disc_info.bdj_handled) {
@@ -1991,7 +1994,17 @@ static int _bdr_hand_over(BLURAY *bd)
 
     bd_mutex_lock(&bd->mutex);
     bd->remote = client;
+#ifdef BD_BDJ_PRESENTATION_TIMING
+    timing = bd->bdj_pt_enabled;
+#endif
     bd_mutex_unlock(&bd->mutex);
+
+#ifdef BD_BDJ_PRESENTATION_TIMING
+    /* the player may have enabled presentation timing before the disc moved over */
+    if (timing) {
+        bdr_bdj_set_presentation_timing(client, 1);
+    }
+#endif
     return 1;
 }
 #endif
@@ -3225,6 +3238,8 @@ int bd_bdj_waiting_for_playback(BLURAY *bd)
 {
     int waiting;
 
+    BDR_FORWARD(bd, bdr_bdj_waiting_for_playback(bd->remote));
+
     if (!bd) {
         return 0;
     }
@@ -4486,6 +4501,7 @@ void bd_set_scr(BLURAY *bd, int64_t pts)
 
 void bd_bdj_set_presentation_timing(BLURAY *bd, int enable)
 {
+    BDR_FORWARD_VOID(bd, bdr_bdj_set_presentation_timing(bd->remote, enable));
     if (!bd) {
         return;
     }
@@ -4501,6 +4517,8 @@ void bd_bdj_set_presentation_timing(BLURAY *bd, int enable)
 uint32_t bd_bdj_pending_seq(BLURAY *bd)
 {
     uint32_t seq;
+
+    BDR_FORWARD(bd, bdr_bdj_pending_seq(bd->remote));
     if (!bd) {
         return 0;
     }
@@ -4515,6 +4533,7 @@ uint32_t bd_bdj_pending_seq(BLURAY *bd)
 
 void bd_bdj_release(BLURAY *bd, uint32_t seq)
 {
+    BDR_FORWARD_VOID(bd, bdr_bdj_release(bd->remote, seq));
     if (!bd) {
         return;
     }
@@ -4525,6 +4544,7 @@ void bd_bdj_release(BLURAY *bd, uint32_t seq)
 
 void bd_bdj_release_all(BLURAY *bd)
 {
+    BDR_FORWARD_VOID(bd, bdr_bdj_release_all(bd->remote));
     if (!bd) {
         return;
     }
-- 
