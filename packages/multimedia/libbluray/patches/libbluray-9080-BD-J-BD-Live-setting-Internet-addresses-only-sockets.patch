+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+package org.videolan;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.net.SocketAddress;
+import java.net.SocketException;
+import java.net.SocketImpl;
+import java.net.SocketOptions;
+import java.net.UnknownHostException;
+
+import java.nio.channels.SocketChannel;
+
+/*
+ * The socket of a disc's Xlet: a TCP connection to an address that BD-Live may reach
+ * (NetAddress), and only while BD-Live is on. Built on a SocketChannel and the Socket it
+ * adapts, with public API only: it is the same on every Java from 1.4 on, where libbluray's
+ * old way (java.net.SocksSocketImpl through reflection) only worked up to Java 12.
+ *
+ * The check is made on the address that is connected to, after any name is resolved (by the
+ * player, through the BD-J host: org.videolan.hades.bdlive). The system checks again, below
+ * this: the service of BD-Live reaches only those addresses (IPAddressDeny=), and only by TCP
+ * (the seccomp filter of the server).
+ */
+class BDJSocketImpl extends SocketImpl {
+
+    private SocketChannel channel;
+    private Socket        socket;     /* the channel's own socket */
+    private int           timeout;    /* SO_TIMEOUT, before the channel exists */
+    private boolean       closed;
+
+    BDJSocketImpl() {
+    }
+
+    static boolean enabled() {
+        return "YES".equals(System.getProperty("bluray.network.connected"));
+    }
+
+    private static void report(String msg) {
+        /* a line of kodi.log: on the critical path of libbluray's log, which the player shows */
+        logger.error("BD-Live: " + msg);
+    }
+
+    protected void create(boolean stream) throws IOException {
+        if (!stream) {
+            throw new IOException("datagram sockets are not available");
+        }
+    }
+
+    protected void connect(String host, int port) throws IOException {
+        connect(new InetSocketAddress(host, port), 0);
+    }
+
+    protected void connect(InetAddress address, int port) throws IOException {
+        connect(new InetSocketAddress(address, port), 0);
+    }
+
+    protected synchronized void connect(SocketAddress endpoint, int t) throws IOException {
+        if (!(endpoint instanceof InetSocketAddress)) {
+            throw new IllegalArgumentException("Unsupported address type");
+        }
+        InetSocketAddress ep = (InetSocketAddress)endpoint;
+        String what = (ep.isUnresolved() ? ep.getHostName() : ep.getAddress().getHostAddress()) +
+            ":" + ep.getPort();
+
+        if (closed) {
+            throw new SocketException("Socket is closed");
+        }
+        if (channel != null) {
+            throw new SocketException("Already connected");
+        }
+        if (!enabled()) {
+            report("connection to " + what + " refused: BD-Live is off");
+            throw new SocketException("BD-Live is off");
+        }
+
+        InetAddress address = ep.getAddress();
+        if (ep.isUnresolved()) {
+            try {
+                address = InetAddress.getByName(ep.getHostName());
+            } catch (UnknownHostException e) {
+                report("connection to " + what + " refused: the name was not resolved");
+                throw e;
+            }
+            ep = new InetSocketAddress(address, ep.getPort());
+        }
+
+        String refusal = NetAddress.refusal(address);
+        if (refusal != null) {
+            report("connection to " + what + " (" + address.getHostAddress() + ") refused: " + refusal);
+            throw new SocketException("BD-Live: " + address.getHostAddress() + " is not an address of the Internet");
+        }
+
+        SocketChannel ch = SocketChannel.open();
+        try {
+            Socket s = ch.socket();
+            if (timeout > 0) {
+                s.setSoTimeout(timeout);
+            }
+            s.connect(ep, t);
+            channel = ch;
+            socket  = s;
+            this.address   = ep.getAddress();
+            this.port      = ep.getPort();
+            this.localport = s.getLocalPort();
+            report("connection to " + what + " (" + address.getHostAddress() + ") allowed");
+        } catch (IOException e) {
+            try {
+                ch.close();
+            } catch (IOException ignore) {
+            }
+            report("connection to " + what + " (" + address.getHostAddress() + ") failed: " + e);
+            throw e;
+        }
+    }
+
+    protected void bind(InetAddress host, int port) throws IOException {
+        throw new SocketException("BD-Live: a disc does not bind sockets");
+    }
+
+    protected void listen(int backlog) throws IOException {
+        throw new SocketException("BD-Live: a disc does not listen");
+    }
+
+    protected void accept(SocketImpl s) throws IOException {
+        throw new SocketException("BD-Live: a disc does not accept connections");
+    }
+
+    private synchronized Socket connected() throws IOException {
+        if (closed) {
+            throw new SocketException("Socket is closed");
+        }
+        if (socket == null) {
+            throw new SocketException("Socket is not connected");
+        }
+        return socket;
+    }
+
+    protected InputStream getInputStream() throws IOException {
+        return connected().getInputStream();
+    }
+
+    protected OutputStream getOutputStream() throws IOException {
+        return connected().getOutputStream();
+    }
+
+    protected int available() throws IOException {
+        return connected().getInputStream().available();
+    }
+
+    protected void close() throws IOException {
+        SocketChannel ch;
+        synchronized (this) {
+            closed = true;
+            ch = channel;
+        }
+        if (ch != null) {
+            ch.close();
+        }
+    }
+
+    /* the Xlet ends (BDJSockets): its connections end with it */
+    void closeFromXlet() {
+        try {
+            close();
+        } catch (IOException e) {
+            logger.error("Failed to close socket: " + e);
+        }
+    }
+
+    synchronized boolean isClosed() {
+        return closed;
+    }
+
+    protected void shutdownInput() throws IOException {
+        connected().shutdownInput();
+    }
+
+    protected void shutdownOutput() throws IOException {
+        connected().shutdownOutput();
+    }
+
+    protected boolean supportsUrgentData() {
+        return true;
+    }
+
+    protected void sendUrgentData(int data) throws IOException {
+        connected().sendUrgentData(data);
+    }
+
+    public void setOption(int optID, Object value) throws SocketException {
+        Socket s;
+        synchronized (this) {
+            if (closed) {
+                throw new SocketException("Socket is closed");
+            }
+            s = socket;
+            if (s == null) {
+                /* before the connection: only the timeout is kept for it */
+                if (optID == SocketOptions.SO_TIMEOUT) {
+                    timeout = ((Integer)value).intValue();
+                    return;
+                }
+                if (optID == SocketOptions.TCP_NODELAY || optID == SocketOptions.SO_KEEPALIVE ||
+                    optID == SocketOptions.SO_LINGER || optID == SocketOptions.SO_RCVBUF ||
+                    optID == SocketOptions.SO_SNDBUF || optID == SocketOptions.IP_TOS ||
+                    optID == SocketOptions.SO_OOBINLINE || optID == SocketOptions.SO_REUSEADDR) {
+                    return;
+                }
+                throw new SocketException("option " + optID + " not supported");
+            }
+        }
+        switch (optID) {
+        case SocketOptions.SO_TIMEOUT:
+            s.setSoTimeout(((Integer)value).intValue());
+            break;
+        case SocketOptions.TCP_NODELAY:
+            s.setTcpNoDelay(((Boolean)value).booleanValue());
+            break;
+        case SocketOptions.SO_KEEPALIVE:
+            s.setKeepAlive(((Boolean)value).booleanValue());
+            break;
+        case SocketOptions.SO_OOBINLINE:
+            s.setOOBInline(((Boolean)value).booleanValue());
+            break;
+        case SocketOptions.SO_REUSEADDR:
+            s.setReuseAddress(((Boolean)value).booleanValue());
+            break;
+        case SocketOptions.SO_RCVBUF:
+            s.setReceiveBufferSize(((Integer)value).intValue());
+            break;
+        case SocketOptions.SO_SNDBUF:
+            s.setSendBufferSize(((Integer)value).intValue());
+            break;
+        case SocketOptions.IP_TOS:
+            s.setTrafficClass(((Integer)value).intValue());
+            break;
+        case SocketOptions.SO_LINGER:
+            if (value instanceof Boolean) {
+                s.setSoLinger(false, 0);
+            } else {
+                s.setSoLinger(true, ((Integer)value).intValue());
+            }
+            break;
+        default:
+            throw new SocketException("option " + optID + " not supported");
+        }
+    }
+
+    public Object getOption(int optID) throws SocketException {
+        Socket s;
+        synchronized (this) {
+            if (closed) {
+                throw new SocketException("Socket is closed");
+            }
+            s = socket;
+            if (s == null) {
+                if (optID == SocketOptions.SO_TIMEOUT) {
+                    return new Integer(timeout);
+                }
+                return null;
+            }
+        }
+        switch (optID) {
+        case SocketOptions.SO_TIMEOUT:   return new Integer(s.getSoTimeout());
+        case SocketOptions.TCP_NODELAY:  return Boolean.valueOf(s.getTcpNoDelay());
+        case SocketOptions.SO_KEEPALIVE: return Boolean.valueOf(s.getKeepAlive());
+        case SocketOptions.SO_OOBINLINE: return Boolean.valueOf(s.getOOBInline());
+        case SocketOptions.SO_REUSEADDR: return Boolean.valueOf(s.getReuseAddress());
+        case SocketOptions.SO_RCVBUF:    return new Integer(s.getReceiveBufferSize());
+        case SocketOptions.SO_SNDBUF:    return new Integer(s.getSendBufferSize());
+        case SocketOptions.IP_TOS:       return new Integer(s.getTrafficClass());
+        case SocketOptions.SO_BINDADDR:  return s.getLocalAddress();
+        case SocketOptions.SO_LINGER: {
+            int l = s.getSoLinger();
+            return l < 0 ? (Object)Boolean.FALSE : (Object)new Integer(l);
+        }
+        default:
+            return null;
+        }
+    }
+
+    private static final Logger logger = Logger.getLogger(BDJSocketImpl.class.getName());
+}
