+package org.videolan;
+
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.util.StringTokenizer;
+
+/*
+ * BD-Live: the addresses the Java code of a disc may connect to. The rule of bdlive_net.c, in
+ * Java: IPv4 of the Internet only (not this network, private networks, carrier-grade NAT,
+ * loopback, link-local, IETF assignments, documentation, 6to4 relays, benchmarking, multicast,
+ * reserved, broadcast), and not this system or a network it is on (HADES_BDJ_BDLIVE_LOCAL, which
+ * the BD-J server reads from the interfaces before it confines itself). No IPv6.
+ */
+public final class NetAddress {
+
+    private static final int[][] REFUSED = {
+        /* network, prefix length */
+        { 0x00000000,  8 }, { 0x0a000000,  8 }, { 0x64400000, 10 }, { 0x7f000000,  8 },
+        { 0xa9fe0000, 16 }, { 0xac100000, 12 }, { 0xc0000000, 24 }, { 0xc0000200, 24 },
+        { 0xc0586300, 24 }, { 0xc0a80000, 16 }, { 0xc6120000, 15 }, { 0xc6336400, 24 },
+        { 0xcb007100, 24 }, { 0xe0000000,  4 }, { 0xf0000000,  4 },
+    };
+    private static final String[] WHY = {
+        "\"this network\" (0.0.0.0/8)", "a private network (10.0.0.0/8)",
+        "carrier-grade NAT (100.64.0.0/10)", "loopback (127.0.0.0/8)",
+        "link-local (169.254.0.0/16)", "a private network (172.16.0.0/12)",
+        "IETF protocol assignments (192.0.0.0/24)", "documentation (192.0.2.0/24)",
+        "6to4 relays (192.88.99.0/24)", "a private network (192.168.0.0/16)",
+        "benchmarking (198.18.0.0/15)", "documentation (198.51.100.0/24)",
+        "documentation (203.0.113.0/24)", "multicast (224.0.0.0/4)",
+        "reserved or broadcast (240.0.0.0/4)",
+    };
+
+    /* the subnets of this system: address, mask; null: they could not be read (nothing allowed) */
+    private static int[][] local;
+    private static boolean localRead;
+
+    private NetAddress() {
+    }
+
+    private static int mask(int len) {
+        return len == 0 ? 0 : (int)(0xffffffffL << (32 - len));
+    }
+
+    private static synchronized int[][] local() {
+        if (!localRead) {
+            localRead = true;
+            local = parseLocal(System.getenv("HADES_BDJ_BDLIVE_LOCAL"));
+        }
+        return local;
+    }
+
+    /* "a.b.c.d/n,..." -> {addr, mask}...; null for anything else */
+    static int[][] parseLocal(String s) {
+        if (s == null) {
+            return null;
+        }
+        StringTokenizer st = new StringTokenizer(s, ",");
+        int[][] r = new int[st.countTokens()][];
+        for (int i = 0; i < r.length; i++) {
+            String t = st.nextToken();
+            int slash = t.indexOf('/');
+            if (slash < 0) {
+                return null;
+            }
+            StringTokenizer o = new StringTokenizer(t.substring(0, slash), ".");
+            if (o.countTokens() != 4) {
+                return null;
+            }
+            int a = 0, len;
+            try {
+                for (int k = 0; k < 4; k++) {
+                    int b = Integer.parseInt(o.nextToken());
+                    if (b < 0 || b > 255) {
+                        return null;
+                    }
+                    a = (a << 8) | b;
+                }
+                len = Integer.parseInt(t.substring(slash + 1));
+            } catch (NumberFormatException e) {
+                return null;
+            }
+            if (len < 0 || len > 32) {
+                return null;
+            }
+            r[i] = new int[] { a, mask(len) };
+        }
+        return r;
+    }
+
+    /* null if BD-Live may connect to the IPv4 address (in host order), or why not */
+    static String refusal4(int addr, int[][] loc) {
+        for (int i = 0; i < REFUSED.length; i++) {
+            if ((addr & mask(REFUSED[i][1])) == REFUSED[i][0]) {
+                return WHY[i];
+            }
+        }
+        if (loc == null) {
+            return "the networks of this system are not known";
+        }
+        for (int i = 0; i < loc.length; i++) {
+            if (addr == loc[i][0]) {
+                return "an address of this system";
+            }
+            if ((addr & loc[i][1]) == (loc[i][0] & loc[i][1])) {
+                return "a network this system is on";
+            }
+        }
+        return null;
+    }
+
+    /* null if BD-Live may connect to the address, or why not */
+    public static String refusal(InetAddress address) {
+        if (!(address instanceof Inet4Address)) {
+            return address == null ? "no address" : "IPv6 (BD-Live uses IPv4 only)";
+        }
+        byte[] b = address.getAddress();
+        int a = ((b[0] & 255) << 24) | ((b[1] & 255) << 16) | ((b[2] & 255) << 8) | (b[3] & 255);
+        return refusal4(a, local());
+    }
+
+    /* for the tests: the rule with the given subnets of this system */
+    public static String refusal(byte[] b, String localSubnets) {
+        if (b == null || b.length != 4) {
+            return "IPv6 (BD-Live uses IPv4 only)";
+        }
+        int a = ((b[0] & 255) << 24) | ((b[1] & 255) << 16) | ((b[2] & 255) << 8) | (b[3] & 255);
+        return refusal4(a, parseLocal(localSubnets));
+    }
+}
