index 0000000..a2405fd
--- /dev/null
+++ b/src/libbluray/bdj/bdlive_net.c
@@ -0,0 +1,162 @@
+/*
+ * This file is part of libbluray
+ * Copyright (C) 2026  Hades
+ *
