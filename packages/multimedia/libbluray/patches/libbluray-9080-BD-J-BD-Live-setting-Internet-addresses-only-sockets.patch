+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+#if HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "bdlive_net.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#ifdef __linux__
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#endif
+
+/* IPv4 that is not globally reachable (IANA's IPv4 Special-Purpose Address Registry, and RFC 1918,
+   6598, 1122, 3927, 5737, 2544, 7526, 5771, 1112); the same table as NetAddress.java and as the
+   IPAddressDeny= of hades-bdj-net@.service */
+static const struct {
+    uint32_t    net;
+    unsigned    len;
+    const char *why;
+} refused4[] = {
+    { 0x00000000u,  8, "\"this network\" (0.0.0.0/8)" },
+    { 0x0a000000u,  8, "a private network (10.0.0.0/8)" },
+    { 0x64400000u, 10, "carrier-grade NAT (100.64.0.0/10)" },
+    { 0x7f000000u,  8, "loopback (127.0.0.0/8)" },
+    { 0xa9fe0000u, 16, "link-local (169.254.0.0/16)" },
+    { 0xac100000u, 12, "a private network (172.16.0.0/12)" },
+    { 0xc0000000u, 24, "IETF protocol assignments (192.0.0.0/24)" },
+    { 0xc0000200u, 24, "documentation (192.0.2.0/24)" },
+    { 0xc0586300u, 24, "6to4 relays (192.88.99.0/24)" },
+    { 0xc0a80000u, 16, "a private network (192.168.0.0/16)" },
+    { 0xc6120000u, 15, "benchmarking (198.18.0.0/15)" },
+    { 0xc6336400u, 24, "documentation (198.51.100.0/24)" },
+    { 0xcb007100u, 24, "documentation (203.0.113.0/24)" },
+    { 0xe0000000u,  4, "multicast (224.0.0.0/4)" },
+    { 0xf0000000u,  4, "reserved or broadcast (240.0.0.0/4)" },
+};
+
+static uint32_t _mask(unsigned len)
+{
+    return len ? 0xffffffffu << (32 - len) : 0;
+}
+
+const char *bdlive_ipv4_refusal(uint32_t addr, const BDLIVE_LOCAL *local)
+{
+    unsigned i;
+
+    for (i = 0; i < sizeof(refused4) / sizeof(refused4[0]); i++) {
+        if ((addr & _mask(refused4[i].len)) == refused4[i].net) {
+            return refused4[i].why;
+        }
+    }
+    if (local) {
+        for (i = 0; i < local->count && i < BDLIVE_MAX_LOCAL; i++) {
+            if (addr == local->net[i].addr) {
+                return "an address of this system";
+            }
+            if ((addr & local->net[i].mask) == (local->net[i].addr & local->net[i].mask)) {
+                return "a network this system is on";
+            }
+        }
+    }
+    return NULL;
+}
+
+const char *bdlive_addr_refusal(int family, const uint8_t *a, const BDLIVE_LOCAL *local)
+{
+#ifdef __linux__
+    if (family == AF_INET) {
+        uint32_t addr = ((uint32_t)a[0] << 24) | ((uint32_t)a[1] << 16) | ((uint32_t)a[2] << 8) | a[3];
+        return bdlive_ipv4_refusal(addr, local);
+    }
+    if (family == AF_INET6) {
+        return "IPv6 (BD-Live uses IPv4 only)";
+    }
+#else
+    (void)family; (void)a; (void)local;
+#endif
+    return "not an Internet address";
+}
+
+int bdlive_local_read(BDLIVE_LOCAL *local)
+{
+    memset(local, 0, sizeof(*local));
+#ifdef __linux__
+    {
+        struct ifaddrs *ifa, *p;
+
+        if (getifaddrs(&ifa) != 0) {
+            return -1;
+        }
+        for (p = ifa; p; p = p->ifa_next) {
+            const struct sockaddr_in *sa = (const struct sockaddr_in *)p->ifa_addr;
+            const struct sockaddr_in *nm = (const struct sockaddr_in *)p->ifa_netmask;
+            if (!sa || sa->sin_family != AF_INET) {
+                continue;
+            }
+            if (local->count >= BDLIVE_MAX_LOCAL) {
+                /* more subnets than kept: a subnet that is not kept would be reachable */
+                freeifaddrs(ifa);
+                return -1;
+            }
+            local->net[local->count].addr = ntohl(sa->sin_addr.s_addr);
+            local->net[local->count].mask = (nm && nm->sin_family == AF_INET) ? ntohl(nm->sin_addr.s_addr)
+                                                                              : 0xffffffffu;
+            local->count++;
+        }
+        freeifaddrs(ifa);
+        return 0;
+    }
+#else
+    return -1;
+#endif
+}
+
+void bdlive_local_format(const BDLIVE_LOCAL *local, char *buf, unsigned len)
+{
+    unsigned i, used = 0;
+
+    if (!len) {
+        return;
+    }
+    buf[0] = 0;
+    for (i = 0; i < local->count && i < BDLIVE_MAX_LOCAL; i++) {
+        uint32_t a = local->net[i].addr, m = local->net[i].mask;
+        unsigned bits = 0;
+        int n;
+        while (bits < 32 && (m & (0x80000000u >> bits))) {
+            bits++;
+        }
+        n = snprintf(buf + used, len - used, "%s%u.%u.%u.%u/%u", used ? "," : "",
+                     (a >> 24) & 255, (a >> 16) & 255, (a >> 8) & 255, a & 255, bits);
+        if (n < 0 || (unsigned)n >= len - used) {
+            buf[used] = 0;
+            return;
+        }
+        used += (unsigned)n;
+    }
+}
