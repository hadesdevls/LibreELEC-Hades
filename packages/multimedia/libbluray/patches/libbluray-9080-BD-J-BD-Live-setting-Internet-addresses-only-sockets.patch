+/*
+ * BD-Live (BLURAY_PLAYER_SETTING_BDJ_NETWORK = BLURAY_BDJ_NETWORK_INTERNET): which addresses the
+ * Java code of a disc may reach. Only addresses of the Internet: IPv4 outside every range that is
+ * not globally reachable (this network, RFC 1918, carrier-grade NAT, loopback, link-local, IETF
+ * assignments, documentation, 6to4 relays, benchmarking, multicast, reserved and broadcast), and
+ * outside the addresses and on-link subnets of this system's own interfaces. No IPv6 at all: on a
+ * home network every device has global IPv6 addresses in the prefix of this system, so no rule
+ * on the address can tell the devices of the network (or this system, where the player listens)
+ * from the Internet.
+ *
+ * The same rule is written in Java (org.videolan.NetAddress) and, its fixed part, in the units of
+ * the service (IPAddressDeny=); the tests check the three against one table.
+ */
+
+#ifndef BDLIVE_NET_H_
+#define BDLIVE_NET_H_
+
+#include "util/attributes.h"
+
+#include <stdint.h>
+
+#define BDLIVE_MAX_LOCAL 32
+
+/* an IPv4 subnet of this system: its address and mask, in host byte order */
+typedef struct {
+    uint32_t addr;
+    uint32_t mask;
+} BDLIVE_SUBNET;
+
+typedef struct {
+    unsigned      count;
+    BDLIVE_SUBNET net[BDLIVE_MAX_LOCAL];
+} BDLIVE_LOCAL;
+
+/*
+ * NULL if the IPv4 address (host byte order) may be reached by BD-Live, or why not. local: the
+ * subnets of this system's interfaces (may be NULL).
+ */
+BD_PRIVATE const char *bdlive_ipv4_refusal(uint32_t addr, const BDLIVE_LOCAL *local);
+
+/* the same for an address of a family (AF_INET: 4 bytes, AF_INET6: 16 bytes, network order) */
+BD_PRIVATE const char *bdlive_addr_refusal(int family, const uint8_t *addr, const BDLIVE_LOCAL *local);
+
+/* the IPv4 subnets of this system's interfaces, from getifaddrs(): 0, or -1 if they cannot be read */
+BD_PRIVATE int bdlive_local_read(BDLIVE_LOCAL *local);
+
+/* "a.b.c.d/n,..." for the environment of the JVM (HADES_BDJ_BDLIVE_LOCAL); buf of len bytes */
+BD_PRIVATE void bdlive_local_format(const BDLIVE_LOCAL *local, char *buf, unsigned len);
+
+#endif /* BDLIVE_NET_H_ */
