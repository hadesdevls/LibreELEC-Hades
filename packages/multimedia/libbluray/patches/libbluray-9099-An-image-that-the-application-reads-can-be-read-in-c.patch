diff --git a/src/libbluray/disc/udf_fs.c b/src/libbluray/disc/udf_fs.c
index ac9cb56..a844706 100644
--- a/src/libbluray/disc/udf_fs.c
+++ b/src/libbluray/disc/udf_fs.c
@@ -212,27 +212,142 @@ static struct udfread_block_input *_block_input(const char *img)
 }
 
 
+/*
+ * (Hades) BLURAY_PLAYER_SETTING_IMAGE_CACHE: an image read by the application is read in aligned chunks of
+ * SI_CHUNK_BLOCKS blocks, and the chunks read last are kept. Opening a disc reads many small pieces of the image,
+ * here and there (descriptors, directories, file entries, playlists, clip information): over a network each read
+ * that does not follow the one before is a new request, with its round trip. Read in chunks, most of those pieces
+ * come from a chunk already read, and the clips are read in reads of a chunk. A read gives what it gave without the
+ * cache: whatever the cache cannot give is read as asked.
+ */
+
+#define SI_CHUNK_BLOCKS 32 /* 64 KiB */
+
+typedef struct {
+    uint32_t first;  /* the first block of the chunk, when blocks > 0 */
+    uint32_t blocks; /* the blocks of it that were read (fewer at the end of the image) */
+    uint64_t used;   /* when it was used last (0: never) */
+    uint8_t *data;
+} SI_CHUNK;
+
 typedef struct {
     struct udfread_block_input i;
     void *read_block_handle;
     int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks);
+
+    /* the chunks kept (none: nchunks 0) */
+    BD_MUTEX  mutex;
+    unsigned  nchunks;
+    SI_CHUNK *chunks;
+    uint64_t  tick;
 } UDF_SI;
 
 static int _si_close(struct udfread_block_input *bi_gen)
 {
+    UDF_SI *si = (UDF_SI *)bi_gen;
+    unsigned ii;
+
+    if (si->chunks) {
+        for (ii = 0; ii < si->nchunks; ii++) {
+            X_FREE(si->chunks[ii].data);
+        }
+        X_FREE(si->chunks);
+        bd_mutex_destroy(&si->mutex);
+    }
     X_FREE(bi_gen);
     return 0;
 }
 
+/* the chunk that begins at block first: a kept one, or read in the place of the one used longest ago, as much of
+   it as can be read (a read may give fewer blocks than asked: it is asked again for the rest); NULL when not a block
+   of it can be read */
+static SI_CHUNK *_si_chunk(UDF_SI *si, uint32_t first)
+{
+    SI_CHUNK *c = NULL;
+    uint32_t got = 0;
+    unsigned ii;
+
+    for (ii = 0; ii < si->nchunks; ii++) {
+        SI_CHUNK *k = &si->chunks[ii];
+        if (k->blocks && k->first == first) {
+            k->used = ++si->tick;
+            return k;
+        }
+        if (!c || k->used < c->used) {
+            c = k;
+        }
+    }
+
+    if (!c->data) {
+        c->data = malloc(SI_CHUNK_BLOCKS * UDF_BLOCK_SIZE);
+        if (!c->data) {
+            return NULL;
+        }
+    }
+    c->blocks = 0;
+    while (got < SI_CHUNK_BLOCKS) {
+        int r = si->read_blocks(si->read_block_handle, c->data + (size_t)got * UDF_BLOCK_SIZE,
+                                (int)(first + got), (int)(SI_CHUNK_BLOCKS - got));
+        if (r <= 0) {
+            break;
+        }
+        got += (uint32_t)r < SI_CHUNK_BLOCKS - got ? (uint32_t)r : SI_CHUNK_BLOCKS - got;
+    }
+    if (!got) {
+        return NULL;
+    }
+    c->first  = first;
+    c->blocks = got;
+    c->used   = ++si->tick;
+    return c;
+}
+
 static int _si_read(struct udfread_block_input *bi_gen, uint32_t lba, void *buf, uint32_t nblocks, int flags)
 {
     (void)flags;
     UDF_SI *si = (UDF_SI *)bi_gen;
-    return si->read_blocks(si->read_block_handle, buf, lba, nblocks);
+    uint32_t done = 0;
+    int got;
+
+    /* without the cache, and for a read of a chunk or more, as asked */
+    if (!si->nchunks || nblocks >= SI_CHUNK_BLOCKS) {
+        return si->read_blocks(si->read_block_handle, buf, lba, nblocks);
+    }
+
+    bd_mutex_lock(&si->mutex);
+    while (done < nblocks) {
+        uint32_t b     = lba + done;
+        uint32_t first = b - b % SI_CHUNK_BLOCKS;
+        uint32_t n;
+        SI_CHUNK *c = _si_chunk(si, first);
+        if (!c || b - first >= c->blocks) {
+            break;
+        }
+        n = c->blocks - (b - first);
+        if (n > nblocks - done) {
+            n = nblocks - done;
+        }
+        memcpy((uint8_t *)buf + (size_t)done * UDF_BLOCK_SIZE, c->data + (size_t)(b - first) * UDF_BLOCK_SIZE,
+               (size_t)n * UDF_BLOCK_SIZE);
+        done += n;
+    }
+    bd_mutex_unlock(&si->mutex);
+
+    if (done == nblocks) {
+        return (int)done;
+    }
+    /* what the cache could not give (the end of the image, a block that cannot be read) is read as asked */
+    got = si->read_blocks(si->read_block_handle, (uint8_t *)buf + (size_t)done * UDF_BLOCK_SIZE, (int)(lba + done),
+                          (int)(nblocks - done));
+    if (got < 0) {
+        return done ? (int)done : got;
+    }
+    return (int)done + got;
 }
 
 static struct udfread_block_input *_stream_input(void *read_block_handle,
-                                                 int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks))
+                                                 int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks),
+                                                 unsigned cache_kib)
 {
     UDF_SI *si = calloc(1, sizeof(*si));
     if (si) {
@@ -240,6 +355,17 @@ static struct udfread_block_input *_stream_input(void *read_block_handle,
         si->read_blocks = read_blocks;
         si->i.close = _si_close;
         si->i.read  = _si_read;
+        si->nchunks = cache_kib / (SI_CHUNK_BLOCKS * UDF_BLOCK_SIZE / 1024);
+        if (si->nchunks) {
+            si->chunks = calloc(si->nchunks, sizeof(*si->chunks));
+            if (!si->chunks) {
+                si->nchunks = 0;
+            } else {
+                bd_mutex_init(&si->mutex);
+                BD_DEBUG(DBG_FILE | DBG_CRIT, "The image is read in chunks of %d KiB, the last %u of them kept\n",
+                         SI_CHUNK_BLOCKS * UDF_BLOCK_SIZE / 1024, si->nchunks);
+            }
+        }
         return &si->i;
     }
     return NULL;
@@ -248,7 +374,8 @@ static struct udfread_block_input *_stream_input(void *read_block_handle,
 
 void *bdpriv_udf_image_open(const char *img_path,
                             void *read_block_handle,
-                            int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks))
+                            int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks),
+                            unsigned cache_kib)
 {
     udfread *udf = udfread_init();
     int result = -1;
@@ -259,7 +386,7 @@ void *bdpriv_udf_image_open(const char *img_path,
 
     /* stream ? */
     if (read_blocks) {
-        struct udfread_block_input *si = _stream_input(read_block_handle, read_blocks);
+        struct udfread_block_input *si = _stream_input(read_block_handle, read_blocks, cache_kib);
         if (si) {
             result = udfread_open_input(udf, si);
             if (result < 0) {
diff --git a/src/libbluray/disc/udf_fs.h b/src/libbluray/disc/udf_fs.h
index 7b68ede..63d4817 100644
--- a/src/libbluray/disc/udf_fs.h
+++ b/src/libbluray/disc/udf_fs.h
@@ -27,7 +27,8 @@ struct bd_dir_s;
 
 BD_PRIVATE void *bdpriv_udf_image_open(const char *img_path,
                                        void *read_block_handle,
-                                       int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks));
+                                       int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks),
+                                       unsigned cache_kib);
 BD_PRIVATE void  bdpriv_udf_image_close(void *udf);
 
 BD_PRIVATE const char       *bdpriv_udf_volume_id(void *udf);
