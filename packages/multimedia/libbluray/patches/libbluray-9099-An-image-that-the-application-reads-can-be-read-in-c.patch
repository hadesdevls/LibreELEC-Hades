-    fs_access fs = { read_blocks_handle, read_blocks, NULL, NULL };
+    fs_access fs = { read_blocks_handle, read_blocks, NULL, NULL, bd ? bd->image_cache_kib : 0 };
     return _bd_open(bd, NULL, NULL, &fs);
 }
 
@@ -2190,7 +2191,7 @@ int bd_open_files(BLURAY *bd,
         return 0;
     }
 
-    fs_access fs = { handle, NULL, open_dir, open_file };
+    fs_access fs = { handle, NULL, open_dir, open_file, 0 };
     return _bd_open(bd, NULL, NULL, &fs);
 }
 
@@ -3898,6 +3899,22 @@ static int _set_player_setting(BLURAY *bd, uint32_t idx, uint32_t value)
         return 1;
     }
 
+    if (idx == BLURAY_PLAYER_SETTING_IMAGE_CACHE) {
+        /* taken when the image is opened (bd_open_stream()) */
+        if (value > 65536) {
+            return 0;
+        }
+        bd_mutex_lock(&bd->mutex);
+        if (bd->disc) {
+            bd_mutex_unlock(&bd->mutex);
+            BD_DEBUG(DBG_BLURAY | DBG_CRIT, "Can't change the image cache once the disc is open\n");
+            return 0;
+        }
+        bd->image_cache_kib = value;
+        bd_mutex_unlock(&bd->mutex);
+        return 1;
+    }
+
     if (idx == BLURAY_PLAYER_SETTING_BDJ_NETWORK) {
         /* Hades, BD-Live: taken when the JVM is created (bdlive_bdj.h) */
         if (value > BLURAY_BDJ_NETWORK_INTERNET) {
