+    uint32_t             image_cache_kib; /* BLURAY_PLAYER_SETTING_IMAGE_CACHE */
 
     /* TextST */
     uint32_t gc_wakeup_time;  /* stream timestamp of next subtitle */
@@ -2177,7 +2178,7 @@ int bd_open_stream(BLURAY *bd,
         return 0;
