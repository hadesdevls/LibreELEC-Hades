From 45f9549018b32878d46774514bdc2b139a281e97 Mon Sep 17 00:00:00 2001
From: Petri Hintukainen <phintuka@gmail.com>
Date: Thu, 6 Aug 2026 17:42:03 +0300
Subject: [PATCH] clpi_lookup_spn(): protect against negative map index

---
 src/libbluray/bdnav/clpi_parse.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/libbluray/bdnav/clpi_parse.c b/src/libbluray/bdnav/clpi_parse.c
index 8f3ee069..64a9cd13 100644
--- a/src/libbluray/bdnav/clpi_parse.c
+++ b/src/libbluray/bdnav/clpi_parse.c
@@ -549,6 +549,9 @@ done:
         }
         jj = entry->coarse[ii].ref_ep_fine_id;
     }
+    if (jj < 0) {
+        jj = 0;
+    }
     spn = (entry->coarse[ii].spn_ep & ~0x1FFFF) + entry->fine[jj].spn_ep;
     return spn;
 }
