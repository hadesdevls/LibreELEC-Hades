+
+/* Framing of the messages of bdr_protocol.h, for both ends */
+
+#ifndef BDR_WIRE_H_
+#define BDR_WIRE_H_
+
+#include "bdr_protocol.h"
+
+#include "util/attributes.h"
+
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Send one message: the header and up to three parts of payload, in one piece under *lock, so
+ * that messages from several threads never interleave. pass_fd >= 0 goes with SCM_RIGHTS.
+ * Returns 0, or -1 when the connection failed (it is then of no further use).
+ */
+BD_PRIVATE int bdr_send(int fd, pthread_mutex_t *lock, uint16_t type, uint16_t flags, uint32_t id,
+                        const void *p1, size_t l1, const void *p2, size_t l2,
+                        const void *p3, size_t l3, int pass_fd);
+
+/*
+ * Receive one message. *payload is allocated (free()) when hdr->len > 0, NULL otherwise.
+ * A file descriptor that comes with it is stored in *recv_fd if recv_fd is not NULL (-1 if
+ * none); with recv_fd NULL, any descriptor is closed and the message is refused.
+ * Returns 0, 1 at the end of the connection, -1 on an error or a message the framing does not
+ * allow (bad magic, payload larger than BDR_MAX_PAYLOAD).
+ */
+BD_PRIVATE int bdr_recv(int fd, BDR_HDR *hdr, uint8_t **payload, int *recv_fd);
+
+#endif /* BDR_WIRE_H_ */
