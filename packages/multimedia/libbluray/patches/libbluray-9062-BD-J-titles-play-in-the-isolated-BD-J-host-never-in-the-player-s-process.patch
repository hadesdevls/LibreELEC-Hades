+#ifdef HAVE_BDJ_REMOTE
+/*
+ * (LibreELEC Hades) Hand a disc with BD-J titles over to the isolated BD-J host, once, when the
+ * player starts it with its menus. 1 if this BLURAY now plays there.
+ */
+static int _bdr_hand_over(BLURAY *bd)
+{
+    BDR_START start;
+    BDR_CLIENT *client;
+
+    if (bd->remote || bd->bdj_remote_mode != BLURAY_BDJ_REMOTE_AUTO || !bd->disc ||
+        !bd->disc_info.bdj_detected || !bd->disc_info.bdj_handled) {
+        return 0;
+    }
+
+    memset(&start, 0, sizeof(start));
+    start.disc        = bd->disc;
+    start.rec         = &bd->bdr_rec;
+    start.debug_mask  = bd_get_debug_mask();
+    start.ov_handle   = bd->ov_proc_handle;
+    start.ov_proc     = bd->ov_proc;
+    bd_mutex_lock(&bd->argb_buffer_mutex);
+    start.argb_handle = bd->argb_overlay_proc_handle;
+    start.argb_proc   = bd->argb_overlay_proc;
+    start.argb_buf    = bd->argb_buffer;
+    bd_mutex_unlock(&bd->argb_buffer_mutex);
+
+    client = bdr_client_start(&start);
+    if (!client) {
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "The isolated BD-J host could not start this disc: its Java titles do not run\n");
+        return 0;
+    }
+
+    bd_mutex_lock(&bd->mutex);
+    bd->remote = client;
+    bd_mutex_unlock(&bd->mutex);
+    return 1;
+}
+#endif
