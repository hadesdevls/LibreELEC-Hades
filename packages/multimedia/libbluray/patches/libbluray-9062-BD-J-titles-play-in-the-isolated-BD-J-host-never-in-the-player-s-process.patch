+/*
+ * (LibreELEC Hades) Once a BLURAY plays in the isolated BD-J host, its calls go there.
+ */
+#ifdef HAVE_BDJ_REMOTE
+#define BDR_FORWARD(bd, call)       do { if ((bd) && (bd)->remote) { return call; } } while (0)
