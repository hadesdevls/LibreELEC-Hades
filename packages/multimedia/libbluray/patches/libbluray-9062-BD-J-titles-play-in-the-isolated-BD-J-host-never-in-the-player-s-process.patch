+int bd_set_player_setting(BLURAY *bd, uint32_t idx, uint32_t value)
+{
+    if (idx == BLURAY_PLAYER_SETTING_BDJ_REMOTE) {
+        /* where BD-J runs is known before the disc is opened (its disc info says it) */
+        if (value > BLURAY_BDJ_REMOTE_NEVER || bd->disc) {
+            return 0;
+        }
+        bd->bdj_remote_mode = (uint8_t)value;
+        return 1;
+    }
+
+    BDR_FORWARD(bd, bdr_set_player_setting(bd->remote, idx, value));
+#ifdef HAVE_BDJ_REMOTE
+    bdr_record_setting(&bd->bdr_rec, bd->disc != NULL, idx, value, NULL);
+#endif
+
+    return _set_player_setting(bd, idx, value);
