From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:05:01 +0000
Subject: [PATCH] BD-J: compose the HAVi background image with straight alpha

The background plane is filled with the configuration colour and then the
still image is drawn over it. The pixels of both have straight (not
premultiplied) alpha, as the ARGB overlay that carries the plane to the
player, but the blend weighed the colour fill by (255 - a) only: a
translucent pixel of the image over a transparent fill (a configuration
that sets no colour and an image with soft edges) came out darkened by the
fill's black, and the output alpha was not the one the colours were
weighed for. Weigh the fill by its own alpha as well and divide by the
output alpha, rounding. Over an opaque fill the result is the same as
before (within one code of rounding).
---
 .../bdj/java/org/havi/ui/BackgroundPlane.java  | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/src/libbluray/bdj/java/org/havi/ui/BackgroundPlane.java b/src/libbluray/bdj/java/org/havi/ui/BackgroundPlane.java
index c3d9bae..9ca3f32 100644
--- a/src/libbluray/bdj/java/org/havi/ui/BackgroundPlane.java
+++ b/src/libbluray/bdj/java/org/havi/ui/BackgroundPlane.java
@@ -216,14 +216,18 @@ final class BackgroundPlane {
                 if (a == 0xff) {
                     pixels[drow + x] = p;
                 } else if (a != 0) {
-                    /* image over the colour fill */
-                    int d = pixels[drow + x];
-                    int ia = 255 - a;
+                    /* image over the colour fill, both with straight (not
+                     * premultiplied) alpha, as the ARGB overlay is: the fill
+                     * weighs by its own alpha too, so a translucent pixel of
+                     * the image over a transparent fill keeps its colour */
+                    int d  = pixels[drow + x];
                     int da = d >>> 24;
-                    int oa = a + (da * ia) / 255;
-                    int r = (((p >> 16) & 0xff) * a + ((d >> 16) & 0xff) * ia) / 255;
-                    int g = (((p >>  8) & 0xff) * a + ((d >>  8) & 0xff) * ia) / 255;
-                    int b = (( p        & 0xff) * a + ( d        & 0xff) * ia) / 255;
+                    int fw = da * (255 - a);        /* fill weight, x255 */
+                    int ow = a * 255 + fw;          /* output alpha, x255; > 0 */
+                    int r = ((((p >> 16) & 0xff) * a * 255) + ((d >> 16) & 0xff) * fw + ow / 2) / ow;
+                    int g = ((((p >>  8) & 0xff) * a * 255) + ((d >>  8) & 0xff) * fw + ow / 2) / ow;
+                    int b = ((( p        & 0xff) * a * 255) + ( d        & 0xff) * fw + ow / 2) / ow;
+                    int oa = (ow + 127) / 255;
                     pixels[drow + x] = (oa << 24) | (r << 16) | (g << 8) | b;
                 }
             }
