+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef _BDJ_SANDBOX_H_
+#define _BDJ_SANDBOX_H_
+
+#include "util/attributes.h"
+
+#include <stddef.h>
+
+/*
+ * The Java code of a disc (BD-J) runs only in a process that the system isolates: the service
+ * hades-bdj@.service, whose server applies a seccomp filter of its own before it opens anything
+ * of the disc (src/tools/hades_bdj_sandbox.c). A player's own process (Kodi runs as root) never
+ * creates a JVM.
+ *
+ * Isolated means, read from the kernel by this process itself:
+ *   - real, effective, saved and file system user and group ids are not 0, and there is no
+ *     supplementary group other than the process's own group;
+ *   - no capability: permitted, effective, ambient and bounding sets are empty;
+ *   - no_new_privs is set, and a seccomp filter is in force (Seccomp: 2);
+ *   - no network interface but loopback in the network namespace of the process, unless the
+ *     service runs with BD-Live (HADES_BDJ_NETWORK=internet in its environment), where the
+ *     system limits the addresses instead.
+ * Anything that cannot be read counts as not isolated.
+ */
+
+/* the environment variable the BD-Live variant of the service sets, and its value */
+#define HADES_BDJ_NETWORK_ENV      "HADES_BDJ_NETWORK"
+#define HADES_BDJ_NETWORK_INTERNET "internet"
+
+/*
+ * 1 when this process is isolated as said above; else 0, with the first check that failed
+ * written to why (if not NULL). No logging and no other part of libbluray: the server
+ * (src/tools/hades_bdj_host.c) builds this file into itself too, with
+ * -DHADES_BDJ_SANDBOX_STANDALONE.
+ */
+BD_PRIVATE int bdj_sandbox_check(char *why, size_t why_size);
+
+#ifndef HADES_BDJ_SANDBOX_STANDALONE
+/* bdj_sandbox_check(), and the reason in the log when it is 0 */
+BD_PRIVATE int bdj_process_is_sandboxed(void);
+#endif
+
+#endif /* _BDJ_SANDBOX_H_ */
