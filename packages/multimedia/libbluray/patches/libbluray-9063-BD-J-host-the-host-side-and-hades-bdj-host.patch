+/*
+ * hades-bdj-host: the isolated BD-J host of LibreELEC Hades. One process per disc, started by
+ * systemd for one connection of a player (hades-bdj.socket, Accept=yes: the connection is file
+ * descriptor 3 with LISTEN_FDS=1, or standard input with StandardInput=socket). It isolates
+ * itself before it reads anything of the connection, then plays the disc's BD-J titles for that
+ * player (bd_bdj_host_run()) and ends.
+ *
+ *   hades-bdj-host [--fd N] [--java-home DIR] [--persistent-root DIR] [--cache-root DIR]
+ *
+ * Builds for tests (-Dhades_bdj_test=true, never in an image) also take --no-sandbox.
+ */
+
+#include "libbluray/bluray.h"
+
+#include "hades_bdj_sandbox.h"
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+
+#define DEFAULT_JAVA_HOME       "/usr/lib/hades-bdj/jre"
+#define DEFAULT_PERSISTENT_ROOT "/var/lib/hades-bdj/persistent"
+#define DEFAULT_CACHE_ROOT      "/tmp/hades-bdj-cache"
+
+static int _usage(const char *argv0)
+{
+    fprintf(stderr, "usage: %s [--fd N] [--java-home DIR] [--persistent-root DIR] [--cache-root DIR]\n",
+            argv0);
+    return 2;
+}
+
+/* the socket systemd passed (sd_listen_fds() for one descriptor), or -1 */
+static int _listen_fd(void)
+{
+    const char *pid = getenv("LISTEN_PID");
+    const char *fds = getenv("LISTEN_FDS");
+
+    if (!pid || !fds || atol(pid) != (long)getpid() || strcmp(fds, "1")) {
+        return -1;
+    }
+    unsetenv("LISTEN_PID");
+    unsetenv("LISTEN_FDS");
+    unsetenv("LISTEN_FDNAMES");
+    return 3;
+}
+
+static int _same_file(int a, int b)
+{
+    struct stat sa, sb;
+    return fstat(a, &sa) == 0 && fstat(b, &sb) == 0 && sa.st_dev == sb.st_dev && sa.st_ino == sb.st_ino;
+}
+
+/*
+ * The connection on a descriptor of its own, above the standard ones, and none of those on it:
+ * the JVM and libbluray write to standard output and error, and nothing they write may reach the
+ * connection (with StandardInput=socket, or a socket-activate --inetd, standard input and output
+ * are the socket). Returns the new descriptor, or -1.
+ */
+static int _detach_stdio(int fd)
+{
+    int nfd = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+    int null = open("/dev/null", O_RDWR | O_CLOEXEC);
+    int i;
+
+    if (nfd < 0 || null < 0) {
+        return -1;
+    }
+    for (i = 0; i <= 2; i++) {
+        if (_same_file(i, nfd) && dup2(null, i) < 0) {
+            return -1;
+        }
+    }
+    if (fd > 2) {
+        close(fd);
+    }
+    close(null);
+    return nfd;
+}
+
+static int _is_stream_socket(int fd)
+{
+    struct stat st;
+    int type = 0;
+    socklen_t len = sizeof(type);
+
+    return fstat(fd, &st) == 0 && S_ISSOCK(st.st_mode) &&
+           getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &len) == 0 && type == SOCK_STREAM;
+}
+
+int main(int argc, char **argv)
+{
+    BD_BDJ_HOST_CONFIG cfg;
+    struct stat st;
+    int fd = -1, sandbox = 1, i, rc;
+
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.java_home       = DEFAULT_JAVA_HOME;
+    cfg.persistent_root = DEFAULT_PERSISTENT_ROOT;
+    cfg.cache_root      = DEFAULT_CACHE_ROOT;
+
+    for (i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--fd") && i + 1 < argc) {
+            fd = atoi(argv[++i]);
+        } else if (!strcmp(argv[i], "--java-home") && i + 1 < argc) {
+            cfg.java_home = argv[++i];
+        } else if (!strcmp(argv[i], "--persistent-root") && i + 1 < argc) {
+            cfg.persistent_root = argv[++i];
+        } else if (!strcmp(argv[i], "--cache-root") && i + 1 < argc) {
+            cfg.cache_root = argv[++i];
+#ifdef HADES_BDJ_TEST
+        } else if (!strcmp(argv[i], "--no-sandbox")) {
+            sandbox = 0;
+#endif
+        } else {
+            return _usage(argv[0]);
+        }
+    }
+
+    if (fd < 0) {
+        fd = _listen_fd();
+    }
+    if (fd < 0 && _is_stream_socket(0)) {
+        /* StandardInput=socket: the connection is standard input */
+        fd = 0;
+    }
+    if (fd < 0 || !_is_stream_socket(fd)) {
+        fprintf(stderr, "hades-bdj-host: no connection (fd %d)\n", fd);
+        return 2;
+    }
+    fd = _detach_stdio(fd);
+    if (fd < 0) {
+        fprintf(stderr, "hades-bdj-host: could not set the connection apart\n");
+        return 2;
+    }
+
+    /* isolated before anything of the player or of the disc is read */
+    if (sandbox && hades_bdj_sandbox_enter() != 0) {
+        fprintf(stderr, "hades-bdj-host: could not isolate itself: BD-J does not run\n");
+        return 3;
+    }
+
+    /* without a writable persistent storage, the disc gets none */
+    if (cfg.persistent_root && (stat(cfg.persistent_root, &st) != 0 || !S_ISDIR(st.st_mode) ||
+                                access(cfg.persistent_root, W_OK) != 0)) {
+        cfg.persistent_root = NULL;
+    }
+
+    rc = bd_bdj_host_run(fd, &cfg);
+
+    /* the JVM's threads are not waited for: the process ends with the disc */
+    _exit(rc);
+}
