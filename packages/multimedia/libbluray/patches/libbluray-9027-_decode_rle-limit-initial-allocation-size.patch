From 70ba7d4bf7262a7e7fb20f428d17a287e532f62e Mon Sep 17 00:00:00 2001
From: Petri Hintukainen <phintuka@gmail.com>
Date: Thu, 6 Aug 2026 18:03:53 +0300
Subject: [PATCH] _decode_rle(): limit initial allocation size

---
 src/libbluray/decoders/pg_decode.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/libbluray/decoders/pg_decode.c b/src/libbluray/decoders/pg_decode.c
index 10684497..03b0b0d6 100644
--- a/src/libbluray/decoders/pg_decode.c
+++ b/src/libbluray/decoders/pg_decode.c
@@ -130,6 +130,9 @@ static int _decode_rle(BITBUFFER *bb, BD_PG_OBJECT *p)
     if (rle_size < 1)
         rle_size = 1;
 
+    if (rle_size > 65536)
+        rle_size = 65536;
+
     tmp = refcnt_realloc(p->img, rle_size * sizeof(BD_PG_RLE_ELEM), NULL);
     if (!tmp) {
         BD_DEBUG(DBG_DECODE | DBG_CRIT, "pg_decode_object(): realloc failed\n");
