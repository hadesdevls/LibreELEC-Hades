From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:03:50 +0000
Subject: [PATCH] BLURAY_PLAYER_SETTING_VIDEO_PREROLL: the primary video from
 the random-access picture before IN

The filter wipes the primary video of a play item up to its first PES
packet presented at or after the IN time. Where IN is not the time of a
random-access picture, that wipes the picture (and the ones after it in
decoding order presented before IN) that the pictures after IN are
predicted from: they cannot be decoded, and the video of the play item
begins only at its next random-access picture, up to a second later.
The Dolby Vision enhancement layer (PID 0x1015) is not filtered at all,
so its random-access picture came without its base picture, and a
player that pairs the layers dropped it too.

With the new setting (LibreELEC Hades, 0x1102, off by default, for the
clips opened from then on) the primary video passes from the
random-access picture at or before IN: the entry point of the clip's
EP map that a play item that is not joined seamlessly is read from
(the first play item is read from the first packet of its clip, and
its video before that entry point is still wiped). The application
decodes the pictures before IN and presents none of them. Nothing
changes for a seamless join (read from the first packet of its clip,
which begins at IN), a clip without an EP map, an IN more than 10 s
after its entry point (VIDEO_PREROLL_MAX), audio, subtitles and menus.
It goes to the isolated BD-J host as the other settings do
(bdr_record_setting(), _setting_allowed()).

Decoding the pictures before IN is the idea of CroqueMr's patch
(libreelec-x86-DV, 0002-navigation-read-boundary, for the clips of
Dolby Vision); written anew, for every primary video.
---
 src/libbluray/bluray.c               | 54 +++++++++++++++++++++++++++-
 src/libbluray/bluray.h               |  4 +++
 src/libbluray/decoders/m2ts_filter.c | 13 +++++--
 src/libbluray/decoders/m2ts_filter.h |  9 ++++-
 4 files changed, 76 insertions(+), 4 deletions(-)

diff --git a/src/libbluray/bluray.c b/src/libbluray/bluray.c
index 817430b..938be06 100644
--- a/src/libbluray/bluray.c
+++ b/src/libbluray/bluray.c
@@ -36,6 +36,8 @@
 #include "util/strutl.h"
 #include "util/mutex.h"
 #include "bdnav/bdid_parse.h"
+#include "bdnav/clpi_data.h"
+#include "bdnav/clpi_parse.h"
 #include "bdnav/navigation.h"
 #include "bdnav/index_parse.h"
 #include "bdnav/meta_parse.h"
@@ -210,6 +212,7 @@ struct bluray {
     BD_UO_MASK           gc_uo_mask;      /* UO mask from current menu page */
     uint32_t             gc_status;
     uint8_t              decode_pg;
+    uint8_t              video_preroll;  /* BLURAY_PLAYER_SETTING_VIDEO_PREROLL */
 
     /* TextST */
     uint32_t gc_wakeup_time;  /* stream timestamp of next subtitle */
@@ -741,6 +744,43 @@ static void _close_m2ts(BD_STREAM *st)
     m2ts_filter_close(&st->m2ts_filter);
 }
 
+/*
+ * BLURAY_PLAYER_SETTING_VIDEO_PREROLL. The filter wipes the primary video before the IN time of a
+ * play item up to its first PES packet presented at or after IN. Where IN is not the time of a
+ * random-access picture, that wipes the picture that the pictures after IN are predicted from, and
+ * the video can be decoded only from the next random-access picture on: up to a second of the play
+ * item without its picture. With the setting the primary video passes from the random-access
+ * picture at or before IN (the entry point of the clip's EP map, which a play item that is not
+ * joined seamlessly is read from, or after which the clip of the first play item, read from its
+ * first packet, is wiped), for an application that decodes the pictures before IN and presents none
+ * of them. Not for a seamless join (read from the first packet of its clip), nor without an EP map,
+ * nor for more than VIDEO_PREROLL_MAX.
+ * Returns the time (90 kHz) from which the primary video passes, or -1 for IN.
+ */
+
+#define VIDEO_PREROLL_MAX (10 * 45000) /* 45 kHz */
+
+static int64_t _video_preroll_from(BLURAY *bd, const NAV_CLIP *clip)
+{
+    uint32_t spn, ep_time = 0;
+
+    if (!bd->video_preroll || !clip->cl || clip->connection != CONNECT_NON_SEAMLESS ||
+        clip->cl->cpi.num_stream_pid < 1 || !clip->cl->cpi.entry) {
+        return -1;
+    }
+
+    spn = clpi_lookup_spn(clip->cl, clip->in_time, 1,
+                          clip->title->pl->play_item[clip->ref].clip[clip->angle].stc_id);
+    clpi_access_point(clip->cl, spn, 0, 0, &ep_time);
+    if (ep_time >= clip->in_time || clip->in_time - ep_time > VIDEO_PREROLL_MAX) {
+        return -1;
+    }
+
+    BD_DEBUG(DBG_BLURAY, "clip %s: primary video from %u, before IN %u (video preroll)\n",
+             clip->name, ep_time, clip->in_time);
+    return (int64_t)ep_time << 1;
+}
+
 static int _open_m2ts(BLURAY *bd, BD_STREAM *st)
 {
     _close_m2ts(st);
@@ -782,7 +822,8 @@ static int _open_m2ts(BLURAY *bd, BD_STREAM *st)
                 st->m2ts_filter = m2ts_filter_init((int64_t)st->clip->in_time << 1,
                                                    (int64_t)st->clip->out_time << 1,
                                                    stn->num_video, stn->num_audio,
-                                                   stn->num_ig, stn->num_pg);
+                                                   stn->num_ig, stn->num_pg,
+                                                   _video_preroll_from(bd, st->clip));
 
                 _update_clip_psrs(bd, st->clip);
 
@@ -3627,6 +3668,17 @@ static int _set_player_setting(BLURAY *bd, uint32_t idx, uint32_t value)
         return 1;
     }
 
+    if (idx == BLURAY_PLAYER_SETTING_VIDEO_PREROLL) {
+        /* taken by every clip opened from now on (_video_preroll_from()) */
+        if (value > 1) {
+            return 0;
+        }
+        bd_mutex_lock(&bd->mutex);
+        bd->video_preroll = (uint8_t)value;
+        bd_mutex_unlock(&bd->mutex);
+        return 1;
+    }
+
     if (idx == BLURAY_PLAYER_SETTING_BDJ_NETWORK) {
         /* Hades, BD-Live: taken when the JVM is created (bdlive_bdj.h) */
         if (value > BLURAY_BDJ_NETWORK_INTERNET) {
diff --git a/src/libbluray/bluray.h b/src/libbluray/bluray.h
index 812f6e2..19763eb 100644
--- a/src/libbluray/bluray.h
+++ b/src/libbluray/bluray.h
@@ -776,6 +776,7 @@ typedef enum {
 
     BLURAY_PLAYER_SETTING_BDJ_NETWORK          = 0x1100, /**< (LibreELEC Hades) BD-Live: network for the Java code of a disc. bd_player_setting_bdj_network value. Default: BLURAY_BDJ_NETWORK_NONE. */
     BLURAY_PLAYER_SETTING_BDJ_REMOTE           = 0x1101, /**< (LibreELEC Hades) Where BD-J titles run. bd_player_setting_bdj_remote value, before the disc is opened. Default: BLURAY_BDJ_REMOTE_AUTO. */
+    BLURAY_PLAYER_SETTING_VIDEO_PREROLL        = 0x1102, /**< (LibreELEC Hades) The primary video of a play item that is not joined seamlessly comes from the random-access picture at or before its IN time, not from IN: the application decodes the pictures before IN and presents none of them. Integer, 0 or 1, for the clips opened from then on. Default: 0. */
 
     BLURAY_PLAYER_PERSISTENT_ROOT              = 0x200, /**< Root path to the BD_J persistent storage location. String. */
     BLURAY_PLAYER_CACHE_ROOT                   = 0x201, /**< Root path to the BD_J cache storage location. String. */
@@ -798,6 +799,9 @@ typedef enum {
 
 #define BD_HAVE_BDJ_NETWORK_SETTING 1
 
+/** (LibreELEC Hades) BLURAY_PLAYER_SETTING_VIDEO_PREROLL is there */
+#define BD_HAVE_VIDEO_PREROLL 1
+
 /**
  *
  *  Update player setting
diff --git a/src/libbluray/decoders/m2ts_filter.c b/src/libbluray/decoders/m2ts_filter.c
index c678302..bad02e2 100644
--- a/src/libbluray/decoders/m2ts_filter.c
+++ b/src/libbluray/decoders/m2ts_filter.c
@@ -50,6 +50,8 @@ struct m2ts_filter_s
 
     int64_t  in_pts;
     int64_t  out_pts;
+    int64_t  video_in_pts; /* the primary video passes from here: in_pts, or before it (m2ts_filter_init()) */
+    unsigned num_video;
     uint32_t pat_packets; /* how many packets to search for PAT (seeked pat_packets packets before the actual seek point) */
     uint8_t  pat_seen;
 
@@ -59,7 +61,8 @@ struct m2ts_filter_s
 
 M2TS_FILTER *m2ts_filter_init(int64_t in_pts, int64_t out_pts,
                               unsigned num_video, unsigned num_audio,
-                              unsigned num_ig, unsigned num_pg)
+                              unsigned num_ig, unsigned num_pg,
+                              int64_t video_in_pts)
 {
     M2TS_FILTER *p = calloc(1, sizeof(*p));
 
@@ -69,6 +72,8 @@ M2TS_FILTER *m2ts_filter_init(int64_t in_pts, int64_t out_pts,
 
         p->in_pts   = in_pts;
         p->out_pts  = out_pts;
+        p->video_in_pts = (video_in_pts >= 0 && video_in_pts < in_pts) ? video_in_pts : in_pts;
+        p->num_video = num_video;
         p->last_pcr = -1;
         p->wipe_pid = calloc(num_audio + num_video + num_ig + num_pg + 1, sizeof(uint16_t));
         p->pass_pid = calloc(num_audio + num_video + num_ig + num_pg + 1, sizeof(uint16_t));
@@ -201,6 +206,9 @@ void m2ts_filter_seek(M2TS_FILTER *p, uint32_t pat_packets, int64_t in_pts)
     }
 
     p->in_pts   = in_pts;
+    if (p->video_in_pts > in_pts) {
+        p->video_in_pts = in_pts;
+    }
     p->pat_seen = 0;
     p->pat_packets = pat_packets;
     p->last_pcr = -1;
@@ -263,7 +271,8 @@ static int _filter_es_pts(M2TS_FILTER *p, const uint8_t *buf, uint16_t pid)
     if (_pid_in_list(p->wipe_pid, pid)) {
 
         int64_t pts = _es_timestamp(buf + 4 + payload_offset, 188 - payload_offset);
-        if (pts >= p->in_pts && (p->out_pts < 0 || pts <= p->out_pts)) {
+        int64_t from = (pid >= HDMV_PID_VIDEO && pid < HDMV_PID_VIDEO + p->num_video) ? p->video_in_pts : p->in_pts;
+        if (pts >= from && (p->out_pts < 0 || pts <= p->out_pts)) {
             M2TS_TRACE("Pid 0x%04x pts %" PRId64 " passed IN timestamp %" PRId64 " (pts %" PRId64 ")\n",
                        pid, pts, p->in_pts, pts);
             _remove_pid(p->wipe_pid, pid);
diff --git a/src/libbluray/decoders/m2ts_filter.h b/src/libbluray/decoders/m2ts_filter.h
index d84e352..43e40ca 100644
--- a/src/libbluray/decoders/m2ts_filter.h
+++ b/src/libbluray/decoders/m2ts_filter.h
@@ -31,9 +31,16 @@
 
 typedef struct m2ts_filter_s M2TS_FILTER;
 
+/*
+ * video_in_pts: the primary video (the first num_video PIDs from HDMV_PID_VIDEO) passes from its
+ * first PES packet presented at or after this time instead of in_pts; -1 (or a time not before
+ * in_pts) for in_pts. The pictures from there to in_pts are for the decoder only: the application
+ * that asks for them (BLURAY_PLAYER_SETTING_VIDEO_PREROLL) presents none of them.
+ */
 BD_PRIVATE M2TS_FILTER *m2ts_filter_init(int64_t in_pts, int64_t out_pts,
                                          unsigned num_video, unsigned num_audio,
-                                         unsigned num_ig, unsigned num_pg);
+                                         unsigned num_ig, unsigned num_pg,
+                                         int64_t video_in_pts);
 BD_PRIVATE void         m2ts_filter_close(M2TS_FILTER **);
 
