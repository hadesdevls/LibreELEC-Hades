From 166ffc08dae319c22eab834d144a9972fcd666f9 Mon Sep 17 00:00:00 2001
From: Petri Hintukainen <phintuka@gmail.com>
Date: Thu, 6 Aug 2026 15:24:23 +0300
Subject: [PATCH] bits: check bs_read() bits count

Return value is uint32_t
---
 src/util/bits.c  | 14 +++++++++++++-
 src/util/macro.h |  7 +++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/util/bits.c b/src/util/bits.c
index 670ef98a..ea3869d0 100644
--- a/src/util/bits.c
+++ b/src/util/bits.c
@@ -28,6 +28,7 @@
 
 #include "file/file.h"
 #include "util/logging.h"
+#include "util/macro.h"
 
 #include <stdio.h>  // SEEK_*
 
@@ -184,6 +185,11 @@ uint32_t bb_read( BITBUFFER *bb, int i_count )
     int      i_shr;
     uint32_t i_result = 0;
 
+    if (i_count > 32) {
+        BD_ASSERT(i_count <= 32);
+        i_count = 32;
+    }
+
     while( i_count > 0 ) {
 
         if( bb->p >= bb->p_end ) {
@@ -215,7 +221,13 @@ uint32_t bb_read( BITBUFFER *bb, int i_count )
 uint32_t bs_read( BITSTREAM *bs, int i_count )
 {
     int left;
-    int bytes = (i_count + 7) >> 3;
+    int bytes;
+
+    if (i_count > 32) {
+        BD_ASSERT(i_count <= 32);
+        i_count = 32;
+    }
+    bytes = (i_count + 7) >> 3;
 
     if (bs->bb.p + bytes >= bs->bb.p_end) {
         bs->pos = bs->pos + (bs->bb.p - bs->bb.p_start);
diff --git a/src/util/macro.h b/src/util/macro.h
index 9b8595a9..53e30435 100644
--- a/src/util/macro.h
+++ b/src/util/macro.h
@@ -33,6 +33,13 @@
 
 #define BD_MAX_SSIZE ((int64_t)(((size_t)-1)>>1))
 
+#define BD_ASSERT(p)                                      \
+  do {                                                    \
+    if (!(p)) {                                           \
+      BD_DEBUG(DBG_CRIT, "assertion failed: '%s'\n", #p); \
+    }                                                     \
+  } while (0)
+
 /*
  * automatic cast from void* (malloc/calloc/realloc)
  */
