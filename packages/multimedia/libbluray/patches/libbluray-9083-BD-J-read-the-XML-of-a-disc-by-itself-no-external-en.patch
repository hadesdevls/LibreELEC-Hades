+package org.videolan;
+
+import java.io.StringReader;
+
+import javax.xml.parsers.ParserConfigurationException;
+import javax.xml.parsers.SAXParser;
+import javax.xml.parsers.SAXParserFactory;
+
+import org.xml.sax.InputSource;
+import org.xml.sax.SAXException;
+import org.xml.sax.ext.DeclHandler;
+
+/*
+ * The XML files of a disc that libbluray reads (the manifest of a disc update, BUMFParser; the font
+ * index of AUXDATA, FontIndex) are read by themselves. Nothing they name outside the file is read:
+ * no external DTD and no external entity, general or parameter (XXE: from the network, or a file
+ * of the system), no XInclude; the parser's limits on entity expansion are on (secure processing:
+ * a "billion laughs" ends at once). A file that declares an external entity, or refers to one that
+ * the parser did not read, is not read at all.
+ *
+ * The DTD such a file may name (the DVB-MHP font directory) is not needed to read it: the parser
+ * does not validate. Any entity or DTD the parser still asks for is an empty document, never the
+ * network or a file.
+ *
+ * A parser that does not know one of these settings is not used (the exception goes to the
+ * caller, which reads nothing).
+ */
+final class SafeXML {
+
+    /* the features, and their values */
+    static final String[][] FEATURES = {
+        { "http://javax.xml.XMLConstants/feature/secure-processing", "true" },
+        { "http://xml.org/sax/features/external-general-entities", "false" },
+        { "http://xml.org/sax/features/external-parameter-entities", "false" },
+        { "http://apache.org/xml/features/nonvalidating/load-external-dtd", "false" },
+        { "http://xml.org/sax/features/validation", "false" },
+    };
+
+    /* the protocols through which an external DTD or schema may be read: none */
+    static final String[] NO_ACCESS = {
+        "http://javax.xml.XMLConstants/property/accessExternalDTD",
+        "http://javax.xml.XMLConstants/property/accessExternalSchema",
+    };
+
+    private SafeXML() {
+    }
+
+    static SAXParserFactory newFactory() throws ParserConfigurationException, SAXException {
+        SAXParserFactory factory = SAXParserFactory.newInstance();
+        factory.setValidating(false);
+        factory.setXIncludeAware(false);
+        for (int i = 0; i < FEATURES.length; i++) {
+            factory.setFeature(FEATURES[i][0], "true".equals(FEATURES[i][1]));
+        }
+        return factory;
+    }
+
+    /* a declaration of an external entity, general or parameter, ends the parsing: the parser would
+       not read it, and a file of a disc that declares one is not read either (a reference to an
+       external parameter entity, skipped, would not end it otherwise) */
+    static final String DECLARATION_HANDLER = "http://xml.org/sax/properties/declaration-handler";
+    private static final DeclHandler NO_EXTERNAL_ENTITY = new DeclHandler() {
+        public void elementDecl(String name, String model) {
+        }
+        public void attributeDecl(String eName, String aName, String type, String mode, String value) {
+        }
+        public void internalEntityDecl(String name, String value) {
+        }
+        public void externalEntityDecl(String name, String publicId, String systemId) throws SAXException {
+            throw new SAXException("external entity " + name + " declared: nothing outside the file is read");
+        }
+    };
+
+    static SAXParser newParser() throws ParserConfigurationException, SAXException {
+        SAXParser parser = newFactory().newSAXParser();
+        for (int i = 0; i < NO_ACCESS.length; i++) {
+            parser.setProperty(NO_ACCESS[i], "");
+        }
+        parser.setProperty(DECLARATION_HANDLER, NO_EXTERNAL_ENTITY);
+        return parser;
+    }
+
+    /* EntityResolver: whatever is asked for, an empty document */
+    static InputSource noEntity(String publicId, String systemId) {
+        return new InputSource(new StringReader(""));
+    }
+
+    /* ContentHandler.skippedEntity(): an entity that was not read ends the parsing; the external DTD
+       subset ("[dtd]"), not read either, is not needed by a parser that does not validate */
+    static void skipped(String name) throws SAXException {
+        if (!"[dtd]".equals(name)) {
+            throw new SAXException("entity " + name + " not read: nothing outside the file is read");
+        }
+    }
+}
