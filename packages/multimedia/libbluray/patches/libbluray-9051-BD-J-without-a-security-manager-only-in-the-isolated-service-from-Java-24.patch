diff --git a/src/libbluray/bdj/java-j2se/java/io/BDFileSystemImpl.java b/src/libbluray/bdj/java-j2se/java/io/BDFileSystemImpl.java
index a814d98..5e055b3 100644
--- a/src/libbluray/bdj/java-j2se/java/io/BDFileSystemImpl.java
+++ b/src/libbluray/bdj/java-j2se/java/io/BDFileSystemImpl.java
@@ -26,6 +26,7 @@ class BDFileSystemImpl extends BDFileSystem {
 
     /* different in ME */
     public boolean checkAccess(File f, int access) {
+        accessFile(f); /* Hades: see BDFileSystem.accessFile() */
         return fs.checkAccess(f, access);
     }
 
diff --git a/src/libbluray/bdj/java-j2se/java/io/FileInputStream.java b/src/libbluray/bdj/java-j2se/java/io/FileInputStream.java
index 74d59f4..c02f9a6 100644
--- a/src/libbluray/bdj/java-j2se/java/io/FileInputStream.java
+++ b/src/libbluray/bdj/java-j2se/java/io/FileInputStream.java
@@ -63,6 +63,8 @@ public class FileInputStream extends InputStream
         SecurityManager security = System.getSecurityManager();
         if (security != null) {
             security.checkRead(name);
+        } else if (name != null) {
+            BDFileSystem.accessFile(name); /* Hades: see BDFileSystem.accessFile() */
         }
         if (name == null) {
             throw new NullPointerException();
diff --git a/src/libbluray/bdj/java/java/io/BDFileSystem.java b/src/libbluray/bdj/java/java/io/BDFileSystem.java
index d7e2ac7..0c8e02f 100644
--- a/src/libbluray/bdj/java/java/io/BDFileSystem.java
+++ b/src/libbluray/bdj/java/java/io/BDFileSystem.java
@@ -153,6 +153,23 @@ public abstract class BDFileSystem extends FileSystem {
     private static boolean booted = false;
 
     /* Called by org.videolan.Libbluray.initOnce() */
+    /*
+     * Hades: a file of the disc is cached when its read is checked (files mode); without a
+     * security manager (Java 24 and later, in the isolated BD-J service) there is no check, and
+     * this does it (org.videolan.BDJLoader.accessFileWithoutSecurityManager()).
+     */
+    static void accessFile(String path) {
+        if (booted && System.getSecurityManager() == null) {
+            org.videolan.BDJLoader.accessFileWithoutSecurityManager(path);
+        }
+    }
+
+    static void accessFile(File f) {
+        if (booted && f != null) {
+            accessFile(f.getPath());
+        }
+    }
+
     public static void setBooted() {
         if (!booted) {
             booted = true;
@@ -282,6 +299,8 @@ public abstract class BDFileSystem extends FileSystem {
         if (!booted)
             return fs.getBooleanAttributes(f);
 
+        accessFile(f);
+
         if (f.isAbsolute()) {
             return fs.getBooleanAttributes(f);
         }
@@ -304,6 +323,7 @@ public abstract class BDFileSystem extends FileSystem {
     */
 
     public long getLastModifiedTime(File f) {
+        accessFile(f);
         return fs.getLastModifiedTime(f);
     }
 
@@ -311,6 +331,8 @@ public abstract class BDFileSystem extends FileSystem {
         if (!booted)
             return fs.getLength(f);
 
+        accessFile(f);
+
         if (f.isAbsolute()) {
             return fs.getLength(f);
         }
diff --git a/src/libbluray/bdj/java/org/videolan/BDJLoader.java b/src/libbluray/bdj/java/org/videolan/BDJLoader.java
index 4b9cd25..a8ed7b6 100644
--- a/src/libbluray/bdj/java/org/videolan/BDJLoader.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJLoader.java
@@ -123,6 +123,38 @@ public class BDJLoader {
         }
     }
 
+    /*
+     * Hades: in files mode (the disc is reached through the player's file system: discRoot is
+     * null, and the VFS root is the cache) BDJSecurityManager caches a file of the disc when its
+     * read is checked, before anything opens it. Without a security manager (Java 24 and later,
+     * in the isolated BD-J service) no check happens: java.io.BDFileSystem and
+     * java.io.FileInputStream call this instead, with the path as the check would see it.
+     */
+    public static void accessFileWithoutSecurityManager(String path) {
+        if (path == null || System.getSecurityManager() != null) {
+            return;
+        }
+        VFSCache localCache = vfsCache;
+        if (localCache == null || !localCache.cachesAll()) {
+            /* not files mode: the disc's files are reached as they are */
+            return;
+        }
+        String absPath = path;
+        if (!java.io.BDFileSystem.isAbsolutePath(absPath)) {
+            String home = BDJXletContext.getCurrentXletHome();
+            if (home == null) {
+                return;
+            }
+            absPath = home + absPath;
+        }
+        try {
+            absPath = new java.io.File(absPath).getCanonicalPath();
+        } catch (java.io.IOException e) {
+            return;
+        }
+        localCache.accessFile(absPath);
+    }
+
     public static String getCachedFile(String path) {
         VFSCache localCache = vfsCache;
         if (localCache != null) {
diff --git a/src/libbluray/bdj/java/org/videolan/Libbluray.java b/src/libbluray/bdj/java/org/videolan/Libbluray.java
index 7bca7d7..bd61a3e 100644
--- a/src/libbluray/bdj/java/org/videolan/Libbluray.java
+++ b/src/libbluray/bdj/java/org/videolan/Libbluray.java
@@ -159,6 +159,17 @@ public class Libbluray {
         }
     }
 
+    /*
+     * Hades: a JVM without a security manager is accepted only in the isolated BD-J service (bdj.c
+     * creates a JVM nowhere else, and sets org.videolan.hades.sandboxed there) and only where
+     * Java has none (24 and later, JEP 486). There the system confines the disc's code: its own
+     * user, no capabilities, no network, nothing of the player's files, a seccomp filter.
+     */
+    private static boolean withoutSecurityManager() {
+        return "true".equals(System.getProperty("org.videolan.hades.sandboxed")) &&
+               getJavaMajor() >= 24 && System.getSecurityManager() == null;
+    }
+
     private static boolean initOnce = false;
     private static void initOnce() {
         if (initOnce) {
@@ -391,8 +402,12 @@ public class Libbluray {
         try {
             setSecurityManager(new BDJSecurityManager(discRoot, persistentRoot, budaRoot, getJavaMajor()));
         } catch (Exception ex) {
-            System.err.println("System.setSecurityManager() failed: " + ex);
-            throw new SecurityException("Failed initializing SecurityManager");
+            if (!withoutSecurityManager()) {
+                System.err.println("System.setSecurityManager() failed: " + ex);
+                throw new SecurityException("Failed initializing SecurityManager");
+            }
+            Logger.getLogger("Libbluray").info("Java " + getJavaMajor() + " has no security manager: " +
+                "the code of the disc is confined by the isolated BD-J service");
         }
 
         loadAdapter(System.getProperty("org.videolan.loader.adapter"));
@@ -420,7 +435,9 @@ public class Libbluray {
 
             /* all Xlet contexts (and threads) should be terminated now */
             try {
-                setSecurityManager(null);
+                /* Hades: none to remove without one (Java 24 and later, in the BD-J service) */
+                if (System.getSecurityManager() != null)
+                    setSecurityManager(null);
             } catch (Exception ex) {
                 System.err.println("System.setSecurityManager(null) failed: " + ex);
             }
diff --git a/src/libbluray/bdj/java/org/videolan/VFSCache.java b/src/libbluray/bdj/java/org/videolan/VFSCache.java
index 6cc57cf..7336d25 100644
--- a/src/libbluray/bdj/java/org/videolan/VFSCache.java
+++ b/src/libbluray/bdj/java/org/videolan/VFSCache.java
@@ -369,6 +369,11 @@ class VFSCache {
      * Accessing any file triggers security manager checks.
      * -> we cache the file (on demand) so that it will be accessible by standard Java I/O.
      */
+    /* Hades: files mode, where the VFS root is the cache and files are cached on demand */
+    protected boolean cachesAll() {
+        return cacheAll;
+    }
+
     boolean inAccessFile = false;
     protected void accessFile(String absPath) {
         if (!cacheAll) {
