From ad31fd1f89419e93eb273b04ffb1f308a2deb6c0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kacper=20Michaj=C5=82ow?= <kasper93@gmail.com>
Date: Fri, 20 Nov 2026 11:16:52 +0100
Subject: [PATCH] _decode_rle(): end runs with their line

Only the sum of the runs was checked against the object size, while
rle_crop_object() and applications read the image line by line. A run
that crossed a line end made them read past the end of the image.

Split such runs and store an EOL marker after every line. Images of
conforming objects do not change.
---
 src/libbluray/decoders/pg_decode.c | 45 +++++++++++++++++++++++-------
 1 file changed, 35 insertions(+), 10 deletions(-)

diff --git a/src/libbluray/decoders/pg_decode.c b/src/libbluray/decoders/pg_decode.c
index 03b0b0d..37653b5 100644
--- a/src/libbluray/decoders/pg_decode.c
+++ b/src/libbluray/decoders/pg_decode.c
@@ -120,12 +120,34 @@ int pg_decode_palette(BITBUFFER *bb, BD_PG_PALETTE *p)
     return pg_decode_palette_update(bb, p);
 }
 
+static int _add_rle(BD_PG_OBJECT *p, int *num_rle, int *rle_size, uint16_t len, uint16_t color)
+{
+    BD_PG_RLE_ELEM *tmp;
+
+    p->img[*num_rle].len   = len;
+    p->img[*num_rle].color = color;
+
+    (*num_rle)++;
+    if (*num_rle >= *rle_size) {
+        *rle_size *= 2;
+        tmp = refcnt_realloc(p->img, *rle_size * sizeof(BD_PG_RLE_ELEM), NULL);
+        if (!tmp) {
+            BD_DEBUG(DBG_DECODE | DBG_CRIT, "pg_decode_object(): realloc failed\n");
+            return 0;
+        }
+        p->img = tmp;
+    }
+
+    return 1;
+}
+
 static int _decode_rle(BITBUFFER *bb, BD_PG_OBJECT *p)
 {
     BD_PG_RLE_ELEM *tmp;
     int64_t pixels_left = (int64_t)p->width * p->height;
     int rle_size        = (int)(pixels_left / 4);
     int num_rle     = 0;
+    unsigned x      = 0;
 
     if (rle_size < 1)
         rle_size = 1;
@@ -161,9 +183,6 @@ static int _decode_rle(BITBUFFER *bb, BD_PG_OBJECT *p)
             }
         }
 
-        p->img[num_rle].len   = len;
-        p->img[num_rle].color = color;
-
         pixels_left -= len;
 
         if (pixels_left < 0) {
@@ -171,15 +190,21 @@ static int _decode_rle(BITBUFFER *bb, BD_PG_OBJECT *p)
             return 0;
         }
 
-        num_rle++;
-        if (num_rle >= rle_size) {
-            rle_size *= 2;
-            tmp = refcnt_realloc(p->img, rle_size * sizeof(BD_PG_RLE_ELEM), NULL);
-            if (!tmp) {
-                BD_DEBUG(DBG_DECODE | DBG_CRIT, "pg_decode_object(): realloc failed\n");
+        while (len > 0) {
+            uint32_t run = BD_MIN(len, p->width - x);
+
+            if (!_add_rle(p, &num_rle, &rle_size, run, color)) {
                 return 0;
             }
-            p->img = tmp;
+            len -= run;
+            x   += run;
+
+            if (x == p->width) {
+                if (!_add_rle(p, &num_rle, &rle_size, 0, 0)) {
+                    return 0;
+                }
+                x = 0;
+            }
         }
     }
 
