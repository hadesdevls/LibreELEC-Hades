+#ifndef HADES_BDJ_SANDBOX_H_
+#define HADES_BDJ_SANDBOX_H_
+
+/*
+ * Called by the BD-J server (hades-bdj-host) first thing, before it opens anything of the disc
+ * and before any JVM exists. The service (hades-bdj@.service) has already isolated the process:
+ * its own user, no capabilities, no_new_privs, no network, no /storage, its own /tmp. This adds
+ * what systemd cannot here (LibreELEC builds systemd without seccomp): a seccomp filter, kept by
+ * every thread the JVM starts, that refuses the system calls a disc's code could use to reach
+ * further (other processes, namespaces, mounts, kernel interfaces, new programs, sockets of other
+ * families). Then it checks, from the kernel, that the process is isolated
+ * (src/libbluray/bdj/bdj_sandbox.c).
+ *
+ * The network families are refused unless the environment of the service says BD-Live
+ * (HADES_BDJ_NETWORK=internet), where AF_INET and AF_INET6 are let through and the service limits
+ * the addresses.
+ *
+ * Returns 0 when the filter is in force and the process is isolated; otherwise the reason is
+ * written to stderr (the journal of the service) and the server must exit without opening the
+ * disc.
+ */
+int hades_bdj_sandbox_enter(void);
+
+#endif /* HADES_BDJ_SANDBOX_H_ */
