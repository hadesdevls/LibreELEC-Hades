+
+/*
+ * The seccomp filter of the BD-J server, and the check that follows it (hades_bdj_sandbox.h).
+ *
+ * A list of refusals on top of everything else allowed, not a list of what is allowed: what a JVM
+ * calls changes with the JVM, its garbage collectors and glibc, and a call missing from an allow
+ * list would break the menus somewhere nobody tried. What is refused here is what a disc's code
+ * (Java with no security manager, or a native library it loads) could use to reach beyond the
+ * process: other processes, namespaces and mounts, kernel interfaces with a history of holes,
+ * new programs, sockets of other families. Refused calls fail with EPERM (EAFNOSUPPORT for a
+ * socket family, ENOSYS for clone3, so that glibc falls back to clone, whose flags are checked),
+ * which the JVM handles as any refusal; a call of another architecture (i386, x32) ends the
+ * process.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE /* CLONE_NEW* */
+#endif
+
+#include "hades_bdj_sandbox.h"
+
+#include "libbluray/bdj/bdj_sandbox.h"
+
+#include <errno.h>
+#include <sched.h>
+#include <seccomp.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#ifndef CLONE_NEWTIME
+#define CLONE_NEWTIME 0x00000080
+#endif
+
+/* refused with EPERM, whatever their arguments */
+static const char *const refused[] = {
+    /* other processes */
+    "ptrace", "process_vm_readv", "process_vm_writev", "pidfd_getfd", "kcmp",
+    "process_madvise", "move_pages", "migrate_pages",
+    /* namespaces, mounts and roots */
+    "unshare", "setns", "mount", "umount2", "pivot_root", "chroot", "move_mount", "open_tree",
+    "open_tree_attr", "fsopen", "fsconfig", "fsmount", "fspick", "mount_setattr",
+    /* new programs: the server is the only program of the service */
+    "execve", "execveat",
+    /* kernel interfaces that a confined process does not need */
+    "bpf", "perf_event_open", "userfaultfd", "io_uring_setup", "io_uring_enter",
+    "io_uring_register", "keyctl", "add_key", "request_key", "open_by_handle_at",
+    "name_to_handle_at", "fanotify_init", "lookup_dcookie", "uselib", "sysfs", "_sysctl",
+    "ustat", "vhangup", "syslog", "acct", "quotactl", "quotactl_fd", "nfsservctl",
+    /* the machine itself */
+    "init_module", "finit_module", "delete_module", "kexec_load", "kexec_file_load", "reboot",
+    "swapon", "swapoff", "settimeofday", "clock_settime", "clock_adjtime", "adjtimex", "iopl",
+    "ioperm", "sethostname", "setdomainname",
+};
+
+static const unsigned long namespace_flags[] = {
+    CLONE_NEWNS, CLONE_NEWUTS, CLONE_NEWIPC, CLONE_NEWUSER, CLONE_NEWPID, CLONE_NEWNET,
+    CLONE_NEWCGROUP, CLONE_NEWTIME,
+};
+
+static int _rule(scmp_filter_ctx ctx, uint32_t action, const char *name, unsigned count,
+                 const struct scmp_arg_cmp *cmp)
+{
+    int nr = seccomp_syscall_resolve_name(name);
+    int rc;
+
+    if (nr == __NR_SCMP_ERROR) {
+        /* not a system call this libseccomp knows: nothing to refuse */
+        return 0;
+    }
+    rc = seccomp_rule_add_array(ctx, action, nr, count, cmp);
+    if (rc < 0) {
+        fprintf(stderr, "hades-bdj: seccomp rule for %s failed: %s\n", name, strerror(-rc));
+        return -1;
+    }
+    return 0;
+}
+
+/* socket() and socketpair() of any family but AF_UNIX; with BD-Live, AF_INET and AF_INET6 too */
+static int _socket_rules(scmp_filter_ctx ctx, const char *name, int internet)
+{
+    const uint32_t act = SCMP_ACT_ERRNO(EAFNOSUPPORT);
+    struct scmp_arg_cmp cmp;
+
+    if (!internet) {
+        cmp = SCMP_A0(SCMP_CMP_NE, AF_UNIX);
+        return _rule(ctx, act, name, 1, &cmp);
+    }
+
+    /* AF_UNSPEC (0), the families between AF_UNIX (1) and AF_INET6 (10) but AF_INET (2), and
+       everything above AF_INET6 (netlink, packet, ...) */
+    cmp = SCMP_A0(SCMP_CMP_EQ, AF_UNSPEC);
+    if (_rule(ctx, act, name, 1, &cmp))
+        return -1;
+    for (unsigned long family = 3; family < AF_INET6; family++) {
+        cmp = SCMP_A0(SCMP_CMP_EQ, family);
+        if (_rule(ctx, act, name, 1, &cmp))
+            return -1;
+    }
+    cmp = SCMP_A0(SCMP_CMP_GT, AF_INET6);
+    return _rule(ctx, act, name, 1, &cmp);
+}
+
+static int _filter(int internet)
+{
+    scmp_filter_ctx ctx = seccomp_init(SCMP_ACT_ALLOW);
+    struct scmp_arg_cmp cmp;
+    int rc = -1;
+
+    if (!ctx) {
+        fprintf(stderr, "hades-bdj: seccomp_init() failed\n");
+        return -1;
+    }
+
+    /* i386 and x32 system calls end the process; every thread of the process gets the filter */
+    if (seccomp_attr_set(ctx, SCMP_FLTATR_ACT_BADARCH, SCMP_ACT_KILL_PROCESS) < 0 ||
+        seccomp_attr_set(ctx, SCMP_FLTATR_CTL_TSYNC, 1) < 0 ||
+        seccomp_attr_set(ctx, SCMP_FLTATR_CTL_NNP, 1) < 0) {
+        fprintf(stderr, "hades-bdj: seccomp attributes failed\n");
+        goto out;
+    }
+
+    for (size_t i = 0; i < sizeof(refused) / sizeof(refused[0]); i++) {
+        if (_rule(ctx, SCMP_ACT_ERRNO(EPERM), refused[i], 0, NULL))
+            goto out;
+    }
+
+    /* clone() with a namespace flag; clone3() takes its flags in memory a filter cannot read:
+       ENOSYS, and glibc and the JVM use clone() */
+    for (size_t i = 0; i < sizeof(namespace_flags) / sizeof(namespace_flags[0]); i++) {
+        cmp = SCMP_A0(SCMP_CMP_MASKED_EQ, namespace_flags[i], namespace_flags[i]);
+        if (_rule(ctx, SCMP_ACT_ERRNO(EPERM), "clone", 1, &cmp))
+            goto out;
+    }
+    if (_rule(ctx, SCMP_ACT_ERRNO(ENOSYS), "clone3", 0, NULL))
+        goto out;
+
+    /* personality(): only back to the default (PER_LINUX), no other execution domain or flag
+       (READ_IMPLIES_EXEC, ADDR_NO_RANDOMIZE...) */
+    cmp = SCMP_A0(SCMP_CMP_NE, 0);
+    if (_rule(ctx, SCMP_ACT_ERRNO(EPERM), "personality", 1, &cmp))
+        goto out;
+
+    if (_socket_rules(ctx, "socket", internet) || _socket_rules(ctx, "socketpair", internet))
+        goto out;
+
+    rc = seccomp_load(ctx);
+    if (rc < 0) {
+        fprintf(stderr, "hades-bdj: seccomp_load() failed: %s\n", strerror(-rc));
+        rc = -1;
+        goto out;
+    }
+    rc = 0;
+
+out:
+    seccomp_release(ctx);
+    return rc;
+}
+
+int hades_bdj_sandbox_enter(void)
+{
+    char why[128];
+    const char *net = getenv(HADES_BDJ_NETWORK_ENV);
+    int internet = net && !strcmp(net, HADES_BDJ_NETWORK_INTERNET);
+
+    if (getuid() == 0 || geteuid() == 0 || getgid() == 0 || getegid() == 0) {
+        fprintf(stderr, "hades-bdj: refusing to run as root\n");
+        return -1;
+    }
+
+    /* the service sets it (NoNewPrivileges=yes); a filter without CAP_SYS_ADMIN needs it */
+    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) {
+        fprintf(stderr, "hades-bdj: PR_SET_NO_NEW_PRIVS failed: %s\n", strerror(errno));
+        return -1;
+    }
+
+    if (_filter(internet) != 0)
+        return -1;
+
+    /* our filter, and not merely some filter, is in force: unshare() of nothing is refused */
+    errno = 0;
+    if (syscall(SYS_unshare, 0) != -1 || errno != EPERM) {
+        fprintf(stderr, "hades-bdj: the seccomp filter is not in force\n");
+        return -1;
+    }
+
+    if (!bdj_sandbox_check(why, sizeof(why))) {
+        fprintf(stderr, "hades-bdj: not isolated: %s\n", why);
+        return -1;
+    }
+
+    fprintf(stderr, "hades-bdj: isolated (%s)\n", internet ? "BD-Live: network to the Internet" :
+            "no network");
+    return 0;
+}
