From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:39:58 +0000
Subject: [PATCH] Marks after a seek: the ones of its position after the target
 still come

A mark's position is the entry point at or before its time (_fill_mark()),
so the marks of one group of pictures share one position. A seek lands on
such a position, and _find_next_playmark() took the first mark after that
position as the next one: the marks at the position itself that come after
the seek target were never reached. On a playlist whose marks 1, 2 and 3
are in one group of pictures, bd_seek_mark(1) gave BD_EVENT_PLAYMARK 4
next; 2 and 3 never came, to the application nor to a BD-J title
(BDJ_EVENT_MARK), and neither did 3 after bd_seek_mark(2),
bd_seek_chapter() to the chapter of mark 1, or bd_seek_time() to a time
between marks 1 and 2.

Each seek now says up to which mark it passes: the mark it seeks to
(bd_seek_mark(); bd_seek_chapter() with the entry mark of its chapter), or
the last mark at or before its time (bd_seek_time(), bd_seek_playitem() at
the start of its play item, the seek of an angle change). The marks of the
position after that one come with the first read, in their order. A seek to
a byte position (bd_seek()) and the start of a playlist pass every mark of
their position, as before.

The marks that a mark seek passed over were found by CroqueMr
(libreelec-x86-DV, 0002-navigation-read-boundary.patch). Written anew for
LibreELEC Hades.
---
 src/libbluray/bluray.c | 66 +++++++++++++++++++++++++++++++++++-------
 1 file changed, 55 insertions(+), 11 deletions(-)

diff --git a/src/libbluray/bluray.c b/src/libbluray/bluray.c
index 1edd62c..bc2a258 100644
--- a/src/libbluray/bluray.c
+++ b/src/libbluray/bluray.c
@@ -60,6 +60,7 @@
 #include <stdio.h> // SEEK_
 #include <stdlib.h>
 #include <inttypes.h>
+#include <limits.h>
 #include <string.h>
 
 
@@ -2055,7 +2056,17 @@ void bd_close(BLURAY *bd)
  * PlayMark tracking
  */
 
-static void _find_next_playmark(BLURAY *bd)
+/*
+ * A mark's position is the entry point (random access picture) at or before its time, so the
+ * marks of one group of pictures share one position. A seek lands on such a position: of the
+ * marks there, the ones up to the seek target are passed (index <= last_passed), and the ones
+ * after it are still ahead and are reached with the first read. MARKS_PASSED_AT_POSITION: every
+ * mark at the position is passed (a seek to a byte position, the start of a playlist).
+ */
+
+#define MARKS_PASSED_AT_POSITION INT_MAX
+
+static void _find_next_playmark(BLURAY *bd, int last_passed)
 {
     unsigned ii;
 
@@ -2063,7 +2074,7 @@ static void _find_next_playmark(BLURAY *bd)
     bd->next_mark_pos = (uint64_t)-1;
     for (ii = 0; ii < bd->title->mark_list.count; ii++) {
         uint64_t pos = (uint64_t)bd->title->mark_list.mark[ii].title_pkt * 192L;
-        if (pos > bd->s_pos) {
+        if (pos > bd->s_pos || (pos == bd->s_pos && (int)ii > last_passed)) {
             bd->next_mark = ii;
             bd->next_mark_pos = pos;
             break;
@@ -2073,6 +2084,36 @@ static void _find_next_playmark(BLURAY *bd)
     _update_chapter_psr(bd);
 }
 
+/* the last mark at or before a title time (45 kHz), -1 when there is none */
+static int _last_mark_at_time(const NAV_TITLE *title, uint32_t title_time)
+{
+    int last = -1;
+    unsigned ii;
+
+    for (ii = 0; ii < title->mark_list.count; ii++) {
+        if (title->mark_list.mark[ii].title_time <= title_time) {
+            last = (int)ii;
+        }
+    }
+    return last;
+}
+
+/* the mark of a chapter in the mark list (the chapters are its entry marks, in their order) */
+static int _chapter_mark(const NAV_TITLE *title, unsigned chapter)
+{
+    unsigned ii, entry = 0;
+
+    for (ii = 0; ii < title->mark_list.count; ii++) {
+        if (title->mark_list.mark[ii].mark_type == BD_MARK_ENTRY) {
+            if (entry == chapter) {
+                return (int)ii;
+            }
+            entry++;
+        }
+    }
+    return MARKS_PASSED_AT_POSITION;
+}
+
 static void _playmark_reached(BLURAY *bd)
 {
     while (bd->next_mark >= 0 && bd->s_pos > bd->next_mark_pos) {
@@ -2102,7 +2143,8 @@ static void _playmark_reached(BLURAY *bd)
  */
 
 static int64_t _seek_internal(BLURAY *bd,
-                           const NAV_CLIP *clip, uint32_t title_pkt, uint32_t clip_pkt)
+                           const NAV_CLIP *clip, uint32_t title_pkt, uint32_t clip_pkt,
+                           int last_passed_mark)
 {
     int64_t result;
 
@@ -2124,7 +2166,7 @@ static int64_t _seek_internal(BLURAY *bd,
         _bdj_event(bd, BDJ_EVENT_SEEK, media_time);
 
         /* playmark tracking */
-        _find_next_playmark(bd);
+        _find_next_playmark(bd, last_passed_mark);
 
         /* reset PG decoder and controller */
         if (bd->graphics_controller) {
@@ -2184,7 +2226,7 @@ static int64_t _seek_time(BLURAY *bd, uint64_t tick, uint8_t is_uo_mask_checked)
         // Find the closest access unit to the requested position
         clip = nav_time_search(bd->title, (uint32_t)tick, &clip_pkt, &out_pkt);
 
-        _seek_internal(bd, clip, out_pkt, clip_pkt);
+        _seek_internal(bd, clip, out_pkt, clip_pkt, _last_mark_at_time(bd->title, (uint32_t)tick));
 
     } else {
         BD_DEBUG(DBG_BLURAY | DBG_CRIT, "bd_seek_time(%" PRIu64 ") failed\n", tick);
@@ -2260,7 +2302,7 @@ int64_t bd_seek_chapter(BLURAY *bd, unsigned chapter)
             // Find the closest access unit to the requested position
             clip = nav_chapter_search(bd->title, chapter, &clip_pkt, &out_pkt);
 
-            _seek_internal(bd, clip, out_pkt, clip_pkt);
+            _seek_internal(bd, clip, out_pkt, clip_pkt, _chapter_mark(bd->title, chapter));
             ret_pos = bd->s_pos; // Update
         }
     } else {
@@ -2326,7 +2368,7 @@ int64_t bd_seek_playitem(BLURAY *bd, unsigned clip_ref)
       clip_pkt = clip->start_pkt;
       out_pkt  = clip->title_pkt;
 
-      _seek_internal(bd, clip, out_pkt, clip_pkt);
+      _seek_internal(bd, clip, out_pkt, clip_pkt, _last_mark_at_time(bd->title, clip->title_time));
 
     } else {
         BD_DEBUG(DBG_BLURAY | DBG_CRIT, "bd_seek_playitem(%u) failed\n", clip_ref);
@@ -2353,7 +2395,7 @@ int64_t bd_seek_mark(BLURAY *bd, unsigned mark)
         // Find the closest access unit to the requested position
         clip = nav_mark_search(bd->title, mark, &clip_pkt, &out_pkt);
 
-        _seek_internal(bd, clip, out_pkt, clip_pkt);
+        _seek_internal(bd, clip, out_pkt, clip_pkt, (int)mark);
 
     } else {
         BD_DEBUG(DBG_BLURAY | DBG_CRIT, "bd_seek_mark(%u) failed\n", mark);
@@ -2382,7 +2424,7 @@ int64_t bd_seek(BLURAY *bd, uint64_t pos)
         // Find the closest access unit to the requested position
         clip = nav_packet_search(bd->title, pkt, &clip_pkt, &out_pkt, &out_time);
 
-        _seek_internal(bd, clip, out_pkt, clip_pkt);
+        _seek_internal(bd, clip, out_pkt, clip_pkt, MARKS_PASSED_AT_POSITION);
     }
 
     bd_mutex_unlock(&bd->mutex);
@@ -2450,7 +2492,9 @@ static int64_t _clip_seek_time(BLURAY *bd, uint32_t tick)
     // Find the closest access unit to the requested position
     nav_clip_time_search(bd->st0.clip, tick, &clip_pkt, &out_pkt);
 
-    _seek_internal(bd, bd->st0.clip, out_pkt, clip_pkt);
+    _seek_internal(bd, bd->st0.clip, out_pkt, clip_pkt,
+                   _last_mark_at_time(bd->title, bd->st0.clip->title_time +
+                                      (tick > bd->st0.clip->in_time ? tick - bd->st0.clip->in_time : 0)));
 
     return bd->s_pos;
 }
@@ -2972,7 +3016,7 @@ static int _open_playlist(BLURAY *bd, unsigned playlist, unsigned angle)
     if (_open_m2ts(bd, &bd->st0)) {
         BD_DEBUG(DBG_BLURAY, "Title %s selected\n", f_name);
 
-        _find_next_playmark(bd);
+        _find_next_playmark(bd, MARKS_PASSED_AT_POSITION);
 
         _preload_subpaths(bd);
 
-- 
