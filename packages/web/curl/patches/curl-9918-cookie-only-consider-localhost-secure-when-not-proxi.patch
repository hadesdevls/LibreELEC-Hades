From 9ce01c5fe2f976fa818985e616f305b97d6a9326 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Mon, 2 Nov 2026 14:09:15 +0100
Subject: [PATCH] cookie: only consider localhost secure when not proxied

Verified in test 392

Fixes #23699
Reported-by: geeknik on github
Closes #23710
---
 lib/cookie.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/lib/cookie.c b/lib/cookie.c
index e44884b..a1b53b3 100644
--- a/lib/cookie.c
+++ b/lib/cookie.c
@@ -1293,12 +1293,19 @@ static int cookie_sort_ct(const void *p1, const void *p2)
   return (c2->creationtime > c1->creationtime) ? 1 : -1;
 }
 
+#ifdef CURL_DISABLE_PROXY
+#define IS_PROXIED(d) 0
+#else
+#define IS_PROXIED(d) !!CURL_EASY_STR(d, STRING_PROXY)
+#endif
+
 bool Curl_secure_context(struct Curl_easy *data, const char *host)
 {
   return Curl_xfer_is_secure(data) ||
-    curl_strequal("localhost", host) ||
-    !strcmp(host, "127.0.0.1") ||
-    !strcmp(host, "::1");
+    (!IS_PROXIED(data) &&
+     (curl_strequal("localhost", host) ||
+      !strcmp(host, "127.0.0.1") ||
+      !strcmp(host, "::1")));
 }
 
