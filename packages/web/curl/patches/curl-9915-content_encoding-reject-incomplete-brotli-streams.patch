From f789f356a873895ba5beae425106938518891856 Mon Sep 17 00:00:00 2001
From: akasakariko <148060537+akasakariko@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:03:13 +0900
Subject: [PATCH] content_encoding: reject incomplete brotli streams

Pass an end-of-input flag through client writer flushes so brotli can
reject streams that still need input when the transfer completes

Keep ordinary and paused flushes non-final, and allow decoders that
never received a response body

Add test 4271 for the reported payload and --remove-on-error cleanup

Fixes #23615
Closes #23653
---
 lib/content_encoding.c | 16 ++++++++++++-
 lib/cw-out.c           | 12 ++--------
 lib/cw-pause.c         |  6 ++---
 lib/sendf.c            | 12 +++++-----
 lib/sendf.h            | 11 +++++----
 lib/ws.c               |  8 +++----
 tests/data/Makefile.am |  1 +
 tests/data/test4271    | 54 ++++++++++++++++++++++++++++++++++++++++++
 8 files changed, 91 insertions(+), 29 deletions(-)
 create mode 100644 tests/data/test4271

diff --git a/lib/content_encoding.c b/lib/content_encoding.c
index 0feecce..ead180f 100644
--- a/lib/content_encoding.c
+++ b/lib/content_encoding.c
@@ -480,6 +480,20 @@ static CURLcode brotli_do_write(struct Curl_easy *data,
   return result;
 }
 
+static CURLcode brotli_do_flush(struct Curl_easy *data,
+                                struct Curl_cwriter *writer, bool eos)
+{
+  struct brotli_writer *bp = (struct brotli_writer *)writer;
+
+  /* A decoder that consumed input must reach SUCCESS before the transfer
+   * ends. An unused decoder is fine for responses without a body. */
+  if(eos && bp->br && BrotliDecoderIsUsed(bp->br)) {
+    failf(data, "Brotli stream ended before completion");
+    return CURLE_BAD_CONTENT_ENCODING;
+  }
+  return Curl_cwriter_flush(data, writer->next, eos);
+}
+
 static void brotli_do_close(struct Curl_easy *data,
                             struct Curl_cwriter *writer)
 {
@@ -498,7 +512,7 @@ static const struct Curl_cwtype brotli_encoding = {
   CURL_CW_FLAG_BLOWUP,
   brotli_do_init,
   brotli_do_write,
-  Curl_cwriter_def_flush,
+  brotli_do_flush,
   brotli_do_close,
   sizeof(struct brotli_writer)
 };
diff --git a/lib/cw-out.c b/lib/cw-out.c
index 9e85fac..e880a38 100644
--- a/lib/cw-out.c
+++ b/lib/cw-out.c
@@ -481,19 +481,13 @@ static CURLcode cw_out_do_flush(struct Curl_easy *data,
   return CURLE_OK;
 }
 
-static CURLcode cw_out_flush(struct Curl_easy *data,
-                             struct Curl_cwriter *writer)
-{
-  return cw_out_do_flush(data, writer, FALSE);
-}
-
 const struct Curl_cwtype Curl_cwt_out = {
   "cw-out",
   NULL,
   0,
   cw_out_init,
   cw_out_write,
-  cw_out_flush,
+  cw_out_do_flush,
   cw_out_close,
   sizeof(struct cw_out_ctx)
 };
@@ -506,9 +500,7 @@ CURLcode Curl_cw_out_done(struct Curl_easy *data)
   cw_out = Curl_cwriter_get_by_type(data, &Curl_cwt_out);
   if(cw_out) {
     CURL_TRC_WRITE(data, "[OUT] done");
-    result = Curl_client_flush(data);
-    if(!result)
-      result = cw_out_do_flush(data, cw_out, TRUE);
+    result = Curl_client_flush(data, TRUE);
   }
   return result;
 }
diff --git a/lib/cw-pause.c b/lib/cw-pause.c
index b7b7249..aaad3ef 100644
--- a/lib/cw-pause.c
+++ b/lib/cw-pause.c
@@ -100,7 +100,7 @@ static void cw_pause_close(struct Curl_easy *data, struct Curl_cwriter *writer)
 }
 
 static CURLcode cw_pause_flush(struct Curl_easy *data,
-                               struct Curl_cwriter *cw_pause)
+                               struct Curl_cwriter *cw_pause, bool eos)
 {
   struct cw_pause_ctx *ctx = (struct cw_pause_ctx *)cw_pause;
   CURLcode result = CURLE_OK;
@@ -146,7 +146,7 @@ static CURLcode cw_pause_flush(struct Curl_easy *data,
   }
 
   if(!result)
-    result = Curl_cwriter_flush(data, cw_pause->next);
+    result = Curl_cwriter_flush(data, cw_pause->next, eos && !ctx->buf);
   return result;
 }
 
@@ -159,7 +159,7 @@ static CURLcode cw_pause_write(struct Curl_easy *data,
   size_t wlen = 0;
 
   if(ctx->buf && !Curl_cwriter_is_paused(data)) {
-    result = cw_pause_flush(data, writer);
+    result = cw_pause_flush(data, writer, FALSE);
     if(result)
       return result;
   }
diff --git a/lib/sendf.c b/lib/sendf.c
index 1f1df86..41b2ca0 100644
--- a/lib/sendf.c
+++ b/lib/sendf.c
@@ -135,9 +135,9 @@ CURLcode Curl_cwriter_def_write(struct Curl_easy *data,
 }
 
 CURLcode Curl_cwriter_def_flush(struct Curl_easy *data,
-                                struct Curl_cwriter *writer)
+                                struct Curl_cwriter *writer, bool eos)
 {
-  return Curl_cwriter_flush(data, writer->next);
+  return Curl_cwriter_flush(data, writer->next, eos);
 }
 
 void Curl_cwriter_def_close(struct Curl_easy *data,
@@ -392,7 +392,7 @@ CURLcode Curl_client_write(struct Curl_easy *data, int type, const char *buf,
   return result;
 }
 
-CURLcode Curl_client_flush(struct Curl_easy *data)
+CURLcode Curl_client_flush(struct Curl_easy *data, bool eos)
 {
   CURLcode result;
 
@@ -403,8 +403,8 @@ CURLcode Curl_client_flush(struct Curl_easy *data)
     DEBUGASSERT(data->req.writer.stack);
   }
 
-  result = Curl_cwriter_flush(data, data->req.writer.stack);
-  CURL_TRC_WRITE(data, "client_flush() -> %d", (int)result);
+  result = Curl_cwriter_flush(data, data->req.writer.stack, eos);
+  CURL_TRC_WRITE(data, "client_flush(eos=%d) -> %d", eos, (int)result);
   return result;
 }
 
@@ -522,7 +522,7 @@ struct Curl_cwriter *Curl_cwriter_get_by_type(struct Curl_easy *data,
 CURLcode Curl_cwriter_unpause(struct Curl_easy *data)
 {
   data->req.writer.paused = FALSE;
-  return Curl_cwriter_flush(data, data->req.writer.stack);
+  return Curl_cwriter_flush(data, data->req.writer.stack, FALSE);
 }
 
 CURLcode Curl_creader_read(struct Curl_easy *data,
diff --git a/lib/sendf.h b/lib/sendf.h
index 39c7a8a..6975ad1 100644
--- a/lib/sendf.h
+++ b/lib/sendf.h
@@ -62,7 +62,8 @@ struct Curl_easy;
 CURLcode Curl_client_write(struct Curl_easy *data, int type, const char *buf,
                            size_t len) WARN_UNUSED_RESULT;
 
-CURLcode Curl_client_flush(struct Curl_easy *data);
+/* Flush buffered data. Set eos when no more input will be written. */
+CURLcode Curl_client_flush(struct Curl_easy *data, bool eos);
 
 /**
  * Free all resources related to client writing.
@@ -124,7 +125,7 @@ struct Curl_cwtype {
                        struct Curl_cwriter *writer, int type,
                        const char *buf, size_t nbytes);
   CURLcode (*do_flush)(struct Curl_easy *data,
-                       struct Curl_cwriter *writer);
+                       struct Curl_cwriter *writer, bool eos);
   void (*do_close)(struct Curl_easy *data,
                    struct Curl_cwriter *writer);
   size_t cwriter_size;  /* sizeof() allocated struct Curl_cwriter */
@@ -187,8 +188,8 @@ struct Curl_cwriter *Curl_cwriter_get_by_name(struct Curl_easy *data,
 #define Curl_cwriter_write(d, w, t, b, n) \
   ((w) ? (w)->cwt->do_write((d), (w), (t), (b), (n)) : CURLE_WRITE_ERROR)
 
-#define Curl_cwriter_flush(d, w) \
-  ((w) ? (w)->cwt->do_flush((d), (w)) : CURLE_WRITE_ERROR)
+#define Curl_cwriter_flush(d, w, eos) \
+  ((w) ? (w)->cwt->do_flush((d), (w), (eos)) : CURLE_WRITE_ERROR)
 
 /* TRUE if client writer is paused. */
 #define Curl_cwriter_is_paused(d)     ((bool)(d)->req.writer.paused)
@@ -208,7 +209,7 @@ CURLcode Curl_cwriter_def_write(struct Curl_easy *data,
                                 struct Curl_cwriter *writer, int type,
                                 const char *buf, size_t nbytes);
 CURLcode Curl_cwriter_def_flush(struct Curl_easy *data,
-                                struct Curl_cwriter *writer);
+                                struct Curl_cwriter *writer, bool eos);
 void Curl_cwriter_def_close(struct Curl_easy *data,
                             struct Curl_cwriter *writer);
 
diff --git a/lib/ws.c b/lib/ws.c
index 8dcd2d6..74d6ef0 100644
--- a/lib/ws.c
+++ b/lib/ws.c
@@ -736,7 +736,7 @@ static CURLcode ws_cw_write(struct Curl_easy *data,
     }
   }
 
-  result = Curl_cwriter_flush(data, writer->next);
+  result = Curl_cwriter_flush(data, writer->next, FALSE);
   if(result)
     goto out;
 
@@ -784,7 +784,7 @@ out:
 }
 
 static CURLcode ws_cw_flush(struct Curl_easy *data,
-                            struct Curl_cwriter *writer)
+                            struct Curl_cwriter *writer, bool eos)
 {
   CURLcode result = CURLE_OK;
 
@@ -796,7 +796,7 @@ static CURLcode ws_cw_flush(struct Curl_easy *data,
     /* Frames should be written one by one, else the meta data does
      * not fit. Flush the next writer first, so it does not aggregate
      * our flushed data with anything it might have buffered. */
-    result = Curl_cwriter_flush(data, writer->next);
+    result = Curl_cwriter_flush(data, writer->next, FALSE);
     if(result)
       goto out;
 
@@ -830,7 +830,7 @@ static CURLcode ws_cw_flush(struct Curl_easy *data,
 
 out:
   if(!result)
-    result = Curl_cwriter_flush(data, writer->next);
+    result = Curl_cwriter_flush(data, writer->next, eos);
   return result;
 }
 
diff --git a/tests/data/Makefile.am b/tests/data/Makefile.am
index 3c0d619..1b25e9c 100644
--- a/tests/data/Makefile.am
+++ b/tests/data/Makefile.am
@@ -2159,6 +2159,7 @@ TESTCASES = \
   test4001 \
   test4039 \
   test4040 \
+  test4271 \
   test4644 \
   test4656 \
   test4657 \
diff --git a/tests/data/test4271 b/tests/data/test4271
new file mode 100644
index 0000000..b7bdfa8
--- /dev/null
+++ b/tests/data/test4271
@@ -0,0 +1,54 @@
+<?xml version="1.0" encoding="US-ASCII"?>
+<testcase>
+<info>
+<keywords>
+HTTP
+HTTP GET
+compressed
+</keywords>
+</info>
+<reply>
+<data crlf="headers" nonewline="yes" nocheck="yes">
+HTTP/1.1 200 OK
+Content-Encoding: br
+Content-Length: 3
+
+AAA
+</data>
+</reply>
+
+<client>
+<features>
+brotli
+</features>
+<server>
+http
+</server>
+<name>
+HTTP GET incomplete brotli compressed content
+</name>
+<command option="no-include">
+http://%HOSTIP:%HTTPPORT/%TESTNUMBER --compressed --remove-on-error -o %LOGDIR/decoded%TESTNUMBER
+</command>
+</client>
+
+<verify>
+<strippart>
+s/^Accept-Encoding: [a-zA-Z, ]*/Accept-Encoding: xxx/
+</strippart>
+<protocol crlf="headers">
+GET /%TESTNUMBER HTTP/1.1
+Host: %HOSTIP:%HTTPPORT
+User-Agent: curl/%VERSION
+Accept: */*
+Accept-Encoding: xxx
+
+</protocol>
+<notexists>
+%LOGDIR/decoded%TESTNUMBER
+</notexists>
+<errorcode>
+61
+</errorcode>
+</verify>
+</testcase>
-- 
