From 7ff8feecb91b836ba0154bd03acaa45f81ef5fb9 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Wed, 21 Oct 2026 23:13:29 +0200
Subject: [PATCH] urlapi: check host for bad content after IDN decode

Turns out there are UTF-8 sequences that convert to characters that are
illegal in hostnames, and might even be URL separators. Make sure to
return error for those cases.

Unfortunately, since the URL parser does not IDN decode the host name at
parsing time, this kind of illegal hostname is not spotted until it is
later decoded.

Extended test 1560 to verify

Reported-by: Zefan Xu
Bug: https://hackerone.com/reports/4129950
Closes #23545

Upstream: https://github.com/curl/curl/commit/7ff8feecb91b836ba0154bd03acaa45f81ef5fb9
---
 lib/urlapi.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/lib/urlapi.c b/lib/urlapi.c
index 8a947d0..4678534 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -533,7 +533,7 @@ static CURLUcode hostname_check(char *hostname, size_t hlen)
 
 /* the input is a hostname or perhaps an IPv6 address */
 static CURLUcode hostname_check6(struct Curl_URL *u, char *hostname,
-                                size_t hlen) /* length of hostname */
+                                 size_t hlen) /* length of hostname */
 {
   DEBUGASSERT(hostname);
 
@@ -1534,6 +1534,11 @@ static CURLUcode urlget_format(const CURLU *u, CURLUPart what,
       curlx_free(part);
       if(uc)
         return uc;
+      uc = hostname_check(punyversion, strlen(punyversion));
+      if(uc) {
+        curlx_free(punyversion);
+        return uc;
+      }
       part = punyversion;
     }
   }
@@ -1635,8 +1640,12 @@ static CURLUcode urlget_url(const CURLU *u, char **part, unsigned int flags)
     else if(flags & CURLU_PUNYCODE) {
       if(!Curl_is_ASCII_name(u->host)) {
         CURLUcode ret = host_decode(u->host, &allochost);
-        if(ret)
+        if(!ret)
+          ret = hostname_check(allochost, strlen(allochost));
+        if(ret) {
+          curlx_safefree(allochost);
           return ret;
+        }
       }
     }
     else if(flags & CURLU_PUNY2IDN) {
