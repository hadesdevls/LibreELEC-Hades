From e8bd2e746f567ed15ff4e76eedafdf54d1d9f0d8 Mon Sep 17 00:00:00 2001
From: Josue Barros <goldenglowitsolutions@gmail.com>
Date: Thu, 12 Nov 2026 19:33:29 -0300
Subject: [PATCH] openssl: stop shutdown after a fatal SSL_read

The probe SSL_read() at the start of ossl_shutdown() can return
SSL_ERROR_SSL or SSL_ERROR_SYSCALL. OpenSSL treats both as terminal, but
the function continued into SSL_shutdown() or another SSL_read(). End
the best-effort shutdown there.

A peer close notify is still SSL_ERROR_ZERO_RETURN. WANT_READ and
WANT_WRITE still continue.

Reported-by: Max Dymond
Fixes #23912
Closes #23914

Upstream: https://github.com/curl/curl/commit/e8bd2e746f567ed15ff4e76eedafdf54d1d9f0d8
---
 lib/vtls/openssl.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index a9ce1d9..d62c09f 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -1862,6 +1862,19 @@ static CURLcode ossl_shutdown(struct Curl_cfilter *cf,
         break;
     }
     err = SSL_get_error(octx->ssl, nread);
+    if(err == SSL_ERROR_SSL || err == SSL_ERROR_SYSCALL) {
+      /* OpenSSL forbids further I/O after these results. A peer close
+       * notify is SSL_ERROR_ZERO_RETURN and stays on the path below. */
+      VERBOSE(unsigned long sslerr = ERR_get_error());
+      CURL_TRC_CF(data, cf,
+                  "SSL shutdown, fatal recv before send: %s (%s), errno %d",
+                  SSL_ERROR_to_str(err),
+                  (sslerr ? ossl_strerror(sslerr, buf, sizeof(buf)) :
+                   "no OpenSSL error"),
+                  SOCKERRNO);
+      *done = TRUE;
+      goto out;
+    }
     if(!nread && err == SSL_ERROR_ZERO_RETURN) {
       bool input_pending;
       /* Yes, it did. */
