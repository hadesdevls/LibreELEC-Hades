From 18a926eca1a885f623eea33fd042a68e781dee40 Mon Sep 17 00:00:00 2001
From: dataisland <dataisland@outlook.com>
Date: Sat, 10 Oct 2026 23:00:50 -0700
Subject: [PATCH] vtls: encode session peer key fields unambiguously

Delimiter-containing TLS configuration strings can produce identical
session peer keys for different trust settings. Length-prefix variable
string fields, including canonical paths, and add a key-format version
marker so older serialized keys are not matched. Extend unit3304 with
CAfile/CApath and cipher-list boundary cases.

Closes #23357

(cherry picked from commit 18a926eca1a885f623eea33fd042a68e781dee40)
---
 docs/internals/TLS-SESSIONS.md | 15 +++++++++----
 lib/vtls/vtls_scache.c         | 40 ++++++++++++++++++++-------------
 tests/unit/unit3304.c          | 41 ++++++++++++++++++++++++++++++++++
 3 files changed, 76 insertions(+), 20 deletions(-)

diff --git a/docs/internals/TLS-SESSIONS.md b/docs/internals/TLS-SESSIONS.md
index fdca13a..34d308f 100644
--- a/docs/internals/TLS-SESSIONS.md
+++ b/docs/internals/TLS-SESSIONS.md
@@ -45,13 +45,20 @@ string that carries hostname and port and any non-default TLS
 parameters involved in the connection.
 
 Examples:
-- `curl.se:443:CA-/etc/ssl/cert.pem:IMPL-GnuTLS/3.8.7` is a peer key for
-   a connection to `curl.se:443` using `/etc/ssl/cert.pem` as CA
+- `curl.se:443:KEY-V2:CA-17:/etc/ssl/cert.pem:IMPL-12:GnuTLS/3.8.7:G`
+   is a peer key for a connection to `curl.se:443` using `/etc/ssl/cert.pem` as CA
    trust anchors and GnuTLS/3.8.7 as TLS backend.
-- `curl.se:443:TLSVER-6-6:CA-/etc/ssl/cert.pem:IMPL-GnuTLS/3.8.7` is the
-   same as the previous, except it is configured to use TLSv1.2 as
+- `curl.se:443:KEY-V2:TLSVER-6-6:CA-17:/etc/ssl/cert.pem:IMPL-12:GnuTLS/3.8.7:G`
+   is the same as the previous, except it is configured to use TLSv1.2 as
    min and max versions.
 
+The `KEY-V2` marker separates this format from legacy peer keys. Variable
+string fields use `NAME-length:value`, where the length counts bytes in the
+value, so delimiters inside a value cannot introduce another field. The `:G`
+suffix marks keys that can be used across processes; `:L` marks local keys.
+Persisted sessions exported with legacy peer keys no longer match keys in this
+format and cannot be resumed from those cache entries.
+
 Different configurations produce different keys which is what curl needs when
 handling SSL session tickets.
 
diff --git a/lib/vtls/vtls_scache.c b/lib/vtls/vtls_scache.c
index 7192be2..3f5046f 100644
--- a/lib/vtls/vtls_scache.c
+++ b/lib/vtls/vtls_scache.c
@@ -63,6 +63,14 @@ struct Curl_ssl_scache_peer {
 
 #define GOOD_SCACHE(x) ((x) && (x)->magic == CURL_SCACHE_MAGIC)
 
+/* Prefix the length to keep field boundaries unambiguous. */
+static CURLcode cf_ssl_peer_key_add_string(struct dynbuf *buf,
+                                           const char *name,
+                                           const char *value)
+{
+  return curlx_dyn_addf(buf, ":%s-%zu:%s", name, strlen(value), value);
+}
+
 static CURLcode cf_ssl_peer_key_add_path(struct dynbuf *buf,
                                          const char *name,
                                          const char *path,
@@ -75,7 +83,7 @@ static CURLcode cf_ssl_peer_key_add_path(struct dynbuf *buf,
 #ifdef _WIN32
     char *abspath = _fullpath(NULL, path, 0);
     if(abspath) {
-      CURLcode result = curlx_dyn_addf(buf, ":%s-%s", name, abspath);
+      CURLcode result = cf_ssl_peer_key_add_string(buf, name, abspath);
       /* !checksrc! disable BANNEDFUNC 1 */
       free(abspath); /* allocated by CRT, use system free() */
       return result;
@@ -85,7 +93,7 @@ static CURLcode cf_ssl_peer_key_add_path(struct dynbuf *buf,
     if(path[0] != '/') {
       char *abspath = realpath(path, NULL);
       if(abspath) {
-        CURLcode result = curlx_dyn_addf(buf, ":%s-%s", name, abspath);
+        CURLcode result = cf_ssl_peer_key_add_string(buf, name, abspath);
         /* !checksrc! disable BANNEDFUNC 1 */
         free(abspath); /* allocated by libc, free without memdebug */
         return result;
@@ -93,7 +101,7 @@ static CURLcode cf_ssl_peer_key_add_path(struct dynbuf *buf,
       *is_local = TRUE;
     }
 #endif
-    return curlx_dyn_addf(buf, ":%s-%s", name, path);
+    return cf_ssl_peer_key_add_string(buf, name, path);
   }
   return CURLE_OK;
 }
@@ -145,7 +153,7 @@ static CURLcode cf_ssl_peer_key_add_mtls(struct dynbuf *buf,
   }
   if(ssl->cert_type && ssl->cert_type[0]) {
     size_t i;
-    result = curlx_dyn_add(buf, ":CT-");
+    result = curlx_dyn_addf(buf, ":CT-%zu:", strlen(ssl->cert_type));
     for(i = 0; !result && ssl->cert_type[i]; i++) {
       char c = Curl_raw_toupper(ssl->cert_type[i]);
       result = curlx_dyn_addn(buf, &c, 1);
@@ -155,7 +163,7 @@ static CURLcode cf_ssl_peer_key_add_mtls(struct dynbuf *buf,
   }
   if(ssl->key_type && ssl->key_type[0]) {
     size_t i;
-    result = curlx_dyn_add(buf, ":KT-");
+    result = curlx_dyn_addf(buf, ":KT-%zu:", strlen(ssl->key_type));
     for(i = 0; !result && ssl->key_type[i]; i++) {
       char c = Curl_raw_toupper(ssl->key_type[i]);
       result = curlx_dyn_addn(buf, &c, 1);
@@ -216,9 +224,9 @@ static CURLcode ssl_peer_key_add_vrfy(struct dynbuf *buf,
   }
   if((!ssl->verifypeer || !ssl->verifyhost) &&
      peer->peer && !Curl_peer_equal(peer->origin, peer->peer)) {
-    result = curlx_dyn_addf(buf, ":CHOST-%s:CPORT-%u",
-                            peer->peer->hostname,
-                            peer->peer->port);
+    result = cf_ssl_peer_key_add_string(buf, "CHOST", peer->peer->hostname);
+    if(!result)
+      result = curlx_dyn_addf(buf, ":CPORT-%u", peer->peer->port);
     if(result)
       return result;
   }
@@ -238,7 +246,7 @@ static CURLcode ssl_peer_key_build(struct ssl_filter_config *ssl,
   *ppeer_key = NULL;
   curlx_dyn_init(&buf, 10 * 1024);
 
-  result = curlx_dyn_addf(&buf, "%s:%d",
+  result = curlx_dyn_addf(&buf, "%s:%d:KEY-V2",
                           peer->origin->hostname, peer->origin->port);
   if(result)
     goto out;
@@ -260,23 +268,23 @@ static CURLcode ssl_peer_key_build(struct ssl_filter_config *ssl,
       goto out;
   }
   if(ssl->cipher_list) {
-    result = curlx_dyn_addf(&buf, ":CIPHER-%s", ssl->cipher_list);
+    result = cf_ssl_peer_key_add_string(&buf, "CIPHER", ssl->cipher_list);
     if(result)
       goto out;
   }
   if(ssl->cipher_list13) {
-    result = curlx_dyn_addf(&buf, ":CIPHER13-%s", ssl->cipher_list13);
+    result = cf_ssl_peer_key_add_string(&buf, "CIPHER13", ssl->cipher_list13);
     if(result)
       goto out;
   }
   if(ssl->curves) {
-    result = curlx_dyn_addf(&buf, ":CURVES-%s", ssl->curves);
+    result = cf_ssl_peer_key_add_string(&buf, "CURVES", ssl->curves);
     if(result)
       goto out;
   }
   if(ssl->signature_algorithms) {
-    result = curlx_dyn_addf(&buf, ":SIGALGS-%s",
-                            ssl->signature_algorithms);
+    result = cf_ssl_peer_key_add_string(&buf, "SIGALGS",
+                                        ssl->signature_algorithms);
     if(result)
       goto out;
   }
@@ -312,7 +320,7 @@ static CURLcode ssl_peer_key_build(struct ssl_filter_config *ssl,
       goto out;
   }
   if(ssl->pinned_key && ssl->pinned_key[0]) {
-    result = curlx_dyn_addf(&buf, ":Pinned-%s", ssl->pinned_key);
+    result = cf_ssl_peer_key_add_string(&buf, "Pinned", ssl->pinned_key);
     if(result)
       goto out;
   }
@@ -325,7 +333,7 @@ static CURLcode ssl_peer_key_build(struct ssl_filter_config *ssl,
     result = CURLE_FAILED_INIT;
     goto out;
   }
-  result = curlx_dyn_addf(&buf, ":IMPL-%s", tls_id);
+  result = cf_ssl_peer_key_add_string(&buf, "IMPL", tls_id);
   if(result)
     goto out;
 
diff --git a/tests/unit/unit3304.c b/tests/unit/unit3304.c
index 1d5546a..d59d4ae 100644
--- a/tests/unit/unit3304.c
+++ b/tests/unit/unit3304.c
@@ -59,6 +59,12 @@ static CURLcode test_unit3304(const char *arg)
   static char alt_ctype[]     = "P12";
   static char lc_ctype[]      = "pem";
   static char lc_ktype[]      = "pem";
+  static char cafile_fields[] = "/root:CApath-/certs";
+  static char cafile[]        = "/root";
+  static char capath[]        = "/certs";
+  static char cipher_fields[] = "DEFAULT:CIPHER13-TLS_AES_128_GCM_SHA256";
+  static char cipher_list[]   = "DEFAULT";
+  static char cipher_list13[] = "TLS_AES_128_GCM_SHA256";
 
   memset(&origin, 0, sizeof(origin));
   origin.hostname = base_hostname;
@@ -84,9 +90,44 @@ static CURLcode test_unit3304(const char *arg)
               "peer key build failed");
   fail_unless(key1 && key2 && !strcmp(key1, key2),
               "identical config should produce identical peer key");
+  /* Keep legacy serialized keys separate from this key format. */
+  fail_unless(key1 && !strncmp(key1, "example.com:443:KEY-V2:",
+                               sizeof("example.com:443:KEY-V2:") - 1),
+              "peer key must carry the V2 format marker after the port");
   curlx_safefree(key1);
   curlx_safefree(key2);
 
+  /* A delimiter in a CA path must not create a second trust field. */
+  ssl.CAfile = cafile_fields;
+  ssl.CApath = NULL;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key1),
+              "peer key build failed");
+  ssl.CAfile = cafile;
+  ssl.CApath = capath;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key2),
+              "peer key build failed");
+  fail_unless(key1 && key2 && strcmp(key1, key2),
+              "CA file and path must not alias another CA file");
+  curlx_safefree(key1);
+  curlx_safefree(key2);
+  ssl.CAfile = NULL;
+  ssl.CApath = NULL;
+
+  /* Non-path fields must not inject a following field either. */
+  ssl.cipher_list = cipher_fields;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key1),
+              "peer key build failed");
+  ssl.cipher_list = cipher_list;
+  ssl.cipher_list13 = cipher_list13;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key2),
+              "peer key build failed");
+  fail_unless(key1 && key2 && strcmp(key1, key2),
+              "cipher fields must have unambiguous boundaries");
+  curlx_safefree(key1);
+  curlx_safefree(key2);
+  ssl.cipher_list = NULL;
+  ssl.cipher_list13 = NULL;
+
   /* key_passwd is NOT in the peer key: lookup uses timing-safe comparison
    * via cf_ssl_scache_match_auth(). */
   fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key1),
-- 
