From 76d00d432ca74c56492604a5df844ded7ec0702a Mon Sep 17 00:00:00 2001
From: dataisland <dataisland@outlook.com>
Date: Tue, 13 Oct 2026 13:12:38 -0700
Subject: [PATCH] easy: clear pending resolve entries on reset

Verify in test 1607

Closes #23389
---
 lib/easy.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/lib/easy.c b/lib/easy.c
index 58d3098..a5dd871 100644
--- a/lib/easy.c
+++ b/lib/easy.c
@@ -1150,6 +1150,7 @@ void curl_easy_reset(CURL *curl)
     Curl_freeset(data);
     memset(&data->set, 0, sizeof(struct UserDefined));
     Curl_init_userdefined(data);
+    data->state.resolve = NULL;
 
     /* zero out Progress data: */
     memset(&data->progress, 0, sizeof(struct Progress));
