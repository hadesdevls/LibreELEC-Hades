From ef7c7b6e1fb7d30398fabac92aa868a92fca8203 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Mon, 26 Oct 2026 16:24:05 +0100
Subject: [PATCH] peer: extract host name punycoded

Saves this code from having to do it separately, and makes it take
advantage of the extra error checking done by the URL API call.

Verify in test 2952 (which doesn't work on Windows)

Fixes #23613
Reported-by: christos-cantina-security on github
Closes #23616

Upstream: https://github.com/curl/curl/commit/ef7c7b6e1fb7d30398fabac92aa868a92fca8203
---
 lib/peer.c       |  5 +++++
 lib/urlapi-int.h |  2 ++
 lib/urlapi.c     | 10 +++++-----
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/lib/peer.c b/lib/peer.c
index 01a77bd..5218091 100644
--- a/lib/peer.c
+++ b/lib/peer.c
@@ -213,6 +213,11 @@ static CURLcode peer_parse_host(struct Curl_easy *data,
           return CURLE_OUT_OF_MEMORY;
       }
       result = Curl_idn_decode(pp->tmp_host_user, &pp->tmp_host);
+      if(!result &&
+         Curl_hostname_check(pp->tmp_host, strlen(pp->tmp_host))) {
+        failf(data, "Illegal hostname: %s", pp->tmp_host);
+        result = CURLE_URL_MALFORMAT;
+      }
       if(result)
         return result;
       pp->host.str = pp->tmp_host;
diff --git a/lib/urlapi-int.h b/lib/urlapi-int.h
index cf1fe6e..e8f41fd 100644
--- a/lib/urlapi-int.h
+++ b/lib/urlapi-int.h
@@ -67,4 +67,6 @@ bool Curl_url_same_origin(CURLU *base, CURLU *href);
 
 CURLUcode Curl_url_get_port(CURLU *u, uint16_t *pport);
 
+CURLUcode Curl_hostname_check(const char *hostname, size_t hlen);
+
 #endif /* HEADER_CURL_URLAPI_INT_H */
diff --git a/lib/urlapi.c b/lib/urlapi.c
index fe90a6f..c10c524 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -514,7 +514,7 @@ UNITTEST CURLUcode ipv6_parse(struct Curl_URL *u, char *hostname,
 }
 
 /* the input is a confirmed hostname, never an IPv6 address */
-static CURLUcode hostname_check(char *hostname, size_t hlen)
+CURLUcode Curl_hostname_check(const char *hostname, size_t hlen)
 {
   size_t i;
   for(i = 0; i < hlen; i++) {
@@ -542,7 +542,7 @@ static CURLUcode hostname_check6(struct Curl_URL *u, char *hostname,
   else if(hostname[0] == '[')
     return ipv6_parse(u, hostname, hlen);
 
-  return hostname_check(hostname, hlen);
+  return Curl_hostname_check(hostname, hlen);
 }
 
 /*
@@ -735,7 +735,7 @@ static CURLUcode parse_authority(struct Curl_URL *u,
     int type = ipv4_normalize(host);
 
     if(type == HOST_NAME)
-      uc = hostname_check(curlx_dyn_ptr(host), curlx_dyn_len(host));
+      uc = Curl_hostname_check(curlx_dyn_ptr(host), curlx_dyn_len(host));
     else if(type == HOST_ERROR)
       uc = CURLUE_OUT_OF_MEMORY;
   }
@@ -1534,7 +1534,7 @@ static CURLUcode urlget_format(const CURLU *u, CURLUPart what,
       curlx_free(part);
       if(uc)
         return uc;
-      uc = hostname_check(punyversion, strlen(punyversion));
+      uc = Curl_hostname_check(punyversion, strlen(punyversion));
       if(uc) {
         curlx_free(punyversion);
         return uc;
@@ -1641,7 +1641,7 @@ static CURLUcode urlget_url(const CURLU *u, char **part, unsigned int flags)
       if(!Curl_is_ASCII_name(u->host)) {
         CURLUcode ret = host_decode(u->host, &allochost);
         if(!ret)
-          ret = hostname_check(allochost, strlen(allochost));
+          ret = Curl_hostname_check(allochost, strlen(allochost));
         if(ret) {
           curlx_safefree(allochost);
           return ret;
