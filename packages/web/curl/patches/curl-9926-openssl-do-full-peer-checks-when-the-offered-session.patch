From 93eb74a610824d1da6d735e518af8a5b8a2bb5e5 Mon Sep 17 00:00:00 2001
From: lazerg <lazerg2@gmail.com>
Date: Sun, 8 Nov 2026 12:31:00 +0500
Subject: [PATCH] openssl: do full peer checks when the offered session is not
 resumed

Anthropic's OSS Scanner issue ANT-2026-0AXP89WL

Fixes #23756
Closes #23816

Upstream: https://github.com/curl/curl/commit/93eb74a610824d1da6d735e518af8a5b8a2bb5e5
---
 lib/vtls/openssl.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index 5452f75..a9ce1d9 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -4806,6 +4806,12 @@ CURLcode Curl_ossl_check_peer_cert(struct Curl_cfilter *cf,
   X509 *server_cert;
   bool verified = FALSE;
 
+  /* we may have offered a session, but the server decides if it resumes */
+  if(octx->reused_session && !SSL_session_reused(octx->ssl)) {
+    infof(data, "SSL session not resumed by server, doing full checks");
+    octx->reused_session = FALSE;
+  }
+
   if(data->set.ssl.certinfo && !octx->reused_session) {
     /* asked to gather certificate info. Reused sessions do not have cert
        chains */
