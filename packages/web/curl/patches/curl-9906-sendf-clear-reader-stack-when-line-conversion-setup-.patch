From 5e396f38bba9736db31dc1714bb78d5210cb882b Mon Sep 17 00:00:00 2001
From: Max Dymond <cmeister2@gmail.com>
Date: Sun, 25 Oct 2026 08:15:11 +0000
Subject: [PATCH] sendf: clear reader stack when line-conversion setup fails

Clean up the installed readers in do_init_reader_stack() if adding the
CRLF reader fails. Let Curl_creader_set() rely on that cleanup instead
of freeing the client reader separately.

Add unit3307 to enable allocation failure from the reader length
callback and verify cleanup without depending on allocation ordinals.

Closes #23596
---
 lib/sendf.c             |  14 +++---
 tests/data/Makefile.am  |   1 +
 tests/data/test3307     |  21 ++++++++
 tests/unit/Makefile.inc |   1 +
 tests/unit/unit3307.c   | 107 ++++++++++++++++++++++++++++++++++++++++
 5 files changed, 137 insertions(+), 7 deletions(-)
 create mode 100644 tests/data/test3307
 create mode 100644 tests/unit/unit3307.c

diff --git a/lib/sendf.c b/lib/sendf.c
index d6ff925..9c202d1 100644
--- a/lib/sendf.c
+++ b/lib/sendf.c
@@ -1142,8 +1142,13 @@ static CURLcode do_init_reader_stack(struct Curl_easy *data,
 #endif
     ) {
     result = cr_lc_add(data);
-    if(result)
+    if(result) {
+      /* Adding the line-conversion reader failed. Undo the publication of
+       * `r` so no freed reader remains reachable from
+       * `data->req.reader.stack`, and free the readers already installed. */
+      cl_reset_reader(data);
       return result;
+    }
   }
 
   return result;
@@ -1192,17 +1197,12 @@ CURLcode Curl_creader_add(struct Curl_easy *data,
 
 CURLcode Curl_creader_set(struct Curl_easy *data, struct Curl_creader *r)
 {
-  CURLcode result;
-
   DEBUGASSERT(r);
   DEBUGASSERT(r->crt);
   DEBUGASSERT(r->phase == CURL_CR_CLIENT);
 
   cl_reset_reader(data);
-  result = do_init_reader_stack(data, r);
-  if(result)
-    Curl_creader_free(data, r);
-  return result;
+  return do_init_reader_stack(data, r);
 }
 
 CURLcode Curl_client_read(struct Curl_easy *data, char *buf, size_t blen,
