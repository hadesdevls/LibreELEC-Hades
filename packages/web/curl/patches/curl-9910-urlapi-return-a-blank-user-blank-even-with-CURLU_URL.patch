From 2bc780243feea0fc47660bf16534077251e47793 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Wed, 28 Oct 2026 23:23:17 +0100
Subject: [PATCH] urlapi: return a blank user blank even with CURLU_URLENCODE

Extended test 1560 to verify

Fixes #23659
Reported-by: Dilshod Urazov
Closes #23665
---
 lib/urlapi.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/urlapi.c b/lib/urlapi.c
index 9d5e84d..51dab87 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -1521,7 +1521,7 @@ static CURLUcode urlget_format(const CURLU *u, CURLUPart what,
     part = decoded;
     partlen = dlen;
   }
-  if(urlencode) {
+  if(urlencode && partlen) {
     struct dynbuf enc;
     curlx_dyn_init(&enc, CURL_MAX_INPUT_LENGTH);
     uc = urlencode_str(&enc, part, partlen, TRUE, what == CURLUPART_QUERY ?
