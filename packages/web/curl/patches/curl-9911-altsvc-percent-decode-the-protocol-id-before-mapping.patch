From a4eed8c7f39c1a24f073f5889623b8fb99b50b1a Mon Sep 17 00:00:00 2001
From: Vishnu Srivatsava <vishnusrivatsava@gmail.com>
Date: Thu, 29 Oct 2026 00:51:19 +0530
Subject: [PATCH] altsvc: percent-decode the protocol-id before mapping

RFC 7838 section 3 defines the Alt-Svc protocol-id as a percent-encoded
ALPN name. A conforming header using http%2F1.1 was silently ignored
because curl matched the encoded token against raw protocol names.

Use Curl_urldecode() in Curl_altsvc_parse() before matching tokens that
contain percent signs. Match using the decoded length, free the temporary
buffer, and propagate allocation errors. Keep cache-file protocol names
and unencoded header tokens on the existing raw matching path.

Reject decoded control and NUL bytes with REJECT_CTRL. Treat decoder
format errors as unknown protocols so other alternatives in the header
are still processed without aborting the transfer.

Extend unit1654 with uppercase and lowercase escapes, encoded h2,
malformed and truncated escapes, encoded control and NUL bytes, empty
tokens, and valid alternatives before and after rejected tokens. Clear
the test origin between cases and run them after the cache save to
preserve its expected output.

Fixes #23654
Reported-by: Achim Friedland
Closes #23657
---
 lib/altsvc.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/lib/altsvc.c b/lib/altsvc.c
index 5d478a7..7e91f04 100644
--- a/lib/altsvc.c
+++ b/lib/altsvc.c
@@ -37,6 +37,7 @@
 #include "curlx/inet_pton.h"
 #include "curlx/strparse.h"
 #include "connect.h"
+#include "escape.h"
 
 #define MAX_ALTSVC_LINE    4095
 #define MAX_ALTSVC_DATELEN 17
@@ -632,7 +633,23 @@ CURLcode Curl_altsvc_parse(struct Curl_easy *data,
     if(curlx_str_until(&p, &alpn, MAX_ALTSVC_LINE, '='))
       break; /* not another entry, leave */
     curlx_str_trimblanks(&alpn);
-    dstalpnid = Curl_str2alpnid(&alpn);
+    if(memchr(curlx_str(&alpn), '%', curlx_strlen(&alpn))) {
+      char *decoded;
+      size_t dlen;
+      /* RFC 7838 section 3: protocol-id is a percent-encoded ALPN name. */
+      CURLcode result = Curl_urldecode(curlx_str(&alpn), curlx_strlen(&alpn),
+                                       &decoded, &dlen, REJECT_CTRL);
+      if(result == CURLE_URL_MALFORMAT)
+        dstalpnid = ALPN_none;
+      else if(result)
+        return result;
+      else {
+        dstalpnid = Curl_alpn2alpnid((const unsigned char *)decoded, dlen);
+        curlx_free(decoded);
+      }
+    }
+    else
+      dstalpnid = Curl_str2alpnid(&alpn);
 
     if(curlx_str_single(&p, '='))
       break;
