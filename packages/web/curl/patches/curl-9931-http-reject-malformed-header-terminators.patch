From 3f684481b82e3f7ccbf61f79afb96fb4f0c67b60 Mon Sep 17 00:00:00 2001
From: Andrew Gabaraev <46446380+Artyx71@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:41:02 +0300
Subject: [PATCH] http: reject malformed header terminators

Require exactly CRLF or LF before treating a line as the end of response
headers. CR-prefixed payloads must not bypass validation and reach the
header callback as a successful terminator.

Add tests for NUL and ordinary text after the leading CR, including the
bytes delivered to the header output.

Reported-by: christos-cantina-security on github
Fixes #23859
Closes #23884

Upstream: https://github.com/curl/curl/commit/3f684481b82e3f7ccbf61f79afb96fb4f0c67b60
---
 lib/http.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/lib/http.c b/lib/http.c
index 25cf1f4..73424d7 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -4314,6 +4314,12 @@ static CURLcode http_rw_hd(struct Curl_easy *data,
     struct dynbuf last_header;
     size_t consumed;
 
+    if((hdlen != 1 || hd[0] != '\n') &&
+       (hdlen != 2 || hd[0] != '\r' || hd[1] != '\n')) {
+      failf(data, "Invalid header termination");
+      return CURLE_WEIRD_SERVER_REPLY;
+    }
+
     curlx_dyn_init(&last_header, hdlen + 1);
     result = curlx_dyn_addn(&last_header, hd, hdlen);
     if(result)
