From 350c4307ed6d667ce022a6f6aa80369e18b01ee3 Mon Sep 17 00:00:00 2001
From: Armaan Sandhu <armaan.sandhu0504@gmail.com>
Date: Fri, 23 Oct 2026 23:56:50 -0400
Subject: [PATCH] urlapi: do not add the zone id twice to a set IPv6 host

Setting CURLUPART_HOST to "[fe80::1%25eth0]" without CURLU_URLENCODE
checked a decoded copy of the host, which moved the zone id into
u->zoneid, but then stored the original string with the zone still in
it. Getting CURLUPART_URL then appended the zone id again and returned
"[fe80::1%25eth0%25eth0]", which does not parse back.

Store the checked and normalized address instead, the same form a
parsed URL gets.

Extend test 1560 to verify.
Closes #23586

Upstream: https://github.com/curl/curl/commit/350c4307ed6d667ce022a6f6aa80369e18b01ee3
---
 lib/urlapi.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/lib/urlapi.c b/lib/urlapi.c
index 4678534..fe90a6f 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -2068,6 +2068,12 @@ static CURLUcode url_sethost(CURLU *u, struct dynbuf *encp,
     CURLcode result = Curl_urldecode(newp, n, &decoded, &dlen, REJECT_CTRL);
     if(result || hostname_check6(u, decoded, dlen))
       bad = TRUE;
+    else if(decoded[0] == '[') {
+      /* store the normalized IPv6 address, the zone id is kept separately */
+      curlx_dyn_reset(encp);
+      if(curlx_dyn_add(encp, decoded))
+        bad = TRUE;
+    }
     else {
       struct dynbuf dbuf;
       curlx_dyn_init(&dbuf, CURL_MAX_INPUT_LENGTH);
