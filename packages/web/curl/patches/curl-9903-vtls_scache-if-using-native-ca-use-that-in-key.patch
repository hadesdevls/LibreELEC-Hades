From dbb8262a9c99b105f7289df35b34c32d476b2d81 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Mon, 19 Oct 2026 17:21:15 +0200
Subject: [PATCH] vtls_scache: if using native-ca, use that in key

Instead of CA/CAfile

Assisted-by: stze on hackerone
Closes #23495

(cherry picked from commit dbb8262a9c99b105f7289df35b34c32d476b2d81)
---
 lib/vtls/vtls_scache.c | 13 +++++++------
 tests/unit/unit3304.c  | 14 ++++++++++++++
 2 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/lib/vtls/vtls_scache.c b/lib/vtls/vtls_scache.c
index 3f7c02b..81795b1 100644
--- a/lib/vtls/vtls_scache.c
+++ b/lib/vtls/vtls_scache.c
@@ -291,12 +291,13 @@ static CURLcode ssl_peer_key_build(struct ssl_filter_config *ssl,
   }
   if(ssl->verifypeer) {
     result = cf_ssl_peer_key_add_path(&buf, "CA", ssl->CAfile, &is_local);
-    if(result)
-      goto out;
-    result = cf_ssl_peer_key_add_path(&buf, "CApath", ssl->CApath, &is_local);
-    if(result)
-      goto out;
-    result = cf_ssl_peer_key_add_path(&buf, "CRL", ssl->CRLfile, &is_local);
+    if(!result)
+      result = cf_ssl_peer_key_add_path(&buf, "CApath",
+                                        ssl->CApath, &is_local);
+    if(!result && ssl->native_ca_store)
+      result = curlx_dyn_add(&buf, ":NATIVE-CA");
+    if(!result)
+      result = cf_ssl_peer_key_add_path(&buf, "CRL", ssl->CRLfile, &is_local);
     if(result)
       goto out;
     result = cf_ssl_peer_key_add_path(&buf, "Issuer", ssl->issuercert,
diff --git a/tests/unit/unit3304.c b/tests/unit/unit3304.c
index f6a74ba..29ea23a 100644
--- a/tests/unit/unit3304.c
+++ b/tests/unit/unit3304.c
@@ -102,6 +102,20 @@ static CURLcode test_unit3304(const char *arg)
   curlx_safefree(key1);
   curlx_safefree(key2);
 
+  /* The effective native CA-store policy is not necessarily represented in
+   * ssl_options: a build can enable it by default. It must still separate
+   * sessions authenticated with native roots from file-only sessions. */
+  ssl.native_ca_store = TRUE;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key1),
+              "peer key build failed");
+  ssl.native_ca_store = FALSE;
+  fail_unless(!Curl_ssl_peer_key_make(&peer, &ssl, "test", &key2),
+              "peer key build failed");
+  fail_unless(key1 && key2 && strcmp(key1, key2),
+              "native CA-store policy must affect the peer key");
+  curlx_safefree(key1);
+  curlx_safefree(key2);
+
   /* A delimiter in a CA path must not create a second trust field. */
   ssl.CAfile = cafile_fields;
   ssl.CApath = NULL;
-- 
