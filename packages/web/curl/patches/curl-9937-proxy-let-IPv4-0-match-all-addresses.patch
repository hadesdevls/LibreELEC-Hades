From 3dde2fb68296c3e2a41e0616309fab8b409d55a3 Mon Sep 17 00:00:00 2001
From: kzeratal <skzeratal@gmail.com>
Date: Sun, 22 Nov 2026 03:31:08 +0800
Subject: [PATCH] proxy: let IPv4 /0 match all addresses

be652f3f9 only did this for 0.0.0.0/0, so 10.0.0.1/0 still matched just
10.0.0.1. IPv6 already matches everything for any /0.

The !check condition is no longer needed now that a missing prefix is
-1. Two old cases in test 1614 still used 0 for "no prefix", change them
to -1 and add a test for 10.0.0.1/0.

Follow-up to #23434
Closes #24081

Upstream: https://github.com/curl/curl/commit/3dde2fb68296c3e2a41e0616309fab8b409d55a3
---
 lib/proxy.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/proxy.c b/lib/proxy.c
index ae4afd8..d4b9af2 100644
--- a/lib/proxy.c
+++ b/lib/proxy.c
@@ -85,8 +85,8 @@ UNITTEST bool cidr4_match(const char *ipv4,    /* 1.2.3.4 address */
       return FALSE;
     return TRUE;
   }
-  else if(!bits && !check)
-    /* 0.0.0.0/0 matches everything */
+  else if(!bits)
+    /* a /0 prefix matches everything */
     return TRUE;
 
   return address == check;
