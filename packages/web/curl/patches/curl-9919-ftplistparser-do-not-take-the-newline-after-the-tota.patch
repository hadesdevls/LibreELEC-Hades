From 0069ac869e723ef7e9ed87f2cc5094962ebc31ac Mon Sep 17 00:00:00 2001
From: Rhino <195818135+1rhino2@users.noreply.github.com>
Date: Tue, 27 Oct 2026 18:37:21 -0400
Subject: [PATCH] ftplistparser: do not take the newline after the "total" line
 as a file type

Since e83e8c30a8 (8.14.0) a UNIX style listing that starts with a "total
N" line fails with CURLE_FTP_BAD_FILE_LIST, because the newline that
ends that line falls through into the file type state and is treated as
the first character of an entry. Break out when the total line just
ended and start the next line normally.

Test 1719 lists a directory with a leading total line through the
wildcard matcher.

Closes #23460
---
 lib/ftplistparser.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/lib/ftplistparser.c b/lib/ftplistparser.c
index c92b07d..ed29cd4 100644
--- a/lib/ftplistparser.c
+++ b/lib/ftplistparser.c
@@ -856,6 +856,9 @@ static CURLcode parse_unix(struct Curl_easy *data,
       break;
     if(parser->state.UNIX.main != PL_UNIX_FILETYPE)
       break;
+    if(c == '\n')
+      /* the "total" line just ended, the newline is not a file type */
+      break;
     FALLTHROUGH();
   case PL_UNIX_FILETYPE:
     result = unix_filetype(c, &finfo->filetype);
