From 3c62111b0b975afc4f1a27baa7bbd93fb6d5177a Mon Sep 17 00:00:00 2001
From: Cameron Sparks <cam@sparksd.net>
Date: Thu, 12 Nov 2026 23:15:18 -0500
Subject: [PATCH] headers: clear headerout when the header list is reset

curl_easy_nextheader() follows the anchor of the struct curl_header
passed in as prev. The anchor points into data->state.httphdrs, which is
freed when the list is torn down, but headerout[] kept the old anchors.
A stale header from an earlier transfer on the same handle then made
curl_easy_nextheader() read a freed node.

Zero data->state.headerout in headers_reset(), so a stale prev has a
NULL anchor and curl_easy_nextheader() returns NULL.

Add test 1949, which uses a header from a previous transfer.
Closes #23935

Upstream: https://github.com/curl/curl/commit/3c62111b0b975afc4f1a27baa7bbd93fb6d5177a
---
 lib/headers.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/lib/headers.c b/lib/headers.c
index 438eb54..64c41aa 100644
--- a/lib/headers.c
+++ b/lib/headers.c
@@ -403,6 +403,7 @@ static void headers_reset(struct Curl_easy *data)
 {
   Curl_llist_init(&data->state.httphdrs, NULL);
   data->state.nh_count = 0;
+  memset(data->state.headerout, 0, sizeof(data->state.headerout));
 }
 
 struct hds_cw_collect_ctx {
