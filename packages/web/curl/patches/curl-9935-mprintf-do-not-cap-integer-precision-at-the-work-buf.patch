From 24224928309dbc2d9018b0cb991722764bab7cd2 Mon Sep 17 00:00:00 2001
From: Martin Mirchev <mmirchev@comp.nus.edu.sg>
Date: Tue, 27 Oct 2026 10:36:53 +0800
Subject: [PATCH] mprintf: do not cap integer precision at the work buffer size

out_number() wrote the zeros for the precision into the 326-byte work
buffer and stopped when it was full, but reduced the field width by the
full precision. "%.400d" gave 325 digits, and "%410.400d" 335 bytes
instead of 410.

Output the zeros with stream_pad() instead, as the padding is.

Extend test 557.

Closes #24028

Upstream: https://github.com/curl/curl/commit/24224928309dbc2d9018b0cb991722764bab7cd2
---
 lib/mprintf.c | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/lib/mprintf.c b/lib/mprintf.c
index 9f172c3..f5b7282 100644
--- a/lib/mprintf.c
+++ b/lib/mprintf.c
@@ -914,11 +914,9 @@ static bool out_number(void *userp,
     --width;
   }
 
-  if(prec > 0) {
+  if(prec > 0)
+    /* the precision zeros are output right before the digits */
     width -= prec;
-    while(prec-- > 0 && w >= work)
-      *w-- = '0';
-  }
 
   if(is_alt && base == 16)
     width -= 2;
@@ -953,8 +951,9 @@ static bool out_number(void *userp,
     width = 0;
   }
 
-  /* Write the number. */
-  if(stream_run(userp, stream, streamn, (const unsigned char *)w + 1,
+  /* Write the precision zeros and the number. */
+  if(stream_pad(userp, stream, streamn, '0', prec, donep) ||
+     stream_run(userp, stream, streamn, (const unsigned char *)w + 1,
                 (size_t)(workend - w), donep))
     return TRUE;
 
