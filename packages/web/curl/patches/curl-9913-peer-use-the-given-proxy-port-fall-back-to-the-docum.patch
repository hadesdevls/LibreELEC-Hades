From 31c911efe5652725e930f4d2e60c9060e5f6646d Mon Sep 17 00:00:00 2001
From: Victor Hugo <victorhugomacedopaesleme@yahoo.com.br>
Date: Fri, 30 Oct 2026 02:29:44 -0300
Subject: [PATCH] peer: use the given proxy port, fall back to the documented
 default

Since bc40e09f63 the proxy port is read with CURLU_NO_DEFAULT_PORT,
which drops an explicit port when it matches the default port of the
proxy URL's scheme. A proxy string without a scheme is guessed as http,
so "--socks5 host:80" ended up connecting to port 1080, and an explicit
port lost against CURLOPT_PROXYPORT when it happened to be the scheme
default.

The fallback also became the scheme's default port, so a plain HTTP
proxy without a port used 80 instead of the documented 1080.

Use the port as given, otherwise CURLOPT_PROXYPORT, or 443 for https
default, or 1080 for all others as default, like before.

Extend unit test 2413 to verify.

Follow-up to bc40e09f63.

Fixes https://github.com/curl/curl/issues/23681
Closes https://github.com/curl/curl/pull/23682
---
 lib/peer.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/lib/peer.c b/lib/peer.c
index b01907e..5218091 100644
--- a/lib/peer.c
+++ b/lib/peer.c
@@ -676,7 +676,7 @@ CURLcode Curl_peer_from_proxy_url(CURLU *uh,
     goto out;
   }
 
-  uc = curl_url_get(uh, CURLUPART_PORT, &portptr, CURLU_NO_DEFAULT_PORT);
+  uc = curl_url_get(uh, CURLUPART_PORT, &portptr, 0);
   if(uc == CURLUE_OUT_OF_MEMORY) {
     result = CURLE_OUT_OF_MEMORY;
     goto out;
@@ -690,11 +690,13 @@ CURLcode Curl_peer_from_proxy_url(CURLU *uh,
     curlx_free(portptr);
   }
   else {
-    /* No port in URL, take the set one or the scheme's default */
+    /* No port in URL, take the set one or the proxy default */
     if(data->set.proxyport)
       pp.port = data->set.proxyport;
+    else if(CURL_PROXY_IS_HTTPS(proxytype))
+      pp.port = CURL_DEFAULT_HTTPS_PROXY_PORT;
     else
-      pp.port = pp.scheme->defport;
+      pp.port = CURL_DEFAULT_PROXY_PORT;
   }
 
   /* now, clone the proxy hostname */
