From 9f8e42c7bb8897efe4cb792f0d11a88fdd95809e Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Sat, 14 Nov 2026 23:38:28 +0100
Subject: [PATCH] hsts: drop the length check (from live headers)

The limit still applies when the name is provided from file or callback.

Reported by Anthropic's OSS Scanner ANT-2026-H0Z93AA6

Fixes #23819
Closes #23948

Upstream: https://github.com/curl/curl/commit/9f8e42c7bb8897efe4cb792f0d11a88fdd95809e
---
 lib/hsts.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/hsts.c b/lib/hsts.c
index 1cce1e5..621416f 100644
--- a/lib/hsts.c
+++ b/lib/hsts.c
@@ -172,7 +172,7 @@ UNITTEST struct stsentry *hsts_check(struct hsts *h, const char *hostname,
     struct Curl_llist_node *n;
     size_t blen = 0;
 
-    if((hlen > MAX_HSTS_HOSTLEN) || !hlen)
+    if(!hlen)
       return NULL;
     if(hostname[hlen - 1] == '.')
       /* remove the trailing dot */
