From f29c5d3fa03e2b91d933fd287b8c592dac47db61 Mon Sep 17 00:00:00 2001
From: Rhino <195818135+1rhino2@users.noreply.github.com>
Date: Sat, 17 Oct 2026 18:28:39 -0400
Subject: [PATCH] cw-pause: only pass EOS with the last flushed piece

cw_pause_write() strips CLIENTWRITE_EOS from every piece but the last
when it splits a body write into CW_PAUSE_DEC_WRITE_CHUNK sized pieces,
but cw_pause_flush() passed the buffer's type unchanged on each flushed
piece, so a buffered EOS write was flushed as several EOS writes. Keep
EOS for the last piece of the last buffer only.

Closes #23461

(cherry picked from commit f29c5d3fa03e2b91d933fd287b8c592dac47db61)
---
 lib/cw-pause.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/lib/cw-pause.c b/lib/cw-pause.c
index c7afb6a..d5026f9 100644
--- a/lib/cw-pause.c
+++ b/lib/cw-pause.c
@@ -113,12 +113,16 @@ static CURLcode cw_pause_flush_do(struct Curl_easy *data,
     const unsigned char *buf = NULL;
 
     if(Curl_bufq_peek(&first->b, &buf, &blen)) {
+      int wtype = first->type;
       wlen = (first->type & CLIENTWRITE_BODY) ?
              CURLMIN(blen, CW_PAUSE_DEC_WRITE_CHUNK) : blen;
-      result = Curl_cwriter_write(data, cw_pause->next, first->type,
+      /* EOS only goes with the very last piece, same as in cw_pause_write */
+      if((wlen < Curl_bufq_len(&first->b)) || first->next)
+        wtype &= ~CLIENTWRITE_EOS;
+      result = Curl_cwriter_write(data, cw_pause->next, wtype,
                                   (const char *)buf, wlen);
       CURL_TRC_WRITE(data, "[PAUSE] flushed %zu/%zu bytes, type=%x -> %d",
-                     wlen, ctx->buf_total, (unsigned int)first->type,
+                     wlen, ctx->buf_total, (unsigned int)wtype,
                      (int)result);
       Curl_bufq_skip(&first->b, wlen);
       DEBUGASSERT(ctx->buf_total >= wlen);
-- 
