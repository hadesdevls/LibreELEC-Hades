From 240094493125dd083c938ff12204b0210d1f35d2 Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Sun, 22 Nov 2026 22:58:43 +0100
Subject: [PATCH] http: ignore location handling in 1xx responses

To avoid getting fooled by any such headers in 1xx responses.

Verify in test 1816

Reported-by: Bhabani Sankar Das
Fixes #24093
Closes #24097

Upstream: https://github.com/curl/curl/commit/240094493125dd083c938ff12204b0210d1f35d2
---
 lib/http.c | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/lib/http.c b/lib/http.c
index 73424d7..7ead5f5 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -3431,7 +3431,7 @@ static CURLcode http_header_l(struct Curl_easy *data,
       data->info.filetime = k->timeofdoc;
     return CURLE_OK;
   }
-  if(HD_IS(hd, hdlen, "Location:")) {
+  if(HD_IS(hd, hdlen, "Location:") && (k->httpcode/100 >= 2)) {
     /* this is the URL that the server advises us to use instead */
     char *location = Curl_copy_header_value(hd);
     if(!location)
@@ -3451,8 +3451,7 @@ static CURLcode http_header_l(struct Curl_easy *data,
       }
       data->req.location = location;
 
-      if((k->httpcode >= 300 && k->httpcode < 400) &&
-         data->set.http_follow_mode) {
+      if(data->set.http_follow_mode && (k->httpcode/100 == 3)) {
         CURLcode result;
         DEBUGASSERT(!data->req.newurl);
         data->req.newurl = curlx_strdup(data->req.location); /* clone */
