From a70bdea4742d9dd9c09621a6a95e589f2a5046a6 Mon Sep 17 00:00:00 2001
From: Cameron Sparks <cam@sparksd.net>
Date: Thu, 12 Nov 2026 22:12:23 -0500
Subject: [PATCH] http: detach borrowed headers from mime part on error

set_post_reader attaches the borrowed data->set.headers to the top-level
mime part for Curl_mime_prepare_headers(). If that call failed, it
returned early and left the pointer in the part. Once the application
freed its list, curl_easy_duphandle() read freed memory.

Detach the list right after Curl_mime_prepare_headers(), before the
result check, so every exit path leaves the part without it.

Add test 3598, which fails the transfer, frees the list and duplicates
the handle.

Closes #23918

Upstream: https://github.com/curl/curl/commit/a70bdea4742d9dd9c09621a6a95e589f2a5046a6
---
 lib/http.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/http.c b/lib/http.c
index 016e42c..25cf1f4 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -2337,9 +2337,9 @@ static CURLcode set_post_reader(struct Curl_easy *data, Curl_HttpReq httpreq)
       curl_mime_headers(data->state.mimepost, data->set.headers, 0);
       result = Curl_mime_prepare_headers(data, data->state.mimepost, cthdr,
                                          NULL, MIMESTRATEGY_FORM);
+      curl_mime_headers(data->state.mimepost, NULL, 0);
       if(result)
         return result;
-      curl_mime_headers(data->state.mimepost, NULL, 0);
       result = Curl_creader_set_mime(data, data->state.mimepost);
       if(result)
         return result;
