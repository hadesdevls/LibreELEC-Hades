From 6d303dfc1170a1c2e30358f4c188b824ce8acdc5 Mon Sep 17 00:00:00 2001
From: Max Dymond <cmeister2@gmail.com>
Date: Fri, 30 Oct 2026 08:55:07 +0000
Subject: [PATCH] openssl: stop I/O after fatal shutdown errors

Classify negative SSL_shutdown() results before continuing. Treat
SSL_ERROR_SSL and SSL_ERROR_SYSCALL as terminal and end the
best-effort shutdown without another TLS I/O call on the SSL object.

Do not pass a zero SSL_shutdown() result to SSL_get_error(). Zero
means shutdown is still in progress. Preserve the existing WANT_READ
and WANT_WRITE behavior.

Add a unit test using a real TLS connection and a failing BIO to
check that curl does not read after a terminal shutdown error.

Bug: https://gist.github.com/cmeister2/ef763a8464826adb3c61823b9f5e5710
Closes #23686
---
 lib/vtls/openssl.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index 0ce51cf..517f9c2 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -1914,10 +1914,24 @@ static CURLcode ossl_shutdown(struct Curl_cfilter *cf,
       *done = TRUE;
       goto out;
     }
-    if(SSL_get_error(octx->ssl, rc) == SSL_ERROR_WANT_WRITE) {
-      CURL_TRC_CF(data, cf, "SSL shutdown still wants to send");
-      connssl->io_need = CURL_SSL_IO_NEED_SEND;
-      goto out;
+    if(rc < 0) {
+      err = SSL_get_error(octx->ssl, rc);
+      if(err == SSL_ERROR_WANT_WRITE) {
+        CURL_TRC_CF(data, cf, "SSL shutdown still wants to send");
+        connssl->io_need = CURL_SSL_IO_NEED_SEND;
+        goto out;
+      }
+      if(err != SSL_ERROR_WANT_READ) {
+        VERBOSE(unsigned long sslerr = ERR_get_error());
+        CURL_TRC_CF(data, cf,
+                    "SSL shutdown, ignore send error: %s (%s), errno %d",
+                    SSL_ERROR_to_str(err),
+                    (sslerr ? ossl_strerror(sslerr, buf, sizeof(buf)) :
+                     "no OpenSSL error"),
+                    SOCKERRNO);
+        *done = TRUE;
+        goto out;
+      }
     }
     /* Having sent the close notify, we use SSL_read() to get the
      * missing close notify from the server. */
