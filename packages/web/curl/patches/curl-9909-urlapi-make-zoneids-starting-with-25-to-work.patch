From a7023cafb8912176706f98481e3bab6283ff11fd Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Wed, 28 Oct 2026 23:08:35 +0100
Subject: [PATCH] urlapi: make zoneids starting with 25 to work

Regression from 04afd160767d22 shipped in 8.21.0

Verified in test 1560

Fixes #23658
Reported-by: Dilshod Urazov
Closes #23664
---
 lib/urlapi.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/lib/urlapi.c b/lib/urlapi.c
index a70b778..9d5e84d 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -481,9 +481,6 @@ UNITTEST CURLUcode ipv6_parse(struct Curl_URL *u, char *hostname,
       char zoneid[MAX_ZONEID_LEN];
       int i = 0;
       char *h = &hostname[len + 1];
-      /* pass '25' if present and is a URL encoded percent sign */
-      if(!strncmp(h, "25", 2) && h[2] && (h[2] != ']'))
-        h += 2;
       while(!invalid_host_char[(unsigned char)*h] && (*h != ']') &&
             (i < (MAX_ZONEID_LEN - 1)))
         zoneid[i++] = *h++;
