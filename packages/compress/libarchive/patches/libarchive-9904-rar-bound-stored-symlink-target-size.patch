From ef743732590996862e6858a41e069ae1717c667c Mon Sep 17 00:00:00 2001
From: Eduard Zateev <hackerowskiy@gmail.com>
Date: Sun, 18 Oct 2026 13:53:40 +0200
Subject: [PATCH] rar: bound stored symlink target size

Signed-off-by: Eduard Zateev <hackerowskiy@gmail.com>

(cherry picked from commit ef743732590996862e6858a41e069ae1717c667c)
---
 libarchive/archive_read_support_format_rar.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/libarchive/archive_read_support_format_rar.c b/libarchive/archive_read_support_format_rar.c
index 61baeef..aeb1140 100644
--- a/libarchive/archive_read_support_format_rar.c
+++ b/libarchive/archive_read_support_format_rar.c
@@ -89,6 +89,8 @@
 #define FHD_EXTTIME      0x1000
 #define FHD_EXTFLAGS     0x2000
 
+#define RAR_MAX_SYMLINK_SIZE (1024 * 1024)
+
 /* File dictionary sizes */
 #define DICTIONARY_SIZE_64   0x00
 #define DICTIONARY_SIZE_128  0x20
@@ -1969,7 +1971,7 @@ read_symlink_stored(struct archive_read *a, struct archive_entry *entry,
   const char *p;
   int ret = (ARCHIVE_OK);
 
-  if ((uintmax_t)rar->packed_size > SIZE_MAX)
+  if (rar->packed_size > RAR_MAX_SYMLINK_SIZE)
   {
     archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
                       "Unable to read link");
-- 
2.53.0

