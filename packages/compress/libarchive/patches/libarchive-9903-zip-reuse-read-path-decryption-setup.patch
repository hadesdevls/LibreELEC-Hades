From dad01e1484a0061f0e18d2ba690f3e3797a39203 Mon Sep 17 00:00:00 2001
From: iPlayForSG <88138517+iPlayForSG@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:46:10 +0800
Subject: [PATCH] zip: reuse read path decryption setup

---
 libarchive/archive_read_support_format_zip.c | 20 +-------------------
 1 file changed, 1 insertion(+), 19 deletions(-)

diff --git a/libarchive/archive_read_support_format_zip.c b/libarchive/archive_read_support_format_zip.c
index c43fe73d3d01..55851e54a0ec 100644
--- a/libarchive/archive_read_support_format_zip.c
+++ b/libarchive/archive_read_support_format_zip.c
@@ -3976,25 +3976,7 @@ archive_read_format_zip_read_data_skip_streamable(struct archive_read *a)
 		return (ARCHIVE_OK);
 	}
 
-	if (zip->init_decryption) {
-		int r;
-
-		zip->has_encrypted_entries = 1;
-		if (zip->entry->zip_flags & ZIP_STRONG_ENCRYPTED)
-			r = read_decryption_header(a);
-		else if (zip->entry->compression == WINZIP_AES_ENCRYPTION)
-			r = init_WinZip_AES_decryption(a);
-		else
-			r = init_traditional_PKWARE_decryption(a);
-		if (r != ARCHIVE_OK)
-			return (r);
-		zip->init_decryption = 0;
-	}
-
-	/* We are streaming and do not know the length.  Use the normal data
-	 * path so a candidate descriptor is accepted only after its CRC and
-	 * sizes match the bytes that were actually decoded.  Signature-only
-	 * scanning lets descriptor-shaped entry data terminate skip early. */
+	/* Validate the descriptor against decoded CRC and sizes. */
 	while (!zip->end_of_entry) {
 		int64_t offset = 0;
 		const void *buff = NULL;
