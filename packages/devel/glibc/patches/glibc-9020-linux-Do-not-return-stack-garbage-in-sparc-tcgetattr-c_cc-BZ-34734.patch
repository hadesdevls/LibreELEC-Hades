From 045c51476c7abf6144815a4db44f51a118b4cb3e Mon Sep 17 00:00:00 2001
From: Stian Halseth <stian@itx.no>
Date: Sun, 11 Oct 2026 18:32:49 +0200
Subject: [PATCH] linux: Do not return stack garbage in sparc tcgetattr c_cc
 [BZ #34734]

The sparc kernel's struct termios2 declares 19 c_cc entries, but
TCGETS2 only writes the first 17 and TCSETS2 only reads them.  Since
the termios rework in glibc 2.42, tcgetattr copies all 19 from an
uninitialized struct termios2 on its stack, so c_cc[17] and c_cc[18]
return whatever was there before.  Two tcgetattr calls on the same
terminal can then disagree, which fails Python's test_termios and
test_tty.

Set _TERMIOS2_NCCS to 17 for sparc, as __KERNEL_NCCS was before 2.42.
The struct size and layout do not change, since c_ispeed is aligned to
4 bytes either way, and c_cc[17] onwards is filled with _POSIX_VDISABLE
again.

Add a test that calls tcgetattr twice with different stack contents
and compares the results.

Link: https://github.com/sparclinux/issues/issues/112
Signed-off-by: Stian Halseth <stian@itx.no>
Reviewed-by: Avinal Kumar <avinal.xlvii@gmail.com>

(cherry picked from commit e4080b50a38a9e07b6fb5d75f3786e36031d8bd2)
[LibreELEC Hades: the NEWS hunk of this commit is left out. NEWS is not
built, and the NEWS of this series differs from the branch.]
---
 sysdeps/unix/sysv/linux/Makefile              |  1 +
 sysdeps/unix/sysv/linux/sparc/termios_arch.h  |  5 +-
 sysdeps/unix/sysv/linux/tst-tcgetattr-stack.c | 68 +++++++++++++++++++
 4 files changed, 75 insertions(+), 1 deletion(-)
 create mode 100644 sysdeps/unix/sysv/linux/tst-tcgetattr-stack.c

diff --git a/sysdeps/unix/sysv/linux/Makefile b/sysdeps/unix/sysv/linux/Makefile
index 14a56d5..005847d 100644
--- a/sysdeps/unix/sysv/linux/Makefile
+++ b/sysdeps/unix/sysv/linux/Makefile
@@ -432,6 +432,7 @@ sysdep_headers += \
   # sysdep_headers
 
 tests += \
+  tst-tcgetattr-stack \
   tst-termios-linux \
   # tests
 endif
diff --git a/sysdeps/unix/sysv/linux/sparc/termios_arch.h b/sysdeps/unix/sysv/linux/sparc/termios_arch.h
index ce83698..b230424 100644
--- a/sysdeps/unix/sysv/linux/sparc/termios_arch.h
+++ b/sysdeps/unix/sysv/linux/sparc/termios_arch.h
@@ -17,7 +17,10 @@
    License along with the GNU C Library; if not, see
    <https://www.gnu.org/licenses/>.  */
 
-#define _TERMIOS2_NCCS 19
+/* The kernel's struct termios2 has 19 c_cc entries, but TCGETS2 and
+   TCSETS2 only transfer the first 17.  The size and layout are the same
+   either way, since c_ispeed is aligned to 4 bytes.  */
+#define _TERMIOS2_NCCS 17
 #define _HAVE_TERMIOS2_C_CC_BEFORE_C_LINE 0
 
 #define _HAVE_STRUCT_OLD_TERMIOS 1
diff --git a/sysdeps/unix/sysv/linux/tst-tcgetattr-stack.c b/sysdeps/unix/sysv/linux/tst-tcgetattr-stack.c
new file mode 100644
index 0000000..b3cace6
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/tst-tcgetattr-stack.c
@@ -0,0 +1,68 @@
+/* Check that tcgetattr does not return uninitialized stack contents.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <support/check.h>
+#include <support/tty.h>
+
+/* Fill the stack below the caller with PATTERN, so that whatever
+   tcgetattr leaves uninitialized in its own frame differs between
+   two calls.  */
+static void __attribute__ ((noinline, noclone))
+dirty_stack (int pattern)
+{
+  char buf[4096];
+  memset (buf, pattern, sizeof buf);
+  __asm__ volatile ("" : : "r" (buf) : "memory");
+}
+
+static void
+get (int fd, int pattern, struct termios *tio)
+{
+  memset (tio, pattern, sizeof *tio);
+  dirty_stack (pattern);
+  TEST_COMPARE (tcgetattr (fd, tio), 0);
+}
+
+static int
+do_test (void)
+{
+  struct termios a, b;
+  int outer, inner;
+
+  support_openpty (&outer, &inner, NULL, NULL, NULL);
+
+  get (inner, 0x5a, &a);
+  get (inner, 0xa5, &b);
+  TEST_COMPARE_BLOB (&a, sizeof a, &b, sizeof b);
+
+  cfmakeraw (&a);
+  TEST_COMPARE (tcsetattr (inner, TCSANOW, &a), 0);
+  get (inner, 0x5a, &a);
+  get (inner, 0xa5, &b);
+  TEST_COMPARE_BLOB (&a, sizeof a, &b, sizeof b);
+
+  close (inner);
+  close (outer);
+  return 0;
+}
+
+#include <support/test-driver.c>
