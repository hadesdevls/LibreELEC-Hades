From b21dfcc4121b9a1b46e6f3cdafa6994824ed6fb0 Mon Sep 17 00:00:00 2001
From: Adhemerval Zanella <adhemerval.zanella@linaro.org>
Date: Wed, 11 Nov 2026 15:26:05 -0300
Subject: [PATCH] posix: Fix double free after allocation failure in glob (BZ
 34993)

prefix_array prepends the directory name to each match in place.  If an
allocation fails partway through, it frees the names it has already
replaced but leaves them in the vector.  All of its callers then
release the vector with globfree, which frees those names again.

Checked on x86_64-linux-gnu.

Reviewed-by: Yury Khrustalev <yury.khrustalev@arm.com>
Tested-by: Yury Khrustalev <yury.khrustalev@arm.com>
[LibreELEC Hades: from master, b21dfcc, which release/2.44/master does not have
yet (GLIBC-SA-2026-0032, CVE-2026-126765). Only posix/glob.c: the new test
(tst-glob-nospace.c and its line in posix/Makefile, whose context differs in
2.44) is left out; the tests are not built.]
---
 posix/glob.c | 25 ++++++++++++-------------
 1 file changed, 12 insertions(+), 13 deletions(-)

diff --git a/posix/glob.c b/posix/glob.c
index 2e484ca..4f7ae7c 100644
--- a/posix/glob.c
+++ b/posix/glob.c
@@ -1625,7 +1625,10 @@ collated_compare (const void *a, const void *b)
 /* Prepend DIRNAME to each of N members of ARRAY, replacing ARRAY's
    elements in place.  Return nonzero if out of memory, zero if successful.
    A slash is inserted between DIRNAME and each elt of ARRAY,
-   unless DIRNAME is just "/".  Each old element of ARRAY is freed.  */
+   unless DIRNAME is just "/".  Each old element of ARRAY is freed.
+   If out of memory, ARRAY keeps the elements already replaced and the
+   original ones after them, so the caller can free all of them with
+   globfree.  */
 static int
 prefix_array (const char *dirname, char **array, size_t n)
 {
@@ -1657,20 +1660,16 @@ prefix_array (const char *dirname, char **array, size_t n)
     {
       size_t eltlen = strlen (array[i]) + 1;
       char *new = malloc (dirlen + 1 + eltlen);
-      if (new == NULL)
+      if (new != NULL)
         {
-          while (i > 0)
-            free (array[--i]);
-          return 1;
+          char *endp = mempcpy (new, dirname, dirlen);
+          *endp++ = dirsep_char;
+          mempcpy (endp, array[i], eltlen);
+          free (array[i]);
+          array[i] = new;
         }
-
-      {
-        char *endp = mempcpy (new, dirname, dirlen);
-        *endp++ = dirsep_char;
-        mempcpy (endp, array[i], eltlen);
-      }
-      free (array[i]);
-      array[i] = new;
+      else
+        return 1;
     }
 
   return 0;
