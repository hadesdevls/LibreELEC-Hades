From 3d15d5591af45f3893bdfd3428d88ff21c58c98a Mon Sep 17 00:00:00 2001
From: Wilco Dijkstra <wilco.dijkstra@arm.com>
Date: Wed, 28 Oct 2026 19:58:31 +0000
Subject: [PATCH 9072/9073] malloc: Preserve errno in tcache_free_init [BZ
 #34890]

After changing the tcache initialization, tcache_init() may be called from
__libc_free().  Since it does a malloc which could fail in rare cases and
set errno, preserve errno in tcache_free_init().  This fixes BZ #34890.

Reviewed-by: DJ Delorie <dj@redhat.com>
(cherry picked from commit 6049d099387b29dfd03b2d4b01209f6776e32374)
---
 malloc/malloc.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/malloc/malloc.c b/malloc/malloc.c
index a50ff3598..84b7df72c 100644
--- a/malloc/malloc.c
+++ b/malloc/malloc.c
@@ -3128,7 +3128,10 @@ libc_hidden_def (__libc_malloc)
 static void __attribute_noinline__
 tcache_free_init (void *mem)
 {
+  /* Preserve errno in case malloc in tcache_init sets it.  */
+  int err = errno;
   tcache_init (NULL);
+  __set_errno (err);
   __libc_free (mem);
 }
 
