From a0b0ef791e0c74670097917c0c2196ac6c9de765 Mon Sep 17 00:00:00 2001
From: Dylan Fleming <Dylan.Fleming@arm.com>
Date: Wed, 4 Nov 2026 15:06:40 +0000
Subject: [PATCH] aarch64: Fix SVE tanf mixed-lane results [BZ #34922]

The special-case path reciprocates every lane before calling scalar tanf
for large inputs. This also changes ordinary lanes which do not need the
reciprocal, so inputs [0.0f, 0x1p15f, ...] return infinity in the first
lane instead of zero.

Fixed by passing the alternate-lane predicate to special_case and selecting
the reciprocal only where needed before handling the special lanes.

Reviewed-by: Adhemerval Zanella  <adhemerval.zanella@linaro.org>
(cherry picked from commit 2adca4525327d0321570fda9cdab6e16fa24dba9)
[LibreELEC Hades: the NEWS hunk of this commit is left out. NEWS is not
built, and the NEWS of this series differs from the branch.]
---
 SHARED-FILES                   | 2 +-
 sysdeps/aarch64/fpu/sve/tanf.c | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/SHARED-FILES b/SHARED-FILES
index edf860562841..9f17c6bf4802 100644
--- a/SHARED-FILES
+++ b/SHARED-FILES
@@ -570,7 +570,7 @@ arm-optimized-routines:
   sysdeps/aarch64/fpu/sve/sinpif.c
   # math/aarch64/sve/tan.c, revision 1aad38d
   sysdeps/aarch64/fpu/sve/tan.c
-  # math/aarch64/sve/tanf.c, revision 1aad38d
+  # math/aarch64/sve/tanf.c, revision 5e51e52
   sysdeps/aarch64/fpu/sve/tanf.c
   # math/aarch64/sve/tanh.c, revision 1aad38d
   sysdeps/aarch64/fpu/sve/tanh.c
diff --git a/sysdeps/aarch64/fpu/sve/tanf.c b/sysdeps/aarch64/fpu/sve/tanf.c
index 60d93fd7e255..4a627d31e03b 100644
--- a/sysdeps/aarch64/fpu/sve/tanf.c
+++ b/sysdeps/aarch64/fpu/sve/tanf.c
@@ -47,8 +47,10 @@ static const struct data
 };
 
 static svfloat32_t NOINLINE
-special_case (svfloat32_t x, svfloat32_t y, svbool_t cmp)
+special_case (svfloat32_t x, svfloat32_t y, svbool_t cmp, svbool_t pred_alt)
 {
+  svfloat32_t inv_y = svdivr_x (svptrue_b32 (), y, 1.0f);
+  y = svsel (pred_alt, inv_y, y);
   return sv_call_f32 (tanf, x, y, cmp);
 }
 
@@ -107,7 +109,7 @@ svfloat32_t SV_NAME_F1 (tan) (svfloat32_t x, const svbool_t pg)
   /* Determine whether input is too large to perform fast regression.  */
   svbool_t cmp = svacge (pg, x, d->range_val);
   if (__glibc_unlikely (svptest_any (pg, cmp)))
-    return special_case (x, svdivr_x (pg, y, 1.0f), cmp);
+    return special_case (x, y, cmp, pred_alt);
 
   svfloat32_t inv_y = svdivr_x (pg, y, 1.0f);
   return svsel (pred_alt, inv_y, y);
-- 
