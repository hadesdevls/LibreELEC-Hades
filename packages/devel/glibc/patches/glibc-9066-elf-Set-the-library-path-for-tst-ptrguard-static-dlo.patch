From c5c6fc6f449dbc95e3a68cacd61852dc0a48e57c Mon Sep 17 00:00:00 2001
From: Adhemerval Zanella <adhemerval.zanella@linaro.org>
Date: Fri, 6 Nov 2026 13:18:01 -0300
Subject: [PATCH] elf: Set the library path for tst-ptrguard-static-dlopen (BZ
 34966)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The test is statically linked and dlopens its module by name.

Checked on x86_64-linux-gnu and aarch64-linux-gnu.

Suggested-by: João Reis <joaosreis@outlook.pt>
(cherry picked from commit 4e465e5c3ed634f71690e1fb40ea91c49a5fbae9)
[LibreELEC Hades: the NEWS hunk of this commit is left out. NEWS is not
built, and the NEWS of this series differs from the branch.]
---
 elf/Makefile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/elf/Makefile b/elf/Makefile
index a9cafed56da2..d3a8c485b8c3 100644
--- a/elf/Makefile
+++ b/elf/Makefile
@@ -3284,6 +3284,7 @@ tst-getauxval-static-ENV = LD_LIBRARY_PATH=$(objpfx):$(common-objpfx)
 
 $(objpfx)tst-ptrguard-static-dlopen.out: \
   $(objpfx)tst-ptrguard-static-dlopen-mod.so
+tst-ptrguard-static-dlopen-ENV = $(static-dlopen-environment)
 
 $(objpfx)tst-dlmopen-gethostbyname.out: $(objpfx)tst-dlmopen-gethostbyname-mod.so
 
-- 
2.53.0

