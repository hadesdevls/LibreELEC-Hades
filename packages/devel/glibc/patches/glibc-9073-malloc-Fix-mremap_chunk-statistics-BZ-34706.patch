From c90470a5a0964d33705ddb19544c04d5ae2b9822 Mon Sep 17 00:00:00 2001
From: Wilco Dijkstra <wilco.dijkstra@arm.com>
Date: Fri, 6 Nov 2026 18:28:51 +0000
Subject: [PATCH 9073/9073] malloc: Fix mremap_chunk statistics [BZ #34706]

Adjust counters based on the total size change of mapped memory in mremap_chunk.
This fixes BZ #34706.

Reviewed-by: DJ Delorie <dj@redhat.com>
(cherry picked from commit 03628c2f85acaab6ef71c37c954fd0707685e0f0)
---
 malloc/malloc.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/malloc/malloc.c b/malloc/malloc.c
index 84b7df72c..921291787 100644
--- a/malloc/malloc.c
+++ b/malloc/malloc.c
@@ -2658,7 +2658,6 @@ mremap_chunk (mchunkptr p, size_t new_size)
   bool is_hp = mmap_is_hp (p);
   size_t pagesize = is_hp ? mp_.hp_pagesize : GLRO (dl_pagesize);
   INTERNAL_SIZE_T offset = mmap_base_offset (p);
-  INTERNAL_SIZE_T size = chunksize (p);
   char *cp;
 
   assert (chunk_is_mmapped (p));
@@ -2678,7 +2677,7 @@ mremap_chunk (mchunkptr p, size_t new_size)
     return p;
 
   cp = (char *) __mremap ((char *) block, total_size, new_size,
-                          MREMAP_MAYMOVE);
+			  MREMAP_MAYMOVE);
 
   if (cp == MAP_FAILED)
     return NULL;
@@ -2691,8 +2690,8 @@ mremap_chunk (mchunkptr p, size_t new_size)
   p = mmap_set_chunk ((uintptr_t) cp, new_size, offset, is_hp);
 
   INTERNAL_SIZE_T new;
-  new = atomic_fetch_add_relaxed (&mp_.mmapped_mem, new_size - size - offset)
-        + new_size - size - offset;
+  new = atomic_fetch_add_relaxed (&mp_.mmapped_mem, new_size - total_size)
+	+ new_size - total_size;
   atomic_max (&mp_.max_mmapped_mem, new);
   return p;
 }
