From 991d11383a7536067a174ede52d33b7b085baad8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:49:05 +0000
Subject: [PATCH] displayid, displayid2: do not read the padding past the
 section

CVE-2026-112271. _di_displayid_parse() walks the data blocks with i and
computes max_data_block_size = section_size - 1 - i at the top of each
iteration. After the loop it checks the padding with
is_all_zeroes(&data[i], max_data_block_size). When the loop ends because
i reached section_size - 1 (the last data block ends at the checksum)
rather than through the zero-header break, max_data_block_size still
holds the size measured from the previous i, so the check reads
data[section_size - 1] (the checksum) and up to that many bytes after
it. When a data block declares more bytes than remain,
parse_data_block() records the failure and still returns the declared
size, so i jumps past the section and the same check starts reading
there. In both cases the read goes past the section and, for the last
extension block of an EDID, past the end of the EDID buffer: a heap
out-of-bounds read reachable from a crafted EDID (monitor, TV, KVM,
capture device, EDID file). is_all_zeroes() stops at the first non-zero
byte, so the read is short unless the bytes after the section are zero;
the checksum byte is usually non-zero, which also made a valid section
whose blocks fill it exactly report "Padding: Contains non-zero bytes".

Two changes, in displayid.c and in the identical code of displayid2.c
(DisplayID 2.x sections, same loop and same parse_data_block() skip):
- parse_data_block() returns the number of bytes that remain (size)
  instead of the declared length when the block does not fit, so i stops
  at section_size - 1; the failure is still recorded as before.
- after the loop, max_data_block_size is recomputed from the final i:
  section_size - 1 - i when i < section_size - 1, otherwise 0. When the
  loop left through the zero-header break the value is the one it
  already had.

Data blocks occupy [header, section_size - 1) and the checksum sits at
section_size - 1 (validate_checksum() covers section_size bytes), so the
padding is exactly the bytes from the final i up to the checksum, and
none when i is at the checksum.

Effect on callers: di_edid_parse() and di_info_parse_edid() (Kodi's
CDisplayInfo, di-edid-decode) get the same parsed data blocks; the only
visible difference is that a section filled exactly by its data blocks
no longer reports the spurious padding failure. Not fixed in
libdisplay-info's main as of 62a9346 (2026-08-31).
---
 displayid.c  | 5 ++++-
 displayid2.c | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/displayid.c b/displayid.c
index 26f208b..752a8b2 100644
--- a/displayid.c
+++ b/displayid.c
@@ -616,7 +616,8 @@ parse_data_block(struct di_displayid *displayid, const uint8_t *data,
 		add_failure(displayid,
 			    "The length of this DisplayID data block (%d) exceeds the number of bytes remaining (%zu)",
 			    data_block_size, size);
-		goto skip;
+		/* Consume what remains, never more than the section holds */
+		return (ssize_t) size;
 	}
 
 	data_block = calloc(1, sizeof(*data_block));
@@ -783,6 +784,8 @@ _di_displayid_parse(struct di_displayid *displayid, const uint8_t *data,
 		assert(data_block_size > 0);
 		i += (size_t) data_block_size;
 	}
+	/* The padding is what lies between the final i and the checksum */
+	max_data_block_size = i < section_size - 1 ? section_size - 1 - i : 0;
 	if (!is_all_zeroes(&data[i], max_data_block_size)) {
 		if (max_data_block_size < DISPLAYID_DATA_BLOCK_HEADER_SIZE)
 			add_failure(displayid,
diff --git a/displayid2.c b/displayid2.c
index 6ab9c7b..ede2a14 100644
--- a/displayid2.c
+++ b/displayid2.c
@@ -94,7 +94,8 @@ parse_data_block(struct di_displayid2 *displayid2, const uint8_t *data,
 		add_failure(displayid2,
 			    "The length of this DisplayID data block (%d) exceeds the number of bytes remaining (%zu)",
 			    data_block_size, size);
-		goto skip;
+		/* Consume what remains, never more than the section holds */
+		return (ssize_t) size;
 	}
 
 	data_block = calloc(1, sizeof(*data_block));
@@ -245,6 +246,8 @@ _di_displayid2_parse(struct di_displayid2 *displayid2, const uint8_t *data,
 		assert(data_block_size > 0);
 		i += (size_t) data_block_size;
 	}
+	/* The padding is what lies between the final i and the checksum */
+	max_data_block_size = i < section_size - 1 ? section_size - 1 - i : 0;
 	if (!is_all_zeroes(&data[i], max_data_block_size)) {
 		if (max_data_block_size < DISPLAYID2_DATA_BLOCK_HEADER_SIZE) {
 			add_failure(displayid2,
-- 
