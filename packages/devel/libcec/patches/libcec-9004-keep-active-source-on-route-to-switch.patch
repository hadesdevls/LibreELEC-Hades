From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 01:41:57 +0000
Subject: [PATCH] Keep the active source on a route to a switch that leads to
 it

libcec-9001 marks this system's devices as inactive sources when a
<Routing Change>, <Routing Information> or <Set Stream Path> names another
known device. Where that device is a switch that this system is connected
through - an AV receiver on an input of the TV, with this system on an input
of the receiver - the route still leads here: the TV selected the input of
the receiver, and the receiver answers with <Routing Information> for the
input that it shows. Until then this system was made inactive and active
again, and Kodi's CEC adapter paused or stopped the video on the first
("Pause or stop playback when switching to another source") and could not
resume a stopped one.

A route to an address whose path includes this device's own address
(CCECTypeUtils::RouteLeadsTo(), from PhysicalAddressIsIncluded()) now leaves
it the active source; the switch's answer decides, as it did before
libcec-9001. A route to the TV's own address (0.0.0.0), the TV's own
picture, is not one: it makes this system inactive, as any other device
does. Each such decision is logged at NOTICE level, which Kodi's log shows.
---
 src/libcec/CECTypeUtils.h                        | 12 ++++++++++++
 src/libcec/devices/CECBusDevice.cpp              |  8 +++++++-
 src/libcec/implementations/CECCommandHandler.cpp |  8 +++++++-
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/libcec/CECTypeUtils.h b/src/libcec/CECTypeUtils.h
index f6c85e9..f4fbe9a 100644
--- a/src/libcec/CECTypeUtils.h
+++ b/src/libcec/CECTypeUtils.h
@@ -794,6 +794,18 @@ namespace CEC
       return true;
     }
 
+    /*!
+     * @brief Whether a route to iRoute can still lead to the device at iDevice: iRoute is a switch on its way
+     *        there (an AV receiver that it is connected through), which answers <Routing Information> with the
+     *        input that it shows. The TV's own address (0.0.0.0) is not: a route there is the TV's own picture.
+     */
+    static bool RouteLeadsTo(uint16_t iRoute, uint16_t iDevice)
+    {
+      return iRoute != 0 && iRoute != CEC_INVALID_PHYSICAL_ADDRESS &&
+             iDevice != CEC_INVALID_PHYSICAL_ADDRESS && iRoute != iDevice &&
+             PhysicalAddressIsIncluded(iRoute, iDevice);
+    }
+
     static std::string ToString(const cec_command& command)
     {
       std::string dataStr;
diff --git a/src/libcec/devices/CECBusDevice.cpp b/src/libcec/devices/CECBusDevice.cpp
index 4ace6f2..95a44d2 100644
--- a/src/libcec/devices/CECBusDevice.cpp
+++ b/src/libcec/devices/CECBusDevice.cpp
@@ -1290,7 +1290,13 @@ void CCECBusDevice::SetActiveRoute(uint16_t iRoute)
     CECDEVICEVEC myDevices;
     map->GetLibCECControlled(myDevices);
     for (CECDEVICEVEC::iterator it = myDevices.begin(); it != myDevices.end(); it++)
-      (*it)->MarkAsInactiveSource();
+    {
+      // but not where the route is a switch that we are connected through: it says next where it routes
+      if (CCECTypeUtils::RouteLeadsTo(iRoute, (*it)->GetCurrentPhysicalAddress()))
+        LIB_CEC->AddLog(CEC_LOG_NOTICE, "routing changed to %04x, which leads to %s (%04x): it stays the active source until that device says where it routes", iRoute, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
+      else
+        (*it)->MarkAsInactiveSource();
+    }
   }
 }
 
diff --git a/src/libcec/implementations/CECCommandHandler.cpp b/src/libcec/implementations/CECCommandHandler.cpp
index a8e01b1..59b6a39 100644
--- a/src/libcec/implementations/CECCommandHandler.cpp
+++ b/src/libcec/implementations/CECCommandHandler.cpp
@@ -675,7 +675,13 @@ int CCECCommandHandler::HandleSetStreamPath(const cec_command &command)
         CECDEVICEVEC myDevices;
         m_processor->GetDevices()->GetLibCECControlled(myDevices);
         for (CECDEVICEVEC::iterator it = myDevices.begin(); it != myDevices.end(); it++)
-          (*it)->MarkAsInactiveSource();
+        {
+          // but not where the path is a switch that we are connected through
+          if (CCECTypeUtils::RouteLeadsTo(iStreamAddress, (*it)->GetCurrentPhysicalAddress()))
+            LIB_CEC->AddLog(CEC_LOG_NOTICE, "stream path set to %04x, which leads to %s (%04x): it stays the active source", iStreamAddress, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
+          else
+            (*it)->MarkAsInactiveSource();
+        }
       }
       return COMMAND_HANDLED;
     }
