From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:07:23 +0000
Subject: [PATCH] Stop a worker thread in the destructor of its own class

CThread's destructor stops the thread, but by then the destructor of the
class whose Process() the thread runs has already finished: the thread
goes on in Process() of an object whose part that holds it is gone, and
reads its virtual table as it is being rewritten. Close() deletes the
standby protection of the processor and the ping thread of the Pulse-Eight
adapter while they run, at every close; the processor's destructor does
the same with a logical address allocation that is still running.

The destructors of CCECStandbyProtection, CAdapterPingThread,
CCECAllocateLogicalAddress and CAdapterEepromWriteThread stop their thread
first, as the other workers of libCEC do. Each of these threads already
had to end before its object could go, so a close waits no longer than
before.

Tests (outside the tree): libCEC built on the host with ThreadSanitizer,
opened and closed through a Pulse-Eight adapter emulated on a pseudo
terminal (a data race on the virtual table of both threads at each close
before, none after).
---
 src/libcec/CECProcessor.cpp                                | 6 +++++-
 src/libcec/CECProcessor.h                                  | 2 ++
 .../adapter/Pulse-Eight/USBCECAdapterCommunication.h       | 7 +++++--
 3 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/libcec/CECProcessor.cpp b/src/libcec/CECProcessor.cpp
index 8497384..927a689 100644
--- a/src/libcec/CECProcessor.cpp
+++ b/src/libcec/CECProcessor.cpp
@@ -58,7 +58,11 @@ using namespace CEC;
 
 CCECStandbyProtection::CCECStandbyProtection(CCECProcessor* processor) :
     m_processor(processor) {}
-CCECStandbyProtection::~CCECStandbyProtection(void) {}
+CCECStandbyProtection::~CCECStandbyProtection(void)
+{
+  // the thread runs Process() of this class: stop it before this part of the object is gone
+  StopThread(0);
+}
 
 void* CCECStandbyProtection::Process(void)
 {
diff --git a/src/libcec/CECProcessor.h b/src/libcec/CECProcessor.h
index cb3d8e9..8c1aa83 100644
--- a/src/libcec/CECProcessor.h
+++ b/src/libcec/CECProcessor.h
@@ -67,6 +67,8 @@ namespace CEC
   {
   public:
     CCECAllocateLogicalAddress(CCECProcessor* processor, CECClientPtr client);
+    // the thread runs Process() of this class: stop it before this part of the object is gone
+    virtual ~CCECAllocateLogicalAddress(void) { StopThread(0); }
     void* Process(void);
 
   private:
diff --git a/src/libcec/adapter/Pulse-Eight/USBCECAdapterCommunication.h b/src/libcec/adapter/Pulse-Eight/USBCECAdapterCommunication.h
index 5137bad..b581c6a 100644
--- a/src/libcec/adapter/Pulse-Eight/USBCECAdapterCommunication.h
+++ b/src/libcec/adapter/Pulse-Eight/USBCECAdapterCommunication.h
@@ -208,7 +208,9 @@ namespace CEC
         m_bWrite(false),
         m_iLastEepromWrite(0),
         m_iScheduleEepromWrite(0) {}
-    virtual ~CAdapterEepromWriteThread(void) {}
+    // the thread runs Process() of this class: stop it before this part of the object is gone
+    // (Close() stops it with Stop() first, which this does not replace)
+    virtual ~CAdapterEepromWriteThread(void) { StopThread(0); }
 
     bool Write(void);
     void* Process(void);
@@ -228,7 +230,8 @@ namespace CEC
     CAdapterPingThread(CUSBCECAdapterCommunication *com, uint32_t iTimeout) :
         m_com(com),
         m_timeout(iTimeout){}
-    virtual ~CAdapterPingThread(void) {}
+    // the thread runs Process() of this class: stop it before this part of the object is gone
+    virtual ~CAdapterPingThread(void) { StopThread(0); }
 
     void* Process(void);
   private:
