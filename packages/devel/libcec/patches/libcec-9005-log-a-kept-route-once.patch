From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:17:18 +0000
Subject: [PATCH] Log a route kept to a switch once, not each time it is
 announced

libcec-9004 logs at NOTICE level, which Kodi's log shows, each <Routing
Change>, <Routing Information> or <Set Stream Path> to a switch that leads
to this device. An AV receiver that announces its routing again and again
(as the one of libcec-9002 does when it powers down) would write that line
each time, for as long as it does.

CCECBusDevice::RouteKeptIsNew() remembers the last route kept for each
device: the line is written at NOTICE level the first time for a route,
and again only when another route is kept or the device stops being the
active source (MarkAsInactiveSource() forgets it); the repeats go to the
debug level. What is decided does not change.
---
 src/libcec/devices/CECBusDevice.cpp              | 15 +++++++++++++--
 src/libcec/devices/CECBusDevice.h                |  7 +++++++
 src/libcec/implementations/CECCommandHandler.cpp |  2 +-
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/src/libcec/devices/CECBusDevice.cpp b/src/libcec/devices/CECBusDevice.cpp
index 95a44d2..f0aa918 100644
--- a/src/libcec/devices/CECBusDevice.cpp
+++ b/src/libcec/devices/CECBusDevice.cpp
@@ -154,7 +154,8 @@ CCECBusDevice::CCECBusDevice(CCECProcessor *processor, cec_logical_address iLogi
   m_bVendorIdRequested    (false),
   m_waitForResponse       (new CWaitForResponse),
   m_bImageViewOnSent      (false),
-  m_bActiveSourceSent     (false)
+  m_bActiveSourceSent     (false),
+  m_iRouteKept            (CEC_INVALID_PHYSICAL_ADDRESS)
 {
   m_handler = new CCECCommandHandler(this);
   m_strDeviceName = ToString(m_iLogicalAddress);
@@ -1153,6 +1154,7 @@ void CCECBusDevice::MarkAsInactiveSource(bool bClientUnregistered /* = false */)
       bWasDeactivated = true;
     }
     m_bActiveSource = false;
+    m_iRouteKept = CEC_INVALID_PHYSICAL_ADDRESS;
   }
 
   if (bWasDeactivated)
@@ -1261,6 +1263,15 @@ bool CCECBusDevice::TransmitPendingActiveSourceCommands(void)
   return bReturn;
 }
 
+bool CCECBusDevice::RouteKeptIsNew(uint16_t iRoute)
+{
+  CLockObject lock(m_mutex);
+  if (m_iRouteKept == iRoute)
+    return false;
+  m_iRouteKept = iRoute;
+  return true;
+}
+
 void CCECBusDevice::SetActiveRoute(uint16_t iRoute)
 {
   SetPowerStatus(CEC_POWER_STATUS_ON);
@@ -1293,7 +1304,7 @@ void CCECBusDevice::SetActiveRoute(uint16_t iRoute)
     {
       // but not where the route is a switch that we are connected through: it says next where it routes
       if (CCECTypeUtils::RouteLeadsTo(iRoute, (*it)->GetCurrentPhysicalAddress()))
-        LIB_CEC->AddLog(CEC_LOG_NOTICE, "routing changed to %04x, which leads to %s (%04x): it stays the active source until that device says where it routes", iRoute, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
+        LIB_CEC->AddLog((*it)->RouteKeptIsNew(iRoute) ? CEC_LOG_NOTICE : CEC_LOG_DEBUG, "routing changed to %04x, which leads to %s (%04x): it stays the active source until that device says where it routes", iRoute, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
       else
         (*it)->MarkAsInactiveSource();
     }
diff --git a/src/libcec/devices/CECBusDevice.h b/src/libcec/devices/CECBusDevice.h
index b7214ab..0cffca5 100644
--- a/src/libcec/devices/CECBusDevice.h
+++ b/src/libcec/devices/CECBusDevice.h
@@ -180,6 +180,12 @@ namespace CEC
     virtual bool                  RequestActiveSource(bool bWaitForResponse = true);
     virtual void                  MarkAsActiveSource(void);
     virtual void                  MarkAsInactiveSource(bool bClientUnregistered = false);
+    /*!
+     * @brief Whether keeping this device the active source on a route to iRoute, a switch that leads to it, is
+     *        news to log at NOTICE level: the first time for that route, until another route is kept or this
+     *        device stops being the active source. An AV receiver may announce its routing again and again.
+     */
+    bool                          RouteKeptIsNew(uint16_t iRoute);
     virtual bool                  TransmitActiveSource(bool bIsReply);
     virtual bool                  TransmitImageViewOn(void);
     virtual bool                  TransmitInactiveSource(void);
@@ -246,5 +252,6 @@ namespace CEC
     CWaitForResponse     *m_waitForResponse;
     bool                  m_bImageViewOnSent;
     bool                  m_bActiveSourceSent;
+    uint16_t              m_iRouteKept; /**< the last route kept by RouteKeptIsNew(), or CEC_INVALID_PHYSICAL_ADDRESS */
   };
 };
diff --git a/src/libcec/implementations/CECCommandHandler.cpp b/src/libcec/implementations/CECCommandHandler.cpp
index 59b6a39..7bf8b90 100644
--- a/src/libcec/implementations/CECCommandHandler.cpp
+++ b/src/libcec/implementations/CECCommandHandler.cpp
@@ -678,7 +678,7 @@ int CCECCommandHandler::HandleSetStreamPath(const cec_command &command)
         {
           // but not where the path is a switch that we are connected through
           if (CCECTypeUtils::RouteLeadsTo(iStreamAddress, (*it)->GetCurrentPhysicalAddress()))
-            LIB_CEC->AddLog(CEC_LOG_NOTICE, "stream path set to %04x, which leads to %s (%04x): it stays the active source", iStreamAddress, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
+            LIB_CEC->AddLog((*it)->RouteKeptIsNew(iStreamAddress) ? CEC_LOG_NOTICE : CEC_LOG_DEBUG, "stream path set to %04x, which leads to %s (%04x): it stays the active source", iStreamAddress, (*it)->GetLogicalAddressName(), (*it)->GetCurrentPhysicalAddress());
           else
             (*it)->MarkAsInactiveSource();
         }
