From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:43:00 +0000
Subject: [PATCH] Keep a response that a thread waits for until that thread
 returns

CWaitForResponse hands each thread that waits for a reply (WaitForOpcode(),
for every request that expects one) a raw pointer to a CResponse that it
owns. Clear() deletes them all, and CCECBusDevice::ResetDeviceStatus()
calls it whenever a device stops answering polls, is unregistered, or the
connection closes: a request to that device that is still waiting is then
woken inside a CResponse that is gone, and locks and reads its freed mutex
and flags. That happens, for instance, when an amplifier is switched off
while it is asked for its name, or when the connection is closed while a
request waits for its reply.

The map holds the responses by shared_ptr, and Wait() and Received() keep
their own reference until they return. Clear() still wakes every waiter
before it drops them, so a waiter returns at once, as before. What a waiter
gets back does not change: a reply, a timeout, a reply that came before it
waited, or the wake-up of a Clear().

Idea: pannal (CoreELEC), whose patch holds these responses by shared_ptr.

Tests (outside the tree): libCEC built on the host with AddressSanitizer
and ThreadSanitizer; a thread that waits for a reply while Clear() runs
(use after free in CCondition::Wait() before, none after), and the replies
a waiter gets in each case, the same before and after.
---
 src/libcec/devices/CECBusDevice.cpp | 33 ++++++++++-------------------
 src/libcec/devices/CECBusDevice.h   | 12 ++++++++---
 2 files changed, 20 insertions(+), 25 deletions(-)

diff --git a/src/libcec/devices/CECBusDevice.cpp b/src/libcec/devices/CECBusDevice.cpp
index f0aa918..510539a 100644
--- a/src/libcec/devices/CECBusDevice.cpp
+++ b/src/libcec/devices/CECBusDevice.cpp
@@ -93,44 +93,33 @@ CWaitForResponse::~CWaitForResponse(void)
 void CWaitForResponse::Clear()
 {
   CLockObject lock(m_mutex);
-  for (std::map<cec_opcode, CResponse*>::iterator it = m_waitingFor.begin(); it != m_waitingFor.end(); it++)
-  {
+  // wake whoever waits, and drop the responses: a thread that is still in Wait() or Received()
+  // holds its own reference, and the response goes when that thread is done with it
+  for (std::map<cec_opcode, std::shared_ptr<CResponse>>::iterator it = m_waitingFor.begin(); it != m_waitingFor.end(); it++)
     it->second->Broadcast();
-    delete it->second;
-  }
   m_waitingFor.clear();
 }
 
 bool CWaitForResponse::Wait(cec_opcode opcode, uint32_t iTimeout)
 {
-  CResponse *response = GetEvent(opcode);
+  std::shared_ptr<CResponse> response = GetEvent(opcode);
   return response ? response->Wait(iTimeout) : false;
 }
 
 void CWaitForResponse::Received(cec_opcode opcode)
 {
-  CResponse *response = GetEvent(opcode);
+  std::shared_ptr<CResponse> response = GetEvent(opcode);
   if (response)
     response->Broadcast();
 }
 
-CResponse* CWaitForResponse::GetEvent(cec_opcode opcode)
+std::shared_ptr<CResponse> CWaitForResponse::GetEvent(cec_opcode opcode)
 {
-  CResponse *retVal(NULL);
-  {
-    CLockObject lock(m_mutex);
-    std::map<cec_opcode, CResponse*>::iterator it = m_waitingFor.find(opcode);
-    if (it != m_waitingFor.end())
-    {
-      retVal = it->second;
-    }
-    else
-    {
-      retVal = new CResponse(opcode);
-      m_waitingFor[opcode] = retVal;
-    }
-    return retVal;
-  }
+  CLockObject lock(m_mutex);
+  std::shared_ptr<CResponse>& response = m_waitingFor[opcode];
+  if (!response)
+    response = std::make_shared<CResponse>(opcode);
+  return response;
 }
 
 CCECBusDevice::CCECBusDevice(CCECProcessor *processor, cec_logical_address iLogicalAddress, uint16_t iPhysicalAddress /* = CEC_INVALID_PHYSICAL_ADDRESS */) :
diff --git a/src/libcec/devices/CECBusDevice.h b/src/libcec/devices/CECBusDevice.h
index 0cffca5..38ef68b 100644
--- a/src/libcec/devices/CECBusDevice.h
+++ b/src/libcec/devices/CECBusDevice.h
@@ -76,10 +76,16 @@ namespace CEC
     void Received(cec_opcode opcode);
 
   private:
-    CResponse *GetEvent(cec_opcode opcode);
+    /*!
+     * @brief The response for this opcode, made when there is none yet.
+     *
+     * Shared, so that a thread that waits for it, or signals it, keeps it until it is done
+     * with it, even when Clear() drops it from the map meanwhile.
+     */
+    std::shared_ptr<CResponse> GetEvent(cec_opcode opcode);
 
-    CMutex                           m_mutex;
-    std::map<cec_opcode, CResponse*> m_waitingFor;
+    CMutex                                           m_mutex;
+    std::map<cec_opcode, std::shared_ptr<CResponse>> m_waitingFor;
   };
 
   class CCECBusDevice
