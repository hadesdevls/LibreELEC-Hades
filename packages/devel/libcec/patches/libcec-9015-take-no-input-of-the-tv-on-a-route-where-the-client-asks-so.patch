From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:51:27 +0000
Subject: [PATCH] Take no input of the TV on a route where the client asks so

A <Routing Change> or <Routing Information> that names the address of a
device of libCEC makes it the active source (SetActiveRoute(), with
libcec-9001 and libcec-9002): ActivateSource() sends the TV <Image View
On>, which wakes it and switches it to that input, and broadcasts
<Active Source>. An AV receiver sends one each time the user picks the
input that the device is on.

LibreELEC Hades issue #24: an AV receiver on the HDMI port of the board
(a DP to HDMI converter whose CEC the kernel tunnels over DP-AUX) for
the sound only, while the picture goes to the TV from another graphics
card. Picking the PC's input on the receiver switched the TV to the
receiver's input, away from the picture.

The client says it now: CECSetTakesNoTvInput(instance, true), declared
in cec.h with CEC_HADES_TAKES_NO_TV_INPUT, makes a route to a device of
that instance leave the TV alone (a line at NOTICE level, which Kodi's
log shows). Kodi calls it for the CEC adapter of an output that does
not carry its picture. Off when the instance is created, so every other
client, cec-client among them, and every setting are as before.

It is a function of its own because the configuration cannot say it:
CCECClient::SetConfiguration() ties the TV among the devices to wake to
the activation of the source at the start (taking the TV off the first
turns the second off, and Kodi writes that back to its settings), so a
client that keeps the TV off its devices to wake for its own reasons
could not be told from one that asks for this. The function is an
addition: libcec_configuration and ICECAdapter are unchanged, and a
program built against libCEC 8.1.7 neither sees nor needs it.
---
 include/cec.h                       | 13 +++++++++++++
 src/libcec/LibCEC.cpp               | 10 ++++++++++
 src/libcec/LibCEC.h                 |  6 ++++++
 src/libcec/devices/CECBusDevice.cpp |  5 +++++
 4 files changed, 34 insertions(+)

diff --git a/include/cec.h b/include/cec.h
index 680c058..51b5622 100644
--- a/include/cec.h
+++ b/include/cec.h
@@ -516,6 +516,19 @@ extern "C" DECLSPEC void CECDestroy(CEC::ICECAdapter *instance);
  */
 extern "C" DECLSPEC CEC::ICECAdapter* CECInitialise(CEC::libcec_configuration *configuration);
 
+/*!
+ * @brief LibreELEC Hades: whether the client takes no input of the TV through this instance. When
+ *        it does not, a route that a switch announces to a device of libCEC (<Routing Change>,
+ *        <Routing Information>) does not make it the active source: no <Image View On> to the TV,
+ *        which also switches the TV to it, and no <Active Source>. Kodi sets it for the CEC adapter
+ *        of an output that does not carry its picture (an AV receiver for the sound only). Off when
+ *        the instance is created. Declared where CEC_HADES_TAKES_NO_TV_INPUT is.
+ * @param instance The instance that CECInitialise() returned.
+ * @param takesNoTvInput True: the input of the TV is not taken on a route.
+ */
+#define CEC_HADES_TAKES_NO_TV_INPUT 1
+extern "C" DECLSPEC void CECSetTakesNoTvInput(CEC::ICECAdapter *instance, bool takesNoTvInput);
+
 /*!
  * @brief Try to connect to the adapter and send the "start bootloader" command, without initialising libCEC and going through all checks
  * @return True when the command was send, false otherwise.
diff --git a/src/libcec/LibCEC.cpp b/src/libcec/LibCEC.cpp
index 736ae8f..6026fd4 100644
--- a/src/libcec/LibCEC.cpp
+++ b/src/libcec/LibCEC.cpp
@@ -582,6 +582,16 @@ void CECDestroy(CEC::ICECAdapter *instance)
   SafeDelete(instance);
 }
 
+void CECSetTakesNoTvInput(CEC::ICECAdapter *instance, bool takesNoTvInput)
+{
+  // (an instance is a CLibCEC: CECInitialise())
+  CLibCEC *lib = static_cast<CLibCEC *>(instance);
+  if (!lib || lib->TakesNoTvInput() == takesNoTvInput)
+    return;
+  lib->SetTakesNoTvInput(takesNoTvInput);
+  lib->AddLog(CEC_LOG_NOTICE, "the input of the TV is %s on a route to this client", takesNoTvInput ? "no longer taken" : "taken again");
+}
+
 bool CLibCEC::GetDeviceInformation(const char *strPort, libcec_configuration *config, uint32_t iTimeoutMs /* = CEC_DEFAULT_CONNECT_TIMEOUT */)
 {
   if (m_cec->IsRunning())
diff --git a/src/libcec/LibCEC.h b/src/libcec/LibCEC.h
index 9c5f81d..0211ee1 100644
--- a/src/libcec/LibCEC.h
+++ b/src/libcec/LibCEC.h
@@ -38,6 +38,7 @@
 #include "platform/util/buffer.h"
 #include "platform/threads/mutex.h"
 #include "CECTypeUtils.h"
+#include <atomic>
 #include <memory>
 
 #define CEC_PROCESSOR_SIGNAL_WAIT_TIME 1000
@@ -149,6 +150,9 @@ namespace CEC
       bool CommandHandlerCB(const cec_command &command);
       uint16_t CheckKeypressTimeout(void);
       void Alert(const libcec_alert type, const libcec_parameter &param);
+      //! LibreELEC Hades: CECSetTakesNoTvInput()
+      void SetTakesNoTvInput(bool takesNoTvInput) { m_bTakesNoTvInput = takesNoTvInput; }
+      bool TakesNoTvInput(void) const { return m_bTakesNoTvInput; }
 
       static bool IsValidPhysicalAddress(uint16_t iPhysicalAddress);
       CECClientPtr RegisterClient(libcec_configuration &configuration);
@@ -194,5 +198,7 @@ namespace CEC
       std::vector<CECClientPtr> m_clients;
       // serialises Open() against Close()
       CMutex                    m_mutex;
+      // LibreELEC Hades: CECSetTakesNoTvInput(); read by the processor's thread
+      std::atomic<bool>         m_bTakesNoTvInput{false};
   };
 };
diff --git a/src/libcec/devices/CECBusDevice.cpp b/src/libcec/devices/CECBusDevice.cpp
index d082a03..20b060f 100644
--- a/src/libcec/devices/CECBusDevice.cpp
+++ b/src/libcec/devices/CECBusDevice.cpp
@@ -1280,6 +1280,11 @@ void CCECBusDevice::SetActiveRoute(uint16_t iRoute)
     if (tvStatus == CEC_POWER_STATUS_STANDBY ||
         tvStatus == CEC_POWER_STATUS_IN_TRANSITION_ON_TO_STANDBY)
       LIB_CEC->AddLog(CEC_LOG_DEBUG, "not activating '%s' on routing change: TV is '%s'", newRoute->GetLogicalAddressName(), ToString(tvStatus));
+    // LibreELEC Hades: nor where the client takes no input of the TV through this adapter
+    // (CECSetTakesNoTvInput()): activating sends the TV 'image view on', which also switches it
+    // to this input
+    else if (LIB_CEC->TakesNoTvInput())
+      LIB_CEC->AddLog(CEC_LOG_NOTICE, "not activating '%s' on a routing change to it (%04x): the client takes no input of the TV through this adapter", newRoute->GetLogicalAddressName(), iRoute);
     else
       newRoute->ActivateSource();
   }
