From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:46:28 +0000
Subject: [PATCH] cmake: leave the kernel release of the build machine out of a
 reproducible build

With SOURCE_DATE_EPOCH set, SetBuildInfo.cmake already leaves the user and
the host that built the library out of LIB_INFO, which libCEC logs when it
starts, but it still writes the release of the kernel of the build machine
(uname -r) there, so two builds of the same source on machines with other
kernels differ. Leave the release out too in that case; the system name and
the architecture stay. Without SOURCE_DATE_EPOCH, nothing changes.
---
 src/libcec/cmake/SetBuildInfo.cmake | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/libcec/cmake/SetBuildInfo.cmake b/src/libcec/cmake/SetBuildInfo.cmake
index 64e8599..e77a457 100644
--- a/src/libcec/cmake/SetBuildInfo.cmake
+++ b/src/libcec/cmake/SetBuildInfo.cmake
@@ -68,7 +68,12 @@ if(NOT DISABLE_BUILDINFO)
     string(STRIP ${BUILD_SYSVER} BUILD_SYSVER)
     string(STRIP ${BUILD_SYSARCH} BUILD_SYSARCH)
 
-    set(LIB_INFO "${LIB_INFO} on ${BUILD_SYSNAME} ${BUILD_SYSVER} (${BUILD_SYSARCH})")
+    if (DEFINED ENV{SOURCE_DATE_EPOCH})
+      # the release of the kernel of the build machine is not part of a reproducible build
+      set(LIB_INFO "${LIB_INFO} on ${BUILD_SYSNAME} (${BUILD_SYSARCH})")
+    else()
+      set(LIB_INFO "${LIB_INFO} on ${BUILD_SYSNAME} ${BUILD_SYSVER} (${BUILD_SYSARCH})")
+    endif()
   endif()
 endif()
 endif()
