From bab118f8b46de427f8b455498820811f0908d574 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:58:30 +0000
Subject: [PATCH] drm/i915: the tunnel's scanout check reads the colour that
 the pipe programs

intel_dv_lab_scanout_check() refuses colour processing with, among others,
gamma_enable and csc_enable of the CRTC state. On display version 11 and
later those two are never set: icl_color_check() programs the pipe with
csc_mode (the pipe CSC and the output CSC) and gamma_mode (PRE_CSC_GAMMA_ENABLE
and POST_CSC_GAMMA_ENABLE), so on Ice Lake and every Intel GPU after it the
terms were always false. The result was right only because what turns those
blocks on (a CTM, a LUT, limited range, YCbCr output) is refused by other
terms first.

The check now reads what the pipe programs, by generation
(intel_dv_lab_pipe_colour(): csc_mode and the two gamma enables from version
11 on, gamma_enable and csc_enable before), and the kernel log of a refusal
says the same. It also refuses a colour pipeline on the primary plane
(COLOR_PIPELINE), even one whose operations are all bypassed, as amdgpu does:
the tunnel takes the plane with no colour processing at all. Nothing that
passed before is refused now unless user space sets a colour pipeline (Kodi
does not). W=1 on intel_display.c and its xe copy: no warning.
---
 drivers/gpu/drm/i915/display/intel_display.c | 27 ++++++++++++++++----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index 5a65362..61220ce 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -63,6 +63,7 @@
 #include "intel_clock_gating.h"
 #include "intel_cmtg.h"
 #include "intel_color.h"
+#include "intel_color_regs.h"
 #include "intel_crt.h"
 #include "intel_crtc.h"
 #include "intel_crtc_state_dump.h"
@@ -4334,6 +4335,20 @@ static bool intel_dv_lab_low_latency(const struct intel_crtc_state *state)
 	return intel_dv_lab_active(state) && state->infoframes.hdmi.vendor.dolby.low_latency;
 }
 
+/*
+ * Hades: the pipe processes colour for this state, as the hardware is programmed. On display
+ * version 11 and later the output CSC, the pipe CSC and the gamma blocks are enabled by csc_mode
+ * and gamma_mode (icl_color_check()); gamma_enable and csc_enable are never set there. Before,
+ * by gamma_enable and csc_enable (ivb_color_check(), glk_color_check()).
+ */
+static bool intel_dv_lab_pipe_colour(const struct intel_crtc_state *s)
+{
+	if (DISPLAY_VER(to_intel_display(s)) >= 11)
+		return s->csc_mode ||
+		       (s->gamma_mode & (PRE_CSC_GAMMA_ENABLE | POST_CSC_GAMMA_ENABLE));
+	return s->gamma_enable || s->csc_enable;
+}
+
 static int intel_dv_lab_scanout_check(struct intel_atomic_state *state,
 				     struct intel_crtc *crtc)
 {
@@ -4348,7 +4363,7 @@ static int intel_dv_lab_scanout_check(struct intel_atomic_state *state,
 		return 0;
 	/* Refuse color processing/compositing, do not silently bypass a user's LUT. */
 	if (s->hw.ctm || s->hw.degamma_lut || s->hw.gamma_lut || s->pre_csc_lut ||
-	    s->post_csc_lut || s->gamma_enable || s->csc_enable || s->dither ||
+	    s->post_csc_lut || intel_dv_lab_pipe_colour(s) || s->dither ||
 	    s->vrr.enable || s->dsc.compression_enable || s->scaler_state.scaler_users ||
 	    s->uapi.plane_mask != drm_plane_mask(primary))
 		return -EINVAL;
@@ -4360,7 +4375,9 @@ static int intel_dv_lab_scanout_check(struct intel_atomic_state *state,
 	    p->fb->width != w || p->fb->height != h ||
 	    p->src_x || p->src_y || p->src_w != (w << 16) || p->src_h != (h << 16) ||
 	    p->crtc_x || p->crtc_y || p->crtc_w != w || p->crtc_h != h ||
-	    p->rotation != DRM_MODE_ROTATE_0 || p->alpha != 0xffff)
+	    p->rotation != DRM_MODE_ROTATE_0 || p->alpha != 0xffff ||
+	    /* Hades: no colour pipeline of the plane at all, as amdgpu */
+	    p->color_pipeline)
 		return -EINVAL;
 	ip = to_intel_plane_state(p);
 	if (ip->hw.ctm || ip->hw.degamma_lut || ip->hw.gamma_lut || ip->hw.lut_3d ||
@@ -4402,17 +4419,17 @@ static void intel_dv_lab_scanout_report(struct intel_atomic_state *state,
 	len = scnprintf(detail, sizeof(detail),
 			"CRTC: colour management %d, dither %d, VRR %d, DSC %d, scaler users %#x, planes %#x (the primary alone: %#x)",
 			!!(s->hw.ctm || s->hw.degamma_lut || s->hw.gamma_lut || s->pre_csc_lut ||
-			   s->post_csc_lut || s->gamma_enable || s->csc_enable),
+			   s->post_csc_lut || intel_dv_lab_pipe_colour(s)),
 			s->dither, s->vrr.enable, s->dsc.compression_enable,
 			s->scaler_state.scaler_users, s->uapi.plane_mask,
 			drm_plane_mask(crtc->base.primary));
 	if (p && p->fb)
 		scnprintf(detail + len, sizeof(detail) - len,
-			  "; primary plane: %p4cc %ux%u, source %ux%u+%u+%u, on screen %ux%u%+d%+d, rotation %#x, alpha %#x, scaler %d",
+			  "; primary plane: %p4cc %ux%u, source %ux%u+%u+%u, on screen %ux%u%+d%+d, rotation %#x, alpha %#x, scaler %d, colour pipeline %s",
 			  &p->fb->format->format, p->fb->width, p->fb->height,
 			  p->src_w >> 16, p->src_h >> 16, p->src_x >> 16, p->src_y >> 16,
 			  p->crtc_w, p->crtc_h, p->crtc_x, p->crtc_y, p->rotation, p->alpha,
-			  to_intel_plane_state(p)->scaler_id);
+			  to_intel_plane_state(p)->scaler_id, str_yes_no(p->color_pipeline));
 	for_each_new_intel_connector_in_state(state, connector, conn_state, i) {
 		if (conn_state->base.crtc != &crtc->base || !connector->dv_refused_property)
 			continue;
-- 
2.53.0

