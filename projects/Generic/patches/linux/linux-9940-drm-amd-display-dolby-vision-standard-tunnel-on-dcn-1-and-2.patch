From a9cca97c88d6a430390948f739fc34b738f00c9a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:07:33 +0000
Subject: [PATCH] drm/amd/display: Dolby Vision Standard tunnel on DCN 1 and 2

linux-9910 offers DVBRIDGE_DV_STANDARD_LAB only on DCN 3.x, the pipeline
it was reviewed for. Raven, Picasso, Dali and Pollock (DCN 1.0 and
1.0.1), Navi 1x (DCN 2.0) and Renoir, Lucienne and Cezanne (DCN 2.1)
program the scanout through the same DC paths, with blocks of their own
in places. Reviewed stage by stage in 7.2.10 (7.2.11 leaves the display
core as it is), with the state that
linux-9910 already requires (XRGB8888 primary plane alone, unscaled,
opaque; no plane or CRTC colour properties; COLOR_SPACE_SRGB; RGB 8 bpc
over TMDS; DITHER_OPTION_TRUN8):

- format converter (DPP1, DPP2): ARGB8888 with zero expansion
  (EXPANSION_MODE_ZERO, as on DCN 3); input CSC in bypass for RGB;
- bias and scale (DPP1 only): 1.0 and 0 for RGB formats
  (build_prescale_params());
- degamma, gamut remap and HDR multiplier, and on DPP2 the shaper, 3D
  LUT and blend gamma: bypass, or a multiplier of exactly 1.0;
- input gamma LUT (DPP1 only): the format setup puts it in fixed point
  bypass, and dcn10_set_input_transfer_func() writes it from the plane's
  legacy gamma whenever that is not the identity. amdgpu_dm never sets
  one; a tunnel over a plane with one is now refused;
- output CSC: in the DPP on DCN 1, where it is never put in bypass; the
  matrix for COLOR_SPACE_SRGB is the identity without offsets. In the
  MPC on DCN 2, as on DCN 3;
- regamma: in the DPP on DCN 1, with an sRGB ROM that a predefined sRGB
  output TF selects. A new stream starts with that TF
  (fill_stream_properties_from_drm_display_mode()); the colour update
  at commit setup replaces it with bypass under the conditions the
  atomic check requires. Before DCN 3, a commit that would leave a
  tunnelled stream with any other output TF is now refused there. On
  DCN 2 the output gamma is in the MPC, in bypass for that TF;
- scaler: 4:4:4 bypass at unity ratios; the DCN 1 line buffer keeps 12
  bits per component of the zero-expanded 8 (fixed point, rounding),
  DCN 2 works in floating point as DCN 3 does;
- blending: one MPCC, top layer only. With an MPC combine split (forced
  for a single display on DCN 1, chosen by bandwidth on DCN 2.x as on
  most of DCN 3.0 to 3.1.6), the left half is blended over the right
  with global alpha 0xff, non-premultiplied, as on DCN 3;
- output formatter: the opp1 code DCN 3 uses (truncation to 8 bits, no
  dither, clamping to the full range only);
- HDMI stream encoder (DCN 1 and DCN 2 variants): RGB, 8 bpc, scrambling
  above 340 MHz; the AVI InfoFrame in generic packet 0 and the vendor
  one in packet 3, 32 bytes after the header, written by
  dce110_update_info_frame() at modeset and on the stream update of
  linux-9910.

DCN 2.0.1 has DPP, MPC, OPP and sequencer variants of its own that were
not reviewed, and stays without the property, as do DCE and DCN 4. DCN
3.x is unchanged: the new checks run only before DCN 3.0.

The Dolby Vision fork of CroqueMr (libreelec-x86-DV) offers its amdgpu
tunnel from DCN 1.0 to 3.6 with the same programming on every
generation; of what it checks, the one that only DCN 1 needs is the
plane's gamma_correction.is_identity, which this patch requires on its
own terms.

Not tested on hardware yet.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 62 +++++++++++++++++--
 1 file changed, 58 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 435d351..437baee 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -7911,6 +7911,30 @@ static int amdgpu_dm_dvbridge_check_connector(struct amdgpu_dm_connector *aconn,
 	return 0;
 }
 
+/*
+ * DCN 1.0/1.0.1 (DPP1, MPC1) and DCN 2.0/2.1 (DPP2, MPC2) program the scanout as DCN 3 does from
+ * the state that amdgpu_dm_dvbridge_check_scanout() checks, with these differences:
+ *
+ * - DPP1 has an input gamma LUT before the degamma block. The format setup leaves it in fixed
+ *   point bypass, and dcn10_set_input_transfer_func() writes it from the plane's legacy gamma
+ *   whenever that is not the identity: refused here.
+ * - DPP1 holds the output CSC, which is never put in bypass, and the regamma, which has an sRGB
+ *   ROM. The CSC for COLOR_SPACE_SRGB is the identity matrix without offsets. The ROM is chosen
+ *   by a predefined sRGB output TF, the TF a new stream starts with: the colour update of
+ *   amdgpu_dm_atomic_setup_commit() replaces it with bypass under the conditions checked here,
+ *   and that function refuses the commit otherwise.
+ * - DPP2 holds the shaper, the 3D LUT and the blend gamma, all in bypass with the plane state
+ *   already checked; MPC2 holds the output gamma and CSC as MPC3 does.
+ */
+static int amdgpu_dm_dvbridge_check_dcn1_2(const struct dc_stream_state *stream,
+					   const struct dc_plane_state *dc_plane)
+{
+	if (stream->ctx->dce_version <= DCN_VERSION_1_01 &&
+	    !dc_plane->gamma_correction.is_identity)
+		return -EINVAL;
+	return 0;
+}
+
 /* Refuse colour processing and compositing: never bypass a user setting silently. */
 static int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 					    struct drm_crtc *crtc,
@@ -8000,6 +8024,8 @@ static int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 	    dc_plane->dst_rect.x || dc_plane->dst_rect.y ||
 	    dc_plane->dst_rect.width != w || dc_plane->dst_rect.height != h)
 		return -EINVAL;
+	if (stream->ctx->dce_version < DCN_VERSION_3_0)
+		return amdgpu_dm_dvbridge_check_dcn1_2(stream, dc_plane);
 	return 0;
 }
 
@@ -8027,13 +8053,25 @@ static bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct d
 }
 
 /*
- * The byte exact path was reviewed for the DCN 3.x pipeline (DPP3, MPC3, OPP); DCE and DCN
- * 1/2 have other blocks, and DCN 4 adds scaler sharpening (SPL, ISHARP).
+ * The byte exact path was reviewed for the DCN 1.0 and 1.0.1 pipeline (DPP1, MPC1, OPP), for
+ * DCN 2.0 and 2.1 (DPP2, MPC2, OPP) and for DCN 3.x (DPP3, MPC3, OPP). DCE has other blocks,
+ * DCN 2.0.1 has DPP, MPC, OPP and sequencer variants of its own that were not reviewed, and
+ * DCN 4 adds scaler sharpening (SPL, ISHARP).
  */
 static bool amdgpu_dm_dvbridge_dcn_reviewed(const struct amdgpu_device *adev)
 {
-	return adev->dm.dc && adev->dm.dc->ctx->dce_version >= DCN_VERSION_3_0 &&
-	       adev->dm.dc->ctx->dce_version < DCN_VERSION_4_01;
+	if (!adev->dm.dc)
+		return false;
+	switch (adev->dm.dc->ctx->dce_version) {
+	case DCN_VERSION_1_0:
+	case DCN_VERSION_1_01:
+	case DCN_VERSION_2_0:
+	case DCN_VERSION_2_1:
+		return true;
+	default:
+		return adev->dm.dc->ctx->dce_version >= DCN_VERSION_3_0 &&
+		       adev->dm.dc->ctx->dce_version < DCN_VERSION_4_01;
+	}
 }
 
 /*
@@ -12202,6 +12240,22 @@ static int amdgpu_dm_atomic_setup_commit(struct drm_atomic_commit *state)
 				return ret;
 			}
 		}
+
+		/*
+		 * The output gamma of a Dolby Vision tunnel must be in bypass. The colour update
+		 * above sets it whenever the atomic check let the tunnel through; on DCN 1 and 2,
+		 * reviewed for the bypass TF only, make sure of it: there a predefined sRGB output
+		 * TF, the TF a new stream starts with, selects the sRGB regamma ROM of DCN 1.
+		 */
+		if (dm_new_crtc_state->base.active &&
+		    amdgpu_dm_dvbridge_stream_active(dm_new_crtc_state->stream) &&
+		    dm_new_crtc_state->stream->ctx->dce_version < DCN_VERSION_3_0 &&
+		    dm_new_crtc_state->stream->out_transfer_func.type != TF_TYPE_BYPASS) {
+			drm_warn_once(state->dev,
+				      "[CRTC:%d:%s] Dolby Vision tunnel refused: output gamma not in bypass\n",
+				      crtc->base.id, crtc->name);
+			return -EINVAL;
+		}
 	}
 
 	return 0;
