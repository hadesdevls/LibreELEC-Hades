 		return -EINVAL;
 	/* 2160p50 and 2160p60 need a sink that advertises Dolby Vision at 2160p60. */
-	if (!(hdmi14b ? sink.hdmi14b_p60 : sink.p60) && drm_dvbridge_vic_needs_p60(vic))
+	if (!hdr10t && !(hdmi14b ? sink.hdmi14b_p60 : sink.p60) && drm_dvbridge_vic_needs_p60(vic))
 		return -EINVAL;
 
 	/* RGB is a byte tunnel here, not an RGB colour-managed picture (drm_dvbridge.h). */
@@ -1713,6 +1729,9 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	/* Hades: what the sink's Low-Latency input reads the same bytes as (drm_dvbridge_ll.h) */
 	if (low_latency)
 		drm_dvbridge_ll_avi(&avi);
+	/* Hades: ... or HDR as the same YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+	if (hdr10t)
+		drm_dvbridge_hdr10t_avi(&avi);
 	/* Hades: with the HDMI 1.4b signal, VIC 0 where its vendor InfoFrame has the HDMI VIC */
 	if (hdmi14b)
 		drm_dvbridge_hdmi14b_avi(&avi, vic);
@@ -1725,24 +1744,27 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 
 	/*
 	 * AVI carries the CTA timing, so the vendor slot holds the Dolby VSIF and no
-	 * HDMI 1.4 vendor packet competes with it.
+	 * HDMI 1.4 vendor packet competes with it. (Hades: HDR over the tunnel sends no Dolby VSIF
+	 * and no vendor packet: the slot stays free, for HDR10+ in its own packet.)
 	 */
-	if (hdmi14b) {
-		/* Hades: the HDMI 1.4b signal, with the HDMI VIC of the mode (drm_dvbridge.h) */
-		drm_dvbridge_tunnel_hdmi14b_vsif(&dv14, vic);
-		len = hdmi_dolby_hdmi14b_infoframe_pack(&dv14, buf, sizeof(buf));
-	} else {
-		drm_dvbridge_tunnel_vsif(&dv);
-		/* Hades: ... with low latency (drm_dvbridge_ll.h) */
-		if (low_latency)
-			drm_dvbridge_ll_vsif(&dv);
-		len = hdmi_dolby_vendor_infoframe_pack(&dv, buf, sizeof(buf));
+	if (!hdr10t) {
+		if (hdmi14b) {
+			/* Hades: the HDMI 1.4b signal, with the HDMI VIC of the mode (drm_dvbridge.h) */
+			drm_dvbridge_tunnel_hdmi14b_vsif(&dv14, vic);
+			len = hdmi_dolby_hdmi14b_infoframe_pack(&dv14, buf, sizeof(buf));
+		} else {
+			drm_dvbridge_tunnel_vsif(&dv);
+			/* Hades: ... with low latency (drm_dvbridge_ll.h) */
+			if (low_latency)
+				drm_dvbridge_ll_vsif(&dv);
+			len = hdmi_dolby_vendor_infoframe_pack(&dv, buf, sizeof(buf));
+		}
+		if (len < 0)
+			return len;
+		ret = amdgpu_dm_dvbridge_infopacket(buf, len, &stream->vsp_infopacket);
+		if (ret)
+			return ret;
 	}
-	if (len < 0)
-		return len;
-	ret = amdgpu_dm_dvbridge_infopacket(buf, len, &stream->vsp_infopacket);
-	if (ret)
-		return ret;
 
 	stream->timing.vic = vic;
 	stream->timing.hdmi_vic = 0;
@@ -1772,11 +1794,29 @@ static int amdgpu_dm_dvbridge_check_connector(struct amdgpu_dm_connector *aconn,
 	    aconn->dc_link->connector_signal != SIGNAL_TYPE_HDMI_TYPE_A ||
 	    !aconn->base.display_info.has_hdmi_infoframe)
 		return -EOPNOTSUPP;
+	/*
+	 * (Hades: HDR over the tunnel is the one that has HDR metadata, and has to: nothing else
+	 * says HDR, drm_dvbridge_hdr10t.h)
+	 */
 	if (con_state->max_requested_bpc != 8 ||
 	    con_state->colorspace != DRM_MODE_COLORIMETRY_DEFAULT ||
-	    con_state->hdr_output_metadata ||
+	    (con_state->hdr_output_metadata && !dm_state->dvbridge_hdr10t) ||
 	    con_state->hdmi.broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED)
 		return -EINVAL;
+	if (dm_state->dvbridge_hdr10t) {
+		const struct drm_dvbridge_hdr10t_request request = {
+			.sink_ycbcr422 = true, /* (the stream's: amdgpu_dm_dvbridge_fill_stream()) */
+			.hdr_metadata = !!con_state->hdr_output_metadata,
+			.low_latency = dm_state->dvbridge_dv_low_latency,
+			.hdmi14b = dm_state->dvbridge_dv_hdmi14b,
+			.hdr10plus = !!con_state->hdr10plus_vsif,
+			.vendor_slot_free = !drm_dvbridge_hdmi14b_vic(
+				drm_match_cea_mode(&crtc_state->mode)),
