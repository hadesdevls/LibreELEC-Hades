 	     dm_new_con_state->dvbridge_dv_low_latency != dm_old_con_state->dvbridge_dv_low_latency) ||
 	    (dm_new_con_state->dvbridge_dv_standard &&
-	     dm_new_con_state->dvbridge_dv_hdmi14b != dm_old_con_state->dvbridge_dv_hdmi14b)) {
+	     dm_new_con_state->dvbridge_dv_hdmi14b != dm_old_con_state->dvbridge_dv_hdmi14b) ||
+	    /* Hades: ... and HDR over the tunnel or back: other InfoFrames and another format */
+	    (dm_new_con_state->dvbridge_dv_standard &&
+	     dm_new_con_state->dvbridge_hdr10t != dm_old_con_state->dvbridge_hdr10t)) {
 		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
 		if (IS_ERR(new_crtc_state))
 			return PTR_ERR(new_crtc_state);
@@ -4054,7 +4117,8 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	 * never a modeset. Not with the Dolby Vision tunnel, whose Dolby VSIF is the dynamic
 	 * metadata of its picture; not on a link that does not carry it.
 	 */
-	if (new_con_state->hdr10plus_vsif && dm_new_con_state->dvbridge_dv_standard) {
