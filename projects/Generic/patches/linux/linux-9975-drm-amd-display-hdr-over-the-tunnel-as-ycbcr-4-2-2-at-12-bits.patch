 		/* Hades: ... and its HDMI 1.4b signal */
 		dm_new_con_state->dvbridge_dv_hdmi14b = false;
+		/* Hades: ... and HDR over it */
+		dm_new_con_state->dvbridge_hdr10t = false;
 		/* Hades: ... and the HDR10 depth guard */
 		dm_new_con_state->dvbridge_hdr10_deep_color = false;
 		return 0;
@@ -3948,7 +4008,10 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
