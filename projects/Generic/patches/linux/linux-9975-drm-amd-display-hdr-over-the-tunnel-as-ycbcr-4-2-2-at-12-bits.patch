+
+		if (drm_dvbridge_hdr10t_refused(&request))
+			return -EINVAL;
+	}
 	/*
 	 * Hades: the "color format" property of Linux 7.3 chooses the pixel encoding of the stream
 	 * (amdgpu_dm_create_validate_stream_for_sink()): the tunnel is RGB, with it at AUTO or RGB.
@@ -2010,6 +2050,11 @@ bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct drm_crtc
 		    to_dm_connector_state(old_con_state)->dvbridge_dv_hdmi14b !=
