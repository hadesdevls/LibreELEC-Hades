 #include <drm/drm_eld.h>
@@ -1652,6 +1653,12 @@ static int amdgpu_dm_dvbridge_infopacket(const u8 *buf, ssize_t len,
 /* The Dolby VSIF this driver builds occupies the vendor slot of the stream. */
 bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream)
 {
+	/*
+	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) sends no Dolby VSIF: the stream that
+	 * amdgpu_dm_dvbridge_fill_stream() made says it
+	 */
+	if (stream && stream->byte_tunnel)
+		return true;
 	return stream && stream->vsp_infopacket.valid &&
 	       stream->vsp_infopacket.hb0 == HDMI_INFOFRAME_TYPE_VENDOR &&
 	       ((stream->vsp_infopacket.hb2 == HDMI_DOLBY_VENDOR_INFOFRAME_SIZE &&
@@ -1676,6 +1683,8 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	const bool low_latency = to_dm_connector_state(con_state)->dvbridge_dv_low_latency;
 	/* Hades: ... or the Standard tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
 	const bool hdmi14b = to_dm_connector_state(con_state)->dvbridge_dv_hdmi14b;
+	/* Hades: ... or HDR sent over it as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+	const bool hdr10t = to_dm_connector_state(con_state)->dvbridge_hdr10t;
 	struct hdmi_dolby_hdmi14b_infoframe dv14;
 	struct hdmi_dolby_vendor_infoframe dv;
 	struct drm_dvbridge_sink sink;
@@ -1695,13 +1704,20 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 		return -EOPNOTSUPP;
 	/* (Hades: the rule of drm_dvbridge.h, read once) */
 	drm_dvbridge_edid_read(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length, &sink);
-	if (hdmi14b ? low_latency || !drm_dvbridge_sink_takes_hdmi14b(&sink) :
-		      !drm_dvbridge_sink_takes(&sink, low_latency))
+	if (hdr10t) {
+		/* Hades: no Dolby block is needed, the sink takes YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+		if (low_latency || hdmi14b)
+			return -EINVAL;
+		if (!(connector->display_info.color_formats &
+		      BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422)))
+			return -EOPNOTSUPP;
+	} else if (hdmi14b ? low_latency || !drm_dvbridge_sink_takes_hdmi14b(&sink) :
+			     !drm_dvbridge_sink_takes(&sink, low_latency))
 		return -EOPNOTSUPP;
