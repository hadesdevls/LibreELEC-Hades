diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 0e51c8671..3d00b53e7 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5556,7 +5556,7 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 		dm_new_crtc_state->abm_level = dm_new_conn_state->abm_level;
 
 		/* Hades: HDR10PLUS_VSIF (amdgpu_dm_hdr10plus.h); never with the Dolby Vision tunnel */
-		if (!dm_new_conn_state->dvbridge_dv_standard)
+		if (!dm_new_conn_state->dvbridge_dv_standard || dm_new_conn_state->dvbridge_hdr10t)
 			amdgpu_dm_fill_hdr10plus(drm_new_conn_state, new_stream->signal,
 						 &new_stream->hdr10plus_infopacket);
 
@@ -5573,7 +5573,8 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 				amdgpu_dm_dvbridge_refused_stream(connector, &new_crtc_state->mode,
 								  new_stream,
 								  dm_new_conn_state->dvbridge_dv_low_latency,
-								  dm_new_conn_state->dvbridge_dv_hdmi14b);
+								  dm_new_conn_state->dvbridge_dv_hdmi14b,
+								  dm_new_conn_state->dvbridge_hdr10t);
 				goto fail;
 			}
 		}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index d76e9d5eb..fa5e1e187 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1110,6 +1110,11 @@ struct dm_connector_state {
 	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
 	 */
 	bool dvbridge_dv_hdmi14b;
+	/*
+	 * Hades: DVBRIDGE_HDR10_TUNNEL_LAB: with the tunnel requested, it carries HDR as YCbCr 4:2:2
+	 * at 12 bits (drm_dvbridge_hdr10t.h); without it, nothing
+	 */
+	bool dvbridge_hdr10t;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 	bool dvbridge_hdr10_deep_color;
 	/*
@@ -1129,7 +1134,7 @@ void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
 				       const struct dc_stream_state *stream, bool low_latency,
-				       bool hdmi14b);
+				       bool hdmi14b, bool hdr10t);
 void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 					const struct drm_crtc_state *crtc_state);
 void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
