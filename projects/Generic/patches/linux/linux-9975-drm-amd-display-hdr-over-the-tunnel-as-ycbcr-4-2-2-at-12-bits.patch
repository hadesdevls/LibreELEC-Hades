@@ -2911,6 +2956,14 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EOPNOTSUPP;
 		dm_new_state->dvbridge_dv_hdmi14b = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_hdr10t_property) {
+		/* Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) */
