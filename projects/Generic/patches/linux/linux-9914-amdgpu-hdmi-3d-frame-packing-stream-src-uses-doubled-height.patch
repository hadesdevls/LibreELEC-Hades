From 0d0b1bc2d7b94aac535b8aa7f2dfc1cf464248a6 Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:29:35 +0200
Subject: [PATCH] amdgpu: hdmi 3d frame packing stream src uses doubled height

0104-amdgpu-hdmi-3d-frame-packing-stream-src-uses-doubled-height.patch
of cinema-ONE's LibreELEC tree
(https://github.com/cinema-ONE/LibreELEC.tv,
packages/linux/patches/default, as of 8f7810a9d203). The file there is a
plain diff without a description of its own: the subject above is its
file name, and the author and the date are those of the commit that
carries it, 4e703345b57a ("linux: carry the amdgpu HDMI 3D and 8K
patches (0100-0108)").

[Hades: no line of code differs from the original; the diff is
regenerated against Linux 7.2.10 with Hades' patches, whose Dolby Vision
tunnel moves the hunk]

[Hades, ported to Linux 7.3: 7.3 split amdgpu_dm.c; the hunk goes with
update_stream_scaling_settings(), now amdgpu_dm_update_stream_scaling_settings()
in amdgpu_dm_connector.c with the same body. No line of code differs from
the original]
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c  | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 31a5e80..a878bc1 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1427,9 +1427,12 @@ void amdgpu_dm_update_stream_scaling_settings(struct drm_device *dev,
 	if (!mode)
 		return;
 
-	/* Full screen scaling by default */
-	src.width = mode->hdisplay;
-	src.height = mode->vdisplay;
+	/* Full screen scaling by default. A frame-packed 3D mode scans out the
+	 * doubled timing (two eyes plus the active space), so take the CRTC
+	 * height, not the per-eye vdisplay: with 1080 here against a 2205-line
+	 * destination the aspect fit keeps 1080 lines and centres them, showing
+	 * the first eye across both eye windows and none of the second. */
+	drm_mode_get_hv_timing(mode, &src.width, &src.height);
 	dst.width = stream->timing.h_addressable;
 	dst.height = stream->timing.v_addressable;
 
