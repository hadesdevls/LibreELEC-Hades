From a4cf6d9aec3dbd01f0d864c66ce4f17b2b1158de Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:17:06 +0000
Subject: [PATCH] drm/i915: the HDMI 1.4b signal of the Dolby Vision tunnel

DVBRIDGE_DV_HDMI14B_LAB, a connector property next to
DVBRIDGE_DV_LOW_LATENCY_LAB and with its rules (HDMI connectors,
enable_dv_lab, dropped with the CRTC and for the console, a change with
the tunnel on is a full modeset): with DVBRIDGE_DV_STANDARD_LAB, the same
byte exact tunnel goes out next to the HDMI 1.4b vendor InfoFrame of
Dolby Vision, with the HDMI VIC of 2160p24, 25 and 30, and the tunnel's
AVI InfoFrame with VIC 0 in those modes (drm_dvbridge.h), to a sink
whose EDID read at detect asks for that signal. With Low-Latency the
commit is refused (no sink asks for both), and a refusal says why.

The frame is the vendor DIP's, read back through hdmi_infoframe_unpack()
for the state check; intel_dv_lab_active() takes it for the tunnel, so
the tunnel's exactness checks and its fastset rule cover it, and going
to it or from it is a modeset.

Why: TVs of 2016 (the LG OLEDs among them) and some later ones have
Dolby Vision only with this signal. With the property 0 (its default)
nothing changes: every new line is behind it, and the frame that
intel_dv_lab_active() now also takes is only made with it. W=1, no
warnings.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 24 ++++++++++-
 drivers/gpu/drm/i915/display/intel_display.c  | 18 ++++++--
 .../drm/i915/display/intel_display_types.h    |  7 ++++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 42 ++++++++++++++++---
 4 files changed, 82 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index eed53b7..b3386c2 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -74,6 +74,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_low_latency;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_lab_hdmi14b_property &&
+	    property == to_intel_connector(connector)->dv_lab_hdmi14b_property) {
+		*val = intel_conn_state->dv_lab_hdmi14b;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		*val = intel_conn_state->dv_hdr10_deep_color;
@@ -136,6 +141,16 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_low_latency = val;
 		return 0;
 	}
+	/* Hades: the HDMI 1.4b signal of the tunnel (drm_dvbridge.h) */
+	if (to_intel_connector(connector)->dv_lab_hdmi14b_property &&
+	    property == to_intel_connector(connector)->dv_lab_hdmi14b_property) {
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !display->params.enable_dv_lab)
+			return -EOPNOTSUPP;
+		intel_conn_state->dv_lab_hdmi14b = val;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		if (val > 1)
@@ -186,6 +201,8 @@ void intel_digital_connector_client_restore(struct drm_connector *connector,
 			 s->dv_lab_low_latency, s->dv_hdr10_deep_color);
 	s->dv_lab_standard = false;
 	s->dv_lab_low_latency = false;
+	/* (Hades: the HDMI 1.4b signal goes with the tunnel, which the line above names) */
+	s->dv_lab_hdmi14b = false;
 	s->dv_hdr10_deep_color = false;
 }
 
@@ -208,6 +225,8 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 		new_conn_state->dv_lab_standard = false;
 		/* Hades: ... and Low-Latency over the tunnel */
 		new_conn_state->dv_lab_low_latency = false;
+		/* Hades: ... and its HDMI 1.4b signal */
+		new_conn_state->dv_lab_hdmi14b = false;
 		/* Hades: a disabled connector drops the HDR10 depth guard as well */
 		new_conn_state->dv_hdr10_deep_color = false;
 		return 0;
@@ -221,11 +240,14 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	 * (Hades: the HDR10 depth guard as well. It changes nothing of the output: the
 	 * configuration is computed again only so that the guard sees the depth of the link.
 	 * And DVBRIDGE_HDR_YCBCR420, which can change the format of HDR: a full modeset then.
-	 * And going from Standard to Low-Latency, or back, with the tunnel on.)
+	 * And going from Standard to Low-Latency, or back, with the tunnel on, and to the HDMI 1.4b
+	 * signal or back.)
 	 */
 	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
 	    (new_conn_state->dv_lab_standard &&
 	     new_conn_state->dv_lab_low_latency != old_conn_state->dv_lab_low_latency) ||
+	    (new_conn_state->dv_lab_standard &&
+	     new_conn_state->dv_lab_hdmi14b != old_conn_state->dv_lab_hdmi14b) ||
 	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
 	    new_conn_state->dv_hdr_ycbcr420 != old_conn_state->dv_hdr_ycbcr420 ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index 61220ce..196df0e 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -4323,10 +4323,21 @@ static int hsw_compute_linetime_wm(struct intel_atomic_state *state,
 	return 0;
 }
 
+/*
+ * Hades: the tunnel signalled with the HDMI 1.4b vendor InfoFrame of Dolby Vision: the HDMI one of
+ * its length, which no HDMI vendor InfoFrame has (drm_dvbridge.h)
+ */
+static bool intel_dv_lab_hdmi14b(const struct intel_crtc_state *state)
+{
+	return state->infoframes.hdmi.vendor.any.oui == HDMI_IEEE_OUI &&
+		state->infoframes.hdmi.vendor.any.length == HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE;
+}
+
 static bool intel_dv_lab_active(const struct intel_crtc_state *state)
 {
-	return state->infoframes.hdmi.vendor.any.oui == HDMI_DOLBY_IEEE_OUI &&
-		state->infoframes.hdmi.vendor.dolby.signal;
+	return (state->infoframes.hdmi.vendor.any.oui == HDMI_DOLBY_IEEE_OUI &&
+		state->infoframes.hdmi.vendor.dolby.signal) ||
+	       intel_dv_lab_hdmi14b(state);
 }
 
 /* Hades: the tunnel carries Dolby Vision Low-Latency (drm_dvbridge_ll.h) */
@@ -6008,7 +6019,8 @@ static void intel_crtc_check_fastset(const struct intel_crtc_state *old_crtc_sta
 
 	/* Never transition the private vendor mode through the HDR-only fastset. */
 	if (intel_dv_lab_active(old_crtc_state) != intel_dv_lab_active(new_crtc_state) ||
-	    intel_dv_lab_low_latency(old_crtc_state) != intel_dv_lab_low_latency(new_crtc_state)) {
+	    intel_dv_lab_low_latency(old_crtc_state) != intel_dv_lab_low_latency(new_crtc_state) ||
+	    intel_dv_lab_hdmi14b(old_crtc_state) != intel_dv_lab_hdmi14b(new_crtc_state)) {
 		new_crtc_state->uapi.mode_changed = true;
 		new_crtc_state->update_lrr = false;
 		new_crtc_state->update_m_n = false;
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index e4e1952..64cddab 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -529,6 +529,8 @@ struct intel_connector {
 	struct drm_property *dv_lab_property;
 	/* Hades: DVBRIDGE_DV_LOW_LATENCY_LAB, Low-Latency over that tunnel (drm_dvbridge_ll.h) */
 	struct drm_property *dv_lab_ll_property;
+	/* Hades: DVBRIDGE_DV_HDMI14B_LAB, that tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
+	struct drm_property *dv_lab_hdmi14b_property;
 	/*
 	 * Hades, gated by enable_dv_lab too: DVBRIDGE_HDR10_DEEP_COLOR, the guard that refuses a
 	 * commit sending HDR10 with fewer than 10 bits per component, and DVBRIDGE_REFUSED, why
@@ -653,6 +655,11 @@ struct intel_digital_connector_state {
 	 * Low-Latency (drm_dvbridge_ll.h); without it, nothing
 	 */
 	bool dv_lab_low_latency;
+	/*
+	 * Hades: DVBRIDGE_DV_HDMI14B_LAB: with the tunnel requested, it is signalled with the HDMI
+	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
+	 */
+	bool dv_lab_hdmi14b;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR (scalar as well) */
 	bool dv_hdr10_deep_color;
 	/*
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index af7a7ac..9a0abdb 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -879,6 +879,9 @@ intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 		/* Hades: what the sink's Low-Latency input reads the same bytes as */
 		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
 			drm_dvbridge_ll_avi(frame);
+		/* Hades: with the HDMI 1.4b signal, VIC 0 where its vendor InfoFrame has the HDMI VIC */
+		if (to_intel_digital_connector_state(conn_state)->dv_lab_hdmi14b)
+			drm_dvbridge_hdmi14b_avi(frame, vic);
 	}
 
 	/* Hades: the CTA VIC in place of the HDMI VIC, where HDR10+ takes the vendor DIP (intel_hdr10plus.h) */
@@ -961,6 +964,15 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 		if (!drm_dvbridge_avi_vic(drm_match_cea_mode(&crtc_state->hw.adjusted_mode)) ||
 		    (crtc_state->hw.adjusted_mode.flags & DRM_MODE_FLAG_3D_MASK))
 			return false;
+		/* Hades: the HDMI 1.4b signal, with the HDMI VIC of the mode (drm_dvbridge.h) */
+		if (to_intel_digital_connector_state(conn_state)->dv_lab_hdmi14b) {
+			struct hdmi_dolby_hdmi14b_infoframe *dv14 =
+				&crtc_state->infoframes.hdmi.vendor.dolby_hdmi14b;
+
+			drm_dvbridge_tunnel_hdmi14b_vsif(dv14,
+				drm_match_cea_mode(&crtc_state->hw.adjusted_mode));
+			return hdmi_dolby_hdmi14b_infoframe_check(dv14) == 0;
+		}
 		drm_dvbridge_tunnel_vsif(dv);
 		/* Hades: ... with low latency (drm_dvbridge_ll.h) */
 		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
@@ -2723,7 +2735,7 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 					      struct intel_connector *connector,
 					      const struct intel_crtc_state *pipe_config,
 					      const struct intel_dv_lab_link *link, u64 bits,
-					      bool low_latency, char *buf, size_t size)
+					      bool low_latency, bool hdmi14b, char *buf, size_t size)
 {
 	struct intel_hdmi *hdmi = enc_to_intel_hdmi(encoder);
 	const bool vbt_dual_mode = intel_bios_encoder_supports_dp_dual_mode(encoder->devdata);
@@ -2735,7 +2747,11 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 				 len ? "; " : "", DISPLAY_VER(to_intel_display(encoder)),
 				 to_intel_display(encoder)->params.enable_dv_lab);
 	/* (Hades: what the EDID read at detect lacks, drm_dvbridge.h) */
-	if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && low_latency)
+	if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && hdmi14b)
+		/* Hades: the rule of the HDMI 1.4b signal (drm_dvbridge.h) */
+		len += scnprintf(buf + len, size - len, "%sHDMI 1.4b: %s", len ? "; " : "",
+				 drm_dvbridge_sink_takes_hdmi14b_why(&connector->dv_sink) ?: "EDID");
+	else if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && low_latency)
 		/* Hades: the rule of Low-Latency over the tunnel (drm_dvbridge_ll.h) */
 		len += scnprintf(buf + len, size - len, "%sLow-Latency: %s", len ? "; " : "",
 				 drm_dvbridge_sink_takes_why(&connector->dv_sink, true) ?: "EDID");
@@ -2930,12 +2946,15 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		 */
 		const bool low_latency =
 			to_intel_digital_connector_state(conn_state)->dv_lab_low_latency;
+		/* Hades: ... or the Standard tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
+		const bool hdmi14b = to_intel_digital_connector_state(conn_state)->dv_lab_hdmi14b;
 		struct intel_dv_lab_link link = {
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
 				intel_dv_lab_platform_supported(DISPLAY_VER(display)),
-			.sink_standard = drm_dvbridge_sink_takes(sink, low_latency),
-			.sink_2160p60 = sink->p60,
+			.sink_standard = hdmi14b ? drm_dvbridge_sink_takes_hdmi14b(sink) :
+					 drm_dvbridge_sink_takes(sink, low_latency),
+			.sink_2160p60 = hdmi14b ? sink->hdmi14b_p60 : sink->p60,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
 			.native_hdmi = intel_dv_lab_native_hdmi(
@@ -2958,6 +2977,12 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		};
 
 		drm_modeset_lock_assert_held(&display->drm->mode_config.connection_mutex);
+		/* Hades: no display asks for Low-Latency with the HDMI 1.4b signal */
+		if (low_latency && hdmi14b) {
+			intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT),
+						    "Low-Latency and the HDMI 1.4b signal together");
+			return -EINVAL;
+		}
 		ret = intel_dv_lab_validate(&link);
 		if (ret) {
 			/* Hades: why, for user space and the kernel log */
@@ -2965,7 +2990,8 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 							       INTEL_OUTPUT_FORMAT_YCBCR420);
 
 			intel_hdmi_dvbridge_tunnel_detail(encoder, connector, pipe_config, &link,
-							  bits, low_latency, detail, sizeof(detail));
+							  bits, low_latency, hdmi14b, detail,
+							  sizeof(detail));
 			intel_hdmi_dvbridge_refused(connector, bits, detail);
 			return ret;
 		}
@@ -3323,6 +3349,12 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			if (connector->dv_lab_ll_property)
 				drm_object_attach_property(&_connector->base,
 							   connector->dv_lab_ll_property, 0);
+			/* Hades: the HDMI 1.4b signal of the same tunnel (drm_dvbridge.h) */
+			connector->dv_lab_hdmi14b_property = drm_property_create_bool(display->drm,
+				DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_HDMI14B_LAB");
+			if (connector->dv_lab_hdmi14b_property)
+				drm_object_attach_property(&_connector->base,
+							   connector->dv_lab_hdmi14b_property, 0);
 		}
 	}
 
