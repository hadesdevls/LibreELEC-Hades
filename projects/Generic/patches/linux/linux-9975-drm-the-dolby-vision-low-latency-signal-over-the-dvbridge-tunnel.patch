From 419dae6acc12cda6b714ed6b2e01d73191dbd265 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:59:19 +0000
Subject: [PATCH] drm: the Dolby Vision Low-Latency signal over the dvbridge
 tunnel

Some displays take Dolby Vision as Low-Latency ("player-led") only: a
Sony of 2020, and the LG C5 in its game mode, whose Dolby VSVDB says
interface 0 (YCbCr 4:2:2 at 12 bits, Low-Latency alone). There the
player maps the picture to the display itself and sends it next to the
Dolby VSIF with low_latency set and an AVI InfoFrame of YCbCr 4:2:2,
limited range, BT.2020, with no metadata in the picture and no HDR
InfoFrame: the Low-Latency signal of the Amlogic HDMI transmitter
(CoreELEC linux-amlogic, hdmitx_set_vsif_pkt() and its AVI), with the
VSIF fields as the Dolby packer of linux-9900-08 has them.

The byte exact RGB 8 bpc tunnel of DVBRIDGE_DV_STANDARD_LAB already
carries YCbCr 4:2:2 at 12 bits in its pixels (the luma in G, the high
chroma bits in R, the low bits of both in B), so with that AVI
InfoFrame the same scanout is the Low-Latency input. Add, in one header
that amdgpu and i915 share: the rule for such a sink (exactly one Dolby
VSVDB of 12 bytes or more, version 2 with any interface or the 12-byte
version 1 block with low latency 1, by the walk of the Standard rule,
which Kodi's CDisplayInfo follows too; no display management version,
as no metadata is sent), its reasons for the kernel log, and the AVI
and VSIF fields. The AVI fields are those the two drivers send for
their own YCbCr output: RGB quantization default, YCC limited. Nothing
uses the header yet.

That the tunnel's layout is the HDMI 4:2:2 pixel encoding comes from
those sources, not from the HDMI specification (not public): a test
pattern on the display shows it at once.
---
 include/drm/drm_dvbridge_ll.h | 193 ++++++++++++++++++++++++++++++++++
 1 file changed, 193 insertions(+)
 create mode 100644 include/drm/drm_dvbridge_ll.h

diff --git a/include/drm/drm_dvbridge_ll.h b/include/drm/drm_dvbridge_ll.h
new file mode 100644
index 000000000..74ada169b
--- /dev/null
+++ b/include/drm/drm_dvbridge_ll.h
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * DVBRIDGE_DV_LOW_LATENCY_LAB: Dolby Vision Low-Latency ("player-led") over the byte exact RGB
+ * 8 bpc tunnel that DVBRIDGE_DV_STANDARD_LAB turns on (amdgpu, i915 and xe).
+ *
+ * The tunnel carries YCbCr 4:2:2 at 12 bits in the RGB 8 bpc pixels: the luma in G, the high
+ * eight bits of the chroma sample in R and the low four bits of both in B, the layout of the
+ * HDMI 4:2:2 pixel encoding. With Dolby Vision Standard (TV-led) the sink reads them as its
+ * Standard input, with the display management metadata in the chroma LSBs, next to a Dolby VSIF
+ * and an AVI InfoFrame that says RGB. With DVBRIDGE_DV_LOW_LATENCY_LAB set as well, user space
+ * scans out a picture it has already mapped to the display (PQ, BT.2020, narrow range) with no
+ * metadata in the chroma LSBs, and the kernel says what the sink's Low-Latency input expects: the
+ * Dolby VSIF with low_latency set, and an AVI InfoFrame that says YCbCr 4:2:2, limited range,
+ * BT.2020. That is the input of every version 2 Dolby VSVDB (interface 0 is YCbCr 4:2:2 at
+ * 12 bits Low-Latency alone) and of the 12-byte version 1 block with low latency. No HDR
+ * InfoFrame is sent, as with Standard. The scanout, its checks, the modes, VRR and the refusals
+ * are those of the Standard tunnel: only the InfoFrames and the rule for the sink change.
+ *
+ * Sources, which agree: the Low-Latency signal of the Amlogic HDMI transmitter (CoreELEC
+ * linux-amlogic, hdmitx_set_vsif_pkt(), GPL) and the Dolby VSIF packer this tunnel already uses
+ * (hdmi_dolby_vendor_infoframe_pack()). That the tunnel's layout is the HDMI 4:2:2 pixel encoding
+ * comes from those sources too, not from the HDMI specification (not public): a sink shows it at
+ * once with a test pattern.
+ *
+ * The AVI fields are those that amdgpu's display core and i915 send for their own YCbCr output:
+ * RGB quantization range default, YCC quantization range limited.
+ *
+ * Nothing here touches a kernel object, so that a test can build it on the host.
+ */
+#ifndef __DRM_DVBRIDGE_LL_H__
+#define __DRM_DVBRIDGE_LL_H__
+
+#include <linux/hdmi.h>
+#include <linux/types.h>
+
+/*
+ * An EDID with exactly one Dolby VSVDB that advertises Dolby Vision Low-Latency in YCbCr 4:2:2
+ * at 12 bits: version 2, whatever its interface field (0 Low-Latency alone, 1 with LL-HDMI, 2
+ * with Standard, 3 all three), or version 1 in its 12-byte form with the low-latency field 1.
+ * The walk and its refusals are those of the Standard rule (amdgpu_dm_dvbridge_edid_standard(),
+ * intel_dv_lab_edid()); Kodi reads the EDID with the same rule (CDisplayInfo). No display
+ * management version is needed: no metadata is sent. *p60: the sink takes it at 2160p50 and
+ * 2160p60, always with version 2.
+ */
+static inline bool drm_dvbridge_ll_edid(const u8 *edid, size_t size, bool *p60)
+{
+	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	unsigned int block, i, found = 0;
+	bool low_latency = false;
+
+	*p60 = false;
+	/* An HDMI Forum EEODB makes the EDID longer than its base block's extension count. */
+	if (!edid || size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
+		return false;
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return false;
+	for (block = 0; block < size / 128; block++) {
+		const u8 *b = edid + block * 128;
+		unsigned int end, pos;
+		u8 sum = 0;
+
+		for (i = 0; i < 128; i++)
+			sum += b[i];
+		if (sum)
+			return false;
+		if (!block || b[0] != 0x02 || b[1] < 3)
+			continue;
+		end = b[2];
+		if (!end)
+			continue;
+		if (end < 4 || end > 127)
+			return false;
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const u8 *data = b + pos + 1;
+
+			if (pos + len + 1 > end)
+				return false;
+			/* Extended vendor-specific video block, little-endian Dolby OUI */
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1 || len < 11)
+					return false;
+				switch (data[4] >> 5) {
+				case 2:
+					low_latency = true;
+					*p60 = true;
+					break;
+				case 1:
+					low_latency = len == 11 && (data[7] & 3) == 1;
+					*p60 = data[4] & 2;
+					break;
+				default:
+					return false;
+				}
+			}
+			pos += len + 1;
+		}
+	}
+	return found == 1 && low_latency;
+}
+
+/*
+ * Why drm_dvbridge_ll_edid() does not take an EDID, for the kernel log: the same walk and the
+ * same tests in the same order. NULL exactly when it takes it.
+ */
+static inline const char *drm_dvbridge_ll_edid_why(const u8 *edid, size_t size)
+{
+	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	unsigned int block, i, found = 0, version = 0;
+	bool low_latency = false;
+
+	if (!edid || !size)
+		return "no EDID";
+	if (size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
+		return "the EDID is not whole blocks, or shorter than its extension count says";
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return "the EDID header is not valid";
+	for (block = 0; block < size / 128; block++) {
+		const u8 *b = edid + block * 128;
+		unsigned int end, pos;
+		u8 sum = 0;
+
+		for (i = 0; i < 128; i++)
+			sum += b[i];
+		if (sum)
+			return "an EDID block has a wrong checksum";
+		if (!block || b[0] != 0x02 || b[1] < 3)
+			continue;
+		end = b[2];
+		if (!end)
+			continue;
+		if (end < 4 || end > 127)
+			return "a CTA extension block is not valid";
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const u8 *data = b + pos + 1;
+
+			if (pos + len + 1 > end)
+				return "a CTA data block is not valid";
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1)
+					return "the EDID has several Dolby Vision blocks";
+				if (len < 11)
+					return "the Dolby Vision block is shorter than 12 bytes";
+				version = data[4] >> 5;
+				switch (version) {
+				case 2:
+					low_latency = true;
+					break;
+				case 1:
+					low_latency = len == 11 && (data[7] & 3) == 1;
+					break;
+				case 0:
+					return "the Dolby Vision block is version 0, which has no Low-Latency mode";
+				default:
+					return "the Dolby Vision block has a version this driver does not know";
+				}
+			}
+			pos += len + 1;
+		}
+	}
+	if (!found)
+		return "the EDID has no Dolby Vision block";
+	if (!low_latency)
+		return "the version 1 Dolby Vision block is not the 12-byte one with low latency 1";
+	return NULL;
+}
+
+/*
+ * The AVI InfoFrame of the Low-Latency signal, from the one the driver built for the mode and
+ * the tunnel (its VIC, aspect ratio, content type): YCbCr 4:2:2, BT.2020, limited range.
+ */
+static inline void drm_dvbridge_ll_avi(struct hdmi_avi_infoframe *frame)
+{
+	frame->colorspace = HDMI_COLORSPACE_YUV422;
+	frame->colorimetry = HDMI_COLORIMETRY_EXTENDED;
+	frame->extended_colorimetry = HDMI_EXTENDED_COLORIMETRY_BT2020;
+	frame->quantization_range = HDMI_QUANTIZATION_RANGE_DEFAULT;
+	frame->ycc_quantization_range = HDMI_YCC_QUANTIZATION_RANGE_LIMITED;
+}
+
+/* The Dolby VSIF of the Low-Latency signal: the Dolby Vision signal with low latency. */
+static inline void drm_dvbridge_ll_vsif(struct hdmi_dolby_vendor_infoframe *frame)
+{
+	frame->signal = true;
+	frame->low_latency = true;
+}
+
+#endif /* __DRM_DVBRIDGE_LL_H__ */
-- 
2.53.0

