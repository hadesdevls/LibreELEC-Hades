From d03048633a0fd97f6b91c2b86306d7f7dfd9a4d2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:52:52 +0000
Subject: [PATCH] drm/i915/hdmi: take the Dolby Vision blocks that amdgpu and
 Kodi take

intel_dv_lab_edid(), from the Intel Dolby Vision fork, takes one Dolby
VSVDB only: the 12-byte version 2 block with the Standard interface, in
an EDID whose size is exactly what its extension count says. amdgpu
(linux-9910) and Kodi (CDisplayInfo) share another rule: version 2 with
interface 2 or 3, 12 bytes or longer, or the 12-byte version 1 block
with the low-latency field 1 and display management 4 or later, all of
them Standard Dolby Vision with the Dolby vendor InfoFrame, the one the
tunnel sends (version 0, the 15-byte version 1 block and the
low-latency field 0 mean the HDMI 1.4b vendor InfoFrame, which it does
not send), in an EDID that an HDMI Forum EEODB may make longer than its
extension count. So a TV with a version 1 block, or with an EEODB, had
native output on AMD and not on Intel, and Kodi had to tell it so
("driveredid").

i915 now takes the same blocks: intel_dv_lab_edid() is the walk of
amdgpu_dm_dvbridge_edid_standard(), and says as it does whether the
sink takes Dolby Vision at 2160p50 and 2160p60 (always with version 2;
with version 1, the 2160p60 bit of its block). A version 1 sink without
it is refused at 3840x2160 above 30 Hz, as on amdgpu, with the reason
edid-2160p30 in DVBRIDGE_REFUSED and in the kernel log.
intel_dv_lab_edid_why() follows the same walk and says which form of
block it found. sink_standard_v2 of the link becomes sink_standard,
beside sink_2160p60. The transport does not change: the blocks taken
now ask for the same Dolby vendor InfoFrame.

A host test compares the two kernel copies and Kodi's, taken out of
the trees as they are, on every form of one Dolby block (length,
version, display management, 2160p60 bit, interface, low-latency
field), with and without an EEODB, and on two million random mutations
of valid EDIDs: the three take the same EDIDs and say the same of
2160p60. It also checks that intel_dv_lab_edid_why() gives a reason
exactly when the EDID is refused, and that intel_dv_lab_refused() names
edid-2160p30 exactly where intel_dv_lab_validate() refuses for it;
twenty-two mutations of the headers make it fail.
---
 .../drm/i915/display/intel_dv_lab_policy.h    | 87 +++++++++++++++----
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 10 ++-
 2 files changed, 80 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index 581cb80..021d535 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: MIT */
 /* Experimental Standard-DV RGB8 tunnel policy. No hardware accesses here.
- * Only EDID v2 and CTA progressive 1080p/2160p at 24–60 Hz are in scope.
+ * Only the Dolby VSVDB of intel_dv_lab_edid() and CTA progressive 1080p/2160p at 24–60 Hz are in
+ * scope (Hades: the VSVDB rule of amdgpu and Kodi; before, version 2 only).
  * Pixel packing and correctly transformed frame metadata are userspace duties;
  * passing this policy is NOT a Dolby Vision color/fidelity validation.
  */
@@ -10,13 +11,24 @@
 #include <linux/errno.h>
 #include <drm/drm_dvbridge_refused.h>
 
-static inline bool intel_dv_lab_edid(const u8 *edid, size_t size)
+/*
+ * Hades: an EDID with exactly one Dolby VSVDB that advertises Standard (TV-led) Dolby Vision with
+ * the Dolby vendor InfoFrame, by the rule of amdgpu (amdgpu_dm_dvbridge_edid_standard()) and of
+ * Kodi (CDisplayInfo), so that the three take the same displays: version 2 with interface 2 or 3,
+ * or version 1 in its 12-byte form with the low-latency field 1 (Standard and low latency) and
+ * display management 4 or later, the version of the metadata user space sends. The field 0, the
+ * 15-byte version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which this tunnel does
+ * not send. An HDMI Forum EEODB may make the EDID longer than its base block's extension count.
+ * *p60: the sink takes it at 2160p50 and 2160p60, always with version 2.
+ */
+static inline bool intel_dv_lab_edid(const u8 *edid, size_t size, bool *p60)
 {
 	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
 	unsigned int block, i, found = 0;
 	bool standard = false;
 
-	if (!edid || size < 128 || size != ((size_t)edid[126] + 1) * 128)
+	*p60 = false;
+	if (!edid || size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
 		return false;
 	for (i = 0; i < 8; i++)
 		if (edid[i] != magic[i])
@@ -46,10 +58,22 @@ static inline bool intel_dv_lab_edid(const u8 *edid, size_t size)
 			/* Extended vendor video block, little-endian Dolby OUI. */
 			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
 			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
-				if (++found != 1 || len != 11 || (data[4] >> 5) != 2)
+				if (++found != 1 || len < 11)
+					return false;
+				switch (data[4] >> 5) {
+				case 2:
+					/* VSVDB v2 interface 2 or 3 advertises Standard DV */
+					standard = (data[6] & 3) >= 2;
+					*p60 = true;
+					break;
+				case 1:
+					standard = len == 11 && (data[7] & 3) == 1 &&
+						   ((data[4] >> 2) & 7) >= 2;
+					*p60 = data[4] & 2;
+					break;
+				default:
 					return false;
-				/* EDID v2 interface 2/3 advertises Standard DV. */
-				standard = (data[6] & 3) >= 2;
+				}
 			}
 			pos += len + 1;
 		}
@@ -64,13 +88,13 @@ static inline bool intel_dv_lab_edid(const u8 *edid, size_t size)
 static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
 {
 	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
-	unsigned int block, i, found = 0;
+	unsigned int block, i, found = 0, version = 0;
 	bool standard = false;
 
 	if (!edid || !size)
 		return "no EDID";
-	if (size < 128 || size != ((size_t)edid[126] + 1) * 128)
-		return "the EDID is longer or shorter than its extension count says (an HDMI Forum EEODB, which this driver does not read)";
+	if (size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
+		return "the EDID is not whole blocks, or shorter than its extension count says";
 	for (i = 0; i < 8; i++)
 		if (edid[i] != magic[i])
 			return "the EDID header is not valid";
@@ -100,9 +124,22 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
 			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
 				if (++found != 1)
 					return "the EDID has several Dolby Vision blocks";
-				if (len != 11 || (data[4] >> 5) != 2)
-					return "the Dolby Vision block is not the 12-byte version 2 block, the only one this driver takes";
-				standard = (data[6] & 3) >= 2;
+				if (len < 11)
+					return "the Dolby Vision block is shorter than 12 bytes";
+				version = data[4] >> 5;
+				switch (version) {
+				case 2:
+					standard = (data[6] & 3) >= 2;
+					break;
+				case 1:
+					standard = len == 11 && (data[7] & 3) == 1 &&
+						   ((data[4] >> 2) & 7) >= 2;
+					break;
+				case 0:
+					return "the Dolby Vision block is version 0, for the HDMI 1.4b vendor InfoFrame, which this driver does not send";
+				default:
+					return "the Dolby Vision block has a version this driver does not know";
+				}
 			}
 			pos += len + 1;
 		}
@@ -110,7 +147,9 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
 	if (!found)
 		return "the EDID has no Dolby Vision block";
 	if (!standard)
-		return "the Dolby Vision block has no Standard interface (Low-Latency only)";
+		return version == 2 ?
+		       "the Dolby Vision block has no Standard interface (Low-Latency only)" :
+		       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1 and display management 4 or later (it asks for the HDMI 1.4b vendor InfoFrame, or older metadata)";
 	return NULL;
 }
 
@@ -125,8 +164,12 @@ static inline bool intel_dv_lab_native_hdmi(bool lspcon_active,
 	return !lspcon_active && (!dual_mode_detected || !vbt_dual_mode);
 }
 
+/*
+ * (Hades: sink_standard, the sink's EDID by intel_dv_lab_edid(); sink_2160p60, what it says of
+ * 2160p50 and 2160p60.)
+ */
 struct intel_dv_lab_link {
-	bool requested, lab_enabled, sink_standard_v2, hdmi, native_hdmi;
+	bool requested, lab_enabled, sink_standard, sink_2160p60, hdmi, native_hdmi;
 	bool rgb, limited_range, hdr_blob, cloned, progressive;
 	unsigned int requested_bpc, pipe_bpp, colorspace;
 	unsigned int width, height, rounded_refresh;
@@ -147,11 +190,18 @@ static inline unsigned int intel_dv_lab_avi_vic(unsigned int cea_vic)
         }
 }
 
+/* Hades: the mode is 3840x2160 at 50 or 60 Hz (CTA VIC 96 or 97, or their fractional clocks) */
+static inline bool intel_dv_lab_2160p60(const struct intel_dv_lab_link *s)
+{
+	return s->width == 3840 && s->height == 2160 &&
+	       (s->rounded_refresh == 50 || s->rounded_refresh == 60);
+}
+
 static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 {
 	if (!s->requested)
 		return 0;
-	if (!s->lab_enabled || !s->sink_standard_v2 || !s->native_hdmi)
+	if (!s->lab_enabled || !s->sink_standard || !s->native_hdmi)
 		return -EOPNOTSUPP;
 	if (!s->hdmi || !s->rgb || s->limited_range || s->hdr_blob || s->cloned ||
 	    !s->progressive || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
@@ -163,6 +213,9 @@ static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 	if (!((s->width == 1920 && s->height == 1080) ||
 	      (s->width == 3840 && s->height == 2160)))
 		return -EINVAL;
+	/* Hades: 2160p50 and 2160p60 need a sink that advertises Dolby Vision at 2160p60 */
+	if (intel_dv_lab_2160p60(s) && !s->sink_2160p60)
+		return -EINVAL;
 	return 0;
 }
 
@@ -179,8 +232,10 @@ static inline u64 intel_dv_lab_refused(const struct intel_dv_lab_link *s, bool y
 		return 0;
 	if (!s->lab_enabled)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_DISABLED;
-	if (!s->sink_standard_v2)
+	if (!s->sink_standard)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID;
+	else if (intel_dv_lab_2160p60(s) && !s->sink_2160p60)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID_2160P30;
 	if (!s->native_hdmi)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_CONVERTER;
 	if (!s->hdmi)
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index d6af0f8..146cc3b 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2511,6 +2511,10 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 		len += scnprintf(buf + len, size - len, "%s%s", len ? "; " : "",
 				 intel_dv_lab_edid_why(edid ? edid->data : NULL,
 						       edid ? edid->length : 0) ?: "EDID");
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID_2160P30))
+		len += scnprintf(buf + len, size - len,
+				 "%sthe version 1 Dolby Vision block does not advertise 2160p60",
+				 len ? "; " : "");
 	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_CONVERTER))
 		len += scnprintf(buf + len, size - len,
 				 "%sDisplayPort dual-mode adaptor: %s, the VBT says the port is dual-mode: %s, LSPCON: %s",
@@ -2651,11 +2655,15 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 
 	if (to_intel_digital_connector_state(conn_state)->dv_lab_standard) {
 		const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
+		/* (Hades: read before the link below, whose initializers are not sequenced) */
+		bool p60 = false;
+		const bool standard = edid && intel_dv_lab_edid(edid->data, edid->length, &p60);
 		struct intel_dv_lab_link link = {
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
 				intel_dv_lab_platform_supported(DISPLAY_VER(display)),
-			.sink_standard_v2 = edid && intel_dv_lab_edid(edid->data, edid->length),
+			.sink_standard = standard,
+			.sink_2160p60 = p60,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
 			.native_hdmi = intel_dv_lab_native_hdmi(
