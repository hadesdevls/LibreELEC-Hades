From 16eba209dcfc981c299e5c410c4322d17b686b54 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:43:15 +0000
Subject: [PATCH] drm/i915/hdmi: say why the Dolby Vision tunnel is refused

intel_hdmi_compute_config() refuses the tunnel for several reasons
that user space cannot tell apart, and that a user needs to know: a
DisplayPort dual-mode adaptor in the path of an HDMI port that the VBT
calls dual-mode, a sink driven as DVI, a link that cannot carry the
mode in RGB at 8 bits (the TMDS clock of the port, of the adaptor or
of the sink, or a mode the sink takes in YCbCr 4:2:0 only), an EDID
whose Dolby Vision block this driver does not take (it takes the
12-byte version 2 block only, in an EDID without an HDMI Forum EEODB),
or a mode without the CTA VIC the AVI InfoFrame needs.

Each test that refuses now says why, through DVBRIDGE_REFUSED and the
kernel log (drm_dvbridge_refused.h): the check of a request starts from
0, and the reasons of intel_dv_lab_validate() come from
intel_dv_lab_refused(), which names a reason exactly when it refuses
(a host test checks that, and which reason, over 1.1 million
combinations of its inputs). The log
gives the figures: the TMDS clock the mode needs at 8 bpc against the
port, the adaptor and the sink, the adaptor type and what the VBT says,
the formats, and for the EDID the first test of intel_dv_lab_edid()
that fails (intel_dv_lab_edid_why(): the same walk, a reason exactly
when it refuses, checked on built EDIDs and two million mutations of
them). A refusal of the scanout of a tunnelled CRTC
(intel_dv_lab_scanout_check()) is said too, with what the CRTC and the
primary plane have, and a pass clears it.

Two cases never reach a request, and the kernel log now tells them
once at boot, where enable_dv_lab is on:
- a port whose HDMI goes through an LSPCON (VBT): its display is on a
  DisplayPort connector, which has no tunnel (many display 9 desktops
  with an onboard DisplayPort to HDMI converter, such as an MCDP2800);
- an HDMI port that sends less than 594 MHz TMDS (display 9, HDMI 1.4b
  at 300 MHz): Dolby Vision at 3840x2160 up to 30 Hz only.

Nothing that the driver decides changes: the reasons are computed only
where a request is refused, from the same values.
---
 drivers/gpu/drm/i915/display/intel_ddi.c      |  11 ++
 drivers/gpu/drm/i915/display/intel_display.c  |  57 +++++-
 .../drm/i915/display/intel_display_types.h    |   7 +
 .../drm/i915/display/intel_dv_lab_policy.h    |  95 ++++++++++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 171 +++++++++++++++++-
 5 files changed, 338 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index 95008e0..58bc9f3 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
+++ b/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -64,6 +64,7 @@
 #include "intel_dp_tunnel.h"
 #include "intel_dpio_phy.h"
 #include "intel_dsi.h"
+#include "intel_dv_lab_policy.h"
 #include "intel_encoder.h"
 #include "intel_fdi.h"
 #include "intel_fifo_underrun.h"
@@ -5241,6 +5242,16 @@ void intel_ddi_init(struct intel_display *display,
 		init_hdmi = false;
 		drm_dbg_kms(display->drm, "VBT says port %c has lspcon\n",
 			    port_name(port));
+		/*
+		 * Hades: the HDMI output of such a port is a DisplayPort connector, which the
+		 * Dolby Vision tunnel (an HDMI one) does not reach: said once, so that the kernel
+		 * log of such a machine tells why
+		 */
+		if (display->params.enable_dv_lab &&
+		    intel_dv_lab_platform_supported(DISPLAY_VER(display)))
+			drm_info(display->drm,
+				 "DVBRIDGE: port %c sends HDMI through an LSPCON (a DisplayPort to HDMI converter): its display is on a DisplayPort connector, without native Dolby Vision\n",
+				 port_name(port));
 	}
 
 	if (!init_dp && !init_hdmi) {
diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index 765b0a6..ede341c 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -4315,6 +4315,59 @@ static int intel_dv_lab_scanout_check(struct intel_atomic_state *state,
 	return 0;
 }
 
+/*
+ * Hades: what intel_dv_lab_scanout_check() found of the scanout of a CRTC that carries the
+ * tunnel (refused: its result), said to DVBRIDGE_REFUSED of the connector that the commit has on
+ * the CRTC (user space puts it in every commit of the tunnel): SCANOUT, with what the scanout has
+ * in the kernel log, or 0 when it passed.
+ */
+static void intel_dv_lab_scanout_report(struct intel_atomic_state *state,
+					struct intel_crtc *crtc, int refused)
+{
+	const struct intel_crtc_state *s = intel_atomic_get_new_crtc_state(state, crtc);
+	const struct drm_plane_state *p =
+		drm_atomic_get_new_plane_state(&state->base, crtc->base.primary);
+	struct intel_digital_connector_state *conn_state;
+	struct intel_connector *connector;
+	char detail[256];
+	size_t len;
+	int i;
+
+	if (!s->hw.active || !intel_dv_lab_active(s))
+		return;
+	if (!refused) {
+		for_each_new_intel_connector_in_state(state, connector, conn_state, i)
+			if (conn_state->base.crtc == &crtc->base && connector->dv_refused_property)
+				drm_dvbridge_refused_report(&connector->base,
+							    connector->dv_refused_property,
+							    &connector->dv_refused_log, 0, NULL);
+		return;
+	}
+	if (!p)
+		p = crtc->base.primary->state;
+	len = scnprintf(detail, sizeof(detail),
+			"CRTC: colour management %d, dither %d, VRR %d, DSC %d, scaler users %#x, planes %#x (the primary alone: %#x)",
+			!!(s->hw.ctm || s->hw.degamma_lut || s->hw.gamma_lut || s->pre_csc_lut ||
+			   s->post_csc_lut || s->gamma_enable || s->csc_enable),
+			s->dither, s->vrr.enable, s->dsc.compression_enable,
+			s->scaler_state.scaler_users, s->uapi.plane_mask,
+			drm_plane_mask(crtc->base.primary));
+	if (p && p->fb)
+		scnprintf(detail + len, sizeof(detail) - len,
+			  "; primary plane: %p4cc %ux%u, source %ux%u+%u+%u, on screen %ux%u%+d%+d, rotation %#x, alpha %#x, scaler %d",
+			  &p->fb->format->format, p->fb->width, p->fb->height,
+			  p->src_w >> 16, p->src_h >> 16, p->src_x >> 16, p->src_y >> 16,
+			  p->crtc_w, p->crtc_h, p->crtc_x, p->crtc_y, p->rotation, p->alpha,
+			  to_intel_plane_state(p)->scaler_id);
+	for_each_new_intel_connector_in_state(state, connector, conn_state, i) {
+		if (conn_state->base.crtc != &crtc->base || !connector->dv_refused_property)
+			continue;
+		drm_dvbridge_refused_report(&connector->base, connector->dv_refused_property,
+					    &connector->dv_refused_log,
+					    BIT_ULL(DRM_DVBRIDGE_REFUSED_SCANOUT), detail);
+	}
+}
+
 static int intel_crtc_atomic_check(struct intel_atomic_state *state,
 				   struct intel_crtc *crtc)
 {
@@ -4377,7 +4430,9 @@ static int intel_crtc_atomic_check(struct intel_atomic_state *state,
 	if (ret)
 		return ret;
 
-	return intel_dv_lab_scanout_check(state, crtc);
+	ret = intel_dv_lab_scanout_check(state, crtc);
+	intel_dv_lab_scanout_report(state, crtc, ret);
+	return ret;
 }
 
 static int bpc_to_bpp(int bpc)
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index ab6a8fc..1260547 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -36,6 +36,7 @@
 #include <drm/drm_atomic.h>
 #include <drm/drm_colorop.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_panel.h>
@@ -521,6 +522,12 @@ struct intel_connector {
 	struct drm_connector base;
 	/* Private experimental property; gated by enable_dv_lab. */
 	struct drm_property *dv_lab_property;
+	/*
+	 * Hades, gated by enable_dv_lab too: DVBRIDGE_REFUSED, why the last request of the tunnel
+	 * was refused, with what the kernel log has said of it (drm_dvbridge_refused.h).
+	 */
+	struct drm_property *dv_refused_property;
+	struct drm_dvbridge_refused_log dv_refused_log;
 	/*
 	 * The fixed encoder this connector is connected to.
 	 */
diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index 09933f4..581cb80 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -8,6 +8,7 @@
 #define __INTEL_DV_LAB_POLICY_H__
 #include <linux/types.h>
 #include <linux/errno.h>
+#include <drm/drm_dvbridge_refused.h>
 
 static inline bool intel_dv_lab_edid(const u8 *edid, size_t size)
 {
@@ -56,6 +57,63 @@ static inline bool intel_dv_lab_edid(const u8 *edid, size_t size)
 	return found == 1 && standard;
 }
 
+/*
+ * Hades: why intel_dv_lab_edid() does not take an EDID, for the kernel log: the same walk and
+ * the same tests in the same order. NULL exactly when it takes it.
+ */
+static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
+{
+	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	unsigned int block, i, found = 0;
+	bool standard = false;
+
+	if (!edid || !size)
+		return "no EDID";
+	if (size < 128 || size != ((size_t)edid[126] + 1) * 128)
+		return "the EDID is longer or shorter than its extension count says (an HDMI Forum EEODB, which this driver does not read)";
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return "the EDID header is not valid";
+	for (block = 0; block < size / 128; block++) {
+		const u8 *b = edid + block * 128;
+		u8 sum = 0;
+		unsigned int end, pos;
+
+		for (i = 0; i < 128; i++)
+			sum += b[i];
+		if (sum)
+			return "an EDID block has a wrong checksum";
+		if (!block || b[0] != 0x02 || b[1] < 3)
+			continue;
+		end = b[2];
+		if (!end)
+			continue;
+		if (end < 4 || end > 127)
+			return "a CTA extension block is not valid";
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const u8 *data = b + pos + 1;
+
+			if (pos + len + 1 > end)
+				return "a CTA data block is not valid";
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1)
+					return "the EDID has several Dolby Vision blocks";
+				if (len != 11 || (data[4] >> 5) != 2)
+					return "the Dolby Vision block is not the 12-byte version 2 block, the only one this driver takes";
+				standard = (data[6] & 3) >= 2;
+			}
+			pos += len + 1;
+		}
+	}
+	if (!found)
+		return "the EDID has no Dolby Vision block";
+	if (!standard)
+		return "the Dolby Vision block has no Standard interface (Low-Latency only)";
+	return NULL;
+}
+
 /* Native HDMI ports can expose a dual-mode level-shifter ID. Match the
  * topology distinction used by intel_hdmi_dp_dual_mode_detect(), rather
  * than treating that ID alone as proof of an external DP conversion.
@@ -108,6 +166,43 @@ static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 	return 0;
 }
 
+/*
+ * Hades: the reasons intel_dv_lab_validate() refuses a link, as bits of DVBRIDGE_REFUSED: not 0
+ * exactly when it refuses, with a bit for each of its tests that fails. ycbcr420: the
+ * configuration that was refused sends YCbCr 4:2:0 (the link takes the mode in no other way).
+ */
+static inline u64 intel_dv_lab_refused(const struct intel_dv_lab_link *s, bool ycbcr420)
+{
+	u64 bits = 0;
+
+	if (!s->requested)
+		return 0;
+	if (!s->lab_enabled)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_DISABLED;
+	if (!s->sink_standard_v2)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID;
+	if (!s->native_hdmi)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_CONVERTER;
+	if (!s->hdmi)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_SINK;
+	if (!s->rgb)
+		bits |= 1ULL << (ycbcr420 ? DRM_DVBRIDGE_REFUSED_YCBCR420 :
+				 DRM_DVBRIDGE_REFUSED_FORMAT);
+	if (s->limited_range || s->hdr_blob || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
+	    s->colorspace)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_FORMAT;
+	if (s->cloned)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_CLONE;
+	if (!s->progressive ||
+	    (s->rounded_refresh != 24 && s->rounded_refresh != 25 &&
+	     s->rounded_refresh != 30 && s->rounded_refresh != 50 &&
+	     s->rounded_refresh != 60) ||
+	    !((s->width == 1920 && s->height == 1080) ||
+	      (s->width == 3840 && s->height == 2160)))
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_MODE;
+	return bits;
+}
+
 /* Display9+ shares the native HDMI vendor-infoframe transport. */
 static inline bool intel_dv_lab_platform_supported(unsigned int display_ver)
 {
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 5c5b3ae..0d5a07a 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2431,6 +2431,99 @@ bool intel_hdmi_compute_has_hdmi_sink(struct intel_encoder *encoder,
 		!intel_hdmi_is_cloned(crtc_state);
 }
 
+/*
+ * Hades: a request of the Dolby Vision tunnel was checked: bits are why it was refused, 0 when it
+ * passed (DVBRIDGE_REFUSED and the kernel log, see drm_dvbridge_refused.h).
+ */
+static void intel_hdmi_dvbridge_refused(struct intel_connector *connector, u64 bits,
+					const char *detail)
+{
+	if (connector->dv_refused_property)
+		drm_dvbridge_refused_report(&connector->base, connector->dv_refused_property,
+					    &connector->dv_refused_log, bits, detail);
+}
+
+/*
+ * Hades: for the kernel log of a refusal, what the mode needs of the link and what the link
+ * takes: the TMDS clock of RGB at bpc bits per component in the mode, against the limits of the
+ * source port, of a DisplayPort dual-mode adaptor and of the sink (0: none stated). Appended at
+ * buf + len; returns the new length.
+ */
+static size_t intel_hdmi_dvbridge_link_detail(struct intel_encoder *encoder,
+					      struct intel_connector *connector,
+					      const struct drm_display_mode *mode, int bpc,
+					      char *buf, size_t len, size_t size)
+{
+	struct intel_hdmi *hdmi = enc_to_intel_hdmi(encoder);
+	const struct drm_display_info *info = &connector->base.display_info;
+	int clock = mode->crtc_clock * (mode->flags & DRM_MODE_FLAG_DBLCLK ? 2 : 1);
+
+	if (len >= size)
+		return len;
+	return len + scnprintf(buf + len, size - len,
+			       "%dx%d@%d: RGB at %d bpc needs TMDS %d kHz; the port sends up to %d kHz, the dual-mode adaptor (%s) takes %d kHz, the sink %d kHz%s",
+			       mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode), bpc,
+			       intel_hdmi_tmds_clock(clock, bpc, INTEL_OUTPUT_FORMAT_RGB),
+			       intel_hdmi_source_max_tmds_clock(encoder),
+			       drm_dp_get_dual_mode_type_name(hdmi->dp_dual_mode.type),
+			       hdmi->dp_dual_mode.max_tmds_clock, info->max_tmds_clock,
+			       drm_mode_is_420_only(info, mode) ?
+			       "; the sink takes this mode in YCbCr 4:2:0 only" : "");
+}
+
+/* Hades: what the kernel log of a refused tunnel says beside its reasons (the bits) */
+static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
+					      struct intel_connector *connector,
+					      const struct intel_crtc_state *pipe_config,
+					      const struct intel_dv_lab_link *link, u64 bits,
+					      char *buf, size_t size)
+{
+	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
+	struct intel_hdmi *hdmi = enc_to_intel_hdmi(encoder);
+	const bool vbt_dual_mode = intel_bios_encoder_supports_dp_dual_mode(encoder->devdata);
+	size_t len = 0;
+
+	buf[0] = '\0';
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_DISABLED))
+		len += scnprintf(buf + len, size - len, "%sdisplay version %u, enable_dv_lab %d",
+				 len ? "; " : "", DISPLAY_VER(to_intel_display(encoder)),
+				 to_intel_display(encoder)->params.enable_dv_lab);
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID))
+		len += scnprintf(buf + len, size - len, "%s%s", len ? "; " : "",
+				 intel_dv_lab_edid_why(edid ? edid->data : NULL,
+						       edid ? edid->length : 0) ?: "EDID");
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_CONVERTER))
+		len += scnprintf(buf + len, size - len,
+				 "%sDisplayPort dual-mode adaptor: %s, the VBT says the port is dual-mode: %s, LSPCON: %s",
+				 len ? "; " : "",
+				 drm_dp_get_dual_mode_type_name(hdmi->dp_dual_mode.type),
+				 str_yes_no(vbt_dual_mode),
+				 str_yes_no(enc_to_dig_port(encoder)->lspcon.active));
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_SINK))
+		len += scnprintf(buf + len, size - len,
+				 "%sHDMI sink: %s, InfoFrames: %s", len ? "; " : "",
+				 str_yes_no(pipe_config->has_hdmi_sink),
+				 str_yes_no(connector->base.display_info.has_hdmi_infoframe));
+	if (bits & (BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT) | BIT_ULL(DRM_DVBRIDGE_REFUSED_YCBCR420)))
+		len += scnprintf(buf + len, size - len,
+				 "%s%s at %u bpp, max bpc %u, limited range %d, HDR metadata %d, colorimetry %u",
+				 len ? "; " : "",
+				 pipe_config->sink_format == INTEL_OUTPUT_FORMAT_YCBCR420 ?
+				 "YCbCr 4:2:0" : "RGB", link->pipe_bpp, link->requested_bpc,
+				 link->limited_range, link->hdr_blob, link->colorspace);
+	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_YCBCR420)) {
+		len += scnprintf(buf + len, size - len, "; ");
+		len = intel_hdmi_dvbridge_link_detail(encoder, connector,
+						      &pipe_config->hw.adjusted_mode, 8,
+						      buf, len, size);
+	}
+	if (bits & (BIT_ULL(DRM_DVBRIDGE_REFUSED_MODE) | BIT_ULL(DRM_DVBRIDGE_REFUSED_CLONE)))
+		len += scnprintf(buf + len, size - len, "%s%ux%u@%u%s%s", len ? "; " : "",
+				 link->width, link->height, link->rounded_refresh,
+				 link->progressive ? "" : ", not progressive 2D",
+				 link->cloned ? ", cloned" : "");
+}
+
 int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			      struct intel_crtc_state *pipe_config,
 			      struct drm_connector_state *conn_state)
@@ -2439,8 +2532,18 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	struct drm_display_mode *adjusted_mode = &pipe_config->hw.adjusted_mode;
 	struct intel_connector *connector = to_intel_connector(conn_state->connector);
 	struct drm_scdc *scdc = &connector->base.display_info.hdmi.scdc;
+	/* Hades: a request of the Dolby Vision tunnel */
+	const bool dv_requested = to_intel_digital_connector_state(conn_state)->dv_lab_standard;
+	char detail[256];
 	int ret;
 
+	/*
+	 * Hades: what the last check of such a request found is cleared; each test below that
+	 * refuses it says why (it stays 0 when it passes)
+	 */
+	if (dv_requested)
+		intel_hdmi_dvbridge_refused(connector, 0, NULL);
+
 	if (adjusted_mode->flags & DRM_MODE_FLAG_DBLSCAN)
 		return -EINVAL;
 
@@ -2476,12 +2579,28 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		drm_dbg_kms(display->drm,
 			    "unsupported HDMI clock (%d kHz), rejecting mode\n",
 			    pipe_config->hw.adjusted_mode.crtc_clock);
+		/*
+		 * Hades: the tunnel is not let past the limits of the link. A mode that the sink
+		 * takes in YCbCr 4:2:0 only cannot be sent here in any other way.
+		 */
+		if (dv_requested) {
+			intel_hdmi_dvbridge_link_detail(encoder, connector, adjusted_mode, 8,
+							detail, 0, sizeof(detail));
+			intel_hdmi_dvbridge_refused(connector,
+				drm_mode_is_420_only(&connector->base.display_info, adjusted_mode) ?
+				BIT_ULL(DRM_DVBRIDGE_REFUSED_YCBCR420) :
+				BIT_ULL(DRM_DVBRIDGE_REFUSED_TMDS), detail);
+		}
 		return ret;
 	}
 
 	ret = intel_pfit_compute_config(pipe_config, conn_state);
-	if (ret)
+	if (ret) {
+		if (dv_requested)
+			intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_MODE),
+						    "the panel fitter (scaling) is not set up for it");
 		return ret;
+	}
 
 	pipe_config->limited_color_range =
 		intel_hdmi_limited_color_range(pipe_config, conn_state);
@@ -2515,8 +2634,16 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		};
 
 		ret = intel_dv_lab_validate(&link);
-		if (ret)
+		if (ret) {
+			/* Hades: why, for user space and the kernel log */
+			u64 bits = intel_dv_lab_refused(&link, pipe_config->sink_format ==
+							       INTEL_OUTPUT_FORMAT_YCBCR420);
+
+			intel_hdmi_dvbridge_tunnel_detail(encoder, connector, pipe_config, &link,
+							  bits, detail, sizeof(detail));
+			intel_hdmi_dvbridge_refused(connector, bits, detail);
 			return ret;
+		}
 		pipe_config->dither_force_disable = true;
 	}
 
