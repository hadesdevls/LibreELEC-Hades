From 0b9d2944ae26e792da6702937a651a159ba9e3a2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:52:52 +0000
Subject: [PATCH] drm/amd/display: HDR in YCbCr 4:2:0 at 10 bits where RGB
 would leave at 8

amdgpu sends HDR at 2160p50 and 2160p60 over TMDS as RGB at 8 bits:
fill_stream_properties_from_drm_display_mode() lowers the depth until
the TMDS clock fits (adjust_colour_depth_from_display_info()), and
turns to YCbCr 4:2:0 only where not even 8 bits fit. It follows now the
rule of drm_dvbridge_hdr.h (linux-9966), as i915 does: where HDR video
(PQ or HLG) over TMDS HDMI was fitted in RGB below 10 bits per
component, the timing is made again in 4:2:0, at the depth the sink
takes in 4:2:0 capped by max bpc, as for a mode the sink takes in 4:2:0
only, and lowered until the TMDS clock fits; it is kept when that is 10
bits or more, and otherwise the RGB timing stays. The gate of the depth
is max bpc as create_validate_stream_for_sink() tries it and the sink's
deep colour in RGB as DRM reads it, as i915 has both in its pipe bpp.
DC validates the stream as any other; a 4:2:0 stream it refused at that
depth is tried again with a lower max bpc, down to 8, where the rule no
longer applies, so no mode is lost. The output colour space is then
BT.2020 YCbCr (get_output_color_space()), and DC encodes and signals it
with the BT.2020 matrix already. A format forced in debugfs is left as
it is, and so is HDMI FRL.

The stream is made again when DVBRIDGE_HDR_YCBCR420 changes, or when
HDR metadata starts or stops having the PQ or HLG transfer function
without the metadata coming or going (that already forces a modeset);
a stream that comes out the same is no modeset (dm_update_crtc_state()).

The HDMI connectors whose encoder sends 4:2:0 get DVBRIDGE_HDR_YCBCR420
("deep" by default; not gated by amdgpu.dvbridge, the rule is no part
of the tunnel), and, beside the HDR10 depth guard, DVBRIDGE_LINK_FORMAT,
written by amdgpu_dm_hdr10_guard_check() for every request of the
guard, with any metadata or none, from the stream of the commit
(encoding and depth), and 0 when the connector has none. A request of
the guard puts the CRTC in the commit for that, without a modeset. The
kernel log of a refusal of the guard says why 4:2:0 was not sent
instead. dvbridge_depth_bpc() is shared with amdgpu_dm.c.

Built with W=1 on the changed files, without warnings; the rule and a
model of its use here are tested on the host (linux-9966).

Ported to Linux 7.3. 7.3 split amdgpu_dm.c and rewrote how the pixel
encoding is chosen: fill_stream_properties_from_drm_display_mode() takes the
encoding of its caller and no longer falls back to 4:2:0 when the TMDS clock
does not fit, and amdgpu_dm_create_validate_stream_for_sink() (now in
amdgpu_dm_connector.c) enumerates (encoding, bpc), RGB first, from the most
bits down, and returns the first stream that validates; it keeps the choice
on the stack, as it runs from the connector probe and from atomic checks at
the same time. The rule here was the branch beside the fallback that 7.3
removed. It is now an order of that enumeration: when the first RGB stream
it builds carries HDR (PQ or HLG) below 10 bits per component over TMDS
HDMI, dm_hdr_ycbcr_stream() builds the 4:2:0 streams of the rule, from max
bpc down to 10, and returns the first that is kept
(drm_dvbridge_hdr420_keep()) and passes the same checks as the enumeration
(dc_validate_stream(), dm_validate_stream_and_context(),
dm_validate_stream_color_format()); otherwise the RGB stream and the rest
of the enumeration go on as they do without it. The streams it builds are
the ones 7.2 built: the encoding and the depth (amdgpu_dm_convert_color_depth_from_display_info()
for 4:2:0 at that max bpc, lowered until the TMDS clock fits) are those of
fill_stream_properties_from_drm_display_mode(), and a 4:2:0 stream that DC
refuses is tried again two bits lower, as the max bpc loop of 7.2 did. No
connector state is written. Besides a format forced in debugfs, a format
named by the new color format property of 7.3 (anything but "AUTO") is left
as it is. The rest goes to amdgpu_dm_connector.c with the functions of 7.3:
amdgpu_dm_hdr420_input() after adjust_colour_depth_from_display_info(),
the properties, amdgpu_dm_connector_atomic_check() and
amdgpu_dm_connector_init_helper(); the include of drm_dvbridge_hdr.h goes
there too, and two comments name that file.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |  10 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |   7 +
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  14 ++
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 185 +++++++++++++++++-
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    |  70 +++++--
 5 files changed, 269 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index b096033..514f2a8 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -41,6 +41,7 @@
 #include <drm/drm_crtc_helper.h>
 #include <drm/drm_damage_helper.h>
 #include <drm/drm_drv.h>
+#include <drm/drm_dvbridge_hdr.h>
 #include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_fb_helper.h>
@@ -1638,6 +1639,15 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 		drm_dvbridge_refused_property_create(adev_to_drm(adev));
 	if (!adev->mode_info.dvbridge_refused_property)
 		return -ENOMEM;
+	/* Hades: the same names and meanings as the i915 ones (drm_dvbridge_hdr.h) */
+	adev->mode_info.dvbridge_link_property =
+		drm_dvbridge_link_property_create(adev_to_drm(adev));
+	if (!adev->mode_info.dvbridge_link_property)
+		return -ENOMEM;
+	adev->mode_info.dvbridge_hdr420_property =
+		drm_dvbridge_hdr_ycbcr420_property_create(adev_to_drm(adev));
+	if (!adev->mode_info.dvbridge_hdr420_property)
+		return -ENOMEM;
 
 	return amdgpu_display_setup_abm_prop(adev);
 }
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index 3d232a5..c5f82a5 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -336,6 +336,13 @@ struct amdgpu_mode_info {
 	 */
 	struct drm_property *dvbridge_hdr10_property;
 	struct drm_property *dvbridge_refused_property;
+	/*
+	 * Hades: what a request of the guard found the stream sends (DVBRIDGE_LINK_FORMAT, read
+	 * only), and HDR in YCbCr 4:2:0 at 10 bits or more where RGB would carry fewer
+	 * (DVBRIDGE_HDR_YCBCR420) (drm_dvbridge_hdr.h)
+	 */
+	struct drm_property *dvbridge_link_property;
+	struct drm_property *dvbridge_hdr420_property;
 	/* hardcoded DFP edid from BIOS */
 	const struct drm_edid *bios_hardcoded_edid;
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index dfe8aef..55b500e 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1092,6 +1092,11 @@ struct dm_connector_state {
 	bool dvbridge_dv_standard;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 	bool dvbridge_hdr10_deep_color;
+	/*
+	 * Hades: DVBRIDGE_HDR_YCBCR420, enum drm_dvbridge_hdr_ycbcr420: 0 ("deep", the default of
+	 * a state that is reset) or "never". A setting of the user, kept while the connector is off.
+	 */
+	u8 dvbridge_hdr_ycbcr420;
 };
 
 /* Hades: amdgpu_dm_dvbridge_refused.c */
@@ -1109,6 +1114,15 @@ void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct
 void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 				       const struct dc_stream_state *stream);
 int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state);
+unsigned int amdgpu_dm_dvbridge_depth_bpc(enum dc_color_depth depth);
+
+/* Hades: amdgpu_dm_connector.c, HDR in YCbCr 4:2:0 at 10 bits or more (drm_dvbridge_hdr.h) */
+struct drm_dvbridge_hdr420;
+void amdgpu_dm_hdr420_input(const struct drm_connector *connector,
+			    const struct drm_connector_state *connector_state,
+			    const struct drm_display_mode *mode, enum signal_type signal,
+			    enum dc_pixel_encoding encoding, unsigned int bpc, int requested_bpc,
+			    struct drm_dvbridge_hdr420 *s);
 
 #define to_dm_connector_state(x)\
 	container_of((x), struct dm_connector_state, base)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index ca9e538..37341a1 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -59,6 +59,7 @@
 #include <drm/drm_atomic_uapi.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_blend.h>
+#include <drm/drm_dvbridge_hdr.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_eld.h>
 #include <drm/drm_fixed.h>
@@ -873,6 +874,37 @@ STATIC_IFN_KUNIT bool adjust_colour_depth_from_display_info(
 }
 EXPORT_IF_KUNIT(adjust_colour_depth_from_display_info);
 
+/*
+ * Hades: the inputs of the HDR 4:2:0 rule (drm_dvbridge_hdr.h) for a stream timing of the
+ * connector: its pixel encoding and its depth as computed (bpc), over TMDS HDMI. The gate of the
+ * depth is max bpc (requested_bpc, as amdgpu_dm_create_validate_stream_for_sink() has it) and the
+ * sink's deep colour in RGB as DRM reads it, as i915 has it in its pipe bpp: the rule is the same
+ * for both drivers.
+ */
+void amdgpu_dm_hdr420_input(const struct drm_connector *connector,
+			    const struct drm_connector_state *connector_state,
+			    const struct drm_display_mode *mode, enum signal_type signal,
+			    enum dc_pixel_encoding encoding, unsigned int bpc, int requested_bpc,
+			    struct drm_dvbridge_hdr420 *s)
+{
+	const struct drm_display_info *info = &connector->display_info;
+	const struct dm_connector_state *dm_state = to_dm_connector_state(connector_state);
+	const int edid_bpc = info->bpc ? info->bpc : 8;
+
+	*s = (struct drm_dvbridge_hdr420) {
+		.never = dm_state->dvbridge_hdr_ycbcr420 == DRM_DVBRIDGE_HDR_YCBCR420_NEVER,
+		.hdr = drm_dvbridge_hdr_output(connector_state),
+		.dv_tunnel = dm_state->dvbridge_dv_standard,
+		.hdmi_sink = signal == SIGNAL_TYPE_HDMI_TYPE_A && info->is_hdmi,
+		.source = connector->ycbcr_420_allowed,
+		.mode = drm_mode_is_420_also(info, mode),
+		.rgb = encoding == PIXEL_ENCODING_RGB,
+		.bpc = bpc,
+		.max_bpc = clamp(requested_bpc, 0, edid_bpc),
+		.y420_dc_modes = info->hdmi.y420_dc_modes,
+	};
+}
+
 /*
  * DOC: HDMI 3D
  *
@@ -2375,6 +2407,10 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EINVAL;
 		dm_new_state->dvbridge_hdr10_deep_color = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_hdr420_property) {
+		/* Hades: DVBRIDGE_HDR_YCBCR420 (drm_dvbridge_hdr.h; DRM checks the enum's values) */
+		dm_new_state->dvbridge_hdr_ycbcr420 = val;
+		ret = 0;
 	} else if (property == adev->mode_info.abm_level_property) {
 		switch (val) {
 		case ABM_SYSFS_CONTROL:
@@ -2438,6 +2474,9 @@ int amdgpu_dm_connector_atomic_get_property(struct drm_connector *connector,
 	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
 		*val = dm_state->dvbridge_hdr10_deep_color;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_hdr420_property) {
+		*val = dm_state->dvbridge_hdr_ycbcr420;
+		ret = 0;
 	} else if (property == adev->mode_info.abm_level_property) {
 		if (!dm_state->abm_sysfs_forbidden)
 			*val = ABM_SYSFS_CONTROL;
@@ -2815,6 +2854,99 @@ dm_validate_stream_color_format(const struct drm_connector_state *drm_state,
 		DC_OK : DC_UNSUPPORTED_VALUE;
 }
 
+/*
+ * Hades: the checks that amdgpu_dm_create_validate_stream_for_sink() makes of a stream, for one of
+ * the HDR rule over TMDS HDMI (an HDMI sink: no MST)
+ */
+static enum dc_status dm_hdr_validate_stream(struct amdgpu_device *adev,
+					     const struct drm_connector_state *connector_state,
+					     struct dc_stream_state *stream)
+{
+	enum dc_status dc_result = dc_validate_stream(adev->dm.dc, stream);
+
+	if (dc_result == DC_OK)
+		dc_result = dm_validate_stream_and_context(adev->dm.dc, stream);
+	if (dc_result == DC_OK)
+		dc_result = dm_validate_stream_color_format(connector_state, stream);
+	return dc_result;
+}
+
+/*
+ * Hades: HDR video where RGB over TMDS, as the first RGB stream of
+ * amdgpu_dm_create_validate_stream_for_sink() has it (adjust_colour_depth_from_display_info()
+ * fitted its depth), leaves below 10 bits per component: YCbCr 4:2:0 at the depth it gets, if that
+ * is 10 or more (drm_dvbridge_hdr.h; i915 follows the same rule). The depth starts from what the
+ * sink takes in 4:2:0 and max bpc, as for a mode the sink takes in 4:2:0 only, and goes down until
+ * the TMDS clock fits. DC validates the stream as any other: a 4:2:0 stream that it refuses at
+ * this depth is tried again with a lower max bpc, down to where the rule no longer applies. Not
+ * for a format forced in debugfs or named by the color format property. The candidates live on
+ * the stack, as those of the enumeration do: no connector state changes. NULL: the enumeration
+ * goes on with the RGB stream, as without this rule.
+ */
+static struct dc_stream_state *
+dm_hdr_ycbcr_stream(struct drm_connector *connector, const struct drm_display_mode *drm_mode,
+		    const struct dm_connector_state *dm_state,
+		    const struct dc_stream_state *old_stream, const struct dc_stream_state *rgb,
+		    int requested_bpc, bool is_hdmi_ep)
+{
+	struct amdgpu_dm_connector *aconnector = to_amdgpu_dm_connector(connector);
+	struct amdgpu_device *adev = drm_to_adev(connector->dev);
+	const struct drm_connector_state *connector_state = &dm_state->base;
+	const unsigned int rgb_bpc = amdgpu_dm_dvbridge_depth_bpc(rgb->timing.display_color_depth);
+	const int edid_bpc = connector->display_info.bpc ? connector->display_info.bpc : 8;
+	struct dc_stream_state *stream;
+	struct drm_dvbridge_hdr420 s;
+	enum dc_status dc_result;
+	int bpc;
+
+	if (aconnector->force_yuv_pixel_format != PIXEL_ENCODING_UNDEFINED ||
+	    connector_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_AUTO)
+		return NULL;
+
+	amdgpu_dm_hdr420_input(connector, connector_state, drm_mode, rgb->signal,
+			       rgb->timing.pixel_encoding, rgb_bpc, requested_bpc, &s);
+	if (!drm_dvbridge_hdr420_try(&s)) {
+		if (s.hdr && s.rgb && rgb_bpc < 10)
+			drm_dbg_kms(connector->dev, "[CONNECTOR:%d:%s] HDR goes out in RGB at %u bpc: %s\n",
+				    connector->base.id, connector->name, rgb_bpc,
+				    drm_dvbridge_hdr420_why_not(&s));
+		return NULL;
+	}
+	for (bpc = requested_bpc; min(bpc, edid_bpc) >= 10; bpc -= 2) {
+		struct dc_crtc_timing t;
+
+		stream = create_stream_for_sink(connector, drm_mode, dm_state, old_stream, bpc,
+						PIXEL_ENCODING_YCBCR420, is_hdmi_ep);
+		if (!stream)
+			return NULL;
+		/* the depth that fill_stream_properties_from_drm_display_mode() fitted, if it fits */
+		t = stream->timing;
+		if (!adjust_colour_depth_from_display_info(&t, &connector->display_info) ||
+		    t.display_color_depth != stream->timing.display_color_depth ||
+		    !drm_dvbridge_hdr420_keep(rgb_bpc,
+					      amdgpu_dm_dvbridge_depth_bpc(t.display_color_depth))) {
+			drm_dbg_kms(connector->dev, "[CONNECTOR:%d:%s] HDR stays in RGB at %u bpc: YCbCr 4:2:0 is not deeper on this link\n",
+				    connector->base.id, connector->name, rgb_bpc);
+			dc_stream_release(stream);
+			return NULL;
+		}
+		dc_result = dm_hdr_validate_stream(adev, connector_state, stream);
+		if (dc_result == DC_OK) {
+			drm_dbg_kms(connector->dev,
+				    "[CONNECTOR:%d:%s] HDR goes out in YCbCr 4:2:0 at %u bpc: RGB would be %u bpc\n",
+				    connector->base.id, connector->name,
+				    amdgpu_dm_dvbridge_depth_bpc(t.display_color_depth), rgb_bpc);
+			return stream;
+		}
+		drm_dbg_kms(connector->dev, "[CONNECTOR:%d:%s] HDR in YCbCr 4:2:0 at %u bpc refused (%s)\n",
+			    connector->base.id, connector->name,
+			    amdgpu_dm_dvbridge_depth_bpc(t.display_color_depth),
+			    dc_status_to_str(dc_result));
+		dc_stream_release(stream);
+	}
+	return NULL;
+}
+
 struct dc_stream_state *
 amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 					  const struct drm_display_mode *drm_mode,
@@ -2846,6 +2978,7 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 	u32 encoding_mask = 0;
 	u32 bpc_mask = 0;
 	bool is_hdmi_ep = false;
+	bool hdr_tried = false; /* Hades: the HDR rule, once (drm_dvbridge_hdr.h) */
 	unsigned int i, j;
 
 	if (!dm_state)
@@ -2996,6 +3129,24 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 				return NULL;
 			}
 
+			/*
+			 * Hades: HDR in YCbCr at 10 bits or more where RGB, as this first RGB stream
+			 * has it, carries fewer (dm_hdr_ycbcr_stream()): tried before it is validated;
+			 * otherwise the enumeration goes on as it does without the rule.
+			 */
+			if (enc == PIXEL_ENCODING_RGB && !hdr_tried) {
+				struct dc_stream_state *hdr_stream;
+
+				hdr_tried = true;
+				hdr_stream = dm_hdr_ycbcr_stream(connector, drm_mode, dm_state,
+								 old_stream, stream, requested_bpc,
+								 is_hdmi_ep);
+				if (hdr_stream) {
+					dc_stream_release(stream);
+					return hdr_stream;
+				}
+			}
+
 			dc_result = dc_validate_stream(adev->dm.dc, stream);
 
 			if (dc_result == DC_OK &&
@@ -3195,17 +3346,34 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	 * Hades: a request of the tunnel or of the HDR10 depth guard is checked again: what
 	 * was found of the last one is cleared (DVBRIDGE_REFUSED), and each check that
 	 * refuses says why. The guard needs the CRTC in the commit, to see the depth of its
-	 * stream; that is no modeset.
+	 * stream and to say what it sends (DVBRIDGE_LINK_FORMAT, with any metadata or none);
+	 * that is no modeset.
 	 */
-	if (dm_new_con_state->dvbridge_dv_standard || amdgpu_dm_hdr10_guarded(new_con_state))
+	if (dm_new_con_state->dvbridge_dv_standard || dm_new_con_state->dvbridge_hdr10_deep_color)
 		amdgpu_dm_dvbridge_refused(aconn, 0, NULL);
 	if (dm_new_con_state->dvbridge_hdr10_deep_color !=
-	    dm_old_con_state->dvbridge_hdr10_deep_color || amdgpu_dm_hdr10_guarded(new_con_state)) {
+	    dm_old_con_state->dvbridge_hdr10_deep_color ||
+	    dm_new_con_state->dvbridge_hdr10_deep_color) {
 		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
 		if (IS_ERR(new_crtc_state))
 			return PTR_ERR(new_crtc_state);
 	}
 
+	/*
+	 * Hades: HDR in YCbCr 4:2:0 at 10 bits or more (drm_dvbridge_hdr.h) is decided when the
+	 * stream is made: its setting, or HDR metadata that starts or stops having the PQ or HLG
+	 * transfer function without the metadata coming or going (that is below), make it again.
+	 * A stream that comes out the same is no modeset (dm_update_crtc_state()).
+	 */
+	if (dm_new_con_state->dvbridge_hdr_ycbcr420 != dm_old_con_state->dvbridge_hdr_ycbcr420 ||
+	    drm_dvbridge_hdr_output(new_con_state) != drm_dvbridge_hdr_output(old_con_state)) {
+		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
+		if (IS_ERR(new_crtc_state))
+			return PTR_ERR(new_crtc_state);
+
+		new_crtc_state->mode_changed = true;
+	}
+
 	if (dm_new_con_state->dvbridge_dv_standard) {
 		ret = amdgpu_dm_dvbridge_check_connector(aconn, new_con_state, state);
 		if (ret) {
@@ -3901,6 +4069,17 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge)
 		amdgpu_dm_dvbridge_attach_refused(aconnector);
 
+	/*
+	 * Hades: HDR in YCbCr 4:2:0 at 10 bits or more where RGB would carry fewer
+	 * (drm_dvbridge_hdr.h), on every HDMI connector whose encoder sends 4:2:0: on by default
+	 * ("deep"), not gated by amdgpu.dvbridge (it is no part of the tunnel)
+	 */
+	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && aconnector->base.ycbcr_420_allowed &&
+	    adev->mode_info.dvbridge_hdr420_property)
+		drm_object_attach_property(&aconnector->base.base,
+					   adev->mode_info.dvbridge_hdr420_property,
+					   DRM_DVBRIDGE_HDR_YCBCR420_DEEP);
+
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA) {
 		if (!drm_mode_create_hdmi_colorspace_property(&aconnector->base, supported_colorspaces))
 			drm_connector_attach_colorspace_property(&aconnector->base);
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index f0db1e8..14663e6 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
