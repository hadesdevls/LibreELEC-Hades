 	if (adev->mode_info.dvbridge_refused_property) {
 		drm_dvbridge_refused_log_init(&aconn->dvbridge_refused_log);
 		drm_object_attach_property(&aconn->base.base,
@@ -101,6 +106,12 @@ static unsigned int dvbridge_depth_bpc(enum dc_color_depth depth)
 	}
 }
 
+/* (the same, for amdgpu_dm.c) */
+unsigned int amdgpu_dm_dvbridge_depth_bpc(enum dc_color_depth depth)
+{
+	return dvbridge_depth_bpc(depth);
+}
+
 static const char *dvbridge_encoding_name(enum dc_pixel_encoding encoding)
 {
 	switch (encoding) {
@@ -446,13 +457,33 @@ void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct d
 	}
 }
 
+/* Hades: the DVBRIDGE_LINK_FORMAT bit of a DC pixel encoding (drm_dvbridge_hdr.h) */
+static unsigned int dvbridge_link_format(enum dc_pixel_encoding encoding)
+{
+	switch (encoding) {
+	case PIXEL_ENCODING_YCBCR422:
+		return DRM_DVBRIDGE_LINK_YCBCR422;
+	case PIXEL_ENCODING_YCBCR444:
+		return DRM_DVBRIDGE_LINK_YCBCR444;
+	case PIXEL_ENCODING_YCBCR420:
+		return DRM_DVBRIDGE_LINK_YCBCR420;
+	case PIXEL_ENCODING_RGB:
+		return DRM_DVBRIDGE_LINK_RGB;
+	default:
+		return DRM_DVBRIDGE_LINK_COUNT; /* (no bits) */
+	}
+}
+
 /*
  * The HDR10 depth guard: an active stream whose connector is under the guard with HDR10 metadata
  * carries 10 bits per component or more, or the commit is refused. Run once the streams of the
- * commit are made. It changes nothing: DC chooses the depth as without it.
+ * commit are made. It changes nothing: DC chooses the depth as without it. (Hades: and every
+ * request of the guard, with any metadata or none, is answered in DVBRIDGE_LINK_FORMAT: what the
+ * stream sends, or 0 when the connector has none.)
  */
 int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
 {
+	struct amdgpu_device *adev = drm_to_adev(state->dev);
 	struct drm_connector_state *con_state;
 	struct drm_connector *connector;
 	int i;
@@ -461,18 +492,22 @@ int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
 		struct amdgpu_dm_connector *aconn;
 		const struct drm_crtc_state *crtc_state;
 		const struct dc_stream_state *stream;
+		struct drm_dvbridge_hdr420 s;
 		unsigned int bpc;
-		char detail[320];
+		const char *why;
+		char detail[448];
 		size_t len;
 
 		if (connector->connector_type != DRM_MODE_CONNECTOR_HDMIA || !con_state->crtc ||
-		    !amdgpu_dm_hdr10_guarded(con_state))
+		    !to_dm_connector_state(con_state)->dvbridge_hdr10_deep_color)
 			continue;
 		crtc_state = drm_atomic_get_new_crtc_state(state, con_state->crtc);
-		if (!crtc_state || !crtc_state->active)
-			continue;
-		stream = to_dm_crtc_state(crtc_state)->stream;
-		if (!stream)
+		stream = crtc_state && crtc_state->active ? to_dm_crtc_state(crtc_state)->stream : NULL;
+		drm_dvbridge_link_report(connector, adev->mode_info.dvbridge_link_property,
+					 stream ? drm_dvbridge_link_bits(
+							  dvbridge_link_format(stream->timing.pixel_encoding),
+							  dvbridge_depth_bpc(stream->timing.display_color_depth)) : 0);
+		if (!stream || !amdgpu_dm_hdr10_guarded(con_state))
 			continue;
 		bpc = dvbridge_depth_bpc(stream->timing.display_color_depth);
 		if (bpc >= 10)
@@ -481,13 +516,20 @@ int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
 		len = scnprintf(detail, sizeof(detail), "HDR10 would go out as %s at %u bpc in ",
 				dvbridge_encoding_name(stream->timing.pixel_encoding), bpc);
 		len = dvbridge_link_detail(aconn, &crtc_state->mode, detail, len, sizeof(detail));
-		scnprintf(detail + len, sizeof(detail) - len,
