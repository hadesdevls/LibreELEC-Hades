 #include <drm/drm_fourcc.h>
@@ -45,6 +46,10 @@ void amdgpu_dm_dvbridge_attach_refused(struct amdgpu_dm_connector *aconn)
 	if (adev->mode_info.dvbridge_hdr10_property)
 		drm_object_attach_property(&aconn->base.base,
 					   adev->mode_info.dvbridge_hdr10_property, 0);
+	/* ... and its answer, what the stream sends (drm_dvbridge_hdr.h, read only) */
+	if (adev->mode_info.dvbridge_hdr10_property && adev->mode_info.dvbridge_link_property)
+		drm_object_attach_property(&aconn->base.base,
