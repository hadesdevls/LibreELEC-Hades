+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -41,6 +41,7 @@
 #include <drm/drm_crtc_helper.h>
 #include <drm/drm_damage_helper.h>
 #include <drm/drm_drv.h>
+#include <drm/drm_dvbridge_hdr.h>
 #include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_fb_helper.h>
@@ -1485,6 +1486,15 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 		drm_dvbridge_refused_property_create(adev_to_drm(adev));
 	if (!adev->mode_info.dvbridge_refused_property)
 		return -ENOMEM;
+	/* Hades: the same names and meanings as the i915 ones (drm_dvbridge_hdr.h) */
+	adev->mode_info.dvbridge_link_property =
+		drm_dvbridge_link_property_create(adev_to_drm(adev));
+	if (!adev->mode_info.dvbridge_link_property)
+		return -ENOMEM;
+	adev->mode_info.dvbridge_hdr420_property =
+		drm_dvbridge_hdr_ycbcr420_property_create(adev_to_drm(adev));
+	if (!adev->mode_info.dvbridge_hdr420_property)
+		return -ENOMEM;
 
 	return amdgpu_display_setup_abm_prop(adev);
 }
