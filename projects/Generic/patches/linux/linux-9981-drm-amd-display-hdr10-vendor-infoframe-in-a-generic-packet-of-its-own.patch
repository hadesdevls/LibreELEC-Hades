 	return result;
 }
 
+/* Hades: the links that carry HDR10PLUS_VSIF (amdgpu_dm_hdr10plus.h) */
+static bool amdgpu_dm_hdr10plus_link(enum signal_type signal)
+{
+	return dc_is_hdmi_signal(signal) ||
+	       (dc_is_dp_signal(signal) && signal != SIGNAL_TYPE_EDP);
+}
+
+/*
+ * Hades: the HDR10+ packet of a connector state for a stream's link (amdgpu_dm_hdr10plus.h):
+ * invalid without HDR10PLUS_VSIF, and on a link that does not carry it, which the atomic check
+ * refuses on a stream that exists.
+ */
+static void amdgpu_dm_fill_hdr10plus(const struct drm_connector_state *state,
+				     enum signal_type signal, struct dc_info_packet *out)
+{
+	const struct drm_property_blob *blob = state->hdr10plus_vsif;
+
+	memset(out, 0, sizeof(*out));
+	if (!blob || !amdgpu_dm_hdr10plus_link(signal))
+		return;
+	amdgpu_dm_hdr10plus_packet(blob->data, blob->length, dc_is_hdmi_signal(signal), out);
+}
+
 static int fill_hdr_info_packet(const struct drm_connector_state *state,
 				struct dc_info_packet *out)
 {
@@ -9768,6 +9792,31 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 			!new_con_state->hdr_output_metadata;
 	}
 
+	/*
+	 * Hades: HDR10PLUS_VSIF (amdgpu_dm_hdr10plus.h) changes a packet of the stream in place:
+	 * never a modeset. Not with the Dolby Vision tunnel, whose Dolby VSIF is the dynamic
+	 * metadata of its picture; not on a link that does not carry it.
+	 */
+	if (new_con_state->hdr10plus_vsif && dm_new_con_state->dvbridge_dv_standard) {
+		drm_dbg_atomic(conn->dev, "[CONNECTOR:%d:%s] HDR10PLUS_VSIF with the Dolby Vision tunnel\n",
+			       conn->base.id, conn->name);
+		return -EINVAL;
+	}
+	if (!drm_connector_atomic_hdr10plus_vsif_equal(old_con_state, new_con_state)) {
+		const struct dc_stream_state *stream;
+
+		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
+		if (IS_ERR(new_crtc_state))
+			return PTR_ERR(new_crtc_state);
+		stream = to_dm_crtc_state(new_crtc_state)->stream;
+		if (new_con_state->hdr10plus_vsif && stream &&
+		    !amdgpu_dm_hdr10plus_link(stream->signal)) {
+			drm_dbg_atomic(conn->dev, "[CONNECTOR:%d:%s] HDR10PLUS_VSIF on a link that does not carry it (signal %d)\n",
+				       conn->base.id, conn->name, stream->signal);
+			return -EINVAL;
+		}
+	}
+
 	return 0;
 }
 
@@ -10539,6 +10588,11 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 	    connector_type == DRM_MODE_CONNECTOR_eDP) {
 		drm_connector_attach_hdr_output_metadata_property(&aconnector->base);
 
+		/* Hades: HDR10PLUS_VSIF where DC sends it (amdgpu_dm_hdr10plus.h) */
+		if (connector_type != DRM_MODE_CONNECTOR_eDP &&
+		    adev->dm.dc->ctx->dce_version >= DCN_VERSION_1_0)
+			drm_connector_attach_hdr10plus_vsif_property(&aconnector->base);
+
 		if (!aconnector->mst_root)
 			drm_connector_attach_vrr_capable_property(&aconnector->base);
 
@@ -12707,8 +12761,10 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 		struct dc_surface_update *dummy_updates;
 		struct dc_stream_update stream_update;
 		struct dc_info_packet hdr_packet;
+		struct dc_info_packet hdr10plus_packet; /* Hades */
 		struct dc_stream_status *status = NULL;
 		bool abm_changed, hdr_changed, scaling_changed, output_color_space_changed = false;
+		bool hdr10plus_changed;
 
 		memset(&stream_update, 0, sizeof(stream_update));
 
@@ -12738,7 +12794,12 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 		hdr_changed =
 			!drm_connector_atomic_hdr_metadata_equal(old_con_state, new_con_state);
 
-		if (!scaling_changed && !abm_changed && !hdr_changed && !output_color_space_changed)
+		/* Hades: HDR10PLUS_VSIF, the packet of this frame (amdgpu_dm_hdr10plus.h) */
+		hdr10plus_changed = dm_new_crtc_state->stream &&
+			!drm_connector_atomic_hdr10plus_vsif_equal(old_con_state, new_con_state);
+
+		if (!scaling_changed && !abm_changed && !hdr_changed && !output_color_space_changed &&
+		    !hdr10plus_changed)
 			continue;
 
 		stream_update.stream = dm_new_crtc_state->stream;
@@ -12768,6 +12829,12 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 			stream_update.hdr_static_metadata = &hdr_packet;
 		}
 
+		if (hdr10plus_changed) {
+			amdgpu_dm_fill_hdr10plus(new_con_state, dm_new_crtc_state->stream->signal,
+						 &hdr10plus_packet);
+			stream_update.hdr10plus_infopacket = &hdr10plus_packet;
+		}
+
 		status = dc_stream_get_status(dm_new_crtc_state->stream);
 
 		if (WARN_ON(!status))
@@ -13301,6 +13368,11 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 
 		dm_new_crtc_state->abm_level = dm_new_conn_state->abm_level;
 
+		/* Hades: HDR10PLUS_VSIF (amdgpu_dm_hdr10plus.h); never with the Dolby Vision tunnel */
+		if (!dm_new_conn_state->dvbridge_dv_standard)
+			amdgpu_dm_fill_hdr10plus(drm_new_conn_state, new_stream->signal,
+						 &new_stream->hdr10plus_infopacket);
+
 		ret = fill_hdr_info_packet(drm_new_conn_state,
 					   &new_stream->hdr_static_metadata);
 		if (ret)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_hdr10plus.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_hdr10plus.h
