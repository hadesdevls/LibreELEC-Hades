@@ -5645,6 +5651,7 @@ void populate_fast_updates(struct dc_fast_update *fast_update,
 		fast_update[0].vrr_infopacket = stream_update->vrr_infopacket;
 		fast_update[0].vsc_infopacket = stream_update->vsc_infopacket;
