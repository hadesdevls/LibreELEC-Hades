index 0000000..77058b9
--- /dev/null
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_hdr10plus.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: HDR10PLUS_VSIF on amdgpu (drm_hdr10plus.h). DC sends the HDR10+ vendor-specific InfoFrame
+ * of a stream (dc_stream_state.hdr10plus_infopacket) in a generic packet slot of its own, so that
+ * nothing else moves for it: not the HDMI 1.4 vendor InfoFrame of the vendor slot (the HDMI VIC
+ * of 2160p24, 25 and 30; 3D), nor the Dolby VSIF of the tunnel, nor the HDR one:
+ *
+ * - HDMI (DIO): generic packet 7. DCN 1 sends packets 0 to 5, DCN 2 to 6, DCN 3 and later 0 to 6
+ *   (enc1/enc2/enc3_stream_encoder_update_hdmi_info_packets()); HDMI FRL (HPO): packet 13, past
+ *   the 5 to 10 of DSC, the HF-VSIF (11) and the VTEM (12);
+ * - DisplayPort (DIO and HPO): generic packet 6, the first after the adaptive sync SDP (5): 4 is
+ *   the immediate SDP, 7 the PPS of DSC on DCN 2 and later.
+ *
+ * Only for DCN, on HDMI and DisplayPort connectors (not eDP). A change of HDR10PLUS_VSIF is a
+ * stream update of that packet, from the commit that sets it (amdgpu_dm_atomic_commit_tail()),
+ * never a modeset; a stream that is created takes it from the connector state. The atomic check
+ * refuses it with the Dolby Vision tunnel and on a link that does not carry it.
+ */
+#ifndef __AMDGPU_DM_HDR10PLUS_H__
+#define __AMDGPU_DM_HDR10PLUS_H__
+
+#include <drm/drm_hdr10plus.h>
+
+/*
+ * The packet of a payload as DC takes it, for an HDMI signal (the InfoFrame: its header in
+ * hb0..hb2, the checksum in sb[0], the payload after it) or a DisplayPort one (the InfoFrame SDP:
+ * its header in hb0..hb3, its data bytes in sb). 0, or -errno with out invalid.
+ */
+static inline int amdgpu_dm_hdr10plus_packet(const u8 *vsif, size_t size, bool hdmi,
+					     struct dc_info_packet *out)
+{
+	u8 buf[DRM_HDR10PLUS_INFOFRAME_SIZE];
+	u8 hb[4];
+	ssize_t len;
+
+	memset(out, 0, sizeof(*out));
+	if (hdmi) {
+		len = drm_hdr10plus_hdmi_infoframe_pack(vsif, size, buf, sizeof(buf));
+		if (len < 0)
+			return len;
+		out->hb0 = buf[0];
+		out->hb1 = buf[1];
+		out->hb2 = buf[2];
+		memcpy(out->sb, &buf[3], len - 3);
+	} else {
+		len = drm_hdr10plus_dp_sdp_pack(vsif, size, hb, out->sb, sizeof(out->sb));
+		if (len < 0)
+			return len;
+		out->hb0 = hb[0];
+		out->hb1 = hb[1];
+		out->hb2 = hb[2];
+		out->hb3 = hb[3];
+	}
+	out->valid = true;
+	return 0;
+}
+
+#endif /* __AMDGPU_DM_HDR10PLUS_H__ */
