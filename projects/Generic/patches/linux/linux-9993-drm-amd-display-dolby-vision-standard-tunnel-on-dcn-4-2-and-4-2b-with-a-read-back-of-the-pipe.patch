+/*
+ * Hades: DCN 4.2 and 4.2B: once each time the tunnel goes on (a modeset of a tunnelled stream), the
+ * pipes of the stream as their registers hold them, into the kernel log, with what is not as the
+ * tunnel needs (amdgpu_dm_dvbridge_dcn42_readback_why()): one line with the verdict, one per pipe,
+ * one per OPP, one for the RMCM and the encoder. The hardware is not changed from here; what was
+ * found wrong refuses the tunnel from the next commit that turns it on
+ * (amdgpu_dm_dvbridge_check_dcn42()), so that user space plays HDR10 from then on. With the DC lock
+ * held.
+ */
+void amdgpu_dm_dvbridge_log_dcn42(struct drm_crtc *crtc, const struct dc_stream_state *stream)
+{
+	struct amdgpu_device *adev = drm_to_adev(crtc->dev);
+	const char *name = amdgpu_dm_dvbridge_dcn42_name(stream);
+	struct dc_byte_tunnel_dcn42_readback *rb;
+	char why[512];
+	unsigned int n;
+
+	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
+	if (!rb) {
+		WRITE_ONCE(adev->dm.dvbridge_readback_failed, true);
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: no memory for the read back of its pipes; the tunnel is refused from now on\n",
+			 crtc->base.id, crtc->name, name);
+		return;
+	}
+	dc_stream_read_byte_tunnel_dcn42(stream->ctx->dc, stream, rb);
+	if (amdgpu_dm_dvbridge_dcn42_readback_why(rb, stream->vsp_infopacket.valid &&
+						  amdgpu_dm_dvbridge_stream_dolby(stream),
+						  why, sizeof(why))) {
+		WRITE_ONCE(adev->dm.dvbridge_readback_failed, true);
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: read back NOT as the tunnel needs (%s); the tunnel is refused from the next time it is turned on, until the driver is loaded again\n",
+			 crtc->base.id, crtc->name, name, why);
+	} else {
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: read back as the tunnel needs: %u pipes, %u OPPs\n",
+			 crtc->base.id, crtc->name, name, rb->pipes, rb->opps);
+	}
+	for (n = 0; n < rb->pipes; n++) {
+		const struct dc_byte_tunnel_dcn42_dpp *d = &rb->dpp[n];
+		const struct dc_byte_tunnel_dcn42_mpcc *m = &rb->mpcc[n];
+
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: DPP %u (read %d, missing %u): bypass %u, expansion %u, cnv16 %u, MSB align %u, clamp %u, crossbar %u/%u/%u, format %u, dealpha %u/%u, realpha %u, keyer %u, bias %#x/%#x/%#x, scale %#x/%#x/%#x, pre-degamma %u, pre-CSC %u, post-CSC %u, gamma correction %u, HDR multiplier %#x, CM bypass %u, CM bias %#x/%#x/%#x, histogram %#x\n",
+			 crtc->base.id, crtc->name, name, d->inst, d->read, d->missing,
+			 d->cnvc_bypass, d->expansion_mode, d->cnv16, d->bypass_msb_align,
+			 d->clamp_positive, d->crossbar[0], d->crossbar[1], d->crossbar[2],
+			 d->pixel_format, d->pre_dealpha, d->cm_dealpha, d->pre_realpha, d->keyer,
+			 d->fcnv_bias[0], d->fcnv_bias[1], d->fcnv_bias[2], d->fcnv_scale[0],
+			 d->fcnv_scale[1], d->fcnv_scale[2], d->pre_degam, d->pre_csc, d->post_csc,
+			 d->gamcor, d->hdr_mult, d->cm_bypass, d->cm_bias[0], d->cm_bias[1],
+			 d->cm_bias[2], d->hist_channels);
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: DPP %u scaler %u (EASF %u/%u, sharpener %u, SC %u/%u), recout %u,%u %ux%u, MPC %ux%u, cursor %u, clock %u; MPCC %u (read %d, missing %u): mode %u, top %u, bottom %#x, alpha mode %u, alpha %#x/%#x, gain %#x/%#x, premultiplied %u, overlap %u, output gamma %u, gamut remap %u/%u/%u, MCM %u/%u/%u\n",
+			 crtc->base.id, crtc->name, name, d->inst, d->dscl_mode, d->easf_h,
+			 d->easf_v, d->isharp, d->sc_matrix, d->sc_ltonl, d->recout[0],
+			 d->recout[1], d->recout[2], d->recout[3], d->mpc_size[0], d->mpc_size[1],
+			 d->cursor, d->clock, m->inst, m->read, m->missing, m->mode, m->top_sel,
+			 m->bot_sel, m->alpha_mode, m->global_alpha, m->alpha_max, m->global_gain,
+			 m->gain_max, m->premultiplied, m->overlap_only, m->ogam, m->gamut_remap,
+			 m->mcm_gamut_remap[0], m->mcm_gamut_remap[1], m->mcm_shaper, m->mcm_3dlut,
+			 m->mcm_1dlut);
+	}
+	for (n = 0; n < rb->opps; n++) {
+		const struct dc_byte_tunnel_dcn42_opp *o = &rb->opp[n];
+
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: OPP %u (read %d/%d, missing %u): output CSC %u (%#x %#x %#x %#x / %#x %#x %#x %#x / %#x %#x %#x %#x), denormalisation %u (clamp %#x-%#x %#x-%#x %#x-%#x), formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u, subsampling %u\n",
+			 crtc->base.id, crtc->name, name, o->inst, o->mpc_read, o->fmt_read,
+			 o->missing, o->ocsc_mode, o->ocsc_coef[0], o->ocsc_coef[1],
+			 o->ocsc_coef[2], o->ocsc_coef[3], o->ocsc_coef[4], o->ocsc_coef[5],
+			 o->ocsc_coef[6], o->ocsc_coef[7], o->ocsc_coef[8], o->ocsc_coef[9],
+			 o->ocsc_coef[10], o->ocsc_coef[11], o->denorm_mode, o->denorm_clamp_min[0],
+			 o->denorm_clamp_max[0], o->denorm_clamp_min[1], o->denorm_clamp_max[1],
+			 o->denorm_clamp_min[2], o->denorm_clamp_max[2], o->fmt_truncate_en,
+			 o->fmt_truncate_depth, o->fmt_truncate_mode, o->fmt_spatial_dither_en,
+			 o->fmt_temporal_dither_en, o->fmt_clamp_en, o->fmt_clamp_color_format,
+			 o->fmt_dyn_exp_en, o->fmt_dyn_exp_mode, o->fmt_pixel_encoding,
+			 o->fmt_subsampling);
+	}
+	drm_info(crtc->dev,
+		 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: RMCM (read %d, missing %u) 0 in %#x (shaper %u, 3D LUT %u), 1 in %#x (shaper %u, 3D LUT %u); HDMI encoder (read %d, missing %u): pixel encoding %u, colour format %u, deep colour %u/%u, DOLBY_VISION_EN %u, generic 0 %u/%u, 1 %u/%u\n",
+		 crtc->base.id, crtc->name, name, rb->rmcm_read, rb->rmcm_missing, rb->rmcm_cntl[0],
+		 rb->rmcm_shaper[0], rb->rmcm_3dlut[0], rb->rmcm_cntl[1], rb->rmcm_shaper[1],
+		 rb->rmcm_3dlut[1], rb->se_read, rb->se_missing, rb->se_pixel_encoding,
+		 rb->se_color_format, rb->se_deep_color_en, rb->se_deep_color_depth,
+		 rb->se_dolby_vision_en, rb->se_generic_send[0], rb->se_generic_cont[0],
+		 rb->se_generic_send[1], rb->se_generic_cont[1]);
+	kfree(rb);
+}
