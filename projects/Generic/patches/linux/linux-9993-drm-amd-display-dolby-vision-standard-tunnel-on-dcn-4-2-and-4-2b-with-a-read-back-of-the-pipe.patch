+/* Hades: the stream is on DCN 4.2 or 4.2B (dcn42, dcn42b) */
+bool amdgpu_dm_dvbridge_stream_dcn42(const struct dc_stream_state *stream)
+{
+	return stream && (stream->ctx->dce_version == DCN_VERSION_4_2 ||
+			  stream->ctx->dce_version == DCN_VERSION_4_2B);
+}
+
 /* Refuse colour processing and compositing: never bypass a user setting silently. */
 int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 				     struct drm_crtc *crtc,
@@ -2057,7 +2071,8 @@ int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 		return -EINVAL;
 	if (stream->ctx->dce_version < DCN_VERSION_3_0)
 		return amdgpu_dm_dvbridge_check_dcn1_2(stream, dc_plane);
-	if (stream->ctx->dce_version == DCN_VERSION_4_01)
