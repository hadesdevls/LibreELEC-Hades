+/*
+ * Hades: what the HDMI encoder sends of a byte tunnel stream (struct dc_byte_tunnel_dcn42_readback):
+ * its pixel encoding and depth as enc42_stream_encoder_hdmi_set_stream_attribute() sets them, the
+ * DOLBY_VISION_EN bit that dcn30_program_dmdata_engine() clears, and whether generic packets 0 and 1
+ * (the AVI InfoFrame and the vendor one, enc42_stream_encoder_update_hdmi_info_packets()) are sent.
+ * It changes nothing.
+ */
+static void enc42_read_byte_tunnel(struct stream_encoder *enc,
+				   struct dc_byte_tunnel_dcn42_readback *rb)
+{
+	struct dcn10_stream_encoder *enc1 = DCN10STRENC_FROM_STRENC(enc);
+
+	rb->se_missing = 0;
+	BT_GET(HDMI_CONTROL, TMDS_PIXEL_ENCODING, &rb->se_pixel_encoding, rb->se_missing);
+	BT_GET(HDMI_CONTROL, TMDS_COLOR_FORMAT, &rb->se_color_format, rb->se_missing);
+	BT_GET(HDMI_CONTROL, HDMI_DEEP_COLOR_ENABLE, &rb->se_deep_color_en, rb->se_missing);
+	BT_GET(HDMI_CONTROL, HDMI_DEEP_COLOR_DEPTH, &rb->se_deep_color_depth, rb->se_missing);
+	BT_GET(HDMI_CONTROL, DOLBY_VISION_EN, &rb->se_dolby_vision_en, rb->se_missing);
+	BT_GET(HDMI_GENERIC_PACKET_CONTROL0, HDMI_GENERIC0_SEND, &rb->se_generic_send[0],
+	       rb->se_missing);
+	BT_GET(HDMI_GENERIC_PACKET_CONTROL0, HDMI_GENERIC0_CONT, &rb->se_generic_cont[0],
+	       rb->se_missing);
+	BT_GET(HDMI_GENERIC_PACKET_CONTROL0, HDMI_GENERIC1_SEND, &rb->se_generic_send[1],
+	       rb->se_missing);
+	BT_GET(HDMI_GENERIC_PACKET_CONTROL0, HDMI_GENERIC1_CONT, &rb->se_generic_cont[1],
+	       rb->se_missing);
+	rb->se_read = true;
+}
