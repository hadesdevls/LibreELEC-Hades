+	uint32_t rmcm_shaper[2];	/* MPC_RMCM_SHAPER_MODE_CURRENT */
+	uint32_t rmcm_3dlut[2];		/* MPC_RMCM_3DLUT_MODE_CURRENT */
+	/* HDMI stream encoder */
+	bool se_read;
+	uint32_t se_missing;
+	uint32_t se_pixel_encoding;	/* HDMI_CONTROL.TMDS_PIXEL_ENCODING */
+	uint32_t se_color_format;	/* TMDS_COLOR_FORMAT */
+	uint32_t se_deep_color_en;	/* HDMI_DEEP_COLOR_ENABLE */
+	uint32_t se_deep_color_depth;	/* HDMI_DEEP_COLOR_DEPTH */
+	uint32_t se_dolby_vision_en;	/* DOLBY_VISION_EN */
+	uint32_t se_generic_send[2];	/* HDMI_GENERIC0/1_SEND: the AVI InfoFrame and the vendor one */
+	uint32_t se_generic_cont[2];	/* HDMI_GENERIC0/1_CONT */
+};
