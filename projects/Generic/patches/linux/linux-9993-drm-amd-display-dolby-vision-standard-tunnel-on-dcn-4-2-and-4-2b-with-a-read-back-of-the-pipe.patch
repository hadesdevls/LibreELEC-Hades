index 529dbe757..204e8b263 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -908,6 +908,72 @@ bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *str
 	return readback->ipp_read && readback->xfm_read && readback->opp_read;
 }
 
+/*
+ * Hades: the registers of every pipe of a byte tunnel stream on DCN 4.2 and 4.2B that decide whether
+ * its bytes reach the encoder as they were scanned out (struct dc_byte_tunnel_dcn42_readback), read
+ * back: the DPP and the MPCC of each pipe with the plane, the MPC output and the formatter of each
+ * OPP head (one per ODM slice), the two RMCM and the HDMI stream encoder. amdgpu_dm writes them to the
+ * kernel log each time the tunnel goes on. It changes nothing.
+ */
+bool dc_stream_read_byte_tunnel_dcn42(struct dc *dc, const struct dc_stream_state *stream,
+				      struct dc_byte_tunnel_dcn42_readback *readback)
+{
+	struct output_pixel_processor *opps[DC_BYTE_TUNNEL_DCN42_PIPES] = { NULL };
+	struct dpp *dpps[DC_BYTE_TUNNEL_DCN42_PIPES] = { NULL };
+	struct stream_encoder *se = NULL;
+	struct mpc *mpc = dc->res_pool->mpc;
+	bool ok = true;
+	unsigned int n;
+	int i;
+
+	memset(readback, 0, sizeof(*readback));
+	for (i = 0; i < MAX_PIPES; i++) {
+		const struct pipe_ctx *p = &dc->current_state->res_ctx.pipe_ctx[i];
+
+		if (p->stream != stream || !p->plane_state)
+			continue;
+		readback->all_pipes++;
+		if (p->plane_res.dpp && p->plane_res.hubp &&
+		    readback->pipes < DC_BYTE_TUNNEL_DCN42_PIPES) {
+			dpps[readback->pipes] = p->plane_res.dpp;
+			readback->dpp[readback->pipes].inst = p->plane_res.dpp->inst;
+			/* the MPCC of a pipe is its HUBP's (dcn42_update_mpcc()) */
+			readback->mpcc[readback->pipes].inst = p->plane_res.hubp->inst;
+			readback->pipes++;
+		}
+		if (!p->top_pipe && p->stream_res.opp &&
+		    readback->opps < DC_BYTE_TUNNEL_DCN42_PIPES) {
+			opps[readback->opps] = p->stream_res.opp;
+			readback->opp[readback->opps].inst = p->stream_res.opp->inst;
+			readback->opps++;
+			if (!p->prev_odm_pipe)
+				se = p->stream_res.stream_enc;
+		}
+	}
+	if (!readback->pipes || !readback->opps)
+		return false;
+
+	dc_exit_ips_for_hw_access(dc);
+
+	for (n = 0; n < readback->pipes; n++) {
+		if (dpps[n]->funcs->dpp_read_byte_tunnel)
+			dpps[n]->funcs->dpp_read_byte_tunnel(dpps[n], &readback->dpp[n]);
+		ok = ok && readback->dpp[n].read;
+	}
+	if (mpc && mpc->funcs->mpc_read_byte_tunnel)
+		mpc->funcs->mpc_read_byte_tunnel(mpc, readback);
+	for (n = 0; n < readback->opps; n++) {
+		if (opps[n]->funcs->opp_read_byte_tunnel_fmt)
+			opps[n]->funcs->opp_read_byte_tunnel_fmt(opps[n], &readback->opp[n]);
+		ok = ok && readback->opp[n].fmt_read && readback->opp[n].mpc_read;
+	}
+	for (n = 0; n < readback->pipes; n++)
+		ok = ok && readback->mpcc[n].read;
+	if (se && se->funcs->se_read_byte_tunnel)
+		se->funcs->se_read_byte_tunnel(se, readback);
+	return ok && readback->rmcm_read && readback->se_read;
+}
