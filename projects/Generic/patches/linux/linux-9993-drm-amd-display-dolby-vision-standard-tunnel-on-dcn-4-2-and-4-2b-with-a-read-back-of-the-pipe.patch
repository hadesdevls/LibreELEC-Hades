@@ -1947,6 +1947,11 @@ static int amdgpu_dm_dvbridge_check_stream_extras(const struct dc_stream_state *
  *   already checked. The output gamma and CSC are in the MPC as on DCN 3
  *   (dcn401_set_output_transfer_func(), mpc3_set_ocsc_default()); the commit setup refuses a
  *   tunnelled stream whose output TF is not bypass, as on DCN 1 and 2.
+ *
