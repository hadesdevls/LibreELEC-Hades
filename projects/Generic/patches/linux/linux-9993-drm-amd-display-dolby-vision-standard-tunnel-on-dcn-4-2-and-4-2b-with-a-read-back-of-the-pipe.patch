+/*
+ * Hades: one field for the read back of a byte tunnel, or 0 and counted in missing where the pool
+ * gives the encoder no register or no mask for it.
+ */
+#define BT_GET(reg, field, out, missing) \
+	do { \
+		if (REG(reg) && enc1->se_mask->field) { \
+			REG_GET(reg, field, out); \
+		} else { \
+			*(out) = 0; \
