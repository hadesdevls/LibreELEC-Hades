 	}
 }
 
+/*
+ * Hades: one field for the read back of a byte tunnel (struct dc_byte_tunnel_dcn42_readback), or 0
+ * and counted in missing where the pool gives the MPC no register or no mask for it.
+ */
+#define BT_GET(reg, field, out, missing) \
+	do { \
+		if (REG(reg) && mpc42->mpc_mask->field) { \
+			REG_GET(reg, field, out); \
+		} else { \
+			*(out) = 0; \
+			(missing)++; \
+		} \
+	} while (0)
+
+/*
+ * Hades: what decides in the MPC whether the bytes of a byte tunnel stream go through as they were
+ * scanned out: for the MPCC of each of its pipes, the blending (mpc42_update_blending(),
+ * mpc1_insert_plane()), the output gamma (mpc3_set_output_gamma()), the gamut remaps and the MCM
+ * (mpc401_*()); for the output of each of its OPPs, the output CSC (mpc3_set_ocsc_default()) and the
+ * denormalisation, which DC never programs on DCN; and the two RMCM, which DC never programs in this
+ * kernel either, so that MPC_RMCM_CNTL holds what the VBIOS or a reset left. It changes nothing.
+ */
+static void mpc42_read_byte_tunnel(struct mpc *mpc, struct dc_byte_tunnel_dcn42_readback *rb)
+{
+	struct dcn42_mpc *mpc42 = TO_DCN42_MPC(mpc);
+	unsigned int n;
+	int i;
+
+	for (n = 0; n < rb->pipes; n++) {
+		struct dc_byte_tunnel_dcn42_mpcc *m = &rb->mpcc[n];
+		int id = m->inst;
+
+		m->missing = 0;
+		if (id >= MAX_MPCC || id >= mpc42->num_mpcc)
+			continue;
+		BT_GET(MPCC_CONTROL[id], MPCC_MODE, &m->mode, m->missing);
+		BT_GET(MPCC_CONTROL[id], MPCC_ALPHA_BLND_MODE, &m->alpha_mode, m->missing);
+		BT_GET(MPCC_CONTROL[id], MPCC_ALPHA_MULTIPLIED_MODE, &m->premultiplied, m->missing);
+		BT_GET(MPCC_CONTROL[id], MPCC_BLND_ACTIVE_OVERLAP_ONLY, &m->overlap_only, m->missing);
+		BT_GET(MPCC_CONTROL2[id], MPCC_GLOBAL_ALPHA, &m->global_alpha, m->missing);
+		BT_GET(MPCC_CONTROL2[id], MPCC_GLOBAL_GAIN, &m->global_gain, m->missing);
+		m->alpha_max = mpc42->mpc_mask->MPCC_GLOBAL_ALPHA >> mpc42->mpc_shift->MPCC_GLOBAL_ALPHA;
+		m->gain_max = mpc42->mpc_mask->MPCC_GLOBAL_GAIN >> mpc42->mpc_shift->MPCC_GLOBAL_GAIN;
+		BT_GET(MPCC_TOP_SEL[id], MPCC_TOP_SEL, &m->top_sel, m->missing);
+		BT_GET(MPCC_BOT_SEL[id], MPCC_BOT_SEL, &m->bot_sel, m->missing);
+		BT_GET(MPCC_OGAM_CONTROL[id], MPCC_OGAM_MODE_CURRENT, &m->ogam, m->missing);
+		BT_GET(MPCC_GAMUT_REMAP_MODE[id], MPCC_GAMUT_REMAP_MODE_CURRENT, &m->gamut_remap,
+		       m->missing);
+		BT_GET(MPCC_MCM_FIRST_GAMUT_REMAP_MODE[id], MPCC_MCM_FIRST_GAMUT_REMAP_MODE_CURRENT,
+		       &m->mcm_gamut_remap[0], m->missing);
+		BT_GET(MPCC_MCM_SECOND_GAMUT_REMAP_MODE[id], MPCC_MCM_SECOND_GAMUT_REMAP_MODE_CURRENT,
+		       &m->mcm_gamut_remap[1], m->missing);
+		BT_GET(MPCC_MCM_SHAPER_CONTROL[id], MPCC_MCM_SHAPER_MODE_CURRENT, &m->mcm_shaper,
+		       m->missing);
+		BT_GET(MPCC_MCM_3DLUT_MODE[id], MPCC_MCM_3DLUT_MODE_CURRENT, &m->mcm_3dlut, m->missing);
+		BT_GET(MPCC_MCM_1DLUT_CONTROL[id], MPCC_MCM_1DLUT_MODE_CURRENT, &m->mcm_1dlut,
+		       m->missing);
+		m->read = true;
+	}
+
+	for (n = 0; n < rb->opps; n++) {
+		struct dc_byte_tunnel_dcn42_opp *o = &rb->opp[n];
+		struct color_matrices_reg ocsc_regs;
+		uint16_t coef[12] = { 0 };
+		int id = o->inst;
+
+		o->missing = 0;
+		if (id >= MAX_OPP)
+			continue;
+		BT_GET(CSC_MODE[id], MPC_OCSC_MODE, &o->ocsc_mode, o->missing);
+		/* set A, the one dcn20_program_output_csc() programs (cm_helper_read_color_matrices()) */
+		if (REG(CSC_C11_C12_A[id]) && REG(CSC_C33_C34_A[id]) &&
+		    REG(CSC_C33_C34_A[id]) - REG(CSC_C11_C12_A[id]) == 5 &&
+		    mpc42->mpc_mask->MPC_OCSC_C11_A && mpc42->mpc_mask->MPC_OCSC_C12_A) {
+			ocsc_regs.shifts.csc_c11 = mpc42->mpc_shift->MPC_OCSC_C11_A;
+			ocsc_regs.masks.csc_c11 = mpc42->mpc_mask->MPC_OCSC_C11_A;
+			ocsc_regs.shifts.csc_c12 = mpc42->mpc_shift->MPC_OCSC_C12_A;
+			ocsc_regs.masks.csc_c12 = mpc42->mpc_mask->MPC_OCSC_C12_A;
+			ocsc_regs.csc_c11_c12 = REG(CSC_C11_C12_A[id]);
+			ocsc_regs.csc_c33_c34 = REG(CSC_C33_C34_A[id]);
+			cm_helper_read_color_matrices(mpc42->base.ctx, coef, &ocsc_regs);
+			for (i = 0; i < 12; i++)
+				o->ocsc_coef[i] = coef[i];
+		} else {
+			o->missing++;
+		}
+		BT_GET(DENORM_CONTROL[id], MPC_OUT_DENORM_MODE, &o->denorm_mode, o->missing);
+		BT_GET(DENORM_CONTROL[id], MPC_OUT_DENORM_CLAMP_MIN_R_CR, &o->denorm_clamp_min[0],
+		       o->missing);
+		BT_GET(DENORM_CONTROL[id], MPC_OUT_DENORM_CLAMP_MAX_R_CR, &o->denorm_clamp_max[0],
+		       o->missing);
+		BT_GET(DENORM_CLAMP_G_Y[id], MPC_OUT_DENORM_CLAMP_MIN_G_Y, &o->denorm_clamp_min[1],
+		       o->missing);
+		BT_GET(DENORM_CLAMP_G_Y[id], MPC_OUT_DENORM_CLAMP_MAX_G_Y, &o->denorm_clamp_max[1],
+		       o->missing);
+		BT_GET(DENORM_CLAMP_B_CB[id], MPC_OUT_DENORM_CLAMP_MIN_B_CB, &o->denorm_clamp_min[2],
+		       o->missing);
+		BT_GET(DENORM_CLAMP_B_CB[id], MPC_OUT_DENORM_CLAMP_MAX_B_CB, &o->denorm_clamp_max[2],
+		       o->missing);
+		o->mpc_read = true;
+	}
+
+	rb->rmcm_missing = 0;
+	for (i = 0; i < 2; i++) {
+		BT_GET(MPC_RMCM_CNTL[i], MPC_RMCM_CNTL, &rb->rmcm_cntl[i], rb->rmcm_missing);
+		BT_GET(MPC_RMCM_SHAPER_CONTROL[i], MPC_RMCM_SHAPER_MODE_CURRENT, &rb->rmcm_shaper[i],
+		       rb->rmcm_missing);
+		BT_GET(MPC_RMCM_3DLUT_MODE[i], MPC_RMCM_3DLUT_MODE_CURRENT, &rb->rmcm_3dlut[i],
+		       rb->rmcm_missing);
+	}
+	rb->rmcm_read = true;
+}
+
+#undef BT_GET
+
 static const struct mpc_funcs dcn42_mpc_funcs = {
 	.read_mpcc_state = mpc42_read_mpcc_state,
 	.insert_plane = mpc1_insert_plane,
@@ -787,6 +902,7 @@ static const struct mpc_funcs dcn42_mpc_funcs = {
 		.fl_3dlut_configure = mpc42_set_fl_config,
 		.get_3dlut_mode = mpc42_get_rmcm_3dlut_mode,
 	},
+	.mpc_read_byte_tunnel = mpc42_read_byte_tunnel, /* Hades */
 };
 
