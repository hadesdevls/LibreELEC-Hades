 }
@@ -2375,11 +2390,430 @@ void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_st
 			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
 }
 
+/* Hades: the name of a DCN 4.2 version, for the kernel log */
+static const char *amdgpu_dm_dvbridge_dcn42_name(const struct dc_stream_state *stream)
+{
+	return stream->ctx->dce_version == DCN_VERSION_4_2B ? "4.2B" : "4.2";
+}
+
+/*
+ * Hades: DCN 4.2 and 4.2B: why the pipes that DC validated for a tunnelled stream would not carry
+ * its bytes unchanged, written to buf (true), or false: they would. From the validated context
+ * alone, what DC chooses by itself and amdgpu_dm_dvbridge_check_scanout() cannot see: one plane on
+ * pipes of its own, one per ODM slice and none blended over another (no MPC combine), as many as
+ * the read back covers, and no sub-viewport (SubVP) in the state; the scaler that SPL computed for
+ * each pipe in 444 bypass or DSCL bypass, with one tap and its edge adaptive filter (EASF) and
+ * sharpener (ISHARP) off (spl_get_dscl_mode(), dpp401_dscl_set_scaler_manual_scale()); the bit depth
+ * reduction of DITHER_OPTION_TRUN8 (truncation to 8 bits, no dither); and no clamp in the formatter.
+ */
+bool amdgpu_dm_dvbridge_dcn42_pipe_why(const struct dc_state *context,
+				       const struct dc_stream_state *stream, char *buf, size_t size)
+{
+	const struct bit_depth_reduction_params *bd = &stream->bit_depth_params;
+	const struct dc_plane_state *plane = NULL;
+	unsigned int pipes = 0, heads = 0;
+	size_t len = 0;
+	int i;
+
+	buf[0] = '\0';
+	if (!stream->byte_tunnel)
+		len += scnprintf(buf + len, size - len, "the stream is not a byte tunnel for DC");
+	for (i = 0; i < MAX_PIPES; i++) {
+		const struct pipe_ctx *p = &context->res_ctx.pipe_ctx[i];
+		const struct dscl_prog_data *d;
+
+		if (p->stream != stream)
+			continue;
+		pipes++;
+		if (!p->top_pipe)
+			heads++;
+		if (!p->plane_state) {
+			len += scnprintf(buf + len, size - len, "%spipe %d has no plane",
+					 len ? "; " : "", i);
+			continue;
+		}
+		if (plane && p->plane_state != plane)
+			len += scnprintf(buf + len, size - len, "%spipe %d has a second plane",
+					 len ? "; " : "", i);
+		plane = p->plane_state;
+		if (p->top_pipe || p->bottom_pipe)
+			len += scnprintf(buf + len, size - len,
+					 "%spipe %d is blended with another (MPC combine)",
+					 len ? "; " : "", i);
+		d = &p->plane_res.scl_data.dscl_prog_data;
+		if ((d->dscl_mode != SCL_MODE_SCALING_444_BYPASS &&
+		     d->dscl_mode != SCL_MODE_DSCL_BYPASS) ||
+		    d->taps.h_taps || d->taps.v_taps || d->easf_h_en || d->easf_v_en || d->isharp_en)
+			len += scnprintf(buf + len, size - len,
+					 "%spipe %d: scaler mode %u, taps %u/%u, EASF %u/%u, sharpener %u",
+					 len ? "; " : "", i, d->dscl_mode, d->taps.h_taps + 1,
+					 d->taps.v_taps + 1, d->easf_h_en, d->easf_v_en, d->isharp_en);
+	}
+	if (!plane)
+		len += scnprintf(buf + len, size - len, "%sDC gives the stream no pipe with its plane",
+				 len ? "; " : "");
+	if (pipes > DC_BYTE_TUNNEL_DCN42_PIPES || heads > DC_BYTE_TUNNEL_DCN42_PIPES)
+		len += scnprintf(buf + len, size - len,
+				 "%sDC gives the stream %u pipes (%u OPP heads), more than the read back covers",
+				 len ? "; " : "", pipes, heads);
+	if (context->phantom_stream_count)
+		len += scnprintf(buf + len, size - len, "%sthe state has %u sub-viewport (SubVP) streams",
+				 len ? "; " : "", context->phantom_stream_count);
+	if (!bd->flags.TRUNCATE_ENABLED || bd->flags.TRUNCATE_DEPTH != 1 || bd->flags.TRUNCATE_MODE ||
+	    bd->flags.SPATIAL_DITHER_ENABLED || bd->flags.FRAME_MODULATION_ENABLED)
+		len += scnprintf(buf + len, size - len,
+				 "%sbit depth reduction: truncation %u (depth %u, mode %u), spatial dither %u, frame modulation %u",
+				 len ? "; " : "", bd->flags.TRUNCATE_ENABLED, bd->flags.TRUNCATE_DEPTH,
+				 bd->flags.TRUNCATE_MODE, bd->flags.SPATIAL_DITHER_ENABLED,
+				 bd->flags.FRAME_MODULATION_ENABLED);
+	if (stream->clamping.clamping_level != CLAMPING_FULL_RANGE ||
+	    stream->clamping.pixel_encoding != PIXEL_ENCODING_RGB)
+		len += scnprintf(buf + len, size - len, "%sformatter clamp %d, pixel encoding %d",
+				 len ? "; " : "", stream->clamping.clamping_level,
+				 stream->clamping.pixel_encoding);
+	return len != 0;
+}
+
+/*
+ * Hades: DCN 4.2 and 4.2B: after the global validation of DC, what it will program for the pipes of
+ * each tunnelled stream of the commit (amdgpu_dm_dvbridge_dcn42_pipe_why()); and, once a read back
+ * of the pipes of a tunnel was not as the tunnel needs (amdgpu_dm_dvbridge_log_dcn42()), any commit
+ * that turns the tunnel on. Refused, with why in DVBRIDGE_REFUSED and in the kernel log: the display
+ * keeps its last configuration and user space goes on without the tunnel (HDR10).
+ */
+int amdgpu_dm_dvbridge_check_dcn42(struct drm_atomic_commit *state, const struct dc_state *context)
+{
+	struct amdgpu_device *adev = drm_to_adev(state->dev);
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_crtc *crtc;
+	char detail[384];
+	int i;
+
+	if (!context)
+		return 0;
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		const struct dc_stream_state *stream = to_dm_crtc_state(new_crtc_state)->stream;
+
+		if (!new_crtc_state->active || !amdgpu_dm_dvbridge_stream_active(stream) ||
+		    !amdgpu_dm_dvbridge_stream_dcn42(stream))
+			continue;
+		if (READ_ONCE(adev->dm.dvbridge_readback_failed) &&
+		    drm_atomic_crtc_needs_modeset(new_crtc_state)) {
+			scnprintf(detail, sizeof(detail),
+				  "DCN %s: a read back of the pipe of the tunnel was not as the tunnel needs (the kernel log has what was read); the tunnel stays off until the driver is loaded again",
+				  amdgpu_dm_dvbridge_dcn42_name(stream));
+		} else if (!amdgpu_dm_dvbridge_dcn42_pipe_why(context, stream, detail,
+							      sizeof(detail))) {
+			continue;
+		}
+		drm_dbg_atomic(state->dev, "[CRTC:%d:%s] Dolby Vision tunnel refused: DCN %s: %s\n",
+			       crtc->base.id, crtc->name, amdgpu_dm_dvbridge_dcn42_name(stream),
+			       detail);
+		/* (the reason goes out as "scanout", as on DCE) */
+		amdgpu_dm_dvbridge_refused_dce(state, crtc, detail);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+/*
+ * Hades: DCN 4.2 and 4.2B: what in a read back of the pipes of a tunnelled stream
+ * (dc_stream_read_byte_tunnel_dcn42()) is not as the tunnel needs it, written to buf (true), or false:
+ * all of it is. The expected values are those that DC writes for a byte tunnel stream, with
+ * DITHER_OPTION_TRUN8 and COLOR_SPACE_SRGB, through the functions named in struct
+ * dc_byte_tunnel_dcn42_readback; for the three blocks that DC never programs on DCN, their bypass
+ * (pre-CSC, denormalisation) or no RMCM with a LUT on in an MPCC of the stream. A field that could
+ * not be read counts as not as the tunnel needs. The vendor InfoFrame is judged only where the
+ * stream has one (vendor_infoframe: not with HDR over the tunnel). Not judged: the histogram (a
+ * tap that counts pixels), the colour matrix of the scaler (only programmed with EASF on), the
+ * dynamic expansion (each component keeps its 8 most significant bits, then truncated), the
+ * clamps of the denormalisation (programmed nowhere, and without meaning in its bypass), the
+ * clock of the DPP, the recout and the MPC size: all in the log.
+ */
+bool amdgpu_dm_dvbridge_dcn42_readback_why(const struct dc_byte_tunnel_dcn42_readback *rb,
+					   bool vendor_infoframe, char *buf, size_t size)
+{
+	static const uint32_t identity[12] = { 0x2000, 0, 0, 0, 0, 0x2000, 0, 0, 0, 0, 0x2000, 0 };
+	size_t len = 0;
+	unsigned int n, k;
+	int i;
+
+	buf[0] = '\0';
+	if (!rb->pipes || !rb->opps)
+		len += scnprintf(buf + len, size - len, "no pipe of the stream was found");
+	if (rb->all_pipes > rb->pipes)
+		len += scnprintf(buf + len, size - len, "%sthe stream has %u pipes, %u were read",
+				 len ? "; " : "", rb->all_pipes, rb->pipes);
+
+	for (n = 0; n < rb->pipes; n++) {
+		const struct dc_byte_tunnel_dcn42_dpp *d = &rb->dpp[n];
+		const struct dc_byte_tunnel_dcn42_mpcc *m = &rb->mpcc[n];
+
+		if (!d->read || d->missing)
+			len += scnprintf(buf + len, size - len,
+					 "%sDPP %u: not read (%u fields without a register or a mask)",
+					 len ? "; " : "", d->inst, d->missing);
+		else {
+			if (d->cnvc_bypass || d->expansion_mode != 1 || d->cnv16 ||
+			    d->bypass_msb_align || d->clamp_positive || d->crossbar[0] != 0 ||
+			    d->crossbar[1] != 1 || d->crossbar[2] != 2 || d->pixel_format != 8)
+				len += scnprintf(buf + len, size - len,
+						 "%sDPP %u: format converter bypass %u, expansion %u, cnv16 %u, MSB align %u, clamp %u, crossbar %u/%u/%u, format %u",
+						 len ? "; " : "", d->inst, d->cnvc_bypass,
+						 d->expansion_mode, d->cnv16, d->bypass_msb_align,
+						 d->clamp_positive, d->crossbar[0], d->crossbar[1],
+						 d->crossbar[2], d->pixel_format);
+			if (d->pre_dealpha || d->pre_realpha || d->keyer || d->cm_dealpha)
+				len += scnprintf(buf + len, size - len,
+						 "%sDPP %u: dealpha %u/%u, realpha %u, keyer %u",
+						 len ? "; " : "", d->inst, d->pre_dealpha, d->cm_dealpha,
+						 d->pre_realpha, d->keyer);
+			for (k = 0; k < 3; k++)
+				if (d->fcnv_bias[k] || d->fcnv_scale[k] != 0x1f000 || d->cm_bias[k])
+					break;
+			if (k < 3)
+				len += scnprintf(buf + len, size - len,
+						 "%sDPP %u: bias %#x %#x %#x, scale %#x %#x %#x, colour management bias %#x %#x %#x",
+						 len ? "; " : "", d->inst, d->fcnv_bias[0],
+						 d->fcnv_bias[1], d->fcnv_bias[2], d->fcnv_scale[0],
+						 d->fcnv_scale[1], d->fcnv_scale[2], d->cm_bias[0],
+						 d->cm_bias[1], d->cm_bias[2]);
+			if (d->pre_degam || d->pre_csc || d->post_csc || d->gamcor ||
+			    d->hdr_mult != 0x1f000)
+				len += scnprintf(buf + len, size - len,
+						 "%sDPP %u: pre-degamma %u, pre-CSC %u, post-CSC %u, gamma correction %u, HDR multiplier %#x",
+						 len ? "; " : "", d->inst, d->pre_degam, d->pre_csc,
+						 d->post_csc, d->gamcor, d->hdr_mult);
+			if ((d->dscl_mode != 0 && d->dscl_mode != 6) ||
+			    (d->dscl_mode == 0 && (d->easf_h || d->easf_v || d->isharp)))
+				len += scnprintf(buf + len, size - len,
+						 "%sDPP %u: scaler mode %u, EASF %u/%u, sharpener %u",
+						 len ? "; " : "", d->inst, d->dscl_mode, d->easf_h,
+						 d->easf_v, d->isharp);
+			if (d->cursor)
+				len += scnprintf(buf + len, size - len, "%sDPP %u: cursor on",
+						 len ? "; " : "", d->inst);
+		}
+
+		if (!m->read || m->missing)
+			len += scnprintf(buf + len, size - len,
+					 "%sMPCC %u: not read (%u fields without a register or a mask)",
+					 len ? "; " : "", m->inst, m->missing);
+		else {
+			/* top layer only or passthrough, nothing below, opaque and not premultiplied */
+			if ((m->mode != 1 && m->mode != 2) || m->bot_sel != 0xf ||
+			    m->top_sel != d->inst || m->alpha_mode != 2 ||
+			    m->global_alpha != m->alpha_max || m->global_gain != m->gain_max ||
+			    m->premultiplied || m->overlap_only)
+				len += scnprintf(buf + len, size - len,
+						 "%sMPCC %u: mode %u, top %u (DPP %u), bottom %#x, alpha mode %u, global alpha %#x of %#x, gain %#x of %#x, premultiplied %u, overlap only %u",
+						 len ? "; " : "", m->inst, m->mode, m->top_sel, d->inst,
+						 m->bot_sel, m->alpha_mode, m->global_alpha,
+						 m->alpha_max, m->global_gain, m->gain_max,
+						 m->premultiplied, m->overlap_only);
+			if (m->ogam || m->gamut_remap || m->mcm_gamut_remap[0] ||
+			    m->mcm_gamut_remap[1] || m->mcm_shaper || m->mcm_3dlut || m->mcm_1dlut)
+				len += scnprintf(buf + len, size - len,
+						 "%sMPCC %u: output gamma %u, gamut remap %u/%u/%u, MCM shaper %u, 3D LUT %u, 1D LUT %u",
+						 len ? "; " : "", m->inst, m->ogam, m->gamut_remap,
+						 m->mcm_gamut_remap[0], m->mcm_gamut_remap[1],
+						 m->mcm_shaper, m->mcm_3dlut, m->mcm_1dlut);
+		}
+	}
+
+	for (n = 0; n < rb->opps; n++) {
+		const struct dc_byte_tunnel_dcn42_opp *o = &rb->opp[n];
+		bool ocsc_ok = o->ocsc_mode == 0;
+
+		if (!o->mpc_read || !o->fmt_read || o->missing) {
+			len += scnprintf(buf + len, size - len,
+					 "%sOPP %u: not read (%u fields without a register or a mask)",
+					 len ? "; " : "", o->inst, o->missing);
+			continue;
+		}
+		if (o->ocsc_mode == 1)
+			ocsc_ok = !memcmp(o->ocsc_coef, identity, sizeof(identity));
+		if (!ocsc_ok)
+			len += scnprintf(buf + len, size - len,
+					 "%sOPP %u: output CSC mode %u, not the identity",
+					 len ? "; " : "", o->inst, o->ocsc_mode);
+		if (o->denorm_mode)
+			len += scnprintf(buf + len, size - len,
+					 "%sOPP %u: denormalisation mode %u, not bypass (DC never programs it)",
+					 len ? "; " : "", o->inst, o->denorm_mode);
+		if (!o->fmt_truncate_en || o->fmt_truncate_depth != 1 || o->fmt_truncate_mode)
+			len += scnprintf(buf + len, size - len,
+					 "%sOPP %u: formatter truncation %u (depth %u, mode %u), not to 8 bits",
+					 len ? "; " : "", o->inst, o->fmt_truncate_en,
+					 o->fmt_truncate_depth, o->fmt_truncate_mode);
+		if (o->fmt_spatial_dither_en || o->fmt_temporal_dither_en)
+			len += scnprintf(buf + len, size - len, "%sOPP %u: formatter dither %u/%u",
+					 len ? "; " : "", o->inst, o->fmt_spatial_dither_en,
+					 o->fmt_temporal_dither_en);
+		if (o->fmt_clamp_en || o->fmt_clamp_color_format)
+			len += scnprintf(buf + len, size - len, "%sOPP %u: formatter clamp %u/%u",
+					 len ? "; " : "", o->inst, o->fmt_clamp_en,
+					 o->fmt_clamp_color_format);
+		if (o->fmt_pixel_encoding || o->fmt_subsampling)
+			len += scnprintf(buf + len, size - len,
+					 "%sOPP %u: formatter pixel encoding %u, subsampling %u",
+					 len ? "; " : "", o->inst, o->fmt_pixel_encoding,
+					 o->fmt_subsampling);
+	}
+
+	if (!rb->rmcm_read || rb->rmcm_missing)
+		len += scnprintf(buf + len, size - len,
+				 "%sRMCM: not read (%u fields without a register or a mask)",
+				 len ? "; " : "", rb->rmcm_missing);
+	else
+		for (i = 0; i < 2; i++)
+			for (n = 0; n < rb->pipes; n++)
+				if (rb->rmcm_cntl[i] == rb->mpcc[n].inst &&
+				    (rb->rmcm_shaper[i] || rb->rmcm_3dlut[i]))
+					len += scnprintf(buf + len, size - len,
+							 "%sRMCM %d in MPCC %u with shaper %u, 3D LUT %u",
+							 len ? "; " : "", i, rb->mpcc[n].inst,
+							 rb->rmcm_shaper[i], rb->rmcm_3dlut[i]);
+
+	if (!rb->se_read || rb->se_missing)
+		len += scnprintf(buf + len, size - len,
+				 "%sHDMI encoder: not read (%u fields without a register or a mask)",
+				 len ? "; " : "", rb->se_missing);
+	else {
+		if (rb->se_pixel_encoding || rb->se_color_format || rb->se_deep_color_en ||
+		    rb->se_deep_color_depth || rb->se_dolby_vision_en)
+			len += scnprintf(buf + len, size - len,
+					 "%sHDMI encoder: pixel encoding %u, colour format %u, deep colour %u (depth %u), DOLBY_VISION_EN %u",
+					 len ? "; " : "", rb->se_pixel_encoding, rb->se_color_format,
+					 rb->se_deep_color_en, rb->se_deep_color_depth,
+					 rb->se_dolby_vision_en);
+		if (!rb->se_generic_send[0] || !rb->se_generic_cont[0] ||
+		    (vendor_infoframe && (!rb->se_generic_send[1] || !rb->se_generic_cont[1])))
+			len += scnprintf(buf + len, size - len,
+					 "%sHDMI encoder: AVI InfoFrame sent %u (each frame %u), vendor InfoFrame sent %u (each frame %u)",
+					 len ? "; " : "", rb->se_generic_send[0],
+					 rb->se_generic_cont[0], rb->se_generic_send[1],
+					 rb->se_generic_cont[1]);
+	}
+	return len != 0;
+}
