+struct dc_byte_tunnel_dcn42_dpp {
+	bool read;
+	uint32_t inst;
+	uint32_t missing;
+	/* format converter (CNVC) */
+	uint32_t cnvc_bypass;		/* FORMAT_CONTROL */
+	uint32_t expansion_mode;	/* 1: zero expansion */
+	uint32_t cnv16;
+	uint32_t bypass_msb_align;
+	uint32_t clamp_positive;
+	uint32_t crossbar[3];		/* R, G, B: 0, 1, 2 */
+	uint32_t pixel_format;		/* CNVC_SURFACE_PIXEL_FORMAT, 8: ARGB8888 */
+	uint32_t pre_dealpha;
+	uint32_t pre_realpha;
+	uint32_t fcnv_bias[3];		/* FCNV_FP_BIAS_R/G/B */
+	uint32_t fcnv_scale[3];		/* FCNV_FP_SCALE_R/G/B, 0x1f000: 1.0 */
+	uint32_t pre_degam;		/* PRE_DEGAM_MODE */
+	uint32_t pre_csc;		/* PRE_CSC_MODE_CURRENT: never programmed by DC */
+	uint32_t keyer;			/* COLOR_KEYER_EN, LUMA_KEYER_EN */
+	/* colour management (CM) */
+	uint32_t post_csc;		/* CM_POST_CSC_MODE_CURRENT */
+	uint32_t gamcor;		/* CM_GAMCOR_MODE_CURRENT */
+	uint32_t hdr_mult;		/* CM_HDR_MULT_COEF, 0x1f000: 1.0 */
+	uint32_t cm_bypass;		/* CM_CONTROL.CM_BYPASS */
+	uint32_t cm_dealpha;		/* CM_DEALPHA_EN */
+	uint32_t cm_bias[3];		/* CM_BIAS_CR_R, CM_BIAS_Y_G, CM_BIAS_CB_B */
+	uint32_t hist_channels;		/* CM_HIST_CNTL.CM_HIST_CH_EN */
+	/* scaler (DSCL) */
+	uint32_t dscl_mode;		/* SCL_MODE.DSCL_MODE: 0 444 bypass, 6 DSCL bypass */
+	uint32_t easf_h;		/* SCL_EASF_H_EN */
+	uint32_t easf_v;		/* SCL_EASF_V_EN */
+	uint32_t isharp;		/* ISHARP_EN */
+	uint32_t sc_matrix;		/* DSCL_SC_MODE.SCL_SC_MATRIX_MODE */
+	uint32_t sc_ltonl;		/* DSCL_SC_MODE.SCL_SC_LTONL_EN */
+	uint32_t recout[4];		/* RECOUT_START_X/Y, RECOUT_WIDTH/HEIGHT */
+	uint32_t mpc_size[2];		/* MPC_WIDTH, MPC_HEIGHT */
+	uint32_t cursor;		/* CURSOR0_CONTROL.CUR0_ENABLE */
+	uint32_t clock;			/* DPP_CONTROL.DPP_CLOCK_ENABLE */
+};
+
+struct dc_byte_tunnel_dcn42_mpcc {
+	bool read;
+	uint32_t inst;
+	uint32_t missing;
+	uint32_t mode;			/* MPCC_CONTROL.MPCC_MODE, 2: top layer only */
+	uint32_t alpha_mode;		/* MPCC_ALPHA_BLND_MODE, 2: global alpha */
+	uint32_t premultiplied;		/* MPCC_ALPHA_MULTIPLIED_MODE */
+	uint32_t overlap_only;		/* MPCC_BLND_ACTIVE_OVERLAP_ONLY */
+	uint32_t global_alpha;		/* MPCC_CONTROL2.MPCC_GLOBAL_ALPHA */
+	uint32_t global_gain;		/* MPCC_CONTROL2.MPCC_GLOBAL_GAIN */
+	uint32_t alpha_max;		/* the largest value of MPCC_GLOBAL_ALPHA (its mask) */
+	uint32_t gain_max;		/* ... and of MPCC_GLOBAL_GAIN */
+	uint32_t top_sel;		/* MPCC_TOP_SEL: the DPP */
+	uint32_t bot_sel;		/* MPCC_BOT_SEL, 0xf: none */
+	uint32_t ogam;			/* MPCC_OGAM_MODE_CURRENT */
+	uint32_t gamut_remap;		/* MPCC_GAMUT_REMAP_MODE_CURRENT */
+	uint32_t mcm_gamut_remap[2];	/* MPCC_MCM_FIRST/SECOND_GAMUT_REMAP_MODE_CURRENT */
+	uint32_t mcm_shaper;		/* MPCC_MCM_SHAPER_MODE_CURRENT */
+	uint32_t mcm_3dlut;		/* MPCC_MCM_3DLUT_MODE_CURRENT */
+	uint32_t mcm_1dlut;		/* MPCC_MCM_1DLUT_MODE_CURRENT */
+};
+
+struct dc_byte_tunnel_dcn42_opp {
+	bool mpc_read;			/* the MPC output of this OPP */
+	bool fmt_read;			/* the formatter */
+	uint32_t inst;
+	uint32_t missing;
+	uint32_t ocsc_mode;		/* CSC_MODE.MPC_OCSC_MODE, 1: coefficients A */
+	uint32_t ocsc_coef[12];		/* C11 ... C34 of set A, as cm_helper_program_color_matrices() writes them */
+	uint32_t denorm_mode;		/* DENORM_CONTROL.MPC_OUT_DENORM_MODE: never programmed by DC */
+	uint32_t denorm_clamp_min[3];
+	uint32_t denorm_clamp_max[3];
+	/* formatter */
+	uint32_t fmt_truncate_en;	/* FMT_BIT_DEPTH_CONTROL */
+	uint32_t fmt_truncate_depth;
+	uint32_t fmt_truncate_mode;
+	uint32_t fmt_spatial_dither_en;
+	uint32_t fmt_temporal_dither_en;
+	uint32_t fmt_clamp_en;		/* FMT_CLAMP_CNTL */
+	uint32_t fmt_clamp_color_format;
+	uint32_t fmt_dyn_exp_en;	/* FMT_DYNAMIC_EXP_CNTL */
+	uint32_t fmt_dyn_exp_mode;
+	uint32_t fmt_pixel_encoding;	/* FMT_CONTROL */
+	uint32_t fmt_subsampling;
+};
+
+struct dc_byte_tunnel_dcn42_readback {
+	unsigned int pipes;		/* DPP pipes of the stream, in dpp[] and mpcc[] */
+	unsigned int opps;		/* OPP heads of the stream (ODM), in opp[] */
+	unsigned int all_pipes;		/* every pipe of the stream that has a plane */
+	struct dc_byte_tunnel_dcn42_dpp dpp[DC_BYTE_TUNNEL_DCN42_PIPES];
+	struct dc_byte_tunnel_dcn42_mpcc mpcc[DC_BYTE_TUNNEL_DCN42_PIPES];
+	struct dc_byte_tunnel_dcn42_opp opp[DC_BYTE_TUNNEL_DCN42_PIPES];
+	/* RMCM 0 and 1: MPC_RMCM_CNTL (the MPCC it is in, 0xf: none) and its LUT modes */
