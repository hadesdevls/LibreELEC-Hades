diff --git a/include/drm/drm_dvbridge.h b/include/drm/drm_dvbridge.h
new file mode 100644
index 0000000..0724d5a
--- /dev/null
+++ b/include/drm/drm_dvbridge.h
@@ -0,0 +1,252 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * The policy of the Dolby Vision tunnel (DVBRIDGE_DV_STANDARD_LAB, DVBRIDGE_DV_LOW_LATENCY_LAB) that
+ * i915/xe and amdgpu share: what the EDID says of the sink, the CTA modes the tunnel takes, and the
+ * AVI InfoFrame it sends. Kodi reads the EDID with the same rule (CDisplayInfo, ScanDolbyVideo()),
+ * and a host test compares the two on real EDIDs.
+ *
+ * The EDID rule: exactly one Dolby VSVDB, of 12 bytes or more, in valid CTA extension blocks.
+ * - Standard (TV-led) with the Dolby vendor InfoFrame: version 2 with interface 2 or 3, or version 1
+ *   in its 12-byte form with the low-latency field 1, of any display management version (user space
+ *   sends a display of 2 or 3 the content mapping v2.9 part of the metadata, the part it reads). The
+ *   field 0, the 15-byte version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which the
+ *   tunnel does not send.
+ * - Low-Latency in YCbCr 4:2:2 at 12 bits (drm_dvbridge_ll.h): version 2 with any interface, or the
+ *   12-byte version 1 block with the low-latency field 1. No display management version is needed.
+ * - 2160p50 and 2160p60: always with version 2; with version 1, its 2160p60 bit.
+ * Every block of the EDID is walked: an HDMI Forum EEODB makes the EDID longer than its base block's
+ * extension count. Extensions that are not CTA (DisplayID) are skipped: a TV puts its CTA data blocks
+ * in CTA extensions (none of the 603 EDIDs of the host test has a Dolby block in DisplayID).
+ *
+ * The functions above the __KERNEL__ block touch no kernel object, so that a test can build them on
+ * the host.
+ */
+#ifndef __DRM_DVBRIDGE_H__
+#define __DRM_DVBRIDGE_H__
+
+#include <linux/types.h>
+
+/* What drm_dvbridge_edid_read() found: the first that applies, in the order of the walk */
+enum drm_dvbridge_edid_result {
+	/* exactly one Dolby VSVDB of 12 bytes or more, version 1 or 2 (it may advertise neither mode) */
+	DRM_DVBRIDGE_EDID_TAKEN,
+	DRM_DVBRIDGE_EDID_NONE,		/* no EDID */
+	DRM_DVBRIDGE_EDID_SIZE,		/* not whole blocks, or fewer than its extension count */
+	DRM_DVBRIDGE_EDID_HEADER,
+	DRM_DVBRIDGE_EDID_CHECKSUM,
+	DRM_DVBRIDGE_EDID_CTA,		/* a CTA extension block is not valid */
+	DRM_DVBRIDGE_EDID_DATA_BLOCK,	/* a CTA data block runs past its CTA block */
+	DRM_DVBRIDGE_EDID_SEVERAL,	/* more than one Dolby VSVDB */
+	DRM_DVBRIDGE_EDID_SHORT,	/* the Dolby VSVDB is shorter than 12 bytes */
+	DRM_DVBRIDGE_EDID_VERSION0,
+	DRM_DVBRIDGE_EDID_VERSION,	/* a version this rule does not know */
+	DRM_DVBRIDGE_EDID_NO_BLOCK,	/* no Dolby VSVDB */
+};
+
+/*
+ * The sink as its EDID describes it. standard and low_latency are true only with
+ * DRM_DVBRIDGE_EDID_TAKEN. p60 is what the Dolby block read says of 2160p50 and 2160p60, left as
+ * the walk had it when it stopped (as the drivers' copies of the rule did); it means something only
+ * with one of the two modes.
+ */
+struct drm_dvbridge_sink {
+	enum drm_dvbridge_edid_result result;
+	unsigned int version;
+	bool standard;
+	bool low_latency;
+	bool p60;
+};
+
+static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
+					  struct drm_dvbridge_sink *sink)
+{
+	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	unsigned int block, i, found = 0;
+
+	sink->result = DRM_DVBRIDGE_EDID_NONE;
+	sink->version = 0;
+	sink->standard = false;
+	sink->low_latency = false;
+	sink->p60 = false;
+	if (!edid || !size)
+		return;
+	sink->result = DRM_DVBRIDGE_EDID_SIZE;
+	if (size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
+		return;
+	sink->result = DRM_DVBRIDGE_EDID_HEADER;
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return;
+	for (block = 0; block < size / 128; block++) {
+		const u8 *b = edid + block * 128;
+		unsigned int end, pos;
+		u8 sum = 0;
+
+		for (i = 0; i < 128; i++)
+			sum += b[i];
+		if (sum) {
+			sink->result = DRM_DVBRIDGE_EDID_CHECKSUM;
+			goto refused;
+		}
+		if (!block || b[0] != 0x02 || b[1] < 3)
+			continue;
+		end = b[2];
+		if (!end)
+			continue;
+		if (end < 4 || end > 127) {
+			sink->result = DRM_DVBRIDGE_EDID_CTA;
+			goto refused;
+		}
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const u8 *data = b + pos + 1;
+
+			if (pos + len + 1 > end) {
+				sink->result = DRM_DVBRIDGE_EDID_DATA_BLOCK;
+				goto refused;
+			}
+			/* Extended vendor-specific video block, little-endian Dolby OUI */
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1) {
+					sink->result = DRM_DVBRIDGE_EDID_SEVERAL;
+					goto refused;
+				}
+				if (len < 11) {
+					sink->result = DRM_DVBRIDGE_EDID_SHORT;
+					goto refused;
+				}
+				sink->version = data[4] >> 5;
+				switch (sink->version) {
+				case 2:
+					sink->standard = (data[6] & 3) >= 2;
+					sink->low_latency = true;
+					sink->p60 = true;
+					break;
+				case 1:
+					sink->standard = len == 11 && (data[7] & 3) == 1;
+					sink->low_latency = sink->standard;
+					sink->p60 = data[4] & 2;
+					break;
+				case 0:
+					sink->result = DRM_DVBRIDGE_EDID_VERSION0;
+					goto refused;
+				default:
+					sink->result = DRM_DVBRIDGE_EDID_VERSION;
+					goto refused;
+				}
+			}
+			pos += len + 1;
+		}
+	}
+	sink->result = found ? DRM_DVBRIDGE_EDID_TAKEN : DRM_DVBRIDGE_EDID_NO_BLOCK;
+	return;
+refused:
+	sink->standard = false;
+	sink->low_latency = false;
+}
+
+/* What the EDID lacks for a mode of the tunnel, for the kernel log; NULL when it has it. */
+static inline const char *drm_dvbridge_sink_why(const struct drm_dvbridge_sink *sink,
+						bool low_latency)
+{
+	switch (sink->result) {
+	case DRM_DVBRIDGE_EDID_TAKEN:
+		break;
+	case DRM_DVBRIDGE_EDID_NONE:
+		return "no EDID";
+	case DRM_DVBRIDGE_EDID_SIZE:
+		return "the EDID is not whole blocks, or shorter than its extension count says";
+	case DRM_DVBRIDGE_EDID_HEADER:
+		return "the EDID header is not valid";
+	case DRM_DVBRIDGE_EDID_CHECKSUM:
+		return "an EDID block has a wrong checksum";
+	case DRM_DVBRIDGE_EDID_CTA:
+		return "a CTA extension block is not valid";
+	case DRM_DVBRIDGE_EDID_DATA_BLOCK:
+		return "a CTA data block is not valid";
+	case DRM_DVBRIDGE_EDID_SEVERAL:
+		return "the EDID has several Dolby Vision blocks";
+	case DRM_DVBRIDGE_EDID_SHORT:
+		return "the Dolby Vision block is shorter than 12 bytes";
+	case DRM_DVBRIDGE_EDID_VERSION0:
+		return low_latency ?
+		       "the Dolby Vision block is version 0, which has no Low-Latency mode" :
+		       "the Dolby Vision block is version 0, for the HDMI 1.4b vendor InfoFrame, which this driver does not send";
+	case DRM_DVBRIDGE_EDID_VERSION:
+		return "the Dolby Vision block has a version this driver does not know";
+	case DRM_DVBRIDGE_EDID_NO_BLOCK:
+	default:
+		return "the EDID has no Dolby Vision block";
+	}
+	if (low_latency)
+		return sink->low_latency ? NULL :
+		       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1";
+	if (sink->standard)
+		return NULL;
+	return sink->version == 2 ?
+	       "the Dolby Vision block has no Standard interface (Low-Latency only)" :
+	       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1 (it asks for the HDMI 1.4b vendor InfoFrame, which this driver does not send)";
+}
+
+/* The sink takes the tunnel in Standard (TV-led) Dolby Vision. *p60: as struct drm_dvbridge_sink. */
+static inline bool drm_dvbridge_edid_standard(const u8 *edid, size_t size, bool *p60)
+{
+	struct drm_dvbridge_sink sink;
+
+	drm_dvbridge_edid_read(edid, size, &sink);
+	*p60 = sink.p60;
+	return sink.standard;
+}
+
+/*
+ * The CTA VIC of the AVI InfoFrame of the tunnel: 1080p and 2160p at 24, 25, 30, 50 and 60 Hz
+ * (fractional clocks included); 0 for any other mode, which the tunnel does not take. The AVI
+ * InfoFrame carries the timing because the vendor slot carries the Dolby VSIF, and no HDMI 1.4
+ * vendor packet (HDMI VIC) competes with it.
+ */
+static inline u8 drm_dvbridge_avi_vic(u8 cea_vic)
+{
+	switch (cea_vic) {
+	case 16: case 31: case 32: case 33: case 34:
+	case 93: case 94: case 95: case 96: case 97:
+		return cea_vic;
+	default:
+		return 0;
+	}
+}
+
+/* 2160p50 and 2160p60 (CTA VIC 96 and 97) need a sink whose Dolby block advertises 2160p60. */
+static inline bool drm_dvbridge_vic_needs_p60(u8 vic)
+{
+	return vic == 96 || vic == 97;
+}
+
+#ifdef __KERNEL__
+#include <linux/hdmi.h>
+
+/*
+ * The AVI InfoFrame of the tunnel, from the one the driver built for the mode (its aspect ratio
+ * and content type): RGB is a byte tunnel here, not a colour-managed picture, so the frame says
+ * RGB, no colorimetry and full range, with the CTA VIC of drm_dvbridge_avi_vic(). (The YQ field
+ * stays as each driver sets it for RGB; a sink ignores it with RGB, CTA-861-F.)
+ */
+static inline void drm_dvbridge_tunnel_avi(struct hdmi_avi_infoframe *frame, u8 vic)
+{
+	frame->video_code = vic;
+	frame->colorspace = HDMI_COLORSPACE_RGB;
+	frame->colorimetry = HDMI_COLORIMETRY_NONE;
+	frame->extended_colorimetry = 0;
+	frame->quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
+}
+
+/* The Dolby VSIF of the tunnel, in the vendor slot: the Dolby Vision signal. */
+static inline void drm_dvbridge_tunnel_vsif(struct hdmi_dolby_vendor_infoframe *frame)
+{
+	hdmi_dolby_vendor_infoframe_init(frame);
+	frame->signal = true;
+}
+#endif /* __KERNEL__ */
+
+#endif /* __DRM_DVBRIDGE_H__ */
+
