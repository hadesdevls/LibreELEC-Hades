 /*
  * An EDID with exactly one Dolby VSVDB that advertises Standard (TV-led) DV with the Dolby VSIF:
- * version 2 with interface 2 or 3, or version 1 in its 12-byte form with the low-latency field 1
- * (Standard and low latency), of any display management version (user space sends a display of 2
- * or 3 the content mapping v2.9 part of the metadata, the part it reads). The field 0, the 15-byte
- * version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which this tunnel does not
- * send. *p60: the sink takes it at 2160p50 and 2160p60, always with version 2. Kodi reads the
- * EDID with the same rule.
+ * the rule of drm_dvbridge.h, which i915 and Kodi follow (this name is kept for the host test of
+ * the rule). *p60: the sink takes it at 2160p50 and 2160p60, always with version 2.
  */
 static inline bool amdgpu_dm_dvbridge_edid_standard(const u8 *edid, size_t size, bool *p60)
 {
-	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
-	unsigned int block, i, found = 0;
-	bool standard = false;
-
-	*p60 = false;
-	/* An HDMI Forum EEODB makes the EDID longer than its base block's extension count. */
-	if (!edid || size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
-		return false;
-	for (i = 0; i < 8; i++)
-		if (edid[i] != magic[i])
-			return false;
-	for (block = 0; block < size / 128; block++) {
-		const u8 *b = edid + block * 128;
-		unsigned int end, pos;
-		u8 sum = 0;
-
-		for (i = 0; i < 128; i++)
-			sum += b[i];
-		if (sum)
-			return false;
-		if (!block || b[0] != 0x02 || b[1] < 3)
-			continue;
-		end = b[2];
-		if (!end)
-			continue;
-		if (end < 4 || end > 127)
-			return false;
-		for (pos = 4; pos < end;) {
-			unsigned int len = b[pos] & 31;
-			const u8 *data = b + pos + 1;
-
-			if (pos + len + 1 > end)
-				return false;
-			/* Extended vendor-specific video block, little-endian Dolby OUI */
-			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
-			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
-				if (++found != 1 || len < 11)
-					return false;
-				switch (data[4] >> 5) {
-				case 2:
-					/* VSVDB v2 interface 2 or 3 advertises Standard DV */
-					standard = (data[6] & 3) >= 2;
-					*p60 = true;
-					break;
-				case 1:
-					standard = len == 11 && (data[7] & 3) == 1;
-					*p60 = data[4] & 2;
-					break;
-				default:
-					return false;
-				}
-			}
-			pos += len + 1;
-		}
-	}
-	return found == 1 && standard;
-}
-
-/*
- * CTA 1080p and 2160p at 24, 25, 30, 50 and 60 Hz (fractional clocks included): the AVI
- * InfoFrame carries the timing because the vendor slot carries the Dolby VSIF.
- */
-static inline u8 amdgpu_dm_dvbridge_avi_vic(u8 cea_vic)
-{
-	switch (cea_vic) {
-	case 16: case 31: case 32: case 33: case 34:
-	case 93: case 94: case 95: case 96: case 97:
-		return cea_vic;
-	default:
-		return 0;
-	}
+	return drm_dvbridge_edid_standard(edid, size, p60);
 }
 
