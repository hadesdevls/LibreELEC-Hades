+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1660,13 +1660,13 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 				   struct dc_stream_state *stream)
 {
 	u8 buf[HDMI_INFOFRAME_SIZE(DOLBY_VENDOR)];
-	u8 vic = amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode));
+	u8 vic = drm_dvbridge_avi_vic(drm_match_cea_mode(mode));
 	/* Hades: Dolby Vision Low-Latency over the tunnel (drm_dvbridge_ll.h) */
 	const bool low_latency = to_dm_connector_state(con_state)->dvbridge_dv_low_latency;
 	struct hdmi_dolby_vendor_infoframe dv;
+	struct drm_dvbridge_sink sink;
 	struct hdmi_avi_infoframe avi;
 	ssize_t len;
-	bool p60;
 	int ret;
 
 	/*
@@ -1677,29 +1677,24 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	 */
 	if (stream->signal == SIGNAL_TYPE_VIRTUAL)
 		return 0; /* no display (a fake sink): nothing receives it, no tunnel is built */
-	if (!stream->sink ||
-	    !(low_latency ?
-	      drm_dvbridge_ll_edid(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length,
-				   &p60) :
-	      amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
-					       stream->sink->dc_edid.length, &p60)))
+	if (!stream->sink)
+		return -EOPNOTSUPP;
+	/* (Hades: the rule of drm_dvbridge.h, read once) */
+	drm_dvbridge_edid_read(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length, &sink);
+	if (!(low_latency ? sink.low_latency : sink.standard))
 		return -EOPNOTSUPP;
 	if (!vic || (mode->flags & DRM_MODE_FLAG_3D_MASK))
 		return -EINVAL;
 	/* 2160p50 and 2160p60 need a sink that advertises Dolby Vision at 2160p60. */
-	if (!p60 && (vic == 96 || vic == 97))
+	if (!sink.p60 && drm_dvbridge_vic_needs_p60(vic))
 		return -EINVAL;
 
-	/* RGB is a byte tunnel here, not an RGB colour-managed picture. */
+	/* RGB is a byte tunnel here, not an RGB colour-managed picture (drm_dvbridge.h). */
 	ret = drm_hdmi_avi_infoframe_from_display_mode(&avi, connector, mode);
 	if (ret)
 		return ret;
 	drm_hdmi_avi_infoframe_content_type(&avi, con_state);
-	avi.video_code = vic;
-	avi.colorspace = HDMI_COLORSPACE_RGB;
-	avi.colorimetry = HDMI_COLORIMETRY_NONE;
-	avi.extended_colorimetry = 0;
-	avi.quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
+	drm_dvbridge_tunnel_avi(&avi, vic);
 	/* Hades: what the sink's Low-Latency input reads the same bytes as (drm_dvbridge_ll.h) */
 	if (low_latency)
 		drm_dvbridge_ll_avi(&avi);
@@ -1714,8 +1709,7 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	 * AVI carries the CTA timing, so the vendor slot holds the Dolby VSIF and no
 	 * HDMI 1.4 vendor packet competes with it.
 	 */
-	hdmi_dolby_vendor_infoframe_init(&dv);
-	dv.signal = true;
+	drm_dvbridge_tunnel_vsif(&dv);
 	/* Hades: ... with low latency (drm_dvbridge_ll.h) */
 	if (low_latency)
 		drm_dvbridge_ll_vsif(&dv);
@@ -1763,7 +1757,7 @@ static int amdgpu_dm_dvbridge_check_connector(struct amdgpu_dm_connector *aconn,
 	     (dm_state->underscan_hborder || dm_state->underscan_vborder)))
 		return -EINVAL;
 	mode = &crtc_state->mode;
-	if (!amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode)) ||
+	if (!drm_dvbridge_avi_vic(drm_match_cea_mode(mode)) ||
 	    (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN |
 			    DRM_MODE_FLAG_DBLCLK | DRM_MODE_FLAG_3D_MASK)))
 		return -EINVAL;
