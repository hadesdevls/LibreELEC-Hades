From 0e9c7b38dae9b6fe774fbeef1bb20c20df121d74 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:52:52 +0000
Subject: [PATCH] drm: HDR in YCbCr 4:2:0 at 10 bits where RGB would leave at 8

HDR10 and HLG are 10-bit signals. At 3840x2160 above 30 Hz over HDMI
TMDS (594 MHz at most: HDMI 2.0, or an HDMI 2.1 TV that the graphics
card drives without FRL, as amdgpu does by default and i915 always),
RGB fits at 8 bits only, and i915 and amdgpu then send HDR at 8 bits:
both lower the depth until the TMDS clock fits. The video is YCbCr
4:2:0 already, and in 4:2:0 the same mode needs half the clock, 371.25
MHz at 10 bits. Most HDR TVs take 2160p50 and 2160p60 in 4:2:0 too (the
YCbCr 4:2:0 capability map of their EDID) with deep colour in 4:2:0
(DC_30_420 or DC_36_420 of their HDMI Forum VSDB).

This header gives i915 and amdgpu one rule for it. Where a connector
state has HDR static metadata with the PQ or HLG transfer function, the
configuration the driver computed sends RGB below 10 bits per
component, max bpc and the sink's deep colour let it reach 10, the sink
is an HDMI sink over TMDS, the source sends 4:2:0, the sink takes the
mode in 4:2:0 as well as RGB and takes deep colour in 4:2:0, the driver
computes the 4:2:0 configuration (drm_dvbridge_hdr420_try()) and keeps
it if it reaches 10 bits per component or more, and more than RGB
(drm_dvbridge_hdr420_keep()); otherwise RGB stays as it was. Nothing of
the picture is lost (the video is 4:2:0), two bits are gained, and only
the chroma of what is drawn over the video, the GUI and subtitles, is
at half resolution. SDR is never touched, nor the Dolby Vision tunnel
(RGB at 8 bits, a byte tunnel), nor a link that carries RGB at 10 bits
already. drm_dvbridge_hdr420_why_not() says why the rule did not try,
for the kernel log; it is NULL exactly when it tries.

Two connector properties go with it:
- DVBRIDGE_HDR_YCBCR420, an enum: "deep" (0, the default of a state
  that is reset) or "never", with which the driver chooses as without
  this rule. It is a choice of the user (in Kodi, an expert setting).
- DVBRIDGE_LINK_FORMAT, a read-only bitmask beside the HDR10 depth
  guard (DVBRIDGE_HDR10_DEEP_COLOR): the answer to the question the
  guard asks. The driver writes it from the atomic check of every
  request of the guard, TEST_ONLY included, with one bit for the format
  (rgb, ycbcr444, ycbcr422, ycbcr420) and one for the bits per
  component (6bpc to 16bpc) of the configuration that was checked, 0
  when there is none. Kodi asks it in a TEST_ONLY commit to say in its
  player information at what depth and in what format HDR leaves.

The functions above the __KERNEL__ block touch no kernel object. A
host test runs the rule over every combination of its inputs against
the rule written out in plain terms, checks that each input alone can
turn it off, and runs a model of how each driver chooses the depth of
TMDS (i915's intel_hdmi_compute_bpc() with LibreELEC's linux 9900,
amdgpu's convert_color_depth_from_display_info() and
adjust_colour_depth_from_display_info()) with the rule on top, over
modes, TMDS limits, sink deep colour in RGB and 4:2:0, max bpc and
display versions: RGB as before wherever RGB reaches 10 bits or the
rule does not apply, and 4:2:0 at 10 bits or more exactly where it
does and the link carries it.

The idea of sending HDR in 4:2:0 deep colour where RGB would drop to 8
bits comes from linux-9904 of the YBLOD fork
(github.com/dangerouslaser/libreelec-yblod) and, before it, from
linux-9900-07 of CroqueMr's Intel Dolby Vision fork, which did it on
Lunar Lake for HDR10 only. This is that idea for both drivers, as a
rule user space can turn off and read back.
---
 include/drm/drm_dvbridge_hdr.h | 248 +++++++++++++++++++++++++++++++++
 1 file changed, 248 insertions(+)
 create mode 100644 include/drm/drm_dvbridge_hdr.h

diff --git a/include/drm/drm_dvbridge_hdr.h b/include/drm/drm_dvbridge_hdr.h
new file mode 100644
index 0000000..b24ed9d
--- /dev/null
+++ b/include/drm/drm_dvbridge_hdr.h
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: HDR video in YCbCr 4:2:0 at 10 bits per component or more where the link would carry it
+ * in RGB with fewer, and what a configuration sends, for i915 and amdgpu: one rule for both.
+ *
+ * HDR10 and HLG are 10-bit signals. At 3840x2160 above 30 Hz over HDMI TMDS (594 MHz at most),
+ * RGB fits at 8 bits only, and both drivers then send 8 bits: they lower the depth until the TMDS
+ * clock fits (i915: intel_hdmi_compute_bpc(); amdgpu: adjust_colour_depth_from_display_info()).
+ * The video is YCbCr 4:2:0 already, and in 4:2:0 the same mode needs half the clock: 371.25 MHz
+ * at 10 bits. Where the sink takes the mode in 4:2:0 too (its YCbCr 4:2:0 capability map, as
+ * drm_mode_is_420_also() reads it) and deep colour in 4:2:0 (DC_30_420, DC_36_420 or DC_48_420
+ * of its HDMI Forum VSDB, drm_hdmi_info.y420_dc_modes), the driver sends 4:2:0 at the depth it
+ * chooses for it, if that is 10 bits or more, instead of RGB at 8. The video gains two bits; the
+ * chroma of what is drawn over it (the GUI, subtitles) loses resolution.
+ *
+ * Only for a connector state whose HDR_OUTPUT_METADATA has the PQ (SMPTE ST 2084) or HLG
+ * transfer function: SDR is never touched, nor the Dolby Vision tunnel (RGB at 8 bits, a byte
+ * tunnel), nor a link that carries RGB at 10 bits or more already (as HDMI FRL does). The
+ * connector property DVBRIDGE_HDR_YCBCR420 turns it off: "deep" (the default) or "never" (the
+ * driver chooses as without this rule).
+ *
+ * drm_dvbridge_hdr420_try() says whether the 4:2:0 configuration is to be computed, from the RGB
+ * one; drm_dvbridge_hdr420_keep() whether it is kept; drm_dvbridge_hdr420_why_not() says, for
+ * the kernel log, why it was not tried: NULL exactly when it is.
+ *
+ * DVBRIDGE_LINK_FORMAT, a read-only bitmask connector property beside the HDR10 depth guard
+ * (DVBRIDGE_HDR10_DEEP_COLOR), is the answer to the question that the guard asks: the driver
+ * writes it from the atomic check of every request of the guard (Kodi asks in a TEST_ONLY
+ * commit), with one bit for the format and one for the bits per component of the configuration
+ * that was checked; 0 when there is none. Nothing in the kernel reads it.
+ *
+ * The functions above the __KERNEL__ block touch no kernel object, so that a test can build them
+ * on the host.
+ */
+#ifndef __DRM_DVBRIDGE_HDR_H__
+#define __DRM_DVBRIDGE_HDR_H__
+
+#include <linux/types.h>
+#include <linux/hdmi.h>
+
+/* The values of DVBRIDGE_HDR_YCBCR420 */
+enum drm_dvbridge_hdr_ycbcr420 {
+	/* HDR in YCbCr 4:2:0 at 10 bits or more where RGB would have fewer: the default */
+	DRM_DVBRIDGE_HDR_YCBCR420_DEEP,
+	/* never for that: the driver chooses as without this rule */
+	DRM_DVBRIDGE_HDR_YCBCR420_NEVER,
+};
+
+static inline const char *drm_dvbridge_hdr_ycbcr420_name(unsigned int value)
+{
+	switch (value) {
+	case DRM_DVBRIDGE_HDR_YCBCR420_DEEP:
+		return "deep";
+	case DRM_DVBRIDGE_HDR_YCBCR420_NEVER:
+		return "never";
+	default:
+		return NULL;
+	}
+}
+
+/*
+ * The deep colour bits of drm_hdmi_info.y420_dc_modes: DRM_EDID_YCBCR420_DC_30, _36 and _48
+ * (DC_30_420, DC_36_420 and DC_48_420 of the HDMI Forum VSDB), checked against drm_edid.h below
+ */
+#define DRM_DVBRIDGE_Y420_DEEP_COLOUR	((1 << 0) | (1 << 1) | (1 << 2))
+
+/* HDR static metadata (CTA-861.3 type 1) with the PQ or the HLG transfer function */
+static inline bool drm_dvbridge_hdr_eotf(u32 metadata_type, u8 eotf)
+{
+	return metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+	       (eotf == HDMI_EOTF_SMPTE_ST2084 || eotf == HDMI_EOTF_BT_2100_HLG);
+}
+
+/* What the rule looks at, for the configuration the driver computed in RGB */
+struct drm_dvbridge_hdr420 {
+	bool never;		/* DVBRIDGE_HDR_YCBCR420 is "never" */
+	bool hdr;		/* drm_dvbridge_hdr_eotf() of the connector state's HDR metadata */
+	bool dv_tunnel;		/* the Dolby Vision tunnel is requested on the connector */
+	bool hdmi_sink;		/* an HDMI sink (not DVI), over TMDS */
+	bool source;		/* the output can send YCbCr 4:2:0 in this commit */
+	bool mode;		/* the sink takes this mode in YCbCr 4:2:0 as well as in RGB */
+	bool rgb;		/* the configuration computed sends RGB */
+	unsigned int bpc;	/* ... at this many bits per component */
+	unsigned int max_bpc;	/* the most bits per component the connector state lets through */
+	u8 y420_dc_modes;	/* the sink's deep colour in YCbCr 4:2:0 (drm_hdmi_info) */
+};
+
+/* Whether the YCbCr 4:2:0 configuration is to be computed (drm_dvbridge_hdr420_why_not()) */
+static inline bool drm_dvbridge_hdr420_try(const struct drm_dvbridge_hdr420 *s)
+{
+	return s->hdr && !s->dv_tunnel && !s->never && s->rgb && s->bpc < 10 &&
+	       s->max_bpc >= 10 && s->hdmi_sink && s->source && s->mode &&
+	       (s->y420_dc_modes & DRM_DVBRIDGE_Y420_DEEP_COLOUR);
+}
+
+/* Why it is not: the first test that fails, for the kernel log; NULL exactly when it is tried */
+static inline const char *drm_dvbridge_hdr420_why_not(const struct drm_dvbridge_hdr420 *s)
+{
+	if (!s->hdr)
+		return "no HDR metadata with the PQ or HLG transfer function";
+	if (s->dv_tunnel)
+		return "the Dolby Vision tunnel is requested";
+	if (s->never)
+		return "DVBRIDGE_HDR_YCBCR420 is never";
+	if (!s->rgb)
+		return "the output is not RGB";
+	if (s->bpc >= 10)
+		return "RGB goes out at 10 bits or more";
+	if (s->max_bpc < 10)
+		return "max bpc, or the deep colour of the sink, is below 10 bits";
+	if (!s->hdmi_sink)
+		return "the sink is not an HDMI sink over TMDS";
+	if (!s->source)
+		return "this output does not send YCbCr 4:2:0 here";
+	if (!s->mode)
+		return "the sink takes this mode in RGB only (it is not in its YCbCr 4:2:0 capability map)";
+	if (!(s->y420_dc_modes & DRM_DVBRIDGE_Y420_DEEP_COLOUR))
+		return "the sink takes no deep colour in YCbCr 4:2:0 (no DC_30_420, DC_36_420 or DC_48_420)";
+	return NULL;
+}
+
+/*
+ * Whether the YCbCr 4:2:0 configuration that was computed is kept: it carries 10 bits per
+ * component or more, and more than RGB did. Otherwise the RGB one is.
+ */
+static inline bool drm_dvbridge_hdr420_keep(unsigned int rgb_bpc, unsigned int ycbcr420_bpc)
+{
+	return ycbcr420_bpc >= 10 && ycbcr420_bpc > rgb_bpc;
+}
+
+/* The bits of DVBRIDGE_LINK_FORMAT: one format, and one depth */
+enum drm_dvbridge_link {
+	DRM_DVBRIDGE_LINK_RGB,
+	DRM_DVBRIDGE_LINK_YCBCR444,
+	DRM_DVBRIDGE_LINK_YCBCR422,
+	DRM_DVBRIDGE_LINK_YCBCR420,
+	DRM_DVBRIDGE_LINK_6BPC,
+	DRM_DVBRIDGE_LINK_8BPC,
+	DRM_DVBRIDGE_LINK_10BPC,
+	DRM_DVBRIDGE_LINK_12BPC,
+	DRM_DVBRIDGE_LINK_14BPC,
+	DRM_DVBRIDGE_LINK_16BPC,
+	DRM_DVBRIDGE_LINK_COUNT
+};
+
+/* The name of a bit, as the property gives it; NULL for an unknown bit */
+static inline const char *drm_dvbridge_link_name(unsigned int bit)
+{
+	switch (bit) {
+	case DRM_DVBRIDGE_LINK_RGB:
+		return "rgb";
+	case DRM_DVBRIDGE_LINK_YCBCR444:
+		return "ycbcr444";
+	case DRM_DVBRIDGE_LINK_YCBCR422:
+		return "ycbcr422";
+	case DRM_DVBRIDGE_LINK_YCBCR420:
+		return "ycbcr420";
+	case DRM_DVBRIDGE_LINK_6BPC:
+		return "6bpc";
+	case DRM_DVBRIDGE_LINK_8BPC:
+		return "8bpc";
+	case DRM_DVBRIDGE_LINK_10BPC:
+		return "10bpc";
+	case DRM_DVBRIDGE_LINK_12BPC:
+		return "12bpc";
+	case DRM_DVBRIDGE_LINK_14BPC:
+		return "14bpc";
+	case DRM_DVBRIDGE_LINK_16BPC:
+		return "16bpc";
+	default:
+		return NULL;
+	}
+}
+
+/*
+ * The value of DVBRIDGE_LINK_FORMAT for a format (DRM_DVBRIDGE_LINK_RGB to _YCBCR420) and a
+ * depth of 6 to 16 bits per component (even); 0 for anything else.
+ */
+static inline u64 drm_dvbridge_link_bits(unsigned int format, unsigned int bpc)
+{
+	if (format > DRM_DVBRIDGE_LINK_YCBCR420 || bpc < 6 || bpc > 16 || bpc % 2)
+		return 0;
+	return (1ULL << format) | (1ULL << (DRM_DVBRIDGE_LINK_6BPC + (bpc - 6) / 2));
+}
+
+#ifdef __KERNEL__
+#include <linux/array_size.h>
+#include <linux/build_bug.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_mode.h>
+#include <drm/drm_property.h>
+
+static_assert(DRM_DVBRIDGE_Y420_DEEP_COLOUR == DRM_EDID_YCBCR420_DC_MASK);
+
+/* The connector state's HDR metadata has the PQ or HLG transfer function */
+static inline bool drm_dvbridge_hdr_output(const struct drm_connector_state *state)
+{
+	const struct hdr_output_metadata *hdr;
+
+	if (!state->hdr_output_metadata || state->hdr_output_metadata->length < sizeof(*hdr))
+		return false;
+	hdr = state->hdr_output_metadata->data;
+	return drm_dvbridge_hdr_eotf(hdr->metadata_type, hdr->hdmi_metadata_type1.eotf);
+}
+
+/* DVBRIDGE_HDR_YCBCR420 of a device: an enum, "deep" (0, the default) or "never" (1) */
+static inline struct drm_property *drm_dvbridge_hdr_ycbcr420_property_create(struct drm_device *dev)
+{
+	static const struct drm_prop_enum_list list[] = {
+		{ DRM_DVBRIDGE_HDR_YCBCR420_DEEP, "deep" },
+		{ DRM_DVBRIDGE_HDR_YCBCR420_NEVER, "never" },
+	};
+
+	return drm_property_create_enum(dev, DRM_MODE_PROP_ATOMIC, "DVBRIDGE_HDR_YCBCR420", list,
+					ARRAY_SIZE(list));
+}
+
+/* DVBRIDGE_LINK_FORMAT of a device: read only, one bit for each format and depth */
+static inline struct drm_property *drm_dvbridge_link_property_create(struct drm_device *dev)
+{
+	struct drm_prop_enum_list list[DRM_DVBRIDGE_LINK_COUNT];
+	unsigned int i;
+
+	for (i = 0; i < DRM_DVBRIDGE_LINK_COUNT; i++) {
+		list[i].type = i;
+		list[i].name = drm_dvbridge_link_name(i);
+	}
+	return drm_property_create_bitmask(dev, DRM_MODE_PROP_IMMUTABLE, "DVBRIDGE_LINK_FORMAT",
+					   list, DRM_DVBRIDGE_LINK_COUNT,
+					   (1ULL << DRM_DVBRIDGE_LINK_COUNT) - 1);
+}
+
+/*
+ * A request of the HDR10 depth guard was checked on this connector: bits are what the
+ * configuration checked sends (drm_dvbridge_link_bits()), 0 when there is none. Called from the
+ * atomic check of a commit that has the connector in its state: it holds the connection mutex,
+ * which the readers of the property hold too.
+ */
+static inline void drm_dvbridge_link_report(struct drm_connector *connector,
+					    struct drm_property *prop, u64 bits)
+{
+	if (prop)
+		drm_object_property_set_value(&connector->base, prop, bits);
+}
+#endif /* __KERNEL__ */
+
+#endif /* __DRM_DVBRIDGE_HDR_H__ */
