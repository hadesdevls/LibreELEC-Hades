From 5c99814e62f127d3c75b163cb11b03882ccb0cd8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:58:26 +0000
Subject: [PATCH] drm/amd/display: the tunnel refused, and why, with a color
 format that is not RGB

Linux 7.3 gives amdgpu's HDMI connectors the "color format" property, and
amdgpu_dm_create_validate_stream_for_sink() builds the stream in the
encoding it names. With the Dolby Vision tunnel requested and the property
at YCbCr 4:4:4, 4:2:2 or 4:2:0, the stream is not RGB and the scanout check
refuses it, fail closed, but under a reason that is not the one: 4:2:2 is
named as a TMDS limit and 4:2:0 as a mode the sink takes in 4:2:0 only,
as if the link could not carry the tunnel.

amdgpu_dm_dvbridge_check_connector() refuses the tunnel when the property
is neither AUTO nor RGB, before any stream is made, and the refusal names
it: FORMAT, with the encoding the property asks for. AUTO and RGB are
unchanged (the enumeration of 7.3 tries RGB first, and with RGB only RGB).
The HDR 4:2:2 and 4:2:0 rules of Hades already stay out with any value but
AUTO. i915 does not attach the property in 7.3. W=1 on amdgpu_dm: no
warning.
---
 .../amd/display/amdgpu_dm/amdgpu_dm_connector.c    |  9 +++++++++
 .../display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c | 14 ++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index cfcfaae..355bb83 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1751,6 +1751,15 @@ static int amdgpu_dm_dvbridge_check_connector(struct amdgpu_dm_connector *aconn,
 	    con_state->hdr_output_metadata ||
 	    con_state->hdmi.broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED)
 		return -EINVAL;
+	/*
+	 * Hades: the "color format" property of Linux 7.3 chooses the pixel encoding of the stream
+	 * (amdgpu_dm_create_validate_stream_for_sink()): the tunnel is RGB, with it at AUTO or RGB.
+	 * Another value would end in the scanout check, named as a link limit (4:2:2 as TMDS, 4:2:0
+	 * as a mode taken in 4:2:0 only): it is refused here, for what it is.
+	 */
+	if (con_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_AUTO &&
+	    con_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_RGB444)
+		return -EINVAL;
 	/* Underscan borders and the scaling modes change the scanout or the timing. */
 	if (dm_state->scaling != RMX_OFF ||
 	    (dm_state->underscan_enable &&
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 47d85bf..58f0bef 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -195,6 +195,20 @@ static u64 dvbridge_why_connector(const struct amdgpu_dm_connector *aconn,
 				 str_yes_no(con_state->hdmi.broadcast_rgb ==
 					    DRM_HDMI_BROADCAST_RGB_LIMITED));
 	}
+	/* Hades: the "color format" property asks for another encoding than RGB */
+	if (con_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_AUTO &&
+	    con_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_RGB444) {
+		bits |= REFUSED(FORMAT);
+		len += scnprintf(buf + len, size - len,
+				 "%sthe \"color format\" property asks for %s (the tunnel is RGB: \"AUTO\" or \"RGB\")",
+				 len ? "; " : "",
+				 con_state->color_format == DRM_CONNECTOR_COLOR_FORMAT_YCBCR444 ?
+				 "YCbCr 4:4:4" :
+				 con_state->color_format == DRM_CONNECTOR_COLOR_FORMAT_YCBCR422 ?
+				 "YCbCr 4:2:2" :
+				 con_state->color_format == DRM_CONNECTOR_COLOR_FORMAT_YCBCR420 ?
+				 "YCbCr 4:2:0" : "an encoding this driver does not name");
+	}
 	if (dm_state->scaling != RMX_OFF ||
 	    (dm_state->underscan_enable &&
 	     (dm_state->underscan_hborder || dm_state->underscan_vborder))) {
-- 
2.53.0

