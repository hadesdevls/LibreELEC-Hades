From 104e4e7f545fa428f64b19bd18e93a63fa4e9912 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:51:23 +0000
Subject: [PATCH] drm/client: the console takes the display without the Dolby
 Vision tunnel

When Kodi dies in a Dolby Vision video (a crash, kill -9), the fbdev
console takes the display back: drm_lastclose() restores it with a commit
of the in-kernel client (drm_client_modeset_commit_atomic()). That commit
starts from a duplicate of every connector state, so what user space left
on the connector stays on: DVBRIDGE_DV_STANDARD_LAB (and Low-Latency over
it), and the console goes out with the Dolby vendor InfoFrame, as a tunnel
of bytes the sink cannot read; or, where the console's mode is not one the
tunnel takes, the commit is refused and the last picture stays. The HDR10
depth guard can refuse it too, and HDR10PLUS_VSIF would keep sending the
dynamic metadata of a picture that is gone. Kodi clears them when it starts
again, not before.

drm_client_modeset_restore_connectors(), called on that commit before it
is checked, drops HDR10PLUS_VSIF from the new state of every connector in
it and calls a new optional hook, &drm_connector_funcs.atomic_client_restore,
where the driver puts its own properties back to their defaults. i915 (HDMI
connectors) and amdgpu turn off the tunnel, Low-Latency and the guard there,
and say so in the kernel log once, with what was on; the change of those
properties makes the commit a full modeset, as any change of them does.
DVBRIDGE_HDR_YCBCR420 is a setting, not something on the wire, and stays.
DRM_CONNECTOR_HAS_ATOMIC_CLIENT_RESTORE lets a driver built outside the tree
(NVIDIA's nvidia-drm) use the hook. Nothing changes for a connector without
those properties, nor while user space holds the display (the client commits
only without a master).

KUnit (drm_client_modeset_test.c, UML): the hook is called once on the new
state of the commit, the state in use is not touched, the blob goes, and a
connector without the hook loses the blob and nothing else; it fails with
either half of the change taken out, and the 639 DRM KUnit tests pass. W=1
on drm_client_modeset.c, intel_atomic.c, intel_hdmi.c and their xe copies,
and amdgpu_dm_connector.c: no warning.

On hardware: in a Dolby Vision video, kill -9 the Kodi process; the TV
leaves Dolby Vision for the console, the kernel log has the line of the
hook, and modetest -c shows DVBRIDGE_DV_STANDARD_LAB 0 on the connector.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   |  26 +++++
 drivers/gpu/drm/drm_client_modeset.c          |  30 +++++
 drivers/gpu/drm/i915/display/intel_atomic.c   |  24 ++++
 drivers/gpu/drm/i915/display/intel_atomic.h   |   2 +
 drivers/gpu/drm/i915/display/intel_hdmi.c     |   2 +
 .../gpu/drm/tests/drm_client_modeset_test.c   | 105 ++++++++++++++++++
 include/drm/drm_client.h                      |   2 +
 include/drm/drm_connector.h                   |  16 +++
 8 files changed, 207 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index cd0c67c..82e6d95 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -2820,7 +2820,33 @@ STATIC_IFN_KUNIT void amdgpu_dm_connector_funcs_force(struct drm_connector *conn
 }
 EXPORT_IF_KUNIT(amdgpu_dm_connector_funcs_force);
 
+/*
+ * Hades: the in-kernel client (the fbdev console) takes the display back
+ * (&drm_connector_funcs.atomic_client_restore): the Dolby Vision tunnel, Low-Latency over it and
+ * the HDR10 depth guard that user space left on (Kodi killed in a video) are turned off in the
+ * state of its commit, as i915 does. With the tunnel on, the console would go out with the
+ * Dolby VSIF (or the commit be refused and the last picture stay). Their change makes the
+ * commit a modeset (amdgpu_dm_connector_atomic_check()). DVBRIDGE_HDR_YCBCR420 is a setting:
+ * it stays.
+ */
+static void amdgpu_dm_connector_client_restore(struct drm_connector *connector,
+					       struct drm_connector_state *state)
+{
+	struct dm_connector_state *s = to_dm_connector_state(state);
+
+	if (s->dvbridge_dv_standard || s->dvbridge_dv_low_latency || s->dvbridge_hdr10_deep_color)
+		drm_info(connector->dev,
+			 "[CONNECTOR:%d:%s] DVBRIDGE: the console takes the display: tunnel %d, Low-Latency %d, HDR10 depth guard %d turned off\n",
+			 connector->base.id, connector->name, s->dvbridge_dv_standard,
+			 s->dvbridge_dv_low_latency, s->dvbridge_hdr10_deep_color);
+	s->dvbridge_dv_standard = false;
+	s->dvbridge_dv_low_latency = false;
+	s->dvbridge_hdr10_deep_color = false;
+}
+
 static const struct drm_connector_funcs amdgpu_dm_connector_funcs = {
+	/* Hades: no Dolby Vision tunnel left on for the console */
+	.atomic_client_restore = amdgpu_dm_connector_client_restore,
 	.reset = amdgpu_dm_connector_funcs_reset,
 	.detect = amdgpu_dm_connector_detect,
 	.fill_modes = drm_helper_probe_single_connector_modes,
diff --git a/drivers/gpu/drm/drm_client_modeset.c b/drivers/gpu/drm/drm_client_modeset.c
index 0080a8e..034a6e1 100644
--- a/drivers/gpu/drm/drm_client_modeset.c
+++ b/drivers/gpu/drm/drm_client_modeset.c
@@ -1031,6 +1031,33 @@ bool drm_client_rotation(struct drm_mode_set *modeset, unsigned int *rotation)
 }
 EXPORT_SYMBOL(drm_client_rotation);
 
+/**
+ * drm_client_modeset_restore_connectors - what a client does not draw for is not left on
+ * @state: a commit of the in-kernel client
+ *
+ * Hades: on the new state of every connector of @state, drops the HDR10+ vendor InfoFrame of a
+ * video (HDR10PLUS_VSIF) and calls &drm_connector_funcs.atomic_client_restore, so that the
+ * console does not go out with what user space left on the connector for its own pictures (a
+ * Dolby Vision tunnel above all, when Kodi dies in a video).
+ */
+void drm_client_modeset_restore_connectors(struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *conn_state;
+	struct drm_connector *connector;
+	int i;
+
+	for_each_new_connector_in_state(state, connector, conn_state, i) {
+		if (conn_state->hdr10plus_vsif)
+			drm_dbg_kms(connector->dev,
+				    "[CONNECTOR:%d:%s] the console takes the display: HDR10PLUS_VSIF dropped\n",
+				    connector->base.id, connector->name);
+		drm_property_replace_blob(&conn_state->hdr10plus_vsif, NULL);
+		if (connector->funcs->atomic_client_restore)
+			connector->funcs->atomic_client_restore(connector, conn_state);
+	}
+}
+EXPORT_SYMBOL(drm_client_modeset_restore_connectors);
+
 static int drm_client_modeset_commit_atomic(struct drm_client_dev *client, bool active, bool check)
 {
 	struct drm_device *dev = client->dev;
@@ -1098,6 +1125,9 @@ static int drm_client_modeset_commit_atomic(struct drm_client_dev *client, bool
 		}
 	}
 
+	/* Hades: ... without what user space left on its connectors (Dolby Vision) */
+	drm_client_modeset_restore_connectors(state);
+
 	if (check)
 		ret = drm_atomic_check_only(state);
 	else
diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index 47b2ec5..eed53b7 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -165,6 +165,30 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 	return -EINVAL;
 }
 
+/*
+ * Hades: the in-kernel client (the fbdev console) takes the display back
+ * (&drm_connector_funcs.atomic_client_restore): the Dolby Vision tunnel, Low-Latency over it and
+ * the HDR10 depth guard that user space left on (Kodi killed in a video) are turned off in the
+ * state of its commit. With the tunnel on, the console would go out with the Dolby VSIF (or the
+ * commit be refused and the last picture stay); the guard could refuse it. Their change makes
+ * the commit a full modeset (intel_digital_connector_atomic_check()). DVBRIDGE_HDR_YCBCR420 is
+ * a setting, not something on the wire: it stays.
+ */
+void intel_digital_connector_client_restore(struct drm_connector *connector,
+					    struct drm_connector_state *state)
+{
+	struct intel_digital_connector_state *s = to_intel_digital_connector_state(state);
+
+	if (s->dv_lab_standard || s->dv_lab_low_latency || s->dv_hdr10_deep_color)
+		drm_info(connector->dev,
+			 "[CONNECTOR:%d:%s] DVBRIDGE: the console takes the display: tunnel %d, Low-Latency %d, HDR10 depth guard %d turned off\n",
+			 connector->base.id, connector->name, s->dv_lab_standard,
+			 s->dv_lab_low_latency, s->dv_hdr10_deep_color);
+	s->dv_lab_standard = false;
+	s->dv_lab_low_latency = false;
+	s->dv_hdr10_deep_color = false;
+}
+
 int intel_digital_connector_atomic_check(struct drm_connector *conn,
 					 struct drm_atomic_commit *state)
 {
diff --git a/drivers/gpu/drm/i915/display/intel_atomic.h b/drivers/gpu/drm/i915/display/intel_atomic.h
index 4dc5205..27a1dd0 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.h
+++ b/drivers/gpu/drm/i915/display/intel_atomic.h
@@ -24,6 +24,8 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 						const struct drm_connector_state *state,
 						struct drm_property *property,
 						u64 *val);
+void intel_digital_connector_client_restore(struct drm_connector *connector,
+					    struct drm_connector_state *state);
 int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 						struct drm_connector_state *state,
 						struct drm_property *property,
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 4f63be0..29fc777 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -3275,6 +3275,8 @@ static const struct drm_connector_funcs intel_hdmi_connector_funcs = {
 	.destroy = intel_connector_destroy,
 	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
 	.atomic_duplicate_state = intel_digital_connector_duplicate_state,
+	/* Hades: no Dolby Vision tunnel left on for the console */
+	.atomic_client_restore = intel_digital_connector_client_restore,
 };
 
 static int intel_hdmi_connector_atomic_check(struct drm_connector *_connector,
diff --git a/drivers/gpu/drm/tests/drm_client_modeset_test.c b/drivers/gpu/drm/tests/drm_client_modeset_test.c
index ec58fe0..c23a3b0 100644
--- a/drivers/gpu/drm/tests/drm_client_modeset_test.c
+++ b/drivers/gpu/drm/tests/drm_client_modeset_test.c
@@ -197,6 +197,111 @@ static struct kunit_suite drm_test_pick_cmdline_test_suite = {
 
 kunit_test_suite(drm_test_pick_cmdline_test_suite);
 
+/*
+ * Hades: drm_client_modeset_restore_connectors(), what a commit of the in-kernel client does to
+ * the new state of every connector in it: the HDR10+ vendor InfoFrame of a video goes, and the
+ * driver's &drm_connector_funcs.atomic_client_restore is called on that state, once.
+ */
+static unsigned int drm_test_restore_calls;
+static struct drm_connector_state *drm_test_restore_state;
+
+static void drm_test_restore_hook(struct drm_connector *connector,
+				  struct drm_connector_state *state)
+{
+	drm_test_restore_calls++;
+	drm_test_restore_state = state;
+	/* (what a driver does: puts a property of user space back to its default) */
+	state->content_type = DRM_MODE_CONTENT_TYPE_NO_DATA;
+}
+
+static const struct drm_connector_funcs drm_client_restore_hook_funcs = {
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_client_restore	= drm_test_restore_hook,
+};
+
+static const struct drm_connector_funcs drm_client_restore_plain_funcs = {
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+};
+
+static void drm_test_client_restore(struct kunit *test, bool hook)
+{
+	struct drm_client_modeset_test_priv *priv;
+	static const u8 vsif[4] = {0x81, 0x01, 0x1b, 0x8b};
+	struct drm_connector_state *conn_state;
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_property_blob *blob;
+	struct drm_atomic_commit *state;
+	int ret;
+
+	priv = kunit_kzalloc(test, sizeof(*priv), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+	priv->dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv->dev);
+	priv->drm = __drm_kunit_helper_alloc_drm_device(test, priv->dev, sizeof(*priv->drm), 0,
+							DRIVER_MODESET | DRIVER_ATOMIC);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv->drm);
+	ret = drmm_connector_init(priv->drm, &priv->connector,
+				  hook ? &drm_client_restore_hook_funcs :
+					 &drm_client_restore_plain_funcs,
+				  DRM_MODE_CONNECTOR_HDMIA, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	drm_mode_config_reset(priv->drm);
+	KUNIT_ASSERT_NOT_NULL(test, priv->connector.state);
+	priv->connector.state->content_type = DRM_MODE_CONTENT_TYPE_CINEMA;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	state = drm_kunit_helper_atomic_state_alloc(test, priv->drm, &ctx);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, state);
+	conn_state = drm_atomic_get_connector_state(state, &priv->connector);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, conn_state);
+	KUNIT_EXPECT_EQ(test, conn_state->content_type, DRM_MODE_CONTENT_TYPE_CINEMA);
+	blob = drm_property_create_blob(priv->drm, sizeof(vsif), vsif);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, blob);
+	conn_state->hdr10plus_vsif = blob;
+
+	drm_test_restore_calls = 0;
+	drm_test_restore_state = NULL;
+	drm_client_modeset_restore_connectors(state);
+
+	KUNIT_EXPECT_NULL(test, conn_state->hdr10plus_vsif);
+	KUNIT_EXPECT_EQ(test, drm_test_restore_calls, hook ? 1 : 0);
+	KUNIT_EXPECT_PTR_EQ(test, drm_test_restore_state, hook ? conn_state : NULL);
+	KUNIT_EXPECT_EQ(test, conn_state->content_type,
+			hook ? DRM_MODE_CONTENT_TYPE_NO_DATA : DRM_MODE_CONTENT_TYPE_CINEMA);
+	/* the state in use is not touched: only the commit's new one */
+	KUNIT_EXPECT_EQ(test, priv->connector.state->content_type, DRM_MODE_CONTENT_TYPE_CINEMA);
+
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
+static void drm_test_client_restore_hook(struct kunit *test)
+{
+	drm_test_client_restore(test, true);
+}
+
+static void drm_test_client_restore_no_hook(struct kunit *test)
+{
+	drm_test_client_restore(test, false);
+}
+
+static struct kunit_case drm_test_client_restore_tests[] = {
+	KUNIT_CASE(drm_test_client_restore_hook),
+	KUNIT_CASE(drm_test_client_restore_no_hook),
+	{}
+};
+
+static struct kunit_suite drm_test_client_restore_test_suite = {
+	.name = "drm_test_client_restore",
+	.test_cases = drm_test_client_restore_tests
+};
+
+kunit_test_suite(drm_test_client_restore_test_suite);
+
 /*
  * This file is included directly by drm_client_modeset.c so we can't
  * use any MODULE_* macro here.
diff --git a/include/drm/drm_client.h b/include/drm/drm_client.h
index 49a21f3..2567170 100644
--- a/include/drm/drm_client.h
+++ b/include/drm/drm_client.h
@@ -11,6 +11,7 @@
 #include <drm/drm_connector.h>
 #include <drm/drm_crtc.h>
 
+struct drm_atomic_commit;
 struct drm_client_dev;
 struct drm_device;
 struct drm_file;
@@ -215,6 +216,7 @@ int drm_client_modeset_probe(struct drm_client_dev *client, unsigned int width,
 bool drm_client_rotation(struct drm_mode_set *modeset, unsigned int *rotation);
 int drm_client_modeset_check(struct drm_client_dev *client);
 int drm_client_modeset_commit_locked(struct drm_client_dev *client);
+void drm_client_modeset_restore_connectors(struct drm_atomic_commit *state);
 int drm_client_modeset_commit(struct drm_client_dev *client);
 int drm_client_modeset_dpms(struct drm_client_dev *client, int mode);
 int drm_client_modeset_wait_for_vblank(struct drm_client_dev *client, unsigned int crtc_index);
diff --git a/include/drm/drm_connector.h b/include/drm/drm_connector.h
index b6c707a..c177ddf 100644
--- a/include/drm/drm_connector.h
+++ b/include/drm/drm_connector.h
@@ -1826,8 +1826,24 @@ struct drm_connector_funcs {
 	 */
 	enum drm_connector_color_format (*color_format)(
 		const struct drm_connector_state *conn_state);
+
+	/**
+	 * @atomic_client_restore:
+	 *
+	 * Hades: called by the in-kernel client (the fbdev console, drm_log) on the new state of
+	 * every connector of a commit it makes, before the commit is checked
+	 * (drm_client_modeset_restore_connectors()). The client takes the display back from user
+	 * space, which may have died with properties set that send something only user space draws
+	 * for: the Dolby Vision tunnel of DVBRIDGE_DV_STANDARD_LAB, whose vendor InfoFrame would
+	 * go out with the console. The driver puts them back to their defaults here. Optional.
+	 */
+	void (*atomic_client_restore)(struct drm_connector *connector,
+				      struct drm_connector_state *state);
 };
 
+/* Hades: drivers built outside the tree can test for the hook above */
+#define DRM_CONNECTOR_HAS_ATOMIC_CLIENT_RESTORE 1
+
 /**
  * struct drm_cmdline_mode - DRM Mode passed through the kernel command-line
  *
-- 
2.53.0

