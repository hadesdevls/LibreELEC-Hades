From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:25:23 +0000
Subject: [PATCH 3/5] drm/amd/display: the HDR InfoFrame laid out for the link
 that carries it

amdgpu_dm_fill_hdr_info_packet() lays out the HDR static metadata packet
by the type of the connector: HDMI InfoFrame on an HDMI connector,
DisplayPort SDP on a DisplayPort one. DC sends the packet of a stream by
the stream's signal (resource_build_info_frame()). A DisplayPort
connector whose display is behind a passive dual-mode adaptor (DP++)
carries HDMI: its stream is an HDMI one, and the SDP layout goes out as
an HDMI InfoFrame whose first byte, 0x00 (the SDP id), is the type of a
null packet. The display gets no HDR InfoFrame: HDR10 and HLG through
such an adaptor stay SDR on the display. Linux has it so up to 7.4-rc2.

The two places that build the packet for a stream now lay it out for
the stream's signal (amdgpu_dm_fill_hdr_info_packet_link()): HDMI on a
DisplayPort connector that carries HDMI, the layouts of before
everywhere else. The connector check, which builds it only to see that
it can, keeps amdgpu_dm_fill_hdr_info_packet() as it is.

Checked: KUnit of amdgpu_dm (x86_64 in QEMU), with the test patch of
this series: the HDMI layout with a valid checksum, byte for byte the
packet of an HDMI connector, for a DisplayPort connector that carries
HDMI; the SDP for one that carries DisplayPort; W=1 of the two objects
without warnings.

Not tried with an adaptor on hardware.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 10 ++++--
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 36 ++++++++++++++++---
 .../display/amdgpu_dm/amdgpu_dm_connector.h   |  6 ++++
 3 files changed, 45 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 3d00b53e77cc..dfd85f5b061b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5190,7 +5190,10 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 		}
 
 		if (hdr_changed) {
-			amdgpu_dm_fill_hdr_info_packet(new_con_state, &hdr_packet);
+			/* Hades: laid out for the link of the stream (a passive dual-mode adaptor) */
+			amdgpu_dm_fill_hdr_info_packet_link(new_con_state,
+							    dm_new_crtc_state->stream->signal,
+							    &hdr_packet);
 			stream_update.hdr_static_metadata = &hdr_packet;
 		}
 
@@ -5560,8 +5563,9 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 			amdgpu_dm_fill_hdr10plus(drm_new_conn_state, new_stream->signal,
 						 &new_stream->hdr10plus_infopacket);
 
-		ret = amdgpu_dm_fill_hdr_info_packet(drm_new_conn_state,
-					   &new_stream->hdr_static_metadata);
+		/* Hades: laid out for the link of the stream (a passive dual-mode adaptor) */
+		ret = amdgpu_dm_fill_hdr_info_packet_link(drm_new_conn_state, new_stream->signal,
+							  &new_stream->hdr_static_metadata);
 		if (ret)
 			goto fail;
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 31fe9357209b..a3a540b5fedc 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -4048,11 +4048,22 @@ void amdgpu_dm_fill_hdr10plus(const struct drm_connector_state *state,
 	amdgpu_dm_hdr10plus_packet(blob->data, blob->length, dc_is_hdmi_signal(signal), out);
 }
 
-int amdgpu_dm_fill_hdr_info_packet(const struct drm_connector_state *state,
-				   struct dc_info_packet *out)
+/*
+ * Hades: the layout of the packet is that of the link that carries it. A DisplayPort connector
+ * whose display is behind a passive dual-mode adaptor carries HDMI (the stream's signal is HDMI,
+ * amdgpu_dm_dual_mode_of()), and DC sends the packet of such a stream as an HDMI InfoFrame
+ * (resource_build_info_frame(), by the signal): in the layout of a DisplayPort SDP its first byte
+ * says a null packet, and the display takes no HDR. The layout follows the signal there; on an HDMI
+ * connector, and on a DisplayPort one that carries DisplayPort, it is what it was.
+ * amdgpu_dm_fill_hdr_info_packet() lays it out by the connector (no signal), for the connector check
+ * that only builds it to see that it can be built.
+ */
+static int amdgpu_dm_hdr_info_packet(const struct drm_connector_state *state,
+				     enum signal_type signal, struct dc_info_packet *out)
 {
 	struct hdmi_drm_infoframe frame;
 	unsigned char buf[30]; /* 26 + 4 */
+	int connector_type;
 	ssize_t len;
 	int ret, i;
 
@@ -4073,8 +4084,11 @@ int amdgpu_dm_fill_hdr_info_packet(const struct drm_connector_state *state,
 	if (len != 30)
 		return -EINVAL;
 
-	/* Prepare the infopacket for DC. */
-	switch (state->connector->connector_type) {
+	/* Prepare the infopacket for DC. (Hades: for the link that carries it) */
+	connector_type = state->connector->connector_type;
+	if (connector_type == DRM_MODE_CONNECTOR_DisplayPort && dc_is_hdmi_signal(signal))
+		connector_type = DRM_MODE_CONNECTOR_HDMIA;
+	switch (connector_type) {
 	case DRM_MODE_CONNECTOR_HDMIA:
 		out->hb0 = 0x87; /* type */
 		out->hb1 = 0x01; /* version */
@@ -4106,8 +4120,22 @@ int amdgpu_dm_fill_hdr_info_packet(const struct drm_connector_state *state,
 
 	return 0;
 }
+
+int amdgpu_dm_fill_hdr_info_packet(const struct drm_connector_state *state,
+				   struct dc_info_packet *out)
+{
+	return amdgpu_dm_hdr_info_packet(state, SIGNAL_TYPE_NONE, out);
+}
 EXPORT_IF_KUNIT(amdgpu_dm_fill_hdr_info_packet);
 
+/* Hades: the packet for the link of a stream (amdgpu_dm_hdr_info_packet()) */
+int amdgpu_dm_fill_hdr_info_packet_link(const struct drm_connector_state *state,
+					enum signal_type signal, struct dc_info_packet *out)
+{
+	return amdgpu_dm_hdr_info_packet(state, signal, out);
+}
+EXPORT_IF_KUNIT(amdgpu_dm_fill_hdr_info_packet_link);
+
 static int
 amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 				 struct drm_atomic_commit *state)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
index 8f1bdeca0e6e..a6ae5a2384ec 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
@@ -124,6 +124,12 @@ bool amdgpu_dm_is_freesync_video_mode(const struct drm_display_mode *mode,
 
 int amdgpu_dm_fill_hdr_info_packet(const struct drm_connector_state *state,
 			 struct dc_info_packet *out);
+/*
+ * Hades: the same packet laid out for the link of a stream: an HDMI one on a DisplayPort connector
+ * whose display is behind a passive dual-mode adaptor (stream signal HDMI)
+ */
+int amdgpu_dm_fill_hdr_info_packet_link(const struct drm_connector_state *state,
+					enum signal_type signal, struct dc_info_packet *out);
 
 /*
  * Hades: what is behind a DisplayPort connector (SST) for the HDMI that this driver sends through
