From 4e5de50358fa876924ccb3e128847bb6479bbe37 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:43:15 +0000
Subject: [PATCH] drm: DVBRIDGE_REFUSED, why a Dolby Vision tunnel request was
 refused

When i915 or amdgpu (with the Hades patches) refuse a commit that asks
for the Dolby Vision Standard tunnel (DVBRIDGE_DV_STANDARD_LAB), user
space gets -EINVAL or -EOPNOTSUPP and nothing else: the reason is only
in drm.debug output, which nobody has on. Kodi then disables native
output after two seconds of refused frames and can only say "failed",
and the kernel log of a machine whose HDMI port is behind a converter,
or whose link cannot carry the mode, says nothing about it.

This header gives the drivers one set of reasons, one bit each:
disabled, edid, edid-2160p30, converter, sink, tmds, ycbcr420, frl,
format, mode, clone, scanout, hdr10-depth (for the HDR10 depth guard
that follows in this series) and other. They go to user space through a
read-only bitmask connector property, DVBRIDGE_REFUSED, whose enum names
are those words: user space matches the names, not the bit numbers.

The driver writes it from its atomic check, also for a TEST_ONLY
request: the reasons the last checked request of the tunnel or of the
guard on that connector was refused, 0 when it passed. The check holds
the connection mutex of a connector in its state, which is the lock the
readers of the property (GETCONNECTOR, OBJ_GETPROPERTIES) hold. Nothing
in the kernel reads the value: it changes no decision.

The same reasons go to the kernel log at info level with what the
driver found (clocks, adaptor, formats, mode): when they differ from the
refusal before, at most 10 times in 30 s, and otherwise at most once in
30 s per connector, so that a request that user space repeats every
frame is logged once.

The name, the bit and the print functions touch no kernel object, so
that a host test can build them.
---
 include/drm/drm_dvbridge_refused.h | 208 +++++++++++++++++++++++++++++
 1 file changed, 208 insertions(+)
 create mode 100644 include/drm/drm_dvbridge_refused.h

diff --git a/include/drm/drm_dvbridge_refused.h b/include/drm/drm_dvbridge_refused.h
new file mode 100644
index 0000000..13b3674
--- /dev/null
+++ b/include/drm/drm_dvbridge_refused.h
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * DVBRIDGE_REFUSED: why a request of the Dolby Vision Standard tunnel (connector property
+ * DVBRIDGE_DV_STANDARD_LAB) or of the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR) was refused,
+ * as a read-only bitmask property of the connector. The drivers that offer those properties
+ * write it from their atomic check, for a TEST_ONLY request as well: the reasons of the last
+ * request of this connector that was checked, 0 when it passed. Nothing in the kernel reads it:
+ * it is for user space, which can then say why (Kodi's player information), and for
+ * diagnostics (modetest lists it). User space matches the names of the bits, not their numbers.
+ * The kernel log says the same, with the figures behind it, when the reasons change and
+ * otherwise at most once in 30 s per connector.
+ *
+ * The functions above the __KERNEL__ block touch no kernel object, so that a test can build
+ * them on the host.
+ */
+#ifndef __DRM_DVBRIDGE_REFUSED_H__
+#define __DRM_DVBRIDGE_REFUSED_H__
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#endif
+
+enum drm_dvbridge_refused {
+	/* the tunnel is off (module parameter) or not offered on this display hardware */
+	DRM_DVBRIDGE_REFUSED_DISABLED,
+	/* the EDID has no Dolby Vision Standard block that this driver takes */
+	DRM_DVBRIDGE_REFUSED_EDID,
+	/* the sink takes Dolby Vision at 3840x2160 up to 30 Hz only */
+	DRM_DVBRIDGE_REFUSED_EDID_2160P30,
+	/*
+	 * the link is not native HDMI: an LSPCON, a DisplayPort dual-mode adaptor or a
+	 * DisplayPort-to-HDMI converter is in the path
+	 */
+	DRM_DVBRIDGE_REFUSED_CONVERTER,
+	/* the sink is driven as DVI, or takes no HDMI InfoFrames */
+	DRM_DVBRIDGE_REFUSED_SINK,
+	/*
+	 * RGB at 8 bits per component in this mode needs a higher TMDS clock than the source,
+	 * the sink or an adaptor in the path takes
+	 */
+	DRM_DVBRIDGE_REFUSED_TMDS,
+	/* the link carries this mode in YCbCr 4:2:0 only */
+	DRM_DVBRIDGE_REFUSED_YCBCR420,
+	/* the link runs HDMI FRL; the tunnel is TMDS only */
+	DRM_DVBRIDGE_REFUSED_FRL,
+	/*
+	 * the output is not RGB at 8 bits per component in full range, with the default
+	 * colorimetry and without HDR metadata
+	 */
+	DRM_DVBRIDGE_REFUSED_FORMAT,
+	/*
+	 * the mode is not a CTA 1920x1080 or 3840x2160 progressive 2D mode at 24 to 60 Hz,
+	 * or it is scaled or bordered
+	 */
+	DRM_DVBRIDGE_REFUSED_MODE,
+	/* another connector is on the CRTC */
+	DRM_DVBRIDGE_REFUSED_CLONE,
+	/*
+	 * the scanout is not byte exact: colour processing, another plane, scaling, rotation,
+	 * VRR, DSC or dither
+	 */
+	DRM_DVBRIDGE_REFUSED_SCANOUT,
+	/* HDR10 would go out with fewer than 10 bits per component (DVBRIDGE_HDR10_DEEP_COLOR) */
+	DRM_DVBRIDGE_REFUSED_HDR10_DEPTH,
+	/* refused for what none of the bits above names (the kernel log says what was found) */
+	DRM_DVBRIDGE_REFUSED_OTHER,
+	DRM_DVBRIDGE_REFUSED_COUNT
+};
+
+/* The name of a bit, as the property and the kernel log give it; NULL for an unknown bit. */
+static inline const char *drm_dvbridge_refused_name(unsigned int bit)
+{
+	switch (bit) {
+	case DRM_DVBRIDGE_REFUSED_DISABLED:
+		return "disabled";
+	case DRM_DVBRIDGE_REFUSED_EDID:
+		return "edid";
+	case DRM_DVBRIDGE_REFUSED_EDID_2160P30:
+		return "edid-2160p30";
+	case DRM_DVBRIDGE_REFUSED_CONVERTER:
+		return "converter";
+	case DRM_DVBRIDGE_REFUSED_SINK:
+		return "sink";
+	case DRM_DVBRIDGE_REFUSED_TMDS:
+		return "tmds";
+	case DRM_DVBRIDGE_REFUSED_YCBCR420:
+		return "ycbcr420";
+	case DRM_DVBRIDGE_REFUSED_FRL:
+		return "frl";
+	case DRM_DVBRIDGE_REFUSED_FORMAT:
+		return "format";
+	case DRM_DVBRIDGE_REFUSED_MODE:
+		return "mode";
+	case DRM_DVBRIDGE_REFUSED_CLONE:
+		return "clone";
+	case DRM_DVBRIDGE_REFUSED_SCANOUT:
+		return "scanout";
+	case DRM_DVBRIDGE_REFUSED_HDR10_DEPTH:
+		return "hdr10-depth";
+	case DRM_DVBRIDGE_REFUSED_OTHER:
+		return "other";
+	default:
+		return NULL;
+	}
+}
+
+/*
+ * The names of the bits that are set, separated by spaces, in buf (always terminated when size
+ * is not 0; cut where it does not fit). Bits without a name are left out.
+ * Returns the length of what was written.
+ */
+static inline size_t drm_dvbridge_refused_print(u64 bits, char *buf, size_t size)
+{
+	size_t len = 0;
+	unsigned int bit;
+
+	if (!size)
+		return 0;
+	for (bit = 0; bit < DRM_DVBRIDGE_REFUSED_COUNT; bit++) {
+		const char *name = drm_dvbridge_refused_name(bit);
+
+		if (!(bits & (1ULL << bit)) || !name)
+			continue;
+		if (len && len + 1 < size)
+			buf[len++] = ' ';
+		while (*name && len + 1 < size)
+			buf[len++] = *name++;
+	}
+	buf[len] = '\0';
+	return len;
+}
+
+#ifdef __KERNEL__
+#include <linux/jiffies.h>
+#include <linux/ratelimit.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mode.h>
+#include <drm/drm_print.h>
+#include <drm/drm_property.h>
+
+/*
+ * What the kernel log has said of a connector (see drm_dvbridge_refused_report()): the reasons of
+ * the last refusal, and the two limits.
+ */
+struct drm_dvbridge_refused_log {
+	struct ratelimit_state change;
+	struct ratelimit_state repeat;
+	u64 last;
+};
+
+static inline void drm_dvbridge_refused_log_init(struct drm_dvbridge_refused_log *log)
+{
+	ratelimit_state_init(&log->change, 30 * HZ, 10);
+	ratelimit_state_init(&log->repeat, 30 * HZ, 1);
+	/* no "callbacks suppressed" lines in between */
+	ratelimit_set_flags(&log->change, RATELIMIT_MSG_ON_RELEASE);
+	ratelimit_set_flags(&log->repeat, RATELIMIT_MSG_ON_RELEASE);
+	log->last = 0;
+}
+
+/* The DVBRIDGE_REFUSED property of a device: read only, one bit for each reason. */
+static inline struct drm_property *drm_dvbridge_refused_property_create(struct drm_device *dev)
+{
+	struct drm_prop_enum_list list[DRM_DVBRIDGE_REFUSED_COUNT];
+	unsigned int i;
+
+	for (i = 0; i < DRM_DVBRIDGE_REFUSED_COUNT; i++) {
+		list[i].type = i;
+		list[i].name = drm_dvbridge_refused_name(i);
+	}
+	return drm_property_create_bitmask(dev, DRM_MODE_PROP_IMMUTABLE, "DVBRIDGE_REFUSED", list,
+					   DRM_DVBRIDGE_REFUSED_COUNT,
+					   (1ULL << DRM_DVBRIDGE_REFUSED_COUNT) - 1);
+}
+
+/*
+ * A request of the tunnel or of the HDR10 depth guard was checked on this connector: bits are
+ * the reasons it was refused, 0 when it passed (or before its checks run). Written to the
+ * DVBRIDGE_REFUSED property (prop, when the connector has it), and, for a refusal, to the kernel
+ * log with detail (what the driver found, or NULL): when the reasons differ from those of the
+ * refusal before (at most 10 times in 30 s), and otherwise at most once in 30 s. Called from the
+ * atomic check of a commit that has the connector in its state: it holds the connection mutex,
+ * which the readers of the property hold too.
+ */
+static inline void drm_dvbridge_refused_report(struct drm_connector *connector,
+					       struct drm_property *prop,
+					       struct drm_dvbridge_refused_log *log,
+					       u64 bits, const char *detail)
+{
+	char names[128];
+	bool changed;
+
+	if (prop)
+		drm_object_property_set_value(&connector->base, prop, bits);
+	if (!bits)
+		return;
+	changed = bits != log->last;
+	log->last = bits;
+	if (!(changed ? __ratelimit(&log->change) : __ratelimit(&log->repeat)))
+		return;
+	drm_dvbridge_refused_print(bits, names, sizeof(names));
+	drm_info(connector->dev, "[CONNECTOR:%d:%s] DVBRIDGE refused: %s%s%s\n",
+		 connector->base.id, connector->name, names,
+		 detail && *detail ? "; " : "", detail ? detail : "");
+}
+#endif /* __KERNEL__ */
+
+#endif /* __DRM_DVBRIDGE_REFUSED_H__ */
