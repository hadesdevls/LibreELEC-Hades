From 5a82d54579d95291e98fdfc6b54f32d6ca192a7b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:56:37 +0000
Subject: [PATCH] drm/amd/display, drm/i915: take the version 1 Dolby block of
 every display management

The Dolby Vision Standard tunnel took a 12-byte version 1 Dolby VSVDB
with the low-latency field 1 only with display management 4 or later,
because user space sent content mapping v4.0 metadata and nothing said
whether an older display reads it. User space (Kodi, dvbridge) now sends
a display of display management 2 or 3 the content mapping v2.9 part of
the metadata, the part such a display reads, and takes these blocks; the
kernel rule follows, so that Kodi, amdgpu and i915 take the same
displays.

What the tunnel sends them does not change: with the low-latency field 1
the block asks for the Dolby vendor InfoFrame, the one this tunnel sends
(Amlogic, CoreELEC linux-amlogic hdmi_tx_main.c, hdmitx_set_vsif_pkt():
"ver1_12 with low_latency = 1 and ver2 use Dolby VSIF"). In a public
collection of 584 EDIDs with a Dolby block (the linuxhw/EDID dataset),
119 have such a block of display management 2 or 3: LG TVs of 2017 and
2018, TCL, Toshiba, Vestel, Vizio, Hisense, Roku, AV receivers.

What stays out: version 0, the 15-byte version 1 form and the field 0,
which ask for the HDMI 1.4b vendor InfoFrame. The reason texts of
amdgpu_dm_dvbridge_refused.c and intel_dv_lab_edid_why() say so, without
display management.
---
 .../amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h  | 12 ++++++------
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c      |  2 +-
 .../gpu/drm/i915/display/intel_dv_lab_policy.h  | 17 ++++++++---------
 3 files changed, 15 insertions(+), 16 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index da3ff6e..76cd8a1 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -20,10 +20,11 @@ bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream);
 /*
  * An EDID with exactly one Dolby VSVDB that advertises Standard (TV-led) DV with the Dolby VSIF:
  * version 2 with interface 2 or 3, or version 1 in its 12-byte form with the low-latency field 1
- * (Standard and low latency) and display management 4 or later, the version of the metadata user
- * space sends. The field 0, the 15-byte version 1 form and version 0 mean the HDMI 1.4b vendor
- * InfoFrame, which this tunnel does not send. *p60: the sink takes it at 2160p50 and 2160p60,
- * always with version 2. Kodi reads the EDID with the same rule.
+ * (Standard and low latency), of any display management version (user space sends a display of 2
+ * or 3 the content mapping v2.9 part of the metadata, the part it reads). The field 0, the 15-byte
+ * version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which this tunnel does not
+ * send. *p60: the sink takes it at 2160p50 and 2160p60, always with version 2. Kodi reads the
+ * EDID with the same rule.
  */
 static inline bool amdgpu_dm_dvbridge_edid_standard(const u8 *edid, size_t size, bool *p60)
 {
@@ -72,8 +73,7 @@ static inline bool amdgpu_dm_dvbridge_edid_standard(const u8 *edid, size_t size,
 					*p60 = true;
 					break;
 				case 1:
-					standard = len == 11 && (data[7] & 3) == 1 &&
-						   ((data[4] >> 2) & 7) >= 2;
+					standard = len == 11 && (data[7] & 3) == 1;
 					*p60 = data[4] & 2;
 					break;
 				default:
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index c57077f..355b40c 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -264,7 +264,7 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 						      stream->sink->dc_edid.length, &p60))) {
 		bits |= REFUSED(EDID);
 		len += scnprintf(detail + len, sizeof(detail) - len,
-				 "%sthe EDID has no Dolby Vision block that this driver takes (version 2 with the Standard interface, or the 12-byte version 1 block with low latency and display management 4 or later)",
+				 "%sthe EDID has no Dolby Vision block that this driver takes (version 2 with the Standard interface, or the 12-byte version 1 block with low latency)",
 				 len ? "; " : "");
 	} else if (!p60 && (vic == 96 || vic == 97)) {
 		bits |= REFUSED(EDID_2160P30);
diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index 021d535..a840be4 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -15,10 +15,11 @@
  * Hades: an EDID with exactly one Dolby VSVDB that advertises Standard (TV-led) Dolby Vision with
  * the Dolby vendor InfoFrame, by the rule of amdgpu (amdgpu_dm_dvbridge_edid_standard()) and of
  * Kodi (CDisplayInfo), so that the three take the same displays: version 2 with interface 2 or 3,
- * or version 1 in its 12-byte form with the low-latency field 1 (Standard and low latency) and
- * display management 4 or later, the version of the metadata user space sends. The field 0, the
- * 15-byte version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which this tunnel does
- * not send. An HDMI Forum EEODB may make the EDID longer than its base block's extension count.
+ * or version 1 in its 12-byte form with the low-latency field 1 (Standard and low latency), of any
+ * display management version (user space sends a display of 2 or 3 the content mapping v2.9 part
+ * of the metadata, the part it reads). The field 0, the 15-byte version 1 form and version 0 mean
+ * the HDMI 1.4b vendor InfoFrame, which this tunnel does not send. An HDMI Forum EEODB may make
+ * the EDID longer than its base block's extension count.
  * *p60: the sink takes it at 2160p50 and 2160p60, always with version 2.
  */
 static inline bool intel_dv_lab_edid(const u8 *edid, size_t size, bool *p60)
@@ -67,8 +68,7 @@ static inline bool intel_dv_lab_edid(const u8 *edid, size_t size, bool *p60)
 					*p60 = true;
 					break;
 				case 1:
-					standard = len == 11 && (data[7] & 3) == 1 &&
-						   ((data[4] >> 2) & 7) >= 2;
+					standard = len == 11 && (data[7] & 3) == 1;
 					*p60 = data[4] & 2;
 					break;
 				default:
@@ -132,8 +132,7 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
 					standard = (data[6] & 3) >= 2;
 					break;
 				case 1:
-					standard = len == 11 && (data[7] & 3) == 1 &&
-						   ((data[4] >> 2) & 7) >= 2;
+					standard = len == 11 && (data[7] & 3) == 1;
 					break;
 				case 0:
 					return "the Dolby Vision block is version 0, for the HDMI 1.4b vendor InfoFrame, which this driver does not send";
@@ -149,7 +148,7 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
 	if (!standard)
 		return version == 2 ?
 		       "the Dolby Vision block has no Standard interface (Low-Latency only)" :
-		       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1 and display management 4 or later (it asks for the HDMI 1.4b vendor InfoFrame, or older metadata)";
+		       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1 (it asks for the HDMI 1.4b vendor InfoFrame, which this driver does not send)";
 	return NULL;
 }
 
