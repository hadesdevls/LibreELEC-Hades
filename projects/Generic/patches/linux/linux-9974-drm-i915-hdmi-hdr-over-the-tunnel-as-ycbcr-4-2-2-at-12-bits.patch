From fb6d8e3dfe4647d068da2d6bfe5130e4fc9344c5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:40:53 +0000
Subject: [PATCH 2/3] drm/i915/hdmi: HDR over the tunnel as YCbCr 4:2:2 at 12
 bits (DVBRIDGE_HDR10_TUNNEL_LAB)

With DVBRIDGE_DV_STANDARD_LAB and the new DVBRIDGE_HDR10_TUNNEL_LAB set
(display version 10 and later, where HDR metadata can be sent), the tunnel
carries HDR instead of Dolby Vision (drm_dvbridge_hdr10t.h, linux-9932):
- the sink's rule is not its Dolby block but YCbCr 4:2:2 in its EDID
  (display_info.color_formats), and the 2160p60 bit of the Dolby block does
  not come in;
- HDR_OUTPUT_METADATA, which the tunnel refuses otherwise, is required, and
  its HDR static metadata InfoFrame goes out as for any HDR commit;
- the AVI InfoFrame says YCbCr 4:2:2, BT.2020, limited range (the CTA VIC and
  the content type as for the tunnel);
- no Dolby VSIF and no HDMI vendor InfoFrame: the slot is free. HDR10+ goes in
  it where the mode has no HDMI VIC (the generic path refuses one that has);
- the scanout checks of the tunnel (no colour processing, dither, scaling,
  other planes, VRR, DSC) apply, as the state says the tunnel is on
  (crtc_state->dv_lab_hdr10t: no infoframe says it, so it is not read out and
  not compared), and a change of the property is a full modeset, as one of
  Low-Latency is.
The reasons of a refusal go to DVBRIDGE_REFUSED and the kernel log.

A host test (intel_dv_lab_policy.h against the header of the base, over every
combination of the inputs of the tunnel's rule) shows that nothing changes with
the property off, and that with it on the HDR metadata test is the only one
that differs. W=1 on i915 and its xe copies: no warning. Not run on hardware.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 22 +++++++
 drivers/gpu/drm/i915/display/intel_display.c  | 14 ++++-
 .../drm/i915/display/intel_display_types.h    | 13 ++++
 .../drm/i915/display/intel_dv_lab_policy.h    | 11 +++-
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 59 +++++++++++++++++--
 5 files changed, 110 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index b3386c200..53dece41d 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -79,6 +79,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_hdmi14b;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_lab_hdr10t_property &&
+	    property == to_intel_connector(connector)->dv_lab_hdr10t_property) {
+		*val = intel_conn_state->dv_lab_hdr10t;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		*val = intel_conn_state->dv_hdr10_deep_color;
@@ -151,6 +156,16 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_hdmi14b = val;
 		return 0;
 	}
+	/* Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) */
+	if (to_intel_connector(connector)->dv_lab_hdr10t_property &&
+	    property == to_intel_connector(connector)->dv_lab_hdr10t_property) {
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !display->params.enable_dv_lab)
+			return -EOPNOTSUPP;
+		intel_conn_state->dv_lab_hdr10t = val;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		if (val > 1)
@@ -203,6 +218,8 @@ void intel_digital_connector_client_restore(struct drm_connector *connector,
 	s->dv_lab_low_latency = false;
 	/* (Hades: the HDMI 1.4b signal goes with the tunnel, which the line above names) */
 	s->dv_lab_hdmi14b = false;
+	/* (Hades: ... and HDR over it) */
+	s->dv_lab_hdr10t = false;
 	s->dv_hdr10_deep_color = false;
 }
 
@@ -227,6 +244,8 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 		new_conn_state->dv_lab_low_latency = false;
 		/* Hades: ... and its HDMI 1.4b signal */
 		new_conn_state->dv_lab_hdmi14b = false;
+		/* Hades: ... and HDR over it */
+		new_conn_state->dv_lab_hdr10t = false;
 		/* Hades: a disabled connector drops the HDR10 depth guard as well */
 		new_conn_state->dv_hdr10_deep_color = false;
 		return 0;
@@ -248,6 +267,9 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	     new_conn_state->dv_lab_low_latency != old_conn_state->dv_lab_low_latency) ||
 	    (new_conn_state->dv_lab_standard &&
 	     new_conn_state->dv_lab_hdmi14b != old_conn_state->dv_lab_hdmi14b) ||
+	    /* Hades: ... and to HDR over the tunnel or back: other InfoFrames and another format */
+	    (new_conn_state->dv_lab_standard &&
+	     new_conn_state->dv_lab_hdr10t != old_conn_state->dv_lab_hdr10t) ||
 	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
 	    new_conn_state->dv_hdr_ycbcr420 != old_conn_state->dv_hdr_ycbcr420 ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index 196df0e76..55038eb97 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -4333,17 +4333,24 @@ static bool intel_dv_lab_hdmi14b(const struct intel_crtc_state *state)
 		state->infoframes.hdmi.vendor.any.length == HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE;
 }
 
+/* Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h): no Dolby VSIF says it, the state does */
+static bool intel_dv_lab_hdr10t(const struct intel_crtc_state *state)
+{
+	return state->dv_lab_hdr10t;
+}
+
 static bool intel_dv_lab_active(const struct intel_crtc_state *state)
 {
 	return (state->infoframes.hdmi.vendor.any.oui == HDMI_DOLBY_IEEE_OUI &&
 		state->infoframes.hdmi.vendor.dolby.signal) ||
-	       intel_dv_lab_hdmi14b(state);
+	       intel_dv_lab_hdmi14b(state) || intel_dv_lab_hdr10t(state);
 }
 
 /* Hades: the tunnel carries Dolby Vision Low-Latency (drm_dvbridge_ll.h) */
 static bool intel_dv_lab_low_latency(const struct intel_crtc_state *state)
 {
-	return intel_dv_lab_active(state) && state->infoframes.hdmi.vendor.dolby.low_latency;
+	return intel_dv_lab_active(state) && !intel_dv_lab_hdr10t(state) &&
+	       state->infoframes.hdmi.vendor.dolby.low_latency;
 }
 
 /*
@@ -6020,7 +6027,8 @@ static void intel_crtc_check_fastset(const struct intel_crtc_state *old_crtc_sta
 	/* Never transition the private vendor mode through the HDR-only fastset. */
 	if (intel_dv_lab_active(old_crtc_state) != intel_dv_lab_active(new_crtc_state) ||
 	    intel_dv_lab_low_latency(old_crtc_state) != intel_dv_lab_low_latency(new_crtc_state) ||
-	    intel_dv_lab_hdmi14b(old_crtc_state) != intel_dv_lab_hdmi14b(new_crtc_state)) {
+	    intel_dv_lab_hdmi14b(old_crtc_state) != intel_dv_lab_hdmi14b(new_crtc_state) ||
+	    intel_dv_lab_hdr10t(old_crtc_state) != intel_dv_lab_hdr10t(new_crtc_state)) {
 		new_crtc_state->uapi.mode_changed = true;
 		new_crtc_state->update_lrr = false;
 		new_crtc_state->update_m_n = false;
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 3e026905c..2844c1e00 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -531,6 +531,8 @@ struct intel_connector {
 	struct drm_property *dv_lab_ll_property;
 	/* Hades: DVBRIDGE_DV_HDMI14B_LAB, that tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
 	struct drm_property *dv_lab_hdmi14b_property;
+	/* Hades: DVBRIDGE_HDR10_TUNNEL_LAB, HDR sent over that tunnel (drm_dvbridge_hdr10t.h) */
+	struct drm_property *dv_lab_hdr10t_property;
 	/*
 	 * Hades, gated by enable_dv_lab too: DVBRIDGE_HDR10_DEEP_COLOR, the guard that refuses a
 	 * commit sending HDR10 with fewer than 10 bits per component, and DVBRIDGE_REFUSED, why
@@ -677,6 +679,11 @@ struct intel_digital_connector_state {
 	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
 	 */
 	bool dv_lab_hdmi14b;
+	/*
+	 * Hades: DVBRIDGE_HDR10_TUNNEL_LAB: with the tunnel requested, it carries HDR as YCbCr 4:2:2
+	 * at 12 bits (drm_dvbridge_hdr10t.h); without it, nothing
+	 */
+	bool dv_lab_hdr10t;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR (scalar as well) */
 	bool dv_hdr10_deep_color;
 	/*
@@ -1201,6 +1208,12 @@ struct intel_crtc_state {
 	 * 18bpp.
 	 */
 	bool dither_force_disable;
+	/*
+	 * Hades: the tunnel of this state carries HDR (drm_dvbridge_hdr10t.h). It sends no Dolby VSIF,
+	 * so that nothing of the infoframes says it: computed by intel_hdmi_compute_config(), not read
+	 * out and not compared (a change of it is a change of the connector state, which is a modeset).
+	 */
+	bool dv_lab_hdr10t;
 
 	/* Controls for the clock computation, to override various stages. */
 	bool clock_set;
diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index f3202ee77..8dd3bd3dd 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -10,6 +10,7 @@
 #include <linux/types.h>
 #include <linux/errno.h>
 #include <drm/drm_dvbridge.h>
+#include <drm/drm_dvbridge_hdr10t.h>
 #include <drm/drm_dvbridge_refused.h>
 
 /*
@@ -52,6 +53,11 @@ static inline bool intel_dv_lab_native_hdmi(bool lspcon_active,
 struct intel_dv_lab_link {
 	bool requested, lab_enabled, sink_standard, sink_2160p60, hdmi, native_hdmi;
 	bool rgb, limited_range, hdr_blob, cloned, progressive;
+	/*
+	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h): the connector state has the HDR metadata
+	 * that the tunnel otherwise refuses, and sink_standard says that the sink takes YCbCr 4:2:2
+	 */
+	bool hdr10t;
 	unsigned int requested_bpc, pipe_bpp, colorspace;
 	unsigned int width, height, rounded_refresh;
 };
@@ -70,7 +76,7 @@ static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 		return 0;
 	if (!s->lab_enabled || !s->sink_standard || !s->native_hdmi)
 		return -EOPNOTSUPP;
-	if (!s->hdmi || !s->rgb || s->limited_range || s->hdr_blob || s->cloned ||
+	if (!s->hdmi || !s->rgb || s->limited_range || (s->hdr_blob && !s->hdr10t) || s->cloned ||
 	    !s->progressive || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
 	    s->colorspace ||
 	    (s->rounded_refresh != 24 && s->rounded_refresh != 25 &&
@@ -110,7 +116,8 @@ static inline u64 intel_dv_lab_refused(const struct intel_dv_lab_link *s, bool y
 	if (!s->rgb)
 		bits |= 1ULL << (ycbcr420 ? DRM_DVBRIDGE_REFUSED_YCBCR420 :
 				 DRM_DVBRIDGE_REFUSED_FORMAT);
-	if (s->limited_range || s->hdr_blob || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
+	if (s->limited_range || (s->hdr_blob && !s->hdr10t) || s->requested_bpc != 8 ||
+	    s->pipe_bpp != 24 ||
 	    s->colorspace)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_FORMAT;
 	if (s->cloned)
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 50cdec86b..a9bdcc1fb 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -40,6 +40,7 @@
 #include <drm/drm_crtc.h>
 #include <drm/drm_dvbridge.h>
 #include <drm/drm_dvbridge_hdr.h>
+#include <drm/drm_dvbridge_hdr10t.h>
 #include <drm/drm_dvbridge_ll.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_print.h>
@@ -893,6 +894,9 @@ intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 		/* Hades: what the sink's Low-Latency input reads the same bytes as */
 		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
 			drm_dvbridge_ll_avi(frame);
+		/* Hades: ... or HDR as the same YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+		if (crtc_state->dv_lab_hdr10t)
+			drm_dvbridge_hdr10t_avi(frame);
 		/* Hades: with the HDMI 1.4b signal, VIC 0 where its vendor InfoFrame has the HDMI VIC */
 		if (to_intel_digital_connector_state(conn_state)->dv_lab_hdmi14b)
 			drm_dvbridge_hdmi14b_avi(frame, vic);
@@ -971,7 +975,8 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 	 */
 	if (conn_state->hdr10plus_vsif &&
 	    (!crtc_state->has_infoframe || !info->has_hdmi_infoframe ||
-	     to_intel_digital_connector_state(conn_state)->dv_lab_standard))
+	     (to_intel_digital_connector_state(conn_state)->dv_lab_standard &&
+	      !crtc_state->dv_lab_hdr10t)))
 		return false;
 
 	if (!crtc_state->has_infoframe || !info->has_hdmi_infoframe)
@@ -980,7 +985,19 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 	crtc_state->infoframes.enable |=
 		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
 
-	if (to_intel_digital_connector_state(conn_state)->dv_lab_standard) {
+	/*
+	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) sends no Dolby VSIF and no HDMI VIC (the
+	 * AVI InfoFrame has the CTA VIC): the vendor slot stays free, for HDR10+ where the mode has
+	 * no HDMI VIC (the generic path below refuses one that has)
+	 */
+	if (crtc_state->dv_lab_hdr10t && !conn_state->hdr10plus_vsif) {
+		crtc_state->infoframes.enable &=
+			~intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
+		return true;
+	}
+
+	if (to_intel_digital_connector_state(conn_state)->dv_lab_standard &&
+	    !crtc_state->dv_lab_hdr10t) {
 		struct hdmi_dolby_vendor_infoframe *dv =
 			&crtc_state->infoframes.hdmi.vendor.dolby;
 
@@ -2845,6 +2862,8 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	 */
 	const bool dv_requested = to_intel_digital_connector_state(conn_state)->dv_lab_standard;
 	const bool guard_asked = to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color;
+	/* Hades: ... carrying HDR as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+	const bool hdr10t = dv_requested && to_intel_digital_connector_state(conn_state)->dv_lab_hdr10t;
 	const bool hdr10_guarded = intel_hdmi_hdr10_guarded(conn_state);
 	int requested_bpp;
 	char detail[384];
@@ -2868,6 +2887,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		return -EINVAL;
 
 	pipe_config->output_format = INTEL_OUTPUT_FORMAT_RGB;
+	pipe_config->dv_lab_hdr10t = hdr10t;
 
 	if (pipe_config->has_hdmi_sink)
 		pipe_config->has_infoframe = true;
@@ -2984,13 +3004,29 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			to_intel_digital_connector_state(conn_state)->dv_lab_low_latency;
 		/* Hades: ... or the Standard tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
 		const bool hdmi14b = to_intel_digital_connector_state(conn_state)->dv_lab_hdmi14b;
+		/*
+		 * Hades: what HDR over the tunnel asks of the request and of the sink's EDID
+		 * (drm_dvbridge_hdr10t.h)
+		 */
+		const struct drm_dvbridge_hdr10t_request hdr10t_request = {
+			.sink_ycbcr422 = connector->base.display_info.color_formats &
+					 BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422),
+			.hdr_metadata = !!conn_state->hdr_output_metadata,
+			.low_latency = low_latency,
+			.hdmi14b = hdmi14b,
+			.hdr10plus = !!conn_state->hdr10plus_vsif,
+			.vendor_slot_free = !drm_dvbridge_hdmi14b_vic(drm_match_cea_mode(adjusted_mode)),
+		};
 		struct intel_dv_lab_link link = {
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
 				intel_dv_lab_platform_supported(DISPLAY_VER(display)),
-			.sink_standard = hdmi14b ? drm_dvbridge_sink_takes_hdmi14b(sink) :
+			.sink_standard = hdr10t ? hdr10t_request.sink_ycbcr422 :
+					 hdmi14b ? drm_dvbridge_sink_takes_hdmi14b(sink) :
 					 drm_dvbridge_sink_takes(sink, low_latency),
-			.sink_2160p60 = hdmi14b ? sink->hdmi14b_p60 : sink->p60,
+			/* (Hades: HDR over the tunnel is no Dolby Vision: its block says nothing of it) */
+			.sink_2160p60 = hdr10t ? true : hdmi14b ? sink->hdmi14b_p60 : sink->p60,
+			.hdr10t = hdr10t,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
 			.native_hdmi = intel_dv_lab_native_hdmi(
@@ -3013,6 +3049,13 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		};
 
 		drm_modeset_lock_assert_held(&display->drm->mode_config.connection_mutex);
+		/* Hades: HDR over the tunnel: what it asks of the request, and the sink's 4:2:2 */
+		if (hdr10t && drm_dvbridge_hdr10t_refused(&hdr10t_request)) {
+			intel_hdmi_dvbridge_refused(connector,
+						    drm_dvbridge_hdr10t_refused(&hdr10t_request),
+						    drm_dvbridge_hdr10t_why(&hdr10t_request));
+			return -EINVAL;
+		}
 		/* Hades: no display asks for Low-Latency with the HDMI 1.4b signal */
 		if (low_latency && hdmi14b) {
 			intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT),
@@ -3502,6 +3545,14 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			if (connector->dv_lab_hdmi14b_property)
 				drm_object_attach_property(&_connector->base,
 							   connector->dv_lab_hdmi14b_property, 0);
+			/* Hades: HDR over the same tunnel, as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
+			if (DISPLAY_VER(display) >= 10) {
+				connector->dv_lab_hdr10t_property = drm_property_create_bool(display->drm,
+					DRM_MODE_PROP_ATOMIC, "DVBRIDGE_HDR10_TUNNEL_LAB");
+				if (connector->dv_lab_hdr10t_property)
+					drm_object_attach_property(&_connector->base,
+								   connector->dv_lab_hdr10t_property, 0);
+			}
 		}
 	}
 
