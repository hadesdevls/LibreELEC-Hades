From 1a387d8e9258fc85c7c2bb322d153003b0b6ee3d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:38:16 +0000
Subject: [PATCH] drm/edid: keep the blocks that an HF-EEODB counts when one is
 not valid

_drm_do_get_edid() reads the blocks that the HDMI Forum EEODB of block 1
counts past the extension count of the base block, and where any block is
not valid (an extension that is not CTA with a wrong checksum, such as a
DisplayID block, or a block of 0xff bytes where a sink has fewer blocks
than its HF-EEODB says), edid_filter_invalid_blocks() went back to the
regular extension count: every block that only the HF-EEODB counts was
taken out with the bad one, the valid ones too ("We don't want to start
modifying the HF-EEODB extension too"). A TV whose HF-EEODB counts more
blocks than it has, or with one bad block among them, lost the blocks
behind it and what they hold: its Dolby Vision data block, for one, which
Kodi and the Dolby Vision tunnel of amdgpu and i915
(drm_dvbridge_edid_read()) read from the EDID that DRM keeps. NVIDIA's
driver passes those blocks on unchecked, and Kodi skips the ones that are
not valid, so the same TV kept its Dolby Vision there.

Where the HF-EEODB made the read go past the regular extension count, the
blocks it counts are now filtered as the others: the valid ones are kept,
the HF-EEODB's count (byte 6 of block 1) is set to the blocks kept, the
checksum of block 1 moves by as much (a block that was valid stays valid;
a CTA block that DRM takes with a wrong checksum keeps it wrong by as
much), and the base block keeps its extension count where that is not
higher than the blocks kept. Block 1 holds the HF-EEODB and is valid here,
since the read takes the HF-EEODB only from a valid block 1. The EDID is
valid then (drm_edid_valid(): its size is what its counts say). An EDID
read without the HF-EEODB, one whose blocks are all valid and one whose
block 1 is not valid come as before.

KUnit tests (drm_edid_eeodb: drm_edid_read_custom() with the blocks served
from memory): an EEODB of 3 with block 2 of 0xff bytes, or a DisplayID block
2 with a wrong checksum, keeps block 3 with its Dolby Vision block as block 2
with an EEODB of 2 (both fail without this change); all blocks valid, a block
of zeros (DRM takes it: its checksum is right), a CTA block with a wrong
checksum, two blocks, a base block that counts the blocks with a block that
is not valid, and a block 1 that is not valid come as before.
---
 drivers/gpu/drm/drm_edid.c                  |  39 ++-
 drivers/gpu/drm/tests/Makefile              |   1 +
 drivers/gpu/drm/tests/drm_edid_eeodb_test.c | 328 ++++++++++++++++++++
 3 files changed, 363 insertions(+), 5 deletions(-)
 create mode 100644 drivers/gpu/drm/tests/drm_edid_eeodb_test.c

diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index 07970e5b5..71cfd429c 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -2115,13 +2115,32 @@ static struct edid *edid_filter_invalid_blocks(struct edid *edid,
 {
 	struct edid *new;
 	int i, valid_blocks = 0;
+	int num_blocks = edid_block_count(edid);
+	bool eeodb = false;
 
 	/*
-	 * Note: If the EDID uses HF-EEODB, but has invalid blocks, we'll revert
-	 * back to regular extension count here. We don't want to start
-	 * modifying the HF-EEODB extension too.
+	 * Hades: where the HF-EEODB of block 1 made the read go past the
+	 * regular extension count, the blocks it counts are filtered as the
+	 * others: the valid ones are kept, and its count is set to the blocks
+	 * that are kept (with the checksum of block 1 moved by as much, so that
+	 * a block that was valid stays so). The EDID used to go back to the
+	 * regular extension count here, which took out every block that only
+	 * the HF-EEODB counts for one of them that is not valid (a DisplayID
+	 * block with a wrong checksum, or a block of 0xff bytes where a sink
+	 * has fewer blocks than its HF-EEODB says): a TV's Dolby Vision data
+	 * block among them, for one. Block 1 holds the HF-EEODB and is valid
+	 * here (the read takes the HF-EEODB only of a valid block 1), so it
+	 * stays block 1.
 	 */
-	for (i = 0; i < edid_block_count(edid); i++) {
+	if (*alloc_size / EDID_LENGTH > num_blocks &&
+	    edid_block_valid(edid_block_data(edid, 1), false) &&
+	    edid_hfeeodb_block_count(edid) > num_blocks) {
+		num_blocks = min_t(int, *alloc_size / EDID_LENGTH,
+				   edid_hfeeodb_block_count(edid));
+		eeodb = true;
+	}
+
+	for (i = 0; i < num_blocks; i++) {
 		const void *src_block = edid_block_data(edid, i);
 
 		if (edid_block_valid(src_block, i == 0)) {
@@ -2138,7 +2157,17 @@ static struct edid *edid_filter_invalid_blocks(struct edid *edid,
 		return NULL;
 	}
 
-	edid->extensions = valid_blocks - 1;
+	if (eeodb) {
+		/* Hades: byte 6 of block 1 is the count of the HF-EEODB */
+		u8 *cta = (u8 *)edid_block_data(edid, 1);
+		u8 count = valid_blocks - 1;
+
+		cta[EDID_LENGTH - 1] -= count - cta[6];
+		cta[6] = count;
+		edid->extensions = min_t(int, edid->extensions, valid_blocks - 1);
+	} else {
+		edid->extensions = valid_blocks - 1;
+	}
 	edid->checksum = edid_block_compute_checksum(edid);
 
 	*alloc_size = edid_size_by_blocks(valid_blocks);
diff --git a/drivers/gpu/drm/tests/Makefile b/drivers/gpu/drm/tests/Makefile
index ae37fbb80..0e748f259 100644
--- a/drivers/gpu/drm/tests/Makefile
+++ b/drivers/gpu/drm/tests/Makefile
@@ -12,6 +12,7 @@ obj-$(CONFIG_DRM_KUNIT_TEST) += \
 	drm_damage_helper_test.o \
 	drm_dvbridge_test.o \
 	drm_edid_stereo_test.o \
+	drm_edid_eeodb_test.o \
 	drm_hdmi_gmp_hdr_test.o \
 	drm_dp_mst_helper_test.o \
 	drm_exec_test.o \
diff --git a/drivers/gpu/drm/tests/drm_edid_eeodb_test.c b/drivers/gpu/drm/tests/drm_edid_eeodb_test.c
new file mode 100644
index 000000000..de0a21008
--- /dev/null
+++ b/drivers/gpu/drm/tests/drm_edid_eeodb_test.c
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Hades: KUnit tests of the read of an EDID with an HDMI Forum EEODB (drm_edid_read_custom(), with
+ * the blocks served from memory) where an extension block is not valid: the blocks that only the
+ * EEODB counts are filtered as the others, the valid ones kept and the EEODB's count set to them
+ * (drm_edid.c, edid_filter_invalid_blocks()). And what does not change: an EDID whose blocks are
+ * all valid, one of two blocks, one whose base block counts the blocks, a block of zeros and a CTA
+ * block with a wrong checksum (which DRM takes), and an EDID whose block 1 is not valid.
+ */
+#include <kunit/test.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_dvbridge.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_kunit_helpers.h>
+
+#define EEODB_TEST_BLOCKS 4
+
+struct eeodb_priv {
+	struct drm_device drm;
+	struct drm_connector connector;
+	/* the EDID the sink gives, block by block */
+	u8 edid[EEODB_TEST_BLOCKS * EDID_LENGTH];
+	unsigned int blocks;
+};
+
+static const struct drm_connector_funcs eeodb_funcs = {
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.reset			= drm_atomic_helper_connector_reset,
+};
+
+static int eeodb_read_block(void *context, u8 *buf, unsigned int block, size_t len)
+{
+	const struct eeodb_priv *priv = context;
+
+	if (block >= priv->blocks || len != EDID_LENGTH)
+		return -EIO;
+	memcpy(buf, priv->edid + block * EDID_LENGTH, len);
+	return 0;
+}
+
+static void eeodb_sum(u8 *b)
+{
+	unsigned int i, s = 0;
+
+	for (i = 0; i < EDID_LENGTH - 1; i++)
+		s += b[i];
+	b[EDID_LENGTH - 1] = (u8)(256 - s % 256);
+}
+
+static bool eeodb_block_sum_ok(const u8 *b)
+{
+	unsigned int i, s = 0;
+
+	for (i = 0; i < EDID_LENGTH; i++)
+		s += b[i];
+	return !(s % 256);
+}
+
+/* a CTA-861 block of revision 3 with these data blocks */
+static void eeodb_cta(u8 *b, const u8 *dbs, unsigned int len)
+{
+	memset(b, 0, EDID_LENGTH);
+	b[0] = 0x02;
+	b[1] = 3;
+	b[2] = 4 + len;
+	b[3] = 0xf0;
+	memcpy(b + 4, dbs, len);
+	eeodb_sum(b);
+}
+
+/* Dolby Vision VSVDB, version 2, Standard + Low-Latency */
+static const u8 eeodb_dolby[] = {0xeb, 0x01, 0x46, 0xd0, 0x00, 0x44, 0x03, 0x72,
+				 0x88, 0x62, 0x76, 0x97};
+/* video capability data block with QS; HDR static metadata data block */
+static const u8 eeodb_vcdb_hdr[] = {0xe2, 0x00, 0xcb, 0xe3, 0x06, 0x0d, 0x01};
+
+/*
+ * The EDID of a sink: a base block of version 1.3 counting ext extensions, block 1 a CTA block
+ * with an HF-EEODB of eeodb (none with 0) as its first data block, block 2 a CTA block, block 3 a
+ * CTA block with the Dolby Vision block.
+ */
+static void eeodb_edid(struct eeodb_priv *priv, unsigned int ext, unsigned int eeodb)
+{
+	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	u8 dbs[16];
+	unsigned int n = 0;
+
+	memset(priv->edid, 0, sizeof(priv->edid));
+	memcpy(priv->edid, magic, 8);
+	priv->edid[8] = 0x4d;
+	priv->edid[9] = 0xd9;
+	priv->edid[18] = 1;
+	priv->edid[19] = 3;
+	priv->edid[20] = 0x80;
+	priv->edid[126] = ext;
+	eeodb_sum(priv->edid);
+	if (eeodb) {
+		dbs[n++] = 0xe2;
+		dbs[n++] = 0x78;
+		dbs[n++] = eeodb;
+	}
+	memcpy(dbs + n, eeodb_vcdb_hdr, sizeof(eeodb_vcdb_hdr));
+	n += sizeof(eeodb_vcdb_hdr);
+	eeodb_cta(priv->edid + EDID_LENGTH, dbs, n);
+	eeodb_cta(priv->edid + 2 * EDID_LENGTH, eeodb_vcdb_hdr, sizeof(eeodb_vcdb_hdr));
+	eeodb_cta(priv->edid + 3 * EDID_LENGTH, eeodb_dolby, sizeof(eeodb_dolby));
+	priv->blocks = EEODB_TEST_BLOCKS;
+}
+
+static int eeodb_test_init(struct kunit *test)
+{
+	struct eeodb_priv *priv;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	priv = drm_kunit_helper_alloc_drm_device(test, dev, struct eeodb_priv, drm,
+						 DRIVER_MODESET | DRIVER_ATOMIC);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv);
+	ret = drmm_connector_init(&priv->drm, &priv->connector, &eeodb_funcs,
+				  DRM_MODE_CONNECTOR_HDMIA, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	test->priv = priv;
+	return 0;
+}
+
+/* The EDID read, and whether the Dolby Vision rule of the tunnel takes its Standard mode */
+static const struct drm_edid *eeodb_read(struct kunit *test, bool *standard)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	struct drm_dvbridge_sink sink;
+	size_t size;
+	const u8 *raw;
+
+	drm_edid = drm_edid_read_custom(&priv->connector, eeodb_read_block, priv);
+	KUNIT_ASSERT_NOT_NULL(test, drm_edid);
+	raw = (const u8 *)drm_edid_raw(drm_edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	/*
+	 * The blocks that were kept: those that the EEODB counts where the EDID is valid (its size
+	 * is what its counts say), else those of the extension count of its base block, which the
+	 * read sets to the blocks it keeps
+	 */
+	size = (raw[126] + 1) * EDID_LENGTH;
+	if (drm_edid_valid(drm_edid) && size > EDID_LENGTH && raw[EDID_LENGTH + 4] == 0xe2 &&
+	    raw[EDID_LENGTH + 5] == 0x78)
+		size = (raw[EDID_LENGTH + 6] + 1) * EDID_LENGTH;
+	drm_dvbridge_edid_read(raw, size, &sink);
+	*standard = sink.result == DRM_DVBRIDGE_EDID_TAKEN && sink.standard;
+	return drm_edid;
+}
+
+/* The EEODB counts 3 blocks, all valid: the EDID comes as the sink gives it */
+static void drm_test_edid_eeodb_all_valid(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	bool standard;
+
+	eeodb_edid(priv, 1, 3);
+	drm_edid = eeodb_read(test, &standard);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(drm_edid));
+	KUNIT_EXPECT_MEMEQ(test, drm_edid_raw(drm_edid), priv->edid, 4 * EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+/* Block n made a block that DRM does not take: a DisplayID block with a wrong checksum */
+static void eeodb_bad_displayid(struct eeodb_priv *priv, unsigned int n)
+{
+	u8 *b = priv->edid + n * EDID_LENGTH;
+
+	memset(b, 0, EDID_LENGTH);
+	b[0] = 0x70;
+	b[1] = 0x13;
+	eeodb_sum(b);
+	b[EDID_LENGTH - 1] ^= 1;
+}
+
+/*
+ * Block 2 not valid (a DisplayID block with a wrong checksum, or one of 0xff bytes, as a sink with
+ * fewer blocks than its HF-EEODB says may give): it is taken out, block 3 (the Dolby Vision block)
+ * is kept as block 2, the EEODB counts 2, block 1 keeps a right checksum, the base block its count
+ * of 1
+ */
+static void eeodb_one_bad(struct kunit *test, bool ff)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	const u8 *raw;
+	u8 block3[EDID_LENGTH];
+	bool standard;
+
+	eeodb_edid(priv, 1, 3);
+	memcpy(block3, priv->edid + 3 * EDID_LENGTH, EDID_LENGTH);
+	if (ff)
+		memset(priv->edid + 2 * EDID_LENGTH, 0xff, EDID_LENGTH);
+	else
+		eeodb_bad_displayid(priv, 2);
+	drm_edid = eeodb_read(test, &standard);
+	raw = (const u8 *)drm_edid_raw(drm_edid);
+	/* (an assertion: the reads below are within the EDID only where its counts are its size) */
+	KUNIT_ASSERT_TRUE(test, drm_edid_valid(drm_edid));
+	KUNIT_EXPECT_EQ(test, raw[126], 1);
+	KUNIT_ASSERT_EQ(test, raw[EDID_LENGTH + 6], 2);
+	KUNIT_EXPECT_TRUE(test, eeodb_block_sum_ok(raw + EDID_LENGTH));
+	KUNIT_EXPECT_MEMEQ(test, raw + 2 * EDID_LENGTH, block3, EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+static void drm_test_edid_eeodb_ff_block(struct kunit *test)
+{
+	eeodb_one_bad(test, true);
+}
+
+static void drm_test_edid_eeodb_bad_displayid(struct kunit *test)
+{
+	eeodb_one_bad(test, false);
+}
+
+/* A block of zeros has a right checksum: DRM takes it, and the EDID comes whole, as before */
+static void drm_test_edid_eeodb_zero_block(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	bool standard;
+
+	eeodb_edid(priv, 1, 3);
+	memset(priv->edid + 2 * EDID_LENGTH, 0, EDID_LENGTH);
+	drm_edid = eeodb_read(test, &standard);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(drm_edid));
+	KUNIT_EXPECT_MEMEQ(test, drm_edid_raw(drm_edid), priv->edid, 4 * EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+/* A CTA block with a wrong checksum is taken by DRM, as before: the EDID comes whole */
+static void drm_test_edid_eeodb_cta_bad_checksum(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	bool standard;
+
+	eeodb_edid(priv, 1, 3);
+	priv->edid[3 * EDID_LENGTH - 1] ^= 1;
+	drm_edid = eeodb_read(test, &standard);
+	KUNIT_EXPECT_MEMEQ(test, drm_edid_raw(drm_edid), priv->edid, 4 * EDID_LENGTH);
+	drm_edid_free(drm_edid);
+}
+
+/* Two blocks: as the sink gives them */
+static void drm_test_edid_eeodb_two_blocks(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	bool standard;
+
+	eeodb_edid(priv, 1, 0);
+	priv->blocks = 2;
+	drm_edid = eeodb_read(test, &standard);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(drm_edid));
+	KUNIT_EXPECT_MEMEQ(test, drm_edid_raw(drm_edid), priv->edid, 2 * EDID_LENGTH);
+	KUNIT_EXPECT_FALSE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+/* The base block counts the 3 blocks, no EEODB, block 2 not valid: taken out as before */
+static void drm_test_edid_eeodb_none_bad_block(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	const u8 *raw;
+	bool standard;
+
+	eeodb_edid(priv, 3, 0);
+	eeodb_bad_displayid(priv, 2);
+	drm_edid = eeodb_read(test, &standard);
+	raw = (const u8 *)drm_edid_raw(drm_edid);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(drm_edid));
+	KUNIT_EXPECT_EQ(test, raw[126], 2);
+	KUNIT_EXPECT_MEMEQ(test, raw + 2 * EDID_LENGTH, priv->edid + 3 * EDID_LENGTH, EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+/* Block 1 not valid: its EEODB is not read, the base count is, and block 1 is taken out */
+static void drm_test_edid_eeodb_block1_bad(struct kunit *test)
+{
+	struct eeodb_priv *priv = test->priv;
+	const struct drm_edid *drm_edid;
+	bool standard;
+
+	eeodb_edid(priv, 1, 3);
+	eeodb_bad_displayid(priv, 1);
+	drm_edid = eeodb_read(test, &standard);
+	KUNIT_EXPECT_EQ(test, ((const u8 *)drm_edid_raw(drm_edid))[126], 0);
+	KUNIT_EXPECT_FALSE(test, standard);
+	drm_edid_free(drm_edid);
+}
+
+static struct kunit_case drm_edid_eeodb_tests[] = {
+	KUNIT_CASE(drm_test_edid_eeodb_all_valid),
+	KUNIT_CASE(drm_test_edid_eeodb_ff_block),
+	KUNIT_CASE(drm_test_edid_eeodb_bad_displayid),
+	KUNIT_CASE(drm_test_edid_eeodb_zero_block),
+	KUNIT_CASE(drm_test_edid_eeodb_cta_bad_checksum),
+	KUNIT_CASE(drm_test_edid_eeodb_two_blocks),
+	KUNIT_CASE(drm_test_edid_eeodb_none_bad_block),
+	KUNIT_CASE(drm_test_edid_eeodb_block1_bad),
+	{}
+};
+
+static struct kunit_suite drm_edid_eeodb_test_suite = {
+	.name = "drm_edid_eeodb",
+	.init = eeodb_test_init,
+	.test_cases = drm_edid_eeodb_tests,
+};
+
+kunit_test_suite(drm_edid_eeodb_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests of the EDID read with an HDMI Forum EEODB (Hades)");
+MODULE_LICENSE("Dual MIT/GPL");
-- 
2.53.0

