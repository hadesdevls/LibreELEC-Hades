From 6bb768e5835102f7f50a74d7143ee424ddd96c2a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:01:49 +0000
Subject: [PATCH] drm: BT.2020 in the AVI InfoFrame of the Dolby Vision
 tunnel, where user space asks for it

drm_dvbridge_tunnel_avi_bt2020(): the AVI InfoFrame of the tunnel, made by
drm_dvbridge_tunnel_avi(), with the extended colorimetry BT.2020 (C 3, EC
6) in place of no colorimetry. RGB, full range and the VIC stay as they
are.

Why: a licensed player sends it so with Dolby Vision TV-led. Read on an
Amlogic player with Dolby's own core, five films: RGB, full range,
extended colorimetry BT.2020; Amlogic's transmitter sets it citing
"Expected AVI-IF for Dolby Vision output, need BT2020 for DV" of Dolby's
kit (CoreELEC common_drivers, hdmitx21/hdmi_tx_main.c). The tunnel has
always gone out without colorimetry, and what a display does with either
is only seen on it: the drivers take it only where user space asks
(DVBRIDGE_DV_AVI_BT2020_LAB, the next two patches), so nothing changes
by default. Only the InfoFrame changes, not a byte of the tunnel.

The KUnit test of the tunnel's AVI InfoFrame checks the packed bytes
with it (C, EC, Y, Q and the VIC).
---
 drivers/gpu/drm/tests/drm_dvbridge_test.c | 11 +++++++++++
 include/drm/drm_dvbridge.h                | 16 ++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/drivers/gpu/drm/tests/drm_dvbridge_test.c b/drivers/gpu/drm/tests/drm_dvbridge_test.c
index aa417b0..395d14d 100644
--- a/drivers/gpu/drm/tests/drm_dvbridge_test.c
+++ b/drivers/gpu/drm/tests/drm_dvbridge_test.c
@@ -120,6 +120,17 @@ static void drm_test_dvbridge_avi(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, (buf[6] >> 2) & 3, HDMI_QUANTIZATION_RANGE_FULL);	/* Q */
 	KUNIT_EXPECT_EQ(test, buf[7], 93);					/* VIC */
 
+	/* Hades: BT.2020 in it (DVBRIDGE_DV_AVI_BT2020_LAB): C extended, EC BT.2020, the rest as above */
+	drm_dvbridge_tunnel_avi_bt2020(&avi);
+	len = hdmi_avi_infoframe_pack(&avi, buf, sizeof(buf));
+	KUNIT_ASSERT_GT(test, len, 7);
+	KUNIT_EXPECT_EQ(test, (buf[4] >> 5) & 3, HDMI_COLORSPACE_RGB);
+	KUNIT_EXPECT_EQ(test, buf[5] >> 6, HDMI_COLORIMETRY_EXTENDED);
+	KUNIT_EXPECT_EQ(test, (buf[6] >> 4) & 7, HDMI_EXTENDED_COLORIMETRY_BT2020);
+	KUNIT_EXPECT_EQ(test, (buf[6] >> 2) & 3, HDMI_QUANTIZATION_RANGE_FULL);
+	KUNIT_EXPECT_EQ(test, buf[7], 93);
+	drm_dvbridge_tunnel_avi(&avi, 93);
+
 	/* Low-Latency: YCbCr 4:2:2, BT.2020, the default RGB range, limited YCC range */
 	drm_dvbridge_ll_avi(&avi);
 	len = hdmi_avi_infoframe_pack(&avi, buf, sizeof(buf));
diff --git a/include/drm/drm_dvbridge.h b/include/drm/drm_dvbridge.h
index 1d3f62e..8fcc24b 100644
--- a/include/drm/drm_dvbridge.h
+++ b/include/drm/drm_dvbridge.h
@@ -457,6 +457,22 @@ static inline void drm_dvbridge_tunnel_avi(struct hdmi_avi_infoframe *frame, u8
 	frame->quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
 }
 
+/*
+ * Hades: the AVI InfoFrame of the tunnel, from drm_dvbridge_tunnel_avi(), with the extended
+ * colorimetry BT.2020 (DVBRIDGE_DV_AVI_BT2020_LAB): what a licensed player sends with Dolby Vision
+ * TV-led. Read on an Amlogic player with Dolby's own core: RGB, full range, extended colorimetry
+ * BT.2020; Amlogic's transmitter sets it citing "Expected AVI-IF for Dolby Vision output, need
+ * BT2020 for DV" of Dolby's kit (CoreELEC common_drivers, hdmitx21/hdmi_tx_main.c). Only the
+ * InfoFrame changes: the bytes of the tunnel are the same. What a sink does with either is only
+ * seen on it, so user space asks for it, and without the property the frame says no colorimetry,
+ * as before.
+ */
+static inline void drm_dvbridge_tunnel_avi_bt2020(struct hdmi_avi_infoframe *frame)
+{
+	frame->colorimetry = HDMI_COLORIMETRY_EXTENDED;
+	frame->extended_colorimetry = HDMI_EXTENDED_COLORIMETRY_BT2020;
+}
+
 /* The Dolby VSIF of the tunnel, in the vendor slot: the Dolby Vision signal. */
 static inline void drm_dvbridge_tunnel_vsif(struct hdmi_dolby_vendor_infoframe *frame)
 {
-- 
