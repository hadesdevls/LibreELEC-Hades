+			drm_info(dev,
+				 "[CRTC:%d:%s] static HDR packet: %s -> %s, sent with the update: the new stream keeps the pipe of the old one, whose stream encoder still had the old packet\n",
+				 pcrtc->base.id, pcrtc->name,
+				 amdgpu_dm_hdr_packet_name(dm_old_crtc_state->stream),
+				 amdgpu_dm_hdr_packet_name(acrtc_state->stream));
+		}
+
 		if (new_pcrtc_state->color_mgmt_changed) {
 			/*
