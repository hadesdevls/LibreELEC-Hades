diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index f139d50..d892ab7 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3219,6 +3219,60 @@ bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
 		      sizeof(new_stream->vsp_infopacket));
 }
 
+/*
+ * Hades: the static HDR packet (the Dynamic Range and Mastering InfoFrame, or its SDP on DisplayPort)
+ * of a stream that a commit replaced, where DC keeps the pipe as the old stream programmed it.
+ *
+ * Entering or leaving HDR forces a modeset (amdgpu_dm_connector_atomic_check(): "DC considers the
+ * stream backends changed if the static metadata changes"), and dm_update_crtc_state() takes it
+ * back where dc_is_stream_unchanged() finds the new stream the same as the old: the packet then
+ * goes as a stream update of its own, which is the usual case. Where the modeset stays, for
+ * anything that dc_is_stream_unchanged() compares and the pipe does not (the audio of the sink, the
+ * MSA timing parameter) or for a change of connectors (a new scaling or ABM level), DC replaces the
+ * stream but programs the pipe again only where pipe_need_reprogram() says so, and it compares no
+ * InfoFrame: on the same timing, colour space, signal and DPMS state the stream encoder keeps
+ * the packet of the old stream. The display would stay in HDR over an SDR picture, or show HDR as
+ * SDR. The same mechanism that linux-9910 (the Dolby Vision tunnel) and linux-9918 (the vendor
+ * InfoFrame of HDMI 3D) handle, there for the static HDR packet: CB1 found it on a Ryzen 7430U
+ * (CroqueMr/libreelec-CB1, PR #306, 94a0dbadf8).
+ */
+bool amdgpu_dm_hdr_packet_kept_stale(struct dc_stream_state *old_stream,
+				     struct dc_stream_state *new_stream)
+{
+	if (!old_stream || !new_stream || old_stream == new_stream)
+		return false;
+	/* a pipe whose signal, DPMS state, timing or colour space changes is programmed in full */
+	if (old_stream->signal != new_stream->signal || old_stream->dpms_off != new_stream->dpms_off ||
+	    dc_is_timing_changed(old_stream, new_stream))
+		return false;
+	return memcmp(&old_stream->hdr_static_metadata, &new_stream->hdr_static_metadata,
+		      sizeof(new_stream->hdr_static_metadata)) != 0;
+}
+EXPORT_IF_KUNIT(amdgpu_dm_hdr_packet_kept_stale);
+
+/* Hades, for the log: the EOTF of the static HDR packet of a stream (CTA-861-G, table 45) */
+const char *amdgpu_dm_hdr_packet_name(const struct dc_stream_state *stream)
+{
+	const struct dc_info_packet *p = stream ? &stream->hdr_static_metadata : NULL;
+
+	if (!p || !p->valid)
+		return "none";
+	/* the EOTF is the first byte of the payload: sb[1] in the InfoFrame, sb[2] in the SDP */
+	switch ((p->hb0 == 0x87 ? p->sb[1] : p->sb[2]) & 0x7) {
+	case 0:
+		return "SDR";
+	case 1:
+		return "HDR of traditional gamma";
+	case 2:
+		return "PQ (HDR10)";
+	case 3:
+		return "HLG";
+	default:
+		return "a reserved EOTF";
+	}
+}
+EXPORT_IF_KUNIT(amdgpu_dm_hdr_packet_name);
+
 /* For the log: what the vendor InfoFrame of a stream says about 3D. */
 const char *amdgpu_dm_stereo_vsif_name(const struct dc_stream_state *stream)
 {
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index 6b575fd..ced5cf5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -100,4 +100,14 @@ u32 amdgpu_dm_stereo_layout(const struct drm_connector *connector,
 /* HDMI 3D, for the log: what the vendor InfoFrame of a stream says about 3D. */
 const char *amdgpu_dm_stereo_vsif_name(const struct dc_stream_state *stream);
 
+/*
+ * Hades: the commit replaced the stream of a CRTC on a pipe that DC keeps as the old stream
+ * programmed it, and the static HDR packet of the new stream is not that of the old one.
+ */
+bool amdgpu_dm_hdr_packet_kept_stale(struct dc_stream_state *old_stream,
+				     struct dc_stream_state *new_stream);
+
+/* Hades, for the log: the EOTF that the static HDR packet of a stream names, or "none". */
+const char *amdgpu_dm_hdr_packet_name(const struct dc_stream_state *stream);
+
 #endif
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
index d462d18..25e3e38 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -10636,7 +10636,82 @@ static void dm_test_force_commit_conn_state_error(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dm_force_atomic_commit(&ctx->aconnector->base), -ENOMEM);
 }
 
+/*
+ * Hades: amdgpu_dm_hdr_packet_kept_stale(): the static HDR packet of a replaced stream on a pipe
+ * that DC keeps (CB1 PR #306). Streams of 2160p23.976 RGB at 10 bits on HDMI.
+ */
+static void dm_test_hdr_packet_stream(struct dc_stream_state *s, u8 eotf)
+{
+	memset(s, 0, sizeof(*s));
+	s->signal = SIGNAL_TYPE_HDMI_TYPE_A;
+	s->timing.h_addressable = 3840;
+	s->timing.v_addressable = 2160;
+	s->timing.h_total = 5500;
+	s->timing.v_total = 2250;
+	s->timing.pix_clk_100hz = 2967033;
+	s->timing.display_color_depth = COLOR_DEPTH_101010;
+	s->timing.pixel_encoding = PIXEL_ENCODING_RGB;
+	s->output_color_space = COLOR_SPACE_2020_RGB_FULLRANGE;
+	if (eotf != 0xff) {
+		s->hdr_static_metadata.valid = true;
+		s->hdr_static_metadata.hb0 = 0x87;
+		s->hdr_static_metadata.hb1 = 0x01;
+		s->hdr_static_metadata.hb2 = 0x1a;
+		s->hdr_static_metadata.sb[1] = eotf;
+	}
+}
+
+static void dm_test_hdr_packet_kept_stale(struct kunit *test)
+{
+	struct dc_stream_state *sdr = kunit_kzalloc(test, sizeof(*sdr), GFP_KERNEL);
+	struct dc_stream_state *pq = kunit_kzalloc(test, sizeof(*pq), GFP_KERNEL);
+	struct dc_stream_state *pq2 = kunit_kzalloc(test, sizeof(*pq2), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, sdr);
+	KUNIT_ASSERT_NOT_NULL(test, pq);
+	KUNIT_ASSERT_NOT_NULL(test, pq2);
+	dm_test_hdr_packet_stream(sdr, 0xff);
+	dm_test_hdr_packet_stream(pq, 2);
+	dm_test_hdr_packet_stream(pq2, 2);
+
+	/* SDR to HDR10 and back on the same pipe: the packet goes with the update */
+	KUNIT_EXPECT_TRUE(test, amdgpu_dm_hdr_packet_kept_stale(sdr, pq));
+	KUNIT_EXPECT_TRUE(test, amdgpu_dm_hdr_packet_kept_stale(pq, sdr));
+	KUNIT_EXPECT_STREQ(test, amdgpu_dm_hdr_packet_name(sdr), "none");
+	KUNIT_EXPECT_STREQ(test, amdgpu_dm_hdr_packet_name(pq), "PQ (HDR10)");
+	/* HDR10 to HLG */
+	pq2->hdr_static_metadata.sb[1] = 3;
+	KUNIT_EXPECT_TRUE(test, amdgpu_dm_hdr_packet_kept_stale(pq, pq2));
+	KUNIT_EXPECT_STREQ(test, amdgpu_dm_hdr_packet_name(pq2), "HLG");
+	/* the same packet, the same stream, no old stream: nothing */
+	pq2->hdr_static_metadata.sb[1] = 2;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(pq, pq2));
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(pq, pq));
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(NULL, pq));
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(pq, NULL));
+	/* a pipe that DC programs in full sends the new packet itself: another depth ... */
+	pq2->timing.display_color_depth = COLOR_DEPTH_888;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(sdr, pq2));
+	/* ... another colour space, another signal, another DPMS state */
+	dm_test_hdr_packet_stream(pq2, 2);
+	pq2->output_color_space = COLOR_SPACE_SRGB;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(sdr, pq2));
+	dm_test_hdr_packet_stream(pq2, 2);
+	pq2->signal = SIGNAL_TYPE_DISPLAY_PORT;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(sdr, pq2));
+	dm_test_hdr_packet_stream(pq2, 2);
+	pq2->dpms_off = true;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_hdr_packet_kept_stale(sdr, pq2));
+	/* the SDP of DisplayPort names its EOTF in sb[2] */
+	dm_test_hdr_packet_stream(pq2, 0xff);
+	pq2->hdr_static_metadata.valid = true;
+	pq2->hdr_static_metadata.hb1 = 0x87;
+	pq2->hdr_static_metadata.sb[2] = 3;
+	KUNIT_EXPECT_STREQ(test, amdgpu_dm_hdr_packet_name(pq2), "HLG");
+}
+
 static struct kunit_case amdgpu_dm_connector_tests[] = {
+	KUNIT_CASE(dm_test_hdr_packet_kept_stale), /* Hades */
 	/* get_subconnector_type */
 	KUNIT_CASE(dm_test_subconnector_type_none),
 	KUNIT_CASE(dm_test_subconnector_type_vga),
