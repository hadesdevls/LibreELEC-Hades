@@ -4256,6 +4256,22 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 					    amdgpu_dm_stereo_vsif_name(acrtc_state->stream));
 		}
 
+		/*
+		 * Hades: the same for the static HDR packet, where the commit replaced the stream and DC
