From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Fri, 20 Nov 2026 21:20:12 +0000
Subject: [PATCH] drm/amd/display: say that no EDID came through a passive
 dual-mode adaptor

When the display behind a passive DisplayPort dual-mode (DP++) adaptor
gives no EDID (dm_helpers_read_local_edid(): "EDID err: 2" and "No EDID
read." after its 25 reads, or none with a valid checksum), DC keeps the
display on a DisplayPort connector but takes it for a DVI one, since
only an EDID says HDMI (detect_link_and_local_sink(): an HDMI sink
without edid_hdmi is DVI), and the driver lists 640x480 only
(amdgpu_dm_connector_get_modes()): no sound and no InfoFrames, so no
HDMI 3D and no Dolby Vision tunnel either. The line of Hades for the
adaptor (amdgpu_dm_update_dual_mode()) then said "to a DVI display",
which is what DC made of the display, not what it is: issue 31 of
LibreELEC Hades, a Philips TV that gave no EDID through one type 2
adaptor on an A10-8730B and was named a DVI display, while the same TV
gives its EDID through other adaptors and over HDMI.

A display without an EDID is told apart by its empty dc_edid
(amdgpu_dm_dual_mode_no_edid()), and the line then says that no EDID
came from the display through the adaptor, so that the driver takes it
for a DVI one and lists 640x480 only: no sound, no HDMI 3D and no Dolby
Vision tunnel. It is said again when that changes, as for a change of
the adaptor. What the driver does, and DVBRIDGE_DUAL_MODE, do not
change.

Checked: KUnit of amdgpu_dm_connector (x86_64 in QEMU), 249 of 249,
with a new case, dm_test_dual_mode_no_edid, which fails 2 of its
expectations when the line does not tell a display without an EDID
apart; W=1 of amdgpu_dm_connector.o without warnings.

Not tried with an adaptor on hardware.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  2 +
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 29 +++++++++-
 .../display/amdgpu_dm/amdgpu_dm_connector.h   |  1 +
 .../tests/amdgpu_dm_connector_test.c          | 57 +++++++++++++++++++
 4 files changed, 88 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index f7ef1eb..c0509cf 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -934,6 +934,8 @@ struct amdgpu_dm_connector {
 	 */
 	struct drm_property *dvbridge_dual_mode_property;
 	u8 dvbridge_dual_mode_logged;
+	/* Hades: and whether it said that no EDID came from the display (amdgpu_dm_dual_mode_no_edid()) */
+	bool dvbridge_dual_mode_logged_no_edid;
 };
 
 static inline void amdgpu_dm_set_mst_status(uint8_t *status,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index f5afdf1..893c6b1 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1085,6 +1085,20 @@ static const char *amdgpu_dm_dual_mode_name(const struct dc_link *link)
 	}
 }
 
+/*
+ * Hades: no EDID came from the display behind a passive adaptor: none answered on the DDC through
+ * it (dm_helpers_read_local_edid(): "EDID err" and "No EDID read."), or none with a valid checksum.
+ * DC keeps such a display on a DisplayPort connector, but takes it for a DVI one, since only an
+ * EDID says HDMI (detect_link_and_local_sink(): an HDMI sink without edid_hdmi is DVI), and the
+ * driver lists 640x480 only (amdgpu_dm_connector_get_modes()): no sound, no InfoFrames. The kernel
+ * log says that then, rather than name the display a DVI one, which it may not be.
+ */
+STATIC_IFN_KUNIT bool amdgpu_dm_dual_mode_no_edid(const struct amdgpu_dm_connector *aconnector)
+{
+	return aconnector->dc_sink && !aconnector->dc_sink->dc_edid.length;
+}
+EXPORT_IF_KUNIT(amdgpu_dm_dual_mode_no_edid);
+
 /*
  * Hades: a DisplayPort connector (SST) once its display was looked at: what passive adaptor is
  * behind it (amdgpu_dm_dual_mode_of()), for HDMI 3D (stereo_allowed, which the probe helper reads
@@ -1094,6 +1108,7 @@ static const char *amdgpu_dm_dual_mode_name(const struct dc_link *link)
 STATIC_IFN_KUNIT void amdgpu_dm_update_dual_mode(struct amdgpu_dm_connector *aconnector)
 {
 	struct drm_connector *connector = &aconnector->base;
+	bool no_edid;
 	int mode;
 
 	if (connector->connector_type != DRM_MODE_CONNECTOR_DisplayPort || aconnector->mst_root)
@@ -1103,11 +1118,23 @@ STATIC_IFN_KUNIT void amdgpu_dm_update_dual_mode(struct amdgpu_dm_connector *aco
 	if (aconnector->dvbridge_dual_mode_property)
 		drm_object_property_set_value(&connector->base,
 					      aconnector->dvbridge_dual_mode_property, mode);
-	if (mode == aconnector->dvbridge_dual_mode_logged)
+	/* (an HDMI display has an EDID: only "other" can be without one) */
+	no_edid = mode != AMDGPU_DVBRIDGE_DUAL_MODE_NONE && amdgpu_dm_dual_mode_no_edid(aconnector);
+	if (mode == aconnector->dvbridge_dual_mode_logged &&
+	    no_edid == aconnector->dvbridge_dual_mode_logged_no_edid)
 		return;
 	aconnector->dvbridge_dual_mode_logged = mode;
+	aconnector->dvbridge_dual_mode_logged_no_edid = no_edid;
 	if (mode == AMDGPU_DVBRIDGE_DUAL_MODE_NONE)
 		return;
+	if (no_edid) {
+		drm_info(connector->dev,
+			 "[CONNECTOR:%d:%s] passive DisplayPort dual-mode adaptor: %s, TMDS clock up to %u kHz; no EDID came from the display through it, so the driver takes the display for a DVI one and lists 640x480 only: no sound, no HDMI 3D and no Dolby Vision tunnel\n",
+			 connector->base.id, connector->name,
+			 amdgpu_dm_dual_mode_name(aconnector->dc_link),
+			 aconnector->dc_link->dongle_max_pix_clk);
+		return;
+	}
 	drm_info(connector->dev,
 		 "[CONNECTOR:%d:%s] passive DisplayPort dual-mode adaptor: %s, TMDS clock up to %u kHz, to %s display%s\n",
 		 connector->base.id, connector->name, amdgpu_dm_dual_mode_name(aconnector->dc_link),
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
index b074cb3..8955b61 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.h
@@ -197,6 +197,7 @@ enum drm_mode_subconnector get_subconnector_type(struct dc_link *link);
 void update_subconnector_property(struct amdgpu_dm_connector *aconnector);
 /* Hades: the passive dual-mode adaptor behind a DisplayPort connector */
 void amdgpu_dm_update_dual_mode(struct amdgpu_dm_connector *aconnector);
+bool amdgpu_dm_dual_mode_no_edid(const struct amdgpu_dm_connector *aconnector);
 bool amdgpu_dm_dvbridge_tmds_hdmi(const struct amdgpu_dm_connector *aconn);
 void amdgpu_dm_fbc_init(struct drm_connector *connector);
 void amdgpu_dm_set_panel_type(struct amdgpu_dm_connector *aconnector);
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
index a84f885..09d15b3 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -5788,6 +5788,62 @@ static void dm_test_dual_mode_update_stereo(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, hdmi->aconnector->base.stereo_allowed);
 }
 
+/**
+ * dm_test_dual_mode_no_edid - Test what the kernel log says of a display without an EDID
+ * @test: The KUnit test context
+ *
+ * Behind an HDMI adaptor, a display that gave no EDID is a DVI sink for DC with an empty dc_edid
+ * (issue 31 of LibreELEC Hades): the log says that no EDID came, and says it again when that changes.
+ */
+static void dm_test_dual_mode_no_edid(struct kunit *test)
+{
+	struct drm_device *drm = dm_test_alloc_drm(test);
+	struct dm_test_dual_mode_ctx *ctx =
+		dm_test_dual_mode_ctx_alloc(test, drm, DRM_MODE_CONNECTOR_DisplayPort,
+					    SIGNAL_TYPE_DISPLAY_PORT, SIGNAL_TYPE_DVI_SINGLE_LINK,
+					    DISPLAY_DONGLE_DP_HDMI_DONGLE, 300000, false);
+	struct dm_test_dual_mode_ctx *none =
+		dm_test_dual_mode_ctx_alloc(test, drm, DRM_MODE_CONNECTOR_DisplayPort,
+					    SIGNAL_TYPE_DISPLAY_PORT, SIGNAL_TYPE_NONE,
+					    DISPLAY_DONGLE_DP_HDMI_DONGLE, 300000, false);
+
+	/* no display at all is not "no EDID" */
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_dual_mode_no_edid(none->aconnector));
+	amdgpu_dm_update_dual_mode(none->aconnector);
+	KUNIT_EXPECT_FALSE(test, none->aconnector->dvbridge_dual_mode_logged_no_edid);
+
+	/* the display gave no EDID through the adaptor */
+	KUNIT_EXPECT_TRUE(test, amdgpu_dm_dual_mode_no_edid(ctx->aconnector));
+	amdgpu_dm_update_dual_mode(ctx->aconnector);
+	KUNIT_EXPECT_FALSE(test, ctx->aconnector->base.stereo_allowed);
+	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->dvbridge_dual_mode_logged,
+			AMDGPU_DVBRIDGE_DUAL_MODE_OTHER);
+	KUNIT_EXPECT_TRUE(test, ctx->aconnector->dvbridge_dual_mode_logged_no_edid);
+
+	/* a DVI display with its EDID: still "other", no longer said to be without an EDID */
+	ctx->sink->dc_edid.length = DC_EDID_BLOCK_SIZE;
+	KUNIT_EXPECT_FALSE(test, amdgpu_dm_dual_mode_no_edid(ctx->aconnector));
+	amdgpu_dm_update_dual_mode(ctx->aconnector);
+	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->dvbridge_dual_mode_logged,
+			AMDGPU_DVBRIDGE_DUAL_MODE_OTHER);
+	KUNIT_EXPECT_FALSE(test, ctx->aconnector->dvbridge_dual_mode_logged_no_edid);
+
+	/* an HDMI display, with its EDID, through the same adaptor */
+	ctx->sink->sink_signal = SIGNAL_TYPE_HDMI_TYPE_A;
+	amdgpu_dm_update_dual_mode(ctx->aconnector);
+	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->dvbridge_dual_mode_logged,
+			AMDGPU_DVBRIDGE_DUAL_MODE_HDMI);
+	KUNIT_EXPECT_FALSE(test, ctx->aconnector->dvbridge_dual_mode_logged_no_edid);
+
+	/* and the EDID gone again (DC makes such a sink DVI): said again */
+	ctx->sink->dc_edid.length = 0;
+	ctx->sink->sink_signal = SIGNAL_TYPE_DVI_SINGLE_LINK;
+	amdgpu_dm_update_dual_mode(ctx->aconnector);
+	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->dvbridge_dual_mode_logged,
+			AMDGPU_DVBRIDGE_DUAL_MODE_OTHER);
+	KUNIT_EXPECT_TRUE(test, ctx->aconnector->dvbridge_dual_mode_logged_no_edid);
+}
+
 static struct drm_display_mode *dm_test_dual_mode_cea(struct kunit *test, struct drm_device *drm,
 						      u8 vic, u32 layout)
 {
@@ -6381,6 +6437,7 @@ static struct kunit_case amdgpu_dm_connector_tests[] = {
 	KUNIT_CASE(dm_test_dual_mode_of),
 	KUNIT_CASE(dm_test_dvbridge_tmds_hdmi_links),
 	KUNIT_CASE(dm_test_dual_mode_update_stereo),
+	KUNIT_CASE(dm_test_dual_mode_no_edid),
 	KUNIT_CASE(dm_test_dual_mode_stereo_layout),
 	KUNIT_CASE(dm_test_dual_mode_3d_streams),
 	KUNIT_CASE(dm_test_dual_mode_tmds_clock),
-- 
2.53.0

