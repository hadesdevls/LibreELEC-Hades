From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:24:40 +0000
Subject: [PATCH] ALSA: hda/hdmi: intel: the output of an Alder Lake-P pin set
 again where the display left it off

On the HDMI codec of Alder Lake-P (0x8086281c, which Alder Lake-N
uses too), the pin's widget control can be found at 0 (PIN_OUT and
EPT cleared) while the stream of the pin keeps running, after a mode
set of i915 that disables and enables the audio of the transcoder
(hsw_audio_codec_disable() and hsw_audio_codec_enable(): the ELD is
made invalid, then valid). That is how a Dolby Vision output that ends
while a passthrough stream drains leaves the HDMI audio silent: in the
menus and in every later video, until the codec is initialized again
(a restart of Kodi, or minutes later when the codec is suspended and
resumed). Nothing in the driver writes 0 there on Intel: the hardware
resets the pin, as the driver says it can reset the converter selection
of a pin when the transcoder changes.

The driver selects the converter again and rewrites the audio
infoframe when the ELD comes back (update_eld() calls pin_cvt_fixup()
for a pin whose stream is set up), and pin_cvt_fixup() runs again when
a stream of the pin opens and when it is prepared. But on Intel it
writes PIN_OUT only when the codec is initialized (hdmi_init_pin(): no
dyn_pin_out), and hdmi_pin_hbr_setup() keeps the bit as it reads it.

i915_pin_cvt_fixup() now sets PIN_OUT again on such a pin, keeping its
encoding (EPT, HBR), where a stream of the pin is in use and its sink
has a valid ELD, once the device of the pin is selected. Only on this
codec, and said in the kernel log when it happens:
"HDMI pin 0x..: output was off with its stream in use (pin control
0x..), enabled again".
---
 sound/hda/codecs/hdmi/intelhdmi.c | 43 +++++++++++++++++++++++++++++--
 1 file changed, 41 insertions(+), 2 deletions(-)

diff --git a/sound/hda/codecs/hdmi/intelhdmi.c b/sound/hda/codecs/hdmi/intelhdmi.c
index 7314104..cffa060 100644
--- a/sound/hda/codecs/hdmi/intelhdmi.c
+++ b/sound/hda/codecs/hdmi/intelhdmi.c
@@ -475,6 +475,44 @@ static int i915_hsw_setup_stream(struct hda_codec *codec, hda_nid_t cvt_nid,
 	return res;
 }
 
+/*
+ * The output of an HDMI pin of the Alder Lake-P codec (Alder Lake-N has it too), set again where
+ * the display left it off. A mode set of i915 that disables and enables the audio of the
+ * transcoder (hsw_audio_codec_disable() and hsw_audio_codec_enable(): the ELD invalid, then
+ * valid) can leave the pin's widget control at 0, PIN_OUT and EPT cleared, while its stream runs:
+ * the hardware resets it, as it can reset the converter selection of a pin when the transcoder
+ * changes. The driver selects the converter again and rewrites the audio infoframe when the ELD
+ * comes back (update_eld() calls pin_cvt_fixup() for a pin whose stream is set up), but on Intel
+ * it writes PIN_OUT only when the codec is initialized (no dyn_pin_out), and
+ * hdmi_pin_hbr_setup() keeps the bit as it reads it, so the stream and every later one played
+ * silent until the codec was initialized again. Only where a stream of the pin is in use and its
+ * sink has a valid ELD; the encoding of the pin (EPT, HBR) is kept as it is.
+ */
+static void adlp_restore_pin_out(struct hda_codec *codec,
+				 struct hdmi_spec_per_pin *per_pin)
+{
+	struct hdmi_spec *spec = codec->spec;
+	int pinctl;
+
+	if (codec->core.vendor_id != 0x8086281c)
+		return;
+	if (per_pin->pcm_idx < 0 ||
+	    !test_bit(per_pin->pcm_idx, &spec->pcm_in_use) ||
+	    !per_pin->sink_eld.eld_valid)
+		return;
+
+	pinctl = snd_hda_codec_read(codec, per_pin->pin_nid, 0,
+				    AC_VERB_GET_PIN_WIDGET_CONTROL, 0);
+	if (pinctl < 0 || (pinctl & PIN_OUT))
+		return;
+
+	snd_hda_codec_write(codec, per_pin->pin_nid, 0,
+			    AC_VERB_SET_PIN_WIDGET_CONTROL, pinctl | PIN_OUT);
+	codec_info(codec,
+		   "HDMI pin 0x%x: output was off with its stream in use (pin control 0x%02x), enabled again\n",
+		   per_pin->pin_nid, pinctl);
+}
+
 /* pin_cvt_fixup ops override for HSW+ and VLV+ */
 static void i915_pin_cvt_fixup(struct hda_codec *codec,
 			       struct hdmi_spec_per_pin *per_pin,
@@ -482,8 +520,9 @@ static void i915_pin_cvt_fixup(struct hda_codec *codec,
 {
 	if (per_pin) {
 		haswell_verify_D0(codec, per_pin->cvt_nid, per_pin->pin_nid);
-		snd_hda_set_dev_select(codec, per_pin->pin_nid,
-			       per_pin->dev_id);
+		if (!snd_hda_set_dev_select(codec, per_pin->pin_nid,
+					    per_pin->dev_id))
+			adlp_restore_pin_out(codec, per_pin);
 		intel_verify_pin_cvt_connect(codec, per_pin);
 		intel_not_share_assigned_cvt(codec, per_pin->pin_nid,
 				     per_pin->dev_id, per_pin->mux_idx);
-- 
