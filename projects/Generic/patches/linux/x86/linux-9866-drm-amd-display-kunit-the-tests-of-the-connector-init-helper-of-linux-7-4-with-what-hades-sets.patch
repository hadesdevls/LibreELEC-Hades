From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:48:05 +0000
Subject: [PATCH] drm/amd/display: KUnit: the tests of the connector init
 helper of Linux 7.4 with what Hades sets

Linux 7.4 adds KUnit tests of amdgpu_dm_connector_init_helper() that
check upstream's defaults. Two of those defaults are Hades' own: an HDMI
connector takes 3D modes (amdgpu.hdmi_3d, on by default, linux-9911) and
a short HDMI HPD drop is not an unplug (hdmi_hpd_debounce_delay_ms 3000
by default, linux-9935). The common defaults test now expects those, and
the test of the debounce turned off sets the parameter to 0 for its call
(upstream's default) instead of relying on the default; neither check is
dropped.

With them, dm_test_init_helper_* pass in UML (10 of 10); before, 2 of 10
failed on these two values.
---
 .../amdgpu_dm/tests/amdgpu_dm_connector_test.c   | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
index f66967fad730..7d7d03460c5d 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -9608,10 +9608,12 @@ static void dm_test_init_helper_common_defaults(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->as_type, (int)ADAPTIVE_SYNC_TYPE_NONE);
 	KUNIT_EXPECT_FALSE(test, connector->interlace_allowed);
 	KUNIT_EXPECT_FALSE(test, connector->doublescan_allowed);
-	KUNIT_EXPECT_FALSE(test, connector->stereo_allowed);
+	/* Hades: an HDMI connector takes 3D modes (amdgpu.hdmi_3d, on by default) */
+	KUNIT_EXPECT_TRUE(test, connector->stereo_allowed);
 	KUNIT_EXPECT_EQ(test, connector->dpms, DRM_MODE_DPMS_OFF);
 	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->hpd.hpd, (int)AMDGPU_HPD_NONE);
-	KUNIT_EXPECT_EQ(test, ctx->aconnector->hdmi_hpd_debounce_delay_ms, 0);
+	/* Hades: a short HPD drop is not an unplug: 3000 ms by default (linux-9935) */
+	KUNIT_EXPECT_EQ(test, ctx->aconnector->hdmi_hpd_debounce_delay_ms, 3000);
 
 	/* The link encoder advertises no YCbCr 4:2:0 support. */
 	KUNIT_EXPECT_FALSE(test, connector->ycbcr_420_allowed);
@@ -9812,19 +9814,23 @@ static void dm_test_init_helper_hdcp_property(struct kunit *test)
 }
 
 /**
- * dm_test_init_helper_hpd_debounce_disabled - Test the default HPD debounce delay
+ * dm_test_init_helper_hpd_debounce_disabled - Test the HPD debounce delay turned off
  * @test: The KUnit test context
  *
- * With the hdmi_hpd_debounce_delay_ms module parameter left at its default the
- * debounce work is not armed and the delay stays zero.
+ * With the hdmi_hpd_debounce_delay_ms module parameter at 0 (Hades: upstream's
+ * default; Hades' own is 3000 ms) the debounce work is not armed and the delay
+ * stays zero.
  */
 static void dm_test_init_helper_hpd_debounce_disabled(struct kunit *test)
 {
 	struct dm_test_init_helper_ctx *ctx =
 		dm_test_init_helper_ctx_alloc(test, DRM_MODE_CONNECTOR_HDMIA);
+	uint saved = amdgpu_hdmi_hpd_debounce_delay_ms;
 
+	amdgpu_hdmi_hpd_debounce_delay_ms = 0;
 	amdgpu_dm_connector_init_helper(ctx->dm, ctx->aconnector,
 					DRM_MODE_CONNECTOR_HDMIA, ctx->link, 0);
+	amdgpu_hdmi_hpd_debounce_delay_ms = saved;
 
 	KUNIT_EXPECT_EQ(test, ctx->aconnector->hdmi_hpd_debounce_delay_ms, 0);
 }
