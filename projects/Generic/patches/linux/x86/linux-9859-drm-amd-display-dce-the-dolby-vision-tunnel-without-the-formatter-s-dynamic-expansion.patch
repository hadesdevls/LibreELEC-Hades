From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:08:57 +0000
Subject: [PATCH] drm/amd/display: DCE: the Dolby Vision tunnel without the
 formatter's dynamic expansion

On DCE, DC turns the dynamic expansion of the formatter on for every HDMI
and DisplayPort stream of 8 bits or more (dce110_opp_set_dyn_expansion():
8 to 12 bits at 8 bpc), and never off: amdgpu_dm_crc.c asks for it off while
a CRC of the pipe is taken (dc_stream_set_dyn_expansion() with
DYN_EXPANSION_DISABLE), but the DCE formatter function does not read that
request. The tunnel truncates to 8 bits after it (DITHER_OPTION_TRUN8), so by
its registers the expansion gives nothing that reaches the encoder, and the
read back of the pipe (amdgpu_dm_dvbridge_dce_readback_why()) left it
unjudged.

The one DCE card that ran the check of its output with the tunnel, an
RX 550 (Polaris 12, DCE 11.2, issue 20 of LibreELEC Hades), changed the bytes
in red, green and blue while every register that the read back judges was as
the tunnel needs, and the formatter's expansion was on ("expansion 1/1" in
its kernel log). Its LG G3 showed the Dolby Vision logo on a black picture,
and HLG over the tunnel came out green. CroqueMr's build turns the expansion
off during the tunnel on that card ("linux-9970-rx550-native-dv", CB1 #168);
the other two parts of that change are in Hades already (the output CSC in
its hardware bypass, set_default_colors(), and the transfer functions
programmed whatever the update bits say, dce110_program_front_end_for_pipe()).

So a byte tunnel stream now asks for the expansion off
(dc_stream_state.byte_tunnel_no_expansion, set with byte_tunnel by
amdgpu_dm_dvbridge_fill_stream()), and dce110 programs an undefined depth
for it, which leaves FMT_DYNAMIC_EXP_CNTL off, for the pipe and every ODM
pipe of the stream. The read back judges the expansion where the stream
turns it off, and the log line of the read back says what the tunnel did with
it. amdgpu.dvbridge_dce_expansion=1 leaves it on, as 1.0 did, so that the check
of the output (hades-output-check, whose CRC is the judge) can tell the two
apart on the card.

Only DCE reads the field (dce110_hwseq.c, which DCE 11.2 to 12 use), and the
tunnel is offered there only with amdgpu.dvbridge_dce=1: nothing changes for
anyone else. Not tried on hardware.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 36 ++++++++++++++++---
 drivers/gpu/drm/amd/display/dc/core/dc.c      |  1 +
 drivers/gpu/drm/amd/display/dc/dc_hw_types.h  |  2 ++
 drivers/gpu/drm/amd/display/dc/dc_stream.h    |  6 ++++
 .../amd/display/dc/hwss/dce110/dce110_hwseq.c | 28 +++++++++------
 5 files changed, 59 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 5be51c946..4b1525ce9 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1757,6 +1757,26 @@ module_param_named(dvbridge_dce, amdgpu_dm_dvbridge_dce, bool, 0444);
 MODULE_PARM_DESC(dvbridge_dce,
 		 "Offer the Dolby Vision tunnel on DCE 11.2 and 12 (Polaris, Vega) too, which has not been seen to show a picture (default: false)");
 
+/*
+ * Hades: DCE: the dynamic expansion of the formatter (FMT_DYNAMIC_EXP_CNTL) during the tunnel. DC
+ * turns it on for every HDMI and DisplayPort stream of 8 bits or more (dce110_opp_set_dyn_expansion(),
+ * 8 to 12 bits at 8 bpc) and off for none: the request of amdgpu_dm_crc.c to turn it off while a
+ * CRC of the pipe is taken (DYN_EXPANSION_DISABLE) does not reach DCE, whose formatter function does
+ * not read it. The tunnel truncates to 8 bits after it (DITHER_OPTION_TRUN8), so by its registers
+ * the expansion gives nothing that reaches the encoder; but the one card that ran the check of its
+ * output with the tunnel, an RX 550 (DCE 11.2, issue 20), changed the bytes in all three components
+ * while every register that the read back judges was as the tunnel needs, and the expansion of the
+ * formatter was on and not judged. Off during the tunnel by default, as CroqueMr does on that card
+ * (CB1 #168, linux-9970-rx550-native-dv): the bytes go from the truncation to the encoder without
+ * it, and the read back judges it. 1 leaves it on, as 1.0 did, so that the check of the output
+ * (hades-output-check) can tell the two apart. DCE only, and only where amdgpu.dvbridge_dce=1
+ * offers the tunnel at all.
+ */
+static bool amdgpu_dm_dvbridge_dce_expansion;
+module_param_named(dvbridge_dce_expansion, amdgpu_dm_dvbridge_dce_expansion, bool, 0444);
+MODULE_PARM_DESC(dvbridge_dce_expansion,
+		 "DCE: keep the dynamic expansion of the formatter on during the Dolby Vision tunnel, as 1.0 did (default: false: off during the tunnel)");
+
 /* HDMI InfoFrame to DC: header in hb0-hb2, checksum in sb[0], payload after it. */
 static int amdgpu_dm_dvbridge_infopacket(const u8 *buf, ssize_t len,
 					 struct dc_info_packet *out)
@@ -1919,6 +1939,8 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	stream->dither_option = DITHER_OPTION_TRUN8;
 	/* Hades: on DCE, DC programs what it chooses by itself for the bytes (dc_stream.h) */
 	stream->byte_tunnel = true;
+	/* Hades: ... and its formatter without the dynamic expansion (amdgpu.dvbridge_dce_expansion) */
+	stream->byte_tunnel_no_expansion = !amdgpu_dm_dvbridge_dce_expansion;
 	return 0;
 }
 
@@ -2436,8 +2458,9 @@ int amdgpu_dm_dvbridge_check_dce(struct drm_atomic_commit *state, const struct d
  * Hades: DCE: what in a read back of the pipe of a tunnelled stream (dc_stream_read_byte_tunnel())
  * is not as the tunnel needs it, written to buf (true), or false: all of it is. The expected values
  * are those that dce_ipp.c, dce_transform.c and dce_opp.c write for a byte tunnel stream with
- * DITHER_OPTION_TRUN8; the expansion of the line buffer and of the formatter are not judged (the
- * same as without the tunnel; each keeps the 8 most significant bits that are then truncated).
+ * DITHER_OPTION_TRUN8; the expansion of the line buffer is not judged (the same as without the
+ * tunnel; it keeps the 8 most significant bits that are then truncated), and that of the formatter
+ * is where the stream turns it off (amdgpu.dvbridge_dce_expansion, the default) and not otherwise.
  */
 bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *rb, char *buf,
 					 size_t size)
@@ -2504,11 +2527,15 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
 	if (rb->fmt_pixel_encoding)
 		len += scnprintf(buf + len, size - len, "%sformatter pixel encoding %u",
 				 len ? "; " : "", rb->fmt_pixel_encoding);
+	if (rb->no_expansion && rb->fmt_dyn_exp_en)
+		len += scnprintf(buf + len, size - len,
+				 "%sformatter dynamic expansion on (mode %u), which the tunnel turns off",
+				 len ? "; " : "", rb->fmt_dyn_exp_mode);
 	return len != 0;
 }
 
 #define DVBRIDGE_DCE_READBACK_FORMAT \
-	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s"
+	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s; formatter expansion during the tunnel: %s (amdgpu.dvbridge_dce_expansion=%d)"
 #define DVBRIDGE_DCE_READBACK_VALUES(rb, enc) \
 	(rb)->prescale_bypass, (rb)->input_gamma_mode, (rb)->input_csc_mode, \
 	(rb)->input_csc_mode_before, (rb)->degamma_mode, (rb)->gamut_remap_mode, (rb)->regamma_mode, \
@@ -2519,7 +2546,8 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
 	(rb)->fmt_spatial_dither_en, (rb)->fmt_temporal_dither_en, (rb)->fmt_clamp_en, \
 	(rb)->fmt_clamp_color_format, (rb)->fmt_dyn_exp_en, (rb)->fmt_dyn_exp_mode, \
 	(rb)->fmt_pixel_encoding, (enc) ? (enc)->features.max_hdmi_pixel_clock : 0, \
-	(enc) ? str_yes_no((enc)->features.flags.bits.HDMI_6GB_EN) : "unknown"
+	(enc) ? str_yes_no((enc)->features.flags.bits.HDMI_6GB_EN) : "unknown", \
+	(rb)->no_expansion ? "off" : "on", !(rb)->no_expansion
 
 /*
  * Hades: DCE: once each time the tunnel goes on (a modeset of a tunnelled stream), the pipe of the
diff --git a/drivers/gpu/drm/amd/display/dc/core/dc.c b/drivers/gpu/drm/amd/display/dc/core/dc.c
index 4e5dfc0d9..6e011f0fb 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -885,6 +885,7 @@ bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *str
 	int i;
 
 	memset(readback, 0, sizeof(*readback));
+	readback->no_expansion = stream->byte_tunnel && stream->byte_tunnel_no_expansion;
 	for (i = 0; i < MAX_PIPES; i++) {
 		struct pipe_ctx *p = &dc->current_state->res_ctx.pipe_ctx[i];
 
diff --git a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
index f7e6cb726..ec3bb56f0 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
@@ -1341,6 +1341,8 @@ struct dc_byte_tunnel_readback {
 	uint32_t fmt_dyn_exp_en;	/* FMT_DYNAMIC_EXP_CNTL */
 	uint32_t fmt_dyn_exp_mode;
 	uint32_t fmt_pixel_encoding;	/* FMT_CONTROL */
+	/* the stream turns the dynamic expansion off (dc_stream_state.byte_tunnel_no_expansion) */
+	bool no_expansion;
 };
 
 /*
diff --git a/drivers/gpu/drm/amd/display/dc/dc_stream.h b/drivers/gpu/drm/amd/display/dc/dc_stream.h
index f898eed1e..2a164ffd6 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_stream.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_stream.h
@@ -245,6 +245,12 @@ struct dc_stream_state {
 	 * with a modeset.
 	 */
 	bool byte_tunnel;
+	/*
+	 * Hades: DCE: the formatter of a byte tunnel stream without its dynamic expansion
+	 * (FMT_DYNAMIC_EXP_CNTL off, dce110_hwseq.c). Set with byte_tunnel, by
+	 * amdgpu_dm_dvbridge_fill_stream(), unless amdgpu.dvbridge_dce_expansion=1.
+	 */
+	bool byte_tunnel_no_expansion;
 
 	enum view_3d_format view_format;
 
diff --git a/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c b/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
index bd25ddcc5..e5096aa2e 100644
--- a/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
+++ b/drivers/gpu/drm/amd/display/dc/hwss/dce110/dce110_hwseq.c
@@ -1642,6 +1642,22 @@ static void program_scaler(const struct dc *dc,
 		&pipe_ctx->plane_res.scl_data);
 }
 
+/*
+ * Hades: the dynamic expansion of the formatter of a stream (FMT_DYNAMIC_EXP_CNTL), as DC sets it
+ * for its depth, except for a byte tunnel that asks for it off (dc_stream_state.byte_tunnel_no_expansion):
+ * an undefined depth leaves it off (dce110_opp_set_dyn_expansion() turns it off first, and on for
+ * the depths that it knows only)
+ */
+static void dce110_set_stream_dyn_expansion(struct output_pixel_processor *opp,
+					    const struct dc_stream_state *stream)
+{
+	enum dc_color_depth depth = stream->timing.display_color_depth;
+
+	if (stream->byte_tunnel && stream->byte_tunnel_no_expansion)
+		depth = COLOR_DEPTH_UNDEFINED;
+	opp->funcs->opp_set_dyn_expansion(opp, COLOR_SPACE_YCBCR601, depth, stream->signal);
+}
+
 static enum dc_status dce110_enable_stream_timing(
 		struct pipe_ctx *pipe_ctx,
 		struct dc_state *context,
@@ -1757,18 +1773,10 @@ enum dc_status dce110_apply_single_controller_ctx_to_hw(
 		&stream->bit_depth_params,
 		&stream->clamping);
 
-	pipe_ctx->stream_res.opp->funcs->opp_set_dyn_expansion(
-			pipe_ctx->stream_res.opp,
-			COLOR_SPACE_YCBCR601,
-			stream->timing.display_color_depth,
-			stream->signal);
+	dce110_set_stream_dyn_expansion(pipe_ctx->stream_res.opp, stream);
 
 	while (odm_pipe) {
-		odm_pipe->stream_res.opp->funcs->opp_set_dyn_expansion(
-				odm_pipe->stream_res.opp,
-				COLOR_SPACE_YCBCR601,
-				stream->timing.display_color_depth,
-				stream->signal);
+		dce110_set_stream_dyn_expansion(odm_pipe->stream_res.opp, stream);
 
 		odm_pipe->stream_res.opp->funcs->opp_program_fmt(
 				odm_pipe->stream_res.opp,
-- 
