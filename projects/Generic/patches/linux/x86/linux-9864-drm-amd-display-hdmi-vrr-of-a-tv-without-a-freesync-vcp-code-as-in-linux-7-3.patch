From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:24:48 +0000
Subject: [PATCH] drm/amd/display: HDMI VRR of a TV without a FreeSync VCP
 code, as in Linux 7.3 (amdgpu.freesync_hdmi_vcp)

Linux 7.4 clears freesync_capable for a native HDMI sink whose EDID has
no FreeSync MCCS VCP code (e4dca268eea6, "Restore FreeSync VCP code
check for HDMI/PCON sinks"). TVs have no MCCS and no VCP code: a TV with
FreeSync Premium has an AMD VSDB with its range and VCP code 0, and a TV
with HDMI 2.1 VRR declares it in the HF-VSDB, which Linux 7.4 reads as a
fallback (fa3389c71379) just above the check, so the check undoes that
too. amdgpu_dm_update_freesync_caps() then reports such a TV as not VRR
capable, and Kodi's playback at the video's own rate with the TV's VRR
(off by default) cannot be used on AMD graphics. Linux 7.3 did not look
at the VCP code there.

A module parameter, amdgpu.freesync_hdmi_vcp: 0 (the default) does not
ask for the VCP code on native HDMI, as in Linux 7.3; 1 is upstream's
check. A PCON in the whitelist and the MCCS handling are upstream's
either way. Where the default keeps a sink VRR capable that upstream
would not, the kernel log says so once per detection, with the range.
The parameter has the name and the meaning that YBLOD's build gives it.

KUnit (amdgpu_dm_connector_test.c): an HDMI sink whose EDID has an HDMI
Forum VSDB with VRR from 40 to 120 Hz and no VCP code is VRR capable
from 40 to 120 Hz with the default and not capable with 1. Without this
change the first case fails.

Not tried on hardware.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu.h           |  1 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c       | 14 +++++
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 18 +++++-
 .../tests/amdgpu_dm_connector_test.c          | 59 +++++++++++++++++++
 4 files changed, 90 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu.h b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
index c7577b608f3e..b449f56448d0 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
@@ -201,6 +201,7 @@ extern int amdgpu_emu_mode;
 extern uint amdgpu_smu_memory_pool_size;
 extern int amdgpu_smu_pptable_id;
 extern uint amdgpu_dc_feature_mask;
+extern int amdgpu_freesync_hdmi_vcp; /* Hades */
 extern uint amdgpu_freesync_vid_mode;
 extern uint amdgpu_dc_debug_mask;
 extern uint amdgpu_dc_visual_confirm;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 6e96dfda306d..c8baa316f2f4 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -223,6 +223,8 @@ int amdgpu_smu_pptable_id = -1;
  */
 uint amdgpu_dc_feature_mask = DC_MULTI_MON_PP_MCLK_SWITCH_MASK | DC_FRL_MASK;
 uint amdgpu_dc_debug_mask;
+/* Hades: see the DOC of freesync_hdmi_vcp below */
+int amdgpu_freesync_hdmi_vcp;
 uint amdgpu_dc_visual_confirm;
 int amdgpu_async_gfx_ring = 1;
 int amdgpu_mcbp = -1;
@@ -901,6 +903,18 @@ MODULE_PARM_DESC(pcie_p2p, "Enable PCIe P2P (requires large-BAR). (N = off, Y =
 MODULE_PARM_DESC(dcfeaturemask, "all stable DC features enabled (default))");
 module_param_named(dcfeaturemask, amdgpu_dc_feature_mask, uint, 0444);
 
+/**
+ * DOC: freesync_hdmi_vcp (int)
+ * Hades: whether a native HDMI sink needs the FreeSync MCCS VCP code in its EDID to be called
+ * FreeSync/VRR capable, as Linux 7.4 asks (e4dca268eea6). TVs have no MCCS and no VCP code: an LG
+ * TV with FreeSync Premium has an AMD VSDB with its range and VCP code 0, and the check would also
+ * undo the HDMI 2.1 VRR that the HF-VSDB declares. 0 (the default): not needed on native HDMI, as
+ * in Linux 7.3. 1: needed, as upstream. A PCON in the whitelist and MCCS are upstream's either way.
+ */
+MODULE_PARM_DESC(freesync_hdmi_vcp,
+	"Need the FreeSync VCP code in the EDID of a native HDMI sink for FreeSync/VRR (0 = no, the default, as in Linux 7.3; 1 = yes, as upstream)");
+module_param_named(freesync_hdmi_vcp, amdgpu_freesync_hdmi_vcp, int, 0444);
+
 /**
  * DOC: dcdebugmask (uint)
  * Display debug options. See enum DC_DEBUG_MASK in drivers/gpu/drm/amd/include/amd_shared.h.
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index fd91324d6376..ae001c53901a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -6336,8 +6336,22 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 			amdgpu_dm_connector->min_vfreq;
 	}
 
-	/* HDMI/PCON without an EDID FreeSync VCP code is not FreeSync-capable. */
-	if ((sink->sink_signal == SIGNAL_TYPE_HDMI_TYPE_A ||
+	/*
+	 * HDMI/PCON without an EDID FreeSync VCP code is not FreeSync-capable.
+	 *
+	 * Hades: on native HDMI only with amdgpu.freesync_hdmi_vcp=1. A TV has no MCCS and no VCP
+	 * code, and its VRR (an AMD VSDB with a range, or the HDMI 2.1 VRR of the HF-VSDB above)
+	 * worked in Linux 7.3, which did not look at the VCP code here. The kernel log says when
+	 * this keeps a sink VRR capable that upstream would not.
+	 */
+	if (freesync_capable && !sink->edid_caps.freesync_vcp_code &&
+	    sink->sink_signal == SIGNAL_TYPE_HDMI_TYPE_A &&
+	    as_type != FREESYNC_TYPE_PCON_IN_WHITELIST && !amdgpu_freesync_hdmi_vcp)
+		drm_info(adev_to_drm(adev),
+			 "%s: HDMI sink without a FreeSync VCP code in its EDID: VRR %d to %d Hz kept (amdgpu.freesync_hdmi_vcp=0)\n",
+			 connector->name, amdgpu_dm_connector->min_vfreq,
+			 amdgpu_dm_connector->max_vfreq);
+	if (((sink->sink_signal == SIGNAL_TYPE_HDMI_TYPE_A && amdgpu_freesync_hdmi_vcp) ||
 	     as_type == FREESYNC_TYPE_PCON_IN_WHITELIST) &&
 	    !sink->edid_caps.freesync_vcp_code)
 		freesync_capable = false;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
index 9f3d621d464a..f66967fad730 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_connector_test.c
@@ -10112,6 +10112,62 @@ static void dm_test_fs_caps_edp_replay_mode(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, (int)ctx->aconnector->as_type, (int)ADAPTIVE_SYNC_TYPE_EDP);
 }
 
+/*
+ * Hades: an HDMI Forum VSDB whose gaming bytes declare VRR from @vrr_min to @vrr_max Hz
+ * (drm_parse_hdmi_gaming_info()), as a TV's EDID has it, without an AMD VSDB or a FreeSync VCP code.
+ */
+static const struct drm_edid *
+dm_test_fs_edid_hf_vsdb_vrr(struct kunit *test, u8 vrr_min, u16 vrr_max)
+{
+	u8 ext[EDID_LENGTH] = {0};
+
+	ext[0] = DM_TEST_CEA_EXT;
+	ext[1] = 3;
+	ext[2] = 4 + 1 + 10;
+	ext[4] = (3 << 5) | 10;		/* vendor data block, 10-byte payload */
+	ext[5] = 0xd8;			/* HDMI Forum IEEE OUI, LSB first */
+	ext[6] = 0x5d;
+	ext[7] = 0xc4;
+	ext[8] = 0x01;			/* version */
+	ext[13] = (vrr_min & DRM_EDID_VRR_MIN_MASK) | ((vrr_max >> 8) << 6);
+	ext[14] = vrr_max & 0xff;
+
+	return dm_test_fs_edid_alloc(test, ext);
+}
+
+static void dm_test_fs_caps_hdmi_vrr_no_vcp(struct kunit *test, int require_vcp, bool capable)
+{
+	struct dm_test_fs_caps_ctx *ctx =
+		dm_test_fs_caps_ctx_alloc(test, SIGNAL_TYPE_HDMI_TYPE_A);
+	const struct drm_edid *drm_edid = dm_test_fs_edid_hf_vsdb_vrr(test, 40, 120);
+	int saved = amdgpu_freesync_hdmi_vcp;
+
+	amdgpu_freesync_hdmi_vcp = require_vcp;
+	amdgpu_dm_update_freesync_caps(&ctx->aconnector->base, drm_edid, false);
+	amdgpu_freesync_hdmi_vcp = saved;
+
+	/* the EDID reached the HF-VSDB fallback as intended */
+	KUNIT_ASSERT_TRUE(test, ctx->aconnector->base.display_info.hdmi.vrr_cap.supported);
+	KUNIT_EXPECT_EQ(test, ctx->sink->edid_caps.freesync_vcp_code, 0);
+	KUNIT_EXPECT_EQ(test, dm_test_fs_caps_capable(ctx), capable);
+	if (capable) {
+		KUNIT_EXPECT_EQ(test, ctx->aconnector->min_vfreq, 40);
+		KUNIT_EXPECT_EQ(test, ctx->aconnector->max_vfreq, 120);
+	}
+}
+
+/* Hades: by default a TV keeps its HDMI VRR without a VCP code, as in Linux 7.3 */
+static void dm_test_fs_caps_hdmi_vrr_no_vcp_kept(struct kunit *test)
+{
+	dm_test_fs_caps_hdmi_vrr_no_vcp(test, 0, true);
+}
+
+/* Hades: amdgpu.freesync_hdmi_vcp=1 is upstream's check */
+static void dm_test_fs_caps_hdmi_vrr_no_vcp_upstream(struct kunit *test)
+{
+	dm_test_fs_caps_hdmi_vrr_no_vcp(test, 1, false);
+}
+
 /**
  * dm_test_fs_caps_hdmi_no_vsdb - Test an HDMI sink with no AMD VSDB
  * @test: The KUnit test context
@@ -10937,6 +10993,9 @@ static struct kunit_case amdgpu_dm_connector_tests[] = {
 	KUNIT_CASE(dm_test_fs_caps_dp_msa_not_allowed),
 	KUNIT_CASE(dm_test_fs_caps_edp_replay_mode),
 	KUNIT_CASE(dm_test_fs_caps_hdmi_no_vsdb),
+	/* Hades: amdgpu.freesync_hdmi_vcp */
+	KUNIT_CASE(dm_test_fs_caps_hdmi_vrr_no_vcp_kept),
+	KUNIT_CASE(dm_test_fs_caps_hdmi_vrr_no_vcp_upstream),
 	KUNIT_CASE(dm_test_fs_caps_force_min_hz_quirk),
 	KUNIT_CASE(dm_test_fs_caps_mccs_clears_capability),
 	KUNIT_CASE(dm_test_fs_caps_disables_replay),
