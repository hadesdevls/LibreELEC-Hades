From 7091a1a97cab79df7a777b9b5ac2aca9df4853d9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:01:49 +0000
Subject: [PATCH] drm/amd/display: BT.2020 in the AVI InfoFrame of the
 Dolby Vision tunnel, as a connector property

DVBRIDGE_DV_AVI_BT2020_LAB, a connector property next to
DVBRIDGE_DV_HDMI14B_LAB and with its rules (the connectors where the
tunnel is offered, the dvbridge parameter, dropped with the CRTC and for
the console, a change with the tunnel on is a full modeset, and a change
of the stream's packets for amdgpu_dm_dvbridge_toggled()): with
DVBRIDGE_DV_STANDARD_LAB, amdgpu_dm_dvbridge_fill_stream() makes the AVI
InfoFrame of the tunnel with the extended colorimetry BT.2020
(drm_dvbridge_tunnel_avi_bt2020()), as licensed players send it. The
connector's "Colorspace" stays Default (the tunnel refuses another), so
the output colour space of the stream, and every byte of the tunnel, is
as before. Low-Latency and HDR over the tunnel set their own colorimetry
after it.

Why: to compare on a display what a licensed player sends with what
Hades sends. With the property 0 (its default) nothing changes. No new
warnings with the flags of the build.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |  6 ++++
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |  2 ++
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  6 ++++
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 31 +++++++++++++++++++
 4 files changed, 45 insertions(+)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index 9f2fbc8..3b52d05 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -1647,6 +1647,12 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 					 "DVBRIDGE_DV_HDMI14B_LAB");
 	if (!adev->mode_info.dvbridge_dv_hdmi14b_property)
 		return -ENOMEM;
+	/* Hades: BT.2020 in the AVI InfoFrame of that tunnel (drm_dvbridge.h) */
+	adev->mode_info.dvbridge_dv_avi_bt2020_property =
+		drm_property_create_bool(adev_to_drm(adev), DRM_MODE_PROP_ATOMIC,
+					 "DVBRIDGE_DV_AVI_BT2020_LAB");
+	if (!adev->mode_info.dvbridge_dv_avi_bt2020_property)
+		return -ENOMEM;
 	/* Hades: HDR over that tunnel, as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
 	adev->mode_info.dvbridge_hdr10t_property =
 		drm_property_create_bool(adev_to_drm(adev), DRM_MODE_PROP_ATOMIC,
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index dd686b9..972e524 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -334,6 +334,8 @@ struct amdgpu_mode_info {
 	struct drm_property *dvbridge_dv_low_latency_property;
 	/* Hades: the HDMI 1.4b signal of that tunnel (drm_dvbridge.h) */
 	struct drm_property *dvbridge_dv_hdmi14b_property;
+	/* Hades: BT.2020 in the AVI InfoFrame of that tunnel (drm_dvbridge.h) */
+	struct drm_property *dvbridge_dv_avi_bt2020_property;
 	/* Hades: HDR sent over that tunnel as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
 	struct drm_property *dvbridge_hdr10t_property;
 	/*
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index f7ef1eb..465a8c7 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1125,6 +1125,12 @@ struct dm_connector_state {
 	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
 	 */
 	bool dvbridge_dv_hdmi14b;
+	/*
+	 * Hades: DVBRIDGE_DV_AVI_BT2020_LAB: with the tunnel requested, its AVI InfoFrame says the
+	 * extended colorimetry BT.2020, as licensed players send it (drm_dvbridge.h); without it, no
+	 * colorimetry
+	 */
+	bool dvbridge_dv_avi_bt2020;
 	/*
 	 * Hades: DVBRIDGE_HDR10_TUNNEL_LAB: with the tunnel requested, it carries HDR as YCbCr 4:2:2
 	 * at 12 bits (drm_dvbridge_hdr10t.h); without it, nothing
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index f5afdf1..172bb24 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1885,6 +1885,9 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 		return ret;
 	drm_hdmi_avi_infoframe_content_type(&avi, con_state);
 	drm_dvbridge_tunnel_avi(&avi, vic);
+	/* Hades: ... with BT.2020, where asked for (drm_dvbridge.h) */
+	if (to_dm_connector_state(con_state)->dvbridge_dv_avi_bt2020)
+		drm_dvbridge_tunnel_avi_bt2020(&avi);
 	/* Hades: what the sink's Low-Latency input reads the same bytes as (drm_dvbridge_ll.h) */
 	if (low_latency)
 		drm_dvbridge_ll_avi(&avi);
@@ -2288,6 +2291,11 @@ bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct drm_crtc
 		    to_dm_connector_state(old_con_state)->dvbridge_dv_hdmi14b !=
 		    to_dm_connector_state(new_con_state)->dvbridge_dv_hdmi14b)
 			return true;
+		/* Hades: ... and BT.2020 in the AVI InfoFrame of the tunnel (drm_dvbridge.h) */
+		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
+		    to_dm_connector_state(old_con_state)->dvbridge_dv_avi_bt2020 !=
+		    to_dm_connector_state(new_con_state)->dvbridge_dv_avi_bt2020)
+			return true;
 		/* Hades: ... and HDR over the tunnel (drm_dvbridge_hdr10t.h) */
 		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
 		    to_dm_connector_state(old_con_state)->dvbridge_hdr10t !=
@@ -3646,6 +3654,14 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EOPNOTSUPP;
 		dm_new_state->dvbridge_dv_hdmi14b = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_avi_bt2020_property) {
+		/* Hades: BT.2020 in the AVI InfoFrame of the tunnel (drm_dvbridge.h) */
+		if (val > 1 || !amdgpu_dm_dvbridge_connector(connector))
+			return -EINVAL;
+		if (val && !amdgpu_dm_dvbridge)
+			return -EOPNOTSUPP;
+		dm_new_state->dvbridge_dv_avi_bt2020 = val;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10t_property) {
 		/* Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) */
 		if (val > 1 || !amdgpu_dm_dvbridge_connector(connector))
@@ -3730,6 +3746,9 @@ int amdgpu_dm_connector_atomic_get_property(struct drm_connector *connector,
 	} else if (property == adev->mode_info.dvbridge_dv_hdmi14b_property) {
 		*val = dm_state->dvbridge_dv_hdmi14b;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_avi_bt2020_property) {
+		*val = dm_state->dvbridge_dv_avi_bt2020;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10t_property) {
 		*val = dm_state->dvbridge_hdr10t;
 		ret = 0;
@@ -3960,6 +3979,8 @@ static void amdgpu_dm_connector_client_restore(struct drm_connector *connector,
 	s->dvbridge_dv_low_latency = false;
 	/* (Hades: the HDMI 1.4b signal goes with the tunnel, which the line above names) */
 	s->dvbridge_dv_hdmi14b = false;
+	/* (Hades: ... and BT.2020 in its AVI InfoFrame) */
+	s->dvbridge_dv_avi_bt2020 = false;
 	/* (Hades: ... and HDR over it) */
 	s->dvbridge_hdr10t = false;
 	s->dvbridge_hdr10_deep_color = false;
@@ -4711,6 +4732,8 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 		dm_new_con_state->dvbridge_dv_low_latency = false;
 		/* Hades: ... and its HDMI 1.4b signal */
 		dm_new_con_state->dvbridge_dv_hdmi14b = false;
+		/* Hades: ... and BT.2020 in its AVI InfoFrame */
+		dm_new_con_state->dvbridge_dv_avi_bt2020 = false;
 		/* Hades: ... and HDR over it */
 		dm_new_con_state->dvbridge_hdr10t = false;
 		/* Hades: ... and the HDR10 depth guard */
@@ -4727,6 +4750,9 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	     dm_new_con_state->dvbridge_dv_low_latency != dm_old_con_state->dvbridge_dv_low_latency) ||
 	    (dm_new_con_state->dvbridge_dv_standard &&
 	     dm_new_con_state->dvbridge_dv_hdmi14b != dm_old_con_state->dvbridge_dv_hdmi14b) ||
+	    /* Hades: ... and BT.2020 in the AVI InfoFrame of the tunnel or back */
+	    (dm_new_con_state->dvbridge_dv_standard &&
+	     dm_new_con_state->dvbridge_dv_avi_bt2020 != dm_old_con_state->dvbridge_dv_avi_bt2020) ||
 	    /* Hades: ... and HDR over the tunnel or back: other InfoFrames and another format */
 	    (dm_new_con_state->dvbridge_dv_standard &&
 	     dm_new_con_state->dvbridge_hdr10t != dm_old_con_state->dvbridge_hdr10t)) {
@@ -5545,6 +5571,11 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 			drm_object_attach_property(&aconnector->base.base,
 						   adev->mode_info.dvbridge_dv_hdmi14b_property,
 						   0);
+		/* Hades: BT.2020 in the AVI InfoFrame of the same tunnel (drm_dvbridge.h) */
+		if (adev->mode_info.dvbridge_dv_avi_bt2020_property)
+			drm_object_attach_property(&aconnector->base.base,
+						   adev->mode_info.dvbridge_dv_avi_bt2020_property,
+						   0);
 		/* Hades: HDR over the same tunnel, as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h) */
 		if (adev->mode_info.dvbridge_hdr10t_property)
 			drm_object_attach_property(&aconnector->base.base,
-- 
2.53.0

