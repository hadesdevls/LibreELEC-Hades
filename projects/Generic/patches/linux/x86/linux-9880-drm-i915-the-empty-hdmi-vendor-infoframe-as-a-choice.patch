+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -132,6 +132,7 @@
 #include "skl_universal_plane.h"
 #include "skl_watermark.h"
 #include "intel_hdr10plus.h"
+#include "intel_hdmi_vsif.h"
 #include "vlv_dsi.h"
 #include "vlv_dsi_pll.h"
 #include "vlv_dsi_regs.h"
@@ -5613,6 +5614,21 @@ intel_pipe_config_compare(const struct intel_crtc_state *current_config,
 	if (current_config->vrr.enable || pipe_config->vrr.enable)
 		exclude_infoframes |= intel_hdmi_infoframe_enable(DP_SDP_ADAPTIVE_SYNC);
 
+	/*
+	 * Hades: i915.hdmi_empty_vsif: the start and the end of HDR10+ within a mode turn the
+	 * vendor DIP on and off where no empty HDMI vendor InfoFrame is under it
+	 * (intel_hdmi_vsif.h)
+	 */
+	if (fastset) {
+		const bool old10 = intel_hdr10plus_active(current_config->infoframes.hdr10plus);
+		const bool new10 = intel_hdr10plus_active(pipe_config->infoframes.hdr10plus);
+
