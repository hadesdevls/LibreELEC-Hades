diff --git a/drivers/gpu/drm/tests/drm_hdmi_vsif_test.c b/drivers/gpu/drm/tests/drm_hdmi_vsif_test.c
new file mode 100644
index 000000000..dd03f0c28
--- /dev/null
+++ b/drivers/gpu/drm/tests/drm_hdmi_vsif_test.c
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Hades: KUnit tests of intel_hdmi_vsif.h, i915.hdmi_empty_vsif (issue #28): what becomes of an
+ * HDMI vendor InfoFrame that carries neither an HDMI VIC nor 3D in each case, a run of modes as
+ * issue #28 and a 3D film make them, and the fastsets that may turn the vendor DIP on and off for
+ * HDR10+.
+ */
+#include <kunit/test.h>
+
+#include "../i915/display/intel_hdmi_vsif.h"
+
+/* on (the default, as upstream): sent, whatever is on the screen */
+static void drm_test_hdmi_vsif_on(struct kunit *test)
+{
+	unsigned int i;
+
+	for (i = 0; i < 8; i++)
+		KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(true, i & 1, i & 2, i & 4),
+				INTEL_HDMI_EMPTY_VSIF_SENT);
+}
+
+/* off: a new mode drops it, but after 3D; the same mode keeps what is on the screen */
+static void drm_test_hdmi_vsif_off(struct kunit *test)
+{
+	/* a new mode after a 2D one (issue #28: 2160p60 after 2160p30) */
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, false, true, false),
+			INTEL_HDMI_EMPTY_VSIF_NOT_SENT);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, false, false, false),
+			INTEL_HDMI_EMPTY_VSIF_NOT_SENT);
+	/* a new mode after a 3D one (HDMI 2.0 Appendix F) */
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, false, false, true),
+			INTEL_HDMI_EMPTY_VSIF_AFTER_3D);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, false, true, true),
+			INTEL_HDMI_EMPTY_VSIF_AFTER_3D);
+	/* the same mode: as it is on the screen */
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, true, true, false),
+			INTEL_HDMI_EMPTY_VSIF_KEPT);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, true, false, false),
+			INTEL_HDMI_EMPTY_VSIF_KEPT_OFF);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, true, true, true),
+			INTEL_HDMI_EMPTY_VSIF_KEPT);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_empty_vsif_of(false, true, false, true),
+			INTEL_HDMI_EMPTY_VSIF_KEPT_OFF);
+}
+
+static void drm_test_hdmi_vsif_dropped(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_empty_vsif_dropped(INTEL_HDMI_EMPTY_VSIF_SENT));
+	KUNIT_EXPECT_TRUE(test, intel_hdmi_empty_vsif_dropped(INTEL_HDMI_EMPTY_VSIF_NOT_SENT));
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_empty_vsif_dropped(INTEL_HDMI_EMPTY_VSIF_AFTER_3D));
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_empty_vsif_dropped(INTEL_HDMI_EMPTY_VSIF_KEPT));
+	KUNIT_EXPECT_TRUE(test, intel_hdmi_empty_vsif_dropped(INTEL_HDMI_EMPTY_VSIF_KEPT_OFF));
+}
+
+/* a commit, as intel_hdmi_compute_hdmi_infoframe() sees it */
+struct vsif_step {
+	const char *what;
+	int mode;		/* the mode: the same number is the same mode */
+	bool hdmi_vic;		/* the mode has an HDMI VIC (2160p24, 25, 30) */
+	bool s3d;		/* the mode is 3D */
+	bool on_param;		/* the vendor DIP is on with the parameter on */
+	bool on_off;		/* ... and with it off */
+};
+
+/*
+ * The vendor DIP through a run of commits, as the driver decides it from the configuration on the
+ * screen: 2160p30 (an HDMI VIC), the menus at 2160p60 (issue #28), a commit that keeps that mode
+ * (HDR metadata, a colour property), a 3D film at 1080p24 with frame packing, the menus at 1080p60
+ * after it and a commit that keeps that, then 2160p60 again
+ */
+static void drm_test_hdmi_vsif_run(struct kunit *test)
+{
+	static const struct vsif_step steps[] = {
+		{ "2160p30 (HDMI VIC 1)",		1, true,  false, true, true },
+		{ "menus at 2160p60",		2, false, false, true, false },
+		{ "the same mode",		2, false, false, true, false },
+		{ "1080p24 3D",			3, false, true,  true, true },
+		{ "menus at 1080p60 after 3D",	4, false, false, true, true },
+		{ "the same mode",		4, false, false, true, true },
+		{ "2160p60 again",		2, false, false, true, false },
+	};
+	int p;
+
+	for (p = 0; p < 2; p++) {
+		const bool param = !p;
+		bool active = false, old_dropped = false, old_3d = false, old_decided = false;
+		int old_mode = 0;
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(steps); i++) {
+			const struct vsif_step *s = &steps[i];
+			const bool empty = !s->hdmi_vic && !s->s3d;
+			const bool same = active && old_decided && old_mode == s->mode;
+			bool dropped = false, on;
+
+			if (empty)
+				dropped = intel_hdmi_empty_vsif_dropped(
+					intel_hdmi_empty_vsif_of(param, same, !old_dropped,
+								 active && old_3d));
+			on = !dropped;
+			KUNIT_EXPECT_EQ_MSG(test, on, param ? s->on_param : s->on_off,
+					    "%s, parameter %s", s->what, param ? "on" : "off");
+			active = true;
+			old_decided = true;
+			old_mode = s->mode;
+			old_dropped = dropped;
+			old_3d = s->s3d;
+		}
+	}
+}
+
+/* fastsets that turn the vendor DIP on or off: HDR10+ that starts or ends with nothing under it */
+static void drm_test_hdmi_vsif_fastset(struct kunit *test)
+{
+	unsigned int i;
+
+	for (i = 0; i < 16; i++) {
+		const bool old10 = i & 1, old_dropped = i & 2, new10 = i & 4, new_dropped = i & 8;
+		const bool want = (old10 && !new10 && new_dropped) ||
+				  (new10 && !old10 && old_dropped);
+		const bool got = intel_hdmi_vsif_fastset_vendor(old10, old_dropped, new10,
+								new_dropped);
+
+		KUNIT_EXPECT_EQ_MSG(test, got, want,
+				    "old HDR10+ %d dropped %d, new HDR10+ %d dropped %d",
+				    old10, old_dropped, new10, new_dropped);
+	}
+	/* with the parameter on nothing is dropped: no fastset turns the DIP on or off */
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_vsif_fastset_vendor(true, false, false, false));
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_vsif_fastset_vendor(false, false, true, false));
+	/* HDR10+ from one scene to the next keeps the DIP on */
+	KUNIT_EXPECT_FALSE(test, intel_hdmi_vsif_fastset_vendor(true, true, true, true));
+	/* the start and the end of HDR10+ where the parameter dropped the empty InfoFrame */
+	KUNIT_EXPECT_TRUE(test, intel_hdmi_vsif_fastset_vendor(false, true, true, true));
+	KUNIT_EXPECT_TRUE(test, intel_hdmi_vsif_fastset_vendor(true, true, false, true));
+}
+
+static struct kunit_case drm_hdmi_vsif_tests[] = {
+	KUNIT_CASE(drm_test_hdmi_vsif_on),
+	KUNIT_CASE(drm_test_hdmi_vsif_off),
+	KUNIT_CASE(drm_test_hdmi_vsif_dropped),
+	KUNIT_CASE(drm_test_hdmi_vsif_run),
+	KUNIT_CASE(drm_test_hdmi_vsif_fastset),
+	{ }
+};
+
+static struct kunit_suite drm_hdmi_vsif_test_suite = {
+	.name = "drm_hdmi_vsif",
+	.test_cases = drm_hdmi_vsif_tests,
+};
+
+kunit_test_suite(drm_hdmi_vsif_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests of i915.hdmi_empty_vsif (Hades)");
+MODULE_LICENSE("Dual MIT/GPL");
