diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index ba18716b9..25710e4ef 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -70,6 +70,7 @@
 #include "intel_hdmi.h"
 #include "intel_hdr10plus.h"
 #include "intel_hdmi_gmp_hdr.h"
+#include "intel_hdmi_vsif.h"
 #include "intel_link_bw.h"
 #include "intel_lspcon.h"
 #include "intel_panel.h"
@@ -1248,6 +1249,72 @@ intel_hdmi_compute_spd_infoframe(struct intel_encoder *encoder,
 	return true;
 }
 
+/*
+ * Hades: the HDMI vendor InfoFrame where it carries neither an HDMI VIC nor 3D (intel_hdmi_vsif.h):
+ * sent, as upstream, by default
+ */
+static bool hdmi_empty_vsif = true;
+module_param(hdmi_empty_vsif, bool, 0644);
+MODULE_PARM_DESC(hdmi_empty_vsif,
+	"HDMI: send the HDMI vendor InfoFrame also where it carries neither an HDMI VIC nor 3D "
+	"(default true, as upstream; false: only with an HDMI VIC or 3D, and in the mode after a 3D "
+	"one; applies from the next mode change)");
+
+/* Hades: what becomes of the empty HDMI vendor InfoFrame here (intel_hdmi_vsif.h) */
+static enum intel_hdmi_empty_vsif
+intel_hdmi_empty_vsif(const struct intel_crtc_state *crtc_state)
+{
+	struct intel_atomic_state *state = crtc_state->uapi.state ?
+		to_intel_atomic_state(crtc_state->uapi.state) : NULL;
+	const bool sends = READ_ONCE(hdmi_empty_vsif);
+	const struct intel_crtc_state *old = NULL;
+	bool same_mode;
+
+	if (state && crtc_state->uapi.crtc)
+		old = intel_atomic_get_old_crtc_state(state, to_intel_crtc(crtc_state->uapi.crtc));
+	if (!old || !old->hw.active)
+		return intel_hdmi_empty_vsif_of(sends, false, false, false);
+	same_mode = old->hdmi_vsif_decided &&
+		    drm_mode_equal(&old->hw.adjusted_mode, &crtc_state->hw.adjusted_mode);
+	return intel_hdmi_empty_vsif_of(sends, same_mode, !old->hdmi_vsif_dropped,
+					old->hw.adjusted_mode.flags & DRM_MODE_FLAG_3D_MASK);
+}
+
+/*
+ * Hades: the kernel log says a decision of i915.hdmi_empty_vsif=0 for a new mode once (the atomic
+ * check runs it for every commit that recomputes the configuration, test commits among them)
+ */
+static void intel_hdmi_empty_vsif_log(struct intel_connector *connector,
+				      const struct intel_crtc_state *crtc_state,
+				      enum intel_hdmi_empty_vsif what)
+{
+	struct intel_display *display = to_intel_display(connector);
+	const struct drm_display_mode *mode = &crtc_state->hw.adjusted_mode;
+
+	if (what != INTEL_HDMI_EMPTY_VSIF_NOT_SENT && what != INTEL_HDMI_EMPTY_VSIF_AFTER_3D)
+		return;
+	if (connector->hdmi_vsif_said.what == what &&
+	    connector->hdmi_vsif_said.clock == mode->clock &&
+	    connector->hdmi_vsif_said.hdisplay == mode->hdisplay &&
+	    connector->hdmi_vsif_said.vdisplay == mode->vdisplay &&
+	    connector->hdmi_vsif_said.vtotal == mode->vtotal &&
+	    connector->hdmi_vsif_said.flags == mode->flags)
+		return;
+	connector->hdmi_vsif_said.what = what;
+	connector->hdmi_vsif_said.clock = mode->clock;
+	connector->hdmi_vsif_said.hdisplay = mode->hdisplay;
+	connector->hdmi_vsif_said.vdisplay = mode->vdisplay;
+	connector->hdmi_vsif_said.vtotal = mode->vtotal;
+	connector->hdmi_vsif_said.flags = mode->flags;
+	drm_info(display->drm,
+		 "Hades: [CONNECTOR:%d:%s] %dx%d@%d: the HDMI vendor InfoFrame would carry neither an HDMI VIC nor 3D: %s (%s.hdmi_empty_vsif=0)\n",
+		 connector->base.base.id, connector->base.name, mode->hdisplay, mode->vdisplay,
+		 drm_mode_vrefresh(mode),
+		 what == INTEL_HDMI_EMPTY_VSIF_NOT_SENT ? "not sent" :
+		 "sent empty for as long as this mode lasts, as it follows a 3D one (HDMI 2.0 Appendix F)",
+		 KBUILD_MODNAME);
+}
+
 static bool
 intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 				  struct intel_crtc_state *crtc_state,
@@ -1326,6 +1393,16 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 	if (drm_WARN_ON(encoder->base.dev, ret))
 		return false;
 
+	/* Hades: i915.hdmi_empty_vsif, decided here for this configuration (intel_hdmi_vsif.h) */
+	crtc_state->hdmi_vsif_decided = true;
+	if (intel_hdr10plus_vsi_empty(frame)) {
+		const enum intel_hdmi_empty_vsif what = intel_hdmi_empty_vsif(crtc_state);
+
+		crtc_state->hdmi_vsif_dropped = intel_hdmi_empty_vsif_dropped(what);
+		intel_hdmi_empty_vsif_log(to_intel_connector(conn_state->connector),
+					  crtc_state, what);
+	}
+
 	/* Hades: HDR10PLUS_VSIF (intel_hdr10plus.h) */
 	if (conn_state->hdr10plus_vsif) {
 		const struct drm_property_blob *blob = conn_state->hdr10plus_vsif;
@@ -1354,6 +1431,13 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 			return false;
 	}
 
+	/* Hades: ... and then no vendor InfoFrame, where HDR10+ does not take the DIP */
+	if (crtc_state->hdmi_vsif_dropped && !conn_state->hdr10plus_vsif) {
+		memset(&crtc_state->infoframes.hdmi, 0, sizeof(crtc_state->infoframes.hdmi));
+		crtc_state->infoframes.enable &=
+			~intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
+	}
+
 	return true;
 }
 
@@ -1744,6 +1828,25 @@ static void vlv_set_infoframes(struct intel_encoder *encoder,
 			      &crtc_state->infoframes.hdmi);
 }
 
+/*
+ * Hades: i915.hdmi_empty_vsif (intel_hdmi_vsif.h): the vendor DIP off, where HDR10+ ended within a
+ * mode with no empty HDMI vendor InfoFrame under it
+ */
+static void intel_hdmi_vendor_dip_off(struct intel_encoder *encoder,
+				      const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	intel_reg_t reg = HSW_TVIDEO_DIP_CTL(display, crtc_state->cpu_transcoder);
+	const u32 vs = hsw_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
+	u32 val = intel_de_read(display, reg);
+
+	if ((val & vs) == 0)
+		return;
+	intel_de_write(display, reg, val & ~vs);
+	intel_de_posting_read(display, reg);
+	intel_hdmi_log_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_VENDOR, NULL, 0, true);
+}
+
 /*
  * Hades: HDR10PLUS_VSIF changes the vendor DIP with a fastset (intel_hdr10plus.h): written again
  * where it sends HDR10+, or did. Before intel_hdmi_fastset_infoframes(), which reads the control
@@ -1757,6 +1860,11 @@ void intel_hdmi_fastset_hdr10plus(struct intel_encoder *encoder,
 	    (intel_hdr10plus_active(crtc_state->infoframes.hdr10plus) ||
 	     intel_hdmi_hdr10plus_in_dip(encoder, crtc_state)))
 		intel_hdmi_write_vendor_infoframe(encoder, crtc_state);
+	/* Hades: i915.hdmi_empty_vsif: ... and off where HDR10+ ended with nothing under it */
+	else if (crtc_state->hdmi_vsif_dropped &&
+		 (crtc_state->infoframes.enable &
+		  intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) == 0)
+		intel_hdmi_vendor_dip_off(encoder, crtc_state);
 }
 
 void intel_hdmi_fastset_infoframes(struct intel_encoder *encoder,
@@ -3850,6 +3958,12 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 	struct intel_connector *connector = to_intel_connector(_connector);
 	struct intel_display *display = to_intel_display(intel_hdmi);
 
+	/* Hades: i915.hdmi_empty_vsif (intel_hdmi_vsif.h), said where it is off */
+	if (!READ_ONCE(hdmi_empty_vsif))
+		drm_info(display->drm,
+			 "Hades: [CONNECTOR:%d:%s] %s.hdmi_empty_vsif=0: the HDMI vendor InfoFrame goes out only with an HDMI VIC or 3D, and in the mode after a 3D one\n",
+			 connector->base.base.id, connector->base.name, KBUILD_MODNAME);
+
 	if (display->params.enable_dv_lab &&
 	    intel_dv_lab_platform_supported(DISPLAY_VER(display))) {
 		connector->dv_lab_property = drm_property_create_bool(display->drm,
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi_vsif.h b/drivers/gpu/drm/i915/display/intel_hdmi_vsif.h
new file mode 100644
index 000000000..04d370834
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_hdmi_vsif.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: i915.hdmi_empty_vsif (xe.hdmi_empty_vsif): the HDMI vendor InfoFrame that says nothing.
+ *
+ * DRM fills the HDMI vendor InfoFrame (OUI 00-0C-03) for every mode of a sink whose EDID has the
+ * HDMI vendor block, also where it carries neither an HDMI VIC nor a 3D structure
+ * (drm_hdmi_vendor_infoframe_from_display_mode()), and i915 sends it. Linux f1781e9bb2dd says why:
+ * HDMI 2.0 Appendix F suggests that the source keeps sending it as it leaves 3D, for sinks that do
+ * not leave 3D when it simply stops coming; HDMI 1.4 makes it optional in that case. AMD's display
+ * core sends it only with an HDMI VIC or 3D (mod_build_hf_vsif_infopacket()), and Hades' amdgpu
+ * sends it empty in the mode that follows a 3D one as well (linux-9919).
+ *
+ * Issue #28: an Anthem AVM 90 between the source and the TV takes the frame rate from that
+ * InfoFrame whenever there is one, and an empty one does not update it: at 2160p60 it says 4K30,
+ * the last mode that had an HDMI VIC, while the same mode with the Dolby VSIF in that slot, or an
+ * Apple TV, which sends none, is shown as 4K60.
+ *
+ * With the parameter off, the HDMI vendor InfoFrame goes out only where it carries something, and:
+ * - in the mode that follows a 3D one it goes out empty, for as long as that mode lasts (Appendix
+ *   F, as amdgpu does);
+ * - within a mode the vendor DIP stays as it is on the screen: a change of infoframes.enable needs
+ *   a modeset, which a commit that keeps the mode must not be made to need, so it is decided when
+ *   the mode changes, and a change of the parameter applies from the next mode;
+ * - HDR10+ takes the DIP as before; where no empty InfoFrame is under it, its start and its end
+ *   within a mode turn the DIP on and off in a fastset (intel_hdmi_vsif_fastset_vendor()).
+ * The Dolby VSIF of the tunnel and HDR over the tunnel (no vendor InfoFrame) do not change, nor
+ * does anything with the parameter on (the default, as upstream).
+ */
+#ifndef __INTEL_HDMI_VSIF_H__
+#define __INTEL_HDMI_VSIF_H__
+
+#include <linux/types.h>
+
+enum intel_hdmi_empty_vsif {
+	INTEL_HDMI_EMPTY_VSIF_SENT,	/* sent: the parameter is on */
+	INTEL_HDMI_EMPTY_VSIF_NOT_SENT,	/* not sent: a new mode */
+	INTEL_HDMI_EMPTY_VSIF_AFTER_3D,	/* sent: the mode follows a 3D one */
+	INTEL_HDMI_EMPTY_VSIF_KEPT,	/* sent: as the mode on the screen */
+	INTEL_HDMI_EMPTY_VSIF_KEPT_OFF,	/* not sent: as the mode on the screen */
+};
+
+/*
+ * What becomes of an HDMI vendor InfoFrame that carries neither an HDMI VIC nor 3D:
+ * @sends: the parameter (i915.hdmi_empty_vsif)
+ * @same_mode: the configuration on the screen is active with the same mode, and its vendor DIP was
+ *	decided by the same rule (not the Dolby VSIF of the tunnel, nor HDR over the tunnel)
+ * @old_sent: ... and it sends the empty InfoFrame (or would, under the HDR10+ one that it sends)
+ * @old_3d: the configuration on the screen is active with a 3D mode
+ */
+static inline enum intel_hdmi_empty_vsif
+intel_hdmi_empty_vsif_of(bool sends, bool same_mode, bool old_sent, bool old_3d)
+{
+	if (sends)
+		return INTEL_HDMI_EMPTY_VSIF_SENT;
+	if (same_mode)
+		return old_sent ? INTEL_HDMI_EMPTY_VSIF_KEPT : INTEL_HDMI_EMPTY_VSIF_KEPT_OFF;
+	if (old_3d)
+		return INTEL_HDMI_EMPTY_VSIF_AFTER_3D;
+	return INTEL_HDMI_EMPTY_VSIF_NOT_SENT;
+}
+
+/* The decision leaves the vendor DIP without the empty InfoFrame */
+static inline bool intel_hdmi_empty_vsif_dropped(enum intel_hdmi_empty_vsif what)
+{
+	return what == INTEL_HDMI_EMPTY_VSIF_NOT_SENT || what == INTEL_HDMI_EMPTY_VSIF_KEPT_OFF;
+}
+
+/*
+ * A fastset may turn the vendor DIP on or off between two configurations where one sends HDR10+
+ * and the other sends nothing in that DIP because of the parameter (@*_dropped: its empty HDMI
+ * vendor InfoFrame dropped): the start and the end of HDR10+ within a mode. Never with the
+ * parameter on, nor for HDR over the tunnel, whose vendor DIP is off for another reason.
+ */
+static inline bool intel_hdmi_vsif_fastset_vendor(bool old_hdr10plus, bool old_dropped,
+						  bool new_hdr10plus, bool new_dropped)
+{
+	return (old_hdr10plus && !new_hdr10plus && new_dropped) ||
+	       (new_hdr10plus && !old_hdr10plus && old_dropped);
+}
+
+#endif /* __INTEL_HDMI_VSIF_H__ */
