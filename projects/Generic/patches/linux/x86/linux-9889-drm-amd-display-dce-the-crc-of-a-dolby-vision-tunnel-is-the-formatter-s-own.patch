From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:05:34 +0000
Subject: [PATCH] drm/amd/display: DCE: the CRC of a Dolby Vision tunnel is the
 formatter's own, taken before the HDMI encoder

On DCE amdgpu_dm takes the CRC of a pipe in the CRTC (dce110_get_crc():
CRTC_CRC0_DATA_RG and _B), and the formatter takes its pixels from a CRTC
after it (FMT_CONTROL.FMT_SRC_SELECT, program_formatter_420_memory()). The
check of the output of a Dolby Vision tunnel (hades-output-check) therefore
never measured the formatter, and measured each component at the width of the
pipe there, not at the 8 bits that leave: issue #20 of LibreELEC Hades, an
RX 550 (DCE 11.2), needed extra test pictures (k * 0x11, k * 0x55) to tell a
widening inside the pipe from a change of the 8 bits, and still could not
measure what the formatter does.

DCE 11.2 and 12 have the formatter's own CRC, which DC does not use:
FMT_CRC_CNTL, the masks FMT_CRC_SIG_RED_GREEN_MASK and
FMT_CRC_SIG_BLUE_CONTROL_MASK, and the signatures FMT_CRC_SIG_RED_GREEN and
FMT_CRC_SIG_BLUE_CONTROL (dce_11_2_d.h, dce_12_0_offset.h), on what the
formatter gives the HDMI encoder: after its truncation, dither, clamp and
subsampling, the last stage that can change a component. For a byte tunnel
stream (dc_stream_state.byte_tunnel_crc_fmt, which
amdgpu_dm_dvbridge_fill_stream() sets from amdgpu.dvbridge_dce_crc, on by
default), dc_stream_configure_crc() also turns it on (every bit of each
component in its signature, continuous, the rest of FMT_CRC_CNTL as it was)
and dc_stream_get_crc() gives its signatures instead of the CRTC's. It goes
off with the CRC, or when a stream without the tunnel takes the pipe with the
CRC on; a formatter whose CRC the tunnel did not turn on is not touched.
amdgpu_dm says in the kernel log, each time the CRC is set for a tunnel on
DCE, where it is taken and the formatter's CRC as its registers hold it:
hades-output-check reads that line and says where it measured. The encoder's
own CRC (DIG_OUTPUT_CRC_CNTL, one value of 30 bits whose input
DIG_OUTPUT_CRC_DATA_SEL chooses, undocumented) is not used.
amdgpu.dvbridge_dce_crc=0 takes the CRC in the CRTC again, as up to 1.2.2, so
that the two can be compared.

Host test (the one of linux-9888, with dc_stream_configure_crc(),
dc_stream_get_crc() and dc_stream_read_fmt_crc() cut from dc.c): on DCE 11.2,
11.22, 12.0 and 12.1 a stream without the tunnel leaves FMT_CRC_CNTL as a
VBIOS left it; the tunnel turns the formatter's CRC on and continuous with
the three masks at 0xffff, the rest of the register kept, and gets its
signatures; with the parameter off it gets the CRTC's and turns the
formatter's off; the CRC ending, or a stream without the tunnel, turns it
off. Mutations of each part make the test fail.

Not verified: what the masks and the rest of FMT_CRC_CNTL do on a card. The
check guards against a CRC that does not follow the picture: its calibration
needs every bit of a pixel to change the CRC and the relation of the CRC to
hold on separate pixels, or it judges nothing, and never says exact.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 17 ++++
 .../drm/amd/display/amdgpu_dm/amdgpu_dm_crc.c | 22 ++++++
 drivers/gpu/drm/amd/display/dc/core/dc.c      | 33 ++++++++
 drivers/gpu/drm/amd/display/dc/dc_stream.h    | 15 ++++
 drivers/gpu/drm/amd/display/dc/dce/dce_opp.c  | 79 ++++++++++++++++++-
 drivers/gpu/drm/amd/display/dc/dce/dce_opp.h  | 50 ++++++++++++
 drivers/gpu/drm/amd/display/dc/inc/hw/opp.h   | 15 ++++
 .../dc/resource/dce112/dce112_resource.c      |  7 +-
 .../dc/resource/dce120/dce120_resource.c      |  7 +-
 9 files changed, 240 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 522c362..96795dd 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1814,6 +1814,21 @@ module_param_named(dvbridge_dce_expansion, amdgpu_dm_dvbridge_dce_expansion, boo
 MODULE_PARM_DESC(dvbridge_dce_expansion,
 		 "DCE: keep the dynamic expansion of the formatter on during the Dolby Vision tunnel, as 1.0 did (default: false: off during the tunnel)");
 
+/*
+ * Hades: DCE 11.2 and 12: where the CRC of the pipe is taken during the tunnel. The CRC of the CRTC,
+ * which amdgpu_dm gives for every other stream, is taken before the formatter, so it measures neither
+ * the formatter nor the width at which the pipe carries each component there (issue 20 of LibreELEC
+ * Hades: an RX 550 whose CRTC CRC broke the check while the read back was as the tunnel needs). With
+ * this on (the default), the CRC of a tunnelled stream is the formatter's own, taken on what goes to
+ * the HDMI encoder, after the last stage that can change a component (dc_stream_state.
+ * byte_tunnel_crc_fmt). 0 takes it in the CRTC, as up to 1.2.2, so that the two can be compared.
+ * hades-output-check reads this parameter to say where it measured.
+ */
+static bool amdgpu_dm_dvbridge_dce_crc = true;
+module_param_named(dvbridge_dce_crc, amdgpu_dm_dvbridge_dce_crc, bool, 0444);
+MODULE_PARM_DESC(dvbridge_dce_crc,
+		 "DCE: the CRC of a Dolby Vision tunnel is the formatter's, taken before the HDMI encoder (default: true; false: the CRTC's, before the formatter, as up to 1.2.2)");
+
 /* HDMI InfoFrame to DC: header in hb0-hb2, checksum in sb[0], payload after it. */
 static int amdgpu_dm_dvbridge_infopacket(const u8 *buf, ssize_t len,
 					 struct dc_info_packet *out)
@@ -1981,6 +1996,8 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	stream->byte_tunnel = true;
 	/* Hades: ... and its formatter without the dynamic expansion (amdgpu.dvbridge_dce_expansion) */
 	stream->byte_tunnel_no_expansion = !amdgpu_dm_dvbridge_dce_expansion;
+	/* Hades: ... and its CRC taken after the formatter (amdgpu.dvbridge_dce_crc) */
+	stream->byte_tunnel_crc_fmt = amdgpu_dm_dvbridge_dce_crc;
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_crc.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_crc.c
index 3c43e82..0003fdc 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_crc.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_crc.c
@@ -617,6 +617,28 @@ int amdgpu_dm_crtc_configure_crc_source(struct drm_crtc *crtc,
 		}
 	}
 
+	/*
+	 * Hades: DCE 11.2 and 12: the CRC of a Dolby Vision tunnel is the formatter's, on what goes
+	 * to the HDMI encoder (dc_stream_state.byte_tunnel_crc_fmt, amdgpu.dvbridge_dce_crc); the
+	 * kernel log says where it is taken, with the formatter's CRC as its registers hold it
+	 */
+	if (enable && dm_is_crc_source_crtc(source) &&
+	    amdgpu_dm_dvbridge_stream_active(stream_state) &&
+	    stream_state->ctx->dce_version < DCE_VERSION_MAX) {
+		uint32_t cntl = 0, rg_mask = 0, b_mask = 0;
+
+		if (dc_stream_read_fmt_crc(stream_state->ctx->dc, stream_state, &cntl, &rg_mask,
+					   &b_mask))
+			drm_info(crtc->dev,
+				 "[CRTC:%d:%s] Dolby Vision tunnel, DCE: its CRC is taken after the formatter, before the HDMI encoder (FMT_CRC_CNTL %#x, masks %#x %#x)\n",
+				 crtc->base.id, crtc->name, cntl, rg_mask, b_mask);
+		else
+			drm_info(crtc->dev,
+				 "[CRTC:%d:%s] Dolby Vision tunnel, DCE: its CRC is taken in the CRTC, before the formatter (the formatter's CRC is %s)\n",
+				 crtc->base.id, crtc->name,
+				 stream_state->byte_tunnel_crc_fmt ? "not listed" : "off: amdgpu.dvbridge_dce_crc=0");
+	}
+
 	/*
 	 * Configure dithering, never on a Dolby Vision tunnel: its bytes must stay exact (it keeps
 	 * its truncation to 8 bits).
diff --git a/drivers/gpu/drm/amd/display/dc/core/dc.c b/drivers/gpu/drm/amd/display/dc/core/dc.c
index c143667..f7bfc86 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -696,6 +696,16 @@ bool dc_stream_configure_crc(struct dc *dc, struct dc_stream_state *stream,
 
 	tg = pipe->stream_res.tg;
 
+	/*
+	 * Hades: a byte tunnel stream on DCE 11.2 and 12 (dc_stream_state.byte_tunnel_crc_fmt): the
+	 * formatter's CRC too, the one dc_stream_get_crc() gives for it; off again with the CRC, or for
+	 * a stream without it whose formatter still has it on from a tunnel (dce110_opp_configure_crc()
+	 * touches nothing otherwise)
+	 */
+	if (idx == 0 && pipe->stream_res.opp && pipe->stream_res.opp->funcs->opp_configure_crc)
+		pipe->stream_res.opp->funcs->opp_configure_crc(pipe->stream_res.opp,
+			enable && pipe->stream->byte_tunnel && pipe->stream->byte_tunnel_crc_fmt);
+
 	/* Only call if supported */
 	if (tg->funcs->configure_crc)
 		return tg->funcs->configure_crc(tg, &param);
@@ -738,6 +748,14 @@ bool dc_stream_get_crc(struct dc *dc, struct dc_stream_state *stream, uint8_t id
 
 	tg = pipe->stream_res.tg;
 
+	/*
+	 * Hades: a byte tunnel stream on DCE 11.2 and 12: the formatter's CRC, on what goes to the
+	 * HDMI encoder (dc_stream_state.byte_tunnel_crc_fmt); none while it is off
+	 */
+	if (idx == 0 && stream->byte_tunnel && stream->byte_tunnel_crc_fmt &&
+	    pipe->stream_res.opp && pipe->stream_res.opp->funcs->opp_get_crc)
+		return pipe->stream_res.opp->funcs->opp_get_crc(pipe->stream_res.opp, r_cr, g_y, b_cb);
+
 	if (tg->funcs->get_crc)
 		return tg->funcs->get_crc(tg, idx, r_cr, g_y, b_cb);
 	DC_LOG_WARNING("CRC capture not supported.");
@@ -923,6 +941,21 @@ bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *str
 	return readback->ipp_read && readback->xfm_read && readback->opp_read;
 }
 
+bool dc_stream_read_fmt_crc(struct dc *dc, const struct dc_stream_state *stream, uint32_t *cntl,
+			    uint32_t *rg_mask, uint32_t *b_mask)
+{
+	struct pipe_ctx *pipe;
+
+	if (!stream->byte_tunnel || !stream->byte_tunnel_crc_fmt)
+		return false;
+	pipe = resource_get_otg_master_for_stream(&dc->current_state->res_ctx, stream);
+	if (!pipe || !pipe->stream_res.opp || !pipe->stream_res.opp->funcs->opp_read_crc_config)
+		return false;
+	dc_exit_ips_for_hw_access(dc);
+	return pipe->stream_res.opp->funcs->opp_read_crc_config(pipe->stream_res.opp, cntl, rg_mask,
+								b_mask);
+}
+
 /*
  * Hades: the registers of every pipe of a byte tunnel stream on DCN 4.2 and 4.2B that decide whether
  * its bytes reach the encoder as they were scanned out (struct dc_byte_tunnel_dcn42_readback), read
diff --git a/drivers/gpu/drm/amd/display/dc/dc_stream.h b/drivers/gpu/drm/amd/display/dc/dc_stream.h
index 2c71e31..3e83da8 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_stream.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_stream.h
@@ -248,6 +248,13 @@ struct dc_stream_state {
 	 * with a modeset.
 	 */
 	bool byte_tunnel;
+	/*
+	 * Hades: DCE 11.2 and 12: the CRC of a byte tunnel stream (dc_stream_configure_crc(),
+	 * dc_stream_get_crc()) is the formatter's own, taken on its output before the HDMI encoder,
+	 * instead of the CRTC's, taken before the formatter. Set with byte_tunnel by
+	 * amdgpu_dm_dvbridge_fill_stream() (amdgpu.dvbridge_dce_crc).
+	 */
+	bool byte_tunnel_crc_fmt;
 	/*
 	 * Hades: DCE: the formatter of a byte tunnel stream without its dynamic expansion
 	 * (FMT_DYNAMIC_EXP_CNTL off, dce110_hwseq.c). Set with byte_tunnel, by
@@ -642,6 +649,14 @@ bool dc_stream_program_csc_matrix(struct dc *dc,
 bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *stream,
 				struct dc_byte_tunnel_readback *readback);
 
+/*
+ * Hades: DCE 11.2 and 12: whether the CRC of the stream is the formatter's
+ * (dc_stream_state.byte_tunnel_crc_fmt), and that CRC's configuration as the registers hold it
+ * (FMT_CRC_CNTL and its two mask registers), for the kernel log. False otherwise. It changes nothing.
+ */
+bool dc_stream_read_fmt_crc(struct dc *dc, const struct dc_stream_state *stream, uint32_t *cntl,
+			    uint32_t *rg_mask, uint32_t *b_mask);
+
 /*
  * Hades: the same on DCN 4.2 and 4.2B, every pipe of the stream (struct
  * dc_byte_tunnel_dcn42_readback). False when the stream has no pipe with a plane in the current
diff --git a/drivers/gpu/drm/amd/display/dc/dce/dce_opp.c b/drivers/gpu/drm/amd/display/dc/dce/dce_opp.c
index bb98c6a..4cdc5d1 100644
--- a/drivers/gpu/drm/amd/display/dc/dce/dce_opp.c
+++ b/drivers/gpu/drm/amd/display/dc/dce/dce_opp.c
@@ -741,6 +741,80 @@ static void dce110_opp_read_byte_tunnel(
 	}
 }
 
+/* Hades: the pool lists the formatter's CRC (OPP_DCE_112_TUNNEL_REG_LIST(), DCE 11.2 and 12) */
+static bool dce110_opp_fmt_crc_listed(const struct dce110_opp *opp110)
+{
+	return opp110->regs->FMT_CRC_CNTL && opp110->regs->FMT_CRC_SIG_RED_GREEN_MASK &&
+	       opp110->regs->FMT_CRC_SIG_BLUE_CONTROL_MASK && opp110->regs->FMT_CRC_SIG_RED_GREEN &&
+	       opp110->regs->FMT_CRC_SIG_BLUE_CONTROL && opp110->opp_mask->FMT_CRC_EN &&
+	       opp110->opp_mask->FMT_CRC_CONT_EN && opp110->opp_mask->FMT_CRC_SIG_RED_MASK &&
+	       opp110->opp_mask->FMT_CRC_SIG_GREEN_MASK && opp110->opp_mask->FMT_CRC_SIG_BLUE_MASK &&
+	       opp110->opp_mask->FMT_CRC_SIG_RED && opp110->opp_mask->FMT_CRC_SIG_GREEN &&
+	       opp110->opp_mask->FMT_CRC_SIG_BLUE;
+}
+
+/*
+ * Hades: the formatter's own CRC (FMT_CRC_CNTL and its signatures), for a byte tunnel stream
+ * (dc_stream_state.byte_tunnel_crc_fmt): taken on what the formatter gives the HDMI encoder, after its
+ * truncation, dither, clamp and subsampling, where the CRC of the CRTC (dce110_configure_crc()) is
+ * taken before them. Each component's signature takes every bit of its component (the masks at
+ * 0xffff); the rest of FMT_CRC_CNTL keeps its reset value (no overscan, the whole frame, both
+ * fields, every pixel). Continuous, like the CRC of the CRTC. Off again when the CRC ends, and only
+ * then: a formatter whose CRC the tunnel did not turn on is not touched. False where the pool does
+ * not list it.
+ */
+static bool dce110_opp_configure_crc(struct output_pixel_processor *opp, bool enable)
+{
+	struct dce110_opp *opp110 = TO_DCE110_OPP(opp);
+
+	if (!dce110_opp_fmt_crc_listed(opp110))
+		return false;
+	if (!enable) {
+		if (opp110->fmt_crc_on)
+			REG_UPDATE_2(FMT_CRC_CNTL, FMT_CRC_EN, 0, FMT_CRC_CONT_EN, 0);
+		opp110->fmt_crc_on = false;
+		return true;
+	}
+	REG_UPDATE(FMT_CRC_CNTL, FMT_CRC_EN, 0);
+	REG_UPDATE_2(FMT_CRC_SIG_RED_GREEN_MASK,
+		     FMT_CRC_SIG_RED_MASK, 0xffff,
+		     FMT_CRC_SIG_GREEN_MASK, 0xffff);
+	REG_UPDATE(FMT_CRC_SIG_BLUE_CONTROL_MASK, FMT_CRC_SIG_BLUE_MASK, 0xffff);
+	REG_UPDATE_2(FMT_CRC_CNTL, FMT_CRC_CONT_EN, 1, FMT_CRC_EN, 1);
+	opp110->fmt_crc_on = true;
+	return true;
+}
+
+/* Hades: the signatures of the formatter's CRC (dce110_opp_configure_crc()), false while it is off */
+static bool dce110_opp_get_crc(struct output_pixel_processor *opp,
+			       uint32_t *r_cr, uint32_t *g_y, uint32_t *b_cb)
+{
+	struct dce110_opp *opp110 = TO_DCE110_OPP(opp);
+
+	if (!opp110->fmt_crc_on || !dce110_opp_fmt_crc_listed(opp110))
+		return false;
+	REG_GET_2(FMT_CRC_SIG_RED_GREEN, FMT_CRC_SIG_RED, r_cr, FMT_CRC_SIG_GREEN, g_y);
+	REG_GET(FMT_CRC_SIG_BLUE_CONTROL, FMT_CRC_SIG_BLUE, b_cb);
+	return true;
+}
+
+/*
+ * Hades: the formatter's CRC as its registers hold it, for the kernel log: FMT_CRC_CNTL and the two
+ * mask registers, whole. False where the pool does not list it.
+ */
+static bool dce110_opp_read_crc_config(struct output_pixel_processor *opp, uint32_t *cntl,
+				       uint32_t *rg_mask, uint32_t *b_mask)
+{
+	struct dce110_opp *opp110 = TO_DCE110_OPP(opp);
+
+	if (!dce110_opp_fmt_crc_listed(opp110))
+		return false;
+	*cntl = REG_READ(FMT_CRC_CNTL);
+	*rg_mask = REG_READ(FMT_CRC_SIG_RED_GREEN_MASK);
+	*b_mask = REG_READ(FMT_CRC_SIG_BLUE_CONTROL_MASK);
+	return true;
+}
+
 /*****************************************/
 /* Constructor, Destructor               */
 /*****************************************/
@@ -750,7 +824,10 @@ static const struct opp_funcs funcs = {
 	.opp_destroy = dce110_opp_destroy,
 	.opp_program_fmt = dce110_opp_program_fmt,
 	.opp_program_bit_depth_reduction = dce110_opp_program_bit_depth_reduction,
-	.opp_read_byte_tunnel = dce110_opp_read_byte_tunnel /* Hades */
+	.opp_read_byte_tunnel = dce110_opp_read_byte_tunnel, /* Hades */
+	.opp_configure_crc = dce110_opp_configure_crc, /* Hades */
+	.opp_get_crc = dce110_opp_get_crc, /* Hades */
+	.opp_read_crc_config = dce110_opp_read_crc_config /* Hades */
 };
 
 #if defined(CONFIG_DRM_AMD_DC_SI)
diff --git a/drivers/gpu/drm/amd/display/dc/dce/dce_opp.h b/drivers/gpu/drm/amd/display/dc/dce/dce_opp.h
index 3d9be87..4850027 100644
--- a/drivers/gpu/drm/amd/display/dc/dce/dce_opp.h
+++ b/drivers/gpu/drm/amd/display/dc/dce/dce_opp.h
@@ -81,6 +81,18 @@ enum dce110_opp_reg_type {
 	OPP_COMMON_REG_LIST_BASE(id), \
 	SRI(CONTROL, FMT_MEMORY, id)
 
+/*
+ * Hades: DCE 11.2 and 12, where the byte tunnel is offered: the formatter's own CRC, taken on its
+ * output, after every stage that can change a component and before the HDMI encoder
+ * (dce110_opp_configure_crc()). DC does not use it.
+ */
+#define OPP_DCE_112_TUNNEL_REG_LIST(id) \
+	SRI(FMT_CRC_CNTL, FMT, id), \
+	SRI(FMT_CRC_SIG_RED_GREEN_MASK, FMT, id), \
+	SRI(FMT_CRC_SIG_BLUE_CONTROL_MASK, FMT, id), \
+	SRI(FMT_CRC_SIG_RED_GREEN, FMT, id), \
+	SRI(FMT_CRC_SIG_BLUE_CONTROL, FMT, id)
+
 #if defined(CONFIG_DRM_AMD_DC_SI)
 #define OPP_DCE_60_REG_LIST(id) \
 	SRI(FMT_DYNAMIC_EXP_CNTL, FMT, id), \
@@ -155,6 +167,28 @@ enum dce110_opp_reg_type {
 	OPP_SF(FMT_CONTROL, FMT_SPATIAL_DITHER_FRAME_COUNTER_BIT_SWAP, mask_sh),\
 	OPP_SF(FMT_CONTROL, FMT_STEREOSYNC_OVERRIDE, mask_sh)
 
+/* Hades: with OPP_DCE_112_TUNNEL_REG_LIST(), DCE 11.2 */
+#define OPP_DCE_112_TUNNEL_MASK_SH_LIST(mask_sh)\
+	OPP_SF(FMT_CRC_CNTL, FMT_CRC_EN, mask_sh),\
+	OPP_SF(FMT_CRC_CNTL, FMT_CRC_CONT_EN, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_RED_GREEN_MASK, FMT_CRC_SIG_RED_MASK, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_RED_GREEN_MASK, FMT_CRC_SIG_GREEN_MASK, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_BLUE_CONTROL_MASK, FMT_CRC_SIG_BLUE_MASK, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_RED_GREEN, FMT_CRC_SIG_RED, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_RED_GREEN, FMT_CRC_SIG_GREEN, mask_sh),\
+	OPP_SF(FMT_CRC_SIG_BLUE_CONTROL, FMT_CRC_SIG_BLUE, mask_sh)
+
+/* Hades: with OPP_DCE_112_TUNNEL_REG_LIST(), DCE 12 */
+#define OPP_DCE_120_TUNNEL_MASK_SH_LIST(mask_sh)\
+	OPP_SF(FMT0_FMT_CRC_CNTL, FMT_CRC_EN, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_CNTL, FMT_CRC_CONT_EN, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_RED_GREEN_MASK, FMT_CRC_SIG_RED_MASK, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_RED_GREEN_MASK, FMT_CRC_SIG_GREEN_MASK, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_BLUE_CONTROL_MASK, FMT_CRC_SIG_BLUE_MASK, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_RED_GREEN, FMT_CRC_SIG_RED, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_RED_GREEN, FMT_CRC_SIG_GREEN, mask_sh),\
+	OPP_SF(FMT0_FMT_CRC_SIG_BLUE_CONTROL, FMT_CRC_SIG_BLUE, mask_sh)
+
 #define OPP_COMMON_MASK_SH_LIST_DCE_80(mask_sh)\
 	OPP_COMMON_MASK_SH_LIST_DCE_COMMON_BASE(mask_sh)
 
@@ -274,6 +308,14 @@ enum dce110_opp_reg_type {
 	type FMT_SUBSAMPLING_ORDER; \
 	type FMT_SUBSAMPLING_MODE; \
 	type FMT_CBCR_BIT_REDUCTION_BYPASS;\
+	type FMT_CRC_EN;\
+	type FMT_CRC_CONT_EN;\
+	type FMT_CRC_SIG_RED_MASK;\
+	type FMT_CRC_SIG_GREEN_MASK;\
+	type FMT_CRC_SIG_BLUE_MASK;\
+	type FMT_CRC_SIG_RED;\
+	type FMT_CRC_SIG_GREEN;\
+	type FMT_CRC_SIG_BLUE;\
 
 struct dce_opp_shift {
 	OPP_REG_FIELD_LIST(uint8_t)
@@ -298,6 +340,12 @@ struct dce_opp_registers {
 	uint32_t FMT_CLAMP_COMPONENT_R;
