 	/*
 	 * Hades: DVBRIDGE_LINK_FORMAT, what a request of the guard found the configuration sends
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 9f48b98..b733f3a 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -88,6 +88,7 @@
 #include "intel_hotplug_irq.h"
 #include "intel_dv_lab_policy.h"
 #include "intel_dv_pcon_policy.h"
+#include "intel_pcon_audio.h"
 #include "intel_lspcon.h"
 #include "intel_lvds.h"
 #include "intel_modeset_lock.h"
@@ -3408,6 +3409,55 @@ intel_dp_compute_formats(struct intel_encoder *encoder,
 	return ret;
 }
 
+/*
+ * Hades: the display parameter pcon_hd_audio (off by default; intel_pcon_audio.h). The ELD of a
+ * display behind a DisplayPort to HDMI converter whose display data declare stereo PCM only is
+ * given PCM in 8 channels and Dolby Digital, Dolby Digital Plus and Dolby TrueHD. Only where the
+ * port's DPCD says that a branch device of the HDMI type is behind it, with an HDMI sink, on a
+ * single stream: a DisplayPort display, an MST hub and a display that declares more are left as
+ * they are. The kernel log says what the parameter did, once for each change.
+ */
+static void intel_dp_pcon_audio(struct intel_dp *intel_dp, struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	enum intel_pcon_audio_eld kind = INTEL_PCON_AUDIO_ELD_INVALID;
+	u8 *eld = crtc_state->eld;
+	bool converter;
+	int n = 0;
+	u8 told;
+
+	if (!display->params.pcon_hd_audio || intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP_MST))
+		return;
+	converter = drm_dp_is_branch(intel_dp->dpcd) &&
+		(intel_dp->downstream_ports[0] & DP_DS_PORT_TYPE_MASK) == DP_DS_PORT_TYPE_HDMI &&
+		intel_dp_has_hdmi_sink(intel_dp);
+	if (converter) {
+		kind = intel_pcon_audio_eld_kind(eld, sizeof(crtc_state->eld));
+		if (kind == INTEL_PCON_AUDIO_ELD_STEREO)
+			n = intel_pcon_audio_widen(eld, sizeof(crtc_state->eld));
+	}
+
+	told = converter ? 1 + kind : 4;
+	if (connector->pcon_audio_told == told)
+		return;
+	connector->pcon_audio_told = told;
+	if (n > 0)
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] audio: the display data behind the DisplayPort to HDMI converter declare stereo PCM only; %s.pcon_hd_audio=1: the sound driver is given PCM in 8 channels (rates 0x%02x and sizes 0x%02x, as declared), Dolby Digital 5.1, Dolby Digital Plus 7.1 and Dolby TrueHD 7.1, %d descriptors\n",
+			 connector->base.base.id, connector->base.name,
+			 dev_driver_string(display->drm->dev),
+			 eld[DRM_ELD_CEA_SAD(drm_eld_mnl(eld), 0) + 1],
+			 eld[DRM_ELD_CEA_SAD(drm_eld_mnl(eld), 0) + 2], n);
+	else
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] audio: %s.pcon_hd_audio=1 leaves the display data as they are: %s\n",
+			 connector->base.base.id, connector->base.name,
+			 dev_driver_string(display->drm->dev),
+			 !converter ? "no DisplayPort to HDMI converter is behind this port" :
+			 intel_pcon_audio_eld_name(kind));
+}
+
 void
 intel_dp_audio_compute_config(struct intel_encoder *encoder,
 			      struct intel_crtc_state *pipe_config,
@@ -3419,6 +3469,10 @@ intel_dp_audio_compute_config(struct intel_encoder *encoder,
 		intel_dp_has_audio(encoder, conn_state) &&
 		intel_audio_compute_config(encoder, pipe_config, conn_state);
 
+	/* Hades: the HD audio of a display behind a converter, where the parameter asks for it */
+	if (pipe_config->has_audio)
+		intel_dp_pcon_audio(intel_dp, pipe_config);
+
 	pipe_config->sdp_split_enable = pipe_config->has_audio &&
 					intel_dp_is_uhbr(pipe_config);
 
diff --git a/drivers/gpu/drm/i915/display/intel_pcon_audio.h b/drivers/gpu/drm/i915/display/intel_pcon_audio.h
new file mode 100644
index 0000000..4699f59
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_pcon_audio.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: the audio of a display behind a DisplayPort to HDMI converter (an adapter, the HDMI socket
+ * of a USB-C hub or dock) whose display data declare stereo PCM and nothing else, as the display
+ * parameter pcon_hd_audio asks (i915.pcon_hd_audio, or xe.pcon_hd_audio; off by default). The ELD
+ * that the sound driver gets is built from the EDID that is read through the converter. Where it
+ * declares 2 channels of PCM at most and no other format, the HDA HDMI codec limits every stream
+ * to 2 channels and to the rates of that PCM (snd_hdmi_eld_update_pcm_info()), so that a
+ * bitstream of Dolby TrueHD or Dolby Digital Plus (8 channels at 192 kHz, 2 channels at 192 kHz)
+ * cannot be opened and decoded surround is mixed down to stereo. Whether such data come from the
+ * converter or from the display behind it is not known from here; the parameter is for the user
+ * who knows that the chain behind it takes more.
+ *
+ * With it, such an ELD is given, in place of its descriptors:
+ * - linear PCM in 8 channels, at the rates and sample sizes that the display data declare for PCM
+ *   (at least 32, 44.1 and 48 kHz at 16 bits, the basic audio that every display with audio takes);
+ * - Dolby Digital in 6 channels (32 to 48 kHz, 640 kbit/s), Dolby Digital Plus in 8 (32 to 48 kHz)
+ *   and Dolby TrueHD (MAT) in 8 (44.1 to 192 kHz), with their format-dependent byte at zero (no
+ *   claim of objects);
+ * and the speakers of 7.1 in its speaker allocation (the HDA codec offers channel maps up to the
+ * speakers it declares). DTS is not declared: what Kodi passes through is its own setting, and the
+ * display data would then say something that nobody has checked. The rest of the ELD (its version,
+ * the monitor name, the connection type) is as it was, and its baseline length is what the new
+ * descriptors take (drm_eld_calc_baseline_block_size()).
+ *
+ * Nothing in this header touches hardware or the kernel: the host test runs it as it is.
+ */
+#ifndef __INTEL_PCON_AUDIO_H__
+#define __INTEL_PCON_AUDIO_H__
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <drm/drm_eld.h>
+
+/* CTA-861 audio format codes of a short audio descriptor */
+#define INTEL_PCON_AUDIO_LPCM	1
+#define INTEL_PCON_AUDIO_AC3	2
+#define INTEL_PCON_AUDIO_EAC3	10
+#define INTEL_PCON_AUDIO_MAT	12	/* Dolby MAT: Dolby TrueHD */
+
+/* Basic audio, in the bits of a descriptor of PCM: 32, 44.1 and 48 kHz; 16 bits */
+#define INTEL_PCON_AUDIO_BASIC_RATES	0x07
+#define INTEL_PCON_AUDIO_BASIC_SIZES	0x01
+
+/* The descriptors that follow the one of PCM */
+#define INTEL_PCON_AUDIO_DOLBY		3
+
+/* What an ELD says, for the parameter */
+enum intel_pcon_audio_eld {
+	/* stereo PCM at most and no other format (or no descriptor, basic audio): it acts */
+	INTEL_PCON_AUDIO_ELD_STEREO,
+	/* PCM in more than 2 channels, or another format: the display data are taken as they are */
+	INTEL_PCON_AUDIO_ELD_MORE,
+	/* not an ELD of version 2 whose monitor name and descriptors fit: left as it is */
+	INTEL_PCON_AUDIO_ELD_INVALID,
+};
+
+static inline const char *intel_pcon_audio_eld_name(enum intel_pcon_audio_eld kind)
+{
+	switch (kind) {
+	case INTEL_PCON_AUDIO_ELD_STEREO:
+		return "stereo PCM only";
+	case INTEL_PCON_AUDIO_ELD_MORE:
+		return "more than stereo PCM";
+	default:
+		return "not a valid ELD";
+	}
+}
+
+static inline enum intel_pcon_audio_eld intel_pcon_audio_eld_kind(const u8 *eld, size_t size)
+{
+	unsigned int ver, mnl, n, i;
+
+	if (size < DRM_ELD_MONITOR_NAME_STRING)
+		return INTEL_PCON_AUDIO_ELD_INVALID;
+	ver = (eld[DRM_ELD_VER] & DRM_ELD_VER_MASK) >> DRM_ELD_VER_SHIFT;
+	mnl = drm_eld_mnl(eld);
+	n = drm_eld_sad_count(eld);
+	if (ver != 2 || mnl > 16 || DRM_ELD_CEA_SAD(mnl, n) > size)
+		return INTEL_PCON_AUDIO_ELD_INVALID;
+	for (i = 0; i < n; i++) {
+		const u8 *sad = eld + DRM_ELD_CEA_SAD(mnl, i);
+
+		if (((sad[0] >> 3) & 0xf) != INTEL_PCON_AUDIO_LPCM || (sad[0] & 0x7) + 1 > 2)
+			return INTEL_PCON_AUDIO_ELD_MORE;
+	}
+	return INTEL_PCON_AUDIO_ELD_STEREO;
+}
+
+/*
+ * Give an ELD of stereo PCM only the descriptors above (the comment at the top). @size is the size
+ * of the buffer of @eld. Returns the number of descriptors it now has, 0 where it is left as it is
+ * (not stereo PCM only, or the new descriptors would not fit).
+ */
+static inline int intel_pcon_audio_widen(u8 *eld, size_t size)
+{
+	static const u8 dolby[INTEL_PCON_AUDIO_DOLBY][3] = {
+		{ INTEL_PCON_AUDIO_AC3 << 3 | (6 - 1), 0x07, 640 / 8 },
+		{ INTEL_PCON_AUDIO_EAC3 << 3 | (8 - 1), 0x07, 0 },
+		{ INTEL_PCON_AUDIO_MAT << 3 | (8 - 1), 0x7e, 0 },
+	};
+	u8 rates = INTEL_PCON_AUDIO_BASIC_RATES, sizes = INTEL_PCON_AUDIO_BASIC_SIZES;
+	unsigned int mnl, n, i;
+	u8 *sad;
+
+	if (intel_pcon_audio_eld_kind(eld, size) != INTEL_PCON_AUDIO_ELD_STEREO)
+		return 0;
+	mnl = drm_eld_mnl(eld);
+	n = drm_eld_sad_count(eld);
+	if (DRM_ELD_CEA_SAD(mnl, 1 + INTEL_PCON_AUDIO_DOLBY) > size)
+		return 0;
+
+	sad = eld + DRM_ELD_CEA_SAD(mnl, 0);
+	/* the rates and sizes that the display data declare for PCM (bit 7 is reserved) */
+	for (i = 0; i < n; i++) {
+		rates |= sad[3 * i + 1] & 0x7f;
+		sizes |= sad[3 * i + 2] & 0x07;
+	}
+	/* the old descriptors go: none is left behind the new ones */
+	memset(sad, 0, 3 * n);
+	sad[0] = INTEL_PCON_AUDIO_LPCM << 3 | (8 - 1);
+	sad[1] = rates;
+	sad[2] = sizes;
+	memcpy(sad + 3, dolby, sizeof(dolby));
+	n = 1 + INTEL_PCON_AUDIO_DOLBY;
+
+	eld[DRM_ELD_SAD_COUNT_CONN_TYPE] =
+		(eld[DRM_ELD_SAD_COUNT_CONN_TYPE] & ~DRM_ELD_SAD_COUNT_MASK) |
+		(n << DRM_ELD_SAD_COUNT_SHIFT);
+	eld[DRM_ELD_SPEAKER] |= DRM_ELD_SPEAKER_FLR | DRM_ELD_SPEAKER_LFE | DRM_ELD_SPEAKER_FC |
+				DRM_ELD_SPEAKER_RLR | DRM_ELD_SPEAKER_RLRC;
+	eld[DRM_ELD_BASELINE_ELD_LEN] = (drm_eld_calc_baseline_block_size(eld) + 3) / 4;
+	return n;
+}
+
+#endif
-- 
