diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 4f68708..522c362 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -2579,6 +2579,82 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
 	return len != 0;
 }
 
+/*
+ * Hades (issue #20): DCE: what in the read back of the other stages between the plane and the HDMI
+ * encoder (struct dc_byte_tunnel_readback, from mi_read on) is not as the tunnel needs it, written to
+ * buf (true), or false: all of it is. Every stage must answer (DCE 11.2 and 12 list them all). The
+ * stages that the tunnel sets must read back as it set them: the blender of the pipe fed through
+ * without the SuperAA degamma and regamma (dce_set_blender_byte_tunnel()) and the line buffer's colour
+ * keyer off (dce_transform_set_byte_tunnel()). The others must read as DC programs them for an
+ * XRGB8888 plane on an RGB stream at 8 bpc: the surface at 32 bpp, format 0, zero expansion and no
+ * crossbar (program_grph_pixel_format(), program_tiling()); no cursor; no chroma subsampling or
+ * chroma bit reduction bypass in the formatter (set_pixel_encoding()); and an HDMI link without deep
+ * colour, at 24 bpp, RGB and without AV mute (dce110_stream_encoder_hdmi_set_stream_attribute()).
+ * The DCP keyer, the alpha control, the scaler's bypass mode, sharpness and rounding offset and the
+ * formatter's source are read, not judged: the keyer makes an alpha, which the blender fed through
+ * does not use, and the scaler is in bypass (SCL_MODE 0, judged before).
+ */
+bool amdgpu_dm_dvbridge_dce_stages_why(const struct dc_byte_tunnel_readback *rb, char *buf,
+					size_t size)
+{
+	size_t len = 0;
+
+	buf[0] = '\0';
+	if (!rb->mi_read || !rb->cursor_read || !rb->dcp_extra_read || !rb->lb_keyer_read ||
+	    !rb->scl_extra_read || !rb->blnd_read || !rb->fmt_extra_read || !rb->enc_read)
+		len += scnprintf(buf + len, size - len,
+				 "%snot every stage answered or was set (surface %d, cursor %d, keyer %d, line buffer keyer %d, scaler %d, blender %d, formatter %d, HDMI encoder %d)",
+				 len ? "; " : "", rb->mi_read, rb->cursor_read, rb->dcp_extra_read,
+				 rb->lb_keyer_read, rb->scl_extra_read, rb->blnd_read,
+				 rb->fmt_extra_read, rb->enc_read);
+	if (rb->mi_read && (rb->grph_depth != 2 || rb->grph_format || rb->grph_expansion != 1 ||
+			    rb->grph_crossbar_red || rb->grph_crossbar_blue))
+		len += scnprintf(buf + len, size - len,
+				 "%sthe surface enters at depth %u, format %u, expansion %u, crossbars %u/%u, not as XRGB8888 with zero expansion",
+				 len ? "; " : "", rb->grph_depth, rb->grph_format, rb->grph_expansion,
+				 rb->grph_crossbar_red, rb->grph_crossbar_blue);
+	if (rb->cursor_read && rb->cursor_en)
+		len += scnprintf(buf + len, size - len, "%sthe cursor is on", len ? "; " : "");
+	if (rb->lb_keyer_read && rb->lb_keyer != rb->lb_keyer_set)
+		len += scnprintf(buf + len, size - len, "%sline buffer keyer %#x, not %#x",
+				 len ? "; " : "", rb->lb_keyer, rb->lb_keyer_set);
+	if (rb->blnd_read && rb->blnd_control != rb->blnd_control_set)
+		len += scnprintf(buf + len, size - len, "%sblender %u control %#x, not %#x",
+				 len ? "; " : "", rb->blnd_inst, rb->blnd_control,
+				 rb->blnd_control_set);
+	if (rb->blnd_read && rb->blnd_control2 != rb->blnd_control2_set)
+		len += scnprintf(buf + len, size - len, "%sblender %u control2 %#x, not %#x",
+				 len ? "; " : "", rb->blnd_inst, rb->blnd_control2,
+				 rb->blnd_control2_set);
+	if (rb->fmt_extra_read && (rb->fmt_subsampling_mode || rb->fmt_cbcr_bypass))
+		len += scnprintf(buf + len, size - len,
+				 "%sformatter subsampling %u, chroma bit reduction bypass %u",
+				 len ? "; " : "", rb->fmt_subsampling_mode, rb->fmt_cbcr_bypass);
+	if (rb->enc_read && (rb->enc_deep_color_en || rb->enc_deep_color_depth ||
+			     rb->enc_pixel_encoding || rb->enc_color_format))
+		len += scnprintf(buf + len, size - len,
+				 "%sthe HDMI link has deep colour %u (depth %u), pixel encoding %u, colour format %u, not RGB at 8 bpc",
+				 len ? "; " : "", rb->enc_deep_color_en, rb->enc_deep_color_depth,
+				 rb->enc_pixel_encoding, rb->enc_color_format);
+	if (rb->enc_read && rb->enc_avmute)
+		len += scnprintf(buf + len, size - len, "%sthe HDMI encoder holds AV mute",
+				 len ? "; " : "");
+	return len != 0;
+}
+
+#define DVBRIDGE_DCE_STAGES_FORMAT \
+	"surface depth %u, format %u, expansion %u, crossbars %u/%u; cursor %u; DCP keyer %u, alpha control %#x; line buffer keyer found %#x, set %#x, reads %#x; scaler bypass mode %u, sharpness %#x, rounding offset %#x; blender %u: control as DC left it %#x, set %#x, reads %#x, control2 found %#x, set %#x, reads %#x; formatter subsampling %u, chroma bit reduction bypass %u, source %u; HDMI deep colour %u (depth %u), pixel encoding %u, colour format %u, AV mute %u"
+#define DVBRIDGE_DCE_STAGES_VALUES(rb) \
+	(rb)->grph_depth, (rb)->grph_format, (rb)->grph_expansion, (rb)->grph_crossbar_red, \
+	(rb)->grph_crossbar_blue, (rb)->cursor_en, (rb)->key_mode, (rb)->alpha_control, \
+	(rb)->lb_keyer_before, (rb)->lb_keyer_set, (rb)->lb_keyer, (rb)->scl_bypass_mode, \
+	(rb)->scl_f_sharp, (rb)->scl_round_offset, (rb)->blnd_inst, (rb)->blnd_control_dc, \
+	(rb)->blnd_control_set, (rb)->blnd_control, (rb)->blnd_control2_before, \
+	(rb)->blnd_control2_set, (rb)->blnd_control2, (rb)->fmt_subsampling_mode, \
+	(rb)->fmt_cbcr_bypass, (rb)->fmt_src_select, (rb)->enc_deep_color_en, \
+	(rb)->enc_deep_color_depth, (rb)->enc_pixel_encoding, (rb)->enc_color_format, \
+	(rb)->enc_avmute
+
 #define DVBRIDGE_DCE_READBACK_FORMAT \
 	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u, reduction %u, dynamic depth %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s; formatter expansion during the tunnel: %s (amdgpu.dvbridge_dce_expansion=%d)"
 #define DVBRIDGE_DCE_READBACK_VALUES(rb, enc) \
@@ -2604,31 +2680,62 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
  * cannot be made, refuses every commit of the tunnel from then on, the frames of the video playing
  * among them (amdgpu_dm_dvbridge_readback_verdict()). With the DC lock held.
  */
+/* Hades: what amdgpu_dm_dvbridge_log_dce() reads and writes, off the stack */
+struct amdgpu_dm_dvbridge_dce_log {
+	struct dc_byte_tunnel_readback rb;
+	char why[384];
+	char stages_why[512];
+};
+
 void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_state *stream)
 {
 	struct amdgpu_display_manager *dm = &drm_to_adev(crtc->dev)->dm;
 	const struct link_encoder *enc = stream->link ? stream->link->link_enc : NULL;
 	const char *name = amdgpu_dm_dvbridge_dce_name(stream->ctx->dce_version);
-	struct dc_byte_tunnel_readback rb;
-	char why[384];
+	struct amdgpu_dm_dvbridge_dce_log *l = kzalloc(sizeof(*l), GFP_KERNEL);
 
-	if (!dc_stream_read_byte_tunnel(stream->ctx->dc, stream, &rb) &&
-	    !rb.ipp_read && !rb.xfm_read && !rb.opp_read) {
+	if (!l) {
 		amdgpu_dm_dvbridge_readback_verdict(dm, false);
 		drm_warn(crtc->dev,
-			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: its pipe could not be read back; " DVBRIDGE_READBACK_REFUSED "\n",
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: no memory to read its pipe back; " DVBRIDGE_READBACK_REFUSED "\n",
 			 crtc->base.id, crtc->name, name);
 		return;
 	}
-	if (amdgpu_dm_dvbridge_dce_readback_why(&rb, why, sizeof(why))) {
+	if (!dc_stream_read_byte_tunnel(stream->ctx->dc, stream, &l->rb) &&
+	    !l->rb.ipp_read && !l->rb.xfm_read && !l->rb.opp_read) {
+		amdgpu_dm_dvbridge_readback_verdict(dm, false);
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: its pipe could not be read back; " DVBRIDGE_READBACK_REFUSED "\n",
+			 crtc->base.id, crtc->name, name);
+		goto out;
+	}
+	if (amdgpu_dm_dvbridge_dce_readback_why(&l->rb, l->why, sizeof(l->why))) {
 		amdgpu_dm_dvbridge_readback_verdict(dm, false);
 		drm_warn(crtc->dev,
 			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back NOT as the tunnel needs (%s): " DVBRIDGE_DCE_READBACK_FORMAT "; " DVBRIDGE_READBACK_REFUSED "\n",
-			 crtc->base.id, crtc->name, name, why, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
+			 crtc->base.id, crtc->name, name, l->why, DVBRIDGE_DCE_READBACK_VALUES(&l->rb, enc));
 	} else
 		drm_info(crtc->dev,
 			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back as the tunnel needs: " DVBRIDGE_DCE_READBACK_FORMAT "\n",
-			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
+			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_READBACK_VALUES(&l->rb, enc));
+
+	/*
+	 * Hades (issue #20): the other stages up to the HDMI encoder, on a line of their own (the one
+	 * above is near the length of a kernel log line): for each one that the tunnel sets, what it
+	 * found, what it set and what reads back; with the same consequence
+	 */
+	if (amdgpu_dm_dvbridge_dce_stages_why(&l->rb, l->stages_why, sizeof(l->stages_why))) {
+		amdgpu_dm_dvbridge_readback_verdict(dm, false);
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: stages up to the HDMI encoder NOT as the tunnel needs (%s): " DVBRIDGE_DCE_STAGES_FORMAT "; " DVBRIDGE_READBACK_REFUSED "\n",
+			 crtc->base.id, crtc->name, name, l->stages_why,
+			 DVBRIDGE_DCE_STAGES_VALUES(&l->rb));
+	} else
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: stages up to the HDMI encoder as the tunnel needs: " DVBRIDGE_DCE_STAGES_FORMAT "\n",
+			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_STAGES_VALUES(&l->rb));
+out:
+	kfree(l);
 }
 
 /* Hades: the name of a DCN 4.2 version, for the kernel log */
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index ced5cf5..0ed4b55 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -59,6 +59,8 @@ struct dc_state;
 bool amdgpu_dm_dvbridge_dce_pipe_why(const struct dc_state *context,
 				     const struct dc_stream_state *stream, char *buf, size_t size);
 int amdgpu_dm_dvbridge_check_dce(struct drm_atomic_commit *state, const struct dc_state *context);
+bool amdgpu_dm_dvbridge_dce_stages_why(const struct dc_byte_tunnel_readback *rb, char *buf,
+					size_t size);
 bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *rb, char *buf,
 					 size_t size);
 void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_state *stream);
diff --git a/drivers/gpu/drm/amd/display/dc/core/dc.c b/drivers/gpu/drm/amd/display/dc/core/dc.c
index 91b5ebe..c143667 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -908,6 +908,18 @@ bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *str
 								      readback);
 	if (pipe->stream_res.opp && pipe->stream_res.opp->funcs->opp_read_byte_tunnel)
 		pipe->stream_res.opp->funcs->opp_read_byte_tunnel(pipe->stream_res.opp, readback);
+	/*
+	 * Hades (issue #20): the other stages between the plane and the HDMI encoder: the memory
+	 * input, the blender of the pipe (DCE only: dce_hwseq.c) and the HDMI encoder
+	 */
+	if (pipe->plane_res.mi && pipe->plane_res.mi->funcs->mem_input_read_byte_tunnel)
+		pipe->plane_res.mi->funcs->mem_input_read_byte_tunnel(pipe->plane_res.mi, readback);
+	if (dc->hwseq && pipe->stream_res.tg && stream->ctx->dce_version < DCE_VERSION_MAX)
+		dce_read_blender_byte_tunnel(dc->hwseq, pipe->stream_res.tg->inst, readback);
+	if (pipe->stream_res.stream_enc &&
+	    pipe->stream_res.stream_enc->funcs->se_read_byte_tunnel_dce)
+		pipe->stream_res.stream_enc->funcs->se_read_byte_tunnel_dce(pipe->stream_res.stream_enc,
+									    readback);
 	return readback->ipp_read && readback->xfm_read && readback->opp_read;
 }
 
diff --git a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
index a0747e5..9585962 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
@@ -1361,6 +1361,64 @@ struct dc_byte_tunnel_readback {
 	uint32_t fmt_pixel_encoding;	/* FMT_CONTROL */
 	/* the stream turns the dynamic expansion off (dc_stream_state.byte_tunnel_no_expansion) */
 	bool no_expansion;
+
+	/*
+	 * Hades (issue #20): every other stage between the plane and the HDMI encoder that can change
+	 * a component, on DCE 11.2 and 12. Those that DC never programs, or programs in a way the
+	 * tunnel does not want, the tunnel sets and gives back when it ends (*_before: what it found
+	 * there, *_set: what it wrote, the field itself: what reads back now); the others are read.
+	 * *_read: the block has the registers and masks for them (a missing one reads 0, which could
+	 * look like a bypass), and for a stage that the tunnel sets, the tunnel holds it now.
+	 */
+	/* memory input: how the 8-bit components enter the pipe */
+	bool mi_read;
+	uint32_t grph_depth;		/* GRPH_CONTROL.GRPH_DEPTH, 2: 32 bpp */
+	uint32_t grph_format;		/* GRPH_CONTROL.GRPH_FORMAT, 0: ARGB8888 */
+	uint32_t grph_expansion;	/* GRPH_CONTROL.GRPH_COLOR_EXPANSION_MODE, 1: zero expansion */
+	/*
+	 * GRPH_SWAP_CNTL.GRPH_RED_CROSSBAR and GRPH_BLUE_CROSSBAR, 0: own component (the two that
+	 * program_grph_pixel_format() writes, swapping red and blue for the ABGR formats)
+	 */
+	uint32_t grph_crossbar_red;
+	uint32_t grph_crossbar_blue;
+	/* DCP: the cursor, drawn over the plane */
+	bool cursor_read;
+	uint32_t cursor_en;		/* CUR_CONTROL.CURSOR_EN */
+	/* DCP: the keyer and the alpha of the graphics pipe */
+	bool dcp_extra_read;
+	uint32_t key_mode;		/* KEY_CONTROL.KEY_MODE (read: it makes an alpha, not a colour) */
+	uint32_t alpha_control;		/* ALPHA_CONTROL, whole (read) */
+	/* line buffer keyer: replaces a keyed colour (LB_KEYER_COLOR_CTRL, whole) */
+	bool lb_keyer_read;
+	uint32_t lb_keyer_before;
+	uint32_t lb_keyer_set;
+	uint32_t lb_keyer;
+	/* scaler in bypass: what DC does not write there (read) */
+	bool scl_extra_read;
+	uint32_t scl_bypass_mode;	/* SCL_BYPASS_CONTROL.SCL_BYPASS_MODE */
+	uint32_t scl_f_sharp;		/* SCL_F_SHARP_CONTROL, whole */
+	uint32_t scl_round_offset;	/* SCL_ROUND_OFFSET, whole */
+	/* blender of the pipe (BLND_CONTROL and BLND_CONTROL2, whole) */
+	bool blnd_read;
