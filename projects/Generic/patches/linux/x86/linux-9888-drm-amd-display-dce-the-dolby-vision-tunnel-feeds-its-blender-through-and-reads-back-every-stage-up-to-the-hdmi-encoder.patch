+		readback->blnd_control_dc = readback->blnd_control;
+		readback->blnd_control2_before = readback->blnd_control2;
+	}
+	readback->blnd_control_set = readback->blnd_control_dc | hws->masks->BLND_FEEDTHROUGH_EN;
+	readback->blnd_control2_set = readback->blnd_control2_before & ~superaa;
+	readback->blnd_read = hws->blnd_tunnel_held[blnd_inst];
+}
