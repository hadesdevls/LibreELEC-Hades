From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:41:05 +0000
Subject: [PATCH] drm/amd/display: DCE: the read back of the tunnel names the
 line buffer's reduction and dynamic depth

Issue #20 (SunnySnacks): an RX 550 (Polaris 12, DCE 11.2) changes the bytes
of the Dolby Vision tunnel with the formatter's dynamic expansion off
(linux-9859, amdgpu.dvbridge_dce_expansion=N), and the check of its output
says what kind of change is left: each component on its own (red moves only
the red CRC, green the green, blue the blue), the same at every frame, every
bit reaching the CRC. Its read back (linux-9969, 9970) found every register it
reads as the tunnel needs: prescale bypass, input gamma bypass, input CSC,
degamma, gamut remap, regamma and output CSC in bypass, denormalisation at
unity, the DCP clamp at 0-0x3fc0, truncation to 8 bits, no DCP dither, the
line buffer at 24 bpp, the scaler in bypass, and in the formatter truncation
to 8 bits, no dither, no clamp, RGB.

A per-component change that is the same at every frame is a curve, a range, a
rounding, or a dither that depends on the position of the pixel and not on
the frame: the check rules out only a temporal one. The line buffer has two
fields that DC never programs on DCE, so they keep what the VBIOS or a reset
left there: PIXEL_REDUCE_MODE (rounding or truncation where the line buffer
stores fewer bits than it is given) and DYNAMIC_PIXEL_DEPTH (a depth the line
buffer may choose by itself). The read back did not read them. It now does,
on DCE 10, 11, 11.2 and 12 (the register lists of DCE 6 and 8 have no mask
for them and read 0), and the kernel log line of the tunnel says them:
"line buffer 1 (expansion 1, reduction R, dynamic depth D)". They are read,
not judged: what each value does to an 8-bit pixel at 24 bpp is not
documented, and the next check on the card says whether one of them is what
changes the bytes. Nothing is programmed differently.
---
 .../drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c    |  4 ++--
 drivers/gpu/drm/amd/display/dc/dc_hw_types.h           |  6 ++++++
 drivers/gpu/drm/amd/display/dc/dce/dce_transform.c     |  4 ++++
 drivers/gpu/drm/amd/display/dc/dce/dce_transform.h     | 10 ++++++++--
 4 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 1a5e210..7bb94aa 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -2542,14 +2542,14 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
 }
 
 #define DVBRIDGE_DCE_READBACK_FORMAT \
-	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s; formatter expansion during the tunnel: %s (amdgpu.dvbridge_dce_expansion=%d)"
+	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u, reduction %u, dynamic depth %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s; formatter expansion during the tunnel: %s (amdgpu.dvbridge_dce_expansion=%d)"
 #define DVBRIDGE_DCE_READBACK_VALUES(rb, enc) \
 	(rb)->prescale_bypass, (rb)->input_gamma_mode, (rb)->input_csc_mode, \
 	(rb)->input_csc_mode_before, (rb)->degamma_mode, (rb)->gamut_remap_mode, (rb)->regamma_mode, \
 	(rb)->output_csc_mode, (rb)->denorm_mode, (rb)->clamp_min[0], (rb)->clamp_max[0], \
 	(rb)->clamp_min[1], (rb)->clamp_max[1], (rb)->clamp_min[2], (rb)->clamp_max[2], \
 	(rb)->round_trunc_mode, (rb)->dcp_dither_en, (rb)->lb_pixel_depth, (rb)->lb_expan_mode, \
-	(rb)->scl_mode, (rb)->fmt_truncate_en, (rb)->fmt_truncate_depth, (rb)->fmt_truncate_mode, \
+	(rb)->lb_reduce_mode, (rb)->lb_dynamic_depth, (rb)->scl_mode, (rb)->fmt_truncate_en, (rb)->fmt_truncate_depth, (rb)->fmt_truncate_mode, \
 	(rb)->fmt_spatial_dither_en, (rb)->fmt_temporal_dither_en, (rb)->fmt_clamp_en, \
 	(rb)->fmt_clamp_color_format, (rb)->fmt_dyn_exp_en, (rb)->fmt_dyn_exp_mode, \
 	(rb)->fmt_pixel_encoding, (enc) ? (enc)->features.max_hdmi_pixel_clock : 0, \
diff --git a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
index ec3bb56..687d0b0 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
@@ -1329,6 +1329,12 @@ struct dc_byte_tunnel_readback {
 	uint32_t dcp_dither_en;		/* DCP_SPATIAL_DITHER_CNTL.DCP_SPATIAL_DITHER_EN */
 	uint32_t lb_pixel_depth;	/* LB_DATA_FORMAT.PIXEL_DEPTH, 1: 24 bpp */
 	uint32_t lb_expan_mode;		/* LB_DATA_FORMAT.PIXEL_EXPAN_MODE */
+	/*
+	 * LB_DATA_FORMAT.PIXEL_REDUCE_MODE and DYNAMIC_PIXEL_DEPTH, which DC never programs: they
+	 * keep what the VBIOS or a reset left there (issue #20: read, not judged)
+	 */
+	uint32_t lb_reduce_mode;
+	uint32_t lb_dynamic_depth;
 	uint32_t scl_mode;		/* SCL_MODE.SCL_MODE, 0: bypass */
 	/* formatter */
 	uint32_t fmt_truncate_en;	/* FMT_BIT_DEPTH_CONTROL */
diff --git a/drivers/gpu/drm/amd/display/dc/dce/dce_transform.c b/drivers/gpu/drm/amd/display/dc/dce/dce_transform.c
index e279ec9..d677681 100644
--- a/drivers/gpu/drm/amd/display/dc/dce/dce_transform.c
+++ b/drivers/gpu/drm/amd/display/dc/dce/dce_transform.c
@@ -1633,6 +1633,10 @@ static void dce_transform_read_byte_tunnel(struct transform *xfm,
 	REG_GET_2(LB_DATA_FORMAT,
 		  PIXEL_DEPTH, &readback->lb_pixel_depth,
 		  PIXEL_EXPAN_MODE, &readback->lb_expan_mode);
+	/* Hades: issue #20 (not on DCE 6 and 8, whose lists have no mask for them: read as 0) */
+	REG_GET_2(LB_DATA_FORMAT,
+		  PIXEL_REDUCE_MODE, &readback->lb_reduce_mode,
+		  DYNAMIC_PIXEL_DEPTH, &readback->lb_dynamic_depth);
 	REG_GET(SCL_MODE, SCL_MODE, &readback->scl_mode);
 	readback->xfm_read = true;
 }
diff --git a/drivers/gpu/drm/amd/display/dc/dce/dce_transform.h b/drivers/gpu/drm/amd/display/dc/dce/dce_transform.h
index eb716e8..c9e80cc 100644
--- a/drivers/gpu/drm/amd/display/dc/dce/dce_transform.h
+++ b/drivers/gpu/drm/amd/display/dc/dce/dce_transform.h
@@ -267,7 +267,9 @@
 	XFM_SF(DCFE_MEM_PWR_CTRL, DCP_REGAMMA_MEM_PWR_DIS, mask_sh),\
 	XFM_SF(DCFE_MEM_PWR_CTRL, DCP_LUT_MEM_PWR_DIS, mask_sh),\
 	XFM_SF(DCFE_MEM_PWR_STATUS, DCP_REGAMMA_MEM_PWR_STATE, mask_sh),\
-	XFM_SF(SCL_MODE, SCL_PSCL_EN, mask_sh)
+	XFM_SF(SCL_MODE, SCL_PSCL_EN, mask_sh), \
+	XFM_SF(LB_DATA_FORMAT, PIXEL_REDUCE_MODE, mask_sh), \
+	XFM_SF(LB_DATA_FORMAT, DYNAMIC_PIXEL_DEPTH, mask_sh)
 
 #if defined(CONFIG_DRM_AMD_DC_SI)
 #define XFM_COMMON_MASK_SH_LIST_DCE60(mask_sh) \
@@ -427,7 +429,9 @@
 	XFM_SF(DCFE0_DCFE_MEM_PWR_CTRL, DCP_REGAMMA_MEM_PWR_DIS, mask_sh),\
 	XFM_SF(DCFE0_DCFE_MEM_PWR_CTRL, DCP_LUT_MEM_PWR_DIS, mask_sh),\
 	XFM_SF(DCFE0_DCFE_MEM_PWR_STATUS, SCL_COEFF_MEM_PWR_STATE, mask_sh), \
-	XFM_SF(SCL0_SCL_MODE, SCL_PSCL_EN, mask_sh)
+	XFM_SF(SCL0_SCL_MODE, SCL_PSCL_EN, mask_sh), \
+	XFM_SF(LB0_LB_DATA_FORMAT, PIXEL_REDUCE_MODE, mask_sh), \
+	XFM_SF(LB0_LB_DATA_FORMAT, DYNAMIC_PIXEL_DEPTH, mask_sh)
 
 #define XFM_REG_FIELD_LIST(type) \
 	type OUT_CLAMP_MIN_B_CB; \
@@ -447,6 +451,8 @@
 	type INTERLEAVE_EN; \
 	type PIXEL_DEPTH; \
 	type PIXEL_EXPAN_MODE; \
+	type PIXEL_REDUCE_MODE; \
+	type DYNAMIC_PIXEL_DEPTH; \
 	type GAMUT_REMAP_C11; \
 	type GAMUT_REMAP_C12; \
 	type GAMUT_REMAP_C13; \
-- 
