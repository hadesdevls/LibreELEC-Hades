From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:59:15 +0000
Subject: [PATCH] drm/i915/dp: HADES_BOOT_OPTION names pcon_hd_audio where a
 converter is behind the port
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The display parameter pcon_hd_audio (linux-9891) reaches i915, which is
built into the kernel, only from the kernel line, and was to be put
there by hand. Kodi offers such a parameter as a setting where the
connector of its output names it in HADES_BOOT_OPTION, an immutable
property (linux-9989), and writes it into the boot menus
(internal-disks).

Every DisplayPort connector that is not eDP now has HADES_BOOT_OPTION
with two values: the parameter as it is written on the kernel line
("i915.pcon_hd_audio", or "xe.pcon_hd_audio" under xe), and an empty
name, which Kodi takes as no option. Its value follows each detect: it
names the parameter where a DisplayPort to HDMI converter is behind the
port (the port's DPCD: a branch device of the HDMI type with an HDMI
sink, the same test the parameter acts on), and nothing elsewhere, so
the setting is shown only where it can act; a DisplayPort monitor never
sees it. The kernel log says each change once (the detect takes the
EDID away before it reads it again, so only what a detect found is
said; no converter where there was none before is not said).

The test of the converter moves into intel_pcon_audio.h, with the value
of the property and when it is said, so the host test runs them: 47
checks, five more mutants caught (named without a converter, a
converter without an HDMI sink, said at every detect, nothing said,
the attached value naming the parameter); with the header of
linux-9891 the test does not build. Compiled with W=1 for i915 and xe:
no warning. Not tried on hardware.

After the finding of PR #29 by Felix Oghină.
---
 .../drm/i915/display/intel_display_types.h    |  6 ++
 drivers/gpu/drm/i915/display/intel_dp.c       | 77 ++++++++++++++++++-
 .../gpu/drm/i915/display/intel_pcon_audio.h   | 47 +++++++++++
 3 files changed, 127 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index dda28e5..3857b67 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -552,6 +552,12 @@ struct intel_connector {
 	struct drm_dp_dpcd_ident dv_converter_told_ident;
 	/* Hades: what i915.pcon_hd_audio last did here, as the kernel log told it (intel_dp.c) */
 	u8 pcon_audio_told;
+	/*
+	 * Hades: HADES_BOOT_OPTION of a DisplayPort connector, which names pcon_hd_audio where a
+	 * converter is behind the port, and what the kernel log last said of it (intel_dp.c)
+	 */
+	struct drm_property *pcon_audio_boot_option;
+	u8 pcon_audio_boot_told;
 	struct drm_dvbridge_refused_log dv_refused_log;
 	/*
 	 * Hades: DVBRIDGE_LINK_FORMAT, what a request of the guard found the configuration sends
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index b733f3a..d535703 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3409,6 +3409,15 @@ intel_dp_compute_formats(struct intel_encoder *encoder,
 	return ret;
 }
 
+/* Hades: a DisplayPort to HDMI converter is behind the port, as its DPCD says */
+static bool intel_dp_pcon_audio_converter(struct intel_dp *intel_dp)
+{
+	return intel_pcon_audio_converter(drm_dp_is_branch(intel_dp->dpcd),
+					  (intel_dp->downstream_ports[0] & DP_DS_PORT_TYPE_MASK) ==
+					  DP_DS_PORT_TYPE_HDMI,
+					  intel_dp_has_hdmi_sink(intel_dp));
+}
+
 /*
  * Hades: the display parameter pcon_hd_audio (off by default; intel_pcon_audio.h). The ELD of a
  * display behind a DisplayPort to HDMI converter whose display data declare stereo PCM only is
@@ -3429,9 +3438,7 @@ static void intel_dp_pcon_audio(struct intel_dp *intel_dp, struct intel_crtc_sta
 
 	if (!display->params.pcon_hd_audio || intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP_MST))
 		return;
-	converter = drm_dp_is_branch(intel_dp->dpcd) &&
-		(intel_dp->downstream_ports[0] & DP_DS_PORT_TYPE_MASK) == DP_DS_PORT_TYPE_HDMI &&
-		intel_dp_has_hdmi_sink(intel_dp);
+	converter = intel_dp_pcon_audio_converter(intel_dp);
 	if (converter) {
 		kind = intel_pcon_audio_eld_kind(eld, sizeof(crtc_state->eld));
 		if (kind == INTEL_PCON_AUDIO_ELD_STEREO)
@@ -3458,6 +3465,64 @@ static void intel_dp_pcon_audio(struct intel_dp *intel_dp, struct intel_crtc_sta
 			 intel_pcon_audio_eld_name(kind));
 }
 
+/*
+ * Hades: HADES_BOOT_OPTION on a DisplayPort connector that is not eDP (intel_pcon_audio.h). It
+ * names the parameter as it is written on the kernel line, "i915.pcon_hd_audio" (or the xe one),
+ * where a DisplayPort to HDMI converter is behind the port, and nothing elsewhere: Kodi offers the
+ * setting of it (which internal-disks writes into the boot menus) only where it can act. Its value
+ * follows each detect.
+ */
+static void intel_dp_pcon_audio_add_property(struct intel_dp *intel_dp,
+					     struct intel_connector *connector)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	char name[DRM_PROP_NAME_LEN];
+	const struct drm_prop_enum_list values[] = {
+		{ INTEL_PCON_AUDIO_BOOT_OPTION_NONE, "" },
+		{ INTEL_PCON_AUDIO_BOOT_OPTION_NAMED, name },
+	};
+
+	if (intel_dp_is_edp(intel_dp))
+		return;
+	scnprintf(name, sizeof(name), "%s.pcon_hd_audio", dev_driver_string(display->drm->dev));
+	connector->pcon_audio_boot_option =
+		drm_property_create_enum(display->drm, DRM_MODE_PROP_IMMUTABLE, "HADES_BOOT_OPTION",
+					 values, ARRAY_SIZE(values));
+	if (connector->pcon_audio_boot_option)
+		drm_object_attach_property(&connector->base.base, connector->pcon_audio_boot_option,
+					   INTEL_PCON_AUDIO_BOOT_OPTION_NONE);
+}
+
+/*
+ * The value of HADES_BOOT_OPTION after a detect (connected) or when the display goes. The detect
+ * takes the EDID away before it reads it again, so the kernel log says it only for what a detect
+ * found, and once for each change: that the setting is offered, or that it no longer is.
+ */
+static void intel_dp_pcon_audio_update(struct intel_dp *intel_dp, bool connected)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	enum intel_pcon_audio_boot_option value;
+
+	if (!connector->pcon_audio_boot_option)
+		return;
+	value = intel_pcon_audio_boot_option(connected, intel_dp_pcon_audio_converter(intel_dp));
+	drm_object_property_set_value(&connector->base.base, connector->pcon_audio_boot_option,
+				      value);
+	if (!intel_pcon_audio_boot_say(&connector->pcon_audio_boot_told, connected, value))
+		return;
+	if (value == INTEL_PCON_AUDIO_BOOT_OPTION_NAMED)
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] HADES_BOOT_OPTION %s.pcon_hd_audio: a DisplayPort to HDMI converter is behind this port, and Kodi offers the setting of its sound (the parameter is %s now)\n",
+			 connector->base.base.id, connector->base.name,
+			 dev_driver_string(display->drm->dev),
+			 display->params.pcon_hd_audio ? "on" : "off");
+	else
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] HADES_BOOT_OPTION names nothing: no DisplayPort to HDMI converter is behind this port now\n",
+			 connector->base.base.id, connector->base.name);
+}
+
 void
 intel_dp_audio_compute_config(struct intel_encoder *encoder,
 			      struct intel_crtc_state *pipe_config,
@@ -6600,6 +6665,9 @@ intel_dp_set_edid(struct intel_dp *intel_dp)
 		intel_dp_pcon_dv_update(intel_dp, true);
 	}
 
+	/* Hades: HADES_BOOT_OPTION of the sound behind a converter, as this detect found it */
+	intel_dp_pcon_audio_update(intel_dp, true);
+
 	drm_dp_cec_attach(&intel_dp->aux,
 			  connector->base.display_info.source_physical_address);
 }
@@ -6628,6 +6696,7 @@ intel_dp_unset_edid(struct intel_dp *intel_dp)
 		drm_dvbridge_edid_read(NULL, 0, &connector->dv_sink);
 		intel_dp_pcon_dv_update(intel_dp, false);
 	}
+	intel_dp_pcon_audio_update(intel_dp, false);
 
 	drm_connector_set_vrr_capable_property(&connector->base,
 					       false);
@@ -7363,6 +7432,8 @@ intel_dp_add_properties(struct intel_dp *intel_dp, struct drm_connector *_connec
 
 	/* Hades: the tunnel through the converter of the board, where the port can carry it */
 	intel_dp_pcon_dv_add_properties(intel_dp, _connector);
+	/* Hades: pcon_hd_audio named where a converter is behind the port (HADES_BOOT_OPTION) */
+	intel_dp_pcon_audio_add_property(intel_dp, connector);
 
 	if (intel_dp_has_gamut_metadata_dip(&dp_to_dig_port(intel_dp)->base))
 		drm_connector_attach_hdr_output_metadata_property(&connector->base);
diff --git a/drivers/gpu/drm/i915/display/intel_pcon_audio.h b/drivers/gpu/drm/i915/display/intel_pcon_audio.h
index 4699f59..974c521 100644
--- a/drivers/gpu/drm/i915/display/intel_pcon_audio.h
+++ b/drivers/gpu/drm/i915/display/intel_pcon_audio.h
@@ -55,6 +55,53 @@ enum intel_pcon_audio_eld {
 	INTEL_PCON_AUDIO_ELD_INVALID,
 };
 
+/*
+ * Whether a DisplayPort to HDMI converter is behind a port, as its DPCD says: a branch device whose
+ * first downstream port is of the HDMI type, with an HDMI sink behind it. Only there does the
+ * parameter act on the ELD, and only there does the connector name the parameter for Kodi.
+ */
+static inline bool intel_pcon_audio_converter(bool branch, bool dfp_hdmi, bool hdmi_sink)
+{
+	return branch && dfp_hdmi && hdmi_sink;
+}
+
+/*
+ * HADES_BOOT_OPTION of a DisplayPort connector (not eDP): the parameter as it is written on the
+ * kernel line ("i915.pcon_hd_audio") where a converter is behind the port, so that Kodi offers its
+ * setting there and nowhere else, and an empty name elsewhere, which Kodi takes as no option.
+ */
+enum intel_pcon_audio_boot_option {
+	INTEL_PCON_AUDIO_BOOT_OPTION_NONE,
+	INTEL_PCON_AUDIO_BOOT_OPTION_NAMED,
+};
+
+/* HADES_BOOT_OPTION after a detect: named only where a display is behind a converter */
+static inline enum intel_pcon_audio_boot_option intel_pcon_audio_boot_option(bool connected,
+									    bool converter)
+{
+	return connected && converter ? INTEL_PCON_AUDIO_BOOT_OPTION_NAMED :
+					INTEL_PCON_AUDIO_BOOT_OPTION_NONE;
+}
+
+/*
+ * Whether the kernel log says the value now; @told is what it said last (0 nothing yet, else 1 +
+ * the value). A detect takes the EDID away before it reads it again, so only what a detect found
+ * (@connected) is said, once for each change; no converter where there was none before is not
+ * said.
+ */
+static inline bool intel_pcon_audio_boot_say(u8 *told, bool connected,
+					     enum intel_pcon_audio_boot_option value)
+{
+	bool say;
+
+	if (!connected || *told == 1 + value)
+		return false;
+	say = value == INTEL_PCON_AUDIO_BOOT_OPTION_NAMED ||
+	      *told == 1 + INTEL_PCON_AUDIO_BOOT_OPTION_NAMED;
+	*told = 1 + value;
+	return say;
+}
+
 static inline const char *intel_pcon_audio_eld_name(enum intel_pcon_audio_eld kind)
 {
 	switch (kind) {
-- 
2.53.0

