From 70a13a8fa95a051ff22ec3fcfa0e09dfe935beea Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:01:49 +0000
Subject: [PATCH] drm/i915: BT.2020 in the AVI InfoFrame of the Dolby
 Vision tunnel, as a connector property

DVBRIDGE_DV_AVI_BT2020_LAB, a connector property next to
DVBRIDGE_DV_HDMI14B_LAB and with its rules (HDMI connectors,
enable_dv_lab, dropped with the CRTC and for the console, a change with
the tunnel on is a full modeset): with DVBRIDGE_DV_STANDARD_LAB, the AVI
InfoFrame of the tunnel says the extended colorimetry BT.2020
(drm_dvbridge_tunnel_avi_bt2020()), as licensed players send it. Low-
Latency and HDR over the tunnel set their own colorimetry after it, as
before. The tunnel through a DisplayPort to HDMI converter is not
concerned.

Why: to compare on a display what a licensed player sends with what
Hades sends. With the property 0 (its default) nothing changes. No new
warnings with the flags of the build.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 22 +++++++++++++++++++
 .../drm/i915/display/intel_display_types.h    |  8 +++++++
 drivers/gpu/drm/i915/display/intel_hdmi.c     |  9 ++++++++
 3 files changed, 39 insertions(+)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index 312936d..1f4d68d 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -79,6 +79,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_hdmi14b;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_lab_avi_bt2020_property &&
+	    property == to_intel_connector(connector)->dv_lab_avi_bt2020_property) {
+		*val = intel_conn_state->dv_lab_avi_bt2020;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_lab_hdr10t_property &&
 	    property == to_intel_connector(connector)->dv_lab_hdr10t_property) {
 		*val = intel_conn_state->dv_lab_hdr10t;
@@ -161,6 +166,16 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_hdmi14b = val;
 		return 0;
 	}
+	/* Hades: BT.2020 in the AVI InfoFrame of the tunnel (drm_dvbridge.h) */
+	if (to_intel_connector(connector)->dv_lab_avi_bt2020_property &&
+	    property == to_intel_connector(connector)->dv_lab_avi_bt2020_property) {
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !display->params.enable_dv_lab)
+			return -EOPNOTSUPP;
+		intel_conn_state->dv_lab_avi_bt2020 = val;
+		return 0;
+	}
 	/* Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) */
 	if (to_intel_connector(connector)->dv_lab_hdr10t_property &&
 	    property == to_intel_connector(connector)->dv_lab_hdr10t_property) {
@@ -223,6 +238,8 @@ void intel_digital_connector_client_restore(struct drm_connector *connector,
 	s->dv_lab_low_latency = false;
 	/* (Hades: the HDMI 1.4b signal goes with the tunnel, which the line above names) */
 	s->dv_lab_hdmi14b = false;
+	/* (Hades: ... and BT.2020 in its AVI InfoFrame) */
+	s->dv_lab_avi_bt2020 = false;
 	/* (Hades: ... and HDR over it) */
 	s->dv_lab_hdr10t = false;
 	s->dv_hdr10_deep_color = false;
@@ -249,6 +266,8 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 		new_conn_state->dv_lab_low_latency = false;
 		/* Hades: ... and its HDMI 1.4b signal */
 		new_conn_state->dv_lab_hdmi14b = false;
+		/* Hades: ... and BT.2020 in its AVI InfoFrame */
+		new_conn_state->dv_lab_avi_bt2020 = false;
 		/* Hades: ... and HDR over it */
 		new_conn_state->dv_lab_hdr10t = false;
 		/* Hades: a disabled connector drops the HDR10 depth guard as well */
@@ -272,6 +291,9 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	     new_conn_state->dv_lab_low_latency != old_conn_state->dv_lab_low_latency) ||
 	    (new_conn_state->dv_lab_standard &&
 	     new_conn_state->dv_lab_hdmi14b != old_conn_state->dv_lab_hdmi14b) ||
+	    /* Hades: ... and to BT.2020 in the AVI InfoFrame of the tunnel or back */
+	    (new_conn_state->dv_lab_standard &&
+	     new_conn_state->dv_lab_avi_bt2020 != old_conn_state->dv_lab_avi_bt2020) ||
 	    /* Hades: ... and to HDR over the tunnel or back: other InfoFrames and another format */
 	    (new_conn_state->dv_lab_standard &&
 	     new_conn_state->dv_lab_hdr10t != old_conn_state->dv_lab_hdr10t) ||
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 0a34408..96b57f9 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -531,6 +531,8 @@ struct intel_connector {
 	struct drm_property *dv_lab_ll_property;
 	/* Hades: DVBRIDGE_DV_HDMI14B_LAB, that tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
 	struct drm_property *dv_lab_hdmi14b_property;
+	/* Hades: DVBRIDGE_DV_AVI_BT2020_LAB, BT.2020 in the AVI InfoFrame of that tunnel (drm_dvbridge.h) */
+	struct drm_property *dv_lab_avi_bt2020_property;
 	/* Hades: DVBRIDGE_HDR10_TUNNEL_LAB, HDR sent over that tunnel (drm_dvbridge_hdr10t.h) */
 	struct drm_property *dv_lab_hdr10t_property;
 	/*
@@ -721,6 +723,12 @@ struct intel_digital_connector_state {
 	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
 	 */
 	bool dv_lab_hdmi14b;
+	/*
+	 * Hades: DVBRIDGE_DV_AVI_BT2020_LAB: with the tunnel requested, its AVI InfoFrame says the
+	 * extended colorimetry BT.2020, as licensed players send it (drm_dvbridge.h); without it, no
+	 * colorimetry
+	 */
+	bool dv_lab_avi_bt2020;
 	/*
 	 * Hades: DVBRIDGE_HDR10_TUNNEL_LAB: with the tunnel requested, it carries HDR as YCbCr 4:2:2
 	 * at 12 bits (drm_dvbridge_hdr10t.h); without it, nothing
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index d586f26..5ee7771 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -1182,6 +1182,9 @@ intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 		if (!vic)
 			return false;
 		drm_dvbridge_tunnel_avi(frame, vic);
+		/* Hades: ... with BT.2020, where asked for (drm_dvbridge.h) */
+		if (to_intel_digital_connector_state(conn_state)->dv_lab_avi_bt2020)
+			drm_dvbridge_tunnel_avi_bt2020(frame);
 		/* Hades: what the sink's Low-Latency input reads the same bytes as */
 		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
 			drm_dvbridge_ll_avi(frame);
@@ -4012,6 +4015,12 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			if (connector->dv_lab_hdmi14b_property)
 				drm_object_attach_property(&_connector->base,
 							   connector->dv_lab_hdmi14b_property, 0);
+			/* Hades: BT.2020 in the AVI InfoFrame of the same tunnel (drm_dvbridge.h) */
+			connector->dv_lab_avi_bt2020_property = drm_property_create_bool(display->drm,
+				DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_AVI_BT2020_LAB");
+			if (connector->dv_lab_avi_bt2020_property)
+				drm_object_attach_property(&_connector->base,
+							   connector->dv_lab_avi_bt2020_property, 0);
 			/*
 			 * Hades: HDR over the same tunnel, as YCbCr 4:2:2 (drm_dvbridge_hdr10t.h),
 			 * where the port sends the DRM InfoFrame (intel_hdmi_gmp_hdr.h)
-- 
2.53.0

