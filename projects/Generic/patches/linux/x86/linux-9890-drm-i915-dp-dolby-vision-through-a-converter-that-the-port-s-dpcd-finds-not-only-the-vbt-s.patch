@@ -37,8 +37,8 @@ intel_display_param_named_unsafe(dmc_firmware_path, charp, 0400,
 	"Use /dev/null to disable DMC and runtime PM.");
 
 intel_display_param_named(dv_pcon, int, 0400,
-	"Standard Dolby Vision through the DisplayPort to HDMI converter of a board (display version 11 and later): "
-	"-1=boards where it was seen working only [default], 0=off, 1=every converter "
+	"Standard Dolby Vision through a DisplayPort to HDMI converter, on the board or in an adapter or USB-C hub (display version 11 and later): "
+	"-1=the boards and converters where it was seen working, and others where user space asks for it [default], 0=off, 1=every converter "
 	"(experimental: a converter that does not carry the Dolby vendor InfoFrame shows no Dolby Vision, or no picture).");
 
 intel_display_param_named(hdmi_hdr_gmp, bool, 0400,
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 1c3be86..d5e60e6 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -548,6 +548,8 @@ struct intel_connector {
 	 */
 	struct drm_property *dv_converter_property;
 	u8 dv_converter, dv_converter_told;
+	/* Hades: what the branch device said of itself when the kernel log last told the verdict */
+	struct drm_dp_dpcd_ident dv_converter_told_ident;
 	struct drm_dvbridge_refused_log dv_refused_log;
 	/*
 	 * Hades: DVBRIDGE_LINK_FORMAT, what a request of the guard found the configuration sends
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 3ec24ce..9f48b98 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3563,6 +3563,11 @@ int intel_dp_compute_min_hblank(struct intel_crtc_state *crtc_state,
  * through (YBLOD, linux-9930: the mechanism and the board; this is written again for the policy,
  * the checks and the readout of this tree). The bytes of the picture go as they do through native
  * HDMI: RGB at 8 bits, full range, nothing of the display pipe in between.
+ *
+ * Hades: and through a converter that is not on the board (an adapter, the HDMI socket of a USB-C
+ * hub or dock, as on a Chromebook): any DisplayPort port can have one, and which one is there is
+ * asked of the port's DPCD when a display is found, not of the VBT. The idea of Dolby Vision
+ * through a USB-C hub on a Chromebook is from Felix Oghină (PR #29 of LibreELEC Hades).
  */
 bool intel_dp_pcon_dv_candidate(const struct intel_digital_port *dig_port)
 {
@@ -3571,8 +3576,24 @@ bool intel_dp_pcon_dv_candidate(const struct intel_digital_port *dig_port)
 
 	return intel_dv_pcon_candidate(DISPLAY_VER(display), display->params.enable_dv_lab,
 				       display->params.dv_pcon, false,
-				       intel_bios_encoder_is_lspcon(devdata),
-				       intel_bios_encoder_supports_hdmi(devdata));
+				       intel_bios_encoder_is_lspcon(devdata));
+}
+
+/* Hades: the VBT says that this port is an HDMI one: its converter is on the board */
+static bool intel_dp_pcon_dv_on_board(struct intel_dp *intel_dp)
+{
+	return intel_bios_encoder_supports_hdmi(dp_to_dig_port(intel_dp)->base.devdata);
+}
+
+/* Hades: the converter behind the port on the list of converters (by its branch device's DPCD) */
+static const struct intel_dv_pcon_converter *intel_dp_pcon_dv_converter(struct intel_dp *intel_dp)
+{
+	const struct drm_dp_dpcd_ident *id = &intel_dp->desc.ident;
+
+	if (!drm_dp_is_branch(intel_dp->dpcd))
+		return NULL;
+	return intel_dv_pcon_converter_listed(id->oui, (const u8 *)id->device_id, id->hw_rev,
+					      id->sw_major_rev, id->sw_minor_rev);
 }
 
 /*
@@ -3597,20 +3618,27 @@ static enum intel_dv_pcon_verdict intel_dp_pcon_dv_verdict(struct intel_dp *inte
 	struct intel_display *display = to_intel_display(intel_dp);
 
 	return intel_dv_pcon_verdict(display->params.dv_pcon, intel_dp_pcon_dv_route(intel_dp),
-				     !!intel_dp_pcon_dv_board());
+				     intel_dv_pcon_listed(intel_dp_pcon_dv_on_board(intel_dp),
+							  !!intel_dp_pcon_dv_board(),
+							  !!intel_dp_pcon_dv_converter(intel_dp)));
 }
 
 /*
  * DVBRIDGE_DV_CONVERTER, what the detect that just ran found; the kernel log says it when a
- * converter is found, and again only when it is another verdict
+ * converter is found, and again only when it is another verdict or another converter. (Hades: with
+ * where the converter is, and what its branch device says of itself: the identity that the list of
+ * converters takes, intel_dv_pcon_policy.h.)
  */
 static void intel_dp_pcon_dv_update(struct intel_dp *intel_dp, bool connected)
 {
 	struct intel_display *display = to_intel_display(intel_dp);
 	struct intel_connector *connector = intel_dp->attached_connector;
+	const struct drm_dp_dpcd_ident *id = &intel_dp->desc.ident;
 	enum intel_dv_pcon_verdict verdict =
 		connected ? intel_dp_pcon_dv_verdict(intel_dp) : INTEL_DV_PCON_NONE;
+	const struct intel_dv_pcon_converter *converter;
 	const struct intel_dv_pcon_board *board;
+	bool on_board;
 
 	if (!connector->dv_converter_property)
 		return;
@@ -3619,15 +3647,25 @@ static void intel_dp_pcon_dv_update(struct intel_dp *intel_dp, bool connected)
 					      connector->dv_converter_property, verdict);
 		connector->dv_converter = verdict;
 	}
-	if (verdict == INTEL_DV_PCON_NONE || verdict == connector->dv_converter_told)
+	if (verdict == INTEL_DV_PCON_NONE ||
+	    (verdict == connector->dv_converter_told &&
+	     !memcmp(&connector->dv_converter_told_ident, id, sizeof(*id))))
 		return;
 	connector->dv_converter_told = verdict;
-	board = intel_dp_pcon_dv_board();
+	connector->dv_converter_told_ident = *id;
+	on_board = intel_dp_pcon_dv_on_board(intel_dp);
+	board = on_board ? intel_dp_pcon_dv_board() : NULL;
+	converter = intel_dp_pcon_dv_converter(intel_dp);
 	drm_info(display->drm,
-		 "[CONNECTOR:%d:%s] DVBRIDGE: a DisplayPort to HDMI converter is behind this port (DVBRIDGE_DV_CONVERTER %s): %s%s%s%s\n",
-		 connector->base.base.id, connector->base.name,
+		 "[CONNECTOR:%d:%s] DVBRIDGE: a DisplayPort to HDMI converter is behind this port, %s (branch OUI %*phD, id \"%*pE\", hw %d.%d, sw %d.%d; DVBRIDGE_DV_CONVERTER %s): %s%s%s%s\n",
+		 connector->base.base.id, connector->base.name, intel_dv_pcon_where(on_board),
+		 (int)sizeof(id->oui), id->oui,
+		 (int)strnlen(id->device_id, sizeof(id->device_id)), id->device_id,
+		 id->hw_rev >> 4, id->hw_rev & 0xf, id->sw_major_rev, id->sw_minor_rev,
 		 intel_dv_pcon_verdict_name(verdict), intel_dv_pcon_verdict_why(verdict),
-		 board ? " (" : "", board ? board->seen : "", board ? ")" : "");
+		 board || converter ? " (" : "",
+		 board ? board->seen : converter ? converter->seen : "",
+		 board || converter ? ")" : "");
 }
 
 /* The properties of the tunnel on a DisplayPort connector of a port that can carry it */
diff --git a/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h b/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h
index da26995..0cce1d6 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h
@@ -9,9 +9,9 @@
  * What a converter does with the bytes is not in the standard: it turns DisplayPort InfoFrame
  * SDPs into HDMI InfoFrames in its own way, and a converter that does not carry the Dolby vendor
  * InfoFrame leaves the display without Dolby Vision, or without a picture. So the tunnel goes
- * through one only where somebody has seen it work on that board (the list below), or where the
- * user asks for it (the module parameter dv_pcon, or Kodi's setting, which reads
- * DVBRIDGE_DV_CONVERTER): the default is to refuse, as before.
+ * through one only where somebody has seen it work on that board or with that converter (the lists
+ * below), or where the user asks for it (the module parameter dv_pcon, or Kodi's setting, which
+ * reads DVBRIDGE_DV_CONVERTER): the default is to refuse, as before.
  *
  * The idea, and the first board, are from YBLOD (github.com/dangerouslaser/libreelec-yblod,
  * linux-9930: "Standard Dolby Vision through an onboard DP-to-HDMI protocol converter", verified
@@ -36,7 +36,7 @@ enum intel_dv_pcon_verdict {
 	/* a converter that nobody has seen carry the Dolby vendor InfoFrame: user space that asks
 	 * for it gets it, and takes the risk (Kodi: "Dolby Vision through a display converter: On") */
 	INTEL_DV_PCON_UNLISTED,
-	/* the board is on the list below: seen working (Kodi: Automatic uses it) */
+	/* the board or the converter is on a list below: seen working (Kodi: Automatic uses it) */
 	INTEL_DV_PCON_LISTED,
 	/* dv_pcon=1: the user took every converter as verified on the kernel command line */
 	INTEL_DV_PCON_FORCED,
@@ -93,22 +93,98 @@ static inline const struct intel_dv_pcon_board *intel_dv_pcon_board_listed(const
 	return NULL;
 }
 
+/*
+ * Hades: the converters that are not on a board (a DisplayPort to HDMI adapter, the HDMI socket of
+ * a USB-C hub or dock) are known by what their branch device says of itself in its DPCD (0x500 to
+ * 0x50b): the IEEE OUI of its maker, its device identification string, and the revisions of its
+ * hardware and firmware. A converter on this list was seen carrying the tunnel; every field must be
+ * the same, the firmware too, since what a converter does with the InfoFrames is its firmware's.
+ * To add one: a line here with where it was seen (the converter, the display, the modes), from the
+ * kernel log line of the detect ("a DisplayPort to HDMI converter is behind this port"), and the
+ * same in the Hades documents. None yet.
+ */
+struct intel_dv_pcon_converter {
+	u8 oui[3];
+	u8 device_id[6];
+	u8 hw_rev, sw_major_rev, sw_minor_rev;
+	const char *seen;
+};
+
+static const struct intel_dv_pcon_converter intel_dv_pcon_converters[] = {
+	{ .seen = NULL },
+};
+
+/*
+ * The entry of a list of converters (the one above: intel_dv_pcon_converter_listed()) for what a
+ * branch device says of itself, NULL when it is not on it. A branch device that gives no maker (an
+ * OUI of zero, which many do not fill in) is on no list.
+ */
+static inline const struct intel_dv_pcon_converter *
+intel_dv_pcon_converter_in(const struct intel_dv_pcon_converter *list, const u8 *oui,
+			   const u8 *device_id, u8 hw_rev, u8 sw_major_rev, u8 sw_minor_rev)
+{
+	if (!oui || !device_id || !(oui[0] | oui[1] | oui[2]))
+		return NULL;
+	for (; list->seen; list++)
+		if (!memcmp(list->oui, oui, sizeof(list->oui)) &&
+		    !memcmp(list->device_id, device_id, sizeof(list->device_id)) &&
+		    list->hw_rev == hw_rev && list->sw_major_rev == sw_major_rev &&
+		    list->sw_minor_rev == sw_minor_rev)
+			return list;
+	return NULL;
+}
+
+static inline const struct intel_dv_pcon_converter *
+intel_dv_pcon_converter_listed(const u8 *oui, const u8 *device_id, u8 hw_rev, u8 sw_major_rev,
+			       u8 sw_minor_rev)
+{
+	return intel_dv_pcon_converter_in(intel_dv_pcon_converters, oui, device_id, hw_rev,
+					  sw_major_rev, sw_minor_rev);
+}
+
 /*
  * A port can carry the tunnel through a converter at all: the property is attached to its
  * DisplayPort connector only then (decided once, at the start of the driver). param is dv_pcon:
- * -1 the list of boards decides, 0 off, 1 any converter is taken as verified.
+ * -1 the lists decide, 0 off, 1 any converter is taken as verified.
+ *
+ * Hades: any DisplayPort port that is not eDP, not only one that the VBT calls HDMI. A converter
+ * can be on the board (the VBT says HDMI for the port: the socket of a NUC) or plugged into the
+ * port (an adapter, a USB-C hub; a Chromebook's VBT has no HDMI on its USB-C ports), and which one
+ * is there is asked of the port itself when a display is found: its DPCD says whether a branch
+ * device of the HDMI type is behind it (intel_dv_pcon_verdict()'s route). Where nothing such is
+ * behind it, the verdict is none and the kernel refuses the tunnel whatever user space asks, as
+ * before.
  */
 static inline bool intel_dv_pcon_candidate(unsigned int display_ver, bool dv_lab, int param,
-					   bool edp, bool vbt_lspcon, bool vbt_hdmi)
+					   bool edp, bool vbt_lspcon)
 {
 	/* an LSPCON (a VBT flag, the NUC7 level-shifter and the like) has its own way: not this one */
-	return dv_lab && display_ver >= 11 && param != 0 && !edp && !vbt_lspcon && vbt_hdmi;
+	return dv_lab && display_ver >= 11 && param != 0 && !edp && !vbt_lspcon;
+}
+
+/*
+ * Whether the converter behind a port is on a list of those seen carrying the tunnel: the board's
+ * list is about the converter of the board, so it counts only on the port that the VBT calls HDMI
+ * (on another port of the same board the converter is a plugged one); the list of converters counts
+ * on any port.
+ */
+static inline bool intel_dv_pcon_listed(bool vbt_hdmi, bool board_listed, bool converter_listed)
+{
+	return (vbt_hdmi && board_listed) || converter_listed;
+}
+
+/* Where the converter that the detect found is, for the kernel log */
+static inline const char *intel_dv_pcon_where(bool vbt_hdmi)
+{
+	return vbt_hdmi ? "on the board (the VBT says this port is an HDMI one)" :
+			  "plugged into the port or not in the VBT (an adapter, a USB-C hub or dock; its branch device says it is an HDMI converter)";
 }
 
 /*
  * What the connector says of the converter behind it, from what detect found. route: the sink is
  * an HDMI sink behind a DisplayPort branch device of the HDMI type, and that converter cannot go
- * to FRL (what the tunnel was seen through is TMDS). listed: the board is on the list.
+ * to FRL (what the tunnel was seen through is TMDS). listed: the converter is on a list
+ * (intel_dv_pcon_listed()).
  */
 static inline enum intel_dv_pcon_verdict intel_dv_pcon_verdict(int param, bool route, bool listed)
 {
@@ -126,9 +202,9 @@ static inline const char *intel_dv_pcon_verdict_why(enum intel_dv_pcon_verdict v
 	case INTEL_DV_PCON_NONE:
 		return "no DisplayPort to HDMI converter that the tunnel takes behind this port";
 	case INTEL_DV_PCON_UNLISTED:
-		return "this board is not on the list of those where the converter was seen carrying it: offered to user space that asks for it (dv_pcon=1 takes every converter as verified)";
+		return "this converter is not on the lists of those seen carrying it (boards, converters): offered to user space that asks for it (dv_pcon=1 takes every converter as verified)";
 	case INTEL_DV_PCON_LISTED:
-		return "this board is on the list of those where the converter was seen carrying it";
+		return "this converter is on a list of those seen carrying it (boards, converters)";
 	case INTEL_DV_PCON_FORCED:
 		return "dv_pcon=1: every converter is taken as verified (experimental: an unverified converter may show no picture)";
 	default:
-- 
