From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:08:58 +0000
Subject: [PATCH] drm/amd/display: say the signal and the depth that go through
 a passive dual-mode adaptor

When a DisplayPort connector drives its display through a passive dual-mode
(DP++) adaptor, DC sends TMDS (HDMI or DVI) at the deepest colour that the
display declares and the TMDS clock of the adaptor carries
(link_validate_mode_timing(), DC_EXCEED_DONGLE_CAP): through a 300 MHz adaptor,
1080p60 goes at 12 bpc (222.75 MHz) to a display with 36-bit deep colour,
while 3840x2160 at 30 Hz can only go at 8. Issue 26 of LibreELEC Hades (an
A10-8730B, DCE 11.0) had no picture at 1080p60 and in frame packing through
one such adaptor, which the same display takes from Intel graphics at 8 bpc,
and 4K30 worked; the kernel log said the adaptor (amdgpu_dm_update_dual_mode(),
at detection) but nothing of what each commit sent through it, so the depth
could only be inferred.

The kernel log now says, with the packets of a commit and once for each
change, the signal, the size, the pixel encoding, the depth and the TMDS
clock of a stream that goes through such an adaptor, beside the clock that
the adaptor takes. Nothing that goes out changes.
---
 .../gpu/drm/amd/display/dc/core/dc_resource.c | 73 +++++++++++++++++++
 .../amd/display/dc/inc/hw/stream_encoder.h    |  3 +-
 2 files changed, 75 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
index 202145b97..35a690062 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
@@ -5348,11 +5348,84 @@ static void hades_log_info_packet(const struct pipe_ctx *pipe_ctx, const char *n
 	st->last = jiffies;
 }
 
+/*
+ * Hades: a stream that a DisplayPort connector sends through a passive dual-mode (DP++) adaptor (the
+ * link of a DisplayPort connector, the stream an HDMI or a DVI one): the signal, the depth and the
+ * pixel encoding that go through the adaptor, and the TMDS clock that they make beside the one that
+ * the adaptor takes, as link_validate_mode_timing() compares them. Once for each change, with the
+ * packets of the commit. What adaptor and display are there is said when the display is looked at
+ * (amdgpu_dm_update_dual_mode()); this is what a commit sends through them. Nothing changes.
+ */
+static void hades_log_dual_mode_link(const struct pipe_ctx *pipe_ctx, struct dc_info_packet_log *st)
+{
+	const struct dc_stream_state *stream = pipe_ctx->stream;
+	const struct dc_link *link = stream->link;
+	const struct dc_crtc_timing *t = &stream->timing;
+	unsigned int bpc, tmds_khz;
+	uint32_t key[6];
+	uint32_t crc;
+
+	if (!link || link->connector_signal != SIGNAL_TYPE_DISPLAY_PORT ||
+	    !(dc_is_hdmi_tmds_signal(stream->signal) || dc_is_dvi_signal(stream->signal)))
+		return;
+	switch (t->display_color_depth) {
+	case COLOR_DEPTH_666:
+		bpc = 6;
+		break;
+	case COLOR_DEPTH_101010:
+		bpc = 10;
+		break;
+	case COLOR_DEPTH_121212:
+		bpc = 12;
+		break;
+	case COLOR_DEPTH_141414:
+		bpc = 14;
+		break;
+	case COLOR_DEPTH_161616:
+		bpc = 16;
+		break;
+	default:
+		bpc = 8;
+		break;
+	}
+	/* the TMDS clock: deep colour multiplies it, 4:2:2 does not, 4:2:0 halves it */
+	tmds_khz = t->pix_clk_100hz / 10;
+	if (t->pixel_encoding == PIXEL_ENCODING_YCBCR420)
+		tmds_khz /= 2;
+	if (t->pixel_encoding != PIXEL_ENCODING_YCBCR422 && bpc > 8)
+		tmds_khz = tmds_khz * bpc / 8;
+
+	key[0] = stream->signal;
+	key[1] = t->display_color_depth;
+	key[2] = t->pixel_encoding;
+	key[3] = t->pix_clk_100hz;
+	key[4] = link->dongle_max_pix_clk;
+	key[5] = (t->h_addressable << 16) ^ t->v_addressable;
+	crc = crc32_le(~0, (const u8 *)key, sizeof(key));
+	if (st->valid && st->crc == crc)
+		return;
+	st->valid = true;
+	st->crc = crc;
+	if (atomic_inc_return(&hades_info_packet_lines) > HADES_INFO_PACKET_LOG_LINES)
+		return;
+	if (link->dongle_max_pix_clk)
+		pr_info("[drm] Hades: link %u (DisplayPort, through a passive dual-mode adaptor): %s signal, %ux%u, %s at %u bpc, TMDS clock %u kHz of the %u kHz that the adaptor takes\n",
+			link->link_index, dc_is_dvi_signal(stream->signal) ? "DVI" : "HDMI",
+			t->h_addressable, t->v_addressable, dc_pixel_encoding_to_str(t->pixel_encoding),
+			bpc, tmds_khz, link->dongle_max_pix_clk);
+	else
+		pr_info("[drm] Hades: link %u (DisplayPort, through a passive dual-mode adaptor): %s signal, %ux%u, %s at %u bpc, TMDS clock %u kHz; the adaptor says no limit\n",
+			link->link_index, dc_is_dvi_signal(stream->signal) ? "DVI" : "HDMI",
+			t->h_addressable, t->v_addressable, dc_pixel_encoding_to_str(t->pixel_encoding),
+			bpc, tmds_khz);
+}
+
 static void hades_log_info_packets(struct pipe_ctx *pipe_ctx)
 {
 	struct encoder_info_frame *info = &pipe_ctx->stream_res.encoder_info_frame;
 	struct encoder_info_frame *w = info;
 
+	hades_log_dual_mode_link(pipe_ctx, &w->hades_log[10]);
 	hades_log_info_packet(pipe_ctx, "AVI", false, &info->avi, &w->hades_log[0]);
 	hades_log_info_packet(pipe_ctx, "gamut", false, &info->gamut, &w->hades_log[1]);
 	hades_log_info_packet(pipe_ctx, "vendor-specific", true, &info->vendor, &w->hades_log[2]);
diff --git a/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h b/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h
index 578854aba..52605ada5 100644
--- a/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h
+++ b/drivers/gpu/drm/amd/display/dc/inc/hw/stream_encoder.h
@@ -116,7 +116,8 @@ struct encoder_info_frame {
 	/* Adaptive Sync SDP*/
 	struct dc_info_packet adaptive_sync;
 	/* Hades: the packets that the kernel log said, in the order of the packets above */
-	struct dc_info_packet_log hades_log[10];
+	/* (Hades: and [10] the line of a stream through a passive dual-mode adaptor) */
+	struct dc_info_packet_log hades_log[11];
 	struct enc_sdp_line_num sdp_line_num;
 	bool firmware_controlled_hdr_info_packet;
 };
-- 
