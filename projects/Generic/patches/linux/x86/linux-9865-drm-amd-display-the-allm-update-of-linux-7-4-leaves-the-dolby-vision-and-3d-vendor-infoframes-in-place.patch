From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:24:48 +0000
Subject: [PATCH] drm/amd/display: the ALLM update of Linux 7.4 leaves the
 Dolby Vision and 3D vendor InfoFrames in place

Linux 7.4 sends HDMI ALLM with Gaming-VRR (8b607d6f54b0): at every flip
of the primary plane, amdgpu_dm_update_freesync_state_on_stream() builds
the vendor packet of an HDMI stream again from its timing alone
(mod_build_hf_vsif_infopacket()), puts it in vsp_infopacket, and a
difference marks freesync_vrr_info_changed, so that the stream update of
amdgpu_dm_commit_planes() sends it. In that slot this driver keeps
packets that the timing cannot give: the Dolby VSIF of the tunnel and
its HDMI 1.4b form, the free slot of HDR over the tunnel, the HDMI 3D
layout packed in a 2D frame, and the packet that says that 3D has ended.
From the first flip on, each of them would have been replaced: the TV
would have left Dolby Vision or 3D at once.

Such a slot is now left as it is (amdgpu_dm_vendor_slot_is_hades()).
ALLM is only due with Gaming-VRR active, and neither goes with VRR: the
tunnel turns VRR off (vrr_supported) and a 3D mode has a fixed rate. Any
other packet is built as upstream does.

KUnit (amdgpu_dm_freesync_test.c): the Dolby VSIF, its HDMI 1.4b form,
the free slot of HDR over the tunnel on a mode with an HDMI VIC, a 3D
layout and the packet after 3D stay byte for byte and mark nothing; a
control, an HDMI VIC packet that the timing does not ask for, is built
again as upstream does. Without this change the five fail.

Not tried on hardware.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 14 +++
 .../display/amdgpu_dm/amdgpu_dm_dvbridge.h    |  3 +
 .../display/amdgpu_dm/amdgpu_dm_freesync.c    | 12 ++-
 .../amdgpu_dm/tests/amdgpu_dm_freesync_test.c | 94 +++++++++++++++++++
 4 files changed, 121 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index ae001c53901a..3409740ed84f 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3161,6 +3161,20 @@ static bool amdgpu_dm_stereo_vsif_present(const struct dc_stream_state *stream)
 	       format == AMDGPU_DM_HDMI_VIDEO_FORMAT_NONE;
 }
 
+/*
+ * Hades: the vendor slot of the stream holds what this driver put there for a signal of its own,
+ * which mod_build_hf_vsif_infopacket() cannot build again from the timing: the Dolby VSIF of the
+ * tunnel or its HDMI 1.4b form, the slot that HDR over the tunnel leaves free (byte_tunnel), the
+ * HDMI vendor InfoFrame of a 3D layout packed in a 2D frame, or the one without a layout that
+ * follows a 3D mode (create_stream_for_sink()). The ALLM update of Linux 7.4
+ * (amdgpu_dm_update_freesync_state_on_stream()) leaves such a slot as it is.
+ */
+bool amdgpu_dm_vendor_slot_is_hades(const struct dc_stream_state *stream)
+{
+	return amdgpu_dm_dvbridge_stream_active(stream) || amdgpu_dm_stereo_vsif_present(stream);
+}
+EXPORT_IF_KUNIT(amdgpu_dm_vendor_slot_is_hades);
+
 /*
  * The commit replaced the stream of a CRTC, and the vendor InfoFrame of the new stream does
  * not say about 3D what the one of the old stream said.
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index 602fe1edb03d..6b575fdee304 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -87,6 +87,9 @@ bool amdgpu_dm_dvbridge_readback_refuses(const struct amdgpu_display_manager *dm
 					 const struct dc_stream_state *stream);
 
 /* HDMI 3D, built in the same file: the commit side sends a vendor InfoFrame that changed. */
+/* Hades: the vendor slot of the stream holds a Dolby Vision or 3D packet of this driver */
+bool amdgpu_dm_vendor_slot_is_hades(const struct dc_stream_state *stream);
+
 bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
 				   const struct dc_stream_state *new_stream);
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
index 89155cfaab88..916981e499fa 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
@@ -35,6 +35,7 @@
 #include "amdgpu_dm_psr.h"
 #include "amdgpu_dm_replay.h"
 #include "amdgpu_dm_freesync.h"
+#include "amdgpu_dm_dvbridge.h"
 #include "dm_helpers.h"
 #include "modules/inc/mod_freesync.h"
 #include "modules/inc/mod_info_packet.h"
@@ -309,9 +310,16 @@ void amdgpu_dm_update_freesync_state_on_stream(
 	 * HDMI ALLM: when Gaming-VRR is active (VRR_EN=1) and the sink
 	 * advertises ALLM in the SCDS, the Source shall transmit the HF-VSIF
 	 * with ALLM_Mode=1 (HDMI 2.1 Section 7.6.6).
+	 *
+	 * Hades: not over a vendor packet of this driver's own (the Dolby VSIF of
+	 * the tunnel, a 3D layout; amdgpu_dm_vendor_slot_is_hades()): this runs at
+	 * every flip, and the packet built from the timing would take its place
+	 * from the first flip on. Neither goes with VRR: the tunnel turns VRR off
+	 * (vrr_supported), and a 3D mode is a fixed rate.
 	 */
-	if (new_stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
-	    new_stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+	if ((new_stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
+	     new_stream->signal == SIGNAL_TYPE_HDMI_FRL) &&
+	    !amdgpu_dm_vendor_slot_is_hades(new_stream)) {
 		struct dc_info_packet vsp_infopacket = {0};
 		bool sink_allm = aconn && aconn->base.display_info.hdmi.allm;
 		bool allm = sink_allm &&
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_freesync_test.c b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_freesync_test.c
index 8f219f08cd55..472845a2106c 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_freesync_test.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/tests/amdgpu_dm_freesync_test.c
@@ -5,6 +5,7 @@
  * Copyright 2026 Advanced Micro Devices, Inc.
  */
 
+#include <linux/hdmi.h>
 #include <kunit/test.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_connector.h>
@@ -529,6 +530,92 @@ static void dm_test_update_freesync_state_packet_changed(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, crtc_state.vrr_infopacket.valid);
 }
 
+/*
+ * Hades: the ALLM update of Linux 7.4 rebuilds the vendor packet of an HDMI stream from its timing
+ * at every flip. A packet that this driver built for a signal of its own stays: the Dolby VSIF of
+ * the tunnel, its HDMI 1.4b form, the 3D layout and the 2D one after it. Another one is rebuilt
+ * as upstream does (here: from a timing without an HDMI VIC or 3D, to no packet).
+ */
+static void dm_test_hades_vendor_slot_case(struct kunit *test, bool valid, u8 hb2, u8 oui0, u8 oui1,
+					   u8 oui2, u8 pb4, u8 pb5, bool byte_tunnel, u8 hdmi_vic,
+					   bool kept)
+{
+	struct amdgpu_device *adev = dm_kunit_alloc_adev(test);
+	struct dc_stream_state *stream = dm_kunit_alloc_stream(test, NULL);
+	struct dc_info_packet before;
+	struct amdgpu_crtc *acrtc;
+	struct dm_crtc_state crtc_state = { 0 };
+
+	acrtc = kunit_kzalloc(test, sizeof(*acrtc), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, acrtc);
+	crtc_state.base.crtc = &acrtc->base;
+	stream->timing.h_total = 4400;
+	stream->timing.v_total = 2250;
+	stream->signal = SIGNAL_TYPE_HDMI_TYPE_A;
+	stream->byte_tunnel = byte_tunnel;
+	stream->timing.hdmi_vic = hdmi_vic;
+	stream->vsp_infopacket.valid = valid;
+	stream->vsp_infopacket.hb0 = HDMI_INFOFRAME_TYPE_VENDOR;
+	stream->vsp_infopacket.hb1 = 0x01;
+	stream->vsp_infopacket.hb2 = hb2;
+	stream->vsp_infopacket.sb[1] = oui0;
+	stream->vsp_infopacket.sb[2] = oui1;
+	stream->vsp_infopacket.sb[3] = oui2;
+	stream->vsp_infopacket.sb[4] = pb4;
+	stream->vsp_infopacket.sb[5] = pb5;
+	before = stream->vsp_infopacket;
+	adev->dm.adev = adev;
+
+	amdgpu_dm_update_freesync_state_on_stream(&adev->dm, &crtc_state, stream, NULL, 0);
+
+	if (kept) {
+		KUNIT_EXPECT_EQ(test, memcmp(&stream->vsp_infopacket, &before, sizeof(before)), 0);
+		KUNIT_EXPECT_FALSE(test, crtc_state.freesync_vrr_info_changed);
+	} else {
+		KUNIT_EXPECT_NE(test, memcmp(&stream->vsp_infopacket, &before, sizeof(before)), 0);
+		KUNIT_EXPECT_TRUE(test, crtc_state.freesync_vrr_info_changed);
+	}
+}
+
+/* Hades: the Dolby VSIF of the tunnel (OUI 00-D0-46, 27 bytes) */
+static void dm_test_hades_vendor_slot_dolby(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, true, HDMI_DOLBY_VENDOR_INFOFRAME_SIZE, 0x46, 0xd0,
+				       0x00, 0x02, 0x00, false, 0, true);
+}
+
+/* Hades: the Dolby Vision VSIF of the HDMI 1.4b signalling (OUI of HDMI, its own length) */
+static void dm_test_hades_vendor_slot_dolby_hdmi14b(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, true, HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE, 0x03, 0x0c,
+				       0x00, 0x20, 0x00, false, 0, true);
+}
+
+/* Hades: HDR over the tunnel leaves the slot free, and it stays free on a mode with an HDMI VIC */
+static void dm_test_hades_vendor_slot_byte_tunnel(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, false, 0, 0, 0, 0, 0, 0, true, 1, true);
+}
+
+/* Hades: HDMI 3D side by side (half) packed in a 2D frame */
+static void dm_test_hades_vendor_slot_3d(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, true, 6, 0x03, 0x0c, 0x00, 2 << 5, 0x8 << 4, false, 0,
+				       true);
+}
+
+/* Hades: the 2D mode after a 3D one says that there is no 3D any more */
+static void dm_test_hades_vendor_slot_2d_after_3d(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, true, 5, 0x03, 0x0c, 0x00, 0x00, 0x00, false, 0, true);
+}
+
+/* Control: an HDMI VIC packet that the timing does not ask for is rebuilt, as upstream does */
+static void dm_test_hades_vendor_slot_hdmi_vic_rebuilt(struct kunit *test)
+{
+	dm_test_hades_vendor_slot_case(test, true, 5, 0x03, 0x0c, 0x00, 1 << 5, 0x01, false, 0, false);
+}
+
 /**
  * dm_test_update_freesync_state_pre_ai_active - Test pre-AI active VRR adjustment
  * @test: The KUnit test context
@@ -1054,6 +1141,13 @@ static struct kunit_case amdgpu_dm_freesync_tests[] = {
 	/* amdgpu_dm_reset_freesync_config_for_crtc */
 	KUNIT_CASE(dm_test_reset_freesync_config),
 	/* amdgpu_dm_update_freesync_state_on_stream */
+	/* Hades: the vendor slot of this driver's own packets */
+	KUNIT_CASE(dm_test_hades_vendor_slot_dolby),
+	KUNIT_CASE(dm_test_hades_vendor_slot_dolby_hdmi14b),
+	KUNIT_CASE(dm_test_hades_vendor_slot_byte_tunnel),
+	KUNIT_CASE(dm_test_hades_vendor_slot_3d),
+	KUNIT_CASE(dm_test_hades_vendor_slot_2d_after_3d),
+	KUNIT_CASE(dm_test_hades_vendor_slot_hdmi_vic_rebuilt),
 	KUNIT_CASE(dm_test_update_freesync_state_no_stream),
 	KUNIT_CASE(dm_test_update_freesync_state_invalid_timing),
 	KUNIT_CASE(dm_test_update_freesync_state_default_packet),
