From d1b476decdb50763b879b5731e01fc606b764dc5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:52:52 +0000
Subject: [PATCH] drm/i915/hdmi: HDR in YCbCr 4:2:0 at 10 bits where RGB would
 leave at 8

i915 follows the rule of drm_dvbridge_hdr.h (linux-9966). In
intel_hdmi_compute_formats(), after the RGB configuration with the
downstream limits respected, HDR video (PQ or HLG) that it leaves below
10 bits per component is computed again in YCbCr 4:2:0 from the same
pipe bpp, through intel_hdmi_compute_output_format() as any 4:2:0
configuration (the sink's 4:2:0 deep colour, the source's depths, the
port clock and its holes); it is kept when it reaches 10 bits or more,
and otherwise RGB is computed again from the same inputs, which gives
the same configuration. The depth the port sends in 4:2:0 is what i915
sends: 10 bits on display 11 and later (12 is not sent there with
LibreELEC's linux 9900), 12 on display 10. With linux-9967 the colours
are encoded with the BT.2020 matrix that the sink is told.

A YCbCr 4:2:0 output takes a pipe scaler. The rule tries 4:2:0 only
where one is left beside the planes of the CRTC that scale (as the
commit has them, or as they are), so that it never makes a commit fail
on the scalers where RGB passes (a pipe with one scaler and a scaled
plane, or a pipe without scalers, keeps RGB).

This replaces the retry of linux-9900-07 from CroqueMr's fork, which
did it on Lunar Lake only, for HDR10 only, gated by enable_dv_lab, and
refused the commit, instead of sending RGB, where 4:2:0 fell short (and
kept such a request from the fallback that ignores the downstream
limits). intel_dvbridge_hdr_policy.h (linux-9900-06) goes with it; the
patches of the fork stay as they were published.

The connector gets DVBRIDGE_HDR_YCBCR420 (display 10 and later, where
it sends 4:2:0; not gated by enable_dv_lab, the rule is no part of the
tunnel), "deep" by default, "never" to choose as before; a change of it
is computed as a change of the HDR metadata is (a modeset when the
format changes). Beside the HDR10 depth guard (where enable_dv_lab is
on) it gets DVBRIDGE_LINK_FORMAT, the format and the depth of the
configuration that a request of the guard checked, written also when
the guard refuses it, and for any metadata or none. The kernel log of
a refusal of the guard now says why YCbCr 4:2:0 was not sent instead,
and the debug log says what the rule chose.

Built with W=1 on the changed files, without warnings; the rule and a
model of its use here are tested on the host (linux-9966).
---
 drivers/gpu/drm/i915/display/intel_atomic.c   |  15 +-
 .../drm/i915/display/intel_display_types.h    |  12 +
 .../i915/display/intel_dvbridge_hdr_policy.h  |  12 -
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 220 ++++++++++++++----
 4 files changed, 205 insertions(+), 54 deletions(-)
 delete mode 100644 drivers/gpu/drm/i915/display/intel_dvbridge_hdr_policy.h

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index d643d94..a2af559 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -74,6 +74,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_hdr10_deep_color;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_hdr420_property &&
+	    property == to_intel_connector(connector)->dv_hdr420_property) {
+		*val = intel_conn_state->dv_hdr_ycbcr420;
+		return 0;
+	}
 
 	if (property == display->properties.force_audio)
 		*val = intel_conn_state->force_audio;
@@ -123,6 +128,12 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_hdr10_deep_color = val;
 		return 0;
 	}
+	/* Hades: DVBRIDGE_HDR_YCBCR420 (drm_dvbridge_hdr.h; DRM checks the enum's values) */
+	if (to_intel_connector(connector)->dv_hdr420_property &&
+	    property == to_intel_connector(connector)->dv_hdr420_property) {
+		intel_conn_state->dv_hdr_ycbcr420 = val;
+		return 0;
+	}
 
 	if (property == display->properties.force_audio) {
 		intel_conn_state->force_audio = val;
@@ -167,10 +178,12 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	 * These properties are handled by fastset, and might not end
 	 * up in a modeset.
 	 * (Hades: the HDR10 depth guard as well. It changes nothing of the output: the
-	 * configuration is computed again only so that the guard sees the depth of the link.)
+	 * configuration is computed again only so that the guard sees the depth of the link.
+	 * And DVBRIDGE_HDR_YCBCR420, which can change the format of HDR: a full modeset then.)
 	 */
 	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
 	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
+	    new_conn_state->dv_hdr_ycbcr420 != old_conn_state->dv_hdr_ycbcr420 ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
 	    new_conn_state->broadcast_rgb != old_conn_state->broadcast_rgb ||
 	    new_conn_state->base.colorspace != old_conn_state->base.colorspace ||
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index f07c9ad..173d5cd 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -531,6 +531,13 @@ struct intel_connector {
 	struct drm_property *dv_hdr10_property;
 	struct drm_property *dv_refused_property;
 	struct drm_dvbridge_refused_log dv_refused_log;
+	/*
+	 * Hades: DVBRIDGE_LINK_FORMAT, what a request of the guard found the configuration sends
+	 * (gated as the guard), and DVBRIDGE_HDR_YCBCR420, HDR in YCbCr 4:2:0 at 10 bits or more
+	 * where RGB would carry fewer (not gated: an HDR rule, not the tunnel) (drm_dvbridge_hdr.h)
+	 */
+	struct drm_property *dv_link_property;
+	struct drm_property *dv_hdr420_property;
 	/*
 	 * The fixed encoder this connector is connected to.
 	 */
@@ -629,6 +636,11 @@ struct intel_digital_connector_state {
 	bool dv_lab_standard;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR (scalar as well) */
 	bool dv_hdr10_deep_color;
+	/*
+	 * Hades: DVBRIDGE_HDR_YCBCR420, enum drm_dvbridge_hdr_ycbcr420: 0 ("deep", the default of
+	 * a state that is reset) or "never". A setting of the user, kept while the connector is off.
+	 */
+	u8 dv_hdr_ycbcr420;
 
 	enum hdmi_force_audio force_audio;
 	int broadcast_rgb;
diff --git a/drivers/gpu/drm/i915/display/intel_dvbridge_hdr_policy.h b/drivers/gpu/drm/i915/display/intel_dvbridge_hdr_policy.h
deleted file mode 100644
index d1a85fe..0000000
--- a/drivers/gpu/drm/i915/display/intel_dvbridge_hdr_policy.h
+++ /dev/null
@@ -1,12 +0,0 @@
-/* SPDX-License-Identifier: GPL-2.0 */
-#ifndef INTEL_DVBRIDGE_HDR_POLICY_H
-#define INTEL_DVBRIDGE_HDR_POLICY_H
-/* Do not sacrifice HDR precision when 4:2:0 deep colour fits the actual link.
- * Standard-DV's byte-preserving RGB8 tunnel is deliberately excluded. */
-static inline bool intel_dvbridge_hdr_retry_420(bool lab_hdr, bool strict_limits,
-    bool rgb, int actual_bpp, int requested_bpp, bool allowed, bool mode_also)
-{
-    return lab_hdr && strict_limits && rgb && actual_bpp < 30 &&
-           requested_bpp >= 30 && allowed && mode_also;
-}
-#endif
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 146cc3b..6f852ac 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -38,6 +38,7 @@
 #include <drm/display/drm_scdc_helper.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_dvbridge_hdr.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
@@ -47,7 +48,6 @@
 #include "g4x_hdmi.h"
 #include "intel_atomic.h"
 #include "intel_dv_lab_policy.h"
-#include "intel_dvbridge_hdr_policy.h"
 #include "intel_audio.h"
 #include "intel_connector.h"
 #include "intel_cx0_phy.h"
@@ -2326,19 +2326,107 @@ static int intel_hdmi_compute_output_format(struct intel_encoder *encoder,
 	return intel_hdmi_compute_clock(encoder, crtc_state, respect_downstream_limits);
 }
 
-static bool intel_dvbridge_hdr_deep_requested(struct intel_display *display,
-					 const struct drm_connector_state *state)
+/*
+ * Hades: YCbCr 4:2:0 takes a pipe scaler (intel_pfit_compute_config() turns the panel fitter on
+ * for it, and the scaler does the chroma downsampling). One is left for it when the planes on
+ * the CRTC that scale (as the commit has them, or as they are: a plane that a commit changes on
+ * this CRTC is changed under its lock, which this check holds) use fewer than the pipe has;
+ * otherwise 4:2:0 would make the commit fail on the scalers where RGB passes. A plane counts when
+ * its source and destination sizes differ, or its framebuffer is YUV.
+ */
+static bool intel_hdmi_hdr420_scaler_left(const struct intel_crtc_state *crtc_state)
 {
-	const struct hdr_output_metadata *hdr;
+	struct intel_display *display = to_intel_display(crtc_state);
+	struct intel_crtc *crtc = to_intel_crtc(crtc_state->uapi.crtc);
+	struct drm_atomic_commit *state = crtc_state->uapi.state;
+	struct drm_plane *plane;
+	int used = 0;
 
-	if (!display->params.enable_dv_lab || !display->platform.lunarlake ||
-	    to_intel_digital_connector_state(state)->dv_lab_standard ||
-	    state->max_requested_bpc < 10 || !state->hdr_output_metadata ||
-	    state->hdr_output_metadata->length < sizeof(*hdr))
-		return false;
-	hdr = state->hdr_output_metadata->data;
-	return hdr->metadata_type == 0 &&
-		hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
+	drm_for_each_plane_mask(plane, display->drm, crtc_state->uapi.plane_mask) {
+		const struct drm_plane_state *p = state ?
+			drm_atomic_get_new_plane_state(state, plane) : NULL;
+
+		if (!p)
+			p = plane->state;
+		if (plane->type == DRM_PLANE_TYPE_CURSOR || !p || !p->fb)
+			continue;
+		if ((p->src_w >> 16) != p->crtc_w || (p->src_h >> 16) != p->crtc_h ||
+		    p->fb->format->is_yuv)
+			used++;
+	}
+	return used < crtc->num_scalers;
+}
+
+/*
+ * Hades: the inputs of the HDR 4:2:0 rule (drm_dvbridge_hdr.h) for the configuration just
+ * computed in RGB with the downstream limits respected. requested_bpp: the pipe bpp the
+ * configuration started from (the platform's, max bpc and the sink's RGB deep colour).
+ */
+static void intel_hdmi_hdr420_input(const struct intel_crtc_state *crtc_state,
+				    const struct drm_connector_state *conn_state,
+				    int requested_bpp, struct drm_dvbridge_hdr420 *s)
+{
+	const struct intel_digital_connector_state *state =
+		to_intel_digital_connector_state(conn_state);
+	const struct drm_connector *connector = conn_state->connector;
+	const struct drm_display_info *info = &connector->display_info;
+
+	*s = (struct drm_dvbridge_hdr420) {
+		.never = state->dv_hdr_ycbcr420 == DRM_DVBRIDGE_HDR_YCBCR420_NEVER,
+		.hdr = drm_dvbridge_hdr_output(conn_state),
+		.dv_tunnel = state->dv_lab_standard,
+		.hdmi_sink = crtc_state->has_hdmi_sink,
+		.source = connector->ycbcr_420_allowed && intel_hdmi_hdr420_scaler_left(crtc_state),
+		.mode = drm_mode_is_420_also(info, &crtc_state->hw.adjusted_mode),
+		.rgb = crtc_state->sink_format == INTEL_OUTPUT_FORMAT_RGB,
+		.bpc = crtc_state->pipe_bpp / 3,
+		.max_bpc = requested_bpp / 3,
+		.y420_dc_modes = info->hdmi.y420_dc_modes,
+	};
+}
+
+/*
+ * Hades: HDR video where RGB, as just computed with the downstream limits respected, leaves
+ * below 10 bits per component: YCbCr 4:2:0 at the depth it gets, if that is 10 or more, by the
+ * rule of drm_dvbridge_hdr.h (amdgpu follows the same one). Otherwise the RGB configuration is
+ * computed again from the same inputs, which gives the same one. Nothing else changes: the
+ * validation of the format, the depth and the clock is upstream's.
+ */
+static int intel_hdmi_hdr420(struct intel_encoder *encoder, struct intel_crtc_state *crtc_state,
+			     const struct drm_connector_state *conn_state, int requested_bpp)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	struct intel_connector *connector = to_intel_connector(conn_state->connector);
+	const int rgb_bpp = crtc_state->pipe_bpp;
+	struct drm_dvbridge_hdr420 s;
+	int ret;
+
+	intel_hdmi_hdr420_input(crtc_state, conn_state, requested_bpp, &s);
+	if (!drm_dvbridge_hdr420_try(&s)) {
+		if (s.hdr && s.rgb && s.bpc < 10)
+			drm_dbg_kms(display->drm,
+				    "[CONNECTOR:%d:%s] HDR goes out in RGB at %d bpc: %s\n",
+				    connector->base.base.id, connector->base.name, s.bpc,
+				    drm_dvbridge_hdr420_why_not(&s));
+		return 0;
+	}
+	crtc_state->pipe_bpp = requested_bpp;
+	ret = intel_hdmi_compute_output_format(encoder, crtc_state, connector, true,
+					       INTEL_OUTPUT_FORMAT_YCBCR420);
+	if (!ret && drm_dvbridge_hdr420_keep(rgb_bpp / 3, crtc_state->pipe_bpp / 3)) {
+		drm_dbg_kms(display->drm,
+			    "[CONNECTOR:%d:%s] HDR goes out in YCbCr 4:2:0 at %d bpc: RGB would be %d bpc\n",
+			    connector->base.base.id, connector->base.name, crtc_state->pipe_bpp / 3,
+			    rgb_bpp / 3);
+		return 0;
+	}
+	drm_dbg_kms(display->drm,
+		    "[CONNECTOR:%d:%s] HDR stays in RGB at %d bpc: YCbCr 4:2:0 %s\n",
+		    connector->base.base.id, connector->base.name, rgb_bpp / 3,
+		    ret ? "does not fit the link" : "is not deeper");
+	crtc_state->pipe_bpp = requested_bpp;
+	return intel_hdmi_compute_output_format(encoder, crtc_state, connector, true,
+						INTEL_OUTPUT_FORMAT_RGB);
 }
 
 static int intel_hdmi_compute_formats(struct intel_encoder *encoder,
@@ -2371,21 +2459,15 @@ static int intel_hdmi_compute_formats(struct intel_encoder *encoder,
 						       respect_downstream_limits,
 						       INTEL_OUTPUT_FORMAT_RGB);
 
-		if (!ret && intel_dvbridge_hdr_retry_420(
-			    intel_dvbridge_hdr_deep_requested(display, conn_state),
-			    respect_downstream_limits,
-			    crtc_state->sink_format == INTEL_OUTPUT_FORMAT_RGB,
-			    crtc_state->pipe_bpp, requested_bpp,
-			    connector->base.ycbcr_420_allowed,
-			    drm_mode_is_420_also(info, adjusted_mode))) {
-			/* Keep upstream format and link validation, but do not reuse
-			 * the precision reduced by the first RGB attempt. */
-			crtc_state->pipe_bpp = requested_bpp;
-			ret = intel_hdmi_compute_output_format(encoder, crtc_state,
-				connector, true, INTEL_OUTPUT_FORMAT_YCBCR420);
-			if (ret || crtc_state->pipe_bpp < 30)
-				return ret ? ret : -EINVAL;
-		}
+		/*
+		 * Hades: HDR where RGB leaves below 10 bits per component (drm_dvbridge_hdr.h).
+		 * This replaces the retry of linux-9900-07 (Lunar Lake only, HDR10 only, gated by
+		 * enable_dv_lab, and a refusal of the commit where 4:2:0 fell short): every display
+		 * version that sends YCbCr 4:2:0 over HDMI, HDR10 and HLG, and RGB as before
+		 * wherever 4:2:0 does not reach 10 bits.
+		 */
+		if (!ret && respect_downstream_limits)
+			ret = intel_hdmi_hdr420(encoder, crtc_state, conn_state, requested_bpp);
 
 		if (ret && drm_mode_is_420_also(info, adjusted_mode))
 			ret = intel_hdmi_compute_output_format(encoder, crtc_state, connector,
@@ -2555,18 +2637,27 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	struct drm_display_mode *adjusted_mode = &pipe_config->hw.adjusted_mode;
 	struct intel_connector *connector = to_intel_connector(conn_state->connector);
 	struct drm_scdc *scdc = &connector->base.display_info.hdmi.scdc;
-	/* Hades: a request of the Dolby Vision tunnel or of the HDR10 depth guard */
+	/*
+	 * Hades: a request of the Dolby Vision tunnel or of the HDR10 depth guard (asked: with any
+	 * metadata or none, for DVBRIDGE_LINK_FORMAT; guarded: with HDR10, which it refuses below
+	 * 10 bits)
+	 */
 	const bool dv_requested = to_intel_digital_connector_state(conn_state)->dv_lab_standard;
+	const bool guard_asked = to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color;
 	const bool hdr10_guarded = intel_hdmi_hdr10_guarded(conn_state);
-	char detail[256];
+	int requested_bpp;
+	char detail[384];
 	int ret;
 
 	/*
 	 * Hades: what the last check of such a request found is cleared; each test below that
 	 * refuses it says why (it stays 0 when it passes)
 	 */
-	if (dv_requested || hdr10_guarded)
+	if (dv_requested || guard_asked)
 		intel_hdmi_dvbridge_refused(connector, 0, NULL);
+	/* Hades: ... and what it found the configuration sends, written once it is computed */
+	if (guard_asked)
+		drm_dvbridge_link_report(&connector->base, connector->dv_link_property, 0);
 
 	if (adjusted_mode->flags & DRM_MODE_FLAG_DBLSCAN)
 		return -EINVAL;
@@ -2585,6 +2676,8 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 
 	if (!intel_link_bw_compute_pipe_bpp(pipe_config))
 		return -EINVAL;
+	/* Hades: what the formats start from, for the kernel log of the HDR10 depth guard */
+	requested_bpp = pipe_config->pipe_bpp;
 
 	pipe_config->has_audio =
 		intel_hdmi_has_audio(encoder, pipe_config, conn_state) &&
@@ -2595,9 +2688,12 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	 * that fails assume the user might know something we don't.
 	 */
 	ret = intel_hdmi_compute_formats(encoder, pipe_config, conn_state, true);
-	/* Experimental DV/HDR must never override the sink bandwidth limit. */
-	if (ret && !to_intel_digital_connector_state(conn_state)->dv_lab_standard &&
-	    !intel_dvbridge_hdr_deep_requested(display, conn_state))
+	/*
+	 * Experimental DV must never override the sink bandwidth limit. (Hades: HDR as
+	 * upstream: the exception linux-9900-07 made for HDR10 on Lunar Lake goes with its retry,
+	 * which drm_dvbridge_hdr.h replaces.)
+	 */
+	if (ret && !dv_requested)
 		ret = intel_hdmi_compute_formats(encoder, pipe_config, conn_state, false);
 	if (ret) {
 		drm_dbg_kms(display->drm,
@@ -2629,25 +2725,45 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	pipe_config->limited_color_range =
 		intel_hdmi_limited_color_range(pipe_config, conn_state);
 
+	/*
+	 * Hades: the answer to a request of the guard: the format and the depth of the
+	 * configuration (DVBRIDGE_LINK_FORMAT, drm_dvbridge_hdr.h), also when the guard refuses it
+	 */
+	if (guard_asked)
+		drm_dvbridge_link_report(&connector->base, connector->dv_link_property,
+					 drm_dvbridge_link_bits(
+						 pipe_config->sink_format == INTEL_OUTPUT_FORMAT_YCBCR420 ?
+						 DRM_DVBRIDGE_LINK_YCBCR420 :
+						 pipe_config->sink_format == INTEL_OUTPUT_FORMAT_YCBCR444 ?
+						 DRM_DVBRIDGE_LINK_YCBCR444 : DRM_DVBRIDGE_LINK_RGB,
+						 pipe_config->pipe_bpp / 3));
+
 	/*
 	 * Hades: HDR10 under the depth guard leaves at 10 bits per component or more, or the commit
 	 * is refused (and user space knows that the link carries it with fewer). Nothing of the
 	 * configuration is changed for it.
 	 */
 	if (hdr10_guarded && pipe_config->pipe_bpp < 30) {
+		struct drm_dvbridge_hdr420 s;
+		const char *why;
 		size_t len = scnprintf(detail, sizeof(detail), "HDR10 would go out at %d bpc in ",
 				       pipe_config->pipe_bpp / 3);
 
 		len = intel_hdmi_dvbridge_link_detail(encoder, connector, adjusted_mode, 10,
 						      detail, len, sizeof(detail));
-		scnprintf(detail + len, sizeof(detail) - len,
-			  "; this port sends 10 bpc: %s, 12 bpc: %s; the sink takes RGB at 10 bpc: %s, at 12 bpc: %s",
-			  str_yes_no(intel_hdmi_source_bpc_possible(display, 10)),
-			  str_yes_no(intel_hdmi_source_bpc_possible(display, 12)),
-			  str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
-				     DRM_EDID_HDMI_DC_30),
-			  str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
-				     DRM_EDID_HDMI_DC_36));
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "; this port sends 10 bpc: %s, 12 bpc: %s; the sink takes RGB at 10 bpc: %s, at 12 bpc: %s",
+				 str_yes_no(intel_hdmi_source_bpc_possible(display, 10)),
+				 str_yes_no(intel_hdmi_source_bpc_possible(display, 12)),
+				 str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
+					    DRM_EDID_HDMI_DC_30),
+				 str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
+					    DRM_EDID_HDMI_DC_36));
+		/* ... and why YCbCr 4:2:0 at 10 bits or more was not sent instead */
+		intel_hdmi_hdr420_input(pipe_config, conn_state, requested_bpp, &s);
+		why = drm_dvbridge_hdr420_why_not(&s);
+		scnprintf(detail + len, sizeof(detail) - len, "; YCbCr 4:2:0: %s",
+			  why ? why : "does not reach 10 bpc on this link");
 		intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_HDR10_DEPTH),
 					    detail);
 		return -EINVAL;
@@ -3031,6 +3147,28 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			if (connector->dv_hdr10_property)
 				drm_object_attach_property(&_connector->base,
 							   connector->dv_hdr10_property, 0);
+			/* ... and its answer, what the configuration sends (read only) */
+			if (connector->dv_hdr10_property) {
+				connector->dv_link_property =
+					drm_dvbridge_link_property_create(display->drm);
+				if (connector->dv_link_property)
+					drm_object_attach_property(&_connector->base,
+								   connector->dv_link_property, 0);
+			}
+		}
+
+		/*
+		 * Hades: HDR in YCbCr 4:2:0 at 10 bits or more where RGB would carry fewer
+		 * (drm_dvbridge_hdr.h), where the output sends 4:2:0: on by default ("deep"), not
