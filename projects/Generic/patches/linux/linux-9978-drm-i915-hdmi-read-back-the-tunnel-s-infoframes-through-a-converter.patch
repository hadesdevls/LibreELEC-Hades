From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:40:05 +0000
Subject: [PATCH 3/3] drm/i915/hdmi: read back the tunnel's InfoFrames through
 a converter as the HDMI ones

The AVI and Dolby vendor InfoFrames of the tunnel through a DisplayPort
to HDMI converter are DisplayPort InfoFrame SDPs in the AVI and GMP DIPs
(the previous patch). The state check reads the hardware back and
compares it with the state it computed, in HDMI InfoFrames: a GMP DIP
that carries a Dolby vendor SDP would be read as HDR metadata and
mismatch, and the SDPs would not unpack as HDMI InfoFrames.

On a port that can carry the tunnel through a converter, the readout of
the InfoFrames that are enabled maps a GMP DIP whose SDP is the vendor
InfoFrame (header byte 0 is 0 for a DisplayPort SDP, byte 1 is the
InfoFrame type) to the vendor InfoFrame, and reads the AVI and the vendor
InfoFrames of a DisplayPort transcoder from their SDPs back into the HDMI
layout (type, version, length, checksum, payload). Everything else, and
the DIPs of an HDMI transcoder, are read as before.

Not tried on hardware. Compiled with W=1, for i915 and xe.
---
 drivers/gpu/drm/i915/display/intel_hdmi.c | 72 +++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 50cdec86b..21ea44587 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -600,6 +600,72 @@ static u32 hsw_infoframes_enabled(struct intel_encoder *encoder,
 	return val & mask;
 }
 
+/*
+ * Hades: the tunnel of Dolby Vision through the DisplayPort to HDMI converter of a board
+ * (intel_dp_pcon_dv_write()): the AVI and the Dolby vendor InfoFrames are DisplayPort InfoFrame
+ * SDPs in the AVI and GMP DIPs. They are read back as the HDMI InfoFrames that the state computed,
+ * so that the state check compares like with like: a GMP DIP that carries a Dolby vendor SDP is the
+ * vendor InfoFrame, not HDR metadata.
+ */
+static bool hsw_pcon_dv_sdp_type(struct intel_encoder *encoder,
+				 const struct intel_crtc_state *crtc_state, unsigned int dip,
+				 u8 type)
+{
+	u32 dw0 = 0;
+
+	hsw_read_infoframe(encoder, crtc_state, dip, &dw0, sizeof(dw0));
+
+	/* (HB0 is 0 for a DisplayPort SDP; the DIP of an HDMI transcoder has the InfoFrame type there) */
+	return (dw0 & 0xff) == 0 && ((dw0 >> 8) & 0xff) == type;
+}
+
+static u32 hsw_pcon_dv_infoframes_enabled(struct intel_encoder *encoder,
+					  const struct intel_crtc_state *pipe_config)
+{
+	u32 val = hsw_infoframes_enabled(encoder, pipe_config);
+
+	if ((val & VIDEO_DIP_ENABLE_GMP_HSW) &&
+	    hsw_pcon_dv_sdp_type(encoder, pipe_config, HDMI_PACKET_TYPE_GAMUT_METADATA,
+				 HDMI_INFOFRAME_TYPE_VENDOR)) {
+		val &= ~VIDEO_DIP_ENABLE_GMP_HSW;
+		val |= VIDEO_DIP_ENABLE_VS_HSW;
+	}
+	return val;
+}
+
+static void hsw_pcon_dv_read_infoframe(struct intel_encoder *encoder,
+				       const struct intel_crtc_state *crtc_state,
+				       unsigned int type, void *frame, ssize_t len)
+{
+	unsigned int dip = type == HDMI_INFOFRAME_TYPE_VENDOR ?
+		HDMI_PACKET_TYPE_GAMUT_METADATA : type;
+	u8 sdp[VIDEO_DIP_DATA_SIZE], *out = frame, sum;
+	int i, n;
+
+	/*
+	 * Only a DisplayPort transcoder carries the SDPs; an HDMI one may still hold a stale Dolby SDP
+	 * in its (disabled) GMP DIP.
+	 */
+	if ((type != HDMI_INFOFRAME_TYPE_VENDOR && type != HDMI_INFOFRAME_TYPE_AVI) ||
+	    intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI) || len < VIDEO_DIP_DATA_SIZE ||
+	    !hsw_pcon_dv_sdp_type(encoder, crtc_state, dip, type)) {
+		hsw_read_infoframe(encoder, crtc_state, type, frame, len);
+		return;
+	}
+	hsw_read_infoframe(encoder, crtc_state, dip, sdp, sizeof(sdp));
+	/* the HDMI DIP layout: HB0-HB2, the ECC byte, PB0 (the checksum), PB1... */
+	memset(frame, 0, len);
+	out[0] = sdp[1];
+	out[1] = sdp[4];
+	out[2] = sdp[5];
+	n = min_t(int, sdp[5], VIDEO_DIP_DATA_SIZE - 6);
+	memcpy(&out[5], &sdp[6], n);
+	sum = out[0] + out[1] + out[2];
+	for (i = 0; i < n; i++)
+		sum += out[5 + i];
+	out[4] = 256 - sum;
+}
+
 static const u8 infoframe_type_to_idx[] = {
 	HDMI_PACKET_TYPE_GENERAL_CONTROL,
 	HDMI_PACKET_TYPE_GAMUT_METADATA,
@@ -3947,6 +4013,12 @@ void intel_infoframe_init(struct intel_digital_port *dig_port)
 			dig_port->read_infoframe = lspcon_read_infoframe;
 			dig_port->set_infoframes = lspcon_set_infoframes;
 			dig_port->infoframes_enabled = lspcon_infoframes_enabled;
+		} else if (intel_dp_pcon_dv_candidate(dig_port)) {
+			/* Hades: a port that can carry the tunnel through a converter (intel_dp.c) */
+			dig_port->write_infoframe = hsw_write_infoframe;
+			dig_port->read_infoframe = hsw_pcon_dv_read_infoframe;
+			dig_port->set_infoframes = hsw_set_infoframes;
+			dig_port->infoframes_enabled = hsw_pcon_dv_infoframes_enabled;
 		} else {
 			dig_port->write_infoframe = hsw_write_infoframe;
 			dig_port->read_infoframe = hsw_read_infoframe;
