From c772ae76c2adfdf836c1942d14a0a1dffba4a61e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:59:19 +0000
Subject: [PATCH] drm/amd/display: Dolby Vision Low-Latency over the tunnel

Offer DVBRIDGE_DV_LOW_LATENCY_LAB next to DVBRIDGE_DV_STANDARD_LAB, on
the HDMI connectors that have the tunnel. With both set, the tunnel
sends the Low-Latency AVI InfoFrame and Dolby VSIF of drm_dvbridge_ll.h
and takes a sink by the Low-Latency rule instead of the Standard one;
the scanout and every check of the tunnel stay as they are. That is why
it changes the tunnel instead of being one of its own: one byte exact
path, reviewed once. Alone it does nothing.

A change of it with the tunnel on is a full modeset, as turning the
tunnel on is, and the update sends the new InfoFrames on an unchanged
timing (amdgpu_dm_dvbridge_toggled()). A disabled connector drops it
with the tunnel. A refused sink is "edid" in DVBRIDGE_REFUSED, with the
Low-Latency reason in the kernel log. A kernel without this patch has
no such property, and user space then sends no Low-Latency.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |  6 ++
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |  2 +
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 63 ++++++++++++++++---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  7 ++-
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 22 +++++--
 5 files changed, 87 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index 83311bfc9..4fff2070f 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -1475,6 +1475,12 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 					 "DVBRIDGE_DV_STANDARD_LAB");
 	if (!adev->mode_info.dvbridge_dv_standard_property)
 		return -ENOMEM;
+	/* Hades: Dolby Vision Low-Latency over that tunnel (drm_dvbridge_ll.h) */
+	adev->mode_info.dvbridge_dv_low_latency_property =
+		drm_property_create_bool(adev_to_drm(adev), DRM_MODE_PROP_ATOMIC,
+					 "DVBRIDGE_DV_LOW_LATENCY_LAB");
+	if (!adev->mode_info.dvbridge_dv_low_latency_property)
+		return -ENOMEM;
 
 	/* Hades: the same names and meanings as the i915 ones (drm_dvbridge_refused.h) */
 	adev->mode_info.dvbridge_hdr10_property =
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index f68669f15..182775b4f 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -330,6 +330,8 @@ struct amdgpu_mode_info {
 	struct drm_property *abm_level_property;
 	/* Dolby Vision Standard tunnel over HDMI, requested by user space */
 	struct drm_property *dvbridge_dv_standard_property;
+	/* Hades: Dolby Vision Low-Latency over that tunnel (drm_dvbridge_ll.h) */
+	struct drm_property *dvbridge_dv_low_latency_property;
 	/*
 	 * Hades: the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR), and why a request of the
 	 * tunnel or of the guard was refused (DVBRIDGE_REFUSED, read only)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index b416e56f7..ecfd0db6c 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -92,6 +92,7 @@
 #include <drm/drm_fixed.h>
 #include <drm/drm_fourcc.h>
 #include <drm/drm_dvbridge_hdr.h>
+#include <drm/drm_dvbridge_ll.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_eld.h>
 #include <drm/drm_mode.h>
@@ -7954,11 +7955,17 @@ static void apply_dsc_policy_for_stream(struct amdgpu_dm_connector *aconnector,
  * kernel sends the InfoFrames (AVI with the CTA VIC and full range RGB, Dolby VSIF in the
  * vendor slot) and refuses any configuration whose output is not byte exact: dither,
  * colour processing, scaling, other planes, VRR, DSC, limited range or deep colour.
+ *
+ * Hades: with DVBRIDGE_DV_LOW_LATENCY_LAB set as well, the same tunnel carries Dolby Vision
+ * Low-Latency: a picture user space has mapped to the display, as YCbCr 4:2:2 12-bit without
+ * metadata, next to the Low-Latency VSIF and an AVI InfoFrame that says YCbCr 4:2:2, limited
+ * range, BT.2020, for a sink whose Dolby block advertises Low-Latency (drm_dvbridge_ll.h).
+ * Everything else is as above.
  */
 static bool amdgpu_dm_dvbridge = true;
 module_param_named(dvbridge, amdgpu_dm_dvbridge, bool, 0444);
 MODULE_PARM_DESC(dvbridge,
-		 "Offer DVBRIDGE_DV_STANDARD_LAB, the byte exact RGB 8 bpc Dolby Vision Standard tunnel, on HDMI connectors (default: true)");
+		 "Offer DVBRIDGE_DV_STANDARD_LAB, the byte exact RGB 8 bpc Dolby Vision Standard tunnel, and DVBRIDGE_DV_LOW_LATENCY_LAB, Low-Latency over it, on HDMI connectors (default: true)");
 
 /* HDMI InfoFrame to DC: header in hb0-hb2, checksum in sb[0], payload after it. */
 static int amdgpu_dm_dvbridge_infopacket(const u8 *buf, ssize_t len,
@@ -7994,6 +8001,8 @@ static int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 {
 	u8 buf[HDMI_INFOFRAME_SIZE(DOLBY_VENDOR)];
 	u8 vic = amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode));
+	/* Hades: Dolby Vision Low-Latency over the tunnel (drm_dvbridge_ll.h) */
+	const bool low_latency = to_dm_connector_state(con_state)->dvbridge_dv_low_latency;
 	struct hdmi_dolby_vendor_infoframe dv;
 	struct hdmi_avi_infoframe avi;
 	ssize_t len;
@@ -8002,14 +8011,18 @@ static int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 
 	/*
 	 * The sink this stream is built for, which the stream holds a reference to, must
-	 * advertise Dolby Vision Standard: the connector's EDID can be replaced by a hotplug
-	 * meanwhile, and it is not protected by the locks of an atomic check.
+	 * advertise Dolby Vision Standard (Hades: or Low-Latency, for that tunnel): the
+	 * connector's EDID can be replaced by a hotplug meanwhile, and it is not protected by the
+	 * locks of an atomic check.
 	 */
 	if (stream->signal == SIGNAL_TYPE_VIRTUAL)
 		return 0; /* no display (a fake sink): nothing receives it, no tunnel is built */
 	if (!stream->sink ||
-	    !amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
-					      stream->sink->dc_edid.length, &p60))
+	    !(low_latency ?
+	      drm_dvbridge_ll_edid(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length,
+				   &p60) :
+	      amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
+					       stream->sink->dc_edid.length, &p60)))
 		return -EOPNOTSUPP;
 	if (!vic || (mode->flags & DRM_MODE_FLAG_3D_MASK))
 		return -EINVAL;
@@ -8027,6 +8040,9 @@ static int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	avi.colorimetry = HDMI_COLORIMETRY_NONE;
 	avi.extended_colorimetry = 0;
 	avi.quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
+	/* Hades: what the sink's Low-Latency input reads the same bytes as (drm_dvbridge_ll.h) */
+	if (low_latency)
+		drm_dvbridge_ll_avi(&avi);
 	len = hdmi_avi_infoframe_pack(&avi, buf, sizeof(buf));
 	if (len < 0)
 		return len;
@@ -8040,6 +8056,9 @@ static int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	 */
 	hdmi_dolby_vendor_infoframe_init(&dv);
 	dv.signal = true;
+	/* Hades: ... with low latency (drm_dvbridge_ll.h) */
+	if (low_latency)
+		drm_dvbridge_ll_vsif(&dv);
 	len = hdmi_dolby_vendor_infoframe_pack(&dv, buf, sizeof(buf));
 	if (len < 0)
 		return len;
@@ -8285,6 +8304,11 @@ static bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct d
 		if (to_dm_connector_state(old_con_state)->dvbridge_dv_standard !=
 		    to_dm_connector_state(new_con_state)->dvbridge_dv_standard)
 			return true;
+		/* Hades: Standard and Low-Latency send other InfoFrames (drm_dvbridge_ll.h) */
+		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
+		    to_dm_connector_state(old_con_state)->dvbridge_dv_low_latency !=
+		    to_dm_connector_state(new_con_state)->dvbridge_dv_low_latency)
+			return true;
 		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
 		    old_con_state->content_type != new_con_state->content_type)
 			return true;
@@ -8851,6 +8875,14 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EOPNOTSUPP;
 		dm_new_state->dvbridge_dv_standard = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_low_latency_property) {
+		/* Hades: Low-Latency over the tunnel (drm_dvbridge_ll.h) */
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !amdgpu_dm_dvbridge)
+			return -EOPNOTSUPP;
+		dm_new_state->dvbridge_dv_low_latency = val;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
 		/* Hades: the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 		if (val > 1)
@@ -8920,6 +8952,9 @@ int amdgpu_dm_connector_atomic_get_property(struct drm_connector *connector,
 	} else if (property == adev->mode_info.dvbridge_dv_standard_property) {
 		*val = dm_state->dvbridge_dv_standard;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_low_latency_property) {
+		*val = dm_state->dvbridge_dv_low_latency;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
 		*val = dm_state->dvbridge_hdr10_deep_color;
 		ret = 0;
@@ -9622,12 +9657,17 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	if (!crtc) {
 		/* A disabled connector drops the Dolby Vision tunnel request. */
 		dm_new_con_state->dvbridge_dv_standard = false;
+		/* Hades: ... and that of Low-Latency over it */
+		dm_new_con_state->dvbridge_dv_low_latency = false;
 		/* Hades: ... and the HDR10 depth guard */
 		dm_new_con_state->dvbridge_hdr10_deep_color = false;
 		return 0;
 	}
 
-	if (dm_new_con_state->dvbridge_dv_standard != dm_old_con_state->dvbridge_dv_standard) {
+	/* (Hades: so does going from Standard to Low-Latency, or back, with the tunnel on) */
+	if (dm_new_con_state->dvbridge_dv_standard != dm_old_con_state->dvbridge_dv_standard ||
+	    (dm_new_con_state->dvbridge_dv_standard &&
+	     dm_new_con_state->dvbridge_dv_low_latency != dm_old_con_state->dvbridge_dv_low_latency)) {
 		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
 		if (IS_ERR(new_crtc_state))
 			return PTR_ERR(new_crtc_state);
@@ -10460,9 +10500,15 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge &&
 	    adev->mode_info.dvbridge_dv_standard_property &&
-	    amdgpu_dm_dvbridge_dcn_reviewed(adev))
+	    amdgpu_dm_dvbridge_dcn_reviewed(adev)) {
 		drm_object_attach_property(&aconnector->base.base,
 					   adev->mode_info.dvbridge_dv_standard_property, 0);
+		/* Hades: Low-Latency over the same tunnel (drm_dvbridge_ll.h) */
+		if (adev->mode_info.dvbridge_dv_low_latency_property)
+			drm_object_attach_property(&aconnector->base.base,
+						   adev->mode_info.dvbridge_dv_low_latency_property,
+						   0);
+	}
 
 	/* Hades: the HDR10 depth guard and DVBRIDGE_REFUSED, on every HDMI connector */
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge)
@@ -13266,7 +13312,8 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 			if (ret) {
 				/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
 				amdgpu_dm_dvbridge_refused_stream(connector, &new_crtc_state->mode,
-								  new_stream);
+								  new_stream,
+								  dm_new_conn_state->dvbridge_dv_low_latency);
 				goto fail;
 			}
 		}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index fa20fbeda..5e3e5cbab 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1090,6 +1090,11 @@ struct dm_connector_state {
 	uint64_t pbn;
 	/* DVBRIDGE_DV_STANDARD_LAB: Dolby Vision Standard tunnel requested */
 	bool dvbridge_dv_standard;
+	/*
+	 * Hades: DVBRIDGE_DV_LOW_LATENCY_LAB: with the tunnel requested, it carries Dolby Vision
+	 * Low-Latency (drm_dvbridge_ll.h); without it, nothing
+	 */
+	bool dvbridge_dv_low_latency;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 	bool dvbridge_hdr10_deep_color;
 	/*
@@ -1108,7 +1113,7 @@ void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 					  struct drm_atomic_commit *state);
 void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
-				       const struct dc_stream_state *stream);
+				       const struct dc_stream_state *stream, bool low_latency);
 void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 					const struct drm_crtc_state *crtc_state);
 void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index fa5888df3..c57077fce 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -15,6 +15,7 @@
 #include <drm/drm_atomic.h>
 #include <drm/drm_blend.h>
 #include <drm/drm_dvbridge_hdr.h>
+#include <drm/drm_dvbridge_ll.h>
 #include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_fourcc.h>
@@ -235,7 +236,7 @@ void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 /* The tests of amdgpu_dm_dvbridge_fill_stream(), named. */
 void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
-				       const struct dc_stream_state *stream)
+				       const struct dc_stream_state *stream, bool low_latency)
 {
 	struct amdgpu_dm_connector *aconn = to_amdgpu_dm_connector(connector);
 	u8 vic = amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode));
@@ -245,9 +246,22 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 	bool p60 = false;
 
 	detail[0] = '\0';
-	if (!stream->sink ||
-	    !amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
-					      stream->sink->dc_edid.length, &p60)) {
+	if (low_latency && (!stream->sink ||
+			    !drm_dvbridge_ll_edid(stream->sink->dc_edid.raw_edid,
+						  stream->sink->dc_edid.length, &p60))) {
+		/* Hades: Low-Latency over the tunnel (drm_dvbridge_ll.h) */
+		const char *why = stream->sink ?
+			drm_dvbridge_ll_edid_why(stream->sink->dc_edid.raw_edid,
+						 stream->sink->dc_edid.length) : "no sink";
+
+		bits |= REFUSED(EDID);
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "%sLow-Latency: %s", len ? "; " : "",
+				 why ? why : "the EDID changed while it was read");
+	} else if (!low_latency &&
+		   (!stream->sink ||
+		    !amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
+						      stream->sink->dc_edid.length, &p60))) {
 		bits |= REFUSED(EDID);
 		len += scnprintf(detail + len, sizeof(detail) - len,
 				 "%sthe EDID has no Dolby Vision block that this driver takes (version 2 with the Standard interface, or the 12-byte version 1 block with low latency and display management 4 or later)",
-- 
2.53.0

