From 2f199ae6965ba3d0c914eb3b94453e7c2ef731f2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:10:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: only where the driver signals it,
 with a switch

The patches treated a mode as 3D wherever its flags said so, each place
with a test of its own:

- frame packing was recognised with "flags &
  DRM_MODE_FLAG_3D_FRAME_PACKING". The 3D layouts are the values of one
  field of the flags, not bits: the test is also true for top-and-bottom,
  line alternative and L + depth. Nothing went wrong only because
  drm_mode_set_crtcinfo() compares the whole field itself;
- a mode with the flag of side-by-side full got the vendor InfoFrame of
  side-by-side half, over a timing that is not the doubled one the full
  layout needs. The EDID parser of DRM never offers that layout, but
  user space may set any mode;
- the timing of a frame packed mode was doubled on every connector, also
  where nothing tells the sink (DisplayPort, where 3D modes are not
  offered either);
- the viewport check of a plane took the size of every mode from
  drm_mode_get_hv_timing(), which is not what it took before for an
  interlaced or a doublescan mode (set by hand: the driver lists
  neither).

One function now says whether, and how, a mode is 3D for this driver:
amdgpu_dm_stereo_layout(), which names the layout only on a connector
that allows 3D (HDMI) and only for progressive frame packing,
top-and-bottom and side-by-side half, the three layouts DRM reads from
an EDID. Everything else is 0 and is handled as it was before 3D was
offered. The doubled timing, the source size of the stream and the
vendor InfoFrame follow it. The plane check has no connector at hand: it
looks at the flags alone, compares the whole field and takes the doubled
height only for frame packing, as the plane clipping of the DRM core
does; for any other mode it reads what upstream reads.

amdgpu.hdmi_3d=0 (a new parameter, default 1) turns all of it off: no
connector allows 3D, so no 3D mode is listed and none is handled.

Not covered: nothing refuses a 3D mode that the driver does not handle;
it is shown as the 2D mode it is, as upstream does.

Checked: compiled with the configuration and the compiler of the image.
Not run on hardware.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 67 ++++++++++++++++---
 .../amd/display/amdgpu_dm/amdgpu_dm_plane.c   |  9 ++-
 2 files changed, 63 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index b30cc0c..7619199 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -6820,6 +6820,44 @@ ffu:
 			   &flip_addrs->dirty_rect_count, true);
 }
 
+/*
+ * DOC: HDMI 3D
+ *
+ * A 3D mode is a 2D mode with a 3D layout in its flags. User space packs both eyes into one
+ * frame; the driver scans that frame out as plain 2D (frame packing with the doubled timing)
+ * and names the layout in the HDMI vendor InfoFrame, which is all that makes the sink show 3D.
+ */
+static bool amdgpu_dm_hdmi_3d = true;
+module_param_named(hdmi_3d, amdgpu_dm_hdmi_3d, bool, 0444);
+MODULE_PARM_DESC(hdmi_3d,
+		 "Offer the 3D modes of an HDMI sink: frame packing, top-and-bottom and side-by-side half (default: true)");
+
+/*
+ * The 3D layout of a mode, where this driver puts 3D on the wire: a connector that allows 3D
+ * (HDMI) and a progressive mode with one of the three layouts that the EDID parser of DRM
+ * offers. 0 for everything else, which is then handled as the 2D mode it always was here:
+ * the other connectors, and the layouts that need a timing or a signalling of their own.
+ * The layout is a value of one field of the flags, not a bit: the whole field is compared.
+ */
+static u32 amdgpu_dm_stereo_layout(const struct drm_connector *connector,
+				   const struct drm_display_mode *mode)
+{
+	u32 layout = mode->flags & DRM_MODE_FLAG_3D_MASK;
+
+	if (!connector->stereo_allowed ||
+	    (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)))
+		return 0;
+
+	switch (layout) {
+	case DRM_MODE_FLAG_3D_FRAME_PACKING:
+	case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
+	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
+		return layout;
+	default:
+		return 0;
+	}
+}
+
 static void update_stream_scaling_settings(struct drm_device *dev,
 					   const struct drm_display_mode *mode,
 					   const struct dm_connector_state *dm_state,
@@ -6834,12 +6872,20 @@ static void update_stream_scaling_settings(struct drm_device *dev,
 	if (!mode)
 		return;
 
-	/* Full screen scaling by default. A frame-packed 3D mode scans out the
-	 * doubled timing (two eyes plus the active space), so take the CRTC
-	 * height, not the per-eye vdisplay: with 1080 here against a 2205-line
-	 * destination the aspect fit keeps 1080 lines and centres them, showing
-	 * the first eye across both eye windows and none of the second. */
-	drm_mode_get_hv_timing(mode, &src.width, &src.height);
+	/* Full screen scaling by default */
+	src.width = mode->hdisplay;
+	src.height = mode->vdisplay;
+	/*
+	 * A frame-packed 3D mode scans out the doubled timing (two eyes plus the
+	 * active space), so take the CRTC height, not the per-eye vdisplay: with
+	 * 1080 here against a 2205-line destination the aspect fit keeps 1080
+	 * lines and centres them, showing the first eye across both eye windows
+	 * and none of the second.
+	 */
+	if (dm_state &&
+	    amdgpu_dm_stereo_layout(dm_state->base.connector, mode) ==
+	    DRM_MODE_FLAG_3D_FRAME_PACKING)
+		drm_mode_get_hv_timing(mode, &src.width, &src.height);
 	dst.width = stream->timing.h_addressable;
 	dst.height = stream->timing.v_addressable;
 
@@ -8006,10 +8052,11 @@ create_stream_for_sink(struct drm_connector *connector,
 #endif
 	struct dc_link *link = NULL;
 	struct dc_sink *sink = NULL;
+	u32 stereo = amdgpu_dm_stereo_layout(connector, drm_mode);
 
 	drm_mode_init(&mode, drm_mode);
 	/* frame packing scans out the doubled timing (two eyes plus the gap) */
-	if (mode.flags & DRM_MODE_FLAG_3D_FRAME_PACKING)
+	if (stereo == DRM_MODE_FLAG_3D_FRAME_PACKING)
 		drm_mode_set_crtcinfo(&mode, CRTC_STEREO_DOUBLE);
 	memset(&saved_mode, 0, sizeof(saved_mode));
 
@@ -8141,13 +8188,12 @@ create_stream_for_sink(struct drm_connector *connector,
 		enum dc_timing_3d_format saved_3d = stream->timing.timing_3d_format;
 		enum view_3d_format saved_view = stream->view_format;
 
-		switch (mode.flags & DRM_MODE_FLAG_3D_MASK) {
+		switch (stereo) {
 		case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
 			stream->timing.timing_3d_format = TIMING_3D_FORMAT_TB_SW_PACKED;
 			stream->view_format = VIEW_3D_FORMAT_TOP_AND_BOTTOM;
 			break;
 		case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
-		case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL:
 			stream->timing.timing_3d_format = TIMING_3D_FORMAT_SBS_SW_PACKED;
 			stream->view_format = VIEW_3D_FORMAT_SIDE_BY_SIDE;
 			break;
@@ -9848,7 +9894,8 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 	aconnector->base.interlace_allowed = false;
 	aconnector->base.doublescan_allowed = false;
 	/* HDMI only: DP->HDMI dongles reject 3D timings in link validation */
-	aconnector->base.stereo_allowed = connector_type == DRM_MODE_CONNECTOR_HDMIA;
+	aconnector->base.stereo_allowed = amdgpu_dm_hdmi_3d &&
+					  connector_type == DRM_MODE_CONNECTOR_HDMIA;
 	aconnector->base.dpms = DRM_MODE_DPMS_OFF;
 	aconnector->hpd.hpd = AMDGPU_HPD_NONE; /* not used */
 	aconnector->audio_inst = -1;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
index 8f24bd5..1cd6086 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
@@ -1101,13 +1101,16 @@ int amdgpu_dm_plane_helper_check_state(struct drm_plane_state *state,
 	if (fb && state->crtc) {
 		/* Validate viewport to cover the case when only the position changes */
 		if (state->plane->type != DRM_PLANE_TYPE_CURSOR) {
-			int mode_hdisplay, mode_vdisplay;
+			int mode_hdisplay = new_crtc_state->mode.crtc_hdisplay;
+			int mode_vdisplay = new_crtc_state->mode.crtc_vdisplay;
 			int viewport_width = state->crtc_w;
 			int viewport_height = state->crtc_h;
 
 			/* frame-packed 3D scans out the doubled timing */
-			drm_mode_get_hv_timing(&new_crtc_state->mode,
-					       &mode_hdisplay, &mode_vdisplay);
+			if ((new_crtc_state->mode.flags & DRM_MODE_FLAG_3D_MASK) ==
+			    DRM_MODE_FLAG_3D_FRAME_PACKING)
+				drm_mode_get_hv_timing(&new_crtc_state->mode,
+						       &mode_hdisplay, &mode_vdisplay);
 
 			if (state->crtc_x < 0)
 				viewport_width += state->crtc_x;
