+	IPP_DCE120_MASK_SH_LIST_SOC_BASE(mask_sh), \
+	IPP_SF(DCP0_INPUT_CSC_CONTROL, INPUT_CSC_GRPH_MODE, mask_sh)
+
 #if defined(CONFIG_DRM_AMD_DC_SI)
 #define IPP_DCE60_MASK_SH_LIST_DCE_COMMON_BASE(mask_sh) \
 	IPP_SF(CUR_UPDATE, CURSOR_UPDATE_LOCK, mask_sh), \
@@ -225,7 +243,8 @@
 	type DC_LUT_SEQ_COLOR; \
 	type GRPH_DEGAMMA_MODE; \
 	type CURSOR_DEGAMMA_MODE; \
-	type CURSOR2_DEGAMMA_MODE
+	type CURSOR2_DEGAMMA_MODE; \
+	type INPUT_CSC_GRPH_MODE
 
 struct dce_ipp_shift {
 	IPP_REG_FIELD_LIST(uint8_t);
@@ -257,6 +276,7 @@ struct dce_ipp_registers {
 	uint32_t DC_LUT_RW_INDEX;
 	uint32_t DC_LUT_SEQ_COLOR;
 	uint32_t DEGAMMA_CONTROL;
+	uint32_t INPUT_CSC_CONTROL; /* Hades: IPP_DCE112_REG_LIST_DCE_BASE() */
 };
 
 struct dce_ipp {
@@ -264,6 +284,9 @@ struct dce_ipp {
 	const struct dce_ipp_registers *regs;
 	const struct dce_ipp_shift *ipp_shift;
 	const struct dce_ipp_mask *ipp_mask;
+	/* Hades: the mode of the graphics input CSC that a byte tunnel found and will put back */
+	uint32_t input_csc_before;
+	bool input_csc_held;
 };
 
