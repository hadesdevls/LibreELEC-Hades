 	IPP_SF(DCP0_CUR_CONTROL, CURSOR_EN, mask_sh), \
@@ -147,6 +160,11 @@
 	IPP_SF(DCP0_DEGAMMA_CONTROL, CURSOR_DEGAMMA_MODE, mask_sh), \
