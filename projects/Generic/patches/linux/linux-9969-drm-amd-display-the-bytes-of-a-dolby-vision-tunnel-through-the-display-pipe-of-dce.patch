diff --git a/drivers/gpu/drm/amd/display/dc/core/dc.c b/drivers/gpu/drm/amd/display/dc/core/dc.c
index 333ac17..529dbe7 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -50,6 +50,7 @@
 #include "bios/bios_parser_helper.h"
 #include "include/irq_service_interface.h"
 #include "transform.h"
+#include "ipp.h" /* Hades: dc_stream_read_byte_tunnel() */
 #include "dmcu.h"
 #include "dpp.h"
 #include "timing_generator.h"
@@ -872,6 +873,41 @@ bool dc_stream_program_csc_matrix(struct dc *dc, struct dc_stream_state *stream)
 	return ret;
 }
 
+/*
+ * Hades: the registers of the pipe of a byte tunnel stream on DCE that decide whether its bytes
+ * reach the encoder as they were scanned out (struct dc_byte_tunnel_readback), read back;
+ * amdgpu_dm writes them to the kernel log each time the tunnel goes on. It changes nothing.
+ */
+bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *stream,
+				struct dc_byte_tunnel_readback *readback)
+{
+	struct pipe_ctx *pipe = NULL;
+	int i;
+
+	memset(readback, 0, sizeof(*readback));
+	for (i = 0; i < MAX_PIPES; i++) {
+		struct pipe_ctx *p = &dc->current_state->res_ctx.pipe_ctx[i];
+
+		if (p->stream == stream && !p->top_pipe && !p->prev_odm_pipe) {
+			pipe = p;
+			break;
+		}
+	}
+	if (!pipe || !pipe->plane_state)
+		return false;
+
+	dc_exit_ips_for_hw_access(dc);
+
+	if (pipe->plane_res.ipp && pipe->plane_res.ipp->funcs->ipp_read_byte_tunnel)
+		pipe->plane_res.ipp->funcs->ipp_read_byte_tunnel(pipe->plane_res.ipp, readback);
+	if (pipe->plane_res.xfm && pipe->plane_res.xfm->funcs->transform_read_byte_tunnel)
+		pipe->plane_res.xfm->funcs->transform_read_byte_tunnel(pipe->plane_res.xfm,
+								      readback);
+	if (pipe->stream_res.opp && pipe->stream_res.opp->funcs->opp_read_byte_tunnel)
+		pipe->stream_res.opp->funcs->opp_read_byte_tunnel(pipe->stream_res.opp, readback);
+	return readback->ipp_read && readback->xfm_read && readback->opp_read;
+}
+
 void dc_stream_set_static_screen_params(struct dc *dc,
 		struct dc_stream_state **streams,
 		int num_streams,
diff --git a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
index 0e304a8..3706435 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
@@ -1646,6 +1646,14 @@ bool resource_build_scaling_params(struct pipe_ctx *pipe_ctx)
 	 */
 	if (plane_state->ctx->dce_version > DCE_VERSION_MAX)
 		pipe_ctx->plane_res.scl_data.lb_params.depth = LB_PIXEL_DEPTH_36BPP;
+	else if (pipe_ctx->stream->byte_tunnel)
+		/*
+		 * Hades: a byte tunnel (dc_stream_state.byte_tunnel) on DCE: the DCP truncates each
+		 * component to its 8 bits and the line buffer keeps them (dce_transform.c: unity
+		 * denormalisation, the clamp at 8 bits); with the prescale in bypass
+		 * (dce_ipp_set_byte_passthrough()) every 8-bit value goes through unchanged.
+		 */
+		pipe_ctx->plane_res.scl_data.lb_params.depth = LB_PIXEL_DEPTH_24BPP;
 	else
 		pipe_ctx->plane_res.scl_data.lb_params.depth = LB_PIXEL_DEPTH_30BPP;
 
diff --git a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
index aeac5a4..a441392 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_hw_types.h
@@ -1300,5 +1300,47 @@ enum regam_lut {
 	REGAM_20 = 0,
 	REGAM_24
 };
+
+/*
+ * Hades: the register fields of a DCE pipe that decide whether the bytes of a byte tunnel stream
+ * (dc_stream_state.byte_tunnel) reach the encoder as they were scanned out, as
+ * dc_stream_read_byte_tunnel() reads them back; each one as dce_ipp.c, dce_transform.c and
+ * dce_opp.c program it. *_read: the block answered.
+ */
+struct dc_byte_tunnel_readback {
+	bool ipp_read;
+	bool xfm_read;
+	bool opp_read;
+	/* input pixel processor */
+	uint32_t prescale_bypass;	/* PRESCALE_GRPH_CONTROL.GRPH_PRESCALE_BYPASS, 1: bypass */
+	uint32_t input_gamma_mode;	/* INPUT_GAMMA_CONTROL.GRPH_INPUT_GAMMA_MODE, 1: LUT bypass */
+	bool input_csc_read;		/* the block has the graphics input CSC */
+	uint32_t input_csc_mode;	/* INPUT_CSC_CONTROL.INPUT_CSC_GRPH_MODE, 0: bypass */
+	uint32_t input_csc_mode_before;	/* ... as the tunnel found it when it took the pipe */
+	uint32_t degamma_mode;		/* DEGAMMA_CONTROL.GRPH_DEGAMMA_MODE, 0: bypass */
+	/* transform: colour, bit depth reduction, line buffer, scaler */
+	uint32_t gamut_remap_mode;	/* GAMUT_REMAP_CONTROL.GRPH_GAMUT_REMAP_MODE, 0: bypass */
+	uint32_t regamma_mode;		/* REGAMMA_CONTROL.GRPH_REGAMMA_MODE, 0: bypass */
+	uint32_t output_csc_mode;	/* OUTPUT_CSC_CONTROL.OUTPUT_CSC_GRPH_MODE, 0: bypass */
+	uint32_t denorm_mode;		/* DENORM_CONTROL.DENORM_MODE, 0: unity */
+	uint32_t clamp_min[3];		/* OUT_CLAMP_CONTROL_R_CR, _G_Y and _B_CB */
+	uint32_t clamp_max[3];
+	uint32_t round_trunc_mode;	/* OUT_ROUND_CONTROL.OUT_ROUND_TRUNC_MODE, 4: truncate to u0.8 */
+	uint32_t dcp_dither_en;		/* DCP_SPATIAL_DITHER_CNTL.DCP_SPATIAL_DITHER_EN */
+	uint32_t lb_pixel_depth;	/* LB_DATA_FORMAT.PIXEL_DEPTH, 1: 24 bpp */
+	uint32_t lb_expan_mode;		/* LB_DATA_FORMAT.PIXEL_EXPAN_MODE */
+	uint32_t scl_mode;		/* SCL_MODE.SCL_MODE, 0: bypass */
+	/* formatter */
+	uint32_t fmt_truncate_en;	/* FMT_BIT_DEPTH_CONTROL */
+	uint32_t fmt_truncate_depth;
+	uint32_t fmt_truncate_mode;
+	uint32_t fmt_spatial_dither_en;
+	uint32_t fmt_temporal_dither_en;
+	uint32_t fmt_clamp_en;		/* FMT_CLAMP_CNTL */
+	uint32_t fmt_clamp_color_format;
+	uint32_t fmt_dyn_exp_en;	/* FMT_DYNAMIC_EXP_CNTL */
+	uint32_t fmt_dyn_exp_mode;
+	uint32_t fmt_pixel_encoding;	/* FMT_CONTROL */
+};
 #endif /* DC_HW_TYPES_H */
 
diff --git a/drivers/gpu/drm/amd/display/dc/dc_stream.h b/drivers/gpu/drm/amd/display/dc/dc_stream.h
index f5d6051..1797e32 100644
--- a/drivers/gpu/drm/amd/display/dc/dc_stream.h
+++ b/drivers/gpu/drm/amd/display/dc/dc_stream.h
@@ -234,6 +234,17 @@ struct dc_stream_state {
 	enum dc_color_space output_color_space;
 	enum display_content_type content_type;
 	enum dc_dither_option dither_option;
+	/*
+	 * Hades: the stream is a byte tunnel (the Dolby Vision tunnel of amdgpu_dm, drm_dvbridge.h):
+	 * its RGB 8 bpc pixels are a transport, not a picture, and must reach the encoder as they
+	 * were scanned out. On DCN amdgpu_dm gets there with the stream and plane state it checks.
+	 * On DCE, DC chooses by itself the depth of the line buffer, the prescale, the input gamma
+	 * LUT, the graphics input CSC and the output CSC: with this set, it programs them for the
+	 * bytes (resource_build_scaling_params(), dce110_hwseq.c). Only
+	 * amdgpu_dm_dvbridge_fill_stream() sets it, on a new stream: the tunnel goes on and off
+	 * with a modeset.
+	 */
+	bool byte_tunnel;
 
 	enum view_3d_format view_format;
 
@@ -614,6 +625,14 @@ bool dc_stream_set_gamut_remap(struct dc *dc,
 bool dc_stream_program_csc_matrix(struct dc *dc,
 				  struct dc_stream_state *stream);
 
+/*
+ * Hades: what the pipe of a byte tunnel stream holds on DCE, read back from its registers for the
+ * kernel log (struct dc_byte_tunnel_readback). False when the stream has no pipe with a plane in
+ * the current state, or a block of that pipe cannot be read. It changes nothing.
+ */
+bool dc_stream_read_byte_tunnel(struct dc *dc, const struct dc_stream_state *stream,
+				struct dc_byte_tunnel_readback *readback);
+
 struct dc_rmcm_3dlut *dc_stream_get_3dlut_for_stream(
 	const struct dc *dc,
 	const struct dc_stream_state *stream,
diff --git a/drivers/gpu/drm/amd/display/dc/dce/dce_ipp.c b/drivers/gpu/drm/amd/display/dc/dce/dce_ipp.c
index 72c0950..fea833a 100644
--- a/drivers/gpu/drm/amd/display/dc/dce/dce_ipp.c
+++ b/drivers/gpu/drm/amd/display/dc/dce/dce_ipp.c
@@ -230,6 +230,72 @@ static void dce_ipp_set_degamma(
 		  CURSOR2_DEGAMMA_MODE, degamma_type);
 }
 
+/*
+ * Hades: the graphics input path of a byte tunnel (dc_stream_state.byte_tunnel): the prescale, the
+ * legacy input gamma LUT and the graphics input CSC in bypass, so that each 8-bit component goes
+ * on as it was scanned out (with the line buffer at 24 bpp and the output CSC in bypass, which
+ * resource_build_scaling_params() and set_default_colors() choose for the tunnel).
+ *
+ * dce_ipp_program_prescale() scales an 8-bit surface by 0x2020 (1 + 1/256, to bring the zero
+ * expansion of the memory input to full scale): with the line buffer at 30 bpp, or at 24 bpp if it
+ * rounds, some values would not come out as they went in; the prescale in bypass with the line
+ * buffer at 24 bpp does, whatever the internal precision (by arithmetic, not measured on a DCE).
+ * The input gamma LUT is written from the legacy gamma of the plane, which amdgpu_dm refuses
+ * with the tunnel; it is in bypass here whatever the plane holds. DC never programs the graphics
+ * input CSC: it holds what the VBIOS or a driver before DC left there (amdgpu without DC writes
+ * it to bypass with each LUT, dce_v10_0_crtc_load_lut()). Its mode is kept when the tunnel takes
+ * the pipe and written back when the pipe leaves it, so that a pipe out of the tunnel is
+ * programmed as it was before.
+ */
+static bool dce_ipp_set_byte_passthrough(
+	struct input_pixel_processor *ipp,
+	bool enable)
+{
+	struct dce_ipp *ipp_dce = TO_DCE_IPP(ipp);
+
+	if (!ipp->byte_passthrough_capable)
+		return false;
+
+	if (!enable) {
+		if (ipp_dce->input_csc_held)
+			REG_UPDATE(INPUT_CSC_CONTROL,
+				   INPUT_CSC_GRPH_MODE, ipp_dce->input_csc_before);
+		ipp_dce->input_csc_held = false;
+		ipp->byte_passthrough = false;
+		return true;
+	}
+
+	if (!ipp_dce->input_csc_held) {
+		REG_GET(INPUT_CSC_CONTROL, INPUT_CSC_GRPH_MODE, &ipp_dce->input_csc_before);
+		ipp_dce->input_csc_held = true;
+	}
+	REG_UPDATE(PRESCALE_GRPH_CONTROL, GRPH_PRESCALE_BYPASS, 1);
+	REG_UPDATE(INPUT_GAMMA_CONTROL, GRPH_INPUT_GAMMA_MODE, 1);
+	REG_UPDATE(INPUT_CSC_CONTROL, INPUT_CSC_GRPH_MODE, 0);
+	ipp->byte_passthrough = true;
+	return true;
+}
+
+/* Hades: read back for the kernel log (struct dc_byte_tunnel_readback) */
+static void dce_ipp_read_byte_tunnel(
+	struct input_pixel_processor *ipp,
+	struct dc_byte_tunnel_readback *readback)
+{
+	struct dce_ipp *ipp_dce = TO_DCE_IPP(ipp);
+
+	REG_GET(PRESCALE_GRPH_CONTROL, GRPH_PRESCALE_BYPASS, &readback->prescale_bypass);
+	REG_GET(INPUT_GAMMA_CONTROL, GRPH_INPUT_GAMMA_MODE, &readback->input_gamma_mode);
+	REG_GET(DEGAMMA_CONTROL, GRPH_DEGAMMA_MODE, &readback->degamma_mode);
+	if (ipp->byte_passthrough_capable) {
+		REG_GET(INPUT_CSC_CONTROL, INPUT_CSC_GRPH_MODE, &readback->input_csc_mode);
+		readback->input_csc_mode_before = ipp_dce->input_csc_held ?
+						  ipp_dce->input_csc_before :
+						  readback->input_csc_mode;
+		readback->input_csc_read = true;
+	}
+	readback->ipp_read = true;
+}
+
 #if defined(CONFIG_DRM_AMD_DC_SI)
 static void dce60_ipp_set_degamma(
 	struct input_pixel_processor *ipp,
@@ -251,7 +317,10 @@ static const struct ipp_funcs dce_ipp_funcs = {
 	.ipp_cursor_set_position = dce_ipp_cursor_set_position,
 	.ipp_program_prescale = dce_ipp_program_prescale,
 	.ipp_program_input_lut = dce_ipp_program_input_lut,
-	.ipp_set_degamma = dce_ipp_set_degamma
+	.ipp_set_degamma = dce_ipp_set_degamma,
+	/* Hades: the byte tunnel */
+	.ipp_set_byte_passthrough = dce_ipp_set_byte_passthrough,
+	.ipp_read_byte_tunnel = dce_ipp_read_byte_tunnel
 };
 
 #if defined(CONFIG_DRM_AMD_DC_SI)
@@ -284,6 +353,10 @@ void dce_ipp_construct(
 	ipp_dce->regs = regs;
 	ipp_dce->ipp_shift = ipp_shift;
 	ipp_dce->ipp_mask = ipp_mask;
+
+	/* Hades: the graphics input CSC is listed (IPP_DCE112_REG_LIST_DCE_BASE()) */
+	ipp_dce->base.byte_passthrough_capable =
+		regs->INPUT_CSC_CONTROL && ipp_mask->INPUT_CSC_GRPH_MODE;
 }
 
 #if defined(CONFIG_DRM_AMD_DC_SI)
