From 8fbe188444c0fd1987e359b3981046dbb56562ba Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:29:35 +0200
Subject: [PATCH] amdgpu: expose hdmi frame packed 3d modes

0100-amdgpu-expose-hdmi-frame-packed-3d-modes.patch of cinema-ONE's
LibreELEC tree (https://github.com/cinema-ONE/LibreELEC.tv,
packages/linux/patches/default, as of 8f7810a9d203). The file there is a
plain diff without a description of its own: the subject above is its
file name, and the author and the date are those of the commit that
carries it, 4e703345b57a ("linux: carry the amdgpu HDMI 3D and 8K
patches (0100-0108)").

[Hades: no line of code differs from the original; the diff is
regenerated against Linux 7.2.10 with Hades' patches, whose Dolby Vision
tunnel moves the hunks of amdgpu_dm.c]
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 38 +++++++++++++++++--
 .../amd/display/amdgpu_dm/amdgpu_dm_plane.c   | 13 +++++--
 .../amd/display/dc/optc/dcn10/dcn10_optc.c    |  3 ++
 3 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 55189cd..fa5fbc3 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -7114,7 +7114,29 @@ static void fill_stream_properties_from_drm_display_mode(
 	else
 		timing_out->pixel_encoding = PIXEL_ENCODING_RGB;
 
-	timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
+	switch (mode_in->flags & DRM_MODE_FLAG_3D_MASK) {
+	/* SBS/TAB: the application packs both eyes into a 2D frame, so the
+	 * display core scans out plain 2D; only the VSIF says 3D (see
+	 * create_stream_for_sink). Any DC stereo format here makes the hardware
+	 * treat the plane as two views and paint the whole frame into each. */
+	case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
+	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
+	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL:
+		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
+		stream->view_format = VIEW_3D_FORMAT_NONE;
+		break;
+	/* Frame packing likewise: the doubled 2205-line frame is already laid
+	 * out by the application (eye, 45-line gap, eye), so scan it out as 2D
+	 * too; DC's stereo programming would re-pack it. */
+	case DRM_MODE_FLAG_3D_FRAME_PACKING:
+		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
+		stream->view_format = VIEW_3D_FORMAT_NONE;
+		break;
+	default:
+		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
+		stream->view_format = VIEW_3D_FORMAT_NONE;
+		break;
+	}
 	timing_out->display_color_depth = convert_color_depth_from_display_info(
 		connector,
 		(timing_out->pixel_encoding == PIXEL_ENCODING_YCBCR420),
@@ -7997,6 +8019,9 @@ create_stream_for_sink(struct drm_connector *connector,
 	struct dc_sink *sink = NULL;
 
 	drm_mode_init(&mode, drm_mode);
+	/* frame packing scans out the doubled timing (two eyes plus the gap) */
+	if (mode.flags & DRM_MODE_FLAG_3D_FRAME_PACKING)
+		drm_mode_set_crtcinfo(&mode, CRTC_STEREO_DOUBLE);
 	memset(&saved_mode, 0, sizeof(saved_mode));
 
 	if (connector->connector_type != DRM_MODE_CONNECTOR_WRITEBACK) {
@@ -8076,7 +8101,9 @@ create_stream_for_sink(struct drm_connector *connector,
 	}
 
 	if (recalculate_timing)
-		drm_mode_set_crtcinfo(&saved_mode, 0);
+		drm_mode_set_crtcinfo(&saved_mode,
+				      (saved_mode.flags & DRM_MODE_FLAG_3D_FRAME_PACKING) ?
+				      CRTC_STEREO_DOUBLE : 0);
 
 	/*
 	 * If scaling is enabled and refresh rate didn't change
@@ -8987,7 +9014,9 @@ enum drm_mode_status amdgpu_dm_connector_mode_valid(struct drm_connector *connec
 	if (!test_mode)
 		goto fail;
 
-	drm_mode_set_crtcinfo(test_mode, 0);
+	drm_mode_set_crtcinfo(test_mode,
+			      (test_mode->flags & DRM_MODE_FLAG_3D_FRAME_PACKING) ?
+			      CRTC_STEREO_DOUBLE : 0);
 
 	stream = create_validate_stream_for_sink(connector, test_mode,
 						 to_dm_connector_state(connector->state),
@@ -9807,7 +9836,8 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 	aconnector->dc_link = link;
 	aconnector->base.interlace_allowed = false;
 	aconnector->base.doublescan_allowed = false;
-	aconnector->base.stereo_allowed = false;
+	/* HDMI only: DP->HDMI dongles reject 3D timings in link validation */
+	aconnector->base.stereo_allowed = connector_type == DRM_MODE_CONNECTOR_HDMIA;
 	aconnector->base.dpms = DRM_MODE_DPMS_OFF;
 	aconnector->hpd.hpd = AMDGPU_HPD_NONE; /* not used */
 	aconnector->audio_inst = -1;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
index cfd76c5..8f24bd5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_plane.c
@@ -1101,18 +1101,23 @@ int amdgpu_dm_plane_helper_check_state(struct drm_plane_state *state,
 	if (fb && state->crtc) {
 		/* Validate viewport to cover the case when only the position changes */
 		if (state->plane->type != DRM_PLANE_TYPE_CURSOR) {
+			int mode_hdisplay, mode_vdisplay;
 			int viewport_width = state->crtc_w;
 			int viewport_height = state->crtc_h;
 
+			/* frame-packed 3D scans out the doubled timing */
+			drm_mode_get_hv_timing(&new_crtc_state->mode,
+					       &mode_hdisplay, &mode_vdisplay);
+
 			if (state->crtc_x < 0)
 				viewport_width += state->crtc_x;
-			else if (state->crtc_x + state->crtc_w > new_crtc_state->mode.crtc_hdisplay)
-				viewport_width = new_crtc_state->mode.crtc_hdisplay - state->crtc_x;
+			else if (state->crtc_x + state->crtc_w > mode_hdisplay)
+				viewport_width = mode_hdisplay - state->crtc_x;
 
 			if (state->crtc_y < 0)
 				viewport_height += state->crtc_y;
-			else if (state->crtc_y + state->crtc_h > new_crtc_state->mode.crtc_vdisplay)
-				viewport_height = new_crtc_state->mode.crtc_vdisplay - state->crtc_y;
+			else if (state->crtc_y + state->crtc_h > mode_vdisplay)
+				viewport_height = mode_vdisplay - state->crtc_y;
 
 			if (viewport_width < 0 || viewport_height < 0) {
 				DRM_DEBUG_ATOMIC("Plane completely outside of screen\n");
diff --git a/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c b/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
index e6426cc..addcb9a 100644
--- a/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
+++ b/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
@@ -608,6 +608,9 @@ bool optc1_validate_timing(
 
 	if (timing->timing_3d_format != TIMING_3D_FORMAT_NONE &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_HW_FRAME_PACKING &&
+		timing->timing_3d_format != TIMING_3D_FORMAT_SW_FRAME_PACKING &&
+		timing->timing_3d_format != TIMING_3D_FORMAT_SBS_SW_PACKED &&
+		timing->timing_3d_format != TIMING_3D_FORMAT_TB_SW_PACKED &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_TOP_AND_BOTTOM &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_SIDE_BY_SIDE &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_FRAME_ALTERNATE &&
