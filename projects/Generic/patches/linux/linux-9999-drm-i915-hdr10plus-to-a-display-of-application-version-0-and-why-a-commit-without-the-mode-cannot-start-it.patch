From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:10:53 +0000
Subject: [PATCH] drm/i915: HDR10+ to a display of application version 0, and
 why a commit without the mode cannot start it

Two changes to HDR10PLUS_VSIF on i915 and xe (linux-9982).

A display may declare HDR10+ of application version 0. The rule took
version 1 or later only, as user space did; Kodi now reads a block of
any version (libdisplay-info 0.4.0 drops one of version 0) and sends a
display of version 0 metadata of version 0. intel_hdr10plus_edid_version()
gives the version of the block, the highest of several (-1 without
one), with the walk of intel_hdr10plus_edid_declares(), which now means
any version. An HDR10+ InfoFrame goes out only where its own version
(PB4, bits 7 and 6) is not above the display's, nor above 1
(intel_hdr10plus_version_fits()): metadata of version 1 do not go to a
display of version 0, where the places of 5 and 10 percent are read as
percentiles, as Amlogic sends HDR10+ only to displays of version 1 and as
Kodi decides it. A refusal says so in the kernel log, once.

At 2160p24, 25 and 30 HDR10+ needs the CTA VIC in the AVI InfoFrame,
which a commit of the mode sets. A later commit without ALLOW_MODESET
that brought the first HDR10+ InfoFrame computed the CTA VIC too, so the
fastset check found another AVI InfoFrame and the commit was refused as
one that needs a modeset, with only a debug line: user space saw
EINVAL and the kernel log nothing (issue 2: Dolby Vision sent as HDR10+
on an i3-1005G1 with a Samsung S90H at 2160p23.976). Now, where the CTA
VIC would change the AVI InfoFrame of the same mode in a commit that may
not change the mode (intel_hdr10plus_cta_vic_needs_modeset()), the mode
keeps its HDMI VIC, so the refusal of HDR10+ at it is the one that the
kernel log names ("HDR10+ refused: the HDMI vendor InfoFrame carries
the HDMI VIC ..., and HDR10+ in the commit of the mode"). The commit is
refused as before; only the reason is told. Commits with ALLOW_MODESET,
and every mode without an HDMI VIC, are as before.

Checked: the host test of intel_hdr10plus.h with the new helpers and
mutations; intel_hdmi.c compiled with the command of the kernel's build,
with the same warnings as before. Not run on a GPU; no display of
version 0 is known (none in 216 HDR10+ blocks of the EDIDs at hand).
---
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 41 +++++++++++-----
 .../gpu/drm/i915/display/intel_hdr10plus.h    | 48 ++++++++++++++++---
 2 files changed, 71 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 9a0abdb..a4c9779 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -790,8 +790,8 @@ static u8 intel_hdmi_hdr10plus_cta_vic(const struct intel_crtc_state *crtc_state
 		to_intel_atomic_state(crtc_state->uapi.state) : NULL;
 	const struct edid *edid = drm_edid_raw(to_intel_connector(connector)->detect_edid);
 	struct hdmi_vendor_infoframe vsi;
-	bool listed = false, kept = false;
-	u8 cta_vic, hdmi_vic = 0;
+	bool listed = false, kept = false, same_mode = false;
+	u8 cta_vic, hdmi_vic = 0, old_avi_vic = 0, vic;
 	int i;
 
 	if (!crtc_state->has_infoframe || !info->has_hdmi_infoframe ||
@@ -809,16 +809,22 @@ static u8 intel_hdmi_hdr10plus_cta_vic(const struct intel_crtc_state *crtc_state
 		const struct intel_crtc_state *old_crtc_state =
 			intel_atomic_get_old_crtc_state(state, to_intel_crtc(crtc_state->uapi.crtc));
 
-		kept = old_crtc_state &&
-		       intel_hdr10plus_cta_vic_kept(old_crtc_state->infoframes.avi.avi.video_code,
-						    cta_vic,
-						    drm_mode_equal(&old_crtc_state->hw.adjusted_mode, mode));
+		if (old_crtc_state) {
+			same_mode = drm_mode_equal(&old_crtc_state->hw.adjusted_mode, mode);
+			old_avi_vic = old_crtc_state->infoframes.avi.avi.video_code;
+		}
+		kept = old_crtc_state && intel_hdr10plus_cta_vic_kept(old_avi_vic, cta_vic, same_mode);
 	}
 
-	return intel_hdr10plus_cta_vic(hdmi_vic, cta_vic, info->hdmi.scdc.supported, listed,
-				       edid && intel_hdr10plus_edid_declares((const u8 *)edid,
-							(edid->extensions + 1) * EDID_LENGTH),
-				       conn_state->hdr10plus_vsif != NULL, kept);
+	vic = intel_hdr10plus_cta_vic(hdmi_vic, cta_vic, info->hdmi.scdc.supported, listed,
+				      edid && intel_hdr10plus_edid_declares((const u8 *)edid,
+						       (edid->extensions + 1) * EDID_LENGTH),
+				      conn_state->hdr10plus_vsif != NULL, kept);
+	/* Hades (linux-9999): not where a fastset would have to change the AVI InfoFrame */
+	if (intel_hdr10plus_cta_vic_needs_modeset(vic, old_avi_vic, same_mode,
+						  state && state->base.allow_modeset))
+		return 0;
+	return vic;
 }
 
 static bool
@@ -996,7 +1002,20 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 	/* Hades: HDR10PLUS_VSIF (intel_hdr10plus.h) */
 	if (conn_state->hdr10plus_vsif) {
 		const struct drm_property_blob *blob = conn_state->hdr10plus_vsif;
-
+		const struct edid *edid =
+			drm_edid_raw(to_intel_connector(conn_state->connector)->detect_edid);
+		const int receiver = edid ?
+			intel_hdr10plus_edid_version((const u8 *)edid,
+						     (edid->extensions + 1) * EDID_LENGTH) : -1;
+		const u8 version = blob->length > 3 ? ((const u8 *)blob->data)[3] >> 6 : 0;
+
+		/* Hades (linux-9999): of an application version that the display takes */
+		if (!intel_hdr10plus_version_fits(version, receiver)) {
+			drm_info_once(encoder->base.dev,
+				      "HDR10+ refused: the HDR10+ InfoFrame is of application version %u, and the display declares %d (-1: no HDR10+ block); metadata of version 1 do not go to a display of version 0\n",
+				      version, receiver);
+			return false;
+		}
 		if (!intel_hdr10plus_vsi_empty(frame)) {
 			/* (in the kernel log, once: user space only learns that the commit failed) */
 			drm_info_once(encoder->base.dev,
diff --git a/drivers/gpu/drm/i915/display/intel_hdr10plus.h b/drivers/gpu/drm/i915/display/intel_hdr10plus.h
index b03e90a..18d5e56 100644
--- a/drivers/gpu/drm/i915/display/intel_hdr10plus.h
+++ b/drivers/gpu/drm/i915/display/intel_hdr10plus.h
@@ -73,12 +73,15 @@ static inline bool intel_hdr10plus_fastset_vendor(const u8 *old_frame, const u8
 }
 
 /*
- * The EDID (size bytes) declares HDR10+: a CTA-861 extension with the HDR10+ vendor-specific video
- * data block (extended tag 1, IEEE OUI 90-84-8B), application version 1 or later, as user space
- * asks for it before it sends HDR10PLUS_VSIF (Kodi).
+ * The application version of the HDR10+ vendor-specific video data block of the EDID (size bytes):
+ * a CTA-861 extension with that block (extended tag 1, IEEE OUI 90-84-8B), bits 1 and 0 of the byte
+ * after the OUI, the highest of several; -1 without one. Version 0 too (linux-9999): the display of
+ * version 0 is sent metadata of version 0 (intel_hdr10plus_version_fits()), as user space reads the
+ * same block before it sends HDR10PLUS_VSIF (Kodi's Hdr10PlusBlockVersion(), with this walk).
  */
-static inline bool intel_hdr10plus_edid_declares(const u8 *edid, size_t size)
+static inline int intel_hdr10plus_edid_version(const u8 *edid, size_t size)
 {
+	int version = -1;
 	size_t b;
 
 	for (b = 128; edid && b + 128 <= size; b += 128) {
@@ -94,12 +97,43 @@ static inline bool intel_hdr10plus_edid_declares(const u8 *edid, size_t size)
 				break;
 			if (tag == 7 && len >= 5 && ext[i + 1] == 0x01 &&
 			    ext[i + 2] == 0x8b && ext[i + 3] == 0x84 && ext[i + 4] == 0x90 &&
-			    (ext[i + 5] & 0x3) >= 1)
-				return true;
+			    (int)(ext[i + 5] & 0x3) > version)
+				version = ext[i + 5] & 0x3;
 			i += 1 + len;
 		}
 	}
-	return false;
+	return version;
+}
+
+/* The EDID (size bytes) declares HDR10+, of any application version (intel_hdr10plus_edid_version()) */
+static inline bool intel_hdr10plus_edid_declares(const u8 *edid, size_t size)
+{
+	return intel_hdr10plus_edid_version(edid, size) >= 0;
+}
+
+/*
+ * An HDR10+ InfoFrame of application version payload_version (PB4, bits 7 and 6) goes to a display
+ * whose block declares receiver_version (-1: none) only where it is not above that version, nor
+ * above 1: metadata of version 1 do not go to a display of version 0 (in version 1 the places of 5
+ * and 10 percent are not the percentiles that version 0 has there), as Amlogic sends HDR10+ only
+ * to displays of version 1 and as Kodi decides it (CHDR10PlusOutput::VersionFits()).
+ */
+static inline bool intel_hdr10plus_version_fits(u8 payload_version, int receiver_version)
+{
+	return receiver_version >= 0 && (int)payload_version <= (receiver_version < 1 ? receiver_version : 1);
+}
+
+/*
+ * The CTA VIC of intel_hdr10plus_cta_vic() would change the AVI InfoFrame of the mode on the screen
+ * (old_avi_vic, of the same mode) in a commit that may not change the mode: a fastset compares the
+ * AVI InfoFrame, so the commit would be refused as one that needs a modeset, with nothing in the
+ * kernel log. Then the mode keeps its HDMI VIC, so that the refusal of HDR10+ at it says why
+ * (intel_hdmi_compute_hdmi_infoframe()): HDR10+ at it needs the commit of the mode.
+ */
+static inline bool intel_hdr10plus_cta_vic_needs_modeset(u8 cta_vic, u8 old_avi_vic, bool same_mode,
+							 bool allow_modeset)
+{
+	return cta_vic && same_mode && old_avi_vic != cta_vic && !allow_modeset;
 }
 
