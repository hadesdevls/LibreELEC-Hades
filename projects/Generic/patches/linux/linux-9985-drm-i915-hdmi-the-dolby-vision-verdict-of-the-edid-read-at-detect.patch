From 3aa385d1c8f2bc8fc394b738ae81568cb8dcbc2b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:44:48 +0000
Subject: [PATCH] drm/i915/hdmi: the Dolby Vision verdict of the EDID read at
 detect

The atomic check of the Dolby Vision tunnel (intel_hdmi_compute_config())
and its kernel log read the EDID from the connector's EDID property,
edid_blob_ptr. DRM documents that member as "Protected by
&drm_mode_config.mutex. This must not be used by drivers directly": an
atomic check holds the connection mutex only, and a probe that replaces the
property under mode_config.mutex (a hotplug, a getconnector ioctl) frees the
blob the check may be reading. amdgpu does not do it: it reads the EDID of
the sink the stream holds a reference to.

The verdict is now made where the EDID is read: intel_hdmi_set_edid(),
right after drm_edid_connector_update() made the property of it, under
mode_config.mutex and the connection mutex that every caller of detect and
force holds, reads it with the rule of drm_dvbridge.h and keeps the result
in struct intel_connector (dv_sink: what was found, Standard, Low-Latency,
2160p60). intel_hdmi_unset_edid() empties it, and so does a detect that
finds the port disconnected (on display version 11 and later that path
neither reads nor unsets the EDID, and the probe helper empties the
property). The check reads dv_sink, with the connection mutex asserted, and
the log names what dv_sink lacks; neither reads the EDID property, and the
EDID is no longer walked in every commit of the tunnel.

What is decided is the same: the same rule on the same bytes, read when
they are set rather than when they are used. W=1 on intel_hdmi.c and its xe
copy: no warning.
---
 .../drm/i915/display/intel_display_types.h    |  8 +++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 49 ++++++++++++++-----
 2 files changed, 44 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index b3be703..e4e1952 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -36,6 +36,7 @@
 #include <drm/drm_atomic.h>
 #include <drm/drm_colorop.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_dvbridge.h>
 #include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_framebuffer.h>
@@ -544,6 +545,13 @@ struct intel_connector {
 	 */
 	struct drm_property *dv_link_property;
 	struct drm_property *dv_hdr420_property;
+	/*
+	 * Hades: what the EDID read at detect says of Dolby Vision (drm_dvbridge.h). Written by
+	 * detect and force, which hold the connection mutex, and read by the atomic check of the
+	 * tunnel, which holds it too: the check never reads the EDID property (edid_blob_ptr),
+	 * which is under mode_config.mutex and "must not be used by drivers directly".
+	 */
+	struct drm_dvbridge_sink dv_sink;
 	/*
 	 * The fixed encoder this connector is connected to.
 	 */
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 58ff13a..4f63be0 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2725,7 +2725,6 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 					      const struct intel_dv_lab_link *link, u64 bits,
 					      bool low_latency, char *buf, size_t size)
 {
-	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
 	struct intel_hdmi *hdmi = enc_to_intel_hdmi(encoder);
 	const bool vbt_dual_mode = intel_bios_encoder_supports_dp_dual_mode(encoder->devdata);
 	size_t len = 0;
@@ -2735,15 +2734,14 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 		len += scnprintf(buf + len, size - len, "%sdisplay version %u, enable_dv_lab %d",
 				 len ? "; " : "", DISPLAY_VER(to_intel_display(encoder)),
 				 to_intel_display(encoder)->params.enable_dv_lab);
+	/* (Hades: what the EDID read at detect lacks, drm_dvbridge.h) */
 	if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && low_latency)
 		/* Hades: the rule of Low-Latency over the tunnel (drm_dvbridge_ll.h) */
 		len += scnprintf(buf + len, size - len, "%sLow-Latency: %s", len ? "; " : "",
-				 drm_dvbridge_ll_edid_why(edid ? edid->data : NULL,
-							  edid ? edid->length : 0) ?: "EDID");
+				 drm_dvbridge_sink_why(&connector->dv_sink, true) ?: "EDID");
 	else if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID))
 		len += scnprintf(buf + len, size - len, "%s%s", len ? "; " : "",
-				 intel_dv_lab_edid_why(edid ? edid->data : NULL,
-						       edid ? edid->length : 0) ?: "EDID");
+				 drm_dvbridge_sink_why(&connector->dv_sink, false) ?: "EDID");
 	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID_2160P30))
 		len += scnprintf(buf + len, size - len,
 				 "%sthe version 1 Dolby Vision block does not advertise 2160p60",
@@ -2921,24 +2919,23 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	}
 
 	if (to_intel_digital_connector_state(conn_state)->dv_lab_standard) {
-		const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
-		/* (Hades: read before the link below, whose initializers are not sequenced) */
-		bool p60 = false;
+		/*
+		 * Hades: the sink as the EDID read at detect described it (dv_sink, written under
+		 * the connection mutex that this check holds), not the EDID property
+		 */
+		const struct drm_dvbridge_sink *sink = &connector->dv_sink;
 		/*
 		 * Hades: the sink takes the tunnel requested, Standard or Low-Latency
 		 * (drm_dvbridge_ll.h); sink_standard below is that answer
 		 */
 		const bool low_latency =
 			to_intel_digital_connector_state(conn_state)->dv_lab_low_latency;
-		const bool standard = edid &&
-			(low_latency ? drm_dvbridge_ll_edid(edid->data, edid->length, &p60) :
-				       intel_dv_lab_edid(edid->data, edid->length, &p60));
 		struct intel_dv_lab_link link = {
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
 				intel_dv_lab_platform_supported(DISPLAY_VER(display)),
-			.sink_standard = standard,
-			.sink_2160p60 = p60,
+			.sink_standard = low_latency ? sink->low_latency : sink->standard,
+			.sink_2160p60 = sink->p60,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
 			.native_hdmi = intel_dv_lab_native_hdmi(
@@ -2960,6 +2957,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			.rounded_refresh = drm_mode_vrefresh(adjusted_mode),
 		};
 
+		drm_modeset_lock_assert_held(&display->drm->mode_config.connection_mutex);
 		ret = intel_dv_lab_validate(&link);
 		if (ret) {
 			/* Hades: why, for user space and the kernel log */
@@ -3054,6 +3052,23 @@ intel_hdmi_unset_edid(struct drm_connector *_connector)
 
 	drm_edid_free(connector->detect_edid);
 	connector->detect_edid = NULL;
+	/* Hades: and what it said of Dolby Vision (drm_dvbridge.h): no EDID */
+	drm_dvbridge_edid_read(NULL, 0, &connector->dv_sink);
+}
+
+/*
+ * Hades: what the EDID just read says of Dolby Vision (drm_dvbridge.h), for the atomic check of
+ * the tunnel. The EDID property was just made of it; detect and force are called with
+ * mode_config.mutex held, which protects that property, and the connection mutex, which the
+ * check holds.
+ */
+static void intel_hdmi_dvbridge_sink_read(struct intel_connector *connector)
+{
+	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
+
+	lockdep_assert_held(&connector->base.dev->mode_config.mutex);
+	drm_dvbridge_edid_read(edid ? edid->data : NULL, edid ? edid->length : 0,
+			       &connector->dv_sink);
 }
 
 static void
@@ -3134,6 +3149,8 @@ intel_hdmi_set_edid(struct drm_connector *_connector)
 
 	/* Below we depend on display info having been updated */
 	drm_edid_connector_update(&connector->base, drm_edid);
+	/* Hades: ... and on the Dolby Vision verdict of the same EDID */
+	intel_hdmi_dvbridge_sink_read(connector);
 
 	connector->detect_edid = drm_edid;
 
@@ -3186,6 +3203,12 @@ intel_hdmi_detect(struct drm_connector *_connector, bool force)
 
 	if (status != connector_status_connected)
 		cec_notifier_phys_addr_invalidate(intel_hdmi->cec_notifier);
+	/*
+	 * Hades: a port found disconnected keeps no Dolby Vision sink (on display version 11 and
+	 * later the EDID is not read or unset then; the probe helper empties the EDID property)
+	 */
+	if (status != connector_status_connected)
+		drm_dvbridge_edid_read(NULL, 0, &connector->dv_sink);
 
 	return status;
 }
-- 
2.53.0

