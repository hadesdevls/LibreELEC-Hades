From d25efc42a882ac1a5acec796227a2124096b0579 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:54:20 +0000
Subject: [PATCH] drm: the Standard tunnel only to a sink that lets the source
 select the RGB range

The AVI InfoFrame of the Dolby Vision Standard tunnel says full range RGB
(Q = 2) on i915 and amdgpu, always. Its modes are CTA modes, whose default
RGB range is limited, and CTA-861, as the kernel quotes it in
drm_hdmi_avi_infoframe_quant_range(), says: "A Source shall not send a
non-zero Q value that does not correspond to the default RGB Quantization
Range for the transmitted Picture unless the Sink indicates support for the
Q bit in a Video Capabilities Data Block". The kernel's own rule therefore
sends Q = 0 to a sink without QS, and so does NVIDIA's driver; that is why
Kodi has refused the tunnel there on NVIDIA since it has had it. A sink
told the default range may expand the bytes of the tunnel as limited range,
which no longer carry the picture nor its metadata. Which sinks those are,
and what they do in Dolby Vision, nobody here has seen.

Measured on the 603 real EDIDs of the host test: the Standard rule takes
485; 483 of them declare QS, 0 declare QS = 0, and 2 have no video
capability data block (an "MXX0001" of 2015 with a 12-byte version 1 block,
and a Vestel VES3700 of 2019 with version 2, display management 3).

The rule is now the same on the three backends: the walk of drm_dvbridge.h
also reads QS (a video capability data block of a payload of two bytes, as
DRM's cea_db_is_vcdb()), drm_dvbridge_sink_takes() takes the Standard
tunnel with the Dolby block and QS, and Low-Latency, whose AVI InfoFrame
says YCbCr in the limited range (the default), with the Dolby block alone.
i915 and amdgpu refuse a Standard tunnel without QS with the reason EDID,
and the kernel log says what is missing (drm_dvbridge_sink_takes_why();
amdgpu's log names now the reason of the rule, as i915's did, where it had
one sentence for every refusal of the EDID). The two sinks of the corpus
without the block leave the tunnel for the normal path of Kodi (HDR10).

The Dolby block rule itself does not change: the five verdict functions
give, on the 603 EDIDs and 400 mutations of each, the same 242061 lines as
before. The QS of the walk agrees with an independent reading of the
corpus on every EDID that the Standard rule takes (6 others differ: the
walk stops at an invalid Dolby block before their capability block). W=1
on i915, its xe copies and amdgpu_dm: no warning.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   |  2 +-
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 14 ++----
 drivers/gpu/drm/i915/display/intel_hdmi.c     |  6 +--
 include/drm/drm_dvbridge.h                    | 46 +++++++++++++++++--
 4 files changed, 51 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 82e6d95..cfcfaae 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1681,7 +1681,7 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 		return -EOPNOTSUPP;
 	/* (Hades: the rule of drm_dvbridge.h, read once) */
 	drm_dvbridge_edid_read(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length, &sink);
-	if (!(low_latency ? sink.low_latency : sink.standard))
+	if (!drm_dvbridge_sink_takes(&sink, low_latency))
 		return -EOPNOTSUPP;
 	if (!vic || (mode->flags & DRM_MODE_FLAG_3D_MASK))
 		return -EINVAL;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 8ff58e7..47d85bf 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -249,19 +249,15 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 	/* (Hades: the rule of drm_dvbridge.h, as amdgpu_dm_dvbridge_fill_stream() read it) */
 	drm_dvbridge_edid_read(stream->sink ? stream->sink->dc_edid.raw_edid : NULL,
 			       stream->sink ? stream->sink->dc_edid.length : 0, &sink);
-	if (low_latency && (!stream->sink || !sink.low_latency)) {
-		/* Hades: Low-Latency over the tunnel (drm_dvbridge_ll.h) */
-		const char *why = stream->sink ? drm_dvbridge_sink_why(&sink, true) : "no sink";
+	if (!stream->sink || !drm_dvbridge_sink_takes(&sink, low_latency)) {
+		/* Hades: what the EDID lacks (drm_dvbridge.h), Low-Latency over the tunnel too */
+		const char *why = stream->sink ? drm_dvbridge_sink_takes_why(&sink, low_latency) :
+						 "no sink";
 
 		bits |= REFUSED(EDID);
 		len += scnprintf(detail + len, sizeof(detail) - len,
-				 "%sLow-Latency: %s", len ? "; " : "",
+				 "%s%s%s", len ? "; " : "", low_latency ? "Low-Latency: " : "",
 				 why ? why : "the EDID changed while it was read");
-	} else if (!low_latency && (!stream->sink || !sink.standard)) {
-		bits |= REFUSED(EDID);
-		len += scnprintf(detail + len, sizeof(detail) - len,
-				 "%sthe EDID has no Dolby Vision block that this driver takes (version 2 with the Standard interface, or the 12-byte version 1 block with low latency)",
-				 len ? "; " : "");
 	} else if (!sink.p60 && drm_dvbridge_vic_needs_p60(vic)) {
 		bits |= REFUSED(EDID_2160P30);
 		len += scnprintf(detail + len, sizeof(detail) - len,
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 29fc777..14cc4f1 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2738,10 +2738,10 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 	if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && low_latency)
 		/* Hades: the rule of Low-Latency over the tunnel (drm_dvbridge_ll.h) */
 		len += scnprintf(buf + len, size - len, "%sLow-Latency: %s", len ? "; " : "",
-				 drm_dvbridge_sink_why(&connector->dv_sink, true) ?: "EDID");
+				 drm_dvbridge_sink_takes_why(&connector->dv_sink, true) ?: "EDID");
 	else if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID))
 		len += scnprintf(buf + len, size - len, "%s%s", len ? "; " : "",
-				 drm_dvbridge_sink_why(&connector->dv_sink, false) ?: "EDID");
+				 drm_dvbridge_sink_takes_why(&connector->dv_sink, false) ?: "EDID");
 	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID_2160P30))
 		len += scnprintf(buf + len, size - len,
 				 "%sthe version 1 Dolby Vision block does not advertise 2160p60",
@@ -2934,7 +2934,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
 				intel_dv_lab_platform_supported(DISPLAY_VER(display)),
-			.sink_standard = low_latency ? sink->low_latency : sink->standard,
+			.sink_standard = drm_dvbridge_sink_takes(sink, low_latency),
 			.sink_2160p60 = sink->p60,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
diff --git a/include/drm/drm_dvbridge.h b/include/drm/drm_dvbridge.h
index 0724d5a..d1c16ab 100644
--- a/include/drm/drm_dvbridge.h
+++ b/include/drm/drm_dvbridge.h
@@ -14,6 +14,14 @@
  * - Low-Latency in YCbCr 4:2:2 at 12 bits (drm_dvbridge_ll.h): version 2 with any interface, or the
  *   12-byte version 1 block with the low-latency field 1. No display management version is needed.
  * - 2160p50 and 2160p60: always with version 2; with version 1, its 2160p60 bit.
+ * - The Standard tunnel sends an AVI InfoFrame that says full range RGB, which is not the default
+ *   range of its CTA modes (limited). CTA-861, as drm_hdmi_avi_infoframe_quant_range() quotes it:
+ *   "A Source shall not send a non-zero Q value that does not correspond to the default RGB
+ *   Quantization Range for the transmitted Picture unless the Sink indicates support for the Q
+ *   bit in a Video Capabilities Data Block". So the Standard tunnel also needs QS in a video
+ *   capability data block (drm_dvbridge_sink_takes()), as NVIDIA's backend in Kodi always asked;
+ *   483 of the 485 real EDIDs of the host test that the Standard rule takes have it, the other 2
+ *   have no such block. Low-Latency sends YCbCr, limited range, the default: no QS needed.
  * Every block of the EDID is walked: an HDMI Forum EEODB makes the EDID longer than its base block's
  * extension count. Extensions that are not CTA (DisplayID) are skipped: a TV puts its CTA data blocks
  * in CTA extensions (none of the 603 EDIDs of the host test has a Dolby block in DisplayID).
@@ -47,7 +55,8 @@ enum drm_dvbridge_edid_result {
  * The sink as its EDID describes it. standard and low_latency are true only with
  * DRM_DVBRIDGE_EDID_TAKEN. p60 is what the Dolby block read says of 2160p50 and 2160p60, left as
  * the walk had it when it stopped (as the drivers' copies of the rule did); it means something only
- * with one of the two modes.
+ * with one of the two modes. qs: a video capability data block (of a payload of two bytes, as DRM
+ * reads it) before the walk stopped lets the source select the RGB quantization range.
  */
 struct drm_dvbridge_sink {
 	enum drm_dvbridge_edid_result result;
@@ -55,6 +64,7 @@ struct drm_dvbridge_sink {
 	bool standard;
 	bool low_latency;
 	bool p60;
+	bool qs;
 };
 
 static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
@@ -68,6 +78,7 @@ static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
 	sink->standard = false;
 	sink->low_latency = false;
 	sink->p60 = false;
+	sink->qs = false;
 	if (!edid || !size)
 		return;
 	sink->result = DRM_DVBRIDGE_EDID_SIZE;
@@ -105,6 +116,9 @@ static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
 				sink->result = DRM_DVBRIDGE_EDID_DATA_BLOCK;
 				goto refused;
 			}
+			/* Video capability data block: QS */
+			if ((b[pos] >> 5) == 7 && len == 2 && data[0] == 0x00 && (data[1] & 0x40))
+				sink->qs = true;
 			/* Extended vendor-specific video block, little-endian Dolby OUI */
 			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
 			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
@@ -189,7 +203,30 @@ static inline const char *drm_dvbridge_sink_why(const struct drm_dvbridge_sink *
 	       "the version 1 Dolby Vision block is not the 12-byte one with low latency 1 (it asks for the HDMI 1.4b vendor InfoFrame, which this driver does not send)";
 }
 
-/* The sink takes the tunnel in Standard (TV-led) Dolby Vision. *p60: as struct drm_dvbridge_sink. */
+/*
+ * The sink takes the tunnel requested: Standard with the Dolby block and QS for the full range
+ * RGB of its AVI InfoFrame, or Low-Latency with the Dolby block.
+ */
+static inline bool drm_dvbridge_sink_takes(const struct drm_dvbridge_sink *sink, bool low_latency)
+{
+	return low_latency ? sink->low_latency : sink->standard && sink->qs;
+}
+
+/* Why drm_dvbridge_sink_takes() is false, for the kernel log; NULL when it is true. */
+static inline const char *drm_dvbridge_sink_takes_why(const struct drm_dvbridge_sink *sink,
+						      bool low_latency)
+{
+	const char *why = drm_dvbridge_sink_why(sink, low_latency);
+
+	if (why || low_latency || sink->qs)
+		return why;
+	return "the EDID has no video capability data block with QS, so the full range RGB of the tunnel's AVI InfoFrame cannot be signalled (CTA-861)";
+}
+
+/*
+ * The Dolby block advertises Standard (TV-led) Dolby Vision (the Dolby VSVDB rule alone, without
+ * QS: the rule that Kodi's ScanDolbyVideo() follows). *p60: as struct drm_dvbridge_sink.
+ */
 static inline bool drm_dvbridge_edid_standard(const u8 *edid, size_t size, bool *p60)
 {
 	struct drm_dvbridge_sink sink;
@@ -228,8 +265,9 @@ static inline bool drm_dvbridge_vic_needs_p60(u8 vic)
 /*
  * The AVI InfoFrame of the tunnel, from the one the driver built for the mode (its aspect ratio
  * and content type): RGB is a byte tunnel here, not a colour-managed picture, so the frame says
- * RGB, no colorimetry and full range, with the CTA VIC of drm_dvbridge_avi_vic(). (The YQ field
- * stays as each driver sets it for RGB; a sink ignores it with RGB, CTA-861-F.)
+ * RGB, no colorimetry and full range (to a sink that declares QS: drm_dvbridge_sink_takes()),
+ * with the CTA VIC of drm_dvbridge_avi_vic(). (The YQ field stays as each driver sets it for
+ * RGB; a sink ignores it with RGB, CTA-861-F.)
  */
 static inline void drm_dvbridge_tunnel_avi(struct hdmi_avi_infoframe *frame, u8 vic)
 {
-- 
2.53.0

