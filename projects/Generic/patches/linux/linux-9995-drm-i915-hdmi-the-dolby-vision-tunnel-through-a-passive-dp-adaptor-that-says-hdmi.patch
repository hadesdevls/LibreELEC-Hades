From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:25:21 +0000
Subject: [PATCH 1/5] drm/i915/hdmi: the Dolby Vision tunnel through a passive
 DP++ adaptor that says HDMI

A passive DisplayPort dual-mode adaptor (DP++) on a dual-mode port makes
i915 drive the display through the HDMI connector of the port: the port
sends TMDS itself, as HDMI, and the adaptor shifts its levels. The
display gets what a native HDMI port sends, InfoFrames included.

The tunnel refused every such adaptor: intel_dv_lab_native_hdmi() takes
an adaptor found on a port that the VBT calls dual-mode for a conversion
(DVBRIDGE_REFUSED "converter"), the HDMI ones too, and 3D, HDR10 and
HLG went through them while Dolby Vision did not. What an adaptor limits
is the TMDS clock (DP Dual-Mode Standard: 165 MHz for type 1, what its
register says for type 2), and the configuration of the port already
keeps the tunnel to it: hdmi_port_clock_limit() takes the adaptor's
clock with the downstream limits, and intel_hdmi_compute_config() does
not try again past them when the tunnel is asked for, so a mode that
the adaptor cannot carry in RGB at 8 bits is refused for its TMDS clock
(DRM_DVBRIDGE_REFUSED_TMDS), as on a native port of 300 MHz.

An adaptor that identifies itself as an HDMI one (type 1 or 2 HDMI, by
the HDMI ID that drm_dp_dual_mode_detect() reads) now carries the tunnel:
1080p at 24 to 60 Hz through either type, 2160p at 24 to 30 Hz through
a type 2 adaptor of 300 MHz, never 2160p50 or 60 (594 MHz). An adaptor
that does not say it is an HDMI one stays refused, failing closed: a
DVI adaptor of either type, and one that answered nothing, which
intel_hdmi_dp_dual_mode_detect() takes for a type 1 DVI one on a
dual-mode port. A native HDMI port, with or without a level shifter that
answers the dual-mode ID, and an LSPCON, are as before.

The kernel log names the adaptor once for each one found, with its type
and clock, and whether the tunnel can go through it; drm.debug was
needed for that before. The refusal of a DVI adaptor says that only an
HDMI one carries the tunnel.

Checked on the host, with drm_dp_dual_mode_helper.c as it is and
intel_dv_lab_policy.h of the tree, over register bytes made up for each
adaptor: 9 adaptors (none, level shifters on a native port, type 1 and
2 DVI and HDMI, no answer, LSPCON) and 5 modes, 306 checks; the policy
before this change fails 42 of them (the HDMI adaptors), and each of 5
mutants of it fails. W=1 of intel_hdmi.o for i915 and xe: no warning.

Not tried with an adaptor on hardware.
---
 .../drm/i915/display/intel_display_types.h    |  8 ++++
 .../drm/i915/display/intel_dv_lab_policy.h    | 23 ++++++++++-
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 38 +++++++++++++++++--
 3 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 2d12c25275b8..1c3be86e7dc9 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -1776,6 +1776,14 @@ struct intel_hdmi {
 		enum drm_dp_dual_mode_type type;
 		int max_tmds_clock;
 	} dp_dual_mode;
+	/*
+	 * Hades: the dual-mode adaptor that the kernel log named last (intel_hdmi_dp_dual_mode_detect());
+	 * type DRM_DP_DUAL_MODE_NONE after a display without one
+	 */
+	struct {
+		enum drm_dp_dual_mode_type type;
+		int max_tmds_clock;
+	} dp_dual_mode_logged;
 	struct intel_connector *attached_connector;
 	struct cec_notifier *cec_notifier;
 	/* Hades: what the kernel log said last of QMS (intel_qms.h); 0 when it said nothing */
diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index 4b70eb26290f..bf3dc7f3687d 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -9,6 +9,7 @@
 #define __INTEL_DV_LAB_POLICY_H__
 #include <linux/types.h>
 #include <linux/errno.h>
+#include <drm/display/drm_dp_dual_mode_helper.h>
 #include <drm/drm_dvbridge.h>
 #include <drm/drm_dvbridge_hdr10t.h>
 #include <drm/drm_dvbridge_refused.h>
@@ -39,11 +40,29 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
  * Active LSPCON conversion remains outside the supported transport path.
  * (Hades: a port with an LSPCON gets a DisplayPort connector, not an HDMI one
  * (intel_ddi_init()), so lspcon_active is not true here; the test is kept as a guard.)
+ *
+ * Hades: a passive adaptor on a dual-mode (DP++) port is no conversion when it identifies itself
+ * as an HDMI one (type 1 or type 2 HDMI: the HDMI ID of the DP Dual-Mode Standard, as
+ * drm_dp_dual_mode_detect() reads it). The port sends TMDS itself, as HDMI, through the HDMI
+ * connector of the port; the adaptor shifts its levels, InfoFrames included, and the sink gets
+ * what a native HDMI port sends. What the adaptor limits is the TMDS clock (165 MHz for type 1,
+ * what its register says for type 2), which the configuration of the port keeps to with the
+ * tunnel: hdmi_port_clock_limit() takes the adaptor's clock, and a configuration that does not fit
+ * is not tried again past the downstream limits when the tunnel is asked for (REFUSED_TMDS). An
+ * adaptor that does not identify itself as an HDMI one stays refused: a DVI adaptor (type 1 or 2),
+ * or one that answered nothing, which intel_hdmi_dp_dual_mode_detect() takes on a dual-mode port
+ * for a type 1 DVI one. Nothing says that it carries more than DVI, and the tunnel fails closed
+ * there (REFUSED_CONVERTER). The other types (none, and an LSPCON) are as before.
  */
 static inline bool intel_dv_lab_native_hdmi(bool lspcon_active,
-					 bool dual_mode_detected, bool vbt_dual_mode)
+					 enum drm_dp_dual_mode_type dual_mode, bool vbt_dual_mode)
 {
-	return !lspcon_active && (!dual_mode_detected || !vbt_dual_mode);
+	const bool dual_mode_detected = dual_mode != DRM_DP_DUAL_MODE_NONE;
+	/* Hades: an adaptor that identifies itself as an HDMI one */
+	const bool dual_mode_hdmi = dual_mode == DRM_DP_DUAL_MODE_TYPE1_HDMI ||
+				    dual_mode == DRM_DP_DUAL_MODE_TYPE2_HDMI;
+
+	return !lspcon_active && (!dual_mode_detected || !vbt_dual_mode || dual_mode_hdmi);
 }
 
 /*
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 6eff8bc9ab03..533682c21cdb 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -3107,9 +3107,13 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 		len += scnprintf(buf + len, size - len,
 				 "%sthe version 1 Dolby Vision block does not advertise 2160p60",
 				 len ? "; " : "");
+	/*
+	 * (Hades: on a dual-mode port, an adaptor that identifies itself as an HDMI one carries the
+	 * tunnel; this is any other: intel_dv_lab_native_hdmi())
+	 */
 	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_CONVERTER))
 		len += scnprintf(buf + len, size - len,
-				 "%sDisplayPort dual-mode adaptor: %s, the VBT says the port is dual-mode: %s, LSPCON: %s",
+				 "%sDisplayPort dual-mode adaptor: %s (one that identifies itself as an HDMI adaptor carries the tunnel), the VBT says the port is dual-mode: %s, LSPCON: %s",
 				 len ? "; " : "",
 				 drm_dp_get_dual_mode_type_name(hdmi->dp_dual_mode.type),
 				 str_yes_no(vbt_dual_mode),
@@ -3321,9 +3325,10 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			.hdr10t = hdr10t,
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
 				connector->base.display_info.has_hdmi_infoframe,
+			/* (Hades: the type of a dual-mode adaptor, which can be an HDMI one) */
 			.native_hdmi = intel_dv_lab_native_hdmi(
 				enc_to_dig_port(encoder)->lspcon.active,
-				enc_to_intel_hdmi(encoder)->dp_dual_mode.type != DRM_DP_DUAL_MODE_NONE,
+				enc_to_intel_hdmi(encoder)->dp_dual_mode.type,
 				intel_bios_encoder_supports_dp_dual_mode(encoder->devdata)),
 			.rgb = pipe_config->output_format == INTEL_OUTPUT_FORMAT_RGB &&
 				pipe_config->sink_format == INTEL_OUTPUT_FORMAT_RGB,
@@ -3494,6 +3499,7 @@ intel_hdmi_dp_dual_mode_detect(struct drm_connector *_connector)
 	struct intel_encoder *encoder = &hdmi_to_dig_port(hdmi)->base;
 	struct i2c_adapter *ddc = connector->base.ddc;
 	enum drm_dp_dual_mode_type type;
+	int adaptor_clock;
 
 	type = drm_dp_dual_mode_detect(display->drm, ddc);
 
@@ -3517,12 +3523,17 @@ intel_hdmi_dp_dual_mode_detect(struct drm_connector *_connector)
 		}
 	}
 
-	if (type == DRM_DP_DUAL_MODE_NONE)
+	if (type == DRM_DP_DUAL_MODE_NONE) {
+		/* (Hades: an adaptor found later is named again in the log) */
+		hdmi->dp_dual_mode_logged.type = DRM_DP_DUAL_MODE_NONE;
 		return;
+	}
 
 	hdmi->dp_dual_mode.type = type;
 	hdmi->dp_dual_mode.max_tmds_clock =
 		drm_dp_dual_mode_max_tmds_clock(display->drm, type, ddc);
+	/* (Hades: for the log below, what the adaptor said before the VBT has its word) */
+	adaptor_clock = hdmi->dp_dual_mode.max_tmds_clock;
 
 	drm_dbg_kms(display->drm,
 		    "DP dual mode adaptor (%s) detected (max TMDS clock: %d kHz)\n",
@@ -3536,6 +3547,27 @@ intel_hdmi_dp_dual_mode_detect(struct drm_connector *_connector)
 			    "Ignoring DP dual mode adaptor max TMDS clock for native HDMI port\n");
 		hdmi->dp_dual_mode.max_tmds_clock = 0;
 	}
+
+	/*
+	 * Hades: the adaptor in the kernel log, once for each one found (its type and its clock), so
+	 * that a report says what is between the port and the display without drm.debug, and whether
+	 * the Dolby Vision tunnel can go through it (intel_dv_lab_native_hdmi())
+	 */
+	if (hdmi->dp_dual_mode_logged.type != type ||
+	    hdmi->dp_dual_mode_logged.max_tmds_clock != adaptor_clock) {
+		const bool vbt = intel_bios_encoder_supports_dp_dual_mode(encoder->devdata);
+
+		hdmi->dp_dual_mode_logged.type = type;
+		hdmi->dp_dual_mode_logged.max_tmds_clock = adaptor_clock;
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] DisplayPort dual-mode adaptor: %s, TMDS clock up to %d kHz%s\n",
+			 connector->base.base.id, connector->base.name,
+			 drm_dp_get_dual_mode_type_name(type), adaptor_clock,
+			 !vbt ? " (not taken as one: the VBT says that the port is a native HDMI one)" :
+			 intel_dv_lab_native_hdmi(false, type, true) ?
+			 "; the Dolby Vision tunnel can go through it" :
+			 "; no Dolby Vision tunnel through it: it does not identify itself as an HDMI adaptor");
+	}
 }
 
