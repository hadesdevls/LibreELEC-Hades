From 91082d798c94b7b040d478efa6b0b501bc788d0e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:34:55 +0000
Subject: [PATCH] drm/amd/display: Dolby Vision Standard tunnel on DCN 4.0.1

linux-9910 offers DVBRIDGE_DV_STANDARD_LAB on the pipelines it was
reviewed for, and linux-9940 added DCN 1 and 2. DCN 4.0.1 (GC 12.0.0
and 12.0.1, dc_resource.c) programs the scanout through the same DC
paths, with blocks of its own. Reviewed stage by stage in 7.2.11, with
the state that linux-9910 and linux-9973 require (XRGB8888 primary
plane alone, unscaled, opaque; no plane or CRTC colour properties;
COLOR_SPACE_SRGB; RGB 8 bpc over TMDS; DITHER_OPTION_TRUN8; no visual
confirm, no stream 3D LUT or shaper):

- HUBP: hubp2_program_pixel_format() and hubp2_program_rotation(), as
  on DCN 2 and 3;
- format converter (dpp401_dpp_setup()): ARGB8888 with zero expansion,
  no alpha processing; the input CSC in bypass for RGB
  (dpp3_program_post_csc(INPUT_CSC_SELECT_BYPASS));
- bias and scale of the format converter
  (dpp35_program_bias_and_scale_fcnv()): bias 0 and scale 1.0, as only a
  surface update sets it and amdgpu_dm sends none;
- pre-degamma and degamma in bypass, the HDR multiplier 1.0
  (dcn32_set_input_transfer_func()); no gamut remap in the DPP: it is in
  the MPC (dcn401_program_gamut_remap()), in bypass without a matrix;
- scaler: SPL with its edge adaptive filter (EASF) and its sharpener
  (ISHARP). At unity ratios SPL chooses 444 bypass, one tap, EASF and
  ISHARP off (spl_get_dscl_mode(), spl_get_isharp_en() and
  spl_get_optimal_number_of_taps()),
  and the DPP writes them so (dpp401_dscl_set_scaler_manual_scale()).
  That holds unless the debug options force scaling (always_scale) or
  sharpening (force_sharpness other than SHARPNESS_HW_OFF: with
  SHARPNESS_ZERO, ISHARP is on at 1:1 for RGB), or the plane has
  adaptive sharpness. amdgpu_dm sets none of them; the tunnel is now
  refused with any of them on DCN 4.0.1;
- colour management before blending (1D LUT, shaper, 3D LUT) is in the
  MPC (MCM). With its 3D LUT from system memory, the value of a new
  plane, dcn401_set_mcm_luts() programs it from the plane's blend_tf,
  in_shaper_func and lut3d_func, which the tunnel already requires in
  bypass. From video memory it is programmed from mcm_luts and
  mcm_shaper_3dlut_setting instead (dcn401_populate_mcm_luts()), which
  only the cm2_params of a surface update set; amdgpu_dm sends none. The
  tunnel is now refused on DCN 4.0.1 with any of them away from bypass;
- blending: one MPCC, top layer, global alpha 0xff, not premultiplied
  (dcn20_update_mpcc()), as on DCN 3; MPC_SPLIT_AVOID by default;
- output gamma (dcn401_set_output_transfer_func(), the code of DCN 3.2)
  in bypass for the bypass TF, and the output CSC the identity without
  offsets for COLOR_SPACE_SRGB (mpc3_set_ocsc_default()). The commit
  setup now refuses a tunnelled stream on DCN 4.0.1 whose output TF is
  not bypass, as linux-9940 does on DCN 1 and 2;
- output formatter: the OPP of DCN 2 and 3 (opp1_program_fmt():
  truncation to 8 bits, no dither, clamping to the full range); with
  ODM combine each OPP gets it, and the extra left edge pixel is 0 for
  RGB;
- no colour histogram on 4.0.1 (no CM_HIST registers, no
  program_cm_hist), and no RMCM 3D LUT;
- HDMI stream encoder (enc401_stream_encoder_hdmi_set_stream_attribute()):
  RGB, 8 bpc without deep colour, scrambling above 340 MHz; its
  DOLBY_VISION_EN bit of HDMI_CONTROL is cleared by
  dcn30_program_dmdata_engine() when the stream is enabled. The AVI
  InfoFrame and the vendor one (the Dolby VSIF, 27 bytes) go in generic
  packets through enc3_stream_encoder_update_hdmi_info_packets(), at
  modeset and on the stream update of linux-9910;
- HDMI FRL is off by default (DC_FRL_MASK is not in the default
  dcfeaturemask): the link is TMDS, and linux-9910 refuses FRL anyway.

What cannot be read from the code: the semantics of the registers the
code writes (as on every generation), what the closed DMUB firmware
does with FAMS2 and its flip offload (dcn401 turns them on; DCN 3.2 has
the first version of FAMS, and the tunnel runs there), and the effect
of DOLBY_VISION_EN, which the code keeps at 0.

DCN 4.2 and 4.2B (dcn42, dcn42b) have resources of their own with a
colour histogram and are not offered: the gate names DCN 4.0.1 alone.

Not tested on hardware: no RDNA4 graphics card is at hand.

Ported to Linux 7.3: 7.3 split amdgpu_dm.c; the hunks of the tunnel block
go to amdgpu_dm_connector.c with it (linux-9910), and the one of
amdgpu_dm_atomic_setup_commit() stays in amdgpu_dm.c. The review above was
made on 7.2.11; against 7.2.12 and 7.3 the stages read the same, but for:
- the MCM: 7.3 keeps the 1D LUT, the shaper and the 3D LUT of a plane in
  dc_plane_state.cm, and dcn401_set_mcm_luts() programs each from there
  only with its flag (blend_enable, shaper_enable, lut3d_enable; a 3D LUT
  from video memory is cm.lut3d_dma under lut3d_dma_enable);
  dcn401_populate_mcm_luts() is gone. linux-9910 on 7.3 requires all of
  cm off; mcm_luts, mcm_shaper_3dlut_setting and mcm_lut1d_enable are no
  longer programmed (dml21 still reads the 3D LUT source of mcm_luts) and
  stay refused away from their defaults. The comment says so;
- dcn401_set_output_transfer_func() and dcn401_program_gamut_remap() take
  their arguments in a struct and do the same; dcn32_set_input_transfer_func()
  calls dpp_set_pregam_state() where the DPP has it (DCN 5 and 6, not
  4.0.1), and dcn20_update_mpcc() reads the renamed update bits;
- SPL: spl_get_optimal_number_of_taps() tells horizontal from vertical
  subsampling, which changes nothing for RGB; spl_get_dscl_mode() and
  spl_get_isharp_en(), the DPP setup and scaler, the post CSC, the bias and
  scale, the formatter, the HDMI stream encoder and the dmdata engine do
  not differ from 7.2.12. 7.3 adds a colour histogram, programmed on DCN
  4.2 and 6 only.
Not run on a DCN 4.0.1 GPU.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  7 ++-
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 46 +++++++++++++++++--
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 28 ++++++++++-
 3 files changed, 75 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index e98e4eb..65fe956 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4994,11 +4994,14 @@ static int amdgpu_dm_atomic_setup_commit(struct drm_atomic_commit *state)
 		 * The output gamma of a Dolby Vision tunnel must be in bypass. The colour update
 		 * above sets it whenever the atomic check let the tunnel through; on DCN 1 and 2,
 		 * reviewed for the bypass TF only, make sure of it: there a predefined sRGB output
-		 * TF, the TF a new stream starts with, selects the sRGB regamma ROM of DCN 1.
+		 * TF, the TF a new stream starts with, selects the sRGB regamma ROM of DCN 1. Hades:
+		 * and on DCN 4.0.1, reviewed for the bypass TF only too (its output gamma in the MPC
+		 * is programmed from a TF of distributed points).
 		 */
 		if (dm_new_crtc_state->base.active &&
 		    amdgpu_dm_dvbridge_stream_active(dm_new_crtc_state->stream) &&
-		    dm_new_crtc_state->stream->ctx->dce_version < DCN_VERSION_3_0 &&
+		    (dm_new_crtc_state->stream->ctx->dce_version < DCN_VERSION_3_0 ||
+		     dm_new_crtc_state->stream->ctx->dce_version == DCN_VERSION_4_01) &&
 		    dm_new_crtc_state->stream->out_transfer_func.type != TF_TYPE_BYPASS) {
 			drm_warn_once(state->dev,
 				      "[CRTC:%d:%s] Dolby Vision tunnel refused: output gamma not in bypass\n",
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 28f78e2..fa05e9a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1788,6 +1788,43 @@ static int amdgpu_dm_dvbridge_check_stream_extras(const struct dc_stream_state *
 	return 0;
 }
 
+/*
+ * Hades: DCN 4.0.1 (DPP401, MPC401, and the OPP of DCN 2 and 3) programs the scanout as DCN 3 does
+ * from the state that amdgpu_dm_dvbridge_check_scanout() checks, with these blocks of its own:
+ *
+ * - The scaler goes through SPL (dc->config.use_spl), with its edge adaptive filter (EASF) and
+ *   its sharpener (ISHARP). At unity ratios SPL puts it in 444 bypass, with one tap and EASF and
+ *   ISHARP off (spl_get_dscl_mode(), spl_get_isharp_en(), spl_get_optimal_number_of_taps()), and
+ *   dpp401_dscl_set_scaler_manual_scale() writes them so. That holds unless the debug options
+ *   force scaling (always_scale) or sharpening (force_sharpness other than SHARPNESS_HW_OFF:
+ *   SHARPNESS_ZERO turns ISHARP on at 1:1 for RGB, SHARPNESS_CUSTOM with the plane's adaptive
+ *   sharpness), which nothing of amdgpu_dm sets: refused here otherwise.
+ * - The colour management of the plane before blending (1D LUT, shaper, 3D LUT) is in the MPC
+ *   (MCM). dcn401_set_mcm_luts() programs it from the cm of the plane, each LUT only with its
+ *   flag (blend_enable, shaper_enable, lut3d_enable, and lut3d_dma_enable for a 3D LUT from
+ *   video memory), which amdgpu_dm_dvbridge_check_scanout() already requires off. mcm_luts,
+ *   mcm_shaper_3dlut_setting and mcm_lut1d_enable, from which Linux 7.2 programmed a 3D LUT
+ *   from video memory, are no longer programmed (dml21 still reads the source of the 3D LUT in
+ *   mcm_luts): they stay refused away from their defaults.
+ * - The DPP has no gamut remap: it is in the MPC, from the matrices of the plane and the stream
+ *   already checked. The output gamma and CSC are in the MPC as on DCN 3
+ *   (dcn401_set_output_transfer_func(), mpc3_set_ocsc_default()); the commit setup refuses a
+ *   tunnelled stream whose output TF is not bypass, as on DCN 1 and 2.
+ */
+static int amdgpu_dm_dvbridge_check_dcn4(const struct dc_stream_state *stream,
+					 const struct dc_plane_state *dc_plane)
+{
+	const struct dc *dc = stream->ctx->dc;
+
+	if (dc->debug.force_sharpness != SHARPNESS_HW_OFF || dc->debug.always_scale ||
+	    dc_plane->adaptive_sharpness_en || dc_plane->sharpness_level ||
+	    dc_plane->mcm_luts.lut3d_data.lut3d_src != DC_CM2_TRANSFER_FUNC_SOURCE_SYSMEM ||
+	    dc_plane->mcm_shaper_3dlut_setting != DC_CM2_SHAPER_3DLUT_SETTING_BYPASS_ALL ||
+	    dc_plane->mcm_lut1d_enable)
+		return -EINVAL;
+	return 0;
+}
+
 /* Refuse colour processing and compositing: never bypass a user setting silently. */
 int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 				     struct drm_crtc *crtc,
@@ -1881,6 +1918,8 @@ int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 		return -EINVAL;
 	if (stream->ctx->dce_version < DCN_VERSION_3_0)
 		return amdgpu_dm_dvbridge_check_dcn1_2(stream, dc_plane);
+	if (stream->ctx->dce_version == DCN_VERSION_4_01)
+		return amdgpu_dm_dvbridge_check_dcn4(stream, dc_plane);
 	return 0;
 }
 
@@ -1909,9 +1948,9 @@ bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct drm_crtc
 
 /*
  * The byte exact path was reviewed for the DCN 1.0 and 1.0.1 pipeline (DPP1, MPC1, OPP), for
- * DCN 2.0 and 2.1 (DPP2, MPC2, OPP) and for DCN 3.x (DPP3, MPC3, OPP). DCE has other blocks,
- * DCN 2.0.1 has DPP, MPC, OPP and sequencer variants of its own that were not reviewed, and
- * DCN 4 adds scaler sharpening (SPL, ISHARP).
+ * DCN 2.0 and 2.1 (DPP2, MPC2, OPP), for DCN 3.x (DPP3, MPC3, OPP) and for DCN 4.0.1 (DPP401,
+ * MPC401, OPP: amdgpu_dm_dvbridge_check_dcn4()). DCE has other blocks, DCN 2.0.1 has DPP, MPC,
+ * OPP and sequencer variants of its own that were not reviewed, and so has DCN 4.2 (dcn42).
  */
 static bool amdgpu_dm_dvbridge_dcn_reviewed(const struct amdgpu_device *adev)
 {
@@ -1922,6 +1961,7 @@ static bool amdgpu_dm_dvbridge_dcn_reviewed(const struct amdgpu_device *adev)
 	case DCN_VERSION_1_01:
 	case DCN_VERSION_2_0:
 	case DCN_VERSION_2_1:
+	case DCN_VERSION_4_01:
 		return true;
 	default:
 		return adev->dm.dc->ctx->dce_version >= DCN_VERSION_3_0 &&
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 373dce9..f2b733b 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -398,6 +398,32 @@ static u64 dvbridge_why_scanout(struct drm_atomic_commit *state, struct drm_crtc
 				 str_yes_no(stream->func_shaper &&
 					    stream->func_shaper->type != TF_TYPE_BYPASS));
 	}
+	/* Hades: DCN 4.0.1, scaling or sharpening forced, and MCM LUTs from video memory (linux-9974) */
+	if (plane_state && stream->ctx->dce_version == DCN_VERSION_4_01) {
+		const struct dm_plane_state *dm_plane_state = to_dm_plane_state(plane_state);
+		const struct dc_plane_state *dc_plane = dm_plane_state->dc_state;
+		const struct dc *dc = stream->ctx->dc;
+
+		if (dc->debug.force_sharpness != SHARPNESS_HW_OFF || dc->debug.always_scale ||
+		    (dc_plane && (dc_plane->adaptive_sharpness_en || dc_plane->sharpness_level))) {
+			bits |= REFUSED(SCANOUT);
+			len += scnprintf(buf + len, size - len,
+					 "%sDCN 4.0.1: sharpening %u, always scale %d, adaptive sharpness of the plane %d (level %u)",
+					 len ? "; " : "", dc->debug.force_sharpness, dc->debug.always_scale,
+					 dc_plane ? dc_plane->adaptive_sharpness_en : 0,
+					 dc_plane ? dc_plane->sharpness_level : 0);
+		}
+		if (dc_plane &&
+		    (dc_plane->mcm_luts.lut3d_data.lut3d_src != DC_CM2_TRANSFER_FUNC_SOURCE_SYSMEM ||
+		     dc_plane->mcm_shaper_3dlut_setting != DC_CM2_SHAPER_3DLUT_SETTING_BYPASS_ALL ||
+		     dc_plane->mcm_lut1d_enable)) {
+			bits |= REFUSED(SCANOUT);
+			len += scnprintf(buf + len, size - len,
+					 "%sDCN 4.0.1: MCM 3D LUT source %d, shaper and 3D LUT %d, 1D LUT %d",
+					 len ? "; " : "", dc_plane->mcm_luts.lut3d_data.lut3d_src,
+					 dc_plane->mcm_shaper_3dlut_setting, dc_plane->mcm_lut1d_enable);
+		}
+	}
 	/* (the colour pipeline of the plane, as user space and DC have it, is "scanout" too) */
 	return bits ? bits : REFUSED(SCANOUT);
 }
@@ -457,7 +483,7 @@ void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct d
 	int i;
 
 	scnprintf(detail, sizeof(detail),
-		  "at commit setup, the output transfer function of the stream is %s (curve %d), not bypass: before DCN 3 the regamma would change the bytes",
+		  "at commit setup, the output transfer function of the stream is %s (curve %d), not bypass: before DCN 3 and on DCN 4.0.1 the output gamma would change the bytes",
 		  dvbridge_tf_type_name(stream->out_transfer_func.type),
 		  stream->out_transfer_func.tf);
 	for_each_new_connector_in_state(state, connector, con_state, i) {
-- 
2.53.0

