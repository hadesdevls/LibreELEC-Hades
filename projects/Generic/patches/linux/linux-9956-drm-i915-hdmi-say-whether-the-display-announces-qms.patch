From 3340c2e5f4844444b6866a474f811955c5db7553 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:30:00 +0000
Subject: [PATCH] drm/i915/hdmi: say whether the display announces QMS

HDMI 2.1 QMS (Quick Media Switching) lets a source change the refresh
rate without a mode set: the frame is lengthened in its vertical front
porch over one base timing, and an EMP packet (the VTEM, with QMS_EN,
M_CONST and the next target frame rate) tells the display beforehand.
DRM does not read the QMS bits of the EDID and i915 does not do QMS.

This reads what the display announces, from the HDMI Forum block of its
EDID (the HF-VSDB, OUI C4-5D-D8, or the HF-SCDB, extended tag 0x79):
QMS (byte 8, bit 6), QMS_TFR_min and QMS_TFR_max (byte 11, bits 4 and
5) and the VRR range, in the layout of NVIDIA's
NVT_HDMI_FORUM_VSDB_PAYLOAD (HDMI 2.1a is not public), and says it once
for each EDID that says something new, at detect, where the EDID is
read. An LG C5 announces QMS or not by the settings of its input (one
EDID of it does, another does not), so a report has to say which.

Nothing else changes: a change of refresh rate is a mode set, as
before. Doing QMS right on this kernel is out of reach on the hardware
this was written for (display version 13, Alder Lake):
- there is no EMP engine for HDMI before display version 14.01 and 20
  (EMP_AS_SDP_TL, "VRR packets for HDMI2.1", intel_vrr.c); the VTEM
  would have to ride in the gamut metadata DIP, whose header software
  writes (LSPCON's HDR InfoFrame goes that way over DP), sent at the
  lines after vsync where the DIPs go out (intel_vrr.c), and a DIP is
  rewritten by turning it off and on;
- the legacy timing generator takes TRANS_VTOTAL at the undelayed
  vblank but TRANS_VSYNC at once, and the vblank evasion lets the
  writes of a fastset land inside the vertical blank: a lengthened front
  porch moves vsync, and a write there would give a frame without one.
  i915 uses the VRR timing generator for DP and eDP only;
- without CMRR (display version 20 and later, and off there) a rate
  goes over a base only where the vertical total comes out whole: at
  2160p 23.976 and 29.97 Hz over 59.94, 24, 25, 30 and 50 Hz over 60;
  at 1080p no film rate at all (29.97 over 59.94, 25, 30 and 50 over
  60);
- the 2160p60 base takes 594 MHz over TMDS, where 10 bit RGB does not
  fit: HDR10 at 24 Hz would leave RGB for 4:2:0.

With the line, a test on a given display says whether there is anything
to build for. Host test: the reader against the EDIDs of two LG C5 that
announce QMS and one that does not (the same bits as NVIDIA's EDID
parser), 584 more EDIDs against an independent reading (none announces
QMS), built blocks, and twelve mutations, all caught. W=1 on
intel_hdmi.c without a new warning; i915 and xe compiled. Not run on a
GPU.

Since the review of 1.0 RC6 the reader gets the EDID property that
detect has just made, all of it, and no longer the EDID cut at the
extension count of its base block (drm_edid_raw() and edid->extensions):
an HF-SCDB in a block that only an HDMI Forum EEODB counts is read, as
Kodi reads it and as linux-9999 reads HDR10+. Detect and force hold
mode_config.mutex, which protects the property, as for
intel_hdmi_dvbridge_sink_read() of linux-9985; nothing is read of an
EDID that detect may free. Host test: an EDID with the HF-SCDB in an
EEODB block is read with the whole EDID and not with the cut one; the
size passed before fails it (the mutation).
---
 .../drm/i915/display/intel_display_types.h    |   2 +
 drivers/gpu/drm/i915/display/intel_hdmi.c     |  46 ++++++++
 drivers/gpu/drm/i915/display/intel_qms.h      | 103 ++++++++++++++++++
 3 files changed, 151 insertions(+)
 create mode 100644 drivers/gpu/drm/i915/display/intel_qms.h

diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 174d3df..92d8280 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -1702,6 +1702,8 @@ struct intel_hdmi {
 	} dp_dual_mode;
 	struct intel_connector *attached_connector;
 	struct cec_notifier *cec_notifier;
+	/* Hades: what the kernel log said last of QMS (intel_qms.h); 0 when it said nothing */
+	u32 hades_qms_logged;
 };
 
 struct intel_dp_mst_encoder;
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index d4e29b0..fbcd23f 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -68,6 +68,7 @@
 #include "intel_lspcon.h"
 #include "intel_panel.h"
 #include "intel_pfit.h"
+#include "intel_qms.h"
 #include "intel_snps_phy.h"
 #include "intel_vrr.h"
 
@@ -2826,6 +2827,48 @@ intel_hdmi_dp_dual_mode_detect(struct drm_connector *_connector)
 	}
 }
 
+/*
+ * Hades: what the display announces of HDMI 2.1 QMS (Quick Media Switching), in the kernel log once
+ * for each EDID that says something new of it (intel_qms.h), from the whole EDID property that
+ * detect has just made (the blocks of an HDMI Forum EEODB too). i915 does not change the refresh
+ * rate by QMS: a change of rate is a mode set. An LG C5 announces QMS or not by its input settings.
+ */
+static void intel_hdmi_qms_log(struct intel_connector *connector,
+			       const struct drm_edid *drm_edid)
+{
+	struct intel_display *display = to_intel_display(connector);
+	struct intel_hdmi *intel_hdmi = intel_attached_hdmi(connector);
+	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
+	struct intel_qms q;
+	u32 key;
+
+	if (!drm_edid || !edid) {
+		intel_hdmi->hades_qms_logged = 0;
+		return;
+	}
+
+	q = intel_qms_read(edid->data, edid->length);
+	key = intel_qms_signature(&q) ?: 1;
+	if (key == intel_hdmi->hades_qms_logged)
+		return;
+	intel_hdmi->hades_qms_logged = key;
+
+	if (!q.block)
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] QMS: the display does not announce QMS (HDMI 2.1 Quick Media Switching): its EDID has no HF-VSDB or HF-SCDB\n",
+			 connector->base.base.id, connector->base.name);
+	else if (!q.qms)
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] QMS: the display does not announce QMS (HDMI 2.1 Quick Media Switching) in its HDMI Forum block (VRR %u-%u Hz)\n",
+			 connector->base.base.id, connector->base.name,
+			 q.vrr_min, q.vrr_max);
+	else
+		drm_info(display->drm,
+			 "[CONNECTOR:%d:%s] QMS: the display announces QMS (HDMI 2.1 Quick Media Switching), QMS_TFR_min %d, QMS_TFR_max %d, VRR %u-%u Hz; i915 does not change the refresh rate by QMS: a change of rate is a mode set\n",
+			 connector->base.base.id, connector->base.name,
+			 q.tfr_min, q.tfr_max, q.vrr_min, q.vrr_max);
+}
+
 static bool
 intel_hdmi_set_edid(struct drm_connector *_connector)
 {
@@ -2865,6 +2908,9 @@ intel_hdmi_set_edid(struct drm_connector *_connector)
 	cec_notifier_set_phys_addr(intel_hdmi->cec_notifier,
 				   connector->base.display_info.source_physical_address);
 
+	/* Hades: what the display announces of QMS, once per change */
+	intel_hdmi_qms_log(connector, drm_edid);
+
 	return connected;
 }
 
diff --git a/drivers/gpu/drm/i915/display/intel_qms.h b/drivers/gpu/drm/i915/display/intel_qms.h
new file mode 100644
index 0000000..5473dbe
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_qms.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: what an EDID says of HDMI 2.1 QMS (Quick Media Switching).
+ *
+ * The HDMI Forum vendor-specific data block (HF-VSDB, OUI C4-5D-D8) and the
+ * HDMI Forum sink capability data block (HF-SCDB, extended tag 0x79) of the
+ * CTA-861 extensions share one layout from their byte 4 on: byte 8 holds
+ * FAPA_start_location, ALLM, FVA, CNMVRR, CinemaVRR, M_delta, QMS (bit 6)
+ * and FAPA_End_Extended; bytes 9-10 VRRmin and VRRmax; byte 11 the DSC
+ * flags with QMS_TFR_min (bit 4) and QMS_TFR_max (bit 5). That is the layout
+ * of NVIDIA's NVT_HDMI_FORUM_VSDB_PAYLOAD (open-gpu-kernel-modules,
+ * src/common/modeset/timing/edid.h); HDMI 2.1a itself is not public.
+ *
+ * DRM does not read the QMS bits (drm_edid.h names bits 0-5 of byte 8 only)
+ * and i915 does not switch the refresh rate by QMS: the kernel log says what
+ * the display announces, so that a report tells whether that input of that
+ * display offers it. Pure functions on the bytes of the EDID, so that a host
+ * test runs them against real EDIDs.
+ */
+
+#ifndef __INTEL_QMS_H__
+#define __INTEL_QMS_H__
+
+#include <linux/types.h>
+
+struct intel_qms {
+	bool block;		/* an HF-VSDB or HF-SCDB with byte 8 was found */
+	bool qms;		/* byte 8 bit 6 */
+	bool tfr_min;		/* byte 11 bit 4 (absent byte 11: 0) */
+	bool tfr_max;		/* byte 11 bit 5 */
+	u8 vrr_min;		/* byte 9 bits 0-5 (absent: 0) */
+	u16 vrr_max;		/* byte 9 bits 6-7 and byte 10 (absent: 0) */
+};
+
+/*
+ * The first HF-VSDB or HF-SCDB that is long enough to hold byte 8, in the
+ * CTA-861 extensions of an EDID of size bytes (a multiple of 128 is not
+ * required: a partial block at the end is not read). An HF-VSDB is taken
+ * before an HF-SCDB of the same block, as the first one in a block's data
+ * block collection is taken.
+ */
+static inline struct intel_qms
+intel_qms_read(const u8 *edid, unsigned int size)
+{
+	struct intel_qms r = {};
+	unsigned int ext;
+
+	if (!edid)
+		return r;
+
+	for (ext = 128; ext + 128 <= size; ext += 128) {
+		const u8 *b = edid + ext;
+		unsigned int end = b[2];
+		unsigned int i = 4;
+
+		if (b[0] != 0x02 || end < 4 || end > 127)
+			continue;
+
+		while (i < end) {
+			unsigned int tag = b[i] >> 5;
+			unsigned int len = b[i] & 0x1f;
+			const u8 *d = b + i;
+			bool hf;
+
+			if (i + 1 + len > end)
+				break;	/* a block that runs past the collection */
+
+			hf = (tag == 3 && len >= 3 &&
+			      d[1] == 0xd8 && d[2] == 0x5d && d[3] == 0xc4) ||
+			     (tag == 7 && len >= 1 && d[1] == 0x79);
+
+			if (hf && len >= 8) {
+				r.block = true;
+				r.qms = d[8] & 0x40;
+				if (len >= 9)
+					r.vrr_min = d[9] & 0x3f;
+				if (len >= 10)
+					r.vrr_max = (u16)(d[9] >> 6) << 8 | d[10];
+				if (len >= 11) {
+					r.tfr_min = d[11] & 0x10;
+					r.tfr_max = d[11] & 0x20;
+				}
+				return r;
+			}
+			i += 1 + len;
+		}
+	}
+
+	return r;
+}
+
+/* One number for what is logged, so that a detect logs only a change; 0 when nothing was found */
+static inline u32 intel_qms_signature(const struct intel_qms *q)
+{
+	if (!q->block)
+		return 0;
+
+	return 1u << 31 | (u32)q->qms << 30 | (u32)q->tfr_min << 29 |
+		(u32)q->tfr_max << 28 | (u32)(q->vrr_min & 0x3f) << 10 |
+		(q->vrr_max & 0x3ff);
+}
+
+#endif /* __INTEL_QMS_H__ */
-- 
2.53.0

