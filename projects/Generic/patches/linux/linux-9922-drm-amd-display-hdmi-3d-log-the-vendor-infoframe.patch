From fe017bac60c9af5f8aee8579230fb0c3d339b853 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 18:10:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: log what the vendor InfoFrame says
 about 3D

Nothing in amdgpu shows the vendor InfoFrame that goes to an HDMI sink:
no debugfs file, no log line (i915 reads its InfoFrames back from the
hardware and prints them). Whether a sink was told to enter 3D, and to
leave it, could only be seen on the sink, or with an HDMI analyser.

Where the commit hands the vendor InfoFrame to the display core because
what it says about 3D changed, a KMS debug line (drm.debug bit 0x4) now
records it, with the payload of the frame. Each of these is one line in
the log, after "[CRTC:<id>:<name>] ":

  HDMI vendor InfoFrame, 3D: none -> frame packing
      (payload 03 0c 00 40 00)
  HDMI vendor InfoFrame, 3D: frame packing -> explicit 2D
      (payload 03 0c 00 00)
  HDMI vendor InfoFrame, 3D: explicit 2D -> none
      (no vendor InfoFrame any more)

The layouts are named "frame packing", "top-and-bottom" and
"side-by-side half". "explicit 2D" is the frame that the 2D mode after a
3D one carries. "none" is a stream with no vendor InfoFrame or with one
that is not about 3D (an HDMI VIC, Dolby Vision): the payload tells
which.

The line is written when the frame is handed over, not when the sink
has it: it says what the driver sent, not what the sink did with it. A
CRTC that is turned off while in 3D logs nothing, as nothing is sent. A
commit that does not change the 3D state logs nothing, so a system that
never uses a 3D mode never has the line.

Checked: compiled with the configuration and the compiler of the image;
the names, by running the function on the build host. Not run on
hardware: the line has not been seen in a kernel log.

Ported to Linux 7.3: 7.3 split amdgpu_dm.c. The name function goes to
amdgpu_dm_connector.c after amdgpu_dm_stereo_vsif_changed(), and the hunk of
amdgpu_dm_commit_planes() stays in amdgpu_dm.c; amdgpu_dm_stereo_vsif_name(),
which it calls, is no longer static and is declared in amdgpu_dm_dvbridge.h.
The code is the code of 7.2.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 19 ++++++++++++++-
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 24 +++++++++++++++++++
 .../display/amdgpu_dm/amdgpu_dm_dvbridge.h    |  3 +++
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index b84837c..ee5ee51 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4110,8 +4110,25 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 		 * the old stream programmed it, so the sink would not be told to show 3D, or
 		 * to stop showing it: send the vendor InfoFrame with the update.
 		 */
-		if (amdgpu_dm_stereo_vsif_changed(dm_old_crtc_state->stream, acrtc_state->stream))
+		if (amdgpu_dm_stereo_vsif_changed(dm_old_crtc_state->stream, acrtc_state->stream)) {
+			const struct dc_info_packet *vsp = &acrtc_state->stream->vsp_infopacket;
+
 			bundle->stream_update.vsp_infopacket = &acrtc_state->stream->vsp_infopacket;
+			/* the only record of what the sink is told: hb2 is the payload length */
+			if (vsp->valid)
+				drm_dbg_kms(dev,
+					    "[CRTC:%d:%s] HDMI vendor InfoFrame, 3D: %s -> %s (payload %*ph)\n",
+					    pcrtc->base.id, pcrtc->name,
+					    amdgpu_dm_stereo_vsif_name(dm_old_crtc_state->stream),
+					    amdgpu_dm_stereo_vsif_name(acrtc_state->stream),
+					    min_t(int, vsp->hb2, sizeof(vsp->sb) - 1), &vsp->sb[1]);
+			else
+				drm_dbg_kms(dev,
+					    "[CRTC:%d:%s] HDMI vendor InfoFrame, 3D: %s -> %s (no vendor InfoFrame any more)\n",
+					    pcrtc->base.id, pcrtc->name,
+					    amdgpu_dm_stereo_vsif_name(dm_old_crtc_state->stream),
+					    amdgpu_dm_stereo_vsif_name(acrtc_state->stream));
+		}
 
 		if (new_pcrtc_state->color_mgmt_changed) {
 			/*
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 90ec4fb..864f894 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1882,6 +1882,30 @@ bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
 		      sizeof(new_stream->vsp_infopacket));
 }
 
+/* For the log: what the vendor InfoFrame of a stream says about 3D. */
+const char *amdgpu_dm_stereo_vsif_name(const struct dc_stream_state *stream)
+{
+	switch (amdgpu_dm_hdmi_video_format(stream)) {
+	case AMDGPU_DM_HDMI_VIDEO_FORMAT_NONE:
+		return "explicit 2D";
+	case AMDGPU_DM_HDMI_VIDEO_FORMAT_3D:
+		break;
+	default:
+		return "none";
+	}
+
+	switch (stream->vsp_infopacket.sb[5] >> 4) {
+	case HDMI_3D_STRUCTURE_FRAME_PACKING:
+		return "frame packing";
+	case HDMI_3D_STRUCTURE_TOP_AND_BOTTOM:
+		return "top-and-bottom";
+	case HDMI_3D_STRUCTURE_SIDE_BY_SIDE_HALF:
+		return "side-by-side half";
+	default:
+		return "another layout";
+	}
+}
+
 STATIC_IFN_KUNIT struct dc_stream_state *
 create_stream_for_sink(struct drm_connector *connector,
 		       const struct drm_display_mode *drm_mode,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index 6aad0d9..228f777 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -129,4 +129,7 @@ bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
 u32 amdgpu_dm_stereo_layout(const struct drm_connector *connector,
 			    const struct drm_display_mode *mode);
 
+/* HDMI 3D, for the log: what the vendor InfoFrame of a stream says about 3D. */
+const char *amdgpu_dm_stereo_vsif_name(const struct dc_stream_state *stream);
+
 #endif
-- 
2.53.0

