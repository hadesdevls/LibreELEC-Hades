From 3bb1474746ddf3785186331b1392a61dc5dde12a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:17:06 +0000
Subject: [PATCH] drm/amd/display: the HDMI 1.4b signal of the Dolby Vision
 tunnel

DVBRIDGE_DV_HDMI14B_LAB, a connector property next to
DVBRIDGE_DV_LOW_LATENCY_LAB and with its rules (HDMI connectors where
the tunnel is offered, the dvbridge parameter, dropped with the CRTC and
for the console, a change with the tunnel on is a full modeset): with
DVBRIDGE_DV_STANDARD_LAB, amdgpu_dm_dvbridge_fill_stream() puts the HDMI
1.4b vendor InfoFrame of Dolby Vision in the vendor packet of the stream
(the HDMI one of 24 payload bytes, with the HDMI VIC of 2160p24, 25 and
30) and the tunnel's AVI InfoFrame with VIC 0 in those modes
(drm_dvbridge.h), for a sink whose EDID asks for that signal. Everything
else is the Standard tunnel's, with its checks:
amdgpu_dm_dvbridge_stream_active() takes this packet, of a length that
no HDMI vendor InfoFrame has. With Low-Latency it is refused, and a
refusal says why. The timing keeps the CTA VIC and no HDMI VIC, as for
the Standard tunnel: DC sends the packets given to it.

amdgpu_dm_hdmi_video_format(), which tells what the vendor InfoFrame of
a stream says of 3D for a commit and for its log, leaves this packet
out as it leaves out the Dolby one (amdgpu_dm_dvbridge_stream_active()):
with the OUI of HDMI and a PB4 of 0x20 or 0, it would be an HDMI VIC,
or "explicit 2D" in the log of the commit that starts or ends the
tunnel. The packets sent do not depend on it: the vendor packet goes
with the update of such a commit anyway.

Why: TVs of 2016 (the LG OLEDs among them) and some later ones have
Dolby Vision only with this signal. With the property 0 (its default)
nothing changes: every new line is behind it, and the packet that
amdgpu_dm_dvbridge_stream_active() now also takes is only made with it.
W=1, no warnings.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |  6 ++
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |  2 +
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  3 +-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  8 +-
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 85 +++++++++++++++----
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 25 +++++-
 6 files changed, 110 insertions(+), 19 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index 54b4ecb..03549a1 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -1634,6 +1634,12 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 					 "DVBRIDGE_DV_LOW_LATENCY_LAB");
 	if (!adev->mode_info.dvbridge_dv_low_latency_property)
 		return -ENOMEM;
+	/* Hades: the HDMI 1.4b signal of that tunnel (drm_dvbridge.h) */
+	adev->mode_info.dvbridge_dv_hdmi14b_property =
+		drm_property_create_bool(adev_to_drm(adev), DRM_MODE_PROP_ATOMIC,
+					 "DVBRIDGE_DV_HDMI14B_LAB");
+	if (!adev->mode_info.dvbridge_dv_hdmi14b_property)
+		return -ENOMEM;
 
 	/* Hades: the same names and meanings as the i915 ones (drm_dvbridge_refused.h) */
 	adev->mode_info.dvbridge_hdr10_property =
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index e88abc3..78ca7d2 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -332,6 +332,8 @@ struct amdgpu_mode_info {
 	struct drm_property *dvbridge_dv_standard_property;
 	/* Hades: Dolby Vision Low-Latency over that tunnel (drm_dvbridge_ll.h) */
 	struct drm_property *dvbridge_dv_low_latency_property;
+	/* Hades: the HDMI 1.4b signal of that tunnel (drm_dvbridge.h) */
+	struct drm_property *dvbridge_dv_hdmi14b_property;
 	/*
 	 * Hades: the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR), and why a request of the
 	 * tunnel or of the guard was refused (DVBRIDGE_REFUSED, read only)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 3996d52..2aa1fdf 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5557,7 +5557,8 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 				/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
 				amdgpu_dm_dvbridge_refused_stream(connector, &new_crtc_state->mode,
 								  new_stream,
-								  dm_new_conn_state->dvbridge_dv_low_latency);
+								  dm_new_conn_state->dvbridge_dv_low_latency,
+								  dm_new_conn_state->dvbridge_dv_hdmi14b);
 				goto fail;
 			}
 		}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index c6cf14f..2d63a72 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1095,6 +1095,11 @@ struct dm_connector_state {
 	 * Low-Latency (drm_dvbridge_ll.h); without it, nothing
 	 */
 	bool dvbridge_dv_low_latency;
+	/*
+	 * Hades: DVBRIDGE_DV_HDMI14B_LAB: with the tunnel requested, it is signalled with the HDMI
+	 * 1.4b vendor InfoFrame of Dolby Vision (drm_dvbridge.h); without it, nothing
+	 */
+	bool dvbridge_dv_hdmi14b;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 	bool dvbridge_hdr10_deep_color;
 	/*
@@ -1113,7 +1118,8 @@ void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 					  struct drm_atomic_commit *state);
 void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
-				       const struct dc_stream_state *stream, bool low_latency);
+				       const struct dc_stream_state *stream, bool low_latency,
+				       bool hdmi14b);
 void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 					const struct drm_crtc_state *crtc_state);
 void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 2e827f1..afecee8 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1621,6 +1621,11 @@ EXPORT_IF_KUNIT(amdgpu_dm_update_stream_scaling_settings);
  * metadata, next to the Low-Latency VSIF and an AVI InfoFrame that says YCbCr 4:2:2, limited
  * range, BT.2020, for a sink whose Dolby block advertises Low-Latency (drm_dvbridge_ll.h).
  * Everything else is as above.
+ *
+ * Hades: with DVBRIDGE_DV_HDMI14B_LAB set as well, the same Standard tunnel goes out next to the
+ * HDMI 1.4b vendor InfoFrame of Dolby Vision (the HDMI one, of 24 payload bytes, with the HDMI VIC
+ * of 2160p24, 25 and 30) and an AVI InfoFrame with VIC 0 in those modes, for a sink whose Dolby
+ * block asks for that signal (drm_dvbridge.h). Everything else is as above.
  */
 static bool amdgpu_dm_dvbridge = true;
 module_param_named(dvbridge, amdgpu_dm_dvbridge, bool, 0444);
@@ -1648,10 +1653,15 @@ bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream)
 {
 	return stream && stream->vsp_infopacket.valid &&
 	       stream->vsp_infopacket.hb0 == HDMI_INFOFRAME_TYPE_VENDOR &&
-	       stream->vsp_infopacket.hb2 == HDMI_DOLBY_VENDOR_INFOFRAME_SIZE &&
-	       stream->vsp_infopacket.sb[1] == 0x46 &&
-	       stream->vsp_infopacket.sb[2] == 0xd0 &&
-	       stream->vsp_infopacket.sb[3] == 0x00;
+	       ((stream->vsp_infopacket.hb2 == HDMI_DOLBY_VENDOR_INFOFRAME_SIZE &&
+		 stream->vsp_infopacket.sb[1] == 0x46 &&
+		 stream->vsp_infopacket.sb[2] == 0xd0 &&
+		 stream->vsp_infopacket.sb[3] == 0x00) ||
+		/* Hades: ... or its HDMI 1.4b one, of a length no HDMI vendor InfoFrame has */
+		(stream->vsp_infopacket.hb2 == HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE &&
+		 stream->vsp_infopacket.sb[1] == 0x03 &&
+		 stream->vsp_infopacket.sb[2] == 0x0c &&
+		 stream->vsp_infopacket.sb[3] == 0x00));
 }
 
 int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
@@ -1663,6 +1673,9 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	u8 vic = drm_dvbridge_avi_vic(drm_match_cea_mode(mode));
 	/* Hades: Dolby Vision Low-Latency over the tunnel (drm_dvbridge_ll.h) */
 	const bool low_latency = to_dm_connector_state(con_state)->dvbridge_dv_low_latency;
+	/* Hades: ... or the Standard tunnel with the HDMI 1.4b signal (drm_dvbridge.h) */
+	const bool hdmi14b = to_dm_connector_state(con_state)->dvbridge_dv_hdmi14b;
+	struct hdmi_dolby_hdmi14b_infoframe dv14;
 	struct hdmi_dolby_vendor_infoframe dv;
 	struct drm_dvbridge_sink sink;
 	struct hdmi_avi_infoframe avi;
@@ -1681,12 +1694,13 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 		return -EOPNOTSUPP;
 	/* (Hades: the rule of drm_dvbridge.h, read once) */
 	drm_dvbridge_edid_read(stream->sink->dc_edid.raw_edid, stream->sink->dc_edid.length, &sink);
-	if (!drm_dvbridge_sink_takes(&sink, low_latency))
+	if (hdmi14b ? low_latency || !drm_dvbridge_sink_takes_hdmi14b(&sink) :
+		      !drm_dvbridge_sink_takes(&sink, low_latency))
 		return -EOPNOTSUPP;
 	if (!vic || (mode->flags & DRM_MODE_FLAG_3D_MASK))
 		return -EINVAL;
 	/* 2160p50 and 2160p60 need a sink that advertises Dolby Vision at 2160p60. */
-	if (!sink.p60 && drm_dvbridge_vic_needs_p60(vic))
+	if (!(hdmi14b ? sink.hdmi14b_p60 : sink.p60) && drm_dvbridge_vic_needs_p60(vic))
 		return -EINVAL;
 
 	/* RGB is a byte tunnel here, not an RGB colour-managed picture (drm_dvbridge.h). */
@@ -1698,6 +1712,9 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	/* Hades: what the sink's Low-Latency input reads the same bytes as (drm_dvbridge_ll.h) */
 	if (low_latency)
 		drm_dvbridge_ll_avi(&avi);
+	/* Hades: with the HDMI 1.4b signal, VIC 0 where its vendor InfoFrame has the HDMI VIC */
+	if (hdmi14b)
+		drm_dvbridge_hdmi14b_avi(&avi, vic);
 	len = hdmi_avi_infoframe_pack(&avi, buf, sizeof(buf));
 	if (len < 0)
 		return len;
@@ -1709,11 +1726,17 @@ int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 	 * AVI carries the CTA timing, so the vendor slot holds the Dolby VSIF and no
 	 * HDMI 1.4 vendor packet competes with it.
 	 */
-	drm_dvbridge_tunnel_vsif(&dv);
-	/* Hades: ... with low latency (drm_dvbridge_ll.h) */
-	if (low_latency)
-		drm_dvbridge_ll_vsif(&dv);
-	len = hdmi_dolby_vendor_infoframe_pack(&dv, buf, sizeof(buf));
+	if (hdmi14b) {
+		/* Hades: the HDMI 1.4b signal, with the HDMI VIC of the mode (drm_dvbridge.h) */
+		drm_dvbridge_tunnel_hdmi14b_vsif(&dv14, vic);
+		len = hdmi_dolby_hdmi14b_infoframe_pack(&dv14, buf, sizeof(buf));
+	} else {
+		drm_dvbridge_tunnel_vsif(&dv);
+		/* Hades: ... with low latency (drm_dvbridge_ll.h) */
+		if (low_latency)
+			drm_dvbridge_ll_vsif(&dv);
+		len = hdmi_dolby_vendor_infoframe_pack(&dv, buf, sizeof(buf));
+	}
 	if (len < 0)
 		return len;
 	ret = amdgpu_dm_dvbridge_infopacket(buf, len, &stream->vsp_infopacket);
@@ -1973,6 +1996,11 @@ bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct drm_crtc
 		    to_dm_connector_state(old_con_state)->dvbridge_dv_low_latency !=
 		    to_dm_connector_state(new_con_state)->dvbridge_dv_low_latency)
 			return true;
+		/* Hades: ... and so do the Dolby and the HDMI 1.4b signals (drm_dvbridge.h) */
+		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
+		    to_dm_connector_state(old_con_state)->dvbridge_dv_hdmi14b !=
+		    to_dm_connector_state(new_con_state)->dvbridge_dv_hdmi14b)
+			return true;
 		if (to_dm_connector_state(new_con_state)->dvbridge_dv_standard &&
 		    old_con_state->content_type != new_con_state->content_type)
 			return true;
@@ -2054,13 +2082,15 @@ static int amdgpu_dm_stereo_vsif(u32 layout, struct dc_info_packet *out)
 
 /*
  * HDMI_Video_Format of the vendor InfoFrame of a stream, or -1 when the stream has no vendor
- * InfoFrame or one of another kind (the Dolby Vision one).
+ * InfoFrame or one of another kind: the Dolby Vision tunnel's, as amdgpu_dm_dvbridge_stream_active()
+ * tells it. Hades: its HDMI 1.4b form has the OUI of HDMI and a PB4 (0x20 or 0) that says nothing
+ * of 3D; taken for an HDMI one, it would be "explicit 2D" or an HDMI VIC in the log of a commit.
  */
 static int amdgpu_dm_hdmi_video_format(const struct dc_stream_state *stream)
 {
 	const struct dc_info_packet *p;
 
-	if (!stream)
+	if (!stream || amdgpu_dm_dvbridge_stream_active(stream))
 		return -1;
 	p = &stream->vsp_infopacket;
 	if (!p->valid || p->hb0 != HDMI_INFOFRAME_TYPE_VENDOR ||
@@ -2552,6 +2582,14 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EOPNOTSUPP;
 		dm_new_state->dvbridge_dv_low_latency = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_hdmi14b_property) {
+		/* Hades: the HDMI 1.4b signal of the tunnel (drm_dvbridge.h) */
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !amdgpu_dm_dvbridge)
+			return -EOPNOTSUPP;
+		dm_new_state->dvbridge_dv_hdmi14b = val;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
 		/* Hades: the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
 		if (val > 1)
@@ -2625,6 +2663,9 @@ int amdgpu_dm_connector_atomic_get_property(struct drm_connector *connector,
 	} else if (property == adev->mode_info.dvbridge_dv_low_latency_property) {
 		*val = dm_state->dvbridge_dv_low_latency;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_dv_hdmi14b_property) {
+		*val = dm_state->dvbridge_dv_hdmi14b;
+		ret = 0;
 	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
 		*val = dm_state->dvbridge_hdr10_deep_color;
 		ret = 0;
@@ -2850,6 +2891,8 @@ static void amdgpu_dm_connector_client_restore(struct drm_connector *connector,
 			 s->dvbridge_dv_low_latency, s->dvbridge_hdr10_deep_color);
 	s->dvbridge_dv_standard = false;
 	s->dvbridge_dv_low_latency = false;
+	/* (Hades: the HDMI 1.4b signal goes with the tunnel, which the line above names) */
+	s->dvbridge_dv_hdmi14b = false;
 	s->dvbridge_hdr10_deep_color = false;
 }
 
@@ -3569,15 +3612,22 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 		dm_new_con_state->dvbridge_dv_standard = false;
 		/* Hades: ... and that of Low-Latency over it */
 		dm_new_con_state->dvbridge_dv_low_latency = false;
+		/* Hades: ... and its HDMI 1.4b signal */
+		dm_new_con_state->dvbridge_dv_hdmi14b = false;
 		/* Hades: ... and the HDR10 depth guard */
 		dm_new_con_state->dvbridge_hdr10_deep_color = false;
 		return 0;
 	}
 
-	/* (Hades: so does going from Standard to Low-Latency, or back, with the tunnel on) */
+	/*
+	 * (Hades: so does going from Standard to Low-Latency, or back, with the tunnel on, and to the
+	 * HDMI 1.4b signal or back)
+	 */
 	if (dm_new_con_state->dvbridge_dv_standard != dm_old_con_state->dvbridge_dv_standard ||
 	    (dm_new_con_state->dvbridge_dv_standard &&
-	     dm_new_con_state->dvbridge_dv_low_latency != dm_old_con_state->dvbridge_dv_low_latency)) {
+	     dm_new_con_state->dvbridge_dv_low_latency != dm_old_con_state->dvbridge_dv_low_latency) ||
+	    (dm_new_con_state->dvbridge_dv_standard &&
+	     dm_new_con_state->dvbridge_dv_hdmi14b != dm_old_con_state->dvbridge_dv_hdmi14b)) {
 		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
 		if (IS_ERR(new_crtc_state))
 			return PTR_ERR(new_crtc_state);
@@ -4341,6 +4391,11 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 			drm_object_attach_property(&aconnector->base.base,
 						   adev->mode_info.dvbridge_dv_low_latency_property,
 						   0);
+		/* Hades: the HDMI 1.4b signal of the same tunnel (drm_dvbridge.h) */
+		if (adev->mode_info.dvbridge_dv_hdmi14b_property)
+			drm_object_attach_property(&aconnector->base.base,
+						   adev->mode_info.dvbridge_dv_hdmi14b_property,
+						   0);
 	}
 
 	/* Hades: the HDR10 depth guard and DVBRIDGE_REFUSED, on every HDMI connector */
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 58f0bef..cd242a5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -250,7 +250,8 @@ void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 /* The tests of amdgpu_dm_dvbridge_fill_stream(), named. */
 void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
-				       const struct dc_stream_state *stream, bool low_latency)
+				       const struct dc_stream_state *stream, bool low_latency,
+				       bool hdmi14b)
 {
 	struct amdgpu_dm_connector *aconn = to_amdgpu_dm_connector(connector);
 	u8 vic = drm_dvbridge_avi_vic(drm_match_cea_mode(mode));
@@ -263,7 +264,27 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 	/* (Hades: the rule of drm_dvbridge.h, as amdgpu_dm_dvbridge_fill_stream() read it) */
 	drm_dvbridge_edid_read(stream->sink ? stream->sink->dc_edid.raw_edid : NULL,
 			       stream->sink ? stream->sink->dc_edid.length : 0, &sink);
-	if (!stream->sink || !drm_dvbridge_sink_takes(&sink, low_latency)) {
+	if (low_latency && hdmi14b) {
+		/* Hades: no display asks for Low-Latency with the HDMI 1.4b signal */
+		bits |= REFUSED(FORMAT);
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "%sLow-Latency and the HDMI 1.4b signal together", len ? "; " : "");
+	} else if (hdmi14b && (!stream->sink || !drm_dvbridge_sink_takes_hdmi14b(&sink))) {
+		/* Hades: what the EDID lacks for the HDMI 1.4b signal (drm_dvbridge.h) */
+		const char *why = stream->sink ? drm_dvbridge_sink_takes_hdmi14b_why(&sink) :
+						 "no sink";
+
+		bits |= REFUSED(EDID);
+		len += scnprintf(detail + len, sizeof(detail) - len, "%sHDMI 1.4b: %s",
+				 len ? "; " : "", why ? why : "the EDID changed while it was read");
+	} else if (hdmi14b) {
+		if (!sink.hdmi14b_p60 && drm_dvbridge_vic_needs_p60(vic)) {
+			bits |= REFUSED(EDID_2160P30);
+			len += scnprintf(detail + len, sizeof(detail) - len,
+					 "%sthe Dolby Vision block does not advertise 2160p60",
+					 len ? "; " : "");
+		}
+	} else if (!stream->sink || !drm_dvbridge_sink_takes(&sink, low_latency)) {
 		/* Hades: what the EDID lacks (drm_dvbridge.h), Low-Latency over the tunnel too */
 		const char *why = stream->sink ? drm_dvbridge_sink_takes_why(&sink, low_latency) :
 						 "no sink";
-- 
2.53.0

