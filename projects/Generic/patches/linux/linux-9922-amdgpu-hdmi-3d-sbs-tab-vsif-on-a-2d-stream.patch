From b76696511537a7fca5a2bc97d6a558013ec56abe Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:29:35 +0200
Subject: [PATCH] amdgpu: hdmi 3d sbs tab vsif on a 2d stream

0103-amdgpu-hdmi-3d-sbs-tab-vsif-on-a-2d-stream.patch of cinema-ONE's
LibreELEC tree (https://github.com/cinema-ONE/LibreELEC.tv,
packages/linux/patches/default, as of 8f7810a9d203). The file there is a
plain diff without a description of its own: the subject above is its
file name, and the author and the date are those of the commit that
carries it, 4e703345b57a ("linux: carry the amdgpu HDMI 3D and 8K
patches (0100-0108)").

[Hades: no line of code differs from the original; the diff is
regenerated against Linux 7.2.10 with Hades' patches, whose Dolby Vision
tunnel moves the hunk]
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 28 ++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index fa5fbc3..4dc6880 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -8147,8 +8147,34 @@ create_stream_for_sink(struct drm_connector *connector,
 	update_stream_signal(stream, sink);
 
 	if (stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
-	    stream->signal == SIGNAL_TYPE_HDMI_FRL)
+	    stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+		/* Side-by-side and top-and-bottom are packed by the application
+		 * into an ordinary 2D frame: the display core scans it out as 2D
+		 * and only the vendor infoframe tells the sink about the layout. */
+		enum dc_timing_3d_format saved_3d = stream->timing.timing_3d_format;
+		enum view_3d_format saved_view = stream->view_format;
+
+		switch (mode.flags & DRM_MODE_FLAG_3D_MASK) {
+		case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
+			stream->timing.timing_3d_format = TIMING_3D_FORMAT_TB_SW_PACKED;
+			stream->view_format = VIEW_3D_FORMAT_TOP_AND_BOTTOM;
+			break;
+		case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
+		case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL:
+			stream->timing.timing_3d_format = TIMING_3D_FORMAT_SBS_SW_PACKED;
+			stream->view_format = VIEW_3D_FORMAT_SIDE_BY_SIDE;
+			break;
+		case DRM_MODE_FLAG_3D_FRAME_PACKING:
+			stream->timing.timing_3d_format = TIMING_3D_FORMAT_SW_FRAME_PACKING;
+			stream->view_format = VIEW_3D_FORMAT_FRAME_SEQUENTIAL;
+			break;
+		default:
+			break;
+		}
 		mod_build_hf_vsif_infopacket(stream, &stream->vsp_infopacket, false, false);
+		stream->timing.timing_3d_format = saved_3d;
+		stream->view_format = saved_view;
+	}
 
 	if (stream->signal == SIGNAL_TYPE_DISPLAY_PORT ||
 	    stream->signal == SIGNAL_TYPE_DISPLAY_PORT_MST ||
