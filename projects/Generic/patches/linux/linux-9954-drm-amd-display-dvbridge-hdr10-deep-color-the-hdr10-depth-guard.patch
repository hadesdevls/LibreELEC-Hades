From cedbb041f5455477f76e788ed4a49a443cc7f387 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:43:15 +0000
Subject: [PATCH] drm/amd/display: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth
 guard

As on i915: HDR10 needs 10 bits per component, and the depth of the
link is DC's choice (create_validate_stream_for_sink() lowers it until
the stream fits, then tries YCbCr 4:2:2 and 4:2:0). At 3840x2160 above
30 Hz over TMDS, or on an HDMI 1.4 TV input, HDR10 goes out at 8 bits
and user space cannot know.

DVBRIDGE_HDR10_DEEP_COLOR is a boolean on every HDMI connector, where
amdgpu.dvbridge is on. While it is set and the connector state carries
HDR10 static metadata, an active stream with fewer than 10 bits per
component is refused once the streams of the commit are made, with
hdr10-depth in DVBRIDGE_REFUSED and the mode, the TMDS clocks and the
deep colour of the sink in the kernel log. The connector check puts the
CRTC in the commit for it, without a modeset: on an unchanged timing
the stream in use is the one that is looked at. DC chooses the depth as
without the guard; the guard only refuses. Without HDR10 metadata it
does nothing, and a disabled connector drops it.

Kodi uses it as a question, in a TEST_ONLY commit, to say in its player
information whether Dolby Vision reconstructed as HDR10 leaves at 10
bits in the mode in use. It does not commit it.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |  7 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |  6 +-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 32 +++++++--
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  8 ++-
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 70 ++++++++++++++++++-
 5 files changed, 112 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index 4d10d0a..13c1b97 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -1475,7 +1475,12 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 	if (!adev->mode_info.dvbridge_dv_standard_property)
 		return -ENOMEM;
 
-	/* Hades: the same name and meaning as the i915 one (drm_dvbridge_refused.h) */
+	/* Hades: the same names and meanings as the i915 ones (drm_dvbridge_refused.h) */
+	adev->mode_info.dvbridge_hdr10_property =
+		drm_property_create_bool(adev_to_drm(adev), DRM_MODE_PROP_ATOMIC,
+					 "DVBRIDGE_HDR10_DEEP_COLOR");
+	if (!adev->mode_info.dvbridge_hdr10_property)
+		return -ENOMEM;
 	adev->mode_info.dvbridge_refused_property =
 		drm_dvbridge_refused_property_create(adev_to_drm(adev));
 	if (!adev->mode_info.dvbridge_refused_property)
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index bc7423a..a45ab00 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -330,7 +330,11 @@ struct amdgpu_mode_info {
 	struct drm_property *abm_level_property;
 	/* Dolby Vision Standard tunnel over HDMI, requested by user space */
 	struct drm_property *dvbridge_dv_standard_property;
-	/* Hades: why a request of the tunnel was refused (DVBRIDGE_REFUSED, read only) */
+	/*
+	 * Hades: the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR), and why a request of the
+	 * tunnel or of the guard was refused (DVBRIDGE_REFUSED, read only)
+	 */
+	struct drm_property *dvbridge_hdr10_property;
 	struct drm_property *dvbridge_refused_property;
 	/* hardcoded DFP edid from BIOS */
 	const struct drm_edid *bios_hardcoded_edid;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 26b1089..9224a55 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -8572,6 +8572,12 @@ int amdgpu_dm_connector_atomic_set_property(struct drm_connector *connector,
 			return -EOPNOTSUPP;
 		dm_new_state->dvbridge_dv_standard = val;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
+		/* Hades: the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
+		if (val > 1)
+			return -EINVAL;
+		dm_new_state->dvbridge_hdr10_deep_color = val;
+		ret = 0;
 	} else if (property == adev->mode_info.abm_level_property) {
 		switch (val) {
 		case ABM_SYSFS_CONTROL:
@@ -8631,6 +8637,9 @@ int amdgpu_dm_connector_atomic_get_property(struct drm_connector *connector,
 	} else if (property == adev->mode_info.dvbridge_dv_standard_property) {
 		*val = dm_state->dvbridge_dv_standard;
 		ret = 0;
+	} else if (property == adev->mode_info.dvbridge_hdr10_property) {
+		*val = dm_state->dvbridge_hdr10_deep_color;
+		ret = 0;
 	} else if (property == adev->mode_info.abm_level_property) {
 		if (!dm_state->abm_sysfs_forbidden)
 			*val = ABM_SYSFS_CONTROL;
@@ -9306,6 +9315,8 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	if (!crtc) {
 		/* A disabled connector drops the Dolby Vision tunnel request. */
 		dm_new_con_state->dvbridge_dv_standard = false;
+		/* Hades: ... and the HDR10 depth guard */
+		dm_new_con_state->dvbridge_hdr10_deep_color = false;
 		return 0;
 	}
 
@@ -9319,11 +9330,19 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	}
 
 	/*
-	 * Hades: a request of the tunnel is checked again: what was found of the last one is
-	 * cleared (DVBRIDGE_REFUSED), and each check that refuses says why.
+	 * Hades: a request of the tunnel or of the HDR10 depth guard is checked again: what
+	 * was found of the last one is cleared (DVBRIDGE_REFUSED), and each check that
+	 * refuses says why. The guard needs the CRTC in the commit, to see the depth of its
+	 * stream; that is no modeset.
 	 */
-	if (dm_new_con_state->dvbridge_dv_standard)
+	if (dm_new_con_state->dvbridge_dv_standard || amdgpu_dm_hdr10_guarded(new_con_state))
 		amdgpu_dm_dvbridge_refused(aconn, 0, NULL);
+	if (dm_new_con_state->dvbridge_hdr10_deep_color !=
+	    dm_old_con_state->dvbridge_hdr10_deep_color || amdgpu_dm_hdr10_guarded(new_con_state)) {
+		new_crtc_state = drm_atomic_get_crtc_state(state, crtc);
+		if (IS_ERR(new_crtc_state))
+			return PTR_ERR(new_crtc_state);
+	}
 
 	if (dm_new_con_state->dvbridge_dv_standard) {
 		ret = amdgpu_dm_dvbridge_check_connector(aconn, new_con_state, state);
@@ -10121,7 +10140,7 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 		drm_object_attach_property(&aconnector->base.base,
 					   adev->mode_info.dvbridge_dv_standard_property, 0);
 
-	/* Hades: DVBRIDGE_REFUSED, on every HDMI connector */
+	/* Hades: the HDR10 depth guard and DVBRIDGE_REFUSED, on every HDMI connector */
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge)
 		amdgpu_dm_dvbridge_attach_refused(aconnector);
 
@@ -14182,6 +14201,11 @@ static int amdgpu_dm_atomic_check(struct drm_device *dev,
 		}
 	}
 
+	/* Hades: the HDR10 depth guard, on the streams of the commit */
+	ret = amdgpu_dm_hdr10_guard_check(state);
+	if (ret)
+		goto fail;
+
 	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
 		dm_new_crtc_state = to_dm_crtc_state(new_crtc_state);
 		if (dm_new_crtc_state->mpo_requested)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index fa08426..9956a38 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -899,8 +899,8 @@ struct amdgpu_dm_connector {
 	struct dc_sink *hdmi_prev_sink;
 
 	/*
-	 * Hades: what the kernel log has said of refused requests of the Dolby Vision tunnel, once
-	 * the connector has DVBRIDGE_REFUSED (ready)
+	 * Hades: what the kernel log has said of refused requests of the Dolby Vision tunnel or of
+	 * the HDR10 depth guard, once the connector has DVBRIDGE_REFUSED (ready)
 	 */
 	struct drm_dvbridge_refused_log dvbridge_refused_log;
 	bool dvbridge_refused_ready;
@@ -1085,11 +1085,14 @@ struct dm_connector_state {
 	uint64_t pbn;
 	/* DVBRIDGE_DV_STANDARD_LAB: Dolby Vision Standard tunnel requested */
 	bool dvbridge_dv_standard;
+	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth guard (amdgpu_dm_dvbridge_refused.c) */
+	bool dvbridge_hdr10_deep_color;
 };
 
 /* Hades: amdgpu_dm_dvbridge_refused.c */
 void amdgpu_dm_dvbridge_attach_refused(struct amdgpu_dm_connector *aconn);
 void amdgpu_dm_dvbridge_refused(struct amdgpu_dm_connector *aconn, u64 bits, const char *detail);
+bool amdgpu_dm_hdr10_guarded(const struct drm_connector_state *con_state);
 void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
 					  const struct drm_connector_state *con_state,
 					  struct drm_atomic_commit *state);
@@ -1098,6 +1101,7 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct dc_stream_state *stream);
 void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 					const struct drm_crtc_state *crtc_state);
+int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state);
 
 #define to_dm_connector_state(x)\
 	container_of((x), struct dm_connector_state, base)
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 0eea695..71b77ae 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -1,8 +1,8 @@
 // SPDX-License-Identifier: MIT
 /*
- * Hades: why a request of the Dolby Vision Standard tunnel (DVBRIDGE_DV_STANDARD_LAB) is refused on
- * an HDMI connector, for user space (the read-only property DVBRIDGE_REFUSED) and for the kernel
- * log.
+ * Hades: why a request of the Dolby Vision Standard tunnel (DVBRIDGE_DV_STANDARD_LAB) or of the
+ * HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR) is refused on an HDMI connector, for user space
+ * (the read-only property DVBRIDGE_REFUSED) and for the kernel log; and the guard itself.
  *
  * The tunnel is admitted by amdgpu_dm_dvbridge_check_connector(),
  * amdgpu_dm_dvbridge_fill_stream() and amdgpu_dm_dvbridge_check_scanout() in amdgpu_dm.c. The
@@ -42,6 +42,9 @@ void amdgpu_dm_dvbridge_attach_refused(struct amdgpu_dm_connector *aconn)
 
 	if (aconn->base.connector_type != DRM_MODE_CONNECTOR_HDMIA)
 		return;
+	if (adev->mode_info.dvbridge_hdr10_property)
+		drm_object_attach_property(&aconn->base.base,
+					   adev->mode_info.dvbridge_hdr10_property, 0);
 	if (adev->mode_info.dvbridge_refused_property) {
 		drm_dvbridge_refused_log_init(&aconn->dvbridge_refused_log);
 		drm_object_attach_property(&aconn->base.base,
@@ -60,6 +63,19 @@ void amdgpu_dm_dvbridge_refused(struct amdgpu_dm_connector *aconn, u64 bits, con
 				    &aconn->dvbridge_refused_log, bits, detail);
 }
 
+bool amdgpu_dm_hdr10_guarded(const struct drm_connector_state *con_state)
+{
+	const struct hdr_output_metadata *hdr;
+
+	if (!to_dm_connector_state(con_state)->dvbridge_hdr10_deep_color ||
+	    !con_state->hdr_output_metadata ||
+	    con_state->hdr_output_metadata->length < sizeof(*hdr))
+		return false;
+	hdr = con_state->hdr_output_metadata->data;
+	return hdr->metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+	       hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
+}
+
 /* Bits per component of a DC colour depth; 0 when unknown (the enum is not in order). */
 static unsigned int dvbridge_depth_bpc(enum dc_color_depth depth)
 {
@@ -372,3 +388,51 @@ void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct
 					   detail);
 	}
 }
+
+/*
+ * The HDR10 depth guard: an active stream whose connector is under the guard with HDR10 metadata
+ * carries 10 bits per component or more, or the commit is refused. Run once the streams of the
+ * commit are made. It changes nothing: DC chooses the depth as without it.
+ */
+int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *con_state;
+	struct drm_connector *connector;
+	int i;
+
+	for_each_new_connector_in_state(state, connector, con_state, i) {
+		struct amdgpu_dm_connector *aconn;
+		const struct drm_crtc_state *crtc_state;
+		const struct dc_stream_state *stream;
+		unsigned int bpc;
+		char detail[320];
+		size_t len;
+
+		if (connector->connector_type != DRM_MODE_CONNECTOR_HDMIA || !con_state->crtc ||
+		    !amdgpu_dm_hdr10_guarded(con_state))
+			continue;
+		crtc_state = drm_atomic_get_new_crtc_state(state, con_state->crtc);
+		if (!crtc_state || !crtc_state->active)
+			continue;
+		stream = to_dm_crtc_state(crtc_state)->stream;
+		if (!stream)
+			continue;
+		bpc = dvbridge_depth_bpc(stream->timing.display_color_depth);
+		if (bpc >= 10)
+			continue;
+		aconn = to_amdgpu_dm_connector(connector);
+		len = scnprintf(detail, sizeof(detail), "HDR10 would go out as %s at %u bpc in ",
+				dvbridge_encoding_name(stream->timing.pixel_encoding), bpc);
+		len = dvbridge_link_detail(aconn, &crtc_state->mode, detail, len, sizeof(detail));
+		scnprintf(detail + len, sizeof(detail) - len,
+			  "; max bpc %u, the sink takes RGB at 10 bpc: %s, at 12 bpc: %s",
+			  con_state->max_requested_bpc,
+			  str_yes_no(connector->display_info.edid_hdmi_rgb444_dc_modes &
+				     DRM_EDID_HDMI_DC_30),
+			  str_yes_no(connector->display_info.edid_hdmi_rgb444_dc_modes &
+				     DRM_EDID_HDMI_DC_36));
+		amdgpu_dm_dvbridge_refused(aconn, REFUSED(HDR10_DEPTH), detail);
+		return -EINVAL;
+	}
+	return 0;
+}
