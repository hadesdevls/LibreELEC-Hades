From 6c4803516bd9ad8e88bdc85a8f0d859ab623e87a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:20:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: the vendor InfoFrame of the HDMI
 packer

The vendor InfoFrame of a 3D mode came from the builder of the display
core, mod_build_hf_vsif_infopacket(), which reads the 3D layout from the
stream: create_stream_for_sink() stored a DC stereo format and a view
format in the stream, called the builder and put the old values back.
And the builder was changed to give top-and-bottom a length of 6, with a
3D_Ext_Data byte, for every sink.

The HDMI code of the kernel (drivers/video/hdmi.c) has 3D_Ext_Data from
3D_Structure 8, side-by-side half, upwards; top-and-bottom is 6 and its
frame has 5 bytes. That is what hdmi_vendor_infoframe_pack() writes, and
so what i915 and every driver on the DRM HDMI helpers send. The comment
of the change names the sinks it was made for (JVC D-ILA projectors,
said to engage top-and-bottom only with the byte, as Amlogic sources
send it). A frame that is not the standard one is not sent to every sink
for the sake of one family of them.

The frame now comes from hdmi_vendor_infoframe_pack(), with the layout
that amdgpu_dm_stereo_layout() gave:

  frame packing        81 01 05 2a 03 0c 00 40 00
  top-and-bottom       81 01 05 ca 03 0c 00 40 60
  side-by-side half    81 01 06 a9 03 0c 00 40 80 00

For frame packing and side-by-side half those are the bytes the builder
of the display core gave. The stream is not touched while the frame is
built, and the builder of the display core is as upstream has it again.

The longer top-and-bottom frame stays available, off by default:
amdgpu.hdmi_3d_tab_ext_data=1 appends the byte, as zero
(81 01 06 c9 03 0c 00 40 60 00, the frame the patches sent).

The frame depends on the layout alone, not on what the EDID says about
HDMI InfoFrames: a 3D mode never goes out with its timing and without
its frame.

Checked: compiled with the configuration and the compiler of the image;
the bytes, by running the packer, the builder of the display core and
the function of this patch on the build host. Not run on hardware: no
sink has received these frames from this code. That a JVC projector
needs the byte is the report of the author of the patches, not something
verified here; the HDMI specification was not read for this patch.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 78 +++++++++++++------
 .../display/modules/info_packet/info_packet.c |  4 -
 2 files changed, 54 insertions(+), 28 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 7619199..00268e7 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -6832,6 +6832,11 @@ module_param_named(hdmi_3d, amdgpu_dm_hdmi_3d, bool, 0444);
 MODULE_PARM_DESC(hdmi_3d,
 		 "Offer the 3D modes of an HDMI sink: frame packing, top-and-bottom and side-by-side half (default: true)");
 
+static bool amdgpu_dm_hdmi_3d_tab_ext_data;
+module_param_named(hdmi_3d_tab_ext_data, amdgpu_dm_hdmi_3d_tab_ext_data, bool, 0444);
+MODULE_PARM_DESC(hdmi_3d_tab_ext_data,
+		 "Send the 3D_Ext_Data byte also with top-and-bottom 3D, against HDMI; reported as needed by JVC D-ILA projectors (default: false)");
+
 /*
  * The 3D layout of a mode, where this driver puts 3D on the wire: a connector that allows 3D
  * (HDMI) and a progressive mode with one of the three layouts that the EDID parser of DRM
@@ -8026,6 +8031,47 @@ static bool amdgpu_dm_dvbridge_dcn_reviewed(const struct amdgpu_device *adev)
 	       adev->dm.dc->ctx->dce_version < DCN_VERSION_4_01;
 }
 
+/*
+ * The HDMI vendor InfoFrame of a 3D layout, from the packer of the kernel: the bytes that
+ * every driver on the DRM helpers sends. HDMI defines 3D_Ext_Data for side-by-side half and
+ * the layouts after it, and the packer adds it there. Some sinks (JVC D-ILA) are reported
+ * to engage top-and-bottom only when that byte is present, as Amlogic sources send it:
+ * hdmi_3d_tab_ext_data adds it, as zero, to top-and-bottom as well.
+ */
+static int amdgpu_dm_stereo_vsif(u32 layout, struct dc_info_packet *out)
+{
+	u8 buf[HDMI_INFOFRAME_HEADER_SIZE + 6];
+	struct hdmi_vendor_infoframe frame;
+	ssize_t len;
+
+	hdmi_vendor_infoframe_init(&frame);
+	switch (layout) {
+	case DRM_MODE_FLAG_3D_FRAME_PACKING:
+		frame.s3d_struct = HDMI_3D_STRUCTURE_FRAME_PACKING;
+		break;
+	case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
+		frame.s3d_struct = HDMI_3D_STRUCTURE_TOP_AND_BOTTOM;
+		break;
+	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
+		frame.s3d_struct = HDMI_3D_STRUCTURE_SIDE_BY_SIDE_HALF;
+		break;
+	default:
+		return -EINVAL;
+	}
+	len = hdmi_vendor_infoframe_pack(&frame, buf, sizeof(buf));
+	if (len < 0)
+		return len;
+	if (amdgpu_dm_hdmi_3d_tab_ext_data &&
+	    layout == DRM_MODE_FLAG_3D_TOP_AND_BOTTOM &&
+	    len == HDMI_INFOFRAME_HEADER_SIZE + 5) {
+		/* one more byte, zero: the length grows by one, the checksum makes up for it */
+		buf[len++] = 0;
+		buf[2] += 1;
+		buf[3] -= 1;
+	}
+	return amdgpu_dm_dvbridge_infopacket(buf, len, out);
+}
+
 static struct dc_stream_state *
 create_stream_for_sink(struct drm_connector *connector,
 		       const struct drm_display_mode *drm_mode,
@@ -8182,31 +8228,15 @@ create_stream_for_sink(struct drm_connector *connector,
 
 	if (stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
 	    stream->signal == SIGNAL_TYPE_HDMI_FRL) {
-		/* Side-by-side and top-and-bottom are packed by the application
-		 * into an ordinary 2D frame: the display core scans it out as 2D
-		 * and only the vendor infoframe tells the sink about the layout. */
-		enum dc_timing_3d_format saved_3d = stream->timing.timing_3d_format;
-		enum view_3d_format saved_view = stream->view_format;
-
-		switch (stereo) {
-		case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
-			stream->timing.timing_3d_format = TIMING_3D_FORMAT_TB_SW_PACKED;
-			stream->view_format = VIEW_3D_FORMAT_TOP_AND_BOTTOM;
-			break;
-		case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
-			stream->timing.timing_3d_format = TIMING_3D_FORMAT_SBS_SW_PACKED;
-			stream->view_format = VIEW_3D_FORMAT_SIDE_BY_SIDE;
-			break;
-		case DRM_MODE_FLAG_3D_FRAME_PACKING:
-			stream->timing.timing_3d_format = TIMING_3D_FORMAT_SW_FRAME_PACKING;
-			stream->view_format = VIEW_3D_FORMAT_FRAME_SEQUENTIAL;
-			break;
-		default:
-			break;
-		}
 		mod_build_hf_vsif_infopacket(stream, &stream->vsp_infopacket, false, false);
-		stream->timing.timing_3d_format = saved_3d;
-		stream->view_format = saved_view;
+		/*
+		 * A 3D mode is packed by the application into an ordinary 2D frame:
+		 * the display core scans it out as 2D and only the vendor InfoFrame
+		 * tells the sink about the layout.
+		 */
+		if (stereo && amdgpu_dm_stereo_vsif(stereo, &stream->vsp_infopacket))
+			drm_warn_once(dev, "Failed to set up the 3D vendor infoframe on connector %s\n",
+				      connector->name);
 	}
 
 	if (stream->signal == SIGNAL_TYPE_DISPLAY_PORT ||
diff --git a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
index 4aadbf5..f5ac4bf 100644
--- a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
+++ b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
@@ -556,10 +556,6 @@ void mod_build_hf_vsif_infopacket(const struct dc_stream_state *stream,
 			case TIMING_3D_FORMAT_TOP_AND_BOTTOM:
 			case TIMING_3D_FORMAT_TB_SW_PACKED:
 				info_packet->sb[5] = (0x6 << 4);
-				/* Some sinks (JVC D-ILA) only engage TAB when the
-				 * 3D_Ext_Data byte is present, as Amlogic sources send it.
-				 */
-				length = 6;
 				break;
 
 			default:
