From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:35:05 +0000
Subject: [PATCH] drm/amd/display: HDR over the tunnel is not refused for its
 own HDR static metadata packet

linux-9975 made a stream that amdgpu_dm_dvbridge_fill_stream() turned into
a byte tunnel count as a tunnel (amdgpu_dm_dvbridge_stream_active()), so
that HDR over the tunnel (DVBRIDGE_HDR10_TUNNEL_LAB, drm_dvbridge_hdr10t.h),
which sends no Dolby VSIF, gets the checks of the scanout. One of them
refuses a stream with an HDR static metadata packet (the Dolby Vision
tunnels send none), and HDR over the tunnel has one by rule: the check of
the connector requires HDR_OUTPUT_METADATA, and dm_update_crtc_state()
makes the packet from it before the tunnel is made. Every commit of HDR
over the tunnel was therefore refused in amdgpu_dm_dvbridge_check_scanout()
("scanout not byte exact"; DVBRIDGE_REFUSED: FORMAT, "HDR InfoFrame yes"),
on every DCN and DCE: the property did nothing on amdgpu, and user space
went on with the ordinary output.

The scanout check now takes the HDR static metadata packet with HDR over
the tunnel, and only with it: amdgpu_dm_dvbridge_stream_hdr10t() names such
a stream (a byte tunnel without the Dolby VSIF or its HDMI 1.4b form), and a
Dolby Vision tunnel with an HDR packet, or HDR over the tunnel without one,
is still refused. The reason that DVBRIDGE_REFUSED and the kernel log give
follows the same test. Nothing changes for the Dolby Vision tunnels, nor
for a stream without the tunnel.

Host test: the stream helpers and the stream test of
amdgpu_dm_dvbridge_check_scanout() taken from the source and run on 21
cases; without this change the cases of HDR over the tunnel fail (its
stream with its packet: -EINVAL). W=1 on amdgpu: no warning. Not run on
hardware.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 36 ++++++++++++++-----
 .../display/amdgpu_dm/amdgpu_dm_dvbridge.h    |  2 ++
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 10 +++---
 3 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 97740585e..6b19feecd 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1662,15 +1662,9 @@ static int amdgpu_dm_dvbridge_infopacket(const u8 *buf, ssize_t len,
 	return 0;
 }
 
-/* The Dolby VSIF this driver builds occupies the vendor slot of the stream. */
-bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream)
+/* Hades: the vendor packet of the stream is the Dolby VSIF of the tunnel */
+static bool amdgpu_dm_dvbridge_stream_dolby(const struct dc_stream_state *stream)
 {
-	/*
-	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) sends no Dolby VSIF: the stream that
-	 * amdgpu_dm_dvbridge_fill_stream() made says it
-	 */
-	if (stream && stream->byte_tunnel)
-		return true;
 	return stream && stream->vsp_infopacket.valid &&
 	       stream->vsp_infopacket.hb0 == HDMI_INFOFRAME_TYPE_VENDOR &&
 	       ((stream->vsp_infopacket.hb2 == HDMI_DOLBY_VENDOR_INFOFRAME_SIZE &&
@@ -1684,6 +1678,28 @@ bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream)
 		 stream->vsp_infopacket.sb[3] == 0x00));
 }
 
+/* The Dolby VSIF this driver builds occupies the vendor slot of the stream. */
+bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream)
+{
+	/*
+	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h) sends no Dolby VSIF: the stream that
+	 * amdgpu_dm_dvbridge_fill_stream() made says it
+	 */
+	if (stream && stream->byte_tunnel)
+		return true;
+	return amdgpu_dm_dvbridge_stream_dolby(stream);
+}
+
+/*
+ * Hades: the stream carries HDR over the tunnel (drm_dvbridge_hdr10t.h): a byte tunnel that
+ * amdgpu_dm_dvbridge_fill_stream() made without the Dolby VSIF. Its HDR static metadata packet is
+ * what tells the sink HDR: such a stream has one, and no other tunnel has.
+ */
+bool amdgpu_dm_dvbridge_stream_hdr10t(const struct dc_stream_state *stream)
+{
+	return stream && stream->byte_tunnel && !amdgpu_dm_dvbridge_stream_dolby(stream);
+}
+
 int amdgpu_dm_dvbridge_fill_stream(struct drm_connector *connector,
 				   const struct drm_display_mode *mode,
 				   const struct drm_connector_state *con_state,
@@ -1968,7 +1984,9 @@ int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 	    stream->dither_option != DITHER_OPTION_TRUN8 ||
 	    stream->gamut_remap_matrix.enable_remap ||
 	    stream->csc_color_matrix.enable_adjustment ||
-	    stream->hdr_static_metadata.valid || !stream->avi_infopacket.valid)
+	    /* Hades: the HDR static metadata packet with HDR over the tunnel, and only with it */
+	    stream->hdr_static_metadata.valid != amdgpu_dm_dvbridge_stream_hdr10t(stream) ||
+	    !stream->avi_infopacket.valid)
 		return -EINVAL;
 	/* The whole raster, unscaled (underscan would shrink the destination). */
 	if (stream->src.x || stream->src.y || stream->src.width != w || stream->src.height != h ||
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index 5e015ac8d..28a5a1e82 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -17,6 +17,8 @@ struct dc_stream_state;
 
 /* The stream carries the Dolby Vision tunnel (its vendor slot holds the Dolby VSIF). */
 bool amdgpu_dm_dvbridge_stream_active(const struct dc_stream_state *stream);
+/* Hades: ... HDR over it, which has no Dolby VSIF and has the HDR static metadata packet */
+bool amdgpu_dm_dvbridge_stream_hdr10t(const struct dc_stream_state *stream);
 
 /*
  * An EDID with exactly one Dolby VSVDB that advertises Standard (TV-led) DV with the Dolby VSIF:
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index f56f58df7..ab3d3a187 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -371,12 +371,14 @@ static u64 dvbridge_why_scanout(struct drm_atomic_commit *state, struct drm_crtc
 			len = dvbridge_link_detail(aconn, &crtc_state->mode, buf, len, size);
 		}
 	}
-	if (stream->output_color_space != COLOR_SPACE_SRGB || stream->hdr_static_metadata.valid) {
+	if (stream->output_color_space != COLOR_SPACE_SRGB ||
+	    stream->hdr_static_metadata.valid != amdgpu_dm_dvbridge_stream_hdr10t(stream)) {
 		bits |= REFUSED(FORMAT);
 		len += scnprintf(buf + len, size - len,
-				 "%soutput colour space %d, HDR InfoFrame %s", len ? "; " : "",
-				 stream->output_color_space,
-				 str_yes_no(stream->hdr_static_metadata.valid));
+				 "%soutput colour space %d, HDR InfoFrame %s (HDR over the tunnel: %s)",
+				 len ? "; " : "", stream->output_color_space,
+				 str_yes_no(stream->hdr_static_metadata.valid),
+				 str_yes_no(amdgpu_dm_dvbridge_stream_hdr10t(stream)));
 	}
 	if (stream->timing.flags.INTERLACE ||
 	    stream->timing.timing_3d_format != TIMING_3D_FORMAT_NONE ||
-- 
2.53.0

