From cc77337d6ae63c7b979295af109e3641b461afd2 Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:29:35 +0200
Subject: [PATCH] amdgpu: hdmi vsif tab 3d ext data byte

0102-amdgpu-hdmi-vsif-tab-3d-ext-data-byte.patch of cinema-ONE's
LibreELEC tree (https://github.com/cinema-ONE/LibreELEC.tv,
packages/linux/patches/default, as of 8f7810a9d203). The file there is a
plain diff without a description of its own: the subject above is its
file name, and the author and the date are those of the commit that
carries it, 4e703345b57a ("linux: carry the amdgpu HDMI 3D and 8K
patches (0100-0108)").

[Hades: no line of code differs from the original; the diff is
regenerated against Linux 7.2.10]
---
 drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
index f5ac4bf..4aadbf5 100644
--- a/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
+++ b/drivers/gpu/drm/amd/display/modules/info_packet/info_packet.c
@@ -556,6 +556,10 @@ void mod_build_hf_vsif_infopacket(const struct dc_stream_state *stream,
 			case TIMING_3D_FORMAT_TOP_AND_BOTTOM:
 			case TIMING_3D_FORMAT_TB_SW_PACKED:
 				info_packet->sb[5] = (0x6 << 4);
+				/* Some sinks (JVC D-ILA) only engage TAB when the
+				 * 3D_Ext_Data byte is present, as Amlogic sources send it.
+				 */
+				length = 6;
 				break;
 
 			default:
