From eefa50beb27ae392a2c2dd505ac5ab99696e71ab Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Tue, 3 Nov 2026 20:45:48 +0000
Subject: [PATCH] big-fella: a short HDMI HPD drop isn't an unplug (i915 and
 amdgpu)

TVs drop HPD for a moment when they change picture mode: an LG G5 for about
0.4 s, about 0.4 s after Dolby Vision engages. Reported as a disconnect, the
compositor removes the output and adds it back: the shell's windows are
recreated over the video, the saved configuration is applied again (undoing a
temporary refresh rate, resolution and HDR) and the screen blanks.
kwin-big-fella held such an output for 3 s itself
(kwin-big-fella-hotplug-hold.patch); this does it in the kernel, for any
client.

- i915: intel_hdmi_detect reports a connected HDMI sink with a CRTC as still
  connected (EDID kept) while HPD is low, for up to i915.hpd_hold_ms (3000;
  0 off), and intel_ddi_hotplug looks again every second meanwhile, so a real
  unplug is reported when the time is up. Applies after linux-9913 (its SCDC
  recheck still runs once HPD is back).
- amdgpu: upstream's HDMI HPD debounce (amdgpu.hdmi_hpd_debounce_delay_ms,
  off by default) on by default at 3000 ms. A sink that comes back with the
  same EDID gets no hotplug event; DC re-enables the stream itself.

Not yet tested with a sink that drops HPD (the LG B4 on ryzen-fella and the
N150 doesn't); there, boots, forced detects and EDID changes neither hold nor
remove the output.

[Hades: taken as is from YBLOD 0.3.3 (dangerouslaser/libreelec-yblod
3b3a983f93, linux-9925-big-fella-hdmi-hpd-hold.patch; big-fella 69c770c),
as linux-9962; its linux-9913 is linux-9959 here, and linux-9963 (their
9927) goes with it: without it, the SCDC look of every hotplug runs while
the sink is not answering. YBLOD measured the i915 side on an LG G5 with a
Tiger Lake ("HPD back after 1007-1027 ms"). The hold is in the detect path
of display version 11 and later; earlier ones detect by the EDID and are as
before. amdgpu (read in Linux 7.3.1, not run): the HPD interrupt of a sink
that comes back while the debounce work waits is dropped, and the work
detects 3 s after the drop; a sink that is the same goes through
dm_restore_drm_connector_state(), where linux-9964 sets the link up again if
the sink lost its scrambling setup; another sink, or none, is reported then.
The KUnit tests of the debounce set the delay of their own connectors and do
not read this default. Kodi gets no hot-plug event from a held drop.]
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c       | 14 ++++-
 drivers/gpu/drm/i915/display/intel_ddi.c      |  5 ++
 .../drm/i915/display/intel_display_types.h    |  4 ++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 56 ++++++++++++++++++-
 4 files changed, 75 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index d9d794a..dac2f89 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -245,7 +245,8 @@ int amdgpu_damage_clips = -1; /* auto */
 int amdgpu_umsch_mm_fwlog;
 int amdgpu_rebar = -1; /* auto */
 int amdgpu_user_queue = -1;
-uint amdgpu_hdmi_hpd_debounce_delay_ms;
+/* big-fella: 3000, not 0 (off); see hdmi_hpd_debounce_delay_ms below */
+uint amdgpu_hdmi_hpd_debounce_delay_ms = 3000;
 int amdgpu_ptl = -1; /* auto */
 
 DECLARE_DYNDBG_CLASSMAP(drm_debug_classes, DD_CLASS_TYPE_DISJOINT_BITS, 0,
@@ -1109,8 +1110,15 @@ module_param_named(user_queue, amdgpu_user_queue, int, 0444);
  *
  * Used to filter short disconnect->reconnect HPD toggles some HDMI sinks
  * generate while entering/leaving power save. Set to 0 to disable by default.
- */
-MODULE_PARM_DESC(hdmi_hpd_debounce_delay_ms, "HDMI HPD disconnect debounce delay in milliseconds (0 to disable (by default), 1500 is common)");
+ *
+ * big-fella: 3000 by default. TVs drop HPD for a moment as they change picture
+ * mode (an LG G5 for ~0.4 s, ~0.4 s after Dolby Vision engages); reported, the
+ * compositor removed the output and added it back (windows recreated, the
+ * saved configuration applied again). Until linux-yblod 7.3-7 KWin held the
+ * output 3 s itself (kwin-big-fella-hotplug-hold.patch); i915 has
+ * i915.hpd_hold_ms. A real unplug is reported after the delay.
+ */
+MODULE_PARM_DESC(hdmi_hpd_debounce_delay_ms, "HDMI HPD disconnect debounce delay in milliseconds (0 to disable, 1500 is common; big-fella: 3000 by default)");
 module_param_named(hdmi_hpd_debounce_delay_ms, amdgpu_hdmi_hpd_debounce_delay_ms, uint, 0644);
 
 /**
diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index 4c113a6..46a6eef 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
+++ b/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -4965,6 +4965,11 @@ intel_ddi_hotplug(struct intel_encoder *encoder,
 	if (state == INTEL_HOTPLUG_UNCHANGED && connector->hdmi_scdc_recheck)
 		state = INTEL_HOTPLUG_RETRY;
 
+	/* big-fella: HPD held low (intel_hdmi_detect): look again until it's
+	 * back or the hold is up */
+	if (state == INTEL_HOTPLUG_UNCHANGED && connector->hpd_held)
+		state = INTEL_HOTPLUG_RETRY;
+
 	return state;
 }
 
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index cdfda34..fcfdf8f 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -566,6 +566,10 @@ struct intel_connector {
 	/* big-fella: modesets intel_hdmi_reset_link made since hdmi_scdc_fix_since (at most 3 in 20 s) */
 	int hdmi_scdc_fixes;
 	unsigned long hdmi_scdc_fix_since;
+	/* big-fella: HPD low on a connected HDMI sink with a CRTC, reported as
+	 * connected since hpd_low_since (intel_hdmi_detect, i915.hpd_hold_ms) */
+	bool hpd_held;
+	unsigned long hpd_low_since;
 
 	/* since POLL and HPD connectors may use the same HPD line keep the native
 	   state of connector->polled in case hotplug storm detection changes it */
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 0bc79b5..63689f0 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2926,6 +2926,50 @@ intel_hdmi_set_edid(struct drm_connector *_connector)
 	return connected;
 }
 
+/*
+ * big-fella: TVs drop HPD for a moment when they change picture mode (an LG
+ * G5 for ~0.4 s, ~0.4 s after Dolby Vision engages). Reported as is, the
+ * compositor removes the output and adds it again: windows recreated, the
+ * saved configuration applied again, a blank. While a connected HDMI sink has
+ * a CRTC, HPD low is reported as still connected (the EDID kept) for up to
+ * hpd_hold_ms; intel_ddi_hotplug looks again every second meanwhile, so a real
+ * unplug is reported once the time is up. Until linux-yblod 7.3-7 KWin did
+ * this itself (kwin-big-fella-hotplug-hold.patch, 3 s). 0 turns it off.
+ */
+static unsigned int hpd_hold_ms = 3000;
+module_param(hpd_hold_ms, uint, 0644);
+MODULE_PARM_DESC(hpd_hold_ms,
+	"HDMI: ms an HPD drop of a sink with an active output is reported as still "
+	"connected (big-fella; default 3000, 0 off)");
+
+static bool intel_hdmi_hpd_hold(struct intel_connector *connector)
+{
+	struct intel_display *display = to_intel_display(connector);
+
+	if (!hpd_hold_ms || connector->base.status != connector_status_connected ||
+	    !connector->base.state || !connector->base.state->crtc) {
+		connector->hpd_held = false;
+		return false;
+	}
+
+	if (!connector->hpd_held) {
+		connector->hpd_held = true;
+		connector->hpd_low_since = jiffies;
+		drm_info(display->drm, "[CONNECTOR:%d:%s] HPD low with an active output, still connected for up to %u ms\n",
+			 connector->base.base.id, connector->base.name, hpd_hold_ms);
+		return true;
+	}
+
+	if (time_before(jiffies, connector->hpd_low_since + msecs_to_jiffies(hpd_hold_ms)))
+		return true;
+
+	connector->hpd_held = false;
+	drm_info(display->drm, "[CONNECTOR:%d:%s] HPD still low after %u ms, disconnected\n",
+		 connector->base.base.id, connector->base.name,
+		 jiffies_to_msecs(jiffies - connector->hpd_low_since));
+	return false;
+}
+
 static enum drm_connector_status
 intel_hdmi_detect(struct drm_connector *_connector, bool force)
 {
@@ -2948,8 +2992,18 @@ intel_hdmi_detect(struct drm_connector *_connector, bool force)
 	wakeref = intel_display_power_get(display, POWER_DOMAIN_GMBUS);
 
 	if (DISPLAY_VER(display) >= 11 &&
-	    !intel_digital_port_connected(encoder))
+	    !intel_digital_port_connected(encoder)) {
+		/* big-fella: a short HPD drop isn't an unplug (hpd_hold_ms) */
+		if (intel_hdmi_hpd_hold(connector))
+			status = connector_status_connected;
 		goto out;
+	}
+
+	if (connector->hpd_held)
+		drm_info(display->drm, "[CONNECTOR:%d:%s] HPD back after %u ms\n",
+			 connector->base.base.id, connector->base.name,
+			 jiffies_to_msecs(jiffies - connector->hpd_low_since));
+	connector->hpd_held = false;
 
 	intel_hdmi_unset_edid(&connector->base);
 
