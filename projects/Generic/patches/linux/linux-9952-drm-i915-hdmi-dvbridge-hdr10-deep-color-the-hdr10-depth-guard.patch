From bdfd6b79da3f394b185374a25417ae5a644bf3f1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:43:15 +0000
Subject: [PATCH] drm/i915/hdmi: DVBRIDGE_HDR10_DEEP_COLOR, the HDR10 depth
 guard

HDR10 (PQ) needs 10 bits per component. Kodi gives i915 a 10-bit
framebuffer for it, but the depth of the HDMI link is the driver's
choice: at 3840x2160 above 30 Hz the TMDS clock of 10 bits does not
fit HDMI 2.0, an HDMI 1.4 TV input (340 MHz) takes 2160p at 8 bits
only, and the depths a port sends depend on the display version
(display 10: 8 or 12 bits; display 11 and later: 8 or 10, with
LibreELEC's linux 9900). The picture then goes out at 8 bits, without
dither, and user space cannot know.

DVBRIDGE_HDR10_DEEP_COLOR is a boolean connector property, beside
HDR_OUTPUT_METADATA (display 10 and later, where enable_dv_lab is on).
While it is set and the connector state carries HDR10 static metadata
(SMPTE ST 2084), a configuration that would send fewer than 10 bits per
component is refused, with the reason hdr10-depth in DVBRIDGE_REFUSED
and the figures in the kernel log (the TMDS clock of 10 bits against
the port, an adaptor and the sink, what the port and the sink take).
It changes nothing of the configuration that is computed: the guard
only refuses. Without HDR10 metadata it does nothing, so a guard that
was left set never blocks an SDR mode, and a disabled connector drops
it. A change of the guard computes the configuration again, as a change
of the HDR metadata does (a fastset when nothing else changes).

Kodi uses it as a question, in a TEST_ONLY commit: whether Dolby Vision
reconstructed as HDR10 leaves at 10 bits in the mode in use, to say so
in its player information. It does not commit it.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 17 +++++
 .../drm/i915/display/intel_display_types.h    |  9 ++-
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 71 +++++++++++++++++--
 3 files changed, 88 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index dd32230..d643d94 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -69,6 +69,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_standard;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_hdr10_property &&
+	    property == to_intel_connector(connector)->dv_hdr10_property) {
+		*val = intel_conn_state->dv_hdr10_deep_color;
+		return 0;
+	}
 
 	if (property == display->properties.force_audio)
 		*val = intel_conn_state->force_audio;
@@ -111,6 +116,13 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_standard = val;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_hdr10_property &&
+	    property == to_intel_connector(connector)->dv_hdr10_property) {
+		if (val > 1)
+			return -EINVAL;
+		intel_conn_state->dv_hdr10_deep_color = val;
+		return 0;
+	}
 
 	if (property == display->properties.force_audio) {
 		intel_conn_state->force_audio = val;
@@ -144,6 +156,8 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 
 	if (!new_state->crtc) {
 		new_conn_state->dv_lab_standard = false;
+		/* Hades: a disabled connector drops the HDR10 depth guard as well */
+		new_conn_state->dv_hdr10_deep_color = false;
 		return 0;
 	}
 
@@ -152,8 +166,11 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	/*
 	 * These properties are handled by fastset, and might not end
 	 * up in a modeset.
+	 * (Hades: the HDR10 depth guard as well. It changes nothing of the output: the
+	 * configuration is computed again only so that the guard sees the depth of the link.)
 	 */
 	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
+	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
 	    new_conn_state->broadcast_rgb != old_conn_state->broadcast_rgb ||
 	    new_conn_state->base.colorspace != old_conn_state->base.colorspace ||
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 1260547..f07c9ad 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -523,9 +523,12 @@ struct intel_connector {
 	/* Private experimental property; gated by enable_dv_lab. */
 	struct drm_property *dv_lab_property;
 	/*
-	 * Hades, gated by enable_dv_lab too: DVBRIDGE_REFUSED, why the last request of the tunnel
-	 * was refused, with what the kernel log has said of it (drm_dvbridge_refused.h).
+	 * Hades, gated by enable_dv_lab too: DVBRIDGE_HDR10_DEEP_COLOR, the guard that refuses a
+	 * commit sending HDR10 with fewer than 10 bits per component, and DVBRIDGE_REFUSED, why
+	 * the last request of the tunnel or of the guard was refused, with what the kernel log
+	 * has said of it (drm_dvbridge_refused.h).
 	 */
+	struct drm_property *dv_hdr10_property;
 	struct drm_property *dv_refused_property;
 	struct drm_dvbridge_refused_log dv_refused_log;
 	/*
@@ -624,6 +627,8 @@ struct intel_digital_connector_state {
 	struct drm_connector_state base;
 	/* Scalar copy/reset lifecycle, no property-blob reference to leak. */
 	bool dv_lab_standard;
+	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR (scalar as well) */
+	bool dv_hdr10_deep_color;
 
 	enum hdmi_force_audio force_audio;
 	int broadcast_rgb;
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 0d5a07a..d6af0f8 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2432,8 +2432,27 @@ bool intel_hdmi_compute_has_hdmi_sink(struct intel_encoder *encoder,
 }
 
 /*
- * Hades: a request of the Dolby Vision tunnel was checked: bits are why it was refused, 0 when it
- * passed (DVBRIDGE_REFUSED and the kernel log, see drm_dvbridge_refused.h).
+ * Hades: the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR) is set and the connector state carries
+ * HDR10 static metadata (SMPTE ST 2084). Only then does the guard refuse anything: without HDR10
+ * a guard that was left set changes nothing.
+ */
+static bool intel_hdmi_hdr10_guarded(const struct drm_connector_state *conn_state)
+{
+	const struct hdr_output_metadata *hdr;
+
+	if (!to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color ||
+	    !conn_state->hdr_output_metadata ||
+	    conn_state->hdr_output_metadata->length < sizeof(*hdr))
+		return false;
+	hdr = conn_state->hdr_output_metadata->data;
+	return hdr->metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+	       hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
+}
+
+/*
+ * Hades: a request of the Dolby Vision tunnel or of the HDR10 depth guard was checked: bits are
+ * why it was refused, 0 when it passed (DVBRIDGE_REFUSED and the kernel log, see
+ * drm_dvbridge_refused.h).
  */
 static void intel_hdmi_dvbridge_refused(struct intel_connector *connector, u64 bits,
 					const char *detail)
@@ -2532,8 +2551,9 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	struct drm_display_mode *adjusted_mode = &pipe_config->hw.adjusted_mode;
 	struct intel_connector *connector = to_intel_connector(conn_state->connector);
 	struct drm_scdc *scdc = &connector->base.display_info.hdmi.scdc;
-	/* Hades: a request of the Dolby Vision tunnel */
+	/* Hades: a request of the Dolby Vision tunnel or of the HDR10 depth guard */
 	const bool dv_requested = to_intel_digital_connector_state(conn_state)->dv_lab_standard;
+	const bool hdr10_guarded = intel_hdmi_hdr10_guarded(conn_state);
 	char detail[256];
 	int ret;
 
@@ -2541,7 +2561,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	 * Hades: what the last check of such a request found is cleared; each test below that
 	 * refuses it says why (it stays 0 when it passes)
 	 */
-	if (dv_requested)
+	if (dv_requested || hdr10_guarded)
 		intel_hdmi_dvbridge_refused(connector, 0, NULL);
 
 	if (adjusted_mode->flags & DRM_MODE_FLAG_DBLSCAN)
@@ -2605,6 +2625,30 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	pipe_config->limited_color_range =
 		intel_hdmi_limited_color_range(pipe_config, conn_state);
 
+	/*
+	 * Hades: HDR10 under the depth guard leaves at 10 bits per component or more, or the commit
+	 * is refused (and user space knows that the link carries it with fewer). Nothing of the
+	 * configuration is changed for it.
+	 */
+	if (hdr10_guarded && pipe_config->pipe_bpp < 30) {
+		size_t len = scnprintf(detail, sizeof(detail), "HDR10 would go out at %d bpc in ",
+				       pipe_config->pipe_bpp / 3);
+
+		len = intel_hdmi_dvbridge_link_detail(encoder, connector, adjusted_mode, 10,
+						      detail, len, sizeof(detail));
+		scnprintf(detail + len, sizeof(detail) - len,
+			  "; this port sends 10 bpc: %s, 12 bpc: %s; the sink takes RGB at 10 bpc: %s, at 12 bpc: %s",
+			  str_yes_no(intel_hdmi_source_bpc_possible(display, 10)),
+			  str_yes_no(intel_hdmi_source_bpc_possible(display, 12)),
+			  str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
+				     DRM_EDID_HDMI_DC_30),
+			  str_yes_no(connector->base.display_info.edid_hdmi_rgb444_dc_modes &
+				     DRM_EDID_HDMI_DC_36));
+		intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_HDR10_DEPTH),
+					    detail);
+		return -EINVAL;
+	}
+
 	if (to_intel_digital_connector_state(conn_state)->dv_lab_standard) {
 		const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
 		struct intel_dv_lab_link link = {
@@ -2966,14 +3010,27 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 	intel_attach_hdmi_colorspace_property(&connector->base);
 	drm_connector_attach_content_type_property(&connector->base);
 
-	if (DISPLAY_VER(display) >= 10)
+	if (DISPLAY_VER(display) >= 10) {
 		drm_connector_attach_hdr_output_metadata_property(&connector->base);
 
+		/*
+		 * Hades: the HDR10 depth guard, where HDR metadata can be sent (it acts only with
+		 * HDR10 metadata in the connector state)
+		 */
+		if (display->params.enable_dv_lab) {
+			connector->dv_hdr10_property = drm_property_create_bool(display->drm,
+				DRM_MODE_PROP_ATOMIC, "DVBRIDGE_HDR10_DEEP_COLOR");
+			if (connector->dv_hdr10_property)
+				drm_object_attach_property(&_connector->base,
+							   connector->dv_hdr10_property, 0);
+		}
+	}
+
 	if (!HAS_GMCH(display))
 		drm_connector_attach_max_bpc_property(&connector->base, 8, 12);
 
-	/* Hades: why a request of the tunnel was refused (read only) */
-	if (connector->dv_lab_property) {
+	/* Hades: why a request of the tunnel or of the guard was refused (read only) */
+	if (connector->dv_lab_property || connector->dv_hdr10_property) {
 		connector->dv_refused_property = drm_dvbridge_refused_property_create(display->drm);
 		if (connector->dv_refused_property) {
 			drm_dvbridge_refused_log_init(&connector->dv_refused_log);
