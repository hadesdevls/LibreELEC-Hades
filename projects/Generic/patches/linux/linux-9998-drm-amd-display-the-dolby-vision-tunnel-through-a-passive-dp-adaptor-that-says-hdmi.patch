+/*
+ * Hades: the link of the connector carries the tunnel: native TMDS HDMI, as the tunnel always took,
+ * or a DisplayPort connector (SST) whose display is behind a passive dual-mode adaptor that
+ * identifies itself as an HDMI one, with an HDMI display (amdgpu_dm_dual_mode_of()). DC drives that
+ * link as TMDS HDMI, InfoFrames included; a stream that the TMDS clock of the adaptor does not carry
+ * in RGB at 8 bits fails its validation, and the scanout check refuses what comes instead (YCbCr,
+ * named as a link limit). Any other DisplayPort connector stays refused.
+ */
+STATIC_IFN_KUNIT bool amdgpu_dm_dvbridge_tmds_hdmi(const struct amdgpu_dm_connector *aconn)
+{
+	if (!aconn->dc_link || !aconn->base.display_info.has_hdmi_infoframe)
+		return false;
+	if (aconn->base.connector_type == DRM_MODE_CONNECTOR_HDMIA)
+		return aconn->dc_link->connector_signal == SIGNAL_TYPE_HDMI_TYPE_A;
+	return amdgpu_dm_connector_dual_mode(aconn) == AMDGPU_DVBRIDGE_DUAL_MODE_HDMI;
+}
+EXPORT_IF_KUNIT(amdgpu_dm_dvbridge_tmds_hdmi);
