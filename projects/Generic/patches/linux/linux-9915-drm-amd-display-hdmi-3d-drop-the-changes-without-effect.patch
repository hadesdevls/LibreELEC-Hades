From a66a79ed553951ea3635377e0ece5dd40ee78b4e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:00:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: drop the changes that have no
 effect

Four parts of the HDMI 3D patches change no behaviour. They go, so that
what is carried on top of the kernel is what does something, and so that
the display core (dc/) stays as upstream has it:

- fill_stream_properties_from_drm_display_mode() switched on the 3D
  layout to store TIMING_3D_FORMAT_NONE and VIEW_3D_FORMAT_NONE in every
  branch. The one line of upstream does the same: the stream comes
  zeroed from dc_create_stream_for_sink(), and VIEW_3D_FORMAT_NONE is 0.
  What the comments of the switch explained stays, as one comment: a 3D
  mode is scanned out as plain 2D, and a DC stereo format or a view
  format in the stream makes the hardware handle two views;
- optc1_validate_timing() accepted the "software packed" formats. No
  stream reaches it with one: create_stream_for_sink() stores them only
  while it builds the vendor InfoFrame and puts back what was there
  before it returns;
- amdgpu_dm_connector_mode_valid() doubled the timing of its test mode.
  create_stream_for_sink() works on its own copy of the mode and sets
  the timing of that copy again, from the mode itself;
- create_stream_for_sink() doubled the timing of saved_mode, which
  nothing reads after that line (upstream sets it there, to no use
  either).

The last two tested the layout with
"flags & DRM_MODE_FLAG_3D_FRAME_PACKING". The layouts are values of one
field, not bits: that test is also true for top-and-bottom, line
alternative and L + depth. It did no harm, because
drm_mode_set_crtcinfo() looks at the whole field before it doubles
anything. The one test of that kind that is left is corrected in the
next patch.

Checked: compiled with the configuration and the compiler of the image.
Not run on hardware.

Ported to Linux 7.3: 7.3 split amdgpu_dm.c; the three hunks go with their
functions to amdgpu_dm_connector.c (fill_stream_properties_from_drm_display_mode(),
create_stream_for_sink() and amdgpu_dm_connector_mode_valid()), with the
context 7.3 gives them (the pixel encoding chosen by the caller, the amdgpu_dm_
names of two helpers). What each says still holds in 7.3: the stream comes
zeroed from dc_create_stream_for_sink(), and create_stream_for_sink() sets the
timing of its own copy of the mode. The code is the code of 7.2.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 40 +++++--------------
 .../amd/display/dc/optc/dcn10/dcn10_optc.c    |  3 --
 2 files changed, 11 insertions(+), 32 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index a878bc1..fcdf55a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -909,29 +909,15 @@ STATIC_IFN_KUNIT void fill_stream_properties_from_drm_display_mode(
 	 */
 	timing_out->pixel_encoding = requested_encoding;
 
-	switch (mode_in->flags & DRM_MODE_FLAG_3D_MASK) {
-	/* SBS/TAB: the application packs both eyes into a 2D frame, so the
-	 * display core scans out plain 2D; only the VSIF says 3D (see
-	 * create_stream_for_sink). Any DC stereo format here makes the hardware
-	 * treat the plane as two views and paint the whole frame into each. */
-	case DRM_MODE_FLAG_3D_TOP_AND_BOTTOM:
-	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF:
-	case DRM_MODE_FLAG_3D_SIDE_BY_SIDE_FULL:
-		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
-		stream->view_format = VIEW_3D_FORMAT_NONE;
-		break;
-	/* Frame packing likewise: the doubled 2205-line frame is already laid
-	 * out by the application (eye, 45-line gap, eye), so scan it out as 2D
-	 * too; DC's stereo programming would re-pack it. */
-	case DRM_MODE_FLAG_3D_FRAME_PACKING:
-		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
-		stream->view_format = VIEW_3D_FORMAT_NONE;
-		break;
-	default:
-		timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
-		stream->view_format = VIEW_3D_FORMAT_NONE;
-		break;
-	}
+	/*
+	 * Also for a 3D mode: the application packs both eyes into one frame (side by
+	 * side, one above the other or, for frame packing, the doubled frame with its
+	 * gap) and the display core scans it out as plain 2D; only the vendor InfoFrame
+	 * says 3D (see create_stream_for_sink()). A DC stereo format here, or a view
+	 * format in the stream, makes the hardware treat the plane as two views: it
+	 * paints the whole frame into each, or packs the frame again.
+	 */
+	timing_out->timing_3d_format = TIMING_3D_FORMAT_NONE;
 	timing_out->display_color_depth = amdgpu_dm_convert_color_depth_from_display_info(
 		connector,
 		(timing_out->pixel_encoding == PIXEL_ENCODING_YCBCR420),
@@ -1860,9 +1846,7 @@ create_stream_for_sink(struct drm_connector *connector,
 	}
 
 	if (recalculate_timing)
-		drm_mode_set_crtcinfo(&saved_mode,
-				      (saved_mode.flags & DRM_MODE_FLAG_3D_FRAME_PACKING) ?
-				      CRTC_STEREO_DOUBLE : 0);
+		drm_mode_set_crtcinfo(&saved_mode, 0);
 
 	/*
 	 * If scaling is enabled and refresh rate didn't change
@@ -2864,9 +2848,7 @@ enum drm_mode_status amdgpu_dm_connector_mode_valid(struct drm_connector *connec
 	if (!test_mode)
 		goto fail;
 
-	drm_mode_set_crtcinfo(test_mode,
-			      (test_mode->flags & DRM_MODE_FLAG_3D_FRAME_PACKING) ?
-			      CRTC_STEREO_DOUBLE : 0);
+	drm_mode_set_crtcinfo(test_mode, 0);
 
 	stream = amdgpu_dm_create_validate_stream_for_sink(connector, test_mode,
 						 to_dm_connector_state(connector->state),
diff --git a/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c b/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
index 4416bdb..844705a 100644
--- a/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
+++ b/drivers/gpu/drm/amd/display/dc/optc/dcn10/dcn10_optc.c
@@ -603,9 +603,6 @@ bool optc1_validate_timing(
 
 	if (timing->timing_3d_format != TIMING_3D_FORMAT_NONE &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_HW_FRAME_PACKING &&
-		timing->timing_3d_format != TIMING_3D_FORMAT_SW_FRAME_PACKING &&
-		timing->timing_3d_format != TIMING_3D_FORMAT_SBS_SW_PACKED &&
-		timing->timing_3d_format != TIMING_3D_FORMAT_TB_SW_PACKED &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_TOP_AND_BOTTOM &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_SIDE_BY_SIDE &&
 		timing->timing_3d_format != TIMING_3D_FORMAT_FRAME_ALTERNATE &&
-- 
