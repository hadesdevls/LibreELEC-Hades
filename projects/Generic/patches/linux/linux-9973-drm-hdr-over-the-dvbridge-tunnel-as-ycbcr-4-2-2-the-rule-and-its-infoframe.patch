From 247ff312d1b75335ff8b7175c96fa41a7b8666e9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:40:52 +0000
Subject: [PATCH 1/3] drm: HDR over the dvbridge tunnel, as YCbCr 4:2:2 at 12
 bits: the rule and its InfoFrame

HDR over HDMI 2.0 TMDS at 3840x2160 50 and 60 Hz does not fit in RGB at 10
bits (742.5 MHz against 600), so i915 and amdgpu send it at 8 bits, or in
YCbCr 4:2:0 at 10 bits (linux-9966, 9968, 9969). amdgpu's display core can
send YCbCr 4:2:2 at 12 bits (linux-9972), but not on DCN 3.1 and 3.1.5
(Raphael, Rembrandt, Mendocino: no_native422_support), and i915 has no 4:2:2
output on HDMI at all. The byte exact RGB 8 bpc tunnel of
DVBRIDGE_DV_STANDARD_LAB already carries YCbCr 4:2:2 at 12 bits in its
pixels (linux-9975), whatever the hardware subsamples: with an AVI InfoFrame
that says YCbCr 4:2:2, BT.2020, limited range, and the HDR static metadata
InfoFrame of the connector, the sink reads the same bytes as a plain HDR
picture in 4:2:2 at 12 bits, every line with its own chroma, at the TMDS
clock of RGB at 8 bits (594 MHz at 2160p60).

drm_dvbridge_hdr10t.h is the rule that i915 and amdgpu share for it, for a
connector property DVBRIDGE_HDR10_TUNNEL_LAB that the next patches add to
each: what a request needs (the sink declares YCbCr 4:2:2, HDR_OUTPUT_METADATA
is in the connector state, not with Low-Latency or the HDMI 1.4b signal, which
are Dolby Vision signals, and HDR10+ only where the mode leaves the vendor
slot free), its reasons for DVBRIDGE_REFUSED and the kernel log, and the AVI
InfoFrame fields (those of Low-Latency, drm_dvbridge_ll_avi()). No Dolby VSIF
is sent: the vendor slot is free and nothing tells the sink Dolby Vision. The
functions touch no kernel object, so a host test builds them.

The idea of HDR10 over the tunnel, as "Master Reference", is YBLOD's
(github.com/dangerouslaser/libreelec-yblod, linux-9928, DVBRIDGE_TUNNEL_FORMAT);
this is its own form, from the behaviour of the tunnel here, not from that
code.

Nothing uses the header yet.
---
 include/drm/drm_dvbridge_hdr10t.h | 98 +++++++++++++++++++++++++++++++
 1 file changed, 98 insertions(+)
 create mode 100644 include/drm/drm_dvbridge_hdr10t.h

diff --git a/include/drm/drm_dvbridge_hdr10t.h b/include/drm/drm_dvbridge_hdr10t.h
new file mode 100644
index 000000000..06969de14
--- /dev/null
+++ b/include/drm/drm_dvbridge_hdr10t.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * DVBRIDGE_HDR10_TUNNEL_LAB: HDR (HDR10, HLG, HDR10+) sent as YCbCr 4:2:2 at 12 bits over the byte
+ * exact RGB 8 bpc tunnel that DVBRIDGE_DV_STANDARD_LAB turns on (amdgpu, i915 and xe).
+ *
+ * Where it is for. HDR over HDMI 2.0 TMDS at 3840x2160 50 and 60 Hz does not fit in RGB at 10 bits
+ * (it needs 742.5 MHz, the link has 600), so i915 and amdgpu send it at 8 bits, or Hades sends it in
+ * YCbCr 4:2:0 at 10 bits (drm_dvbridge_hdr.h). amdgpu's display core can send YCbCr 4:2:2 at 12 bits
+ * itself (linux-9972), but not on DCN 3.1 and 3.1.5 (Raphael, Rembrandt, Mendocino: they refuse
+ * 4:2:2 over HDMI), and i915 has no 4:2:2 output on HDMI at all. The tunnel does not need the
+ * hardware to: user space packs the picture as YCbCr 4:2:2 at 12 bits into RGB 8 bpc pixels (the
+ * luma in G, the high eight bits of the chroma sample in R and the low four bits of both in B, the
+ * layout of the HDMI 4:2:2 pixel encoding, as drm_dvbridge_ll.h has it), and the kernel scans the
+ * bytes out untouched at the TMDS clock of RGB at 8 bits, 594 MHz at 2160p60, with an AVI
+ * InfoFrame that says YCbCr 4:2:2, BT.2020, limited range. The sink reads the pixels as what the
+ * AVI InfoFrame says they are: a plain HDR picture in 4:2:2 at 12 bits, with every pixel of the
+ * chroma of the lines exact (no subsampling or conversion of the display core), so what Kodi
+ * draws over the video (menus, subtitles) keeps its chroma.
+ *
+ * What it is. The Low-Latency tunnel of drm_dvbridge_ll.h with other InfoFrames: no Dolby VSIF
+ * (the vendor slot is free: nothing tells the sink Dolby Vision, so it takes the picture as HDR),
+ * the HDR static metadata InfoFrame of the HDR_OUTPUT_METADATA of the connector (the tunnel
+ * refuses it otherwise), and the sink's rule is not the Dolby block but YCbCr 4:2:2 in its CTA
+ * block. The scanout, its checks (byte exact: no colour processing, dither, scaling, other planes,
+ * VRR, DSC), the modes and the refusals are those of the Standard tunnel.
+ *
+ * The idea of HDR10 over the tunnel, as "Master Reference", comes from the YBLOD fork of
+ * LibreELEC (github.com/dangerouslaser/libreelec-yblod, linux-9928, DVBRIDGE_TUNNEL_FORMAT); this
+ * is its own form, read from the behaviour of the tunnel here and not from that code.
+ *
+ * Nothing here touches a kernel object, so that a test can build it on the host.
+ */
+#ifndef __DRM_DVBRIDGE_HDR10T_H__
+#define __DRM_DVBRIDGE_HDR10T_H__
+
+#include <linux/hdmi.h>
+#include <linux/types.h>
+#include <drm/drm_dvbridge_refused.h>
+
+/* What the request of the connector has, for drm_dvbridge_hdr10t_refused() */
+struct drm_dvbridge_hdr10t_request {
+	/* the sink's EDID declares YCbCr 4:2:2 (the CTA block's capability bits) */
+	bool sink_ycbcr422;
+	/* HDR_OUTPUT_METADATA is in the connector state (what the sink takes of it is DRM's check) */
+	bool hdr_metadata;
+	/* DVBRIDGE_DV_LOW_LATENCY_LAB or DVBRIDGE_DV_HDMI14B_LAB is set as well */
+	bool low_latency, hdmi14b;
+	/* HDR10PLUS_VSIF is set, and the mode leaves the vendor slot free for it */
+	bool hdr10plus, vendor_slot_free;
+};
+
+/*
+ * Why the request cannot be sent as HDR over the tunnel, as bits of DVBRIDGE_REFUSED; 0 when it
+ * can. The mode, the link and the scanout are checked by the tunnel's own rules.
+ */
+static inline u64 drm_dvbridge_hdr10t_refused(const struct drm_dvbridge_hdr10t_request *r)
+{
+	u64 bits = 0;
+
+	if (!r->sink_ycbcr422)
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID;
+	if (!r->hdr_metadata || r->low_latency || r->hdmi14b ||
+	    (r->hdr10plus && !r->vendor_slot_free))
+		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_FORMAT;
+	return bits;
+}
+
+/* Why drm_dvbridge_hdr10t_refused() is not 0, for the kernel log; NULL exactly when it is 0. */
+static inline const char *drm_dvbridge_hdr10t_why(const struct drm_dvbridge_hdr10t_request *r)
+{
+	if (!r->sink_ycbcr422)
+		return "the sink does not declare YCbCr 4:2:2 in its EDID, which HDR over the tunnel is sent as";
+	if (r->low_latency || r->hdmi14b)
+		return "DVBRIDGE_HDR10_TUNNEL_LAB is set with Low-Latency or the HDMI 1.4b signal, which are Dolby Vision signals";
+	if (!r->hdr_metadata)
+		return "DVBRIDGE_HDR10_TUNNEL_LAB is set without HDR_OUTPUT_METADATA: nothing says HDR";
+	if (r->hdr10plus && !r->vendor_slot_free)
+		return "HDR10PLUS_VSIF is set and the mode has an HDMI VIC, which takes the vendor slot";
+	return NULL;
+}
+
+/*
+ * The AVI InfoFrame of HDR over the tunnel, from the one the driver built for the mode and the
+ * tunnel (drm_dvbridge_tunnel_avi(): its VIC, aspect ratio, content type): YCbCr 4:2:2, BT.2020
+ * (the non-constant luminance Y'Cb'Cr' of ITU-R BT.2020, which is what the packer of user space
+ * makes), limited range. The fields are those of Low-Latency (drm_dvbridge_ll_avi()): the ones
+ * the two drivers send for their own YCbCr output.
+ */
+static inline void drm_dvbridge_hdr10t_avi(struct hdmi_avi_infoframe *frame)
+{
+	frame->colorspace = HDMI_COLORSPACE_YUV422;
+	frame->colorimetry = HDMI_COLORIMETRY_EXTENDED;
+	frame->extended_colorimetry = HDMI_EXTENDED_COLORIMETRY_BT2020;
+	frame->quantization_range = HDMI_QUANTIZATION_RANGE_DEFAULT;
+	frame->ycc_quantization_range = HDMI_YCC_QUANTIZATION_RANGE_LIMITED;
+}
+
+#endif /* __DRM_DVBRIDGE_HDR10T_H__ */
-- 
2.53.0

