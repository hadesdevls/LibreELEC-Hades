diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index 8dd3bd3dd..4b70eb262 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -52,6 +52,8 @@ static inline bool intel_dv_lab_native_hdmi(bool lspcon_active,
  */
 struct intel_dv_lab_link {
 	bool requested, lab_enabled, sink_standard, sink_2160p60, hdmi, native_hdmi;
+	/* Hades: a DisplayPort to HDMI converter that the tunnel goes through (intel_dv_pcon_policy.h) */
+	bool converter;
 	bool rgb, limited_range, hdr_blob, cloned, progressive;
 	/*
 	 * Hades: HDR over the tunnel (drm_dvbridge_hdr10t.h): the connector state has the HDR metadata
@@ -74,7 +76,7 @@ static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 {
 	if (!s->requested)
 		return 0;
-	if (!s->lab_enabled || !s->sink_standard || !s->native_hdmi)
+	if (!s->lab_enabled || !s->sink_standard || !(s->native_hdmi || s->converter))
 		return -EOPNOTSUPP;
 	if (!s->hdmi || !s->rgb || s->limited_range || (s->hdr_blob && !s->hdr10t) || s->cloned ||
 	    !s->progressive || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
@@ -109,7 +111,7 @@ static inline u64 intel_dv_lab_refused(const struct intel_dv_lab_link *s, bool y
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID;
 	else if (intel_dv_lab_2160p60(s) && !s->sink_2160p60)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_EDID_2160P30;
-	if (!s->native_hdmi)
+	if (!s->native_hdmi && !s->converter)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_CONVERTER;
 	if (!s->hdmi)
 		bits |= 1ULL << DRM_DVBRIDGE_REFUSED_SINK;
diff --git a/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h b/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h
new file mode 100644
index 000000000..da26995e3
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_dv_pcon_policy.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: the policy of the Dolby Vision tunnel through the DisplayPort to HDMI converter that some
+ * boards have between a DDI port and their HDMI socket (a protocol converter, PCON: the HDMI port
+ * of many Intel NUCs and mini PCs of the 11th generation and later). Such a port is a DisplayPort
+ * connector for i915, not an HDMI one, and the tunnel was refused there (intel_dv_lab_native_hdmi()).
+ * Nothing in this header touches hardware or the kernel: the host test runs it as it is.
+ *
+ * What a converter does with the bytes is not in the standard: it turns DisplayPort InfoFrame
+ * SDPs into HDMI InfoFrames in its own way, and a converter that does not carry the Dolby vendor
+ * InfoFrame leaves the display without Dolby Vision, or without a picture. So the tunnel goes
+ * through one only where somebody has seen it work on that board (the list below), or where the
+ * user asks for it (the module parameter dv_pcon, or Kodi's setting, which reads
+ * DVBRIDGE_DV_CONVERTER): the default is to refuse, as before.
+ *
+ * The idea, and the first board, are from YBLOD (github.com/dangerouslaser/libreelec-yblod,
+ * linux-9930: "Standard Dolby Vision through an onboard DP-to-HDMI protocol converter", verified
+ * there on an INUSUAL INUC 11i5FL with a Sony Bravia 7, 4K23.976 and 4K59.94). The code is
+ * Hades' own.
+ */
+#ifndef __INTEL_DV_PCON_POLICY_H__
+#define __INTEL_DV_PCON_POLICY_H__
+
+#include <linux/types.h>
+#include <linux/string.h>
+
+/*
+ * DVBRIDGE_DV_CONVERTER, what the connector says of the converter behind it (read only; the
+ * values are the enum of the property):
+ */
+enum intel_dv_pcon_verdict {
+	/* no converter behind this port that the tunnel takes (a display on a plain DisplayPort port, an
+	 * HDMI sink without a converter's branch device, a converter that may go to FRL), or the
+	 * parameter dv_pcon is 0 */
+	INTEL_DV_PCON_NONE,
+	/* a converter that nobody has seen carry the Dolby vendor InfoFrame: user space that asks
+	 * for it gets it, and takes the risk (Kodi: "Dolby Vision through a display converter: On") */
+	INTEL_DV_PCON_UNLISTED,
+	/* the board is on the list below: seen working (Kodi: Automatic uses it) */
+	INTEL_DV_PCON_LISTED,
+	/* dv_pcon=1: the user took every converter as verified on the kernel command line */
+	INTEL_DV_PCON_FORCED,
+	INTEL_DV_PCON_COUNT
+};
+
+static inline const char *intel_dv_pcon_verdict_name(enum intel_dv_pcon_verdict v)
+{
+	switch (v) {
+	case INTEL_DV_PCON_NONE:
+		return "none";
+	case INTEL_DV_PCON_UNLISTED:
+		return "unlisted";
+	case INTEL_DV_PCON_LISTED:
+		return "listed";
+	case INTEL_DV_PCON_FORCED:
+		return "forced";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * The boards where the tunnel through the converter was seen working with a display. Matched on
+ * the DMI board vendor (a substring) and the DMI board name (exact). To add one: a line here with
+ * where it was seen (the board, the display, the modes), and the same in the Hades documents.
+ */
+struct intel_dv_pcon_board {
+	const char *vendor;
+	const char *board;
+	const char *seen;
+};
+
+static const struct intel_dv_pcon_board intel_dv_pcon_boards[] = {
+	{
+		.vendor = "Intel Corporation",
+		.board = "CM11EBV58W",
+		.seen = "INUSUAL INUC 11i5FL (Tiger Lake), Sony Bravia 7, 4K23.976 and 4K59.94 (YBLOD 0.3.4)",
+	},
+	{ NULL, NULL, NULL },
+};
+
+/* The entry of the list for this board, NULL when it is not on it (either string may be NULL) */
+static inline const struct intel_dv_pcon_board *intel_dv_pcon_board_listed(const char *vendor,
+									  const char *board)
+{
+	const struct intel_dv_pcon_board *b;
+
+	if (!vendor || !board)
+		return NULL;
+	for (b = intel_dv_pcon_boards; b->vendor; b++)
+		if (strstr(vendor, b->vendor) && !strcmp(board, b->board))
+			return b;
+	return NULL;
+}
+
+/*
+ * A port can carry the tunnel through a converter at all: the property is attached to its
+ * DisplayPort connector only then (decided once, at the start of the driver). param is dv_pcon:
+ * -1 the list of boards decides, 0 off, 1 any converter is taken as verified.
+ */
+static inline bool intel_dv_pcon_candidate(unsigned int display_ver, bool dv_lab, int param,
+					   bool edp, bool vbt_lspcon, bool vbt_hdmi)
+{
+	/* an LSPCON (a VBT flag, the NUC7 level-shifter and the like) has its own way: not this one */
+	return dv_lab && display_ver >= 11 && param != 0 && !edp && !vbt_lspcon && vbt_hdmi;
+}
+
+/*
+ * What the connector says of the converter behind it, from what detect found. route: the sink is
+ * an HDMI sink behind a DisplayPort branch device of the HDMI type, and that converter cannot go
+ * to FRL (what the tunnel was seen through is TMDS). listed: the board is on the list.
+ */
+static inline enum intel_dv_pcon_verdict intel_dv_pcon_verdict(int param, bool route, bool listed)
+{
+	if (!route || param == 0)
+		return INTEL_DV_PCON_NONE;
+	if (listed)
+		return INTEL_DV_PCON_LISTED;
+	return param > 0 ? INTEL_DV_PCON_FORCED : INTEL_DV_PCON_UNLISTED;
+}
+
+/* Why the verdict is what it is, for the kernel log; the strings are short sentences. */
+static inline const char *intel_dv_pcon_verdict_why(enum intel_dv_pcon_verdict v)
+{
+	switch (v) {
+	case INTEL_DV_PCON_NONE:
+		return "no DisplayPort to HDMI converter that the tunnel takes behind this port";
+	case INTEL_DV_PCON_UNLISTED:
+		return "this board is not on the list of those where the converter was seen carrying it: offered to user space that asks for it (dv_pcon=1 takes every converter as verified)";
+	case INTEL_DV_PCON_LISTED:
+		return "this board is on the list of those where the converter was seen carrying it";
+	case INTEL_DV_PCON_FORCED:
+		return "dv_pcon=1: every converter is taken as verified (experimental: an unverified converter may show no picture)";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * Whether a request of the tunnel passes the converter test of the policy: the verdict is not NONE.
+ * (The rest of what the tunnel needs is intel_dv_lab_validate()'s: RGB at 8 bits, full range, no HDR
+ * metadata, a mode in its list, a sink that takes it.)
+ */
+static inline bool intel_dv_pcon_takes(enum intel_dv_pcon_verdict v)
+{
+	return v != INTEL_DV_PCON_NONE;
+}
+
+/* Low-Latency and the HDMI 1.4b signalling were not seen through a converter: never asked for there */
+static inline bool intel_dv_pcon_signalling_ok(bool low_latency, bool hdmi14b)
+{
+	return !low_latency && !hdmi14b;
+}
+
+#endif
