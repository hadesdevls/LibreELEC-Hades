From 13a994cc6e390be4bedb5f3ee412be5647ea309a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:34:55 +0000
Subject: [PATCH] drm/amd/display: HDR in YCbCr 4:2:2 at 12 bits where RGB
 would leave at 8

linux-9969 sends HDR (PQ or HLG) over TMDS HDMI in YCbCr 4:2:0 at 10
bits or more where RGB fits at 8 bits only (2160p50 and 2160p60 at 594
MHz), on sinks that take the mode in 4:2:0 with deep colour in 4:2:0.
amdgpu can send YCbCr 4:2:2 there instead, which keeps more of the
picture at the same clock, and this tries it first.

What Linux 7.2.11 does with YCbCr 4:2:2 over HDMI on DCN, as read:
- the output formatter subsamples the chroma horizontally with the same
  filter as for 4:2:0 (FMT_SUBSAMPLING_MODE 2 for both in
  opp1_set_pixel_encoding(), with the extra left edge pixel of
  opp2_get_left_edge_extra_pixel_count() for both); 4:2:0 also halves
  the chroma vertically, 4:2:2 does not;
- the HDMI stream encoders send 4:2:2 at 10 or 12 bits without deep
  colour packing (HDMI_DEEP_COLOR_ENABLE 0, enc1, enc3 and enc401
  hdmi_set_stream_attribute()), as HDMI carries it: 12 bits per
  component in the 24-bit pixel of RGB at 8 bits;
- so its TMDS clock is the pixel clock at any depth (get_norm_pix_clk()
  leaves 4:2:2 at the pixel clock), the clock of RGB at 8 bits that the
  link already carries; scrambling above 340 MHz follows from it;
- set_avi_info_frame() signals Y = 4:2:2, and get_output_color_space()
  gives BT.2020 YCbCr for HDR, as for 4:2:0.

A sink that takes YCbCr 4:2:2 (bit 4 of byte 3 of its CTA extension,
DRM_COLOR_FORMAT_YCBCR422) takes it in every video format, and no deep
colour flag of the sink is involved. DCE subsamples 4:2:2 without the
filter (set_pixel_encoding() of dce_opp.c leaves FMT_SUBSAMPLING_MODE at
0), so the rule is for DCN only; DCE keeps 4:2:0 as before. DCN 3.1 and
3.1.5 (Rembrandt, Raphael, Mendocino) set no_native422_support, and
link_validate_mode_timing() refuses 4:2:2 over HDMI there (HDMI 2.1a
7.7.1: DSC without native 4:2:2): they keep 4:2:0 as before too.

What changes for the picture: the video is YCbCr 4:2:0, which Kodi
upsamples to draw it in RGB. In 4:2:0 out, the display core halves the
chroma vertically again and the sink upsamples it again; in 4:2:2 the
chroma of every line goes out as drawn, and what is drawn over the
video (menus, subtitles) keeps it too. 4:2:2 goes out at 12 bits where
max bpc lets it (it does by default on amdgpu), 4:2:0 at 10 or 12 as
the sink's 4:2:0 deep colour allows. Neither loses anything of the
10-bit video. What a sink does inside with each format cannot be read
from here.

The rule is drm_dvbridge_hdr422_try() in drm_dvbridge_hdr.h, beside
the one of 4:2:0, with its reasons for the kernel log
(drm_dvbridge_hdr422_why_not()): HDR metadata with PQ or HLG, not the
Dolby Vision tunnel, DVBRIDGE_HDR_YCBCR420 not "never", RGB computed
below 10 bits, max bpc 10 or more, an HDMI sink over TMDS, a DCN output,
a sink that takes 4:2:2, and the pixel clock within the sink's TMDS
limit. dm_hdr_ycbcr420() sets the 4:2:2 timing itself (12 bits, or 10
with max bpc 10 or 11): adjust_colour_depth_from_display_info() counts
deep colour packing, which HDMI does not use for 4:2:2, and would lower
it. DC validates the stream as any other. A stream of HDR in 4:2:2 that it
refuses, for any reason, is made again at the same max bpc without
4:2:2 (create_validate_stream_for_sink(), with a flag of the connector
that it clears again; not a 4:2:2 forced in debugfs or by the DP
fallback): 4:2:0 and RGB then come exactly as they did without this
change. Otherwise 4:2:0 is tried as before.
DVBRIDGE_HDR_YCBCR420 keeps its name and values: "deep" covers both,
"never" turns both off. DVBRIDGE_LINK_FORMAT reports "ycbcr422" and
"12bpc", which Kodi shows, and the kernel log of a refusal of the HDR10
depth guard also says why 4:2:2 was not sent.

i915 has no YCbCr 4:2:2 output (enum intel_output_format: RGB, 4:2:0,
4:4:4): it keeps 4:2:0.

Thanks to CroqueMr's Dolby Vision fork (libreelec-x86-DV), whose
linux-9920 sends HDR10 in 4:2:2 on amdgpu, for the idea.

Ported to Linux 7.3. linux-9969 on 7.3 makes the rule an order of the
enumeration of amdgpu_dm_create_validate_stream_for_sink() (7.3 chooses the
encoding there, from RGB down, and keeps the choice on the stack), with the
streams of the rule built and validated by dm_hdr_ycbcr_stream(). YCbCr
4:2:2 is its first candidate: the same inputs and test
(amdgpu_dm_hdr422_input(), drm_dvbridge_hdr422_try()) on the first RGB
stream of the enumeration, the stream built in 4:2:2 at max bpc, and its
depth set to 12 bits (10 with max bpc 10 or 11), as 7.2 set it in
fill_stream_properties_from_drm_display_mode(): nothing that 7.3's
create_stream_for_sink() builds for HDMI over TMDS after that function
depends on the depth. A 4:2:2 stream that DC refuses is released and the
4:2:0 candidates follow, then RGB: what 7.2 did by setting
aconnector->dvbridge_no_hdr422 and making the stream again at the same max
bpc. That field is gone, as 7.3 writes no shared connector state there; so
are the hunks of fill_stream_properties_from_drm_display_mode() and of the
old retry. The 4:2:2 stream passes the same checks as any stream of the
enumeration. What 7.2.11 did with 4:2:2 and that this relies on is the
same in 7.3: get_norm_pix_clk() leaves 4:2:2 at the pixel clock,
set_avi_info_frame(), the formatter of dcn10_opp.c and the HDMI stream
encoders of DCN 1, 3 and 4.0.1 do not differ from 7.2.12 (dcn20_opp.c
changes only in its test patterns), and link_validate_mode_timing() still
refuses 4:2:2 over HDMI on DCN 3.1 and 3.1.5 (no_native422_support).
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h | 11 +++
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 89 +++++++++++++++++--
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 14 ++-
 include/drm/drm_dvbridge_hdr.h                | 71 ++++++++++++++-
 4 files changed, 175 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 55b500e..5daf670 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1118,6 +1118,17 @@ unsigned int amdgpu_dm_dvbridge_depth_bpc(enum dc_color_depth depth);
 
 /* Hades: amdgpu_dm_connector.c, HDR in YCbCr 4:2:0 at 10 bits or more (drm_dvbridge_hdr.h) */
 struct drm_dvbridge_hdr420;
+struct drm_dvbridge_hdr422;
+struct dc_crtc_timing;
+struct dc_stream_state;
+/* ... and in YCbCr 4:2:2 (linux-9972) */
+void amdgpu_dm_hdr422_input(const struct drm_connector *connector,
+			    const struct drm_connector_state *connector_state,
+			    const struct dc_crtc_timing *timing, enum signal_type signal,
+			    unsigned int bpc, int requested_bpc, bool source,
+			    struct drm_dvbridge_hdr422 *s);
+/* The output of the stream sends YCbCr 4:2:2 with its chroma filter (linux-9972) */
+bool amdgpu_dm_hdr422_source(const struct dc_stream_state *stream);
 void amdgpu_dm_hdr420_input(const struct drm_connector *connector,
 			    const struct drm_connector_state *connector_state,
 			    const struct drm_display_mode *mode, enum signal_type signal,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 70ee597..51fe7e2 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -912,6 +912,49 @@ void amdgpu_dm_hdr420_input(const struct drm_connector *connector,
 	};
 }
 
+/*
+ * Hades (linux-9972): the inputs of the HDR 4:2:2 rule (drm_dvbridge_hdr.h) for a stream timing of
+ * the connector, as computed (bpc), over TMDS HDMI. The gate of the depth is max bpc
+ * (requested_bpc, as amdgpu_dm_create_validate_stream_for_sink() has it): deep colour of the sink
+ * does not come into 4:2:2, which HDMI always carries at 12 bits. source: amdgpu_dm_hdr422_source().
+ */
+/*
+ * Hades (linux-9972): DCN subsamples YCbCr 4:2:2 with the horizontal chroma filter of its output
+ * formatter (opp1_set_pixel_encoding(): FMT_SUBSAMPLING_MODE 2, as for 4:2:0); DCE without one
+ * (set_pixel_encoding() of dce_opp.c leaves FMT_SUBSAMPLING_MODE at 0). DCN 3.1 and 3.1.5 do not
+ * send 4:2:2 over HDMI at all (dc->config.no_native422_support: link_validate_mode_timing()
+ * refuses it, by HDMI 2.1a 7.7.1, as they have DSC without native 4:2:2).
+ */
+bool amdgpu_dm_hdr422_source(const struct dc_stream_state *stream)
+{
+	return stream->ctx->dce_version >= DCN_VERSION_1_0 &&
+	       !stream->ctx->dc->config.no_native422_support;
+}
+
+void amdgpu_dm_hdr422_input(const struct drm_connector *connector,
+			    const struct drm_connector_state *connector_state,
+			    const struct dc_crtc_timing *timing, enum signal_type signal,
+			    unsigned int bpc, int requested_bpc, bool source,
+			    struct drm_dvbridge_hdr422 *s)
+{
+	const struct drm_display_info *info = &connector->display_info;
+	const struct dm_connector_state *dm_state = to_dm_connector_state(connector_state);
+
+	*s = (struct drm_dvbridge_hdr422) {
+		.never = dm_state->dvbridge_hdr_ycbcr420 == DRM_DVBRIDGE_HDR_YCBCR420_NEVER,
+		.hdr = drm_dvbridge_hdr_output(connector_state),
+		.dv_tunnel = dm_state->dvbridge_dv_standard,
+		.hdmi_sink = signal == SIGNAL_TYPE_HDMI_TYPE_A && info->is_hdmi,
+		.source = source,
+		.sink = info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422),
+		.rgb = timing->pixel_encoding == PIXEL_ENCODING_RGB,
+		.bpc = bpc,
+		.max_bpc = requested_bpc > 0 ? requested_bpc : 0,
+		.clock = timing->pix_clk_100hz / 10,
+		.max_tmds = info->max_tmds_clock > 0 ? info->max_tmds_clock : 0,
+	};
+}
+
 /*
  * DOC: HDMI 3D
  *
@@ -2881,11 +2924,15 @@ static enum dc_status dm_hdr_validate_stream(struct amdgpu_device *adev,
 /*
  * Hades: HDR video where RGB over TMDS, as the first RGB stream of
  * amdgpu_dm_create_validate_stream_for_sink() has it (adjust_colour_depth_from_display_info()
- * fitted its depth), leaves below 10 bits per component: YCbCr 4:2:0 at the depth it gets, if that
- * is 10 or more (drm_dvbridge_hdr.h; i915 follows the same rule). The depth starts from what the
- * sink takes in 4:2:0 and max bpc, as for a mode the sink takes in 4:2:0 only, and goes down until
- * the TMDS clock fits. DC validates the stream as any other: a 4:2:0 stream that it refuses at
- * this depth is tried again with a lower max bpc, down to where the rule no longer applies. Not
+ * fitted its depth), leaves below 10 bits per component: YCbCr 4:2:2 at 12 bits where the output
+ * and the sink take it (linux-9972, the depth set here: adjust_colour_depth_from_display_info()
+ * counts deep colour packing, which HDMI does not use for 4:2:2); otherwise YCbCr 4:2:0 at the
+ * depth it gets, if that is 10 or more (drm_dvbridge_hdr.h; i915 follows the same rule). The depth
+ * of 4:2:0 starts from what the sink takes in 4:2:0 and max bpc, as for a mode the sink takes in
+ * 4:2:0 only, and goes down until the TMDS clock fits. DC validates each stream as any other: a
+ * 4:2:2 stream that it refuses leaves 4:2:0 and RGB to come as without 4:2:2, and a 4:2:0 stream
+ * that it refuses at this depth is tried again with a lower max bpc, down to where the rule no
+ * longer applies. Not
  * for a format forced in debugfs or named by the color format property. The candidates live on
  * the stack, as those of the enumeration do: no connector state changes. NULL: the enumeration
  * goes on with the RGB stream, as without this rule.
@@ -2903,6 +2950,7 @@ dm_hdr_ycbcr_stream(struct drm_connector *connector, const struct drm_display_mo
 	const int edid_bpc = connector->display_info.bpc ? connector->display_info.bpc : 8;
 	struct dc_stream_state *stream;
 	struct drm_dvbridge_hdr420 s;
+	struct drm_dvbridge_hdr422 s422;
 	enum dc_status dc_result;
 	int bpc;
 
@@ -2910,6 +2958,37 @@ dm_hdr_ycbcr_stream(struct drm_connector *connector, const struct drm_display_mo
 	    connector_state->color_format != DRM_CONNECTOR_COLOR_FORMAT_AUTO)
 		return NULL;
 
+	/*
+	 * Hades (linux-9972): YCbCr 4:2:2 first. Its TMDS clock is the pixel clock, the one of RGB at
+	 * 8 bits that the link already carries.
+	 */
+	amdgpu_dm_hdr422_input(connector, connector_state, &rgb->timing, rgb->signal, rgb_bpc,
+			       requested_bpc, amdgpu_dm_hdr422_source(rgb), &s422);
+	if (drm_dvbridge_hdr422_try(&s422)) {
+		const unsigned int bpc422 = drm_dvbridge_hdr422_bpc(s422.max_bpc);
+
+		stream = create_stream_for_sink(connector, drm_mode, dm_state, old_stream, bpc422,
+						PIXEL_ENCODING_YCBCR422, is_hdmi_ep);
+		if (!stream)
+			return NULL;
+		stream->timing.display_color_depth = bpc422 >= 12 ? COLOR_DEPTH_121212 :
+								     COLOR_DEPTH_101010;
+		dc_result = dm_hdr_validate_stream(adev, connector_state, stream);
+		if (dc_result == DC_OK) {
+			drm_dbg_kms(connector->dev,
+				    "[CONNECTOR:%d:%s] HDR goes out in YCbCr 4:2:2 at %u bpc: RGB would be %u bpc\n",
+				    connector->base.id, connector->name, bpc422, rgb_bpc);
+			return stream;
+		}
+		drm_dbg_kms(connector->dev,
+			    "[CONNECTOR:%d:%s] HDR in YCbCr 4:2:2 refused (%s): made again without it\n",
+			    connector->base.id, connector->name, dc_status_to_str(dc_result));
+		dc_stream_release(stream);
+	} else if (s422.hdr && s422.rgb && rgb_bpc < 10) {
+		drm_dbg_kms(connector->dev, "[CONNECTOR:%d:%s] HDR not in YCbCr 4:2:2: %s\n",
+			    connector->base.id, connector->name, drm_dvbridge_hdr422_why_not(&s422));
+	}
+
 	amdgpu_dm_hdr420_input(connector, connector_state, drm_mode, rgb->signal,
 			       rgb->timing.pixel_encoding, rgb_bpc, requested_bpc, &s);
 	if (!drm_dvbridge_hdr420_try(&s)) {
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 14663e6..d3e7cb8 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -493,9 +493,10 @@ int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
 		const struct drm_crtc_state *crtc_state;
 		const struct dc_stream_state *stream;
 		struct drm_dvbridge_hdr420 s;
+		struct drm_dvbridge_hdr422 s422;
 		unsigned int bpc;
 		const char *why;
-		char detail[448];
+		char detail[512];
 		size_t len;
 
 		if (connector->connector_type != DRM_MODE_CONNECTOR_HDMIA || !con_state->crtc ||
@@ -528,8 +529,15 @@ int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state)
 				       stream->timing.pixel_encoding, bpc, con_state->max_requested_bpc,
 				       &s);
 		why = drm_dvbridge_hdr420_why_not(&s);
-		scnprintf(detail + len, sizeof(detail) - len, "; YCbCr 4:2:0: %s",
-			  why ? why : "does not reach 10 bpc on this link");
+		len += scnprintf(detail + len, sizeof(detail) - len, "; YCbCr 4:2:0: %s",
+				 why ? why : "does not reach 10 bpc on this link");
+		/* ... and why not YCbCr 4:2:2 (linux-9972) */
+		amdgpu_dm_hdr422_input(connector, con_state, &stream->timing, stream->signal, bpc,
+				       con_state->max_requested_bpc,
+				       amdgpu_dm_hdr422_source(stream), &s422);
+		why = drm_dvbridge_hdr422_why_not(&s422);
+		scnprintf(detail + len, sizeof(detail) - len, "; YCbCr 4:2:2: %s",
+			  why ? why : "refused by the display core for this stream");
 		amdgpu_dm_dvbridge_refused(aconn, REFUSED(HDR10_DEPTH), detail);
 		return -EINVAL;
 	}
diff --git a/include/drm/drm_dvbridge_hdr.h b/include/drm/drm_dvbridge_hdr.h
index b24ed9d..7a1fe2d 100644
--- a/include/drm/drm_dvbridge_hdr.h
+++ b/include/drm/drm_dvbridge_hdr.h
@@ -38,9 +38,12 @@
 #include <linux/types.h>
 #include <linux/hdmi.h>
 
-/* The values of DVBRIDGE_HDR_YCBCR420 */
+/*
+ * The values of DVBRIDGE_HDR_YCBCR420 (Hades, linux-9972: the name stays; "deep" also covers
+ * YCbCr 4:2:2, where the driver sends it, drm_dvbridge_hdr422_try())
+ */
 enum drm_dvbridge_hdr_ycbcr420 {
-	/* HDR in YCbCr 4:2:0 at 10 bits or more where RGB would have fewer: the default */
+	/* HDR in YCbCr at 10 bits or more where RGB would have fewer (4:2:2 or 4:2:0): the default */
 	DRM_DVBRIDGE_HDR_YCBCR420_DEEP,
 	/* never for that: the driver chooses as without this rule */
 	DRM_DVBRIDGE_HDR_YCBCR420_NEVER,
@@ -128,6 +131,70 @@ static inline bool drm_dvbridge_hdr420_keep(unsigned int rgb_bpc, unsigned int y
 	return ycbcr420_bpc >= 10 && ycbcr420_bpc > rgb_bpc;
 }
 
+/*
+ * Hades (linux-9972): HDR in YCbCr 4:2:2 where the driver sends 4:2:2 with a horizontal chroma
+ * filter (amdgpu on DCN), tried before 4:2:0. HDMI carries YCbCr 4:2:2 in the 24-bit pixel of
+ * RGB at 8 bits, with 12 bits per component and no deep colour packing: its TMDS clock is the
+ * pixel clock at any depth, so the link that carried RGB at 8 bits carries 4:2:2 at 12. A sink
+ * that takes YCbCr 4:2:2 (DRM_COLOR_FORMAT_YCBCR422, from its CTA extension) takes it in every
+ * video format; no deep colour of the sink is involved. 4:2:2 keeps the chroma of every line of
+ * what is drawn, where 4:2:0 halves it vertically; both halve it horizontally with the same
+ * filter on DCN. The depth is 12 bits where max bpc lets it, 10 otherwise.
+ */
+struct drm_dvbridge_hdr422 {
+	bool never;		/* DVBRIDGE_HDR_YCBCR420 is "never" */
+	bool hdr;		/* drm_dvbridge_hdr_eotf() of the connector state's HDR metadata */
+	bool dv_tunnel;		/* the Dolby Vision tunnel is requested on the connector */
+	bool hdmi_sink;		/* an HDMI sink (not DVI), over TMDS */
+	bool source;		/* the output sends YCbCr 4:2:2 here, with its chroma filter */
+	bool sink;		/* the sink takes YCbCr 4:2:2 */
+	bool rgb;		/* the configuration computed sends RGB */
+	unsigned int bpc;	/* ... at this many bits per component */
+	unsigned int max_bpc;	/* the most bits per component the connector state lets through */
+	unsigned int clock;	/* the pixel clock in kHz: the TMDS clock of 4:2:2 at any depth */
+	unsigned int max_tmds;	/* the TMDS clock the sink takes, kHz (0: not known) */
+};
+
+/* Whether HDR goes out in YCbCr 4:2:2 (drm_dvbridge_hdr422_why_not()) */
+static inline bool drm_dvbridge_hdr422_try(const struct drm_dvbridge_hdr422 *s)
+{
+	return s->hdr && !s->dv_tunnel && !s->never && s->rgb && s->bpc < 10 &&
+	       s->max_bpc >= 10 && s->hdmi_sink && s->source && s->sink && s->max_tmds &&
+	       s->clock <= s->max_tmds;
+}
+
+/* Why it does not: the first test that fails, for the kernel log; NULL exactly when it does */
+static inline const char *drm_dvbridge_hdr422_why_not(const struct drm_dvbridge_hdr422 *s)
+{
+	if (!s->hdr)
+		return "no HDR metadata with the PQ or HLG transfer function";
+	if (s->dv_tunnel)
+		return "the Dolby Vision tunnel is requested";
+	if (s->never)
+		return "DVBRIDGE_HDR_YCBCR420 is never";
+	if (!s->rgb)
+		return "the output is not RGB";
+	if (s->bpc >= 10)
+		return "RGB goes out at 10 bits or more";
+	if (s->max_bpc < 10)
+		return "max bpc is below 10 bits";
+	if (!s->hdmi_sink)
+		return "the sink is not an HDMI sink over TMDS";
+	if (!s->source)
+		return "this output does not send YCbCr 4:2:2 here";
+	if (!s->sink)
+		return "the sink does not take YCbCr 4:2:2";
+	if (!s->max_tmds || s->clock > s->max_tmds)
+		return "the pixel clock is above the TMDS clock the sink takes";
+	return NULL;
+}
+
+/* The depth of YCbCr 4:2:2: 12 bits, the most HDMI carries in it, where max bpc lets it */
+static inline unsigned int drm_dvbridge_hdr422_bpc(unsigned int max_bpc)
+{
+	return max_bpc >= 12 ? 12 : 10;
+}
+
 /* The bits of DVBRIDGE_LINK_FORMAT: one format, and one depth */
 enum drm_dvbridge_link {
 	DRM_DVBRIDGE_LINK_RGB,
-- 
2.53.0

