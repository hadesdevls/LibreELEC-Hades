From cb51d591ebd2d0466473f5fcf653c39be27e3752 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:15:47 +0000
Subject: [PATCH] video/hdmi: the Dolby Vision vendor InfoFrame, written for
 Hades

drivers/video/hdmi.c and include/linux/hdmi.h get the Dolby Vision
vendor-specific InfoFrame: the OUI 00-D0-46 and its payload size (27),
struct hdmi_dolby_vendor_infoframe, hdmi_dolby_vendor_infoframe_init(),
_check() and _pack(), and the frame in union hdmi_vendor_any_infoframe,
so that hdmi_infoframe_pack(), _pack_only(), _unpack() and _log() take
it. The Dolby Vision tunnel of i915 and xe and of amdgpu sends it, and
i915 reads it back to compare its state.

Why: these functions came with CroqueMr's Dolby Vision fork of LibreELEC
(linux-9900-08-drivers__video__hdmi.c.patch and
linux-9900-09-include__linux__hdmi.h.patch), which added them to two
files under the permission notice of Avionic Design GmbH without a
licence statement or an author of their own. This patch replaces those
two with code written for LibreELEC Hades, under a stated licence. The
idea and the interface are the fork's: the Dolby frame as one more
vendor InfoFrame of this file, with the names, types and order of its
fields and the functions and arguments that the callers use, kept as
they were so that no caller changes. The code and its comments are new.

Licence: the code of this patch is offered under the permission notice
at the top of drivers/video/hdmi.c and include/linux/hdmi.h (Copyright
(C) 2012 Avionic Design GmbH; the MIT licence), the licence of the
files that it changes, so that both files stay under one licence. A
comment at the code says so in each file.

The layout: ETSI GS CCM 001 V1.1.1 defines the metadata that the
Dolby Vision signal carries in the picture (clause 6.4), not this
InfoFrame. The bytes are those that the GPL HDMI transmitter of Amlogic
fills (CoreELEC linux-amlogic, branch amlogic-5.4.210, a3aaaa5b0e64:
hdmitx_set_vsif_pkt() in
drivers/amlogic/media/vout/hdmitx/hdmi_tx_20/hdmi_tx_main.c and struct
dv_vsif_para in include/linux/amlogic/media/vout/vinfo.h), read as data:
PB4 low latency (bit 0) and the signal (bit 1); PB5 the high bits of
Eff_tmax_PQ (3-0) and the backlight, auxiliary and L11 flags (7, 6, 5);
PB6 the low byte of Eff_tmax_PQ; PB7-PB9 the auxiliary metadata;
PB10-PB13 L11; the rest zero. No code of Amlogic, of the fork or of any
other implementation is copied. Bits 5-7 of PB4, where Amlogic can put
the display management version of the source, stay zero, as before.

Behaviour: the same, measured. A host test builds the old and the new
drivers/video/hdmi.c, each with its own include/linux/hdmi.h, and links
them side by side: the same layout of the frame and of the unions; for
234,038,539 frames (every type with every version, every length, every
24-bit OUI; with each of the 32 combinations of the five flags, every
16-bit Eff_tmax_PQ, every auxiliary run mode with every run version,
every debug byte, every 8-bit value of each L11 field with the field
that shares its byte or follows it; 4,096 frames in buffers of 0 to 95
bytes; 200 million random frames) the same verdict of _check(), which
changes neither frame, and the same return value and bytes of _pack()
and of hdmi_infoframe_pack() and _pack_only() over the whole buffer;
for 320,499,442 buffers (every packed frame, every value of PB4 with
PB5, of each pair of payload bytes and of each byte of 64 frames, and
100 million random ones) the same return value of hdmi_infoframe_unpack()
and the same bytes of the union it fills; the HDMI vendor InfoFrame
unchanged. Fourteen mutations of the new code each make it fail. The
kernel log of hdmi_infoframe_log() names every field of a Dolby frame
now (it named five), and only that text differs.
---
 drivers/video/hdmi.c | 258 ++++++++++++++++++++++++++++++++++++++++++-
 include/linux/hdmi.h |  60 ++++++++++
 2 files changed, 316 insertions(+), 2 deletions(-)

diff --git a/drivers/video/hdmi.c b/drivers/video/hdmi.c
index 45b42f1..bc779b0 100644
--- a/drivers/video/hdmi.c
+++ b/drivers/video/hdmi.c
@@ -684,6 +684,245 @@ ssize_t hdmi_vendor_infoframe_pack(struct hdmi_vendor_infoframe *frame,
 }
 EXPORT_SYMBOL(hdmi_vendor_infoframe_pack);
 
+/*
+ * The Dolby Vision vendor-specific InfoFrame
+ *
+ * Written for LibreELEC Hades and offered under the permission notice at the top of this file.
+ *
+ * A vendor-specific InfoFrame (type 0x81, version 1) of 27 payload bytes with the IEEE OUI of
+ * Dolby Laboratories, 00-D0-46, in PB1-PB3. A source sends it with its Dolby Vision output; with
+ * the signal bit clear it says that the output is not Dolby Vision. The metadata of each frame
+ * is not in it: the picture carries it (ETSI GS CCM 001, clause 6.4). PB4-PB13 as the GPL HDMI
+ * transmitter of Amlogic fills them:
+ *
+ *	PB4	bit 0: low latency; bit 1: the Dolby Vision signal; bits 2-7: zero (in bits 5-7
+ *		Amlogic can put the display management version of the source; not here)
+ *	PB5	bits 0-3: bits 11-8 of Eff_tmax_PQ; bit 4: zero; bit 5: L11 metadata present;
+ *		bit 6: auxiliary metadata present; bit 7: backlight control metadata present
+ *	PB6	bits 7-0 of Eff_tmax_PQ
+ *	PB7-9	the auxiliary metadata: run mode, run version, debug byte
+ *	PB10	L11: content type (bits 0-3), content subtype (bits 4-7)
+ *	PB11	L11: intended white point (bits 0-3), the field that Amlogic calls crf (bits 4-7)
+ *	PB12-13	L11: its other two bytes
+ *	PB14-27	zero
+ *
+ * A field is zero unless its "present" flag announces it, and nothing is present without the
+ * signal: the frames that this file unpacks are exactly the frames that it packs.
+ */
+#define HDMI_DOLBY_FRAME_SIZE		HDMI_INFOFRAME_SIZE(DOLBY_VENDOR)
+/* where payload byte PB<n> is in a packed frame (the checksum, PB0, is byte 3) */
+#define HDMI_DOLBY_PB(n)		(HDMI_INFOFRAME_HEADER_SIZE - 1 + (n))
+
+#define HDMI_DOLBY_PB4_LOW_LATENCY	BIT(0)
+#define HDMI_DOLBY_PB4_SIGNAL		BIT(1)
+#define HDMI_DOLBY_PB5_TMAX_PQ_HIGH	GENMASK(3, 0)
+#define HDMI_DOLBY_PB5_UNUSED		BIT(4)
+#define HDMI_DOLBY_PB5_L11		BIT(5)
+#define HDMI_DOLBY_PB5_AUXILIARY	BIT(6)
+#define HDMI_DOLBY_PB5_BACKLIGHT	BIT(7)
+
+/* whether three bytes, the least significant first, are the OUI of Dolby */
+static bool hdmi_dolby_oui(const u8 *oui)
+{
+	return oui[0] == (HDMI_DOLBY_IEEE_OUI & 0xff) &&
+	       oui[1] == ((HDMI_DOLBY_IEEE_OUI >> 8) & 0xff) &&
+	       oui[2] == ((HDMI_DOLBY_IEEE_OUI >> 16) & 0xff);
+}
+
+/**
+ * hdmi_dolby_vendor_infoframe_init() - initialize a Dolby Vision vendor InfoFrame
+ * @frame: the frame
+ *
+ * Zeroes the frame, also between its fields (so that two frames with the same fields compare
+ * equal with memcmp()), and sets its header and OUI. The Dolby Vision signal is off.
+ */
+void hdmi_dolby_vendor_infoframe_init(struct hdmi_dolby_vendor_infoframe *frame)
+{
+	memset(frame, 0, sizeof(*frame));
+
+	frame->type = HDMI_INFOFRAME_TYPE_VENDOR;
+	frame->version = 1;
+	frame->length = HDMI_DOLBY_VENDOR_INFOFRAME_SIZE;
+	frame->oui = HDMI_DOLBY_IEEE_OUI;
+}
+EXPORT_SYMBOL(hdmi_dolby_vendor_infoframe_init);
+
+/**
+ * hdmi_dolby_vendor_infoframe_check() - check a Dolby Vision vendor InfoFrame
+ * @frame: the frame, which is not changed
+ *
+ * The header and the OUI must be those that hdmi_dolby_vendor_infoframe_init() sets, every
+ * field must fit its bits, the bytes of a metadata block may only be non-zero with its
+ * "present" flag, and low latency and the flags need the Dolby Vision signal. Whether the sink
+ * takes Dolby Vision is for the caller to know: a frame that passes enables nothing.
+ *
+ * Returns 0 on success or a negative error code on failure.
+ */
+int hdmi_dolby_vendor_infoframe_check(const struct hdmi_dolby_vendor_infoframe *frame)
+{
+	const unsigned int l11_nibbles = frame->content_type | frame->content_subtype |
+					 frame->intended_white_point | frame->crf;
+
+	if (frame->type != HDMI_INFOFRAME_TYPE_VENDOR || frame->version != 1 ||
+	    frame->length != HDMI_DOLBY_VENDOR_INFOFRAME_SIZE ||
+	    frame->oui != HDMI_DOLBY_IEEE_OUI)
+		return -EINVAL;
+
+	/* every field fits its bits */
+	if (frame->effective_tmax_pq > 0xfff || l11_nibbles > 0xf)
+		return -EINVAL;
+
+	/* low latency and the metadata blocks only with the signal */
+	if (!frame->signal && (frame->low_latency || frame->backlight_present ||
+			       frame->auxiliary_present || frame->l11_present))
+		return -EINVAL;
+
+	/* and the bytes of each block only with its flag */
+	if (!frame->backlight_present && frame->effective_tmax_pq)
+		return -EINVAL;
+	if (!frame->auxiliary_present &&
+	    (frame->auxiliary_runmode | frame->auxiliary_version | frame->auxiliary_debug))
+		return -EINVAL;
+	if (!frame->l11_present && (l11_nibbles | frame->l11_byte2 | frame->l11_byte3))
+		return -EINVAL;
+
+	return 0;
+}
+EXPORT_SYMBOL(hdmi_dolby_vendor_infoframe_check);
+
+/**
+ * hdmi_dolby_vendor_infoframe_pack() - check a Dolby Vision vendor InfoFrame and write it
+ * @frame: the frame
+ * @buffer: where to write it: the header, the checksum and the 27 payload bytes
+ * @size: the size of @buffer
+ *
+ * Writes the frame, with the checksum of section 5.3.5 of the HDMI 1.4 specification, and
+ * zeroes the rest of @buffer. On failure @buffer is not touched.
+ *
+ * Returns the number of bytes written (31) or a negative error code.
+ */
+ssize_t hdmi_dolby_vendor_infoframe_pack(const struct hdmi_dolby_vendor_infoframe *frame,
+					 void *buffer, size_t size)
+{
+	u8 *ptr = buffer;
+	int ret;
+
+	ret = hdmi_dolby_vendor_infoframe_check(frame);
+	if (ret)
+		return ret;
+
+	if (size < HDMI_DOLBY_FRAME_SIZE)
+		return -ENOSPC;
+
+	memset(buffer, 0, size);
+
+	ptr[0] = frame->type;
+	ptr[1] = frame->version;
+	ptr[2] = frame->length;
+	ptr[3] = 0; /* checksum */
+
+	/* the OUI, the least significant byte first */
+	ptr[HDMI_DOLBY_PB(1)] = HDMI_DOLBY_IEEE_OUI & 0xff;
+	ptr[HDMI_DOLBY_PB(2)] = (HDMI_DOLBY_IEEE_OUI >> 8) & 0xff;
+	ptr[HDMI_DOLBY_PB(3)] = (HDMI_DOLBY_IEEE_OUI >> 16) & 0xff;
+
+	ptr[HDMI_DOLBY_PB(4)] = (frame->low_latency ? HDMI_DOLBY_PB4_LOW_LATENCY : 0) |
+				(frame->signal ? HDMI_DOLBY_PB4_SIGNAL : 0);
+	ptr[HDMI_DOLBY_PB(5)] = (frame->effective_tmax_pq >> 8) |
+				(frame->l11_present ? HDMI_DOLBY_PB5_L11 : 0) |
+				(frame->auxiliary_present ? HDMI_DOLBY_PB5_AUXILIARY : 0) |
+				(frame->backlight_present ? HDMI_DOLBY_PB5_BACKLIGHT : 0);
+	ptr[HDMI_DOLBY_PB(6)] = frame->effective_tmax_pq & 0xff;
+	ptr[HDMI_DOLBY_PB(7)] = frame->auxiliary_runmode;
+	ptr[HDMI_DOLBY_PB(8)] = frame->auxiliary_version;
+	ptr[HDMI_DOLBY_PB(9)] = frame->auxiliary_debug;
+	ptr[HDMI_DOLBY_PB(10)] = frame->content_type | (frame->content_subtype << 4);
+	ptr[HDMI_DOLBY_PB(11)] = frame->intended_white_point | (frame->crf << 4);
+	ptr[HDMI_DOLBY_PB(12)] = frame->l11_byte2;
+	ptr[HDMI_DOLBY_PB(13)] = frame->l11_byte3;
+	/* PB14-PB27 stay zero */
+
+	hdmi_infoframe_set_checksum(buffer, HDMI_DOLBY_FRAME_SIZE);
+
+	return HDMI_DOLBY_FRAME_SIZE;
+}
+EXPORT_SYMBOL(hdmi_dolby_vendor_infoframe_pack);
+
+/*
+ * hdmi_dolby_vendor_infoframe_unpack() - read a Dolby Vision vendor InfoFrame
+ *
+ * Takes exactly the frames that hdmi_dolby_vendor_infoframe_pack() writes: its header, the OUI
+ * of Dolby and a good checksum, zero in every bit that the layout does not use, and fields that
+ * hdmi_dolby_vendor_infoframe_check() takes. @frame is only written on success.
+ */
+static int hdmi_dolby_vendor_infoframe_unpack(struct hdmi_dolby_vendor_infoframe *frame,
+					      const void *buffer, size_t size)
+{
+	struct hdmi_dolby_vendor_infoframe dv;
+	const u8 *ptr = buffer;
+	unsigned int i;
+
+	if (size < HDMI_DOLBY_FRAME_SIZE)
+		return -EINVAL;
+
+	if (ptr[0] != HDMI_INFOFRAME_TYPE_VENDOR || ptr[1] != 1 ||
+	    ptr[2] != HDMI_DOLBY_VENDOR_INFOFRAME_SIZE || !hdmi_dolby_oui(&ptr[HDMI_DOLBY_PB(1)]))
+		return -EINVAL;
+
+	if (hdmi_infoframe_checksum(buffer, HDMI_DOLBY_FRAME_SIZE) != 0)
+		return -EINVAL;
+
+	/* the bits that the layout does not use */
+	if ((ptr[HDMI_DOLBY_PB(4)] & ~(HDMI_DOLBY_PB4_LOW_LATENCY | HDMI_DOLBY_PB4_SIGNAL)) ||
+	    (ptr[HDMI_DOLBY_PB(5)] & HDMI_DOLBY_PB5_UNUSED))
+		return -EINVAL;
+	for (i = HDMI_DOLBY_PB(14); i < HDMI_DOLBY_FRAME_SIZE; i++)
+		if (ptr[i])
+			return -EINVAL;
+
+	hdmi_dolby_vendor_infoframe_init(&dv);
+
+	dv.low_latency = ptr[HDMI_DOLBY_PB(4)] & HDMI_DOLBY_PB4_LOW_LATENCY;
+	dv.signal = ptr[HDMI_DOLBY_PB(4)] & HDMI_DOLBY_PB4_SIGNAL;
+	dv.l11_present = ptr[HDMI_DOLBY_PB(5)] & HDMI_DOLBY_PB5_L11;
+	dv.auxiliary_present = ptr[HDMI_DOLBY_PB(5)] & HDMI_DOLBY_PB5_AUXILIARY;
+	dv.backlight_present = ptr[HDMI_DOLBY_PB(5)] & HDMI_DOLBY_PB5_BACKLIGHT;
+	dv.effective_tmax_pq = ((ptr[HDMI_DOLBY_PB(5)] & HDMI_DOLBY_PB5_TMAX_PQ_HIGH) << 8) |
+			       ptr[HDMI_DOLBY_PB(6)];
+	dv.auxiliary_runmode = ptr[HDMI_DOLBY_PB(7)];
+	dv.auxiliary_version = ptr[HDMI_DOLBY_PB(8)];
+	dv.auxiliary_debug = ptr[HDMI_DOLBY_PB(9)];
+	dv.content_type = ptr[HDMI_DOLBY_PB(10)] & 0xf;
+	dv.content_subtype = ptr[HDMI_DOLBY_PB(10)] >> 4;
+	dv.intended_white_point = ptr[HDMI_DOLBY_PB(11)] & 0xf;
+	dv.crf = ptr[HDMI_DOLBY_PB(11)] >> 4;
+	dv.l11_byte2 = ptr[HDMI_DOLBY_PB(12)];
+	dv.l11_byte3 = ptr[HDMI_DOLBY_PB(13)];
+
+	/* a block's bytes without its flag, or a flag without the signal */
+	if (hdmi_dolby_vendor_infoframe_check(&dv))
+		return -EINVAL;
+
+	*frame = dv;
+
+	return 0;
+}
+
+static void hdmi_dolby_vendor_infoframe_log(const char *level, struct device *dev,
+					    const struct hdmi_dolby_vendor_infoframe *frame)
+{
+	hdmi_log("    Dolby Vision: signal %u, low latency %u\n",
+		 frame->signal, frame->low_latency);
+	hdmi_log("    backlight control metadata %u: Eff_tmax_PQ %u\n",
+		 frame->backlight_present, frame->effective_tmax_pq);
+	hdmi_log("    auxiliary metadata %u: run mode %u, run version %u, debug %u\n",
+		 frame->auxiliary_present, frame->auxiliary_runmode, frame->auxiliary_version,
+		 frame->auxiliary_debug);
+	hdmi_log("    L11 metadata %u: content type %u, subtype %u, white point %u, crf %u, %u, %u\n",
+		 frame->l11_present, frame->content_type, frame->content_subtype,
+		 frame->intended_white_point, frame->crf, frame->l11_byte2, frame->l11_byte3);
+}
+
 static int
 hdmi_vendor_any_infoframe_check_only(const union hdmi_vendor_any_infoframe *frame)
 {
@@ -850,7 +1089,10 @@ hdmi_vendor_any_infoframe_check(union hdmi_vendor_any_infoframe *frame)
 	if (ret)
 		return ret;
 
-	/* we only know about HDMI vendor infoframes */
+	if (frame->any.oui == HDMI_DOLBY_IEEE_OUI)
+		return hdmi_dolby_vendor_infoframe_check(&frame->dolby);
+
+	/* other than Dolby's, we only know about HDMI vendor infoframes */
 	if (frame->any.oui != HDMI_IEEE_OUI)
 		return -EINVAL;
 
@@ -870,7 +1112,10 @@ hdmi_vendor_any_infoframe_pack_only(const union hdmi_vendor_any_infoframe *frame
 	if (ret)
 		return ret;
 
-	/* we only know about HDMI vendor infoframes */
+	if (frame->any.oui == HDMI_DOLBY_IEEE_OUI)
+		return hdmi_dolby_vendor_infoframe_pack(&frame->dolby, buffer, size);
+
+	/* other than Dolby's, we only know about HDMI vendor infoframes */
 	if (frame->any.oui != HDMI_IEEE_OUI)
 		return -EINVAL;
 
@@ -1496,6 +1741,11 @@ hdmi_vendor_any_infoframe_log(const char *level,
 	hdmi_infoframe_log_header(level, dev,
 				  (const struct hdmi_any_infoframe *)frame);
 
+	if (frame->any.oui == HDMI_DOLBY_IEEE_OUI) {
+		hdmi_dolby_vendor_infoframe_log(level, dev, &frame->dolby);
+		return;
+	}
+
 	if (frame->any.oui != HDMI_IEEE_OUI) {
 		hdmi_log("    not a HDMI vendor infoframe\n");
 		return;
@@ -1725,6 +1975,10 @@ hdmi_vendor_any_infoframe_unpack(union hdmi_vendor_any_infoframe *frame,
 	u8 hdmi_video_format;
 	struct hdmi_vendor_infoframe *hvf = &frame->hdmi;
 
+	/* the Dolby Vision vendor InfoFrame has a layout of its own */
+	if (size >= HDMI_DOLBY_PB(4) && hdmi_dolby_oui(&ptr[HDMI_DOLBY_PB(1)]))
+		return hdmi_dolby_vendor_infoframe_unpack(&frame->dolby, buffer, size);
+
 	if (size < HDMI_INFOFRAME_HEADER_SIZE)
 		return -EINVAL;
 
diff --git a/include/linux/hdmi.h b/include/linux/hdmi.h
index 8dab78e..2ffa82a 100644
--- a/include/linux/hdmi.h
+++ b/include/linux/hdmi.h
@@ -58,12 +58,14 @@ enum hdmi_infoframe_type {
 
 #define HDMI_IEEE_OUI 0x000c03
 #define HDMI_FORUM_IEEE_OUI 0xc45dd8
+#define HDMI_DOLBY_IEEE_OUI 0x00d046
 #define HDMI_INFOFRAME_HEADER_SIZE  4
 #define HDMI_AVI_INFOFRAME_SIZE    13
 #define HDMI_SPD_INFOFRAME_SIZE    25
 #define HDMI_AUDIO_INFOFRAME_SIZE  10
 #define HDMI_DRM_INFOFRAME_SIZE    26
 #define HDMI_VENDOR_INFOFRAME_SIZE  4
+#define HDMI_DOLBY_VENDOR_INFOFRAME_SIZE 27
 
 /*
  * HDMI 1.3a table 5-14 states that the largest InfoFrame_length is 27,
@@ -415,6 +417,63 @@ ssize_t hdmi_vendor_infoframe_pack_only(const struct hdmi_vendor_infoframe *fram
 					void *buffer, size_t size);
 int hdmi_vendor_infoframe_check(struct hdmi_vendor_infoframe *frame);
 
+/*
+ * The Dolby Vision vendor-specific InfoFrame (drivers/video/hdmi.c), written for LibreELEC Hades
+ * and offered under the permission notice at the top of this file.
+ */
+
+/**
+ * struct hdmi_dolby_vendor_infoframe - the Dolby Vision vendor-specific InfoFrame
+ * @type: HDMI_INFOFRAME_TYPE_VENDOR
+ * @version: 1
+ * @length: HDMI_DOLBY_VENDOR_INFOFRAME_SIZE
+ * @oui: HDMI_DOLBY_IEEE_OUI
+ * @signal: the output is Dolby Vision (PB4, bit 1)
+ * @low_latency: in its low-latency form (PB4, bit 0)
+ * @backlight_present: backlight control metadata, @effective_tmax_pq (PB5, bit 7)
+ * @auxiliary_present: auxiliary metadata, @auxiliary_runmode to @auxiliary_debug (PB5, bit 6)
+ * @l11_present: L11 metadata, @content_type to @l11_byte3 (PB5, bit 5)
+ * @effective_tmax_pq: Eff_tmax_PQ, 12 bits (PB5 bits 3-0, PB6)
+ * @auxiliary_runmode: PB7
+ * @auxiliary_version: PB8
+ * @auxiliary_debug: PB9
+ * @content_type: PB10, bits 3-0
+ * @content_subtype: PB10, bits 7-4
+ * @intended_white_point: PB11, bits 3-0
+ * @crf: PB11, bits 7-4
+ * @l11_byte2: PB12
+ * @l11_byte3: PB13
+ *
+ * Not the metadata of each frame of the video, which the Dolby Vision signal carries in the
+ * picture. hdmi_dolby_vendor_infoframe_check() says which frames can be sent.
+ */
+struct hdmi_dolby_vendor_infoframe {
+	enum hdmi_infoframe_type type;
+	unsigned char version;
+	unsigned char length;
+	unsigned int oui;
+	bool signal;
+	bool low_latency;
+	bool backlight_present;
+	bool auxiliary_present;
+	bool l11_present;
+	u16 effective_tmax_pq;
+	u8 auxiliary_runmode;
+	u8 auxiliary_version;
+	u8 auxiliary_debug;
+	u8 content_type;
+	u8 content_subtype;
+	u8 intended_white_point;
+	u8 crf;
+	u8 l11_byte2;
+	u8 l11_byte3;
+};
+
+void hdmi_dolby_vendor_infoframe_init(struct hdmi_dolby_vendor_infoframe *frame);
+int hdmi_dolby_vendor_infoframe_check(const struct hdmi_dolby_vendor_infoframe *frame);
+ssize_t hdmi_dolby_vendor_infoframe_pack(const struct hdmi_dolby_vendor_infoframe *frame,
+					 void *buffer, size_t size);
+
 union hdmi_vendor_any_infoframe {
 	struct {
 		enum hdmi_infoframe_type type;
@@ -423,6 +482,7 @@ union hdmi_vendor_any_infoframe {
 		unsigned int oui;
 	} any;
 	struct hdmi_vendor_infoframe hdmi;
+	struct hdmi_dolby_vendor_infoframe dolby;
 };
 
 /**
