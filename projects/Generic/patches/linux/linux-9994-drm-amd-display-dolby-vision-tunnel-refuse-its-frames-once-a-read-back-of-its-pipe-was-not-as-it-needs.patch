 		drm_warn(crtc->dev,
-			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: no memory for the read back of its pipes; the tunnel is refused from now on\n",
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: no memory for the read back of its pipes; " DVBRIDGE_READBACK_REFUSED "\n",
