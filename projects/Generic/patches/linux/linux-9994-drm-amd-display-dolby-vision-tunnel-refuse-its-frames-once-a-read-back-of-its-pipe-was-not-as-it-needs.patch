--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1976,6 +1976,35 @@ bool amdgpu_dm_dvbridge_stream_dcn42(const struct dc_stream_state *stream)
 			  stream->ctx->dce_version == DCN_VERSION_4_2B);
 }
 
+/*
+ * Hades: the verdict of a read back of the pipe of a tunnel (DCE: amdgpu_dm_dvbridge_log_dce(),
+ * DCN 4.2 and 4.2B: amdgpu_dm_dvbridge_log_dcn42()), made once the commit that turned the tunnel
+ * on has gone out. One that was not as the tunnel needs, or that could not be made, refuses the
+ * tunnel from then on (amdgpu_dm_dvbridge_readback_refuses()), until the driver is loaded again.
+ */
+#define DVBRIDGE_READBACK_REFUSED \
+	"every commit of the tunnel is refused from now on, its frames among them, until the driver is loaded again: the video goes on in the ordinary output"
+
+void amdgpu_dm_dvbridge_readback_verdict(struct amdgpu_display_manager *dm, bool as_needed)
+{
+	if (!as_needed)
+		WRITE_ONCE(dm->dvbridge_readback_failed, true);
+}
+
+/*
+ * Hades: after such a verdict, every commit whose active stream carries the tunnel is refused:
+ * the frames of the video playing (each commits the primary plane, which brings its CRTC into
+ * the commit, drm_atomic_get_plane_state()), so that user space leaves the tunnel in that same
+ * video, and any commit that would turn it on again. A commit that turns it off, whose stream no
+ * longer carries it, is not refused: that is the way out.
+ */
+bool amdgpu_dm_dvbridge_readback_refuses(const struct amdgpu_display_manager *dm, bool active,
+					 const struct dc_stream_state *stream)
+{
+	return active && amdgpu_dm_dvbridge_stream_active(stream) &&
+	       READ_ONCE(dm->dvbridge_readback_failed);
+}
+
 /* Refuse colour processing and compositing: never bypass a user setting silently. */
 int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 				     struct drm_crtc *crtc,
@@ -1991,6 +2020,10 @@ int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 
 	if (!crtc_state->active || !amdgpu_dm_dvbridge_stream_active(stream))
 		return 0;
+	/* Hades: a read back that was not as the tunnel needs (amdgpu_dm_dvbridge_readback_refuses()) */
+	if (amdgpu_dm_dvbridge_readback_refuses(&drm_to_adev(crtc->dev)->dm, crtc_state->active,
+						stream))
+		return -EINVAL;
 	w = stream->timing.h_addressable;
 	h = stream->timing.v_addressable;
 
@@ -2364,10 +2397,13 @@ bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *r
  * (amdgpu_dm_dvbridge_dce_readback_why()); also the mode in which the tunnel found the graphics
  * input CSC, which DC does not program otherwise, and what the VBIOS lets the HDMI encoder send.
  * The hardware is not changed from here: what decides the tunnel is checked before the commit
- * (amdgpu_dm_dvbridge_check_dce()). With the DC lock held.
+ * (amdgpu_dm_dvbridge_check_dce()). Hades: a read back that is not as the tunnel needs, or that
+ * cannot be made, refuses every commit of the tunnel from then on, the frames of the video playing
+ * among them (amdgpu_dm_dvbridge_readback_verdict()). With the DC lock held.
  */
 void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_state *stream)
 {
+	struct amdgpu_display_manager *dm = &drm_to_adev(crtc->dev)->dm;
 	const struct link_encoder *enc = stream->link ? stream->link->link_enc : NULL;
 	const char *name = amdgpu_dm_dvbridge_dce_name(stream->ctx->dce_version);
 	struct dc_byte_tunnel_readback rb;
@@ -2375,16 +2411,18 @@ void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_st
 
 	if (!dc_stream_read_byte_tunnel(stream->ctx->dc, stream, &rb) &&
 	    !rb.ipp_read && !rb.xfm_read && !rb.opp_read) {
+		amdgpu_dm_dvbridge_readback_verdict(dm, false);
 		drm_warn(crtc->dev,
-			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: its pipe could not be read back\n",
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: its pipe could not be read back; " DVBRIDGE_READBACK_REFUSED "\n",
 			 crtc->base.id, crtc->name, name);
 		return;
 	}
-	if (amdgpu_dm_dvbridge_dce_readback_why(&rb, why, sizeof(why)))
+	if (amdgpu_dm_dvbridge_dce_readback_why(&rb, why, sizeof(why))) {
+		amdgpu_dm_dvbridge_readback_verdict(dm, false);
 		drm_warn(crtc->dev,
-			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back NOT as the tunnel needs (%s): " DVBRIDGE_DCE_READBACK_FORMAT "\n",
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back NOT as the tunnel needs (%s): " DVBRIDGE_DCE_READBACK_FORMAT "; " DVBRIDGE_READBACK_REFUSED "\n",
 			 crtc->base.id, crtc->name, name, why, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
-	else
+	} else
 		drm_info(crtc->dev,
 			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back as the tunnel needs: " DVBRIDGE_DCE_READBACK_FORMAT "\n",
 			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
@@ -2476,14 +2514,13 @@ bool amdgpu_dm_dvbridge_dcn42_pipe_why(const struct dc_state *context,
 
