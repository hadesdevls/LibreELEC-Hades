 	char why[512];
@@ -2717,9 +2747,9 @@ void amdgpu_dm_dvbridge_log_dcn42(struct drm_crtc *crtc, const struct dc_stream_
 
 	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
 	if (!rb) {
-		WRITE_ONCE(adev->dm.dvbridge_readback_failed, true);
