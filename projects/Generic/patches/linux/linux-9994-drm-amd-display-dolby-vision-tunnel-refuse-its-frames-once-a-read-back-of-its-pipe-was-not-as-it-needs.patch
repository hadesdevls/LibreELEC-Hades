 	if (amdgpu_dm_dvbridge_dcn42_readback_why(rb, stream->vsp_infopacket.valid &&
 						  amdgpu_dm_dvbridge_stream_dolby(stream),
 						  why, sizeof(why))) {
-		WRITE_ONCE(adev->dm.dvbridge_readback_failed, true);
+		amdgpu_dm_dvbridge_readback_verdict(dm, false);
 		drm_warn(crtc->dev,
-			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: read back NOT as the tunnel needs (%s); the tunnel is refused from the next time it is turned on, until the driver is loaded again\n",
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCN %s: read back NOT as the tunnel needs (%s); " DVBRIDGE_READBACK_REFUSED "\n",
