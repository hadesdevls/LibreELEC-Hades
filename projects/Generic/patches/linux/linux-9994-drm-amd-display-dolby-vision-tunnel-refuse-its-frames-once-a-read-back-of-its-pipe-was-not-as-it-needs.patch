 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h | 11 +--
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 88 +++++++++++++------
 .../display/amdgpu_dm/amdgpu_dm_dvbridge.h    |  9 ++
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 48 ++++++++--
 5 files changed, 125 insertions(+), 45 deletions(-)

