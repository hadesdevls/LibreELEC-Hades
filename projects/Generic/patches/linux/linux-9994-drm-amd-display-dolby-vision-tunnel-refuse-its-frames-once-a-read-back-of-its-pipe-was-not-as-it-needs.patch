-	 * Hades: DCN 4.2 and 4.2B: the read back of the pipe of a Dolby Vision tunnel was not as the
-	 * tunnel needs (amdgpu_dm_dvbridge_log_dcn42()); from then on the tunnel is refused when a
-	 * commit turns it on, until the driver is loaded again (amdgpu_dm_dvbridge_check_dcn42()).
+	 * Hades: DCE, DCN 4.2 and 4.2B: the read back of the pipe of a Dolby Vision tunnel was not as
+	 * the tunnel needs (amdgpu_dm_dvbridge_log_dce(), amdgpu_dm_dvbridge_log_dcn42()); from then on
+	 * every commit of the tunnel is refused, the frames of the video playing among them, until the
+	 * driver is loaded again (amdgpu_dm_dvbridge_readback_refuses()).
 	 */
 	bool dvbridge_readback_failed;
 };
@@ -1142,8 +1143,8 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct drm_display_mode *mode,
 				       const struct dc_stream_state *stream, bool low_latency,
 				       bool hdmi14b, bool hdr10t);
-void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
-					const struct drm_crtc_state *crtc_state);
+int amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+				       const struct drm_crtc_state *crtc_state);
