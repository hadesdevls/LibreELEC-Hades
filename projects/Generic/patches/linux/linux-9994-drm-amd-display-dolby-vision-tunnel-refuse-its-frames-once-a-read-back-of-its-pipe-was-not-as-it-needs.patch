index 24716fb812a7..69cbf963573a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -5387,7 +5387,9 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 
 	/*
 	 * Hades: DCE: each Dolby Vision tunnel that went on in this commit, as its pipe holds it, into
-	 * the kernel log (amdgpu_dm_dvbridge_log_dce())
+	 * the kernel log (amdgpu_dm_dvbridge_log_dce()); one that is not as the tunnel needs refuses
+	 * every commit of the tunnel from then on, its frames among them
+	 * (amdgpu_dm_dvbridge_readback_refuses())
 	 */
 	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
 		dm_new_crtc_state = to_dm_crtc_state(new_crtc_state);
@@ -5402,8 +5404,7 @@ static void amdgpu_dm_atomic_commit_tail(struct drm_atomic_commit *state)
 
 	/*
 	 * Hades: DCN 4.2 and 4.2B: the same, every pipe of each tunnel that went on in this commit
-	 * (amdgpu_dm_dvbridge_log_dcn42()); one that is not as the tunnel needs refuses the tunnel from
-	 * then on
+	 * (amdgpu_dm_dvbridge_log_dcn42()), with the same consequence
 	 */
 	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
 		dm_new_crtc_state = to_dm_crtc_state(new_crtc_state);
@@ -6514,8 +6515,11 @@ static int amdgpu_dm_atomic_check(struct drm_device *dev,
 		if (ret) {
 			drm_dbg_atomic(dev, "[CRTC:%d:%s] Dolby Vision tunnel refused: scanout not byte exact\n",
 				       crtc->base.id, crtc->name);
-			/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
-			amdgpu_dm_dvbridge_refused_scanout(state, crtc, new_crtc_state);
+			/*
+			 * Hades: why (DVBRIDGE_REFUSED and the kernel log); -EDEADLK from there: checked
+			 * again after a back off
+			 */
+			ret = amdgpu_dm_dvbridge_refused_scanout(state, crtc, new_crtc_state) ?: ret;
 			goto fail;
 		}
 	}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index c14f7c879f1e..f9e4cb43a69a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -745,9 +745,10 @@ struct amdgpu_display_manager {
