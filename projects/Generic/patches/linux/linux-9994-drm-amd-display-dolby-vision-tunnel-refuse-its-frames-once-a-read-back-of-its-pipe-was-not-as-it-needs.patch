+ * goes on without the tunnel (HDR10). (A read back that was not as the tunnel needs is refused
+ * before, with every generation: amdgpu_dm_dvbridge_readback_refuses().)
  */
 int amdgpu_dm_dvbridge_check_dcn42(struct drm_atomic_commit *state, const struct dc_state *context)
 {
-	struct amdgpu_device *adev = drm_to_adev(state->dev);
 	struct drm_crtc_state *new_crtc_state;
 	struct drm_crtc *crtc;
 	char detail[384];
@@ -2497,15 +2534,8 @@ int amdgpu_dm_dvbridge_check_dcn42(struct drm_atomic_commit *state, const struct
 		if (!new_crtc_state->active || !amdgpu_dm_dvbridge_stream_active(stream) ||
 		    !amdgpu_dm_dvbridge_stream_dcn42(stream))
 			continue;
-		if (READ_ONCE(adev->dm.dvbridge_readback_failed) &&
-		    drm_atomic_crtc_needs_modeset(new_crtc_state)) {
-			scnprintf(detail, sizeof(detail),
-				  "DCN %s: a read back of the pipe of the tunnel was not as the tunnel needs (the kernel log has what was read); the tunnel stays off until the driver is loaded again",
-				  amdgpu_dm_dvbridge_dcn42_name(stream));
-		} else if (!amdgpu_dm_dvbridge_dcn42_pipe_why(context, stream, detail,
-							      sizeof(detail))) {
+		if (!amdgpu_dm_dvbridge_dcn42_pipe_why(context, stream, detail, sizeof(detail)))
 			continue;
-		}
 		drm_dbg_atomic(state->dev, "[CRTC:%d:%s] Dolby Vision tunnel refused: DCN %s: %s\n",
 			       crtc->base.id, crtc->name, amdgpu_dm_dvbridge_dcn42_name(stream),
 			       detail);
@@ -2703,13 +2733,13 @@ bool amdgpu_dm_dvbridge_dcn42_readback_why(const struct dc_byte_tunnel_dcn42_rea
  * pipes of the stream as their registers hold them, into the kernel log, with what is not as the
  * tunnel needs (amdgpu_dm_dvbridge_dcn42_readback_why()): one line with the verdict, one per pipe,
  * one per OPP, one for the RMCM and the encoder. The hardware is not changed from here; what was
- * found wrong refuses the tunnel from the next commit that turns it on
- * (amdgpu_dm_dvbridge_check_dcn42()), so that user space plays HDR10 from then on. With the DC lock
- * held.
+ * found wrong refuses every commit of the tunnel from then on, the frames of the video playing
+ * among them (amdgpu_dm_dvbridge_readback_verdict()), so that user space leaves the tunnel in that
+ * same video and plays HDR10. With the DC lock held.
