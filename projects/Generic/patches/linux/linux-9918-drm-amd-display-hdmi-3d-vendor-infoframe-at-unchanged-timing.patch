From c3b354d7ea90ebd77aa2fd15c956f88c31f208d6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:30:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: send the vendor InfoFrame when the
 timing stays

Going from a 2D mode to its side-by-side half or top-and-bottom twin,
back, or from one of the two to the other changes nothing in the stream
but the vendor InfoFrame: the timing is the one of the 2D mode, and for
the display core the stream of a 3D mode is a 2D stream. The DRM core
calls it a modeset (drm_mode_equal() compares the 3D flags) and
dm_update_crtc_state() builds a new stream. But when the new stream is
committed the display core programs only the pipes that need it
(dce110_apply_ctx_to_hw()), and pipe_need_reprogram() compares the
timing and no InfoFrame: the stream encoder goes on sending the frames
of the old stream. InfoFrames are otherwise written only when a stream
update names one (commit_planes_do_stream_update()), and nothing named
the vendor InfoFrame.

So the sink was not told to show 3D and, worse, not told to stop: after
a 3D film at the refresh rate of the menus it would go on giving each
half of the menus to one eye.

It is the case that linux-9910 describes for the Dolby vendor InfoFrame
at 2160p50/60, and the fix is the same: when a commit replaced the
stream, and the vendor InfoFrame of the old or of the new stream is a 3D
one and the two differ, amdgpu_dm_commit_planes() names the vendor
InfoFrame in the stream update of the commit. A new stream without a
vendor InfoFrame stops the old frame (enc3_update_hdmi_info_packet()).

Frame packing never had this: its timing is not the one of its 2D twin,
so the pipe is programmed again. Nor has a change that also changes the
refresh rate, which is all that the reports about these patches cover
(1080p24).

The Dolby Vision tunnel and 3D never share a stream: the tunnel is
refused on a mode with a 3D flag. A commit that goes from one to the
other passes either test, and both name the same frame.

With no 3D vendor InfoFrame in the old stream or in the new one, the
test is false and the stream update is what it was.

Not covered: a commit that replaces the stream with no plane of the CRTC
in it does not reach this code. A modeset brings the planes of its CRTC
(amdgpu_dm_atomic_check()), so none is known.

Checked: compiled with the configuration and the compiler of the image.
Not run on hardware and never seen on a 3D display: that the frame
reaches the sink at an unchanged timing is read in the code. HDR
metadata that changes without a modeset goes out by the same call.

Ported to Linux 7.3: 7.3 split amdgpu_dm.c. The functions go to
amdgpu_dm_connector.c after amdgpu_dm_stereo_vsif(), before
create_stream_for_sink(), and the hunk of amdgpu_dm_commit_planes() stays in
amdgpu_dm.c; amdgpu_dm_stereo_vsif_changed(), which it calls, is no longer
static and is declared in amdgpu_dm_dvbridge.h. The code is the code of 7.2.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  9 +++++
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 39 +++++++++++++++++++
 .../display/amdgpu_dm/amdgpu_dm_dvbridge.h    |  4 ++
 3 files changed, 52 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index e6bfaed..4f83951 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -4104,6 +4104,15 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 			bundle->stream_update.dither_option = &acrtc_state->stream->dither_option;
 		}
 
+		/*
+		 * The same for HDMI 3D: a 2D mode and its side-by-side and top-and-bottom
+		 * twins differ in the vendor InfoFrame alone. DC keeps the stream encoder as
+		 * the old stream programmed it, so the sink would not be told to show 3D, or
+		 * to stop showing it: send the vendor InfoFrame with the update.
+		 */
+		if (amdgpu_dm_stereo_vsif_changed(dm_old_crtc_state->stream, acrtc_state->stream))
+			bundle->stream_update.vsp_infopacket = &acrtc_state->stream->vsp_infopacket;
+
 		if (new_pcrtc_state->color_mgmt_changed) {
 			/*
 			 * TODO: This isn't fully correct since we've actually
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index e8c4fc3..da39035 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1826,6 +1826,45 @@ static int amdgpu_dm_stereo_vsif(u32 layout, struct dc_info_packet *out)
 	return amdgpu_dm_dvbridge_infopacket(buf, len, out);
 }
 
+/* HDMI_Video_Format, the field of the HDMI vendor InfoFrame that says what the frame holds */
+#define AMDGPU_DM_HDMI_VIDEO_FORMAT_NONE	0
+#define AMDGPU_DM_HDMI_VIDEO_FORMAT_VIC		1
+#define AMDGPU_DM_HDMI_VIDEO_FORMAT_3D		2
+
+/*
+ * HDMI_Video_Format of the vendor InfoFrame of a stream, or -1 when the stream has no vendor
+ * InfoFrame or one of another kind (the Dolby Vision one).
+ */
+static int amdgpu_dm_hdmi_video_format(const struct dc_stream_state *stream)
+{
+	const struct dc_info_packet *p;
+
+	if (!stream)
+		return -1;
+	p = &stream->vsp_infopacket;
+	if (!p->valid || p->hb0 != HDMI_INFOFRAME_TYPE_VENDOR ||
+	    p->sb[1] != 0x03 || p->sb[2] != 0x0c || p->sb[3] != 0x00)
+		return -1;
+	return p->sb[4] >> 5;
+}
+
+/*
+ * The commit replaced the stream of a CRTC, and the vendor InfoFrame of the new stream does
+ * not say about 3D what the one of the old stream said.
+ */
+bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
+				   const struct dc_stream_state *new_stream)
+{
+	if (!new_stream || old_stream == new_stream)
+		return false;
+	if (amdgpu_dm_hdmi_video_format(old_stream) != AMDGPU_DM_HDMI_VIDEO_FORMAT_3D &&
+	    amdgpu_dm_hdmi_video_format(new_stream) != AMDGPU_DM_HDMI_VIDEO_FORMAT_3D)
+		return false;
+	return !old_stream ||
+	       memcmp(&old_stream->vsp_infopacket, &new_stream->vsp_infopacket,
+		      sizeof(new_stream->vsp_infopacket));
+}
+
 STATIC_IFN_KUNIT struct dc_stream_state *
 create_stream_for_sink(struct drm_connector *connector,
 		       const struct drm_display_mode *drm_mode,
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
index 5c6484e..57f59e8 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge.h
@@ -121,4 +121,8 @@ int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 				     struct drm_crtc_state *crtc_state);
 bool amdgpu_dm_dvbridge_toggled(struct drm_atomic_commit *state, struct drm_crtc *crtc);
 
+/* HDMI 3D, built in the same file: the commit side sends a vendor InfoFrame that changed. */
+bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stream,
+				   const struct dc_stream_state *new_stream);
+
 #endif
