From f4ace950b2f58668bc765c5c5b309dbd931eafd1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:00:00 +0000
Subject: [PATCH] ALSA: hda: say the PCIe link at each stream DMA error (the
 HD-audio function of a GPU)

A FIFO error on an output stream of an HD-audio controller means the
controller's DMA could not read the next samples from memory in time
(SD_STS 0x28 is SD_INT_FIFO_ERR plus SD_STS_FIFO_READY). snd_hdac_bus_
handle_stream_irq() warns "stream N dma error" and goes on.

On the HD-audio function of a discrete NVIDIA GPU (a hybrid laptop, with
TrueHD/DTS-HD in 8 channels at 192 kHz), these errors came every 7 s on
the charger, where the GPU switches between performance states and the
PCIe link between generations (the log of a monitor that polls the GPU
shows P3 and P0, memory clock 5501/810 MHz, link generation 4/2), and
never on battery, where the GPU stays at P5 and generation 2. The kernel
log of the error says nothing about the link, so one cannot tell from a
single log whether the errors follow it.

Read the link status register of the function's own PCIe capability at
the error and say its generation and width in a second line, rate limited on its own.
Nothing is written; a controller that is not on a PCIe link
(or a kernel without PCI) says nothing more than before.
---
 sound/hda/core/controller.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/sound/hda/core/controller.c b/sound/hda/core/controller.c
index 78855ac..3d0cb6a 100644
--- a/sound/hda/core/controller.c
+++ b/sound/hda/core/controller.c
@@ -6,6 +6,7 @@
 #include <linux/kernel.h>
 #include <linux/delay.h>
 #include <linux/export.h>
+#include <linux/pci.h>
 #include <sound/core.h>
 #include <sound/hdaudio.h>
 #include <sound/hda_register.h>
@@ -667,6 +668,36 @@ void snd_hdac_bus_stop_chip(struct hdac_bus *bus)
 }
 EXPORT_SYMBOL_GPL(snd_hdac_bus_stop_chip);
 
+/*
+ * A FIFO error on an output stream means that the controller's DMA could
+ * not read the next samples from memory in time. On a controller behind a
+ * PCIe link, such as the HD-audio function of a discrete GPU, a likely
+ * cause is the link being retrained, or the memory behind it stalling,
+ * when the GPU changes its performance state. Say which generation and
+ * width the link has right now, so that a log shows whether the errors
+ * follow the link changing state. Only reads the status register of the
+ * function's own PCIe capability; nothing is written.
+ */
+static void hdac_report_dma_error_link(struct hdac_bus *bus)
+{
+#ifdef CONFIG_PCI
+	struct pci_dev *pci;
+	u16 sta;
+
+	if (!dev_is_pci(bus->dev))
+		return;
+	pci = to_pci_dev(bus->dev);
+	if (!pci_is_pcie(pci))
+		return;
+	if (pcie_capability_read_word(pci, PCI_EXP_LNKSTA, &sta))
+		return;
+	dev_warn_ratelimited(bus->dev,
+			     "stream dma error: the PCIe link is at generation %u, x%u\n",
+			     sta & PCI_EXP_LNKSTA_CLS,
+			     (sta & PCI_EXP_LNKSTA_NLW) >> PCI_EXP_LNKSTA_NLW_SHIFT);
+#endif
+}
+
 /**
  * snd_hdac_bus_handle_stream_irq - interrupt handler for streams
  * @bus: HD-audio core bus
@@ -692,6 +723,7 @@ int snd_hdac_bus_handle_stream_irq(struct hdac_bus *bus, unsigned int status,
 				dev_warn_ratelimited(bus->dev,
 						"stream %u dma error: 0x%02x\n",
 						azx_dev->index, sd_status);
+				hdac_report_dma_error_link(bus);
 			}
 			if ((!azx_dev->substream && !azx_dev->cstream) ||
 			    !azx_dev->running || !(sd_status & SD_INT_COMPLETE))
