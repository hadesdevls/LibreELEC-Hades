From 12956f19ee0f3df41ac57d815d0922bea30067f3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:34:55 +0000
Subject: [PATCH] drm/amd/display: no Dolby Vision tunnel under visual confirm
 or a stream LUT

The Dolby Vision tunnel of linux-9910 refuses every commit whose
scanout is not byte exact, by the state that user space and DC have
for the stream and its plane. Two things that DC applies to a stream on
its own were not among them:

- visual confirm, the debug overlay of the display core
  (amdgpu.visualconfirm, or amdgpu_dm_visual_confirm in debugfs): it
  shrinks the recout of the planes and paints a bar in the background
  colour of the MPC (resource_build_scaling_params(),
  dcn10_update_visual_confirm_color() and its successors);
- a 3D LUT or a shaper of the stream, which DCN 3.0 and later program
  in the MPC when the stream has them (dcn32_set_mpc_shaper_3dlut(),
  called by the output transfer function of DCN 3.2 and 4.0.1).

amdgpu_dm sets neither by itself: visual confirm is off unless asked
for, and stream->lut3d_func and stream->func_shaper are never assigned
in amdgpu_dm (they are only passed on in a stream update). So nothing
changes for a tunnel today; a tunnel is refused with any of them, on
every generation, rather than sent with bytes that are not the
framebuffer's. The refusal is "scanout" in DVBRIDGE_REFUSED, and the
kernel log says which of them it was.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 19 +++++++++++++++++++
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 12 ++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 2c06194..371a659 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -8118,6 +8118,23 @@ static int amdgpu_dm_dvbridge_check_dcn1_2(const struct dc_stream_state *stream,
 	return 0;
 }
 
+/*
+ * Hades: nothing that DC itself draws or applies over a tunnelled stream. Visual confirm
+ * (amdgpu.visualconfirm, or the amdgpu_dm_visual_confirm file of debugfs) shrinks the recout
+ * and paints the MPC background (dcn10_update_visual_confirm_color() and the recout of
+ * resource_build_scaling_params()). DCN 3.0 and later program a 3D LUT and a shaper of the
+ * stream in the MPC (dcn32_set_mpc_shaper_3dlut()) when the stream has them. amdgpu_dm sets
+ * neither by itself: a tunnel is refused with any of them.
+ */
+static int amdgpu_dm_dvbridge_check_stream_extras(const struct dc_stream_state *stream)
+{
+	if (stream->ctx->dc->debug.visual_confirm != VISUAL_CONFIRM_DISABLE ||
+	    (stream->lut3d_func && stream->lut3d_func->state.bits.initialized) ||
+	    (stream->func_shaper && stream->func_shaper->type != TF_TYPE_BYPASS))
+		return -EINVAL;
+	return 0;
+}
+
 /* Refuse colour processing and compositing: never bypass a user setting silently. */
 static int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 					    struct drm_crtc *crtc,
@@ -8164,6 +8181,8 @@ static int amdgpu_dm_dvbridge_check_scanout(struct drm_atomic_commit *state,
 	    dm_crtc_state->freesync_config.state == VRR_STATE_ACTIVE_VARIABLE ||
 	    dm_crtc_state->freesync_config.state == VRR_STATE_ACTIVE_FIXED)
 		return -EINVAL;
+	if (amdgpu_dm_dvbridge_check_stream_extras(stream))
+		return -EINVAL;
 
 	/* The primary plane alone (no overlay, no cursor), full screen, unscaled. */
 	if (crtc_state->plane_mask != drm_plane_mask(primary))
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index c848a04..84b7885 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -386,6 +386,18 @@ static u64 dvbridge_why_scanout(struct drm_atomic_commit *state, struct drm_crtc
 					 len ? "; " : "");
 		}
 	}
+	/* Hades: what DC would draw or apply over the stream itself (linux-9973) */
+	if (stream->ctx->dc->debug.visual_confirm != VISUAL_CONFIRM_DISABLE ||
+	    (stream->lut3d_func && stream->lut3d_func->state.bits.initialized) ||
+	    (stream->func_shaper && stream->func_shaper->type != TF_TYPE_BYPASS)) {
+		bits |= REFUSED(SCANOUT);
+		len += scnprintf(buf + len, size - len,
+				 "%svisual confirm %d, stream 3D LUT %s, stream shaper %s", len ? "; " : "",
+				 stream->ctx->dc->debug.visual_confirm,
+				 str_yes_no(stream->lut3d_func && stream->lut3d_func->state.bits.initialized),
+				 str_yes_no(stream->func_shaper &&
+					    stream->func_shaper->type != TF_TYPE_BYPASS));
+	}
 	/* (the colour pipeline of the plane, as user space and DC have it, is "scanout" too) */
 	return bits ? bits : REFUSED(SCANOUT);
 }
-- 
2.53.0

