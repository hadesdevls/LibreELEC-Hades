From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:36:23 +0000
Subject: [PATCH] drm/amd/display: the kernel log says the packets that a
 commit gives a stream, not those of a check

linux-9980 says each packet of a stream from resource_build_info_frame().
On DCE that function also runs when a stream is added to a context that is
only validated: build_mapped_resource() of DCE 10, 11 and 11.2 (and of the
display cores that use them, DCE 8 and 12), which amdgpu_dm reaches for
each mode that it checks at a detection (dm_validate_stream_and_context(),
each time with a new context, in which nothing was said yet) and for a
commit that only tests. The log then said the AVI, SPD and other packets
of every mode of the EDID at each detection, none of which went out, and
its 400 lines were spent at the first one: the packets of a video were
never said.

The DCE builders of a context now use resource_build_info_frame_unlogged(),
the same packets without the log; the commit that enables a stream builds
them again (link_set_dpms_on(), in
link_set_dpms_on_pre_enable_link()) and says those, as on DCN, where only the
commit paths build them. Nothing that goes out changes.

Host test: on DCE the builders of a validated context build without the
log, and link_set_dpms_on() and the stream updates of dc.c with it;
it fails without this change. W=1 on amdgpu: no warning. Not run on hardware.
---
 drivers/gpu/drm/amd/display/dc/core/dc_resource.c  | 14 +++++++++++++-
 drivers/gpu/drm/amd/display/dc/inc/resource.h      |  2 ++
 .../display/dc/resource/dce100/dce100_resource.c   |  3 ++-
 .../display/dc/resource/dce110/dce110_resource.c   |  3 ++-
 .../display/dc/resource/dce112/dce112_resource.c   |  3 ++-
 5 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
index 0e9e3b272..202145b97 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
@@ -5367,7 +5367,15 @@ static void hades_log_info_packets(struct pipe_ctx *pipe_ctx)
 			      &w->hades_log[9]);
 }
 
-void resource_build_info_frame(struct pipe_ctx *pipe_ctx)
+/*
+ * Hades: the packets of the stream of a pipe, without the lines of the kernel log that
+ * resource_build_info_frame() adds: for a context that is only validated, whose packets are not
+ * given to a stream. DCE builds them when a stream is added to a context (build_mapped_resource()),
+ * which amdgpu_dm does for each mode that it checks (dm_validate_stream_and_context()) and for a
+ * commit that only tests; the commit that enables the stream builds them again
+ * (link_set_dpms_on()), and those are the ones that the log says.
+ */
+void resource_build_info_frame_unlogged(struct pipe_ctx *pipe_ctx)
 {
 	enum signal_type signal = SIGNAL_TYPE_NONE;
 	struct encoder_info_frame *info = &pipe_ctx->stream_res.encoder_info_frame;
@@ -5423,7 +5431,11 @@ void resource_build_info_frame(struct pipe_ctx *pipe_ctx)
 	}
 
 	patch_gamut_packet_checksum(&info->gamut);
+}
 
+void resource_build_info_frame(struct pipe_ctx *pipe_ctx)
+{
+	resource_build_info_frame_unlogged(pipe_ctx);
 	hades_log_info_packets(pipe_ctx); /* Hades */
 }
 
diff --git a/drivers/gpu/drm/amd/display/dc/inc/resource.h b/drivers/gpu/drm/amd/display/dc/inc/resource.h
index 8e21aaac0..59d96b3ad 100644
--- a/drivers/gpu/drm/amd/display/dc/inc/resource.h
+++ b/drivers/gpu/drm/amd/display/dc/inc/resource.h
@@ -132,6 +132,8 @@ enum dc_status resource_build_scaling_params_for_context(
 		struct dc_state *context);
 
 void resource_build_info_frame(struct pipe_ctx *pipe_ctx);
+/* Hades: ... without the kernel log's lines, for a context that is only validated */
+void resource_build_info_frame_unlogged(struct pipe_ctx *pipe_ctx);
 
 void resource_unreference_clock_source(
 		struct resource_context *res_ctx,
diff --git a/drivers/gpu/drm/amd/display/dc/resource/dce100/dce100_resource.c b/drivers/gpu/drm/amd/display/dc/resource/dce100/dce100_resource.c
index 97ea22af5..79d279b9d 100644
--- a/drivers/gpu/drm/amd/display/dc/resource/dce100/dce100_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/resource/dce100/dce100_resource.c
@@ -858,7 +858,8 @@ static enum dc_status build_mapped_resource(
 
 	dce110_resource_build_pipe_hw_param(pipe_ctx);
 
-	resource_build_info_frame(pipe_ctx);
+	/* Hades: a context being validated: the commit's packets are the ones said in the log */
+	resource_build_info_frame_unlogged(pipe_ctx);
 
 	return DC_OK;
 }
diff --git a/drivers/gpu/drm/amd/display/dc/resource/dce110/dce110_resource.c b/drivers/gpu/drm/amd/display/dc/resource/dce110/dce110_resource.c
index 19252b25b..dc436a1dc 100644
--- a/drivers/gpu/drm/amd/display/dc/resource/dce110/dce110_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/resource/dce110/dce110_resource.c
@@ -962,7 +962,8 @@ static enum dc_status build_mapped_resource(
 
 	/* TODO: validate audio ASIC caps, encoder */
 
-	resource_build_info_frame(pipe_ctx);
+	/* Hades: a context being validated: the commit's packets are the ones said in the log */
+	resource_build_info_frame_unlogged(pipe_ctx);
 
 	return DC_OK;
 }
diff --git a/drivers/gpu/drm/amd/display/dc/resource/dce112/dce112_resource.c b/drivers/gpu/drm/amd/display/dc/resource/dce112/dce112_resource.c
index 4e5bf35f6..c382a7f50 100644
--- a/drivers/gpu/drm/amd/display/dc/resource/dce112/dce112_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/resource/dce112/dce112_resource.c
@@ -885,7 +885,8 @@ static enum dc_status build_mapped_resource(
 
 	dce110_resource_build_pipe_hw_param(pipe_ctx);
 
-	resource_build_info_frame(pipe_ctx);
+	/* Hades: a context being validated: the commit's packets are the ones said in the log */
+	resource_build_info_frame_unlogged(pipe_ctx);
 
 	return DC_OK;
 }
