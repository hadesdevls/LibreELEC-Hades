+/*
+ * Hades: Standard Dolby Vision through the DisplayPort to HDMI converter of a board (a protocol
+ * converter, PCON, between the DDI port and the HDMI socket), whose policy is
+ * intel_dv_pcon_policy.h: the tunnel has been an HDMI connector's, and a port with a converter is
+ * a DisplayPort connector here.
+ *
+ * The converter turns DisplayPort InfoFrame SDPs into HDMI InfoFrames, which is how HDR10 goes
+ * through it (the GMP DIP, the DRM InfoFrame). The AVI InfoFrame and the Dolby vendor InfoFrame of
+ * the tunnel go as DisplayPort InfoFrame SDPs too: the AVI one in the AVI DIP, the vendor one in
+ * the GMP DIP, because the vendor DIP blanks the HDMI output of the converter that it was seen
+ * through (YBLOD, linux-9930: the mechanism and the board; this is written again for the policy,
+ * the checks and the readout of this tree). The bytes of the picture go as they do through native
+ * HDMI: RGB at 8 bits, full range, nothing of the display pipe in between.
+ */
+bool intel_dp_pcon_dv_candidate(const struct intel_digital_port *dig_port)
+{
+	struct intel_display *display = to_intel_display(&dig_port->base);
+	const struct intel_bios_encoder_data *devdata = dig_port->base.devdata;
+
+	return intel_dv_pcon_candidate(DISPLAY_VER(display), display->params.enable_dv_lab,
+				       display->params.dv_pcon, false,
+				       intel_bios_encoder_is_lspcon(devdata),
+				       intel_bios_encoder_supports_hdmi(devdata));
+}
+
+/*
+ * The sink is an HDMI sink behind a branch device of the HDMI type, and that device will not go
+ * to FRL (what the tunnel was seen through is TMDS): Kodi asks only where this is so.
+ */
+static bool intel_dp_pcon_dv_route(struct intel_dp *intel_dp)
+{
+	return drm_dp_is_branch(intel_dp->dpcd) &&
+		(intel_dp->downstream_ports[0] & DP_DS_PORT_TYPE_MASK) == DP_DS_PORT_TYPE_HDMI &&
+		intel_dp_has_hdmi_sink(intel_dp) && !intel_dp->dfp.pcon_max_frl_bw;
+}
+
+static const struct intel_dv_pcon_board *intel_dp_pcon_dv_board(void)
+{
+	return intel_dv_pcon_board_listed(dmi_get_system_info(DMI_BOARD_VENDOR),
+					  dmi_get_system_info(DMI_BOARD_NAME));
+}
+
+static enum intel_dv_pcon_verdict intel_dp_pcon_dv_verdict(struct intel_dp *intel_dp)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+
+	return intel_dv_pcon_verdict(display->params.dv_pcon, intel_dp_pcon_dv_route(intel_dp),
+				     !!intel_dp_pcon_dv_board());
+}
+
+/*
+ * DVBRIDGE_DV_CONVERTER, what the detect that just ran found; the kernel log says it when a
+ * converter is found, and again only when it is another verdict
+ */
+static void intel_dp_pcon_dv_update(struct intel_dp *intel_dp, bool connected)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	enum intel_dv_pcon_verdict verdict =
+		connected ? intel_dp_pcon_dv_verdict(intel_dp) : INTEL_DV_PCON_NONE;
+	const struct intel_dv_pcon_board *board;
+
+	if (!connector->dv_converter_property)
+		return;
+	if (verdict != connector->dv_converter) {
+		drm_object_property_set_value(&connector->base.base,
+					      connector->dv_converter_property, verdict);
+		connector->dv_converter = verdict;
+	}
+	if (verdict == INTEL_DV_PCON_NONE || verdict == connector->dv_converter_told)
+		return;
+	connector->dv_converter_told = verdict;
+	board = intel_dp_pcon_dv_board();
+	drm_info(display->drm,
+		 "[CONNECTOR:%d:%s] DVBRIDGE: a DisplayPort to HDMI converter is behind this port (DVBRIDGE_DV_CONVERTER %s): %s%s%s%s\n",
+		 connector->base.base.id, connector->base.name,
+		 intel_dv_pcon_verdict_name(verdict), intel_dv_pcon_verdict_why(verdict),
+		 board ? " (" : "", board ? board->seen : "", board ? ")" : "");
+}
+
+/* The properties of the tunnel on a DisplayPort connector of a port that can carry it */
+static void intel_dp_pcon_dv_add_properties(struct intel_dp *intel_dp,
+					    struct drm_connector *_connector)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = to_intel_connector(_connector);
+	static const struct drm_prop_enum_list verdicts[] = {
+		{ INTEL_DV_PCON_NONE, "none" },
+		{ INTEL_DV_PCON_UNLISTED, "unlisted" },
+		{ INTEL_DV_PCON_LISTED, "listed" },
+		{ INTEL_DV_PCON_FORCED, "forced" },
+	};
+
+	if (intel_dp_is_edp(intel_dp) || !intel_dp_pcon_dv_candidate(dp_to_dig_port(intel_dp)))
+		return;
+
+	connector->dv_lab_property = drm_property_create_bool(display->drm, DRM_MODE_PROP_ATOMIC,
+							      "DVBRIDGE_DV_STANDARD_LAB");
+	if (!connector->dv_lab_property)
+		return;
+	drm_object_attach_property(&_connector->base, connector->dv_lab_property, 0);
+
+	connector->dv_converter_property =
+		drm_property_create_enum(display->drm, DRM_MODE_PROP_IMMUTABLE,
+					 "DVBRIDGE_DV_CONVERTER", verdicts,
+					 ARRAY_SIZE(verdicts));
+	if (connector->dv_converter_property)
+		drm_object_attach_property(&_connector->base, connector->dv_converter_property,
+					   INTEL_DV_PCON_NONE);
+
+	connector->dv_refused_property = drm_dvbridge_refused_property_create(display->drm);
+	if (connector->dv_refused_property) {
+		drm_dvbridge_refused_log_init(&connector->dv_refused_log);
+		drm_object_attach_property(&_connector->base, connector->dv_refused_property, 0);
+	}
+}
+
+/* Why a request of the tunnel was refused, for DVBRIDGE_REFUSED and the kernel log */
+static void intel_dp_pcon_dv_refused(struct intel_connector *connector, u64 bits,
+				     const char *detail)
+{
+	if (connector->dv_refused_property)
+		drm_dvbridge_refused_report(&connector->base, connector->dv_refused_property,
+					    &connector->dv_refused_log, bits, detail);
+}
+
+static int intel_dp_pcon_dv_compute_config(struct intel_dp *intel_dp,
+					   struct intel_crtc_state *crtc_state,
+					   const struct drm_connector_state *conn_state)
+{
+	static DEFINE_RATELIMIT_STATE(limit, 30 * HZ, 2);
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	const struct drm_display_mode *mode = &crtc_state->hw.adjusted_mode;
+	const struct drm_dvbridge_sink *sink = &connector->dv_sink;
+	struct hdmi_avi_infoframe *avi = &crtc_state->infoframes.avi.avi;
+	struct hdmi_dolby_vendor_infoframe *dv = &crtc_state->infoframes.hdmi.vendor.dolby;
+	const struct intel_digital_connector_state *dcs =
+		to_intel_digital_connector_state(conn_state);
+	enum intel_dv_pcon_verdict verdict;
+	struct intel_dv_lab_link link;
+	char detail[256];
+	u8 vic;
+	int ret;
+	u64 bits;
+
+	if (!dcs->dv_lab_standard)
+		return 0;
+
+	drm_modeset_lock_assert_held(&display->drm->mode_config.connection_mutex);
+	verdict = intel_dp_pcon_dv_verdict(intel_dp);
+	link = (struct intel_dv_lab_link) {
+		.requested = true,
+		.lab_enabled = display->params.enable_dv_lab &&
+			intel_dv_lab_platform_supported(DISPLAY_VER(display)),
+		.sink_standard = drm_dvbridge_sink_takes(sink, false),
+		.sink_2160p60 = sink->p60,
+		.hdmi = intel_dp_has_hdmi_sink(intel_dp) &&
+			connector->base.display_info.has_hdmi_infoframe,
+		.native_hdmi = false,
+		.converter = intel_dv_pcon_takes(verdict) &&
+			intel_dv_pcon_signalling_ok(dcs->dv_lab_low_latency, dcs->dv_lab_hdmi14b),
+		.rgb = crtc_state->output_format == INTEL_OUTPUT_FORMAT_RGB &&
+			crtc_state->sink_format == INTEL_OUTPUT_FORMAT_RGB,
+		.limited_range = crtc_state->limited_color_range,
+		.hdr_blob = !!conn_state->hdr_output_metadata,
+		.cloned = hweight32(crtc_state->uapi.encoder_mask) > 1,
+		.progressive = !(mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN |
+						DRM_MODE_FLAG_DBLCLK | DRM_MODE_FLAG_3D_MASK)),
+		.requested_bpc = conn_state->max_requested_bpc,
+		.pipe_bpp = crtc_state->pipe_bpp,
+		.colorspace = conn_state->colorspace,
+		.width = mode->hdisplay,
+		.height = mode->vdisplay,
+		.rounded_refresh = drm_mode_vrefresh(mode),
+	};
+	ret = intel_dv_lab_validate(&link);
+	if (ret || crtc_state->dsc.compression_enable || mode->flags & DRM_MODE_FLAG_3D_MASK) {
+		bits = intel_dv_lab_refused(&link, crtc_state->sink_format ==
+						   INTEL_OUTPUT_FORMAT_YCBCR420);
+		if (!bits)
+			bits = BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT);
+		scnprintf(detail, sizeof(detail),
+			  "DisplayPort to HDMI converter: %s (%s); %s at %u bpp, max bpc %u, limited range %d, HDR metadata %d, colorimetry %u; %ux%u@%u%s%s%s",
+			  intel_dv_pcon_verdict_name(verdict), intel_dv_pcon_verdict_why(verdict),
+			  crtc_state->sink_format == INTEL_OUTPUT_FORMAT_YCBCR420 ? "YCbCr 4:2:0" :
+			  crtc_state->sink_format == INTEL_OUTPUT_FORMAT_YCBCR444 ? "YCbCr 4:4:4" : "RGB",
+			  link.pipe_bpp, link.requested_bpc, link.limited_range, link.hdr_blob,
+			  link.colorspace, link.width, link.height, link.rounded_refresh,
+			  link.progressive ? "" : ", not progressive 2D", link.cloned ? ", cloned" : "",
+			  crtc_state->dsc.compression_enable ? ", DSC" : "");
+		intel_dp_pcon_dv_refused(connector, bits, detail);
+		if (__ratelimit(&limit))
+			drm_err(display->drm,
+				"[CONNECTOR:%d:%s] DVBRIDGE: the tunnel through the DisplayPort to HDMI converter was refused: %s\n",
+				connector->base.base.id, connector->base.name, detail);
+		return ret ?: -EINVAL;
+	}
+
+	/* the AVI InfoFrame of the tunnel: the one of native HDMI (drm_dvbridge.h) */
+	vic = drm_dvbridge_avi_vic(drm_match_cea_mode(mode));
+	if (!vic) {
+		scnprintf(detail, sizeof(detail),
+			  "%dx%d@%d has no CTA VIC that the tunnel takes (CTA VIC %u)", mode->hdisplay,
+			  mode->vdisplay, drm_mode_vrefresh(mode), drm_match_cea_mode(mode));
+		intel_dp_pcon_dv_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_MODE), detail);
+		return -EINVAL;
+	}
+	ret = drm_hdmi_avi_infoframe_from_display_mode(avi, &connector->base, mode);
+	if (ret)
+		return ret;
+	drm_hdmi_avi_infoframe_quant_range(avi, &connector->base, mode,
+					   HDMI_QUANTIZATION_RANGE_FULL);
+	drm_hdmi_avi_infoframe_content_type(avi, conn_state);
+	drm_dvbridge_tunnel_avi(avi, vic);
+	ret = hdmi_avi_infoframe_check(avi);
+	if (ret)
+		return ret;
+
+	drm_dvbridge_tunnel_vsif(dv);
+	ret = hdmi_dolby_vendor_infoframe_check(dv);
+	if (ret)
+		return ret;
+
+	crtc_state->dither_force_disable = true;
+	crtc_state->infoframes.enable |= intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_AVI) |
+					 intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
+	intel_dp_pcon_dv_refused(connector, 0, NULL);
+
+	if (verdict != INTEL_DV_PCON_LISTED && __ratelimit(&limit))
+		drm_warn(display->drm,
+			 "[CONNECTOR:%d:%s] DVBRIDGE: the tunnel goes through a DisplayPort to HDMI converter that nobody has seen carry it (%s)\n",
+			 connector->base.base.id, connector->base.name,
+			 intel_dv_pcon_verdict_name(verdict));
+	return 0;
+}
+
+/*
+ * An HDMI InfoFrame (type, version, length, checksum, payload) as the DisplayPort 1.4 InfoFrame
+ * SDP that intel_dp_hdr_metadata_infoframe_sdp_pack() makes, in 32 bytes (the size of the AVI
+ * DIP): the Dolby vendor InfoFrame's last payload byte (reserved, zero) is not carried; the 36
+ * bytes of the GMP DIP are zero-padded by hsw_write_infoframe().
+ */
+static void intel_dp_pcon_dv_sdp(const u8 *hdmi, ssize_t len, u8 *sdp)
+{
+	memset(sdp, 0, VIDEO_DIP_DATA_SIZE);
+	sdp[1] = hdmi[0];	/* HB1: 0x80 + the InfoFrame type */
+	sdp[2] = 0x1d;		/* HB2: as the HDR metadata one */
+	sdp[3] = 0x13 << 2;	/* HB3 */
+	sdp[4] = hdmi[1];	/* DB0: version */
+	sdp[5] = hdmi[2];	/* DB1: length */
+	memcpy(&sdp[6], &hdmi[HDMI_INFOFRAME_HEADER_SIZE],
+	       min_t(ssize_t, len - HDMI_INFOFRAME_HEADER_SIZE, VIDEO_DIP_DATA_SIZE - 6));
+}
+
+static void intel_dp_pcon_dv_write(struct intel_encoder *encoder,
+				   const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	u8 buf[VIDEO_DIP_DATA_SIZE] = {}, sdp[VIDEO_DIP_DATA_SIZE];
+	ssize_t len;
+
+	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP_MST) ||
+	    !(crtc_state->infoframes.enable &
+	      intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) ||
+	    !intel_dp_pcon_dv_candidate(enc_to_dig_port(encoder)))
+		return;
+
+	len = hdmi_avi_infoframe_pack_only(&crtc_state->infoframes.avi.avi, buf, sizeof(buf));
+	if (drm_WARN_ON(display->drm, len < HDMI_INFOFRAME_HEADER_SIZE))
+		return;
+	intel_dp_pcon_dv_sdp(buf, len, sdp);
+	hsw_write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_AVI, sdp, sizeof(sdp));
+
+	memset(buf, 0, sizeof(buf));
+	len = hdmi_dolby_vendor_infoframe_pack(&crtc_state->infoframes.hdmi.vendor.dolby, buf,
+					       sizeof(buf));
+	if (drm_WARN_ON(display->drm, len != HDMI_INFOFRAME_HEADER_SIZE + 27 ||
+			buf[HDMI_INFOFRAME_HEADER_SIZE + 26]))
+		return;
+	intel_dp_pcon_dv_sdp(buf, len, sdp);
+	/* The GMP DIP: the vendor DIP blanks the output of the converter that this was seen through */
+	hsw_write_infoframe(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA, sdp, sizeof(sdp));
+}
+
 int
 intel_dp_compute_config(struct intel_atomic_state *state,
 			struct intel_encoder *encoder,
@@ -3582,7 +3871,8 @@ intel_dp_compute_config(struct intel_atomic_state *state,
 	 * that fails assume the user might know something we don't.
 	 */
 	ret = intel_dp_compute_formats(encoder, pipe_config, conn_state, true);
-	if (ret)
+	/* Hades: the tunnel never goes past the converter's TMDS limit (as through native HDMI) */
+	if (ret && !to_intel_digital_connector_state(conn_state)->dv_lab_standard)
 		ret = intel_dp_compute_formats(encoder, pipe_config, conn_state, false);
 	if (ret)
 		return ret;
@@ -3656,6 +3946,11 @@ intel_dp_compute_config(struct intel_atomic_state *state,
 	intel_dp_compute_vsc_sdp(intel_dp, pipe_config, conn_state);
 	intel_dp_compute_hdr_metadata_infoframe_sdp(intel_dp, pipe_config, conn_state);
 
+	/* Hades: the tunnel through the converter of the board, after what its checks look at */
+	ret = intel_dp_pcon_dv_compute_config(intel_dp, pipe_config, conn_state);
+	if (ret)
+		return ret;
+
 	return intel_dp_tunnel_atomic_compute_stream_bw(state, intel_dp, connector,
 							pipe_config);
 }
@@ -5373,6 +5668,9 @@ void intel_dp_set_infoframes(struct intel_encoder *encoder,
 	intel_write_dp_sdp(encoder, crtc_state, DP_SDP_ADAPTIVE_SYNC);
 
 	intel_write_dp_sdp(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA);
+
+	/* Hades: the AVI and Dolby vendor InfoFrames of the tunnel through a converter */
+	intel_dp_pcon_dv_write(encoder, crtc_state);
 }
 
 static
@@ -6193,6 +6491,18 @@ intel_dp_set_edid(struct intel_dp *intel_dp)
 	intel_dp_update_dfp(intel_dp, drm_edid);
 	intel_dp_update_420(intel_dp);
 
+	/*
+	 * Hades: what the EDID says of Dolby Vision (drm_dvbridge.h) for the atomic check of the
+	 * tunnel, and what is behind the port (the display info and the branch device are read now)
+	 */
+	if (connector->dv_lab_property) {
+		const struct drm_property_blob *blob = connector->base.edid_blob_ptr;
+
+		drm_dvbridge_edid_read(blob ? blob->data : NULL, blob ? blob->length : 0,
+				       &connector->dv_sink);
+		intel_dp_pcon_dv_update(intel_dp, true);
+	}
+
 	drm_dp_cec_attach(&intel_dp->aux,
 			  connector->base.display_info.source_physical_address);
 }
@@ -6216,6 +6526,12 @@ intel_dp_unset_edid(struct intel_dp *intel_dp)
