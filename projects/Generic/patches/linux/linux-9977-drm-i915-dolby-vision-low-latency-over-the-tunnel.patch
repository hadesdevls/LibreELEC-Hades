From f183bd8798eb35246c3041ebaaf44c1ca553fe9a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:59:19 +0000
Subject: [PATCH] drm/i915: Dolby Vision Low-Latency over the tunnel

As for amdgpu: DVBRIDGE_DV_LOW_LATENCY_LAB next to
DVBRIDGE_DV_STANDARD_LAB (gated by enable_dv_lab as well); with both
set, the Low-Latency AVI InfoFrame and Dolby VSIF of drm_dvbridge_ll.h
and the Low-Latency rule for the sink, with the checks of the tunnel as
they are. A change of it with the tunnel on is a full modeset, from the
connector check and from intel_crtc_check_fastset(), which now compares
the Low-Latency bit of the Dolby VSIF of the two states as well. A
disabled connector drops it with the tunnel, and a refused sink gives
the Low-Latency reason in the kernel log.

i915 cannot send YCbCr 4:2:2 over HDMI by itself, so this is its only
way to the Low-Latency input. xe builds the same files.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 22 +++++++++++-
 drivers/gpu/drm/i915/display/intel_display.c  |  9 ++++-
 .../drm/i915/display/intel_display_types.h    |  7 ++++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 36 ++++++++++++++++---
 4 files changed, 68 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index a2af559c0..7e806cb4e 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -69,6 +69,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_standard;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_lab_ll_property &&
+	    property == to_intel_connector(connector)->dv_lab_ll_property) {
+		*val = intel_conn_state->dv_lab_low_latency;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		*val = intel_conn_state->dv_hdr10_deep_color;
@@ -121,6 +126,16 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_standard = val;
 		return 0;
 	}
+	/* Hades: Low-Latency over the tunnel (drm_dvbridge_ll.h) */
+	if (to_intel_connector(connector)->dv_lab_ll_property &&
+	    property == to_intel_connector(connector)->dv_lab_ll_property) {
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !display->params.enable_dv_lab)
+			return -EOPNOTSUPP;
+		intel_conn_state->dv_lab_low_latency = val;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_hdr10_property &&
 	    property == to_intel_connector(connector)->dv_hdr10_property) {
 		if (val > 1)
@@ -167,6 +182,8 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 
 	if (!new_state->crtc) {
 		new_conn_state->dv_lab_standard = false;
+		/* Hades: ... and Low-Latency over the tunnel */
+		new_conn_state->dv_lab_low_latency = false;
 		/* Hades: a disabled connector drops the HDR10 depth guard as well */
 		new_conn_state->dv_hdr10_deep_color = false;
 		return 0;
@@ -179,9 +196,12 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	 * up in a modeset.
 	 * (Hades: the HDR10 depth guard as well. It changes nothing of the output: the
 	 * configuration is computed again only so that the guard sees the depth of the link.
-	 * And DVBRIDGE_HDR_YCBCR420, which can change the format of HDR: a full modeset then.)
+	 * And DVBRIDGE_HDR_YCBCR420, which can change the format of HDR: a full modeset then.
+	 * And going from Standard to Low-Latency, or back, with the tunnel on.)
 	 */
 	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
+	    (new_conn_state->dv_lab_standard &&
+	     new_conn_state->dv_lab_low_latency != old_conn_state->dv_lab_low_latency) ||
 	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
 	    new_conn_state->dv_hdr_ycbcr420 != old_conn_state->dv_hdr_ycbcr420 ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
diff --git a/drivers/gpu/drm/i915/display/intel_display.c b/drivers/gpu/drm/i915/display/intel_display.c
index ede341cd0..05d13d53c 100644
--- a/drivers/gpu/drm/i915/display/intel_display.c
+++ b/drivers/gpu/drm/i915/display/intel_display.c
@@ -4280,6 +4280,12 @@ static bool intel_dv_lab_active(const struct intel_crtc_state *state)
 		state->infoframes.hdmi.vendor.dolby.signal;
 }
 
+/* Hades: the tunnel carries Dolby Vision Low-Latency (drm_dvbridge_ll.h) */
+static bool intel_dv_lab_low_latency(const struct intel_crtc_state *state)
+{
+	return intel_dv_lab_active(state) && state->infoframes.hdmi.vendor.dolby.low_latency;
+}
+
 static int intel_dv_lab_scanout_check(struct intel_atomic_state *state,
 				     struct intel_crtc *crtc)
 {
@@ -5912,7 +5918,8 @@ static void intel_crtc_check_fastset(const struct intel_crtc_state *old_crtc_sta
 	struct intel_crtc *crtc = to_intel_crtc(new_crtc_state->uapi.crtc);
 
 	/* Never transition the private vendor mode through the HDR-only fastset. */
-	if (intel_dv_lab_active(old_crtc_state) != intel_dv_lab_active(new_crtc_state)) {
+	if (intel_dv_lab_active(old_crtc_state) != intel_dv_lab_active(new_crtc_state) ||
+	    intel_dv_lab_low_latency(old_crtc_state) != intel_dv_lab_low_latency(new_crtc_state)) {
 		new_crtc_state->uapi.mode_changed = true;
 		new_crtc_state->update_lrr = false;
 		new_crtc_state->update_m_n = false;
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 173d5cdbf..132014883 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -522,6 +522,8 @@ struct intel_connector {
 	struct drm_connector base;
 	/* Private experimental property; gated by enable_dv_lab. */
 	struct drm_property *dv_lab_property;
+	/* Hades: DVBRIDGE_DV_LOW_LATENCY_LAB, Low-Latency over that tunnel (drm_dvbridge_ll.h) */
+	struct drm_property *dv_lab_ll_property;
 	/*
 	 * Hades, gated by enable_dv_lab too: DVBRIDGE_HDR10_DEEP_COLOR, the guard that refuses a
 	 * commit sending HDR10 with fewer than 10 bits per component, and DVBRIDGE_REFUSED, why
@@ -634,6 +636,11 @@ struct intel_digital_connector_state {
 	struct drm_connector_state base;
 	/* Scalar copy/reset lifecycle, no property-blob reference to leak. */
 	bool dv_lab_standard;
+	/*
+	 * Hades: DVBRIDGE_DV_LOW_LATENCY_LAB: with the tunnel requested, it carries Dolby Vision
+	 * Low-Latency (drm_dvbridge_ll.h); without it, nothing
+	 */
+	bool dv_lab_low_latency;
 	/* Hades: DVBRIDGE_HDR10_DEEP_COLOR (scalar as well) */
 	bool dv_hdr10_deep_color;
 	/*
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 6f852ac53..9c3567c3a 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -39,6 +39,7 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_dvbridge_hdr.h>
+#include <drm/drm_dvbridge_ll.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
@@ -781,6 +782,9 @@ intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 		frame->colorimetry = HDMI_COLORIMETRY_NONE;
 		frame->extended_colorimetry = 0;
 		frame->quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
+		/* Hades: what the sink's Low-Latency input reads the same bytes as */
+		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
+			drm_dvbridge_ll_avi(frame);
 	}
 
 	/* TODO: handle pixel repetition for YCBCR420 outputs */
@@ -853,6 +857,9 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 			return false;
 		hdmi_dolby_vendor_infoframe_init(dv);
 		dv->signal = true;
+		/* Hades: ... with low latency (drm_dvbridge_ll.h) */
+		if (to_intel_digital_connector_state(conn_state)->dv_lab_low_latency)
+			drm_dvbridge_ll_vsif(dv);
 		return hdmi_dolby_vendor_infoframe_check(dv) == 0;
 	}
 
@@ -2577,7 +2584,7 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 					      struct intel_connector *connector,
 					      const struct intel_crtc_state *pipe_config,
 					      const struct intel_dv_lab_link *link, u64 bits,
-					      char *buf, size_t size)
+					      bool low_latency, char *buf, size_t size)
 {
 	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
 	struct intel_hdmi *hdmi = enc_to_intel_hdmi(encoder);
@@ -2589,7 +2596,12 @@ static void intel_hdmi_dvbridge_tunnel_detail(struct intel_encoder *encoder,
 		len += scnprintf(buf + len, size - len, "%sdisplay version %u, enable_dv_lab %d",
 				 len ? "; " : "", DISPLAY_VER(to_intel_display(encoder)),
 				 to_intel_display(encoder)->params.enable_dv_lab);
-	if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID))
+	if ((bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID)) && low_latency)
+		/* Hades: the rule of Low-Latency over the tunnel (drm_dvbridge_ll.h) */
+		len += scnprintf(buf + len, size - len, "%sLow-Latency: %s", len ? "; " : "",
+				 drm_dvbridge_ll_edid_why(edid ? edid->data : NULL,
+							  edid ? edid->length : 0) ?: "EDID");
+	else if (bits & BIT_ULL(DRM_DVBRIDGE_REFUSED_EDID))
 		len += scnprintf(buf + len, size - len, "%s%s", len ? "; " : "",
 				 intel_dv_lab_edid_why(edid ? edid->data : NULL,
 						       edid ? edid->length : 0) ?: "EDID");
@@ -2773,7 +2785,15 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
 		/* (Hades: read before the link below, whose initializers are not sequenced) */
 		bool p60 = false;
-		const bool standard = edid && intel_dv_lab_edid(edid->data, edid->length, &p60);
+		/*
+		 * Hades: the sink takes the tunnel requested, Standard or Low-Latency
+		 * (drm_dvbridge_ll.h); sink_standard below is that answer
+		 */
+		const bool low_latency =
+			to_intel_digital_connector_state(conn_state)->dv_lab_low_latency;
+		const bool standard = edid &&
+			(low_latency ? drm_dvbridge_ll_edid(edid->data, edid->length, &p60) :
+				       intel_dv_lab_edid(edid->data, edid->length, &p60));
 		struct intel_dv_lab_link link = {
 			.requested = true,
 			.lab_enabled = display->params.enable_dv_lab &&
@@ -2808,7 +2828,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 							       INTEL_OUTPUT_FORMAT_YCBCR420);
 
 			intel_hdmi_dvbridge_tunnel_detail(encoder, connector, pipe_config, &link,
-							  bits, detail, sizeof(detail));
+							  bits, low_latency, detail, sizeof(detail));
 			intel_hdmi_dvbridge_refused(connector, bits, detail);
 			return ret;
 		}
@@ -3125,6 +3145,14 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_STANDARD_LAB");
 		if (connector->dv_lab_property)
 			drm_object_attach_property(&_connector->base, connector->dv_lab_property, 0);
+		/* Hades: Low-Latency over the same tunnel (drm_dvbridge_ll.h) */
+		if (connector->dv_lab_property) {
+			connector->dv_lab_ll_property = drm_property_create_bool(display->drm,
+				DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_LOW_LATENCY_LAB");
+			if (connector->dv_lab_ll_property)
+				drm_object_attach_property(&_connector->base,
+							   connector->dv_lab_ll_property, 0);
+		}
 	}
 
 	intel_attach_force_audio_property(&connector->base);
-- 
2.53.0

