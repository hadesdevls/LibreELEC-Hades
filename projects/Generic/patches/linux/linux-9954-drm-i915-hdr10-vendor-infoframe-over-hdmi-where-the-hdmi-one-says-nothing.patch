 	dig_port->write_infoframe(encoder, crtc_state, type, buffer, len);
 }
 
+/* Hades: the vendor DIP, with the HDR10+ InfoFrame where there is one (intel_hdr10plus.h) */
+static void intel_hdmi_write_vendor_infoframe(struct intel_encoder *encoder,
+					      const struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	u8 buffer[VIDEO_DIP_DATA_SIZE];
+
+	BUILD_BUG_ON(sizeof(buffer) < DRM_HDR10PLUS_INFOFRAME_SIZE + 1);
+
+	if (!intel_hdr10plus_active(crtc_state->infoframes.hdr10plus)) {
+		intel_write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_VENDOR,
+				      &crtc_state->infoframes.hdmi);
+		return;
+	}
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) == 0)
+		return;
+	intel_hdr10plus_to_dip(crtc_state->infoframes.hdr10plus, buffer);
+	dig_port->write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_VENDOR, buffer,
+				  DRM_HDR10PLUS_INFOFRAME_SIZE + 1);
+}
+
+/* Hades: the vendor DIP holds an HDR10+ InfoFrame (intel_hdr10plus.h) */
+static bool intel_hdmi_hdr10plus_in_dip(struct intel_encoder *encoder,
+					const struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	u32 dip[2];
+
+	dig_port->read_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_VENDOR, dip, sizeof(dip));
+	return intel_hdr10plus_dip_holds((const u8 *)dip);
+}
+
+/* Hades: the readout of HDR10PLUS_VSIF, the HDR10+ InfoFrame of the vendor DIP (intel_hdr10plus.h) */
+void intel_hdmi_read_hdr10plus(struct intel_encoder *encoder, struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	u8 buffer[VIDEO_DIP_DATA_SIZE];
+
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) == 0)
+		return;
+	dig_port->read_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_VENDOR, buffer,
+				 sizeof(buffer));
+	if (intel_hdr10plus_dip_holds(buffer))
+		intel_hdr10plus_from_dip(buffer, crtc_state->infoframes.hdr10plus);
+}
+
 void intel_read_infoframe(struct intel_encoder *encoder,
 			  const struct intel_crtc_state *crtc_state,
 			  enum hdmi_infoframe_type type,
@@ -725,6 +774,52 @@ void intel_read_infoframe(struct intel_encoder *encoder,
 			    frame->any.type, type);
 }
 
+/*
+ * Hades: the CTA VIC with which the mode of this configuration goes out in the AVI InfoFrame, in
+ * place of its HDMI VIC, for HDR10+ (intel_hdr10plus_cta_vic()); 0 where it goes out as DRM
+ * signals it.
+ */
+static u8 intel_hdmi_hdr10plus_cta_vic(const struct intel_crtc_state *crtc_state,
+				       const struct drm_connector_state *conn_state)
+{
+	struct drm_connector *connector = conn_state->connector;
+	const struct drm_display_info *info = &connector->display_info;
+	const struct drm_display_mode *mode = &crtc_state->hw.adjusted_mode;
+	struct intel_atomic_state *state = crtc_state->uapi.state ?
+		to_intel_atomic_state(crtc_state->uapi.state) : NULL;
+	const struct edid *edid = drm_edid_raw(to_intel_connector(connector)->detect_edid);
+	struct hdmi_vendor_infoframe vsi;
+	bool listed = false, kept = false;
+	u8 cta_vic, hdmi_vic = 0;
+	int i;
+
+	if (!crtc_state->has_infoframe || !info->has_hdmi_infoframe ||
+	    to_intel_digital_connector_state(conn_state)->dv_lab_standard)
+		return 0;
+
+	if (drm_hdmi_vendor_infoframe_from_display_mode(&vsi, connector, mode) == 0)
+		hdmi_vic = vsi.vic;
+	cta_vic = drm_match_cea_mode(mode);
+	for (i = 0; cta_vic && info->vics && i < info->vics_len; i++)
+		listed |= info->vics[i] == cta_vic;
+
+	/* (any commit that keeps the mode, with or without ALLOW_MODESET) */
+	if (state && crtc_state->uapi.crtc) {
+		const struct intel_crtc_state *old_crtc_state =
+			intel_atomic_get_old_crtc_state(state, to_intel_crtc(crtc_state->uapi.crtc));
+
+		kept = old_crtc_state &&
+		       intel_hdr10plus_cta_vic_kept(old_crtc_state->infoframes.avi.avi.video_code,
+						    cta_vic,
+						    drm_mode_equal(&old_crtc_state->hw.adjusted_mode, mode));
+	}
+
+	return intel_hdr10plus_cta_vic(hdmi_vic, cta_vic, info->hdmi.scdc.supported, listed,
+				       edid && intel_hdr10plus_edid_declares((const u8 *)edid,
+							(edid->extensions + 1) * EDID_LENGTH),
+				       conn_state->hdr10plus_vsif != NULL, kept);
+}
+
 static bool
 intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 				 struct intel_crtc_state *crtc_state,
@@ -787,6 +882,9 @@ intel_hdmi_compute_avi_infoframe(struct intel_encoder *encoder,
 			drm_dvbridge_ll_avi(frame);
 	}
 
+	/* Hades: the CTA VIC in place of the HDMI VIC, where HDR10+ takes the vendor DIP (intel_hdr10plus.h) */
+	intel_hdr10plus_avi_cta_vic(frame, intel_hdmi_hdr10plus_cta_vic(crtc_state, conn_state));
+
 	/* TODO: handle pixel repetition for YCBCR420 outputs */
 
 	ret = hdmi_avi_infoframe_check(frame);
@@ -839,6 +937,15 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 		&conn_state->connector->display_info;
 	int ret;
 
+	/*
+	 * Hades: HDR10PLUS_VSIF only to a sink that takes vendor InfoFrames, and never with the
+	 * Dolby VSIF, which takes the vendor DIP (intel_hdr10plus.h)
+	 */
+	if (conn_state->hdr10plus_vsif &&
+	    (!crtc_state->has_infoframe || !info->has_hdmi_infoframe ||
+	     to_intel_digital_connector_state(conn_state)->dv_lab_standard))
+		return false;
+
 	if (!crtc_state->has_infoframe || !info->has_hdmi_infoframe)
 		return true;
 
@@ -869,10 +976,31 @@ intel_hdmi_compute_hdmi_infoframe(struct intel_encoder *encoder,
 	if (drm_WARN_ON(encoder->base.dev, ret))
 		return false;
 
+	/* Hades: ... and then no HDMI VIC here (intel_hdr10plus.h) */
+	intel_hdr10plus_vsi_cta_vic(frame, intel_hdmi_hdr10plus_cta_vic(crtc_state, conn_state));
+
 	ret = hdmi_vendor_infoframe_check(frame);
 	if (drm_WARN_ON(encoder->base.dev, ret))
 		return false;
 
+	/* Hades: HDR10PLUS_VSIF (intel_hdr10plus.h) */
+	if (conn_state->hdr10plus_vsif) {
+		const struct drm_property_blob *blob = conn_state->hdr10plus_vsif;
+
+		if (!intel_hdr10plus_vsi_empty(frame)) {
+			/* (in the kernel log, once: user space only learns that the commit failed) */
+			drm_info_once(encoder->base.dev,
+				      "HDR10+ refused: the HDMI vendor InfoFrame carries the HDMI VIC %u (its CTA VIC needs an HDMI 2.0 sink that lists it and declares HDR10+, and HDR10+ in the commit of the mode), or 3D\n",
+				      frame->vic);
+			return false;
+		}
+		memset(&crtc_state->infoframes.hdmi, 0, sizeof(crtc_state->infoframes.hdmi));
+		if (drm_hdr10plus_hdmi_infoframe_pack(blob->data, blob->length,
+						      crtc_state->infoframes.hdr10plus,
+						      sizeof(crtc_state->infoframes.hdr10plus)) < 0)
+			return false;
+	}
+
 	return true;
 }
 
@@ -1261,6 +1389,21 @@ static void vlv_set_infoframes(struct intel_encoder *encoder,
 			      &crtc_state->infoframes.hdmi);
 }
 
+/*
+ * Hades: HDR10PLUS_VSIF changes the vendor DIP with a fastset (intel_hdr10plus.h): written again
+ * where it sends HDR10+, or did. Before intel_hdmi_fastset_infoframes(), which reads the control
+ * register of the DIPs once.
+ */
+void intel_hdmi_fastset_hdr10plus(struct intel_encoder *encoder,
+				  const struct intel_crtc_state *crtc_state)
+{
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) &&
+	    (intel_hdr10plus_active(crtc_state->infoframes.hdr10plus) ||
+	     intel_hdmi_hdr10plus_in_dip(encoder, crtc_state)))
+		intel_hdmi_write_vendor_infoframe(encoder, crtc_state);
+}
+
 void intel_hdmi_fastset_infoframes(struct intel_encoder *encoder,
 				   const struct intel_crtc_state *crtc_state,
 				   const struct drm_connector_state *conn_state)
@@ -1321,9 +1464,7 @@ static void hsw_set_infoframes(struct intel_encoder *encoder,
 	intel_write_infoframe(encoder, crtc_state,
 			      HDMI_INFOFRAME_TYPE_SPD,
 			      &crtc_state->infoframes.spd);
-	intel_write_infoframe(encoder, crtc_state,
-			      HDMI_INFOFRAME_TYPE_VENDOR,
-			      &crtc_state->infoframes.hdmi);
+	intel_hdmi_write_vendor_infoframe(encoder, crtc_state); /* Hades */
 	intel_write_infoframe(encoder, crtc_state,
 			      HDMI_INFOFRAME_TYPE_DRM,
 			      &crtc_state->infoframes.drm);
@@ -3164,6 +3305,8 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 
 	if (DISPLAY_VER(display) >= 10) {
 		drm_connector_attach_hdr_output_metadata_property(&connector->base);
+		/* Hades: HDR10PLUS_VSIF (intel_hdr10plus.h) */
+		drm_connector_attach_hdr10plus_vsif_property(&connector->base);
 
 		/*
 		 * Hades: the HDR10 depth guard, where HDR metadata can be sent (it acts only with
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.h b/drivers/gpu/drm/i915/display/intel_hdmi.h
index 0fa366156..96471a0e2 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.h
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.h
@@ -44,6 +44,9 @@ void intel_hdmi_read_gcp_infoframe(struct intel_encoder *encoder,
 void intel_hdmi_fastset_infoframes(struct intel_encoder *encoder,
 				   const struct intel_crtc_state *crtc_state,
