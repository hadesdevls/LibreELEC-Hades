+void intel_hdmi_read_hdr10plus(struct intel_encoder *encoder, struct intel_crtc_state *crtc_state);
+void intel_hdmi_fastset_hdr10plus(struct intel_encoder *encoder,
+				  const struct intel_crtc_state *crtc_state);
 void intel_read_infoframe(struct intel_encoder *encoder,
 			  const struct intel_crtc_state *crtc_state,
 			  enum hdmi_infoframe_type type,
diff --git a/drivers/gpu/drm/i915/display/intel_hdr10plus.h b/drivers/gpu/drm/i915/display/intel_hdr10plus.h
new file mode 100644
index 000000000..b03e90abc
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_hdr10plus.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: HDR10PLUS_VSIF on i915 and xe (drm_hdr10plus.h), over HDMI. The HDR10+ vendor-specific
+ * InfoFrame takes the vendor DIP, the only one the transcoder has for a vendor InfoFrame, and only
+ * where the HDMI one carries nothing: no HDMI VIC (DRM puts the VIC of 2160p24, 25 and 30 there,
+ * drm_mode_hdmi_vic(), and 0 in the AVI InfoFrame), no 3D. A mode with an HDMI VIC goes out with
+ * its CTA VIC in the AVI InfoFrame instead, and an HDMI vendor InfoFrame without the HDMI VIC,
+ * where HDR10+ needs the DIP and the sink can take that (intel_hdr10plus_cta_vic()). Elsewhere,
+ * sending HDR10+ would take the format away from the sink, so the configuration is refused and
+ * user space keeps HDR10. Never with the Dolby Vision tunnel, whose Dolby VSIF is in that DIP.
+ *
+ * A change of HDR10PLUS_VSIF is a fastset, as one of HDR_OUTPUT_METADATA is: the vendor DIP is
+ * written again (intel_hdmi_fastset_infoframes()), with nothing else of the output changed.
+ *
+ * Not over DisplayPort: there the HDR10+ InfoFrame SDP is 33 bytes (drm_hdr10plus_dp_sdp_pack())
+ * and the free DIP (the vendor one) holds 32 (VIDEO_DIP_DATA_SIZE); the gamut metadata DIP, of
+ * 36 bytes since display version 11, carries the HDR InfoFrame SDP.
+ *
+ * crtc_state->infoframes.hdr10plus holds the InfoFrame (drm_hdr10plus_hdmi_infoframe_pack()), all
+ * zero for none; with it infoframes.hdmi is all zero, as the readout leaves it (the vendor
+ * InfoFrame of the DIP is not one hdmi_infoframe_unpack() knows).
+ */
+#ifndef __INTEL_HDR10PLUS_H__
+#define __INTEL_HDR10PLUS_H__
+
+#include <drm/drm_hdr10plus.h>
+#include <linux/hdmi.h>
+
+/* The HDMI vendor InfoFrame of a configuration carries nothing that HDR10+ would take away */
+static inline bool intel_hdr10plus_vsi_empty(const struct hdmi_vendor_infoframe *vsi)
+{
+	return vsi->oui == HDMI_IEEE_OUI && vsi->vic == 0 &&
+	       vsi->s3d_struct == HDMI_3D_STRUCTURE_INVALID;
+}
+
+/* infoframes.hdr10plus holds an InfoFrame */
+static inline bool intel_hdr10plus_active(const u8 *frame)
+{
+	return frame[0] == 0x81;
+}
+
+/*
+ * The DIP layout of the InfoFrame (DRM_HDR10PLUS_INFOFRAME_SIZE + 1 bytes): its header, the
+ * zero byte at 3 (see the comment above intel_write_infoframe()), the checksum and the payload.
+ */
+static inline void intel_hdr10plus_to_dip(const u8 *frame, u8 *dip)
+{
+	memcpy(dip, frame, 3);
+	dip[3] = 0;
+	memcpy(&dip[4], &frame[3], DRM_HDR10PLUS_INFOFRAME_SIZE - 3);
+}
+
+/* The vendor DIP, as read back (at least 8 bytes), holds an HDR10+ InfoFrame */
+static inline bool intel_hdr10plus_dip_holds(const u8 *dip)
+{
+	return dip[0] == 0x81 && dip[1] == 0x01 && dip[2] == DRM_HDR10PLUS_VSIF_SIZE &&
+	       dip[5] == 0x8b && dip[6] == 0x84 && dip[7] == 0x90;
+}
+
+static inline void intel_hdr10plus_from_dip(const u8 *dip, u8 *frame)
+{
+	memcpy(frame, dip, 3);
+	memcpy(&frame[3], &dip[4], DRM_HDR10PLUS_INFOFRAME_SIZE - 3);
+}
+
+/*
+ * A fastset may change the vendor DIP between two configurations: one of them sends HDR10+ (the
+ * other then has the same mode, so the same empty HDMI vendor InfoFrame, or HDR10+ as well).
+ */
+static inline bool intel_hdr10plus_fastset_vendor(const u8 *old_frame, const u8 *new_frame)
+{
+	return intel_hdr10plus_active(old_frame) || intel_hdr10plus_active(new_frame);
+}
+
+/*
+ * The EDID (size bytes) declares HDR10+: a CTA-861 extension with the HDR10+ vendor-specific video
+ * data block (extended tag 1, IEEE OUI 90-84-8B), application version 1 or later, as user space
+ * asks for it before it sends HDR10PLUS_VSIF (Kodi).
+ */
+static inline bool intel_hdr10plus_edid_declares(const u8 *edid, size_t size)
+{
+	size_t b;
+
+	for (b = 128; edid && b + 128 <= size; b += 128) {
+		const u8 *ext = &edid[b];
+		unsigned int end = ext[2], i = 4;
+
+		if (ext[0] != 0x02 || end < 4 || end > 127)
+			continue;
+		while (i < end) {
+			unsigned int tag = ext[i] >> 5, len = ext[i] & 0x1f;
+
+			if (i + 1 + len > end)
+				break;
+			if (tag == 7 && len >= 5 && ext[i + 1] == 0x01 &&
+			    ext[i + 2] == 0x8b && ext[i + 3] == 0x84 && ext[i + 4] == 0x90 &&
+			    (ext[i + 5] & 0x3) >= 1)
+				return true;
+			i += 1 + len;
+		}
+	}
+	return false;
+}
+
+/*
+ * The CTA VIC that a mode goes out with in the AVI InfoFrame, in place of the HDMI VIC with which
+ * DRM signals it (hdmi_vic: 2160p24, 25 and 30, 4096x2160p24, and their 1000/1001 rates), so that
+ * the vendor DIP carries HDR10+ and the HDMI vendor InfoFrame goes without the HDMI VIC; as NVKMS
+ * signals these modes, and as Amlogic sends HDR10+ next to them. Only:
+ *  - for a mode with an HDMI VIC whose CTA VIC (cta_vic) the sink lists in its video data block;
+ *  - to an HDMI 2.0 sink (SCDC) that declares HDR10+ (intel_hdr10plus_edid_declares());
+ *  - with HDR10PLUS_VSIF in the commit (requested), or in any commit of the same mode as the one on
+ *    the screen, which went out with the CTA VIC already (kept, intel_hdr10plus_cta_vic_kept()),
+ *    whether it may change the mode or not: the end of HDR10+, the end of the video and the next
+ *    video at that mode change the signalling of nothing, and the mode goes out as DRM signals it
+ *    again with the next change of mode.
+ * 0 elsewhere: the mode goes out exactly as DRM signals it (SDR and HDR10 among them). DRM gives no
+ * HDMI VIC with 3D; the Dolby Vision tunnel is left out by the caller.
+ */
+static inline u8 intel_hdr10plus_cta_vic(u8 hdmi_vic, u8 cta_vic, bool hdmi2, bool listed,
+					 bool declares, bool requested, bool kept)
+{
+	if (!hdmi_vic || !cta_vic || !hdmi2 || !listed || !declares)
+		return 0;
+	return (requested || kept) ? cta_vic : 0;
+}
+
+/*
+ * kept of intel_hdr10plus_cta_vic(): the configuration on the screen (old_avi_vic, the VIC of its AVI
+ * InfoFrame) went out with the CTA VIC of the mode, and the new one has the same mode (same_mode)
+ */
+static inline bool intel_hdr10plus_cta_vic_kept(u8 old_avi_vic, u8 cta_vic, bool same_mode)
+{
+	return cta_vic && old_avi_vic == cta_vic && same_mode;
+}
+
+/* The AVI InfoFrame with the CTA VIC of intel_hdr10plus_cta_vic(), where it gives one */
+static inline void intel_hdr10plus_avi_cta_vic(struct hdmi_avi_infoframe *avi, u8 cta_vic)
+{
+	if (cta_vic)
+		avi->video_code = cta_vic;
+}
+
+/* The HDMI vendor InfoFrame without the HDMI VIC there (hdmi_vendor_infoframe_check() then sizes it) */
+static inline void intel_hdr10plus_vsi_cta_vic(struct hdmi_vendor_infoframe *vsi, u8 cta_vic)
+{
+	if (cta_vic)
+		vsi->vic = 0;
+}
+
+#endif /* __INTEL_HDR10PLUS_H__ */
