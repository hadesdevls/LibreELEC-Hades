+	intel_hdmi_fastset_hdr10plus(encoder, crtc_state); /* Hades */
 	intel_hdmi_fastset_infoframes(encoder, crtc_state, conn_state);
 }
 
@@ -4211,6 +4212,7 @@ static void intel_ddi_get_config(struct intel_encoder *encoder,
