diff --git a/include/drm/drm_hdr10plus.h b/include/drm/drm_hdr10plus.h
new file mode 100644
index 000000000..28e9528e4
--- /dev/null
+++ b/include/drm/drm_hdr10plus.h
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: HDR10+ out of a connector. HDR10PLUS_VSIF is the payload of the HDR10+ vendor-specific
+ * InfoFrame of each frame (SMPTE ST 2094-40 dynamic metadata, laid out as the HDR10+ technical
+ * specification lays it out: the IEEE OUI 90-84-8B, least significant byte first, and 24 bytes),
+ * which user space sets with the commit that flips that frame. A driver gives the property to the
+ * connectors where it sends that InfoFrame next to the one of HDR_OUTPUT_METADATA, in a slot of
+ * its own, with a commit and never as a change of mode, and refuses a commit it cannot honour.
+ *
+ * Only the framing is here, one for every driver; the payload is user space's, byte for byte:
+ *
+ * - HDMI: the InfoFrame, type 0x81, version 1, length 27, its checksum and the payload;
+ * - DisplayPort: the same InfoFrame in an InfoFrame SDP (version 1.3: HB1 the InfoFrame type,
+ *   HB2 0x1d, HB3 0x13 << 2; DB0 the InfoFrame version, DB1 its length, then the payload, no
+ *   checksum), the form in which DRM drivers send the HDR one.
+ */
+#ifndef __DRM_HDR10PLUS_H__
+#define __DRM_HDR10PLUS_H__
+
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+/* the payload: the OUI and 24 bytes */
+#define DRM_HDR10PLUS_VSIF_SIZE 27
+/* HDMI: the header (type, version, length), the checksum and the payload */
+#define DRM_HDR10PLUS_INFOFRAME_SIZE (4 + DRM_HDR10PLUS_VSIF_SIZE)
+/* DisplayPort: the data bytes of the SDP that carry something (the version, the length, the payload) */
+#define DRM_HDR10PLUS_DP_SDP_DATA_SIZE (2 + DRM_HDR10PLUS_VSIF_SIZE)
+
+/* A payload as HDR10PLUS_VSIF takes it: exactly DRM_HDR10PLUS_VSIF_SIZE bytes, with the OUI. */
+static inline bool drm_hdr10plus_vsif_valid(const u8 *vsif, size_t size)
+{
+	return vsif && size == DRM_HDR10PLUS_VSIF_SIZE &&
+	       vsif[0] == 0x8b && vsif[1] == 0x84 && vsif[2] == 0x90;
+}
+
+/* HDMI: the InfoFrame of a payload into buf. Its size (DRM_HDR10PLUS_INFOFRAME_SIZE), or -errno. */
+static inline ssize_t drm_hdr10plus_hdmi_infoframe_pack(const u8 *vsif, size_t size,
+							 u8 *buf, size_t buf_size)
+{
+	u8 sum = 0;
+	size_t i;
+
+	if (!drm_hdr10plus_vsif_valid(vsif, size))
+		return -EINVAL;
+	if (buf_size < DRM_HDR10PLUS_INFOFRAME_SIZE)
+		return -ENOSPC;
+	buf[0] = 0x81;
+	buf[1] = 0x01;
+	buf[2] = DRM_HDR10PLUS_VSIF_SIZE;
+	buf[3] = 0;
+	memcpy(&buf[4], vsif, DRM_HDR10PLUS_VSIF_SIZE);
+	for (i = 0; i < DRM_HDR10PLUS_INFOFRAME_SIZE; i++)
+		sum += buf[i];
+	buf[3] = (u8)(0x100 - sum);
+	return DRM_HDR10PLUS_INFOFRAME_SIZE;
+}
+
+/*
+ * DisplayPort: the InfoFrame SDP of a payload, its four header bytes into hb and its data bytes
+ * into db (the rest of db_size, zero). The data bytes that carry something
+ * (DRM_HDR10PLUS_DP_SDP_DATA_SIZE), or -errno.
+ */
+static inline int drm_hdr10plus_dp_sdp_pack(const u8 *vsif, size_t size, u8 hb[4],
+					    u8 *db, size_t db_size)
+{
+	if (!drm_hdr10plus_vsif_valid(vsif, size))
+		return -EINVAL;
+	if (db_size < DRM_HDR10PLUS_DP_SDP_DATA_SIZE)
+		return -ENOSPC;
+	hb[0] = 0x00;
+	hb[1] = 0x81;
+	hb[2] = 0x1d;
+	hb[3] = 0x13 << 2;
+	memset(db, 0, db_size);
+	db[0] = 0x01;
+	db[1] = DRM_HDR10PLUS_VSIF_SIZE;
+	memcpy(&db[2], vsif, DRM_HDR10PLUS_VSIF_SIZE);
+	return DRM_HDR10PLUS_DP_SDP_DATA_SIZE;
+}
+
+#endif /* __DRM_HDR10PLUS_H__ */
