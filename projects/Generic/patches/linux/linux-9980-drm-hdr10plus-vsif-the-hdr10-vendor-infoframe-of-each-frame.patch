diff --git a/drivers/gpu/drm/drm_connector.c b/drivers/gpu/drm/drm_connector.c
index 11646453a..e1e243d74 100644
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -1706,6 +1706,18 @@ EXPORT_SYMBOL(drm_hdmi_connector_get_output_format_name);
  *	hdmi_drm_infoframe_pack() to pack the infoframe as per spec, in case of
  *	HDMI encoder.
  *
+ * HDR10PLUS_VSIF:
+ *	(Hades) Connector property for user space to send the HDR10+ dynamic
+ *	metadata of each frame: a blob of the payload of the HDR10+
+ *	vendor-specific InfoFrame (the IEEE OUI 90-84-8B, least significant
+ *	byte first, and 24 bytes: DRM_HDR10PLUS_VSIF_SIZE in all), set with
+ *	the commit that flips the frame; 0 for none. A driver attaches it only
+ *	to connectors where it sends that InfoFrame (an InfoFrame SDP over
+ *	DisplayPort, drm_hdr10plus.h) next to the one of HDR_OUTPUT_METADATA,
+ *	from the commit that sets it and never as a change of mode, and it
+ *	refuses a commit whose value it cannot send. User space reads the
+ *	sink's HDR10+ support in its EDID.
+ *
  * max bpc:
  *	This range property is used by userspace to limit the bit depth. When
  *	used the driver would limit the bpc in accordance with the valid range
@@ -1877,6 +1889,13 @@ int drm_connector_create_standard_properties(struct drm_device *dev)
 		return -ENOMEM;
 	dev->mode_config.hdr_output_metadata_property = prop;
 
+	/* Hades */
+	prop = drm_property_create(dev, DRM_MODE_PROP_BLOB,
+				   "HDR10PLUS_VSIF", 0);
+	if (!prop)
+		return -ENOMEM;
+	dev->mode_config.hdr10plus_vsif_property = prop;
+
 	return 0;
 }
 
@@ -2882,6 +2901,23 @@ void drm_connector_attach_hdr_output_metadata_property(struct drm_connector *con
 }
 EXPORT_SYMBOL(drm_connector_attach_hdr_output_metadata_property);
 
+/**
+ * drm_connector_attach_hdr10plus_vsif_property - attach "HDR10PLUS_VSIF" property
+ * @connector: connector to attach the property on.
+ *
+ * Hades: for a driver that sends the HDR10+ vendor-specific InfoFrame of
+ * &drm_connector_state.hdr10plus_vsif on this connector (see "HDR10PLUS_VSIF" in
+ * the standard connector properties).
+ */
+void drm_connector_attach_hdr10plus_vsif_property(struct drm_connector *connector)
+{
+	struct drm_device *dev = connector->dev;
+	struct drm_property *prop = dev->mode_config.hdr10plus_vsif_property;
+
+	drm_object_attach_property(&connector->base, prop, 0);
+}
+EXPORT_SYMBOL(drm_connector_attach_hdr10plus_vsif_property);
+
 /**
  * drm_connector_attach_broadcast_rgb_property - attach "Broadcast RGB" property
  * @connector: connector to attach the property on.
@@ -2963,6 +2999,27 @@ bool drm_connector_atomic_hdr_metadata_equal(struct drm_connector_state *old_sta
 }
 EXPORT_SYMBOL(drm_connector_atomic_hdr_metadata_equal);
 
+/**
+ * drm_connector_atomic_hdr10plus_vsif_equal - checks if the HDR10+ payload changed
+ * @old_state: old connector state to compare
+ * @new_state: new connector state to compare
+ *
+ * Hades: true if both states send the same HDR10+ vendor-specific InfoFrame, or none.
+ */
+bool drm_connector_atomic_hdr10plus_vsif_equal(const struct drm_connector_state *old_state,
+					       const struct drm_connector_state *new_state)
+{
+	const struct drm_property_blob *old_blob = old_state->hdr10plus_vsif;
+	const struct drm_property_blob *new_blob = new_state->hdr10plus_vsif;
+
+	if (!old_blob || !new_blob)
+		return old_blob == new_blob;
+
+	return old_blob->length == new_blob->length &&
+	       !memcmp(old_blob->data, new_blob->data, old_blob->length);
+}
+EXPORT_SYMBOL(drm_connector_atomic_hdr10plus_vsif_equal);
+
