From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:27:07 +0000
Subject: [PATCH] drm/edid: side-by-side (half) at 1080p for a 3D display that
 does not list the format

HDMI 1.4b (8.3.2) makes three layouts mandatory for a display that says
3D_present: frame packing and top-and-bottom at 1080p24 and at 720p50
and 60, and side-by-side (half) at 1080i50 and 60. drm_edid.c adds those
(stereo_mandatory_modes[]), and the others that the HDMI vendor block
lists (3D_Structure_ALL with 3D_MASK, and 2D_VIC_order). Side-by-side
(half) at 1080p is mandatory for none: a display that does not list it
gets no such mode, and a half side-by-side film at 50 or 60 Hz goes out
as an ordinary 2D picture that the display is switched to 3D by hand.

That is what cinemaONE saw with a JVC D-ILA projector on an RX 7600: a
half side-by-side clip fell back to 2D, and played as 1080p60
side-by-side 3D once a build gave that layout at 1080p 24, 50 and 60 Hz
to every 3D display (LibreELEC forum, thread 30362, post 208017; the
patch was his own, 0101 of cinema-ONE/LibreELEC.tv, and CroqueMr's
build carries it). Of the 584 EDIDs of the corpus that Hades tests with,
12 have 3D_present: the 9 that list their 3D formats list side-by-side
(half) for each of 1080p 24, 50 and 60 Hz that they have, and 3 list
nothing beyond the mandatory formats.

Written here, narrower than that patch: a 3D display gets side-by-side
(half) at 1080p 24, 50 and 60 Hz for each of those formats that its
vendor block says nothing of in 3D. A format that the block lists in 3D,
by 3D_Structure_ALL with a structure for it or by a 2D_VIC_order entry
of any structure, keeps exactly what the block lists, so a display that
lists other layouts than side-by-side for it gets none it did not list.
A display without 3D_present gets nothing, and the modes are added only
after the whole 3D part of the block has been read. The rate is matched
as the mandatory formats are (24 takes 23.976, 60 takes 59.94), and the
1000/1001 twins follow from add_alternate_cea_modes(), which carries the
3D flags. A display without 3D gets the same modes as before.

Where the display takes frame packing at the rate (1080p24, mandatory),
Kodi still chooses it over a half layout; these modes are used for half
side-by-side video at 50 and 60 Hz, and at 25 and 30 Hz shown twice.
Kodi's "Switch the display to 3D (HDMI)" set to off sends the halves as
a 2D picture as before.

KUnit (drm_edid_stereo, 5 cases, in UML): the mandatory formats and the
three new modes for a display that lists nothing; no 3D mode and the
same 2D modes for one without 3D_present; a list with side-by-side
(half) is not given a second copy; a list without it is kept; and a
2D_VIC_order entry for 1080p24 alone keeps 1080p24 as listed while 50
and 60 Hz get the new modes.

Not tried on a 3D display.
---
 drivers/gpu/drm/drm_edid.c                   |  88 +++++
 drivers/gpu/drm/tests/Makefile               |   1 +
 drivers/gpu/drm/tests/drm_edid_stereo_test.c | 321 +++++++++++++++++++
 3 files changed, 410 insertions(+)
 create mode 100644 drivers/gpu/drm/tests/drm_edid_stereo_test.c

diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index 07970e5b5f65..2367bc946623 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -4765,6 +4765,83 @@ static int add_hdmi_mandatory_stereo_modes(struct drm_connector *connector)
 	return modes;
 }
 
+/*
+ * Hades: side-by-side (half) at 1080p. HDMI 1.4b (8.3.2) makes it mandatory for a 3D display at
+ * 1080i only; at 1080p it is mandatory for none, and a display lists it in its HDMI vendor block
+ * (3D_Structure_ALL and 3D_MASK, or 2D_VIC_order with 3D_Structure). Every display of the corpus
+ * of 584 EDIDs that lists its 3D formats (9 of 12 with 3D_present) lists side-by-side (half) for
+ * each of 1080p 24, 50 and 60 Hz that it has, and a JVC D-ILA projector showed it at 1080p60 once
+ * a build gave it to every 3D display (cinemaONE, LibreELEC forum, thread 30362, post 208017).
+ * So a 3D display that says nothing in 3D of one of those three formats is taken to take it side
+ * by side (half); a format that it lists in 3D keeps exactly what it lists, and a display without
+ * 3D_present gets nothing.
+ */
+static const struct stereo_mandatory_mode stereo_sbs_1080p_modes[] = {
+	{ 1920, 1080, 24, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF },
+	{ 1920, 1080, 50, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF },
+	{ 1920, 1080, 60, DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF },
+};
+
+/* Hades: the HDMI vendor block lists 3D structures for the format of @mode (@listed: SVD indices) */
+static bool hdmi_3d_format_listed(const struct drm_connector *connector,
+				  const struct drm_display_mode *mode, u16 listed)
+{
+	const struct drm_display_info *info = &connector->display_info;
+	u8 vic = drm_match_cea_mode(mode);
+	int i;
+
+	if (!vic || !info->vics)
+		return false;
+
+	for (i = 0; i < 16 && i < info->vics_len; i++) {
+		if ((listed & BIT(i)) && info->vics[i] == vic)
+			return true;
+	}
+
+	return false;
+}
+
+/* Hades: side-by-side (half) at 1080p 24, 50 and 60 Hz where the block does not list the format */
+static int add_hdmi_sbs_1080p_modes(struct drm_connector *connector, u16 listed)
+{
+	struct drm_device *dev = connector->dev;
+	const struct drm_display_mode *mode;
+	struct list_head stereo_modes;
+	int modes = 0, i;
+
+	INIT_LIST_HEAD(&stereo_modes);
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (mode->flags & DRM_MODE_FLAG_3D_MASK)
+			continue;
+
+		for (i = 0; i < ARRAY_SIZE(stereo_sbs_1080p_modes); i++) {
+			struct drm_display_mode *new_mode;
+
+			if (!stereo_match_mandatory(mode, &stereo_sbs_1080p_modes[i]) ||
+			    hdmi_3d_format_listed(connector, mode, listed))
+				continue;
+
+			new_mode = drm_mode_duplicate(dev, mode);
+			if (!new_mode)
+				continue;
+
+			new_mode->flags |= stereo_sbs_1080p_modes[i].flags;
+			list_add_tail(&new_mode->head, &stereo_modes);
+			modes++;
+		}
+	}
+
+	if (modes)
+		drm_dbg_kms(dev,
+			    "[CONNECTOR:%d:%s] 3D: %d side-by-side (half) mode(s) at 1080p, not listed in 3D\n",
+			    connector->base.id, connector->name, modes);
+
+	list_splice_tail(&stereo_modes, &connector->probed_modes);
+
+	return modes;
+}
+
 static int add_hdmi_mode(struct drm_connector *connector, u8 vic)
 {
 	struct drm_device *dev = connector->dev;
@@ -4855,6 +4932,8 @@ do_hdmi_vsdb_modes(struct drm_connector *connector, const u8 *db, u8 len)
 	u8 vic_len, hdmi_3d_len = 0;
 	u16 mask;
 	u16 structure_all;
+	bool present_3d = false; /* Hades: 3D_present */
+	u16 listed = 0; /* Hades: the SVD indices that the block lists 3D structures for */
 
 	if (len < 8)
 		goto out;
@@ -4874,6 +4953,7 @@ do_hdmi_vsdb_modes(struct drm_connector *connector, const u8 *db, u8 len)
 	offset++;
 	if (db[8 + offset] & (1 << 7)) {
 		modes += add_hdmi_mandatory_stereo_modes(connector);
+		present_3d = true;
 
 		/* 3D_Multi_present */
 		multi_present = (db[8 + offset] & 0x60) >> 5;
@@ -4919,6 +4999,9 @@ do_hdmi_vsdb_modes(struct drm_connector *connector, const u8 *db, u8 len)
 				modes += add_3d_struct_modes(connector,
 							     structure_all, i);
 		}
+
+		if (structure_all)
+			listed |= mask;
 	}
 
 	offset += multi_len;
@@ -4936,6 +5019,7 @@ do_hdmi_vsdb_modes(struct drm_connector *connector, const u8 *db, u8 len)
 
 		/* 2D_VIC_order_X */
 		vic_index = db[8 + offset + i] >> 4;
+		listed |= BIT(vic_index);
 
 		/* 3D_Structure_X */
 		switch (db[8 + offset + i] & 0x0f) {
@@ -4967,6 +5051,10 @@ do_hdmi_vsdb_modes(struct drm_connector *connector, const u8 *db, u8 len)
 			i++;
 	}
 
+	/* Hades: only after the whole 3D part of the block has been read */
+	if (present_3d)
+		modes += add_hdmi_sbs_1080p_modes(connector, listed);
+
 out:
 	return modes;
 }
diff --git a/drivers/gpu/drm/tests/Makefile b/drivers/gpu/drm/tests/Makefile
index 8de21c676fb9..01eacd9a9042 100644
--- a/drivers/gpu/drm/tests/Makefile
+++ b/drivers/gpu/drm/tests/Makefile
@@ -11,6 +11,7 @@ obj-$(CONFIG_DRM_KUNIT_TEST) += \
 	drm_connector_test.o \
 	drm_damage_helper_test.o \
 	drm_dvbridge_test.o \
+	drm_edid_stereo_test.o \
 	drm_dp_mst_helper_test.o \
 	drm_exec_test.o \
 	drm_format_helper_test.o \
diff --git a/drivers/gpu/drm/tests/drm_edid_stereo_test.c b/drivers/gpu/drm/tests/drm_edid_stereo_test.c
new file mode 100644
index 000000000000..00a2556a9268
--- /dev/null
+++ b/drivers/gpu/drm/tests/drm_edid_stereo_test.c
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Hades: KUnit tests of the 3D modes that drm_edid.c lists for an HDMI display, from EDIDs made
+ * here: the formats that HDMI 1.4b makes mandatory for a 3D display (3D_present), the formats that
+ * the HDMI vendor block lists (3D_Structure_ALL with 3D_MASK, 2D_VIC_order), and side-by-side
+ * (half) at 1080p 24, 50 and 60 Hz for a 3D display that says nothing in 3D of that format. A
+ * display without 3D_present gets no 3D mode at all, and its 2D modes are the same either way.
+ */
+#include <kunit/test.h>
+
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modes.h>
+
+struct edid_stereo_priv {
+	struct drm_device drm;
+};
+
+static const struct drm_connector_funcs edid_stereo_connector_funcs = {
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.reset			= drm_atomic_helper_connector_reset,
+};
+
+/* 1080p60, 1080p50, 1080p24, 720p60, 720p50, 1080i60, 1080i50 */
+static const u8 edid_stereo_svds[] = { 16, 31, 32, 4, 19, 5, 20 };
+
+#define EDID_STEREO_SBS_HALF	(1 << 8)
+#define EDID_STEREO_TB		(1 << 6)
+
+static void edid_stereo_sum(u8 *b)
+{
+	unsigned int i, s = 0;
+
+	for (i = 0; i < 127; i++)
+		s += b[i];
+	b[127] = (u8)(256 - s % 256);
+}
+
+/*
+ * An EDID of two blocks: a base block, and a CTA extension with the video data block above and an
+ * HDMI vendor block (HDMI_Video_present, no latency fields). present: 3D_present; multi: 3D_Multi_present
+ * (0, or 1 with 3D_Structure_ALL @all); order: 2D_VIC_order and 3D_Structure entries (one byte
+ * each, without 3D_Detail), @n_order of them.
+ */
+static void edid_stereo_make(u8 *e, bool present, unsigned int multi, u16 all,
+			     const u8 *order, unsigned int n_order)
+{
+	static const u8 magic[8] = { 0, 255, 255, 255, 255, 255, 255, 0 };
+	u8 *c = e + 128;
+	unsigned int at, len3d, vsdb;
+
+	memset(e, 0, 256);
+	memcpy(e, magic, 8);
+	e[8] = 0x22;		/* manufacturer "HAD" */
+	e[9] = 0x24;
+	e[18] = 1;		/* EDID 1.3 */
+	e[19] = 3;
+	e[20] = 0x80;		/* digital input */
+	e[126] = 1;		/* one extension */
+	edid_stereo_sum(e);
+
+	c[0] = 2;		/* CTA-861 */
+	c[1] = 3;
+	at = 4;
+	c[at++] = (2 << 5) | ARRAY_SIZE(edid_stereo_svds);	/* video data block */
+	memcpy(&c[at], edid_stereo_svds, ARRAY_SIZE(edid_stereo_svds));
+	at += ARRAY_SIZE(edid_stereo_svds);
+
+	len3d = (multi == 1 ? 2 : 0) + n_order;
+	vsdb = at;
+	c[at + 1] = 0x03;	/* the OUI of HDMI Licensing, 00-0C-03 */
+	c[at + 2] = 0x0c;
+	c[at + 3] = 0x00;
+	c[at + 4] = 0x10;	/* physical address 1.0.0.0 */
+	c[at + 5] = 0x00;
+	c[at + 6] = 0x00;
+	c[at + 7] = 0x2d;	/* 225 MHz */
+	c[at + 8] = 0x20;	/* HDMI_Video_present */
+	c[at + 9] = (present ? 0x80 : 0) | (multi << 5);
+	c[at + 10] = len3d;	/* no HDMI_VIC, HDMI_3D_LEN */
+	at += 11;
+	if (multi == 1) {
+		c[at++] = all >> 8;
+		c[at++] = all & 0xff;
+	}
+	memcpy(&c[at], order, n_order);
+	at += n_order;
+	c[vsdb] = (3 << 5) | (at - vsdb - 1);	/* vendor block, its payload length */
+
+	c[2] = at;		/* no detailed timing */
+	edid_stereo_sum(c);
+}
+
+static int edid_stereo_init(struct kunit *test)
+{
+	struct edid_stereo_priv *priv;
+	struct device *dev;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+
+	priv = drm_kunit_helper_alloc_drm_device(test, dev, struct edid_stereo_priv, drm,
+						 DRIVER_MODESET | DRIVER_ATOMIC);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv);
+
+	test->priv = priv;
+	return 0;
+}
+
+/* a new HDMI connector of the test's device, its modes read from @edid */
+static struct drm_connector *edid_stereo_connector(struct kunit *test, const u8 *edid)
+{
+	struct edid_stereo_priv *priv = test->priv;
+	struct drm_connector *connector;
+	const struct drm_edid *drm_edid;
+	int ret;
+
+	connector = drmm_kzalloc(&priv->drm, sizeof(*connector), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, connector);
+
+	ret = drmm_connector_init(&priv->drm, connector, &edid_stereo_connector_funcs,
+				  DRM_MODE_CONNECTOR_HDMIA, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	drm_edid = drm_edid_alloc(edid, 256);
+	KUNIT_ASSERT_NOT_NULL(test, drm_edid);
+	KUNIT_ASSERT_TRUE(test, drm_edid_valid(drm_edid));
+
+	mutex_lock(&priv->drm.mode_config.mutex);
+	ret = drm_edid_connector_update(connector, drm_edid);
+	if (!ret)
+		ret = drm_edid_connector_add_modes(connector);
+	mutex_unlock(&priv->drm.mode_config.mutex);
+	drm_edid_free(drm_edid);
+	KUNIT_ASSERT_GT(test, ret, 0);
+
+	return connector;
+}
+
+/*
+ * The probed modes of @width x @height at @refresh Hz, interlaced or not, with the 3D layout
+ * @layout, at the clock of the CTA format (74.25 or 148.5 MHz here), not at its 1000/1001 twin,
+ * which drm_edid.c adds too
+ */
+static int edid_stereo_count(struct drm_connector *connector, int width, int height, int refresh,
+			     bool interlaced, u32 layout)
+{
+	const struct drm_display_mode *mode;
+	int n = 0;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (mode->hdisplay == width && mode->vdisplay == height &&
+		    drm_mode_vrefresh(mode) == refresh && mode->clock % 250 == 0 &&
+		    !!(mode->flags & DRM_MODE_FLAG_INTERLACE) == interlaced &&
+		    (mode->flags & DRM_MODE_FLAG_3D_MASK) == layout)
+			n++;
+	}
+	return n;
+}
+
+static int edid_stereo_count_3d(struct drm_connector *connector)
+{
+	const struct drm_display_mode *mode;
+	int n = 0;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (mode->flags & DRM_MODE_FLAG_3D_MASK)
+			n++;
+	}
+	return n;
+}
+
+/* 3D modes whose layout is none of frame packing, top-and-bottom and side-by-side (half) */
+static int edid_stereo_count_odd(struct drm_connector *connector)
+{
+	const struct drm_display_mode *mode;
+	int n = 0;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		u32 layout = mode->flags & DRM_MODE_FLAG_3D_MASK;
+
+		if (layout && layout != DRM_MODE_FLAG_3D_FRAME_PACKING &&
+		    layout != DRM_MODE_FLAG_3D_TOP_AND_BOTTOM &&
+		    layout != DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF)
+			n++;
+	}
+	return n;
+}
+
+#define SBS DRM_MODE_FLAG_3D_SIDE_BY_SIDE_HALF
+#define TB DRM_MODE_FLAG_3D_TOP_AND_BOTTOM
+#define FP DRM_MODE_FLAG_3D_FRAME_PACKING
+
+/* 3D_present and nothing listed: the mandatory formats, and side-by-side (half) at 1080p */
+static void drm_test_edid_stereo_silent(struct kunit *test)
+{
+	u8 edid[256];
+	struct drm_connector *connector;
+
+	edid_stereo_make(edid, true, 0, 0, NULL, 0);
+	connector = edid_stereo_connector(test, edid);
+
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 50, false, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, SBS), 1);
+	/* the mandatory ones, as before */
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, FP), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, TB), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1280, 720, 60, false, FP), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1280, 720, 50, false, TB), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, true, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 50, true, SBS), 1);
+	/* nothing at 720p side by side, nothing at 1080p60 frame packed */
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1280, 720, 60, false, SBS), 0);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, FP), 0);
+	/* and no mode with two layouts at once */
+	KUNIT_EXPECT_EQ(test, edid_stereo_count_odd(connector), 0);
+}
+
+/* No 3D_present: no 3D mode, and the 2D modes of the 3D display */
+static void drm_test_edid_stereo_not_3d(struct kunit *test)
+{
+	static const int sizes[][4] = {
+		{ 1920, 1080, 60, 0 }, { 1920, 1080, 50, 0 }, { 1920, 1080, 24, 0 },
+		{ 1280, 720, 60, 0 }, { 1280, 720, 50, 0 }, { 1920, 1080, 60, 1 },
+		{ 1920, 1080, 50, 1 },
+	};
+	u8 edid[256], edid_3d[256];
+	struct drm_connector *connector, *connector_3d;
+	unsigned int i;
+
+	edid_stereo_make(edid, false, 0, 0, NULL, 0);
+	edid_stereo_make(edid_3d, true, 0, 0, NULL, 0);
+	connector = edid_stereo_connector(test, edid);
+	connector_3d = edid_stereo_connector(test, edid_3d);
+
+	KUNIT_EXPECT_EQ(test, edid_stereo_count_3d(connector), 0);
+	for (i = 0; i < ARRAY_SIZE(sizes); i++)
+		KUNIT_EXPECT_EQ(test,
+				edid_stereo_count(connector, sizes[i][0], sizes[i][1], sizes[i][2],
+						  sizes[i][3], 0),
+				edid_stereo_count(connector_3d, sizes[i][0], sizes[i][1],
+						  sizes[i][2], sizes[i][3], 0));
+}
+
+/* 3D_Structure_ALL with side-by-side (half): the listed modes, none added twice */
+static void drm_test_edid_stereo_listed_sbs(struct kunit *test)
+{
+	u8 edid[256];
+	struct drm_connector *connector;
+
+	edid_stereo_make(edid, true, 1, EDID_STEREO_SBS_HALF | EDID_STEREO_TB, NULL, 0);
+	connector = edid_stereo_connector(test, edid);
+
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 50, false, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, SBS), 1);
+	/* and side by side at 720p, which it lists too */
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1280, 720, 60, false, SBS), 1);
+}
+
+/* 3D_Structure_ALL without side-by-side (half): the display's list holds, nothing is added */
+static void drm_test_edid_stereo_listed_no_sbs(struct kunit *test)
+{
+	u8 edid[256];
+	struct drm_connector *connector;
+
+	edid_stereo_make(edid, true, 1, EDID_STEREO_TB, NULL, 0);
+	connector = edid_stereo_connector(test, edid);
+
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, SBS), 0);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 50, false, SBS), 0);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, SBS), 0);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, TB), 1);
+	/* the mandatory side-by-side (half) at 1080i stays */
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, true, SBS), 1);
+}
+
+/* 2D_VIC_order for 1080p24 only (frame packing): 1080p24 as listed, 1080p60 and 50 side by side */
+static void drm_test_edid_stereo_listed_one(struct kunit *test)
+{
+	/* the third SVD (index 2, 1080p24), 3D_Structure 0 (frame packing) */
+	static const u8 order[] = { 2 << 4 | 0 };
+	u8 edid[256];
+	struct drm_connector *connector;
+
+	edid_stereo_make(edid, true, 0, 0, order, ARRAY_SIZE(order));
+	connector = edid_stereo_connector(test, edid);
+
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 24, false, SBS), 0);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 60, false, SBS), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count(connector, 1920, 1080, 50, false, SBS), 1);
+	/* frame packing at 1080p24: mandatory, and listed (two modes of the same timing) */
+	KUNIT_EXPECT_GE(test, edid_stereo_count(connector, 1920, 1080, 24, false, FP), 1);
+	KUNIT_EXPECT_EQ(test, edid_stereo_count_odd(connector), 0);
+}
