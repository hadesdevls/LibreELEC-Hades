From 2b31ca09cc8452a3db300fa009a316847bb9d80c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:46:30 +0000
Subject: [PATCH] drm/amd/display: say what the HDMI HPD debounce took, without
 debugging

The HDMI HPD debounce of amdgpu (amdgpu.hdmi_hpd_debounce_delay_ms, 3000 ms
in Hades by linux-9962) says what it does only with drm.debug=0x4: "HDMI
HPD: Disconnect detected, scheduling debounce work", "Sink unchanged after
debounce, internal re-enable". A test with an ordinary log cannot tell
whether a TV drops HPD, for how long, or whether the delay was enough. The
HPD hold of i915 in the same patch says it with drm_info ("HPD low with an
active output, still connected for up to ... ms", "HPD back after ... ms",
"HPD still low after ... ms, disconnected").

Now amdgpu says, at the info level and at most 20 lines a minute for all
connectors:

- "[CONNECTOR:N:HDMI-A-x] HPD low, held for up to 3000 ms
  (amdgpu.hdmi_hpd_debounce_delay_ms)" at the first drop of a burst;
- when the debounce work looks: "HPD back after N ms, M more drop(s),
  looked at after N ms: the same display, held (no hot-plug event)", or
  "...: another display, reported", or "HPD still low after N ms,
  disconnected", or "...: the display could not be detected, nothing
  reported". The time HPD came back is taken from the HPD interrupt of its
  return, which the debounce drops while its work waits ("no HPD interrupt
  of its return" where none came).

The line of the debounce work goes before dm_restore_drm_connector_state(),
so that the line of linux-9964, where the display lost its scrambling setup
and the link is set up again, comes after it. Logging only: what the
debounce does, and when, is not changed.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h | 10 +++
 .../drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c | 86 ++++++++++++++++++-
 2 files changed, 95 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index efb4fbe..d76e9d5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -899,6 +899,16 @@ struct amdgpu_dm_connector {
 	unsigned int hdmi_hpd_debounce_delay_ms;
 	struct delayed_work hdmi_hpd_debounce_work;
 	struct dc_sink *hdmi_prev_sink;
+	/*
+	 * Hades: for the log of a drop that the debounce took (under hpd_lock):
+	 * when HPD went low first, when it came back meanwhile, and how many more
+	 * drops came before the debounce work looked
+	 */
+	bool hdmi_hpd_low_seen;
+	bool hdmi_hpd_back_seen;
+	unsigned long hdmi_hpd_low_at;
+	unsigned long hdmi_hpd_back_at;
+	unsigned int hdmi_hpd_drops;
 
 	/* HDMI compliance automation */
 	bool hdmi_comp_auto;
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
index 74a8735..ba3f2ff 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_irq.c
@@ -1284,6 +1284,61 @@ EXPORT_IF_KUNIT(are_sinks_equal);
  * The default value of 1500ms was chosen based on experimental testing with
  * various monitors that exhibit spontaneous HPD toggling behavior.
  */
+/*
+ * Hades: the HDMI HPD debounce said what it did only at drm.debug=0x4. Without
+ * debugging, a test cannot tell whether a TV drops HPD, for how long, or
+ * whether the delay was enough to hold it: these lines say it, as the HPD hold
+ * of i915 does (linux-9962), at most 20 a minute for all connectors. Logging
+ * only: what the debounce does is not changed.
+ */
+static DEFINE_RATELIMIT_STATE(hades_hpd_log_rs, 60 * HZ, 20);
+#define hades_hpd_info(drm, fmt, ...)						\
+	do {									\
+		if (__ratelimit(&hades_hpd_log_rs))				\
+			drm_info(drm, fmt, ##__VA_ARGS__);			\
+	} while (0)
+
+static void hades_hpd_log_outcome(struct amdgpu_dm_connector *aconnector,
+				  struct drm_device *dev, bool detected,
+				  bool same)
+{
+	const struct drm_connector *connector = &aconnector->base;
+	char back[96] = "";
+	unsigned int looked;
+
+	if (!aconnector->hdmi_hpd_low_seen) {
+		hades_hpd_info(dev, "[CONNECTOR:%d:%s] HPD debounce: %s\n",
+			       connector->base.id, connector->name,
+			       !detected ? "the display could not be detected, nothing reported" :
+			       same ? "the same display, no hot-plug event" :
+			       aconnector->dc_link->local_sink ? "another display, reported" :
+			       "no display, disconnected");
+		return;
+	}
+	looked = jiffies_to_msecs(jiffies - aconnector->hdmi_hpd_low_at);
+	if (aconnector->hdmi_hpd_back_seen)
+		snprintf(back, sizeof(back), "HPD back after %u ms",
+			 jiffies_to_msecs(aconnector->hdmi_hpd_back_at -
+					  aconnector->hdmi_hpd_low_at));
+	else
+		snprintf(back, sizeof(back), "no HPD interrupt of its return");
+	if (!detected)
+		hades_hpd_info(dev, "[CONNECTOR:%d:%s] HPD low %u ms ago (%s, %u more drop(s)): the display could not be detected, nothing reported\n",
+			       connector->base.id, connector->name, looked, back,
+			       aconnector->hdmi_hpd_drops);
+	else if (same)
+		hades_hpd_info(dev, "[CONNECTOR:%d:%s] %s, %u more drop(s), looked at after %u ms: the same display, held (no hot-plug event)\n",
+			       connector->base.id, connector->name, back,
+			       aconnector->hdmi_hpd_drops, looked);
+	else if (aconnector->dc_link->local_sink)
+		hades_hpd_info(dev, "[CONNECTOR:%d:%s] %s, %u more drop(s), looked at after %u ms: another display, reported\n",
+			       connector->base.id, connector->name, back,
+			       aconnector->hdmi_hpd_drops, looked);
+	else
+		hades_hpd_info(dev, "[CONNECTOR:%d:%s] HPD still low after %u ms, disconnected\n",
+			       connector->base.id, connector->name, looked);
+}
+
 void amdgpu_dm_hdmi_hpd_debounce_work(struct work_struct *work)
 {
 	struct amdgpu_dm_connector *aconnector =
@@ -1320,6 +1375,10 @@ void amdgpu_dm_hdmi_hpd_debounce_work(struct work_struct *work)
 			fake_reconnect = true;
 		}
 
+		/* Hades: what the debounce found, in the log (before the restore,
+		 * whose linux-9964 line says when the link is set up again) */
+		hades_hpd_log_outcome(aconnector, dev, true, fake_reconnect);
+
 		/* Update connector state */
 		amdgpu_dm_update_connector_after_detect(aconnector);
 
@@ -1330,7 +1389,12 @@ void amdgpu_dm_hdmi_hpd_debounce_work(struct work_struct *work)
 		/* Only notify OS if sink actually changed */
 		if (!fake_reconnect && aconnector->base.force == DRM_FORCE_UNSPECIFIED)
 			drm_kms_helper_hotplug_event(dev);
+	} else {
+		hades_hpd_log_outcome(aconnector, dev, false, false);
 	}
+	aconnector->hdmi_hpd_low_seen = false;
+	aconnector->hdmi_hpd_back_seen = false;
+	aconnector->hdmi_hpd_drops = 0;
 
 	/* Release the cached sink reference */
 	if (aconnector->hdmi_prev_sink) {
@@ -1405,6 +1469,20 @@ STATIC_IFN_KUNIT void handle_hpd_irq_helper(struct amdgpu_dm_connector *aconnect
 		drm_dbg_kms(dev, "HDMI HPD: Disconnect detected, scheduling debounce work (%u ms)\n",
 			    aconnector->hdmi_hpd_debounce_delay_ms);
 
+		/* Hades: the first drop of a burst, in the log; the next ones
+		 * before the work looks are counted (hades_hpd_log_outcome()) */
+		if (!delayed_work_pending(&aconnector->hdmi_hpd_debounce_work)) {
+			aconnector->hdmi_hpd_low_seen = true;
+			aconnector->hdmi_hpd_back_seen = false;
+			aconnector->hdmi_hpd_low_at = jiffies;
+			aconnector->hdmi_hpd_drops = 0;
+			hades_hpd_info(dev, "[CONNECTOR:%d:%s] HPD low, held for up to %u ms (amdgpu.hdmi_hpd_debounce_delay_ms)\n",
+				       connector->base.id, connector->name,
+				       aconnector->hdmi_hpd_debounce_delay_ms);
+		} else {
+			aconnector->hdmi_hpd_drops++;
+		}
+
 		/* Cache the current sink for later comparison */
 		if (aconnector->hdmi_prev_sink)
 			dc_sink_release(aconnector->hdmi_prev_sink);
@@ -1421,8 +1499,14 @@ STATIC_IFN_KUNIT void handle_hpd_irq_helper(struct amdgpu_dm_connector *aconnect
 	} else {
 
 		/* If the aconnector->hdmi_hpd_debounce_work is scheduled, exit early */
-		if (delayed_work_pending(&aconnector->hdmi_hpd_debounce_work))
+		if (delayed_work_pending(&aconnector->hdmi_hpd_debounce_work)) {
+			/* Hades: ... noting when HPD came back, for the log */
+			if (aconnector->hdmi_hpd_low_seen && !aconnector->hdmi_hpd_back_seen) {
+				aconnector->hdmi_hpd_back_seen = true;
+				aconnector->hdmi_hpd_back_at = jiffies;
+			}
 			return;
+		}
 
 		scoped_guard(mutex, &adev->dm.dc_lock) {
 			dc_exit_ips_for_hw_access(dc);
-- 
2.53.0

