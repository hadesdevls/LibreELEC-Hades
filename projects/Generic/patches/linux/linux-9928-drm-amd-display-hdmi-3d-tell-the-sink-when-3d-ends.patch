From 1762b32490e16a8e8474985b45103db780a7a856 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:40:00 +0000
Subject: [PATCH] drm/amd/display: HDMI 3D: tell the sink when 3D ends

When a 2D mode follows a 3D one the new stream has no vendor InfoFrame,
or the one with the HDMI VIC of a 4K mode: the 3D frame just stops. The
DRM helpers do not rely on a sink noticing that.
drm_hdmi_vendor_infoframe_from_display_mode() gives every mode a vendor
InfoFrame, also a 2D mode below 4K, on a suggestion of HDMI 2.0
Appendix F: "some sinks have trouble realizing that they should switch
from 3D to 2D mode if the source simply stops sending the infoframe".
amdgpu builds its vendor InfoFrame in the display core, which has none
for such a mode.

The 2D stream that replaces a 3D stream now carries that frame: an HDMI
vendor InfoFrame with no 3D layout and no HDMI VIC
(81 01 04 6b 03 0c 00 00). It is sent for as long as that stream lasts;
the mode change after it goes back to no frame. A mode with an HDMI VIC
keeps its own frame, which says 2D too, and the Dolby Vision tunnel puts
its frame in the slot afterwards, as it did.

The stream update of the previous patch now also carries these two
steps when the timing does not change: the frame that says 2D takes the
place of the 3D one, and its end stops it.

A stream that does not follow a 3D stream is built as before.

Checked: compiled with the configuration and the compiler of the image;
the bytes, by running the packer and the function on the build host.
Not run on hardware and never seen on a 3D display: whether a given sink
needs this frame, or minds it, is not known here. i915 sends it to every
HDMI sink whose EDID has the video fields of the HDMI vendor block.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 27 +++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 7408225..de55dbf 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -8037,6 +8037,7 @@ static bool amdgpu_dm_dvbridge_dcn_reviewed(const struct amdgpu_device *adev)
  * the layouts after it, and the packer adds it there. Some sinks (JVC D-ILA) are reported
  * to engage top-and-bottom only when that byte is present, as Amlogic sources send it:
  * hdmi_3d_tab_ext_data adds it, as zero, to top-and-bottom as well.
+ * Layout 0 gives the frame without a 3D layout and without an HDMI VIC: "this is 2D".
  */
 static int amdgpu_dm_stereo_vsif(u32 layout, struct dc_info_packet *out)
 {
@@ -8046,6 +8047,8 @@ static int amdgpu_dm_stereo_vsif(u32 layout, struct dc_info_packet *out)
 
 	hdmi_vendor_infoframe_init(&frame);
 	switch (layout) {
+	case 0:
+		break;
 	case DRM_MODE_FLAG_3D_FRAME_PACKING:
 		frame.s3d_struct = HDMI_3D_STRUCTURE_FRAME_PACKING;
 		break;
@@ -8094,6 +8097,15 @@ static int amdgpu_dm_hdmi_video_format(const struct dc_stream_state *stream)
 	return p->sb[4] >> 5;
 }
 
+/* The vendor InfoFrame of the stream names a 3D layout, or says that there is none any more. */
+static bool amdgpu_dm_stereo_vsif_present(const struct dc_stream_state *stream)
+{
+	int format = amdgpu_dm_hdmi_video_format(stream);
+
+	return format == AMDGPU_DM_HDMI_VIDEO_FORMAT_3D ||
+	       format == AMDGPU_DM_HDMI_VIDEO_FORMAT_NONE;
+}
+
 /*
  * The commit replaced the stream of a CRTC, and the vendor InfoFrame of the new stream does
  * not say about 3D what the one of the old stream said.
@@ -8103,8 +8115,8 @@ static bool amdgpu_dm_stereo_vsif_changed(const struct dc_stream_state *old_stre
 {
 	if (!new_stream || old_stream == new_stream)
 		return false;
-	if (amdgpu_dm_hdmi_video_format(old_stream) != AMDGPU_DM_HDMI_VIDEO_FORMAT_3D &&
-	    amdgpu_dm_hdmi_video_format(new_stream) != AMDGPU_DM_HDMI_VIDEO_FORMAT_3D)
+	if (!amdgpu_dm_stereo_vsif_present(old_stream) &&
+	    !amdgpu_dm_stereo_vsif_present(new_stream))
 		return false;
 	return !old_stream ||
 	       memcmp(&old_stream->vsp_infopacket, &new_stream->vsp_infopacket,
@@ -8276,6 +8288,17 @@ create_stream_for_sink(struct drm_connector *connector,
 		if (stereo && amdgpu_dm_stereo_vsif(stereo, &stream->vsp_infopacket))
 			drm_warn_once(dev, "Failed to set up the 3D vendor infoframe on connector %s\n",
 				      connector->name);
+		/*
+		 * The 2D mode that follows a 3D one says so, in a vendor InfoFrame without
+		 * a 3D layout, unless it has one of its own (an HDMI VIC): some sinks do not
+		 * leave 3D when the frame just stops coming, which is why the DRM helpers
+		 * send this frame with every 2D mode
+		 * (drm_hdmi_vendor_infoframe_from_display_mode()). Here it lasts as long as
+		 * this stream does.
+		 */
+		if (!stereo && !stream->vsp_infopacket.valid &&
+		    amdgpu_dm_hdmi_video_format(old_stream) == AMDGPU_DM_HDMI_VIDEO_FORMAT_3D)
+			amdgpu_dm_stereo_vsif(0, &stream->vsp_infopacket);
 	}
 
 	if (stream->signal == SIGNAL_TYPE_DISPLAY_PORT ||
