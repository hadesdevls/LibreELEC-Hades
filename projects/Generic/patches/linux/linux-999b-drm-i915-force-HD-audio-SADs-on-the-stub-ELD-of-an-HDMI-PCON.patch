--- a/drivers/gpu/drm/i915/display/intel_audio.c
+++ b/drivers/gpu/drm/i915/display/intel_audio.c
@@ -21,6 +21,7 @@
  * DEALINGS IN THE SOFTWARE.
  */
 
+#include <linux/bitfield.h>
 #include <linux/component.h>
 #include <linux/kernel.h>
 
@@ -704,6 +705,15 @@
 	       intel_dp_is_uhbr(crtc_state);
 }
 
+
+/* HDMI-type DP-to-HDMI PCONs (USB-C hubs) synthesize a stub ELD and never forward the
+ * display's real SADs, so the HD-audio constraints refuse every bitstream. With
+ * i915.force_dp_stub_eld_sads=1 append the HD formats the TV behind such a stub takes. */
+static bool force_dp_stub_eld_sads;
+module_param(force_dp_stub_eld_sads, bool, 0644);
+MODULE_PARM_DESC(force_dp_stub_eld_sads,
+	" append HD-audio SADs to a DP connector's ELD");
+
 bool intel_audio_compute_config(struct intel_encoder *encoder,
 				struct intel_crtc_state *crtc_state,
 				struct drm_connector_state *conn_state)
@@ -724,6 +734,49 @@
 
 	BUILD_BUG_ON(sizeof(crtc_state->eld) != sizeof(connector->eld));
 	memcpy(crtc_state->eld, connector->eld, sizeof(crtc_state->eld));
+
+	if (force_dp_stub_eld_sads) {
+		u8 *e = crtc_state->eld;
+		int mnl = (e[DRM_ELD_CEA_EDID_VER_MNL] & DRM_ELD_MNL_MASK) >> DRM_ELD_MNL_SHIFT;
+		int n = FIELD_GET(DRM_ELD_SAD_COUNT_MASK, e[DRM_ELD_SAD_COUNT_CONN_TYPE]);
+
+		if ((e[DRM_ELD_SAD_COUNT_CONN_TYPE] & DRM_ELD_CONN_TYPE_MASK) ==
+		    DRM_ELD_CONN_TYPE_DP && n <= 2) {
+			static const u8 stub_sads[][3] = {
+				{ (2 << 3) | 7, 0x7f, 0x7f },  /* AC-3    8ch */
+				{ (14 << 3) | 7, 0x7f, 0x7f }, /* DTS     8ch */
+				{ (9 << 3) | 7, 0x7f, 0x7f },  /* TRUEHD  8ch */
+				{ (10 << 3) | 7, 0x7f, 0x7f }, /* E-AC-3  8ch */
+				{ (15 << 3) | 7, 0x7f, 0x7f }, /* DTS-HD  8ch */
+			};
+			int i;
+
+			/* the stub also under-declares LPCM (2ch), which honest
+			 * limiters clamp decoded streams to; raise any LPCM SAD to 8ch. */
+			for (i = 0; i < n; i++) {
+				int off = DRM_ELD_CEA_SAD(mnl, i);
+				if ((e[off] >> 3) == 0x01)
+					e[off] = (1 << 3) | 7;
+			}
+
+			if (n == 0)
+				n = 1;
+			for (i = 0; i < (int)ARRAY_SIZE(stub_sads); i++) {
+				if (n >= 15)
+					break;
+				e[DRM_ELD_CEA_SAD(mnl, n)] = stub_sads[i][0];
+				e[DRM_ELD_CEA_SAD(mnl, n) + 1] = stub_sads[i][1];
+				e[DRM_ELD_CEA_SAD(mnl, n) + 2] = stub_sads[i][2];
+				n++;
+			}
+			e[DRM_ELD_SAD_COUNT_CONN_TYPE] =
+				(e[DRM_ELD_SAD_COUNT_CONN_TYPE] & ~DRM_ELD_SAD_COUNT_MASK) |
+				FIELD_PREP(DRM_ELD_SAD_COUNT_MASK, n);
+			e[DRM_ELD_BASELINE_ELD_LEN] =
+				DIV_ROUND_UP(20 + mnl + 3 * n + 3, 4);
+			DRM_INFO("audio ELD: forced SADs (LPCM 8ch), sadn now %d\n", n);
+		}
+	}
 
 	crtc_state->eld[6] = drm_av_sync_delay(connector, adjusted_mode) / 2;
 	mutex_unlock(&connector->eld_mutex);
