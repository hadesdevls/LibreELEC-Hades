From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:30:00 +0000
Subject: [PATCH] drm: HADES_BOOT_OPTION names the kernel parameter that
 changes a connector

Two kernel parameters of drivers that are built into the kernel change
what an HDMI connector offers: i915.hdmi_hdr_gmp (HDR over the HDMI port
of display version 9, in its gamut metadata DIP) and amdgpu.dvbridge_dce
(the Dolby Vision tunnel on the display cores DCE 11.2 to 12.1 of Polaris
and Vega). User space is to offer each as a setting where it applies, and
cannot tell those connectors apart: on i915 only by the absence of
HDR_OUTPUT_METADATA, which the parameter itself changes, and on amdgpu
not at all (the one trace was a line of the kernel log).

Each driver now attaches to those connectors an immutable enum property,
HADES_BOOT_OPTION, with one value whose name is the parameter as it is
written on the kernel line, whatever the parameter is now, so that the
setting can be turned off again as well:

- i915: native HDMI connectors of the display versions on which the
  parameter changes where the DRM InfoFrame goes (intel_hdmi_boot_option(),
  next to intel_hdmi_drm_dip_of(), whose decision it compares with and
  without the parameter: version 9);
- amdgpu: HDMI connectors of DCE 11.2, 11.22, 12.0 and 12.1 where the
  tunnel is not turned off altogether (amdgpu.dvbridge), the cores that
  amdgpu_dm_dvbridge_reviewed() gives to the parameter
  (amdgpu_dm_dvbridge_dce_core(), which the line of the kernel log that
  says the tunnel is not offered there now uses too).

The kernel log says it once per connector (i915) or once (amdgpu), with
the parameter's value. Nothing else changes: the same properties,
decisions and InfoFrames, with the parameters and without.

KUnit (drm_hdmi_gmp_hdr): the parameter is named on display version 9 and
on no other from 2 to 35, exactly where the decision changes with it. On
the host, amdgpu_dm_dvbridge_dce_core() cut out of the file and built on
the display core's own enum: true on the four cores of the parameter and
on none of the other 33; a mutant without 12.1 and one with 11.0 fail.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 35 ++++++++++++++++---
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 18 ++++++++++
 .../gpu/drm/i915/display/intel_hdmi_gmp_hdr.h | 12 +++++++
 drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c | 18 ++++++++++
 4 files changed, 79 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index c36faa6f8..c37404ea4 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -2414,6 +2414,16 @@ void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_st
  * and 6), the underlay pipe and FBC of DCE 11.0 not reviewed, and DCE 6 cannot set the depth of
  * its line buffer.
  */
+/*
+ * Hades: the display cores on which amdgpu.dvbridge_dce decides whether the tunnel is offered (the
+ * comment of that parameter): the condition of the kernel log line that says it is not, and of
+ * HADES_BOOT_OPTION, which names the parameter on their HDMI connectors whatever it is now
+ */
+static bool amdgpu_dm_dvbridge_dce_core(enum dce_version version)
+{
+	return version >= DCE_VERSION_11_2 && version <= DCE_VERSION_12_1;
+}
+
 static bool amdgpu_dm_dvbridge_reviewed(const struct amdgpu_device *adev)
 {
 	if (!adev->dm.dc)
@@ -4808,10 +4818,27 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge &&
 	    adev->mode_info.dvbridge_dv_standard_property && adev->dm.dc &&
-	    adev->dm.dc->ctx->dce_version >= DCE_VERSION_11_2 &&
-	    adev->dm.dc->ctx->dce_version <= DCE_VERSION_12_1 && !amdgpu_dm_dvbridge_dce)
-		drm_info_once(adev_to_drm(adev),
-			      "DVBRIDGE: the Dolby Vision tunnel is not offered on this display core (DCE 11.2 to 12: Polaris, Vega): it has not been seen to show a picture; Dolby Vision plays converted to HDR10. amdgpu.dvbridge_dce=1 offers it\n");
+	    amdgpu_dm_dvbridge_dce_core(adev->dm.dc->ctx->dce_version)) {
+		const struct drm_prop_enum_list option = { 0, "amdgpu.dvbridge_dce" };
+		struct drm_property *prop;
+
+		if (!amdgpu_dm_dvbridge_dce)
+			drm_info_once(adev_to_drm(adev),
+				      "DVBRIDGE: the Dolby Vision tunnel is not offered on this display core (DCE 11.2 to 12: Polaris, Vega): it has not been seen to show a picture; Dolby Vision plays converted to HDR10. amdgpu.dvbridge_dce=1 offers it\n");
+		/*
+		 * Hades: the parameter that decides it, by its name on the kernel line, in an immutable
+		 * property of the connector: whatever it is now, so that user space can offer to turn it on
+		 * and off again (and the boot menus keep it)
+		 */
+		prop = drm_property_create_enum(adev_to_drm(adev), DRM_MODE_PROP_IMMUTABLE,
+						"HADES_BOOT_OPTION", &option, 1);
+		if (prop) {
+			drm_object_attach_property(&aconnector->base.base, prop, 0);
+			drm_info_once(adev_to_drm(adev),
+				      "DVBRIDGE: HADES_BOOT_OPTION amdgpu.dvbridge_dce on the HDMI connectors of this display core (now %s)\n",
+				      amdgpu_dm_dvbridge_dce ? "on" : "off");
+		}
+	}
 
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge &&
 	    adev->mode_info.dvbridge_dv_standard_property &&
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 6eff8bc9a..af3e938ea 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -3858,6 +3858,24 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 	intel_attach_hdmi_colorspace_property(&connector->base);
 	drm_connector_attach_content_type_property(&connector->base);
 
+	/*
+	 * Hades: the kernel parameter that changes what this port offers, by its name on the kernel
+	 * line (intel_hdmi_boot_option()), in an immutable property: whatever the parameter is now
+	 */
+	if (intel_hdmi_boot_option(DISPLAY_VER(display))) {
+		const struct drm_prop_enum_list option = { 0, intel_hdmi_boot_option(DISPLAY_VER(display)) };
+		struct drm_property *prop = drm_property_create_enum(display->drm, DRM_MODE_PROP_IMMUTABLE,
+								     "HADES_BOOT_OPTION", &option, 1);
+
+		if (prop) {
+			drm_object_attach_property(&_connector->base, prop, 0);
+			drm_info(display->drm,
+				 "Hades: [CONNECTOR:%d:%s] HADES_BOOT_OPTION %s: HDR over this port of display version %d is offered with it (now %s)\n",
+				 connector->base.base.id, connector->base.name, option.name,
+				 DISPLAY_VER(display), display->params.hdmi_hdr_gmp ? "on" : "off");
+		}
+	}
+
 	/* Hades: where the port sends the DRM InfoFrame (intel_hdmi_gmp_hdr.h) */
 	if (intel_hdmi_drm_dip(display) == INTEL_HDMI_DRM_DIP_GMP)
 		drm_info(display->drm,
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h b/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h
index afa86036a..af063b07d 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h
+++ b/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h
@@ -46,6 +46,18 @@ static inline enum intel_hdmi_drm_dip intel_hdmi_drm_dip_of(int display_ver, boo
 	return INTEL_HDMI_DRM_DIP_NONE;
 }
 
+/*
+ * The kernel parameter that changes what an HDMI port of display version @display_ver offers (the
+ * DIP of its DRM InfoFrame, and with it HDR_OUTPUT_METADATA), as it is written on the kernel line;
+ * NULL where it changes nothing. The connector says it in HADES_BOOT_OPTION, whatever the parameter
+ * is now, so that user space can offer to turn it on and off again (and the boot menus keep it).
+ */
+static inline const char *intel_hdmi_boot_option(int display_ver)
+{
+	return intel_hdmi_drm_dip_of(display_ver, false) != intel_hdmi_drm_dip_of(display_ver, true) ?
+	       "i915.hdmi_hdr_gmp" : NULL;
+}
+
 /* the packet type whose bit of infoframes.enable, and whose DIP, carry the DRM InfoFrame */
 static inline unsigned int intel_hdmi_drm_dip_type(enum intel_hdmi_drm_dip dip)
 {
diff --git a/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c b/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c
index c9fd82079..d58a18db0 100644
--- a/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c
+++ b/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c
@@ -63,6 +63,23 @@ static void drm_test_gmp_hdr_dip_of(struct kunit *test)
 			(unsigned int)HDMI_INFOFRAME_TYPE_DRM);
 }
 
+/* HADES_BOOT_OPTION: the parameter is named where it changes the decision, and only there */
+static void drm_test_gmp_hdr_boot_option(struct kunit *test)
+{
+	int ver;
+
+	for (ver = 2; ver <= 35; ver++) {
+		const char *option = intel_hdmi_boot_option(ver);
+		const bool changes = intel_hdmi_drm_dip_of(ver, false) != intel_hdmi_drm_dip_of(ver, true);
+
+		KUNIT_EXPECT_EQ(test, option != NULL, changes);
+		if (ver == 9)
+			KUNIT_EXPECT_STREQ(test, option, "i915.hdmi_hdr_gmp");
+		else
+			KUNIT_EXPECT_NULL(test, option);
+	}
+}
+
 static void drm_test_gmp_hdr_bytes(struct kunit *test)
 {
 	union hdmi_infoframe frame = {}, back = {};
@@ -145,6 +162,7 @@ static void drm_test_gmp_hdr_other_packets(struct kunit *test)
 
 static struct kunit_case drm_hdmi_gmp_hdr_tests[] = {
 	KUNIT_CASE(drm_test_gmp_hdr_dip_of),
+	KUNIT_CASE(drm_test_gmp_hdr_boot_option),
 	KUNIT_CASE(drm_test_gmp_hdr_bytes),
 	KUNIT_CASE(drm_test_gmp_hdr_other_packets),
 	{ }
