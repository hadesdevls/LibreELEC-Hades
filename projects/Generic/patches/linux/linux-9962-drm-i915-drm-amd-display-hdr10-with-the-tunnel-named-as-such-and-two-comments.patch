From bb47d4967a48da3ef4fe80d868b98add07409b23 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:58:34 +0000
Subject: [PATCH] drm/i915, drm/amd/display: HDR10+ with the tunnel named as
 such, and two comments

- A commit with HDR10PLUS_VSIF and the Dolby Vision tunnel is refused on
  both drivers (the Dolby VSIF takes the vendor slot). i915 named it MODE,
  "the Dolby vendor InfoFrame could not be made for the mode", because the
  refusal comes out of intel_hdmi_compute_hdmi_infoframe(); amdgpu refused
  it with a debug line only and no reason in DVBRIDGE_REFUSED. Both say
  now FORMAT, "HDR10PLUS_VSIF is set with the tunnel". Kodi never sets the
  two together (it clears HDR10+ for the tunnel); this is for another
  client and for the log.
- intel_dv_lab_platform_supported() said "Display9+ shares the native HDMI
  vendor-infoframe transport": every DDI platform sends the vendor
  InfoFrame the same way, Haswell and Broadwell too. The comment says now
  that version 9 is the floor of the fork's policy, kept, and that what it
  stands for besides is not verified.
- intel_dv_lab_native_hdmi() tests an active LSPCON, which an HDMI connector
  of i915 never has (a port with an LSPCON gets a DisplayPort connector):
  a comment says it is a guard. The spaces of indentation inherited in
  intel_dv_lab_validate() are tabs.

Nothing else changes. W=1 on i915, its xe copies and amdgpu_dm: no warning.
---
 .../amd/display/amdgpu_dm/amdgpu_dm_connector.c   |  3 +++
 .../gpu/drm/i915/display/intel_dv_lab_policy.h    | 15 +++++++++++----
 drivers/gpu/drm/i915/display/intel_hdmi.c         | 11 +++++++++--
 3 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 355bb83..88ea1b7 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3686,6 +3686,9 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 	if (new_con_state->hdr10plus_vsif && dm_new_con_state->dvbridge_dv_standard) {
 		drm_dbg_atomic(conn->dev, "[CONNECTOR:%d:%s] HDR10PLUS_VSIF with the Dolby Vision tunnel\n",
 			       conn->base.id, conn->name);
+		/* Hades: ... and why, as i915 says it (DVBRIDGE_REFUSED) */
+		amdgpu_dm_dvbridge_refused(aconn, BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT),
+					   "HDR10PLUS_VSIF is set with the tunnel, whose Dolby vendor InfoFrame takes the vendor slot");
 		return -EINVAL;
 	}
 	if (!drm_connector_atomic_hdr10plus_vsif_equal(old_con_state, new_con_state)) {
diff --git a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
index eb83467..f3202ee 100644
--- a/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
+++ b/drivers/gpu/drm/i915/display/intel_dv_lab_policy.h
@@ -36,6 +36,8 @@ static inline const char *intel_dv_lab_edid_why(const u8 *edid, size_t size)
  * topology distinction used by intel_hdmi_dp_dual_mode_detect(), rather
  * than treating that ID alone as proof of an external DP conversion.
  * Active LSPCON conversion remains outside the supported transport path.
+ * (Hades: a port with an LSPCON gets a DisplayPort connector, not an HDMI one
+ * (intel_ddi_init()), so lspcon_active is not true here; the test is kept as a guard.)
  */
 static inline bool intel_dv_lab_native_hdmi(bool lspcon_active,
 					 bool dual_mode_detected, bool vbt_dual_mode)
@@ -71,9 +73,9 @@ static inline int intel_dv_lab_validate(const struct intel_dv_lab_link *s)
 	if (!s->hdmi || !s->rgb || s->limited_range || s->hdr_blob || s->cloned ||
 	    !s->progressive || s->requested_bpc != 8 || s->pipe_bpp != 24 ||
 	    s->colorspace ||
-        (s->rounded_refresh != 24 && s->rounded_refresh != 25 &&
-         s->rounded_refresh != 30 && s->rounded_refresh != 50 &&
-         s->rounded_refresh != 60))
+	    (s->rounded_refresh != 24 && s->rounded_refresh != 25 &&
+	     s->rounded_refresh != 30 && s->rounded_refresh != 50 &&
+	     s->rounded_refresh != 60))
 		return -EINVAL;
 	if (!((s->width == 1920 && s->height == 1080) ||
 	      (s->width == 3840 && s->height == 2160)))
@@ -123,7 +125,12 @@ static inline u64 intel_dv_lab_refused(const struct intel_dv_lab_link *s, bool y
 	return bits;
 }
 
-/* Display9+ shares the native HDMI vendor-infoframe transport. */
+/*
+ * Display version 9 (Skylake) and later: the floor of the fork's policy, kept. (Hades: the vendor
+ * InfoFrame is sent the same way on every DDI platform, Haswell and Broadwell too: the floor is
+ * not about that transport. What else it stands for, HEVC Main 10 decoding in the GPU for
+ * instance, is not verified.)
+ */
 static inline bool intel_dv_lab_platform_supported(unsigned int display_ver)
 {
 	return display_ver >= 9;
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 14cc4f1..af7a7ac 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -3015,8 +3015,15 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 
 	if (!intel_hdmi_compute_hdmi_infoframe(encoder, pipe_config, conn_state)) {
 		drm_dbg_kms(display->drm, "bad HDMI infoframe\n");
-		/* Hades: the Dolby vendor InfoFrame, which takes no 3D mode */
-		if (dv_requested)
+		/*
+		 * Hades: HDR10PLUS_VSIF set with the tunnel, whose Dolby VSIF takes the vendor
+		 * slot (Kodi clears HDR10+ for the tunnel), is the format of the commit; otherwise
+		 * the Dolby vendor InfoFrame, which takes no 3D mode
+		 */
+		if (dv_requested && conn_state->hdr10plus_vsif)
+			intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_FORMAT),
+						    "HDR10PLUS_VSIF is set with the tunnel, whose Dolby vendor InfoFrame takes the vendor slot");
+		else if (dv_requested)
 			intel_hdmi_dvbridge_refused(connector, BIT_ULL(DRM_DVBRIDGE_REFUSED_MODE),
 						    "the Dolby vendor InfoFrame could not be made for the mode");
 		return -EINVAL;
-- 
2.53.0

