From ef0b4b3ebccd4e1b6e319a512a94c1b356a8af69 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:17:05 +0000
Subject: [PATCH] video/hdmi: the HDMI 1.4b vendor InfoFrame of Dolby Vision,
 written for Hades

drivers/video/hdmi.c and include/linux/hdmi.h get the other Dolby
Vision signal: struct hdmi_dolby_hdmi14b_infoframe, its _init(),
_check() and _pack(), and the frame in union hdmi_vendor_any_infoframe,
so that hdmi_infoframe_pack(), _pack_only(), _unpack() and _log() take
it. It is an HDMI vendor InfoFrame (OUI 00-0C-03, header 81 01 18) of
24 payload bytes: PB4 0x20 and PB5 the HDMI VIC in 3840x2160p30, p25,
p24 and 4096x2160p24, zero otherwise; PB6-PB24 zero. Only its length
tells it from the HDMI vendor InfoFrame of the same mode (4 or 5), and
the union's functions tell them apart by that.

Why: a Dolby Vision TV whose data block is of version 0, of version 1
in its 15-byte form, or of version 1 in its 12-byte form with the
low-latency field 0 (the LG OLEDs of 2016 among them) asks for this
signal, not for the Dolby vendor InfoFrame. i915 reads its vendor
InfoFrame back to compare its state, so the frame must unpack too.

The bytes: those that the GPL HDMI transmitter of Amlogic sends to such
a display (CoreELEC linux-amlogic, branch amlogic-5.4.210,
a3aaaa5b0e64: hdmitx_set_vsif_pkt() in hdmi_tx_main.c, "ver0 and
ver1_15 and ver1_12bit with ll= 0 use hdmi 1.4b VSIF", and
hdmitx_set_packet() in hw/hdmi_tx_hw.c, which also writes AVI VIC 0
with PB4 0x20), and what CroqueMr's fork of LibreELEC sends; both read
as data, no code of either copied.

Licence: the code of this patch is offered under the permission notice
at the top of drivers/video/hdmi.c and include/linux/hdmi.h (Copyright
(C) 2012 Avionic Design GmbH; the MIT licence), the licence of the
files that it changes; a comment at the code says so in each file.

Behaviour: the same as before for every input but this frame, measured.
A host test builds the hdmi.c of linux-9899 and this one side by side:
on 234,038,795 frames and 370,916,978 buffers (the exhaustive and
random phases of the test of linux-9899, and every HDMI-OUI buffer of
length 24 with every value of PB4 and PB5, of each later byte, and 50
million random ones) the same return values and bytes everywhere,
except the 297,470 buffers that are exactly this frame, which only the
new code takes. Seven mutations of the new code each make it fail.
---
 drivers/video/hdmi.c | 183 +++++++++++++++++++++++++++++++++++++++++++
 include/linux/hdmi.h |  28 +++++++
 2 files changed, 211 insertions(+)

diff --git a/drivers/video/hdmi.c b/drivers/video/hdmi.c
index bc779b0..26378cc 100644
--- a/drivers/video/hdmi.c
+++ b/drivers/video/hdmi.c
@@ -923,6 +923,177 @@ static void hdmi_dolby_vendor_infoframe_log(const char *level, struct device *de
 		 frame->intended_white_point, frame->crf, frame->l11_byte2, frame->l11_byte3);
 }
 
+/*
+ * The HDMI 1.4b vendor InfoFrame of Dolby Vision
+ *
+ * Written for LibreELEC Hades and offered under the permission notice at the top of this file.
+ *
+ * The Dolby Vision signal (TV-led) for a display whose Dolby Vision data block is of version 0,
+ * of version 1 in its 15-byte form, or of version 1 in its 12-byte form with the low-latency
+ * field 0 (TVs of 2016, the LG OLEDs among them): an HDMI vendor InfoFrame (OUI 00-0C-03) of 24
+ * payload bytes, where the HDMI 1.4b one of the same mode has 4 or 5. Its PB4 and PB5 are those
+ * of HDMI 1.4b: 0x20 (HDMI_Video_Format: extended resolution) and the HDMI VIC in 3840x2160p30,
+ * p25, p24 and 4096x2160p24, whose AVI InfoFrame then carries VIC 0; zero in any other mode.
+ * PB6-PB24 are zero. This is what the GPL HDMI transmitter of Amlogic sends to such a display
+ * (hdmitx_set_vsif_pkt() and hdmitx_set_packet(), read as data), and what CroqueMr's fork of
+ * LibreELEC sends. Only its length tells it from an HDMI vendor InfoFrame.
+ */
+#define HDMI_DOLBY_HDMI14B_FRAME_SIZE	HDMI_INFOFRAME_SIZE(DOLBY_HDMI14B)
+#define HDMI_DOLBY_HDMI14B_EXTENDED	0x20	/* PB4: extended resolution format */
+#define HDMI_DOLBY_HDMI14B_VIC_MAX	4	/* 4096x2160p24, the last HDMI VIC */
+
+/* whether three bytes, the least significant first, are the OUI of HDMI Licensing */
+static bool hdmi_ieee_oui(const u8 *oui)
+{
+	return oui[0] == (HDMI_IEEE_OUI & 0xff) &&
+	       oui[1] == ((HDMI_IEEE_OUI >> 8) & 0xff) &&
+	       oui[2] == ((HDMI_IEEE_OUI >> 16) & 0xff);
+}
+
+/* the vendor frame in @frame is the HDMI 1.4b one of Dolby Vision: its OUI and length */
+static bool hdmi_dolby_hdmi14b_frame(const union hdmi_vendor_any_infoframe *frame)
+{
+	return frame->any.oui == HDMI_IEEE_OUI &&
+	       frame->any.length == HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE;
+}
+
+/**
+ * hdmi_dolby_hdmi14b_infoframe_init() - initialize the HDMI 1.4b vendor InfoFrame of Dolby Vision
+ * @frame: the frame
+ *
+ * Zeroes the frame, also between its fields, and sets its header and OUI; no HDMI VIC.
+ */
+void hdmi_dolby_hdmi14b_infoframe_init(struct hdmi_dolby_hdmi14b_infoframe *frame)
+{
+	memset(frame, 0, sizeof(*frame));
+
+	frame->type = HDMI_INFOFRAME_TYPE_VENDOR;
+	frame->version = 1;
+	frame->length = HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE;
+	frame->oui = HDMI_IEEE_OUI;
+}
+EXPORT_SYMBOL(hdmi_dolby_hdmi14b_infoframe_init);
+
+/**
+ * hdmi_dolby_hdmi14b_infoframe_check() - check the HDMI 1.4b vendor InfoFrame of Dolby Vision
+ * @frame: the frame, which is not changed
+ *
+ * The header and the OUI must be those that hdmi_dolby_hdmi14b_infoframe_init() sets, and the
+ * HDMI VIC one of HDMI 1.4b (1 to 4) or 0. Whether it is the HDMI VIC of the mode, and whether
+ * the sink asks for this signal, is for the caller to know.
+ *
+ * Returns 0 on success or a negative error code on failure.
+ */
+int hdmi_dolby_hdmi14b_infoframe_check(const struct hdmi_dolby_hdmi14b_infoframe *frame)
+{
+	if (frame->type != HDMI_INFOFRAME_TYPE_VENDOR || frame->version != 1 ||
+	    frame->length != HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE || frame->oui != HDMI_IEEE_OUI)
+		return -EINVAL;
+
+	if (frame->hdmi_vic > HDMI_DOLBY_HDMI14B_VIC_MAX)
+		return -EINVAL;
+
+	return 0;
+}
+EXPORT_SYMBOL(hdmi_dolby_hdmi14b_infoframe_check);
+
+/**
+ * hdmi_dolby_hdmi14b_infoframe_pack() - check the HDMI 1.4b vendor InfoFrame of Dolby Vision
+ *                                       and write it
+ * @frame: the frame
+ * @buffer: where to write it: the header, the checksum and the 24 payload bytes
+ * @size: the size of @buffer
+ *
+ * Writes the frame, with the checksum of section 5.3.5 of the HDMI 1.4 specification, and
+ * zeroes the rest of @buffer. On failure @buffer is not touched.
+ *
+ * Returns the number of bytes written (28) or a negative error code.
+ */
+ssize_t hdmi_dolby_hdmi14b_infoframe_pack(const struct hdmi_dolby_hdmi14b_infoframe *frame,
+					  void *buffer, size_t size)
+{
+	u8 *ptr = buffer;
+	int ret;
+
+	ret = hdmi_dolby_hdmi14b_infoframe_check(frame);
+	if (ret)
+		return ret;
+
+	if (size < HDMI_DOLBY_HDMI14B_FRAME_SIZE)
+		return -ENOSPC;
+
+	memset(buffer, 0, size);
+
+	ptr[0] = frame->type;
+	ptr[1] = frame->version;
+	ptr[2] = frame->length;
+	ptr[3] = 0; /* checksum */
+
+	/* the OUI, the least significant byte first */
+	ptr[HDMI_DOLBY_PB(1)] = HDMI_IEEE_OUI & 0xff;
+	ptr[HDMI_DOLBY_PB(2)] = (HDMI_IEEE_OUI >> 8) & 0xff;
+	ptr[HDMI_DOLBY_PB(3)] = (HDMI_IEEE_OUI >> 16) & 0xff;
+
+	if (frame->hdmi_vic) {
+		ptr[HDMI_DOLBY_PB(4)] = HDMI_DOLBY_HDMI14B_EXTENDED;
+		ptr[HDMI_DOLBY_PB(5)] = frame->hdmi_vic;
+	}
+	/* PB6-PB24 stay zero */
+
+	hdmi_infoframe_set_checksum(buffer, HDMI_DOLBY_HDMI14B_FRAME_SIZE);
+
+	return HDMI_DOLBY_HDMI14B_FRAME_SIZE;
+}
+EXPORT_SYMBOL(hdmi_dolby_hdmi14b_infoframe_pack);
+
+/*
+ * hdmi_dolby_hdmi14b_infoframe_unpack() - read the HDMI 1.4b vendor InfoFrame of Dolby Vision
+ *
+ * Takes exactly the frames that hdmi_dolby_hdmi14b_infoframe_pack() writes. @frame is only
+ * written on success.
+ */
+static int hdmi_dolby_hdmi14b_infoframe_unpack(struct hdmi_dolby_hdmi14b_infoframe *frame,
+					       const void *buffer, size_t size)
+{
+	struct hdmi_dolby_hdmi14b_infoframe dv;
+	const u8 *ptr = buffer;
+	unsigned int i;
+
+	if (size < HDMI_DOLBY_HDMI14B_FRAME_SIZE)
+		return -EINVAL;
+
+	if (ptr[0] != HDMI_INFOFRAME_TYPE_VENDOR || ptr[1] != 1 ||
+	    ptr[2] != HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE || !hdmi_ieee_oui(&ptr[HDMI_DOLBY_PB(1)]))
+		return -EINVAL;
+
+	if (hdmi_infoframe_checksum(buffer, HDMI_DOLBY_HDMI14B_FRAME_SIZE) != 0)
+		return -EINVAL;
+
+	/* PB4 and PB5: an HDMI VIC of HDMI 1.4b, or nothing */
+	if (ptr[HDMI_DOLBY_PB(4)] == HDMI_DOLBY_HDMI14B_EXTENDED) {
+		if (!ptr[HDMI_DOLBY_PB(5)] || ptr[HDMI_DOLBY_PB(5)] > HDMI_DOLBY_HDMI14B_VIC_MAX)
+			return -EINVAL;
+	} else if (ptr[HDMI_DOLBY_PB(4)] || ptr[HDMI_DOLBY_PB(5)]) {
+		return -EINVAL;
+	}
+	for (i = HDMI_DOLBY_PB(6); i < HDMI_DOLBY_HDMI14B_FRAME_SIZE; i++)
+		if (ptr[i])
+			return -EINVAL;
+
+	hdmi_dolby_hdmi14b_infoframe_init(&dv);
+	dv.hdmi_vic = ptr[HDMI_DOLBY_PB(5)];
+
+	*frame = dv;
+
+	return 0;
+}
+
+static void hdmi_dolby_hdmi14b_infoframe_log(const char *level, struct device *dev,
+					     const struct hdmi_dolby_hdmi14b_infoframe *frame)
+{
+	hdmi_log("    Dolby Vision, the HDMI 1.4b signal: HDMI VIC %u\n", frame->hdmi_vic);
+}
+
 static int
 hdmi_vendor_any_infoframe_check_only(const union hdmi_vendor_any_infoframe *frame)
 {
@@ -1091,6 +1262,8 @@ hdmi_vendor_any_infoframe_check(union hdmi_vendor_any_infoframe *frame)
 
 	if (frame->any.oui == HDMI_DOLBY_IEEE_OUI)
 		return hdmi_dolby_vendor_infoframe_check(&frame->dolby);
+	if (hdmi_dolby_hdmi14b_frame(frame))
+		return hdmi_dolby_hdmi14b_infoframe_check(&frame->dolby_hdmi14b);
 
 	/* other than Dolby's, we only know about HDMI vendor infoframes */
 	if (frame->any.oui != HDMI_IEEE_OUI)
@@ -1114,6 +1287,8 @@ hdmi_vendor_any_infoframe_pack_only(const union hdmi_vendor_any_infoframe *frame
 
 	if (frame->any.oui == HDMI_DOLBY_IEEE_OUI)
 		return hdmi_dolby_vendor_infoframe_pack(&frame->dolby, buffer, size);
+	if (hdmi_dolby_hdmi14b_frame(frame))
+		return hdmi_dolby_hdmi14b_infoframe_pack(&frame->dolby_hdmi14b, buffer, size);
 
 	/* other than Dolby's, we only know about HDMI vendor infoframes */
 	if (frame->any.oui != HDMI_IEEE_OUI)
@@ -1745,6 +1920,10 @@ hdmi_vendor_any_infoframe_log(const char *level,
 		hdmi_dolby_vendor_infoframe_log(level, dev, &frame->dolby);
 		return;
 	}
+	if (hdmi_dolby_hdmi14b_frame(frame)) {
+		hdmi_dolby_hdmi14b_infoframe_log(level, dev, &frame->dolby_hdmi14b);
+		return;
+	}
 
 	if (frame->any.oui != HDMI_IEEE_OUI) {
 		hdmi_log("    not a HDMI vendor infoframe\n");
@@ -1978,6 +2157,10 @@ hdmi_vendor_any_infoframe_unpack(union hdmi_vendor_any_infoframe *frame,
 	/* the Dolby Vision vendor InfoFrame has a layout of its own */
 	if (size >= HDMI_DOLBY_PB(4) && hdmi_dolby_oui(&ptr[HDMI_DOLBY_PB(1)]))
 		return hdmi_dolby_vendor_infoframe_unpack(&frame->dolby, buffer, size);
+	/* and its HDMI 1.4b vendor InfoFrame, which only its length tells from the HDMI one */
+	if (size >= HDMI_DOLBY_PB(4) && ptr[2] == HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE &&
+	    hdmi_ieee_oui(&ptr[HDMI_DOLBY_PB(1)]))
+		return hdmi_dolby_hdmi14b_infoframe_unpack(&frame->dolby_hdmi14b, buffer, size);
 
 	if (size < HDMI_INFOFRAME_HEADER_SIZE)
 		return -EINVAL;
diff --git a/include/linux/hdmi.h b/include/linux/hdmi.h
index 2ffa82a..8ac77c0 100644
--- a/include/linux/hdmi.h
+++ b/include/linux/hdmi.h
@@ -66,6 +66,7 @@ enum hdmi_infoframe_type {
 #define HDMI_DRM_INFOFRAME_SIZE    26
 #define HDMI_VENDOR_INFOFRAME_SIZE  4
 #define HDMI_DOLBY_VENDOR_INFOFRAME_SIZE 27
+#define HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE 24
 
 /*
  * HDMI 1.3a table 5-14 states that the largest InfoFrame_length is 27,
@@ -474,6 +475,32 @@ int hdmi_dolby_vendor_infoframe_check(const struct hdmi_dolby_vendor_infoframe *
 ssize_t hdmi_dolby_vendor_infoframe_pack(const struct hdmi_dolby_vendor_infoframe *frame,
 					 void *buffer, size_t size);
 
+/**
+ * struct hdmi_dolby_hdmi14b_infoframe - the HDMI 1.4b vendor InfoFrame of Dolby Vision
+ * @type: HDMI_INFOFRAME_TYPE_VENDOR
+ * @version: 1
+ * @length: HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE
+ * @oui: HDMI_IEEE_OUI
+ * @hdmi_vic: the HDMI VIC of the mode (1 to 4: 3840x2160p30, p25, p24, 4096x2160p24), or 0
+ *
+ * The Dolby Vision signal for a display whose Dolby Vision data block asks for HDMI 1.4b
+ * signalling (version 0; version 1 in its 15-byte form, or in its 12-byte form with the
+ * low-latency field 0): an HDMI vendor InfoFrame of 24 payload bytes (drivers/video/hdmi.c).
+ * Written for LibreELEC Hades and offered under the permission notice at the top of this file.
+ */
+struct hdmi_dolby_hdmi14b_infoframe {
+	enum hdmi_infoframe_type type;
+	unsigned char version;
+	unsigned char length;
+	unsigned int oui;
+	u8 hdmi_vic;
+};
+
+void hdmi_dolby_hdmi14b_infoframe_init(struct hdmi_dolby_hdmi14b_infoframe *frame);
+int hdmi_dolby_hdmi14b_infoframe_check(const struct hdmi_dolby_hdmi14b_infoframe *frame);
+ssize_t hdmi_dolby_hdmi14b_infoframe_pack(const struct hdmi_dolby_hdmi14b_infoframe *frame,
+					  void *buffer, size_t size);
+
 union hdmi_vendor_any_infoframe {
 	struct {
 		enum hdmi_infoframe_type type;
@@ -483,6 +510,7 @@ union hdmi_vendor_any_infoframe {
 	} any;
 	struct hdmi_vendor_infoframe hdmi;
 	struct hdmi_dolby_vendor_infoframe dolby;
+	struct hdmi_dolby_hdmi14b_infoframe dolby_hdmi14b;
 };
 
 /**
-- 
2.53.0

