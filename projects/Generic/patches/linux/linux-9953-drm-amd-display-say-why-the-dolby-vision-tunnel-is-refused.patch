From 6bd58fa586f78c1e4c974a1522245cce9a9aefa8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:43:15 +0000
Subject: [PATCH] drm/amd/display: say why the Dolby Vision tunnel is refused

amdgpu refuses the tunnel in three places (linux-9910):
amdgpu_dm_dvbridge_check_connector(), amdgpu_dm_dvbridge_fill_stream()
and amdgpu_dm_dvbridge_check_scanout(). User space only gets -EINVAL or
-EOPNOTSUPP, and the kernel says why only in drm.debug output. Among
the reasons a user can act on: the HDMI link in FRL, a sink without
HDMI InfoFrames, a stream that DC had to make YCbCr because RGB at 8
bits does not fit the link (an HDMI 1.4 TV input at 2160p50/60), an
EDID whose Dolby Vision block the driver does not take, a version 1
block without 2160p60.

Each HDMI connector now has DVBRIDGE_REFUSED (drm_dvbridge_refused.h),
where amdgpu.dvbridge is on. The connector check of a request clears
it, and each of the three checks that refuses names the reasons with
the same tests, in amdgpu_dm_dvbridge_refused.c, and logs what it
found (the mode and its TMDS clock against the encoder and the sink,
the format of the stream, the planes). Those functions run only after a
check has refused and decide nothing: a refusal that none of their
tests names is "other" (or "scanout" for the scanout check), never no
reason, so a later change to the checks cannot leave a refusal unsaid.
A refusal at commit setup, after the check, is not covered: user space
then reads no reason, as before.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_display.c   |   7 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h      |   2 +
 .../gpu/drm/amd/display/amdgpu_dm/Makefile    |   3 +-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  24 +-
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  20 +
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 374 ++++++++++++++++++
 6 files changed, 427 insertions(+), 3 deletions(-)
 create mode 100644 drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
index 830fc91..4d10d0a 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_display.c
@@ -41,6 +41,7 @@
 #include <drm/drm_crtc_helper.h>
 #include <drm/drm_damage_helper.h>
 #include <drm/drm_drv.h>
+#include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_edid.h>
 #include <drm/drm_fb_helper.h>
 #include <drm/drm_gem_framebuffer_helper.h>
@@ -1474,6 +1475,12 @@ int amdgpu_display_modeset_create_props(struct amdgpu_device *adev)
 	if (!adev->mode_info.dvbridge_dv_standard_property)
 		return -ENOMEM;
 
+	/* Hades: the same name and meaning as the i915 one (drm_dvbridge_refused.h) */
+	adev->mode_info.dvbridge_refused_property =
+		drm_dvbridge_refused_property_create(adev_to_drm(adev));
+	if (!adev->mode_info.dvbridge_refused_property)
+		return -ENOMEM;
+
 	return amdgpu_display_setup_abm_prop(adev);
 }
 
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
index d01b67d..bc7423a 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mode.h
@@ -330,6 +330,8 @@ struct amdgpu_mode_info {
 	struct drm_property *abm_level_property;
 	/* Dolby Vision Standard tunnel over HDMI, requested by user space */
 	struct drm_property *dvbridge_dv_standard_property;
+	/* Hades: why a request of the tunnel was refused (DVBRIDGE_REFUSED, read only) */
+	struct drm_property *dvbridge_refused_property;
 	/* hardcoded DFP edid from BIOS */
 	const struct drm_edid *bios_hardcoded_edid;
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/Makefile b/drivers/gpu/drm/amd/display/amdgpu_dm/Makefile
index 54a93e4..7318811 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/Makefile
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/Makefile
@@ -41,7 +41,8 @@ AMDGPUDM = \
 	amdgpu_dm_quirks.o \
 	amdgpu_dm_wb.o \
 	amdgpu_dm_colorop.o \
-	amdgpu_dm_ism.o
+	amdgpu_dm_ism.o \
+	amdgpu_dm_dvbridge_refused.o
 
 ifdef CONFIG_DRM_AMD_DC_FP
 AMDGPUDM += dc_fpu.o
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 435d351..26b1089 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -9318,10 +9318,20 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 		new_crtc_state->mode_changed = true;
 	}
 
+	/*
+	 * Hades: a request of the tunnel is checked again: what was found of the last one is
+	 * cleared (DVBRIDGE_REFUSED), and each check that refuses says why.
+	 */
+	if (dm_new_con_state->dvbridge_dv_standard)
+		amdgpu_dm_dvbridge_refused(aconn, 0, NULL);
+
 	if (dm_new_con_state->dvbridge_dv_standard) {
 		ret = amdgpu_dm_dvbridge_check_connector(aconn, new_con_state, state);
-		if (ret)
+		if (ret) {
+			if (ret == -EINVAL || ret == -EOPNOTSUPP)
+				amdgpu_dm_dvbridge_refused_connector(aconn, new_con_state, state);
 			return ret;
+		}
 	}
 
 	if (new_con_state->privacy_screen_sw_state != old_con_state->privacy_screen_sw_state) {
@@ -10111,6 +10121,10 @@ void amdgpu_dm_connector_init_helper(struct amdgpu_display_manager *dm,
 		drm_object_attach_property(&aconnector->base.base,
 					   adev->mode_info.dvbridge_dv_standard_property, 0);
 
+	/* Hades: DVBRIDGE_REFUSED, on every HDMI connector */
+	if (connector_type == DRM_MODE_CONNECTOR_HDMIA && amdgpu_dm_dvbridge)
+		amdgpu_dm_dvbridge_attach_refused(aconnector);
+
 	if (connector_type == DRM_MODE_CONNECTOR_HDMIA) {
 		if (!drm_mode_create_hdmi_colorspace_property(&aconnector->base, supported_colorspaces))
 			drm_connector_attach_colorspace_property(&aconnector->base);
@@ -12855,8 +12869,12 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 		if (dm_new_conn_state->dvbridge_dv_standard && new_crtc_state->active) {
 			ret = amdgpu_dm_dvbridge_fill_stream(connector, &new_crtc_state->mode,
 							     drm_new_conn_state, new_stream);
-			if (ret)
+			if (ret) {
+				/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
+				amdgpu_dm_dvbridge_refused_stream(connector, &new_crtc_state->mode,
+								  new_stream);
 				goto fail;
+			}
 		}
 
 		/*
@@ -14158,6 +14176,8 @@ static int amdgpu_dm_atomic_check(struct drm_device *dev,
 		if (ret) {
 			drm_dbg_atomic(dev, "[CRTC:%d:%s] Dolby Vision tunnel refused: scanout not byte exact\n",
 				       crtc->base.id, crtc->name);
+			/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
+			amdgpu_dm_dvbridge_refused_scanout(state, crtc, new_crtc_state);
 			goto fail;
 		}
 	}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 2edeefe..fa08426 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -31,6 +31,7 @@
 #include <drm/drm_atomic.h>
 #include <drm/drm_connector.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_dvbridge_refused.h>
 #include <drm/drm_plane.h>
 #include "link_service_types.h"
 #include <drm/drm_writeback.h>
@@ -896,6 +897,13 @@ struct amdgpu_dm_connector {
 	unsigned int hdmi_hpd_debounce_delay_ms;
 	struct delayed_work hdmi_hpd_debounce_work;
 	struct dc_sink *hdmi_prev_sink;
+
+	/*
+	 * Hades: what the kernel log has said of refused requests of the Dolby Vision tunnel, once
+	 * the connector has DVBRIDGE_REFUSED (ready)
+	 */
+	struct drm_dvbridge_refused_log dvbridge_refused_log;
+	bool dvbridge_refused_ready;
 };
 
 static inline void amdgpu_dm_set_mst_status(uint8_t *status,
@@ -1079,6 +1087,18 @@ struct dm_connector_state {
 	bool dvbridge_dv_standard;
 };
 
+/* Hades: amdgpu_dm_dvbridge_refused.c */
+void amdgpu_dm_dvbridge_attach_refused(struct amdgpu_dm_connector *aconn);
+void amdgpu_dm_dvbridge_refused(struct amdgpu_dm_connector *aconn, u64 bits, const char *detail);
+void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
+					  const struct drm_connector_state *con_state,
+					  struct drm_atomic_commit *state);
+void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
+				       const struct drm_display_mode *mode,
+				       const struct dc_stream_state *stream);
+void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+					const struct drm_crtc_state *crtc_state);
+
 #define to_dm_connector_state(x)\
 	container_of((x), struct dm_connector_state, base)
 
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
new file mode 100644
index 0000000..0eea695
--- /dev/null
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Hades: why a request of the Dolby Vision Standard tunnel (DVBRIDGE_DV_STANDARD_LAB) is refused on
+ * an HDMI connector, for user space (the read-only property DVBRIDGE_REFUSED) and for the kernel
+ * log.
+ *
+ * The tunnel is admitted by amdgpu_dm_dvbridge_check_connector(),
+ * amdgpu_dm_dvbridge_fill_stream() and amdgpu_dm_dvbridge_check_scanout() in amdgpu_dm.c. The
+ * functions here run only after one of those has refused, and name what it found with the same
+ * tests; a refusal that none of them names is "other", never no reason. They decide nothing.
+ */
+
+#include <linux/hdmi.h>
+#include <linux/string_choices.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_blend.h>
+#include <drm/drm_dvbridge_refused.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_print.h>
+
+#include "dm_services_types.h"
+#include "dc.h"
+#include "dc/inc/core_types.h"
+#include "amdgpu.h"
+#include "amdgpu_dm.h"
+#include "amdgpu_dm_dvbridge.h"
+
+#define REFUSED(reason) BIT_ULL(DRM_DVBRIDGE_REFUSED_##reason)
+
+/* The connector says why to user space and to the log: an HDMI connector that has the property. */
+static bool dvbridge_refused_ready(const struct amdgpu_dm_connector *aconn)
+{
+	return aconn->base.connector_type == DRM_MODE_CONNECTOR_HDMIA &&
+	       aconn->dvbridge_refused_ready;
+}
+
+void amdgpu_dm_dvbridge_attach_refused(struct amdgpu_dm_connector *aconn)
+{
+	struct amdgpu_device *adev = drm_to_adev(aconn->base.dev);
+
+	if (aconn->base.connector_type != DRM_MODE_CONNECTOR_HDMIA)
+		return;
+	if (adev->mode_info.dvbridge_refused_property) {
+		drm_dvbridge_refused_log_init(&aconn->dvbridge_refused_log);
+		drm_object_attach_property(&aconn->base.base,
+					   adev->mode_info.dvbridge_refused_property, 0);
+		aconn->dvbridge_refused_ready = true;
+	}
+}
+
+void amdgpu_dm_dvbridge_refused(struct amdgpu_dm_connector *aconn, u64 bits, const char *detail)
+{
+	struct amdgpu_device *adev = drm_to_adev(aconn->base.dev);
+
+	if (!dvbridge_refused_ready(aconn))
+		return;
+	drm_dvbridge_refused_report(&aconn->base, adev->mode_info.dvbridge_refused_property,
+				    &aconn->dvbridge_refused_log, bits, detail);
+}
+
+/* Bits per component of a DC colour depth; 0 when unknown (the enum is not in order). */
+static unsigned int dvbridge_depth_bpc(enum dc_color_depth depth)
+{
+	switch (depth) {
+	case COLOR_DEPTH_666:
+		return 6;
+	case COLOR_DEPTH_888:
+		return 8;
+	case COLOR_DEPTH_999:
+		return 9;
+	case COLOR_DEPTH_101010:
+		return 10;
+	case COLOR_DEPTH_111111:
+		return 11;
+	case COLOR_DEPTH_121212:
+		return 12;
+	case COLOR_DEPTH_141414:
+		return 14;
+	case COLOR_DEPTH_161616:
+		return 16;
+	default:
+		return 0;
+	}
+}
+
+static const char *dvbridge_encoding_name(enum dc_pixel_encoding encoding)
+{
+	switch (encoding) {
+	case PIXEL_ENCODING_RGB:
+		return "RGB";
+	case PIXEL_ENCODING_YCBCR422:
+		return "YCbCr 4:2:2";
+	case PIXEL_ENCODING_YCBCR444:
+		return "YCbCr 4:4:4";
+	case PIXEL_ENCODING_YCBCR420:
+		return "YCbCr 4:2:0";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * What the link takes beside what the mode needs, for the log: the TMDS clock of RGB at 8 bits
+ * per component in the mode (its pixel clock), the HDMI pixel clock of the encoder and the TMDS
+ * clock of the sink (0: none stated).
+ */
+static size_t dvbridge_link_detail(const struct amdgpu_dm_connector *aconn,
+				   const struct drm_display_mode *mode, char *buf, size_t len,
+				   size_t size)
+{
+	const struct dc_link *link = aconn->dc_link;
+	unsigned int encoder_max = link && link->link_enc ?
+				   link->link_enc->features.max_hdmi_pixel_clock : 0;
+
+	if (len >= size)
+		return len;
+	return len + scnprintf(buf + len, size - len,
+			       "%dx%d@%d: RGB at 8 bpc needs TMDS %d kHz; the encoder sends up to %u kHz, the sink takes %d kHz%s",
+			       mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode), mode->clock,
+			       encoder_max, aconn->base.display_info.max_tmds_clock,
+			       drm_mode_is_420_only(&aconn->base.display_info, mode) ?
+			       "; the sink takes this mode in YCbCr 4:2:0 only" : "");
+}
+
+/* The tests of amdgpu_dm_dvbridge_check_connector(), named. */
+static u64 dvbridge_why_connector(const struct amdgpu_dm_connector *aconn,
+				  const struct drm_connector_state *con_state,
+				  const struct drm_crtc_state *crtc_state, char *buf, size_t size)
+{
+	const struct dm_connector_state *dm_state = to_dm_connector_state(con_state);
+	const struct dc_link *link = aconn->dc_link;
+	const struct drm_display_mode *mode = crtc_state ? &crtc_state->mode : NULL;
+	size_t len = 0;
+	u64 bits = 0;
+
+	buf[0] = '\0';
+	if (aconn->base.connector_type != DRM_MODE_CONNECTOR_HDMIA || !link) {
+		bits |= REFUSED(CONVERTER);
+		len += scnprintf(buf + len, size - len, "%snot a native HDMI connector",
+				 len ? "; " : "");
+	} else if (link->connector_signal == SIGNAL_TYPE_HDMI_FRL) {
+		bits |= REFUSED(FRL);
+		len += scnprintf(buf + len, size - len,
+				 "%sthe HDMI connector is driven in FRL", len ? "; " : "");
+	} else if (link->connector_signal != SIGNAL_TYPE_HDMI_TYPE_A) {
+		bits |= REFUSED(CONVERTER);
+		len += scnprintf(buf + len, size - len, "%sconnector signal %#x",
+				 len ? "; " : "", link->connector_signal);
+	}
+	if (!aconn->base.display_info.has_hdmi_infoframe) {
+		bits |= REFUSED(SINK);
+		len += scnprintf(buf + len, size - len,
+				 "%sthe sink takes no HDMI InfoFrames (HDMI sink: %s)",
+				 len ? "; " : "", str_yes_no(aconn->base.display_info.is_hdmi));
+	}
+	if (con_state->max_requested_bpc != 8 ||
+	    con_state->colorspace != DRM_MODE_COLORIMETRY_DEFAULT ||
+	    con_state->hdr_output_metadata ||
+	    con_state->hdmi.broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED) {
+		bits |= REFUSED(FORMAT);
+		len += scnprintf(buf + len, size - len,
+				 "%smax bpc %u, colorimetry %u, HDR metadata %s, limited range %s",
+				 len ? "; " : "", con_state->max_requested_bpc,
+				 con_state->colorspace, str_yes_no(con_state->hdr_output_metadata),
+				 str_yes_no(con_state->hdmi.broadcast_rgb ==
+					    DRM_HDMI_BROADCAST_RGB_LIMITED));
+	}
+	if (dm_state->scaling != RMX_OFF ||
+	    (dm_state->underscan_enable &&
+	     (dm_state->underscan_hborder || dm_state->underscan_vborder))) {
+		bits |= REFUSED(MODE);
+		len += scnprintf(buf + len, size - len, "%sscaling %d, underscan %ux%u",
+				 len ? "; " : "", dm_state->scaling,
+				 dm_state->underscan_enable ? dm_state->underscan_hborder : 0,
+				 dm_state->underscan_enable ? dm_state->underscan_vborder : 0);
+	}
+	if (mode && (!amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode)) ||
+		     (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN |
+				     DRM_MODE_FLAG_DBLCLK | DRM_MODE_FLAG_3D_MASK)))) {
+		bits |= REFUSED(MODE);
+		len += scnprintf(buf + len, size - len,
+				 "%s%dx%d@%d, CTA VIC %u, flags %#x (CTA 1080p or 2160p at 24 to 60 Hz, progressive 2D, are taken)",
+				 len ? "; " : "", mode->hdisplay, mode->vdisplay,
+				 drm_mode_vrefresh(mode), drm_match_cea_mode(mode), mode->flags);
+	}
+	if (crtc_state && crtc_state->connector_mask != drm_connector_mask(&aconn->base)) {
+		bits |= REFUSED(CLONE);
+		len += scnprintf(buf + len, size - len, "%sconnectors on the CRTC %#x",
+				 len ? "; " : "", crtc_state->connector_mask);
+	}
+	return bits ? bits : REFUSED(OTHER);
+}
+
+void amdgpu_dm_dvbridge_refused_connector(struct amdgpu_dm_connector *aconn,
+					  const struct drm_connector_state *con_state,
+					  struct drm_atomic_commit *state)
+{
+	char detail[320];
+	const struct drm_crtc_state *crtc_state =
+		con_state->crtc ? drm_atomic_get_new_crtc_state(state, con_state->crtc) : NULL;
+	u64 bits = dvbridge_why_connector(aconn, con_state, crtc_state, detail, sizeof(detail));
+
+	amdgpu_dm_dvbridge_refused(aconn, bits, detail);
+}
+
+/* The tests of amdgpu_dm_dvbridge_fill_stream(), named. */
+void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
+				       const struct drm_display_mode *mode,
+				       const struct dc_stream_state *stream)
+{
+	struct amdgpu_dm_connector *aconn = to_amdgpu_dm_connector(connector);
+	u8 vic = amdgpu_dm_dvbridge_avi_vic(drm_match_cea_mode(mode));
+	char detail[320];
+	size_t len = 0;
+	u64 bits = 0;
+	bool p60 = false;
+
+	detail[0] = '\0';
+	if (!stream->sink ||
+	    !amdgpu_dm_dvbridge_edid_standard(stream->sink->dc_edid.raw_edid,
+					      stream->sink->dc_edid.length, &p60)) {
+		bits |= REFUSED(EDID);
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "%sthe EDID has no Dolby Vision block that this driver takes (version 2 with the Standard interface, or the 12-byte version 1 block with low latency and display management 4 or later)",
+				 len ? "; " : "");
+	} else if (!p60 && (vic == 96 || vic == 97)) {
+		bits |= REFUSED(EDID_2160P30);
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "%sthe version 1 Dolby Vision block does not advertise 2160p60",
+				 len ? "; " : "");
+	}
+	if (!vic || (mode->flags & DRM_MODE_FLAG_3D_MASK)) {
+		bits |= REFUSED(MODE);
+		len += scnprintf(detail + len, sizeof(detail) - len,
+				 "%s%dx%d@%d, CTA VIC %u, flags %#x", len ? "; " : "",
+				 mode->hdisplay, mode->vdisplay, drm_mode_vrefresh(mode),
+				 drm_match_cea_mode(mode), mode->flags);
+	}
+	amdgpu_dm_dvbridge_refused(aconn, bits ? bits : REFUSED(OTHER), detail);
+}
+
+/* The tests of amdgpu_dm_dvbridge_check_scanout(), named. */
+static u64 dvbridge_why_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+				const struct drm_crtc_state *crtc_state,
+				const struct amdgpu_dm_connector *aconn, char *buf, size_t size)
+{
+	const struct dm_crtc_state *dm_crtc_state = to_dm_crtc_state(crtc_state);
+	const struct dc_stream_state *stream = dm_crtc_state->stream;
+	const struct drm_plane_state *plane_state;
+	struct drm_plane *primary = crtc->primary;
+	unsigned int w = stream->timing.h_addressable;
+	unsigned int h = stream->timing.v_addressable;
+	size_t len = 0;
+	u64 bits = 0;
+	bool luts, vrr;
+
+	buf[0] = '\0';
+	if (stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+		bits |= REFUSED(FRL);
+		len += scnprintf(buf + len, size - len, "the stream is HDMI FRL");
+	} else if (stream->signal == SIGNAL_TYPE_DVI_SINGLE_LINK ||
+		   stream->signal == SIGNAL_TYPE_DVI_DUAL_LINK) {
+		bits |= REFUSED(SINK);
+		len += scnprintf(buf + len, size - len, "the stream is DVI");
+	} else if (stream->signal != SIGNAL_TYPE_HDMI_TYPE_A) {
+		bits |= REFUSED(CONVERTER);
+		len += scnprintf(buf + len, size - len, "stream signal %#x", stream->signal);
+	}
+	/* DC sends YCbCr when RGB at 8 bpc does not fit the link (or the mode is 4:2:0 only) */
+	if (stream->timing.pixel_encoding != PIXEL_ENCODING_RGB ||
+	    stream->timing.display_color_depth != COLOR_DEPTH_888) {
+		if (stream->timing.pixel_encoding == PIXEL_ENCODING_YCBCR420)
+			bits |= REFUSED(YCBCR420);
+		else if (stream->timing.pixel_encoding == PIXEL_ENCODING_YCBCR422)
+			bits |= REFUSED(TMDS);
+		else
+			bits |= REFUSED(FORMAT);
+		len += scnprintf(buf + len, size - len, "%sthe stream is %s at %u bpc",
+				 len ? "; " : "",
+				 dvbridge_encoding_name(stream->timing.pixel_encoding),
+				 dvbridge_depth_bpc(stream->timing.display_color_depth));
+		if (aconn && (bits & (REFUSED(YCBCR420) | REFUSED(TMDS)))) {
+			len += scnprintf(buf + len, size - len, "; ");
+			len = dvbridge_link_detail(aconn, &crtc_state->mode, buf, len, size);
+		}
+	}
+	if (stream->output_color_space != COLOR_SPACE_SRGB || stream->hdr_static_metadata.valid) {
+		bits |= REFUSED(FORMAT);
+		len += scnprintf(buf + len, size - len,
+				 "%soutput colour space %d, HDR InfoFrame %s", len ? "; " : "",
+				 stream->output_color_space,
+				 str_yes_no(stream->hdr_static_metadata.valid));
+	}
+	if (stream->timing.flags.INTERLACE ||
+	    stream->timing.timing_3d_format != TIMING_3D_FORMAT_NONE ||
+	    stream->timing.h_border_left || stream->timing.h_border_right ||
+	    stream->timing.v_border_top || stream->timing.v_border_bottom ||
+	    stream->src.x || stream->src.y || stream->src.width != w || stream->src.height != h ||
+	    stream->dst.x || stream->dst.y || stream->dst.width != w || stream->dst.height != h) {
+		bits |= REFUSED(MODE);
+		len += scnprintf(buf + len, size - len,
+				 "%sinterlaced %d, 3D %d, borders, or the raster scaled (destination %ux%u+%u+%u of %ux%u)",
+				 len ? "; " : "", stream->timing.flags.INTERLACE,
+				 stream->timing.timing_3d_format, stream->dst.width,
+				 stream->dst.height, stream->dst.x, stream->dst.y, w, h);
+	}
+	luts = crtc_state->ctm || crtc_state->degamma_lut || crtc_state->gamma_lut;
+	vrr = crtc_state->vrr_enabled ||
+	      dm_crtc_state->freesync_config.state == VRR_STATE_ACTIVE_VARIABLE ||
+	      dm_crtc_state->freesync_config.state == VRR_STATE_ACTIVE_FIXED;
+	if (stream->timing.flags.DSC || stream->dither_option != DITHER_OPTION_TRUN8 ||
+	    stream->gamut_remap_matrix.enable_remap ||
+	    stream->csc_color_matrix.enable_adjustment || luts ||
+	    dm_crtc_state->regamma_tf != AMDGPU_TRANSFER_FUNCTION_DEFAULT || vrr) {
+		bits |= REFUSED(SCANOUT);
+		len += scnprintf(buf + len, size - len,
+				 "%sDSC %d, dither %d, gamut remap %d, CSC %d, CRTC CTM/LUTs %d, regamma %d, VRR %d",
+				 len ? "; " : "", stream->timing.flags.DSC, stream->dither_option,
+				 stream->gamut_remap_matrix.enable_remap,
+				 stream->csc_color_matrix.enable_adjustment, luts,
+				 dm_crtc_state->regamma_tf, vrr);
+	}
+	plane_state = drm_atomic_get_new_plane_state(state, primary);
+	if (!plane_state)
+		plane_state = primary->state;
+	if (crtc_state->plane_mask != drm_plane_mask(primary) || !plane_state ||
+	    !plane_state->fb || !plane_state->visible) {
+		bits |= REFUSED(SCANOUT);
+		len += scnprintf(buf + len, size - len,
+				 "%splanes %#x (the primary alone: %#x)", len ? "; " : "",
+				 crtc_state->plane_mask, drm_plane_mask(primary));
+	} else if (plane_state->fb->format->format != DRM_FORMAT_XRGB8888 ||
+		   plane_state->src_x || plane_state->src_y ||
+		   plane_state->src_w != (w << 16) || plane_state->src_h != (h << 16) ||
+		   plane_state->crtc_x || plane_state->crtc_y ||
+		   plane_state->crtc_w != w || plane_state->crtc_h != h ||
+		   plane_state->rotation != DRM_MODE_ROTATE_0 ||
+		   plane_state->alpha != DRM_BLEND_ALPHA_OPAQUE || plane_state->color_pipeline) {
+		bits |= REFUSED(SCANOUT);
+		len += scnprintf(buf + len, size - len,
+				 "%sprimary plane: %p4cc, source %ux%u+%u+%u, on screen %ux%u%+d%+d, rotation %#x, alpha %#x",
+				 len ? "; " : "", &plane_state->fb->format->format,
+				 plane_state->src_w >> 16, plane_state->src_h >> 16,
+				 plane_state->src_x >> 16, plane_state->src_y >> 16,
+				 plane_state->crtc_w, plane_state->crtc_h, plane_state->crtc_x,
+				 plane_state->crtc_y, plane_state->rotation, plane_state->alpha);
+	}
+	/* (the colour pipeline of the plane, as user space and DC have it, is "scanout" too) */
+	return bits ? bits : REFUSED(SCANOUT);
+}
+
+void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+					const struct drm_crtc_state *crtc_state)
+{
+	struct drm_connector_state *con_state;
+	struct drm_connector *connector;
+	char detail[384];
+	int i;
+
+	for_each_new_connector_in_state(state, connector, con_state, i) {
+		struct amdgpu_dm_connector *aconn;
+
+		if (con_state->crtc != crtc ||
+		    connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			continue;
+		aconn = to_amdgpu_dm_connector(connector);
+		amdgpu_dm_dvbridge_refused(aconn,
+					   dvbridge_why_scanout(state, crtc, crtc_state, aconn,
+								detail, sizeof(detail)),
+					   detail);
+	}
+}
