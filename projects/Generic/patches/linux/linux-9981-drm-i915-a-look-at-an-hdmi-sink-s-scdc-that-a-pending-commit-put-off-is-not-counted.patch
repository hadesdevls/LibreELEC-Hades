From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:01:24 +0000
Subject: [PATCH] drm/i915: a look at an HDMI sink's SCDC that a pending commit
 put off is not counted

linux-9934 looks at an HDMI sink's SCDC TMDS_Config once a second for 4 s
after a hotplug, so that a sink that reset it after intel_hdmi_reset_link()
read it as matching (an LG G5 drops HPD ~0.4 s after a Dolby Vision or
refresh rate change) gets its modeset. intel_hdmi_reset_link() does not
read the SCDC while the last commit that carried the connector has not
reached hw_done, and returns as if it had looked: the look is spent.
Kodi puts the connector in a commit whenever it sets one of its
properties, and on i915 that is each new HDR10+ InfoFrame of a video
(HDR10PLUS_VSIF), besides the HDR metadata and the colour settings of a
video that starts; a nonblocking commit waits for the flip before it, up
to a refresh, before it reaches hw_done. Looks that each found such a
commit pending, or one commit that stayed pending for the 4 s, left the
sink unchecked, with nothing in the log.

A look that a pending commit put off is no longer counted: the looks go
on, once a second, for 10 more at most (hdmi_scdc_look_again()). Each look
that is put off says so in the debug log, and the last one, if it is put
off too, in the kernel log. With i915.scdc_recheck=0 nothing of this runs,
as before. Each look is a whole detection, as those of linux-9934 are.
Applies after linux-9934 and linux-9936.

The idea of not losing this check to a pending commit comes from
CroqueMr's builds (linux-9944-intel-hdmi-deferred-link-check), which wait
for hw_done in the commit path; this keeps it in the looks of linux-9934,
with nothing added to the commit path.
---
 drivers/gpu/drm/i915/display/intel_ddi.c      | 41 ++++++++++++++++++-
 .../drm/i915/display/intel_display_types.h    |  2 +
 2 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_ddi.c b/drivers/gpu/drm/i915/display/intel_ddi.c
index 3697cdf4cd80..2010702df01a 100644
--- a/drivers/gpu/drm/i915/display/intel_ddi.c
+++ b/drivers/gpu/drm/i915/display/intel_ddi.c
@@ -4788,6 +4788,23 @@ MODULE_PARM_DESC(scdc_recheck,
 	"after a hotplug, with at most 3 modesets in 20 s (big-fella; default "
 	"true; false: one retry and no cap, as upstream)");
 
+/*
+ * Hades: whether intel_ddi_hotplug() looks at an HDMI sink's SCDC once more
+ * after the pass $retries of a hotplug (0: the hotplug itself). Four times
+ * after it (big-fella, linux-9934), and a look that a pending commit put off
+ * ($deferred: intel_hdmi_reset_link() did not read the SCDC) is not counted,
+ * for 10 more passes at most: a commit that carries the connector at each
+ * look (an HDR10+ vendor InfoFrame per scene or frame, HDR metadata, a mode)
+ * left a sink whose TMDS_Config was reset after the hotplug unchecked.
+ */
+#define HDMI_SCDC_LOOKS			4
+#define HDMI_SCDC_DEFERRED_LOOKS	10
+static bool hdmi_scdc_look_again(int retries, bool deferred)
+{
+	return retries < HDMI_SCDC_LOOKS ||
+	       (deferred && retries < HDMI_SCDC_LOOKS + HDMI_SCDC_DEFERRED_LOOKS);
+}
+
 static int intel_hdmi_reset_link(struct intel_encoder *encoder,
 				 struct drm_modeset_acquire_ctx *ctx)
 {
@@ -4832,8 +4849,18 @@ static int intel_hdmi_reset_link(struct intel_encoder *encoder,
 		return 0;
 
 	if (conn_state->commit &&
-	    !try_wait_for_completion(&conn_state->commit->hw_done))
+	    !try_wait_for_completion(&conn_state->commit->hw_done)) {
+		/*
+		 * Hades: the SCDC is not looked at while a commit that carries
+		 * this connector has not reached the hardware, and that is no
+		 * look: intel_ddi_hotplug() looks again (hdmi_scdc_look_again()).
+		 */
+		connector->hdmi_scdc_deferred = true;
+		drm_dbg_kms(display->drm,
+			    "[CONNECTOR:%d:%s] a commit is pending: SCDC looked at again\n",
+			    connector->base.base.id, connector->base.name);
 		return 0;
+	}
 
 	ret = drm_scdc_readb(ddc, SCDC_TMDS_CONFIG, &config);
 	if (ret < 0) {
@@ -4909,6 +4936,8 @@ intel_ddi_hotplug(struct intel_encoder *encoder,
 
 	state = intel_encoder_hotplug(encoder, connector);
 
+	/* Hades: set by intel_hdmi_reset_link() where a pending commit puts its look off */
+	connector->hdmi_scdc_deferred = false;
 	if (!intel_tc_port_link_reset(dig_port)) {
 		/*
 		 * big-fella: not while HPD is held low (intel_hdmi_detect,
@@ -4976,7 +5005,15 @@ intel_ddi_hotplug(struct intel_encoder *encoder,
 	connector->hdmi_scdc_recheck = scdc_recheck &&
 		connector->base.connector_type == DRM_MODE_CONNECTOR_HDMIA &&
 		connector->base.status == connector_status_connected &&
-		connector->hotplug_retries < 4;
+		hdmi_scdc_look_again(connector->hotplug_retries,
+				     connector->hdmi_scdc_deferred);
+	if (scdc_recheck && connector->hdmi_scdc_deferred &&
+	    !connector->hdmi_scdc_recheck &&
+	    connector->base.status == connector_status_connected)
+		drm_info(encoder->base.dev,
+			 "[CONNECTOR:%d:%s] SCDC not looked at: a commit was still pending at the last of %d looks after the hotplug\n",
+			 connector->base.base.id, connector->base.name,
+			 connector->hotplug_retries + 1);
 	if (state == INTEL_HOTPLUG_UNCHANGED && connector->hdmi_scdc_recheck)
 		state = INTEL_HOTPLUG_RETRY;
 
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 8d73c3a5192d..2d12c25275b8 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -603,6 +603,8 @@ struct intel_connector {
 	/* big-fella: modesets intel_hdmi_reset_link made since hdmi_scdc_fix_since (at most 3 in 20 s) */
 	int hdmi_scdc_fixes;
 	unsigned long hdmi_scdc_fix_since;
+	/* Hades: the last look at the sink's SCDC was put off by a pending commit (intel_ddi_hotplug) */
+	bool hdmi_scdc_deferred;
 	/* big-fella: HPD low on a connected HDMI sink with a CRTC, reported as
 	 * connected since hpd_low_since (intel_hdmi_detect, i915.hpd_hold_ms) */
 	bool hpd_held;
-- 
2.53.0

