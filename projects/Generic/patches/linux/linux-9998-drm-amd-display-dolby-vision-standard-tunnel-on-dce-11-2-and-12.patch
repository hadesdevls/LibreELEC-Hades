 	return false;
 }
 
+/* Hades: the name of a DCE version that offers the tunnel, for the kernel log */
+static const char *amdgpu_dm_dvbridge_dce_name(enum dce_version version)
+{
+	switch (version) {
+	case DCE_VERSION_11_2:
+		return "11.2 (Polaris)";
+	case DCE_VERSION_11_22:
+		return "11.22 (Vega M)";
+	case DCE_VERSION_12_0:
+		return "12.0 (Vega 10, Vega 12)";
+	case DCE_VERSION_12_1:
+		return "12.1 (Vega 20)";
+	default:
+		return "(not one that offers the tunnel)";
+	}
+}
+
+static const char *amdgpu_dm_dvbridge_lb_name(enum lb_pixel_depth depth)
+{
+	switch (depth) {
+	case LB_PIXEL_DEPTH_18BPP:
+		return "18 bpp";
+	case LB_PIXEL_DEPTH_24BPP:
+		return "24 bpp";
+	case LB_PIXEL_DEPTH_30BPP:
+		return "30 bpp";
+	case LB_PIXEL_DEPTH_36BPP:
+		return "36 bpp";
+	default:
+		return "an unknown depth";
+	}
+}
+
+/*
+ * Hades: DCE: why the pipe that DC validated for a tunnelled stream would not carry its bytes
+ * unchanged, written to buf (true), or false: it would. From the validated context alone, the
+ * blocks that DC chooses by itself on DCE and that amdgpu_dm_dvbridge_check_scanout() cannot see:
+ * one pipe with the plane and no second plane (underlay) or ODM pipe; a graphics input CSC to put
+ * in bypass (dce_ipp_set_byte_passthrough()), a line buffer whose depth DC can set, and the read
+ * back; the line buffer at 24 bpp; the scaler at 1:1 with one tap, over the whole raster; the bit
+ * depth reduction of DITHER_OPTION_TRUN8 (truncation to 8 bits, no dither: DCP and formatter); and
+ * no clamp in the formatter.
+ */
+bool amdgpu_dm_dvbridge_dce_pipe_why(const struct dc_state *context,
+				     const struct dc_stream_state *stream, char *buf, size_t size)
+{
+	const int w = (int)stream->timing.h_addressable;
+	const int h = (int)stream->timing.v_addressable;
+	const struct bit_depth_reduction_params *bd = &stream->bit_depth_params;
+	const struct pipe_ctx *pipe = NULL;
+	const struct scaler_data *scl;
+	unsigned int pipes = 0;
+	size_t len = 0;
+	int i;
+
+	buf[0] = '\0';
+	for (i = 0; i < MAX_PIPES; i++) {
+		const struct pipe_ctx *p = &context->res_ctx.pipe_ctx[i];
+
+		if (p->stream != stream)
+			continue;
+		pipes++;
+		if (!p->top_pipe && !p->prev_odm_pipe)
+			pipe = p;
+	}
+	if (!stream->byte_tunnel)
+		len += scnprintf(buf + len, size - len, "the stream is not a byte tunnel for DC");
+	if (pipes != 1 || !pipe || !pipe->plane_state || pipe->bottom_pipe || pipe->next_odm_pipe) {
+		scnprintf(buf + len, size - len,
+			  "%sDC gives the stream %u pipes, with %s plane, %s second plane, %s ODM pipe",
+			  len ? "; " : "", pipes, pipe && pipe->plane_state ? "a" : "no",
+			  pipe && pipe->bottom_pipe ? "a" : "no",
+			  pipe && pipe->next_odm_pipe ? "an" : "no");
+		return true;
+	}
+	if (!pipe->plane_res.ipp || !pipe->plane_res.ipp->byte_passthrough_capable ||
+	    !pipe->plane_res.ipp->funcs->ipp_read_byte_tunnel ||
+	    !pipe->plane_res.xfm ||
+	    !pipe->plane_res.xfm->funcs->transform_set_pixel_storage_depth ||
+	    !pipe->plane_res.xfm->funcs->transform_read_byte_tunnel ||
+	    !pipe->stream_res.opp || !pipe->stream_res.opp->funcs->opp_read_byte_tunnel)
+		len += scnprintf(buf + len, size - len,
+				 "%sthe pipe lacks the graphics input CSC, the depth of its line buffer or its read back",
+				 len ? "; " : "");
+	scl = &pipe->plane_res.scl_data;
+	if (scl->lb_params.depth != LB_PIXEL_DEPTH_24BPP)
+		len += scnprintf(buf + len, size - len, "%sthe line buffer at %s, not 24 bpp",
+				 len ? "; " : "", amdgpu_dm_dvbridge_lb_name(scl->lb_params.depth));
+	if (scl->taps.h_taps != 1 || scl->taps.v_taps != 1 ||
+	    scl->taps.h_taps_c != 1 || scl->taps.v_taps_c != 1 ||
+	    scl->ratios.horz.value != dc_fixpt_one.value ||
+	    scl->ratios.vert.value != dc_fixpt_one.value ||
+	    scl->ratios.horz_c.value != dc_fixpt_one.value ||
+	    scl->ratios.vert_c.value != dc_fixpt_one.value)
+		len += scnprintf(buf + len, size - len,
+				 "%sthe scaler not at 1:1 with one tap (taps %u/%u, chroma %u/%u)",
+				 len ? "; " : "", scl->taps.h_taps, scl->taps.v_taps,
+				 scl->taps.h_taps_c, scl->taps.v_taps_c);
+	if (scl->viewport.x || scl->viewport.y || scl->viewport.width != w ||
+	    scl->viewport.height != h || scl->recout.x || scl->recout.y ||
+	    scl->recout.width != w || scl->recout.height != h)
+		len += scnprintf(buf + len, size - len,
+				 "%sviewport %dx%d%+d%+d, out %dx%d%+d%+d, of a %dx%d raster",
+				 len ? "; " : "", scl->viewport.width, scl->viewport.height,
+				 scl->viewport.x, scl->viewport.y, scl->recout.width, scl->recout.height,
+				 scl->recout.x, scl->recout.y, w, h);
+	if (!bd->flags.TRUNCATE_ENABLED || bd->flags.TRUNCATE_DEPTH != 1 || bd->flags.TRUNCATE_MODE ||
+	    bd->flags.SPATIAL_DITHER_ENABLED || bd->flags.FRAME_MODULATION_ENABLED)
+		len += scnprintf(buf + len, size - len,
+				 "%sbit depth reduction: truncation %u (depth %u, mode %u), spatial dither %u, frame modulation %u",
+				 len ? "; " : "", bd->flags.TRUNCATE_ENABLED, bd->flags.TRUNCATE_DEPTH,
+				 bd->flags.TRUNCATE_MODE, bd->flags.SPATIAL_DITHER_ENABLED,
+				 bd->flags.FRAME_MODULATION_ENABLED);
+	if (stream->clamping.clamping_level != CLAMPING_FULL_RANGE ||
+	    stream->clamping.pixel_encoding != PIXEL_ENCODING_RGB)
+		len += scnprintf(buf + len, size - len, "%sformatter clamp %d, pixel encoding %d",
+				 len ? "; " : "", stream->clamping.clamping_level,
+				 stream->clamping.pixel_encoding);
+	return len != 0;
+}
+
+/*
+ * Hades: DCE: after the global validation of DC, what it will program for the pipe of each
+ * tunnelled stream of the commit (amdgpu_dm_dvbridge_dce_pipe_why()). A stream whose pipe would not
+ * carry its bytes unchanged is refused, and why goes to DVBRIDGE_REFUSED and the kernel log: the
+ * display keeps its last configuration and user space goes on without the tunnel (HDR10).
+ */
+int amdgpu_dm_dvbridge_check_dce(struct drm_atomic_commit *state, const struct dc_state *context)
+{
+	struct drm_crtc_state *new_crtc_state;
+	struct drm_crtc *crtc;
+	char detail[384];
+	int i;
+
+	if (!context)
+		return 0;
+	for_each_new_crtc_in_state(state, crtc, new_crtc_state, i) {
+		const struct dc_stream_state *stream = to_dm_crtc_state(new_crtc_state)->stream;
+
+		if (!new_crtc_state->active || !amdgpu_dm_dvbridge_stream_active(stream) ||
+		    stream->ctx->dce_version >= DCE_VERSION_MAX)
+			continue;
+		if (!amdgpu_dm_dvbridge_dce_pipe_why(context, stream, detail, sizeof(detail)))
+			continue;
+		drm_dbg_atomic(state->dev,
+			       "[CRTC:%d:%s] Dolby Vision tunnel refused: DCE %s: %s\n", crtc->base.id,
+			       crtc->name, amdgpu_dm_dvbridge_dce_name(stream->ctx->dce_version),
+			       detail);
+		amdgpu_dm_dvbridge_refused_dce(state, crtc, detail);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+/*
+ * Hades: DCE: what in a read back of the pipe of a tunnelled stream (dc_stream_read_byte_tunnel())
+ * is not as the tunnel needs it, written to buf (true), or false: all of it is. The expected values
+ * are those that dce_ipp.c, dce_transform.c and dce_opp.c write for a byte tunnel stream with
+ * DITHER_OPTION_TRUN8; the expansion of the line buffer and of the formatter are not judged (the
+ * same as without the tunnel; each keeps the 8 most significant bits that are then truncated).
+ */
+bool amdgpu_dm_dvbridge_dce_readback_why(const struct dc_byte_tunnel_readback *rb, char *buf,
+					 size_t size)
+{
+	size_t len = 0;
+	bool clamp = false;
+	int i;
+
+	buf[0] = '\0';
+	if (!rb->ipp_read || !rb->xfm_read || !rb->opp_read || !rb->input_csc_read)
+		len += scnprintf(buf + len, size - len,
+				 "%snot every block answered (input %d, input CSC %d, transform %d, formatter %d)",
+				 len ? "; " : "", rb->ipp_read, rb->input_csc_read, rb->xfm_read,
+				 rb->opp_read);
+	if (rb->prescale_bypass != 1)
+		len += scnprintf(buf + len, size - len, "%sprescale on", len ? "; " : "");
+	if (rb->input_gamma_mode != 1)
+		len += scnprintf(buf + len, size - len, "%sinput gamma LUT on", len ? "; " : "");
+	if (rb->input_csc_mode)
+		len += scnprintf(buf + len, size - len, "%sgraphics input CSC in mode %u",
+				 len ? "; " : "", rb->input_csc_mode);
+	if (rb->degamma_mode)
+		len += scnprintf(buf + len, size - len, "%sdegamma mode %u", len ? "; " : "",
+				 rb->degamma_mode);
+	if (rb->gamut_remap_mode)
+		len += scnprintf(buf + len, size - len, "%sgamut remap mode %u", len ? "; " : "",
+				 rb->gamut_remap_mode);
+	if (rb->regamma_mode)
+		len += scnprintf(buf + len, size - len, "%sregamma mode %u", len ? "; " : "",
+				 rb->regamma_mode);
+	if (rb->output_csc_mode)
+		len += scnprintf(buf + len, size - len, "%soutput CSC mode %u", len ? "; " : "",
+				 rb->output_csc_mode);
+	if (rb->denorm_mode)
+		len += scnprintf(buf + len, size - len, "%sdenormalisation mode %u", len ? "; " : "",
+				 rb->denorm_mode);
+	for (i = 0; i < 3; i++)
+		if (rb->clamp_min[i] || rb->clamp_max[i] != 0x3fc0)
+			clamp = true;
+	if (clamp)
+		len += scnprintf(buf + len, size - len, "%sthe DCP clamp is not 0-0x3fc0 (8 bits)",
+				 len ? "; " : "");
+	if (rb->round_trunc_mode != 4)
+		len += scnprintf(buf + len, size - len,
+				 "%sDCP round/truncate mode %u, not truncation to 8 bits", len ? "; " : "",
+				 rb->round_trunc_mode);
+	if (rb->dcp_dither_en)
+		len += scnprintf(buf + len, size - len, "%sDCP dither on", len ? "; " : "");
+	if (rb->lb_pixel_depth != 1)
+		len += scnprintf(buf + len, size - len, "%sline buffer depth %u, not 24 bpp",
+				 len ? "; " : "", rb->lb_pixel_depth);
+	if (rb->scl_mode)
+		len += scnprintf(buf + len, size - len, "%sscaler mode %u", len ? "; " : "",
+				 rb->scl_mode);
+	if (!rb->fmt_truncate_en || rb->fmt_truncate_depth != 1 || rb->fmt_truncate_mode)
+		len += scnprintf(buf + len, size - len,
+				 "%sformatter truncation %u (depth %u, mode %u), not to 8 bits",
+				 len ? "; " : "", rb->fmt_truncate_en, rb->fmt_truncate_depth,
+				 rb->fmt_truncate_mode);
+	if (rb->fmt_spatial_dither_en || rb->fmt_temporal_dither_en)
+		len += scnprintf(buf + len, size - len, "%sformatter dither on", len ? "; " : "");
+	if (rb->fmt_clamp_en || rb->fmt_clamp_color_format)
+		len += scnprintf(buf + len, size - len, "%sformatter clamp on", len ? "; " : "");
+	if (rb->fmt_pixel_encoding)
+		len += scnprintf(buf + len, size - len, "%sformatter pixel encoding %u",
+				 len ? "; " : "", rb->fmt_pixel_encoding);
+	return len != 0;
+}
+
+#define DVBRIDGE_DCE_READBACK_FORMAT \
+	"prescale bypass %u, input gamma %u, input CSC %u (found %u), degamma %u, gamut remap %u, regamma %u, output CSC %u, denormalisation %u, clamp %#x-%#x %#x-%#x %#x-%#x, round/truncate %u, DCP dither %u, line buffer %u (expansion %u), scaler %u; formatter truncation %u/%u/%u, dither %u/%u, clamp %u/%u, expansion %u/%u, encoding %u; HDMI encoder up to %u kHz, 6 Gbps %s"
+#define DVBRIDGE_DCE_READBACK_VALUES(rb, enc) \
+	(rb)->prescale_bypass, (rb)->input_gamma_mode, (rb)->input_csc_mode, \
+	(rb)->input_csc_mode_before, (rb)->degamma_mode, (rb)->gamut_remap_mode, (rb)->regamma_mode, \
+	(rb)->output_csc_mode, (rb)->denorm_mode, (rb)->clamp_min[0], (rb)->clamp_max[0], \
+	(rb)->clamp_min[1], (rb)->clamp_max[1], (rb)->clamp_min[2], (rb)->clamp_max[2], \
+	(rb)->round_trunc_mode, (rb)->dcp_dither_en, (rb)->lb_pixel_depth, (rb)->lb_expan_mode, \
