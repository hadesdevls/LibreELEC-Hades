+/*
+ * Hades: DCE: once each time the tunnel goes on (a modeset of a tunnelled stream), the pipe of the
+ * stream as its registers hold it, into the kernel log, with what is not as the tunnel needs
+ * (amdgpu_dm_dvbridge_dce_readback_why()); also the mode in which the tunnel found the graphics
+ * input CSC, which DC does not program otherwise, and what the VBIOS lets the HDMI encoder send.
+ * The hardware is not changed from here: what decides the tunnel is checked before the commit
+ * (amdgpu_dm_dvbridge_check_dce()). With the DC lock held.
+ */
+void amdgpu_dm_dvbridge_log_dce(struct drm_crtc *crtc, const struct dc_stream_state *stream)
+{
+	const struct link_encoder *enc = stream->link ? stream->link->link_enc : NULL;
+	const char *name = amdgpu_dm_dvbridge_dce_name(stream->ctx->dce_version);
+	struct dc_byte_tunnel_readback rb;
+	char why[384];
+
+	if (!dc_stream_read_byte_tunnel(stream->ctx->dc, stream, &rb) &&
+	    !rb.ipp_read && !rb.xfm_read && !rb.opp_read) {
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: its pipe could not be read back\n",
+			 crtc->base.id, crtc->name, name);
+		return;
+	}
+	if (amdgpu_dm_dvbridge_dce_readback_why(&rb, why, sizeof(why)))
+		drm_warn(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back NOT as the tunnel needs (%s): " DVBRIDGE_DCE_READBACK_FORMAT "\n",
+			 crtc->base.id, crtc->name, name, why, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
+	else
+		drm_info(crtc->dev,
+			 "[CRTC:%d:%s] Dolby Vision tunnel, DCE %s: read back as the tunnel needs: " DVBRIDGE_DCE_READBACK_FORMAT "\n",
+			 crtc->base.id, crtc->name, name, DVBRIDGE_DCE_READBACK_VALUES(&rb, enc));
