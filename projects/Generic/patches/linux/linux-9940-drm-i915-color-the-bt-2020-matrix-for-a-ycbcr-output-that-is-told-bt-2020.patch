From 98f04c32f2e8cc58f05b84ac4569fb081ce0a19f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:52:52 +0000
Subject: [PATCH] drm/i915/color: the BT.2020 matrix for a YCbCr output that is
 told BT.2020

A YCbCr output of i915 (4:2:0 over HDMI) is made from the RGB of the
pipe with one matrix, BT.709 (ilk_csc_matrix_rgb_to_ycbcr), whatever
the AVI InfoFrame tells the sink. With the Colorspace property at
BT2020_RGB or BT2020_YCC, which is how HDR10 and HLG are signalled, the
AVI InfoFrame says BT.2020 (C=3, EC=6) and the sink decodes with the
BT.2020 matrix what was made with the BT.709 one: every colour of an
HDR picture in 4:2:0 shifts (Kr 0.2126 against 0.2627, Kb 0.0722
against 0.0593). Upstream sends 4:2:0 only for modes that the sink
takes in 4:2:0 alone; linux-9968 sends HDR in it at 2160p50 and
2160p60.

Where the HDMI AVI InfoFrame of the CRTC tells the sink BT.2020, the
pipe CSC (display 10) or the output CSC (display 11 and later) now
takes the BT.2020 (non-constant luminance) full range RGB to limited
range YCbCr matrix. Everything else keeps the BT.709 one, as before:
DisplayPort, and HDMI with any other colorimetry. The colour check runs
after the encoder has computed the InfoFrame; the state readout and
the fastset path take the matrix as they take the BT.709 one.

The coefficients are in the encoding of the BT.709 table (sign,
exponent and a 9-bit mantissa, as ilk_csc_convert_ctm() writes a CTM),
each row the one of least error among the nearest values and their
neighbours. A host test, with the two tables taken out of the file as
they are and decoded as the driver encodes, finds the BT.2020 table
within 0.42 of a 10-bit code of the exact BT.2020 matrix over the RGB
cube, and a grey within 0.25 of a code of neutral; the BT.709 table of
upstream, decoded the same way, is within 1.25 codes of BT.709.
---
 drivers/gpu/drm/i915/display/intel_color.c | 44 +++++++++++++++++++++-
 1 file changed, 42 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_color.c b/drivers/gpu/drm/i915/display/intel_color.c
index 7ef870c..b3035c0 100644
--- a/drivers/gpu/drm/i915/display/intel_color.c
+++ b/drivers/gpu/drm/i915/display/intel_color.c
@@ -31,6 +31,7 @@
 #include "intel_display_types.h"
 #include "intel_display_utils.h"
 #include "intel_dsb.h"
+#include "intel_hdmi.h"
 #include "intel_vrr.h"
 #include "skl_universal_plane.h"
 #include "skl_universal_plane_regs.h"
@@ -185,6 +186,45 @@ static const struct intel_csc_matrix ilk_csc_matrix_rgb_to_ycbcr = {
 	},
 };
 
+/*
+ * Hades: BT.2020 (non-constant luminance) full range RGB -> limited range YCbCr matrix, for a
+ * YCbCr output whose HDMI AVI InfoFrame tells the sink BT.2020 (HDR10 and HLG). The coefficients
+ * are those of the BT.709 matrix above with Kr 0.2627 and Kb 0.0593, in the same encoding (sign,
+ * exponent, 9-bit mantissa), each row the one of least error among the nearest values and their
+ * neighbours: within 0.42 of a 10-bit code of the exact matrix over the whole RGB cube, a grey
+ * within 0.25 of a code of neutral (the table above: 1.25 codes and 1.25).
+ */
+static const struct intel_csc_matrix ilk_csc_matrix_rgb_to_ycbcr_bt2020 = {
+	.preoff = {},
+	.coeff = {
+		0x1e10, 0x9cf0, 0xb480,
+		0x2e70, 0x0950, 0x3688,
+		0xbfb8, 0x9a20, 0x1e10,
+	},
+	.postoff = {
+		0x0800, 0x0100, 0x0800,
+	},
+};
+
+/*
+ * Hades: the RGB -> YCbCr matrix of a YCbCr output: BT.2020 where the HDMI AVI InfoFrame of the
+ * CRTC tells the sink BT.2020 (Y'CbCr, the colorimetry of the Colorspace property BT2020_RGB and
+ * BT2020_YCC), so that the sink decodes it with the matrix it was made with; BT.709 otherwise, as
+ * before (the default colorimetry of an HD mode). Called from the colour check, after the
+ * encoder has computed the InfoFrame.
+ */
+static const struct intel_csc_matrix *
+intel_csc_rgb_to_ycbcr(const struct intel_crtc_state *crtc_state)
+{
+	const struct hdmi_avi_infoframe *avi = &crtc_state->infoframes.avi.avi;
+
+	if (crtc_state->infoframes.enable & intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_AVI) &&
+	    avi->colorimetry == HDMI_COLORIMETRY_EXTENDED &&
+	    avi->extended_colorimetry == HDMI_EXTENDED_COLORIMETRY_BT2020)
+		return &ilk_csc_matrix_rgb_to_ycbcr_bt2020;
+	return &ilk_csc_matrix_rgb_to_ycbcr;
+}
+
 static void intel_csc_clear(struct intel_csc_matrix *csc)
 {
 	memset(csc, 0, sizeof(*csc));
@@ -536,7 +576,7 @@ static void ilk_assign_csc(struct intel_crtc_state *crtc_state)
 	} else if (crtc_state->output_format != INTEL_OUTPUT_FORMAT_RGB) {
 		drm_WARN_ON(display->drm, !crtc_state->csc_enable);
 
-		ilk_csc_copy(display, &crtc_state->csc, &ilk_csc_matrix_rgb_to_ycbcr);
+		ilk_csc_copy(display, &crtc_state->csc, intel_csc_rgb_to_ycbcr(crtc_state));
 	} else if (limited_color_range) {
 		drm_WARN_ON(display->drm, !crtc_state->csc_enable);
 
@@ -582,7 +622,7 @@ static void icl_assign_csc(struct intel_crtc_state *crtc_state)
 	if (crtc_state->output_format != INTEL_OUTPUT_FORMAT_RGB) {
 		drm_WARN_ON(display->drm, (crtc_state->csc_mode & ICL_OUTPUT_CSC_ENABLE) == 0);
 
-		ilk_csc_copy(display, &crtc_state->output_csc, &ilk_csc_matrix_rgb_to_ycbcr);
+		ilk_csc_copy(display, &crtc_state->output_csc, intel_csc_rgb_to_ycbcr(crtc_state));
 	} else if (crtc_state->limited_color_range) {
 		drm_WARN_ON(display->drm, (crtc_state->csc_mode & ICL_OUTPUT_CSC_ENABLE) == 0);
 
