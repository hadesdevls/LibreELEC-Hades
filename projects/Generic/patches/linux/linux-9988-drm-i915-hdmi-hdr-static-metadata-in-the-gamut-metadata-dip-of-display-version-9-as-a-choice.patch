diff --git a/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c b/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c
new file mode 100644
index 000000000000..c9fd82079f9a
--- /dev/null
+++ b/drivers/gpu/drm/tests/drm_hdmi_gmp_hdr_test.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Hades: KUnit tests of intel_hdmi_gmp_hdr.h, the DRM InfoFrame of an HDMI port of i915 in the
+ * gamut metadata DIP of display version 9 (i915.hdmi_hdr_gmp), with the kernel's own InfoFrame
+ * packers (drivers/video/hdmi.c): where the InfoFrame goes on each display version, the data that
+ * the DIP is given (the bytes of the packet, in the layout of every other DIP of i915, and no more
+ * than the 32 bytes of that DIP before display version 11), that the readout gives back the same
+ * InfoFrame, and that a DIP holding another packet gives none. The registers themselves are not
+ * here: no display of version 9 has been seen to take the packet from that DIP.
+ */
+#include <kunit/test.h>
+#include <linux/hdmi.h>
+
+#include "../i915/display/intel_hdmi_gmp_hdr.h"
+
+/* the size of the gamut metadata DIP before display version 11 (hsw_dip_data_size()) */
+#define GMP_DIP_SIZE_DISPLAY9	32
+
+/* the HDR10 metadata of a film: ST 2084, BT.2020 primaries, D65, 1000 and 0.005 cd/m2, 1000/400 */
+static void gmp_hdr10(struct kunit *test, struct hdmi_drm_infoframe *f)
+{
+	KUNIT_ASSERT_EQ(test, hdmi_drm_infoframe_init(f), 0);
+	f->eotf = HDMI_EOTF_SMPTE_ST2084;
+	f->metadata_type = HDMI_STATIC_METADATA_TYPE1;
+	f->display_primaries[0].x = 34000;	/* green, then blue, then red (CTA-861-G) */
+	f->display_primaries[0].y = 16000;
+	f->display_primaries[1].x = 13250;
+	f->display_primaries[1].y = 34500;
+	f->display_primaries[2].x = 7500;
+	f->display_primaries[2].y = 3000;
+	f->white_point.x = 15635;
+	f->white_point.y = 16450;
+	f->max_display_mastering_luminance = 1000;
+	f->min_display_mastering_luminance = 50;
+	f->max_cll = 1000;
+	f->max_fall = 400;
+}
+
+static void drm_test_gmp_hdr_dip_of(struct kunit *test)
+{
+	int ver;
+
+	for (ver = 2; ver <= 35; ver++) {
+		const enum intel_hdmi_drm_dip without = intel_hdmi_drm_dip_of(ver, false);
+		const enum intel_hdmi_drm_dip with = intel_hdmi_drm_dip_of(ver, true);
+
+		if (ver >= 10) {
+			/* its own DIP, whatever the parameter says */
+			KUNIT_EXPECT_EQ(test, without, INTEL_HDMI_DRM_DIP_DRM);
+			KUNIT_EXPECT_EQ(test, with, INTEL_HDMI_DRM_DIP_DRM);
+		} else if (ver == 9) {
+			KUNIT_EXPECT_EQ(test, without, INTEL_HDMI_DRM_DIP_NONE);
+			KUNIT_EXPECT_EQ(test, with, INTEL_HDMI_DRM_DIP_GMP);
+		} else {
+			/* before version 9 nothing, with the parameter or without */
+			KUNIT_EXPECT_EQ(test, without, INTEL_HDMI_DRM_DIP_NONE);
+			KUNIT_EXPECT_EQ(test, with, INTEL_HDMI_DRM_DIP_NONE);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, intel_hdmi_drm_dip_type(INTEL_HDMI_DRM_DIP_GMP),
+			(unsigned int)HDMI_PACKET_TYPE_GAMUT_METADATA);
+	KUNIT_EXPECT_EQ(test, intel_hdmi_drm_dip_type(INTEL_HDMI_DRM_DIP_DRM),
+			(unsigned int)HDMI_INFOFRAME_TYPE_DRM);
+}
+
+static void drm_test_gmp_hdr_bytes(struct kunit *test)
+{
+	union hdmi_infoframe frame = {}, back = {};
+	u8 dip[GMP_DIP_SIZE_DISPLAY9], ref[GMP_DIP_SIZE_DISPLAY9];
+	ssize_t len, rlen;
+	unsigned int i, sum = 0;
+
+	gmp_hdr10(test, &frame.drm);
+	memset(dip, 0xee, sizeof(dip));
+	len = intel_hdmi_gmp_dip_of_drm(&frame, dip, sizeof(dip));
+
+	/* 3 header bytes, the byte at 3, the checksum, 26 bytes of payload: within the DIP */
+	KUNIT_ASSERT_EQ(test, len, (ssize_t)(3 + 1 + 1 + HDMI_DRM_INFOFRAME_SIZE));
+	KUNIT_EXPECT_LE(test, len, (ssize_t)GMP_DIP_SIZE_DISPLAY9);
+	KUNIT_EXPECT_EQ(test, dip[0], 0x87);
+	KUNIT_EXPECT_EQ(test, dip[1], 0x01);
+	KUNIT_EXPECT_EQ(test, dip[2], 0x1a);
+	KUNIT_EXPECT_EQ(test, dip[3], 0x00);
+	KUNIT_EXPECT_TRUE(test, intel_hdmi_dip_holds_drm(dip));
+
+	/* the packet (the byte at 3 aside) sums to 0 */
+	for (i = 0; i < len; i++)
+		if (i != 3)
+			sum += dip[i];
+	KUNIT_EXPECT_EQ(test, sum % 256, 0u);
+
+	/* the bytes of the packet: those of the kernel's packer, as the DRM DIP would get them */
+	rlen = hdmi_infoframe_pack_only(&frame, ref, sizeof(ref));
+	KUNIT_ASSERT_EQ(test, rlen, len - 1);
+	KUNIT_EXPECT_MEMEQ(test, dip, ref, 3);
+	KUNIT_EXPECT_MEMEQ(test, dip + 4, ref + 3, rlen - 3);
+	/* EOTF and the first primary, in the payload */
+	KUNIT_EXPECT_EQ(test, dip[5], HDMI_EOTF_SMPTE_ST2084);
+	KUNIT_EXPECT_EQ(test, dip[6], HDMI_STATIC_METADATA_TYPE1);
+	KUNIT_EXPECT_EQ(test, dip[7] | dip[8] << 8, 34000);
+
+	/* the readout gives the same InfoFrame back */
+	KUNIT_ASSERT_EQ(test, intel_hdmi_drm_of_gmp_dip(&back, dip, sizeof(dip)), 0);
+	KUNIT_EXPECT_EQ(test, back.any.type, HDMI_INFOFRAME_TYPE_DRM);
+	KUNIT_EXPECT_MEMEQ(test, &back.drm, &frame.drm, sizeof(frame.drm));
+
+	/* only a DRM InfoFrame is packed for the DIP */
+	hdmi_avi_infoframe_init(&frame.avi);
+	KUNIT_EXPECT_LT(test, intel_hdmi_gmp_dip_of_drm(&frame, dip, sizeof(dip)), 0);
+}
+
+static void drm_test_gmp_hdr_other_packets(struct kunit *test)
+{
+	/* an HDMI gamut metadata packet, the HDR InfoFrame SDP of DisplayPort, a Dolby vendor SDP */
+	static const u8 gmp[4] = { 0x0a, 0x80, 0x00, 0x00 };
+	static const u8 dp_sdp[4] = { 0x00, 0x87, 0x1d, 0x4c };
+	static const u8 dolby_sdp[4] = { 0x00, 0x81, 0x1b, 0x00 };
+	/* a DRM InfoFrame of another version or length */
+	static const u8 v2[4] = { 0x87, 0x02, 0x1a, 0x00 };
+	static const u8 len27[4] = { 0x87, 0x01, 0x1b, 0x00 };
+	static const u8 zero[4] = {};
+	const u8 *const others[] = { gmp, dp_sdp, dolby_sdp, v2, len27, zero };
+	union hdmi_infoframe frame;
+	u8 dip[GMP_DIP_SIZE_DISPLAY9];
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(others); i++) {
+		memset(dip, 0, sizeof(dip));
+		memcpy(dip, others[i], 4);
+		KUNIT_EXPECT_FALSE(test, intel_hdmi_dip_holds_drm(dip));
+		memset(&frame, 0x5a, sizeof(frame));
+		KUNIT_EXPECT_EQ(test, intel_hdmi_drm_of_gmp_dip(&frame, dip, sizeof(dip)), -EINVAL);
+	}
+
+	/* a DRM header whose checksum is wrong unpacks to nothing */
+	{
+		union hdmi_infoframe good = {};
+
+		gmp_hdr10(test, &good.drm);
+		KUNIT_ASSERT_GT(test, intel_hdmi_gmp_dip_of_drm(&good, dip, sizeof(dip)), 0);
+		dip[4] ^= 0xff;
+		KUNIT_EXPECT_NE(test, intel_hdmi_drm_of_gmp_dip(&frame, dip, sizeof(dip)), 0);
+	}
+}
+
+static struct kunit_case drm_hdmi_gmp_hdr_tests[] = {
+	KUNIT_CASE(drm_test_gmp_hdr_dip_of),
+	KUNIT_CASE(drm_test_gmp_hdr_bytes),
+	KUNIT_CASE(drm_test_gmp_hdr_other_packets),
+	{ }
+};
+
+static struct kunit_suite drm_hdmi_gmp_hdr_test_suite = {
+	.name = "drm_hdmi_gmp_hdr",
+	.test_cases = drm_hdmi_gmp_hdr_tests,
+};
+
+kunit_test_suite(drm_hdmi_gmp_hdr_test_suite);
+
+MODULE_DESCRIPTION("Hades: KUnit tests of the DRM InfoFrame in the gamut metadata DIP of i915");
+MODULE_LICENSE("GPL");
