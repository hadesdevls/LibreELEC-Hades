diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 0095b27c77e9..6eff8bc9ab03 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -69,6 +69,7 @@
 #include "intel_hdcp_shim.h"
 #include "intel_hdmi.h"
 #include "intel_hdr10plus.h"
+#include "intel_hdmi_gmp_hdr.h"
 #include "intel_link_bw.h"
 #include "intel_lspcon.h"
 #include "intel_panel.h"
@@ -691,6 +692,22 @@ u32 intel_hdmi_infoframe_enable(unsigned int type)
 	return 0;
 }
 
+/*
+ * Hades: where the DRM InfoFrame of an HDMI port goes (intel_hdmi_gmp_hdr.h): its own DIP from
+ * display version 10 on, the gamut metadata DIP on version 9 with i915.hdmi_hdr_gmp, else nowhere
+ */
+static enum intel_hdmi_drm_dip intel_hdmi_drm_dip(struct intel_display *display)
+{
+	return intel_hdmi_drm_dip_of(DISPLAY_VER(display), display->params.hdmi_hdr_gmp);
+}
+
+/* Hades: the DRM InfoFrame of this HDMI configuration is in the gamut metadata DIP */
+bool intel_hdmi_drm_in_gmp(const struct intel_crtc_state *crtc_state)
+{
+	return intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI) &&
+	       intel_hdmi_drm_dip(to_intel_display(crtc_state)) == INTEL_HDMI_DRM_DIP_GMP;
+}
+
 u32 intel_hdmi_infoframes_enabled(struct intel_encoder *encoder,
 				  const struct intel_crtc_state *crtc_state)
 {
@@ -839,6 +856,11 @@ static void intel_hdmi_log_infoframe(struct intel_encoder *encoder,
 			 encoder->base.name, hades_if_pipe(crtc_state),
 			 packed[6], packed[5], packed[4], n, bytes,
 			 st->suppressed ? " (changes not said since the last line: see next)" : "");
+	else if (type == HDMI_INFOFRAME_TYPE_DRM && intel_hdmi_drm_in_gmp(crtc_state))
+		drm_info(display->drm,
+			 "Hades: %s pipe %c: %s InfoFrame in the gamut metadata slot (i915.hdmi_hdr_gmp), %d bytes: %s\n",
+			 encoder->base.name, hades_if_pipe(crtc_state),
+			 hades_infoframe_name(type), n, bytes);
 	else
 		drm_info(display->drm, "Hades: %s pipe %c: %s InfoFrame, %d bytes: %s\n",
 			 encoder->base.name, hades_if_pipe(crtc_state),
@@ -885,6 +907,55 @@ static void intel_write_infoframe(struct intel_encoder *encoder,
 	dig_port->write_infoframe(encoder, crtc_state, type, buffer, len);
 }
 
+/*
+ * Hades: the DRM InfoFrame in the gamut metadata DIP (intel_hdmi_gmp_hdr.h), packed as
+ * intel_write_infoframe() packs it, then read back: the DIP has to hold what was written
+ */
+static void intel_hdmi_write_gmp_drm_infoframe(struct intel_encoder *encoder,
+					       const struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	const union hdmi_infoframe *frame = &crtc_state->infoframes.drm;
+	u8 buffer[VIDEO_DIP_DATA_SIZE] = {};
+	u8 back[VIDEO_DIP_DATA_SIZE];
+	ssize_t len;
+
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_PACKET_TYPE_GAMUT_METADATA)) == 0) {
+		intel_hdmi_log_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_DRM,
+					 NULL, 0, true);
+		return;
+	}
+
+	/* the layout of intel_write_infoframe(), see the comment above intel_hdmi_log_infoframe() */
+	len = intel_hdmi_gmp_dip_of_drm(frame, buffer, sizeof(buffer));
+	if (drm_WARN_ON(encoder->base.dev, len < 0))
+		return;
+
+	intel_hdmi_log_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_DRM, buffer, len, false);
+	dig_port->write_infoframe(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA,
+				  buffer, len);
+
+	/* (byte 3 is no part of the packet: i915 reads past it, intel_read_infoframe()) */
+	dig_port->read_infoframe(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA,
+				 back, sizeof(back));
+	if (memcmp(back, buffer, 3) || memcmp(back + 4, buffer + 4, len - 4))
+		drm_err(encoder->base.dev,
+			"Hades: %s: the gamut metadata DIP does not hold the DRM InfoFrame written to it (read back: %*ph)\n",
+			encoder->base.name, (int)len, back);
+}
+
+/* Hades: the DRM InfoFrame, in the DIP that the configuration puts it in */
+static void intel_hdmi_write_drm_infoframe(struct intel_encoder *encoder,
+					   const struct intel_crtc_state *crtc_state)
+{
+	if (intel_hdmi_drm_in_gmp(crtc_state))
+		intel_hdmi_write_gmp_drm_infoframe(encoder, crtc_state);
+	else
+		intel_write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_DRM,
+				      &crtc_state->infoframes.drm);
+}
+
 /* Hades: the vendor DIP, with the HDR10+ InfoFrame where there is one (intel_hdr10plus.h) */
 static void intel_hdmi_write_vendor_infoframe(struct intel_encoder *encoder,
 					      const struct intel_crtc_state *crtc_state)
@@ -968,6 +1039,34 @@ void intel_read_infoframe(struct intel_encoder *encoder,
 			    frame->any.type, type);
 }
 
+/*
+ * Hades: the readout of the DRM InfoFrame; from the gamut metadata DIP where the configuration
+ * puts it there (intel_hdmi_gmp_hdr.h), and only if that DIP holds a DRM InfoFrame
+ */
+void intel_hdmi_read_drm_infoframe(struct intel_encoder *encoder,
+				   struct intel_crtc_state *crtc_state)
+{
+	struct intel_digital_port *dig_port = enc_to_dig_port(encoder);
+	u8 buffer[VIDEO_DIP_DATA_SIZE];
+
+	if (!intel_hdmi_drm_in_gmp(crtc_state)) {
+		intel_read_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_DRM,
+				     &crtc_state->infoframes.drm);
+		return;
+	}
+
+	if ((crtc_state->infoframes.enable &
+	     intel_hdmi_infoframe_enable(HDMI_PACKET_TYPE_GAMUT_METADATA)) == 0)
+		return;
+
+	dig_port->read_infoframe(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA,
+				 buffer, sizeof(buffer));
+	if (intel_hdmi_drm_of_gmp_dip(&crtc_state->infoframes.drm, buffer, sizeof(buffer)))
+		drm_dbg_kms(encoder->base.dev,
+			    "the gamut metadata DIP holds no DRM InfoFrame that unpacks (header %02x %02x %02x)\n",
+			    buffer[0], buffer[1], buffer[2]);
+}
+
 /*
  * Hades: the HDR10+ application version that the EDID read at detect declares, -1 for none
  * (hdr10plus_sink of struct intel_connector, which detect writes as it writes dv_sink)
@@ -1265,9 +1364,11 @@ intel_hdmi_compute_drm_infoframe(struct intel_encoder *encoder,
 {
 	struct intel_display *display = to_intel_display(encoder);
 	struct hdmi_drm_infoframe *frame = &crtc_state->infoframes.drm.drm;
+	/* Hades: in its own DIP, or in the gamut metadata DIP (intel_hdmi_gmp_hdr.h) */
+	const enum intel_hdmi_drm_dip dip = intel_hdmi_drm_dip(display);
 	int ret;
 
-	if (DISPLAY_VER(display) < 10)
+	if (dip == INTEL_HDMI_DRM_DIP_NONE)
 		return true;
 
 	if (!crtc_state->has_infoframe)
@@ -1277,7 +1378,7 @@ intel_hdmi_compute_drm_infoframe(struct intel_encoder *encoder,
 		return true;
 
 	crtc_state->infoframes.enable |=
-		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_DRM);
+		intel_hdmi_infoframe_enable(intel_hdmi_drm_dip_type(dip));
 
 	ret = drm_hdmi_infoframe_set_hdr_metadata(frame, conn_state);
 	if (ret < 0) {
@@ -1666,20 +1767,22 @@ void intel_hdmi_fastset_infoframes(struct intel_encoder *encoder,
 	intel_reg_t reg = HSW_TVIDEO_DIP_CTL(display,
 					    crtc_state->cpu_transcoder);
 	u32 val = intel_de_read(display, reg);
+	/* Hades: the DIP of the DRM InfoFrame (intel_hdmi_gmp_hdr.h) */
+	const bool gmp = intel_hdmi_drm_in_gmp(crtc_state);
+	const unsigned int type = gmp ? HDMI_PACKET_TYPE_GAMUT_METADATA : HDMI_INFOFRAME_TYPE_DRM;
+	const u32 slot = gmp ? VIDEO_DIP_ENABLE_GMP_HSW : VIDEO_DIP_ENABLE_DRM_GLK;
 
 	if ((crtc_state->infoframes.enable &
-		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_DRM)) == 0 &&
-			(val & VIDEO_DIP_ENABLE_DRM_GLK) == 0)
+		intel_hdmi_infoframe_enable(type)) == 0 &&
+			(val & slot) == 0)
 		return;
 
-	val &= ~(VIDEO_DIP_ENABLE_DRM_GLK);
+	val &= ~slot;
 
 	intel_de_write(display, reg, val);
 	intel_de_posting_read(display, reg);
 
-	intel_write_infoframe(encoder, crtc_state,
-			      HDMI_INFOFRAME_TYPE_DRM,
-			      &crtc_state->infoframes.drm);
+	intel_hdmi_write_drm_infoframe(encoder, crtc_state);
 }
 
 static void hsw_set_infoframes(struct intel_encoder *encoder,
@@ -1719,9 +1822,7 @@ static void hsw_set_infoframes(struct intel_encoder *encoder,
 			      HDMI_INFOFRAME_TYPE_SPD,
 			      &crtc_state->infoframes.spd);
 	intel_hdmi_write_vendor_infoframe(encoder, crtc_state); /* Hades */
-	intel_write_infoframe(encoder, crtc_state,
-			      HDMI_INFOFRAME_TYPE_DRM,
-			      &crtc_state->infoframes.drm);
+	intel_hdmi_write_drm_infoframe(encoder, crtc_state); /* Hades */
 }
 
