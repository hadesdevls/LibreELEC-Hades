diff --git a/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h b/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h
new file mode 100644
index 000000000000..afa86036aadf
--- /dev/null
+++ b/drivers/gpu/drm/i915/display/intel_hdmi_gmp_hdr.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Hades: where the DRM InfoFrame (Dynamic Range and Mastering, the HDR static metadata of
+ * CTA-861-G 6.9) of an HDMI port goes.
+ *
+ * Display version 10 and later have a DIP of its own for it (VIDEO_DIP_ENABLE_DRM_GLK,
+ * GLK_TVIDEO_DIP_DRM_DATA), and i915 offers HDR_OUTPUT_METADATA on their HDMI ports. Display
+ * version 9 (Skylake, Broxton, Kaby Lake, Coffee Lake, Comet Lake) has none, so i915 offers HDR
+ * there only through an LSPCON, which sends the InfoFrame itself; its native HDMI port, HDMI 1.4
+ * at 300 MHz, sends no HDR. Each transcoder of those versions has a gamut metadata DIP
+ * (VIDEO_DIP_ENABLE_GMP_HSW, HSW_TVIDEO_DIP_GMP_DATA) that nothing uses over HDMI. Its header
+ * bytes, like those of the other DIPs, are the first ones that are written to it: over DisplayPort, i915
+ * sends the HDR metadata InfoFrame SDP in it from Haswell on (header 00 87 1d 4c,
+ * intel_dp_hdr_metadata_infoframe_sdp_pack()), and Hades the Dolby vendor InfoFrame SDP of a
+ * converter (intel_dp_pcon_dv_write()). With i915.hdmi_hdr_gmp=1, an HDMI port of display version
+ * 9 carries the DRM InfoFrame there, with its own header (87 01 1a), and offers
+ * HDR_OUTPUT_METADATA as version 10 does; without it, nothing changes. CroqueMr's build does the
+ * same (its linux-9900-07); no display has been seen to take the packet from that DIP.
+ *
+ * In the configuration the InfoFrame is crtc_state->infoframes.drm, as everywhere; what changes
+ * is the bit of infoframes.enable that says it is sent (that of the DIP it goes in, as over
+ * DisplayPort), the DIP that intel_hdmi.c writes and reads it in, and, on readout, the check that
+ * the DIP holds a DRM InfoFrame and not some other packet.
+ */
+#ifndef __INTEL_HDMI_GMP_HDR_H__
+#define __INTEL_HDMI_GMP_HDR_H__
+
+#include <linux/errno.h>
+#include <linux/hdmi.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+enum intel_hdmi_drm_dip {
+	INTEL_HDMI_DRM_DIP_NONE,	/* not sent: no HDR_OUTPUT_METADATA on the port */
+	INTEL_HDMI_DRM_DIP_DRM,		/* its own DIP: display version 10 and later */
+	INTEL_HDMI_DRM_DIP_GMP,		/* the gamut metadata DIP: display version 9, by choice */
+};
+
+/* @gmp: i915.hdmi_hdr_gmp */
+static inline enum intel_hdmi_drm_dip intel_hdmi_drm_dip_of(int display_ver, bool gmp)
+{
+	if (display_ver >= 10)
+		return INTEL_HDMI_DRM_DIP_DRM;
+	if (display_ver == 9 && gmp)
+		return INTEL_HDMI_DRM_DIP_GMP;
+	return INTEL_HDMI_DRM_DIP_NONE;
+}
+
+/* the packet type whose bit of infoframes.enable, and whose DIP, carry the DRM InfoFrame */
+static inline unsigned int intel_hdmi_drm_dip_type(enum intel_hdmi_drm_dip dip)
+{
+	return dip == INTEL_HDMI_DRM_DIP_GMP ? HDMI_PACKET_TYPE_GAMUT_METADATA :
+					       HDMI_INFOFRAME_TYPE_DRM;
+}
+
+/*
+ * The data of a DIP (HB0, HB1, HB2, the byte that i915 leaves for the ECC, then PB0, the
+ * checksum, and the payload) holds a DRM InfoFrame: type 0x87, version 1, length 26
+ */
+static inline bool intel_hdmi_dip_holds_drm(const u8 *dip)
+{
+	return dip[0] == HDMI_INFOFRAME_TYPE_DRM && dip[1] == 1 &&
+	       dip[2] == HDMI_DRM_INFOFRAME_SIZE;
+}
+
+/*
+ * The data that the gamut metadata DIP is given for the DRM InfoFrame @frame, in @dip of @size
+ * bytes: the header, the byte that i915 leaves at 3, the checksum and the payload, as
+ * intel_write_infoframe() lays out every InfoFrame. Its length (31), or a negative error.
+ */
+static inline ssize_t intel_hdmi_gmp_dip_of_drm(const union hdmi_infoframe *frame, u8 *dip,
+						size_t size)
+{
+	ssize_t len;
+
+	if (frame->any.type != HDMI_INFOFRAME_TYPE_DRM || size < 4)
+		return -EINVAL;
+
+	len = hdmi_infoframe_pack_only(frame, dip + 1, size - 1);
+	if (len < 0)
+		return len;
+
+	memmove(&dip[0], &dip[1], 3);
+	dip[3] = 0;
+	return len + 1;
+}
+
+/*
+ * The DRM InfoFrame that the data @dip (@size bytes) of a gamut metadata DIP holds, the other way:
+ * -EINVAL where it holds another packet. @dip is changed (the byte at 3 is overwritten).
+ */
+static inline int intel_hdmi_drm_of_gmp_dip(union hdmi_infoframe *frame, u8 *dip, size_t size)
+{
+	if (size < 4 || !intel_hdmi_dip_holds_drm(dip))
+		return -EINVAL;
+
+	memmove(&dip[1], &dip[0], 3);
+	return hdmi_infoframe_unpack(frame, dip + 1, size - 1);
+}
+
+#endif /* __INTEL_HDMI_GMP_HDR_H__ */
