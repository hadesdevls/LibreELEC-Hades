From aa8193b015aa589c6ab2b82a2cc1fca6ecb0eb21 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:17:05 +0000
Subject: [PATCH] drm: the HDMI 1.4b signal in the policy of the Dolby Vision
 tunnel

drm_dvbridge.h, which i915/xe and amdgpu share, says which sinks ask for
the HDMI 1.4b signal of the Standard tunnel and builds its InfoFrames:

- struct drm_dvbridge_sink gets hdmi14b, hdmi14b_p60 and hdmi14b_qs:
  exactly one Dolby VSVDB, of version 0 and 26 bytes, of version 1 and
  15 bytes, or of version 1 and 12 bytes with the low-latency field 0,
  in an EDID valid to its end; its 2160p60 bit; QS anywhere in the EDID
  (the same full range RGB as the Standard tunnel). These are the forms
  that Amlogic's GPL HDMI transmitter sends that signal to
  (hdmitx_set_vsif_pkt(); hdmi_tx_edid.c reads version 0 of 26 bytes
  and version 1 of 12 or 15 only), read as data.
- A version 0 block stops the walk of the Dolby VSVDB rule; for these
  fields the EDID is walked once more past it, and nothing else comes
  from that walk: every field of before stays as it was.
- drm_dvbridge_sink_takes_hdmi14b() and its reason for the kernel log:
  what the walk those fields come from refused (hdmi14b_result: past a
  version 0 block, what the second walk found), or a Dolby block of
  none of the forms; drm_dvbridge_hdmi14b_vic() (the HDMI VICs of HDMI
  1.4b), the AVI InfoFrame (VIC 0 where the vendor InfoFrame has the
  HDMI VIC) and the vendor InfoFrame of the tunnel with this signal.
- The reasons of the Standard tunnel for a version 0 block, and for a
  version 1 block that is not the Standard one, said that they asked
  for the HDMI 1.4b vendor InfoFrame and that the driver did not send
  it. A block that asks for it now says so and names the property that
  sends it (DVBRIDGE_DV_HDMI14B_LAB), and one that does not ask for it
  is not said to.

Why: TVs of 2016 (the LG OLEDs among them) and some later ones have
Dolby Vision only with this signal, and today get HDR10.

Measured, on the 603 EDIDs of the host test, 400 mutations of each and
55,296 EDIDs of every form of one block: 42 EDIDs ask and 41 take (the
other has no CTA block), the same files as an independent scanner; the
rule is Kodi's (ScanDolbyVideo(), whose host test compares the two); on
all 297,099 EDIDs every field of the rule of before is the same, and so
is every reason but the two of the Standard tunnel above. Eight
mutations of the rule each make that test fail (the two checks that a
refused walk gives no verdict are each enough alone, and caught
together). KUnit: the forms, QS before and after a version 0 block, a
later bad block, two blocks, the reasons of each, the HDMI VICs, and
the bytes of the vendor and AVI InfoFrames for the ten CTA VICs of the
tunnel, through the union and back.
---
 drivers/gpu/drm/tests/drm_dvbridge_test.c | 210 +++++++++++++++++++++-
 include/drm/drm_dvbridge.h                | 182 +++++++++++++++++--
 2 files changed, 376 insertions(+), 16 deletions(-)

diff --git a/drivers/gpu/drm/tests/drm_dvbridge_test.c b/drivers/gpu/drm/tests/drm_dvbridge_test.c
index 4ca547d..1f0e375 100644
--- a/drivers/gpu/drm/tests/drm_dvbridge_test.c
+++ b/drivers/gpu/drm/tests/drm_dvbridge_test.c
@@ -5,7 +5,8 @@
  * the bytes of the Dolby vendor InfoFrame and of the AVI InfoFrame of the tunnel, the Dolby block
  * rule on EDIDs made here (an HDMI Forum EEODB among them), QS, and the CTA VIC table. The bytes of
  * an InfoFrame on the wire also depend on the driver (i915 puts the vendor DIP's hole in the
- * frame, amdgpu copies it into a DC packet): that part is not here.
+ * frame, amdgpu copies it into a DC packet): that part is not here. Also the HDMI 1.4b signal: its
+ * rule, its vendor InfoFrame and its AVI InfoFrame.
  */
 #include <kunit/test.h>
 #include <linux/hdmi.h>
@@ -217,11 +218,218 @@ static void drm_test_dvbridge_edid(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, s.result, DRM_DVBRIDGE_EDID_CHECKSUM);
 }
 
+/* The forms of the Dolby block that ask for the HDMI 1.4b signal, made for the test */
+static const u8 dvb_vsvdb_v0[26] = {0xf9, 0x01, 0x46, 0xd0, 0x00, 0x02, 0x10, 0x20, 0x30, 0x40,
+				    0x50, 0x60, 0x70, 0x80, 0x90, 0xa0, 0xb0, 0xc0, 0xd0, 0xe0, 0xf0,
+				    0x28, 0, 0, 0, 0};
+static const u8 dvb_vsvdb_v1_15[15] = {0xee, 0x01, 0x46, 0xd0, 0x00, 0x24, 0x10, 0x80, 0x00,
+				       0xa0, 0x50, 0x40, 0x90, 0x20, 0x08};
+static const u8 dvb_vsvdb_v1_12_ll0[12] = {0xeb, 0x01, 0x46, 0xd0, 0x00, 0x2a, 0x40, 0x30, 0x40,
+					   0x50, 0x60, 0x70};
+static const u8 dvb_vsvdb_v1_12_ll1[12] = {0xeb, 0x01, 0x46, 0xd0, 0x00, 0x2a, 0x40, 0x30, 0x41,
+					   0x50, 0x60, 0x70};
+
+static void dvb_read1(u8 *e, const u8 *a, size_t na, const u8 *b, size_t nb,
+		      struct drm_dvbridge_sink *s)
+{
+	dvb_edid(e, 2, 1);
+	dvb_db(e, 1, a, na);
+	if (b)
+		dvb_db(e, 1, b, nb);
+	drm_dvbridge_edid_read(e, 256, s);
+}
+
+static void drm_test_dvbridge_hdmi14b_edid(struct kunit *test)
+{
+	struct drm_dvbridge_sink s;
+	unsigned int v;
+	u8 e[384];
+
+	/* version 1, 15 bytes, with QS: the HDMI 1.4b signal, not the Standard one */
+	dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), dvb_vsvdb_v1_15, sizeof(dvb_vsvdb_v1_15), &s);
+	KUNIT_EXPECT_EQ(test, s.result, DRM_DVBRIDGE_EDID_TAKEN);
+	KUNIT_EXPECT_TRUE(test, s.hdmi14b && s.hdmi14b_qs && !s.hdmi14b_p60);
+	KUNIT_EXPECT_FALSE(test, s.standard || s.low_latency);
+	KUNIT_EXPECT_TRUE(test, drm_dvbridge_sink_takes_hdmi14b(&s));
+	KUNIT_EXPECT_FALSE(test, drm_dvbridge_sink_takes(&s, false));
+	KUNIT_EXPECT_NULL(test, drm_dvbridge_sink_takes_hdmi14b_why(&s));
+	/* the reason of the Standard tunnel names the signal and the property that sends it */
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_why(&s, false),
+			   "the version 1 Dolby Vision block is not the 12-byte one with low latency 1: it asks for the HDMI 1.4b vendor InfoFrame (DVBRIDGE_DV_HDMI14B_LAB)");
+
+	/* the same without QS: asked for, not taken */
+	dvb_read1(e, dvb_vsvdb_v1_15, sizeof(dvb_vsvdb_v1_15), NULL, 0, &s);
+	KUNIT_EXPECT_TRUE(test, s.hdmi14b && !s.hdmi14b_qs);
+	KUNIT_EXPECT_FALSE(test, drm_dvbridge_sink_takes_hdmi14b(&s));
+	KUNIT_EXPECT_NOT_NULL(test, drm_dvbridge_sink_takes_hdmi14b_why(&s));
+
+	/*
+	 * version 0 with QS after it: the fields of the Dolby VSVDB rule as before (the walk stops at
+	 * the block, QS unseen), the HDMI 1.4b signal from the whole EDID, with its 2160p60 bit
+	 */
+	dvb_read1(e, dvb_vsvdb_v0, sizeof(dvb_vsvdb_v0), dvb_vcdb_qs, sizeof(dvb_vcdb_qs), &s);
+	KUNIT_EXPECT_EQ(test, s.result, DRM_DVBRIDGE_EDID_VERSION0);
+	KUNIT_EXPECT_FALSE(test, s.standard || s.low_latency || s.qs);
+	KUNIT_EXPECT_TRUE(test, s.hdmi14b && s.hdmi14b_qs && s.hdmi14b_p60);
+	KUNIT_EXPECT_TRUE(test, drm_dvbridge_sink_takes_hdmi14b(&s));
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_why(&s, false),
+			   "the Dolby Vision block is version 0, which asks for the HDMI 1.4b vendor InfoFrame (DVBRIDGE_DV_HDMI14B_LAB) instead of the Dolby one");
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_why(&s, true),
+			   "the Dolby Vision block is version 0, which has no Low-Latency mode");
+
+	/* version 0, and a later block with a wrong checksum: no */
+	dvb_edid(e, 3, 2);
+	dvb_db(e, 1, dvb_vcdb_qs, sizeof(dvb_vcdb_qs));
+	dvb_db(e, 1, dvb_vsvdb_v0, sizeof(dvb_vsvdb_v0));
+	e[300] ^= 1;
+	drm_dvbridge_edid_read(e, 384, &s);
+	KUNIT_EXPECT_EQ(test, s.result, DRM_DVBRIDGE_EDID_VERSION0);
+	KUNIT_EXPECT_FALSE(test, s.hdmi14b || drm_dvbridge_sink_takes_hdmi14b(&s));
+	/* the reason is that of the walk past the block, and the Standard one does not name the signal */
+	KUNIT_EXPECT_EQ(test, s.hdmi14b_result, DRM_DVBRIDGE_EDID_CHECKSUM);
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_takes_hdmi14b_why(&s), "an EDID block has a wrong checksum");
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_why(&s, false),
+			   "the Dolby Vision block is version 0, which the Standard tunnel does not take");
+
+	/* version 0 of 25 bytes: no (Amlogic reads 26 only) */
+	dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), dvb_vsvdb_v0, sizeof(dvb_vsvdb_v0), &s);
+	KUNIT_EXPECT_TRUE(test, s.hdmi14b);
+	{
+		u8 short_v0[25];
+
+		memcpy(short_v0, dvb_vsvdb_v0, sizeof(short_v0));
+		short_v0[0] = 0xf8;
+		dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), short_v0, sizeof(short_v0), &s);
+		KUNIT_EXPECT_FALSE(test, s.hdmi14b);
+		KUNIT_EXPECT_EQ(test, s.hdmi14b_result, DRM_DVBRIDGE_EDID_TAKEN);
+		KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_takes_hdmi14b_why(&s),
+				   "the Dolby Vision block does not ask for the HDMI 1.4b vendor InfoFrame (it is not of version 0 and 26 bytes, version 1 and 15 bytes, or version 1 and 12 bytes with low latency 0)");
+	}
+
+	/* version 0 and a second Dolby block: no */
+	dvb_read1(e, dvb_vsvdb_v0, sizeof(dvb_vsvdb_v0), dvb_vsvdb_v1_15, sizeof(dvb_vsvdb_v1_15), &s);
+	KUNIT_EXPECT_FALSE(test, s.hdmi14b);
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_takes_hdmi14b_why(&s), "the EDID has several Dolby Vision blocks");
+	dvb_read1(e, dvb_vsvdb_v1_15, sizeof(dvb_vsvdb_v1_15), dvb_vsvdb_v1_15, sizeof(dvb_vsvdb_v1_15), &s);
+	KUNIT_EXPECT_EQ(test, s.result, DRM_DVBRIDGE_EDID_SEVERAL);
+	KUNIT_EXPECT_FALSE(test, s.hdmi14b);
+	KUNIT_EXPECT_EQ(test, s.hdmi14b_result, DRM_DVBRIDGE_EDID_SEVERAL);
+	KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_takes_hdmi14b_why(&s), "the EDID has several Dolby Vision blocks");
+	/* no reason of the walk for one that took the block, or that stopped at a version 0 one */
+	KUNIT_EXPECT_NULL(test, __drm_dvbridge_edid_result_why(DRM_DVBRIDGE_EDID_TAKEN));
+	KUNIT_EXPECT_NULL(test, __drm_dvbridge_edid_result_why(DRM_DVBRIDGE_EDID_VERSION0));
+
+	/* version 1, 12 bytes: low latency 0 asks for it, 1 is the Standard one */
+	dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), dvb_vsvdb_v1_12_ll0, sizeof(dvb_vsvdb_v1_12_ll0), &s);
+	KUNIT_EXPECT_TRUE(test, s.hdmi14b && !s.standard);
+	dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), dvb_vsvdb_v1_12_ll1, sizeof(dvb_vsvdb_v1_12_ll1), &s);
+	KUNIT_EXPECT_TRUE(test, !s.hdmi14b && s.standard);
+	KUNIT_EXPECT_NOT_NULL(test, drm_dvbridge_sink_takes_hdmi14b_why(&s));
+	/* low latency 2: neither the Standard block nor one that asks for the signal, and its reason says neither */
+	{
+		u8 ll2[12];
+
+		memcpy(ll2, dvb_vsvdb_v1_12_ll1, sizeof(ll2));
+		ll2[8] = 0x42;
+		dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), ll2, sizeof(ll2), &s);
+		KUNIT_EXPECT_TRUE(test, !s.hdmi14b && !s.standard);
+		KUNIT_EXPECT_STREQ(test, drm_dvbridge_sink_why(&s, false),
+				   "the version 1 Dolby Vision block is not the 12-byte one with low latency 1");
+	}
+
+	/* version 2: no */
+	dvb_read1(e, dvb_vcdb_qs, sizeof(dvb_vcdb_qs), dvb_vsvdb_v2, sizeof(dvb_vsvdb_v2), &s);
+	KUNIT_EXPECT_FALSE(test, s.hdmi14b);
+
+	/* the HDMI VICs of HDMI 1.4b, and none else */
+	for (v = 0; v < 256; v++)
+		KUNIT_EXPECT_EQ_MSG(test, drm_dvbridge_hdmi14b_vic(v),
+				    v == 95 ? 1 : v == 94 ? 2 : v == 93 ? 3 : v == 98 ? 4 : 0, "VIC %u", v);
+}
+
+static void drm_test_dvbridge_hdmi14b_frames(struct kunit *test)
+{
+	static const u8 tunnel_vics[] = {16, 31, 32, 33, 34, 93, 94, 95, 96, 97};
+	struct hdmi_dolby_hdmi14b_infoframe dv;
+	struct hdmi_vendor_infoframe hdmi;
+	struct hdmi_avi_infoframe avi;
+	union hdmi_infoframe u, back;
+	u8 buf[HDMI_INFOFRAME_SIZE(MAX)], via[HDMI_INFOFRAME_SIZE(MAX)];
+	unsigned int i, j, sum;
+	ssize_t len;
+
+	for (i = 0; i < ARRAY_SIZE(tunnel_vics); i++) {
+		const u8 vic = tunnel_vics[i];
+		const u8 hvic = drm_dvbridge_hdmi14b_vic(vic);
+
+		drm_dvbridge_tunnel_hdmi14b_vsif(&dv, vic);
+		len = hdmi_dolby_hdmi14b_infoframe_pack(&dv, buf, sizeof(buf));
+		KUNIT_ASSERT_EQ(test, len, 28);
+		KUNIT_EXPECT_EQ(test, buf[0], 0x81);
+		KUNIT_EXPECT_EQ(test, buf[1], 0x01);
+		KUNIT_EXPECT_EQ(test, buf[2], 24);
+		KUNIT_EXPECT_EQ(test, buf[4], 0x03);
+		KUNIT_EXPECT_EQ(test, buf[5], 0x0c);
+		KUNIT_EXPECT_EQ(test, buf[6], 0x00);
+		KUNIT_EXPECT_EQ_MSG(test, buf[7], hvic ? 0x20 : 0x00, "VIC %u", vic);
+		KUNIT_EXPECT_EQ_MSG(test, buf[8], hvic, "VIC %u", vic);
+		for (sum = 0, j = 0; j < len; j++)
+			sum += buf[j];
+		KUNIT_EXPECT_EQ(test, sum % 256, 0);
+		for (j = 9; j < sizeof(buf); j++)
+			KUNIT_EXPECT_EQ_MSG(test, buf[j], 0, "VIC %u byte %u", vic, j);
+
+		/* the same bytes through the union, and back */
+		memset(&u, 0, sizeof(u));
+		u.vendor.dolby_hdmi14b = dv;
+		KUNIT_ASSERT_EQ(test, hdmi_infoframe_pack(&u, via, sizeof(via)), 28);
+		KUNIT_EXPECT_EQ(test, memcmp(via, buf, sizeof(buf)), 0);
+		memset(&back, 0x5a, sizeof(back));
+		KUNIT_ASSERT_EQ(test, hdmi_infoframe_unpack(&back, buf, len), 0);
+		KUNIT_EXPECT_EQ(test, back.vendor.any.oui, HDMI_IEEE_OUI);
+		KUNIT_EXPECT_EQ(test, back.vendor.any.length, HDMI_DOLBY_HDMI14B_INFOFRAME_SIZE);
+		KUNIT_EXPECT_EQ(test, back.vendor.dolby_hdmi14b.hdmi_vic, hvic);
+		KUNIT_EXPECT_EQ(test, memcmp(&back.vendor.dolby_hdmi14b, &dv, sizeof(dv)), 0);
+
+		/* its AVI InfoFrame: the tunnel's, with VIC 0 where the vendor one has the HDMI VIC */
+		hdmi_avi_infoframe_init(&avi);
+		drm_dvbridge_tunnel_avi(&avi, vic);
+		drm_dvbridge_hdmi14b_avi(&avi, vic);
+		len = hdmi_avi_infoframe_pack(&avi, buf, sizeof(buf));
+		KUNIT_ASSERT_GT(test, len, 7);
+		KUNIT_EXPECT_EQ(test, (buf[4] >> 5) & 3, HDMI_COLORSPACE_RGB);
+		KUNIT_EXPECT_EQ(test, (buf[6] >> 2) & 3, HDMI_QUANTIZATION_RANGE_FULL);
+		KUNIT_EXPECT_EQ_MSG(test, buf[7], hvic ? 0 : vic, "VIC %u", vic);
+	}
+
+	/* what is not the frame: an HDMI VIC past 4; one byte more than it in the payload */
+	drm_dvbridge_tunnel_hdmi14b_vsif(&dv, 93);
+	dv.hdmi_vic = 5;
+	KUNIT_EXPECT_LT(test, hdmi_dolby_hdmi14b_infoframe_pack(&dv, buf, sizeof(buf)), 0);
+	drm_dvbridge_tunnel_hdmi14b_vsif(&dv, 93);
+	KUNIT_ASSERT_EQ(test, hdmi_dolby_hdmi14b_infoframe_pack(&dv, buf, sizeof(buf)), 28);
+	buf[20] = 1;
+	buf[3] -= 1;
+	KUNIT_EXPECT_LT(test, hdmi_infoframe_unpack(&back, buf, 28), 0);
+
+	/* the HDMI vendor InfoFrame of the same mode stays what it was: 5 bytes, the HDMI one */
+	hdmi_vendor_infoframe_init(&hdmi);
+	hdmi.vic = 3;
+	len = hdmi_vendor_infoframe_pack(&hdmi, buf, sizeof(buf));
+	KUNIT_ASSERT_EQ(test, len, 9);
+	KUNIT_EXPECT_EQ(test, buf[2], 5);
+	KUNIT_ASSERT_EQ(test, hdmi_infoframe_unpack(&back, buf, len), 0);
+	KUNIT_EXPECT_EQ(test, back.vendor.any.length, 5);
+	KUNIT_EXPECT_EQ(test, back.vendor.hdmi.vic, 3);
+}
+
 static struct kunit_case drm_dvbridge_tests[] = {
 	KUNIT_CASE(drm_test_dvbridge_vsif),
 	KUNIT_CASE(drm_test_dvbridge_avi),
 	KUNIT_CASE(drm_test_dvbridge_vic),
 	KUNIT_CASE(drm_test_dvbridge_edid),
+	KUNIT_CASE(drm_test_dvbridge_hdmi14b_edid),
+	KUNIT_CASE(drm_test_dvbridge_hdmi14b_frames),
 	{}
 };
 
diff --git a/include/drm/drm_dvbridge.h b/include/drm/drm_dvbridge.h
index d1c16ab..874cbde 100644
--- a/include/drm/drm_dvbridge.h
+++ b/include/drm/drm_dvbridge.h
@@ -10,7 +10,17 @@
  *   in its 12-byte form with the low-latency field 1, of any display management version (user space
  *   sends a display of 2 or 3 the content mapping v2.9 part of the metadata, the part it reads). The
  *   field 0, the 15-byte version 1 form and version 0 mean the HDMI 1.4b vendor InfoFrame, which the
- *   tunnel does not send.
+ *   tunnel does not send unless asked to (below).
+ * - Hades: the HDMI 1.4b signal of the Standard tunnel (DVBRIDGE_DV_HDMI14B_LAB with
+ *   DVBRIDGE_DV_STANDARD_LAB), for a display that asks for it as the GPL HDMI transmitter of Amlogic
+ *   reads its block (hdmitx_set_vsif_pkt(): "ver0 and ver1_15 and ver1_12bit with ll= 0 use hdmi
+ *   1.4b VSIF"; hdmi_tx_edid.c takes version 0 of 26 bytes and version 1 of 12 or 15): exactly one
+ *   Dolby VSVDB, of version 0 and 26 bytes, of version 1 and 15 bytes, or of version 1 and 12 bytes
+ *   with the low-latency field 0, in an EDID valid to its end; 2160p50 and 2160p60 with its 2160p60
+ *   bit; and QS anywhere in the EDID, for the same full range RGB. Its vendor InfoFrame is the HDMI
+ *   one of 24 payload bytes (struct hdmi_dolby_hdmi14b_infoframe), with the HDMI VIC of 2160p24, 25
+ *   and 30, whose AVI InfoFrame then carries VIC 0. 42 of the 603 EDIDs of the host test ask for it,
+ *   41 of them with QS (the other has no CTA block).
  * - Low-Latency in YCbCr 4:2:2 at 12 bits (drm_dvbridge_ll.h): version 2 with any interface, or the
  *   12-byte version 1 block with the low-latency field 1. No display management version is needed.
  * - 2160p50 and 2160p60: always with version 2; with version 1, its 2160p60 bit.
@@ -65,10 +75,26 @@ struct drm_dvbridge_sink {
 	bool low_latency;
 	bool p60;
 	bool qs;
+	/*
+	 * Hades: the HDMI 1.4b signal (drm_dvbridge_sink_takes_hdmi14b()): hdmi14b, the Dolby block is
+	 * one of its forms and the only one of an EDID valid to its end (walked past a version 0
+	 * block too, where the walk of the fields above stops); hdmi14b_p60, its 2160p60 bit;
+	 * hdmi14b_qs, QS anywhere in that EDID. They mean something only with hdmi14b.
+	 * hdmi14b_result: what the walk they come from found (result, or, past a version 0 block,
+	 * what the second walk found), for drm_dvbridge_sink_takes_hdmi14b_why().
+	 */
+	bool hdmi14b;
+	bool hdmi14b_p60;
+	bool hdmi14b_qs;
+	enum drm_dvbridge_edid_result hdmi14b_result;
 };
 
-static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
-					  struct drm_dvbridge_sink *sink)
+/*
+ * The walk of drm_dvbridge_edid_read(). past_version0: (Hades) a version 0 Dolby block does not stop
+ * it, for the HDMI 1.4b signal, which a version 0 block may ask for.
+ */
+static inline void __drm_dvbridge_edid_walk(const u8 *edid, size_t size,
+					    struct drm_dvbridge_sink *sink, bool past_version0)
 {
 	static const u8 magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
 	unsigned int block, i, found = 0;
@@ -79,6 +105,10 @@ static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
 	sink->low_latency = false;
 	sink->p60 = false;
 	sink->qs = false;
+	sink->hdmi14b = false;
+	sink->hdmi14b_p60 = false;
+	sink->hdmi14b_qs = false;
+	sink->hdmi14b_result = DRM_DVBRIDGE_EDID_NONE;
 	if (!edid || !size)
 		return;
 	sink->result = DRM_DVBRIDGE_EDID_SIZE;
@@ -141,8 +171,16 @@ static inline void drm_dvbridge_edid_read(const u8 *edid, size_t size,
 					sink->standard = len == 11 && (data[7] & 3) == 1;
 					sink->low_latency = sink->standard;
 					sink->p60 = data[4] & 2;
+					/* Hades: the forms that ask for the HDMI 1.4b signal */
+					sink->hdmi14b = len == 14 || (len == 11 && !(data[7] & 3));
 					break;
 				case 0:
+					/* Hades: (for the HDMI 1.4b signal, the walk goes on) */
