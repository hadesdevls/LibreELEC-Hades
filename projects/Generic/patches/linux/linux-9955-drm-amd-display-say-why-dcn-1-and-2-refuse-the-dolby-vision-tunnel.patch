From dcd13a562cc761994fd1a5b684ae0f88b9193b26 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:01:34 +0000
Subject: [PATCH] drm/amd/display: say why DCN 1 and 2 refuse the Dolby Vision
 tunnel

linux-9940 offers the tunnel on DCN 1.0, 1.0.1, 2.0 and 2.1 with two
refusals of its own: in the scanout check, a plane whose legacy gamma
is not the identity (DCN 1 writes it to its input gamma LUT), and at
commit setup, a tunnelled stream whose output transfer function is not
bypass (the regamma, with the sRGB ROM of DCN 1, would change the
bytes). The first one already came out as "scanout" (the scanout check
refused and none of the tests of linux-9953 named anything), without
saying what was found. The second one left DVBRIDGE_REFUSED as the
connector check had cleared it, with no reason, and only a one-time
warning in the kernel log.

Both are now named, with the bit that says what they are: "scanout",
the scanout is not byte exact because of colour processing, which
covers a gamma LUT in the path of the plane and an output transfer
function that is not bypass alike. No new bit: user space reads them as
it reads the other scanout refusals, and the kernel log says what was
found (the plane's gamma, or the type and curve of the transfer
function).

The commit setup runs after the atomic check, and only for a commit
that is not TEST_ONLY. It holds the connection mutex of the connectors
in the state of the commit, and the reason goes to the HDMI connectors
of the CRTC among them. A commit that does not have the connector in
its state leaves the property as the last check of that connector
found it; the warning of linux-9940 is still in the kernel log.

This patch needs linux-9940 and linux-9953, and does not change
linux-9940.
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  2 +
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  2 +
 .../amdgpu_dm/amdgpu_dm_dvbridge_refused.c    | 57 +++++++++++++++++++
 3 files changed, 61 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index f159f2b..572ec65 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -12287,6 +12287,8 @@ static int amdgpu_dm_atomic_setup_commit(struct drm_atomic_commit *state)
 			drm_warn_once(state->dev,
 				      "[CRTC:%d:%s] Dolby Vision tunnel refused: output gamma not in bypass\n",
 				      crtc->base.id, crtc->name);
+			/* Hades: why (DVBRIDGE_REFUSED and the kernel log) */
+			amdgpu_dm_dvbridge_refused_out_tf(state, crtc, dm_new_crtc_state->stream);
 			return -EINVAL;
 		}
 	}
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 9956a38..8f4105c 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -1101,6 +1101,8 @@ void amdgpu_dm_dvbridge_refused_stream(struct drm_connector *connector,
 				       const struct dc_stream_state *stream);
 void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct drm_crtc *crtc,
 					const struct drm_crtc_state *crtc_state);
+void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+				       const struct dc_stream_state *stream);
 int amdgpu_dm_hdr10_guard_check(struct drm_atomic_commit *state);
 
 #define to_dm_connector_state(x)\
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
index 71b77ae..f0db1e8 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_dvbridge_refused.c
@@ -363,6 +363,18 @@ static u64 dvbridge_why_scanout(struct drm_atomic_commit *state, struct drm_crtc
 				 plane_state->crtc_w, plane_state->crtc_h, plane_state->crtc_x,
 				 plane_state->crtc_y, plane_state->rotation, plane_state->alpha);
 	}
+	/* DCN 1 writes its input gamma LUT from the legacy gamma of the plane, unless identity */
+	if (plane_state && stream->ctx->dce_version <= DCN_VERSION_1_01) {
+		const struct dm_plane_state *dm_plane_state = to_dm_plane_state(plane_state);
+		const struct dc_plane_state *dc_plane = dm_plane_state->dc_state;
+
+		if (dc_plane && !dc_plane->gamma_correction.is_identity) {
+			bits |= REFUSED(SCANOUT);
+			len += scnprintf(buf + len, size - len,
+					 "%sthe plane has a legacy gamma that is not the identity (input gamma LUT of DCN 1)",
+					 len ? "; " : "");
+		}
+	}
 	/* (the colour pipeline of the plane, as user space and DC have it, is "scanout" too) */
 	return bits ? bits : REFUSED(SCANOUT);
 }
@@ -389,6 +401,51 @@ void amdgpu_dm_dvbridge_refused_scanout(struct drm_atomic_commit *state, struct
 	}
 }
 
+static const char *dvbridge_tf_type_name(enum dc_transfer_func_type type)
+{
+	switch (type) {
+	case TF_TYPE_PREDEFINED:
+		return "predefined";
+	case TF_TYPE_DISTRIBUTED_POINTS:
+		return "distributed points";
+	case TF_TYPE_BYPASS:
+		return "bypass";
+	case TF_TYPE_HWPWL:
+		return "hardware PWL";
+	default:
+		return "unknown";
+	}
+}
+
+/*
+ * Before DCN 3, amdgpu_dm_atomic_setup_commit() refuses a commit that would leave a tunnelled
+ * stream with an output transfer function other than bypass: the regamma (with the sRGB ROM of
+ * DCN 1) would change the bytes, which is "scanout". That runs after the atomic check, and only
+ * for a commit that is not TEST_ONLY. The reason goes to the HDMI connectors of the CRTC that are
+ * in the state of the commit, whose connection mutex it holds; a connector outside it keeps what
+ * its last check found, and the kernel log has the warning of the refusal.
+ */
+void amdgpu_dm_dvbridge_refused_out_tf(struct drm_atomic_commit *state, struct drm_crtc *crtc,
+				       const struct dc_stream_state *stream)
+{
+	struct drm_connector_state *con_state;
+	struct drm_connector *connector;
+	char detail[256];
+	int i;
+
+	scnprintf(detail, sizeof(detail),
+		  "at commit setup, the output transfer function of the stream is %s (curve %d), not bypass: before DCN 3 the regamma would change the bytes",
+		  dvbridge_tf_type_name(stream->out_transfer_func.type),
+		  stream->out_transfer_func.tf);
+	for_each_new_connector_in_state(state, connector, con_state, i) {
+		if (con_state->crtc != crtc ||
+		    connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			continue;
+		amdgpu_dm_dvbridge_refused(to_amdgpu_dm_connector(connector), REFUSED(SCANOUT),
+					   detail);
+	}
+}
+
 /*
  * The HDR10 depth guard: an active stream whose connector is under the guard with HDR10 metadata
  * carries 10 bits per component or more, or the commit is refused. Run once the streams of the
