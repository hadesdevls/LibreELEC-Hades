From 624f9d953de0a3c589786d03005262cec44475a9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 16:20:32 +0000
Subject: [PATCH] dvbridge: log when native Dolby Vision output starts and ends

Only failures were logged, so a log could not tell whether the Dolby Vision
transport ever reached the display. Log once when the first Dolby Vision
frame is accepted by the kernel with the transport state, and once when the
ordinary output has been restored.
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 10 ++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  2 ++
 2 files changed, 12 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 757dac2..622c918 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -164,6 +164,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       if (m_eglContext.TrySwapBuffers())
       {
         presented = FlipDVBridgePage(m_dvState, false);
+        if (presented && !m_dvSignalling)
+        {
+          m_dvSignalling = true;
+          CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output started");
+        }
       }
     }
     if (m_dvBridge)
@@ -583,6 +588,11 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
       return false;
     }
   }
+  if (m_dvSignalling)
+  {
+    m_dvSignalling = false;
+    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output ended, normal output restored");
+  }
   if (m_dvBridge)
     m_dvBridge->Reset();
   SetGuiCompositing(0);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 2060039..e648f4a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -88,6 +88,8 @@ private:
   CDVBridgeState m_dvState;
   bool m_dvFrame = false;
   bool m_dvOverlays = true;
+  //! A Dolby Vision frame has reached the display since the output was last restored
+  bool m_dvSignalling = false;
 #endif
 };
 
