From 1bd06cf0c47e10e8a961f4d38fa96ebb60e20302 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:26:18 +0000
Subject: [PATCH] system/hades: the player information of every skin, made
 again from Estuary's pages

tools/hades-playerinfo/make-playerinfo.py run on this tree, so that HadesIncludes.xml and
DialogHadesPlayerInfo.xml are what it writes (make-playerinfo.py --check: up to date). It adds:

- the row of the HDMI 1.4b signalling of the Dolby Vision page ("Signalling: HDMI 1.4b vendor
  InfoFrame", #31928 and #31929, shown with hades.dv.vsif "hdmi14b"), and the reason
  "hdmi14bdriver" (#31932), of the commits before this one;
- the reason "hlgbase" (#31875), which Estuary's Variables.xml has had since "dvbridge,
  VideoPlayer, windowing/gbm: a base layer in HLG (profile 8.4) composed as one in PQ where its RPU
  declares that, else played as HLG" and these files did not: the generator had not been run after
  it (before the commits of the HDMI 1.4b signalling, HadesIncludes.xml was stale by that line
  alone).

Nothing else changes.
---
 system/hades/DialogHadesPlayerInfo.xml | 15 +++++++++++++++
 system/hades/HadesIncludes.xml         |  2 ++
 2 files changed, 17 insertions(+)

diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index 3823e1c..c42059a 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -3169,6 +3169,21 @@
 					<scroll>false</scroll>
 					<scrollspeed>40</scrollspeed>
 				</control>
+				<control type="label">
+					<width>885</width>
+					<height>44</height>
+					<aligny>bottom</aligny>
+					<label>[COLOR FF12A0C7]$ADDON[skin.estuary 31928]:[/COLOR] $ADDON[skin.estuary 31929]</label>
+					<font>font14</font>
+					<shadowcolor>FF000000</shadowcolor>
+					<visible>String.IsEqual(Window(Home).Property(hades.dv.vsif),hdmi14b)</visible>
+					<align>left</align>
+					<textcolor>FFF0F0F0</textcolor>
+					<disabledcolor>40FFFFFF</disabledcolor>
+					<selectedcolor>FFFFB70F</selectedcolor>
+					<scroll>false</scroll>
+					<scrollspeed>40</scrollspeed>
+				</control>
 				<control type="label">
 					<width>885</width>
 					<height>44</height>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index e6e230d..de3eb49 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -105,6 +105,7 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),display)">$ADDON[skin.estuary 31655]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),lloff)">$ADDON[skin.estuary 31926]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),lldriver)">$ADDON[skin.estuary 31927]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),hdmi14bdriver)">$ADDON[skin.estuary 31932]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),legacy)">$ADDON[skin.estuary 31684]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),invalid)">$ADDON[skin.estuary 31687]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),output)">$ADDON[skin.estuary 31656]</value>
@@ -114,6 +115,7 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),rate)">$ADDON[skin.estuary 31685]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),view)">$ADDON[skin.estuary 31710]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sdrbase)">$ADDON[skin.estuary 31874]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),hlgbase)">$ADDON[skin.estuary 31875]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converter)">$ADDON[skin.estuary 31890]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sink)">$ADDON[skin.estuary 31891]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),frl)">$ADDON[skin.estuary 31892]</value>
-- 
