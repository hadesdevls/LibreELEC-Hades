From 0d954f7f6a4cea943265d40d65a48ce6f9f62dc7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 17:25:38 +0000
Subject: [PATCH] windowing/gbm: composite a subtitle over HDR under the
 rectangle that bounds it

The tile mask of the GUI texture puts the composite of the GUI over HDR10
and HLG under scissor rectangles of its marked tiles where they make 24 at
most (dvbridge_tiles_merge()); with more, the whole quad is drawn. A
subtitle at 3840x2160 often makes more: its words are a tile or more apart,
its letters fill the rows of tiles unevenly, and runs of tiles are only
joined where they have the same columns.

Where the merge gives up and the marked tiles are not more than half of
them, the HDR10/HLG composite is now drawn under the one rectangle that
bounds them (dvbridge_tiles_bounds()): the same bytes, since the fragments
of its unmarked tiles discard as they do in the whole quad, over the band
of the subtitle. The composite of the Dolby Vision frames keeps the whole
quad, as before.

Tests (outside the tree): pgs_tiles_bounds_test (the real header; does not
build on the tree before); text_frame at 3840x2160 on llvmpipe and zink, a
still line composited under the bounds with the same bytes; the scissor_box_test of the composite.
---
 tools/dvbridge/dvbridge_tiles.h               | 34 +++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 12 +++++--
 2 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_tiles.h b/tools/dvbridge/dvbridge_tiles.h
index 86b521b..28d4ac3 100644
--- a/tools/dvbridge/dvbridge_tiles.h
+++ b/tools/dvbridge/dvbridge_tiles.h
@@ -131,4 +131,38 @@ static inline bool dvbridge_tiles_scissor(const struct dvbridge_tile_rect *r, un
     out[3] = (int)(y1 - y0);
     return true;
 }
+/* Hades (pgs): the one rectangle that bounds the marked tiles of mask (cols x rows), for the
+ * composite of the GUI over HDR10 and HLG (CWinSystemGbmGLESContext::CompositeGui()): where
+ * dvbridge_tiles_merge() gives more rectangles than the composite takes (the words of the lines of a
+ * subtitle, a tile or more apart, in rows of tiles that its letters fill unevenly), the rectangle
+ * around them all draws the same bytes as the whole quad (the fragments of its unmarked tiles
+ * discard, as they do in the whole quad), over the band of the subtitle instead of the whole raster.
+ * Returns 1 (out set), 0 (no tile is marked), or -1 where the marked tiles are more than percent of
+ * all of them (not worth it). */
+static inline int dvbridge_tiles_bounds(const uint8_t *mask, unsigned cols, unsigned rows,
+                                        struct dvbridge_tile_rect *out, unsigned percent)
+{
+    if (!mask || !out || !cols || !rows)
+        return -1;
+    unsigned marked = 0, x0 = cols, y0 = rows, x1 = 0, y1 = 0;
+    for (unsigned y = 0; y < rows; ++y)
+        for (unsigned x = 0; x < cols; ++x) {
+            if (!mask[y * cols + x])
+                continue;
+            ++marked;
+            if (x < x0)
+                x0 = x;
+            if (x + 1 > x1)
+                x1 = x + 1;
+            if (y < y0)
+                y0 = y;
+            y1 = y + 1;
+        }
+    if (!marked)
+        return 0;
+    if ((unsigned long)marked * 100ul > (unsigned long)cols * rows * percent)
+        return -1;
+    out->x = x0, out->y = y0, out->w = x1 - x0, out->h = y1 - y0;
+    return 1;
+}
 #endif
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 9de5696..ec58558 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -6731,9 +6731,15 @@ void CWinSystemGbmGLESContext::HdrTilesUpdate(bool dolbyVision)
                            m_hdrTiles.begin() + static_cast<size_t>(rows - 1 - y) * columns);
       }
       m_tilesRects.assign(DVBRIDGE_TILE_RECTS_MAX, dvbridge_tile_rect{});
-      const int n = usable ? dvbridge_tiles_merge(m_hdrTiles.data(), columns, rows,
-                                                  m_tilesRects.data(), DVBRIDGE_TILE_RECTS_MAX, 50)
-                           : -1;
+      int n = usable ? dvbridge_tiles_merge(m_hdrTiles.data(), columns, rows, m_tilesRects.data(),
+                                            DVBRIDGE_TILE_RECTS_MAX, 50)
+                     : -1;
+      // Hades: more rectangles than the composite takes, over HDR10 or HLG (a subtitle: its words, a
+      // tile or more apart, in rows of tiles that its letters fill unevenly): the one rectangle that
+      // bounds the marked tiles, the same bytes as the whole quad over the band of the subtitle
+      // (dvbridge_tiles_bounds()). The composite of the Dolby Vision frames keeps the whole quad.
+      if (n < 0 && usable && !m_hdrMaskDv)
+        n = dvbridge_tiles_bounds(m_hdrTiles.data(), columns, rows, m_tilesRects.data(), 50);
       m_tilesRects.resize(n > 0 ? static_cast<size_t>(n) : 0);
       m_tilesUse = n > 0;
       m_tilesGen = serial;
-- 
