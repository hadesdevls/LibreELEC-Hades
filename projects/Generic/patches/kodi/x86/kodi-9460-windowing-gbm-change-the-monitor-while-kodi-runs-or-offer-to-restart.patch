     CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+    // Hades: a window system that changes the monitor by itself (GBM) says what it did. Kodi is
+    // shown on it only where it was moved there: the question to keep it follows then. A change
+    // that is not kept, or that the window system refused, comes back here with the monitor of
+    // before (the setting is put back), which the window system goes back to without a question.
+    const bool reverting = m_resolutionChangeAborted;
+    switch (winSystem->ChangeScreen(
+        std::static_pointer_cast<const CSettingString>(setting)->GetValue(), reverting))
+    {
+      case CWinSystemBase::ScreenChange::DONE:
+        m_resolutionChangeAborted = false;
+        return true;
+      case CWinSystemBase::ScreenChange::REFUSED:
+        m_resolutionChangeAborted = true;
+        return false;
+      case CWinSystemBase::ScreenChange::MOVED:
+        if (reverting)
+        {
+          m_resolutionChangeAborted = false;
+          return true;
+        }
+        if (HELPERS::ShowYesNoDialogText(CVariant{13110}, CVariant{13111}, CVariant{""},
+                                         CVariant{""}, 10000) != DialogResponse::CHOICE_YES)
+        {
+          m_resolutionChangeAborted = true;
+          return false;
+        }
+        return true;
+      case CWinSystemBase::ScreenChange::AS_ALWAYS:
+        break;
+    }
+
