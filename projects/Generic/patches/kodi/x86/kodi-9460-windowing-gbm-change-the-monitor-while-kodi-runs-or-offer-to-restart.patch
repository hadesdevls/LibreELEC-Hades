+namespace
+{
+// Hades: whether the outputs of the device in use are asked of the kernel as they are now (a
+// display connected since Kodi started is offered too, and Kodi can move to it): from the thread
+// that draws, and not while a video plays (the kernel may be busy with a display, and the thread
+// would wait for it)
+bool OutputsNow()
+{
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  return messenger && messenger->IsProcessThread() && !(player && player->IsPlayingVideo());
+}
+} // namespace
+
