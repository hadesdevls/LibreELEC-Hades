+bool CDRMAtomic::TestOutputMove(const OutputMove& move, struct gbm_bo* bo, std::string& why)
+{
+  struct drm_fb* fb = bo ? DrmFbGetFromBo(bo) : nullptr;
+  if (!fb || !move.connector || !move.crtc || !move.plane || !m_connector)
+  {
+    why = "there is no framebuffer, output, CRTC or plane to ask with";
+    return false;
+  }
+  CDRMPropertyBlob mode(m_fd, &move.mode, sizeof(move.mode));
+  if (!mode.IsValid())
+  {
+    why = "its mode could not be given to the driver";
+    return false;
+  }
+
+  // What the commit of the move carries (DrmAtomicCommit()), in its order: a property named twice
+  // goes with the value it was added with last
+  CDRMAtomicRequest request;
+  bool made = true;
+  const auto add = [&request, &made](CDRMObject* object, const char* name, uint64_t value)
+  { made = made && request.AddProperty(object, name, value); };
+  // every other CRTC that is on goes off, with its planes and its outputs (DisableOtherOutputs())
+  for (const auto& crtc : GetCrtcs())
+  {
+    if (crtc.get() == move.crtc || crtc->GetPropertyValue("ACTIVE").value_or(0) == 0)
+      continue;
+    for (const auto& plane : m_planes)
+    {
+      if (plane->GetPropertyValue("CRTC_ID").value_or(0) == crtc->GetId())
+      {
+        add(plane.get(), "CRTC_ID", 0);
+        add(plane.get(), "FB_ID", 0);
+      }
+    }
+    for (const auto& connector : GetConnectors())
+    {
+      if (connector.get() != move.connector &&
+          connector->GetPropertyValue("CRTC_ID").value_or(0) == crtc->GetId())
+        add(connector.get(), "CRTC_ID", 0);
+    }
+    add(crtc.get(), "ACTIVE", 0);
+    add(crtc.get(), "MODE_ID", 0);
+  }
+  // the output in use leaves its CRTC, and the planes of the CRTC of the move but its own go off
+  add(m_connector, "CRTC_ID", 0);
+  for (const auto& plane : m_planes)
+  {
+    if (plane.get() != move.plane &&
+        plane->GetPropertyValue("CRTC_ID").value_or(0) == move.crtc->GetId())
+    {
+      add(plane.get(), "CRTC_ID", 0);
+      add(plane.get(), "FB_ID", 0);
+    }
+  }
+  // the output it moves to, in the mode of its display, and the buffer on its plane
+  add(move.connector, "CRTC_ID", move.crtc->GetCrtcId());
+  add(move.crtc, "MODE_ID", mode.Get());
+  add(move.crtc, "ACTIVE", 1);
+  add(move.plane, "FB_ID", fb->fb_id);
+  add(move.plane, "CRTC_ID", move.crtc->GetCrtcId());
+  add(move.plane, "SRC_X", 0);
+  add(move.plane, "SRC_Y", 0);
+  add(move.plane, "SRC_W", static_cast<uint64_t>(move.width) << 16);
+  add(move.plane, "SRC_H", static_cast<uint64_t>(move.height) << 16);
+  add(move.plane, "CRTC_X", 0);
+  add(move.plane, "CRTC_Y", 0);
+  add(move.plane, "CRTC_W", move.mode.hdisplay);
+  add(move.plane, "CRTC_H", move.mode.vdisplay);
+  if (!made)
+  {
+    why = "the request could not be made";
+    return false;
+  }
+
+  if (drmModeAtomicCommit(m_fd, request.Get(),
+                          DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr) != 0)
+  {
+    why = std::string("the driver would not take it: ") + strerror(errno);
+    return false;
+  }
+  return true;
+}
