+bool CDRMUtils::PlanOutputMove(CDRMConnector* connector, OutputMove& move, std::string& why)
+{
+  move = {};
+  if (!connector || connector == m_connector || !m_crtc || !m_gui_plane)
+  {
+    why = "it is the one in use, or Kodi shows itself on none";
+    return false;
+  }
+  if (!connector->Refresh())
+  {
+    why = "it cannot be read";
+    return false;
+  }
+  if (!connector->IsConnected())
+  {
+    why = "nothing is connected to it now";
+    return false;
+  }
+
+  // The mode its display prefers, of its modes without a 3D layout, or else the largest
+  // (FindPreferredMode(), which is what a start takes where the console left none)
+  int index = -1;
+  for (int i = 0, area = 0; i < connector->GetModesCount(); i++)
+  {
+    const drmModeModeInfo* mode = connector->GetModeForIndex(i);
+    if (mode->flags & DRM_MODE_FLAG_3D_MASK)
+      continue;
+    if (mode->type & DRM_MODE_TYPE_PREFERRED)
+    {
+      index = i;
+      break;
+    }
+    if (mode->hdisplay * mode->vdisplay > area)
+    {
+      index = i;
+      area = mode->hdisplay * mode->vdisplay;
+    }
+  }
+  if (index < 0)
+  {
+    why = "its display has no mode";
+    return false;
+  }
+
+  // A CRTC that can drive it: the one in use, where it can (what shows Kodi stays then)
+  uint32_t possible = 0;
+  const std::vector<uint32_t> encoders = connector->GetEncoderIds();
+  for (const auto& encoder : m_encoders)
+  {
+    if (std::ranges::find(encoders, encoder->GetEncoderId()) != encoders.end())
+      possible |= encoder->GetPossibleCrtcsMask();
+  }
+  const int crtcIndex =
+      MoveCrtc(possible, static_cast<int>(m_crtc->GetOffset()), static_cast<int>(m_crtcs.size()));
+  if (crtcIndex < 0)
+  {
+    why = "no CRTC of the device can drive it";
+    return false;
+  }
+  move.crtc = m_crtcs[crtcIndex].get();
+  for (const auto& encoder : m_encoders)
+  {
+    if (std::ranges::find(encoders, encoder->GetEncoderId()) != encoders.end() &&
+        (encoder->GetPossibleCrtcsMask() & (uint32_t{1} << crtcIndex)))
+    {
+      move.encoder = encoder.get();
+      break;
+    }
+  }
+
+  // The plane that shows Kodi there, which takes what it shows now (its format and modifier):
+  // the one in use, where that is on the same CRTC
+  const RESOLUTION_INFO res = GetResolutionInfo(connector->GetModeForIndex(index));
+  const PlaneType type = HasQuirk(QUIRK_NEEDSPRIMARY) ? PLANE_TYPE_PRIMARY : PLANE_TYPE_ANY;
+  const uint32_t format = m_gui_plane->GetFormat();
+  const uint64_t modifier = m_gui_plane->GetModifier();
+  if (move.crtc == m_crtc &&
+      m_gui_plane->Check(res.iWidth, res.iHeight, format, modifier, m_crtc, type))
+    move.plane = m_gui_plane;
+  for (const auto& plane : m_planes)
+  {
+    if (!move.plane && plane->Check(res.iWidth, res.iHeight, format, modifier, move.crtc, type))
+      move.plane = plane.get();
+  }
+  if (!move.encoder || !move.plane)
+  {
+    why = !move.encoder ? "it has no encoder for that CRTC"
+                        : "no plane of that CRTC takes what Kodi shows";
+    return false;
+  }
+
+  move.connector = connector;
+  move.modeIndex = index;
+  move.mode = *connector->GetModeForIndex(index);
+  move.width = res.iWidth;
+  move.height = res.iHeight;
+  return true;
+}
+
+void CDRMUtils::MoveOutput(const OutputMove& move)
+{
+  // (the next commit of a mode takes the output in use off its CRTC)
+  m_moveFrom = m_connector;
+  m_moveResult.reset();
+
+  if (move.crtc != m_crtc)
+    m_old_crtc = m_crtc;
+  m_connector = move.connector;
+  m_encoder = move.encoder;
+  m_crtc = move.crtc;
+  if (move.plane != m_gui_plane)
+  {
+    move.plane->SetFormat(m_gui_plane->GetFormat());
+    move.plane->SetModifier(m_gui_plane->GetModifier());
+    m_gui_plane = move.plane;
+  }
+  // (Kodi moves while it shows its interface only: no plane is a video's)
+  m_video_plane = nullptr;
+  m_mode = m_connector->GetModeForIndex(move.modeIndex);
+  m_width = move.width;
+  m_height = move.height;
+  AllowModeset();
+
+  CLog::LogF(LOGINFO, "Kodi shows itself on {} from the next commit, CRTC {}, in {}x{}{} @ {} Hz",
+             m_connector->GetName(), m_crtc->GetCrtcId(), m_mode->hdisplay, m_mode->vdisplay,
+             m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "", m_mode->vrefresh);
 }
 
