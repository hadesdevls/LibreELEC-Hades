+  /*!
+   * \brief Hades: what a change of the Monitor setting does (CDisplaySettings::OnSettingChanging())
+   */
+  enum class ScreenChange
+  {
+    AS_ALWAYS, //!< as in Kodi: MoveToScreen(), the resolutions, and the question to keep it
+    MOVED, //!< the window system shows Kodi on that monitor now: the question to keep it follows
+    DONE, //!< nothing more is to be done: the setting takes the monitor (used, or as it is told)
+    REFUSED, //!< the setting keeps the monitor it had (the window system told the user why)
+  };
+
+  /*!
+   * \brief Hades: a window system that changes the monitor by itself does it here
+   * \param screen the monitor that the setting names now (a name of GetConnectedOutputs())
+   * \param reverting the setting goes back to the monitor it had: a change that was not kept is
+   *        undone (nothing is asked then)
+   */
+  virtual ScreenChange ChangeScreen(const std::string& screen, bool reverting)
+  {
+    return ScreenChange::AS_ALWAYS;
+  }
