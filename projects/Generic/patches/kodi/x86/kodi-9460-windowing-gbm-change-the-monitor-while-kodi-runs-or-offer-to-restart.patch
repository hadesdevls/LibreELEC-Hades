   std::vector<std::string> outputs;
   outputs.emplace_back(OUTPUT_NAME_DEFAULT);
-  for (const auto& name : m_DRM->GetConnectedConnectorNames())
+  for (const auto& name : m_DRM->GetConnectedConnectorNames(OutputsNow()))
