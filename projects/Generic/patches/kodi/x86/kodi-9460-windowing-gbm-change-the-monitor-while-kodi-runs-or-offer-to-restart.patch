+bool CDRMConnector::Refresh()
+{
+  std::unique_ptr<drmModeConnector, DrmModeConnectorDeleter> now(
+      drmModeGetConnector(m_fd, m_connector->connector_id));
+  if (!now)
+    return false;
+
+  // (the one read before is kept: m_connector is never empty for another thread that reads it)
+  m_connector.swap(now);
+  m_before.emplace_back(std::move(now));
+  RefreshPropertyValues();
+  return true;
+}
