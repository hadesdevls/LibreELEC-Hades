From e9481861f536e3b35536c57ffe2fe7662863e8c7 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 19 Oct 2026 22:33:19 +0200
Subject: [PATCH] [AudioEngine] ActiveAE: Do not mute in-sync samples while
 measuring the sync error

On every start of a stream, e.g. at playback start and after a seek,
the stream's samples were muted for the 100 ms the sync error is
averaged over. Muted samples are consumed, not delayed, so the start of
the audio was lost, e.g. the first syllable of a video starting with
speech. Samples are now only muted as long as no error was measured yet
or it is beyond the sync threshold.

(cherry picked from commit cdbfacb15acc9d6b7b7c24d13fe5f0c84d88154d)
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp   |  6 +++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAEStream.h      | 10 ++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 338a151..d5555d4 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2685,7 +2685,11 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     CLog::Log(LOGDEBUG, "ActiveAE::SyncStream - average error of {:f}, start adjusting", error);
   }
 
-  if (stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE)
+  // While the error is averaged, samples that already play close to in sync stay audible, so that
+  // the start of the audio is not lost.
+  double errorSoFar{0.0};
+  const bool closeToSync{stream->m_syncError.GetSoFar(errorSoFar) && fabs(errorSoFar) <= threshold};
+  if (stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE && !closeToSync)
   {
     CSampleBuffer *buf = stream->m_processingBuffers->m_outputSamples.front();
     if (m_mode == MODE_RAW)
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index 82a9220..65c688a 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -66,6 +66,16 @@ public:
     }
   }
 
+  // The error averaged so far, before the interval of Get() is over.
+  bool GetSoFar(double& error) const
+  {
+    if (!m_count)
+      return false;
+
+    error = Get();
+    return true;
+  }
+
   double GetLastError(unsigned int &time)
   {
     time = m_timer.GetStartTime().time_since_epoch().count();
-- 
2.53.0

