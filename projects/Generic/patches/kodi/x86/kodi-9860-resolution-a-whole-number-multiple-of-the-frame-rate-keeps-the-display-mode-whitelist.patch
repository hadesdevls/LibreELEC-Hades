+KODI::WINDOWING::WholeMultipleDepthKey CWinSystemGbm::HdrDepthKey(uint32_t clock,
+                                                                 uint32_t hdisplay,
+                                                                 uint32_t vdisplay,
+                                                                 uint32_t htotal,
+                                                                 uint32_t vtotal,
+                                                                 uint32_t flags) const
