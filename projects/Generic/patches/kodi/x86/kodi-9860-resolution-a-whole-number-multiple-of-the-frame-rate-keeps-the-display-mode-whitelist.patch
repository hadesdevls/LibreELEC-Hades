new file mode 100644
index 0000000..25e92ec
--- /dev/null
+++ b/xbmc/windowing/WholeMultiple.h
@@ -0,0 +1,312 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace KODI::WINDOWING
+{
+
+/*!
+ * \brief Hades: a refresh rate that is a whole-number multiple of the frame rate of a video, kept
+ * in place of a change of mode (System > Display, the whitelist: videoscreen.hadeswholemultiple)
+ *
+ * With a whitelist, Kodi takes a mode at the exact frame rate of the video, then one at twice it
+ * or at 2.5 times it (3:2 pulldown) where its options allow them, at the size of the video and
+ * then at the width of the GUI (CResolutionUtils::FindResolutionFromWhitelist()). A display that
+ * is at 120 Hz takes a change of mode for 24 fps (to 24 Hz, or to 60 Hz with 3:2 pulldown) that
+ * shows nothing better than what 120 Hz shows: each picture five times, the same number of times
+ * every time. The setting keeps the mode the display is in where all of this holds:
+ *  - the setting is on, and there is a user whitelist (without one, nothing changes);
+ *  - the whitelist has no mode at the exact frame rate, neither at the size of the video nor at
+ *    the width of the GUI: a mode at the exact frame rate still comes first;
+ *  - the mode the display is in is in the whitelist, progressive and not 3D, of the size of the
+ *    video or of the width of the GUI (Kodi's two tiers);
+ *  - its refresh rate is k times the frame rate, k a whole number, within Kodi's tolerance for
+ *    refresh rates (0.01 Hz): k from 3, and k = 2 only where Kodi's own option of double refresh
+ *    rates allows them (videoscreen.whitelistdoublerefreshrate). 120 Hz is 5 x 24 fps, 119.88 Hz
+ *    5 x 23.976 fps, 100 Hz 4 x 25 fps; 120 Hz is no multiple of 23.976 fps (5 x 23.976 is
+ *    119.88);
+ *  - the video is known to be progressive (CDVDStreamInfo::progressive, the frame rate is then
+ *    exact), and is SDR or HDR10. Never Dolby Vision (in the stream, in its pictures, or as
+ *    the output: native output keeps its cadence, at 60 Hz at most), HDR10+ or HLG;
+ *  - for HDR10, the link is known with certainty to carry 10 bits per component or more in that
+ *    mode with HDR10 on (WholeMultipleDepth, below); where that is not known, the mode is not
+ *    kept.
+ * Otherwise Kodi's choice is made as it was, step for step.
+ *
+ * Nothing of Kodi is here: a test runs it on the host.
+ */
+
+//! The setting (System > Display, under the whitelist), off by default
+constexpr const char* WHOLE_MULTIPLE_SETTING = "videoscreen.hadeswholemultiple";
+
+//! Kodi's tolerance for the refresh rate of a whitelisted mode (FindResolutionFromWhitelist())
+constexpr double WHOLE_MULTIPLE_TOLERANCE = 0.01;
+
+//! What the video is, for the setting. The order is the order of WholeMultipleVideoNext(): within
+//! a file, a video only goes down this list.
+enum class WholeMultipleVideo
+{
+  UNKNOWN, //!< not told (no video stream opened for the file yet, or a caller that does not say)
+  SDR,
+  HDR10,
+  HDR10PLUS,
+  HLG,
+  DOLBY_VISION, //!< in the stream, in a picture of it, or as its output (native or measured)
+};
+
+//! What a video stream or one of its pictures is, by what it says
+constexpr WholeMultipleVideo WholeMultipleVideoOf(bool dolbyVision, bool hdr10Plus, bool hlg, bool pq)
+{
+  return dolbyVision ? WholeMultipleVideo::DOLBY_VISION
+         : hdr10Plus ? WholeMultipleVideo::HDR10PLUS
+         : hlg       ? WholeMultipleVideo::HLG
+         : pq        ? WholeMultipleVideo::HDR10
+                     : WholeMultipleVideo::SDR;
+}
+
+//! What the video is once one of its streams or pictures said "next": the further down the list.
+//! A video that was not told stays so (a picture alone does not make a video SDR).
+constexpr WholeMultipleVideo WholeMultipleVideoNext(WholeMultipleVideo now, WholeMultipleVideo next)
+{
+  if (now == WholeMultipleVideo::UNKNOWN)
+    return now;
+  return static_cast<int>(next) > static_cast<int>(now) ? next : now;
+}
+
+//! The video may have its frame rate shown at a whole-number multiple: SDR or HDR10
+constexpr bool WholeMultipleVideoTakes(WholeMultipleVideo video)
+{
+  return video == WholeMultipleVideo::SDR || video == WholeMultipleVideo::HDR10;
+}
+
+//! For the log: what the video is
+constexpr const char* WholeMultipleVideoName(WholeMultipleVideo video)
+{
+  switch (video)
+  {
+    case WholeMultipleVideo::UNKNOWN:
+      return "not known";
+    case WholeMultipleVideo::SDR:
+      return "SDR";
+    case WholeMultipleVideo::HDR10:
+      return "HDR10";
+    case WholeMultipleVideo::HDR10PLUS:
+      return "HDR10+";
+    case WholeMultipleVideo::HLG:
+      return "HLG";
+    case WholeMultipleVideo::DOLBY_VISION:
+      return "Dolby Vision";
+  }
+  return "not known";
+}
+
+/*!
+ * \brief k where refresh is k times fps (a whole number, within Kodi's tolerance), or 0
+ * \param doubleAllowed k = 2 counts (Kodi's option of double refresh rates); k = 1 never does
+ */
+inline int WholeMultipleOf(double refresh, double fps, bool doubleAllowed)
+{
+  if (!(fps > 0.0) || !(refresh > 0.0) || !std::isfinite(fps) || !std::isfinite(refresh))
+    return 0;
+  const double k = std::round(refresh / fps);
+  if (k < 2.0 || (k < 3.0 && !doubleAllowed))
+    return 0;
+  if (!(std::fabs(refresh - k * fps) < WHOLE_MULTIPLE_TOLERANCE))
+    return 0;
+  return static_cast<int>(k);
+}
+
+/*!
+ * \brief What is known, with certainty, of the depth of the link for HDR10 in a mode
+ *
+ * HDR10 keeps a mode only where the link carries 10 bits per component or more in it with HDR10
+ * on: no driver says that before a commit by itself. What is known comes from the driver:
+ * - i915 and amdgpu with the Hades patches answer a TEST_ONLY commit of HDR10 in the mode in use
+ *   (HDR_OUTPUT_METADATA, Colorspace, the depth Kodi sets for HDR and the choice of HDR in YCbCr
+ *   4:2:0, with their HDR10 depth guard, DVBRIDGE_HDR10_DEEP_COLOR): the format and the depth of
+ *   that configuration (DVBRIDGE_LINK_FORMAT), or a refusal below 10 bits;
+ * - every driver of Hades says the depth once HDR10 is on the output: nvidia-drm in NV_OUTPUT_BPC,
+ *   i915 and amdgpu through the guard. NVKMS chooses the depth (and HDMI FRL) only when it commits,
+ *   and a TEST_ONLY commit does not report it: on NVIDIA the depth is known only where HDR10 went
+ *   out in that mode before.
+ * Each answer is kept for the mode (its timing), the display (its EDID) and the settings that change
+ * the driver's choice (HDR where RGB would be 8-bit, HDR output depth), for the session.
+ */
+enum class WholeMultipleDepth
+{
+  UNKNOWN, //!< nothing certain: the mode is not kept for HDR10
+  DEEP, //!< 10 bits or more
+  SHALLOW, //!< fewer than 10
+};
+
+//! The answer of the window system for a mode
+struct WholeMultipleDepthFact
+{
+  WholeMultipleDepth depth = WholeMultipleDepth::UNKNOWN;
+  unsigned int bpc = 0; //!< bits per component, where known
+  //! how it is known (for the log); nullptr where nothing is
+  const char* how = nullptr;
+};
+
+//! A mode of a display, as the depth of HDR10 in it is kept
+struct WholeMultipleDepthKey
+{
+  uint64_t edid = 0; //!< a hash of the EDID of the display (0: none read)
+  uint32_t clock = 0; //!< kHz
+  uint32_t hdisplay = 0;
+  uint32_t vdisplay = 0;
+  uint32_t htotal = 0;
+  uint32_t vtotal = 0;
+  uint32_t flags = 0; //!< the mode's flags without its 3D layout
+  int hdr420 = 0; //!< videoscreen.hadeshdr420
+  int hdrDepth = 0; //!< videoscreen.hadeshdrdepth
+  bool operator==(const WholeMultipleDepthKey&) const = default;
+};
+
+//! FNV-1a of the bytes of an EDID: the display, for WholeMultipleDepthKey (0 for none)
+inline uint64_t WholeMultipleEdidHash(const uint8_t* data, size_t size)
+{
+  if (!data || !size)
+    return 0;
+  uint64_t h = 1469598103934665603ULL;
+  for (size_t i = 0; i < size; ++i)
+  {
+    h ^= data[i];
+    h *= 1099511628211ULL;
+  }
+  return h ? h : 1;
+}
+
+//! The answers kept (the last LIMIT modes): a later answer for a mode replaces the one before
+class WholeMultipleDepthMemory
+{
+public:
+  static constexpr size_t LIMIT = 32;
+
+  void Remember(const WholeMultipleDepthKey& key, unsigned int bpc, const char* how)
+  {
+    for (auto it = m_entries.begin(); it != m_entries.end(); ++it)
+    {
+      if (it->key == key)
+      {
+        m_entries.erase(it);
+        break;
+      }
+    }
+    m_entries.push_back({key, {bpc >= 10 ? WholeMultipleDepth::DEEP : WholeMultipleDepth::SHALLOW,
+                               bpc, how}});
+    while (m_entries.size() > LIMIT)
+      m_entries.erase(m_entries.begin());
+  }
+  WholeMultipleDepthFact Find(const WholeMultipleDepthKey& key) const
+  {
+    // (a display without an EDID read is no display the answers can be told of)
+    if (key.edid == 0)
+      return {};
+    for (const auto& entry : m_entries)
+    {
+      if (entry.key == key)
+        return entry.fact;
+    }
+    return {};
+  }
+  bool Has(const WholeMultipleDepthKey& key) const { return Find(key).how != nullptr; }
+  size_t Size() const { return m_entries.size(); }
+
+private:
+  struct Entry
+  {
+    WholeMultipleDepthKey key;
+    WholeMultipleDepthFact fact;
+  };
+  std::vector<Entry> m_entries;
+};
+
+//! What FindResolutionFromWhitelist() knows when the whitelist has no mode at the exact frame rate
+//! at the size of the video (the first search of Kodi found nothing)
+struct WholeMultipleQuery
+{
+  bool setting = false; //!< videoscreen.hadeswholemultiple
+  bool whitelist = false; //!< the user has a whitelist (not Kodi's default list)
+  bool doubleAllowed = false; //!< videoscreen.whitelistdoublerefreshrate
+  float fps = 0.0f; //!< the frame rate Kodi chooses for
+  bool progressive = false; //!< CDVDStreamInfo::progressive, as the render manager keeps it
+  bool is3D = false; //!< the video is stereoscopic
+  bool nativeDV = false; //!< the video goes out as native Dolby Vision
+  WholeMultipleVideo video = WholeMultipleVideo::UNKNOWN;
+  bool exactListed = false; //!< a whitelisted mode at the exact rate, at the width of the GUI
+  float currentRefresh = 0.0f; //!< the refresh rate of the mode the display is in
+  bool currentListed = false; //!< that mode is in the whitelist
+  bool currentSized = false; //!< ... of the size of the video, or of the width of the GUI
+  bool currentInterlaced = false;
+  bool current3D = false;
+  //! for HDR10: the depth of the link in that mode with HDR10 on (WholeMultipleDepthFact)
+  WholeMultipleDepth hdrDepth = WholeMultipleDepth::UNKNOWN;
+};
+
+//! What WholeMultipleKeep() decided
+struct WholeMultipleVerdict
+{
+  bool keep = false; //!< the mode the display is in is kept: Kodi's choice ends there
+  int multiple = 0; //!< k of the mode the display is in (0: it is no whole-number multiple)
+  //! why the mode, a whole-number multiple, is not kept (for the log); nullptr: nothing to say
+  //! (the setting is off, no whitelist, the mode is no multiple, or it is kept)
+  const char* why = nullptr;
+};
+
+/*!
+ * \brief Whether the mode the display is in is kept as a whole-number multiple of the frame rate
+ *
+ * With the setting off, or without a whitelist, the answer is always "no, and nothing to say":
+ * the caller goes on with Kodi's choice exactly as before.
+ */
+inline WholeMultipleVerdict WholeMultipleKeep(const WholeMultipleQuery& q)
+{
+  WholeMultipleVerdict v;
+  if (!q.setting || !q.whitelist)
+    return v;
+  v.multiple = WholeMultipleOf(q.currentRefresh, q.fps, q.doubleAllowed);
+  if (v.multiple == 0)
+    return v;
+  if (q.nativeDV || q.video == WholeMultipleVideo::DOLBY_VISION)
+    v.why = "Dolby Vision keeps the cadence Kodi chooses without it, and goes natively at 60 Hz "
+            "at most: whole-number multiples are ignored for it";
+  else if (q.video == WholeMultipleVideo::HDR10PLUS)
+    v.why = "the video is HDR10+: whole-number multiples are for SDR and HDR10 only";
+  else if (q.video == WholeMultipleVideo::HLG)
+    v.why = "the video is HLG: whole-number multiples are for SDR and HDR10 only";
+  else if (q.video == WholeMultipleVideo::UNKNOWN)
+    v.why = "what the video is was not told";
+  else if (q.is3D)
+    v.why = "the video is 3D";
+  else if (!q.progressive)
+    v.why = "the video is not known to be progressive";
+  else if (q.exactListed)
+    v.why = "the whitelist has a mode at the exact frame rate";
+  else if (!q.currentListed)
+    v.why = "that mode is not in the whitelist";
+  else if (q.currentInterlaced || q.current3D)
+    v.why = "that mode is interlaced or 3D";
+  else if (!q.currentSized)
+    v.why = "that mode is neither of the size of the video nor of the width of the GUI";
+  else if (q.video == WholeMultipleVideo::HDR10 && q.hdrDepth == WholeMultipleDepth::UNKNOWN)
+    v.why = "the video is HDR10, and whether the link carries 10 bits in this mode is not known";
+  else if (q.video == WholeMultipleVideo::HDR10 && q.hdrDepth != WholeMultipleDepth::DEEP)
+    v.why = "the video is HDR10, and the link carries fewer than 10 bits in this mode";
+  else
+    v.keep = true;
+  return v;
+}
