+void CWinSystemGbmGLESContext::WholeMultipleMeasured(const drmModeModeInfo* mode,
+                                                     unsigned int bpc,
+                                                     const char* how)
+{
+  // (HDR10 only: what the multiples are asked about. A Dolby Vision picture rebuilt as HDR10 goes
+  // out as HDR10, with the same signalling.)
+  if (!mode || m_outDepthEotf != KODI::UTILS::Eotf::PQ)
+    return;
+  RememberHdrDepth(*mode, bpc, how);
+  if (bpc >= 10)
+    return;
+  // Where this mode was kept for the video as a whole-number multiple of its frame rate, and the
+  // link carries fewer than 10 bits in it after all, the mode is chosen again, without the
+  // multiple (the answer is now known for it)
+  auto& gfx = GetGfxContext();
+  if (CResolutionUtils::WholeMultipleKept() == RES_INVALID ||
+      CResolutionUtils::WholeMultipleKept() != gfx.GetVideoResolution())
+    return;
+  CLog::Log(LOGWARNING,
+            "[WHITELIST] Hades: {}x{} was kept as a whole-number multiple of the frame rate, and "
+            "HDR10 goes out at {} bits in it ({}): the display mode is chosen again",
+            mode->hdisplay, mode->vdisplay, bpc, how);
+  CResolutionUtils::ForgetWholeMultipleKept();
+  if (const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>())
+    player->TriggerUpdateResolution();
+}
+
+void CWinSystemGbmGLESContext::ProbeHdr10DepthAhead()
+{
+  using namespace KODI::WINDOWING;
+  // (a look every two seconds at most: the settings are read with it)
+  const int64_t now = SteadyNowNs();
+  if (now - m_hdrAheadCheckedNs < 2'000'000'000LL)
+    return;
+  m_hdrAheadCheckedNs = now;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  const drmModeModeInfo* mode = drm ? drm->GetSelectedMode() : nullptr;
+  const char* const guard = "DVBRIDGE_HDR10_DEEP_COLOR";
+  // Only i915 and amdgpu have the guard; nvidia-drm says the depth only once HDR10 is on
+  // (ProbeOutputDepth()). The mode must be the one on the output.
+  if (!connector || !mode || !drm->SelectedModeOnOutput() || !connector->SupportsProperty(guard) ||
+      !connector->SupportsProperty(DVBRIDGE::LINK::PROPERTY) ||
+      !connector->SupportsProperty("HDR_OUTPUT_METADATA") ||
+      !connector->SupportsProperty("Colorspace") || NativeDVOutputInUse())
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetBool(WHOLE_MULTIPLE_SETTING) ||
+      settings->GetList(CSettings::SETTING_VIDEOSCREEN_WHITELIST).empty())
+    return;
+  // (the GUI alone: nothing plays, nothing is being set up for a video)
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlaying())
+    return;
+  const auto key =
+      HdrDepthKey(mode->clock, mode->hdisplay, mode->vdisplay, mode->htotal, mode->vtotal,
+                  mode->flags);
+  if (key.edid == 0 || (m_hdrAheadTried && *m_hdrAheadTried == key) || HdrDepthRemembered(*mode))
+    return;
+  m_hdrAheadTried = key;
+
+  // The configuration that HDR10 would have in this mode (SetHDR(), SetColorimetry(),
+  // QueueLinkDepth()): static metadata with the PQ EOTF (their values do not change the depth),
+  // BT.2020 RGB, the depth Kodi sets for HDR where it sets one, the choice of HDR in YCbCr 4:2:0,
+  // and the guard. TEST_ONLY: nothing goes to the display.
+  hdr_output_metadata metadata{};
+  metadata.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  metadata.hdmi_metadata_type1.eotf = static_cast<uint8_t>(KODI::UTILS::Eotf::PQ);
+  metadata.hdmi_metadata_type1.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  // BT.2020 and D65 in units of 0.00002, 1000 and 0.005 cd/m2
+  const uint16_t primaries[3][2] = {{35400, 14600}, {8500, 39850}, {6550, 2300}};
+  for (int i = 0; i < 3; i++)
+  {
+    metadata.hdmi_metadata_type1.display_primaries[i].x = primaries[i][0];
+    metadata.hdmi_metadata_type1.display_primaries[i].y = primaries[i][1];
+  }
+  metadata.hdmi_metadata_type1.white_point.x = 15635;
+  metadata.hdmi_metadata_type1.white_point.y = 16450;
+  metadata.hdmi_metadata_type1.max_display_mastering_luminance = 1000;
+  metadata.hdmi_metadata_type1.min_display_mastering_luminance = 50;
+  metadata.hdmi_metadata_type1.max_cll = 1000;
+  metadata.hdmi_metadata_type1.max_fall = 400;
+  CDRMPropertyBlob blob(drm->GetFileDescriptor(), &metadata, sizeof(metadata));
+  const auto colorspace = connector->GetPropertyEnumValue("Colorspace", "BT2020_RGB");
+  const std::string where = StringUtils::Format(
+      "{}x{} @ {:.3f} Hz", mode->hdisplay, mode->vdisplay,
+      mode->htotal && mode->vtotal
+          ? mode->clock * 1000.0 / (static_cast<double>(mode->htotal) * mode->vtotal)
+          : 0.0);
+  if (!blob.IsValid() || !colorspace)
+  {
+    CLog::Log(LOGINFO, "HDR output: the depth of HDR10 in {} could not be asked before a video "
+                       "(no blob, or no BT2020_RGB): not known",
+              where);
+    return;
+  }
+  std::vector<std::pair<const char*, uint64_t>> properties{
+      {"HDR_OUTPUT_METADATA", blob.Get()}, {"Colorspace", *colorspace}, {guard, 1}};
+  if (m_linkDepth.managed)
+    properties.emplace_back("max bpc", LinkDepthWanted(m_linkDepth, LinkContent::HDR,
+                                                       m_hdrDepthChoice ? key.hdrDepth : 0));
+  if (connector->SupportsProperty(DVBRIDGE::LINK::HDR_YCBCR420))
+  {
+    if (const auto value = connector->GetPropertyEnumValue(DVBRIDGE::LINK::HDR_YCBCR420,
+                                                           key.hdr420 == 1 ? "never" : "deep"))
+      properties.emplace_back(DVBRIDGE::LINK::HDR_YCBCR420, *value);
+  }
+  const auto test = drm->TestConnectorProperties(properties);
+  DVBRIDGE::LINK::Format link;
+  if (test != CDRMAtomic::PropertyTest::UNSUPPORTED)
+  {
+    if (const auto value = connector->ReadPropertyValue(DVBRIDGE::LINK::PROPERTY); value && *value)
+      link = DVBRIDGE::LINK::Parse(
+          connector->GetPropertyBitmaskNames(DVBRIDGE::LINK::PROPERTY, *value));
+  }
+  const auto refused =
+      test == CDRMAtomic::PropertyTest::REFUSED ? drm->ReadRefused() : std::vector<std::string>{};
+  const bool shallow = DVBRIDGE::REFUSED::Has(refused, DVBRIDGE::REFUSED::HDR10_DEPTH);
+  if (link.Known() && (test == CDRMAtomic::PropertyTest::ACCEPTED || shallow))
+  {
+    RememberHdrDepth(*mode, link.bpc,
+                     "a TEST_ONLY commit of HDR10 before the video (DVBRIDGE_HDR10_DEEP_COLOR, "
+                     "DVBRIDGE_LINK_FORMAT)");
+    CLog::Log(LOGINFO,
+              "HDR output: HDR10 in {} would go out as {} at {} bits, as the driver answers a "
+              "TEST_ONLY commit of it (for the whole-number multiples of the frame rate)",
+              where, DVBRIDGE::LINK::DisplayName(link.format), link.bpc);
+  }
+  else
+    CLog::Log(LOGINFO,
+              "HDR output: the depth of HDR10 in {} is not known before a video: the driver {} the "
+              "TEST_ONLY commit of it{}",
+              where,
+              test == CDRMAtomic::PropertyTest::ACCEPTED ? "took"
+              : test == CDRMAtomic::PropertyTest::REFUSED ? "refused"
+                                                          : "could not be asked",
+              link.Known() ? "" : " and said no format");
+}
