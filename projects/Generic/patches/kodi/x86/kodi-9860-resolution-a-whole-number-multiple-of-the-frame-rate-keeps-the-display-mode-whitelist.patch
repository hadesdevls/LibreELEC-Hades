+CDRMAtomic::PropertyTest CDRMAtomic::TestConnectorProperties(
+    const std::vector<std::pair<const char*, uint64_t>>& properties)
+{
+  if (!m_connector || properties.empty())
+    return PropertyTest::UNSUPPORTED;
+  CDRMAtomicRequest request;
+  for (const auto& [name, value] : properties)
+  {
+    if (!m_connector->SupportsProperty(name) || !request.AddProperty(m_connector, name, value))
+      return PropertyTest::UNSUPPORTED;
+  }
+  return drmModeAtomicCommit(m_fd, request.Get(),
+                             DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET,
+                             nullptr) == 0
+             ? PropertyTest::ACCEPTED
+             : PropertyTest::REFUSED;
+}
