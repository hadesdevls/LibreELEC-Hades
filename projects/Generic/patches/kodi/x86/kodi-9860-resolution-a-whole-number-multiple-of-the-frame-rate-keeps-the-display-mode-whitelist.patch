                                        m_fileModeChosen, m_nativeDVIntent))
         m_bTriggerUpdateResolution = true;
       return true;
@@ -172,6 +176,8 @@ bool CRenderManager::Configure(const VideoPicture& picture,
 #endif
     m_fps = fps;
     UpdateProgressive(progressive);
+    // (the mode is chosen again once this configuration is done: Configure())
+    UpdateWholeMultipleVideo(picture);
     m_orientation = orientation;
     m_NumberBuffers  = buffers;
     m_renderState = STATE_CONFIGURING;
@@ -648,7 +654,7 @@ RESOLUTION CRenderManager::GetResolution()
   {
     res = CResolutionUtils::ChooseBestResolution(m_fps, m_picture.iWidth, m_picture.iHeight,
                                                  !m_picture.stereoMode.empty(), m_nativeDVRate,
-                                                 m_progressive);
+                                                 m_progressive, m_wholeVideo);
   }
 
   return res;
@@ -894,7 +900,7 @@ void CRenderManager::UpdateResolution()
       {
         RESOLUTION res = CResolutionUtils::ChooseBestResolution(
             m_fps, m_picture.iWidth, m_picture.iHeight, !m_picture.stereoMode.empty(), m_nativeDVRate,
-            m_progressive);
+            m_progressive, m_wholeVideo);
         // Once a file has its mode, a mode at twice the frame rate stays: Kodi's default choice puts
         // 25 and 50 fps, 29.97 and 59.94 fps, 30 and 60 fps in the same mode, so a frame rate
         // corrected during playback (a container rate of 50 for 25p video) switches nothing.
@@ -1016,6 +1022,54 @@ void CRenderManager::NewFile()
   m_fileModeChosen = false;
   m_nativeDVIntent = -1;
   m_nativeDVRate = false;
+  m_wholeVideo = KODI::WINDOWING::WholeMultipleVideo::UNKNOWN;
+}
+
+void CRenderManager::SetWholeMultipleVideo(KODI::WINDOWING::WholeMultipleVideo video)
+{
+  using KODI::WINDOWING::WholeMultipleVideo;
+  WholeMultipleVideo now = m_wholeVideo;
+  WholeMultipleVideo next;
+  do
+  {
+    next = now == WholeMultipleVideo::UNKNOWN ? video
+                                              : KODI::WINDOWING::WholeMultipleVideoNext(now, video);
+    if (next == now)
+      return;
+  } while (!m_wholeVideo.compare_exchange_weak(now, next));
+  CLog::Log(LOGDEBUG, "CRenderManager - the video is {}, for whole-number multiples of its frame rate",
+            KODI::WINDOWING::WholeMultipleVideoName(next));
+}
+
+bool CRenderManager::UpdateWholeMultipleVideo(const VideoPicture& picture)
+{
+  using namespace KODI::WINDOWING;
+  const bool dolbyVision = picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION ||
+                           picture.hdrTypeAlt == StreamHdrType::HDR_TYPE_DOLBYVISION ||
+                           picture.doviMeasured || picture.doviConvert;
+  const bool hdr10Plus = picture.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS ||
+                         picture.hdrTypeAlt == StreamHdrType::HDR_TYPE_HDR10PLUS;
+  const bool hlg = picture.hdrType == StreamHdrType::HDR_TYPE_HLG ||
+                   picture.color_transfer == AVCOL_TRC_ARIB_STD_B67;
+  const bool pq = picture.hdrType == StreamHdrType::HDR_TYPE_HDR10 ||
+                  picture.color_transfer == AVCOL_TRC_SMPTE2084;
+  const WholeMultipleVideo said = WholeMultipleVideoOf(dolbyVision, hdr10Plus, hlg, pq);
+  WholeMultipleVideo now = m_wholeVideo;
+  WholeMultipleVideo next;
+  do
+  {
+    next = WholeMultipleVideoNext(now, said);
+    if (next == now)
+      return false;
+  } while (!m_wholeVideo.compare_exchange_weak(now, next));
+  const bool lost = WholeMultipleVideoTakes(now) && !WholeMultipleVideoTakes(next) &&
+                    CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+                        WHOLE_MULTIPLE_SETTING);
+  CLog::Log(lost ? LOGINFO : LOGDEBUG,
+            "CRenderManager - a picture shows that the video is {}, not {}{}",
+            WholeMultipleVideoName(next), WholeMultipleVideoName(now),
+            lost ? ": its display mode is chosen again, without whole-number multiples" : "");
+  return lost;
 }
 
 bool CRenderManager::UpdateProgressive(bool progressive)
