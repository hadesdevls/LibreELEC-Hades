+void CWinSystemGbm::RememberHdrDepth(const drmModeModeInfo& mode,
+                                     unsigned int bpc,
+                                     const char* how)
+{
+  const auto key =
+      HdrDepthKey(mode.clock, mode.hdisplay, mode.vdisplay, mode.htotal, mode.vtotal, mode.flags);
