+                       hint.dovi.dv_profile != 0;
+    bool hdr10Plus = hint.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS;
+#ifdef HAVE_DVBRIDGE
+    dolbyVision = dolbyVision || hint.doviMeasured || hint.doviFromHdr10Plus;
+    // (HDR10+ metadata that the demuxer found in the first packets of the stream)
+    hdr10Plus = hdr10Plus || DVBRIDGE::ChoiceSourceNow() == DVBRIDGE::ChoiceSource::HDR10PLUS;
+#endif
+    m_renderManager.SetWholeMultipleVideo(KODI::WINDOWING::WholeMultipleVideoOf(
+        dolbyVision, hdr10Plus,
+        hint.hdrType == StreamHdrType::HDR_TYPE_HLG ||
+            hint.colorTransferCharacteristic == AVCOL_TRC_ARIB_STD_B67,
+        hint.hdrType == StreamHdrType::HDR_TYPE_HDR10 ||
+            hint.colorTransferCharacteristic == AVCOL_TRC_SMPTE2084));
+  }
+
