+bool CWinSystemGbm::HdrDepthRemembered(const drmModeModeInfo& mode) const
+{
+  const auto key =
+      HdrDepthKey(mode.clock, mode.hdisplay, mode.vdisplay, mode.htotal, mode.vtotal, mode.flags);
+  std::unique_lock lock(m_hdrDepthLock);
+  return m_hdrDepthMemory.Has(key);
+}
+
+KODI::WINDOWING::WholeMultipleDepthFact CWinSystemGbm::HdrDepthInMode(
+    const RESOLUTION_INFO& info) const
+{
+  // The mode of the resolution: its place among the modes of the connector is its strId, as the
+  // modes are kept for any thread (m_stereoModes)
+  if (info.strId.empty())
+    return {};
+  const int index = std::atoi(info.strId.c_str());
+  STEREO::Mode mode;
+  {
+    std::unique_lock lock(m_infoLock);
+    if (index < 0 || static_cast<size_t>(index) >= m_stereoModes.size())
+      return {};
+    mode = m_stereoModes[static_cast<size_t>(index)];
+  }
+  if (mode.hdisplay != info.iScreenWidth || mode.vdisplay != info.iScreenHeight)
+    return {};
+  const auto key =
+      HdrDepthKey(mode.clock, mode.hdisplay, mode.vdisplay, mode.htotal, mode.vtotal, mode.flags);
+  std::unique_lock lock(m_hdrDepthLock);
+  return m_hdrDepthMemory.Find(key);
+}
