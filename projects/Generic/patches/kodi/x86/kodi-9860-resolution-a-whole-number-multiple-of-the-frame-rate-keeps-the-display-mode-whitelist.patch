+  key.vdisplay = vdisplay;
+  key.htotal = htotal;
+  key.vtotal = vtotal;
+  key.flags = flags & ~static_cast<uint32_t>(DRM_MODE_FLAG_3D_MASK);
+  // (the settings that change what the driver chooses for HDR: SetHDR(), QueueLinkDepth())
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
