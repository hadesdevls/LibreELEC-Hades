+
+#pragma once
+
+// Hades: where native Dolby Vision output draws a picture whose view the user changed (zoom, a
+// vertical shift, stretching) or whose pixels are not square: the part of the picture that Kodi
+// shows, at the place where Kodi draws it on the 3840x2160 raster (CRendererVAAPIGLES::DVGeometry()).
+// Kodi has already cut its destination to the screen and moved the source with it
+// (CBaseRenderer::ManageRenderArea()); here the place is put on whole pixels of the raster, its
+// columns even (the 4:2:2 transport), and the part of the picture is moved with each edge by the
+// same map from the destination to the source, so that what is drawn is what Kodi would draw there.
+// Pure, for the tests.
+
+#include "dvbridge_core.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace DVBRIDGE
+{
+
+//! source_* the part of the picture that Kodi shows (in its samples), dest_* where it draws it (in
+//! pixels of the raster); false where nothing of it lands on the raster
+inline bool ViewGeometry(int width, int height, double source_x1, double source_y1,
+                         double source_x2, double source_y2, double dest_x1, double dest_y1,
+                         double dest_x2, double dest_y2, dvbridge_geometry& geometry)
+{
+  if (width < 1 || height < 1 || width > 3840 || height > 2160 || !(source_x2 > source_x1) ||
+      !(source_y2 > source_y1) || !(dest_x2 > dest_x1) || !(dest_y2 > dest_y1) ||
+      !std::isfinite(source_x1) || !std::isfinite(source_y1) || !std::isfinite(source_x2) ||
+      !std::isfinite(source_y2) || !std::isfinite(dest_x1) || !std::isfinite(dest_y1) ||
+      !std::isfinite(dest_x2) || !std::isfinite(dest_y2))
+    return false;
+  // the place: within the raster, its edges moved inwards to whole pixels (and even columns) by at
+  // most a pixel (two for a column); a hundredth of a pixel of slack for Kodi's float arithmetic
+  const int left = std::clamp(2 * static_cast<int>(std::ceil(dest_x1 / 2.0 - 0.01)), 0, 3840);
+  const int right = std::clamp(2 * static_cast<int>(std::floor(dest_x2 / 2.0 + 0.01)), 0, 3840);
+  const int top = std::clamp(static_cast<int>(std::ceil(dest_y1 - 0.01)), 0, 2160);
+  const int bottom = std::clamp(static_cast<int>(std::floor(dest_y2 + 0.01)), 0, 2160);
+  if (right - left < 2 || bottom - top < 2)
+    return false;
+  // the part of the picture at those edges, by Kodi's map from its destination to its source
+  const double kx = (source_x2 - source_x1) / (dest_x2 - dest_x1);
+  const double ky = (source_y2 - source_y1) / (dest_y2 - dest_y1);
+  const double v[4] = {
+      std::clamp(source_x1 + (left - dest_x1) * kx, 0.0, static_cast<double>(width)),
+      std::clamp(source_y1 + (top - dest_y1) * ky, 0.0, static_cast<double>(height)),
+      std::clamp(source_x1 + (right - dest_x1) * kx, 0.0, static_cast<double>(width)),
+      std::clamp(source_y1 + (bottom - dest_y1) * ky, 0.0, static_cast<double>(height))};
+  if (v[2] - v[0] < 1.0 || v[3] - v[1] < 1.0)
+    return false;
+  geometry = {width, height, left, top, right - left, bottom - top,
+              {static_cast<float>(v[0]), static_cast<float>(v[1]), static_cast<float>(v[2]),
+               static_cast<float>(v[3])}};
+  return true;
+}
+
+//! Hades: the same geometry, view and all (a frame drawn with another view is another frame)
+inline bool SameGeometry(const dvbridge_geometry& a, const dvbridge_geometry& b)
+{
+  return a.source_width == b.source_width && a.source_height == b.source_height && a.x == b.x &&
+         a.y == b.y && a.width == b.width && a.height == b.height && a.view[0] == b.view[0] &&
+         a.view[1] == b.view[1] && a.view[2] == b.view[2] && a.view[3] == b.view[3];
+}
+
+} // namespace DVBRIDGE
