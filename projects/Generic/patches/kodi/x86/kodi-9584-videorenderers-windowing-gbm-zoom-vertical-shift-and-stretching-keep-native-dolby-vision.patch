   // Native output draws the whole picture, at its own aspect ratio, inside the 3840x2160
-  // raster. Zoom (a cropped source), stretching or a shift out of the raster keep the ordinary
-  // output.
-  if (m_sourceWidth == 0 || m_sourceHeight == 0 || m_sourceWidth > 3840 || m_sourceHeight > 2160 ||
-      m_sourceRect.x1 != 0 || m_sourceRect.y1 != 0 ||
-      m_sourceRect.Width() != m_sourceWidth || m_sourceRect.Height() != m_sourceHeight)
-    return false;
-  if (m_destRect.x1 < -0.5f || m_destRect.y1 < -0.5f || m_destRect.x2 > 3840.5f ||
-      m_destRect.y2 > 2160.5f)
+  // raster. Hades: zoom (a cropped source), stretching, pixels that are not square or a shift out
+  // of the raster draw the part of the picture that Kodi shows where Kodi draws it, natively too
+  // (a view in the geometry: DVBRIDGE::ViewGeometry()); they kept the ordinary output.
+  if (m_sourceWidth == 0 || m_sourceHeight == 0 || m_sourceWidth > 3840 || m_sourceHeight > 2160)
     return false;
   const double aspect = static_cast<double>(m_sourceHeight) / m_sourceWidth;
-  if (std::abs(static_cast<double>(m_destRect.Width()) * aspect -
+  if (m_sourceRect.x1 != 0 || m_sourceRect.y1 != 0 || m_sourceRect.Width() != m_sourceWidth ||
+      m_sourceRect.Height() != m_sourceHeight || m_destRect.x1 < -0.5f ||
+      m_destRect.y1 < -0.5f || m_destRect.x2 > 3840.5f || m_destRect.y2 > 2160.5f ||
+      std::abs(static_cast<double>(m_destRect.Width()) * aspect -
                static_cast<double>(m_destRect.Height())) > 1.5)
-    return false;
+    return DVBRIDGE::ViewGeometry(static_cast<int>(m_sourceWidth),
+                                  static_cast<int>(m_sourceHeight), m_sourceRect.x1,
+                                  m_sourceRect.y1, m_sourceRect.x2, m_sourceRect.y2,
+                                  m_destRect.x1, m_destRect.y1, m_destRect.x2, m_destRect.y2,
+                                  geometry);
   // The 4:2:2 transport needs an even horizontal position and width (for example a 3586-pixel
   // wide picture pillarboxed at x = 127): move each side inwards to an even column, at most one
   // pixel, and take the height from that width, centred where Kodi placed the picture.
