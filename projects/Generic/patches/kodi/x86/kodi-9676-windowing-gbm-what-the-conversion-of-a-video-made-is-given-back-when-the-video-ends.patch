From 4b7c6f05bb1ef9fcc55b8393e49b5c3039ded5b3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:21:11 +0000
Subject: [PATCH] windowing/gbm: what the conversion of a video made is given
 back when the video ends

The objects that the conversion of pictures makes (Dolby Vision sent as HDR10 or
HDR10+, HDR10 adapted or mapped to the display: libplacebo, its tables of colour,
the measurements of HDR10+, the timers) and the profile that the GPU was asked for
were given back only when the window was made again or the window system went. After
such a video the menus went on with all of it engaged, and the GPU in the profile of
the video. They are given back on the render thread as soon as the output of the
video has gone and no other video has begun; the next video that needs them makes
them again with its first picture, as after a change of window.
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 15 +++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  4 ++++
 2 files changed, 19 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 9e928d1..c3e38ee 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -529,6 +529,18 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   m_passSeekNs = std::exchange(m_seekShownNs, 0);
   if (m_passSeekNs > 0)
     m_lagFrameNs = m_lagFrameSoundNs = 0;
+  // Hades: a video has ended and none has begun: what it made for the conversion of its pictures
+  // (Dolby Vision sent as HDR10 or HDR10+, HDR10 adapted or mapped to the display: libplacebo's
+  // objects and their tables of colour, the measurements of HDR10+, the timers) and the profile of
+  // the GPU that it asked for are given back now, not with the next video or the next window. They
+  // are made again, where a video needs them, with its first picture.
+  if (m_dvConvertRelease.exchange(false) && !m_videoOutputUp && m_dvConvertBridge)
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: the video has ended: what it made for the conversion of its pictures "
+              "and the profile of the GPU are given back");
+    EndDVConversion();
+  }
   PublishDVInfo(false);
   // Hades: the menus in Dolby Vision (CDVMenus)
   if (m_dvMenus)
@@ -4788,6 +4800,9 @@ bool CWinSystemGbmGLESContext::SetVideoOutput(const VideoPicture* picture)
   // for the change of mode that follows (CModeChangeHold, STOP)
   if (!picture)
     HoldEndOfVideo();
+  // Hades: ... and nothing that the conversion of its pictures made stays engaged for the menus
+  // (PresentRender()); a video that begins takes that back
+  m_dvConvertRelease = !picture;
   // Hades: the menus in Dolby Vision (CDVMenus): a video whose renderer draws natively, in the surface of the
   // menus, in the Standard mode that they go out in, takes the output over from them: nothing is restored, and
   // the TV keeps its picture mode
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index bbeee0b..0951186 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -726,6 +726,10 @@ private:
   //! Hades: the output of a video is set up: SetVideoOutput() with a picture, and none without one
   //! since (CDVStartSignal)
   bool m_videoOutputUp = false;
+  //! Hades: the output of a video went (its renderer ended) and what it made for the conversion of
+  //! pictures (libplacebo and its tables, the measurements of HDR10+, the profile of the GPU) is
+  //! given back on the render thread, unless another video has begun by then
+  std::atomic<bool> m_dvConvertRelease{false};
   /*!
    * Hades: Dolby Vision for the menus (videoscreen.hadesdvmenus, off by default; CDVMenus): while no video
    * plays, each frame that Kodi draws of its GUI goes out in the transport of native output, made PQ at the
-- 
