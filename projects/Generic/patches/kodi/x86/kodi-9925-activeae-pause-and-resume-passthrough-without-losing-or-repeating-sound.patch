+bool CActiveAE::SinkHold(AEDelayStatus& device, std::deque<CSampleBuffer*>& unwritten)
+{
+  Message* reply;
+  bool held = false;
+  if (m_sink.m_controlPort.SendOutMessageSync(CSinkControlProtocol::HOLD, &reply, 2s))
+  {
+    held = reply->signal == CSinkControlProtocol::ACC && reply->data;
+    if (held)
+      memcpy(&device, reply->data, sizeof(device));
+    reply->Release();
+  }
+  else
+  {
+    CLog::Log(LOGERROR, "ActiveAE::{} - failed to hold", __FUNCTION__);
+    m_extError = true;
+  }
+
+  // What the sink gave back before it answered is all in the queue: what it wrote, and then, in
+  // order, what it had not. A packet given back after an answer that did not come is returned to
+  // its pool by the state machine, as a flush has it.
+  Message* msg;
+  while (m_sink.m_dataPort.ReceiveInMessage(&msg))
+  {
+    CSampleBuffer* buffer = msg->data ? *reinterpret_cast<CSampleBuffer**>(msg->data) : nullptr;
+    if (buffer && held && msg->signal == CSinkDataProtocol::RETURNUNWRITTEN)
+      unwritten.push_back(buffer);
+    else if (buffer)
+      buffer->Return();
+    msg->Release();
+  }
+  return held;
+}
+
+bool CActiveAE::HoldRawStream(CActiveAEStream* stream)
+{
+  if (m_mode != MODE_RAW)
+    return false;
+
+  const char* refused = nullptr;
+  const auto state = stream->m_syncState;
+  if (!m_stats.SinkNeedsIecPack())
+    refused = "the output takes it without IEC 61937 packing";
+  else if (m_state != AE_TOP_CONFIGURED_PLAY && m_state != AE_TOP_CONFIGURED_IDLE)
+    refused = "the output is not open";
+  else if (!stream->m_started || stream->m_drain || !stream->m_processingBuffers ||
+           !stream->m_inputBuffers || !stream->m_pClock)
+    refused = "the stream is not playing";
+  else if (state != CAESyncInfo::AESyncState::SYNC_INSYNC &&
+           state != CAESyncInfo::AESyncState::SYNC_ADJUST &&
+           state != CAESyncInfo::AESyncState::SYNC_MUTE)
+    refused = "its sync is not measured yet";
+  else if (static_cast<unsigned int>(stream->m_format.m_streamInfo.GetDuration()) == 0)
+    refused = "its frames have no length";
+  else if (!PTPAUSE::FrozenFor(stream->m_rawClockRead, std::chrono::steady_clock::now(),
+                               stream->m_pClock->GetClock()))
+    refused = "the engine has no recent reading of the video clock";
+  const std::string type = CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type);
+  if (refused)
+  {
+    CLog::Log(LOGINFO,
+              "ActiveAE - the passthrough stream ({}) is paused as before, what the output had not "
+              "played let go: {}",
+              type, refused);
+    return false;
+  }
+
+  // the averages of the sync, as they are at the pause
+  const auto averageLeft = stream->m_syncError.GetTimeLeft();
+  unsigned int before;
+  const double lastError = stream->m_syncError.GetLastError(before);
+  double soFar;
+  const bool measured =
+      state == CAESyncInfo::AESyncState::SYNC_MUTE && stream->m_syncError.GetSoFar(soFar);
+
+  // what the sink had not written, then what the engine had for it after that, in this order
+  AEDelayStatus device;
+  std::deque<CSampleBuffer*> unwritten;
+  const bool sinkHeld = SinkHold(device, unwritten);
+  if (m_sinkBuffers)
+  {
+    for (auto* buffers : {&m_sinkBuffers->m_outputSamples, &m_sinkBuffers->m_inputSamples})
+    {
+      unwritten.insert(unwritten.end(), buffers->begin(), buffers->end());
+      buffers->clear();
+    }
+    m_sinkBuffers->Flush();
+  }
+  m_stats.Reset(m_sinkFormat.m_sampleRate, m_mode == MODE_PCM);
+
+  const auto releaseAll = [&unwritten]()
+  {
+    for (CSampleBuffer* buffer : unwritten)
+      buffer->Return();
+    unwritten.clear();
+  };
+  if (!sinkHeld)
+  {
+    releaseAll();
+    CLog::Log(LOGWARNING,
+              "ActiveAE - the passthrough stream ({}) is paused as before: the output did not give "
+              "back what it had not played",
+              type);
+    return true;
+  }
+
+  // copies of the packets and pauses, in their order; the packets go back to the pool of the stream
+  // (or to the pool of the copies of a pause before, still going out) as a flush has them, so that
+  // the player feeds it as before
+  const auto ofStream = [stream](const CSampleBuffer* buffer)
+  {
+    if (buffer->pool == stream->m_inputBuffers.get())
+      return true;
+    return std::any_of(stream->m_rawCopyPools.begin(), stream->m_rawCopyPools.end(),
+                       [buffer](const auto& pool) { return buffer->pool == pool.get(); });
+  };
+  std::deque<CSampleBuffer*> kept;
+  bool unknown = false;
+  for (CSampleBuffer* buffer : unwritten)
+  {
+    const PTPAUSE::Kept what = PTPAUSE::Classify(
+        ofStream(buffer), m_silenceBuffers && buffer->pool == m_silenceBuffers.get(),
+        buffer->pkt->nb_samples, buffer->pkt->pause_burst_ms);
+    if (what == PTPAUSE::Kept::UNKNOWN ||
+        buffer->pkt->nb_samples > static_cast<int>(stream->m_inputBuffers->m_format.m_frames))
+      unknown = true;
+    else if (what != PTPAUSE::Kept::NOTHING)
+      kept.push_back(buffer);
+  }
+  if (unknown)
+  {
+    releaseAll();
+    CLog::Log(LOGWARNING,
+              "ActiveAE - the passthrough stream ({}) is paused as before: the output gave back a "
+              "packet that is not of the stream",
+              type);
+    return true;
+  }
+
+  CActiveAEStream::RawHold hold;
+  const unsigned int frameMs =
+      static_cast<unsigned int>(stream->m_format.m_streamInfo.GetDuration());
+  CActiveAEBufferPool* pool = nullptr;
+  if (!kept.empty())
+  {
+    auto copies = std::make_unique<CActiveAEBufferPool>(stream->m_inputBuffers->m_format);
+    copies->Create(static_cast<unsigned int>(kept.size()) * frameMs);
+    pool = copies.get();
+    stream->m_rawCopyPools.push_back(std::move(copies));
+  }
+  double soundMs = 0;
+  double pauseMs = 0;
+  unsigned int sounds = 0;
+  for (CSampleBuffer* buffer : kept)
+  {
+    CSampleBuffer* copy = pool->GetFreeBuffer();
+    copy->pkt->nb_samples = buffer->pkt->nb_samples;
+    copy->pkt->pause_burst_ms = buffer->pkt->pause_burst_ms;
+    if (buffer->pkt->nb_samples > 0)
+      memcpy(copy->pkt->data[0], buffer->pkt->data[0], buffer->pkt->nb_samples);
+    // (a pause of the engine has no time of its own: it is not measured)
+    copy->timestamp = ofStream(buffer) ? buffer->timestamp : 0;
+    copy->pkt_start_offset = buffer->pkt_start_offset;
+    copy->centerMixLevel = buffer->centerMixLevel;
+    hold.packets.push_back(copy);
+    if (buffer->pkt->nb_samples > 0)
+    {
+      soundMs += stream->m_format.m_streamInfo.GetDuration();
+      sounds++;
+    }
+    else
+      pauseMs += buffer->pkt->pause_burst_ms;
+  }
+  releaseAll();
+  // (the pools of copies that all came back are let go)
+  std::erase_if(stream->m_rawCopyPools, [](const auto& copies)
+                { return copies->m_allSamples.size() == copies->m_freeSamples.size(); });
+
+  // what the device played after the picture stopped: while the pause reached the engine, and all
+  // that it held when the sink answered (it plays out)
+  const auto now = std::chrono::steady_clock::now();
+  const double clockMs = stream->m_pClock->GetClock();
+  const double frozenMs = PTPAUSE::FrozenFor(stream->m_rawClockRead, now, clockMs).value_or(0.0);
+  const double deviceMs = device.GetDelay() * 1000;
+  hold.clockMs = clockMs;
+  hold.heardMs = frozenMs + deviceMs;
+  hold.syncState = state;
+  hold.averageLeft = averageLeft;
+  if (measured)
+    hold.averageSoFar = soFar;
+  hold.at = now;
+  stream->m_rawHold = std::move(hold);
+
+  const double scale{IsTrueHDPassthrough() ? TRUEHD_SYNC_ERROR_SCALE : 1.0};
+  CLog::Log(LOGINFO,
+            "ActiveAE - the passthrough stream ({}) is paused: {} packets ({:.0f} ms of sound) and "
+            "{:.0f} ms of pauses that the output had not played are kept for the resume; {:.0f} ms "
+            "play with the picture stopped ({:.0f} in the device, {:.0f} before the pause reached "
+            "the engine); its sync was {} ({:+.0f} ms)",
+            type, sounds, soundMs, pauseMs, frozenMs + deviceMs, deviceMs, frozenMs,
+            state == CAESyncInfo::AESyncState::SYNC_INSYNC   ? "in sync"
+            : state == CAESyncInfo::AESyncState::SYNC_ADJUST ? "being corrected"
+                                                             : "being measured",
+            lastError / scale);
+  return true;
+}
+
+bool CActiveAE::ResumeRawStream(CActiveAEStream* stream)
+{
+  if (!stream->m_rawHold)
+    return false;
+
+  CActiveAEStream::RawHold hold = std::move(*stream->m_rawHold);
+  stream->m_rawHold.reset();
+  const std::string type = CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type);
+  const auto now = std::chrono::steady_clock::now();
+  const auto paused = std::chrono::duration_cast<std::chrono::milliseconds>(now - hold.at);
+
+  const size_t packets = hold.packets.size();
+  const auto letGoFreePools = [stream]()
+  {
+    // (the pools of the copies that all came back are let go)
+    std::erase_if(stream->m_rawCopyPools, [](const auto& copies)
+                  { return copies->m_allSamples.size() == copies->m_freeSamples.size(); });
+  };
+
+  const char* again = nullptr;
+  if (m_mode != MODE_RAW || !m_stats.SinkNeedsIecPack() || !m_sinkBuffers)
+    again = "the output is no longer passthrough";
+  else if (m_streams.size() != 1)
+    again = "another stream plays";
+  else if (m_state != AE_TOP_CONFIGURED_PLAY && m_state != AE_TOP_CONFIGURED_IDLE)
+    again = "the output is not open";
+  else if (!stream->m_processingBuffers || !stream->m_pClock)
+    again = "the stream is not playing";
+  if (again)
+  {
+    // the sound kept is what comes next: it goes first, and the sync starts again as at a start,
+    // which measures where it is (the pauses kept are let go)
+    if (m_mode == MODE_RAW && stream->m_processingBuffers)
+    {
+      auto& out = stream->m_processingBuffers->m_outputSamples;
+      auto at = out.begin();
+      for (CSampleBuffer* buffer : hold.packets)
+      {
+        if (buffer->pkt->nb_samples > 0)
+          at = std::next(out.insert(at, buffer));
+        else
+          buffer->Return();
+      }
+    }
+    else
+    {
+      for (CSampleBuffer* buffer : hold.packets)
+        buffer->Return();
+    }
+    letGoFreePools();
+    CLog::Log(LOGINFO,
+              "ActiveAE - the passthrough stream ({}) resumes after {} ms with the sound kept at "
+              "the pause, and its sync starts again as at a start: {}",
+              type, paused.count(), again);
+    return false;
+  }
+
+  // The picture moved this much before the engine heard of the resume: the sound that the device
+  // played after it stopped is what it is ahead now. The sink puts a pause of what is left of it,
+  // less what the device holds then, before the first packet it writes (PTPAUSE::GapMs()).
+  const double clockMs = stream->m_pClock->GetClock();
+  const double movedMs = clockMs - hold.clockMs;
+  SinkResumeGap gap;
+  gap.aheadMs = hold.heardMs - movedMs;
+  gap.at = now;
+  m_sink.m_controlPort.SendOutMessage(CSinkControlProtocol::RESUMEGAP, &gap, sizeof(gap));
+  // Nothing of the stream plays before that: the engine counts the sink to hold at least that much
+  // until it says what it holds, or the measurements of the packets it sends now (all of them at
+  // once for TrueHD) would take a device that the pause let empty for the time to the sound.
+  AEDelayStatus sinkDelay;
+  m_stats.GetDelay(sinkDelay);
+  if (sinkDelay.GetDelay() * 1000 < gap.aheadMs)
+  {
+    sinkDelay.SetDelay(gap.aheadMs / 1000);
+    m_stats.UpdateSinkDelay(sinkDelay, 0);
+  }
+
+  // What the sink had not written goes back to it as it was, in its order: the sync decided it
+  // before the pause, and decides from the packet after it, as it would have.
+  for (CSampleBuffer* buffer : hold.packets)
+  {
+    m_stats.AddSamples(1, m_streams);
+    m_sinkBuffers->m_inputSamples.push_back(buffer);
+  }
+  hold.packets.clear();
+  letGoFreePools();
+
+  // the sync goes on as it was, on averages taken from now (the readings made while the picture
+  // stood still and the engine did not know it yet are left out)
+  stream->m_syncState = hold.syncState;
+  switch (hold.syncState)
+  {
+    case CAESyncInfo::AESyncState::SYNC_INSYNC:
+      // what the player was told stays told
+      stream->m_syncError.Flush(stream->GetErrorInterval());
+      stream->m_lateStartHandedOver = false;
+      break;
+    case CAESyncInfo::AESyncState::SYNC_ADJUST:
+      // the error left to correct stays (m_lastError)
+      stream->m_syncError.SetErrorInterval(100ms);
+      stream->m_rawSilenceWaitSince.reset();
+      stream->m_rawAdjustSince += paused;
+      break;
+    default:
+      // measuring (SYNC_MUTE): the average it had is what it measured; it ends with the first
+      // reading taken from now. Measured on for the rest of its time, it would turn into pauses the
+      // packets that the player fed while paused, which went out only after the measurement without
+      // the pause. With no reading yet, it measures for the rest of its time.
+      if (hold.averageSoFar)
+      {
+        stream->m_syncError.Flush(0ms);
+        stream->m_syncError.Add(*hold.averageSoFar);
+      }
+      else
+        stream->m_syncError.SetErrorInterval(std::max<std::chrono::milliseconds>(
+            hold.averageLeft,
+            std::chrono::milliseconds(
+                2 * static_cast<int>(stream->m_format.m_streamInfo.GetDuration()) + 1)));
+      break;
+  }
+  stream->m_rawClockRead = PTPAUSE::ClockRead{now, clockMs};
+
+  CLog::Log(LOGINFO,
+            "ActiveAE - the passthrough stream ({}) resumes after {} ms where it stopped: the {} "
+            "packets kept at the pause go first, after a pause of what the device played with the "
+            "picture stopped ({:.0f} ms, the picture moved {:.0f} ms before the engine heard of "
+            "the resume), and its sync goes on as it was",
+            type, paused.count(), packets, hold.heardMs, movedMs);
+  return true;
+}
+
+void CActiveAE::DropRawHold(CActiveAEStream* stream, const char* why)
+{
+  // the pools of copies go with the stream's buffers: deleted once the last of them is back, as
+  // those of a stream (ClearDiscardedBuffers())
+  for (auto& copies : stream->m_rawCopyPools)
+    m_discardBufferPools.push_back(std::move(copies));
+  stream->m_rawCopyPools.clear();
+  if (!stream->m_rawHold)
+    return;
+
+  const size_t packets = stream->m_rawHold->packets.size();
+  for (CSampleBuffer* buffer : stream->m_rawHold->packets)
+    buffer->Return();
+  stream->m_rawHold.reset();
+  // the sink sends its silence as after a pause that keeps nothing
+  m_sink.m_controlPort.SendOutMessage(CSinkControlProtocol::HOLDDROPPED);
+  CLog::Log(LOGINFO,
+            "ActiveAE - the {} packets of the passthrough stream ({}) kept at its pause are "
+            "let go: {}",
+            packets, CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), why);
+}
+
 void CActiveAE::ClearDiscardedBuffers()
 {
+  // Hades: the copies that a pause of passthrough kept, once all of them are back (HoldRawStream())
+  for (CActiveAEStream* stream : m_streams)
+    std::erase_if(stream->m_rawCopyPools, [](const auto& copies)
+                  { return copies->m_allSamples.size() == copies->m_freeSamples.size(); });
+
   auto it = m_discardBufferPools.begin();
   while (it != m_discardBufferPools.end())
   {
@@ -2374,7 +2763,11 @@ bool CActiveAE::RunStages()
         double delay = status.GetDelay() * 1000;
         double playingPts = pts - delay;
         double maxError = ((*it)->m_syncState == CAESyncInfo::SYNC_INSYNC) ? 1000 : 5000;
