+
+void CWinSystemGbmGLESContext::AnnouncePlaybackMode(const std::map<std::string, std::string>& info)
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const bool playing = player && player->IsPlayingVideo();
+  // (the announcer is fed while the setting is off too, so that turning it on during a video does
+  // not tell about a video that began long ago: it has decided by then)
+  const bool on = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESPLAYBACKMODE, false);
+  const auto value = [&info](const char* key) {
+    const auto it = info.find(key);
+    return it == info.end() ? std::string() : it->second;
+  };
+  KODI::UTILS::PlaybackModeInfo mode;
+  mode.source = value("hades.src.hdrtype");
+  mode.output = value("hades.out.hdrtype");
+  mode.layers = value("hades.dv.layers");
+  if (const auto* selected = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+      selected && selected->htotal && selected->vtotal)
+    mode.mode = StringUtils::Format(
+        "{}x{} @ {:.3f} Hz", selected->hdisplay, selected->vdisplay,
+        selected->clock * 1000.0 / (static_cast<double>(selected->htotal) * selected->vtotal));
+  const std::string text = m_modeAnnouncer.Update(CTimeUtils::GetFrameTime(), playing, mode);
+  if (text.empty() || !on)
+    return;
+  CLog::Log(LOGINFO, "Playback mode: {}", text);
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Info,
+                                        CGUIUtils::GetHadesString(41103, 32504), text, 5000);
 }
 
 void CWinSystemGbmGLESContext::DVGpuTimerMark(bool begin)
