new file mode 100644
index 0000000..a8b6b6c
--- /dev/null
+++ b/xbmc/utils/test/TestPlaybackMode.cpp
@@ -0,0 +1,97 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "utils/PlaybackMode.h"
+
+#include <gtest/gtest.h>
+
+using namespace KODI::UTILS;
+
+TEST(TestPlaybackMode, Describe)
+{
+  EXPECT_EQ("", DescribePlaybackMode({}));
+  EXPECT_EQ("", DescribePlaybackMode({"hdr10", "", "", "3840x2160 @ 24.000 Hz"}));
+  EXPECT_EQ("HDR10", DescribePlaybackMode({"hdr10", "hdr10", "", ""}));
+  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL \xC2\xB7 3840x2160 @ 23.976 Hz",
+            DescribePlaybackMode({"dolbyvision", "dolbyvision", "FEL", "3840x2160 @ 23.976 Hz"}));
+  EXPECT_EQ("Dolby Vision \xC2\xB7 MEL",
+            DescribePlaybackMode({"dolbyvision", "dolbyvision", "MEL", ""}));
+  // layers that are not an enhancement layer that is used are not told
+  EXPECT_EQ("Dolby Vision", DescribePlaybackMode({"dolbyvision", "dolbyvision", "BL", ""}));
+  EXPECT_EQ("Dolby Vision", DescribePlaybackMode({"dolbyvision", "dolbyvision", "FELGAP", ""}));
+  // converted: the two, and no layers (they belong to Dolby Vision sent as such)
+  EXPECT_EQ("Dolby Vision \xE2\x86\x92 HDR10",
+            DescribePlaybackMode({"dolbyvision", "hdr10", "FEL", ""}));
+  EXPECT_EQ("HDR10 \xE2\x86\x92 Dolby Vision",
+            DescribePlaybackMode({"hdr10", "dolbyvision", "", ""}));
+  EXPECT_EQ("HLG", DescribePlaybackMode({"", "hlg", "", ""}));
+}
+
+TEST(TestPlaybackMode, TellsOnceAfterTheOutputSettles)
+{
+  CPlaybackModeAnnouncer announcer;
+  const PlaybackModeInfo hdr10{"hdr10", "hdr10", "", "3840x2160 @ 23.976 Hz"};
+  uint32_t now = 5000;
+  // nothing known yet
+  EXPECT_EQ("", announcer.Update(now, true, {}));
+  now += 500;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 1000;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 500;
+  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, hdr10));
+  // once
+  now += 500;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  // and again after the playback stopped
+  EXPECT_EQ("", announcer.Update(now, false, {}));
+  now += 100;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 1500;
+  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, hdr10));
+}
+
+TEST(TestPlaybackMode, ATextThatChangesRestartsTheWait)
+{
+  CPlaybackModeAnnouncer announcer;
+  const PlaybackModeInfo hdr10{"dolbyvision", "hdr10", "", ""};
+  const PlaybackModeInfo dv{"dolbyvision", "dolbyvision", "FEL", ""};
+  uint32_t now = 100;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 1400;
+  // the output became Dolby Vision just before the wait was over: the wait starts again
+  EXPECT_EQ("", announcer.Update(now, true, dv));
+  now += 1000;
+  EXPECT_EQ("", announcer.Update(now, true, dv));
+  now += 600;
+  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL", announcer.Update(now, true, dv));
+}
+
+TEST(TestPlaybackMode, GivesUpWhenTheOutputIsNeverKnown)
+{
+  CPlaybackModeAnnouncer announcer;
+  uint32_t now = 0;
+  for (; now < CPlaybackModeAnnouncer::GIVE_UP_MS + 500; now += 500)
+    EXPECT_EQ("", announcer.Update(now, true, {}));
+  // too late to be news: nothing is told for this playback
+  EXPECT_EQ("", announcer.Update(now, true, {"hdr10", "hdr10", "", ""}));
+  now += 5000;
+  EXPECT_EQ("", announcer.Update(now, true, {"hdr10", "hdr10", "", ""}));
+}
+
+TEST(TestPlaybackMode, TheClockMayWrap)
+{
+  CPlaybackModeAnnouncer announcer;
+  const PlaybackModeInfo hdr10{"hdr10", "hdr10", "", ""};
+  uint32_t now = 0xFFFFFE00u;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 1000;
+  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  now += 1000;
+  EXPECT_EQ("HDR10", announcer.Update(now, true, hdr10));
+}
