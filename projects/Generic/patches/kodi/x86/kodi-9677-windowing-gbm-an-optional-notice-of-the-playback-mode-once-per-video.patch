diff --git a/xbmc/utils/PlaybackMode.h b/xbmc/utils/PlaybackMode.h
new file mode 100644
index 0000000..06e2883
--- /dev/null
+++ b/xbmc/utils/PlaybackMode.h
@@ -0,0 +1,122 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace KODI::UTILS
+{
+
+//! What the output says about the video that plays, as the window system publishes it
+//! (hades.src.hdrtype, hades.out.hdrtype, hades.dv.layers, hades.out.mode)
+struct PlaybackModeInfo
+{
+  std::string source; //!< what the video is: dolbyvision, hdr10, hdr10plus, hlg, sdr, or empty
+  std::string output; //!< what the display is sent: the same words, or empty if not known
+  std::string layers; //!< of Dolby Vision sent as such: FEL, MEL, BL, ...
+  std::string mode; //!< the mode of the display, "3840x2160 @ 23.976 Hz", or empty
+};
+
+//! The name of a kind of picture; these are names of formats, the same in every language
+inline std::string PlaybackModeFormatName(const std::string& kind)
+{
+  if (kind == "dolbyvision")
+    return "Dolby Vision";
+  if (kind == "hdr10")
+    return "HDR10";
+  if (kind == "hdr10plus")
+    return "HDR10+";
+  if (kind == "hlg")
+    return "HLG";
+  if (kind == "sdr")
+    return "SDR";
+  return {};
+}
+
+//! \brief One line that says in which mode the video plays: "Dolby Vision · FEL · 3840x2160 @
+//!        23.976 Hz"; "Dolby Vision → HDR10" where a Dolby Vision video is sent as HDR10. Empty
+//!        while the output is not known.
+inline std::string DescribePlaybackMode(const PlaybackModeInfo& info)
+{
+  static const std::string DOT = "\xC2\xB7";
+  static const std::string ARROW = "\xE2\x86\x92";
+  const std::string out = PlaybackModeFormatName(info.output);
+  if (out.empty())
+    return {};
+  const std::string src = PlaybackModeFormatName(info.source);
+  std::string text = !src.empty() && src != out ? src + " " + ARROW + " " + out : out;
+  if (info.output == "dolbyvision" && (info.layers == "FEL" || info.layers == "MEL"))
+    text += " " + DOT + " " + info.layers;
+  if (!info.mode.empty())
+    text += " " + DOT + " " + info.mode;
+  return text;
+}
+
+//! \brief Says once per playback, a little after it has begun, what the mode is.
+//!
+//! The output settles after the start (the display changes its mode, Dolby Vision begins): the
+//! mode is told when the same text has been the output's for SETTLE_MS. It is not told again until
+//! the playback stops, nor if the output stays unknown for GIVE_UP_MS.
+class CPlaybackModeAnnouncer
+{
+public:
+  static constexpr uint32_t SETTLE_MS = 1500;
+  static constexpr uint32_t GIVE_UP_MS = 8000;
+
+  //! \param nowMs a clock in ms that goes forward (may wrap)
+  //! \param playing whether a video plays
+  //! \return the text to show, or empty if there is nothing to show now
+  std::string Update(uint32_t nowMs, bool playing, const PlaybackModeInfo& info)
+  {
+    if (!playing)
+    {
+      m_active = false;
+      m_done = false;
+      return {};
+    }
+    if (m_done)
+      return {};
+    if (!m_active)
+    {
+      m_active = true;
+      m_begin = nowMs;
+      m_known = false;
+    }
+    const std::string text = DescribePlaybackMode(info);
+    if (text.empty())
+    {
+      m_known = false;
+      if (static_cast<uint32_t>(nowMs - m_begin) >= GIVE_UP_MS)
+        m_done = true;
+      return {};
+    }
+    if (!m_known || text != m_lastText)
+    {
+      // a change of what the output is restarts the wait: the text that counts is the last one
+      m_known = true;
+      m_since = nowMs;
+      m_lastText = text;
+    }
+    if (static_cast<uint32_t>(nowMs - m_since) < SETTLE_MS)
+      return {};
+    m_done = true;
+    return text;
+  }
+
+private:
+  bool m_active{false};
+  bool m_done{false};
+  bool m_known{false};
+  uint32_t m_begin{0};
+  uint32_t m_since{0};
+  std::string m_lastText;
+};
+
+} // namespace KODI::UTILS
