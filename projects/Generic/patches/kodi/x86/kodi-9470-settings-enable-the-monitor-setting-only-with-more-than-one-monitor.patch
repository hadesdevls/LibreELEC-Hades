From 2a2b70a88eb0d40d1018987dc226396c52e739ab Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:40:13 +0000
Subject: [PATCH] settings: enable the Monitor setting only with more than one
 monitor

Kodi PR 29073 (open, not merged), taken: the setting was enabled where the
window system can move Kodi to another screen OR there are several monitors,
and every window system says it can, so it was always enabled, also with one
display, where it offers Default and that display and nothing to choose. Now
it is enabled where both hold (AND): with one display it is greyed.

HasMultipleMonitors counts the outputs of GetConnectedOutputs() but Default
(CWinSystemBase::GetPhysicalOutputCount()); on GBM those are the connected
outputs of every graphics card, as the setting lists them (the device in use as
the kernel knows it now, the others as they were when it was chosen).
---
 system/settings/settings.xml | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 5ada752..d76aff2 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -2959,10 +2959,11 @@
           </constraints>
           <dependencies>
             <dependency type="enable">
-              <or>
+              <!-- Hades: AND, as Kodi PR 29073 has it: with one monitor there is nothing to choose -->
+              <and>
                 <condition on="property" name="SupportsScreenMove" />
                 <condition on="property" name="HasMultipleMonitors" />
-              </or>
+              </and>
             </dependency>
             <dependency type="update" setting="videoscreen.screenmode" />
           </dependencies>
-- 
2.53.0

