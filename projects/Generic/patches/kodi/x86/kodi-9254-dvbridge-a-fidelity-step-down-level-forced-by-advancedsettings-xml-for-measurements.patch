@@ -1725,6 +1787,9 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
     m_dvStats.gpuFrames++;
     m_dvStats.gpuSumMs += ms;
     m_dvStats.gpuMaxMs = std::max(m_dvStats.gpuMaxMs, ms);
