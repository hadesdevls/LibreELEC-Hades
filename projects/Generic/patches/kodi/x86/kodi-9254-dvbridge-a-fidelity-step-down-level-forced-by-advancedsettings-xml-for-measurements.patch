+  //! dvbridge_render_set_step()). 0, the faithful picture, until it is set; Reset() keeps it
+  void SetStepLevel(int level) { dvbridge_render_set_step(m_renderer, level); }
+  int StepLevel() const { return dvbridge_render_step(m_renderer); }
   /*!
    * \brief What the work of preparing a frame depends on, from its metadata, before it is prepared
    * \param enhancement the frame comes with a picture of its enhancement layer
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
