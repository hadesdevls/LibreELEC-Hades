diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index fee4181..1fd656b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1235,6 +1235,10 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
     foreseen = CDVFrameLoad::Residual(m_dvPathLoad[layered].Take(layer.width, layer.height, l5[0],
                                                                  l5[1], l5[2], l5[3], residual),
                                       residual && !m_dvResidualLost);
+  // The fidelity step-down level of this frame: the way of drawing it is chosen, and its time
+  // measured, with it
+  m_dvStepLevel = DVStepLevel();
+  m_dvBridge->SetStepLevel(m_dvStepLevel);
   DVPathRecall();
   const bool direct = m_dvPath[layered].Direct(foreseen);
   m_dvFrame = m_dvBridge->PrepareHardware(layer, enhancement, metadata, geometry,
@@ -1401,6 +1405,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
   m_dvAheadShown = false;
   m_dvAheadLatencyMs = 0.0f;
   m_dvAheadModeRead = false;
+  m_dvStepRead = false;
   if (m_dvAhead.Ended())
     CLog::Log(LOGWARNING,
               "DVBridge: frames could not be presented a frame ahead in several videos in a row: "
@@ -1432,6 +1437,33 @@ double PQToNits(int code)
   const double e = std::pow(std::clamp(code, 0, 4095) / 4095.0, 1.0 / m2);
   return 10000.0 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1.0 / m1);
 }
+
+// Hades: what a fidelity step-down level changes (dvbridge_render_set_step())
+const char* DVStepWhat(int level)
+{
+  switch (level)
+  {
+    case 0:
+      return "nothing, the faithful picture";
+    case 1:
+      return "the chroma of the base layer is scaled up bilinearly";
+    case 2:
+      return "the chroma of both layers is scaled up bilinearly";
+    default:
+      return "the chroma of both layers and the luma of the enhancement layer are scaled up "
+             "bilinearly";
+  }
+}
+
+// Hades: the fidelity step-down levels of the frames of a period of the log
+std::string DVStepText(int low, int high, bool forced)
+{
+  if (low < 0)
+    return "level (no frame timed)";
+  return (low == high ? StringUtils::Format("level {}", low)
+                      : StringUtils::Format("levels {} to {}", low, high)) +
+         (forced ? " (forced)" : "");
+}
 } // namespace
 
 void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
@@ -1563,6 +1595,31 @@ void CWinSystemGbmGLESContext::DVGpuTimerMark(bool begin)
   }
 }
 
+int CWinSystemGbmGLESContext::DVStepLevel()
+{
+  // To measure on a GPU what each level saves, advancedsettings.xml can force one for every
+  // frame: <video><dvstepdown>N</dvstepdown></video>, N from 0 to 3. Without it the picture is the
+  // faithful one. (Where Kodi is to step down by itself, only on graphics whose frames do not
+  // fit in a refresh, is to be decided with those measurements.)
+  if (!m_dvStepRead)
+  {
+    m_dvStepRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    m_dvStepForced =
+        advanced ? std::clamp(advanced->m_videoDVStepDown, -1, DVBRIDGE_STEP_LEVELS - 1) : -1;
+    if (m_dvStepForced >= 0 && !m_dvStepLogged)
+    {
+      m_dvStepLogged = true;
+      CLog::Log(LOGINFO,
+                "DVBridge: the fidelity step-down of native Dolby Vision frames is forced to "
+                "level {} by advancedsettings.xml (dvstepdown): {}",
+                m_dvStepForced, DVStepWhat(m_dvStepForced));
+    }
+  }
+  return std::max(m_dvStepForced, 0);
+}
