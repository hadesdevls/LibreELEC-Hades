diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 2952cfc..0f88000 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -27,6 +27,7 @@ struct dvbridge_renderer {
      * once it has failed with it and not without it in two frames in a row. */
     bool early_mask, early_off, early_unusable[2];
     unsigned char early_failures[2];
+    int step; /* Hades: dvbridge_render_set_step() */
 };
 
 struct active_mask {
@@ -283,6 +284,21 @@ static void restore_gl_state(const struct saved_gl_state *s)
     }
 }
 
+/* Hades: the upscalers of a step-down level (dvbridge_render_set_step()). Bilinear, not libplacebo's
+ * bicubic: measured, bicubic is further from the faithful picture. The chroma of the base layer is
+ * scaled up with plane_upscaler, and the planes of the enhancement layer would take that one too:
+ * until their own level comes they get the faithful one of their own (libplacebo-9920). */
+static void step_down(struct pl_render_params *params, int level)
+{
+    if (level < 1)
+        return;
+    const struct pl_filter_config *faithful =
+        params->plane_upscaler ? params->plane_upscaler : params->upscaler;
+    params->plane_upscaler = &pl_filter_bilinear;
+    params->el_chroma_upscaler = level >= 2 ? &pl_filter_bilinear : faithful;
+    params->el_luma_upscaler = level >= 3 ? &pl_filter_bilinear : faithful;
+}
+
 static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                         const void *metadata, size_t bytes, double pts, double el_pts,
                         struct dvbridge_geometry geometry, pl_tex packed, bool flip,
@@ -346,6 +362,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     // Own exact PQ-zero borders below. Do not translate an sRGB clear color
     // through the output transfer function or clear a full-raster frame twice.
     params.border = PL_CLEAR_SKIP;
+    step_down(&params, r->step);
     unsigned margins[4];
     if (!dvbridge_active_area(r->pending, margins))
         return false;
@@ -555,6 +572,7 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     params.frame_mixer = NULL;
     params.skip_caching_single_frame = true;
     params.border = PL_CLEAR_SKIP;
+    step_down(&params, r->step);
     bool clamped = false;
     const struct pl_hook hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &clamped,
@@ -632,3 +650,14 @@ void dvbridge_render_allow_early_mask(struct dvbridge_renderer *r, bool allow)
     if (r)
         r->early_off = !allow;
 }
+
+void dvbridge_render_set_step(struct dvbridge_renderer *r, int level)
+{
+    if (r)
+        r->step = level < 0 ? 0 : level >= DVBRIDGE_STEP_LEVELS ? DVBRIDGE_STEP_LEVELS - 1 : level;
+}
+
+int dvbridge_render_step(const struct dvbridge_renderer *r)
+{
+    return r ? r->step : 0;
+}
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 5460c07..5766c9b 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -59,4 +59,20 @@ int dvbridge_render_early_mask(const struct dvbridge_renderer *renderer, bool pa
 /* Hades: whether the area outside the active picture may be written before the reconstruction
  * (the default). Turned off to measure on hardware what it saves, and by the host test. */
 void dvbridge_render_allow_early_mask(struct dvbridge_renderer *renderer, bool allow);
+/* Hades: a step down from the faithful picture, for graphics that cannot draw a frame in the time
+ * of a refresh. The planes that are scaled up to the size of the picture are scaled up bilinearly
+ * (the sampling of the GPU itself) instead of with Lanczos, more of them at each level:
+ *   0: none, the faithful picture (the default);
+ *   1: the chroma of the base layer;
+ *   2: also the chroma of the enhancement layer;
+ *   3: also the luma of the enhancement layer.
+ * Measured on three pictures of a profile 7 FEL stream on a software renderer, against level 0, in
+ * codes of 4095 of the reconstructed PQ picture: levels 1, 2 and 3 change up to 22 %, 48 % and 56 %
+ * of the pixels, most of them by one code, none by more than 7, 10 and 16 codes. Nothing else
+ * changes: the metadata, the transport, the area outside the active picture. For every render of
+ * this renderer after the call, of either kind; a level out of range counts as the nearest one,
+ * and dvbridge_renderer_reset() keeps it. */
+#define DVBRIDGE_STEP_LEVELS 4
+void dvbridge_render_set_step(struct dvbridge_renderer *renderer, int level);
+int dvbridge_render_step(const struct dvbridge_renderer *renderer);
 #endif
