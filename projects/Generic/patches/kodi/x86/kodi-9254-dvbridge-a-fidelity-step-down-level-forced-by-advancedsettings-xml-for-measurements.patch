     XMLUtils::GetBoolean(pElement, "smoothpercenttotimeseeking", m_videoSmoothPercentToTimeSeeking);
     XMLUtils::GetInt(pElement, "timeseekforward", m_videoTimeSeekForward, 0, 6000);
     XMLUtils::GetInt(pElement, "timeseekbackward", m_videoTimeSeekBackward, -6000, 0);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index afc69cd..bc915fa 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -170,6 +170,10 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! Hades: native Dolby Vision frames are presented a frame ahead wherever that can be done,
     //! not only where the GPU needs it (video/dvaheadalways). To try it on a fast GPU
     bool m_videoDVAheadAlways;
+    //! Hades: the fidelity step-down level of native Dolby Vision frames, 0 to 3, forced for every
+    //! frame (video/dvstepdown; dvbridge_render_set_step()). To measure on a GPU what each level
+    //! saves. -1, when it is not there: Kodi chooses, and keeps the faithful picture (0) for now
+    int m_videoDVStepDown;
     bool m_videoSmoothPercentToTimeSeeking;
