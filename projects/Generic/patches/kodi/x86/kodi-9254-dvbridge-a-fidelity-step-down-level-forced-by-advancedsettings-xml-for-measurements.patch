     // Whether frames call for being presented a frame ahead goes by all of them, with GUI
     // elements or without, while the video plays.
     if (timer.playing)
@@ -1734,9 +1799,10 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
       if (change != CDVAhead::Change::NONE && m_dvAheadModeRead &&
           m_dvAheadMode == CDVAhead::Mode::NEEDED)
         CLog::Log(LOGINFO,
