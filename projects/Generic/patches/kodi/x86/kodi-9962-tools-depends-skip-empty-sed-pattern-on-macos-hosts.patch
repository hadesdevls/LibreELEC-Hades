From a576d53c8bbe641e469c5b34dd579a7dd17cf9fe Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 9 Nov 2026 16:30:14 -0800
Subject: [PATCH] [tools/depends] Skip empty sed pattern on macOS hosts

Prevents `sed: first RE may not be empty` when cross-compiling
for WASM or Android, where `platform_includes` is unset.

(cherry picked from commit c96cb2edfcdb058cb6ff15363458ae4170c753b1)
---
 tools/depends/configure.ac | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/depends/configure.ac b/tools/depends/configure.ac
index 50aa0d0..7375cac 100644
--- a/tools/depends/configure.ac
+++ b/tools/depends/configure.ac
@@ -622,7 +622,9 @@ fi
 
 case $build in
   *darwin*)
-    LDFLAGS=$(echo "$LDFLAGS" | sed "s|$platform_includes||")
+    if test -n "$platform_includes"; then
+      LDFLAGS=$(echo "$LDFLAGS" | sed "s|$platform_includes||")
+    fi
 esac
 
 if test "$ac_cv_search_iconv_open" != "none required"; then
-- 
2.53.0

