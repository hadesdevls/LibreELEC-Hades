From 02319c6ef28c506ce2f26fe49b4de1ad53dfc8b9 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:07:06 +0100
Subject: [PATCH] [VideoInfoScanner] Ignore a bluray's backup index.bdmv on
 Windows

A bluray's BDMV folder holds a backup copy of index.bdmv in BDMV/BACKUP,
which is left out of a tv show's episode candidates. It was recognised
by a forward slash only, so on a local Windows path the backup was kept
as a candidate. Where the episode is named by a pattern that can match
anywhere in its path, such as an air date, the disc was then added as
two episodes. Recognise either separator.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3252d3f42b258dae66c92a76e24e25810859e6db)
---
 xbmc/video/VideoInfoScanner.cpp          | 13 +++++++++----
 xbmc/video/test/TestVideoInfoScanner.cpp | 16 ++++++++++++++++
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 7a5e7b4..ff38607 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -1921,6 +1921,13 @@ CVideoInfoScanner::~CVideoInfoScanner()
     // with VIDEO_TS or BDMV can be ignored.
     // THere can be a BACKUP/INDEX.BDMV which needs to be ignored (and broke the old while loop here)
 
+    // A local Windows path is separated by backslashes
+    const auto isBackupIndex = [](const std::string& upperPath)
+    {
+      return upperPath.find("BACKUP/INDEX.BDMV") != std::string::npos ||
+             upperPath.find("BACKUP\\INDEX.BDMV") != std::string::npos;
+    };
+
     // Get folders to remove
     std::vector<std::string> foldersToRemove;
     for (const auto& item : items)
@@ -1928,8 +1935,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
       const std::string file = StringUtils::ToUpper(item->GetPath());
       if (file.find("VIDEO_TS.IFO") != std::string::npos)
         foldersToRemove.emplace_back(StringUtils::ToUpper(URIUtils::GetDirectory(file)));
-      if (file.find("INDEX.BDMV") != std::string::npos &&
-          file.find("BACKUP/INDEX.BDMV") == std::string::npos)
+      if (file.find("INDEX.BDMV") != std::string::npos && !isBackupIndex(file))
         foldersToRemove.emplace_back(
             StringUtils::ToUpper(URIUtils::GetParentPath(URIUtils::GetDirectory(file))));
     }
@@ -1946,8 +1952,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
                                      [&](const std::string& removePath)
                                      { return path.rfind(removePath, 0) == 0; }) > 0) &&
                       file != "VIDEO_TS.IFO" &&
-                      (file != "INDEX.BDMV" ||
-                       fileAndPath.find("BACKUP/INDEX.BDMV") != std::string::npos);
+                      (file != "INDEX.BDMV" || isBackupIndex(fileAndPath));
              });
 
     bool hasEpisodeCandidates = false;
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index c1bec0c..91911c7 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -423,6 +423,22 @@ protected:
 };
 } // namespace
 
+// The backup copy of the index is matched too by a pattern found anywhere in the path, as an air
+// date is
+TEST_F(TestVideoInfoScanner, ABlurayRipOfADatedEpisodeIsOneEpisode)
+{
+  const std::string show{Folder(m_root, "Show")};
+  BlurayRip(Folder(show, "Show.2023-11-05"));
+
+  TestScanner scanner{m_settings};
+  CFileItem item{show, true};
+  EPISODELIST episodes;
+  EXPECT_EQ(TestScanner::EpisodeResult::FOUND_EPISODES,
+            scanner.EnumerateSeriesFolder(&item, episodes));
+
+  EXPECT_EQ(1U, episodes.size());
+}
+
 TEST_F(TestVideoInfoScanner, ACancelledScanDoesNotHideTheSameScanAskedForAgain)
 {
   CVideoLibraryScanningJob cancelled{m_root};
