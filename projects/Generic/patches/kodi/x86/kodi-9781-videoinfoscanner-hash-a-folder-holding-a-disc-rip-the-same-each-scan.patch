From 786f657d74e66ad7b5bf4a1c88aad3e98f89f7fe Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 20:14:48 +0000
Subject: [PATCH] [VideoInfoScanner] Hash a folder holding a disc rip the same
 each scan.

A folder holding a disc rip is listed as its disc until the folder has
a hash of its own, and as a folder once it has, so the hash of the
folder above it changed on the scan after the rip was first found. The
source root holding the rips was looked at again for nothing.

A disc listed from a folder below is now hashed as that folder.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: this tree has master's 0a62df0f35e7 ("Test a bluray folder rip
only with libbluray"), so the new test goes at the start of its
#ifdef HAVE_LIBBLURAY block, where master's b1a740a7 puts it.]
---
 xbmc/video/VideoInfoScanner.cpp          | 29 ++++++++++++++++++++++--
 xbmc/video/test/TestVideoInfoScanner.cpp | 19 ++++++++++++++++
 2 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 3fe722d..9606c30 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -491,10 +491,35 @@ CVideoInfoScanner::~CVideoInfoScanner()
         // sort by filename as always present for any files, but keep case sensitivity
         items.Sort(SortBy::FILE, SortOrder::ASCENDING, SortAttributeNone);
 
+        // A folder holding a disc rip is listed as its disc only until the folder's own hash is
+        // stored, after which it is marked unchanged above and stays a folder. It is hashed as the
+        // folder, so that this folder's hash doesn't change between the two.
+        CFileItemList hashed;
+        for (const auto& item : items)
+        {
+          std::string discFolder;
+          if (!item->IsFolder() && !URIUtils::IsStack(item->GetPath()) &&
+              URIUtils::IsOpticalMediaFile(item->GetPath()))
+          {
+            discFolder = URIUtils::RemoveDiscPath(item->GetPath());
+            URIUtils::AddSlashAtEnd(discFolder);
+          }
+          if (discFolder.empty() || URIUtils::PathEquals(discFolder, strDirectory, true))
+          {
+            hashed.Add(item);
+            continue;
+          }
+          auto folder{std::make_shared<CFileItem>(*item)};
+          folder->SetPath(discFolder);
+          folder->SetFolder(true);
+          hashed.Add(folder);
+        }
+        hashed.Sort(SortBy::FILE, SortOrder::ASCENDING, SortAttributeNone);
+
         // check whether to re-use previously computed fast hash
-        listingHash = !CanFastHash(items, regexps) || fastHash.empty();
+        listingHash = !CanFastHash(hashed, regexps) || fastHash.empty();
         if (listingHash)
-          GetPathHash(items, hash);
+          GetPathHash(hashed, hash);
         else
           hash = fastHash;
       }
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 2445b93..6167af5 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -643,6 +643,25 @@ TEST_F(TestVideoInfoScanner, AFolderStackIsOneMovie)
 }
 
 #ifdef HAVE_LIBBLURAY
+// What a scan makes of a disc rip in a folder depends on whether its folder was scanned before,
+// which the hash of the folder holding it doesn't, so that the next scan doesn't look at it again
+TEST_F(TestVideoInfoScanner, AFolderHoldingADiscRipKeepsItsHash)
+{
+  const std::string folder{Folder(m_root, "Film (2010)")};
+  Nfo(folder, "movie.nfo", "Film");
+  BlurayRip(folder);
+  Scan();
+  ASSERT_EQ(1, CountMovies());
+  std::string first;
+  ASSERT_TRUE(m_db.GetPathHash(m_root, first));
+
+  Scan();
+
+  std::string second;
+  ASSERT_TRUE(m_db.GetPathHash(m_root, second));
+  EXPECT_EQ(first, second);
+}
+
 TEST_F(TestVideoInfoScanner, ABlurayFolderRipIsOneMovie)
 {
   const std::string folder{Folder(m_root, "Film (2010)")};
