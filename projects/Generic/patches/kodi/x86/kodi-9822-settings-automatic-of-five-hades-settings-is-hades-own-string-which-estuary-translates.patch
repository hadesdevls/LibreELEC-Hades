         </constraints>
         <control type="spinner" format="string" />
@@ -4204,7 +4204,7 @@
           <default>0</default>
           <constraints>
             <options>
-              <option label="36058">0</option> <!-- automatic: measured for each picture format -->
+              <option label="39875">0</option> <!-- automatic: measured for each picture format -->
               <option label="39967">1</option> <!-- always direct -->
