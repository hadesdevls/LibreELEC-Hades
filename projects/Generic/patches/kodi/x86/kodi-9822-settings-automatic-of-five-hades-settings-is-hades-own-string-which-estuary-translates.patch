-              <option label="36058">0</option> <!-- automatic: where the GPU cannot keep up -->
+              <option label="39875">0</option> <!-- automatic: where the GPU cannot keep up -->
               <option label="20420">1</option> <!-- never: the faithful picture -->
               <option label="39970">2</option> <!-- level 1 -->
