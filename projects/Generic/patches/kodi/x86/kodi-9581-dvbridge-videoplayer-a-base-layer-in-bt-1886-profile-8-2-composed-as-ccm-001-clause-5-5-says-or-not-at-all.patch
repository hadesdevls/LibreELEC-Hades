   return profile > 0 && !BaseLayerIsNoPicture(profile, compatibility);
 }
 
+/*!
+ * \brief Hades: whether the base layer of a Dolby Vision stream is SDR, in Recommendation ITU-R
+ *        BT.1886: the record of the stream says that its base layer signal compatibility is 2
+ *        (profiles 8.2, 9.2 and 10.2)
+ *
+ * ETSI GS CCM 001 composes such a base layer at 14 bits and converts the picture to SMPTE ST 2084
+ * (clause 5.5); without that, the picture would come out as if the base layer were in PQ. The
+ * bridge has libplacebo compose it so (pl_render_params.dovi_ccm_bl_transfer) or not at all. A
+ * stream whose profile is not known (0) is not taken to be one.
+ */
+constexpr bool BaseLayerIsSdr(int profile, int compatibility)
+{
+  return profile > 0 && compatibility == 2;
+}
