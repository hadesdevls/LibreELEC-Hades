@@ -955,6 +966,8 @@ void CDVBridgeGLES::Warm(const Layer& base,
   if (!m_renderer || !metadata.Data())
     return;
   TakeStaleGLErrors("the ways of drawing are made ready");
+  // (Hades: drawn as the frames will be: a base layer in BT.1886 with clause 5.5)
