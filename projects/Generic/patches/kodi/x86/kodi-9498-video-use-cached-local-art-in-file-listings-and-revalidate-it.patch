From cdcef35f521c8d0fcbe0c1ee35c8605daac1417c Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Wed, 21 Oct 2026 09:15:03 +0200
Subject: [PATCH] [Video] Use cached local art in file listings and revalidate
 it

CVideoThumbLoader::LoadItemCached() only looked up the art cached in
the texture database path table when the item had no art at all. Since
the default icon became art, file listings always have art by the time
the thumb loader starts, so the cache was never used there. Every visit
fell through to LoadItemLookup(), which checks the local art files on
the source one item after the other, and after a restart folder thumbs
show up slowly one by one.

Look up the cached art per missing type for items not in the library.
Items that already have art, like the default icon, only take plain
files, as other code stores wrapped, embedded or remote images for the
same paths. Library items keep the old behaviour.

In LoadItemLookup() look up art that came from the cache again, so a
newly added higher priority file replaces it and a removed file is
forgotten via the new CThumbLoader::ClearCachedImagePath(). When
nothing changed, the item is not touched.
---
 xbmc/ThumbLoader.cpp            |  9 ++++
 xbmc/ThumbLoader.h              |  7 +++
 xbmc/video/VideoThumbLoader.cpp | 95 ++++++++++++++++++++++++---------
 3 files changed, 87 insertions(+), 24 deletions(-)

diff --git a/xbmc/ThumbLoader.cpp b/xbmc/ThumbLoader.cpp
index 6440897..5ed27c2 100644
--- a/xbmc/ThumbLoader.cpp
+++ b/xbmc/ThumbLoader.cpp
@@ -52,6 +52,15 @@ void CThumbLoader::SetCachedImage(const CFileItem &item, const std::string &type
   }
 }
 
+void CThumbLoader::ClearCachedImagePath(const CFileItem& item, const std::string& type)
+{
+  if (!item.GetPath().empty() && m_textureDatabase->Open())
+  {
+    m_textureDatabase->ClearTextureForPath(item.GetPath(), type);
+    m_textureDatabase->Close();
+  }
+}
+
 CProgramThumbLoader::CProgramThumbLoader() = default;
 
 CProgramThumbLoader::~CProgramThumbLoader() = default;
diff --git a/xbmc/ThumbLoader.h b/xbmc/ThumbLoader.h
index c84e1e8..00c99fa 100644
--- a/xbmc/ThumbLoader.h
+++ b/xbmc/ThumbLoader.h
@@ -47,6 +47,13 @@ public:
    */
   virtual void SetCachedImage(const CFileItem &item, const std::string &type, const std::string &image);
 
+  /*! \brief Remove the association of an image with the given item from the texture database.
+   The cached texture of the image itself is kept.
+   \param item CFileItem to remove the association from
+   \param type the type of image
+   */
+  void ClearCachedImagePath(const CFileItem& item, const std::string& type);
+
 protected:
   std::unique_ptr<CTextureDatabase> m_textureDatabase;
 };
diff --git a/xbmc/video/VideoThumbLoader.cpp b/xbmc/video/VideoThumbLoader.cpp
index 68d0969..d624eaa 100644
--- a/xbmc/video/VideoThumbLoader.cpp
+++ b/xbmc/video/VideoThumbLoader.cpp
@@ -110,6 +110,15 @@ const std::map<std::string, std::string> artTypeSettings = {
     {MediaTypeMusicVideo, CSettings::SETTING_VIDEOLIBRARY_MUSICVIDEOART_WHITELIST},
     {MediaTypeVideoVersion, CSettings::SETTING_VIDEOLIBRARY_MOVIEART_WHITELIST},
 };
+
+//! Whether \p art is a plain file path (not a wrapped image:// or remote URL), the kind of art
+//! local art lookup stores. Other code stores wrapped, embedded or remote images for the same paths
+//! in the texture database
+bool IsPlainFileArt(const std::string& art)
+{
+  return !art.empty() && !StringUtils::StartsWith(art, "image://") &&
+         !URIUtils::IsInternetStream(art);
+}
 } // namespace
 
 std::vector<std::string> CVideoThumbLoader::GetArtTypes(const std::string &type)
@@ -210,18 +219,26 @@ bool CVideoThumbLoader::LoadItemCached(CFileItem* pItem)
     }
   }
 
-  // if we have no art, look for it all
-  KODI::ART::Artwork artwork = pItem->GetArt();
-  if (artwork.empty())
+  // look up the art cached in the texture database for the types the item doesn't have yet. Items
+  // not in the library look up each type they lack, as file listings already carry the default
+  // icon as art at this point, and only take plain files unless they have no art at all. Library
+  // items only get it if they have no art at all
+  const bool isLibraryItem = pItem->HasVideoInfoTag() && pItem->GetVideoInfoTag()->m_iDbId > -1 &&
+                             !pItem->GetVideoInfoTag()->m_type.empty();
+  const bool hasNoArt = pItem->GetArt().empty();
+  if (!isLibraryItem || hasNoArt)
   {
-    std::vector<std::string> artTypes = GetArtTypes(pItem->HasVideoInfoTag() ? pItem->GetVideoInfoTag()->m_type : "");
+    std::vector<std::string> artTypes =
+        GetArtTypes(pItem->HasVideoInfoTag() ? pItem->GetVideoInfoTag()->m_type : "");
     if (find(artTypes.begin(), artTypes.end(), "thumb") == artTypes.end())
       artTypes.emplace_back("thumb"); // always look for "thumb" art for files
-    for (std::vector<std::string>::const_iterator i = artTypes.begin(); i != artTypes.end(); ++i)
+    KODI::ART::Artwork artwork;
+    for (const auto& type : artTypes)
     {
-      std::string type = *i;
+      if (pItem->HasArt(type))
+        continue;
       std::string art = GetCachedImage(*pItem, type);
-      if (!art.empty())
+      if (!art.empty() && (hasNoArt || IsPlainFileArt(art)))
         artwork.insert(std::make_pair(type, art));
     }
     pItem->AppendArt(artwork);
@@ -254,40 +271,70 @@ bool CVideoThumbLoader::LoadItemLookup(CFileItem* pItem)
   if (!isLibraryItem || !libraryArtFilled)
   {
     KODI::ART::Artwork artwork = pItem->GetArt();
+    bool artRemoved = false;
     std::vector<std::string> artTypes =
         GetArtTypes(pItem->HasVideoInfoTag() ? pItem->GetVideoInfoTag()->m_type : "");
     if (find(artTypes.begin(), artTypes.end(), "thumb") == artTypes.end())
       artTypes.emplace_back("thumb"); // always look for "thumb" art for files
-    for (std::vector<std::string>::const_iterator i = artTypes.begin(); i != artTypes.end(); ++i)
+    for (const auto& type : artTypes)
     {
-      std::string type = *i;
-      if (!pItem->HasArt(type))
+      // for items not in the library, a plain file equal to the art cached in the texture database
+      // for the item's path is looked up again, so that local art which was replaced or removed
+      // since it was cached is noticed. Any other art the item already has is kept
+      std::string cachedArt;
+      if (pItem->HasArt(type))
       {
-        std::string art = GetLocalArt(*pItem, type, type == "fanart");
-        if (!art.empty()) // cache it
-        {
+        if (isLibraryItem)
+          continue;
+        const std::string itemArt = pItem->GetArt(type);
+        if (!IsPlainFileArt(itemArt))
+          continue;
+        cachedArt = GetCachedImage(*pItem, type);
+        if (cachedArt != itemArt)
+          continue;
+      }
+
+      std::string art = GetLocalArt(*pItem, type, type == "fanart");
+      if (!art.empty()) // cache it, if it changed
+      {
+        if (art != cachedArt)
           SetCachedImage(*pItem, type, art);
-          CServiceBroker::GetTextureCache()->BackgroundCacheImage(art);
+        CServiceBroker::GetTextureCache()->BackgroundCacheImage(art);
+        if (!cachedArt.empty())
+          artwork.insert_or_assign(type, art);
+        else
           artwork.insert(std::make_pair(type, art));
+      }
+      else
+      {
+        // the cached file is gone, so forget it
+        if (!cachedArt.empty() && !CFile::Exists(cachedArt))
+        {
+          CLog::LogF(LOGDEBUG, "cached {} art {} for {} is gone, forgetting it", type,
+                     CURL::GetRedacted(cachedArt), CURL::GetRedacted(pItem->GetPath()));
+          ClearCachedImagePath(*pItem, type);
+          artwork.erase(type);
+          artRemoved = true;
         }
-        else
+
+        // If nothing was found, try embedded art
+        if (pItem->HasVideoInfoTag() && !pItem->GetVideoInfoTag()->m_coverArt.empty())
         {
-          // If nothing was found, try embedded art
-          if (pItem->HasVideoInfoTag() && !pItem->GetVideoInfoTag()->m_coverArt.empty())
+          for (auto& it : pItem->GetVideoInfoTag()->m_coverArt)
           {
-            for (auto& it : pItem->GetVideoInfoTag()->m_coverArt)
+            if (it.m_type == type)
             {
-              if (it.m_type == type)
-              {
-                art = IMAGE_FILES::URLFromFile(pItem->GetPath(), "video_" + type);
-                artwork.insert(std::make_pair(type, art));
-              }
+              art = IMAGE_FILES::URLFromFile(pItem->GetPath(), "video_" + type);
+              artwork.insert(std::make_pair(type, art));
             }
           }
         }
       }
     }
-    pItem->AppendArt(artwork);
+    if (artRemoved)
+      pItem->SetArt(artwork);
+    else
+      pItem->AppendArt(artwork);
   }
 
   // We can only extract flags/thumbs for file-like items
-- 
2.53.0

