From d8fe16a082cd3cddb6105811e44fff19253b0533 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Sun, 11 Oct 2026 13:28:58 +0100
Subject: [PATCH] TextureCacheJob: load an image only as large as the cache
 will keep

The caching job decoded every image at its full source resolution,
bounded only by GL_MAX_TEXTURE_SIZE, although CPicture::CacheTexture()
never writes out more than imageres/fanartres. Every pixel above that
ceiling was decoded, held and scaled only to be thrown away, and with
two caching jobs running at once a folder of camera photos is enough
to exhaust memory on a small device.

Ask for the ceiling instead. Images at or below it are unaffected,
since LoadIImage() never scales up.

ResizeTexture(), used by the HTTP image transformation handler, still
loads at full size, as it is asked for client supplied dimensions.

Clamp the loaded size to at least 1x1, as rounding can otherwise give
an extremely wide or tall image a zero dimension and fail the load.
---
 xbmc/TextureCacheJob.cpp | 26 +++++++++++++++++++-------
 xbmc/TextureCacheJob.h   |  6 +++++-
 xbmc/guilib/Texture.cpp  |  3 +++
 3 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/xbmc/TextureCacheJob.cpp b/xbmc/TextureCacheJob.cpp
index b4a1760..212d777 100644
--- a/xbmc/TextureCacheJob.cpp
+++ b/xbmc/TextureCacheJob.cpp
@@ -20,11 +20,14 @@
 #include "imagefiles/ImageFileURL.h"
 #include "imagefiles/SpecialImageLoaderFactory.h"
 #include "pictures/Picture.h"
+#include "settings/AdvancedSettings.h"
+#include "settings/SettingsComponent.h"
 #include "utils/Mime.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
+#include <algorithm>
 #include <cstring>
 
 #include "PlatformDefs.h"
@@ -119,7 +122,14 @@ bool CTextureCacheJob::CacheTexture()
     }
   }
 
-  std::unique_ptr<CTexture> texture = LoadImage(imageURL);
+  // CPicture::CacheTexture() will not write out more than imageres/fanartres, so decoding or
+  // holding anything above that ceiling is memory spent on pixels that are discarded
+  const auto advancedSettings = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings();
+  const unsigned int maxHeight =
+      std::max(advancedSettings->m_imageRes, advancedSettings->m_fanartRes);
+  const unsigned int maxWidth = maxHeight * 16 / 9;
+
+  std::unique_ptr<CTexture> texture = LoadImage(imageURL, maxWidth, maxHeight);
   if (texture)
   {
     if (texture->HasAlpha())
@@ -159,7 +169,7 @@ bool CTextureCacheJob::ResizeTexture(const std::string& url,
   if (image.empty())
     return false;
 
-  std::unique_ptr<CTexture> texture = LoadImage(imageURL);
+  std::unique_ptr<CTexture> texture = LoadImage(imageURL, 0, 0);
   if (texture == NULL)
     return false;
 
@@ -175,7 +185,9 @@ bool CTextureCacheJob::MayBeAnImage(const std::string& mimeType)
          StringUtils::EqualsNoCase(mimeType, "application/octet-stream");
 }
 
-std::unique_ptr<CTexture> CTextureCacheJob::LoadImage(const IMAGE_FILES::CImageFileURL& imageURL)
+std::unique_ptr<CTexture> CTextureCacheJob::LoadImage(const IMAGE_FILES::CImageFileURL& imageURL,
+                                                      unsigned int maxWidth,
+                                                      unsigned int maxHeight)
 {
   if (imageURL.IsSpecialImage())
   {
@@ -200,8 +212,8 @@ std::unique_ptr<CTexture> CTextureCacheJob::LoadImage(const IMAGE_FILES::CImageF
     return {};
   }
 
-  auto texture = CTexture::LoadFromFile(imageURL.GetTargetFile(), 0, 0, CAspectRatio::CENTER,
-                                        file.GetMimeType());
+  auto texture = CTexture::LoadFromFile(imageURL.GetTargetFile(), maxWidth, maxHeight,
+                                        CAspectRatio::KEEP, file.GetMimeType());
   if (!texture && !namedType.empty())
   {
     // The extension named a type that couldn't be read, so the source may be serving another and
@@ -211,8 +223,8 @@ std::unique_ptr<CTexture> CTextureCacheJob::LoadImage(const IMAGE_FILES::CImageF
     file.FillInMimeType();
     if (MayBeAnImage(file.GetMimeType()))
     {
-      texture = CTexture::LoadFromFile(imageURL.GetTargetFile(), 0, 0, CAspectRatio::CENTER,
-                                       file.GetMimeType());
+      texture = CTexture::LoadFromFile(imageURL.GetTargetFile(), maxWidth, maxHeight,
+                                       CAspectRatio::KEEP, file.GetMimeType());
     }
   }
   if (!texture)
diff --git a/xbmc/TextureCacheJob.h b/xbmc/TextureCacheJob.h
index fc0c8c2..5937a94 100644
--- a/xbmc/TextureCacheJob.h
+++ b/xbmc/TextureCacheJob.h
@@ -140,9 +140,13 @@ private:
    or smaller than the desired size for speed reasons.
 
    \param image the URL of the image file.
+   \param maxWidth the maximum width to load the image at, 0 for no limit.
+   \param maxHeight the maximum height to load the image at, 0 for no limit.
    \return a pointer to a CTexture object, NULL if failed.
    */
-  static std::unique_ptr<CTexture> LoadImage(const IMAGE_FILES::CImageFileURL& imageURL);
+  static std::unique_ptr<CTexture> LoadImage(const IMAGE_FILES::CImageFileURL& imageURL,
+                                             unsigned int maxWidth,
+                                             unsigned int maxHeight);
 
   std::string    m_cachePath;
 };
diff --git a/xbmc/guilib/Texture.cpp b/xbmc/guilib/Texture.cpp
index fc9d1b1..b92c8b6 100644
--- a/xbmc/guilib/Texture.cpp
+++ b/xbmc/guilib/Texture.cpp
@@ -308,6 +308,9 @@ bool CTexture::LoadIImage(IImage* pImage,
     }
   }
 
+  width = std::max(width, 1u);
+  height = std::max(height, 1u);
+
   // align all textures so that they have an even width
   // in some circumstances when we downsize a thumbnail
   // which has an uneven number of pixels in width
-- 
2.53.0

