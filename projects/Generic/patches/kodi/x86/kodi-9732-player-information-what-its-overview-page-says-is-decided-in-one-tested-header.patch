+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+/*!
+ * \file
+ * \brief What the player information of Hades decides before it shows it (the overview page, the
+ *        badges, the speaker layout, the table of the metadata levels, the values that just
+ *        changed). Nothing of Kodi is here: a test runs it on the host.
+ *
+ * The skin draws what this says. It does not decide (a skin cannot test a list of conditions by
+ * severity without evaluating all of them on every frame), and a decision made here is the same
+ * in every skin and can be tested in both directions.
+ */
+namespace KODI
+{
+namespace UTILS
+{
+namespace PLAYERINFO
+{
+
+//! The three states of the sentence at the top of the overview page; the skin draws a symbol and
+//! the sentence, never a colour alone: a tick, an "i" and an exclamation mark
+enum class Severity
+{
+  OK, //!< it works as intended
+  NOTE, //!< worth knowing, nothing is lost
+  WARN, //!< not as it was meant to be
+};
+
+inline const char* SeverityName(Severity severity)
+{
+  switch (severity)
+  {
+    case Severity::OK:
+      return "ok";
+    case Severity::NOTE:
+      return "note";
+    case Severity::WARN:
+      return "warn";
+  }
+  return "";
+}
+
+//! What is known of the playback when the sentence is decided; every field is "not so" or empty
+//! where it is not known, and the sentence then says nothing about it
+struct SummaryInput
+{
+  bool video = false; //!< a video is playing
+  //! hades.src.hdrtype: what the file is: dolbyvision, hdr10, hdr10plus, hlg, or empty (SDR)
+  std::string source;
+  //! hades.dv.state: native, hdr10 (Dolby Vision rebuilt as HDR10), sdr, or empty
+  std::string dvState;
+  //! hades.dv.reason: why a Dolby Vision video is not native (empty when it is, or when not known)
+  std::string dvReason;
+  //! hades.out.signal: what the display is told: dv, hdr10plus, pq, hlg, hdrgamma, sdr, or empty
+  //! (the connector does not say)
+  std::string signal;
+  //! why the display is not told that an HDR video is HDR (CHDRSignal::Reason, as a code): noprop,
+  //! noedid, nostatic, noeotf, noblob, notqueued; empty when it is, or when the video is not HDR
+  std::string hdrNotSent;
+  int failed = 0; //!< pictures of the last 10 s that were not shown (native Dolby Vision)
+  int stepLevel = 0; //!< the level of simplification of the drawing of native Dolby Vision
+  bool felGap = false; //!< the enhancement layer is catching up after a seek
+  //! the display rate against the video's (FitRate(): exact, multiple, near, mismatch), or empty
+  std::string rateFit;
+  std::string audioWhy; //!< hades.audio.why: why the sound is decoded where it could be passed
+};
+
+//! One thing worth saying about the playback
+struct Note
+{
+  Severity severity = Severity::OK;
+  std::string code; //!< dv_not_native, hdr_to_sdr, hdr_not_sent, frames_failed, step_down,
+                    //!< fel_resync, rate_mismatch, audio_decoded, unknown_output
+  std::string arg; //!< the reason, or the number, that the sentence has in it
+  std::string todo; //!< what to do about it: tv, mode, choice, rate, hdr, sync, system; or empty
+};
+
+//! The sentence of the overview page
+struct Summary
+{
+  Severity state = Severity::OK; //!< hades.sum.state
+  std::string code = "ok"; //!< hades.sum.code
+  std::string arg; //!< hades.sum.arg
+  std::string todo; //!< hades.sum.todo
+  int more = 0; //!< hades.sum.more: the other things worth saying
+  std::string head; //!< hades.sum.head: the heading
+};
+
+/*!
+ * \brief What to do about a reason that a Dolby Vision video is not sent as Dolby Vision, in one
+ *        of a few kinds: the TV input (tv), the output mode (mode), a choice that was made (choice)
+ *        or nothing that a person does here (empty)
+ */
+inline std::string TodoForReason(const std::string& reason)
+{
+  static const std::set<std::string> tv{"display", "lloff", "legacy", "invalid", "edid",
+                                        "driveredid", "sink", "converter", "frl"};
+  static const std::set<std::string> mode{"mode", "refresh", "rate", "nomode", "noratemode", "link"};
+  static const std::set<std::string> choice{"settings", "choice", "dualhdr", "view"};
+  if (tv.count(reason))
+    return "tv";
+  if (mode.count(reason))
+    return "mode";
+  if (choice.count(reason))
+    return "choice";
+  return "";
+}
+
+/*!
+ * \brief The heading of the overview page: what the display is told, and, where it is not what
+ *        the file is, that it is not
+ * \return dv, dv_hdr10, dv_sdr, hdr10plus, hdr10, hlg, sdr, hdr_lost (an HDR file whose display is
+ *         told it is not HDR), or empty (not known)
+ */
+inline std::string HeadCode(const SummaryInput& in)
+{
+  if (!in.video)
+    return "";
+  if (in.dvState == "native" || in.signal == "dv")
+    return "dv";
+  if (in.source == "dolbyvision" && in.dvState == "hdr10")
+    return "dv_hdr10";
+  if (in.source == "dolbyvision" && in.dvState == "sdr")
+    return "dv_sdr";
+  const bool hdr = in.source == "hdr10" || in.source == "hdr10plus" || in.source == "hlg" ||
+                   in.source == "dolbyvision";
+  if (in.signal == "hdr10plus")
+    return "hdr10plus";
+  if (in.signal == "pq")
+    return in.source == "hdr10plus" ? "hdr10plus" : "hdr10";
+  if (in.signal == "hlg")
+    return "hlg";
+  // an HDR file and an output that says SDR: the display is not told
+  if (in.signal == "sdr")
+    return hdr ? "hdr_lost" : in.source.empty() ? "" : "sdr";
+  // the connector does not say what it is told: an SDR file is SDR whatever it says
+  if (in.signal.empty() && in.source == "sdr")
+    return "sdr";
+  return "";
+}
+
+/*!
+ * \brief Everything that is worth saying, most serious first, and in the order of the table of the
+ *        overview page within a severity
+ */
+inline std::vector<Note> Notes(const SummaryInput& in)
+{
+  std::vector<Note> warn, note;
+  if (!in.video)
+    return {};
+  const bool dv = in.source == "dolbyvision";
+  // Dolby Vision that is not sent as Dolby Vision
+  if (dv && in.dvState == "sdr")
+    warn.push_back({Severity::WARN, "hdr_to_sdr", "", ""});
+  else if (dv && in.dvState != "native" && in.signal != "dv")
+    warn.push_back({Severity::WARN, "dv_not_native", in.dvReason, TodoForReason(in.dvReason)});
+  // an HDR video whose display is not told it is HDR
+  if (!in.hdrNotSent.empty())
+    warn.push_back({Severity::WARN, "hdr_not_sent", in.hdrNotSent, "hdr"});
+  if (in.failed > 0)
+    warn.push_back({Severity::WARN, "frames_failed", std::to_string(in.failed), "system"});
+  if (in.stepLevel > 0)
+    warn.push_back({Severity::WARN, "step_down", std::to_string(in.stepLevel), "system"});
+  if (in.rateFit == "mismatch")
+    warn.push_back({Severity::WARN, "rate_mismatch", "", "rate"});
+  if (in.felGap)
+    note.push_back({Severity::NOTE, "fel_resync", "", ""});
+  if (!in.audioWhy.empty())
+    note.push_back({Severity::NOTE, "audio_decoded", in.audioWhy,
+                    in.audioWhy == "syncdisplay" ? "sync" : ""});
+  // what the display is told could not be read (the connector has no such property): the page
+  // says so, for a video that is not a plain SDR one
+  const bool hdr = dv || in.source == "hdr10" || in.source == "hdr10plus" || in.source == "hlg";
+  if (in.signal.empty() && hdr && in.dvState != "native" && in.hdrNotSent.empty())
+    note.push_back({Severity::NOTE, "unknown_output", "", ""});
+  warn.insert(warn.end(), note.begin(), note.end());
+  return warn;
+}
+
+//! The sentence: the first of the notes, and how many others there are
+inline Summary Decide(const SummaryInput& in)
+{
+  Summary summary;
+  summary.head = HeadCode(in);
+  const std::vector<Note> notes = Notes(in);
+  if (notes.empty())
+    return summary;
+  summary.state = notes.front().severity;
+  summary.code = notes.front().code;
+  summary.arg = notes.front().arg;
+  summary.todo = notes.front().todo;
+  summary.more = static_cast<int>(notes.size()) - 1;
+  return summary;
+}
+
+/*!
+ * \brief How the rate of the display fits the video's
+ * \return exact (the same), multiple (a whole number of times, as 120 Hz for 24 fps), near (within
+ *         1.5 % of one or of a multiple of it: 23.976 fps at 24 Hz is not a judder anyone sees),
+ *         mismatch (anything else: 24 fps at 60 Hz), or empty where either is not known
+ */
+inline std::string FitRate(double hz, double fps)
+{
+  if (!(hz > 1.0) || !(fps > 1.0) || hz > 1000.0 || fps > 1000.0)
+    return "";
+  const double ratio = hz / fps;
+  const double k = std::max(1.0, std::round(ratio));
+  const double off = std::fabs(ratio - k) / k;
+  if (off < 0.00005)
+    return k == 1.0 ? "exact" : "multiple";
+  if (off < 0.015)
+    return "near";
+  return "mismatch";
+}
+
+// ---- the badges
+
+//! "Dolby Vision · FEL", "Dolby Vision · P8.1", "HDR10+", "HDR10", "HLG", "SDR"
+inline std::string VideoBadge(const std::string& hdrType,
+                              bool hdr10plus,
+                              int dvProfile,
+                              int dvCompat,
+                              const std::string& layers)
+{
+  if (hdrType == "dolbyvision")
+  {
+    std::string detail;
+    if (dvProfile == 7)
+    {
+      if (layers == "FEL" || layers == "FELGAP")
+        detail = "FEL";
+      else if (layers == "MEL" || layers == "MELSKIP")
+        detail = "MEL";
+      else
+        detail = "P7";
+    }
+    else if (dvProfile > 0)
+    {
+      detail = "P" + std::to_string(dvProfile);
+      if (dvProfile == 8 && dvCompat > 0)
+        detail += "." + std::to_string(dvCompat);
+    }
+    return detail.empty() ? "Dolby Vision" : "Dolby Vision \xc2\xb7 " + detail; // ·
+  }
+  if (hdrType == "hdr10plus" || (hdrType == "hdr10" && hdr10plus))
+    return "HDR10+";
+  if (hdrType == "hdr10")
+    return "HDR10";
+  if (hdrType == "hlg")
+    return "HLG";
+  return "SDR";
+}
+
+//! The name of the layout of so many channels, as the sound of a film is called
+inline std::string ChannelsName(int channels)
+{
+  switch (channels)
+  {
+    case 1:
+      return "1.0";
+    case 2:
+      return "2.0";
+    case 3:
+      return "2.1";
+    case 4:
+      return "4.0";
+    case 5:
+      return "5.0";
+    case 6:
+      return "5.1";
+    case 7:
+      return "6.1";
+    case 8:
+      return "7.1";
+    default:
+      return channels > 0 ? std::to_string(channels) + " ch" : "";
+  }
+}
+
+/*!
+ * \brief "TrueHD Atmos 7.1.2", "DTS-HD MA 5.1", "Dolby Digital+ 5.1"
+ * \param codec the codec of the stream as VideoPlayer.AudioCodec has it (truehd_atmos, ...)
+ * \param bed the layout of the bed of an object-based stream (7.1.2), or empty
+ * \param channels the channels of the stream, where it has no bed
+ */
+inline std::string AudioBadge(const std::string& codec, const std::string& bed, int channels)
+{
+  static const std::map<std::string, std::string> names{
+      {"truehd_atmos", "TrueHD Atmos"}, {"truehd", "Dolby TrueHD"},
+      {"eac3_ddp_atmos", "DD+ Atmos"},  {"eac3", "Dolby Digital+"},
+      {"ac3", "Dolby Digital"},         {"dtshd_ma_x", "DTS:X"},
+      {"dtshd_ma_x_imax", "DTS:X"},     {"dtshd_ma", "DTS-HD MA"},
+      {"dtshd_hra", "DTS-HD HRA"},      {"dtshd", "DTS-HD"},
+      {"dts", "DTS"},                   {"mlp", "MLP"},
+      {"aac", "AAC"},                   {"flac", "FLAC"},
+      {"opus", "Opus"},                 {"vorbis", "Vorbis"},
+      {"mp3", "MP3"},                   {"alac", "ALAC"},
+  };
+  if (codec.empty())
+    return "";
+  std::string name;
+  const auto it = names.find(codec);
+  if (it != names.end())
+    name = it->second;
+  else if (codec.compare(0, 4, "pcm_") == 0 || codec == "pcm")
+    name = "PCM";
+  else
+  {
+    name = codec;
+    for (auto& c : name)
+      c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  }
+  const std::string layout = !bed.empty() ? bed : ChannelsName(channels);
+  return layout.empty() ? name : name + " " + layout;
+}
+
+// ---- the speakers
+
+/*!
+ * \brief The speakers that a layout lights, as ",FL,FR,FC,LFE,SL,SR,TFL,TFR," (a comma at each
+ *        end, so that a skin tests one name as ",FL," and not as the end of another)
+ * \param channels the channel names of Kodi's audio engine, as Player.Process(audiochannels) has
+ *        them ("FL,FR,FC,LFE,BL,BR"), in any separator
+ * \param bed the bed of an object-based stream ("7.1.2"); where it is given it says what is lit
+ *        (a bed of Dolby Atmos is not the channels of its core)
+ */
+inline std::string Speakers(const std::string& channels, const std::string& bed)
+{
+  std::set<std::string> lit;
+  int main = 0, lfe = 0, top = 0;
+  if (!bed.empty() && std::sscanf(bed.c_str(), "%d.%d.%d", &main, &lfe, &top) >= 2 && main > 0)
+  {
+    // the bed of Dolby Atmos: the front pair, the centre, the sides, the backs; the height
+    // speakers in pairs from the front
+    if (main == 1)
+      lit.insert("FC");
+    if (main >= 2)
+    {
+      lit.insert("FL");
+      lit.insert("FR");
+    }
+    if (main >= 3)
+      lit.insert("FC");
+    if (main == 4)
+    {
+      lit.insert("BL");
+      lit.insert("BR");
+    }
+    if (main >= 5)
+    {
+      lit.insert("SL");
+      lit.insert("SR");
+    }
+    if (main >= 7)
+    {
+      lit.insert("BL");
+      lit.insert("BR");
+    }
+    if (lfe > 0)
+      lit.insert("LFE");
+    if (top >= 2)
+    {
+      lit.insert("TFL");
+      lit.insert("TFR");
+    }
+    if (top >= 4)
+    {
+      lit.insert("TBL");
+      lit.insert("TBR");
+    }
+  }
+  else
+  {
+    static const std::set<std::string> known{"FL",  "FR",  "FC",  "LFE", "BL",  "BR",  "FLOC",
+                                             "FROC", "BC",  "SL",  "SR",  "TFL", "TFR", "TFC",
+                                             "TC",  "TBL", "TBR", "TBC"};
+    std::string token;
+    const auto flush = [&]() {
+      if (known.count(token))
+        lit.insert(token);
+      token.clear();
+    };
+    for (const char c : channels)
+    {
+      if (std::isalnum(static_cast<unsigned char>(c)))
+        token += static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+      else
+        flush();
+    }
+    flush();
+  }
+  if (lit.empty())
+    return "";
+  std::string out = ",";
+  for (const auto& name : lit)
+    out += name + ",";
+  return out;
+}
+
+// ---- what the picture says of its colour
+
+//! The primaries of a picture by their number (ISO/IEC 23091-2, as FFmpeg's AVCOL_PRI_*)
+inline std::string PrimariesText(int primaries)
+{
+  switch (primaries)
+  {
+    case 1:
+      return "BT.709";
+    case 4:
+      return "BT.470 M";
+    case 5:
+      return "BT.601 (PAL)";
+    case 6:
+      return "BT.601 (NTSC)";
+    case 7:
+      return "SMPTE 240M";
+    case 8:
+      return "Film";
+    case 9:
+      return "BT.2020";
+    case 10:
+      return "XYZ";
+    case 11:
+      return "DCI-P3";
+    case 12:
+      return "P3-D65";
+    case 22:
+      return "EBU 3213";
+    default:
+      return "";
+  }
+}
+
+//! The transfer function by its number (AVCOL_TRC_*)
+inline std::string TransferText(int transfer)
+{
+  switch (transfer)
+  {
+    case 1:
+    case 6:
+    case 14:
+    case 15:
+      return "BT.709/BT.1886";
+    case 4:
+      return "gamma 2.2";
+    case 5:
+      return "gamma 2.8";
+    case 7:
+      return "SMPTE 240M";
+    case 8:
+      return "linear";
+    case 13:
+      return "sRGB";
+    case 16:
+      return "PQ";
+    case 17:
+      return "DCI gamma 2.6";
+    case 18:
+      return "HLG";
+    default:
+      return "";
+  }
+}
+
+//! The matrix by its number (AVCOL_SPC_*)
+inline std::string MatrixText(int matrix)
+{
+  switch (matrix)
+  {
+    case 0:
+      return "RGB";
+    case 1:
+      return "BT.709";
+    case 5:
+    case 6:
+      return "BT.601";
+    case 7:
+      return "SMPTE 240M";
+    case 9:
+      return "BT.2020 NCL";
+    case 10:
+      return "BT.2020 CL";
+    case 14:
+      return "ICtCp";
+    default:
+      return "";
+  }
+}
+
+/*!
+ * \brief "BT.2020 · PQ · limited range": what the decoder gives the renderer
+ * \param primariesAssumed the stream did not say its primaries and Kodi chose them by the size of
+ *        the picture (DVDVideoCodecFFmpeg.cpp): then "(assumed)" follows them. A part that the
+ *        stream does not give and Kodi does not choose is "not given".
+ */
+inline std::string ColourText(int primaries, int transfer, bool fullRange, bool primariesAssumed)
+{
+  const std::string p = PrimariesText(primaries);
+  const std::string t = TransferText(transfer);
+  std::string out = p.empty() ? "not given" : p + (primariesAssumed ? " (assumed)" : "");
+  out += " \xc2\xb7 " + (t.empty() ? std::string("not given") : t);
+  out += fullRange ? " \xc2\xb7 full range" : " \xc2\xb7 limited range";
+  return out;
+}
+
+/*!
+ * \brief The name of the primaries that CIE xy coordinates are (red, green, blue), where they are
+ *        those of BT.709, P3-D65 or BT.2020 within 0.003; "custom" for others
+ */
+inline std::string PrimariesName(double rx, double ry, double gx, double gy, double bx, double by)
+{
+  struct Set
+  {
+    const char* name;
+    double v[6];
+  };
+  static const Set sets[] = {
+      {"BT.709", {0.640, 0.330, 0.300, 0.600, 0.150, 0.060}},
+      {"P3-D65", {0.680, 0.320, 0.265, 0.690, 0.150, 0.060}},
+      {"BT.2020", {0.708, 0.292, 0.170, 0.797, 0.131, 0.046}},
+  };
+  const double given[6] = {rx, ry, gx, gy, bx, by};
+  for (const auto& set : sets)
+  {
+    bool same = true;
+    for (int i = 0; i < 6; ++i)
+      same = same && std::fabs(set.v[i] - given[i]) <= 0.003;
+    if (same)
+      return set.name;
+  }
+  return "custom";
+}
+
+/*!
+ * \brief "3840 × 1606 (2.39:1)": the part of a picture that is not bars, from the offsets of the
+ *        level 5 block of its RPU (pixels of the picture, as the RPU gives them); empty where they
+ *        do not fit the picture
+ */
+inline std::string PictureArea(int width, int height, int left, int right, int top, int bottom)
+{
+  if (width <= 0 || height <= 0 || left < 0 || right < 0 || top < 0 || bottom < 0)
+    return "";
+  const int w = width - left - right;
+  const int h = height - top - bottom;
+  if (w <= 0 || h <= 0)
+    return "";
+  char text[64];
+  std::snprintf(text, sizeof(text), "%d \xc3\x97 %d (%.2f:1)", w, h,
+                static_cast<double>(w) / static_cast<double>(h));
+  return text;
+}
+
+// ---- the levels of the Dolby Vision metadata
+
+//! The levels that a stream can carry, in the order of the table
+inline const std::vector<int>& MetadataLevels()
+{
+  static const std::vector<int> levels{1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 254, 255};
+  return levels;
+}
+
+/*!
+ * \brief Whether Hades reads the values of a level and acts on them, and does not only carry its
+ *        bytes. Read from the code (dvbridge_metadata.h, dvbridge_placebo.c):
+ *        native output: L1 (checked, clamped), L2 (checked; not where the settings send no
+ *        trims), L5 (the active area, remade from what is drawn over the bars);
+ *        a picture rebuilt as HDR10 or SDR: L1 and L3 (the content range, with its offsets) and
+ *        L6 (the static values).
+ *        The others (L3, L4, L8, L9, L10, L11, L254 for native output) go to the display as they
+ *        are in the RPU, converted for the tunnel; L255 is the encoder's own data.
+ */
+inline bool LevelUsed(int level, bool native, bool converted, bool trims)
+{
+  if (native)
+    return level == 1 || level == 5 || (level == 2 && trims);
+  if (converted)
+    return level == 1 || level == 3 || level == 6;
+  return false;
+}
+
+/*!
+ * \brief The table of the levels as three lines of text of a monospaced font, a column of five
+ *        characters for each level, "+" where it holds and "-" where it does not
+ * \param file the levels of the extension blocks of the RPU
+ * \param sent the levels of the blocks that the display is sent; sentKnown false where that is not
+ *        known (nothing is shown as sent then)
+ * \return {header, file, used, sent}
+ */
+inline std::vector<std::string> LevelTable(const std::vector<int>& file,
+                                           const std::vector<int>& sent,
+                                           bool sentKnown,
+                                           bool native,
+                                           bool converted,
+                                           bool trims)
+{
+  std::string head, in, used, out;
+  for (const int level : MetadataLevels())
+  {
+    const std::string name = "L" + std::to_string(level);
+    const auto cell = [](const std::string& text) {
+      return text + std::string(text.size() < 5 ? 5 - text.size() : 0, ' ');
+    };
+    const bool inFile = std::find(file.begin(), file.end(), level) != file.end();
+    const bool inSent = sentKnown && std::find(sent.begin(), sent.end(), level) != sent.end();
+    head += cell(name);
+    in += cell(inFile ? "+" : "-");
+    used += cell(inFile && LevelUsed(level, native, converted, trims) ? "+" : "-");
+    out += cell(inSent ? "+" : "-");
+  }
+  return {head, in, used, out};
+}
+
+// ---- the values that just changed
+
+/*!
+ * \brief Which published values changed a moment ago, for the page to show them lit
+ *
+ * A value that goes from one to another (not from nothing, which is the page opening, and not to
+ * nothing) is lit from the publication that shows it for `hold`. The page is published twice a
+ * second, so a value is lit and put out on those beats: with a hold of 750 ms it is lit for
+ * 1000 ms, the first beat at or after the hold. A value that changes again while it is lit stays
+ * lit.
+ */
+class CChangeFlash
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  //! Told when a key is lit (true) or put out (false)
+  using Sink = std::function<void(const std::string& key, bool lit)>;
+
+  explicit CChangeFlash(std::chrono::milliseconds hold = std::chrono::milliseconds(750))
+    : m_hold(hold)
+  {
+  }
+
+  //! A key is published with this value; it was published with the other one before
+  void Observe(const std::string& key,
+               const std::string& before,
+               const std::string& now,
+               Clock::time_point at)
+  {
+    if (before.empty() || now.empty() || before == now)
+      return;
+    m_entries[key].until = at + m_hold;
+  }
+
+  //! Lights what changed since the last call and puts out what has been lit for the hold
+  void Update(Clock::time_point at, const Sink& sink)
+  {
+    for (auto it = m_entries.begin(); it != m_entries.end();)
+    {
+      Entry& entry = it->second;
+      const bool should = at < entry.until;
+      if (should && !entry.lit)
+      {
+        entry.lit = true;
+        sink(it->first, true);
+      }
+      else if (!should && entry.lit)
+      {
+        sink(it->first, false);
+        it = m_entries.erase(it);
+        continue;
+      }
+      else if (!should)
+      {
+        it = m_entries.erase(it);
+        continue;
+      }
+      ++it;
+    }
+  }
+
+  //! Puts everything out (the page closes)
+  void Clear(const Sink& sink)
+  {
+    for (const auto& [key, entry] : m_entries)
+      if (entry.lit)
+        sink(key, false);
+    m_entries.clear();
+  }
+
+  size_t Size() const { return m_entries.size(); }
+
+private:
+  struct Entry
+  {
+    Clock::time_point until{};
+    bool lit = false;
+  };
+  std::chrono::milliseconds m_hold;
+  std::map<std::string, Entry> m_entries;
+};
