From eafae53cecf4b2e16cdc9a931788e91be31e6cb4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:24:51 +0000
Subject: [PATCH] application: a frame whose GUI pass was left out still counts
 for System.FPS

CApplication::Render() counted a frame for the GUI's frame counter only where the
GUI pass drew (hasRendered). A frame whose pass was left out (GuiPassSkipped())
goes to the screen all the same, with the GUI composited from its FBO, so
System.FPS fell to the rate of the frames that changed. WinSystem::FrameShown()
says whether a frame counts: the window system's answer is rendered || reused.

Host test (outside the tree): dvguireuse_test, the four combinations.
---
 xbmc/application/Application.cpp             | 4 +++-
 xbmc/windowing/WinSystem.h                   | 3 +++
 xbmc/windowing/gbm/DVGuiReuse.h              | 4 ++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h | 4 ++++
 4 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index acfa89f..9a80880 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1014,7 +1014,9 @@ void CApplication::Render()
   infoMgr.ResetCache();
   infoMgr.GetInfoProviders().GetGUIControlsInfoProvider().ResetContainerMovingCache();
 
-  if (hasRendered)
+  // Hades: a frame whose GUI pass was left out (WinSystem::GuiPassReusable()) goes to the screen
+  // all the same, and counts for the frame counter of the GUI (System.FPS)
+  if (CServiceBroker::GetWinSystem()->FrameShown(hasRendered))
   {
     infoMgr.GetInfoProviders().GetSystemInfoProvider().UpdateFPS();
   }
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index 1992efc..34513aa 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -408,6 +408,9 @@ public:
   // Hades: the GUI pass of this frame is left out and the composite reads the FBO of the frame
   // before
   virtual bool GuiPassSkipped() const { return false; }
+  // Hades: a frame goes to the screen: its GUI pass drew, or was left out (GuiPassSkipped()); for
+  // the frame counter of the GUI (System.FPS)
+  virtual bool FrameShown(bool rendered) const { return rendered; }
 
   /*!
    * \brief Gets debug info from video renderer for use in "Debug Info OSD" (Alt + O)
diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index 2bfb229..529da1b 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -141,6 +141,10 @@ public:
   };
 
   //! The over-picture classification of a frame (a capture first: it makes every frame whole)
+  //! Whether a frame counts for the frame counter of the GUI (System.FPS): one whose GUI was drawn,
+  //! and one whose GUI pass was left out, which goes to the screen all the same
+  static bool CountsAsFrame(bool rendered, bool reused) { return rendered || reused; }
+
   static Over Classify(bool captured, bool guiElements)
   {
     return captured ? Over::CAPTURE : guiElements ? Over::GUI : Over::OVERLAYS;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index f9f5bb9..ac3ad08 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -112,6 +112,10 @@ public:
   bool IsHdrComposite() const override { return m_guiCompositing; }
   bool GuiPassReusable() const override;
   bool GuiPassSkipped() const override { return m_guiReusing; }
+  bool FrameShown(bool rendered) const override
+  {
+    return CDVGuiReuse::CountsAsFrame(rendered, m_guiReusing);
+  }
   //! Hades: the video was drawn by RenderEx() in this frame (CRenderManager::Render()): the GUI
   //! pass is what draws a disc menu without a picture, and what updates an unconfigured renderer
   void NoteVideoDrawnInRenderEx() { m_guiVideoNow = true; }
