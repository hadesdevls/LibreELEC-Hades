 xbmc/cores/VideoPlayer/RepeatedField.h      | 45 +++++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 14 +++----
 3 files changed, 52 insertions(+), 8 deletions(-)
 create mode 100644 xbmc/cores/VideoPlayer/RepeatedField.h

diff --git a/xbmc/cores/VideoPlayer/CMakeLists.txt b/xbmc/cores/VideoPlayer/CMakeLists.txt
index b29358c..4444478 100644
--- a/xbmc/cores/VideoPlayer/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/CMakeLists.txt
@@ -53,6 +53,7 @@ set(HEADERS AudioSinkAE.h
             MultiviewChoice.h
             MultiviewDisc.h
             PTSTracker.h
+            RepeatedField.h
             SubtitleSeekMemory.h
             SubtitleSeekSearch.h
