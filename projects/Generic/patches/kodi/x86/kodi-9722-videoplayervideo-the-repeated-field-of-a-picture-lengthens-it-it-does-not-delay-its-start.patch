diff --git a/xbmc/cores/VideoPlayer/RepeatedField.h b/xbmc/cores/VideoPlayer/RepeatedField.h
new file mode 100644
index 0000000..c1998e3
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/RepeatedField.h
@@ -0,0 +1,45 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI::VIDEOPLAYER
+{
+//! \brief The time and the duration that a decoded picture goes out with
+struct PictureTime
+{
+  double pts; //!< when it starts to be shown
+  double duration; //!< for how long it is shown
+};
+
+/*!
+ * \brief (Hades) The time of a picture that carries repeated fields (soft telecine, frame doubling)
+ *
+ * MPEG-2 (repeat_first_field), H.264 (pic_struct) and VC-1 say that a picture is shown for longer
+ * than one picture: the extra field, or frame, is shown at the end of it, after the fields that
+ * the picture has. The picture starts when its own time says (for MPEG-2 the time of a picture is
+ * the one of its first field); only the one after it is later. Kodi delayed the start of such a
+ * picture by the extra time too, so a soft telecined film at 23.976 pictures per second, whose
+ * pictures all have their time in a container that gives one (Matroska), had every second
+ * picture 21 ms late: with a refresh of 23.976 Hz one picture was then shown twice and the one
+ * before it not at all, in half of the phases of the display.
+ *
+ * \param pts the time of the picture (its running guess where the picture has none)
+ * \param duration the duration of one picture of the stream
+ * \param repeatPicture the repeated fields as pictures: 0.5 for each repeated field. Negative
+ *        (-0.5) is how the decoder marks a picture whose time is the one of the picture before it:
+ *        it is shown half a picture earlier than the guess and for half a picture, as it always was
+ * \return the time to show it at, and its duration with the repeated fields in it (the time of the
+ *         next picture, where it has none, is this time and this duration after)
+ */
+constexpr PictureTime RepeatedFieldTiming(double pts, double duration, double repeatPicture)
+{
+  const double extra = repeatPicture * duration;
+  return {repeatPicture > 0.0 ? pts : pts + extra, duration + extra};
+}
+} // namespace KODI::VIDEOPLAYER
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 5705612..a0fcb62 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -12,6 +12,7 @@
 #include "DVDCodecs/DVDFactoryCodec.h"
 #include "DVDCodecs/Overlay/DVDOverlay.h"
 #include "DVDCodecs/Video/DVDVideoCodecFFmpeg.h"
+#include "RepeatedField.h"
 #include "ServiceBroker.h"
 #include "cores/VideoPlayer/Interface/DemuxPacket.h"
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
@@ -840,14 +841,11 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       }
     }
 
-    double extraDelay = 0.0;
-    if (m_picture.iRepeatPicture)
-    {
-      extraDelay = m_picture.iRepeatPicture * m_picture.iDuration;
-      m_picture.iDuration += extraDelay;
-    }
-
-    m_picture.pts = pts + extraDelay;
+    // Hades: the repeated field of a picture lengthens it; it does not move its start
+    const auto timing = KODI::VIDEOPLAYER::RepeatedFieldTiming(pts, m_picture.iDuration,
+                                                               m_picture.iRepeatPicture);
+    m_picture.iDuration = timing.duration;
+    m_picture.pts = timing.pts;
     // guess next frame pts. iDuration is always valid
     if (m_speed != 0)
       pts += m_picture.iDuration * m_speed / abs(m_speed);
-- 
