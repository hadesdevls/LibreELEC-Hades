From 672c58f290467e229263371006589d80f3c3b9d1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:33:13 +0000
Subject: [PATCH] videoplayer: a demuxer of a file can be given a check that
 stops its reads

A demuxer is stopped only by its own Abort(), which needs the object, and the
object of a stream-details probe or of a thumbnail is not reachable from the
thread that wants it stopped (a loader of a list that is stopped, Kodi
closing). The open of the demuxer cannot be reached at all: Open() clears the
abort flag and creates the object inside CreateDemuxer().

CDVDDemuxFFmpeg::SetCancelCheck() takes a function that Aborted() calls along
with the abort flag and the timeout. Aborted() is what the interrupt callback
of libavformat and every read and seek of the input look at, so a check that
answers true ends the open, the probe and the read, and Read() answers null.
CDVDFactoryDemuxer::CreateDemuxer() passes it to the demuxer of libavformat
(the others do not read a file); nothing changes for a caller that gives none.
---
 .../cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp |  3 +++
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  | 12 ++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp    |  4 +++-
 .../VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.h      | 11 ++++++++++-
 4 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 0db9858..8b9dc1d 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -239,6 +239,9 @@ bool CDVDDemuxFFmpeg::Aborted()
   if (m_abortRequested)
     return true;
 
+  if (m_cancelCheck && m_cancelCheck())
+    return true;
+
   if (m_timeout.IsTimePast())
     return true;
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 141aaa5..91fb47b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -20,6 +20,7 @@
 
 #include <atomic>
 #include <chrono>
+#include <functional>
 #include <map>
 #include <memory>
 #include <optional>
@@ -133,6 +134,15 @@ public:
 
   bool Aborted();
 
+  /*!
+   * \brief Hades: a check that the demuxer asks, with every read and seek of its input, whether
+   *        what it reads for is not wanted any more (a library scan or a loader of the lists that
+   *        is stopped, Kodi closing). When it answers true the demuxer is aborted as by Abort(),
+   *        the open or the read returns, and Read() answers null. Set before Open(): the open
+   *        reads too. The check is called from the thread that reads, and must be cheap.
+   */
+  void SetCancelCheck(std::function<bool()> check) { m_cancelCheck = std::move(check); }
+
   /*!
    * \brief Hades: around each read of the input by libavformat (dvd_file_read()). The time that a
    *        read of a local file waits for its drive does not count against m_timeout, which would
@@ -266,6 +276,8 @@ protected:
   XbmcThreads::EndTime<> m_timeout;
   //! Hades: Abort() was called; Aborted() answers true from then on, whatever sets m_timeout
   std::atomic<bool> m_abortRequested{false};
+  //! Hades: SetCancelCheck()
+  std::function<bool()> m_cancelCheck;
   //! Hades: InputReadBegins() and InputReadEnded()
   bool m_inputLocalFile{false};
   CDemuxReadStall m_readStall;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
index f37e458..6352322 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
@@ -24,7 +24,8 @@
 #endif
 
 CDVDDemux* CDVDFactoryDemuxer::CreateDemuxer(const std::shared_ptr<CDVDInputStream>& pInputStream,
-                                             bool fileinfo)
+                                             bool fileinfo,
+                                             std::function<bool()> cancel)
 {
   if (!pInputStream)
     return NULL;
@@ -120,6 +121,7 @@ CDVDDemux* CDVDFactoryDemuxer::CreateDemuxer(const std::shared_ptr<CDVDInputStre
 #endif
 
   std::unique_ptr<CDVDDemuxFFmpeg> demuxer(new CDVDDemuxFFmpeg());
+  demuxer->SetCancelCheck(std::move(cancel));
   if (demuxer->Open(pInputStream, fileinfo))
     return demuxer.release();
   else
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.h
index 1d2bddf..04088b4 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include <functional>
 #include <memory>
 
 class CDVDDemux;
@@ -16,6 +17,14 @@ class CDVDInputStream;
 class CDVDFactoryDemuxer
 {
 public:
+  /*!
+   * \brief Creates the demuxer of an input stream and opens it.
+   * \param fileinfo only stream details or a picture are wanted, not playback
+   * \param cancel Hades: asked with every read of the input of the demuxer of a file (the one
+   *        of libavformat), which stops when it answers true (CDVDDemuxFFmpeg::SetCancelCheck());
+   *        the other demuxers do not look at it
+   */
   static CDVDDemux* CreateDemuxer(const std::shared_ptr<CDVDInputStream>& pInputStream,
-                                  bool fileinfo = false);
+                                  bool fileinfo = false,
+                                  std::function<bool()> cancel = {});
 };
