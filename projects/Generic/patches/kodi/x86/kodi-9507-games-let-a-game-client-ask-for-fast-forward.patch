new file mode 100644
index 0000000..204ebce
--- /dev/null
+++ b/xbmc/games/addons/GameClientFastForward.cpp
@@ -0,0 +1,212 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "GameClientFastForward.h"
+
+#include "ServiceBroker.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
+#include "messaging/ApplicationMessenger.h"
+#include "messaging/ThreadMessage.h"
+
+#include <mutex>
+#include <utility>
+
+using namespace KODI;
+using namespace GAME;
+
+namespace
+{
+class CApplicationPlayerSpeed : public CGameClientFastForward::IPlayerSpeed
+{
+public:
+  bool IsPlayingGame() const override
+  {
+    const auto player = Player();
+    return player && player->IsPlayingGame();
+  }
+
+  float GetSpeed() const override
+  {
+    const auto player = Player();
+    return player ? player->GetPlaySpeed() : 1.0f;
+  }
+
+  void SetSpeed(float speed) override
+  {
+    if (const auto player = Player(); player)
+      player->SetPlaySpeed(speed);
+  }
+
+private:
+  static std::shared_ptr<CApplicationPlayer> Player()
+  {
+    return CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  }
+};
+
+bool PostToApplication(std::function<void()> task)
+{
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  if (!messenger)
+    return false;
+
+  struct Callback
+  {
+    MESSAGING::ThreadMessageCallback message;
+    std::function<void()> task;
+  };
+  auto* callback = new Callback{{}, std::move(task)};
+  callback->message.userptr = callback;
+  callback->message.callback = [](void* data)
+  {
+    std::unique_ptr<Callback> callback(static_cast<Callback*>(data));
+    callback->task();
+  };
+  messenger->PostMsg(TMSG_CALLBACK, -1, -1, &callback->message);
+  return true;
+}
+
+double RequestedSpeed(bool fastForward, double ratio)
+{
+  if (!fastForward)
+    return 0.0;
+
+  // Also false for a ratio that isn't a number
+  if (ratio > 1.0 && ratio <= CGameClientFastForward::DEFAULT_SPEED)
+    return ratio;
+
+  return CGameClientFastForward::DEFAULT_SPEED;
+}
+} // namespace
+
+struct CGameClientFastForward::State
+{
+  std::mutex mutex;
+
+  double requested = 0.0; // The speed asked for last, or 0
+  unsigned int session = 0; // Counts the games closed
+  float owned = 0.0f; // The speed Kodi set and the player took, or 0
+
+  // What the client reads back while requests wait for the application thread
+  unsigned int pending = 0;
+  double expectedSpeed = 0.0;
+  double expectedOwned = 0.0;
+};
+
+CGameClientFastForward::CGameClientFastForward()
+  : CGameClientFastForward(std::make_shared<CApplicationPlayerSpeed>(), PostToApplication)
+{
+}
+
+CGameClientFastForward::CGameClientFastForward(std::shared_ptr<IPlayerSpeed> player, Post post)
+  : m_player(std::move(player)),
+    m_post(std::move(post)),
+    m_state(std::make_shared<State>())
+{
+}
+
+CGameClientFastForward::~CGameClientFastForward() = default;
+
+void CGameClientFastForward::Request(bool fastForward, double ratio, double clientSpeed)
+{
+  unsigned int session = 0;
+  {
+    std::unique_lock lock(m_state->mutex);
+    State& state = *m_state;
+
+    state.requested = RequestedSpeed(fastForward, ratio);
+
+    const bool expecting = state.pending > 0;
+    const double speed = expecting ? state.expectedSpeed : clientSpeed;
+    const double owned = expecting ? state.expectedOwned : static_cast<double>(state.owned);
+    const double target = Target(state.requested, speed, owned);
+
+    state.expectedOwned = state.requested > 0.0 ? (target != speed ? target : owned) : 0.0;
+    state.expectedSpeed = target;
+    ++state.pending;
+    session = state.session;
+  }
+
+  // The task holds the state rather than this, which can go with its client first
+  if (!m_post([state = m_state, player = m_player, session] { Apply(*state, *player, session); }))
+  {
+    std::unique_lock lock(m_state->mutex);
+    if (m_state->session == session && m_state->pending > 0)
+      --m_state->pending;
+  }
+}
+
+double CGameClientFastForward::ClientSpeed(double clientSpeed) const
+{
+  std::unique_lock lock(m_state->mutex);
+  return m_state->pending > 0 ? m_state->expectedSpeed : clientSpeed;
+}
+
+void CGameClientFastForward::Reset()
+{
+  std::unique_lock lock(m_state->mutex);
+  m_state->requested = 0.0;
+  m_state->owned = 0.0f;
+  m_state->pending = 0;
+  ++m_state->session;
+}
+
+double CGameClientFastForward::Target(double requested, double speed, double owned)
+{
+  if (requested == 0.0)
+    return owned != 0.0 && speed == owned ? 1.0 : speed;
+
+  // From normal speed, or from the speed Kodi set for an earlier ratio
+  const bool kodiSpeed = owned != 0.0 ? speed == owned : speed == 1.0;
+  return kodiSpeed ? requested : speed;
+}
+
+void CGameClientFastForward::Apply(State& state, IPlayerSpeed& player, unsigned int session)
+{
+  double requested = 0.0;
+  float owned = 0.0f;
+  {
+    std::unique_lock lock(state.mutex);
+    if (state.session != session)
+      return;
+    requested = state.requested;
+    owned = state.owned;
+  }
+
+  // Not under the lock: changing speed waits on the game loop, whose frame may
+  // be making a request
+  bool changed = false;
+  float taken = 0.0f;
+  if (player.IsPlayingGame())
+  {
+    const float speed = player.GetSpeed();
+    const auto target = static_cast<float>(
+        Target(requested, static_cast<double>(speed), static_cast<double>(owned)));
+    if (target != speed)
+    {
+      player.SetSpeed(target);
+
+      // The player can round the speed or refuse it
+      taken = player.GetSpeed();
+      changed = taken != speed;
+    }
+  }
+
+  std::unique_lock lock(state.mutex);
+  if (state.session != session)
+    return;
+
+  if (requested == 0.0)
+    state.owned = 0.0f;
+  else if (changed)
+    state.owned = taken;
+
+  if (state.pending > 0)
+    --state.pending;
+}
diff --git a/xbmc/games/addons/GameClientFastForward.h b/xbmc/games/addons/GameClientFastForward.h
new file mode 100644
index 0000000..f8c0498
--- /dev/null
+++ b/xbmc/games/addons/GameClientFastForward.h
@@ -0,0 +1,105 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <functional>
+#include <memory>
+
+namespace KODI
+{
+namespace GAME
+{
+/*!
+ * \ingroup games
+ *
+ * \brief A game client's requests to fast-forward
+ *
+ * A client asks from inside a frame, but the player changes speed on the
+ * application thread, as it does when the user picks a speed, so it can't race
+ * the player closing. Requests are applied there in the order they're made,
+ * each one applying the latest.
+ *
+ * Kodi only fast-forwards from normal speed, and only returns to normal speed
+ * from the speed it set. Any other speed is the user's and is left alone.
+ */
+class CGameClientFastForward
+{
+public:
+  //! The speed a client gets when it leaves the speed to Kodi, and the most it
+  //! can ask for. The game loop goes no faster than the client runs frames.
+  static constexpr double DEFAULT_SPEED = 16.0;
+
+  //! The player whose speed the requests change
+  class IPlayerSpeed
+  {
+  public:
+    virtual ~IPlayerSpeed() = default;
+
+    virtual bool IsPlayingGame() const = 0;
+    virtual float GetSpeed() const = 0;
+    virtual void SetSpeed(float speed) = 0;
+  };
+
+  //! Runs a task on the application thread later, or returns false
+  using Post = std::function<bool(std::function<void()> task)>;
+
+  //! Requests that change the speed of the application's player
+  CGameClientFastForward();
+
+  CGameClientFastForward(std::shared_ptr<IPlayerSpeed> player, Post post);
+
+  ~CGameClientFastForward();
+
+  /*!
+   * \brief Ask to fast-forward, or to stop a fast-forward asked for
+   *
+   * \param fastForward True to fast-forward, false to return to normal speed
+   * \param ratio The speed asked for if it's above 1 and at most
+   *        DEFAULT_SPEED, otherwise DEFAULT_SPEED
+   * \param clientSpeed The speed the client was last told it's playing at
+   */
+  void Request(bool fastForward, double ratio, double clientSpeed);
+
+  /*!
+   * \brief The speed the client reads back
+   *
+   * Until its requests are applied, the speed they will give it, as it would
+   * get at once from RetroArch. A client may act on the speed it reads in its
+   * next frame.
+   *
+   * \param clientSpeed The speed the client was last told it's playing at
+   */
+  double ClientSpeed(double clientSpeed) const;
+
+  /*!
+   * \brief The game closed: drop requests not yet applied, and forget the
+   *        speed Kodi set
+   */
+  void Reset();
+
+  /*!
+   * \brief The speed a request moves the player to
+   *
+   * \param requested The speed asked for, or 0 to stop fast-forwarding
+   * \param speed The player's speed
+   * \param owned The speed Kodi set for the client, or 0 if it set none
+   */
+  static double Target(double requested, double speed, double owned);
+
+private:
+  struct State;
+
+  static void Apply(State& state, IPlayerSpeed& player, unsigned int session);
+
+  const std::shared_ptr<IPlayerSpeed> m_player;
+  const Post m_post;
+  const std::shared_ptr<State> m_state;
+};
+} // namespace GAME
+} // namespace KODI
