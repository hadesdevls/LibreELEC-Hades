 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),port)">$ADDON[skin.estuary 32729]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),system)">$ADDON[skin.estuary 32736]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),hdrassdr)">$ADDON[skin.estuary 32597]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),ratemode)">$ADDON[skin.estuary 32756]</value>
 	</variable>
 	<variable name="HadesSysGpuVar">
 		<value condition="!String.IsEmpty(Window(Home).Property(hades.sys.gpu))">$INFO[Window(Home).Property(hades.sys.gpu),,%]$INFO[Window(Home).Property(hades.sys.gputemp), · ,]</value>
diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 06d0f14..17de460 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -85,6 +85,9 @@ struct SummaryInput
   bool felGap = false; //!< the enhancement layer is catching up after a seek
   //! the display rate against the video's (FitRate(): exact, multiple, near, mismatch), or empty
   std::string rateFit;
+  //! "Adjust display refresh rate" is on (videoplayer.adjustrefreshrate): a rate that does not fit is
+  //! then no setting to turn on, but a display without a mode at the video's rate that Kodi may use
+  bool rateFollows = false;
   std::string audioWhy; //!< hades.audio.why: why the sound is decoded where it could be passed
 };
 
@@ -95,8 +98,8 @@ struct Note
   std::string code; //!< dv_not_native, hdr_to_sdr, hdr_not_sent, frames_failed, step_down,
                     //!< fel_resync, rate_mismatch, audio_decoded, unknown_output, hdr_as_sdr
   std::string arg; //!< the reason, or the number, that the sentence has in it
-  //! what to do about it: tv, mode, choice, rate, hdr, sync, system, converteron, convertertry,
-  //! port, hdrassdr (Hades: the setting "Play HDR videos as SDR"); or empty
+  //! what to do about it: tv, mode, choice, rate, ratemode, hdr, sync, system, converteron,
+  //! convertertry, port, hdrassdr (Hades: the setting "Play HDR videos as SDR"); or empty
   std::string todo;
 };
 
@@ -256,8 +259,9 @@ inline std::vector<Note> Notes(const SummaryInput& in)
     warn.push_back({Severity::WARN, "frames_failed", std::to_string(in.failed), "system"});
   if (in.stepLevel > 0)
     warn.push_back({Severity::WARN, "step_down", std::to_string(in.stepLevel), "system"});
+  // (with the rate following the video already, what is missing is the mode: ratemode)
   if (in.rateFit == "mismatch")
-    warn.push_back({Severity::WARN, "rate_mismatch", "", "rate"});
+    warn.push_back({Severity::WARN, "rate_mismatch", "", in.rateFollows ? "ratemode" : "rate"});
   if (in.felGap)
     note.push_back({Severity::NOTE, "fel_resync", "", ""});
   // Hades: an HDR video sent as SDR by the user's choice: not a fault, said with where it is chosen
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index a461336..37dc56a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -10950,6 +10950,12 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     input.stepLevel = std::atoi(dv("hades.dv.step").c_str());
     input.felGap = dv("hades.dv.layers") == "FELGAP";
     input.rateFit = info["hades.out.ratefit"];
+    {
+      const auto component = CServiceBroker::GetSettingsComponent();
+      const auto settings = component ? component->GetSettings() : nullptr;
+      input.rateFollows = settings && settings->GetInt(CSettings::SETTING_VIDEOPLAYER_ADJUSTREFRESHRATE) !=
+                                          ADJUST_REFRESHRATE_OFF;
+    }
     input.audioWhy = info["hades.audio.why"];
     const Summary summary = Decide(input);
     info["hades.sum.state"] = SeverityName(summary.state);
