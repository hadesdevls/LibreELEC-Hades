 system/hades/HadesIncludes.xml                         |  1 +
 xbmc/utils/HadesPlayerInfo.h                           | 10 +++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp         |  6 ++++++
 8 files changed, 32 insertions(+), 3 deletions(-)

