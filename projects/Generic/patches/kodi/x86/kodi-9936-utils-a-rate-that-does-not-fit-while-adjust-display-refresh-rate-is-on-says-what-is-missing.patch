 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),system)">$ADDON[skin.estuary 32736]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),hdrassdr)">$ADDON[skin.estuary 32597]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.sum.todo),ratemode)">$ADDON[skin.estuary 32756]</value>
 	</variable>
 	<variable name="HadesOvDecodingVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.video.decoding),hw)">$ADDON[skin.estuary 32817]$INFO[Window(Home).Property(hades.video.api), (,)]</value>
