     const bool attempted = m_dvFrame && m_dvBridge;
     const auto presentStart = std::chrono::steady_clock::now();
     bool presented = false;
+    // Hades: the commit of this frame changes nothing but the picture (CDVPresentStall): the
+    // output carries the transport already, and Kodi has asked for nothing else since
+    bool plainFrame = false;
     // EGL's window framebuffer has a bottom-left GL origin, while transport
     // metadata is indexed from the top-left of the HDMI raster.
     if (m_dvFrame && m_dvBridge && m_dvBridge->Pack(0, m_nWidth, m_nHeight, true))
@@ -394,6 +397,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         DVFlip flip;
         flip.fenced = fenced;
         flip.ahead = ahead;
+        const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+        plainFrame = m_dvState.TransportLive() && atomic && !atomic->HasPendingRequest();
         presented = FlipDVBridgePage(m_dvState, false, &flip);
         DVAheadEnd(presented, flip);
         if (presented && !m_dvSignalling)
@@ -428,6 +433,13 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       const bool late = periodMs > 0 && presentMs > 1.5 * periodMs;
       if (late)
         m_dvStats.late++;
+      // Hades: a frame that was taken and whose flip did not come; the output ends when they do
+      // not reach the display (the ordinary output, restored, is told from here on)
+      if (presented && DVPresentStalled(plainFrame, presentMs))
+      {
+        SendDisplayReset();
+        return;
+      }
       // Hades: whether the frame came with its refresh, for the fidelity step-down: presented the
       // way that waits, by how long that took; a frame ahead, by the time of its flip, which is
       // told while the next frame is presented (DVAheadFlipped())
@@ -1558,6 +1570,8 @@ bool CWinSystemGbmGLESContext::BeginDVBridge()
   m_dvShown = {};
   m_dvRepeatFlipPending = false;
   DVEngineRead();
+  // Hades: whether its frames reach the display is found for this native output
+  m_dvPresentStall.Reset();
   return true;
 }
 
@@ -1910,6 +1924,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
     glEnable(GL_SCISSOR_TEST);
   }
   DVGpuTimerReset();
+  m_dvPresentStall.Reset();
   // (the restoration is a commit that waits)
   m_dvAheadPending = false;
   m_dvRepeatFlipPending = false;
@@ -2987,6 +3002,37 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   m_dvStats.hasLastShown = hasLastShown;
 }
 
+bool CWinSystemGbmGLESContext::DVPresentStalled(bool plain, double presentMs)
+{
+  const unsigned int stalls = m_dvPresentStall.Stalls();
+  const auto verdict = m_dvPresentStall.Presented(plain, presentMs);
+  if (verdict == CDVPresentStall::Verdict::NONE)
+    return false;
+  if (verdict == CDVPresentStall::Verdict::STALLED)
+  {
+    CLog::Log(LOGWARNING,
+              "DVBridge: a frame of native Dolby Vision output was taken but took {:.0f} ms to be "
+              "shown (its flip did not come; the driver gave up waiting for it): native output "
+              "ends if the next one does too",
+              presentMs);
+    return false;
+  }
+  CLog::Log(LOGERROR,
+            "DVBridge: a frame of native Dolby Vision output took {:.0f} ms to be shown, after {} "
+            "that took over {:.0f} ms: their flips do not come, and the display shows nothing new",
+            presentMs, stalls, CDVPresentStall::STALL_MS);
+  // As for frames that cannot be shown (DVBridgeFrameShown()): the ordinary output now, and the
+  // renderer is configured again for it with the next picture
+  m_dvFailedFrames = 0;
+  m_dvShownTime = {};
+  m_dvLastShownPts = DVD_NOPTS_VALUE;
+  m_dvWorked = false;
+  DisableNativeDVOutput("its frames did not reach the display: their flips did not come");
+  if (m_dvState.Captured())
+    EndDVBridge();
+  return true;
+}
