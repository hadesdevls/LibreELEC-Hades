+void DVBRIDGE::SetOutputChoice(OutputChoice choice)
+{
+  const int before = g_dvOutputChoice.exchange(static_cast<int>(choice));
+  if (before != static_cast<int>(choice))
+    CLog::Log(LOGINFO,
+              "DVBridge: the user chose for this video: {}; its video stream is opened again",
+              choice == OutputChoice::HDR10  ? "Dolby Vision as HDR10"
+              : choice == OutputChoice::KODI ? "no Dolby Vision (as Kodi plays it)"
+                                             : "as the settings say");
+}
+
+DVBRIDGE::OutputChoice DVBRIDGE::GetOutputChoice()
+{
+  const int choice = g_dvOutputChoice;
+  return choice == static_cast<int>(OutputChoice::HDR10)  ? OutputChoice::HDR10
+         : choice == static_cast<int>(OutputChoice::KODI) ? OutputChoice::KODI
+                                                          : OutputChoice::AUTOMATIC;
+}
+
+void DVBRIDGE::VideoStreamOpened(const CDVDStreamInfo& stream)
+{
+  g_dvStreamProfile = static_cast<int>(stream.dovi.dv_profile);
+  g_dvStreamCompatibility = static_cast<int>(stream.dovi.dv_bl_signal_compatibility_id);
+}
+
+bool DVBRIDGE::OutputChoiceAvailable(OutputChoice choice)
+{
+  // (not as Kodi plays it where that has the wrong colours: OutputChoiceOffered())
+  if (!OutputChoiceOffered(choice, g_dvStreamProfile, g_dvStreamCompatibility))
+    return false;
+  if (choice != OutputChoice::HDR10)
+    return true;
+  const auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  return window && window->SupportsDVConversion();
+}
+
+bool DVBRIDGE::NativeOutputAvailable()
+{
+  const auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  return window && window->SupportsNativeDVOutput(true);
+}
