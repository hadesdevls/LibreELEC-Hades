+/*!
+ * \brief Hades: the output that the user chose for the Dolby Vision video that plays, in the video
+ *        settings of the player; for that video only (VideoPlayer forgets it when the next file
+ *        starts, DVBRIDGE::NewVideo())
+ *
+ * AUTOMATIC: as the settings say (native output where the display takes it). HDR10: never native;
+ * reconstructed and sent as HDR10, whatever the stream's profile, mapped to the display where
+ * that is set. KODI: never native, never reconstructed: as Kodi plays it.
+ */
+enum class OutputChoice
+{
+  AUTOMATIC = 0,
+  HDR10 = 1,
+  KODI = 2,
+};
+
+//! Native output may be had with this choice
+constexpr bool NativeAllowed(OutputChoice choice)
+{
+  return choice == OutputChoice::AUTOMATIC;
+}
+
+//! What decides whether a stream is reconstructed and sent as HDR10, with this choice
+constexpr ConversionSetting ConversionSettingFor(ConversionSetting settings, OutputChoice choice)
+{
+  return choice == OutputChoice::HDR10  ? ConversionSetting::EVERY
+         : choice == OutputChoice::KODI ? ConversionSetting::NEVER
+                                        : settings;
+}
+
 /*!
  * \brief The setting of the conversion (videoscreen.hadesdvashdr10, videoscreen.hadesdvashdr10fel)
  *        and of the mapping to the display (videoscreen.hadesdvhdr10map), as one
@@ -119,6 +149,19 @@ constexpr bool BaseLayerIsNoPicture(int profile, int compatibility)
   return profile == 5 || (profile == 10 && compatibility == 0);
 }
 
+/*!
+ * \brief Hades: whether a choice of output (OutputChoice) is offered for a stream of this profile
+ *        and base layer compatibility
+ *
+ * Not KODI where the base layer is no picture by itself (BaseLayerIsNoPicture()): played as Kodi
+ * plays it, its colours are wrong, which is why such a stream is reconstructed where it is not
+ * sent natively. Every other choice for every stream.
+ */
+constexpr bool OutputChoiceOffered(OutputChoice choice, int profile, int compatibility)
+{
+  return choice != OutputChoice::KODI || !BaseLayerIsNoPicture(profile, compatibility);
+}
+
 /*!
  * \brief Whether a Dolby Vision stream is one that is reconstructed and sent as HDR10 where it
  *        is not sent natively
@@ -222,4 +265,21 @@ bool ConversionEligible(const CDVDStreamInfo& stream);
 bool WantsConversion(const VideoPicture* picture);
 //! Such pictures could not be shown (the renderer says so): not tried again in this video.
 void ConversionFailed(const char* reason);
+
+//! Hades: the choice of the user for the video that plays (any thread). Set before its video
+//! stream is opened again (the video settings of the player), read when a video stream opens:
+//! by VideoPlayer and the decoder factory, and by the decoder, which marks its pictures with it
+//! (VideoPicture::doviNoNative). Back to AUTOMATIC when a new file starts (NewVideo()).
+void SetOutputChoice(OutputChoice choice);
+OutputChoice GetOutputChoice();
+//! The video stream of the video that plays opened (VideoPlayer, each time it opens): its profile
+//! and the compatibility of its base layer, for OutputChoiceAvailable()
+void VideoStreamOpened(const CDVDStreamInfo& stream);
+//! Whether a choice can be had now for the video that plays: AUTOMATIC always; HDR10 where the
+//! display takes HDR10 and the conversion has not failed in this video; KODI where the stream's
+//! base layer is a picture by itself (OutputChoiceOffered())
+bool OutputChoiceAvailable(OutputChoice choice);
+//! Native output can be had for the video that plays, in a mode that carries it (what AUTOMATIC
+//! then gives): for the player's video settings
+bool NativeOutputAvailable();
 } // namespace DVBRIDGE
