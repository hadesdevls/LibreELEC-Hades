+#ifdef HAVE_DVBRIDGE
+void CGUIDialogVideoSettings::AddDVOutput(const std::shared_ptr<CSettingGroup>& group)
+{
+  // Only for a Dolby Vision video whose video stream can be opened again
+  auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+  if (!group || !appPlayer || appPlayer->GetVideoStream() < 0)
+    return;
+  VideoStreamInfo info;
+  appPlayer->GetVideoStreamInfo(CURRENT_STREAM, info);
+  if (info.hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION)
+    return;
+  m_dvOutput = static_cast<int>(DVBRIDGE::GetOutputChoice());
+  AddList(group, SETTING_VIDEO_HADES_DV_OUTPUT, 39820, SettingLevel::Basic, m_dvOutput,
+          DVOutputFiller, 39820);
+}
+
+void CGUIDialogVideoSettings::DVOutputFiller(const std::shared_ptr<const CSetting>& /*setting*/,
+                                             std::vector<IntegerSettingOption>& list,
+                                             int& /*current*/)
+{
+  using DVBRIDGE::OutputChoice;
+  // (the strings of Hades are translated in Estuary: CGUIUtils::GetHadesString())
+  // As the settings say: native output where the display takes it, which is then what it gives
+  list.emplace_back(DVBRIDGE::NativeOutputAvailable() ? CGUIUtils::GetHadesString(39821, 31763)
+                                                      : CGUIUtils::GetHadesString(39822, 31764),
+                    static_cast<int>(OutputChoice::AUTOMATIC));
+  if (DVBRIDGE::OutputChoiceAvailable(OutputChoice::HDR10))
+  {
+    // ... and the mapping to the display, where it is set
+    std::string label = CGUIUtils::GetHadesString(39823, 31765);
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) &&
+        settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) != 0 &&
+        settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK))
+      label = StringUtils::Format(CGUIUtils::GetHadesString(39824, 31766),
+                                  settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK));
+    list.emplace_back(label, static_cast<int>(OutputChoice::HDR10));
+  }
+  // Not where the base layer is no picture by itself (profile 5): there it has the wrong colours
+  if (DVBRIDGE::OutputChoiceAvailable(OutputChoice::KODI))
+    list.emplace_back(CGUIUtils::GetHadesString(39825, 31767), static_cast<int>(OutputChoice::KODI));
+}
+
+void CGUIDialogVideoSettings::ChooseDVOutput(int value)
+{
+  using DVBRIDGE::OutputChoice;
+  auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+  const OutputChoice choice = value == static_cast<int>(OutputChoice::HDR10) ? OutputChoice::HDR10
+                              : value == static_cast<int>(OutputChoice::KODI)
+                                  ? OutputChoice::KODI
+                                  : OutputChoice::AUTOMATIC;
+  const int stream = appPlayer ? appPlayer->GetVideoStream() : -1;
+  // Fail closed: what cannot be had now (the display does not take HDR10, the conversion failed
+  // in this video, a base layer that is no picture by itself as Kodi plays it, or no video stream
+  // to open again) is not tried; the video goes on as it was, and the list shows that again
+  if (!DVBRIDGE::OutputChoiceAvailable(choice) || stream < 0 ||
+      static_cast<int>(choice) != value)
+  {
+    CLog::Log(LOGWARNING, "DVBridge: the output chosen for this video ({}) cannot be had now; it "
+                          "goes on as it was",
+              value);
+    // (the heading is the name, which is not translated: the label of the setting does not fit
+    // the 450 pixels of Estuary's notification)
+    CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, "Dolby Vision",
+                                          CGUIUtils::GetHadesString(39826, 31768));
+    GetSettingsManager()->SetInt(SETTING_VIDEO_HADES_DV_OUTPUT, m_dvOutput);
+    return;
+  }
+  m_dvOutput = value;
+  // The decisions are taken where a video stream opens (VideoPlayer, the decoder factory, the
+  // decoder): it is opened again, at the time it is at, as when another video stream is chosen.
+  // Its pictures say for which output they were decoded (VideoPicture::doviNoNative), so the
+  // renderer changes the output once, with the first picture of the stream opened again.
+  DVBRIDGE::SetOutputChoice(choice);
+  appPlayer->SetVideoStream(stream);
+}
