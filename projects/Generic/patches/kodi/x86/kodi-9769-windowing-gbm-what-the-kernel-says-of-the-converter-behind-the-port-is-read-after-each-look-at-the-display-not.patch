 #include "LibdrmKms.h"
 #include "NvidiaDualMode.h"
 #include "windowing/gbm/HDR10PlusOutput.h"
@@ -79,6 +80,19 @@ std::vector<uint32_t>& LeftoverBlobs()
   return *blobs;
 }
 
+//! DVBRIDGE_DV_CONVERTER and NV_DUAL_MODE_TMDS of the connector in use, as the kernel wrote them
+//! when it last looked at the display (CDetectedProperty): asked with each picture
+CDetectedProperty& ConverterKept()
+{
+  static CDetectedProperty kept;
+  return kept;
+}
+CDetectedProperty& DualModeKept()
+{
+  static CDetectedProperty kept;
+  return kept;
+}
+
 bool AnySet(CDRMConnector& connector, const char* const* names, size_t count)
 {
   for (size_t i = 0; i < count; ++i)
@@ -109,9 +123,10 @@ std::optional<uint64_t> COutputHandover::ConverterVerdict(CDRMConnector& connect
 {
   if (connector.GetType() != "DP" || !connector.SupportsProperty(DV_CONVERTER::PROPERTY))
     return std::nullopt;
-  // (the kernel writes it when the display is found, after the connector was read: so from the
-  // kernel, not from what was read at the start)
-  return connector.ReadPropertyValue(DV_CONVERTER::PROPERTY);
+  // (the kernel writes it when it looks at the display, after the connector was read at the start:
+  // so from the kernel, once after each of those looks, CDetectedProperty)
+  return ConverterKept().Get(connector.GetId(), [&connector]
+                             { return connector.ReadPropertyValue(DV_CONVERTER::PROPERTY); });
 }
 
 DV_CONVERTER::Offer COutputHandover::ConverterOffer(CDRMConnector& connector)
@@ -135,7 +150,8 @@ COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
   const std::string type = connector.GetType();
   std::optional<uint64_t> dualMode;
   if (type == "DP" && connector.SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
-    dualMode = connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY);
+    dualMode = DualModeKept().Get(connector.GetId(), [&connector]
+                                  { return connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY); });
   if (!NVIDIA_DUAL_MODE::DrivenAsHdmi(type, dualMode))
     return Driver::NONE;
   const bool complete = std::ranges::all_of(NVIDIA_NEEDS, [&connector](const char* name)
