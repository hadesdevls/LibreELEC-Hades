diff --git a/xbmc/windowing/gbm/drm/DetectedProperty.h b/xbmc/windowing/gbm/drm/DetectedProperty.h
new file mode 100644
index 0000000..63d6777
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DetectedProperty.h
@@ -0,0 +1,84 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <optional>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: a read-only property of a connector that the kernel writes when it looks at the
+ *        display, kept between the times it does
+ *
+ * DVBRIDGE_DV_CONVERTER of i915 and xe is written by the detect of the connector, and only there
+ * (intel_dp_set_edid() and intel_dp_unset_edid(), linux-9977); NV_DUAL_MODE_TMDS of nvidia-drm
+ * likewise (__nv_drm_connector_detect_internal(), nvidia-open-kernel-modules-9011). The kernel
+ * runs that detect when a display is plugged or unplugged, and sends the hot-plug event after it
+ * (the event that CDRMDisplayWatch hears), and when a program probes the connector (Kodi when it
+ * takes an output, when a video starts, and when it looks at the modes after an event). Those are
+ * the times this asks the kernel again (DisplayLooked()); between them, what was read is what the
+ * kernel has. The question is asked with each picture of a Dolby Vision video
+ * (CWinSystemGbm::SupportsNativeDVOutput(), COutputHandover::DriverOf()).
+ *
+ * What is kept is one atomic word (the count of the looks it was read after, the connector, the
+ * value): any thread asks, none waits, and a value read before a look is never taken for one read
+ * after it. A read that fails, a value above 255 or a connector id above 2^20 is not kept (asked
+ * again the next time).
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+class CDetectedProperty
+{
+public:
+  //! The kernel may have looked at the display since: what every such property keeps is read
+  //! again when it is asked next (any thread)
+  static void DisplayLooked() { Looks().fetch_add(1, std::memory_order_acq_rel); }
+
+  /*!
+   * \brief The value of the property of the connector \p connector: what was kept, where it is of
+   *        that connector and no look came since it was read; otherwise \p read() (the kernel),
+   *        kept
+   */
+  template<typename Read>
+  std::optional<uint64_t> Get(uint32_t connector, Read&& read)
+  {
+    const uint32_t looks = Looks().load(std::memory_order_acquire);
+    const uint64_t kept = m_kept.load(std::memory_order_acquire);
+    if ((kept & VALID) && static_cast<uint32_t>(kept >> 32) == looks &&
+        ((kept >> CONNECTOR_SHIFT) & CONNECTOR_MASK) == connector)
+      return (kept & HAS_VALUE) ? std::optional<uint64_t>(kept & VALUE_MASK) : std::nullopt;
+    const std::optional<uint64_t> now = read();
+    if (connector <= CONNECTOR_MASK && now && *now <= VALUE_MASK)
+      m_kept.store((static_cast<uint64_t>(looks) << 32) |
+                       (static_cast<uint64_t>(connector) << CONNECTOR_SHIFT) | VALID | HAS_VALUE |
+                       *now,
+                   std::memory_order_release);
+    return now;
+  }
+
+private:
+  static constexpr uint64_t VALUE_MASK = 0xff;
+  static constexpr uint64_t HAS_VALUE = uint64_t{1} << 8;
+  static constexpr uint64_t VALID = uint64_t{1} << 9;
+  static constexpr int CONNECTOR_SHIFT = 12;
+  static constexpr uint64_t CONNECTOR_MASK = 0xfffff;
+
+  static std::atomic<uint32_t>& Looks()
+  {
+    static std::atomic<uint32_t> looks{1};
+    return looks;
+  }
+
+  std::atomic<uint64_t> m_kept{0};
+};
+
+} // namespace KODI::WINDOWING::GBM
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
