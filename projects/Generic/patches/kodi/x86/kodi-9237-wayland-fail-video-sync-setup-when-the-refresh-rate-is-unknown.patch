From 78d4e584eeb8525abeb3f762108b7411db99af88 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sun, 4 Oct 2026 15:58:24 +0200
Subject: [PATCH] [wayland] Fail video sync setup when the refresh rate is
 unknown

The refresh rate is taken from the output announced by the
wp_presentation_feedback sync_output event. Compositors are not required
to send it, and KWin intentionally does not. The rate then stays at 0
and CVideoReferenceClock crashes with a division by zero (SIGFPE) when
playback starts.

Fail the setup in this case so the reference clock falls back to the
system clock.

Fixes https://github.com/xbmc/xbmc/issues/25850

(cherry picked from commit c65b242d412fa388faf70ae07c2b643f4dbb92fd)
---
 xbmc/windowing/wayland/VideoSyncWpPresentation.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/xbmc/windowing/wayland/VideoSyncWpPresentation.cpp b/xbmc/windowing/wayland/VideoSyncWpPresentation.cpp
index 4a126ce..c3174da 100644
--- a/xbmc/windowing/wayland/VideoSyncWpPresentation.cpp
+++ b/xbmc/windowing/wayland/VideoSyncWpPresentation.cpp
@@ -30,6 +30,11 @@ bool CVideoSyncWpPresentation::Setup()
 {
   m_stopEvent.Reset();
   m_fps = m_winSystem.GetSyncOutputRefreshRate();
+  if (m_fps <= 0.0f)
+  {
+    CLog::Log(LOGDEBUG, "VideoSyncWpPresentation: refresh rate unknown");
+    return false;
+  }
 
   return true;
 }
