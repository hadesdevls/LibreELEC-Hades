-  return window->RenderPlainMapping(layer, plain, m_sourceRect, m_destRect, buffer.doviSerial);
-}
-
-int CRendererVAAPIGLES::RenderHdr10Tunnel(int idx)
+/*!
+ * \brief Hades: the planes of a picture of a VAAPI surface as the bridge imports them: the layout,
+ *        the size, where its chroma samples are and its two textures (\a planes: those of the
+ *        whole frame, CPictureBuffer::fields[FIELD_FULL]), for RenderDVConversion(),
+ *        RenderPlainMapping() and RenderHdr10Tunnel()
+ * \return false for a layout that the bridge does not take (the layer is then not to be used)
+ */
+template<typename Planes>
+bool PlanesOf(std::int32_t vaapiFourcc,
+              unsigned int width,
+              unsigned int height,
+              AVChromaLocation chroma,
+              const Planes& planes,
+              CDVBridgeGLES::Layer& layer)
 {
-  // Hades: an HDR picture of a VAAPI surface drawn as it is into the tunnel: its planes and its
-  // colour as
-  // RenderPlainMapping() takes them, the place that Kodi gives it as for a picture mapped to SDR
-  if (!m_isVAAPIBuffer || m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0)
-    return -1;
-  auto* window =
-      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
-  if (!window)
-    return -1;
-  const auto& buffer = m_buffers[idx];
-  CDVBridgeGLES::Layer layer{};
-  switch (m_vaapiFourcc)
+  switch (vaapiFourcc)
   {
     case VA_FOURCC_NV12:
       layer.layout = DVBRIDGE_NV12;
@@ -324,17 +282,25 @@ int CRendererVAAPIGLES::RenderHdr10Tunnel(int idx)
       layer.layout = DVBRIDGE_P016;
       break;
     default:
-      return -1;
+      return false;
   }
-  layer.width = m_sourceWidth;
-  layer.height = m_sourceHeight;
-  layer.chroma = buffer.doviChroma;
+  layer.width = width;
+  layer.height = height;
+  layer.chroma = chroma;
   for (int p = 0; p < 2; ++p)
   {
-    const auto& plane = buffer.fields[FIELD_FULL][p];
+    const auto& plane = planes[p];
     layer.planes[p] = {plane.id, static_cast<int>(plane.texwidth),
                        static_cast<int>(plane.texheight)};
   }
+  return true;
+}
+
+//! Hades: ... and the colour of a picture that is drawn as it is (RenderPlainMapping(),
+//! RenderHdr10Tunnel()): its transfer, its range and its HDR10 metadata (0 where not known)
+template<typename Buffer>
+dvbridge_plain PlainColourOf(const Buffer& buffer)
+{
   dvbridge_plain plain{};
   plain.hlg = buffer.m_srcColTransfer == AVCOL_TRC_ARIB_STD_B67;
   plain.full_range = buffer.m_srcFullRange;
@@ -349,7 +315,45 @@ int CRendererVAAPIGLES::RenderHdr10Tunnel(int idx)
     plain.max_cll = static_cast<float>(buffer.lightMetadata.MaxCLL);
     plain.max_fall = static_cast<float>(buffer.lightMetadata.MaxFALL);
   }
-  return window->RenderHdr10Tunnel(layer, plain, m_sourceRect, m_destRect);
+  return plain;
+}
+} // namespace
+
+int CRendererVAAPIGLES::RenderPlainMapping(int idx)
+{
+  // its planes and its colour (PlanesOf(), PlainColourOf())
+  if (!m_isVAAPIBuffer || m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0)
+    return -1;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return -1;
+  const auto& buffer = m_buffers[idx];
+  CDVBridgeGLES::Layer layer{};
+  if (!PlanesOf(m_vaapiFourcc, m_sourceWidth, m_sourceHeight, buffer.doviChroma,
+                buffer.fields[FIELD_FULL], layer))
+    return -1;
+  return window->RenderPlainMapping(layer, PlainColourOf(buffer), m_sourceRect, m_destRect,
+                                    buffer.doviSerial);
+}
+
+int CRendererVAAPIGLES::RenderHdr10Tunnel(int idx)
+{
+  // Hades: an HDR picture of a VAAPI surface drawn as it is into the tunnel: its planes and its
+  // colour as RenderPlainMapping() takes them, the place that Kodi gives it as for a picture mapped
+  // to SDR
+  if (!m_isVAAPIBuffer || m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0)
+    return -1;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return -1;
+  const auto& buffer = m_buffers[idx];
+  CDVBridgeGLES::Layer layer{};
+  if (!PlanesOf(m_vaapiFourcc, m_sourceWidth, m_sourceHeight, buffer.doviChroma,
+                buffer.fields[FIELD_FULL], layer))
+    return -1;
+  return window->RenderHdr10Tunnel(layer, PlainColourOf(buffer), m_sourceRect, m_destRect);
 }
 
 int CRendererVAAPIGLES::RenderDVConversion(int idx)
