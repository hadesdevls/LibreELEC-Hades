diff --git a/xbmc/windowing/gbm/DVPeak.h b/xbmc/windowing/gbm/DVPeak.h
new file mode 100644
index 0000000..c3307cd
--- /dev/null
+++ b/xbmc/windowing/gbm/DVPeak.h
@@ -0,0 +1,49 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The 12-bit PQ level (SMPTE ST 2084) of a luminance in cd/m2, the unit in which the Dolby
+ *        block of an EDID gives the peak of a display (a version 2 block) and the content mapping
+ *        v4.0 of the bridge is decided against it (dvbridge_set_cm40())
+ */
+inline unsigned int NitsToPqLevel(double nits)
+{
+  const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128, c1 = 3424.0 / 4096,
+               c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+  const double y = std::pow(std::clamp(nits, 0.0, 10000.0) / 10000.0, m1);
+  return static_cast<unsigned int>(std::lround(4095 * std::pow((c1 + c2 * y) / (1 + c3 * y), m2)));
+}
+
+/*!
+ * \brief The peak that the content mapping v4.0 is decided against
+ * \param declaredPq the peak that the display's Dolby block declares, as a 12-bit PQ level (0: it
+ *        declares none)
+ * \param manual the peak is set by hand (videoscreen.hadesdvcm40manual), for a TV whose block
+ *        declares a wrong one
+ * \param manualNits that peak, cd/m2, taken within what the setting allows
+ */
+inline unsigned int Cm40Peak(unsigned int declaredPq, bool manual, int manualNits)
+{
+  return manual ? NitsToPqLevel(std::clamp(manualNits, 40, 4000)) : declaredPq;
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index e673cb6..8a79d46 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -8,6 +8,7 @@
 
 #include "WinSystemGbmGLESContext.h"
 
+#include "DVPeak.h"
 #include "GPUPowerProfile.h"
 #include "GPUSensors.h"
 #include "LangInfo.h"
@@ -4746,13 +4747,24 @@ void CWinSystemGbmGLESContext::DVNativeOutputBegins()
     if (dv.valid && dv.version == 2)
       peak = dv.targetMaxPq;
     else if (dv.valid && dv.targetMaxNits > 0)
-    {
       // (a version 1 block gives cd/m2: as a 12-bit PQ level, SMPTE ST 2084)
-      const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128, c1 = 3424.0 / 4096,
-                   c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
-      const double y = std::pow(std::min(10000.0, static_cast<double>(dv.targetMaxNits)) / 10000.0, m1);
-      peak = static_cast<unsigned int>(
-          std::lround(4095 * std::pow((c1 + c2 * y) / (1 + c3 * y), m2)));
+      peak = NitsToPqLevel(dv.targetMaxNits);
+    // Hades: ... or the peak set by hand, for a TV whose Dolby block declares a wrong one
+    // (videoscreen.hadesdvcm40manual)
+    if (BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVCM40MANUAL, false))
+    {
+      const int nits = settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVCM40PEAK)
+                           ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVCM40PEAK)
+                           : 1000;
+      const unsigned int declared = peak;
+      peak = Cm40Peak(declared, true, nits);
+      CLog::Log(LOGINFO,
+                "DVBridge: the content mapping v4.0 is decided against a peak of {} cd/m2 set by "
+                "hand (videoscreen.hadesdvcm40peak), not the {} that the Dolby block of the TV "
+                "declares",
+                std::clamp(nits, 40, 4000),
+                declared ? StringUtils::Format("{:.0f} cd/m2", UTILS::PqLevelToNits(declared))
+                         : std::string("none"));
     }
     m_dvBridge->UseContentMapping(mode, peak);
   }
