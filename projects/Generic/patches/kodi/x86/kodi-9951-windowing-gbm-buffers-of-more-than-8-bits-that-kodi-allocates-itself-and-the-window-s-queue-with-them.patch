+/*!
+ * \brief Hades: which of a few buffers a frame is drawn into, and which are held for the screen,
+ * as a gbm_surface does with its own (GBMUtils.h, IOwnBuffers): the buffer drawn last becomes the
+ * front one when the frame is swapped; Kodi locks the front one for its commit and gives a locked
+ * one back when it no longer holds it (two at most: the one on the screen and the one whose flip
+ * comes next, CGBMSurface::LockFrontBuffer()); the next frame is drawn into one that is neither,
+ * chosen only when it is needed (Back()), after Kodi has given back what it gives back.
+ * No GL and no GBM: what the indices stand for is the caller's.
+ */
+class COwnBufferRing
+{
+public:
+  explicit COwnBufferRing(unsigned int count) : m_buffers(count) {}
+
+  unsigned int Count() const { return static_cast<unsigned int>(m_buffers.size()); }
+
+  //! The buffer the next frame is drawn into: the one chosen before, or one that is neither held
+  //! nor the front one; -1 when there is none
+  int Back()
+  {
+    if (m_back >= 0)
+      return m_back;
+    for (unsigned int i = 0; i < m_buffers.size(); ++i)
+    {
+      const unsigned int index = (m_next + i) % m_buffers.size();
+      if (Free(index))
+      {
+        m_back = static_cast<int>(index);
+        m_next = (index + 1) % m_buffers.size();
+        return m_back;
+      }
+    }
+    return -1;
+  }
+
+  //! The frame drawn into the back buffer is done: it becomes the front one (a front one that was
+  //! never locked is free again, as with eglSwapBuffers() twice). False when there was no back
+  //! buffer.
+  bool Swap()
+  {
+    if (m_back < 0)
+      return false;
+    m_front = m_back;
+    m_back = -1;
+    return true;
+  }
+
+  //! The front buffer, locked; when none was swapped since the last lock, the one locked last
+  //! again; -1 when none was ever swapped
+  int LockFront()
+  {
+    if (m_front >= 0)
+    {
+      m_lastLocked = m_front;
+      m_front = -1;
+    }
+    if (m_lastLocked >= 0)
+      ++m_buffers[m_lastLocked].locks;
+    return m_lastLocked;
+  }
+
+  //! One lock of the buffer is given back
+  void Release(int index)
+  {
+    if (index >= 0 && index < static_cast<int>(m_buffers.size()) && m_buffers[index].locks > 0)
+      --m_buffers[index].locks;
+  }
+
+  //! A buffer is left to draw the next frame into (or was chosen for it already)
+  bool HasFree() const
+  {
+    if (m_back >= 0)
+      return true;
+    for (unsigned int i = 0; i < m_buffers.size(); ++i)
+      if (Free(i))
+        return true;
+    return false;
+  }
+
+  //! No buffer is locked
+  bool Unlocked() const
+  {
+    for (const auto& buffer : m_buffers)
+      if (buffer.locks > 0)
+        return false;
+    return true;
+  }
+
+  unsigned int Locks(unsigned int index) const { return m_buffers[index].locks; }
+  int BackIndex() const { return m_back; }
+  int FrontIndex() const { return m_front; }
+
+private:
+  bool Free(unsigned int index) const
+  {
+    return m_buffers[index].locks == 0 && static_cast<int>(index) != m_front &&
+           static_cast<int>(index) != m_back;
+  }
+
+  struct Buffer
+  {
+    unsigned int locks{0};
+  };
+  std::vector<Buffer> m_buffers;
+  int m_back{-1};
+  int m_front{-1};
+  int m_lastLocked{-1};
+  unsigned int m_next{0};
+};
+
+/*!
+ * \brief Hades: what describes a buffer to import into EGL (EGL_EXT_image_dma_buf_import)
+ */
+struct OwnDmaBuf
+{
+  uint32_t fourcc{0};
+  int width{0};
+  int height{0};
+  int planes{0};
+  int fd[4]{-1, -1, -1, -1};
+  uint32_t offset[4]{};
+  uint32_t pitch[4]{};
+  uint64_t modifier{0};
+  //! the modifier is said to EGL (EGL_EXT_image_dma_buf_import_modifiers); not for a buffer that
+  //! was made without one (DRM_FORMAT_MOD_INVALID)
+  bool hasModifier{false};
+};
+
+/*!
+ * \brief Hades: buffers of more than 8 bits that Kodi allocates itself (GBM, for scanout and
+ * rendering) and draws into through framebuffer objects, where the EGL of the driver offers no
+ * window of more than 8 bits while the planes take such buffers (nvidia-drm with the 580 driver:
+ * AB30, XB30 and AB4H planes, EGL windows of 8 bits). They stand for the buffers of the window
+ * (IOwnBuffers): the frame is drawn into the framebuffer of the back buffer
+ * (KODI::RENDERING::OutputFramebuffer()), "swapped" (Swap()), and Kodi's commit takes the front
+ * buffer, as it takes one of the window's (CGBMSurface::LockFrontBuffer()).
+ * GLES only. Made and destroyed on the render thread, with its GL context current.
+ */
+class COwnScanout : public IOwnBuffers
+{
+public:
+  //! Buffers, as many as Kodi holds of the window on nvidia-drm: one on the screen, one whose flip
+  //! comes next, and one drawn into
+  static constexpr unsigned int BUFFERS = 3;
+
+  ~COwnScanout() override;
+
+  /*!
+   * \brief Buffers of this format, each imported into EGL, bound to a framebuffer object, and
+   * checked: the framebuffer is complete, and keeps values of more than 8 bits (Probe())
+   * \param modifiers those the plane takes for the format (none: linear, or the driver's choice)
+   * \param[out] failed which step failed, in plain words
+   * \return nullptr when a step failed; nothing is left of what was made
+   */
+  static std::shared_ptr<COwnScanout> Create(gbm_device* device,
+                                             EGLDisplay display,
+                                             int width,
+                                             int height,
+                                             uint32_t format,
+                                             const std::vector<uint64_t>& modifiers,
+                                             std::string& failed);
+
+  //! The format is one these buffers can be made of (10-bit or half-float RGB)
+  static bool Supported(uint32_t format);
+  //! Bits of each component of the format (10, or 16 for half floats; 0 when not Supported())
+  static int Bits(uint32_t format);
+  static bool IsFloat(uint32_t format);
+
+  // Steps of Create(), on their own for the test of the host (and for nothing else)
+  //! \brief An EGL image of the buffer that the descriptor names (the fds are not taken)
+  static EGLImageKHR ImportDmaBuf(EGLDisplay display, const OwnDmaBuf& buffer, std::string& failed);
+  //! \brief A renderbuffer of the image and a framebuffer object with it; complete, or nothing
+  static bool MakeTarget(EGLImageKHR image, unsigned int& renderbuffer, unsigned int& framebuffer,
+                         std::string& failed);
+  //! \brief Four pixels of the framebuffer cleared to values that 8 bits cannot hold, read back:
+  //! the same values, or the step that failed. The framebuffer is then cleared to black. The GL
+  //! state that it touches is put back.
+  static bool Probe(unsigned int framebuffer, bool floating, std::string& failed);
+
+  // IOwnBuffers (the GBM surface of the window, CGBMSurface)
+  gbm_bo* LockFront() override;
+  void Release(gbm_bo* bo) override;
+  bool HasFree() const override { return m_ring.HasFree(); }
+
+  //! The frame drawn is done: its buffer is the front one. Its GPU work is flushed, or finished
+  //! when \p finish (no fence of it goes to the commit).
+  bool Swap(bool finish);
+  //! The framebuffer of the buffer that the next frame is drawn into is bound, and is the one
+  //! that stands for the window (OutputFramebuffer()); false when none is free (then nothing is
+  //! bound)
+  bool BindBack();
+  //! The window's framebuffer (0) is bound again, and stands for the window again
+  static void UnbindAll();
+
+  //! The first buffer, for the driver's test before anything is shown through these
+  gbm_bo* FirstBuffer() const { return m_buffers.empty() ? nullptr : m_buffers.front().bo; }
+  uint32_t Format() const { return m_format; }
+  uint64_t Modifier() const { return m_modifier; }
+  int OutputBits() const { return Bits(m_format); }
+  bool Floating() const { return IsFloat(m_format); }
+  //! No buffer is held by Kodi's queue any more
+  bool Unlocked() const { return m_ring.Unlocked(); }
+
+private:
+  COwnScanout() : m_ring(BUFFERS) {}
+
+  struct Buffer
+  {
+    gbm_bo* bo{nullptr};
+    EGLImageKHR image{EGL_NO_IMAGE_KHR};
+    unsigned int renderbuffer{0};
+    unsigned int framebuffer{0};
+  };
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  uint32_t m_format{0};
+  uint64_t m_modifier{0};
+  std::vector<Buffer> m_buffers;
+  COwnBufferRing m_ring;
+};
+
