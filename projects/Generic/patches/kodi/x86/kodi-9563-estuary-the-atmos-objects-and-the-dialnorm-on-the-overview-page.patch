From 963606ef7ad125a6e6dc4bcffe2b76e733264ff5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:22:45 +0000
Subject: [PATCH] Estuary: the Atmos objects and the dialnorm on the overview
 page

Two rows under the layout of the audio, each shown only while the stream
says it: "Atmos: bed 7.1.2 + 9 objects" (Player.Process(audiobedlayout)
and audio.object.count) and "Dialnorm: -27 dB" (audio.dialnorm).
system/hades made again with tools/hades-playerinfo/make-playerinfo.py.
---
 .../resource.language.en_gb/strings.po        | 24 ++++++
 .../resource.language.es_ar/strings.po        | 24 ++++++
 .../resource.language.es_es/strings.po        | 24 ++++++
 .../resource.language.es_mx/strings.po        | 24 ++++++
 .../xml/DialogPlayerProcessInfo.xml           | 10 +++
 addons/skin.estuary/xml/Variables.xml         |  4 +
 system/hades/DialogHadesPlayerInfo.xml        | 74 +++++++++++++++++++
 system/hades/HadesIncludes.xml                |  3 +
 8 files changed, 187 insertions(+)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index 127c572..33f7420 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -3033,6 +3033,30 @@ msgctxt "#32240"
 msgid "Dolby Vision made from its HDR10+ metadata"
 msgstr ""
 
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row on the overview page: the beds and the objects of the Dolby Atmos audio that plays, as its object audio metadata gives them (Player.Process(audio.object.count))
+msgctxt "#32250"
+msgid "Atmos"
+msgstr ""
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Word before the layout of the beds in that row: "bed 7.1.2 + 9 objects"
+msgctxt "#32251"
+msgid "bed"
+msgstr ""
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Word after the number of dynamic objects in that row: "bed 7.1.2 + 9 objects"
+msgctxt "#32252"
+msgid "objects"
+msgstr ""
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row on the overview page: the dialogue level (dialnorm) that the audio stream says it has, as "-27 dB" (Player.Process(audio.dialnorm))
+msgctxt "#32253"
+msgid "Dialnorm"
+msgstr ""
+
 #: system/settings/settings.xml
 #. Setting label: a refresh rate that is a whole-number multiple of the frame rate of a video keeps the mode the display is in (core #39815)
 msgctxt "#32265"
