From 17dd983437358b7221f52d387ba0c49ae081d67e Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Fri, 23 Oct 2026 03:54:28 -0700
Subject: [PATCH] [cmake] Fix Visual Studio ccache builds

Keep Kodi sources aggregated in an object library and suppress the unused
MSBuild archive to avoid the /Z7 archive size limit without creating
per-directory projects.

Allow dependency installation when embedded debug information produces no
compiler PDB.
---
 CMakeLists.txt                                        | 7 +++++++
 cmake/modules/buildtools/FindCCache.cmake             | 2 --
 cmake/scripts/windows/ObjectLibrary.props             | 5 +++++
 tools/depends/target/libmicrohttpd/01-win-cmake.patch | 4 ++--
 tools/depends/target/taglib/001-cmake-pdb-debug.patch | 4 ++--
 tools/depends/target/tinyxml2/001-debug-pdb.patch     | 4 ++--
 6 files changed, 18 insertions(+), 8 deletions(-)
 create mode 100644 cmake/scripts/windows/ObjectLibrary.props

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a2fe823..6a72e7a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -453,6 +453,13 @@ if(CORE_SYSTEM_NAME STREQUAL "darwin_embedded")
   add_library(lib${APP_NAME_LC} STATIC)
   add_dependencies(lib${APP_NAME_LC} compileinfo)
   target_link_libraries(lib${APP_NAME_LC} PUBLIC compileinfo_obj)
+elseif(CCACHE_FOUND AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND
+       CMAKE_GENERATOR MATCHES "Visual Studio")
+  # Embedded debug information can exceed the static archive size limit.
+  add_library(lib${APP_NAME_LC} OBJECT)
+  set_target_properties(lib${APP_NAME_LC} PROPERTIES
+    VS_USER_PROPS "${CMAKE_SOURCE_DIR}/cmake/scripts/windows/ObjectLibrary.props")
+  target_link_libraries(lib${APP_NAME_LC} PUBLIC $<TARGET_OBJECTS:compileinfo>)
 else()
   add_library(lib${APP_NAME_LC} STATIC $<TARGET_OBJECTS:compileinfo>)
 endif()
diff --git a/cmake/modules/buildtools/FindCCache.cmake b/cmake/modules/buildtools/FindCCache.cmake
index 043efcb..75c6f71 100644
--- a/cmake/modules/buildtools/FindCCache.cmake
+++ b/cmake/modules/buildtools/FindCCache.cmake
@@ -70,8 +70,6 @@ if(CCACHE_FOUND)
   if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_GENERATOR MATCHES "Visual Studio")
     include(${CMAKE_CURRENT_LIST_DIR}/../../scripts/windows/CCache.cmake)
     set(CMAKE_CXX_SCAN_FOR_MODULES OFF PARENT_SCOPE)
-    # Embedded debug information can exceed the archive size limit.
-    set(ENABLE_STATIC_LIBS TRUE PARENT_SCOPE)
     foreach(_variable IN LISTS _ccache_variables)
       set(${_variable} "${${_variable}}" PARENT_SCOPE)
     endforeach()
diff --git a/cmake/scripts/windows/ObjectLibrary.props b/cmake/scripts/windows/ObjectLibrary.props
new file mode 100644
index 0000000..1b4bfb9
--- /dev/null
+++ b/cmake/scripts/windows/ObjectLibrary.props
@@ -0,0 +1,5 @@
+<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <PropertyGroup>
+    <LibCompiled>false</LibCompiled>
+  </PropertyGroup>
+</Project>
diff --git a/tools/depends/target/libmicrohttpd/01-win-cmake.patch b/tools/depends/target/libmicrohttpd/01-win-cmake.patch
index 83b29e7..56c76e3 100644
--- a/tools/depends/target/libmicrohttpd/01-win-cmake.patch
+++ b/tools/depends/target/libmicrohttpd/01-win-cmake.patch
@@ -102,8 +102,8 @@
 +
 +if(MSVC)
 +  set_target_properties(libmicrohttpd PROPERTIES COMPILE_PDB_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR} COMPILE_PDB_NAME libmicrohttpd COMPILE_PDB_NAME_DEBUG libmicrohttpd_d)
-+  install(FILES ${PROJECT_BINARY_DIR}/RelWithDebInfo/libmicrohttpd.pdb DESTINATION lib CONFIGURATIONS RelWithDebInfo)
-+  install(FILES ${PROJECT_BINARY_DIR}/Debug/libmicrohttpd_d.pdb DESTINATION lib CONFIGURATIONS Debug)
++  install(FILES ${PROJECT_BINARY_DIR}/RelWithDebInfo/libmicrohttpd.pdb DESTINATION lib CONFIGURATIONS RelWithDebInfo OPTIONAL)
++  install(FILES ${PROJECT_BINARY_DIR}/Debug/libmicrohttpd_d.pdb DESTINATION lib CONFIGURATIONS Debug OPTIONAL)
 +endif()
 +
 +include(CMakePackageConfigHelpers)
diff --git a/tools/depends/target/taglib/001-cmake-pdb-debug.patch b/tools/depends/target/taglib/001-cmake-pdb-debug.patch
index 895ac09..09974cf 100644
--- a/tools/depends/target/taglib/001-cmake-pdb-debug.patch
+++ b/tools/depends/target/taglib/001-cmake-pdb-debug.patch
@@ -17,8 +17,8 @@
 +
 +if(MSVC)
 +  set_target_properties(tag PROPERTIES COMPILE_PDB_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR} COMPILE_PDB_NAME tag COMPILE_PDB_NAME_DEBUG tagd)
-+  install(FILES ${PROJECT_BINARY_DIR}/RelWithDebInfo/tag.pdb DESTINATION lib CONFIGURATIONS RelWithDebInfo)
-+  install(FILES ${PROJECT_BINARY_DIR}/Debug/tagd.pdb DESTINATION lib CONFIGURATIONS Debug)
++  install(FILES ${PROJECT_BINARY_DIR}/RelWithDebInfo/tag.pdb DESTINATION lib CONFIGURATIONS RelWithDebInfo OPTIONAL)
++  install(FILES ${PROJECT_BINARY_DIR}/Debug/tagd.pdb DESTINATION lib CONFIGURATIONS Debug OPTIONAL)
 +endif(MSVC)
  
  set_target_properties(tag PROPERTIES
diff --git a/tools/depends/target/tinyxml2/001-debug-pdb.patch b/tools/depends/target/tinyxml2/001-debug-pdb.patch
index cc39d18..59333a1 100644
--- a/tools/depends/target/tinyxml2/001-debug-pdb.patch
+++ b/tools/depends/target/tinyxml2/001-debug-pdb.patch
@@ -17,12 +17,12 @@
 +  install(FILES
 +      ${PROJECT_BINARY_DIR}/Debug/tinyxml2d.pdb
 +      DESTINATION lib
-+      CONFIGURATIONS Debug
++      CONFIGURATIONS Debug OPTIONAL
 +  )
 +  install(FILES
 +      ${PROJECT_BINARY_DIR}/RelWithDebInfo/tinyxml2.pdb
 +      DESTINATION lib
-+      CONFIGURATIONS RelWithDebInfo
++      CONFIGURATIONS RelWithDebInfo OPTIONAL
 +  )
 +endif()
 +
