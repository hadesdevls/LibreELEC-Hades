From 406d6f6f455f08b5160dad6a32aed55f650dc54f Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 13 Oct 2026 05:40:00 -0700
Subject: [PATCH] [cmake][osx] Fix Xcode 27 builds

Preserve the depends deployment target across CMake initialization and
allow macOS 11 builds with the macOS 27 SDK, including compiler checks.

Use the toolchain ccache launcher for Exiv2 so Xcode builds do not
depend on the shell PATH.
---
 cmake/modules/FindExiv2.cmake           | 5 ++++-
 tools/depends/target/Toolchain.cmake.in | 9 ++++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/cmake/modules/FindExiv2.cmake b/cmake/modules/FindExiv2.cmake
index 5e1425c..675efe6 100644
--- a/cmake/modules/FindExiv2.cmake
+++ b/cmake/modules/FindExiv2.cmake
@@ -48,7 +48,10 @@ if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
                    -DEXIV2_BUILD_EXIV2_COMMAND=OFF
                    ${EXTRA_ARGS})
 
-    if(NOT CMAKE_CXX_COMPILER_LAUNCHER STREQUAL "")
+    if(XCODE)
+      # Exiv2's ccache wrapper relies on PATH; use the toolchain's absolute launcher.
+      list(APPEND CMAKE_ARGS -DBUILD_WITH_CCACHE=OFF)
+    elseif(NOT CMAKE_CXX_COMPILER_LAUNCHER STREQUAL "")
       list(APPEND CMAKE_ARGS -DBUILD_WITH_CCACHE=ON)
     endif()
 
diff --git a/tools/depends/target/Toolchain.cmake.in b/tools/depends/target/Toolchain.cmake.in
index 1ac59be..77b4641 100644
--- a/tools/depends/target/Toolchain.cmake.in
+++ b/tools/depends/target/Toolchain.cmake.in
@@ -67,7 +67,14 @@ if(CORE_SYSTEM_NAME STREQUAL darwin_embedded)
 endif()
 
 if(CMAKE_SYSTEM_NAME STREQUAL Darwin)
-  set(CMAKE_OSX_DEPLOYMENT_TARGET @target_minver@)
+  if(NOT CORE_SYSTEM_NAME STREQUAL osx OR NOT DEFINED CMAKE_OSX_DEPLOYMENT_TARGET)
+    set(CMAKE_OSX_DEPLOYMENT_TARGET @target_minver@)
+  endif()
+  if(CORE_SYSTEM_NAME STREQUAL osx AND XCODE AND
+     XCODE_VERSION VERSION_GREATER_EQUAL 27 AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 12.0)
+    set(CMAKE_OSX_DEPLOYMENT_TARGET 12.0)
+  endif()
+  set(CMAKE_OSX_DEPLOYMENT_TARGET ${CMAKE_OSX_DEPLOYMENT_TARGET} CACHE STRING "Minimum OS deployment version" FORCE)
   set(CMAKE_OSX_SYSROOT @use_sdk_path@)
   set(CMAKE_XCODE_ATTRIBUTE_ARCHS ${CPU})
 endif()
