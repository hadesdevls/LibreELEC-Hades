From fee26287ddedcb1806e85df07e8fade4ff22aeff Mon Sep 17 00:00:00 2001
From: Kevin Goffe <HitcherUK@gmail.com>
Date: Fri, 16 Oct 2026 17:22:24 +0100
Subject: [PATCH] [Estuary] Avoid duplicate version names in asset folders

---
 addons/skin.estuary/xml/Variables.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index f047f74..2d0b142 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -80,7 +80,7 @@
 		<value>$INFO[ListItem.Icon]</value>
 	</variable>
 	<variable name="ListLabelVar">
-		<value condition="!String.IsEmpty(ListItem.VideoVersionName) + [!ListItem.HasVideoVersions | System.GetBool(videolibrary.flattenversions)] + !String.IsEqual(ListItem.VideoVersionName,$LOCALIZE[40400])">$VAR[ListLabelTitleVar]$INFO[ListItem.VideoVersionName, [COLOR grey][,][/COLOR]]</value>
+		<value condition="!$EXP[videoasset_true] + !String.IsEmpty(ListItem.VideoVersionName) + [!ListItem.HasVideoVersions | System.GetBool(videolibrary.flattenversions)] + !String.IsEqual(ListItem.VideoVersionName,$LOCALIZE[40400])">$VAR[ListLabelTitleVar]$INFO[ListItem.VideoVersionName, [COLOR grey][,][/COLOR]]</value>
 		<value condition="ListItem.HasVideoVersions + Window.IsActive(videoplaylist)">$INFO[ListItem.Label]$INFO[ListItem.VideoVersionName, [I](,)[/I]]</value>
 		<value condition="String.IsEqual(ListItem.DbType,episode) + Window.IsActive(videoplaylist)">$INFO[ListItem.TVShowtitle,,: ]$INFO[ListItem.Season,,x]$INFO[ListItem.Episode,,. ]$INFO[ListItem.Title]</value>
 		<value condition="String.IsEqual(ListItem.DbType,musicvideo) + Window.IsActive(videoplaylist)">$INFO[ListItem.Artist,, - ]$INFO[ListItem.Title]</value>
-- 
2.53.0

