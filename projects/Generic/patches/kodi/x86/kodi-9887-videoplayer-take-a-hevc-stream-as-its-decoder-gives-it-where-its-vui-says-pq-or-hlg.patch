+// Hades: the pictures of a HEVC stream have the colour description of the VUI of its sequence
+// parameter sets wherever it has one (its decoder, PROGRESSIVE_VIDEO::HevcVuiColour()), but
+// libavformat leaves the container's in the parameters of the stream. A Matroska or MP4 file that
+// says BT.2020-10 (or BT.709, or no transfer) for a stream whose VUI says HLG was HLG on the display
+// but SDR for everything decided before its first picture: its HDR type, the change of mode held for
+// its HDR signalling, HLG sent as Dolby Vision, the whole-number multiples of its frame rate, the
+// library. Where the VUI says PQ or HLG and the container another transfer, the stream is taken as
+// its decoder gives it. Not the other way round: a VUI of BT.2020-10 (or BT.709) where the container
+// says HLG is how an HLG stream speaks to decoders that do not know HLG, with an alternative transfer
+// characteristics SEI in its packets that says HLG (DVB's HLG10: CDVHdr10Plus), so the container's
+// HLG stays, and the log says so. Nothing else changes.
+void CDVDDemuxFFmpeg::TakeDecoderColour(AVStream* pStream)
+{
+  AVCodecParameters* par = pStream->codecpar;
+  if (par->codec_id != AV_CODEC_ID_HEVC || !par->extradata || par->extradata_size <= 0)
+    return;
+  const std::optional<PROGRESSIVE_VIDEO::Colour> vui =
+      PROGRESSIVE_VIDEO::HevcVuiColour(par->extradata, static_cast<size_t>(par->extradata_size));
+  if (!vui || vui->transfer == par->color_trc)
+    return;
+  const auto hdr = [](int transfer)
+  { return transfer == AVCOL_TRC_SMPTE2084 || transfer == AVCOL_TRC_ARIB_STD_B67; };
+  const auto name = [](int transfer)
+  {
+    const char* n = av_color_transfer_name(static_cast<AVColorTransferCharacteristic>(transfer));
+    return n ? n : "?";
+  };
+  if (!hdr(vui->transfer))
+  {
+    if (hdr(par->color_trc))
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg: stream {}: the container says the transfer {} and the VUI of its "
+                "HEVC sequence parameter set {}: the container's is kept (an alternative transfer "
+                "characteristics SEI in its packets may say HLG, as DVB's HLG10 does)",
+                pStream->index, name(par->color_trc), name(vui->transfer));
+    return;
+  }
+  CLog::Log(
+      LOGINFO,
+      "CDVDDemuxFFmpeg: stream {}: the container says the transfer {} (primaries {}, matrix "
+      "{}) and the VUI of its HEVC sequence parameter set {} (primaries {}, matrix {}), which "
+      "its decoder gives its pictures: taken as the VUI says",
+      pStream->index, name(par->color_trc), static_cast<int>(par->color_primaries),
+      static_cast<int>(par->color_space), name(vui->transfer), vui->primaries, vui->matrix);
+  par->color_primaries = static_cast<AVColorPrimaries>(vui->primaries);
+  par->color_trc = static_cast<AVColorTransferCharacteristic>(vui->transfer);
+  par->color_space = static_cast<AVColorSpace>(vui->matrix);
+}
+
 StreamHdrType CDVDDemuxFFmpeg::DetermineHdrType(AVStream* pStream)
 {
   StreamHdrType hdrType = StreamHdrType::HDR_TYPE_NONE;
