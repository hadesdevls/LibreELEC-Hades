index 1e15f1e..9358e5a 100644
--- a/xbmc/utils/ProgressiveVideo.h
+++ b/xbmc/utils/ProgressiveVideo.h
@@ -9,6 +9,7 @@
 
 #include <cstddef>
 #include <cstdint>
+#include <optional>
 #include <string_view>
 
 extern "C"
@@ -44,4 +45,31 @@ struct Result
  * a stream without them, an unparsable one or any other codec is not progressive
  */
 Result Check(AVCodecID codec, const uint8_t* extradata, size_t size);
+
+//! Hades: a colour description of H.273 (the values of AVColorPrimaries, AVColorTransferCharacteristic
+//! and AVColorSpace)
+struct Colour
+{
+  int primaries{0};
+  int transfer{0};
+  int matrix{0};
+
+  bool operator==(const Colour&) const = default;
+};
+
+/*!
+ * \brief Hades: the colour description that FFmpeg's HEVC decoder gives every picture of a stream,
+ *        from the VUI of its sequence parameter sets, known before its first picture
+ *
+ * FFmpeg 9's decoder takes the primaries, the transfer and the matrix of the VUI wherever it has a
+ * colour description (hevc/hevcdec.c, export_stream_params()), whatever the container said, and a
+ * value that libavutil does not name as unspecified (h2645_vui.c); an alternative transfer
+ * characteristics SEI in the packets may still change the transfer (CDVHdr10Plus). Read with the
+ * parse of Check().
+ *
+ * \param extradata the codec's parameter sets (hvcC or Annex B), as FFmpeg reads them
+ * \return the description where every sequence parameter set in it has one and they all agree;
+ * nothing where one has none, one is cut or invalid, one is of another layer, or there is none
+ */
+std::optional<Colour> HevcVuiColour(const uint8_t* extradata, size_t size);
 } // namespace PROGRESSIVE_VIDEO
