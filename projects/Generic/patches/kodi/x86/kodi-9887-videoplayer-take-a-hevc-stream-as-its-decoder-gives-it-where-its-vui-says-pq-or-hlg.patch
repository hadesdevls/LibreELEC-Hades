@@ -23,6 +28,7 @@
 
 namespace
 {
+using PROGRESSIVE_VIDEO::Colour;
 using PROGRESSIVE_VIDEO::Result;
 
 constexpr unsigned int H264_NAL_SPS = 7;
@@ -161,8 +167,9 @@ std::vector<std::span<const uint8_t>> AnnexBNals(std::span<const uint8_t> data)
 
 // The part of the VUI common to H.264 and HEVC (ff_h2645_decode_common_vui_params). The chroma
 // sample locations go up to 5; FFmpeg reads them with get_ue_golomb_31(), which takes a longer code
-// with other bits, so a larger value fails here.
-bool SkipCommonVui(CRbspReader& br)
+// with other bits, so a larger value fails here. Hades: the colour description, where it has one,
+// with its reserved values and those libavutil does not name as unspecified, as FFmpeg sets them.
+bool SkipCommonVui(CRbspReader& br, std::optional<Colour>* colour = nullptr)
 {
   if (br.Bit() && br.Bits(8) == 255) // aspect_ratio_info_present_flag, aspect_ratio_idc
     br.Skip(32); // sar_width, sar_height
@@ -172,7 +179,25 @@ bool SkipCommonVui(CRbspReader& br)
   {
     br.Skip(4); // video_format, video_full_range_flag
     if (br.Bit()) // colour_description_present_flag
-      br.Skip(24); // colour_primaries, transfer_characteristics, matrix_coeffs
+    {
+      Colour description;
+      description.primaries = static_cast<int>(br.Bits(8)); // colour_primaries
+      description.transfer = static_cast<int>(br.Bits(8)); // transfer_characteristics
+      description.matrix = static_cast<int>(br.Bits(8)); // matrix_coeffs
+      if (description.primaries == AVCOL_PRI_RESERVED0 ||
+          description.primaries == AVCOL_PRI_RESERVED ||
+          !av_color_primaries_name(static_cast<AVColorPrimaries>(description.primaries)))
+        description.primaries = AVCOL_PRI_UNSPECIFIED;
+      if (description.transfer == AVCOL_TRC_RESERVED0 ||
+          description.transfer == AVCOL_TRC_RESERVED ||
+          !av_color_transfer_name(static_cast<AVColorTransferCharacteristic>(description.transfer)))
+        description.transfer = AVCOL_TRC_UNSPECIFIED;
+      if (description.matrix == AVCOL_SPC_RESERVED ||
+          !av_color_space_name(static_cast<AVColorSpace>(description.matrix)))
+        description.matrix = AVCOL_SPC_UNSPECIFIED;
+      if (colour)
+        *colour = description;
+    }
   }
   if (br.Bit()) // chroma_loc_info_present_flag
   {
@@ -430,11 +455,21 @@ void SkipHevcProfileTierLevel(CRbspReader& br, unsigned int maxSubLayersMinus1)
   }
 }
 
-Result HevcSps(std::span<const uint8_t> nal)
+// Hades: what the parse of a HEVC SPS gives: whether it is progressive for Kodi and, where it was
+// read up to the flags that decide that without a fault, the colour description of its VUI (none
+// where the parse failed)
+struct HevcSpsRead
+{
+  Result result;
+  std::optional<Colour> colour;
+};
+
+HevcSpsRead ReadHevcSps(std::span<const uint8_t> nal)
 {
   const std::vector<uint8_t> rbsp = Rbsp(nal.subspan(2));
   CRbspReader br(rbsp);
-  const Result truncated{false, "HEVC: sequence parameter set ends early or is invalid"};
+  const HevcSpsRead truncated{{false, "HEVC: sequence parameter set ends early or is invalid"},
+                              std::nullopt};
 
   br.Skip(4); // sps_video_parameter_set_id
   const uint32_t maxSubLayersMinus1 = br.Bits(3);
@@ -503,9 +538,10 @@ Result HevcSps(std::span<const uint8_t> nal)
 
   bool fieldSeq = false;
   bool frameFieldInfo = false;
+  std::optional<Colour> colour;
   if (br.Bit()) // vui_parameters_present_flag
   {
-    if (!SkipCommonVui(br))
+    if (!SkipCommonVui(br, &colour))
       return truncated;
     br.Skip(1); // neutral_chroma_indication_flag
     fieldSeq = br.Bit() != 0;
@@ -514,10 +550,16 @@ Result HevcSps(std::span<const uint8_t> nal)
   if (br.Failed())
     return truncated;
   if (fieldSeq)
-    return {false, "HEVC: field_seq_flag is 1, the pictures are fields"};
+    return {{false, "HEVC: field_seq_flag is 1, the pictures are fields"}, colour};
   if (frameFieldInfo)
-    return {false, "HEVC: frame_field_info_present_flag is 1, picture timing may signal fields"};
-  return {true, "HEVC: no field_seq_flag and no frame_field_info_present_flag"};
+    return {{false, "HEVC: frame_field_info_present_flag is 1, picture timing may signal fields"},
+            colour};
+  return {{true, "HEVC: no field_seq_flag and no frame_field_info_present_flag"}, colour};
+}
+
+Result HevcSps(std::span<const uint8_t> nal)
+{
+  return ReadHevcSps(nal).result;
 }
 
 Result CheckH264(std::span<const uint8_t> data)
@@ -563,10 +605,11 @@ Result CheckH264(std::span<const uint8_t> data)
   return result;
 }
 
-Result CheckHevc(std::span<const uint8_t> data)
+// The NAL units of HEVC parameter sets as FFmpeg reads them: an hvcC record, also the
+// configurationVersion 0 that predates the standard (hevc/parse.c), or an Annex B byte stream. False
+// where an hvcC record ends early.
+bool HevcNals(std::span<const uint8_t> data, std::vector<std::span<const uint8_t>>& nals)
 {
-  std::vector<std::span<const uint8_t>> nals;
-  // hvcC, also the configurationVersion 0 that predates the standard (hevc/parse.c)
   if (data.size() >= 23 && (data[0] == 1 || (data[0] == 0 && (data[1] != 0 || data[2] > 1))))
   {
     const unsigned int arrays = data[22]; // numOfArrays
@@ -574,17 +617,17 @@ Result CheckHevc(std::span<const uint8_t> data)
     for (unsigned int i = 0; i < arrays; i++)
     {
       if (data.size() - pos < 3)
-        return {false, "HEVC: hvcC ends early"};
+        return false;
       const unsigned int count = (static_cast<unsigned int>(data[pos + 1]) << 8) | data[pos + 2];
       pos += 3;
       for (unsigned int j = 0; j < count; j++)
       {
         if (data.size() - pos < 2)
-          return {false, "HEVC: hvcC ends early"};
+          return false;
         const size_t length = (static_cast<size_t>(data[pos]) << 8) | data[pos + 1];
         pos += 2;
         if (length > data.size() - pos)
-          return {false, "HEVC: hvcC ends early"};
+          return false;
         nals.push_back(data.subspan(pos, length));
         pos += length;
       }
@@ -592,6 +635,14 @@ Result CheckHevc(std::span<const uint8_t> data)
   }
   else
     nals = AnnexBNals(data);
+  return true;
+}
+
+Result CheckHevc(std::span<const uint8_t> data)
+{
+  std::vector<std::span<const uint8_t>> nals;
+  if (!HevcNals(data, nals))
+    return {false, "HEVC: hvcC ends early"};
 
   Result result{false, "HEVC: no sequence parameter set in the extradata"};
   for (const auto& nal : nals)
@@ -630,4 +681,24 @@ Result Check(AVCodecID codec, const uint8_t* extradata, size_t size)
       return {false, "codec with interlaced coding, not inspected"};
   }
 }
+
+std::optional<Colour> HevcVuiColour(const uint8_t* extradata, size_t size)
+{
+  std::vector<std::span<const uint8_t>> nals;
+  if (!extradata || !HevcNals(std::span<const uint8_t>(extradata, size), nals))
+    return {};
+  std::optional<Colour> colour;
+  for (const auto& nal : nals)
+  {
+    if (nal.size() < 3 || ((nal[0] >> 1) & 0x3f) != HEVC_NAL_SPS)
+      continue;
+    if ((((nal[0] & 1) << 5) | (nal[1] >> 3)) != 0) // nuh_layer_id: another layer, not looked into
+      return {};
+    const HevcSpsRead sps = ReadHevcSps(nal);
+    if (!sps.colour || (colour && *colour != *sps.colour))
+      return {};
+    colour = sps.colour;
+  }
+  return colour;
+}
 } // namespace PROGRESSIVE_VIDEO
