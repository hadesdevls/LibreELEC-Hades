+void CLinuxRendererGLES::DVHdr10Plus(int idx, dvbridge_plain_hdr10plus& out) const
+{
+  out = {};
+  if (idx < 0 || idx >= NUM_BUFFERS)
+    return;
+  const CPictureBuffer& buffer = m_buffers[idx];
+  // (the metadata of each picture as the decoder holds them: its own, or those of the last one over a gap of a
+  // few pictures without, CMetadataHold)
+  const AVDynamicHDRPlus* metadata = KODI::UTILS::HDR10PLUS::ForDolbyVision(
+      buffer.doviFromHdr10Plus, buffer.m_srcColTransfer, buffer.hdr10PlusDynamic.get());
+  if (metadata)
+    dvbridge_hdr10plus_plain(metadata, &out, nullptr, nullptr);
+}
+
