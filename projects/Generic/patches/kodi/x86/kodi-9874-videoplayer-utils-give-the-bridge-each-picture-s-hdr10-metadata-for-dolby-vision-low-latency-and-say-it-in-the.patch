                                                   : 1;
     m_pendingDetail.signalColorSpace = av_dovi_get_color(parsed)->signal_color_space;
     m_pendingDetail.ipt = sourceTransport && dvbridge_render_ipt(m_renderer);
+    m_pendingDetail.hdr10PlusCurve = m_lowLatencyOn && dvbridge_render_hdr10plus_curve(m_renderer);
     if (!sourceTransport && m_sourceWanted && why && why != m_sourceWhyLogged)
     {
       CLog::Log(LOGINFO,
@@ -1210,9 +1214,12 @@ void CDVBridgeGLES::LogNotes()
     const dvbridge_plain_hdr10plus& h = notes.hdr10plus;
     const double brightest = std::max({h.scene_max[0], h.scene_max[1], h.scene_max[2]});
     const double peak = notes.hdr10plus_peak;
+    // (Hades: in Dolby Vision Low-Latency, where the player maps the picture, inside Dolby Vision)
     const std::string to =
         notes.hdr10plus_sdr ? StringUtils::Format("SDR (its white {:.0f} cd/m2)", peak)
-                            : StringUtils::Format("the display ({:.0f} cd/m2)", peak);
+        : notes.hdr10plus_ll
+            ? StringUtils::Format("the display ({:.0f} cd/m2) inside Dolby Vision Low-Latency", peak)
+            : StringUtils::Format("the display ({:.0f} cd/m2)", peak);
     if (notes.hdr10plus_curve)
     {
       const double target = h.target;
@@ -1231,9 +1238,14 @@ void CDVBridgeGLES::LogNotes()
                 "{} Bezier curve anchors), on the maxRGB of each pixel over the brightest of its "
                 "scene (the highest MaxSCL, {:.0f} cd/m2 in the first picture), by libplacebo's "
                 "pl_tone_map_st2094_40; {}. Scene by scene, from each picture's own HDR10+ "
-                "metadata (the first picture that has them)",
+                "metadata (the first picture that has them){}",
                 to, target, static_cast<double>(h.knee_x), static_cast<double>(h.knee_y),
-                h.anchors, brightest, fit);
+                h.anchors, brightest, fit,
+                notes.hdr10plus_ll
+                    ? ". In Low-Latency Hades maps the picture and the display shows it as it comes: "
+                      "the studio's curve is applied without leaving Dolby Vision; a scene whose "
+                      "metadata carry no tone curve is mapped from its level 1, as before"
+                    : "");
     }
     if (notes.hdr10plus_statistics)
       CLog::Log(LOGINFO,
@@ -1245,6 +1257,11 @@ void CDVBridgeGLES::LogNotes()
                 to, m_convertMapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
                 brightest, static_cast<double>(h.scene_avg));
   }
+  if (notes.hdr10plus_ll_failed)
+    CLog::Log(LOGINFO,
+              "DVBridge: the HDR10+ tone curve could not be drawn on this GPU in Dolby Vision "
+              "Low-Latency: the pictures of the rest of this stream are mapped from their level 1, as "
+              "without it (no picture was lost)");
 }
 
