   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
                                 base.chroma))
@@ -1380,8 +1400,9 @@ void CDVBridgeGLES::Warm(const Layer& base,
     return;
   TakeStaleGLErrors("the ways of drawing are made ready");
   // (Hades: drawn as the frames will be: a base layer in BT.1886 with clause 5.5, one in HLG as the
-  // frames are)
+  // frames are; and, in Low-Latency, a picture of HDR10+ sent as Dolby Vision by its tone curve)
   dvbridge_render_set_base_transfer(m_renderer, base.baseTransfer);
+  dvbridge_render_set_hdr10plus(m_renderer, &base.hdr10plus);
   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
                                 base.chroma))
