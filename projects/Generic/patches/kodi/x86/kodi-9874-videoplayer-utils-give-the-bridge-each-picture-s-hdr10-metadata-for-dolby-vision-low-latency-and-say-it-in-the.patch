+/*!
+ * \brief Hades: the HDR10+ metadata that a picture drawn natively takes to the bridge, which maps it by their tone
+ *        curve in Dolby Vision Low-Latency (CDVBridgeGLES::Layer::hdr10plus): those that it holds
+ *        (VideoPicture::hdr10PlusDynamic, CMetadataHold: its own, or the last picture's over a gap of fewer than
+ *        MISSING_MAX), where its Dolby Vision metadata are made from them (HDR10+ sent as Dolby Vision,
+ *        VideoPicture::doviFromHdr10Plus) and it is in PQ (HDR10+ is of SMPTE ST 2084); none for a picture whose
+ *        Dolby Vision is its own (its HDR10+ beside it are left aside, as in Dolby Vision Standard) or that holds
+ *        none
+ */
+inline const AVDynamicHDRPlus* ForDolbyVision(bool doviFromHdr10Plus, int transfer, const AVDynamicHDRPlus* held)
+{
+  return doviFromHdr10Plus && transfer == AVCOL_TRC_SMPTE2084 ? held : nullptr;
+}
