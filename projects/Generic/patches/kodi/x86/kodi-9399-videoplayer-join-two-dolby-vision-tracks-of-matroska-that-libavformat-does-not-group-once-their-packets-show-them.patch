           // The base layer of a Dolby Vision stream in two tracks carries no Dolby Vision record
           // of its own. For the player it is the stream of the one-track form that ReadFrame()
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
