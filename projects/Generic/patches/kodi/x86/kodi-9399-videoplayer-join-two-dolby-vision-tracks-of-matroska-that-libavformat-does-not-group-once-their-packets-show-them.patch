+void CDVDDemuxFFmpeg::CheckDVLayers()
+{
+  using Verification = CDVLayerMerge::Verification;
+  if (m_dvBaseIndex < 0 || m_dvVerified)
+    return;
+
+  const Verification verification = m_dvMerge.GetVerification();
+  if (verification == Verification::VERIFIED)
+  {
+    m_dvVerified = true;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} has the RPUs of a Dolby Vision enhancement layer and "
+              "stream {} none: they are a pair, and stream {} is Dolby Vision profile 7 from "
+              "here on",
+              m_dvEnhancementIndex, m_dvBaseIndex, m_dvBaseIndex);
+    if (CDemuxStream* stream = GetStream(m_dvBaseIndex))
+      PromoteDolbyVision(stream, m_dvRecord,
+                         m_pFormatContext->streams[m_dvEnhancementIndex]->codecpar);
+  }
+  else if (verification == Verification::REFUSED)
+  {
+    if (m_dvEnhancementIndex >= 0)
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg: streams {} and {} are no Dolby Vision pair (no RPU in the "
+                "first packets of the second, or one in those of the first): two streams, as "
+                "they were",
+                m_dvBaseIndex, m_dvEnhancementIndex);
+    // the second track becomes a stream with its next packet (AddStream())
+    m_dvEnhancementIndex = -1;
+    // what waited goes out first
+    if (m_dvMerge.Empty())
+      m_dvBaseIndex = -1;
+  }
+}
+
+void CDVDDemuxFFmpeg::PromoteDolbyVision(CDemuxStream* stream,
+                                        const AVDOVIDecoderConfigurationRecord& record,
+                                        const AVCodecParameters* enhancement)
+{
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (!video)
+    return;
+  video->hdr_type = StreamHdrType::HDR_TYPE_DOLBYVISION;
+  video->dovi = record;
+  if (enhancement &&
+      CDVLayerMerge::IsConfigurationRecord(enhancement->extradata, enhancement->extradata_size))
+    video->doviELConfig = FFmpegExtraData(enhancement->extradata, enhancement->extradata_size);
+  // VideoPlayer opens the codec of the stream again with what it is now (CheckStreamChanges())
+  video->changes++;
+}
+
 void CDVDDemuxFFmpeg::ReportDVLayers()
 {
   const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
@@ -1243,6 +1309,7 @@ int CDVDDemuxFFmpeg::ReadFrame(AVPacket* packet)
     const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
     if (!m_dvReported && counts.joined + counts.alone >= FIRST_REPORT)
       ReportDVLayers();
+    CheckDVLayers();
     return result;
   }
 #endif
@@ -2205,7 +2272,8 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
 #endif
