+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -23,6 +23,7 @@ extern "C"
 
 struct AVCodecParameters;
 struct AVFormatContext;
+struct dvbridge_rpu_probe;
 
 /*!
  * \brief Joins the two video tracks of a Dolby Vision stream into the one-track form
@@ -106,6 +107,10 @@ public:
     //! the container gives the packets their decoding times (a transport stream, MP4); Matroska
     //! does not
     bool decodingTimes = true;
+    //! What the container says is enough. False: two Matroska tracks that libavformat does not
+    //! group (no record, or records that do not tell which is which); they are a pair only once
+    //! their packets show it (Verification()), and the record is made for that case.
+    bool verified = true;
   };
 
   /*!
@@ -117,10 +122,34 @@ public:
    * which has no such reference, by the Dolby Vision record of the enhancement track when there
    * is exactly one other HEVC track. For MP4 and Matroska the enhancement track must also have
    * the size of an enhancement layer of the base track.
+   *
+   * Matroska files with the two tracks of a disc are not all made so: older ones have no record
+   * at all (the enhancement layer is found by its RPUs, which a muxer that did not read them did
+   * not see), or one that calls the enhancement layer profile 8 (a MEL, whose RPUs say that it
+   * carries no residual), or the same record on both tracks. Where libavformat makes no group of
+   * a Matroska file with exactly two HEVC tracks, one of the size of an enhancement layer of the
+   * other, and no record that speaks against it, the pair is found unverified (Layers::verified):
+   * it is one only if the first packets of the second track have an RPU, and the ones of the
+   * first track have none.
    * \param program index of the program that plays; any other value: all streams play
    */
   static Layers Find(AVFormatContext* context, unsigned int program);
 
+  //! \brief What the packets of an unverified pair said (Layers::verified)
+  enum class Verification
+  {
+    VERIFIED, //!< a pair, or one whose container said so
+    PENDING, //!< not known yet: base packets wait, as they wait for their enhancement packets
+    REFUSED, //!< no pair: what waits goes out as it was read, then every packet as it is read
+  };
+  Verification GetVerification() const { return m_verification; }
+
+  //! \brief No packet waits (after a refusal, the join can be left)
+  bool Empty() const { return m_base.waiting.empty() && m_enhancement.waiting.empty(); }
+
+  //! packets of the second track that may come before one with an RPU, when a pair is verified
+  static constexpr unsigned int VERIFY_PACKETS = 4;
+
   /*!
    * \brief The framing of a track: the bytes of the length before each unit when its codec
    *        parameters have an hvcC record, 0 for start codes. As libavcodec tells them apart: such
@@ -177,6 +206,9 @@ public:
   //! \brief Forget what waits (a seek, a flush)
   void Clear();
 
+  //! \brief Clear(), and forget what the packets of an unverified pair said (another pair)
+  void Restart();
+
   const Counts& GetCounts() const { return m_counts; }
 
   /*!
@@ -318,6 +350,8 @@ private:
   };
 
   bool Queue(Track& track, AVPacket* packet, bool enhancement);
+  void Verify(const AVPacket* packet, bool enhancement);
+  bool PopRefused(AVPacket* packet);
   bool Backfill();
   void GiveTimes(Track& track, size_t keep);
   int64_t ToBase(int64_t time) const;
@@ -338,5 +372,10 @@ private:
   bool m_any = false; //!< an enhancement packet has come
   bool m_end = false; //!< the input ended and what waits is going out
   bool m_fromPresentation = false; //!< the times are made from presentation times (REORDER)
+  Verification m_verification = Verification::VERIFIED;
+  unsigned int m_verifyLayer = 0; //!< packets of the second track probed without an RPU
+  unsigned int m_verifyBase = 0; //!< packets of the first track probed without one
+  bool m_layerRpu = false; //!< a packet of the second track had the RPU of a dual-layer stream
+  bool m_verifyDone = false; //!< the packets said it (VERIFIED or REFUSED)
   Counts m_counts;
 };
