 #endif
 
   struct AVCodecParametersDeleter
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
index c3749d2..b165095 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
@@ -8,6 +8,8 @@
 
 #include "DVLayerMerge.h"
 
+#include "dvbridge_probe.h"
+
 #include <algorithm>
 #include <charconv>
 #include <cinttypes>
@@ -332,7 +334,85 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
     layers.result = Layers::Result::JOINED;
     return layers;
   }
-  return refused;
+
+  // Matroska files that libavformat does not group (see the comment of Find() in the header):
+  // only where it made no Dolby Vision group at all.
+  if (container != Container::MATROSKA || refused.result != Layers::Result::NONE)
+    return refused;
+  for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
+  {
+    if (context->stream_groups[i] &&
+        context->stream_groups[i]->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
+      return refused;
+  }
+  AVStream* tracks[2] = {};
+  unsigned int hevc = 0;
+  for (unsigned int i = 0; i < context->nb_streams; ++i)
+  {
+    AVStream* stream = context->streams[i];
+    if (!stream || !stream->codecpar || stream->codecpar->codec_type != AVMEDIA_TYPE_VIDEO ||
+        stream->codecpar->codec_id != AV_CODEC_ID_HEVC ||
+        (stream->disposition & AV_DISPOSITION_ATTACHED_PIC) || !played(stream))
+      continue;
+    if (hevc < 2)
+      tracks[hevc] = stream;
+    ++hevc;
+  }
+  if (hevc != 2)
+    return refused;
+  const auto area = [](const AVStream* s)
+  { return static_cast<int64_t>(s->codecpar->width) * s->codecpar->height; };
+  AVStream* base = area(tracks[0]) >= area(tracks[1]) ? tracks[0] : tracks[1];
+  AVStream* enhancement = base == tracks[0] ? tracks[1] : tracks[0];
+  const AVCodecParameters* b = base->codecpar;
+  const AVCodecParameters* e = enhancement->codecpar;
+  // sizes that are known, and that are the ones of a pair; a length before each unit
+  if (b->width <= 0 || b->height <= 0 || e->width <= 0 || e->height <= 0 ||
+      !EnhancementSize(b->width, b->height, e->width, e->height) || !LengthSize(b) ||
+      !LengthSize(e))
+    return refused;
+  // what records the tracks have must not speak against it: the first one says it has a base
+  // layer, the second one an RPU, of profile 7 or 8 (a MEL)
+  const auto recordOf = [](const AVCodecParameters* par) -> const AVDOVIDecoderConfigurationRecord*
+  {
+    const AVPacketSideData* sd = av_packet_side_data_get(par->coded_side_data,
+                                                         par->nb_coded_side_data,
+                                                         AV_PKT_DATA_DOVI_CONF);
+    return sd && sd->size >= sizeof(AVDOVIDecoderConfigurationRecord)
+               ? reinterpret_cast<const AVDOVIDecoderConfigurationRecord*>(sd->data)
+               : nullptr;
+  };
+  const AVDOVIDecoderConfigurationRecord* baseRecord = recordOf(b);
+  const AVDOVIDecoderConfigurationRecord* layerRecord = recordOf(e);
+  if ((baseRecord && !baseRecord->bl_present_flag) ||
+      (layerRecord && (!layerRecord->rpu_present_flag ||
+                       (layerRecord->dv_profile != 7 && layerRecord->dv_profile != 8))))
+    return refused;
+
+  Layers layers;
+  layers.container = container;
+  layers.base = base->index;
+  layers.enhancement = enhancement->index;
+  layers.described = layerRecord != nullptr;
+  layers.rate = av_guess_frame_rate(context, base, nullptr);
+  if (layers.rate.num <= 0 || layers.rate.den <= 0)
+    layers.rate = AVRational{0, 1};
+  layers.baseLengthSize = LengthSize(b);
+  layers.enhancementLengthSize = LengthSize(e);
+  layers.decodingTimes = false;
+  layers.verified = false;
+  // the record of the one-track form of the two tracks of a disc
+  layers.record.dv_version_major = 1;
+  layers.record.dv_version_minor = 0;
+  layers.record.dv_profile = 7;
+  layers.record.dv_level = Level(b->width, b->height, layers.rate);
+  layers.record.rpu_present_flag = 1;
+  layers.record.el_present_flag = 1;
+  layers.record.bl_present_flag = 1;
+  layers.record.dv_bl_signal_compatibility_id = 6;
+  layers.record.dv_md_compression = AV_DOVI_COMPRESSION_NONE;
+  layers.result = Layers::Result::JOINED;
+  return layers;
 }
 
 CDVLayerMerge::~CDVLayerMerge()
@@ -358,6 +438,49 @@ void CDVLayerMerge::Configure(const Layers& layers)
   m_base.lengthSize = layers.baseLengthSize;
   m_enhancement.lengthSize = layers.enhancementLengthSize;
   m_fromPresentation = !layers.decodingTimes;
+  // (decided once for the pair: the same pair found again keeps what its packets said)
+  if (layers.verified)
+    m_verification = Verification::VERIFIED;
+  else if (!m_verifyDone)
+    m_verification = Verification::PENDING;
+}
+
+void CDVLayerMerge::Restart()
+{
+  Clear();
+  m_verification = Verification::VERIFIED;
+  m_verifyDone = false;
+  m_verifyLayer = 0;
+  m_verifyBase = 0;
+  m_layerRpu = false;
+}
+
+// For an unverified pair (Layers::verified): the first packets of the first track must have no
+// RPU and no units of an enhancement layer (it would be a Dolby Vision stream of its own), and one
+// of the first VERIFY_PACKETS of the second track must have the RPU of a dual-layer stream, and
+// no units of type 63.
+void CDVLayerMerge::Verify(const AVPacket* packet, bool enhancement)
+{
+  if (m_verification != Verification::PENDING)
+    return;
+  dvbridge_rpu_probe probe;
+  dvbridge_rpu_probe_packet(packet->data, static_cast<size_t>(std::max(packet->size, 0)),
+                            enhancement ? m_enhancement.lengthSize : m_base.lengthSize, &probe);
+  if (!enhancement)
+  {
+    if (probe.rpu || probe.layer)
+      m_verification = Verification::REFUSED;
+    else if (m_verifyBase < VERIFY_PACKETS)
+      ++m_verifyBase;
+  }
+  else if (probe.rpu && !probe.layer && probe.rpu_profile == 1)
+    m_layerRpu = true;
+  else if (++m_verifyLayer >= VERIFY_PACKETS && !m_layerRpu)
+    m_verification = Verification::REFUSED;
+
+  if (m_verification == Verification::PENDING && m_layerRpu && m_verifyBase > 0)
+    m_verification = Verification::VERIFIED;
+  m_verifyDone = m_verification != Verification::PENDING;
 }
 
 // The early packets of the enhancement track (Waiting::early): when the first one after them has
@@ -413,6 +536,21 @@ bool CDVLayerMerge::Backfill()
   return resolve();
 }
 
+// After a refusal: what waits goes out as it was read, the first track before the second.
+bool CDVLayerMerge::PopRefused(AVPacket* packet)
+{
+  Track& track = !m_base.waiting.empty() ? m_base : m_enhancement;
+  if (track.waiting.empty())
+    return false;
+  Waiting waiting = track.waiting.front();
+  track.waiting.pop_front();
+  if (&track == &m_base)
+    m_counts.alone++;
+  av_packet_move_ref(packet, waiting.packet);
+  av_packet_free(&waiting.packet);
+  return true;
+}
+
 void CDVLayerMerge::Clear()
 {
   Forget(m_base);
@@ -545,6 +683,7 @@ bool CDVLayerMerge::PushBase(AVPacket* packet)
 {
   if (m_silent < m_silentAfter && ++m_silent == m_silentAfter && !m_any)
     m_absent = true;
+  Verify(packet, false);
   return Queue(m_base, packet, false);
 }
 
@@ -560,6 +699,7 @@ bool CDVLayerMerge::PushEnhancement(AVPacket* packet)
     m_enhancement.waiting.pop_front();
     m_counts.dropped++;
   }
+  Verify(packet, true);
   return Queue(m_enhancement, packet, true);
 }
 
@@ -811,6 +951,19 @@ bool CDVLayerMerge::Passed() const
 
 bool CDVLayerMerge::Pop(AVPacket* packet, bool end)
 {
+  if (m_verification == Verification::PENDING &&
+      (end || m_silent >= m_silentAfter || m_base.waiting.size() >= MAX_WAITING))
+  {
+    // what the first packets would say did not come: no pair
+    m_verification = Verification::REFUSED;
+    m_verifyDone = true;
+  }
+  if (m_verification == Verification::REFUSED)
+    return PopRefused(packet);
+  // base packets wait while it is not known whether the tracks are a pair
+  if (m_verification == Verification::PENDING)
+    return false;
+
   if (end)
   {
     // no more packets come to make the times of the last ones
@@ -902,6 +1055,9 @@ int CDVLayerMerge::Read(AVFormatContext* context, int base, int enhancement, AVP
     if (result < 0)
       return result;
 
+    // no pair (an unverified one that its packets refused): every packet as it is read
+    if (m_verification == Verification::REFUSED && Empty())
+      return 0;
     if (packet->stream_index == base)
       PushBase(packet);
     else if (packet->stream_index == enhancement)
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index 22ec184..a58e20f 100644
