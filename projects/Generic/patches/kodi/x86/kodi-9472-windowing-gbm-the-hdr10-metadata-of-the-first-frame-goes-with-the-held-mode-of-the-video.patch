From 6068d6130b0dc13dec2e35961777d53a8eb792e9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 17:06:07 +0000
Subject: [PATCH] windowing/gbm: the HDR10+ metadata of the first frame goes
 with the held mode of the video

CHDR10PlusOutput queued a payload only in a request that changes neither
the mode nor the HDR signalling (Output::alone), so the first one went
out a commit after the change of mode of the video. i915 sends HDR10+ at
2160p24, 25 and 30 only where the commit of the mode carries it: it then
signals the mode with its CTA VIC in the AVI InfoFrame and keeps the
vendor DIP for HDR10+ (linux-9982); in a later commit that would need
another change of mode, which it refuses. That is the case of issue #2: a
film at 3840x2160 at 23.976 Hz on an Ice Lake to a Samsung S90H.

The change of mode of a video that opens is held for its output, and goes
out in one commit with its first frame and its HDR signalling
(CModeChangeHold; on that system, "The change of mode goes out with the
output of the video, in one commit"). Only that commit now carries the
payload of its frame too (Output::withMode, CHDR10PlusOutput::WithMode()):
CWinSystemGbm::TellModeHoldEnd() marks it when the hold of a video's mode
ends because its output came (End::CONFIGURED), FlipPage() unmarks it
after the commit, and it counts while the modeset is pending and the
request sets the HDR metadata. No other commit that changes the mode or
the HDR signalling carries a payload: a modeset that turns HDR on without
a hold (a mode of another window size), a hold that ended otherwise, the
end of a video. A test that fails with the payload is made again without
it, as before (CHDR10PlusOutput::Without()), so a driver that refuses it
there takes nothing else of the commit with it.

Where the change of mode is not held, the payload comes a commit later as
before: there i915 keeps refusing HDR10+ at those modes, and says so in
the kernel log; Kodi says that the driver refused it.

Host test of CHDR10PlusOutput, with withMode computed as SetHDR10Plus()
computes it: 9 checks; one fails with Kodi before the payload went with
the mode, and three with withMode as "a modeset is pending and the
request sets the HDR metadata"; three mutations caught. A check of the
source of CWinSystemGbm (where the held commit is marked and unmarked, and
how withMode is computed) passes here and fails on that earlier version.
The earlier HDR10+ tests and checks pass.
---
 xbmc/windowing/gbm/HDR10PlusOutput.h | 36 ++++++++++++++++++++++++----
 xbmc/windowing/gbm/WinSystemGbm.cpp  |  8 +++++++
 2 files changed, 40 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index e0cbc77..f11e1c7 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -49,9 +49,12 @@ namespace GBM
  * (TestFailed()) for the log to say so: the driver says why in the kernel log (the Hades patches
  * of NVIDIA: "Hades: HDR10+ refused on head N: ...").
  *
- * A payload is never queued in a request that changes the HDR signalling or the mode (Output::alone),
- * and a test that fails with one is made again without it (Without()), so that a refusal takes
- * nothing else of the request with it.
+ * A payload is not queued in a request that changes the HDR signalling or the mode (Output::alone),
+ * but in the one that sets the mode and the HDR signalling of the video together, with its first
+ * frame (Output::withMode: the commit that ends the hold of the change of mode, CModeChangeHold).
+ * i915 sends HDR10+ at 2160p24, 25 and 30 only where the commit of the mode carries it: it signals
+ * the mode with its CTA VIC then (linux-9982). A test that fails with a payload is made again
+ * without it (Without()), so that a refusal takes nothing else of the request with it.
  *
  * Only what is decided is here, with nothing of DRM in it, so that a test can run it.
  */
@@ -81,6 +84,10 @@ public:
     //! is never queued with one: a driver that refuses it would take the HDR10 or the mode of the
     //! video with it (CDRMAtomic falls back to the request before). The next frame sends it.
     bool alone = true;
+    //! the request is the one that a hold of the change of mode of the video releases, with the
+    //! mode, the HDR signalling and this frame (WithMode()): the payload goes with them (a test that
+    //! fails with it is made again without it, Without())
+    bool withMode = false;
   };
 
   //! What to queue for a frame (payload: its HDR10+ metadata, nothing without)
@@ -88,7 +95,7 @@ public:
   {
     const bool on = output.pq && output.display && output.driver && !m_refused;
     if (on && payload)
-      return m_queued == payload || !output.alone ? Step::NOTHING : Step::SEND;
+      return m_queued == payload || !(output.alone || output.withMode) ? Step::NOTHING : Step::SEND;
     return m_queued ? Step::CLEAR : Step::NOTHING;
   }
 
@@ -162,6 +169,26 @@ public:
 
   bool Refused() const { return m_refused; }
 
+  //! A hold of a change of mode ended (CModeChangeHold, CWinSystemGbm::TellModeHoldEnd()):
+  //! released is true when it was the hold of the mode of a video that opens and its output came
+  //! (End::CONFIGURED), so the next commit carries the mode, the HDR signalling and the first frame
+  void HeldModeReleased(bool released) { m_heldMode = released; }
+
+  //! A commit was made (CWinSystemGbm::FlipPage()): the one a hold released went out with it
+  void HeldModeCommitted() { m_heldMode = false; }
+
+  /*!
+   * \brief Output::withMode of a frame: the request is the one the hold released (HeldModeReleased()),
+   *        with the modeset still pending and the HDR metadata of the video in it (hdrMetadata: the
+   *        value of HDR_OUTPUT_METADATA in the request). Not any other commit with a modeset that
+   *        turns HDR on: where the change of mode was not held, the payload comes a commit later,
+   *        alone, as before.
+   */
+  bool WithMode(bool modesetPending, std::optional<uint64_t> hdrMetadata) const
+  {
+    return m_heldMode && modesetPending && hdrMetadata.value_or(0) != 0;
+  }
+
   /*!
    * \brief A value of HDR10PLUS_VSIF that a previous session left on the connector (Kodi killed
    *        or crashed while it sent HDR10+) is staged as 0 for the first commit of this one: the
@@ -186,6 +213,7 @@ private:
   unsigned int m_unseen = 0;
   bool m_refused = false;
   int m_testError = 0;
+  bool m_heldMode = false;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 05d9783..1adf884 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2029,6 +2029,9 @@ void CWinSystemGbm::TellModeHoldEnd()
     return;
   using End = CModeChangeHold::End;
   const bool start = kind == CModeChangeHold::Kind::START;
+  // Hades: the next commit carries the mode of the video with its output and first frame, and the
+  // HDR10+ metadata of that frame (CHDR10PlusOutput::WithMode())
+  m_hdr10Plus.HeldModeReleased(start && end == End::CONFIGURED);
   if (start)
   {
     m_modeHeldFrom = nullptr;
@@ -2098,6 +2101,8 @@ void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
   m_DRM->FlipPage(bo, rendered, videoLayer, async);
   // Hades: whether the driver took the HDR10+ metadata that the request carried
   HDR10PlusCommitted();
+  // ... and the commit that a hold of the change of mode released, if any, went out
+  m_hdr10Plus.HeldModeCommitted();
 
   // !videoLayer alone cannot gate teardown: FlipPage also runs with videoLayer
   // false during a mode switch or renderer swap. use_count reaches 1 only when
@@ -2738,6 +2743,9 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
   output.alone = !drm->ModesetPending() &&
                  !drm->RequestValue(connector, "HDR_OUTPUT_METADATA") &&
                  !drm->RequestValue(connector, "Colorspace");
+  // (the commit that the hold of the change of mode of the video releases: i915 needs HDR10+ there)
+  output.withMode = m_hdr10Plus.WithMode(drm->ModesetPending(),
+                                         drm->RequestValue(connector, "HDR_OUTPUT_METADATA"));
 
   if (payload && output.pq && output.display && !output.driver &&
       !(m_hdr10PlusTold & TOLD_NO_DRIVER))
-- 
2.53.0

