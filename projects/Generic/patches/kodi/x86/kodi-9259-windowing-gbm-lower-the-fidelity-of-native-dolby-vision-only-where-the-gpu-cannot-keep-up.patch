+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The fidelity step-down level of native Dolby Vision frames, where the GPU cannot keep up
+ *
+ * The renderer of the bridge can trade some precision of the reconstruction for GPU time
+ * (dvbridge_render_set_step()): from level 1 on, more of the planes that are scaled up to the size
+ * of the picture are scaled up bilinearly instead of with Lanczos. Level 0 is the faithful picture.
+ * Which levels change anything depends on the renderer and the frame (the planes of an enhancement
+ * layer are only scaled up that way when its residual is drawn and the renderer resamples it with
+ * those upscalers): the renderer tells it as a ladder (dvbridge_render_step_levels()), and a level
+ * that is not in the ladder of a frame is never used for it: it would change nothing, and cost a
+ * window of measurement for nothing. What each level costs in fidelity was measured on a software
+ * renderer; what it saves in GPU time is not known before it is measured on the GPU at hand, and
+ * may be nothing. Nothing here assumes a saving: a level is kept only for what it was measured to
+ * do, on this GPU, with this picture format.
+ *
+ * The remedies that cost no fidelity come first. While the two ways of drawing a format are
+ * compared (CDVPathChoice), nothing is measured or decided here for it. While frame ahead
+ * (CDVAhead) can still be had and the frames are not presented that way yet (Pace::PENDING), no
+ * format goes down (one can go back up: what fits the way that waits fits a frame ahead).
+ *
+ * Each picture format (the load of CDVFrameLoad: size, active area, and whether the residual of
+ * an enhancement layer is drawn) has a level of its own, 0 until its frames are found not to keep
+ * up, and what is found of it is of one ladder: when the ladder of its frames changes (another
+ * renderer), the format begins again from the faithful picture. Its frames are measured in windows
+ * of WINDOW frames of one level, one way of drawing, one pace and one refresh rate, leaving out the
+ * frames with GUI elements (subtitles, the player bar, a capture), those of a picture that stands
+ * still, the first seconds of a video and after a seek, and the first frames after a change of
+ * format, of level or of way and after GUI elements. Each presentation of those frames is counted
+ * with them, and whether it came with its refresh: by the times of the flips that the kernel tells
+ * while frames are presented a frame ahead, by how long its presentation took while they are
+ * presented the way that waits.
+ *
+ * A window is behind when both the GPU times and the refreshes say so. Frames presented a frame
+ * ahead have up to two periods each, but the GPU draws one after the other, so they keep up as
+ * long as they take less than a period on average: the window is behind when its frames take more
+ * than LOADED_AHEAD of the period on average (without its slowest frame) and LOST_PART of its
+ * presentations, LOST_MIN at least, missed their refresh. Frames presented the way that waits have
+ * one period each, less what the rest of the loop takes: the window is behind when LOST_PART of its
+ * frames, LOST_MIN at least, took more than LOADED_WAITING of the period, and as many of its
+ * presentations missed their refresh. The GPU times say that the GPU is the cause, the missed
+ * refreshes that the frames do not keep up: with only one of the two, nothing changes. Two windows
+ * in a row have to be behind, or one in which the GPU could not keep up in any case (frames ahead
+ * that take more than the period on average; frames that wait, most of them over the mark).
+ *
+ * Then the format goes down to the next level of its ladder, and that level is measured before
+ * anything more is decided: down once more if it is behind too, until a level keeps up. A level
+ * that is measured not to save time (it takes GAIN of the level in use or more, or less by no
+ * more than the two measurements could be apart by chance) is passed over. When none keeps up, the
+ * format goes to the fastest level measured, the lowest of those that are not measured to save
+ * time on each other (with no level that saves time, the faithful one), and stays there until the
+ * refresh rate or the pace changes.
+ *
+ * Back up: the level above in the ladder is taken again when what it would take now fits with
+ * room to spare (RELEASE_AHEAD, RELEASE_WAITING of the period: the room between them and the marks
+ * above keeps a format from going up and down). What it would take is what the level in use takes
+ * now times what the level above took for what this one took, measured in two windows next to each
+ * other (at a change between them): so the format goes back up when the refresh period is longer
+ * than when it went down, or when the GPU has become faster since (it was held up at the start of
+ * the video). Nothing is tried on a guess or after a while: on a GPU whose frames have not become
+ * faster nothing goes up, and the frames do not stutter now and then for a trial. A format goes up
+ * only RELEASE_WAIT measured frames after it last went down; when the level it went up to does not
+ * keep up after all, it goes down again with that measurement, and the wait doubles. A format of
+ * less work is a format of its own, at level 0 until it is found not to keep up.
+ *
+ * What is known stays from one video to the next, and Known() and Recall() keep it from one
+ * session to the next for the same GPU, driver and build, as the ways of drawing are kept: the
+ * frames of a format that a GPU cannot draw faithfully in time are drawn at the level found before
+ * from the first one.
+ *
+ * This class only decides. The window system draws each frame at the level of Draw(), tells it the
+ * GPU times and the presentations, and logs what changes.
+ */
+class CDVStepDown
+{
+public:
+  static constexpr int LEVELS = 4; //!< DVBRIDGE_STEP_LEVELS
+  static constexpr unsigned int WINDOW = 48; //!< measured frames of a window (two seconds of film)
+
+  //! How the frames are presented: what a frame may take of the refresh period
+  enum class Pace
+  {
+    WAITING, //!< the way that waits, and frame ahead cannot be had (turned off, given up, no fence)
+    PENDING, //!< the way that waits while frame ahead can still be had: no format goes down
+    AHEAD, //!< a frame ahead (see CDVAhead)
+  };
+
+  //! Why the level of a format changed, or what a window found
+  enum class Why
+  {
+    NONE,
+    BEHIND, //!< the frames did not keep up: a level down
+    NO_GAIN, //!< no level keeps up, and this one is the fastest that was measured
+    NOTHING_KEEPS_UP, //!< ... and it is the level in use already (the level does not change)
+    FITS, //!< what the level above would take now fits with room to spare: a level up
+    LADDER, //!< the levels that change anything are others: begun again from the faithful picture
+  };
+
+  struct Step
+  {
+    int level = 0; //!< Draw(): the level to draw the frame at
+    bool changed = false; //!< the level of the format changed with this call
+    Why why = Why::NONE;
+    int from = 0;
+    int to = 0;
+    Pace pace = Pace::PENDING; //!< of the window
+    double averageMs = 0; //!< ... its GPU time, without its slowest frame
+    double budgetMs = 0; //!< ... the mark of a frame at that pace and refresh period
+    double periodMs = 0;
+    unsigned int frames = 0; //!< ... its measured frames
+    unsigned int over = 0; //!< ... of those, the ones that took more than the mark
+    unsigned int presented = 0; //!< ... its presentations whose outcome is known
+    unsigned int lost = 0; //!< ... of those, the ones that missed their refresh
+    double estimateMs = 0; //!< FITS: what the level above would take now
+    std::array<double, LEVELS> knownMs{}; //!< what each level of the format took (0: not known)
+    unsigned int ladder = 1; //!< the levels that change anything for the format
+  };
+
+  //! A ladder as the renderer gives it (bit n: level n draws another picture than the level of the
+  //! ladder above it), with the faithful picture in it and no level that does not exist
+  static unsigned int Ladder(unsigned int ladder) { return (ladder | 1u) & ((1u << LEVELS) - 1u); }
+
+  //! Whether a level is in a ladder
+  static bool In(unsigned int ladder, int level)
+  {
+    return level >= 0 && level < LEVELS && ((ladder >> level) & 1u) != 0;
+  }
+
+  //! The next level of a ladder above a level (of more fidelity); -1: none
+  static int Above(unsigned int ladder, int level)
+  {
+    for (int n = level - 1; n >= 0; --n)
+    {
+      if (In(ladder, n))
+        return n;
+    }
+    return -1;
+  }
+
+  //! The next level of a ladder below a level (of less fidelity); -1: none
+  static int Below(unsigned int ladder, int level)
+  {
+    for (int n = level + 1; n < LEVELS; ++n)
+    {
+      if (In(ladder, n))
+        return n;
+    }
+    return -1;
+  }
+
+  /*!
+   * \brief The level that a frame is drawn at
+   * \param forced the level that advancedsettings.xml forces (video/dvstepdown); -1: none
+   * \param automatic the setting that lets Kodi lower the fidelity where the GPU cannot keep up
+   * \param chosen what Draw() gave (not asked when a level is forced or the setting is off)
+   */
+  static int Chosen(int forced, bool automatic, int chosen)
+  {
+    if (forced >= 0)
+      return std::min(forced, LEVELS - 1);
+    return automatic ? std::clamp(chosen, 0, LEVELS - 1) : 0;
+  }
+
+  /*!
+   * \brief A frame of that format is to be drawn (with GUI elements or without)
+   * \param ladder the levels that change anything for it (dvbridge_render_step_levels())
+   * \return its level; changed when the ladder is another one than what was found of the format
+   */
+  Step Draw(uint64_t format, unsigned int ladder)
+  {
+    Step step;
+    ++m_clock;
+    Format* const found = format != 0 ? Find(format) : nullptr;
+    if (!found)
+      return step;
+    Format& f = *found;
+    ladder = Ladder(ladder);
+    if (f.ladder != ladder)
+    {
+      // What was found of its levels is of other work (another renderer, another composer)
+      const bool begun = f.ladder != 0;
+      step.from = f.level;
+      const uint64_t id = f.id;
+      f = Format();
+      f.id = id;
+      f.ladder = ladder;
+      if (begun && step.from != 0)
+      {
+        step.changed = true;
+        step.why = Why::LADDER;
+        step.to = 0;
+      }
+    }
+    const uint64_t away = m_clock - f.drawn;
+    f.drawn = m_clock;
+    // Back after other formats: its first frames carry the change. After much longer, what its
+    // window had gathered is too old.
+    if (away > ABSENCE)
+      f.Drop();
+    if (away > WINDOW)
+      f.skip = std::max(f.skip, CHANGE_SKIP);
+    step.level = f.level;
+    step.ladder = f.ladder;
+    return step;
+  }
+
+  /*!
+   * \brief The GPU time of a frame without GUI elements whose picture did not stand still
+   * \param format its format, as it turned out to be (a frame drawn at another level than that of
+   *        its format is not taken: it was drawn before a change, or foreseen as of another one)
+   * \param level the level it was drawn at
+   * \param pace how frames are presented now
+   * \param comparing the ways of drawing its format were being compared (CDVPathChoice)
+   * \param direct it was drawn directly
+   * \return when a window ends with it: a change of level of its format, or what it found
+   */
+  Step Measured(uint64_t format,
+                int level,
+                double ms,
+                double periodMs,
+                Pace pace,
+                bool comparing,
+                bool direct)
+  {
+    if (format == 0 || !(ms > 0) || !std::isfinite(ms) || !(periodMs > 0) || !std::isfinite(periodMs))
+      return Step();
+    Format* const found = Lookup(format);
+    if (!found || level != found->level)
+      return Step();
+    Format& f = *found;
+    // The frames of a comparison of the ways are drawn one way and the other: none counts
+    if (comparing)
+    {
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+      return Step();
+    }
+    // A window is of one way of drawing. What the levels take for each other stays when the way
+    // changes (the levels change the reconstruction, which both ways make), and so the times of
+    // the other levels follow the one in use (Now()); a change of level that comes with a change
+    // of way tells nothing of how the two levels compare.
+    if (!f.wayKnown)
+    {
+      f.wayKnown = true;
+      f.way = direct;
+    }
+    else if (direct != f.way)
+    {
+      f.way = direct;
+      f.cameFrom = -1;
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+    }
+    // A window is of one pace and one refresh period
+    Window& w = f.window;
+    if (w.count > 0 && (w.pace != pace || !SamePeriod(w.periodMs, periodMs)))
+    {
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+    }
+    // the first seconds of a video or after a seek, by the refresh period; the first frames after
+    // a change, by their number
+    const bool settling = m_settlingMs > 0 || f.skip > 0;
+    if (m_settlingMs > 0)
+      m_settlingMs -= periodMs;
+    if (f.skip > 0)
+      --f.skip;
+    if (settling)
+      return Step();
+    if (w.count == 0)
+    {
+      w = Window();
+      w.pace = pace;
+      w.periodMs = periodMs;
+    }
+    w.sum += ms;
+    w.squares += ms * ms;
+    w.max = std::max(w.max, ms);
+    w.over += ms > LOADED_WAITING * periodMs ? 1 : 0;
+    if (++w.count < WINDOW)
+      return Step();
+    return Decide(f);
+  }
+
+  /*!
+   * \brief A frame without GUI elements whose picture did not stand still was presented, and
+   *        whether it came with its refresh is known
+   * \param late it missed its refresh
+   */
+  void Presented(uint64_t format, int level, bool late, Pace pace)
+  {
+    Format* const f = format != 0 ? Lookup(format) : nullptr;
+    if (!f || level != f->level || f->window.count == 0 || f->window.pace != pace)
+      return;
+    ++f->window.presented;
+    f->window.lost += late ? 1 : 0;
+  }
+
+  //! A frame was drawn that is not measured (GUI elements, a picture standing still, or one of
+  //! the other kind of stream): the first frames after it also carry the change
+  void Interrupted()
+  {
+    for (Format& f : m_formats)
+      f.skip = std::max(f.skip, SKIP);
+  }
+
+  //! The video jumped (a seek, a change of stream): the frames around it are slow and late for
+  //! that, and the windows begin again
+  void Seeked()
+  {
+    for (Format& f : m_formats)
+      f.Drop();
+    m_settlingMs = SETTLE_MS;
+  }
+
+  //! Native output ended (the video, or a change of the display mode): the levels and what they
+  //! took stay, the windows begin again with the next video
+  void Restart() { Seeked(); }
+
+  /*!
+   * \brief What is known, as text, for Recall() in a later session
+   *
+   * The formats that are not at level 0 or have had a level below it measured, STORED at most,
+   * the last drawn first: "|<format>,<ladder>,<level>,<way>,<ms>,<ms>,<ms>,<ms>" each, what each
+   * level takes in hundredths of a millisecond (0: not known): the level in use as it was last
+   * measured, the others by what they took for what the level next to them in the ladder took,
+   * where that was measured (so Recall() has those ratios again). Empty when there are none.
+   */
+  std::string Known() const
+  {
+    std::array<const Format*, FORMATS> order{};
+    size_t count = 0;
+    for (const Format& f : m_formats)
+    {
+      if (f.id != 0 && f.ladder != 0 && f.Explored())
+        order[count++] = &f;
+    }
+    std::sort(order.begin(), order.begin() + count,
+              [](const Format* a, const Format* b) { return a->drawn > b->drawn; });
+    std::string text;
+    char part[160];
+    for (size_t n = 0; n < count && n < STORED; ++n)
+    {
+      const Format& f = *order[n];
+      const std::array<double, LEVELS> now = Now(f);
+      std::snprintf(part, sizeof(part), "|%llx,%u,%d,%d,%u,%u,%u,%u",
+                    static_cast<unsigned long long>(f.id), f.ladder, f.level, f.way ? 1 : 0,
+                    Hundredths(now[0]), Hundredths(now[1]), Hundredths(now[2]), Hundredths(now[3]));
+      text += part;
+    }
+    return text;
+  }
+
+  /*!
+   * \brief Take what an earlier session knew, as Known() gave it
+   * \return false, and nothing changes, when the text is not of that form (or empty)
+   *
+   * For a new session, before its first frame: it takes the place of what this one knew. The
+   * formats taken are drawn at their level from their first frame (if the renderer gives them the
+   * same ladder), and count as formats that have been away and that last went down long ago.
+   */
+  bool Recall(const std::string& text)
+  {
+    std::array<Format, FORMATS> formats{};
+    size_t count = 0;
+    size_t at = 0;
+    while (at < text.size())
+    {
+      uint64_t id = 0;
+      uint64_t ladder = 0;
+      uint64_t level = 0;
+      uint64_t way = 0;
+      std::array<uint64_t, LEVELS> ms{};
+      if (count >= STORED || !Skip(text, at, '|') || !Number(text, at, 16, UINT64_MAX, id) ||
+          (id >> 63) == 0 || !Skip(text, at, ',') ||
+          !Number(text, at, 10, (1u << LEVELS) - 1u, ladder) || (ladder & 1u) == 0 ||
+          !Skip(text, at, ',') || !Number(text, at, 10, LEVELS - 1, level) ||
+          !In(static_cast<unsigned int>(ladder), static_cast<int>(level)) || !Skip(text, at, ',') ||
+          !Number(text, at, 10, 1, way))
+        return false;
+      for (size_t n = 0; n < LEVELS; ++n)
+      {
+        if (!Skip(text, at, ',') || !Number(text, at, 10, MAX_HUNDREDTHS, ms[n]) ||
+            (!In(static_cast<unsigned int>(ladder), static_cast<int>(n)) && ms[n] != 0))
+          return false;
+      }
+      for (size_t n = 0; n < count; ++n)
+      {
+        if (formats[n].id == id)
+          return false;
+      }
+      Format& f = formats[count++];
+      f.id = id;
+      f.ladder = static_cast<unsigned int>(ladder);
+      f.level = static_cast<int>(level);
+      f.wayKnown = true;
+      f.way = way != 0;
+      for (size_t n = 0; n < LEVELS; ++n)
+        f.ms[n] = static_cast<double>(ms[n]) / 100.0;
+      for (int n = 1; n < LEVELS; ++n)
+      {
+        const int above = Above(f.ladder, n);
+        if (In(f.ladder, n) && above >= 0 && f.ms[static_cast<size_t>(above)] > 0 &&
+            f.ms[static_cast<size_t>(n)] > 0)
+          f.ratio[static_cast<size_t>(n)] = f.ms[static_cast<size_t>(above)] / f.ms[static_cast<size_t>(n)];
+      }
+      f.sinceDown = RELEASE_WAIT;
+    }
+    if (count == 0)
+      return false;
+    m_formats = formats;
+    // later than ABSENCE after the frame that the formats say they were last drawn at (0)
+    m_clock = ABSENCE + 1;
+    m_settlingMs = SETTLE_MS;
+    return true;
+  }
+
+  //! The level of a format, without drawing a frame (0 when it is not known)
+  int Level(uint64_t format) const
+  {
+    for (const Format& f : m_formats)
+    {
+      if (f.id != 0 && f.id == format)
+        return f.level;
+    }
+    return 0;
+  }
+
+private:
+  static constexpr unsigned int SKIP = 6; //!< frames left out after a change
+  //! ... when a format comes back after others (a second of film)
+  static constexpr unsigned int CHANGE_SKIP = 24;
+  //! the time left out at the start of a video and after a seek
+  static constexpr double SETTLE_MS = 2000;
+  static constexpr size_t FORMATS = 8; //!< formats known at a time
+  static constexpr size_t STORED = 4; //!< ... and kept for a later session
+  //! frames after which a format that was not drawn drops what its window had gathered
+  static constexpr uint64_t ABSENCE = 14400;
+  //! The part of the refresh period that frames presented a frame ahead may take on average. Not
+  //! measured on a GPU (in the long run a frame has one period, less what else the GPU does in it);
+  //! refreshes have to be missed as well.
+  static constexpr double LOADED_AHEAD = 0.85;
+  //! The part of the refresh period above which a frame presented the way that waits can miss its
+  //! refresh. Measured on the integrated GPU of a Ryzen 9 7950X3D at 23.976 Hz (CDVPathChoice,
+  //! TIGHT): at 72 to 75 % of the period none to two frames of 240 were late, at 84 to 88 % 61 to 73.
+  static constexpr double LOADED_WAITING = 0.8;
+  //! What a level above has to be taking for the format to go back up to it: room to spare below
+  //! the marks, so that a format does not go up and down
+  static constexpr double RELEASE_AHEAD = 0.75;
+  static constexpr double RELEASE_WAITING = 0.7;
+  //! Missed refreshes (and frames over the mark) that make a window behind: this part of them,
+  //! and at least ...
+  static constexpr double LOST_PART = 0.05;
+  static constexpr unsigned int LOST_MIN = 3;
+  //! ... of at least this many presentations whose outcome is known (else nothing is decided)
+  static constexpr unsigned int KNOWN_MIN = WINDOW / 2;
+  //! a level saves time when it takes less than this part of the other (as CDVPathChoice::GAIN)
+  static constexpr double GAIN = 0.95;
+  //! measured frames after a format went down before it goes up again (a minute of film), doubled
+  //! when the level it went up to did not keep up, up to about an hour of film
+  static constexpr unsigned int RELEASE_WAIT = 1440;
+  static constexpr unsigned int RELEASE_MAX_WAIT = 64 * RELEASE_WAIT;
+  //! the most that Known() writes for a time, in hundredths of a millisecond (a second)
+  static constexpr uint64_t MAX_HUNDREDTHS = 100000;
+
+  struct Window
+  {
+    unsigned int count = 0;
+    double sum = 0;
+    double squares = 0;
+    double max = 0;
+    unsigned int over = 0; //!< frames over LOADED_WAITING of the period
+    Pace pace = Pace::PENDING;
+    double periodMs = 0;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+  };
+
+  struct Format
+  {
+    uint64_t id = 0; //!< 0: none
+    uint64_t drawn = 0; //!< m_clock of its last frame
+    unsigned int ladder = 0; //!< the levels that change anything, that what is found is of (0: none yet)
+    int level = 0;
+    std::array<double, LEVELS> ms{}; //!< what each level took, the last window of it (0: not known)
+    std::array<double, LEVELS> error{}; //!< ... the standard error of that average
+    //! [n]: what the level above n in the ladder took for what level n took, in two windows next
+    //! to each other (0: not known)
+    std::array<double, LEVELS> ratio{};
+    int cameFrom = -1; //!< the level of before its last change, until a window at the new one ...
+    double leftMs = 0; //!< ... and what it took
+    bool wayKnown = false;
+    bool way = true; //!< the way of drawing that the times are of (true: directly)
+    Window window;
+    unsigned int skip = CHANGE_SKIP; //!< its next measured frames that are left out
+    unsigned int behind = 0; //!< windows in a row that were behind, at its level
+    //! no level keeps up, at the refresh period and pace of then: it is at the fastest
+    bool exhausted = false;
+    double exhaustedPeriodMs = 0;
+    Pace exhaustedPace = Pace::PENDING;
+    unsigned int sinceDown = 0; //!< measured frames since it last went down
+    unsigned int releaseWait = RELEASE_WAIT;
+    bool upToKeep = false; //!< it went up, and no window has kept up there yet
+
+    //! What its window had gathered: it begins again
+    void Drop()
+    {
+      window = Window();
+      behind = 0;
+    }
+
+    bool Explored() const
+    {
+      bool explored = level > 0;
+      for (size_t n = 1; n < LEVELS; ++n)
+        explored = explored || ms[n] > 0;
+      return explored;
+    }
+  };
+
+  static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
+
+  static double Release(Pace pace)
+  {
+    return pace == Pace::AHEAD ? RELEASE_AHEAD : RELEASE_WAITING;
+  }
+
+  static unsigned int Mark(unsigned int count)
+  {
+    return std::max(LOST_MIN, static_cast<unsigned int>(std::ceil(LOST_PART * count)));
+  }
+
+  Format* Lookup(uint64_t id)
+  {
+    for (Format& f : m_formats)
+    {
+      if (f.id == id)
+        return &f;
+    }
+    return nullptr;
+  }
+
+  //! The format, or a place for it: a free one; else the one drawn longest ago of those at level
+  //! 0 with nothing measured below it; else the one drawn longest ago.
+  Format* Find(uint64_t id)
+  {
+    const auto rank = [](const Format& g) { return g.id == 0 ? 0 : g.Explored() ? 2 : 1; };
+    Format* place = nullptr;
+    for (Format& f : m_formats)
+    {
+      if (f.id == id)
+        return &f;
+      if (!place || rank(f) < rank(*place) || (rank(f) == rank(*place) && f.drawn < place->drawn))
+        place = &f;
+    }
+    *place = Format();
+    place->id = id;
+    place->drawn = m_clock;
+    return place;
+  }
+
+  //! The level of a format changes, with the window that made it change
+  Step Change(Format& f, int to, Why why, Step step)
+  {
+    step.changed = true;
+    step.why = why;
+    step.from = f.level;
+    step.to = to;
+    f.cameFrom = f.level;
+    f.leftMs = f.ms[static_cast<size_t>(f.level)];
+    f.level = to;
+    f.Drop();
+    f.skip = std::max(f.skip, SKIP);
+    step.level = to;
+    return step;
+  }
+
+  //! What each level of the ladder of a format takes now, as far as it is known: the level in use
+  //! as last measured, the others by what they took for what the level next to them took, where
+  //! that was measured, else as they were last measured
+  static std::array<double, LEVELS> Now(const Format& f)
+  {
+    std::array<double, LEVELS> now = f.ms;
+    for (int n = f.level, above = Above(f.ladder, n); above >= 0; n = above, above = Above(f.ladder, n))
+    {
+      const size_t at = static_cast<size_t>(n);
+      if (f.ratio[at] > 0 && now[at] > 0)
+        now[static_cast<size_t>(above)] = now[at] * f.ratio[at];
+    }
+    for (int n = f.level, below = Below(f.ladder, n); below >= 0; n = below, below = Below(f.ladder, n))
+    {
+      const size_t at = static_cast<size_t>(below);
