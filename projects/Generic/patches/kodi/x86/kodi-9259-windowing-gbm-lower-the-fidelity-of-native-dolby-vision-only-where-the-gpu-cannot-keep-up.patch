+      // go up all the same: what fits that way fits a frame ahead.)
+      if (w.pace == Pace::PENDING || f.exhausted)
+        return step;
+      // One window that is behind could have been slow for another reason
+      if (!beyond && ++f.behind < 2)
+        return step;
+      f.behind = 0;
+      // A level it went up to that does not keep up after all: it waits longer before it goes up
+      // again
+      if (f.upToKeep)
