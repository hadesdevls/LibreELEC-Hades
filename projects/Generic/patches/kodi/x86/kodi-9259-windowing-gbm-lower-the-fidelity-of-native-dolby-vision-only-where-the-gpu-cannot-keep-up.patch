+
+    const bool known = w.presented >= KNOWN_MIN;
+    const bool missed = w.lost >= Mark(w.presented);
+    bool behind = false;
+    bool beyond = false; // the GPU could not keep up with these frames in any case
+    if (w.pace == Pace::AHEAD)
+    {
+      behind = known && missed && average > step.budgetMs;
+      beyond = average > w.periodMs;
+    }
+    else
+    {
+      behind = known && missed && w.over >= Mark(w.count);
+      beyond = 2 * w.over > w.count;
+    }
+    // what was found when no level kept up is of that refresh period and pace
+    if (f.exhausted && w.pace != Pace::PENDING &&
