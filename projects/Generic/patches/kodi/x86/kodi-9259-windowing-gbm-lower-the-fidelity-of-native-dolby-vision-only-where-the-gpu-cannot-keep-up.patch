diff --git a/xbmc/windowing/gbm/DVPathChoice.h b/xbmc/windowing/gbm/DVPathChoice.h
index 06e349e..0788a4d 100644
--- a/xbmc/windowing/gbm/DVPathChoice.h
+++ b/xbmc/windowing/gbm/DVPathChoice.h
@@ -199,6 +199,39 @@ public:
    */
   Verdict Missed(uint64_t load) { return Spend(load); }
 
+  //! Whether the two ways of drawing the frames of that load are being compared: they are then
+  //! asked for one way and the other (see CDVStepDown, which measures nothing of them meanwhile)
+  bool Comparing(uint64_t load) const
+  {
+    for (const Load& known : m_loads)
+    {
+      if (load != 0 && known.id == load)
+        return known.Comparing();
+    }
+    return false;
+  }
+
+  /*!
+   * \brief The frames of that load are drawn at another fidelity step-down level from now on
+   *        (see CDVStepDown): they are other work
+   *
+   * What its windows had gathered is dropped, and so is a comparison under way (CDVStepDown does
+   * not change a level while one is, but a comparison can begin before the frame that changes it
+   * is measured): its parts would be of two levels. Its next frames are left out, as after a
+   * change of way. Its way, and what its comparisons found, stay: the two ways reconstruct the
+   * same picture at a level, and differ in what they do after it.
+   */
+  void Changed(uint64_t load)
+  {
+    for (Load& known : m_loads)
+    {
+      if (load == 0 || known.id != load)
+        continue;
+      known.Forget();
+      known.skip = SKIP;
+    }
+  }
+
   /*!
    * \brief Take the GPU time of a frame without GUI elements
    * \param asked the way that was asked for
@@ -800,6 +833,9 @@ public:
     return residual ? load | RESIDUAL : load & ~RESIDUAL;
   }
 
+  //! Whether the residual of the enhancement layer is drawn in the frames of a load
+  static bool WithResidual(uint64_t load) { return (load & RESIDUAL) != 0; }
+
   //! For the log: how many 64ths of the picture of a load are active
   static unsigned int Active64ths(uint64_t load) { return static_cast<unsigned int>(load & 0x7f); }
 
