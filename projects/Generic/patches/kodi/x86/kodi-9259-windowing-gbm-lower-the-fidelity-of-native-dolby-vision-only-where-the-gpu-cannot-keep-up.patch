+  static unsigned int Hundredths(double ms)
+  {
+    if (!(ms > 0))
+      return 0;
+    const double hundredths = std::round(ms * 100.0);
+    if (!(hundredths >= 1.0))
+      return 1;
+    return hundredths > static_cast<double>(MAX_HUNDREDTHS)
+               ? static_cast<unsigned int>(MAX_HUNDREDTHS)
+               : static_cast<unsigned int>(hundredths);
+  }
+
+  //! Reads a number as Known() writes one (digits only, lower case, no zero before another
+  //! digit); false when there is none at that place, or it is more than max
+  static bool Number(const std::string& text, size_t& at, unsigned int base, uint64_t max,
+                     uint64_t& value)
+  {
+    const size_t start = at;
+    value = 0;
+    while (at < text.size())
+    {
+      const char c = text[at];
+      unsigned int digit = 0;
+      if (c >= '0' && c <= '9')
+        digit = static_cast<unsigned int>(c - '0');
+      else if (base == 16 && c >= 'a' && c <= 'f')
+        digit = static_cast<unsigned int>(c - 'a') + 10;
+      else
+        break;
+      if (digit > max || value > (max - digit) / base)
+        return false;
+      value = value * base + digit;
+      ++at;
+    }
+    return at > start && (at - start == 1 || text[start] != '0');
+  }
+
+  static bool Skip(const std::string& text, size_t& at, char c)
+  {
+    if (at >= text.size() || text[at] != c)
+      return false;
+    ++at;
+    return true;
+  }
+
+  std::array<Format, FORMATS> m_formats{};
+  uint64_t m_clock = 0; //!< counts the frames drawn
+  double m_settlingMs = SETTLE_MS; //!< time of measured frames still left out, of any format
+};
