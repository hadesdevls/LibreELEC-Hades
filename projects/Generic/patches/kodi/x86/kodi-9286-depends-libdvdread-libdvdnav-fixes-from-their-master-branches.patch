+From f5cdeae910b62fa73dc48a7be6a7d087669791fe Mon Sep 17 00:00:00 2001
+From: Jean-Baptiste Kempf <jb@kyber.tech>
+Date: Fri, 31 Jul 2026 18:03:54 +0000
+Subject: [PATCH] dvd_reader: check arguments before dereferencing dvd_file
+
+---
+ src/dvd_reader.c | 7 +++++--
+ 1 file changed, 5 insertions(+), 2 deletions(-)
+
+diff --git a/src/dvd_reader.c b/src/dvd_reader.c
+index 56351719c37d..ce3939b6752f 100644
+--- a/src/dvd_reader.c
++++ b/src/dvd_reader.c
+@@ -1849,14 +1849,17 @@ static int DVDReadBlocksPath( const dvd_file_t *dvd_file, unsigned int offset,
+ ssize_t DVDReadBlocks( dvd_file_t *dvd_file, int offset,
+                        size_t block_count, unsigned char *data )
+ {
+-  dvd_reader_t *ctx = dvd_file->ctx;
+-  dvd_reader_device_t *dvd = ctx->rd;
++  dvd_reader_t *ctx;
++  dvd_reader_device_t *dvd;
+   int ret;
+ 
+   /* Check arguments. */
+   if( dvd_file == NULL || offset < 0 || data == NULL )
+     return -1;
+ 
++  ctx = dvd_file->ctx;
++  dvd = ctx->rd;
++
+   /* Hack, and it will still fail for multiple opens in a threaded app ! */
+   if( dvd->css_title != dvd_file->css_title ) {
+       dvd->css_title = dvd_file->css_title;
diff --git a/tools/depends/target/libdvdread/11-all-nav_read-zero-init-pci.patch b/tools/depends/target/libdvdread/11-all-nav_read-zero-init-pci.patch
new file mode 100644
index 0000000..2b64a4e
--- /dev/null
+++ b/tools/depends/target/libdvdread/11-all-nav_read-zero-init-pci.patch
@@ -0,0 +1,27 @@
+From 534350c18c01dd1b85c7ec5e0f05db3d66351c7c Mon Sep 17 00:00:00 2001
+From: Jean-Baptiste Kempf <jb@kyber.tech>
+Date: Fri, 31 Jul 2026 18:00:36 +0000
+Subject: [PATCH] nav_read: zero-initialize the PCI structure before parsing
+
+navRead_PCI fills the structure field by field. Now that pci_t is no
+longer packed, it needs init.
+---
+ src/nav_read.c | 5 +++++
+ 1 file changed, 5 insertions(+)
+
+diff --git a/src/nav_read.c b/src/nav_read.c
+index 5f487f26fefb..4d095d7044ea 100644
+--- a/src/nav_read.c
++++ b/src/nav_read.c
+@@ -72,6 +72,11 @@ void navRead_PCI(pci_t *pci, unsigned char *buffer) {
+   getbits_state_t state;
+   if (!getbits_init(&state, buffer)) abort(); /* Passed NULL pointers */
+ 
++  /* pci_t is no longer packed, so it now has padding bytes that the field by
++   * field parsing below never writes; clear them to keep the whole structure
++   * deterministic for callers that copy or hash it. */
++  memset(pci, 0, sizeof(*pci));
