diff --git a/tools/depends/target/libdvdread/22-all-dvd_udf-backup-VDS-from-rvds.patch b/tools/depends/target/libdvdread/22-all-dvd_udf-backup-VDS-from-rvds.patch
new file mode 100644
index 0000000..794cfb9
--- /dev/null
+++ b/tools/depends/target/libdvdread/22-all-dvd_udf-backup-VDS-from-rvds.patch
@@ -0,0 +1,28 @@
+From ce9bdb7775601f4e6b95136b875bc72a53c5ba7d Mon Sep 17 00:00:00 2001
+From: Petri Hintukainen <phintuka@gmail.com>
+Date: Sat, 8 Aug 2026 01:37:46 +0300
+Subject: [PATCH] dvd_udf: use the backup volume descriptor sequence from the
+ AVDP rvds
+
+When the partition or volume could not be found in the main volume
+descriptor sequence, the fallback retried the same main sequence again
+instead of the backup sequence.
+---
+ src/dvd_udf.c | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/src/dvd_udf.c b/src/dvd_udf.c
+index 3f3ff7ea3b21..11c884c7ddbd 100644
+--- a/src/dvd_udf.c
++++ b/src/dvd_udf.c
+@@ -819,8 +819,8 @@ static int UDFFindPartition( dvd_reader_t *ctx, int partnum,
+ 
+     if( ( !part->valid) || ( !volvalid ) ) {
+       /* Backup volume descriptor */
+-      MVDS_location = avdp.mvds.location;
+-      MVDS_length = avdp.mvds.length;
++      MVDS_location = avdp.rvds.location;
++      MVDS_length = avdp.rvds.length;
+     }
+   } while( i-- && ( ( !part->valid ) || ( !volvalid ) ) );
+ 
diff --git a/tools/depends/target/libdvdread/23-all-ifo_read-avoid-large-negative-info_length.patch b/tools/depends/target/libdvdread/23-all-ifo_read-avoid-large-negative-info_length.patch
new file mode 100644
index 0000000..67435f6
--- /dev/null
+++ b/tools/depends/target/libdvdread/23-all-ifo_read-avoid-large-negative-info_length.patch
@@ -0,0 +1,71 @@
+From 636a8e2c13b6ae3181d4d9e78bbb2341b8acad5b Mon Sep 17 00:00:00 2001
+From: Steve Lhomme <robux4@ycbcr.xyz>
+Date: Thu, 30 Jul 2026 12:09:03 +0200
+Subject: [PATCH] ifo_read: avoid potential large/negative info_length from
+ read data
+
+---
+ src/ifo_read.c | 15 +++++++++------
+ 1 file changed, 9 insertions(+), 6 deletions(-)
+
+diff --git a/src/ifo_read.c b/src/ifo_read.c
+index 36ac33e3c590..da9ace5edc3c 100644
+--- a/src/ifo_read.c
++++ b/src/ifo_read.c
+@@ -2363,7 +2363,7 @@ int ifoRead_TT_SRPT(ifo_handle_t *ifofile) {
+   struct ifo_handle_private_s *ifop = PRIV(ifofile);
+   tt_srpt_t *tt_srpt;
+   unsigned int i;
+-  size_t info_length;
++  size_t info_length = 0;
+ 
+   if(!ifofile)
+     return 0;
+@@ -2396,7 +2396,8 @@ int ifoRead_TT_SRPT(ifo_handle_t *ifofile) {
+   if(tt_srpt->last_byte == 0) {
+     tt_srpt->last_byte = tt_srpt->nr_of_srpts * sizeof(title_info_t) - 1 + TT_SRPT_SIZE;
+   }
+-  info_length = tt_srpt->last_byte + 1 - TT_SRPT_SIZE;
++  if(tt_srpt->last_byte >= TT_SRPT_SIZE - 1)
++    info_length = tt_srpt->last_byte + 1 - TT_SRPT_SIZE;
+ 
+   tt_srpt->title = calloc(1, info_length);
+   if(!tt_srpt->title) {
+@@ -2476,7 +2477,7 @@ void ifoFree_TT_SRPT(ifo_handle_t *ifofile) {
+ int ifoRead_VTS_PTT_SRPT(ifo_handle_t *ifofile) {
+   struct ifo_handle_private_s *ifop = PRIV(ifofile);
+   vts_ptt_srpt_t *vts_ptt_srpt = NULL;
+-  int info_length, i, j;
++  int info_length = 0, i, j;
+   uint32_t *data = NULL;
+ 
+   if(!ifofile)
+@@ -2515,7 +2516,8 @@ int ifoRead_VTS_PTT_SRPT(ifo_handle_t *ifofile) {
+   if(vts_ptt_srpt->last_byte == 0) {
+     vts_ptt_srpt->last_byte  = vts_ptt_srpt->nr_of_srpts * sizeof(*data) - 1 + VTS_PTT_SRPT_SIZE;
+   }
+-  info_length = vts_ptt_srpt->last_byte + 1 - VTS_PTT_SRPT_SIZE;
++  if(vts_ptt_srpt->last_byte >= VTS_PTT_SRPT_SIZE - 1)
++    info_length = vts_ptt_srpt->last_byte + 1 - VTS_PTT_SRPT_SIZE;
+   data = calloc(1, info_length);
+   if(!data)
+     goto fail;
+@@ -3117,7 +3119,7 @@ static int ifoRead_VOBU_ADMAP_internal(ifo_handle_t *ifofile,
+                                        unsigned int sector) {
+   struct ifo_handle_private_s *ifop = PRIV(ifofile);
+   unsigned int i;
+-  int info_length;
++  size_t info_length = 0;
+ 
+   if(!DVDFileSeekForce_(ifop->file, sector * DVD_BLOCK_LEN, sector))
+     return 0;
+@@ -3127,7 +3129,8 @@ static int ifoRead_VOBU_ADMAP_internal(ifo_handle_t *ifofile,
+ 
+   B2N_32(vobu_admap->last_byte);
+ 
+-  info_length = vobu_admap->last_byte + 1 - VOBU_ADMAP_SIZE;
++  if(vobu_admap->last_byte >= VOBU_ADMAP_SIZE - 1)
++    info_length = vobu_admap->last_byte + 1 - VOBU_ADMAP_SIZE;
+   /* assert(info_length > 0);
+      Magic Knight Rayearth Daybreak is mastered very strange and has
+      Titles with a VOBS that has no VOBUs. */
diff --git a/tools/depends/target/libdvdread/24-all-ifo_read-error-if-vobu_admap-last_byte-too-small.patch b/tools/depends/target/libdvdread/24-all-ifo_read-error-if-vobu_admap-last_byte-too-small.patch
new file mode 100644
index 0000000..d1ca2ed
--- /dev/null
+++ b/tools/depends/target/libdvdread/24-all-ifo_read-error-if-vobu_admap-last_byte-too-small.patch
@@ -0,0 +1,27 @@
+From 09530764823f3fb5b9ab32b80e4620438c1eed53 Mon Sep 17 00:00:00 2001
+From: Steve Lhomme <robux4@ycbcr.xyz>
+Date: Fri, 14 Aug 2026 09:22:39 +0200
+Subject: [PATCH] ifo_read: issue an error if the VOBU_ADMAP last_byte is too
+ small
+
+We cannot parse the data.
+---
+ src/ifo_read.c | 5 +++++
+ 1 file changed, 5 insertions(+)
+
+diff --git a/src/ifo_read.c b/src/ifo_read.c
+index 80e6a64f6f9c..e145eb13bebe 100644
+--- a/src/ifo_read.c
++++ b/src/ifo_read.c
+@@ -3131,6 +3131,11 @@ static int ifoRead_VOBU_ADMAP_internal(ifo_handle_t *ifofile,
+ 
+   if(vobu_admap->last_byte >= VOBU_ADMAP_SIZE - 1)
+     info_length = vobu_admap->last_byte + 1 - VOBU_ADMAP_SIZE;
++  else {
++    Log0(ifop->ctx, "VOBU_ADMAP last_byte too small in %s:%i %" PRIu32,
++         __FILE__, __LINE__, vobu_admap->last_byte );
++    return 0;
++  }
+   /* assert(info_length > 0);
+      Magic Knight Rayearth Daybreak is mastered very strange and has
+      Titles with a VOBS that has no VOBUs. */
