+  /*!
+   * \brief Hades: what native Dolby Vision gives the property when it ends, by the setting that the
+   *        user has now (they may have changed it meanwhile): what Wanted() says for the value that
+   *        the end puts back (connector.kernel is that value: what was found). Nothing: it goes
+   *        back as found (the setting agrees, or the driver refused it REFUSALS times: givenUp).
+   */
+  static std::optional<uint64_t> AtHandBack(bool setting, const Connector& connector, bool givenUp)
+  {
+    if (givenUp)
+      return std::nullopt;
+    const auto want = Wanted(setting, connector);
+    if (!want || (connector.kernel && *want == *connector.kernel))
+      return std::nullopt;
+    return want;
+  }
