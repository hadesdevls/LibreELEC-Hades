+#ifdef HAVE_DVBRIDGE
+void CWinSystemGbm::HandBackIntents(COutputHandover& state)
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  std::vector<std::pair<std::string, uint64_t>> intents;
+  if (connector)
+  {
+    // The colour range: what CRgbRange says of the value that the end puts back (what was found),
+    // for the setting now
+    if (const auto found = state.FoundValue(CRgbRange::PROPERTY))
+    {
+      CRgbRange::Connector range = RgbRangeOf(connector);
+      range.kernel = found;
+      if (const auto value = CRgbRange::AtHandBack(LimitedRangeSetting(), range,
+                                                   m_rgbRangeRefusals >= CRgbRange::REFUSALS))
+        intents.emplace_back(CRgbRange::PROPERTY, *value);
+    }
+    // The colour format: what OUTPUT_FORMAT::Stage() says for a request with a mode set
+    if (m_outputFormatChoice && !m_formatProperty.empty())
+    {
+      OUTPUT_FORMAT::Format format = OUTPUT_FORMAT::Format::AUTO;
+      const auto chosen = ChosenOutputFormat(*connector, format);
+      const std::string key = OutputModeKey() + ":" + std::to_string(static_cast<int>(format));
+      if (const auto value = OUTPUT_FORMAT::Stage(true, false, true, chosen,
+                                                  state.FoundValue(m_formatProperty.c_str()),
+                                                  m_formatRefusedKey == key))
+        intents.emplace_back(m_formatProperty, *value);
+    }
+  }
+  state.SetHandBackIntents(intents);
+}
+#endif
