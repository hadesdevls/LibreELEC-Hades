+  /*!
+   * \brief What the settings of Kodi say now of the properties that they own (the colour range, the
+   *        colour format): at the end the output has that, and not what was found when the user has
+   *        changed a setting during native output. Replaces what was said before; a property
+   *        whose intent the driver refused is not given one again. Connector properties only.
+   */
+  void SetIntents(const std::vector<std::pair<std::string, uint64_t>>& intents)
+  {
+    for (auto& entry : m_entries)
+      entry.hasIntent = false;
+    for (const auto& [name, value] : intents)
+      for (auto& entry : m_entries)
+        if (entry.role == Role::CONNECTOR && entry.info.name == name && entry.restorable &&
+            !entry.leaveEmpty && entry.info.kind != Kind::BLOB && entry.info.Accepts(value) &&
+            !m_intentRefused.count(entry.Key()))
+        {
+          entry.hasIntent = true;
+          entry.intent = value;
+        }
+  }
+
+  //! The value that a property had when it was captured (not a blob)
+  std::optional<uint64_t> Found(Role role, std::string_view name) const
+  {
+    const Entry* entry = Find(role, name);
+    if (!entry || !entry->restorable || entry->info.kind == Kind::BLOB)
+      return std::nullopt;
+    return entry->original;
+  }
+
