From 9a98722bfb2920b847331201b37f693da31082bc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:24:33 +0000
Subject: [PATCH] windowing/gbm: HDR10+ chosen again in a video takes no second
 mode set where the CTA VIC is kept

420d5e2 sets the mode again where HDR10+ starts in the middle of a
video on i915 and xe at a mode they name by an HDMI VIC. Going from
HDR10+ to HDR10 and back to HDR10+ in the same video then set the mode a
second time, although the AVI InfoFrame still names the mode by its CTA
VIC: i915 and xe (linux-9982) and NVKMS (nvidia-open-kernel-modules-
9050) keep it in every commit of that mode after HDR10+ went out at it,
with HDR10+ or without, until the next change of mode. On NVIDIA the
second start was told as a change of the AVI InfoFrame that does not
happen.

CCtaVicKept (DVPlusModeStart.h) follows that: the CTA VIC is taken as
kept after a commit that the kernel took with HDR10+ of Kodi's on the
connector (CHDR10PlusOutput::Sent() of HDR10PLUS_VSIF as the kernel
keeps it), for that CRTC and mode, while the display watch counts no
hot-plug since. It is forgotten, fail-closed (the mode is then set again
as before), by any commit that may set a mode without HDR10+ in it (a
pending mode set, or a display reset, where not known), another mode or
CRTC, a hot-plug, a lost device (OnLostDevice()) and a hidden output
(Hide()). CWinSystemGbm::FlipPage() tells it of each commit, after
HDR10PlusCommitted(). Where it is kept, CDVPlusModeStart::ForMidVideo()
says CTA_VIC_KEPT: HDR10+ starts again with a flip, on i915, xe and
nvidia-drm, and the log says so ("DVBridge: HDR10+ starts again in the
middle of the video (the output chosen for it), with a flip: the AVI
InfoFrame names this mode by its CTA VIC already ...").

Tested on the host: dvplus_midvideo_test with the sequence (34 checks:
HDR10 at the start, the mode again for HDR10+, HDR10, HDR10+ again with
no mode set; a mode set without HDR10+, another mode, a hot-plug,
another CRTC, a lost device, no CRTC; NVIDIA and amdgpu). It does not
build against 420d5e2's header, and four mutations make it fail (the
kept CTA VIC ignored, a mode set ignored, the mode ignored, a loss
ignored). Syntax: the sources that the build compiles with these files.
Not run on a GPU.
---
 xbmc/windowing/gbm/DVPlusModeStart.h          | 72 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 27 ++++++-
 xbmc/windowing/gbm/WinSystemGbm.h             |  5 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  7 ++
 4 files changed, 108 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/DVPlusModeStart.h b/xbmc/windowing/gbm/DVPlusModeStart.h
index c595257..d68a985 100644
--- a/xbmc/windowing/gbm/DVPlusModeStart.h
+++ b/xbmc/windowing/gbm/DVPlusModeStart.h
@@ -148,15 +148,83 @@ public:
     //! (nvidia-open-kernel-modules-9050); a commit that allows a mode set changes nothing more
     //! there (the mode is the same, so DRM sets no mode)
     AVI_CHANGES,
+    //! either of those two, where the AVI InfoFrame names the mode by its CTA VIC already, since
+    //! HDR10+ went out at that mode and no mode was set since (CCtaVicKept): i915, xe and NVKMS
+    //! keep it until the next change of mode, so HDR10+ starts again with a flip, and nothing else
+    //! changes
+    CTA_VIC_KEPT,
   };
 
-  //! \param needed NeededFor() the mode on the screen; \param nvidiaAvi NeededForNvidia() for it
-  static MidVideo ForMidVideo(bool needed, bool nvidiaAvi)
+  //! \param needed NeededFor() the mode on the screen; \param nvidiaAvi NeededForNvidia() for it;
+  //! \param kept CCtaVicKept::Kept() for it
+  static MidVideo ForMidVideo(bool needed, bool nvidiaAvi, bool kept)
   {
+    if ((needed || nvidiaAvi) && kept)
+      return MidVideo::CTA_VIC_KEPT;
     return needed ? MidVideo::MODE_AGAIN : nvidiaAvi ? MidVideo::AVI_CHANGES : MidVideo::FLIP;
   }
 };
 
+/*!
+ * \brief Hades: whether the AVI InfoFrame names the mode on the screen by its CTA VIC since the
+ * last
+ *        mode set, because HDR10+ went out at it (CDVPlusModeStart::MidVideo::CTA_VIC_KEPT)
+ *
+ * i915 and xe (linux-9982) and NVKMS (nvidia-open-kernel-modules-9050) put the CTA VIC of a mode
+ * that DRM or NVKMS name by an HDMI VIC in the AVI InfoFrame where HDR10+ goes out, and keep it in
+ * every commit of the same mode after it, with HDR10+ or without, until the next change of mode.
+ * Taken as kept only after a commit that the kernel took with HDR10+ of Kodi's on the connector,
+ * and only for that CRTC and mode and while no display was plugged or unplugged since; anything
+ * else forgets it, fail-closed (then HDR10+ in the middle of a video sets the mode again, as at the
+ * start of a video): any commit that may have set a mode without HDR10+ in it, another mode or
+ * CRTC, a hot-plug, a lost device or a hidden output (Lost()).
+ */
+class CCtaVicKept
+{
+public:
+  //! the mode on the screen, as this looks at it (crtc 0: none known, never kept)
+  struct Mode
+  {
+    uint32_t crtc = 0;
+    int width = 0;
+    int height = 0;
+    int clock = 0;
+    int htotal = 0;
+    int vtotal = 0;
+    uint32_t flags = 0;
+    unsigned int hotplugs = 0; //!< the count of hot-plugs of the display watch then
+    bool operator==(const Mode&) const = default;
+  };
+
+  /*!
+   * \brief A commit was made (CWinSystemGbm::FlipPage())
+   * \param modeset it may have set a mode (fail-closed: true where that is not known)
+   * \param hdr10Plus HDR10+ of Kodi's is on the connector after it, as the kernel keeps
+   *        HDR10PLUS_VSIF (CHDR10PlusOutput::Sent())
+   * \param mode the mode on the screen after it
+   */
+  void Committed(bool modeset, bool hdr10Plus, const Mode& mode)
+  {
+    if (hdr10Plus && mode.crtc != 0)
+    {
+      m_kept = true;
+      m_mode = mode;
+      return;
+    }
+    if (modeset || !(mode == m_mode))
+      m_kept = false;
+  }
+
+  //! the output was hidden or the device lost: nothing is known of what goes out
+  void Lost() { m_kept = false; }
+
+  bool Kept(const Mode& now) const { return m_kept && now.crtc != 0 && now == m_mode; }
+
+private:
+  bool m_kept = false;
+  Mode m_mode;
+};
+
 } // namespace GBM
 } // namespace WINDOWING
 } // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 6731e1a..1c2ba86 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2941,12 +2941,16 @@ void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
   StageHdmiVrrOff();
   // Hades: ... and Kodi's limited range asked of the driver, in a commit with a mode set (CRgbRange)
   StageRgbRange();
+  // Hades: whether this commit may set a mode, for CCtaVicKept (fail-closed: yes where not known)
+  const auto atomicForCta = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const bool mayModeset = !atomicForCta || atomicForCta->ModesetPending() || m_dispReset;
   m_DRM->FlipPage(bo, rendered, videoLayer, async);
   // Hades: a change of mode that the driver kept refusing was given up (CModesetRetry)
   if (m_DRM->TakeModesetGivenUp())
     AnnounceModesetGivenUp();
   // Hades: whether the driver took the HDR10+ metadata that the request carried
   HDR10PlusCommitted();
+  m_ctaVicKept.Committed(mayModeset, HDR10PlusSent().has_value(), CtaVicMode());
   HdmiVrrOffCommitted();
   RgbRangeCommitted();
   // ... and the commit that a hold of the change of mode released, if any, went out
@@ -3010,6 +3014,8 @@ bool CWinSystemGbm::Hide()
     TellModeHoldEnd();
   AnnounceHeldModeChange(false);
 #endif
+  // Hades: nothing is known of the signalling of the output once it is off (CCtaVicKept)
+  m_ctaVicKept.Lost();
   bool ret = m_DRM->SetActive(false);
   FlipPage(false, false, false);
 #ifdef HAVE_DVBRIDGE
@@ -3064,6 +3070,7 @@ void CWinSystemGbm::OnLostDevice()
   }
   CLog::Log(LOGDEBUG, "{} - notify display change event", __FUNCTION__);
   m_dispReset = true;
+  m_ctaVicKept.Lost(); // (Hades: CCtaVicKept)
 
   std::unique_lock lock(m_resourceSection);
   std::vector<IDispResource*> resources = m_resources;
@@ -3872,7 +3879,7 @@ CDVPlusModeStart::MidVideo CWinSystemGbm::HDR10PlusStartMidVideo(std::string& wh
       StringUtils::Format("{} at {}x{} {:.3f} Hz", driver, mode->hdisplay, mode->vdisplay, refresh);
   const CDVPlusModeStart::MidVideo how = CDVPlusModeStart::ForMidVideo(
       CDVPlusModeStart::NeededFor(driver, mode->hdisplay, mode->vdisplay, refresh),
-      HDR10PlusChangesAviAfterMode());
+      HDR10PlusChangesAviAfterMode(), m_ctaVicKept.Kept(CtaVicMode()));
   if (how == CDVPlusModeStart::MidVideo::MODE_AGAIN)
   {
     m_hdr10Plus.NewVideo();
@@ -3884,6 +3891,24 @@ CDVPlusModeStart::MidVideo CWinSystemGbm::HDR10PlusStartMidVideo(std::string& wh
   return how;
 }
 
+CCtaVicKept::Mode CWinSystemGbm::CtaVicMode() const
+{
+  CCtaVicKept::Mode now;
+  const auto* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  if (!crtc || !mode)
+    return now;
+  now.crtc = crtc->GetCrtcId();
+  now.width = mode->hdisplay;
+  now.height = mode->vdisplay;
+  now.clock = static_cast<int>(mode->clock);
+  now.htotal = mode->htotal;
+  now.vtotal = mode->vtotal;
+  now.flags = mode->flags;
+  now.hotplugs = m_displayWatch ? m_displayWatch->Hotplugs() : 0;
+  return now;
+}
+
 int CWinSystemGbm::HDR10PlusOutputVersion() const
 {
   CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 9065446..fc1215b 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -333,6 +333,8 @@ protected:
    * \param what for the log: the driver, the mode and its rate
    */
   CDVPlusModeStart::MidVideo HDR10PlusStartMidVideo(std::string& what);
+  //! Hades: the mode on the screen, for CCtaVicKept
+  CCtaVicKept::Mode CtaVicMode() const;
   //! Hades: nvidia-drm puts the CTA VIC of the mode on the screen in the AVI InfoFrame at the first
   //! HDR10+ frame, for this display (CDVPlusModeStart::NeededForNvidia())
   bool HDR10PlusChangesAviAfterMode() const;
@@ -781,6 +783,9 @@ private:
   //! Hades: HDR10+ (SetHDR10Plus()): what is queued, and the blobs of the last payloads, kept
   //! while a request that falls back may still name them
   CHDR10PlusOutput m_hdr10Plus;
+  //! Hades: the AVI InfoFrame names the mode by its CTA VIC since HDR10+ went out at it
+  //! (HDR10PlusStartMidVideo())
+  CCtaVicKept m_ctaVicKept;
   std::array<CDRMPropertyBlob, 4> m_hdr10PlusBlobs;
   std::size_t m_hdr10PlusNextBlob = 0;
   unsigned int m_hdr10PlusTold = 0; //!< HDR10PlusTold bits written in this video
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 3382e0d..05a8e39 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3633,6 +3633,13 @@ void CWinSystemGbmGLESContext::DVPlusMidVideo(bool wasSending, bool sends)
                 "moment at that change, the picture is the same",
                 what);
       break;
+    case CDVPlusModeStart::MidVideo::CTA_VIC_KEPT:
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10+ starts again in the middle of the video (the output chosen for "
+                "it), with a flip: the AVI InfoFrame names this mode by its CTA VIC already ({}: "
