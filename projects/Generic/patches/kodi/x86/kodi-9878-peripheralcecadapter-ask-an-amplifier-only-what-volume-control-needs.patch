From 74c6c2219b2e040e8f082f1681b03f2fd7a8b0c1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:04:40 +0000
Subject: [PATCH] PeripheralCecAdapter: ask an amplifier only what volume
 control needs

The update thread of the CEC adapter settles the volume target and only
then accepts the keys of the remote (m_bIsReady). Before that it asked the
amplifier for its OSD name, its system audio mode and its audio status,
whatever the setting of volume commands over CEC. Each request that an
amplifier does not answer costs libCEC its transmit wait, a second each
try, and the OSD name request is preceded by one for the vendor id: an
amplifier that answers slowly or not at all held up the remote for
seconds after every start and every reconnection.

- With volume commands over CEC set to none, the amplifier never gets the
  volume, whatever it answers: it is no longer asked for its system audio
  mode or its audio status. The volume target is the same as before
  (Kodi's own mixer), and kodi.log says once that the amplifier was not
  asked.
- The OSD names of the TV and the amplifier only go into the "Connected"
  notification. They are now asked for once the keys are accepted, so the
  notification keeps them and no longer holds up the remote. The name of
  the amplifier is no longer asked for again, and dropped, at every update
  of the configuration. The notification puts a space before the dash
  ("Connected: TV - Amplifier"; it read "TV- Amplifier").
- kodi.log tells how long after the connection was opened the keys were
  accepted.

Nothing changes for an amplifier that handles the volume: it is asked for
its system audio mode and its mute state as before, before the keys are
accepted.

Idea: Portisch (CoreELEC), who skips the queries of an amplifier without
volume control and drops its name from the notification. Here the name
stays in the notification and is asked for after the keys are accepted.

Tests (outside the tree): the real PeripheralCecAdapter.cpp built on the
host against a libCEC adapter that answers like an amplifier that does not
reply, and stand-ins of the rest of Kodi.
---
 .../devices/PeripheralCecAdapter.cpp          | 58 ++++++++++++-------
 .../devices/PeripheralCecAdapter.h            |  6 +-
 2 files changed, 42 insertions(+), 22 deletions(-)

diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
index 3663572..3a218f1 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.cpp
@@ -1766,10 +1766,8 @@ void CPeripheralCecAdapterUpdateThread::UpdateTvVolumeTarget(void)
   m_adapter->SetTvVolumeTarget(target);
 }
 
-std::string CPeripheralCecAdapterUpdateThread::UpdateAudioSystemStatus(void)
+bool CPeripheralCecAdapterUpdateThread::UpdateAudioSystemStatus(void)
 {
-  std::string strAmpName;
-
   /* the TV takes over whenever the amp is not handling volume, so settle on it first */
   UpdateTvVolumeTarget();
 
@@ -1777,26 +1775,34 @@ std::string CPeripheralCecAdapterUpdateThread::UpdateAudioSystemStatus(void)
   {
     CLog::Log(LOGDEBUG, "{} - no CEC capable amplifier found", __FUNCTION__);
     m_adapter->SetAmpControlsVolume(false);
-    return strAmpName;
+    return false;
   }
 
-  // request the OSD name of the amp
-  std::string ampName(m_adapter->m_cecAdapter->GetDeviceOSDName(CECDEVICE_AUDIOSYSTEM));
-  strAmpName += ampName;
+  /* with volume commands over CEC set to none the amp never gets the volume, whatever it
+     answers. an amp that answers slowly or not at all would only hold up the remote. */
+  if (m_adapter->GetSettingInt("volume_control") == LOCALISED_ID_NONE)
+  {
+    CLog::Log(LOGINFO,
+              "{} - CEC capable amplifier found; volume commands over CEC are set to none, so it "
+              "is not asked for its audio state",
+              __FUNCTION__);
+    m_adapter->SetAmpControlsVolume(false);
+    return true;
+  }
 
 #if CEC_LIB_HAS_SYSTEM_AUDIO_MODE_STATUS
   /* an amp only acts on volume keypresses while system audio mode is on. handing it the volume
      while it is off leaves the user with no working volume control at all. */
   if (m_adapter->m_cecAdapter->SystemAudioModeStatus() != CEC_SYSTEM_AUDIO_STATUS_ON)
   {
-    CLog::Log(LOGDEBUG, "{} - CEC capable amplifier found ({}), but system audio mode is off",
-              __FUNCTION__, ampName);
+    CLog::Log(LOGDEBUG, "{} - CEC capable amplifier found, but system audio mode is off",
+              __FUNCTION__);
     m_adapter->SetAmpControlsVolume(false);
-    return strAmpName;
+    return true;
   }
 #endif
 
-  CLog::Log(LOGDEBUG, "{} - CEC capable amplifier found ({})", __FUNCTION__, ampName);
+  CLog::Log(LOGDEBUG, "{} - CEC capable amplifier found", __FUNCTION__);
 
   m_adapter->SetAmpControlsVolume(true);
 
@@ -1806,11 +1812,13 @@ std::string CPeripheralCecAdapterUpdateThread::UpdateAudioSystemStatus(void)
     m_adapter->SetAmpMuted((audioStatus & CEC_AUDIO_MUTE_STATUS_MASK) ==
                            CEC_AUDIO_MUTE_STATUS_MASK);
 
-  return strAmpName;
+  return true;
 }
 
 bool CPeripheralCecAdapterUpdateThread::SetInitialConfiguration(void)
 {
+  const auto start = std::chrono::steady_clock::now();
+
   // the option to make XBMC the active source is set
   if (m_configuration.bActivateSource == 1)
     m_adapter->m_cecAdapter->SetActiveSource();
@@ -1829,17 +1837,25 @@ bool CPeripheralCecAdapterUpdateThread::SetInitialConfiguration(void)
 
   UpdateMenuLanguage();
 
-  // request the OSD name of the TV
-  std::string strNotification;
-  std::string tvName(m_adapter->m_cecAdapter->GetDeviceOSDName(CECDEVICE_TV));
-  strNotification = StringUtils::Format(
-      "{}: {}", CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36016), tvName);
-
-  std::string strAmpName = UpdateAudioSystemStatus();
-  if (!strAmpName.empty())
-    strNotification += StringUtils::Format("- {}", strAmpName);
+  const bool bAmpFound = UpdateAudioSystemStatus();
 
   m_adapter->m_bIsReady = true;
+  const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now() - start);
+  CLog::Log(LOGINFO, "{} - CEC remote keys accepted {} ms after the connection was opened",
+            __FUNCTION__, elapsed.count());
+
+  /* the names are only shown in the notification, so they are asked for once the keys are
+     accepted: a device that answers slowly or not at all no longer holds up the remote */
+  std::string strNotification = StringUtils::Format(
+      "{}: {}", CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36016),
+      m_adapter->m_cecAdapter->GetDeviceOSDName(CECDEVICE_TV));
+  if (bAmpFound)
+  {
+    const std::string ampName(m_adapter->m_cecAdapter->GetDeviceOSDName(CECDEVICE_AUDIOSYSTEM));
+    CLog::Log(LOGDEBUG, "{} - CEC capable amplifier: {}", __FUNCTION__, ampName);
+    strNotification += StringUtils::Format(" - {}", ampName);
+  }
 
   // and let the gui know that we're done
   CGUIDialogKaiToast::QueueNotification(
diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.h b/xbmc/peripherals/devices/PeripheralCecAdapter.h
index e30a6ba..3d66604 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.h
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.h
@@ -246,7 +246,11 @@ public:
 protected:
   void UpdateMenuLanguage(void);
   void UpdateTvVolumeTarget(void);
-  std::string UpdateAudioSystemStatus(void);
+  /*!
+   * @brief Settle which device handles volume and mute, asking the amp only what that needs.
+   * @return True when a CEC capable amp is on the bus, whether or not it handles the volume.
+   */
+  bool UpdateAudioSystemStatus(void);
   bool WaitReady(void);
   bool SetInitialConfiguration(void);
   void Process(void) override;
-- 
