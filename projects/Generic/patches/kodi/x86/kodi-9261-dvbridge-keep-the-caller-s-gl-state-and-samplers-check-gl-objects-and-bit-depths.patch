From 8246f9e60c839134d855df4578bf263d6600cde9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:19:28 +0000
Subject: [PATCH] dvbridge: keep the caller's GL state and samplers, check GL
 objects and bit depths

- The native renders put back only the viewport, the scissor rectangle, the
  write mask and the capabilities. The program, vertex array, buffer,
  framebuffers, blending and the textures and samplers of the first texture
  units stayed as libplacebo left them. They now keep all of
  dvbridge_gl_state, as the reconstruction for output as HDR10 already did.
- libplacebo sets the filtering and wrapping of a texture on the texture
  itself. A sampler object bound on a unit overrides that, and one with its
  default filtering (which asks for mipmaps) makes the texture incomplete: in
  the host test every render with such samplers bound on the first 16 units
  gave other bytes. No sampler object stays bound on those units during a
  render; they are put back after it.
- The packer and the copier used their vertex array and sampler without
  checking that they were made: they are not made either when one is not
  (a name of 0, or a GL error), and the native output is then not started.
- The reshaping takes its pivots and coefficients in codes of the bit depth
  that the RPU gives, and libplacebo reads the samples at the depth of the
  imported planes. A base layer of another depth than bl_bit_depth now
  refuses the frame; an enhancement layer of another depth than el_bit_depth
  is left out as a missing one is (its residual omitted and counted) instead
  of being added at the wrong scale. Each is logged once per stream.

Tested on the host, software OpenGL ES: with the previous code the renders in
a caller's state with sampler objects bound gave other bytes in 12 of 12 and
left 192 probed state values changed, layers of the wrong depth were drawn,
and the packer and copier were made without their sampler or vertex array;
with this one all of that holds, and the drawings of the FEL test stream are
byte-identical to before.
---
 tools/dvbridge/dvbridge_gl_pack.c             | 40 ++++++---
 tools/dvbridge/dvbridge_render.c              | 85 +++++++++++++------
 tools/dvbridge/dvbridge_render.h              |  7 +-
 .../VideoRenderers/DVBridgeGLES.cpp           | 10 +++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  2 +-
 5 files changed, 103 insertions(+), 41 deletions(-)

diff --git a/tools/dvbridge/dvbridge_gl_pack.c b/tools/dvbridge/dvbridge_gl_pack.c
index 3d87cb4..f3bdce9 100644
--- a/tools/dvbridge/dvbridge_gl_pack.c
+++ b/tools/dvbridge/dvbridge_gl_pack.c
@@ -29,6 +29,28 @@ static GLuint compile(GLenum type, const char *source)
     return shader;
 }
 
+/* Hades: the vertex array and the exact sampler that a pass draws with. Made with the errors of
+ * earlier GL work cleared (bounded), and checked: an object that was not made (a name of 0, or an
+ * error raised) is not used, and the packer or copier is not made either, instead of drawing later
+ * with the default vertex array or with the filtering of the texture. */
+static bool make_objects(GLuint *vao, GLuint *sampler)
+{
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    glGenVertexArrays(1, vao);
+    glGenSamplers(1, sampler);
+    if (*sampler) {
+        glSamplerParameteri(*sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glSamplerParameteri(*sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glSamplerParameteri(*sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glSamplerParameteri(*sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    const bool made = glGetError() == GL_NO_ERROR && *vao && *sampler;
+    if (!made)
+        fprintf(stderr, "DV transport: vertex array %u or sampler %u not made\n", *vao, *sampler);
+    return made;
+}
+
 struct dvbridge_gl_packer *dvbridge_gl_packer_create(const char *vertex, const char *fragment)
 {
     GLuint vs = compile(GL_VERTEX_SHADER, vertex), fs = compile(GL_FRAGMENT_SHADER, fragment);
@@ -55,16 +77,11 @@ struct dvbridge_gl_packer *dvbridge_gl_packer_create(const char *vertex, const c
     p->words = glGetUniformLocation(p->program, "metadata_words");
     p->count = glGetUniformLocation(p->program, "packet_count");
     p->flip = glGetUniformLocation(p->program, "flip_y");
-    if (!linked || p->input < 0 || p->words < 0 || p->count < 0 || p->flip < 0) {
+    if (!linked || p->input < 0 || p->words < 0 || p->count < 0 || p->flip < 0 ||
+        !make_objects(&p->vao, &p->sampler)) {
         dvbridge_gl_packer_destroy(p);
         return NULL;
     }
-    glGenVertexArrays(1, &p->vao);
-    glGenSamplers(1, &p->sampler);
-    glSamplerParameteri(p->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
-    glSamplerParameteri(p->sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
-    glSamplerParameteri(p->sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
-    glSamplerParameteri(p->sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
     return p;
 }
 
@@ -140,16 +157,11 @@ struct dvbridge_gl_copier *dvbridge_gl_copier_create(void)
     c->flip_height = glGetUniformLocation(c->program, "flip_height");
     c->levels = glGetUniformLocation(c->program, "levels");
     c->limited = glGetUniformLocation(c->program, "limited");
-    if (!linked || c->picture < 0 || c->flip_height < 0 || c->levels < 0 || c->limited < 0) {
+    if (!linked || c->picture < 0 || c->flip_height < 0 || c->levels < 0 || c->limited < 0 ||
+        !make_objects(&c->vao, &c->sampler)) {
         dvbridge_gl_copier_destroy(c);
         return NULL;
     }
-    glGenVertexArrays(1, &c->vao);
-    glGenSamplers(1, &c->sampler);
-    glSamplerParameteri(c->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
-    glSamplerParameteri(c->sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
-    glSamplerParameteri(c->sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
-    glSamplerParameteri(c->sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
     return c;
 }
 
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b99bd29..b33fb06 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1,7 +1,9 @@
 /* SPDX-License-Identifier: GPL-3.0-or-later */
 /* Reconstruct video at full precision, then pack the HDMI transport with frame-matched metadata. */
 #include "dvbridge_render.h"
+#include "dvbridge_gl_pack.h"
 #include "dvbridge_placebo.h"
+#include <libavutil/dovi_meta.h>
 #include <libplacebo/shaders/custom.h>
 #include <libplacebo/opengl.h>
 #include <GLES3/gl31.h>
@@ -12,6 +14,8 @@
 enum {
     NOTE_L5_MASTER = 1,
     NOTE_LEVEL_SKIPPED = 2,
+    NOTE_BL_DEPTH = 4,
+    NOTE_EL_DEPTH = 8,
 };
 
 struct dvbridge_renderer {
@@ -270,6 +274,8 @@ bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_ren
     *notes = r->notes;
     notes->l5_master = r->fresh & NOTE_L5_MASTER;
     notes->level_skipped = r->fresh & NOTE_LEVEL_SKIPPED;
+    notes->bl_depth = r->fresh & NOTE_BL_DEPTH;
+    notes->el_depth = r->fresh & NOTE_EL_DEPTH;
     r->fresh = 0;
     return true;
 }
@@ -301,38 +307,67 @@ void dvbridge_renderer_destroy(struct dvbridge_renderer *r)
  * blending off. Kodi's GUI, drawn and composited after the video, relies on its own viewport,
  * scissor rectangle and scissor test: without them the GUI is not clipped, or is clipped to the
  * picture area of a letterboxed film. The render itself starts without blending, dithering, tests
- * or write masks, and the caller's state is restored after it. */
+ * or write masks, and the caller's state is restored after it.
+ * Hades: all of the state that dvbridge_gl_state keeps (program, vertex array, buffer,
+ * framebuffers, blending, the textures and samplers of the first 16 units, and the above), as for
+ * the picture that goes out as HDR10: only part of it was put back. And no sampler object stays
+ * bound on those units during the render: libplacebo sets the filtering and wrapping of a texture
+ * on the texture itself, and a sampler object that a caller left bound on a unit overrides that
+ * (one with its default filtering, which asks for mipmaps, makes the texture incomplete: it reads
+ * as black). */
 static const GLenum saved_caps[] = {GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_SCISSOR_TEST,
     GL_DITHER, GL_CULL_FACE, GL_RASTERIZER_DISCARD, GL_SAMPLE_ALPHA_TO_COVERAGE,
     GL_SAMPLE_COVERAGE};
 #define SAVED_CAPS (sizeof(saved_caps) / sizeof(*saved_caps))
 
-struct saved_gl_state {
-    GLint viewport[4], scissor[4];
-    GLboolean enabled[SAVED_CAPS], mask[4];
-};
-
-static void save_gl_state(struct saved_gl_state *s)
+static void save_gl_state(struct dvbridge_gl_state *s)
 {
-    glGetIntegerv(GL_VIEWPORT, s->viewport);
-    glGetIntegerv(GL_SCISSOR_BOX, s->scissor);
-    glGetBooleanv(GL_COLOR_WRITEMASK, s->mask);
-    for (unsigned i = 0; i < SAVED_CAPS; ++i) {
-        s->enabled[i] = glIsEnabled(saved_caps[i]);
+    dvbridge_gl_state_save(s);
+    for (unsigned i = 0; i < SAVED_CAPS; ++i)
         glDisable(saved_caps[i]);
-    }
     glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    for (unsigned unit = 0; unit < DVBRIDGE_GL_STATE_UNITS; ++unit)
+        glBindSampler(unit, 0);
+}
+
+static void restore_gl_state(const struct dvbridge_gl_state *s)
+{
+    dvbridge_gl_state_restore(s);
 }
 
-static void restore_gl_state(const struct saved_gl_state *s)
+/* Hades: the colour mapping of a picture by its metadata (dvbridge_map_color()), with the bit
+ * depth of its imported layers checked against the one the metadata gives for them. The reshaping
+ * takes its pivots and coefficients in codes of that depth, and libplacebo reads the samples at the
+ * depth of the planes: where they differ, the picture would be reconstructed from samples of
+ * another scale. A base layer of another depth refuses the frame. An enhancement layer of another
+ * depth, whose residual would be added, is left out as one that is missing is: the residual is
+ * omitted (and counted), instead of added at the wrong scale. Each is noted once in a stream.
+ * *paired: in, the enhancement layer is the picture's own; out, it is used. */
+static bool map_layers(struct dvbridge_renderer *r, struct dvbridge_color *mapped,
+                       const struct pl_frame *source, const void *metadata, size_t bytes,
+                       bool *paired)
 {
-    glViewport(s->viewport[0], s->viewport[1], s->viewport[2], s->viewport[3]);
-    glScissor(s->scissor[0], s->scissor[1], s->scissor[2], s->scissor[3]);
-    glColorMask(s->mask[0], s->mask[1], s->mask[2], s->mask[3]);
-    for (unsigned i = 0; i < SAVED_CAPS; ++i) {
-        if (s->enabled[i]) glEnable(saved_caps[i]);
-        else glDisable(saved_caps[i]);
+    if (!dvbridge_map_color(mapped, metadata, bytes, *paired, &r->residual_omitted))
+        return false;
+    /* (dvbridge_map_color() has checked that the header can be read) */
+    const AVDOVIRpuDataHeader *h = av_dovi_get_header((const AVDOVIMetadata *)metadata);
+    if (source->repr.bits.color_depth != h->bl_bit_depth) {
+        if (note(r, NOTE_BL_DEPTH)) {
+            r->notes.bl_bits = source->repr.bits.color_depth;
+            r->notes.rpu_bl_bits = h->bl_bit_depth;
+        }
+        return false;
     }
+    const struct pl_frame *el = source->enhancement_layer;
+    if (*paired && mapped->dovi.nlq_active && el->repr.bits.color_depth != h->el_bit_depth) {
+        if (note(r, NOTE_EL_DEPTH)) {
+            r->notes.el_bits = el->repr.bits.color_depth;
+            r->notes.rpu_el_bits = h->el_bit_depth;
+        }
+        *paired = false;
+        return dvbridge_map_color(mapped, metadata, bytes, false, &r->residual_omitted);
+    }
+    return true;
 }
 
 /* Hades: the upscalers of a step-down level (dvbridge_render_set_step()). Bilinear, not libplacebo's
@@ -380,7 +415,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     }
     bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
     struct dvbridge_color mapped;
-    if (!dvbridge_map_color(&mapped, metadata, bytes, paired, &r->residual_omitted))
+    if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
     /* The composition is settled: the residual is reconstructed, or deliberately omitted
      * while the decoder resynchronizes the enhancement layer (counted by the caller). */
@@ -513,7 +548,7 @@ bool dvbridge_render_rgb(struct dvbridge_renderer *r, const struct pl_frame *sou
      * dvbridge_render_packed(): the first GL object that libplacebo makes fails on one. */
     for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
         ;
-    struct saved_gl_state state;
+    struct dvbridge_gl_state state;
     save_gl_state(&state);
     bool ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, NULL, false);
     restore_gl_state(&state);
@@ -541,7 +576,7 @@ bool dvbridge_render_packed(struct dvbridge_renderer *r, const struct pl_frame *
     // after rendering sees only what this pass raised (bounded: one flag per error kind).
     for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
         ;
-    struct saved_gl_state state;
+    struct dvbridge_gl_state state;
     save_gl_state(&state);
     bool ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, target, flip);
     ok = glGetError() == GL_NO_ERROR && ok;
@@ -596,7 +631,7 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     bool paired = el && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
     struct dvbridge_color mapped;
-    if (!dvbridge_map_color(&mapped, metadata, bytes, paired, &r->residual_omitted))
+    if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
     /* The format of the picture that the transport is packed from. A half-float one would be half
      * the memory, and it is not as good: stored in one by a software renderer, the picture came
@@ -660,7 +695,7 @@ bool dvbridge_render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *s
     /* errors left by earlier, unrelated GL work are not ours, as in dvbridge_render_rgb() */
     for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
         ;
-    struct saved_gl_state state;
+    struct dvbridge_gl_state state;
     save_gl_state(&state);
     r->hdr10_ready = render_hdr10(r, source, metadata, bytes, pts, el_pts, view, width, height);
     restore_gl_state(&state);
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 34ab66b..aa8c6a5 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -23,10 +23,15 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *renderer);
  * (dvbridge_set_frame_period()); 0 when not known */
 void dvbridge_render_set_frame_period(struct dvbridge_renderer *renderer, double period);
 /* Hades: what the renderer noticed of a stream, once each between two resets. */
+#define DVBRIDGE_RENDER_DEPTH_NOTES 1
 struct dvbridge_render_notes {
     bool l5_master;     /* level 5 offsets read as those of a 3840x2160 master (reading) */
     bool level_skipped; /* extension blocks of reserved levels left out (reading) */
-    struct dvbridge_reading reading; /* of the frame that brought them */
+    bool bl_depth;      /* a frame refused: its base layer is not of the depth of its RPU */
+    bool el_depth;      /* an enhancement layer not used: not of the depth of its RPU */
+    unsigned bl_bits, rpu_bl_bits;   /* for bl_depth: of the layer, and of the RPU */
+    unsigned el_bits, rpu_el_bits;   /* for el_depth */
+    struct dvbridge_reading reading; /* of the frame that brought the first two */
 };
 /* false when there is nothing new since the last call */
 bool dvbridge_render_take_notes(struct dvbridge_renderer *renderer, struct dvbridge_render_notes *notes);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index f9d0307..486fbeb 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -461,6 +461,16 @@ void CDVBridgeGLES::LogNotes()
               "metadata sent to the display, which ignores them ({} in a frame, the first of level "
               "{})",
               r.skipped, r.skipped_level);
+  if (notes.bl_depth)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the base layer is decoded to {} bits and its RPU is for {}: such frames are "
+              "not reconstructed (they would be, from samples of another scale)",
+              notes.bl_bits, notes.rpu_bl_bits);
+  if (notes.el_depth)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the enhancement layer is decoded to {} bits and its RPU is for {}: its "
+              "residual is omitted (as when the layer is missing), not added at another scale",
+              notes.el_bits, notes.rpu_el_bits);
 }
 
 unsigned int CDVBridgeGLES::GetPQTexture() const
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index d68db43..bfcfa57 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -152,7 +152,7 @@ private:
   bool Fail(const char* stage);
   void LogEarlyMask(bool packed);
   //! Hades: what the renderer noticed of the stream (its level 5 offsets read as those of a
-  //! master, reserved levels left out), once each
+  //! master, reserved levels left out, layers of another bit depth than their RPU), once each
   void LogNotes();
   //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
   //! \param before what runs next, for the log
