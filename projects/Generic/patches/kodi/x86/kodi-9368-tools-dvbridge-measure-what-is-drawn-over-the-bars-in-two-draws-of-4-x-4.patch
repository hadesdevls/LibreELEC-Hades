From b22b479a1582be04e7e9678fdc03915f4d07d23e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:48:20 +0000
Subject: [PATCH] tools/dvbridge: measure what is drawn over the bars in two
 draws of 4 x 4

The measurement of the edges drawn over (pass 5, the way that waits) had
one fragment for each block of 16 x 16 pixels, which read the pixels of
the bars in its block one after the other. Where the GUI spans the bars
(an OSD, the dimmed background of a window) that is a few thousand
fragments of 256 reads each, waiting for each read in turn: on the
integrated Radeon of a test PC (through Direct3D 12) a frame with an OSD
took 31.0 ms the way that waits and 21.6 ms a frame ahead, which does not
measure, and a window over a dimmed screen 49.6 and 38.5.

Now it is two draws that each take 4 x 4 of what they read for a fragment,
as the tiles of the GUI are found (pass 6): the pixels of the bars in each
4 x 4 of the raster (none read in a 4 x 4 inside the active picture, or
outside the tiles that what is drawn over may reach), and from those the
blocks, which are read back as before. Each pixel of the bars is still
read once, and the edges are the same.

Measured with cover_test.c:
- the edges, against those counted on the CPU from the picture read back,
  in 9 sets of margins (2.39:1, pillarbox, windowbox, odd ones, one row or
  column, at the boundaries of the blocks) with each drawing and single
  pixels at either side of each edge: 268 cases, all the same;
- seven mutations each make it fail (the last row of a 4 x 4 not read,
  the column of the right edge not counted, two rows of the second draw
  not read, a 4 x 4 across the top edge taken as inside, an alpha near 2
  taken as 2, two edges swapped, half the blocks not read back), and so
  does the measurement over every tile with the picture made where the GUI
  reaches;
- the frames of a profile 7 FEL stream with each drawing over them: the
  same bytes and level 5 blocks as 1.0 RC2; with the picture made where
  the GUI reaches, the bytes it has as before;
- the measurement alone (the read back of the blocks included, medians of
  5) on the integrated Radeon through Direct3D 12: with nothing, an OSD
  strip or a dimmed background over the bars of a 2.39:1 picture, 8.3,
  13.7 and 19.6 ms with the points of 1.0 RC2, 5.6, 5.3 and 5.5 now; on
  the RTX 4080 SUPER 0.9, 5.0 and 9.0, and 0.8, 0.7 and 0.7;
- the time of a frame with GUI elements over the video (guitime, medians of
  9, nothing read back), the way that waits / a frame ahead, the commit
  before and now, on the integrated Radeon: an OSD 31.0/21.6 and
  28.5/21.6 ms, a window over a dimmed screen 49.6/38.5 and 46.9/39.5;
  two lines of subtitles, the seek bar and an empty GUI 16.9 to 18.2 /
  16.1 to 16.5 either way (the frame drawn directly: 13.4); on the RTX
  4080 SUPER 1.4 to 2.7 / 1.1 to 2.0 (directly: 1.0). What is left between
  the two ways on the Radeon (about 7 ms with an OSD) was not taken
  apart; the read back through WSL is in it.

Not verified: the times with the drivers that LibreELEC runs.
---
 tools/dvbridge/dvbridge_source.c | 89 +++++++++++++++++++++-----------
 1 file changed, 60 insertions(+), 29 deletions(-)

diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 3f241af..99aacc4 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -472,12 +472,12 @@ static const char PACK[] =
     "}\n";
 
 /* 5. The edges drawn over (dvbridge_source_cover()): the raster in blocks of COVER_BLOCK x COVER_BLOCK
- * pixels, one fragment for each, which reads the pixels of the bars in its block (those outside the
- * active picture) and writes, as the colour of its texel, the edges that the pixels drawn over (alpha
- * not 2) among them lie beyond; read back, the texels together give the edges of all. A pixel lies
- * beyond the left edge where x < x0, the right where x >= x1, the top where y < y0 and the bottom
- * where y >= y1 (a pixel in a corner lies beyond two). Each pixel of the bars is read once, by the
- * fragment of its block, and the blocks are read side by side.
+ * pixels, a texel for each, which holds as its colour the edges that the pixels of the bars in its block
+ * (those outside the active picture) that are drawn over (alpha not 2) lie beyond; read back, the texels
+ * together give the edges of all. A pixel lies beyond the left edge where x < x0, the right where
+ * x >= x1, the top where y < y0 and the bottom where y >= y1 (a pixel in a corner lies beyond two).
+ * Each pixel of the bars is read once (Hades: by the fragment of its 4 x 4, below), and the blocks are
+ * read side by side.
  * Hades: it was one point for each pixel of the bars, which landed on the single pixel of a 1x1 target
  * where it was drawn over, blended by their maximum. A GPU blends the fragments that land on one pixel
  * one after the other: under a GUI that covers the bars of a 2.39:1 film (its dimmed background, an
@@ -485,11 +485,19 @@ static const char PACK[] =
  * refresh on a Radeon RX 7600 (issue 3), and made the frames that are not presented a frame ahead late:
  * the GPU time that called for that, and those frames, measured nothing. The edges are the same. */
 /* Hades: the blocks are the tiles of what is drawn over (DRAWN_TILE): where those are known, a block
- * outside them has nothing drawn over it */
+ * outside them has nothing drawn over it.
+ * Hades: in two draws that each take 4 x 4 of what they read for a fragment, as pass 6: the pixels of
+ * the bars in each 4 x 4 of the raster (a 4 x 4 inside the active picture, or outside the tiles that
+ * what is drawn over may reach, reads none), and from those the blocks, which are read back. One
+ * fragment for each block, reading its 256 pixels one after the other, took 9 to 11 ms on an integrated
+ * Radeon where the GUI spans the bars (an OSD, a dimmed background): a few thousand fragments, each
+ * waiting for its reads in turn. */
 #define COVER_BLOCK DRAWN_TILE
 #define COVER_COLUMNS DRAWN_COLUMNS
 #define COVER_ROWS DRAWN_ROWS
 #define COVER_STRING(x) DRAWN_STRING(x)
+_Static_assert(COVER_BLOCK == 16 && 3840 % COVER_BLOCK == 0 && 2160 % COVER_BLOCK == 0,
+               "pass 5 takes 4 x 4 twice, of the whole raster");
 static const char COVER[] =
     "#version 300 es\n"
     "precision highp float;\n"
@@ -501,26 +509,35 @@ static const char COVER[] =
     "out vec4 color;\n"
     "void main()\n"
     "{\n"
-    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * " COVER_STRING(COVER_BLOCK) ";\n"
-    "    ivec2 b1 = min(b0 + " COVER_STRING(COVER_BLOCK) ", ivec2(3840, 2160));\n"
+    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * 4;\n"
     "    vec4 edges = vec4(0.0);\n"
-    "    if (tiles_mode != 0 && texelFetch(drawn_tiles, ivec2(gl_FragCoord.xy), 0).r < 0.5)\n"
-    "        b1.y = b0.y;\n"
-    "    for (int y = b0.y; y < b1.y; ++y) {\n"
-    /* a row of the bars: the block's columns; a row of the active picture: those left of it and those
-     * right of it */
-    "        bool bars = y < active_rect.y || y >= active_rect.w;\n"
-    "        int left_end = bars ? b1.x : min(b1.x, active_rect.x);\n"
-    "        int right_start = bars ? b1.x : max(b0.x, active_rect.z);\n"
-    "        for (int x = b0.x; x < left_end; ++x)\n"
-    "            if (texelFetch(drawn, ivec2(x, y), 0).a != 2.0)\n"
-    "                edges = max(edges, vec4(x < active_rect.x, x >= active_rect.z, y < active_rect.y,\n"
-    "                                        y >= active_rect.w));\n"
-    "        for (int x = right_start; x < b1.x; ++x)\n"
-    "            if (texelFetch(drawn, ivec2(x, y), 0).a != 2.0)\n"
-    "                edges = max(edges, vec4(x < active_rect.x, x >= active_rect.z, y < active_rect.y,\n"
-    "                                        y >= active_rect.w));\n"
-    "    }\n"
+    "    bool inside = b0.x >= active_rect.x && b0.x + 4 <= active_rect.z && b0.y >= active_rect.y &&\n"
+    "                  b0.y + 4 <= active_rect.w;\n"
+    "    bool none = tiles_mode != 0 && texelFetch(drawn_tiles, b0 / " COVER_STRING(COVER_BLOCK) ", 0).r < 0.5;\n"
+    "    if (!inside && !none)\n"
+    "        for (int y = b0.y; y < b0.y + 4; ++y)\n"
+    "            for (int x = b0.x; x < b0.x + 4; ++x)\n"
+    /* a pixel of the bars: beyond an edge of the active picture */
+    "                if ((x < active_rect.x || x >= active_rect.z || y < active_rect.y || y >= active_rect.w) &&\n"
+    "                    texelFetch(drawn, ivec2(x, y), 0).a != 2.0)\n"
+    "                    edges = max(edges, vec4(x < active_rect.x, x >= active_rect.z, y < active_rect.y,\n"
+    "                                            y >= active_rect.w));\n"
+    "    color = edges;\n"
+    "}\n";
+/* ... and the blocks, from the 4 x 4 of the draw before */
+static const char COVER_BLOCKS[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D quads;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * 4;\n"
+    "    vec4 edges = vec4(0.0);\n"
+    "    for (int y = 0; y < 4; ++y)\n"
+    "        for (int x = 0; x < 4; ++x)\n"
+    "            edges = max(edges, texelFetch(quads, b0 + ivec2(x, y), 0));\n"
     "    color = edges;\n"
     "}\n";
 
@@ -606,6 +623,10 @@ struct dvbridge_source_packer {
     GLuint pack, picture, resite, rows, cover, vao, sampler;
     struct texture resited, chroma, edges;
     GLint cover_drawn, cover_active;
+    /* Hades: the second draw of pass 5, and what the first leaves it */
+    GLuint cover_blocks;
+    GLint cover_quads;
+    struct texture cover_quarter;
     /* Hades: the texels of the edges that dvbridge_source_cover() reads back */
     uint8_t cover_read[COVER_COLUMNS * COVER_ROWS * 4];
     /* Hades: what is drawn over (passes 6 and 7: dvbridge_source_drawn()). gui: the texture that the
@@ -716,6 +737,8 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     p->cover = link(COVER);
     p->cover_drawn = p->cover ? glGetUniformLocation(p->cover, "drawn") : -1;
     p->cover_active = p->cover ? glGetUniformLocation(p->cover, "active_rect") : -1;
+    p->cover_blocks = link(COVER_BLOCKS);
+    p->cover_quads = p->cover_blocks ? glGetUniformLocation(p->cover_blocks, "quads") : -1;
     /* Hades: passes 6 and 7, and how 3, 4 and 5 take their tiles */
     p->gui_tiles_program = link(GUI_TILES);
     p->drawn_program = link(DRAWN);
@@ -740,7 +763,7 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     p->drawn_usable = p->gt_gui >= 0 && p->gt_size >= 0 && p->gt_alpha >= 0 && p->dr_tiles >= 0 &&
                       p->dr_size >= 0;
     if (!p->pack || !p->picture || !p->resite || !p->rows || !p->cover || p->cover_drawn < 0 ||
-        p->cover_active < 0 || !found ||
+        p->cover_active < 0 || !p->cover_blocks || p->cover_quads < 0 || !found ||
         !locate(p->pack, &p->pc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
         !locate(p->picture, &p->cc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
         !locate(p->pack, &p->u.drawn, pack, COUNT(pack)) ||
@@ -774,6 +797,7 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     texture_destroy(&p->resited);
     texture_destroy(&p->chroma);
     texture_destroy(&p->edges);
+    texture_destroy(&p->cover_quarter);
     texture_destroy(&p->gui_quarter);
     texture_destroy(&p->gui_tiles);
     texture_destroy(&p->tiles);
@@ -784,6 +808,7 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     glDeleteProgram(p->resite);
     glDeleteProgram(p->rows);
     glDeleteProgram(p->cover);
+    glDeleteProgram(p->cover_blocks);
     glDeleteProgram(p->gui_tiles_program);
     glDeleteProgram(p->drawn_program);
     free(p);
@@ -1169,15 +1194,21 @@ bool dvbridge_source_cover(struct dvbridge_source_packer *p, unsigned layer,
     glGetIntegerv(GL_PACK_SKIP_ROWS, &skip_rows);
     glGetIntegerv(GL_PACK_SKIP_PIXELS, &skip_pixels);
     glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
-    if (!target(&p->edges, GL_RGBA8, COVER_COLUMNS, COVER_ROWS))
+    if (!target(&p->cover_quarter, GL_RGBA8, 3840 / 4, 2160 / 4))
         return end(&state, false);
-    /* every texel is written: nothing to clear, nothing blended */
+    /* every texel is written, in both draws: nothing to clear, nothing blended */
     glUseProgram(p->cover);
     bind(p, 0, layer);
     glUniform1i(p->cover_drawn, 0);
     glUniform4i(p->cover_active, x0, y0, x1, y1);
     set_tiles(p, p->cv_tiles, p->cv_mode, p->tiles_mode);
     glDrawArrays(GL_TRIANGLES, 0, 3);
+    if (!target(&p->edges, GL_RGBA8, COVER_COLUMNS, COVER_ROWS))
+        return end(&state, false);
+    glUseProgram(p->cover_blocks);
+    bind(p, 0, p->cover_quarter.texture);
+    glUniform1i(p->cover_quads, 0);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
     glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
     glPixelStorei(GL_PACK_ALIGNMENT, 1);
     glPixelStorei(GL_PACK_ROW_LENGTH, 0);
-- 
2.53.0

