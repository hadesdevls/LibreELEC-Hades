+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: HDMI VRR left off in the mode set of an HDR10+ video on Turing and Ampere
+ *        (NV_HDMI_VRR_OFF of nvidia-drm, nvidia-open-kernel-modules-9051)
+ *
+ * On Turing and Ampere the SOR of a head has one slot for an InfoFrame of a client next to the
+ * HDR one: the generic InfoFrame slot, where HDR10+ goes (nvidia-open-kernel-modules-9020). NVKMS
+ * turns HDMI VRR on in every mode set of a display that declares it, from 50 Hz and 720 lines up,
+ * and then sends the EMP of HDMI VRR in that slot with every frame, whether flips use VRR or not:
+ * HDR10+ is refused there (Ada sends it in a shared generic slot then; Blackwell has slots of its
+ * own). Kodi never flips with VRR. nvidia-drm gives these connectors NV_HDMI_VRR_OFF (only where
+ * it frees the slot for HDR10+: Turing and Ampere, not GA10x where RM keeps the slot for its ACR
+ * workaround): with 1, the mode set asks NVKMS for no Adaptive-Sync, so no EMP goes out and HDR10+
+ * has the slot. A change of it needs a mode set.
+ *
+ * Kodi sets it only in the mode set that the video makes anyway: the commit that the hold of the
+ * change of mode of the video releases (CHDR10PlusOutput::WithMode()), and only where it is what
+ * stands between the video and HDR10+ (Wanted()): never a change of mode for it. Any other mode set
+ * puts it back to 0 (Stage()), the GUI's after the video among them: until then it stays as it was,
+ * which changes nothing that Kodi uses (the display does not get the EMP of VRR). A test of the
+ * request that fails with it is made again without it and without the HDR10+ payload (Without()):
+ * the video then goes out as it would without this, as HDR10, and the log says so.
+ */
+class CHdmiVrrOff
+{
+public:
+  static constexpr const char* PROPERTY = "NV_HDMI_VRR_OFF";
+
+  /*!
+   * \brief Whether the mode set of a video asks for HDMI VRR off: the connector has the property;
+   *        the request is the commit of the mode of the video (withMode); the video sends HDR10+
+   *        (hdr10Plus: a payload that goes out to the display, or Dolby Vision sent as HDR10+ that
+   *        will have one); the display declares HDMI VRR; and the mode is one NVKMS would turn HDMI
+   *        VRR on in (nvGetAllowedDpyVrrType(): vVisible 720 or more, RRx1k 50000 or more)
+   */
+  static bool Wanted(bool property,
+                     bool withMode,
+                     bool hdr10Plus,
+                     bool displayVrr,
+                     int vdisplay,
+                     int64_t refreshMilliHz)
+  {
+    return property && withMode && hdr10Plus && displayVrr && vdisplay >= 720 &&
+           refreshMilliHz >= 50000;
+  }
+
+  /*!
+   * \brief The refresh of a mode as NVKMS's RRx1k has it, which nvidia-drm gives KAPI as
+   *        drm_mode_vrefresh() times 1000 (nv_drm_mode_to_nvkms_display_mode()): the refresh in Hz,
+   *        rounded to the nearest, in mHz (59.94 Hz is 60000, 49.95 Hz 50000); 0 for a mode that
+   *        gives none
+   */
+  static int64_t RefreshMilliHz(uint32_t clockKHz, uint32_t htotal, uint32_t vtotal)
+  {
+    if (!clockKHz || !htotal || !vtotal)
+      return 0;
+    const uint64_t frame = static_cast<uint64_t>(htotal) * vtotal;
+    return static_cast<int64_t>((static_cast<uint64_t>(clockKHz) * 1000 + frame / 2) / frame) * 1000;
+  }
+
+  /*!
+   * \brief The value to put in a request for the property (nothing: leave it as the kernel has it):
+   *        only in a request with a mode set (a change of it needs one), and only where it differs
+   *        from the kernel's (kernel: nothing without the property)
+   */
+  static std::optional<uint64_t> Stage(bool modesetPending,
+                                       bool wanted,
+                                       std::optional<uint64_t> kernel)
+  {
+    if (!modesetPending || !kernel)
+      return std::nullopt;
+    const uint64_t want = wanted ? 1 : 0;
+    if (*kernel == want)
+      return std::nullopt;
+    return want;
+  }
+
+  /*!
+   * \brief A test of a request failed whose value is inRequest: the value to test it again with,
+   *        0 (the request asked for VRR off only where the kernel had 0: Stage()), or nothing
+   *        where it does not ask for VRR off
+   */
+  static std::optional<uint64_t> Without(std::optional<uint64_t> inRequest)
+  {
+    if (!inRequest || *inRequest == 0)
+      return std::nullopt;
+    return 0;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 7738d88..7be36ae 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -41,6 +41,7 @@
 #include "guilib/WindowIDs.h"
 #include "utils/HDR10PlusVsif.h"
 #include "windowing/gbm/DVPlusModeStart.h"
+#include "windowing/gbm/HdmiVrrOff.h"
 #include "messaging/ApplicationMessenger.h"
 #include "messaging/helpers/DialogHelper.h"
 #include "resources/LocalizeStrings.h"
@@ -2744,9 +2745,12 @@ void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
     bo = m_GBM->GetDevice().GetSurface().LockFrontBuffer().Get();
   }
 
+  // Hades: HDMI VRR left off, or allowed again, in a commit with a mode set (CHdmiVrrOff)
+  StageHdmiVrrOff();
   m_DRM->FlipPage(bo, rendered, videoLayer, async);
   // Hades: whether the driver took the HDR10+ metadata that the request carried
   HDR10PlusCommitted();
+  HdmiVrrOffCommitted();
   // ... and the commit that a hold of the change of mode released, if any, went out
   m_hdr10Plus.HeldModeCommitted();
 
@@ -3406,6 +3410,51 @@ enum HDR10PlusTold : unsigned int
 };
 } // namespace
 
+void CWinSystemGbm::StageHdmiVrrOff()
+{
+  m_hdmiVrrOffStaged.reset();
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty(CHdmiVrrOff::PROPERTY))
+  {
+    m_hdmiVrrOffWanted = false;
+    return;
+  }
+  const auto value = CHdmiVrrOff::Stage(drm->ModesetPending(), m_hdmiVrrOffWanted,
+                                        connector->GetPropertyValue(CHdmiVrrOff::PROPERTY));
+  if (value && drm->AddProperty(connector, CHdmiVrrOff::PROPERTY, *value))
+    m_hdmiVrrOffStaged = value;
+}
+
+void CWinSystemGbm::HdmiVrrOffCommitted()
+{
+  const bool wanted = std::exchange(m_hdmiVrrOffWanted, false);
+  const auto staged = std::exchange(m_hdmiVrrOffStaged, std::nullopt);
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!staged || !connector)
+    return;
+  const auto kernel = connector->GetPropertyValue(CHdmiVrrOff::PROPERTY);
+  const auto* mode = m_DRM->GetSelectedMode();
+  const double refresh = mode && mode->htotal && mode->vtotal
+                             ? mode->clock * 1000.0 / (mode->htotal * mode->vtotal)
+                             : 0;
+  if (*staged == 1 && kernel == 1u)
+    CLog::Log(LOGINFO,
+              "HDR10+: HDMI VRR is left off in the mode set of this video ({}x{} at {:.3f} Hz, "
+              "{} 1), so that HDR10+ has the InfoFrame slot that the EMP of HDMI VRR would take; "
+              "Kodi does not flip with VRR, and the next mode set allows it again",
+              mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0, refresh, CHdmiVrrOff::PROPERTY);
+  else if (*staged == 1)
+    CLog::Log(LOGWARNING,
+              "HDR10+: the driver refused HDMI VRR off in the mode set of this video ({} 1, at "
+              "{:.3f} Hz): the video goes out as without it, as HDR10 at this rate ({})",
+              CHdmiVrrOff::PROPERTY, refresh,
+              wanted ? "the commit fell back" : "the request changed meanwhile");
+  else if (kernel == 0u)
+    CLog::Log(LOGINFO, "HDR10+: HDMI VRR is allowed again with this mode set ({} 0)",
+              CHdmiVrrOff::PROPERTY);
+}
+
 bool CWinSystemGbm::HDR10PlusWithModeNow() const
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
@@ -3478,6 +3527,24 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
   output.withMode = m_hdr10Plus.WithMode(drm->ModesetPending(),
                                          drm->RequestValue(connector, "HDR_OUTPUT_METADATA"));
 
+  // Hades: HDMI VRR left off in that commit where its EMP would take the slot of HDR10+ (Turing
+  // and Ampere: CHdmiVrrOff), for a video that sends HDR10+ to this display
+  if (output.withMode && connector->SupportsProperty(CHdmiVrrOff::PROPERTY))
+  {
+    const auto* mode = drm->GetSelectedMode();
+    const bool sends =
+        output.pq && output.display && output.driver &&
+        (payload ? CHDR10PlusOutput::VersionFits(*payload, output.receiverVersion)
+                 : HDR10PlusExpected());
+    m_hdmiVrrOffWanted =
+        m_hdmiVrrOffWanted ||
+        CHdmiVrrOff::Wanted(true, true, sends, info && info->SupportsHdmiVrr(),
+                            mode ? mode->vdisplay : 0,
+                            mode ? CHdmiVrrOff::RefreshMilliHz(mode->clock, mode->htotal,
+                                                               mode->vtotal)
+                                 : 0);
+  }
+
   if (payload && output.pq && output.display && !output.driver &&
       !(m_hdr10PlusTold & TOLD_NO_DRIVER))
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index b5054b3..380b33e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -307,6 +307,16 @@ protected:
   //! Hades: the request of this frame is the commit of the mode of the video, with its HDR
   //! signalling: an HDR10+ payload goes with it (CHDR10PlusOutput::WithMode())
   bool HDR10PlusWithModeNow() const;
+  //! Hades: the video of the frames that SetHDR10Plus() is given will send HDR10+ although the
+  //! frame has no payload yet (Dolby Vision sent as HDR10+, measured once drawn)
+  virtual bool HDR10PlusExpected() const { return false; }
+  //! Hades: HDMI VRR left off in the mode set of an HDR10+ video (CHdmiVrrOff): asked for by
+  //! SetHDR10Plus() for the commit of the mode of the video, staged in each commit with a mode set
+  //! (StageHdmiVrrOff()), and what came of it said after the commit (HdmiVrrOffCommitted())
+  bool m_hdmiVrrOffWanted = false;
+  std::optional<uint64_t> m_hdmiVrrOffStaged;
+  void StageHdmiVrrOff();
+  void HdmiVrrOffCommitted();
   //! \brief Hades: native Dolby Vision output has the output. Its transport is no picture
   //! that the display could take as two eyes: no 3D output is chosen meanwhile.
   virtual bool NativeDVOutputInUse() const { return false; }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index a415923..7e371a2 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -307,6 +307,9 @@ protected:
 #ifdef HAVE_DVBRIDGE
   int VideoOutputBitDepth(const VideoPicture* picture) const override;
   bool NativeDVOutputInUse() const override { return m_dvState.Captured(); }
+  //! Hades: Dolby Vision sent as HDR10+ is on for the video (its first payload comes once its first
+  //! picture is measured: CHdmiVrrOff wants to know in the commit of the mode)
+  bool HDR10PlusExpected() const override { return m_dvPlusOn == 1; }
 #endif
   //! Hades: ... and what is left of native Dolby Vision (its end that waits for a change of mode,
   //! a move of it into a mode, a hand-over), a change of mode that a video that opens has told
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 8130e24..a066ba6 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -11,6 +11,7 @@
 #include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
 #include "windowing/gbm/HDR10PlusOutput.h"
+#include "windowing/gbm/HdmiVrrOff.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
@@ -309,16 +310,28 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     m_dvFrameIoctls.untested++;
   // Hades: an HDR10+ InfoFrame that the driver refuses takes nothing else of the request with it:
   // the request is tested again without it (CHDR10PlusOutput::Without())
+  // (and HDMI VRR left off for it, CHdmiVrrOff: both go, so that the request is what it would be
+  // without them)
   if (ret < 0 && !strict && m_connector)
   {
     const int error = errno;
     const auto without =
         CHDR10PlusOutput::Without(m_req->Value(m_connector, CHDR10PlusOutput::PROPERTY));
+    const auto withoutVrrOff =
+        CHdmiVrrOff::Without(m_req->Value(m_connector, CHdmiVrrOff::PROPERTY));
+    bool again = false;
     if (without && m_req->AddProperty(m_connector, CHDR10PlusOutput::PROPERTY, *without))
     {
       m_hdr10PlusTestError = error;
-      CLog::LogF(LOGDEBUG, "test commit failed: ({}) - testing it again without {}",
-                 strerror(error), CHDR10PlusOutput::PROPERTY);
+      again = true;
+    }
+    if (withoutVrrOff && m_req->AddProperty(m_connector, CHdmiVrrOff::PROPERTY, *withoutVrrOff))
+      again = true;
+    if (again)
+    {
+      CLog::LogF(LOGDEBUG, "test commit failed: ({}) - testing it again without {}{}",
+                 strerror(error), without ? CHDR10PlusOutput::PROPERTY : "",
+                 withoutVrrOff ? (without ? " and HDMI VRR off" : "HDMI VRR off") : "");
       ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
     }
   }
