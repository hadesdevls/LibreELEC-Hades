-        nlq.linear_deadzone_slope != 0 || nlq.linear_deadzone_threshold != 0)
-      return true;
-  return false;
-}
+// Consecutive pictures with Dolby Vision metadata after which a stream that left native output
+// because the metadata was missing returns to it (2 s at 24 fps).
+constexpr unsigned int DV_RPU_BACK = 48;
 } // namespace
 
-void CDVDVideoCodecFFmpeg::AbandonDVEnhancement(const char* reason)
+void CDVDVideoCodecFFmpeg::ResyncDVEnhancement(const char* reason)
 {
-  // Never pair a base picture with a wrong enhancement surface and never stop the video: the
-  // base layer continues. CheckNativeDVPicture() sends the stream to the ordinary output at its
-  // first picture that needs the enhancement layer (FEL); MEL pictures stay in Dolby Vision.
-  CLog::Log(LOGWARNING,
-            "DV FEL: giving up the enhancement layer for this stream ({}); the base layer "
-            "continues, {} queued pictures",
-            reason, m_dvPending.size());
-  m_dvFel.reset();
+  // The enhancement layer is never given up: it starts again at the next random-access point
+  // common to both layers, as after a seek, for as long as the stream plays. Until then the base
+  // pictures go out without it (dvbridge draws them without the FEL residual and counts them),
+  // and a base picture is never paired with a neighbouring enhancement surface.
+  ++m_dvResyncs;
+  if (m_dvResyncs <= 5 || m_dvResyncs % 100 == 0)
+    CLog::Log(LOGWARNING, "DV FEL: resynchronizing the enhancement layer ({}); resync {}",
+              reason, m_dvResyncs);
+  dvbridge_fel_reset(m_dvFel.get());
   m_dvFailed = false;
-  m_dvPrerollDropped = 0;
 }
 
