-/* Output owns its mapping; do not copy it without rebinding repr.dovi. */
+/* Output owns its mapping; do not copy it without rebinding repr.dovi.
+ * A FEL picture (NLQ active) without its paired enhancement layer is refused, unless
+ * residual_omitted is given (Hades): it is then mapped with the base-layer reshaping alone and
+ * *residual_omitted is set, for a caller that counts such pictures while the decoder
+ * resynchronizes the layer. */
 bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
-                       size_t bytes, bool enhancement_layer_paired);
+                       size_t bytes, bool enhancement_layer_paired, bool *residual_omitted);
 #endif
