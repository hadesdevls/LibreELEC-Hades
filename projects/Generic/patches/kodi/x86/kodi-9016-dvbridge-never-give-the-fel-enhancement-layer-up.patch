diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index c5c0e58..ccc0e88 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -10,10 +10,6 @@
 #define QUEUE_MAX 32
 #define PACKET_BYTES_MAX (64u * 1024u * 1024u)
 #define MAP_MAX (QUEUE_MAX * 2)
-/* Hades: enhancement packets discarded while waiting for a common random-access point after a
- * reset (about 5 s at 24 fps); beyond it the enhancement layer is given up for the stream. */
-#define PREROLL_PACKETS_MAX 120
-
 /* Independently coded layers can have different decode
  * order and IDR boundaries. Use FFmpeg's HEVC parser rather than assigning
  * the BL packet timestamp blindly to the encapsulated EL access unit. */
@@ -345,10 +341,8 @@ bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
             if (!common_key && !el_idr) {
                 av_packet_free(&copy);
                 f->num_times = 0;
-                if (++f->preroll_packets > PREROLL_PACKETS_MAX) {
-                    f->reason = "no common random-access point within the preroll bound";
-                    goto fail;
-                }
+                /* Hades: no bound; the base pictures meanwhile go out without the layer. */
+                ++f->preroll_packets;
                 continue;
             }
             f->enhancement_order.offset = base_identity - ep->output_picture_number;
@@ -376,11 +370,10 @@ bool dvbridge_fel_drain(struct dvbridge_fel *f)
 {
     if (!f)
         return false;
-    if (f->synchronizing) {
-        f->reason = "the stream ended before a common random-access point";
-        f->failed = true;
-        return false; /* EOF cannot supply the missing random-access picture. */
-    }
+    /* Hades: nothing of the enhancement layer to drain; the remaining base pictures go out
+     * without it (EOF cannot supply the missing random-access picture). */
+    if (f->synchronizing)
+        return true;
     f->draining = true;
     return pump(f);
 }
