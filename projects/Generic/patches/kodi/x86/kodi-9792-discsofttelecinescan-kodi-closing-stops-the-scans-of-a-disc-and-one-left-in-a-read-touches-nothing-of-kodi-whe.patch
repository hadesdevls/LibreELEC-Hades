+/*!
+ * \brief The scans of the titles of discs whose thread runs, for Kodi to stop them when it closes
+ *        (StopAllScans()), before it takes down what they read with (the clients of SMB and NFS,
+ *        the loaded libraries, the log)
+ *
+ * A scan is in one of three places: it reads, it closes what it read with (finishing), or, where
+ * Kodi gave it up in a read that did not come back in time, it is parked for good when it comes
+ * back (Park()): from then on it touches nothing of Kodi, and the process ends with it parked.
+ * Never freed, so that a parked scan touches nothing freed either.
+ */
+struct ScanRegistry
+{
+  std::mutex mutex;
+  std::condition_variable changed;
+  int running = 0; //!< scans whose thread runs and is not parked
+  int finishing = 0; //!< ... of which closing what they read with
+  std::atomic<bool> closing{false}; //!< Kodi closes: every scan stops, and none starts
+  std::atomic<bool> abandoned{false}; //!< ... and the scans left were given up
+};
+
+inline ScanRegistry& Scans()
+{
+  static ScanRegistry* scans = new ScanRegistry;
+  return *scans;
+}
+
+//! \brief Kodi closes (StopAllScans())
+inline bool Closing()
+{
+  return Scans().closing.load();
+}
+
+//! \brief (a thread of a scan) Kodi gave the scan up: it stays here, touching nothing, until the
+//!        process ends
+[[noreturn]] inline void Park()
+{
+  for (;;)
+    std::this_thread::sleep_for(std::chrono::hours(24));
+}
+
+//! \brief (a thread of a scan) where it comes back from what can block (a read, the opening of an
+//!        image): parks if Kodi gave it up meanwhile
+inline void ParkIfAbandoned()
+{
+  if (Scans().abandoned.load())
+    Park();
+}
+
+//! (a thread of a scan) it counts as finishing (BeginFinish()), until it ends (RunDetached())
+inline thread_local bool t_scanFinishing = false;
+
+//! \brief (a thread of a scan) the scan is about to close what it read with: parks if Kodi gave it
+//!        up, else counts as finishing (StopAllScans() waits a moment more for it)
+inline void BeginFinish()
+{
+  ScanRegistry& scans = Scans();
+  std::unique_lock lock(scans.mutex);
+  if (scans.abandoned)
+  {
+    lock.unlock();
+    Park();
+  }
+  if (!t_scanFinishing)
+    ++scans.finishing;
+  t_scanFinishing = true;
+}
+
+/*!
+ * \brief (Kodi, closing) every scan stops (CScanResults::Stopped()) and none starts; the ones that
+ *        run are waited for up to \a wait, and those closing what they read with then up to
+ *        \a finishing more. Those still left are in a read that does not come back: they are given
+ *        up and park when they come back (Park()).
+ * \return the scans left (0: all ended); where none runs, at once
+ */
+inline int StopAllScans(std::chrono::milliseconds wait, std::chrono::milliseconds finishing)
+{
+  ScanRegistry& scans = Scans();
+  std::unique_lock lock(scans.mutex);
+  scans.closing = true;
+  if (scans.running == 0)
+    return 0;
+  if (!scans.changed.wait_for(lock, wait, [&scans] { return scans.running == 0; }) &&
+      scans.finishing > 0)
+    scans.changed.wait_for(lock, finishing, [&scans] { return scans.finishing == 0; });
+  if (scans.running > 0)
+    scans.abandoned = true;
+  return scans.running;
+}
+
 /*!
  * \brief What a scan of the titles of a disc found, shared by the thread that reads them and the
  *        player's navigator that asks
@@ -257,7 +346,8 @@ public:
     std::lock_guard lock(m_mutex);
     m_changed.notify_all();
   }
-  bool Stopped() const { return m_stop.load(); }
+  //! \brief told to stop, by the owner or by Kodi closing (StopAllScans())
+  bool Stopped() const { return m_stop.load() || Closing(); }
   bool Finished() const
   {
     std::lock_guard lock(m_mutex);
@@ -299,18 +389,36 @@ private:
 
 /*!
  * \brief Runs a scan on a thread of its own that nobody joins: \a job(results) reads, looks at
- *        CScanResults::Stopped() as often as it can, and keeps what it needs; the results end
- *        finished whatever it did
+ *        CScanResults::Stopped() as often as it can, keeps what it needs, comes back from what can
+ *        block through ParkIfAbandoned() and calls BeginFinish() before it closes what it read
+ *        with; the results end finished whatever it did. The scan counts in ScanRegistry while it
+ *        runs.
+ * \return false where Kodi closes: no scan starts then
  */
 template<class Job>
-void RunDetached(std::shared_ptr<CScanResults> results, Job job)
+bool RunDetached(std::shared_ptr<CScanResults> results, Job job)
 {
+  ScanRegistry& scans = Scans();
+  {
+    std::lock_guard lock(scans.mutex);
+    if (scans.closing)
+      return false;
+    ++scans.running;
+  }
   std::thread(
       [results = std::move(results), job = std::move(job)]() mutable
       {
         job(*results);
         results->Finish();
+        ScanRegistry& registry = Scans();
+        std::lock_guard lock(registry.mutex);
+        if (t_scanFinishing)
+          --registry.finishing;
+        t_scanFinishing = false;
+        --registry.running;
+        registry.changed.notify_all();
       })
       .detach();
+  return true;
 }
 } // namespace KODI::DISC
