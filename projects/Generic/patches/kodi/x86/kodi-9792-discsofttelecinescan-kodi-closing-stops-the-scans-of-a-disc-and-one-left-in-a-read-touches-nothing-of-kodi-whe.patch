+void CDiscSoftTelecineScan::StopAll()
+{
+  // (where no scan runs, a lock and nothing else: Kodi closes as fast as it did)
+  const auto begin = std::chrono::steady_clock::now();
+  const int left =
+      KODI::DISC::StopAllScans(std::chrono::milliseconds(2000), std::chrono::milliseconds(1000));
+  if (left > 0)
+    CLog::Log(LOGWARNING,
+              "CDiscSoftTelecineScan: {} scan(s) of the titles of a disc did not stop within {} "
+              "ms, in a read of the disc that does not come back: left, and parked when it does "
+              "(nothing of Kodi is touched then)",
+              left,
+              std::chrono::duration_cast<std::chrono::milliseconds>(
+                  std::chrono::steady_clock::now() - begin)
+                  .count());
+}
