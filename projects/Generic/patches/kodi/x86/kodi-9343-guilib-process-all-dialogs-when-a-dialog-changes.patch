From 680b1b259c7fdc2a86760f96061a315b25a11b23 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sun, 11 Oct 2026 00:21:13 +0200
Subject: [PATCH] [guilib] Process all dialogs when a dialog changes

Skins make dialogs depend on each other, e.g. the seek bar and Estuary's
top bar overlay change their content when the video OSD is open. When a
dialog is dirty, only the main window was marked dirty. With smart
redraw, the other dialogs were not processed, so their visibility
conditions were not updated and parts of the OSD were missing.

Also send GUI_MSG_STATE_CHANGED to the open dialogs, which processes
them without adding a dirty region. The seek bar dialog dropped this
message, so let it through.

(cherry picked from commit 3ebe15341bc77dc0b8074a8e9b98156ecaf14626)
---
 xbmc/dialogs/GUIDialogSeekBar.cpp |  4 ++++
 xbmc/guilib/GUIWindowManager.cpp  | 19 ++++++++++++++++---
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/xbmc/dialogs/GUIDialogSeekBar.cpp b/xbmc/dialogs/GUIDialogSeekBar.cpp
index 7dc765e..735cb09 100644
--- a/xbmc/dialogs/GUIDialogSeekBar.cpp
+++ b/xbmc/dialogs/GUIDialogSeekBar.cpp
@@ -47,6 +47,10 @@ bool CGUIDialogSeekBar::OnMessage(CGUIMessage& message)
     break;
   case GUI_MSG_REFRESH_TIMER:
     return CGUIDialog::OnMessage(message);
+  case GUI_MSG_NOTIFY_ALL:
+    if (message.GetParam1() == GUI_MSG_STATE_CHANGED)
+      return CGUIDialog::OnMessage(message);
+    break;
   }
   return false; // don't process anything other than what we need!
 }
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index c73b076..0f44df4 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -1493,14 +1493,27 @@ void CGUIWindowManager::AfterRender()
 
   // make copy of vector as we may remove items from it as we go
   auto activeDialogs = m_activeDialogs;
+  bool dialogDirty = false;
   for (const auto& window : activeDialogs)
   {
     if (window->IsDialogRunning())
     {
       window->AfterRender();
-      // Dialog state can affect visibility states
-      if (pWindow && window->IsControlDirty())
-        pWindow->MarkDirtyRegion();
+      dialogDirty |= window->IsControlDirty();
+    }
+  }
+
+  // Dialog state can affect visibility states of the window and the other dialogs
+  if (dialogDirty)
+  {
+    if (pWindow)
+      pWindow->MarkDirtyRegion();
+
+    CGUIMessage msg(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_STATE_CHANGED);
+    for (const auto& window : activeDialogs)
+    {
+      if (window->IsDialogRunning())
+        window->OnMessage(msg);
     }
   }
 }
