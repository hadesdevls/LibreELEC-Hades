From 4a7e3ae89d1242561a2362e0a8c8db2b7a1503bf Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Thu, 29 Oct 2026 12:59:23 +0100
Subject: [PATCH] [Video] Hold the list item while the information dialog is
 open

OnItemInfo() is mostly called with an item of the list, and it copies
the item while the thumb loader thread may still be setting its art and
properties. The item is now held back from the loader while the dialog
is open, and the loader goes on with the other items meanwhile.
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 7074556..0b66c96 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -232,6 +232,9 @@ bool CGUIWindowVideoBase::OnItemInfo(const CFileItem& fileItem)
       (PLAYLIST::IsPlayList(fileItem) && !URIUtils::HasExtension(fileItem.GetDynPath(), ".strm")))
     return false;
 
+  // the item may be one of the list, which the loader thread writes
+  const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, &fileItem};
+
   // "Videos/Video Add-ons" lists addons in the video window
   if (fileItem.HasAddonInfo())
     return CGUIDialogAddonInfo::ShowForItem(std::make_shared<CFileItem>(fileItem));
-- 
