--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25220,7 +25220,19 @@ msgctxt "#39961"
 msgid "A 3D Blu-ray holds the picture of each eye as a view of its own (H.264 MVC), and so does a Matroska file made of one. With this setting both views are decoded, by the processor, and the video is shown as a stereoscopic one. Without it, or where the second view cannot be decoded, the video plays in 2D as before, with hardware decoding. Applies from the next video."
 msgstr ""
 
-#empty strings from id 39962 to 39979
+#empty strings from id 39962 to 39977
+
+#. Hades: help of setting "videoscreen.hades3doutput"; translated in Estuary (#31712)
+#: system/settings/settings.xml
+msgctxt "#39978"
+msgid "With a 3D TV or projector. While Kodi shows a video in a split 3D mode (over/under or side by side), the display is told so over HDMI and switches to 3D by itself. Frame packing, which keeps both eyes at full resolution, is used where the display and the graphics driver have it (Kodi then draws over/under, whatever was asked for); else the half format that is drawn. The refresh rate is the one the video gets anyway. Off: the two halves go out as an ordinary 2D picture and the display is switched to 3D by hand, as before. Turn it off if a 3D video shows a black or broken picture. Without a 3D display nothing changes. Applies from the next change of the 3D mode."
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hades3doutput"; translated in Estuary (#31711)
+#: system/settings/settings.xml
+msgctxt "#39979"
+msgid "Switch the display to 3D (HDMI)"
+msgstr ""
 
