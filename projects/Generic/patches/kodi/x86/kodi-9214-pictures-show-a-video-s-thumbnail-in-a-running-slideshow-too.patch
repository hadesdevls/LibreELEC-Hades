From e052004cb59067deee38af4a86c80419c92686e3 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 11 Oct 2026 20:47:59 +0100
Subject: [PATCH] [pictures] Show a video's thumbnail in a running slideshow
 too

A running slideshow neither loaded nor drew the next video's thumbnail,
so a picture faded out to black and the screen stayed black until the
video had a frame. Load it and fade into it like any picture, then keep
it up until the video starts, as when browsing by hand.
---
 xbmc/pictures/GUIWindowSlideShow.cpp | 13 ++++---------
 1 file changed, 4 insertions(+), 9 deletions(-)

diff --git a/xbmc/pictures/GUIWindowSlideShow.cpp b/xbmc/pictures/GUIWindowSlideShow.cpp
index c4ad569..af63ebb 100644
--- a/xbmc/pictures/GUIWindowSlideShow.cpp
+++ b/xbmc/pictures/GUIWindowSlideShow.cpp
@@ -572,7 +572,7 @@ void CGUIWindowSlideShow::Process(unsigned int currentTime, CDirtyRegionList &re
     m_iLastFailedNextSlide = -1;
     CFileItemPtr item = m_slides.at(m_iNextSlide);
     std::string picturePath = GetPicturePath(item.get());
-    if (!picturePath.empty() && (!IsVideo(*item) || !m_bSlideShow || m_bPause))
+    if (!picturePath.empty())
     {
       if (IsVideo(*item))
         CLog::Log(LOGDEBUG, "Loading the thumb {} for next video {}: {}", picturePath, m_iNextSlide,
@@ -621,11 +621,7 @@ void CGUIWindowSlideShow::Process(unsigned int currentTime, CDirtyRegionList &re
   // render the next image
   if (m_Image[m_iCurrentPic]->DrawNextImage())
   {
-    if (m_bSlideShow && !m_bPause && IsVideo(*m_slides.at(m_iNextSlide)))
-    {
-      // do not show thumb of video when playing slideshow
-    }
-    else if (m_Image[1 - m_iCurrentPic]->IsLoaded())
+    if (m_Image[1 - m_iCurrentPic]->IsLoaded())
     {
       if (appPlayer->IsPlayingVideo())
         appPlayer->ClosePlayer();
@@ -740,9 +736,8 @@ void CGUIWindowSlideShow::Render()
   auto& components = CServiceBroker::GetAppComponents();
   const auto appPlayer = components.GetComponent<CApplicationPlayer>();
 
-  // A running slideshow never shows a video's thumbnail. Otherwise keep it up until the first frame.
-  if (IsVideo(*m_slides.at(m_iCurrentSlide)) &&
-      ((m_bSlideShow && !m_bPause) || appPlayer->IsRenderingVideo()))
+  // Keep the video's thumbnail up until its first frame
+  if (IsVideo(*m_slides.at(m_iCurrentSlide)) && appPlayer->IsRenderingVideo())
   {
     gfxCtx.SetViewWindow(0, 0, m_coordsRes.iWidth, m_coordsRes.iHeight);
     gfxCtx.SetRenderingResolution(gfxCtx.GetVideoResolution(), false);
-- 
