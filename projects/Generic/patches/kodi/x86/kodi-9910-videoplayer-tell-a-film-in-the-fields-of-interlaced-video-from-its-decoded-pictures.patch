+#pragma once
+
+#include "cores/VideoPlayer/FieldCadence.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+}
+
+/*!
+ * \file FieldCadenceProbe.h
+ * \brief (Hades) Decodes a stretch of MPEG-2 video read before it is played and tells its cadence
+ *        (FieldCadence.h)
+ *
+ * Whether interlaced video is a film whose fields can be put back together is not in its flags:
+ * it is in its pictures. A stretch of the stream (its start, as the demuxer reads it, or a place
+ * further on, read as bytes) is decoded here with a decoder of its own, on one thread, and the luma
+ * of each picture is compared with the one before (KODI::FIELDCADENCE::Measure()). Nothing of the
+ * player is used, and the same file is tested outside of Kodi against FFmpeg.
+ *
+ * A picture that the decoder could not decode whole (the start of an open group of pictures whose
+ * reference was not read, a damaged stretch) ends the run of pictures that follow each other: the
+ * place in the cadence is counted again from the next one. The verdict is that of the runs, which
+ * have to agree.
+ */
+
+namespace KODI::FIELDCADENCE
+{
+/*!
+ * \brief The video elementary stream in a stretch of an MPEG transport stream that starts anywhere
+ *        (a TS read at a place of its own): the payload of the packets of the first PID met whose
+ *        packet starts a PES packet of a video stream (stream id 0xE0 to 0xEF), from that packet
+ *        on, without the PES headers; the packets are found by their sync byte every 188 bytes
+ */
+inline std::vector<uint8_t> TransportStreamVideo(const uint8_t* data, size_t size)
+{
+  static constexpr size_t PACKET = 188;
+  std::vector<uint8_t> video;
+  size_t i = 0;
+  // the first place where three packets in a row start with the sync byte
+  while (i + 2 * PACKET < size &&
+         (data[i] != 0x47 || data[i + PACKET] != 0x47 || data[i + 2 * PACKET] != 0x47))
+    ++i;
+  int pid = -1;
+  for (; i + PACKET <= size; i += PACKET)
+  {
+    const uint8_t* p = data + i;
+    if (p[0] != 0x47)
+      break; // (out of step: what is left is not read)
+    const bool start = (p[1] & 0x40) != 0;
+    const int packetPid = ((p[1] & 0x1F) << 8) | p[2];
+    const int adaptation = (p[3] >> 4) & 3;
+    size_t payload = 4;
+    if (adaptation & 2)
+      payload += 1 + static_cast<size_t>(p[4]);
+    if (!(adaptation & 1) || payload >= PACKET)
+      continue;
+    if (start)
+    {
+      // a PES packet: 00 00 01, stream id, length (2), flags (2), header length, header
+      const uint8_t* pes = p + payload;
+      const size_t left = PACKET - payload;
+      const bool videoPes = left >= 9 && pes[0] == 0 && pes[1] == 0 && pes[2] == 1 &&
+                            pes[3] >= 0xE0 && pes[3] <= 0xEF;
+      if (pid < 0 && videoPes)
+        pid = packetPid;
+      if (packetPid != pid)
+        continue;
+      if (!videoPes || 9 + static_cast<size_t>(pes[8]) > left)
+        continue;
+      payload += 9 + pes[8];
+    }
+    else if (packetPid != pid)
+      continue;
+    video.insert(video.end(), p + payload, p + PACKET);
+  }
+  return video;
+}
+
+/*!
+ * \brief The frames of the MPEG-2 video track in a stretch of a Matroska file that starts anywhere
+ *        (an MKV read at a place of its own), one after the other: from the first cluster met, the
+ *        payload of its blocks (SimpleBlock, and Block in a BlockGroup) without their headers; a
+ *        block with lacing (not used for video) and one cut by the end of the stretch are left out.
+ *        The track is the first whose block starts as an MPEG-2 picture does (a sequence header, a
+ *        group of pictures or a picture: the demuxer of FFmpeg does not keep the number of the
+ *        track). Where the elements stop making sense, the next cluster is looked for.
+ */
+inline std::vector<uint8_t> MatroskaVideo(const uint8_t* data, size_t size)
+{
+  std::vector<uint8_t> video;
+  uint64_t track = 0;
+  // an EBML variable-size integer at i: its length (0 where it is none), its value without the
+  // marker bit (or with it, for an element id), and whether all its bits are set (unknown size)
+  const auto vint = [data, size](size_t i, bool keepMarker, uint64_t& value, bool* unknown)
+  {
+    if (i >= size || data[i] == 0)
+      return size_t{0};
+    size_t length = 1;
+    while (!(data[i] & (0x80 >> (length - 1))))
+      ++length;
+    if (i + length > size)
+      return size_t{0};
+    value = keepMarker ? data[i] : (data[i] & (0xFF >> length));
+    bool ones = (data[i] & (0xFF >> length)) == (0xFF >> length);
+    for (size_t k = 1; k < length; ++k)
+    {
+      value = (value << 8) | data[i + k];
+      ones = ones && data[i + k] == 0xFF;
+    }
+    if (unknown)
+      *unknown = ones;
+    return length;
+  };
+  const auto nextCluster = [data, size](size_t from)
+  {
+    for (size_t i = from; i + 4 <= size; ++i)
+      if (data[i] == 0x1F && data[i + 1] == 0x43 && data[i + 2] == 0xB6 && data[i + 3] == 0x75)
+        return i;
+    return size;
+  };
+
+  size_t i = nextCluster(0);
+  while (i < size)
+  {
+    uint64_t id = 0;
+    uint64_t length = 0;
+    bool unknown = false;
+    const size_t idSize = vint(i, true, id, nullptr);
+    const size_t lengthSize = idSize ? vint(i + idSize, false, length, &unknown) : 0;
+    if (!idSize || !lengthSize)
+    {
+      i = nextCluster(i + 1);
+      continue;
+    }
+    const size_t body = i + idSize + lengthSize;
+    if (id == 0x1F43B675 || id == 0xA0) // a cluster, a block group: their elements follow
+    {
+      i = body;
+      continue;
+    }
+    if (unknown || body + length > size)
+    {
+      if (unknown)
+      {
+        i = nextCluster(i + 1);
+        continue;
+      }
+      break; // (cut by the end of the stretch)
+    }
+    if (id == 0xA3 || id == 0xA1) // SimpleBlock, Block
+    {
+      uint64_t number = 0;
+      const size_t numberSize = vint(body, false, number, nullptr);
+      const size_t header = numberSize + 3; // the track, a 16-bit timestamp, the flags
+      const uint8_t* frame = data + body + header;
+      if (track == 0 && numberSize && header + 4 <= length && frame[0] == 0 && frame[1] == 0 &&
+          frame[2] == 1 && (frame[3] == 0xB3 || frame[3] == 0xB8 || frame[3] == 0x00))
+        track = number;
+      if (numberSize && header <= length && number == track && !(data[body + numberSize + 2] & 0x06))
+        video.insert(video.end(), frame, data + body + length);
+    }
+    i = body + static_cast<size_t>(length);
+  }
+  return video;
+}
+
+class CProbe
+{
+public:
+  //! pictures decoded at the most (some 2.4 s at 29.97, 2.9 s at 25)
+  static constexpr size_t MAX_PICTURES = 72;
+
+  CProbe()
+  {
+    const AVCodec* codec = avcodec_find_decoder(AV_CODEC_ID_MPEG2VIDEO);
+    if (!codec)
+      return;
+    m_ctx = avcodec_alloc_context3(codec);
+    m_parser = av_parser_init(AV_CODEC_ID_MPEG2VIDEO);
+    m_packet = av_packet_alloc();
+    m_frame = av_frame_alloc();
+    if (!m_ctx || !m_parser || !m_packet || !m_frame)
+      return;
+    m_ctx->thread_count = 1;
+    if (avcodec_open2(m_ctx, codec, nullptr) < 0)
+      return;
+    m_open = true;
+  }
+
+  ~CProbe()
+  {
+    av_frame_free(&m_frame);
+    av_packet_free(&m_packet);
+    if (m_parser)
+      av_parser_close(m_parser);
+    avcodec_free_context(&m_ctx);
+  }
+
+  CProbe(const CProbe&) = delete;
+  CProbe& operator=(const CProbe&) = delete;
+
+  bool IsOpen() const { return m_open; }
+
+  //! \brief A packet of the stream as a demuxer gives it (a picture, or the end of one)
+  void AddPacket(const uint8_t* data, size_t size)
+  {
+    if (!m_open || Enough() || size == 0)
+      return;
+    av_packet_unref(m_packet);
+    if (av_new_packet(m_packet, static_cast<int>(size)) < 0)
+      return;
+    std::copy(data, data + size, m_packet->data);
+    Send(m_packet);
+  }
+
+  /*!
+   * \brief A stretch of elementary stream read at a place of its own: split into pictures by
+   *        FFmpeg's parser, as the demuxer of an elementary stream does
+   */
+  void AddElementaryStream(const uint8_t* data, size_t size)
+  {
+    if (!m_open)
+      return;
+    while (size > 0 && !Enough())
+    {
+      uint8_t* out = nullptr;
+      int outSize = 0;
+      const int used =
+          av_parser_parse2(m_parser, m_ctx, &out, &outSize, data, static_cast<int>(size),
+                           AV_NOPTS_VALUE, AV_NOPTS_VALUE, 0);
+      if (used < 0)
+        return;
+      data += used;
+      size -= static_cast<size_t>(used);
+      if (outSize > 0)
+        AddPacket(out, static_cast<size_t>(outSize));
+      if (used == 0 && outSize == 0)
+        break;
+    }
+  }
+
+  /*!
+   * \brief A stretch of elementary stream read at a place of its own, from its first sequence
+   *        header or group of pictures on (what comes before is of a group whose start was not
+   *        read)
+   */
+  void AddStretch(const std::vector<uint8_t>& video)
+  {
+    for (size_t i = 0; i + 4 <= video.size(); ++i)
+    {
+      if (video[i] == 0 && video[i + 1] == 0 && video[i + 2] == 1 &&
+          (video[i + 3] == 0xB3 || video[i + 3] == 0xB8))
+      {
+        AddElementaryStream(video.data() + i, video.size() - i);
+        return;
+      }
+    }
+  }
+
+  bool Enough() const { return m_pictures >= MAX_PICTURES; }
+
+  //! \brief Pictures decoded and compared so far
+  size_t Pictures() const { return m_pictures; }
+
+  //! \brief The rate of the coded frames that the stream says (its sequence header); false
+  //!        before a picture was decoded
+  bool CodedRate(int& rate, int& scale) const
+  {
+    if (!m_open || m_ctx->framerate.num <= 0 || m_ctx->framerate.den <= 0)
+      return false;
+    rate = m_ctx->framerate.num;
+    scale = m_ctx->framerate.den;
+    return true;
+  }
+
+  //! \brief Decodes what is left in the decoder, and tells what the runs of pictures say
+  Cadence Finish()
+  {
+    if (m_open && !m_flushed)
+    {
+      m_flushed = true;
+      if (!Enough())
+        Send(nullptr);
+    }
+    EndRun();
+    Cadence found = Cadence::UNKNOWN;
+    for (const Cadence c : m_runs)
+    {
+      if (c == Cadence::VIDEO)
+        return Cadence::VIDEO;
+      if (c == Cadence::UNKNOWN)
+        continue;
+      if (found != Cadence::UNKNOWN && found != c)
+        return Cadence::UNKNOWN;
+      found = c;
+    }
+    return found;
+  }
+
+  //! \brief What the longest run counted (for the log)
+  const Evidence& GetEvidence() const { return m_longest; }
+
+private:
+  void Send(const AVPacket* packet)
+  {
+    if (avcodec_send_packet(m_ctx, packet) < 0 && packet)
+      return;
+    while (!Enough() && avcodec_receive_frame(m_ctx, m_frame) == 0)
+    {
+      Picture(*m_frame);
+      av_frame_unref(m_frame);
+    }
+  }
+
+  void Picture(const AVFrame& frame)
+  {
+    const bool whole = frame.data[0] && frame.width >= 16 && frame.height >= 16 &&
+                       frame.decode_error_flags == 0 && !(frame.flags & AV_FRAME_FLAG_CORRUPT);
+    if (!whole || frame.width != m_width || frame.height != m_height)
+    {
+      EndRun();
+      m_have = false;
+      if (!whole)
+        return;
+    }
+    const Plane now{frame.data[0], frame.linesize[0], frame.width, frame.height};
+    const bool interlaced = (frame.flags & AV_FRAME_FLAG_INTERLACED) != 0;
+    const bool topFirst = !interlaced || (frame.flags & AV_FRAME_FLAG_TOP_FIELD_FIRST) != 0;
+    if (m_have)
+    {
+      const Plane before{m_before.data(), frame.width, frame.width, frame.height};
+      m_run.Add(LabelOf(Measure(before, now, topFirst), interlaced));
+      ++m_pictures;
+    }
+    m_width = frame.width;
+    m_height = frame.height;
+    m_before.resize(static_cast<size_t>(frame.width) * frame.height);
+    for (int y = 0; y < frame.height; ++y)
+      std::copy(frame.data[0] + static_cast<ptrdiff_t>(y) * frame.linesize[0],
+                frame.data[0] + static_cast<ptrdiff_t>(y) * frame.linesize[0] + frame.width,
+                m_before.data() + static_cast<size_t>(y) * frame.width);
+    m_have = true;
+  }
+
+  void EndRun()
+  {
+    const Evidence& e = m_run.GetEvidence();
+    if (e.pictures > 0)
+    {
+      m_runs.push_back(m_run.Verdict());
+      if (e.pictures > m_longest.pictures)
+        m_longest = e;
+    }
+    m_run = CRunClassifier();
+  }
+
+  AVCodecContext* m_ctx = nullptr;
+  AVCodecParserContext* m_parser = nullptr;
+  AVPacket* m_packet = nullptr;
+  AVFrame* m_frame = nullptr;
+  bool m_open = false;
+  bool m_flushed = false;
+  std::vector<uint8_t> m_before;
+  int m_width = 0;
+  int m_height = 0;
+  bool m_have = false;
+  size_t m_pictures = 0;
+  CRunClassifier m_run;
+  std::vector<Cadence> m_runs;
+  Evidence m_longest;
+};
+} // namespace KODI::FIELDCADENCE
