+/*
+ * Hades: the older Dolby Vision signalling that a display asks for with a Dolby VSVDB of version 0,
+ * the 15-byte version 1 form, or the 12-byte one with the low-latency field 0
+ * (CDisplayInfo::SupportsHdmi14bDolbyVision(): TVs of 2016, LG OLED among them, and some later
+ * ones): the tunnel of the Standard mode (TV-led) with, in place of the Dolby vendor InfoFrame, the
+ * HDMI 1.4b vendor InfoFrame (HDMI OUI 00-0C-03, 24 bytes of payload), which names the HDMI_VIC of
+ * 3840x2160 at 24, 25 and 30 Hz and of 4096x2160 at 24 Hz, and nothing for any other mode. It is
+ * what the HDMI transmitter of Amlogic sends for those blocks (hdmitx_set_vsif_pkt(): "ver0 and
+ * ver1_15 and ver1_12bit with ll= 0 use hdmi 1.4b VSIF"), with the AVI InfoFrame of the tunnel and
+ * its VIC 0 in the modes of an HDMI_VIC. The kernel backends make it themselves
+ * (DVBRIDGE_DV_HDMI14B_LAB); nvidia-drm sends what Kodi gives it in NV_HDMI_VSIF_METADATA, with
+ * NV_HDMI_DV_HDMI14B (nvidia-open-kernel-modules-9045, nvidia-legacy-open-9058), and refuses one
+ * whose HDMI_VIC is not that of the mode of its commit.
+ * Pure: a test builds it on the host.
+ */
+namespace DV_HDMI14B
+{
+//! The payload of the InfoFrame, PB1 to PB24 (nvidia-drm adds the header, 81 01 18, and the
+//! checksum)
+constexpr std::size_t PAYLOAD_SIZE = 24;
+//! The values of HDMI_VIC that it may name: 0 (none) and 1 to 4
+constexpr std::size_t HDMI_VICS = 5;
+
+//! The HDMI_VIC of a mode, from its timing as the kernel gives it (its refresh rate as Kodi takes
+//! it: the clock over the total pixels): 1 for 3840x2160 at 30 Hz (29.97 too), 2 at 25 Hz, 3 at 24
+//! Hz (23.976 too), 4 for 4096x2160 at 24 Hz (23.976 too); 0 for every other mode, and for an
+//! interlaced or 3D one
+inline unsigned int HdmiVic(
+    int width, int height, uint32_t clockKHz, int htotal, int vtotal, bool interlacedOr3D)
+{
+  if (interlacedOr3D || height != 2160 || htotal <= 0 || vtotal <= 0)
+    return 0;
+  const double refresh = clockKHz * 1000.0 / htotal / vtotal;
+  // (matched as DVBRIDGE::IsTransportMode() matches the rates of the transport)
+  const auto at = [refresh](double rate)
+  { return refresh > rate - 0.012 && refresh < rate + 0.012; };
+  if (width == 3840 && (at(30.0) || at(30000.0 / 1001)))
+    return 1;
+  if (width == 3840 && at(25.0))
+    return 2;
+  if (width == 3840 && (at(24.0) || at(24000.0 / 1001)))
+    return 3;
+  if (width == 4096 && (at(24.0) || at(24000.0 / 1001)))
+    return 4;
+  return 0;
+}
+
+//! The payload for a mode of that HDMI_VIC: the OUI (03 0C 00), HDMI_Video_Format 1 (an extended
+//! resolution, PB4 0x20) with the HDMI_VIC in PB5, or PB4 and PB5 0 for a mode without one; PB6 to
+//! PB24 0
+inline std::array<uint8_t, PAYLOAD_SIZE> Payload(unsigned int hdmiVic)
+{
+  std::array<uint8_t, PAYLOAD_SIZE> payload{};
+  payload[0] = 0x03;
+  payload[1] = 0x0C;
+  payload[2] = 0x00;
+  if (hdmiVic >= 1 && hdmiVic < HDMI_VICS)
+  {
+    payload[3] = 0x20;
+    payload[4] = static_cast<uint8_t>(hdmiVic);
+  }
+  return payload;
+}
+} // namespace DV_HDMI14B
