+bool CDVBridgeState::SupportsHdmi14b(CDRMConnector& connector)
+{
+  switch (GetBackend(connector))
+  {
+    case Backend::KERNEL:
+      return connector.SupportsProperty("DVBRIDGE_DV_HDMI14B_LAB");
+    case Backend::NVIDIA:
+      return connector.SupportsProperty("NV_HDMI_DV_HDMI14B");
+    default:
+      return false;
+  }
+}
+
+unsigned int CDVBridgeState::Hdmi14bVic(const drmModeModeInfo& mode)
+{
+  const bool interlacedOr3D =
+      (mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0;
+  return DV_HDMI14B::HdmiVic(mode.hdisplay, mode.vdisplay, mode.clock, mode.htotal, mode.vtotal,
+                             interlacedOr3D);
+}
