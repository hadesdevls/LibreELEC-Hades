From 04941c5862c77bc18546d936bd18b103604af745 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:29:08 +0000
Subject: [PATCH] [DVBridge] Keep repeated pictures by a commit where the
 driver has no vblank

A picture of native Dolby Vision output that repeats (24p at 60 Hz, a pause) is kept on the
screen instead of being drawn again, paced by the vblanks of the CRTC, or by a commit of the same
picture that waits for its flip where advancedsettings.xml asks for it (dvkeepbycommit, off).
nvidia-drm with its defaults has no vblank at all (EOPNOTSUPP): from the first repeat on, every
one of them was drawn and committed again in full. The logs count it: 6 543 of 29 035 pictures
shown drawn again for "no vblank" in one of issue #4 (Quadro RTX 4000), 184 of 8 131 and 225 of
3 553 in two of an RTX 4080 SUPER.

Where the device has no vblank, CDVRepeatKeep now keeps them by the commit of the same picture
without being asked, after a frame presented the way that waits (after one presented a frame ahead
it is still drawn again). Read in nvidia-drm 615.78.08: every flip marks its surface as changed "so
that we always get a flip event: a DRM client may flip with the same surface and wait for a flip
event" (nvidia-drm-crtc.c), and a commit that waits returns once its flip has come, after 3 s at
most (nvidia-drm-modeset.c). Fail closed as before: a refused commit, or (new) three in a row that
come back in less than a quarter of a refresh, which paced nothing, end it for that native output
and the pictures are drawn again; a commit whose flip does not come counts as any frame's
(CDVPresentStall). kodi.log says it once ("the vblanks of the output cannot be waited for
(Operation not supported): the driver has none ...; a picture that repeats after a frame
presented the way that waits is kept by committing it again"), and the line of every 10 s counts
"N of the pictures kept were committed again" and the reasons of those drawn again.

Host test: dvrepeatkeep_test, 15 checks; with the header before, 5 fail. Whether it saves the GPU
time of those frames on nvidia-drm without a late refresh can only be read in a log of an NVIDIA
GPU: kept pictures, "no vblank" going to 0, and no frame of native output stalled.
---
 xbmc/windowing/gbm/DVRepeatKeep.h             | 45 +++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 29 +++++++++---
 2 files changed, 64 insertions(+), 10 deletions(-)

diff --git a/xbmc/windowing/gbm/DVRepeatKeep.h b/xbmc/windowing/gbm/DVRepeatKeep.h
index 3e3043c..f0a624b 100644
--- a/xbmc/windowing/gbm/DVRepeatKeep.h
+++ b/xbmc/windowing/gbm/DVRepeatKeep.h
@@ -38,6 +38,16 @@ namespace GBM
  * output in which it happened. From then on the pictures are drawn again every refresh, as in
  * 1.0 RC1, unless a commit keeps them.
  *
+ * Hades: where the device has no vblank at all (EOPNOTSUPP), a commit keeps them without being
+ * asked for: nvidia-drm marks the surface of every flip as changed "so that we always get a flip
+ * event: a DRM client may flip with the same surface and wait for a flip event"
+ * (nvidia-drm-crtc.c), and a commit that waits returns when its flip has come
+ * (nvidia-drm-modeset.c, at most 3 s). The pictures drawn again for "no vblank" were 6 543 of
+ * 29 035 shown in a log of issue #4 (Quadro RTX 4000), and 184 of 8 131 and 225 of 3 553 in two of
+ * an RTX 4080 SUPER. Only after a frame presented the way that waits; one presented a frame ahead
+ * is still drawn again. A commit that is refused, or that comes back in less than a quarter of a
+ * refresh three times in a row (it paced nothing), ends it for that native output.
+ *
  * This class only decides.
  */
 class CDVRepeatKeep
@@ -71,18 +81,37 @@ public:
   {
     m_vblankFailedHere = false;
     m_byCommit = byCommit;
+    m_commitFailedHere = false;
+    m_quickCommits = 0;
   }
 
   //! \param ahead the frame on the screen was presented a frame ahead
   Pace Way(bool ahead) const
   {
-    if (m_byCommit && !ahead)
+    // (Hades: also where the device has no vblank, until a commit fails in this native output)
+    if ((m_byCommit || m_noVBlank) && !ahead && !m_commitFailedHere)
       return Pace::COMMIT;
     if (!m_noVBlank && !m_vblankFailedHere)
       return Pace::VBLANK;
     return Pace::NONE;
   }
 
+  //! Hades: a commit kept the picture, and took ms of a refresh of periodMs. True when commits no
+  //! longer keep pictures in this native output: the third in a row that came back in less than a
+  //! quarter of the refresh (it paced nothing)
+  bool CommitTook(double ms, double periodMs)
+  {
+    if (!(periodMs > 0.0) || ms >= QUICK * periodMs)
+    {
+      m_quickCommits = 0;
+      return false;
+    }
+    if (++m_quickCommits < QUICK_COMMITS)
+      return false;
+    CommitFailed();
+    return true;
+  }
+
   //! The vblank of the CRTC could not be waited for, with this error (errno). True when the log
   //! is to be told (once for the device, the first three times for another error)
   bool VBlankFailed(int error)
@@ -103,8 +132,14 @@ public:
   bool DeviceHasNoVBlank() const { return m_noVBlank; }
 
   //! The commit that kept a picture was refused: the vblanks pace the rest of this native output
-  void CommitFailed() { m_byCommit = false; }
-  bool ByCommit() const { return m_byCommit; }
+  //! (Hades: where there are some; else the pictures are drawn again)
+  void CommitFailed()
+  {
+    m_byCommit = false;
+    m_commitFailedHere = true;
+  }
+  //! (asked for in advancedsettings.xml, or kept by commits because the device has no vblank)
+  bool ByCommit() const { return (m_byCommit || m_noVBlank) && !m_commitFailedHere; }
 
   static constexpr const char* Name(Reason reason)
   {
@@ -145,9 +180,13 @@ public:
   }
 
 private:
+  static constexpr double QUICK = 0.25; //!< Hades: of a refresh: a commit that paced nothing
+  static constexpr unsigned int QUICK_COMMITS = 3;
   bool m_noVBlank = false;
   bool m_vblankFailedHere = false;
   bool m_byCommit = false;
+  bool m_commitFailedHere = false; //!< Hades: a commit failed to keep a picture in this output
+  unsigned int m_quickCommits = 0;
   unsigned int m_othersTold = 0;
 };
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 54200fc..060ee89 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4248,8 +4248,11 @@ void CWinSystemGbmGLESContext::KeepDVBridgeFrame()
       paced = false;
       why = CDVRepeatKeep::Reason::COMMIT;
       m_dvKeep.CommitFailed();
-      CLog::Log(LOGWARNING, "DVBridge: the commit that kept a picture on the screen was refused; "
-                            "the vblanks pace the pictures kept in the rest of this native output");
+      CLog::Log(LOGWARNING,
+                "DVBridge: the commit that kept a picture on the screen was refused; {}",
+                m_dvKeep.DeviceHasNoVBlank()
+                    ? "pictures that repeat are drawn again in the rest of this native output"
+                    : "the vblanks pace the pictures kept in the rest of this native output");
     }
   }
   else
@@ -4275,12 +4278,15 @@ void CWinSystemGbmGLESContext::KeepDVBridgeFrame()
     // pass late (nvidia-drm has no vblank with its defaults)
     why = CDVRepeatKeep::Reason::NO_VBLANK;
     if (m_dvKeep.VBlankFailed(vblankError))
-      CLog::Log(LOGINFO,
-                "DVBridge: the vblanks of the output cannot be waited for ({}): a picture that "
-                "repeats is drawn again every refresh, {}",
+      CLog::Log(LOGINFO, "DVBridge: the vblanks of the output cannot be waited for ({}): {}",
                 strerror(vblankError),
-                m_dvKeep.DeviceHasNoVBlank() ? "until Kodi is started again (the driver has none)"
-                                             : "for the rest of this native output");
+                m_dvKeep.DeviceHasNoVBlank()
+                    ? "the driver has none (until Kodi is started again); a picture that repeats "
+                      "after a frame presented the way that waits is kept by committing it again, "
+                      "its commit waiting for its flip, and one after a frame presented a frame "
+                      "ahead is drawn again every refresh"
+                    : "a picture that repeats is drawn again every refresh, for the rest of this "
+                      "native output");
   }
   if (!paced)
   {
@@ -4303,6 +4309,15 @@ void CWinSystemGbmGLESContext::KeepDVBridgeFrame()
     if (DVPresentStalled(true, presentMs, false))
       return;
     m_dvStats.keptByCommit++;
+    // Hades: a commit of the same picture that comes back long before a refresh paced nothing
+    // (CDVRepeatKeep::CommitTook())
+    if (const double periodMs = DVRefreshPeriodMs(); m_dvKeep.CommitTook(presentMs, periodMs))
+      CLog::Log(LOGWARNING,
+                "DVBridge: commits that kept a picture on the screen came back without waiting for "
+                "a refresh ({:.1f} ms of {:.1f}); pictures that repeat are {} in the rest of this "
+                "native output",
+                presentMs, periodMs,
+                m_dvKeep.DeviceHasNoVBlank() ? "drawn again" : "paced by the vblanks");
   }
   m_dvStats.presentSumMs += presentMs;
   m_dvStats.presentMaxMs = std::max(m_dvStats.presentMaxMs, presentMs);
-- 
2.53.0

