From e944cc5cdd23eb7410420165f30d5af7b51f14a4 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 16:34:55 +0000
Subject: [PATCH] [Video] Keep a movie whose refresh can't read its details.

A refresh removes a movie before adding it again, so a lookup that
failed, as when the scraper's site didn't answer, left it out of the
library until the next scan found it. A refresh of a whole source lost
movies this way.

The details are now read before the movie is removed, and a movie they
can't be read for is left as it is. A movie with an override nfo or an
embedded title still needs them looked up, so it is searched for in the
refresh rather than by the scanner once removed. The refresh's scanner
uses the same scraper, so it reads them from its cache rather than
fetching them again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.h                 |  8 +++
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 49 ++++++++++++--
 xbmc/video/test/TestVideoInfoScanner.cpp      | 64 +++++++++++++++++++
 3 files changed, 117 insertions(+), 4 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.h b/xbmc/video/VideoInfoScanner.h
index 4875b68..e60bc11 100644
--- a/xbmc/video/VideoInfoScanner.h
+++ b/xbmc/video/VideoInfoScanner.h
@@ -124,6 +124,14 @@ namespace KODI::VIDEO
                            bool fetchEpisodes = true,
                            CGUIDialogProgress* pDlgProgress = nullptr);
 
+    /*! \brief Look the videos up with these scrapers, as CVideoDatabase::GetScraperForPath()
+     cached them, so that the details already read with them are read from their cache.
+     */
+    void UseScrapers(const CVideoDatabase::ScraperCache& scrapers)
+    {
+      m_scraperCache.insert(scrapers.begin(), scrapers.end());
+    }
+
     static bool DownloadFailed(CGUIDialogProgress* pDlgProgress);
 
     /*! \brief Update the set information from a SET.NFO in the Movie Set Information Folder
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index d5ea1cb..d24b602 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -94,7 +94,8 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
   // determine the scraper for the item's path
   VIDEO::SScanSettings scanSettings;
-  ScraperPtr scraper = db.GetScraperForPath(m_item->GetPath(), scanSettings);
+  CVideoDatabase::ScraperCache scrapers;
+  ScraperPtr scraper = db.GetScraperForPath(m_item->GetPath(), scanSettings, &scrapers);
   if (!scraper && m_item->GetVideoContentType() == VideoDbContentType::MOVIE_SETS)
   {
     // Deal with refreshing movie set
@@ -220,10 +221,14 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
   // run this in a loop in case we need to refresh again
   bool failure = false;
+  // a title the user enters is searched for in place of one embedded in the file
+  bool useEmbeddedTitle{m_searchTitle.empty()};
   do
   {
     std::unique_ptr<CVideoInfoTag> pluginTag;
     std::unique_ptr<KODI::ART::Artwork> pluginArt;
+    std::string embeddedTitle;
+    int embeddedYear{-1};
 
     if (!ignoreNfo)
     {
@@ -259,8 +264,14 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
           if (nfo && nfo->GetArt())
             pluginArt = std::move(nfo->GetArt());
         }
-        else if (nfoResult == CInfoScanner::InfoType::URL)
+        else if (nfoResult == CInfoScanner::InfoType::URL ||
+                 nfoResult == CInfoScanner::InfoType::COMBINED)
           scraperUrl = loader->ScraperUrl();
+        else if (nfoResult == CInfoScanner::InfoType::TITLE)
+        {
+          embeddedTitle = tag->GetTitle();
+          embeddedYear = tag->GetYear();
+        }
       }
 
       static constexpr std::array NFO_RESULTS{"none",     "full",      "url",  "override",
@@ -274,7 +285,11 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       // if there's no NFO remember it in case we have to refresh again
       if (nfoResult == CInfoScanner::InfoType::ERROR_NFO)
         ignoreNfo = true;
-      else if (nfoResult != CInfoScanner::InfoType::NONE)
+      // a movie's embedded title or override nfo still needs its details looked up
+      else if (nfoResult != CInfoScanner::InfoType::NONE &&
+               (scraper->Content() != ADDON::ContentType::MOVIES ||
+                (nfoResult != CInfoScanner::InfoType::TITLE &&
+                 nfoResult != CInfoScanner::InfoType::OVERRIDE)))
         hasDetails = true;
 
       // if we are performing a forced refresh ask the user to choose between using a valid NFO and a valid scraper
@@ -335,7 +350,10 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
       // try to find a matching item
       MOVIELIST itemResultList;
-      int result = infoDownloader.FindMovie(itemTitle, -1, itemResultList, GetProgressDialog());
+      const bool useTagTitle{useEmbeddedTitle && !ignoreNfo && !embeddedTitle.empty()};
+      int result = infoDownloader.FindMovie(useTagTitle ? embeddedTitle : itemTitle,
+                                            useTagTitle ? embeddedYear : -1, itemResultList,
+                                            GetProgressDialog());
 
       // close the progress dialog
       MarkFinished();
@@ -376,6 +394,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
                 return false;
 
               // go through the whole process again
+              useEmbeddedTitle = false;
               needsRefresh = true;
               continue;
             }
@@ -412,6 +431,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
           return false;
 
         // go through the whole process again
+        useEmbeddedTitle = false;
         needsRefresh = true;
         continue;
       }
@@ -421,6 +441,26 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       break;
     }
 
+    // A movie is removed before it is added again, so its details are read first. One the scraper
+    // can't give them for, as when its site doesn't answer, is left as it is.
+    if (scraper->Content() == ADDON::ContentType::MOVIES && scraperUrl.HasUrls())
+    {
+      // the search closed a modal progress dialog, and the download pumps the GUI through it
+      SetTitle(CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(198));
+      SetText(itemTitle);
+      SetProgress(0);
+
+      CVideoInfoTag details;
+      if (!CVideoInfoDownloader(scraper).GetDetails({}, scraperUrl, details, GetProgressDialog()))
+      {
+        CLog::Log(LOGWARNING,
+                  "CVideoLibraryRefreshingJob: no details found for '{}', so it is left as it is",
+                  CURL::GetRedacted(m_item->GetPath()));
+        failure = true;
+        break;
+      }
+    }
+
     // before we start downloading all the necessary information cleanup any existing artwork and hashes
     CTextureDatabase textureDb;
     if (textureDb.Open())
@@ -574,6 +614,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
     // finally download the information for the item
     VIDEO::CVideoInfoScanner scanner;
+    scanner.UseScrapers(scrapers);
     if (!scanner.RetrieveVideoInfo(items, scanSettings.parent_name,
                                    scraper->Content(), !ignoreNfo,
                                    scraperUrl.HasUrls() ? &scraperUrl : nullptr,
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 55c7773..8060d8d 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -33,6 +33,7 @@
 #include "video/VideoInfoScanner.h"
 #include "video/VideoInfoTag.h"
 #include "video/VideoManagerTypes.h"
+#include "video/jobs/VideoLibraryRefreshingJob.h"
 #include "video/jobs/VideoLibraryScanningJob.h"
 
 #include <chrono>
@@ -127,6 +128,14 @@ constexpr const char* OTHER_SCRAPER_XML = R"(<?xml version="1.0" encoding="UTF-8
   </GetEpisodeList>
 </scraper>)";
 
+//! A refresh without its GUI, of the test's database
+class TestRefreshingJob : public CVideoLibraryRefreshingJob
+{
+public:
+  using CVideoLibraryRefreshingJob::CVideoLibraryRefreshingJob;
+  using CVideoLibraryRefreshingJob::Work;
+};
+
 //! A scan without its GUI: Start() needs one, so the folders are scanned with DoScan()
 class TestScanner : public CVideoInfoScanner
 {
@@ -233,6 +242,11 @@ protected:
         m_fastHash;
     CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_bVideoScannerIgnoreErrors =
         m_ignoreErrors;
+    if (!m_installedScraper.empty())
+    {
+      CServiceBroker::GetAddonMgr().UnloadAddon(SCRAPER_ID);
+      XFILE::CDirectory::RemoveRecursive(m_installedScraper);
+    }
     if (!m_otherScraper.empty())
     {
       CServiceBroker::GetAddonMgr().UnloadAddon(OTHER_SCRAPER_ID);
@@ -345,6 +359,18 @@ protected:
         CSettings::SETTING_EVENTLOG_ENABLED, false);
   }
 
+  //! Installs the test scraper, as a refresh finds the scraper of a path through the add-on manager
+  void InstallTestScraper()
+  {
+    const std::string addons{CSpecialProtocol::TranslatePath("special://home/addons/")};
+    static_cast<void>(XFILE::CDirectory::Create(addons));
+    m_installedScraper = Folder(addons, SCRAPER_ID);
+    File(m_installedScraper, "addon.xml", SCRAPER_ADDON);
+    File(m_installedScraper, "scraper.xml", SCRAPER_XML);
+    ASSERT_TRUE(CServiceBroker::GetAddonMgr().FindAddon(SCRAPER_ID, ADDON::ORIGIN_SYSTEM,
+                                                        ADDON::CAddonVersion{"1.0.0"}));
+  }
+
   //! Installs the other scraper. Neither scraper can fetch the url it recognises, nor does the
   //! other one find an episode guide.
   void InstallOtherScraper()
@@ -420,6 +446,31 @@ protected:
 
   int CountMovies() { return m_db.GetSingleValueInt("SELECT COUNT(*) FROM movie"); }
 
+  //! A refresh removes a movie before adding it again, so one whose details can't be read is
+  //! kept. The movie has no nfo, or one that overrides some of the details it is looked up for.
+  void RefreshThatCantReadTheDetails(bool overrideNfo)
+  {
+    UseTestScraper(ADDON::AddonType::SCRAPER_MOVIES);
+    InstallTestScraper();
+    const std::string folder{Folder(m_root, "Afilm")};
+    const std::string film{File(folder, "Afilm.mkv")};
+    if (overrideNfo)
+      File(folder, "Afilm.nfo", "<movie override=\"true\"><title>Afilm</title></movie>");
+    Found("Afilm");
+    Details("Afilm", "<details><title>Afilm</title></details>");
+    Scan();
+    const int idMovie{m_db.GetMovieId(film)};
+    ASSERT_GT(idMovie, 0);
+
+    DetailsFail("Afilm");
+    CVideoInfoTag tag;
+    ASSERT_TRUE(m_db.GetMovieInfo({}, tag, idMovie));
+    TestRefreshingJob refresh{std::make_shared<CFileItem>(tag), true, false};
+    refresh.Work(m_db);
+
+    EXPECT_EQ(idMovie, m_db.GetMovieId(film));
+  }
+
   std::string m_root;
   DatabaseSettings m_settings;
   CVideoDatabase m_db;
@@ -432,6 +483,7 @@ protected:
   ADDON::AddonType m_scraperType{ADDON::AddonType::SCRAPER_MOVIES};
   bool m_eventLog{false};
   std::string m_otherScraper;
+  std::string m_installedScraper;
 };
 } // namespace
 
@@ -732,6 +784,18 @@ TEST_F(TestVideoInfoScanner, AnUnchangedFolderIsLookedUpAgainAfterDetailsFailed)
   EXPECT_EQ(2, CountMovies());
 }
 
+// A refresh removes a movie before adding it again, so one whose details can't be read is kept
+TEST_F(TestVideoInfoScanner, ARefreshThatCantReadTheDetailsKeepsTheMovie)
+{
+  RefreshThatCantReadTheDetails(false);
+}
+
+// An override nfo gives some of the details, and the rest are still looked up
+TEST_F(TestVideoInfoScanner, ARefreshWithAnOverrideNfoThatCantReadTheDetailsKeepsTheMovie)
+{
+  RefreshThatCantReadTheDetails(true);
+}
+
 // A url is only taken from the scraper chosen for the path, which is the one it is fetched with
 TEST_F(TestVideoInfoScanner, AMovieIsLookedUpWithItsPathsScraperWhenItsNfoNamesAnother)
 {
