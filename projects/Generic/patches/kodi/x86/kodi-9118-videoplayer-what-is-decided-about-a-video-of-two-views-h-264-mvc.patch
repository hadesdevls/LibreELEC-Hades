+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <numeric>
+#include <optional>
+#include <string_view>
+
+namespace KODI
+{
+namespace MULTIVIEW
+{
+
+/*!
+ * \brief What is decided about a video whose two eyes are coded as two views (H.264 MVC)
+ *
+ * A 3D Blu-ray, and a Matroska file made of one, code the left and the right eye as two views
+ * of one H.264 stream: a base view that any decoder plays, and a second view that is predicted
+ * from it. A decoder that knows both gives each view as a picture of its own, the two of an
+ * access unit with the same presentation time. Kodi shows a stereoscopic video from one picture
+ * that holds both eyes, so the two are put side by side at their full size, the left eye on the
+ * left.
+ *
+ * Here is what that takes to decide, and nothing else: whether a track is such a stream, which
+ * eye its base view is, which two pictures are the two views of one access unit, and what to do
+ * when one of them does not come. The rule everywhere is that a doubt ends in the base view
+ * alone, shown to both eyes, and never in two pictures that do not belong together.
+ *
+ * Nothing of FFmpeg or of Kodi is used, so that it can be tested by itself.
+ */
+
+//! The name of the decoder that outputs both views. The H.264 decoder that every other stream
+//! uses is another one and is never asked for a second view.
+inline constexpr const char* DECODER_NAME = "h264_mvc";
+
+//! The option of that decoder that names the views to output, and its value for all of them
+inline constexpr const char* DECODER_VIEWS_OPTION = "view_ids";
+inline constexpr const char* DECODER_ALL_VIEWS = "-1";
+//! ... and the option in which it lists the views of the stream, the base view first
+inline constexpr const char* DECODER_VIEW_LIST_OPTION = "view_ids_available";
+
+//! The stereo mode of the picture that is made of the two views
+inline constexpr const char* PACKED_STEREO_MODE = "left_right";
+//! ... and of the pictures of such a stream when only its base view is decoded
+inline constexpr const char* BASE_ONLY_STEREO_MODE = "mono";
+
+/*!
+ * \name The track
+ * @{
+ */
+
+namespace DETAIL
+{
+inline constexpr int NAL_SUBSET_SPS = 15;
+inline constexpr int PROFILE_MULTIVIEW_HIGH = 118;
+inline constexpr int PROFILE_STEREO_HIGH = 128;
+
+inline size_t Be16(const uint8_t* data)
+{
+  return (static_cast<size_t>(data[0]) << 8) | data[1];
+}
+
+inline uint64_t Be32(const uint8_t* data)
+{
+  return (static_cast<uint64_t>(data[0]) << 24) | (static_cast<uint64_t>(data[1]) << 16) |
+         (static_cast<uint64_t>(data[2]) << 8) | data[3];
+}
+
+/*!
+ * \brief Whether a record of the form of the 'mvcC' box declares a second view
+ *
+ * It is laid out as the record of 'avcC': six bytes, a count of sequence parameter sets and
+ * each of them behind its length. Those of a second view are subset sequence parameter sets
+ * (NAL unit type 15) of the Multiview High or the Stereo High profile; one is enough. The count
+ * has seven bits here, where 'avcC' has five below three bits that are set: a writer that kept
+ * those three bits is understood too.
+ */
+inline bool DeclaresSecondView(const uint8_t* record, size_t size)
+{
+  if (size < 7 || record[0] != 1)
+    return false;
+
+  const unsigned int count = (record[5] & 0xe0) == 0xe0 ? record[5] & 0x1f : record[5] & 0x7f;
+  bool found = false;
+  size_t pos = 6;
+  for (unsigned int i = 0; i < count; ++i)
+  {
+    if (size - pos < 2)
+      return false;
+    const size_t length = Be16(record + pos);
+    pos += 2;
+    if (size - pos < length)
+      return false;
+    if (length >= 2 && (record[pos] & 0x1f) == NAL_SUBSET_SPS &&
+        (record[pos + 1] == PROFILE_MULTIVIEW_HIGH || record[pos + 1] == PROFILE_STEREO_HIGH))
+      found = true;
+    pos += length;
+  }
+  return found;
+}
+} // namespace DETAIL
+
+/*!
+ * \brief Whether the codec private data of an H.264 track declares a second view
+ *
+ * A Matroska file made of a 3D Blu-ray carries both views in one track and says so in the
+ * private data of the codec only: behind the record of the base view ('avcC', ISO/IEC 14496-15)
+ * comes a box 'mvcC' with the parameter sets of the second view.
+ *
+ * The record of the base view is walked to the end of its parameter sets, and the box is looked
+ * for from there on (the record may go on with a few bytes that a writer is free to leave out,
+ * so the place of the box is not fixed). A box counts when it lies within the data and holds a
+ * subset sequence parameter set of a multiview profile: the four letters alone, which could
+ * stand anywhere, do not.
+ */
+inline bool HasMvcConfiguration(const uint8_t* data, size_t size)
+{
+  if (!data || size < 7 || data[0] != 1)
+    return false;
+
+  // the sequence parameter sets and the picture parameter sets of the base view
+  size_t pos = 6;
+  for (unsigned int i = data[5] & 0x1f; i; --i)
+  {
+    if (size - pos < 2)
+      return false;
+    const size_t length = DETAIL::Be16(data + pos);
+    pos += 2;
+    if (size - pos < length)
+      return false;
+    pos += length;
+  }
+  if (size - pos < 1)
+    return false;
+  for (unsigned int i = data[pos++]; i; --i)
+  {
+    if (size - pos < 2)
+      return false;
+    const size_t length = DETAIL::Be16(data + pos);
+    pos += 2;
+    if (size - pos < length)
+      return false;
+    pos += length;
+  }
+
+  // a box: its size in four bytes, its type in four, its content
+  for (; size - pos >= 8; ++pos)
+  {
+    if (data[pos + 4] != 'm' || data[pos + 5] != 'v' || data[pos + 6] != 'c' ||
+        data[pos + 7] != 'C')
+      continue;
+    const uint64_t box = DETAIL::Be32(data + pos);
+    if (box < 8 || box > size - pos)
+      continue;
+    if (DETAIL::DeclaresSecondView(data + pos + 8, static_cast<size_t>(box) - 8))
+      return true;
+  }
+  return false;
+}
+
+//! Which eye the base view of a stream is
+enum class BaseEye
+{
+  LEFT,
+  RIGHT,
+};
+
+/*!
+ * \brief The eye of the base view, by what the container says of the layout of the track
+ *
+ * A container has no word for two views in one track. A Matroska file made of a 3D Blu-ray
+ * says "both eyes in one block", with the eye that comes first, or nothing at all: the base
+ * view is the left eye unless it says that the right one comes first. A container that names a
+ * layout within the picture (side by side, top and bottom...) or says that the track is not
+ * stereoscopic describes another stream, which is left alone.
+ */
+inline std::optional<BaseEye> BaseEyeOfContainer(std::string_view stereoMode)
+{
+  if (stereoMode.empty() || stereoMode == "block_lr")
+    return BaseEye::LEFT;
+  if (stereoMode == "block_rl")
+    return BaseEye::RIGHT;
+  return std::nullopt;
+}
+
+//! What is known of a track when its stream is made
+struct Track
+{
+  bool h264{false};
+  bool allowed{false}; //!< the setting: both views of such a stream are to be decoded
+  bool decoder{false}; //!< this build has the decoder that outputs both views
+  const uint8_t* extradata{nullptr}; //!< the private data of the codec
+  size_t extradataSize{0};
+  std::string_view stereoMode; //!< what the container says of the layout, in the words of Matroska
+};
+
+/*!
+ * \brief Whether a track is decoded as two views, and which eye its base view is then
+ *
+ * Everything has to hold: any other track is the stream it always was.
+ */
+inline std::optional<BaseEye> TwoViews(const Track& track)
+{
+  if (!track.h264 || !track.allowed || !track.decoder)
+    return std::nullopt;
+  if (!HasMvcConfiguration(track.extradata, track.extradataSize))
+    return std::nullopt;
+  return BaseEyeOfContainer(track.stereoMode);
+}
+
+//! @}
+
+/*!
+ * \name The pictures
+ * @{
+ */
+
+//! The presentation time of a picture that has none
+inline constexpr int64_t NO_TIME = std::numeric_limits<int64_t>::min();
+
+//! What tells whether two pictures are the two views of one access unit
+struct View
+{
+  bool hasId{false}; //!< the decoder said which view the picture is
+  int id{0};
+  int64_t time{NO_TIME};
+  int width{0};
+  int height{0};
+  int format{-1};
+
+  bool operator==(const View&) const = default;
+};
+
+/*!
+ * \brief Whether a picture is the base view
+ *
+ * The decoder names the view of each picture when it outputs more than one view; a picture
+ * without that name is the only view of its access unit, the base view. The base view of the
+ * others is the first one of the list of views that the decoder gives, and where it gives no
+ * list, the view of the first picture that had a name.
+ */
+inline bool IsBase(const View& view, int baseId)
+{
+  return !view.hasId || view.id == baseId;
+}
+
+/*!
+ * \brief Whether two pictures are the two views of one access unit
+ *
+ * Both are named, as different views, and have the same presentation time; and they can be put
+ * side by side. Two pictures without a time are not known to belong together, however they
+ * follow each other.
+ */
+inline bool SameAccessUnit(const View& a, const View& b)
+{
+  return a.hasId && b.hasId && a.id != b.id && a.time != NO_TIME && a.time == b.time &&
+         a.width == b.width && a.height == b.height && a.format == b.format;
+}
+
+//! What is done with a picture that comes from the decoder
+enum class Step
+{
+  //! nothing waits: the picture waits for the other view of its access unit
+  KEEP,
+  //! it is the other view of the picture that waits: the two go out as one picture
+  PAIR,
+  //! the picture that waits is a base view whose second view did not come: it goes out alone,
+  //! and this picture waits
+  ALONE_THEN_KEEP,
+  //! the picture that waits is a second view whose base view did not come: it is never shown,
+  //! and this picture waits
+  REPLACE,
+};
+
+/*!
+ * \brief What is done with a picture, given the one that waits
+ *
+ * One picture waits at most. The order in which the decoder gives the two views of an access
+ * unit is not relied upon; that they have the same time is. A base view that is left without
+ * its second view goes out alone, to both eyes; a second view that is left without its base
+ * view goes nowhere.
+ *
+ * \param waiting the picture that waits, if one does
+ * \param picture the picture that comes
+ * \param baseId the view that is the base view
+ */
+inline Step Take(const std::optional<View>& waiting, const View& picture, int baseId)
+{
+  if (!waiting)
+    return Step::KEEP;
+  if (IsBase(*waiting, baseId) != IsBase(picture, baseId) && SameAccessUnit(*waiting, picture))
+    return Step::PAIR;
+  return IsBase(*waiting, baseId) ? Step::ALONE_THEN_KEEP : Step::REPLACE;
+}
+
+//! When no more pictures come: whether the picture that waits goes out alone (a base view)
+inline bool AloneAtEnd(const std::optional<View>& waiting, int baseId)
+{
+  return waiting && IsBase(*waiting, baseId);
+}
+
+//! Whether the base view goes in the left half of the picture of the two
+inline bool BaseOnLeft(BaseEye eye)
+{
+  return eye == BaseEye::LEFT;
+}
+
+//! The picture of the two views
+struct Packed
+{
+  int width{0};
+  int height{0};
+  int sarNum{1};
+  int sarDen{1};
+
+  bool operator==(const Packed&) const = default;
+};
+
+/*!
+ * \brief The size and the shape of the pixels of the picture that holds both views side by side
+ *
+ * It is twice as wide, and its pixels are half as wide as those of a view: shown at its whole
+ * width it has the shape of one view, which is what a picture with both eyes side by side is
+ * taken to be (each half is stretched over the whole width). A view whose width is not a whole
+ * number of chroma samples cannot be placed at the right, and one of no size or beyond what a
+ * picture can be is not packed either.
+ *
+ * \param chromaShift the binary logarithm of the horizontal subsampling of the chroma planes
+ */
+inline std::optional<Packed> PackedPicture(
+    int width, int height, int sarNum, int sarDen, int chromaShift)
+{
+  constexpr int LARGEST = 16384;
+  if (width <= 0 || height <= 0 || width > LARGEST || height > LARGEST)
+    return std::nullopt;
+  if (chromaShift < 0 || chromaShift > 4 || (width & ((1 << chromaShift) - 1)))
+    return std::nullopt;
+
+  // unknown: square
+  if (sarNum <= 0 || sarDen <= 0)
+    sarNum = sarDen = 1;
+  if (sarDen > std::numeric_limits<int>::max() / 2)
+    return std::nullopt;
+
+  Packed packed;
+  packed.width = width * 2;
+  packed.height = height;
+  const int divisor = std::gcd(sarNum, sarDen * 2);
+  packed.sarNum = sarNum / divisor;
+  packed.sarDen = sarDen * 2 / divisor;
+  return packed;
+}
+
+//! @}
+
+/*!
+ * \name Giving the second view up
+ * @{
+ */
+
+//! Base views gone out alone, with none ever paired, after which the stream is taken to have
+//! no second view that this decoder gives (ten seconds of film)
+inline constexpr unsigned int ALONE_UNTIL_GIVEN_UP = 240;
+
+//! Packets in a row that the decoder refused, after which it is taken not to work on the stream
+inline constexpr unsigned int REFUSED_UNTIL_GIVEN_UP = 48;
+
+/*!
+ * \brief Whether the stream goes back to the decoder of every other stream, for its base view
+ *
+ * Not for a second view that is missing for a while once it has been there (a damaged part, the
+ * pictures after a seek that wait for the next one that starts from nothing): then the base
+ * view goes out alone and the second one is taken again when it comes. Only when it never came,
+ * or when the decoder takes nothing: such a stream plays as it did before, with what that
+ * decoder has (hardware decoding).
+ */
+inline bool GiveUp(uint64_t paired, uint64_t alone, unsigned int refusedInARow)
+{
+  return (paired == 0 && alone >= ALONE_UNTIL_GIVEN_UP) || refusedInARow >= REFUSED_UNTIL_GIVEN_UP;
+}
+
+//! @}
+
+} // namespace MULTIVIEW
+} // namespace KODI
