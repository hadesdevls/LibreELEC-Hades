From 6f31989fba2ef8f381c400343df04413138d4e91 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 9 Oct 2026 15:35:26 +0100
Subject: [PATCH] TCPServer: don't hold the connections lock while a request
 runs

Since 7c57431393 Announce takes m_connectionsCritSection, which Process
also held while a request ran. A method that waits on the main thread,
like XBMC.GetInfoBooleans, could then hang Kodi for good: the main thread
waits for the announcement lock in AddAnnouncer (a window's list
provider), and the announce thread holds it while Announce waits for the
connections lock.

With Announce now able to run alongside a request, the client lock is
held for a whole message, so an announcement can't land inside a
response, and it guards the announcement flags SetConfiguration writes.
---
 xbmc/network/TCPServer.cpp | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/xbmc/network/TCPServer.cpp b/xbmc/network/TCPServer.cpp
index 6ffc739..c59ca35 100644
--- a/xbmc/network/TCPServer.cpp
+++ b/xbmc/network/TCPServer.cpp
@@ -179,7 +179,16 @@ void CTCPServer::Process()
             }
 
             if (response.empty())
-              m_connections[i]->PushBuffer(this, buffer, nread);
+            {
+              // Don't hold the lock while a request runs. A method that waits on the
+              // main thread would block Announce, which holds the announcement lock
+              // the main thread may be waiting for. Only this thread removes
+              // connections, so the client stays valid.
+              CTCPClient* client = m_connections[i];
+              lock.unlock();
+              client->PushBuffer(this, buffer, nread);
+              lock.lock();
+            }
 
             close = m_connections[i]->Closing();
           }
@@ -556,16 +565,18 @@ int CTCPServer::CTCPClient::GetAnnouncementFlags()
 
 bool CTCPServer::CTCPClient::SetAnnouncementFlags(int flags)
 {
+  std::unique_lock lock(m_critSection);
   m_announcementflags = flags;
   return true;
 }
 
 void CTCPServer::CTCPClient::Send(const char *data, unsigned int size)
 {
+  // Announce can send from another thread, so a message goes out whole
+  std::unique_lock lock(m_critSection);
   unsigned int sent = 0;
   do
   {
-    std::unique_lock lock(m_critSection);
     sent += send(m_socket, data + sent, size - sent, 0);
   } while (sent < size);
 }
