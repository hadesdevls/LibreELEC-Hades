From 64496dfe3619d0e6196a8b5d9c3cd798fdd6a97f Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 4 Oct 2026 09:03:29 +0100
Subject: [PATCH] [RetroPlayer] Give shader passes their real texture size

A pass scaled to the viewport renders to a texture truncated to whole
pixels, but its shaders were told the fractional size. crt-royale tiles
its phosphor mask from those sizes, so the mask drifted across each tile
and showed seams.
---
 xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
index 4d6a2e6..ee2ad1b 100644
--- a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
@@ -17,6 +17,8 @@
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
+#include <cmath>
+
 using namespace KODI::SHADER;
 
 CShaderPreset::CShaderPreset(RETRO::CRenderContext& context,
@@ -233,6 +235,11 @@ void CShaderPreset::CalculateScaledSize(const KODI::SHADER::ShaderPass& pass,
           pass.fbo.scaleY.scale != 0.0f ? pass.fbo.scaleY.scale * prevSize.y : prevSize.y;
       break;
   }
+
+  // The pass renders to a texture of whole pixels, so its shaders must be
+  // given that size rather than a fractional one
+  scaledSize.x = std::floor(scaledSize.x);
+  scaledSize.y = std::floor(scaledSize.y);
 }
 
 void CShaderPreset::DisposeShaders()
