From 43d7171c0c1aedaa68432502731103e198576ddc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 07:29:10 +0000
Subject: [PATCH] ActiveAESink: the log line of the sink names the output, and
 tells passthrough

The line that says what the sink opened, which Hades writes without
debugging ("ALSA is open for PCM: 2 channels (FL, FR) at 48000 Hz,
AE_FMT_S32NE (...)"), ended in "('Device not found')" for every output,
on every machine of the test of 2026-10-21. The friendly name is looked
up in the list of outputs by the device name, and Kodi looked it up again
after the sink had opened, by the device as the sink gives it back:
CAESinkFactory::Create() replaces it with what the sink opened, and ALSA
returns snd_pcm_name(), "hdmi:CARD=Generic,DEV=0,AES0=0x04,AES1=0x82,
AES2=0x00,AES3=0x02" (or "surround51:CARD=..." for "@"), which is no name
of that list. The name found before the sink opened, of the output that
was opened (the configured one, or the first output it fell back to,
which sets its own), now stays. m_deviceFriendlyName is read only by this
line and by the "Output Device" line of the debug log, which said the
same since the code came from Kodi.

The same line told passthrough as PCM ("ALSA is open for PCM: 8 channels
(RAW, RAW, ...) at 192000 Hz, AE_FMT_S16NE") because it asked the format
that the sink opened, and the sink packs passthrough as PCM: it now asks
the format that was requested, and says the stream type, the channels of
the IEC 61937 frames and their rate ("ALSA is open for passthrough:
STREAM_TYPE_TRUEHD, in 8 channels at 192000 Hz ('HDA NVidia')").

Not changed: the device of the sink itself keeps the name that the sink
gave back. CActiveAESink::NeedIECPacking() then finds no output of that
name and answers yes, which every ALSA output answers anyway
(m_wantsIECPassthrough), and CActiveAE keeps it as the opened device for
the decisions on a change of the count of outputs, which ALSA does not
send.
---
 .../Engines/ActiveAE/ActiveAESink.cpp         | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index d343114..80cf78c 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -1169,8 +1169,11 @@ void CActiveAESink::OpenSink()
   }
 
   m_device = device;
-  const AESinkDevice openedDevice = CAESinkFactory::ParseDevice(m_device);
-  GetDeviceFriendlyName(openedDevice.name);
+  // Hades: the friendly name stays that of the output that was opened, found above by its name in
+  // the list of outputs. The sink gives back the device as it opened it (ALSA:
+  // "hdmi:CARD=NVidia,DEV=0,AES0=0x06,AES1=0x82,AES2=0x00,AES3=0x09"; "surround51:CARD=..." for
+  // "@"), which is no name of that list: looked up again by it, every output that ALSA opened was
+  // "Device not found".
 
   m_sink->SetVolume(m_volume);
 
@@ -1201,11 +1204,14 @@ void CActiveAESink::OpenSink()
   CLog::Log(LOGDEBUG, "  Frames        : {}", m_sinkFormat.m_frames);
   CLog::Log(LOGDEBUG, "  Frame Size    : {}", m_sinkFormat.m_frameSize);
   // Hades: what goes out, also without debugging: how many channels of PCM a display was sent is
-  // what tells why it is silent with a track that Kodi decodes
-  if (m_sinkFormat.m_dataFormat == AE_FMT_RAW)
-    CLog::LogF(LOGINFO, "{} is open for passthrough: {} at {} Hz ('{}')", m_sink->GetName(),
-               CAEUtil::StreamTypeToStr(m_sinkFormat.m_streamInfo.m_type),
-               m_sinkFormat.m_sampleRate, m_deviceFriendlyName);
+  // what tells why it is silent with a track that Kodi decodes. Passthrough is told by the format
+  // that was asked for: the sink packs it as PCM (ALSA: S16, the IEC 61937 frames in 2 or 8
+  // channels), so the format it opened is no longer AE_FMT_RAW.
+  if (passthrough)
+    CLog::LogF(LOGINFO, "{} is open for passthrough: {}, in {} channels at {} Hz ('{}')",
+               m_sink->GetName(), CAEUtil::StreamTypeToStr(m_requestedFormat.m_streamInfo.m_type),
+               m_sinkFormat.m_channelLayout.Count(), m_sinkFormat.m_sampleRate,
+               m_deviceFriendlyName);
   else
     CLog::LogF(LOGINFO, "{} is open for PCM: {} channels ({}) at {} Hz, {} ('{}')", m_sink->GetName(),
                m_sinkFormat.m_channelLayout.Count(), (std::string)m_sinkFormat.m_channelLayout,
