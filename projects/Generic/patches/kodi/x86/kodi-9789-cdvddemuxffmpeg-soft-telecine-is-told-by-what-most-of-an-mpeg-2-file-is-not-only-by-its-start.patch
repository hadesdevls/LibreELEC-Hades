From 7199c8ac64cc9dfac7c4c3f54413017335161404 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:23:39 +0000
Subject: [PATCH] CDVDDemuxFFmpeg: soft telecine is told by what most of an
 MPEG-2 file is, not only by its start

PrefetchForSoftTelecine() decided from the first second of the file. A rip of
a DVD that begins with a logo or an intro in interlaced video and is film after
it was therefore played whole at 59.94 Hz with the 3:2 cadence, as if nothing
had been looked at; and a file that begins with a stretch of film and is video
after it was played whole at 23.976 Hz.

Where the sequence can carry 2:3 pulldown (30000/1001 or 30, not progressive),
points further in the file are now read with a handle of their own (the input
of libavformat is left where it is), headers only, no decoding
(KODI::MPEG2::SampleFile()): the middle first, and where it says what the start
said that is the stream; otherwise 10 % and 75 % too, and the majority of the
points decides (MajorityOf()). The video of a program stream (VOB, MPG) is
taken out of its packets (ProgramStreamVideo()); an elementary stream and
Matroska are read as they are. Over the internet, where each point would be a
request of its own, and after 1.5 s, the start decides as before. The decision
is made before the first picture, once: the mode is chosen once for the file.
kodi.log says what the start and each point said, and what was read in how
long.

Measured on the host (local files, warm cache): a file whose middle says what
its start says reads one point, 1 to 1.3 MiB in 4 or 5 reads, 4 to 8 ms; a
file with an intro reads three, 3.75 MiB in 15 reads, 14 to 26 ms. Files of 5
and 10 s of video before 2 min of film (elementary stream, VOB, Matroska) are
film; 8 s of film before 2 min of video is video; films and videos of the
corpus are told as before. A majority that never decides leaves the intros as
video and the film starts as film (13 files wrong).

Over the network the cost is what is read, once, when the file opens: about
1 MiB for a file whose middle says what its start says, about 3.75 MiB for one
with an intro or mixed; on a LAN at 1 Gbit some 15 and 45 ms, at 100 Mbit some
115 and 370 ms, on a Wi-Fi of some 50 Mbit some 220 and 700 ms. The 0.4 to
0.7 s are only for a file with an intro or mixed on a slow network, which is
where the choice matters: the other ways were to lose it there, or to change
the display mode after the start, a blackout at the start of the film.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            |  96 ++++++++-
 .../DVDDemuxers/Mpeg2SoftTelecine.h           | 189 ++++++++++++++++++
 2 files changed, 276 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 6144a8e..624f547 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -2030,6 +2030,73 @@ void CDVDDemuxFFmpeg::ClearPrefetched()
   m_prefetched.clear();
 }
 
+namespace
+{
+const char* VerdictName(KODI::MPEG2::CSoftTelecineDetector::Verdict verdict)
+{
+  return verdict == KODI::MPEG2::CSoftTelecineDetector::Verdict::FILM       ? "film"
+         : verdict == KODI::MPEG2::CSoftTelecineDetector::Verdict::NOT_FILM ? "not film"
+                                                                            : "not told";
+}
+
+// Hades: points of the file further on (KODI::MPEG2::SampleFile()), read with a handle of their own
+// (the input of libavformat is left where it is), headers only, no decoding; not over the internet,
+// where each point costs a request of its own: there the start of the file decides
+KODI::MPEG2::CSoftTelecineDetector::Verdict SampleForSoftTelecine(
+    const std::string& path,
+    bool programStream,
+    KODI::MPEG2::CSoftTelecineDetector::Verdict start,
+    int frameRateCode,
+    int& filmRateCode,
+    std::string& said,
+    const std::function<bool()>& aborted)
+{
+  using namespace KODI::MPEG2;
+  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
+  if (URIUtils::IsInternetStream(path))
+    return start;
+  XFILE::CFile file;
+  if (!file.Open(path, XFILE::READ_TRUNCATED | XFILE::READ_NO_CACHE))
+    return start;
+  const int64_t length = file.GetLength();
+  const auto begin = std::chrono::steady_clock::now();
+  const FileSamples samples = SampleFile(
+      length, programStream, frameRateCode, start,
+      [&file](int64_t offset, size_t size, std::vector<uint8_t>& out)
+      {
+        if (file.Seek(offset, SEEK_SET) != offset)
+          return false;
+        const size_t before = out.size();
+        out.resize(before + size);
+        size_t got = 0;
+        while (got < size)
+        {
+          const ssize_t r = file.Read(out.data() + before + got, size - got);
+          if (r <= 0)
+            break;
+          got += static_cast<size_t>(r);
+        }
+        out.resize(before + got);
+        return got > 0;
+      },
+      [begin, &aborted]
+      { return std::chrono::steady_clock::now() - begin > MAX_TIME || aborted(); });
+  file.Close();
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - begin)
+                      .count();
+  const CSoftTelecineDetector::Verdict verdict = MajorityOf(start, samples.verdicts);
+  if (verdict == CSoftTelecineDetector::Verdict::FILM && samples.filmFrameRateCode &&
+      start != CSoftTelecineDetector::Verdict::FILM)
+    filmRateCode = samples.filmFrameRateCode;
+  for (size_t i = 0; i < samples.verdicts.size(); ++i)
+    said += StringUtils::Format("; at {:.0f} %: {}", SAMPLE_POINTS[i] * 100.0,
+                                VerdictName(samples.verdicts[i]));
+  said += StringUtils::Format(" ({} KiB read in {} ms)", samples.bytes / 1024, ms);
+  return verdict;
+}
+} // namespace
+
 // Hades: a film on a DVD or from one is MPEG-2 with soft telecine: pictures coded at 23.976 per
 // second
 // that carry the flags to be shown at 29.97 (repeat_first_field on every second one). Kodi showed
@@ -2101,12 +2168,23 @@ void CDVDDemuxFFmpeg::PrefetchForSoftTelecine()
   }
   m_timeout.SetInfinite();
   // (only the groups of pictures that are complete: the last one is cut where the reading stopped)
-  const CSoftTelecineDetector::Verdict verdict = detector.GetVerdict();
+  const CSoftTelecineDetector::Verdict start = detector.GetVerdict();
+  int filmRateCode = detector.FilmFrameRateCode();
 
+  // Hades: a file whose start is not what the rest of it is (a logo or an intro in video before
+  // the film, a film that begins a video) is told by what most of it is: points further on are
+  // read, for a sequence that can carry 2:3 pulldown (30000/1001 or 30, not progressive)
+  CSoftTelecineDetector::Verdict verdict = start;
   int rate = 0;
   int scale = 0;
-  if (verdict == CSoftTelecineDetector::Verdict::FILM &&
-      FilmRateOf(detector.FilmFrameRateCode(), rate, scale))
+  std::string points;
+  if (FilmRateOf(detector.FrameRateCode(), rate, scale) && !progressiveSequence)
+    verdict = SampleForSoftTelecine(
+        m_pInput->GetFileName(), strcmp(m_pFormatContext->iformat->name, "mpeg") == 0, start,
+        detector.FrameRateCode(), filmRateCode, points,
+        [this] { return m_abortRequested || (m_cancelCheck && m_cancelCheck()); });
+
+  if (verdict == CSoftTelecineDetector::Verdict::FILM && FilmRateOf(filmRateCode, rate, scale))
   {
     video->iFpsRate = rate;
     video->iFpsScale = scale;
@@ -2114,17 +2192,17 @@ void CDVDDemuxFFmpeg::PrefetchForSoftTelecine()
     video->softTelecine = true;
     CLog::Log(LOGINFO,
               "CDVDDemuxFFmpeg: stream {} is MPEG-2 video with soft telecine (the pictures of a "
-              "film at {:.3f} that carry the flags to be shown at {:.3f}, as seen in its first {} "
-              "pictures): each is shown once, at the pace of the film",
+              "film at {:.3f} that carry the flags to be shown at {:.3f}; its first {} pictures: "
+              "{}{}): each is shown once, at the pace of the film",
               index, static_cast<double>(rate) / scale, static_cast<double>(rate) * 1.25 / scale,
-              detector.Count());
+              detector.Count(), VerdictName(start), points);
   }
   else
   {
     CLog::Log(LOGDEBUG,
-              "CDVDDemuxFFmpeg: stream {} is MPEG-2 video that does not show soft telecine in its "
-              "first {} pictures: shown as the stream says",
-              index, detector.Count());
+              "CDVDDemuxFFmpeg: stream {} is MPEG-2 video that does not show soft telecine (its "
+              "first {} pictures: {}{}): shown as the stream says",
+              index, detector.Count(), VerdictName(start), points);
   }
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/Mpeg2SoftTelecine.h b/xbmc/cores/VideoPlayer/DVDDemuxers/Mpeg2SoftTelecine.h
index 4fdccea..0d1e9a8 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/Mpeg2SoftTelecine.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/Mpeg2SoftTelecine.h
@@ -321,4 +321,193 @@ private:
   int m_filmFrameRateCode = 0;
 };
 
+// ---------------------------------------------------------------------------------------------
+// Points of a file further on: a file whose start is not what the rest is (a logo or an intro in
+// video before the film) is told by what most of it is
+// ---------------------------------------------------------------------------------------------
+
+/*!
+ * \brief The video elementary stream in a stretch of an MPEG program stream that starts anywhere
+ *        (a VOB or an MPG read at a point of its own): the payload of the PES packets of the first
+ *        video stream met (0xE0 to 0xEF), from the first pack header on, in MPEG-2 PES packets; a
+ *        packet cut by the end of the stretch is left out
+ */
+inline std::vector<uint8_t> ProgramStreamVideo(const uint8_t* data, size_t size)
+{
+  std::vector<uint8_t> video;
+  int id = 0;
+  size_t i = 0;
+  while (i + 4 <= size &&
+         (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1 || data[i + 3] != 0xBA))
+    ++i;
+  while (i + 4 <= size)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+    {
+      ++i; // (not where a pack or a packet starts: found again at the next start code)
+      continue;
+    }
+    const uint8_t code = data[i + 3];
+    if (code == 0xBA) // pack header: MPEG-2 (14 bytes and its stuffing) or MPEG-1 (12 bytes)
+    {
+      if (i + 14 > size)
+        break;
+      if ((data[i + 4] & 0xC0) == 0x40)
+        i += 14 + (data[i + 13] & 0x07);
+      else if ((data[i + 4] & 0xF0) == 0x20)
+        i += 12;
+      else
+        i += 4;
+      continue;
+    }
+    if (code < 0xBB) // the end of the program stream, or no packet of it
+    {
+      i += 4;
+      continue;
+    }
+    if (i + 6 > size)
+      break;
+    const size_t end = i + 6 + ((static_cast<size_t>(data[i + 4]) << 8) | data[i + 5]);
+    if (end > size)
+      break;
+    if (code >= 0xE0 && code <= 0xEF && (id == 0 || id == code) && i + 9 <= end &&
+        (data[i + 6] & 0xC0) == 0x80)
+    {
+      id = code;
+      const size_t payload = i + 9 + data[i + 8];
+      if (payload < end)
+        video.insert(video.end(), data + payload, data + end);
+    }
+    i = end;
+  }
+  return video;
+}
+
+/*!
+ * \brief What a stretch of video elementary stream read at a point of its own says: its pictures
+ *        from its first sequence header or group of pictures on (those before are of a group whose
+ *        start was not read), in the groups that are complete
+ * \param frameRateCode the one of the stream where the stretch has no sequence header (0: none)
+ * \param filmFrameRateCode set to the frame_rate_code of the film where it is film
+ */
+inline CSoftTelecineDetector::Verdict SampleVerdict(const std::vector<uint8_t>& video,
+                                                    int frameRateCode,
+                                                    int& filmFrameRateCode,
+                                                    size_t* pictures = nullptr)
+{
+  CSoftTelecineDetector detector;
+  detector.SetFrameRateCode(frameRateCode);
+  bool progressiveSequence = false;
+  std::vector<PictureFlags> found;
+  ParsePictures(video.data(), video.size(), progressiveSequence, found);
+  bool started = false;
+  for (const PictureFlags& picture : found)
+  {
+    started = started || picture.groupStart;
+    if (started)
+      detector.Add(picture);
+  }
+  if (pictures)
+    *pictures = detector.Count();
+  filmFrameRateCode = detector.FilmFrameRateCode();
+  return detector.GetVerdict();
+}
+
+/*!
+ * \brief The verdict of a stream from the one of its start and those of points further in it: the
+ *        points that tell, by majority; the start where fewer than two tell or as many say one as
+ *        the other (and where the first point said what the start said, FirstPointAgrees())
+ */
+inline CSoftTelecineDetector::Verdict MajorityOf(
+    CSoftTelecineDetector::Verdict start, const std::vector<CSoftTelecineDetector::Verdict>& points)
+{
+  int film = 0;
+  int notFilm = 0;
+  for (const CSoftTelecineDetector::Verdict verdict : points)
+  {
+    film += verdict == CSoftTelecineDetector::Verdict::FILM;
+    notFilm += verdict == CSoftTelecineDetector::Verdict::NOT_FILM;
+  }
+  if (film + notFilm < 2 || film == notFilm)
+    return start;
+  return film > notFilm ? CSoftTelecineDetector::Verdict::FILM
+                        : CSoftTelecineDetector::Verdict::NOT_FILM;
+}
+
+//! \brief What the points of a file further on said (SampleFile())
+struct FileSamples
+{
+  //! one for each point read, in the order of SAMPLE_POINTS
+  std::vector<CSoftTelecineDetector::Verdict> verdicts;
+  int filmFrameRateCode = 0; //!< of a point that was film
+  size_t bytes = 0; //!< read in all
+  unsigned reads = 0; //!< reads made (each a seek too)
+};
+
+//! \brief Where in a file (or a title of a disc) the points are read, as parts of its length: the
+//!        middle first, which ends it where it says what the start said (FirstPointAgrees())
+inline constexpr double SAMPLE_POINTS[] = {0.50, 0.10, 0.75};
+
+//! \brief The first point says what the start said: the stream is that, and the other points are
+//!        not read (what most files are: film from the start, or video)
+inline bool FirstPointAgrees(CSoftTelecineDetector::Verdict start,
+                             const std::vector<CSoftTelecineDetector::Verdict>& points)
+{
+  return points.size() == 1 && start != CSoftTelecineDetector::Verdict::UNKNOWN &&
+         points.front() == start;
+}
+
+/*!
+ * \brief Reads points of a file further on (SAMPLE_POINTS: 50 %, then 10 and 75 % of its length
+ *        where the middle does not say what the start said) and tells for each whether its video
+ *        is film with soft telecine: 256 KiB at a time, up to 2 MiB a point, and no more once the
+ *        point tells
+ * \param length the length of the file in bytes
+ * \param programStream the file is an MPEG program stream (VOB, MPG): its video is taken out of
+ *        its packets (ProgramStreamVideo()); otherwise the bytes are read as they are (an
+ *        elementary stream, Matroska, whose blocks hold the pictures whole)
+ * \param frameRateCode the one of the stream (0: not known), for a point with no sequence header
+ * \param start what the start of the file said
+ * \param read bool(int64_t offset, size_t size, std::vector<uint8_t>& out): appends what is at
+ *        offset (less at the end of the file), false where it could not
+ * \param stop called before each read: true to give up (the points not read do not tell)
+ */
+template<class Read, class Stop>
+FileSamples SampleFile(int64_t length,
+                       bool programStream,
+                       int frameRateCode,
+                       CSoftTelecineDetector::Verdict start,
+                       Read&& read,
+                       Stop&& stop)
+{
+  static constexpr size_t STEP = 256 * 1024;
+  static constexpr size_t MAX_POINT = 2 * 1024 * 1024;
+  FileSamples samples;
+  for (const double point : SAMPLE_POINTS)
+  {
+    if (FirstPointAgrees(start, samples.verdicts))
+      break;
+    CSoftTelecineDetector::Verdict verdict = CSoftTelecineDetector::Verdict::UNKNOWN;
+    std::vector<uint8_t> bytes;
+    const int64_t offset = static_cast<int64_t>(static_cast<double>(length) * point);
+    while (bytes.size() < MAX_POINT && length > 0)
+    {
+      const size_t before = bytes.size();
+      if (stop() || !read(offset + static_cast<int64_t>(before), STEP, bytes))
+        break;
+      ++samples.reads;
+      samples.bytes += bytes.size() - before;
+      int film = 0;
+      verdict =
+          SampleVerdict(programStream ? ProgramStreamVideo(bytes.data(), bytes.size()) : bytes,
+                        frameRateCode, film);
+      if (verdict == CSoftTelecineDetector::Verdict::FILM)
+        samples.filmFrameRateCode = film;
+      if (verdict != CSoftTelecineDetector::Verdict::UNKNOWN || bytes.size() < before + STEP)
+        break; // (told, or the end of the file)
+    }
+    samples.verdicts.push_back(verdict);
+  }
+  return samples;
+}
 } // namespace KODI::MPEG2
-- 
