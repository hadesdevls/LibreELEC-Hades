From 60fad18d92acab3c1d073da8cb8635879c30a9ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:34:45 +0000
Subject: [PATCH] OverlayRenderer: no plane offset where the video is shown as
 one picture

CRenderer::SubtitleDepth() shifts a subtitle by the plane offset that a Blu-ray
3D title gives whenever the eye being drawn is not RenderStereoView::OFF. In
the mono view of a 3D video ("Play as 2D", RenderStereoMode::MONO)
CApplication::Render() draws the GUI once, as the left eye. The subtitle of a
title that places its subtitles in depth was then shifted by the left eye's
offset, scaled to the screen, on a flat picture: off its place by up to a few
dozen pixels and moving with the depth the title asks for, where before it sat
where its bitmap says. GetStereoscopicDepth(), which answers for the setting,
already gives 0 in mono and without 3D output.

Give 0 in the same cases for the title's offset: without 3D output and in the
mono view. What a 3D view draws does not change.
---
 .../VideoPlayer/VideoRenderers/OverlayRenderer.cpp    | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
index 6895930..8090a5a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -309,8 +309,15 @@ float CRenderer::SubtitleDepth() const
   if (*m_subtitlePlaneOffset == 0 || m_rs.Width() <= 0.0f)
     return 0.0f;
 
-  const RenderStereoView view{CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoView()};
-  if (view == RenderStereoView::OFF)
+  // Hades: no depth where the video is shown as one picture, as GetStereoscopicDepth() has it
+  // for the setting: without 3D output, and in the mono view of a 3D video, which draws the left
+  // eye's view alone (CApplication::Render()) and would otherwise shift the subtitle by that
+  // eye's offset on a flat picture.
+  CGraphicContext& context{CServiceBroker::GetWinSystem()->GetGfxContext()};
+  const RenderStereoMode mode{context.GetStereoMode()};
+  const RenderStereoView view{context.GetStereoView()};
+  if (view == RenderStereoView::OFF || mode == RenderStereoMode::MONO ||
+      mode == RenderStereoMode::OFF)
     return 0.0f;
 
   // The plane is drawn over the video and the offset is in the video's pixels, so the two
