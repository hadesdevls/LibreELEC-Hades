+
+#pragma once
+
+#include <array>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The expert settings of native Dolby Vision output (System > Display, "Dolby Vision
+ *        engine"), with what advancedsettings.xml says, as one native output takes them
+ *
+ * Every setting is read when native output starts and holds until it ends: a video never changes
+ * its way of drawing, its pace or its picture because a setting was changed while it played. Each
+ * one is automatic by default, which is how native output worked before there were settings for
+ * it. The overrides of advancedsettings.xml keep working as they did: <dvaheadalways> turns "when
+ * needed" into "always" (not "never", which the user chose), <dvstepdown> sets the level whatever
+ * the setting says, and <dvkeeprepeats>false and <dvccmcomposer>false turn those off.
+ *
+ * The automatic choices of the window system (the way of drawing, CDVPathChoice; the fidelity
+ * step-down, CDVStepDown) keep what they find, in the session and for later ones. They are not to
+ * keep what was found while a setting made the frames other work than they choose: with the way of
+ * drawing set, CDVPathChoice measures nothing (CDVPathChoice::SetMode()), and CDVStepDown, whose
+ * windows are of a way, measures on a copy that is dropped when the output ends; with a level set,
+ * CDVStepDown is not asked at all, and CDVPathChoice measures on a copy; with libplacebo's
+ * composition both do (see CDVLearned).
+ */
+struct CDVEngineSettings
+{
+  //! videoscreen.hadesdvpathmode: the way a frame without GUI elements is drawn
+  enum class Path
+  {
+    AUTOMATIC = 0, //!< measured for each picture format (CDVPathChoice)
+    DIRECT = 1,
+    COMPOSED = 2,
+  };
+  //! videoscreen.hadesdvaheadmode: frames presented a frame ahead (CDVAhead)
+  enum class Ahead
+  {
+    NEEDED = 0, //!< where the frames take a large part of the refresh period
+    ALWAYS = 1,
+    NEVER = 2,
+  };
+  //! videoscreen.hadesdvstepmode: the fidelity step-down (CDVStepDown)
+  enum class Step
+  {
+    AUTOMATIC = 0, //!< where the GPU cannot keep up
+    NEVER = 1, //!< the faithful picture always
+    LEVEL_1 = 2, //!< that level for every frame
+    LEVEL_2 = 3,
+    LEVEL_3 = 4,
+  };
+  //! videoscreen.hadesdvcomposer: how the picture is composed from its layers
+  enum class Composer
+  {
+    SPECIFICATION = 0, //!< as the composer of ETSI GS CCM 001 composes it
+    LIBPLACEBO = 1, //!< libplacebo's own reshaping
+  };
+
+  static constexpr int STEP_LEVELS = 4; //!< CDVStepDown::LEVELS, DVBRIDGE_STEP_LEVELS
+
+  //! What the settings hold (a value that is none of the options counts as the default)
+  struct Read
+  {
+    int path = 0;
+    int ahead = 0;
+    int step = 0;
+    int composer = 0;
+    bool keepRepeats = true;
+  };
+  //! What advancedsettings.xml says (its defaults: nothing)
+  struct Advanced
+  {
+    bool aheadAlways = false; //!< video/dvaheadalways
+    int stepDown = -1; //!< video/dvstepdown, 0 to 3; -1: not given
+    bool keepRepeats = true; //!< video/dvkeeprepeats
+    bool ccmComposer = true; //!< video/dvccmcomposer
+  };
+
+  Path path = Path::AUTOMATIC;
+  Ahead ahead = Ahead::NEEDED;
+  //! the level that every frame is drawn at (-1: none), by the setting or by advancedsettings.xml
+  int stepForced = -1;
+  //! without a level set: whether Kodi lowers the fidelity where the GPU cannot keep up
+  bool stepAutomatic = true;
+  bool ccmComposer = true;
+  bool keepRepeats = true;
+  // what advancedsettings.xml decided, for the log
+  bool aheadByAdvanced = false;
+  bool stepByAdvanced = false;
+  bool composerByAdvanced = false;
+  bool keepRepeatsByAdvanced = false;
+
+  bool operator==(const CDVEngineSettings&) const = default;
+
+  static CDVEngineSettings Resolve(const Read& read, const Advanced& advanced)
+  {
+    CDVEngineSettings s;
+    s.path = read.path == 1 ? Path::DIRECT : read.path == 2 ? Path::COMPOSED : Path::AUTOMATIC;
+    // (as before: "never" is the user's, and <dvaheadalways> only makes "when needed" "always")
+    if (read.ahead == static_cast<int>(Ahead::NEVER))
+      s.ahead = Ahead::NEVER;
+    else if (read.ahead == static_cast<int>(Ahead::ALWAYS))
+      s.ahead = Ahead::ALWAYS;
+    else if (advanced.aheadAlways)
+    {
+      s.ahead = Ahead::ALWAYS;
+      s.aheadByAdvanced = true;
+    }
+    s.stepAutomatic = read.step != static_cast<int>(Step::NEVER);
+    if (advanced.stepDown >= 0 && advanced.stepDown < STEP_LEVELS)
+    {
+      s.stepForced = advanced.stepDown;
+      s.stepByAdvanced = true;
+    }
+    else if (read.step >= static_cast<int>(Step::LEVEL_1) &&
+             read.step <= static_cast<int>(Step::LEVEL_3))
+      s.stepForced = read.step - static_cast<int>(Step::LEVEL_1) + 1;
+    s.ccmComposer = read.composer != static_cast<int>(Composer::LIBPLACEBO) && advanced.ccmComposer;
+    s.composerByAdvanced = !advanced.ccmComposer;
+    s.keepRepeats = read.keepRepeats && advanced.keepRepeats;
+    s.keepRepeatsByAdvanced = !advanced.keepRepeats;
+    return s;
+  }
+
+  //! Nothing is set: native output as it works without these settings
+  bool Automatic() const { return *this == CDVEngineSettings(); }
+
+  //! What CDVPathChoice measures in this output is kept: not with a level set (other work at a
+  //! level that the automatic step-down would not have chosen) or with libplacebo's composition.
+  //! (With the way set it measures nothing: CDVPathChoice::SetMode().)
+  bool PathKept() const { return stepForced < 0 && ccmComposer; }
+  //! What CDVStepDown measures in this output is kept: not with the way of drawing set (its windows
+  //! are of a way that the automatic choice might not take) or with libplacebo's composition
+  bool StepKept() const { return path == Path::AUTOMATIC && ccmComposer; }
+
+  //! For the log
+  std::string Describe() const
+  {
+    std::string text = "drawing path ";
+    text += path == Path::DIRECT     ? "always direct"
+            : path == Path::COMPOSED ? "always composed"
+                                     : "automatic";
+    text += "; frames a frame ahead ";
+    text += ahead == Ahead::ALWAYS  ? "always"
+            : ahead == Ahead::NEVER ? "never"
+                                    : "when needed";
+    if (aheadByAdvanced)
+      text += " (advancedsettings.xml: dvaheadalways)";
+    text += "; fidelity step-down ";
+    if (stepForced >= 0)
+      text += "level " + std::to_string(stepForced) +
+              (stepByAdvanced ? " (advancedsettings.xml: dvstepdown)" : "");
+    else
+      text += stepAutomatic ? "automatic" : "never";
+    text += "; composition ";
+    text += ccmComposer ? "as ETSI GS CCM 001 composes" : "libplacebo's reshaping";
+    if (composerByAdvanced)
+      text += " (advancedsettings.xml: dvccmcomposer)";
+    text += "; repeated pictures ";
+    text += keepRepeats ? "kept on the screen" : "drawn again";
+    if (keepRepeatsByAdvanced)
+      text += " (advancedsettings.xml: dvkeeprepeats)";
+    if (!PathKept() || !StepKept())
+      text += "; nothing that is measured in this video is kept";
+    return text;
+  }
+
+  /*!
+   * \brief The settings that were booleans before (videoscreen.hadesdvahead,
+   *        videoscreen.hadesdvstepdown) and their place in the settings that took them over
+   *        (videoscreen.hadesdvaheadmode, videoscreen.hadesdvstepmode)
+   *
+   * The boolean is kept, hidden, with the value that an earlier build would read from it: on
+   * for every mode but "never". A boolean that is off while the new setting is at its default
+   * (never set, or set back to it, which turns the boolean on again) was saved by a build
+   * without the new setting: the new one becomes "never". So a user's choice survives the update
+   * to this build, and the way back to an earlier one.
+   */
+  static int AheadFromOld(bool on) { return static_cast<int>(on ? Ahead::NEEDED : Ahead::NEVER); }
+  static bool AheadToOld(int mode) { return mode != static_cast<int>(Ahead::NEVER); }
+  static int StepFromOld(bool on) { return static_cast<int>(on ? Step::AUTOMATIC : Step::NEVER); }
+  static bool StepToOld(int mode) { return mode != static_cast<int>(Step::NEVER); }
+
+  struct Migration
+  {
+    int mode = 0; //!< the new setting
+    bool old = true; //!< the boolean
+    bool modeChanged = false;
+    bool oldChanged = false;
+  };
+  //! When the settings are loaded: what the two are to be. \param deflt the default of the new one
+  static Migration Migrate(int mode, int deflt, bool old, int (*fromOld)(bool), bool (*toOld)(int))
+  {
+    Migration m;
+    m.mode = mode == deflt && old != toOld(deflt) ? fromOld(old) : mode;
+    m.old = toOld(m.mode);
+    m.modeChanged = m.mode != mode;
+    m.oldChanged = m.old != old;
+    return m;
+  }
+};
+
+/*!
+ * \brief What an automatic choice of native output knows for frames without (0) and with (1) an
+ *        enhancement layer, and the copy that a native output measures on when what it finds is
+ *        not to be kept (CDVEngineSettings::PathKept(), StepKept())
+ *
+ * The copy starts as what is known when the output begins (Begin()), so that its frames are drawn
+ * as they would be anyway, and is dropped when it ends (End()): what is kept never sees them.
+ */
+template<typename T>
+class CDVLearned
+{
+public:
+  //! A native output begins: on a copy of what is known, or on it
+  void Begin(bool onCopy)
+  {
+    m_onCopy = onCopy;
+    if (onCopy)
+      m_copy = m_kept;
+  }
+  //! ... and ends: what was found on the copy is dropped
+  void End()
+  {
+    m_onCopy = false;
+    m_copy = {};
+  }
+  //! What the frames of this output are decided and measured with
+  std::array<T, 2>& Now() { return m_onCopy ? m_copy : m_kept; }
+  const std::array<T, 2>& Now() const { return m_onCopy ? m_copy : m_kept; }
+  //! What is known for good (recalled from earlier sessions, and kept for later ones)
+  std::array<T, 2>& Kept() { return m_kept; }
+  const std::array<T, 2>& Kept() const { return m_kept; }
+  bool OnCopy() const { return m_onCopy; }
+
+private:
+  std::array<T, 2> m_kept{};
+  std::array<T, 2> m_copy{};
+  bool m_onCopy = false;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
