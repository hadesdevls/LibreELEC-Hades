+// When the settings are loaded, before they count as loaded (nothing is told of what changes):
+// what a user chose in an earlier build is taken over, and the booleans are what the new settings
+// say. Returns whether anything changed (then the settings are saved at once).
+bool MigrateDVEngine(CSettingsManager& manager)
+{
+  bool changed = false;
+  for (const auto& m : DV_ENGINE_MIGRATIONS)
+  {
+    const auto mode = std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(m.mode));
+    const auto old = std::dynamic_pointer_cast<CSettingBool>(manager.GetSetting(m.old));
+    if (!mode || !old)
+      continue;
+    const auto step = CDVEngineSettings::Migrate(mode->GetValue(), mode->GetDefault(),
+                                                 old->GetValue(), m.fromOld, m.toOld);
+    if (step.modeChanged && mode->SetValue(step.mode))
+    {
+      changed = true;
+      CLog::Log(LOGINFO,
+                "CSettings: \"{}\" takes over \"{}\" (off), which an earlier build saved: {}",
+                m.mode, m.old, step.mode);
+    }
+    if (step.oldChanged && old->SetValue(step.old))
+      changed = true;
+  }
