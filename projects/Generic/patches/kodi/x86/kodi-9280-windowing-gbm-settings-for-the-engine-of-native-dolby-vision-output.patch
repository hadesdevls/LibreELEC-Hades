+struct DVEngineMigration
+{
+  const char* mode;
+  const char* old;
+  int (*fromOld)(bool);
+  bool (*toOld)(int);
+};
+constexpr DVEngineMigration DV_ENGINE_MIGRATIONS[] = {
+    {CSettings::SETTING_VIDEOSCREEN_HADESDVAHEADMODE, CSettings::SETTING_VIDEOSCREEN_HADESDVAHEAD,
+     CDVEngineSettings::AheadFromOld, CDVEngineSettings::AheadToOld},
+    {CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE, CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPDOWN,
