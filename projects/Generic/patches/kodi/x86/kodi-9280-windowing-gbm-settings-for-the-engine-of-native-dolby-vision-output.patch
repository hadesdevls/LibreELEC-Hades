-// Hades: the composer of the Dolby Vision picture, ETSI GS CCM 001 unless advancedsettings.xml asks
-// for libplacebo's own reshaping: <video><dvccmcomposer>false</dvccmcomposer></video>
+// Hades: the composer of the Dolby Vision picture, as UseComposer() asked: ETSI GS CCM 001 unless
+// the setting (videoscreen.hadesdvcomposer) or advancedsettings.xml asks for libplacebo's own
+// reshaping (<video><dvccmcomposer>false</dvccmcomposer></video>). Logged when it changes the
+// renderer's.
 void CDVBridgeGLES::UseComposerSetting()
 {
-  const auto settings = CServiceBroker::GetSettingsComponent();
-  if (!m_renderer || !settings || settings->GetAdvancedSettings()->m_videoDVCCMComposer)
+  if (!m_renderer || dvbridge_render_ccm_composer(m_renderer) == m_ccmComposer)
     return;
-  dvbridge_render_use_ccm_composer(m_renderer, false);
-  CLog::Log(LOGINFO, "DVBridge: the picture is composed by libplacebo's reshaping, not as ETSI GS "
-                     "CCM 001 composes it, as advancedsettings.xml asks (dvccmcomposer)");
+  dvbridge_render_use_ccm_composer(m_renderer, m_ccmComposer);
+  CLog::Log(LOGINFO,
+            "DVBridge: the picture is composed {}, as the settings ask "
+            "(videoscreen.hadesdvcomposer, or dvccmcomposer in advancedsettings.xml)",
+            m_ccmComposer ? "as ETSI GS CCM 001 composes it"
+                          : "by libplacebo's reshaping, not as ETSI GS CCM 001 composes it");
+}
+
+void CDVBridgeGLES::UseComposer(bool ccm)
+{
+  m_ccmComposer = ccm;
+  UseComposerSetting();
 }
 
