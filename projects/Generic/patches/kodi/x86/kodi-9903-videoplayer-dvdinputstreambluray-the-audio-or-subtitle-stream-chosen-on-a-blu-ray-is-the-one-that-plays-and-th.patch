+void CVideoPlayer::TellDiscStreamChoice(
+    StreamType type, int64_t demuxerId, int id, int source, bool visible)
+{
+#if defined(HAVE_LIBBLURAY)
+  // Hades: the disc's choice is what IsBetterStream() opens, packet after packet: a stream chosen
+  // here without it would give way to the disc's at the next packet of that one. So the stream the
+  // player plays from now on is the one kept there, and the disc is told, as a player's own menu
+  // tells it: its program and the play items after this one keep it, until the disc or the user
+  // chooses again (each choice reaches the player in the order it was made)
+  if (!m_pInputStream || !m_pInputStream->IsStreamType(DVDSTREAM_TYPE_BLURAY) || !m_pDemuxer ||
+      STREAM_SOURCE_MASK(source) != STREAM_SOURCE_DEMUX)
+    return;
+  const CDemuxStream* stream = m_pDemuxer->GetStream(demuxerId, id);
+  if (!stream || stream->type != type || stream->dvdNavId <= 0)
+    return;
+  const auto bluray = std::static_pointer_cast<CDVDInputStreamBluray>(m_pInputStream);
+  if (type == StreamType::AUDIO)
+  {
+    m_dvd.iSelectedAudioStream = stream->dvdNavId;
+    bluray->SelectAudioStream(stream->dvdNavId);
+  }
+  else if (type == StreamType::SUBTITLE)
+  {
+    m_dvd.iSelectedSPUStream = stream->dvdNavId;
+    bluray->SelectSubtitleStream(stream->dvdNavId, visible);
+  }
+#endif
+}
+
+void CVideoPlayer::TellDiscDefaultStreams()
+{
+#if defined(HAVE_LIBBLURAY)
+  // Hades: a playlist played directly: the streams Kodi opened for it by its own preferences (and
+  // the user's choice for this file) are the ones it plays, not the ones libbluray chose by language
+  // alone; a subtitle stream Kodi left closed is not opened by itself either
+  if (!m_pInputStream || !m_pInputStream->IsStreamType(DVDSTREAM_TYPE_BLURAY))
+    return;
+  if (m_CurrentAudio.id >= 0)
+    TellDiscStreamChoice(StreamType::AUDIO, m_CurrentAudio.demuxerId, m_CurrentAudio.id,
+                         m_CurrentAudio.source, true);
+  if (m_CurrentSubtitle.id >= 0)
+    TellDiscStreamChoice(StreamType::SUBTITLE, m_CurrentSubtitle.demuxerId, m_CurrentSubtitle.id,
+                         m_CurrentSubtitle.source, m_VideoPlayerVideo->IsSubtitleEnabled());
+  else
+    m_dvd.iSelectedSPUStream = -1;
+#endif
+}
+
 void CVideoPlayer::Prepare()
 {
   // a new file: whether its video is progressive, and its display mode, are chosen again
@@ -3804,6 +3856,8 @@ void CVideoPlayer::HandleMessages()
         }
         else if (!st.IsCurrent(m_CurrentAudio))
         {
+          // Hades: (on a Blu-ray, the disc's choice gives way to this one, and the disc is told)
+          TellDiscStreamChoice(StreamType::AUDIO, st.demuxerId, st.id, st.source, true);
           CloseStream(m_CurrentAudio, false);
           OpenStream(m_CurrentAudio, st.demuxerId, st.id, st.source);
           AdaptForcedSubtitles();
@@ -3901,6 +3955,9 @@ void CVideoPlayer::HandleMessages()
         }
         else if (!st.IsCurrent(m_CurrentSubtitle) || m_CurrentSubtitle.demuxDisabled)
         {
+          // Hades: (on a Blu-ray, the disc's choice gives way to this one, and the disc is told)
+          TellDiscStreamChoice(StreamType::SUBTITLE, st.demuxerId, st.id, st.source,
+                               m_VideoPlayerVideo->IsSubtitleEnabled());
           // a stream disabled in the demuxer is only enabled again by a reopen
           ReopenSubtitleStream(st);
         }
@@ -3932,6 +3989,11 @@ void CVideoPlayer::HandleMessages()
 
       SetSubtitleVisibleInternal(isVisible);
 
+      // Hades: (on a Blu-ray, the disc is told whether the subtitles show, with their stream)
