 }
 
+int CDVDInputStreamBluray::StreamNumberOf(int pid, const BLURAY_STREAM_INFO* streams, int count)
+{
+  for (int i = 0; streams && i < count; ++i)
+  {
+    if (streams[i].pid == static_cast<uint16_t>(pid))
+      return i + 1;
+  }
+  return 0;
+}
+
+void CDVDInputStreamBluray::SelectAudioStream(int pid)
+{
+  if (!m_bd)
+    return;
+  // (from the thread that plays, while the one of the application may take the events of a key)
+  std::unique_lock lock(m_eventLock);
+  m_userAudioPid = pid;
+  // the play item that libbluray plays is m_clip, unless an event that changes it waits: one held
+  // for NextStream() with the menus, or one left for the thread that reads (TakeUserInputEvents());
+  // then the choice is told when that play item is known (ProcessEvent(), BD_EVENT_PLAYITEM)
+  if (m_event.event == BD_EVENT_NONE && !(m_navmode && m_hold == HOLD_HELD))
+    TellUserChoice();
+}
+
+void CDVDInputStreamBluray::SelectSubtitleStream(int pid, bool visible)
+{
+  if (!m_bd)
+    return;
+  std::unique_lock lock(m_eventLock);
+  m_userPgPid = pid;
+  m_userPgVisible = visible;
+  if (m_event.event == BD_EVENT_NONE && !(m_navmode && m_hold == HOLD_HELD))
+    TellUserChoice();
+}
+
+void CDVDInputStreamBluray::TellUserChoice()
+{
+  if (!m_bd || !m_titleInfo || !m_clip)
+    return;
+
+  // bd_select_stream() writes the register as a menu of the disc does; libbluray tells the change
+  // with its own events (BD_EVENT_AUDIO_STREAM, BD_EVENT_PG_TEXTST_STREAM, BD_EVENT_PG_TEXTST), which
+  // give the player the stream it already plays
+  if (m_userAudioPid >= 0)
+  {
+    const int pid = m_userAudioPid;
+    m_userAudioPid = -1;
+    const int number = StreamNumberOf(pid, m_clip->audio_streams, m_clip->audio_stream_count);
+    if (number > 0)
+    {
+      const int told =
+          bd_select_stream(m_bd, BLURAY_AUDIO_STREAM, static_cast<uint32_t>(number), 1);
+      CLog::Log(told == 0 ? LOGDEBUG : LOGINFO,
+                "CDVDInputStreamBluray - the audio stream the player chose (PID 0x{:x}) is told to "
+                "the disc: stream number {}{}",
+                pid, number,
+                told > 0    ? ""
+                : told == 0 ? " (the disc had it already, or does not let it be changed now)"
+                            : " (libbluray did not take it)");
+    }
+    else
+      CLog::Log(LOGINFO,
+                "CDVDInputStreamBluray - the audio stream the player chose (PID 0x{:x}) is not in "
+                "the stream number table of play item {}: the disc is not told",
+                pid, m_playItem.load());
+  }
+
+  if (m_userPgPid >= 0)
+  {
+    const int pid = m_userPgPid;
+    m_userPgPid = -1;
+    const int number = StreamNumberOf(pid, m_clip->pg_streams, m_clip->pg_stream_count);
+    if (number > 0)
+    {
+      const int told = bd_select_stream(m_bd, BLURAY_PG_TEXTST_STREAM,
+                                        static_cast<uint32_t>(number), m_userPgVisible ? 1 : 0);
+      CLog::Log(told == 0 ? LOGDEBUG : LOGINFO,
+                "CDVDInputStreamBluray - the subtitle stream the player chose (PID 0x{:x}, {}) is "
+                "told to the disc: stream number {}{}",
+                pid, m_userPgVisible ? "shown" : "hidden", number,
+                told > 0    ? ""
+                : told == 0 ? " (the disc had it already, or does not let it be changed now)"
+                            : " (libbluray did not take it)");
+    }
+    else
+      CLog::Log(LOGINFO,
+                "CDVDInputStreamBluray - the subtitle stream the player chose (PID 0x{:x}) is not "
+                "in the stream number table of play item {}: the disc is not told",
+                pid, m_playItem.load());
+  }
+}
+
 void CDVDInputStreamBluray::ProcessEvent() {
 
   int pid = -1;
@@ -801,6 +895,9 @@ void CDVDInputStreamBluray::ProcessEvent() {
                              : std::string("none in this play item"));
         m_player->OnDiscNavResult(static_cast<void*>(&pgPid), BD_EVENT_PG_TEXTST_STREAM);
       }
+      // Hades: ... and a choice of the player's made while this play item was not known yet is told
+      // to the disc now, after it (the last choice is the one that stays)
+      TellUserChoice();
       // Hades: a playlist played directly goes on its own timeline (BlurayTitleTime.h). Each
       // join is told with the step between the two clocks that this puts away.
       if (!m_navmode && m_event.param > 0)
