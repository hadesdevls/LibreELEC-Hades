+/* Hades: the picture stays within [0, 1]: a floating-point target does not clamp what is
+ * written to it. */
+static struct pl_hook_res clamp_picture(void *priv, const struct pl_hook_params *p)
+{
+    bool *called = priv;
+    static const struct pl_custom_shader shader = {
+        .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+        .body = "color = clamp(color, 0.0, 1.0);",
+        .description = "DV picture within the range of an HDR10 output"};
+    *called = p->stage == PL_HOOK_OUTPUT && pl_shader_custom(p->sh, &shader);
+    return (struct pl_hook_res){.failed = !*called, .output = PL_HOOK_SIG_NONE};
+}
+
+static bool view_fits(struct dvbridge_view view, const struct pl_frame *source, int width,
+                      int height)
+{
+    return view.dst_width > 0 && view.dst_height > 0 && view.dst_x >= 0 && view.dst_y >= 0 &&
+           view.dst_x <= width - view.dst_width && view.dst_y <= height - view.dst_height &&
+           isfinite(view.src_x0) && isfinite(view.src_y0) && isfinite(view.src_x1) &&
+           isfinite(view.src_y1) && view.src_x1 - view.src_x0 >= 1 &&
+           view.src_y1 - view.src_y0 >= 1 && view.src_x0 >= source->crop.x0 &&
+           view.src_y0 >= source->crop.y0 && view.src_x1 <= source->crop.x1 &&
+           view.src_y1 <= source->crop.y1;
+}
+
+static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *source,
+                         const void *metadata, size_t bytes, double pts, double el_pts,
+                         struct dvbridge_view view, int width, int height)
+{
+    if (!source || !isfinite(pts) || width < 1 || height < 1 || width > 16384 || height > 16384 ||
+        source->num_planes < 1 || source->num_planes > 4 || source->rotation ||
+        !view_fits(view, source, width, height))
+        return false;
+    for (int p = 0; p < source->num_planes; ++p)
+        if (!source->planes[p].texture)
+            return false;
+    const struct pl_frame *el = source->enhancement_layer;
+    if (el) {
+        if (el->num_planes < 1 || el->num_planes > 4 || el->rotation || el->enhancement_layer)
+            return false;
+        for (int p = 0; p < el->num_planes; ++p)
+            if (!el->planes[p].texture)
+                return false;
+    }
+    bool paired = el && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
+    struct dvbridge_color mapped;
+    if (!dvbridge_map_color(&mapped, metadata, bytes, paired, &r->residual_omitted))
+        return false;
+    /* The format of the picture that the transport is packed from. A half-float one would be half
+     * the memory, and it is not as good: stored in one by a software renderer, the picture came
+     * out up to half a code of 1023 below this one (the values were cut off, not rounded). */
+    if (!r->hdr10 || r->hdr10->params.w != width || r->hdr10->params.h != height) {
+        r->hdr10_whole = false;
+        pl_fmt fmt = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 4, 32, 32,
+                                 PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+        if (!fmt || !pl_tex_recreate(r->gpu, &r->hdr10, pl_tex_params(.w = width, .h = height,
+                .format = fmt, .sampleable = true, .renderable = true)))
+            return false;
+    }
+    struct pl_frame image = *source;
+    mapped.repr.bits = source->repr.bits;
+    mapped.repr.alpha = source->repr.alpha;
+    image.repr = mapped.repr;
+    image.color = mapped.color;
+    image.profile = (struct pl_icc_profile){0};
+    image.icc = NULL;
+    image.lut = NULL;
+    image.crop = (pl_rect2df){view.src_x0, view.src_y0, view.src_x1, view.src_y1};
+    /* The same colour space on both sides: the picture is reconstructed and not mapped. */
+    struct pl_frame target = {
+        .num_planes = 1,
+        .planes = {{.texture = r->hdr10, .components = 4, .component_mapping = {0, 1, 2, 3}}},
+        .repr = pl_color_repr_rgb,
+        .color = mapped.color,
+        .crop = {view.dst_x, view.dst_y, view.dst_x + view.dst_width, view.dst_y + view.dst_height},
+    };
+    struct pl_render_params params = pl_render_default_params;
+    params.min_fbo_precision = 32;
+    params.peak_detect_params = NULL;
+    params.dither_params = NULL;
+    params.frame_mixer = NULL;
+    params.skip_caching_single_frame = true;
+    params.border = PL_CLEAR_SKIP;
+    bool clamped = false;
+    const struct pl_hook hook = {
+        .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &clamped,
+        .hook = clamp_picture, .signature = 0x4456424844523130ULL};
+    const struct pl_hook *hooks[] = {&hook};
+    params.hooks = hooks;
+    params.num_hooks = 1;
+    /* from here on the texture may hold a part of this picture over the one before it */
+    r->hdr10_whole = false;
+    bool ok = pl_render_image(r->renderer, &image, &target, &params) && clamped;
+    struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
+    r->hdr10_whole = ok && !errors.errors && !errors.num_disabled_hooks;
+    return r->hdr10_whole;
+}
+
+bool dvbridge_render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *source,
+                          const void *metadata, size_t bytes, double pts, double el_pts,
+                          struct dvbridge_view view, int width, int height)
+{
+    if (!r)
+        return false;
+    r->hdr10_ready = false;
+    r->residual_omitted = false;
+    /* errors left by earlier, unrelated GL work are not ours, as in dvbridge_render_rgb() */
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct saved_gl_state state;
+    save_gl_state(&state);
+    r->hdr10_ready = render_hdr10(r, source, metadata, bytes, pts, el_pts, view, width, height);
+    restore_gl_state(&state);
+    return r->hdr10_ready;
+}
+
+pl_tex dvbridge_render_hdr10_texture(const struct dvbridge_renderer *r)
+{
+    return r && r->hdr10_ready ? r->hdr10 : NULL;
+}
+
+pl_tex dvbridge_render_hdr10_last(const struct dvbridge_renderer *r)
+{
+    return r && r->hdr10_whole ? r->hdr10 : NULL;
+}
