From 36d0dd02c834ff979d85fed65577572c8141e5f0 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Thu, 8 Oct 2026 13:22:33 +0200
Subject: [PATCH] [pvr] Channel group thumbs: Skip channels without icon

The "icon" art of a channel item falls back to a skin default image if
the channel has no icon. These images cannot be loaded by the tiled
thumb generator, leaving black gaps in the channel group thumbnail. Use
the "thumb" art instead, which contains only the channel's real icon.
---
 xbmc/pvr/PVRChannelGroupImageFileLoader.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp b/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
index 66ce85a..9a78020 100644
--- a/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
+++ b/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
@@ -34,7 +34,7 @@ std::unique_ptr<CTexture> PVR::CPVRChannelGroupImageFileLoader::Load(
   std::vector<std::string> channelIcons;
   for (const auto& channel : channels)
   {
-    const std::string& icon = channel->GetArt("icon");
+    const std::string& icon = channel->GetArt("thumb");
     if (!icon.empty())
       channelIcons.emplace_back(IMAGE_FILES::CImageFileURL(icon).GetTargetFile());
 
