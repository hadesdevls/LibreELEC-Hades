+  if (labelId >= 39848 && labelId <= 39851)
+    return CGUIUtils::GetHadesString(labelId, 31980 + (labelId - 39848));
   // native output, and Dolby Vision as HDR10 mapped to the display: labels, help, values
   if (labelId >= 39830 && labelId <= 39847)
     return CGUIUtils::GetHadesString(labelId, 31770 + (labelId - 39830));
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index 06a9037..24f7e72 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -89,6 +89,10 @@ public:
   //! \brief Video of more than 8 bits can go out through an output of floating-point components
   //! here: the setting for it is shown.
   virtual bool SupportsFloatOutput() const { return false; }
+  //! \brief Hades: the driver of the output takes the choice of HDR in YCbCr 4:2:0 at 10 bits
+  //! where RGB would be 8 bits (the connector property DVBRIDGE_HDR_YCBCR420): the setting for it
+  //! is shown.
+  virtual bool SupportsHDRYCbCr420Choice() const { return false; }
   /*!
    * \brief Whether the picture that is presented is somewhere else than in the window framebuffer
    *
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 2be254c..e54e05a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -16,6 +16,7 @@
 #include "dialogs/GUIDialogKaiToast.h"
 #include "drm/DRMAtomic.h"
 #include "drm/DRMDisplayWatch.h"
+#include "drm/DVBridgeLink.h"
 #ifdef HAVE_DVBRIDGE
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "drm/DVBridgeRefused.h"
@@ -210,6 +211,8 @@ bool CWinSystemGbm::InitWindowSystem()
 #endif
 
   CDRMConnector* connector = m_DRM->GetConnector();
+  // Hades: the driver of this output takes the choice of HDR in YCbCr 4:2:0 (SetHDR())
+  m_hdrYCbCr420Choice = connector && connector->SupportsProperty(DVBRIDGE::LINK::HDR_YCBCR420);
   if (connector)
   {
     std::vector<uint8_t> edid = connector->GetEDID();
@@ -2144,6 +2147,18 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
     if (m_hdrBlob.IsValid())
       DropEndedStereoInfoFrame();
 
+    // Hades: ... and, where the driver takes it (i915 and amdgpu with the Hades patches), the
+    // choice of the user for HDR where RGB would be 8 bits: YCbCr 4:2:0 at 10 bits ("deep", the
+    // driver's default) or RGB at 8 ("never"). It acts only with HDR metadata, and the driver keeps
+    // it with the connector's state: it is set with each video, as the setting is then.
+    if (m_hdrBlob.IsValid() && connector->SupportsProperty(DVBRIDGE::LINK::HDR_YCBCR420))
+    {
+      const bool rgb = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESHDR420) == 1;
+      if (const auto value =
+              connector->GetPropertyEnumValue(DVBRIDGE::LINK::HDR_YCBCR420, rgb ? "never" : "deep"))
+        drm->AddProperty(connector, DVBRIDGE::LINK::HDR_YCBCR420, *value);
+    }
+
     drm->AddProperty(connector, "HDR_OUTPUT_METADATA", m_hdrBlob.Get());
     drm->SetActive(true);
