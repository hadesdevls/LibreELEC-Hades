+ */
+
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+/*
+ * Hades: what the driver says the HDMI link carries, and the choice of HDR in YCbCr 4:2:0, from
+ * i915 and amdgpu with the Hades patches (the kernel's drm_dvbridge_hdr.h):
+ * - DVBRIDGE_LINK_FORMAT, a read-only bitmask connector property: the answer to a request of the
+ *   HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR, asked in a TEST_ONLY commit), one bit for the
+ *   format of the configuration that was checked and one for its bits per component;
+ * - DVBRIDGE_HDR_YCBCR420, an enum: "deep" (HDR in YCbCr 4:2:0 at 10 bits or more where RGB would
+ *   carry fewer, the driver's default) or "never".
+ * Pure: a test builds it on the host, with the names of the kernel header.
+ */
+namespace DVBRIDGE::LINK
+{
+constexpr const char* PROPERTY = "DVBRIDGE_LINK_FORMAT";
+constexpr const char* HDR_YCBCR420 = "DVBRIDGE_HDR_YCBCR420";
+
+struct Format
+{
+  std::string format; //!< "rgb", "ycbcr444", "ycbcr422" or "ycbcr420"; empty: not said
+  unsigned int bpc = 0; //!< bits per component, 6 to 16; 0: not said
+  bool Known() const { return !format.empty() && bpc != 0; }
+};
+
+//! The format and the depth in the names the kernel gave: one of each, or nothing (not known)
+inline Format Parse(const std::vector<std::string>& names)
+{
+  Format found;
+  unsigned int formats = 0;
+  unsigned int depths = 0;
+  for (const std::string_view name : names)
+  {
+    if (name == "rgb" || name == "ycbcr444" || name == "ycbcr422" || name == "ycbcr420")
+    {
+      found.format = name;
+      formats++;
+      continue;
+    }
+    // "6bpc" ... "16bpc"
+    if (name.size() < 4 || name.size() > 5 || !name.ends_with("bpc"))
+      continue;
+    unsigned int bpc = 0;
+    bool digits = true;
+    for (const char c : name.substr(0, name.size() - 3))
+    {
+      digits = digits && c >= '0' && c <= '9';
+      bpc = bpc * 10 + static_cast<unsigned int>(c - '0');
+    }
+    if (!digits || bpc < 6 || bpc > 16 || bpc % 2)
+      continue;
+    found.bpc = bpc;
+    depths++;
+  }
+  if (formats != 1 || depths != 1)
+    return {};
+  return found;
+}
+
+//! The format as the player information shows it: "RGB", "YCbCr 4:2:0"...; empty for none
+inline std::string DisplayName(std::string_view format)
+{
+  if (format == "rgb")
+    return "RGB";
+  if (format == "ycbcr444")
+    return "YCbCr 4:4:4";
+  if (format == "ycbcr422")
+    return "YCbCr 4:2:2";
+  if (format == "ycbcr420")
+    return "YCbCr 4:2:0";
+  return "";
+}
+} // namespace DVBRIDGE::LINK
