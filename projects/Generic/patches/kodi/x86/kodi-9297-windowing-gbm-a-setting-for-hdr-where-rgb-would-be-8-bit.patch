diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index b13491d..f4a7dd4 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3310,6 +3310,26 @@
         <default>true</default>
         <control type="toggle" />
       </setting>
+      <setting id="videoscreen.hadeshdr420" type="integer" label="39848" help="39849">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="supportshdrycbcr420"/>
+        </dependencies>
+        <level>3</level>
+        <default>0</default> <!-- 10-bit YCbCr 4:2:0 -->
+        <constraints>
+          <options>
+            <option label="39850">0</option> <!-- 10-bit YCbCr 4:2:0 -->
+            <option label="39851">1</option> <!-- 8-bit RGB -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
+      </setting>
       <setting id="videoscreen.hadesdvnative" type="boolean" label="39830" help="39831">
         <requirement>
           <and>
diff --git a/xbmc/settings/SettingConditions.cpp b/xbmc/settings/SettingConditions.cpp
index 534d80d..4547ecb 100644
--- a/xbmc/settings/SettingConditions.cpp
+++ b/xbmc/settings/SettingConditions.cpp
@@ -145,6 +145,15 @@ bool SupportsFloatOutput(const std::string& /*condition*/,
   return winSystem && winSystem->SupportsFloatOutput();
 }
 
+// Hades: the setting of HDR where RGB would be 8 bits, where the driver of the output takes it
+bool SupportsHDRYCbCr420Choice(const std::string& /*condition*/,
+                               const std::string& /*value*/,
+                               const SettingConstPtr& /*setting*/)
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  return winSystem && winSystem->SupportsHDRYCbCr420Choice();
+}
+
 bool IsMasterUser(const std::string& /*condition*/,
                   const std::string& /*value*/,
                   const SettingConstPtr& /*setting*/)
@@ -474,6 +483,7 @@ void CSettingConditions::Initialize()
   m_complexConditions.try_emplace("supportsdolbyvision", SupportsDolbyVision);
   m_complexConditions.try_emplace("ishdrdisplay", IsHDRDisplay);
   m_complexConditions.try_emplace("supportsfloatoutput", SupportsFloatOutput);
+  m_complexConditions.try_emplace("supportshdrycbcr420", SupportsHDRYCbCr420Choice);
   m_complexConditions.try_emplace("ismasteruser", IsMasterUser);
   m_complexConditions.try_emplace("hassubtitlesfontextensions", HasSubtitlesFontExtensions);
   m_complexConditions.try_emplace("profilecanwritedatabase", ProfileCanWriteDatabase);
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 35e93a7..f3a0d35 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -405,6 +405,9 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESGUIWHITE = "videoscreen.hadesguiwhite";
   //! Video of more than 8 bits through a half-float output where there is no 10-bit one (NVIDIA)
   static constexpr auto SETTING_VIDEOSCREEN_HADESFLOATOUTPUT = "videoscreen.hadesfloatoutput";
+  //! Hades: HDR where RGB would be 8 bits: 0 in YCbCr 4:2:0 at 10 bits (the default), 1 in RGB
+  //! at 8 bits (the connector property DVBRIDGE_HDR_YCBCR420 of i915 and amdgpu)
+  static constexpr auto SETTING_VIDEOSCREEN_HADESHDR420 = "videoscreen.hadeshdr420";
   //! Dolby Vision that is not sent natively: reconstructed and sent as HDR10 when its base
   //! layer is no picture by itself (profile 5) ...
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVASHDR10 = "videoscreen.hadesdvashdr10";
