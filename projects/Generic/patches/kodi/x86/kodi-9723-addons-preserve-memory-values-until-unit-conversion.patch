From e832e0d3b232f5ad3302f9d627a346650207a62b Mon Sep 17 00:00:00 2001
From: kontell <kontell@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:26:30 +0100
Subject: [PATCH] [addons] Preserve memory values until unit conversion

Convert memory counters before narrowing and preserve the failure result
when memory status is unavailable. Keep the add-on ABI unchanged.

Clarify the bytes-mode limit and bump the general API patch version for
the SDK documentation change.
---
 xbmc/addons/interfaces/General.cpp               | 15 ++++++++++-----
 xbmc/addons/kodi-dev-kit/include/kodi/General.h  |  3 +++
 xbmc/addons/kodi-dev-kit/include/kodi/versions.h |  2 +-
 3 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/xbmc/addons/interfaces/General.cpp b/xbmc/addons/interfaces/General.cpp
index aa488e0..8083b0a 100644
--- a/xbmc/addons/interfaces/General.cpp
+++ b/xbmc/addons/interfaces/General.cpp
@@ -29,6 +29,8 @@
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 
+#include <algorithm>
+#include <limits>
 #include <string.h>
 
 using namespace kodi; // addon-dev-kit namespace
@@ -252,15 +254,18 @@ void Interface_General::get_free_mem(void* kodiBase, long* free, long* total, bo
     return;
   }
 
-  KODI::MEMORY::MemoryStatus stat;
+  KODI::MEMORY::MemoryStatus stat{};
   KODI::MEMORY::GetMemoryStatus(&stat);
-  *free = static_cast<long>(stat.availPhys);
-  *total = static_cast<long>(stat.totalPhys);
+  if (stat.totalPhys == 0)
+    return;
+
   if (!as_bytes)
   {
-    *free = *free / ( 1024 * 1024 );
-    *total = *total / ( 1024 * 1024 );
+    stat.availPhys /= 1024 * 1024;
+    stat.totalPhys /= 1024 * 1024;
   }
+  *free = static_cast<long>(std::min<uint64_t>(stat.availPhys, std::numeric_limits<long>::max()));
+  *total = static_cast<long>(std::min<uint64_t>(stat.totalPhys, std::numeric_limits<long>::max()));
 }
 
 int Interface_General::get_global_idle_time(void* kodiBase)
diff --git a/xbmc/addons/kodi-dev-kit/include/kodi/General.h b/xbmc/addons/kodi-dev-kit/include/kodi/General.h
index d4c8222..ef39396 100644
--- a/xbmc/addons/kodi-dev-kit/include/kodi/General.h
+++ b/xbmc/addons/kodi-dev-kit/include/kodi/General.h
@@ -351,6 +351,9 @@ inline std::string ATTR_DLL_LOCAL GetRegion(const std::string& id)
 /// @brief Returns the amount of free memory in MByte (or as bytes) as an long
 /// integer
 ///
+/// In bytes mode on platforms with a 32-bit long (Windows and 32-bit Android/Linux),
+/// values of 2 GiB or more are capped at LONG_MAX. Use the default MB mode for larger values.
+///
 /// @param[out] free free memory
 /// @param[out] total total memory
 /// @param[in] asBytes [opt] if set to true becomes returned as bytes, otherwise
diff --git a/xbmc/addons/kodi-dev-kit/include/kodi/versions.h b/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
index 0169038..b9b2fd9 100644
--- a/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
+++ b/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
@@ -44,7 +44,7 @@
                                                       "addon-instance/" \
                                                       "c-api/addon_base.h"
 
-#define ADDON_GLOBAL_VERSION_GENERAL                  "1.0.5"
+#define ADDON_GLOBAL_VERSION_GENERAL                  "1.0.6"
 #define ADDON_GLOBAL_VERSION_GENERAL_MIN              "1.0.4"
 #define ADDON_GLOBAL_VERSION_GENERAL_XML_ID           "kodi.binary.global.general"
 #define ADDON_GLOBAL_VERSION_GENERAL_DEPENDS          "General.h"
-- 
2.53.0

