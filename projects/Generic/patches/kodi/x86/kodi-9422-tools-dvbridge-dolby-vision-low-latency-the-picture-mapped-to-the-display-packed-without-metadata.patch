     bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
+    /* Hades: Low-Latency is drawn the composed way only (dvbridge_render_set_low_latency()) */
+    if (packed && r->low_latency)
+        return false;
     struct dvbridge_color mapped;
     if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
     r->residual_drawn = paired && mapped.dovi.nlq_active;
     /* Hades: the transport of this picture: as certified source devices send it, where that
-     * covers the picture (render_source()); else converted to BT.2020, below */
+     * covers the picture (render_source()); else converted to BT.2020, below (always so for
+     * Low-Latency: the picture is the one mapped to the display) */
     r->geometry = geometry;
     r->source = false;
-    if (source_possible(r, source, metadata, bytes, geometry) && source_planes(r, source)) {
+    if (!r->low_latency && source_possible(r, source, metadata, bytes, geometry) &&
+        source_planes(r, source)) {
         bool composed = false;
         if (render_source(r, source, metadata, bytes, pts, geometry, mapped, packed, flip, early,
                           &composed)) {
@@ -816,8 +894,18 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                                        3840 - margins[1], 2160 - margins[3]}};
     mask.flip = flip;
     mask.packets = dvbridge_packets(r->pending, &mask.count);
+    /* Hades: Low-Latency: mapped to the display (as dvbridge_render_hdr10() maps a picture with the
+     * same mapping) and within its peak; the test pattern covers the raster, bars too */
+    struct pl_color_map_params ll_color;
+    if (r->low_latency) {
+        map_to_display(&r->ll_mapping, &image.color, &target.color, &ll_color);
+        params.color_map_params = &ll_color;
+        mask.low_latency = true;
+        mask.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->ll_mapping.peak);
+        mask.pattern = r->ll_pattern;
+    }
     /* Only a picture that is not scaled is one shader from its planes to the target. */
-    mask.early_mask = early &&
+    mask.early_mask = early && !mask.pattern &&
                       geometry.source_width == 3840 && geometry.source_height == 2160 &&
                       !geometry.x && !geometry.y &&
