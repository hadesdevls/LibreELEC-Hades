 }
 
+static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer, int width,
+                 int height, const uint32_t packets[512], unsigned count, bool flip);
+
 bool dvbridge_gl_pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer,
                      int width, int height, const uint32_t packets[512], unsigned count, bool flip)
 {
     /* (16 packets of 32 words: dvbridge_packets()) */
     if (!p || !texture || !packets || !count || count > 16 || width != 3840 || height != 2160)
         return false;
+    return pack(p, texture, framebuffer, width, height, packets, count, flip);
+}
+
+bool dvbridge_gl_pack_no_metadata(struct dvbridge_gl_packer *p, unsigned texture,
+                                  unsigned framebuffer, int width, int height, bool flip)
+{
+    static const uint32_t none[512];
+    if (!p || !texture || width != 3840 || height != 2160)
+        return false;
+    return pack(p, texture, framebuffer, width, height, none, 0, flip);
+}
+
+static bool pack(struct dvbridge_gl_packer *p, unsigned texture, unsigned framebuffer, int width,
+                 int height, const uint32_t packets[512], unsigned count, bool flip)
+{
     /* Errors left by earlier, unrelated GL work are not ours: clear them (bounded), so that the
      * checks below see only what the pack raised. */
     for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
