+    float target_xy[8];
 };
 /* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
- * one in the gamut BT.709 only). */
+ * one in the gamut BT.709 only; Hades: one of DVBRIDGE_HDR10_GAMUT_CUSTOM to HDR10 only, with a
+ * target_xy that is a gamut inside BT.2020). */
 bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m);
 /* Hades: the mapping of a picture to an SDR output: on, to DVBRIDGE_SDR_WHITE, in BT.709, with the
