 };
 
 /* Hades: the area outside the active picture is written at the start of the shader, which a
@@ -219,12 +227,75 @@ static struct pl_hook_res pack_active_area(void *priv, const struct pl_hook_para
     return (struct pl_hook_res){.failed=mask->failed, .output=PL_HOOK_SIG_NONE};
 }
 
+/* Hades: the test pattern of Low-Latency (dvbridge_render_set_ll_pattern()), in the converted
+ * transport's own terms: PQ R'G'B' in BT.2020 that it packs as BT.2020 YCbCr of the narrow range at
+ * 12 bits (Y = 256 + 3504 Y', C = 2048 + 3584 (B' or R' - Y') / 1.8814 or 1.4746). The staircases are
+ * given by their codes: a grey of luma code n is n - 256 over 3504 in all three channels; a chroma
+ * code next to luma code 1536 is that luma with the one difference of its channel. The bars are the
+ * BT.709 primaries and their mixes at 100 cd/m2, taken to BT.2020 by the matrix of ITU-R BT.2087. */
+static const char ll_pattern_header[] =
+    "float dvbridge_pq(float nits) {\n"
+    "    float y = pow(clamp(nits / 10000.0, 0.0, 1.0), 0.1593017578125);\n"
+    "    return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), 78.84375);\n"
+    "}\n"
+    "vec3 dvbridge_ll_pattern(vec2 at, float peak) {\n"
+    "    int x = int(at.x), y = int(at.y);\n"
+    "    if (y < 540) {\n"
+    "        int bar = x / 480;\n"
+    "        vec3 c = vec3(bar == 0 || bar == 1 || bar == 4 || bar == 5 ? 100.0 : 0.0,\n"
+    "                      bar <= 3 ? 100.0 : 0.0,\n"
+    "                      bar == 0 || bar == 2 || bar == 4 || bar == 6 ? 100.0 : 0.0);\n"
+    "        vec3 l = vec3(dot(vec3(0.627404, 0.329283, 0.043313), c),\n"
+    "                      dot(vec3(0.069097, 0.919540, 0.011362), c),\n"
+    "                      dot(vec3(0.016391, 0.088013, 0.895595), c));\n"
+    "        return vec3(dvbridge_pq(l.r), dvbridge_pq(l.g), dvbridge_pq(l.b));\n"
+    "    }\n"
+    "    if (y < 1080)\n"
+    "        return vec3(peak * float(x) / 3839.0);\n"
+    "    if (y < 1620)\n"
+    "        return vec3(float(768 + x / 15) / 3504.0);\n"
+    "    float y0 = 1280.0 / 3504.0, r = y0, b = y0;\n"
+    "    if (x < 1920)\n"
+    "        r = y0 + float(x / 15 - 128) * 1.4746 / 3584.0;\n"
+    "    else\n"
+    "        b = y0 + float((x - 1920) / 15) * 1.8814 / 3584.0;\n"
+    "    return vec3(r, (y0 - 0.2627 * r - 0.0593 * b) / 0.6780, b);\n"
+    "}\n";
+
+/* Hades: the output hook of a Low-Latency render (dvbridge_render_set_low_latency()): the area outside
+ * the active picture black, as mask_active_area() writes it; the test pattern in place of the picture
+ * where it is asked for; and nothing above the peak of the display (in PQ), as the picture that goes out
+ * as HDR10 mapped to a display is held (clamp_to_display()). A hook of its own, with its own
+ * signatures: the shader of the other renders does not change. */
+static struct pl_hook_res mask_low_latency(struct active_mask *mask, const struct pl_hook_params *p)
+{
+    struct pl_shader_var vars[] = {
+        {.var = pl_var_vec4("dvbridge_active"), .data = mask->rect, .dynamic = true},
+        {.var = pl_var_float("dvbridge_peak"), .data = &mask->peak, .dynamic = true},
+        {.var = pl_var_uint("dvbridge_pattern"), .data = &mask->pattern, .dynamic = true}};
+    struct pl_custom_shader shader = {
+        .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+        .header = ll_pattern_header,
+        .body = "if(gl_FragCoord.x < dvbridge_active.x || gl_FragCoord.x >= dvbridge_active.z || "
+                "gl_FragCoord.y < dvbridge_active.y || gl_FragCoord.y >= dvbridge_active.w) "
+                "color = vec4(0.0, 0.0, 0.0, 1.0);\n"
+                "if(dvbridge_pattern != 0u) color.rgb = dvbridge_ll_pattern(gl_FragCoord.xy, dvbridge_peak);\n"
+                "color = vec4(min(clamp(color.rgb, 0.0, 1.0), vec3(dvbridge_peak)), " PICTURE_ALPHA ");",
+        .variables = vars, .num_variables = 3,
+        .description = "DV Low-Latency picture within the display's peak"};
+    mask->failed = mask->failed || p->stage != PL_HOOK_OUTPUT ||
+                   !bars_written_in_this_shader(mask, p) || !pl_shader_custom(p->sh, &shader);
+    return (struct pl_hook_res){.failed = mask->failed, .output = PL_HOOK_SIG_NONE};
+}
+
 static struct pl_hook_res mask_active_area(void *priv, const struct pl_hook_params *p)
 {
     struct active_mask *mask = priv;
     if (p->stage == PL_HOOK_NATIVE)
         return skip_inactive_area(mask, p, false);
     mask->called = true;
+    if (mask->low_latency)
+        return mask_low_latency(mask, p);
     struct pl_shader_var variable = {
         .var = pl_var_vec4("dvbridge_active"), .data = mask->rect, .dynamic = true};
     /* Hades: the picture is stored within [0, 1], the range the transport packs. libplacebo
@@ -245,6 +316,8 @@ static struct pl_hook_res mask_active_area(void *priv, const struct pl_hook_para
 }
 
