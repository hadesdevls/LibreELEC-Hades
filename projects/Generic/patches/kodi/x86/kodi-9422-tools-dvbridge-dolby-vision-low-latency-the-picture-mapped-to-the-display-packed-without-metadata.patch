 /* Hades: copies a picture from a float texture (first row at the top) into a framebuffer of the
  * same size, sample for sample, for output as HDR10. A fixed-point framebuffer gets the nearest
  * of its levels of every value: the shader picks the level, since a framebuffer may also cut a
diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 9463c11..d78d44a 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -3,6 +3,7 @@
 #include "dvbridge_placebo.h"
 #include "dvbridge_metadata.h"
 #include <libplacebo/utils/libav.h>
+#include <math.h>
 
 bool dvbridge_hdr10_static(struct dvbridge_hdr10_static *out, const void *metadata, size_t bytes)
 {
@@ -62,6 +63,70 @@ bool dvbridge_hdr10_gamut_xy(enum dvbridge_hdr10_gamut gamut, float xy[8])
     return true;
 }
 
+/* Hades: how far a point is outside a triangle (CIE xy, counter-clockwise or not): the farthest it is past
+ * one of its edges, 0 inside; and the nearest point of the triangle's edges */
+static float outside_triangle(const float t[6], float px, float py)
+{
+    const float area = (t[2] - t[0]) * (t[5] - t[1]) - (t[4] - t[0]) * (t[3] - t[1]);
+    float worst = 0;
+    for (int e = 0; e < 3; ++e) {
+        const float ax = t[2 * e], ay = t[2 * e + 1];
+        const float bx = t[2 * ((e + 1) % 3)], by = t[2 * ((e + 1) % 3) + 1];
+        float d = ((bx - ax) * (py - ay) - (by - ay) * (px - ax)) / hypotf(bx - ax, by - ay);
+        if (area < 0)
+            d = -d;
+        if (-d > worst)
+            worst = -d;
+    }
+    return worst;
+}
+
+static void nearest_on_edges(const float t[6], float px, float py, float *qx, float *qy)
+{
+    float best = INFINITY;
+    for (int e = 0; e < 3; ++e) {
+        const float ax = t[2 * e], ay = t[2 * e + 1];
+        const float bx = t[2 * ((e + 1) % 3)], by = t[2 * ((e + 1) % 3) + 1];
+        const float vx = bx - ax, vy = by - ay;
+        float k = ((px - ax) * vx + (py - ay) * vy) / (vx * vx + vy * vy);
+        k = k < 0 ? 0 : k > 1 ? 1 : k;
+        const float cx = ax + k * vx, cy = ay + k * vy, d = hypotf(px - cx, py - cy);
+        if (d < best) {
+            best = d;
+            *qx = cx;
+            *qy = cy;
+        }
+    }
+}
+
+bool dvbridge_hdr10_custom_xy(const struct dvbridge_hdr10_mapping *m, float xy[8])
+{
+    if (!m || !xy || m->gamut != DVBRIDGE_HDR10_GAMUT_CUSTOM)
+        return false;
+    for (int i = 0; i < 8; ++i)
+        if (!(m->target_xy[i] > 0.0f && m->target_xy[i] < 1.0f))
+            return false;
+    const struct pl_raw_primaries *bt = pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    const float t[6] = {bt->red.x, bt->red.y, bt->green.x, bt->green.y, bt->blue.x, bt->blue.y};
+    for (int i = 0; i < 3; ++i) {
+        float px = m->target_xy[2 * i], py = m->target_xy[2 * i + 1];
+        const float out = outside_triangle(t, px, py);
+        if (out > DVBRIDGE_CUSTOM_SLACK)
+            return false;
+        if (out > 0)
+            nearest_on_edges(t, px, py, &px, &py);
+        xy[2 * i] = px;
+        xy[2 * i + 1] = py;
+    }
+    if (outside_triangle(t, m->target_xy[6], m->target_xy[7]) > 0)
+        return false;
+    xy[6] = m->target_xy[6];
+    xy[7] = m->target_xy[7];
+    const struct pl_raw_primaries p = {.red = {xy[0], xy[1]}, .green = {xy[2], xy[3]},
+                                       .blue = {xy[4], xy[5]}, .white = {xy[6], xy[7]}};
+    return pl_primaries_valid(&p);
+}
+
 bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
 {
     if (!m)
@@ -71,8 +136,13 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     if (!(m->peak >= DVBRIDGE_HDR10_PEAK_MIN && m->peak <= DVBRIDGE_HDR10_PEAK_MAX))
         return false;
     float xy[8];
-    if (!dvbridge_hdr10_gamut_xy(m->gamut, xy))
+    if (m->gamut == DVBRIDGE_HDR10_GAMUT_CUSTOM) {
+        /* Hades: a display's own gamut, inside the BT.2020 of the HDR10 signal */
+        if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 || !dvbridge_hdr10_custom_xy(m, xy))
+            return false;
+    } else if (!dvbridge_hdr10_gamut_xy(m->gamut, xy)) {
         return false;
+    }
     if (m->curve != DVBRIDGE_HDR10_CURVE_SPLINE && m->curve != DVBRIDGE_HDR10_CURVE_BT2390)
         return false;
     /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
