From 572112f68829d9a2cb4e8baeb041839670d4a697 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 03:43:11 +0000
Subject: [PATCH] windowing/gbm: an HDR10+ InfoFrame left by a previous session
 is cleared

A Kodi that ended while it sent HDR10+ (killed or crashed) left
HDR10PLUS_VSIF set on the connector, and nothing cleared it:
CDVBridgeState::ClearLeftover() looked only at the Dolby Vision
transport, and ResetHDR10Plus() cleared only what this session had
queued. The driver then sent that InfoFrame with every frame, over the
SDR GUI and HDR10 too, and refused the Dolby Vision tunnel while it was
set (nvidia-drm with NV_HDMI_VSIF_METADATA, amdgpu with
DVBRIDGE_DV_STANDARD_LAB): Dolby Vision went out as HDR10 for the whole
session.

CHDR10PlusOutput::ClearLeftover() stages it as 0 for the first modeset,
from CDVBridgeState::ClearLeftover(), before that returns for a
connector without a Dolby Vision leftover; the log says so.
ResetHDR10Plus() clears it also when the kernel has one that this
session did not queue. HDR10PLUS_VSIF is the only property of Hades'
HDR10+ that outlives Kodi.

Host test (hdr10plus_leftover_test.cpp): passes, fails against Kodi as
it was; the order in ClearLeftover() and the condition of
ResetHDR10Plus() are checked in the source, and fail on the tree before.
---
 xbmc/windowing/gbm/HDR10PlusOutput.h     | 15 +++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp      |  6 ++++--
 xbmc/windowing/gbm/drm/DVBridgeState.cpp |  6 ++++++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index f263997..3dae428 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -124,6 +124,21 @@ public:
   }
 
   bool Refused() const { return m_refused; }
+
+  /*!
+   * \brief A value of HDR10PLUS_VSIF that a previous session left on the connector (Kodi killed
+   *        or crashed while it sent HDR10+) is staged as 0 for the first commit of this one: the
+   *        driver would otherwise send that InfoFrame with every frame, over SDR and HDR10 too,
+   *        and the Dolby Vision tunnel is refused while it is set. True when there was one.
+   */
+  template<typename Drm, typename Connector>
+  static bool ClearLeftover(Drm& drm, Connector& connector)
+  {
+    if (!connector.SupportsProperty(PROPERTY) ||
+        connector.GetPropertyValue(PROPERTY).value_or(0) == 0)
+      return false;
+    return drm.AddProperty(&connector, PROPERTY, 0);
+  }
   bool Active() const { return m_queued.has_value(); }
 
 private:
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 3c8ab07..ac86259 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2345,8 +2345,10 @@ void CWinSystemGbm::ResetHDR10Plus()
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
-  if (m_hdr10Plus.Active() && connector &&
-      connector->SupportsProperty(CHDR10PlusOutput::PROPERTY))
+  // (also when the kernel has one that this did not queue: a commit before refused to clear it)
+  if (connector && connector->SupportsProperty(CHDR10PlusOutput::PROPERTY) &&
+      (m_hdr10Plus.Active() ||
+       connector->GetPropertyValue(CHDR10PlusOutput::PROPERTY).value_or(0) != 0))
     drm->AddProperty(connector, CHDR10PlusOutput::PROPERTY, 0);
   m_hdr10Plus.NewVideo();
   m_hdr10PlusTold = 0;
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index e8a3c0a..a467d1a 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -2,6 +2,7 @@
 #include "DVBridgeState.h"
 
 #include "NvidiaDualMode.h"
+#include "windowing/gbm/HDR10PlusOutput.h"
 #include "DRMAtomic.h"
 #include "DRMConnector.h"
 
@@ -61,6 +62,11 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
   auto* connector = drm.GetConnector();
   if (!connector)
     return;
+  // Hades: an HDR10+ InfoFrame of a previous session, whatever else is left (CHDR10PlusOutput)
+  if (CHDR10PlusOutput::ClearLeftover(drm, *connector))
+    CLog::Log(LOGWARNING, "HDR10+: {} of a previous session is still set on the connector; "
+                          "cleared with the first modeset",
+              CHDR10PlusOutput::PROPERTY);
   // Only when a transport signal proves it: otherwise nothing here is touched.
   // (Hades: and the Low-Latency of either, which goes with them)
   const bool kernel = connector->GetPropertyValue("DVBRIDGE_DV_STANDARD_LAB").value_or(0) != 0 ||
-- 
