diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0bd56fa..5e7e2b2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -12,6 +12,9 @@
 #include "OptionalsReg.h"
 #include "ServiceBroker.h"
 #include "VideoSyncGbm.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
+#include "cores/DataCacheCore.h"
 #include "cores/VideoPlayer/VideoReferenceClock.h"
 #include "dialogs/GUIDialogKaiToast.h"
 #include "drm/DRMAtomic.h"
@@ -488,6 +491,10 @@ STEREO::Arrangement ArrangementOf(RenderStereoMode mode)
   return mode == RenderStereoMode::SPLIT_HORIZONTAL ? STEREO::Arrangement::TOP_AND_BOTTOM
                                                    : STEREO::Arrangement::SIDE_BY_SIDE;
 }
+
+// Kodi's option of the whitelist (CResolutionUtils::FindResolutionFromWhitelist())
+constexpr const char* SETTING_VIDEOSCREEN_WHITELIST_DOUBLEREFRESHRATE =
+    "videoscreen.whitelistdoublerefreshrate";
 } // namespace
 
 bool CWinSystemGbm::SetStereoEdid(std::span<const uint8_t> edid)
@@ -550,6 +557,14 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
   // With a whitelist of modes, a timing of another size than the one Kodi chose is taken only
   // where the whitelist has its 2D mode
   allowed.otherSize = !CResolutionUtils::HasWhitelist();
+  // A 3D mode at twice the refresh rate shows each picture twice (STEREO::Choose()): while a
+  // video plays, whose picture rate is known, and where Kodi's own choice of a mode for a video
+  // would take a double refresh rate (always without a whitelist; with one, by its option)
+  allowed.doubleRate =
+      allowed.otherSize || settings->GetBool(SETTING_VIDEOSCREEN_WHITELIST_DOUBLEREFRESHRATE);
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlayingVideo())
+    allowed.pictureRate = static_cast<double>(CServiceBroker::GetDataCacheCore().GetVideoFps());
   if (!allowed.otherSize)
   {
     for (const auto& listed : settings->GetList(CSettings::SETTING_VIDEOSCREEN_WHITELIST))
@@ -669,6 +684,19 @@ bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
     info = entry;
     info.strId = chosen.strId;
   }
+  else if (std::fabs(timing.fRefreshRate - entry.fRefreshRate) >= 0.01f &&
+           timing.iScreenWidth == entry.iScreenWidth &&
+           timing.iScreenHeight == entry.iScreenHeight && timing.dwFlags == entry.dwFlags)
+  {
+    // The frame of the resolution at twice its refresh rate, which has no 3D mode of its own:
+    // each picture is shown twice (STEREO::Choose()). Sent in the mode that tells of its
+    // layout, or with the vendor InfoFrame in that 2D mode; drawn and calibrated as the
+    // resolution is.
+    info = entry;
+    info.strId = chosen.strId;
+    info.fRefreshRate = chosen.fRefreshRate;
+    info.strMode = timing.strMode;
+  }
   else
   {
     // A mode of another size: the 3D mode of a half layout or, where the display is told by
@@ -677,6 +705,11 @@ bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
     info.strOutput = entry.strOutput;
     gfx.ResetOverscan(info);
   }
+  if (std::fabs(timing.fRefreshRate - entry.fRefreshRate) >= 0.01f)
+    TellStereoOutput(StringUtils::Format(
+        "{} at {}, twice the refresh rate of {}, which has no 3D mode: each picture is shown "
+        "twice",
+        STEREO::LayoutName(choice.layout), timing.strMode, entry.strMode));
   return true;
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index a101ed2..7e21d7c 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -289,6 +289,14 @@ struct Allowed
   //! whole pictures side by side is as wide as a 2160p mode, which Kodi then chooses, and
   //! frame packing is of 1080p.
   bool otherSize{true};
+  //! The rate of the pictures that are shown, in pictures a second, where it is known (a video
+  //! plays); 0 where it is not. See Choose(), for a 3D mode at twice the refresh rate.
+  double pictureRate{0.0};
