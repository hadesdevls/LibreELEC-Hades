From aba3e19e3fc184dbfafa38d20dc223e750d6b845 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:02:18 +0000
Subject: [PATCH] dvbridge: reset the whole transport state left by a killed
 Kodi

ClearLeftover() reset the transport signal, "max bpc" and "dithering
mode". The transport also sets full-range "Broadcast RGB" (kernel
backend) and an opaque plane without blending ("pixel blend mode" None,
"alpha" at maximum), which Kodi's ordinary output never sets: after a
crash during Dolby Vision output they stayed, with wrong RGB levels on
a sink without RGB range selection and broken blending of a GUI plane
over a video plane, until the next reboot. They now go back to the
drivers' defaults too ("Automatic", "Pre-multiplied", opaque alpha),
still only when a transport signal proves a leftover.

The HDMI preference of the output selection also skips "non-desktop"
connectors (head-mounted displays).
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp      |  7 ++++++-
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 13 +++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 1e03287..3c45924 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -719,7 +719,12 @@ bool CDRMUtils::FindConnector()
     // With several displays connected, prefer an HDMI output, where the TV normally is,
     // over DisplayPort monitors; otherwise the first connected output, as before.
     const auto usable = [](auto& conn) { return conn->GetEncoderId() > 0 && conn->IsConnected(); };
-    const auto hdmi = [&usable](auto& conn) { return usable(conn) && conn->GetType() == "HDMI-A"; };
+    // A head-mounted display ("non-desktop") is never the preferred output.
+    const auto hdmi = [&usable](auto& conn)
+    {
+      return usable(conn) && conn->GetType() == "HDMI-A" &&
+             conn->GetPropertyValue("non-desktop").value_or(0) == 0;
+    };
     // With two HDMI cables to one TV (an input set up for games, another for films), prefer
     // the output whose display advertises Dolby Vision Standard.
     connector = std::ranges::find_if(m_connectors,
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index 3b936a9..65df84f 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -51,6 +51,19 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
     drm.AddProperty(connector, "max bpc", limits->second);
   if (auto dither = connector->GetPropertyEnumValue("dithering mode", "auto"))
     drm.AddProperty(connector, "dithering mode", *dither);
+  // It also forced full-range RGB and opaque, unblended planes; the ordinary output never sets
+  // these either, so they go back to the drivers' defaults.
+  if (auto range = connector->GetPropertyEnumValue("Broadcast RGB", "Automatic"))
+    drm.AddProperty(connector, "Broadcast RGB", *range);
+  for (auto* plane : {drm.GetGuiPlane(), drm.GetVideoPlane()})
+  {
+    if (!plane)
+      continue;
+    if (auto blend = plane->GetPropertyEnumValue("pixel blend mode", "Pre-multiplied"))
+      drm.AddProperty(plane, "pixel blend mode", *blend);
+    if (auto alpha = plane->GetRangePropertyLimits("alpha"))
+      drm.AddProperty(plane, "alpha", alpha->second);
+  }
 }
 
 bool CDVBridgeState::Capture(CDRMAtomic& drm)
