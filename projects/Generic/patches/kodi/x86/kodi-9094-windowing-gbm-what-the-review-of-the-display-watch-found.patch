+    // (the watch gives a call up that is not got to in time: it is not done late)
+    int expected = PENDING;
+    if (!call->result.compare_exchange_strong(expected, RUNNING))
+      return;
+
+    int result = 0;
+    try
+    {
+      result = call->work();
+    }
+    catch (const std::exception& error)
+    {
+      CLog::LogF(LOGERROR, "{}", error.what());
+    }
+    call->result.store(result);
+  }
+};
+
+// The functions from here to the end of this namespace run on the application thread.
+
+int StateNow()
+{
+  if (g_application.IsStopping())
+    return STATE_STOPPING;
+
+  int state = 0;
+  const auto gui = CServiceBroker::GetGUI();
+  if (gui && gui->GetSkinInfo())
+    state |= STATE_UP;
+  if (gui && gui->GetWindowManager().HasModalDialog(true))
+    state |= STATE_MODAL;
+
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlaying())
+    state |= STATE_PLAYING;
+  if (player && player->IsPlayingVideo())
+    state |= STATE_VIDEO;
+
+  return state;
+}
+
+// Whether Kodi may be started again for this output without anyone having said so, which is
+// noted down when it may
+bool SpendUnaskedMove(const std::string& output)
+{
+  std::vector<std::string> made;
+  {
+    std::ifstream file(MOVES_FILE);
+    std::string line;
+    while (std::getline(file, line))
+    {
+      if (!line.empty())
+        made.emplace_back(line);
+    }
+  }
+
+  if (made.size() >= UNASKED_MOVES || std::ranges::find(made, output) != made.end())
+    return false;
+
+  std::ofstream file(MOVES_FILE, std::ios::app);
+  file << output << '\n';
+  file.flush();
+  return file.good();
+}
+
+int PutNotice(const std::vector<std::string>& outputs)
+{
+  if (g_application.IsStopping())
+    return NOTICE_DONE;
+
+  const auto gui = CServiceBroker::GetGUI();
+  if (!gui || !gui->GetSkinInfo())
+    return NOTICE_LATER;
+
+  std::string names;
+  for (std::size_t i = 0; i < outputs.size() && i < NOTICE_NAMES; ++i)
+    names += (i > 0 ? ", " : "") + outputs[i];
+  if (outputs.size() > NOTICE_NAMES)
+    names += "...";
+
+  std::string text = CGUIUtils::GetHadesString(39981, 31708);
+  StringUtils::Replace(text, "{0}", names);
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Info,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246), text, 12000);
+  return NOTICE_DONE;
+}
+
+// The question. To move is the button that says yes, and the one that has the focus: only a
+// press of it sets the dialog as confirmed. A dialog that was closed in any other way has "no"
+// for its answer: by the other button, by something that closes dialogs, or by its own time
+// running out, which alone is told apart (CGUIDialog::IsAutoClosed()).
+int PutQuestion(const std::string& output, const std::string& qualified)
+{
+  const int state = StateNow();
+  if (!(state & STATE_UP) || (state & (STATE_STOPPING | STATE_VIDEO | STATE_MODAL)))
+    return ANSWER_NOT_SHOWN;
+
+  // It is one dialog for all of Kodi: a question that is open in it is not written over.
+  auto* dialog = CServiceBroker::GetGUI()->GetWindowManager().GetWindow<CGUIDialogYesNo>(
+      WINDOW_DIALOG_YES_NO);
+  if (!dialog || dialog->IsDialogRunning())
+    return ANSWER_NOT_SHOWN;
+
+  const std::string heading = CGUIUtils::GetHadesString(39985, 31704);
+  std::string text = CGUIUtils::GetHadesString(39984, 31705);
+  StringUtils::Replace(text, "{0}", output);
+  StringUtils::Replace(text, "{1}", std::to_string(ASK_SECONDS));
+
+  // (so that IsAutoClosed() tells of this time: nothing else puts it back)
+  dialog->Reset();
+  const auto start = std::chrono::steady_clock::now();
+  const CGUIDialogYesNo::DialogResult result = CGUIDialogYesNo::ShowAndGetInput(
+      CVariant{heading}, CVariant{text}, CVariant{CGUIUtils::GetHadesString(39982, 31707)},
+      CVariant{CGUIUtils::GetHadesString(39983, 31706)}, CVariant{""}, ASK_SECONDS * 1000,
+      CONTROL_YES_BUTTON);
+
+  // Kodi may have been told to stop from within the question.
+  if (g_application.IsStopping())
+    return ANSWER_STAY;
+
+  const auto gui = CServiceBroker::GetGUI();
+  dialog = gui ? gui->GetWindowManager().GetWindow<CGUIDialogYesNo>(WINDOW_DIALOG_YES_NO)
+               : nullptr;
+  // Something else put its own question in the dialog meanwhile (what was answered was that
+  // one), or the answer came sooner than a person gives one: no answer to this.
+  if (!dialog || dialog->GetHeading() != heading ||
+      std::chrono::steady_clock::now() - start < TOO_SOON_TIME)
+    return ANSWER_NOT_SHOWN;
+
+  if (result == CGUIDialogYesNo::DIALOG_RESULT_YES)
+  {
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+    return ANSWER_MOVED;
+  }
+
+  if (result != CGUIDialogYesNo::DIALOG_RESULT_NO || !dialog->IsAutoClosed())
+    return ANSWER_STAY;
+
+  // Nobody answered in all that time: the screen of the question may be one that nobody sees.
+  // Kodi moves, unless something plays or another dialog waits now, and not without end.
+  if (StateNow() & (STATE_PLAYING | STATE_MODAL))
+    return ANSWER_LATER;
+  if (!SpendUnaskedMove(qualified))
+    return ANSWER_SPENT;
+
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+  return ANSWER_MOVED_UNASKED;
+}
+
+// Kodi shows itself on no output: there is nobody to ask
+int RestartUnasked(const std::string& qualified)
+{
+  const int state = StateNow();
+  if (state & STATE_STOPPING)
+    return ANSWER_STAY;
+  if (state & STATE_PLAYING)
+    return ANSWER_LATER;
+  if (!SpendUnaskedMove(qualified))
+    return ANSWER_SPENT;
+
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+  return ANSWER_MOVED_UNASKED;
+}
+
+std::string Connected(const DRMLook& look)
+{
+  std::string names;
+  for (const auto& outputs : look.outputs)
+  {
+    for (const DRMOutput& output : outputs)
+    {
+      if (output.connected)
+        names += (names.empty() ? "" : ", ") + QualifiedOutputName(output);
+    }
+  }
+  return names.empty() ? "none" : names;
+}
