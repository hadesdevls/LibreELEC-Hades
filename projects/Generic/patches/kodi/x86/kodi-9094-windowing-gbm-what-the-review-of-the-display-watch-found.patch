+
+// What the application thread is asked, and what it answers (never less than 0)
+enum : int
+{
+  STATE_UP = 1, //!< the interface is there to show something
+  STATE_PLAYING = 2, //!< something plays, a video or not
+  STATE_VIDEO = 4,
+  //! a dialog is open that waits for the user (also the one of a stream that is being opened)
+  STATE_MODAL = 8,
+  STATE_STOPPING = 16,
+};
+
+enum : int
+{
+  ANSWER_NOT_SHOWN, //!< the question could not be put, or was not answered by anyone
+  ANSWER_LATER, //!< nobody answered, and Kodi cannot be moved now
+  ANSWER_STAY,
+  ANSWER_SPENT, //!< nobody answered, and Kodi was started again unasked often enough already
+  ANSWER_MOVED, //!< the user said to move: Kodi is being started again
+  ANSWER_MOVED_UNASKED, //!< nobody answered: Kodi is being started again
+  NOTICE_LATER,
+  NOTICE_DONE,
+};
+
+// Something for the application thread to do. It is posted and never waited for: the result is
+// looked for (CDRMDisplayWatch::CallApp()). It keeps itself until it has been done, so that it
+// is there whatever has become of the watch by then; one that is still in the queue when Kodi
+// stops is never done, and stays behind.
+struct AppCall
+{
+  enum : int
+  {
+    PENDING = -1,
+    RUNNING = -2,
+    DROPPED = -3,
+  };
+
