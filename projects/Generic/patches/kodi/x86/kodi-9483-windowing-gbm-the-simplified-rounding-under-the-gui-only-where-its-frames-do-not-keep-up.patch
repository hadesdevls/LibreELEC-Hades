+void CWinSystemGbmGLESContext::DVGuiRoundReport(const CDVGuiRound::Step& step,
+                                                uint64_t format,
+                                                int level)
+{
+  if (step.change == CDVGuiRound::Change::NONE)
+    return;
+  // which frames, and what the window that decided found
+  const std::string which = StringUtils::Format(
+      "{}/64 of the picture active, fidelity step-down level {}", CDVFrameLoad::Active64ths(format),
+      level);
+  const std::string window =
+      step.pace == CDVStepDown::Pace::AHEAD
+          ? StringUtils::Format("presented a frame ahead, {} of {} refreshes missed", step.lost,
+                                step.presented)
+          : StringUtils::Format("presented the way that waits, {} of {} frames over {:.1f} ms, {} "
+                                "of {} refreshes missed",
+                                step.over, step.frames, step.budgetMs, step.lost, step.presented);
+  if (step.change == CDVGuiRound::Change::ON)
+    CLog::Log(LOGINFO,
+              "DVBridge: P5 frames with GUI elements: {:.1f} ms of {:.1f} ms, the rounding of the "
+              "conversion under the GUI is simplified (at most 1 code in near-ties) from now on; "
+              "the frames without GUI elements and the pixels not drawn over are as before ({}; "
+              "{})",
+              step.averageMs, step.periodMs, which, window);
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: P5 frames with GUI elements: {:.1f} ms of {:.1f} ms with the exact "
+              "rounding (by what the simplified one takes now, {:.1f} ms), which fits with room to "
+              "spare: the rounding of the conversion under the GUI is exact again ({}; {})",
+              step.estimateMs, step.periodMs, step.averageMs, which, window);
 }
 
