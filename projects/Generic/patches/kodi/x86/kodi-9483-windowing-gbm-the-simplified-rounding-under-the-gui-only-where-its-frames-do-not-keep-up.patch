diff --git a/xbmc/windowing/gbm/DVGuiRound.h b/xbmc/windowing/gbm/DVGuiRound.h
new file mode 100644
index 0000000..5fa963a
--- /dev/null
+++ b/xbmc/windowing/gbm/DVGuiRound.h
@@ -0,0 +1,367 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "DVStepDown.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Whether the pixels drawn over a profile 5 picture are converted with the simplified
+ *        rounding (dvbridge_render_simplify_gui()), where the frames with GUI elements cannot keep up
+ *
+ * Converting a pixel drawn over a picture of profile 5 back to codes takes PQ round trips that the
+ * affine profiles do not, and on a small GPU the frames with GUI elements over most of the picture
+ * (the player information, a window over the dimmed video) can take more than a refresh while the
+ * others fit. The simplified rounding leaves out the correction of the round trip of the picture
+ * under such a pixel: a code apart in values close to a half, under the GUI only. It is drawn for
+ * the frames with GUI elements of a picture format only where those frames are measured not to keep
+ * up, and they go back to the exact rounding when that would fit with room to spare.
+ *
+ * The frames measured are those with GUI elements whose picture the simplified rounding draws (the
+ * bridge says so: profile 5 in the source transport, its programs made), while the video plays.
+ * Each picture format (CDVFrameLoad) at each fidelity step-down level (CDVStepDown: the frames of
+ * another level are other work) and refresh period has a state of its own, off until its frames
+ * are found not to keep up. Its frames are measured in windows of WINDOW frames of one
+ * rounding and one pace, leaving out the first seconds of a video and after a seek (SETTLE_MS), the
+ * first second after GUI elements come (GUI_SETTLE_MS: the GUI that appears is drawn and faded in
+ * meanwhile, and the GPU times of CDVAhead are set aside then too) and the first frames after a
+ * change of rounding or of pace (SKIP). A window is behind as a window of CDVStepDown is: both its
+ * GPU times and its missed refreshes say so (frames presented a frame ahead that take more than
+ * LOADED_AHEAD of the period on average without the slowest, and LOST_PART of the presentations,
+ * LOST_MIN at least, late; frames that wait, LOST_PART of them over LOADED_WAITING of the period and
+ * as many presentations late); two windows in a row, or one in which the GPU could not keep up in
+ * any case. While frames are still to be presented a frame ahead (CDVStepDown::Pace::PENDING), that
+ * comes first: nothing goes on.
+ *
+ * On: the frames of the format with GUI elements are drawn with the simplified rounding, and the
+ * first window of it says what it takes for what the exact rounding took (the window that turned it
+ * on). Off again only when the exact rounding would take, by that, no more than RELEASE_AHEAD or
+ * RELEASE_WAITING of the period (room to spare below the marks), and only RELEASE_WAIT measured
+ * frames after it went on; where it has to go on again after that, the wait doubles. Nothing goes
+ * off on a guess (with that ratio not measured, it stays on).
+ *
+ * This class only decides. The window system asks it for each frame with GUI elements, tells it
+ * their GPU times and presentations, and logs what changes.
+ */
+class CDVGuiRound
+{
+public:
+  using Pace = CDVStepDown::Pace;
+  static constexpr unsigned int WINDOW = CDVStepDown::WINDOW;
+
+  enum class Change
+  {
+    NONE,
+    ON, //!< the frames did not keep up: the simplified rounding from now on
+    OFF, //!< the exact rounding would fit with room to spare: back to it
+  };
+
+  struct Step
+  {
+    Change change = Change::NONE;
+    Pace pace = Pace::PENDING;
+    double averageMs = 0; //!< the window's GPU time, without its slowest frame
+    double budgetMs = 0; //!< the mark of a frame at that pace and refresh period
+    double periodMs = 0;
+    unsigned int frames = 0;
+    unsigned int over = 0;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+    double estimateMs = 0; //!< OFF: what the exact rounding would take now
+  };
+
+  //! A frame with GUI elements of that format is to be drawn: whether with the simplified rounding
+  bool Simplified(uint64_t format, int level, double periodMs)
+  {
+    const Format* const f = Lookup(format, level, periodMs);
+    return f && f->on;
+  }
+
+  //! The GPU time of a frame with GUI elements whose picture the simplified rounding draws, drawn
+  //! with it (simplified) or not, while the video played
+  Step Measured(uint64_t format, int level, bool simplified, double ms, double periodMs, Pace pace)
+  {
+    if (format == 0 || !(ms > 0) || !std::isfinite(ms) || !(periodMs > 0) || !std::isfinite(periodMs))
+      return Step();
+    Format& f = *Find(format, level, periodMs);
+    // a frame drawn with the other rounding than the format's (before a change): not taken
+    if (simplified != f.on)
+      return Step();
+    Window& w = f.window;
+    if (w.count > 0 && w.pace != pace)
+    {
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+    }
+    const bool settling = m_settlingMs > 0 || m_guiSettlingMs > 0 || f.skip > 0;
+    if (m_settlingMs > 0)
+      m_settlingMs -= periodMs;
+    if (m_guiSettlingMs > 0)
+      m_guiSettlingMs -= periodMs;
+    if (f.skip > 0)
+      --f.skip;
+    if (settling)
+      return Step();
+    if (w.count == 0)
+    {
+      w = Window();
+      w.pace = pace;
+    }
+    w.sum += ms;
+    w.max = std::max(w.max, ms);
+    w.over += ms > LOADED_WAITING * periodMs ? 1 : 0;
+    if (++w.count < WINDOW)
+      return Step();
+    return Decide(f);
+  }
+
+  //! A frame with GUI elements whose picture the simplified rounding draws was presented, and
+  //! whether it came with its refresh is known
+  void Presented(uint64_t format, int level, bool simplified, bool late, Pace pace, double periodMs)
+  {
+    Format* const f = Lookup(format, level, periodMs);
+    if (!f || simplified != f->on || f->window.count == 0 || f->window.pace != pace)
+      return;
+    ++f->window.presented;
+    f->window.lost += late ? 1 : 0;
+  }
+
+  //! A frame without GUI elements was drawn while the video played: the first ones with GUI
+  //! elements that come after it are left out
+  void Plain()
+  {
+    m_guiSettlingMs = GUI_SETTLE_MS;
+    for (Format& f : m_formats)
+      f.Drop();
+  }
+
+  //! The video jumped (a seek, a change of stream): the frames around it say nothing
+  void Seeked()
+  {
+    for (Format& f : m_formats)
+      f.Drop();
+    m_settlingMs = SETTLE_MS;
+  }
+
+  //! Native output ended: what is found stays, the windows begin again with the next video
+  void Restart() { Seeked(); }
+
+  //! Whether the frames of that format are drawn with the simplified rounding
+  bool On(uint64_t format, int level, double periodMs) const
+  {
+    const Format* const f = Lookup(format, level, periodMs);
+    return f && f->on;
+  }
+
+private:
+  static constexpr unsigned int SKIP = 6; //!< frames left out after a change
+  static constexpr double SETTLE_MS = 2000; //!< the start of a video, and after a seek
+  static constexpr double GUI_SETTLE_MS = 1000; //!< after GUI elements come
+  static constexpr size_t FORMATS = 8; //!< formats and refresh periods known at a time
+  // (the marks of CDVStepDown, for the same frames presented the same ways)
+  static constexpr double LOADED_AHEAD = 0.85;
+  static constexpr double LOADED_WAITING = 0.8;
+  static constexpr double RELEASE_AHEAD = 0.75;
+  static constexpr double RELEASE_WAITING = 0.7;
+  static constexpr double LOST_PART = 0.05;
+  static constexpr unsigned int LOST_MIN = 3;
+  static constexpr unsigned int KNOWN_MIN = WINDOW / 2;
+  //! measured frames after it went on before it goes off (a minute of film), doubled each time it
+  //! had to go on again, up to about an hour of film
+  static constexpr unsigned int RELEASE_WAIT = 1440;
+  static constexpr unsigned int RELEASE_MAX_WAIT = 64 * RELEASE_WAIT;
+
+  struct Window
+  {
+    unsigned int count = 0;
+    double sum = 0;
+    double max = 0;
+    unsigned int over = 0;
+    Pace pace = Pace::PENDING;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+  };
+
+  struct Format
+  {
+    uint64_t id = 0; //!< 0: none
+    int level = 0;
+    double periodMs = 0;
+    uint64_t used = 0; //!< m_clock of its last frame measured
+    bool on = false;
+    double exactMs = 0; //!< what the exact rounding took, its last window
+    double ratio = 0; //!< what the exact rounding takes for what the simplified one takes (0: not known)
+    bool justOn = false; //!< it went on, and no window of the simplified rounding has ended yet
+    bool offToKeep = false; //!< it went off, and no window of the exact rounding has kept up yet
+    unsigned int sinceOn = 0; //!< measured frames since it went on
+    unsigned int releaseWait = RELEASE_WAIT;
+    unsigned int behind = 0; //!< windows in a row that were behind
+    unsigned int skip = SKIP;
+    Window window;
+
+    void Drop()
+    {
+      window = Window();
+      behind = 0;
+    }
+  };
+
+  static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
+
+  static unsigned int Mark(unsigned int count)
+  {
+    return std::max(LOST_MIN, static_cast<unsigned int>(std::ceil(LOST_PART * count)));
+  }
+
+  Format* Lookup(uint64_t id, int level, double periodMs)
+  {
+    for (Format& f : m_formats)
+    {
+      if (id != 0 && f.id == id && f.level == level && SamePeriod(f.periodMs, periodMs))
+        return &f;
+    }
+    return nullptr;
+  }
+  const Format* Lookup(uint64_t id, int level, double periodMs) const
+  {
+    return const_cast<CDVGuiRound*>(this)->Lookup(id, level, periodMs);
+  }
+
+  //! The format at that level and period, or a place for it: a free one, else the one measured
+  //! longest ago of those that are off, else the one measured longest ago
+  Format* Find(uint64_t id, int level, double periodMs)
+  {
+    ++m_clock;
+    if (Format* const f = Lookup(id, level, periodMs))
+    {
+      f->used = m_clock;
+      return f;
+    }
+    const auto rank = [](const Format& g) { return g.id == 0 ? 0 : g.on ? 2 : 1; };
+    Format* place = &m_formats[0];
+    for (Format& f : m_formats)
+    {
+      if (rank(f) < rank(*place) || (rank(f) == rank(*place) && f.used < place->used))
+        place = &f;
+    }
+    *place = Format();
+    place->id = id;
+    place->level = level;
+    place->periodMs = periodMs;
+    place->used = m_clock;
+    return place;
+  }
+
+  Step To(Format& f, bool on, Change change, Step step)
+  {
+    step.change = change;
+    f.on = on;
+    f.Drop();
+    f.skip = std::max(f.skip, SKIP);
+    return step;
+  }
+
+  Step Decide(Format& f)
+  {
+    const Window w = f.window;
+    f.window = Window();
+    const double average = (w.sum - w.max) / (w.count - 1);
+    Step step;
+    step.pace = w.pace;
+    step.averageMs = average;
+    step.periodMs = f.periodMs;
+    step.budgetMs = (w.pace == Pace::AHEAD ? LOADED_AHEAD : LOADED_WAITING) * f.periodMs;
+    step.frames = w.count;
+    step.over = w.over;
+    step.presented = w.presented;
+    step.lost = w.lost;
+
+    const bool known = w.presented >= KNOWN_MIN;
+    const bool missed = w.lost >= Mark(w.presented);
+    bool behind = false;
+    bool beyond = false;
+    if (w.pace == Pace::AHEAD)
+    {
+      behind = known && missed && average > step.budgetMs;
+      beyond = average > f.periodMs;
+    }
+    else
+    {
+      behind = known && missed && w.over >= Mark(w.count);
+      beyond = 2 * w.over > w.count;
+    }
+
+    if (!f.on)
+    {
+      f.exactMs = average;
+      if (!behind)
+      {
+        f.behind = 0;
+        // it kept up after it went off: the wait is back to its start
+        if (known && f.offToKeep)
+        {
+          f.offToKeep = false;
+          f.releaseWait = RELEASE_WAIT;
+        }
+        return step;
+      }
+      // frame ahead comes first; one window could have been slow for another reason
+      if (w.pace == Pace::PENDING || (!beyond && ++f.behind < 2))
+        return step;
+      f.behind = 0;
+      // it went off and does not keep up after all: it waits longer before it goes off again
+      if (f.offToKeep)
+      {
+        f.offToKeep = false;
+        f.releaseWait = std::min(2 * f.releaseWait, RELEASE_MAX_WAIT);
+      }
+      f.sinceOn = 0;
+      f.justOn = true;
+      return To(f, true, Change::ON, step);
+    }
+
+    // on: the first window says what it takes for what the exact rounding took
+    if (f.justOn)
+    {
+      f.justOn = false;
+      if (f.exactMs > 0 && average > 0)
+        f.ratio = f.exactMs / average;
+    }
+    f.sinceOn += w.count;
+    if (!known || behind || f.sinceOn < f.releaseWait || !(f.ratio > 0))
+      return step;
+    const double estimate = average * f.ratio;
+    const double release = (w.pace == Pace::AHEAD ? RELEASE_AHEAD : RELEASE_WAITING) * f.periodMs;
+    if (estimate > release)
+      return step;
+    step.estimateMs = estimate;
+    f.offToKeep = true;
+    return To(f, false, Change::OFF, step);
+  }
+
+  std::array<Format, FORMATS> m_formats{};
+  uint64_t m_clock = 0;
+  double m_settlingMs = SETTLE_MS; //!< time of measured frames still left out, of any format
+  double m_guiSettlingMs = 0; //!< ... after GUI elements came
+};
