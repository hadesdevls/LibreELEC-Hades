 xbmc/settings/DisplaySettings.cpp     | 32 ++++++++++++-
 xbmc/settings/DisplaySettings.h       | 19 +++++++-
 xbmc/settings/ResolutionListReplace.h | 68 +++++++++++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp   | 20 ++++----
 5 files changed, 127 insertions(+), 13 deletions(-)
 create mode 100644 xbmc/settings/ResolutionListReplace.h

