--- a/xbmc/settings/DisplaySettings.cpp
+++ b/xbmc/settings/DisplaySettings.cpp
@@ -8,6 +8,8 @@
 
 #include "DisplaySettings.h"
 
+#include "ResolutionListReplace.h"
+
 #include "ServiceBroker.h"
 #include "cores/VideoPlayer/VideoRenderers/ColorManager.h"
 #include "dialogs/GUIDialogFileBrowser.h"
@@ -536,9 +538,17 @@ RESOLUTION_INFO& CDisplaySettings::GetResolutionInfo(RESOLUTION resolution)
   return GetResolutionInfo((size_t)resolution);
 }
 
-void CDisplaySettings::AddResolutionInfo(const RESOLUTION_INFO &resolution)
+size_t CDisplaySettings::ResolutionInfoSize() const
 {
   std::unique_lock lock(m_critical);
+  return m_resolutions.size();
+}
+
+namespace
+{
+// The entry that the list keeps of a resolution (AddResolutionInfo())
+RESOLUTION_INFO ListEntryOf(const RESOLUTION_INFO& resolution)
+{
   RESOLUTION_INFO res(resolution);
 
   if((res.dwFlags & D3DPRESENTFLAG_MODE3DTB) == 0)
@@ -559,7 +569,23 @@ void CDisplaySettings::AddResolutionInfo(const RESOLUTION_INFO &resolution)
       res.dwFlags  |= D3DPRESENTFLAG_MODE3DTB;
     }
   }
-  m_resolutions.push_back(res);
+  return res;
+}
+} // unnamed namespace
+
+void CDisplaySettings::AddResolutionInfo(const RESOLUTION_INFO &resolution)
+{
+  std::unique_lock lock(m_critical);
+  m_resolutions.push_back(ListEntryOf(resolution));
+}
+
+void CDisplaySettings::ReplaceCustomResolutions(const std::vector<RESOLUTION_INFO>& resolutions,
+                                                std::optional<size_t> desktop)
+{
+  std::unique_lock lock(m_critical);
+  RESOLUTION_LIST::Replace(m_resolutions, resolutions, desktop, RES_DESKTOP, RES_CUSTOM,
+                           ListEntryOf, m_retired);
+  ApplyCalibrations();
 }
 
 void CDisplaySettings::ApplyCalibrations()
@@ -988,6 +1014,8 @@ void CDisplaySettings::SettingOptionsMonitorsFiller(const SettingConstPtr& setti
 
 void CDisplaySettings::ClearCustomResolutions()
 {
+  // (Hades: under the lock of the list, as AddResolutionInfo())
+  std::unique_lock lock(m_critical);
   if (m_resolutions.size() > RES_CUSTOM)
   {
     std::vector<RESOLUTION_INFO>::iterator firstCustom = m_resolutions.begin()+RES_CUSTOM;
