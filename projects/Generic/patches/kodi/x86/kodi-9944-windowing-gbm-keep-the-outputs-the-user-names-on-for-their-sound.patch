From f1f212fa738d83b2628f3e7801f1c5163613d9b0 Mon Sep 17 00:00:00 2001
From: harment <harment@users.noreply.github.com>
Date: Sat, 31 Oct 2026 07:07:05 +0000
Subject: [PATCH] windowing/gbm: keep the outputs the user names on, for their
 sound

Kodi turns off the outputs that it does not use ten seconds after it
comes up: those of its own device (kodi-9992, DisableOtherOutputs()) and
all of every other graphics device (kodi-9084, DisableOtherDevices()).
That is right for a monitor next to the TV and wrong for a receiver or a
sound bar on a second output, for example the DisplayPort output of the
graphics card, or an output of the motherboard's graphics beside a
discrete card: an HDMI or DisplayPort output carries sound only while
its CRTC is on, so the sound devices of those outputs are listed in the
audio settings and play nothing. Kodi as Team Kodi publishes it never
turned them off: it detached their planes and left them lit and black.

The file hades-keep-outputs of the userdata folder
(/storage/.kodi/userdata/hades-keep-outputs) names the outputs to leave
on, one per line: "DP-1" (that name on any device), "card0-HDMI-A-2"
(the names of /sys/class/drm, for one device), "*" (every output), and
"#" for comments. Names are compared without regard to case. The file is
read once, when first needed, so a change takes a restart of Kodi.

- Its own device: the output stays on with its planes detached (black),
  its CRTC, mode and connector untouched. Where the driver needs a plane
  to keep a CRTC on (QUIRK_NEEDSPRIMARY, amdgpu) the planes are left.
- Another device: the CRTC that drives such an output is not turned off;
  the device is held open as before. What it shows is what it showed
  (the console), not a black picture made for it.
- No file, or no entry: nothing changes, and the device is not asked
  about its connectors (drmModeGetConnectorCurrent() does not probe).

The parser (DRMKeepOutputs.h) has no dependency on Kodi and was run on
the host with the cases of a missing file, comments, CRLF, case, the
"cardN-" form, "*" and a name that is a prefix of another. The code that
asks the device was compiled against libdrm 2.4.125 and run against a
device that is not there. Run on a 1.0 RC6 build (RTX 3050 to a TV, Intel iGPU to
an AV receiver): sound stays on the receiver, and the hot-plug fix still works.
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp    |  32 ++++++
 xbmc/windowing/gbm/drm/DRMKeepOutputs.h | 126 ++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.cpp     |  82 ++++++++++++++-
 xbmc/windowing/gbm/drm/DRMUtils.h       |   5 +
 4 files changed, 242 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/DRMKeepOutputs.h

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 26a8f51..33f5a2f 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -488,11 +488,40 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 bool CDRMAtomic::DisableOtherOutputs(int& flags)
 {
   int disabled = 0;
+  int keptOn = 0;
   for (const auto& crtc : GetCrtcs())
   {
     if (crtc.get() == m_crtc || crtc->GetPropertyValue("ACTIVE").value_or(0) == 0)
       continue;
     const uint64_t id = crtc->GetId();
+
+    // Hades: an output that the user keeps on (hades-keep-outputs) stays lit with nothing on it,
+    // black, which is how Kodi left its unused outputs before this build turned them off: the
+    // sound of a receiver or a sound bar on it goes on, which needs the output on. Its planes
+    // are detached, but not where the driver needs one to keep a CRTC on (QUIRK_NEEDSPRIMARY);
+    // its CRTC, mode and connector are not touched.
+    if (KeepsAnyOutputOn() &&
+        std::ranges::any_of(
+            GetConnectors(), [this, id](const auto& connector)
+            { return connector.get() != m_connector &&
+                     connector->GetPropertyValue("CRTC_ID").value_or(0) == id &&
+                     KeepsOutputOn(GetNode(), connector->GetName()); }))
+    {
+      if (!HasQuirk(QUIRK_NEEDSPRIMARY))
+      {
+        for (const auto& plane : m_planes)
+        {
+          if (plane->GetPropertyValue("CRTC_ID").value_or(0) == id)
+          {
+            AddProperty(plane.get(), "CRTC_ID", 0);
+            AddProperty(plane.get(), "FB_ID", 0);
+          }
+        }
+      }
+      ++keptOn;
+      continue;
+    }
+
     for (const auto& plane : m_planes)
     {
       if (plane->GetPropertyValue("CRTC_ID").value_or(0) == id)
@@ -517,6 +546,9 @@ bool CDRMAtomic::DisableOtherOutputs(int& flags)
     flags &= ~DRM_MODE_ATOMIC_NONBLOCK;
     CLog::LogF(LOGINFO, "turning off {} output(s) not used by Kodi", disabled);
   }
+  if (keptOn > 0)
+    CLog::LogF(LOGINFO, "{} output(s) stay on, black, for their sound (hades-keep-outputs)",
+               keptOn);
   return disabled > 0;
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMKeepOutputs.h b/xbmc/windowing/gbm/drm/DRMKeepOutputs.h
new file mode 100644
index 0000000..8a46b02
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DRMKeepOutputs.h
@@ -0,0 +1,126 @@
+/*
+ *  Copyright (C) 2026 harment
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <istream>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace KEEP_OUTPUTS
+{
+
+/*!
+ * \brief The outputs that the user keeps on, with nothing on them, for their sound
+ *
+ * An HDMI or DisplayPort output carries sound only while it is on: its CRTC drives a mode, and
+ * the audio codec of the graphics device reads the display's ELD from an output that is on. Kodi
+ * turns off the outputs that it does not use (CDRMAtomic::DisableOtherOutputs(), and
+ * CDRMUtils::DisableOtherDevices() for the other graphics devices), which is right for a monitor
+ * and wrong for a sound bar or a receiver on a second output, which then has no sound.
+ *
+ * The user names those outputs in the file hades-keep-outputs of the userdata folder
+ * (/storage/.kodi/userdata/hades-keep-outputs), one per line:
+ *
+ *   DP-1                an output of that name, on any graphics device
+ *   card0-HDMI-A-2      an output of that name on one device (the names of /sys/class/drm)
+ *   *                   every output (as Kodi before it turned the unused ones off)
+ *   # text              a comment, whole line or after an entry
+ *
+ * Names are compared without regard to case. A file that is not there, or has no entry, keeps
+ * nothing: Kodi turns the unused outputs off as it always did in this build.
+ */
+class CKeepOutputs
+{
+public:
+  CKeepOutputs() = default;
+  explicit CKeepOutputs(std::istream& in) { Parse(in); }
+
+  //! \brief Reads the entries of a file. Earlier entries are kept.
+  void Parse(std::istream& in)
+  {
+    std::string line;
+    while (std::getline(in, line))
+    {
+      const auto hash = line.find('#');
+      if (hash != std::string::npos)
+        line.erase(hash);
+      line = Trim(line);
+      if (line.empty())
+        continue;
+      if (line == "*")
+        m_all = true;
+      else
+        m_entries.emplace_back(Lower(line));
+    }
+  }
+
+  //! \brief Whether anything is kept at all
+  bool Any() const { return m_all || !m_entries.empty(); }
+
+  //! \brief Whether the output is kept on
+  //! \param node the node of its graphics device ("/dev/dri/card1")
+  //! \param connector its name as Kodi names it ("DP-1", "HDMI-A-2")
+  bool Keeps(const std::string& node, const std::string& connector) const
+  {
+    if (m_all)
+      return true;
+    const std::string name = Lower(connector);
+    const std::string withCard = Lower(CardOfNode(node)) + "-" + name;
+    return std::ranges::any_of(m_entries, [&](const std::string& entry)
+                               { return entry == name || entry == withCard; });
+  }
+
+  //! \brief The entries as they will be compared, for the log
+  std::string Describe() const
+  {
+    std::string text = m_all ? "*" : "";
+    for (const std::string& entry : m_entries)
+      text += (text.empty() ? "" : ", ") + entry;
+    return text;
+  }
+
+  //! \brief "card1" for "/dev/dri/card1"
+  static std::string CardOfNode(const std::string& node)
+  {
+    const auto slash = node.find_last_of('/');
+    return slash == std::string::npos ? node : node.substr(slash + 1);
+  }
+
+private:
+  static std::string Trim(const std::string& text)
+  {
+    const auto space = [](unsigned char c) { return std::isspace(c) != 0; };
+    const auto first = std::find_if_not(text.begin(), text.end(), space);
+    const auto last = std::find_if_not(text.rbegin(), text.rend(), space).base();
+    return first < last ? std::string(first, last) : std::string();
+  }
+
+  static std::string Lower(std::string text)
+  {
+    std::ranges::transform(text, text.begin(),
+                           [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+  }
+
+  bool m_all{false};
+  std::vector<std::string> m_entries;
+};
+
+} // namespace KEEP_OUTPUTS
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index a153911..f99efc7 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -19,8 +19,12 @@
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
 
+#include "DRMKeepOutputs.h"
 #include "PlatformDefs.h"
+#include "filesystem/SpecialProtocol.h"
 
+#include <fstream>
+#include <set>
 #include <stdexcept>
 
 using namespace KODI::WINDOWING::GBM;
@@ -29,6 +33,27 @@ namespace
 {
 const std::string SETTING_VIDEOSCREEN_LIMITGUISIZE = "videoscreen.limitguisize";
 
+// Hades: the outputs that the user keeps on, read once, the first time they are asked for
+const KEEP_OUTPUTS::CKeepOutputs& KeptOutputs()
+{
+  static const KEEP_OUTPUTS::CKeepOutputs kept = []
+  {
+    KEEP_OUTPUTS::CKeepOutputs list;
+    const std::string path =
+        CSpecialProtocol::TranslatePath("special://masterprofile/hades-keep-outputs");
+    std::ifstream in(path);
+    if (in)
+    {
+      list.Parse(in);
+      if (list.Any())
+        CLog::Log(LOGINFO, "GBM: outputs kept on for their sound ({}): {}", path,
+                  list.Describe());
+    }
+    return list;
+  }();
+  return kept;
+}
+
 // DRMStereo.h has the values of drm_mode.h without including it
 static_assert(STEREO::FLAG_INTERLACE == DRM_MODE_FLAG_INTERLACE);
 static_assert(STEREO::FLAG_DBLSCAN == DRM_MODE_FLAG_DBLSCAN);
@@ -1254,6 +1279,16 @@ bool CDRMUtils::RestoreOriginalMode()
   return true;
 }
 
+bool CDRMUtils::KeepsAnyOutputOn()
+{
+  return KeptOutputs().Any();
+}
+
+bool CDRMUtils::KeepsOutputOn(const std::string& node, const std::string& connector)
+{
+  return KeptOutputs().Keeps(node, connector);
+}
+
 void CDRMUtils::DisableOtherDevices()
 {
   for (const std::string& node : m_otherDeviceNodes)
@@ -1269,9 +1304,37 @@ void CDRMUtils::DisableOtherDevices()
 
     int off = 0;
     int kept = 0;
+    int byUser = 0; // Hades: outputs left on because the user keeps them on (hades-keep-outputs)
     int refused = 0; // why the driver refused, the last time it did
     if (drmModeResPtr resources = drmModeGetResources(fd))
     {
+      // Hades: the CRTCs that drive an output the user keeps on. Only asked when the user keeps
+      // any, so that nothing is read from the device otherwise: the question is of the state
+      // that the driver already has (drmModeGetConnectorCurrent() does not probe the display).
+      std::set<uint32_t> keep;
+      if (KeepsAnyOutputOn())
+      {
+        for (int i = 0; i < resources->count_connectors; i++)
+        {
+          drmModeConnectorPtr connector = drmModeGetConnectorCurrent(fd, resources->connectors[i]);
+          if (!connector)
+            continue;
+          const char* type = drmModeGetConnectorTypeName(connector->connector_type);
+          const std::string name =
+              std::string(type ? type : "unknown") + "-" + std::to_string(connector->connector_type_id);
+          if (connector->encoder_id != 0 && KeepsOutputOn(node, name))
+          {
+            if (drmModeEncoderPtr encoder = drmModeGetEncoder(fd, connector->encoder_id))
+            {
+              if (encoder->crtc_id != 0)
+                keep.insert(encoder->crtc_id);
+              drmModeFreeEncoder(encoder);
+            }
+          }
+          drmModeFreeConnector(connector);
+        }
+      }
+
       for (int i = 0; i < resources->count_crtcs; i++)
       {
         drmModeCrtcPtr crtc = drmModeGetCrtc(fd, resources->crtcs[i]);
@@ -1280,6 +1343,13 @@ void CDRMUtils::DisableOtherDevices()
         if (!on)
           continue;
 
+        // Hades: left as it is, lit, for the sound of its display
+        if (keep.count(resources->crtcs[i]) != 0)
+        {
+          ++byUser;
+          continue;
+        }
+
         // (a CRTC with no framebuffer and no mode drives nothing: its display goes to standby)
         if (drmModeSetCrtc(fd, resources->crtcs[i], 0, 0, 0, nullptr, 0, nullptr) == 0)
         {
@@ -1294,12 +1364,18 @@ void CDRMUtils::DisableOtherDevices()
       drmModeFreeResources(resources);
     }
 
-    if (off > 0)
+    if (byUser > 0)
+      CLog::LogF(LOGINFO, "{}: {} output(s) stay on for their sound (hades-keep-outputs)", node,
+                 byUser);
+
+    if (off > 0 || byUser > 0)
     {
       // Held open: when the last one to have a device open closes it, the kernel puts its
       // console back on it, and the display with it. That is what happens when Kodi ends.
-      CLog::LogF(LOGINFO, "{}: turned off {} output(s) that Kodi does not use{}", node, off,
-                 kept > 0 ? "; another stays on, the driver refused" : "");
+      // (Hades: also with outputs that stay on, so that the device is in the state it was left.)
+      if (off > 0)
+        CLog::LogF(LOGINFO, "{}: turned off {} output(s) that Kodi does not use{}", node, off,
+                   kept > 0 ? "; another stays on, the driver refused" : "");
       m_otherDeviceFds.emplace_back(fd);
     }
     else
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index ca9701e..e7dad60 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -312,6 +312,11 @@ protected:
   //! Turns the outputs of those devices off. The devices are then kept open until
   //! DestroyDrm(): the kernel turns the displays of a device on again when it is closed.
   void DisableOtherDevices();
+  //! Hades: whether the user keeps any output on (the file hades-keep-outputs, KEEP_OUTPUTS)
+  static bool KeepsAnyOutputOn();
+  //! Hades: whether the user keeps this output on for its sound. \param node the device
+  //! ("/dev/dri/card1"), \param connector the name of the output ("DP-1")
+  static bool KeepsOutputOn(const std::string& node, const std::string& connector);
 
   int m_fd{-1};
   CDRMConnector* m_connector{nullptr};
-- 
