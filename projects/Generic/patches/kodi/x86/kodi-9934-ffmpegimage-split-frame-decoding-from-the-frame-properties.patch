From 5b52254ee47eef4d2c7ffbd497e2b208af0e37b2 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 17 Oct 2026 17:05:57 +1000
Subject: [PATCH] FFmpegImage: Split frame decoding from the frame properties

Move the packet loop of ExtractFrame into ExtractStreamFrame, so that
another source of frames can share the size, alpha and orientation
handling. No change in behaviour. Two lines over the column limit are
re-wrapped, as clang-format requires for moved lines.

Assisted-by: Claude
(cherry picked from commit 172af4ab0ed15232faad90edfa716fe4c61db287)
---
 xbmc/guilib/FFmpegImage.cpp | 76 +++++++++++++++++++++----------------
 xbmc/guilib/FFmpegImage.h   |  1 +
 2 files changed, 45 insertions(+), 32 deletions(-)

diff --git a/xbmc/guilib/FFmpegImage.cpp b/xbmc/guilib/FFmpegImage.cpp
index 70e9991..49c409b 100644
--- a/xbmc/guilib/FFmpegImage.cpp
+++ b/xbmc/guilib/FFmpegImage.cpp
@@ -421,6 +421,50 @@ AVFrame* CFFmpegImage::ExtractFrame()
     return nullptr;
   }
 
+  AVFrame* frame = ExtractStreamFrame();
+  if (!frame)
+    return nullptr;
+
+  m_height = frame->height;
+  m_width = frame->width;
+  m_originalWidth = m_sourceWidth > 0 ? m_sourceWidth : m_width;
+  m_originalHeight = m_sourceHeight > 0 ? m_sourceHeight : m_height;
+
+  const AVPixFmtDescriptor* pixDescriptor =
+      av_pix_fmt_desc_get(static_cast<AVPixelFormat>(frame->format));
+  if (pixDescriptor &&
+      ((pixDescriptor->flags & (AV_PIX_FMT_FLAG_ALPHA | AV_PIX_FMT_FLAG_PAL)) != 0))
+    m_hasAlpha = true;
+
+  AVDictionary* dic = frame->metadata;
+  AVDictionaryEntry* entry = NULL;
+  if (dic)
+  {
+    entry = av_dict_get(dic, "Orientation", NULL, AV_DICT_MATCH_CASE);
+    if (entry && entry->value)
+    {
+      int orientation = atoi(entry->value);
+      // only values between including 0 and including 8
+      // http://sylvana.net/jpegcrop/exif_orientation.html
+      if (orientation >= 0 && orientation <= 8)
+        m_orientation = (unsigned int)orientation;
+    }
+  }
+
+  // FFmpeg 8.1 and later only report the EXIF orientation as a display matrix
+  if (m_orientation == 0)
+  {
+    const AVFrameSideData* sideData{av_frame_get_side_data(frame, AV_FRAME_DATA_DISPLAYMATRIX)};
+    if (sideData && sideData->size >= sizeof(int32_t) * DISPLAY_MATRIX_SIZE)
+      m_orientation =
+          OrientationFromDisplayMatrix(reinterpret_cast<const int32_t*>(sideData->data));
+  }
+
+  return frame;
+}
+
+AVFrame* CFFmpegImage::ExtractStreamFrame()
+{
   AVPacket pkt;
   AVFrame* frame = av_frame_alloc();
   int frame_decoded = -1;
@@ -466,38 +510,6 @@ AVFrame* CFFmpegImage::ExtractFrame()
       av_rescale_q(frame->duration, m_fctx->streams[m_streamIndex]->time_base, AVRational{1, 1000});
 #endif
 
-  m_height = frame->height;
-  m_width = frame->width;
-  m_originalWidth = m_sourceWidth > 0 ? m_sourceWidth : m_width;
-  m_originalHeight = m_sourceHeight > 0 ? m_sourceHeight : m_height;
-
-  const AVPixFmtDescriptor* pixDescriptor = av_pix_fmt_desc_get(static_cast<AVPixelFormat>(frame->format));
-  if (pixDescriptor && ((pixDescriptor->flags & (AV_PIX_FMT_FLAG_ALPHA | AV_PIX_FMT_FLAG_PAL)) != 0))
-    m_hasAlpha = true;
-
-  AVDictionary* dic = frame->metadata;
-  AVDictionaryEntry* entry = NULL;
-  if (dic)
-  {
-    entry = av_dict_get(dic, "Orientation", NULL, AV_DICT_MATCH_CASE);
-    if (entry && entry->value)
-    {
-      int orientation = atoi(entry->value);
-      // only values between including 0 and including 8
-      // http://sylvana.net/jpegcrop/exif_orientation.html
-      if (orientation >= 0 && orientation <= 8)
-        m_orientation = (unsigned int)orientation;
-    }
-  }
-
-  // FFmpeg 8.1 and later only report the EXIF orientation as a display matrix
-  if (m_orientation == 0)
-  {
-    const AVFrameSideData* sideData{av_frame_get_side_data(frame, AV_FRAME_DATA_DISPLAYMATRIX)};
-    if (sideData && sideData->size >= sizeof(int32_t) * DISPLAY_MATRIX_SIZE)
-      m_orientation =
-          OrientationFromDisplayMatrix(reinterpret_cast<const int32_t*>(sideData->data));
-  }
   av_packet_unref(&pkt);
 
   return frame;
diff --git a/xbmc/guilib/FFmpegImage.h b/xbmc/guilib/FFmpegImage.h
index d7c1876..5ec896c 100644
--- a/xbmc/guilib/FFmpegImage.h
+++ b/xbmc/guilib/FFmpegImage.h
@@ -79,6 +79,7 @@ public:
 private:
   static void FreeIOCtx(AVIOContext** ioctx);
   AVFrame* ExtractFrame();
+  AVFrame* ExtractStreamFrame();
   bool DecodeFrame(AVFrame* m_pFrame, unsigned int width, unsigned int height, unsigned int pitch, unsigned char * const pixels);
   static int EncodeFFmpegFrame(AVCodecContext *avctx, AVPacket *pkt, int *got_packet, AVFrame *frame);
   static int DecodeFFmpegFrame(AVCodecContext *avctx, AVFrame *frame, int *got_frame, AVPacket *pkt);
