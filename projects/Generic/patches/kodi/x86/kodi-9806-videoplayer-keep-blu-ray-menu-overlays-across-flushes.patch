From 4860767fbaf7428de8e49dd29cac7b1331775d84 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Fri, 30 Oct 2026 20:01:38 +0000
Subject: [PATCH] [VideoPlayer] Keep Blu-ray menu overlays across flushes

A flush, such as the one requested when libbluray stops a playlist,
removes a Blu-ray menu that is still on screen. BD-J menus often stop
and restart their background playlist after drawing the menu, which
hides the menu until it is next redrawn.

Make the Blu-ray menu overlays non-flushable. As a replaced input stream
can no longer remove them, clear the overlays when an input stream is
opened.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: adapted to Piers, where the Blu-ray input stream hands its menu overlays to the player with m_player->OnDiscNavResult() rather than NotifyPlayer(). Same lines added and removed as the origin, 8a81ff17185f.]
---
 .../cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp | 2 ++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp                         | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index bf92f34..5768a4d 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -863,6 +863,7 @@ void CDVDInputStreamBluray::OverlayClose()
   auto group = std::make_shared<CDVDOverlayGroup>();
   group->bForced = true;
   group->SetDiscMenu(true);
+  group->SetOverlayContainerFlushable(false);
   m_player->OnDiscNavResult(static_cast<void*>(&group), BD_EVENT_MENU_OVERLAY);
   m_hasOverlay = false;
 #endif
@@ -924,6 +925,7 @@ void CDVDInputStreamBluray::OverlayFlush(int64_t pts)
   group->iPTSStartTime = static_cast<double>(pts);
   group->iPTSStopTime  = 0;
   group->SetDiscMenu(true);
+  group->SetOverlayContainerFlushable(false);
 
   for(SPlane& plane : m_planes)
   {
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index ac75401..350d272 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -932,6 +932,9 @@ bool CVideoPlayer::OpenInputStream()
     throw std::runtime_error("m_pInputStream reference count is greater than 1");
   m_pInputStream.reset();
 
+  // Flushes keep disc menu overlays, and the closed input stream can no longer remove them
+  m_overlayContainer.Clear();
+
   CLog::Log(LOGINFO, "Creating InputStream");
 
   m_pInputStream = CDVDFactoryInputStream::CreateInputStream(this, m_item, true);
-- 
