From 61292f926c5ac99ee8071dacb6e6c3b056f70b24 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 7 Oct 2026 11:07:45 +0100
Subject: [PATCH] [Video] Don't crash adding the first extra of a movie.

Manage extras opened for a movie without extras has no asset selected,
and refreshing the list after the first one is added looked up the
selection to keep it, so dereferenced nothing. Select the first asset
where none is selected yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/dialogs/GUIDialogVideoManager.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/xbmc/video/dialogs/GUIDialogVideoManager.cpp b/xbmc/video/dialogs/GUIDialogVideoManager.cpp
index 144cb73..1fa3966 100644
--- a/xbmc/video/dialogs/GUIDialogVideoManager.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoManager.cpp
@@ -232,6 +232,10 @@ void CGUIDialogVideoManager::Refresh()
       m_selectedVideoAsset = item;
   }
 
+  // A list that was empty has nothing, or the empty item Remove() leaves, selected
+  if ((!m_selectedVideoAsset || selectedId == -1) && !m_videoAssetsList->IsEmpty())
+    m_selectedVideoAsset = m_videoAssetsList->Get(0);
+
   CGUIMessage msg{GUI_MSG_LABEL_BIND, GetID(), CONTROL_LIST_ASSETS, 0, 0, m_videoAssetsList.get()};
   OnMessage(msg);
 }
-- 
