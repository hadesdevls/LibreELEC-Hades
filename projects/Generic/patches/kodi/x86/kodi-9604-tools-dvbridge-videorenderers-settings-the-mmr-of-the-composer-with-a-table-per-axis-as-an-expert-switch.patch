From 1caae8275bfe360190ba1b4981ba3c29464238da Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:42:05 +0000
Subject: [PATCH] tools/dvbridge, VideoRenderers, settings: the MMR of the
 composer with a table per axis, as an expert switch

The composer of ETSI GS CCM 001 can evaluate the MMR mapping of the chroma
with a table for each of its three samples (libplacebo-9977, with the
RGBA32UI format of libplacebo-9976): the terms of one sample alone, 10 of
the 22 of an order 3 mapping, summed on the CPU for every code of that
sample and read from a texture, and only the others evaluated in the
shader. The composed planes are the same, bit for bit; whether it is
faster depends on the GPU (three reads of a texture for fewer products and
sums), which only a measurement on one can tell. So it is an expert switch,
off by default:

 - advancedsettings.xml, <video><dvmmrtable>true</dvmmrtable></video>
   (CAdvancedSettings::m_videoDVMmrTable), read when the bridge is made,
   for native output and for output as HDR10
   (CDVBridgeGLES::UseMmrTableSetting()), and said in kodi.log;
 - dvbridge_render_use_mmr_table() puts it into the three renders that
   compose (pl_render_params.dovi_ccm_mmr_table);
 - with <dvpasstimes> the composer's chroma pass has a name of its own,
   "DV composer: chroma (CCM 001 5.4, MMR table)", so that the GPU times of
   the two can be compared on the same frames;
 - the reference of a check of the bytes (dvbridge_render_reference(),
   <dvverify>) never takes it: with both switches on, every checked frame
   is the table's against the composer that evaluates every term, on the
   GPU itself.
Without libplacebo-9977 the switch does nothing (PL_DOVI_CCM_MMR_TABLE).

Measured on Mesa's zink (fidbench in five configurations, 14 pictures of a
profile 7 FEL stream whose chroma is MMR of order 3; the measured test with
the oracle of CCM 001; the render test with the composer and with
libplacebo's reshaping): with the table, every file and line the same as
without it, and without it the same as before this. A table one step of v
off on one axis (a mutation) changes the composed chroma of every picture
and the transport.
---
 tools/dvbridge/dvbridge_render.c              | 30 +++++++++++++++++++
 tools/dvbridge/dvbridge_render.h              | 12 ++++++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 22 ++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  3 ++
 xbmc/settings/AdvancedSettings.cpp            |  2 ++
 xbmc/settings/AdvancedSettings.h              |  4 +++
 6 files changed, 73 insertions(+)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 7122a34..d286961 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -87,6 +87,8 @@ struct dvbridge_renderer {
     /* Hades: the picture is composed by libplacebo's own reshaping, not as ETSI GS CCM 001 composes it
      * (dvbridge_render_use_ccm_composer()) */
     bool legacy_composer;
+    /* Hades: the MMR of the chroma with a table per axis (dvbridge_render_use_mmr_table()) */
+    bool mmr_table;
     /* Hades: the transfer of the base layer (dvbridge_render_set_base_transfer(), DVBRIDGE_BASE_*); the
      * last render of a picture whose base layer is not in PQ was not composed (base_refused: its
      * transfer, else DVBRIDGE_BASE_PQ) */
@@ -939,6 +941,9 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
     params.dovi_ccm_planes[1] = r->planes[1];
     params.dovi_ccm_composed = composed;
     params.dovi_ccm_bl_transfer = base_transfer(r);
+#ifdef PL_DOVI_CCM_MMR_TABLE
+    params.dovi_ccm_mmr_table = r->mmr_table;
+#endif
     step_down(&params, r->step);
     /* the rows of the bars are not composed: the packer writes them black without reading them,
      * and its filter reads at most 6 chroma rows beyond the active ones, which the composer
@@ -1138,6 +1143,9 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     params.border = PL_CLEAR_SKIP;
     params.dovi_ccm = !r->legacy_composer;
     params.dovi_ccm_bl_transfer = base_transfer(r);
+#ifdef PL_DOVI_CCM_MMR_TABLE
+    params.dovi_ccm_mmr_table = r->mmr_table;
+#endif
     bool ccm_composed = false;
     params.dovi_ccm_composed = &ccm_composed;
     step_down(&params, r->step);
@@ -1735,6 +1743,9 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     params.dovi_ccm = !r->legacy_composer;
     /* (a plain picture is no Dolby Vision one: libplacebo looks at this only for one) */
     params.dovi_ccm_bl_transfer = plain ? PL_COLOR_TRC_UNKNOWN : base_transfer(r);
+#ifdef PL_DOVI_CCM_MMR_TABLE
+    params.dovi_ccm_mmr_table = r->mmr_table;
+#endif
     bool ccm_composed = false;
     params.dovi_ccm_composed = &ccm_composed;
     /* (the levels step down the reconstruction: a plain picture has none) */
@@ -1949,6 +1960,22 @@ void dvbridge_render_set_base_transfer(struct dvbridge_renderer *r, int transfer
                                : DVBRIDGE_BASE_PQ;
 }
 
+void dvbridge_render_use_mmr_table(struct dvbridge_renderer *r, bool use)
+{
+    if (r)
+        r->mmr_table = use;
+}
+
+bool dvbridge_render_mmr_table(const struct dvbridge_renderer *r)
+{
+#ifdef PL_DOVI_CCM_MMR_TABLE
+    return r && r->mmr_table;
+#else
+    (void)r;
+    return false;
+#endif
+}
+
 int dvbridge_render_composed(const struct dvbridge_renderer *r)
 {
     return r ? r->composed : DVBRIDGE_COMPOSED_NONE;
@@ -2001,6 +2028,9 @@ bool dvbridge_render_reference(struct dvbridge_renderer *ref, const struct dvbri
     ref->rgb_clean = false;
     ref->step = main->step;
     ref->legacy_composer = main->legacy_composer;
+    /* (Hades: and every term of the MMR evaluated in the shader, whatever main does: the table is to
+     * give the same bytes, which this then checks, dvbridge_render_use_mmr_table()) */
+    ref->mmr_table = false;
     /* (Hades: the transfer of the base layer: as main's pictures have it) */
     ref->base_transfer = main->base_transfer;
     /* the transport: as certified source devices send it, or converted (it changes the bytes on
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 9578917..6c29be7 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -268,6 +268,18 @@ bool dvbridge_render_ccm_composer(const struct dvbridge_renderer *renderer);
  * reshaping, as before, to compare on hardware. A picture outside the clause's scope is composed
  * by libplacebo's reshaping either way (libplacebo logs why). */
 void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *renderer, bool use);
+/* Hades: whether the composer of ETSI GS CCM 001 maps the chroma by MMR with a table for each of its
+ * three samples (libplacebo's pl_render_params.dovi_ccm_mmr_table, libplacebo-9977): the terms of one
+ * sample alone summed on the CPU for every code of it, read from a texture, the others evaluated in
+ * the shader. The same composed planes, bit for bit (measured on Mesa's zink); whether it is faster
+ * depends on the GPU, so it is off by default, an expert switch for a measurement on hardware
+ * (advancedsettings.xml, <video><dvmmrtable>true</dvmmrtable></video>): the composer's chroma pass
+ * then has a name of its own in the GPU time of each pass ("DV composer: chroma (CCM 001 5.4, MMR
+ * table)", dvbridge_render_time_passes()). The reference of a check of the bytes
+ * (dvbridge_render_reference()) always evaluates every term: a check with it on compares the two.
+ * Without libplacebo's switch it does nothing. */
+void dvbridge_render_use_mmr_table(struct dvbridge_renderer *renderer, bool use);
+bool dvbridge_render_mmr_table(const struct dvbridge_renderer *renderer);
 /* Hades: how the picture of the last render was composed, which is not always what was asked for
  * (dvbridge_render_use_ccm_composer()): DVBRIDGE_COMPOSED_CCM as the composer of ETSI GS CCM 001
  * composes it; DVBRIDGE_COMPOSED_RESHAPING by libplacebo's own reshaping, which the setting asks for,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index b189ba9..4a1719f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -485,6 +485,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   }
   UseComposerSetting();
   UseGamutSetting();
+  UseMmrTableSetting();
   // Hades: the transport that UseSourceTransport() asked for, also for a renderer made after it
   dvbridge_render_use_source_transport(m_renderer, m_sourceWanted);
   // ... and Low-Latency (SetLowLatency())
@@ -1333,6 +1334,26 @@ void CDVBridgeGLES::UseGamutSetting()
                                                             : DVBRIDGE_GAMUT_TABLE_STANDARD);
 }
 
+// Hades: the composer maps the chroma by MMR with a table for each of its three samples, where
+// advancedsettings.xml asks for it (<video><dvmmrtable>true</dvmmrtable></video>,
+// dvbridge_render_use_mmr_table()): the same pictures, bit for bit, to measure on a GPU whether it is
+// faster. With dvpasstimes the composer's chroma pass is timed apart ("DV composer: chroma (CCM 001
+// 5.4, MMR table)"); with dvverify the frames are checked against the composer that computes every
+// term (the reference of the check never takes the table). Off by default.
+void CDVBridgeGLES::UseMmrTableSetting()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent();
+  if (!m_renderer || !settings || !settings->GetAdvancedSettings()->m_videoDVMmrTable)
+    return;
+  dvbridge_render_use_mmr_table(m_renderer, true);
+  CLog::Log(LOGINFO,
+            "DVBridge: the composer maps the chroma by MMR with a table for each of its samples, as "
+            "advancedsettings.xml asks (dvmmrtable): the same pictures{}",
+            dvbridge_render_mmr_table(m_renderer)
+                ? "; with dvpasstimes its chroma pass is timed apart (\"MMR table\")"
+                : ", but this libplacebo has no such table: every term is computed");
+}
+
 void CDVBridgeGLES::UseGamutTable(bool fine)
 {
   m_fineGamut = fine;
@@ -1400,6 +1421,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
   UseComposerSetting();
   UseGamutSetting();
+  UseMmrTableSetting();
   m_copier = dvbridge_gl_copier_create();
   CLog::Log(LOGDEBUG, "DVBridge: GL initialized for output as HDR10 renderer={} copier={}",
             m_renderer != nullptr, m_copier != nullptr);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index eb1063c..9e3aa37 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -410,6 +410,9 @@ private:
   void UseComposerSetting();
   //! The gamut mapping table of the renderer, as UseGamutTable() asked
   void UseGamutSetting();
+  //! Hades: the MMR of the composer with a table per axis, where advancedsettings.xml asks for it
+  //! (dvmmrtable; with a renderer that has just been made)
+  void UseMmrTableSetting();
   //! Hades: which gamut mapping table the last mapping took, when that is new (once for a table
   //! and its format)
   void LogGamutTable();
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index 9400a95..292fa7e 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -212,6 +212,7 @@ void CAdvancedSettings::Initialize()
   m_videoDVVerify = 0;
   m_videoDVPassTimes = false;
   m_videoDVEndOfStream = false;
+  m_videoDVMmrTable = false;
   m_videoDVWarmup = true;
   m_videoSmoothPercentToTimeSeeking = true;
   m_videoTimeSeekForward = 30;
@@ -718,6 +719,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
     XMLUtils::GetInt(pElement, "dvverify", m_videoDVVerify, 0, 1000000);
     XMLUtils::GetBoolean(pElement, "dvpasstimes", m_videoDVPassTimes);
     XMLUtils::GetBoolean(pElement, "dveos", m_videoDVEndOfStream);
+    XMLUtils::GetBoolean(pElement, "dvmmrtable", m_videoDVMmrTable);
     XMLUtils::GetBoolean(pElement, "dvwarmup", m_videoDVWarmup);
     XMLUtils::GetBoolean(pElement, "smoothpercenttotimeseeking", m_videoSmoothPercentToTimeSeeking);
     XMLUtils::GetInt(pElement, "timeseekforward", m_videoTimeSeekForward, 0, 6000);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index 669b48f..e235a3b 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -207,6 +207,10 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! restored (video/dveos; DVBRIDGE::EndOfStreamFrame()): a comparison for a display. Off, the
     //! default: the output is restored as before, with no such frame
     bool m_videoDVEndOfStream;
+    //! Hades: the composer of ETSI GS CCM 001 maps the chroma by MMR with a table for each of its three
+    //! samples (video/dvmmrtable; dvbridge_render_use_mmr_table()): the same pictures, bit for bit, to
+    //! measure on a GPU whether it is faster. Off, the default
+    bool m_videoDVMmrTable;
     //! Hades: the GPU programs of the ways a native Dolby Vision session can draw its frames are
     //! made ready before its first frame (video/dvwarmup; dvbridge_render_warm()). Off to have each
     //! made when a frame first needs it, as before
