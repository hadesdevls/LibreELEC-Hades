From b0635b76cc0503fedc920c6401ffc86ad7b1859b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:08:51 +0000
Subject: [PATCH] VideoPlayer: the PGS of a Dolby Vision profile 5 video are
 taken as PQ in BT.2020

Kodi gives a PGS stream the colours of its video (a PGS palette has none of its own) and takes it as
made for HDR where the video's transfer is PQ. A Dolby Vision video of profile 5, and of profile 10
with no base layer of another kind, is IPT-PQ-c2: PQ in BT.2020 by its definition, and its stream
says nothing of its colours (transfer, primaries and matrix unspecified). Its subtitles were taken as
SDR: drawn through the GUI's composite, sRGB to PQ at the GUI's white (a white made at 203 cd/m2 came
out at about 60, as the menus of an Ultra HD Blu-ray did), with their palette decoded with BT.709
instead of BT.2020; with native Dolby Vision output and with Dolby Vision converted to HDR10 alike.

Such a video now gives its subtitles PQ, the BT.2020 primaries and the BT.2020 matrix
(IptPQVideo(), PgsRange.h), as the other profiles say of themselves, and kodi.log says so. Subtitles
made for SDR in such a file are told apart by their colours as in any PQ video
(subtitles.hadesbitmaprange).

Tests (outside the tree): pgs_range_test, the profiles taken so (5, and 10 with base layer 0) and not
(7, 8.1, 8.2, 8.4, 9, 10 with an HDR10, SDR or HLG base layer, none); pgs_range_wiring.py, the hint
in CVideoPlayer::OpenStream() (fails on the tree before); menu_frame, a PQ palette drawn through the
GUI and as an HDR overlay against BT.2020 and ST 2084.

The fault was seen by matthane and SamuriHL in CoreELEC's Kodi.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 8614e79..b2404eb 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -12,6 +12,7 @@
 #endif
 
 #include "DVDCodecs/DVDCodecUtils.h"
+#include "DVDCodecs/Overlay/PgsRange.h"
 #include "DVDDemuxers/DVDDemux.h"
 #include "DVDDemuxers/DVDDemuxCC.h"
 #include "DVDDemuxers/DVDDemuxFFmpeg.h"
@@ -5036,6 +5037,21 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
         hint.colorSpace = m_CurrentVideo.hint.colorSpace;
         hint.colorPrimaries = m_CurrentVideo.hint.colorPrimaries;
         hint.colorTransferCharacteristic = m_CurrentVideo.hint.colorTransferCharacteristic;
+        // Hades: a Dolby Vision video whose base layer says nothing of its colours (profile 5,
+        // and 10 with no other base layer: IPT-PQ-c2) is a PQ video in BT.2020 for its subtitles,
+        // as the other profiles say of themselves
+        const auto& dovi = m_CurrentVideo.hint.dovi;
+        if (KODI::SUBTITLES::IptPQVideo(dovi.dv_profile, dovi.dv_bl_signal_compatibility_id) &&
+            hint.colorTransferCharacteristic == AVCOL_TRC_UNSPECIFIED)
+        {
+          hint.colorSpace = AVCOL_SPC_BT2020_NCL;
+          hint.colorPrimaries = AVCOL_PRI_BT2020;
+          hint.colorTransferCharacteristic = AVCOL_TRC_SMPTE2084;
+          CLog::Log(LOGINFO,
+                    "CVideoPlayer::OpenStream - PGS of a Dolby Vision profile {} video, which says "
+                    "nothing of its colours: taken as PQ in BT.2020",
+                    static_cast<int>(dovi.dv_profile));
+        }
       }
       res = OpenSubtitleStream(hint);
       if (res)
