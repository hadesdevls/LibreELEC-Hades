From 91eb286a40c357857dbf947c4da8ee48584d4503 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 9 Nov 2026 16:33:58 -0800
Subject: [PATCH] [tools/depends] Disable zlib tests with updated CMake option

zlib 1.3.2 replaced ZLIB_BUILD_EXAMPLES with ZLIB_BUILD_TESTING.
The obsolete option leaves tests enabled, causing the infcover
coverage executable to fail linking with Emscripten 7.0.0 due to
unresolved LLVM coverage runtime symbols.

Disable tests using the supported option.

(cherry picked from commit 4b1789627dd912f82902d46bf09a5299629ab4a9)
---
 tools/depends/target/zlib/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/depends/target/zlib/Makefile b/tools/depends/target/zlib/Makefile
index fb534b5..4cad6be 100644
--- a/tools/depends/target/zlib/Makefile
+++ b/tools/depends/target/zlib/Makefile
@@ -4,7 +4,7 @@ DEPS = ../../Makefile.include Makefile ZLIB-VERSION ../../download-files.include
 # configuration settings
 CMAKE_OPTIONS=-DCMAKE_INSTALL_PREFIX=$(PREFIX) \
               -DINSTALL_PKGCONFIG_DIR=$(PREFIX)/lib/pkgconfig \
-              -DZLIB_BUILD_EXAMPLES=OFF \
+              -DZLIB_BUILD_TESTING=OFF \
               -DZLIB_BUILD_SHARED=OFF \
 			  -DZLIB_BUILD_STATIC=ON
 
