From 7140b6a3f0576cd1b791b00d393f648a38a0e289 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 6 Oct 2026 19:43:24 +0000
Subject: [PATCH] VideoPlayer: a native Dolby Vision stream keeps its HDR10
 static metadata

The mastering-display and light-level SEI of HDR10 describe the whole
stream, but some encoders carry them only on the first IRAP picture. The
decoder then reports the pictures of the next IRAP without static
metadata (or with that of the container, which may differ), the renderer
manager compares that as another format and makes the renderer again,
and making the renderer again ends native Dolby Vision output: the HDMI
signal leaves Dolby Vision and enters it again about one GOP after the
start, with two full changes of the display mode, a visible
interruption and a reset of the HDMI audio.

A stream that is set up for native output now keeps the last static
metadata it carried in band. A new SEI still replaces it, the metadata
of the container is still used before any SEI has been seen, and
nothing is kept from one stream to the next. It is kept when the
decoder of the same stream is reset (a seek, the next clip of a
Blu-ray) or opened again (a hardware decoder that failed), and also
while such a stream plays on the ordinary output. Streams that are not
Dolby Vision (HDR10, HLG, SDR) are not changed.

From intel-dv-libreelec, patches/kodi/
kodi-9997-dv-static-metadata-latch.patch at
0008daa71e8233891fcf712d7e0f59fe65eaab3d ("Keep HDR10 static metadata
for the rest of a native DV stream", pull request 4 of that
repository), written for this tree with std::optional; keeping it
across a reopening of the decoder is not from there.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 41 +++++++++++++++++++
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  4 ++
 2 files changed, 45 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 26be451..ed8ad6a 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -375,6 +375,8 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   // The stream is set up for native output (dual-layer decoding) when a transport mode can carry
   // it, also before the output switches to that mode.
   m_dvNativeOutput = DVBRIDGE::WantsNativeOutputMode(hints);
+  m_dvDisplayMetadata.reset();
+  m_dvLightMetadata.reset();
 #endif
 
   const AVCodec* pCodec = nullptr;
@@ -561,6 +563,8 @@ void CDVDVideoCodecFFmpeg::Dispose()
   m_dvRpuBack = DV_RPU_BACK;
   m_dvRpuReturns = 0;
   m_dvNativeOutput = false;
+  m_dvDisplayMetadata.reset();
+  m_dvLightMetadata.reset();
 #endif
   av_frame_free(&m_pFrame);
   av_frame_free(&m_pDecodedFrame);
@@ -1289,11 +1293,23 @@ void CDVDVideoCodecFFmpeg::Reset()
 
 void CDVDVideoCodecFFmpeg::Reopen()
 {
+#ifdef HAVE_DVBRIDGE
+  // the same stream goes on: what it carried in band is still its static metadata
+  const auto displayMetadata = m_dvDisplayMetadata;
+  const auto lightMetadata = m_dvLightMetadata;
+#endif
   Dispose();
   if (!Open(m_hints, m_options))
   {
     Dispose();
   }
+#ifdef HAVE_DVBRIDGE
+  else
+  {
+    m_dvDisplayMetadata = displayMetadata;
+    m_dvLightMetadata = lightMetadata;
+  }
+#endif
 }
 
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::HandleHwFatal()
@@ -1448,7 +1464,22 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   {
     pVideoPicture->displayMetadata = *(AVMasteringDisplayMetadata *)sd->data;
     pVideoPicture->hasDisplayMetadata = true;
+#ifdef HAVE_DVBRIDGE
+    m_dvDisplayMetadata = pVideoPicture->displayMetadata;
+#endif
+  }
+#ifdef HAVE_DVBRIDGE
+  // The static metadata of HDR10 describes the whole stream, but an encoder may carry its SEI
+  // only on the first IRAP picture. A later picture without it compares as another format
+  // (VideoPicture::IsSameParams()): the renderer is made again, which ends native Dolby Vision
+  // output and starts it again, two changes of the display mode in the middle of the video.
+  // A stream set up for native output keeps the last metadata it carried; a new SEI replaces it.
+  else if (m_dvNativeOutput && m_dvDisplayMetadata)
+  {
+    pVideoPicture->displayMetadata = *m_dvDisplayMetadata;
+    pVideoPicture->hasDisplayMetadata = true;
   }
+#endif
   else if (m_hints.masteringMetadata)
   {
     pVideoPicture->displayMetadata = *m_hints.masteringMetadata.get();
@@ -1459,7 +1490,17 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   {
     pVideoPicture->lightMetadata = *(AVContentLightMetadata *)sd->data;
     pVideoPicture->hasLightMetadata = true;
+#ifdef HAVE_DVBRIDGE
+    m_dvLightMetadata = pVideoPicture->lightMetadata;
+#endif
+  }
+#ifdef HAVE_DVBRIDGE
+  else if (m_dvNativeOutput && m_dvLightMetadata)
+  {
+    pVideoPicture->lightMetadata = *m_dvLightMetadata;
+    pVideoPicture->hasLightMetadata = true;
   }
+#endif
   else if (m_hints.contentLightMetadata)
   {
     pVideoPicture->lightMetadata = *m_hints.contentLightMetadata.get();
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index 8e7f879..4eac7ea 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -14,6 +14,7 @@
 #include "cores/VideoPlayer/DVDStreamInfo.h"
 
 #include <memory>
+#include <optional>
 #include <string>
 #include <vector>
 #ifdef HAVE_DVBRIDGE
@@ -79,6 +80,9 @@ protected:
   CDVDVideoCodec::VCReturn GetPairedPicture(VideoPicture* picture);
   void CheckNativeDVPicture(VideoPicture* picture);
   bool m_dvNativeOutput{false};
+  //! The last HDR10 static metadata that the stream carried in band (see GetPictureCommon())
+  std::optional<AVMasteringDisplayMetadata> m_dvDisplayMetadata;
+  std::optional<AVContentLightMetadata> m_dvLightMetadata;
 #endif
   void Dispose();
   CDVDVideoCodec::VCReturn HandleHwFatal();
-- 
