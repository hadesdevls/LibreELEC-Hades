+
+#include "cores/AudioEngine/Utils/AEPcmChannels.h"
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace AE::PCM;
+
+namespace
+{
+// The short audio descriptors of real EDIDs, as the displays give them
+// An LG C5 with its sound bar on eARC, on a day when it declared 8 channels of PCM (2026-10-14):
+// LPCM 8, E-AC-3 8, AC-3 6, MLP 8
+const std::vector<uint8_t> LG_8 = {0x0f, 0x7f, 0x07, 0x57, 0x04, 0x03,
+                                   0x15, 0x07, 0x50, 0x67, 0x54, 0x07};
+// The same TV on a day when it declared 2 (2026-10-15), and no speaker allocation: LPCM 2, AC-3 6,
+// E-AC-3 8
+const std::vector<uint8_t> LG_2 = {0x09, 0x57, 0x07, 0x15, 0x07, 0x50, 0x57, 0x04, 0x03};
+// Its sound bar, with the PC on the bar's own input: LPCM 2 and 8, MLP, E-AC-3, AC-3, DTS, DTS-HD
+const std::vector<uint8_t> BAR = {0x09, 0x7f, 0x07, 0x0f, 0x7f, 0x07, 0x67, 0x54,
+                                  0x07, 0x57, 0x04, 0x03, 0x15, 0x07, 0x50, 0x3d,
+                                  0x07, 0xc0, 0x5f, 0x7e, 0x03, 0x5f, 0x7e, 0x01};
+// A Hisense TV (2026-10-17): LPCM 2, AC-3 6, E-AC-3 8, DTS 6, MLP 8, DTS-HD 8
+const std::vector<uint8_t> HISENSE = {0x09, 0x07, 0x07, 0x15, 0x07, 0x50, 0x57, 0x04, 0x01,
+                                      0x3d, 0x07, 0xc0, 0x67, 0x04, 0x03, 0x5f, 0x7e, 0x01};
+
+unsigned int Max(const std::vector<uint8_t>& sads)
+{
+  return MaxChannelsOfSads(sads.data(), sads.size() / 3);
+}
+
+// An ELD as the HDA HDMI codec has it (version 2), with this monitor name and these descriptors
+std::vector<uint8_t> Eld(const char* name, const std::vector<uint8_t>& sads)
+{
+  const size_t nameLength = std::strlen(name);
+  std::vector<uint8_t> eld(20, 0);
+  eld[0] = 2 << 3;
+  eld[2] = static_cast<uint8_t>((16 + nameLength + sads.size() + 3) / 4);
+  eld[4] = static_cast<uint8_t>((3 << 5) | nameLength);
+  eld[5] = static_cast<uint8_t>((sads.size() / 3) << 4);
+  eld.insert(eld.end(), name, name + nameLength);
+  eld.insert(eld.end(), sads.begin(), sads.end());
+  return eld;
+}
+
+unsigned int MaxOfEld(const std::vector<uint8_t>& eld, size_t length)
+{
+  return MaxChannelsOfEld(eld.data(), length);
+}
+} // namespace
+
+TEST(TestAEPcmChannels, TheMostChannelsOfTheLpcmDescriptors)
+{
+  EXPECT_EQ(8u, Max(LG_8));
+  EXPECT_EQ(2u, Max(LG_2)); // not the 8 of its E-AC-3
+  EXPECT_EQ(8u, Max(BAR));
+  EXPECT_EQ(2u, Max(HISENSE)); // not the 8 of its MLP and DTS-HD
+}
+
+TEST(TestAEPcmChannels, BasicAudioWithoutAnLpcmDescriptor)
+{
+  // AC-3 6 and E-AC-3 8 only: 2 channels of LPCM, which every display with audio takes
+  const std::vector<uint8_t> compressed = {0x15, 0x07, 0x50, 0x57, 0x04, 0x03};
+  EXPECT_EQ(2u, Max(compressed));
+}
+
+TEST(TestAEPcmChannels, NothingKnownWithoutDescriptors)
+{
+  EXPECT_EQ(0u, MaxChannelsOfSads(nullptr, 3));
+  EXPECT_EQ(0u, MaxChannelsOfSads(LG_8.data(), 0));
+}
+
+TEST(TestAEPcmChannels, FromAnEld)
+{
+  EXPECT_EQ(2u, MaxOfEld(Eld("LG TV SSCR2", LG_2), Eld("LG TV SSCR2", LG_2).size()));
+  EXPECT_EQ(8u, MaxOfEld(Eld("LG TV SSCR2", LG_8), Eld("LG TV SSCR2", LG_8).size()));
+  EXPECT_EQ(2u, MaxOfEld(Eld("HISENSE", HISENSE), Eld("HISENSE", HISENSE).size()));
+  // the buffer of the control is larger than the ELD: the bytes after it do not count (here they
+  // would be descriptors of 8 channels of LPCM)
+  std::vector<uint8_t> padded = Eld("", LG_2);
+  padded.resize(256, 0x0f);
+  EXPECT_EQ(2u, MaxOfEld(padded, padded.size()));
+  // no descriptors: not known
+  EXPECT_EQ(0u, MaxOfEld(Eld("TV", {}), Eld("TV", {}).size()));
+}
+
+TEST(TestAEPcmChannels, AnEldThatDoesNotHoldItsDescriptors)
+{
+  const std::vector<uint8_t> eld = Eld("LG TV SSCR2", LG_8);
+  // cut in the last descriptor
+  EXPECT_EQ(0u, MaxOfEld(eld, eld.size() - 1));
+  // shorter than its fixed part
+  EXPECT_EQ(0u, MaxOfEld(eld, 19));
+  EXPECT_EQ(0u, MaxChannelsOfEld(nullptr, 64));
+  // another version
+  std::vector<uint8_t> other = eld;
+  other[0] = 1 << 3;
+  EXPECT_EQ(0u, MaxOfEld(other, other.size()));
+  // a monitor name longer than an ELD has
+  std::vector<uint8_t> name = eld;
+  name[4] = (3 << 5) | 17;
+  EXPECT_EQ(0u, MaxOfEld(name, name.size()));
+}
+
+TEST(TestAEPcmChannels, ChannelsOfTheLayouts)
+{
+  const unsigned int channels[] = {1, 2, 3, 3, 4, 4, 5, 5, 6, 7, 8};
+  for (int layout = 0; layout <= 10; ++layout)
+    EXPECT_EQ(channels[layout], ChannelsOfLayout(layout)) << "layout " << layout;
+  EXPECT_EQ(0u, ChannelsOfLayout(-1));
+  EXPECT_EQ(0u, ChannelsOfLayout(11));
+}
+
+TEST(TestAEPcmChannels, TheSettingLimitedToTheDisplay)
+{
+  constexpr int L1_0 = 0, L2_0 = 1, L4_0 = 5, L5_1 = 8, L7_0 = 9, L7_1 = 10;
+  // a display of 2 channels: 2.0, as with the setting at 2.0
+  EXPECT_EQ(L2_0, LimitLayout(L7_1, 2));
+  EXPECT_EQ(L2_0, LimitLayout(L5_1, 2));
+  // 6: 5.1; 8 and more: the setting
+  EXPECT_EQ(L5_1, LimitLayout(L7_1, 6));
+  EXPECT_EQ(L7_1, LimitLayout(L7_1, 8));
+  EXPECT_EQ(L5_1, LimitLayout(L5_1, 8));
+  // 7: 7.0
+  EXPECT_EQ(L7_0, LimitLayout(L7_1, 7));
+  // 4: 4.0, the nearest layout below 5.1 of 4 channels
+  EXPECT_EQ(L4_0, LimitLayout(L5_1, 4));
+  // 1: mono
+  EXPECT_EQ(L1_0, LimitLayout(L7_1, 1));
+  // a setting that fits stays, also below what the display takes
+  EXPECT_EQ(L2_0, LimitLayout(L2_0, 8));
+  EXPECT_EQ(L2_0, LimitLayout(L2_0, 2));
+  // not known: the setting
+  EXPECT_EQ(L7_1, LimitLayout(L7_1, 0));
+  // a value that is no layout: as it is
+  EXPECT_EQ(42, LimitLayout(42, 2));
+}
