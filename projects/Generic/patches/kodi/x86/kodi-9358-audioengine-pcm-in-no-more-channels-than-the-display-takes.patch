new file mode 100644
index 0000000..ad9a782
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/AEPcmChannels.h
@@ -0,0 +1,102 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+/*!
+ * Hades: how many channels of linear PCM a display takes, by its audio data (the ELD that the
+ * graphics driver builds from the EDID), and the channel setting of the engine limited to that.
+ *
+ * A display says in its EDID which audio it takes, as short audio descriptors (CTA-861): for each
+ * format the most channels it takes. Kodi read only which formats there are, and took the channels
+ * from the speaker allocation, or, where a display has none (the driver of the HDA HDMI codec then
+ * assumes every speaker, "to not prohibit multi-channel audio playback"), from what ALSA offers,
+ * which is up to the most channels of any descriptor, compressed ones included. So a TV that takes
+ * linear PCM in 2 channels and Dolby Digital Plus in 8 got 8 channels of PCM whenever Kodi decoded
+ * a multichannel track (DTS where the chain has no DTS, TrueHD without passthrough). Seen with an
+ * LG C5 and its sound bar on eARC, with an EDID of 2 channels of PCM (2026-10-15): a DTS-HD Master
+ * Audio track decoded to PCM played nothing. With an EDID of 8 channels, which the same TV gave on
+ * other days, the same track decoded to 7.1 PCM played.
+ */
+namespace AE::PCM
+{
+//! CTA-861 audio format code of linear PCM in a short audio descriptor
+constexpr unsigned int FORMAT_LPCM = 1;
+
+/*!
+ * \brief The most channels of linear PCM that short audio descriptors (3 bytes each) declare
+ * \return the most channels of the LPCM descriptors; 2 when there are descriptors and none is of
+ *         LPCM (basic audio, 2 channels of LPCM, is what every display with audio takes); 0 when
+ *         there are none (not known)
+ */
+constexpr unsigned int MaxChannelsOfSads(const uint8_t* sads, size_t count)
+{
+  if (!sads || count == 0)
+    return 0;
+
+  unsigned int most = 0;
+  for (size_t i = 0; i < count; ++i)
+  {
+    const uint8_t first = sads[3 * i];
+    if (((first >> 3) & 0xF) == FORMAT_LPCM && (first & 0x7) + 1u > most)
+      most = (first & 0x7) + 1u;
+  }
+  return most > 0 ? most : 2;
+}
+
+/*!
+ * \brief The same, from an ELD (version 2, CEA-861-D, as the HDA HDMI codec reads it)
+ * \return 0 when the ELD is not of that version, or its descriptors do not fit in it
+ */
+constexpr unsigned int MaxChannelsOfEld(const uint8_t* eld, size_t length)
+{
+  // (the fixed part: 20 bytes, then the monitor name, then the descriptors)
+  if (!eld || length < 20)
+    return 0;
+  const unsigned int version = (eld[0] & 0xF8) >> 3;
+  if (version != 2 && version != 31)
+    return 0;
+  const size_t nameLength = eld[4] & 0x1F;
+  const size_t count = (eld[5] & 0xF0) >> 4;
+  if (nameLength > 16 || 20 + nameLength + 3 * count > length)
+    return 0;
+  return MaxChannelsOfSads(eld + 20 + nameLength, count);
+}
+
+//! The number of channels of a channel setting (audiooutput.channels: an AEStdChLayout, 0 is 1.0,
+//! 1 is 2.0 ... 10 is 7.1); 0 for a value that is none of them
+constexpr unsigned int ChannelsOfLayout(int layout)
+{
+  constexpr unsigned int channels[] = {1, 2, 3, 3, 4, 4, 5, 5, 6, 7, 8};
+  return layout >= 0 && layout < static_cast<int>(sizeof(channels) / sizeof(channels[0]))
+             ? channels[layout]
+             : 0;
+}
+
+/*!
+ * \brief A channel setting limited to the channels a display takes
+ * \param maxChannels from MaxChannelsOfEld(); 0, not known: the setting as it is
+ * \return the setting where its channels fit; else the nearest standard layout below it whose
+ *         channels fit (7.1 for 8 channels and more, 5.1 for 6, 2.0 for 2), at least 1.0
+ */
+constexpr int LimitLayout(int layout, unsigned int maxChannels)
+{
+  if (maxChannels == 0 || ChannelsOfLayout(layout) == 0 || ChannelsOfLayout(layout) <= maxChannels)
+    return layout;
+
+  for (int lower = layout - 1; lower > 0; --lower)
+  {
+    if (ChannelsOfLayout(lower) <= maxChannels)
+      return lower;
+  }
+  return 0;
+}
+} // namespace AE::PCM
