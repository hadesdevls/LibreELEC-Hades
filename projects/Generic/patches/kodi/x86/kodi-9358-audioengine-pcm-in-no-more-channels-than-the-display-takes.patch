+unsigned int CActiveAESink::GetMaxPcmChannels(const std::string& device) const
+{
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+
+  for (const auto& sink : m_sinkInfoList)
+  {
+    if (sink.m_sinkName != dev.driver)
+      continue;
+
+    for (const auto& info : sink.m_deviceInfoList)
+    {
+      if (info.m_deviceName == dev.name)
+        return info.m_maxPcmChannels;
+    }
+  }
+  return 0;
+}
