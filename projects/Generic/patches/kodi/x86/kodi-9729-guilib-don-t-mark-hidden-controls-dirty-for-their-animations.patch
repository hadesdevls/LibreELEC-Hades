From 153c2546509e48b5cc353ea206ad3d8e02e08540 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 24 Oct 2026 16:48:32 +0200
Subject: [PATCH] [guilib] Don't mark hidden controls dirty for their
 animations

Animations of hidden controls keep running, e.g. a looping rotation of
a busy spinner that is only visible while a widget loads. Each step
marked the control dirty, so its last region was redrawn and the
window processed on every frame, even though nothing is drawn.

Only mark animation steps dirty while the control is visible before or
after animating, so the end of a hide animation and the start of a
show animation are still redrawn. A control waiting for a delayed show
animation, or a hidden control running a focus or window close
animation, is only kept processed, so focus actions still run and the
window can finish closing.
---
 xbmc/guilib/GUIControl.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUIControl.cpp b/xbmc/guilib/GUIControl.cpp
index 992f61f..2e86942 100644
--- a/xbmc/guilib/GUIControl.cpp
+++ b/xbmc/guilib/GUIControl.cpp
@@ -134,6 +134,7 @@ void CGUIControl::DoProcess(unsigned int currentTime, CDirtyRegionList &dirtyreg
 
   // If the control has an active animation, mark it as dirty even if culled because the
   // animation might change the alpha at a later time so processing needs to continue
+  const bool wasVisible = IsVisible();
   const bool animated = Animate(currentTime);
 
   const bool culled = m_transform.alpha <= 0.01f;
@@ -141,11 +142,15 @@ void CGUIControl::DoProcess(unsigned int currentTime, CDirtyRegionList &dirtyreg
   // if the control changed culling state from true to false, mark it.
   const bool cullingChanged = m_isCulled != culled;
 
-  if (cullingChanged || animated)
+  // animations of hidden controls aren't drawn
+  if (cullingChanged || (animated && (wasVisible || IsVisible())))
   {
     m_isCulled = false; // set to false so MarkDirtyRegion() isn't a no-op
     MarkDirtyRegion();
   }
+  else if (animated && (m_visible == DELAYED || IsAnimating(ANIM_TYPE_FOCUS) ||
+                        IsAnimating(ANIM_TYPE_UNFOCUS) || IsAnimating(ANIM_TYPE_WINDOW_CLOSE)))
+    MarkDirtyRegion(DIRTY_STATE_CHILD); // keep processing for delays, focus actions and closing
   m_isCulled = culled;
 
   if (IsVisible())
-- 
