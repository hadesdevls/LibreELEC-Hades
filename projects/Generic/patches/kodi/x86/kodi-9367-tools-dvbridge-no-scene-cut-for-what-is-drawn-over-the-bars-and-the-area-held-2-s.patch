From 76384c093840f8a73705d26a68d52882751133e6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:36:33 +0000
Subject: [PATCH] tools/dvbridge: no scene cut for what is drawn over the bars,
 and the area held 2 s

What is drawn over the bars of a film (subtitles in a bar, the OSD, a
menu) takes those edges into the level 5 active area that the display is
sent, so that the area holds every pixel transported (ETSI GS CCM 001
V1.1.1, 6.2.2: the metadata of levels 1 and 2 "shall be applied to the
active area"). Each change of that area also set scene_refresh_flag. So
the display started its mapping again in the middle of a scene with every
line of subtitles in a bar, every time the OSD came or went, and at every
switch between the way that waits (the edges measured) and a frame ahead
(every edge with bars): in a host test, 20 scene cuts in 30 s of film with
a menu over the bottom bar while the presentation switched every 36
frames. In a pause, the repeats after such a change kept the flag set:
every refresh of the still picture was a scene cut too.

6.2.2 has scene_refresh_flag say that the picture "is the first picture of
a scene". What is drawn over the bars does not make one, and the content
range and trims of levels 1 and 2 stay the scene's. A change of the area is
a change of the metadata, which takes a new metadata_id (6.3.1: "Each time
the metadata of the HDR picture changes in a way that requires
transmission of new HDR DM metadata, a metadata_id is incremented"). So the
flag is now the RPU's, or the serializer's own after a gap, a seek or a
new stream, and nothing else; a repeat keeps the payload of the frame it
repeats.

An edge now also stays taken out for 2 s of the video after the last frame
with something drawn over the bars beyond it. The lines of subtitles in a
bar, and an OSD shown again, come and go within that: the area sent
changes once when they come and once 2 s after they are gone, not with
each of them (a minute of subtitles, 3 s a line with 0.8 s between: 2
changes, 32 before). The area is taken out from the first frame something
is drawn on, so no frame is sent with an area that leaves out what it
carries; held, it is only wider than the film's, with the bars in it, as
while the GUI was there. In a pause the video time stands still, and so
does the area. A seek backwards and a new stream hold nothing from before.

Tested on the host:
- ser2_test, the serializer alone, against 1.0 RC2 and this tree: with
  1.0 RC2 8 of its 13 checks fail (the cases above), with this tree none;
  with nothing drawn over the bars, 210 frames with scene cuts, a gap and a
  pause give the same packets with both; seven mutations each make it fail
  (no reset at a seek backwards or a new stream, no hold, a hold of 1 s,
  the edges drawn over not taken, a scene cut at each change, a repeat as
  a scene cut);
- cover_test, through the renderer and read back from the packed bytes:
  an OSD strip over the bottom bar in 6 frames, then nothing: the bottom
  edge taken out from the first of them to the first frame 2 s after the
  last, two changes of the metadata id, no scene cut.

Not verified: how a display takes a change of the area without a scene
cut (no display here; the LG C5 of the tests sends nothing back about it).
---
 tools/dvbridge/dvbridge_core.h     |  7 ++--
 tools/dvbridge/dvbridge_metadata.h | 60 +++++++++++++++++++-----------
 2 files changed, 43 insertions(+), 24 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 7ab31cf..0f75d44 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -43,9 +43,10 @@ struct dvbridge_candidate *dvbridge_prepare_transport(
 void dvbridge_candidate_destroy(struct dvbridge_candidate *candidate);
 /* Hades: the candidate made again with the level 5 block taken out to what is drawn over the bars:
  * cover, the edges of the active picture beyond which something is drawn over the picture (1 left,
- * 2 right, 4 top, 8 bottom), whose offsets are sent as 0; and the scene refreshed where that changes
- * the area sent from the last frame's (dvbridge_dv_metadata()). 0: as dvbridge_prepare() made it.
- * The blanking margins (dvbridge_active_area()) stay the film's. */
+ * 2 right, 4 top, 8 bottom), whose offsets are sent as 0, and those held from the frames before it
+ * (DVBRIDGE_DV_COVER_HOLD); a change of the area sent takes a new metadata id and is not a scene cut
+ * (dvbridge_dv_metadata()). 0: as dvbridge_prepare() made it (the edges held, then, only). The
+ * blanking margins (dvbridge_active_area()) stay the film's. */
 bool dvbridge_candidate_cover(struct dvbridge_candidate *candidate, unsigned cover);
 bool dvbridge_commit(struct dvbridge_context *context, const struct dvbridge_candidate *candidate);
 /* The transport packets of the candidate: count packets of 128 bytes, as 32 words each, four bytes
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index ae92f09..9247e82 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -56,14 +56,20 @@ struct dvbridge_dv {
     unsigned gaps_seen;
     /* Hades: the blanking margins of the frame in the 3840x2160 raster (left, right, top, bottom):
      * what the renderer paints black, and what the level 5 block sends where nothing is drawn over
-     * the bars (cover: sent_l5) */
+     * the bars (cover: held_until) */
     unsigned margins[4];
     struct dvbridge_dv_reading reading;
-    /* Hades: the level 5 block of the last frame (the raster's left, right, top, bottom offsets), and
-     * whether it was taken out beyond the margins to what was drawn over the bars (cover) */
-    unsigned sent_l5[4];
-    bool sent_extended;
+    /* Hades: until when (a presentation time) each edge of the active picture (left, right, top,
+     * bottom) stays taken out in the level 5 block sent, since something was last drawn over the bars
+     * beyond it (cover, DVBRIDGE_DV_COVER_HOLD); 0: not taken out */
+    double held_until[4];
 };
+/* Hades: how long an edge of the active area sent stays taken out after the last frame that had
+ * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
+ * OSD that is shown again, come and go within it: the area sent changes once when they come and once
+ * when they are gone, not with each of them. (In a pause the video time stands still, and so does
+ * the area.) */
+#define DVBRIDGE_DV_COVER_HOLD (2.0 * DVBRIDGE_PTS_PER_SECOND)
 #define DV_REQUIRE(x) do { if (!(x)) return false; } while (0)
 /* Presentation times reach the serializer in AV_TIME_BASE units (microseconds), as Kodi passes
  * them; the reviewed mpv adapter passed seconds. */
@@ -273,7 +279,19 @@ static inline bool dvbridge_dv_gap_refresh(struct dvbridge_dv *d, double gap)
  * around what is drawn would need its bounds on the CPU before the packets are made, a wait for the
  * GPU in every frame with something drawn over it; an edge each takes one of 16 areas, which
  * dvbridge_candidate_cover() makes again once the edges are known.) The blanking margins stay the
- * film's. */
+ * film's.
+ * Hades: an edge stays taken out for DVBRIDGE_DV_COVER_HOLD after the last frame with something
+ * drawn over the bars beyond it (held_until), so that the area does not change with every line of
+ * subtitles or every frame presented a frame ahead (which takes every edge that has bars). The area
+ * still holds every pixel that is drawn over, from the frame it is first drawn on: nothing is late.
+ * A change of the area sent takes a new metadata id, as any change of the metadata does (6.3.1:
+ * "Each time the metadata of the HDR picture changes in a way that requires transmission of new HDR
+ * DM metadata, a metadata_id is incremented"), and is not a scene cut: the flag is the RPU's (6.2.2:
+ * scene_refresh_flag says that the picture "is the first picture of a scene"; what is drawn over
+ * the bars does not make one, and the content range and trims of levels 1 and 2 stay the scene's).
+ * It was: every change of the area refreshed the scene, so every line of subtitles in a bar, the
+ * OSD, and every switch of the presentation a frame ahead made the display start its mapping again
+ * in the middle of a scene. */
 static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetadata *m, double pts,
                                         bool source, unsigned cover)
 {
@@ -290,6 +308,17 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
      * repeat, not backwards) */
     bool refresh = !d->frames || pts < d->last_pts ||
                    (!repeat && dvbridge_dv_gap_refresh(d, pts - d->last_pts));
+    /* Hades: the edges taken out: drawn over in this frame, or held from one before it (a video that
+     * goes back, a seek backwards, holds none from before) */
+    if (d->frames && pts < d->last_pts)
+        memset(d->held_until, 0, sizeof(d->held_until));
+    unsigned taken = 0;
+    for (int j = 0; j < 4; j++) {
+        if (cover >> j & 1)
+            d->held_until[j] = pts + DVBRIDGE_DV_COVER_HOLD;
+        if (d->held_until[j] > pts)
+            taken |= 1u << j;
+    }
     d->reading.skipped = d->reading.skipped_level = 0;
     d->size = 0;
     d->payload[d->size++] = 0;
@@ -330,7 +359,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     unsigned count_pos = d->size++;
     d->payload[count_pos] = 0;
     d->blocks_at = count_pos;
-    unsigned l1 = 0, area = 0, targets[AV_DOVI_MAX_EXT_BLOCKS], ntargets = 0, sent[4] = {0};
+    unsigned l1 = 0, area = 0, targets[AV_DOVI_MAX_EXT_BLOCKS], ntargets = 0;
     const AVDOVIDmData *ordered[AV_DOVI_MAX_EXT_BLOCKS];
     unsigned order[AV_DOVI_MAX_EXT_BLOCKS];
     for(int i=0;i<m->num_ext_blocks;i++) {
@@ -372,8 +401,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
                                            e->l5.top_offset, e->l5.bottom_offset, v));
             memcpy(d->margins, v, sizeof(d->margins));
             for (int j = 0; j < 4; j++)
-                if (cover >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
-            memcpy(sent, v, sizeof(sent)); break;
+                if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
+            break;
         case 4: case 3: case 8: case 9: case 10: case 11: case 254: {
             uint8_t wire[32];
             DV_REQUIRE(e->dvbridge_raw_magic==0x41424456);
@@ -403,24 +432,13 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         unsigned v[4];DV_REQUIRE(dvbridge_dv_margins(d,0,0,0,0,v));
         memcpy(d->margins, v, sizeof(d->margins));
         for (int j = 0; j < 4; j++)
-            if (cover >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
-        memcpy(sent, v, sizeof(sent));
+            if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
         DV_REQUIRE(d->size+13 <= DVBRIDGE_DV_MAX_PAYLOAD);
         dvbridge_dv_u32(d,8);d->payload[d->size++]=5;
         for (int j=0;j<4;j++) dvbridge_dv_u16(d,v[j]);
         d->payload[count_pos]++;
     }
     DV_REQUIRE(d->size<=DVBRIDGE_DV_MAX_PAYLOAD && d->payload[count_pos]<=AV_DOVI_MAX_EXT_BLOCKS);
-    /* Hades: where the active area sent changes because of what is drawn over the bars (it is taken
-     * out, comes back, or goes out to other edges), the frame is the first of a scene (6.2.2:
-     * scene_refresh_flag "indicates that the picture, which DM metadata affects, is the first
-     * picture of a scene"): the display starts its mapping again on the area that the metadata now
-     * applies to. Between frames whose area is the film's, nothing changes. */
-    const bool extended = memcmp(sent, d->margins, sizeof(sent)) != 0;
-    if (d->frames && (extended || d->sent_extended) && memcmp(sent, d->sent_l5, sizeof(sent)))
-        d->payload[1] = 1;
-    memcpy(d->sent_l5, sent, sizeof(sent));
-    d->sent_extended = extended;
     if (d->frames && (d->previous_size != d->size || memcmp(d->previous, d->payload, d->size))) {
         d->id = (d->id + 1) & 15; d->changes++;
     } else if (!d->frames && d->restart) {
-- 
