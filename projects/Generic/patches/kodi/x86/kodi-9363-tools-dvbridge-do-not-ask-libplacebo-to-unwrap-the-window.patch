From 6bc10305e22736b65013ce22e230942207cd67e4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 15:12:50 +0000
Subject: [PATCH] tools/dvbridge: do not ask libplacebo to unwrap the window

A frame drawn directly in the source transport is packed into the
framebuffer of its target (render_source()). Kodi's target is its window,
the default framebuffer, which the bridge wraps without a texture, and
pl_opengl_unwrap() refuses a wrapped framebuffer: every such frame logged
"Trying to call `pl_opengl_unwrap` on a pseudo-texture (perhaps obtained
by `pl_swapchain_start_frame`?)" as an error (issue 3, and every native
output since the source transport). The frame went out right all the
same, packed into framebuffer 0, because the variable that the call
leaves alone held 0. But the bridge logs the first 64 messages of
libplacebo and one in 1000 after them, for as long as Kodi runs: those 64
were spent on this one within the first seconds of the first native
output, and a real failure of libplacebo after them would most likely not
have been logged.

Now the bridge tells the renderer which target wraps the window
(dvbridge_render_set_window(), set again whenever the window is wrapped
anew or let go, since another object may take its address), and that one
is packed into as framebuffer 0 without asking libplacebo. Any other
target is a texture, packed into through the framebuffer that libplacebo
made with it; one with neither is not packed into in the source
transport (it was packed into framebuffer 0).

Measured on Mesa's software OpenGL ES (zink on lavapipe), with the
default framebuffer of a pbuffer wrapped as the bridge wraps Kodi's
window (cover_test.c): a picture of a profile 7 FEL stream drawn directly
in the source transport into it has the bytes that it has drawn into a
texture, and libplacebo logs nothing (the tree before: the same bytes,
and the message once for each frame); with the window not set, the frame
does not go out in the source transport there, and the message is logged
(the test sees it).
---
 tools/dvbridge/dvbridge_render.c              | 20 ++++++++++++++++---
 tools/dvbridge/dvbridge_render.h              |  7 +++++++
 .../VideoRenderers/DVBridgeGLES.cpp           |  8 ++++++++
 3 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index e683185..b7b8ee7 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -72,6 +72,8 @@ struct dvbridge_renderer {
      * those that the transport does not read (dvbridge_render_reference()) */
     bool all_rows;
     struct dvbridge_geometry geometry; /* of the last picture prepared */
+    /* Hades: the target that wraps the window (dvbridge_render_set_window()), or NULL */
+    pl_tex window;
 };
 
 /* Hades: the alpha of the picture of the composed way, that Kodi draws over: its blend functions
@@ -663,9 +665,15 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
                               r->all_rows);
     unsigned fbo = 0;
     if (ok && target) {
-        /* the framebuffer of the target (0 for a wrapped default framebuffer, as Kodi's window) */
-        pl_opengl_unwrap(r->gpu, target, NULL, NULL, &fbo);
-        ok = source_pack(r, 0, fbo, flip);
+        /* the framebuffer of the target. Hades: the window, the default framebuffer that Kodi wraps
+         * (dvbridge_render_set_window()), is framebuffer 0, and not a texture: pl_opengl_unwrap()
+         * refuses a wrapped framebuffer, and said so in the log at every frame drawn this way (its
+         * first 64 messages and one in 1000 after them, which then took those of every other
+         * failure of libplacebo with them). A texture has the framebuffer that libplacebo made
+         * with it; one without either is not packed into. */
+        if (target != r->window)
+            ok = pl_opengl_unwrap(r->gpu, target, NULL, NULL, &fbo) && fbo;
+        ok = ok && source_pack(r, 0, fbo, flip);
     } else if (ok) {
         pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, &fbo);
         ok = fbo && dvbridge_source_picture(r->source_packer, &r->source_params, luma,
@@ -1494,6 +1502,12 @@ void dvbridge_render_use_source_transport(struct dvbridge_renderer *r, bool use)
         r->source_wanted = use;
 }
 
+void dvbridge_render_set_window(struct dvbridge_renderer *r, pl_tex window)
+{
+    if (r)
+        r->window = window;
+}
+
 bool dvbridge_render_source(const struct dvbridge_renderer *r, const char **why)
 {
     if (why)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index f954e82..34f5737 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -229,6 +229,13 @@ bool dvbridge_render_source(const struct dvbridge_renderer *renderer, const char
 /* The GL textures of the composed planes of the last picture, where it goes out in the source
  * transport: the luma and the chroma (Cb, Cr at 4:2:0), h / 2^12 (for the host test) */
 bool dvbridge_render_source_planes(const struct dvbridge_renderer *renderer, unsigned textures[2]);
+/* Hades: the target of dvbridge_render_packed() that wraps the window: the default framebuffer
+ * (pl_opengl_wrap() without a texture or a framebuffer), which the packer of the source transport
+ * draws into as framebuffer 0. Any other target is a texture, which is packed into through the
+ * framebuffer that libplacebo made with it. NULL: none. Set again whenever that wrapper is made anew
+ * or destroyed (another object may take its address). */
+#define DVBRIDGE_RENDER_WINDOW 1
+void dvbridge_render_set_window(struct dvbridge_renderer *renderer, pl_tex window);
 /* Whether dvbridge_render_packed() may draw a picture of this geometry: full raster, or, with the
  * source transport, a picture drawn at its own size anywhere */
 bool dvbridge_render_direct_fits(const struct dvbridge_renderer *renderer,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 95a0951..d201b9d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -360,6 +360,8 @@ void CDVBridgeGLES::UpdateScanout()
   }
   if (!same)
   {
+    // Hades: the renderer no longer takes it for the window (another object may take its address)
+    dvbridge_render_set_window(m_renderer, nullptr);
     pl_tex_destroy(m_gl->gpu, &m_scanout);
     if (usable)
     {
@@ -369,6 +371,9 @@ void CDVBridgeGLES::UpdateScanout()
       output.width = 3840;
       output.height = 2160;
       m_scanout = pl_opengl_wrap(m_gl->gpu, &output);
+      // Hades: the default framebuffer, which the packer of the source transport draws into as
+      // framebuffer 0 (it is not a texture to unwrap)
+      dvbridge_render_set_window(m_renderer, m_scanout);
     }
     CLog::Log(LOGDEBUG, "DVBridge: the window was looked at again: packed_scanout={} rgb_bits={}/{}/{}/{} "
                         "samples={} linear_encoding={}",
@@ -474,6 +479,9 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE &&
       red == 8 && green == 8 && blue == 8 && samples <= 1 && encoding == GL_LINEAR)
     m_scanout = pl_opengl_wrap(m_gl->gpu, &output);
+  // Hades: the default framebuffer, which the packer of the source transport draws into as
+  // framebuffer 0 (it is not a texture to unwrap)
+  dvbridge_render_set_window(m_renderer, m_scanout);
   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
   glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
   m_packer = dvbridge_gl_packer_create(DVBRIDGE_VERTEX, DVBRIDGE_FRAGMENT);
