+void CVideoPlayer::AttachPlayedVideo(CFileItem& item) const
+{
+  VideoStreamInfo info;
+  GetVideoStreamInfo(CURRENT_STREAM, info);
+  if (!info.valid)
+    return;
+  KODI::UTILS::LIBRARYHDR::Played played;
+  played.codec = info.codecName;
+  played.width = info.width;
+  played.height = info.height;
+  played.hdr = KODI::UTILS::LIBRARYHDR::OfPlayback(
+      CStreamDetails::HdrTypeToString(info.hdrType), info.hdrDetail,
+      info.hdrTypeAlt == StreamHdrType::HDR_TYPE_HLG, m_processInfo->GetVideoHdr10Plus(),
+      m_processInfo->GetVideoTransfer());
+  KODI::VIDEO::PLAYEDHDR::Attach(item, played);
+}
