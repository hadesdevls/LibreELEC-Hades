+ */
+
+#pragma once
+
+/*!
+ * \brief Hades: the HDR that a playback found of its video, taken to the details the library keeps
+ *
+ * The player puts what it found of the video it played on the item that it gives back when the
+ * playback ends (Attach(), CVideoPlayer::OnExit()): only where that video is the one of the item
+ * (not a Blu-ray playlist other than the one kept for the item, nor a DVD). CSaveFileState::DoWork()
+ * takes it (Take()) and makes the details that it stores, or that the library has, say what it
+ * adds (Refine(), LibraryHdr.h), in Kodi's own columns. Nothing else of the details changes.
+ */
+
+#include "FileItem.h"
+#include "utils/LibraryHdr.h"
+#include "utils/StreamDetails.h"
+#include "utils/Variant.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace KODI::VIDEO::PLAYEDHDR
+{
+namespace LIBRARYHDR = ::KODI::UTILS::LIBRARYHDR;
+
+//! The property of the item that carries it (from the player to CSaveFileState)
+constexpr const char* PROPERTY = "hades.playedvideo";
+
+inline void Attach(CFileItem& item, const LIBRARYHDR::Played& played)
+{
+  CVariant v(CVariant::VariantTypeObject);
+  v["codec"] = played.codec;
+  v["width"] = played.width;
+  v["height"] = played.height;
+  v["type"] = played.hdr.type;
+  v["detail"] = played.hdr.detail;
+  v["alt"] = played.hdr.alt;
+  item.SetProperty(PROPERTY, v);
+}
+
+//! What the player put on the item, which is taken off it
+inline std::optional<LIBRARYHDR::Played> Take(CFileItem& item)
+{
+  if (!item.HasProperty(PROPERTY))
+    return std::nullopt;
+  const CVariant v = item.GetProperty(PROPERTY);
+  item.ClearProperty(PROPERTY);
+  if (!v.isObject())
+    return std::nullopt;
+  LIBRARYHDR::Played played;
+  played.codec = v["codec"].asString();
+  played.width = static_cast<int>(v["width"].asInteger());
+  played.height = static_cast<int>(v["height"].asInteger());
+  played.hdr = {v["type"].asString(), v["detail"].asString(), v["alt"].asString()};
+  return played;
+}
+
+/*!
+ * \brief Makes the details say what the playback adds to them
+ * \param fileOfItem the details are of the file that played (not a .strm, nor a stream that can be
+ *        another video at each playback)
+ * \return the decision; the details are changed where it is REFINED
+ */
+inline LIBRARYHDR::Decision Refine(CStreamDetails& details,
+                                   const LIBRARYHDR::Played& played,
+                                   bool fileOfItem)
+{
+  using namespace LIBRARYHDR;
+  std::vector<VideoRow> rows;
+  bool nfo = false;
+  const int videos = details.GetVideoStreamCount();
+  for (int i = 1; i <= videos; ++i)
+  {
+    const auto* v =
+        static_cast<const CStreamDetailVideo*>(details.GetNthStream(CStreamDetail::VIDEO, i));
+    if (!v)
+      break;
+    rows.push_back({v->m_strCodec, v->m_iWidth, v->m_iHeight, v->m_strHdrType, v->m_strHdrDetail});
+    nfo = nfo || v->GetSource() == CStreamDetail::NFO;
+  }
+  if (rows.size() != static_cast<size_t>(videos))
+    return {Verdict::NOT_ONE_VIDEO, 0, {}, {}};
+
+  // (details from an NFO keep what they say; a type is given only where they say none and are not
+  // from one)
+  const Decision d = Decide(rows, played, fileOfItem && !nfo);
+  if (d.verdict != Verdict::REFINED)
+    return d;
+
+  // the video stream as a scan writes it (CDVDFileInfo::DemuxerToStreamDetails()), then its virtual
+  // stream, then the audio and subtitle streams as they were
+  CStreamDetails out;
+  const auto* main = static_cast<const CStreamDetailVideo*>(
+      details.GetNthStream(CStreamDetail::VIDEO, static_cast<int>(d.main) + 1));
+  auto* video = new CStreamDetailVideo(*main);
+  video->m_strHdrType = d.after.type;
+  video->m_strHdrDetail = d.after.type == DOLBY_VISION ? d.after.detail : std::string();
+  video->m_strHdrTypeAlt = d.after.alt;
+  out.AddStream(video);
+  if (!d.after.alt.empty())
+  {
+    auto* alt = new CStreamDetailVideo(*video);
+    alt->m_strHdrType = d.after.alt;
+    alt->m_strHdrDetail.clear();
+    out.AddStream(alt);
+  }
+  for (int i = 1; i <= details.GetAudioStreamCount(); ++i)
+    if (const auto* a = details.GetNthStream(CStreamDetail::AUDIO, i))
+      out.AddStream(new CStreamDetailAudio(static_cast<const CStreamDetailAudio&>(*a)));
+  for (int i = 1; i <= details.GetSubtitleStreamCount(); ++i)
+    if (const auto* s = details.GetNthStream(CStreamDetail::SUBTITLE, i))
+      out.AddStream(new CStreamDetailSubtitle(static_cast<const CStreamDetailSubtitle&>(*s)));
+  out.DetermineBestStreams();
+  details = out;
+  return d;
+}
+
+} // namespace KODI::VIDEO::PLAYEDHDR
