+/*!
+ * \brief Hades: whether the details of a file are of the very video that played: not of a .strm,
+ *        an add-on's item or a stream, which can be another video at each playback
+ */
+bool DetailsOfPlayedFile(const std::string& path)
+{
+  return !URIUtils::HasExtension(path, ".strm") && !URIUtils::IsPlugin(path) &&
+         !URIUtils::IsInternetStream(path) && !URIUtils::IsUPnP(path);
+}
+
+void LogPlayedHdr(const KODI::UTILS::LIBRARYHDR::Decision& d,
+                  const KODI::UTILS::LIBRARYHDR::Played& played)
+{
+  using namespace KODI::UTILS::LIBRARYHDR;
+  switch (d.verdict)
+  {
+    case Verdict::REFINED:
+      CLog::Log(LOGINFO,
+                "CSaveFileState: the library's details of the video now say {} (they said {}), "
+                "as its playback found",
+                Describe(d.after), Describe(d.before));
+      break;
+    case Verdict::CONTRADICTED:
+      CLog::Log(LOGINFO,
+                "CSaveFileState: the playback found {}, the library's details of the video say "
+                "{}: they are kept as they are",
+                Describe(played.hdr), Describe(d.before));
+      break;
+    case Verdict::OTHER_VIDEO:
+      CLog::Log(LOGINFO,
+                "CSaveFileState: the playback was of a video ({} {}x{}) other than the one of the "
+                "library's details: they are kept as they are",
+                played.codec, played.width, played.height);
+      break;
+    case Verdict::SAME:
+    case Verdict::NOT_ONE_VIDEO:
+      CLog::Log(LOGDEBUG, "CSaveFileState: the playback found {}, the details say {}{}",
+                Describe(played.hdr), Describe(d.before),
+                d.verdict == Verdict::SAME ? "" : " (they are not of one video stream)");
+      break;
+  }
+}
