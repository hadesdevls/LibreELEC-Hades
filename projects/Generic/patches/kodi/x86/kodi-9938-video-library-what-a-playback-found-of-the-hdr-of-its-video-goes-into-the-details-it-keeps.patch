+#pragma once
+
+/*!
+ * \brief Hades: what a playback found of the HDR of its video, and what the library keeps of it
+ *
+ * The library keeps the HDR of a video in the stream details of its file, in Kodi's own columns
+ * (see DolbyVisionLibrary.h): the HDR type of the video stream ("dolbyvision", "hdr10",
+ * "hdr10plus", "hlg", or nothing), the Dolby Vision profile in its HDR detail ("5", "7FEL", "8.1"),
+ * and, for a Dolby Vision stream whose base layer is also HDR10+ or HLG, a second, virtual, video
+ * stream of that type (CDVDFileInfo::DemuxerToStreamDetails()). A scan reads it from the file. A
+ * file that is not scanned (a .strm, a disc, a stream) gets the details that its first playback
+ * knew when it began, and a file scanned with an older Kodi keeps what that one knew.
+ *
+ * What is here is pure (no Kodi): what a playback knows of its video when it ends, and whether that
+ * says more than the details do. It only ever adds: the profile of a Dolby Vision stream whose
+ * details do not have it, the layer of a profile 7 stream ("7" -> "7FEL"/"7MEL"), the HDR10+ or HLG
+ * of a Dolby Vision stream as its virtual stream, HDR10+ for HDR10, and, where the details are of
+ * the very file that played (not a .strm or a stream, which can name another video each time) and
+ * not from an NFO, the HDR type where they have none. Anything the details say that the playback
+ * contradicts is kept as it is; a playback that knows less changes nothing.
+ */
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace KODI::UTILS::LIBRARYHDR
+{
+
+constexpr std::string_view DOLBY_VISION = "dolbyvision";
+constexpr std::string_view HDR10 = "hdr10";
+constexpr std::string_view HDR10_PLUS = "hdr10plus";
+constexpr std::string_view HLG = "hlg";
+
+//! The HDR of a video as the library keeps it
+struct Hdr
+{
+  std::string type; //!< the HDR type of the video stream; empty: none said
+  std::string detail; //!< of Dolby Vision: the profile ("5", "7FEL", "8.1")
+  std::string alt; //!< of Dolby Vision: the type of its virtual stream ("hdr10plus", "hlg")
+
+  bool operator==(const Hdr& other) const = default;
+};
+
+//! A video stream of the stream details, as the library keeps it (a row of streamdetails)
+struct VideoRow
+{
+  std::string codec;
+  int width = 0;
+  int height = 0;
+  std::string type; //!< strHdrType
+  std::string detail; //!< strHdrDetail
+};
+
+//! What a playback found of its video stream
+struct Played
+{
+  std::string codec;
+  int width = 0;
+  int height = 0;
+  Hdr hdr;
+};
+
+/*!
+ * \brief The HDR of the video of a playback, as the library keeps it
+ * \param streamType the HDR type of the stream, as the demuxer says it (CStreamDetails::
+ *        HdrTypeToString(): "dolbyvision", "hdr10", "hlg", or empty)
+ * \param dvDetail of a Dolby Vision stream, its profile as the player gives it ("8.1", and for
+ *        profile 7 "7FEL"/"7MEL" once its pictures told the layer, "7" before)
+ * \param hlgBase the base layer of the Dolby Vision stream is HLG (profile 8.4)
+ * \param hdr10Plus a decoded picture of the stream carried HDR10+ metadata
+ * \param transfer the transfer function of its first decoded picture (AVCOL_TRC_*: 16 PQ, 18 HLG;
+ *        -1 before one): it names the HDR of a stream that says none itself (an add-on's stream
+ *        of HLG, as the player information names it, HadesPlayerInfo.h SourceHdrType())
+ */
+inline Hdr OfPlayback(std::string_view streamType,
+                      std::string_view dvDetail,
+                      bool hlgBase,
+                      bool hdr10Plus,
+                      int transfer)
+{
+  constexpr int TRANSFER_PQ = 16;
+  constexpr int TRANSFER_HLG = 18;
+  Hdr hdr;
+  if (streamType == DOLBY_VISION)
+  {
+    hdr.type = DOLBY_VISION;
+    hdr.detail = dvDetail;
+    if (hlgBase)
+      hdr.alt = HLG;
+    else if (hdr10Plus)
+      hdr.alt = HDR10_PLUS;
+  }
+  else if (streamType == HDR10 || streamType == HDR10_PLUS)
+    hdr.type = hdr10Plus || streamType == HDR10_PLUS ? HDR10_PLUS : HDR10;
+  else if (streamType.empty())
+  {
+    if (transfer == TRANSFER_HLG)
+      hdr.type = HLG;
+    else if (transfer == TRANSFER_PQ)
+      hdr.type = HDR10;
+  }
+  else
+    hdr.type = streamType;
+  return hdr;
+}
+
+//! What a playback does to the details of its video
+enum class Verdict
+{
+  SAME, //!< the playback found what the details say, or less
+  REFINED, //!< the details say more now (Decision::after)
+  CONTRADICTED, //!< the playback found other than the details say: they are kept
+  OTHER_VIDEO, //!< the video of the playback is not the one of the details (codec or size)
+  //! the details have no video stream, or streams that are not one video and its virtual stream
+  NOT_ONE_VIDEO,
+};
+
+struct Decision
+{
+  Verdict verdict = Verdict::SAME;
+  size_t main = 0; //!< the row of the video stream (of a Dolby Vision one and its virtual stream)
+  Hdr before; //!< what the details say
+  Hdr after; //!< what they say now: before, unless REFINED
+};
+
+namespace DETAIL
+{
+inline bool SameCodec(std::string_view a, std::string_view b)
+{
+  if (a.size() != b.size())
+    return false;
+  for (size_t i = 0; i < a.size(); ++i)
+  {
+    const char x = a[i] >= 'A' && a[i] <= 'Z' ? static_cast<char>(a[i] - 'A' + 'a') : a[i];
+    const char y = b[i] >= 'A' && b[i] <= 'Z' ? static_cast<char>(b[i] - 'A' + 'a') : b[i];
+    if (x != y)
+      return false;
+  }
+  return true;
+}
+
+inline bool SameVideo(const VideoRow& a, const VideoRow& b)
+{
+  return SameCodec(a.codec, b.codec) && a.width == b.width && a.height == b.height;
+}
+
+inline bool IsProfile7(std::string_view detail)
+{
+  return detail == "7";
+}
+
+inline bool IsProfile7WithLayer(std::string_view detail)
+{
+  return detail == "7FEL" || detail == "7MEL";
+}
+} // namespace DETAIL
+
+/*!
+ * \brief Whether what a playback found of its video says more than the details of it
+ * \param rows the video streams of the details, in their order
+ * \param played what the playback found
+ * \param fillType whether a type may be given where the details have none: details of the file
+ *        that played itself (not a .strm or a stream), and not from an NFO
+ */
+inline Decision Decide(const std::vector<VideoRow>& rows, const Played& played, bool fillType)
+{
+  using namespace DETAIL;
+  Decision d;
+  // the video of the details: one stream, or a Dolby Vision stream and its virtual stream (the same
+  // video with the type of its base layer, HDR10+ or HLG), in either order
+  if (rows.size() == 1)
+  {
+    d.main = 0;
+    d.before = {rows[0].type, rows[0].detail, {}};
+  }
+  else if (rows.size() == 2 && SameVideo(rows[0], rows[1]))
+  {
+    const size_t dv = rows[0].type == DOLBY_VISION ? 0 : rows[1].type == DOLBY_VISION ? 1 : 2;
+    const std::string_view other =
+        dv < 2 ? std::string_view(rows[1 - dv].type) : std::string_view();
+    if (dv == 2 || rows[1 - dv].type == DOLBY_VISION || (other != HDR10_PLUS && other != HLG))
+    {
+      d.verdict = Verdict::NOT_ONE_VIDEO;
+      return d;
+    }
+    d.main = dv;
+    d.before = {rows[dv].type, rows[dv].detail, std::string(other)};
+  }
+  else
+  {
+    d.verdict = Verdict::NOT_ONE_VIDEO;
+    return d;
+  }
+  d.after = d.before;
+
+  const VideoRow playedVideo{played.codec, played.width, played.height, {}, {}};
+  if (!SameVideo(rows[d.main], playedVideo) || played.codec.empty())
+  {
+    d.verdict = Verdict::OTHER_VIDEO;
+    return d;
+  }
+
+  const Hdr& p = played.hdr;
+  const auto contradicted = [&d]
+  {
+    d.after = d.before;
+    d.verdict = Verdict::CONTRADICTED;
+    return d;
+  };
+
+  // the type: the same; HDR10 that is HDR10+; or none where one may be given
+  if (p.type != d.before.type)
+  {
+    if (d.before.type == HDR10 && p.type == HDR10_PLUS)
+      d.after.type = HDR10_PLUS;
+    else if (d.before.type == HDR10_PLUS && p.type == HDR10)
+      return d; // (no HDR10+ was seen in what was decoded: that is knowing less)
+    else if (d.before.type.empty() && fillType)
+    {
+      d.after = p;
+      d.verdict = d.after == d.before ? Verdict::SAME : Verdict::REFINED;
+      return d;
+    }
+    else
+      return contradicted();
+  }
+
+  // of Dolby Vision, the profile and the virtual stream
+  if (d.after.type == DOLBY_VISION)
+  {
+    if (p.detail != d.before.detail && !p.detail.empty())
+    {
+      if (d.before.detail.empty() || (IsProfile7(d.before.detail) && IsProfile7WithLayer(p.detail)))
+        d.after.detail = p.detail;
+      else if (!(IsProfile7(p.detail) && IsProfile7WithLayer(d.before.detail)))
+        return contradicted();
+    }
+    if (p.alt != d.before.alt && !p.alt.empty())
+    {
+      if (d.before.alt.empty())
+        d.after.alt = p.alt;
+      else
+        return contradicted();
+    }
+  }
+
+  d.verdict = d.after == d.before ? Verdict::SAME : Verdict::REFINED;
+  return d;
+}
+
+//! For the log: "dolbyvision 7FEL with hdr10plus", "hdr10", "no HDR type"
+inline std::string Describe(const Hdr& hdr)
+{
+  if (hdr.type.empty())
+    return "no HDR type";
+  std::string out = hdr.type;
+  if (!hdr.detail.empty())
+    out.append(" ").append(hdr.detail);
+  if (!hdr.alt.empty())
+    out.append(" with ").append(hdr.alt);
+  return out;
+}
+
+} // namespace KODI::UTILS::LIBRARYHDR
