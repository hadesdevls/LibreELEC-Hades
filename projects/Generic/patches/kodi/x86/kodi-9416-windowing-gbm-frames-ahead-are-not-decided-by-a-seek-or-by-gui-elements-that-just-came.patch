From 8bc7b2e9e6a027f6ada4de0856b970671c3e9a2e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:42:28 +0000
Subject: [PATCH] windowing/gbm: frames ahead are not decided by a seek or by
 GUI elements that just came

Whether Dolby Vision frames are presented a frame ahead goes by the
average GPU time of each second of them (CDVAhead). The second after a
seek, and the second in which GUI elements come over the video, are not
like the ones that follow: the decoder starts again, the GPU's clocks are
still those of the lighter frames before, and the composed way is used
for the first time. In the log of an RTX 4080 Laptop GPU such a second
called for frames ahead and the next one no longer, six times in one
session (averages of 21 to 25 ms of 41.7 with frames of up to 57 to 112
ms in that second, then 13 to 16 ms with the GUI still there). On that
GPU it only told so; on an integrated one it switches the presentation
on and off. And on the integrated Radeon of a test PC (through Direct3D
12) a frame with Estuary's seek bar takes 23.9 ms of 41.7, over half of
it: every seek, with the seek bar that comes with it, would switch it on
and, a second after the seek bar goes, off.

Now a seek sets 2 s of the video aside (CDVAhead::Seeked(), as the
fidelity step-down sets them aside after a seek), and GUI elements that
come or go set aside the second that begins (Changed()). An average of
frames set aside calls for frames ahead only where they cannot keep up
at all, a refresh period or more each (the way that waits cannot show
them on time, whatever comes after), and never ends it. What is decided
stays; with no seek and no change, everything is as before.

Tested on the host: dvahead_aside_test.cpp, 8 checks (the laptop's
seconds, a seek with slow frames after it, a seek while frames ahead are
called for, an OSD of five seconds that calls for it, subtitles at 59.94
Hz that take more than a refresh, frames over a refresh after a seek, the
24th frame deciding as before, the end of a native output); 3 of them
fail with CDVAhead as it was. dvahead_test.cpp, 39 of 39. The window
system's file compiles with Kodi's compile commands. Not run on a GPU.
---
 xbmc/windowing/gbm/DVAhead.h                  | 51 ++++++++++++++++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 15 ++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  5 ++
 3 files changed, 69 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
index 51e840b..4741bda 100644
--- a/xbmc/windowing/gbm/DVAhead.h
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include <algorithm>
 #include <cmath>
 
 namespace KODI
@@ -39,6 +40,14 @@ namespace GBM
  * way that waits, by the window system, and is told here: after a few of them that come
  * close together nothing is tried again in that native output, and after a few such
  * outputs, not until Kodi starts again.
+ *
+ * Hades: the frames of the seconds around a seek, and of the first second after GUI elements come
+ * over the video or go, say little of the frames that follow (Seeked(), Changed()): an average of
+ * them calls for frames ahead only where the frames cannot keep up at all, taking a refresh period
+ * or more each, and never ends it. Without that, the second in which the GUI came called for frames
+ * ahead and the next one no longer (the log of an RTX 4080 Laptop GPU: averages of 21 to 25 ms of
+ * 41.7 in that second, with frames of up to 57 to 112 ms in it, against 13 to 16 ms in the seconds
+ * after it with the GUI still there; six times in one session, each over in one or two seconds).
  */
 class CDVAhead
 {
@@ -72,20 +81,29 @@ public:
       m_count = 0;
       m_sum = 0.0;
     }
+    // Hades: a frame of the time set aside makes its average one that decides for frames that
+    // cannot keep up only
+    if (m_asideMs > 0.0)
+    {
+      m_asideMs -= periodMs;
+      m_windowAside = true;
+    }
     m_sum += ms;
     if (++m_count < WINDOW)
       return Change::NONE;
     m_average = m_sum / m_count;
     m_count = 0;
     m_sum = 0.0;
+    const bool aside = m_windowAside;
+    m_windowAside = false;
     const bool needed = Needed(periodMs);
-    if (!needed && m_average >= HEAVY * periodMs)
+    if (!needed && m_average >= (aside ? 1.0 : HEAVY) * periodMs)
     {
       m_needed = true;
       m_neededPeriod = periodMs;
       return Change::NEEDED;
     }
-    if (needed && m_average <= LIGHT * periodMs)
+    if (needed && !aside && m_average <= LIGHT * periodMs)
     {
       m_needed = false;
       return Change::NOT_NEEDED;
@@ -96,6 +114,29 @@ public:
   //! The average that Measured() last decided with
   double Average() const { return m_average; }
 
+  //! Hades: the video jumped (a seek, a change of stream): its frames are slow and late for that
+  //! (the decoder starts again; the GPU's clocks go down while it waits, and the GUI comes with the
+  //! seek). SEEK_ASIDE_MS of them are set aside, as the fidelity step-down sets them aside
+  //! (CDVStepDown::Seeked()), and the average begins again.
+  void Seeked()
+  {
+    m_count = 0;
+    m_sum = 0.0;
+    m_windowAside = false;
+    m_asideMs = std::max(m_asideMs, SEEK_ASIDE_MS);
+  }
+
+  //! Hades: GUI elements came over the video, or went: the first frames drawn the other way are
+  //! slower than the ones after them (the GPU's clocks are still those of the lighter frames
+  //! before, and the other way is used for the first time). The average begins again, and its
+  //! first one is of the time set aside.
+  void Changed()
+  {
+    m_count = 0;
+    m_sum = 0.0;
+    m_windowAside = true;
+  }
+
   //! The frames at this refresh rate call for it, as far as they have been measured. Kept from
   //! one video to the next: the first frames of the next one then have it too.
   bool Needed(double periodMs) const { return m_needed && SamePeriod(periodMs, m_neededPeriod); }
@@ -160,6 +201,8 @@ public:
     m_presented = false;
     m_count = 0;
     m_sum = 0.0;
+    m_asideMs = 0.0;
+    m_windowAside = false;
     return gone;
   }
 
@@ -177,6 +220,8 @@ private:
   static constexpr unsigned int FAILURES = 3; //!< frames that give it up for a native output
   static constexpr unsigned int WORKED = 1440; //!< frames (a minute of film) that forget them
   static constexpr unsigned int OUTPUTS = 3; //!< such outputs in a row that give it up for good
+  //! Hades: the time of the video set aside after a seek (as CDVStepDown::SETTLE_MS)
+  static constexpr double SEEK_ASIDE_MS = 2000.0;
 
   unsigned int m_count = 0;
   double m_sum = 0.0;
@@ -190,6 +235,8 @@ private:
   unsigned int m_outputsOff = 0;
   bool m_off = false;
   bool m_gone = false;
+  double m_asideMs = 0.0; //!< Hades: of the video still set aside after a seek
+  bool m_windowAside = false; //!< Hades: the average being taken has frames set aside
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b0c783d..701fa52 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2646,6 +2646,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset)
   m_dvAheadShown = false;
   m_dvAheadLatencyMs = 0.0f;
   m_dvAheadModeRead = false;
+  m_dvAheadGui = -1;
   m_dvStepRead = false;
   m_dvStepFrame = {};
   m_dvStepFlipFrame = {};
@@ -3370,6 +3371,20 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
     if (timer.playing)
     {
       const double period = DVRefreshPeriodMs();
+      // Hades: the seconds around a seek, and the first one after GUI elements come or go, decide
+      // only for frames that cannot keep up at all (CDVAhead::Seeked(), Changed()). (Seeks before
+      // the first frame of this output timed are those of its start: not set aside.)
+      const unsigned int seeks = m_dvStepSeeks.load(std::memory_order_relaxed);
+      const int gui = timer.measured ? 0 : 1;
+      if (m_dvAheadGui >= 0)
+      {
+        if (seeks != m_dvAheadSeeksSeen)
+          m_dvAhead.Seeked();
+        if (gui != m_dvAheadGui)
+          m_dvAhead.Changed();
+      }
+      m_dvAheadSeeksSeen = seeks;
+      m_dvAheadGui = gui;
       const auto change = m_dvAhead.Measured(ms, period);
       if (change != CDVAhead::Change::NONE && m_dvAheadModeRead &&
           m_dvAheadMode == CDVAhead::Mode::NEEDED)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 6976056..5cc89dc 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -474,6 +474,11 @@ private:
   bool m_dvAheadPending = false;
   bool m_dvAheadLost = false; //!< ... and did not come when it was waited for (told once)
   bool m_dvAheadShown = false; //!< the last frame was presented a frame ahead
+  //! Hades: what the last frame timed while the video played had over it (1: GUI elements, 0:
+  //! nothing, -1: none timed yet in this native output), and the seeks counted until then
+  //! (m_dvStepSeeks): for CDVAhead::Changed() and Seeked()
+  int m_dvAheadGui = -1;
+  unsigned int m_dvAheadSeeksSeen = 0;
   std::atomic<float> m_dvAheadLatencyMs{0.0f}; //!< see GetFrameLatencyAdjustment()
   //! When the frame before the last one was flipped, by the kernel's clock (0: not known)
   int64_t m_dvAheadLastFlipNs = 0;
-- 
2.53.0

