+// Hades: HDR10+ sent as Dolby Vision where the stream's statistics are missing (CDVHdr10PlusFill):
+// a picture whose HDR10+ metadata give no level 1 block, or that has none, was measured on the GPU
+// (VideoPicture::doviMeasured: ahead of its presentation where the renderer has it queued, as for
+// HDR10 measured as Dolby Vision); here, as it is presented, CDVHdr10PlusFill says what goes out
+// with it: the metadata the decoder made of its own statistics, or for a scene without them the
+// level 1 block that the measurement makes (dvbridge_measured_take(),
+// dvbridge_measured_take_cut()). A picture of its own statistics is not measured, and its metadata
+// change only to carry a scene refresh after measured ones.
+static_assert(CDVHdr10PlusFill::OWN == DVBRIDGE_HDR10PLUS_OWN &&
+                  CDVHdr10PlusFill::INCOMPLETE == DVBRIDGE_HDR10PLUS_INCOMPLETE &&
+                  CDVHdr10PlusFill::NONE == DVBRIDGE_HDR10PLUS_NONE &&
+                  CDVHdr10PlusFill::KIND == DVBRIDGE_HDR10PLUS_KIND &&
+                  CDVHdr10PlusFill::CUT == DVBRIDGE_HDR10PLUS_CUT,
+              "CDVHdr10PlusFill takes what dvbridge_hdr10plus_next_of() says");
+
+namespace
+{
+// the level 1 block of Dolby Vision metadata (an AVDOVIMetadata of FFmpeg)
+bool Level1Of(const CDVMetadataBuffer& metadata, unsigned int l1[3])
+{
+  const auto* m = reinterpret_cast<const AVDOVIMetadata*>(metadata.Data());
+  const size_t size = metadata.Size();
+  if (!m || size < sizeof(*m) || m->num_ext_blocks < 0 ||
+      m->num_ext_blocks > AV_DOVI_MAX_EXT_BLOCKS ||
+      (m->num_ext_blocks &&
+       m->ext_block_offset + static_cast<size_t>(m->num_ext_blocks) * m->ext_block_size > size))
+    return false;
+  for (int i = 0; i < m->num_ext_blocks; ++i)
+  {
+    const AVDOVIDmData* e = av_dovi_get_ext(m, i);
+    if (e->level == 1)
+    {
+      l1[0] = e->l1.min_pq;
+      l1[1] = e->l1.max_pq;
+      l1[2] = e->l1.avg_pq;
+      return true;
+    }
+  }
+  return false;
+}
+} // namespace
+
+void CWinSystemGbmGLESContext::DVHdr10PlusFillTell(const char* when)
+{
+  const CDVHdr10PlusFill::Counts& c = m_dvFill.GetCounts();
+  if (!c.incompleteScenes && !c.withoutScenes && !c.gapPictures)
+    return; // (every picture of its own statistics: nothing to tell)
+  CLog::Log(LOGINFO,
+            "DVBridge: HDR10+ sent as Dolby Vision, {}: {} scenes went out with the metadata of "
+            "their own HDR10+ statistics and {} with a level 1 block measured from the picture ({} "
+            "of HDR10+ metadata without statistics, {} stretches without HDR10+ metadata; {} more "
+            "scene cuts found by the measurement); {} pictures with a measured level 1, {} with "
+            "the last one sent (their scene not measured yet), {} without statistics of their own "
+            "that kept their HDR10+ scene's; now {}",
+            when, c.hdr10PlusScenes, c.incompleteScenes + c.withoutScenes, c.incompleteScenes,
+            c.withoutScenes, c.measuredCuts, c.measuredPictures, c.keptPictures, c.gapPictures,
+            m_dvFill.GetSource() == CDVHdr10PlusFill::Source::MEASURED    ? "measured"
+            : m_dvFill.GetSource() == CDVHdr10PlusFill::Source::HDR10PLUS ? "from HDR10+"
+                                                                          : "no scene");
+}
+
+void CWinSystemGbmGLESContext::DVHdr10PlusMetadata(const CDVBridgeGLES::Layer& layer,
+                                                   CDVMetadataBuffer& metadata,
+                                                   unsigned int kind)
+{
+  if (m_dvFillRestart.exchange(false))
+  {
+    DVHdr10PlusFillTell("as the video ended");
+    m_dvFill.Reset();
+    m_dvFill.ResetCounts();
+    m_dvFillPts = DVD_NOPTS_VALUE;
+    m_dvFillFrames = 0;
+    m_dvFillTold = false;
+    m_dvFillHaveLast = false;
+  }
+  CDVHdr10PlusFill::Out out;
+  // (the picture drawn again, paused or kept: what went out with it the first time)
+  const bool again = m_dvFillHaveLast && layer.pts == m_dvFillPts;
+  if (again)
+    out = m_dvFillLast;
+  // a jump of the video (a seek): no scene goes on, and what was measured of the pictures around
+  // it says nothing of those after it (the active area of the stream stays)
+  const double gap = layer.duration > 0 ? 24 * layer.duration : 0;
+  if (!again && m_dvFillPts != DVD_NOPTS_VALUE &&
+      (layer.pts < m_dvFillPts || (gap > 0 && layer.pts > m_dvFillPts + gap)))
+  {
+    m_dvFill.Reset();
+    if (m_dvMeasure && m_dvMeasured)
+    {
+      ++m_dvMeasureEpoch;
+      m_dvMeasureSubmitted.clear();
+      dvbridge_measure_reset(m_dvMeasure.get());
+      dvbridge_measured_reset(m_dvMeasured.get(), true);
+    }
+  }
+  m_dvFillPts = layer.pts;
+  if (!again)
+  {
+    const CDVHdr10PlusFill::Take take = m_dvFill.Before(kind);
+    CDVHdr10PlusFill::Measured measured;
+    if (take != CDVHdr10PlusFill::Take::NONE && DVMeasureReady())
+    {
+      // (this picture, where it was not measured ahead)
+      DVMeasurePicture(layer);
+      dvbridge_measure_collect(
+          m_dvMeasure.get(),
+          [](const dvbridge_measured_raw* raw, uint64_t tag, void* context)
+          {
+            auto* self = static_cast<CWinSystemGbmGLESContext*>(context);
+            dvbridge_measured_picture picture;
+            if (tag == self->m_dvMeasureEpoch &&
+                dvbridge_measured_reduce(self->m_dvMeasured.get(), raw, &picture))
+              dvbridge_measured_add(self->m_dvMeasured.get(), &picture);
+          },
+          this);
+      dvbridge_measured_l1 l1{};
+      measured.found = take == CDVHdr10PlusFill::Take::CUT
+                           ? dvbridge_measured_take_cut(m_dvMeasured.get(), layer.pts, &l1)
+                           : dvbridge_measured_take(m_dvMeasured.get(), layer.pts, &l1);
+      measured.measured = l1.measured;
+      measured.refresh = l1.refresh;
+      measured.min = l1.min_pq;
+      measured.max = l1.max_pq;
+      measured.avg = l1.avg_pq;
+    }
+    unsigned int own[3] = {};
+    const bool ownValid = Level1Of(metadata, own);
+    out = m_dvFill.After(kind, own, ownValid, measured);
+    m_dvFillLast = out;
+    m_dvFillHaveLast = true;
+    if (out.measuredSceneStarts && !m_dvFillTold)
+    {
+      m_dvFillTold = true;
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10+ sent as Dolby Vision: the scene at {:.3f} s has {}: its level 1 "
+                "block is measured from the picture, as for HDR10 measured as Dolby Vision, until "
