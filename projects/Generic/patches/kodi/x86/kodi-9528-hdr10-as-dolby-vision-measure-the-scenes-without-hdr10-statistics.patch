@@ -1340,11 +1356,38 @@ void CDVDVideoCodecFFmpeg::MakeHdr10PlusMetadata(VideoPicture* picture)
                               : nullptr;
   size_t size = 0;
   bool repeated = false;
-  const AVDOVIMetadata* made = dvbridge_hdr10plus_next(
+  unsigned int of = 0;
+  const AVDOVIMetadata* made = dvbridge_hdr10plus_next_of(
       m_dvHdr10PlusScene, hdr10plus, picture->hasDisplayMetadata ? &picture->displayMetadata : nullptr,
-      picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size, &repeated);
+      picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size, &repeated, &of);
+  const bool own = (of & DVBRIDGE_HDR10PLUS_KIND) == DVBRIDGE_HDR10PLUS_OWN;
+  const bool fill = m_dvHdr10PlusFill && !own;
+  picture->doviMeasured = false;
+  picture->doviHdr10Plus = 0;
   if (made && picture->doviMetadata.Assign(reinterpret_cast<const uint8_t*>(made), size))
-    picture->doviRpuRepeated = repeated;
+    picture->doviRpuRepeated = repeated && !fill;
+  else if (fill)
