+    // (nothing made of HDR10+ statistics yet: the metadata of its static metadata, measured)
+    if (m_dvMeasuredPlaceholder.empty() && picture->hasDisplayMetadata &&
+        picture->displayMetadata.has_luminance)
+    {
+      AVDOVIMetadata* placeholder = dvbridge_measured_placeholder(
+          &picture->displayMetadata, picture->hasLightMetadata ? &picture->lightMetadata : nullptr,
+          &size);
+      if (placeholder)
+        m_dvMeasuredPlaceholder.assign(reinterpret_cast<const uint8_t*>(placeholder),
+                                       reinterpret_cast<const uint8_t*>(placeholder) + size);
+      av_free(placeholder);
+    }
+    if (!m_dvMeasuredPlaceholder.empty())
