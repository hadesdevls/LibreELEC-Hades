@@ -158,22 +158,54 @@ COverlayTextureGLES::COverlayTextureGLES(const CDVDOverlayImage& o, CRect& rSour
   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
 
+  // Hades: the light of a bitmap subtitle (subtitles.hadesbitmapbrightness), put into its
+  // texture; 1 leaves the pixels as they are
+  const float light{OVERLAY::BitmapSubtitleLight(o)};
+
   if (o.palette.empty())
   {
     m_pma = false;
     const uint32_t* rgba = reinterpret_cast<const uint32_t*>(o.pixels.data());
-    LoadTexture(GL_TEXTURE_2D, o.width, o.height, o.linesize, &m_u, &m_v, false, rgba);
+    int stride = o.linesize;
+    std::vector<uint32_t> dimmed;
+    if (light < 1.0f && o.width > 0 && o.height > 0)
+    {
+      // the pixels as they are stored: PQ where the overlay is in HDR
+      dimmed.resize(static_cast<size_t>(o.width) * o.height);
+      for (int row = 0; row < o.height; row++)
+      {
+        const uint32_t* line = reinterpret_cast<const uint32_t*>(
+            o.pixels.data() + static_cast<size_t>(row) * o.linesize);
+        for (int col = 0; col < o.width; col++)
+          dimmed[static_cast<size_t>(row) * o.width + col] =
+              OVERLAY::ScaleLight(line[col], light, o.m_isHDROverlay);
+      }
+      rgba = dimmed.data();
+      stride = o.width * 4;
+    }
+    LoadTexture(GL_TEXTURE_2D, o.width, o.height, stride, &m_u, &m_v, false, rgba);
   }
   else
   {
     std::vector<uint32_t> convertedPalette;
     const std::vector<uint32_t>* paletteOverride = nullptr;
-    if (OVERLAY::ShouldConvertPQPaletteToSRGB(o.m_isHDROverlay))
+    const bool toSrgb{OVERLAY::ShouldConvertPQPaletteToSRGB(o.m_isHDROverlay)};
+    if (toSrgb)
     {
       convertedPalette = o.palette;
       OVERLAY::ConvertPQPaletteToSRGB(convertedPalette);
       paletteOverride = &convertedPalette;
     }
+    if (light < 1.0f)
+    {
+      if (!paletteOverride)
+      {
+        convertedPalette = o.palette;
+        paletteOverride = &convertedPalette;
+      }
+      // PQ where the palette stays in HDR, sRGB otherwise (also after the conversion above)
+      OVERLAY::ScaleLight(convertedPalette, light, o.m_isHDROverlay && !toSrgb);
+    }
 
     std::vector<uint32_t> rgba(static_cast<size_t>(o.width) * o.height);
     m_pma = !!USE_PREMULTIPLIED_ALPHA;
@@ -263,7 +295,8 @@ COverlayTextureGLES::COverlayTextureGLES(const CDVDOverlaySpu& o)
   int min_x, max_x, min_y, max_y;
   std::vector<uint32_t> rgba(static_cast<size_t>(o.width) * o.height);
 
-  convert_rgba(o, USE_PREMULTIPLIED_ALPHA, min_x, max_x, min_y, max_y, rgba);
+  convert_rgba(o, USE_PREMULTIPLIED_ALPHA, min_x, max_x, min_y, max_y, rgba,
+               OVERLAY::BitmapSubtitleLight(o));
 
   glGenTextures(1, &m_texture);
