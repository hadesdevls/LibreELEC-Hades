+  // Hades: the light of a bitmap subtitle is put into its texture when it is made
+  // (OVERLAY::BitmapSubtitleLight()), so a change makes them again
+  const int bitmapBrightnessPerc{settings->GetBitmapBrightnessPerc()};
+  if (bitmapBrightnessPerc != m_bitmapBrightnessPerc)
+  {
+    m_bitmapBrightnessPerc = bitmapBrightnessPerc;
+    ReleaseCache();
+  }
+
   if (resetPosition)
     ResetSubtitlePosition();
 }
