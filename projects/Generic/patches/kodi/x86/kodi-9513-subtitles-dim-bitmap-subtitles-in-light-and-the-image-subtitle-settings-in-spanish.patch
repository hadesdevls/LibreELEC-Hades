+namespace
+{
+float SrgbToLinearComponent(float c)
+{
+  c = std::clamp(c, 0.0f, 1.0f);
+  return (c <= 0.04045f) ? (c / 12.92f) : std::pow((c + 0.055f) / 1.055f, 2.4f);
+}
+
+// linear (1.0 == 10000 nits) -> PQ code value (0-1)
+float EncodePQ(float y)
+{
+  y = std::clamp(y, 0.0f, 1.0f);
+  const float p = std::pow(y, ST2084_m1);
+  return std::pow((ST2084_c1 + ST2084_c2 * p) / (1.0f + ST2084_c3 * p), ST2084_m2);
+}
+} // namespace
+
+float BitmapSubtitleLight(const CDVDOverlay& o)
+{
+  if (!o.IsBitmapSubtitle())
+    return 1.0f;
+  const int perc{CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_SUBTITLES_HADESBITMAPBRIGHTNESS)};
+  if (perc >= 100 || perc <= 0)
+    return 1.0f;
+  return static_cast<float>(perc) / 100.0f;
+}
+
+uint32_t ScaleLight(uint32_t colour, float factor, bool pq)
+{
+  const auto scale = [factor, pq](uint32_t code)
+  {
+    const float c{static_cast<float>(code) / 255.0f};
+    const float light{(pq ? DecodePQ(c) : SrgbToLinearComponent(c)) * factor};
+    const float out{pq ? EncodePQ(light) : LinearToSrgbComponent(light)};
+    return static_cast<uint32_t>(std::clamp(static_cast<int>(out * 255.0f + 0.5f), 0, 255));
+  };
+  return (colour & (0xffu << PIXEL_ASHIFT)) |
+         scale((colour >> PIXEL_RSHIFT) & 0xff) << PIXEL_RSHIFT |
+         scale((colour >> PIXEL_GSHIFT) & 0xff) << PIXEL_GSHIFT |
+         scale((colour >> PIXEL_BSHIFT) & 0xff) << PIXEL_BSHIFT;
+}
+
+void ScaleLight(std::vector<uint32_t>& palette, float factor, bool pq)
+{
+  for (uint32_t& entry : palette)
+    entry = ScaleLight(entry, factor, pq);
+}
