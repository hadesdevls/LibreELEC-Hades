 {
   uint32_t palette[8];
   for (int i = 0; i < 4; i++)
@@ -81,6 +82,21 @@ void convert_rgba(const CDVDOverlaySpu& o,
     palette[i] = build_rgba(o.color[i], o.alpha[i], mergealpha);
     palette[i + 4] = build_rgba(o.highlight_color[i], o.highlight_alpha[i], mergealpha);
   }
+  // Hades: dimmed in light before the alpha is merged into the colour
+  if (light < 1.0f)
+  {
+    const auto dim = [light, mergealpha](const int yuv[3], int alpha)
+    {
+      const uint32_t own{ScaleLight(build_rgba(yuv, alpha, false), light, false)};
+      return build_rgba((own >> PIXEL_ASHIFT) & 0xff, (own >> PIXEL_RSHIFT) & 0xff,
+                        (own >> PIXEL_GSHIFT) & 0xff, (own >> PIXEL_BSHIFT) & 0xff, mergealpha);
+    };
+    for (int i = 0; i < 4; i++)
+    {
+      palette[i] = dim(o.color[i], o.alpha[i]);
+      palette[i + 4] = dim(o.highlight_color[i], o.highlight_alpha[i]);
+    }
+  }
 
   uint32_t  color;
   uint32_t* trg;
@@ -362,6 +378,55 @@ void ConvertPQPaletteToSRGB(std::vector<uint32_t>& palette)
   }
