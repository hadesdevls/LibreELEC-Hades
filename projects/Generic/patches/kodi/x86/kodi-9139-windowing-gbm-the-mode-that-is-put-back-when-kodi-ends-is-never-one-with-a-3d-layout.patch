From 105c7990f3ac35f3305a55addb3f0cf5243221ad Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:22:57 +0000
Subject: [PATCH] windowing/gbm: the mode that is put back when Kodi ends is
 never one with a 3D layout

Kodi does not start in a mode with a 3D layout that it finds the output
in, but it put that mode back when it ended: what is shown there next, a
2D picture, would be shown as two eyes. The timing of that mode is put
back as a 2D mode. Any other mode is put back as it was.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 82fc285..9330cbb 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1153,9 +1153,16 @@ bool CDRMUtils::RestoreOriginalMode()
     return false;
   }
 
+  // Hades: an output that Kodi found in a mode with a 3D layout (see FindCrtc()) is not put
+  // back into it, but into the same timing as a 2D mode: what is shown there next is a 2D
+  // picture, which a display that is told of a 3D layout shows as two eyes. Any other mode is
+  // put back as it was.
+  drmModeModeInfo mode = *m_orig_crtc->GetMode();
+  mode.flags &= ~DRM_MODE_FLAG_3D_MASK;
+
   auto ret = drmModeSetCrtc(m_fd, m_orig_crtc->GetCrtcId(), m_orig_crtc->GetBufferId(),
                             m_orig_crtc->GetX(), m_orig_crtc->GetY(), m_connector->GetConnectorId(),
-                            1, m_orig_crtc->GetMode());
+                            1, &mode);
 
   if (ret)
   {
-- 
2.53.0

