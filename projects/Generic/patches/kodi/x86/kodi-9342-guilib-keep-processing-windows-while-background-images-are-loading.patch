From 75e985b1bf830a14afca6516b0e02e1bd9e4587c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 10 Oct 2026 19:38:05 +0200
Subject: [PATCH] [guilib] Keep processing windows while background images are
 loading

With smart redraw, a window is only processed while it is dirty. A
loaded background texture is only picked up in CGUITexture::Process(),
and since textures mark themselves dirty only on ready state changes,
the window stops being processed while the image is still loading.
The image then only appears after something else, like a key press,
dirties the window.

Mark the image's parents dirty while one of its textures is loading,
which keeps the window processed without adding a dirty region.

(cherry picked from commit 66fa879ca70e80e313b919c9ec3d41d52d0e729e)
---
 xbmc/guilib/GUIImage.cpp | 5 +++++
 xbmc/guilib/GUITexture.h | 1 +
 2 files changed, 6 insertions(+)

diff --git a/xbmc/guilib/GUIImage.cpp b/xbmc/guilib/GUIImage.cpp
index f775b85..28176b0 100644
--- a/xbmc/guilib/GUIImage.cpp
+++ b/xbmc/guilib/GUIImage.cpp
@@ -162,6 +162,11 @@ void CGUIImage::Process(unsigned int currentTime, CDirtyRegionList &dirtyregions
   if (m_textureCurrent->Process(currentTime))
     MarkDirtyRegion();
 
+  // background textures are picked up in Process(), keep the window
+  // processed until they're loaded without redrawing this control
+  if (m_textureCurrent->IsLoading() || m_textureNext->IsLoading())
+    MarkDirtyRegion(DIRTY_STATE_CHILD);
+
   CGUIControl::Process(currentTime, dirtyregions);
 }
 
diff --git a/xbmc/guilib/GUITexture.h b/xbmc/guilib/GUITexture.h
index 99cdeee..1c50eab 100644
--- a/xbmc/guilib/GUITexture.h
+++ b/xbmc/guilib/GUITexture.h
@@ -127,6 +127,7 @@ public:
   {
     return m_isAllocated == NORMAL_FAILED || m_isAllocated == LARGE_FAILED;
   }
+  bool IsLoading() const { return m_isAllocated == LARGE && !m_texture.size(); }
   bool ReadyToRender() const;
 
 protected:
