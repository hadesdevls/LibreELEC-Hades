   if (!m_eglContext.TrySwapBuffers())
   {
@@ -423,6 +454,43 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
   return true;
 }
 
+#ifdef HAVE_DVBRIDGE
+bool CWinSystemGbmGLESContext::RestoreDVInNewWindow(const RESOLUTION_INFO& res)
+{
+  // The window is the one of res, and its mode is selected (CreateNewWindow()): the restoration
+  // goes out with its first frame, black, in that mode, the head turned off with it and on again
+  // (FlipDVBridgePage(), withMode; NVIDIA_DUAL_MODE::RestoreRestarts()). The change of mode after
+  // it (CWinSystemGbm::SetFullScreen()) finds that mode on the output, and goes out in place.
+  // (Hades: the depth of the link for what this mode will carry goes with it: LinkDepth.h)
+  m_linkNextContent = LinkContentOfMode(res);
+  const bool joined = EndDVBridge(true, true);
+  m_linkNextContent.reset();
+  if (joined)
+  {
+    // (in another mode the link may carry another depth and format: asked again, as after the
+    // restoration with a mode of the same window)
+    ResetOutputDepth();
+    CLog::Log(LOGINFO,
+              "DVBridge: native Dolby Vision output left with the change of mode to {}x{} @ "
+              "{:.3f} Hz, after its new window ({}x{}) was made: the output changes once for both",
+              res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, res.iWidth, res.iHeight);
+    return true;
+  }
+  CLog::Log(LOGWARNING, "DVBridge: leaving native Dolby Vision with the change of mode, after its "
+                        "new window, did not go through; the ordinary output is restored on its "
+                        "own, in the new mode");
+  if (EndDVBridge())
+  {
+    ResetOutputDepth();
+    return true;
+  }
+  // The window is the new one, and nothing of the ordinary output goes out while native output has
+  // the output: the restoration is tried again once a second, in this mode (PresentRender())
+  m_displayLostSent = false;
+  return false;
+}
+#endif
+
 void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 {
   if (!m_bRenderCreated)
@@ -5712,7 +5780,9 @@ bool CWinSystemGbmGLESContext::DestroyWindow()
   // A restoration that waits for the change of mode after a video, or that has failed so far, is
   // made while the window is still there: Kodi can stop (quit, restart, power off) without a
   // change of mode, and its window goes before its window system, whose end restores too late.
-  if (m_dvState.Captured())
+  // (Hades: not where SetFullScreen() makes it after the new window, with the change of mode:
+  // RestoreDVInNewWindow())
+  if (m_dvState.Captured() && !m_dvRestoreInNewWindow)
     EndDVBridge(false);
   // Hades: nothing waits for a window that goes (the next commit is of another one)
   if (m_modeHold.Cancel())
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 524992d..becadbc 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -160,8 +160,14 @@ public:
   //! Kodi then sets another mode of the size of the window (DVEndWaitsForMode(): with every
   //! backend), the ordinary output waits for that change of mode, DV_END_WAIT at most, with the
   //! last frame on the display, and comes back with it in one commit (SetFullScreen());
-  //! otherwise EndDVBridge().
+  //! otherwise EndDVBridge(). (Hades: also another mode of another size where every change of mode
+  //! goes out with the head turned off and on: then after its window, RestoreDVInNewWindow())
   bool EndDVBridgeAfterVideo();
+  //! Hades: native Dolby Vision left with the change of mode to res after its new window was made,
+  //! in the commits that turn the head off with that mode and on again
+  //! (CModeChangeHold::DVRestoreInNewWindow()); then on its own, in that mode. False when neither
+  //! went through: the restoration is tried again once a second.
+  bool RestoreDVInNewWindow(const RESOLUTION_INFO& res);
   //! Hades: the renderer of a video was configured (RenderManager, render thread): a change of
   //! mode that waits for the output of that video goes out with the next commit (CModeChangeHold)
   void VideoOutputConfigured();
@@ -654,6 +660,9 @@ private:
   //! EndDVBridgeAfterVideo(): the restoration waits for the change of mode, until then
   std::atomic<bool> m_dvEndDeferred{false};
   std::chrono::steady_clock::time_point m_dvEndDeferredUntil{};
+  //! Hades: SetFullScreen() makes the restoration after the new window (RestoreDVInNewWindow()):
+  //! DestroyWindow() leaves it, while this is set
+  bool m_dvRestoreInNewWindow = false;
   //! Hades: native output goes on into the mode of the video that takes it next (CDVModeMove):
   //! res is selected, and the next commit carries it. True when that is done.
   bool DVModeMoves(const RESOLUTION_INFO& res);
diff --git a/xbmc/windowing/gbm/drm/NvidiaDualMode.h b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
index bcce2b5..3251dd0 100644
--- a/xbmc/windowing/gbm/drm/NvidiaDualMode.h
+++ b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
@@ -96,4 +96,18 @@ inline bool ModeChangeRestarts(std::string_view type, std::optional<uint64_t> du
 {
   return setting && active && otherTiming && LinkFromScratch(type, dualModeTmds);
 }
+
+/*!
+ * Hades: whether the restoration of the ordinary output after native Dolby Vision turns the head
+ * off and on (CWinSystemGbm::FlipDVBridgePage(); nvidia, the backend that was captured; active, the
+ * output meant to be on). On its own, in the mode on the output, it does. With the mode that Kodi
+ * sets next (withMode) only where every change of mode does (fromScratch: the link started from
+ * scratch for native output, and a change of mode restarts it, CWinSystemGbm::ModeFromScratch());
+ * elsewhere that restoration goes out in place, in one commit with the mode: that mode is another
+ * one, so the head is set from scratch anyway.
+ */
+inline bool RestoreRestarts(bool withMode, bool fromScratch, bool active, bool nvidia)
+{
+  return nvidia && active && (!withMode || fromScratch);
+}
 } // namespace NVIDIA_DUAL_MODE
