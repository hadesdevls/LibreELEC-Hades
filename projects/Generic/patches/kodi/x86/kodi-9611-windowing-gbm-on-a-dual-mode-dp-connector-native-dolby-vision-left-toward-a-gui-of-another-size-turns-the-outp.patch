--- a/xbmc/windowing/gbm/DVModeMove.h
+++ b/xbmc/windowing/gbm/DVModeMove.h
@@ -59,7 +59,9 @@ public:
     bool captured = false; //!< native output has the output
     bool transportLive = false; //!< ... and carries the transport
     bool disabled = false; //!< native output is disabled after a failure
-    bool joins = false; //!< DVModeChangeJoins(): another mode of the window, on, not 3D
+    //! DVModeChangeJoins(): another mode of the window, on, not 3D (Hades: or of a new window,
+    //! where the link starts from scratch: no move there)
+    bool joins = false;
     bool transportMode = false; //!< the new mode carries the transport, at a rate taken
     bool rendererNative = false; //!< a renderer draws natively now
     bool endWaits = false; //!< the end of the video before waits for a change of mode
diff --git a/xbmc/windowing/gbm/ModeChangeHold.h b/xbmc/windowing/gbm/ModeChangeHold.h
index 13dacf8..469ed98 100644
--- a/xbmc/windowing/gbm/ModeChangeHold.h
+++ b/xbmc/windowing/gbm/ModeChangeHold.h
@@ -116,6 +116,34 @@ public:
     return c.atomic && c.active && c.captured && c.sameWindow && !c.mode3D && c.timingChanges;
   }
 
+  /*!
+   * \brief Hades: ... or, where that mode needs a window of another size, after the new window is
+   *        made, in the commits that turn the head off with that mode and on again
+   *        (CWinSystemGbmGLESContext::SetFullScreen())
+   *
+   * Where every change of mode goes out with the head turned off and on: a dual-mode DisplayPort
+   * connector that nvidia-drm drives as HDMI, with video/dualmoderestart on (linkFromScratch,
+   * modeFromScratch; NVIDIA_DUAL_MODE::ModeChangeRestarts()). Made on its own before the new window,
+   * the restoration turned the head off and on in the mode of the video, and the change of mode
+   * after it turned it off and on again, in the new mode: two bring-ups of the HDMI link one after
+   * the other (issue #4: a GUI at 1920x1080 and 120 Hz after a video in native Dolby Vision at
+   * 3840x2160). With the first frame of the new window they are one, in the new mode. Not on
+   * another connector, where the change of mode after a restoration goes out in place, as before;
+   * nor with the setting off, where it does too.
+   */
+  static bool DVRestoreInNewWindow(const Change& c)
+  {
+    return c.atomic && c.active && c.captured && !c.sameWindow && !c.mode3D && c.timingChanges &&
+           c.linkFromScratch && c.modeFromScratch;
+  }
+
+  //! Hades: the restoration goes out with the change of mode that Kodi sets next, one way or the
+  //! other (CWinSystemGbm::DVModeChangeJoins())
+  static bool DVRestoreGoesWithMode(const Change& c)
+  {
+    return DVRestoreJoins(c) || DVRestoreInNewWindow(c);
+  }
+
   //! START: a change of mode made for a video that opens is held for its output (Hades: not for
   //! native Dolby Vision where it brings the link up from scratch: the mode goes out alone; nor
   //! for HDR signalling where the change of mode goes out with the head turned off and on)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 530ff53..6a14f67 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2066,9 +2066,13 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state,
   // DisplayPort connector, ModeFromScratch()): there the restoration with the mode that Kodi sets
   // next goes out so too, one bring-up of the head and the link in the new mode; in place, the TV
   // took no change of the rate there (issue #4)
+  // (Hades: also after a new window, with the first frame of it, for a mode of another size:
+  // CModeChangeHold::DVRestoreInNewWindow(). The decision: NVIDIA_DUAL_MODE::RestoreRestarts(),
+  // which a test builds on the host.)
   const bool fromScratch = withMode && state.CapturedLinkFromScratch() && ModeFromScratch();
-  if (valid && restore && (!withMode || fromScratch) && drm->IsActive() &&
-      state.CapturedBackend() == CDVBridgeState::Backend::NVIDIA)
+  if (valid && restore &&
+      NVIDIA_DUAL_MODE::RestoreRestarts(withMode, fromScratch, drm->IsActive(),
+                                        state.CapturedBackend() == CDVBridgeState::Backend::NVIDIA))
   {
     drm->SetActive(false);
     const bool off = drm->FlipPageTransactional(stage(true) ? bo : nullptr, true);
@@ -2376,10 +2380,27 @@ bool CWinSystemGbm::DVModeChangeJoins(const CDVBridgeState& state, const RESOLUT
   // (two changes of the display). In the commit of that mode, the display changes once.
   if (!state.Captured())
     return false;
+  // Hades: ... and a change of another window size where every change of mode goes out with the
+  // head turned off and on, after its window is made (DVRestoreInNewWindow())
+  return CModeChangeHold::DVRestoreGoesWithMode(DVRestoreChangeOf(state, res));
+}
+
+bool CWinSystemGbm::DVRestoreInNewWindow(const CDVBridgeState& state,
+                                         const RESOLUTION_INFO& res) const
+{
+  return state.Captured() && CModeChangeHold::DVRestoreInNewWindow(DVRestoreChangeOf(state, res));
+}
+
+CModeChangeHold::Change CWinSystemGbm::DVRestoreChangeOf(const CDVBridgeState& state,
+                                                         const RESOLUTION_INFO& res) const
+{
   CModeChangeHold::Change change = ModeChangeOf(res);
   // (the state of the bridge that the caller has, which is the one captured)
   change.captured = true;
-  return CModeChangeHold::DVRestoreJoins(change);
+  // (Hades: ... whose link starts from scratch only where it did for native output: what
+  // FlipDVBridgePage() turns the head off and on for)
+  change.linkFromScratch = change.linkFromScratch && state.CapturedLinkFromScratch();
+  return change;
 }
 
 bool CWinSystemGbm::ModeAfterVideo(RESOLUTION_INFO& res) const
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 482dc7d..76ddd04 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -119,8 +119,12 @@ public:
   //! Hades: native Dolby Vision can be left with res, the mode that Kodi sets next, in one commit
   //! (see FlipDVBridgePage()), with every backend (CModeChangeHold::DVRestoreJoins()): the output
