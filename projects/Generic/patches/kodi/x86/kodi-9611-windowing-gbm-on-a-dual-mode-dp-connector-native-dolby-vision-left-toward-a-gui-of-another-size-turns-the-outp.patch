--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -324,6 +324,13 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
   // CDVStartSignal: the player stopped, and Kodi sets the mode of the GUI)
   // (Hades: also the menus in Dolby Vision, for a mode they cannot go on into or a video that does not
