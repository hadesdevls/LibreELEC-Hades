-  //! a 3D output
+  //! a 3D output. Hades: ... or of another size, after its window is made, where every change of
+  //! mode goes out with the head turned off and on (DVRestoreInNewWindow())
   bool DVModeChangeJoins(const CDVBridgeState& state, const RESOLUTION_INFO& res) const;
+  //! Hades: ... the second way: res needs a window of another size, on a connector where every
+  //! change of mode goes out with the head turned off and on (CModeChangeHold::DVRestoreInNewWindow())
+  bool DVRestoreInNewWindow(const CDVBridgeState& state, const RESOLUTION_INFO& res) const;
   //! Hades: ... and the resolution that Kodi goes back to when a video stops
   //! (CGraphicContext::SetFullScreenVideo()) is such a mode
   bool DVEndWaitsForMode(const CDVBridgeState& state) const;
@@ -439,6 +443,10 @@ protected:
   const drmModeModeInfo* m_modeHeldFrom = nullptr;
   //! ... the change to res as this window system sees it
   CModeChangeHold::Change ModeChangeOf(const RESOLUTION_INFO& res) const;
+  //! Hades: ... as the restoration of native Dolby Vision that state has captured sees it
+  //! (DVModeChangeJoins())
+  CModeChangeHold::Change DVRestoreChangeOf(const CDVBridgeState& state,
+                                            const RESOLUTION_INFO& res) const;
   //! ... START: res is chosen as SetFullScreen() does, but nothing is committed: the mode goes out
   //! with the next commit, and the other subsystems are told of it then (m_modeAnnounce). False,
