@@ -357,7 +370,7 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
                               "new mode");
     }
   }
-  if (!EndDVBridge())
+  if (!restoreInNewWindow && !EndDVBridge())
   {
     m_displayLostSent = false;
     if (before)
@@ -377,7 +390,9 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
   // Hades: the change of mode for a video that goes out natively goes out now, with the Dolby
   // Vision signal set up for it, before its first picture and before the player's clock starts
   // (CDVStartSignal). Where it cannot, it is held as below, as before.
-  if (!heldEnd && DVStartSignal(res))
+  // (Hades: neither this nor the hold below takes a change of another window size, nor one whose
+  // link starts from scratch: CModeChangeHold::Possible(), StartHolds())
+  if (!heldEnd && !restoreInNewWindow && DVStartSignal(res))
   {
     CRenderSystemGLES::ResetRenderSystem(res.iWidth, res.iHeight);
     return true;
@@ -388,7 +403,7 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
   // signalling of the video before, which waited for this change (heldEnd): that goes out now,
   // before anything of the next video is set up on it (native Dolby Vision keeps, to put them
   // back, the properties that are on the screen when it starts).
-  if (!heldEnd && HoldsModeForVideo(res) && HoldModeChange(res))
+  if (!heldEnd && !restoreInNewWindow && HoldsModeForVideo(res) && HoldModeChange(res))
   {
     CRenderSystemGLES::ResetRenderSystem(res.iWidth, res.iHeight);
     return true;
@@ -403,13 +418,29 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
   {
     CLog::Log(LOGDEBUG, "CWinSystemGbmGLESContext::{} - resolution changed, creating a new window",
               __FUNCTION__);
-    if (!CreateNewWindow("", fullScreen, res) &&
-        StereoWindowFailed(res, "its window could not be made", plain))
+#ifdef HAVE_DVBRIDGE
+    // (Hades: the window of native output goes with it still captured: DestroyWindow() leaves the
