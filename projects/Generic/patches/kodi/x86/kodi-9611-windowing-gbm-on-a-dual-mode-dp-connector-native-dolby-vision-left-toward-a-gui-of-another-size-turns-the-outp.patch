+  bool restoreInNewWindow = false;
   if ((m_dvEndDeferred || m_dvMovePending || m_dvStartWaits || m_dvMenus) &&
       DVModeChangeJoins(m_dvState, res))
   {
@@ -339,7 +346,13 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
     OnLostDevice();
     m_displayLostSent = true;
     before = m_DRM->GetSelectedMode();
-    if (m_DRM->SetMode(res))
+    restoreInNewWindow = DVRestoreInNewWindow(m_dvState, res);
+    if (restoreInNewWindow)
