 xbmc/windowing/gbm/ModeChangeHold.h           | 28 +++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 27 +++++-
 xbmc/windowing/gbm/WinSystemGbm.h             | 10 ++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 84 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 11 ++-
 xbmc/windowing/gbm/drm/NvidiaDualMode.h       | 14 ++++
 7 files changed, 165 insertions(+), 13 deletions(-)

diff --git a/xbmc/windowing/gbm/DVModeMove.h b/xbmc/windowing/gbm/DVModeMove.h
