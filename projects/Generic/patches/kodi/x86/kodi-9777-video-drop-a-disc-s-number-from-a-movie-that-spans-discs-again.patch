From 287297be2bbb68527ba980cffd6557a4c5d334e6 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 16:39:31 +0000
Subject: [PATCH] [Video] Drop a disc's number from a movie that spans discs
 again.

A movie added from a "Disc n" folder is titled with its disc. The title
stayed so when a file or an unread disc image joined another movie as
a version, and when a refresh added a disc again and gave it back the
versions on its other discs.

The number is now removed in both cases, as it already is when a disc's
playlists join another movie.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.cpp               |  1 +
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 17 ++++++++++++++---
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index cab67e5..c684598 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -1483,6 +1483,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
         switch (result)
         {
           case VersionConversionResult::SUCCESS:
+            RemovePartNumberFromTitle(targetMovieDbId, VideoDbContentType::MOVIES, m_database);
             return InfoRet::HAVE_ALREADY;
           case VersionConversionResult::NOT_NEEDED:
           case VersionConversionResult::CANCELLED:
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index 94c0994..2e8888b 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -41,6 +41,7 @@
 #include "video/VideoFileItemClassify.h"
 #include "video/VideoInfoDownloader.h"
 #include "video/VideoInfoScanner.h"
+#include "video/dialogs/GUIDialogVideoManagerVersions.h"
 #include "video/tags/IVideoInfoTagLoader.h"
 #include "video/tags/VideoInfoTagLoaderFactory.h"
 #include "video/tags/VideoTagLoaderNFO.h"
@@ -749,15 +750,25 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       // the versions kept from before the refresh are not scanned, so their stream details are
       // read again here
       CFileItemList keptVersions;
-      if (scraper->Content() == ADDON::ContentType::MOVIES &&
-          CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
-              CSettings::SETTING_MYVIDEOS_EXTRACTFLAGS))
+      if (scraper->Content() == ADDON::ContentType::MOVIES)
         db.GetVideoVersions(VideoDbContentType::MOVIES, origDbId, keptVersions,
                             VideoAssetType::VERSION);
 
       const auto videoTag{m_item->GetVideoInfoTag()};
       db.UpdateAssetsOwner(videoTag->m_type, origDbId, videoTag->m_iDbId);
 
+      // The versions kept are on other discs than the one refreshed, so the movie the disc was added
+      // as again isn't named by it
+      if (!keptVersions.IsEmpty() && videoTag->m_iDbId > 0)
+      {
+        CGUIDialogVideoManagerVersions::RemovePartNumberFromTitle(videoTag->m_iDbId,
+                                                                  VideoDbContentType::MOVIES, db);
+        db.GetMovieInfo({}, *videoTag, videoTag->m_iDbId);
+      }
+
+      if (!CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+              CSettings::SETTING_MYVIDEOS_EXTRACTFLAGS))
+        keptVersions.Clear();
       for (const auto& version : keptVersions)
       {
         CFileItem versionItem{version->GetDynPath(), false};
-- 
