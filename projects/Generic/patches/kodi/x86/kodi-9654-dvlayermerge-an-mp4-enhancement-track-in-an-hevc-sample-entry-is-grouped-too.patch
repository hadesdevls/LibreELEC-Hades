From 3a9467bf564863ab20e2777cadf5a730b3dd0679 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:06:24 +0000
Subject: [PATCH] DVLayerMerge: an MP4 enhancement track in an HEVC sample
 entry is grouped too

With ffmpeg-9930, libavformat groups the enhancement track of a dual-track
Dolby Vision MP4 file also when its sample entry is an ordinary HEVC one
('hvc1' or 'hev1') with the Dolby Vision record in it, if its 'vdep' reference
names one track. Nothing in the join depends on the sample entry: the record
and the hvcC record of the track are what it reads, and 'hvc1' keeps the
parameter sets in that record as 'dvh1' does (doviELConfig). Only the words
change: the reason given when an MP4 file has no group, and the comment that
says how libavformat groups the tracks.

On the host, the join test of 1.0 RC3 (fel_tracks_test.c) gives for the 'hvc1'
file the same pictures, pairs and RPUs as for the 'dvh1' file it was made from,
and for the 'hev1' file the same as for the 'dvhe' one.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp | 4 ++--
 xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h   | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
index 930eb45..7426a81 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
@@ -392,8 +392,8 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
   {
     refused.reason = container == Container::MP4
                          ? "no Dolby Vision group of libavformat (in MP4: the 'vdep' reference "
-                           "of an enhancement track with its Dolby Vision sample entry and "
-                           "record)"
+                           "of an enhancement track with its record, in a Dolby Vision sample "
+                           "entry, or in an HEVC one with a reference to one track only)"
                          : "no Dolby Vision group of libavformat (in a transport stream: the "
                            "Dolby Vision descriptor of the enhancement track, or the stream "
                            "numbers of a Blu-ray program)";
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index 6e2de8b..df89bc3 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -121,7 +121,8 @@ public:
    *
    * libavformat groups them by the Dolby Vision descriptor of the enhancement track of a
    * transport stream, or by the stream numbers of a Blu-ray stream; by the 'vdep' reference of
-   * an MP4 enhancement track with its Dolby Vision sample entry and record; and in Matroska,
+   * an MP4 enhancement track with its record, in a Dolby Vision sample entry or (Hades,
+   * ffmpeg-9923) in an HEVC one ('hvc1', 'hev1') with a reference to one track only; and in Matroska,
    * which has no such reference, by the Dolby Vision record of the enhancement track when there
    * is exactly one other HEVC track. For MP4 and Matroska the enhancement track must also have
    * the size of an enhancement layer of the base track.
