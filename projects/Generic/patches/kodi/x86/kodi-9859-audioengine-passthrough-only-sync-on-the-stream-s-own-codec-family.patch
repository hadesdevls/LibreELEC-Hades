From 6164e2c61ef87bfbed4f8a4d1df82a2e0bb142f5 Mon Sep 17 00:00:00 2001
From: heit88 <heit88@gmail.com>
Date: Tue, 3 Nov 2026 14:39:45 -0700
Subject: [PATCH] [AudioEngine] Passthrough: only sync on the stream's own
 codec family

After a seek, CAEStreamParser::DetectType can lock on to bytes inside a
TrueHD stream that look like an E-AC3 header. The passthrough codec then
reports a bogus E-AC3 format, ActiveAE reopens the sink for it and again
for TrueHD a moment later. On Android the second AudioTrack open can
fail, leaving ActiveAE in its error state and playback stalled.

The demuxer already tells the passthrough codec which codec it carries,
so restrict detection to that family (AC3/E-AC3, DTS or TrueHD).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LLzpkzBMUHThyvZgfnkvwn

(Backported from xbmc/xbmc pull request 30326, commits 41281ee1bf9c and 93dfb3b14a91 (code
style) in one; SetExpectedType() is called next to SetDTSHDMA() of pull request 30440.)
---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp | 27 ++++++++++++++++---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.h   |  9 +++++++
 .../Audio/DVDAudioCodecPassthrough.cpp        |  2 ++
 3 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
index 720a381..cb91266 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
@@ -238,6 +238,25 @@ void CAEStreamParser::GetPacket(uint8_t** buffer, unsigned int* bufferSize)
   m_coreSize = 0;
 }
 
+bool CAEStreamParser::AllowsAC3() const
+{
+  return m_expectedType == CAEStreamInfo::STREAM_TYPE_NULL ||
+         m_expectedType == CAEStreamInfo::STREAM_TYPE_AC3 ||
+         m_expectedType == CAEStreamInfo::STREAM_TYPE_EAC3;
+}
+
+bool CAEStreamParser::AllowsTrueHD() const
+{
+  return m_expectedType == CAEStreamInfo::STREAM_TYPE_NULL ||
+         m_expectedType == CAEStreamInfo::STREAM_TYPE_TRUEHD;
+}
+
+bool CAEStreamParser::AllowsDTS() const
+{
+  // Every type outside the AC3 and TrueHD families is a DTS variant.
+  return m_expectedType == CAEStreamInfo::STREAM_TYPE_NULL || (!AllowsAC3() && !AllowsTrueHD());
+}
+
 // SYNC FUNCTIONS
 
 // This function looks for sync words across the types in parallel, and only does an exhaustive
@@ -253,8 +272,8 @@ unsigned int CAEStreamParser::DetectType(uint8_t* data, unsigned int size)
   {
     // if it could be DTS
     unsigned int header = data[0] << 24 | data[1] << 16 | data[2] << 8 | data[3];
-    if (header == DTS_PREAMBLE_14LE || header == DTS_PREAMBLE_14BE || header == DTS_PREAMBLE_16LE ||
-        header == DTS_PREAMBLE_16BE)
+    if (AllowsDTS() && (header == DTS_PREAMBLE_14LE || header == DTS_PREAMBLE_14BE ||
+                        header == DTS_PREAMBLE_16LE || header == DTS_PREAMBLE_16BE))
     {
       unsigned int skip = SyncDTS(data, size);
       if (m_hasSync || m_needBytes)
@@ -264,7 +283,7 @@ unsigned int CAEStreamParser::DetectType(uint8_t* data, unsigned int size)
     }
 
     // if it could be AC3
-    if (data[0] == 0x0b && data[1] == 0x77)
+    if (AllowsAC3() && data[0] == 0x0b && data[1] == 0x77)
     {
       unsigned int skip = SyncAC3(data, size);
       if (m_hasSync || m_needBytes)
@@ -274,7 +293,7 @@ unsigned int CAEStreamParser::DetectType(uint8_t* data, unsigned int size)
     }
 
     // if it could be TrueHD
-    if (data[4] == 0xf8 && data[5] == 0x72 && data[6] == 0x6f && data[7] == 0xba)
+    if (AllowsTrueHD() && data[4] == 0xf8 && data[5] == 0x72 && data[6] == 0x6f && data[7] == 0xba)
     {
       unsigned int skip = SyncTrueHD(data, size);
       if (m_hasSync)
diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
index c57d250..696ebce 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
@@ -59,6 +59,11 @@ public:
 
   void SetCoreOnly(bool value) { m_coreOnly = value; }
   void SetDTSHDMA(bool value) { m_dtsHDMA = value; }
+  /*!
+   \brief Only sync on streams of the same family (AC3/E-AC3, DTS, TrueHD) as type.
+   STREAM_TYPE_NULL (the default) accepts any family.
+   */
+  void SetExpectedType(CAEStreamInfo::DataType type) { m_expectedType = type; }
   unsigned int IsValid() const { return m_hasSync; }
   unsigned int GetSampleRate() const { return m_info.m_sampleRate; }
   unsigned int GetChannels() const { return m_info.m_channels; }
@@ -81,6 +86,7 @@ private:
 
   CAEStreamInfo m_info;
   bool m_coreOnly = false;
+  CAEStreamInfo::DataType m_expectedType = CAEStreamInfo::STREAM_TYPE_NULL;
   unsigned int m_needBytes = 0;
   ParseFunc m_syncFunc;
   bool m_hasSync = false;
@@ -95,6 +101,9 @@ private:
 
   void GetPacket(uint8_t **buffer, unsigned int *bufferSize);
   unsigned int DetectType(uint8_t *data, unsigned int size);
+  bool AllowsAC3() const;
+  bool AllowsDTS() const;
+  bool AllowsTrueHD() const;
   bool TrySyncAC3(uint8_t *data, unsigned int size, bool resyncing, bool wantEAC3dependent);
   unsigned int SyncAC3(uint8_t *data, unsigned int size);
   unsigned int SyncDTS(uint8_t *data, unsigned int size);
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
index 20002e6..40976a5 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
@@ -52,6 +52,8 @@ CDVDAudioCodecPassthrough::~CDVDAudioCodecPassthrough(void)
 bool CDVDAudioCodecPassthrough::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options)
 {
   m_parser.SetCoreOnly(false);
+  // After a seek, TrueHD data can contain bytes that pass as an E-AC3 header.
+  m_parser.SetExpectedType(m_format.m_streamInfo.m_type);
   m_parser.SetDTSHDMA(m_format.m_streamInfo.m_type == CAEStreamInfo::STREAM_TYPE_DTSHD_MA);
   switch (m_format.m_streamInfo.m_type)
   {
