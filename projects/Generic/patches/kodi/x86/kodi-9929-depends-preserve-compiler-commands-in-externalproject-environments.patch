From c1bf7ef846291c51dd539b0b6c458c418d41d208 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 26 Oct 2026 15:18:29 -0700
Subject: [PATCH] [depends] Preserve compiler commands in ExternalProject
 environments

Use the original Autoconf compiler commands for CC and CXX assignments.
CMake compiler lists otherwise split flags into arguments to cmake -E env.
---
 tools/depends/target/Toolchain.cmake.in | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/depends/target/Toolchain.cmake.in b/tools/depends/target/Toolchain.cmake.in
index 77b4641..1794a34 100644
--- a/tools/depends/target/Toolchain.cmake.in
+++ b/tools/depends/target/Toolchain.cmake.in
@@ -195,8 +195,8 @@ find_file(CONFIG_SITE "config.site" PATHS "${DEPENDS_PATH}/share" NO_CMAKE_FIND_
 # Env variables for non cmake target environments
 set(PROJECT_TARGETENV "AS=${CMAKE_AS}"
                       "AR=${CMAKE_AR}"
-                      "CC=${CMAKE_C_COMPILER}"
-                      "CXX=${CMAKE_CXX_COMPILER}"
+                      [=[CC=@CC@]=]
+                      [=[CXX=@CXX@]=]
                       "NM=${CMAKE_NM}"
                       "LD=${CMAKE_LINKER}"
                       "STRIP=${CMAKE_STRIP}"
-- 
2.53.0

