From ef85991843d00577a368e5076b68a7a80a1764c0 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:04 +0000
Subject: [PATCH] [pvr] Fix unsigned subtraction in HasNonRecordingTimers

CodeQL cpp/unsigned-difference-expression-compared-zero: the difference
of two unsigned values is never negative, so the check was really a
non-equality test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/pvr/guilib/guiinfo/PVRGUITimerInfo.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/pvr/guilib/guiinfo/PVRGUITimerInfo.h b/xbmc/pvr/guilib/guiinfo/PVRGUITimerInfo.h
index 4d7aaab..f540de7 100644
--- a/xbmc/pvr/guilib/guiinfo/PVRGUITimerInfo.h
+++ b/xbmc/pvr/guilib/guiinfo/PVRGUITimerInfo.h
@@ -43,7 +43,7 @@ public:
 
   bool HasTimers() const { return m_iTimerAmount > 0; }
   bool HasRecordingTimers() const { return m_iRecordingTimerAmount > 0; }
-  bool HasNonRecordingTimers() const { return m_iTimerAmount - m_iRecordingTimerAmount > 0; }
+  bool HasNonRecordingTimers() const { return m_iTimerAmount > m_iRecordingTimerAmount; }
 
 private:
   bool TimerInfoToggle();
-- 
2.53.0

