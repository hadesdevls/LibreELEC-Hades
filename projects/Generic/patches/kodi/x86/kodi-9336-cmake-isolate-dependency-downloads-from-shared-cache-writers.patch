From eae8ab87a5ca5daf12bb31f7e80c9bd0da87d72c Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 12 Oct 2026 22:57:09 -0700
Subject: [PATCH] [cmake] Isolate dependency downloads from shared cache
 writers

Concurrent builds can remove or truncate an archive while another build
is downloading or extracting it. Verify private copies and publish cache
updates atomically, keeping ExternalProject's download step build-local.

Bound cache-lock waits to 20 minutes so contention fails clearly.
---
 cmake/scripts/common/DownloadWithRetry.cmake | 64 ++++++++++++++------
 cmake/scripts/common/ModuleHelpers.cmake     | 24 ++++++--
 2 files changed, 64 insertions(+), 24 deletions(-)

diff --git a/cmake/scripts/common/DownloadWithRetry.cmake b/cmake/scripts/common/DownloadWithRetry.cmake
index 2749e09..39aa2a7 100644
--- a/cmake/scripts/common/DownloadWithRetry.cmake
+++ b/cmake/scripts/common/DownloadWithRetry.cmake
@@ -2,14 +2,14 @@
 # download step gives up on: it retries only connection-level curl errors (6 7 8 15 28
 # 35), so a response dropped or refused mid-transfer fails the dependency build.
 #
-# BUILD_DEP_TARGET runs this as a step ahead of the download step, which then finds the
-# file with a matching hash and skips the network.
+# BUILD_DEP_TARGET runs this ahead of the download step using a build-local
+# ARCHIVE_DEST. Only verified, complete downloads are published to ARCHIVE_CACHE.
 #
-# -DARCHIVE_URL=<url> -DARCHIVE_DEST=<path> -DARCHIVE_HASH=<ALGO>=<hex>
+# -DARCHIVE_URL=<url> -DARCHIVE_DEST=<path> -DARCHIVE_CACHE=<path> -DARCHIVE_HASH=<ALGO>=<hex>
 # CMAKE_TLS_* and CMAKE_NETRC* apply as they do to file(DOWNLOAD) when passed with -D.
 
-if(NOT ARCHIVE_URL OR NOT ARCHIVE_DEST OR NOT ARCHIVE_HASH)
-  message(FATAL_ERROR "DownloadWithRetry.cmake needs ARCHIVE_URL, ARCHIVE_DEST and ARCHIVE_HASH")
+if(NOT ARCHIVE_URL OR NOT ARCHIVE_DEST OR NOT ARCHIVE_CACHE OR NOT ARCHIVE_HASH)
+  message(FATAL_ERROR "DownloadWithRetry.cmake needs ARCHIVE_URL, ARCHIVE_DEST, ARCHIVE_CACHE and ARCHIVE_HASH")
 endif()
 if(NOT ARCHIVE_HASH MATCHES "^([A-Za-z0-9_]+)=([0-9A-Fa-f]+)$")
   message(FATAL_ERROR "DownloadWithRetry.cmake: ARCHIVE_HASH must be <ALGO>=<hex>, got '${ARCHIVE_HASH}'")
@@ -17,36 +17,62 @@ endif()
 set(_algo ${CMAKE_MATCH_1})
 string(TOLOWER "${CMAKE_MATCH_2}" _expected)
 
-if(EXISTS "${ARCHIVE_DEST}")
+if(EXISTS "${ARCHIVE_DEST}" AND NOT IS_DIRECTORY "${ARCHIVE_DEST}")
   file(${_algo} "${ARCHIVE_DEST}" _actual)
   if(_actual STREQUAL _expected)
     return()
   endif()
-  file(REMOVE "${ARCHIVE_DEST}")
 endif()
 
+get_filename_component(_dest_dir "${ARCHIVE_DEST}" DIRECTORY)
+file(MAKE_DIRECTORY "${_dest_dir}")
+file(LOCK "${ARCHIVE_CACHE}.lock" GUARD PROCESS TIMEOUT 1200)
+
+# Other cache writers may ignore the lock. Verify a private copy, never the
+# shared file that they can truncate or remove while it is being read.
+if(EXISTS "${ARCHIVE_CACHE}" AND NOT IS_DIRECTORY "${ARCHIVE_CACHE}")
+  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${ARCHIVE_CACHE}" "${ARCHIVE_DEST}"
+                  RESULT_VARIABLE _copy_result ERROR_QUIET)
+  if(_copy_result EQUAL 0)
+    file(${_algo} "${ARCHIVE_DEST}" _actual)
+    if(_actual STREQUAL _expected)
+      return()
+    endif()
+  endif()
+endif()
+
+string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _suffix)
+set(_download "${ARCHIVE_CACHE}.${_suffix}.tmp")
 set(_attempts 5)
 foreach(_attempt RANGE 1 ${_attempts})
-  file(DOWNLOAD "${ARCHIVE_URL}" "${ARCHIVE_DEST}" INACTIVITY_TIMEOUT 60 STATUS _status)
+  file(DOWNLOAD "${ARCHIVE_URL}" "${_download}" INACTIVITY_TIMEOUT 60 STATUS _status)
   list(GET _status 0 _code)
   list(GET _status 1 _error)
 
   if(_code EQUAL 0)
-    file(SIZE "${ARCHIVE_DEST}" _size)
-    if(_size GREATER 0)
-      file(${_algo} "${ARCHIVE_DEST}" _actual)
-      if(_actual STREQUAL _expected)
-        return()
+    set(_error "missing download output")
+    if(EXISTS "${_download}" AND NOT IS_DIRECTORY "${_download}")
+      execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${_download}" "${ARCHIVE_DEST}"
+                      RESULT_VARIABLE _copy_result ERROR_VARIABLE _error)
+      if(_copy_result EQUAL 0)
+        file(SIZE "${ARCHIVE_DEST}" _size)
+        if(_size GREATER 0)
+          file(${_algo} "${ARCHIVE_DEST}" _actual)
+          if(_actual STREQUAL _expected)
+            file(RENAME "${_download}" "${ARCHIVE_CACHE}")
+            return()
+          endif()
+          # A complete transfer with the wrong hash is a wrong pin, not a network fault
+          file(REMOVE "${_download}" "${ARCHIVE_DEST}")
+          message(FATAL_ERROR "${ARCHIVE_URL}: ${_algo} mismatch, expected ${_expected}, got ${_actual}")
+        endif()
+        # An empty 200 is the server failing mid-request, so it is retried like a dropped connection
+        set(_error "empty response")
       endif()
-      # A complete transfer with the wrong hash is a wrong pin, not a network fault
-      file(REMOVE "${ARCHIVE_DEST}")
-      message(FATAL_ERROR "${ARCHIVE_URL}: ${_algo} mismatch, expected ${_expected}, got ${_actual}")
     endif()
-    # An empty 200 is the server failing mid-request, so it is retried like a dropped connection
-    set(_error "empty response")
   endif()
 
-  file(REMOVE "${ARCHIVE_DEST}")
+  file(REMOVE "${_download}" "${ARCHIVE_DEST}")
   if(_attempt EQUAL _attempts)
     message(FATAL_ERROR "Failed to download ${ARCHIVE_URL} after ${_attempts} attempts: ${_error}")
   endif()
diff --git a/cmake/scripts/common/ModuleHelpers.cmake b/cmake/scripts/common/ModuleHelpers.cmake
index 6375a30..96130f5 100644
--- a/cmake/scripts/common/ModuleHelpers.cmake
+++ b/cmake/scripts/common/ModuleHelpers.cmake
@@ -521,13 +521,25 @@ macro(BUILD_DEP_TARGET)
     set(INSTALL_DIR ${DEP_LOCATION})
   endif()
 
+  set(_download_dir "${TARBALL_DIR}")
+  unset(_download_cache)
+  if(NOT ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_SOURCE_DIR
+     AND ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_HASH
+     AND ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_URL MATCHES "^[A-Za-z][A-Za-z0-9+.-]*://")
+    get_filename_component(_download_cache "${TARBALL_DIR}/${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_ARCHIVE}"
+                           ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
+    # ExternalProject may also download or remove archives, so give it a private copy.
+    get_filename_component(_download_dir "${CORE_BUILD_DIR}/${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_BUILD_NAME}/download"
+                           ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
+  endif()
+
   # Allow a target to supply in-tree source location. eg TexturePacker, JsonSchemaBuilder
   if(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_SOURCE_DIR)
     set(BUILD_DOWNLOAD_STEPS SOURCE_DIR "${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_SOURCE_DIR}")
   else()
     set(BUILD_DOWNLOAD_STEPS URL ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_URL}
                              URL_HASH ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_HASH}
-                             DOWNLOAD_DIR ${TARBALL_DIR}
+                             DOWNLOAD_DIR "${_download_dir}"
                              DOWNLOAD_NAME ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_ARCHIVE})
   endif()
 
@@ -550,9 +562,7 @@ macro(BUILD_DEP_TARGET)
   # Pointless for local tarballs, and without a hash the download step re-downloads
   # regardless. INDEPENDENT like the download step itself, which CMP0114 requires of
   # anything that step depends on.
-  if(NOT ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_SOURCE_DIR
-     AND ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_HASH
-     AND ${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_URL MATCHES "^[A-Za-z][A-Za-z0-9+.-]*://")
+  if(_download_cache)
     # ExternalProject bakes these into its download script; a cmake -P process would
     # not see them otherwise
     set(_download_retry_settings)
@@ -564,14 +574,18 @@ macro(BUILD_DEP_TARGET)
     externalproject_add_step(${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_BUILD_NAME} download-retry
                              COMMAND ${CMAKE_COMMAND} ${_download_retry_settings}
                                      -DARCHIVE_URL=${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_URL}
-                                     -DARCHIVE_DEST=${TARBALL_DIR}/${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_ARCHIVE}
+                                     -DARCHIVE_DEST=${_download_dir}/${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_ARCHIVE}
+                                     -DARCHIVE_CACHE=${_download_cache}
                                      -DARCHIVE_HASH=${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_HASH}
                                      -P ${PROJECTSOURCE}/cmake/scripts/common/DownloadWithRetry.cmake
                              DEPENDERS download
+                             DEPENDEES mkdir
                              INDEPENDENT TRUE
                              COMMENT "Fetching ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_ARCHIVE}")
     unset(_download_retry_settings)
   endif()
+  unset(_download_dir)
+  unset(_download_cache)
 
   set_target_properties(${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_BUILD_NAME} PROPERTIES FOLDER "External Projects")
 
-- 
2.53.0

