+/*!
+ * \brief How a value of the Monitor setting is shown: by the output that it names (OutputLabel(),
+ *        with its graphics device where connected outputs of more than one device are offered, as
+ *        the settings list them); the value itself where it names none (Default, a display that is
+ *        not connected)
+ */
+inline std::string ValueLabel(const std::vector<std::vector<DRMOutput>>& devices,
+                              const std::string& value)
+{
+  const auto withConnected = std::ranges::count_if(
+      devices, [](const std::vector<DRMOutput>& outputs)
+      { return std::ranges::any_of(outputs, [](const DRMOutput& o) { return o.connected; }); });
+  for (const auto& outputs : devices)
+  {
+    for (const DRMOutput& output : outputs)
+    {
+      if (IsAskedOutput(output, value))
+        return OutputLabel(output, withConnected > 1);
+    }
+  }
+  return value;
+}
+
+/*!
+ * \brief The outputs of every device, those that refused names counting as ones that cannot be
+ *        used (Hades: displays that were not kept, DRMMonitorConfirm.h); as they are where that
+ *        would leave none that can be used: a start never shows Kodi on no output for it
+ * \param refused names of outputs, with or without their device (IsAskedOutput())
+ */
+inline std::vector<std::vector<DRMOutput>> WithoutRefused(
+    const std::vector<std::vector<DRMOutput>>& devices, const std::vector<std::string>& refused)
+{
+  if (refused.empty())
+    return devices;
+  std::vector<std::vector<DRMOutput>> without = devices;
+  bool usable = false;
+  for (auto& outputs : without)
+  {
+    for (DRMOutput& output : outputs)
+    {
+      if (std::ranges::any_of(refused, [&output](const std::string& name)
+                              { return IsAskedOutput(output, name); }))
+        output.usable = false;
+      usable = usable || output.usable;
+    }
+  }
+  return usable ? without : devices;
+}
+
