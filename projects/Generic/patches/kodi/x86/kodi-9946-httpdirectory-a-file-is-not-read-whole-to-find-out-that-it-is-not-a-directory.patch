From ded3666a50efa9a354f8a8a1206eb95bf6c513cd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:11:48 +0000
Subject: [PATCH] HTTPDirectory: a file is not read whole to find out that it
 is not a directory

CHTTPDirectory::GetDirectory read the whole answer and only then looked at its headers to see that
the URL was a file (a length, and not a page). The search for subtitles beside a video on a server
of the local network lists the video's folder before the video is opened; when that folder's URL
answers with a file - a server or a local stream proxy that gives the video for any path - the
search read all of it first: 189 s for a 1.2 GB file at the video's rate, during which the video
did not start and Stop held the interface. A stream without a length was read for ever.

The headers are looked at before the body: a file with a length that is not a page, or a video or
a sound with or without a length, is not a directory, as the code already decided for the first
kind once it had read it all. A page is read and parsed as before, so the subtitles beside a video
on such a server are still found.
---
 xbmc/filesystem/HTTPDirectory.cpp | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/xbmc/filesystem/HTTPDirectory.cpp b/xbmc/filesystem/HTTPDirectory.cpp
index 1146d59..3bff44f 100644
--- a/xbmc/filesystem/HTTPDirectory.cpp
+++ b/xbmc/filesystem/HTTPDirectory.cpp
@@ -41,6 +41,21 @@ bool CHTTPDirectory::GetDirectory(const CURL& url, CFileItemList &items)
     return false;
   }
 
+  // A file is not a directory, and its headers say so: a file with a length that is not a page,
+  // or a video or a sound (a stream has no length). Its body is not read to find that out: that
+  // takes as long as the whole file takes to come, and a stream does not end.
+  const std::string length{http.GetHttpHeader().GetValue("Content-Length")};
+  const std::string type{http.GetHttpHeader().GetValue("Content-type")};
+  const bool page{StringUtils::StartsWithNoCase(type, "text/html")};
+  const bool media{StringUtils::StartsWithNoCase(type, "video/") ||
+                   StringUtils::StartsWithNoCase(type, "audio/")};
+  if ((!length.empty() && length != "0" && !page) || media)
+  {
+    CLog::Log(LOGDEBUG, "{} - {} is a file ({}, length {}), not a directory", __FUNCTION__,
+              url.GetRedacted(), type, length.empty() ? "unknown" : length);
+    return false;
+  }
+
   CRegExp reItem(true); // HTML is case-insensitive
   reItem.RegComp("<a href=\"([^\"]*)\"[^>]*>\\s*(.*?)\\s*</a>(.+?)(?=<a|</tr|$)");
 
@@ -76,13 +91,6 @@ bool CHTTPDirectory::GetDirectory(const CURL& url, CFileItemList &items)
   std::string strBuffer;
   if (http.ReadData(strBuffer) && !strBuffer.empty())
   {
-    /* if Content-Length is found and its not text/html, URL is pointing to file so don't treat URL as HTTPDirectory */
-    if (!http.GetHttpHeader().GetValue("Content-Length").empty() &&
-        !StringUtils::StartsWithNoCase(http.GetHttpHeader().GetValue("Content-type"), "text/html"))
-    {
-      return false;
-    }
-
     std::string fileCharset(http.GetProperty(XFILE::FileProperty::CONTENT_CHARSET));
     if (!fileCharset.empty() && fileCharset != "UTF-8")
     {
