@@ -1157,9 +1157,9 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   else if (info && info->SupportsLegacyDolbyVisionOnly())
   {
     code = "legacy";
-    reason = "the display advertises Dolby Vision only in an older version (a version 0 block, or "
-             "a version 1 block for the HDMI 1.4b vendor InfoFrame or with display management "
-             "before version 4), which native output does not implement";
+    reason = "the display advertises Dolby Vision only with the older signalling, the HDMI 1.4b "
+             "vendor InfoFrame (a version 0 block, the 15-byte version 1 block, or the 12-byte one "
+             "with the low-latency field 0), which native output does not send";
   }
   else if (info && !info->SupportsStandardDolbyVision() &&
            info->SupportsLowLatencyDolbyVisionOnly() && !lowLatency)
