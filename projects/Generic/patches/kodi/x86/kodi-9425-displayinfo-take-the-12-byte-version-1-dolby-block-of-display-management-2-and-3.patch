diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index bc9e4c1..267622c 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -36,8 +36,8 @@ namespace
 // - Version 2 with interface 2 or 3 advertises the Standard mode; 2160p60 is always there.
 // - A 12-byte version 1 block with the low-latency field 1 advertises the Standard mode with the
 //   same Dolby vendor InfoFrame (0 there, the 15-byte form and version 0 mean the HDMI 1.4b
-//   vendor InfoFrame), taken with display management 4 or later only: the metadata sent is the
-//   one of that version, and nothing reports whether an older display reads it.
+//   vendor InfoFrame), of any display management version (Hades: a display of 2 or 3 is sent the
+//   content mapping v2.9 part of the metadata, which it reads: dvbridge_set_display_management()).
 DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
 {
   static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
@@ -107,7 +107,7 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
         }
         else if (result.version == 1 && len == 11)
         {
-          result.standard = (data[7] & 3) == 1 && result.dmVersion >= 4;
+          result.standard = (data[7] & 3) == 1;
           result.at2160p60 = (data[4] & 2) != 0;
           // The low-latency field (p[3], bits 1 and 0) at 1: low latency next to the Standard mode
           // (libdisplay-info reads bit 0 alone; with 3, neither this rule nor the Standard one
@@ -334,7 +334,7 @@ void CDisplayInfo::LogInfo() const
               m_dolbyVideo.dmVersion ? std::to_string(m_dolbyVideo.dmVersion) + ".x" : "-",
               m_dolbyVideo.standard
                   ? (m_dolbyVideo.at2160p60 ? "standard" : "standard, 2160p up to 30 Hz")
-              : SupportsLegacyDolbyVisionOnly() ? "older version, not supported"
+              : SupportsLegacyDolbyVisionOnly() ? "older signalling (HDMI 1.4b), not sent"
                                                 : "without the standard mode");
   else if (m_dolbyVision)
     CLog::Log(LOGINFO, "[display-info] dolby vision: not taken (an invalid EDID block, or several "
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 596e51e..59b25b5 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -115,8 +115,8 @@ public:
   //! Dolby Vision Standard (TV-led) with the Dolby vendor InfoFrame, by the rule of the kernel
   //! backends (amdgpu, and i915/xe since linux-9965: the same one): exactly one Dolby VSVDB in
   //! valid EDID blocks, of version 2 with the Standard interface, or of version 1 in its 12-byte
-  //! form with the low-latency field 1 and display management version 4 or later (the metadata
-  //! sent is the one of that version).
+  //! form with the low-latency field 1, of any display management version (Hades: what a display of
+  //! 2 or 3 is sent, see StandardDolbyVisionDmVersion()).
   bool SupportsStandardDolbyVision() const { return m_dolbyVideo.standard; }
   //! The version of the block that advertises Dolby Vision Standard: 1 or 2, 0 without it.
   unsigned int StandardDolbyVisionVersion() const
@@ -138,9 +138,9 @@ public:
   {
     return m_dolbyVideo.standard && m_dolbyVideo.at2160p60;
   }
-  //! Dolby Vision only in an older version, which native output does not implement: a version 0
-  //! block, or a version 1 block for the HDMI 1.4b vendor InfoFrame or with display management
-  //! before version 4.
+  //! Dolby Vision only with the older signalling, the HDMI 1.4b vendor InfoFrame (24 bytes, OUI
+  //! 00-0C-03), which native output does not send: a version 0 block, the 15-byte version 1 block, or
+  //! the 12-byte one with the low-latency field 0.
   bool SupportsLegacyDolbyVisionOnly() const
   {
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version < 2;
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index cb036b3..0bd56fa 100644
