diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 124b03d..978bad2 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -9,6 +9,8 @@ struct dvbridge_context {
     /* Hades: dvbridge_set_display_management(); given to each frame's state when it is prepared
      * (not kept in the state: a commit puts back the state of its frame) */
     bool cm29_only;
+    /* Hades: DVBRIDGE_CM40_V29_ONLY (dvbridge_set_cm40()): the v2.9 part only, whatever the display */
+    bool cm29_forced;
 };
 
 struct dvbridge_candidate {
@@ -65,6 +67,16 @@ void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add)
         context->state.cm40_default = add;
 }
 
+void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq)
+{
+    if (!context)
+        return;
+    context->state.cm40_default = mode == DVBRIDGE_CM40_ADD;
+    context->state.cm40_auto = mode == DVBRIDGE_CM40_AUTO;
+    context->state.cm40_auto_peak_pq = display_peak_pq;
+    context->cm29_forced = mode == DVBRIDGE_CM40_V29_ONLY;
+}
+
 struct dvbridge_candidate *dvbridge_prepare(
     const struct dvbridge_context *context, const void *metadata, size_t bytes,
     double pts, struct dvbridge_geometry geometry, bool fel_reconstructed)
@@ -116,7 +128,7 @@ struct dvbridge_candidate *dvbridge_prepare_why(
     candidate->owner = context;
     candidate->revision = context->revision;
     candidate->state.fel_verified = fel_reconstructed;
-    candidate->state.cm29_only = context->cm29_only;
+    candidate->state.cm29_only = context->cm29_only || context->cm29_forced;
     /* (the serializer refuses more than one level 5 block, and sets the margins from the one
      * there is, or from none: dvbridge_dv_margins()) */
     /* (Hades: and the part of the picture drawn, where the geometry says it) */
@@ -205,6 +217,8 @@ bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
     reading->cm40_level = candidate->state.cm40_level;
     reading->cm40_length = candidate->state.cm40_length;
     reading->cm40_added = r->cm40_added;
+    reading->cm40_auto = candidate->state.cm40_auto && candidate->state.cm40_auto_on;
+    reading->cm40_auto_source = candidate->state.cm40_auto_source;
     reading->packets = candidate->state.count;
     reading->scene_refresh = candidate->state.size > 1 && candidate->state.payload[1] == 1;
     reading->metadata_id = candidate->state.id;
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 56c6280..f484d63 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -72,6 +72,16 @@ void dvbridge_set_trims(struct dvbridge_context *context, bool send);
  * (dvbridge_dv::cm40_default in dvbridge_metadata.h); false until said otherwise. Set and kept as
  * dvbridge_set_trims(). */
 void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add);
+/* Hades: the content mapping v4.0 setting (videoscreen.hadesdvcm40): as the RPU has it; the default v4.0 part
+ * added to RPUs without one (cm40_default); added automatically, decided once a stream, where the RPU has none and
+ * its mastering display is brighter than the display, whose peak is display_peak_pq (a 12-bit PQ level from its
+ * Dolby VSVDB; 0 not known: never added); or the content mapping v2.9 part only, as for a display of display
+ * management 2 or 3, whatever the display reads (for a display that needs it). Kept as cm40_default is. */
+#define DVBRIDGE_CM40_AS_GIVEN 0
+#define DVBRIDGE_CM40_ADD 1
+#define DVBRIDGE_CM40_AUTO 2
+#define DVBRIDGE_CM40_V29_ONLY 3
+void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq);
 
 /* No state advances until presentation succeeds and commit is called. */
 struct dvbridge_candidate *dvbridge_prepare(
@@ -136,6 +146,10 @@ struct dvbridge_reading {
      * then left out until the stream ends; cm40_why says why (a fixed text), cm40_level and
      * cm40_length of which block (its level, and its length in the RPU). */
     unsigned cm40_dropped;
+    /* Hades: DVBRIDGE_CM40_AUTO decided to add the default v4.0 part in this stream, and the mastering
+     * peak it was decided on (source_max_pq, 12-bit PQ) */
+    bool cm40_auto;
+    unsigned cm40_auto_source;
     const char *cm40_why;
     unsigned cm40_level, cm40_length;
     /* Hades: blocks of the default v4.0 part added to this frame (dvbridge_set_cm40_default()) */
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 0400f6b..128982a 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -115,6 +115,17 @@ struct dvbridge_dv {
      * (cm40_dropped); a frame whose payload has no room for it goes out without it. Kept from one stream
      * to the next (dvbridge_dv_restart()), as no_trims. */
     bool cm40_default;
+    /* Hades: cm40_auto, cm40_default decided once a stream (videoscreen.hadesdvcm40 automatic,
+     * dvbridge_set_cm40()): with the first frame that is made, on where its RPU has no v4.0 part and its
+     * mastering display (source_max_pq) is brighter than the display (cm40_auto_peak_pq, its peak as a
+     * 12-bit PQ level from its Dolby VSVDB; 0 not known: never on). Once a stream, so that the display does
+     * not switch between its two mappings within a film. cm40_auto_decided, cm40_auto_on and
+     * cm40_auto_source say what was decided, on what. The setting is kept from one stream to the next,
+     * the decision is not. */
+    bool cm40_auto;
+    unsigned cm40_auto_peak_pq;
+    bool cm40_auto_decided, cm40_auto_on;
+    unsigned cm40_auto_source;
 };
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
@@ -323,11 +334,14 @@ static inline uint32_t dvbridge_dv_crc(const uint8_t *p, size_t n)
 static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
 {
     const unsigned id = d->id;
-    const bool no_trims = d->no_trims, cm40_default = d->cm40_default;
+    const bool no_trims = d->no_trims, cm40_default = d->cm40_default, cm40_auto = d->cm40_auto;
+    const unsigned cm40_auto_peak_pq = d->cm40_auto_peak_pq;
     memset(d, 0, sizeof(*d));
     d->id = id;
     d->no_trims = no_trims;
     d->cm40_default = cm40_default;
+    d->cm40_auto = cm40_auto;
+    d->cm40_auto_peak_pq = cm40_auto_peak_pq;
     d->restart = true;
 }
 /* Hades: the extension levels that the serializer knows. ETSI GS CCM 001 V1.1.1 defines 1, 2 and 5
@@ -668,7 +682,14 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         return false; /* (d->refused says why) */
     /* Hades: the default v4.0 part (cm40_default), after the v2.9 part as an RPU has it, converted for
      * the tunnel as the blocks of an RPU are (dvbridge_cm4_wire() of their bytes in the RPU) */
-    if (d->cm40_default && !rpu_v40 && !d->cm29_only && !d->cm40_dropped) {
+    if (d->cm40_auto && !d->cm40_auto_decided) {
+        /* (Hades: once a stream, with its first frame made) */
+        d->cm40_auto_decided = true;
+        d->cm40_auto_source = c->source_max_pq;
+        d->cm40_auto_on = !rpu_v40 && d->cm40_auto_peak_pq && c->source_max_pq > d->cm40_auto_peak_pq;
+    }
+    if ((d->cm40_default || (d->cm40_auto && d->cm40_auto_on)) && !rpu_v40 && !d->cm29_only &&
