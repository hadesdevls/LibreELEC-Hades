+
+// (a 12-bit PQ level in cd/m2, SMPTE ST 2084)
+double CDVBridgeGLES::PQToNitsLevel(unsigned int level)
+{
+  const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128, c1 = 3424.0 / 4096,
+               c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+  const double e = std::pow(std::min(level, 4095u) / 4095.0, 1 / m2);
+  return 10000 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1 / m1);
 }
 
