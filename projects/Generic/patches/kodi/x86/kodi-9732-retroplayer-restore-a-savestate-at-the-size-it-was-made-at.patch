From b9de4326ab66e42989c8371c187908e6fa3a360d Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sat, 31 Oct 2026 13:37:19 +0000
Subject: [PATCH] [RetroPlayer] Restore a savestate at the size it was made at

An emulator's state size can change as it runs. Nestopia reports 5109
bytes before its first frame and 5100 once running, so a savestate made
in play fails with "Invalid memory size" when it is picked as the game
starts, and one made after starting from a savestate fails in play.

Pass the savestate's own size to the emulator and let it decide, as
RetroArch does. The rewind history only starts from the loaded state
when the sizes match.
---
 .../playback/ReversiblePlayback.cpp           | 33 +++++++++++--------
 .../addons/disc/test/TestGameClientDiscs.cpp  | 22 ++++++++++++-
 2 files changed, 41 insertions(+), 14 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/playback/ReversiblePlayback.cpp b/xbmc/cores/RetroPlayer/playback/ReversiblePlayback.cpp
index 824c202..9efcecd 100644
--- a/xbmc/cores/RetroPlayer/playback/ReversiblePlayback.cpp
+++ b/xbmc/cores/RetroPlayer/playback/ReversiblePlayback.cpp
@@ -425,17 +425,20 @@ bool CReversiblePlayback::LoadSavestate(const std::string& savestatePath)
   std::unique_ptr<ISavestate> savestate = CSavestateDatabase::AllocateSavestate();
   if (m_savestateDatabase->GetSavestate(savestatePath, *savestate))
   {
-    if (!savestate->PrepareMemoryData(memorySize))
+    // The size a client reports can change as it runs, so a savestate is
+    // restored at its own size and the client decides whether it fits
+    const size_t savedSize = savestate->GetMemorySize();
+
+    if (!savestate->PrepareMemoryData(savedSize))
     {
       CLog::Log(LOGERROR, "RetroPlayer[SAVE]: Failed to prepare memory data");
     }
-    else if (savestate->GetMemorySize() != memorySize)
-    {
-      CLog::Log(LOGERROR, "Invalid memory size, got {}, expected {}", savestate->GetMemorySize(),
-                memorySize);
-    }
     else
     {
+      if (savedSize != memorySize)
+        CLog::Log(LOGDEBUG, "RetroPlayer[SAVE]: Savestate size is {}, client reports {}", savedSize,
+                  memorySize);
+
       std::optional<GAME::CGameClientDiscModel> discModel;
       if (const auto discState = savestate->GetDiscState())
       {
@@ -456,7 +459,7 @@ bool CReversiblePlayback::LoadSavestate(const std::string& savestatePath)
                   discState->slots.size(), discState->selectedSlot, discState->trayEjected);
       }
 
-      const RestoreResult result = m_gameClient->Deserialize(savestate->GetMemoryData(), memorySize,
+      const RestoreResult result = m_gameClient->Deserialize(savestate->GetMemoryData(), savedSize,
                                                              discModel ? &*discModel : nullptr);
       if (result == RestoreResult::Restored)
       {
@@ -486,12 +489,16 @@ bool CReversiblePlayback::LoadSavestate(const std::string& savestatePath)
           const uint64_t maxFrames = m_memoryStream->MaxFrameCount();
           m_memoryStream->Init(memorySize, maxFrames);
           m_discStateHistory.Clear();
-          std::memcpy(m_memoryStream->BeginFrame(), savestate->GetMemoryData(), memorySize);
-          const uint32_t discStateId =
-              m_gameClient->SupportsDiscControl()
-                  ? m_discStateHistory.Intern(m_gameClient->Discs().GetDiscsForSnapshot())
-                  : 0;
-          m_memoryStream->SubmitFrame(discStateId, savestate->TimestampFrames());
+          // Rewind frames are the client's current size
+          if (savedSize == memorySize)
+          {
+            std::memcpy(m_memoryStream->BeginFrame(), savestate->GetMemoryData(), memorySize);
+            const uint32_t discStateId =
+                m_gameClient->SupportsDiscControl()
+                    ? m_discStateHistory.Intern(m_gameClient->Discs().GetDiscsForSnapshot())
+                    : 0;
+            m_memoryStream->SubmitFrame(discStateId, savestate->TimestampFrames());
+          }
           UpdatePlaybackStats();
         }
         m_totalFrameCount = savestate->TimestampFrames();
diff --git a/xbmc/games/addons/disc/test/TestGameClientDiscs.cpp b/xbmc/games/addons/disc/test/TestGameClientDiscs.cpp
index 7a86891..93a082c 100644
--- a/xbmc/games/addons/disc/test/TestGameClientDiscs.cpp
+++ b/xbmc/games/addons/disc/test/TestGameClientDiscs.cpp
@@ -165,6 +165,7 @@ struct DiscCore
   std::vector<bool> frameInputs;
   bool compactRemoval{false};
   unsigned int deserializeCalls{0};
+  size_t deserializedSize{0};
   std::vector<std::string> deserializedSlots;
   std::string machinePath;
 };
@@ -388,10 +389,11 @@ protected:
     TestMember<ClientFrameRate>(*m_client) = 1.0;
     TestMember<ClientGamePath>(*m_client) = m_core.slots.front();
     auto* callbacks = m_client->GetInstanceInterface()->toAddon;
-    callbacks->Deserialize = [](const AddonInstance_Game* game, const uint8_t* data, size_t)
+    callbacks->Deserialize = [](const AddonInstance_Game* game, const uint8_t* data, size_t size)
     {
       auto& core = Core(game);
       ++core.deserializeCalls;
+      core.deserializedSize = size;
       core.machineFrame = 99;
       if (core.failAllFrames || data[0] == core.failedFrame)
         return GAME_ERROR_FAILED;
@@ -1276,6 +1278,24 @@ TEST_F(TestGameClientDiscs, SavestateDeserializeFailureLeavesStateUncertainDespi
   EXPECT_TRUE(m_playback->CreateSavestate(false).empty());
 }
 
+TEST_F(TestGameClientDiscs, SavestateOfAnotherSizeIsRestoredAtItsOwnSize)
+{
+  m_core.slots = {CreateFile(".chd")};
+  StartPlaying();
+  CreatePlayback();
+  // Before its first frame, a client can report another size than the one
+  // the savestate was made at
+  TestMember<ClientSerializeSize>(*m_client) = 2;
+
+  EXPECT_TRUE(m_playback->LoadSavestate(WriteSavestate(nullptr)));
+
+  EXPECT_EQ(m_core.machineFrame, 1);
+  EXPECT_EQ(m_core.deserializedSize, 1U);
+  const auto& memory = TestMember<PlaybackMemory>(*m_playback);
+  EXPECT_EQ(memory->FrameSize(), 2U);
+  EXPECT_EQ(memory->CurrentFrame(), nullptr);
+}
+
 TEST_F(TestGameClientDiscs, SavestateDiscRollbackFailureLeavesStateUncertainBeforeDeserialize)
 {
   m_core.slots = {CreateFile(".chd"), CreateFile(".chd")};
-- 
2.53.0

