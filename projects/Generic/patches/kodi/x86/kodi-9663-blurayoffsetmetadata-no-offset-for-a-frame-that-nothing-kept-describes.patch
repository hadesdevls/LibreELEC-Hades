From 63da3be2ad1c0f4172a6f572ddab6726bec77a16 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:28:48 +0000
Subject: [PATCH] BlurayOffsetMetadata: no offset for a frame that nothing kept
 describes

COffsetMetadataStore::GetOffset() answered 0 when no block it keeps describes
the frame, and when the block that does carries no such sequence. The player
hands the answer on as the disc's (CVideoPlayer::GetSubtitlePlaneOffset()), and
CRenderer::SubtitleDepth() takes an answer of 0 as the depth the title asks for,
the screen, in place of the subtitles.stereoscopicdepth setting. So wherever the
title gave no offset for a frame, the viewer's own subtitle depth was replaced
by 0:

- on every frame of an MVC remux whose dependent view carries no offsets: a PG
  stream of such a file is given a sequence (by its "3d-plane" tag, or by its
  position) as soon as the demuxer keeps a store, which it does for every MVC
  track it decodes as two views, offsets or not;
- on a disc whose playlist names a sequence that its dependent view does not
  carry, or that a mis-tagged remux names;
- on the frames after a seek, a play item change or a playlist that is read
  again, before the first block arrives.

With the setting at its default of 0 none of this shows; with any other value
the subtitles went to the screen there.

Answer no value in those cases, which leaves the setting in charge, as for a
title that says nothing. A frame that a block describes keeps its offset, 0
included. The newest block that covers the frame decides: one that does not
carry the sequence answers nothing, rather than an older block for the same
time. The tests say so (three new cases; the four that expected 0 for a frame
that nothing describes now expect no value).

The CroqueMr fork has GetOffset() answer no value in the same cases; written
here for this tree.
---
 .../DVDDemuxers/BlurayOffsetMetadata.cpp      | 10 +++-
 .../DVDDemuxers/BlurayOffsetMetadata.h        | 11 ++++-
 .../test/TestBlurayOffsetMetadata.cpp         | 49 ++++++++++++++++---
 3 files changed, 59 insertions(+), 11 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
index 57591d8..b6ce234 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
@@ -231,7 +231,7 @@ void COffsetMetadataStore::NoteFrame(double pts)
     newest.startPts = pts;
 }
 
-int COffsetMetadataStore::GetOffset(double pts, unsigned int sequence) const
+std::optional<int> COffsetMetadataStore::GetOffset(double pts, unsigned int sequence) const
 {
   std::unique_lock lock(m_section);
 
@@ -240,10 +240,16 @@ int COffsetMetadataStore::GetOffset(double pts, unsigned int sequence) const
   {
     const long frame{std::lround((pts - entry.startPts) / entry.frameDuration)};
     if (frame >= 0 && frame < static_cast<long>(entry.metadata.frames))
+    {
+      // (Hades: the block that describes the frame decides, also when it does not carry the
+      // sequence; an older block for the same time is not asked)
+      if (sequence >= entry.metadata.sequences)
+        return std::nullopt;
       return entry.metadata.Offset(sequence, static_cast<unsigned int>(frame));
+    }
   }
 
-  return 0;
+  return std::nullopt;
 }
 
 void COffsetMetadataStore::Flush()
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
index 9633a99..786635b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
@@ -92,8 +92,15 @@ public:
   //!        frame shown, which in an open GOP is a leading frame decoded after the carrier.
   void NoteFrame(double pts);
 
-  //! \brief The offset a sequence asks for at \p pts, or 0 when nothing describes it.
-  int GetOffset(double pts, unsigned int sequence) const;
+  /*!
+   * \brief The offset a sequence asks for at \p pts.
+   *
+   * No value when no block kept describes that frame, or when the newest block that does
+   * carries no such sequence: the title then says nothing about the frame, and the subtitles
+   * are placed as for a title that says nothing (the subtitles.stereoscopicdepth setting).
+   * An offset of 0 that a block gives is an answer like any other.
+   */
+  std::optional<int> GetOffset(double pts, unsigned int sequence) const;
 
   void Flush();
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
index c4e0dfa..1232ea1 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
@@ -171,10 +171,45 @@ TEST(TestBlurayOffsetMetadata, StoreFindsTheFrameAtATime)
   // Close enough to a frame is that frame; the presented time need not be exact.
   EXPECT_EQ(store.GetOffset(6100.0, 0), 2);
 
-  // Outside what the block describes, and for a sequence it does not carry.
-  EXPECT_EQ(store.GetOffset(4000.0, 0), 0);
-  EXPECT_EQ(store.GetOffset(8000.0, 0), 0);
-  EXPECT_EQ(store.GetOffset(5000.0, 5), 0);
+  // Outside what the block describes, and for a sequence it does not carry: no answer (Hades:
+  // the title says nothing about that frame, and the setting places its subtitles).
+  EXPECT_FALSE(store.GetOffset(4000.0, 0));
+  EXPECT_FALSE(store.GetOffset(8000.0, 0));
+  EXPECT_FALSE(store.GetOffset(5000.0, 5));
+}
+
+TEST(TestBlurayOffsetMetadata, StoreAnswersTheZeroOfABlock)
+{
+  // Hades: an offset of 0 that the title gives (as 0x00 or as 0x80, either direction) is an
+  // answer, unlike a frame that nothing describes.
+  OffsetMetadata metadata;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 1, 2, {0x00, 0x80}), metadata));
+
+  COffsetMetadataStore store;
+  store.Add(0.0, FRAME, std::move(metadata));
+
+  ASSERT_TRUE(store.GetOffset(0.0, 0).has_value());
+  EXPECT_EQ(*store.GetOffset(0.0, 0), 0);
+  ASSERT_TRUE(store.GetOffset(FRAME, 0).has_value());
+  EXPECT_EQ(*store.GetOffset(FRAME, 0), 0);
+  EXPECT_FALSE(store.GetOffset(2 * FRAME, 0));
+}
+
+TEST(TestBlurayOffsetMetadata, StoreLetsTheNewestBlockDecide)
+{
+  // Hades: two blocks for the same time (a loop): the newer one, which carries one sequence,
+  // answers for its sequence and says nothing for the second one, which only the older block has.
+  OffsetMetadata older;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 2, 1, {3, 7}), older));
+  OffsetMetadata newer;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 1, 1, {5}), newer));
+
+  COffsetMetadataStore store;
+  store.Add(0.0, FRAME, std::move(older));
+  store.Add(0.0, FRAME, std::move(newer));
+
+  EXPECT_EQ(store.GetOffset(0.0, 0), 5);
+  EXPECT_FALSE(store.GetOffset(0.0, 1));
 }
 
 TEST(TestBlurayOffsetMetadata, StoreStartsAnOpenGopAtItsFirstShownFrame)
@@ -207,7 +242,7 @@ TEST(TestBlurayOffsetMetadata, StoreIgnoresAFrameFarBeforeTheNewestBlock)
   // Too far back for a leading frame: a loop or a timestamp jump.
   store.NoteFrame(20000.0);
   EXPECT_EQ(store.GetOffset(50000.0, 0), 1);
-  EXPECT_EQ(store.GetOffset(20000.0, 0), 0);
+  EXPECT_FALSE(store.GetOffset(20000.0, 0));
 }
 
 TEST(TestBlurayOffsetMetadata, StoreForgetsWhatItIsToldTo)
@@ -220,7 +255,7 @@ TEST(TestBlurayOffsetMetadata, StoreForgetsWhatItIsToldTo)
   EXPECT_EQ(store.GetOffset(0.0, 0), 4);
 
   store.Flush();
-  EXPECT_EQ(store.GetOffset(0.0, 0), 0);
+  EXPECT_FALSE(store.GetOffset(0.0, 0));
 }
 
 TEST(TestBlurayOffsetMetadata, StoreKeepsTheMostRecentBlocks)
@@ -236,7 +271,7 @@ TEST(TestBlurayOffsetMetadata, StoreKeepsTheMostRecentBlocks)
   }
 
   EXPECT_EQ(store.GetOffset(99 * FRAME, 0), 1 + 99 % 9);
-  EXPECT_EQ(store.GetOffset(0.0, 0), 0);
+  EXPECT_FALSE(store.GetOffset(0.0, 0));
 }
 
 TEST(TestBlurayOffsetMetadata, ReadsTheSequenceARemuxTagNames)
