From 426e2110583c545b2fae9c10d5adf50545c8bc33 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:00:42 +0000
Subject: [PATCH] windowing/gbm: report Dolby Vision where native output can be
 had as set

System.SupportedHDRTypes, which add-ons may read to choose a stream, said
"Dolby Vision" where native output was possible in some transport mode, also
where a refresh rate that is not adjusted to the video (Settings > Player >
Videos) and is none of the transport's (100, 119.88, 120 or 144 Hz) keeps every
video from such a mode: there no video goes out as Dolby Vision, since Dolby
Vision never changes the refresh rate the video gets. It now says it only where
native output can be had with the settings as they are
(CWinSystemGbm::NativeDVOutputReachable()). Elsewhere a Dolby Vision stream is
rebuilt and sent as HDR10, mapped to SDR, or played by its base layer, and an
add-on that is told so can choose an HDR10 version of the title instead.

The comment gave as the reason that a Low-Latency-only TV shows a profile 5
stream in the wrong colours, which the conversion to HDR10 ended on HDR10
outputs and the mapping to SDR ends on the others; the reason that stays is
that only native output is Dolby Vision on the display. Nothing of Kodi's own
decisions reads this report on GBM: the choice of mode and of the decoder, and
the video settings of the player, still ask SupportsNativeDVOutput(true).

Compiled in syntax-only mode and read; not run.

The mode of the output that native output needs is looked at per refresh rate
(OfferedDVTransportModes(): an output can have 3840x2160 at some rates of the
transport and not at others, as an HDMI port of 300 MHz has it at 24 to 30 Hz
only). So a refresh rate that is kept where it is set also keeps every video
from native output where it is one of the transport's at which the output has
no transport mode: DVBRIDGE::RefreshRateKeepsFromTransport() says both. A host
test runs it against a model of an output (its modes and the one that is set,
the rate kept or adjusted): the same answer in all 1280 cases; the rule with the
rate kept that is none of the transport's alone gives another one in 128.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 24 ++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 28 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbm.h             |  5 ++++
 3 files changed, 53 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index d6145ea..f76019d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -142,6 +142,30 @@ inline const char* ModeReason(bool anyMode,
   return "";
 }
 
+/*!
+ * \brief Hades: whether the refresh rate, kept where it is set (it is not adjusted to the video),
+ *        keeps every video from native output: it is none of the transport's ("refresh" in
+ *        ModeReason()), or the output has no transport mode at it ("noratemode": an HDMI port of 300
+ *        MHz has 3840x2160 at 24 to 30 Hz only). Dolby Vision never takes another refresh rate than
+ *        the one the video gets, so there no video goes out natively, in whatever mode it opens.
+ *        Asked before a video, where the output has a transport mode at all (ModeReason() with
+ *        anyMode): the Dolby Vision that add-ons are told of (NativeDVOutputReachable()). A mode
+ *        that carries native output, and an interlaced or 3D one (left out as in
+ *        RefreshRateKeepsOrdinary()), keep nothing.
+ * \param offered what the modes of the output offer at the rate of the mode (TransportModesOf())
+ */
+inline bool RefreshRateKeepsFromTransport(bool refreshFixed,
+                                          double modeRate,
+                                          bool modeIsTransport,
+                                          bool modeInterlacedOr3D,
+                                          TransportModes offered)
+{
+  if (!refreshFixed || modeIsTransport || modeInterlacedOr3D)
+    return false;
+  return RefreshRateKeepsOrdinary(refreshFixed, modeRate, modeInterlacedOr3D) ||
+         offered != TransportModes::AT_RATE;
+}
+
 // Above 30 Hz, the transport needs a display that takes Dolby Vision at 2160p60 (VICs 96 and 97):
 // every version 2 Dolby VSVDB, and the version 1 blocks that advertise it.
 inline bool TransportRateNeeds2160p60(double refresh)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 230674d..7fcc623 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1262,6 +1262,22 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   return reason == nullptr;
 }
 
+bool CWinSystemGbm::NativeDVOutputReachable() const
+{
+  if (!SupportsNativeDVOutput(true))
+    return false;
+  // The verdict in any mode leaves out the refresh rate (SupportsNativeDVOutput()): a mode of
+  // another rate may come with the video. Not when the rate is not adjusted to it and the output
+  // has no transport mode at the one set (none of the transport's, or one at which the output has
+  // transport modes at other rates only), where no video reaches one.
+  const auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  return !(connector && mode &&
+           DVBRIDGE::RefreshRateKeepsFromTransport(
+               RefreshRateFixed(), ModeRate(*mode), IsDVTransportMode(*mode),
+               DVModeInterlacedOr3D(*mode), OfferedDVTransportModes(*connector, ModeRate(*mode))));
+}
+
 bool CWinSystemGbm::DVTurnedOff() const
 {
   int off = m_dvTurnedOff;
@@ -2419,10 +2435,14 @@ CHDRCapabilities CWinSystemGbm::GetDisplayHDRCapabilities() const
     caps.SetHLG();
 
 #ifdef HAVE_DVBRIDGE
-  // Dolby Vision plays correctly only through native output: report it (System.SupportedHDRTypes,
-  // which add-ons may use to choose streams) when native output is possible in a transport mode,
-  // not for any Dolby Vision block (a Low-Latency-only TV shows a profile 5 stream in wrong colours).
-  if (SupportsNativeDVOutput(true))
+  // Dolby Vision is reported (System.SupportedHDRTypes, which add-ons may use to choose streams)
+  // where the display is sent Dolby Vision: where native output can be had with the settings as
+  // they are, not for any Dolby Vision block. Elsewhere a Dolby Vision stream is rebuilt and sent
+  // as HDR10, or mapped to SDR (profile 5), or plays by its base layer, the version made for
+  // displays without Dolby Vision: an add-on that is told so can pick that version, or an HDR10
+  // stream, for it. (Hades: also not where a refresh rate that is not adjusted to the video keeps
+  // every video from a transport mode, NativeDVOutputReachable(); before, it was reported there.)
+  if (NativeDVOutputReachable())
     caps.SetDolbyVision();
 #else
   if (info->SupportsDolbyVision())
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 0261a63..fbf44ee 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -107,6 +107,11 @@ public:
   //! (3840x2160 at 23.976 to 60 Hz) even if the current mode is another one: that query does not
   //! change the verdict that is logged and shown in the player information.
   bool SupportsNativeDVOutput(bool anyMode = false) const;
+  //! Hades: native Dolby Vision output can be had with the settings as they are: possible in a
+  //! transport mode (SupportsNativeDVOutput(true)), and not kept from every one by a refresh rate
+  //! that is not adjusted to the video and is none of the transport's (Dolby Vision never changes
+  //! the refresh rate the video gets). What is reported to add-ons (GetDisplayHDRCapabilities()).
+  bool NativeDVOutputReachable() const;
   //! Stop using native Dolby Vision output after a failure, until a later video tries it again:
   //! the next one after a first failure, then the one after 2, 4 and at most 8 videos, or the next
   //! one if the display changed (see DVNewVideo). Nothing enables it again during a video.
-- 
2.53.0

