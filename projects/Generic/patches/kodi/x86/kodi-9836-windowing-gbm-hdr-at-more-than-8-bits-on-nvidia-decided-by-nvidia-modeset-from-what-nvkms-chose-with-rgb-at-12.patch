+void CWinSystemGbm::ApplyHdrMoreBits()
+{
+  using namespace HDR_MORE_BITS;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !Supported())
+    return;
+  const std::string key = OutputModeKey();
+  const auto cap = m_hdrMoreBitsCap.find(key);
+  const Level wanted = Wanted(settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDRMOREBITS),
+                              settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDRDEEPCOLOUR));
+  const Level level = Allowed(wanted, cap != m_hdrMoreBitsCap.end()
+                                          ? std::optional<Level>(cap->second)
+                                          : std::nullopt);
+  Apply(ParamsOf(level),
+        level != wanted ? "in " + key + ", where the display did not lock onto more earlier in this "
+                                        "session"
+                        : std::string());
+  m_hdrMoreBitsKey = key;
+  m_hdrMoreBitsAsked = level;
 }
 
