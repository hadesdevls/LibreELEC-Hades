diff --git a/xbmc/settings/SettingConditions.cpp b/xbmc/settings/SettingConditions.cpp
index 038091c..2a28ab4 100644
--- a/xbmc/settings/SettingConditions.cpp
+++ b/xbmc/settings/SettingConditions.cpp
@@ -248,6 +248,15 @@ bool SupportsHDRMoreBits(const std::string& /*condition*/,
   return winSystem && winSystem->SupportsHDRMoreBits();
 }
 
+// Hades: ... and RGB at 12 bits first, where the driver has it (HdrMoreBits.h)
+bool SupportsHDRDeepColour(const std::string& /*condition*/,
+                           const std::string& /*value*/,
+                           const SettingConstPtr& /*setting*/)
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  return winSystem && winSystem->SupportsHDRDeepColour();
+}
+
 // Hades: an NVIDIA graphics card that the driver "nvidia" runs, for "Keep the graphics card at full
 // speed while HD audio plays through" (GpuClockHold.h)
 bool SupportsGpuClockHold(const std::string& /*condition*/,
@@ -592,6 +601,7 @@ void CSettingConditions::Initialize()
   m_complexConditions.try_emplace("supportshdrycbcr420", SupportsHDRYCbCr420Choice);
   m_complexConditions.try_emplace("supportshdrdepthchoice", SupportsHDRDepthChoice);
   m_complexConditions.try_emplace("supportshdrmorebits", SupportsHDRMoreBits);
+  m_complexConditions.try_emplace("supportshdrdeepcolour", SupportsHDRDeepColour);
   m_complexConditions.try_emplace("supportsgpuclockhold", SupportsGpuClockHold);
