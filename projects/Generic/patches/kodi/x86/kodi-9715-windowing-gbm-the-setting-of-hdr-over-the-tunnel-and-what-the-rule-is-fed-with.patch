--- a/xbmc/windowing/gbm/HDR10Tunnel.h
+++ b/xbmc/windowing/gbm/HDR10Tunnel.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include <cstdint>
+#include <string_view>
 
 namespace KODI::WINDOWING::GBM
 {
@@ -48,12 +49,17 @@ enum class Link
 struct Input
 {
   bool setting = false; //!< the user allows HDR over the tunnel
+  bool disabled = false; //!< a tunnel of this display failed earlier in this session (until it changes)
+  bool formatChosen = false; //!< the user chose a colour format, or RGB at 8 bits for HDR: theirs
   bool kernelBackend = false; //!< the connector has DVBRIDGE_DV_STANDARD_LAB (i915, xe, amdgpu)
   bool hasProperty = false; //!< ... and DVBRIDGE_HDR10_TUNNEL_LAB
   bool hdmiTmds = false; //!< an HDMI connector that the driver drives as TMDS (no FRL)
   bool displayYcbcr422 = false; //!< the EDID declares YCbCr 4:2:2 (CDisplayInfo::SupportsYCbCr422())
   bool displayHdr = false; //!< the EDID has an HDR static metadata block
-  bool hdrPicture = false; //!< what is shown is HDR10, HLG, HDR10+ or Dolby Vision as HDR10
+  bool hdrPicture = false; //!< what is shown is HDR10, HLG or HDR10+ (not Dolby Vision, which has its own ways)
+  //! ... and one that the bridge draws as it is: BT.2020 with the matrix for non-constant luminance,
+  //! progressive and 2D (as for the other pictures that it draws, DVBRIDGE::PlainMappingEligible())
+  bool pictureTaken = true;
   bool nativeDolbyVision = false; //!< native Dolby Vision output has the output (the other tunnel)
   int width = 0;
   int height = 0;
@@ -65,15 +71,48 @@ enum class Why
 {
   USE,
   SETTING,
+  DISABLED, //!< a tunnel failed on this display; not tried again until it changes
+  CHOICE, //!< the user chose the colour format (or RGB at 8 bits for HDR)
   DRIVER, //!< no kernel backend, or a kernel without the property
   LINK, //!< not HDMI over TMDS
   DISPLAY, //!< no 4:2:2 or no HDR in the EDID
   PICTURE, //!< not HDR
+  FORMAT, //!< HDR that the bridge does not draw as it is (not BT.2020 NCL, interlaced, 3D)
   DOLBY_VISION, //!< native Dolby Vision has the output
   MODE, //!< not 3840x2160 at 50 or 60 Hz
   ORDINARY, //!< the ordinary output is as good, or not known
 };
 
+//! The link of the ordinary output from what DVBRIDGE_LINK_FORMAT says of it (DVBRIDGE::LINK::Format): RGB at
+//! 8 bits, RGB at more, YCbCr 4:2:0 and YCbCr 4:2:2 are the ones that the rule knows; 4:4:4, a depth that is
+//! not said, anything else: not known (fail closed)
+constexpr Link LinkOf(std::string_view format, unsigned bpc)
+{
+  if (bpc < 8)
+    return Link::UNKNOWN;
+  if (format == "rgb")
+    return bpc == 8 ? Link::RGB8 : Link::RGB_DEEP;
+  if (format == "ycbcr420")
+    return Link::YCBCR420;
+  if (format == "ycbcr422")
+    return Link::YCBCR422;
+  return Link::UNKNOWN;
+}
+
+//! What is shown is HDR10, HLG or HDR10+ (a PQ or an HLG picture), and not Dolby Vision: a Dolby Vision picture
+//! goes native or reconstructed as HDR10, its own ways, which this does not take over
+constexpr bool IsHdrPicture(bool pq, bool hlg, bool dolbyVision)
+{
+  return (pq || hlg) && !dolbyVision;
+}
+
+//! A picture that the bridge draws as it is (dvbridge_render_plain()): PQ or HLG, BT.2020 primaries with the
+//! matrix for non-constant luminance, progressive, 2D
+constexpr bool PictureTaken(bool pq, bool hlg, bool bt2020, bool ncl, bool interlaced, bool stereo)
+{
+  return (pq || hlg) && !(pq && hlg) && bt2020 && ncl && !interlaced && !stereo;
+}
+
 //! 3840x2160 at 50 or 60 Hz, fractional rates included: what HDMI 2.0 does not carry as RGB at
 //! 10 bits (CTA VIC 96 and 97)
 constexpr bool IsUhd2160p50Or60(int width, int height, double refresh)
@@ -85,6 +124,10 @@ constexpr Why Decide(const Input& in)
 {
   if (!in.setting)
     return Why::SETTING;
+  if (in.disabled)
+    return Why::DISABLED;
+  if (in.formatChosen)
+    return Why::CHOICE;
   if (!in.kernelBackend || !in.hasProperty)
     return Why::DRIVER;
   if (!in.hdmiTmds)
@@ -93,6 +136,8 @@ constexpr Why Decide(const Input& in)
     return Why::DISPLAY;
   if (!in.hdrPicture)
     return Why::PICTURE;
+  if (!in.pictureTaken)
+    return Why::FORMAT;
   if (in.nativeDolbyVision)
     return Why::DOLBY_VISION;
   if (!IsUhd2160p50Or60(in.width, in.height, in.refresh))
@@ -111,6 +156,10 @@ constexpr const char* Code(Why why)
       return "use";
     case Why::SETTING:
       return "setting";
+    case Why::DISABLED:
+      return "disabled";
+    case Why::CHOICE:
+      return "choice";
     case Why::DRIVER:
       return "driver";
     case Why::LINK:
@@ -119,6 +168,8 @@ constexpr const char* Code(Why why)
       return "display";
     case Why::PICTURE:
       return "picture";
+    case Why::FORMAT:
+      return "format";
     case Why::DOLBY_VISION:
       return "dolbyvision";
     case Why::MODE:
