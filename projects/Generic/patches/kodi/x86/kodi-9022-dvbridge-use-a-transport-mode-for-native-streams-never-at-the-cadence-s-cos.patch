+#ifdef HAVE_DVBRIDGE
+bool CResolutionUtils::IsDVTransportResolution(RESOLUTION resolution)
+{
+  const RESOLUTION_INFO info =
+      CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(resolution);
+  return !(info.dwFlags & (D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) &&
+         DVBRIDGE::IsTransportMode(info.iScreenWidth, info.iScreenHeight, info.fRefreshRate,
+                                   (info.dwFlags & D3DPRESENTFLAG_INTERLACED) != 0);
+}
+
+bool CResolutionUtils::FindDVTransportResolution(float refresh, bool useWhitelist,
+                                                 RESOLUTION& resolution)
+{
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  if (IsDVTransportResolution(resolution))
+    return true;
+
+  std::vector<RESOLUTION> candidates;
+  const std::vector<CVariant> whitelist =
+      useWhitelist ? CServiceBroker::GetSettingsComponent()->GetSettings()->GetList(
+                         CSettings::SETTING_VIDEOSCREEN_WHITELIST)
+                   : std::vector<CVariant>{};
+  if (whitelist.empty())
+    gfx.GetAllowedResolutions(candidates);
+  else
+    for (const auto& mode : whitelist)
+      candidates.push_back(CDisplaySettings::GetInstance().GetResFromString(mode.asString()));
+
+  for (const RESOLUTION r : candidates)
+  {
+    if (IsDVTransportResolution(r) &&
+        MathUtils::FloatEquals(gfx.GetResInfo(r).fRefreshRate, refresh, 0.01f))
+    {
+      CLog::Log(LOGINFO, "[DV] native Dolby Vision output: {} instead of {}, same refresh rate",
+                gfx.GetResInfo(r).strMode, gfx.GetResInfo(resolution).strMode);
+      resolution = r;
+      return true;
+    }
+  }
+  CLog::Log(LOGINFO,
+            "[DV] no 3840x2160 mode at {:.3f} Hz in the {}: {} stays, without native Dolby Vision",
+            refresh, whitelist.empty() ? "display modes" : "whitelist",
+            gfx.GetResInfo(resolution).strMode);
+  return false;
+}
+
+RESOLUTION CResolutionUtils::ChooseDVResolutionWithoutAdjustment(bool nativeDV)
+{
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const RESOLUTION current = gfx.GetVideoResolution();
+  const float refresh = gfx.GetResInfo(current).fRefreshRate;
+  if (nativeDV)
+  {
+    RESOLUTION res = current;
+    FindDVTransportResolution(refresh, false, res);
+    return res;
+  }
+  // The GUI mode, as CGraphicContext::SetFullScreenVideo() restores it when playback stops. Kodi
+  // stays in the full-screen video window between the items of a playlist, so a 3840x2160 mode
+  // chosen for an earlier native stream in place of the GUI mode would stay; nothing else
+  // changes the mode without the adjustment, and only that change is undone.
+  RESOLUTION gui = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    gui = CDisplaySettings::GetInstance().GetCurrentResolution();
+  if (current != gui && IsDVTransportResolution(current) && !IsDVTransportResolution(gui) &&
+      MathUtils::FloatEquals(gfx.GetResInfo(gui).fRefreshRate, refresh, 0.01f))
+  {
+    CLog::Log(LOGINFO, "[DV] {} again for a stream without native Dolby Vision",
+              gfx.GetResInfo(gui).strMode);
+    return gui;
+  }
+  return current;
+}
+#endif
