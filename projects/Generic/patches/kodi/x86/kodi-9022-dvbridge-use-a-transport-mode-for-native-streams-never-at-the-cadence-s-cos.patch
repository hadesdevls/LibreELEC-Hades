-            !(info.dwFlags & D3DPRESENTFLAG_INTERLACED) &&
-            MathUtils::FloatEquals(info.fRefreshRate, fps, 0.01f);
-        if (nativeDVRate || (info.fRefreshRate > 30) ||
-            (MathUtils::FloatEquals(info.fRefreshRate, 24.0f, 0.1f)))
