From b5668517bd67d19e562bf315ece0f4654f94bd37 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 23 Oct 2026 08:39:45 +0100
Subject: [PATCH] [RetroPlayer] Clamp GLES shader textures to the border when
 asked

A shader pass or LUT that wants clamp to border, the default for preset
passes, got clamp to edge on GLES. Passes that sample past the picture,
like CRT Royale's blurs and the NTSC decoders, then smeared the edge
pixels inward instead of reading black, so the picture edges differed
from desktop GL.

GLES 3.2 has border clamping, and earlier versions have it through
GL_EXT_texture_border_clamp or GL_OES_texture_border_clamp, so use it
where it's available.

(cherry picked from commit 75fb3f1e456fe26bd4eb7a2409e8b6b4494f383d)
---
 .../shaders/gles/ShaderUtilsGLES.cpp          | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
index a664283..7563b84 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
@@ -15,6 +15,24 @@
 
 using namespace KODI::SHADER;
 
+namespace
+{
+bool SupportsBorderClamp()
+{
+  const CRenderSystemBase* renderSystem = CServiceBroker::GetRenderSystem();
+  if (renderSystem == nullptr)
+    return false;
+
+  unsigned int major{0};
+  unsigned int minor{0};
+  renderSystem->GetRenderVersion(major, minor);
+
+  return major > 3 || (major == 3 && minor >= 2) ||
+         renderSystem->IsExtSupported("GL_EXT_texture_border_clamp") ||
+         renderSystem->IsExtSupported("GL_OES_texture_border_clamp");
+}
+} // namespace
+
 GLint CShaderUtilsGLES::TranslateWrapType(WrapType wrapType)
 {
   GLint glWrap;
@@ -32,7 +50,11 @@ GLint CShaderUtilsGLES::TranslateWrapType(WrapType wrapType)
       break;
     case WrapType::BORDER:
     default:
+#if defined(GL_CLAMP_TO_BORDER_EXT)
+      glWrap = SupportsBorderClamp() ? GL_CLAMP_TO_BORDER_EXT : GL_CLAMP_TO_EDGE;
+#else
       glWrap = GL_CLAMP_TO_EDGE;
+#endif
       break;
   }
 
