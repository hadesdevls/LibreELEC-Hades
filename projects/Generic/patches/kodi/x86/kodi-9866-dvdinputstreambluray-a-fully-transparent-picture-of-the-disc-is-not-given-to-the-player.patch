From 54d81c4372770f83bd9ff483e4c1cf61549a2269 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:48:49 +0000
Subject: [PATCH] DVDInputStreamBluray: a fully transparent picture of the disc
 is not given to the player

A BD-J disc keeps its graphics plane open, and fully transparent, through the film. Each flush of
its planes gave the player that picture, an ARGB image of 1920x1080 whose every pixel has alpha 0,
and it was drawn over every frame for as long as the film played: over HDR10 or HLG as an element of
the GUI (the GUI's FBO cleared and composited over the window each frame) or, now that the graphics
of an HDR playlist are HDR overlays, straight onto the picture; and with native Dolby Vision output a
frame with something over it is composed, never kept.

An image that draws nothing (no palette and no pixel with alpha: ImageShows(), the test of
PlaneShows() for one image) now stays in its plane, for what the disc draws over it next, and is not
given to the player. What reaches the screen is the same: a fully transparent picture changes no
byte, drawn either way. Whether the disc is in its menu, the menu state and the background plane
are decided on the planes, as before.

Test (outside the tree): menu_frame, on llvmpipe and zink with Kodi's composite shader of the tree,
full and limited range: a fully transparent plane drawn through the GUI or straight onto the picture
leaves the bytes of the picture alone.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 38 +++++++++++++------
 .../DVDInputStreams/DVDInputStreamBluray.h    |  2 +
 2 files changed, 28 insertions(+), 12 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 4228396..7066365 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1454,22 +1454,29 @@ void CDVDInputStreamBluray::OverlayClear(SPlane& plane, int x, int y, int w, int
 #endif
 }
 
+bool CDVDInputStreamBluray::ImageShows(const CDVDOverlayImage& image)
+{
+  if (!image.palette.empty())
+    return true;
+  // ARGB as libbluray gives it: one 32-bit word for each pixel, alpha in its top byte
+  const size_t count = image.pixels.size() / 4;
+  for (size_t i = 0; i < count; ++i)
+  {
+    uint32_t pixel;
+    memcpy(&pixel, image.pixels.data() + i * 4, sizeof(pixel));
+    if (pixel >> 24)
+      return true;
+  }
+  return false;
+}
+
 bool CDVDInputStreamBluray::PlaneShows(const SPlane& plane)
 {
 #if(BD_OVERLAY_INTERFACE_VERSION >= 2)
   for (const SOverlay& o : plane.o)
   {
-    if (!o->palette.empty())
+    if (ImageShows(*o))
       return true;
-    // ARGB as libbluray gives it: one 32-bit word for each pixel, alpha in its top byte
-    const size_t count = o->pixels.size() / 4;
-    for (size_t i = 0; i < count; ++i)
-    {
-      uint32_t pixel;
-      memcpy(&pixel, o->pixels.data() + i * 4, sizeof(pixel));
-      if (pixel >> 24)
-        return true;
-    }
   }
 #endif
   return false;
@@ -1486,13 +1493,20 @@ void CDVDInputStreamBluray::OverlayFlush(int64_t pts)
   group->SetOverlayContainerFlushable(false);
 
   std::unique_lock lock(m_overlayLock);
-  // Hades: back to front - the HAVi background (2), when shown, then PG (0), then IG (1)
+  // Hades: back to front - the HAVi background (2), when shown, then PG (0), then IG (1). An
+  // image that is fully transparent draws nothing and is not given to the player: a BD-J disc
+  // keeps its plane open, and fully transparent, through the film, and it was drawn over every
+  // frame of it (the GUI composite over HDR, the picture of native Dolby Vision drawn over). The
+  // planes keep it, for what is drawn over it next.
   for (const int planeIdx : {2, 0, 1})
   {
     if (planeIdx == 2 && !m_bgVisible)
       continue;
     for (const SOverlay& o : m_planes[planeIdx].o)
-      group->m_overlays.push_back(o);
+    {
+      if (ImageShows(*o))
+        group->m_overlays.push_back(o);
+    }
   }
 
   m_player->OnDiscNavResult(static_cast<void*>(&group), BD_EVENT_MENU_OVERLAY);
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index a0d5b0a..f0c8d6e 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -346,6 +346,8 @@ protected:
   //! Hades: whether a plane shows anything: an image with a palette (HDMV) always, an ARGB one
   //! (BD-J) only with a pixel that is not fully transparent
   static bool PlaneShows(const SPlane& plane);
+  //! Hades: whether an image draws anything (PlaneShows(), for one image)
+  static bool ImageShows(const CDVDOverlayImage& image);
   //! Hades: (player thread) the range of the disc's graphics (BlurayGraphicsRange.h) from the video
   //! of the play item being played, else of the playlist's first one; kept as it was without either
   void UpdateGraphicsRange();
