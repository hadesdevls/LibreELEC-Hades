+// Hades: the EDID of a connector read with drmModeGetConnector() (the value of its EDID property
+// is the blob of it); empty where it has none
+std::vector<uint8_t> EdidOfProbed(int fd, const drmModeConnector& probed, uint32_t edidProperty)
+{
+  uint64_t blob = 0;
+  for (int i = 0; edidProperty && i < probed.count_props; ++i)
+  {
+    if (probed.props[i] == edidProperty)
+      blob = probed.prop_values[i];
+  }
+  std::vector<uint8_t> edid;
+  if (!blob)
+    return edid;
+  if (drmModePropertyBlobPtr data = drmModeGetPropertyBlob(fd, static_cast<uint32_t>(blob)))
+  {
+    const auto* bytes = static_cast<const uint8_t*>(data->data);
+    edid.assign(bytes, bytes + data->length);
+    drmModeFreePropertyBlob(data);
+  }
+  return edid;
+}
+
+// Hades: a resolution as the log and the notifications name it ("3840x2160 @ 59.94 Hz")
+std::string ModeText(const RESOLUTION_INFO& res)
+{
+  return StringUtils::Format("{}x{}{} @ {:.2f} Hz", res.iScreenWidth, res.iScreenHeight,
+                             res.dwFlags & D3DPRESENTFLAG_INTERLACED ? "i" : "", res.fRefreshRate);
+}
+
+// Hades: the look at the modes is made by the application thread, between two frames (it may set
+// a mode): posted, never waited for. The window system is the one of then (none where Kodi has
+// ended it).
+void PostModesLook()
+{
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  if (!messenger)
+    return;
+  struct Call
+  {
+    KODI::MESSAGING::ThreadMessageCallback message;
+  };
+  auto* call = new Call{};
+  call->message.userptr = call;
+  call->message.callback = [](void* data)
+  {
+    std::unique_ptr<Call> owned(static_cast<Call*>(data));
+    if (auto* gbm = dynamic_cast<CWinSystemGbm*>(CServiceBroker::GetWinSystem()))
+      gbm->RefreshModes();
+  };
+  messenger->PostMsg(TMSG_CALLBACK, -1, -1, &call->message);
+}
