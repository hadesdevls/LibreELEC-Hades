+const char* CWinSystemGbm::ModesInTheWay()
+{
+  MODELIST::Busy busy;
+  busy.stopping = g_application.IsStopping();
+  const auto gui = CServiceBroker::GetGUI();
+  busy.noInterface = !gui || !gui->GetSkinInfo();
+  const auto& components = CServiceBroker::GetAppComponents();
+  const auto player = components.GetComponent<CApplicationPlayer>();
+  busy.playing = player && player->IsPlaying();
+  // (no video plane, no HDR signalling, no HDR10+, no change of mode held for a video, nothing of
+  // native Dolby Vision, no composition over HDR, no output that a flip which did not come turned
+  // off: what a move to another output waits for too)
+  busy.output = OutputMoveBlocked();
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  busy.modeChange = (drm && drm->ModesetPending()) || m_dispReset;
+  if (gui)
+  {
+    CGUIWindowManager& windows = gui->GetWindowManager();
+    // (the question to keep a resolution, and the list of the resolutions in the settings, are
+    // dialogs: what they show is of the list of before)
+    busy.dialog = windows.HasModalDialog(true);
+    busy.calibrating = windows.IsWindowActive(WINDOW_SCREEN_CALIBRATION);
+    busy.slideshow = windows.IsWindowActive(WINDOW_SLIDESHOW);
+  }
+  busy.calibrating = busy.calibrating || GetGfxContext().IsCalibrating();
+  busy.stereo = GetGfxContext().GetStereoMode() != RenderStereoMode::OFF;
+  const auto power = components.GetComponent<CApplicationPowerHandling>();
+  busy.dark = power && !power->GetRenderGUI();
+  return MODELIST::InTheWay(busy);
+}
+
+void CWinSystemGbm::LookAtModes()
+{
+  // Nothing at all while no hot-plug event of the device in use came since the last look: two
+  // counts compared, for each frame
+  if (!m_displayWatch)
+    return;
+  const unsigned int hotplugs = m_displayWatch->Hotplugs();
+  if (hotplugs == m_modesHotplugs)
+    return;
+  // (an output that is not set by atomic modesetting is not looked at: its events are let go)
+  if (!std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+  {
+    m_modesHotplugs = hotplugs;
+    return;
+  }
+
+  // (asked once a second at most while one is due; a look that was posted is waited for)
+  const auto now = std::chrono::steady_clock::now();
+  if (now < m_modesNext || (m_modesQueued && now - m_modesQueuedAt < std::chrono::seconds(10)))
+    return;
+  m_modesNext = now + std::chrono::seconds(1);
+
+  const char* inTheWay = ModesInTheWay();
+  if (MODELIST::WhenToLook(true, m_displayWatch->SinceHotplugMs(), m_displayWatch->SinceVideoMs(),
+                           inTheWay) != MODELIST::When::NOW)
+  {
+    if (inTheWay && m_modesWaitTold != inTheWay)
+    {
+      m_modesWaitTold = inTheWay;
+      CLog::Log(LOGDEBUG,
+                "Modes: a hot-plug event of the device came: the display is looked at for its "
+                "modes once nothing is in the way ({})",
+                inTheWay);
+    }
+    return;
+  }
+  m_modesWaitTold.clear();
+  m_modesQueued = true;
+  m_modesQueuedAt = now;
+  PostModesLook();
+}
+
+void CWinSystemGbm::RefreshModes()
+{
+  m_modesQueued = false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!m_displayWatch || !connector)
+    return;
+  const unsigned int hotplugs = m_displayWatch->Hotplugs();
+  // (what came between the post and now is looked at again by a later frame)
+  if (hotplugs == m_modesHotplugs || ModesInTheWay())
+    return;
+  m_modesHotplugs = hotplugs;
+
+  const std::string output = connector->GetName();
+  // The display probed, as when a video starts after such an event (CDisplayLook): nvidia-drm and
+  // i915 read its state and its EDID again, amdgpu reports what its hot-plug handling found
+  drmModeConnector* probed =
+      drmModeGetConnector(drm->GetFileDescriptor(), *connector->GetConnectorId());
+  if (!probed)
+  {
+    CLog::Log(LOGWARNING,
+              "Modes: {} could not be read after a hot-plug event: the resolutions stay", output);
+    return;
+  }
+  const std::vector<uint8_t> edid =
+      EdidOfProbed(drm->GetFileDescriptor(), *probed, connector->GetPropertyId("EDID"));
+  const std::vector<drmModeModeInfo> now(probed->modes, probed->modes + probed->count_modes);
+  const bool connected = probed->connection == DRM_MODE_CONNECTED;
+  const std::vector<drmModeModeInfo> before = drm->GetConnectorModes();
+  // (the bytes are compared: the kernel can give a new EDID the id of an earlier one)
+  const bool sameEdid = !edid.empty() && edid == m_modesEdid;
+  const MODELIST::Found found =
+      MODELIST::Of(connected, !edid.empty(), sameEdid,
+                   connected && !edid.empty() && !sameEdid && MODELIST::SameList(before, now));
+  if (found != MODELIST::Found::OTHER_MODES)
+  {
+    drmModeFreeConnector(probed);
+    switch (found)
+    {
+      // (a TV that is turned off or wakes up: debug only, as for the same EDID. Where nothing
+      // changes in a session, nothing is written)
+      case MODELIST::Found::NOT_CONNECTED:
+        CLog::Log(LOGDEBUG,
+                  "Modes: after a hot-plug event nothing is connected to {}: the resolutions stay",
+                  output);
+        break;
+      case MODELIST::Found::NO_EDID:
+        CLog::Log(LOGDEBUG,
+                  "Modes: after a hot-plug event the display of {} has no EDID that can be read "
+                  "(it may be waking up): the resolutions stay",
+                  output);
+        break;
+      case MODELIST::Found::SAME_EDID:
+        CLog::Log(LOGDEBUG,
+                  "Modes: after a hot-plug event the display of {} has the EDID that the "
+                  "resolutions were made with: nothing is done",
+                  output);
+        break;
+      default:
+        m_modesEdid = edid;
+        CLog::Log(LOGINFO,
+                  "Modes: the display of {} has another EDID, with the {} modes that the "
+                  "resolutions were made of: nothing is done",
+                  output, now.size());
+        break;
+    }
+    return;
+  }
+
+  // Each mode that Kodi holds is found in the new list by its timing (ModeListRefresh.h)
+  CDisplaySettings& display = CDisplaySettings::GetInstance();
+  const auto modeOf = [&before](const RESOLUTION_INFO& res) -> const drmModeModeInfo*
+  {
+    if (res.strId.empty())
+      return nullptr;
+    const int place = std::atoi(res.strId.c_str());
+    return place >= 0 && place < static_cast<int>(before.size()) ? &before[place] : nullptr;
+  };
+  const RESOLUTION gfxBefore = GetGfxContext().GetVideoResolution();
+  const RESOLUTION currentBefore = display.GetCurrentResolution();
+  const RESOLUTION_INFO desktopInfo = display.GetResolutionInfo(RES_DESKTOP);
+  const RESOLUTION_INFO currentInfo = display.GetResolutionInfo(currentBefore);
+  const RESOLUTION_INFO screenInfo = GetGfxContext().GetResInfo();
+  const MODELIST::Plan plan = MODELIST::MakePlan(before, now, drm->GetSelectedMode(),
+                                                 modeOf(desktopInfo), modeOf(currentInfo));
+  if (plan.kind == MODELIST::Plan::Kind::SAME)
+  {
+    drmModeFreeConnector(probed);
+    m_modesEdid = edid;
+    return;
+  }
+  if (plan.kind == MODELIST::Plan::Kind::REFUSE)
+  {
+    drmModeFreeConnector(probed);
+    CLog::Log(LOGWARNING,
+              "Modes: the display of {} has other modes ({} -> {}), which cannot be matched to "
+              "those Kodi holds ({}): the resolutions stay, and a restart takes them{}",
+              output, before.size(), now.size(), plan.why,
+              m_modesRefusedEdid != edid ? "; the user is told" : "");
+    if (m_modesRefusedEdid != edid)
+    {
+      m_modesRefusedEdid = edid;
+      CGUIDialogKaiToast::QueueNotification(
+          CGUIDialogKaiToast::Warning,
+          CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220),
+          CGUIUtils::GetHadesString(39957, 31977), 10000);
+    }
+    return;
+  }
+
+  // The resolutions are made again of the new list, with the desktop resolution that the plan
+  // found (its own mode, else the one the display prefers, as at a start)
+  drm->TakeConnectorModes(probed, plan.screen);
+  m_modesEdid = edid;
+  m_modesRefusedEdid.clear();
+  MakeResolutions(plan.desktop);
+
+  const auto resOf = [&display](int place)
+  {
+    const std::string id = std::to_string(place);
+    for (size_t i = RES_CUSTOM; i < display.ResolutionInfoSize(); ++i)
+    {
+      if (display.GetResolutionInfo(i).strId == id)
+        return static_cast<int>(i);
+    }
+    return -1;
+  };
+  // The current resolution: its mode, else the one a start takes (the settings, or the nearest:
+  // CApplication::CreateGUI())
+  int current =
+      MODELIST::ResolutionFor(plan.current, currentBefore == RES_DESKTOP, plan, RES_DESKTOP, resOf);
+  const bool currentKept = current >= 0;
+  if (!currentKept)
+  {
+    current = display.GetDisplayResolution();
+    if (current < RES_DESKTOP ||
+        !GetGfxContext().IsValidResolution(static_cast<RESOLUTION>(current)))
+      current = RES_DESKTOP;
+  }
+  display.SetCurrentResolution(static_cast<RESOLUTION>(current), false);
+  const RESOLUTION_INFO desktopNow = display.GetResolutionInfo(RES_DESKTOP);
+  const RESOLUTION_INFO currentNow = display.GetResolutionInfo(static_cast<RESOLUTION>(current));
+
+  int gfx = plan.kind == MODELIST::Plan::Kind::RENUMBER
+                ? MODELIST::ResolutionFor(plan.screen, gfxBefore == RES_DESKTOP, plan, RES_DESKTOP,
+                                          resOf)
+                : -1;
+  if (gfx >= 0)
+  {
+    // The mode on the screen is offered: nothing changes on the screen; its resolution has another
+    // place now, which Kodi takes as it takes a mode that the system set (ApplyModeChange(): the
+    // state of the graphics context, and the interface told of its size, without a mode set)
+    if (gfx != gfxBefore)
+      GetGfxContext().ApplyModeChange(static_cast<RESOLUTION>(gfx));
+    CLog::Log(LOGINFO,
+              "Modes: the display of {} has other modes ({} -> {}): the resolutions are made again "
+              "of them. The interface stays in {} (resolution {} -> {}); the desktop resolution is "
+              "{} ({}), the current one {} ({})",
+              output, before.size(), now.size(), ModeText(screenInfo), gfxBefore, gfx,
+              ModeText(desktopNow), plan.desktopKept ? "its mode" : "the one the display prefers",
+              ModeText(currentNow), currentKept ? "its mode" : "as a start takes it");
+    CGUIDialogKaiToast::QueueNotification(
+        CGUIDialogKaiToast::Info,
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220),
+        CGUIUtils::GetHadesString(39955, 31975));
+    return;
+  }
+
+  // The mode on the screen is not offered: the interface is set in the current resolution, as Kodi
+  // sets it for its interface (what the display shows now is no mode of it)
+  CLog::Log(LOGINFO,
+            "Modes: the display of {} has other modes ({} -> {}): the resolutions are made again "
+            "of them. The mode on the screen ({}) is not one of them: the interface is set in {}, "
+            "the current resolution ({}); the desktop resolution is {} ({})",
+            output, before.size(), now.size(), ModeText(screenInfo), ModeText(currentNow),
+            currentKept ? "its mode" : "as a start takes it", ModeText(desktopNow),
+            plan.desktopKept ? "its mode" : "the one the display prefers");
+  GetGfxContext().SetVideoResolution(static_cast<RESOLUTION>(current), true);
+  if (drm->LastCommitRefused())
+  {
+    CLog::Log(LOGWARNING, "Modes: the driver refused {}: a restart takes the display's new modes; "
+                          "the user is told",
+              ModeText(currentNow));
+    CGUIDialogKaiToast::QueueNotification(
+        CGUIDialogKaiToast::Warning,
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220),
+        CGUIUtils::GetHadesString(39957, 31977), 10000);
+    return;
+  }
+  std::string text = CGUIUtils::GetHadesString(39956, 31976);
+  StringUtils::Replace(text, "{0}", ModeText(currentNow));
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Info,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(14220), text);
+}
