+std::vector<drmModeModeInfo> CDRMUtils::GetConnectorModes() const
+{
+  std::vector<drmModeModeInfo> modes;
+  if (!m_connector)
+    return modes;
+
+  modes.reserve(m_connector->GetModesCount());
+  for (int i = 0; i < m_connector->GetModesCount(); i++)
+    modes.push_back(*m_connector->GetModeForIndex(i));
+  return modes;
+}
+
+void CDRMUtils::TakeConnectorModes(drmModeConnector* probed, int screenPlace)
+{
+  if (!m_connector)
+  {
+    drmModeFreeConnector(probed);
+    return;
+  }
+
+  m_connector->Adopt(probed);
+  if (screenPlace >= 0 && screenPlace < m_connector->GetModesCount())
+    m_mode = m_connector->GetModeForIndex(screenPlace);
+}
