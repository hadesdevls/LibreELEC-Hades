From abe28b551caeb9c47547283aff1d202f703aadec Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:43:24 +0000
Subject: [PATCH] windowing/gbm: the Dolby Vision frames without a pass 7 mask
 draw their composite under scissor rectangles too

The converted transport (the composer's YCbCr, where the fidelity step-down sends
GPUs that cannot keep up) has no pass 7: the packer of the source transport makes
the tile mask, and that transport is not used there. Its frames drew the whole
3840x2160 quad in every frame whose GUI pass was left out. They now take the mask
of the GUI texture (dvbridge_guimask, once for a content of the GUI, read back
asynchronously, the first frame whose pass is left out asks for it), where the
frame has no pass 7 mask to ask for (CWinSystemGbmGLESContext::m_packerTried);
the source transport keeps its pass 7 mask.

The composite of the Dolby Vision frames draws the texture upside down (its last
row on the first row of the window, proj[5] and proj[13] turned over in
CompositeGui()), so the rows of the tile mask are turned over before the
rectangles are made. That is whole tiles only where the window's height is a
multiple of 16 (2160 is; the Dolby Vision output is 3840x2160 only): otherwise
the mask is not used and the whole quad is drawn. A mask is used by the composite
it was made for (TILES_PACKER and TILES_GUI_DV by the Dolby Vision composite,
TILES_GUI_HDR by the HDR composite); the argument for the bytes, the generation
tag and every fallback are those of the previous commits. The 10 s line counts
the composites under rectangles as before.

Host proof (outside the tree): perf_bridge with DV_SCISSOR_HDR and DV_SCISSOR_FLIP:
the projection of the Dolby Vision frames (rows turned over) and their blend, Kodi's
own gles_gui_composite shaders, the mask of the GUI texture with its rows turned
over, 3840x2160, 2560x1440 and 1366x768 (1920x1080 is not whole tiles: not used,
which the test says), llvmpipe and zink over lavapipe: 0 pixels differ in all six
runs; with each rectangle one tile short, 2 or 3 differ in every run that makes a mask.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 55 ++++++++++++++-----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 18 ++++--
 2 files changed, 55 insertions(+), 18 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6a3cab3..fa2089f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2267,10 +2267,12 @@ void CWinSystemGbmGLESContext::CompositeGui()
   // this frame composites (the GUI pass was left out, and the mask is that of its content): the
   // fragments inside the rectangles are those of the whole quad, and outside them the whole quad
   // discards (dvbridge_tiles.h). Any doubt (no mask yet, another GUI): the whole quad.
-  if (!dvComposite && m_guiCompositing)
-    HdrTilesUpdate();
-  if (m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && m_tilesNative == dvComposite &&
-      !m_tilesRects.empty() && glIsEnabled(GL_SCISSOR_TEST) == GL_FALSE)
+  if (m_guiCompositing)
+    HdrTilesUpdate(dvComposite);
+  const bool maskFits = dvComposite ? (m_tilesKind == TILES_PACKER || m_tilesKind == TILES_GUI_DV)
+                                    : m_tilesKind == TILES_GUI_HDR;
+  if (m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && maskFits && !m_tilesRects.empty() &&
+      glIsEnabled(GL_SCISSOR_TEST) == GL_FALSE)
   {
     constexpr int TILE = DVBRIDGE_SOURCE_TILE;
     GLint box[4]{};
@@ -6207,7 +6209,7 @@ constexpr int64_t DV_MENUS_SETTLE_MS = 3000;
 constexpr auto DV_MENUS_AFTER_WAKE = std::chrono::seconds(5);
 } // namespace
 
-void CWinSystemGbmGLESContext::HdrTilesUpdate()
+void CWinSystemGbmGLESContext::HdrTilesUpdate(bool dolbyVision)
 {
   // (GLES 3: the mask maker reads the GUI texture with texelFetch and the result back with a fence)
   if (m_renderableType != EGL_OPENGL_ES3_BIT)
@@ -6223,10 +6225,23 @@ void CWinSystemGbmGLESContext::HdrTilesUpdate()
     // (a mask is the one of a GUI that has not been drawn since it was asked for)
     if (polled == 1 && serial == m_guiGen)
     {
-      m_tilesNative = false;
+      m_tilesKind = m_hdrMaskDv ? TILES_GUI_DV : TILES_GUI_HDR;
+      // (the composite of the Dolby Vision frames draws the texture's last row on the window's
+      // first and its first on the last: the rows of the tiles are turned over, which needs the
+      // rows to be whole tiles of the window)
+      bool usable = true;
+      if (m_hdrMaskDv)
+      {
+        usable = rows * DVBRIDGE_SOURCE_TILE == static_cast<unsigned int>(m_guiFboHeight);
+        for (unsigned int y = 0; usable && y < rows / 2; ++y)
+          std::swap_ranges(m_hdrTiles.begin() + static_cast<size_t>(y) * columns,
+                           m_hdrTiles.begin() + static_cast<size_t>(y + 1) * columns,
+                           m_hdrTiles.begin() + static_cast<size_t>(rows - 1 - y) * columns);
+      }
       m_tilesRects.assign(DVBRIDGE_TILE_RECTS_MAX, dvbridge_tile_rect{});
-      const int n = dvbridge_tiles_merge(m_hdrTiles.data(), columns, rows, m_tilesRects.data(),
-                                         DVBRIDGE_TILE_RECTS_MAX, 50);
+      const int n = usable ? dvbridge_tiles_merge(m_hdrTiles.data(), columns, rows,
+                                                  m_tilesRects.data(), DVBRIDGE_TILE_RECTS_MAX, 50)
+                           : -1;
       m_tilesRects.resize(n > 0 ? static_cast<size_t>(n) : 0);
       m_tilesUse = n > 0;
       m_tilesGen = serial;
@@ -6236,8 +6251,13 @@ void CWinSystemGbmGLESContext::HdrTilesUpdate()
   // changes in every frame never pays for it
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
-  if (!m_guiReusing || m_hdrMaskPending || (m_tilesGen == m_guiGen && !m_tilesNative) ||
-      !advanced || !advanced->m_videoDVGuiScissor || !m_guiFbo.IsValid())
+  // (the Dolby Vision composite has the mask of the packer's pass 7 where the frame has one)
+  const bool have =
+      m_tilesGen == m_guiGen &&
+      (dolbyVision ? (m_tilesKind == TILES_PACKER || m_tilesKind == TILES_GUI_DV)
+                   : m_tilesKind == TILES_GUI_HDR);
+  if (!m_guiReusing || m_hdrMaskPending || have || (dolbyVision && m_packerTried) || !advanced ||
+      !advanced->m_videoDVGuiScissor || !m_guiFbo.IsValid())
     return;
   if (!m_guiMask)
   {
@@ -6247,14 +6267,17 @@ void CWinSystemGbmGLESContext::HdrTilesUpdate()
       CLog::Log(LOGINFO, "HDR GUI: the tile mask of the GUI could not be made on this GPU: the "
                          "composite is drawn over the whole screen (video/dvguiscissor)");
       m_tilesGen = m_guiGen; // (not asked for again for this content)
-      m_tilesNative = false;
+      m_tilesKind = dolbyVision ? TILES_GUI_DV : TILES_GUI_HDR;
       m_tilesUse = false;
       return;
     }
   }
   if (dvbridge_guimask_request(m_guiMask, m_guiFbo.Texture(), m_guiFboWidth, m_guiFboHeight,
                                m_guiGen))
+  {
     m_hdrMaskPending = true;
+    m_hdrMaskDv = dolbyVision;
+  }
 }
 
 void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
@@ -6272,7 +6295,7 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
     // nothing of this one)
     if (polled == 1 && serial == m_guiGen)
     {
-      m_tilesNative = true;
+      m_tilesKind = TILES_PACKER;
       m_tilesRects.assign(DVBRIDGE_TILE_RECTS_MAX, dvbridge_tile_rect{});
       // (more than 24 rectangles, or marked tiles over half of them: the whole quad, as before)
       const int n = dvbridge_tiles_merge(mask, DVBRIDGE_SOURCE_TILE_COLUMNS,
@@ -6283,9 +6306,13 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
       m_tilesGen = serial;
     }
   }
-  if (wanted && !m_tilesPending && (m_tilesGen != m_guiGen || !m_tilesNative) &&
-      m_dvBridge->RequestDrawnTiles(m_guiGen))
+  const bool have =
+      m_tilesGen == m_guiGen && (m_tilesKind == TILES_PACKER || m_tilesKind == TILES_GUI_DV);
+  if (wanted && !m_tilesPending && !have && m_dvBridge->RequestDrawnTiles(m_guiGen))
     m_tilesPending = true;
+  // (a frame without a pass 7 mask to ask for, the converted transport: the mask of the GUI texture
+  // is made for it, HdrTilesUpdate())
+  m_packerTried = wanted && (m_tilesPending || have);
 }
 
 CDVGuiReuse::Facts CWinSystemGbmGLESContext::GuiReuseFacts() const
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 32eda23..640e90d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -474,9 +474,19 @@ private:
   unsigned m_tilesGen{0};
   bool m_tilesPending{false};
   bool m_tilesUse{false};
-  //! ... the mask of the packer's pass 7 (native Dolby Vision output), or of the GUI texture itself
-  //! (the HDR10/HLG composite: dvbridge_guimask.h), which only the path it was made for may use
-  bool m_tilesNative{true};
+  //! ... the mask of the packer's pass 7 (TILES_PACKER: native Dolby Vision output in the source
+  //! transport), or of the GUI texture itself (dvbridge_guimask.h): for the composite of the Dolby
+  //! Vision frames that have no pass 7 (the converted transport) with its rows turned over, as the
+  //! composite turns the texture over there (TILES_GUI_DV), or for the HDR10/HLG composite as it is
+  //! (TILES_GUI_HDR). Only the composite it was made for may use it.
+  static constexpr int TILES_PACKER = 1;
+  static constexpr int TILES_GUI_DV = 2;
+  static constexpr int TILES_GUI_HDR = 3;
+  int m_tilesKind{0};
+  //! ... this frame's pass 7 mask was asked for, or came (the GUI texture's is not made then)
+  bool m_packerTried{false};
+  //! ... the mask of the GUI texture that waits is for the Dolby Vision composite
+  bool m_hdrMaskDv{false};
   std::vector<dvbridge_tile_rect> m_tilesRects;
   void DVTilesUpdate(bool wanted);
   struct dvbridge_guimask* m_guiMask{nullptr};
@@ -484,7 +494,7 @@ private:
   std::vector<uint8_t> m_hdrTiles;
   //! Hades: the HDR composite: the mask of the GUI texture, once for each content of it that stays
   //! for a frame (HdrTilesUpdate(): asked for at the first frame whose GUI pass was left out)
-  void HdrTilesUpdate();
+  void HdrTilesUpdate(bool dolbyVision);
   std::chrono::steady_clock::time_point m_guiHdrLogAt{};
   CDVGuiReuse m_dvGuiReuse;
   CDVGuiReuse::Facts GuiReuseFacts() const;
-- 
2.53.0

