From 390677b7b78fc3b331ca28bf7834fc1ba3d47003 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 29 Sep 2026 07:35:27 +0000
Subject: [PATCH] gbm: allow a modeset for native Dolby Vision frames only when
 one is needed

Every transport frame was committed with DRM_MODE_ATOMIC_ALLOW_MODESET,
although only entering and leaving the transport change the output
(depth, dither, InfoFrames, the kernel tunnel property). i915 and
nvidia-drm ignore the flag when nothing needs a modeset, but amdgpu
before DCN 3.2 resets every plane of a commit that allows one
(should_reset_plane() in amdgpu_dm.c: "TODO: Remove this hack for all
asics once it proves that the fast updates works fine on DCN3.2+"),
which makes each frame a full update. On a Ryzen 7000 iGPU (DCN 3.1.5)
at 2160p23.976 every Dolby Vision frame took two refresh periods to
present (83 ms instead of 41.7 ms, about 117 frames in 10 s instead of
240), and the film played at half speed, while the GPU work took 15 to
31 ms per frame.

Allow the modeset for the first transport frame after the output state
is captured, for the restoring commit, and whenever Kodi has one pending
(a mode switch); the frames in between change only the framebuffer.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp    |  8 +++++++-
 xbmc/windowing/gbm/drm/DRMAtomic.cpp   |  6 ++++--
 xbmc/windowing/gbm/drm/DRMAtomic.h     |  6 ++++--
 xbmc/windowing/gbm/drm/DVBridgeState.h | 12 +++++++++++-
 4 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0d6e9cc..230d15e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -667,13 +667,19 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore)
   }
   if (valid)
     valid = state.Stage(*drm, restore);
-  const bool accepted = drm->FlipPageTransactional(valid ? bo : nullptr);
+  // Entering and leaving the transport change the output (depth, dither, InfoFrames) and need a
+  // modeset; the transport frames in between change only the framebuffer. A modeset still
+  // pending in Kodi (m_need_modeset) is allowed by FlipPageTransactional() itself.
+  const bool modeset = restore || !state.TransportLive();
+  const bool accepted = drm->FlipPageTransactional(valid ? bo : nullptr, modeset);
   surface.CompleteTransactionalBuffer(accepted);
   if (accepted && restore)
   {
     surface.EndTransactionalMode();
     state.Restored();
   }
+  else if (accepted)
+    state.SetTransportLive();
   return accepted;
 }
 #endif
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index e353738..6ecaa7c 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -284,7 +284,7 @@ void CDRMAtomic::FinishRequest(bool accepted)
   m_propertyFailure = false;
 }
 
-bool CDRMAtomic::FlipPageTransactional(struct gbm_bo* bo)
+bool CDRMAtomic::FlipPageTransactional(struct gbm_bo* bo, bool modeset)
 {
   if (!bo)
   {
@@ -300,7 +300,9 @@ bool CDRMAtomic::FlipPageTransactional(struct gbm_bo* bo)
     FinishRequest(false);
     return false;
   }
-  const int flags = DRM_MODE_ATOMIC_ALLOW_MODESET;
+  // amdgpu before DCN 3.2 resets every plane of a commit that allows a modeset
+  // (should_reset_plane()), a full update that takes a second refresh period.
+  const int flags = modeset || m_need_modeset ? DRM_MODE_ATOMIC_ALLOW_MODESET : 0;
   const bool accepted = DrmAtomicCommit(fb, flags, true, false, true);
   if (accepted)
     m_need_modeset = false;
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 4d30639..b7ee26b 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -38,8 +38,10 @@ public:
   void DestroyDrm() override;
   bool SupportsFencing() override { return true; }
   bool AddProperty(CDRMObject* object, const char* name, uint64_t value);
-  // Blocking commit: rejected properties must not be paired with a new framebuffer.
-  bool FlipPageTransactional(struct gbm_bo* bo);
+  // Blocking commit: rejected properties must not be paired with a new framebuffer. modeset
+  // allows a modeset (also allowed when one is pending); leave it off for commits that change
+  // neither the mode nor anything else that needs one.
+  bool FlipPageTransactional(struct gbm_bo* bo, bool modeset);
 
   // Probe whether any DRM device supports atomic modesetting, with no
   // connector required. Used to decide atomic-vs-legacy before falling back.
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.h b/xbmc/windowing/gbm/drm/DVBridgeState.h
index 792cd15..93f8aa5 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.h
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.h
@@ -33,8 +33,17 @@ public:
 
   bool Capture(CDRMAtomic& drm);
   bool Stage(CDRMAtomic& drm, bool restore);
-  void Restored() { m_saved.clear(); m_owner = nullptr; }
+  void Restored()
+  {
+    m_saved.clear();
+    m_owner = nullptr;
+    m_transportLive = false;
+  }
   bool Captured() const { return !m_saved.empty(); }
+  //! The transport has been committed once since the capture: the output already has the
+  //! transport properties, so the next transport frames change only the framebuffer.
+  bool TransportLive() const { return m_transportLive; }
+  void SetTransportLive() { m_transportLive = true; }
 
 private:
   struct Property
@@ -48,5 +57,6 @@ private:
   };
   std::vector<Property> m_saved;
   CDRMAtomic* m_owner = nullptr;
+  bool m_transportLive = false;
 };
 }
-- 
2.53.0

