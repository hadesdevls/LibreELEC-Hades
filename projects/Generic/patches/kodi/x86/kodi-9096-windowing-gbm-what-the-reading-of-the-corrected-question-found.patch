+/*!
+ * \brief What came back from the question whether to move to a display
+ */
+enum class DRMAnswer
+{
+  NONE, //!< no answer to the question: nobody is taken to have said anything
+  STAY,
+  MOVE,
+  NOBODY, //!< the question was shown for all of its time and nobody answered
+};
+
+/*!
+ * \brief Reads what came back from the question
+ * \param closedOnce its dialog was closed once, and only once, since the question was put
+ * \param ownTexts the dialog showed the question when it closed (it is one dialog for all of
+ * Kodi, and another caller can write its own question over one that is open)
+ * \param tooSoon it closed sooner than a person answers
+ * \param yes the button that moves was pressed
+ * \param no the button that stays was pressed, or the user went back
+ * \param timedOut the dialog closed itself when its time ran out
+ *
+ * Only what the user did is an answer. A dialog that something else closed (what closes every
+ * dialog, a skin that is loaded again) was answered by nobody, and is not taken for "stay".
+ */
+inline DRMAnswer ReadAnswer(
+    bool closedOnce, bool ownTexts, bool tooSoon, bool yes, bool no, bool timedOut)
+{
+  if (!closedOnce || !ownTexts || tooSoon)
+    return DRMAnswer::NONE;
+  if (yes)
+    return DRMAnswer::MOVE;
+  if (no)
+    return DRMAnswer::STAY;
+  return timedOut ? DRMAnswer::NOBODY : DRMAnswer::NONE;
+}
+
+/*!
+ * \brief What is done when nobody answered the question
+ */
+enum class DRMUnasked
+{
+  MOVE, //!< Kodi is started again without anyone having said so
+  LATER, //!< not now: the display is offered again later
+  SPENT, //!< not any more: Kodi stays
+};
+
+/*!
+ * \param saidItWould the question said that Kodi would move by itself (it could, when it was
+ * put: nothing played, and Kodi may be started again unasked)
+ * \param mayStill Kodi may still be started again unasked for this output
+ * \param busy something plays, a dialog waits for the user, or Kodi does what it would not be
+ * turned off under (a library that is being updated, a recording), now
+ * \param late the question came back long after its time: it sat under another dialog, which
+ * the user was busy with
+ */
+inline DRMUnasked WhenNobodyAnswers(bool saidItWould, bool mayStill, bool busy, bool late)
+{
+  if (!mayStill)
+    return DRMUnasked::SPENT;
+  if (!saidItWould || busy || late)
+    return DRMUnasked::LATER;
+  return DRMUnasked::MOVE;
+}
+
+/*!
+ * \brief How long to wait before the outputs are looked at again after looks that failed
+ * \param failed how many have failed in a row (1 or more)
+ * \return seconds: 10, then twice as long each time, up to 300
+ */
+inline unsigned int LookAgainSeconds(unsigned int failed)
+{
+  const unsigned int doubled = failed > 0 ? failed - 1 : 0;
+  const unsigned int seconds = 10u << (doubled < 5 ? doubled : 5);
+  return seconds < 300 ? seconds : 300;
+}
