From 61491c6f4d56ca1719be7b85502f77d747c8e69c Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:04 +0000
Subject: [PATCH] Fix new/free mismatches

CodeQL cpp/new-free-mismatch: CWIID_WiiRemote allocates the sample
buffers with new[] but released them with free(), and the Neptune
NetPump sample app releases a malloc() buffer with delete[].

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/libUPnP/Neptune/Source/Apps/NetPump/NetPump.cpp      | 2 +-
 tools/EventClients/Clients/WiiRemote/CWIID_WiiRemote.cpp | 6 ++----
 2 files changed, 3 insertions(+), 5 deletions(-)

diff --git a/lib/libUPnP/Neptune/Source/Apps/NetPump/NetPump.cpp b/lib/libUPnP/Neptune/Source/Apps/NetPump/NetPump.cpp
index 7189062..239eacd 100644
--- a/lib/libUPnP/Neptune/Source/Apps/NetPump/NetPump.cpp
+++ b/lib/libUPnP/Neptune/Source/Apps/NetPump/NetPump.cpp
@@ -674,7 +674,7 @@ main(int argc, char** argv)
         exit(1);
     }
     
-    delete[] buffer;
+    free(buffer);
     return 0;
 }
 
diff --git a/tools/EventClients/Clients/WiiRemote/CWIID_WiiRemote.cpp b/tools/EventClients/Clients/WiiRemote/CWIID_WiiRemote.cpp
index 19ff811..067fbcd 100644
--- a/tools/EventClients/Clients/WiiRemote/CWIID_WiiRemote.cpp
+++ b/tools/EventClients/Clients/WiiRemote/CWIID_WiiRemote.cpp
@@ -144,10 +144,8 @@ CWiiRemote::~CWiiRemote()
   if (m_connected == true)
     this->DisconnectNow(false);
 
-  if (m_SamplesY != NULL)
-    free(m_SamplesY);
-  if (m_SamplesX != NULL)
-    free(m_SamplesX);
+  delete[] m_SamplesY;
+  delete[] m_SamplesX;
 
   if (m_JoyMap)
     free(m_JoyMap);
-- 
2.53.0

