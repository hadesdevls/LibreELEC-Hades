From 866b04fea870633c67d2e621aa82711b49edcac1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:56:03 +0000
Subject: [PATCH] guilib: a grouplist steps each wheel notch from where its
 scroll is heading

CGUIControlGroupList::OnMouseEvent() aimed a notch of the mouse wheel at
the next (or previous) control from the current, animated value of its
scroller. A notch that came while a scroll was running found the same
control as the one before and called ScrollTo() with the same end: the
notch was lost, and the scroll started again from where it was, so it
slowed down. A quick spin of the wheel over a settings pane (a
grouplist, as the add-on and skin settings are) moved fewer rows than it
had notches.

CScroller::GetDestination() says where a scroll in progress ends (the
value itself when there is none), and the notch steps from there: notches
add up, as they do in a list, which steps from its offset. The clamping
of ScrollTo() keeps the end inside the list, and the conditions that stop
a notch at either end read the same position.

Idea from the YBLOD fork, f946078f0a; rewritten.
---
 xbmc/guilib/GUIControlGroupList.cpp | 10 ++++++++--
 xbmc/guilib/VisibleEffect.h         |  7 +++++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/xbmc/guilib/GUIControlGroupList.cpp b/xbmc/guilib/GUIControlGroupList.cpp
index 256cee1..aca3bf0 100644
--- a/xbmc/guilib/GUIControlGroupList.cpp
+++ b/xbmc/guilib/GUIControlGroupList.cpp
@@ -607,18 +607,24 @@ EVENT_RESULT CGUIControlGroupList::OnMouseEvent(const CPoint& point,
   if (event.m_id == ACTION_MOUSE_WHEEL_UP || event.m_id == ACTION_MOUSE_WHEEL_DOWN)
   {
     // find the current control and move to the next or previous
+    // Hades: from where a scroll in progress is heading, not from where it is now: a notch that
+    // came during the scroll aimed at the control the scroll was going to, and started it again
+    // from where it was (lost, and the scroll slowed); now notches add up, as in a list
+    const float position = m_scroller.GetDestination();
     float offset = 0;
     for (ciControls it = m_children.begin(); it != m_children.end(); ++it)
     {
       CGUIControl *control = *it;
       if (!control->IsVisible()) continue;
       float nextOffset = offset + Size(control) + m_itemGap;
-      if (event.m_id == ACTION_MOUSE_WHEEL_DOWN && nextOffset > m_scroller.GetValue() && m_scroller.GetValue() < m_totalSize - Size()) // past our current offset
+      if (event.m_id == ACTION_MOUSE_WHEEL_DOWN && nextOffset > position &&
+          position < m_totalSize - Size()) // past our current offset
       {
         ScrollTo(nextOffset);
         return EVENT_RESULT_HANDLED;
       }
-      else if (event.m_id == ACTION_MOUSE_WHEEL_UP && nextOffset >= m_scroller.GetValue() && m_scroller.GetValue() > 0) // at least at our current offset
+      else if (event.m_id == ACTION_MOUSE_WHEEL_UP && nextOffset >= position &&
+               position > 0) // at least at our current offset
       {
         ScrollTo(offset);
         return EVENT_RESULT_HANDLED;
diff --git a/xbmc/guilib/VisibleEffect.h b/xbmc/guilib/VisibleEffect.h
index a5b19e2..cf60cf0 100644
--- a/xbmc/guilib/VisibleEffect.h
+++ b/xbmc/guilib/VisibleEffect.h
@@ -247,6 +247,13 @@ public:
    * Value of scroll
    */
   float GetValue() const { return m_scrollValue; }
+  /*!
+   * \brief Hades: where the scroll in progress ends (the value itself when there is none)
+   */
+  float GetDestination() const
+  {
+    return m_delta != 0 ? m_startPosition + m_delta : m_scrollValue;
+  }
   void SetValue(float scrollValue) { m_scrollValue = scrollValue; }
 
   bool IsScrolling() const { return m_delta != 0; }
