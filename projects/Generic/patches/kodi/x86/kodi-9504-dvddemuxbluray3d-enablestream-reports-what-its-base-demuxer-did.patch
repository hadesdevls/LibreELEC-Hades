From 754195b0aa8a66757a77e8f68507d227e73206c3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:58:33 +0000
Subject: [PATCH] DVDDemuxBluray3D: EnableStream() reports what its base
 demuxer did

Piers commit 022a068cff02 ("[VideoPlayer] Only mark a subtitle stream
demuxer-disabled if the demuxer honours it") makes
CDVDDemux::EnableStream() return whether the request reached an
implementation that can act on it, so that VideoPlayer only marks a
stream demuxer-disabled, and reopens it with a seek when it is shown
again, where the demuxer really stops delivering it.

The Blu-ray 3D demuxer of Hades wraps the demuxer of the disc and
forwards the call. It now returns what that demuxer reports, as
CDemuxMultiSource does, and false without one: a stream of a Blu-ray 3D
title is marked disabled exactly when the demuxer under it would have
been on its own.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp | 5 ++---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h   | 2 +-
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
index 749ea4b..7f3420c 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
@@ -958,10 +958,9 @@ std::string CDVDDemuxBluray3D::GetStreamCodecName(int iStreamId)
   return m_base ? m_base->GetStreamCodecName(iStreamId) : std::string{};
 }
 
-void CDVDDemuxBluray3D::EnableStream(int64_t demuxerId, int id, bool enable)
+bool CDVDDemuxBluray3D::EnableStream(int64_t demuxerId, int id, bool enable)
 {
-  if (m_base)
-    m_base->EnableStream(demuxerId, id, enable);
+  return m_base ? m_base->EnableStream(demuxerId, id, enable) : false;
 }
 
 void CDVDDemuxBluray3D::OpenStream(int64_t demuxerId, int id)
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
index eeec6aa..d767bde 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
@@ -72,7 +72,7 @@ public:
   void SetProgram(int progId) override;
   std::string GetFileName() override;
   std::string GetStreamCodecName(int64_t demuxerId, int iStreamId) override;
-  void EnableStream(int64_t demuxerId, int id, bool enable) override;
+  bool EnableStream(int64_t demuxerId, int id, bool enable) override;
   void OpenStream(int64_t demuxerId, int id) override;
   void SetVideoResolution(unsigned int width, unsigned int height) override;
 
