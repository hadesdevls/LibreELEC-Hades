From dfed09efa0b0daccc060b6af7d720a7244f8d489 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] GUIWindowSettingsCategory: keep the interface resolution
 while a video plays

When the display mode changes while the settings window is active, the
window saved the mode of the graphics context as the resolution of the
interface (videoscreen.screenmode). While a video plays that mode is
the one the player chose for the video (its frame rate, Dolby Vision):
with the settings window open over a playlist whose next video has
another rate, the video's mode became the resolution that Kodi returns
to when playback stops, and was kept for later sessions. CroqueMr found
the case in his build ("settings-to-playback").

While a video plays the resolution is no longer saved there (a
resolution the user chooses is saved by its own setting,
CDisplaySettings::OnSettingChanged(), and toggling full screen saves its
own in CGraphicContext::ToggleFullScreen()); the settings are made again
as before. kodi.log says it: "Settings: the display went to <mode> while
a video plays; that is the video's mode, and the resolution of the
interface stays <screenmode>". Outside playback nothing changes.
---
 .../windows/GUIWindowSettingsCategory.cpp     | 23 +++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/xbmc/settings/windows/GUIWindowSettingsCategory.cpp b/xbmc/settings/windows/GUIWindowSettingsCategory.cpp
index 657ad77..c541710 100644
--- a/xbmc/settings/windows/GUIWindowSettingsCategory.cpp
+++ b/xbmc/settings/windows/GUIWindowSettingsCategory.cpp
@@ -11,6 +11,8 @@
 #include "GUIPassword.h"
 #include "GUIUserMessages.h"
 #include "ServiceBroker.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
 #include "input/actions/Action.h"
 #include "input/actions/ActionIDs.h"
 #include "settings/DisplaySettings.h"
@@ -107,9 +109,26 @@ bool CGUIWindowSettingsCategory::OnMessage(CGUIMessage &message)
     {
       if (message.GetParam1() == GUI_MSG_WINDOW_RESIZE)
       {
-        if (IsActive() && CDisplaySettings::GetInstance().GetCurrentResolution() != CServiceBroker::GetWinSystem()->GetGfxContext().GetVideoResolution())
+        const RESOLUTION videoResolution =
+            CServiceBroker::GetWinSystem()->GetGfxContext().GetVideoResolution();
+        if (IsActive() && CDisplaySettings::GetInstance().GetCurrentResolution() != videoResolution)
         {
-          CDisplaySettings::GetInstance().SetCurrentResolution(CServiceBroker::GetWinSystem()->GetGfxContext().GetVideoResolution(), true);
+          // Hades: while a video plays, the mode is the one the player chose for it (its frame
+          // rate, Dolby Vision): saved here it would become the resolution of the interface, which
+          // the player goes back to when the video stops. The settings window open over a video
+          // whose mode changes (the next one of a list) must not do that; a resolution the user
+          // chose is saved by its own setting (CDisplaySettings::OnSettingChanged()). After a case
+          // CroqueMr found.
+          const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+          if (appPlayer && appPlayer->IsPlayingVideo())
+            CLog::Log(LOGINFO,
+                      "Settings: the display went to {} while a video plays; that is the video's "
+                      "mode, and the resolution of the interface stays {}",
+                      CDisplaySettings::GetInstance().GetResolutionInfo(videoResolution).strMode,
+                      CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(
+                          CSettings::SETTING_VIDEOSCREEN_SCREENMODE));
+          else
+            CDisplaySettings::GetInstance().SetCurrentResolution(videoResolution, true);
           CreateSettings();
         }
       }
