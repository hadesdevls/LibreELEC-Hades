From 0cbf9d3fbc54750a9210524ba3beab15a279fe29 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 20:57:16 +0000
Subject: [PATCH] rendering: the framebuffer that stands for the window, bound
 where code went back to 0

Code that draws into a framebuffer of its own binds the window again afterwards with
glBindFramebuffer(GL_FRAMEBUFFER, 0): CFrameBufferObject (the multi-pass scalers of the GLES video
renderer, the GUI framebuffer of the HDR GUI composite) and RetroPlayer's shader textures. Where the
window system draws into buffers that it allocates itself instead of the window of EGL (the next
commits: output of more than 8 bits on nvidia-drm with the 580 driver), framebuffer 0 is a window
that is never shown, and what those draw after it would be lost.

rendering/OutputFramebuffer.h holds the framebuffer that stands for the window: 0 unless the window
system says otherwise. Those places bind it instead of 0. Nothing else changes: with no buffers of
the window system's own it is 0, as before.

Read for the other binds of framebuffer 0 in the tree: the Dolby Vision bridge binds 0 only to
look at the window (UpdateScanout(), Initialize()) and restores the binding it found, and the
native Dolby Vision paths of the GBM window system bind 0 while the output is the 8-bit window
(native output starts only at 8 bits). The captures and the screenshots read the framebuffer that is
bound.
---
 .../shaders/gles/ShaderTextureGLES.cpp        |  4 ++-
 .../VideoRenderers/FrameBufferObject.cpp      |  9 +++--
 xbmc/rendering/OutputFramebuffer.h            | 36 +++++++++++++++++++
 3 files changed, 45 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/rendering/OutputFramebuffer.h

diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderTextureGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderTextureGLES.cpp
index 08edecd..30b8947 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderTextureGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderTextureGLES.cpp
@@ -8,6 +8,7 @@
 
 #include "ShaderTextureGLES.h"
 
+#include "rendering/OutputFramebuffer.h"
 #include "utils/log.h"
 
 using namespace KODI::SHADER;
@@ -118,5 +119,6 @@ bool CShaderTextureGLES::BindFBO()
 
 void CShaderTextureGLES::UnbindFBO() const
 {
-  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  // Hades: the framebuffer that stands for the window (OutputFramebuffer.h)
+  glBindFramebuffer(GL_FRAMEBUFFER, KODI::RENDERING::OutputFramebuffer());
 }
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/FrameBufferObject.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/FrameBufferObject.cpp
index f04132f..44f3dbb 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/FrameBufferObject.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/FrameBufferObject.cpp
@@ -10,6 +10,7 @@
 
 #include "ServiceBroker.h"
 #include "rendering/GLExtensions.h"
+#include "rendering/OutputFramebuffer.h"
 #include "rendering/RenderSystem.h"
 #include "utils/GLUtils.h"
 #include "utils/log.h"
@@ -96,7 +97,7 @@ bool CFrameBufferObject::CreateAndBindToTexture(GLenum target, int width, int he
   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, target, m_texid, 0);
   VerifyGLState();
   GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
-  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glBindFramebuffer(GL_FRAMEBUFFER, KODI::RENDERING::OutputFramebuffer());
   if (status != GL_FRAMEBUFFER_COMPLETE)
   {
     VerifyGLState();
@@ -122,7 +123,7 @@ bool CFrameBufferObject::AttachDepthBuffer(int width, int height)
   glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
   glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, m_depthBuffer);
   const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
-  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glBindFramebuffer(GL_FRAMEBUFFER, KODI::RENDERING::OutputFramebuffer());
 
   if (status != GL_FRAMEBUFFER_COMPLETE)
   {
@@ -152,8 +153,10 @@ bool CFrameBufferObject::BeginRender()
 }
 
 // Finish rendering to FBO
+// (Hades: back to the framebuffer that stands for the window, OutputFramebuffer(): 0 unless the
+// window system draws into buffers of its own)
 void CFrameBufferObject::EndRender() const
 {
   if (IsValid())
-    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, KODI::RENDERING::OutputFramebuffer());
 }
diff --git a/xbmc/rendering/OutputFramebuffer.h b/xbmc/rendering/OutputFramebuffer.h
new file mode 100644
index 0000000..42e851a
--- /dev/null
+++ b/xbmc/rendering/OutputFramebuffer.h
@@ -0,0 +1,36 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <atomic>
+
+namespace KODI
+{
+namespace RENDERING
+{
+
+//! Hades: the framebuffer that stands for the window, which what Kodi draws for the display goes
+//! into: 0 (the window of EGL) unless the window system draws into buffers that it allocates
+//! itself (GBM: COwnScanout, output of more than 8 bits where EGL offers no window of them). Code
+//! that binds the window again after drawing into a framebuffer of its own binds this one instead
+//! of 0. Framebuffers are objects of the GL context of the render thread, where this is asked.
+inline std::atomic<unsigned int> g_outputFramebuffer{0};
+
+inline unsigned int OutputFramebuffer()
+{
+  return g_outputFramebuffer.load(std::memory_order_relaxed);
+}
+
+inline void SetOutputFramebuffer(unsigned int framebuffer)
+{
+  g_outputFramebuffer.store(framebuffer, std::memory_order_relaxed);
+}
+
+} // namespace RENDERING
+} // namespace KODI
