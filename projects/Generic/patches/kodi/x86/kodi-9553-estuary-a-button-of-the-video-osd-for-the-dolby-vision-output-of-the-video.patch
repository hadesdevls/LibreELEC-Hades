From 3762eeceecf5b93bf7b68e657391097f6e304fba Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:46:05 +0000
Subject: [PATCH] estuary: a button of the video OSD for the Dolby Vision
 output of the video

Next to the button of the player information: it opens "Dolby Vision
output (this video)" (PlayerControl(HadesDVOutput)), and is there only
where there is more than one output to choose from
(Player.Process(videodvoutputchoice)). Its texture,
osd/fullscreen/buttons/dvoutput.png, is drawn by the build
(packages/mediacenter/kodi/hades/make-dvoutput-icon.py), as the one of
the player information. The same choice can be put on any key with
PlayerControl(HadesDVOutput) in a keymap.
---
 addons/skin.estuary/xml/VideoOSD.xml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/addons/skin.estuary/xml/VideoOSD.xml b/addons/skin.estuary/xml/VideoOSD.xml
index 8c44e5f..bc59d33 100644
--- a/addons/skin.estuary/xml/VideoOSD.xml
+++ b/addons/skin.estuary/xml/VideoOSD.xml
@@ -187,6 +187,15 @@
 						<onclick>Dialog.Close(VideoOSD)</onclick>
 						<onclick>ActivateWindow(playerprocessinfo)</onclick>
 					</control>
+					<!-- Hades: "Dolby Vision output (this video)", where there is more than one to choose from -->
+					<control type="radiobutton" id="70050">
+						<include content="OSDButton">
+							<param name="texture" value="osd/fullscreen/buttons/dvoutput.png"/>
+						</include>
+						<onclick>Dialog.Close(VideoOSD)</onclick>
+						<onclick>PlayerControl(HadesDVOutput)</onclick>
+						<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
+					</control>
 					<control type="radiobutton" id="70044">
 						<include content="OSDButton">
 							<param name="texture" value="osd/fullscreen/buttons/bookmarks.png"/>
-- 
