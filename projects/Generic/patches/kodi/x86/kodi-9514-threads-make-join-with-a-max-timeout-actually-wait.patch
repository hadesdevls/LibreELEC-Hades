From 5a4ba799912c120d2671fcc6c55a3da96d098e4d Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Tue, 13 Oct 2026 12:42:01 +0100
Subject: [PATCH] threads: make Join() with a max() timeout actually wait

libstdc++'s std::future::wait_for() overflows when converting
milliseconds::max() to an absolute time and returns timeout immediately
(seen with GCC 11 on x86 and GCC 16.2 on aarch64). So Join(max()) never
waited and returned false without joining. Do an untimed wait for max(),
as CEventGroup::wait() already does.

(cherry picked from commit 13b52717245dd41459bf3df0f7584ccbe2df902a)
---
 xbmc/threads/Thread.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/xbmc/threads/Thread.cpp b/xbmc/threads/Thread.cpp
index 247c9f5..7564d51 100644
--- a/xbmc/threads/Thread.cpp
+++ b/xbmc/threads/Thread.cpp
@@ -260,8 +260,10 @@ bool CThread::Join(std::chrono::milliseconds duration)
 
     {
       CSingleExit exit(m_CriticalSection); // don't hold the thread lock while we're waiting
-      std::future_status stat = m_future.wait_for(duration);
-      if (stat != std::future_status::ready)
+      // wait_for() overflows on a max() timeout and returns immediately
+      if (duration == std::chrono::milliseconds::max())
+        m_future.wait();
+      else if (m_future.wait_for(duration) != std::future_status::ready)
         return false;
     }
 
