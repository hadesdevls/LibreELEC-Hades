From 766ce8c3a51df155a1c37bfd100e8affc06a5b8c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:33 +0000
Subject: [PATCH] windowing/gbm: what is done about the vendor InfoFrame with a
 mode is one function, with its test

What nvidia-drm is given as its HDMI vendor InfoFrame is the one new
thing on the property that native Dolby Vision output uses, and it was
decided inside PrepareStereoInfoFrame(), where no host test reaches.

The decision is now STEREO::NextInfoFrameStep() in DRMStereo.h, from
what the driver has from here, the layout that is wanted and the mode
that is set: leave, give the InfoFrame of the layout, give the one that
says "no 3D", or empty the property. PrepareStereoInfoFrame() makes the
blob and queues it. It does what it did; one case is stricter: a layout
is never told from here in a mode for which the driver sends a vendor
InfoFrame of its own, whatever was chosen.

Host test: drmstereo_test, each rule, and every state against every mode
and wish (nothing from here stays in a mode of which the driver tells
the display itself; the InfoFrame of a layout never stays where it is
not wanted; a second commit of the same mode changes nothing).
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 45 +++++++++++-----------------
 xbmc/windowing/gbm/drm/DRMStereo.h  | 46 +++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+), 27 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index a96da21..5b5c6f6 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -746,12 +746,17 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
     }
   }
 
-  if (wanted != STEREO::Layout::NONE)
-  {
-    // (the driver has it already)
-    if (wanted == m_stereoInfoFrameLayout)
-      return;
+  // What is done about it with this commit (STEREO::NextInfoFrameStep(), which has the rules).
+  // The driver sends a vendor InfoFrame of its own, which one from here would be sent in place
+  // of, for a mode with a 3D layout and for one that HDMI has a format number of its own for
+  // (2160p at 24 to 30 Hz).
+  const bool driverTells = !plain || STEREO::HasHdmiVic(mode);
+  STEREO::InfoFrameStep step =
+      STEREO::NextInfoFrameStep(m_stereoInfoFrameLayout, m_stereoInfoFrameEnds, wanted,
+                                driverTells, m_stereoInfoFrameNoEnd);
 
+  if (step == STEREO::InfoFrameStep::GIVE_LAYOUT)
+  {
     const STEREO::InfoFramePayload payload = STEREO::HalfLayoutInfoFrame(wanted);
     CDRMPropertyBlob blob(drm->GetFileDescriptor(), payload.bytes.data(), payload.size);
     if (payload.size != 0 && blob.IsValid() &&
@@ -766,29 +771,12 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
 
     RefuseStereoOutput(m_stereoRefusedInfoFrame, "the HDMI vendor InfoFrame of a half layout",
                        "it could not be made for the driver");
+    // (what the driver has from here, if anything, as where no layout is wanted)
+    step = STEREO::NextInfoFrameStep(m_stereoInfoFrameLayout, m_stereoInfoFrameEnds,
+                                     STEREO::Layout::NONE, driverTells, m_stereoInfoFrameNoEnd);
   }
 
-  // None is wanted (or the one that is wanted could not be made)
-  if (!m_stereoInfoFrame.IsValid())
-    return;
-
-  // The driver has one from here.
-  //
-  // If it is the one of a half layout, that layout ends with this commit. The display is told
-  // so, by an InfoFrame that says "no 3D", and not left to notice that the InfoFrame of the
-  // layout stopped coming, which some displays do not (STEREO::NoLayoutInfoFrame()). That one
-  // then stays with the driver in the modes that are set later, until a layout is told again,
-  // native Dolby Vision output takes the property, or Kodi ends.
-  //
-  // But not in a mode for which the driver sends a vendor InfoFrame of its own, which ours
-  // would be sent in place of: a mode with a 3D layout, and one that HDMI has a format number
-  // of its own for (2160p at 24 to 30 Hz). With such a mode ours is taken away, whichever it
-  // is, and the driver's own tells the display.
-  const bool driverTells = !plain || STEREO::HasHdmiVic(mode);
-  if (m_stereoInfoFrameEnds && !driverTells)
-    return;
-
-  if (!m_stereoInfoFrameEnds && !driverTells && !m_stereoInfoFrameNoEnd)
+  if (step == STEREO::InfoFrameStep::GIVE_NO_LAYOUT)
   {
     const STEREO::InfoFramePayload payload = STEREO::NoLayoutInfoFrame();
     CDRMPropertyBlob blob(drm->GetFileDescriptor(), payload.bytes.data(), payload.size);
@@ -800,9 +788,12 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
       m_stereoInfoFrameQueued = true;
       return;
     }
+    // (it could not be made: the one of the layout is taken away)
+    step = STEREO::InfoFrameStep::TAKE_AWAY;
   }
 
-  if (drm->AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0))
+  if (step == STEREO::InfoFrameStep::TAKE_AWAY &&
+      drm->AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0))
   {
     m_stereoInfoFramePending = CDRMPropertyBlob();
     m_stereoInfoFrameAsked = STEREO::Layout::NONE;
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index f9c12b3..f53cf5e 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -789,6 +789,52 @@ constexpr InfoFramePayload NoLayoutInfoFrame()
   return {4, {0x03, 0x0C, 0x00, 0x00}};
 }
 
+//! What is done about the HDMI vendor InfoFrame that a driver takes from its user, with the
+//! commit of a mode
+enum class InfoFrameStep
+{
+  LEAVE, //!< nothing is given or taken: what the driver has from here, if anything, stays
+  GIVE_LAYOUT, //!< the driver is given the InfoFrame of the half layout that is wanted
+  GIVE_NO_LAYOUT, //!< the driver is given the InfoFrame that says "no 3D"
+  TAKE_AWAY, //!< the property is emptied
+};
+
+/*!
+ * \brief What is done about that InfoFrame with the commit of a mode
+ * \param held the half layout whose InfoFrame the driver has from here; none: it has none of a
+ *        layout
+ * \param holdsNoLayout the driver has the InfoFrame that says "no 3D" from here (and none of a
+ *        layout)
+ * \param wanted the half layout that the display is to be told of with this mode; none: none
+ * \param driverTells the driver sends a vendor InfoFrame of its own for this mode, which one
+ *        from here would be sent in place of: a mode with a 3D layout, or one that HDMI has a
+ *        format number of its own for (HasHdmiVic())
+ * \param noLayoutRefused the driver did not take the InfoFrame that says "no 3D" before
+ *
+ * - A layout is told from here only in a mode for which the driver tells nothing itself.
+ * - The InfoFrame of a layout that is no longer wanted never stays. Its place is taken by the
+ *   one that says "no 3D", so that the display is told that the layout ended; where the driver
+ *   tells the display itself, or did not take that InfoFrame before, the property is emptied.
+ * - The one that says "no 3D" stays in the modes that follow, until a layout is wanted again
+ *   or a mode comes for which the driver tells the display itself.
+ * - Where the driver has nothing from here and no layout is wanted, nothing is touched.
+ */
+constexpr InfoFrameStep NextInfoFrameStep(
+    Layout held, bool holdsNoLayout, Layout wanted, bool driverTells, bool noLayoutRefused)
+{
+  if (driverTells || HalfLayoutInfoFrame(wanted).size == 0)
+    wanted = Layout::NONE;
+
+  if (wanted != Layout::NONE)
+    return !holdsNoLayout && wanted == held ? InfoFrameStep::LEAVE : InfoFrameStep::GIVE_LAYOUT;
+  if (holdsNoLayout)
+    return driverTells ? InfoFrameStep::TAKE_AWAY : InfoFrameStep::LEAVE;
+  if (HalfLayoutInfoFrame(held).size == 0)
+    return InfoFrameStep::LEAVE;
+  return driverTells || noLayoutRefused ? InfoFrameStep::TAKE_AWAY
+                                        : InfoFrameStep::GIVE_NO_LAYOUT;
+}
+
 } // namespace STEREO
 } // namespace GBM
 } // namespace WINDOWING
