diff --git a/xbmc/rendering/capture/CaptureBlit.cpp b/xbmc/rendering/capture/CaptureBlit.cpp
index 133be61..0c92a32 100644
--- a/xbmc/rendering/capture/CaptureBlit.cpp
+++ b/xbmc/rendering/capture/CaptureBlit.cpp
@@ -162,6 +162,22 @@ bool CCaptureBlit::Blit(const CRect& srcRect,
   if (!ClampToOutput(srcRect, x0, y0, x1, y1, fbHeight))
     return false;
 
+  // What is presented is not in the framebuffer that was just drawn to (native Dolby Vision
+  // output, see CWinSystemBase::HasCaptureFramebuffer()) but in one of its own: of the size of
+  // the output, deeper than it, and its first row is the top one where that of a window is the
+  // bottom one. A frame that has no picture gives nothing, rather than the transport.
+  CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  const bool separate = winSystem->HasCaptureFramebuffer();
+  int separateWidth{0};
+  int separateHeight{0};
+  const GLuint separateFBO =
+      separate ? winSystem->GetCaptureFramebuffer(separateWidth, separateHeight) : 0;
+  if (separate && (!separateFBO || separateHeight != fbHeight || !HasFramebufferBlit()))
+    return false;
+  // the first row of the region in the source, and whether its rows are bottom-up
+  const int sourceY = separate ? y0 : fbHeight - y1;
+  const bool bottomUp = !separate;
+
   // an ES2 context has no framebuffer blit: read the region at its native size
   // and let the consumer's swscale resize, as the GLES2 and Direct3D paths do
   if (!HasFramebufferBlit())
@@ -173,7 +189,7 @@ bool CCaptureBlit::Blit(const CRect& srcRect,
   }
 
   // native depth is only distinct from BGRA8 when the output runs above 8 bits
-  const int outputBitDepth = CServiceBroker::GetWinSystem()->GetOutputBitDepth();
+  const int outputBitDepth = separate ? 16 : winSystem->GetOutputBitDepth();
   const bool highDepth = format == CaptureFormat::NATIVE && outputBitDepth > 8;
   const int readDepth = highDepth ? outputBitDepth : 8;
   m_outputBitDepth = outputBitDepth;
@@ -185,14 +201,15 @@ bool CCaptureBlit::Blit(const CRect& srcRect,
   GLint prevDrawFBO{0};
   glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevReadFBO);
   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDrawFBO);
+  const GLuint sourceFBO = separate ? separateFBO : static_cast<GLuint>(prevDrawFBO);
 
   // no scaling: read the region straight from the just-drawn framebuffer, no
   // FBO round trip (the driver requantizes a deep surface to 8 bits on read)
   if (width == srcWidth && height == srcHeight)
   {
-    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevDrawFBO));
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, sourceFBO);
     const bool ok =
-        ReadFramebufferRegion(x0, fbHeight - y1, srcWidth, srcHeight, readDepth, true, m_staged);
+        ReadFramebufferRegion(x0, sourceY, srcWidth, srcHeight, readDepth, bottomUp, m_staged);
     glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevReadFBO));
     m_useStaged = ok;
     return ok;
@@ -209,12 +226,17 @@ bool CCaptureBlit::Blit(const CRect& srcRect,
     while (glGetError() != GL_NO_ERROR)
       ;
 
-    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevDrawFBO));
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, sourceFBO);
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
 
     // source is bottom-up GL coordinates; the inverted destination yields top-down rows
-    glBlitFramebuffer(x0, fbHeight - y1, x1, fbHeight - y0, 0, static_cast<GLint>(height),
-                      static_cast<GLint>(width), 0, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    // (a source whose first row is the top one is copied as it is)
+    if (bottomUp)
+      glBlitFramebuffer(x0, fbHeight - y1, x1, fbHeight - y0, 0, static_cast<GLint>(height),
+                        static_cast<GLint>(width), 0, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    else
+      glBlitFramebuffer(x0, y0, x1, y1, 0, 0, static_cast<GLint>(width),
+                        static_cast<GLint>(height), GL_COLOR_BUFFER_BIT, GL_LINEAR);
     ok = glGetError() == GL_NO_ERROR;
     if (!ok)
       CLog::LogF(LOGWARNING, "glBlitFramebuffer failed");
diff --git a/xbmc/rendering/capture/CaptureMetadata.cpp b/xbmc/rendering/capture/CaptureMetadata.cpp
index a80a1fa..c28aeb7 100644
--- a/xbmc/rendering/capture/CaptureMetadata.cpp
+++ b/xbmc/rendering/capture/CaptureMetadata.cpp
@@ -30,6 +30,15 @@ ImageColorMetadata GetOutputColorMetadata(CWinSystemBase& winSystem)
   using KODI::UTILS::Colorimetry;
   using KODI::UTILS::Eotf;
   ImageColorMetadata color;
+  // With native Dolby Vision output a capture is of the picture before it is packed for the
+  // link (CWinSystemBase::HasCaptureFramebuffer()), not of what the display mode says.
+  if (winSystem.HasCaptureFramebuffer())
+  {
+    color.primaries = AVCOL_PRI_BT2020;
+    color.transfer = AVCOL_TRC_SMPTE2084;
+    color.range = AVCOL_RANGE_JPEG;
+    return color;
+  }
   color.primaries = AVCOL_PRI_BT709;
   const Colorimetry colorimetry = winSystem.GetColorimetry();
   if (colorimetry == Colorimetry::BT2020_RGB || colorimetry == Colorimetry::BT2020_YCC ||
diff --git a/xbmc/rendering/capture/CaptureReadback.cpp b/xbmc/rendering/capture/CaptureReadback.cpp
index 1f6b4fb..49bf820 100644
--- a/xbmc/rendering/capture/CaptureReadback.cpp
+++ b/xbmc/rendering/capture/CaptureReadback.cpp
@@ -49,12 +49,13 @@ bool ReadFramebufferRegion(int x,
   unsigned int rowBytes = width * 4;
   bool floating = false;
 #ifndef HAS_GL
-  // A floating-point framebuffer (the half-float output of nvidia-drm) cannot be read as bytes,
-  // whatever depth is asked for; as GL_FLOAT it always can. Only looked at where the output is
-  // one, so that nothing changes anywhere else. The kind of its components says it; the type the
-  // driver prefers for reading is its free choice.
+  // A floating-point framebuffer (the half-float output of nvidia-drm, the picture of native
+  // Dolby Vision output) cannot be read as bytes, whatever depth is asked for; as GL_FLOAT it
+  // always can. Only looked at where the output is one or the picture is in one, so that nothing
+  // changes anywhere else. The kind of its components says it; the type the driver prefers for
+  // reading is its free choice.
   if (const auto* winSystem = CServiceBroker::GetWinSystem();
-      winSystem && winSystem->HasFloatOutput())
+      winSystem && (winSystem->HasFloatOutput() || winSystem->HasCaptureFramebuffer()))
   {
     GLint bound = 0;
     GLint components = GL_UNSIGNED_NORMALIZED;
diff --git a/xbmc/rendering/gles/ScreenshotSurfaceGLES.cpp b/xbmc/rendering/gles/ScreenshotSurfaceGLES.cpp
index 3c5800b..dd0d626 100644
--- a/xbmc/rendering/gles/ScreenshotSurfaceGLES.cpp
+++ b/xbmc/rendering/gles/ScreenshotSurfaceGLES.cpp
@@ -30,17 +30,43 @@ bool CScreenshotSurfaceGLES::Read(const ScreenshotContext& ctx)
 {
   using namespace KODI::RENDERING::CAPTURE;
 
-  // get current viewport: x, y, width, height
-  GLint viewport[4];
-  glGetIntegerv(GL_VIEWPORT, viewport);
-
-  // window rows are bottom-up: flip to top-down. The shared readback negotiates
-  // the deep type and delivers 8-bit when the driver offers nothing deeper.
   ReadbackBuffer buffer;
-  if (!ReadFramebufferRegion(viewport[0], viewport[1], static_cast<unsigned int>(viewport[2]),
-                             static_cast<unsigned int>(viewport[3]),
-                             ctx.winSystem.GetOutputBitDepth(), true, buffer))
-    return false;
+#if HAS_GLES == 3
+  // What is presented is not in the window framebuffer (native Dolby Vision output, see
+  // CWinSystemBase::HasCaptureFramebuffer()): the picture is read where it is, whole and at its
+  // depth. Its first row is the top one, so its rows are not flipped. A frame that has no
+  // picture gives nothing, rather than the transport.
+  if (ctx.winSystem.HasCaptureFramebuffer())
+  {
+    int width = 0;
+    int height = 0;
+    const unsigned int framebuffer = ctx.winSystem.GetCaptureFramebuffer(width, height);
+    if (!framebuffer || width <= 0 || height <= 0)
+      return false;
+
+    GLint previous = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+    const bool read = ReadFramebufferRegion(0, 0, static_cast<unsigned int>(width),
+                                            static_cast<unsigned int>(height), 16, false, buffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(previous));
+    if (!read)
+      return false;
+  }
+  else
+#endif
+  {
+    // get current viewport: x, y, width, height
+    GLint viewport[4];
+    glGetIntegerv(GL_VIEWPORT, viewport);
+
+    // window rows are bottom-up: flip to top-down. The shared readback negotiates
+    // the deep type and delivers 8-bit when the driver offers nothing deeper.
+    if (!ReadFramebufferRegion(viewport[0], viewport[1], static_cast<unsigned int>(viewport[2]),
+                               static_cast<unsigned int>(viewport[3]),
+                               ctx.winSystem.GetOutputBitDepth(), true, buffer))
+      return false;
+  }
 
   m_width = static_cast<int>(buffer.width);
   m_height = static_cast<int>(buffer.height);
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index 2984e88..b1f88f1 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -88,6 +88,23 @@ public:
   //! \brief Video of more than 8 bits can go out through an output of floating-point components
   //! here: the setting for it is shown.
   virtual bool SupportsFloatOutput() const { return false; }
+  /*!
+   * \brief Whether the picture that is presented is somewhere else than in the window framebuffer
+   *
+   * With native Dolby Vision output the window framebuffer holds the transport: the picture
+   * packed for the HDMI link, which is no picture to look at. The picture itself, the video and
+   * the GUI over it, is then in a framebuffer of its own: floating-point components, full
+   * range, BT.2020 primaries and the PQ transfer, of the size of the output, its first row the
+   * top one.
+   */
+  virtual bool HasCaptureFramebuffer() const { return false; }
+  /*!
+   * \brief That framebuffer, as it is for the frame that is being drawn
+   * \param[out] width its size
+   * \param[out] height its size
+   * \return its name, or 0 when this frame has no such picture: a capture of it fails
+   */
+  virtual unsigned int GetCaptureFramebuffer(int& width, int& height) { return 0; }
   virtual bool MoveWindow(int topLeft, int topRight){return false;}
   virtual void FinishModeChange(RESOLUTION res){}
   virtual void FinishWindowResize(int newWidth, int newHeight) {ResizeWindow(newWidth, newHeight, -1, -1);}
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6009c0c..d0f900b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -55,6 +55,7 @@ extern "C"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "cores/VideoPlayer/DVDStreamInfo.h"
 #include "drm/DRMAtomic.h"
+#include "rendering/capture/CaptureService.h"
 #endif
 
 #include <gbm.h>
@@ -773,6 +774,17 @@ bool CWinSystemGbmGLESContext::SetVideoOutput(const VideoPicture* picture)
   return CWinSystemGbmEGLContext::SetVideoOutput(picture);
 }
 
+unsigned int CWinSystemGbmGLESContext::GetCaptureFramebuffer(int& width, int& height)
+{
+  // Only a frame that was composed has its picture there: one drawn directly exists as the
+  // transport only. RenderDVBridge() composes the frame that a capture waits for.
+  if (!m_dvState.Captured() || !m_dvFrame || !m_dvBridge || !m_dvBridge->Composable())
+    return 0;
+  width = 3840;
+  height = 2160;
+  return m_dvBridge->GetPQFramebuffer();
+}
+
 bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
                                             const AVFrame* enhancement,
                                             const CDVMetadataBuffer& metadata,
@@ -782,7 +794,15 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   m_dvFramePts = layer.pts;
   if (!BeginDVBridge())
     return false;
-  const bool overlayFree = m_guiWillRender && GetGUIElementCount() == 0 && !m_dvOverlays;
+  // A frame that a capture waits for (a screenshot, the thumbnail of a bookmark) is composed
+  // like one with GUI elements, so that there is a picture to read (GetCaptureFramebuffer()).
+  // A request is taken up for one frame at a time, the one that is drawn now.
+  using KODI::RENDERING::CAPTURE::CaptureContent;
+  const auto captures = CServiceBroker::GetCaptureService();
+  const bool captured = captures && (!captures->TakeActive(CaptureContent::COMPOSITE).empty() ||
+                                     !captures->TakeActive(CaptureContent::VIDEO).empty());
+  const bool overlayFree =
+      m_guiWillRender && GetGUIElementCount() == 0 && !m_dvOverlays && !captured;
   DVGpuTimerCollect();
   DVGpuTimerMark(true);
   const auto prepareStart = std::chrono::steady_clock::now();
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 5cd2491..00f223a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -70,6 +70,8 @@ public:
   bool BeginDVBridge();
   void SetDVBridgeOverlays(bool visible) { m_dvOverlays = visible; }
   bool DVBridgeCaptured() const { return m_dvState.Captured(); }
+  bool HasCaptureFramebuffer() const override { return m_dvState.Captured(); }
+  unsigned int GetCaptureFramebuffer(int& width, int& height) override;
   //! Route the HDR overlays that Kodi draws right after the video into the Dolby Vision PQ
   //! picture. Returns false (nothing changed) when there is no such picture this frame.
   bool BeginDVBridgeHDROverlays();
