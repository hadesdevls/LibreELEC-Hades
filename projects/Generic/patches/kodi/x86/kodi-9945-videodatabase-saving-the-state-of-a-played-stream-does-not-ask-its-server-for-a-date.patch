From ffc6d05df8a7a36e133b28b22225ece2fac173dd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:11:48 +0000
Subject: [PATCH] VideoDatabase: saving the state of a played stream does not
 ask its server for a date

When a video stops, CSaveFileState::DoWork saves its state (resume point, play count, stream
details) on the player's event queue, and the player's destructor waits for that queue on the
interface thread. Saving it adds the file to the database when it is not there (AddOrUpdateFile),
which first works out the date a new file gets (GetDateAdded), even when the file is there already
and the date is not used - and that asks the file's server when it was changed
(CFileUtils::GetModificationDate, a CCurlFile::Stat for an internet stream). With the server gone (a dropped connection,
an expired link), the Stat waits for curl's timeout three times: the interface stood still for a
minute after Stop, and the events of the video (stopped, and the start of the next one) came a
minute late.

The database is told not to ask the server of an internet stream while the state is saved. Such a
file, when it is new, gets the current date, which is what it gets today once the server has not
answered. A file of the library is in the database already, with the date its scan gave it, so
nothing changes for it, and the scanner, which adds the files of a source, still asks.
---
 xbmc/utils/SaveFileStateJob.cpp |  5 +++++
 xbmc/video/VideoDatabase.cpp    | 12 ++++++++++--
 xbmc/video/VideoDatabase.h      | 12 +++++++++++-
 3 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/xbmc/utils/SaveFileStateJob.cpp b/xbmc/utils/SaveFileStateJob.cpp
index a3f8305..59240b6 100644
--- a/xbmc/utils/SaveFileStateJob.cpp
+++ b/xbmc/utils/SaveFileStateJob.cpp
@@ -141,6 +141,11 @@ void CSaveFileState::DoWork(CFileItem& item,
       }
       else
       {
+        // The player waits for this when it is closed, and the interface for the player, so the
+        // server of a stream is not asked when its file was changed: one that does not answer
+        // would hold both for a minute. A file of the library is there already, with its date.
+        videodatabase.SetAskServersForDates(false);
+
         if (URIUtils::IsPlugin(progressTrackingFile) && !(item.HasVideoInfoTag() && item.GetVideoInfoTag()->m_iDbId >= 0))
         {
           // FileItem from plugin can lack information, make sure all needed fields are set
diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 831eb7b..6f0b56a 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -13086,12 +13086,20 @@ bool CVideoDatabase::SetVideoUserRating(int dbId, int rating, const MediaType& m
 }
 
 CDateTime CVideoDatabase::GetDateAdded(const std::string& filename,
-                                       CDateTime dateAdded /* = CDateTime() */)
+                                       CDateTime dateAdded /* = CDateTime() */) const
 {
   if (!dateAdded.IsValid())
   {
+    // The server of an internet stream is not asked when told so: one that does not answer holds
+    // the caller for as long as its retries take (a minute), and gives the current date then
+    const bool askServer{m_askServersForDates || !URIUtils::IsInternetStream(filename)};
+    if (!askServer)
+      CLog::LogF(LOGDEBUG,
+                 "the server of {} is not asked when it was changed: it gets the current date",
+                 CURL::GetRedacted(filename));
+
     // suppress warnings if we have plugin source
-    if (!URIUtils::IsPlugin(filename))
+    if (!URIUtils::IsPlugin(filename) && askServer)
     {
       const auto dateAddedSetting =
           CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_iVideoLibraryDateAdded;
diff --git a/xbmc/video/VideoDatabase.h b/xbmc/video/VideoDatabase.h
index cb9bd85..0f7909e 100644
--- a/xbmc/video/VideoDatabase.h
+++ b/xbmc/video/VideoDatabase.h
@@ -859,6 +859,14 @@ public:
    */
   void UpdateFileDateAdded(CVideoInfoTag& details);
 
+  /*!
+   \brief Whether the server of an internet stream is asked when its file was changed, for
+   the date that a file added without one gets (as the date added setting says). It is,
+   unless this says otherwise; saving the state of a played video says otherwise.
+   \param ask false: such a file gets the current date, as when its server does not answer
+   */
+  void SetAskServersForDates(bool ask) { m_askServersForDates = ask; }
+
   void ExportToXML(const std::string &path, bool singleFile = true, bool images=false, bool actorThumbs=false, bool overwrite=false);
   void ExportArt(const CFileItem& item, const KODI::ART::Artwork& artwork, bool overwrite) const;
   void ExportActorThumbs(const std::string& path,
@@ -1363,5 +1371,7 @@ private:
 
   static void AnnounceRemove(const std::string& content, int id, bool scanning = false);
 
-  static CDateTime GetDateAdded(const std::string& filename, CDateTime dateAdded = CDateTime());
+  CDateTime GetDateAdded(const std::string& filename, CDateTime dateAdded = CDateTime()) const;
+
+  bool m_askServersForDates{true};
 };
