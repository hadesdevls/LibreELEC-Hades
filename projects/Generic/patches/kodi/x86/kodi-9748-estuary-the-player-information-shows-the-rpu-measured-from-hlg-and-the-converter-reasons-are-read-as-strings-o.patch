From d0784d759fae1da44c05e4545659495f48d5983d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:42:04 +0000
Subject: [PATCH] estuary: the player information shows the RPU measured from
 HLG, and the converter reasons are read as strings of the skin

After the fronts were put together: the Dolby Vision page has the row for
an RPU that Hades measured from an HLG picture (hades.dv.origin
measuredhlg, string 32632 of its front), and the two reasons of the display
converter (32905, 32906) are read as $ADDON[skin.estuary n] like every
string of the skin above 31999, which $LOCALIZE does not give.
---
 .../resource.language.es_ar/strings.po        |  1 +
 .../resource.language.es_es/strings.po        |  1 +
 .../resource.language.es_mx/strings.po        |  1 +
 .../xml/DialogPlayerProcessInfo.xml           |  9 ++++
 addons/skin.estuary/xml/Variables.xml         |  4 +-
 system/hades/DialogHadesPlayerInfo.xml        | 43 +++++++++++++++++++
 6 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index df0fa5f..1f2233a 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -3394,6 +3394,7 @@ msgstr "Para una tarjeta gráfica NVIDIA que envía el sonido a la tele o al rec
 msgctxt "#33800"
 msgid "The list of this folder could not be read to its end ({}). Some of its files may be missing, so nothing is shown. This usually means that the disk or its file system is damaged: check the disk."
 msgstr "No se pudo leer la lista de esta carpeta hasta el final ({}). Puede que falten archivos, así que no se muestra nada. Suele significar que el disco o su sistema de archivos está dañado: revisa el disco."
+
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, player information (key O): begin
 #. Hades, heading of the player information: native Dolby Vision
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index a96798a..2020375 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -3414,6 +3414,7 @@ msgstr "Para una tarjeta gráfica NVIDIA que envía el sonido a la tele o al rec
 msgctxt "#33800"
 msgid "The list of this folder could not be read to its end ({}). Some of its files may be missing, so nothing is shown. This usually means that the disk or its file system is damaged: check the disk."
 msgstr "No se pudo leer la lista de esta carpeta hasta el final ({}). Puede que falten archivos, así que no se muestra nada. Suele significar que el disco o su sistema de archivos está dañado: revisa el disco."
+
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, player information (key O): begin
 #. Hades, heading of the player information: native Dolby Vision
diff --git a/addons/skin.estuary/language/resource.language.es_mx/strings.po b/addons/skin.estuary/language/resource.language.es_mx/strings.po
index f1438d4..c3838d3 100644
--- a/addons/skin.estuary/language/resource.language.es_mx/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -3414,6 +3414,7 @@ msgstr "Para una tarjeta gráfica NVIDIA que envía el sonido a la tele o al rec
 msgctxt "#33800"
 msgid "The list of this folder could not be read to its end ({}). Some of its files may be missing, so nothing is shown. This usually means that the disk or its file system is damaged: check the disk."
 msgstr "No se pudo leer la lista de esta carpeta hasta el final ({}). Puede que falten archivos, así que no se muestra nada. Suele significar que el disco o su sistema de archivos está dañado: revisa el disco."
+
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, player information (key O): begin
 #. Hades, heading of the player information: native Dolby Vision
diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 22c13de..359ee3b 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -1271,6 +1271,15 @@
 						<param name="valuewidth" value="280"/>
 						<param name="height" value="32"/>
 					</include>
+					<include content="HadesPanelRow">
+						<param name="name" value="RPU"/>
+						<param name="value" value="$ADDON[skin.estuary 32632]"/>
+						<param name="visible" value="String.IsEqual(Window(Home).Property(hades.dv.origin),measuredhlg)"/>
+						<param name="font" value="font10"/>
+						<param name="namewidth" value="250"/>
+						<param name="valuewidth" value="280"/>
+						<param name="height" value="32"/>
+					</include>
 				</control>
 				<!-- the last 10 s, and the output of this video -->
 				<control type="image">
diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 9ef79a1..709beb0 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -816,8 +816,8 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sdrbase)">$LOCALIZE[31874]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),hlgbase)">$LOCALIZE[31875]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converter)">$LOCALIZE[31890]</value>
-		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converteroff)">$LOCALIZE[32905]</value>
-		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converterunlisted)">$LOCALIZE[32906]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converteroff)">$ADDON[skin.estuary 32905]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converterunlisted)">$ADDON[skin.estuary 32906]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sink)">$LOCALIZE[31891]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),frl)">$LOCALIZE[31892]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),link)">$LOCALIZE[31893]</value>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index c332b5d..ab8cf5d 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -5739,6 +5739,49 @@
 							<aspectratio>stretch</aspectratio>
 						</control>
 					</control>
+					<control type="group">
+						<width>530</width>
+						<height>32</height>
+						<visible>String.IsEqual(Window(Home).Property(hades.dv.origin),measuredhlg)</visible>
+						<control type="label">
+							<left>0</left>
+							<top>0</top>
+							<width>250</width>
+							<height>32</height>
+							<aligny>center</aligny>
+							<font>font10</font>
+							<textcolor>FF8C99A5</textcolor>
+							<label>RPU</label>
+							<align>left</align>
+							<disabledcolor>40FFFFFF</disabledcolor>
+							<selectedcolor>FFFFB70F</selectedcolor>
+							<scroll>false</scroll>
+							<scrollspeed>40</scrollspeed>
+						</control>
+						<control type="label">
+							<left>250</left>
+							<top>0</top>
+							<width>280</width>
+							<height>32</height>
+							<align>right</align>
+							<aligny>center</aligny>
+							<font>font10</font>
+							<textcolor>FFEEF2F5</textcolor>
+							<label>$ADDON[skin.estuary 32632]</label>
+							<disabledcolor>40FFFFFF</disabledcolor>
+							<selectedcolor>FFFFB70F</selectedcolor>
+							<scroll>false</scroll>
+							<scrollspeed>40</scrollspeed>
+						</control>
+						<control type="image">
+							<left>0</left>
+							<bottom>0</bottom>
+							<width>530</width>
+							<height>1</height>
+							<texture colordiffuse="FF1B2227">special://xbmc/system/hades/colors-white.png</texture>
+							<aspectratio>stretch</aspectratio>
+						</control>
+					</control>
 					<align>left</align>
 				</control>
 				<control type="image">
-- 
