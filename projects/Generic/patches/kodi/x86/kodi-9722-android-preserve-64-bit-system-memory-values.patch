From 3e9bbf186995d14279b69f6e0b59e5a74bbd7bd5 Mon Sep 17 00:00:00 2001
From: kontell <kontell@users.noreply.github.com>
Date: Fri, 23 Oct 2026 13:45:21 +0100
Subject: [PATCH] [Android] Preserve 64-bit system memory values

Read the MemoryInfo fields as jlong so 32-bit libandroidjni long return
values cannot truncate RAM totals or available memory above 4 GiB.
---
 xbmc/platform/android/MemUtils.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/xbmc/platform/android/MemUtils.cpp b/xbmc/platform/android/MemUtils.cpp
index 68f7f64..513eaee 100644
--- a/xbmc/platform/android/MemUtils.cpp
+++ b/xbmc/platform/android/MemUtils.cpp
@@ -12,6 +12,7 @@
 
 #include <androidjni/ActivityManager.h>
 #include <androidjni/Context.h>
+#include <androidjni/jutils-details.hpp>
 
 namespace KODI
 {
@@ -50,8 +51,9 @@ void GetMemoryStatus(MemoryStatus* buffer)
     }
 
     *buffer = {};
-    buffer->totalPhys = static_cast<unsigned long>(info.totalMem());
-    buffer->availPhys = static_cast<unsigned long>(info.availMem());
+    // The libandroidjni accessors return long, which truncates Java long values on 32-bit Android.
+    buffer->totalPhys = static_cast<uint64_t>(jni::get_field<jlong>(info.get_raw(), "totalMem"));
+    buffer->availPhys = static_cast<uint64_t>(jni::get_field<jlong>(info.get_raw(), "availMem"));
   }
 }
 
