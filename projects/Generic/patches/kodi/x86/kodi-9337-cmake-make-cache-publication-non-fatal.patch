From 3947d2d746c754df3c10da9d30e618cbc65912cd Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sun, 18 Oct 2026 07:24:11 +0200
Subject: [PATCH] [cmake] Make cache publication non-fatal

The private archive is already hash-verified, so a busy shared cache
must not fail the dependency build.
---
 cmake/scripts/common/DownloadWithRetry.cmake | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/cmake/scripts/common/DownloadWithRetry.cmake b/cmake/scripts/common/DownloadWithRetry.cmake
index 39aa2a7..9bcf70e 100644
--- a/cmake/scripts/common/DownloadWithRetry.cmake
+++ b/cmake/scripts/common/DownloadWithRetry.cmake
@@ -59,7 +59,11 @@ foreach(_attempt RANGE 1 ${_attempts})
         if(_size GREATER 0)
           file(${_algo} "${ARCHIVE_DEST}" _actual)
           if(_actual STREQUAL _expected)
-            file(RENAME "${_download}" "${ARCHIVE_CACHE}")
+            execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${_download}" "${ARCHIVE_CACHE}"
+                            RESULT_VARIABLE _rename_result ERROR_QUIET)
+            if(NOT _rename_result EQUAL 0)
+              file(REMOVE "${_download}")
+            endif()
             return()
           endif()
           # A complete transfer with the wrong hash is a wrong pin, not a network fault
-- 
