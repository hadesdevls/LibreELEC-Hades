 void CActiveAESink::EnumerateSinkList(bool force, std::string driver)
 {
-  if (!m_sinkInfoList.empty() && !force)
+  const auto before = SinkInfo();
+  if (!before->empty() && !force)
     return;
 
   if (!CAESinkFactory::HasSinks())
     return;
 
-  std::vector<AE::AESinkInfo> tmpList(m_sinkInfoList);
-
+  // Hades: the next list is made apart, with no lock held (the drivers may take seconds, and try
+  // again), and published whole when it is done (m_sinkInfo): a reader goes on with the list it has
+  // meanwhile, and never sees one half made.
+  SinkInfoList list;
   unsigned int c_retry = 4;
-  m_sinkInfoList.clear();
 
   if (!driver.empty())
   {
-    for (auto const& info : tmpList)
+    for (auto const& info : *before)
     {
       if (info.m_sinkName != driver)
-        m_sinkInfoList.push_back(info);
+        list.push_back(info);
     }
   }
 
-  CAESinkFactory::EnumerateEx(m_sinkInfoList, false, driver);
-  while (m_sinkInfoList.empty() && c_retry > 0)
+  CAESinkFactory::EnumerateEx(list, false, driver);
+  while (list.empty() && c_retry > 0)
   {
     CLog::Log(LOGINFO, "No Devices found - retry: {}", c_retry);
     CThread::Sleep(1500ms);
     c_retry--;
     // retry the enumeration
-    CAESinkFactory::EnumerateEx(m_sinkInfoList, true, driver);
+    CAESinkFactory::EnumerateEx(list, true, driver);
   }
-  CLog::Log(LOGINFO, "Found {} Lists of Devices", m_sinkInfoList.size());
+  CLog::Log(LOGINFO, "Found {} Lists of Devices", list.size());
+  m_sinkInfo.store(std::make_shared<const SinkInfoList>(std::move(list)));
   PrintSinks(driver);
 }
 
