 #include "ActiveAESound.h"
 #include "ActiveAEStream.h"
@@ -2913,10 +2914,10 @@ void CActiveAE::LoadSettings()
 
   m_settings.device =
       FollowDisplay(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE),
-                    m_followedDevice, false);
+                    m_followedDevice, m_inPlaceOfDevice, false);
   m_settings.passthroughdevice =
       FollowDisplay(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE),
-                    m_followedPassthroughDevice, true);
+                    m_followedPassthroughDevice, m_inPlaceOfPassthroughDevice, true);
   {
     std::unique_lock lock(m_passthroughInUseLock);
     m_passthroughInUse = m_settings.passthroughdevice;
@@ -2988,12 +2989,48 @@ void CActiveAE::LimitChannelsToDisplay()
   m_settings.channels = limited;
 }
 
+std::string CActiveAE::ResolveOutput(const std::string& device,
+                                     const std::string& followedBefore,
+                                     bool passthrough,
+                                     std::string* followedOut,
+                                     bool* missingOut,
+                                     bool* sameCardOut) const
+{
+  bool missing = false;
+  const std::string followed = m_sink.FollowDisplay(device, followedBefore, passthrough, &missing);
+
+  // Hades: a configured output that is not there, and that is not followed away from: the output
+  // in its place is chosen before the formats are asked (INTERNAL::OutputForSetting())
+  std::string sameDevice;
+  std::string fallback;
+  if (followed == device && missing)
+  {
+    sameDevice = m_sink.ValidateOuputDevice(device, passthrough);
+    if (!CAESinkFactory::ParseDevice(sameDevice).IsSameDeviceAs(CAESinkFactory::ParseDevice(device)))
+      sameDevice.clear();
+    fallback = m_sink.FallbackOutput(passthrough);
+  }
+  std::string used = INTERNAL::OutputForSetting(device, followed, missing, sameDevice, fallback);
+
+  if (followedOut)
+    *followedOut = followed;
+  if (missingOut)
+    *missingOut = missing;
+  if (sameCardOut)
+    *sameCardOut = !sameDevice.empty() && used == sameDevice;
+  return used;
+}
+
 std::string CActiveAE::FollowDisplay(const std::string& device,
                                      std::string& followedBefore,
+                                     std::string& inPlaceBefore,
                                      bool passthrough) const
 {
+  std::string followed;
   bool missing = false;
-  std::string followed = m_sink.FollowDisplay(device, followedBefore, passthrough, &missing);
+  bool sameCard = false;
+  const std::string used =
+      ResolveOutput(device, followedBefore, passthrough, &followed, &missing, &sameCard);
   if (followed != device && followed != followedBefore)
     CLog::Log(LOGINFO,
               "ActiveAE - the configured {} output '{}' {}: using '{}', the only output with a "
@@ -3005,7 +3042,20 @@ std::string CActiveAE::FollowDisplay(const std::string& device,
   // output, or what ValidateOutputDevices() took for a device that is not there: neither may be
   // kept against a change of the setting while no output has a display.
   followedBefore = followed != device ? followed : std::string();
-  return followed;
+
+  if (used != followed)
+  {
+    if (used != inPlaceBefore)
+      CLog::Log(LOGINFO,
+                "ActiveAE - the configured {} output '{}' is not there in this start: using '{}' "
+                "in its place{} (the setting is not changed)",
+                passthrough ? "passthrough" : "audio", device, used,
+                sameCard ? ", the same card" : ", the first output");
+    inPlaceBefore = used;
+  }
+  else
+    inPlaceBefore.clear();
+  return used;
 }
 
 void CActiveAE::ValidateOutputDevices(bool saveChanges)
@@ -3073,8 +3123,16 @@ void CActiveAE::HandleDeviceCountChange(const std::string& driver, bool defaultD
   m_sink.EnumerateSinkList(true, driver);
 
   const bool passthrough = m_mode == MODE_RAW;
-  const std::string configuredDevice =
-      passthrough ? m_settings.passthroughdevice : m_settings.device;
+  // Hades: decided with the output that the settings give with the outputs listed again (the
+  // configured one, the one it follows to, or the one in its place while it is not there:
+  // ResolveOutput()), not with the device that the last LoadSettings() chose with the outputs as
+  // they were: a configured output that comes back (Bluetooth headphones turned on) is the
+  // preferred one again, and an output in its place that stays is not reopened.
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const std::string configuredDevice = ResolveOutput(
+      settings->GetString(passthrough ? CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE
+                                      : CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE),
+      passthrough ? m_followedPassthroughDevice : m_followedDevice, passthrough);
   const AESinkDevice configured = CAESinkFactory::ParseDevice(configuredDevice);
   const std::string validatedDevice = m_sink.ValidateOuputDevice(configuredDevice, passthrough);
   const AESinkDevice validated = CAESinkFactory::ParseDevice(validatedDevice);
