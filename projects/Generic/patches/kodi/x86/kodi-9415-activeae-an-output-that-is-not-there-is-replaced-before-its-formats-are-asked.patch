+  std::string ResolveOutput(const std::string& device,
+                            const std::string& followedBefore,
+                            bool passthrough,
+                            std::string* followedOut = nullptr,
+                            bool* missingOut = nullptr,
+                            bool* sameCardOut = nullptr) const;
   void ValidateOutputDevices(bool saveChanges);
   //! Hades: m_settings.channels limited to the channels of PCM that the display of the device takes
   //! (see the definition)
@@ -368,6 +382,10 @@ protected:
   //! configured output is the one in use.
   std::string m_followedDevice;
   std::string m_followedPassthroughDevice;
+  //! The outputs used in place of the two configured ones while those are not there (see
+  //! FollowDisplay()), empty while they are
+  std::string m_inPlaceOfDevice;
+  std::string m_inPlaceOfPassthroughDevice;
   //! What LimitChannelsToDisplay() last logged (device, setting and channels), empty when it did
   //! not limit anything
   std::string m_channelsLimitTold;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h
index 0fc6c5f..9acd65a 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h
@@ -98,4 +98,43 @@ inline int FollowedDisplayOutput(const std::vector<FollowCandidate>& outputs,
   }
   return -1;
 }
+
+/*!
+ * \brief Hades: the device that the engine uses for a configured output, once it is known whether
+ * it is followed away from (CActiveAE::FollowDisplay())
+ * \param configured the device of the setting
+ * \param followed the device that CActiveAESink::FollowDisplay() gives for it
+ * \param missing the outputs that the engine listed in this start do not include the configured one
+ * \param sameDevice the output that Kodi validates the configured one to
+ *        (CActiveAESink::ValidateOuputDevice()) when Kodi takes it for the same device (the same
+ *        driver and card name: AESinkDevice::IsSameDeviceAs()); empty otherwise
+ * \param fallback the output that the sink opens when the one asked for cannot be opened
+ *        (CActiveAESink::FallbackOutput()); empty when none
+ * \return the device to use
+ *
+ * Every stream loads the settings again, and took a configured output that is not there again: it
+ * tried to open it, and the sink fell back to the first output of the list (or the one with the
+ * display in its place); but the formats that may pass through, and how many channels of PCM the
+ * display takes, were asked of the configured output, whose formats are not known, so nothing passed
+ * through (Dolby TrueHD decoded in every stream of a session of 2026-10-17, until the output was
+ * chosen again in the settings). That output is now chosen before, so that all of it is about the
+ * output in use: where the streams went is not changed. An output with the same card name is taken
+ * for the configured one renamed, as Kodi does when it starts (it saved it in the setting then; the
+ * setting is now not written). When the output is there again (a change of the outputs lists them
+ * again), it is used again.
+ */
+inline std::string OutputForSetting(const std::string& configured,
+                                    const std::string& followed,
+                                    bool missing,
+                                    const std::string& sameDevice,
+                                    const std::string& fallback)
+{
+  if (followed != configured || !missing)
+    return followed;
+  if (!sameDevice.empty())
+    return sameDevice;
+  if (!fallback.empty())
+    return fallback;
+  return configured;
+}
 } // namespace ActiveAE::INTERNAL
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index 3cdba83..4e0494f 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -891,9 +891,24 @@ std::string CActiveAESink::FollowDisplay(const std::string& device,
       *missing = !there;
     return other >= 0 ? sink.m_deviceInfoList[other].ToDeviceString(sink.m_sinkName) : device;
   }
+  // (a driver that lists no output, or none in this start)
+  if (missing)
+    *missing = true;
   return device;
 }
 
+// Hades: as OpenSink() falls back
+std::string CActiveAESink::FallbackOutput(bool passthrough) const
+{
+  if (m_sinkInfoList.empty() || m_sinkInfoList.front().m_deviceInfoList.empty())
+    return {};
+
+  const AE::AESinkInfo& firstSink = m_sinkInfoList.front();
+  const CAEDeviceInfo& first = firstSink.m_deviceInfoList.front();
+  const CAEDeviceInfo* other = DisplayOutputInstead(firstSink, first, passthrough);
+  return (other ? *other : first).ToDeviceString(firstSink.m_sinkName);
+}
+
 std::string CActiveAESink::ValidateOuputDevice(const std::string& device, bool passthrough) const
 {
   if (m_sinkInfoList.empty())
@@ -1115,7 +1130,7 @@ void CActiveAESink::OpenSink()
     m_sink = CAESinkFactory::Create(device, m_sinkFormat);
 
     // try first device in out list (or the output with the display in its place, as
-    // FollowDisplay() does)
+    // FollowDisplay() does; FallbackOutput() is this choice)
     if (!m_sink && !m_sinkInfoList.empty() && !m_sinkInfoList.front().m_deviceInfoList.empty())
     {
       const AE::AESinkInfo& firstSink = m_sinkInfoList.front();
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
