    */
   std::string FollowDisplay(const std::string& device,
                             const std::string& followed,
                             bool passthrough,
                             bool* missing = nullptr) const;
+  //! Hades: the output that OpenSink() opens when the one asked for cannot be opened: the first
+  //! output of the list, or the output with the display in its place; empty when none
+  std::string FallbackOutput(bool passthrough) const;
   void Start();
