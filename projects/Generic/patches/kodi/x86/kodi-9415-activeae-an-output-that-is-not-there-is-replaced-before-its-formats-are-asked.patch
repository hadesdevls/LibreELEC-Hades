   AEDeviceType GetDeviceType(const std::string &device);
diff --git a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp
index 22cee45..7394644 100644
--- a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp
@@ -15,6 +15,7 @@
 
 using ActiveAE::INTERNAL::FollowCandidate;
 using ActiveAE::INTERNAL::FollowedDisplayOutput;
+using ActiveAE::INTERNAL::OutputForSetting;
 
 namespace
 {
@@ -140,3 +141,41 @@ TEST(TestActiveAEFollowDisplay, ADriverWithoutOutputs)
 {
   EXPECT_EQ(-1, FollowedDisplayOutput({}, "hdmi:CARD=PCH,DEV=0", true, ""));
 }
+
+// The setting of a session of 2026-10-17, started with the dedicated graphics only: the HDMI output
+// of the integrated graphics (the card "HDMI") is not there; there are displays on three outputs of
+// the NVIDIA graphics (not followed: the choice stays with the user), and the sink fell back to the
+// first output of the list, the first HDMI output of the NVIDIA graphics
+namespace
+{
+const std::string NOT_THERE = "ALSA:hdmi:CARD=HDMI,DEV=0|HDA ATI";
+const std::string FIRST = "ALSA:hdmi:CARD=NVidia,DEV=0|HDA NVidia";
+const std::string RENAMED = "ALSA:hdmi:CARD=HDMI_1,DEV=0|HDA ATI";
+} // namespace
+
+TEST(TestActiveAEFollowDisplay, AConfiguredOutputThatIsNotThereIsTheOneTheSinkFellBackTo)
+{
+  EXPECT_EQ(FIRST, OutputForSetting(NOT_THERE, NOT_THERE, true, "", FIRST));
+}
+
+TEST(TestActiveAEFollowDisplay, TheSameCardRenamedComesFirst)
+{
+  EXPECT_EQ(RENAMED, OutputForSetting(NOT_THERE, NOT_THERE, true, RENAMED, FIRST));
+}
+
+TEST(TestActiveAEFollowDisplay, AConfiguredOutputThatIsThereStays)
+{
+  EXPECT_EQ(FIRST, OutputForSetting(FIRST, FIRST, false, RENAMED, NOT_THERE));
+}
+
+TEST(TestActiveAEFollowDisplay, AnOutputFollowedToIsKept)
+{
+  const std::string followed = "ALSA:hdmi:CARD=NVidia,DEV=1|HDA NVidia";
+  EXPECT_EQ(followed, OutputForSetting(NOT_THERE, followed, true, RENAMED, FIRST));
+}
+
+TEST(TestActiveAEFollowDisplay, NoOutputListedKeepsTheConfiguredOne)
+{
+  // (no output listed at all: the engine opens what it can, as before)
+  EXPECT_EQ(NOT_THERE, OutputForSetting(NOT_THERE, NOT_THERE, true, "", ""));
+}
