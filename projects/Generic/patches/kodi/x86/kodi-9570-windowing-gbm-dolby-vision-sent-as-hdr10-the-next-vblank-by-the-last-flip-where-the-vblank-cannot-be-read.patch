+
+#pragma once
+
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: where the vblanks of the output are, for the first picture of a scene of Dolby
+ *        Vision sent as HDR10+ that waits for its own measurement until a margin before the next
+ *        one (dvbridge_dvplus_wait_budget())
+ *
+ * The vblank ioctl tells the time of the last vblank where the driver has vblanks (amdgpu, i915);
+ * nvidia-drm has none with its defaults. Every driver flips with the out-fence of its commit, and
+ * that fence is signalled at the flip with the kernel's time of it (CLOCK_MONOTONIC, as the
+ * vblank's): the flips of the output are on the grid of its vblanks. So: the vblank where it can
+ * be read, else the last flip whose time was read, with the period of the mode it flipped in. A
+ * flip anchors the grid again (every one: none drifts from it), and nothing is taken from a flip
+ * after a flip that did not come or whose time could not be read, after a change of mode (or of
+ * the period), or after a new video, until the next one comes.
+ *
+ * Only what is decided is here, with nothing of DRM in it, so that a test can run it.
+ */
+class CDVPlusClock
+{
+public:
+  enum class Source
+  {
+    NONE, //!< nothing tells where the vblanks are: the picture does not wait
+    VBLANK, //!< the vblank ioctl
+    FLIP, //!< the last flip
+  };
+
+  //! A flip came at ns (the time of its out-fence), in a mode of this period (ns); 0 or less: its
+  //! time could not be read, which is as a flip that did not come
+  void Flipped(int64_t ns, int64_t period)
+  {
+    if (ns <= 0 || period <= 0)
+    {
+      Lost();
+      return;
+    }
+    m_flip = ns;
+    m_period = period;
+  }
+
+  //! A flip did not come, a change of mode, a new video: nothing of the flips before counts
+  void Lost()
+  {
+    m_flip = 0;
+    m_period = 0;
+  }
+
+  /*!
+   * \brief The time of a vblank of the output to count the next one from (0: none), and from what
+   * \param vblank the time of the last vblank that the ioctl gave (0: it gave none)
+   * \param period the period of the mode now (ns)
+   */
+  int64_t Anchor(int64_t vblank, int64_t period, Source* source) const
+  {
+    if (vblank > 0 && period > 0)
+    {
+      *source = Source::VBLANK;
+      return vblank;
+    }
+    if (m_flip > 0 && period > 0 && period == m_period)
+    {
+      *source = Source::FLIP;
+      return m_flip;
+    }
+    *source = Source::NONE;
+    return 0;
+  }
+
+private:
+  int64_t m_flip = 0;
+  int64_t m_period = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 40c8a24..5d79487 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -766,8 +766,9 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         if (fd != -1)
         {
 #ifdef HAVE_DVBRIDGE
-          // Hades: (EGL takes this fence; a copy of it says when that flip came, CPresentLag)
-          if (m_videoLagPendingNs > 0)
+          // Hades: (EGL takes this fence; a copy of it says when that flip came, CPresentLag; and,
+          // for Dolby Vision sent as HDR10+, where the vblanks are: m_dvPlusClock)
+          if (m_videoLagPendingNs > 0 || m_dvPlusOn == 1)
             lagFd = dup(fd);
 #endif
           m_eglFence->CreateKMSFence(fd);
@@ -799,13 +800,27 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 #ifdef HAVE_DVBRIDGE
           // Hades: when the flip of the frame before came, against the player's clock (it has
           // come: the copy of its fence is read at once, and closed)
-          if (int64_t flippedNs = 0;
-              lagFd >= 0 && WaitFence(std::exchange(lagFd, -1), 0, &flippedNs) && flippedNs > 0)
-            m_videoLag.Add(CPresentLag::Way::ORDINARY, m_videoLagPendingNs, flippedNs);
+          if (lagFd >= 0)
+          {
+            int64_t flippedNs = 0;
+            if (WaitFence(std::exchange(lagFd, -1), 0, &flippedNs) && flippedNs > 0 &&
+                m_videoLagPendingNs > 0)
+              m_videoLag.Add(CPresentLag::Way::ORDINARY, m_videoLagPendingNs, flippedNs);
+            // (Hades: the vblank it came at anchors the grid of the next ones; a time that cannot
+            // be read takes the anchor away)
+            if (m_dvPlusOn == 1)
+              m_dvPlusClock.Flipped(flippedNs, DVPlusPeriodNs());
+          }
+#endif
+        }
+        else
+        {
+#ifdef HAVE_DVBRIDGE
+          m_dvPlusClock.Lost(); // (Hades: a flip that did not come times nothing)
 #endif
+          if (FlipStalled())
+            async = false;
         }
-        else if (FlipStalled())
-          async = false;
         m_DRM->SetInFenceFd(fd);
       }
 #endif
@@ -816,6 +831,12 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     // Hades: an output that FlipStalled() turned off and could not turn on again
     if (m_flipOutputOff)
       FlipOutputOn();
+#ifdef HAVE_DVBRIDGE
+    // Hades: a commit that changes the mode moves the vblanks: the flips before it count no more
+    if (const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+        atomic && atomic->ModesetPending())
+      m_dvPlusClock.Lost();
+#endif
     CWinSystemGbm::FlipPage(rendered, videoLayer, async);
 #ifdef HAVE_DVBRIDGE
     // Hades: the frame of this commit, whose flip comes before the next commit (async), or came
@@ -1889,10 +1910,20 @@ void CWinSystemGbmGLESContext::DVPlusEnd()
   m_dvPlusFrames = 0;
   m_dvPlusStartPts = DVD_NOPTS_VALUE;
   m_dvPlusStartsWaited = m_dvPlusStartsLate = m_dvPlusStartsNoTime = 0;
+  m_dvPlusStartsByVBlank = m_dvPlusStartsByFlip = 0;
   m_dvPlusNoVBlankTold = false;
+  m_dvPlusClock.Lost();
   m_dvPlusSending = false;
 }
 
+int64_t CWinSystemGbmGLESContext::DVPlusPeriodNs() const
+{
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  return mode && mode->clock && mode->htotal && mode->vtotal
+             ? static_cast<int64_t>(1e9 * mode->htotal * mode->vtotal / (mode->clock * 1000.0))
+             : 0;
+}
+
 void CWinSystemGbmGLESContext::DVPlusCollect()
 {
   // the samples that the GPU has finished, into the scenes of their pictures
@@ -1989,11 +2020,12 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
     dvbridge_dvplus_get_counts(m_dvPlus.get(), &c);
     CLog::Log(LOGINFO,
               "DVBridge: Dolby Vision sent as HDR10+: so far {} pictures with HDR10+ and {} without, "
-              "{} scenes ({} first pictures with their own measurement, {} not measured by the "
-              "vblank, {} without a vblank to wait by), {} changes within a scene, {} pictures "
