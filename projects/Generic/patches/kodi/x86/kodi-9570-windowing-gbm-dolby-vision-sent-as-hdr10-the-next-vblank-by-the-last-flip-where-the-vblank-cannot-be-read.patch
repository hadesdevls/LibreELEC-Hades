-              c.sent, c.unsent, c.scenes, m_dvPlusStartsWaited, m_dvPlusStartsLate,
-              m_dvPlusStartsNoTime, c.changes, c.measured, c.dropped,
+              "{} scenes ({} first pictures with their own measurement, {} timed by the vblank "
+              "and {} by the last flip; {} not measured by the next refresh, {} with nothing to "
+              "time it by), {} changes within a scene, {} pictures measured, {} dropped; now {}",
+              c.sent, c.unsent, c.scenes, m_dvPlusStartsWaited, m_dvPlusStartsByVBlank,
+              m_dvPlusStartsByFlip, m_dvPlusStartsLate, m_dvPlusStartsNoTime, c.changes,
+              c.measured, c.dropped,
               send ? StringUtils::Format("maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2",
                                          stats.average / 10.0, stats.percentiles[8] / 10.0)
                    : std::string("nothing (the frames go out as HDR10)"));
@@ -2060,23 +2092,23 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
   // dvbridge_dvplus_wait_budget(): the commit is then made by that vblank, as without waiting), and
   // goes out with its scene's own; where it does not come by then, as it was.
   m_dvPlusStartPts = DVD_NOPTS_VALUE;
-  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
-  const int64_t period =
-      mode && mode->clock && mode->htotal && mode->vtotal
-          ? static_cast<int64_t>(1e9 * mode->htotal * mode->vtotal / (mode->clock * 1000.0))
-          : 0;
-  const int64_t vblank = DVPlusLastVBlankNs();
+  // (the next vblank by the vblank ioctl, or where it has none, nvidia-drm with its defaults, by
+  // the last flip and the period of the mode: CDVPlusClock)
+  const int64_t period = DVPlusPeriodNs();
+  CDVPlusClock::Source timedBy = CDVPlusClock::Source::NONE;
+  const int64_t anchor = m_dvPlusClock.Anchor(DVPlusLastVBlankNs(), period, &timedBy);
   const int64_t budget =
-      dvbridge_dvplus_wait_budget(SteadyNowNs(), vblank, period, DVBRIDGE_DVPLUS_WAIT_MARGIN);
+      dvbridge_dvplus_wait_budget(SteadyNowNs(), anchor, period, DVBRIDGE_DVPLUS_WAIT_MARGIN);
   if (budget <= 0)
   {
     ++m_dvPlusStartsNoTime;
-    if (!vblank && !m_dvPlusNoVBlankTold)
+    if (timedBy == CDVPlusClock::Source::NONE && !m_dvPlusNoVBlankTold)
     {
       m_dvPlusNoVBlankTold = true;
-      CLog::Log(LOGINFO, "DVBridge: Dolby Vision sent as HDR10+: the vblanks of the output cannot "
-                         "be read, so the first picture of a scene does not wait for its own "
-                         "measurement: it goes out with the metadata of the scene before");
+      CLog::Log(LOGINFO, "DVBridge: Dolby Vision sent as HDR10+: neither the vblanks nor the flips "
+                         "of the output can be timed now, so the first picture of a scene does not "
+                         "wait for its own measurement: it goes out with the metadata of the scene "
+                         "before, until a flip is timed");
     }
     return;
   }
@@ -2094,6 +2126,7 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
   if (const auto payload = KODI::UTILS::HDR10PLUS::MakeVsif(made))
   {
     ++m_dvPlusStartsWaited;
+    ++(timedBy == CDVPlusClock::Source::VBLANK ? m_dvPlusStartsByVBlank : m_dvPlusStartsByFlip);
     SetHDR10Plus(payload);
   }
 }
