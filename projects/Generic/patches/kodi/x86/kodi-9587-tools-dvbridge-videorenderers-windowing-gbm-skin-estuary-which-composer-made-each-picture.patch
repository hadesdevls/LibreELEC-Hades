From 5cab227c8963b33e33432c966da4c4caeee09dba Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:40:31 +0000
Subject: [PATCH] tools/dvbridge, VideoRenderers, windowing/gbm, skin.estuary:
 which composer made each picture

A Dolby Vision picture is composed as the composer of ETSI GS CCM 001 does
by default, but libplacebo's own reshaping composes it where the composer
does not cover it (MMR on the luma, a layer of another size...) or failed on
the GPU, and the renderer accepted such a picture without saying so:
dvbridge_render_ccm_composer() is the setting, not what happened, and the
transport of such a frame showed as converted because it was "not possible
with this video".

dvbridge_render_composed() says how the last render composed its picture
(CCM 001, libplacebo's reshaping, or nothing), from libplacebo's
dovi_ccm_composed in the source transport, the converted one and the
picture for output as HDR10. Kodi takes it with each frame
(PresentedDetail::composed): the Dolby Vision page shows "Converted to
BT.2020 (libplacebo's reshaping)" for such a frame, the 10 s line of native
output counts its presentations, and the line of the pictures reconstructed
for output as HDR10 counts them too. The string is the one the setting of
the composition already has (#31912). Nothing drawn changes.

Tested with the render test of the bridge on Mesa's zink (6 pictures of a
profile 7 FEL stream): each of the 36 composed pictures says CCM 001 with
the default and libplacebo's reshaping with DV_CCM=0; with render() made to
say CCM 001 for every picture (a mutation), 36 of 36 are caught. The other
lines of the test, and the skin check, unchanged.
---
 addons/skin.estuary/xml/Variables.xml              |  2 ++
 tools/dvbridge/dvbridge_render.c                   | 14 ++++++++++++++
 tools/dvbridge/dvbridge_render.h                   | 10 ++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.cpp    |  8 ++++++--
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h      |  6 ++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp     | 12 ++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h       |  2 ++
 7 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 24ef019..3bf1a0a 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -853,7 +853,9 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),lowlatency)">$LOCALIZE[31925]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source) + String.IsEqual(Window(Home).Property(hades.dv.signal),ictcp)">$LOCALIZE[32002] (ICtCp)</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source)">$LOCALIZE[32002] (YCbCr)</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),fallback) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$LOCALIZE[32003] ($LOCALIZE[31912])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),fallback)">$LOCALIZE[32003] ($LOCALIZE[32004])</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$LOCALIZE[32003] ($LOCALIZE[31912])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020)">$LOCALIZE[32003]</value>
 	</variable>
 	<variable name="HadesDVDisplayVar">
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 7f78d6b..1147710 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -90,6 +90,8 @@ struct dvbridge_renderer {
     /* Hades: the base layer is SDR, in BT.1886 (dvbridge_render_set_base_sdr()); the last render of
      * such a picture was not composed so (base_sdr_refused) */
     bool base_sdr, base_sdr_refused;
+    /* Hades: how the last render composed its picture (dvbridge_render_composed()) */
+    int composed;
     /* Hades: the transport state that the candidates are prepared from: that of another renderer
      * during dvbridge_render_reference(), else NULL (this renderer's own context) */
     const struct dvbridge_context *serializer;
@@ -924,6 +926,7 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
     bool ok = pl_render_image(r->renderer, &image, &frame, &params) && *composed;
     /* Hades: a base layer in BT.1886 is composed as clause 5.5 says or not at all */
     r->base_sdr_refused = r->base_sdr && !*composed;
+    r->composed = ok ? DVBRIDGE_COMPOSED_CCM : DVBRIDGE_COMPOSED_NONE;
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
     ok = ok && !errors.errors && !errors.num_disabled_hooks;
     const unsigned composed_luma = ok ? pl_opengl_unwrap(r->gpu, r->planes[0], NULL, NULL, NULL) : 0;
@@ -1173,6 +1176,9 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     time_render(r, &params);
     r->ready = pl_render_image(r->renderer, &image, &target, &params) && mask.called && !mask.failed;
     r->base_sdr_refused = r->base_sdr && !ccm_composed;
+    r->composed = !r->ready      ? DVBRIDGE_COMPOSED_NONE
+                  : ccm_composed ? DVBRIDGE_COMPOSED_CCM
+                                 : DVBRIDGE_COMPOSED_RESHAPING;
     /* An EL sampling failure can otherwise return a successfully rendered BL-only frame. A composer of
      * ETSI GS CCM 001 that failed on this GPU is not one: libplacebo composed the picture by its own
      * reshaping, as with it turned off, and said so in the log. */
@@ -1750,6 +1756,9 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
     ok = ok && !(errors.errors & ~PL_RENDER_ERR_DOVI_COMPOSER) && !errors.num_disabled_hooks;
     r->base_sdr_refused = r->base_sdr && !plain && !ccm_composed;
+    r->composed = !ok || plain   ? DVBRIDGE_COMPOSED_NONE
+                  : ccm_composed ? DVBRIDGE_COMPOSED_CCM
+                                 : DVBRIDGE_COMPOSED_RESHAPING;
     if (ok) {
         r->hdr10_shown = into;
         r->hdr10_whole = true;
@@ -1901,6 +1910,11 @@ void dvbridge_render_set_base_sdr(struct dvbridge_renderer *r, bool sdr)
         r->base_sdr = sdr;
 }
 
+int dvbridge_render_composed(const struct dvbridge_renderer *r)
+{
+    return r ? r->composed : DVBRIDGE_COMPOSED_NONE;
+}
+
 bool dvbridge_render_base_sdr_refused(const struct dvbridge_renderer *r)
 {
     return r && r->base_sdr_refused;
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index d329547..ecec276 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -265,6 +265,16 @@ bool dvbridge_render_ccm_composer(const struct dvbridge_renderer *renderer);
  * reshaping, as before, to compare on hardware. A picture outside the clause's scope is composed
  * by libplacebo's reshaping either way (libplacebo logs why). */
 void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *renderer, bool use);
+/* Hades: how the picture of the last render was composed, which is not always what was asked for
+ * (dvbridge_render_use_ccm_composer()): DVBRIDGE_COMPOSED_CCM as the composer of ETSI GS CCM 001
+ * composes it; DVBRIDGE_COMPOSED_RESHAPING by libplacebo's own reshaping, which the setting asks for,
+ * or where the composer does not cover the picture (MMR on the luma, a layer of another size...:
+ * libplacebo logs why) or failed on the GPU; DVBRIDGE_COMPOSED_NONE before a render, after one that
+ * failed, and for a picture that is no Dolby Vision one (dvbridge_render_plain()). */
+#define DVBRIDGE_COMPOSED_NONE 0
+#define DVBRIDGE_COMPOSED_CCM 1
+#define DVBRIDGE_COMPOSED_RESHAPING 2
+int dvbridge_render_composed(const struct dvbridge_renderer *renderer);
 /* Hades: the base layer of the pictures that follow is SDR, in Recommendation ITU-R BT.1886 (a Dolby
  * Vision configuration with base layer signal compatibility 2: profile 8.2). ETSI GS CCM 001 then
  * composes its samples at 14 bits and converts them to SMPTE ST 2084 (clause 5.5), which libplacebo
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 965d559..4064d18 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -641,6 +641,7 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
     m_pendingDetail.layerNotDecoded = !enhancement && m_layerNotDecoded;
     m_pendingDetail.fel = fel;
     m_pendingDetail.felWithoutLayer = omitted;
+    m_pendingDetail.composed = dvbridge_render_composed(m_renderer);
     // Hades: how it goes out; why it goes out converted where the other is asked for, once for each
     // reason (a scaled picture, one that libplacebo does not compose as CCM 001 does...)
     const char* why = nullptr;
@@ -1448,6 +1449,8 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
     const bool omitted = dvbridge_render_residual_omitted(m_renderer);
     const bool fel = layered && dvbridge_render_residual_drawn(m_renderer);
     m_convertEpoch = epoch;
+    m_convertComposed = dvbridge_render_composed(m_renderer);
+    m_convertedReshaped += m_convertComposed == DVBRIDGE_COMPOSED_RESHAPING ? 1 : 0;
     m_convertView = view;
     m_convertWidth = width;
     m_convertHeight = height;
@@ -1608,12 +1611,13 @@ void CDVBridgeGLES::LogConversion() const
   if (m_converted || m_convertFailed)
     CLog::Log(LOGINFO,
               "DVBridge: {} pictures were reconstructed for output {}, {} of them with the "
-              "residual of their enhancement layer; {} could not be",
+              "residual of their enhancement layer, {} composed by libplacebo's reshaping (not as "
+              "ETSI GS CCM 001 composes them); {} could not be",
               m_converted,
               m_convertMapping.enabled && m_convertMapping.target == DVBRIDGE_HDR10_TARGET_SDR
                   ? "as SDR"
                   : "as HDR10",
-              m_convertedFel, m_convertFailed);
+              m_convertedFel, m_convertedReshaped, m_convertFailed);
 }
 
 void CDVBridgeGLES::SetConversionTarget(unsigned int framebuffer, bool limited)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 2f24816..d19cdef 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -149,6 +149,8 @@ public:
     bool layerNotDecoded = false; //!< Hades: that layer was not decoded: no residual (MEL)
     bool fel = false; //!< the enhancement layer reconstructs residuals (NLQ active)
     bool felWithoutLayer = false; //!< FEL drawn without its residual (layer resynchronizing)
+    //! Hades: how the picture was composed (dvbridge_render_composed(): DVBRIDGE_COMPOSED_*)
+    int composed = 0;
     bool cm4 = false; //!< content mapping v4.0 levels are present
     //! Hades: the v4.0 part of its content mapping was left out for a display of display
     //! management 2 or 3: that version (0: nothing was left out)
@@ -358,6 +360,8 @@ public:
   //! copies), its size, and the place of the picture in it (from its top left): for what measures it
   //! (Dolby Vision sent as HDR10+). false when there is none.
   bool ConversionPicture(unsigned int& texture, int& width, int& height, dvbridge_view& place) const;
+  //! Hades: how the last picture that was reconstructed was composed (DVBRIDGE_COMPOSED_*)
+  int ConversionComposed() const { return m_convertComposed; }
   /*!
    * \brief What an HDR10 output is told of such a picture
    * \param[out] output the picture as it is sent: PQ, BT.2020, 10 bits; the luminance of the
@@ -472,6 +476,8 @@ private:
   unsigned int m_convertedFel = 0; //!< ... with the residual of their enhancement layer
   unsigned int m_convertFailed = 0; //!< ... that could not be
   const char* m_convertLayers = ""; //!< see ConversionLayers()
+  int m_convertComposed = 0; //!< see ConversionComposed()
+  unsigned int m_convertedReshaped = 0; //!< ... of them composed by libplacebo's reshaping
   dvbridge_hdr10_mapping m_convertMapping{}; //!< see SetConversionMapping()
   bool m_convertMappingSet = false;
   //! Hades: the pictures are kept as 10-bit codes (SetConversionTarget()); -1 before it is told
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 8be0326..f72100b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -636,6 +636,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
           const auto& detail = m_dvBridge->GetPresentedDetail();
           m_dvStats.fel += detail.fel ? 1 : 0;
           m_dvStats.felWithoutLayer += detail.felWithoutLayer ? 1 : 0;
+          m_dvStats.reshaped += detail.composed == DVBRIDGE_COMPOSED_RESHAPING ? 1 : 0;
         }
       }
       else
@@ -3609,6 +3610,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.l5sent", ""}, {"hades.dv.l5origin", ""}, {"hades.dv.depth", ""},
       {"hades.dv.depthformat", ""}, {"hades.dv.depthwhy", ""},
       {"hades.dv.transport", ""}, {"hades.dv.signal", ""}, {"hades.dv.cmsent", ""},
+      {"hades.dv.composer", ""},
       {"hades.dv.trims", ""}, {"hades.dv.origin", ""}, {"hades.dv.hdr10plus", ""}};
   // Hades: a picture rebuilt as HDR10 goes out with HDR10+ metadata measured from it
   // (DVConversionHDR10Plus())
@@ -3714,6 +3716,9 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       // the picture when the RPU has none
       info["hades.dv.l5origin"] = d.sentL5Drawn ? "drawn" : d.l5[0] >= 0 ? "rpu" : "picture";
     }
+    // Hades: how the picture was composed, where it was not as CCM 001 composes it
+    if (d.composed == DVBRIDGE_COMPOSED_RESHAPING)
+      info["hades.dv.composer"] = "reshaping";
     // Hades: how the signal is sent
     info["hades.dv.transport"] = d.transport == 0   ? "source"
                                  : d.transport == 1 ? "bt2020"
@@ -4875,6 +4880,7 @@ void CWinSystemGbmGLESContext::KeepDVBridgeFrame()
     const auto& detail = m_dvBridge->GetPresentedDetail();
     m_dvStats.fel += detail.fel ? 1 : 0;
     m_dvStats.felWithoutLayer += detail.felWithoutLayer ? 1 : 0;
+    m_dvStats.reshaped += detail.composed == DVBRIDGE_COMPOSED_RESHAPING ? 1 : 0;
   }
   if (m_dvSignalling && end - m_dvStats.start >= std::chrono::seconds(10))
     LogDVStats("last 10 s");
@@ -5031,6 +5037,12 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   // Hades: when the flips came against the player's clock, per way (CPresentLag)
   if (const std::string lag = m_dvLag.Text(LagLatencyMs()); !lag.empty())
     ioctls += "; " + lag;
+  // Hades: pictures that the composer of CCM 001 did not compose (libplacebo logs why)
+  if (m_dvStats.reshaped)
+    ioctls = StringUtils::Format("; {} presentations of pictures composed by libplacebo's reshaping, "
+                                 "not as ETSI GS CCM 001 composes them",
+                                 m_dvStats.reshaped) +
+             ioctls;
   m_dvLag.Reset();
   // Hades: the GPU time of each pass, where advancedsettings.xml asks for it (dvpasstimes)
   std::vector<dvbridge_pass_time> passes;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 2448f20..0c39961 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -536,6 +536,8 @@ private:
     double flipGapMaxMs = 0;
     unsigned int fel = 0; //!< presentations with the FEL residual reconstructed
     unsigned int felWithoutLayer = 0; //!< FEL presentations without it (resynchronizing)
+    //! Hades: presentations of a picture composed by libplacebo's reshaping, not as CCM 001 does
+    unsigned int reshaped = 0;
     unsigned int gpuFrames = 0;
     double gpuSumMs = 0;
     double gpuMaxMs = 0;
