From bbe2a21b35e161a76b320ec6062759d2d66b36c5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:36:34 +0000
Subject: [PATCH] dvbridge: an HLG picture is drawn to ST 2084 and measured as
 such, for HLG sent as Dolby Vision

HLG sent as Dolby Vision (videoscreen.hadeshlgasdv, the next commit) is profile 8.1 over a
picture in ST 2084 that libplacebo makes of the HLG picture, not a profile 8.4 with a
synthesized reshaping: in a real 8.4 the reshaping of the RPU is what takes the HLG signal to
PQ, and coefficients made up to do that would only approximate the OOTF of BT.2100.

DVBRIDGE_BASE_HLG_TO_PQ is a new base transfer of the renderer. The picture is drawn by the
converted transport, never the source transport (its composer takes the picture for one in ST
2084): libplacebo takes the BT.2020 HLG planes to BT.2020 in ST 2084 as the BT.2100 reference
display of DVBRIDGE_HLG_NOMINAL_PEAK = 1000 cd/m2 shows them (the inverse OETF, then the OOTF with
the system gamma 1.2 at that peak; the peak is the same on both sides, so nothing is tone mapped).
1000 cd/m2 is the nominal peak of the reference display of BT.2100 (table 5), where the gamma
needs no extension, and with BT.2408 it puts reference white (HLG 0.75) at 203 cd/m2, the white of
HDR10 graphics. The display maps it from there with the metadata it is sent. A picture with an
enhancement layer is not drawn.

dvbridge_measure_submit_ex() measures the picture as it goes out: each pixel's R'G'B' taken from
HLG to PQ the same way, before the 2x2 means of level 1. dvbridge_measure_submit() is as it was.
dvbridge_measured_placeholder_hlg() makes the metadata that such a picture carries before it is
measured (profile 8.1, the identity mapping, a source of 1000 cd/m2 and a black of 0).

Checked on Mesa's software OpenGL ES (zink on llvmpipe) with synthetic 3840x2160 pictures (grey
steps, shadows, colour bars): against an independent float64 computation of BT.2100, 6912 points
a picture within 0.11 codes of 10 bits of PQ and level 1 within 0.02 codes of 12 bits; the same
independent check fails by 317 codes on a picture that is drawn as PQ. The transport and the
picture of every other video are byte for byte the same as before (FNV-1a of both, the source
and the converted transport). The metadata read field by field as profile 8.1 with the identity
composer, a level 1 block and a level 6 block of 1000 cd/m2.
---
 tools/dvbridge/dvbridge_measure.c  | 34 +++++++++++++++++++++--
 tools/dvbridge/dvbridge_measure.h  |  7 +++++
 tools/dvbridge/dvbridge_measured.c | 10 +++++++
 tools/dvbridge/dvbridge_measured.h |  5 ++++
 tools/dvbridge/dvbridge_render.c   | 44 +++++++++++++++++++++++++++---
 tools/dvbridge/dvbridge_render.h   | 18 +++++++++++-
 6 files changed, 111 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_measure.c b/tools/dvbridge/dvbridge_measure.c
index 6a32ea7..6882f88 100644
--- a/tools/dvbridge/dvbridge_measure.c
+++ b/tools/dvbridge/dvbridge_measure.c
@@ -26,13 +26,34 @@ static const char VERTEX[] = "#version 300 es\n"
 /* The block (2x2 pixels) of block column c and block row r: the means of its R'G'B' (BT.2020, from 10-bit limited
  * range YCbCr, each pixel's components clamped to [0, 1] before the mean, as l1stats.py and framestats.c), max and
  * min of them. P010: the 10 bits are the top of 16. The chroma sample of a 4:2:0 block is the block's own. */
+/* Hades: an HLG picture sent as Dolby Vision (dvbridge_measure_submit_ex()) is measured as the picture that goes
+ * out: the HLG signal of a pixel taken to ST 2084 as libplacebo does it for a display of 1000 cd/m2 whose black
+ * is below PL_COLOR_HDR_BLACK (pl_shader_linearize() for HLG: the inverse OETF of BT.2100 / ARIB STD-B67 and
+ * the OOTF, the system gamma 1.2 at that peak; pl_shader_delinearize() for PQ). A signal that is not HLG is
+ * used as it is. */
+#define HLG_TO_PQ                                                                                              \
+    "float hlg_e(float s) {\n"                                                                                \
+    "  return s > 0.5 ? (exp((s - 0.55991073) / 0.17883277) + 0.28466892) / 12.0 : s * s / 3.0;\n"            \
+    "}\n"                                                                                                     \
+    "vec3 pq_of(vec3 nits) {\n"                                                                               \
+    "  vec3 y = pow(nits / 10000.0, vec3(0.1593017578125));\n"                                                \
+    "  return pow((vec3(0.8359375) + 18.8515625 * y) / (vec3(1.0) + 18.6875 * y), vec3(78.84375));\n"         \
+    "}\n"                                                                                                     \
+    "vec3 hlg_to_pq(vec3 s) {\n"                                                                              \
+    "  vec3 e = vec3(hlg_e(s.r), hlg_e(s.g), hlg_e(s.b));\n"                                                  \
+    "  float ys = dot(vec3(0.2627, 0.6780, 0.0593), e);\n"                                                    \
+    "  return pq_of(1000.0 * pow(max(ys, 0.0), 0.2) * e);\n"                                                  \
+    "}\n"
+
 #define BLOCK                                                                                                  \
+    HLG_TO_PQ                                                                                                  \
     "float code(float v) { return floor(v * 65535.0 / 64.0 + 0.5); }\n"                                      \
     "vec3 rgb(float y, vec2 c) {\n"                                                                           \
     "  float yn = (y - 64.0) / 876.0;\n"                                                                      \
     "  vec2 p = (c - 512.0) / 896.0;\n"                                                                       \
-    "  return clamp(vec3(yn + 1.4746 * p.y, yn - (0.0593 * 1.8814 / 0.6780) * p.x - (0.2627 * 1.4746 / 0.6780) " \
+    "  vec3 s = clamp(vec3(yn + 1.4746 * p.y, yn - (0.0593 * 1.8814 / 0.6780) * p.x - (0.2627 * 1.4746 / 0.6780) " \
     "* p.y, yn + 1.8814 * p.x), 0.0, 1.0);\n"                                                                 \
+    "  return hlg != 0 ? hlg_to_pq(s) : s;\n"                                                                 \
     "}\n"                                                                                                     \
     "vec2 block(int c, int r) {\n"                                                                            \
     "  vec2 ch = texelFetch(chroma, ivec2(c, r), 0).rg;\n"                                                    \
@@ -53,6 +74,7 @@ static const char VERTEX[] = "#version 300 es\n"
     "uniform sampler2D luma;\n"                                                                               \
     "uniform sampler2D chroma;\n"                                                                             \
     "uniform ivec4 geo; /* blocks_w, blocks_h, the window's first and end block columns */\n"                 \
+    "uniform int hlg; /* the picture is HLG, measured as ST 2084 (HLG sent as Dolby Vision) */\n"             \
     "out vec4 o;\n"
 
 /* rows: fragment (band b, block row r) */
@@ -94,7 +116,7 @@ struct slot {
 
 struct dvbridge_measure {
     GLuint programs[2], vertex_array;
-    GLint geo[2], luma[2], chroma[2];
+    GLint geo[2], luma[2], chroma[2], hlg[2];
     struct slot slots[SLOTS];
     unsigned next_order;
     float *columns; /* (the column values in the order dvbridge_measured_raw has them) */
@@ -162,6 +184,7 @@ struct dvbridge_measure *dvbridge_measure_create(void)
             m->geo[i] = glGetUniformLocation(m->programs[i], "geo");
             m->luma[i] = glGetUniformLocation(m->programs[i], "luma");
             m->chroma[i] = glGetUniformLocation(m->programs[i], "chroma");
+            m->hlg[i] = glGetUniformLocation(m->programs[i], "hlg");
         }
     glGenVertexArrays(1, &m->vertex_array);
     dvbridge_gl_state_restore(&state);
@@ -227,6 +250,12 @@ static bool slot_make(struct slot *s, int bw, int bh)
 
 bool dvbridge_measure_submit(struct dvbridge_measure *m, unsigned luma, unsigned chroma, int width, int height,
                              const int window[2], double pts, uint64_t tag)
+{
+    return dvbridge_measure_submit_ex(m, luma, chroma, width, height, window, pts, tag, false);
+}
+
+bool dvbridge_measure_submit_ex(struct dvbridge_measure *m, unsigned luma, unsigned chroma, int width, int height,
+                                const int window[2], double pts, uint64_t tag, bool hlg)
 {
     if (!m || !luma || !chroma || width < 2 * DVBRIDGE_MEASURED_BANDS || height < 2 * DVBRIDGE_MEASURED_ROW_GROUPS ||
         width > 4096 || height > 2304 || !window || window[0] < 0 || window[1] > width / 2 || window[0] >= window[1])
@@ -269,6 +298,7 @@ bool dvbridge_measure_submit(struct dvbridge_measure *m, unsigned luma, unsigned
             glUniform1i(m->luma[i], 0);
             glUniform1i(m->chroma[i], 1);
             glUniform4i(m->geo[i], bw, bh, window[0], window[1]);
+            glUniform1i(m->hlg[i], hlg ? 1 : 0);
             glBindFramebuffer(GL_FRAMEBUFFER, s->framebuffers[i]);
             glViewport(0, 0, size[i][0], size[i][1]);
             glDrawArrays(GL_TRIANGLES, 0, 3);
diff --git a/tools/dvbridge/dvbridge_measure.h b/tools/dvbridge/dvbridge_measure.h
index 918d567..cf9e631 100644
--- a/tools/dvbridge/dvbridge_measure.h
+++ b/tools/dvbridge/dvbridge_measure.h
@@ -31,6 +31,13 @@ void dvbridge_measure_destroy(struct dvbridge_measure *m);
  * false: not queued (every slot is in flight, or GL failed: the picture is not measured). */
 bool dvbridge_measure_submit(struct dvbridge_measure *m, unsigned luma, unsigned chroma, int width, int height,
                              const int window[2], double pts, uint64_t tag);
+/* Hades: the same for the picture of an HLG video that is sent as Dolby Vision (hlg: DVBRIDGE_BASE_HLG_TO_PQ of
+ * dvbridge_render.h). It is measured as the picture that goes out is: each pixel's R'G'B' (BT.2020, from the
+ * limited range YCbCr) taken from HLG to ST 2084 through the HLG system of BT.2100 for a display of 1000 cd/m2
+ * (the inverse OETF, then the OOTF with the system gamma 1.2 and the BT.2020 luma of the scene light), as
+ * libplacebo draws it (dvbridge_render.c: hlg_to_pq()), before the 2x2 means. hlg false: as above. */
+bool dvbridge_measure_submit_ex(struct dvbridge_measure *m, unsigned luma, unsigned chroma, int width, int height,
+                                const int window[2], double pts, uint64_t tag, bool hlg);
 /* The measurements that the GPU has finished, in the order they were queued, each to done(); one not finished stops
  * it (so that they come in order). Returns how many are still in flight. */
 unsigned dvbridge_measure_collect(struct dvbridge_measure *m,
diff --git a/tools/dvbridge/dvbridge_measured.c b/tools/dvbridge/dvbridge_measured.c
index a52a634..89ffc81 100644
--- a/tools/dvbridge/dvbridge_measured.c
+++ b/tools/dvbridge/dvbridge_measured.c
@@ -9,6 +9,7 @@
 #include "dvbridge_measured.h"
 
 #include "dvbridge_hdr10plus.h"
+#include "dvbridge_render.h"
 
 #include <libavutil/dovi_meta.h>
 #include <libavutil/mastering_display_metadata.h>
@@ -420,6 +421,15 @@ struct AVDOVIMetadata *dvbridge_measured_placeholder(const struct AVMasteringDis
     return dvbridge_profile81_metadata(c[0], c[1], c[2], NULL, mastering, light, false, size);
 }
 
+struct AVDOVIMetadata *dvbridge_measured_placeholder_hlg(size_t *size)
+{
+    AVMasteringDisplayMetadata mastering = {0};
+    mastering.has_luminance = 1;
+    mastering.max_luminance = (AVRational){(int)DVBRIDGE_HLG_NOMINAL_PEAK, 1};
+    mastering.min_luminance = (AVRational){0, 1};
+    return dvbridge_measured_placeholder(&mastering, NULL, size);
+}
+
 bool dvbridge_measured_apply(struct AVDOVIMetadata *m, size_t size, const struct dvbridge_measured_l1 *l1)
 {
     if (!m || !l1 || size < sizeof(*m) || m->num_ext_blocks < 0 || m->num_ext_blocks > AV_DOVI_MAX_EXT_BLOCKS ||
diff --git a/tools/dvbridge/dvbridge_measured.h b/tools/dvbridge/dvbridge_measured.h
index 7ccc3b0..98a1da2 100644
--- a/tools/dvbridge/dvbridge_measured.h
+++ b/tools/dvbridge/dvbridge_measured.h
@@ -123,6 +123,11 @@ struct AVContentLightMetadata;
  * one. NULL without the luminance of the mastering display: no Dolby Vision. */
 struct AVDOVIMetadata *dvbridge_measured_placeholder(const struct AVMasteringDisplayMetadata *mastering,
                                                      const struct AVContentLightMetadata *light, size_t *size);
+/* Hades: the same for an HLG video sent as Dolby Vision (DVBRIDGE_BASE_HLG_TO_PQ, dvbridge_render.h), which has no
+ * mastering display to take the source range from: that of the reference HLG display of BT.2100, 1000 cd/m2
+ * (DVBRIDGE_HLG_NOMINAL_PEAK) over a black of 0, the picture that goes out being made for it. Level 1 from that
+ * peak until the picture is measured. */
+struct AVDOVIMetadata *dvbridge_measured_placeholder_hlg(size_t *size);
 /* The metadata of a picture made from those, as it is presented: its level 1 block, its scene refresh and its level
  * 5 block (added, or replaced) from l1. false: they cannot take it (no level 1 block, no room). */
 bool dvbridge_measured_apply(struct AVDOVIMetadata *metadata, size_t size, const struct dvbridge_measured_l1 *l1);
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index cb7d116..be1a85a 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1015,7 +1015,10 @@ static bool source_possible(struct dvbridge_renderer *r, const struct pl_frame *
     if (!r->source_wanted)
         return false;
     float sx = 0.0f, sy = 0.0f, v[4];
-    if (!r->source_packer)
+    /* Hades: the composer of the source transport takes its picture to be in ST 2084 */
+    if (r->base_transfer == DVBRIDGE_BASE_HLG_TO_PQ)
+        r->source_why = "the base layer is HLG, drawn converted to ST 2084 (HLG sent as Dolby Vision)";
+    else if (!r->source_packer)
         r->source_why = "the packer of the transport could not be made on this GPU";
     else if (r->legacy_composer)
         r->source_why = "the composer of ETSI GS CCM 001 is turned off";
@@ -1338,6 +1341,28 @@ static const char WHY_DIRECT_TARGET[] = "the direct way has no picture or target
                                         "3840x2160 one of four 8-bit components, or the picture has overlays";
 static const char WHY_DIRECT_GL[] = "OpenGL raised an error while the picture was drawn directly into the transport";
 
+/* Hades: HLG sent as Dolby Vision (DVBRIDGE_BASE_HLG_TO_PQ): the picture is the planes of an HLG video
+ * (BT.2020, the matrix for non-constant luminance, limited range: the stream is made so only where it is)
+ * and libplacebo draws it to BT.2020 in ST 2084 as the display of DVBRIDGE_HLG_NOMINAL_PEAK shows it: the
+ * same peak on both sides, so that nothing is tone mapped, and the primaries are the same. Its RPU (profile
+ * 8.1) describes the picture that comes out, which is in ST 2084. */
+static void hlg_to_pq(struct pl_frame *image, struct pl_frame *target)
+{
+    image->color = (struct pl_color_space){
+        .primaries = PL_COLOR_PRIM_BT_2020,
+        .transfer = PL_COLOR_TRC_HLG,
+        .hdr = {.max_luma = DVBRIDGE_HLG_NOMINAL_PEAK},
+    };
+    image->repr.sys = PL_COLOR_SYSTEM_BT_2020_NC;
+    image->repr.levels = PL_COLOR_LEVELS_LIMITED;
+    image->repr.dovi = NULL;
+    target->color = (struct pl_color_space){
+        .primaries = PL_COLOR_PRIM_BT_2020,
+        .transfer = PL_COLOR_TRC_PQ,
+        .hdr = {.max_luma = DVBRIDGE_HLG_NOMINAL_PEAK},
+    };
+}
+
 static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                         const void *metadata, size_t bytes, double pts, double el_pts,
                         struct dvbridge_geometry geometry, pl_tex packed, bool flip,
@@ -1382,6 +1407,11 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
             }
     }
     bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
+    /* Hades: HLG sent as Dolby Vision is a single layer: one with an enhancement layer is not drawn */
+    if (r->base_transfer == DVBRIDGE_BASE_HLG_TO_PQ && el) {
+        r->not_drawn = "a picture of HLG sent as Dolby Vision came with an enhancement layer";
+        return false;
+    }
     /* Hades: Low-Latency is drawn the composed way only (dvbridge_render_set_low_latency()) */
     if (packed && r->low_latency) {
         r->not_drawn = "Low-Latency is drawn the composed way only, not directly into the transport";
@@ -1458,6 +1488,9 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         .color = mapped.color,
         .crop = {geometry.x, geometry.y, geometry.x + geometry.width, geometry.y + geometry.height},
     };
+    /* Hades: HLG sent as Dolby Vision */
+    if (r->base_transfer == DVBRIDGE_BASE_HLG_TO_PQ)
+        hlg_to_pq(&image, &target);
     // Own exact PQ-zero borders below (base_params(): PL_CLEAR_SKIP). Do not translate an sRGB clear
     // color through the output transfer function or clear a full-raster frame twice.
     bool ccm_composed = false;
@@ -1559,8 +1592,10 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     /* (Hades: a picture over HLG whose RPU declares PQ may be drawn by libplacebo's reshaping.) What
      * the render composed, and why a base layer that is not in PQ was not composed, are of the render
      * as its errors leave it, as render_hdr10() has them: a render that they fail composed nothing. */
-    r->base_refused = r->base_transfer && !ccm_composed && !r->ready ? r->base_transfer
-                                                                    : DVBRIDGE_BASE_PQ;
+    r->base_refused = r->base_transfer && r->base_transfer != DVBRIDGE_BASE_HLG_TO_PQ && !ccm_composed &&
+                              !r->ready
+                          ? r->base_transfer
+                          : DVBRIDGE_BASE_PQ;
     r->composed = !r->ready      ? DVBRIDGE_COMPOSED_NONE
                   : ccm_composed ? DVBRIDGE_COMPOSED_CCM
                                  : DVBRIDGE_COMPOSED_RESHAPING;
@@ -2495,7 +2530,8 @@ void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *r, bool use)
 void dvbridge_render_set_base_transfer(struct dvbridge_renderer *r, int transfer)
 {
     if (r)
-        r->base_transfer = transfer == DVBRIDGE_BASE_SDR || transfer == DVBRIDGE_BASE_HLG
+        r->base_transfer = transfer == DVBRIDGE_BASE_SDR || transfer == DVBRIDGE_BASE_HLG ||
+                                   transfer == DVBRIDGE_BASE_HLG_TO_PQ
                                ? transfer
                                : DVBRIDGE_BASE_PQ;
 }
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 96fc181..305bada 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -351,7 +351,14 @@ int dvbridge_render_composed(const struct dvbridge_renderer *renderer);
  *  - DVBRIDGE_BASE_HLG: HLG (compatibility 4: profile 8.4), which the clause does not name. Composed
  *    as a base layer in ST 2084 where the RPU declares its HDR picture in ST 2084 at hdr_bit_depth, as
  *    the clause sends one: the reshaping of the RPU then takes the HLG signal to that picture
- *    (libplacebo-9975).
+ *    (libplacebo-9975);
+ *  - DVBRIDGE_BASE_HLG_TO_PQ: HLG in BT.2020 as an ordinary HLG video is (no Dolby Vision metadata of
+ *    its own: HLG sent as Dolby Vision, videoscreen.hadeshlgasdv), whose RPU is that of profile 8.1
+ *    (the identity mapping: the metadata describe a picture in ST 2084). Not composed: libplacebo
+ *    draws it to BT.2020 in ST 2084, through the HLG system of BT.2100 (the inverse OETF and the OOTF)
+ *    for a display of DVBRIDGE_HLG_NOMINAL_PEAK cd/m2 and no more, with no tone mapping, and it goes
+ *    out in the converted transport (never the source transport, whose composer would take the HLG
+ *    signal for one in ST 2084).
  * Where libplacebo does not compose such a picture so (the setting of libplacebo's reshaping for a
  * base layer in BT.1886, an RPU over HLG that declares another picture, or a reason that libplacebo
  * logs), the picture is not drawn, never one composed as if its base layer were in PQ. The bridge
@@ -360,7 +367,16 @@ enum dvbridge_base_transfer {
     DVBRIDGE_BASE_PQ = 0,
     DVBRIDGE_BASE_SDR = 1,
     DVBRIDGE_BASE_HLG = 2,
+    DVBRIDGE_BASE_HLG_TO_PQ = 3,
 };
+/* Hades: the nominal peak luminance of the display that an HLG picture is drawn for when it is sent as Dolby
+ * Vision (DVBRIDGE_BASE_HLG_TO_PQ), in cd/m2. 1000 is the nominal peak of the reference HLG display of
+ * Recommendation ITU-R BT.2100 (table 5, "nominal peak luminance of the display 1000 cd/m2"), where the system
+ * gamma of the OOTF is 1.2, and the display of Report ITU-R BT.2408 that puts reference white (HLG signal 0.75) at
+ * 203 cd/m2: the same white as HDR10 video's graphic white. It is the peak at which the BT.2100 gamma needs no
+ * extension, the same as libplacebo uses for HLG without any other (PL_COLOR_HLG_PEAK). The picture is made as
+ * that display shows it, and the real display maps it from there by its Dolby Vision metadata. */
+#define DVBRIDGE_HLG_NOMINAL_PEAK 1000.0f
 void dvbridge_render_set_base_transfer(struct dvbridge_renderer *renderer, int transfer);
 /* Hades: the last render of a picture whose base layer is not in PQ (above) failed because libplacebo
  * did not compose it: that transfer, or DVBRIDGE_BASE_PQ */
-- 
