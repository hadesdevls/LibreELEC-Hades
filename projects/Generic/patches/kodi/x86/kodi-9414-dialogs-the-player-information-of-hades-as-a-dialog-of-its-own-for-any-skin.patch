index 87ec544..6583f51 100644
--- a/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
+++ b/xbmc/dialogs/GUIDialogPlayerProcessInfo.cpp
@@ -8,8 +8,14 @@
 
 #include "GUIDialogPlayerProcessInfo.h"
 
+#include "ServiceBroker.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPlayer.h"
+#include "guilib/GUIComponent.h"
+#include "guilib/GUIWindowManager.h"
 #include "input/actions/Action.h"
 #include "input/actions/ActionIDs.h"
+#include "utils/XBMCTinyXML.h"
 
 CGUIDialogPlayerProcessInfo::CGUIDialogPlayerProcessInfo(void)
     : CGUIDialog(WINDOW_DIALOG_PLAYER_PROCESS_INFO, "DialogPlayerProcessInfo.xml")
@@ -24,7 +30,27 @@ bool CGUIDialogPlayerProcessInfo::OnAction(const CAction &action)
   if (action.GetID() == ACTION_PLAYER_PROCESS_INFO)
   {
     Close();
+    // Hades: a skin whose player information does not show that of Hades (its overview and Dolby
+    // Vision pages, which Estuary has) goes on to Hades' own dialog with the second press, for a video
+    const auto& components = CServiceBroker::GetAppComponents();
+    const auto player = components.GetComponent<CApplicationPlayer>();
+    if (!m_showsHades && player && player->IsPlayingVideo())
+      CServiceBroker::GetGUI()->GetWindowManager().ActivateWindow(WINDOW_DIALOG_HADES_PLAYER_INFO);
     return true;
   }
   return CGUIDialog::OnAction(action);
 }
+
+void CGUIDialogPlayerProcessInfo::OnWindowLoaded()
+{
+  CGUIDialog::OnWindowLoaded();
+  // Hades: whether the skin's dialog shows the player information of Hades, which is read from the
+  // properties hades.* of the Home window (Estuary's, through Window(Home).Property(hades.…))
+  m_showsHades = false;
+  if (m_windowXMLRootElement)
+  {
+    TiXmlPrinter printer;
+    m_windowXMLRootElement->Accept(&printer);
+    m_showsHades = std::string_view(printer.CStr()).find("Property(hades.") != std::string_view::npos;
+  }
+}
diff --git a/xbmc/dialogs/GUIDialogPlayerProcessInfo.h b/xbmc/dialogs/GUIDialogPlayerProcessInfo.h
