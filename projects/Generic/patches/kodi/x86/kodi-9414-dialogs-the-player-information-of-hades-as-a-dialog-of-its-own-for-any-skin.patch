@@ -0,0 +1,50 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "GUIDialogHadesPlayerInfo.h"
+
+#include "addons/Skin.h"
+#include "filesystem/SpecialProtocol.h"
+#include "guilib/WindowIDs.h"
+#include "input/actions/Action.h"
+#include "input/actions/ActionIDs.h"
+#include "utils/FileUtils.h"
+#include "utils/log.h"
+
+CGUIDialogHadesPlayerInfo::CGUIDialogHadesPlayerInfo()
+  : CGUIDialog(WINDOW_DIALOG_HADES_PLAYER_INFO, "DialogHadesPlayerInfo.xml")
+{
+  m_loadType = KEEP_IN_MEMORY;
+}
+
+CGUIDialogHadesPlayerInfo::~CGUIDialogHadesPlayerInfo() = default;
+
+bool CGUIDialogHadesPlayerInfo::OnAction(const CAction& action)
+{
+  if (action.GetID() == ACTION_PLAYER_PROCESS_INFO)
+  {
+    Close();
+    return true;
+  }
+  return CGUIDialog::OnAction(action);
+}
+
+bool CGUIDialogHadesPlayerInfo::LoadXML(const std::string& strPath, const std::string& strLowerPath)
+{
+  // The skin's own dialog, if it has one; else the one of system/hades, in Estuary's coordinates
+  // (1920x1080), as a script window falls back to its own skin folder (WindowXML)
+  if (CFileUtils::Exists(strPath) || (!strLowerPath.empty() && CFileUtils::Exists(strLowerPath)))
+    return CGUIDialog::LoadXML(strPath, strLowerPath);
+  RESOLUTION_INFO res;
+  ADDON::CSkinInfo::TranslateResolution("1080i", res);
+  SetCoordsRes(res);
+  const std::string path = CSpecialProtocol::TranslatePath(FALLBACK_XML);
+  CLog::Log(LOGINFO, "Hades: the skin has no {}: the dialog of system/hades ({})",
+            GetProperty("xmlfile").asString(), path);
+  return CGUIDialog::LoadXML(path, path);
+}
diff --git a/xbmc/dialogs/GUIDialogHadesPlayerInfo.h b/xbmc/dialogs/GUIDialogHadesPlayerInfo.h
new file mode 100644
index 0000000..5be8bf1
--- /dev/null
+++ b/xbmc/dialogs/GUIDialogHadesPlayerInfo.h
@@ -0,0 +1,40 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "guilib/GUIDialog.h"
+
+/*!
+ * \brief The player information of Hades (its overview page and its Dolby Vision page), in any skin
+ *
+ * Estuary shows these pages in its own DialogPlayerProcessInfo.xml. For another skin they are a
+ * dialog of their own, "hadesplayerinfo": the skin's DialogHadesPlayerInfo.xml if it has one, else
+ * the one in system/hades, made from Estuary's pages (tools/hades-playerinfo/make-playerinfo.py),
+ * whose variables and maps every skin is given (system/hades/HadesIncludes.xml). Its values are
+ * the properties hades.* of the Home window, which the window system publishes while it is shown
+ * (CWinSystemGbmGLESContext::PublishPlayerInfo(), PublishDVInfo()).
+ *
+ * It opens with ActivateWindow(hadesplayerinfo), and with the action that opens the skin's player
+ * process information when that is already shown and does not show these pages itself (in Estuary
+ * nothing changes). The same action closes it.
+ */
+class CGUIDialogHadesPlayerInfo : public CGUIDialog
+{
+public:
+  CGUIDialogHadesPlayerInfo();
+  ~CGUIDialogHadesPlayerInfo() override;
+
+  bool OnAction(const CAction& action) override;
+
+  //! The dialog that system/hades has, used where the skin has none
+  static constexpr const char* FALLBACK_XML = "special://xbmc/system/hades/DialogHadesPlayerInfo.xml";
+
+protected:
+  bool LoadXML(const std::string& strPath, const std::string& strLowerPath) override;
+};
