From bbad8539140a1580a611c08bf84b0d1bd049df47 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:07:11 +0000
Subject: [PATCH] VideoRenderers: a picture drawn at its own size is never
 scaled above the threshold

ScalingAboveThreshold() takes a scale of 1 as scaling when "Enable high
quality scalers for scaling above" is set to 0 %: the percentage, 0, is
not below 0. A picture drawn at its own size (a 3840x2160 video in a
3840x2160 mode, a picture in the Original view) then went through the
chosen convolution (Lanczos, spline, cubic) and its intermediate
framebuffer, which do not give each pixel back as it is, in place of
the single pass that samples each pixel where it is, as at any other
threshold.

A destination within half a pixel of the source's size, in both
directions, is now never scaled above the threshold. Nothing else
changes: at every other threshold such a picture was below it already,
and a picture that is scaled, even by one pixel, is judged as before.
---
 .../cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 42a6d93..53f63b0 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -3046,6 +3046,13 @@ float CLinuxRendererGLES::ScalingAboveThreshold() const
 {
   // Empty until ManageRenderArea has run, then the per-eye crop of a stereo source
   CRect source = m_sourceRect.IsEmpty() ? CRect(0, 0, m_sourceWidth, m_sourceHeight) : m_sourceRect;
+  // Hades: a picture drawn at its own size, to within half a pixel, is not scaled, whatever the
+  // threshold. With "Enable high quality scalers for scaling above" at 0 %, a convolution of scale
+  // 1 through an intermediate framebuffer took the place of the single pass that samples each
+  // pixel where it is, as at any other threshold.
+  if (std::abs(m_destRect.Width() - source.Width()) < 0.5f &&
+      std::abs(m_destRect.Height() - source.Height()) < 0.5f)
+    return 0.0f;
   float scaleX = m_destRect.Width() / source.Width();
   float scaleY = m_destRect.Height() / source.Height();
   float scaleFactor = (scaleX + scaleY) / 2.0f;
-- 
