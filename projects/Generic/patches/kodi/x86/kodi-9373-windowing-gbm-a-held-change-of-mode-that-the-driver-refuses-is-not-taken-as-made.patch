From 8768d88b2a9daed744e4796c7fd539d1aa89da28 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:46:08 +0000
Subject: [PATCH] windowing/gbm: a held change of mode that the driver refuses
 is not taken as made

A change of mode for a video that opens is held for the commit that sets up
the output of the video (kodi-9284), so that the display changes once. When
the driver refused that commit, CDRMAtomic made it of the request before it,
without the mode and without the HDR signalling, and FlipPage() had already
cleared the pending modeset. HeldModeChangeCommitted(true) took the mode as
made, the other subsystems had been told of it, and nothing tried it again:
Kodi went on in a mode that was not the one on the screen. A driver may
refuse the mode and the HDR metadata together and take each alone, as they
went before the hold.

CDRMAtomic now says whether the last commit went out as it was asked
(LastCommitRefused()). When the commit that made a held change did not, the
mode goes out alone with the next commit, told before it as the first one
was, and the output of the video after it (its properties queued again), as
without a hold. A mode that is refused alone too stays as the driver left
it, as Kodi leaves any refused change of mode.
---
 xbmc/windowing/gbm/ModeChangeHold.h           | 63 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 22 ++++++-
 xbmc/windowing/gbm/WinSystemGbm.h             |  5 +-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  8 ++-
 xbmc/windowing/gbm/drm/DRMAtomic.cpp          |  4 ++
 xbmc/windowing/gbm/drm/DRMAtomic.h            |  4 ++
 6 files changed, 95 insertions(+), 11 deletions(-)

diff --git a/xbmc/windowing/gbm/ModeChangeHold.h b/xbmc/windowing/gbm/ModeChangeHold.h
index cba3e15..d1456e4 100644
--- a/xbmc/windowing/gbm/ModeChangeHold.h
+++ b/xbmc/windowing/gbm/ModeChangeHold.h
@@ -223,6 +223,13 @@ private:
  * frame is attempted every refresh, and is not told again) but the restoration of the ordinary
  * output, or a commit of it, which is told then.
  *
+ * Hades: a commit of the ordinary output that the driver refuses goes out as the request before
+ * it, without what it carried (CDRMAtomic). For the commit that makes a held change, that is the
+ * mode and the output of the video together, which the driver may refuse where it takes each
+ * alone (as they went before the hold). The mode was then taken as made, and nothing tried it
+ * again. Now the mode goes out alone with the next commit, told then, and the output of the video
+ * after it (After()).
+ *
  * Only decides; the window system tells, and arms the reset, when Before() says so.
  */
 class CHeldModeAnnouncement
@@ -236,10 +243,30 @@ public:
     TOLD, //!< told for the commit that is being made
   };
 
+  //! What the window system does after a commit that was told of
+  enum class Then
+  {
+    NOTHING,
+    //! Hades: it was a commit of the ordinary output and went out as the request before it: the
+    //! mode goes out alone with the next commit (a modeset is allowed for it), told then
+    MODE_ALONE,
+    //! ... that commit was made, or refused too (the mode stays as the driver left it): the
+    //! output of the video goes out with the next commit (its properties queued again)
+    OUTPUT_AFTER,
+  };
+
   //! A change of mode was held: it is told with its commit
-  void Held() { m_step = Step::BEFORE_NEXT; }
+  void Held()
+  {
+    m_step = Step::BEFORE_NEXT;
+    m_alone = false;
+  }
   //! Another change of mode is made, which tells of itself: this one is not told
-  void Dropped() { m_step = Step::NONE; }
+  void Dropped()
+  {
+    m_step = Step::NONE;
+    m_alone = false;
+  }
   //! A commit is about to be made (transport: a frame of native Dolby Vision output); true when
   //! the other subsystems are to be told now that the display is lost (and back after it)
   bool Before(bool transport)
@@ -251,16 +278,40 @@ public:
     }
     return false;
   }
-  //! ... it was made: accepted, or refused by the driver (only a frame of native output can be)
-  void After(bool accepted, bool transport)
+  //! ... it was made: accepted, or refused by the driver (a frame of native output is not shown
+  //! then). fellBack: (Hades) a commit of the ordinary output that went out as the request before
+  //! it; any other refusal (a restoration of the ordinary output, made again later with what it
+  //! carried) is not told again, as before
+  Then After(bool accepted, bool transport, bool fellBack = false)
   {
-    if (m_step == Step::TOLD)
-      m_step = !accepted && transport ? Step::BEFORE_ORDINARY : Step::NONE;
+    if (m_step != Step::TOLD)
+      return Then::NOTHING;
+    if (m_alone)
+    {
+      // (a frame of native output carries its own output)
+      m_alone = false;
+      m_step = Step::NONE;
+      return transport ? Then::NOTHING : Then::OUTPUT_AFTER;
+    }
+    if (!accepted && transport)
+    {
+      m_step = Step::BEFORE_ORDINARY;
+      return Then::NOTHING;
+    }
+    if (!accepted && fellBack)
+    {
+      m_step = Step::BEFORE_NEXT;
+      m_alone = true;
+      return Then::MODE_ALONE;
+    }
+    m_step = Step::NONE;
+    return Then::NOTHING;
   }
   Step Pending() const { return m_step; }
 
 private:
   Step m_step = Step::NONE;
+  bool m_alone = false; //!< the commit to be told is the mode alone, after a refusal
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 2c23e87..94a3a9d 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1741,9 +1741,27 @@ void CWinSystemGbm::AnnounceHeldModeChange(bool transport)
     m_dispResetTimer.Set(delay);
 }
 
-void CWinSystemGbm::HeldModeChangeCommitted(bool accepted, bool transport)
+void CWinSystemGbm::HeldModeChangeCommitted(bool accepted, bool transport, bool fellBack)
 {
-  m_modeAnnounce.After(accepted, transport);
+  // Hades: the commit of a held change of mode, with the output of the video, that went out as
+  // the request before it: each goes out alone, as before the hold (CHeldModeAnnouncement)
+  switch (m_modeAnnounce.After(accepted, transport, fellBack))
+  {
+    case CHeldModeAnnouncement::Then::MODE_ALONE:
+      CLog::Log(LOGWARNING, "The commit of the change of mode with the output of the video was "
+                            "refused: the change of mode goes out alone with the next commit, and "
+                            "the output of the video after it");
+      m_DRM->AllowModeset();
+      break;
+    case CHeldModeAnnouncement::Then::OUTPUT_AFTER:
+      CLog::Log(LOGINFO, "The change of mode {}; the output of the video goes out with the next "
+                         "commit",
+                accepted ? "went out alone" : "was refused alone too: the mode stays as it was");
+      RequeueOutputProperties();
+      break;
+    default:
+      break;
+  }
 }
 
 bool CWinSystemGbm::EndModeHoldForModeChange()
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 287719b..2ef53f2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -282,8 +282,9 @@ protected:
   //! is the one that makes such a change, they are told now that the display is lost, and that it
   //! is back after it (OnLostDevice(), and the delay that the user set, as SetFullScreen())
   void AnnounceHeldModeChange(bool transport);
-  //! ... and it was made, or refused by the driver
-  void HeldModeChangeCommitted(bool accepted, bool transport);
+  //! ... and it was made, or refused by the driver (fellBack: a commit of the ordinary output that
+  //! went out as the request before it, see CHeldModeAnnouncement::After())
+  void HeldModeChangeCommitted(bool accepted, bool transport, bool fellBack = false);
   //! ... a change of mode is being made: a hold ends with it (a START one gives the mode on the
   //! screen back to the selection, for what follows to compare with). True when it was a STOP
   //! hold: what it held goes out with the commit of this change, which no START hold may then
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1a88e7c..ebc4b34 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -684,7 +684,13 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       FlipOutputOn();
     CWinSystemGbm::FlipPage(rendered, videoLayer, async);
 #ifdef HAVE_DVBRIDGE
-    HeldModeChangeCommitted(true, false);
+    // (Hades: a commit that the driver refused went out as the one before it, without the change
+    // of mode that it may carry)
+    {
+      const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+      const bool fellBack = atomic && atomic->LastCommitRefused();
+      HeldModeChangeCommitted(!fellBack, false, fellBack);
+    }
     // Hades: the depth and the format at which HDR leaves (and a Dolby Vision picture rebuilt
     // as HDR10 with it), once its signalling has gone out (the commit above carried it, or one
     // before it did); asked again when the signalling changes. Not during native Dolby Vision:
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index ebfdedf..0a8ac0a 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -100,9 +100,11 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   CDRMCrtc* oldCrtc = m_old_crtc;
   const auto reject = [&]() {
     m_old_crtc = oldCrtc;
+    m_lastCommitRefused = true; // (Hades)
     FinishRequest(false);
     return false;
   };
+  m_lastCommitRefused = false;
   // Declared at function scope so the blob outlives drmModeAtomicCommit.
   // DRM requires the blob to remain alive for the duration of the commit;
   // destroying it before the commit returns leaves the atomic request
@@ -249,6 +251,7 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 
     m_flipRefused = m_flipRefused || tells;
     m_flipDropped = m_flipDropped || m_active;
+    m_lastCommitRefused = true; // (Hades: what this request carried does not go out)
     auto oldRequest = m_atomicRequestQueue.front().get();
     CDRMAtomicRequest::LogAtomicDiff(m_req, oldRequest);
     m_req = oldRequest;
@@ -434,6 +437,7 @@ void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, boo
       CLog::LogF(LOGERROR, "Failed to get a new FBO");
       m_flipRefused = m_flipRefused || m_active;
       m_flipDropped = m_flipDropped || m_active;
+      m_lastCommitRefused = true; // (Hades)
       return;
     }
 
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 97cae06..12f3adb 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -59,6 +59,9 @@ public:
   //! Hades: the next commit would carry more than a framebuffer: properties added since the last
   //! one, or a modeset that is pending
   bool HasPendingRequest() const { return m_need_modeset || (m_req && !m_req->Empty()); }
+  //! Hades: the last commit did not go out as it was asked: the driver refused it, or its test
+  //! (the frame then went out with the request before it), or there was no framebuffer
+  bool LastCommitRefused() const { return m_lastCommitRefused; }
 
   // Probe whether any DRM device supports atomic modesetting, with no
   // connector required. Used to decide atomic-vs-legacy before falling back.
@@ -118,6 +121,7 @@ private:
   //! not undo it (a change of mode that was refused is followed by flips in the old mode).
   bool m_flipRefused = false;
   bool m_flipDropped = false; //!< see TakeFlipDropped(); kept until it is asked
+  bool m_lastCommitRefused = false; //!< Hades: see LastCommitRefused()
   //! When to turn off the outputs Kodi does not use (a second monitor)
   std::optional<std::chrono::steady_clock::time_point> m_otherOutputsOff;
 
-- 
