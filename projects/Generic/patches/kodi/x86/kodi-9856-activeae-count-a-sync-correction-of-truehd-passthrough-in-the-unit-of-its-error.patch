From 570d2b8c9cc463f807b13c0d4ab0e2e5bd843fe6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:56:42 +0000
Subject: [PATCH] ActiveAE: count a sync correction of TrueHD passthrough in
 the unit of its error

The engine measures the sync error of TrueHD passed through scaled down by 0.45 (RunStages(),
"underestimate error for TrueHD passthrough"), so that the uneven arrival of its packets does not
trigger corrections. SyncStream() then corrected that scaled error in real time: a pause as long as
the scaled error, counted in full, and a packet left out counted as its whole length. A correction
stopped at 0.45 of the error: a TrueHD stream that started, resumed or was found 300 ms ahead of the
picture was put back by 120 ms of pauses and stayed 180 ms ahead, below the threshold, which for
TrueHD is 222 ms of real time; the player then moved its clock and left it about 100 ms off.

A pause is now as long as the error itself (the scaled error divided by the scale), and each
correction counts scaled down, as the error it corrects. The band the correction lands in is 30 ms
of real time, as for the other formats (scaled for TrueHD as the error is). The thresholds that
decide a correction are not changed. The scale is a named constant, AE::TRUEHD_SYNC_ERROR_SCALE, in
its own header, for the code that reads the error the engine tells (CAESyncInfo::error stays scaled).
Nothing changes for other formats: their scale is 1.

The log lines of a correction of passthrough give the error in milliseconds of real time, and a
stream that starts (or starts again) out of the landing band is told as well, with what is left
when it is in sync again.

Measured in a host harness that runs SyncStream() and CSyncError as they are, with the engine's
measurement, its accounting of the sink and an ALSA sink around them: from 100, 300 and 600 ms
ahead or behind, at start, after a seek or a jump of the clock, TrueHD ended 41 to 219 ms off (41 to
104 ms with the player moving its clock), and ends within 21 ms now.
---
 xbmc/cores/AudioEngine/CMakeLists.txt         |  3 +-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 49 ++++++++++++++-----
 .../cores/AudioEngine/Utils/TrueHDSyncScale.h | 19 +++++++
 3 files changed, 57 insertions(+), 14 deletions(-)
 create mode 100644 xbmc/cores/AudioEngine/Utils/TrueHDSyncScale.h

diff --git a/xbmc/cores/AudioEngine/CMakeLists.txt b/xbmc/cores/AudioEngine/CMakeLists.txt
index 73bf306..2ffcce5 100644
--- a/xbmc/cores/AudioEngine/CMakeLists.txt
+++ b/xbmc/cores/AudioEngine/CMakeLists.txt
@@ -58,7 +58,8 @@ set(HEADERS AEResampleFactory.h
             Utils/DialnormOverride.h
             Utils/DownmixLevels.h
             Utils/GpuClockHold.h
-            Utils/PackerMAT.h)
+            Utils/PackerMAT.h
+            Utils/TrueHDSyncScale.h)
 
 if(TARGET ${APP_NAME_LC}::Alsa)
   list(APPEND SOURCES Sinks/AESinkALSA.cpp
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 2518885..01f0598 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -24,6 +24,7 @@
 #include "cores/AudioEngine/Utils/AEStreamData.h"
 #include "cores/AudioEngine/Utils/AEStreamInfo.h"
 #include "cores/AudioEngine/Utils/AEUtil.h"
+#include "cores/AudioEngine/Utils/TrueHDSyncScale.h"
 #include "cores/DataCacheCore.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/Settings.h"
@@ -2338,7 +2339,7 @@ bool CActiveAE::RunStages()
         // underestimate error for TrueHD passthrough
         // oscillations should be less than frametime 40ms to avoid unnecessary a/v sync corrections
         if (isTrueHDPassthrough)
-          error *= 0.45;
+          error *= TRUEHD_SYNC_ERROR_SCALE;
 
         if (error > maxError)
         {
@@ -2761,6 +2762,11 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     }
   }
 
+  // Hades: the errors of TrueHD passthrough are measured scaled down (RunStages()), and the
+  // thresholds of the decisions below are compared with them as they are. A correction is real
+  // time: a pause is as long as the error unscaled, and each correction counts scaled down.
+  const double scale{IsTrueHDPassthrough() ? TRUEHD_SYNC_ERROR_SCALE : 1.0};
+
   std::chrono::milliseconds timeout = (stream->m_syncState != CAESyncInfo::AESyncState::SYNC_INSYNC)
                                           ? 100ms
                                           : stream->GetErrorInterval();
@@ -2806,8 +2812,8 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       CLog::Log(LOGINFO,
                 "ActiveAE::SyncStream - the passthrough stream ({}) is {:.0f} ms {} the video, "
                 "more than the {:.0f} ms allowed: it is put back with {}, each a cut in the sound",
-                CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error),
-                error > 0 ? "ahead of" : "behind", threshold,
+                CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error) / scale,
+                error > 0 ? "ahead of" : "behind", threshold / scale,
                 error > 0 ? "pauses" : "packets left out");
     }
   }
@@ -2829,6 +2835,22 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       stream->m_syncState = CAESyncInfo::AESyncState::SYNC_ADJUST;
       stream->m_lastSyncError = error;
       CLog::Log(LOGDEBUG, "ActiveAE::SyncStream - average error of {:f}, start adjusting", error);
+      // Hades: a passthrough stream that starts (or starts again) out of the landing band of the
+      // correction is told as above, and when it is in sync
+      if (m_mode == MODE_RAW)
+      {
+        stream->m_rawAdjusting = fabs(error) >= 30 * scale;
+        stream->m_rawAdjustSince = std::chrono::steady_clock::now();
+        stream->m_rawPauseMs = 0;
+        stream->m_rawDropped = 0;
+        if (stream->m_rawAdjusting)
+          CLog::Log(LOGINFO,
+                    "ActiveAE::SyncStream - the passthrough stream ({}) starts {:.0f} ms {} the "
+                    "video: it is put back with {}",
+                    CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type),
+                    fabs(error) / scale, error > 0 ? "ahead of" : "behind",
+                    error > 0 ? "pauses" : "packets left out");
+      }
     }
   }
 
@@ -2876,12 +2898,12 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
         if (m_mode == MODE_RAW)
         {
           ret->pkt->nb_samples = 0;
-          ret->pkt->pause_burst_ms = error;
-          if (error > stream->m_format.m_streamInfo.GetDuration())
+          ret->pkt->pause_burst_ms = error / scale;
+          if (error / scale > stream->m_format.m_streamInfo.GetDuration())
             ret->pkt->pause_burst_ms = stream->m_format.m_streamInfo.GetDuration();
 
-          stream->m_syncError.Correction(-ret->pkt->pause_burst_ms);
-          error -= ret->pkt->pause_burst_ms;
+          stream->m_syncError.Correction(-ret->pkt->pause_burst_ms * scale);
+          error -= ret->pkt->pause_burst_ms * scale;
           stream->m_rawPauseMs += ret->pkt->pause_burst_ms; // (Hades)
         }
         else
@@ -2916,10 +2938,10 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       }
       if (m_mode == MODE_RAW)
       {
-        if (-error > stream->m_format.m_streamInfo.GetDuration() / 2)
+        if (-error > stream->m_format.m_streamInfo.GetDuration() * scale / 2)
         {
-          stream->m_syncError.Correction(stream->m_format.m_streamInfo.GetDuration());
-          error += stream->m_format.m_streamInfo.GetDuration();
+          stream->m_syncError.Correction(stream->m_format.m_streamInfo.GetDuration() * scale);
+          error += stream->m_format.m_streamInfo.GetDuration() * scale;
           buf->pkt->nb_samples = 0;
           stream->m_rawDropped++; // (Hades)
         }
@@ -2938,7 +2960,8 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       }
     }
 
-    if (fabs(error) < 30)
+    // (Hades: 30 ms of real time, scaled as the error is)
+    if (fabs(error) < 30 * scale)
     {
       // Hades: what the correction of a passthrough stream took
       if (stream->m_rawAdjusting)
@@ -2946,11 +2969,11 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
         stream->m_rawAdjusting = false;
         CLog::Log(LOGINFO,
                   "ActiveAE::SyncStream - the passthrough stream is in sync with the video again "
-                  "after {} ms: {:.0f} ms of pauses, {} packets left out",
+                  "after {} ms: {:.0f} ms of pauses, {} packets left out, {:+.0f} ms off",
                   std::chrono::duration_cast<std::chrono::milliseconds>(
                       std::chrono::steady_clock::now() - stream->m_rawAdjustSince)
                       .count(),
-                  stream->m_rawPauseMs, stream->m_rawDropped);
+                  stream->m_rawPauseMs, stream->m_rawDropped, error / scale);
       }
       if (stream->m_lastSyncError > threshold * 2)
       {
diff --git a/xbmc/cores/AudioEngine/Utils/TrueHDSyncScale.h b/xbmc/cores/AudioEngine/Utils/TrueHDSyncScale.h
new file mode 100644
index 0000000..e11d971
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/TrueHDSyncScale.h
@@ -0,0 +1,19 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace AE
+{
+//! The audio engine measures the sync error of TrueHD passed through scaled down by this, as Kodi
+//! has it (CActiveAE::RunStages(): "underestimate error for TrueHD passthrough"): its packets come
+//! in unevenly, and the scaled error keeps that from triggering corrections. The error the engine
+//! averages and tells (CAESyncInfo::error) is scaled; divided by this, it is the error itself, in
+//! milliseconds of real time, which a correction of the sync is counted in (CActiveAE::SyncStream()).
+constexpr double TRUEHD_SYNC_ERROR_SCALE = 0.45;
+} // namespace AE
