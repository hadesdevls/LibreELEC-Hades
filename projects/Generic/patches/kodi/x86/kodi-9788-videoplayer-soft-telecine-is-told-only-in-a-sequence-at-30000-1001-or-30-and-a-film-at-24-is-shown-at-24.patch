diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index e5149cf..4bd61d1 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -195,6 +195,10 @@ void CVideoPlayerVideo::OpenStream(CDVDStreamInfo& hint, std::unique_ptr<CDVDVid
   ResetFrameRateCalc();
   m_softTelecine = hint.softTelecine;
   m_filmTimer.Reset();
+  // (Hades: the film is at the rate that the stream says: 24000/1001, or 24 in a sequence at 30)
+  m_filmTimer.SetDuration(hint.softTelecine && hint.fpsrate > 0 && hint.fpsscale > 0
+                              ? static_cast<double>(DVD_TIME_BASE) * hint.fpsscale / hint.fpsrate
+                              : KODI::VIDEOPLAYER::CFilmTimer::DURATION);
 
   m_iDroppedRequest = 0;
   m_iLateFrames = 0;
