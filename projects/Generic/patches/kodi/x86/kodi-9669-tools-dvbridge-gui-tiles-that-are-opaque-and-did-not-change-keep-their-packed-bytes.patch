+        /* 9: whether the pixels of the tiles packed into it were opaque, and the state after them */
+        ok = glGetError() == GL_NO_ERROR &&
+             target(&p->opaque_quarter, GL_R8, 3840 / 4, 2160 / 4);
+    }
+    if (ok) {
+        glUseProgram(p->opaque_program);
+        bind(p, 2, layer);
+        glUniform1i(p->op_drawn, 2);
+        set_tiles(p, p->op_tiles, p->op_mode, 7);
+        glUniform1i(p->op_flip, 0);
+        glDrawArrays(GL_TRIANGLES, 0, tiled_vertices(7));
+        const int next = 1 - p->state_now;
+        ok = target(&p->state[next], GL_R8, DRAWN_COLUMNS, DRAWN_ROWS);
+        if (ok) {
+            glUseProgram(p->state_program);
+            bind(p, 0, p->opaque_quarter.texture);
+            bind(p, 1, p->state[p->state_now].texture);
+            bind(p, 3, p->tiles_texture);
+            glUniform1i(p->st_quarter, 0);
+            glUniform1i(p->st_state, 1);
+            glUniform1i(p->st_tiles, 3);
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            ok = glGetError() == GL_NO_ERROR;
+            if (ok)
+                p->state_now = next;
+        }
+    }
+    /* 10: the bytes of the tiles copied or packed into the cache, into the framebuffer */
+    if (ok) {
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glViewport(0, 0, 3840, 2160);
+        glUseProgram(p->copy_program);
+        bind(p, 0, p->cache.texture);
+        glUniform1i(p->cp_cache, 0);
+        glUniform1ui(p->cp_flip, flip_y);
+        set_tiles(p, p->cp_tiles, p->cp_mode, 8);
+        glUniform1i(p->cp_tflip, flip_y);
+        glDrawArrays(GL_TRIANGLES, 0, tiled_vertices(8));
+        ok = glGetError() == GL_NO_ERROR;
+    }
+    /* (the check, and what the tiles were: read back, for the check only) */
+    if (ok && p->cache_check && p->again.texture && target(&p->differ, GL_R8, DRAWN_COLUMNS, DRAWN_ROWS)) {
+        glUseProgram(p->check_program);
+        bind(p, 0, p->cache.texture);
+        bind(p, 1, p->again.texture);
+        bind(p, 3, p->tiles_texture);
+        glUniform1i(p->ck_cache, 0);
+        glUniform1i(p->ck_again, 1);
+        glUniform1i(p->ck_tiles, 3);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        uint8_t *differ = malloc(DRAWN_COLUMNS * DRAWN_ROWS * 4);
+        uint8_t *tiles = malloc(DRAWN_COLUMNS * DRAWN_ROWS * 4);
+        if (differ && tiles) {
+            GLint alignment = 4, pack_buffer = 0;
+            glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+            glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+            glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+            glPixelStorei(GL_PACK_ALIGNMENT, 1);
+            glReadPixels(0, 0, DRAWN_COLUMNS, DRAWN_ROWS, GL_RGBA, GL_UNSIGNED_BYTE, differ);
+            glBindFramebuffer(GL_FRAMEBUFFER, p->ctiles.framebuffer);
+            glReadPixels(0, 0, DRAWN_COLUMNS, DRAWN_ROWS, GL_RGBA, GL_UNSIGNED_BYTE, tiles);
+            glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+            glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack_buffer);
+            memset(p->stats, 0, sizeof(p->stats));
+            for (int i = 0; i < DRAWN_COLUMNS * DRAWN_ROWS; ++i) {
+                p->stats[0] += tiles[i * 4 + 1] >= 128;
+                p->stats[1] += tiles[i * 4 + 2] >= 128;
+                p->stats[2] += differ[i * 4] >= 128;
+            }
+            p->stats[3] = 1;
+            p->stats_valid = glGetError() == GL_NO_ERROR;
+        }
+        free(differ);
+        free(tiles);
+    }
+    if (!ok) {
+        /* (the tiles not packed: the frame is not, and nothing more is kept) */
+        dvbridge_gl_drain_errors();
+        p->key_valid = false;
+        p->cache_usable = false;
+        fprintf(stderr, "DV source transport: the passes of the GUI cache failed; the GUI is "
+                        "converted at every frame, as before\n");
+        return end(&state, false);
+    }
     return end(&state, true);
 }
 
+/* Hades: (for tests) what the tiles of the last pack that took the cache were, read back from the
+ * tiles of 7c (copied, packed into it) without the check's count */
+bool dvbridge_source_gui_cache_read(struct dvbridge_source_packer *p, unsigned counts[2])
+{
+    if (!p || !counts || !p->ctiles.texture)
+        return false;
+    uint8_t *tiles = malloc(DRAWN_COLUMNS * DRAWN_ROWS * 4);
+    if (!tiles)
+        return false;
+    GLint previous = 0, alignment = 4;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glBindFramebuffer(GL_FRAMEBUFFER, p->ctiles.framebuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, DRAWN_COLUMNS, DRAWN_ROWS, GL_RGBA, GL_UNSIGNED_BYTE, tiles);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)previous);
+    counts[0] = counts[1] = 0;
+    for (int i = 0; i < DRAWN_COLUMNS * DRAWN_ROWS; ++i) {
+        counts[0] += tiles[i * 4 + 1] >= 128;
+        counts[1] += tiles[i * 4 + 2] >= 128;
+    }
+    free(tiles);
+    return glGetError() == GL_NO_ERROR;
+}
