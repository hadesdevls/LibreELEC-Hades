+void dvbridge_source_gui_cache(struct dvbridge_source_packer *packer, bool use);
+bool dvbridge_source_gui_cache_usable(const struct dvbridge_source_packer *packer);
+/* What decides the colours that the composite of the texture of dvbridge_source_drawn() draws
+ * from its texels (its program, its tables: Kodi's transfer and GUI white), for the next picture
+ * of dvbridge_source_picture(), as dvbridge_source_drawn(): another key, another composite. 0: not
+ * known (nothing is kept, and what was is forgotten). */
+void dvbridge_source_drawn_key(struct dvbridge_source_packer *packer, uint64_t key);
+/* A check of the cache: the frames that copy kept bytes also pack those tiles again into a
+ * texture of the packer's, as without it, and compare the two (each such frame waits for the
+ * GPU). For a check on hardware. */
+void dvbridge_source_gui_cache_check(struct dvbridge_source_packer *packer, bool check);
+/* The tiles of the last dvbridge_source_pack() (each DRAWN_TILE x DRAWN_TILE pixels): [0] copied
+ * from the cache, [1] packed into it, [2] (check) copied and not the same bytes as packed again,
+ * [3] whether the check ran. Reads back what the GPU decided (waits for it): for tests and the
+ * check. False where that frame did not take the cache. */
+bool dvbridge_source_gui_cache_tiles(struct dvbridge_source_packer *packer, unsigned counts[4]);
+/* (for tests) the tiles that the passes of the last picture decided to copy [0] and to pack into
+ * the cache [1], read back */
+bool dvbridge_source_gui_cache_read(struct dvbridge_source_packer *packer, unsigned counts[2]);
