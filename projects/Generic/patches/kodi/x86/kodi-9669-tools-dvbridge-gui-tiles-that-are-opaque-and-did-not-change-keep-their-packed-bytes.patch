From b3f6b8a04cad6fb5335cb7bfa2fd41184282aee4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:20:14 +0000
Subject: [PATCH] tools/dvbridge: GUI tiles that are opaque and did not change
 keep their packed bytes

Under a GUI that stays over a playing Dolby Vision video (Home, a dialog, the player
information), the source transport made the picture under every tile that the GUI reaches,
Kodi composited the GUI over it, and the packer converted every pixel drawn over back to codes,
at every frame. Where the GUI is opaque the result depends on the GUI alone: the composite leaves
a colour + (1 - a) picture, the colour where a = 1, and the conversion back adds (1 - a) times a
finite value, 0. For profile 5 that conversion takes three PQ round trips a pixel.

The packer now keeps a copy of the GUI texture and compares it with the texture, in blocks,
where the texture is opaque (pass 6c, in place of 6, with the same flag of what is drawn; 6p
copies the blocks that changed). A tile of the raster whose GUI texels, all those that its
pixels may sample (the footprint of pass 7), are opaque and the same as at the frame before is
packed once more as before, by the same program with the same uniforms, into a texture of the
packer's, and a pass checks that every one of its pixels came out of the composite with an alpha
of exactly 1; from the next frame its bytes are copied from there: passes 3, 8 and 4 are not
drawn in it. Translucent pixels are composed and converted at every frame, as before. What the
bytes were made with is the key of the cache: the metadata's representation
(dvbridge_source_params), the level of the conversion under the GUI of profile 5, the size of
the GUI, and the key of Kodi's composite (CWinSystemGbmGLESContext counts the programs and the
tables of its GUI composite: another GUI white, another key). The first row of tiles, which holds
the metadata, is never kept. A frame over which something else is drawn (PQ subtitles, a
capture: dvbridge_render_complete()) makes the tiles copied too and packs as before. Its passes
not made, or failing, the GUI is converted at every frame, as before, and the bridge says so.

On by default, as Kodi turns it on: <video><dvguicache>false</dvguicache></video> turns it off,
to measure what it saves, and <video><dvguicachecheck>true</dvguicachecheck></video> packs the
tiles copied again on those frames and compares them (kodi.log every 240 frames, and at once on
a difference).

Measured with the software bridge (Mesa's zink on lavapipe), against 1.0 RC4 with the same
libplacebo: the same bytes in every configuration of the bench (fidbench, 14 pictures of a
profile 7 FEL stream, with and without a GUI, at every fidelity step-down level, without the
enhancement layer, scaled, converted transport, reshaping; the measured test with the CCM 001
reader; the render test; the profile 5, FEL and 8.1 GUI test in its 162 frames and in sequences
of twelve frames under one GUI, at the three levels of the conversion under the GUI, with the
check). Mutations that keep a GUI that changed, leave the composite's key or the metadata's
representation out of the key, keep translucent tiles, keep the first row, or copy or keep the
rows the other way up change the bytes; see the notes of the front.

Idea from YBLOD 0.3.0 (its exact GUI pixel cache), written again for the tiles of this bridge.
---
 tools/dvbridge/dvbridge_render.c              |  39 +-
 tools/dvbridge/dvbridge_render.h              |  19 +
 tools/dvbridge/dvbridge_source.c              | 695 +++++++++++++++++-
 tools/dvbridge/dvbridge_source.h              |  35 +
 .../VideoRenderers/DVBridgeGLES.cpp           |  47 +-
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  12 +-
 xbmc/settings/AdvancedSettings.cpp            |   4 +
 xbmc/settings/AdvancedSettings.h              |   5 +
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |   6 +-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   3 +
 10 files changed, 842 insertions(+), 23 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index a0c6cea..23f9a73 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -124,9 +124,11 @@ struct dvbridge_renderer {
     struct dvbridge_geometry geometry; /* of the last picture prepared */
     /* Hades: the target that wraps the window (dvbridge_render_set_window()), or NULL */
     pl_tex window;
-    /* Hades: what will be drawn over the next composed picture (dvbridge_render_set_drawn()) */
+    /* Hades: what will be drawn over the next composed picture (dvbridge_render_set_drawn()), and
+     * the key of its composite (dvbridge_render_set_drawn_key()) */
     unsigned drawn_gui;
     int drawn_w, drawn_h;
+    uint64_t drawn_key;
     /* Hades: Dolby Vision Low-Latency (dvbridge_render_set_low_latency()): the picture mapped to
      * ll_mapping, packed without metadata; ll_pattern, the test pattern in its place */
     bool low_latency, ll_pattern;
@@ -1032,6 +1034,8 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         /* Hades: in the tiles that what will be drawn over it may reach, where the caller said what
          * that is (dvbridge_render_set_drawn()) */
         dvbridge_source_drawn(r->source_packer, r->drawn_gui, r->drawn_w, r->drawn_h);
+        /* (Hades: and the key of its composite, for the GUI cache) */
+        dvbridge_source_drawn_key(r->source_packer, r->drawn_gui ? r->drawn_key : 0);
         if (fbo)
             timer_begin(r, TIMER_PICTURE);
         ok = fbo && dvbridge_source_picture(r->source_packer, &r->source_params, r->pack_luma,
@@ -2311,6 +2315,39 @@ void dvbridge_render_set_drawn(struct dvbridge_renderer *r, unsigned gui, int wi
     r->drawn_h = height;
 }
 
+void dvbridge_render_use_gui_cache(struct dvbridge_renderer *r, bool use)
+{
+    if (r)
+        dvbridge_source_gui_cache(r->source_packer, use);
+}
+
+bool dvbridge_render_gui_cache_usable(const struct dvbridge_renderer *r)
+{
+    return r && dvbridge_source_gui_cache_usable(r->source_packer);
+}
+
+void dvbridge_render_set_drawn_key(struct dvbridge_renderer *r, uint64_t key)
+{
+    if (r)
+        r->drawn_key = key;
+}
+
+void dvbridge_render_gui_cache_check(struct dvbridge_renderer *r, bool check)
+{
+    if (r)
+        dvbridge_source_gui_cache_check(r->source_packer, check);
+}
+
+bool dvbridge_render_gui_cache_tiles(struct dvbridge_renderer *r, unsigned counts[4])
+{
+    return r && dvbridge_source_gui_cache_tiles(r->source_packer, counts);
+}
+
+bool dvbridge_render_gui_cache_read(struct dvbridge_renderer *r, unsigned counts[2])
+{
+    return r && dvbridge_source_gui_cache_read(r->source_packer, counts);
+}
+
 bool dvbridge_render_complete(struct dvbridge_renderer *r)
 {
     /* only the composed way of the source transport makes its picture in tiles */
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index b6bd09e..7492e7a 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -441,6 +441,25 @@ void dvbridge_render_set_window(struct dvbridge_renderer *renderer, pl_tex windo
 #define DVBRIDGE_RENDER_DRAWN 1
 void dvbridge_render_set_drawn(struct dvbridge_renderer *renderer, unsigned gui, int width,
                                int height);
+/* Hades: the GUI cache of the source transport (dvbridge_source_gui_cache(): the bytes of the
+ * tiles where the GUI is opaque and did not change are copied from the frame before that packed
+ * them, not converted again; the same bytes). Off until asked for; it takes the frames whose
+ * composite's key is given (dvbridge_render_set_drawn_key(), as dvbridge_render_set_drawn(): for
+ * the next frame). check: those frames also pack the tiles copied again and compare them
+ * (dvbridge_render_gui_cache_tiles(): each such frame waits for the GPU). usable: its passes were
+ * made on this GPU. */
+#define DVBRIDGE_RENDER_GUI_CACHE 1
+void dvbridge_render_use_gui_cache(struct dvbridge_renderer *renderer, bool use);
+bool dvbridge_render_gui_cache_usable(const struct dvbridge_renderer *renderer);
+void dvbridge_render_set_drawn_key(struct dvbridge_renderer *renderer, uint64_t key);
+void dvbridge_render_gui_cache_check(struct dvbridge_renderer *renderer, bool check);
+/* of the last dvbridge_render_pack(): tiles copied, packed into the cache, (check) copied and not
+ * the same as packed again, whether the check ran; false where that frame did not take the cache
+ * or there is no check */
+bool dvbridge_render_gui_cache_tiles(struct dvbridge_renderer *renderer, unsigned counts[4]);
+/* (for tests) the tiles that the last picture's passes decided to copy [0] and to pack into the
+ * cache [1], read back (waits for the GPU) */
+bool dvbridge_render_gui_cache_read(struct dvbridge_renderer *renderer, unsigned counts[2]);
 /* Hades: the picture of the last dvbridge_render_rgb() whole, if it was made in tiles; false where
  * that could not be done (the picture is then whole only in those tiles) */
 bool dvbridge_render_complete(struct dvbridge_renderer *renderer);
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index df141b8..a18fe11 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -531,7 +531,12 @@ static const char SCALE_CHROMA_ROWS[] =
  * tiles with the flag only, 2 those without it only, 3 all of them. A tile that is not drawn has its
  * vertices outside the clip volume: it has no fragments. The quads meet at the edges of the pixels,
  * so every pixel of a tile drawn is drawn once. tiles_flip: the rows of the framebuffer are those of
- * the raster the other way up (a window). */
+ * the raster the other way up (a window).
+ * Hades: with the GUI cache (dvbridge_source_gui_cache()) the tiles hold, besides that flag (red),
+ * whether the tile is copied from the cache this frame (green) and whether it is packed into it
+ * (blue), and modes 4 to 9 draw: 4 the tiles with the flag but those copied; 5 those without the
+ * flag and those copied (the rest of the picture); 6 every tile but those copied or packed into the
+ * cache; 7 those packed into it; 8 those copied or packed into it; 9 those copied. */
 static const char TILED_VERTEX[] =
     "#version 300 es\n"
     "precision highp float;\n"
@@ -553,7 +558,19 @@ static const char TILED_VERTEX[] =
     "    int quad = gl_VertexID / 6, corner = gl_VertexID - quad * 6;\n"
     "    ivec2 t = ivec2(quad % " DRAWN_STRING(DRAWN_COLUMNS) ", quad / " DRAWN_STRING(DRAWN_COLUMNS) ");\n"
     "    tile_drawn = texelFetch(drawn_tiles, t, 0).r > 0.5 ? 1 : 0;\n"
-    "    if ((tiles_mode == 1 && tile_drawn == 0) || (tiles_mode == 2 && tile_drawn != 0)) {\n"
+    "    if (tiles_mode >= 4) {\n"
+    "        vec4 f = texelFetch(drawn_tiles, t, 0);\n"
+    "        bool use = f.g > 0.5, fill = f.b > 0.5;\n"
+    "        bool keep = tiles_mode == 4 ? tile_drawn != 0 && !use :\n"
+    "                    tiles_mode == 5 ? tile_drawn == 0 || use :\n"
+    "                    tiles_mode == 6 ? !use && !fill :\n"
+    "                    tiles_mode == 7 ? fill :\n"
+    "                    tiles_mode == 8 ? use || fill : use;\n"
+    "        if (!keep) {\n"
+    "            gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
+    "            return;\n"
+    "        }\n"
+    "    } else if ((tiles_mode == 1 && tile_drawn == 0) || (tiles_mode == 2 && tile_drawn != 0)) {\n"
     "        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
     "        return;\n"
     "    }\n"
@@ -1044,6 +1061,221 @@ static const char DRAWN[] =
     "    color = vec4(drawn);\n"
     "}\n";
 
+/* Hades: the GUI cache (dvbridge_source_gui_cache(), dvbridge_source.h). 6c, in place of 6 where it
+ * is asked for: the blocks of the GUI texture, in two draws as 6 (4 x 4 texels, then 4 x 4 of those),
+ * with in red what 6 writes (anything drawn), in green whether every texel is opaque (alpha 1), and
+ * in blue whether one of them is not the texel it was at the frame before (prev, a copy that 6p
+ * keeps): read for an opaque 4 x 4 only (only those are kept). A texel beyond the texture read is
+ * the last one of its row or column, as for 6. */
+static const char GUI_BLOCKS[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D gui;\n"
+    "uniform highp sampler2D prev;\n"
+    "uniform ivec2 gui_size;\n" /* of the texture read */
+    "uniform int from_gui;\n"   /* 1: from the GUI texture and prev; 0: from the draw before */
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * 4;\n"
+    "    ivec2 last = gui_size - 1;\n"
+    "    float most = 0.0;\n"
+    "    if (from_gui == 0) {\n"
+    "        float opaque = 1.0, changed = 0.0;\n"
+    "        for (int y = 0; y < 4; ++y)\n"
+    "            for (int x = 0; x < 4; ++x) {\n"
+    "                vec4 t = texelFetch(gui, min(b0 + ivec2(x, y), last), 0);\n"
+    "                most = max(most, t.r);\n"
+    "                opaque = min(opaque, t.g);\n"
+    "                changed = max(changed, t.b);\n"
+    "            }\n"
+    "        color = vec4(most > 0.0 ? 1.0 : 0.0, opaque, changed, 0.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    bool opaque = true;\n"
+    "    for (int y = 0; y < 4; ++y)\n"
+    "        for (int x = 0; x < 4; ++x) {\n"
+    "            float a = texelFetch(gui, min(b0 + ivec2(x, y), last), 0).a;\n"
+    "            most = max(most, a);\n"
+    "            opaque = opaque && a == 1.0;\n"
+    "        }\n"
+    "    bool changed = false;\n"
+    "    if (opaque)\n"
+    "        for (int y = 0; y < 4; ++y)\n"
+    "            for (int x = 0; x < 4; ++x) {\n"
+    "                ivec2 q = min(b0 + ivec2(x, y), last);\n"
+    "                changed = changed || texelFetch(gui, q, 0) != texelFetch(prev, q, 0);\n"
+    "            }\n"
+    "    color = vec4(most > 0.0 ? 1.0 : 0.0, opaque ? 1.0 : 0.0, changed ? 1.0 : 0.0, 0.0);\n"
+    "}\n";
+
+/* Hades: 6p. prev made the GUI texture again where a block of 16 x 16 texels changed (a quad for
+ * each block, outside the clip volume where it did not): the texels compared at the next frame */
+static const char PREV_VERTEX[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D gui_tiles;\n"
+    "uniform ivec2 gui_size;\n"
+    "const int corner_x[6] = int[6](0, 1, 0, 0, 1, 1);\n"
+    "const int corner_y[6] = int[6](0, 0, 1, 1, 0, 1);\n"
+    "void main()\n"
+    "{\n"
+    "    int columns = (gui_size.x + " DRAWN_STRING(DRAWN_TILE) " - 1) / " DRAWN_STRING(DRAWN_TILE) ";\n"
+    "    int quad = gl_VertexID / 6, corner = gl_VertexID - quad * 6;\n"
+    "    ivec2 t = ivec2(quad % columns, quad / columns);\n"
+    "    if (texelFetch(gui_tiles, t, 0).b < 0.5) {\n"
+    "        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    ivec2 a = t * " DRAWN_STRING(DRAWN_TILE) ";\n"
+    "    ivec2 b = min(a + " DRAWN_STRING(DRAWN_TILE) ", gui_size);\n"
+    "    ivec2 q = ivec2(corner_x[corner] != 0 ? b.x : a.x, corner_y[corner] != 0 ? b.y : a.y);\n"
+    "    gl_Position = vec4(vec2(q) / vec2(gui_size) * 2.0 - 1.0, 0.0, 1.0);\n"
+    "}\n";
+static const char PREV_COPY[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "uniform highp sampler2D gui;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    color = texelFetch(gui, ivec2(gl_FragCoord.xy), 0);\n"
+    "}\n";
+
+/* Hades: 7c, in place of 7 where the cache is asked for: the flag of 7 (red, the same expressions),
+ * and of the tiles that may be kept (allowed, not in the first row of the raster, every block they
+ * may read opaque and unchanged) those whose kept bytes hold (state) are copied (green) and the
+ * others are packed into the cache (blue); and in a second target the state after the changes of
+ * this frame (a tile that may read a block that changed holds nothing) */
+static const char DECIDE[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D gui_tiles;\n"
+    "uniform highp sampler2D state;\n"
+    "uniform ivec2 gui_size;\n"
+    "uniform int allowed;\n"
+    "layout(location = 0) out vec4 color;\n"
+    "layout(location = 1) out vec4 kept;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 t = ivec2(gl_FragCoord.xy);\n"
+    "    vec2 scale = vec2(gui_size) / vec2(3840.0, 2160.0);\n"
+    "    float x0 = float(t.x * " DRAWN_STRING(DRAWN_TILE) ") + 0.5;\n"
+    "    float x1 = float(min(t.x * " DRAWN_STRING(DRAWN_TILE) " + " DRAWN_STRING(DRAWN_TILE) ", 3840) - 1) + 0.5;\n"
+    "    float y0 = float(t.y * " DRAWN_STRING(DRAWN_TILE) ") + 0.5;\n"
+    "    float y1 = float(min(t.y * " DRAWN_STRING(DRAWN_TILE) " + " DRAWN_STRING(DRAWN_TILE) ", 2160) - 1) + 0.5;\n"
+    "    int c0 = int(floor(x0 * scale.x - 0.5)) - " DRAWN_STRING(DRAWN_MARGIN) ";\n"
+    "    int c1 = int(floor(x1 * scale.x - 0.5)) + 1 + " DRAWN_STRING(DRAWN_MARGIN) ";\n"
+    "    int r0 = int(floor(float(gui_size.y) - 0.5 - y1 * scale.y)) - " DRAWN_STRING(DRAWN_MARGIN) ";\n"
+    "    int r1 = int(floor(float(gui_size.y) - 0.5 - y0 * scale.y)) + 1 + " DRAWN_STRING(DRAWN_MARGIN) ";\n"
+    "    ivec2 last = gui_size - 1;\n"
+    "    ivec2 g0 = clamp(ivec2(c0, r0), ivec2(0), last) / " DRAWN_STRING(DRAWN_TILE) ";\n"
+    "    ivec2 g1 = clamp(ivec2(c1, r1), ivec2(0), last) / " DRAWN_STRING(DRAWN_TILE) ";\n"
+    "    float drawn = 0.0, opaque = 1.0, changed = 0.0;\n"
+    "    for (int y = g0.y; y <= g1.y; ++y)\n"
+    "        for (int x = g0.x; x <= g1.x; ++x) {\n"
+    "            vec4 f = texelFetch(gui_tiles, ivec2(x, y), 0);\n"
+    "            drawn = max(drawn, f.r);\n"
+    "            opaque = min(opaque, f.g);\n"
+    "            changed = max(changed, f.b);\n"
+    "        }\n"
+    "    bool valid = texelFetch(state, t, 0).r > 0.5 && changed < 0.5;\n"
+    "    bool can = allowed != 0 && t.y > 0 && opaque > 0.5 && changed < 0.5;\n"
+    "    color = vec4(drawn, can && valid ? 1.0 : 0.0, can && !valid ? 1.0 : 0.0, 0.0);\n"
+    "    kept = vec4(valid ? 1.0 : 0.0);\n"
+    "}\n";
+
+/* Hades: 9. Of the tiles packed into the cache (drawn as the tiled passes, mode 7, into a quarter of
+ * the raster: a fragment for each 4 x 4 pixels), whether every pixel came out of the composite with
+ * an alpha of exactly 1 (2 - a, a = 1: what was drawn over it is opaque), from the picture drawn over
+ * (rows of the raster, as pass 4 reads it) */
+static const char OPAQUE[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D drawn;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * 4;\n"
+    "    bool opaque = true;\n"
+    "    for (int y = 0; y < 4; ++y)\n"
+    "        for (int x = 0; x < 4; ++x)\n"
+    "            opaque = opaque && texelFetch(drawn, b0 + ivec2(x, y), 0).a == 1.0;\n"
+    "    color = vec4(opaque ? 1.0 : 0.0);\n"
+    "}\n";
+/* ... and the state of each tile after this frame: a tile packed into the cache holds its bytes
+ * where all of its 16 x 16 were; every other tile, as 7c left it */
+static const char STATE[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D quarter;\n"
+    "uniform highp sampler2D drawn_tiles;\n"
+    "uniform highp sampler2D state;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 t = ivec2(gl_FragCoord.xy);\n"
+    "    bool valid = texelFetch(state, t, 0).r > 0.5;\n"
+    "    if (texelFetch(drawn_tiles, t, 0).b > 0.5) {\n"
+    "        valid = true;\n"
+    "        for (int y = 0; y < 4; ++y)\n"
+    "            for (int x = 0; x < 4; ++x)\n"
+    "                valid = valid && texelFetch(quarter, t * 4 + ivec2(x, y), 0).r > 0.5;\n"
+    "    }\n"
+    "    color = vec4(valid ? 1.0 : 0.0);\n"
+    "}\n";
+/* Hades: 10. The kept bytes, into the framebuffer (drawn as the tiled passes, mode 8): the cache holds
+ * the rows of the raster */
+static const char COPY[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D cache;\n"
+    "uniform uint flip_y;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    "    color = texelFetch(cache, p, 0);\n"
+    "}\n";
+/* Hades: the check of the cache (dvbridge_source_gui_cache_check()): a tile copied whose bytes are
+ * not those packed again (a fragment for each tile) */
+static const char CHECK[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D cache;\n"
+    "uniform highp sampler2D again;\n"
+    "uniform highp sampler2D drawn_tiles;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 t = ivec2(gl_FragCoord.xy);\n"
+    "    bool differ = false;\n"
+    "    if (texelFetch(drawn_tiles, t, 0).g > 0.5)\n"
+    "        for (int y = 0; y < " DRAWN_STRING(DRAWN_TILE) "; ++y)\n"
+    "            for (int x = 0; x < " DRAWN_STRING(DRAWN_TILE) "; ++x) {\n"
+    "                ivec2 p = t * " DRAWN_STRING(DRAWN_TILE) " + ivec2(x, y);\n"
+    "                differ = differ || texelFetch(cache, p, 0).rgb != texelFetch(again, p, 0).rgb;\n"
+    "            }\n"
