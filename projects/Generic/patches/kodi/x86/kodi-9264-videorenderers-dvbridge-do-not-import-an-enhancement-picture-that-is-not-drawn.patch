From 0b7b8500283816671eeb61c38defc72789aec7cd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:14:01 +0000
Subject: [PATCH] VideoRenderers/DVBridge: do not import an enhancement picture
 that is not drawn

A profile 7 enhancement picture whose metadata reconstructs no residual
(MEL, or a FEL picture whose NLQ changes nothing) was mapped from VAAPI
and imported into EGL images and textures for every frame, and libplacebo
then dropped it before drawing anything: pass_init() of renderer.c removes
an enhancement layer whose mapping has nlq_active false, before the passes
are made, and the bridge's own pairing gives the same transport metadata
either way (the residual is neither drawn nor omitted).

The mapping that RenderDVBridge() already makes before the frame
(CDVBridgeGLES::Foresee()) tells it; PrepareConversion() asks the same.
Such a picture is now not given to the renderer, and is still reported as
a layer that carries no residual ("MEL" in the player information, the
first-frame log). Where the metadata cannot be mapped the layer is given as
before. The layer is still decoded: its pictures are references of the
ones after them, they carry the metadata of their access unit, and a
stream can switch between FEL and MEL pictures from one frame to the next.

Tested on the host (FEL test stream, zink on lavapipe): with a copy of the
metadata of each picture whose NLQ is made trivial, the float picture, the
packed transport bytes, the directly drawn transport bytes and the picture
for output as HDR10 are the same with the layer and without it in all six
pictures; with the metadata as it is, they differ (the test can tell).
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 32 ++++++++++++++-----
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  9 +++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 12 +++++--
 3 files changed, 41 insertions(+), 12 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 54ce800..7677b4b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -341,10 +341,12 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
     // its residual, which that counted as omitted.)
     const bool omitted = dvbridge_render_residual_omitted(m_renderer);
     const bool fel = enhancement && dvbridge_render_residual_drawn(m_renderer);
+    // a layer that is there and carries no residual: imported or, since it is not drawn, not
+    const bool layered = enhancement || m_layerWithoutResidual;
     m_pendingInfo = CDVPlaybackInfo::HDMI | (fel ? CDVPlaybackInfo::FEL : 0u);
     m_pendingDetail = {};
     m_pendingDetail.valid = true;
-    m_pendingDetail.enhancement = enhancement != nullptr;
+    m_pendingDetail.enhancement = layered;
     m_pendingDetail.fel = fel;
     m_pendingDetail.felWithoutLayer = omitted;
     for (int i = 0; i < parsed->num_ext_blocks; ++i)
@@ -404,8 +406,8 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
                 base.width, base.height, static_cast<int>(base.layout),
                 fel       ? "with the residual of its enhancement layer"
                 : omitted ? "without the residual of its enhancement layer, which is missing"
-                : enhancement ? "with an enhancement layer that carries no residual"
-                              : "no enhancement layer",
+                : layered ? "with an enhancement layer that carries no residual"
+                          : "no enhancement layer",
                 (m_pendingInfo & CDVPlaybackInfo::CM4) ? "v4.0" : "v2.9",
                 DescribeMetadata(metadata.Data()), metadata.Size(), geometry.x, geometry.y,
                 geometry.width, geometry.height, m_direct ? "packed" : "float-composition");
@@ -515,11 +517,17 @@ bool CDVBridgeGLES::Foresee(const CDVMetadataBuffer& metadata,
 }
 
 bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancement,
-                                  const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked)
+                                  const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked,
+                                  bool layerWithoutResidual)
 {
   m_prepared = m_packed = false;
+  m_layerWithoutResidual = !enhancement && layerWithoutResidual;
   if (!enhancement)
-    return Prepare(base, nullptr, metadata, geometry, allowPacked);
+  {
+    const bool result = Prepare(base, nullptr, metadata, geometry, allowPacked);
+    m_layerWithoutResidual = false;
+    return result;
+  }
   // (the import of the layer clears them too, without a word)
   TakeStaleGLErrors("a picture is prepared");
   dvbridge_dmabuf imported{};
@@ -653,6 +661,14 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
   }
   // The enhancement layer as for native output: a picture that cannot be had is left out (the
   // residual of a FEL picture is then omitted), not a reason to lose the frame.
+  // Hades: and one whose residual the metadata does not reconstruct (MEL, or NLQ that changes
+  // nothing) is not imported: libplacebo leaves such a layer out before it draws anything.
+  dvbridge_color residual{};
+  const bool unused = enhancement && dvbridge_map_color(&residual, metadata.Data(), metadata.Size(),
+                                                        true, nullptr) &&
+                      !residual.dovi.nlq_active;
+  if (unused)
+    enhancement = nullptr;
   dvbridge_dmabuf imported{};
   bool mapped = false;
   bool layered = false;
@@ -686,7 +702,7 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
     m_convertWidth = width;
     m_convertHeight = height;
     m_convertedFel += fel ? 1 : 0;
-    m_convertLayers = fel ? "FEL" : omitted ? "FELGAP" : layered ? "MEL" : "BL";
+    m_convertLayers = fel ? "FEL" : omitted ? "FELGAP" : layered || unused ? "MEL" : "BL";
     m_convertInfo = CDVPlaybackInfo::HDR10 | (fel ? CDVPlaybackInfo::FEL : 0u);
     if (!m_converted++)
       CLog::Log(LOGINFO,
@@ -695,8 +711,8 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
                 base.width, base.height,
                 fel       ? "with the residual of its enhancement layer"
                 : omitted ? "without the residual of its enhancement layer, which is missing"
-                : layered ? "with an enhancement layer that carries no residual"
-                          : "no enhancement layer",
+                : layered || unused ? "with an enhancement layer that carries no residual"
+                                    : "no enhancement layer",
                 view.dst_width, view.dst_height, width, height,
                 DescribeMetadata(metadata.Data()));
   }
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 7747bde..38847b0 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -41,8 +41,13 @@ public:
   void Reset();
   bool Prepare(const Layer& base, const Layer* enhancement,
                const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked = false);
+  //! \param layerWithoutResidual the picture has an enhancement picture that is not given
+  //!        (enhancement is nullptr) because its metadata reconstructs no residual with it (MEL,
+  //!        or NLQ that changes nothing): libplacebo would not sample it. Said in the player
+  //!        information and the log as a layer that carries no residual, as when it is imported.
   bool PrepareHardware(const Layer& base, const AVFrame* enhancement,
-                       const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked = false);
+                       const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked = false,
+                       bool layerWithoutResidual = false);
   unsigned int GetPQTexture() const;
   unsigned int GetPQFramebuffer();
   //! The prepared frame is in the PQ texture (full-precision path), so it can take overlays;
@@ -161,6 +166,8 @@ private:
   //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
   //! \param before what runs next, for the log
   void TakeStaleGLErrors(const char* before);
+  //! Hades: see PrepareHardware()
+  bool m_layerWithoutResidual = false;
   DVBRIDGE::DiagnosticFailures m_failures;
   unsigned int m_staleGLErrors = 0; //!< times that TakeStaleGLErrors() found some
   bool m_reportedFrame{false};
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 4ac0553..756e71e 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1262,7 +1262,8 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   int l5[4];
   bool residual = false;
   uint64_t foreseen = 0;
-  if (CDVBridgeGLES::Foresee(metadata, layered, l5, residual))
+  const bool foresaw = CDVBridgeGLES::Foresee(metadata, layered, l5, residual);
+  if (foresaw)
     foreseen = CDVFrameLoad::Residual(m_dvPathLoad[layered].Take(layer.width, layer.height, l5[0],
                                                                  l5[1], l5[2], l5[3], residual),
                                       residual && !m_dvResidualLost);
@@ -1284,8 +1285,13 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   const bool direct = m_dvPath[layered].Direct(foreseen);
   // (the two ways of drawing its load are being compared: its time says nothing of its level)
   const bool comparing = m_dvPath[layered].Comparing(foreseen);
-  m_dvFrame = m_dvBridge->PrepareHardware(layer, enhancement, metadata, geometry,
-                                          overlayFree && direct);
+  // Hades: an enhancement picture whose residual the metadata does not reconstruct (MEL, or NLQ
+  // that changes nothing) is not imported. libplacebo leaves such a layer out before it draws
+  // anything (pass_init()), so the frame is the same without it, to the bit.
+  const bool layerWithoutResidual = layered && foresaw && !residual;
+  m_dvFrame = m_dvBridge->PrepareHardware(layer, layerWithoutResidual ? nullptr : enhancement,
+                                          metadata, geometry, overlayFree && direct,
+                                          layerWithoutResidual);
   if (m_dvFrame && overlayFree)
     m_dvPlainDirect = m_dvBridge->Direct() ? 1 : 0;
   // The load it turned out to be of: the same frame, with or without its residual.
-- 
2.53.0

