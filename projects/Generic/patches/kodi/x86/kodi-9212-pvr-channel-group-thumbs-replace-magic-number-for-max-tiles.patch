From 61efc05956c94609a872e270fcbd54b9cca6a032 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 12 Oct 2026 21:46:18 +0200
Subject: [PATCH] [pvr] Channel group thumbs: Replace magic number for max
 tiles

---
 xbmc/pvr/PVRChannelGroupImageFileLoader.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp b/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
index 2ff79b4..2a66476 100644
--- a/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
+++ b/xbmc/pvr/PVRChannelGroupImageFileLoader.cpp
@@ -16,6 +16,11 @@
 #include "pictures/Picture.h"
 #include "utils/log.h"
 
+namespace
+{
+constexpr size_t MAX_THUMB_TILES = 9;
+} // unnamed namespace
+
 bool PVR::CPVRChannelGroupImageFileLoader::CanLoad(const std::string& specialType) const
 {
   return specialType == "pvr";
@@ -46,7 +51,7 @@ std::vector<std::string> PVR::CPVRChannelGroupImageFileLoader::GetChannelGroupIc
     if (!icon.empty())
       icons.emplace_back(icon);
 
-    if (icons.size() == 9) // limit number of tiles
+    if (icons.size() == MAX_THUMB_TILES)
       break;
   }
   return icons;
-- 
2.53.0

