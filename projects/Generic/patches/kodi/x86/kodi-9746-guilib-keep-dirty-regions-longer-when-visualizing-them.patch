From b9ccf151d1007a2f3b77965d4812ee0f17e470e8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 31 Oct 2026 01:40:11 +0100
Subject: [PATCH] [guilib] Keep dirty regions longer when visualizing them

Visualizing dirty regions keeps them for 20 frames so they stay
visible, but since they are kept independently of the buffer age,
they were dropped after 11 frames like when not visualizing.
---
 xbmc/guilib/GUIWindowManager.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index 15eafdb..c7ef43a 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -1451,7 +1451,7 @@ bool CGUIWindowManager::Render()
   // the buffer age counts presented frames and varies between frames, so keep the regions
   // independently of it and only age them when a frame was presented
   if (m_presentedFrame)
-    m_tracker.CleanMarkedRegions(MAX_BUFFER_AGE + 1);
+    m_tracker.CleanMarkedRegions((visualizeDirtyRegions ? bufferAge : MAX_BUFFER_AGE) + 1);
   m_presentedFrame = false;
 
   // one frame more than needed, as some platforms report a fixed buffer age
-- 
