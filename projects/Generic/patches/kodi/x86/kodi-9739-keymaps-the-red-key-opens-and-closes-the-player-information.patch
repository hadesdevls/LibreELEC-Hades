From a16e8fd0db7c4bba6eefb89700211cc71efb98b6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:22:07 +0000
Subject: [PATCH] keymaps: the red key opens and closes the player information

The video OSD has had a button for the player information (key O on a
keyboard, "Info" on a Harmony remote). A TV remote over CEC reaches the
"title" key that opens it only through "Setup menu", "Dot", "Return"
(analogue) and "Next favourite", which a TV remote may not have, while it
sends the colour keys (CEC F2 is red). In a video the red key did nothing
useful (the global map opens the TV channels). It now opens the player
information, and closes it from the information itself and from the OSD of
information; the Harmony map of Kodi already has red there.
---
 system/keymaps/remote.xml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/system/keymaps/remote.xml b/system/keymaps/remote.xml
index 5549584..0959b99 100644
--- a/system/keymaps/remote.xml
+++ b/system/keymaps/remote.xml
@@ -196,6 +196,12 @@
       <start>OSD</start>
       <select>OSD</select>
       <title>PlayerProcessInfo</title>
+      <!-- Hades: the red key opens (and closes) the player information. A TV remote over CEC reaches
+           the "title" key that opens it in Kodi only through "Setup menu", "Dot", "Return" (analogue)
+           and "Next favourite" (PeripheralCecAdapter.cpp), which the remote of a TV may not have; it
+           sends the colour keys (F2 is red). While a video plays the red key does nothing else (the
+           global map opens the TV channels), and it is what the Harmony map has (customcontroller.Harmony.xml) -->
+      <red>PlayerProcessInfo</red>
       <info>Info</info>
       <guide>ActivateWindow(TVGuide)</guide>
       <teletext>ActivateWindow(Teletext)</teletext>
@@ -231,6 +237,7 @@
   <FullscreenInfo>
     <remote>
       <title>PlayerProcessInfo</title>
+      <red>PlayerProcessInfo</red>
       <info>Back</info>
       <menu>OSD</menu>
       <contentsmenu>OSD</contentsmenu>
@@ -713,12 +720,14 @@
   <PlayerProcessInfo>
     <remote>
       <title>PlayerProcessInfo</title>
+      <red>PlayerProcessInfo</red>
     </remote>
   </PlayerProcessInfo>
   <!-- Hades: the player information of Hades (CGUIDialogHadesPlayerInfo) -->
   <hadesplayerinfo>
     <remote>
       <title>PlayerProcessInfo</title>
+      <red>PlayerProcessInfo</red>
     </remote>
   </hadesplayerinfo>
   <FullScreenLiveTV>
-- 
