From 9399602c995f4cf5ffd519ec8c1a225a4224d841 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 03:43:14 +0000
Subject: [PATCH] windowing/gbm: a refused HDR10+ InfoFrame takes nothing else
 with it

SetHDR10Plus() queued the first HDR10+ payload of a video in the
request that also carried its HDR_OUTPUT_METADATA and the mode held for
it (the first frame after Configure()). Where the driver refuses
HDR10PLUS_VSIF by design (i915 at 2160p24, 25 and 30, linux-9982; GA10x
with the ACR workaround of RM and HDMI VRR on NVIDIA), the test commit
failed, CDRMAtomic fell back to the whole request before, the next
frame's SettleHDR() saw that the HDR signalling did not go in and set
SDR, and nothing asked for it again: the film went out as PQ without
HDR metadata. The review reproduced it with a host model.

Now a payload is never queued in a request that changes the HDR
signalling (HDR_OUTPUT_METADATA, Colorspace) or carries a modeset
(CHDR10PlusOutput::Output::alone): the next frame sends it. And a test
commit that fails with a payload is made again without it
(CHDR10PlusOutput::Without(): HDR10PLUS_VSIF 0) before the fallback;
the refusal counts as before, and after REFUSED_AFTER of them HDR10+
stops for the video. So user space keeps HDR10, as linux-9982 says.

Host test: the review's model, with this (hdr10plus_refused_model.cpp):
i915 at 2160p24, the HDR10 and the mode of the film stay and HDR10+
stops after 8 refusals; a driver that takes HDR10+ sends it from the
second frame. Against Kodi as it was it fails as the review found. The
second test in DrmAtomicCommit() and the hold in SetHDR10Plus() are
checked in the source, and fail on the tree before.
---
 xbmc/windowing/gbm/HDR10PlusOutput.h | 23 ++++++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp  |  3 +++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 27 +++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.h   |  9 +++++++++
 4 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index 3dae428..22eb541 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -47,6 +47,10 @@ namespace GBM
  * like that HDR10+ stops for the video, and the output is HDR10. A new video tries again
  * (NewVideo()).
  *
+ * A payload is never queued in a request that changes the HDR signalling or the mode (Output::alone),
+ * and a test that fails with one is made again without it (Without()), so that a refusal takes
+ * nothing else of the request with it.
+ *
  * Only what is decided is here, with nothing of DRM in it, so that a test can run it.
  */
 class CHDR10PlusOutput
@@ -71,6 +75,10 @@ public:
     bool pq = false; //!< the HDR of the video is signalled, as PQ
     bool display = false; //!< the display declares HDR10+
     bool driver = false; //!< the connector has HDR10PLUS_VSIF
+    //! the request of the frame carries no change of the HDR signalling and no modeset. A payload
+    //! is never queued with one: a driver that refuses it would take the HDR10 or the mode of the
+    //! video with it (CDRMAtomic falls back to the request before). The next frame sends it.
+    bool alone = true;
   };
 
   //! What to queue for a frame (payload: its HDR10+ metadata, nothing without)
@@ -78,10 +86,23 @@ public:
   {
     const bool on = output.pq && output.display && output.driver && !m_refused;
     if (on && payload)
-      return m_queued == payload ? Step::NOTHING : Step::SEND;
+      return m_queued == payload || !output.alone ? Step::NOTHING : Step::SEND;
     return m_queued ? Step::CLEAR : Step::NOTHING;
   }
 
+  /*!
+   * \brief A test of a request failed whose HDR10PLUS_VSIF is inRequest: the value to put there
+   *        instead, so that the request is tested again without the InfoFrame (0: the frame goes
+   *        out as HDR10), or nothing when the request sends none. CDRMAtomic then falls back to
+   *        the request before only for what remains; the refusal counts here (Committed()).
+   */
+  static std::optional<uint64_t> Without(std::optional<uint64_t> inRequest)
+  {
+    if (!inRequest || *inRequest == 0)
+      return std::nullopt;
+    return 0;
+  }
+
   //! value was queued for HDR10PLUS_VSIF (a blob id, 0 for none), for payload (nothing for none)
   void Queued(uint64_t value, const std::optional<Payload>& payload)
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index ac86259..c96fba4 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2376,6 +2376,9 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
   output.pq = m_eotf == KODI::UTILS::Eotf::PQ;
   output.display = info && info->SupportsHDR10Plus();
   output.driver = connector->SupportsProperty(CHDR10PlusOutput::PROPERTY);
+  output.alone = !drm->ModesetPending() &&
+                 !drm->RequestValue(connector, "HDR_OUTPUT_METADATA") &&
+                 !drm->RequestValue(connector, "Colorspace");
 
   if (payload && output.pq && output.display && !output.driver &&
       !(m_hdr10PlusTold & TOLD_NO_DRIVER))
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index d93a824..d62c925 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -10,6 +10,7 @@
 
 #include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
+#include "windowing/gbm/HDR10PlusOutput.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
@@ -234,6 +235,19 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   }
 
   auto ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
+  // Hades: an HDR10+ InfoFrame that the driver refuses takes nothing else of the request with it:
+  // the request is tested again without it (CHDR10PlusOutput::Without())
+  if (ret < 0 && !strict && m_connector)
+  {
+    const auto without =
+        CHDR10PlusOutput::Without(m_req->Value(m_connector, CHDR10PlusOutput::PROPERTY));
+    if (without && m_req->AddProperty(m_connector, CHDR10PlusOutput::PROPERTY, *without))
+    {
+      CLog::LogF(LOGDEBUG, "test commit failed: ({}) - testing it again without {}",
+                 strerror(errno), CHDR10PlusOutput::PROPERTY);
+      ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
+    }
+  }
   if (ret < 0)
   {
     if (strict)
@@ -681,6 +695,19 @@ std::vector<CDRMObject*> CDRMAtomic::CDRMAtomicRequest::Naming(const char* name)
   return objects;
 }
 
+std::optional<uint64_t> CDRMAtomic::CDRMAtomicRequest::Value(CDRMObject* object,
+                                                            const char* name) const
+{
+  const uint32_t propertyId = object ? object->GetPropertyId(name) : 0;
+  const auto properties = m_atomicRequestItems.find(object);
+  if (propertyId == 0 || properties == m_atomicRequestItems.end())
+    return std::nullopt;
+  const auto value = properties->second.find(propertyId);
+  if (value == properties->second.end())
+    return std::nullopt;
+  return value->second;
+}
+
 void CDRMAtomic::CDRMAtomicRequest::CacheProperties()
 {
   for (const auto& [object, properties] : m_atomicRequestItems)
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index a4ce335..c41dfdd 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -65,6 +65,13 @@ public:
   //! Hades: the next commit would carry more than a framebuffer: properties added since the last
   //! one, or a modeset that is pending
   bool HasPendingRequest() const { return m_need_modeset || (m_req && !m_req->Empty()); }
+  //! Hades: the next commit is a modeset (the first one, or one asked for)
+  bool ModesetPending() const { return m_need_modeset; }
+  //! Hades: the value of a property in the request being built, nothing when it does not carry it
+  std::optional<uint64_t> RequestValue(CDRMObject* object, const char* name) const
+  {
+    return m_req ? m_req->Value(object, name) : std::nullopt;
+  }
   //! Hades: the last commit did not go out as it was asked: the driver refused it, or its test
   //! (the frame then went out with the request before it), or there was no framebuffer
   bool LastCommitRefused() const { return m_lastCommitRefused; }
@@ -158,6 +165,8 @@ private:
     bool AddProperty(CDRMObject* object, const char* name, uint64_t value);
     //! Hades: the objects of which this request names the property (FenceFallback())
     std::vector<CDRMObject*> Naming(const char* name) const;
+    //! Hades: the value of a property in this request, nothing when it does not carry it
+    std::optional<uint64_t> Value(CDRMObject* object, const char* name) const;
     //! Hades: the blob of the mode that this request carries lives as long as it does (a blob
     //! that is destroyed gives its id back to the kernel, which gives it to the next one)
     void KeepModeBlob(CDRMPropertyBlob blob) { m_modeBlob = std::move(blob); }
