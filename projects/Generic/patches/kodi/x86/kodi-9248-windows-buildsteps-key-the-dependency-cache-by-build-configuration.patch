From a51af61ecceac333db9ec498feedb8251261b11a Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sat, 10 Oct 2026 19:26:11 +0100
Subject: [PATCH] [Windows][buildsteps] Key the dependency cache by build
 configuration

The bundled libraries are built for the configuration being built, so
project/BuildDependencies/<platform> from a Release build is not usable by a
Debug build. The cache key did not include the configuration, so a Debug build
restored a Release build's directory, and the reverse.

The key now includes buildconfig. BuildSetup.bat builds Release when the
variable is not set, so the key takes the same default and a build that leaves
it unset shares its entry with one that sets it to Release.

Run against a throwaway workspace: with the configuration unset or Release the
key is the same and a cached Release directory is restored; with Debug the key
differs and the Release directory stays in the cache. Before this change the
Debug run restored it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 90a69eb9e573638c85ac027710191ca33d81c018)
---
 tools/buildsteps/windows/download-dependencies.bat | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/buildsteps/windows/download-dependencies.bat b/tools/buildsteps/windows/download-dependencies.bat
index 2767ee0..30e5b38 100644
--- a/tools/buildsteps/windows/download-dependencies.bat
+++ b/tools/buildsteps/windows/download-dependencies.bat
@@ -95,7 +95,9 @@ SET VSWHERE_ARGS=-latest -property installationVersion
 IF "%prerelease%" == "true" SET VSWHERE_ARGS=%VSWHERE_ARGS% -prerelease
 FOR /F "usebackq delims=" %%v IN (`"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" %VSWHERE_ARGS%`) DO SET VS_VERSION=%%v
 FOR /F %%r IN ('git -C "%WORKSPACE%" rev-list HEAD --max-count=1 -- CMakeLists.txt cmake/modules cmake/platform cmake/scripts project/BuildDependencies/scripts tools/buildsteps/windows tools/depends') DO SET DEPENDS_REVISION=%%r
-FOR /F %%h IN ('ECHO %TARGETPLATFORM% %DEPENDS_REVISION% %VS_VERSION%^| git hash-object --stdin') DO SET BUILD_HASH=%%h
+REM BuildSetup.bat builds Release when buildconfig is not set
+IF NOT DEFINED buildconfig SET buildconfig=Release
+FOR /F %%h IN ('ECHO %TARGETPLATFORM% %DEPENDS_REVISION% %VS_VERSION% %buildconfig%^| git hash-object --stdin') DO SET BUILD_HASH=%%h
 EXIT /B 0
 
 :restoreCachedBuild
