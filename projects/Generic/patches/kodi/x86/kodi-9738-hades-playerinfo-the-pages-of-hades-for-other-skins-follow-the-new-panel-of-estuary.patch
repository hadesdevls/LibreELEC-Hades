 system/hades/DefaultIconWarning.png       |   Bin 0 -> 1205 bytes
 system/hades/DialogHadesPlayerInfo.xml    | 11634 ++++++++++++++------
 system/hades/HadesIncludes.xml            |   338 +-
 system/hades/README.txt                   |     9 +-
 system/hades/icons-menumarks-tick.png     |   Bin 0 -> 267 bytes
 tools/hades-playerinfo/make-playerinfo.py |    38 +-
 7 files changed, 8749 insertions(+), 3270 deletions(-)
 create mode 100644 system/hades/DefaultIconInfo.png
 create mode 100644 system/hades/DefaultIconWarning.png
