+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: how long after the time that the player's clock calls for a frame its flip comes,
+ *        by the way it was presented: what the source adds to the sync of the picture with the
+ *        sound
+ *
+ * The render manager chooses a frame for the display latency that Kodi takes (the buffers, plus
+ * one, in refresh periods, less GetFrameLatencyAdjustment()), the same for every way of presenting
+ * it. Read in the code, the ways do not take the same time to put a frame on the screen: the
+ * ordinary output waits for the flip of the frame before it and commits without waiting (about two
+ * periods); native Dolby Vision presented the way that waits commits and returns with its flip
+ * (about one); a frame ahead is chosen a period earlier and flipped about two later. If so, a
+ * picture presented the way that waits would come a refresh earlier than the others, against the
+ * same sound. Nothing is changed for it until it is measured: the time the clock calls for a frame
+ * (its pts, from the clock when it was chosen, CRenderManager::PrepareNextRender()) and the time of
+ * its flip, by the kernel's clock (the out-fence of its commit, or the return of a commit that
+ * waits for it) are told here, per way, for the log. A positive time: the picture after its time;
+ * negative: before.
+ *
+ * This class only counts; a test builds it on the host.
+ */
+class CPresentLag
+{
+public:
+  enum class Way
+  {
+    WAITING, //!< native Dolby Vision, a commit that returns with its flip
+    AHEAD, //!< native Dolby Vision presented a frame ahead
+    ORDINARY, //!< the ordinary output of Kodi
+    COUNT
+  };
+
+  //! A frame whose clock time was dueNs was flipped at flipNs (the same monotonic clock). Times
+  //! more than two seconds apart say nothing of the sync (a pause, a stalled flip): left out.
+  void Add(Way way, int64_t dueNs, int64_t flipNs)
+  {
+    if (dueNs <= 0 || flipNs <= 0)
+      return;
+    const double ms = static_cast<double>(flipNs - dueNs) / 1e6;
+    if (ms > 2000.0 || ms < -2000.0)
+      return;
+    auto& w = m_ways[static_cast<size_t>(way)];
+    if (w.count == 0)
+    {
+      w.minMs = ms;
+      w.maxMs = ms;
+    }
+    w.count++;
+    w.sumMs += ms;
+    w.minMs = std::min(w.minMs, ms);
+    w.maxMs = std::max(w.maxMs, ms);
+  }
+
+  unsigned int Count(Way way) const { return m_ways[static_cast<size_t>(way)].count; }
+  double AverageMs(Way way) const
+  {
+    const auto& w = m_ways[static_cast<size_t>(way)];
+    return w.count ? w.sumMs / w.count : 0.0;
+  }
+
+  //! "the flips came A ms after the clock's time of their frames (min .. max) over N presented the
+  //! way that waits, ...", empty without any; latencyMs: the display latency that Kodi takes now
+  std::string Text(double latencyMs) const
+  {
+    std::string text;
+    static constexpr const char* NAMES[] = {"presented the way that waits",
+                                            "presented a frame ahead", "of the ordinary output"};
+    for (size_t i = 0; i < m_ways.size(); ++i)
+    {
+      const auto& w = m_ways[i];
+      if (!w.count)
+        continue;
+      char part[160];
+      std::snprintf(part, sizeof(part), "%s%.1f ms (%.1f to %.1f) over %u frames %s",
+                    text.empty() ? "" : ", ", w.sumMs / w.count, w.minMs, w.maxMs, w.count,
+                    NAMES[i]);
+      text += part;
+    }
+    if (text.empty())
+      return text;
+    char tail[96];
+    std::snprintf(tail, sizeof(tail), " (Kodi chooses the frames %.1f ms ahead of their flips)",
+                  latencyMs);
+    return "the flips came after the times that the player's clock called for their frames by " +
+           text + tail;
+  }
+
+  void Reset() { m_ways = {}; }
+
+private:
+  struct Stats
+  {
+    unsigned int count = 0;
+    double sumMs = 0.0;
+    double minMs = 0.0;
+    double maxMs = 0.0;
+  };
+  std::array<Stats, static_cast<size_t>(Way::COUNT)> m_ways{};
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 060ee89..81ee444 100644
