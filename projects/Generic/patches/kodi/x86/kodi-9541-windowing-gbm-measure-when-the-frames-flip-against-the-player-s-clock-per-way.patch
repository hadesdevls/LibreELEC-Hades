+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -161,6 +161,14 @@ bool WaitFence(int fd, int timeoutMs, int64_t* signalledNs = nullptr)
   close(fd);
   return signalled;
 }
+
+// Hades: now by the steady clock (CLOCK_MONOTONIC on Linux, the kernel's clock of the flips), in ns
+int64_t SteadyNowNs()
+{
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
 #endif
 } // namespace
 
