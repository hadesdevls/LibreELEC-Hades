diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 09adb4d..49eebf2 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -1265,6 +1265,25 @@ void CRenderManager::PrepareNextRender()
     combined = true;
   }
 
+#ifdef HAVE_DVBRIDGE
+  // Hades: when the player's clock calls for the frame chosen, by the steady clock, for the window
+  // system to tell how long after it the frame was flipped (CPresentLag). Only while the clock runs
+  // at the speed of the video: paused, or fast, there is no such time.
+  const auto chosen = [&](double pts)
+  {
+    const double speed = m_dvdClock.GetClockSpeed();
+    if (isPaused || pts == DVD_NOPTS_VALUE || speed < 0.9 || speed > 1.1)
+      return;
+    if (auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+            CServiceBroker::GetWinSystem()))
+      dvWindow->VideoFrameChosen(
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              std::chrono::steady_clock::now().time_since_epoch())
+              .count() +
+          static_cast<int64_t>((pts - frameOnScreen) / DVD_TIME_BASE * 1e9));
+  };
+#endif
+
   if (renderPts >= nextFramePts || m_forceNext)
   {
     // see if any future queued frames are already due
@@ -1308,6 +1327,9 @@ void CRenderManager::PrepareNextRender()
     m_presentsource = idx;
     m_queued.pop_front();
     m_presentpts = m_Queue[idx].pts - m_displayLatency;
+#ifdef HAVE_DVBRIDGE
+    chosen(m_Queue[idx].pts);
+#endif
     m_presentevent.notifyAll();
 
     m_playerPort->UpdateRenderBuffers(m_queued.size(), m_discard.size(), m_free.size());
@@ -1320,6 +1342,9 @@ void CRenderManager::PrepareNextRender()
     m_presentsource = m_queued.front();
     m_queued.pop_front();
     m_presentpts = m_Queue[m_presentsource].pts - m_displayLatency - frametime / 2;
+#ifdef HAVE_DVBRIDGE
+    chosen(m_Queue[m_presentsource].pts);
+#endif
     m_presentevent.notifyAll();
   }
 }
