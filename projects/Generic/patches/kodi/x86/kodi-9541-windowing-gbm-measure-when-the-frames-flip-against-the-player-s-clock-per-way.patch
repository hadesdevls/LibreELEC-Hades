+        }
         if (presented)
         {
           // (Hades: a mode that native output moved into went out with it: CDVModeMove)
@@ -728,6 +754,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     AnnounceHeldModeChange(false);
 #endif
     bool async = !videoLayer && m_eglFence;
+    int lagFd = -1; // (Hades: the out-fence of the frame before, to read when it flipped)
     if (rendered)
     {
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
@@ -736,6 +763,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         int fd = m_DRM->TakeOutFenceFd();
         if (fd != -1)
         {
+#ifdef HAVE_DVBRIDGE
+          // Hades: (EGL takes this fence; a copy of it says when that flip came, CPresentLag)
+          if (m_videoLagPendingNs > 0)
+            lagFd = dup(fd);
+#endif
           m_eglFence->CreateKMSFence(fd);
           m_eglFence->WaitSyncGPU();
         }
@@ -760,19 +792,41 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         // frame goes to its own commit, after that: a commit that FlipStalled() makes would
         // take it (and close it).
         if (m_eglFence->WaitSyncCPU(FLIP_STALL_WAIT))
+        {
           FlipCame();
+#ifdef HAVE_DVBRIDGE
+          // Hades: when the flip of the frame before came, against the player's clock (it has
+          // come: the copy of its fence is read at once, and closed)
+          if (int64_t flippedNs = 0;
+              lagFd >= 0 && WaitFence(std::exchange(lagFd, -1), 0, &flippedNs) && flippedNs > 0)
+            m_videoLag.Add(CPresentLag::Way::ORDINARY, m_videoLagPendingNs, flippedNs);
+#endif
+        }
         else if (FlipStalled())
           async = false;
         m_DRM->SetInFenceFd(fd);
       }
 #endif
     }
+    if (lagFd >= 0)
+      close(lagFd);
 
     // Hades: an output that FlipStalled() turned off and could not turn on again
     if (m_flipOutputOff)
       FlipOutputOn();
     CWinSystemGbm::FlipPage(rendered, videoLayer, async);
 #ifdef HAVE_DVBRIDGE
+    // Hades: the frame of this commit, whose flip comes before the next commit (async), or came
+    // with this one, which waited for it (CPresentLag); a line a minute while a video plays
+    m_videoLagPendingNs = 0;
+    if (m_lagFrameNs > 0)
+    {
+      if (async)
+        m_videoLagPendingNs = m_lagFrameNs;
+      else
+        m_videoLag.Add(CPresentLag::Way::ORDINARY, m_lagFrameNs, SteadyNowNs());
+    }
+    VideoLagReport();
     // (Hades: a commit that the driver refused went out as the one before it, without the change
     // of mode that it may carry)
     {
@@ -3035,6 +3089,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset)
   DVAheadForgetFlip();
   m_dvAheadShown = false;
   m_dvAheadLatencyMs = 0.0f;
+  m_dvLagAheadNs = 0; // (Hades: CPresentLag)
   m_dvAheadModeRead = false;
   m_dvAheadGui = -1;
   m_dvStepRead = false;
@@ -4013,6 +4068,10 @@ void CWinSystemGbmGLESContext::DVAheadFlipped(int64_t ns)
 {
   // Hades: that frame reached the display in time (CDVPresentStall)
   m_dvPresentStall.Flipped();
+  // Hades: ... and when, against the player's clock (CPresentLag)
+  if (m_dvLagAheadNs > 0 && ns > 0)
+    m_dvLag.Add(CPresentLag::Way::AHEAD, m_dvLagAheadNs, ns);
+  m_dvLagAheadNs = 0;
   // The time between the flips of two frames in a row, as the kernel tells them: what says
   // whether a refresh was missed while frames are presented a frame ahead, where the time that
   // a presentation takes says little.
@@ -4092,6 +4151,29 @@ void CWinSystemGbmGLESContext::DVAheadFailed(const char* what, bool forGood)
                       : ", and so are the frames after it in this video");
 }
 
+double CWinSystemGbmGLESContext::LagLatencyMs()
+{
+  return static_cast<double>(GetGfxContext().GetDisplayLatency()) -
+         static_cast<double>(GetFrameLatencyAdjustment());
+}
+
+void CWinSystemGbmGLESContext::VideoLagReport()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (m_videoLag.Count(CPresentLag::Way::ORDINARY) == 0)
+  {
+    m_videoLagSince = now;
+    return;
+  }
+  if (now - m_videoLagSince < std::chrono::seconds(60))
+    return;
+  CLog::Log(LOGINFO, "Video: in the last {} s, {}",
+            std::chrono::duration_cast<std::chrono::seconds>(now - m_videoLagSince).count(),
+            m_videoLag.Text(LagLatencyMs()));
+  m_videoLag.Reset();
+  m_videoLagSince = now;
+}
