 xbmc/windowing/gbm/PresentLag.h               | 125 ++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  86 ++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  33 +++++
 4 files changed, 269 insertions(+)
