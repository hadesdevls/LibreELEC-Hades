From 7bd83f8bb7ea293765407806614cd034890a1029 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 07:38:45 +0000
Subject: [PATCH] dvbridge: native output only in Dolby Vision transport modes

SupportsNativeDVOutput() accepted any 3840x2160 progressive mode, while
FlipDVBridgePage() accepted only 23.976 to 60 Hz. With the GUI at
2160p 100/120/144 Hz and the refresh-rate adjustment off (Kodi's
default), or a whitelist that picked 47.95/48/119.88 Hz, the verdict
said "available": the dual-layer decoder and the 8-bit transport were
set up, every frame was then refused before the commit, the picture
froze for two seconds and native output was disabled until Kodi
restarted, also for later playback at 24 to 60 Hz. Dolby Vision
Standard over HDMI goes up to 60 Hz, and the amdgpu backend accepts
only VICs 93 to 97.

One predicate, DVBRIDGE::IsTransportMode() (3840x2160 progressive at
23.976/24/25/29.97/30/50/59.94/60 Hz, no double scan), now decides both
the verdict ("mode", shown in the player information) and each flip.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 16 ++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 32 ++++++++++---------
 2 files changed, 33 insertions(+), 15 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 7f51490..728ee19 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -1,6 +1,8 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 #pragma once
 
+#include <initializer_list>
+
 class CDVDStreamInfo;
 class VideoPicture;
 
@@ -14,6 +16,20 @@ constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
          !softwareProbe && !interlaced && !stereo;
 }
 
+// Native Dolby Vision Standard output is sent as 3840x2160 progressive at a CTA rate from 23.976
+// to 60 Hz (VICs 93 to 97 and their 1000/1001 variants): Dolby Vision Standard over HDMI goes up
+// to 60 Hz, and the kernel backends accept only these timings.
+inline bool IsTransportMode(int width, int height, double refresh, bool interlaced)
+{
+  if (width != 3840 || height != 2160 || interlaced)
+    return false;
+  for (const double rate :
+       {24000.0 / 1001, 24.0, 25.0, 30000.0 / 1001, 30.0, 50.0, 60000.0 / 1001, 60.0})
+    if (refresh > rate - 0.012 && refresh < rate + 0.012)
+      return true;
+  return false;
+}
+
 bool WantsNativeOutput(const CDVDStreamInfo& stream);
 bool WantsNativeOutput(const VideoPicture* picture);
 } // namespace DVBRIDGE
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 2669cfe..15a61d5 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -15,6 +15,7 @@
 #include "cores/VideoPlayer/VideoReferenceClock.h"
 #include "drm/DRMAtomic.h"
 #ifdef HAVE_DVBRIDGE
+#include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "drm/DVBridgeState.h"
 #endif
 #include "drm/DRMLegacy.h"
@@ -312,6 +313,18 @@ bool CWinSystemGbm::SetFullScreen(bool fullScreen, RESOLUTION_INFO& res, bool bl
 }
 
 #ifdef HAVE_DVBRIDGE
+namespace
+{
+bool IsDVTransportMode(const drmModeModeInfo& mode)
+{
+  const double rate =
+      mode.htotal && mode.vtotal ? mode.clock * 1000.0 / mode.htotal / mode.vtotal : 0.0;
+  return DVBRIDGE::IsTransportMode(
+      mode.hdisplay, mode.vdisplay, rate,
+      (mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)) != 0);
+}
+} // namespace
+
 bool CWinSystemGbm::SupportsNativeDVOutput() const
 {
   const char* reason = nullptr;
@@ -351,11 +364,10 @@ bool CWinSystemGbm::SupportsNativeDVOutput() const
     code = "range";
     reason = "the display cannot select the RGB range (VCDB QS), needed with NVIDIA";
   }
-  else if (!mode || mode->hdisplay != 3840 || mode->vdisplay != 2160 ||
-           (mode->flags & DRM_MODE_FLAG_INTERLACE))
+  else if (!mode || !IsDVTransportMode(*mode))
   {
     code = "mode";
-    reason = "the output mode is not 3840x2160 progressive";
+    reason = "the output mode is not 3840x2160 progressive at 23.976 to 60 Hz";
   }
 
   // Log the verdict once per change, for diagnosing why Dolby Vision is (not) used.
@@ -415,18 +427,8 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore)
     const auto mode = drm->GetSelectedMode();
     const auto format = gbm_bo_get_format(bo);
     valid = gbm_bo_get_width(bo) == 3840 && gbm_bo_get_height(bo) == 2160 &&
-            (format == DRM_FORMAT_XRGB8888 || format == DRM_FORMAT_ARGB8888) &&
-            mode && mode->hdisplay == 3840 && mode->vdisplay == 2160 &&
-            !(mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN));
-    if (valid)
-    {
-      const double rate = mode->htotal && mode->vtotal
-                              ? mode->clock * 1000.0 / mode->htotal / mode->vtotal : 0.0;
-      valid = false;
-      for (double supported : {24000.0 / 1001, 24.0, 25.0, 30000.0 / 1001,
-                               30.0, 50.0, 60000.0 / 1001, 60.0})
-        valid |= std::abs(rate - supported) < 0.012;
-    }
+            (format == DRM_FORMAT_XRGB8888 || format == DRM_FORMAT_ARGB8888) && mode &&
+            IsDVTransportMode(*mode);
   }
   if (valid)
     valid = state.Stage(*drm, restore);
