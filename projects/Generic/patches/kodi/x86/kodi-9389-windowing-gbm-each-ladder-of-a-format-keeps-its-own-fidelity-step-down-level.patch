From 81c65da25b8be79c584d6dd39b8447e46a690d2f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:00:40 +0000
Subject: [PATCH] windowing/gbm: each ladder of a format keeps its own fidelity
 step-down level

The fidelity step-down (CDVStepDown) kept one level for each picture format, of one ladder (the levels
that change anything for its frames, dvbridge_render_step_levels()), and began the format again from
the faithful picture whenever the ladder of its frames changed. The ladder depends on the transport
the frame before went out in (0x7 or 0x1 with the source transport, 0xf or 0x9 converted). So:
 - one frame that the source transport could not carry (the composer of ETSI GS CCM 001 declined its
   metadata, its packing failed, the composer failed on the GPU until the next recovery) made the
   format forget what had been measured, twice: going and coming back. On a GPU that needs a lower
   level, that is the faithful picture again and several seconds of missed refreshes until it is
   measured behind again;
 - a renderer that has drawn nothing says the converted ladder, so the first frame of each session
   wiped the level that Recall() had brought from the session before for the source transport, the
   default: the memory of the levels never worked for it;
 - the time of a frame of the other transport counted for the ladder of the frame before it.

Now each ladder of a format has a level and measurements of its own: the frames of a format go on with
what was found for the ladder they come with, and one that a format has not had begins from the
faithful picture, as before. A change of ladder that changes the level is told (LADDER), and its first
frames are left out of the measurement, as after a change of level or of way. The window system tells
the time and the presentation of a frame with the ladder of the transport it was drawn in (Measured()
and Presented() take it; without it, the ladder its format came with last, as before), so they count
for that ladder and only at its level. Known() and Recall() keep a format once for each ladder.

Host test (dvstep_test_ccm.cpp, the step-down with the ladder of the composer, own copy): 144 checks, 6 new; with the step-down
before, the four that play a change of ladder fail (one frame of another ladder and back, a stretch of
it and back, a new session whose first frame comes with the other ladder, and the existing one that
goes back to a ladder after another video, which now keeps its level instead of measuring it again).
The integration's copy, unchanged, passes its 138 on the new header. Mutations: 21, M17 now the rule
of before, three new.
---
 xbmc/windowing/gbm/DVStepDown.h               | 110 ++++++++++++------
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  20 +++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   8 +-
 3 files changed, 96 insertions(+), 42 deletions(-)

diff --git a/xbmc/windowing/gbm/DVStepDown.h b/xbmc/windowing/gbm/DVStepDown.h
index eb06fe0..1e56b39 100644
--- a/xbmc/windowing/gbm/DVStepDown.h
+++ b/xbmc/windowing/gbm/DVStepDown.h
@@ -46,8 +46,15 @@ namespace GBM
  *
  * Each picture format (the load of CDVFrameLoad: size, active area, and whether the residual of
  * an enhancement layer is drawn) has a level of its own, 0 until its frames are found not to keep
- * up, and what is found of it is of one ladder: when the ladder of its frames changes (another
- * renderer), the format begins again from the faithful picture. Its frames are measured in windows
+ * up, and what is found of it is of one ladder. Hades: each ladder of a format has a level and
+ * measurements of its own. The frames of a format can come with another ladder for a while (another
+ * transport, where the source transport cannot carry a picture, or another renderer) and back: the
+ * format goes on with what was found for the ladder its frames come with, and begins one that it has
+ * not had from the faithful picture. (It began again from the faithful picture at each change of
+ * ladder, so that a single frame of another transport made it forget what had been measured, twice.)
+ * The time and the presentation of a frame count for the ladder it was drawn with, which the window
+ * system knows once it is drawn (the ladder that Draw() is given is that of the frame before).
+ * Its frames are measured in windows
  * of WINDOW frames of one level, one way of drawing, one pace and one refresh rate, leaving out the
  * frames with GUI elements (subtitles, the player bar, a capture), those of a picture that stands
  * still, the first seconds of a video and after a seek, and the first frames after a change of
@@ -118,7 +125,9 @@ public:
     NO_GAIN, //!< no level keeps up, and this one is the fastest that was measured
     NOTHING_KEEPS_UP, //!< ... and it is the level in use already (the level does not change)
     FITS, //!< what the level above would take now fits with room to spare: a level up
-    LADDER, //!< the levels that change anything are others: begun again from the faithful picture
+    //! the levels that change anything are others: the level found for that ladder (the faithful
+    //! picture where none was)
+    LADDER,
   };
 
   struct Step
@@ -211,31 +220,33 @@ public:
   /*!
    * \brief A frame of that format is to be drawn (with GUI elements or without)
    * \param ladder the levels that change anything for it (dvbridge_render_step_levels())
-   * \return its level; changed when the ladder is another one than what was found of the format
+   * \return its level; changed when its frames came with another ladder before and the level
+   *         found for this one is another (LADDER)
    */
   Step Draw(uint64_t format, unsigned int ladder)
   {
     Step step;
     ++m_clock;
-    Format* const found = format != 0 ? Find(format) : nullptr;
-    if (!found)
+    if (format == 0)
       return step;
-    Format& f = *found;
     ladder = Ladder(ladder);
-    if (f.ladder != ladder)
+    // Hades: the frames of the format came with another ladder last (another transport, another
+    // renderer, another composer): what was found for that one stays, for when they come with it
+    // again, and this one goes on from what was found for it
+    const Format* const last = Lookup(format);
+    const bool other = last && last->ladder != ladder;
+    const int from = last ? last->level : 0;
+    Format& f = *Find(format, ladder);
+    if (other)
     {
-      // What was found of its levels is of other work (another renderer, another composer)
-      const bool begun = f.ladder != 0;
-      step.from = f.level;
-      const uint64_t id = f.id;
-      f = Format();
-      f.id = id;
-      f.ladder = ladder;
-      if (begun && step.from != 0)
+      // (its first frames carry the change, as after one of level or of way)
+      f.skip = std::max(f.skip, SKIP);
+      if (from != f.level)
       {
         step.changed = true;
         step.why = Why::LADDER;
-        step.to = 0;
+        step.from = from;
+        step.to = f.level;
       }
     }
     const uint64_t away = m_clock - f.drawn;
@@ -259,6 +270,9 @@ public:
    * \param pace how frames are presented now
    * \param comparing the ways of drawing its format were being compared (CDVPathChoice)
    * \param direct it was drawn directly
+   * \param ladder Hades: the levels that changed anything for it, as the renderer told them once it
+   *        was drawn (dvbridge_render_step_levels()): it counts for that ladder of its format, and
+   *        only at the level of that ladder. 0: the ladder its format's frames came with last
    * \return when a window ends with it: a change of level of its format, or what it found
    */
   Step Measured(uint64_t format,
@@ -267,11 +281,12 @@ public:
                 double periodMs,
                 Pace pace,
                 bool comparing,
-                bool direct)
+                bool direct,
+                unsigned int ladder = 0)
   {
     if (format == 0 || !(ms > 0) || !std::isfinite(ms) || !(periodMs > 0) || !std::isfinite(periodMs))
       return Step();
-    Format* const found = Lookup(format);
+    Format* const found = ladder != 0 ? Lookup(format, Ladder(ladder)) : Lookup(format);
     if (!found || level != found->level)
       return Step();
     Format& f = *found;
@@ -333,10 +348,13 @@ public:
    * \brief A frame without GUI elements whose picture did not stand still was presented, and
    *        whether it came with its refresh is known
    * \param late it missed its refresh
+   * \param ladder Hades: as for Measured()
    */
-  void Presented(uint64_t format, int level, bool late, Pace pace)
+  void Presented(uint64_t format, int level, bool late, Pace pace, unsigned int ladder = 0)
   {
-    Format* const f = format != 0 ? Lookup(format) : nullptr;
+    Format* const f = format == 0 ? nullptr
+                      : ladder != 0 ? Lookup(format, Ladder(ladder))
+                                    : Lookup(format);
     if (!f || level != f->level || f->window.count == 0 || f->window.pace != pace)
       return;
     ++f->window.presented;
@@ -431,9 +449,10 @@ public:
             (!In(static_cast<unsigned int>(ladder), static_cast<int>(n)) && ms[n] != 0))
           return false;
       }
+      // (Hades: a format can be there once for each ladder)
       for (size_t n = 0; n < count; ++n)
       {
-        if (formats[n].id == id)
+        if (formats[n].id == id && formats[n].ladder == ladder)
           return false;
       }
       Format& f = formats[count++];
@@ -462,15 +481,14 @@ public:
     return true;
   }
 
-  //! The level of a format, without drawing a frame (0 when it is not known)
-  int Level(uint64_t format) const
+  //! The level of a format, without drawing a frame (0 when it is not known): Hades, for the
+  //! ladder its frames came with last, or for that ladder
+  int Level(uint64_t format, unsigned int ladder = 0) const
   {
-    for (const Format& f : m_formats)
-    {
-      if (f.id != 0 && f.id == format)
-        return f.level;
-    }
-    return 0;
+    const Format* const f = format == 0 ? nullptr
+                            : ladder != 0 ? Lookup(format, Ladder(ladder))
+                                          : Lookup(format);
+    return f ? f->level : 0;
   }
 
 private:
@@ -577,31 +595,51 @@ private:
     return std::max(LOST_MIN, static_cast<unsigned int>(std::ceil(LOST_PART * count)));
   }
 
-  Format* Lookup(uint64_t id)
+  //! Hades: the format with that ladder
+  Format* Lookup(uint64_t id, unsigned int ladder)
   {
     for (Format& f : m_formats)
     {
-      if (f.id == id)
+      if (f.id == id && f.ladder == ladder)
         return &f;
     }
     return nullptr;
   }
+  const Format* Lookup(uint64_t id, unsigned int ladder) const
+  {
+    return const_cast<CDVStepDown*>(this)->Lookup(id, ladder);
+  }
+
+  //! Hades: the format with the ladder its frames came with last (the one drawn last of its
+  //! ladders; one that Recall() took and that has not been drawn, when it is the only one)
+  Format* Lookup(uint64_t id)
+  {
+    Format* found = nullptr;
+    for (Format& f : m_formats)
+    {
+      if (f.id == id && (!found || f.drawn > found->drawn))
+        found = &f;
+    }
+    return found;
+  }
+  const Format* Lookup(uint64_t id) const { return const_cast<CDVStepDown*>(this)->Lookup(id); }
 
-  //! The format, or a place for it: a free one; else the one drawn longest ago of those at level
-  //! 0 with nothing measured below it; else the one drawn longest ago.
-  Format* Find(uint64_t id)
+  //! The format with that ladder, or a place for it: a free one; else the one drawn longest ago of
+  //! those at level 0 with nothing measured below it; else the one drawn longest ago.
+  Format* Find(uint64_t id, unsigned int ladder)
   {
     const auto rank = [](const Format& g) { return g.id == 0 ? 0 : g.Explored() ? 2 : 1; };
     Format* place = nullptr;
     for (Format& f : m_formats)
     {
-      if (f.id == id)
+      if (f.id == id && f.ladder == ladder)
         return &f;
       if (!place || rank(f) < rank(*place) || (rank(f) == rank(*place) && f.drawn < place->drawn))
         place = &f;
     }
     *place = Format();
     place->id = id;
+    place->ladder = ladder;
     place->drawn = m_clock;
     return place;
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1b6b9cf..e5f666c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2268,13 +2268,18 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
     DVPathReport(m_dvPath.Now()[layered].Missed(foreseen), layered, foreseen, DVRefreshPeriodMs());
   if (m_dvFrame)
   {
+    // Hades: the levels that change anything for it as it was drawn, in the transport it went out
+    // in (the level was chosen with those of the frame before: a frame of another transport counts
+    // for its own, CDVStepDown::Measured())
+    const unsigned int ladder = m_dvBridge->StepLevels(CDVFrameLoad::WithResidual(load));
     DVGpuTimerTag(measured, pathMeasured, direct, m_dvBridge->Direct(), layered, load, !still,
-                  comparing);
+                  comparing, ladder);
     // what its presentation is told with (DVStepPresented())
     m_dvStepFrame.valid = true;
     m_dvStepFrame.layered = layered;
     m_dvStepFrame.format = load;
     m_dvStepFrame.level = m_dvStepLevel;
+    m_dvStepFrame.ladder = ladder;
     // Hades: (not when work that is not the frame's own went to the GPU before it: when it is
     // presented says nothing of whether the frames keep up)
     m_dvStepFrame.measured = measured && !m_dvExtraWork && !m_dvVerifyPending;
@@ -3014,7 +3019,7 @@ void CWinSystemGbmGLESContext::DVStepPresented(const DVStepFrame& frame,
                                                CDVStepDown::Pace pace)
 {
   if (frame.valid && frame.measured && m_dvStepForced < 0 && m_dvStepAuto)
-    m_dvStep.Now()[frame.layered].Presented(frame.format, frame.level, late, pace);
+    m_dvStep.Now()[frame.layered].Presented(frame.format, frame.level, late, pace, frame.ladder);
 }
 
 void CWinSystemGbmGLESContext::DVStepReport(const CDVStepDown::Step& step,
@@ -3078,7 +3083,9 @@ void CWinSystemGbmGLESContext::DVStepReport(const CDVStepDown::Step& step,
       break;
     default:
       why = "the levels that change anything for these frames are others now (another "
-            "renderer): what was found of them is of other work, and is found again";
+            "transport or another renderer): they go on at what was found for those levels (the "
+            "faithful picture where nothing was), and what was found for the others is kept for "
+            "when they come back";
       break;
   }
   CLog::Log(LOGINFO,
@@ -3123,11 +3130,13 @@ void CWinSystemGbmGLESContext::DVGpuTimerTag(bool measured,
                                              bool layered,
                                              uint64_t load,
                                              bool playing,
-                                             bool comparing)
+                                             bool comparing,
+                                             unsigned int ladder)
 {
   auto& timer = m_dvGpuTimers[m_dvGpuTimerIndex];
   if (timer.begun)
   {
+    timer.ladder = ladder;
     timer.playing = playing;
     timer.measured = measured;
     timer.path = measured && path;
@@ -3356,7 +3365,8 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
     // Hades: the fidelity step-down level of its format, where Kodi chooses it
     if (m_dvStepForced < 0 && m_dvStepAuto)
       DVStepReport(m_dvStep.Now()[timer.layered].Measured(timer.load, timer.step, ms, periodMs,
-                                                          DVStepPace(), comparing, timer.direct),
+                                                          DVStepPace(), comparing, timer.direct,
+                                                          timer.ladder),
                    timer.layered, timer.load);
   }
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 262bb15..b34b6ca 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -429,6 +429,8 @@ private:
     uint64_t load = 0; //!< see CDVFrameLoad
     bool playing = false; //!< its picture did not stand still, with or without GUI elements
     int step = 0; //!< the fidelity step-down level it was drawn at (see DVStepLevel())
+    //! Hades: ... and the levels that changed anything for it, once it was drawn (DVStepFrame)
+    unsigned int ladder = 0;
   };
   std::array<DVGpuTimer, 4> m_dvGpuTimers{};
   //! The way to draw frames without GUI elements, for frames without (0) and with (1) an
@@ -553,6 +555,9 @@ private:
     bool layered = false;
     uint64_t format = 0; //!< its load, as it turned out to be
     int level = 0;
+    //! Hades: the step-down levels that changed anything for it, once it was drawn (the
+    //! transport it went out in): what it counts for (CDVStepDown::Presented())
+    unsigned int ladder = 0;
     bool measured = false; //!< without GUI elements, its picture not standing still
   };
   DVStepFrame m_dvStepFrame; //!< the frame prepared this pass
@@ -629,7 +634,8 @@ private:
                      bool layered,
                      uint64_t load,
                      bool playing,
-                     bool comparing);
+                     bool comparing,
+                     unsigned int ladder);
   //! A frame was drawn whose GPU time is not known (see CDVPathChoice::Untimed())
   void DVPathUntimed(bool measured, bool layered, uint64_t load);
   //! Log what a measurement decided for the frames of a load, if anything
