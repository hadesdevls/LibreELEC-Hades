+
+#pragma once
+
+// Hades: what a Blu-ray disc draws itself (its menus, the graphics of BD-J) is scaled to the output
+// without mixing its pixels where the scale is a whole number in both directions: 1920x1080 to
+// 3840x2160, or 1:1. Each pixel of the disc then becomes a block of whole pixels, as the disc drew
+// it. Linear filtering at twice the size mixes each pixel with its neighbours, a quarter on each
+// side: a line one pixel wide keeps three quarters of its contrast and a dot about half, so the thin
+// text of a menu looks faint. Any other scale is filtered linearly, as before.
+
+#include <cmath>
+
+namespace OVERLAY
+{
+//! Whether destination (in pixels of the output) is a whole number of times source (in pixels of
+//! the picture), 1 or more, to half a pixel
+inline bool IsWholeScale(float destination, int source)
+{
+  if (source <= 0 || !(destination > 0.0f))
+    return false;
+  const float times = std::round(destination / static_cast<float>(source));
+  return times >= 1.0f && std::fabs(destination - times * static_cast<float>(source)) <= 0.5f;
+}
+
+//! Whether an overlay of width x height pixels, drawn into a rectangle of destWidth x destHeight,
+//! is scaled without mixing its pixels (only what the disc draws: discMenu)
+inline bool ScaleWithoutMixing(bool discMenu, int width, int height, float destWidth, float destHeight)
+{
+  return discMenu && IsWholeScale(destWidth, width) && IsWholeScale(destHeight, height);
+}
+} // namespace OVERLAY
