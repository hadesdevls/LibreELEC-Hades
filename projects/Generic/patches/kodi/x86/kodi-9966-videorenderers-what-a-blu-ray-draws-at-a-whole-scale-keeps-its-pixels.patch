+  // Hades: what the disc draws, at a whole number of times its size, is not mixed
+  // (OverlayWholeScale.h)
+  const GLint filter = OVERLAY::ScaleWithoutMixing(m_isDiscMenu, m_pixelsWidth, m_pixelsHeight,
