 extern "C"
 {
@@ -49,7 +52,6 @@ extern "C"
 #include <cstdlib>
 #include <cstring>
 #ifdef HAVE_DVBRIDGE
-#include "ServiceBroker.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "cores/VideoPlayer/DVDStreamInfo.h"
 #include "drm/DRMAtomic.h"
@@ -61,6 +63,20 @@ using namespace KODI::WINDOWING::GBM;
 
 using namespace std::chrono_literals;
 
+namespace
+{
+// GUI white in HDR (videoscreen.hadesguiwhite), in percent of the BT.2408 reference white; 100, the
+// output of Kodi, when the setting cannot be read.
+int GuiReferenceWhite()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESGUIWHITE))
+    return 100;
+  return std::clamp(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESGUIWHITE), 25, 300);
+}
+} // namespace
+
 CWinSystemGbmGLESContext::CWinSystemGbmGLESContext()
   : CWinSystemGbmEGLContext(EGL_PLATFORM_GBM_MESA, "EGL_MESA_platform_gbm")
 {
@@ -350,7 +366,9 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
       }
     }
 
-    if (!m_compositeShader->CreateLUTs(colorTransfer))
+    m_compositeTransfer = colorTransfer;
+    m_compositeWhiteFailed = 0;
+    if (!m_compositeShader->CreateLUTs(colorTransfer, GuiReferenceWhite()))
     {
       CLog::Log(LOGERROR, "CWinSystemGbmGLESContext: failed to create LUTs");
       m_compositeShader.reset();
@@ -374,6 +392,30 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
   if (!m_guiCompositing)
     return false;
 
+  // A change of the GUI white setting applies from this frame. LUTs that cannot be created leave
+  // the ones in use, and that value is not tried again until the setting changes.
+  if (m_compositeShader)
+  {
+    const int white = GuiReferenceWhite();
+    if (white == m_compositeShader->GetReferenceWhite())
+      m_compositeWhiteFailed = 0; // back to the value in use: a failed one is tried again later
+    else if (white != m_compositeWhiteFailed)
+    {
+      if (m_compositeShader->CreateLUTs(m_compositeTransfer, white))
+      {
+        m_compositeWhiteFailed = 0;
+        CLog::Log(LOGINFO, "CWinSystemGbmGLESContext: GUI white in HDR now {}% of the reference "
+                           "white", white);
+      }
+      else
+      {
+        m_compositeWhiteFailed = white;
+        CLog::Log(LOGERROR, "CWinSystemGbmGLESContext: GUI white in HDR {}% could not be applied, "
+                            "the previous one stays", white);
+      }
+    }
+  }
+
   m_guiWillRender = guiWillRender;
 
   int width = m_nWidth;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index fbb4827..4dac3ce 100644
