From 03317878c06d8480b4d652b5cbd1df7b5d98a3e7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:36:32 +0000
Subject: [PATCH] windowing/gbm: tell the Dolby Vision bridge what the GUI will
 be drawn over

A frame of native Dolby Vision with GUI elements is composed, and the GUI
is composited over its picture from the GUI's FBO (CompositeGui()), whose
content is final before the video is drawn: the GUI pass, text subtitles
among it, comes before RenderEx(). The bridge is now told that texture
before the frame is prepared (CDVBridgeGLES::SetDrawnOver(),
dvbridge_render_set_drawn()), and makes the picture that the GUI is drawn
over only where the GUI reaches (the same bytes; tools/dvbridge). What else
is drawn into the picture or reads it asks for the rest of it first
(CDVBridgeGLES::CompletePicture()): PQ subtitles (BeginDVBridgeHDROverlays())
and a capture (GetCaptureFramebuffer()); a frame that a capture waits for is
made whole from the start. To measure on hardware what it saves,
advancedsettings.xml turns it off: <video><dvdrawntiles>false</dvdrawntiles></video>.

Compiled with Kodi's compile commands (-fsyntax-only); the bridge's part is
measured on its own (tools/dvbridge). Not run in Kodi: not on a GPU, not
on a display.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 14 ++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  8 +++++++
 xbmc/settings/AdvancedSettings.cpp            |  2 ++
 xbmc/settings/AdvancedSettings.h              |  3 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 22 +++++++++++++++++++
 5 files changed, 49 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index d201b9d..899d92a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -761,6 +761,20 @@ void CDVBridgeGLES::PQTextureDrawn()
     dvbridge_render_texture_drawn(m_renderer);
 }
 
+void CDVBridgeGLES::SetDrawnOver(unsigned int guiTexture, int width, int height)
+{
+  dvbridge_render_set_drawn(m_renderer, guiTexture, width, height);
+}
+
+bool CDVBridgeGLES::CompletePicture()
+{
+  // (a frame drawn directly has no picture to draw into; one composed by the converted transport
+  // is whole)
+  if (!m_prepared || m_direct)
+    return true;
+  return dvbridge_render_complete(m_renderer);
+}
+
 bool CDVBridgeGLES::VerifyBegin()
 {
   if (m_verifier)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index c108c59..97ec660 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -162,6 +162,14 @@ public:
   //! area outside the place of the video is cleared again before the next picture; it is not
   //! otherwise (dvbridge_render_texture_drawn()).
   void PQTextureDrawn();
+  //! Hades: what will be drawn over the picture of the next frame that is composed: Kodi's GUI,
+  //! composited from this texture (width x height) as CWinSystemGbmGLESContext::CompositeGui()
+  //! composites it, and nothing else; 0: not known. The picture that it is drawn over is then made
+  //! only where it may reach (dvbridge_render_set_drawn()): the same bytes, less work.
+  void SetDrawnOver(unsigned int guiTexture, int width, int height);
+  //! Hades: the picture of the prepared frame whole, for what else is drawn into it (PQ subtitles,
+  //! a capture that reads it); false where that could not be done
+  bool CompletePicture();
   //! Hades: how the Dolby Vision signal is sent from the next frame on: as certified source devices
   //! send it (true), or converted to BT.2020 (dvbridge_render_use_source_transport())
   void UseSourceTransport(bool use);
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index 9519438..5095fb7 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -202,6 +202,7 @@ void CAdvancedSettings::Initialize()
   m_videoAudioDelayStep = 0.025f;
   m_videoUseTimeSeeking = true;
   m_videoDVEarlyMask = true;
+  m_videoDVDrawnTiles = true;
   m_videoDVCCMComposer = true;
   m_videoDVAheadAlways = false;
   m_videoDVStepDown = -1;
@@ -703,6 +704,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
 
     XMLUtils::GetBoolean(pElement, "usetimeseeking", m_videoUseTimeSeeking);
     XMLUtils::GetBoolean(pElement, "dvearlymask", m_videoDVEarlyMask);
+    XMLUtils::GetBoolean(pElement, "dvdrawntiles", m_videoDVDrawnTiles);
     XMLUtils::GetBoolean(pElement, "dvccmcomposer", m_videoDVCCMComposer);
     XMLUtils::GetBoolean(pElement, "dvaheadalways", m_videoDVAheadAlways);
     XMLUtils::GetInt(pElement, "dvstepdown", m_videoDVStepDown, 0, 3);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index e8ab148..bb7e578 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -167,6 +167,9 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! Hades: the Dolby Vision renderer writes the bars of a letterboxed picture before it
     //! reconstructs the picture (video/dvearlymask). Off for a measurement of what that saves
     bool m_videoDVEarlyMask;
+    //! Hades: the Dolby Vision renderer makes the picture that the GUI is drawn over only where the
+    //! GUI reaches (video/dvdrawntiles; the same bytes). Off for a measurement of what that saves
+    bool m_videoDVDrawnTiles;
     //! Hades: the Dolby Vision renderer composes the picture as ETSI GS CCM 001 does
     //! (video/dvccmcomposer). Off: libplacebo's own reshaping, to compare on hardware
     bool m_videoDVCCMComposer;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b505fe3..4d48b0c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1848,6 +1848,9 @@ unsigned int CWinSystemGbmGLESContext::GetCaptureFramebuffer(int& width, int& he
   // transport only. RenderDVBridge() composes the frame that a capture waits for.
   if (!m_dvState.Captured() || !m_dvFrame || !m_dvBridge || !m_dvBridge->Composable())
     return 0;
+  // Hades: the capture reads the whole picture (it may have been made where the GUI reaches only)
+  if (!m_dvBridge->CompletePicture())
+    return 0;
   width = 3840;
   height = 2160;
   return m_dvBridge->GetPQFramebuffer();
@@ -2034,6 +2037,21 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
         m_dvVerify.Missed();
     }
   }
+  // Hades: what will be drawn over the picture of a frame that is composed: the GUI, which
+  // CompositeGui() composites from its FBO, whose content is final by now (the GUI pass, text
+  // subtitles among it, comes before the video's). The composed way of the source transport then
+  // makes the picture that it is drawn over only where the GUI reaches (the same bytes). PQ
+  // subtitles, drawn into the picture after this, and a capture, which reads it, make it whole
+  // first (BeginDVBridgeHDROverlays(), GetCaptureFramebuffer()); a frame that a capture waits for
+  // is made whole from the start. To measure on hardware what it saves, advancedsettings.xml can
+  // turn it off: <video><dvdrawntiles>false</dvdrawntiles></video>
+  const auto drawnSettings = CServiceBroker::GetSettingsComponent();
+  const bool drawnTiles =
+      !drawnSettings || drawnSettings->GetAdvancedSettings()->m_videoDVDrawnTiles;
+  if (!overlayFree && !captured && drawnTiles && m_guiFbo.IsValid())
+    m_dvBridge->SetDrawnOver(m_guiFbo.Texture(), m_guiFboWidth, m_guiFboHeight);
+  else
+    m_dvBridge->SetDrawnOver(0, 0, 0);
   DVGpuTimerMark(true);
   m_dvFrame = m_dvBridge->PrepareHardware(layer, layerWithoutResidual ? nullptr : enhancement,
                                           metadata, geometry, overlayFree && direct,
@@ -2113,6 +2131,10 @@ bool CWinSystemGbmGLESContext::BeginDVBridgeHDROverlays()
   // PQ while the GUI is composited), as is the picture.
   if (!m_dvState.Captured() || !m_dvFrame || !m_dvBridge || !m_dvBridge->Composable())
     return false;
+  // Hades: the subtitles may go anywhere over the picture, which may have been made where the GUI
+  // reaches only (RenderDVBridge(), SetDrawnOver()): made whole first
+  if (!m_dvBridge->CompletePicture())
+    return false;
   const auto target = m_dvBridge->GetPQFramebuffer();
   if (!target)
     return false;
-- 
