+CMeasuredLatency::Way CWinSystemGbmGLESContext::MeasuredWay() const
+{
+  // (as GetFrameLatencyAdjustment(): set when native output starts, and when its way changes)
+  if (!m_dvSignalling)
+    return CMeasuredLatency::Way::ORDINARY;
+  return m_dvAheadShown ? CMeasuredLatency::Way::AHEAD : CMeasuredLatency::Way::WAITING;
+}
+
+std::string CWinSystemGbmGLESContext::MeasuredName(CMeasuredLatency::Way way)
+{
+  if (!m_latencyKeyRead)
+  {
+    m_latencyKeyRead = true;
+    // What tells the GPU and its driver (the GL strings: with Mesa they carry its version and the
+    // kernel's) and the build, as for the way of drawing a Dolby Vision frame (DVPathRecall()):
+    // what a new driver does is measured again.
+    const auto text = [](GLenum name)
+    {
+      const GLubyte* value = glGetString(name);
+      return std::string(value ? reinterpret_cast<const char*>(value) : "");
+    };
+    const std::string renderer = text(GL_RENDERER);
+    if (!renderer.empty())
+      m_latencyKey = DVPathKey(renderer + '\n' + text(GL_VERSION) + '\n' +
+                               CSysInfo::GetOsPrettyNameWithVersion());
+  }
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  if (!m_latencyKey || !mode || !mode->clock || !mode->htotal || !mode->vtotal)
+    return {};
+  auto& c = m_latencyCache;
+  if (c.way != static_cast<int>(way) || c.clock != mode->clock || c.htotal != mode->htotal ||
+      c.vtotal != mode->vtotal || c.hdisplay != mode->hdisplay || c.vdisplay != mode->vdisplay ||
+      c.flags != mode->flags)
+  {
+    c = {mode->clock,    mode->htotal, mode->vtotal,          mode->hdisplay,
+         mode->vdisplay, mode->flags,  static_cast<int>(way), {}};
+    const auto milliHz = static_cast<unsigned int>(
+        std::llround(static_cast<double>(mode->clock) * 1e6 /
+                     (static_cast<double>(mode->htotal) * static_cast<double>(mode->vtotal))));
+    c.name = CLatencyMemory::Name(m_latencyKey, mode->hdisplay, mode->vdisplay, milliHz,
+                                  (mode->flags & DRM_MODE_FLAG_INTERLACE) != 0, way);
+  }
+  return c.name;
+}
+
+std::string CWinSystemGbmGLESContext::MeasuredWhere(CMeasuredLatency::Way way) const
+{
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  const char* const how =
+      way == CMeasuredLatency::Way::WAITING ? "native Dolby Vision presented the way that waits"
+      : way == CMeasuredLatency::Way::AHEAD ? "native Dolby Vision presented a frame ahead"
+                                            : "the ordinary output";
+  if (!mode || !mode->clock || !mode->htotal || !mode->vtotal)
+    return how;
+  return StringUtils::Format(
+      "{}x{}{} at {:.3f} Hz, {}", mode->hdisplay, mode->vdisplay,
+      (mode->flags & DRM_MODE_FLAG_INTERLACE) != 0 ? "i" : "",
+      static_cast<double>(mode->clock) * 1000.0 /
+          (static_cast<double>(mode->htotal) * static_cast<double>(mode->vtotal)),
+      how);
+}
