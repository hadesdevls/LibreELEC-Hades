+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: how many refresh periods later than Kodi's display latency says the frames are
+ *        to be chosen, measured: the time from the choice of each frame to its flip
+ *
+ * The render manager chooses a frame for the time its sound is played plus the display latency
+ * that Kodi takes. In GBM that is Kodi's fallback, the buffers plus one, three refresh periods
+ * (CGraphicContext::GetDisplayLatency(): the window system gives none), less what
+ * GetFrameLatencyAdjustment() says for the way a frame is presented (DVLatency.h). With the clock
+ * sync of the render manager on (a refresh rate that is a whole multiple of the frame rate), Kodi
+ * moves the sound by the offset of the frames from the refreshes (SetVsyncAdjust()), and what is
+ * seen against what is heard is then the time from the choice of a frame to its flip, less that
+ * latency, and nothing else. Read in the code and measured on every driver (the logs of seven
+ * computers, NVIDIA, amdgpu and i915, from 23.976 to 60 Hz), the ordinary output and native Dolby
+ * Vision put a frame on the screen two periods after its choice, one for the way that waits (whose
+ * latency is a period shorter): a period sooner than Kodi takes. The picture went out a period
+ * before its sound: 41.7 ms at 23.976 Hz, 16.7 ms at 60 Hz.
+ *
+ * Here that time is measured for each frame (Add(): its flip less its choice less the latency that
+ * Kodi takes for its way, in ms) and told in whole refresh periods once it is clear (Judge()):
+ *  - whole periods only: the frames keep the offset from the refreshes that the clock sync found,
+ *    so which frames are shown, and for how many refreshes each (the cadence), stays the same, and
+ *    only the refresh each one starts at moves;
+ *  - only on clear evidence: at least SAMPLES frames; the middle half of them (the interquartile
+ *    range) within a quarter of a period; their mean (the interquartile mean, which leaves out the
+ *    frames that missed their refresh) within a quarter of a period of a whole number of periods,
+ *    so that what is left of an offset of a period is a third of it at most; no more than
+ *    MOST_SOONER periods sooner or MOST_LATER later than Kodi takes.
+ * Otherwise the verdict is no correction, and Kodi's latency stands.
+ * Correcting changes nothing that is measured (a frame is chosen and flipped when it is; only which
+ * frame moves), so the verdict cannot feed on itself.
+ *
+ * This class only counts; a test builds it on the host.
+ */
+class CMeasuredLatency
+{
+public:
+  //! As CPresentLag::Way
+  enum class Way
+  {
+    WAITING, //!< native Dolby Vision, a commit that returns with its flip
+    AHEAD, //!< native Dolby Vision presented a frame ahead
+    ORDINARY, //!< the ordinary output of Kodi
+    COUNT
+  };
+  static constexpr unsigned int SAMPLES = 240; //!< 10 s at 24 Hz
+  static constexpr size_t KEPT = 2048; //!< the last ones, judged
+  static constexpr int MOST_SOONER = 2;
+  static constexpr int MOST_LATER = 1;
+  static constexpr double SPREAD = 0.25; //!< of a period, the interquartile range at most
+  static constexpr double LEFT = 0.25; //!< of a period, from a whole number of periods at most
+
+  struct Verdict
+  {
+    bool clear = false; //!< the evidence is clear: periods is to be taken
+    int periods = 0; //!< how many periods later the frames are to be chosen
+    double meanMs =
+        0.0; //!< the interquartile mean of the frames: their flips against Kodi's latency
+    double spreadMs = 0.0; //!< the interquartile range
+    double periodMs = 0.0;
+    unsigned int frames = 0;
+    const char* why = ""; //!< what the evidence lacks, when it is not clear
+  };
+
+  //! A frame presented that way flipped offsetMs after the latency that Kodi takes for it (negative:
+  //! sooner), at a refresh period of periodMs. Samples of another period start the count again.
+  void Add(Way way, double offsetMs, double periodMs)
+  {
+    if (!(periodMs > 0.0) || !std::isfinite(offsetMs) || std::fabs(offsetMs) > 2000.0)
+      return;
+    auto& w = m_ways[static_cast<size_t>(way)];
+    if (std::fabs(w.periodMs - periodMs) > periodMs * 1e-3)
+    {
+      w = {};
+      w.periodMs = periodMs;
+    }
+    if (w.samples.size() < KEPT)
+      w.samples.push_back(offsetMs);
+    else
+      w.samples[w.next] = offsetMs;
+    w.next = (w.next + 1) % KEPT;
+    w.added++;
+  }
+
+  unsigned int Count(Way way) const
+  {
+    return static_cast<unsigned int>(m_ways[static_cast<size_t>(way)].samples.size());
+  }
+  //! Frames added since Reset(), for the ones kept
+  unsigned long long Added(Way way) const { return m_ways[static_cast<size_t>(way)].added; }
+
+  Verdict Judge(Way way) const
+  {
+    Verdict v;
+    const auto& w = m_ways[static_cast<size_t>(way)];
+    v.periodMs = w.periodMs;
+    v.frames = static_cast<unsigned int>(w.samples.size());
+    if (v.frames < SAMPLES || !(w.periodMs > 0.0))
+    {
+      v.why = "too few frames";
+      return v;
+    }
+    std::vector<double> sorted(w.samples);
+    std::sort(sorted.begin(), sorted.end());
+    const size_t n = sorted.size();
+    const size_t q1 = n / 4;
+    const size_t q3 = n - n / 4; // [q1, q3): the middle half
+    double sum = 0.0;
+    for (size_t i = q1; i < q3; ++i)
+      sum += sorted[i];
+    v.meanMs = sum / static_cast<double>(q3 - q1);
+    v.spreadMs = sorted[q3 - 1] - sorted[q1];
+    const double mean = v.meanMs / w.periodMs;
+    const int periods = static_cast<int>(std::lround(-mean));
+    v.periods = periods;
+    if (v.spreadMs > SPREAD * w.periodMs)
+      v.why = "the flips are spread over more than a quarter of a period";
+    else if (std::fabs(mean + periods) > LEFT)
+      v.why = "the offset is not near a whole number of periods";
+    else if (periods > MOST_SOONER || periods < -MOST_LATER)
+      v.why = "the offset is more periods than a correction takes";
+    else
+      v.clear = true;
+    if (!v.clear)
+      v.periods = 0;
+    return v;
+  }
+
+  void Reset(Way way) { m_ways[static_cast<size_t>(way)] = {}; }
+  void Reset() { m_ways = {}; }
+
+private:
+  struct Samples
+  {
+    std::vector<double> samples;
+    size_t next = 0;
+    unsigned long long added = 0;
+    double periodMs = 0.0;
+  };
+  std::array<Samples, static_cast<size_t>(Way::COUNT)> m_ways{};
+};
+
+/*!
+ * \brief Hades: the corrections of CMeasuredLatency found for each GPU, driver and build, display
+ *        mode and way of presenting, kept between sessions in one text
+ *
+ * "<key>/<width>x<height>@<refresh in mHz>[i]/<way>=<periods>" for each, the one put last first,
+ * ENTRIES at most, a space between them; the key is DVPathKey() of what tells the GPU, its driver
+ * and the build (as CDVPathMemory), in 16 hexadecimal digits; the way is w (the way that waits), a
+ * (a frame ahead) or o (the ordinary output). A new driver or build is a new key: what was found
+ * with the one before is not taken for it.
+ */
+class CLatencyMemory
+{
+public:
+  static constexpr unsigned int ENTRIES = 32;
+
+  //! The name of what is kept for that GPU, mode and way
+  static std::string Name(uint64_t key,
+                          unsigned int width,
+                          unsigned int height,
+                          unsigned int refreshMilliHz,
+                          bool interlaced,
+                          CMeasuredLatency::Way way)
+  {
+    static constexpr char WAYS[] = {'w', 'a', 'o'};
+    const size_t index = static_cast<size_t>(way);
+    char name[80];
+    std::snprintf(name, sizeof(name), "%016llx/%ux%u@%u%s/%c", static_cast<unsigned long long>(key),
+                  width, height, refreshMilliHz, interlaced ? "i" : "",
+                  index < sizeof(WAYS) ? WAYS[index] : 'o');
+    return name;
+  }
+
+  //! The text with that name set to periods, put first in place of what it had for it
+  static std::string Put(const std::string& all, const std::string& name, int periods)
+  {
+    std::string text = name + '=' + std::to_string(periods);
+    if (!Well(text))
+      return Without(all, "");
+    const std::string rest = Without(all, name);
+    unsigned int entries = 1;
+    for (size_t at = 0; at < rest.size() && entries < ENTRIES;)
+    {
+      const size_t end = std::min(rest.find(' ', at), rest.size());
+      text += ' ' + rest.substr(at, end - at);
+      ++entries;
+      at = end + 1;
+    }
+    return text;
+  }
+
+  //! What the text has for that name; false when it has nothing (or nothing well formed)
+  static bool Get(const std::string& all, const std::string& name, int& periods)
+  {
+    for (size_t at = 0; at < all.size();)
+    {
+      const size_t end = std::min(all.find(' ', at), all.size());
+      const std::string entry = all.substr(at, end - at);
+      at = end + 1;
+      if (!Well(entry) || entry.compare(0, name.size() + 1, name + '=') != 0)
+        continue;
+      periods = std::stoi(entry.substr(name.size() + 1));
+      return true;
+    }
+    return false;
+  }
+
+private:
+  //! "<16 hex>/<digits>x<digits>@<digits>[i]/<w|a|o>=<-1..2>"
+  static bool Well(const std::string& entry)
+  {
+    if (entry.size() < 16 + 1 + 3 + 1 + 1 + 1 + 1 + 1 + 1 || entry.size() > 64)
+      return false;
+    size_t at = 0;
+    for (; at < 16; ++at)
+      if (!std::isxdigit(static_cast<unsigned char>(entry[at])))
+        return false;
+    const auto digits = [&](char after)
+    {
+      const size_t from = at;
+      while (at < entry.size() && entry[at] >= '0' && entry[at] <= '9')
+        ++at;
+      return at > from && at - from <= 7 && at < entry.size() && entry[at++] == after;
+    };
+    if (entry[at++] != '/' || !digits('x') || !digits('@'))
+      return false;
+    const size_t from = at;
+    while (at < entry.size() && entry[at] >= '0' && entry[at] <= '9')
+      ++at;
+    if (at == from || at - from > 7 || at >= entry.size())
+      return false;
+    if (entry[at] == 'i')
+      ++at;
+    if (at + 3 >= entry.size() || entry[at] != '/' ||
+        (entry[at + 1] != 'w' && entry[at + 1] != 'a' && entry[at + 1] != 'o') ||
+        entry[at + 2] != '=')
+      return false;
+    const std::string value = entry.substr(at + 3);
+    return value == "-1" || value == "0" || value == "1" || value == "2";
+  }
+
+  //! The well formed entries of the text, without the one of that name
+  static std::string Without(const std::string& all, const std::string& name)
+  {
+    std::string text;
+    for (size_t at = 0; at < all.size();)
+    {
+      const size_t end = std::min(all.find(' ', at), all.size());
+      const std::string entry = all.substr(at, end - at);
+      at = end + 1;
+      if (!Well(entry) || (!name.empty() && entry.compare(0, name.size() + 1, name + '=') == 0))
+        continue;
+      if (!text.empty())
+        text += ' ';
+      text += entry;
+    }
+    return text;
+  }
+};
