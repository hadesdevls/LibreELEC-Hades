+const std::string& CWinSystemGbmGLESContext::LatencyMemory()
+{
+  if (!m_latencyMemoryRead)
+  {
+    m_latencyMemoryRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESLATENCY))
+      m_latencyMemory = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESLATENCY);
+  }
+  return m_latencyMemory;
+}
