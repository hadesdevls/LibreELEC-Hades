+double CWinSystemGbmGLESContext::MeasuredLatencyMs(bool clockSync)
+{
+  const auto way = MeasuredWay();
+  if (!clockSync)
+  {
+    // (a frame rate whose multiple is not the refresh rate: Kodi chooses each frame for the
+    // refresh nearest its time, without the clock sync, and nothing is measured)
+    const std::string name = MeasuredName(way) + " unsynced";
+    if (name != m_latencyAppliedName)
+    {
+      m_latencyAppliedName = name;
+      m_latencyApplied = 0;
+      CLog::Log(LOGINFO,
+                "Video: Kodi's display latency of {:.1f} ms is taken as it is at {}: the refresh "
+                "rate is no whole multiple of the frame rate, so the render manager's clock sync "
+                "is off, and nothing is measured or corrected",
+                LagLatencyMs(), MeasuredWhere(way));
+    }
+    return 0.0;
+  }
+  const double period = DVRefreshPeriodMs();
+  const std::string name = MeasuredName(way);
+  int periods = 0;
+  const bool known =
+      !name.empty() && period > 0.0 && CLatencyMemory::Get(LatencyMemory(), name, periods);
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  const bool on = !advanced || advanced->m_videoMeasuredLatency;
+  const int applied = known && on ? periods : 0;
+  // (told when it changes: with each video, a mode, a way of presenting, or a seek that takes a
+  // new measurement)
+  if (!name.empty() && (name != m_latencyAppliedName || applied != m_latencyApplied))
+  {
+    m_latencyAppliedName = name;
+    m_latencyApplied = applied;
+    const double latency = LagLatencyMs();
+    if (applied != 0)
+      CLog::Log(
+          LOGINFO,
+          "Video: frames are chosen {} refresh period{} ({:.1f} ms) {} than Kodi's display "
+          "latency of {:.1f} ms says, at {}: as measured with this GPU, driver and build, so "
+          "that the picture goes out with its sound (<measuredlatency>false</measuredlatency> "
+          "under <video> in advancedsettings.xml leaves Kodi's latency as it is)",
+          std::abs(applied), std::abs(applied) == 1 ? "" : "s", std::abs(applied) * period,
+          applied > 0 ? "later" : "sooner", latency, MeasuredWhere(way));
+    else if (known && periods != 0)
+      CLog::Log(LOGINFO,
+                "Video: Kodi's display latency of {:.1f} ms is taken as it is at {}, although with "
+                "this GPU, driver and build the frames were measured to be chosen {} refresh "
+                "period{} {}: <measuredlatency> is off in advancedsettings.xml",
+                latency, MeasuredWhere(way), std::abs(periods), std::abs(periods) == 1 ? "" : "s",
+                periods > 0 ? "later" : "sooner");
+    else
+      CLog::Log(LOGINFO, "Video: Kodi's display latency of {:.1f} ms is taken as it is at {}: {}",
+                latency, MeasuredWhere(way),
+                known ? "it was measured right with this GPU, driver and build"
+                      : "nothing is measured with this GPU, driver and build yet (the frames of "
+                        "this video are)");
+  }
+  return applied * period;
+}
+
+void CWinSystemGbmGLESContext::MeasuredAdd(CMeasuredLatency::Way way,
+                                           int64_t modelNs,
+                                           int64_t flipNs)
+{
+  if (modelNs <= 0 || flipNs <= 0)
+    return;
+  // (what was measured for another mode, resolution or GPU is another count)
+  const std::string name = MeasuredName(way);
+  auto& last = m_measuredName[static_cast<size_t>(way)];
+  if (name != last)
+  {
+    m_measured.Reset(way);
+    m_measuredJudged[static_cast<size_t>(way)] = 0;
+    m_measuredUnclear[static_cast<size_t>(way)] = nullptr;
+    last = name;
+  }
+  if (!name.empty())
+    m_measured.Add(way, static_cast<double>(flipNs - modelNs) / 1e6, DVRefreshPeriodMs());
+}
+
+void CWinSystemGbmGLESContext::MeasuredJudge(bool now)
+{
+  const auto at = std::chrono::steady_clock::now();
+  if (!now && at - m_measuredJudgedAt < std::chrono::seconds(2))
+    return;
+  m_measuredJudgedAt = at;
+  for (size_t i = 0; i < static_cast<size_t>(CMeasuredLatency::Way::COUNT); ++i)
+  {
+    const auto way = static_cast<CMeasuredLatency::Way>(i);
+    if (m_measured.Added(way) == m_measuredJudged[i] || m_measuredName[i].empty())
+      continue;
+    m_measuredJudged[i] = m_measured.Added(way);
+    const CMeasuredLatency::Verdict v = m_measured.Judge(way);
+    if (!v.clear)
+    {
+      if (v.frames >= CMeasuredLatency::SAMPLES)
+        m_measuredUnclear[i] = v.why;
+      continue;
+    }
+    m_measuredUnclear[i] = nullptr;
+    const std::string& name = m_measuredName[i];
+    m_latencyPending[name] = v.periods;
+    if (!m_latencyTold.insert(name).second)
+      continue;
+    int before = 0;
+    const bool known = CLatencyMemory::Get(LatencyMemory(), name, before);
+    std::string then;
+    if (v.periods == 0)
+      then = "Kodi's latency is right";
+    else if (known && before == v.periods)
+      then = StringUtils::Format("the frames are chosen {} refresh period{} {} than it says, as "
+                                 "they are",
+                                 std::abs(v.periods), std::abs(v.periods) == 1 ? "" : "s",
+                                 v.periods > 0 ? "later" : "sooner");
+    else
+      then = StringUtils::Format("the frames are chosen {} refresh period{} {} than it says from "
+                                 "the next video or seek on, and so with this GPU, driver and "
+                                 "build from then on",
+                                 std::abs(v.periods), std::abs(v.periods) == 1 ? "" : "s",
+                                 v.periods > 0 ? "later" : "sooner");
+    // (the latency that Kodi takes for that way: GetFrameLatencyAdjustment() as it is for it)
+    const double latency =
+        static_cast<double>(GetGfxContext().GetDisplayLatency()) -
+        DVFrameLatencyAdjustmentMs(way != CMeasuredLatency::Way::ORDINARY,
+                                   way == CMeasuredLatency::Way::AHEAD, DVRefreshPeriodMs());
+    CLog::Log(
+        LOGINFO,
+        "Video: measured over {} frames at {}: by Kodi's display latency alone ({:.1f} ms) "
+        "the picture would go out {:.1f} ms {} its sound ({:+.2f} refresh periods; the middle "
+        "half of the frames within {:.1f} ms): {}",
+        v.frames, MeasuredWhere(way), latency, std::fabs(v.meanMs),
+        v.meanMs < 0 ? "before" : "after", v.meanMs / v.periodMs, v.spreadMs, then);
+  }
+}
+
+void CWinSystemGbmGLESContext::VideoLatencyCommit(bool newVideo)
+{
+  MeasuredJudge(true);
+  std::string memory = LatencyMemory();
+  for (const auto& [name, periods] : m_latencyPending)
+  {
+    int before = 0;
+    if (!CLatencyMemory::Get(memory, name, before) || before != periods)
+      memory = CLatencyMemory::Put(memory, name, periods);
+  }
+  m_latencyPending.clear();
+  if (memory != m_latencyMemory)
+  {
+    m_latencyMemory = memory;
+    // written with the other settings when Kodi stops
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESLATENCY))
+      settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESLATENCY, memory);
+  }
+  if (!newVideo)
+    return;
+  for (size_t i = 0; i < static_cast<size_t>(CMeasuredLatency::Way::COUNT); ++i)
+  {
+    if (m_measuredUnclear[i] && m_latencyTold.count(m_measuredName[i]) == 0)
+      CLog::Log(LOGINFO,
+                "Video: the frames of the video before did not tell clearly when they reached the "
+                "screen against Kodi's display latency ({}, {} frames): nothing was kept of them",
+                m_measuredUnclear[i], m_measured.Count(static_cast<CMeasuredLatency::Way>(i)));
+    m_measuredUnclear[i] = nullptr;
+  }
+  m_measured.Reset();
+  m_measuredJudged = {};
+  m_measuredName = {};
+  m_latencyTold.clear();
+  m_latencyAppliedName.clear();
+}
