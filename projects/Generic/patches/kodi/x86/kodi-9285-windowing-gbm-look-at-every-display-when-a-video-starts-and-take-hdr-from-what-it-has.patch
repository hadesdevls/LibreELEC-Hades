+
+#pragma once
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief How the display is looked at when a video starts, and what the EDID that the look finds
+ *        changes (CWinSystemGbm::CheckDisplayChange())
+ *
+ * Kodi read the display's EDID once, when it started. Since 1.0 RC1 a display that offered Dolby
+ * Vision in the session, or one after a failure of native output, is probed again when each video
+ * starts (never in the middle of one): its driver reads its state and its EDID again. Any other
+ * display was not looked at again, so that nothing changed for a display without Dolby Vision. A
+ * TV whose EDID had no Dolby Vision block when Kodi started, or that had none or one that could
+ * not be read (the PC started while the TV was off, or with an input setting that hides it: Deep
+ * Colour off, a receiver in standby), stayed without native Dolby Vision, and with the HDR of that
+ * EDID, until Kodi was started again.
+ *
+ * Now every display is looked at when a video starts:
+ * - probed, as before, where it offered Dolby Vision in the session or native output failed,
+ *   and after a hot-plug event of its device since the last look (a TV that is turned on, or
+ *   whose EDID changes, raises one: nvidia-drm has the new EDID only once it is probed);
+ * - otherwise by the EDID that the kernel has now, without a probe: nothing is asked of the
+ *   display (no read over its DDC line), and the cost is a call to the kernel and a comparison of
+ *   the bytes.
+ * Another EDID that can be read replaces the display information of the decisions of Dolby Vision
+ * and, from now on, of HDR: both are of the display that is there. None, or one that cannot be
+ * read (a TV that wakes up), replaces nothing, so that HDR10 is never lost to a read at the wrong
+ * moment (what an earlier version found with a probe of every display); a display that is probed
+ * then has no native output in this video, as before.
+ *
+ * Only what is decided is here, with nothing of DRM in it, so that it can be tested by itself.
+ */
+class CDisplayLook
+{
+public:
+  enum class Read
+  {
+    PROBE, //!< the driver reads the display again (drmModeGetConnector())
+    CURRENT, //!< what the kernel has (drmModeGetConnectorCurrent()): no read of the display
+  };
+
+  //! \param dvSeen a display that offered Dolby Vision was seen in this session
+  //! \param dvDisabled native output is disabled after a failure
+  //! \param hotplug a hot-plug event of the device came since the last look
+  static Read HowToRead(bool dvSeen, bool dvDisabled, bool hotplug)
+  {
+    return dvSeen || dvDisabled || hotplug ? Read::PROBE : Read::CURRENT;
+  }
+
+  //! What a look that found an EDID changes
+  struct Outcome
+  {
+    bool adopt = false; //!< the EDID replaces the display information (Dolby Vision and HDR)
+    bool unread = false; //!< native output waits for a later video: the EDID was not read
+    bool read = false; //!< the EDID was read (the one known, or one adopted)
+  };
+
+  /*!
+   * \param how how it was looked at
+   * \param empty the look found no EDID
+   * \param same it is the one known (the bytes are the same)
+   * \param parsed it is another one, and it can be read (CDisplayInfo::Create() gave one)
+   */
+  static Outcome Of(Read how, bool empty, bool same, bool parsed)
+  {
+    Outcome outcome;
+    if (!empty && same)
+    {
+      outcome.read = true;
+      return outcome;
+    }
+    if (!empty && parsed)
+    {
+      outcome.adopt = true;
+      outcome.read = true;
+      return outcome;
+    }
+    // No EDID, or one that cannot be read: nothing is replaced. A display that is probed has no
+    // native output in this video (it may be waking up); one that is not was not asked anything.
+    outcome.unread = how == Read::PROBE;
+    return outcome;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 999863b..0680150 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1385,14 +1385,24 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
   if (!connector)
     return false;
-  // Nothing changes for a display without Dolby Vision: as in Kodi, it is not probed again.
-  if (!m_dvDisabled && !m_dvDisplaySeen)
-    return false;
+  // Hades: every display is looked at (CDisplayLook): probed where one that offers Dolby Vision
+  // was seen, after a failure, or after a hot-plug event of its device (a TV switched off and on,
+  // an input setting that changes its EDID: nvidia-drm and i915 read the display's state and EDID
+  // again, amdgpu reports what its hotplug handling found); any other one by the EDID that the
+  // kernel has now, without a probe (nothing is asked of the display). A display without Dolby
+  // Vision used not to be looked at again: one that had none when Kodi started (the TV was off or
+  // on another setting) stayed without it, and with the HDR of that EDID, until Kodi started again.
   const auto info = DVDisplayInfo();
-  // A probe (a TV switched off and on, an input setting that changes its EDID): nvidia-drm and
-  // i915 read the display's state and EDID again, amdgpu reports what its hotplug handling found.
+  const auto hdrInfo = DisplayInfo();
+  const unsigned int hotplugs = m_displayWatch ? m_displayWatch->Hotplugs() : 0;
+  const bool hotplug = hotplugs != m_lookHotplugs;
+  m_lookHotplugs = hotplugs;
+  const CDisplayLook::Read how = CDisplayLook::HowToRead(m_dvDisplaySeen, m_dvDisabled, hotplug);
+  const auto lookStart = std::chrono::steady_clock::now();
   drmModeConnector* probed =
-      drmModeGetConnector(m_DRM->GetFileDescriptor(), *connector->GetConnectorId());
+      how == CDisplayLook::Read::PROBE
+          ? drmModeGetConnector(m_DRM->GetFileDescriptor(), *connector->GetConnectorId())
+          : drmModeGetConnectorCurrent(m_DRM->GetFileDescriptor(), *connector->GetConnectorId());
   if (!probed)
     return false;
   const uint32_t edidProperty = connector->GetPropertyId("EDID");
@@ -1423,26 +1433,38 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
       drmModeFreePropertyBlob(data);
     }
   }
-  // No EDID, or one that cannot be read (a TV waking up): native output waits for the next video,
-  // and the display information stays as it was.
+  // No EDID, or one that cannot be read (a TV waking up): the display information stays as it was
+  // (HDR10 is never lost to a read at the wrong moment), and native output waits for the next
+  // video where the display was probed.
   std::shared_ptr<const UTILS::CDisplayInfo> changed;
-  if (!edid.empty() && edid != m_displayEdid)
+  const bool same = !edid.empty() && edid == m_displayEdid;
+  if (!edid.empty() && !same)
     changed = UTILS::CDisplayInfo::Create(edid);
-  if (edid.empty() || (edid != m_displayEdid && !changed))
+  const CDisplayLook::Outcome outcome =
+      CDisplayLook::Of(how, edid.empty(), same, changed != nullptr);
+  CLog::Log(LOGDEBUG, "DVBridge: the display was looked at ({}) in {:.2f} ms: {}",
+            how == CDisplayLook::Read::PROBE ? "probed" : "the EDID that the kernel has",
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - lookStart)
+                .count(),
+            outcome.adopt ? "another EDID" : same ? "the same EDID" : "no EDID that can be read");
+  if (outcome.unread)
   {
     if (!m_dvEdidUnread.exchange(true))
       CLog::Log(LOGINFO, "DVBridge: the display's EDID could not be read; native Dolby Vision "
                          "output waits for the next video");
     return back;
   }
-  m_dvEdidUnread = false;
-  if (edid == m_displayEdid)
+  if (outcome.read)
+    m_dvEdidUnread = false;
+  if (!outcome.adopt)
     return back;
   m_displayEdid = edid;
   another = true;
   {
+    // Hades: of the decisions of HDR too: both are of the display that is there now
     std::unique_lock lock(m_infoLock);
     m_dvInfo = changed;
+    m_info = changed;
   }
   // Hades: ... and what the display now says of stereoscopic 3D
   if (SetStereoEdid(edid))
@@ -1455,8 +1477,26 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
     m_dvDisplayGeneration++;
   if (changed->SupportsDolbyVision())
     m_dvDisplaySeen = true;
-  CLog::Log(LOGINFO, "DVBridge: the display's EDID changed; Dolby Vision Standard: {}",
-            changed->SupportsStandardDolbyVision() ? "yes" : "no");
+  // One line: what the display takes now, against what was known of it
+  const auto yes = [](bool b) { return b ? "yes" : "no"; };
+  const auto hdr10 = [](const UTILS::CDisplayInfo* i)
+  { return i && i->SupportsHDRStaticMetadataType1() && i->SupportsEOTF(UTILS::Eotf::PQ); };
+  const auto hlg = [](const UTILS::CDisplayInfo* i)
+  { return i && i->SupportsHDRStaticMetadataType1() && i->SupportsEOTF(UTILS::Eotf::HLG); };
+  const bool hdrChanged = hdr10(hdrInfo.get()) != hdr10(changed.get()) ||
+                          hlg(hdrInfo.get()) != hlg(changed.get());
+  CLog::Log(LOGINFO,
+            "DVBridge: the display's EDID changed ({} when this video started){}: Dolby Vision "
+            "Standard {} -> {}, HDR10 {} -> {}, HLG {} -> {}",
+            how == CDisplayLook::Read::PROBE ? "probed" : "read from the kernel",
+            dvChanged || hdrChanged ? ", and what it takes" : "",
+            yes(info && info->SupportsStandardDolbyVision()),
+            yes(changed->SupportsStandardDolbyVision()), yes(hdr10(hdrInfo.get())),
+            yes(hdr10(changed.get())), yes(hlg(hdrInfo.get())), yes(hlg(changed.get())));
+  // ... and the following of displays ranks the output in use by what it has now
+  if (m_displayWatch)
+    m_displayWatch->SetInUseDolbyVision(connector->GetType() == "HDMI-A" &&
+                                        changed->SupportsStandardDolbyVision());
   // told again only when the display enters that state (not for another change of its EDID, such
   // as the audio formats of a sound bar that wakes up)
   if (changed->UhdLimitedToHdmi14() && !(info && info->UhdLimitedToHdmi14()))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 2d70122..1cc9898 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -10,6 +10,7 @@
 
 #include "VideoLayerBridge.h"
 #ifdef HAVE_DVBRIDGE
+#include "DisplayLook.h"
 #include "ModeChangeHold.h"
 #endif
 #include "drm/DRMObject.h"
@@ -106,8 +107,8 @@ public:
   //! again and, when it changed, native output disabled by a failure is tried with this video. Only
   //! here and in DVVideoOpened(), so that whether native output is possible never changes in the
   //! middle of a video, whose decoder is set up for it or not when the video opens.
-  //! \return whether the display is connected again or has another EDID. Never for a display
-  //!         that is not looked at again (see CheckDisplayChange()).
+  //! \return whether the display is connected again or has another EDID (see
+  //!         CheckDisplayChange(), which looks at every display)
   bool DVNewVideo();
   //! The video opened (its input and demuxer, before its streams): after a failure, it counts
   //! towards trying native output again. A video that does not open does not count.
@@ -230,11 +231,14 @@ protected:
   bool m_dvRestoreRequeue = false;
   std::atomic<bool> m_limitedInputPending{false}; //!< see NotifyLimitedInput()
 #ifdef HAVE_DVBRIDGE
-  //! Looks at the display again (DVNewVideo), once a display that offers Dolby Vision has been seen
-  //! in this session or after a failure, so that nothing changes for other displays: the connector
-  //! is probed (nvidia-drm and i915 read the display's state and EDID again; amdgpu reports what its
-  //! hotplug handling found). A changed EDID replaces the display information of the Dolby Vision
-  //! decisions (DVDisplayInfo); one that cannot be read blocks native output for this video only.
+  //! Looks at the display again (DVNewVideo), every display, as CDisplayLook decides: probed (the
+  //! connector: nvidia-drm and i915 read the display's state and EDID again; amdgpu reports
+  //! what its hotplug handling found) once a display that offers Dolby Vision has been seen in
+  //! this session, after a failure, or after a hot-plug event of the device since the last look;
+  //! otherwise by the EDID that the kernel has now, without a probe. Another EDID that can be
+  //! read replaces the display information of the Dolby Vision decisions (DVDisplayInfo) and of
+  //! HDR (DisplayInfo); none, or one that cannot be read, replaces nothing, and blocks native
+  //! output for this video only where the display was probed.
   //! True when the display is connected again or what native output depends on changed.
   //! \param[out] another the display is connected again or has another EDID, whatever changed
   //!             in it
@@ -294,6 +298,9 @@ protected:
   unsigned int m_dvRetryWait{0}; //!< videos still to start before native output is tried again
   unsigned int m_dvRetryBackoff{0}; //!< the wait after the last failure: 1, 2, 4, 8
   std::vector<uint8_t> m_displayEdid; //!< set at init, then only by DVNewVideo (VideoPlayer)
+  //! Hades: the hot-plug events of the device that the last look at the display had heard of
+  //! (CDRMDisplayWatch::Hotplugs()); only DVNewVideo (VideoPlayer)
+  unsigned int m_lookHotplugs{0};
   std::atomic<bool> m_displayGone{false};
   //! Counts the changes of what native output depends on in the display information (m_dvInfo)
   std::atomic<unsigned int> m_dvDisplayGeneration{0};
@@ -379,7 +386,7 @@ private:
   //! connector as they were when the resolutions were made of them (UpdateResolutions(): the
   //! place of a mode among them is the strId of its resolution), and the 3D part of its
   //! EDID, read when Kodi started on the display and again whenever that EDID is found
-  //! changed (CheckDisplayChange(), which looks only at a display that has Dolby Vision).
+  //! changed (CheckDisplayChange(), when a video starts).
   std::vector<STEREO::Mode> m_stereoModes;
   STEREO::Edid3D m_stereoEdid;
   //! \return whether what follows from it (m_stereoDisplay) changed
@@ -395,7 +402,9 @@ private:
   KODI::UTILS::Colorimetry m_colorimetry = KODI::UTILS::Colorimetry::DEFAULT;
 
   //! The display information from its EDID at Kodi's start, as in Kodi: HDR and colorimetry
-  //! decisions. Read through DisplayInfo().
+  //! decisions. Hades: replaced, with the one of the Dolby Vision decisions, when a video starts
+  //! and the display has another EDID that can be read (CheckDisplayChange(); never by none, or
+  //! by one that cannot be read). Read through DisplayInfo(), from any thread.
   std::shared_ptr<const UTILS::CDisplayInfo> DisplayInfo() const;
   //! The display information for the Dolby Vision decisions: the one of Kodi's start, replaced when
   //! a video starts and the display's EDID changed (CheckDisplayChange). Read through
diff --git a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
index a12e822..8a0f1d9 100644
--- a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
+++ b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
@@ -710,6 +710,10 @@ void CDRMDisplayWatch::Watch()
         {
           pending = true;
           notBefore = std::max(notBefore, now + SETTLE_TIME);
+          // Hades: of the device in use, for the look at its display when a video starts
+          const char* node = udev_device_get_devnode(device);
+          if (!node || m_node == node)
+            m_hotplugs.fetch_add(1, std::memory_order_relaxed);
         }
         udev_device_unref(device);
       }
@@ -729,6 +733,11 @@ void CDRMDisplayWatch::Watch()
     if (!pending || now < notBefore)
       continue;
 
+    // Hades: what the display in use has now, where it was looked at again when a video started
+    // (a TV that takes Dolby Vision since, or no longer): its output ranks as it does now
+    if (const int dolbyVision = m_inUseDolbyVision.exchange(-1); dolbyVision >= 0)
+      m_inUse.dolbyVision = dolbyVision != 0;
+
     // Nothing is looked at, and nothing is asked of Kodi, where no display could be a reason
     // to move. (What the settings name is told to this: SetAsked().)
     const std::string asked = Asked();
diff --git a/xbmc/windowing/gbm/drm/DRMDisplayWatch.h b/xbmc/windowing/gbm/drm/DRMDisplayWatch.h
index de14593..229d5e8 100644
--- a/xbmc/windowing/gbm/drm/DRMDisplayWatch.h
+++ b/xbmc/windowing/gbm/drm/DRMDisplayWatch.h
@@ -83,6 +83,16 @@ public:
   void SetAsked(const std::string& asked);
   //! A video is being set up, or has just ended (from the thread that draws)
   void VideoSeen() { m_videoSeen.store(Now(), std::memory_order_relaxed); }
+  //! Hades: the hot-plug events of the device in use heard so far (from any thread): one since
+  //! the last look at the display has it probed when the next video starts (CDisplayLook)
+  unsigned int Hotplugs() const { return m_hotplugs.load(std::memory_order_relaxed); }
+  //! Hades: the display in use was looked at again (a video started), and does or does not take
+  //! Dolby Vision Standard now: the rank of the output in use is that of what it has (from any
+  //! thread; taken before the next look at the outputs)
+  void SetInUseDolbyVision(bool dolbyVision)
+  {
+    m_inUseDolbyVision.store(dolbyVision ? 1 : 0, std::memory_order_relaxed);
+  }
 
 private:
   void Process() override;
@@ -111,6 +121,8 @@ private:
   mutable CCriticalSection m_section; //!< m_asked
   std::string m_asked;
   std::atomic<int64_t> m_videoSeen;
+  std::atomic<unsigned int> m_hotplugs{0}; //!< see Hotplugs()
+  std::atomic<int> m_inUseDolbyVision{-1}; //!< see SetInUseDolbyVision(); -1: nothing new
 };
 
