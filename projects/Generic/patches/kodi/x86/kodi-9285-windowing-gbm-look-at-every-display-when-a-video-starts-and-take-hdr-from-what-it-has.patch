diff --git a/xbmc/windowing/gbm/DisplayLook.h b/xbmc/windowing/gbm/DisplayLook.h
new file mode 100644
index 0000000..2648379
--- /dev/null
+++ b/xbmc/windowing/gbm/DisplayLook.h
@@ -0,0 +1,100 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
