 msgctxt "#32121"
-msgid "No Java runtime could be loaded from {0}: reinstall \"JRE for BD-J menus\" from the LibreELEC Add-ons repository, or correct JAVA_HOME."
-msgstr "No se pudo cargar ningún entorno de ejecución de Java desde {0}: vuelve a instalar \"JRE for BD-J menus\" desde el repositorio LibreELEC Add-ons, o corrige JAVA_HOME."
