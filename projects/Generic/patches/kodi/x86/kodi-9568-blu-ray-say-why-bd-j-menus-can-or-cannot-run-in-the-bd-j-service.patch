index a83267a..6208574 100644
--- a/xbmc/filesystem/BlurayJava.h
+++ b/xbmc/filesystem/BlurayJava.h
@@ -21,138 +21,75 @@ namespace BLURAYJAVA
 /*!
  * \brief What stands between a Blu-ray disc and its Java (BD-J) menus.
  *
- * libbluray answers with two bits (BLURAY_DISC_INFO::libjvm_detected and bdj_handled): a JVM can
- * be loaded, and the jar of this very libbluray version was found as well. Why not is in the
- * environment that Kodi was started with. On LibreELEC the Java runtime is an add-on, "JRE for
- * BD-J menus" (tools.jre.zulu), and what it needs comes from its profile, which kodi.sh reads once,
- * when Kodi starts: JAVA_HOME, its folder, where libbluray loads the JVM from, and its lib folder
- * in LD_LIBRARY_PATH, with the X11 libraries that the JVM's AWT loads when a menu starts. So an
- * add-on installed while Kodi runs is not in effect until Kodi starts again, and nothing that Kodi
- * could set from inside changes the library path of the dynamic loader: that is a restart, not a
- * missing Java, and it is said so.
+ * The Java code of a disc never runs in Kodi. libbluray hands a disc with BD-J titles over to
+ * the BD-J service of the system, hades-bdj: a process of its own for each disc, which runs the
+ * menus in the Java runtime that comes with the system, sees the disc only through Kodi, and
+ * ends with it. libbluray says whether it can hand discs over (BLURAY_DISC_INFO::bdj_handled);
+ * where it cannot, the files and the socket of the service say why. Nothing has to be installed:
+ * the add-on "JRE for BD-J menus" (tools.jre.zulu) of LibreELEC's repository is not used.
  */
 enum class BdjState
 {
-  READY, //!< a JVM loads and the jar of this libbluray was found
-  NO_RUNTIME, //!< no JVM, JAVA_HOME is not set and the Java runtime add-on is not installed
-  RESTART_NEEDED, //!< the add-on is installed, but this Kodi was started before it
-  RUNTIME_NOT_LOADABLE, //!< JAVA_HOME is in effect (the add-on's or another), no JVM loads from it
-  NO_JAR, //!< a JVM loads, the jar of this libbluray version was not found
-  RUNTIME_TOO_NEW, //!< a JVM loads and the jar was found, but it is Java 24 or later
-  START_FAILED, //!< everything was found, and libbluray could not start the disc's Java
+  READY, //!< libbluray can hand BD-J discs to the service
+  NO_SERVICE, //!< the system has no BD-J service: its program or its Java runtime is missing
+  NO_JAR, //!< the Java part of this libbluray version is missing
+  SERVICE_NOT_RUNNING, //!< the service is installed, and its socket is not there
+  UNAVAILABLE, //!< the service is there, and libbluray says that it cannot run BD-J
+  START_FAILED, //!< libbluray reported a BD-J error (BD_ERROR_BDJ) on a disc it handed over
 };
 
+//! The program of the BD-J service, which runs the Java code of one disc
+inline constexpr std::string_view SERVICE_PROGRAM = "/usr/lib/hades-bdj/hades-bdj-host";
+//! Its Java runtime (JAVA_HOME of the service), with its "release" file
+inline constexpr std::string_view SERVICE_RUNTIME = "/usr/lib/hades-bdj/jre";
+//! The socket that systemd listens on for the service (hades-bdj.socket)
+inline constexpr std::string_view SERVICE_SOCKET = "/run/hades-bdj/bdj.sock";
+//! What libbluray reads instead of SERVICE_SOCKET, for tests
+inline constexpr std::string_view SERVICE_SOCKET_ENV = "LIBBLURAY_BDJ_HOST_SOCKET";
+//! Where libbluray finds the Java part of its own version (../share/java beside the library)
+inline constexpr std::string_view JAR_FOLDER = "/usr/share/java";
+//! The setting of BD-Live, the Internet for the Java of a disc (off by default)
+inline constexpr std::string_view BDLIVE_SETTING = "bluray.hadesbdlive";
+//! The Java runtime add-on of LibreELEC's repository, no longer used
+inline constexpr std::string_view JRE_ADDON_ID = "tools.jre.zulu";
 /*!
- * \brief The first Java without a security manager (JEP 486, Java 24).
- *
- * libbluray runs the Java code of a disc only under its own security manager
- * (org.videolan.BDJSecurityManager), which keeps that code to the disc: it fails closed when it
- * cannot install it, and from Java 24 on System.setSecurityManager() always throws. Such a
- * runtime loads, and libbluray's own check says yes; the menus then do not start
- * (BD_ERROR_BDJ).
- */
-inline constexpr int FIRST_JAVA_WITHOUT_SECURITY_MANAGER = 24;
