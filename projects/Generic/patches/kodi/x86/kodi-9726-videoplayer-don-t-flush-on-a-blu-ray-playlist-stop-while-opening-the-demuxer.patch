From 35997361641ebc54f391b98c7b0101b07fe59100 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 29 Oct 2026 00:31:56 +0000
Subject: [PATCH] [VideoPlayer] Don't flush on a Blu-ray playlist stop while
 opening the demuxer

libbluray can report BD_EVENT_PLAYLIST_STOP while the demuxer for the
next playlist is being probed, e.g. when BD-J selects the same playlist
twice. The GENERAL_FLUSH it queues is only handled after the new streams
are open and the first packet has been sent, so that packet is flushed
and the video decoder starts on a non-keyframe. With VC-1 on Intel
DXVA this crashes the driver on the transition from the menu to the
movie.

No audio or video stream is open at that point, so there is nothing of
theirs to flush. The subtitle player isn't closed on a stream change,
so it is flushed straight away instead, which clears the old playlist's
subtitle and menu overlays before the new playlist's packets arrive.

A stop handled by NextStream() is queued before the next-stream path
closes the streams, and consumed once they are closed. FlushBuffers()
then only waits out the 1s synchronize of the closed players, so the
same check is made when the flush is consumed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 897397a..03e3cdf 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3617,7 +3617,11 @@ void CVideoPlayer::HandleMessages()
     }
     else if (pMsg->IsType(CDVDMsg::GENERAL_FLUSH))
     {
-      FlushBuffers(DVD_NOPTS_VALUE, true, true);
+      // a Blu-ray playlist stop handled by NextStream() is queued before the streams are closed
+      if (m_CurrentAudio.id >= 0 || m_CurrentVideo.id >= 0)
+        FlushBuffers(DVD_NOPTS_VALUE, true, true);
+      else
+        m_VideoPlayerSubtitle->Flush();
     }
     else if (pMsg->IsType(CDVDMsg::PLAYER_SETSPEED))
     {
@@ -5133,7 +5137,13 @@ int CVideoPlayer::OnDiscNavResult(void* pData, int iMessage)
     case BD_EVENT_PLAYLIST_STOP:
       m_dvd.state = DVDSTATE_NORMAL;
       m_dvd.iDVDStillTime = 0ms;
-      m_messenger.Put(std::make_shared<CDVDMsg>(CDVDMsg::GENERAL_FLUSH));
+      // while the demuxer is being opened no streams are open yet, and a queued flush would only
+      // discard the first packets of the streams opened next. The subtitle player isn't closed
+      // on a stream change, so its overlays are flushed now.
+      if (m_CurrentAudio.id >= 0 || m_CurrentVideo.id >= 0)
+        m_messenger.Put(std::make_shared<CDVDMsg>(CDVDMsg::GENERAL_FLUSH));
+      else
+        m_VideoPlayerSubtitle->Flush();
       break;
     case BD_EVENT_AUDIO_STREAM:
       m_dvd.iSelectedAudioStream = *static_cast<int*>(pData);
-- 
