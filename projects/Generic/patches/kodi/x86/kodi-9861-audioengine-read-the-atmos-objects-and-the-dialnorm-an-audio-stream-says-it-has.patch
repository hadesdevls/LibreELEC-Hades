+#pragma once
+
+// Hades: what an audio stream says of itself that the player information shows: the bed and the
+// objects of Dolby Atmos, and the dialogue level (dialnorm). Read from the bytes of the demuxed
+// packets, so that it is the same whether the stream passes through or is decoded (FFmpeg's
+// decoders give neither: the profile says Atmos, nothing more). Only what the stream says is
+// given; a field that is absent, reserved or not understood gives nothing, never a guess.
+//
+// What is read, and from where (the clauses are of the documents named; nothing else is assumed):
+//
+// - AC-3: dialnorm of the bit stream information (ATSC A/52, 5.4.2.8; the position of the field
+//   after acmod as in 5.4.2), and the value as FFmpeg's decoder applies it (ac3dec.c: code n is
+//   -n dB, and the reserved code 0 is -31 dB). The frame must pass its CRC (the whole frame after
+//   the syncword gives 0, as FFmpeg checks it).
+// - E-AC-3: dialnorm of the independent substream 0 (A/52 Annex E, E.1.2.2), or of the AC-3
+//   frame that comes first in a stream that has one (Blu-ray); the same value rule and CRC.
+//   Objects: the object audio metadata (OAMD, EMDF payload 11) of ETSI TS 103 420 V1.2.1
+//   (5.5.2 object_audio_metadata_payload, 5.5.3 program_assignment, 5.6.0.x and 5.6.1.1.4-6 for
+//   the beds), in its EMDF container (TS 103 420, 8.2: "the last dependent substream" when there
+//   are dependent substreams). The EMDF container is found by its syncword and read as MediaInfo
+//   and avdvplus read it (ETSI TS 102 366 Annex H was not read here); only a container whose
+//   payloads all fit, of version 0, ending with protection data, counts, and only OAMD of
+//   version 0.
+// - TrueHD: the 16-channel presentation of the major sync (its presence: substream_info bit 7;
+//   16ch_channel_count; program_assignment) as MediaInfo and avdvplus read it; the layout of the
+//   major sync up to the extra channel meaning is the one FFmpeg's encoder writes (mlpenc.c,
+//   write_major_sync) and its parser measures (mlp_parse.c), with its checksum. Dolby's
+//   description of the stream could not be fetched: there is no public specification of the
+//   16-channel meaning behind this. TrueHD's dialogue norm is not given: what its codes mean
+//   could not be read anywhere.
+// - DTS: DIALNORM of the core frame header (ETSI TS 102 114 V1.6.1, 5.4.2 table 5-1 and table
+//   5-20: VERNUM 7, -DIALNORM dB; VERNUM 6, -(16 + DIALNORM) dB; any other VERNUM says nothing),
+//   unless the frame has a Rev2 auxiliary data chunk (5.8.3), which takes priority: its
+//   DIALNORM_rev2aux (-n dB) when it has one and no DRC values before it (their number is that of
+//   subsubframes, not read here: then nothing), and otherwise the core's. The chunk's CRC is not
+//   checked (its definition was not read): a chunk is one whose size and fields fit in the frame.
+//   DTS:X: no bed or objects. The object audio of DTS:X is not in ETSI TS 102 114, and what the
+//   builds that show "DTS:X [n bed ch]" count is the channels of the extension substream's asset
+//   plus the height speakers of its mask: a layout, not the objects.
+//
+// The names of the labels that show this, and the meaning of their values, are those of the
+// CoreELEC builds of avdvplus (Player.Process(audio.bed.channels), audio.object.count,
+// audio.dialnorm); the reading is Hades' own.
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace KODI::AE::PRESENTATION
+{
+
+enum class Codec
+{
+  NONE,
+  AC3,
+  EAC3,
+  TRUEHD,
+  DTS
+};
+
+//! The channels of the beds, by layer: around the listener (L R C Ls Rs Lb Rb Lw Rw), LFE (LFE,
+//! LFE2) and overhead (Ltf Rtf Lts Rts Ltb Rtb)
+struct Bed
+{
+  int main = 0;
+  int lfe = 0;
+  int top = 0;
+
+  int Channels() const { return main + lfe + top; }
+  //! "7.1.2", "5.1", "7.1"; "LFE" for an LFE alone; "" for no bed
+  std::string Name() const
+  {
+    if (Channels() == 0)
+      return {};
+    if (main == 0 && top == 0)
+      return lfe == 1 ? "LFE" : std::to_string(lfe) + " LFE";
+    std::string name = std::to_string(main) + "." + std::to_string(lfe);
+    if (top > 0)
+      name += "." + std::to_string(top);
+    return name;
+  }
+  bool operator==(const Bed& other) const
+  {
+    return main == other.main && lfe == other.lfe && top == other.top;
+  }
+};
+
+//! What the object audio metadata says: the beds and the number of dynamic objects (the objects
+//! of an intermediate spatial format are neither)
+struct Objects
+{
+  Bed bed;
+  int dynamic = 0;
+  bool operator==(const Objects& other) const
+  {
+    return bed == other.bed && dynamic == other.dynamic;
+  }
+};
+
+struct Facts
+{
+  std::optional<Objects> objects;
+  std::optional<int> dialnorm; //!< dB (0 to -31)
+  bool operator==(const Facts& other) const
+  {
+    return objects == other.objects && dialnorm == other.dialnorm;
+  }
+};
+
+namespace DETAIL
+{
+
+//! Most significant bit first, as all of these streams are written
+class CBits
+{
+public:
+  CBits(const uint8_t* data, size_t bytes, size_t startBit = 0, size_t endBit = SIZE_MAX)
+    : m_data(data), m_end(std::min(bytes * 8, endBit)), m_pos(startBit)
+  {
+    if (m_pos > m_end)
+      m_ok = false;
+  }
+  uint32_t Read(unsigned int n)
+  {
+    if (n > 32 || !m_ok || m_end - m_pos < n)
+    {
+      m_ok = false;
+      return 0;
+    }
+    uint32_t value = 0;
+    for (unsigned int i = 0; i < n; ++i, ++m_pos)
+      value = (value << 1) | ((m_data[m_pos >> 3] >> (7 - (m_pos & 7))) & 1);
+    return value;
+  }
+  bool Flag() { return Read(1) != 0; }
+  void Skip(size_t n)
+  {
+    if (!m_ok || m_end - m_pos < n)
+      m_ok = false;
+    else
+      m_pos += n;
+  }
+  //! variable_bits(n) of EMDF (as MediaInfo and avdvplus read it); at most 8 extensions
+  uint32_t Variable(unsigned int n)
+  {
+    uint32_t value = 0;
+    for (int i = 0; i < 8; ++i)
+    {
+      value += Read(n);
+      if (!Flag())
+        return m_ok ? value : 0;
+      value = (value << n) + (1u << n);
+    }
+    m_ok = false;
+    return 0;
+  }
+  bool Ok() const { return m_ok; }
+  size_t Pos() const { return m_pos; }
+  size_t End() const { return m_end; }
+
+private:
+  const uint8_t* m_data;
+  size_t m_end;
+  size_t m_pos;
+  bool m_ok = true;
+};
+
+//! CRC-16, most significant bit first, initial value 0, of a polynomial
+template<uint16_t POLY>
+struct CCrc16
+{
+  std::array<uint16_t, 256> table{};
+  constexpr CCrc16()
+  {
+    for (unsigned int i = 0; i < 256; ++i)
+    {
+      uint16_t c = static_cast<uint16_t>(i << 8);
+      for (int j = 0; j < 8; ++j)
+        c = static_cast<uint16_t>((c & 0x8000) ? (c << 1) ^ POLY : c << 1);
+      table[i] = c;
+    }
+  }
+  uint16_t operator()(const uint8_t* data, size_t size) const
+  {
+    uint16_t crc = 0;
+    for (size_t i = 0; i < size; ++i)
+      crc = static_cast<uint16_t>((crc << 8) ^ table[((crc >> 8) ^ data[i]) & 0xFF]);
+    return crc;
+  }
+};
+
+//! AC-3 and E-AC-3 (x^16 + x^15 + x^2 + 1, A/52 5.4.1.2; FFmpeg's AV_CRC_16_ANSI)
+inline uint16_t CrcAC3(const uint8_t* data, size_t size)
+{
+  static constexpr CCrc16<0x8005> crc;
+  return crc(data, size);
+}
+
+//! The major sync of TrueHD (FFmpeg's ff_mlp_checksum16(): polynomial 0x002D)
+inline uint16_t CrcMLP(const uint8_t* data, size_t size)
+{
+  static constexpr CCrc16<0x002D> crc;
+  return crc(data, size);
+}
+
+//! code n of dialnorm (A/52): -n dB; 0 is reserved, and FFmpeg's decoder applies -31 dB for it
+inline int AC3Dialnorm(uint32_t code)
+{
+  return code == 0 ? -31 : -static_cast<int>(code);
+}
+
+//! The size of an AC-3 syncframe in bytes (A/52 table 5.18, as Kodi's CAEStreamParser computes it),
+//! 0 if fscod or frmsizecod is not valid
+inline size_t AC3FrameBytes(unsigned int fscod, unsigned int frmsizecod)
+{
+  static constexpr uint16_t kbps[19] = {32,  40,  48,  56,  64,  80,  96,  112, 128, 160,
+                                        192, 224, 256, 320, 384, 448, 512, 576, 640};
+  if (fscod == 3 || frmsizecod > 37)
+    return 0;
+  const unsigned int rate = kbps[frmsizecod >> 1];
+  switch (fscod)
+  {
+    case 0:
+      return rate * 4;
+    case 1:
+      return (320 * rate / 147 + (frmsizecod & 1)) * 2;
+    default:
+      return rate * 8;
+  }
+}
+
+//! One syncframe of AC-3 or E-AC-3 at data
+struct SAC3Frame
+{
+  size_t bytes = 0; //!< 0: none here
+  bool eac3 = false; //!< bsid 11 to 16 (E-AC-3 syntax, as FFmpeg tells them apart)
+  bool independent0 = false; //!< an AC-3 frame, or E-AC-3 independent substream 0
+  bool dependent = false; //!< E-AC-3 dependent substream
+  std::optional<int> dialnorm;
+};
+
+inline SAC3Frame ReadAC3Frame(const uint8_t* data, size_t size)
+{
+  SAC3Frame frame;
+  if (size < 8 || data[0] != 0x0B || data[1] != 0x77)
+    return frame;
+  const unsigned int bsid = data[5] >> 3;
+  if (bsid > 16)
+    return frame;
+  if (bsid <= 10)
+  {
+    // syncinfo: syncword 16, crc1 16, fscod 2, frmsizecod 6; bsi: bsid 5, bsmod 3, acmod 3,
+    // cmixlev 2 if a third front channel, surmixlev 2 if surround, dsurmod 2 if 2/0, lfeon 1,
+    // dialnorm 5 (A/52 5.4.1, 5.4.2)
+    const size_t bytes = AC3FrameBytes(data[4] >> 6, data[4] & 0x3F);
+    if (bytes == 0 || bytes > size || CrcAC3(data + 2, bytes - 2) != 0)
+      return frame;
+    CBits bits(data, bytes, 5 * 8 + 5 + 3);
+    const uint32_t acmod = bits.Read(3);
+    if ((acmod & 1) && acmod != 1)
+      bits.Skip(2);
+    if (acmod & 4)
+      bits.Skip(2);
+    if (acmod == 2)
+      bits.Skip(2);
+    bits.Skip(1);
+    const uint32_t dialnorm = bits.Read(5);
+    if (!bits.Ok())
+      return frame;
+    frame.bytes = bytes;
+    frame.independent0 = true;
+    frame.dialnorm = AC3Dialnorm(dialnorm);
+    return frame;
+  }
+  // E-AC-3: syncword 16; strmtyp 2, substreamid 3, frmsiz 11, fscod 2, fscod2 or numblkscod 2,
+  // acmod 3, lfeon 1, bsid 5, dialnorm 5 (A/52 Annex E, E.1.2.1, E.1.2.2)
+  const unsigned int strmtyp = data[2] >> 6;
+  const unsigned int substreamid = (data[2] >> 3) & 7;
+  const size_t bytes = ((((data[2] & 7u) << 8) | data[3]) + 1) * 2;
+  if (strmtyp == 3 || bytes < 8 || bytes > size || CrcAC3(data + 2, bytes - 2) != 0)
+    return frame;
+  if ((data[4] >> 6) == 3 && ((data[4] >> 4) & 3) == 3)
+    return frame;
+  frame.bytes = bytes;
+  frame.eac3 = true;
+  frame.dependent = strmtyp == 1;
+  frame.independent0 = strmtyp != 1 && substreamid == 0;
+  frame.dialnorm = AC3Dialnorm(((data[5] & 7u) << 2) | (data[6] >> 6));
+  return frame;
+}
+
+//! program_assignment() of TS 103 420 (5.5.3), objectCount being object_count (5.6.0.2) for an
+//! OAMD payload, or the 16-channel count of TrueHD. Array elements are taken with element 0 read
+//! first, as MediaInfo and avdvplus take them (table 11a, 12 and 13 give the elements).
+inline std::optional<Objects> ReadProgramAssignment(CBits& bits, int objectCount)
+{
+  Objects objects;
+  if (bits.Flag()) // b_dyn_object_only_program
+  {
+    const bool lfe = bits.Flag(); // b_lfe_present
+    if (!bits.Ok() || objectCount < (lfe ? 2 : 1))
+      return {};
+    objects.bed.lfe = lfe ? 1 : 0;
+    objects.dynamic = objectCount - objects.bed.lfe;
+    return objects;
+  }
+  // content_description[0..3], read [0] first (table 11a): [0] reserved, [1] dynamic objects,
+  // [2] intermediate spatial format (ISF), [3] bed objects. What follows the last of them that
+  // is read here (reserved_data) is not needed.
+  const uint32_t content = bits.Read(4);
+  const bool hasBed = content & 0x1;
+  const bool hasIsf = content & 0x2;
+  const bool hasDynamic = content & 0x4;
+  enum : int
+  {
+    MAIN,
+    LFE,
+    TOP
+  };
+  const auto add = [&objects](int layer, int channels)
+  { (layer == LFE ? objects.bed.lfe : layer == TOP ? objects.bed.top : objects.bed.main) += channels; };
+  if (hasBed)
+  {
+    bits.Skip(1); // b_bed_chan_distribute
+    unsigned int instances = 1;
+    if (bits.Flag()) // b_multiple_bed_instances_present
+      instances = bits.Read(3) + 2;
+    for (unsigned int i = 0; i < instances && bits.Ok(); ++i)
+    {
+      if (bits.Flag()) // b_lfe_only
+      {
+        add(LFE, 1);
+        continue;
+      }
+      if (bits.Flag()) // b_standard_chan_assign: bed_channel_assignment[0..9], table 12
+      {
+        // [0] LFE2, [1] Lw/Rw, [2] Ltb/Rtb, [3] Lts/Rts, [4] Ltf/Rtf, [5] Lb/Rb, [6] Ls/Rs,
+        // [7] LFE, [8] C, [9] L/R
+        static constexpr int width[10] = {1, 2, 2, 2, 2, 2, 2, 1, 1, 2};
+        static constexpr int layer[10] = {LFE, MAIN, TOP, TOP, TOP, MAIN, MAIN, LFE, MAIN, MAIN};
+        for (int k = 0; k < 10; ++k)
+          if (bits.Flag())
+            add(layer[k], width[k]);
+      }
+      else // nonstd_bed_channel_assignment[0..16], table 13
+      {
+        // [0] LFE2, [1] Rw, [2] Lw, [3] Rtb, [4] Ltb, [5] Rts, [6] Lts, [7] Rtf, [8] Ltf, [9] Rb,
+        // [10] Lb, [11] Rs, [12] Ls, [13] LFE, [14] C, [15] R, [16] L
+        for (int k = 0; k < 17; ++k)
+          if (bits.Flag())
+            add(k == 0 || k == 13 ? LFE : k >= 3 && k <= 8 ? TOP : MAIN, 1);
+      }
+    }
+  }
+  if (hasIsf && bits.Read(3) > 5) // intermediate_spatial_format_idx: 6, 7 reserved (table 11b)
+    return {};
+  if (hasDynamic)
+  {
+    uint32_t n = bits.Read(5);
+    if (n == 0x1F)
+      n += bits.Read(7);
+    objects.dynamic = static_cast<int>(n) + 1;
+  }
+  if (!bits.Ok() || objects.bed.Channels() + objects.dynamic > objectCount)
+    return {};
+  return objects;
+}
+
+//! object_audio_metadata_payload() (TS 103 420 5.5.2), up to its program_assignment()
+inline std::optional<Objects> ReadOAMD(CBits bits)
+{
+  uint32_t version = bits.Read(2);
+  if (version == 3)
+    version += bits.Read(3);
+  uint32_t count = bits.Read(5);
+  if (count == 0x1F)
+    count += bits.Read(7);
+  if (!bits.Ok() || version != 0)
+    return {};
+  return ReadProgramAssignment(bits, static_cast<int>(count) + 1);
+}
+
+//! An EMDF container (sync 0x5838, length) at bit start of data: the OAMD of its payload 11, if it
+//! has one and the whole container reads
+inline std::optional<Objects> ReadEMDF(const uint8_t* data, size_t bytes, size_t start)
+{
+  CBits bits(data, bytes, start);
+  if (bits.Read(16) != 0x5838)
+    return {};
+  const size_t length = bits.Read(16) * size_t{8};
+  if (!bits.Ok() || length > bits.End() - bits.Pos())
+    return {};
+  const size_t end = bits.Pos() + length;
+  CBits c(data, bytes, bits.Pos(), end);
+  uint32_t version = c.Read(2);
+  if (version == 3)
+    version += c.Variable(2);
+  if (c.Read(3) == 7) // key_id
+    c.Variable(3);
+  if (!c.Ok() || version != 0)
+    return {};
+  std::optional<Objects> found;
+  for (int payloads = 0;; ++payloads)
+  {
+    uint32_t id = c.Read(5);
+    if (id == 0x1F)
+      id += c.Variable(5);
+    if (!c.Ok() || payloads > 32)
+      return {};
+    if (id == 0)
+      break;
+    // emdf_payload_config()
+    const bool sampleOffset = c.Flag();
+    if (sampleOffset)
+      c.Skip(12);
+    if (c.Flag()) // duratione
+      c.Variable(11);
+    if (c.Flag()) // groupide
+      c.Variable(2);
+    if (c.Flag()) // codecdatae
+      return {};
+    if (!c.Flag()) // discard_unknown_payload
+    {
+      bool aligned = false;
+      if (!sampleOffset)
+      {
+        aligned = c.Flag();
+        if (aligned)
+          c.Skip(2);
+      }
+      if (sampleOffset || aligned)
+        c.Skip(7);
+    }
+    const size_t size = c.Variable(8) * size_t{8};
+    if (!c.Ok() || size > c.End() - c.Pos())
+      return {};
+    if (id == 11 && !found)
+      found = ReadOAMD(CBits(data, bytes, c.Pos(), c.Pos() + size));
+    c.Skip(size);
+  }
+  // emdf_protection(): protection_length_primary is never 0
+  if (c.Read(2) == 0 || !c.Ok())
+    return {};
+  return found;
+}
+
+//! The OAMD of an E-AC-3 syncframe: the first EMDF container in it that reads
+inline std::optional<Objects> FindOAMD(const uint8_t* data, size_t bytes)
+{
+  for (size_t bit = 0; bit + 32 <= bytes * 8; ++bit)
+  {
+    const size_t byte = bit >> 3;
+    const unsigned int shift = bit & 7;
+    const uint32_t word = (static_cast<uint32_t>(data[byte]) << 16) |
+                          (static_cast<uint32_t>(data[byte + 1]) << 8) |
+                          (byte + 2 < bytes ? data[byte + 2] : 0);
+    if (((word >> (8 - shift)) & 0xFFFF) != 0x5838)
+      continue;
+    if (auto objects = ReadEMDF(data, bytes, bit))
+      return objects;
+  }
+  return {};
+}
+
+//! The Atmos presentation of a TrueHD major sync at m (the format_sync), size bytes from there:
+//! empty optional if this is no major sync or its checksum fails; then an empty Objects
+//! optional inside for a stream without a 16-channel presentation
+inline std::optional<std::optional<Objects>> ReadTrueHDMajorSync(const uint8_t* m, size_t size)
+{
+  if (size < 28 || m[0] != 0xF8 || m[1] != 0x72 || m[2] != 0x6F || m[3] != 0xBA)
+    return {};
+  // the size of the major sync (FFmpeg's mlp_get_major_sync_size()), and its checksum
+  // (ff_mlp_read_major_sync()): CRC of all but the last 4 bytes, XOR the 2 before the last 2,
+  // equal to the last 2, both little-endian
+  const bool extra = m[25] & 1;
+  const size_t length = extra ? (m[26] >> 4) : 0;
+  const size_t bytes = 28 + (extra ? 2 + 2 * length : 0);
+  if (bytes > size)
+    return {};
+  const uint16_t crc = CrcMLP(m, bytes - 4) ^ static_cast<uint16_t>(m[bytes - 4] | (m[bytes - 3] << 8));
+  if (crc != static_cast<uint16_t>(m[bytes - 2] | (m[bytes - 1] << 8)))
+    return {};
+  // substream_info (byte 17), bit 7: a 16-channel presentation; then extra_channel_meaning
+  // (bit 207 present, 208 its length, (length + 1) * 16 bits from 208): 16ch_dialogue_norm 5,
+  // 16ch_mix_level 6, 16ch_channel_count 5 (count - 1), program_assignment()
+  if (!(m[17] & 0x80) || !extra)
+    return std::optional<Objects>{};
+  CBits bits(m, bytes, 208 + 4 + 5 + 6, 208 + (length + 1) * 16);
+  const int count = static_cast<int>(bits.Read(5)) + 1;
+  if (!bits.Ok())
+    return std::optional<Objects>{};
+  return ReadProgramAssignment(bits, count);
+}
+
+//! The dialnorm of a DTS core frame at data (16-bit words, big endian): nothing if the frame says
+//! none or it cannot be read
+inline std::optional<int> ReadDTSCore(const uint8_t* data, size_t size, size_t* frameBytes)
+{
+  *frameBytes = 0;
+  if (size < 16 || data[0] != 0x7F || data[1] != 0xFE || data[2] != 0x80 || data[3] != 0x01)
+    return {};
+  CBits bits(data, size, 32);
+  bits.Skip(1 + 5); // FTYPE, SHORT
+  const bool cpf = bits.Flag();
+  bits.Skip(7); // NBLKS
+  const size_t bytes = bits.Read(14) + 1; // FSIZE
+  bits.Skip(6 + 4 + 5 + 1 + 1 + 1 + 1 + 1 + 3 + 1 + 1 + 2 + 1); // AMODE ... HFLAG
+  if (cpf)
+    bits.Skip(16); // HCRC
+  bits.Skip(1); // FILTS
+  const uint32_t vernum = bits.Read(4);
+  bits.Skip(2 + 3 + 1 + 1); // CHIST, PCMR, SUMF, SUMS
+  const uint32_t code = bits.Read(4); // DIALNORM / UNSPEC
+  if (!bits.Ok() || bytes < 96 || bytes > size)
+    return {};
+  *frameBytes = bytes;
+
+  // a Rev2 auxiliary data chunk (5.8.3), searched back from the end of the frame on 32-bit
+  // boundaries from its start
+  for (size_t at = (bytes - 4) & ~size_t{3}; at >= 16; at -= 4)
+  {
+    if (data[at] != 0x70 || data[at + 1] != 0x04 || data[at + 2] != 0xC0 || data[at + 3] != 0x70)
+      continue;
+    CBits aux(data, bytes, (at + 4) * 8);
+    const uint32_t chunk = aux.Read(7) + 1; // nRev2AUXDataByteSize, from itself to the CRC
+    if (!aux.Ok() || chunk < 3 || chunk > 128 || at + 4 + chunk > bytes)
+      continue;
+    CBits r(data, at + 4 + chunk, (at + 4) * 8 + 7);
+    if (r.Flag()) // bESMetaDataFlag
+      r.Skip(8);
+    if (chunk <= 4 || !r.Flag()) // bBroadcastMetadataPresent
+      break; // no dialnorm in it: the core's
+    const bool drc = r.Flag();
+    const bool dialnorm = r.Flag();
+    if (!dialnorm)
+      break;
+    if (drc || !r.Ok())
+      return {};
+    // nByteAlign0: to the next byte (the chunk starts on a byte)
+    const size_t pos = r.Pos();
+    r.Skip((8 - (pos & 7)) & 7);
+    const uint32_t value = r.Read(5);
+    if (!r.Ok())
+      return {};
+    return -static_cast<int>(value);
+  }
+  if (vernum == 7)
+    return -static_cast<int>(code);
+  if (vernum == 6)
+    return -static_cast<int>(16 + code);
+  return {};
+}
+
+} // namespace DETAIL
+
+//! Reads the packets of one audio stream and keeps what they said last
+class CReader
+{
+public:
+  //! For a new stream (NONE: one of none of these codecs, which gives nothing)
+  void Reset(Codec codec)
+  {
+    m_codec = codec;
+    m_facts = {};
+    m_frames = 0;
+    m_misses = 0;
+  }
+
+  //! What the stream said last
+  const Facts& Get() const { return m_facts; }
+
+  //! A demuxed packet of the stream; true if what is known changed
+  bool Feed(const uint8_t* data, size_t size)
+  {
+    if (!data || size == 0)
+      return false;
+    Facts facts = m_facts;
+    switch (m_codec)
+    {
+      case Codec::AC3:
+      case Codec::EAC3:
+        FeedAC3(data, size, facts);
+        break;
+      case Codec::TRUEHD:
+        FeedTrueHD(data, size, facts);
+        break;
+      case Codec::DTS:
+        FeedDTS(data, size, facts);
+        break;
+      default:
+        return false;
+    }
+    if (facts == m_facts)
+      return false;
+    m_facts = facts;
+    return true;
+  }
+
+  //! E-AC-3: the objects are looked for in one packet of so many (about once a second), and are
+  //! forgotten after so many looks in a row that do not find them
+  static constexpr unsigned int LOOK_EVERY = 32;
+  static constexpr unsigned int FORGET_AFTER = 4;
+
+private:
+  void FeedAC3(const uint8_t* data, size_t size, Facts& facts)
+  {
+    const bool look = m_frames++ % LOOK_EVERY == 0 || !m_facts.objects;
+    std::optional<int> dialnorm;
+    std::optional<Objects> objects;
+    bool eac3 = false;
+    for (size_t at = 0; at + 8 <= size;)
+    {
+      const DETAIL::SAC3Frame frame = DETAIL::ReadAC3Frame(data + at, size - at);
+      if (frame.bytes == 0)
+      {
+        ++at; // not a syncframe here
+        continue;
+      }
+      if (frame.independent0 && !dialnorm)
+        dialnorm = frame.dialnorm;
+      if (frame.eac3)
+      {
+        eac3 = true;
+        // the last substream that has it (TS 103 420 8.2: the last dependent one)
+        if (look)
+          if (auto found = DETAIL::FindOAMD(data + at, frame.bytes))
+            objects = found;
+      }
+      at += frame.bytes;
+    }
+    if (dialnorm)
+      facts.dialnorm = dialnorm;
+    if (!look || !eac3)
+      return;
+    if (objects)
+    {
+      facts.objects = objects;
+      m_misses = 0;
+    }
+    else if (facts.objects && ++m_misses >= FORGET_AFTER)
+    {
+      facts.objects.reset();
+      m_misses = 0;
+    }
+  }
+
+  void FeedTrueHD(const uint8_t* data, size_t size, Facts& facts)
+  {
+    // access units: 4 bytes (check nibble, length in 16-bit words, timing), then a major sync
+    // if format_sync follows; a Blu-ray stream has AC-3 frames between them, which are skipped
+    for (size_t at = 0; at + 8 <= size;)
+    {
+      const size_t length = (((data[at] & 0x0Fu) << 8) | data[at + 1]) * 2;
+      if (auto major = DETAIL::ReadTrueHDMajorSync(data + at + 4, size - at - 4))
+      {
+        facts.objects = *major;
+        at += std::max<size_t>(length, 4);
+        continue;
+      }
+      if (data[at] == 0x0B && data[at + 1] == 0x77)
+      {
+        const DETAIL::SAC3Frame frame = DETAIL::ReadAC3Frame(data + at, size - at);
+        at += frame.bytes ? frame.bytes : 1;
+        continue;
+      }
+      // an access unit without a major sync, or no access unit here
+      at += length >= 4 ? length : 1;
+    }
+  }
+
+  void FeedDTS(const uint8_t* data, size_t size, Facts& facts)
+  {
+    for (size_t at = 0; at + 16 <= size; ++at)
+    {
+      size_t bytes = 0;
+      const std::optional<int> dialnorm = DETAIL::ReadDTSCore(data + at, size - at, &bytes);
+      if (bytes == 0)
+        continue;
+      facts.dialnorm = dialnorm;
+      return; // the first core frame of the packet
+    }
+  }
+
+  Codec m_codec = Codec::NONE;
+  Facts m_facts;
+  unsigned int m_frames = 0;
+  unsigned int m_misses = 0;
+};
+
+} // namespace KODI::AE::PRESENTATION
