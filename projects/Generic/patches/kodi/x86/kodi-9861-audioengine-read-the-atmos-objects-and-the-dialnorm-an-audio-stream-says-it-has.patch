+// Hades: the codecs whose packets say something of their presentation (AudioPresentation.h)
+KODI::AE::PRESENTATION::Codec PresentationCodec(AVCodecID codec)
+{
+  using KODI::AE::PRESENTATION::Codec;
+  switch (codec)
+  {
+    case AV_CODEC_ID_AC3:
+      return Codec::AC3;
+    case AV_CODEC_ID_EAC3:
+      return Codec::EAC3;
+    case AV_CODEC_ID_TRUEHD:
+      return Codec::TRUEHD;
+    case AV_CODEC_ID_DTS:
+      return Codec::DTS;
+    default:
+      return Codec::NONE;
+  }
+}
+
+// ... and what is known of it, for the player information (Player.Process(audio.object.count) and
+// the others)
+void PublishPresentation(const KODI::AE::PRESENTATION::Facts& facts)
+{
+  CDataCacheCore::SAudioPresentation presentation;
+  if (facts.objects)
+  {
+    presentation.objects = true;
+    presentation.bedChannels = facts.objects->bed.Channels();
+    presentation.bedName = facts.objects->bed.Name();
+    presentation.dynamicObjects = facts.objects->dynamic;
+  }
+  presentation.dialnorm = facts.dialnorm;
+  CServiceBroker::GetDataCacheCore().SetAudioPresentation(std::move(presentation));
+}
