+  video->doviHdr10PlusWins = wins;
+  video->changes++;
+  CLog::Log(LOGINFO, "CDVDDemuxFFmpeg: stream {} plays as {} from here on: it is opened again", streamIdx,
+            wins ? "the HDR10+ it also is" : "Dolby Vision");
