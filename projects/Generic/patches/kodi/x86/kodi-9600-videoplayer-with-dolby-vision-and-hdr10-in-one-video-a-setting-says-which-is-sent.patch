  */
-constexpr bool ChoiceOffered(OutputChoice choice, ChoiceSource source, int profile, int compatibility)
+//! Hades: dual, a Dolby Vision video with HDR10+ metadata of its own (DVBRIDGE::DualHdr10PlusFound()): for
+//! one whose base layer is HDR10, DOLBY_VISION (its own) and HDR10PLUS (its HDR10+) too
+constexpr bool ChoiceOffered(OutputChoice choice,
+                             ChoiceSource source,
+                             int profile,
+                             int compatibility,
+                             bool dual = false)
 {
   if (choice == OutputChoice::AUTOMATIC)
     return true;
   switch (source)
   {
     case ChoiceSource::DOLBY_VISION:
-      return choice != OutputChoice::DOLBY_VISION &&
-             OutputChoiceOffered(choice, profile, compatibility);
+      if (choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::HDR10PLUS)
+        return dual && BaseLayerIsHdr10(profile, compatibility);
+      return OutputChoiceOffered(choice, profile, compatibility);
     case ChoiceSource::HDR10:
       return choice == OutputChoice::MEASURED || choice == OutputChoice::KODI;
     case ChoiceSource::HDR10PLUS:
@@ -426,12 +437,103 @@ constexpr bool ChoiceOffered(OutputChoice choice, ChoiceSource source, int profi
 //! packets, so a choice kept for an HDR10 or HDR10+ stream stays until the demuxer looks at them
 //! (one that does not apply does nothing there: Hdr10AsDolbyVisionFor(), Hdr10PlusAsDolbyVision()).
 //! Anything else (SDR, HLG, a Dolby Vision file where an HDR10 one was) gives it up.
+//! Hades: a Dolby Vision video is known to have HDR10+ of its own only from its packets too: a choice of
+//! its Dolby Vision or of its HDR10+ kept for it stays (where its HDR10+ is not found, either one plays
+//! it as AUTOMATIC does).
 constexpr bool KeptChoiceHolds(OutputChoice choice, ChoiceSource source, int profile, int compatibility)
 {
   if (source == ChoiceSource::HDR10 || source == ChoiceSource::HDR10PLUS)
     return choice == OutputChoice::AUTOMATIC || choice == OutputChoice::MEASURED ||
            choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::KODI;
-  return ChoiceOffered(choice, source, profile, compatibility);
+  return ChoiceOffered(choice, source, profile, compatibility, source == ChoiceSource::DOLBY_VISION);
+}
+
+//! Hades: videoscreen.hadesdualhdr, which of its own metadata a video with both Dolby Vision and HDR10+
+//! metadata of its own is sent with, on a display that takes both
+enum class DualHdr
+{
+  DOLBY_VISION = 0, //!< Dolby Vision, as before (the default)
+  HDR10PLUS = 1, //!< HDR10+: its base layer (the HDR10 picture) with its own HDR10+ metadata
+};
+
+//! Hades: what a video with both is sent with, and why (DualVerdictOf())
+enum class DualVerdict
+{
+  DOLBY_VISION, //!< Dolby Vision, as the setting says
+  DOLBY_VISION_CHOSEN, //!< Dolby Vision, as the user chose for the video (OutputChoice::DOLBY_VISION)
+  HDR10PLUS, //!< HDR10+, as the setting says
+  HDR10PLUS_CHOSEN, //!< HDR10+, as the user chose for the video (OutputChoice::HDR10PLUS)
+  DISPLAY, //!< as before: the display does not take both
+  BASE_LAYER, //!< as before: its base layer is not HDR10, so there is no HDR10+ picture to send
+  OTHER_CHOICE, //!< as the user chose for the video: another output, which stands
+};
+
+/*!
+ * \brief Hades: what a Dolby Vision video whose packets carry HDR10+ metadata of its own is sent with
+ * \param setting videoscreen.hadesdualhdr (DualHdr)
+ * \param choice the output chosen for the video
+ * \param profile, compatibility its Dolby Vision profile and base layer compatibility
+ * \param nativeDV the display takes native Dolby Vision in a mode that carries it
+ * \param hdr10Plus HDR10+ metadata can be sent to the display (its block, and the connector's
+ *        HDR10PLUS_VSIF: CWinSystemGbm::HDR10PlusOutputVersion())
+ *
+ * HDR10+ only where its base layer is HDR10 (BaseLayerIsHdr10(): profile 7 of a Blu-ray disc, 8.1), whose
+ * HDR10+ metadata describe that picture; only where the display takes both; with the output chosen for the
+ * video as the settings say (AUTOMATIC) or as HDR10+. Everything else is sent as before.
+ */
+constexpr DualVerdict DualVerdictOf(
+    int setting, OutputChoice choice, int profile, int compatibility, bool nativeDV, bool hdr10Plus)
+{
+  if (!BaseLayerIsHdr10(profile, compatibility))
+    return DualVerdict::BASE_LAYER;
+  if (choice != OutputChoice::AUTOMATIC && choice != OutputChoice::DOLBY_VISION &&
+      choice != OutputChoice::HDR10PLUS)
+    return DualVerdict::OTHER_CHOICE;
+  if (!nativeDV || !hdr10Plus)
+    return DualVerdict::DISPLAY;
+  if (choice == OutputChoice::HDR10PLUS)
+    return DualVerdict::HDR10PLUS_CHOSEN;
+  if (choice == OutputChoice::DOLBY_VISION)
+    return DualVerdict::DOLBY_VISION_CHOSEN;
+  return setting == static_cast<int>(DualHdr::HDR10PLUS) ? DualVerdict::HDR10PLUS
+                                                         : DualVerdict::DOLBY_VISION;
+}
+
+//! Hades: the video is sent as the HDR10+ it also is (CDVDStreamInfo::doviHdr10PlusWins)
+constexpr bool Hdr10PlusWins(DualVerdict verdict)
+{
+  return verdict == DualVerdict::HDR10PLUS || verdict == DualVerdict::HDR10PLUS_CHOSEN;
+}
+
+//! Hades: the verdict for the log
+inline std::string DualVerdictText(
+    DualVerdict verdict, int profile, int compatibility, bool nativeDV, bool hdr10Plus)
+{
+  const std::string setting = "\"With Dolby Vision and HDR10+ in one video\" (videoscreen.hadesdualhdr)";
+  const std::string asHdr10Plus = "its base layer, the HDR10 picture, with its own HDR10+ metadata, "
+                                  "picture by picture; its Dolby Vision (its RPU and any enhancement "
+                                  "layer) is left aside";
+  switch (verdict)
+  {
+    case DualVerdict::DOLBY_VISION:
+      return "sent as Dolby Vision, as " + setting + " says (the default); its HDR10+ metadata are left aside";
+    case DualVerdict::DOLBY_VISION_CHOSEN:
+      return "sent as Dolby Vision, as the user chose for this video; its HDR10+ metadata are left aside";
+    case DualVerdict::HDR10PLUS:
+      return "sent as HDR10+, as " + setting + " says: " + asHdr10Plus;
+    case DualVerdict::HDR10PLUS_CHOSEN:
+      return "sent as HDR10+, as the user chose for this video: " + asHdr10Plus;
+    case DualVerdict::DISPLAY:
+      return std::string("the display does not take both (native Dolby Vision: ") +
+             (nativeDV ? "yes" : "no") + "; HDR10+ that can be sent: " + (hdr10Plus ? "yes" : "no") +
+             "): it plays as before, whatever " + setting + " says";
+    case DualVerdict::BASE_LAYER:
+      return "its base layer is not HDR10 (profile " + std::to_string(profile) + ", compatibility " +
+             std::to_string(compatibility) + "): it plays as before, as Dolby Vision";
+    case DualVerdict::OTHER_CHOICE:
+      return "another output was chosen for this video, which stands; " + setting + " does not apply";
+  }
+  return "";
 }
 
