+// Hades: a stream with Dolby Vision of its own (its record, or its RPUs; not measured, nor made from HDR10+)
+// whose access units carry HDR10+ metadata of their own too (CDVHdr10Plus::Read(): the SEI of ITU-T T.35 for
+// SMPTE ST 2094-40), looked for in its first packets. Which of the two it is sent with is decided when they
+// are first found (DVBRIDGE::DualHdr10PlusFound(): videoscreen.hadesdualhdr, the output chosen for the
+// video, the display), and again when the user chooses another output for the video
+// (DVOutputChoiceChanged()). Where its HDR10+ wins, the stream says so (doviHdr10PlusWins), the player opens
+// it again as for a new file (CVideoPlayer::CheckStreamChanges()), and it plays as the HDR10+ it also is:
+// its base layer, the HDR10 picture, with its HDR10+ metadata (no native output, no reconstruction). Where
+// its Dolby Vision wins (the default), nothing changes: it is only looked at.
+void CDVDDemuxFFmpeg::ProbeDualHdr10Plus(CDemuxStream* stream,
+                                         int streamIdx,
+                                         const uint8_t* data,
+                                         int size)
+{
+  static constexpr unsigned int PROBED_PACKETS = 48;
+  if (!stream || stream->type != StreamType::VIDEO || stream->codec != AV_CODEC_ID_HEVC ||
+      streamIdx == m_dvEnhancementIndex || !data || size <= 0)
+    return;
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  if (video->doviHdr10Plus || !video->dovi.dv_profile || video->doviMeasured ||
+      video->doviFromHdr10Plus || m_dvMeasured.count(streamIdx))
+    return;
+  unsigned int& probed = m_dvDualProbed[streamIdx];
+  if (probed >= PROBED_PACKETS)
+    return;
+  ++probed;
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  const CDVHdr10Plus::AccessUnit unit = CDVHdr10Plus::Read(
+      data, static_cast<size_t>(size), CDVLayerMerge::LengthSize(avStream->codecpar));
+  if (unit.t35.empty())
+  {
+    if (probed == PROBED_PACKETS)
+      CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: stream {} is Dolby Vision with no HDR10+ metadata in its first {} "
+                          "packets",
+                streamIdx, PROBED_PACKETS);
+    return;
+  }
+  video->doviHdr10Plus = true;
+  CLog::Log(LOGINFO, "CDVDDemuxFFmpeg: stream {} is Dolby Vision with HDR10+ metadata of its own (packet {} "
+                     "of those looked at)",
+            streamIdx, probed);
+  UpdateDualHdr10Plus(stream, streamIdx);
