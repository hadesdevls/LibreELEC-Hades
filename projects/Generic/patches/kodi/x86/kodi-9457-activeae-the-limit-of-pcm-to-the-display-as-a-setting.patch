@@ -231,7 +231,8 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     bool m_superviseAudioDelay = false; // Android only to correct broken audio firmwares
     //! Hades: PCM goes out in no more channels than the display of the output takes, as its audio
     //! data (ELD) say (audio/pcmchannelsfromeld; CActiveAE::LimitChannelsToDisplay()). Off for a
-    //! display that takes more than it says
+    //! display that takes more than it says; the setting audiooutput.hadespcmlimit, off, does the
+    //! same
     bool m_audioPcmChannelsFromEld = true;
 
     int   m_videoVDPAUScaling;
