diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 7cc6805..fee3749 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2969,18 +2969,21 @@ void CActiveAE::LoadSettings()
 // "Number of channels" setting at 2.0, and so does what Kodi does then: a multichannel track is
 // downmixed to stereo, or, where passthrough and "Enable Dolby Digital transcoding" are on,
 // encoded to Dolby Digital (Dolby Digital Plus where that passes through) and passed through
-// (ApplySettingsToFormat()). The setting is not changed: when the display takes more again (its audio data change, which
-// is a device change, and the settings are loaded again), the setting holds as it was.
-// <audio><pcmchannelsfromeld>false</pcmchannelsfromeld></audio> in advancedsettings.xml turns it
-// off, for a display that takes more than it says.
+// (ApplySettingsToFormat()). The setting is not changed: when the display takes more again (its
+// audio data change, which is a device change, and the settings are loaded again), the setting
+// holds as it was. "Limit PCM channels to what the display declares" (audiooutput.hadespcmlimit,
+// System > Audio, expert level, on by default) turns it off, for a display that takes more than it
+// says; so does <audio><pcmchannelsfromeld>false</pcmchannelsfromeld></audio> in
+// advancedsettings.xml, which came first.
 void CActiveAE::LimitChannelsToDisplay()
 {
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const bool fromDisplay = (!advanced || advanced->m_audioPcmChannelsFromEld) &&
+                           (!settings || settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESPCMLIMIT));
   bool kept = false;
-  const unsigned int most = !advanced || advanced->m_audioPcmChannelsFromEld
-                                ? DisplayAudioOf(m_settings.device, &kept).pcm
-                                : 0;
+  const unsigned int most = fromDisplay ? DisplayAudioOf(m_settings.device, &kept).pcm : 0;
   const int limited = AE::PCM::LimitLayout(m_settings.channels, most);
   // in the log when it changes
   const std::string told = limited != m_settings.channels
