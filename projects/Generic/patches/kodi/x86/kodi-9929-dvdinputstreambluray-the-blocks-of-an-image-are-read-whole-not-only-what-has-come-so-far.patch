From 11dc67cd4546f44c6569f76145df4fe211334e22 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:24:08 +0000
Subject: [PATCH] DVDInputStreamBluray: the blocks of an image are read whole,
 not only what has come so far

An image that Kodi reads itself (stream mode: the disc's menu, or an image opened directly) is
opened with READ_TRUNCATED, so a read returns what the image's stream holds. Over HTTP that is
what curl has delivered so far, which at the start of a transfer can be less than a block, and
ReadBlocks() read once and returned read / 2048: 0 blocks, which libudfread takes for an error.
The disc then failed to open ("failed to open ... in stream mode"), or its reading stopped. Where
the deliveries do not end on a block, a later read could end short of a block in the same way.

ReadBlocks() now reads until the blocks asked for are complete or the image ends (a read that
gives nothing, so a source that stops delivering does not keep it reading), and a read that fails
is an error (-1; it was 0 blocks). The bytes it gives are the same.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 27 ++++++++++++++-----
 1 file changed, 20 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 29a077f..6c2ed24 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1476,16 +1476,29 @@ int CDVDInputStreamBluray::ReadBlocks(uint8_t* buf, int lba, int num_blocks)
   CDVDInputStreamFile* lpstream = m_pstream.get();
   if (!lpstream)
     return -1;
-  int result = -1;
   int64_t offset = static_cast<int64_t>(lba) * 2048;
   std::unique_lock lock(m_readBlocksLock);
-  if (lpstream->Seek(offset, SEEK_SET) >= 0)
-  {
-    int64_t size = static_cast<int64_t>(num_blocks) * 2048;
-    if (size <= std::numeric_limits<int>::max())
-      result = lpstream->Read(buf, static_cast<int>(size)) / 2048;
+  if (lpstream->Seek(offset, SEEK_SET) < 0)
+    return -1;
+  const int64_t size = static_cast<int64_t>(num_blocks) * 2048;
+  if (size > std::numeric_limits<int>::max())
+    return -1;
+  // Hades: the image is opened with READ_TRUNCATED (OpenStream()), so a read returns what its stream
+  // holds: over HTTP, what curl has delivered so far, which at the start of a transfer can be less
+  // than a block, and one such read was 0 blocks, which libudfread takes for an error (the disc then
+  // failed to open, or its reading stopped). Read on until the blocks asked for are complete or the
+  // image ends (a read that gives nothing); a read that fails is an error
+  int64_t done = 0;
+  while (done < size)
+  {
+    const int got = lpstream->Read(buf + done, static_cast<int>(size - done));
+    if (got < 0)
+      return -1;
+    if (got == 0)
+      break;
+    done += got;
   }
-  return result;
+  return static_cast<int>(done / 2048);
 }
 
 void CDVDInputStreamBluray::UpdateGraphicsRange()
