From e1d26337df2c94d5657f005069ebda8657fdc103 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 25 Oct 2026 08:32:59 +0000
Subject: [PATCH] [pvr] Let the cached image clean-up stop when PVR manager
 stops

The clean-up asks the texture database for each guide's images in turn,
so with an IPTV provider's tens of thousands of channels it runs for many
minutes after every start. It runs on PVR manager's thread, so Clear data
and quitting Kodi both wait for it, and Kodi hangs until it finishes.

Stop going through the guides once PVR manager is stopping. Stale images
are cleaned up on the next start instead.
---
 xbmc/pvr/epg/EpgContainer.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/xbmc/pvr/epg/EpgContainer.cpp b/xbmc/pvr/epg/EpgContainer.cpp
index 4f1a4a6..52e17e3 100644
--- a/xbmc/pvr/epg/EpgContainer.cpp
+++ b/xbmc/pvr/epg/EpgContainer.cpp
@@ -968,9 +968,16 @@ int CPVREpgContainer::CleanupCachedImages()
   const std::map<int, std::shared_ptr<CPVREpg>> epgIdToEpgMap = m_epgIdToEpgMap;
   m_critSection.unlock();
 
-  return std::accumulate(epgIdToEpgMap.cbegin(), epgIdToEpgMap.cend(), 0,
-                         [&database](int cleanedImages, const auto& epg)
-                         { return cleanedImages + epg.second->CleanupCachedImages(database); });
+  int cleanedImages = 0;
+  for (const auto& [_, epg] : epgIdToEpgMap)
+  {
+    // With thousands of channels this takes minutes, and PVR manager can't stop until it returns
+    if (!CServiceBroker::GetPVRManager().IsStarted())
+      break;
+
+    cleanedImages += epg->CleanupCachedImages(database);
+  }
+  return cleanedImages;
 }
 
 std::vector<std::shared_ptr<CPVREpgSearchFilter>> CPVREpgContainer::GetSavedSearches(
