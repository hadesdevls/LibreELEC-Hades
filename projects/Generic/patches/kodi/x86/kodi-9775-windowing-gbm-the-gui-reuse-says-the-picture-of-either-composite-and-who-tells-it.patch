From aafd180b2911c92f2975cc58ccbe8b476dd6344b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:42:17 +0000
Subject: [PATCH] windowing/gbm: the GUI reuse says the picture of either
 composite, and who tells it

Since the GUI pass is left out also where the GUI is composited over HDR10 and
HLG (2ad3013), the reason "the frame before had no Dolby Vision picture" is told
by the HDR GUI too, of videos that are no Dolby Vision ("HDR GUI: the GUI pass is
drawn in every frame: the frame before had no Dolby Vision picture"); and the
fact behind it is told by CRenderManager from RenderEx() (NoteVideoDrawnInRenderEx()),
no longer by RenderDVBridge(), as the comments of CDVGuiReuse::Facts and of the
window system still said. The reason and the comments say what is so. Nothing
but the text of the log line changes.

Host test (outside the tree): reuse_text_test (the line of the HDR composite, and
no reason told of a Dolby Vision picture alone); before this change it fails. The reuse test (dvguireuse_test, 58 checks) passes.
---
 xbmc/windowing/gbm/DVGuiReuse.h              | 10 +++++-----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h |  3 ++-
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index efa1c2d..e31ccb8 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -43,9 +43,9 @@ namespace GBM
  * changed), stereoscopic 3D (two passes), overlays on the picture that are drawn in the GUI pass
  * (subtitles, the debug information of the player: they are not left to the dirty regions alone),
  * a frame with the GUI that was not seen yet by the picture's pass (what it was over was not
- * known), a frame before without a Dolby Vision picture (graphics of a disc menu without a picture
- * are drawn by the GUI pass). A capture marks the window manager dirty itself
- * (CApplication::FrameMove()).
+ * known), a frame before without a picture of the video drawn by RenderEx() (graphics of a disc
+ * menu without a picture are drawn by the GUI pass). A capture marks the window manager dirty
+ * itself (CApplication::FrameMove()).
  */
 class CDVGuiReuse
 {
@@ -62,7 +62,7 @@ public:
     bool overlays = false; //!< subtitles or the debug information are over the picture
     bool seen = false; //!< a frame whose GUI was drawn went through the picture's pass since
     //!< the FBO was made, and its elements are known
-    bool video = false; //!< the picture's pass (RenderDVBridge()) ran in the frame before: a disc
+    bool video = false; //!< RenderEx() drew the picture in the frame before: a disc
     //!< menu without a picture, or a renderer that is not configured, draws its
     //!< graphics in the GUI pass, and changes them where nothing says so
   };
@@ -127,7 +127,7 @@ public:
       case Why::NOT_SEEN:
         return "no frame of the GUI has been seen by the picture's pass yet";
       case Why::NO_VIDEO:
-        return "the frame before had no Dolby Vision picture";
+        return "the frame before had no picture of the video drawn under the GUI";
     }
     return "?";
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 07853e1..6bbfc59 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -491,7 +491,8 @@ private:
   bool m_guiBackDrawn{false};
   //! Hades: a frame whose GUI was drawn was composited since the FBO was made (CDVGuiReuse::Facts)
   bool m_guiSeen{false};
-  //! Hades: RenderDVBridge() ran in this frame, and in the frame before it
+  //! Hades: RenderEx() drew the picture in this frame, and in the frame before it
+  //! (NoteVideoDrawnInRenderEx(); rotated by CompositeGui())
   bool m_guiVideoNow{false};
   bool m_guiVideoLast{false};
   //! Hades: the content of the GUI FBO changes with every frame whose GUI pass draws (it counts
-- 
2.53.0

