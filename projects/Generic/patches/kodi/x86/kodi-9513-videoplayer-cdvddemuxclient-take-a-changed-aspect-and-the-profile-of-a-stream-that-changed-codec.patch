From 71bdc242fc795809ee19308e866859713b9efc67 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sun, 11 Oct 2026 19:01:00 +0100
Subject: [PATCH] [VideoPlayer][CDVDDemuxClient] Take a changed aspect, and the
 profile of a stream that changed codec

Keeping the parsed properties of a stream announced as before left two
announcements untaken:

- An announcement differing only in its aspect compared equal, as
  CDVDStreamInfo leaves the aspect out, so opening the stream again kept the
  old one.
- A stream that changed codec under the same id is built anew at the stream
  change, without profile and level, and the open that follows no longer
  initialized it. They are now set whenever the stream is built anew.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b7b3db8593c840205a74d57cc66ab9eeb516da8d)
---
 .../DVDDemuxers/DVDDemuxClient.cpp            |  9 ++-
 .../DVDDemuxers/test/TestDVDDemuxClient.cpp   | 73 ++++++++++++++++++-
 2 files changed, 78 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
index ff3ab00..33f0dc8 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
@@ -423,9 +423,12 @@ void CDVDDemuxClient::SetStreamProps(CDemuxStream *stream, std::map<int, std::sh
   std::shared_ptr<CDemuxStream> currentStream(GetStreamInternal(stream->uniqueId));
   std::shared_ptr<CDemuxStream> toStream;
 
-  // A stream announced as it was before keeps the properties ParsePacket corrected
+  // A stream announced as it was before keeps the properties ParsePacket corrected. The aspect
+  // is asked apart, as comparing two announcements leaves it out
   const auto current = std::dynamic_pointer_cast<CDemuxStreamClientInternal>(currentStream);
-  if (forceInit && current && current->m_announced == *stream)
+  const CDVDStreamInfo announced(*stream, true);
+  if (forceInit && current && current->m_announced == announced &&
+      current->m_announced.aspect == announced.aspect)
     forceInit = false;
 
   if (stream->type == StreamType::AUDIO)
@@ -620,7 +623,7 @@ void CDVDDemuxClient::SetStreamProps(CDemuxStream *stream, std::map<int, std::sh
 
   // only update profile / level if we create a new stream or has been reset stream properties
   // existing streams may be corrected by ParsePacket
-  if (!currentStream || forceInit)
+  if (toStream != currentStream || forceInit)
   {
     toStream->profile = stream->profile;
     toStream->level = stream->level;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestDVDDemuxClient.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestDVDDemuxClient.cpp
index e48b76f..2e68ef2 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestDVDDemuxClient.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestDVDDemuxClient.cpp
@@ -15,6 +15,7 @@
 
 #include <cstring>
 #include <memory>
+#include <utility>
 #include <vector>
 
 #include <gtest/gtest.h>
@@ -56,6 +57,13 @@ public:
   }
 
   void Announce(int channels) { m_channels = channels; }
+  void Announce(AVCodecID codec, int profile)
+  {
+    m_codec = codec;
+    m_profile = profile;
+  }
+  //! The next packet tells the demuxer that the streams changed
+  void SignalStreamChange() { m_streamChange = true; }
 
   int Read(uint8_t* buf, int buf_size) override { return 0; }
   int64_t Seek(int64_t offset, int whence) override { return 0; }
@@ -65,6 +73,12 @@ public:
   bool OpenDemux() override { return true; }
   DemuxPacket* ReadDemux() override
   {
+    if (std::exchange(m_streamChange, false))
+    {
+      DemuxPacket* packet = CDVDDemuxUtils::AllocateDemuxPacket(0);
+      packet->iStreamId = DMX_SPECIALID_STREAMCHANGE;
+      return packet;
+    }
     DemuxPacket* packet = CDVDDemuxUtils::AllocateDemuxPacket(static_cast<int>(m_frame.size()));
     std::memcpy(packet->pData, m_frame.data(), m_frame.size());
     packet->iSize = static_cast<int>(m_frame.size());
@@ -75,7 +89,8 @@ public:
   {
     auto stream = std::make_unique<CDemuxStreamAudio>();
     stream->uniqueId = iStreamId;
-    stream->codec = AV_CODEC_ID_AC3;
+    stream->codec = m_codec;
+    stream->profile = m_profile;
     stream->iChannels = m_channels;
     stream->iSampleRate = 48000;
     m_announced.emplace_back(std::move(stream));
@@ -94,10 +109,38 @@ public:
 
 private:
   int m_channels;
+  AVCodecID m_codec{AV_CODEC_ID_AC3};
+  int m_profile{AV_PROFILE_UNKNOWN};
+  bool m_streamChange{false};
   std::vector<uint8_t> m_frame{MakeAc3Frame()};
   mutable std::vector<std::unique_ptr<CDemuxStream>> m_announced;
 };
 
+// The same, announcing one video stream of the aspect it is told to
+class CTestVideoInputStream : public CTestDemuxInputStream
+{
+public:
+  explicit CTestVideoInputStream(double aspect) : CTestDemuxInputStream(0), m_aspect(aspect) {}
+
+  void AnnounceAspect(double aspect) { m_aspect = aspect; }
+
+  CDemuxStream* GetStream(int iStreamId) const override
+  {
+    auto stream = std::make_unique<CDemuxStreamVideo>();
+    stream->uniqueId = iStreamId;
+    stream->codec = AV_CODEC_ID_H264;
+    stream->iWidth = 720;
+    stream->iHeight = 576;
+    stream->fAspect = m_aspect;
+    m_announced.emplace_back(std::move(stream));
+    return m_announced.back().get();
+  }
+
+private:
+  double m_aspect;
+  mutable std::vector<std::unique_ptr<CDemuxStream>> m_announced;
+};
+
 int Channels(const CDVDDemuxClient& demuxer)
 {
   return static_cast<CDemuxStreamAudio*>(demuxer.GetStream(AUDIO_ID))->iChannels;
@@ -163,3 +206,31 @@ TEST(TestDVDDemuxClient, OpeningAStreamTakesAChangedAnnouncement)
 
   EXPECT_EQ(Channels(demuxer), 6);
 }
+
+TEST(TestDVDDemuxClient, OpeningAStreamTakesAChangedAspect)
+{
+  auto input = std::make_shared<CTestVideoInputStream>(1.25);
+  CDVDDemuxClient demuxer;
+  ASSERT_TRUE(demuxer.Open(input));
+  demuxer.OpenStream(AUDIO_ID);
+
+  input->AnnounceAspect(1.75);
+  demuxer.OpenStream(AUDIO_ID);
+
+  EXPECT_EQ(static_cast<CDemuxStreamVideo*>(demuxer.GetStream(AUDIO_ID))->fAspect, 1.75);
+}
+
+TEST(TestDVDDemuxClient, AStreamThatChangesCodecTakesTheAnnouncedProfile)
+{
+  auto input = std::make_shared<CTestDemuxInputStream>(2);
+  CDVDDemuxClient demuxer;
+  ASSERT_TRUE(demuxer.Open(input));
+  demuxer.OpenStream(AUDIO_ID);
+
+  input->Announce(AV_CODEC_ID_AAC, AV_PROFILE_AAC_HE);
+  input->SignalStreamChange();
+  CDVDDemuxUtils::FreeDemuxPacket(demuxer.Read());
+  demuxer.OpenStream(AUDIO_ID);
+
+  EXPECT_EQ(demuxer.GetStream(AUDIO_ID)->profile, AV_PROFILE_AAC_HE);
+}
