From ec4aebff2474f49080a3c29a216748e85f935bcb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:11:37 +0000
Subject: [PATCH] windowing/gbm: a mode with no transport mode at its rate is
 told by its rates, not by Intel

Where native Dolby Vision output cannot be had because the mode in use is not a transport mode
and the output has transport modes at other refresh rates only ("noratemode"), kodi.log gave one
example for every output: "an HDMI port of 300 MHz, as on Intel graphics of display version 9,
reaches 30 Hz at 3840x2160". A laptop with an RTX 4080 got it in its menus at 3840x2160 120 Hz
over nvidia-drm, where neither Intel nor the port had anything to do with it: the transport goes
to 60 Hz at most.

The line is now made from the driver's own modes (DVBRIDGE::NoRateModeReason()): a mode at a rate
that the transport never takes (above 60 Hz, or 48 Hz) is told as that, with the rates at which
the output has the transport; a transport rate at which the output has no 3840x2160 mode is told
with the rates it has instead, and only where those stop at 30 Hz, that an HDMI link of 300 MHz
goes no further. No brand is named. The reason code of the player information (noratemode), and
when it is given, are as they were.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 69 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 26 +++++--
 2 files changed, 90 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index b2f3120..bd20257 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -3,6 +3,7 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdio>
 #include <initializer_list>
 #include <string>
 #include <vector>
@@ -167,6 +168,74 @@ inline TransportModes TransportModesOf(const std::vector<ModeTraits>& modes, dou
   return any ? TransportModes::OTHER_RATES : TransportModes::NONE;
 }
 
+/*!
+ * \brief Hades: the refresh rates at which a list of modes offers native output, lowest first and
+ *        each once (matched as TransportModesOf() matches a rate: 0.01 Hz)
+ */
+inline std::vector<double> TransportRatesOf(const std::vector<ModeTraits>& modes)
+{
+  std::vector<double> rates;
+  for (const auto& mode : modes)
+  {
+    if (!IsTransportMode(mode.width, mode.height, mode.refresh, mode.interlacedOr3D))
+      continue;
+    if (std::none_of(rates.begin(), rates.end(),
+                     [&mode](double rate) { return std::abs(rate - mode.refresh) < 0.01; }))
+      rates.push_back(mode.refresh);
+  }
+  std::sort(rates.begin(), rates.end());
+  return rates;
+}
+
+//! Hades: a refresh rate as the log says it, to the thousandth of a hertz and without trailing
+//! zeros (23.976, 29.97, 59.94, 60, 119.88)
+inline std::string RateText(double rate)
+{
+  char text[32];
+  std::snprintf(text, sizeof(text), "%.3f", rate);
+  std::string s = text;
+  while (!s.empty() && s.back() == '0')
+    s.pop_back();
+  if (!s.empty() && s.back() == '.')
+    s.pop_back();
+  return s;
+}
+
+/*!
+ * \brief Hades: why the mode in use keeps native output away where the output has transport modes
+ *        at other rates only ("noratemode" of ModeReason()), in the words of the log
+ * \param rate the refresh rate of the mode in use
+ * \param offered the rates at which the output offers native output (TransportRatesOf())
+ *
+ * Told from the modes that the driver lists, whatever the driver: a mode at a rate that the
+ * transport never goes to (above 60 Hz, or 48 Hz) as that, with the rates that the output has; a
+ * transport rate at which the output has no 3840x2160 mode with the rates it has instead, and where
+ * those stop at 30 Hz, that an HDMI link of 300 MHz goes no further. (The line gave one example for
+ * every output, Intel graphics of display version 9, also on NVIDIA and AMD, and also for a mode at
+ * 120 Hz, where it is the rate of the mode and not the port that keeps native output away.)
+ */
+inline std::string NoRateModeReason(double rate, const std::vector<double>& offered)
+{
+  if (offered.empty())
+    return "the output offers no 3840x2160 mode at the " + RateText(rate) +
+           " Hz in use; Dolby Vision does not take another refresh rate than the video gets";
+  std::string list;
+  for (size_t i = 0; i < offered.size(); ++i)
+    list += (i == 0 ? "" : i + 1 == offered.size() ? " and " : ", ") + RateText(offered[i]);
+  if (!IsTransportMode(TRANSPORT_WIDTH, TRANSPORT_HEIGHT, rate, false))
+    return "the output mode in use is at " + RateText(rate) +
+           " Hz, and Dolby Vision goes out at 3840x2160 at 23.976 to 60 Hz only (this output "
+           "offers it at " +
+           list + " Hz); Dolby Vision does not take another refresh rate than the video gets";
+  const bool upTo30 = offered.back() < 30.5 && rate > 30.5;
+  return "this output offers 3840x2160 at " + list + " Hz only, not at the " + RateText(rate) +
+         " Hz in use" +
+         (upTo30 ? " (an HDMI link of 300 MHz, from an HDMI 1.4 port, cable, adapter or TV input, "
+                   "reaches 30 Hz at 3840x2160)"
+                 : "") +
+         "; Dolby Vision does not take another refresh rate than the video gets";
+}
+
 /*!
  * \brief Hades: what of the state of native Dolby Vision output keeps it from being had, before
  *        anything of the display, the output or its mode (the first reasons of
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index d3257b2..6aa32bb 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1314,7 +1314,7 @@ bool DVModeInterlacedOr3D(const drmModeModeInfo& mode)
 // 3840x2160 needs, or behind a DisplayPort dual-mode adapter of the first type; 24 to 30 Hz only on
 // an HDMI port of 300 MHz, as on Intel graphics of display version 9). The modes are the driver's,
 // which lists none that its link cannot carry.
-DVBRIDGE::TransportModes OfferedDVTransportModes(const CDRMConnector& connector, double refresh)
+std::vector<DVBRIDGE::ModeTraits> DVModesOf(const CDRMConnector& connector)
 {
   std::vector<DVBRIDGE::ModeTraits> modes;
   modes.reserve(connector.GetModesCount());
@@ -1323,7 +1323,18 @@ DVBRIDGE::TransportModes OfferedDVTransportModes(const CDRMConnector& connector,
     const auto& mode = *connector.GetModeForIndex(i);
     modes.push_back({mode.hdisplay, mode.vdisplay, ModeRate(mode), DVModeInterlacedOr3D(mode)});
   }
-  return DVBRIDGE::TransportModesOf(modes, refresh);
+  return modes;
+}
+
+DVBRIDGE::TransportModes OfferedDVTransportModes(const CDRMConnector& connector, double refresh)
+{
+  return DVBRIDGE::TransportModesOf(DVModesOf(connector), refresh);
+}
+
+// Hades: ... and the refresh rates at which they offer it (DVBRIDGE::TransportRatesOf())
+std::vector<double> OfferedDVTransportRates(const CDRMConnector& connector)
+{
+  return DVBRIDGE::TransportRatesOf(DVModesOf(connector));
 }
 
 // The refresh rate is not adjusted to the video: the output keeps the current one.
@@ -1373,6 +1384,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
   auto backend = COutputHandover::Driver::NONE;
   // (Hades: the code of the failure, where the driver said why it refused)
   std::string failedCode;
+  // (Hades: a reason made for this output and its modes, as for "noratemode")
+  std::string reasonText;
   // Hades: Dolby Vision Low-Latency, where the display offers no other and it is turned on; or the
   // HDMI 1.4b signalling, where the display asks for it and it is turned on
   const DV_DISPLAY::Signal signal = NativeDVSignal();
@@ -1523,9 +1536,12 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
       reason = "the refresh rate is not adjusted to the video, and the one set is not 23.976 to 60 "
                "Hz; turn on \"Adjust display refresh rate\" (Settings > Player > Videos)";
     else if (which == "noratemode")
-      reason = "the output offers no 3840x2160 mode at the refresh rate in use (an HDMI port of 300 "
-               "MHz, as on Intel graphics of display version 9, reaches 30 Hz at 3840x2160); Dolby "
-               "Vision does not take another refresh rate than the video gets";
+    {
+      // Hades: the rate in use and the rates at which the output has the transport, from the
+      // driver's own modes (DVBRIDGE::NoRateModeReason())
+      reasonText = DVBRIDGE::NoRateModeReason(ModeRate(*mode), OfferedDVTransportRates(*connector));
+      reason = reasonText.c_str();
+    }
     else
       reason = "the output mode is not 3840x2160 progressive at 23.976 to 60 Hz";
   }
