From e0682de950233ab2a29d85d1916eaf5206e6f7b3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:40:51 +0000
Subject: [PATCH] windowing/gbm: an interlaced mode is told with its rate in
 fields, as the kernel takes it

The notice of the playback mode and the Dolby Vision page of the player information said
the mode as its pixel clock over its total pixels: an interlaced mode such as 1080i50 read
"1920x1080 @ 25.000 Hz", where the overview page of the same player information said it
in fields ("1920x1080i @ 50.000 Hz"), as the kernel takes the rate of a mode and as such
modes are named. A double-scanned mode, or one with a vscan, was not taken as the kernel
takes it in any of the three.

KODI::UTILS::ModeRefresh() takes the rate as drm_mode_vrefresh() of Linux 7.3 does (twice
for an interlaced mode, half for a double-scanned one, divided by a vscan above 1), and
ModeText() says the mode with an "i" for an interlaced one. hades.out.mode (and the rate
that the fit of the display rate is decided against), hades.dv.mode and the notice of the
playback mode take them, so the three say the same.

Host test: TestPlaybackMode (in the tree), run with the minimal googletest of the host
tests: 1080i50 and 1080i59.94 in fields with their "i", 2160p23.976, double scan and vscan,
a mode without a timing. Three mutants are killed: the rate of an interlaced mode in frames
(the bug), double scan and vscan left out, and the "i" left out.
---
 xbmc/utils/PlaybackMode.h                     | 44 +++++++++++++++++++
 xbmc/utils/test/TestPlaybackMode.cpp          | 18 ++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 34 ++++++++------
 3 files changed, 83 insertions(+), 13 deletions(-)

diff --git a/xbmc/utils/PlaybackMode.h b/xbmc/utils/PlaybackMode.h
index 08fcb6d..d84481b 100644
--- a/xbmc/utils/PlaybackMode.h
+++ b/xbmc/utils/PlaybackMode.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include <cstdint>
+#include <cstdio>
 #include <string>
 
 namespace KODI::UTILS
@@ -40,6 +41,49 @@ inline std::string PlaybackModeFormatName(const std::string& kind)
   return {};
 }
 
+/*!
+ * \brief The refresh rate of a display mode as the kernel takes it (drm_mode_vrefresh(), Linux
+ *        7.3): its pixel clock over its total pixels, twice that for an interlaced mode (a rate in
+ *        fields, as 1080i50 is named), half of it for a double-scanned one, and divided by its
+ *        vscan where that is above 1; 0 for a mode without a timing
+ * \param clockKHz the pixel clock in kHz, as drmModeModeInfo::clock
+ */
+inline double ModeRefresh(uint32_t clockKHz,
+                          uint32_t htotal,
+                          uint32_t vtotal,
+                          bool interlaced,
+                          bool doubleScan,
+                          uint32_t vscan)
+{
+  if (!htotal || !vtotal)
+    return 0.0;
+  const double fields = interlaced ? 2.0 : 1.0;
+  const double scans = (doubleScan ? 2.0 : 1.0) * (vscan > 1 ? vscan : 1);
+  return clockKHz * 1000.0 * fields / (static_cast<double>(htotal) * vtotal * scans);
+}
+
+/*!
+ * \brief A display mode as the player information and the notice of the playback mode say it:
+ *        "3840x2160 @ 23.976 Hz", and an interlaced mode with an "i" and its rate in fields
+ *        ("1920x1080i @ 50.000 Hz"); empty for a mode without a timing
+ */
+inline std::string ModeText(uint32_t width,
+                            uint32_t height,
+                            uint32_t clockKHz,
+                            uint32_t htotal,
+                            uint32_t vtotal,
+                            bool interlaced,
+                            bool doubleScan,
+                            uint32_t vscan)
+{
+  const double hz = ModeRefresh(clockKHz, htotal, vtotal, interlaced, doubleScan, vscan);
+  if (!(hz > 0.0))
+    return {};
+  char text[64];
+  std::snprintf(text, sizeof(text), "%ux%u%s @ %.3f Hz", width, height, interlaced ? "i" : "", hz);
+  return text;
+}
+
 //! \brief One line that says in which mode the video plays: "Dolby Vision · FEL · 3840x2160 @
 //!        23.976 Hz"; "Dolby Vision → HDR10" where a Dolby Vision video is sent as HDR10. Empty
 //!        while the output is not known.
diff --git a/xbmc/utils/test/TestPlaybackMode.cpp b/xbmc/utils/test/TestPlaybackMode.cpp
index d9cbf39..59b191b 100644
--- a/xbmc/utils/test/TestPlaybackMode.cpp
+++ b/xbmc/utils/test/TestPlaybackMode.cpp
@@ -32,6 +32,24 @@ TEST(TestPlaybackMode, Describe)
   EXPECT_EQ("HLG", DescribePlaybackMode({"", "hlg", "", ""}));
 }
 
+TEST(TestPlaybackMode, ModeText)
+{
+  // 3840x2160 at 23.976 Hz (CTA-861 VIC 93 at 1000/1001)
+  EXPECT_EQ("3840x2160 @ 23.976 Hz", ModeText(3840, 2160, 296703, 5500, 2250, false, false, 0));
+  // interlaced: the rate in fields, as 1080i50 and 1080i59.94 are named (VIC 20, VIC 5 at 1000/1001)
+  EXPECT_EQ("1920x1080i @ 50.000 Hz", ModeText(1920, 1080, 74250, 2640, 1125, true, false, 0));
+  EXPECT_EQ("1920x1080i @ 59.940 Hz", ModeText(1920, 1080, 74176, 2200, 1125, true, false, 0));
+  EXPECT_EQ(50.0, ModeRefresh(74250, 2640, 1125, true, false, 0));
+  // double scan and vscan: fewer frames than lines drawn
+  EXPECT_EQ("720x240 @ 30.000 Hz", ModeText(720, 240, 27000, 900, 500, false, true, 0));
+  EXPECT_EQ(30.0, ModeRefresh(27000, 900, 500, false, true, 0));
+  EXPECT_EQ(30.0, ModeRefresh(27000, 900, 500, false, false, 2));
+  EXPECT_EQ(15.0, ModeRefresh(27000, 900, 500, false, true, 2));
+  // no timing: nothing
+  EXPECT_EQ("", ModeText(1920, 1080, 148500, 0, 1125, false, false, 0));
+  EXPECT_EQ("", ModeText(1920, 1080, 148500, 2200, 0, false, false, 0));
+}
+
 TEST(TestPlaybackMode, TellsOnceAfterTheOutputSettles)
 {
   CPlaybackModeAnnouncer announcer;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 8ada6ec..afe8d1b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7605,6 +7605,23 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
   }
 }
 
+// Hades: the mode that is set, as the player information and the notice of the playback mode say
+// it, and its refresh rate, both as the kernel takes it (an interlaced mode in fields:
+// KODI::UTILS::ModeText(), ModeRefresh())
+std::string ModeTextOf(const drmModeModeInfo& mode)
+{
+  return KODI::UTILS::ModeText(mode.hdisplay, mode.vdisplay, mode.clock, mode.htotal, mode.vtotal,
+                               (mode.flags & DRM_MODE_FLAG_INTERLACE) != 0,
+                               (mode.flags & DRM_MODE_FLAG_DBLSCAN) != 0, mode.vscan);
+}
+
+double ModeRefreshOf(const drmModeModeInfo& mode)
+{
+  return KODI::UTILS::ModeRefresh(mode.clock, mode.htotal, mode.vtotal,
+                                  (mode.flags & DRM_MODE_FLAG_INTERLACE) != 0,
+                                  (mode.flags & DRM_MODE_FLAG_DBLSCAN) != 0, mode.vscan);
+}
+
 // Hades: the values of the player information that are lit when they change (the Dolby Vision
 // metadata, the output, the colour of the picture, the audio format): not the counters that move
 // with every beat (the last 10 s, the GPU, the memory, the bit rates), which would be lit for ever
@@ -7950,9 +7967,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
   {
     if (const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
         mode && mode->htotal && mode->vtotal)
-      info["hades.dv.mode"] = StringUtils::Format(
-          "{}x{} @ {:.3f} Hz", mode->hdisplay, mode->vdisplay,
-          mode->clock * 1000.0 / (static_cast<double>(mode->htotal) * mode->vtotal));
+      info["hades.dv.mode"] = ModeTextOf(*mode);
     if (native && m_dvLastWindow.valid)
     {
       info["hades.dv.shown"] = std::to_string(m_dvLastWindow.shown);
@@ -8031,9 +8046,7 @@ void CWinSystemGbmGLESContext::AnnouncePlaybackMode(const std::map<std::string,
   mode.layers = value("hades.dv.layers");
   if (const auto* selected = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
       selected && selected->htotal && selected->vtotal)
-    mode.mode = StringUtils::Format("{}x{} @ {:.3f} Hz", selected->hdisplay, selected->vdisplay,
-                                    selected->clock * 1000.0 /
-                                        (static_cast<double>(selected->htotal) * selected->vtotal));
+    mode.mode = ModeTextOf(*selected);
   const std::string text = m_modeAnnouncer.Update(
       CTimeUtils::GetFrameTime(), playing, m_playbackStarts.load(std::memory_order_relaxed), mode);
   if (text.empty() || !on)
@@ -9839,13 +9852,8 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     {
       // as the kernel takes the refresh rate of a mode (drm_mode_vrefresh()): in fields for an
       // interlaced one
-      const bool interlaced = (mode->flags & DRM_MODE_FLAG_INTERLACE) != 0;
-      const double refresh = mode->clock * 1000.0 /
-                             (static_cast<double>(mode->htotal) * mode->vtotal) *
-                             (interlaced ? 2 : 1);
-      info["hades.out.mode"] = StringUtils::Format("{}x{}{} @ {:.3f} Hz", mode->hdisplay,
-                                                   mode->vdisplay, interlaced ? "i" : "", refresh);
-      modeHz = refresh;
+      info["hades.out.mode"] = ModeTextOf(*mode);
+      modeHz = ModeRefreshOf(*mode);
     }
     if (connector && fd >= 0)
     {
