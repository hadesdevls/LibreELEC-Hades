new file mode 100644
index 0000000..9e62d01
--- /dev/null
+++ b/tools/dvbridge/dvbridge_hdr10plus.c
@@ -0,0 +1,389 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Hades: see dvbridge_hdr10plus.h. */
+#include "dvbridge_hdr10plus.h"
+
+#include "dvbridge_mel.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <libavutil/mem.h>
+#include <libavutil/rational.h>
+
+/* SMPTE ST 2084, on light in [0, 1] of 10000 cd/m2 */
+#define PQ_M1 (2610.0 / 16384.0)
+#define PQ_M2 (2523.0 / 4096.0 * 128.0)
+#define PQ_C1 (3424.0 / 4096.0)
+#define PQ_C2 (2413.0 / 4096.0 * 32.0)
+#define PQ_C3 (2392.0 / 4096.0 * 32.0)
+
+static double pq_from_linear(double y)
+{
+    y = y < 0 ? 0 : y > 1 ? 1 : y;
+    const double p = pow(y, PQ_M1);
+    return pow((PQ_C1 + PQ_C2 * p) / (1 + PQ_C3 * p), PQ_M2);
+}
+
+static double linear_from_pq(double e)
+{
+    e = e < 0 ? 0 : e > 1 ? 1 : e;
+    const double p = pow(e, 1 / PQ_M2);
+    const double n = p - PQ_C1;
+    return n <= 0 ? 0 : pow(n / (PQ_C2 - PQ_C3 * p), 1 / PQ_M1);
+}
+
+static unsigned code12(double e)
+{
+    const double c = floor(e * 4095 + 0.5);
+    return c < 0 ? 0 : c > 4095 ? 4095 : (unsigned)c;
+}
+
+/* (a value of ST 2094-40 in [0, 1], in multiples of 0.00001) */
+static bool value(AVRational q, double *v)
+{
+    if (q.den <= 0 || q.num < 0)
+        return false;
+    *v = av_q2d(q);
+    return *v <= 1.0;
+}
+
+/* The points of t over a segment of the quantile function: 91 to 0.9, then 400 nearer to 1 by powers, then 1
+ * (the high end is where t^k with a large k does all its rising). */
+#define GRID_POINTS 492
+static void make_grid(double t[GRID_POINTS])
+{
+    int n = 0;
+    for (int i = 0; i <= 90; ++i)
+        t[n++] = 0.9 * i / 90;
+    for (int i = 0; i < 400; ++i)
+        t[n++] = 1 - 0.1 * pow(1e-6, i / 399.0);
+    t[n++] = 1;
+}
+
+/* the mean of PQ and of light over a segment of p of width w, where e(t) = e0 + (e1 - e0) t^k */
+static void segment(const double *t, double e0, double e1, double k, double w, double *pq, double *light)
+{
+    double sp = 0, sl = 0, ep = e0, lp = linear_from_pq(e0);
+    for (int i = 1; i < GRID_POINTS; ++i) {
+        const double e = e0 + (e1 - e0) * (k == 1 ? t[i] : pow(t[i], k));
+        const double l = linear_from_pq(e);
+        const double dt = t[i] - t[i - 1];
+        sp += (e + ep) / 2 * dt;
+        sl += (l + lp) / 2 * dt;
+        ep = e;
+        lp = l;
+    }
+    *pq += sp * w;
+    *light += sl * w;
+}
+
+#define MAX_KNOTS 17
+
+bool dvbridge_hdr10plus_level1(const AVDynamicHDRPlus *m, struct dvbridge_hdr10plus_l1 *l1)
+{
+    if (!m || !l1 || m->num_windows < 1)
+        return false;
+    memset(l1, 0, sizeof(*l1));
+    const AVHDRPlusColorTransformParams *w = &m->params[0];
+    double peak = 0, average;
+    for (int c = 0; c < 3; ++c) {
+        double v;
+        if (!value(w->maxscl[c], &v))
+            return false;
+        if (v > peak)
+            peak = v;
+    }
+    if (!value(w->average_maxrgb, &average))
+        return false;
+    const unsigned n = w->num_distribution_maxrgb_percentiles;
+    if (n < 1 || n > 15)
+        return false;
+    /* ST 2094-40 8.5.4: with ApplicationVersion 1, the entries at 5 and 10 are not part of the distribution (0 and
+     * 0.00255); an encoder that writes version 0 with those two values exactly is taken the same way */
+    double v1 = -1, v2 = -1;
+    if (n >= 3) {
+        value(w->distribution_maxrgb[1].percentile, &v1);
+        value(w->distribution_maxrgb[2].percentile, &v2);
+    }
+    const bool reserved = n >= 3 && w->distribution_maxrgb[1].percentage == 5 &&
+                          w->distribution_maxrgb[2].percentage == 10 &&
+                          (m->application_version >= 1 || (v1 == 0 && fabs(v2 - 0.00255) < 1e-9));
+    double ps[MAX_KNOTS], vs[MAX_KNOTS];
+    unsigned k = 0, last_percentage = 0;
+    ps[k] = 0;
+    vs[k++] = 0; /* (set to the first percentile below) */
+    for (unsigned i = 0; i < n; ++i) {
+        const unsigned j = w->distribution_maxrgb[i].percentage;
+        double v;
+        if (j > 100 || (i && j <= last_percentage) || !value(w->distribution_maxrgb[i].percentile, &v))
+            return false;
+        last_percentage = j;
+        if (reserved && (i == 1 || i == 2))
+            continue;
+        if (k > 1 && v < vs[k - 1])
+            return false; /* percentiles that go down describe no distribution */
+        ps[k] = j == 99 ? 0.9998 : j / 100.0;
+        vs[k++] = v;
+    }
+    if (k < 3)
+        return false;
+    vs[0] = vs[1];
+    ps[k] = 1;
+    vs[k] = peak > vs[k - 1] ? peak : vs[k - 1];
+    ++k;
+    l1->knots = k - 2;
+
+    double t[GRID_POINTS], es[MAX_KNOTS];
+    make_grid(t);
+    for (unsigned i = 0; i < k; ++i)
+        es[i] = pq_from_linear(vs[i]);
+    /* the segments below the top two, linear in PQ */
+    double fixed_pq = 0, fixed_light = 0;
+    for (unsigned i = 0; i + 3 < k; ++i)
+        if (ps[i + 1] > ps[i])
+            segment(t, es[i], es[i + 1], 1, ps[i + 1] - ps[i], &fixed_pq, &fixed_light);
+    /* the top two, shaped as t^k (k > 1 lowers them, k < 1 raises them), k found by halving its logarithm */
+    double top_pq, top_light, lo = 1.0 / 64, hi = 65536.0, chosen;
+#define TOP(kk)                                                                                       \
+    do {                                                                                              \
+        top_pq = fixed_pq;                                                                            \
+        top_light = fixed_light;                                                                      \
+        for (unsigned i = k - 3; i + 1 < k; ++i)                                                      \
+            if (ps[i + 1] > ps[i])                                                                    \
+                segment(t, es[i], es[i + 1], (kk), ps[i + 1] - ps[i], &top_pq, &top_light);           \
+    } while (0)
+    TOP(lo);
+    if (top_light <= average)
+        chosen = lo;
+    else {
+        TOP(hi);
+        if (top_light >= average)
+            chosen = hi;
+        else {
+            for (int i = 0; i < 40; ++i) {
+                const double mid = sqrt(lo * hi);
+                TOP(mid);
+                if (top_light > average)
+                    lo = mid;
+                else
+                    hi = mid;
+            }
+            chosen = sqrt(lo * hi);
+        }
+    }
+    TOP(chosen);
+#undef TOP
+    l1->max_measured = code12(pq_from_linear(peak));
+    l1->avg_measured = code12(top_pq);
+    /* as dovi_tool clamps a level 1 block for CM v2.9 (ExtMetadataBlockLevel1::clamp_values_int()) */
+    l1->min_pq = 0;
+    l1->max_pq = l1->max_measured < 2081 ? 2081 : l1->max_measured;
+    l1->avg_pq = l1->avg_measured < 819 ? 819 : l1->avg_measured;
+    if (l1->avg_pq > l1->max_pq - 1)
+        l1->avg_pq = l1->max_pq - 1;
+    return true;
+}
+
+static bool same_q(AVRational a, AVRational b)
+{
+    return av_cmp_q(a, b) == 0 || (a.num == 0 && b.num == 0);
+}
+
+bool dvbridge_hdr10plus_same_scene(const AVDynamicHDRPlus *a, const AVDynamicHDRPlus *b)
+{
+    if (!a || !b || a->num_windows != b->num_windows ||
+        !same_q(a->targeted_system_display_maximum_luminance, b->targeted_system_display_maximum_luminance))
+        return false;
+    const int windows = a->num_windows < 1 ? 1 : a->num_windows > 3 ? 3 : a->num_windows;
+    for (int i = 0; i < windows; ++i) {
+        const AVHDRPlusColorTransformParams *p = &a->params[i], *q = &b->params[i];
+        for (int c = 0; c < 3; ++c)
+            if (!same_q(p->maxscl[c], q->maxscl[c]))
+                return false;
+        if (!same_q(p->average_maxrgb, q->average_maxrgb) ||
+            p->num_distribution_maxrgb_percentiles != q->num_distribution_maxrgb_percentiles)
+            return false;
+        for (int j = 0; j < p->num_distribution_maxrgb_percentiles && j < 15; ++j)
+            if (p->distribution_maxrgb[j].percentage != q->distribution_maxrgb[j].percentage ||
+                !same_q(p->distribution_maxrgb[j].percentile, q->distribution_maxrgb[j].percentile))
+                return false;
+        /* (hdr10plus_tool: the curve where it is carried, its profile B) */
+        if (p->tone_mapping_flag != q->tone_mapping_flag)
+            return false;
+        if (p->tone_mapping_flag) {
+            if (!same_q(p->knee_point_x, q->knee_point_x) || !same_q(p->knee_point_y, q->knee_point_y) ||
+                p->num_bezier_curve_anchors != q->num_bezier_curve_anchors)
+                return false;
+            for (int j = 0; j < p->num_bezier_curve_anchors && j < 15; ++j)
+                if (!same_q(p->bezier_curve_anchors[j], q->bezier_curve_anchors[j]))
+                    return false;
+        }
+    }
+    return true;
+}
+
+AVDOVIMetadata *dvbridge_hdr10plus_metadata(const struct dvbridge_hdr10plus_l1 *l1,
+                                            const AVMasteringDisplayMetadata *mastering,
+                                            const AVContentLightMetadata *light, bool scene_refresh,
+                                            size_t *size)
+{
+    if (!l1 || !mastering || !mastering->has_luminance || !size || mastering->max_luminance.den <= 0 ||
+        mastering->min_luminance.den <= 0)
+        return NULL;
+    const double max_nits = av_q2d(mastering->max_luminance), min_nits = av_q2d(mastering->min_luminance);
+    if (!(max_nits > 0 && max_nits <= 10000 && min_nits >= 0 && min_nits < max_nits))
+        return NULL;
+    AVDOVIMetadata *m = av_dovi_metadata_alloc(size);
+    if (!m)
+        return NULL;
+
+    /* profile 8.1 as dovi_tool makes it (dovi_rpu.rs, profiles/profile81.rs, rpu_data_header.rs) */
+    AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
+    h->rpu_type = 2;
+    h->rpu_format = 18;
+    h->vdr_rpu_profile = 1;
+    h->vdr_rpu_level = 0;
+    h->coef_data_type = 0;
+    h->coef_log2_denom = 23;
+    h->vdr_rpu_normalized_idc = 1;
+    h->bl_video_full_range_flag = 0;
+    h->bl_bit_depth = 10;
+    h->el_bit_depth = 10;
+    h->vdr_bit_depth = 12;
+    h->spatial_resampling_filter_flag = 0;
+    h->el_spatial_resampling_filter_flag = 0;
+    h->disable_residual_flag = 1;
+
+    /* the identity mapping: one piece over the base layer's codes, x^1 (rpu_data_mapping.rs) */
+    AVDOVIDataMapping *map = av_dovi_get_mapping(m);
+    map->vdr_rpu_id = 0;
+    map->mapping_color_space = 0;
+    map->mapping_chroma_format_idc = 0;
+    for (int c = 0; c < 3; ++c) {
+        AVDOVIReshapingCurve *curve = &map->curves[c];
+        curve->num_pivots = 2;
+        curve->pivots[0] = 0;
+        curve->pivots[1] = 1023;
+        curve->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+        curve->poly_order[0] = 1;
+        curve->poly_coef[0][0] = 0;
+        curve->poly_coef[0][1] = 1 << 23;
+        curve->poly_coef[0][2] = 0;
+    }
+    map->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    map->num_x_partitions = 1;
+    map->num_y_partitions = 1;
+
+    /* BT.2020 PQ (vdr_dm_data.rs) */
+    AVDOVIColorMetadata *col = av_dovi_get_color(m);
+    static const int ycc[9] = {9574, 0, 13802, 9574, -1540, -5348, 9574, 17610, 0};
+    static const int lms[9] = {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962};
+    for (int i = 0; i < 9; ++i) {
+        col->ycc_to_rgb_matrix[i] = (AVRational){ycc[i], 8192};
+        col->rgb_to_lms_matrix[i] = (AVRational){lms[i], 16384};
+    }
+    col->ycc_to_rgb_offset[0] = (AVRational){16777216, 1 << 28};
+    col->ycc_to_rgb_offset[1] = (AVRational){134217728, 1 << 28};
+    col->ycc_to_rgb_offset[2] = (AVRational){134217728, 1 << 28};
+    col->dm_metadata_id = 0;
+    col->scene_refresh_flag = scene_refresh;
+    col->signal_eotf = 65535;
+    col->signal_bit_depth = 12;
+    col->signal_color_space = 0;
+    col->signal_chroma_format = 0;
+    col->signal_full_range_flag = 1;
+    /* the mastering display, as PQ codes (dovi_tool's table, Level6::source_meta_from_l6(), is these codes for
+     * 1000, 2000, 4000 and 10000 cd/m2 and 0.005; a minimum of at most 0.001 is 7 there) */
+    col->source_min_pq = min_nits <= 0.001 ? 7 : code12(pq_from_linear(min_nits / 10000));
+    col->source_max_pq = code12(pq_from_linear(max_nits / 10000));
+    col->source_diagonal = 42;
+
+    m->num_ext_blocks = 0;
+    AVDOVIDmData *e = av_dovi_get_ext(m, m->num_ext_blocks++);
+    e->level = 1;
+    e->l1.min_pq = l1->min_pq;
+    e->l1.max_pq = l1->max_pq;
+    e->l1.avg_pq = l1->avg_pq;
+    e = av_dovi_get_ext(m, m->num_ext_blocks++);
+    e->level = 6;
+    e->l6.max_luminance = (uint16_t)floor(max_nits + 0.5);
+    e->l6.min_luminance = (uint16_t)floor(min_nits * 10000 + 0.5);
+    e->l6.max_cll = light ? (uint16_t)(light->MaxCLL > 65535 ? 65535 : light->MaxCLL) : 0;
+    e->l6.max_fall = light ? (uint16_t)(light->MaxFALL > 65535 ? 65535 : light->MaxFALL) : 0;
+    return m;
+}
+
+struct dvbridge_hdr10plus_scene {
+    AVDynamicHDRPlus from; /* the HDR10+ metadata that the metadata were made of last */
+    AVDOVIMetadata *first; /* those metadata, with a scene refresh: what the first picture of the scene gets */
+    AVDOVIMetadata *made;  /* ... and without one: what the next pictures get */
+    size_t size;
+};
+
+struct dvbridge_hdr10plus_scene *dvbridge_hdr10plus_scene_create(void)
+{
+    return av_mallocz(sizeof(struct dvbridge_hdr10plus_scene));
+}
+
+void dvbridge_hdr10plus_scene_reset(struct dvbridge_hdr10plus_scene *s)
+{
+    if (!s)
+        return;
+    av_freep(&s->first);
+    av_freep(&s->made);
+    memset(s, 0, sizeof(*s));
+}
+
+void dvbridge_hdr10plus_scene_destroy(struct dvbridge_hdr10plus_scene *s)
+{
+    dvbridge_hdr10plus_scene_reset(s);
+    av_free(s);
+}
+
+const AVDOVIMetadata *dvbridge_hdr10plus_next(struct dvbridge_hdr10plus_scene *s,
+                                              const AVDynamicHDRPlus *hdr10plus,
+                                              const AVMasteringDisplayMetadata *mastering,
+                                              const AVContentLightMetadata *light, size_t *size,
+                                              bool *repeated)
+{
+    if (!s || !size || !repeated)
+        return NULL;
+    *repeated = false;
+    if (hdr10plus && mastering && mastering->has_luminance) {
+        if (s->made && dvbridge_hdr10plus_same_scene(&s->from, hdr10plus)) {
+            *size = s->size;
+            return s->made;
+        }
+        struct dvbridge_hdr10plus_l1 l1;
+        size_t bytes = 0;
+        AVDOVIMetadata *first = dvbridge_hdr10plus_level1(hdr10plus, &l1)
+                                    ? dvbridge_hdr10plus_metadata(&l1, mastering, light, true, &bytes)
+                                    : NULL;
+        AVDOVIMetadata *made = first ? av_malloc(bytes) : NULL;
+        if (made) {
+            memcpy(made, first, bytes);
+            av_dovi_get_color(made)->scene_refresh_flag = 0;
+            av_free(s->first);
+            av_free(s->made);
+            s->first = first;
+            s->made = made;
+            s->size = bytes;
+            s->from = *hdr10plus;
+            *size = bytes;
+            return s->first;
+        }
+        av_free(first);
+    }
+    if (!s->made)
+        return NULL;
+    *repeated = true;
+    *size = s->size;
+    return s->made;
+}
+
+void dvbridge_hdr10plus_units(const uint8_t *data, size_t size, int length_size,
+                              bool (*found)(const uint8_t *unit, size_t size, void *context), void *context)
+{
+    if (data && size && found && length_size >= 0 && length_size <= 4)
+        dvbridge_rpu_units(data, size, length_size, found, context);
+}
diff --git a/tools/dvbridge/dvbridge_hdr10plus.h b/tools/dvbridge/dvbridge_hdr10plus.h
new file mode 100644
index 0000000..b279792
--- /dev/null
+++ b/tools/dvbridge/dvbridge_hdr10plus.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef DVBRIDGE_HDR10PLUS_H
+#define DVBRIDGE_HDR10PLUS_H
+/* Hades: Dolby Vision metadata made from the HDR10+ metadata of a picture (SMPTE ST 2094-40:2020), for a display
+ * that takes Dolby Vision and not HDR10+. What is made is what an RPU of profile 8.1 says of a picture that is
+ * the HDR10 picture itself: an identity mapping (the picture is not changed), the colour of BT.2020 PQ, the
+ * mastering display as the source range, and a level 1 block with the range of the scene that the HDR10+
+ * statistics describe. Nothing is invented: the level 1 block is a translation of what the studio's HDR10+
+ * metadata measures, and what HDR10+ has no counterpart for is left out (see dvbridge_hdr10plus_level1()).
+ * The rule for the level 1 block from HDR10+ statistics, and the profile 8.1 defaults, follow dovi_tool's
+ * generator (MIT, read as data); the average is made otherwise, measured (see below). */
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libavutil/dovi_meta.h>
