From dec10f8aefc07cb0c2571a110acc8f3d6a080d24 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:04:51 +0100
Subject: [PATCH] [VideoLibraryQueue] Keep a cancelled scan's queue slot until
 it ends

Cancelling a running scan removed it from the queue and the list of
library jobs at once, while the scanner went on until it next checked
for the cancellation - possibly in the middle of a scraper call or a
database write. Another scan, clean or refresh could then start and
write alongside it, and IsScanningLibrary() reported no scan. Treat a
running scan as a running source refresh already is: it releases the
slot when it ends.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 981e6207a7f598c1ea21d3f99d36fc73b4acbfd8)
---
 xbmc/video/VideoLibraryQueue.cpp            | 10 ++++++----
 xbmc/video/jobs/VideoLibraryScanningJob.cpp |  5 ++++-
 xbmc/video/jobs/VideoLibraryScanningJob.h   |  3 +++
 xbmc/video/test/TestVideoInfoScanner.cpp    | 12 ++++++++++++
 4 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/xbmc/video/VideoLibraryQueue.cpp b/xbmc/video/VideoLibraryQueue.cpp
index 4f470ad..ecc47b3 100644
--- a/xbmc/video/VideoLibraryQueue.cpp
+++ b/xbmc/video/VideoLibraryQueue.cpp
@@ -244,10 +244,12 @@ void CVideoLibraryQueue::CancelJob(CVideoLibraryJob *job)
   if (job->CanBeCancelled())
     job->Cancel();
 
-  // A running source refresh finishes its current item before releasing the queue slot. One that
-  // hasn't started is removed now, as it returns at once if it starts after Cancel().
-  if (jobType == CVideoLibraryRefreshingSourceJob::TYPE &&
-      static_cast<CVideoLibraryRefreshingSourceJob*>(job)->HasStarted())
+  // A running scan or source refresh finishes its current item before releasing the queue slot.
+  // One that hasn't started is removed now, as it returns at once if it starts after Cancel().
+  if ((jobType == CVideoLibraryRefreshingSourceJob::TYPE &&
+       static_cast<CVideoLibraryRefreshingSourceJob*>(job)->HasStarted()) ||
+      (jobType == "VideoLibraryScanningJob" &&
+       static_cast<CVideoLibraryScanningJob*>(job)->HasStarted()))
     return;
 
   // remove the job from the job queue
diff --git a/xbmc/video/jobs/VideoLibraryScanningJob.cpp b/xbmc/video/jobs/VideoLibraryScanningJob.cpp
index 5ac87c7..2a94609 100644
--- a/xbmc/video/jobs/VideoLibraryScanningJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryScanningJob.cpp
@@ -28,7 +28,9 @@ bool CVideoLibraryScanningJob::Cancel()
 
 bool CVideoLibraryScanningJob::Equals(const CJob* job) const
 {
-  if (strcmp(job->GetType(), GetType()) != 0)
+  // A cancelled scan keeps its queue slot until it ends, so the same scan asked for again queues
+  // behind it rather than being dropped as a duplicate
+  if (m_cancelled || strcmp(job->GetType(), GetType()) != 0)
     return false;
 
   const CVideoLibraryScanningJob* scanningJob = dynamic_cast<const CVideoLibraryScanningJob*>(job);
@@ -41,6 +43,7 @@ bool CVideoLibraryScanningJob::Equals(const CJob* job) const
 
 bool CVideoLibraryScanningJob::Work(CVideoDatabase &db)
 {
+  m_started = true;
   if (m_cancelled)
     return true;
 
diff --git a/xbmc/video/jobs/VideoLibraryScanningJob.h b/xbmc/video/jobs/VideoLibraryScanningJob.h
index 37e67ad..79a0195 100644
--- a/xbmc/video/jobs/VideoLibraryScanningJob.h
+++ b/xbmc/video/jobs/VideoLibraryScanningJob.h
@@ -33,6 +33,8 @@ public:
   CVideoLibraryScanningJob(const std::string& directory, bool scanAll = false, bool showProgress = true);
   ~CVideoLibraryScanningJob() override;
 
+  bool HasStarted() const { return m_started; }
+
   // specialization of CVideoLibraryJob
   bool CanBeCancelled() const override { return true; }
   bool Cancel() override;
@@ -48,6 +50,7 @@ protected:
 private:
   KODI::VIDEO::CVideoInfoScanner m_scanner;
   std::atomic<bool> m_cancelled{false};
+  std::atomic<bool> m_started{false};
   std::string m_directory;
   bool m_showProgress;
   bool m_scanAll;
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index e92400b..2a65429 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -25,6 +25,7 @@
 #include "video/VideoDatabase.h"
 #include "video/VideoInfoScanner.h"
 #include "video/VideoManagerTypes.h"
+#include "video/jobs/VideoLibraryScanningJob.h"
 
 #include <chrono>
 #include <filesystem>
@@ -355,6 +356,17 @@ protected:
 };
 } // namespace
 
+TEST_F(TestVideoInfoScanner, ACancelledScanDoesNotHideTheSameScanAskedForAgain)
+{
+  CVideoLibraryScanningJob cancelled{m_root};
+  const CVideoLibraryScanningJob again{m_root};
+  ASSERT_TRUE(cancelled.Equals(&again));
+
+  cancelled.Cancel();
+
+  EXPECT_FALSE(cancelled.Equals(&again));
+}
+
 // Movies
 
 TEST_F(TestVideoInfoScanner, AMovieIsAddedFromItsNfo)
