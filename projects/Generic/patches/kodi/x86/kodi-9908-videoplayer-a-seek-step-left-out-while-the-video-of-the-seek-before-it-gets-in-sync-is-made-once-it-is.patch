diff --git a/xbmc/cores/VideoPlayer/SeekLeftOut.h b/xbmc/cores/VideoPlayer/SeekLeftOut.h
new file mode 100644
index 0000000..6fa7083
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/SeekLeftOut.h
@@ -0,0 +1,73 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <utility>
+
+/*!
+ * \brief Hades: the last seek step that the player left out because the video of the seek before
+ *        it was not in sync yet, made once it is
+ *
+ * Kodi leaves out an inaccurate seek (a step forward or back, a big step, a percentage) that comes
+ * within 2 s of the seek before it while the video of that seek is not in sync yet
+ * (CVideoPlayer::HandleMessages()): a second "-1 minute" pressed while the first one was still
+ * getting its picture did nothing at all. The last such step is kept here, with its target as the
+ * player reports its time and the ticket of its message (CSeekPending: meanwhile the time reported
+ * is its target, and a step asked for after it goes from there), and it is made once the video is
+ * in sync. It is thrown away if anything else comes first: another seek, a seek to a chapter, a
+ * pause or another speed, a flush of the streams, another file, the player stopping, or the video
+ * not getting in sync within MAX_WAIT_MS of it. One step at most, made once at most. The player's
+ * thread only.
+ */
+class CSeekLeftOut
+{
+public:
+  //! How long a step waits for the video to get in sync, in ms
+  static constexpr double MAX_WAIT_MS = 5000;
+
+  struct Step
+  {
+    double targetMs = 0; //!< where it goes, as the player reports its time
+    bool backward = false;
+    bool restore = true;
+    int64_t offsetMs = 0; //!< the offset that its asker announced
+    double keptAtMs = 0; //!< when it was left out, by the player's absolute clock
+    std::shared_ptr<void> ticket; //!< of its message (CSeekPending)
+  };
+
+  enum class Due
+  {
+    NOTHING, //!< no step, or it waits
+    MAKE, //!< the video is in sync: the step is made now
+    TOO_LATE //!< it waited MAX_WAIT_MS: thrown away
+  };
+
+  //! A step left out, kept in place of any kept before it (whose ticket goes)
+  void Keep(Step step) { m_step = std::move(step); }
+  bool Kept() const { return m_step.has_value(); }
+  //! The step kept, taken away (none if there is none)
+  std::optional<Step> Take() { return std::exchange(m_step, std::nullopt); }
+  //! What becomes of the step kept, with the video in sync or not, at nowMs (absolute clock)
+  Due Check(bool videoInSync, double nowMs) const
+  {
+    if (!m_step)
+      return Due::NOTHING;
+    if (videoInSync)
+      return Due::MAKE;
+    if (nowMs - m_step->keptAtMs >= MAX_WAIT_MS)
+      return Due::TOO_LATE;
+    return Due::NOTHING;
+  }
+
+private:
+  std::optional<Step> m_step;
+};
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 52c9faa..5877aff 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3396,6 +3396,76 @@ void CVideoPlayer::SynchronizeDemuxer()
   message->Wait(m_bStop, 0);
 }
 
+void CVideoPlayer::KeepSeekLeftOut(CDVDMsgPlayerSeek& msg, double targetMs, double nowMs)
+{
+  // (trick play asks for its next step by itself)
+  if (msg.GetTrickPlay())
+    return;
+  CSeekLeftOut::Step step;
+  step.targetMs = targetMs;
+  step.backward = msg.GetBackward();
+  step.restore = msg.GetRestore();
+  step.offsetMs = msg.GetOffset();
+  step.keptAtMs = nowMs / 1000;
+  // (the seek stays on its way meanwhile: the time reported is its target, CSeekPending)
+  step.ticket = msg.TakePending();
+  m_seekLeftOut.Keep(std::move(step));
+}
+
+void CVideoPlayer::DropSeekLeftOut(const char* why)
+{
+  if (const auto step = m_seekLeftOut.Take())
+    CLog::Log(LOGINFO,
+              "Seek: the step to {}, left out while the video of the seek before it was not in "
+              "sync, is not made: {}",
+              CSeekTrace::Time(step->targetMs), why);
+}
+
+void CVideoPlayer::ApplySeekLeftOut()
+{
+  if (!m_seekLeftOut.Kept())
+    return;
+  // (one asked for after it goes from its target, CSeekPending, and must not be put before it; nor
+  // the seek of a bookmark, whose state, PLAYER_SET_STATE, comes first and is for its seek only)
+  if (m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK) > 0 ||
+      m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK_CHAPTER) > 0 ||
+      m_messenger.GetPacketCount(CDVDMsg::PLAYER_SET_STATE) > 0)
+  {
+    DropSeekLeftOut("another seek came after it");
+    return;
+  }
+  const double nowMs = m_clock.GetAbsoluteClock() / 1000;
+  switch (m_seekLeftOut.Check(
+      m_CurrentVideo.id < 0 || m_CurrentVideo.syncState == IDVDStreamPlayer::SYNC_INSYNC, nowMs))
+  {
+    case CSeekLeftOut::Due::NOTHING:
+      return;
+    case CSeekLeftOut::Due::TOO_LATE:
+      static_assert(CSeekLeftOut::MAX_WAIT_MS == 5000, "the line below says 5 s");
+      DropSeekLeftOut("the video was not in sync within 5 s of it");
+      return;
+    case CSeekLeftOut::Due::MAKE:
+      break;
+  }
+  CSeekLeftOut::Step step = *m_seekLeftOut.Take();
+  CDVDMsgPlayerSeek::CMode mode;
+  mode.time = step.targetMs;
+  mode.relative = false;
+  mode.backward = step.backward;
+  mode.accurate = false;
+  mode.restore = step.restore;
+  mode.trickplay = false;
+  mode.sync = true;
+  auto message = std::make_shared<CDVDMsgPlayerSeek>(mode);
+  message->SetPending(std::move(step.ticket));
+  message->SetOffset(step.offsetMs);
+  CLog::Log(LOGINFO,
+            "Seek: to {}, a step left out while the video of the seek before it was not in sync, "
+            "made now that it is ({} ms after it was left out)",
+            CSeekTrace::Time(step.targetMs), std::lround(nowMs - step.keptAtMs));
+  m_messenger.Put(message);
+}
+
 IDVDStreamPlayer* CVideoPlayer::GetStreamPlayer(unsigned int target)
 {
   if(target == VideoPlayer_AUDIO)
@@ -3424,6 +3494,7 @@ void CVideoPlayer::OnExit()
 {
   CLog::Log(LOGINFO, "CVideoPlayer::OnExit()");
   m_seekPending->Clear(); // (Hades)
+  DropSeekLeftOut("playback stopped"); // (Hades)
 
   // set event to inform openfile something went wrong in case openfile is still waiting for this event
   SetCaching(CACHESTATE_DONE);
@@ -3526,6 +3597,9 @@ void CVideoPlayer::HandleMessages()
 {
   std::shared_ptr<CDVDMsg> pMsg = nullptr;
 
+  // Hades: a step left out while the video was not in sync is made once it is (CSeekLeftOut)
+  ApplySeekLeftOut();
+
   while (m_messenger.Get(pMsg, 0ms) == MSGQ_OK)
   {
     // Hades: the edition state of a bookmark (PLAYER_SET_STATE) is for the seek that comes right
@@ -3565,6 +3639,7 @@ void CVideoPlayer::HandleMessages()
       m_item = msg.GetItem();
       m_playerOptions = msg.GetOptions();
       m_seekPending->Clear(); // (Hades)
+      DropSeekLeftOut("another file is played"); // (Hades)
 
       m_processInfo->SetPlayTimes(0,0,0,0);
 
@@ -3624,12 +3699,19 @@ void CVideoPlayer::HandleMessages()
             (now - m_State.lastSeek)/1000 < 2000 &&
             !msg.GetAccurate())
         {
-          leftOut("the video of the seek before it is not in sync yet (an inaccurate seek within "
-                  "2 s of it)");
+          leftOut(msg.GetTrickPlay()
+                      ? "the video of the seek before it is not in sync yet (an inaccurate seek "
+                        "within 2 s of it)"
+                      : "the video of the seek before it is not in sync yet (an inaccurate seek "
+                        "within 2 s of it): it is made once the video is");
+          // Hades: ... and the last such step is made once the video is in sync (CSeekLeftOut)
+          KeepSeekLeftOut(msg, trace.toMs, now);
           m_processInfo->SetStateSeeking(false);
           continue;
         }
       }
+      // Hades: this seek goes from where the playback is: a step kept before it is not made
+      DropSeekLeftOut("another seek came after it");
 
       if (!msg.GetTrickPlay())
       {
@@ -3754,6 +3836,7 @@ void CVideoPlayer::HandleMessages()
              m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK) == 0 &&
              m_messenger.GetPacketCount(CDVDMsg::PLAYER_SEEK_CHAPTER) == 0)
     {
+      DropSeekLeftOut("a seek to a chapter came after it"); // (Hades)
       m_processInfo->SeekFinished(0);
       SetCaching(CACHESTATE_FLUSH);
 
@@ -4040,6 +4123,7 @@ void CVideoPlayer::HandleMessages()
     }
     else if (pMsg->IsType(CDVDMsg::PLAYER_SET_STATE))
     {
+      DropSeekLeftOut("a saved state is gone back to"); // (Hades)
       SetCaching(CACHESTATE_FLUSH);
 
       auto pMsgPlayerSetState = std::static_pointer_cast<CDVDMsgPlayerSetState>(pMsg);
@@ -4066,6 +4150,7 @@ void CVideoPlayer::HandleMessages()
     }
     else if (pMsg->IsType(CDVDMsg::GENERAL_FLUSH))
     {
+      DropSeekLeftOut("the streams were flushed"); // (Hades)
       // a Blu-ray playlist stop handled by NextStream() is queued before the streams are closed
       if (m_CurrentAudio.id >= 0 || m_CurrentVideo.id >= 0)
         FlushBuffers(DVD_NOPTS_VALUE, true, true);
@@ -4077,6 +4162,12 @@ void CVideoPlayer::HandleMessages()
       const auto msg = std::static_pointer_cast<CDVDMsgPlayerSetSpeed>(pMsg);
       const int speed = msg->GetSpeed();
 
+      // Hades: a step kept for when the video is in sync is not made after a pause or at another
+      // speed (CSeekLeftOut)
+      if (speed != DVD_PLAYSPEED_NORMAL)
+        DropSeekLeftOut(speed == DVD_PLAYSPEED_PAUSE ? "playback was paused"
+                                                     : "the playback speed changed");
+
       // correct our current clock, as it would start going wrong otherwise
       if (m_State.timestamp > 0)
       {
