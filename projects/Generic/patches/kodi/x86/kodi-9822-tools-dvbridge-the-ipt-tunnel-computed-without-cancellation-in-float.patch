From 1f0f23a98d1e399837cf0478ec2b33397a4b5857 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] tools/dvbridge: the IPT tunnel computed without cancellation
 in float

Pass 9 of the packer converts each pixel of the composer's YCbCr picture to
IPT-PQ-c2 in a shader, in single precision. Written as SMPTE ST 2084
writes its curves, float lost most of what it computed in two places: the
EOTF's c2 - c3 N^(1/m2), a difference of numbers close to each other above
a few cd/m2, and the OETF's (c1 + c2 t) / (1 + c3 t), a number close to 1
raised to m2 = 78.84, which makes the relative error of its float 79 times
larger. P and T, sums of L', M' and S' with coefficients up to 4.9 of
opposite signs, took the most of it. Against the same chain in double
precision (the oracle of the 1.0 RC5 transport bench), on 14 pictures of a
profile 7 FEL stream drawn by the bridge on Mesa's software OpenGL ES
(zink on lavapipe): 0.575 % of the I, 3.618 % of the P and 0.966 % of the
T were one code off, and up to 6.7 % of the P of a picture at the samples
where the composer's own chroma is (the co-sited ones).

Now:
- the EOTF as libplacebo-9942 writes it, with q = 1 - N^(1/m2) =
  -expm1(ln(N) / m2) by its series;
- the OETF as exp(m2 log1p(-w)), w = k (1 - t) / (1 + c3 t), t = l^m1 and
  k = 1 - c1 = c2 - c3;
- P and T from L' - M' and S' - M' (the rows of the inverse of YCCtoRGB
  that give them sum to 0, as its first column is 1), each made with the
  precision of L - M and S - M: through log(L / M), t_L - t_M, w_M - w_L
  and expm1, each series where its argument is at most 1/4;
- P and T rounded about 0, 2048 added after the rounding.

Measured the same way: 0.036 % of the I, 0.034 % of the P and 0.041 % of
the T, at most 0.11 % of the co-sited samples of a picture, never more
than one code. That is of the order of single precision itself: the same
chain on the processor with each operation rounded once (numpy float32)
is off on 0.003 % to 0.045 % of the samples of five of these pictures.
Exact codes would take more than the single precision that OpenGL ES 3.0
has.

Nothing else changes: the picture as composed (the YCbCr transport) and
profile 5 give the same bytes as before, in the direct and the composed
ways; the IPT bytes of the two ways are the same as each other, and the
DM header is that of IPT with the matrices of profile 5 in all 14
pictures. Three mutations of the new chain (a factor of w_M - w_L, the
sign of q in the EOTF, P made from the difference of T) each take more
than 95 % of a channel off the double-precision chain, by up to 3102
codes. Pass 9a computes I only and 9b P and T only: 18 and 20
exponentials and logarithms a pixel where both had 24 (a power is two),
and more multiplications. What that costs on a GPU is not measured.
---
 tools/dvbridge/dvbridge_source.c | 105 +++++++++++++++++++++++++++----
 1 file changed, 92 insertions(+), 13 deletions(-)

diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 1784dae..937b4f8 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -1290,7 +1290,31 @@ struct common_uniforms {
 /* 9. Hades: the IPT tunnel (dvbridge_source_to_ipt()): the codes of a pixel of the composer's YCbCr
  * picture in IPT-PQ-c2, in floats; the luma of the picture (9a, a float a pixel) and its rows of
  * 4:2:2 (9b, as pass 2 lays them out). The chroma between the pairs is Lanczos 6 in integers, the
- * filter of pass 2. Outside the active picture nothing is read: the transport is black there. */
+ * filter of pass 2. Outside the active picture nothing is read: the transport is black there.
+ *
+ * The chain is written so that float keeps the precision of its inputs, not as SMPTE ST 2084 writes
+ * it:
+ *  - the EOTF with q = 1 - N^(1/m2) = -expm1(ln(N) / m2) by its series, as libplacebo-9942 writes
+ *    it: c2 - c3 N^(1/m2) is a difference of numbers close to each other above a few cd/m2;
+ *  - the OETF as exp(m2 log1p(-w)), w = k (1 - t) / (1 + c3 t), t = l^m1, k = 1 - c1 = c2 - c3:
+ *    (c1 + c2 t) / (1 + c3 t) is 1 - w, a number close to 1 whose float loses most of w, which
+ *    the power m2 = 78.84 then makes a relative error 79 times its size;
+ *  - P and T from the differences L' - M' and S' - M' (the rows of the inverse of YCCtoRGB that
+ *    give them sum to 0, as the first column of YCCtoRGB is 1), made from L - M and S - M without
+ *    a difference of the values in PQ: L' - M' = M' expm1(m2 (log1p(-w_L) - log1p(-w_M))), the
+ *    logarithm of the ratio of 1 - w_L to 1 - w_M from w_M - w_L = k (1 + c3) (t_L - t_M) /
+ *    ((1 + c3 t_L) (1 + c3 t_M)), and t_L - t_M = t_M expm1(m1 log1p((L - M) / M)); each series
+ *    where its argument is at most 1/4 (beyond, the difference of the two logarithms, or
+ *    exp(x) - 1, loses nothing); and rounded about 0, 2048 added after: at 2048 a float has
+ *    1/4096 of a code, near 0 far less.
+ * Every series is exact to 1e-9 or better on its range. Measured against the chain in double
+ * precision on 14 pictures of a profile 7 FEL stream, on Mesa's software OpenGL ES: written as
+ * ST 2084 writes it, 0.58 % of the I, 3.6 % of the P and 0.97 % of the T were one code off (up
+ * to 6.7 % of the P of a picture where the composer's own chroma is); written so, 0.036 %, 0.034 %
+ * and 0.041 % (at most 0.11 % of those samples of a picture), never more than one code. That is
+ * of the order of single precision itself (the same chain on the processor, each operation
+ * rounded once, is off on 0.003 % to 0.045 % of the samples of five of them): exact codes would
+ * take more than the single precision that OpenGL ES 3.0 has. */
 #define IPT_HEAD                                                                                  \
     "#version 300 es\n"                                                                           \
     "precision highp float;\n"                                                                    \
@@ -1304,16 +1328,49 @@ struct common_uniforms {
     "uniform ivec2 pairs;\n"  /* the first and the last pair of the active picture */             \
     "uniform int hweights[12];\n"                                                                 \
     "const float m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;\n"                          \
-    "const float c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0, c3 = 2392.0 / 4096.0 * 32.0;\n" \
+    "const float c3 = 2392.0 / 4096.0 * 32.0;\n"                                                  \
+    "const float k = 672.0 / 4096.0;\n" /* 1 - c1 = c2 - c3, exactly */                           \
+    "vec3 expm1_series(vec3 x)\n" /* |x| <= 1/4 */                                                \
+    "{\n"                                                                                         \
+    "    return x * (1.0 + x * (1.0 / 2.0) * (1.0 + x * (1.0 / 3.0) * (1.0 + x * (1.0 / 4.0)\n"    \
+    "           * (1.0 + x * (1.0 / 5.0) * (1.0 + x * (1.0 / 6.0) * (1.0 + x * (1.0 / 7.0)\n"      \
+    "           * (1.0 + x * (1.0 / 8.0))))))));\n"                                               \
+    "}\n"                                                                                         \
+    "vec2 expm1_series(vec2 x)\n"                                                                 \
+    "{\n"                                                                                         \
+    "    return expm1_series(vec3(x, 0.0)).xy;\n"                                                 \
+    "}\n"                                                                                         \
+    "vec2 expm1_any(vec2 x)\n"                                                                    \
+    "{\n"                                                                                         \
+    "    return mix(exp(x) - 1.0, expm1_series(clamp(x, -0.25, 0.25)),\n"                         \
+    "               lessThanEqual(abs(x), vec2(0.25)));\n"                                        \
+    "}\n"                                                                                         \
+    "vec3 log1p_series(vec3 u)\n" /* |u| <= 1/4: 2 atanh(u / (2 + u)) */                          \
+    "{\n"                                                                                         \
+    "    vec3 s = u / (2.0 + u), s2 = s * s;\n"                                                   \
+    "    return 2.0 * s * (1.0 + s2 * (1.0 / 3.0 + s2 * (1.0 / 5.0 + s2 * (1.0 / 7.0\n"            \
+    "           + s2 * (1.0 / 9.0 + s2 * (1.0 / 11.0))))));\n"                                    \
+    "}\n"                                                                                         \
+    "vec2 log1p_series(vec2 u)\n"                                                                 \
+    "{\n"                                                                                         \
+    "    return log1p_series(vec3(u, 0.0)).xy;\n"                                                 \
+    "}\n"                                                                                         \
     "vec3 eotf(vec3 e)\n"                                                                         \
     "{\n"                                                                                         \
-    "    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / m2));\n"                                     \
-    "    return pow(max(p - vec3(c1), 0.0) / (vec3(c2) - vec3(c3) * p), vec3(1.0 / m1));\n"       \
+    "    vec3 x = log(max(clamp(e, 0.0, 1.0), vec3(1e-30))) * (1.0 / m2);\n"                      \
+    "    vec3 q = mix(-expm1_series(clamp(x, -0.25, 0.0)), vec3(1.0), lessThan(x, vec3(-0.25)));\n" \
+    "    return pow(max(vec3(k) - q, 0.0) / (vec3(k) + c3 * q), vec3(1.0 / m1));\n"               \
     "}\n"                                                                                         \
-    "vec3 oetf(vec3 l)\n"                                                                         \
+    /* the OETF of l as exp(m2 lam): its logarithm, t = l^m1, w and lam = log1p(-w) */            \
+    "void oetf_parts(vec3 l, out vec3 lnl, out vec3 t, out vec3 w, out vec3 lam)\n"               \
     "{\n"                                                                                         \
-    "    vec3 t = pow(max(l, 0.0), vec3(m1));\n"                                                  \
-    "    return pow((vec3(c1) + vec3(c2) * t) / (vec3(1.0) + vec3(c3) * t), vec3(m2));\n"          \
+    "    lnl = log(max(l, vec3(1e-37)));\n"                                                       \
+    "    vec3 a = m1 * lnl;\n"                                                                    \
+    "    t = exp(a);\n"                                                                           \
+    "    vec3 rest = mix(1.0 - t, -expm1_series(clamp(a, -0.25, 0.25)),\n"                        \
+    "                    lessThanEqual(abs(a), vec3(0.25)));\n"                                   \
+    "    w = k * rest / (1.0 + c3 * t);\n"                                                        \
+    "    lam = log1p_series(clamp(-w, -0.25, 0.25));\n"                                           \
     "}\n"                                                                                         \
     "uvec2 pair(int n, int r)\n"                                                                  \
     "{\n"                                                                                         \
@@ -1324,11 +1381,33 @@ struct common_uniforms {
     "{\n"                                                                                         \
     "    return floor(texelFetch(luma_plane, q, 0).r * code_scale + 0.5);\n"                      \
     "}\n"                                                                                         \
-    "uvec3 ipt_codes(float y, vec2 c)\n"                                                          \
+    "vec3 linear_of(float y, vec2 c)\n"                                                           \
+    "{\n"                                                                                         \
+    "    return eotf(clamp(ycc_src * (vec3(y, c) / code_scale - off_src), 0.0, 1.0));\n"          \
+    "}\n"                                                                                         \
+    "uint ipt_i(float y, vec2 c)\n"                                                               \
+    "{\n"                                                                                         \
+    "    vec3 lnl, t, w, lam;\n"                                                                  \
+    "    oetf_parts(to_lms * linear_of(y, c), lnl, t, w, lam);\n"                                 \
+    "    return uint(clamp(floor((to_ipt * exp(m2 * lam)).x * 4096.0 + 0.5), 0.0, 4095.0));\n"    \
+    "}\n"                                                                                         \
+    "uvec2 ipt_pt(float y, vec2 c)\n"                                                             \
     "{\n"                                                                                         \
-    "    vec3 rgb = clamp(ycc_src * (vec3(y, c) / code_scale - off_src), 0.0, 1.0);\n"            \
-    "    vec3 v = to_ipt * oetf(to_lms * eotf(rgb)) + vec3(0.0, 0.5, 0.5);\n"                     \
-    "    return uvec3(clamp(floor(v * 4096.0 + 0.5), 0.0, 4095.0));\n"                            \
+    "    vec3 lin = linear_of(y, c), lms = to_lms * lin;\n"                                       \
+    "    mat3 lr = transpose(to_lms), ir = transpose(to_ipt);\n"                                  \
+    "    vec2 d = vec2(dot(lr[0] - lr[1], lin), dot(lr[2] - lr[1], lin));\n" /* L - M, S - M */   \
+    "    vec3 lnl, t, w, lam;\n"                                                                  \
+    "    oetf_parts(lms, lnl, t, w, lam);\n"                                                      \
+    "    vec2 u = d / max(lms.y, 1e-37);\n"                                                       \
+    "    vec2 ratio = mix(lnl.xz - lnl.yy, log1p_series(clamp(u, -0.25, 0.25)),\n"               \
+    "                     lessThanEqual(abs(u), vec2(0.25)));\n" /* log(L / M), log(S / M) */      \
+    "    vec2 dt = t.yy * expm1_any(m1 * ratio);\n"                                               \
+    "    vec2 v = k * (1.0 + c3) * dt / ((1.0 + c3 * t.xz) * (1.0 + c3 * t.y) * (1.0 - w.y));\n"  \
+    "    vec2 dl = mix(lam.xz - lam.yy, log1p_series(clamp(v, -0.25, 0.25)),\n"                   \
+    "                  lessThanEqual(abs(v), vec2(0.25)));\n"                                     \
+    "    vec2 dp = exp(m2 * lam.y) * expm1_any(m2 * dl);\n" /* L' - M', S' - M' */                \
+    "    vec2 pt = vec2(ir[1].x * dp.x + ir[1].z * dp.y, ir[2].x * dp.x + ir[2].z * dp.y);\n"     \
+    "    return uvec2(clamp(floor(pt * 4096.0 + 0.5) + 2048.0, 0.0, 4095.0));\n"                  \
     "}\n"                                                                                         \
     "bool active_at(int x, int y)\n"                                                              \
     "{\n"                                                                                         \
@@ -1356,7 +1435,7 @@ static const char IPT_LUMA[] =
     "            acc += hweights[k] * ivec2(pair(n - 5 + k, q.y));\n"
     "        c = vec2(clamp((acc + (1 << 13)) >> 14, ivec2(0), ivec2(4095)));\n"
     "    }\n"
-    "    color = vec4(float(ipt_codes(luma_at(q), c).x) / code_scale, 0.0, 0.0, 1.0);\n"
+    "    color = vec4(float(ipt_i(luma_at(q), c)) / code_scale, 0.0, 0.0, 1.0);\n"
     "}\n";
 
 /* 9b. P and T of each pair, from its even pixel; fragment (n, i): rows 2 i (rg) and 2 i + 1 (ba) */
@@ -1371,7 +1450,7 @@ static const char IPT_ROWS[] =
     "    for (int k = 0; k < 2; k++) {\n"
     "        int r = 2 * q.y + k, x = 2 * q.x;\n"
     "        if (r < rows && active_at(x, r)) {\n"
-    "            uvec2 pt = ipt_codes(luma_at(ivec2(x, r)), vec2(pair(q.x, r))).yz;\n"
+    "            uvec2 pt = ipt_pt(luma_at(ivec2(x, r)), vec2(pair(q.x, r)));\n"
     "            if (k == 0) out_.rg = pt; else out_.ba = pt;\n"
     "        }\n"
     "    }\n"
-- 
2.53.0

