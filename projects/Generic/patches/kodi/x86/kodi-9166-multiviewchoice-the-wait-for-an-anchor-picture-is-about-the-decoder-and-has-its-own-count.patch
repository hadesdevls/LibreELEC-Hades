From 47fa79b1e31f31a404f0327708260f7d9b0b40de Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 03:43:09 +0000
Subject: [PATCH] MultiviewChoice: the wait for an anchor picture is about the
 decoder, and has its own count

Three things in the rule that holds the second view of a disc back until an anchor picture:

- The wait ended after 300 pictures that went on alone, whatever the reason. Pictures for
  which no second view was at hand counted too, so after two re-placements of a clip at 50 or
  60 pictures a second the first access unit that came was appended without an anchor: the
  very case that the rule is for. The limit now counts only the access units of the second
  view that were at hand and were dropped for want of an anchor (Rejoin::dropped,
  DISC_DROPPED_UNTIL_RESUMED); the pictures that went on alone are still counted, for the log.
- The wait began only after a first picture had gone on with its second view. What it
  protects is the decoder, which did not get the second view of a picture that went on alone
  whether or not one came before it: the condition is gone. A fresh state still appends what
  pairs as it comes, so a start and a seek whose first picture pairs are as they were.
- IsPictureAlone(): a packet of the base view without a presentation time is not a picture
  that went on alone. Where the two fields of a picture come as two packets, the second has
  no time of its own and its second view came with the first. (Not verified: that takes a
  disc whose 3D video is coded in fields.)
---
 xbmc/cores/VideoPlayer/MultiviewChoice.h | 62 ++++++++++++++++--------
 1 file changed, 43 insertions(+), 19 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index 8f23019..38a08b2 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -844,13 +844,31 @@ inline bool IsAnchorOfSecondView(const uint8_t* data, size_t size)
   return false;
 }
 
-//! Pictures of the base view that go on alone while an anchor picture of the second view is
-//! waited for, after which the second view is appended again as it comes (12 seconds of film;
-//! a stream marks an anchor every second or two)
-inline constexpr unsigned int DISC_ALONE_UNTIL_RESUMED = 300;
+//! Access units of the second view that are at hand and are dropped for want of an anchor
+//! picture, after which the second view is appended again as it comes (12 seconds of film; a
+//! stream marks an anchor every second or two). A picture for which no second view was at hand
+//! does not count: that no anchor came is one thing, that nothing came is another.
+inline constexpr unsigned int DISC_DROPPED_UNTIL_RESUMED = 300;
 
 /*!
- * \brief What is remembered between the pictures of a clip about appending its second view
+ * \brief Whether a packet of the base view that goes on without a second view is a picture
+ *        that went on alone
+ * \param hasTime the packet has a presentation time
+ *
+ * A packet without a time is not: it is handed on as it is, and nothing is concluded from it.
+ * Where the two fields of a picture come as two packets, the second one has no time of its
+ * own, and its second view came with the first: the clip of the second view is read a whole
+ * PES packet at a time, both fields in one. (Only a disc whose 3D video is coded in fields
+ * can tell whether that is so. Not verified.)
+ */
+constexpr bool IsPictureAlone(bool hasTime)
+{
+  return hasTime;
+}
+
+/*!
+ * \brief Whether every picture of the base view has gone on with its second view since the
+ *        decoder was last started or flushed, and what is remembered where one has not
  *
  * The decoder of both views gets each picture of the second view in the packet of its base
  * view. When a picture of the base view has gone on alone, the second view of the pictures
@@ -859,16 +877,24 @@ inline constexpr unsigned int DISC_ALONE_UNTIL_RESUMED = 300;
  * second view, and of what comes behind the anchor in the stream, nothing that is shown before
  * it (such a picture may still refer to one from before the gap).
  *
- * The first pictures of a clip, and those after a seek, are appended as they come: the base
- * view starts there on a picture that everything behind it is decoded from.
+ * This is about the decoder, not about a clip. It starts anew with a seek or a flush, which
+ * start the decoder anew, and with nothing else: another clip, another angle, a playlist that
+ * is read again leave it as it is, and a picture of the base view that passes while no clip of
+ * a second view is open went on alone like any other.
+ *
+ * At a start and after a seek it is fresh, and what pairs is appended as it comes: the base
+ * view starts there on a picture that everything behind it is decoded from. If the first
+ * pictures go on alone, the wait begins with them and ends at the next anchor.
  */
 struct Rejoin
 {
-  bool paired{false}; //!< a picture went on with its second view since the clip was opened or sought
-  bool waiting{false}; //!< pictures went on alone since: nothing is appended before an anchor
+  bool waiting{false}; //!< a picture went on alone: nothing is appended before an anchor
   bool behind{false}; //!< appended again from an anchor: what is shown before it goes on alone
   int64_t anchorTime{NO_TIME}; //!< the presentation time of that anchor
-  unsigned int alone{0}; //!< pictures that went on alone since the wait began
+  unsigned int alone{0}; //!< pictures that went on alone since the wait began (for the log)
+  //! ... of them, those whose second view was at hand and was dropped for want of an anchor:
+  //! what the wait is bounded by (DISC_DROPPED_UNTIL_RESUMED)
+  unsigned int dropped{0};
 };
 
 //! What is done with a picture of the base view whose second view is at hand
@@ -881,18 +907,16 @@ enum class Join
 };
 
 /*!
- * \brief A picture of the base view went on without its second view (none met it in time, it
- *        has no time, or the two could not be put together)
- *
- * Before the first picture of a clip that goes on with its second view, and after a seek,
- * that changes nothing.
+ * \brief A picture of the base view went on without its second view: none was at hand (none
+ *        met it in time, no clip is open), or the two could not be put together
  */
 inline void WentAlone(Rejoin& state)
 {
-  if (!state.paired)
-    return;
   if (!state.waiting)
+  {
     state.alone = 0;
+    state.dropped = 0;
+  }
   state.waiting = true;
   state.behind = false;
   state.anchorTime = NO_TIME;
@@ -915,11 +939,12 @@ inline Join Offer(Rejoin& state, bool anchor, int64_t time)
       state.anchorTime = time;
       return Join::APPEND_AT_ANCHOR;
     }
-    if (state.alone >= DISC_ALONE_UNTIL_RESUMED)
+    if (state.dropped >= DISC_DROPPED_UNTIL_RESUMED)
     {
       state.waiting = false;
       return Join::APPEND_UNANCHORED;
     }
+    ++state.dropped;
     ++state.alone;
     return Join::ALONE;
   }
@@ -933,7 +958,6 @@ inline Join Offer(Rejoin& state, bool anchor, int64_t time)
     // a picture that is shown after the anchor: none that is shown before it follows
     state.behind = false;
   }
-  state.paired = true;
   return Join::APPEND;
 }
 
-- 
