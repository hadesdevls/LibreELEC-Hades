From c4010bf5a25c8232ac6a3b2267e077739cd8891b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 29 Sep 2026 02:31:58 +0000
Subject: [PATCH] settings: size the default file cache by the machine's RAM

Kodi's 64 MB memory cache holds 2.5 to 5 s ahead of an 80 Mbit/s UHD remux (2.5 s
when the file is known as Matroska: two buffers of half the size, 3/4 of each
ahead; 5 s with a single buffer), too little for the bitrate peaks of Dolby
Vision FEL remuxes streamed over the internet. The default of
filecache.memorysize now follows the RAM the kernel reports: 64 MB below 3.5 GiB
or when unknown, 256 MB from 3.5 GiB, 512 MB from 7 GiB and 1 GB from 14 GiB
(20 to 40 s ahead at 512 MB, 40 to 80 s at 1 GB). Every value is one of the
setting's choices, below the 2 GB one.

It is a default: a value the user chose is kept, as for any setting. The memory
is allocated when a file opens (and the second Matroska buffer on the first seek
outside the cache), and freed when it closes. The cache settings logged at
startup now also show the default and the RAM it follows.

GetMemoryStatus() on Linux left its counters uninitialised for a line missing
from /proc/meminfo; they start at 0 now, and the caller zero-initialises the
status in case /proc/meminfo cannot be opened.
---
 xbmc/application/Application.cpp   | 10 ++++++++--
 xbmc/platform/linux/MemUtils.cpp   | 11 ++++++-----
 xbmc/settings/ServicesSettings.cpp | 15 +++++++++++++++
 xbmc/settings/ServicesSettings.h   |  5 +++++
 xbmc/settings/Settings.cpp         | 15 +++++++++++++++
 5 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 79cc9a9..c293f9b 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -140,6 +140,7 @@
 #include "utils/ContentUtils.h"
 #include "utils/FileExtensionProvider.h"
 #include "utils/LangCodeExpander.h"
+#include "utils/MemUtils.h"
 #include "utils/PlayerUtils.h"
 #include "utils/RegExp.h"
 #include "utils/Screenshot.h"
@@ -331,12 +332,17 @@ bool CApplication::Create()
   // Log Cache GUI settings (replacement of cache in advancedsettings.xml)
   const auto settings = settingsComponent->GetSettings();
   const float readFactor = settings->GetInt(CSettings::SETTING_FILECACHE_READFACTOR) / 100.0f;
+  KODI::MEMORY::MemoryStatus memory{};
+  KODI::MEMORY::GetMemoryStatus(&memory);
+  const auto memorySize = std::static_pointer_cast<const CSettingInt>(
+      settings->GetSetting(CSettings::SETTING_FILECACHE_MEMORYSIZE));
   CLog::Log(LOGINFO,
             "New Cache GUI Settings (replacement of cache in advancedsettings.xml) are:\n  Buffer "
-            "Mode: {}\n  Memory Size: {} MB\n  Read "
+            "Mode: {}\n  Memory Size: {} MB (default {} MB for {} MiB of RAM)\n  Read "
             "Factor: {:.2f} x {}\n  Chunk Size : {} bytes",
             settings->GetInt(CSettings::SETTING_FILECACHE_BUFFERMODE),
-            settings->GetInt(CSettings::SETTING_FILECACHE_MEMORYSIZE), readFactor,
+            settings->GetInt(CSettings::SETTING_FILECACHE_MEMORYSIZE),
+            memorySize ? memorySize->GetDefault() : 0, memory.totalPhys / (1024 * 1024), readFactor,
             (readFactor < 1.0f) ? "(adaptive)" : "",
             settings->GetInt(CSettings::SETTING_FILECACHE_CHUNKSIZE));
 
diff --git a/xbmc/platform/linux/MemUtils.cpp b/xbmc/platform/linux/MemUtils.cpp
index ce5f2b5..9e3d23a 100644
--- a/xbmc/platform/linux/MemUtils.cpp
+++ b/xbmc/platform/linux/MemUtils.cpp
@@ -49,11 +49,12 @@ void GetMemoryStatus(MemoryStatus* buffer)
   if (!file.is_open())
     return;
 
-  uint64_t buffers;
-  uint64_t cached;
-  uint64_t free;
-  uint64_t total;
-  uint64_t reclaimable;
+  // 0 for a line /proc/meminfo does not have
+  uint64_t buffers = 0;
+  uint64_t cached = 0;
+  uint64_t free = 0;
+  uint64_t total = 0;
+  uint64_t reclaimable = 0;
   uint64_t available = 0;
 
   std::string token;
diff --git a/xbmc/settings/ServicesSettings.cpp b/xbmc/settings/ServicesSettings.cpp
index 92a804a..a19b803 100644
--- a/xbmc/settings/ServicesSettings.cpp
+++ b/xbmc/settings/ServicesSettings.cpp
@@ -73,6 +73,21 @@ void CServicesSettings::SettingOptionsMemorySizesFiller(const SettingConstPtr& /
   list.emplace_back(CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(37115), 0);
 }
 
+int CServicesSettings::DefaultMemorySize(uint64_t totalRam)
+{
+  // The RAM the kernel reports is below the nominal size (firmware and graphics reservations): an
+  // "8 GB" machine has about 7.3 to 7.8 GiB. A Matroska stream gets two buffers of half the size,
+  // each 3/4 ahead: 512 MB hold 20 s of an 80 Mbit/s UHD remux ahead, 64 MB only 2.5 s.
+  constexpr uint64_t GiB = 1024 * 1024 * 1024;
+  if (totalRam >= 14 * GiB)
+    return 1024;
+  if (totalRam >= 7 * GiB)
+    return 512;
+  if (totalRam >= 7 * GiB / 2)
+    return 256;
+  return 64; // Kodi's default, also when the RAM is not known
+}
+
 void CServicesSettings::SettingOptionsReadFactorsFiller(const SettingConstPtr& /*setting*/,
                                                         std::vector<IntegerSettingOption>& list,
                                                         int& /*current*/)
diff --git a/xbmc/settings/ServicesSettings.h b/xbmc/settings/ServicesSettings.h
index 1092dc7..900a175 100644
--- a/xbmc/settings/ServicesSettings.h
+++ b/xbmc/settings/ServicesSettings.h
@@ -11,6 +11,7 @@
 #include "settings/ISubSettings.h"
 #include "settings/lib/Setting.h"
 
+#include <cstdint>
 #include <vector>
 
 class CServicesSettings : public ISubSettings
@@ -25,6 +26,10 @@ public:
   static void SettingOptionsMemorySizesFiller(const SettingConstPtr& setting,
                                               std::vector<IntegerSettingOption>& list,
                                               int& current);
+  //! The default of filecache.memorysize, in MB, for a machine with this much RAM in bytes (0 when
+  //! unknown): from Kodi's 64 MB up to 1 GB, about 1/14 of the RAM at each step, among the setting's
+  //! choices
+  static int DefaultMemorySize(uint64_t totalRam);
   static void SettingOptionsReadFactorsFiller(const SettingConstPtr& setting,
                                               std::vector<IntegerSettingOption>& list,
                                               int& current);
diff --git a/xbmc/settings/Settings.cpp b/xbmc/settings/Settings.cpp
index d26cd00..c33a90e 100644
--- a/xbmc/settings/Settings.cpp
+++ b/xbmc/settings/Settings.cpp
@@ -45,6 +45,7 @@
 #include "settings/SubtitlesSettings.h"
 #include "settings/lib/SettingsManager.h"
 #include "utils/CharsetConverter.h"
+#include "utils/MemUtils.h"
 #include "utils/RssManager.h"
 #include "utils/StringUtils.h"
 #include "utils/SystemInfo.h"
@@ -354,6 +355,20 @@ void CSettings::InitializeDefaults()
       std::static_pointer_cast<CSettingInt>(setting)->SetDefault(POWERSTATE_SHUTDOWN);
   }
 
+  // The memory for the file cache follows the RAM of the machine, so that streamed UHD remuxes
+  // ride out their bitrate peaks. Only a value the user did not change follows the default.
+  const SettingPtr cacheMemory =
+      GetSettingsManager()->GetSetting(CSettings::SETTING_FILECACHE_MEMORYSIZE);
+  if (!cacheMemory)
+    CLog::Log(LOGERROR, "Failed to load setting for: {}", CSettings::SETTING_FILECACHE_MEMORYSIZE);
+  else
+  {
+    KODI::MEMORY::MemoryStatus memory{};
+    KODI::MEMORY::GetMemoryStatus(&memory);
+    std::static_pointer_cast<CSettingInt>(cacheMemory)
+        ->SetDefault(CServicesSettings::DefaultMemorySize(memory.totalPhys));
+  }
+
   // Initialize deviceUUID if not already set, used in zeroconf advertisements.
   std::shared_ptr<CSettingString> deviceUUID = std::static_pointer_cast<CSettingString>(GetSettingsManager()->GetSetting(CSettings::SETTING_SERVICES_DEVICEUUID));
   if (deviceUUID->GetValue().empty())
