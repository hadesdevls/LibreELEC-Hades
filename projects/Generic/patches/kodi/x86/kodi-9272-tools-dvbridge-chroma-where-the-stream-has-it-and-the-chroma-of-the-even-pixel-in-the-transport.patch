From 5ebc07ad69e5284752fe0a8721adf85f27c0f4b3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 17:52:14 +0000
Subject: [PATCH] tools/dvbridge: chroma where the stream has it, and the
 chroma of the even pixel in the transport

The planes of a decoded picture were handed to libplacebo without a
chroma location, and libplacebo takes subsampled planes without one as
centred between their luma samples. HEVC has its 4:2:0 chroma on the
left (type 0, also when the VUI says nothing), and UHD Blu-ray signals
top left (type 2): the chroma of the reconstructed picture was half a
luma pixel to the right of where the stream has it, and for top left
half a pixel down as well. The planes of the enhancement layer had no
offset either, and libplacebo aligns them with the base layer by it.

dvbridge_gl_frame_import() now takes the chroma location of the picture
(AVFrame::chroma_location; for the base layer VideoPicture::chroma_position,
kept with the picture in its buffer) and gives it to libplacebo
(pl_frame_set_chroma_location()), which offsets the subsampled planes
only. Unspecified is "left", as HEVC and libplacebo take it.

The transport made the chroma of a pair of pixels from the mean of its
two pixels, a value centred on pixel 2k + 0.5. 4:2:2 over HDMI is
co-sited: a receiver puts the chroma of a pair on pixel 2k. The two half
pixels cancelled horizontally (not vertically), and the mean blurred.
Now the chroma of a pair is that of its even pixel, in the composed way
(pack_gles300.frag) and in the direct one (pack_active_area()); the
luma of each pixel, the metadata bits and their parity are as they were.
A filter centred on the even pixel would need pixels outside the pair,
which the direct way does not have.

Measured on a software OpenGL ES (Mesa zink on lavapipe), not on a GPU
or a display:
 - flat planes with one chroma sample raised: the response of the
   reconstructed picture is centred on luma pixel 2k (left), and on row
   2r too (top left), where it was 2k + 0.5 and 2r + 0.5; a chroma
   sample m of the enhancement layer lands on base pixel 4m (was
   4m + 1). In the transport a raised chroma sample of the base layer
   now changes the chroma of its own pair alone (others by one code of
   4096 at most, the precision of the scaler's weights); before, that
   of 56 more pairs, by up to 53 codes.
 - eight pictures of a profile 7 FEL stream (top left): the
   reconstructed picture changes in 3 to 68 % of its pixels, mostly by 1
   to 3 codes of 4095 (at most 20); the transport in 0.9 to 32 % of its
   chroma values, mostly by one code (by up to 229 at the edges of
   bright, clipped text, where the two pixels of a pair differ), and in
   the luma of 0.06 to 1.1 % of the pixels by one or two codes.
 - a receiver that puts the chroma on the even pixel and interpolates
   the odd one (linearly or with 4 taps) gets back a picture closer to
   the reconstructed one, in mean error, from the even pixel than from
   the mean, a (1, 2, 1) or a 7-tap half-band filter, in all eight.
 - the two ways still differ by at most one code in luma; in chroma one
   value of the eight pictures differs by two: the chroma of a pair now
   follows one pixel, where the mean halved what the two ways compute
   differently (the same happens with the picture of before and the
   chroma of the even pixel).
---
 tools/dvbridge/dvbridge_gl_frame.c            |  9 ++++++++-
 tools/dvbridge/dvbridge_gl_frame.h            | 11 ++++++++--
 tools/dvbridge/dvbridge_render.c              | 19 ++++++++++--------
 tools/dvbridge/pack_gles300.frag              | 20 ++++++++++++-------
 .../VideoRenderers/DVBridgeGLES.cpp           | 12 +++++++----
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  2 ++
 .../HwDecRender/RendererVAAPIGLES.cpp         |  2 ++
 .../VideoRenderers/LinuxRendererGLES.cpp      |  1 +
 .../VideoRenderers/LinuxRendererGLES.h        |  3 +++
 9 files changed, 57 insertions(+), 22 deletions(-)

diff --git a/tools/dvbridge/dvbridge_gl_frame.c b/tools/dvbridge/dvbridge_gl_frame.c
index 344769d..4916ea1 100644
--- a/tools/dvbridge/dvbridge_gl_frame.c
+++ b/tools/dvbridge/dvbridge_gl_frame.c
@@ -2,6 +2,7 @@
 /* Map native decoded planes to renderer textures while preserving layout and bit depth. */
 #include "dvbridge_gl_frame.h"
 #include <GLES3/gl3.h>
+#include <libplacebo/utils/libav.h>
 #include <string.h>
 
 void dvbridge_gl_frame_release(struct dvbridge_gl_frame *frame)
@@ -15,7 +16,8 @@ void dvbridge_gl_frame_release(struct dvbridge_gl_frame *frame)
 
 bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
                              enum dvbridge_gl_layout layout, int width, int height,
-                             const struct dvbridge_gl_plane planes[3])
+                             const struct dvbridge_gl_plane planes[3],
+                             enum AVChromaLocation chroma_location)
 {
     if (!out || !gpu || !planes || width <= 0 || width > 3840 || height <= 0 || height > 2160)
         return false;
@@ -61,6 +63,11 @@ bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
         if (components == 2)
             plane->component_mapping[1] = 2;
     }
+    /* Hades: the place of the chroma samples, as an offset of the subsampled planes (libplacebo
+     * takes them centred without one). It also reaches the planes of an enhancement layer, which
+     * libplacebo aligns with the base layer by it. A plane that is not subsampled (4:4:4) gets
+     * none. */
+    pl_frame_set_chroma_location(&candidate.frame, pl_chroma_from_av(chroma_location));
     *out = candidate;
     return true;
 fail:
diff --git a/tools/dvbridge/dvbridge_gl_frame.h b/tools/dvbridge/dvbridge_gl_frame.h
index e03099d..4e67824 100644
--- a/tools/dvbridge/dvbridge_gl_frame.h
+++ b/tools/dvbridge/dvbridge_gl_frame.h
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-3.0-or-later */
 #ifndef DVBRIDGE_GL_FRAME_H
 #define DVBRIDGE_GL_FRAME_H
+#include <libavutil/pixfmt.h>
 #include <libplacebo/opengl.h>
 #include <libplacebo/renderer.h>
 
@@ -16,9 +17,15 @@ struct dvbridge_gl_frame {
     pl_gpu gpu;
     struct pl_frame frame;
 };
-/* Current GL context required. The decoder retains ownership of all textures. */
+/* Current GL context required. The decoder retains ownership of all textures.
+ * chroma_location: where the samples of the subsampled planes are, as the decoder gives it for
+ * the picture (AVFrame::chroma_location); unspecified is taken as "left", the default of HEVC and
+ * of libplacebo. Without it the planes were taken as centred between the luma samples, which is
+ * not where an HEVC stream has them: half a luma pixel off horizontally, and also vertically for
+ * the "top left" of UHD Blu-ray. */
 bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
                              enum dvbridge_gl_layout layout, int width, int height,
-                             const struct dvbridge_gl_plane planes[3]);
+                             const struct dvbridge_gl_plane planes[3],
+                             enum AVChromaLocation chroma_location);
 void dvbridge_gl_frame_release(struct dvbridge_gl_frame *frame);
 #endif
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 2573ea9..ba637f5 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -68,7 +68,8 @@ struct active_mask {
  *  - packed: black with the metadata bit of the pixel, luma 256 and chroma 2048, whose bits
  *    have even parity, so the bit goes in as it is. That is what pack_active_area() makes of a
  *    pair of black pixels. A pair that the edge of the active picture divides is left to it:
- *    its chroma takes both pixels;
+ *    its two pixels exchange their values there (the chroma of the pair is that of its even
+ *    pixel, the luma of each pixel its own);
  *  - not packed: black, as mask_active_area() writes it.
  * The packed form is the "Opt1" change of the Intel Dolby Vision LibreELEC fork (commit
  * d5976b3338).
@@ -95,7 +96,7 @@ static struct pl_hook_res skip_inactive_area(struct active_mask *mask,
         .variables=vars, .num_variables=packed ? 4 : 1,
         .body=packed ?
         "ivec2 ep=ivec2(gl_FragCoord.xy); if(dv_flip!=0u) ep.y=2159-ep.y;\n"
-        // Keep boundary pairs together: their chroma also uses the active neighbor.
+        // Keep boundary pairs together: their pixels exchange values in pack_active_area().
         "int ex=ep.x&~1;\n"
         "if(float(ex+1)<early_area.x || float(ex)>=early_area.z || float(ep.y)<early_area.y || float(ep.y)>=early_area.w){\n"
         "uint ei=uint(ep.y*3840+ep.x), ek=ei/3072u, ev=0u;\n"
@@ -128,7 +129,8 @@ static bool bars_written_in_this_shader(const struct active_mask *mask,
 }
 
 /* Same arithmetic/packing as pack_gles300.frag. Subgroup exchange replaces
- * only the full-precision intermediate texture fetch of the adjacent pixel.
+ * only the full-precision intermediate texture fetch of the adjacent pixel
+ * (the even pixel of the pair, whose chroma the pair carries).
  * Adapted from the existing mpv_dvbridge_fused1.h implementation. */
 static struct pl_hook_res pack_active_area(void *priv, const struct pl_hook_params *p)
 {
@@ -161,11 +163,12 @@ static struct pl_hook_res pack_active_area(void *priv, const struct pl_hook_para
         "if(float(p.x)<active_area.x || float(p.x)>=active_area.z || float(p.y)<active_area.y || float(p.y)>=active_area.w) color=vec4(0,0,0,1);\n"
         "vec3 self_rgb=clamp(color.rgb,0.0,1.0);\n"
         "vec3 peer_rgb=subgroupQuadSwapHorizontal(self_rgb);\n"
-        "vec3 a=(p.x&1)==0?self_rgb:peer_rgb, b=(p.x&1)==0?peer_rgb:self_rgb;\n"
-        "float ya=dot(a,vec3(.2627,.6780,.0593)), yb=dot(b,vec3(.2627,.6780,.0593));\n"
-        "uint y=uint(floor(256.0+3504.0*((p.x&1)==0?ya:yb)+.5));\n"
-        "float cb=2048.0+3584.0*((a.b-ya)+(b.b-yb))/(2.0*1.8814);\n"
-        "float cr=2048.0+3584.0*((a.r-ya)+(b.r-yb))/(2.0*1.4746);\n"
+        /* Hades: the chroma of a pair is that of its even pixel, as in pack_gles300.frag */
+        "vec3 s=self_rgb, a=(p.x&1)==0?self_rgb:peer_rgb;\n"
+        "float ys=dot(s,vec3(.2627,.6780,.0593)), ya=dot(a,vec3(.2627,.6780,.0593));\n"
+        "uint y=uint(floor(256.0+3504.0*ys+.5));\n"
+        "float cb=2048.0+3584.0*(a.b-ya)/1.8814;\n"
+        "float cr=2048.0+3584.0*(a.r-ya)/1.4746;\n"
         "uint c=uint(floor(((p.x&1)==0?cb:cr)+.5));\n"
         "uint index=uint(p.y*3840+p.x), packet=index/3072u;\n"
         "if(packet<dv_count){ uint bit=index%1024u, word=packet*32u+bit/32u;\n"
diff --git a/tools/dvbridge/pack_gles300.frag b/tools/dvbridge/pack_gles300.frag
index c07bfbd..ff32219 100644
--- a/tools/dvbridge/pack_gles300.frag
+++ b/tools/dvbridge/pack_gles300.frag
@@ -25,14 +25,20 @@ void main()
 {
     ivec2 p = ivec2(gl_FragCoord.xy);
     if (flip_y != 0u) p.y = 2159 - p.y;
-    ivec2 q = ivec2(p.x & ~1, p.y);
-    vec3 a = clamp(texelFetch(pq_input, q, 0).rgb, 0.0, 1.0);
-    vec3 b = clamp(texelFetch(pq_input, q + ivec2(1, 0), 0).rgb, 0.0, 1.0);
+    // Hades: the luma of each pixel is its own; the chroma of a pair of pixels is that of its even
+    // pixel. 4:2:2 over HDMI is co-sited: a receiver puts the chroma of a pair on its even pixel.
+    // The picture has its chroma samples where the stream has them (dvbridge_gl_frame_import()):
+    // with the left or top-left siting of HEVC, on the even pixels, where the scaler (Lanczos)
+    // keeps each sample as it is. The mean of the two pixels was half a pixel to the right of
+    // where the receiver puts it, and blurred. (A filter centred on the even pixel would reach
+    // past the pair, which the direct way, dvbridge_render.c, cannot.)
+    vec3 s = clamp(texelFetch(pq_input, p, 0).rgb, 0.0, 1.0);
+    vec3 a = clamp(texelFetch(pq_input, ivec2(p.x & ~1, p.y), 0).rgb, 0.0, 1.0);
+    float ys = dot(s, vec3(.2627, .6780, .0593));
     float ya = dot(a, vec3(.2627, .6780, .0593));
-    float yb = dot(b, vec3(.2627, .6780, .0593));
-    uint y = uint(floor(256.0 + 3504.0 * ((p.x & 1) == 0 ? ya : yb) + .5));
-    float cb = 2048.0 + 3584.0 * ((a.b - ya) + (b.b - yb)) / (2.0 * 1.8814);
-    float cr = 2048.0 + 3584.0 * ((a.r - ya) + (b.r - yb)) / (2.0 * 1.4746);
+    uint y = uint(floor(256.0 + 3504.0 * ys + .5));
+    float cb = 2048.0 + 3584.0 * (a.b - ya) / 1.8814;
+    float cr = 2048.0 + 3584.0 * (a.r - ya) / 1.4746;
     uint c = uint(floor(((p.x & 1) == 0 ? cb : cr) + .5));
     uint index = uint(p.y * 3840 + p.x);
     uint packet = index / 3072u;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index aee7295..347f44e 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -515,13 +515,14 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   // was not shown may have started one)
   dvbridge_render_set_frame_period(m_renderer, base.duration);
   dvbridge_gl_frame bl{}, el{};
-  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes))
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
     return Fail("base-layer-import");
   double elPts = std::numeric_limits<double>::quiet_NaN();
   if (enhancement)
   {
     if (dvbridge_gl_frame_import(&el, m_gl->gpu, enhancement->layout, enhancement->width,
-                                 enhancement->height, enhancement->planes))
+                                 enhancement->height, enhancement->planes, enhancement->chroma))
     {
       bl.frame.enhancement_layer = &el.frame;
       elPts = enhancement->pts;
@@ -782,6 +783,7 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancemen
   layer.width = enhancement->width;
   layer.height = enhancement->height;
   layer.pts = static_cast<double>(enhancement->pts);
+  layer.chroma = enhancement->chroma_location;
   for (int i = 0; i < 3; ++i)
     layer.planes[i] = imported.planes[i];
   bool result = Prepare(base, &layer, metadata, geometry, allowPacked);
@@ -893,7 +895,8 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
   const CKeptGLState kept;
   TakeStaleGLErrors("a picture is reconstructed");
   dvbridge_gl_frame bl{}, el{};
-  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes))
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
   {
     m_convertFailed += again ? 0 : 1;
     return Fail("base-layer-import");
@@ -919,7 +922,8 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
     mapped = dvbridge_dmabuf_import_cached(m_layerCache, &imported, enhancement);
     if (mapped)
       layered = dvbridge_gl_frame_import(&el, m_gl->gpu, imported.layout, enhancement->width,
-                                         enhancement->height, imported.planes);
+                                         enhancement->height, imported.planes,
+                                         enhancement->chroma_location);
     if (layered)
     {
       bl.frame.enhancement_layer = &el.frame;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 96313a6..a89583f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -31,6 +31,8 @@ public:
     //! Hades: the duration of a frame of the stream, in the units of pts; 0 when not known
     //! (dvbridge_set_frame_period())
     double duration;
+    //! Hades: where the chroma samples of the picture are (dvbridge_gl_frame_import())
+    AVChromaLocation chroma = AVCHROMA_LOC_UNSPECIFIED;
   };
 
   CDVBridgeGLES() = default;
