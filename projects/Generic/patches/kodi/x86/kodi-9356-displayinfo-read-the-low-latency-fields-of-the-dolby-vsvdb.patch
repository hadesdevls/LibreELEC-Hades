From 956025dad622e3925f2b2b601fa893ecdd89847c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 15:23:21 +0000
Subject: [PATCH] DisplayInfo: read the low-latency fields of the Dolby VSVDB

Dolby Vision Low-Latency (source-led, "player-led") is the only Dolby
Vision some displays take: a TV input in its game mode (the LG C5 then
advertises interface 0), or a TV that never had the Standard mode (a
Sony of 2020 in a user's report advertises a version 2 block with
interface 0). In that mode the source maps the picture to the display
that the block describes and sends it as YCbCr 4:2:2 12-bit. Before any
of that can be designed or measured, Kodi has to know what the display
says of it; until now it read only whether the block advertises the
Standard mode.

ScanDolbyVideo() now also reads, from the same raw bytes and with the
formulas of libdisplay-info 0.4.0 (cta.c, the Dolby video block):

- version 2 (12 bytes or more): low latency (every version 2 block has
  it), LL-HDMI (interface 1 or 3) and its 4:4:4 depth, the YUV 4:2:2
  12-bit bit, global dimming, backlight control and its minimum, the
  black and the peak of the target display as 12-bit PQ levels
  (20 * code and 2055 + 65 * code), and its primaries;
- version 1 in its 12-byte form: low latency with the low-latency field
  at 1 (the value that already means the Dolby vendor InfoFrame for the
  Standard mode; libdisplay-info reads bit 0 alone), the target black
  and peak in cd/m2 and the primaries of that form.

PqLevelToNits() gives the cd/m2 of a 12-bit PQ level (SMPTE ST 2084
EOTF of level / 4095), and the display information in the log gets one
line with what the display offers for low latency, so that a report
from a display like the Sony says what it would be mapped to.

Nothing decides by these fields yet: SupportsLowLatencyDolbyVision() and
GetDolbyVideoBlock() are not called, and the fields of before (valid,
version, length, display management, standard, 2160p60) are read as
they were.

Tested on the host against libdisplay-info 0.4.0 compiled from the
build tree: every value of each payload byte of version 2 and 12-byte
version 1 blocks over four patterns, 400000 random blocks and 300000
mutated EDIDs (182446 version 2 and 121410 version 1 blocks compared
field by field, 53801 with the reserved 4:4:4 value that libdisplay-info
rejects), the fields of before against the base branch on 735851 EDIDs,
PqLevelToNits() against an independent inverse EOTF at every level, and
the EDIDs of the user's LG C5, of the LG C5 of issue 1, of the Sony
and of the LG C5 game-mode block against values decoded by hand: no
failure. Thirteen mutations of the reading are all caught.
---
 xbmc/utils/DisplayInfo.cpp | 74 ++++++++++++++++++++++++++++++++++++++
 xbmc/utils/DisplayInfo.h   | 37 +++++++++++++++++++
 2 files changed, 111 insertions(+)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 0a17669..cd11eca 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -12,6 +12,7 @@
 #include "utils/log.h"
 
 #include <algorithm>
+#include <cmath>
 #include <iterator>
 
 extern "C"
@@ -78,15 +79,52 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
         result.version = data[4] >> 5;
         if (result.version == 1 || result.version == 2)
           result.dmVersion = ((data[4] >> 2) & 7) + 2;
+        // The payload after the OUI (data[4] on) as libdisplay-info 0.4.0 reads it (cta.c, the
+        // Dolby video block), which it calls data[0] to data[6]
+        const uint8_t* p = data + 4;
         if (result.version == 2 && len >= 11)
         {
           result.standard = (data[6] & 3) >= 2;
           result.at2160p60 = true;
+          // Low latency is the mode of every version 2 block; the interface field (p[2], bits 1
+          // and 0) adds LL-HDMI with 1 or 3 and the Standard mode with 2 or 3.
+          result.lowLatency = true;
+          result.lowLatencyHdmi = (p[2] & 1) != 0;
+          const unsigned int yuv444 = ((p[3] & 1u) << 1) | (p[4] & 1u);
+          result.lowLatency444Bits = yuv444 == 1 ? 10 : yuv444 == 2 ? 12 : 0;
+          result.yuv422At12Bits = (p[0] & 1) != 0;
+          result.backlightControl = (p[0] & 2) != 0;
+          result.globalDimming = (p[1] & 4) != 0;
+          result.backlightMinNits = 25 + (p[1] & 3u) * 25;
+          result.targetMinPq = 20 * (p[1] >> 3u);
+          result.targetMaxPq = 2055 + 65 * (p[2] >> 3u);
+          result.redX = 0.625 + (p[5] >> 3) / 256.0;
+          result.redY = 0.25 + (p[6] >> 3) / 256.0;
+          result.greenX = (p[3] >> 1) / 256.0;
+          result.greenY = 0.5 + (p[4] >> 1) / 256.0;
+          result.blueX = 0.125 + (p[5] & 7) / 256.0;
+          result.blueY = 0.03125 + (p[6] & 7) / 256.0;
         }
         else if (result.version == 1 && len == 11)
         {
           result.standard = (data[7] & 3) == 1 && result.dmVersion >= 4;
           result.at2160p60 = (data[4] & 2) != 0;
+          // The low-latency field (p[3], bits 1 and 0) at 1: low latency next to the Standard mode
+          // (libdisplay-info reads bit 0 alone; with 3, neither this rule nor the Standard one
+          // above takes the block)
+          result.lowLatency = (data[7] & 3) == 1;
+          result.yuv422At12Bits = (p[0] & 1) != 0;
+          result.globalDimming = (p[1] & 1) != 0;
+          result.targetMaxNits = (p[1] >> 1) * 50.0 + 100;
+          const double lm = (p[2] >> 1) / 127.0;
+          result.targetMinNits = lm * lm;
+          // The primaries of the 12-byte form, in steps of 1/256 from their minimum
+          result.redX = 0.625 + (p[6] >> 3) / 256.0;
+          result.redY = 0.25 + (((p[6] & 7u) << 2) | ((p[5] & 1u) << 1) | (p[4] & 1u)) / 256.0;
+          result.greenX = (p[4] >> 1) / 256.0;
+          result.greenY = 0.5 + (p[5] >> 1) / 256.0;
+          result.blueX = 0.125 + (p[3] >> 5) / 256.0;
+          result.blueY = 0.03125 + ((p[3] >> 2) & 7u) / 256.0;
         }
       }
       pos += len + 1;
@@ -141,6 +179,18 @@ bool ScanUhd420Only(const std::vector<uint8_t>& edid)
 }
 } // namespace
 
+double KODI::UTILS::PqLevelToNits(unsigned int level)
+{
+  // SMPTE ST 2084 EOTF, with the level of a 12-bit signal over 4095
+  constexpr double m1 = 2610.0 / 16384;
+  constexpr double m2 = 2523.0 / 4096 * 128;
+  constexpr double c1 = 3424.0 / 4096;
+  constexpr double c2 = 2413.0 / 4096 * 32;
+  constexpr double c3 = 2392.0 / 4096 * 32;
+  const double e = std::pow(std::min(level, 4095u) / 4095.0, 1 / m2);
+  return 10000 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1 / m1);
+}
+
 void CDisplayInfo::DiInfoDeleter::operator()(di_info* p)
 {
   di_info_destroy(p);
@@ -282,6 +332,30 @@ void CDisplayInfo::LogInfo() const
     CLog::Log(LOGINFO, "[display-info] dolby vision: not taken (an invalid EDID block, or several "
                        "Dolby Vision blocks)");
 
+  if (m_dolbyVideo.valid && m_dolbyVideo.lowLatency)
+  {
+    // Hades: what the display offers for Dolby Vision Low-Latency (read, not used)
+    const DolbyVideoBlock& dv = m_dolbyVideo;
+    const bool pq = dv.version == 2;
+    const double black = pq ? PqLevelToNits(dv.targetMinPq) : dv.targetMinNits;
+    const double peak = pq ? PqLevelToNits(dv.targetMaxPq) : dv.targetMaxNits;
+    std::string hdmi;
+    if (dv.lowLatencyHdmi)
+      hdmi = dv.lowLatency444Bits ? StringUtils::Format(", LL-HDMI (4:4:4 at {} bits)",
+                                                        dv.lowLatency444Bits)
+                                  : std::string(", LL-HDMI");
+    CLog::Log(LOGINFO,
+              "[display-info] dolby vision low-latency: YCbCr 4:2:2 12-bit{}; target {:.4f} to "
+              "{:.1f} cd/m2{}; primaries r {:.4f},{:.4f} g {:.4f},{:.4f} b {:.4f},{:.4f}; "
+              "backlight control: {}",
+              hdmi, black, peak,
+              pq ? StringUtils::Format(" (PQ {} to {})", dv.targetMinPq, dv.targetMaxPq)
+                 : std::string(),
+              dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY,
+              dv.backlightControl ? StringUtils::Format("yes, from {} cd/m2", dv.backlightMinNits)
+                                  : std::string("no"));
+  }
+
   if (m_hdr_static_metadata)
   {
     CLog::Log(LOGINFO, "[display-info] supports hdr static metadata type1: {}",
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index f326cf8..4cce2d7 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -63,8 +63,37 @@ struct DolbyVideoBlock
   unsigned int dmVersion = 0; //!< display management version (version 1 and 2 blocks)
   bool standard = false; //!< Dolby Vision Standard with the Dolby vendor InfoFrame
   bool at2160p60 = false;
+
+  //! Hades: Dolby Vision Low-Latency (source-led), read for information only (nothing decides by
+  //! it). The source maps the picture to the display described below and sends it as YCbCr 4:2:2
+  //! 12-bit with the low-latency bit of the Dolby vendor InfoFrame. A version 2 block of 12 bytes
+  //! or more always has it (its interface field adds the Standard mode and LL-HDMI to it); a
+  //! 12-byte version 1 block has it with the low-latency field 1, the value that also means the
+  //! Dolby vendor InfoFrame for the Standard mode.
+  bool lowLatency = false;
+  //! Version 2, interface 1 or 3: also LL-HDMI, low latency as RGB or YCbCr 4:4:4 at the depth of
+  //! lowLatency444Bits (libdisplay-info names the two fields mode_low_latency_hdmi and yuv444)
+  bool lowLatencyHdmi = false;
+  unsigned int lowLatency444Bits = 0; //!< version 2: 0 (none, or the reserved value), 10 or 12
+  bool yuv422At12Bits = false; //!< versions 1 and 2: the YUV 4:2:2 12-bit bit of the block
+  bool globalDimming = false; //!< versions 1 and 2
+  bool backlightControl = false; //!< version 2: the source may send backlight metadata
+  unsigned int backlightMinNits = 0; //!< version 2: 25, 50, 75 or 100 cd/m2
+  //! The display the source maps to: its black and its peak. Version 2 gives them as 12-bit PQ
+  //! signal levels (targetMinPq, targetMaxPq); version 1 in cd/m2 (targetMinPq and targetMaxPq 0).
+  unsigned int targetMinPq = 0;
+  unsigned int targetMaxPq = 0;
+  double targetMinNits = 0; //!< version 1 only; for version 2, PqLevelToNits(targetMinPq)
+  double targetMaxNits = 0; //!< version 1 only; for version 2, PqLevelToNits(targetMaxPq)
+  //! Its primaries, CIE 1931 xy of red, green and blue (version 2, and version 1 in its 12-byte
+  //! form), all 0 when not read
+  double redX = 0, redY = 0, greenX = 0, greenY = 0, blueX = 0, blueY = 0;
 };
 
+//! Hades: cd/m2 of a 12-bit PQ signal level (SMPTE ST 2084 EOTF of level / 4095), as the Dolby
+//! VSVDB gives the black and the peak of its target display
+double PqLevelToNits(unsigned int level);
+
 class CDisplayInfo
 {
 public:
@@ -105,6 +134,12 @@ public:
   {
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version < 2;
   }
+  //! Hades: the display takes Dolby Vision Low-Latency (DolbyVideoBlock::lowLatency), with or
+  //! without the Standard mode. Read for information only.
+  bool SupportsLowLatencyDolbyVision() const
+  {
+    return m_dolbyVideo.valid && m_dolbyVideo.lowLatency;
+  }
   //! Dolby Vision Low-Latency only: a version 2 block of 12 bytes or more without the Standard
   //! interface, what a TV input in its game mode advertises.
   bool SupportsLowLatencyDolbyVisionOnly() const
@@ -112,6 +147,8 @@ public:
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version == 2 &&
            m_dolbyVideo.length >= 11;
   }
+  //! Hades: the Dolby VSVDB as it was read (valid false without exactly one in valid EDID blocks)
+  const DolbyVideoBlock& GetDolbyVideoBlock() const { return m_dolbyVideo; }
   //! An HDR TV input in its HDMI 1.4 compatibility mode (LG "HDMI Deep Colour" off, and the like
   //! of other makers): the EDID offers 2160p at 50 and 60 Hz only as YCbCr 4:2:0 and has no HDMI
   //! Forum block, although an HDR TV has inputs for the full HDMI 2.0 rate.
-- 
2.53.0

