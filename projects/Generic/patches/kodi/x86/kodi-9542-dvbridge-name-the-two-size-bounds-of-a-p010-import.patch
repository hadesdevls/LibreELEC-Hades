From 71c040a15a960878d3f8a2f67fc528a8de21b714 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:47:21 +0000
Subject: [PATCH] [DVBridge] Name the two size bounds of a P010 import

dvbridge_dmabuf.c checked a picture against 3840x2160 and the layout of its surface against
4096x2304, written as bare numbers in two places, which read as two limits for the same picture
(the review of the code inherited from the fork took them for a mismatch). They are two sizes: the
picture (source->width/height) goes out in the transport and is imported up to its size, and the
surface of the decoder's pool that holds it (hw_frames_ctx, checked to be at least the picture)
can be larger, aligned to the blocks of the codec, and its layout is checked up to 4096x2304, the
bound of the fork's first version. Narrowing that one to the picture's size could refuse a 2160p
picture held in an aligned surface.

Named, with why: DVBRIDGE_DMABUF_PICTURE_MAX_* and DVBRIDGE_DMABUF_SURFACE_MAX_*. The values do not
change, nor does anything that runs.
---
 tools/dvbridge/dvbridge_dmabuf.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_dmabuf.c b/tools/dvbridge/dvbridge_dmabuf.c
index 21eabd9..ae2c91c 100644
--- a/tools/dvbridge/dvbridge_dmabuf.c
+++ b/tools/dvbridge/dvbridge_dmabuf.c
@@ -44,9 +44,21 @@ static void describe_layout(const AVDRMFrameDescriptor *desc)
              desc && desc->nb_objects > 0 ? (unsigned long long)desc->objects[0].format_modifier : 0ULL);
 }
 
+/* Hades: two sizes that are not the same thing. A picture is imported up to the size of the
+ * transport that it goes out in (3840x2160, dvbridge_dmabuf_import_cached()); the surfaces of the
+ * decoder's pool that hold it (hw_frames_ctx, at least the size of the picture) can be larger,
+ * aligned to the blocks of the codec, so the layout of a surface is checked up to 4096x2304, as in
+ * the fork's first version. Written as two numbers each, they looked like two limits for the same
+ * picture. */
+#define DVBRIDGE_DMABUF_PICTURE_MAX_WIDTH 3840
+#define DVBRIDGE_DMABUF_PICTURE_MAX_HEIGHT 2160
+#define DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH 4096
+#define DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT 2304
+
 bool dvbridge_dmabuf_validate_p010(const AVDRMFrameDescriptor *desc, int width, int height)
 {
-    if (!desc || width < 1 || width > 4096 || height < 1 || height > 2304 ||
+    if (!desc || width < 1 || width > DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH || height < 1 ||
+        height > DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT ||
         desc->nb_layers != 2 || desc->nb_objects < 1 || desc->nb_objects > AV_DRM_MAX_PLANES)
         return false;
     for (int i = 0; i < 2; ++i) {
@@ -268,7 +280,8 @@ bool dvbridge_dmabuf_import_cached(struct dvbridge_dmabuf_cache *cache, struct d
 {
     if (!out || out->mapping || !source || source->format != AV_PIX_FMT_VAAPI ||
         !source->hw_frames_ctx || source->width < 1 || source->height < 1 ||
-        source->width > 3840 || source->height > 2160) {
+        source->width > DVBRIDGE_DMABUF_PICTURE_MAX_WIDTH ||
+        source->height > DVBRIDGE_DMABUF_PICTURE_MAX_HEIGHT) {
         snprintf(last_error, sizeof(last_error), "frame format=%d size=%dx%d", source ? source->format : -1,
                  source ? source->width : 0, source ? source->height : 0);
         return false;
-- 
