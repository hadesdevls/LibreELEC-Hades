From 1e0eecda49c22acebb1acbf30a1999a8c30e061e Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Mon, 12 Oct 2026 11:24:22 +0100
Subject: [PATCH] [Games] Name the file an emulator is missing when it can't
 load a game

A game whose emulator can't find its BIOS was reported as an internal
error in the emulator, as GAME_ERROR_FAILED was all a game client could
return.

Game API 8.3.0 adds GAME_ERROR_MISSING_FILES and a ReportMissingFile()
callback, which a client calls with the file it looked for and couldn't
find. Kodi then names that file, or says it's missing files such as BIOS
files when it wasn't told which. ReportMissingFile() does nothing with an
older Kodi, so the minimum stays 8.2.0.
---
 .../resources/strings.po                      | 14 ++++++++-
 .../include/kodi/addon-instance/Game.h        | 17 ++++++++++
 .../include/kodi/c-api/addon-instance/game.h  | 11 +++++++
 .../kodi-dev-kit/include/kodi/versions.h      |  2 +-
 xbmc/games/addons/GameClient.cpp              | 31 +++++++++++++++++++
 xbmc/games/addons/GameClient.h                |  2 ++
 xbmc/games/addons/GameClientTranslator.cpp    |  2 ++
 7 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index efa92cf..9eef351 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -19256,7 +19256,19 @@ msgctxt "#35239"
 msgid "Integer (square pixels)"
 msgstr ""
 
-#empty strings from id 35240 to 35248
+#. Error dialog text when an emulator can't find a file it needs, such as a BIOS file. {0:s} - emulator name, {1:s} - file name
+#: xbmc/games/addons/GameClient.cpp
+msgctxt "#35240"
+msgid "The emulator \"{0:s}\" couldn't find {1:s}."
+msgstr ""
+
+#. Error dialog text when an emulator can't find files it needs and doesn't say which. {0:s} - emulator name
+#: xbmc/games/addons/GameClient.cpp
+msgctxt "#35241"
+msgid "The emulator \"{0:s}\" couldn't find files it needs, such as BIOS files."
+msgstr ""
+
+#empty strings from id 35242 to 35248
 
 #. Button to open the savestate manager from the game OSD
 #: addons/skin.estuary/xml/GameOSD.xml
diff --git a/xbmc/addons/kodi-dev-kit/include/kodi/addon-instance/Game.h b/xbmc/addons/kodi-dev-kit/include/kodi/addon-instance/Game.h
index d6f134a..fa042e9 100644
--- a/xbmc/addons/kodi-dev-kit/include/kodi/addon-instance/Game.h
+++ b/xbmc/addons/kodi-dev-kit/include/kodi/addon-instance/Game.h
@@ -424,6 +424,23 @@ public:
   void CloseGame(void) { m_instanceData->toKodi->CloseGame(m_instanceData->toKodi->kodiInstance); }
   //----------------------------------------------------------------------------
 
+  //============================================================================
+  /// @brief **Callback to Kodi Function**\n
+  /// Name a file the game client looked for and couldn't find, such as a
+  /// BIOS file, so Kodi can tell the user which one is missing.
+  ///
+  /// @param[in] path The file's path, relative to the system directory
+  ///
+  /// @remarks Call it before returning @ref GAME_ERROR_MISSING_FILES. It does
+  ///          nothing with a Kodi older than game API 8.3.0.
+  ///
+  void ReportMissingFile(const std::string& path)
+  {
+    if (IsInstanceAPIVersionAtLeast(8, 3, 0))
+      m_instanceData->toKodi->ReportMissingFile(m_instanceData->toKodi->kodiInstance, path.c_str());
+  }
+  //----------------------------------------------------------------------------
+
   //============================================================================
   /// @brief **Callback to Kodi Function**\n
   /// Get the speed the game is being played back at
diff --git a/xbmc/addons/kodi-dev-kit/include/kodi/c-api/addon-instance/game.h b/xbmc/addons/kodi-dev-kit/include/kodi/c-api/addon-instance/game.h
index ac75a99..fef9e11 100644
--- a/xbmc/addons/kodi-dev-kit/include/kodi/c-api/addon-instance/game.h
+++ b/xbmc/addons/kodi-dev-kit/include/kodi/c-api/addon-instance/game.h
@@ -50,6 +50,9 @@ extern "C"
 
     /// @brief Game requires restricted resources
     GAME_ERROR_RESTRICTED,
+
+    /// @brief The game client couldn't find files it needs, such as BIOS files
+    GAME_ERROR_MISSING_FILES,
   } GAME_ERROR;
   //----------------------------------------------------------------------------
 
@@ -1636,6 +1639,14 @@ extern "C"
      * must release the handle; Kodi calls HwContextDestroy before teardown.
      */
     bool (*StartStream)(KODI_HANDLE, KODI_GAME_STREAM_HANDLE);
+
+    /*!
+     * @brief Name a file the game client looked for and couldn't find.
+     *
+     * Call it before returning GAME_ERROR_MISSING_FILES. The path is relative
+     * to the client's system directory. Since game API 8.3.0.
+     */
+    void (*ReportMissingFile)(KODI_HANDLE kodiInstance, const char* path);
   } AddonToKodiFuncTable_Game;
 
   /*!
diff --git a/xbmc/addons/kodi-dev-kit/include/kodi/versions.h b/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
index 08d044f..242a82d 100644
--- a/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
+++ b/xbmc/addons/kodi-dev-kit/include/kodi/versions.h
@@ -97,7 +97,7 @@
 #define ADDON_INSTANCE_VERSION_AUDIOENCODER_DEPENDS   "c-api/addon-instance/audioencoder.h" \
                                                       "addon-instance/AudioEncoder.h"
 
-#define ADDON_INSTANCE_VERSION_GAME                   "8.2.1"
+#define ADDON_INSTANCE_VERSION_GAME                   "8.3.0"
 #define ADDON_INSTANCE_VERSION_GAME_MIN               "8.2.0"
 #define ADDON_INSTANCE_VERSION_GAME_XML_ID            "kodi.binary.instance.game"
 #define ADDON_INSTANCE_VERSION_GAME_DEPENDS           "c-api/addon-instance/game.h" \
diff --git a/xbmc/games/addons/GameClient.cpp b/xbmc/games/addons/GameClient.cpp
index 8670abc..0c1ba53 100644
--- a/xbmc/games/addons/GameClient.cpp
+++ b/xbmc/games/addons/GameClient.cpp
@@ -213,6 +213,7 @@ bool CGameClient::Initialize(void)
   m_ifc.game->toKodi->kodiInstance = this;
   m_ifc.game->toKodi->EnableHardwareRendering = cb_enable_hardware_rendering;
   m_ifc.game->toKodi->CloseGame = cb_close_game;
+  m_ifc.game->toKodi->ReportMissingFile = cb_report_missing_file;
   m_ifc.game->toKodi->GetPlaybackSpeed = cb_get_playback_speed;
   m_ifc.game->toKodi->SetGameTiming = cb_set_game_timing;
   m_ifc.game->toKodi->OpenStream = cb_open_stream;
@@ -323,6 +324,8 @@ bool CGameClient::OpenFile(const CFileItem& file,
 
   const auto loadGame = [this, &path]()
   {
+    m_missingFile.clear();
+
     GAME_ERROR loadError = GAME_ERROR_FAILED;
     try
     {
@@ -607,6 +610,18 @@ void CGameClient::NotifyError(GAME_ERROR error)
             CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(35211),
             missingResource)});
   }
+  else if (error == GAME_ERROR_MISSING_FILES)
+  {
+    const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+    // Failed to play game
+    // The emulator "%s" couldn't find %s, a file it needs.
+    // The emulator "%s" couldn't find files it needs, such as BIOS files.
+    MESSAGING::HELPERS::ShowOKDialogText(
+        CVariant{35210},
+        CVariant{m_missingFile.empty()
+                     ? StringUtils::Format(strings.Get(35241), Name())
+                     : StringUtils::Format(strings.Get(35240), Name(), m_missingFile)});
+  }
   else
   {
     // Failed to play game
@@ -671,6 +686,8 @@ void CGameClient::CloseFile()
 {
   std::unique_lock lock(m_critSection);
 
+  m_missingFile.clear();
+
   if (m_bIsPlaying)
   {
     // While the client is still up, so the cheats can be switched off on it
@@ -1076,6 +1093,20 @@ void CGameClient::cb_close_game(KODI_HANDLE kodiInstance)
                                              static_cast<void*>(new CAction(ACTION_STOP)));
 }
 
+void CGameClient::cb_report_missing_file(KODI_HANDLE kodiInstance, const char* path)
+{
+  CGameClient* gameClient = static_cast<CGameClient*>(kodiInstance);
+  if (gameClient == nullptr || path == nullptr)
+    return;
+
+  CLog::Log(LOGWARNING, "GameClient: {} couldn't find {}", gameClient->ID(), path);
+
+  // The first file is the one to name, as clients often look for a file under several names
+  std::unique_lock lock(gameClient->m_critSection);
+  if (gameClient->m_missingFile.empty())
+    gameClient->m_missingFile = path;
+}
+
 double CGameClient::cb_get_playback_speed(KODI_HANDLE kodiInstance)
 {
   CGameClient* gameClient = static_cast<CGameClient*>(kodiInstance);
diff --git a/xbmc/games/addons/GameClient.h b/xbmc/games/addons/GameClient.h
index 56967a3..b8fc61f 100644
--- a/xbmc/games/addons/GameClient.h
+++ b/xbmc/games/addons/GameClient.h
@@ -269,6 +269,7 @@ private:
   static bool cb_enable_hardware_rendering(void* kodiInstance,
                                            const game_hw_rendering_properties* properties);
   static void cb_close_game(KODI_HANDLE kodiInstance);
+  static void cb_report_missing_file(KODI_HANDLE kodiInstance, const char* path);
   static double cb_get_playback_speed(KODI_HANDLE kodiInstance);
   static void cb_set_game_timing(KODI_HANDLE kodiInstance, const game_system_timing* timingInfo);
   static bool cb_start_stream(KODI_HANDLE kodiInstance, KODI_GAME_STREAM_HANDLE stream);
@@ -372,6 +373,7 @@ private:
   // stopped the game before it started.
   std::atomic<double> m_playbackSpeed{1.0};
   std::string m_gamePath;
+  std::string m_missingFile; // The first file the client reported missing while loading
   bool m_bRequiresGameLoop = false;
   mutable size_t m_serializeSize = 0;
   IGameInputCallback* m_input = nullptr; // The input callback passed to OpenFile()
diff --git a/xbmc/games/addons/GameClientTranslator.cpp b/xbmc/games/addons/GameClientTranslator.cpp
index c48ba4a..76a27c0 100644
--- a/xbmc/games/addons/GameClientTranslator.cpp
+++ b/xbmc/games/addons/GameClientTranslator.cpp
@@ -29,6 +29,8 @@ const char* CGameClientTranslator::ToString(GAME_ERROR error)
       return "no game is loaded";
     case GAME_ERROR_RESTRICTED:
       return "the required resources are restricted";
+    case GAME_ERROR_MISSING_FILES:
+      return "files the client needs are missing";
     default:
       break;
   }
