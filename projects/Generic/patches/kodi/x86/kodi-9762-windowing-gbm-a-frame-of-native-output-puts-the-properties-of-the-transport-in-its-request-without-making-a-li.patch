From 7acb67c137d60718ffa027938671ac641f7c61e3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:19:13 +0000
Subject: [PATCH] windowing/gbm: a frame of native output puts the properties
 of the transport in its request without making a list of them

PutInRequest() is called for every frame of native output, and for every
frame that is committed again where no vblank paces the picture
(FlipDVBridgeAgain()). For a frame it took CSnapshot::Transport(): a new
vector of the changes, each with a copy of the name of its property. On
nvidia-drm the transport sets some 25 properties, most of them with names
longer than the buffer that a string keeps in itself
(NV_PLANE_LMS_TO_ITP_CTM, NV_CRTC_REGAMMA_DIVISOR...): some twenty
allocations for each frame, on the thread that draws, where the code that
it replaced added the properties from what it kept.

CSnapshot::ForEachTransport() gives each property that the transport sets
with its value, from the entries of the capture, and the request takes
them as they are; the restoration, made once, keeps its plan. A test on
the host gives the same properties and values as Transport() and counts
no allocation.
---
 xbmc/windowing/gbm/drm/OutputHandover.cpp | 16 ++++++++++++----
 xbmc/windowing/gbm/drm/OutputState.h      | 10 ++++++++++
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
index 38e1b27..4d13c53 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.cpp
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -660,8 +660,19 @@ bool COutputHandover::PutInRequest(CDRMAtomic& drm, bool handBack)
   // sets: it changes in the same commit as the mode (given back, it goes with the rest)
   if (!handBack && m_hdmi14b && m_driver == Driver::NVIDIA_DRM && !NameModeInSignal(drm))
     return false;
+  bool allAdded = true;
+  if (!handBack)
+  {
+    // (with each frame of the transport: nothing is made for it, the request takes the values)
+    m_snapshot.ForEachTransport(
+        [&](OS::Role role, const std::string& name, uint64_t value)
+        {
+          allAdded = drm.AddProperty(objects[static_cast<int>(role)], name.c_str(), value) &&
+                     allAdded;
+        });
+    return allAdded;
+  }
   std::vector<OS::Change> changes;
-  if (handBack)
   {
     OS::CLibdrmKms kms(m_fd);
     auto plan = m_snapshot.PlanRestore(kms);
@@ -694,9 +705,6 @@ bool COutputHandover::PutInRequest(CDRMAtomic& drm, bool handBack)
     }
     changes = std::move(plan.changes);
   }
-  else
-    changes = m_snapshot.Transport();
-  bool allAdded = true;
   for (const auto& change : changes)
     allAdded = drm.AddProperty(objects[static_cast<int>(change.role)], change.name.c_str(),
                                change.value) &&
diff --git a/xbmc/windowing/gbm/drm/OutputState.h b/xbmc/windowing/gbm/drm/OutputState.h
index bee9296..5af443e 100644
--- a/xbmc/windowing/gbm/drm/OutputState.h
+++ b/xbmc/windowing/gbm/drm/OutputState.h
@@ -557,6 +557,16 @@ public:
     return changes;
   }
 
+  //! The same, with nothing made: add(role, name, value) for each property that the transport sets,
+  //! for the request of each of its frames
+  template<typename Add>
+  void ForEachTransport(Add&& add) const
+  {
+    for (const auto& entry : m_entries)
+      if (entry.transport)
+        add(entry.role, entry.info.name, entry.transportValue);
+  }
+
   //! A value of the transport that changes while it is on (the InfoFrame that names a mode)
   bool SetTransport(Role role,
                     std::string_view name,
-- 
