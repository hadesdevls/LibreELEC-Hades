+  // Hades: Dolby Vision made from HDR10+ or measured is that for native output only (Open())
+  if ((m_dvFromHdr10Plus || m_dvMeasured) && !m_dvNativeOutput)
     pVideoPicture->hdrType = StreamHdrType::HDR_TYPE_HDR10;
 #endif
 
@@ -2163,6 +2200,8 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
     // Hades: made from the picture's own HDR10+ metadata (FFmpeg makes none of an RPU there is not)
     else if (m_dvFromHdr10Plus)
       MakeHdr10PlusMetadata(pVideoPicture);
+    else if (m_dvMeasured)
+      MakeMeasuredMetadata(pVideoPicture);
 #endif
   }
 
