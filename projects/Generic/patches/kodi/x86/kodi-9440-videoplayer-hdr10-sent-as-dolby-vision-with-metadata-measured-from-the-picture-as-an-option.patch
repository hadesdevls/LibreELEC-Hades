+// Hades: a picture of HDR10 measured as Dolby Vision, queued for presentation: mapped and given to the
+// measurement now, so that what it shows is known before it is shown (once a picture)
+void CRendererVAAPIGLES::MeasureAhead(int idx)
+{
+  if (idx < 0 || idx >= NUM_BUFFERS)
+    return;
+  auto& buffer = m_buffers[idx];
+  if (!buffer.doviMeasured || buffer.doviMeasureQueued || !buffer.videoBuffer || !m_isVAAPIBuffer ||
+      m_vaapiFourcc != VA_FOURCC_P010 || m_textureTarget != GL_TEXTURE_2D ||
+      buffer.doviPts == DVD_NOPTS_VALUE)
+    return;
+  buffer.doviMeasureQueued = true;
+  auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+      CServiceBroker::GetWinSystem());
+  if (!window || !UploadTexture(idx))
+    return;
+  CDVBridgeGLES::Layer layer{};
+  layer.layout = DVBRIDGE_P010;
+  layer.width = m_sourceWidth;
+  layer.height = m_sourceHeight;
+  layer.chroma = buffer.doviChroma;
+  layer.pts = buffer.doviPts;
+  layer.duration = buffer.doviDuration;
+  for (int p = 0; p < 2; ++p)
+  {
+    const auto& plane = buffer.fields[FIELD_FULL][p];
+    layer.planes[p] = {plane.id, static_cast<int>(plane.texwidth),
+                      static_cast<int>(plane.texheight)};
+  }
+  window->DVMeasurePicture(layer);
+}
