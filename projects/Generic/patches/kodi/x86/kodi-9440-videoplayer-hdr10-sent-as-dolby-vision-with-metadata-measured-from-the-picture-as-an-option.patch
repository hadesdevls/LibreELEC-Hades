+              l1.area[2], l1.area[3]);
+  if (m_dvMeasureFrames % 240 == 0)
+    m_dvMeasureLate = m_dvMeasureCuts = 0;
+  if (!l1.measured || !metadata.Data())
+    return;
+  std::vector<uint8_t> copy(metadata.Data(), metadata.Data() + metadata.Size());
+  CDVMetadataBuffer made;
+  if (dvbridge_measured_apply(reinterpret_cast<AVDOVIMetadata*>(copy.data()), copy.size(), &l1) &&
+      made.Assign(copy.data(), copy.size()))
+    metadata = made;
+}
