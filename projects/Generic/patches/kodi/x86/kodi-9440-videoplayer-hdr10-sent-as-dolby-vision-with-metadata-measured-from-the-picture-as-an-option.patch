+// Hades: the metadata of a picture of HDR10 measured as Dolby Vision as it leaves the decoder: profile
+// 8.1 over the picture, the mastering display as the source range, level 1 from the static metadata
+// (dvbridge_measured_placeholder()). The window system makes its level 1, level 5 and scene refresh
+// from what it measures when the picture is presented (VideoPicture::doviMeasured). Without the
+// luminance of the mastering display there are none: the picture goes to the ordinary output.
+void CDVDVideoCodecFFmpeg::MakeMeasuredMetadata(VideoPicture* picture)
+{
+  if (m_dvMeasuredPlaceholder.empty() && picture->hasDisplayMetadata &&
+      picture->displayMetadata.has_luminance)
+  {
+    size_t size = 0;
+    AVDOVIMetadata* made = dvbridge_measured_placeholder(
+        &picture->displayMetadata, picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size);
+    if (made)
+      m_dvMeasuredPlaceholder.assign(reinterpret_cast<const uint8_t*>(made),
+                                     reinterpret_cast<const uint8_t*>(made) + size);
+    av_free(made);
+  }
+  if (!m_dvMeasuredPlaceholder.empty() &&
+      picture->doviMetadata.Assign(m_dvMeasuredPlaceholder.data(), m_dvMeasuredPlaceholder.size()))
+    picture->doviMeasured = true;
+}
