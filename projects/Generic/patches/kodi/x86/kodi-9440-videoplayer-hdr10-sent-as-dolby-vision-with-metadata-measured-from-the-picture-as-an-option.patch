+void CWinSystemGbmGLESContext::DVMeasuredMetadata(const CDVBridgeGLES::Layer& layer,
+                                                  CDVMetadataBuffer& metadata)
+{
+  if (!DVMeasureReady())
+    return;
+  // a jump of the video (a seek): what was measured of the pictures around it says nothing of the
+  // ones after it (the active area of the stream stays)
+  const double gap = layer.duration > 0 ? 24 * layer.duration : 0;
+  if (m_dvMeasuredPts != DVD_NOPTS_VALUE &&
+      (layer.pts < m_dvMeasuredPts || (gap > 0 && layer.pts > m_dvMeasuredPts + gap)))
