From 2ad30134b16894bd91d3fbbaba61425f89f49150 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:24:51 +0000
Subject: [PATCH] windowing/gbm: leave the GUI pass out also where the GUI is
 composited over HDR10 and HLG

The dirty-driven skip of the GUI pass (CDVGuiReuse) was for native Dolby Vision
output only. The HDR10/HLG composite of the GUI (m_guiCompositing with the GLES
renderer, which includes Dolby Vision rebuilt as HDR10) is the same arrangement:
the picture is drawn by RenderEx() and CompositeGui() puts the GUI over it from
its FBO every frame, so the FBO of the frame before is what drawing the GUI again
would put in it wherever no control is dirty. The video window and the video
control mark themselves dirty in every frame only where nothing does that for them
(GuiPassReusable()), and the skip needs the same facts as before: the setting,
an FBO of the output's size drawn into since it was made, no menus, no partial
redraws, no 3D, no subtitles or debug information over the picture, and a picture
drawn by RenderEx() in the frame before (now told by CRenderManager, not by
RenderDVBridge()).

The facts are the same for both paths and so is the <video><dvguireuse> switch;
the line of the reason is told for either ("HDR GUI:" for this one), and the
HDR composite has a line of its own every 10 s: its frames, and how many had the
GUI pass left out.

Host test (outside the tree): dvguireuse_test, both paths and the HDR line.
---
 .../VideoRenderers/RenderManager.cpp          |  8 ++-
 xbmc/windowing/gbm/DVGuiReuse.h               | 68 +++++++++++++------
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 37 ++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  4 ++
 4 files changed, 79 insertions(+), 38 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index bbfb166..a1129f4 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -722,8 +722,12 @@ void CRenderManager::Render(bool clear, DWORD flags, DWORD alpha, bool gui)
       // Hades: the GUI pass was left out (CWinSystemGbmGLESContext::GuiPassReusable()): it is the
       // one that updates the renderer's areas (a change of view mode, of the window), so it is
       // done here
-      if (!gui && window->GuiPassSkipped())
-        m_pRenderer->Update();
+      if (!gui)
+      {
+        window->NoteVideoDrawnInRenderEx();
+        if (window->GuiPassSkipped())
+          m_pRenderer->Update();
+      }
     }
 #endif
 #ifdef HAVE_DVBRIDGE
diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index 85faa12..2bfb229 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -19,22 +19,25 @@ namespace GBM
 {
 
 /*!
- * \brief When the GUI pass of a frame of native Dolby Vision output can be left out, and why the
- *        frames that have something over the picture have it
+ * \brief When the GUI pass of a frame whose GUI is composited over the picture from its FBO can
+ *        be left out (native Dolby Vision output, and the HDR10/HLG composite of the GUI, which
+ *        includes Dolby Vision rebuilt as HDR10), and why the frames that have something over the
+ *        picture have it
  *
  * Kodi leaves the GUI pass out of a frame when no control marked itself dirty (the dirty-driven
  * skip of CApplication::FrameMove()), but only where the video has a plane of its own
  * (IsRenderingVideoLayer()): with the video drawn by the render pass, the window of the video and
  * its control mark themselves dirty in every frame, so that the pass that draws the picture keeps
- * running. With native Dolby Vision output the picture is drawn by RenderEx(), after the GUI pass
- * and whatever it did, and the GUI goes over it from its FBO (CompositeGui()): the FBO of the
- * frame before holds, to the bit, what drawing the GUI again would put in it, wherever nothing
- * dirtied itself. Leaving the pass out (the walk of every control and its draw calls, on a GPU
- * that is also doing the packing) changes nothing that is sent to the display.
+ * running. Where the GUI is composited (native Dolby Vision output, HDR10 and HLG), the picture is
+ * drawn by RenderEx(), after the GUI pass and whatever it did, and the GUI goes over it from its
+ * FBO (CompositeGui()): the FBO of the frame before holds, to the bit, what drawing the GUI again
+ * would put in it, wherever nothing dirtied itself. Leaving the pass out (the walk of every
+ * control and its draw calls, on a GPU that is also doing the packing) changes nothing that is
+ * sent to the display.
  *
  * This class only decides, from facts the window system gathers, and counts. The facts that make
  * the content of the FBO something other than the last frame drawn are each a reason to draw:
- * the setting, an output that is not native Dolby Vision, a GUI that is not composited, an FBO
+ * the setting, a GUI that is not composited, an FBO
  * that was made after the last frame was drawn (or has not been drawn into yet), the menus in
  * Dolby Vision (their frames are made of the FBO), partial redraws (the FBO would hold only what
  * changed), stereoscopic 3D (two passes), overlays on the picture that are drawn in the GUI pass
@@ -50,7 +53,7 @@ public:
   struct Facts
   {
     bool setting = true; //!< advancedsettings.xml <video><dvguireuse>, on by default
-    bool native = false; //!< native Dolby Vision output is captured
+    bool native = false; //!< native Dolby Vision output is captured (not a reason: told in the log)
     bool compositing = false; //!< the GUI is composited (the FBO and the composite exist)
     bool fboReady = false; //!< the FBO is valid, of the size of the output
     bool menus = false; //!< the menus in Dolby Vision are on, or the setting is
@@ -68,7 +71,6 @@ public:
   {
     NONE, //!< the pass may be left out
     SETTING,
-    NOT_NATIVE,
     NO_COMPOSITE,
     FBO,
     MENUS,
@@ -83,8 +85,6 @@ public:
   {
     if (!f.setting)
       return Why::SETTING;
-    if (!f.native)
-      return Why::NOT_NATIVE;
     if (!f.compositing)
       return Why::NO_COMPOSITE;
     if (!f.fboReady)
@@ -112,8 +112,6 @@ public:
         return "nothing";
       case Why::SETTING:
         return "turned off in advancedsettings.xml (video/dvguireuse)";
-      case Why::NOT_NATIVE:
-        return "the output is not native Dolby Vision";
       case Why::NO_COMPOSITE:
         return "the GUI is not composited";
       case Why::FBO:
@@ -181,17 +179,38 @@ public:
 
   //! The reason that the last ask said no, told once when it changes (empty: nothing to tell)
   //! (an ask is made once a frame: a reason that lasts is not told again)
-  std::string Declined(Why why)
+  std::string Declined(Why why, bool native)
   {
-    if (m_told && why == m_lastAsked)
+    if (m_told && why == m_lastAsked && native == m_lastNative)
       return std::string();
     m_told = true;
     m_lastAsked = why;
+    m_lastNative = native;
+    const std::string path = native ? "DVBridge" : "HDR GUI";
     if (why == Why::NONE)
-      return "DVBridge: the GUI pass of a frame is left out where no control is dirty: the GUI "
-             "over the picture is the FBO of the frame before, the same bytes (video/dvguireuse)";
-    return std::string("DVBridge: the GUI pass is drawn in every frame: ") + Text(why) +
-           " (video/dvguireuse)";
+      return path + ": the GUI pass of a frame is left out where no control is dirty: the GUI "
+                    "over the picture is the FBO of the frame before, the same bytes "
+                    "(video/dvguireuse)";
+    return path + ": the GUI pass is drawn in every frame: " + Text(why) + " (video/dvguireuse)";
+  }
+
+  //! The HDR composite (not native Dolby Vision): a frame, and whether its GUI pass was left out
+  void HdrFrame(bool skipped)
+  {
+    ++m_hdrFrames;
+    m_hdrSkipped += skipped ? 1 : 0;
+  }
+
+  //! ... and the line of a span of it (empty where there were no frames)
+  std::string HdrLine()
+  {
+    if (!m_hdrFrames)
+      return std::string();
+    const std::string s = "HDR GUI: last span: " + std::to_string(m_hdrFrames) +
+                          " frames with the GUI composited over the picture, the GUI pass of " +
+                          std::to_string(m_hdrSkipped) + " of them left out (video/dvguireuse)";
+    m_hdrFrames = m_hdrSkipped = 0;
+    return s;
   }
 
   //! The counts of the span since the last line, and their text
@@ -215,12 +234,19 @@ public:
   }
 
   //! Forget what was asked: the output begins again
-  void Restart() { m_told = false; }
+  void Restart()
+  {
+    m_told = false;
+    m_hdrFrames = m_hdrSkipped = 0;
+  }
 
 private:
   Counts m_counts;
   Why m_lastAsked = Why::NONE;
+  bool m_lastNative = false;
   bool m_told = false; //!< the first ask of an output is told whatever it says
+  unsigned int m_hdrFrames = 0;
+  unsigned int m_hdrSkipped = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 569b0d0..9a0b920 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1920,6 +1920,9 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
     m_guiFboWidth = 0;
     m_guiFboHeight = 0;
     m_compositeShader.reset();
+    m_dvGuiReuse.Restart();
+    m_guiSeen = false;
+    m_guiReusing = false;
   }
 
   return m_guiCompositing;
@@ -1961,13 +1964,6 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
 
   m_guiWillRender = guiWillRender;
   m_guiReusing = false;
-#ifdef HAVE_DVBRIDGE
-  // Hades: what the GUI pass of a frame left out leaves to the frames that follow it is known only
-  // for native Dolby Vision output, whose frames are all seen by RenderDVBridge()
-  if (!m_dvState.Captured())
-    m_guiSeen = false;
-#endif
-
   int width = m_nWidth;
   int height = m_nHeight;
 
@@ -2029,6 +2025,22 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
       m_dvGuiReuse.Skipped();
   }
   DVGuiReuseTell();
+  // Hades: the HDR composite (not native output) is told in a line of its own
+  if (!m_dvState.Captured())
+  {
+    m_dvGuiReuse.HdrFrame(m_guiReusing);
+    const auto now = std::chrono::steady_clock::now();
+    if (m_guiHdrLogAt == std::chrono::steady_clock::time_point{})
+      m_guiHdrLogAt = now;
+    else if (now - m_guiHdrLogAt >= std::chrono::seconds(10))
+    {
+      m_guiHdrLogAt = now;
+      if (const std::string line = m_dvGuiReuse.HdrLine(); !line.empty())
+        CLog::Log(LOGINFO, "{}", line);
+    }
+  }
+  else
+    m_guiHdrLogAt = {};
 #endif
   // When GUI render is being skipped, leave the FBO bind/clear out: nothing
   // will draw into it this frame. The FBO's prior sRGB GUI content is
@@ -5336,7 +5348,6 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
                                             bool measuredPicture,
                                             unsigned int hdr10Plus)
 {
-  m_guiVideoNow = true; // (Hades: GuiPassReusable())
   m_dvFrame = false;
   m_dvRepeat = false;
   m_dvPrepared = {};
@@ -6178,13 +6189,9 @@ bool CWinSystemGbmGLESContext::GuiPassReusable() const
 
 void CWinSystemGbmGLESContext::DVGuiReuseTell()
 {
-  // once a frame, where native output is captured: what is told is a change of the reason
-  if (!m_dvState.Captured())
-  {
-    m_dvGuiReuse.Restart();
-    return;
-  }
-  const std::string text = m_dvGuiReuse.Declined(CDVGuiReuse::Check(GuiReuseFacts()));
+  // once a frame, where the GUI is composited: what is told is a change of the reason
+  const std::string text =
+      m_dvGuiReuse.Declined(CDVGuiReuse::Check(GuiReuseFacts()), m_dvState.Captured());
   if (!text.empty())
     CLog::Log(LOGINFO, "{}", text);
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 3ac40e8..f9f5bb9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -112,6 +112,9 @@ public:
   bool IsHdrComposite() const override { return m_guiCompositing; }
   bool GuiPassReusable() const override;
   bool GuiPassSkipped() const override { return m_guiReusing; }
+  //! Hades: the video was drawn by RenderEx() in this frame (CRenderManager::Render()): the GUI
+  //! pass is what draws a disc menu without a picture, and what updates an unconfigured renderer
+  void NoteVideoDrawnInRenderEx() { m_guiVideoNow = true; }
 #ifdef HAVE_DVBRIDGE
   static bool DVBridgeRequested(const VideoPicture* picture);
   //! Whether the configured video renderer draws its pictures natively; set before its output
@@ -453,6 +456,7 @@ private:
   //! Hades: RenderDVBridge() ran in this frame, and in the frame before it
   bool m_guiVideoNow{false};
   bool m_guiVideoLast{false};
+  std::chrono::steady_clock::time_point m_guiHdrLogAt{};
   CDVGuiReuse m_dvGuiReuse;
   CDVGuiReuse::Facts GuiReuseFacts() const;
   void DVGuiReuseTell();
-- 
