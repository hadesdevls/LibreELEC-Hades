diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 4bfe784..7978c6c 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -88,6 +88,14 @@ struct dvbridge_reading {
     /* Blocks of the content mapping v4.0 part of the metadata, left out for a display of display
      * management 2 or 3 (dvbridge_set_display_management()) */
     unsigned cm40_left_out;
+    /* Blocks of the v4.0 part left out of this frame because that part cannot be carried in this
+     * stream: a block of it could not be converted for the tunnel, or the payload would have been
+     * over 512 bytes with it (dvbridge_dv::cm40_dropped in dvbridge_metadata.h). The v4.0 part is
