+     * cm40_length of which block (its level, and its length in the RPU). */
+    unsigned cm40_dropped;
+    const char *cm40_why;
+    unsigned cm40_level, cm40_length;
     unsigned packets;     /* transport packets of the payload */
     bool scene_refresh;   /* the frame refreshes the scene */
     unsigned metadata_id;
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index d8a8d17..d1c40cd 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -33,6 +33,9 @@ struct dvbridge_dv_reading {
     /* Hades: blocks of the content mapping v4.0 part of the metadata (levels 3, 8 to 11 and 254),
      * left out for a display of an older display management (dvbridge_dv::cm29_only) */
     unsigned cm40_left_out;
+    /* Hades: blocks of the v4.0 part left out because that part cannot be carried in this stream
+     * (dvbridge_dv::cm40_dropped) */
+    unsigned cm40_dropped;
 };
 
 struct dvbridge_dv {
@@ -74,6 +77,19 @@ struct dvbridge_dv {
      * displays, defines levels 1, 2 and 5 and has the others reserved. Set for each frame from its
      * context (dvbridge_set_display_management()). */
     bool cm29_only;
+    /* Hades: the v4.0 part of the metadata is left out for the rest of the stream, as for a display
+     * of display management 2 or 3: a frame of it had a block of that part that cannot be carried
+     * (its bytes not kept by the decoder, or a length or a value that dvbridge_cm4_wire() does not
+     * take), or a payload that would be over the 512 bytes of CCM 001 with it. Refusing such a
+     * frame, as before, took native output away after 24 of them (CDVBridgeGLES::Fail(), the
+     * failure policy of the window system), for the whole title. The v2.9 part is what CCM 001
+     * defines, and it is never touched: with dovi_tool's most blocks (eight of level 2) it is 256
+     * bytes. It stays left out until the stream ends (dvbridge_dv_restart()), so that a display
+     * does not switch between the two mappings from scene to scene. cm40_why says why (a fixed
+     * text), cm40_level and cm40_length of which block (its level, and its length in the RPU). */
+    bool cm40_dropped;
+    const char *cm40_why;
+    unsigned cm40_level, cm40_length;
     /* Hades: the display is sent no trims (dvbridge_set_trims()): the blocks of levels 2 and 8 are
      * left out, and those of level 10, which only describe the targets of level 8 blocks. Kept from
      * one stream to the next (dvbridge_dv_restart()): it is the display's, not the stream's. */
@@ -342,7 +358,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             taken |= 1u << j;
     }
     d->reading.skipped = d->reading.skipped_level = 0;
-    d->reading.cm40_left_out = 0;
+    d->reading.cm40_left_out = d->reading.cm40_dropped = 0;
     d->size = 0;
     d->payload[d->size++] = 0;
     d->payload[d->size++] = repeat ? d->previous[1] : refresh ? 1 : c->scene_refresh_flag;
@@ -383,6 +399,11 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     d->payload[count_pos] = 0;
     d->blocks_at = count_pos;
     unsigned l1 = 0, area = 0, targets[AV_DOVI_MAX_EXT_BLOCKS], ntargets = 0;
+    /* Hades: where the v4.0 part begins in the payload, and how many of its blocks are written, to
+     * take it out again when one of its blocks cannot be carried (cm40_dropped). The blocks are in
+     * the order of their rank: every block of the v2.9 part comes before the v4.0 part. */
+    unsigned v40_size = 0, v40_count = 0, v40_written = 0;
+    bool v40_begun = false;
     const AVDOVIDmData *ordered[AV_DOVI_MAX_EXT_BLOCKS];
     unsigned order[AV_DOVI_MAX_EXT_BLOCKS];
     for(int i=0;i<m->num_ext_blocks;i++) {
@@ -430,20 +451,54 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             break;
         case 4: case 3: case 8: case 9: case 10: case 11: case 254: {
             /* Hades: the v4.0 part, for a display that does not read it (level 4 is of v2.9) */
-            if (d->cm29_only && e->level != 4) {
+            const bool v40 = e->level != 4;
+            if (v40 && d->cm29_only) {
                 d->reading.cm40_left_out++;
                 continue;
             }
+            /* ... and for the rest of a stream where that part cannot be carried */
+            if (v40 && d->cm40_dropped) {
+                d->reading.cm40_dropped++;
+                continue;
+            }
+            if (v40 && !v40_begun) {
+                v40_begun = true;
+                v40_size = d->size;
+                v40_count = d->payload[count_pos];
+            }
             uint8_t wire[32];
-            DV_REQUIRE(e->dvbridge_raw_magic==0x41424456);
-            int size=dvbridge_cm4_wire(e->level,e->dvbridge_original_bytes,e->dvbridge_original_length,wire);
-            if(size<0) {
-                fprintf(stderr,"DVBRIDGE_CM4_REJECT level=%d length=%u\n",e->level,e->dvbridge_original_length);
-                return false;
+            const bool kept = e->dvbridge_raw_magic == 0x41424456;
+            const int size = kept ? dvbridge_cm4_wire(e->level, e->dvbridge_original_bytes,
+                                                      e->dvbridge_original_length, wire) : -1;
+            /* (the level 5 block made for the raster, where the metadata have none, comes after
+             * this part: its room is kept, so that the v4.0 part never takes it) */
+            const unsigned room = DVBRIDGE_DV_MAX_PAYLOAD - (area ? 0 : 13);
+            const unsigned blocks = AV_DOVI_MAX_EXT_BLOCKS - (area ? 0 : 1);
+            const char *why =
+                !kept ? "its bytes were not kept by the decoder (a block of more than 32 bytes)"
+                : size < 0 ? "a length or a value that the conversion to the tunnel does not take"
+                : d->size + 5 + (unsigned)size > room
+                    ? "the payload would be over 512 bytes with it"
+                : d->payload[count_pos] + 1u > blocks ? "the payload would have more than 32 blocks"
+                : NULL;
+            if (why && !v40)
+                return false; /* (level 4 is of the v2.9 part, which is never left out) */
+            if (why) {
+                /* Hades: the v4.0 part is taken out of the payload again, and left out from here
+                 * on (cm40_dropped) */
+                d->size = v40_size;
+                d->payload[count_pos] = v40_count;
+                d->reading.cm40_dropped += v40_written + 1;
+                d->cm40_dropped = true;
+                d->cm40_why = why;
+                d->cm40_level = e->level;
+                d->cm40_length = e->dvbridge_original_length;
+                continue;
             }
-            DV_REQUIRE(d->size+5+size<=DVBRIDGE_DV_MAX_PAYLOAD);
             dvbridge_dv_u32(d,size);d->payload[d->size++]=e->level;
             memcpy(d->payload+d->size,wire,size);d->size+=size;d->payload[count_pos]++;
+            if (v40)
+                v40_written++;
             continue;
         }
         case 6: continue; /* Static HDR10 fallback, not dynamic DV wire data. */
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
