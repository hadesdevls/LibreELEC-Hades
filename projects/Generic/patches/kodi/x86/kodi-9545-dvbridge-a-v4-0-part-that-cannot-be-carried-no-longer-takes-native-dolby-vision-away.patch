+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -130,6 +130,10 @@ public:
     //! Hades: the v4.0 part of its content mapping was left out for a display of display
     //! management 2 or 3: that version (0: nothing was left out)
     unsigned int cm29For = 0;
+    //! Hades: ... or because that part cannot be carried in this stream (a block of it that the
+    //! conversion for the tunnel does not take, or a payload over 512 bytes with it): left out
+    //! until the stream ends (dvbridge_dv::cm40_dropped)
+    bool cm40Dropped = false;
     int l1[3] = {-1, -1, -1}; //!< L1 min, avg, max as 12-bit PQ codes; -1 when absent
