From 6bd0f1a82c598d844d522b9248ac20a05d22ffd4 Mon Sep 17 00:00:00 2001
From: TristanInSec <tristan.mtn@gmail.com>
Date: Sat, 3 Oct 2026 12:05:43 +0200
Subject: [PATCH] cc_decoder: fix heap buffer overflow in cc_to_text

The text[] buffer is sized for one byte per cell (CC_ROWS*CC_COLUMNS+1
= 481), but get_char_override() can produce up to 3 bytes per cell for
UTF-8 characters. When enough cells contain multi-byte characters, the
write loop overflows the buffer by up to 974 bytes.

Fix: size the buffer to accommodate worst-case UTF-8 expansion (3
bytes per cell plus one newline per row), and add a safety check in
the write loop to stop before the buffer is exhausted.
---
 .../cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.c | 5 ++++-
 .../cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.h | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.c b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.c
index 487f42a..1a81702 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.c
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.c
@@ -488,6 +488,8 @@ void ccmem_tobuf(cc_decoder_t *dec)
           break;
       for (j = f; j <= l; j++)
       {
+        if (dec->textlen >= (int)sizeof(dec->text) - 4)
+          break;
         const char* chbytes =
             get_char_override(buf->rows[i].cells[j].charset, buf->rows[i].cells[j].c);
         if (chbytes != NULL)
@@ -503,7 +505,8 @@ void ccmem_tobuf(cc_decoder_t *dec)
           dec->text[dec->textlen++] = (unsigned char)buf->rows[i].cells[j].c;
         }
       }
-      dec->text[dec->textlen++] = '\n';
+      if (dec->textlen < (int)sizeof(dec->text) - 1)
+        dec->text[dec->textlen++] = '\n';
     }
   }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.h b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.h
index a2f5ae6..7ab0dad 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/contrib/cc_decoder.h
@@ -107,7 +107,7 @@ struct cc_decoder_s
 
   void *userdata;
   void(*callback)(int service, void *userdata);
-  char text[CC_ROWS*CC_COLUMNS + 1];
+  char text[CC_ROWS * CC_COLUMNS * 3 + CC_ROWS + 1];
   int textlen;
   cc_attribute_t textattr;
 };
-- 
