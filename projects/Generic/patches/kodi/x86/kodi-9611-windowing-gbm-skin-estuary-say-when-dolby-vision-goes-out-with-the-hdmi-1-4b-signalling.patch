+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -251,6 +251,10 @@ public:
    * native output that starts after it (BeginDVBridge()).
    */
   dvbridge_hdr10_mapping TakeDVLowLatencyMapping(const VideoPicture& picture);
+  //! Hades: native output started with the HDMI 1.4b signalling
+  //! (CDVBridgeState::CapturedHdmi14b()): the log says what goes out, and which setting to turn off
+  //! where the TV shows wrong colours
+  void TellHdmi14bStart() const;
   //! Outcome of one Dolby Vision frame; enough failures in a row fall back to the ordinary output.
   //! pts identifies the picture (DVD_NOPTS_VALUE if unknown): one drawn again counts once
   void DVBridgeFrameShown(bool shown, double pts);
