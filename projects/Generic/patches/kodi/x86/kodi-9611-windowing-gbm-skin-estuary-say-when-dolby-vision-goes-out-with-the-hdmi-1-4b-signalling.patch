diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index d068f14..1df73ed 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -547,6 +547,10 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         {
           m_dvSignalling = true;
           CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output started");
+          // Hades: with the older signalling, what goes out, and what to turn off where the TV
+          // does not take it (nothing here can tell)
+          if (m_dvState.CapturedHdmi14b())
+            TellHdmi14bStart();
           m_dvStats = {};
           m_dvStats.start = std::chrono::steady_clock::now();
           m_dvLastWindow = {};
@@ -3661,6 +3665,21 @@ std::string DescribeLevels(const std::map<unsigned int, unsigned int>& counts)
 }
 } // namespace
 
+void CWinSystemGbmGLESContext::TellHdmi14bStart() const
+{
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  const unsigned int vic = mode ? CDVBridgeState::Hdmi14bVic(*mode) : 0;
+  CLog::Log(LOGINFO,
+            "DVBridge: native Dolby Vision goes out with the older signalling, the HDMI 1.4b "
+            "vendor InfoFrame ({}, {}), because \"Dolby Vision with the older signalling (HDMI "
+            "1.4b)\" is on (System > Display) and the display asks for it. Whether the TV takes it "
+            "cannot be checked from here: if the TV shows wrong colours, turn that setting off",
+            vic ? StringUtils::Format("HDMI_VIC {}", vic) : std::string("no HDMI_VIC in this mode"),
+            m_dvState.CapturedBackend() == CDVBridgeState::Backend::NVIDIA
+                ? "given to nvidia-drm"
+                : "made by the kernel");
+}
+
 void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
 {
   const auto now = std::chrono::steady_clock::now();
@@ -3722,6 +3741,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.l5sent", ""}, {"hades.dv.l5origin", ""}, {"hades.dv.depth", ""},
       {"hades.dv.depthformat", ""}, {"hades.dv.depthwhy", ""},
       {"hades.dv.transport", ""}, {"hades.dv.signal", ""}, {"hades.dv.cmsent", ""},
+      {"hades.dv.vsif", ""},
       {"hades.dv.composer", ""},
       {"hades.dv.trims", ""}, {"hades.dv.origin", ""}, {"hades.dv.hdr10plus", ""}};
   // Hades: a picture rebuilt as HDR10 goes out with HDR10+ metadata measured from it
@@ -3839,6 +3859,9 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
                                                     : "";
     if (d.transport == 0)
       info["hades.dv.signal"] = d.signalColorSpace == 2 ? "ictcp" : "ycbcr";
+    // Hades: the older signalling, the HDMI 1.4b vendor InfoFrame, in place of the Dolby one
+    if (m_dvState.CapturedHdmi14b())
+      info["hades.dv.vsif"] = "hdmi14b";
   }
   if (converted)
     info["hades.dv.layers"] = m_dvConvertBridge->ConversionLayers();
