From 42deebc0b6c618fdac9871e408637726298d25e0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:47:15 +0000
Subject: [PATCH] OverlayRenderer: Blu-ray 3D menus are not shifted by the
 subtitles' sequence

Since the plane offsets of a 3D disc are read, SubtitleDepth() shifts every
overlay of the frame by the offset of the sequence the subtitle stream
follows: also the disc's own graphics (HDMV interactive graphics, and what
BD-J draws), which the subtitles.stereoscopicdepth setting placed before.
The interactive graphics of a disc follow an offset sequence of their own,
named in a part of the stereoscopic table whose layout is not public
(neither libbluray nor tsMuxer reads it), so lending them the subtitles'
sequence is a guess at a depth the disc did not ask for.

The images libbluray draws are marked as the disc's menu (the group that
carries them already was; the renderer sees them one by one), COverlay
carries the mark, and SubtitleDepth() gives such an overlay the setting, as
before the disc's depth was read. Subtitles, and every overlay of a title
that places nothing in depth, get the same shift as before.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp       |  5 +++++
 .../VideoPlayer/VideoRenderers/OverlayRenderer.cpp | 14 +++++++++++---
 .../VideoPlayer/VideoRenderers/OverlayRenderer.h   |  7 ++++++-
 3 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index fab9ab1..e5953d0 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1077,6 +1077,9 @@ void CDVDInputStreamBluray::OverlayCallback(const BD_OVERLAY * const ov)
   if (ov->img && ov->cmd == BD_OVERLAY_DRAW)
   {
     SOverlay overlay = std::make_shared<CDVDOverlayImage>();
+    // Hades: the graphics of the disc's menu, as the group that carries them says; the renderer
+    // sees them one by one, without the group (CRenderer::SubtitleDepth())
+    overlay->SetDiscMenu(true);
 
     if (ov->palette)
     {
@@ -1162,6 +1165,8 @@ void CDVDInputStreamBluray::OverlayCallbackARGB(const struct bd_argb_overlay_s *
   if (ov->argb && ov->cmd == BD_ARGB_OVERLAY_DRAW)
   {
     SOverlay overlay = std::make_shared<CDVDOverlayImage>();
+    // Hades: what BD-J draws, as for the menus above
+    overlay->SetDiscMenu(true);
 
     overlay->palette.clear();
     overlay->linesize = ov->w * 4;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
index ea5edd4..593bef9 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -406,14 +406,20 @@ void CRenderer::GetRenderState(COverlay* o, SRenderState& state) const
     state.y += lowerHalf ? before.y2 - after.y2 : before.y1 - after.y1;
   }
 
-  state.x += SubtitleDepth();
+  state.x += SubtitleDepth(*o);
 }
 
-float CRenderer::SubtitleDepth() const
+float CRenderer::SubtitleDepth(const COverlay& o) const
 {
   // The setting is what places a subtitle the title says nothing about - an external file,
   // a 2D disc, a stream that carries no depth of its own.
-  if (!m_subtitlePlaneOffset)
+  //
+  // Hades: and a disc's menu (its interactive graphics, or what BD-J draws), which the setting
+  // placed before the disc's depth was read. The offset sequence a disc gives its interactive
+  // graphics is a sequence of their own, named by a part of the playlist's stereoscopic table
+  // whose layout is not public (neither libbluray nor tsMuxer reads it), so it is not read; the
+  // one of the subtitles is not lent to them.
+  if (!m_subtitlePlaneOffset || o.m_isDiscMenu)
     return static_cast<float>(GetStereoscopicDepth());
 
   if (*m_subtitlePlaneOffset == 0 || m_rs.Width() <= 0.0f)
@@ -887,6 +893,8 @@ std::shared_ptr<COverlay> CRenderer::Convert(SElement& e)
   {
     CDVDOverlayImage& ovImage = static_cast<CDVDOverlayImage&>(o);
     r = COverlay::Create(ovImage, m_rs);
+    if (r)
+      r->m_isDiscMenu = o.IsDiscMenu();
     if (r && o.IsBitmapSubtitle())
     {
       r->m_isBitmapSubtitle = true;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
index 8a004d0..fe68d55 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
@@ -103,6 +103,8 @@ namespace OVERLAY {
     bool m_isHDROverlay{false};
     // Picture of subtitle text (PGS, VobSub), as opposed to e.g. menu graphics
     bool m_isBitmapSubtitle{false};
+    //! Hades: what a Blu-ray disc draws itself (menus, BD-J): CDVDOverlay::IsDiscMenu()
+    bool m_isDiscMenu{false};
     unsigned int m_subtitleStream{0};
     SContentInset m_contentInset;
 
@@ -258,8 +260,11 @@ namespace OVERLAY {
      * presented, in the video's own pixels, so that is scaled the same way the overlay is;
      * the subtitles.stereoscopicdepth setting answers for everything else. Either way it
      * is signed by the eye being drawn.
+     *
+     * \param o the overlay being placed. (Hades) The disc's answer is for its subtitle plane;
+     *          a menu the disc draws is placed by the setting (see the definition).
      */
-    float SubtitleDepth() const;
+    float SubtitleDepth(const COverlay& o) const;
     std::shared_ptr<COverlay> Convert(SElement& e);
     // Build a COverlay (cached or freshly created) from the libass output
     // already produced by PrepareOverlays. Does not call ass_render_frame.
-- 
