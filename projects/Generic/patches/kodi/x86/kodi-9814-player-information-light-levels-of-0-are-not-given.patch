+/*!
+ * \brief "1000 / 400 nits": the light levels MaxCLL / MaxFALL (of HDR static metadata, CTA-861.3, or of the
+ *        level 6 of a Dolby Vision RPU), where 0 is not given: "none" where both are (the skin says "not given",
+ *        Estuary #31834), and the word for the one that is ("1000 nits / not given")
+ * \param notGiven that word in the language of the interface (English by default)
+ */
+inline std::string LightLevelsText(unsigned int maxCll,
+                                   unsigned int maxFall,
+                                   const std::string& notGiven = "not given")
+{
+  if (!maxCll && !maxFall)
+    return "none";
+  if (maxCll && maxFall)
+    return std::to_string(maxCll) + " / " + std::to_string(maxFall) + " nits";
+  const auto part = [&notGiven](unsigned int nits)
+  { return nits ? std::to_string(nits) + " nits" : notGiven; };
+  return part(maxCll) + " / " + part(maxFall);
+}
