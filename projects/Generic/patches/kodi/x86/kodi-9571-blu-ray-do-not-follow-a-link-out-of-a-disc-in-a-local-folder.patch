From dfe51c17d3c27c5a95b7d4ce332bbdf6186031b0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:12:41 +0000
Subject: [PATCH] [Blu-ray] Do not follow a link out of a disc in a local
 folder

The Java (BD-J) code of a disc now runs in the isolated BD-J host, which
reaches the disc only through Kodi's libbluray callbacks
(CBlurayCallback::file_open and dir_open), and Kodi runs them as root. In
libbluray's files mode (the one Kodi uses for a BDMV folder) libbluray
does not know the folder of the disc, so it cannot check where a path
really leads; it asks only for relative paths without "..", and the host
is checked the same way. A symbolic link in a disc folder made for that,
to /storage say, would still have Kodi read for the disc's code what the
host cannot read itself.

For a disc in a local folder, what is opened now has to be, once its links
are resolved (realpath), the folder itself or under it, and the real path
that was checked is what is opened. A link that leads out is not
followed and is said in kodi.log. The URL of another filesystem (smb://,
nfs://, udf:// of a disc image) is not checked here: its own server
resolves its links, inside its share or image. Found by the isolated host
work (libbluray-9061).
---
 xbmc/filesystem/BlurayCallback.cpp | 65 +++++++++++++++++++++++++++++-
 1 file changed, 63 insertions(+), 2 deletions(-)

diff --git a/xbmc/filesystem/BlurayCallback.cpp b/xbmc/filesystem/BlurayCallback.cpp
index c6d9f12..e351f0a 100644
--- a/xbmc/filesystem/BlurayCallback.cpp
+++ b/xbmc/filesystem/BlurayCallback.cpp
@@ -12,9 +12,12 @@
 #include "FileItemList.h"
 #include "filesystem/Directory.h"
 #include "filesystem/File.h"
+#include "filesystem/SpecialProtocol.h"
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
+#include <cstdlib>
+#include <memory>
 #include <string_view>
 
 using namespace XFILE;
@@ -25,6 +28,56 @@ struct SDirState
   int curr = 0;
 };
 
+namespace
+{
+// Hades: the real path of a local file or folder, empty when it is not there or not local
+std::string RealLocalPath(const std::string& path)
+{
+  const std::string local = CSpecialProtocol::TranslatePath(path);
+  if (local.empty() || local.front() != '/')
+    return {};
+  const std::unique_ptr<char, decltype(&free)> real(realpath(local.c_str(), nullptr), &free);
+  return real ? std::string(real.get()) : std::string();
+}
+
+/*
+ * Hades: whether a file or folder that libbluray asks for by its path in the disc is in the disc.
+ *
+ * For a disc in a local folder (a BDMV folder on a disk, a USB drive, a mounted disc), the real
+ * path of what is opened has to be the folder itself or under it: a symbolic link in the folder
+ * that leads out of it is not followed. The Java (BD-J) code of a disc runs in the isolated BD-J
+ * host, which reaches the disc only through these callbacks, run by Kodi as root; a link to
+ * /storage in a folder made for that would otherwise read for the disc's code what the host
+ * cannot read itself. libbluray asks only for relative paths without "..", and checks the paths
+ * of the host the same way; this is the check that only Kodi can make, because only Kodi knows
+ * the folder (libbluray's files mode). The URL of another filesystem (smb://, nfs://, udf:// of a
+ * disc image...) is not a local path: its own server resolves its links, inside its share or
+ * image. What is opened is the real path that was checked.
+ */
+bool InsideDisc(const std::string& root, const std::string& path, std::string& open)
+{
+  open = path;
+  const std::string local = CSpecialProtocol::TranslatePath(root);
+  if (local.empty() || local.front() != '/')
+    return true;
+  const std::string realRoot = RealLocalPath(root);
+  const std::string realPath = RealLocalPath(path);
+  if (realRoot.empty() || realPath.empty())
+    return false;
+  // what is opened is the real path that was checked, not the link again
+  open = realPath;
+  if (realPath == realRoot)
+    return true;
+  const std::string prefix = realRoot == "/" ? realRoot : realRoot + "/";
+  if (realPath.compare(0, prefix.size(), prefix) == 0)
+    return true;
+  CLog::Log(LOGWARNING,
+            "CBlurayCallback - {} of the disc in {} leads out of it ({}), and is not opened",
+            CURL::GetRedacted(path), CURL::GetRedacted(root), CURL::GetRedacted(realPath));
+  return false;
+}
+} // namespace
+
 void CBlurayCallback::bluray_logger(const char* msg)
 {
   // Hades: libbluray says whether Blu-ray Java (BD-J) menus can run, and why not, only in lines
@@ -61,8 +114,12 @@ BD_DIR_H* CBlurayCallback::dir_open(void *handle, const char* rel_path)
 
   CLog::Log(LOGDEBUG, "CBlurayCallback - Opening dir {}", CURL::GetRedacted(strDirname));
 
+  std::string strOpen;
+  if (!InsideDisc(*strBasePath, strDirname, strOpen))
+    return nullptr;
+
   SDirState *st = new SDirState();
-  if (!CDirectory::GetDirectory(strDirname, st->list, "", DIR_FLAG_DEFAULTS))
+  if (!CDirectory::GetDirectory(strOpen, st->list, "", DIR_FLAG_DEFAULTS))
   {
     if (!CFile::Exists(strDirname))
       CLog::Log(LOGDEBUG, "CBlurayCallback - Error opening dir! ({})",
@@ -122,6 +179,10 @@ BD_FILE_H * CBlurayCallback::file_open(void *handle, const char *rel_path)
 
   std::string strFilename = URIUtils::AddFileToFolder(*strBasePath, strRelPath);
 
+  std::string strOpen;
+  if (!InsideDisc(*strBasePath, strFilename, strOpen))
+    return nullptr;
+
   BD_FILE_H *file = new BD_FILE_H;
 
   file->close = file_close;
@@ -132,7 +193,7 @@ BD_FILE_H * CBlurayCallback::file_open(void *handle, const char *rel_path)
   file->eof = file_eof;
 
   CFile* fp = new CFile();
-  if (fp->Open(strFilename))
+  if (fp->Open(strOpen))
   {
     file->internal = (void*)fp;
     return file;
-- 
