@@ -100,6 +100,11 @@ public:
   //! came (CDVDVideoCodecFFmpeg::AddData()): pictures and enhancement pictures of different
   //! counts are not paired by their times
   uintptr_t doviSourceEpoch = 0;
+  //! Hades: the video the picture is of (DVBRIDGE::VideoNumber() when the first packet came after its
+  //! decoder was opened or reset: CDVDVideoCodecFFmpeg::AddData()); 0 not known. The Dolby Vision bridge
