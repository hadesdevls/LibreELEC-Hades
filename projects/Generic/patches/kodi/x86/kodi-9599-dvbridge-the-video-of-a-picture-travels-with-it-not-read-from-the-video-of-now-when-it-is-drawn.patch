+  //! draws the picture
+  unsigned int doviVideo = 0;
   //! the picture is of a stream that is reconstructed and sent as HDR10 where it is not sent
   //! natively (DVBRIDGE::ConversionEligible())
   bool doviConvert = false;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 60bacde..8e2edbb 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -1048,6 +1048,18 @@ bool CDVDVideoCodecFFmpeg::AddData(const DemuxPacket &packet)
   if (!packet.pData)
     return true;
 
+#ifdef HAVE_DVBRIDGE
+  // Hades: the video of the pictures from here on, taken with the first packet after the decoder was opened
+  // or reset by the player. The player opens the next video (NewVideo()) after it flushed this stream, and
+  // its packets come after that, in order: a picture of the video before keeps the number of its video,
+  // also when it is drawn after the next one opened (dvbridge_cm40_video_of())
+  if (!m_dvVideoTaken)
+  {
+    m_dvVideo = DVBRIDGE::VideoNumber();
+    m_dvVideoTaken = true;
+  }
+#endif
+
   // Hades: a packet that comes after the decoder was drained in the middle of the stream (the
   // stream had run dry: CVideoPlayerVideo::Process()) waits until the decoder has given every
   // picture it held, and the decoder then starts again at the last random-access point, with the
@@ -1065,7 +1077,7 @@ bool CDVDVideoCodecFFmpeg::AddData(const DemuxPacket &packet)
 
   if (m_eof)
   {
-    Reset();
+    ResetWithin();
   }
 
   // Hades: the packets given again go first, one at a time as the decoder takes them; the packet
@@ -1227,7 +1239,7 @@ void CDVDVideoCodecFFmpeg::RestartAfterDrain()
   std::deque<CDrainRestart::Kept> kept = m_drainRestart.TakeKept();
   const double accessTime = m_drainRestart.AccessTime();
   const size_t count = kept.size();
-  Reset();
+  ResetWithin();
   m_drainRestart.GiveAgain(std::move(kept));
   const unsigned restarts = m_drainRestart.Restarts();
   if (restarts <= 10 || restarts % 100 == 0)
@@ -2057,7 +2069,7 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetBasePicture(VideoPicture* pVid
     CDVDVideoCodec::VCReturn ret = m_pHardware->Decode(m_pCodecContext, m_pFrame);
     if (ret == VC_FLUSHED)
     {
-      Reset();
+      ResetWithin();
       return ret;
     }
     else if (ret == VC_FATAL)
@@ -2166,12 +2178,25 @@ bool CDVDVideoCodecFFmpeg::SetPictureParams(VideoPicture* pVideoPicture)
   return true;
 }
 
+void CDVDVideoCodecFFmpeg::ResetWithin()
+{
+#ifdef HAVE_DVBRIDGE
+  const bool taken = m_dvVideoTaken;
+#endif
+  Reset();
+#ifdef HAVE_DVBRIDGE
+  m_dvVideoTaken = taken;
+#endif
+}
+
 void CDVDVideoCodecFFmpeg::Reset()
 {
   // Hades: nothing kept for a restart after a drain is of use after a flush (RestartAfterDrain()
   // takes what it gives again out before)
   m_drainRestart.Reset();
 #ifdef HAVE_DVBRIDGE
+  // (Hades: a reset by the player, a seek or another video: the next packet takes the video again)
+  m_dvVideoTaken = false;
   // (Hades: base pictures that went out without the layer since it last paired, which the reset
   // leaves where they are: said here, else nothing would say it)
   LogWithoutLayer("until the decoders were reset (a seek, or a restart of the stream)");
@@ -2470,6 +2495,7 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
                                      : m_pFrame->best_effort_timestamp;
   pVideoPicture->doviSourceTimed = m_pFrame->pts != AV_NOPTS_VALUE;
   pVideoPicture->doviSourceEpoch = reinterpret_cast<uintptr_t>(m_pFrame->opaque);
+  pVideoPicture->doviVideo = m_dvVideo;
   pVideoPicture->doviConvert = m_dvConvert;
   pVideoPicture->doviBaseIsPicture = DVBRIDGE::BaseLayerIsKnownPicture(
       m_hints.dovi.dv_profile, m_hints.dovi.dv_bl_signal_compatibility_id);
