   bool SendPacket(AVPacket* packet, const CDrainRestart::Info& info);
   //! Hades: the decoder starts again at the last random-access point after a drain (CDrainRestart)
   void RestartAfterDrain();
+  //! Hades: Reset() of the decoder's own, within the stream (after a drain, at the end of the stream, when the
+  //! hardware decoder flushed): the pictures after it are of the same video (VideoPicture::doviVideo)
+  void ResetWithin();
   //! Hades: an HEVC stream that goes on after its decoder was drained in the middle of it
   CDrainRestart m_drainRestart;
   //! Hades: HDR10+ across pictures without metadata of their own
@@ -98,6 +101,10 @@ protected:
   double m_dvPtsOffset{0};
   bool m_dvPtsOffsetKnown{false};
   uintptr_t m_dvEpoch{1};
+  //! Hades: the video the pictures are of (VideoPicture::doviVideo): DVBRIDGE::VideoNumber() when the first
+  //! packet came after the decoder was opened or reset by the player (m_dvVideoTaken)
+  unsigned int m_dvVideo{0};
+  bool m_dvVideoTaken{false};
   bool m_dvSoftware{false}; //!< the base layer is decoded in software: no enhancement layer
   unsigned int m_dvPaired{0}; //!< base pictures paired with their enhancement picture
   unsigned int m_dvLayerRpu{0}; //!< of them, those that took the RPU of that picture, another one
