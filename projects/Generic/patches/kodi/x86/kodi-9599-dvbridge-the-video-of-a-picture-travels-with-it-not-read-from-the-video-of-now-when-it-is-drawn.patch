-  if (!DVBRIDGE_LAYERS::FirstOfVideo(g_layersVideo, g_cm40Video.load()))
+  if (!DVBRIDGE_LAYERS::FirstOfVideo(g_layersVideo,
+                                      dvbridge_cm40_video_of(base.video, g_cm40Video.load())))
     return;
   DVBRIDGE_LAYERS::Shape enhancement;
   if (layer)
@@ -1798,11 +1804,13 @@ void CDVBridgeGLES::ReportLayers(const Layer& base,
                                       metadata.Size()));
 }
 
-void CDVBridgeGLES::Cm40Video(bool menus)
+void CDVBridgeGLES::Cm40Video(unsigned int picture, bool menus)
 {
   if (!m_renderer)
     return;
-  const unsigned int video = g_cm40Video.load();
+  // (the video of the picture, not the one of now: the last picture of a video drawn after the next
+  // one opened does not decide for it)
+  const unsigned int video = dvbridge_cm40_video_of(menus ? 0 : picture, g_cm40Video.load());
   // (the decision kept here, for a renderer made again within this video; dvbridge_set_cm40_video()
   // takes it only where the renderer's own is not of this video)
   dvbridge_render_set_cm40_video(m_renderer, video, menus,
