diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 325c555..2b287c9 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -108,6 +108,16 @@ struct dvbridge_cm40_decision {
  * video, through dvbridge_reset(). */
 void dvbridge_set_cm40_video(struct dvbridge_context *context, unsigned video, bool menus,
                              const struct dvbridge_cm40_decision *known);
+/* Hades: the video that a frame is of, for dvbridge_set_cm40_video(): the number that came with its picture (Kodi's
+ * VideoPicture::doviVideo, which the decoder takes with the first packet after it was opened or reset, in order with
+ * the packets of the stream), or, for a picture without one (0) and for the menus, the video of now. The count of
+ * now moves when the next video opens, on another thread than the one that draws: a picture of the video before
+ * drawn after that (the last one, drawn again until the renderer is flushed) would otherwise make the decision of
+ * the next video with its own RPU, and the next video would not make its own. */
+static inline unsigned dvbridge_cm40_video_of(unsigned picture, unsigned now)
+{
+    return picture ? picture : now;
+}
 /* Hades: the decision of the context (of its last committed frame); false where none is made */
 bool dvbridge_get_cm40_decision(const struct dvbridge_context *context, struct dvbridge_cm40_decision *decision);
 void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq);
