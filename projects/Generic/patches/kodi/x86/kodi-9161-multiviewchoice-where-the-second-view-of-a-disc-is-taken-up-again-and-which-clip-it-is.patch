From 1cdc3e5f5070ce228aa6d8d6e030edc366d1e160 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 02:44:06 +0000
Subject: [PATCH] MultiviewChoice: where the second view of a disc is taken up
 again, and which clip it is

The decoder of both views gets each picture of the second view in the packet of its base
view. Once a picture of the base view has gone on alone (the second view did not meet it in
time, the picture has no time, the clip was placed again), the second view of the pictures
that follow is predicted from one that the decoder never got. It decodes them all the same,
wrongly, and nothing says so.

What is decided about that, and about three other things that were taken on trust:

- IsAnchorOfSecondView() reads from an access unit of the second view whether it is an
  anchor picture: anchor_pic_flag in the header extension of its first NAL unit of type 20.
- Rejoin, WentAlone() and Offer(): after a picture that went on alone nothing is appended
  until an anchor picture, and of what follows the anchor in the stream, nothing that is
  shown before it. The wait ends after 300 pictures without an anchor: a stream that marks
  none gets its second view back as it comes. Before the first picture of a clip that goes
  on with its second view, and after a seek, everything is appended as it comes, as before.
- IsSecondViewSubPath(): of the sub-paths in the extension data of a playlist only the
  stereoscopic video (type 8) is the second view; 9 is the stereoscopic menu graphics.
- SecondViewClipOfAngle(): the clip of the angle that plays, and none where the sub play
  item has no clip for it.
- PlacedAgain(): a clip whose second view never meets the base view is placed again three
  times, not for as long as it plays.

Nothing uses them yet.
---
 xbmc/cores/VideoPlayer/MultiviewChoice.h | 205 ++++++++++++++++++++++-
 1 file changed, 202 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index c13673e..8f23019 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -538,11 +538,53 @@ constexpr BaseEye BaseEyeOfPlaylist(bool baseViewIsRight)
   return baseViewIsRight ? BaseEye::RIGHT : BaseEye::LEFT;
 }
 
-//! Access units of the second view that are read for one picture of the base view, after which
-//! that picture goes on without its second view. The clip of the second view is placed up to
-//! 13 seconds before the base view, which at 60 pictures a second is 780 of them.
+//! Reads of the clip of the second view for one picture of the base view, after which that
+//! picture goes on without its second view. A read gives an access unit of the second view or
+//! nothing of use. The clip is placed up to 13 seconds before the base view, which at 60
+//! pictures a second is 780 access units.
 inline constexpr unsigned int DISC_READS_PER_PICTURE = 1024;
 
+//! The type of the sub-path of a playlist that names the clips of the second view: the
+//! stereoscopic video. (Type 9 is the stereoscopic menu graphics, type 10 another layer.)
+inline constexpr unsigned int DISC_SUBPATH_SECOND_VIEW = 8;
+
+//! Whether a sub-path of that type names the second view
+constexpr bool IsSecondViewSubPath(unsigned int type)
+{
+  return type == DISC_SUBPATH_SECOND_VIEW;
+}
+
+/*!
+ * \brief Which of the clips of a sub play item is the second view of the angle that plays
+ * \param angle the angle that plays, counted from 0
+ * \param anglesOfPlayItem the clips of the play item, one for each of its angles
+ * \param clipsOfSubPlayItem the clips of the sub play item, one for each angle that it has
+ *
+ * A play item without the angle that plays shows its first one, as the library that plays the
+ * disc does. A sub play item without a clip for the angle that is shown has no second view
+ * for it: the clip of another angle is another picture.
+ */
+inline std::optional<size_t> SecondViewClipOfAngle(unsigned int angle,
+                                                   size_t anglesOfPlayItem,
+                                                   size_t clipsOfSubPlayItem)
+{
+  const size_t shown = angle < anglesOfPlayItem ? angle : 0;
+  if (shown >= clipsOfSubPlayItem)
+    return std::nullopt;
+  return shown;
+}
+
+//! Times that the clip of the second view is placed again at the base view without the two
+//! meeting in between, after which the clip is left alone: its base view plays, until a seek,
+//! a flush or another clip
+inline constexpr unsigned int DISC_PLACEMENTS_WITHOUT_PAIR = 3;
+
+//! Whether the clip of the second view is placed once more
+constexpr bool PlacedAgain(unsigned int placedWithoutPair)
+{
+  return placedWithoutPair < DISC_PLACEMENTS_WITHOUT_PAIR;
+}
+
 //! @}
 
 /*!
@@ -740,5 +782,162 @@ inline bool GiveUp(uint64_t paired,
 
 //! @}
 
+/*!
+ * \name The second view of a disc, picture by picture
+ * @{
+ */
+
+/*!
+ * \brief Whether an access unit of the second view is an anchor picture
+ * \param data the access unit as a transport stream carries it: NAL units behind start codes
+ *        of three or four bytes
+ *
+ * An anchor picture is predicted from the base view of its own access unit and from nothing
+ * else, and no picture that is shown after it refers to one that was decoded before it. It is
+ * where the second view can be taken up again after a gap.
+ *
+ * The slices of the second view are NAL units of type 20. Behind the byte of the NAL unit
+ * header they have three bytes more: svc_extension_flag (1 bit, 0 for a view), non_idr_flag
+ * (1), priority_id (6), view_id (10), temporal_id (3), anchor_pic_flag (1), inter_view_flag
+ * (1) and one bit that is reserved. The first such unit of the access unit decides. An access
+ * unit without one, or whose unit ends before the flag, is not known to be an anchor.
+ */
+inline bool IsAnchorOfSecondView(const uint8_t* data, size_t size)
+{
+  constexpr int NAL_SLICE_EXTENSION = 20;
+  if (!data)
+    return false;
+
+  for (size_t i = 0; i + 3 < size; ++i)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+      continue;
+    // (a start code of four bytes is one of three behind a zero)
+    size_t pos = i + 3;
+    if ((data[pos] & 0x80) || (data[pos] & 0x1f) != NAL_SLICE_EXTENSION)
+    {
+      i += 2;
+      continue;
+    }
+
+    // The three bytes, without a byte that the stream inserts behind two zeros so that no
+    // start code stands inside a unit: with a view_id below 4 the first two are zero.
+    uint8_t extension[3] = {};
+    unsigned int zeros = 0;
+    ++pos;
+    for (uint8_t& byte : extension)
+    {
+      if (zeros >= 2 && pos < size && data[pos] == 3)
+      {
+        ++pos;
+        zeros = 0;
+      }
+      if (pos >= size)
+        return false;
+      byte = data[pos++];
+      zeros = byte == 0 ? zeros + 1 : 0;
+    }
+    if (extension[0] & 0x80)
+      return false;
+    return (extension[2] & 0x04) != 0;
+  }
+  return false;
+}
+
+//! Pictures of the base view that go on alone while an anchor picture of the second view is
+//! waited for, after which the second view is appended again as it comes (12 seconds of film;
+//! a stream marks an anchor every second or two)
+inline constexpr unsigned int DISC_ALONE_UNTIL_RESUMED = 300;
+
+/*!
+ * \brief What is remembered between the pictures of a clip about appending its second view
+ *
+ * The decoder of both views gets each picture of the second view in the packet of its base
+ * view. When a picture of the base view has gone on alone, the second view of the pictures
+ * that follow is predicted from one that the decoder never got: it would decode them, wrongly,
+ * and nothing would say so. So nothing is appended from then on until an anchor picture of the
+ * second view, and of what comes behind the anchor in the stream, nothing that is shown before
+ * it (such a picture may still refer to one from before the gap).
+ *
+ * The first pictures of a clip, and those after a seek, are appended as they come: the base
+ * view starts there on a picture that everything behind it is decoded from.
+ */
+struct Rejoin
+{
+  bool paired{false}; //!< a picture went on with its second view since the clip was opened or sought
+  bool waiting{false}; //!< pictures went on alone since: nothing is appended before an anchor
+  bool behind{false}; //!< appended again from an anchor: what is shown before it goes on alone
+  int64_t anchorTime{NO_TIME}; //!< the presentation time of that anchor
+  unsigned int alone{0}; //!< pictures that went on alone since the wait began
+};
+
+//! What is done with a picture of the base view whose second view is at hand
+enum class Join
+{
+  APPEND, //!< the second view is appended
+  APPEND_AT_ANCHOR, //!< ... again, from this anchor picture on
+  APPEND_UNANCHORED, //!< ... again, though no anchor came: the wait is over
+  ALONE, //!< the base view goes on alone, and its second view is dropped
+};
+
+/*!
+ * \brief A picture of the base view went on without its second view (none met it in time, it
+ *        has no time, or the two could not be put together)
+ *
+ * Before the first picture of a clip that goes on with its second view, and after a seek,
+ * that changes nothing.
+ */
+inline void WentAlone(Rejoin& state)
+{
+  if (!state.paired)
+    return;
+  if (!state.waiting)
+    state.alone = 0;
+  state.waiting = true;
+  state.behind = false;
+  state.anchorTime = NO_TIME;
+  ++state.alone;
+}
+
+/*!
+ * \brief What is done with a picture of the base view whose second view is at hand
+ * \param anchor that access unit of the second view is an anchor picture (IsAnchorOfSecondView())
+ * \param time the presentation time of the picture
+ */
+inline Join Offer(Rejoin& state, bool anchor, int64_t time)
+{
+  if (state.waiting)
+  {
+    if (anchor)
+    {
+      state.waiting = false;
+      state.behind = true;
+      state.anchorTime = time;
+      return Join::APPEND_AT_ANCHOR;
+    }
+    if (state.alone >= DISC_ALONE_UNTIL_RESUMED)
+    {
+      state.waiting = false;
+      return Join::APPEND_UNANCHORED;
+    }
+    ++state.alone;
+    return Join::ALONE;
+  }
+  if (state.behind)
+  {
+    if (time != NO_TIME && state.anchorTime != NO_TIME && time < state.anchorTime)
+    {
+      ++state.alone;
+      return Join::ALONE;
+    }
+    // a picture that is shown after the anchor: none that is shown before it follows
+    state.behind = false;
+  }
+  state.paired = true;
+  return Join::APPEND;
+}
+
+//! @}
+
 } // namespace MULTIVIEW
 } // namespace KODI
-- 
