+    // the decoder: on the graphics card (hw) or on the processor (sw), and the interface that names it
+    if (!cache.GetVideoDecoderName().empty())
+    {
+      const bool hardware = cache.IsVideoHwDecoder();
+      info["hades.video.decoding"] = hardware ? "hw" : "sw";
