   return "mismatch";
 }
 
+// ---- the decoder
+
+/*!
+ * \brief The interface that a hardware decoder is named after: "VAAPI", "DRM PRIME", "VDPAU", "NVDEC",
+ *        or empty (the name says none). The name is what Kodi gives (Player.Process(videodecoder):
+ *        "ff-hevc-vaapi", "hevc-drm_prime"...).
+ */
+inline std::string DecoderApi(const std::string& name)
+{
+  std::string lower = name;
+  for (auto& c : lower)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  if (lower.find("vaapi") != std::string::npos)
+    return "VAAPI";
+  if (lower.find("drm_prime") != std::string::npos || lower.find("drmprime") != std::string::npos)
+    return "DRM PRIME";
+  if (lower.find("vdpau") != std::string::npos)
+    return "VDPAU";
+  if (lower.find("nvdec") != std::string::npos || lower.find("cuvid") != std::string::npos)
+    return "NVDEC";
+  return "";
+}
+
 // ---- the badges
 
 //! "Dolby Vision · FEL", "Dolby Vision · P8.1", "HDR10+", "HDR10", "HLG", "SDR"
