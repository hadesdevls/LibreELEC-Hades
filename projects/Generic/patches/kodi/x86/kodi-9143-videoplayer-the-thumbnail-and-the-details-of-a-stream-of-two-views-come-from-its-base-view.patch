From ffed74e75c638bfcd4de99cc6fe749598f63ef89 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] VideoPlayer: the thumbnail and the details of a stream of two
 views come from its base view

What extracts a thumbnail and what reads the details of a picture open a
decoder from the stream as the demuxer describes it. For a stream marked
as two views that was the decoder of both: the thumbnail became two
pictures squeezed side by side where it was one eye, decoded with up to
16 threads; and where that decoder gave the second view up, the reopening
that it asks for is something these callers do not do, so that no
thumbnail was made where there was one.

Both ask for the base view, as before.
---
 xbmc/cores/VideoPlayer/DVDFileInfo.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
index 5c79e62..3f4b06a 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
@@ -317,6 +317,9 @@ std::unique_ptr<CTexture> CDVDFileInfo::ExtractThumbToTexture(const CFileItem& f
 
     CDVDStreamInfo hint(*demuxer->GetStream(demuxerId, nVideoStream), true);
     hint.codecOptions = CODEC_FORCE_SOFTWARE;
+    // Hades: of a stream of two views (KODI::MULTIVIEW) the base view is decoded here, as it
+    // always was: a thumbnail is one eye, not two pictures side by side
+    hint.multiview = false;
 
     std::unique_ptr<CDVDVideoCodec> pVideoCodec =
         CDVDFactoryCodec::CreateVideoCodec(hint, *pProcessInfo);
@@ -468,6 +471,8 @@ static bool GetDetailsFromFrame(CDemuxStreamVideo* stream,
 
   CDVDStreamInfo hint(*stream, true);
   hint.codecOptions = CODEC_FORCE_SOFTWARE;
+  // Hades: ... and so is what is read of a picture of the stream (see above)
+  hint.multiview = false;
 
   std::unique_ptr<CDVDVideoCodec> videoCodec =
       CDVDFactoryCodec::CreateVideoCodec(hint, *processInfo);
