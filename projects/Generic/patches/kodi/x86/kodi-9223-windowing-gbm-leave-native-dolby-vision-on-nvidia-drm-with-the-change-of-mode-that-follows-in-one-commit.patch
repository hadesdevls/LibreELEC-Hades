+bool CWinSystemGbmEGLContext::VideoOutputKeepsSurface(const VideoPicture* picture)
+{
+  const EGLConfig config = m_eglContext.GetEGLConfig();
+  const uint32_t current = m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID);
+  const bool chosen = ChooseEGLConfig(m_renderableType, VideoOutputBitDepth(picture));
+  const uint32_t format = m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID);
+  // Only asked: the config stays the one of the surface in use, for SetVideoOutput() to compare
+  // what it picks with.
+  m_eglContext.SetEGLConfig(config);
+  return chosen && format == current;
+}
