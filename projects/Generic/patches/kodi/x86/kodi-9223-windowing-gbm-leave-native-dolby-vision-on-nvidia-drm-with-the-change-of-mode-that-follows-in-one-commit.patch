+bool CWinSystemGbm::DVModeChangeJoins(const CDVBridgeState& state, const RESOLUTION_INFO& res) const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !drm->IsActive() || !state.Captured() ||
+      state.CapturedBackend() != CDVBridgeState::Backend::NVIDIA)
+    return false;
+  // The window and its buffer stay as they are: a mode of their size, and not a 3D output.
+  if (res.iWidth != m_nWidth || res.iHeight != m_nHeight ||
+      (res.dwFlags & (D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) != 0)
+    return false;
+  const CDRMConnector* connector = drm->GetConnector();
+  const drmModeModeInfo* now = drm->GetSelectedMode();
+  const int index = std::atoi(res.strId.c_str());
+  if (!connector || !now || index < 0 || index >= connector->GetModesCount())
+    return false;
+  // Another mode: with the same one there is no change of mode to wait for, and the output is
+  // restored as one whose mode stays.
+  const drmModeModeInfo& next = *connector->GetModeForIndex(index);
+  return next.clock != now->clock || next.hdisplay != now->hdisplay ||
+         next.hsync_start != now->hsync_start || next.hsync_end != now->hsync_end ||
+         next.htotal != now->htotal || next.hskew != now->hskew ||
+         next.vdisplay != now->vdisplay || next.vsync_start != now->vsync_start ||
+         next.vsync_end != now->vsync_end || next.vtotal != now->vtotal ||
+         next.vscan != now->vscan || next.flags != now->flags;
+}
+
+bool CWinSystemGbm::DVEndWaitsForMode(const CDVBridgeState& state) const
+{
+  // As CGraphicContext::SetFullScreenVideo(): when a video stops, Kodi goes back to the resolution
+  // of the GUI, unless the refresh rate is adjusted when a video starts only.
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || settings->GetInt(CSettings::SETTING_VIDEOPLAYER_ADJUSTREFRESHRATE) ==
+                       ADJUST_REFRESHRATE_ON_START)
+    return false;
+  RESOLUTION target = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    target = CDisplaySettings::GetInstance().GetCurrentResolution();
+  return DVModeChangeJoins(state, CDisplaySettings::GetInstance().GetResolutionInfo(target));
+}
