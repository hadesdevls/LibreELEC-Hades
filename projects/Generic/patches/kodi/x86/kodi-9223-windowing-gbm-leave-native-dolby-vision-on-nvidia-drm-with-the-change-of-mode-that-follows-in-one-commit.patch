+bool CWinSystemGbmGLESContext::EndDVBridgeAfterVideo()
+{
+  if (m_dvState.Captured() && DVEndWaitsForMode(m_dvState))
+  {
+    m_dvEndDeferredUntil = std::chrono::steady_clock::now() + DV_END_WAIT;
+    m_dvEndDeferred = true;
+    CLog::Log(LOGINFO,
+              "DVBridge: the video ended; the ordinary output comes back with the change of mode "
+              "that follows, in one commit (within {} ms)",
+              DV_END_WAIT.count());
+    return true;
+  }
+  return EndDVBridge();
+}
