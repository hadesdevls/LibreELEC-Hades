+bool CWinSystemGbmGLESContext::DestroyWindow()
+{
+#ifdef HAVE_DVBRIDGE
+  // A restoration that waits for the change of mode after a video, or that has failed so far, is
+  // made while the window is still there: Kodi can stop (quit, restart, power off) without a
+  // change of mode, and its window goes before its window system, whose end restores too late.
+  if (m_dvState.Captured())
+    EndDVBridge();
+#endif
+  return CWinSystemGbmEGLContext::DestroyWindow();
+}
