From 483b3ca0f7280461e227f50f24aa04fcfcf1e31d Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:12:11 +0100
Subject: [PATCH] [AudioEngine][CAEStreamParser] Do not sync on a DTS-HD frame
 with no type

After a lost sync the parser resets its stream type to none, and a
DTS-HD frame whose extension asset it does not recognise inherited that
type. A stream without a type has no frame duration, so
CActiveAEBufferPool::Create() never reached its buffer time and
allocated until the process was killed. A seek in a DTS-HD MA track
with passthrough on and no usable sink triggered it.

Such a frame is now skipped while there is no type to inherit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp |  4 ++-
 .../Utils/test/TestAEStreamParser.cpp         | 25 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
index 0d53acb..c70b9c6 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
@@ -667,8 +667,10 @@ unsigned int CAEStreamParser::SyncDTS(uint8_t* data, unsigned int size)
           dataType = m_info.m_type;
         }
       }
-      else
+      else if (m_info.m_type != CAEStreamInfo::STREAM_TYPE_NULL)
         dataType = m_info.m_type;
+      else
+        continue;
 
       m_coreSize = m_fsize;
       m_fsize += hd_size;
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
index cb67f90..c026cae 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
@@ -38,6 +38,15 @@ std::vector<uint8_t> HdExtension()
   return ext;
 }
 
+//! A DTS-HD extension substream whose asset starts with no sync the parser knows.
+std::vector<uint8_t> UnknownExtension()
+{
+  std::vector<uint8_t> ext = HdExtension();
+  const uint8_t unknown[] = {0xF0, 0xC7, 0x89, 0x11};
+  std::copy(std::begin(unknown), std::end(unknown), ext.begin() + 16);
+  return ext;
+}
+
 std::vector<uint8_t> MaFrame()
 {
   std::vector<uint8_t> frame = CoreFrame();
@@ -90,6 +99,22 @@ TEST(TestAEStreamParser, ACoreFrameNotFollowedByASyncIsNotTakenAsTheStream)
     EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_DTSHD_MA, type);
 }
 
+//! After a lost sync there is no previous type to fall back on, and a stream without a type has no
+//! frame duration, which ActiveAE cannot buffer.
+TEST(TestAEStreamParser, AnExtensionWithAnUnknownAssetIsNotTakenAsTheStream)
+{
+  std::vector<uint8_t> stream = CoreFrame();
+  Append(stream, UnknownExtension());
+  for (int i = 0; i < 4; ++i)
+    Append(stream, MaFrame());
+
+  const std::vector<CAEStreamInfo::DataType> types = Parse(stream);
+
+  ASSERT_FALSE(types.empty());
+  for (const CAEStreamInfo::DataType type : types)
+    EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_DTSHD_MA, type);
+}
+
 TEST(TestAEStreamParser, ADtsHdMaStreamIsDetectedFromItsFirstFrame)
 {
   std::vector<uint8_t> stream;
-- 
