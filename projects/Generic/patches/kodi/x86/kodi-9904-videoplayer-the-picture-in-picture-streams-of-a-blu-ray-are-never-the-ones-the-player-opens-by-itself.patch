@@ -13,6 +13,7 @@
 #include "DVDInputStreams/DVDInputStreamNavigator.h"
 #include "Mpeg2SoftTelecine.h"
 #ifdef HAVE_LIBBLURAY
+#include "DVDInputStreams/BluraySecondaryStreams.h"
 #include "DVDInputStreams/DVDInputStreamBluray.h"
 #endif
 #include "DVDInputStreams/DVDInputStreamFFmpeg.h"
@@ -3817,6 +3818,13 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
         delete stream;
         return nullptr;
       }
+      // Hades: a picture-in-picture stream of the disc is never what the player opens by itself
