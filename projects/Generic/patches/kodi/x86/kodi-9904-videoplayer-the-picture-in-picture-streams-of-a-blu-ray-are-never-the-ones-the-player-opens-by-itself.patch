diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/BluraySecondaryStreams.h b/xbmc/cores/VideoPlayer/DVDInputStreams/BluraySecondaryStreams.h
new file mode 100644
index 0000000..6101c5c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BluraySecondaryStreams.h
@@ -0,0 +1,55 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \file BluraySecondaryStreams.h
+ * \brief Hades: the picture-in-picture streams of a Blu-ray are never what the player opens by itself.
+ *
+ * A clip of a Blu-ray can carry, beside the film, a secondary video (a picture-in-picture commentary or
+ * featurette, PIDs 0x1B00 to 0x1B1F) and a secondary audio stream (its sound, or a commentary meant to
+ * be mixed over the primary audio, PIDs 0x1A00 to 0x1A1F). A player shows them over the film when the
+ * disc's menus ask for it; Kodi has neither the picture-in-picture nor the mixer. The demuxer gives them
+ * as ordinary streams, so the player could take one of them for the film: the first video packet of a
+ * title with the disc's menus (CVideoPlayer::IsBetterStream()), or the first video or the best-ranked
+ * audio stream of a playlist played directly (CVideoPlayer::OpenDefaultStreams()). They stay among
+ * the streams the user can choose.
+ */
+
+#include <algorithm>
+#include <vector>
+
+namespace KODI::BLURAYSTREAMS
+{
+constexpr int PID_SECONDARY_AUDIO_FIRST = 0x1A00;
+constexpr int PID_SECONDARY_AUDIO_LAST = 0x1A1F;
+constexpr int PID_SECONDARY_VIDEO_FIRST = 0x1B00;
+constexpr int PID_SECONDARY_VIDEO_LAST = 0x1B1F;
+
+//! Whether a stream of a Blu-ray, by its PID, is a picture-in-picture (secondary) video or audio stream
+inline bool IsSecondary(int pid)
+{
+  return (pid >= PID_SECONDARY_AUDIO_FIRST && pid <= PID_SECONDARY_AUDIO_LAST) ||
+         (pid >= PID_SECONDARY_VIDEO_FIRST && pid <= PID_SECONDARY_VIDEO_LAST);
+}
+
+/*!
+ * \brief Put the secondary streams of a list ranked by the player's preferences after the others,
+ *        each part in the order it had.
+ * \param pidOf The PID of a stream of the list (0 where it has none)
+ * \param chosen Whether the user chose that stream for this file (the video settings): it keeps its
+ *        place, secondary or not
+ */
+template<typename Stream, typename PidOf, typename Chosen>
+void SecondaryLast(std::vector<Stream>& streams, PidOf pidOf, Chosen chosen)
+{
+  std::stable_partition(streams.begin(), streams.end(), [&](const Stream& stream)
+                        { return chosen(stream) || !IsSecondary(pidOf(stream)); });
+}
+} // namespace KODI::BLURAYSTREAMS
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt b/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
index 3d21241..f593bb9 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
@@ -13,7 +13,8 @@ set(SOURCES BlurayStateSerializer.cpp
             InputStreamPVRChannel.cpp
             InputStreamPVRRecording.cpp)
 
-set(HEADERS BlurayStateSerializer.h
+set(HEADERS BluraySecondaryStreams.h
+            BlurayStateSerializer.h
             DVDFactoryInputStream.h
             DVDInputStream.h
             DVDInputStreamFFmpeg.h
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index d886fd6..52c9faa 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -20,6 +20,7 @@
 #include "DVDDemuxers/DVDDemuxUtils.h"
 #include "DVDDemuxers/DVDDemuxVobsub.h"
 #include "DVDDemuxers/DVDFactoryDemuxer.h"
+#include "DVDInputStreams/BluraySecondaryStreams.h"
 #include "DVDInputStreams/DVDFactoryInputStream.h"
 #include "DVDInputStreams/DVDInputStream.h"
 #include "network/NetworkFileItemClassify.h"
@@ -1241,6 +1242,24 @@ void CVideoPlayer::OpenDefaultStreams(bool reset)
 
   bool valid;
 
+  // Hades: of a Blu-ray, the picture-in-picture streams come after the others, unless the user chose
+  // one for this file (BluraySecondaryStreams.h)
+  const auto secondaryLast = [this](std::vector<SelectionStream> streams, int chosenIndex)
+  {
+    if (m_pInputStream->IsStreamType(DVDSTREAM_TYPE_BLURAY) && m_pDemuxer)
+      KODI::BLURAYSTREAMS::SecondaryLast(
+          streams,
+          [this](const SelectionStream& s)
+          {
+            const CDemuxStream* stream = STREAM_SOURCE_MASK(s.source) == STREAM_SOURCE_DEMUX
+                                             ? m_pDemuxer->GetStream(s.demuxerId, s.id)
+                                             : nullptr;
+            return stream ? stream->dvdNavId : 0;
+          },
+          [chosenIndex](const SelectionStream& s) { return s.type_index == chosenIndex; });
+    return streams;
+  };
+
   // open video stream
   valid   = false;
 
@@ -1263,7 +1282,8 @@ void CVideoPlayer::OpenDefaultStreams(bool reset)
   }
 #endif
   PredicateVideoFilter vf(videoStream);
-  for (const auto& stream : m_SelectionStreams.Get(StreamType::VIDEO, vf))
+  for (const auto& stream :
+       secondaryLast(m_SelectionStreams.Get(StreamType::VIDEO, vf), videoStream))
   {
     if (OpenStream(m_CurrentVideo, stream.demuxerId, stream.id, stream.source, reset))
     {
@@ -1282,7 +1302,8 @@ void CVideoPlayer::OpenDefaultStreams(bool reset)
   if (!m_playerOptions.videoOnly && !m_audioOutputFailed)
   {
     PredicateAudioFilter af(m_processInfo->GetVideoSettings().m_AudioStream, m_playerOptions.preferStereo);
-    for (const auto& stream : m_SelectionStreams.Get(StreamType::AUDIO, af))
+    for (const auto& stream : secondaryLast(m_SelectionStreams.Get(StreamType::AUDIO, af),
+                                            m_processInfo->GetVideoSettings().m_AudioStream))
     {
       if(OpenStream(m_CurrentAudio, stream.demuxerId, stream.id, stream.source, reset))
       {
@@ -1581,7 +1602,11 @@ bool CVideoPlayer::IsBetterStream(const CCurrentStream& current, CDemuxStream* s
       return true;
     if (current.type == StreamType::SUBTITLE && stream->dvdNavId == m_dvd.iSelectedSPUStream)
       return true;
-    if (current.type == StreamType::VIDEO && current.id < 0)
+    // Hades: never the picture-in-picture video of a Blu-ray, which can come first
+    // (BluraySecondaryStreams.h)
+    if (current.type == StreamType::VIDEO && current.id < 0 &&
+        !(m_pInputStream->IsStreamType(DVDSTREAM_TYPE_BLURAY) &&
+          KODI::BLURAYSTREAMS::IsSecondary(stream->dvdNavId)))
       return true;
   }
   else
