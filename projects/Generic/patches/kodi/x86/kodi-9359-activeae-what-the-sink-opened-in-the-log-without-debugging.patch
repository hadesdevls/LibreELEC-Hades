From 70a700d6cd068895dfc20f9dfc4ba30d31d0d131 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 15:39:16 +0000
Subject: [PATCH] ActiveAE: what the sink opened, in the log without debugging

When the engine opens its sink, what it opened (sample rate, format,
channel count and layout) was in the log only with debugging on. A
report of a TV that is silent with a track that Kodi decodes cannot
then say how many channels of PCM the display was sent, which is what
tells why (a display that declares 2 channels of PCM gets more of them
from Kodi otherwise). One line at the info level now says it: for PCM,
the channels, their layout, the rate and the format; for passthrough,
the stream type and the rate; with the name of the device.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAESink.cpp     | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index 0237f33..3cdba83 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -1170,6 +1170,17 @@ void CActiveAESink::OpenSink()
   CLog::Log(LOGDEBUG, "  Channel Layout: {}", ((std::string)m_sinkFormat.m_channelLayout));
   CLog::Log(LOGDEBUG, "  Frames        : {}", m_sinkFormat.m_frames);
   CLog::Log(LOGDEBUG, "  Frame Size    : {}", m_sinkFormat.m_frameSize);
+  // Hades: what goes out, also without debugging: how many channels of PCM a display was sent is
+  // what tells why it is silent with a track that Kodi decodes
+  if (m_sinkFormat.m_dataFormat == AE_FMT_RAW)
+    CLog::LogF(LOGINFO, "{} is open for passthrough: {} at {} Hz ('{}')", m_sink->GetName(),
+               CAEUtil::StreamTypeToStr(m_sinkFormat.m_streamInfo.m_type),
+               m_sinkFormat.m_sampleRate, m_deviceFriendlyName);
+  else
+    CLog::LogF(LOGINFO, "{} is open for PCM: {} channels ({}) at {} Hz, {} ('{}')", m_sink->GetName(),
+               m_sinkFormat.m_channelLayout.Count(), (std::string)m_sinkFormat.m_channelLayout,
+               m_sinkFormat.m_sampleRate, CAEUtil::DataFormatToStr(m_sinkFormat.m_dataFormat),
+               m_deviceFriendlyName);
 
   // init sample of silence
   SampleConfig config;
-- 
