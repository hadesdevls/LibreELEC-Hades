From 13a1bf06caa9f10929a86e8fd6bebd85cb387885 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:19:06 +0000
Subject: [PATCH] VideoPlayer: say why two video tracks are not joined as Dolby
 Vision, and what each one is

Two HEVC tracks, or a Dolby Vision group of libavformat, that were not joined left nothing in the log,
and a report of a dual-track file that plays as HDR10 could not tell why. Find() now says why
(Layers::reason), and the demuxer logs it with each track that may be a layer: codec, size, framing,
codec tag, its Dolby Vision record and flags, whether it is in a group, and its PID or track number.
No file name or URL. Each distinct line once.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 79 +++++++++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  4 +
 .../VideoPlayer/DVDDemuxers/DVLayerMerge.cpp  | 71 +++++++++++++++--
 .../VideoPlayer/DVDDemuxers/DVLayerMerge.h    |  3 +
 4 files changed, 149 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 25dc822..7163dfd 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -779,6 +779,7 @@ void CDVDDemuxFFmpeg::Dispose()
   m_dvVerified = true;
   m_dvProbed.clear();
   m_dvPromoted.clear();
+  m_dvNotJoined.clear();
 #endif
 
   if (m_pFormatContext)
@@ -1160,6 +1161,8 @@ void CDVDDemuxFFmpeg::FindDVLayers()
               "the size of a Dolby Vision enhancement layer for the base layer of stream {}: "
               "not joined, the base layer plays alone",
               layers.enhancement, layers.base);
+  else if (layers.result == Result::NONE)
+    LogDVNotJoined(layers.reason);
 
   const bool joined = layers.result == Result::JOINED;
   const int base = joined ? layers.base : -1;
@@ -1284,6 +1287,82 @@ void CDVDDemuxFFmpeg::PromoteDolbyVision(CDemuxStream* stream,
   video->changes++;
 }
 
+void CDVDDemuxFFmpeg::LogDVNotJoined(const char* reason)
+{
+  if (!reason || !*reason)
+    return;
+  unsigned int hevc = 0;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVCodecParameters* par = m_pFormatContext->streams[i]->codecpar;
+    hevc += par->codec_type == AVMEDIA_TYPE_VIDEO && par->codec_id == AV_CODEC_ID_HEVC &&
+            !(m_pFormatContext->streams[i]->disposition & AV_DISPOSITION_ATTACHED_PIC);
+  }
+  bool group = false;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_stream_groups; ++i)
+    group |= m_pFormatContext->stream_groups[i] &&
+             m_pFormatContext->stream_groups[i]->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION;
+  if (hevc < 2 && !group)
+    return;
+
+  // each track that may be a layer: HEVC video, one with a Dolby Vision record, one of a group
+  const bool ts = strcmp(m_pFormatContext->iformat->name, "mpegts") == 0;
+  std::string tracks;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVStream* st = m_pFormatContext->streams[i];
+    const AVCodecParameters* par = st->codecpar;
+    const AVPacketSideData* sd =
+        av_packet_side_data_get(par->coded_side_data, par->nb_coded_side_data,
+                                AV_PKT_DATA_DOVI_CONF);
+    const auto* record = sd && sd->size >= sizeof(AVDOVIDecoderConfigurationRecord)
+                             ? reinterpret_cast<const AVDOVIDecoderConfigurationRecord*>(sd->data)
+                             : nullptr;
+    bool inGroup = false;
+    for (unsigned int g = 0; g < m_pFormatContext->nb_stream_groups; ++g)
+    {
+      const AVStreamGroup* sg = m_pFormatContext->stream_groups[g];
+      if (sg && sg->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
+        for (unsigned int j = 0; j < sg->nb_streams; ++j)
+          inGroup |= sg->streams[j] == st;
+    }
+    const bool video = par->codec_type == AVMEDIA_TYPE_VIDEO && par->codec_id == AV_CODEC_ID_HEVC;
+    if (!video && !record && !inGroup)
+      continue;
+    char tag[AV_FOURCC_MAX_STRING_SIZE] = {};
+    av_fourcc_make_string(tag, par->codec_tag);
+    const int lengthSize = CDVLayerMerge::LengthSize(par);
+    std::string line = StringUtils::Format(
+        "{}stream {} ({} {}): {} {}, {}x{}, tag {}, {}", tracks.empty() ? "" : "; ", i,
+        ts ? "PID" : "track", ts ? StringUtils::Format("0x{:x}", st->id) : std::to_string(st->id),
+        av_get_media_type_string(par->codec_type) ? av_get_media_type_string(par->codec_type)
+                                                  : "unknown",
+        avcodec_get_name(par->codec_id), par->width, par->height, tag,
+        lengthSize ? StringUtils::Format("units with {}-byte lengths", lengthSize)
+                   : std::string("start codes"));
+    if (record)
+      line += StringUtils::Format(", Dolby Vision record: profile {} level {}, RPU {}, enhancement "
+                                  "layer {}, base layer {}, compatibility {}",
+                                  record->dv_profile, record->dv_level, record->rpu_present_flag,
+                                  record->el_present_flag, record->bl_present_flag,
+                                  record->dv_bl_signal_compatibility_id);
+    else
+      line += ", no Dolby Vision record";
+    if (inGroup)
+      line += ", in a Dolby Vision group of libavformat";
+    if (st->disposition & AV_DISPOSITION_ATTACHED_PIC)
+      line += ", an attached picture";
+    tracks += line;
+  }
+  const std::string message = StringUtils::Format(
+      "CDVDDemuxFFmpeg: video tracks not joined as Dolby Vision in two tracks ({}): {}", reason,
+      tracks);
+  if (message == m_dvNotJoined)
+    return;
+  m_dvNotJoined = message;
+  CLog::Log(LOGINFO, "{}", message);
+}
+
 // A HEVC stream that no Dolby Vision record declares, and whose first packets bring an RPU: the
 // RPU says what it is (CDVLayerMerge::RecordFromRpu()), and only what can be told for sure makes
 // it Dolby Vision. A stream without one stays as it is: nothing of it changes.
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 47cf33d..4de6c46 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -208,6 +208,10 @@ protected:
   //! the stream is Dolby Vision from here on: VideoPlayer opens its codec again
   void PromoteDolbyVision(CDemuxStream* stream, const AVDOVIDecoderConfigurationRecord& record,
                           const AVCodecParameters* enhancement);
+  //! Two HEVC tracks, or a Dolby Vision group, that are not joined: why, and what each track is
+  //! (codec, size, framing, Dolby Vision record, PID or track number), once for each line.
+  void LogDVNotJoined(const char* reason);
+  std::string m_dvNotJoined;
 #endif
 
   struct AVCodecParametersDeleter
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
index 501cf17..0165cda 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
@@ -240,17 +240,38 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
   for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
   {
     const AVStreamGroup* group = context->stream_groups[i];
-    if (!group || group->type != AV_STREAM_GROUP_PARAMS_DOLBY_VISION || group->nb_streams != 2 ||
-        !group->params.layered_video || group->params.layered_video->el_index > 1)
+    if (!group || group->type != AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
       continue;
+    if (group->nb_streams != 2 || !group->params.layered_video ||
+        group->params.layered_video->el_index > 1)
+    {
+      refused.reason = "a Dolby Vision group of libavformat that is not a pair of tracks";
+      continue;
+    }
 
     AVStream* enhancement = group->streams[group->params.layered_video->el_index];
     AVStream* base = group->streams[1 - group->params.layered_video->el_index];
     if (!base || !enhancement || base == enhancement || !base->codecpar ||
-        !enhancement->codecpar || base->codecpar->codec_id != AV_CODEC_ID_HEVC ||
-        enhancement->codecpar->codec_id != AV_CODEC_ID_HEVC || !played(base) ||
-        !played(enhancement))
+        !enhancement->codecpar)
+    {
+      refused.reason = "a Dolby Vision group of libavformat that is not a pair of tracks";
+      continue;
+    }
+    if (base->codecpar->codec_id != AV_CODEC_ID_HEVC ||
+        enhancement->codecpar->codec_id != AV_CODEC_ID_HEVC)
+    {
+      // (a transport stream whose enhancement layer is a private stream, as the Dolby Vision
+      // specification of the transport stream has it, is HEVC once libavformat has looked into
+      // its packets: an input that is not analysed before playback has it as data at first)
+      refused.reason =
+          "a track of the Dolby Vision group of libavformat is not (yet) known as HEVC";
       continue;
+    }
+    if (!played(base) || !played(enhancement))
+    {
+      refused.reason = "a track of the Dolby Vision group is not in the program that plays";
+      continue;
+    }
 
     const AVCodecParameters* b = base->codecpar;
     const AVCodecParameters* e = enhancement->codecpar;
@@ -276,7 +297,11 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
       if (layers.record.dv_profile != 7 || !layers.record.el_present_flag ||
           !layers.record.rpu_present_flag ||
           (container != Container::MATROSKA && layers.record.bl_present_flag))
+      {
+        refused.reason = "the Dolby Vision record of the enhancement track is not one of a "
+                         "profile 7 enhancement layer with its RPU";
         continue;
+      }
       // libavformat pairs MP4 tracks by a reference, Matroska tracks by the records only: a
       // second HEVC track of another size than an enhancement layer has is none.
       if (container != Container::TRANSPORT_STREAM &&
@@ -290,6 +315,8 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
     else if (container != Container::TRANSPORT_STREAM)
     {
       // an MP4 or Matroska pair is only known by the record (none: libavformat made no group)
+      refused.reason = "a Dolby Vision group of libavformat without the record of the enhancement "
+                       "track";
       continue;
     }
     else
@@ -337,7 +364,7 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
 
   // Matroska files that libavformat does not group (see the comment of Find() in the header):
   // only where it made no Dolby Vision group at all.
-  if (container != Container::MATROSKA || refused.result != Layers::Result::NONE)
+  if (refused.result != Layers::Result::NONE)
     return refused;
   for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
   {
@@ -345,6 +372,17 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
         context->stream_groups[i]->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
       return refused;
   }
+  if (container != Container::MATROSKA)
+  {
+    refused.reason = container == Container::MP4
+                         ? "no Dolby Vision group of libavformat (in MP4: the 'vdep' reference "
+                           "of an enhancement track with its Dolby Vision sample entry and "
+                           "record)"
+                         : "no Dolby Vision group of libavformat (in a transport stream: the "
+                           "Dolby Vision descriptor of the enhancement track, or the stream "
+                           "numbers of a Blu-ray program)";
+    return refused;
+  }
   AVStream* tracks[2] = {};
   unsigned int hevc = 0;
   for (unsigned int i = 0; i < context->nb_streams; ++i)
@@ -359,7 +397,12 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
     ++hevc;
   }
   if (hevc != 2)
+  {
+    refused.reason = hevc > 2 ? "no Dolby Vision group of libavformat, and more than two HEVC "
+                                "video tracks"
+                              : "no Dolby Vision group of libavformat";
     return refused;
+  }
   const auto area = [](const AVStream* s)
   { return static_cast<int64_t>(s->codecpar->width) * s->codecpar->height; };
   AVStream* base = area(tracks[0]) >= area(tracks[1]) ? tracks[0] : tracks[1];
@@ -368,9 +411,17 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
   const AVCodecParameters* e = enhancement->codecpar;
   // sizes that are known, and that are the ones of a pair; a length before each unit
   if (b->width <= 0 || b->height <= 0 || e->width <= 0 || e->height <= 0 ||
-      !EnhancementSize(b->width, b->height, e->width, e->height) || !LengthSize(b) ||
-      !LengthSize(e))
+      !EnhancementSize(b->width, b->height, e->width, e->height))
+  {
+    refused.reason = "no Dolby Vision group of libavformat, and the two HEVC tracks do not have "
+                     "the sizes of a base layer and its enhancement layer";
     return refused;
+  }
+  if (!LengthSize(b) || !LengthSize(e))
+  {
+    refused.reason = "no Dolby Vision group of libavformat, and a track without an hvcC record";
+    return refused;
+  }
   // what records the tracks have must not speak against it: the first one says it has a base
   // layer, the second one an RPU, of profile 7 or 8 (a MEL)
   const auto recordOf = [](const AVCodecParameters* par) -> const AVDOVIDecoderConfigurationRecord*
@@ -387,7 +438,11 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
   if ((baseRecord && !baseRecord->bl_present_flag) ||
       (layerRecord && (!layerRecord->rpu_present_flag ||
                        (layerRecord->dv_profile != 7 && layerRecord->dv_profile != 8))))
+  {
+    refused.reason = "no Dolby Vision group of libavformat, and Dolby Vision records that are not "
+                     "the ones of a base layer and of an enhancement layer with RPUs";
     return refused;
+  }
 
   Layers layers;
   layers.container = container;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index 3a2d5cc..1dab554 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -111,6 +111,9 @@ public:
     //! group (no record, or records that do not tell which is which); they are a pair only once
     //! their packets show it (Verification()), and the record is made for that case.
     bool verified = true;
+    //! when not joined: why, in words for the log (a static string; empty when the stream has no
+    //! second video track to speak of)
+    const char* reason = "";
   };
 
   /*!
