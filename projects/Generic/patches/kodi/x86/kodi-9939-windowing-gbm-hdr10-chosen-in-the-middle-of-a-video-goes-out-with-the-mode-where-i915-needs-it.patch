From ca71d480998e76fe2f7459761421bcc0f56b8da3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:09:30 +0000
Subject: [PATCH] windowing/gbm: HDR10+ chosen in the middle of a video goes
 out with the mode where i915 needs it

With "Dolby Vision as HDR10+" chosen for a video that plays (b1cc556),
HDR10+ can start, or end, in the middle of the video, with no change of
mode. Read on each driver, from the Hades patches that send it:

- amdgpu (linux-9981): HDR10+ in a generic packet of its own, started
  and ended with a flip; nothing else changes.
- i915 and xe (linux-9982) at the modes DRM names by an HDMI VIC
  (3840x2160 up to 30 Hz, 4096x2160 at 24 Hz): HDR10+ takes the vendor
  DIP there and the mode is then named by its CTA VIC in the AVI
  InfoFrame, which only a commit that allows a mode set can change. The
  start of a video has HDR10+ in the commit of its mode (CModeChangeHold,
  CDVPlusModeStart: the first picture waits for its measurement). In the
  middle of a video every commit with HDR10+ would be refused, and after
  CHDR10PlusOutput::REFUSED_AFTER of them the video went on as HDR10:
  the choice did nothing there.
- nvidia-drm (nvidia-open-kernel-modules-9050) where NVKMS names the
  mode by its HDMI VIC: the flip that starts HDR10+ writes the AVI
  InfoFrame too, with the CTA VIC of the same format. A commit that
  allows a mode set would change nothing more (the mode is the same, so
  DRM sets none).
- The end of HDR10+: i915, xe and NVKMS keep that CTA VIC until the next
  change of mode, and the end of HDR10+ is a fastset or a flip; amdgpu
  stops its packet. Nothing else changes.

So where HDR10+ starts in the middle of a video by the user's choice
(DVConversionChoiceChanged(), only when it was not going out just
before), CWinSystemGbm::HDR10PlusStartMidVideo() asks
CDVPlusModeStart::ForMidVideo(): on i915 and xe at those modes
(MODE_AGAIN) the next commit sets the mode again, as the start of a
video does: the HDR signalling, colorimetry and depth of the link as
queued and a mode set allowed (RequeueOutputProperties()), the hold of
the mode released for HDR10+ (CHDR10PlusOutput::WithMode()), and an
earlier refusal of this video forgotten. The first picture then waits
for its measurement in that commit (DVPlusModeStart(), as at the start),
else goes with provisional metadata. Fail closed as before: a refusal
is tested again without the payload (CDRMAtomic), and the video goes on
as HDR10 with the log line of the refusal. Elsewhere it starts with a
flip, as it did.

The log says which it was ("DVBridge: HDR10+ starts in the middle of the
video (the output chosen for it): i915 at 3840x2160 23.976 Hz takes
HDR10+ only in a commit of the mode, so the next commit sets the mode
again ...", "... nvidia-drm (...) names this mode by its HDMI VIC, so
the flip that starts HDR10+ puts the CTA VIC of the same format in the
AVI InfoFrame ...", "... with a flip ..."), and when it ends ("HDR10+
ends in the middle of the video ...").

Tested on the host: dvplus_midvideo_test (21 checks: the drivers and
modes, and that the commit armed for MODE_AGAIN is one where the first
picture waits, as at the start); it does not build against 1.0 RC6,
and two mutations make it fail. Syntax: the 19 sources that the build
compiles with these files. Not run on a GPU: whether the display takes
a moment at the mode set again (i915) or at the change of the AVI
InfoFrame (NVIDIA), as at a change of mode.
---
 xbmc/windowing/gbm/DVPlusModeStart.h          | 27 +++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 31 ++++++++++
 xbmc/windowing/gbm/WinSystemGbm.h             | 12 ++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 56 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 10 +++-
 5 files changed, 133 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/DVPlusModeStart.h b/xbmc/windowing/gbm/DVPlusModeStart.h
index e7681cc..c595257 100644
--- a/xbmc/windowing/gbm/DVPlusModeStart.h
+++ b/xbmc/windowing/gbm/DVPlusModeStart.h
@@ -128,6 +128,33 @@ public:
   {
     return provisional && !moduleSends && since < lost;
   }
+
+  //! Hades: how HDR10+ starts in the middle of a video whose mode went out without it (the user
+  //! chose "Dolby Vision as HDR10+" for the video then: DVBRIDGE::RebuiltHdr10PlusOf())
+  enum class MidVideo
+  {
+    //! with a flip, nothing else changes: amdgpu, i915 and xe at the other modes, nvidia-drm where
+    //! NVKMS does not name the mode by an HDMI VIC
+    FLIP,
+    //! i915 and xe at a mode they name by an HDMI VIC (NeededFor()): they take HDR10+ there only in
+    //! a commit that may change the mode (the AVI InfoFrame then names it by its CTA VIC, and no
+    //! commit without ALLOW_MODESET can change that), so the next commit sets the mode again, with
+    //! the HDR signalling of the video and the first HDR10+ picture, as the start of a video does
+    //! (For() then says WAIT for it); without that, every commit with HDR10+ is refused and the
+    //! video goes on as HDR10
+    MODE_AGAIN,
+    //! nvidia-drm where NVKMS names the mode by an HDMI VIC (NeededForNvidia()): the flip that
+    //! starts HDR10+ writes the AVI InfoFrame too, with the CTA VIC of the same format
+    //! (nvidia-open-kernel-modules-9050); a commit that allows a mode set changes nothing more
+    //! there (the mode is the same, so DRM sets no mode)
+    AVI_CHANGES,
+  };
+
+  //! \param needed NeededFor() the mode on the screen; \param nvidiaAvi NeededForNvidia() for it
+  static MidVideo ForMidVideo(bool needed, bool nvidiaAvi)
+  {
+    return needed ? MidVideo::MODE_AGAIN : nvidiaAvi ? MidVideo::AVI_CHANGES : MidVideo::FLIP;
+  }
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index c5161cb..6731e1a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3853,6 +3853,37 @@ bool CWinSystemGbm::HDR10PlusWithModeNow() const
                                            drm->RequestValue(connector, "HDR_OUTPUT_METADATA"));
 }
 
+CDVPlusModeStart::MidVideo CWinSystemGbm::HDR10PlusStartMidVideo(std::string& what)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto* mode = drm ? drm->GetSelectedMode() : nullptr;
+  if (!drm || !drm->GetConnector() || !mode)
+    return CDVPlusModeStart::MidVideo::FLIP;
+  std::string driver;
+  if (drmVersionPtr version = drmGetVersion(drm->GetFileDescriptor()))
+  {
+    if (version->name)
+      driver = version->name;
+    drmFreeVersion(version);
+  }
+  const double refresh =
+      mode->htotal && mode->vtotal ? mode->clock * 1000.0 / (mode->htotal * mode->vtotal) : 0;
+  what =
+      StringUtils::Format("{} at {}x{} {:.3f} Hz", driver, mode->hdisplay, mode->vdisplay, refresh);
+  const CDVPlusModeStart::MidVideo how = CDVPlusModeStart::ForMidVideo(
+      CDVPlusModeStart::NeededFor(driver, mode->hdisplay, mode->vdisplay, refresh),
+      HDR10PlusChangesAviAfterMode());
+  if (how == CDVPlusModeStart::MidVideo::MODE_AGAIN)
+  {
+    m_hdr10Plus.NewVideo();
+    // (the HDR signalling, the colorimetry and the depth of the link as they are queued, and a mode
+    // set allowed: the commit that the next frame makes)
+    RequeueOutputProperties();
+    m_hdr10Plus.HeldModeReleased(true);
+  }
+  return how;
+}
+
 int CWinSystemGbm::HDR10PlusOutputVersion() const
 {
   CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index f98d620..9065446 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include "DVPlusModeStart.h"
 #include "HDR10PlusOutput.h"
 #include "HDRSignal.h"
 #include "LinkDepth.h"
@@ -321,6 +322,17 @@ protected:
   //! Hades: the request of this frame is the commit of the mode of the video, with its HDR
   //! signalling: an HDR10+ payload goes with it (CHDR10PlusOutput::WithMode())
   bool HDR10PlusWithModeNow() const;
+  /*!
+   * \brief Hades: HDR10+ starts in the middle of a video whose mode went out without it (the user
+   *        chose "Dolby Vision as HDR10+" for the video): how it can start on this output
+   *        (CDVPlusModeStart::ForMidVideo()), and where that is MODE_AGAIN, the next commit set up
+   *        for it: the mode again, with the HDR signalling of the video (RequeueOutputProperties())
+   *        and the first HDR10+ frame, as the start of a video does (CHDR10PlusOutput::WithMode());
+   *        a refusal of HDR10+ earlier in the video is forgotten for it
+   *        (CHDR10PlusOutput::NewVideo())
+   * \param what for the log: the driver, the mode and its rate
+   */
+  CDVPlusModeStart::MidVideo HDR10PlusStartMidVideo(std::string& what);
   //! Hades: nvidia-drm puts the CTA VIC of the mode on the screen in the AVI InfoFrame at the first
   //! HDR10+ frame, for this display (CDVPlusModeStart::NeededForNvidia())
   bool HDR10PlusChangesAviAfterMode() const;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 61506b1..dd2870f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3167,7 +3167,9 @@ void CWinSystemGbmGLESContext::DVConversionNewVideo()
   m_hdr10Adapt.Reset();
   // Hades: the depth of the output is asked again in each video
   ResetOutputDepth();
-  // Hades: and Dolby Vision sent as HDR10+ starts again (render thread: DVConversionHDR10Plus())
+  // Hades: and Dolby Vision sent as HDR10+ starts again (render thread: DVConversionHDR10Plus()),
+  // as for the start of a video
+  m_dvPlusChoiceRestart = false;
   m_dvPlusRestart = true;
 }
 
@@ -3596,6 +3598,50 @@ void CWinSystemGbmGLESContext::DVPlusEnd()
   m_dvPlusProvisionalFrames = 0;
 }
 
+void CWinSystemGbmGLESContext::DVPlusMidVideo(bool wasSending, bool sends)
+{
+  if (wasSending == sends)
+    return;
+  if (!sends)
+  {
+    // (linux-9982 and nvidia-open-kernel-modules-9050: i915, xe and NVKMS keep the CTA VIC that
+    // HDR10+ put in the AVI InfoFrame until the next change of mode; amdgpu changes nothing else)
+    CLog::Log(LOGINFO,
+              "DVBridge: HDR10+ ends in the middle of the video (the output chosen for it): "
+              "the next frame goes out without the HDR10+ InfoFrame, as HDR10; the mode "
+              "and the HDR signalling stay as they are");
+    return;
+  }
+  std::string what;
+  switch (HDR10PlusStartMidVideo(what))
+  {
+    case CDVPlusModeStart::MidVideo::MODE_AGAIN:
+      CLog::Log(
+          LOGINFO,
+          "DVBridge: HDR10+ starts in the middle of the video (the output chosen for it): {} "
+          "takes HDR10+ only in a commit of the mode, so the next commit sets the mode again, "
+          "with the HDR signalling of the video and the first HDR10+ picture, as the start of "
+          "a video does; the display may take a moment, as at a change of mode. Where the "
+          "driver refuses it, the video goes on as HDR10, and the log says so",
+          what);
+      break;
+    case CDVPlusModeStart::MidVideo::AVI_CHANGES:
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10+ starts in the middle of the video (the output chosen for it): "
+                "nvidia-drm ({}) names this mode by its HDMI VIC, so the flip that starts HDR10+ "
+                "puts the CTA VIC of the same format in the AVI InfoFrame; the display may take a "
+                "moment at that change, the picture is the same",
+                what);
+      break;
+    case CDVPlusModeStart::MidVideo::FLIP:
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10+ starts in the middle of the video (the output chosen for it), "
+                "with a flip: the driver ({}) takes it without a change of mode",
+                what.empty() ? "no mode known" : what);
+      break;
+  }
+}
+
 int64_t CWinSystemGbmGLESContext::DVPlusPeriodNs() const
 {
   const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
@@ -3674,10 +3720,13 @@ int64_t CWinSystemGbmGLESContext::DVPlusLastVBlankNs() const
 std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR10Plus(
     double pts, const CDVMetadataBuffer& metadata)
 {
+  bool wasSending = false;
+  bool byChoice = false;
   if (m_dvPlusRestart.exchange(false))
   {
     // (Hades: what was sent is forgotten by DVPlusEnd(): the player information is told)
-    const bool wasSending = m_dvPlusSending;
+    wasSending = m_dvPlusSending;
+    byChoice = m_dvPlusChoiceRestart.exchange(false);
     DVPlusEnd();
     if (wasSending)
       PublishDVInfo(true);
@@ -3729,6 +3778,9 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
                       : "every percentile of maxRGB measured");
       }
     }
+    // Hades: in the middle of a video, HDR10+ that starts or ends by the choice of the user
+    if (byChoice)
+      DVPlusMidVideo(wasSending, m_dvPlusOn == 1);
   }
   if (m_dvPlusOn != 1 || pts == DVD_NOPTS_VALUE)
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 918c885..b37080d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -241,7 +241,11 @@ public:
   //! Hades: the user chose another output for the video that plays (DVBRIDGE::SetOutputChoice(),
   //! any thread): whether a picture rebuilt for output as HDR10 goes out as HDR10 or as HDR10+ is
   //! decided again, with the next one (DVConversionHDR10Plus())
-  void DVConversionChoiceChanged() { m_dvPlusRestart = true; }
+  void DVConversionChoiceChanged()
+  {
+    m_dvPlusChoiceRestart = true; // (first: a restart seen is then one of a choice)
+    m_dvPlusRestart = true;
+  }
   /*!
    * \brief Hades: Dolby Vision sent as HDR10+ (videoscreen.hadesdvashdr10plus, dvbridge_dvplus.h):
    *        the HDR10+ InfoFrame that goes out with the frame of a picture rebuilt for output as
@@ -591,6 +595,10 @@ private:
   //! the time of the last vblank of the output (CLOCK_MONOTONIC, ns), 0 where it cannot be had
   int64_t DVPlusLastVBlankNs() const;
   std::atomic<bool> m_dvPlusRestart{false};
+  //! Hades: ... because the user chose another output in the middle of the video
+  //! (DVConversionChoiceChanged()): HDR10+ that starts or ends then (DVPlusMidVideo())
+  std::atomic<bool> m_dvPlusChoiceRestart{false};
+  void DVPlusMidVideo(bool wasSending, bool sends);
   std::atomic<bool> m_dvPlusSending{false};
   void DVPlusMeasure(const CDVBridgeGLES::Layer& layer, const CDVMetadataBuffer& metadata);
   void DVPlusEnd();
