 if(ENABLE_DVBRIDGE)
   list(APPEND SOURCES OutputHandover.cpp)
   list(APPEND HEADERS DVBridgeRefused.h
+                      DVDualMode.h
                       OutputHandover.h
                       DVHdmi14b.h
                       LibdrmKms.h
diff --git a/xbmc/windowing/gbm/drm/DVDualMode.h b/xbmc/windowing/gbm/drm/DVDualMode.h
new file mode 100644
index 0000000..257c40f
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVDualMode.h
@@ -0,0 +1,118 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: Dolby Vision through a passive DisplayPort dual-mode (DP++) adaptor on a DisplayPort
+ *        connector of the kernel's tunnel (amdgpu)
+ *
+ * A passive adaptor makes the DisplayPort output of the graphics card send HDMI itself: for the
+ * display it is HDMI from the card, InfoFrames included, within the TMDS clock of the adaptor. The
+ * driver keeps calling the connector DisplayPort. amdgpu gives such a connector (one of a single
+ * stream) the tunnel property (DVBRIDGE_DV_STANDARD_LAB) and DVBRIDGE_DUAL_MODE, read only, which
+ * it writes when it looks at the display: none (a DisplayPort display, an active converter, or
+ * nothing), "HDMI adaptor" (an adaptor that identifies itself as an HDMI one, with an HDMI
+ * display: the tunnel goes through it), or "other adaptor" (a DVI adaptor, or one without the HDMI
+ * signature: nothing says that HDMI reaches the display, and the kernel refuses the tunnel there).
+ * The kernel refuses the tunnel on such a connector unless the value is "HDMI adaptor"; Kodi offers
+ * it only then, so that a DisplayPort display or a converter is told why, as before, and nothing is
+ * tried there.
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+namespace DV_DUAL_MODE
+{
+
+constexpr std::string_view PROPERTY = "DVBRIDGE_DUAL_MODE";
+
+//! DVBRIDGE_DUAL_MODE (enum amdgpu_dvbridge_dual_mode of the kernel)
+enum class Adaptor : uint64_t
+{
+  NONE = 0,
+  HDMI = 1,
+  OTHER = 2,
+};
+
+//! What Kodi decides of a connector
+struct Offer
+{
+  //! a DisplayPort connector that has the property
+  bool applies = false;
+  //! the tunnel is offered through it (where it applies)
+  bool offered = false;
+  //! the reason code of the Dolby Vision page of the player information when it is not
+  const char* code = "";
+  //! ... and in a sentence, for the log
+  const char* reason = "";
+};
+
+/*!
+ * \param displayPort the connector is a DisplayPort one
+ * \param value DVBRIDGE_DUAL_MODE as the kernel wrote it, nothing where the connector has no such
+ *        property (a kernel without it, or another driver: what was decided before stands)
+ */
+inline Offer Decide(bool displayPort, const std::optional<uint64_t>& value)
+{
+  Offer offer;
+  if (!displayPort || !value)
+    return offer;
+  offer.applies = true;
+  // (a value this Kodi does not know is taken as none: fail closed)
+  const auto adaptor = static_cast<Adaptor>(*value > 2 ? 0 : *value);
+  if (adaptor == Adaptor::HDMI)
+  {
+    offer.offered = true;
+    return offer;
+  }
+  // (the code of the player information stays "converter": its text says that the display is on a
+  // DisplayPort output or converter, which this is)
+  offer.code = "converter";
+  offer.reason =
+      adaptor == Adaptor::OTHER
+          ? "the display is on a connector that the driver calls DisplayPort, behind a passive "
+            "dual-mode adaptor that does not identify itself as an HDMI one, or to a display that "
+            "takes DVI only; Dolby Vision goes only through a passive adaptor that says it is "
+            "an HDMI one"
+          : "the display is on a connector that the driver calls DisplayPort, and no passive "
+            "dual-mode (DP++) adaptor is behind it (a DisplayPort display, or a DisplayPort or "
+            "USB-C to HDMI converter); native output needs an HDMI connector or such an adaptor";
+  return offer;
+}
+
+/*!
+ * \brief Whether a connector that has the kernel's tunnel property (DVBRIDGE_DV_STANDARD_LAB) is an
+ *        output of the kernel's tunnel: where the policy of the converter of a board applies
+ *        (DVConverter.h, i915 and xe), what it says; where this one applies (amdgpu), what it says;
+ *        otherwise always, as before either existed (an HDMI connector, or a kernel without them)
+ */
+inline bool KernelOffered(bool converterApplies, bool converterOffered, const Offer& dual)
+{
+  if (converterApplies)
+    return converterOffered;
+  return !dual.applies || dual.offered;
+}
+
+//! What kodi.log says of the way in, for the status of native output
+inline std::string_view Way(const std::optional<uint64_t>& value)
+{
+  if (value && *value == static_cast<uint64_t>(Adaptor::HDMI))
+    return ", on a DisplayPort connector through a passive dual-mode adaptor that identifies "
+           "itself as an HDMI one (DVBRIDGE_DUAL_MODE is \"HDMI adaptor\")";
+  return {};
+}
+
+} // namespace DV_DUAL_MODE
+} // namespace KODI::WINDOWING::GBM
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
index 0cdba9d..e200247 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.cpp
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -91,6 +91,12 @@ CDetectedProperty& DualModeKept()
   static CDetectedProperty kept;
   return kept;
 }
+//! Hades: DVBRIDGE_DUAL_MODE of the connector in use, as the kernel wrote it (DVDualMode.h)
+CDetectedProperty& KernelDualModeKept()
+{
+  static CDetectedProperty kept;
+  return kept;
+}
 
 bool AnySet(CDRMConnector& connector, const char* const* names, size_t count)
 {
@@ -134,6 +140,21 @@ DV_CONVERTER::Offer COutputHandover::ConverterOffer(CDRMConnector& connector)
                               ConverterVerdict(connector));
 }
 
+std::optional<uint64_t> COutputHandover::DualModeVerdict(CDRMConnector& connector)
+{
+  if (connector.GetType() != "DP" || !connector.SupportsProperty(DV_DUAL_MODE::PROPERTY))
+    return std::nullopt;
+  // (the kernel writes it when it looks at the display: so from the kernel, once after each of
+  // those looks, CDetectedProperty)
+  return KernelDualModeKept().Get(connector.GetId(), [&connector]
+                                  { return connector.ReadPropertyValue(DV_DUAL_MODE::PROPERTY); });
+}
+
+DV_DUAL_MODE::Offer COutputHandover::DualModeOffer(CDRMConnector& connector)
+{
+  return DV_DUAL_MODE::Decide(connector.GetType() == "DP", DualModeVerdict(connector));
+}
+
 COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
 {
   if (connector.SupportsProperty(KERNEL_DV))
@@ -141,8 +162,12 @@ COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
     // A DisplayPort connector that reaches the display through the converter of its board
     // (DVBRIDGE_DV_CONVERTER) is a kernel output only where the policy offers it: a board where it
     // was seen working, or one the user asked for. Without that property: always.
+    // Hades: ... and one of amdgpu (DVBRIDGE_DUAL_MODE) only through a passive dual-mode adaptor
+    // that identifies itself as an HDMI one (DVDualMode.h). Without either property: always.
     const auto offer = ConverterOffer(connector);
-    return (!offer.applies || offer.offered) ? Driver::KMS_PROPERTIES : Driver::NONE;
+    return DV_DUAL_MODE::KernelOffered(offer.applies, offer.offered, DualModeOffer(connector))
+               ? Driver::KMS_PROPERTIES
+               : Driver::NONE;
   }
   // nvidia-drm: an HDMI connector, or a DisplayPort one that the card drives as HDMI now
   // (NvidiaDualMode.h; the kernel sets the value when the display is found)
diff --git a/xbmc/windowing/gbm/drm/OutputHandover.h b/xbmc/windowing/gbm/drm/OutputHandover.h
index 9c1d716..b398250 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.h
+++ b/xbmc/windowing/gbm/drm/OutputHandover.h
@@ -10,6 +10,7 @@
 
 #include "DRMObject.h"
 #include "DVConverter.h"
+#include "DVDualMode.h"
 #include "DVHdmi14b.h"
 #include "OutputState.h"
 
@@ -58,6 +59,12 @@ public:
   static DV_CONVERTER::Offer ConverterOffer(CDRMConnector& connector);
   //! DVBRIDGE_DV_CONVERTER of a DisplayPort connector that has it (nothing otherwise)
   static std::optional<uint64_t> ConverterVerdict(CDRMConnector& connector);
+  //! Hades: what DV_DUAL_MODE::Decide() says of this connector: a DisplayPort connector of the
+  //! kernel's tunnel behind a passive dual-mode adaptor (read from the kernel after each look at
+  //! the display)
+  static DV_DUAL_MODE::Offer DualModeOffer(CDRMConnector& connector);
+  //! Hades: DVBRIDGE_DUAL_MODE of a DisplayPort connector that has it (nothing otherwise)
+  static std::optional<uint64_t> DualModeVerdict(CDRMConnector& connector);
   //! The driver of the connector can send Dolby Vision Low-Latency over its tunnel (the kernel:
   //! DVBRIDGE_DV_LOW_LATENCY_LAB, linux-9948 to 9950; nvidia-drm: NV_HDMI_DV_LOW_LATENCY,
   //! nvidia-open-kernel-modules-9030)
