From 0aed4c65312b83fdf2c354ba1e1b1889be4f45a5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:25:08 +0000
Subject: [PATCH] windowing/gbm: native Dolby Vision and HDMI 3D through a
 passive DisplayPort dual-mode adaptor

A passive DisplayPort dual-mode adaptor (DP++) makes the DisplayPort
output of the graphics card send HDMI itself; the driver keeps calling
the connector DisplayPort.

amdgpu now gives such a connector (single stream) the tunnel property
and DVBRIDGE_DUAL_MODE, read only, which it writes when it looks at the
display: "none" (a DisplayPort display, an active converter, or
nothing), "HDMI adaptor" (one that identifies itself as an HDMI one,
with an HDMI display: the kernel takes the tunnel through it), or "other
adaptor" (the kernel refuses it). COutputHandover::DriverOf() takes such
a connector for a kernel output only with "HDMI adaptor"
(DV_DUAL_MODE::Decide() and ::KernelOffered(), DVDualMode.h); otherwise
the reason is "converter" as before, and kodi.log says what is behind
the port. The status line of native output says that it goes through
the adaptor. A kernel without the property, an HDMI connector and the
converter of a board (DVBRIDGE_DV_CONVERTER) are as before.

The half 3D layouts that Kodi tells nvidia-drm by the vendor InfoFrame
were asked of an HDMI connector only; a dual-mode DisplayPort connector
that the card drives as HDMI now (NV_DUAL_MODE_TMDS 1,
NVIDIA_DUAL_MODE::DrivenAsHdmi()) takes the same InfoFrame (and its
frame packed modes come from the driver).

The value is read through the cache of CDetectedProperty, once after each
look of the kernel at the display, as NV_DUAL_MODE_TMDS and
DVBRIDGE_DV_CONVERTER are, and so is NV_DUAL_MODE_TMDS for the 3D offers.

Host test (DVDualMode.h, DVConverter.h and NvidiaDualMode.h as they are):
42 checks; five mutants of the decision each fail. Compiled: the two
files changed, and the six of Linux that include WinSystemGbmGLESContext.h,
with the commands of the build.

Not tried with an adaptor on hardware.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp       |  29 +++++-
 xbmc/windowing/gbm/drm/CMakeLists.txt     |   1 +
 xbmc/windowing/gbm/drm/DVDualMode.h       | 118 ++++++++++++++++++++++
 xbmc/windowing/gbm/drm/OutputHandover.cpp |  27 ++++-
 xbmc/windowing/gbm/drm/OutputHandover.h   |   7 ++
 5 files changed, 180 insertions(+), 2 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/DVDualMode.h

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 324939e..8f4dfba 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -802,8 +802,21 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
   // display of a half layout in the 2D mode, for the timings that the display's EDID says it
   // takes in that layout, where the driver lists no mode for it. (Not looked up for the
   // question of another thread, which is about frame packing.)
+  // (Hades: an HDMI connector, or a dual-mode DisplayPort one that the card drives as HDMI now,
+  // NVIDIA_DUAL_MODE::DrivenAsHdmi(): nvidia-drm takes the vendor InfoFrame there too)
   CDRMConnector* connector = m_DRM->GetConnector();
-  if (drawing && allowed.infoFrame && edid.read && connector->GetType() == "HDMI-A" &&
+  std::optional<uint64_t> dualModeTmds;
+  if (drawing && connector->GetType() == "DP" &&
+      connector->SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+  {
+    // (from the kernel, which writes it when it looks at the display: once after each such look,
+    // CDetectedProperty, as the handover reads it)
+    static CDetectedProperty kept;
+    dualModeTmds = kept.Get(connector->GetId(), [connector]
+                            { return connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY); });
+  }
+  if (drawing && allowed.infoFrame && edid.read &&
+      NVIDIA_DUAL_MODE::DrivenAsHdmi(connector->GetType(), dualModeTmds) &&
       connector->SupportsProperty("NV_HDMI_VSIF_METADATA"))
   {
     for (STEREO::Offer& offer : offers)
@@ -1463,11 +1476,18 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
     // Hades: ... or the driver offers the tunnel through it (DVBRIDGE_DV_CONVERTER), and the
     // policy says why it does not: the setting is off, or the board is not on the list
     const auto offer = COutputHandover::ConverterOffer(*connector);
+    // Hades: ... or (amdgpu) no passive dual-mode adaptor that says it is an HDMI one is behind it
+    const auto dual = COutputHandover::DualModeOffer(*connector);
     if (offer.applies)
     {
       code = offer.code;
       reason = offer.reason;
     }
+    else if (dual.applies)
+    {
+      code = dual.code;
+      reason = dual.reason;
+    }
     else
     {
       code = "converter";
@@ -1566,6 +1586,11 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
   if (anyMode)
     return reason == nullptr;
 
+  // Hades: what the status says of a passive dual-mode adaptor that native output goes through
+  const std::string_view dualModeWay =
+      backend == COutputHandover::Driver::KMS_PROPERTIES
+          ? DV_DUAL_MODE::Way(COutputHandover::DualModeVerdict(*connector))
+          : std::string_view();
   // Log the verdict once per change, for diagnosing why Dolby Vision is (not) used.
   const std::string status =
       reason ? std::string("unavailable: ") + reason
@@ -1577,6 +1602,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
                         ? DV_CONVERTER::Way(DV_CONVERTER::UseOf(DVConverterUse()),
                                             COutputHandover::ConverterVerdict(*connector))
                         : std::string()) +
+                   // Hades: ... through a passive dual-mode adaptor (DV_DUAL_MODE::Way())
+                   std::string(dualModeWay) +
                    // Hades: the TMDS output of a dual-mode DP connector (NvidiaDualMode.h)
                    (backend == COutputHandover::Driver::NVIDIA_DRM && connector->GetType() == "DP"
                         ? ", on a dual-mode DisplayPort connector that the graphics card drives "
