--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -26953,7 +26953,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadesdvnotrims"
 #: system/settings/settings.xml
 msgctxt "#40921"
-msgid "Dolby Vision films carry the colourist's trims: small corrections that say how each scene should look on a display of a few given peak brightnesses (100, 600 or 1000 nits, for instance). Off (the usual): where LibreELEC Hades adjusts Dolby Vision to your display itself (shown as HDR10 adjusted to the display, as SDR, or in Low-Latency), it uses the trims made for exactly your display's peak brightness, if the film has them; if it has none for that brightness, nothing changes. On: those trims are ignored there, and the picture is adjusted from each scene's brightness alone. When your TV does Dolby Vision itself (native output), the TV applies the trims on its own and this only decides whether they are sent to it: turn it on only if the TV shows washed-out blacks or wrong colours because of them, as some projectors do. Applies from the next video."
+msgid "Dolby Vision films carry the colourist's trims: small corrections that say how each scene should look on a display of a few given peak brightnesses (100, 600 or 1000 nits, for instance). When your TV does Dolby Vision itself (native output), the TV applies the trims on its own, and this decides whether they are sent to it. Off (the usual): they are sent. On: they are not; turn it on only if the TV shows washed-out blacks or wrong colours because of them, as some projectors do. Where LibreELEC Hades adjusts Dolby Vision to your display itself (shown as HDR10 adjusted to the display, as SDR, or in Low-Latency), it applies the trims only if \"Dolby Vision: apply the trims when adjusting to your display\" is on, and never while this is on. Applies from the next video."
 msgstr ""
 
 #. Hades: label of setting "videoscreen.hadesdvfromhdr10plus" (group "Dolby Vision")
@@ -27624,6 +27624,18 @@ msgctxt "#41460"
 msgid "BT.2390, libplacebo's knee"
 msgstr ""
 
+#. Hades: label of setting "videoscreen.hadesdvtrimpass" (group "Dolby Vision"); translated in Estuary (#33461)
+#: system/settings/settings.xml
+msgctxt "#41461"
+msgid "Dolby Vision: apply the trims when adjusting to your display"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvtrimpass"; translated in Estuary (#33462)
+#: system/settings/settings.xml
+msgctxt "#41462"
+msgid "Some Dolby Vision films carry trims made for exactly your display's peak brightness. Where LibreELEC Hades adjusts Dolby Vision to your display itself (shown as HDR10 adjusted to the display, as SDR, or in Low-Latency), this decides whether it applies them. Off (the default): it does not, and the picture is adjusted from each scene's brightness alone. The standards describe only one way to apply them, as an example; compared with a studio's own version of a film for a 1000-nit display, that way made the shadows much darker than the studio did (in one scene, everything darker than about 11 nits turned black), so it stays off until the right way is known. On: they are applied that way. A TV that does Dolby Vision itself (native output) applies the trims on its own and is not affected by this. Nothing changes while \"Dolby Vision: ignore the studio's fine-tuning (trims)\" is on. Applies from the next video."
+msgstr ""
+
