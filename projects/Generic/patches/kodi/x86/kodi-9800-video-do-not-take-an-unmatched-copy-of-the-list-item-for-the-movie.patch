From 928a6146d3831c55f15c772985e570b98dbd2f5b Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Thu, 29 Oct 2026 00:16:01 +0100
Subject: [PATCH] [Video] Do not take an unmatched copy of the list item for
 the movie

In the files view the refreshed movie is looked up again on a copy of
its list item. When the library has no match for the copy, it keeps the
old details, and it was only rejected when its database id differed from
the refreshed movie's. That relies on the refreshed movie always having
a new id, which it does not when its details could not be read back
after the refresh. The copy's id is now cleared first, so only a match
from the library is taken.
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index b3654f6..7074556 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -674,6 +674,9 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
     {
       CFileItemList items{m_vecItems->GetPath()};
       newItem = std::make_shared<CFileItem>(*listItem);
+      // the copy keeps the old details unless the library has a match for it
+      if (newItem->HasVideoInfoTag())
+        newItem->GetVideoInfoTag()->m_iDbId = -1;
       items.Add(newItem);
       LoadVideoInfo(items, m_database);
       if (!newItem->HasVideoInfoTag() ||
