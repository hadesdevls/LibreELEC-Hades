From 2e8a32f71500fe3db0300c08cd8888cd3d43854a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:13:28 +0000
Subject: [PATCH] VideoPlayer: profile 8.1 can be rebuilt for Dolby Vision sent
 as HDR10+

Where Dolby Vision is not sent natively, a stream of profile 8.1 plays its
base layer, the HDR10 version of its film, as plain HDR10. For Dolby Vision
sent as HDR10+ it has to be rebuilt, so that the HDR10+ metadata are measured
from the picture that goes out and its scenes come from its RPU.

ConversionTargetOf() takes whether Dolby Vision goes out as HDR10+ (false by
default: every caller as before), and ConversionEligibleForHDR10Plus() says
what that adds: profile 8.1 without an enhancement layer, unless the
conversion is off (or Kodi's own output is chosen), and never for software
decoding, interlaced or stereoscopic video. Profile 7 follows the setting of
its enhancement layer as before.

Host test (dvplus_policy_test.cpp): of 46 080 combinations, every one as
before without HDR10+, and with it only the 8 of profile 8.1 change; the
cases by name. Against the header before, it does not build (the argument does
not exist).
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 4552850..de2bb54 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -341,6 +341,32 @@ constexpr bool ConversionEligible(ConversionSetting setting,
          (setting == ConversionSetting::ALSO_ENHANCEMENT && profile == 7 && enhancementLayer);
 }
 
+/*!
+ * \brief Hades: whether a Dolby Vision stream is reconstructed and sent as HDR10 for Dolby Vision
+ *        sent as HDR10+ (videoscreen.hadesdvashdr10plus), besides those that ConversionEligible()
+ *        takes
+ *
+ * hdr10Plus: the setting is on and the display takes HDR10+ (CWinSystemGbmGLESContext::
+ * DVPlusPossible()). Then a stream of profile 8.1 (its base layer the HDR10 version of its film,
+ * BaseLayerIsHdr10(), and no enhancement layer) is reconstructed too, so that the HDR10+ metadata
+ * measured from the picture go out with it (and its scenes are those of its RPU); before, it
+ * played its base layer as HDR10. A stream of profile 7 follows the setting of the enhancement
+ * layer as before (ALSO_ENHANCEMENT); nothing while the conversion is off (NEVER), and never what
+ * is kept from the Dolby Vision renderer anyway.
+ */
+constexpr bool ConversionEligibleForHDR10Plus(bool hdr10Plus,
+                                              ConversionSetting setting,
+                                              int profile,
+                                              int compatibility,
+                                              bool enhancementLayer,
+                                              bool softwareProbe,
+                                              bool interlaced,
+                                              bool stereo)
+{
+  return hdr10Plus && setting != ConversionSetting::NEVER && !softwareProbe && !interlaced &&
+         !stereo && profile == 8 && BaseLayerIsHdr10(profile, compatibility) && !enhancementLayer;
+}
+
 /*!
  * \brief Hades: the base layer of a Dolby Vision stream is known to be a picture by itself: the
  *        record of the stream gives its profile, and it is not one whose base layer is no picture
@@ -476,11 +502,15 @@ constexpr ConversionTarget ConversionTargetOf(bool hdr10Output,
                                               bool enhancementLayer,
                                               bool softwareProbe,
                                               bool interlaced,
-                                              bool stereo)
+                                              bool stereo,
+                                              bool hdr10Plus = false)
 {
   if (hdr10Output)
     return ConversionEligible(ConversionSettingFor(settings, choice), profile, compatibility,
-                              enhancementLayer, softwareProbe, interlaced, stereo)
+                              enhancementLayer, softwareProbe, interlaced, stereo) ||
+                   ConversionEligibleForHDR10Plus(hdr10Plus, ConversionSettingFor(settings, choice),
+                                                  profile, compatibility, enhancementLayer,
+                                                  softwareProbe, interlaced, stereo)
                ? ConversionTarget::HDR10
                : ConversionTarget::NONE;
   return sdrOutput && SdrConversionEligible(choice, profile, compatibility, reference,
