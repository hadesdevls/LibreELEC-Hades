+#pragma once
+
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: HDR10+ sent as Dolby Vision (videoscreen.hadesdvfromhdr10plus) where the stream's
+ *        own statistics are missing: the scenes without them get a level 1 block measured from the
+ *        picture, as HDR10 measured as Dolby Vision (videoscreen.hadesdvfromhdr10,
+ *        dvbridge_measured.h) makes one, and the display stays in Dolby Vision
+ *
+ * Until now a picture whose HDR10+ metadata give no level 1 block (no distribution, percentiles
+ * that go down: dvbridge_hdr10plus_level1()), or that has no HDR10+ metadata at all (credits, a
+ * stream that leaves them out), went out with the metadata of the last scene that had them, as a
+ * repeated RPU: twelve of them in a row and the stream went to the ordinary output, HDR10, so that
+ * the display left Dolby Vision and came back 48 or more pictures after the statistics did.
+ *
+ * Each scene has one source, kept for the whole scene, so that the display's mapping does not
+ * change source in the middle of a shot:
+ *  - a scene of the stream's own HDR10+ statistics (OWN) goes out with the
+ *    metadata the decoder made of them, as before; the first picture after measured ones carries a
+ *    scene refresh (the display was sent another level 1);
+ *  - a scene of HDR10+ metadata from which no level 1 block can be made
+ *    (INCOMPLETE) is measured; it starts where its HDR10+ metadata say that a
+ *    scene starts (CUT), which is where the source changes, and the
+ *    measurement starts a scene there whatever it sees;
+ *  - pictures without HDR10+ metadata (NONE) have no cuts of their own: in a
+ *    scene of HDR10+ metadata, they keep its metadata (a gap of a few pictures in a shot) until
+ *    the measurement finds a scene cut, where the measurement takes over; after measured pictures,
+ *    or before any scene, they are measured.
+ * Within a measured scene the level 1 block is what the measurement sends: its scene cuts are
+ * found as for HDR10 (dvbridge_measured_take()), and changes within a scene are as small as there.
+ * A picture of a measured scene that nothing of the scene was measured for yet (the measurement
+ * comes a frame or more after the picture is drawn; Kodi measures the pictures queued ahead, so
+ * this is rare) keeps the level 1 block that went out last.
+ *
+ * This class only decides, so that a test runs it on the host: the window system measures the
+ * pictures that are not of their own statistics (CWinSystemGbmGLESContext::DVHdr10PlusMetadata()),
+ * asks the measurement what Before() says, and writes into the picture's metadata what After()
+ * says. Nothing is measured, and no metadata change, for a stream whose statistics are all there.
+ */
+class CDVHdr10PlusFill
+{
+public:
+  //! What a picture is: the values of dvbridge_hdr10plus_next_of() (DVBRIDGE_HDR10PLUS_OWN,
+  //! _INCOMPLETE, _NONE, _KIND and _CUT, which the window system checks these against; the
+  //! module's header is not included here, so that this one needs no FFmpeg)
+  static constexpr unsigned int OWN = 1;
+  static constexpr unsigned int INCOMPLETE = 2;
+  static constexpr unsigned int NONE = 3;
+  static constexpr unsigned int KIND = 0x0f;
+  static constexpr unsigned int CUT = 0x10;
+  //! What the measurement is asked for a picture (Before())
+  enum class Take
+  {
+    NONE, //!< nothing: the picture is of its own statistics (and not measured)
+    DETECT, //!< dvbridge_measured_take(): its own scene cuts
+    CUT, //!< dvbridge_measured_take_cut(): a scene starts at this picture
+  };
+  //! The source of a scene
+  enum class Source
+  {
+    NONE, //!< no scene yet (a new stream, a seek)
+    HDR10PLUS,
+    MEASURED,
+  };
+  //! What the measurement said of a picture (dvbridge_measured_l1 and what take returned)
+  struct Measured
+  {
+    bool found = false; //!< the picture was measured in time (take returned true)
+    bool measured = false; //!< a level 1 block is there (dvbridge_measured_l1::measured)
+    bool refresh = false; //!< ... with a scene refresh
+    unsigned int min = 0, max = 0, avg = 0;
+  };
+  //! What goes out with a picture
+  struct Out
+  {
+    //! the level 1 block and the scene refresh below go into the picture's metadata (else they
+    //! go out as the decoder made them)
+    bool apply = false;
+    unsigned int min = 0, max = 0, avg = 0;
+    bool refresh = false;
+    Source source = Source::NONE;
+    //! the picture starts a measured scene (for the log; the picture is INCOMPLETE or NONE)
+    bool measuredSceneStarts = false;
+  };
+  struct Counts
+  {
+    unsigned int hdr10PlusScenes = 0; //!< scenes of the stream's own statistics
+    unsigned int incompleteScenes = 0; //!< measured scenes of HDR10+ metadata without statistics
+    unsigned int withoutScenes = 0; //!< measured stretches of pictures without HDR10+ metadata
+    unsigned int measuredCuts = 0; //!< scene cuts found by the measurement in measured scenes
+    unsigned int measuredPictures = 0; //!< pictures that went out with a measured level 1 block
+    unsigned int keptPictures = 0; //!< ... of a measured scene not measured yet: the last one kept
+    unsigned int gapPictures = 0; //!< pictures without their own that kept their scene's metadata
+    unsigned int ownPictures = 0;
+  };
+
+  //! What the measurement is asked for the picture presented now; kind: OWN, INCOMPLETE or NONE,
+  //! with CUT (dvbridge_hdr10plus_next_of())
+  Take Before(unsigned int kind)
+  {
+    const unsigned int k = kind & KIND;
+    if (k != INCOMPLETE && k != NONE)
+    {
+      m_stretch = false;
+      m_take = Take::NONE;
+      return m_take;
+    }
+    // (the first picture measured after pictures that were not, whose measurement is of long ago,
+    // starts a scene of the measurement; so does a cut of HDR10+ metadata without statistics)
+    const bool start = !m_stretch;
+    m_stretch = true;
+    m_take = start || (k == INCOMPLETE && (kind & CUT))
+                 ? Take::CUT
+                 : Take::DETECT;
+    return m_take;
+  }
+
+  //! What goes out with that picture. own: the level 1 block of its metadata as the decoder made
+  //! them (min, max, average), ownValid: they have one; measured: what the measurement said, where
+  //! Before() asked it for something (else ignored).
+  Out After(unsigned int kind, const unsigned int own[3], bool ownValid, const Measured& measured)
+  {
+    Out out;
+    const unsigned int k = kind & KIND;
+    const bool cut = (kind & CUT) != 0;
+    if (k != INCOMPLETE && k != NONE)
+    {
+      // of its own statistics: as the decoder made them; a scene refresh where the display was
+      // sent another source before
+      const bool back = m_source != Source::HDR10PLUS;
+      if (cut || back)
+        ++m_counts.hdr10PlusScenes;
+      ++m_counts.ownPictures;
+      m_source = Source::HDR10PLUS;
+      out.source = m_source;
+      if (back && !cut && ownValid && m_hadOutput)
+      {
+        out.apply = true;
+        out.min = own[0];
+        out.max = own[1];
+        out.avg = own[2];
+        out.refresh = true;
+      }
+      Keep(ownValid, own);
+      return out;
+    }
+    // (a refresh of the measurement that is the start it was asked for, now or for a picture before
+    // it that was not measured in time, is no cut it found)
+    const bool given = m_take == Take::CUT || m_givenPending;
+    if (m_take == Take::CUT)
+      m_givenPending = !measured.found;
+    else if (m_givenPending && measured.refresh)
+      m_givenPending = false;
+    const bool foundCut =
+        m_take == Take::DETECT && !given && measured.measured && measured.refresh;
+    const bool incompleteCut = k == INCOMPLETE && cut;
+    bool starts = false;
+    if (m_source == Source::NONE || incompleteCut ||
+        (k == NONE && m_source == Source::HDR10PLUS && foundCut))
+    {
+      starts = true;
+      m_source = Source::MEASURED;
+      m_sceneMeasured = false;
+      ++(k == INCOMPLETE ? m_counts.incompleteScenes : m_counts.withoutScenes);
+    }
+    else if (m_source == Source::MEASURED && foundCut)
+      ++m_counts.measuredCuts;
+    out.source = m_source;
+    out.measuredSceneStarts = starts;
+    if (m_source == Source::HDR10PLUS)
+    {
+      // a picture of a scene of HDR10+ metadata without its own (a gap): the scene's, as the
+      // decoder repeated them
+      ++m_counts.gapPictures;
+      Keep(ownValid, own);
+      return out;
+    }
+    // (the measurement's level 1 block is of this scene once this picture was measured, or once
+    // it refreshed the scene since: a cut it found, or the start it was asked for, of a picture
+    // measured after its presentation; not the refresh of a start asked now and not measured in
+    // time, which is of pictures before it)
+    if (measured.measured && (measured.found || (measured.refresh && m_take != Take::CUT)))
+      m_sceneMeasured = true;
+    if (m_sceneMeasured && measured.measured)
+    {
+      out.apply = true;
+      out.min = measured.min;
+      out.max = measured.max;
+      out.avg = measured.avg;
+      out.refresh = starts || measured.refresh;
+      ++m_counts.measuredPictures;
+    }
+    else if (m_hadOutput)
+    {
+      // nothing of this scene measured yet: what went out last, with the scene's refresh
+      out.apply = true;
+      out.min = m_last[0];
+      out.max = m_last[1];
+      out.avg = m_last[2];
+      out.refresh = starts;
+      ++m_counts.keptPictures;
+    }
+    else
+    {
+      // nothing went out yet: the decoder's (the last made, or its placeholder of the static
+      // metadata), a scene refresh where they can take one
+      out.apply = ownValid;
+      out.min = own[0];
+      out.max = own[1];
+      out.avg = own[2];
+      out.refresh = starts;
+      ++m_counts.keptPictures;
+    }
+    if (out.apply)
+    {
+      const unsigned int sent[3] = {out.min, out.max, out.avg};
+      Keep(true, sent);
+    }
+    else
+      Keep(ownValid, own);
+    return out;
+  }
+
+  //! A seek, or a new stream: no scene goes on (the counts stay; ResetCounts() for a new stream)
+  void Reset()
+  {
+    m_source = Source::NONE;
+    m_stretch = false;
+    m_take = Take::NONE;
+    m_givenPending = false;
+    m_sceneMeasured = false;
+    m_hadOutput = false;
+  }
+  void ResetCounts() { m_counts = {}; }
+  const Counts& GetCounts() const { return m_counts; }
+  Source GetSource() const { return m_source; }
+
+private:
+  void Keep(bool valid, const unsigned int l1[3])
+  {
+    if (!valid)
+      return;
+    m_last[0] = l1[0];
+    m_last[1] = l1[1];
+    m_last[2] = l1[2];
+    m_hadOutput = true;
+  }
+
+  Source m_source = Source::NONE;
+  bool m_stretch = false; //!< the picture before was measured (not of its own statistics)
+  Take m_take = Take::NONE; //!< what Before() asked for the picture of now
+  //! a start asked of the measurement for a picture that was not measured in time: its next
+  //! refresh is that start
+  bool m_givenPending = false;
+  bool m_sceneMeasured = false; //!< the measured scene of now has a measurement of its own
+  bool m_hadOutput = false; //!< a level 1 block went out since the last reset ...
+  unsigned int m_last[3] = {}; //!< ... this one
+  Counts m_counts;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
-- 
