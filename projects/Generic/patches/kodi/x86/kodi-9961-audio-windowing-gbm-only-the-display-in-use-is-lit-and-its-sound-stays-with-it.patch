+/*!
+ * \brief Hades: the display that a device setting was chosen with (CActiveAE::RememberDisplays()),
+ *        kept in a setting of its own (audiooutput.hadesdevicedisplay,
+ *        audiooutput.hadespassthroughdisplay)
+ */
+struct RememberedDisplay
+{
+  //! the output it was read from, as "driver:name" (without the friendly name, which can change)
+  std::string device;
+  KODI::UTILS::DisplayIdentity identity; //!< maker, product and name; its output is not kept
+};
+
+//! The text of a RememberedDisplay: "<maker> <product> <length of the name> <name><device>", the
+//! maker and the product as four hex digits each
+inline std::string RememberedText(const RememberedDisplay& remembered)
+{
+  char head[32];
+  std::snprintf(head, sizeof(head), "%04X %04X %zu ",
+                static_cast<unsigned int>(remembered.identity.maker),
+                static_cast<unsigned int>(remembered.identity.product),
+                remembered.identity.model.size());
+  return head + remembered.identity.model + remembered.device;
+}
+
+//! A RememberedDisplay from its text (RememberedText()); none for an empty text, one that is not
+//! of that form, or one without a maker or a device
+inline std::optional<RememberedDisplay> ParseRemembered(const std::string& text)
+{
+  unsigned int maker = 0;
+  unsigned int product = 0;
+  std::size_t length = 0;
+  int used = -1;
+  // (exactly one space before the name, which may begin with one)
+  if (std::sscanf(text.c_str(), "%4X %4X %zu%n", &maker, &product, &length, &used) != 3 ||
+      used < 0 || static_cast<std::size_t>(used) >= text.size() || text[used] != ' ' ||
+      maker == 0 || maker > 0xFFFF || product > 0xFFFF)
+    return std::nullopt;
+  ++used;
+  if (length > text.size() - static_cast<std::size_t>(used))
+    return std::nullopt;
+  RememberedDisplay remembered;
+  remembered.identity.maker = static_cast<uint16_t>(maker);
+  remembered.identity.product = static_cast<uint16_t>(product);
+  remembered.identity.model = text.substr(used, length);
+  remembered.device = text.substr(used + length);
+  if (remembered.device.empty())
+    return std::nullopt;
+  return remembered;
+}
+
