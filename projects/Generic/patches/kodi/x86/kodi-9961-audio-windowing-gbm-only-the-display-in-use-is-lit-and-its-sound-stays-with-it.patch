+void CActiveAE::RememberDisplays()
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings)
+    return;
+
+  const std::vector<std::pair<std::string, CAEDeviceInfo>> listed = m_sink.ListedOutputs();
+  for (const bool passthrough : {false, true})
+  {
+    const char* id = passthrough ? CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE
+                                 : CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE;
+    const char* rememberedId = passthrough ? CSettings::SETTING_AUDIOOUTPUT_HADESPASSTHROUGHDISPLAY
+                                           : CSettings::SETTING_AUDIOOUTPUT_HADESDEVICEDISPLAY;
+    const AESinkDevice dev = CAESinkFactory::ParseDevice(settings->GetString(id));
+    if (dev.driver.empty() || dev.name.empty())
+      continue;
+    const std::string key = dev.driver + ':' + dev.name;
+    const std::optional<INTERNAL::RememberedDisplay> kept =
+        INTERNAL::ParseRemembered(settings->GetString(rememberedId));
+    if (kept && kept->device == key)
+      continue;
+
+    // (only an HDMI or DisplayPort output that names its display now: a setting that names a
+    // number, from before this was kept, takes the display of that number the first time it has
+    // one, and a setting the user changes takes the display of the output chosen)
+    const auto info = std::ranges::find_if(listed, [&key](const auto& l) { return l.first == key; });
+    if (info == listed.end() || info->second.m_display != CAEDeviceInfo::Display::PRESENT ||
+        !info->second.m_displayIdentity.Known())
+      continue;
+    INTERNAL::RememberedDisplay remembered{key, info->second.m_displayIdentity};
+    remembered.identity.output.clear();
+    settings->SetString(rememberedId, INTERNAL::RememberedText(remembered));
+    settings->Save();
+    CLog::Log(LOGINFO,
+              "ActiveAE - the {} output '{}' of the settings is kept with the display it has now, "
+              "{}: from now on its sound goes to the output that has that display, whatever its "
+              "number",
+              passthrough ? "passthrough" : "audio", key, remembered.identity.Describe());
+  }
+}
+
+INTERNAL::SoundDisplays CActiveAE::DisplaysFor(const std::string& device, bool passthrough) const
+{
+  INTERNAL::SoundDisplays displays;
+  displays.driven = KODI::UTILS::CDrivenDisplay::Get();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings)
+    return displays;
+  displays.lightOthers = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESLIGHTFORSOUND);
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+  const std::optional<INTERNAL::RememberedDisplay> kept = INTERNAL::ParseRemembered(
+      settings->GetString(passthrough ? CSettings::SETTING_AUDIOOUTPUT_HADESPASSTHROUGHDISPLAY
+                                      : CSettings::SETTING_AUDIOOUTPUT_HADESDEVICEDISPLAY));
+  if (kept && !dev.driver.empty() && kept->device == dev.driver + ':' + dev.name)
+    displays.remembered = kept->identity;
+  return displays;
+}
+
 void CActiveAE::LoadSettings()
 {
   const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
 
   // Hades: a device setting that the user has not chosen takes the output of the display first
   ChooseOutputsForTheDisplay();
+  // Hades: ... and the display of each setting is kept (INTERNAL::OutputForDisplayInUse())
+  RememberDisplays();
 
   m_settings.device =
       FollowDisplay(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE),
@@ -3911,6 +3972,20 @@ void CActiveAE::PublishSoundOutputs()
         out.why = d.m_display == CAEDeviceInfo::Display::ABSENT
                       ? "its ELD names no display now, nor did it since Kodi started"
                       : "ALSA gives it no ELD that names its display";
+
+      // Hades: the output of a setting is the display it was chosen with (RememberDisplays()),
+      // which its number may not have today (INTERNAL::OutputForDisplayInUse())
+      if (role.ends_with("of the settings"))
+      {
+        const KODI::UTILS::DisplayIdentity remembered =
+            DisplaysFor(asked, role.find("passthrough") != std::string::npos).remembered;
+        if (remembered.Known() && !KODI::UTILS::SameDisplay(remembered, out.identity))
+        {
+          out.identity = remembered;
+          out.fromBefore = true;
+          out.why.clear();
+        }
+      }
     }
     outputs.push_back(std::move(out));
   }
@@ -4130,12 +4205,18 @@ std::string CActiveAE::ResolveOutput(const std::string& device,
                                      bool passthrough,
