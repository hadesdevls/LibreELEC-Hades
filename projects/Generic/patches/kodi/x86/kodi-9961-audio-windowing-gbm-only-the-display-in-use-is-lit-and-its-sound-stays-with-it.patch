+/*!
+ * \brief Hades: the output that the sound of a configured HDMI or DisplayPort output goes to, by
+ *        the displays (CActiveAESink::FollowDisplay(), before FollowedDisplayOutput())
+ * \param outputs the outputs of the driver of the configured output, with their displays
+ * \param configured the name of the configured output
+ * \param configuredIsDisplayOutput it is an HDMI or DisplayPort output by its name
+ * \param remembered the display that the setting was chosen with (RememberedDisplay); maker 0: none
+ * \param driven the display that Kodi shows its picture on (KODI::UTILS::CDrivenDisplay); maker 0:
+ *        not known
+ * \param lightOthers the expert setting that keeps the display of the audio output lit for its
+ *        sound (audiooutput.hadeslightforsound)
+ * \param choice set to what was decided
+ * \return the index in outputs of the output to use; -1: nothing is decided here
+ *
+ * The driver of an NVIDIA card numbers its HDMI outputs ("hdmi:CARD=NVidia,DEV=0") by the order in
+ * which their displays came, not by the connector: the number chosen in the settings can be
+ * another display from one start to the next (a session of 2026-11-12, three displays on an RTX
+ * 4080 SUPER: the number in the settings was the monitor's, and the sound went to the monitor for
+ * a moment whenever the monitor was lit). So the display that the setting was chosen with is what
+ * counts, and its output is the one that has that display now, whatever its number.
+ *
+ * Only the display in use is lit (the windowing system turns the others off, and lights none for
+ * its sound unless lightOthers is on): an output whose display is not the one in use plays to a
+ * display that is off, or about to go off. Its sound goes to the output of the display in use
+ * instead, where exactly one output has that display. With lightOthers on, the output of the
+ * remembered display stays the output, and the windowing system keeps that display lit for it.
+ * Nothing is decided where the display in use is not known, where no output has its display (a
+ * monitor without audio: the sound of another display is not taken for it; or the instant of a
+ * change of the display mode, when FollowedDisplayOutput() keeps the output followed to), or for
+ * an output that is no HDMI or DisplayPort one.
+ */
+inline int OutputForDisplayInUse(const std::vector<FollowCandidate>& outputs,
+                                 const std::string& configured,
+                                 bool configuredIsDisplayOutput,
+                                 const KODI::UTILS::DisplayIdentity& remembered,
+                                 const KODI::UTILS::DisplayIdentity& driven,
+                                 bool lightOthers,
+                                 DisplayInUseChoice& choice)
+{
+  choice = DisplayInUseChoice::NONE;
+  if (!configuredIsDisplayOutput)
+    return -1;
+
+  int at = -1;
+  for (std::size_t i = 0; i < outputs.size(); ++i)
+  {
+    if (outputs[i].name == configured)
+    {
+      at = static_cast<int>(i);
+      break;
+    }
+  }
+  // (the only output that can be used and has that display now; -1 for none, and for several)
+  const auto only = [&outputs](const KODI::UTILS::DisplayIdentity& display)
+  {
+    int found = -1;
+    for (std::size_t i = 0; i < outputs.size(); ++i)
+    {
+      const FollowCandidate& output = outputs[i];
+      if (output.display != FollowCandidate::Display::PRESENT || !output.usable ||
+          !KODI::UTILS::SameDisplay(display, output.identity))
+        continue;
+      if (found >= 0)
+        return -1;
+      found = static_cast<int>(i);
+    }
+    return found;
+  };
+
+  KODI::UTILS::DisplayIdentity own = remembered;
+  if (!own.Known() && at >= 0 && outputs[at].display == FollowCandidate::Display::PRESENT)
+    own = outputs[at].identity;
+
+  if (own.Known() && (lightOthers || KODI::UTILS::SameDisplay(own, driven)))
+  {
+    const int there = only(own);
+    if (there >= 0)
+    {
+      if (there == at)
+        return -1;
+      choice = DisplayInUseChoice::REMEMBERED;
+      return there;
+    }
+    // (lit by the windowing system for its sound: its output has it then)
+    if (lightOthers)
+      return -1;
+  }
+  if (lightOthers || !driven.Known())
+    return -1;
+
+  const int inUse = only(driven);
+  if (inUse < 0 || inUse == at)
+    return -1;
+  choice = DisplayInUseChoice::DISPLAY_IN_USE;
+  return inUse;
+}
