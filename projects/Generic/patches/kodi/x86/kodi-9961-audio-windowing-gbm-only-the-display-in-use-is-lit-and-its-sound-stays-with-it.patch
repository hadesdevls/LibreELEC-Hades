+// Hades: the output that the sound of a configured HDMI output goes to, by the displays: the one
+// it was chosen with (OutputForDisplayInUse(), RememberedDisplay), the one in use; decided as
+// CActiveAESink::FollowDisplay() does, with FollowedDisplayOutput() after it
+
+namespace
+{
+using ActiveAE::INTERNAL::DisplayInUseChoice;
+using ActiveAE::INTERNAL::OutputForDisplayInUse;
