+
+DisplayIdentity Display(const char* maker, uint16_t product, const char* model)
+{
+  DisplayIdentity id;
+  id.maker = static_cast<uint16_t>(((maker[0] - 'A' + 1) << 10) | ((maker[1] - 'A' + 1) << 5) |
+                                   (maker[2] - 'A' + 1));
+  id.product = product;
+  id.model = model;
+  return id;
+}
+
+// The three displays of the session of 2026-11-12 (RTX 4080 SUPER): the LG C5 (its ELD, with the
+// sound bar on its eARC, names the TV), the Samsung Odyssey G60SD, the LG UltraGear
+const DisplayIdentity LG_C5 = Display("GSM", 0x83CD, "LG TV SSCR2");
+const DisplayIdentity ODYSSEY = Display("SAM", 0x7377, "Odyssey G60SD");
+const DisplayIdentity ULTRAGEAR = Display("GSM", 0x7798, "LG ULTRAGEAR");
+const DisplayIdentity RECEIVER = Display("DON", 0x0041, "AVR-X3800H");
+
+FollowCandidate Hdmi(const char* name, FollowCandidate::Display display,
+                     const DisplayIdentity& identity = {}, bool usable = true)
+{
+  FollowCandidate c = Output(name, display, usable);
+  c.family = "hdmi:NVidia";
+  c.identity = display == PRESENT ? identity : DisplayIdentity{};
+  return c;
+}
+
+// As CActiveAESink::FollowDisplay(): the displays first, then FollowedDisplayOutput()
+int Decide(const std::vector<FollowCandidate>& outputs,
+           const char* configured,
+           const SoundDisplays& displays,
+           DisplayInUseChoice& choice,
+           const char* followed = "")
+{
+  const int byDisplays = OutputForDisplayInUse(outputs, configured, true, displays.remembered,
+                                               displays.driven, displays.lightOthers, choice);
+  return byDisplays >= 0 ? byDisplays
+                         : FollowedDisplayOutput(outputs, configured, true, followed,
+                                                 "hdmi:NVidia");
+}
+
+SoundDisplays Displays(const DisplayIdentity& remembered,
+                       const DisplayIdentity& driven,
+                       bool lightOthers = false)
+{
+  SoundDisplays d;
+  d.remembered = remembered;
+  d.driven = driven;
+  d.lightOthers = lightOthers;
+  return d;
+}
