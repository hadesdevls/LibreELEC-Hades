+  // ... also before the setting was kept with its display (the first start of this version)
+  EXPECT_EQ(2, Decide(start, "hdmi:CARD=NVidia,DEV=0", Displays({}, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+  // The monitors are off: the LG C5 is the only display
+  const std::vector<FollowCandidate> on = {
+      Hdmi("hdmi:CARD=NVidia,DEV=0", ABSENT), Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT),
+      Hdmi("hdmi:CARD=NVidia,DEV=2", PRESENT, LG_C5), Hdmi("hdmi:CARD=NVidia,DEV=3", ABSENT)};
+  EXPECT_EQ(2, Decide(on, "hdmi:CARD=NVidia,DEV=0", Displays(ODYSSEY, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+  // An instant of a change of the display mode (no ELD anywhere): the output followed to stays,
+  // never the Odyssey's number
+  const std::vector<FollowCandidate> instant = {
+      Hdmi("hdmi:CARD=NVidia,DEV=0", ABSENT), Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT),
+      Hdmi("hdmi:CARD=NVidia,DEV=2", ABSENT), Hdmi("hdmi:CARD=NVidia,DEV=3", ABSENT)};
+  EXPECT_EQ(2, Decide(instant, "hdmi:CARD=NVidia,DEV=0", Displays(ODYSSEY, LG_C5), choice,
+                      "hdmi:CARD=NVidia,DEV=2"));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+  // The user moves the picture to the Odyssey in the settings: its sound goes there
+  std::vector<FollowCandidate> moved = on;
+  moved[0] = Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, ODYSSEY);
+  moved[2] = Hdmi("hdmi:CARD=NVidia,DEV=2", ABSENT);
+  EXPECT_EQ(-1, Decide(moved, "hdmi:CARD=NVidia,DEV=0", Displays(ODYSSEY, ODYSSEY), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+  // ... and with the TV's number in the settings, to the Odyssey all the same
+  EXPECT_EQ(0, Decide(moved, "hdmi:CARD=NVidia,DEV=2", Displays(LG_C5, ODYSSEY), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+}
+
+TEST(TestActiveAEFollowDisplay, ANumberThatIsAnotherDisplayTodayFollowsTheDisplay)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  // Chosen as DEV=0 with the LG C5; in this start DEV=0 is the Odyssey, still lit, and the TV is
+  // DEV=2
+  const std::vector<FollowCandidate> outputs = {
+      Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, ODYSSEY), Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT),
+      Hdmi("hdmi:CARD=NVidia,DEV=2", PRESENT, LG_C5)};
+  EXPECT_EQ(2, Decide(outputs, "hdmi:CARD=NVidia,DEV=0", Displays(LG_C5, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // ... and with the display of the audio output kept on (Expert), the same
+  EXPECT_EQ(2, Decide(outputs, "hdmi:CARD=NVidia,DEV=0", Displays(LG_C5, LG_C5, true), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // the number is that display today: nothing to change
+  EXPECT_EQ(-1, Decide(outputs, "hdmi:CARD=NVidia,DEV=2", Displays(LG_C5, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+}
+
+TEST(TestActiveAEFollowDisplay, AReceiverOnItsOwnOutputOnlyWithTheExpertSetting)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  // A receiver on DEV=1 of the card, chosen in the settings; the picture on the TV on DEV=0
+  const std::vector<FollowCandidate> outputs = {
+      Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, LG_C5),
+      Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, RECEIVER)};
+  // the Expert setting on: the receiver stays the output (the windowing system keeps it lit)
+  EXPECT_EQ(-1, Decide(outputs, "hdmi:CARD=NVidia,DEV=1", Displays(RECEIVER, LG_C5, true), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+  // ... also while the receiver is off: the windowing system lights it, nothing is taken for it
+  std::vector<FollowCandidate> receiverOff = outputs;
+  receiverOff[1] = Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT);
+  EXPECT_EQ(-1, OutputForDisplayInUse(receiverOff, "hdmi:CARD=NVidia,DEV=1", true, RECEIVER,
+                                      LG_C5, true, choice));
+  // ... and under another number now: that number
+  const std::vector<FollowCandidate> swapped = {
+      Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, RECEIVER),
+      Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, LG_C5)};
+  EXPECT_EQ(0, Decide(swapped, "hdmi:CARD=NVidia,DEV=1", Displays(RECEIVER, LG_C5, true), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::REMEMBERED);
+  // the Expert setting off (the default): only the TV is lit, and the sound goes to it
+  EXPECT_EQ(0, Decide(outputs, "hdmi:CARD=NVidia,DEV=1", Displays(RECEIVER, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+}
+
+TEST(TestActiveAEFollowDisplay, OneDisplayIsLeftAsItWas)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  const std::vector<FollowCandidate> one = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, LG_C5),
+                                            Hdmi("hdmi:CARD=NVidia,DEV=1", ABSENT)};
+  EXPECT_EQ(-1, Decide(one, "hdmi:CARD=NVidia,DEV=0", Displays(LG_C5, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+  EXPECT_EQ(-1, Decide(one, "hdmi:CARD=NVidia,DEV=0", Displays({}, LG_C5), choice));
+  // a number without a display: the display's output, as before
+  EXPECT_EQ(0, Decide(one, "hdmi:CARD=NVidia,DEV=1", Displays({}, LG_C5), choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::DISPLAY_IN_USE);
+}
+
+TEST(TestActiveAEFollowDisplay, NothingIsDecidedWithoutWhatItNeeds)
+{
+  DisplayInUseChoice choice = DisplayInUseChoice::NONE;
+  const std::vector<FollowCandidate> two = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, ODYSSEY),
+                                            Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, LG_C5)};
+  // the display in use not known (another windowing system)
+  EXPECT_EQ(-1, OutputForDisplayInUse(two, "hdmi:CARD=NVidia,DEV=0", true, ODYSSEY, {}, false,
+                                      choice));
+  // the display in use has no output of its own (a monitor without audio): no other display's
+  EXPECT_EQ(-1, OutputForDisplayInUse(two, "hdmi:CARD=NVidia,DEV=0", true, ODYSSEY, ULTRAGEAR,
+                                      false, choice));
+  // two displays of one model: neither is known to be the one in use
+  const std::vector<FollowCandidate> twins = {Hdmi("hdmi:CARD=NVidia,DEV=0", PRESENT, ODYSSEY),
+                                              Hdmi("hdmi:CARD=NVidia,DEV=1", PRESENT, LG_C5),
+                                              Hdmi("hdmi:CARD=NVidia,DEV=2", PRESENT, LG_C5)};
+  EXPECT_EQ(-1, OutputForDisplayInUse(twins, "hdmi:CARD=NVidia,DEV=0", true, ODYSSEY, LG_C5,
+                                      false, choice));
+  // an output that is no HDMI or DisplayPort one (analog, USB)
+  EXPECT_EQ(-1, OutputForDisplayInUse(two, "@:CARD=PCH,DEV=0", false, {}, LG_C5, false, choice));
+  // an output of the display in use that cannot be used for this kind (passthrough)
+  std::vector<FollowCandidate> pcmOnly = two;
+  pcmOnly[1].usable = false;
+  EXPECT_EQ(-1, OutputForDisplayInUse(pcmOnly, "hdmi:CARD=NVidia,DEV=0", true, ODYSSEY, LG_C5,
+                                      false, choice));
+  EXPECT_TRUE(choice == DisplayInUseChoice::NONE);
+}
+
+TEST(TestActiveAEFollowDisplay, TheRememberedDisplayIsKeptAsText)
+{
+  RememberedDisplay r;
+  r.device = "ALSA:hdmi:CARD=NVidia,DEV=2";
+  r.identity = LG_C5;
+  const std::string text = RememberedText(r);
+  EXPECT_EQ(std::string("1E6D 83CD 11 LG TV SSCR2ALSA:hdmi:CARD=NVidia,DEV=2"), text);
+  const auto back = ParseRemembered(text);
+  ASSERT_TRUE(back.has_value());
+  EXPECT_EQ(r.device, back->device);
+  EXPECT_TRUE(back->identity == LG_C5);
+  // a name with spaces at its ends, or none
+  r.identity.model = " LG ";
+  EXPECT_EQ(std::string(" LG "), ParseRemembered(RememberedText(r))->identity.model);
+  EXPECT_EQ(r.device, ParseRemembered(RememberedText(r))->device);
+  r.identity.model = "";
+  EXPECT_EQ(r.device, ParseRemembered(RememberedText(r))->device);
+  EXPECT_EQ(std::string(""), ParseRemembered(RememberedText(r))->identity.model);
+  // what is not of that form names nothing
+  EXPECT_FALSE(ParseRemembered("").has_value());
+  EXPECT_FALSE(ParseRemembered("ALSA:hdmi:CARD=NVidia,DEV=2").has_value());
+  EXPECT_FALSE(ParseRemembered("0000 83CD 0 ALSA:x").has_value());
+  EXPECT_FALSE(ParseRemembered("1E6D 83CD 40 LG TV SSCR2").has_value());
+  EXPECT_FALSE(ParseRemembered("1E6D 83CD 11 LG TV SSCR2").has_value());
+}
