+  NONE, //!< nothing: the configured output, or what FollowedDisplayOutput() decides
+  REMEMBERED, //!< the output of the display that the setting was chosen with, under another name
+  DISPLAY_IN_USE, //!< the output of the display in use, in place of one of another display
+};
