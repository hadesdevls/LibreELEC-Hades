From c12cf0951fd00441e8475d2bfec8f7bd41c335d7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:30:35 +0000
Subject: [PATCH] tools/dvbridge: draw a picture that is no Dolby Vision one as
 a reconstructed one

The mapping of a reconstructed picture to an SDR output (and to a display)
is libplacebo's colour mapping with the BT.2390 curve and the perceptual
gamut mapping. An HDR10 or HLG picture can go the same way: it needs no
reconstruction, only its colour.

dvbridge_render_plain() draws such a picture into the texture of
dvbridge_render_hdr10(), mapped as dvbridge_render_hdr10_mapping() says, or
as it is without a mapping. Its colour (struct dvbridge_plain): BT.2020
primaries, the BT.2020 matrix for non-constant luminance, PQ or HLG, the
range, and the HDR10 metadata of the stream (the mastering display's white
and black, MaxCLL, MaxFALL; 0 where not known), which must hold: every value
from 0 to 10000 cd/m2 and black below white. The mastering display's
primaries come with the mapping (dvbridge_hdr10_mapping::source_xy), as for a
reconstructed picture. A source with an enhancement layer is refused, and the
step-down levels of the reconstruction do not apply. Anything refused draws
nothing and returns false; the last whole picture is kept.

Measured on the software OpenGL ES (zink on lavapipe, libplacebo with
libplacebo-9942) against libplacebo's mapping written out in double
precision with its exact curves: nine pictures of the base layer of the FEL
test stream (HDR10, mastered to 1000 cd/m2 in DCI-P3, MaxCLL 1000), Delta E
ITP (ITU-R BT.2124) 99.9 % 0.04 to 1.09, at most 1.47; a PQ chart (4000
cd/m2, DCI-P3) and an HLG one, at most 0.59 and 0.39 in the middle of their
patches (more where the chroma of two saturated patches meets at their
edges: up to 35 and 49, cause not verified). The checks of what is refused
pass. The picture of a profile 5 stream, reconstructed and mapped to SDR, is
the same to the bit as before, and so is the render test of the bridge on
the FEL test stream.
---
 tools/dvbridge/dvbridge_render.c | 57 +++++++++++++++++++++++++++++---
 tools/dvbridge/dvbridge_render.h | 20 +++++++++++
 2 files changed, 72 insertions(+), 5 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 7073d2d..5b70bb5 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1188,9 +1188,34 @@ static bool hdr10_texture(struct dvbridge_renderer *r, pl_fmt fmt, pl_tex *tex,
                                                        .sampleable = true, .renderable = true));
 }
 
+/* Hades: the colour of a picture that is no Dolby Vision one (dvbridge_render_plain()): BT.2020,
+ * the matrix of BT.2020 for non-constant luminance, PQ or HLG, and its HDR10 metadata, which must
+ * hold: every value from 0 (not known) to 10000 cd/m2, and the mastering display darker at black
+ * than at white. */
+static bool plain_color(struct dvbridge_color *out, const struct dvbridge_plain *p)
+{
+    const float lumas[] = {p->max_luma, p->min_luma, p->max_cll, p->max_fall};
+    for (unsigned i = 0; i < sizeof(lumas) / sizeof(*lumas); ++i)
+        if (!isfinite(lumas[i]) || lumas[i] < 0 || lumas[i] > 10000)
+            return false;
+    if (p->max_luma && p->min_luma >= p->max_luma)
+        return false;
+    *out = (struct dvbridge_color){
+        .color = {.primaries = PL_COLOR_PRIM_BT_2020,
+                  .transfer = p->hlg ? PL_COLOR_TRC_HLG : PL_COLOR_TRC_PQ,
+                  .hdr = {.min_luma = p->min_luma, .max_luma = p->max_luma,
+                          .max_cll = p->max_cll, .max_fall = p->max_fall}},
+        .repr = {.sys = PL_COLOR_SYSTEM_BT_2020_NC,
+                 .levels = p->full_range ? PL_COLOR_LEVELS_FULL : PL_COLOR_LEVELS_LIMITED},
+    };
+    return true;
+}
+
+/* (Hades: plain, a picture that is no Dolby Vision one, of that colour: no metadata, no layer) */
 static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *source,
                          const void *metadata, size_t bytes, double pts, double el_pts,
-                         struct dvbridge_view view, int width, int height)
+                         struct dvbridge_view view, int width, int height,
+                         const struct dvbridge_plain *plain)
 {
     if (!source || !isfinite(pts) || width < 1 || height < 1 || width > 16384 || height > 16384 ||
         source->num_planes < 1 || source->num_planes > 4 || source->rotation ||
@@ -1201,7 +1226,8 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
             return false;
     const struct pl_frame *el = source->enhancement_layer;
     if (el) {
-        if (el->num_planes < 1 || el->num_planes > 4 || el->rotation || el->enhancement_layer)
+        if (plain || el->num_planes < 1 || el->num_planes > 4 || el->rotation ||
+            el->enhancement_layer)
             return false;
         for (int p = 0; p < el->num_planes; ++p)
             if (!el->planes[p].texture)
@@ -1209,7 +1235,8 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     bool paired = el && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
     struct dvbridge_color mapped;
-    if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
+    if (plain ? !plain_color(&mapped, plain)
+              : !map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
     r->residual_drawn = paired && mapped.dovi.nlq_active;
     /* The format of the picture that the transport is packed from. A half-float one would be half
@@ -1261,7 +1288,8 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     params.skip_caching_single_frame = true;
     params.border = PL_CLEAR_SKIP;
     params.dovi_ccm = !r->legacy_composer;
-    step_down(&params, r->step);
+    /* (the levels step down the reconstruction: a plain picture has none) */
+    step_down(&params, plain ? 0 : r->step);
     bool clamped = false;
     const struct pl_hook hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &clamped,
@@ -1317,7 +1345,26 @@ bool dvbridge_render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *s
         ;
     struct dvbridge_gl_state state;
     save_gl_state(&state);
-    r->hdr10_ready = render_hdr10(r, source, metadata, bytes, pts, el_pts, view, width, height);
+    r->hdr10_ready = render_hdr10(r, source, metadata, bytes, pts, el_pts, view, width, height,
+                                  NULL);
+    restore_gl_state(&state);
+    return r->hdr10_ready;
+}
+
+bool dvbridge_render_plain(struct dvbridge_renderer *r, const struct pl_frame *source,
+                          const struct dvbridge_plain *plain, struct dvbridge_view view,
+                          int width, int height)
+{
+    if (!r || !plain)
+        return false;
+    r->hdr10_ready = false;
+    r->residual_omitted = false;
+    r->residual_drawn = false;
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    save_gl_state(&state);
+    r->hdr10_ready = render_hdr10(r, source, NULL, 0, 0.0, NAN, view, width, height, plain);
     restore_gl_state(&state);
     return r->hdr10_ready;
 }
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 75e8f60..2b5531a 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -66,6 +66,26 @@ struct dvbridge_view {
 bool dvbridge_render_hdr10(struct dvbridge_renderer *renderer, const struct pl_frame *source,
                           const void *metadata, size_t bytes, double pts, double el_pts,
                           struct dvbridge_view view, int width, int height);
+/* Hades: a picture that is no Dolby Vision one, an HDR10 or an HLG one, drawn as
+ * dvbridge_render_hdr10() draws a reconstructed one, into the same texture: mapped as
+ * dvbridge_render_hdr10_mapping() says (to an SDR output, or a display), or as it is without a
+ * mapping. Its colour (struct dvbridge_plain): BT.2020 primaries, the BT.2020 matrix for
+ * non-constant luminance, PQ or HLG, and the HDR10 metadata of the stream, which must hold (from 0,
+ * not known, to 10000 cd/m2, the mastering display darker at black than at white); the mastering
+ * display's primaries come with the mapping (dvbridge_hdr10_mapping::source_xy). A source with an
+ * enhancement layer is refused, and so is metadata that does not hold: false, nothing drawn. */
+#define DVBRIDGE_RENDER_PLAIN 1
+struct dvbridge_plain {
+    bool hlg;           /* the HLG transfer (ARIB STD-B67); else PQ (SMPTE ST 2084) */
+    bool full_range;    /* the YCbCr of the picture in full range; else limited */
+    float max_luma;     /* the mastering display's white, cd/m2 (0: not known) */
+    float min_luma;     /* ... and black */
+    float max_cll;      /* the content light levels, cd/m2 (0: not known) */
+    float max_fall;
+};
+bool dvbridge_render_plain(struct dvbridge_renderer *renderer, const struct pl_frame *source,
+                          const struct dvbridge_plain *plain, struct dvbridge_view view,
+                          int width, int height);
 /* The texture of the last dvbridge_render_hdr10() when it succeeded, or NULL. It goes to the
  * output with dvbridge_gl_copy(). */
 pl_tex dvbridge_render_hdr10_texture(const struct dvbridge_renderer *renderer);
-- 
2.53.0

