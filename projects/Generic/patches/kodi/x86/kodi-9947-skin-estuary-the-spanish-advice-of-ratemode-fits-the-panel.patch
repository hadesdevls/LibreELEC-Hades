From 429709bb9ff43daad3003b7f6bd16dd828b50a65 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:20:08 +0000
Subject: [PATCH] skin.estuary: the Spanish advice of ratemode fits the panel

The advice of the overview page for a display without a mode at the
video's rate (32756) was wider than the panel of the player information
in es_es, es_ar and es_mx (1893, 1931 and 2066 px in a label of 1628 px,
font10). It says the same in fewer words: the name of the setting stays
as Kodi shows it in each language.
---
 addons/skin.estuary/language/resource.language.es_ar/strings.po | 2 +-
 addons/skin.estuary/language/resource.language.es_es/strings.po | 2 +-
 addons/skin.estuary/language/resource.language.es_mx/strings.po | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index fa56c34..cd368d2 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -3875,7 +3875,7 @@ msgstr "Mirá la página Sistema."
 
 msgctxt "#32756"
 msgid "Adjust display refresh rate is on, but the display has no mode at the rate of this video (or the whitelist of the display settings leaves it out)."
-msgstr "«Ajustar la tasa de refresco de la pantalla» está activado, pero la pantalla no tiene un modo a la frecuencia de este video (o la lista blanca de los ajustes de pantalla lo deja afuera)."
+msgstr "«Ajustar la tasa de refresco de la pantalla» está activado, pero la pantalla no ofrece la frecuencia del video (o la lista blanca la excluye)."
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, after a number: 2 more notes
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index 31f4041..5368571 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -3883,7 +3883,7 @@ msgstr "Mira la página Sistema."
 
 msgctxt "#32756"
 msgid "Adjust display refresh rate is on, but the display has no mode at the rate of this video (or the whitelist of the display settings leaves it out)."
-msgstr "«Ajustar tasa de refresco de la pantalla» está activado, pero la pantalla no tiene un modo a la frecuencia de este vídeo (o la lista blanca de los ajustes de pantalla lo deja fuera)."
+msgstr "«Ajustar tasa de refresco de la pantalla» está activado, pero la pantalla no ofrece la frecuencia del vídeo (o la lista blanca la excluye)."
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, after a number: 2 more notes
diff --git a/addons/skin.estuary/language/resource.language.es_mx/strings.po b/addons/skin.estuary/language/resource.language.es_mx/strings.po
index dfc5e6c..eaac5b3 100644
--- a/addons/skin.estuary/language/resource.language.es_mx/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -3883,7 +3883,7 @@ msgstr "Mira la página Sistema."
 
 msgctxt "#32756"
 msgid "Adjust display refresh rate is on, but the display has no mode at the rate of this video (or the whitelist of the display settings leaves it out)."
-msgstr "«Ajustar la frecuencia de actualización de pantalla» está activado, pero la pantalla no tiene un modo a la frecuencia de este video (o la lista blanca de la configuración de pantalla lo deja fuera)."
+msgstr "«Ajustar la frecuencia de actualización de pantalla» está activado, pero la pantalla no ofrece la frecuencia del video (o la lista blanca la excluye)."
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, after a number: 2 more notes
