From 642be13b42d766c5e194ceb9ca2187f5aac226b7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 01:53:47 +0000
Subject: [PATCH] windowing/gbm: a change of resolution on a dual-mode DP
 connector of nvidia-drm goes out from scratch too

On a dual-mode DisplayPort connector that nvidia-drm drives as HDMI, every
change of mode goes out with the head turned off and on, so that the TV takes
the new mode (1.0 RC5, NVIDIA_DUAL_MODE::ModeChangeRestarts()). The decision
compared the mode of res with the selected mode, asked in
CWinSystemGbm::SetFullScreen(). A change of resolution makes a new window
first, in CWinSystemGbmGLESContext::SetFullScreen(), and
CWinSystemGbmEGLContext::CreateNewWindow() selects the mode of res: by the time
the decision was asked, the selected mode was the new one, it was "no change",
and the mode went out in place, which that port does not carry to the TV.

Issue #4 (HP ZBook 17 G6, DP-2, a Hisense TV, 1.0 RC5): with the interface at
1920x1080 at 120 Hz, every video that is not Dolby Vision at 3840x2160 at
23.976 Hz went out in place (no "went out with the output turned off and on"
line, against one for each change that kept the size), and the TV showed it as
3840x2160 at 120 Hz with the left half of the picture on both halves; both
modes run at 297 MHz. Dolby Vision videos were fine: their entry turns the
output off and on again in the mode of the video. Going back to the interface
went out in place too.

The decision now asks of the mode on the output, as Kodi's commits put it
there (CCommittedMode::Known(), CCommittedMode::Differs()), and of the
selected mode only where that is not known; OtherTiming() is kept for the
hold of a change of mode, which is asked before any new window. The line of
a change made from scratch now says how long the output was off and the
pixel clocks before and after it.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp       | 40 +++++++++++++++++++----
 xbmc/windowing/gbm/WinSystemGbm.h         |  3 ++
 xbmc/windowing/gbm/drm/DRMAtomic.h        |  3 ++
 xbmc/windowing/gbm/drm/DRMCommittedMode.h | 21 ++++++++++++
 4 files changed, 60 insertions(+), 7 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index c96973a..3a8325c 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2287,6 +2287,17 @@ bool CWinSystemGbm::ModeFromScratch() const
   return (!advanced || advanced->m_videoDualModeRestart) && DVLinkFromScratch();
 }
 
+bool CWinSystemGbm::OtherThanOnOutput(const RESOLUTION_INFO& res) const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  const int index = std::atoi(res.strId.c_str());
+  if (!connector || res.strId.empty() || index < 0 || index >= connector->GetModesCount())
+    return false;
+  return CCommittedMode<drmModeModeInfo>::Differs(*connector->GetModeForIndex(index),
+                                                  drm->ModeOnOutput(), drm->GetSelectedMode());
+}
+
 bool CWinSystemGbm::ModeChangeRestarts(const RESOLUTION_INFO& res) const
 {
   const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
@@ -2297,7 +2308,7 @@ bool CWinSystemGbm::ModeChangeRestarts(const RESOLUTION_INFO& res) const
   const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
   return NVIDIA_DUAL_MODE::ModeChangeRestarts(
       connector->GetType(), connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY),
-      !advanced || advanced->m_videoDualModeRestart, drm->IsActive(), OtherTiming(res));
+      !advanced || advanced->m_videoDualModeRestart, drm->IsActive(), OtherThanOnOutput(res));
 }
 
 void CWinSystemGbm::FlipModeFromScratch(const RESOLUTION_INFO& res)
@@ -2310,25 +2321,40 @@ void CWinSystemGbm::FlipModeFromScratch(const RESOLUTION_INFO& res)
   // NVKMS brings the head and the link up from scratch in the new mode, as when native Dolby Vision
   // leaves (FlipDVBridgePage()). A refusal of the first commit falls back to the request before it
   // (the head on, the mode before): the second one then makes the change in place, as before.
+  // (Hades: the pixel clocks of the mode on the output and of the new one, and how long the output
+  // was off, for the log: a TV that gets the same clock back after a short gap may not take it for
+  // a new signal)
+  const drmModeModeInfo* was = drm->ModeOnOutput();
+  const int clockBefore = was ? static_cast<int>(was->clock) : 0;
+  const drmModeModeInfo* next = drm->GetSelectedMode();
+  const int clockAfter = next ? static_cast<int>(next->clock) : 0;
   drm->SetActive(false);
   FlipPage(true, false, false);
+  const auto offAt = std::chrono::steady_clock::now();
   const bool off = !drm->LastCommitRefused() && !on();
   drm->SetActive(true);
   FlipPage(false, false, false);
+  const auto offMs =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - offAt)
+          .count();
   if (on())
   {
     if (off)
       CLog::Log(LOGINFO,
                 "The change of mode to {}x{} @ {:.3f} Hz went out with the output turned off and on "
-                "again on connector {}, so that its link starts from scratch in the new mode (a "
-                "dual-mode DisplayPort connector that the graphics card drives as HDMI; "
-                "advancedsettings.xml: dualmoderestart)",
-                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name);
+                "again on connector {} (off for {} ms; pixel clock {} kHz before, {} kHz after), so "
+                "that its link starts from scratch in the new mode (a dual-mode DisplayPort "
+                "connector that the graphics card drives as HDMI; advancedsettings.xml: "
+                "dualmoderestart)",
+                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name, offMs, clockBefore,
+                clockAfter);
     else
       CLog::Log(LOGWARNING,
                 "Turning the output off for the change of mode to {}x{} @ {:.3f} Hz was refused on "
-                "connector {}: the mode went out in place, as before",
-                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name);
+                "connector {} (pixel clock {} kHz before, {} kHz after): the mode went out in place, "
+                "as before",
+                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name, clockBefore,
+                clockAfter);
     return;
   }
   // The driver can refuse to turn it on: it is asked again with the frames after it, after 1 s and
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 357791d..d45f7ce 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -470,6 +470,9 @@ protected:
   bool ModeAfterVideo(RESOLUTION_INFO& res) const;
   //! The mode of res differs from the mode selected (the one on the screen)
   bool OtherTiming(const RESOLUTION_INFO& res) const;
+  //! Hades: ... from the mode on the output (CCommittedMode::Differs()): asked after a new window
+  //! may have selected the mode of res already (ModeChangeRestarts())
+  bool OtherThanOnOutput(const RESOLUTION_INFO& res) const;
   //! Hades: the mode of res carries the transport of native Dolby Vision, at a rate that the
   //! display takes for it (CDVModeMove)
   bool DVTransportModeOf(const RESOLUTION_INFO& res) const;
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 5e0ee3d..c7b21c8 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -75,6 +75,9 @@ public:
   //! Hades: the selected mode is the one that a commit put on the output, whether a modeset is
   //! pending or not: no change of mode is selected (the depth of the link, LinkDepth.h)
   bool SelectedModeOnOutput() const { return m_committedMode.Is(m_mode, false); }
+  //! Hades: the mode that Kodi's commits put on the output (CCommittedMode); nullptr where that is
+  //! not known
+  const drmModeModeInfo* ModeOnOutput() const { return m_committedMode.Known(); }
   //! Hades: what the kernel has now: whether the CRTC is active and its MODE_ID is the selected
   //! mode, by timing (CCommittedMode::SameTiming()); nullopt where that could not be read. Read
   //! from the kernel, as any commit, however made, left it
diff --git a/xbmc/windowing/gbm/drm/DRMCommittedMode.h b/xbmc/windowing/gbm/drm/DRMCommittedMode.h
index 28fe88a..b349822 100644
--- a/xbmc/windowing/gbm/drm/DRMCommittedMode.h
+++ b/xbmc/windowing/gbm/drm/DRMCommittedMode.h
@@ -57,6 +57,27 @@ public:
     return m_known && selected && !modesetPending && SameTiming(m_mode, *selected);
   }
 
+  //! Hades: the mode on the output as Kodi's commits put it there; nullptr where that is not known
+  const Mode* Known() const { return m_known ? &m_mode : nullptr; }
+
+  /*!
+   * \brief Hades: whether next is another mode than the one on the output: than the committed one
+   *        where that is known, else than the selected one (onOutput, Known(); selected,
+   *        CDRMUtils::GetSelectedMode()). The selected mode alone does not say it: a change of
+   *        resolution makes a new window, which selects the mode of res (CWinSystemGbmEGLContext::
+   *        CreateNewWindow()) before CWinSystemGbm::SetFullScreen() asks whether the change of mode
+   *        goes out with the head turned off and on. Asked of the selected mode, a change from
+   *        1920x1080 at 120 Hz to 3840x2160 at 23.976 Hz on the dual-mode DP-2 of an HP ZBook 17 G6
+   *        (issue #4, 1.0 RC5) was no change, and went out in place: the TV went on showing it as
+   *        the 120 Hz signal before it (both at 297 MHz).
+   */
+  static bool Differs(const Mode& next, const Mode* onOutput, const Mode* selected)
+  {
+    if (onOutput)
+      return !SameTiming(*onOutput, next);
+    return selected && !SameTiming(*selected, next);
+  }
+
   static bool SameTiming(const Mode& a, const Mode& b)
   {
     return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsync_start == b.hsync_start &&
