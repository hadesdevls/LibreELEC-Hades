From 79de758154044aaddf045789d8dfa4e2168e1d8d Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Sun, 20 Sep 2026 22:44:21 +0100
Subject: [PATCH] [guilib] Free list item artwork when a container's window is
 deinited

IListProvider::FreeResources() drops the artwork held by a provider's
items while leaving the item list intact, but
CGUIBaseContainer::FreeResources() never called it. Its only caller was
the GUI_MSG_REFRESH_THUMBS handler, so a container fed by a listprovider
kept every poster and fanart it had loaded for as long as its window
object lived, even with the window off screen.

Ordinary media windows are unaffected because
CGUIMediaWindow::ClearFileItems() destroys their items on deinit. A
skin's home screen widgets are listprovider backed and have no such
path, so they hold their artwork for the duration of whatever the user
does next, such as playing a film.

Call it. The item list, sort state and subscriptions are untouched, so
the caching that 1da515fb78c deliberately added is preserved: only the
artwork goes, and ProcessItem() rebuilds a missing layout on demand.
That is already relied upon by GUI_MSG_REFRESH_THUMBS, which does the
same thing to a container that is visible at the time.

CMultiProvider, used when a control has several <content> elements,
did not forward FreeResources() to its providers, so forward it.
---
 xbmc/guilib/GUIBaseContainer.cpp            | 4 ++++
 xbmc/guilib/listproviders/MultiProvider.cpp | 6 ++++++
 xbmc/guilib/listproviders/MultiProvider.h   | 1 +
 3 files changed, 11 insertions(+)

diff --git a/xbmc/guilib/GUIBaseContainer.cpp b/xbmc/guilib/GUIBaseContainer.cpp
index 2a82fa8..168b869 100644
--- a/xbmc/guilib/GUIBaseContainer.cpp
+++ b/xbmc/guilib/GUIBaseContainer.cpp
@@ -1035,6 +1035,10 @@ void CGUIBaseContainer::FreeResources(bool immediately)
   CGUIControl::FreeResources(immediately);
   if (m_listProvider)
   {
+    // Drop the items' artwork. The provider keeps its item list, so re-showing the container
+    // only has to rebuild the layouts, which ProcessItem() does on demand.
+    m_listProvider->FreeResources(immediately);
+
     if (immediately)
     {
       Reset();
diff --git a/xbmc/guilib/listproviders/MultiProvider.cpp b/xbmc/guilib/listproviders/MultiProvider.cpp
index ac7ecfe..cfc1185 100644
--- a/xbmc/guilib/listproviders/MultiProvider.cpp
+++ b/xbmc/guilib/listproviders/MultiProvider.cpp
@@ -83,6 +83,12 @@ void CMultiProvider::Reset()
     provider->Reset();
 }
 
+void CMultiProvider::FreeResources(bool immediately)
+{
+  for (auto const& provider : m_providers)
+    provider->FreeResources(immediately);
+}
+
 bool CMultiProvider::OnClick(const std::shared_ptr<CGUIListItem>& item)
 {
   std::unique_lock lock(m_section);
diff --git a/xbmc/guilib/listproviders/MultiProvider.h b/xbmc/guilib/listproviders/MultiProvider.h
index 8daec77..695e2d0 100644
--- a/xbmc/guilib/listproviders/MultiProvider.h
+++ b/xbmc/guilib/listproviders/MultiProvider.h
@@ -32,6 +32,7 @@ public:
   void Fetch(std::vector<std::shared_ptr<CGUIListItem>>& items) override;
   bool IsUpdating() const override;
   void Reset() override;
+  void FreeResources(bool immediately) override;
   bool OnClick(const std::shared_ptr<CGUIListItem>& item) override;
   bool OnInfo(const std::shared_ptr<CGUIListItem>& item) override;
   bool OnContextMenu(const std::shared_ptr<CGUIListItem>& item) override;
-- 
