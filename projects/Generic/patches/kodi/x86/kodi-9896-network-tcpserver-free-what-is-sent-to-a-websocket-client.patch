From 8963de4f62b89669d49c85665c31eed4d1a5cd07 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:11:14 +0000
Subject: [PATCH] network/TCPServer: free what is sent to a WebSocket client

CWebSocket::Send() returns a new message, with a new frame that holds a
copy of the data, and CWebSocket::Close() a new close frame: both are the
caller's. CWebSocketClient::Send() never freed the message and
Disconnect() never freed the close frame, so every answer and every
announcement sent to a WebSocket client (Home Assistant's integration
uses one) stayed allocated for as long as Kodi ran, the size of its JSON
and a little more each time.

Both are now held by a unique_ptr. What goes to the socket is copied into
the connection's queue first, so nothing reads them afterwards. On the
test host, 1000 announcements of 50 kB to a WebSocket client, each read
before the next, grew the resident memory by 48 MiB before and by none
now, and LeakSanitizer finds no leak left on the WebSocket paths.
---
 xbmc/network/TCPServer.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/xbmc/network/TCPServer.cpp b/xbmc/network/TCPServer.cpp
index eff0e2e..2cf03e2 100644
--- a/xbmc/network/TCPServer.cpp
+++ b/xbmc/network/TCPServer.cpp
@@ -1168,8 +1168,11 @@ void CTCPServer::CWebSocketClient::Send(const char *data, unsigned int size)
   // are queued together.
   std::unique_lock lock(m_critSection);
 
-  const CWebSocketMessage *msg = m_websocket->Send(WebSocketTextFrame, data, size);
-  if (msg == NULL || !msg->IsComplete())
+  // The message is new and the caller's, frames and their data with it: CTCPClient::Send() copies
+  // what it queues
+  const std::unique_ptr<const CWebSocketMessage> msg(
+      m_websocket->Send(WebSocketTextFrame, data, size));
+  if (!msg || !msg->IsComplete())
     return;
 
   std::vector<const CWebSocketFrame *> frames = msg->GetFrames();
@@ -1245,7 +1248,7 @@ void CTCPServer::CWebSocketClient::Disconnect()
     {
       // Already framed, so it bypasses Send(), which would wrap it in a text frame. Only what the
       // socket takes now is written: it is not worth waiting for a peer that has stopped reading.
-      const CWebSocketFrame* closeFrame = m_websocket->Close();
+      const std::unique_ptr<const CWebSocketFrame> closeFrame(m_websocket->Close());
       if (closeFrame)
         CTCPClient::Send(closeFrame->GetFrameData(),
                          static_cast<unsigned int>(closeFrame->GetFrameLength()));
