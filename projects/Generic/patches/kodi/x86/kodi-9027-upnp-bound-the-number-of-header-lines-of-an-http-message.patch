From b3f21bd022276f63030ea882880015cc47ba162f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:00:53 +0000
Subject: [PATCH] upnp: bound the number of header lines of an HTTP message

The CoreELEC fix taken as kodi-9012 caps the length of a folded header,
but not how many header lines a message may have:
NPT_HTTP_PROTOCOL_MAX_HEADER_COUNT (100) was defined and never used, so
a peer on the local network that keeps sending distinct header lines
still made the list grow without limit. Parsing now fails with
NPT_ERROR_INVALID_FORMAT past 100 headers or 200 header lines (folded
continuations included).

UPnP stays off by default in Hades.
---
 lib/libUPnP/Neptune/Source/Core/NptHttp.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/lib/libUPnP/Neptune/Source/Core/NptHttp.cpp b/lib/libUPnP/Neptune/Source/Core/NptHttp.cpp
index 6bb930c..277730c 100644
--- a/lib/libUPnP/Neptune/Source/Core/NptHttp.cpp
+++ b/lib/libUPnP/Neptune/Source/Core/NptHttp.cpp
@@ -173,12 +173,19 @@ NPT_HttpHeaders::Parse(NPT_BufferedInputStream& stream)
     NPT_String header_value;
     bool       header_pending = false;
     NPT_String line;
+    // bound the headers of one message: at most NPT_HTTP_PROTOCOL_MAX_HEADER_COUNT headers, and
+    // as many lines again for folded continuations (whose text is already capped above)
+    unsigned int header_lines = 0;
 
     while (NPT_SUCCEEDED(stream.ReadLine(line, NPT_HTTP_PROTOCOL_MAX_LINE_LENGTH))) {
         if (line.GetLength() == 0) {
             // empty line, end of headers
             break;
         }
+        if (++header_lines > 2 * NPT_HTTP_PROTOCOL_MAX_HEADER_COUNT ||
+            m_Headers.GetItemCount() >= NPT_HTTP_PROTOCOL_MAX_HEADER_COUNT) {
+            return NPT_ERROR_INVALID_FORMAT;
+        }
         if (header_pending && (line[0] == ' ' || line[0] == '\t')) {
             // limit size of multiline header
             if (header_value.GetLength() >= NPT_HTTP_PROTOCOL_MAX_LINE_LENGTH) continue;
