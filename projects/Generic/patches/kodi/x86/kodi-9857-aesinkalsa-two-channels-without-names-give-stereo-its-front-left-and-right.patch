From fea43d938eef7a73e719dac288fa2c157649fda9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:46:06 +0000
Subject: [PATCH] AESinkALSA: two channels without names give stereo its front
 left and right

HDMI may give ALSA a map of two channels without names (while the ELD of
the display is being refreshed, say): stereo PCM, FL and FR, then had no
channel to go to. Where two channels are asked for, two are given and
neither has a name, the classic layout is used (FL, FR), and kodi.log
says so ("ALSA gave 2 channels without names"). Any other map is as
before. The case was found in CroqueMr's build; no log of Hades has shown
it so far (read in the code, not run).
---
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 42672b3..f04398e 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -205,6 +205,20 @@ inline CAEChannelInfo CAESinkALSA::GetChannelLayout(const AEAudioFormat& format,
 
       info = ALSAchmapToAEChannelMap(actualMap);
 
+      /* Hades: HDMI may give a map of two channels without names (while the display's ELD is being
+         refreshed, say): stereo would then have nowhere to go. The classic layout is used, and the
+         log says so (the case is from CroqueMr's build; seen in no log of Hades so far) */
+      if (channels == 2 && info.Count() == 2 && info[0] == AE_CH_UNKNOWN1 &&
+          info[1] == AE_CH_UNKNOWN1 && format.m_channelLayout.HasChannel(AE_CH_FL) &&
+          format.m_channelLayout.HasChannel(AE_CH_FR))
+      {
+        CLog::Log(LOGINFO,
+                  "CAESinkALSA::GetChannelLayout - ALSA gave 2 channels without names ({}): FL, FR "
+                  "are used",
+                  alsaMapStr);
+        info = GetChannelLayoutLegacy(format, 2, 2);
+      }
+
       /* "fake" a compatible map if it is more suitable for AE */
       if (!info.ContainsChannels(format.m_channelLayout))
       {
