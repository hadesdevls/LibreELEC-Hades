new file mode 100644
index 0000000..a88f6eb
--- /dev/null
+++ b/xbmc/utils/ProductName.h
@@ -0,0 +1,144 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace KODI::PRODUCT
+{
+//! The name under which this build shows itself on its own screen and in its own log.
+//!
+//! It is a modified build of Kodi that the XBMC Foundation has not approved, so it does not present
+//! itself as Kodi (Kodi's trademark policy). What other programs read keeps the name of the
+//! application, CCompileInfo::GetAppName(): paths, the user agent, JSON-RPC, UPnP, AirPlay, the
+//! add-on interface. Those tell what this program is compatible with, not whose product it is, and
+//! servers and add-ons choose what they do by them.
+inline constexpr const char* NAME = "LibreELEC Hades";
+
+//! The name inside a sentence
+inline constexpr std::string_view SHORT_NAME = "Hades";
+
+//! The name of the application that this build is made from, as its texts write it
+inline constexpr std::string_view APPLICATION = "Kodi";
+
+/*!
+ * \brief The texts of the core (their ids in strings.po) that name the program that the user runs
+ *
+ * They are left as Kodi has them, in English and in every language pack, and the name is exchanged
+ * when they are loaded (WithOwnName()). Changing the English text instead would lose every
+ * translation: a translation counts only while the English text that it was made from is the one
+ * of this build.
+ *
+ * Not in the list, because they speak of Kodi itself: 24149 and 24152 (an add-on is not compatible
+ * with "this version of Kodi") and the texts that give the addresses of Kodi's own sites.
+ */
+inline constexpr std::array<uint32_t, 16> TEXTS_THAT_NAME_THE_PROGRAM{
+    6,     9,     482,   13473, 14282, 19209, 20009, 24162,
+    34008, 35298, 35300, 35301, 36046, 36161, 36299, 36598};
+
+//! Kodi's thanks to its users in the name of its makers, which a skin shows on the page that the
+//! default skin of this build has as "About this build", and the text of this build that takes
+//! its place in every skin and every language
+inline constexpr uint32_t TEXT_OF_KODIS_MAKERS = 12397;
+inline constexpr uint32_t TEXT_ABOUT_THIS_BUILD = 39959;
+
+/*!
+ * \brief Whether a character of two bytes in UTF-8 (U+0080 to U+07FF) makes a longer word of the
+ * word next to it: a letter, a digit or a mark of a letter
+ *
+ * That is every one of them but the signs of the table: the characters to which Unicode 16.0
+ * gives a general category of punctuation, symbol, separator or control (the no-break space, the
+ * quotation marks of French and Spanish, the inverted question mark, the comma and the question
+ * mark of Arabic, the full stop of Armenian), with the code points between two of them that it has
+ * not assigned.
+ */
+inline constexpr bool IsLetterOfTwoBytes(unsigned char lead, unsigned char next)
+{
+  struct Range
+  {
+    unsigned int first;
+    unsigned int last;
+  };
+  constexpr Range SIGNS[] = {
+      {0x80, 0xA9},   {0xAB, 0xB1},   {0xB4, 0xB4},   {0xB6, 0xB8},   {0xBB, 0xBB},
+      {0xBF, 0xBF},   {0xD7, 0xD7},   {0xF7, 0xF7},   {0x2C2, 0x2C5}, {0x2D2, 0x2DF},
+      {0x2E5, 0x2EB}, {0x2ED, 0x2ED}, {0x2EF, 0x2FF}, {0x375, 0x375}, {0x37E, 0x37E},
+      {0x384, 0x385}, {0x387, 0x387}, {0x3F6, 0x3F6}, {0x482, 0x482}, {0x55A, 0x55F},
+      {0x589, 0x58F}, {0x5BE, 0x5BE}, {0x5C0, 0x5C0}, {0x5C3, 0x5C3}, {0x5C6, 0x5C6},
+      {0x5F3, 0x60F}, {0x61B, 0x61F}, {0x66A, 0x66D}, {0x6D4, 0x6D4}, {0x6DD, 0x6DE},
+      {0x6E9, 0x6E9}, {0x6FD, 0x6FE}, {0x700, 0x70F}, {0x7F6, 0x7F9}, {0x7FE, 0x7FF}};
+  if (lead < 0xC2 || lead > 0xDF || next < 0x80 || next > 0xBF)
+    return false;
+  const unsigned int code = ((lead & 0x1Fu) << 6) | (next & 0x3Fu);
+  for (const Range& sign : SIGNS)
+  {
+    if (code >= sign.first && code <= sign.last)
+      return false;
+  }
+  return true;
+}
+
+/*!
+ * \brief A text with the name of the application exchanged for the name of this build
+ *
+ * Only where the name stands as a word of its own and means the program:
+ * - not inside a longer word. That is an inflected form ("Kodin", "Kodijem"), which cannot be
+ *   declined here and is left as it is. A neighbour makes a longer word when it is an ASCII
+ *   letter or digit or a letter of two bytes (IsLetterOfTwoBytes(): the Latin letters with
+ *   accents, Greek, Cyrillic, Armenian, Hebrew, Arabic). A hyphen, an apostrophe, any
+ *   punctuation, and the characters of three bytes or more (the typographic quotation marks and
+ *   dashes, the scripts that are written without spaces) do not;
+ * - not where the text speaks of Kodi itself: its makers ("Team Kodi", "Kodi Team", "Kodi
+ *   Foundation"), an address ("Kodi.tv") or its trademark (the name with the sign of one).
+ *
+ * A language that inflects with a particle after an apostrophe or a hyphen (the Turkish
+ * "Kodi'nin") gets the new name with the particle of the old one.
+ */
+inline std::string WithOwnName(std::string text)
+{
+  const auto ascii = [](unsigned char c)
+  { return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); };
+  const auto at = [&text](size_t i) { return static_cast<unsigned char>(text[i]); };
+  const auto endsAt = [&text](size_t pos, std::string_view words)
+  { return pos >= words.size() && text.compare(pos - words.size(), words.size(), words) == 0; };
+  const auto startsAt = [&text](size_t pos, std::string_view words)
+  { return text.compare(pos, words.size(), words) == 0; };
+
+  size_t pos = 0;
+  while ((pos = text.find(APPLICATION, pos)) != std::string::npos)
+  {
+    const size_t end = pos + APPLICATION.size();
+    bool leave = false;
+    if (pos > 0)
+      leave = ascii(at(pos - 1)) || (pos > 1 && IsLetterOfTwoBytes(at(pos - 2), at(pos - 1)));
+    // (text[text.size()] can be read: it is the end of the text, which is no letter)
+    if (!leave)
+      leave = ascii(at(end)) || (end < text.size() && IsLetterOfTwoBytes(at(end), at(end + 1)));
+    if (!leave) // Kodi's makers
+      leave = endsAt(pos, "Team ") || startsAt(end, " Team") || startsAt(end, " team") ||
+              startsAt(end, "-Team") || startsAt(end, " Foundation");
+    if (!leave) // an address
+      leave = at(end) == '.' && ascii(at(end + 1));
+    if (!leave) // the signs of a registered trademark and of a trademark
+      leave = startsAt(end, "\xC2\xAE") || startsAt(end, "\xE2\x84\xA2");
+    if (leave)
+    {
+      pos = end;
+      continue;
+    }
+    text.replace(pos, APPLICATION.size(), SHORT_NAME);
+    pos += SHORT_NAME.size();
+  }
+  return text;
+}
+} // namespace KODI::PRODUCT
