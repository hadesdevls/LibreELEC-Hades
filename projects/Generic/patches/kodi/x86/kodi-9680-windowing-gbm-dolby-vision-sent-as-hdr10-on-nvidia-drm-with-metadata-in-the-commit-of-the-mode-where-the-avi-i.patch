+bool CWinSystemGbm::HDR10PlusChangesAviAfterMode() const
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  const auto info = DisplayInfo();
+  return connector && mode && info &&
+         CDVPlusModeStart::NeededForNvidia(
+             connector->SupportsProperty(CDVPlusModeStart::NVIDIA_PROPERTY),
+             info->GetHdmiVicSink(), mode->hdisplay, mode->vdisplay,
+             KODI::UTILS::RRx1kOf(mode->clock, mode->htotal, mode->vtotal));
+}
