+/*!
+ * \brief Hades: what of an EDID decides whether NVIDIA's driver names a 4K mode by an HDMI VIC, and whether
+ *        it then puts the CTA VIC of the mode in the AVI InfoFrame where HDR10+ goes out
+ *        (nvidia-open-kernel-modules-9050, nvidia-legacy-open-9062), read from the raw EDID
+ *
+ * The rule, as NVKMS 615 decides it with its own EDID parser (with the integer-rate twins of 9002) and
+ * nvFindEdidNVT_TIMING(), checked against NVKMS itself on every 4K timing of 593 real EDIDs (the test of this
+ * front, vicrule.c, and the same comparison against this header):
+ *  - the modes: 3840x2160 at 23.976 and 24 Hz (HDMI VIC 3, CTA VIC 93), at 25 Hz (2, 94), at 29.97 and 30 Hz
+ *    (1, 95), and 4096x2160 at 24.000 Hz (4, 98); 4096x2160 at 23.976 always goes by CTA VIC 98;
+ *  - only where the HDMI VSDB lists that HDMI VIC;
+ *  - with UHD_VIC in the HF-VSDB, NVKMS matches the CTA timings first: a 3840 mode goes by its HDMI VIC only
+ *    where the video data blocks do not list its CTA VIC (then nothing is substituted: the CTA VIC is needed),
+ *    and 4096x2160 at 24.000 always by HDMI VIC 4 (9002 adds no integer twin of VIC 98 there);
+ *  - without UHD_VIC, every one of those modes by its HDMI VIC, except 3840x2160 at exactly 24.000 or 30.000
+ *    where the EDID has a progressive 3840x2160 detailed timing of that rate: NVKMS takes that one, with the
+ *    CTA VIC in the AVI InfoFrame already.
+ * With HDR10+ the CTA VIC goes in the AVI InfoFrame where, besides, the video data blocks list it, the display
+ * has SCDC (HF-VSDB), declares HDR10+ (any version) and ST 2084 with static metadata type 1 (its HDR static
+ * metadata block: NVKMS sends the HDR InfoFrame only then), and HDR is on.
+ */
+struct HdmiVicSink
+{
+  struct Dtd
+  {
+    int width, height, pixelClockKHz, htotal, vtotal;
+    bool interlaced;
+  };
+  bool scdc = false;
+  bool uhdVic = false;
+  bool hdr10Plus = false;
+  bool st2084 = false;
+  std::bitset<256> vics; //!< the CTA VICs of the video data blocks
+  std::bitset<8> hdmiVics; //!< the HDMI VICs of the HDMI VSDB
+  std::vector<Dtd> dtds;
+};
+
+inline HdmiVicSink HdmiVicSinkOf(const std::vector<uint8_t>& d)
+{
+  HdmiVicSink s;
+  auto dtd = [&s, &d](std::size_t o)
+  {
+    if (o + 18 > d.size())
+      return;
+    const uint8_t* b = &d[o];
+    const int pclk = (b[0] | (b[1] << 8)) * 10;
+    if (pclk == 0)
+      return;
+    const int ha = b[2] | ((b[4] & 0xf0) << 4), hb = b[3] | ((b[4] & 0x0f) << 8);
+    const int va = b[5] | ((b[7] & 0xf0) << 4), vb = b[6] | ((b[7] & 0x0f) << 8);
+    if (ha + hb && va + vb)
+      s.dtds.push_back({ha, va, pclk, ha + hb, va + vb, (b[17] & 0x80) != 0});
+  };
+  if (d.size() < 128)
+    return s;
+  for (std::size_t o : {54, 72, 90, 108})
+    dtd(o);
+  for (std::size_t b = 128; b + 128 <= d.size(); b += 128)
+  {
+    const uint8_t* e = &d[b];
+    if (e[0] != 0x02)
+      continue;
+    const unsigned end = e[2];
+    for (unsigned i = 4; i < end && i < 128;)
+    {
+      const unsigned tag = e[i] >> 5, len = e[i] & 31;
+      const uint8_t* blk = e + i + 1;
+      const unsigned avail = i + 1 + len <= 128 ? len : 127 - i;
+      if (tag == 2)
+      {
+        for (unsigned k = 0; k < avail; ++k)
+        {
+          const unsigned v = blk[k];
+          s.vics.set(v >= 129 && v <= 192 ? (v & 0x7f) : v);
+        }
+      }
+      else if (tag == 3 && avail >= 8 && blk[0] == 0x03 && blk[1] == 0x0c && blk[2] == 0x00)
+      {
+        // HDMI VSDB: the flags after the TMDS clock; the latencies; HDMI_Video_present, then the 3D byte and
+        // the length of the HDMI VIC list
+        unsigned k = 7;
+        const unsigned flags = blk[k++];
+        if (flags & 0x80)
+          k += 2;
+        if (flags & 0x40)
+          k += 2;
+        if ((flags & 0x20) && k + 1 < avail)
+        {
+          const unsigned n = blk[k + 1] >> 5;
+          k += 2;
+          for (unsigned j = 0; j < n && k + j < avail; ++j)
+            if (blk[k + j] < 8)
+              s.hdmiVics.set(blk[k + j]);
+        }
+      }
+      else if (tag == 3 && avail >= 7 && blk[0] == 0xd8 && blk[1] == 0x5d && blk[2] == 0xc4)
+      {
+        s.scdc = (blk[5] & 0x80) != 0;
+        s.uhdVic = (blk[6] & 0x08) != 0;
+      }
+      else if (tag == 7 && avail >= 5 && blk[0] == 0x01 && blk[1] == 0x8b && blk[2] == 0x84 &&
+               blk[3] == 0x90)
+        s.hdr10Plus = true;
+      else if (tag == 7 && avail >= 3 && blk[0] == 0x06 && (blk[1] & 0x04) && (blk[2] & 0x01))
+        s.st2084 = true;
+      i += 1 + len;
+    }
+    if (end >= 4 && end < 127)
+      for (unsigned o = end; o + 18 <= 127; o += 18)
+        dtd(b + o);
+  }
+  return s;
+}
+
+//! The refresh of a mode in mHz as NVKMS has it for its own modes (RRx1k), from the mode's pixel clock and totals
+inline int RRx1kOf(uint32_t clockKHz, uint32_t htotal, uint32_t vtotal)
+{
+  if (!clockKHz || !htotal || !vtotal)
+    return 0;
+  return static_cast<int>(static_cast<uint64_t>(clockKHz) * 1000000 / (static_cast<uint64_t>(htotal) * vtotal));
+}
+
+//! The HDMI VIC of a mode that NVKMS can name by one (2160 lines, progressive), 0 for any other; rrx1k is matched
+//! within 10 mHz
+inline int HdmiVicOfMode(int width, int height, int rrx1k)
+{
+  if (height != 2160)
+    return 0;
+  auto at = [rrx1k](int r) { return std::abs(rrx1k - r) <= 10; };
+  if (width == 3840)
+    return at(23976) || at(24000) ? 3 : at(25000) ? 2 : at(29970) || at(30000) ? 1 : 0;
+  if (width == 4096)
+    return at(24000) ? 4 : 0;
+  return 0;
+}
+
+inline int CtaVicOfHdmiVic(int hdmiVic)
+{
+  switch (hdmiVic)
+  {
+    case 1:
+      return 95;
+    case 2:
+      return 94;
+    case 3:
+      return 93;
+    case 4:
+      return 98;
+    default:
+      return 0;
+  }
+}
+
+//! NVKMS names this mode by its HDMI VIC for this display (see HdmiVicSink)
+inline bool NvkmsNamesByHdmiVic(const HdmiVicSink& s, int width, int height, int rrx1k)
+{
+  const int hv = HdmiVicOfMode(width, height, rrx1k);
+  if (!hv || !s.hdmiVics[hv])
+    return false;
+  const bool integerTwin = width == 3840 && (std::abs(rrx1k - 24000) <= 10 || std::abs(rrx1k - 30000) <= 10);
+  bool ownDtd = false;
+  for (const HdmiVicSink::Dtd& t : s.dtds)
+  {
+    if (t.width == width && t.height == 2160 && !t.interlaced && t.htotal && t.vtotal)
+    {
+      const int64_t rr = static_cast<int64_t>(t.pixelClockKHz) * 1000 * 1000 / (static_cast<int64_t>(t.htotal) * t.vtotal);
+      ownDtd |= std::abs(rr - rrx1k) <= 10;
+    }
+  }
+  if (s.uhdVic)
+  {
+    if (width == 4096)
+      return true;
+    return !s.vics[CtaVicOfHdmiVic(hv)] && !(integerTwin && ownDtd);
+  }
+  return !(integerTwin && ownDtd);
+}
+
+//! With HDR10+ and HDR on, nvidia-open-kernel-modules-9050 (or nvidia-legacy-open-9062) puts the CTA VIC of this
+//! mode in the AVI InfoFrame for this display
+inline bool NvkmsAviCtaVicWithHdr10Plus(const HdmiVicSink& s, int width, int height, int rrx1k)
+{
+  return NvkmsNamesByHdmiVic(s, width, height, rrx1k) &&
+         s.vics[CtaVicOfHdmiVic(HdmiVicOfMode(width, height, rrx1k))] && s.scdc && s.hdr10Plus && s.st2084;
+}
+
+} // namespace UTILS
+} // namespace KODI
