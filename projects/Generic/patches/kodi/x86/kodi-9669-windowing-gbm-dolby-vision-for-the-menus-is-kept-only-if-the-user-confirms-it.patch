+/*!
+ * \brief Hades: turning "Dolby Vision for the menus" on is kept only if the user says so
+ *
+ * Kodi asks "keep this?" with a countdown after a change of resolution or of monitor, and goes back
+ * when nobody answers yes, because the new output may show nothing and then nobody can undo it. The
+ * menus in Dolby Vision are the same kind of change: a display that takes the transport badly shows
+ * a black picture (with the Dolby Vision logo, at times), and the setting that did it is in the
+ * menus that cannot be seen. So a change of the setting from off to on that Kodi sees while it runs
+ * is armed; once the menus have really gone out and have had time to show (the first frame reached
+ * the display, and the display had a moment to switch its picture mode), the question is asked;
+ * anything but a yes (no, Back, the countdown running out, a dialog that something else closed, a
+ * question that could not be shown for a minute and a half) turns the setting off again, and the
+ * ordinary output comes back by itself (CDVMenus::Stays(): the setting is off).
+ *
+ * Nothing is asked where nothing changed on the output: the menus that cannot go out (the display
+ * has no Dolby Vision, the mode is not 3840x2160...) leave the setting as the user made it, as
+ * before, and say why in the log. A setting that is on when Kodi starts is not asked about: it was
+ * kept before, or set by hand in guisettings.xml.
+ *
+ * Only what is decided is here, with nothing of Kodi in it, so that it can be tested by itself.
+ */
+class CDVMenusKeep
+{
+public:
+  //! how long after the first frame of the menus the question waits, so that the display has changed
+  //! its picture mode and what it shows is what the user judges
+  static constexpr int64_t SETTLE_MS = 2500;
+  //! how long an armed change waits for the menus to go out (the wait after a failure is 30 s, then
+  //! 5 minutes); then it is dropped, and the setting stays as the user made it
+  static constexpr int64_t ARMED_MAX_MS = 10 * 60 * 1000;
+  //! how long a question that cannot be shown (another dialog is open) is waited for
+  static constexpr int64_t NOT_SHOWN_MAX_MS = 90 * 1000;
+  //! the countdown of the question, as that of Kodi's own for the resolution is 15 s
+  static constexpr unsigned int ASK_SECONDS = 15;
+
+  enum class Step
+  {
+    NOTHING, //!< go on
+    ASK, //!< put the question now (once; Answered() takes what comes of it)
+    DROP_OFF, //!< nothing is asked: the setting was turned off again
+    DROP_LATE, //!< nothing is asked: the menus did not go out within ARMED_MAX_MS
+    REVERT_NOT_SHOWN, //!< the question could not be shown: the setting goes off
+  };
+
+  struct Input
+  {
+    bool setting = false; //!< the setting now
+    bool live = false; //!< the menus went out in Dolby Vision, and a frame of them reached the display
+    int64_t liveForMs = 0; //!< since the first frame of them
+    bool canShow = true; //!< the question can be shown now (the interface is up, no other dialog open)
+    int64_t nowMs = 0;
+  };
+
+  //! The setting as it is now; every call tells a change. The first call only learns the value Kodi
+  //! started with.
+  void Observe(bool setting, int64_t nowMs)
+  {
+    if (!m_known)
+    {
+      m_known = true;
+      m_setting = setting;
+      return;
+    }
+    if (setting == m_setting)
+      return;
+    m_setting = setting;
+    if (setting)
+    {
+      if (m_state == State::IDLE)
+      {
+        m_state = State::ARMED;
+        m_armedAt = nowMs;
+        m_notShownSince = 0;
+        m_hasNotShown = false;
+      }
+    }
+    // (turned off while the question is up: the question goes on, and what it comes to is moot)
+  }
+
+  bool Armed() const { return m_state == State::ARMED; }
+  bool Asking() const { return m_state == State::ASKING; }
+
+  Step Next(const Input& in)
+  {
+    if (m_state != State::ARMED)
+      return Step::NOTHING;
+    if (!in.setting)
+    {
+      m_state = State::IDLE;
+      return Step::DROP_OFF;
+    }
+    if (in.nowMs - m_armedAt > ARMED_MAX_MS)
+    {
+      m_state = State::IDLE;
+      return Step::DROP_LATE;
+    }
+    if (!in.live || in.liveForMs < SETTLE_MS)
+    {
+      // (a question that was waiting for a dialog starts its wait again when the menus are gone)
+      m_hasNotShown = false;
+      return Step::NOTHING;
+    }
+    if (in.canShow)
+    {
+      m_state = State::ASKING;
+      return Step::ASK;
+    }
+    if (!m_hasNotShown)
+    {
+      m_hasNotShown = true;
+      m_notShownSince = in.nowMs;
+      return Step::NOTHING;
+    }
+    if (in.nowMs - m_notShownSince >= NOT_SHOWN_MAX_MS)
+    {
+      m_state = State::IDLE;
+      return Step::REVERT_NOT_SHOWN;
+    }
+    return Step::NOTHING;
+  }
+
+  //! What the user did with the question: whether the setting goes off. Only a yes keeps it.
+  //! \param yes the answer was yes (and not no, Back, the time running out, a dialog closed by
+  //!        something else, a question that did not come up)
+  //! \param settingNow the setting as it is now (off already where the user turned it off meanwhile)
+  //! \return true: turn the setting off
+  bool Answered(bool yes, bool settingNow)
+  {
+    m_state = State::IDLE;
+    return !yes && settingNow;
+  }
+
+  //! the question could not be put when the application thread got to it (another dialog is open, the menus
+  //! are gone): it is asked for again, and the wait that counts toward giving it up goes on
+  void NotAsked(int64_t nowMs)
+  {
+    if (m_state != State::ASKING)
+      return;
+    m_state = State::ARMED;
+    if (!m_hasNotShown)
+    {
+      m_hasNotShown = true;
+      m_notShownSince = nowMs;
+    }
+  }
+
+  //! the question did not come back at all (the application is stopping): nothing is changed
+  void Abandon() { m_state = State::IDLE; }
+
+private:
+  enum class State
+  {
+    IDLE,
+    ARMED,
+    ASKING,
+  };
+  State m_state = State::IDLE;
+  bool m_known = false;
+  bool m_setting = false;
+  int64_t m_armedAt = 0;
+  bool m_hasNotShown = false;
+  int64_t m_notShownSince = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
