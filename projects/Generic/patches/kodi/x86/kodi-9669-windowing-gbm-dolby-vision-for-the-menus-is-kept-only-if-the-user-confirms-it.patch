               "DVBridge: the menus do not go out in Dolby Vision: {}", CDVMenus::Text(why));
 }
 
+// Hades: turning "Dolby Vision for the menus" on is kept only if the user says so (CDVMenusKeep), as Kodi asks
+// for a change of resolution: a display that takes the transport badly shows a black picture, and the setting
+// that did it is in the menus that cannot be seen. The question is asked once the menus have gone out and the
+// display had a moment to show them; it is put by the application thread (not from within a frame), and
+// anything but a yes turns the setting off, which ends the menus by itself (CDVMenus::Stays()).
+void CWinSystemGbmGLESContext::DVMenusKeepStep()
+{
+  if (m_dvMenusKeep.Asking())
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - m_dvMenusKeepAt < std::chrono::milliseconds(250))
+    return;
+  m_dvMenusKeepAt = now;
+  const auto nowMs =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count();
+  const bool setting = DVMenusSetting();
+  const bool wasArmed = m_dvMenusKeep.Armed();
+  m_dvMenusKeep.Observe(setting, nowMs);
+  if (!wasArmed && m_dvMenusKeep.Armed())
+    CLog::Log(LOGINFO, "DVBridge: Dolby Vision for the menus was turned on: once the menus go out, the user is "
+                       "asked to keep it, and it goes back to off unless they say yes");
+  if (!m_dvMenusKeep.Armed())
+    return;
+
+  CDVMenusKeep::Input in;
+  in.setting = setting;
+  in.live = m_dvMenus && m_dvMenusShown;
+  in.liveForMs =
+      in.live ? std::chrono::duration_cast<std::chrono::milliseconds>(now - m_dvMenusShownAt).count() : 0;
+  in.nowMs = nowMs;
+  const auto gui = CServiceBroker::GetGUI();
+  const auto dialog =
+      gui ? gui->GetWindowManager().GetWindow<CGUIDialogYesNo>(WINDOW_DIALOG_YES_NO) : nullptr;
+  in.canShow = gui && gui->GetSkinInfo() && dialog && !dialog->IsDialogRunning() &&
+               !gui->GetWindowManager().HasModalDialog(true) && !g_application.IsStopping();
+  switch (m_dvMenusKeep.Next(in))
+  {
+    case CDVMenusKeep::Step::NOTHING:
+      return;
+    case CDVMenusKeep::Step::DROP_OFF:
+      CLog::Log(LOGINFO, "DVBridge: Dolby Vision for the menus was turned off again: nobody is asked");
+      return;
+    case CDVMenusKeep::Step::DROP_LATE:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision for the menus was turned on {} minutes ago and the menus did not "
+                "go out in that time (the lines above say why): nobody is asked, and the setting stays on",
+                CDVMenusKeep::ARMED_MAX_MS / 60000);
+      return;
+    case CDVMenusKeep::Step::REVERT_NOT_SHOWN:
+      CLog::Log(LOGWARNING,
+                "DVBridge: Dolby Vision for the menus is not kept: the question could not be shown for {} "
+                "s (another dialog stayed open); the setting goes back to off",
+                CDVMenusKeep::NOT_SHOWN_MAX_MS / 1000);
+      if (const auto settings = CServiceBroker::GetSettingsComponent()
+                                    ? CServiceBroker::GetSettingsComponent()->GetSettings()
+                                    : nullptr)
+      {
+        settings->SetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVMENUS, false);
+        settings->Save();
+      }
+      return;
+    case CDVMenusKeep::Step::ASK:
+      break;
+  }
+
+  // (posted: the question blocks, and a frame is not the place; the application thread runs it between two
+  // frames, and the window system is the one of then)
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  if (!messenger)
+  {
+    m_dvMenusKeep.Abandon();
+    return;
+  }
+  struct Call
+  {
+    KODI::MESSAGING::ThreadMessageCallback message;
+  };
+  auto* call = new Call{};
+  call->message.userptr = call;
+  call->message.callback = [](void* data)
+  {
+    std::unique_ptr<Call> owned(static_cast<Call*>(data));
+    if (auto* gbm = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem()))
+      gbm->DVMenusAskKeep();
+  };
+  messenger->PostMsg(TMSG_CALLBACK, -1, -1, &call->message);
+}
+
+void CWinSystemGbmGLESContext::DVMenusAskKeep()
+{
+  namespace HELPERS = KODI::MESSAGING::HELPERS;
+  const auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
+  if (g_application.IsStopping())
+  {
+    m_dvMenusKeep.Abandon();
+    return;
+  }
+  const auto gui = CServiceBroker::GetGUI();
+  const auto dialog =
+      gui ? gui->GetWindowManager().GetWindow<CGUIDialogYesNo>(WINDOW_DIALOG_YES_NO) : nullptr;
+  // (what was true when it was posted may not be now: another question is open, or the menus are gone)
+  if (!dialog || dialog->IsDialogRunning() || !(m_dvMenus && m_dvMenusShown))
+  {
+    m_dvMenusKeep.NotAsked(nowMs);
+    return;
+  }
+
+  std::string text = CGUIUtils::GetHadesString(40992, 32196);
+  StringUtils::Replace(text, "{0}", std::to_string(CDVMenusKeep::ASK_SECONDS));
+  CLog::Log(LOGINFO, "DVBridge: the user is asked to keep Dolby Vision for the menus ({} s)",
+            CDVMenusKeep::ASK_SECONDS);
+  // (the default button is "No": a dialog that something else closes answers no, and only a press of "Yes"
+  // keeps the setting)
+  const HELPERS::DialogResponse answer = HELPERS::ShowYesNoDialogText(
+      CVariant{CGUIUtils::GetHadesString(40990, 32190)}, CVariant{text}, CVariant{}, CVariant{},
+      CDVMenusKeep::ASK_SECONDS * 1000);
+  if (g_application.IsStopping())
+  {
+    m_dvMenusKeep.Abandon();
+    return;
+  }
+  const auto settings = CServiceBroker::GetSettingsComponent()
+                            ? CServiceBroker::GetSettingsComponent()->GetSettings()
+                            : nullptr;
+  const bool on = settings && DVMenusSetting();
+  const bool yes = answer == HELPERS::DialogResponse::CHOICE_YES;
+  const bool off = m_dvMenusKeep.Answered(yes, on);
+  const char* what = yes ? "yes"
+                     : answer == HELPERS::DialogResponse::CHOICE_NO
+                         ? "no, Back, or the time ran out"
+                         : "no answer: the dialog was closed by something else";
+  if (yes)
+    CLog::Log(LOGINFO, "DVBridge: Dolby Vision for the menus is kept: the user said yes");
+  else if (off)
+  {
+    CLog::Log(LOGWARNING,
+              "DVBridge: Dolby Vision for the menus is not kept ({}): the setting goes back to off, and "
+              "the ordinary output comes back",
+              what);
+    settings->SetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVMENUS, false);
+    if (!settings->Save())
+      CLog::Log(LOGWARNING, "DVBridge: the settings could not be saved with Dolby Vision for the menus off");
+  }
+  else
+    CLog::Log(LOGINFO, "DVBridge: Dolby Vision for the menus was turned off meanwhile ({}): nothing to revert",
+              what);
+}
