From 7cc7f70fad1714b8e9426ccdaf80b4606479c43b Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 15 Oct 2026 19:55:09 +0100
Subject: [PATCH] [VideoInfoScanner] Carry on with a directory after an error
 with one item

An error adding one item - a database write, or a set or version that
could not be added - abandoned every item after it in the directory
until a later scan. Carry on with the other items instead. The error
counts as a failed lookup, so the directory isn't hashed and the next
scan tries the item again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit a6e8d9f520b6f558b90449330d74443d69a63145)
---
 xbmc/video/VideoInfoScanner.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 37c21b5..d705a05 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -881,10 +881,15 @@ CVideoInfoScanner::~CVideoInfoScanner()
                   "VideoInfoScanner: Error {} occurred while retrieving"
                   "information for {}.",
                   static_cast<int>(ret), CURL::GetRedacted(pItem->GetPath()));
-        FoundSomeInfo = false;
-        break;
+        if (ret == InfoRet::CANCELLED)
+        {
+          FoundSomeInfo = false;
+          break;
+        }
+        // The other items are still added, and the directory is tried again by the next scan
+        ++m_failedLookups;
       }
-      if (ret == InfoRet::ADDED || ret == InfoRet::HAVE_ALREADY)
+      else if (ret == InfoRet::ADDED || ret == InfoRet::HAVE_ALREADY)
         FoundSomeInfo = true;
       else if (ret == InfoRet::NOT_FOUND)
       {
