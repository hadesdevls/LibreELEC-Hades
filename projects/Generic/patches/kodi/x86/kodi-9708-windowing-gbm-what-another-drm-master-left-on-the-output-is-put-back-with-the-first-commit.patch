+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: the state of the CRTC that a program which had the display before Kodi may have
+ *        left, and that Kodi never sets, so that nothing in it would put it back
+ *
+ * Kodi holds DRM master from the start of the process to its end: a Wayland session (a Flatpak
+ * application that Kodi's add-on starts after it stopped, VacuumTube) is another process, and what
+ * it leaves is what Kodi finds when it starts. The kernel keeps the state of a connector and a CRTC
+ * across the programs that use it. Kodi's commits set what the picture needs (the mode, the planes,
+ * the HDR metadata and the colorimetry, the depth of the link: LinkDepth.h, the range: RgbRange.h)
+ * and none of the rest, so a colour matrix or a gamma or degamma table of a compositor that does
+ * colour management or a night light, or variable refresh on, stays on the output under Kodi's
+ * picture, for SDR and for HDR10 (native Dolby Vision saves and clears them itself:
+ * CDVBridgeState). A connector or a CRTC that none had before Kodi has none of them.
+ *
+ * Only what is set is cleared: a property that is there and zero is not part of the commit, so a
+ * start on an output that nothing used goes out as before this existed.
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+namespace FOREIGN_STATE
+{
+
+//! The properties of the CRTC that Kodi puts back to nothing when it finds one set
+//! (the blobs: the id of the table, 0 is none; VRR_ENABLED: 1 is on)
+constexpr std::array<std::string_view, 4> CRTC_PROPERTIES = {"CTM", "GAMMA_LUT", "DEGAMMA_LUT",
+                                                             "VRR_ENABLED"};
+
+//! What the CRTC has of each property of CRTC_PROPERTIES: nothing where it has no such property
+using CrtcValues = std::array<std::optional<uint64_t>, CRTC_PROPERTIES.size()>;
+
+//! The properties to set to 0 in the first commit on the output
+inline std::vector<std::string_view> ToClear(const CrtcValues& found)
+{
+  std::vector<std::string_view> clear;
+  for (size_t i = 0; i < found.size(); ++i)
+    if (found[i] && *found[i] != 0)
+      clear.push_back(CRTC_PROPERTIES[i]);
+  return clear;
+}
+
+} // namespace FOREIGN_STATE
+} // namespace KODI::WINDOWING::GBM
diff --git a/xbmc/windowing/gbm/LinkDepth.h b/xbmc/windowing/gbm/LinkDepth.h
index c105301..624163b 100644
--- a/xbmc/windowing/gbm/LinkDepth.h
+++ b/xbmc/windowing/gbm/LinkDepth.h
@@ -72,6 +72,12 @@ struct LinkDepthOutput
   bool sdrAt8 = false;
   //! the top of the range of "max bpc": the drivers' own choice
   uint64_t maximum = 0;
+  //! the kernel gives this connector the top of the range at its start, and nothing in Kodi
+  //! lowers it: amdgpu, i915 and xe (drm_connector_attach_max_bpc_property() sets
+  //! max_requested_bpc to the maximum). Where another program that had the output before Kodi
+  //! (a Wayland compositor: Flatpak applications that Kodi starts after it stopped) left it lower,
+  //! the first commit of Kodi on the output puts it back, as it is on a connector that none had.
+  bool defaultsToMaximum = false;
 };
 
 //! "max bpc" holds the link at 8 bits (below 10: nvidia-drm asks NVKMS for 8 there and for
@@ -107,6 +113,9 @@ struct LinkDepthStep
   bool waits = false;
   //! a higher depth is wanted: the request is a modeset for it, where it was not one already
   bool raises = false;
+  //! the depth is the one that the kernel gives the connector, put back on the first commit of
+  //! Kodi on it: another program had left a lower one (defaultsToMaximum)
+  bool restores = false;
 };
 
 /*!
@@ -116,16 +125,31 @@ struct LinkDepthStep
  * \param current "max bpc" in the request being built, or else on the connector (the value of
  *        the last commit that the driver took)
  * \param setsHead the request sets the head again whatever its depth (see above)
+ * \param firstCommit the first commit of Kodi on this output (it sets the head, so setsHead too):
+ *        what it finds of "max bpc" is what the program before it left, which is put back to the
+ *        kernel's own value where that is the top of the range (LinkDepthOutput::defaultsToMaximum),
+ *        in whatever way the link is held, so that a depth below the one of the driver's choice
+ *        (10 where 12 goes) or one of 8 does not stay where Kodi asks for a picture that has more
  */
 constexpr LinkDepthStep LinkDepthFor(const LinkDepthOutput& out,
                                      LinkContent content,
                                      int hdrSetting,
                                      uint64_t current,
-                                     bool setsHead)
+                                     bool setsHead,
+                                     bool firstCommit = false)
 {
-  if (!out.managed || out.maximum < 8)
+  if (out.maximum < 8)
     return {};
+  if (!out.managed)
+  {
+    // (Kodi does not manage the depth here: only what another program left is put back)
+    if (firstCommit && out.defaultsToMaximum && current < out.maximum)
+      return {out.maximum, false, false, true};
+    return {};
+  }
   const uint64_t wanted = LinkDepthWanted(out, content, hdrSetting);
+  if (firstCommit && out.defaultsToMaximum && !LinkHeldAt8(wanted) && current != wanted)
+    return {wanted, false, false, true};
   if (LinkHeldAt8(wanted) == LinkHeldAt8(current))
     return {};
   if (LinkHeldAt8(wanted))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 9812b8a..b9562b2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -245,6 +245,8 @@ bool CWinSystemGbm::InitWindowSystem()
   if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
     CDVBridgeState::ClearLeftover(*drm);
 #endif
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+    ClearForeignOutputState(*drm);
 
   CDRMConnector* connector = m_DRM->GetConnector();
   // Hades: the driver of this output takes the choice of HDR in YCbCr 4:2:0 (SetHDR())
@@ -3522,6 +3524,7 @@ void CWinSystemGbm::AdoptOutput()
   // ... and what a session before may have left on this connector, as at start
   CDVBridgeState::ClearLeftover(*drm);
 #endif
+  ClearForeignOutputState(*drm);
   SetStereoEdid(edid);
 
   // The colorimetry and the HDR signalling of the interface, on this connector
@@ -4368,6 +4371,40 @@ void CWinSystemGbm::QueuePictureLinkDepth(const VideoPicture* picture,
                  picture ? "with the output of the video" : "as the video goes");
 }
 
+// Hades: what a program that had the display before Kodi left on the CRTC and Kodi never sets
+// (ForeignOutputState.h), put back with the first commit on the output; the depth of the link
+// ("max bpc") is the business of QueueLinkDepth(), the HDR metadata and the colorimetry that of
+// SetHDR() and SetColorimetry() (each of them sets its own with the first commit, never from what
+// was read), and the range that of CRgbRange (which reads what the kernel has)
+void CWinSystemGbm::ClearForeignOutputState(CDRMAtomic& drm)
+{
+  CDRMCrtc* crtc = drm.GetCrtc();
+  CDRMConnector* connector = drm.GetConnector();
+  if (!crtc || !connector)
+    return;
+  FOREIGN_STATE::CrtcValues found;
+  for (size_t i = 0; i < found.size(); ++i)
+    found[i] = crtc->GetPropertyValue(FOREIGN_STATE::CRTC_PROPERTIES[i]);
+  std::string told;
+  for (const auto name : FOREIGN_STATE::ToClear(found))
+  {
+    const std::string property(name);
+    if (!drm.AddProperty(crtc, property.c_str(), 0))
+    {
+      CLog::Log(LOGWARNING, "Output state: {} could not be added to the request on {}: it stays",
+                property, connector->GetName());
+      continue;
+    }
+    told += (told.empty() ? "" : ", ") + property;
+  }
+  if (!told.empty())
+    CLog::Log(LOGWARNING,
+              "Output state: {} set on the CRTC of {} when Kodi took the output (a program that "
+              "had it before, such as a Wayland session, left it): cleared with the first mode "
+              "set, so that it does not change the picture",
+              told, connector->GetName());
+}
+
 // Hades: what Kodi does with the depth of the link of this output (LinkDepth.h), read when it takes
 // the output, as m_hdrDepthChoice is
 void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
@@ -4405,6 +4442,10 @@ void CWinSystemGbm::ReadLinkDepthOutput(CDRMConnector& connector)
     m_linkDepth.sdrAt8 = true;
   }
   m_linkDepth.maximum = limits->second;
+  // (the drivers that give a connector the top of its range of "max bpc" and keep it there: what a
+  // program that had the output before Kodi left lower is put back with the first commit, as
+  // QueueLinkDepth() does)
+  m_linkDepth.defaultsToMaximum = driver == "amdgpu" || driver == "i915" || driver == "xe";
   const auto value = connector.ReadPropertyValue("max bpc");
   if (!m_linkDepth.managed)
     CLog::Log(LOGINFO, "Output depth: {} ({}): \"max bpc\" is left as the driver has it ({})",
@@ -4449,14 +4490,15 @@ void CWinSystemGbm::QueueLinkDepth(LinkContent content,
   }
   const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
-  if (!connector || !m_linkDepth.managed)
+  if (!connector || (!m_linkDepth.managed && !m_linkDepth.defaultsToMaximum))
     return;
   // (native Dolby Vision stages the depth of its transport with each frame, and puts back the one
   // it found: the renderer of its video that goes, SetHDR(nullptr), does not change it meanwhile)
   if (NativeDVOutputInUse() && !transportEnds)
     return;
   // (the first commit on an output sets its head again: the one at Kodi's start, or after a move)
-  setsHead = setsHead || std::exchange(m_linkNewOutput, false);
+  const bool firstCommit = std::exchange(m_linkNewOutput, false);
+  setsHead = setsHead || firstCommit;
   // (a dual-mode DisplayPort connector of nvidia-drm is driven as HDMI or as DisplayPort by what is
   // plugged into it)
   if (m_hdrDepthChoice && connector->GetType() == "DP")
@@ -4474,7 +4516,8 @@ void CWinSystemGbm::QueueLinkDepth(LinkContent content,
   const uint64_t current =
       drm->RequestValue(connector, "max bpc")
           .value_or(connector->GetPropertyValue("max bpc").value_or(m_linkDepth.maximum));
-  const LinkDepthStep step = LinkDepthFor(m_linkDepth, content, hdrSetting, current, setsHead);
+  const LinkDepthStep step =
+      LinkDepthFor(m_linkDepth, content, hdrSetting, current, setsHead, firstCommit);
   const char* const what = content == LinkContent::HDR  ? "HDR"
                            : content == LinkContent::DV ? "native Dolby Vision"
                                                         : "SDR";
@@ -4504,7 +4547,14 @@ void CWinSystemGbm::QueueLinkDepth(LinkContent content,
     heldAt8 = LinkHeldAt8(*step.maxBpc);
     if (step.raises)
       drm->AllowModeset();
-    if (content == LinkContent::HDR && hdrSetting == 8)
+    if (step.restores)
+      CLog::Log(LOGWARNING,
+                "Output depth: \"max bpc\" was {} on {} when Kodi took the output (the driver gives "
+                "{}: a program that had the output before Kodi, such as a Wayland session, left it "
+                "lower, which holds HDR at RGB of 8 bits): it is put back to {} with the first mode "
+                "set",
+                current, connector->GetName(), m_linkDepth.maximum, *step.maxBpc);
+    else if (content == LinkContent::HDR && hdrSetting == 8)
       CLog::Log(LOGINFO, "HDR output: the link is held at 8 bits for HDR, as the setting \"HDR "
                          "output depth\" asks");
     else if (heldAt8)
