 xbmc/windowing/gbm/LinkDepth.h          | 28 +++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp     | 58 +++++++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.h       |  4 ++
 4 files changed, 145 insertions(+), 6 deletions(-)
 create mode 100644 xbmc/windowing/gbm/ForeignOutputState.h

