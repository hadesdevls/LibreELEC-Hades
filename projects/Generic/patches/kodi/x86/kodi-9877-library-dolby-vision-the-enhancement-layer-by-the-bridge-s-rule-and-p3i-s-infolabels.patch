+      case LISTITEM_VIDEO_HDR_TYPE_ALT:
+      {
+        // Hades: the other HDR type of the Dolby Vision stream: kept in memory by a scan
+        // (m_strHdrTypeAlt), and in the library as the HDR type of its second, virtual, video stream
+        const CStreamDetails& d = tag->m_streamDetails;
+        const auto other = [](const std::string& type)
+        { return type == "hdr10plus" || type == "hlg" ? type : std::string(); };
+        value.clear();
+        if (d.GetVideoHdrType() == "dolbyvision")
+        {
+          value = other(d.GetVideoHdrType(0, true));
+          if (value.empty() && d.GetStreamCount(CStreamDetail::VIDEO) > 1)
+            value = other(d.GetVideoHdrType(2));
+        }
+        return true;
+      }
       default:
         break;
     }
