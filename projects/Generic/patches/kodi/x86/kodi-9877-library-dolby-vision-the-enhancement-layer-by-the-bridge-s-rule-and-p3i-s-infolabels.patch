@@ -2519,22 +2520,10 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
         CheckDVBaseLayer(pVideoPicture, *hdr, *av_dovi_get_color(dovi));
 #endif
 
-      if (hdr != nullptr && hdr->el_spatial_resampling_filter_flag == 1 &&
-          hdr->disable_residual_flag == 0)
-      {
