diff --git a/tools/dvbridge/dvbridge_probe.c b/tools/dvbridge/dvbridge_probe.c
index 46710d0..e6eca5a 100644
--- a/tools/dvbridge/dvbridge_probe.c
+++ b/tools/dvbridge/dvbridge_probe.c
@@ -10,6 +10,7 @@
 
 #include "dvbridge_mel.h"
 
+#include <stdlib.h>
 #include <string.h>
 
 /* (dvbridge_rpu_units(): any unit of type 63 is one of the enhancement layer) */
@@ -91,3 +92,53 @@ void dvbridge_rpu_probe_packet(const uint8_t *data, size_t size, int length_size
     else if (rpu_profile == 1)
         out->profile = 8;
 }
+
+struct dvbridge_residual_probe {
+    struct dvbridge_rpu_nlq nlq;
+    int length_size;
+    struct dvbridge_residual_counts counts;
+};
+
+struct dvbridge_residual_probe *dvbridge_residual_probe_create(const uint8_t *extradata,
+                                                               size_t size)
+{
+    struct dvbridge_residual_probe *p = calloc(1, sizeof(*p));
+    if (!p)
+        return NULL;
+    /* as the enhancement-layer module frames the units of a base packet (unit_length_size()) */
+    p->length_size = extradata && size >= 23 && extradata[0] == 1 ? (extradata[21] & 3) + 1 : 0;
+    return p;
+}
+
+void dvbridge_residual_probe_destroy(struct dvbridge_residual_probe *probe)
+{
+    free(probe);
+}
+
+void dvbridge_residual_probe_packet(struct dvbridge_residual_probe *probe, const uint8_t *data,
+                                    size_t size)
+{
+    if (!probe || !data || !size)
+        return;
+    ++probe->counts.packets;
+    switch (dvbridge_rpu_nlq_packet(&probe->nlq, data, size, probe->length_size)) {
+    case DVBRIDGE_RPU_NO_RESIDUAL:
+        ++probe->counts.no_residual;
+        break;
+    case DVBRIDGE_RPU_RESIDUAL:
+        ++probe->counts.residual;
+        break;
+    case DVBRIDGE_RPU_UNREAD:
+        ++probe->counts.unread;
+        break;
+    case DVBRIDGE_RPU_NONE:
+        break;
+    }
+}
+
+struct dvbridge_residual_counts
+dvbridge_residual_probe_counts(const struct dvbridge_residual_probe *probe)
+{
+    struct dvbridge_residual_counts none = {0};
+    return probe ? probe->counts : none;
+}
diff --git a/tools/dvbridge/dvbridge_probe.h b/tools/dvbridge/dvbridge_probe.h
index 8bde015..697180d 100644
--- a/tools/dvbridge/dvbridge_probe.h
+++ b/tools/dvbridge/dvbridge_probe.h
@@ -41,6 +41,30 @@ struct dvbridge_rpu_probe {
 void dvbridge_rpu_probe_packet(const uint8_t *data, size_t size, int length_size,
                                struct dvbridge_rpu_probe *out);
 
+/* Hades: for the video library (CDVDFileInfo): what the RPUs of the access units of a profile 7
+ * stream say of the residual of their pictures, read as the bridge reads them before it decodes
+ * the enhancement layer (dvbridge_rpu_nlq_packet(), dvbridge_mel.h), with the mappings that the
+ * RPUs before sent and later ones use again. Nothing is decoded. */
+struct dvbridge_residual_probe;
+
+struct dvbridge_residual_counts {
+    unsigned packets;     /* access units given */
+    unsigned no_residual; /* RPUs whose picture has no residual (MEL, or the residual disabled) */
+    unsigned residual;    /* RPUs whose picture can carry one (FEL) */
+    unsigned unread;      /* RPUs that could not be read: the bridge takes them as ones that can */
+};
+
+/* extradata: the stream's (an hvcC record frames each unit with a length; else start codes).
+ * NULL where it cannot be allocated. */
+struct dvbridge_residual_probe *dvbridge_residual_probe_create(const uint8_t *extradata,
+                                                               size_t size);
+void dvbridge_residual_probe_destroy(struct dvbridge_residual_probe *probe);
+/* data: one access unit of the stream, in decoding order (after a seek, from where it went on) */
+void dvbridge_residual_probe_packet(struct dvbridge_residual_probe *probe, const uint8_t *data,
+                                    size_t size);
+struct dvbridge_residual_counts
+dvbridge_residual_probe_counts(const struct dvbridge_residual_probe *probe);
+
 #ifdef __cplusplus
 }
 #endif
