+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \brief Hades: what the video library keeps of Dolby Vision, and how it is shown
+ *
+ * Kodi keeps it in the stream details of a file, in the columns of its database (no column of
+ * Hades): the HDR type of each video stream, the Dolby Vision profile in its HDR detail ("5",
+ * "7FEL", "7MEL", "8.1", "8.4"; CDVDFileInfo::DemuxerToStreamDetails()), and a second, virtual,
+ * video stream for the other HDR type of the stream (HDR10+ or HLG). So a library shared with
+ * other Kodi 22 systems keeps what each of them writes. What is here decides the enhancement layer
+ * of a profile 7 stream with the rule that draws it (the bridge's, tools/dvbridge/dvbridge_mel.h),
+ * and gives the profile with the names of the infolabels that skins made for p3i's CoreELEC read
+ * (ListItem.DvProfile "7.6 FEL", ListItem.HdrTypeAlt "hdr10plus").
+ */
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+}
+
+namespace KODI::UTILS::DOLBYVISION
+{
+
+/*!
+ * \brief What an RPU, as FFmpeg parsed it, says of the enhancement layer of its picture
+ * \return "MEL" where its picture has no residual, "FEL" where it can carry one, "" without a
+ *         header
+ *
+ * The rule of the bridge and of libplacebo's mapping (pl_map_dovi_metadata(), whose
+ * pl_avdovi_nlq_is_trivial() leaves the layer out): no residual exactly when the residual is
+ * disabled (disable_residual_flag), or when the NLQ is the linear dead zone with, in each of the
+ * three components, offset 0, vdr_in_max 1 (1 << coef_log2_denom), slope 0 and threshold 0. Any
+ * other NLQ can carry one. (FFmpeg keeps vdr_in_max, also of floating point coefficients, in fixed
+ * point with coef_log2_denom bits of fraction.)
+ */
+inline std::string_view ElType(const AVDOVIRpuDataHeader* header, const AVDOVIDataMapping* mapping)
+{
+  if (!header)
+    return {};
+  if (header->disable_residual_flag)
+    return "MEL";
+  if (!mapping || header->coef_log2_denom > 63)
+    return {};
+  if (mapping->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+    return "FEL";
+  const uint64_t one = uint64_t{1} << header->coef_log2_denom;
+  for (const AVDOVINLQParams& nlq : mapping->nlq)
+  {
+    if (nlq.nlq_offset != 0 || nlq.vdr_in_max != one || nlq.linear_deadzone_slope != 0 ||
+        nlq.linear_deadzone_threshold != 0)
+      return "FEL";
+  }
+  return "MEL";
+}
+
+/*!
+ * \brief What the RPUs of the access units read of a profile 7 stream say
+ *
+ * Read before anything is decoded, as the bridge reads them (dvbridge_residual_probe_packet()).
+ */
+struct RpuSample
+{
+  unsigned noResidual = 0; //!< RPUs whose picture has no residual
+  unsigned residual = 0; //!< RPUs whose picture can carry one
+  unsigned unread = 0; //!< RPUs that could not be read (the bridge takes them as ones that can)
+};
+
+/*!
+ * \brief The enhancement layer of a profile 7 stream, for the library
+ * \param picture ElType() of the picture that was decoded from the same place ("" without one)
+ *
+ * FEL where one RPU read or the picture can carry a residual: a FEL stream is one whose layer the
+ * bridge decodes, and it decodes it from such an RPU on. MEL where the RPUs read, every one of
+ * them read, say no residual and the picture does not say otherwise. Otherwise what the picture
+ * says, which may be nothing.
+ */
+inline std::string_view StreamElType(const RpuSample& sample, std::string_view picture)
+{
+  if (sample.residual > 0 || picture == "FEL")
+    return "FEL";
+  if (sample.noResidual > 0 && sample.unread == 0)
+    return "MEL";
+  return picture;
+}
+
+/*!
+ * \brief The profile of the HDR detail that Kodi keeps ("7FEL", "8.1", "5"), as p3i names it
+ *        ("7.6 FEL", "8.1", "5.0"): profile, compatibility of the base layer, and its layer
+ * \return "" where the detail says no profile
+ *
+ * Kodi keeps the compatibility of the base layer for profile 8 only; for the profiles that have
+ * one alone it is that one (4: 2, 5: 0, 7: 6, 9: 2). A profile 7 stream whose layer was not told
+ * is "7.6 EL", as p3i says it.
+ */
+inline std::string ProfileName(std::string_view detail)
+{
+  size_t i = 0;
+  while (i < detail.size() && i < 2 && detail[i] >= '0' && detail[i] <= '9')
+    ++i;
+  if (i == 0)
+    return {};
+  const std::string_view profile = detail.substr(0, i);
+  std::string_view rest = detail.substr(i);
+  std::string out(profile);
+  if (!rest.empty() && rest.front() == '.')
+  {
+    size_t j = 1;
+    while (j < rest.size() && rest[j] >= '0' && rest[j] <= '9')
+      ++j;
+    if (j == 1)
+      return {};
+    out.append(rest.substr(0, j));
+    rest = rest.substr(j);
+  }
+  else if (profile == "4" || profile == "9")
+    out += ".2";
+  else if (profile == "5")
+    out += ".0";
+  else if (profile == "7")
+    out += ".6";
+  if (rest == "FEL" || rest == "MEL")
+    out.append(" ").append(rest);
+  else if (!rest.empty())
+    return {};
+  else if (profile == "7")
+    out += " EL";
+  return out;
+}
+
+} // namespace KODI::UTILS::DOLBYVISION
