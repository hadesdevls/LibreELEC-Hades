diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
index a777edb..7360aa8 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
@@ -20,6 +20,7 @@
 #include "pvr/utils/PVRStreamUtils.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/DolbyVisionLibrary.h"
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 #include "video/VideoFileItemClassify.h"
@@ -38,9 +39,15 @@
 #include "Util.h"
 #include "filesystem/File.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <memory>
 #include <string>
+#include <string_view>
+
+#ifdef HAVE_DVBRIDGE
+#include "dvbridge_probe.h"
+#endif
 
 extern "C" {
 #include <libavcodec/avcodec.h>
@@ -503,6 +510,18 @@ static bool GetDetailsFromFrame(CDemuxStreamVideo* stream,
   // num streams * 160 frames, should get a valid frame, if not abort.
   int abort_index = demuxer->GetNrOfStreams() * 160;
 
+  // Hades: of a profile 7 stream, the RPU of each access unit read is read as the bridge reads it
+  // before it decodes the enhancement layer (KODI::UTILS::DOLBYVISION::StreamElType())
+  const bool profile7 = stream->dovi.dv_profile == 7;
+  KODI::UTILS::DOLBYVISION::RpuSample rpus;
+#ifdef HAVE_DVBRIDGE
+  std::unique_ptr<dvbridge_residual_probe, decltype(&dvbridge_residual_probe_destroy)> probe(
+      profile7 ? dvbridge_residual_probe_create(stream->extraData.GetData(),
+                                                stream->extraData.GetSize())
+               : nullptr,
+      &dvbridge_residual_probe_destroy);
+#endif
+
   do
   {
     DemuxPacket* packet = demuxer->Read();
@@ -516,6 +535,11 @@ static bool GetDetailsFromFrame(CDemuxStreamVideo* stream,
       continue;
     }
 
+#ifdef HAVE_DVBRIDGE
+    if (probe)
+      dvbridge_residual_probe_packet(probe.get(), packet->pData,
+                                     static_cast<size_t>(std::max(packet->iSize, 0)));
+#endif
     videoCodec->AddData(*packet);
     CDVDDemuxUtils::FreeDemuxPacket(packet);
 
@@ -535,7 +559,59 @@ static bool GetDetailsFromFrame(CDemuxStreamVideo* stream,
 
   } while (abort_index--);
 
-  if (decoderState != CDVDVideoCodec::VC_PICTURE || (picture.iFlags & DVP_FLAG_DROPPED))
+  const bool decoded =
+      decoderState == CDVDVideoCodec::VC_PICTURE && !(picture.iFlags & DVP_FLAG_DROPPED);
+
+#ifdef HAVE_DVBRIDGE
+  if (probe)
+  {
+    // Hades: while no RPU read can carry a residual, a few access units more are read, and not
+    // decoded: 48 of the stream at most, and 16 MiB of what the demuxer gives of all its streams
+    // (a TrueHD track alone gives some 1200 packets a second)
+    static constexpr unsigned MAX_PACKETS = 48;
+    static constexpr size_t MAX_BYTES = 16 * 1024 * 1024;
+    static constexpr unsigned MAX_READS = 65536;
+    size_t bytes = 0;
+    for (unsigned read = 0; read < MAX_READS && bytes < MAX_BYTES; ++read)
+    {
+      const dvbridge_residual_counts c = dvbridge_residual_probe_counts(probe.get());
+      if (c.residual > 0 || c.packets >= MAX_PACKETS)
+        break;
+      // (eight access units without an RPU: the RPUs are in another track, or there are none)
+      if (c.packets >= 8 && c.no_residual + c.residual + c.unread == 0)
+        break;
+      DemuxPacket* packet = demuxer->Read();
+      if (!packet)
+        break;
+      bytes += static_cast<size_t>(std::max(packet->iSize, 0));
+      if (packet->iStreamId == stream->uniqueId && packet->iSize > 0)
+        dvbridge_residual_probe_packet(probe.get(), packet->pData,
+                                       static_cast<size_t>(packet->iSize));
+      CDVDDemuxUtils::FreeDemuxPacket(packet);
+    }
+    const dvbridge_residual_counts c = dvbridge_residual_probe_counts(probe.get());
+    rpus.noResidual = c.no_residual;
+    rpus.residual = c.residual;
+    rpus.unread = c.unread;
+  }
+#endif
+
+  if (profile7)
+  {
+    const std::string_view pictureEl =
+        decoded ? std::string_view(picture.strDVELType) : std::string_view();
+    const std::string_view el = KODI::UTILS::DOLBYVISION::StreamElType(rpus, pictureEl);
+    if (vDetail.m_strHdrDetail == "7")
+      vDetail.m_strHdrDetail += el;
+    CLog::LogF(LOGINFO,
+               "Dolby Vision profile 7: the enhancement layer is {} (of the RPUs read before "
+               "decoding, {} with no residual, {} that can carry one, {} unread; the decoded "
+               "picture: {})",
+               el.empty() ? "not known" : el, rpus.noResidual, rpus.residual, rpus.unread,
+               !decoded ? "none" : pictureEl.empty() ? "says nothing" : pictureEl);
+  }
+
+  if (!decoded)
   {
     CLog::LogF(LOGERROR, "Decoder couldn't find valid picture");
     return false;
@@ -543,8 +619,6 @@ static bool GetDetailsFromFrame(CDemuxStreamVideo* stream,
 
   vDetail.m_strHdrType = CStreamDetails::HdrTypeToString(picture.hdrType);
   vDetail.m_strHdrTypeAlt = CStreamDetails::HdrTypeToString(picture.hdrTypeAlt);
-  if (vDetail.m_strHdrDetail.find("7") != std::string::npos)
-    vDetail.m_strHdrDetail += picture.strDVELType;
   return true;
 }
 
