diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
index 2fce8fd..bd4ad52 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/VideoShaders/YUV2RGBShaderGLES.cpp
@@ -78,6 +78,11 @@ BaseYUV2RGBGLSLShader::BaseYUV2RGBGLSLShader(EShaderFormat format,
 
   if (toneMap)
   {
+    // Hades: the method of a reference display is the bridge's mapping; what Kodi draws itself
+    // with that method (a picture the bridge does not take, or one it could not draw), it draws
+    // with Hable, Kodi's default before it
+    if (toneMapMethod == VS_TONEMAPMETHOD_BT2390)
+      toneMapMethod = VS_TONEMAPMETHOD_HABLE;
     m_toneMapping = true;
     m_toneMappingMethod = toneMapMethod;
     if (toneMapMethod == VS_TONEMAPMETHOD_REINHARD)
diff --git a/xbmc/cores/VideoSettings.h b/xbmc/cores/VideoSettings.h
index 82779fb..723d7ba 100644
--- a/xbmc/cores/VideoSettings.h
+++ b/xbmc/cores/VideoSettings.h
@@ -160,6 +160,10 @@ enum ETONEMAPMETHOD
   VS_TONEMAPMETHOD_REINHARD = 1,
   VS_TONEMAPMETHOD_ACES = 2,
   VS_TONEMAPMETHOD_HABLE = 3,
+  //! Hades: that of a reference display (ITU-R BT.2390, HDR reference white at the display's
+  //! white), the bridge's mapping to an SDR output; where the bridge does not draw a picture,
+  //! Kodi draws it with Hable
+  VS_TONEMAPMETHOD_BT2390 = 4,
   VS_TONEMAPMETHOD_MAX
 };
 
@@ -189,6 +193,7 @@ private:
       {VS_TONEMAPMETHOD_REINHARD, "reinhard"},
       {VS_TONEMAPMETHOD_ACES, "aces"},
       {VS_TONEMAPMETHOD_HABLE, "hable"},
+      {VS_TONEMAPMETHOD_BT2390, "bt2390"},
   });
 
   static_assert(VS_TONEMAPMETHOD_MAX == tonemapMethodMap.size(),
diff --git a/xbmc/settings/MediaSettings.cpp b/xbmc/settings/MediaSettings.cpp
index 25fe6f5..6847f56 100644
--- a/xbmc/settings/MediaSettings.cpp
+++ b/xbmc/settings/MediaSettings.cpp
@@ -104,7 +104,14 @@ bool CMediaSettings::Load(const TiXmlNode *settings)
     int toneMapMethod;
     if (!XMLUtils::GetInt(pElement, "tonemapmethod", toneMapMethod, VS_TONEMAPMETHOD_OFF,
                           VS_TONEMAPMETHOD_MAX))
-      toneMapMethod = VS_TONEMAPMETHOD_HABLE;
+      toneMapMethod = VS_TONEMAPMETHOD_BT2390;
+    // Hades: the method of a reference display is the default, where Kodi's was Hable. A Hable
+    // saved before that method existed is taken for Kodi's default and becomes this one, once:
+    // from then on the file says so (hadestonemap), and Hable chosen again stays.
+    int hadesToneMap = 0;
+    XMLUtils::GetInt(pElement, "hadestonemap", hadesToneMap);
+    if (hadesToneMap < 1 && toneMapMethod == VS_TONEMAPMETHOD_HABLE)
+      toneMapMethod = VS_TONEMAPMETHOD_BT2390;
     m_defaultVideoSettings.m_ToneMapMethod = static_cast<ETONEMAPMETHOD>(toneMapMethod);
 
     if (!XMLUtils::GetFloat(pElement, "tonemapparam", m_defaultVideoSettings.m_ToneMapParam, 0.1f, 5.0f))
@@ -224,6 +231,7 @@ bool CMediaSettings::Save(TiXmlNode *settings) const
   XMLUtils::SetInt(pNode, "centermixlevel", m_defaultVideoSettings.m_CenterMixLevel);
   XMLUtils::SetInt(pNode, "tonemapmethod", m_defaultVideoSettings.m_ToneMapMethod);
   XMLUtils::SetFloat(pNode, "tonemapparam", m_defaultVideoSettings.m_ToneMapParam);
+  XMLUtils::SetInt(pNode, "hadestonemap", 1);
 
   // default audio settings for dsp addons
   TiXmlElement audioSettingsNode("defaultaudiosettings");
