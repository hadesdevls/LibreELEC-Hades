From 04212291535b6d07d173f11ecedc091254c36b37 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 07:29:09 +0000
Subject: [PATCH] dvbridge: scene refresh only on a real discontinuity; accept
 L255

The metadata serializer took the reviewed mpv adapter's rule "a gap of
more than 0.1 s between presented frames forces scene_refresh_flag",
but Kodi passes presentation times in AV_TIME_BASE units
(microseconds). Every new frame therefore went out with
scene_refresh_flag = 1, telling the display that each frame starts a
scene, instead of the RPU's own flag. Compare in microseconds.

Two per-frame refusals of real content are relaxed (audit finding F12):
- L255 extension blocks are encoder debug data that FFmpeg parses; they
  are not display metadata and are now skipped like L6, instead of
  refusing the frame.
- An L1 average outside [min, max] is sent clamped into that range
  instead of refusing every frame of the shot; min > max still refuses.
---
 tools/dvbridge/dvbridge_metadata.h | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 1a0555e..9f5091b 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -23,6 +23,9 @@ struct dvbridge_dv {
     unsigned compatibility_omissions;
 };
 #define DV_REQUIRE(x) do { if (!(x)) return false; } while (0)
+/* Presentation times reach the serializer in AV_TIME_BASE units (microseconds), as Kodi passes
+ * them; the reviewed mpv adapter passed seconds. */
+#define DVBRIDGE_PTS_PER_SECOND 1000000.0
 static inline bool dvbridge_dv_bounds(const AVDOVIMetadata *m, size_t bytes)
 {
     DV_REQUIRE(m && bytes >= sizeof(*m));
@@ -109,7 +112,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     DV_REQUIRE(c->source_min_pq <= c->source_max_pq && c->source_max_pq <= 4095);
     DV_REQUIRE(m->num_ext_blocks > 0 && m->num_ext_blocks <= AV_DOVI_MAX_EXT_BLOCKS);
     bool repeat = d->frames && pts == d->last_pts;
-    bool refresh = !d->frames || pts < d->last_pts || pts - d->last_pts > 0.1;
+    bool refresh = !d->frames || pts < d->last_pts ||
+                   pts - d->last_pts > 0.1 * DVBRIDGE_PTS_PER_SECOND;
     d->size = 0;
     d->payload[d->size++] = 0;
     d->payload[d->size++] = repeat ? d->previous[1] : refresh ? 1 : c->scene_refresh_flag;
@@ -144,7 +148,12 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         case 1:
             DV_REQUIRE(!area); l1++; n = 3;
             v[0] = e->l1.min_pq; v[1] = e->l1.max_pq; v[2] = e->l1.avg_pq;
-            DV_REQUIRE(v[0] <= v[2] && v[2] <= v[1]); break;
+            DV_REQUIRE(v[0] <= v[1]);
+            /* An average outside [min, max] is an encoder inconsistency: send it clamped
+             * instead of refusing every frame of the shot. */
+            if (v[2] < v[0]) v[2] = v[0];
+            if (v[2] > v[1]) v[2] = v[1];
+            break;
         case 2:
             DV_REQUIRE(!area); n = 7;
             v[0] = e->l2.target_max_pq; v[1] = e->l2.trim_slope; v[2] = e->l2.trim_offset;
@@ -170,6 +179,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             continue;
         }
         case 6: continue; /* Static HDR10 fallback, not dynamic DV wire data. */
+        case 255: continue; /* Encoder debug data (FFmpeg parses it), not display metadata. */
         default: fprintf(stderr,"DVBRIDGE_DV_UNSUPPORTED_METADATA level=%d\n",e->level); return false;
         }
         for (unsigned j = 0; j < n; j++)
