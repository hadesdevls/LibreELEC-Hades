diff --git a/system/settings/settings.xml b/system/settings/settings.xml
old mode 100755
new mode 100644
index ae59c9f..3f1d809
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3310,6 +3310,17 @@
         <default>true</default>
         <control type="toggle" />
       </setting>
+      <setting id="videoscreen.hadesdvnative" type="boolean" label="39830" help="39831">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <level>2</level>
+        <default>true</default>
+        <control type="toggle" />
+      </setting>
       <setting id="videoscreen.hadesdvashdr10" type="boolean" label="39989" help="39990">
         <requirement>
           <and>
@@ -3333,12 +3344,103 @@
         </requirement>
         <dependencies>
           <dependency type="visible" on="property" name="ishdrdisplay"/>
-          <dependency type="enable" setting="videoscreen.hadesdvashdr10" operator="is">true</dependency>
+          <!-- Hades: while Dolby Vision as HDR10 is mapped to the display, every stream is -->
+          <dependency type="enable">
+            <and>
+              <condition setting="videoscreen.hadesdvashdr10" operator="is">true</condition>
+              <condition setting="videoscreen.hadesdvhdr10map" operator="is">0</condition>
+            </and>
+          </dependency>
         </dependencies>
         <level>2</level>
         <default>false</default>
         <control type="toggle" />
       </setting>
+      <setting id="videoscreen.hadesdvhdr10map" type="integer" label="39832" help="39833">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+        </dependencies>
+        <level>2</level>
+        <default>0</default> <!-- as mastered: the display maps it -->
+        <constraints>
+          <options>
+            <option label="39834">0</option> <!-- off -->
+            <option label="39835">1</option> <!-- to this display -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
+      </setting>
+      <setting id="videoscreen.hadesdvhdr10peak" type="integer" parent="videoscreen.hadesdvhdr10map" label="39836" help="39837">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+          <dependency type="enable" setting="videoscreen.hadesdvhdr10map" operator="!is">0</dependency>
+        </dependencies>
+        <level>2</level>
+        <default>1000</default>
+        <constraints>
+          <minimum>40</minimum>
+          <step>10</step>
+          <maximum>4000</maximum>
+        </constraints>
+        <control type="spinner" format="string">
+          <formatlabel>39838</formatlabel>
+        </control>
+      </setting>
+      <setting id="videoscreen.hadesdvhdr10gamut" type="integer" parent="videoscreen.hadesdvhdr10map" label="39839" help="39840">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+          <dependency type="enable" setting="videoscreen.hadesdvhdr10map" operator="!is">0</dependency>
+        </dependencies>
+        <level>2</level>
+        <default>1</default> <!-- DCI-P3 (D65) -->
+        <constraints>
+          <options>
+            <option label="39841">0</option> <!-- BT.2020 -->
+            <option label="39842">1</option> <!-- DCI-P3 (D65) -->
+            <option label="39843">2</option> <!-- BT.709 -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
+      </setting>
+      <setting id="videoscreen.hadesdvhdr10curve" type="integer" parent="videoscreen.hadesdvhdr10map" label="39844" help="39845">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+          <dependency type="enable" setting="videoscreen.hadesdvhdr10map" operator="!is">0</dependency>
+        </dependencies>
+        <level>3</level>
+        <default>1</default> <!-- BT.2390 -->
+        <constraints>
+          <options>
+            <option label="39847">1</option> <!-- BT.2390 -->
+            <option label="39846">0</option> <!-- spline -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
+      </setting>
       <setting id="videoscreen.hadesdvahead" type="boolean" label="39987" help="39988">
         <requirement>
           <and>
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 45fe96a..cd0a577 100644
