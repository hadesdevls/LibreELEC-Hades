+dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
+    const VideoPicture& picture)
+{
+  dvbridge_hdr10_mapping mapping{};
+  mapping.enabled = false;
+  const auto settings = SettingsNow();
+  if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) &&
+      settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) != 0 &&
+      settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK) &&
+      settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10GAMUT) &&
+      settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE))
+  {
+    mapping.enabled = true;
+    mapping.peak =
+        static_cast<float>(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK));
+    switch (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10GAMUT))
+    {
+      case 0: mapping.gamut = DVBRIDGE_HDR10_GAMUT_BT2020; break;
+      case 2: mapping.gamut = DVBRIDGE_HDR10_GAMUT_BT709; break;
+      default: mapping.gamut = DVBRIDGE_HDR10_GAMUT_P3_D65; break;
+    }
+    mapping.curve = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE) == 1
+                        ? DVBRIDGE_HDR10_CURVE_BT2390
+                        : DVBRIDGE_HDR10_CURVE_SPLINE;
+    // where the colours of the picture can be: the gamut of its mastering display, which the
+    // stream's HDR10 metadata gives (red, green, blue in that order, as FFmpeg gives them)
+    mapping.source_known = false;
+    if (picture.hasDisplayMetadata && picture.displayMetadata.has_primaries)
+    {
+      const auto& d = picture.displayMetadata;
+      const AVRational xy[8] = {d.display_primaries[0][0], d.display_primaries[0][1],
+                                d.display_primaries[1][0], d.display_primaries[1][1],
+                                d.display_primaries[2][0], d.display_primaries[2][1],
+                                d.white_point[0],          d.white_point[1]};
+      mapping.source_known = true;
+      for (int i = 0; i < 8; ++i)
+        mapping.source_xy[i] = xy[i].den ? static_cast<float>(av_q2d(xy[i])) : 0.0f;
+      // primaries that are not a gamut are not used: then the BT.2020 of the signal
+      if (!dvbridge_hdr10_mapping_valid(&mapping))
+        mapping.source_known = false;
+    }
+    if (!dvbridge_hdr10_mapping_valid(&mapping))
+    {
+      CLog::Log(LOGWARNING,
+                "DVBridge: the mapping of Dolby Vision as HDR10 to the display is set, but not to "
+                "values that can be used (peak {} cd/m2): the picture is sent as mastered",
+                mapping.peak);
+      mapping = dvbridge_hdr10_mapping{};
+      mapping.enabled = false;
+    }
+  }
+  const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
+    if (a.enabled != b.enabled)
+      return false;
+    if (!a.enabled)
+      return true;
+    for (int i = 0; i < 8; ++i)
+      if (a.source_known && a.source_xy[i] != b.source_xy[i])
+        return false;
+    return a.peak == b.peak && a.gamut == b.gamut && a.curve == b.curve &&
+           a.source_known == b.source_known;
+  };
+  if (!m_dvConvertMappingSet || !same(mapping, m_dvConvertMapping))
+  {
+    static const char* const gamuts[] = {"BT.2020", "DCI-P3 (D65)", "BT.709"};
+    if (mapping.enabled)
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision as HDR10 is mapped to a display of {} cd/m2 and {}, with "
+                "the {} curve, guided by each scene's level 1 metadata; the colours of the source "
+                "within {}",
+                mapping.peak, gamuts[mapping.gamut],
+                mapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
+                mapping.source_known ? "the gamut of its mastering display"
+                                     : "BT.2020 (its mastering display is not known)");
+    else if (m_dvConvertMappingSet)
+      CLog::Log(LOGINFO, "DVBridge: Dolby Vision as HDR10 is sent as mastered, not mapped");
+  }
+  m_dvConvertMapping = mapping;
+  m_dvConvertMappingSet = true;
+  return mapping;
+}
