From 51aac3c970845d7790c0a131f09984b08aa05f92 Mon Sep 17 00:00:00 2001
From: Martin Penkava <mpenkava1337@gmail.com>
Date: Sun, 8 Nov 2026 16:15:57 +0100
Subject: [PATCH] [Windows][Renderer] Keep the HDR state when the renderer is
 replaced

The render manager replaces the renderer whenever the stream
parameters change during playback, e.g. at every Blu-ray playlist
change. The old renderer restored the Windows HDR state from before
playback and the new one switched HDR on again, so each change turned
the display off and on with a refresh delay.

Store the state from before playback once per playback and restore it
only when the renderer is not replaced by a new one.

(cherry picked from commit 01e01678a8e22da304b76f22c4ef05c526dc3a18)
---
 .../VideoPlayer/VideoRenderers/BaseRenderer.h |  2 +
 .../VideoRenderers/RenderManager.cpp          |  1 +
 .../VideoRenderers/WinRenderer.cpp            | 10 +++++
 .../VideoPlayer/VideoRenderers/WinRenderer.h  |  2 +
 .../VideoRenderers/windows/RendererBase.cpp   | 37 +++++++++++++++----
 .../VideoRenderers/windows/RendererBase.h     |  7 +++-
 6 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/BaseRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/BaseRenderer.h
index 6a76962..707b639 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/BaseRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/BaseRenderer.h
@@ -62,6 +62,8 @@ public:
   virtual void AddVideoPicture(const VideoPicture &picture, int index) = 0;
   virtual bool IsPictureHW(const VideoPicture& picture) { return false; }
   virtual void UnInit() = 0;
+  //! Called before the renderer is deleted to be replaced by a new one for the same playback.
+  virtual void PrepareForReconfigure() {}
   virtual bool Flush(bool saveBuffers) { return false; }
   virtual void SetBufferSize(int numBuffers) { }
   virtual void ReleaseBuffer(int idx) { }
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 4c06f4f..a7bf6be 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -218,6 +218,7 @@ bool CRenderManager::Configure()
 
   if (m_pRenderer)
   {
+    m_pRenderer->PrepareForReconfigure();
     DeleteRenderer();
   }
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.cpp
index 299741e..9e25cfc 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.cpp
@@ -67,6 +67,9 @@ CWinRenderer::CWinRenderer()
 
 CWinRenderer::~CWinRenderer()
 {
+  // without a render method for the last picture, no renderer is left to restore the HDR state
+  if (!m_renderer && !m_replaced)
+    CRendererBase::RestoreHdrStateBeforePlayback();
   CWinRenderer::UnInit();
 }
 
@@ -233,6 +236,13 @@ void CWinRenderer::PreInit()
   UnInit();
 }
 
+void CWinRenderer::PrepareForReconfigure()
+{
+  m_replaced = true;
+  if (m_renderer)
+    m_renderer->KeepHdrStateOnDestroy();
+}
+
 void CWinRenderer::UnInit()
 {
   std::unique_lock lock(CServiceBroker::GetWinSystem()->GetGfxContext());
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.h
index 4baab4a..20ace12 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/WinRenderer.h
@@ -28,6 +28,7 @@ public:
   bool Configure(const VideoPicture &picture, float fps, unsigned int orientation) override;
   void AddVideoPicture(const VideoPicture &picture, int index) override;
   void UnInit() override;
+  void PrepareForReconfigure() override;
   bool IsConfigured() override { return m_bConfigured; }
   bool Flush(bool saveBuffers) override;
   CRenderInfo GetRenderInfo() override;
@@ -57,4 +58,5 @@ protected:
 
   bool m_bConfigured = false;
   std::unique_ptr<CRendererBase> m_renderer;
+  bool m_replaced = false;
 };
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
index e5b48fc..9502251 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.cpp
@@ -24,6 +24,8 @@
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
 
+#include <optional>
+
 using namespace Microsoft::WRL;
 
 namespace
@@ -49,6 +51,9 @@ bool IsHdrStream(const VideoPicture& picture, bool canRenderDolbyVision)
          (picture.color_transfer == AVCOL_TRC_SMPTE2084 ||
           picture.color_transfer == AVCOL_TRC_ARIB_STD_B67);
 }
+
+// Windows HDR state before playback, kept while renderers are replaced during the playback
+std::optional<bool> hdrStateBeforePlayback;
 } // namespace
 
 void CRenderBuffer::AppendPicture(const VideoPicture& picture)
@@ -180,11 +185,8 @@ CRendererBase::~CRendererBase()
   // Is not need set swap chain color space because toggling HDR re-creates swap chain
   if (m_AutoSwitchHDR)
   {
-    if (m_initialHdrEnabled != DX::Windowing()->IsHDROutput())
-    {
-      CLog::LogF(LOGDEBUG, "Restoring {} rendering", m_initialHdrEnabled ? "HDR" : "SDR");
-      DX::Windowing()->ToggleHDR();
-    }
+    if (!m_keepHdrState)
+      RestoreHdrStateBeforePlayback();
   }
   else // swap chain is not re-created, set proper color space
   {
@@ -215,6 +217,19 @@ CRenderInfo CRendererBase::GetRenderInfo()
   return info;
 }
 
+void CRendererBase::RestoreHdrStateBeforePlayback()
+{
+  if (!hdrStateBeforePlayback)
+    return;
+
+  if (*hdrStateBeforePlayback != DX::Windowing()->IsHDROutput())
+  {
+    CLog::LogF(LOGDEBUG, "Restoring {} rendering", *hdrStateBeforePlayback ? "HDR" : "SDR");
+    DX::Windowing()->ToggleHDR();
+  }
+  hdrStateBeforePlayback.reset();
+}
+
 bool CRendererBase::Configure(const VideoPicture& picture, float fps, unsigned orientation)
 {
   m_iNumBuffers = 0;
@@ -240,14 +255,22 @@ bool CRendererBase::Configure(const VideoPicture& picture, float fps, unsigned o
   // Auto switch HDR only if supported and "Settings/Player/Use HDR display capabilities" = ON
   if (m_AutoSwitchHDR)
   {
-    m_initialHdrEnabled = DX::Windowing()->IsHDROutput();
-    CLog::LogF(LOGDEBUG, "Storing Windows HDR state: {}", m_initialHdrEnabled ? "ON" : "OFF");
+    if (!hdrStateBeforePlayback)
+    {
+      hdrStateBeforePlayback = DX::Windowing()->IsHDROutput();
+      CLog::LogF(LOGDEBUG, "Storing Windows HDR state: {}", *hdrStateBeforePlayback ? "ON" : "OFF");
+    }
 
     const bool streamIsHDR = IsHdrStream(picture, m_canRenderDolbyVision);
 
     if (streamIsHDR != DX::Windowing()->IsHDROutput())
       DX::Windowing()->ToggleHDR();
   }
+  else
+  {
+    // the setting was turned off during a playback in which a replaced renderer switched HDR
+    RestoreHdrStateBeforePlayback();
+  }
 
   return true;
 }
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.h b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.h
index 9d7e5b1..89d72b9 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/windows/RendererBase.h
@@ -119,6 +119,11 @@ class CRendererBase
 public:
   virtual ~CRendererBase();
 
+  //! The playback continues with a new renderer, so the Windows HDR state is not restored.
+  void KeepHdrStateOnDestroy() { m_keepHdrState = true; }
+  //! Restores the Windows HDR state stored at the start of the playback, if one was stored.
+  static void RestoreHdrStateBeforePlayback();
+
   virtual CRenderInfo GetRenderInfo();
   virtual bool Configure(const VideoPicture &picture, float fps, unsigned int orientation);
   virtual bool Supports(ESCALINGMETHOD method) const = 0;
@@ -220,9 +225,9 @@ protected:
   DXGI_HDR_METADATA_HDR10 m_lastHdr10 = {};
   HDR_TYPE m_HdrType = HDR_TYPE::HDR_INVALID;
   bool m_AutoSwitchHDR = false;
-  bool m_initialHdrEnabled = false;
   bool m_DolbyVisionOutput = false;
   bool m_canRenderDolbyVision = false;
   bool m_dolbyVisionEffect = false; // frames are already display-referred RGB
+  bool m_keepHdrState = false;
   std::string m_renderMethodName;
 };
