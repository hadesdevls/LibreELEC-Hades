+/*!
+ * \brief What a scan of the titles of a disc found, shared by the thread that reads them and the
+ *        player's navigator that asks
+ *
+ * The navigator can close at any time: Stop() returns at once, and the thread ends on its own
+ * when what it is in returns (a read of a disc image over the network that does not come back is
+ * not waited for). The thread owns what it reads with, and these results through a shared
+ * pointer (RunDetached()): nothing of the closed navigator is touched.
+ */
+class CScanResults
+{
+public:
+  enum class State
+  {
+    UNKNOWN, //!< not read, not readable, or not enough to tell
+    FILM,
+    NOT_FILM,
+  };
+
+  //! \brief (the thread) which titles will be read
+  void Plan(const std::set<int>& titles)
+  {
+    std::lock_guard lock(m_mutex);
+    m_plan = titles;
+    m_planned = true;
+    m_changed.notify_all();
+  }
+  //! \brief (the thread) what was found for a title
+  void Set(int title, State state)
+  {
+    std::lock_guard lock(m_mutex);
+    m_results[title] = state;
+    m_changed.notify_all();
+  }
+  //! \brief (the thread) it ends: nothing more is to come
+  void Finish()
+  {
+    std::lock_guard lock(m_mutex);
+    m_planned = true;
+    m_finished = true;
+    m_changed.notify_all();
+  }
+  //! \brief (the owner) give up: the thread stops at its next look, and nobody waits for it
+  void Stop()
+  {
+    m_stop = true;
+    std::lock_guard lock(m_mutex);
+    m_changed.notify_all();
+  }
+  bool Stopped() const { return m_stop.load(); }
+  bool Finished() const
+  {
+    std::lock_guard lock(m_mutex);
+    return m_finished;
+  }
+  size_t Count() const
+  {
+    std::lock_guard lock(m_mutex);
+    return m_results.size();
+  }
+
+  /*!
+   * \brief (the owner) what was found for a title
+   * \param wait how long to wait, at the most, if the title has not been read yet but will be
+   */
+  State Get(int title, std::chrono::milliseconds wait)
+  {
+    std::unique_lock lock(m_mutex);
+    const auto known = [&] { return m_results.contains(title) || m_finished || m_stop; };
+    const auto expected = [&] { return !m_planned || m_plan.contains(title); };
+    if (!known() && expected() && wait.count() > 0)
+      m_changed.wait_for(lock, wait,
+                         [&] { return known() || (m_planned && !m_plan.contains(title)); });
+    if (m_stop)
+      return State::UNKNOWN;
+    const auto it = m_results.find(title);
+    return it == m_results.end() ? State::UNKNOWN : it->second;
+  }
+
+private:
+  std::atomic<bool> m_stop{false};
+  mutable std::mutex m_mutex;
+  std::condition_variable m_changed;
+  bool m_planned = false;
+  bool m_finished = false;
+  std::set<int> m_plan;
+  std::map<int, State> m_results;
+};
+
+/*!
+ * \brief Runs a scan on a thread of its own that nobody joins: \a job(results) reads, looks at
+ *        CScanResults::Stopped() as often as it can, and keeps what it needs; the results end
+ *        finished whatever it did
+ */
+template<class Job>
+void RunDetached(std::shared_ptr<CScanResults> results, Job job)
+{
+  std::thread(
+      [results = std::move(results), job = std::move(job)]() mutable
+      {
+        job(*results);
+        results->Finish();
+      })
+      .detach();
+}
 } // namespace KODI::DISC
