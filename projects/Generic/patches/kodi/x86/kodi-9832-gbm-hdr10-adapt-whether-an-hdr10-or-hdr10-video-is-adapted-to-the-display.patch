+ */
+
+#pragma once
+
+/*
+ * Hades: an HDR10 or HDR10+ video adapted to the display by the player (videoscreen.hadeshdr10adapt):
+ * its picture mapped to the peak of the display by the bridge, as an HDR picture that is not
+ * reconstructed is mapped to SDR (dvbridge_render_plain(): the BT.2390 curve guided by the static
+ * HDR10 metadata of the stream, the perceptual gamut mapping), and sent as HDR10 told that peak. For a
+ * projector, or a display that maps less well than the player does. This decides, once per video,
+ * from what the first picture asked says of itself and what the display is: no GL here, so that a
+ * test runs it on the host.
+ *
+ * Automatic decides by the peak of the source: its MaxCLL where the stream gives one that can be
+ * used, else the peak of its mastering display. MaxCLL is the brightest pixel of the content, the
+ * mastering display only what it could show: a film mastered on a monitor of 4000 cd/m2 may have
+ * nothing above 1000, and on a display of 1000 it is left as it is. The curve itself takes the peak
+ * of the mastering display first and MaxCLL only where that is missing (libplacebo,
+ * pl_color_space_nominal_luma_ex(), read in the libplacebo of this build): it never maps from a
+ * MaxCLL that a stream gives too low, which would clip what is above it. The 99.98th percentile that
+ * Hades measures of a picture exists only where native Dolby Vision is drawn, not on this way: not
+ * used. Without either peak nothing is mapped (the curve would have to guess, as for the mapping to
+ * SDR: PlainMappingEligible()).
+ */
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace HDR10_ADAPT
+{
+
+//! The values of videoscreen.hadeshdr10adapt
+enum class Mode
+{
+  OFF = 0, //!< as the video is: the display maps it (the default)
+  ALWAYS = 1, //!< every HDR10 and HDR10+ video that can be
+  AUTOMATIC = 2, //!< only a video whose peak is above that of the display
+};
+
+enum class Verdict
+{
+  ADAPTED, //!< mapped to the display
+  OFF, //!< the setting is off
+  NOT_HDR10, //!< not a PQ picture (SDR, HLG)
+  DOLBY_VISION, //!< a Dolby Vision picture (its own, or HDR10 sent as Dolby Vision): not this way
+  NO_HDR10_OUTPUT, //!< the output takes no HDR10 (an SDR one maps it to SDR, as before)
+  NOT_TAKEN, //!< not a picture the bridge maps: BT.2020 with its matrix, progressive, 2D
+  NO_SOURCE_PEAK, //!< the stream gives neither MaxCLL nor the peak of its mastering display
+  NO_DISPLAY_PEAK, //!< the display gives no peak (its EDID), and none is set for the mapping
+  NOT_BRIGHTER, //!< automatic: the peak of the source is not above that of the display
+};
+
+//! What a picture says of itself
+struct Picture
+{
+  bool pq = false;
+  bool bt2020 = false; //!< BT.2020 primaries
+  bool ncl = false; //!< ... and the BT.2020 matrix for non-constant luminance
+  bool dolbyVision = false;
+  bool interlaced = false;
+  bool stereo = false;
+  double mdl = 0; //!< the peak of its mastering display, cd/m2 (0 not given)
+  double maxCll = 0; //!< its MaxCLL, cd/m2 (0 not given)
+};
+
+//! What the display is
+struct Display
+{
+  bool hdr10Output = false; //!< the output takes HDR10 (Kodi's HDR output on, the display takes PQ)
+  double peak = 0; //!< cd/m2: the one set for the mapping to the display, else its EDID's (0 none)
+  bool peakSet = false; //!< ... the one set in the settings (videoscreen.hadesdvhdr10peak)
+};
+
+struct Decision
+{
+  Verdict verdict = Verdict::OFF;
+  double sourcePeak = 0; //!< cd/m2, where one is known
+  bool fromMaxCll = false; //!< ... it is the MaxCLL of the stream (else its mastering display)
+  double displayPeak = 0;
+};
+
+//! A peak that the curve can take: above 0, at most the 10000 cd/m2 of PQ
+constexpr bool Usable(double nits)
+{
+  return nits > 0 && nits <= 10000;
+}
+
+constexpr Decision Decide(Mode mode, const Picture& picture, const Display& display)
+{
+  Decision d;
+  d.displayPeak = display.peak;
+  if (Usable(picture.maxCll))
+  {
+    d.sourcePeak = picture.maxCll;
+    d.fromMaxCll = true;
+  }
+  else if (Usable(picture.mdl))
+    d.sourcePeak = picture.mdl;
+  if (mode != Mode::ALWAYS && mode != Mode::AUTOMATIC)
+    d.verdict = Verdict::OFF;
+  else if (picture.dolbyVision)
+    d.verdict = Verdict::DOLBY_VISION;
+  else if (!picture.pq)
+    d.verdict = Verdict::NOT_HDR10;
+  else if (!display.hdr10Output)
+    d.verdict = Verdict::NO_HDR10_OUTPUT;
+  else if (!picture.bt2020 || !picture.ncl || picture.interlaced || picture.stereo)
+    d.verdict = Verdict::NOT_TAKEN;
+  else if (d.sourcePeak <= 0)
+    d.verdict = Verdict::NO_SOURCE_PEAK;
+  else if (!Usable(display.peak))
+    d.verdict = Verdict::NO_DISPLAY_PEAK;
+  else if (mode == Mode::AUTOMATIC && !(d.sourcePeak > display.peak))
+    d.verdict = Verdict::NOT_BRIGHTER;
+  else
+    d.verdict = Verdict::ADAPTED;
+  return d;
+}
+
+//! For the log: why a video is adapted or not (a fixed text)
+constexpr const char* Why(Verdict verdict)
+{
+  switch (verdict)
+  {
+    case Verdict::ADAPTED:
+      return "it is adapted to the display, where its renderer can draw it so (VAAPI)";
+    case Verdict::OFF:
+      return "the setting is off";
+    case Verdict::NOT_HDR10:
+      return "it is not an HDR10 (PQ) picture";
+    case Verdict::DOLBY_VISION:
+      return "it goes out as Dolby Vision";
+    case Verdict::NO_HDR10_OUTPUT:
+      return "the output takes no HDR10 (an SDR output maps HDR10 to SDR, as before)";
+    case Verdict::NOT_TAKEN:
+      return "it is not a picture the bridge maps (BT.2020 with its matrix, progressive, 2D)";
+    case Verdict::NO_SOURCE_PEAK:
+      return "the video gives neither its MaxCLL nor the peak of its mastering display";
+    case Verdict::NO_DISPLAY_PEAK:
+      return "the display gives no peak in its EDID, and none is set for the mapping to the display";
+    case Verdict::NOT_BRIGHTER:
+      return "its peak is not above that of the display";
+  }
+  return "";
+}
+
+//! For the player information (hades.out.adapt): "" where nothing is to be said of it (the setting off,
+//! a video that is not HDR10, an output that takes no HDR10, a picture the bridge does not map)
+constexpr const char* Code(Verdict verdict, Mode mode)
+{
+  switch (verdict)
+  {
+    case Verdict::ADAPTED:
+      return mode == Mode::ALWAYS ? "always" : "brighter";
+    case Verdict::NOT_BRIGHTER:
+      return "notbrighter";
+    case Verdict::NO_SOURCE_PEAK:
+    case Verdict::NO_DISPLAY_PEAK:
+      return "no";
+    default:
+      return "";
+  }
+}
+
+} // namespace HDR10_ADAPT
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
-- 
2.53.0

