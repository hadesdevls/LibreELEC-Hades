From 992c0fef75c6eee8a95bcf3babda2f6fc7bcd5aa Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 15 Oct 2026 20:03:45 +0100
Subject: [PATCH] [VideoInfoScanner] Close the database again after adding a
 set

AddSet() opens the scanner's database, as it can be called from outside
a scan, but never closed it, so each set added left it opened once more.
The scan's own Close() then no longer closed the connection. Close it
again once the set has been added.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6a2f1408746fcb6712cef71908d8fc254cf7b5a0)
---
 xbmc/video/VideoInfoScanner.cpp          |  7 ++++---
 xbmc/video/test/TestVideoInfoScanner.cpp | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index d705a05..25c0406 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -2119,10 +2119,11 @@ CVideoInfoScanner::~CVideoInfoScanner()
     const int idSet{m_database.AddSet(set.GetTitle(), set.GetOverview(), set.GetOriginalTitle())};
 
     // Assume art in set
-    if (idSet > 0)
-      return m_database.SetArtForItem(idSet, MediaTypeVideoCollection, set.GetArt());
+    const bool added{idSet > 0 &&
+                     m_database.SetArtForItem(idSet, MediaTypeVideoCollection, set.GetArt())};
 
-    return false;
+    m_database.Close();
+    return added;
   }
 
   long CVideoInfoScanner::AddVideo(CFileItem* pItem,
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index b0c12ad..44d5f20 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -27,6 +27,7 @@
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "utils/URIUtils.h"
+#include "video/SetInfoTag.h"
 #include "video/VideoDatabase.h"
 #include "video/VideoInfoScanner.h"
 #include "video/VideoManagerTypes.h"
@@ -177,6 +178,8 @@ public:
 
   using CVideoInfoScanner::EnumerateSeriesFolder;
   using EpisodeResult = CVideoInfoScanner::EpisodeResult;
+
+  CVideoDatabase& Database() { return m_database; }
 };
 
 class TestVideoInfoScanner : public ::testing::Test
@@ -439,6 +442,21 @@ TEST_F(TestVideoInfoScanner, ABlurayRipOfADatedEpisodeIsOneEpisode)
   EXPECT_EQ(1U, episodes.size());
 }
 
+TEST_F(TestVideoInfoScanner, AddingASetLeavesTheDatabaseAsItWas)
+{
+  TestScanner scanner{m_settings};
+  CVideoDatabase& database{scanner.Database()};
+  ASSERT_TRUE(database.IsOpen());
+
+  CSetInfoTag set;
+  set.SetTitle("Collection");
+  EXPECT_TRUE(scanner.AddSet(set));
+
+  // Close() only closes once it has been called as often as Open()
+  database.Close();
+  EXPECT_FALSE(database.IsOpen());
+}
+
 TEST_F(TestVideoInfoScanner, ACancelledScanDoesNotHideTheSameScanAskedForAgain)
 {
   CVideoLibraryScanningJob cancelled{m_root};
-- 
