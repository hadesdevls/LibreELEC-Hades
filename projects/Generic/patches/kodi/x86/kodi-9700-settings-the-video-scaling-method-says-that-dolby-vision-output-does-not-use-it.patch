diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index 947e10b..359b4c0 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -626,6 +626,13 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // the black of the display for Dolby Vision Low-Latency (System > Display): label, help
   if (labelId >= 40980 && labelId <= 40983)
     return CGUIUtils::GetHadesString(labelId, 32276 + (labelId - 40980));
+  // the video scaling method (the video settings of the player): Kodi's own label, and where it does
+  // not apply: the Dolby Vision bridge scales the picture itself, with its own filters
+#ifdef HAVE_DVBRIDGE
+  if (labelId == 16300)
+    return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(16300) + " " +
+           CGUIUtils::GetHadesString(41140, 32620);
+#endif
   // the display that Dolby Vision mapped to SDR is made for (System > Display): label, help, values
   if (labelId >= 41130 && labelId <= 41134)
     return CGUIUtils::GetHadesString(labelId, 32610 + (labelId - 41130));
