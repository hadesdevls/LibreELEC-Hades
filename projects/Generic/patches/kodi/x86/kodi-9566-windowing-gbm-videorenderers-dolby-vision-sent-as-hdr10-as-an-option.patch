+void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
+                                             const CDVMetadataBuffer& metadata)
+{
+  if (m_dvPlusOn != 1 || !m_dvPlusGl || !m_dvConvertBridge || layer.pts == m_dvPlusMeasuredPts)
+    return;
+  unsigned int texture = 0;
+  int width = 0, height = 0;
+  dvbridge_view place{};
+  if (!m_dvConvertBridge->ConversionPicture(texture, width, height, place))
+    return;
+  // the film's own part of the place: the active area of its level 5 block (the bars of a film
+  // coded with them are not of the film, which coded without them is shown the same way:
+  // dvbridge_dvplus_area())
+  const float source[4] = {place.src_x0, place.src_y0, place.src_x1, place.src_y1};
+  const int at[4] = {place.dst_x, place.dst_y, place.dst_width, place.dst_height};
+  int area[4];
+  dvbridge_dvplus_area(metadata.Data(), metadata.Size(), layer.width, layer.height, source, at,
+                       area);
+  if (dvbridge_dvplus_gl_submit(m_dvPlusGl.get(), texture, width, height, area[0], area[1],
+                                area[2], area[3], layer.pts))
+    m_dvPlusMeasuredPts = layer.pts;
+}
