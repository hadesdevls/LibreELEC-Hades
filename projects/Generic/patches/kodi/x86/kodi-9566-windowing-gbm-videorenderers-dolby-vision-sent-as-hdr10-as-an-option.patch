diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 42255ac..6bbebce 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1522,6 +1522,21 @@ bool CDVBridgeGLES::CopyConversion(
   return true;
 }
 
+bool CDVBridgeGLES::ConversionPicture(unsigned int& texture,
+                                      int& width,
+                                      int& height,
+                                      dvbridge_view& place) const
+{
+  const pl_tex picture = m_renderer ? dvbridge_render_hdr10_last(m_renderer) : nullptr;
+  if (!picture || !m_gl)
+    return false;
+  texture = pl_opengl_unwrap(m_gl->gpu, picture, nullptr, nullptr, nullptr);
+  width = m_convertWidth;
+  height = m_convertHeight;
+  place = m_convertView;
+  return texture != 0;
+}
+
 void CDVBridgeGLES::LogConversion() const
 {
   if (m_plainMapped || m_plainFailed)
