+bool CWinSystemGbmGLESContext::DVPlusPossible() const
+{
+  return BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVASHDR10PLUS, false) &&
+         GetDisplayHDRCapabilities().SupportsHDR10Plus();
+}
+
+void CWinSystemGbmGLESContext::DVPlusEnd()
+{
+  if (m_dvPlus && m_dvPlusOn == 1)
+  {
+    dvbridge_dvplus_counts c{};
+    dvbridge_dvplus_get_counts(m_dvPlus.get(), &c);
+    CLog::Log(LOGINFO,
+              "DVBridge: Dolby Vision sent as HDR10+: {} pictures went out with HDR10+ metadata "
+              "measured from their scene and {} without (nothing of the video measured yet, or no "
+              "measurement for {} pictures); {} scenes, {} changes of the metadata within a scene; "
+              "{} pictures measured, {} measurements dropped (of a scene that had ended)",
+              c.sent, c.unsent, dvbridge_dvplus_default_params.lost, c.scenes, c.changes,
+              c.measured, c.dropped);
+  }
+  m_dvPlus.reset();
+  if (m_dvPlusGl)
+    dvbridge_dvplus_gl_reset(m_dvPlusGl.get());
+  m_dvPlusOn = -1;
+  m_dvPlusMeasuredPts = DVD_NOPTS_VALUE;
+  m_dvPlusFrames = 0;
+  m_dvPlusSending = false;
+}
+
+std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR10Plus(
+    double pts, const CDVMetadataBuffer& metadata)
+{
+  if (m_dvPlusRestart.exchange(false))
+    DVPlusEnd();
+  if (m_dvPlusOn < 0)
+  {
+    // decided once a video, with its first picture drawn this way
+    m_dvPlusOn = 0;
+    if (BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVASHDR10PLUS, false))
+    {
+      const char* why = nullptr;
+      if (!GetDisplayHDRCapabilities().SupportsHDR10Plus())
+        why = "the display does not declare HDR10+, or its driver cannot send it (HDR10PLUS_VSIF)";
+      else if (m_dvConvertMapping.enabled)
+        why = "the picture is mapped to the display (System > Display), and HDR10+ describes the "
+              "picture as it was mastered";
+      if (!why)
+      {
+        m_dvPlus.reset(dvbridge_dvplus_create(nullptr));
+        if (!m_dvPlusGl)
+          m_dvPlusGl.reset(dvbridge_dvplus_gl_create());
+        if (!m_dvPlusPicture)
+          m_dvPlusPicture.reset(
+              static_cast<dvbridge_dvplus_picture*>(std::calloc(1, sizeof(dvbridge_dvplus_picture))));
+        if (!m_dvPlus || !m_dvPlusGl || !m_dvPlusPicture)
+          why = "its measurement on the GPU could not be set up";
+      }
+      m_dvPlusOn = why ? 0 : 1;
+      if (why)
+        CLog::Log(LOGINFO,
+                  "DVBridge: Dolby Vision rebuilt as HDR10 is not sent as HDR10+ in this video: {}; "
+                  "it goes out as HDR10",
+                  why);
+      else
+        CLog::Log(LOGINFO,
+                  "DVBridge: Dolby Vision rebuilt as HDR10 goes out as HDR10+: dynamic metadata "
+                  "measured from the rebuilt picture, per scene of its Dolby Vision metadata "
+                  "(application version 1, the luminance parameters, no tone mapping curve)");
+    }
+  }
+  if (m_dvPlusOn != 1 || pts == DVD_NOPTS_VALUE)
+  {
+    if (m_dvPlusSending.exchange(false))
+      PublishDVInfo(true);
+    return std::nullopt;
+  }
+  // the samples that the GPU has finished, into the scenes of their pictures
+  dvbridge_dvplus_gl_collect(
+      m_dvPlusGl.get(),
+      [](double measured, const uint16_t* codes, size_t count, void* context)
+      {
+        auto* self = static_cast<CWinSystemGbmGLESContext*>(context);
+        dvbridge_dvplus_picture* picture = self->m_dvPlusPicture.get();
+        std::memset(picture, 0, sizeof(*picture));
+        picture->pts = measured;
+        dvbridge_dvplus_picture_add(self->m_dvPlus.get(), picture, codes, count);
+        dvbridge_dvplus_measured(self->m_dvPlus.get(), picture);
+      },
+      this);
+  dvbridge_dvplus_rpu rpu{};
+  dvbridge_dvplus_rpu_of(metadata.Data(), metadata.Size(), &rpu);
+  dvbridge_dvplus_stats stats{};
+  const bool send = dvbridge_dvplus_present(m_dvPlus.get(), pts, &rpu, &stats, nullptr);
+  if (++m_dvPlusFrames % 240 == 0)
+  {
+    dvbridge_dvplus_counts c{};
+    dvbridge_dvplus_get_counts(m_dvPlus.get(), &c);
+    CLog::Log(LOGINFO,
+              "DVBridge: Dolby Vision sent as HDR10+: so far {} pictures with HDR10+ and {} without, "
+              "{} scenes, {} changes within a scene, {} pictures measured, {} dropped; now {}",
+              c.sent, c.unsent, c.scenes, c.changes, c.measured, c.dropped,
+              send ? StringUtils::Format("maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2",
+                                         stats.average / 10.0, stats.percentiles[8] / 10.0)
+                   : std::string("nothing (the frames go out as HDR10)"));
+  }
+  if (!send)
+  {
+    if (m_dvPlusSending.exchange(false))
+      PublishDVInfo(true);
+    return std::nullopt;
+  }
+  AVDynamicHDRPlus made{};
+  dvbridge_dvplus_metadata(&stats, &made);
+  const char* refused = nullptr;
+  std::optional<std::array<uint8_t, 27>> payload = KODI::UTILS::HDR10PLUS::MakeVsif(made, &refused);
+  if (!payload)
+  {
+    // (not with what is made, which is of the InfoFrame's own form; fail closed all the same)
+    CLog::Log(LOGWARNING,
+              "DVBridge: HDR10+ made from Dolby Vision cannot go in its InfoFrame ({}): the video "
+              "goes on as HDR10",
+              refused ? refused : "");
+    m_dvPlusOn = 0;
+    if (m_dvPlusSending.exchange(false))
+      PublishDVInfo(true);
+    return std::nullopt;
+  }
+  if (!m_dvPlusSending.exchange(true))
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: Dolby Vision sent as HDR10+: the first metadata measured go out, maxRGB "
+              "average {:.1f} and 99.98 % {:.1f} cd/m2",
+              stats.average / 10.0, stats.percentiles[8] / 10.0);
+    PublishDVInfo(true);
+  }
+  return payload;
+}
