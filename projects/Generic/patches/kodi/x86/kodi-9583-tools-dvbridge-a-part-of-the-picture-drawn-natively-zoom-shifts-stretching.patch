From 1a3c7cf86ee698215c0fa1f06daa390cc5bfaa4b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:59:06 +0000
Subject: [PATCH] tools/dvbridge: a part of the picture drawn natively (zoom,
 shifts, stretching)

The geometry of a picture of native Dolby Vision output gets a view: the part of the picture that is
drawn at its place on the raster, x0, y0, x1, y1 in its luma samples. All 0, as every geometry made so
far has it, is the whole picture at its own shape, as before; a view, even of the whole picture, lets the
picture be drawn at another shape (stretching, pixels that are not square), and a part of it lets it be
zoomed or shifted out of the raster.

- The serializer takes the level 5 active area through the view on each axis
  (dvbridge_dv_geometry_view(), dvbridge_dv_through_view()): an edge of the active area inside the part
  drawn lands where that part puts it, one outside it on the edge of the place; both readings of the
  offsets (of the picture, of a 4K master: dvbridge_dv_margins()) go through it. CCM 001 6.2.2 gives
  the active area in the coordinates of the picture sent, which is the raster.
- The source transport scales the view with the scaler of a scaled picture (dvbridge_source_scale(),
  the tables placed by the view's edges); a shift at the picture's own scale is a copy. The converted
  transport gives libplacebo the view as the image's crop.
- A view of the whole picture at its own size draws as no view does: the same code, the same bytes.

Tested on Mesa's software OpenGL ES (zink on lavapipe): the margins of eleven geometries worked out by
hand (zoom of 4K and of 1080p, shifts up and down out of the raster, a crop of a master, a stretched
1440x1080, a view beyond the picture refused), and with the view taken out of dvbridge_dv_area() and of
the master reading five of them fail; zoomed and shifted pictures (a 1080p profile 5 chart, a 4K
profile 7 FEL picture, the same at 1080p with its layer) in the source transport are the CPU's integer
reference of the view code by code, both ways, and read as CCM 001 says they are sent (the independent
reader: copies, CRC, header, the active area through the view, black outside it); the converted
transport with a view reads so too; the bridge of the commit before, which has no view, differs from
that reference in 2.7 to 6.6 million of the samples; the whole picture as its view, the same bytes as
without one.

Kodi gives no view yet: its renderer's geometry of the whole picture says that it has none (it builds
with missing field initializers as errors).
---
 tools/dvbridge/dvbridge_core.c                |  8 ++-
 tools/dvbridge/dvbridge_core.h                | 30 +++++++++++
 tools/dvbridge/dvbridge_metadata.h            | 54 +++++++++++++++++--
 tools/dvbridge/dvbridge_render.c              | 45 +++++++++++-----
 .../HwDecRender/RendererVAAPIGLES.cpp         |  3 +-
 5 files changed, 121 insertions(+), 19 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 8742c1d..343c0f3 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -113,8 +113,12 @@ struct dvbridge_candidate *dvbridge_prepare_why(
     candidate->state.cm29_only = context->cm29_only;
     /* (the serializer refuses more than one level 5 block, and sets the margins from the one
      * there is, or from none: dvbridge_dv_margins()) */
-    if (!dvbridge_dv_geometry(&candidate->state, geometry.source_width, geometry.source_height,
-            geometry.x, geometry.y, geometry.width, geometry.height)) {
+    /* (Hades: and the part of the picture drawn, where the geometry says it) */
+    float view[4];
+    dvbridge_geometry_view(&geometry, view);
+    if (!dvbridge_dv_geometry_view(&candidate->state, geometry.source_width,
+            geometry.source_height, geometry.x, geometry.y, geometry.width, geometry.height,
+            dvbridge_geometry_has_view(&geometry) ? view : NULL)) {
         *why = candidate->state.refused;
         free(candidate);
         return NULL;
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index cc469da..1a9bb3b 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -15,7 +15,37 @@ struct dvbridge_candidate;
 struct dvbridge_geometry {
     int source_width, source_height;
     int x, y, width, height;
+    /* Hades: the part of the picture that is drawn at x, y, width x height: x0, y0, x1, y1 in its
+     * luma samples (zoom, a shift out of the raster, stretching, pixels that are not square). All 0
+     * (as a geometry made without it has them): the whole picture at its own shape, as before. A
+     * view, even of the whole picture, lets it be drawn at another shape. */
+    float view[4];
 };
+#define DVBRIDGE_GEOMETRY_VIEW 1
+
+/* Hades: whether a geometry has a view */
+static inline bool dvbridge_geometry_has_view(const struct dvbridge_geometry *g)
+{
+    return g->view[0] != 0.0f || g->view[1] != 0.0f || g->view[2] != 0.0f || g->view[3] != 0.0f;
+}
+
+/* Hades: the view of a geometry, the whole picture where it has none; and whether it is the whole */
+static inline void dvbridge_geometry_view(const struct dvbridge_geometry *g, float v[4])
+{
+    const bool none = !dvbridge_geometry_has_view(g);
+    v[0] = none ? 0.0f : g->view[0];
+    v[1] = none ? 0.0f : g->view[1];
+    v[2] = none ? (float)g->source_width : g->view[2];
+    v[3] = none ? (float)g->source_height : g->view[3];
+}
+
+static inline bool dvbridge_geometry_whole(const struct dvbridge_geometry *g)
+{
+    float v[4];
+    dvbridge_geometry_view(g, v);
+    return v[0] == 0.0f && v[1] == 0.0f && v[2] == (float)g->source_width &&
+           v[3] == (float)g->source_height;
+}
 
 struct dvbridge_context *dvbridge_create(void);
 void dvbridge_destroy(struct dvbridge_context *context);
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index ddd5703..1ecf6e0 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -45,6 +45,10 @@ struct dvbridge_dv {
     uint64_t frames, changes;
     double last_pts;
     int source_w, source_h, dest_x, dest_y, dest_w, dest_h;
+    /* Hades: the part of the picture drawn there (dvbridge_geometry's view), where it is not the whole
+     * picture (has_view) */
+    bool has_view;
+    double view[4];
     bool fel_verified;
     unsigned compatibility_omissions;
     /* Hades: where the payload holds the count of its extension blocks, which follow it (0: no
@@ -135,17 +139,45 @@ static inline bool dvbridge_dv_readable(const AVDOVIMetadata *m, size_t bytes)
 }
 /* All scaling/letterboxing precedes transport packing. L5 describes the
  * final HDMI raster, not the dimensions of a cropped source file. */
-static inline bool dvbridge_dv_geometry(struct dvbridge_dv *d, int w, int h,
-                              int x, int y, int dw, int dh)
+static inline bool dvbridge_dv_geometry_view(struct dvbridge_dv *d, int w, int h,
+                              int x, int y, int dw, int dh, const float view[4])
 {
     DV_REFUSE(w > 0 && h > 0 && w <= 3840 && h <= 2160, "the picture is larger than 3840x2160");
     DV_REFUSE(dw > 0 && dh > 0 && x >= 0 && y >= 0 && x+dw <= 3840 && y+dh <= 2160,
               "the picture is drawn outside the 3840x2160 raster");
     DV_REFUSE(!(x & 1) && !(dw & 1), "the picture is drawn at an odd column or an odd width");
-    DV_REFUSE(fabs((double)dw*h/w - dh) <= 1.01, "the picture is not drawn at its own shape");
+    /* Hades: with a view (the part of the picture drawn: zoom, a shift out of the raster,
+     * stretching, pixels that are not square; dvbridge_geometry), that part is drawn at whatever
+     * shape it is drawn, and the active area is taken through it on each axis (dvbridge_dv_area()).
+     * Without one, the whole picture at its own shape, as before. */
+    const bool whole = !view || (view[0] == 0.0f && view[1] == 0.0f && view[2] == (float)w &&
+                                 view[3] == (float)h);
+    if (view)
+        DV_REFUSE(isfinite(view[0]) && isfinite(view[1]) && isfinite(view[2]) &&
+                  isfinite(view[3]) && view[0] >= 0.0f && view[1] >= 0.0f &&
+                  view[2] <= (float)w && view[3] <= (float)h && view[2] - view[0] >= 1.0f &&
+                  view[3] - view[1] >= 1.0f,
+                  "the part of the picture drawn is not within the picture");
+    else
+        DV_REFUSE(fabs((double)dw*h/w - dh) <= 1.01, "the picture is not drawn at its own shape");
+    for (int i = 0; i < 4 && !whole; ++i)
+        d->view[i] = (double)view[i];
+    d->has_view = !whole;
     d->source_w=w;d->source_h=h;d->dest_x=x;d->dest_y=y;d->dest_w=dw;d->dest_h=dh;
     return true;
 }
+static inline bool dvbridge_dv_geometry(struct dvbridge_dv *d, int w, int h,
+                              int x, int y, int dw, int dh)
+{
+    return dvbridge_dv_geometry_view(d, w, h, x, y, dw, dh, NULL);
+}
+/* Hades: an edge of the active area, at offset in the picture's samples from its first edge (left
+ * or top), on the raster through the view: in [0, size] of the place */
+static inline long dvbridge_dv_through_view(double offset, double v0, double v1, int size)
+{
+    const long at = lround((offset - v0) * size / (v1 - v0));
+    return at < 0 ? 0 : at > size ? size : at;
+}
 /* The level 5 offsets as offsets of the decoded picture, in the 3840x2160 raster: false when they
  * do not leave a picture. */
 static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned r,
@@ -154,6 +186,15 @@ static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned
     int w=d->source_w ? d->source_w : 3840, h=d->source_h ? d->source_h : 2160;
     int dw=d->dest_w ? d->dest_w : 3840, dh=d->dest_h ? d->dest_h : 2160;
     DV_REQUIRE(l < (unsigned)w && r < (unsigned)w-l && t < (unsigned)h && b < (unsigned)h-t);
+    /* Hades: through the part of the picture drawn, where it is not all of it: the edges of the
+     * active area beyond that part are those of its place */
+    if (d->has_view) {
+        v[0]=d->dest_x+dvbridge_dv_through_view(l, d->view[0], d->view[2], dw);
+        v[1]=3840-d->dest_x-dw+(dw-dvbridge_dv_through_view((double)w-r, d->view[0], d->view[2], dw));
+        v[2]=d->dest_y+dvbridge_dv_through_view(t, d->view[1], d->view[3], dh);
+        v[3]=2160-d->dest_y-dh+(dh-dvbridge_dv_through_view((double)h-b, d->view[1], d->view[3], dh));
+        return v[0]+v[1]<3840 && v[2]+v[3]<2160;
+    }
     v[0]=d->dest_x+lround((double)l*dw/w);
     v[1]=3840-d->dest_x-dw+lround((double)r*dw/w);
     v[2]=d->dest_y+lround((double)t*dh/h);
@@ -210,6 +251,13 @@ static inline bool dvbridge_dv_margins(struct dvbridge_dv *d, unsigned l, unsign
             const double left = fmax(0.0, offsets[i] - removed[i / 2]); /* in the master */
             const double scale = i < 2 ? (double)dw / w : (double)dh / h;
             m[i] = (unsigned)lround(left / s * scale);
+            /* Hades: through the part of the picture drawn (see dvbridge_dv_area()) */
+            if (d->has_view) {
+                const double at = left / s, v0 = d->view[i < 2 ? 0 : 1], v1 = d->view[i < 2 ? 2 : 3];
+                const int size = i < 2 ? dw : dh, full = i < 2 ? w : h;
+                m[i] = (unsigned)(i % 2 == 0 ? dvbridge_dv_through_view(at, v0, v1, size)
+                                             : size - dvbridge_dv_through_view(full - at, v0, v1, size));
+            }
         }
         m[0] += d->dest_x;
         m[1] += 3840 - d->dest_x - dw;
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 0867f4f..7fac715 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -674,10 +674,18 @@ static bool chroma_shift(const struct pl_frame *f, float *sx, float *sy)
     return false;
 }
 
-/* Hades: a picture drawn at another size than its own */
+/* Hades: a picture drawn at another size than its own, or a part of it (its view) */
 static bool scaled(struct dvbridge_geometry g)
 {
-    return g.width != g.source_width || g.height != g.source_height;
+    return g.width != g.source_width || g.height != g.source_height ||
+           !dvbridge_geometry_whole(&g);
+}
+
+/* Hades: the view of a geometry for the packer: NULL for the whole picture */
+static const float *view_of(const struct dvbridge_geometry *g, float v[4])
+{
+    dvbridge_geometry_view(g, v);
+    return dvbridge_geometry_whole(g) ? NULL : v;
 }
 
 /* Hades: whether a picture goes out in the source transport: it is asked for, the composer of
@@ -691,15 +699,16 @@ static bool source_possible(struct dvbridge_renderer *r, const struct pl_frame *
     r->source_why = NULL;
     if (!r->source_wanted)
         return false;
-    float sx = 0.0f, sy = 0.0f;
+    float sx = 0.0f, sy = 0.0f, v[4];
     if (!r->source_packer)
         r->source_why = "the packer of the transport could not be made on this GPU";
     else if (r->legacy_composer)
         r->source_why = "the composer of ETSI GS CCM 001 is turned off";
     else if (scaled(g) && !dvbridge_source_can_scale(r->source_packer))
         r->source_why = "the passes that scale a picture could not be made on this GPU";
-    else if (scaled(g) && !dvbridge_source_scale_covers(g.source_width, g.source_height, NULL,
-                                                         g.width, g.height, &r->source_why))
+    else if (scaled(g) && !dvbridge_source_scale_covers(g.source_width, g.source_height,
+                                                         view_of(&g, v), g.width, g.height,
+                                                         &r->source_why))
         ; /* (source_why says why) */
     else if (!chroma_shift(source, &sx, &sy))
         r->source_why = "the picture has no chroma plane";
@@ -884,8 +893,9 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
     /* the rows of the bars are not composed: the packer writes them black without reading them,
      * and its filter reads at most 6 chroma rows beyond the active ones, which the composer
      * composes (dvbridge_source.h) */
-    if (active_rows && geometry.source_height == 2160 && !geometry.x && !geometry.y &&
-        geometry.width == 3840 && geometry.height == 2160 && (margins[2] || margins[3])) {
+    if (active_rows && !scaled(geometry) && geometry.source_height == 2160 && !geometry.x &&
+        !geometry.y && geometry.width == 3840 && geometry.height == 2160 &&
+        (margins[2] || margins[3])) {
         params.active_rows[0] = (int)margins[2];
         params.active_rows[1] = 2160 - (int)margins[3];
         r->early_mask = true;
@@ -906,11 +916,12 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
     /* Hades: a picture that is scaled is scaled here, in the composer's representation: its luma
      * at the size it is drawn at, and its rows of 4:2:2 chroma at that size, every one of them */
     unsigned luma = composed_luma;
+    float view[4];
     if (composed_luma && chroma && scaled(geometry)) {
         ok = dvbridge_source_scale(r->source_packer, &r->source_params, composed_luma, chroma,
-                                   geometry.source_width, geometry.source_height, NULL,
-                                   geometry.width, geometry.height, geometry.x, geometry.y,
-                                   margins, &luma);
+                                   geometry.source_width, geometry.source_height,
+                                   view_of(&geometry, view), geometry.width, geometry.height,
+                                   geometry.x, geometry.y, margins, &luma);
         r->pack_w = geometry.width;
         r->pack_h = geometry.height;
     } else
@@ -1048,6 +1059,13 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     image.profile = (struct pl_icc_profile){0};
     image.icc = NULL;
     image.lut = NULL;
+    /* Hades: the part of the picture drawn, where it is not all of it (zoom, a shift out of the
+     * raster, stretching: libplacebo scales that part to the place) */
+    if (!dvbridge_geometry_whole(&geometry)) {
+        float v[4];
+        dvbridge_geometry_view(&geometry, v);
+        image.crop = (pl_rect2df){v[0], v[1], v[2], v[3]};
+    }
     struct pl_frame target = {
         .num_planes = 1,
         .planes = {{.texture = packed ? packed : r->rgb, .flipped = packed && flip,
@@ -1088,7 +1106,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         mask.pattern = r->ll_pattern;
     }
     /* Only a picture that is not scaled is one shader from its planes to the target. */
-    mask.early_mask = early && !mask.pattern &&
+    mask.early_mask = early && !mask.pattern && dvbridge_geometry_whole(&geometry) &&
                       geometry.source_width == 3840 && geometry.source_height == 2160 &&
                       !geometry.x && !geometry.y &&
                       geometry.width == 3840 && geometry.height == 2160 &&
@@ -2212,10 +2230,11 @@ bool dvbridge_render_direct_fits(const struct dvbridge_renderer *r, struct dvbri
 
 bool dvbridge_render_source_scales(const struct dvbridge_renderer *r, struct dvbridge_geometry g)
 {
+    float v[4];
     return r && r->source_wanted && r->source_packer && !r->legacy_composer && scaled(g) &&
            dvbridge_source_can_scale(r->source_packer) &&
-           dvbridge_source_scale_covers(g.source_width, g.source_height, NULL, g.width, g.height,
-                                        NULL);
+           dvbridge_source_scale_covers(g.source_width, g.source_height, view_of(&g, v), g.width,
+                                        g.height, NULL);
 }
 
 bool dvbridge_render_pack(struct dvbridge_renderer *r, struct dvbridge_gl_packer *packer,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
