From cb7e27c9f73e584a70c235753679f5034b16dbb6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:39:55 +0000
Subject: [PATCH] windowing/gbm: the composite over HDR10 and HLG under scissor
 rectangles of the GUI's tile mask

The scissored composite (<video><dvguiscissor>) was for native Dolby Vision
output, where the packer's pass 7 gives the mask. The HDR composite (HDR10, HLG,
Dolby Vision rebuilt as HDR10) draws the whole quad in every frame whose GUI pass
was left out. HdrTilesUpdate() asks dvbridge_guimask for the mask of the GUI FBO's
texture at the first frame of each content (generation) of the GUI whose pass was
left out, so a GUI that changes in every frame never pays for it, takes it back
without waiting, and tags it with the generation like the packer's: it is used
only for a frame of that generation whose pass was left out, and only by the path
it was made for (m_tilesNative). Texture and window have one size, so a tile of
the texture is the tile of the window at the same rows, with the GL origin at the
bottom of both (the ordinary projection of CompositeGui() puts the top of the
screen on the top row of the window and the texture's top row).

The argument for the bytes is the one of the packer's mask (OpenGL ES 3.0.6,
sections 4.1.2 and 3.5): the same quad under glScissor, the mask marking every
tile where a fragment can survive the alpha-0 discard, with the margin of a
tile. Any doubt draws the whole quad as before: no mask yet, another generation,
a scissor test already enabled by the caller (then the quad is clipped by that
and not by ours), a GPU without GLES 3, more than 24 rectangles or more than half
of the screen marked. The mask maker is made on first use and freed with the GUI
composite; if it cannot be made the log says so once and the whole quad is drawn.
The 10 s line of the HDR composite says how many composites went under how many
rectangles.

Host test (outside the tree): dvguireuse_test (the HDR scissor counters); the
byte comparison is the one of the previous commit.
---
 xbmc/windowing/gbm/DVGuiReuse.h               | 31 ++++++---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 68 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 14 ++++
 3 files changed, 100 insertions(+), 13 deletions(-)

diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index 005d779..d96d37f 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -184,10 +184,18 @@ public:
   void Skipped() { ++m_counts.passesSkipped; }
 
   //! The composite of a frame was drawn under that many scissor rectangles
-  void Scissored(unsigned int rects)
+  void Scissored(unsigned int rects, bool native = true)
   {
-    ++m_counts.scissored;
-    m_counts.rects += rects;
+    if (native)
+    {
+      ++m_counts.scissored;
+      m_counts.rects += rects;
+    }
+    else
+    {
+      ++m_hdrScissored;
+      m_hdrRects += rects;
+    }
   }
 
   //! The reason that the last ask said no, told once when it changes (empty: nothing to tell)
@@ -219,10 +227,15 @@ public:
   {
     if (!m_hdrFrames)
       return std::string();
-    const std::string s = "HDR GUI: last span: " + std::to_string(m_hdrFrames) +
-                          " frames with the GUI composited over the picture, the GUI pass of " +
-                          std::to_string(m_hdrSkipped) + " of them left out (video/dvguireuse)";
-    m_hdrFrames = m_hdrSkipped = 0;
+    std::string s = "HDR GUI: last span: " + std::to_string(m_hdrFrames) +
+                    " frames with the GUI composited over the picture, the GUI pass of " +
+                    std::to_string(m_hdrSkipped) + " of them left out (video/dvguireuse)";
+    if (m_hdrScissored)
+      s += "; " + std::to_string(m_hdrScissored) + " composites drawn under " +
+           std::to_string(m_hdrRects) +
+           " scissor rectangles of the tile mask of the GUI (the same quad, only where the GUI "
+           "reaches; video/dvguiscissor)";
+    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = 0;
     return s;
   }
 
@@ -255,7 +268,7 @@ public:
   void Restart()
   {
     m_told = false;
-    m_hdrFrames = m_hdrSkipped = 0;
+    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = 0;
   }
 
 private:
@@ -265,6 +278,8 @@ private:
   bool m_told = false; //!< the first ask of an output is told whatever it says
   unsigned int m_hdrFrames = 0;
   unsigned int m_hdrSkipped = 0;
+  unsigned int m_hdrScissored = 0;
+  unsigned int m_hdrRects = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0c9069a..6a3cab3 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1920,6 +1920,12 @@ bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
     m_guiFboWidth = 0;
     m_guiFboHeight = 0;
     m_compositeShader.reset();
+    if (m_guiMask)
+    {
+      dvbridge_guimask_destroy(m_guiMask);
+      m_guiMask = nullptr;
+      m_hdrMaskPending = false;
+    }
     m_dvGuiReuse.Restart();
     m_guiSeen = false;
     m_guiReusing = false;
@@ -1968,8 +1974,6 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
   // does not tell where it can reach
   if (guiWillRender)
     ++m_guiGen;
-  if (!m_dvState.Captured())
-    m_tilesUse = false;
   int width = m_nWidth;
   int height = m_nHeight;
 
@@ -2263,7 +2267,10 @@ void CWinSystemGbmGLESContext::CompositeGui()
   // this frame composites (the GUI pass was left out, and the mask is that of its content): the
   // fragments inside the rectangles are those of the whole quad, and outside them the whole quad
   // discards (dvbridge_tiles.h). Any doubt (no mask yet, another GUI): the whole quad.
-  if (dvComposite && m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && !m_tilesRects.empty())
+  if (!dvComposite && m_guiCompositing)
+    HdrTilesUpdate();
+  if (m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && m_tilesNative == dvComposite &&
+      !m_tilesRects.empty() && glIsEnabled(GL_SCISSOR_TEST) == GL_FALSE)
   {
     constexpr int TILE = DVBRIDGE_SOURCE_TILE;
     GLint box[4]{};
@@ -2277,7 +2284,7 @@ void CWinSystemGbmGLESContext::CompositeGui()
     }
     glDisable(GL_SCISSOR_TEST);
     glScissor(box[0], box[1], box[2], box[3]);
-    m_dvGuiReuse.Scissored(static_cast<unsigned int>(m_tilesRects.size()));
+    m_dvGuiReuse.Scissored(static_cast<unsigned int>(m_tilesRects.size()), dvComposite);
   }
   else
 #endif
@@ -6200,6 +6207,56 @@ constexpr int64_t DV_MENUS_SETTLE_MS = 3000;
 constexpr auto DV_MENUS_AFTER_WAKE = std::chrono::seconds(5);
 } // namespace
 
+void CWinSystemGbmGLESContext::HdrTilesUpdate()
+{
+  // (GLES 3: the mask maker reads the GUI texture with texelFetch and the result back with a fence)
+  if (m_renderableType != EGL_OPENGL_ES3_BIT)
+    return;
+  if (m_hdrMaskPending && m_guiMask)
+  {
+    unsigned int columns = 0, rows = 0, serial = 0;
+    m_hdrTiles.resize(DVBRIDGE_GUIMASK_TILES_MAX);
+    const int polled =
+        dvbridge_guimask_poll(m_guiMask, m_hdrTiles.data(), &columns, &rows, &serial);
+    if (polled != 0)
+      m_hdrMaskPending = false;
+    // (a mask is the one of a GUI that has not been drawn since it was asked for)
+    if (polled == 1 && serial == m_guiGen)
+    {
+      m_tilesNative = false;
+      m_tilesRects.assign(DVBRIDGE_TILE_RECTS_MAX, dvbridge_tile_rect{});
+      const int n = dvbridge_tiles_merge(m_hdrTiles.data(), columns, rows, m_tilesRects.data(),
+                                         DVBRIDGE_TILE_RECTS_MAX, 50);
+      m_tilesRects.resize(n > 0 ? static_cast<size_t>(n) : 0);
+      m_tilesUse = n > 0;
+      m_tilesGen = serial;
+    }
+  }
+  // asked for at the first frame of a content of the GUI whose pass was left out: a GUI that
+  // changes in every frame never pays for it
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  if (!m_guiReusing || m_hdrMaskPending || (m_tilesGen == m_guiGen && !m_tilesNative) ||
+      !advanced || !advanced->m_videoDVGuiScissor || !m_guiFbo.IsValid())
+    return;
+  if (!m_guiMask)
+  {
+    m_guiMask = dvbridge_guimask_create();
+    if (!m_guiMask)
+    {
+      CLog::Log(LOGINFO, "HDR GUI: the tile mask of the GUI could not be made on this GPU: the "
+                         "composite is drawn over the whole screen (video/dvguiscissor)");
+      m_tilesGen = m_guiGen; // (not asked for again for this content)
+      m_tilesNative = false;
+      m_tilesUse = false;
+      return;
+    }
+  }
+  if (dvbridge_guimask_request(m_guiMask, m_guiFbo.Texture(), m_guiFboWidth, m_guiFboHeight,
+                               m_guiGen))
+    m_hdrMaskPending = true;
+}
+
 void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
 {
   if (!m_dvBridge)
@@ -6215,6 +6272,7 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
     // nothing of this one)
     if (polled == 1 && serial == m_guiGen)
     {
+      m_tilesNative = true;
       m_tilesRects.assign(DVBRIDGE_TILE_RECTS_MAX, dvbridge_tile_rect{});
       // (more than 24 rectangles, or marked tiles over half of them: the whole quad, as before)
       const int n = dvbridge_tiles_merge(mask, DVBRIDGE_SOURCE_TILE_COLUMNS,
@@ -6225,7 +6283,7 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
       m_tilesGen = serial;
     }
   }
-  if (wanted && !m_tilesPending && m_tilesGen != m_guiGen &&
+  if (wanted && !m_tilesPending && (m_tilesGen != m_guiGen || !m_tilesNative) &&
       m_dvBridge->RequestDrawnTiles(m_guiGen))
     m_tilesPending = true;
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 51ea69f..32eda23 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -55,6 +55,11 @@
 // (Hades: level 5 offsets that say bars where the picture has content)
 #include "dvbridge_l5check.h"
 #include "dvbridge_tiles.h"
+
+extern "C"
+{
+#include "dvbridge_guimask.h"
+}
 // (Hades: HDR10 measured as Dolby Vision, dvbridge_measure.h and dvbridge_measured.h)
 struct dvbridge_measure;
 struct dvbridge_measured;
@@ -469,8 +474,17 @@ private:
   unsigned m_tilesGen{0};
   bool m_tilesPending{false};
   bool m_tilesUse{false};
+  //! ... the mask of the packer's pass 7 (native Dolby Vision output), or of the GUI texture itself
+  //! (the HDR10/HLG composite: dvbridge_guimask.h), which only the path it was made for may use
+  bool m_tilesNative{true};
   std::vector<dvbridge_tile_rect> m_tilesRects;
   void DVTilesUpdate(bool wanted);
+  struct dvbridge_guimask* m_guiMask{nullptr};
+  bool m_hdrMaskPending{false};
+  std::vector<uint8_t> m_hdrTiles;
+  //! Hades: the HDR composite: the mask of the GUI texture, once for each content of it that stays
+  //! for a frame (HdrTilesUpdate(): asked for at the first frame whose GUI pass was left out)
+  void HdrTilesUpdate();
   std::chrono::steady_clock::time_point m_guiHdrLogAt{};
   CDVGuiReuse m_dvGuiReuse;
   CDVGuiReuse::Facts GuiReuseFacts() const;
