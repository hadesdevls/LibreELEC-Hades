From f04cc89c2530ff5a629aa1528ca1b0466ca7fcd7 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 12 Oct 2026 20:24:25 -0700
Subject: [PATCH] [depends] Update TagLib to 2.3.2

Require the upstream Matroska fast-scan fix and drop the local patch.
Use the official archive because this release is not on the Kodi mirror.
---
 cmake/modules/FindTagLib.cmake                |  7 ++--
 ...02-matroska-fast-scan-segment-lookup.patch | 32 -------------------
 tools/depends/target/taglib/Makefile          |  4 +--
 tools/depends/target/taglib/TAGLIB-VERSION    |  6 ++--
 xbmc/filesystem/AudioBookFileDirectory.cpp    |  5 +--
 .../test/TestAudioBookFileDirectory.cpp       |  4 +--
 xbmc/music/tags/MatroskaTagLibStream.h        |  4 +--
 xbmc/music/tags/MatroskaTagReader.cpp         |  2 +-
 xbmc/music/tags/TagLibVersion.h               | 15 +++------
 .../tags/test/TestMatroskaTagReaderFFmpeg.cpp |  2 +-
 10 files changed, 18 insertions(+), 63 deletions(-)
 delete mode 100644 tools/depends/target/taglib/002-matroska-fast-scan-segment-lookup.patch

diff --git a/cmake/modules/FindTagLib.cmake b/cmake/modules/FindTagLib.cmake
index a450d97..b05d048 100644
--- a/cmake/modules/FindTagLib.cmake
+++ b/cmake/modules/FindTagLib.cmake
@@ -24,12 +24,11 @@ if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
   
     set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_VERSION ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_VER})
   
-    set(patches "${CMAKE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/002-matroska-fast-scan-segment-lookup.patch")
     if(WIN32 OR WINDOWS_STORE)
-      list(APPEND patches "${CMAKE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/001-cmake-pdb-debug.patch")
+      set(patches "${CMAKE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/001-cmake-pdb-debug.patch")
+      generate_patchcommand("${patches}")
+      unset(patches)
     endif()
-    generate_patchcommand("${patches}")
-    unset(patches)
 
     if(WINDOWS_STORE)
       set(EXTRA_ARGS -DPLATFORM_WINRT=ON)
diff --git a/tools/depends/target/taglib/002-matroska-fast-scan-segment-lookup.patch b/tools/depends/target/taglib/002-matroska-fast-scan-segment-lookup.patch
deleted file mode 100644
index b59a90b..0000000
--- a/tools/depends/target/taglib/002-matroska-fast-scan-segment-lookup.patch
+++ /dev/null
@@ -1,32 +0,0 @@
---- a/taglib/matroska/matroskafile.cpp
-+++ b/taglib/matroska/matroskafile.cpp
-@@ -381,15 +381,13 @@
-     head->skipData(*this);
-   }
- 
--  offset_t maxOffset = fileLength;
--  if (readStyle == Properties::ReadStyle::Fast && maxOffset > FAST_SCAN_LIMIT) {
--    maxOffset = FAST_SCAN_LIMIT;
--  }
--
--  // Find the Matroska segment in the file
-+  // Find the Matroska segment in the file.  The bound is the whole file because
-+  // Element::factory() rejects any element whose declared data size runs past its
-+  // bound, and a Segment spans practically the whole file.  How much of the segment
-+  // is scanned is the read style's business, applied in readLimited() below.
-   const std::unique_ptr<EBML::MkSegment> segment(
-     EBML::element_cast<EBML::Element::Id::MkSegment>(
--      EBML::findElement(*this, EBML::Element::Id::MkSegment, maxOffset)
-+      EBML::findElement(*this, EBML::Element::Id::MkSegment, fileLength)
-     )
-   );
-   if(!segment) {
-@@ -400,7 +398,7 @@
- 
-   // Read the segment into memory from file
-   d->segment = segment->parseSegment();
--  maxOffset = segment->getDataSize();
-+  offset_t maxOffset = segment->getDataSize();
-   if (readStyle == Properties::ReadStyle::Fast && maxOffset > FAST_SCAN_LIMIT) {
-     maxOffset = FAST_SCAN_LIMIT;
-   }
diff --git a/tools/depends/target/taglib/Makefile b/tools/depends/target/taglib/Makefile
index 49ce622..b9cca59 100644
--- a/tools/depends/target/taglib/Makefile
+++ b/tools/depends/target/taglib/Makefile
@@ -1,7 +1,6 @@
 include ../../Makefile.include TAGLIB-VERSION ../../download-files.include
 DEPS = ../../Makefile.include Makefile TAGLIB-VERSION ../../download-files.include \
-                                       001-cmake-pdb-debug.patch \
-                                       002-matroska-fast-scan-segment-lookup.patch
+                                       001-cmake-pdb-debug.patch
 
 LIBDYLIB=$(PLATFORM)/build/$(LIBNAME)/$(BYPRODUCT)
 all: .installed-$(PLATFORM)
@@ -11,7 +10,6 @@ all: .installed-$(PLATFORM)
 	cd $(PLATFORM); $(ARCHIVE_TOOL) $(ARCHIVE_TOOL_FLAGS) $(TARBALLS_LOCATION)/$(ARCHIVE)
 	cd $(PLATFORM); rm -rf build; mkdir -p build
 	cd $(PLATFORM); patch -p1 -i ../001-cmake-pdb-debug.patch
-	cd $(PLATFORM); patch -p1 -i ../002-matroska-fast-scan-segment-lookup.patch
 	cd $(PLATFORM)/build; $(CMAKE) -DBUILD_SHARED_LIBS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF -DBUILD_BINDINGS=OFF -DCMAKE_BUILD_TYPE=Debug ..
 	touch $@
 
