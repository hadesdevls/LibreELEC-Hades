+#pragma once
+
+// What FFmpeg's Matroska demuxer exports of the editions of a file (the "editions" option of
+// ffmpeg-9940) and the duration it gives, read from the bytes of the file in ranges: for a file
+// over HTTP (MatroskaHttpRange.h), where every range is a request and a transfer. Read: the EBML
+// header and the start of the Segment (FIRST_BYTES), then only the elements that the SeekHead
+// points to and that are needed: the Chapters and the Info where they are not at the start, a
+// SeekHead that the first one points to while one of those is still missing, and Tags only where
+// an edition is named by a tag. MAX_BYTES at most in all.
+//
+// Element for element as matroskadec.c reads them: an unsigned integer or a float without bytes is
+// its default (ebml_read_uint(), ebml_read_float()); the integers and floats of a master element
+// start from their defaults at each occurrence of it (ebml_parse_nest()), and of an element that is
+// not a list the last one is kept; a string ends at its first NUL; of the level-1 elements the
+// first Info and the first Chapters are read, the ones before the first Cluster first and then
+// those that the SeekHead points to, in its order (an entry for one of them that comes after it is
+// not followed), and every Tags; a nested ChapterAtom is not read; the EBML header is refused as
+// matroska_read_header() refuses it. MKV_EDITIONS::Parse() of what this exports gives the File that
+// the player's demuxer gives (host test: the same keys and values as mkvdump of the same file).
+//
+// Where the two could differ, this reads nothing more and the file plays as it is stored, or the
+// editions are offered without a name: a Chapters or Info element that the demuxer finds by
+// reading on from the start beyond FIRST_BYTES and that the SeekHead does not point to (not
+// found); an entry of the SeekHead that points to another element than it says (not followed); a
+// file malformed where the demuxer would carry on (not read); Tags that do not fit in what is left
+// (tagsSkipped).
+//
+// Pure: no Kodi, curl or FFmpeg, so that a host test can run it.
+
+#include "MatroskaEditions.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace MKV_EDITIONS::HEADER
+{
+
+//! The first range: the EBML header and the start of the Segment
+constexpr int64_t FIRST_BYTES = 64 * 1024;
+//! The range for an element whose size is not known yet (its header comes with it)
+constexpr int64_t ELEMENT_BYTES = 16 * 1024;
+//! All the bytes read of one file, at most
+constexpr int64_t MAX_BYTES = 1024 * 1024;
+
+class ByteSource
+{
+public:
+  virtual ~ByteSource() = default;
+  //! Exactly the bytes [offset, offset + length) of the file, in out. False: they could not be had,
+  //! and nothing more is asked.
+  virtual bool Fetch(int64_t offset, int64_t length, std::string& out) = 0;
+};
+
+enum class Outcome
+{
+  READ, //!< exported is what the demuxer exports (empty: the file has no editions)
+  NOT_MATROSKA, //!< no EBML header and Segment, or a header that matroska_read_header() refuses
+  MALFORMED, //!< an element that is needed is not well formed
+  TOO_LARGE, //!< an element that is needed does not fit in what may be read
+  FETCH_FAILED, //!< the source could not give a range (it says why)
+};
+
+struct Result
+{
+  Outcome outcome = Outcome::MALFORMED;
+  //! the keys and values of the "editions" option of ffmpeg-9940 ("count", "0.uid", "0.0.start"...)
+  std::map<std::string, std::string> exported;
+  //! as ReadEditions() takes it from the demuxer (AVFormatContext::duration / 1000): 0 without one
+  int64_t durationMs = 0;
+  int64_t bytes = 0; //!< asked of the source
+  bool tagsSkipped = false; //!< Tags that could name an edition did not fit in what was left
+  std::string why; //!< for a log line, when not READ
+};
+
+namespace DETAIL
+{
+//! RFC 9559 element IDs, with their length marker, as matroskadec.c compares them
+enum : uint32_t
+{
+  ID_EBML = 0x1A45DFA3,
+  ID_EBMLREADVERSION = 0x42F7,
+  ID_EBMLMAXIDLENGTH = 0x42F2,
+  ID_EBMLMAXSIZELENGTH = 0x42F3,
+  ID_DOCTYPEREADVERSION = 0x4285,
+  ID_SEGMENT = 0x18538067,
+  ID_SEEKHEAD = 0x114D9B74,
+  ID_SEEK = 0x4DBB,
+  ID_SEEKID = 0x53AB,
+  ID_SEEKPOSITION = 0x53AC,
+  ID_INFO = 0x1549A966,
+  ID_TIMESTAMPSCALE = 0x2AD7B1,
+  ID_DURATION = 0x4489,
+  ID_SEGMENTUUID = 0x73A4,
+  ID_CLUSTER = 0x1F43B675,
+  ID_CHAPTERS = 0x1043A770,
+  ID_EDITIONENTRY = 0x45B9,
+  ID_EDITIONUID = 0x45BC,
+  ID_EDITIONFLAGHIDDEN = 0x45BD,
+  ID_EDITIONFLAGDEFAULT = 0x45DB,
+  ID_EDITIONFLAGORDERED = 0x45DD,
+  ID_EDITIONDISPLAY = 0x4520,
+  ID_EDITIONSTRING = 0x4521,
+  ID_CHAPTERATOM = 0xB6,
+  ID_CHAPTERUID = 0x73C4,
+  ID_CHAPTERTIMESTART = 0x91,
+  ID_CHAPTERTIMEEND = 0x92,
+  ID_CHAPTERFLAGHIDDEN = 0x98,
+  ID_CHAPTERFLAGENABLED = 0x4598,
+  ID_CHAPTERSEGMENTUUID = 0x6E67,
+  ID_CHAPTERDISPLAY = 0x80,
+  ID_CHAPSTRING = 0x85,
+  ID_TAGS = 0x1254C367,
+  ID_TAG = 0x7373,
+  ID_TARGETS = 0x63C0,
+  ID_TAGEDITIONUID = 0x63C9,
+  ID_SIMPLETAG = 0x67C8,
+  ID_TAGNAME = 0x45A3,
+  ID_TAGSTRING = 0x4487,
+};
+
+//! AV_NOPTS_VALUE as matroskadec.c keeps a chapter time without a value, in a uint64_t
+constexpr uint64_t NO_TIME = 0x8000000000000000ULL;
+
+struct Header
+{
+  uint32_t id = 0;
+  uint64_t size = 0;
+  bool unknownSize = false;
+  int length = 0; //!< of the ID and the size together
+};
+
+//! The ID (1 to 4 bytes, marker kept) and the size (1 to 8 bytes) of an element at p, from avail
+//! bytes; false: not a whole header there
+inline bool ElementHeader(const uint8_t* p, size_t avail, Header& h)
+{
+  if (avail < 2 || !p[0])
+    return false;
+  int idLength = 1;
+  while (idLength <= 4 && !(p[0] & (0x80 >> (idLength - 1))))
+    idLength++;
+  if (idLength > 4 || static_cast<size_t>(idLength) >= avail)
+    return false;
+  h.id = 0;
+  for (int i = 0; i < idLength; i++)
+    h.id = (h.id << 8) | p[i];
+  const uint8_t* s = p + idLength;
+  if (!s[0])
+    return false;
+  int sizeLength = 1;
+  while (!(s[0] & (0x80 >> (sizeLength - 1))))
+    sizeLength++;
+  if (static_cast<size_t>(idLength + sizeLength) > avail)
+    return false;
+  const unsigned marker = 0x80u >> (sizeLength - 1);
+  uint64_t v = s[0] & (marker - 1);
+  bool allOnes = v == marker - 1;
+  for (int i = 1; i < sizeLength; i++)
+  {
+    v = (v << 8) | s[i];
+    allOnes = allOnes && s[i] == 0xFF;
+  }
+  h.size = v;
+  h.unknownSize = allOnes;
+  h.length = idLength + sizeLength;
+  return true;
+}
+
+//! Every child of a master element whose data is data, in order: onChild(id, its data); false: a
+//! child that is not well formed, or does not fit in its parent (as ebml_parse_elem() refuses it)
+template<typename F>
+bool Children(std::string_view data, F&& onChild)
+{
+  size_t at = 0;
+  while (at < data.size())
+  {
+    Header h;
+    if (!ElementHeader(reinterpret_cast<const uint8_t*>(data.data()) + at, data.size() - at, h) ||
+        h.unknownSize || h.size > data.size() - at - static_cast<size_t>(h.length))
+      return false;
+    if (!onChild(h.id, data.substr(at + h.length, static_cast<size_t>(h.size))))
+      return false;
+    at += h.length + static_cast<size_t>(h.size);
+  }
+  return true;
+}
+
+//! ebml_read_uint(): no bytes, the default; more than 8, not well formed
+inline bool Uint(std::string_view v, uint64_t def, uint64_t& out)
+{
+  if (v.empty())
+  {
+    out = def;
+    return true;
+  }
+  if (v.size() > 8)
+    return false;
+  out = 0;
+  for (const char c : v)
+    out = (out << 8) | static_cast<unsigned char>(c);
+  return true;
+}
+
+//! ebml_read_float(): no bytes, the default; 4 or 8 bytes; otherwise not well formed
+inline bool Float(std::string_view v, double def, double& out)
+{
+  if (v.empty())
+  {
+    out = def;
+    return true;
+  }
+  if (v.size() != 4 && v.size() != 8)
+    return false;
+  uint64_t bits = 0;
+  for (const char c : v)
+    bits = (bits << 8) | static_cast<unsigned char>(c);
+  if (v.size() == 4)
+  {
+    const uint32_t b = static_cast<uint32_t>(bits);
+    float f;
+    std::memcpy(&f, &b, sizeof(f));
+    out = f;
+  }
+  else
+    std::memcpy(&out, &bits, sizeof(out));
+  return true;
+}
+
+//! ebml_read_ascii() keeps the bytes and a NUL after them: as a C string, up to the first NUL
+inline std::string Str(std::string_view v)
+{
+  return std::string(v.substr(0, v.find('\0')));
+}
+
+//! set_hex() of ffmpeg-9940: lowercase, for 1 to 64 bytes
+inline std::optional<std::string> Hex(std::string_view v)
+{
+  if (v.empty() || v.size() > 64)
+    return std::nullopt;
+  static constexpr char digits[] = "0123456789abcdef";
+  std::string s;
+  for (const char c : v)
+  {
+    s += digits[static_cast<unsigned char>(c) >> 4];
+    s += digits[static_cast<unsigned char>(c) & 15];
+  }
+  return s;
+}
+
+//! av_strcasecmp(), ASCII
+inline bool SameNoCase(std::string_view a, std::string_view b)
+{
+  return a.size() == b.size() &&
+         std::equal(a.begin(), a.end(), b.begin(),
+                    [](char x, char y)
+                    {
+                      const auto lower = [](char c)
+                      { return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c; };
+                      return lower(x) == lower(y);
+                    });
+}
+
+struct ChapterRead
+{
+  uint64_t start = NO_TIME;
+  uint64_t end = NO_TIME;
+  uint64_t uid = 0;
+  uint64_t hidden = 0;
+  uint64_t enabled = 1;
+  std::string segmentUid; // as stored: set_hex() exports 1 to 64 bytes
+  std::optional<std::string> title;
+};
+
+struct EditionRead
+{
+  uint64_t uid = 0;
+  uint64_t hidden = 0;
+  uint64_t isDefault = 0;
+  uint64_t ordered = 0;
+  std::optional<std::string> title; // EditionString: present, even empty, it is the name
+  std::vector<ChapterRead> chapters;
+};
+
+//! matroska_chapter_entry of ffmpeg-9940 (a nested ChapterAtom is not read)
+inline bool ParseChapter(std::string_view data, ChapterRead& ch)
+{
+  return Children(data,
+                  [&ch](uint32_t id, std::string_view v)
+                  {
+                    switch (id)
+                    {
+                      case ID_CHAPTERTIMESTART:
+                        return Uint(v, NO_TIME, ch.start);
+                      case ID_CHAPTERTIMEEND:
+                        return Uint(v, NO_TIME, ch.end);
+                      case ID_CHAPTERUID:
+                        return Uint(v, 0, ch.uid);
+                      case ID_CHAPTERFLAGHIDDEN:
+                        return Uint(v, 0, ch.hidden);
+                      case ID_CHAPTERFLAGENABLED:
+                        return Uint(v, 1, ch.enabled);
+                      case ID_CHAPTERSEGMENTUUID:
+                        ch.segmentUid = std::string(v);
+                        return true;
+                      case ID_CHAPTERDISPLAY:
+                        return Children(v,
+                                        [&ch](uint32_t did, std::string_view dv)
+                                        {
+                                          if (did == ID_CHAPSTRING)
+                                            ch.title = Str(dv);
+                                          return true;
+                                        });
+                      default:
+                        return true;
+                    }
+                  });
+}
+
+//! matroska_chapters and matroska_chapter of ffmpeg-9940
+inline bool ParseChapters(std::string_view data, std::vector<EditionRead>& editions)
+{
+  return Children(data,
+                  [&editions](uint32_t id, std::string_view v)
+                  {
+                    if (id != ID_EDITIONENTRY)
+                      return true;
+                    EditionRead ed;
+                    const bool ok =
+                        Children(v,
+                                 [&ed](uint32_t eid, std::string_view ev)
+                                 {
+                                   switch (eid)
+                                   {
+                                     case ID_EDITIONUID:
+                                       return Uint(ev, 0, ed.uid);
+                                     case ID_EDITIONFLAGHIDDEN:
+                                       return Uint(ev, 0, ed.hidden);
+                                     case ID_EDITIONFLAGDEFAULT:
+                                       return Uint(ev, 0, ed.isDefault);
+                                     case ID_EDITIONFLAGORDERED:
+                                       return Uint(ev, 0, ed.ordered);
+                                     case ID_EDITIONDISPLAY:
+                                       return Children(ev,
+                                                       [&ed](uint32_t did, std::string_view dv)
+                                                       {
+                                                         if (did == ID_EDITIONSTRING)
+                                                           ed.title = Str(dv);
+                                                         return true;
+                                                       });
+                                     case ID_CHAPTERATOM:
+                                     {
+                                       ChapterRead ch;
+                                       if (!ParseChapter(ev, ch))
+                                         return false;
+                                       ed.chapters.push_back(std::move(ch));
+                                       return true;
+                                     }
+                                     default:
+                                       return true;
+                                   }
+                                 });
+                    if (!ok)
+                      return false;
+                    editions.push_back(std::move(ed));
+                    return true;
+                  });
+}
+
+//! One Tag as edition_tag_title() of ffmpeg-9940 looks at it: the TagEditionUID of its TagTargets
+//! (which start from their defaults at each TagTargets), and its SimpleTags (TagName, TagString)
+struct TagRead
+{
+  uint64_t editionUid = 0;
+  std::vector<std::pair<std::optional<std::string>, std::optional<std::string>>> simple;
+};
+
+inline bool ParseTags(std::string_view data, std::vector<TagRead>& tags)
+{
+  return Children(data,
+                  [&tags](uint32_t id, std::string_view v)
+                  {
+                    if (id != ID_TAG)
+                      return true;
+                    TagRead tag;
+                    const bool ok =
+                        Children(v,
+                                 [&tag](uint32_t tid, std::string_view tv)
+                                 {
+                                   if (tid == ID_TARGETS)
+                                   {
+                                     tag.editionUid = 0;
+                                     return Children(tv,
+                                                     [&tag](uint32_t gid, std::string_view gv)
+                                                     {
+                                                       if (gid == ID_TAGEDITIONUID)
+                                                         return Uint(gv, 0, tag.editionUid);
+                                                       return true;
+                                                     });
+                                   }
+                                   if (tid != ID_SIMPLETAG)
+                                     return true;
+                                   std::optional<std::string> name;
+                                   std::optional<std::string> string;
+                                   const bool simpleOk =
+                                       Children(tv,
+                                                [&name, &string](uint32_t sid, std::string_view sv)
+                                                {
+                                                  if (sid == ID_TAGNAME)
+                                                    name = Str(sv);
+                                                  else if (sid == ID_TAGSTRING)
+                                                    string = Str(sv);
+                                                  return true;
+                                                });
+                                   tag.simple.emplace_back(std::move(name), std::move(string));
+                                   return simpleOk;
+                                 });
+                    if (!ok)
+                      return false;
+                    tags.push_back(std::move(tag));
+                    return true;
+                  });
+}
+
+class Reader
+{
+public:
+  Reader(ByteSource& source, int64_t fileSize, int64_t maxBytes)
+    : m_source(source),
+      m_size(fileSize),
+      m_max(maxBytes)
+  {
+  }
+
+  Result Run();
+
+private:
+  enum class Got
+  {
+    OK,
+    NONE, //!< not in the file
+    BUDGET, //!< it does not fit in what is left to read
+    FAILED, //!< the source failed
+    BAD, //!< not a well formed element
+  };
+
+  struct Piece
+  {
+    int64_t offset;
+    std::string data;
+    int64_t End() const { return offset + static_cast<int64_t>(data.size()); }
+  };
+
+  //! the piece that holds offset and goes furthest after it, or -1
+  int PieceAt(int64_t offset) const
+  {
+    int best = -1;
+    for (size_t i = 0; i < m_pieces.size(); i++)
+      if (offset >= m_pieces[i].offset && offset < m_pieces[i].End() &&
+          (best < 0 || m_pieces[i].End() > m_pieces[static_cast<size_t>(best)].End()))
+        best = static_cast<int>(i);
+    return best;
+  }
+
+  //! [offset, offset + length) from the source, within what is left to read
+  Got Fetch(int64_t offset, int64_t length, std::string& bytes)
+  {
+    if (m_bytes + length > m_max)
+      return Got::BUDGET;
+    if (!m_source.Fetch(offset, length, bytes) || static_cast<int64_t>(bytes.size()) != length)
+      return Got::FAILED;
+    m_bytes += length;
+    return Got::OK;
+  }
+
+  Got NewPiece(int64_t offset, int64_t length, int& index)
+  {
+    std::string bytes;
+    const Got g = Fetch(offset, length, bytes);
+    if (g == Got::OK)
+    {
+      m_pieces.push_back({offset, std::move(bytes)});
+      index = static_cast<int>(m_pieces.size()) - 1;
+    }
+    return g;
+  }
+
+  //! piece index read on up to the byte to
+  Got Extend(int index, int64_t to)
+  {
+    Piece& p = m_pieces[static_cast<size_t>(index)];
+    std::string bytes;
+    const Got g = Fetch(p.End(), to - p.End(), bytes);
+    if (g == Got::OK)
+      p.data += bytes;
+    return g;
+  }
+
+  //! The header of the element at pos, from what was read or a new range of ELEMENT_BYTES (to the
+  //! end of the file, within what is left); with data, its data too (the rest of it read if needed)
+  Got Element(int64_t pos, Header& h, std::string* data)
+  {
+    if (pos < 0 || pos >= m_size)
+      return Got::NONE;
+    const int64_t headerMax = std::min<int64_t>(12, m_size - pos);
+    int i = PieceAt(pos);
+    const auto header = [this, pos, &h](int k)
+    {
+      const Piece& p = m_pieces[static_cast<size_t>(k)];
+      return ElementHeader(reinterpret_cast<const uint8_t*>(p.data.data()) + (pos - p.offset),
+                           static_cast<size_t>(p.End() - pos), h);
+    };
+    if (i < 0 || (m_pieces[static_cast<size_t>(i)].End() - pos < headerMax && !header(i)))
+    {
+      const int64_t from = i < 0 ? pos : m_pieces[static_cast<size_t>(i)].End();
+      const int64_t to =
+          std::min({m_size, std::max(pos + ELEMENT_BYTES, from), from + (m_max - m_bytes)});
+      if (to < pos + headerMax)
+        return Got::BUDGET;
+      const Got g = i < 0 ? NewPiece(from, to - from, i) : Extend(i, to);
+      if (g != Got::OK)
+        return g;
+    }
+    if (!header(i))
+      return Got::BAD;
+    if (!data)
+      return Got::OK;
+    if (h.unknownSize || h.size > static_cast<uint64_t>(m_size - pos - h.length))
+      return Got::BAD;
+    const int64_t end = pos + h.length + static_cast<int64_t>(h.size);
+    if (m_pieces[static_cast<size_t>(i)].End() < end)
+      if (const Got g = Extend(i, end); g != Got::OK)
+        return g;
+    const Piece& p = m_pieces[static_cast<size_t>(i)];
+    *data =
+        p.data.substr(static_cast<size_t>(pos + h.length - p.offset), static_cast<size_t>(h.size));
+    return Got::OK;
+  }
+
+  //! the entries of the SeekHead at pos (matroska_seekhead_entry: SeekID, SeekPosition with -1 as
+  //! its default), appended
+  Got SeekHead(int64_t pos)
+  {
+    m_seekHeadsRead.push_back(pos);
+    Header h;
+    std::string data;
+    const Got g = Element(pos, h, &data);
+    if (g != Got::OK)
+      return g == Got::NONE ? Got::OK : g;
+    if (h.id != ID_SEEKHEAD)
+      return Got::OK;
+    std::vector<std::pair<uint64_t, uint64_t>> entries;
+    if (!Children(data,
+                  [&entries](uint32_t id, std::string_view v)
+                  {
+                    if (id != ID_SEEK)
+                      return true;
+                    uint64_t sid = 0;
+                    uint64_t spos = ~uint64_t{0};
+                    const bool ok = Children(v,
+                                             [&sid, &spos](uint32_t eid, std::string_view ev)
+                                             {
+                                               if (eid == ID_SEEKID)
+                                                 return Uint(ev, 0, sid);
+                                               if (eid == ID_SEEKPOSITION)
+                                                 return Uint(ev, ~uint64_t{0}, spos);
+                                               return true;
+                                             });
+                    entries.emplace_back(sid, spos);
+                    return ok;
+                  }))
+      return Got::BAD;
+    m_entries.insert(m_entries.end(), entries.begin(), entries.end());
+    return Got::OK;
+  }
+
+  //! the entries from m_next on, as matroska_execute_seekhead() walks them (CUES and the others are
+  //! not read here): a SeekHead it points to is kept for later
+  void Walk()
+  {
+    for (; m_next < m_entries.size(); m_next++)
+    {
+      const auto [id, rel] = m_entries[m_next];
+      if (id > 0xFFFFFFFFu)
+        continue;
+      const int64_t pos = static_cast<int64_t>(static_cast<uint64_t>(m_segment) + rel);
+      if (pos < m_segment)
+        continue;
+      switch (id)
+      {
+        case ID_INFO:
+          if (!m_infoTaken)
+          {
+            m_infoTaken = true;
+            m_info = pos;
+          }
+          break;
+        case ID_CHAPTERS:
+          if (!m_chaptersTaken)
+          {
+            m_chaptersTaken = true;
+            m_chapters = pos;
+          }
+          break;
+        case ID_TAGS:
+          if (std::find(m_tags.begin(), m_tags.end(), pos) == m_tags.end())
+            m_tags.push_back(pos);
+          break;
+        case ID_SEEKHEAD:
+          if (std::find(m_seekHeadsRead.begin(), m_seekHeadsRead.end(), pos) ==
+                  m_seekHeadsRead.end() &&
+              std::find(m_seekHeadsLater.begin(), m_seekHeadsLater.end(), pos) ==
+                  m_seekHeadsLater.end())
+            m_seekHeadsLater.push_back(pos);
+          break;
+        default:
+          break;
+      }
+    }
+  }
+
+  ByteSource& m_source;
+  const int64_t m_size;
+  const int64_t m_max;
+  int64_t m_bytes = 0;
+  std::vector<Piece> m_pieces;
+  int64_t m_segment = 0;
+  std::vector<std::pair<uint64_t, uint64_t>> m_entries;
+  size_t m_next = 0;
+  std::vector<int64_t> m_seekHeadsRead;
+  std::vector<int64_t> m_seekHeadsLater;
+  bool m_infoTaken = false;
+  bool m_chaptersTaken = false;
+  std::optional<int64_t> m_info;
+  std::optional<int64_t> m_chapters;
+  std::vector<int64_t> m_tags;
+};
+
+inline Result Reader::Run()
+{
+  Result r;
+  const auto fail = [this, &r](Outcome o, std::string why)
+  {
+    r.outcome = o;
+    r.why = std::move(why);
+    r.exported.clear();
+    r.bytes = m_bytes;
+    return r;
+  };
+  const auto failed = [this, &fail](Got g, const char* what) -> Result
+  {
+    switch (g)
+    {
+      case Got::BUDGET:
+        return fail(Outcome::TOO_LARGE, std::string(what) + " does not fit in the " +
+                                            std::to_string(m_max) +
+                                            " bytes that are read before playback");
+      case Got::FAILED:
+        return fail(Outcome::FETCH_FAILED, std::string(what) + " could not be read");
+      default:
+        return fail(Outcome::MALFORMED, std::string(what) + " is not well formed");
+    }
+  };
+  if (m_size <= 0)
+    return fail(Outcome::NOT_MATROSKA, "the file is empty");
+  int first = -1;
+  if (const Got g = NewPiece(0, std::min({FIRST_BYTES, m_size, m_max}), first); g != Got::OK)
+    return failed(g, "the start of the file");
+
+  // the EBML header, as matroska_read_header() takes it
+  Header h;
+  std::string data;
+  if (const Got g = Element(0, h, &data); g != Got::OK || h.id != ID_EBML)
+    return g == Got::FAILED ? failed(g, "the EBML header")
+                            : fail(Outcome::NOT_MATROSKA, "no EBML header");
+  uint64_t readVersion = 1;
+  uint64_t maxIdLength = 4;
+  uint64_t maxSizeLength = 8;
+  uint64_t docTypeReadVersion = 1;
+  if (!Children(data,
+                [&](uint32_t id, std::string_view v)
+                {
+                  switch (id)
+                  {
+                    case ID_EBMLREADVERSION:
+                      return Uint(v, 1, readVersion);
+                    case ID_EBMLMAXIDLENGTH:
+                      return Uint(v, 4, maxIdLength);
+                    case ID_EBMLMAXSIZELENGTH:
+                      return Uint(v, 8, maxSizeLength);
+                    case ID_DOCTYPEREADVERSION:
+                      return Uint(v, 1, docTypeReadVersion);
+                    default:
+                      return true;
+                  }
+                }))
+    return fail(Outcome::MALFORMED, "the EBML header is not well formed");
+  if (readVersion > 1 || maxSizeLength > 8 || maxIdLength > 4 || docTypeReadVersion > 3)
+    return fail(Outcome::NOT_MATROSKA, "an EBML header that the demuxer does not read");
+
+  // the Segment (an element that is not one, before it, is passed over)
+  int64_t pos = h.length + static_cast<int64_t>(h.size);
+  int64_t segmentEnd = m_size;
+  bool segment = false;
+  for (int k = 0; k < 8 && pos < m_size && !segment; k++)
+  {
+    Header sh;
+    if (const Got g = Element(pos, sh, nullptr); g != Got::OK)
+      return g == Got::FAILED ? failed(g, "the Segment")
+                              : fail(Outcome::NOT_MATROSKA, "no Segment");
+    if (sh.id == ID_SEGMENT)
+    {
+      segment = true;
+      m_segment = pos + sh.length;
+      if (!sh.unknownSize && sh.size < static_cast<uint64_t>(m_size - m_segment))
+        segmentEnd = m_segment + static_cast<int64_t>(sh.size);
+    }
+    else if (sh.unknownSize)
+      break;
+    else
+      pos += sh.length + static_cast<int64_t>(std::min<uint64_t>(sh.size, m_size));
+  }
+  if (!segment)
+    return fail(Outcome::NOT_MATROSKA, "no Segment");
+
+  // the level-1 elements from the start of the Segment, in what the first range holds, up to the
+  // first Cluster: the demuxer reads them in this order before it follows the SeekHead
+  std::vector<int64_t> seekHeads;
+  pos = m_segment;
+  while (pos < segmentEnd)
+  {
+    const Piece& start = m_pieces[static_cast<size_t>(first)]; // at 0
+    Header lh;
+    if (pos >= start.End() ||
+        !ElementHeader(reinterpret_cast<const uint8_t*>(start.data.data()) + pos,
+                       static_cast<size_t>(start.End() - pos), lh) ||
+        lh.id == ID_CLUSTER || lh.unknownSize)
+      break;
+    switch (lh.id)
+    {
+      case ID_INFO:
+        if (!m_infoTaken)
+        {
+          m_infoTaken = true;
+          m_info = pos;
+        }
+        break;
+      case ID_CHAPTERS:
+        if (!m_chaptersTaken)
+        {
+          m_chaptersTaken = true;
+          m_chapters = pos;
+        }
+        break;
+      case ID_TAGS:
+        m_tags.push_back(pos);
+        break;
+      case ID_SEEKHEAD:
+        seekHeads.push_back(pos);
+        break;
+      default:
+        break;
+    }
+    if (lh.size > static_cast<uint64_t>(segmentEnd - pos))
+      break;
+    pos += lh.length + static_cast<int64_t>(lh.size);
+  }
+
+  // the SeekHeads before the first Cluster, then their entries in order; a SeekHead that they point
+  // to is read while the Info or the Chapters are still missing
+  for (const int64_t at : seekHeads)
+    if (const Got g = SeekHead(at); g != Got::OK)
+      return failed(g, "the SeekHead");
+  Walk();
+  while ((!m_infoTaken || !m_chaptersTaken) && !m_seekHeadsLater.empty())
+  {
+    const int64_t at = m_seekHeadsLater.front();
+    m_seekHeadsLater.erase(m_seekHeadsLater.begin());
+    if (const Got g = SeekHead(at); g != Got::OK)
+      return failed(g, "a SeekHead that the SeekHead points to");
+    Walk();
+  }
+
+  // the Info: the duration as the demuxer gives it, and the SegmentUUID
+  uint64_t timeScale = 1000000;
+  double duration = 0;
+  std::optional<std::string> segmentUid;
+  if (m_info)
+  {
+    Header ih;
+    const Got g = Element(*m_info, ih, &data);
+    if (g != Got::OK && g != Got::NONE)
+      return failed(g, "the Info element");
+    if (g == Got::OK && ih.id == ID_INFO &&
+        !Children(data,
+                  [&](uint32_t id, std::string_view v)
+                  {
+                    switch (id)
+                    {
+                      case ID_TIMESTAMPSCALE:
+                        return Uint(v, 1000000, timeScale);
+                      case ID_DURATION:
+                        return Float(v, 0, duration);
+                      case ID_SEGMENTUUID:
+                        segmentUid = std::string(v);
+                        return true;
+                      default:
+                        return true;
+                    }
+                  }))
+      return fail(Outcome::MALFORMED, "the Info element is not well formed");
+  }
+  if (!timeScale)
+    timeScale = 1000000;
+  if (std::isnan(duration))
+    duration = 0;
+  if (duration != 0)
+  {
+    // matroska_read_header(): duration * time_scale * 1000 / AV_TIME_BASE, into an int64_t
+    const double us = duration * static_cast<double>(timeScale) * 1000 / 1000000;
+    if (us > 0 && us < 9223372036854775807.0)
+      r.durationMs = static_cast<int64_t>(us) / 1000;
+  }
+
+  // the Chapters
+  std::vector<EditionRead> editions;
+  if (m_chapters)
+  {
+    Header ch;
+    const Got g = Element(*m_chapters, ch, &data);
+    if (g != Got::OK && g != Got::NONE)
+      return failed(g, "the Chapters element");
+    if (g == Got::OK && ch.id == ID_CHAPTERS && !ParseChapters(data, editions))
+      return fail(Outcome::MALFORMED, "the Chapters element is not well formed");
+  }
+
+  // a name from the Tags, for an edition without an EditionString (edition_tag_title(): the first
+  // TITLE of a Tag that targets it, in the order the demuxer reads the Tags)
+  std::vector<uint64_t> unnamed;
+  for (const EditionRead& ed : editions)
+    if (!ed.title && ed.uid && std::find(unnamed.begin(), unnamed.end(), ed.uid) == unnamed.end())
+      unnamed.push_back(ed.uid);
+  std::map<uint64_t, std::string> tagNames;
+  for (size_t t = 0; tagNames.size() < unnamed.size();)
+  {
+    if (t == m_tags.size())
+    {
+      if (m_seekHeadsLater.empty())
+        break;
+      const int64_t at = m_seekHeadsLater.front();
+      m_seekHeadsLater.erase(m_seekHeadsLater.begin());
+      if (const Got g = SeekHead(at); g != Got::OK)
+      {
+        if (g != Got::BUDGET)
+          return failed(g, "a SeekHead that the SeekHead points to");
+        r.tagsSkipped = true;
+        break;
+      }
+      Walk();
+      continue;
+    }
+    Header th;
+    const Got g = Element(m_tags[t++], th, &data);
+    if (g == Got::BUDGET)
+    {
+      r.tagsSkipped = true;
+      break;
+    }
+    if (g == Got::NONE)
+      continue;
+    if (g != Got::OK)
+      return failed(g, "the Tags element");
+    if (th.id != ID_TAGS)
+      continue;
+    std::vector<TagRead> tags;
+    if (!ParseTags(data, tags))
+      return fail(Outcome::MALFORMED, "the Tags element is not well formed");
+    for (const TagRead& tag : tags)
+    {
+      if (std::find(unnamed.begin(), unnamed.end(), tag.editionUid) == unnamed.end() ||
+          tagNames.contains(tag.editionUid))
+        continue;
+      for (const auto& [name, string] : tag.simple)
+        if (name && string && SameNoCase(*name, "TITLE"))
+        {
+          tagNames.emplace(tag.editionUid, *string);
+          break;
+        }
+    }
+  }
+
+  // what matroska_export_editions() of ffmpeg-9940 exports
+  r.outcome = Outcome::READ;
+  r.bytes = m_bytes;
+  if (editions.empty())
+    return r;
+  auto& out = r.exported;
+  out["count"] = std::to_string(editions.size());
+  if (segmentUid)
+    if (const auto hex = Hex(*segmentUid))
+      out["segment_uid"] = *hex;
+  for (size_t e = 0; e < editions.size(); e++)
+  {
+    const EditionRead& ed = editions[e];
+    const std::string ek = std::to_string(e) + ".";
+    out[ek + "uid"] = std::to_string(ed.uid);
+    out[ek + "default"] = ed.isDefault ? "1" : "0";
+    out[ek + "hidden"] = ed.hidden ? "1" : "0";
+    out[ek + "ordered"] = ed.ordered ? "1" : "0";
+    out[ek + "chapters"] = std::to_string(ed.chapters.size());
+    std::optional<std::string> name = ed.title;
+    if (!name)
+      if (const auto it = tagNames.find(ed.uid); ed.uid && it != tagNames.end())
+        name = it->second;
+    if (name && !name->empty())
+      out[ek + "name"] = *name;
+    for (size_t c = 0; c < ed.chapters.size(); c++)
+    {
+      const ChapterRead& ch = ed.chapters[c];
+      const std::string ck = ek + std::to_string(c) + ".";
+      if (ch.start != NO_TIME)
+        out[ck + "start"] = std::to_string(ch.start);
+      if (ch.end != NO_TIME)
+        out[ck + "end"] = std::to_string(ch.end);
+      out[ck + "uid"] = std::to_string(ch.uid);
+      out[ck + "hidden"] = ch.hidden ? "1" : "0";
+      out[ck + "enabled"] = ch.enabled ? "1" : "0";
+      if (const auto hex = Hex(ch.segmentUid))
+        out[ck + "segment_uid"] = *hex;
+      if (ch.title && !ch.title->empty())
+        out[ck + "title"] = *ch.title;
+    }
+  }
+  return r;
+}
+} // namespace DETAIL
+
+//! What the demuxer exports of the editions of a file of fileSize bytes, and its duration, read
+//! through source: MAX_BYTES at most (maxBytes, for a test)
+inline Result ReadHeader(ByteSource& source, int64_t fileSize, int64_t maxBytes = MAX_BYTES)
+{
+  return DETAIL::Reader(source, fileSize, maxBytes).Run();
+}
+
+//! The File of what ReadHeader() exports, as from the demuxer (MKV_EDITIONS::Parse())
+inline File FromExported(const std::map<std::string, std::string>& exported)
+{
+  return Parse(
+      [&exported](const char* key) -> const char*
+      {
+        const auto it = exported.find(key);
+        return it == exported.end() ? nullptr : it->second.c_str();
+      });
+}
+
+} // namespace MKV_EDITIONS::HEADER
