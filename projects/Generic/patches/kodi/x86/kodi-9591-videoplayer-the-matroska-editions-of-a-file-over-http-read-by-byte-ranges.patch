+    if (!Perform(t))
+      return false;
+    if (!Identity(t.response.contentEncoding))
+      return Fail(Failure::NO_RANGES, "the server sends the file with a content coding");
+    int64_t from = 0;
+    int64_t to = 0;
+    int64_t total = 0;
+    if (t.response.status == 206 && ContentRange(t.response.contentRange, from, to, total) &&
+        from == 0 && total > 0)
+      m_size = total;
+    else if (t.response.status == 200 && AcceptsBytes(t.response.acceptRanges) &&
+             t.response.contentLength > 0)
+      m_size = t.response.contentLength;
+    else
+      return Fail(Failure::NO_RANGES,
+                  "the server does not accept byte ranges (HTTP " +
+                      std::to_string(t.response.status) +
+                      ", no part and no Accept-Ranges): nothing was downloaded");
+    // the place the file is, after redirections, for the ranges (as CCurlFile::Open() keeps it)
+    char* effective = nullptr;
+    if (curl_easy_getinfo(m_easy, CURLINFO_EFFECTIVE_URL, &effective) == CURLE_OK && effective &&
+        *effective)
+      m_url = effective;
+    return true;
+  }
+
+  bool Fetch(int64_t offset, int64_t length, std::string& out) override
+  {
+    out.clear();
+    if (length <= 0 || m_size <= 0 || offset < 0 || offset + length > m_size)
+      return Fail(Failure::NOT_THE_PART, "a range outside the file");
+    Transfer t{this, false, offset, length, &out};
+    if (!Perform(t))
+      return false;
+    if (static_cast<int64_t>(out.size()) != length)
+      return Fail(Failure::NOT_THE_PART, "the server sent " + std::to_string(out.size()) +
+                                             " of the " + std::to_string(length) + " bytes asked");
+    return true;
+  }
+
+  int64_t Size() const { return m_size; }
+  int Requests() const { return m_requests; }
+  int64_t Bytes() const { return m_bytes; } //!< bodies received
+  Failure GetFailure() const { return m_failure; }
+  long Status() const { return m_status; }
+  const std::string& Why() const { return m_why; }
+
+private:
+  struct Response
+  {
+    long status = 0;
+    std::string acceptRanges;
+    std::string contentRange;
+    std::string contentEncoding;
+    int64_t contentLength = -1;
+  };
+
+  struct Transfer
+  {
+    RangeSource* self;
+    bool head;
+    int64_t offset;
+    int64_t length;
+    std::string* out; // nullptr for the HEAD
+    Response response{};
+    bool checked = false;
+    bool refused = false;
+  };
+
+  static std::string_view Trim(std::string_view s)
+  {
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t'))
+      s.remove_prefix(1);
+    while (!s.empty() &&
+           (s.back() == ' ' || s.back() == '\t' || s.back() == '\r' || s.back() == '\n'))
+      s.remove_suffix(1);
+    return s;
+  }
+
+  static bool Identity(const std::string& coding)
+  {
+    return coding.empty() || HEADER::DETAIL::SameNoCase(coding, "identity");
+  }
+
+  static bool AcceptsBytes(std::string_view value)
+  {
+    while (!value.empty())
+    {
+      const size_t comma = value.find(',');
+      if (HEADER::DETAIL::SameNoCase(Trim(value.substr(0, comma)), "bytes"))
+        return true;
+      if (comma == std::string_view::npos)
+        break;
+      value.remove_prefix(comma + 1);
+    }
+    return false;
+  }
+
+  static bool Number(std::string_view s, int64_t& out)
+  {
+    if (s.empty() || s.size() > 18)
+      return false;
+    out = 0;
+    for (const char c : s)
+    {
+      if (c < '0' || c > '9')
+        return false;
+      out = out * 10 + (c - '0');
+    }
+    return true;
+  }
+
+  //! "bytes FROM-TO/TOTAL"
+  static bool ContentRange(std::string_view value, int64_t& from, int64_t& to, int64_t& total)
+  {
+    value = Trim(value);
+    if (value.size() < 6 || !HEADER::DETAIL::SameNoCase(value.substr(0, 5), "bytes"))
+      return false;
+    value = Trim(value.substr(5));
+    const size_t dash = value.find('-');
+    const size_t slash = value.find('/');
+    if (dash == std::string_view::npos || slash == std::string_view::npos || slash < dash)
+      return false;
+    return Number(value.substr(0, dash), from) &&
+           Number(value.substr(dash + 1, slash - dash - 1), to) &&
+           Number(value.substr(slash + 1), total) && from <= to && to < total;
+  }
+
+  bool IsThePart(const Response& r, int64_t offset, int64_t length) const
+  {
+    int64_t from = 0;
+    int64_t to = 0;
+    int64_t total = 0;
+    return r.status == 206 && Identity(r.contentEncoding) &&
+           ContentRange(r.contentRange, from, to, total) && from == offset &&
+           to == offset + length - 1 && total == m_size;
+  }
+
+  static size_t OnHeader(char* buffer, size_t size, size_t count, void* user)
+  {
+    auto* t = static_cast<Transfer*>(user);
+    const size_t n = size * count;
+    const std::string_view line = Trim(std::string_view(buffer, n));
+    if (line.substr(0, 5) == "HTTP/")
+    {
+      // a new response (after a redirection, or the 206 after nothing): its own headers only
+      t->response = Response{};
+      const size_t space = line.find(' ');
+      int64_t status = 0;
+      if (space != std::string_view::npos && Number(line.substr(space + 1, 3), status))
+        t->response.status = static_cast<long>(status);
+      return n;
+    }
+    const size_t colon = line.find(':');
+    if (colon == std::string_view::npos)
+      return n;
+    const std::string_view name = Trim(line.substr(0, colon));
+    const std::string_view value = Trim(line.substr(colon + 1));
+    if (HEADER::DETAIL::SameNoCase(name, "accept-ranges"))
+      t->response.acceptRanges = std::string(value);
+    else if (HEADER::DETAIL::SameNoCase(name, "content-range"))
+      t->response.contentRange = std::string(value);
+    else if (HEADER::DETAIL::SameNoCase(name, "content-encoding"))
+      t->response.contentEncoding = std::string(value);
+    else if (HEADER::DETAIL::SameNoCase(name, "content-length"))
+    {
+      int64_t length = 0;
+      if (Number(value, length))
+        t->response.contentLength = length;
+    }
+    return n;
+  }
+
+  static size_t Ignore(char*, size_t size, size_t count, void*) { return size * count; }
+
+  static size_t OnBody(char* buffer, size_t size, size_t count, void* user)
+  {
+    auto* t = static_cast<Transfer*>(user);
+    const size_t n = size * count;
+    if (!t->out)
+    {
+      t->refused = true;
+      return 0;
+    }
+    if (!t->checked)
+    {
+      t->checked = true;
+      if (!t->self->IsThePart(t->response, t->offset, t->length))
+      {
+        t->refused = true;
+        return 0;
+      }
+    }
+    if (static_cast<int64_t>(t->out->size() + n) > t->length)
+    {
+      t->refused = true;
+      return 0;
+    }
+    t->out->append(buffer, n);
+    t->self->m_bytes += static_cast<int64_t>(n);
+    return n;
+  }
+
+  bool Fail(Failure f, std::string why)
+  {
+    if (m_failure == Failure::NONE)
+    {
+      m_failure = f;
+      m_why = std::move(why);
+    }
+    return false;
+  }
+
+  //! One request, never repeated
+  bool Perform(Transfer& t)
+  {
+    if (m_failure != Failure::NONE)
+      return false;
+    if (m_stop && m_stop())
+      return Fail(Failure::STOPPED, "stopped");
+    const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(
+                          m_deadline - std::chrono::steady_clock::now())
+                          .count();
+    if (left <= 0)
+      return Fail(Failure::LATE, "not within the deadline");
+    const std::string range =
+        std::to_string(t.offset) + "-" + std::to_string(t.offset + t.length - 1);
+    curl_easy_setopt(m_easy, CURLOPT_URL, m_url.c_str());
+    if (t.head)
+      curl_easy_setopt(m_easy, CURLOPT_NOBODY, 1L);
+    else
+      curl_easy_setopt(m_easy, CURLOPT_HTTPGET, 1L);
+    curl_easy_setopt(m_easy, CURLOPT_RANGE, range.c_str());
+    curl_easy_setopt(m_easy, CURLOPT_ACCEPT_ENCODING, "identity");
+    curl_easy_setopt(m_easy, CURLOPT_FAILONERROR, 1L);
+    curl_easy_setopt(m_easy, CURLOPT_HEADERFUNCTION, &RangeSource::OnHeader);
+    curl_easy_setopt(m_easy, CURLOPT_HEADERDATA, &t);
+    curl_easy_setopt(m_easy, CURLOPT_WRITEFUNCTION, &RangeSource::OnBody);
+    curl_easy_setopt(m_easy, CURLOPT_WRITEDATA, &t);
+    curl_easy_setopt(m_easy, CURLOPT_NOPROGRESS, 1L);
+    curl_easy_setopt(m_easy, CURLOPT_TIMEOUT_MS, static_cast<long>(left));
+#if LIBCURL_VERSION_NUM >= 0x075700
+    // a transfer stopped while a name is still being resolved does not wait for the resolver
+    curl_easy_setopt(m_easy, CURLOPT_QUICK_EXIT, 1L);
+#endif
+    m_requests++;
+    if (curl_multi_add_handle(m_multi, m_easy) != CURLM_OK)
+      return Fail(Failure::NETWORK, "curl could not start the request");
+    CURLcode result = CURLE_OK;
+    bool done = false;
+    bool stopped = false;
+    bool late = false;
+    while (true)
+    {
+      int running = 0;
+      const CURLMcode code = curl_multi_perform(m_multi, &running);
+      int queued = 0;
+      while (CURLMsg* message = curl_multi_info_read(m_multi, &queued))
+        if (message->msg == CURLMSG_DONE && message->easy_handle == m_easy)
+        {
+          result = message->data.result;
+          done = true;
+        }
+      if (done || code != CURLM_OK || running == 0)
+        break;
+      if (m_stop && m_stop())
+      {
+        stopped = true;
+        break;
+      }
+      if (std::chrono::steady_clock::now() >= m_deadline)
+      {
+        late = true;
+        break;
+      }
+      curl_multi_poll(m_multi, nullptr, 0, 100, nullptr);
+    }
+    curl_multi_remove_handle(m_multi, m_easy);
+    // t goes away with this call: nothing of it is left in the handle
+    curl_easy_setopt(m_easy, CURLOPT_HEADERFUNCTION, &RangeSource::Ignore);
+    curl_easy_setopt(m_easy, CURLOPT_HEADERDATA, nullptr);
+    curl_easy_setopt(m_easy, CURLOPT_WRITEFUNCTION, &RangeSource::Ignore);
+    curl_easy_setopt(m_easy, CURLOPT_WRITEDATA, nullptr);
+    long status = 0;
+    curl_easy_getinfo(m_easy, CURLINFO_RESPONSE_CODE, &status);
+    m_status = status;
+    if (stopped)
+      return Fail(Failure::STOPPED, "stopped");
+    if (late)
+      return Fail(Failure::LATE, "not within the deadline");
+    if (!done)
+      return Fail(Failure::NETWORK, "curl ended the request without a result");
+    if (t.refused)
+      return Fail(Failure::NOT_THE_PART, "the server answered HTTP " + std::to_string(status) +
+                                             " without the range asked: refused at its first byte");
+    if (result == CURLE_OK)
+      return true;
+    if (result == CURLE_HTTP_RETURNED_ERROR)
+      return Fail(Failure::HTTP_ERROR,
+                  "the server answered HTTP " + std::to_string(status) + ": not asked again");
+    if (result == CURLE_OPERATION_TIMEDOUT)
+      return Fail(Failure::LATE, "not within the deadline");
+    return Fail(Failure::NETWORK,
+                std::string("network: ") + curl_easy_strerror(result) + ": not tried again");
+  }
+
+  CURL_HANDLE* m_easy;
+  CURLM* m_multi;
+  std::string m_url;
+  std::function<bool()> m_stop;
+  std::chrono::steady_clock::time_point m_deadline;
+  int64_t m_size = 0;
+  int m_requests = 0;
+  int64_t m_bytes = 0;
+  long m_status = 0;
+  Failure m_failure = Failure::NONE;
+  std::string m_why;
+};
+
+struct Read
+{
+  HEADER::Result header; //!< what was read, when failure is NONE
+  Failure failure = Failure::NONE;
+  std::string why; //!< of the failure
+  int requests = 0;
+  int64_t bytes = 0; //!< bodies received
+  int64_t size = 0; //!< of the file, as the server gave it
+};
+
+//! The editions of the Matroska file at url, read by byte ranges (see above)
+inline Read ReadEditions(CURL_HANDLE* easy,
+                         CURLM* multi,
+                         const std::string& url,
+                         std::function<bool()> stop,
+                         std::chrono::steady_clock::time_point deadline,
+                         int64_t maxBytes = HEADER::MAX_BYTES)
+{
+  RangeSource source(easy, multi, url, std::move(stop), deadline);
+  Read read;
+  if (source.Begin(std::min(HEADER::FIRST_BYTES, maxBytes)))
+  {
+    read.size = source.Size();
+    read.header = HEADER::ReadHeader(source, source.Size(), maxBytes);
+  }
+  read.failure = source.GetFailure();
+  read.why = source.Why();
+  read.requests = source.Requests();
+  read.bytes = source.Bytes();
+  return read;
+}
+
+} // namespace MKV_EDITIONS::HTTP
