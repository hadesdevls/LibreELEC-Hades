+bool CWinSystemGbm::HoldModeChange(RESOLUTION_INFO& res)
+{
+  // As SetFullScreen() does, but the commit: the mode is chosen, and the next commit carries it
+  VideoSeen();
+  const drmModeModeInfo* before = m_DRM->GetSelectedMode();
+  if (!m_DRM->SetMode(res))
+    return false;
+  // The other subsystems are told now, as for any change of mode: VideoPlayer, which goes on
+  // when it is told that the display is back (SendDisplayReset()), decodes the picture whose
+  // output then goes out with the mode.
+  if (!std::exchange(m_displayLostSent, false))
+    OnLostDevice();
+  m_DRM->SetVideoMode(res, nullptr);
+  m_modeHeldFrom = before;
+  const auto delay =
+      std::chrono::milliseconds(CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+                                    "videoscreen.delayrefreshchange") *
+                                100);
+  if (delay > 0ms)
+    m_dispResetTimer.Set(delay);
+  // (VideoPlayer waits the delay after a change of mode that the user set before it goes on: the
+  // output of the video comes that much later)
+  m_modeHold.Start(std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now().time_since_epoch())
+                       .count() +
+                   std::max<int64_t>(delay.count(), 0));
+  CLog::Log(LOGINFO,
+            "The change of mode to {}x{} @ {:.3f} Hz waits for the output of the video that opens "
+            "(at most {} ms), to go out in one commit with it",
+            res.iScreenWidth, res.iScreenHeight, res.fRefreshRate,
+            CModeChangeHold::START_MS + std::max<int64_t>(delay.count(), 0));
+  return true;
+}
+
+bool CWinSystemGbm::EndModeHoldForModeChange()
+{
+  const CModeChangeHold::Kind kind = m_modeHold.Holding();
+  if (!m_modeHold.ModeChange())
+    return false;
+  // The mode of a video that never set up its output is not the one on the screen
+  if (kind == CModeChangeHold::Kind::START && m_modeHeldFrom)
+    m_DRM->ReselectMode(m_modeHeldFrom);
+  m_modeHeldFrom = nullptr;
+  TellModeHoldEnd();
+  return kind == CModeChangeHold::Kind::STOP;
+}
+
+void CWinSystemGbm::TellModeHoldEnd()
+{
+  const auto [kind, end] = m_modeHold.Take();
+  if (kind == CModeChangeHold::Kind::NONE)
+    return;
+  using End = CModeChangeHold::End;
+  const bool start = kind == CModeChangeHold::Kind::START;
+  if (start)
+    m_modeHeldFrom = nullptr;
+  switch (end)
+  {
+    case End::CONFIGURED:
+      CLog::Log(LOGINFO, "The change of mode goes out with the output of the video, in one "
+                         "commit");
