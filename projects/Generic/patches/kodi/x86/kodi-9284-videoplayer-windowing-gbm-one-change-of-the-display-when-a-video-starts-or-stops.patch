+namespace
+{
+// Hades: the change of mode that VideoPlayer makes for a video that opens (DVBRIDGE::OpenedOutput,
+// 0 none), and its resolution
+std::atomic<int> g_modeChangeOutput{0};
+std::atomic<int> g_modeChangeResolution{-1};
+
+int64_t NowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+} // namespace
+
+void DVBRIDGE::ModeChangeForVideo(OpenedOutput output, int resolution)
+{
+  g_modeChangeResolution = resolution;
+  g_modeChangeOutput = static_cast<int>(output);
+}
+
+void DVBRIDGE::ModeChangeForVideoDone()
+{
+  g_modeChangeOutput = 0;
+  g_modeChangeResolution = -1;
+}
+
+bool CWinSystemGbmGLESContext::HoldsModeForVideo(const RESOLUTION_INFO& res)
+{
+  const int output = g_modeChangeOutput;
+  const int told = g_modeChangeResolution;
+  if (output == 0 || told < 0)
+    return false;
+  // The change that VideoPlayer told of, and no other one that came meanwhile
+  const RESOLUTION_INFO& asked =
+      CDisplaySettings::GetInstance().GetResolutionInfo(static_cast<RESOLUTION>(told));
+  if (asked.strId != res.strId || asked.iScreenWidth != res.iScreenWidth ||
+      asked.iScreenHeight != res.iScreenHeight || asked.dwFlags != res.dwFlags)
+    return false;
+  using Video = CModeChangeHold::Video;
+  Video video = output == static_cast<int>(DVBRIDGE::OpenedOutput::NATIVE_DV) ? Video::NATIVE_DV
+                : output == static_cast<int>(DVBRIDGE::OpenedOutput::HDR)     ? Video::HDR
+                                                                               : Video::ORDINARY;
+  // HDR signalling goes out only where Kodi's HDR output sends it (SetHDR()): elsewhere the video
+  // sets up nothing after its mode, which is its only change
+  if (video == Video::HDR && !(IsHDRDisplaySettingEnabled() && IsHDRDisplay()))
+    video = Video::ORDINARY;
+  return CModeChangeHold::StartHolds(video, ModeChangeOf(res));
+}
+
+void CWinSystemGbmGLESContext::HoldEndOfVideo()
+{
+  // (native Dolby Vision that ends waits its own way: EndDVBridgeAfterVideo())
+  if (m_dvState.Captured() || m_modeHold.Holding() != CModeChangeHold::Kind::NONE)
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  // The HDR signalling that the display has: what the driver took with the last commit it
+  // accepted (the values of the properties are kept from those commits)
+  const bool hdrOnScreen =
+      connector && connector->GetPropertyValue("HDR_OUTPUT_METADATA").value_or(0) != 0;
+  RESOLUTION_INFO target;
+  if (!hdrOnScreen || !ModeAfterVideo(target) ||
+      !CModeChangeHold::StopHolds(hdrOnScreen, true, ModeChangeOf(target)))
+    return;
+  m_modeHold.Stop(NowMs());
+  CLog::Log(LOGINFO,
+            "The end of the HDR signalling of the video waits for the change of mode to {}x{} @ "
+            "{:.3f} Hz that follows (at most {} ms), to go out in one commit with it",
+            target.iScreenWidth, target.iScreenHeight, target.fRefreshRate,
+            CModeChangeHold::STOP_MS);
+}
+
+bool CWinSystemGbmGLESContext::ModeHoldCommits()
+{
+  if (m_modeHold.Holding() == CModeChangeHold::Kind::NONE)
+    return true;
+  if (!m_modeHold.Commits(NowMs()))
+    return false;
+  TellModeHoldEnd();
+  return true;
+}
+
+void CWinSystemGbmGLESContext::VideoOutputConfigured()
+{
+  if (m_modeHold.Configured())
+    TellModeHoldEnd();
+}
