+//! Hades: what the output of a video that opens will be (CModeChangeHold::Video)
+enum class OpenedOutput
+{
+  ORDINARY = 1, //!< without HDR signalling
+  HDR = 2, //!< with HDR signalling (HDR10, HLG, Dolby Vision that is not sent natively)
+  NATIVE_DV = 3, //!< native Dolby Vision, where a transport mode can carry it
+};
+//! ... told by VideoPlayer from before the change of mode that it makes for that video to after
+//! it, with the resolution it sets (the window system may hold that change for the commit that
+//! sets up the output of the video, so that the display changes once: CModeChangeHold)
+void ModeChangeForVideo(OpenedOutput output, int resolution);
+void ModeChangeForVideoDone();
+//! ... and what it is, by what the stream says before its decoder is open
+constexpr OpenedOutput OutputOfStream(bool nativeDV, bool hdrType, bool pqOrHlg)
+{
+  return nativeDV ? OpenedOutput::NATIVE_DV
+         : hdrType || pqOrHlg ? OpenedOutput::HDR
+                              : OpenedOutput::ORDINARY;
+}
