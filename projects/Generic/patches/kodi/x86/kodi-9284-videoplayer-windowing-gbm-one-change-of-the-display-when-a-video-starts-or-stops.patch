-bool CWinSystemGbm::DVEndWaitsForMode(const CDVBridgeState& state) const
+CModeChangeHold::Change CWinSystemGbm::ModeChangeOf(const RESOLUTION_INFO& res) const
+{
+  CModeChangeHold::Change change;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  change.atomic = drm != nullptr;
+  change.active = drm && drm->IsActive();
+  // The window and its buffer stay as they are: a mode of their size
+  change.sameWindow = res.iWidth == m_nWidth && res.iHeight == m_nHeight;
+  const CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const int index = res.strId.empty() ? -1 : std::atoi(res.strId.c_str());
+  const drmModeModeInfo* mode = connector && index >= 0 && index < connector->GetModesCount()
+                                    ? connector->GetModeForIndex(index)
+                                    : nullptr;
+  change.mode3D = (res.dwFlags & (D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) != 0 ||
+                  (mode && STEREO::LayoutOf(mode->flags) != STEREO::Layout::NONE);
+  // (what PrepareStereoInfoFrame(), CheckStereoInfoFrame() and CheckStereoOutput() have nothing
+  // to do for, which come with the commit of a mode)
+  change.stereoBusy = IsSplitStereoMode(GetGfxContext().GetStereoMode()) ||
+                      m_stereoInfoFrame.IsValid() || m_stereoLayout != STEREO::Layout::NONE ||
+                      m_stereoRefusedFramePacking || m_stereoRefusedHalfModes ||
+                      m_stereoRefusedInfoFrame;
+  change.captured = NativeDVOutputInUse();
+  change.timingChanges = OtherTiming(res);
+  return change;
+}
+
+bool CWinSystemGbm::DVModeChangeJoins(const CDVBridgeState& state, const RESOLUTION_INFO& res) const
+{
+  // Hades: with every backend. nvidia-drm turns the output off and on otherwise, in the mode of
+  // the video, before the mode that Kodi sets next (two changes of the HDMI link in a row, which
+  // lost a notification of its display engine in the tests of 2026-10-14); amdgpu and i915 make a
+  // full modeset to end the transport, in the mode of the video, and another one for the next mode
+  // (two changes of the display). In the commit of that mode, the display changes once.
+  if (!state.Captured())
+    return false;
+  CModeChangeHold::Change change = ModeChangeOf(res);
+  // (the state of the bridge that the caller has, which is the one captured)
+  change.captured = true;
+  return CModeChangeHold::DVRestoreJoins(change);
+}
