From e40f15f37cba8b5bf03dae160a221a34407a98ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:12:36 +0000
Subject: [PATCH] audio: kodi.log tells what can cut out the sound of a
 passthrough stream

Issue #8: on a laptop (RTX 3070 Laptop GPU), TrueHD and DTS in passthrough
cut out briefly while the charger is in; PCM and E-AC-3 do not. Without debug
logging nothing in kodi.log would show what Kodi did at such a moment. Now,
with their times:

- an underrun that the device played past: snd_pcm_delay() gives a negative
  delay and the sink skipped ahead silently; its return value was not
  looked at. The sink now counts both and tells them, at most one line a
  second, as a warning (the sound cut out, or may have);
- the corrections of the sync of a passthrough stream: such a stream can only
  be put back in sync with pauses (silence) or by leaving packets out, each a
  cut in the sound. The start of a correction, how far the stream was from
  the video, and when it is in sync again with what it took;
- a change of a monitored ALSA control (the ELD, what the display says of
  its audio): which control of which card; and ALSA cards added and removed
  (both were debug only);
- the device change that follows: the output is closed, the outputs are
  listed again and it is opened again, which cuts out the sound of whatever
  plays; it now says so and how long the output was closed.

Underruns in snd_pcm_writei() were already errors in the log; the opening of
the output for passthrough already said the stream type, channels and rate.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 42 ++++++++++++++++++-
 .../Engines/ActiveAE/ActiveAEStream.h         |  6 +++
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp   | 42 ++++++++++++++++++-
 xbmc/cores/AudioEngine/Sinks/AESinkALSA.h     |  8 ++++
 .../Sinks/alsa/ALSADeviceMonitor.cpp          |  5 ++-
 .../Sinks/alsa/ALSAHControlMonitor.cpp        | 11 ++++-
 6 files changed, 109 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index da09d20..0feedc5 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -815,9 +815,14 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           msg->Reply(CActiveAEControlProtocol::ACC);
           return;
         case CActiveAEControlProtocol::DEVICECHANGE:
+        {
           time_t now;
           time(&now);
-          CLog::Log(LOGDEBUG,"CActiveAE - device change event");
+          // Hades: told without debug logging, with how long the output was closed (a cut in the
+          // sound of whatever plays)
+          const auto changeStart = std::chrono::steady_clock::now();
+          CLog::Log(LOGINFO, "CActiveAE - device change event: the output is closed, the outputs "
+                             "are listed again and it is opened again");
           while (!m_extLastDeviceChange.empty() && (now - m_extLastDeviceChange.front() > 0))
           {
             m_extLastDeviceChange.pop();
@@ -837,6 +842,11 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           m_extErrorRetries = 0;
           m_extError = false;
           Configure();
+          CLog::Log(LOGINFO, "CActiveAE - device change event: the output was {} after {} ms",
+                    m_extError ? "not opened again" : "opened again",
+                    std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now() - changeStart)
+                        .count());
           if (!m_extError)
           {
             m_state = AE_TOP_CONFIGURED_PLAY;
@@ -848,6 +858,7 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
             m_extTimeout = 500ms;
           }
           return;
+        }
         case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
           HandleDeviceCountChange(reinterpret_cast<const char*>(msg->data), false);
           return;
@@ -2778,6 +2789,21 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     stream->m_lastSyncError = error;
     CLog::Log(LOGDEBUG, "ActiveAE::SyncStream - average error {:f} above threshold of {:f}", error,
               threshold);
+    // Hades: a passthrough stream can only be put back in sync by pauses (silence) or by leaving
+    // packets out: each one cuts out the sound, which is told without debug logging
+    if (m_mode == MODE_RAW)
+    {
+      stream->m_rawAdjusting = true;
+      stream->m_rawAdjustSince = std::chrono::steady_clock::now();
+      stream->m_rawPauseMs = 0;
+      stream->m_rawDropped = 0;
+      CLog::Log(LOGINFO,
+                "ActiveAE::SyncStream - the passthrough stream ({}) is {:.0f} ms {} the video, "
+                "more than the {:.0f} ms allowed: it is put back with {}, each a cut in the sound",
+                CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error),
+                error > 0 ? "ahead of" : "behind", threshold,
+                error > 0 ? "pauses" : "packets left out");
+    }
   }
   else if (newerror && stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE)
   {
@@ -2848,6 +2874,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 
           stream->m_syncError.Correction(-ret->pkt->pause_burst_ms);
           error -= ret->pkt->pause_burst_ms;
+          stream->m_rawPauseMs += ret->pkt->pause_burst_ms; // (Hades)
         }
         else
         {
@@ -2886,6 +2913,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
           stream->m_syncError.Correction(stream->m_format.m_streamInfo.GetDuration());
           error += stream->m_format.m_streamInfo.GetDuration();
           buf->pkt->nb_samples = 0;
+          stream->m_rawDropped++; // (Hades)
         }
       }
       else
@@ -2904,6 +2932,18 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 
     if (fabs(error) < 30)
     {
+      // Hades: what the correction of a passthrough stream took
+      if (stream->m_rawAdjusting)
+      {
+        stream->m_rawAdjusting = false;
+        CLog::Log(LOGINFO,
+                  "ActiveAE::SyncStream - the passthrough stream is in sync with the video again "
+                  "after {} ms: {:.0f} ms of pauses, {} packets left out",
+                  std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - stream->m_rawAdjustSince)
+                      .count(),
+                  stream->m_rawPauseMs, stream->m_rawDropped);
+      }
       if (stream->m_lastSyncError > threshold * 2)
       {
         stream->m_syncState = CAESyncInfo::AESyncState::SYNC_MUTE;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index e0771bc..17595b5 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -258,6 +258,12 @@ protected:
   CAESyncInfo::AESyncState m_syncState;
   // Whether late audio was left to the player's clock and no error was averaged since
   bool m_lateStartHandedOver{false};
+  //! Hades: a correction of the sync of a passthrough stream that is under way: since when, the
+  //! pauses it put in and the packets it left out (CActiveAE::SyncStream(); each a cut in the sound)
+  bool m_rawAdjusting{false};
+  std::chrono::steady_clock::time_point m_rawAdjustSince{};
+  double m_rawPauseMs{0};
+  unsigned int m_rawDropped{0};
 };
 }
 
diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 21490f5..42672b3 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -17,6 +17,7 @@
 #include "cores/AudioEngine/Utils/AEELDParser.h"
 #include "cores/AudioEngine/Utils/AEUtil.h"
 #include "platform/Platform.h"
+#include "utils/StringUtils.h"
 #include "utils/XTimeUtils.h"
 #include "utils/log.h"
 
@@ -861,6 +862,9 @@ bool CAESinkALSA::InitializeSW(const ALSAConfig &inconfig)
 
 void CAESinkALSA::Deinitialize()
 {
+  // Hades: what GetDelay() still had to tell
+  if (m_delayEvents)
+    TellDelayEvents(true);
   if (m_pcm)
   {
     Stop();
@@ -884,17 +888,53 @@ void CAESinkALSA::GetDelay(AEDelayStatus& status)
     return;
   }
   snd_pcm_sframes_t frames = 0;
-  snd_pcm_delay(m_pcm, &frames);
+  // Hades: what the device says, and when it played past the data written (an underrun: the
+  // sound cut out for that long, and the data is skipped ahead), are told (TellDelayEvents())
+  const int error = snd_pcm_delay(m_pcm, &frames);
+  if (error < 0)
+  {
+    ++m_delayEvents;
+    m_delayError = error;
+    frames = 0;
+  }
 
   if (frames < 0)
   {
+    ++m_delayEvents;
+    m_delayPastMs += static_cast<double>(-frames) * m_formatSampleRateMul * 1000.0;
     snd_pcm_forward(m_pcm, -frames);
     frames = 0;
   }
+  if (m_delayEvents)
+    TellDelayEvents(false);
 
   status.SetDelay((double)frames * m_formatSampleRateMul);
 }
 
+void CAESinkALSA::TellDelayEvents(bool force)
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (!force && now - m_delayToldAt < std::chrono::seconds(1))
+    return;
+  m_delayToldAt = now;
+  CLog::Log(LOGWARNING,
+            "CAESinkALSA - {} times since the last line, the device{}{}{} ({}): the sound {} cut "
+            "out",
+            m_delayEvents,
+            m_delayPastMs > 0 ? StringUtils::Format(" had played {:.1f} ms past the data written "
+                                                    "(an underrun), skipped ahead",
+                                                    m_delayPastMs)
+                              : "",
+            m_delayPastMs > 0 && m_delayError ? ", and" : "",
+            m_delayError ? StringUtils::Format(" could not tell its delay (the last time: {})",
+                                               snd_strerror(m_delayError))
+                         : "",
+            m_passthrough ? "passthrough" : "PCM", m_delayPastMs > 0 ? "" : "may have");
+  m_delayEvents = 0;
+  m_delayPastMs = 0;
+  m_delayError = 0;
+}
+
 double CAESinkALSA::GetCacheTotal()
 {
   return (double)m_bufferSize * m_formatSampleRateMul;
diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.h b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.h
index 90c5321..f3eda5b 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.h
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.h
@@ -12,6 +12,7 @@
 #include "cores/AudioEngine/Utils/AEDeviceInfo.h"
 #include "threads/CriticalSection.h"
 
+#include <chrono>
 #include <stdint.h>
 
 #include <alsa/asoundlib.h>
@@ -63,6 +64,13 @@ private:
   unsigned int m_bufferSize = 0;
   double m_formatSampleRateMul = 0.0;
   bool m_passthrough = false;
+  //! Hades: underruns that the device played past, and failures to tell the delay, since the last
+  //! line about them (GetDelay(); at most one line a second)
+  unsigned int m_delayEvents = 0;
+  double m_delayPastMs = 0;
+  int m_delayError = 0;
+  std::chrono::steady_clock::time_point m_delayToldAt{};
+  void TellDelayEvents(bool force);
   std::string m_device;
   snd_pcm_t *m_pcm;
   int m_timeout = 0;
diff --git a/xbmc/cores/AudioEngine/Sinks/alsa/ALSADeviceMonitor.cpp b/xbmc/cores/AudioEngine/Sinks/alsa/ALSADeviceMonitor.cpp
index 2d2bd78..058862f 100644
--- a/xbmc/cores/AudioEngine/Sinks/alsa/ALSADeviceMonitor.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/alsa/ALSADeviceMonitor.cpp
@@ -108,13 +108,14 @@ void CALSADeviceMonitor::FDEventCallback(int id, int fd, short revents, void *da
     /* cardX devices emit a "change" event when ready (i.e. all subdevices added) */
     if (strcmp(action, "change") == 0)
     {
-      CLog::Log(LOGDEBUG, "CALSADeviceMonitor - ALSA card added (\"{}\", \"{}\")",
+      CLog::Log(LOGINFO, "CALSADeviceMonitor - ALSA card added (\"{}\", \"{}\")",
                 udev_device_get_syspath(device), udev_device_get_devpath(device));
       audioDevicesChanged = true;
     }
     else if (strcmp(action, "remove") == 0)
     {
-      CLog::Log(LOGDEBUG, "CALSADeviceMonitor - ALSA card removed");
+      CLog::Log(LOGINFO, "CALSADeviceMonitor - ALSA card removed (\"{}\")",
+                udev_device_get_syspath(device));
       audioDevicesChanged = true;
     }
 
diff --git a/xbmc/cores/AudioEngine/Sinks/alsa/ALSAHControlMonitor.cpp b/xbmc/cores/AudioEngine/Sinks/alsa/ALSAHControlMonitor.cpp
index 5572920..fe9cb87 100644
--- a/xbmc/cores/AudioEngine/Sinks/alsa/ALSAHControlMonitor.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/alsa/ALSAHControlMonitor.cpp
@@ -110,7 +110,16 @@ int CALSAHControlMonitor::HCTLCallback(snd_hctl_elem_t *elem, unsigned int mask)
 
   if (mask & SND_CTL_EVENT_MASK_VALUE)
   {
-    CLog::Log(LOGDEBUG, "CALSAHControlMonitor - Monitored ALSA hctl value changed");
+    // Hades: what changed, and where: the audio of the output is closed, the outputs are listed
+    // again and it is opened again (a cut in the sound), which is told without debug logging
+    snd_hctl_t* hctl = snd_hctl_elem_get_hctl(elem);
+    snd_ctl_t* ctl = hctl ? snd_hctl_ctl(hctl) : nullptr;
+    const char* card = ctl ? snd_ctl_name(ctl) : nullptr;
+    const char* name = snd_hctl_elem_get_name(elem);
+    CLog::Log(LOGINFO,
+              "CALSAHControlMonitor - the control \"{}\" (device {}) of {} changed (for an ELD: "
+              "what the display says of its audio): the outputs are listed again",
+              name ? name : "?", snd_hctl_elem_get_device(elem), card ? card : "?");
 
     /*
      * Currently we just re-enumerate on any change.
-- 
