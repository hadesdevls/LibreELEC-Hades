diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
index 9102cbe..b39c552 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
@@ -105,14 +105,6 @@ StreamHdrType ConvertHdrType(const VIDEOCODEC_HDR_TYPE type)
   return StreamHdrType::HDR_TYPE_NONE;
 }
 
-unsigned int GetColorBitsFromVideoFormat(const VIDEOCODEC_FORMAT videoFormat)
-{
-  // Delegate format mapping to ConvertToPixelFormat; bit depth comes
-  // from libavutil's public pixdesc API, avoiding a parallel switch.
-  const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(ConvertToPixelFormat(videoFormat));
-  return desc ? desc->comp[0].depth : 8;
-}
-
 } // unnamed namespace
 
 CAddonVideoCodec::CAddonVideoCodec(CProcessInfo& processInfo,
@@ -377,6 +369,8 @@ CDVDVideoCodec::VCReturn CAddonVideoCodec::GetPicture(VideoPicture* pVideoPictur
     videoBuffer->Release();
   }
 
+  const AVPixelFormat format = ConvertToPixelFormat(picture.videoFormat);
+
   switch (ret)
   {
   case VIDEOCODEC_RETVAL::VC_NONE:
@@ -392,9 +386,9 @@ CDVDVideoCodec::VCReturn CAddonVideoCodec::GetPicture(VideoPicture* pVideoPictur
     pVideoPicture->dts = DVD_NOPTS_VALUE;
     pVideoPicture->iFlags = 0;
     pVideoPicture->chroma_position = AVCHROMA_LOC_UNSPECIFIED;
-    pVideoPicture->colorBits = GetColorBitsFromVideoFormat(picture.videoFormat);
+    pVideoPicture->colorBits = av_pix_fmt_desc_get(format)->comp[0].depth;
     pVideoPicture->color_primaries = m_colorPrimaries;
-    pVideoPicture->color_range = m_colorRange == AVCOL_RANGE_JPEG ? 1 : 0; // 0=Limited, 1=Full
+    pVideoPicture->color_range = VideoPicture::IsFullRange(m_colorRange, format);
     pVideoPicture->color_space = m_colorSpace;
     pVideoPicture->color_transfer = m_colorTransfer;
     pVideoPicture->hasDisplayMetadata = false;
@@ -442,7 +436,7 @@ CDVDVideoCodec::VCReturn CAddonVideoCodec::GetPicture(VideoPicture* pVideoPictur
     for (int i = 0; i<YuvImage::MAX_PLANES; ++i)
       planeOffsets[i] = picture.planeOffsets[i];
 
-    pVideoPicture->videoBuffer->SetPixelFormat(ConvertToPixelFormat(picture.videoFormat));
+    pVideoPicture->videoBuffer->SetPixelFormat(format);
     pVideoPicture->videoBuffer->SetDimensions(picture.width, picture.height, strides, planeOffsets);
 
     pVideoPicture->iDisplayWidth = pVideoPicture->iWidth;
@@ -473,11 +467,10 @@ CDVDVideoCodec::VCReturn CAddonVideoCodec::GetPicture(VideoPicture* pVideoPictur
       m_processInfo.SetVideoDimensions(m_width, m_height);
     }
 
-    // Inner scope keeps the const pix declaration from crossing the next
+    // Inner scope keeps the declaration from crossing the next
     // case label, which C++ forbids.
     {
-      const AVPixelFormat pix = ConvertToPixelFormat(picture.videoFormat);
-      const char* pixFmtName = av_get_pix_fmt_name(pix);
+      const char* pixFmtName = av_get_pix_fmt_name(format);
       m_processInfo.SetVideoPixelFormat(pixFmtName ? pixFmtName : "");
     }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
index c01db36..983f429 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
@@ -13,6 +13,11 @@
 #include <string>
 #include <vector>
 
+extern "C"
+{
+#include <libavutil/pixdesc.h>
+}
+
 //******************************************************************************
 // VideoPicture
 //******************************************************************************
@@ -97,6 +102,15 @@ VideoPicture& VideoPicture::SetParams(const VideoPicture &pic)
   return *this;
 }
 
+bool VideoPicture::IsFullRange(AVColorRange range, AVPixelFormat format)
+{
+  if (range != AVCOL_RANGE_UNSPECIFIED)
+    return range == AVCOL_RANGE_JPEG;
+
+  const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(format);
+  return desc && (desc->flags & AV_PIX_FMT_FLAG_RGB);
+}
+
 bool VideoPicture::CompareDisplayMetadata(const VideoPicture& pic) const
 {
   if (this->hasDisplayMetadata != pic.hasDisplayMetadata)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
index 5958a84..b4a9d3d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
@@ -55,6 +55,12 @@ public:
   void Reset(); // reinitialize members, videoBuffer will be released if set!
   bool IsSameParams(const VideoPicture& pic) const;
 
+  /*!
+   * \brief Whether a picture of \p format is full range when its stream gives \p range. RGB with
+   * no range given is full range.
+   */
+  static bool IsFullRange(AVColorRange range, AVPixelFormat format);
+
   CVideoBuffer *videoBuffer = nullptr;
 
   double pts; // timestamp in seconds, used in the CVideoPlayer class to keep track of pts
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index e6787e5..be7e905 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -2297,11 +2297,14 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(pVideoPicture->pixelFormat);
   pVideoPicture->colorBits = desc ? desc->comp[0].depth : 8;
 
+  AVColorRange range = m_hints.colorRange;
   if (m_pCodecContext->color_range == AVCOL_RANGE_JPEG ||
     m_pCodecContext->pix_fmt == AV_PIX_FMT_YUVJ420P)
-    pVideoPicture->color_range = 1;
-  else
-    pVideoPicture->color_range = m_hints.colorRange == AVCOL_RANGE_JPEG ? 1 : 0;
+    range = AVCOL_RANGE_JPEG;
+  else if (range == AVCOL_RANGE_UNSPECIFIED)
+    range = m_pCodecContext->color_range;
+
+  pVideoPicture->color_range = VideoPicture::IsFullRange(range, pVideoPicture->pixelFormat);
 
   //! @todo: ffmpeg doesn't seem like they know how they want to handle this.
   // av_frame_get_qp_table is deprecated but there doesn't seem to be a valid
diff --git a/xbmc/cores/VideoPlayer/test/TestVideoCodecPictureFormat.cpp b/xbmc/cores/VideoPlayer/test/TestVideoCodecPictureFormat.cpp
index bbf475c..31134d9 100644
--- a/xbmc/cores/VideoPlayer/test/TestVideoCodecPictureFormat.cpp
+++ b/xbmc/cores/VideoPlayer/test/TestVideoCodecPictureFormat.cpp
@@ -133,3 +133,14 @@ TEST(TestVideoCodecPictureFormat, H264ReportsItsPixelFormatAndBitDepth)
   EXPECT_EQ(8, picture.depthFromDescriptor);
   EXPECT_EQ(8u, picture.colorBits);
 }
+
+//! FFmpeg takes RGB to be full range, and a decoder handing RGB over often gives no range.
+TEST(TestVideoCodecPictureFormat, RangeNotGivenIsFullForRGBOnly)
+{
+  EXPECT_TRUE(VideoPicture::IsFullRange(AVCOL_RANGE_UNSPECIFIED, AV_PIX_FMT_BGR0));
+  EXPECT_TRUE(VideoPicture::IsFullRange(AVCOL_RANGE_UNSPECIFIED, AV_PIX_FMT_GBRP10));
+  EXPECT_FALSE(VideoPicture::IsFullRange(AVCOL_RANGE_UNSPECIFIED, AV_PIX_FMT_YUV420P));
+
+  EXPECT_FALSE(VideoPicture::IsFullRange(AVCOL_RANGE_MPEG, AV_PIX_FMT_BGR0));
+  EXPECT_TRUE(VideoPicture::IsFullRange(AVCOL_RANGE_JPEG, AV_PIX_FMT_YUV420P));
+}
