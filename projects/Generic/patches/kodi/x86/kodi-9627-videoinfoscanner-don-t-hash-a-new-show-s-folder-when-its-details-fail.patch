From d33b2ddfec37b2a89e4d6075cb120ddac8212f23 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:03:13 +0100
Subject: [PATCH] [VideoInfoScanner] Don't hash a new show's folder when its
 details fail

When the details of a new TV show couldn't be retrieved, its episodes
were still processed against show id -1, writing orphaned episodes and
seasons, and the folder hash could be stored. The show was then never
added, and never retried as the folder looked unchanged. Return
NOT_FOUND without touching the episodes or the hash instead, as is done
for movies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3697f968459f67d554e7e37142561b438166b11c)
---
 xbmc/video/VideoInfoScanner.cpp          | 21 ++++++++++++---------
 xbmc/video/test/TestVideoInfoScanner.cpp | 18 ++++++++++++++++++
 2 files changed, 30 insertions(+), 9 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 0a7ad7e..cd2906e 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -1090,14 +1090,17 @@ CVideoInfoScanner::~CVideoInfoScanner()
     CLog::Log(LOGDEBUG, "VideoInfoScanner: Fetching url '{}' using {} scraper (content: '{}')",
               url.GetFirstThumbUrl(), info2->Name(), info2->Content());
 
-    if (GetDetails(pItem, {}, url, info2,
-                   (result == InfoType::COMBINED || result == InfoType::OVERRIDE) ? loader.get()
-                                                                                  : nullptr,
-                   pDlgProgress))
-    {
-      if ((lResult = AddVideo(pItem, info2, false, useLocal)) < 0)
-        return InfoRet::INFO_ERROR;
-    }
+    // Without the show's details there is nothing to add its episodes to. The folder isn't hashed,
+    // so that the next scan tries again.
+    if (!GetDetails(pItem, {}, url, info2,
+                    (result == InfoType::COMBINED || result == InfoType::OVERRIDE) ? loader.get()
+                                                                                   : nullptr,
+                    pDlgProgress))
+      return InfoRet::NOT_FOUND;
+
+    if ((lResult = AddVideo(pItem, info2, false, useLocal)) < 0)
+      return InfoRet::INFO_ERROR;
+
     if (fetchEpisodes && !files.empty())
     {
       const InfoRet ret =
@@ -1105,7 +1108,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
       if (ret == InfoRet::ADDED)
         setFolderHash();
     }
-    else if (lResult >= 0 && files.empty())
+    else if (files.empty())
     {
       setFolderHash();
     }
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 1dd09ad..0000ba4 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -690,3 +690,21 @@ TEST_F(TestVideoInfoScannerTvShows, ABlurayRipInAShowIsOneEpisode)
   EXPECT_EQ(1, episodes[0].iSeason);
   EXPECT_EQ(1, episodes[0].iEpisode);
 }
+
+// TV shows looked up with a scraper
+
+TEST_F(TestVideoInfoScannerTvShows, AShowWhoseDetailsFailedIsLookedUpAgain)
+{
+  UseTestScraper(ADDON::AddonType::SCRAPER_TVSHOWS);
+  DetailsFail("Show");
+  const std::string episode{Episode(Folder(Folder(m_root, "Show"), "Season 1"), "Show S01E01.mkv")};
+  Scan();
+  ASSERT_EQ(0, CountShows());
+  EXPECT_EQ(0, CountEpisodes());
+
+  Details("Show", "<details><title>Show</title></details>");
+  Scan();
+
+  EXPECT_EQ(1, CountShows());
+  EXPECT_GT(m_db.GetEpisodeId(episode, 1, 1), 0);
+}
