diff --git a/xbmc/utils/HDR10PlusVsif.h b/xbmc/utils/HDR10PlusVsif.h
index a76fa4d..a91c746 100644
--- a/xbmc/utils/HDR10PlusVsif.h
+++ b/xbmc/utils/HDR10PlusVsif.h
@@ -55,6 +55,54 @@ inline uint8_t CodedMaxRgb(int64_t coded)
   return static_cast<uint8_t>(std::min<int64_t>(255, (v + (1 << 3)) >> 4));
 }
 
+/*!
+ * \brief The percentages of the nine values of the distribution of maxRGB that the InfoFrame
+ *        carries, PB6..PB14 in that order
+ *
+ * The InfoFrame has nine places and no percentages: each place is of one percentage. Those of the
+ * code of Amlogic that its layout comes from (above): the first nine entries of the metadata in
+ * their places, and in application version 0 with ten entries the tenth in the ninth place,
+ * which it names the 99th percentile (maxrgb_99_percentiles); neither looks at a percentage.
+ * The forms of the metadata that hdr10plus_tool (MIT, read as data: hdr10plus/src/metadata.rs,
+ * DISTRIBUTION_INDEXES_9 and _10, main 82cb01ba3871) takes: nine entries at 1, 5, 10, 25, 50, 75,
+ * 90, 95 and 99, or ten with 98 before 99. ST 2094-40 has the entry at 99 made at 99.98 percent
+ * (as dvbridge_hdr10plus.h reads it). The HDR10+ specification itself is given to adopters only:
+ * not read.
+ */
+constexpr std::array<uint8_t, 9> VSIF_PERCENTAGES{1, 5, 10, 25, 50, 75, 90, 95, 99};
+
+/*!
+ * \brief The entry of the distribution of maxRGB of a window that each place of the InfoFrame
+ *        takes (VSIF_PERCENTAGES), by its percentage; nothing when the distribution is not one
+ *        of the two forms: nine entries of those percentages, in that order, or ten with an
+ *        entry at 98 before the one at 99 (that one is left out). Hades: Kodi took the entries by
+ *        their places, whatever their percentages: a distribution of other percentages went out
+ *        with its values in the places of others, one of fewer than nine with zeros, and one of
+ *        ten in application version 1 with its 98th percentile in the place of the 99th.
+ */
+inline std::optional<std::array<unsigned int, 9>> DistributionFrom(
+    const AVHDRPlusColorTransformParams& w)
+{
+  const int count = w.num_distribution_maxrgb_percentiles;
+  if (count != 9 && count != 10)
+    return std::nullopt;
+  std::array<unsigned int, 9> from{};
+  unsigned int entry = 0;
+  for (unsigned int i = 0; i < 9; ++i, ++entry)
+  {
+    if (count == 10 && i == 8)
+    {
+      if (w.distribution_maxrgb[entry].percentage != 98)
+        return std::nullopt;
+      ++entry;
+    }
+    if (w.distribution_maxrgb[entry].percentage != VSIF_PERCENTAGES[i])
+      return std::nullopt;
+    from[i] = entry;
+  }
+  return from;
+}
+
 /*!
  * \brief The payload of the HDR10+ vendor-specific InfoFrame of a picture, from its SMPTE ST
  *        2094-40 (application 4) metadata as FFmpeg gives it (AV_FRAME_DATA_DYNAMIC_HDR_PLUS,
@@ -70,7 +118,7 @@ inline uint8_t CodedMaxRgb(int64_t coded)
  *  - PB5: average_maxrgb; PB6..PB14: the nine percentiles of the distribution of maxRGB of the
  *    first window, each in units of 16/10000 and at most 255, except the third one of
  *    application version 1, which is given as it is coded (it is no percentile there);
- *    in version 0, a tenth percentile replaces the ninth;
+ *    in version 0, a tenth percentile replaces the ninth (see VSIF_PERCENTAGES);
  *  - PB15..PB17: the number of Bezier curve anchors (4 bits, 9 at most), the knee point x and
  *    y (10 bits each, of the 12 of the metadata); PB18..PB26: the anchors (8 of their 10
  *    bits); all of them 0 without tone mapping;
@@ -78,14 +126,37 @@ inline uint8_t CodedMaxRgb(int64_t coded)
  *    where Kodi composes its GUI over the video) and no delay 1 (it is sent with the frame it
  *    is of).
  * Every field comes from the picture's own metadata of its first processing window; nothing is
- * made up. Nothing when there is no window, or for an application version above 1.
+ * made up. Nothing when there is no window, for an application version above 1, or for a
+ * distribution of maxRGB that is not the one the InfoFrame carries (VSIF_PERCENTAGES): its
+ * values would go out in the places of others. why (may be nullptr): then why, a fixed text for
+ * the log; else nullptr.
  */
-inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m)
+inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m, const char** why = nullptr)
 {
-  if (m.num_windows < 1 || m.application_version > 1)
+  const char* unused = nullptr;
+  if (!why)
+    why = &unused;
+  *why = nullptr;
+  if (m.num_windows < 1)
+  {
+    *why = "the metadata have no processing window";
+    return std::nullopt;
+  }
+  if (m.application_version > 1)
+  {
+    *why = "an application version above 1";
     return std::nullopt;
+  }
 
   const AVHDRPlusColorTransformParams& w = m.params[0];
+  // Hades: the entry of the distribution that each value of the InfoFrame is (DistributionFrom())
+  const auto from = DistributionFrom(w);
+  if (!from)
+  {
+    *why = "a distribution of maxRGB that is not the one its InfoFrame carries (the nine "
+           "percentiles at 1, 5, 10, 25, 50, 75, 90, 95 and 99 %, or ten with 98 % before 99 %)";
+    return std::nullopt;
+  }
   Payload p{};
   p[0] = 0x8B;
   p[1] = 0x84;
@@ -97,13 +168,9 @@ inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m)
 
   p[4] = CodedMaxRgb(Coded(w.average_maxrgb, 100000));
 
-  const unsigned int count = std::min<unsigned int>(w.num_distribution_maxrgb_percentiles, 15);
   for (unsigned int i = 0; i < 9; ++i)
   {
-    unsigned int from = i;
-    if (i == 8 && m.application_version == 0 && count == 10)
-      from = 9;
-    const int64_t coded = from < count ? Coded(w.distribution_maxrgb[from].percentile, 100000) : 0;
+    const int64_t coded = Coded(w.distribution_maxrgb[(*from)[i]].percentile, 100000);
     if (i == 2 && m.application_version != 0)
       p[5 + i] = static_cast<uint8_t>(std::min<int64_t>(255, coded));
     else
@@ -164,10 +231,44 @@ public:
   static constexpr unsigned int BACK = 48;
   static constexpr unsigned int BACK_MAX = 1440;
 
-  //! The InfoFrame of the next picture, whose own is own (nothing without metadata)
-  std::optional<Payload> Picture(const std::optional<Payload>& own)
+  /*!
+   * \brief The InfoFrame of the next picture, whose own is own (nothing without metadata).
+   *        refused: the picture has HDR10+ metadata that its InfoFrame cannot carry, and why
+   *        (MakeVsif()): it counts as a picture without; the log says it once a stream.
+   */
+  std::optional<Payload> Picture(const std::optional<Payload>& own, const char* refused = nullptr)
   {
     m_message.clear();
+    std::string told;
+    if (!own && refused && !m_refusedTold)
+    {
+      m_refusedTold = true;
+      told = std::string("the metadata of a picture of this video cannot go in its InfoFrame: ") +
+             refused + "; such pictures go out as pictures without HDR10+ metadata";
+    }
+    std::optional<Payload> sent = Next(own);
+    if (!told.empty())
+      m_message = m_message.empty() ? told : told + "; " + m_message;
+    return sent;
+  }
+
+  //! A flush (a seek): nothing of the pictures before is held
+  void Flush()
+  {
+    m_missing = 0;
+    m_present = 0;
+    m_last.reset();
+  }
+
+  //! A new stream
+  void Reset() { *this = CGap(); }
+
+  //! What the last picture changed, for the log (empty for nothing)
+  const std::string& Message() const { return m_message; }
+
+private:
+  std::optional<Payload> Next(const std::optional<Payload>& own)
+  {
     if (!own)
     {
       m_present = 0;
@@ -198,27 +299,13 @@ public:
     return own;
   }
 
-  //! A flush (a seek): nothing of the pictures before is held
-  void Flush()
-  {
-    m_missing = 0;
-    m_present = 0;
-    m_last.reset();
-  }
-
-  //! A new stream
-  void Reset() { *this = CGap(); }
-
-  //! What the last picture changed, for the log (empty for nothing)
-  const std::string& Message() const { return m_message; }
-
-private:
   std::optional<Payload> m_last;
   unsigned int m_missing = 0;
   unsigned int m_present = 0;
   unsigned int m_back = BACK;
   unsigned int m_returns = 0;
   bool m_absent = false;
+  bool m_refusedTold = false; //!< Hades: a refusal of MakeVsif() was told in this stream
   std::string m_message;
 };
 
