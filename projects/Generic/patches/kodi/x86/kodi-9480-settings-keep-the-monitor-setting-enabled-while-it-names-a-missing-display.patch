From 048dd0a0c28653f7a439f4e40c759d44e62ea96b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 18:31:51 +0000
Subject: [PATCH] settings: keep the Monitor setting enabled while it names a
 missing display

With the AND condition of Kodi PR 29073 the setting is greyed where
there is one monitor. A setting that names a display that is not
connected (a TV unplugged since it was chosen) was then greyed too, and
neither Default nor the one monitor could be chosen again.
HasMultipleMonitors now also holds where the value names no connected
output (MonitorChoice.h). The condition names videoscreen.monitor, so
that it is given the value and is looked at again when it changes.
---
 system/settings/settings.xml        |  4 ++-
 xbmc/settings/SettingConditions.cpp | 15 +++++++++--
 xbmc/windowing/CMakeLists.txt       |  1 +
 xbmc/windowing/MonitorChoice.h      | 42 +++++++++++++++++++++++++++++
 4 files changed, 59 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/windowing/MonitorChoice.h

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index d76aff2..ea5edbd 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -2962,7 +2962,9 @@
               <!-- Hades: AND, as Kodi PR 29073 has it: with one monitor there is nothing to choose -->
               <and>
                 <condition on="property" name="SupportsScreenMove" />
-                <condition on="property" name="HasMultipleMonitors" />
+                <!-- Hades: with the setting, which it reads (a monitor named that is not connected keeps it
+                     enabled: MonitorChoice.h) -->
+                <condition on="property" name="HasMultipleMonitors" setting="videoscreen.monitor" />
               </and>
             </dependency>
             <dependency type="update" setting="videoscreen.screenmode" />
diff --git a/xbmc/settings/SettingConditions.cpp b/xbmc/settings/SettingConditions.cpp
index 14891d1..7e0080b 100644
--- a/xbmc/settings/SettingConditions.cpp
+++ b/xbmc/settings/SettingConditions.cpp
@@ -25,6 +25,7 @@
 #include "settings/SettingsComponent.h"
 #include "utils/FontUtils.h"
 #include "utils/StringUtils.h"
+#include "windowing/MonitorChoice.h"
 #include "windowing/WinSystem.h"
 
 namespace
@@ -104,9 +105,19 @@ bool HasSystemSdrPeakLuminance(const std::string& /*condition*/,
 
 bool HasMultipleMonitors(const std::string& /*condition*/,
                          const std::string& /*value*/,
-                         const SettingConstPtr& /*setting*/)
+                         const SettingConstPtr& setting)
 {
-  return CServiceBroker::GetWinSystem()->GetPhysicalOutputCount() > 1;
+  CWinSystemBase* const winSystem = CServiceBroker::GetWinSystem();
+  if (!winSystem)
+    return false;
+  const size_t physical = winSystem->GetPhysicalOutputCount();
+  if (physical > 1)
+    return true;
+  // Hades: ... or the setting (videoscreen.monitor, which the condition names) names a monitor that
+  // is not connected: Default can be chosen again (MonitorChoice.h)
+  const auto monitor = std::dynamic_pointer_cast<const CSettingString>(setting);
+  return monitor && KODI::WINDOWING::MonitorChoiceOpen(physical, monitor->GetValue(),
+                                                       winSystem->GetConnectedOutputs());
 }
 
 bool SupportsVideoSuperResolution(const std::string& /*condition*/,
diff --git a/xbmc/windowing/CMakeLists.txt b/xbmc/windowing/CMakeLists.txt
index 21c7611..57d4091 100644
--- a/xbmc/windowing/CMakeLists.txt
+++ b/xbmc/windowing/CMakeLists.txt
@@ -5,6 +5,7 @@ set(SOURCES GraphicContext.cpp
             WinSystem.cpp)
 
 set(HEADERS GraphicContext.h
+            MonitorChoice.h
             OSScreenSaver.h
             Resolution.h
             WinEvents.h
diff --git a/xbmc/windowing/MonitorChoice.h b/xbmc/windowing/MonitorChoice.h
new file mode 100644
index 0000000..ac61375
--- /dev/null
+++ b/xbmc/windowing/MonitorChoice.h
@@ -0,0 +1,42 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+
+/*!
+ * \brief Hades: whether the Monitor setting has something to choose, which is what enables it
+ *        (with the window system's moving to another screen; Kodi PR 29073): more than one
+ *        monitor, or a value that names one that is not connected. With one monitor, that value
+ *        would be kept as it is with the setting greyed: Default, or the one monitor, could not
+ *        be chosen again.
+ * \param physical the monitors (CWinSystemBase::GetPhysicalOutputCount())
+ * \param named the value of the setting; empty, as Default
+ * \param outputs the values the setting can take now (CWinSystemBase::GetConnectedOutputs(), which
+ *        has Default)
+ */
+inline bool MonitorChoiceOpen(std::size_t physical,
+                              const std::string& named,
+                              const std::vector<std::string>& outputs)
+{
+  if (physical > 1)
+    return true;
+  return !named.empty() && std::ranges::find(outputs, named) == outputs.end();
+}
+
+} // namespace WINDOWING
+} // namespace KODI
