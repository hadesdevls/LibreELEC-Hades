From d5f18d8fb5851a8b387f9b9460e9956c7a052152 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 6 Oct 2026 19:43:24 +0000
Subject: [PATCH] ActiveAE: open the sink again after an attempt that failed

Configure() stores the request in m_sinkRequestFormat before it opens
the sink. When InitSink() fails with the device unchanged (a new
stream, a reconfiguration or the idle timer finds the output gone or
busy), the retry of the error state calls Configure() again, the
request is compared with itself, the sink is not opened, and the
buffers and the resamplers are configured for the format of a sink that
is no longer there. The resamplers cannot be set up, and freeing the
mismatched buffer pools corrupts the heap (swr_get_delay() on a null
context, or an abort in ~CActiveAEBufferPool).

It is a defect of Kodi, likely when native Dolby Vision output is left
at a stop and the refresh rate is restored right after. (After a lost
display or a device change the device name is cleared, and the sink was
already opened again.)

With the sink really opened again on every attempt, a stream that was
made while it could not be opened stays without processing buffers for
as long as it fails, and the handler of DRAINSTREAM of the states
without a configuration used them without looking: it now drains only a
stream that has them.

The retry is from intel-dv-libreelec, patches/kodi/
kodi-9998-activeae-sink-retry.patch at
0008daa71e8233891fcf712d7e0f59fe65eaab3d ("Reopen the audio sink when
retrying after a failed sink init", pull request 6 of that repository),
with the comments reworded. The drain is not from there.
---
 .../cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 13 ++++++++++---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h  |  3 +++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 3860c3f..893956c 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -473,7 +473,9 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           CActiveAEStream *stream;
           stream = *(CActiveAEStream**)msg->data;
           stream->m_drain = true;
-          stream->m_processingBuffers->SetDrain(true);
+          // a stream that was made while the sink could not be opened has no buffers
+          if (stream->m_processingBuffers)
+            stream->m_processingBuffers->SetDrain(true);
           msg->Reply(CActiveAEDataProtocol::ACC);
           stream->m_streamPort->SendInMessage(CActiveAEDataProtocol::STREAMDRAINED);
           return;
@@ -1303,12 +1305,17 @@ void CActiveAE::Configure(AEAudioFormat *desiredFmt)
   const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
   const bool requestedDefaultDevice = IsDefaultDevice(dev);
 
-  if ((!CompareFormat(m_sinkRequestFormat, m_sinkFormat) &&
+  // After an InitSink() that failed, m_sinkRequestFormat already holds the request that failed:
+  // compared with itself, the next attempt would not open the sink, and would configure the
+  // buffers and the resamplers for the format of a sink that is no longer there.
+  if (m_sinkInitFailed ||
+      (!CompareFormat(m_sinkRequestFormat, m_sinkFormat) &&
        !CompareFormat(m_sinkRequestFormat, oldSinkRequestFormat)) ||
       m_currDevice.compare(dev.name) != 0 || m_settings.driver.compare(dev.driver) != 0)
   {
     FlushEngine();
-    if (!InitSink())
+    m_sinkInitFailed = !InitSink();
+    if (m_sinkInitFailed)
       return;
     m_settings.driver = dev.driver;
     m_currDevice = dev.name;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index 0213320..98b17e7 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -372,6 +372,9 @@ protected:
   bool m_bStateMachineSelfTrigger;
   std::chrono::milliseconds m_extTimeout;
   bool m_extError;
+  //! The last InitSink() failed: the sink is opened again before anything is configured for
+  //! m_sinkFormat.
+  bool m_sinkInitFailed{false};
   unsigned int m_extErrorRetries{0};
   bool m_extDrain;
   XbmcThreads::EndTime<> m_extDrainTimer;
-- 
2.53.0

