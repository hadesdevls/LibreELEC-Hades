+// Hades: the points of a file further on (KODI::MPEG2::SAMPLE_POINTS: 50, 10 and 75 % of its
+// length), each decoded for the cadence of its fields (KODI::FIELDCADENCE::CProbe): 2 MiB of the
+// file at each, read with a handle of their own, its video taken out of the packets of a program
+// or transport stream or the blocks of a Matroska file, or the bytes as they are for an
+// elementary stream. All three are read: a film is only told where they agree
+// (KODI::FIELDCADENCE::Decide()). Not over the internet; 1.5 s at the most, a point not read
+// tells nothing.
+std::vector<KODI::FIELDCADENCE::Cadence> SampleForFieldCadence(
+    const std::string& path,
+    const std::string& format,
+    std::string& said,
+    const std::function<bool()>& aborted)
+{
+  using namespace KODI::FIELDCADENCE;
+  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
+  static constexpr size_t POINT_BYTES = 2 * 1024 * 1024;
+  std::vector<Cadence> points;
+  if (URIUtils::IsInternetStream(path))
+    return points;
+  XFILE::CFile file;
+  if (!file.Open(path, XFILE::READ_TRUNCATED | XFILE::READ_NO_CACHE))
+    return points;
+  const int64_t length = file.GetLength();
+  const auto begin = std::chrono::steady_clock::now();
+  size_t bytes = 0;
+  for (const double point : KODI::MPEG2::SAMPLE_POINTS)
+  {
+    Cadence verdict = Cadence::UNKNOWN;
+    const int64_t offset = static_cast<int64_t>(static_cast<double>(length) * point);
+    std::vector<uint8_t> raw(POINT_BYTES);
+    size_t got = 0;
+    if (length > 0 && file.Seek(offset, SEEK_SET) == offset)
+    {
+      while (got < raw.size() && std::chrono::steady_clock::now() - begin < MAX_TIME &&
+             !aborted())
+      {
+        const ssize_t r = file.Read(raw.data() + got, std::min<size_t>(256 * 1024, raw.size() - got));
+        if (r <= 0)
+          break;
+        got += static_cast<size_t>(r);
+      }
+    }
+    raw.resize(got);
+    bytes += got;
+    if (!raw.empty() && std::chrono::steady_clock::now() - begin < MAX_TIME && !aborted())
+    {
+      CProbe probe;
+      if (format == "mpeg")
+        probe.AddStretch(KODI::MPEG2::ProgramStreamVideo(raw.data(), raw.size()));
+      else if (format == "mpegts")
+        probe.AddStretch(TransportStreamVideo(raw.data(), raw.size()));
+      else if (format.starts_with("matroska"))
+        probe.AddStretch(MatroskaVideo(raw.data(), raw.size()));
+      else
+        probe.AddStretch(raw);
+      verdict = probe.Finish();
+      said += StringUtils::Format("; at {:.0f} %: {} ({} pictures)", point * 100.0, NameOf(verdict),
+                                  probe.Pictures());
+    }
+    points.push_back(verdict);
+  }
+  file.Close();
+  said += StringUtils::Format(" ({} KiB read and decoded in {} ms)", bytes / 1024,
+                              std::chrono::duration_cast<std::chrono::milliseconds>(
+                                  std::chrono::steady_clock::now() - begin)
+                                  .count());
+  return points;
+}
