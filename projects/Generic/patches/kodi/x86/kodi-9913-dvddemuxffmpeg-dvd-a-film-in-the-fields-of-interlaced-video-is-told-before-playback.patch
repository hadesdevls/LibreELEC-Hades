+// Hades: whether films in the fields of interlaced video are put back together
+// (videoplayer.hadesfilmfields, on by default)
+bool CDVDDemuxFFmpeg::FilmCadenceWanted()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent();
+  return settings && settings->GetSettings() &&
+         settings->GetSettings()->GetBool(CSettings::SETTING_VIDEOPLAYER_HADESFILMFIELDS);
+}
+
+// Hades: what a stream that is a film in its fields says of itself: the rate of the film, not
+// interlaced; false (and nothing changed) where the rate of its coded frames is not one the
+// cadence is of
+bool CDVDDemuxFFmpeg::ApplyFilmCadence(CDemuxStreamVideo& video,
+                                       KODI::FIELDCADENCE::Cadence cadence,
+                                       int codedRate,
+                                       int codedScale)
+{
+  int rate = 0;
+  int scale = 0;
+  if (!KODI::FIELDCADENCE::FilmRateOf(cadence, codedRate, codedScale, rate, scale))
+    return false;
+  video.iFpsRate = rate;
+  video.iFpsScale = scale;
+  video.codedFpsRate = codedRate;
+  video.codedFpsScale = codedScale;
+  video.interlaced = false;
+  video.filmCadence = cadence;
+  return true;
+}
