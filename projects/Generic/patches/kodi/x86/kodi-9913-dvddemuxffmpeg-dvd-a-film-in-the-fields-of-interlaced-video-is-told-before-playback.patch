+// Hades: a film whose pictures are in the fields of interlaced video (3:2 pulldown, 2:2) or
+// repeated in its frames (a film at 25 in 29.97): told from its start, decoded as it was read ahead
+// (PrefetchForSoftTelecine()), and from points further on (SampleForFieldCadence()), before the
+// streams are given to the player. Where they agree, the stream says the rate of the film, and the
+// decoder puts each picture back together (CDVDVideoCodecFFmpeg::SetFilters()): the mode is chosen
+// once, for the whole file, and is the film's.
+void CDVDDemuxFFmpeg::PrefetchForFieldCadence(CDemuxStreamVideo& video,
+                                              int index,
+                                              KODI::FIELDCADENCE::CProbe* fields,
+                                              bool rateOfFields)
+{
+  using namespace KODI::FIELDCADENCE;
+  if (!fields || !rateOfFields || !fields->IsOpen())
+    return;
+  const Cadence start = fields->Finish();
+  const Evidence evidence = fields->GetEvidence();
+  int codedRate = 0;
+  int codedScale = 0;
+  if (!fields->CodedRate(codedRate, codedScale))
+    return;
+  std::string said;
+  const std::vector<Cadence> points = SampleForFieldCadence(
+      m_pInput->GetFileName(), m_pFormatContext->iformat->name, said,
+      [this] { return m_abortRequested || (m_cancelCheck && m_cancelCheck()); });
+  const Cadence cadence = Decide(start, points);
+  if (cadence != Cadence::UNKNOWN && ApplyFilmCadence(video, cadence, codedRate, codedScale))
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} is a {} at {:.3f} coded frames a second (its start: {} "
+              "after {} pictures{}): its pictures are put back together and shown at {:.3f}",
+              index, NameOf(cadence), static_cast<double>(codedRate) / codedScale, NameOf(start),
+              fields->Pictures(), said, static_cast<double>(video.iFpsRate) / video.iFpsScale);
+  else
+    CLog::Log(LOGDEBUG,
+              "CDVDDemuxFFmpeg: stream {} is not told to be a film in its fields (its start: {} "
+              "after {} pictures, {} of them moving, {} combing both ways{}): shown as the stream "
+              "says",
+              index, NameOf(start), fields->Pictures(), evidence.moving, evidence.neither, said);
+}
