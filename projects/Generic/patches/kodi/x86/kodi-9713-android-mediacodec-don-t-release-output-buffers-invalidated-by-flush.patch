From 0533b52bed1de5913d089e26ba6351ba765a9bfb Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Fri, 23 Oct 2026 08:48:12 +0200
Subject: [PATCH] [Android] MediaCodec: Don't release output buffers
 invalidated by flush

MediaCodec.flush() hands all output buffers back to the codec and
invalidates their indices. The video thread and the renderer released
the buffers they still held afterwards, which MediaCodec rejected, so
every seek logged "ReleaseOutputBuffer error in render(...)".
---
 .../Video/DVDVideoCodecAndroidMediaCodec.cpp  | 30 ++++++++++++++-----
 .../Video/DVDVideoCodecAndroidMediaCodec.h    |  5 ++++
 2 files changed, 28 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
index 67bb605..85c7d2c 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
@@ -126,8 +126,10 @@ bool CMediaCodecVideoBuffer::WaitForFrame(int millis)
 
 void CMediaCodecVideoBuffer::ReleaseOutputBuffer(bool render, int64_t displayTime, CMediaCodecVideoBufferPool* pool)
 {
-  std::shared_ptr<CJNIMediaCodec> codec(
-      static_cast<CMediaCodecVideoBufferPool*>(pool ? pool : m_pool.get())->GetMediaCodec());
+  auto* bufferPool{static_cast<CMediaCodecVideoBufferPool*>(pool ? pool : m_pool.get())};
+  std::unique_lock lock(bufferPool->GetCriticalSection());
+
+  std::shared_ptr<CJNIMediaCodec> codec(bufferPool->GetMediaCodec());
 
   if (m_bufferId < 0 || !codec)
     return;
@@ -287,6 +289,12 @@ void CMediaCodecVideoBufferPool::ReleaseMediaCodecBuffers()
     buffer->ReleaseOutputBuffer(false, 0, this);
 }
 
+void CMediaCodecVideoBufferPool::InvalidateMediaCodecBuffers()
+{
+  std::unique_lock lock(m_criticalSection);
+  for (auto buffer : m_videoBuffers)
+    buffer->InvalidateOutputBuffer();
+}
 
 /*****************************************************************************/
 /*****************************************************************************/
@@ -1194,12 +1202,20 @@ void CDVDVideoCodecAndroidMediaCodec::Reset()
   {
     // now we can flush the actual MediaCodec object
     CLog::Log(LOGDEBUG, "CDVDVideoCodecAndroidMediaCodec::Reset Current state ({})", m_state);
-    m_codec->flush();
-    if (xbmc_jnienv()->ExceptionCheck())
     {
-      xbmc_jnienv()->ExceptionDescribe();
-      xbmc_jnienv()->ExceptionClear();
-      CLog::Log(LOGERROR, "CDVDVideoCodecAndroidMediaCodec::Reset: flush failed");
+      // No output buffer may be released between flush() and its invalidation
+      std::unique_lock lock(m_videoBufferPool->GetCriticalSection());
+
+      m_codec->flush();
+      if (xbmc_jnienv()->ExceptionCheck())
+      {
+        xbmc_jnienv()->ExceptionDescribe();
+        xbmc_jnienv()->ExceptionClear();
+        CLog::Log(LOGERROR, "CDVDVideoCodecAndroidMediaCodec::Reset: flush failed");
+      }
+
+      // flush() hands all output buffers back to MediaCodec, their indices are invalid now
+      m_videoBufferPool->InvalidateMediaCodecBuffers();
     }
 
     if (m_state == MEDIACODEC_STATE_ERROR)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.h
index 3f46318..8a43da7 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.h
@@ -59,6 +59,8 @@ public:
   void ReleaseOutputBuffer(bool render,
                            int64_t displayTime,
                            CMediaCodecVideoBufferPool* pool = nullptr);
+  // MediaCodec took the output buffer back without it being released
+  void InvalidateOutputBuffer() { m_bufferId = -1; }
   // SurfaceTexture released
   int GetBufferId() const;
   int GetTextureId() const;
@@ -93,6 +95,9 @@ public:
   std::shared_ptr<CJNIMediaCodec> GetMediaCodec();
   void ResetMediaCodec();
   void ReleaseMediaCodecBuffers();
+  void InvalidateMediaCodecBuffers();
+  // Held while an output buffer is released and while MediaCodec is flushed
+  CCriticalSection& GetCriticalSection() { return m_criticalSection; }
 
 private:
   CCriticalSection m_criticalSection;
-- 
