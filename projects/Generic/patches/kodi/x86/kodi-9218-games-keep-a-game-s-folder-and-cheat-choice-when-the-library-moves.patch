From 7114ec0c30c969e98323480fdf5d727385242caf Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Mon, 12 Oct 2026 08:20:33 +0100
Subject: [PATCH] [games] Keep a game's folder and cheat choice when the
 library moves

The key took the last parts of the whole URL, so a game near the top of
a share keyed on the server name, and a game in an archive on the
archive's full location. It now takes only path parts, continuing an
archive's path with the archive's own location.

The saved cheat-pack choice was also ignored after a move, because it
checked the game's full path. Being in the game's folder already ties it
to the game.
---
 xbmc/games/GameUtils.cpp                      | 20 ++++++++++++++++---
 xbmc/games/addons/cheats/GameClientCheats.cpp |  2 +-
 xbmc/games/test/TestGameUtils.cpp             |  9 +++++++++
 3 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/xbmc/games/GameUtils.cpp b/xbmc/games/GameUtils.cpp
index 77b5a1d..3399665 100644
--- a/xbmc/games/GameUtils.cpp
+++ b/xbmc/games/GameUtils.cpp
@@ -58,6 +58,21 @@ constexpr auto GAMES_FOLDER = "special://profile/games";
 constexpr size_t MAX_NAME_BYTES = 200;
 // The file name and the two folders above it
 constexpr size_t KEY_PARTS = 3;
+
+// The folders and file name of a location, without its protocol or server.
+// A game in an archive continues the path of the archive's own location.
+void AddPathParts(const CURL& url, std::vector<std::string>& parts)
+{
+  if (url.HasParentInHostname())
+    AddPathParts(CURL(url.GetHostName()), parts);
+
+  constexpr std::array<std::string_view, 2> separators{"/", "\\"};
+  for (std::string& part : StringUtils::Split(url.GetFileName(), separators))
+  {
+    if (!part.empty())
+      parts.emplace_back(std::move(part));
+  }
+}
 } // namespace
 
 // Initialize static state
@@ -487,9 +502,8 @@ std::string CGameUtils::GetGameFolder(const std::string& gamePath)
 
   // Enough of the path to tell PS1/Worms (USA)/Worms (USA).cue from
   // Dreamcast/Worms (USA)/Worms (USA).cue, but not the drive or share above it
-  constexpr std::array<std::string_view, 2> separators{"/", "\\"};
-  std::vector<std::string> parts = StringUtils::Split(path, separators);
-  std::erase(parts, "");
+  std::vector<std::string> parts;
+  AddPathParts(url, parts);
   const std::span<const std::string> key = std::span(parts).last(std::min(parts.size(), KEY_PARTS));
 
   return URIUtils::AddFileToFolder(
diff --git a/xbmc/games/addons/cheats/GameClientCheats.cpp b/xbmc/games/addons/cheats/GameClientCheats.cpp
index 6fec643..30ea7ef 100644
--- a/xbmc/games/addons/cheats/GameClientCheats.cpp
+++ b/xbmc/games/addons/cheats/GameClientCheats.cpp
@@ -587,7 +587,7 @@ std::string CGameClientCheats::ReadChoice(const std::string& gamePath) const
   if (xml.LoadFile(GetSelectionPath(gamePath)))
   {
     const auto* root = xml.FirstChildElement("cheatpack");
-    if (root && root->Attribute("game", gamePath.c_str()))
+    if (root)
     {
       if (const char* candidate = root->Attribute("candidate"))
         return candidate;
diff --git a/xbmc/games/test/TestGameUtils.cpp b/xbmc/games/test/TestGameUtils.cpp
index cfb7d67..ef172a3 100644
--- a/xbmc/games/test/TestGameUtils.cpp
+++ b/xbmc/games/test/TestGameUtils.cpp
@@ -47,6 +47,15 @@ TEST(TestGameUtils, AGameKeepsItsFolderWhenTheLibraryMoves)
   EXPECT_EQ(folder, CGameUtils::GetGameFolder("D:\\Games\\PS1\\Worms (USA)\\Worms (USA).cue"));
   EXPECT_NE(folder,
             CGameUtils::GetGameFolder("/media/disk1/Games/Dreamcast/Worms (USA)/Worms (USA).cue"));
+
+  EXPECT_EQ(CGameUtils::GetGameFolder("smb://nas1/Roms/Sonic.md"),
+            CGameUtils::GetGameFolder("smb://nas2/Roms/Sonic.md"));
+
+  const std::string zipped =
+      CGameUtils::GetGameFolder("zip://%2fmedia%2fdisk1%2fGames%2fSNES%2fMario.zip/Mario.sfc");
+  EXPECT_EQ(zipped,
+            CGameUtils::GetGameFolder("zip://smb%3a%2f%2fnas%2fRoms%2fSNES%2fMario.zip/Mario.sfc"));
+  EXPECT_EQ(URIUtils::GetFileName(zipped).substr(0, 10), "Mario.sfc_");
 }
 
 TEST(TestGameUtils, ALongNameStaysWithinTheFileSystemLimit)
