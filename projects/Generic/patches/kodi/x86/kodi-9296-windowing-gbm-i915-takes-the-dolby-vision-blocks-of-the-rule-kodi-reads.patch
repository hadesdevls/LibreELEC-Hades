From b5c3ea502c382bb1d6a8f0e1ba5582677627f5ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 23:17:22 +0000
Subject: [PATCH] windowing/gbm: i915 takes the Dolby Vision blocks of the rule
 Kodi reads

CDisplayInfo reads the Dolby Vision block of the display with the rule
of the amdgpu backend (version 2 with the Standard interface, or the
12-byte version 1 block with low latency 1 and display management 4 or
later, in an EDID that an HDMI Forum EEODB may extend). i915 took the
12-byte version 2 block only, in an EDID without an EEODB, and Kodi
told such a display that "the driver's Dolby Vision backend takes
12-byte version 2 Dolby Vision blocks only" (driveredid) before asking
the driver.

linux-9965 makes i915 take the same blocks, with the same answer for
2160p60 (a host test compares the three copies of the rule, Kodi's
ScanDolbyVideo() among them, on every form of one block and on two
million mutations of valid EDIDs). The check of Kodi for i915 goes, and
with it what only it used: m_dvKernelAmdgpu,
StandardDolbyVisionBlockIs12Bytes(), EdidExtendedByEEODB() and the
eeodb field of DolbyVideoBlock. A refusal of the driver for the EDID is
still told as driveredid, from DVBRIDGE_REFUSED
(DVBRIDGE::REFUSED::Code()).
---
 xbmc/utils/DisplayInfo.cpp          |  6 +++---
 xbmc/utils/DisplayInfo.h            | 18 +++++-------------
 xbmc/windowing/gbm/WinSystemGbm.cpp | 21 +++------------------
 xbmc/windowing/gbm/WinSystemGbm.h   |  4 ----
 4 files changed, 11 insertions(+), 38 deletions(-)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 8121f6b..0a17669 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -26,8 +26,9 @@ using namespace UTILS;
 
 namespace
 {
-// The Dolby VSVDB, read from the raw EDID with the rule of the amdgpu kernel backend
-// (amdgpu_dm_dvbridge_edid_standard) so that Kodi and the kernel take the same displays: valid
+// The Dolby VSVDB, read from the raw EDID with the rule of the kernel backends (amdgpu's
+// amdgpu_dm_dvbridge_edid_standard() and, since linux-9965, i915's intel_dv_lab_edid(), which a
+// host test compares with this function) so that Kodi and the kernel take the same displays: valid
 // blocks (an HDMI Forum EEODB may make the EDID longer than its extension count) and exactly one
 // Dolby VSVDB. libdisplay-info gives neither the length of a version 1 block nor its whole
 // low-latency field, and stops at the extension count.
@@ -44,7 +45,6 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       !std::equal(std::begin(magic), std::end(magic), edid.begin()))
     return {};
   DolbyVideoBlock result;
-  result.eeodb = size > (edid[126] + 1u) * 128;
   unsigned int found = 0;
   for (size_t block = 0; block < size / 128; ++block)
   {
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 3facebb..f326cf8 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -63,7 +63,6 @@ struct DolbyVideoBlock
   unsigned int dmVersion = 0; //!< display management version (version 1 and 2 blocks)
   bool standard = false; //!< Dolby Vision Standard with the Dolby vendor InfoFrame
   bool at2160p60 = false;
-  bool eeodb = false; //!< the EDID is longer than its extension count (HDMI Forum EEODB)
 };
 
 class CDisplayInfo
@@ -79,24 +78,17 @@ public:
   bool SupportsEOTF(Eotf eotf) const;
 
   bool SupportsDolbyVision() const { return m_dolbyVision; }
-  //! Dolby Vision Standard (TV-led) with the Dolby vendor InfoFrame, by the rule of the amdgpu
-  //! kernel backend: exactly one Dolby VSVDB in valid EDID blocks, of version 2 with the Standard
-  //! interface, or of version 1 in its 12-byte form with the low-latency field 1 and display
-  //! management version 4 or later (the metadata sent is the one of that version).
+  //! Dolby Vision Standard (TV-led) with the Dolby vendor InfoFrame, by the rule of the kernel
+  //! backends (amdgpu, and i915/xe since linux-9965: the same one): exactly one Dolby VSVDB in
+  //! valid EDID blocks, of version 2 with the Standard interface, or of version 1 in its 12-byte
+  //! form with the low-latency field 1 and display management version 4 or later (the metadata
+  //! sent is the one of that version).
   bool SupportsStandardDolbyVision() const { return m_dolbyVideo.standard; }
   //! The version of the block that advertises Dolby Vision Standard: 1 or 2, 0 without it.
   unsigned int StandardDolbyVisionVersion() const
   {
     return m_dolbyVideo.standard ? m_dolbyVideo.version : 0;
   }
-  //! Dolby Vision Standard from a 12-byte block (the only form the i915/xe backend takes).
-  bool StandardDolbyVisionBlockIs12Bytes() const
-  {
-    return m_dolbyVideo.standard && m_dolbyVideo.length == 11;
-  }
-  //! The EDID is longer than its base block's extension count (an HDMI Forum EEODB), which the
-  //! i915/xe backend does not take.
-  bool EdidExtendedByEEODB() const { return m_dolbyVideo.eeodb; }
   //! The EDID has a Dolby Vision block that the rule above does not read: in an EDID block that is
   //! not valid, or with several Dolby Vision blocks.
   bool DolbyVisionBlockInvalid() const { return m_dolbyVision && !m_dolbyVideo.valid; }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0680150..2be254c 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -206,14 +206,7 @@ bool CWinSystemGbm::InitWindowSystem()
 
 #ifdef HAVE_DVBRIDGE
   if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
-  {
     CDVBridgeState::ClearLeftover(*drm);
-    if (drmVersionPtr version = drmGetVersion(drm->GetFileDescriptor()))
-    {
-      m_dvKernelAmdgpu = strcmp(version->name, "amdgpu") == 0;
-      drmFreeVersion(version);
-    }
-  }
 #endif
 
   CDRMConnector* connector = m_DRM->GetConnector();
@@ -255,7 +248,6 @@ bool CWinSystemGbm::InitWindowSystem()
       m_displayEdid.clear();
       m_dvInfo.reset();
       m_dvDisplaySeen = false;
-      m_dvKernelAmdgpu = false;
 #endif
       // This function and no override of it: the caller (InitWindowSystemEGL() of the class that
       // was started) goes on with EGL when this returns, once.
@@ -1062,8 +1054,6 @@ auto DVCapabilities(const KODI::UTILS::CDisplayInfo* info)
   return std::make_tuple(info != nullptr, info && info->SupportsDolbyVision(),
                          info && info->SupportsStandardDolbyVision(),
                          info ? info->StandardDolbyVisionVersion() : 0u,
-                         info && info->StandardDolbyVisionBlockIs12Bytes(),
-                         info && info->EdidExtendedByEEODB(),
                          info && info->SupportsStandardDolbyVision2160p60(),
                          info && info->SupportsRGBQuantizationSelection());
 }
@@ -1142,14 +1132,9 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
     code = "output";
     reason = "the output driver has no Dolby Vision backend";
   }
-  else if (backend == CDVBridgeState::Backend::KERNEL && !m_dvKernelAmdgpu &&
-           (info->StandardDolbyVisionVersion() != 2 || !info->StandardDolbyVisionBlockIs12Bytes() ||
-            info->EdidExtendedByEEODB()))
-  {
-    code = "driveredid";
-    reason = "the driver's Dolby Vision backend takes 12-byte version 2 Dolby Vision blocks only, "
-             "in an EDID without an extension override (EEODB)";
-  }
+  // (Hades: i915/xe take the Dolby Vision blocks of the rule of SupportsStandardDolbyVision() since
+  // linux-9965, as amdgpu does: no more "driveredid" here for them. The code still comes from
+  // the driver when it refuses for its EDID: DVBRIDGE::REFUSED::Code().)
   else if (backend == CDVBridgeState::Backend::NVIDIA &&
            !info->SupportsRGBQuantizationSelection())
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 1cc9898..04f93e0 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -306,10 +306,6 @@ protected:
   std::atomic<unsigned int> m_dvDisplayGeneration{0};
   //! The m_dvDisplayGeneration the Low-Latency notification was shown for, none yet
   std::atomic<unsigned int> m_dvLowLatencyTold{~0u};
-  //! The kernel Dolby Vision backend is amdgpu's, which takes the displays of the rule of
-  //! CDisplayInfo::SupportsStandardDolbyVision(); the i915/xe one takes 12-byte version 2 blocks
-  //! only, in an EDID without an extension override.
-  bool m_dvKernelAmdgpu{false};
 #endif
   XbmcThreads::EndTime<> m_dispResetTimer;
   std::unique_ptr<CLibInputHandler> m_libinput;
-- 
