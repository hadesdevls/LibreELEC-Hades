From d564e3f3e0cc5983572b35c74b495f3374f48a80 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:22:30 +0000
Subject: [PATCH] windowing/gbm: what the display says of 3D is kept for the
 threads that ask, and follows its EDID

Two readers went to the connector where that is not safe, or not true.

GetStereoOutputArrangement() runs on a thread of the player whenever a
side-by-side picture is applied, on any display, and walked the
connector's list of modes. The thread that sets modes replaces that list
when it finds the display disconnected (CDRMConnector::CheckConnector()):
a walk in that instant reads freed memory.

On nvidia-drm, the half layouts that are told by the vendor InfoFrame
were looked up in the EDID, read through the number of the blob that the
connector learnt when Kodi started. The kernel gives the EDID a new blob
each time the display is read again, and Kodi reads a display that has
Dolby Vision again when a video starts. From the second video on the
number named nothing, or something else: no half layout was offered, and
the log said that the display had no 3D mode. The same number was used
when the resolutions are made again for the Monitor setting.

Now the modes are copied where the resolutions are made of them, and the
3D part of the EDID is read from the bytes that Kodi has: when it starts
on the display, and whenever CheckDisplayChange() finds that EDID
changed. Both are kept under the lock of the display information. A
thread other than the one that sets modes uses the copies. That one uses
them too, and takes no 3D mode at all where the connector's list is no
longer the one the resolutions were made of: a mode is set by its place
in that list.

HasStereoDisplay() follows them: what the display said when Kodi started
on it or, for a display with Dolby Vision, when a video last started.

Not run on a GPU.
---
 xbmc/windowing/WinSystem.h          |  7 +--
 xbmc/windowing/gbm/WinSystemGbm.cpp | 69 ++++++++++++++++++++++-------
 xbmc/windowing/gbm/WinSystemGbm.h   | 11 ++++-
 xbmc/windowing/gbm/drm/DRMStereo.h  |  2 +
 4 files changed, 68 insertions(+), 21 deletions(-)

diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index 247c7b9..06a9037 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -247,9 +247,10 @@ public:
   /*!
    * \brief Hades: whether the display says that it takes stereoscopic 3D
    *
-   * What it said when Kodi started on it, as with what it says of HDR. Asked, from any thread,
-   * by what decides when a video is opened whether the second view of a video of two views is
-   * decoded (KODI::MULTIVIEW::Allowed()).
+   * What it said when Kodi started on it, as with what it says of HDR; where the window system
+   * looks at a display again later (GBM: at one with Dolby Vision, when a video starts), what
+   * it said then. Asked, from any thread, by what decides when a video is opened whether the
+   * second view of a video of two views is decoded (KODI::MULTIVIEW::Allowed()).
    */
   virtual bool HasStereoDisplay() { return false; }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 54efef2..b2f3a4d 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -228,6 +228,8 @@ bool CWinSystemGbm::InitWindowSystem()
     m_dvInfo = m_info;
     m_dvDisplaySeen = m_info && m_info->SupportsDolbyVision();
 #endif
+    // Hades: ... and what it says of stereoscopic 3D (see m_stereoEdid)
+    SetStereoEdid(edid);
   }
 
   if (!m_GBM->CreateDevice(m_DRM->GetFileDescriptor()))
@@ -246,6 +248,7 @@ bool CWinSystemGbm::InitWindowSystem()
       // another display, or one whose EDID cannot be read
       m_info.reset();
       m_limitedInputPending = false;
+      SetStereoEdid({});
 #ifdef HAVE_DVBRIDGE
       m_displayEdid.clear();
       m_dvInfo.reset();
@@ -350,11 +353,17 @@ void CWinSystemGbm::UpdateResolutions()
 
   // Hades: whether the display says that it takes stereoscopic 3D: the driver lists a mode of
   // it with a 3D layout or, for a driver that lists none, its EDID has 3D in the HDMI vendor
-  // block. Kept as it is found here, when Kodi starts on the display.
+  // block. The modes are kept as they are here, where the resolutions are made of them, for
+  // the threads that ask (see m_stereoModes). The EDID is the one that Kodi has of the
+  // display: it is not read again here, where the connector may know it by a number that the
+  // kernel has since given to something else.
   bool stereoDisplay = false;
-  if (CDRMConnector* connector = m_DRM->GetConnector())
-    stereoDisplay =
-        STEREO::TakesStereo(m_DRM->GetStereoModes(), STEREO::Parse(connector->GetEDID()));
+  {
+    std::vector<STEREO::Mode> modes = m_DRM->GetStereoModes();
+    std::unique_lock lock(m_infoLock);
+    m_stereoModes = std::move(modes);
+    stereoDisplay = STEREO::TakesStereo(m_stereoModes, m_stereoEdid);
+  }
   m_stereoDisplay = stereoDisplay;
   CLog::Log(LOGINFO, "3D output: the display {} that it takes stereoscopic 3D",
             stereoDisplay ? "says" : "does not say");
@@ -434,6 +443,16 @@ STEREO::Arrangement ArrangementOf(RenderStereoMode mode)
 }
 } // namespace
 
+bool CWinSystemGbm::SetStereoEdid(std::span<const uint8_t> edid)
+{
+  STEREO::Edid3D read = STEREO::Parse(edid);
+
+  std::unique_lock lock(m_infoLock);
+  m_stereoEdid = std::move(read);
+  const bool takes = STEREO::TakesStereo(m_stereoModes, m_stereoEdid);
+  return m_stereoDisplay.exchange(takes) != takes;
+}
+
 bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
                                     STEREO::Allowed& allowed,
                                     const char*& reason,
@@ -459,7 +478,24 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
     return false;
   }
 
-  const std::vector<STEREO::Mode> modes = m_DRM->GetStereoModes();
+  // The modes of the display and what its EDID says of 3D, as they are kept for any thread:
+  // another thread does not read the connector, which the thread that sets modes reads again
+  // (and replaces) when it finds the display disconnected.
+  std::vector<STEREO::Mode> modes;
+  STEREO::Edid3D edid;
+  {
+    std::unique_lock lock(m_infoLock);
+    modes = m_stereoModes;
+    edid = m_stereoEdid;
+  }
+  // A mode is set by its place in the list of the connector as that is now. Where it is no
+  // longer the list that the resolutions were made of (the display was read again, and has
+  // other modes), no place in it is taken for a 3D mode.
+  if (drawing && modes != m_DRM->GetStereoModes())
+  {
+    reason = "the modes of the display are no longer those that the resolutions were made of";
+    return false;
+  }
   offers = STEREO::Offers(modes);
   allowed.framePacking = !m_stereoRefusedFramePacking;
   allowed.halfModes = !m_stereoRefusedHalfModes;
@@ -471,21 +507,16 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
   // takes in that layout, where the driver lists no mode for it. (Not looked up for the
   // question of another thread, which is about frame packing.)
   CDRMConnector* connector = m_DRM->GetConnector();
-  if (drawing && allowed.infoFrame && connector->GetType() == "HDMI-A" &&
+  if (drawing && allowed.infoFrame && edid.read && connector->GetType() == "HDMI-A" &&
       connector->SupportsProperty("NV_HDMI_VSIF_METADATA"))
   {
-    const std::vector<uint8_t> raw = connector->GetEDID();
-    const STEREO::Edid3D edid = STEREO::Parse(raw);
-    if (edid.read)
+    for (STEREO::Offer& offer : offers)
     {
-      for (STEREO::Offer& offer : offers)
-      {
-        const uint8_t vic = STEREO::VicOf(modes[offer.base]);
-        offer.infoFrameTopAndBottom =
-            offer.topAndBottom < 0 && STEREO::Supports(edid, vic, STEREO::Layout::TOP_AND_BOTTOM);
-        offer.infoFrameSideBySide =
-            offer.sideBySide < 0 && STEREO::Supports(edid, vic, STEREO::Layout::SIDE_BY_SIDE_HALF);
-      }
+      const uint8_t vic = STEREO::VicOf(modes[offer.base]);
+      offer.infoFrameTopAndBottom =
+          offer.topAndBottom < 0 && STEREO::Supports(edid, vic, STEREO::Layout::TOP_AND_BOTTOM);
+      offer.infoFrameSideBySide =
+          offer.sideBySide < 0 && STEREO::Supports(edid, vic, STEREO::Layout::SIDE_BY_SIDE_HALF);
     }
   }
   return true;
@@ -1164,6 +1195,10 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
     std::unique_lock lock(m_infoLock);
     m_dvInfo = changed;
   }
+  // Hades: ... and what the display now says of stereoscopic 3D
+  if (SetStereoEdid(edid))
+    CLog::Log(LOGINFO, "3D output: the display now {} that it takes stereoscopic 3D",
+              m_stereoDisplay ? "says" : "does not say");
   // Only a change of what native output depends on counts (not, for example, the audio formats of
   // a sound bar behind the TV); it also allows the Low-Latency notification again.
   const bool dvChanged = DVCapabilities(info.get()) != DVCapabilities(changed.get());
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index ede17a3..e9cb00b 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -283,7 +283,16 @@ private:
   int m_stereoLeaveTries{0}; //!< times in a row that a 3D mode stayed when a 2D one was set
   std::string m_stereoStatus; //!< see TellStereoOutput()
   std::atomic<bool> m_stereoArrangementTold{false};
-  //! What the display said of 3D when Kodi started on it (UpdateResolutions())
+  //! What the display says of 3D, under m_infoLock (other threads ask): the modes of its
+  //! connector as they were when the resolutions were made of them (UpdateResolutions(): the
+  //! place of a mode among them is the strId of its resolution), and the 3D part of its
+  //! EDID, read when Kodi started on the display and again whenever that EDID is found
+  //! changed (CheckDisplayChange(), which looks only at a display that has Dolby Vision).
+  std::vector<STEREO::Mode> m_stereoModes;
+  STEREO::Edid3D m_stereoEdid;
+  //! \return whether what follows from it (m_stereoDisplay) changed
+  bool SetStereoEdid(std::span<const uint8_t> edid);
+  //! Whether those say that the display takes stereoscopic 3D (STEREO::TakesStereo())
   std::atomic<bool> m_stereoDisplay{false};
 
   CDRMPropertyBlob m_hdrBlob;
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index ced7cf0..744e43f 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -116,6 +116,8 @@ struct Mode
   uint16_t vtotal{0};
   uint16_t vscan{0};
   uint32_t flags{0};
+
+  bool operator==(const Mode&) const = default;
 };
 
 /*!
