From 2ef708d49de249d3e6ae034d194b521093b37a4d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:20:49 +0000
Subject: [PATCH] estuary: "Restart LibreELEC Hades" in the power menu

Quit() is hidden on LibreELEC (System.ShowExitButton), so the only way to restart the
application, for instance after changing a setting that asks for it, was to reboot
the whole PC. RestartApp() is Kodi's own builtin: it ends the application with the
restart exit code, which kodi.sh turns into 0 and systemd restarts. Reported in the
forum by testmest.
---
 addons/skin.estuary/xml/DialogButtonMenu.xml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/addons/skin.estuary/xml/DialogButtonMenu.xml b/addons/skin.estuary/xml/DialogButtonMenu.xml
index a028333..2ce50b7 100644
--- a/addons/skin.estuary/xml/DialogButtonMenu.xml
+++ b/addons/skin.estuary/xml/DialogButtonMenu.xml
@@ -55,6 +55,11 @@
 						<onclick>Reset()</onclick>
 						<visible>System.CanReboot</visible>
 					</item>
+					<item>
+						<label>$LOCALIZE[32501]</label>
+						<onclick>RestartApp()</onclick>
+						<visible>System.Platform.Linux</visible>
+					</item>
 					<item>
 						<label>$LOCALIZE[20126] $INFO[system.profilename]</label>
 						<onclick>dialog.close(all,true)</onclick>
-- 
2.53.0

