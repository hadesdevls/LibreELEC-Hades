diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 9cc5396..c9f3c8e 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1476,7 +1476,17 @@ bool CVideoPlayer::ReadPacket(DemuxPacket*& packet, CDemuxStream*& stream)
 
   // read a data frame from stream.
   if (m_pDemuxer)
+  {
+    // Hades: a read that waits for its source (a network stream that stopped sending) keeps this
+    // thread inside it: meanwhile the input calls OnInputWait(), which does what this loop would
+    // have done while the players run dry (CFileCache, IOControl::READ_WAIT)
+    if (m_pInputStream)
+      m_pInputStream->SetReadWait(&m_inputWaitFn);
     packet = m_pDemuxer->Read();
+    if (m_pInputStream)
+      m_pInputStream->SetReadWait(nullptr);
+    InputWaitEnded();
+  }
 
   if (packet)
   {
@@ -2162,6 +2172,22 @@ void CVideoPlayer::Process()
         continue;
       }
 
+      // Hades: the input did not end, its source was given up on before the end of the file (no
+      // data for minutes, or a server that refuses the file): playback ends with an error, which
+      // keeps the position, and not as if the whole video had been played
+      if (m_pInputStream->SourceFailed())
+      {
+        m_error = true;
+        CLog::Log(LOGERROR,
+                  "VideoPlayer: the source of the video was given up on before its end, at {} ms: "
+                  "playback ends with an error and the position is kept",
+                  static_cast<int64_t>(GetTime()));
+        CGUIDialogKaiToast::QueueNotification(
+            CGUIDialogKaiToast::Error, CGUIUtils::GetHadesString(39888, 31616),
+            CGUIUtils::GetHadesString(39953, 31618), 15000);
+        break;
+      }
+
       if (!m_pInputStream->IsEOF())
         CLog::Log(LOGINFO, "{} - eof reading from demuxer", __FUNCTION__);
 
@@ -2529,6 +2555,65 @@ bool CVideoPlayer::ShouldDeferSync(bool ready, std::chrono::steady_clock::time_p
   return true;
 }
 
+void CVideoPlayer::OnInputWait(std::chrono::milliseconds waited)
+{
+  // Hades: called by the input on this thread, inside m_pDemuxer->Read(), while a read waits for a
+  // source that stopped sending (CFileCache, IOControl::READ_WAIT). Only what HandlePlaySpeed()
+  // does when the players run dry: the clock stops and the player buffers, which the GUI shows;
+  // nothing that seeks, flushes or reads. Messages (a seek, a pause) wait for the read to return; a
+  // stop ends the read at once (IOControl::READ_ABORT).
+  if (m_bAbortRequest)
+    return;
+  m_inputWait.active = true;
+  m_inputWait.waited = waited;
+
+  const bool tolerateStall =
+      IsInMenuInternal() || (m_CurrentVideo.hint.flags & StreamFlags::FLAG_STILL_IMAGES);
+  if (m_caching == CACHESTATE_DONE && m_playSpeed == DVD_PLAYSPEED_NORMAL && !tolerateStall &&
+      !m_pInputStream->IsRealtime() &&
+      ((m_VideoPlayerAudio->IsStalled() && m_CurrentAudio.inited) ||
+       (m_VideoPlayerVideo->IsStalled() && m_CurrentVideo.inited)) &&
+      m_syncTimer.IsTimePast() && m_VideoPlayerAudio->GetLevel() <= 50 &&
+      m_processInfo->GetLevelVQ() <= 50)
+  {
+    SetCaching(CACHESTATE_FULL);
+    m_inputWait.paused = true;
+    CLog::Log(LOGINFO,
+              "VideoPlayer: the input waits for its source ({} ms so far) and the players ran "
+              "dry: playback waits for it as while buffering, at {} ms",
+              waited.count(), static_cast<int64_t>(DVD_TIME_TO_MSEC(m_clock.GetClock())));
+  }
+  if (m_caching != CACHESTATE_FULL && m_caching != CACHESTATE_INIT)
+    return;
+
+  // the state of the GUI (caching), which this loop would have updated
+  UpdatePlayState(500);
+  // what the wait is, on any skin: after 5 s without data, and again every 30 s
+  if (waited >= 5s && (!m_inputWait.toldAt || waited - *m_inputWait.toldAt >= 30s))
+  {
+    m_inputWait.toldAt = waited;
+    CGUIDialogKaiToast::QueueNotification(
+        CGUIDialogKaiToast::Info, CGUIUtils::GetHadesString(39888, 31616),
+        StringUtils::Format(CGUIUtils::GetHadesString(39889, 31617),
+                            static_cast<int64_t>(waited.count() / 1000)),
+        8000, false);
+  }
+}
+
+void CVideoPlayer::InputWaitEnded()
+{
+  // Hades: after a read of a packet (ReadPacket())
+  if (!m_inputWait.active)
+    return;
+  if (m_inputWait.waited >= 1s)
+    CLog::Log(LOGINFO, "VideoPlayer: the input waited {} ms for its source{}",
+              m_inputWait.waited.count(),
+              m_bAbortRequest      ? " (the player closes)"
+              : m_inputWait.paused ? "; playback goes on once the buffers have filled again"
+                                   : "");
+  m_inputWait = InputWaitState{};
+}
+
 void CVideoPlayer::HandlePlaySpeed()
 {
   const bool isInMenu = IsInMenuInternal();
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index bb902a1..519d472 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -513,6 +513,15 @@ protected:
 
   void HandleMessages();
   void HandlePlaySpeed();
+  /*!
+   * \brief Hades: called by the input on this thread while a read of a packet waits for a source
+   *        that stopped sending (IOControl::READ_WAIT), with how long it has waited: when the
+   *        players have run dry, the player buffers (the clock stops) as HandlePlaySpeed() would,
+   *        and says so on screen
+   */
+  void OnInputWait(std::chrono::milliseconds waited);
+  //! Hades: after the read of a packet: the end of such a wait, in the log
+  void InputWaitEnded();
   bool IsInMenuInternal() const;
   void SynchronizeDemuxer();
   bool IsNearStreamEnd(std::chrono::milliseconds time) const;
@@ -785,6 +794,17 @@ protected:
 
   std::optional<std::chrono::steady_clock::time_point> m_syncStartPtsWait;
 
+  //! Hades: OnInputWait(), given to the input around the reads of packets (ReadPacket())
+  const std::function<void(std::chrono::milliseconds)> m_inputWaitFn{
+      [this](std::chrono::milliseconds waited) { OnInputWait(waited); }};
+  struct InputWaitState
+  {
+    bool active{false}; // a read waits, or waited, for its source
+    bool paused{false}; // and the player stopped its clock for it
+    std::chrono::milliseconds waited{0};
+    std::optional<std::chrono::milliseconds> toldAt; // the notification, last at this wait
+  } m_inputWait;
+
   CEdl m_Edl;
   bool m_SkipCommercials;
 
