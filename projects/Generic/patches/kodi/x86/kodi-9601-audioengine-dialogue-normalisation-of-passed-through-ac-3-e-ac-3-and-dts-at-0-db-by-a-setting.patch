new file mode 100644
index 0000000..41cffe6
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
@@ -0,0 +1,717 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: the dialogue normalisation of a stream that is passed through, sent as "no attenuation"
+// (setting audiooutput.hadesdialnorm, off by default). A receiver lowers the sound by what the
+// stream's dialogue normalisation says (AC-3 dialnorm -27 dB: 4 dB lower). With the setting on,
+// the field says 0 dB of attenuation and nothing else of the frame changes. It departs from what
+// the stream asks for, so it is a choice of the user, explained where it is set.
+//
+// What is rewritten, and how (the clauses are of the documents named):
+//
+// - AC-3 (bsid 0 to 10): dialnorm, and dialnorm2 of a 1+1 stream, to code 31 (-31 dB, which a
+//   receiver reproduces as it is: ATSC A/52 5.4.2.8 and 7.6; code 0 is reserved). The field is in
+//   the first 5/8 of the syncframe, so crc1 is computed again (A/52 5.4.1.2 and 7.10.1: the CRC of
+//   the first 5/8, syncword excluded, is 0); crc2 covers the rest and does not change.
+// - E-AC-3 (bsid 11 to 16): dialnorm (and dialnorm2 of 1+1) of every substream, independent and
+//   dependent, to 31; crc2 computed again over the whole syncframe (A/52 Annex E), and when it would
+//   equal the syncword, crcrsv/encinfo flipped with it, as an encoder does (A/52 5.4.6.2).
+//   Not rewritten: a stream whose additional bit stream information says "extension type A" (Dolby
+//   Atmos by joint object coding: the flag FFmpeg's decoder reads for its Atmos profile,
+//   ac3_parser.c), or that carries object audio metadata (OAMD, AudioPresentation.h): its objects
+//   come with metadata that changing the frame could break. The player also tells it when its
+//   demuxer says the profile is Atmos (CDialnormOverride::SetAtmos()).
+// - DTS core (16-bit big-endian words, sync 0x7FFE8001): DIALNORM to 0 when VERNUM is 7, which is
+//   a dialogue normalisation gain of 0 dB (ETSI TS 102 114 V1.6.1, 5.4.2, table 5-20). No CRC
+//   protects it: the header CRC (HCRC) "shall not be applied" (5.4.2), and a frame that has one
+//   (CPF = 1) is still left as it came. Not rewritten: VERNUM 6 (its DIALNORM says -16 dB at
+//   least: 0 dB would need another version number), other VERNUM (the field means nothing there),
+//   and a frame whose Rev2 auxiliary data chunk carries the dialogue normalisation (5.8.3: it takes
+//   priority, and it has its own CRC). Nothing of DTS-HD's extension substream is touched: its
+//   headers, CRCs and lossless data stay byte for byte as they came.
+// - TrueHD: nothing. Its dialogue norm (16ch_dialogue_norm) has no public description.
+//
+// Every frame that is rewritten is checked again afterwards (its CRCs, read the way a decoder
+// reads them); if anything does not check, the frame gets its original bytes back. A frame that
+// fails its own CRC as it comes is never touched: a valid CRC on corrupted data would make a
+// receiver play it instead of concealing it.
+
+#include "AudioPresentation.h"
+
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace KODI::AE::DIALNORM
+{
+
+enum class Codec
+{
+  NONE,
+  AC3,
+  EAC3,
+  DTS
+};
+
+//! Why a frame was left as it came
+enum class Skip
+{
+  NONE,
+  NOT_A_FRAME, //!< no syncframe of these codecs at the start, or bytes that are not one after it
+  BAD_CRC, //!< a syncframe that fails its own CRC
+  ATMOS, //!< E-AC-3 with Dolby Atmos (joint object coding, or object audio metadata)
+  DTS_FORM, //!< DTS that is not a core frame of 16-bit big-endian words (14-bit, little-endian,
+            //!< or DTS-HD without a core)
+  DTS_HEADER_CRC, //!< DTS core with a header CRC (CPF = 1)
+  DTS_VERSION_6, //!< DTS core with VERNUM 6: its field cannot say 0 dB
+  DTS_NO_DIALNORM, //!< DTS core with a VERNUM other than 6 and 7: the field says nothing
+  DTS_REV2AUX, //!< DTS core whose dialogue normalisation is in its Rev2 auxiliary data chunk
+  CHECK_FAILED, //!< the rewritten frame did not check: its original bytes are back
+};
+
+struct SResult
+{
+  Codec codec = Codec::NONE;
+  Skip skip = Skip::NONE;
+  bool changed = false; //!< bytes were rewritten
+  //! The attenuation the stream asked for, in dB, of its first syncframe (0 to 31); 0 also for
+  //! AC-3's reserved code 0, which FFmpeg's decoder reproduces as -31 dB
+  int attenuation = 0;
+  bool reservedCode = false; //!< AC-3/E-AC-3 dialnorm code 0
+  int dialogueLevel = 0; //!< AC-3/E-AC-3: the dialogue level the stream gave, in dB (-1 to -31)
+  int syncframes = 0; //!< syncframes rewritten
+};
+
+namespace DETAIL
+{
+using KODI::AE::PRESENTATION::DETAIL::CBits;
+using KODI::AE::PRESENTATION::DETAIL::CrcAC3;
+
+//! Writes n bits (most significant first) at bit pos of data
+inline void WriteBits(uint8_t* data, size_t pos, unsigned int n, uint32_t value)
+{
+  for (unsigned int i = 0; i < n; ++i, ++pos)
+  {
+    const uint8_t mask = static_cast<uint8_t>(0x80 >> (pos & 7));
+    if ((value >> (n - 1 - i)) & 1)
+      data[pos >> 3] |= mask;
+    else
+      data[pos >> 3] &= static_cast<uint8_t>(~mask);
+  }
+}
+
+inline uint32_t ReadBits(const uint8_t* data, size_t bytes, size_t pos, unsigned int n)
+{
+  CBits bits(data, bytes, pos);
+  return bits.Read(n);
+}
+
+//! Arithmetic modulo the AC-3 CRC polynomial P = x^16 + x^15 + x^2 + 1, polynomials as bits
+constexpr uint32_t CRC_POLY = 0x18005;
+//! x^-1 mod P: x * (x^15 + x^14 + x) = x^16 + x^15 + x^2 = 1 mod P
+constexpr uint16_t X_INVERSE = 0xC002;
+
+inline uint16_t MulMod(uint16_t a, uint16_t b)
+{
+  uint32_t r = 0;
+  for (int i = 15; i >= 0; --i)
+  {
+    r <<= 1;
+    if (r & 0x10000)
+      r ^= CRC_POLY;
+    if (b & (1u << i))
+      r ^= a;
+  }
+  return static_cast<uint16_t>(r);
+}
+
+inline uint16_t PowMod(uint16_t base, uint64_t exponent)
+{
+  uint16_t result = 1;
+  while (exponent)
+  {
+    if (exponent & 1)
+      result = MulMod(result, base);
+    base = MulMod(base, base);
+    exponent >>= 1;
+  }
+  return result;
+}
+
+//! The bytes of the first 5/8 of an AC-3 syncframe of bytes (A/52 7.10.1: 5/8 of its 16-bit
+//! words, rounded down, as FFmpeg's encoder computes it)
+inline size_t AC3FiveEighths(size_t bytes)
+{
+  return ((bytes >> 2) + (bytes >> 4)) << 1;
+}
+
+//! crc1 of an AC-3 syncframe written so that the CRC of its first 5/8 (syncword excluded) is 0.
+//! The CRC is linear: with crc1 = c in front of the rest R of L bytes, CRC = c*x^(8L+16) + CRC(R),
+//! so c = CRC(R) * x^-(8L+16).
+inline void WriteCrc1(uint8_t* frame, size_t bytes)
+{
+  const size_t end = AC3FiveEighths(bytes);
+  frame[2] = 0;
+  frame[3] = 0;
+  const uint16_t rest = CrcAC3(frame + 4, end - 4);
+  const uint16_t c = MulMod(rest, PowMod(X_INVERSE, 8 * static_cast<uint64_t>(end - 4) + 16));
+  frame[2] = static_cast<uint8_t>(c >> 8);
+  frame[3] = static_cast<uint8_t>(c & 0xFF);
+}
+
+//! crc2 (the last 2 bytes) written so that the CRC of the whole syncframe after its syncword is 0;
+//! crc2 never equals the syncword: then the bit before it (crcrsv, encinfo) is flipped too, and
+//! the 17 bits changed are P, which leaves the CRC as it was (FFmpeg's encoder does the same)
+inline void WriteCrc2(uint8_t* frame, size_t bytes)
+{
+  uint16_t c = CrcAC3(frame + 2, bytes - 4);
+  if (c == 0x0B77)
+  {
+    frame[bytes - 3] ^= 0x01;
+    c ^= 0x8005;
+  }
+  frame[bytes - 2] = static_cast<uint8_t>(c >> 8);
+  frame[bytes - 1] = static_cast<uint8_t>(c & 0xFF);
+}
+
+//! What of an AC-3 or E-AC-3 syncframe this needs: where its dialogue normalisation fields are,
+//! and whether it says Atmos
+struct SAC3Fields
+{
+  size_t bytes = 0; //!< 0: none, or one that fails its CRC
+  bool eac3 = false;
+  bool crcOk = false;
+  size_t dialnorm = 0; //!< bit position
+  size_t dialnorm2 = 0; //!< bit position; 0: none (not 1+1)
+  bool extensionTypeA = false; //!< E-AC-3: flag_ec3_extension_type_a (joint object coding)
+  bool parsed = false; //!< the header read to its end
+};
+
+//! The bit stream information of an E-AC-3 syncframe from the bit after dialnorm(2) and its
+//! compression fields, to the additional bit stream information, as FFmpeg's ac3_parser.c reads it
+//! (A/52 Annex E, E.1.2.2): whether it says extension type A
+inline bool ReadEAC3ExtensionTypeA(CBits& bits,
+                                   unsigned int strmtyp,
+                                   unsigned int acmod,
+                                   bool lfeon,
+                                   unsigned int numblks,
+                                   bool reducedRate,
+                                   bool* typeA)
+{
+  *typeA = false;
+  const int programs = acmod ? 1 : 2;
+  if (strmtyp == 1 && bits.Flag()) // chanmape
+    bits.Skip(16);
+  if (bits.Flag()) // mixmdate
+  {
+    if (acmod > 2)
+    {
+      bits.Skip(2); // dmixmod
+      if (acmod & 1)
+        bits.Skip(6); // ltrtcmixlev, lorocmixlev
+      if (acmod & 4)
+        bits.Skip(6); // ltrtsurmixlev, lorosurmixlev
+    }
+    if (lfeon && bits.Flag()) // lfemixlevcode
+      bits.Skip(5);
+    if (strmtyp == 0)
+    {
+      for (int i = 0; i < programs; ++i)
+        if (bits.Flag()) // pgmscle
+          bits.Skip(6);
+      if (bits.Flag()) // extpgmscle
+        bits.Skip(6);
+      switch (bits.Read(2)) // mixdef
+      {
+        case 1:
+          bits.Skip(5);
+          break;
+        case 2:
+          bits.Skip(12);
+          break;
+        case 3:
+          bits.Skip((bits.Read(5) + 2) * 8);
+          break;
+        default:
+          break;
+      }
+      if (acmod < 2)
+        for (int i = 0; i < programs; ++i)
+          if (bits.Flag()) // paninfoe
+            bits.Skip(14);
+      if (bits.Flag()) // frmmixcfginfoe
+        for (unsigned int i = 0; i < numblks; ++i)
+          if (numblks == 1 || bits.Flag())
+            bits.Skip(5);
+    }
+  }
+  if (bits.Flag()) // infomdate
+  {
+    bits.Skip(3 + 2); // bsmod, copyrightb, origbs
+    if (acmod == 2)
+      bits.Skip(4); // dsurmod, dheadphonmod
+    if (acmod >= 6)
+      bits.Skip(2); // dsurexmod
+    for (int i = 0; i < programs; ++i)
+      if (bits.Flag()) // audprodie
+        bits.Skip(8);
+    if (!reducedRate)
+      bits.Skip(1); // sourcefscod
+  }
+  if (strmtyp == 0 && numblks != 6)
+    bits.Skip(1); // convsync
+  if (strmtyp == 2 && (numblks == 6 || bits.Flag()))
+    bits.Skip(6); // frmsizecod
+  if (bits.Flag()) // addbsie
+  {
+    bits.Skip(6 + 7); // addbsil, the first 7 bits of the first byte
+    *typeA = bits.Flag();
+  }
+  return bits.Ok();
+}
+
+inline SAC3Fields ReadAC3Fields(const uint8_t* data, size_t size)
+{
+  SAC3Fields f;
+  const auto frame = KODI::AE::PRESENTATION::DETAIL::ReadAC3Frame(data, size);
+  if (frame.bytes == 0)
+    return f;
+  f.bytes = frame.bytes;
+  f.eac3 = frame.eac3;
+  f.crcOk = true; // ReadAC3Frame() takes only a frame whose whole CRC is 0
+  if (!f.eac3)
+  {
+    // bsid 5 @40, bsmod 3, acmod 3 @48, cmixlev/surmixlev/dsurmod, lfeon, dialnorm, compre (+compr),
+    // langcode (+langcod), audprodie (+mixlevel, roomtyp), then for 1+1 dialnorm2 (A/52 5.4.2)
+    CBits bits(data, f.bytes, 48);
+    const uint32_t acmod = bits.Read(3);
+    if ((acmod & 1) && acmod != 1)
+      bits.Skip(2);
+    if (acmod & 4)
+      bits.Skip(2);
+    if (acmod == 2)
+      bits.Skip(2);
+    bits.Skip(1);
+    f.dialnorm = bits.Pos();
+    bits.Skip(5);
+    if (acmod == 0)
+    {
+      if (bits.Flag())
+        bits.Skip(8);
+      if (bits.Flag())
+        bits.Skip(8);
+      if (bits.Flag())
+        bits.Skip(7);
+      f.dialnorm2 = bits.Pos();
+      bits.Skip(5);
+    }
+    f.parsed = bits.Ok();
+    return f;
+  }
+  // strmtyp 2 @16, substreamid 3, frmsiz 11, fscod 2 @32, fscod2/numblkscod 2, acmod 3 @36,
+  // lfeon 1, bsid 5 @40, dialnorm 5 @45, compre (+compr), then for 1+1 dialnorm2, compr2e (+compr2)
+  const unsigned int strmtyp = data[2] >> 6;
+  const bool reducedRate = (data[4] >> 6) == 3;
+  static constexpr unsigned int blocks[4] = {1, 2, 3, 6};
+  const unsigned int numblks = reducedRate ? 6 : blocks[(data[4] >> 4) & 3];
+  const unsigned int acmod = (data[4] >> 1) & 7;
+  const bool lfeon = data[4] & 1;
+  CBits bits(data, f.bytes, 45);
+  f.dialnorm = bits.Pos();
+  bits.Skip(5);
+  if (bits.Flag())
+    bits.Skip(8);
+  if (acmod == 0)
+  {
+    f.dialnorm2 = bits.Pos();
+    bits.Skip(5);
+    if (bits.Flag())
+      bits.Skip(8);
+  }
+  f.parsed = ReadEAC3ExtensionTypeA(bits, strmtyp, acmod, lfeon, numblks, reducedRate,
+                                    &f.extensionTypeA);
+  return f;
+}
+
+//! The fields of a DTS core frame at data that this needs
+struct SDTSCore
+{
+  size_t bytes = 0; //!< FSIZE + 1; 0: no core frame here
+  bool headerCrc = false; //!< CPF
+  unsigned int vernum = 0;
+  unsigned int dialnorm = 0;
+  bool rev2auxDialnorm = false; //!< a Rev2 auxiliary data chunk with DIALNORM_rev2aux
+};
+
+//! Bit positions of a core frame header without HCRC (TS 102 114 table 5-1): VERNUM after SYNC 32,
+//! FTYPE 1, SHORT 5, CPF 1, NBLKS 7, FSIZE 14, AMODE 6, SFREQ 4, RATE 5, FixedBit 1, DYNF 1,
+//! TIMEF 1, AUXF 1, HDCD 1, EXT_AUDIO_ID 3, EXT_AUDIO 1, ASPF 1, LFF 2, HFLAG 1, FILTS 1; then
+//! CHIST 2, PCMR 3, SUMF 1, SUMS 1, DIALNORM 4
+constexpr size_t DTS_VERNUM_BIT = 89;
+constexpr size_t DTS_DIALNORM_BIT = 100;
+
+inline SDTSCore ReadDTSCore(const uint8_t* data, size_t size)
+{
+  SDTSCore core;
+  if (size < 16 || data[0] != 0x7F || data[1] != 0xFE || data[2] != 0x80 || data[3] != 0x01)
+    return core;
+  CBits bits(data, size, 32);
+  if (!bits.Flag()) // FTYPE: a normal frame
+    return core;
+  bits.Skip(5); // SHORT
+  core.headerCrc = bits.Flag();
+  bits.Skip(7); // NBLKS
+  const size_t bytes = bits.Read(14) + 1; // FSIZE
+  if (!bits.Ok() || bytes < 96 || bytes > size)
+    return core;
+  core.bytes = bytes;
+  core.vernum = ReadBits(data, bytes, DTS_VERNUM_BIT + (core.headerCrc ? 16 : 0), 4);
+  core.dialnorm = ReadBits(data, bytes, DTS_DIALNORM_BIT + (core.headerCrc ? 16 : 0), 4);
+  // a Rev2 auxiliary data chunk (5.8.3), searched back from the end of the frame on 32-bit
+  // boundaries from its start, as AudioPresentation.h reads it: one whose size fits counts
+  for (size_t at = (bytes - 4) & ~size_t{3}; at >= 16; at -= 4)
+  {
+    if (data[at] != 0x70 || data[at + 1] != 0x04 || data[at + 2] != 0xC0 || data[at + 3] != 0x70)
+      continue;
+    CBits aux(data, bytes, (at + 4) * 8);
+    const uint32_t chunk = aux.Read(7) + 1; // nRev2AUXDataByteSize
+    if (!aux.Ok() || chunk < 3 || chunk > 128 || at + 4 + chunk > bytes)
+      continue;
+    if (aux.Flag()) // bESMetaDataFlag
+      aux.Skip(8);
+    if (chunk > 4 && aux.Flag() && aux.Ok()) // bBroadcastMetadataPresent
+    {
+      aux.Skip(1); // bDRCMetadataPresent
+      core.rev2auxDialnorm = aux.Flag() && aux.Ok(); // bDialnormMetadata
+    }
+    break;
+  }
+  return core;
+}
+
+} // namespace DETAIL
+
+//! Rewrites the dialogue normalisation of the frames of one stream, as the passthrough codec
+//! gets them from CAEStreamParser (one syncframe, an AC-3 or E-AC-3 one with its dependent
+//! substream, or a DTS core frame with its DTS-HD extension substream)
+class CRewriter
+{
+public:
+  //! Rewrites data in place; on any skip, data is as it came
+  SResult Rewrite(uint8_t* data, size_t size)
+  {
+    if (size >= 2 && data[0] == 0x0B && data[1] == 0x77)
+      return RewriteAC3(data, size);
+    if (size >= 4 && IsDTS(data))
+      return RewriteDTS(data, size);
+    return {};
+  }
+
+private:
+  static bool IsDTS(const uint8_t* d)
+  {
+    const uint32_t sync = (static_cast<uint32_t>(d[0]) << 24) | (d[1] << 16) | (d[2] << 8) | d[3];
+    return sync == 0x7FFE8001 || sync == 0xFE7F0180 || sync == 0x1FFFE800 || sync == 0xFF1F00E8 ||
+           sync == 0x64582025;
+  }
+
+  SResult RewriteAC3(uint8_t* data, size_t size)
+  {
+    SResult result;
+    // first: every syncframe of the buffer reads, checks and is no Atmos
+    m_frames.clear();
+    for (size_t at = 0; at < size;)
+    {
+      const DETAIL::SAC3Fields f = DETAIL::ReadAC3Fields(data + at, size - at);
+      if (m_frames.empty())
+        result.codec = (size >= 6 && (data[5] >> 3) > 10) ? Codec::EAC3 : Codec::AC3;
+      if (f.bytes == 0)
+      {
+        // the syncword is there: a frame of a size that fits that fails its CRC, or no frame
+        result.skip = (size - at >= 8 && data[at] == 0x0B && data[at + 1] == 0x77) ? Skip::BAD_CRC
+                                                                                   : Skip::NOT_A_FRAME;
+        return result;
+      }
+      if (!f.parsed)
+      {
+        result.skip = Skip::NOT_A_FRAME;
+        return result;
+      }
+      if (f.eac3)
+        result.codec = Codec::EAC3;
+      if (f.extensionTypeA || (f.eac3 && KODI::AE::PRESENTATION::DETAIL::FindOAMD(data + at, f.bytes)))
+      {
+        result.skip = Skip::ATMOS;
+        return result;
+      }
+      m_frames.push_back({at, f});
+      at += f.bytes;
+    }
+    if (m_frames.empty())
+    {
+      result.skip = Skip::NOT_A_FRAME;
+      return result;
+    }
+    const uint32_t first = DETAIL::ReadBits(data, size, m_frames[0].fields.dialnorm, 5);
+    result.reservedCode = first == 0;
+    result.dialogueLevel = first == 0 ? -31 : -static_cast<int>(first);
+    result.attenuation = first == 0 ? 0 : 31 - static_cast<int>(first);
+
+    // then: the fields to 31 and the CRCs again, frame by frame, with the bytes as they came kept
+    m_backup.assign(data, data + size);
+    for (const auto& [at, f] : m_frames)
+    {
+      uint8_t* frame = data + at;
+      bool change = DETAIL::ReadBits(frame, f.bytes, f.dialnorm, 5) != 31;
+      if (f.dialnorm2)
+        change = change || DETAIL::ReadBits(frame, f.bytes, f.dialnorm2, 5) != 31;
+      if (!change)
+        continue;
+      DETAIL::WriteBits(frame, f.dialnorm, 5, 31);
+      if (f.dialnorm2)
+        DETAIL::WriteBits(frame, f.dialnorm2, 5, 31);
+      if (f.eac3)
+        DETAIL::WriteCrc2(frame, f.bytes);
+      else
+        DETAIL::WriteCrc1(frame, f.bytes);
+      ++result.syncframes;
+    }
+    if (result.syncframes == 0)
+      return result; // already 0 dB
+    if (!CheckAC3(data))
+    {
+      std::memcpy(data, m_backup.data(), size);
+      result.skip = Skip::CHECK_FAILED;
+      result.syncframes = 0;
+      return result;
+    }
+    result.changed = true;
+    return result;
+  }
+
+  //! The rewritten syncframes read again as a decoder reads them: whole CRC 0 (and the first 5/8
+  //! of AC-3), the same fields in the same places, at 31; only those bits and the CRCs changed
+  bool CheckAC3(const uint8_t* data) const
+  {
+    for (const auto& [at, f] : m_frames)
+    {
+      const uint8_t* frame = data + at;
+      const DETAIL::SAC3Fields again = DETAIL::ReadAC3Fields(frame, f.bytes);
+      if (again.bytes != f.bytes || !again.parsed || again.dialnorm != f.dialnorm ||
+          again.dialnorm2 != f.dialnorm2 || again.extensionTypeA)
+        return false;
+      if (DETAIL::CrcAC3(frame + 2, f.bytes - 2) != 0)
+        return false;
+      if (!f.eac3 && DETAIL::CrcAC3(frame + 2, DETAIL::AC3FiveEighths(f.bytes) - 2) != 0)
+        return false;
+      if (DETAIL::ReadBits(frame, f.bytes, f.dialnorm, 5) != 31 ||
+          (f.dialnorm2 && DETAIL::ReadBits(frame, f.bytes, f.dialnorm2, 5) != 31))
+        return false;
+      // nothing else changed: the bytes that may differ are the crc1 or the crc2 (and the one
+      // before it, for crcrsv), and those of the fields
+      const uint8_t* old = m_backup.data() + at;
+      for (size_t i = 2; i < f.bytes; ++i)
+      {
+        if (frame[i] == old[i])
+          continue;
+        const bool crc = f.eac3 ? i >= f.bytes - 3 : (i == 2 || i == 3);
+        const bool field =
+            (i == f.dialnorm / 8 || i == (f.dialnorm + 4) / 8) ||
+            (f.dialnorm2 && (i == f.dialnorm2 / 8 || i == (f.dialnorm2 + 4) / 8));
+        if (!crc && !field)
+          return false;
+        if (f.eac3 && i == f.bytes - 3 && ((frame[i] ^ old[i]) & 0xFE) && !field)
+          return false;
+      }
+    }
+    return true;
+  }
+
+  SResult RewriteDTS(uint8_t* data, size_t size)
+  {
+    SResult result;
+    result.codec = Codec::DTS;
+    if (data[0] != 0x7F)
+    {
+      result.skip = Skip::DTS_FORM;
+      return result;
+    }
+    const DETAIL::SDTSCore core = DETAIL::ReadDTSCore(data, size);
+    if (core.bytes == 0)
+    {
+      result.skip = Skip::NOT_A_FRAME;
+      return result;
+    }
+    if (core.headerCrc)
+      result.skip = Skip::DTS_HEADER_CRC;
+    else if (core.vernum == 6)
+      result.skip = Skip::DTS_VERSION_6;
+    else if (core.vernum != 7)
+      result.skip = Skip::DTS_NO_DIALNORM;
+    else if (core.rev2auxDialnorm)
+      result.skip = Skip::DTS_REV2AUX;
+    if (result.skip != Skip::NONE)
+      return result;
+    result.attenuation = static_cast<int>(core.dialnorm);
+    if (core.dialnorm == 0)
+      return result; // already 0 dB
+    const uint8_t before = data[DETAIL::DTS_DIALNORM_BIT / 8];
+    DETAIL::WriteBits(data, DETAIL::DTS_DIALNORM_BIT, 4, 0);
+    const DETAIL::SDTSCore again = DETAIL::ReadDTSCore(data, size);
+    if (again.bytes != core.bytes || again.vernum != 7 || again.dialnorm != 0 || again.headerCrc ||
+        again.rev2auxDialnorm)
+    {
+      data[DETAIL::DTS_DIALNORM_BIT / 8] = before;
+      result.skip = Skip::CHECK_FAILED;
+      return result;
+    }
+    result.changed = true;
+    result.syncframes = 1;
+    return result;
+  }
+
+  struct SFrame
+  {
+    size_t at;
+    DETAIL::SAC3Fields fields;
+  };
+  std::vector<SFrame> m_frames;
+  std::vector<uint8_t> m_backup;
+};
+
+inline const char* CodecName(Codec codec)
+{
+  switch (codec)
+  {
+    case Codec::AC3:
+      return "AC-3";
+    case Codec::EAC3:
+      return "E-AC-3";
+    case Codec::DTS:
+      return "DTS";
+    default:
+      return "audio";
+  }
+}
+
+//! Why a stream keeps its dialogue normalisation, for the log
+inline std::string SkipReason(Skip skip)
+{
+  switch (skip)
+  {
+    case Skip::NOT_A_FRAME:
+      return "the data is not syncframes of the form it is written in";
+    case Skip::BAD_CRC:
+      return "a syncframe fails its own CRC as it comes (it is passed on as it came, for the "
+             "receiver to conceal)";
+    case Skip::ATMOS:
+      return "it carries Dolby Atmos objects, whose metadata a change to the frame could break";
+    case Skip::DTS_FORM:
+      return "it is DTS in 14-bit or little-endian words, or DTS-HD without a core";
+    case Skip::DTS_HEADER_CRC:
+      return "its core frames have a header CRC";
+    case Skip::DTS_VERSION_6:
+      return "its encoder version (VERNUM 6) cannot say 0 dB in that field (-16 dB at least)";
+    case Skip::DTS_NO_DIALNORM:
+      return "its encoder version gives the field no meaning";
+    case Skip::DTS_REV2AUX:
+      return "it carries its dialogue normalisation in a Rev2 auxiliary data chunk, which has its "
+             "own CRC";
+    case Skip::CHECK_FAILED:
+      return "a rewritten frame did not check, and was sent as it came";
+    default:
+      return {};
+  }
+}
+
+//! The state of one stream: what was said in the log, so that each thing is said once
+class CStream
+{
+public:
+  void Reset()
+  {
+    m_atmos = false;
+    m_said.clear();
+    m_lastAttenuation.reset();
+    m_frames = 0;
+    m_rewritten = 0;
+  }
+
+  //! The demuxer's profile says Atmos (E-AC-3 + Dolby Atmos)
+  void SetAtmos(bool atmos) { m_atmos = atmos; }
+  bool Atmos() const { return m_atmos; }
+
+  //! A frame as the passthrough codec has it; returns a line for the log when there is something
+  //! new to say
+  std::optional<std::string> Apply(uint8_t* data, size_t size)
+  {
+    ++m_frames;
+    SResult r;
+    if (m_atmos && size >= 2 && data[0] == 0x0B && data[1] == 0x77)
+    {
+      r.codec = Codec::EAC3;
+      r.skip = Skip::ATMOS;
+    }
+    else
+      r = m_rewriter.Rewrite(data, size);
+    if (r.changed)
+      ++m_rewritten;
+    return Say(r);
+  }
+
+  unsigned int Frames() const { return m_frames; }
+  unsigned int Rewritten() const { return m_rewritten; }
+
+  //! The log line for a result, if it says something new
+  std::optional<std::string> Say(const SResult& r)
+  {
+    if (r.codec == Codec::NONE)
+      return {};
+    if (r.skip != Skip::NONE)
+    {
+      const std::string key = std::string(CodecName(r.codec)) + std::to_string(static_cast<int>(r.skip));
+      for (const auto& said : m_said)
+        if (said == key)
+          return {};
+      m_said.push_back(key);
+      return std::string(CodecName(r.codec)) + " passed through: dialogue normalisation left as " +
+             "the stream says: " + SkipReason(r.skip);
+    }
+    if (m_lastAttenuation == r.attenuation)
+      return {};
+    m_lastAttenuation = r.attenuation;
+    if (!r.changed)
+      return std::string(CodecName(r.codec)) +
+             " passed through: dialogue normalisation already asks for no attenuation";
+    // each in its unit: the dialogue normalisation gain of DTS in dB, the dialogue level of
+    // AC-3 and E-AC-3 below full scale in dBFS (as the player information says them)
+    if (r.codec == Codec::DTS)
+      return std::string(CodecName(r.codec)) + " passed through: dialogue normalisation gain -" +
+             std::to_string(r.attenuation) + " dB, sent as 0 dB";
+    const std::string level =
+        r.reservedCode ? std::string("in the reserved code 0 (reproduced as -31 dBFS)")
+                       : std::to_string(r.dialogueLevel) + " dBFS (the receiver lowers the sound by " +
+                             std::to_string(r.attenuation) + " dB)";
+    return std::string(CodecName(r.codec)) + " passed through: dialogue level " + level +
+           ", sent as -31 dBFS (no attenuation)";
+  }
+
+private:
+  CRewriter m_rewriter;
+  bool m_atmos = false;
+  std::vector<std::string> m_said;
+  std::optional<int> m_lastAttenuation;
+  unsigned int m_frames = 0;
+  unsigned int m_rewritten = 0;
+};
+
+} // namespace KODI::AE::DIALNORM
