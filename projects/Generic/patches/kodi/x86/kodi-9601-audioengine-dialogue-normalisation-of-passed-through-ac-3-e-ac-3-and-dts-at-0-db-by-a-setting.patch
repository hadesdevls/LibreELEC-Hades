+void CDVDAudioCodecPassthrough::Dialnorm()
+{
+  // the frame as the parser handed it over, before it is packed for the receiver
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const bool on = settings && settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESDIALNORM);
+  const bool trueHD = m_parser.GetStreamInfo().m_type == CAEStreamInfo::STREAM_TYPE_TRUEHD;
+  if (m_dialnormOn != on)
+  {
+    // (said when it is on, and when it changes; not for a stream that starts with it off)
+    if (on || m_dialnormOn.has_value())
+      CLog::Log(LOGINFO,
+                "CDVDAudioCodecPassthrough: the dialogue normalisation of the stream passed through "
+                "({}) is {} (setting \"{}\")",
+                m_codecName, on ? "sent as 0 dB where its form allows it" : "left as the stream says",
+                CSettings::SETTING_AUDIOOUTPUT_HADESDIALNORM);
+    if (on && trueHD)
+      CLog::Log(LOGINFO, "CDVDAudioCodecPassthrough: TrueHD passed through: dialogue normalisation "
+                         "left as the stream says: nothing public describes its dialogue norm");
+    m_dialnormOn = on;
+  }
+  if (!on || trueHD)
+    return;
+  if (const auto line = m_dialnorm.Apply(m_buffer, m_dataSize))
+    CLog::Log(LOGINFO, "CDVDAudioCodecPassthrough: {}", *line);
+}
+
+void CDVDAudioCodecPassthrough::DialnormSummary()
+{
+  if (m_dialnorm.Frames())
+    CLog::Log(LOGINFO,
+              "CDVDAudioCodecPassthrough: dialogue normalisation sent as 0 dB in {} of the {} frames "
+              "passed through with the setting on",
+              m_dialnorm.Rewritten(), m_dialnorm.Frames());
+  m_dialnorm.Reset();
+  m_dialnormOn.reset();
+}
