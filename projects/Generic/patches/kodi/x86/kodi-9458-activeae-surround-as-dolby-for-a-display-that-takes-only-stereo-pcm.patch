diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index fee3749..2d82e8e 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -1453,8 +1453,28 @@ void CActiveAE::Configure(AEAudioFormat *desiredFmt)
       if (!m_encoder)
       {
         m_encoder = new CAEEncoderFFmpeg();
-        m_encoder->Initialize(outputFormat, true);
+        const CAEStreamInfo::DataType wanted = outputFormat.m_streamInfo.m_type;
+        const bool opened = m_encoder->Initialize(outputFormat, true);
         m_encoderFormat = outputFormat;
+        // Hades: fail closed for the Dolby of a display of stereo PCM (DolbyForDisplay(), which
+        // tried the encoder already): an encoder that does not open, or opens another format than
+        // the sink was opened for, is not used, and the engine is configured again with PCM,
+        // mixed down to stereo as before. ("Enable Dolby Digital transcoding" is as Kodi has it.)
+        if (!m_settings.ac3transcode &&
+            m_settings.dolbyForDisplay != CAEStreamInfo::STREAM_TYPE_NULL &&
+            (!opened || outputFormat.m_streamInfo.m_type != wanted))
+        {
+          CLog::Log(LOGERROR,
+                    "ActiveAE - the encoder of {} did not open: multichannel tracks that Kodi "
+                    "decodes are mixed down to stereo PCM",
+                    CAEUtil::StreamTypeToStr(wanted));
+          m_encoderOpens[wanted] = false;
+          delete m_encoder;
+          m_encoder = nullptr;
+          m_settings.dolbyForDisplay = CAEStreamInfo::STREAM_TYPE_NULL;
+          Configure(desiredFmt);
+          return;
+        }
       }
       else
         outputFormat = m_encoderFormat;
@@ -1917,18 +1937,27 @@ void CActiveAE::ApplySettingsToFormat(AEAudioFormat& format,
   else if (settings.channels <= AE_CH_LAYOUT_2_0 && // no multichannel pcm
            settings.passthrough &&
            settings.ac3passthrough &&
-           settings.ac3transcode &&
            !m_streams.empty() &&
-           (format.m_channelLayout.Count() > 2 || settings.stereoupmix))
+           ((settings.ac3transcode &&
+             (format.m_channelLayout.Count() > 2 || settings.stereoupmix)) ||
+            // Hades: a multichannel track for a display that takes stereo PCM only and Dolby in
+            // more channels (DolbyForDisplay())
+            (settings.dolbyForDisplay != CAEStreamInfo::STREAM_TYPE_NULL &&
+             format.m_channelLayout.Count() > 2)))
   {
     format.m_dataFormat = AE_FMT_RAW;
     format.m_sampleRate = 48000;
     format.m_channelLayout = AE_CH_LAYOUT_2_0;
     format.m_streamInfo.m_channels = 2;
     format.m_streamInfo.m_sampleRate = 48000;
-    format.m_streamInfo.m_type = CAEStreamInfo::STREAM_TYPE_EAC3;
-    if (!settings.eac3passthrough || !m_sink.SupportsFormat(settings.passthroughdevice, format))
-      format.m_streamInfo.m_type = CAEStreamInfo::STREAM_TYPE_AC3;
+    if (settings.ac3transcode)
+    {
+      format.m_streamInfo.m_type = CAEStreamInfo::STREAM_TYPE_EAC3;
+      if (!settings.eac3passthrough || !m_sink.SupportsFormat(settings.passthroughdevice, format))
+        format.m_streamInfo.m_type = CAEStreamInfo::STREAM_TYPE_AC3;
+    }
+    else
+      format.m_streamInfo.m_type = settings.dolbyForDisplay;
     if (mode)
       *mode = MODE_TRANSCODE;
   }
@@ -2962,6 +2991,116 @@ void CActiveAE::LoadSettings()
   m_settings.silenceTimeoutMinutes = settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_STREAMSILENCE);
   m_settings.mixSubLevel = settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_MIXSUBLEVEL) / 100.0;
   m_settings.lowLatencyMode = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_LOWLATENCY);
+  m_settings.dolbyForDisplay = DolbyForDisplay();
+}
+
+// Hades: decoded multichannel sound for a display that takes stereo PCM only but Dolby in more
+// channels (AE::PCM::DolbyForStereoDisplay()): encoded to Dolby Digital Plus 5.1, else Dolby
+// Digital 5.1, and passed through (ApplySettingsToFormat()), rather than mixed down to stereo.
+// "Surround as Dolby when the display takes only stereo PCM" (audiooutput.hadessurroundtodolby,
+// System > Audio, on by default) turns it off. The log says once what it does, and why.
+CAEStreamInfo::DataType CActiveAE::DolbyForDisplay()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+
+  AE::PCM::StereoDisplayCase c;
+  c.enabled = !settings || settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESSURROUNDTODOLBY);
+  c.setting = m_channelsSetting;
+  c.limited = m_settings.channels;
+  c.passthrough = m_settings.passthrough;
+  c.ac3Passthrough = m_settings.ac3passthrough;
+  c.eac3Passthrough = m_settings.eac3passthrough;
+  c.display = DisplayAudioOf(m_settings.passthroughdevice);
+
+  // the encoders are tried only where one would be used
+  bool eac3Opens = true;
+  AE::PCM::DolbyChoice choice = AE::PCM::DolbyForStereoDisplay(c, true, true);
