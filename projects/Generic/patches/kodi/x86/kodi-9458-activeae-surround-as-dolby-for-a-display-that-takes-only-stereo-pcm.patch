+        CLog::Log(LOGINFO,
+                  "ActiveAE - the display of '{}' takes stereo PCM, Dolby Digital in {} channels "
+                  "and Dolby Digital Plus in {}: multichannel tracks that Kodi decodes go out "
+                  "encoded to {} 5.1 and passed through, not mixed down to stereo",
+                  m_settings.passthroughdevice, c.display.ac3, c.display.eac3,
+                  type == CAEStreamInfo::STREAM_TYPE_EAC3 ? "Dolby Digital Plus" : "Dolby Digital");
+        break;
+      case AE::PCM::DolbyWhy::SETTING_OFF:
+        CLog::Log(LOGINFO,
+                  "ActiveAE - the display of '{}' takes stereo PCM: {} (\"Surround as Dolby when "
+                  "the display takes only stereo PCM\" is off)",
+                  m_settings.passthroughdevice, stereo);
+        break;
+      case AE::PCM::DolbyWhy::NO_PASSTHROUGH:
+        CLog::Log(LOGINFO,
+                  "ActiveAE - the display of '{}' takes stereo PCM: {} (passthrough or Dolby "
+                  "Digital passthrough is off)",
