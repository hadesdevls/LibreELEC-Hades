+//! What decoded multichannel sound goes out as, for a display that takes stereo PCM only
+enum class DolbyEncode
+{
+  NONE, //!< PCM, mixed down to the channels the display takes, as Kodi does with "Number of channels" at 2.0
+  AC3, //!< encoded to Dolby Digital 5.1 and passed through
+  EAC3, //!< encoded to Dolby Digital Plus 5.1 and passed through
+};
+
+//! Why (for the log)
+enum class DolbyWhy
+{
+  NOT_THE_CASE, //!< "Number of channels" is 2.0 or less, or the display takes more than 2 channels of PCM
+  ENCODED,
+  SETTING_OFF, //!< "Surround as Dolby when the display takes only stereo PCM" is off
+  NO_PASSTHROUGH, //!< passthrough, or Dolby Digital passthrough, is off
+  NO_DOLBY, //!< the display declares no Dolby Digital (Plus) in more than 2 channels
+  NO_ENCODER, //!< no encoder of what the display takes opens
+};
+
+struct DolbyChoice
+{
+  DolbyEncode encode{DolbyEncode::NONE};
+  DolbyWhy why{DolbyWhy::NOT_THE_CASE};
