+            </dependency>
+            <dependency type="visible">
+              <and>
+                <condition setting="audiooutput.hadespcmlimit" operator="is">true</condition>
+                <condition on="property" name="aesettingvisible" setting="audiooutput.config">audiooutput.hadessurroundtodolby</condition>
+                <condition on="property" name="aesettingvisible" setting="audiooutput.channels">audiooutput.hadessurroundtodolby</condition>
+              </and>
+            </dependency>
+          </dependencies>
