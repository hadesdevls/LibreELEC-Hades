+}
+
+bool CActiveAE::EncoderOpens(CAEStreamInfo::DataType type)
+{
+  const auto it = m_encoderOpens.find(type);
+  if (it != m_encoderOpens.end())
+    return it->second;
+
+  // what Configure() asks of it for a transcode (MODE_TRANSCODE)
+  AEAudioFormat format;
+  format.m_dataFormat = AE_FMT_FLOATP;
+  format.m_sampleRate = 48000;
+  format.m_channelLayout = AE_CH_LAYOUT_5_1;
+  format.m_streamInfo.m_type = type;
+  CAEEncoderFFmpeg encoder;
+  // (an encoder of E-AC-3 that is not there falls back to AC-3 in Initialize(): not this one)
+  const bool opens = encoder.Initialize(format, true) && format.m_streamInfo.m_type == type;
+  if (!opens)
+    CLog::Log(LOGWARNING, "ActiveAE - the encoder of {} does not open",
+              CAEUtil::StreamTypeToStr(type));
+  m_encoderOpens[type] = opens;
+  return opens;
 }
 
