+  // (the PCM of an ELD is what MaxChannelsOfEld() gives)
+  const std::vector<uint8_t> eld = Eld("LG TV SSCR2", LG_2);
+  EXPECT_EQ(MaxChannelsOfEld(eld.data(), eld.size()), DisplayAudioOfEld(eld.data(), eld.size()).pcm);
+}
+
+namespace
+{
+constexpr int L2_0 = 1, L5_1 = 8, L7_1 = 10;
+
+// the PC of the user on 2026-10-21: "Number of channels" 7.1, passthrough of Dolby Digital and
+// Dolby Digital Plus on, the TV with its own audio data
+StereoDisplayCase TheCase(const DisplayAudio& display = {2, 6, 8})
+{
+  StereoDisplayCase c;
+  c.enabled = true;
+  c.setting = L7_1;
+  c.limited = LimitLayout(L7_1, display.pcm);
+  c.passthrough = true;
+  c.ac3Passthrough = true;
+  c.eac3Passthrough = true;
+  c.display = display;
+  return c;
+}
+
+bool Is(const DolbyChoice& choice, DolbyEncode encode, DolbyWhy why)
+{
+  return choice.encode == encode && choice.why == why;
+}
+} // namespace
+
+TEST(TestAEPcmChannels, SurroundAsDolbyForADisplayOfStereoPcm)
+{
+  // Dolby Digital Plus, which the TV declares in 8 channels
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase(), true, true), DolbyEncode::EAC3, DolbyWhy::ENCODED));
+  // its passthrough off: Dolby Digital
+  StereoDisplayCase c = TheCase();
+  c.eac3Passthrough = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::AC3, DolbyWhy::ENCODED));
+  // a display that declares Dolby Digital only
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 6, 0}), true, true), DolbyEncode::AC3,
+                 DolbyWhy::ENCODED));
+  // or Dolby Digital Plus only
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 0, 8}), true, true), DolbyEncode::EAC3,
+                 DolbyWhy::ENCODED));
+  // the Hisense of a report, and any setting above 2.0
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 6, 8}), true, true), DolbyEncode::EAC3,
+                 DolbyWhy::ENCODED));
+  c = TheCase();
+  c.setting = L5_1;
+  c.limited = LimitLayout(L5_1, 2);
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::EAC3, DolbyWhy::ENCODED));
+}
+
+TEST(TestAEPcmChannels, SurroundAsDolbyFailsClosed)
+{
+  // an encoder that does not open: the other one, else stereo
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase(), false, true), DolbyEncode::AC3, DolbyWhy::ENCODED));
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase(), false, false), DolbyEncode::NONE,
+                 DolbyWhy::NO_ENCODER));
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 6, 0}), true, false), DolbyEncode::NONE,
+                 DolbyWhy::NO_ENCODER));
+  // the setting off
+  StereoDisplayCase c = TheCase();
+  c.enabled = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::SETTING_OFF));
+  // passthrough, or Dolby Digital passthrough, off
+  c = TheCase();
+  c.passthrough = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_PASSTHROUGH));
+  c = TheCase();
+  c.ac3Passthrough = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_PASSTHROUGH));
+  // no Dolby in more than 2 channels: a monitor of PCM only, Dolby Digital in 2 channels, or
+  // Dolby Digital Plus with its passthrough off and no Dolby Digital
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 0, 0}), true, true), DolbyEncode::NONE,
+                 DolbyWhy::NO_DOLBY));
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({2, 2, 2}), true, true), DolbyEncode::NONE,
+                 DolbyWhy::NO_DOLBY));
+  c = TheCase({2, 0, 8});
+  c.eac3Passthrough = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_DOLBY));
+}
+
+TEST(TestAEPcmChannels, NothingChangesWhereTheDisplayTakesTheChannels)
+{
+  // the TV with its sound bar's audio data (PCM in 8), the bar, a display of 5.1 PCM: PCM
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({8, 6, 8}), true, true), DolbyEncode::NONE,
+                 DolbyWhy::NOT_THE_CASE));
+  StereoDisplayCase c = TheCase({6, 6, 8});
+  EXPECT_EQ(L5_1, c.limited);
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NOT_THE_CASE));
+  // "Number of channels" at 2.0: "Enable Dolby Digital transcoding" is the setting, as in Kodi
+  c = TheCase();
+  c.setting = L2_0;
+  c.limited = L2_0;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NOT_THE_CASE));
+  // the limit off (or not known): PCM in the channels of the setting
+  c = TheCase();
+  c.limited = L7_1;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NOT_THE_CASE));
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase({0, 0, 0}), true, true), DolbyEncode::NONE,
+                 DolbyWhy::NOT_THE_CASE));
+  // a limited value that is no layout: not taken for stereo
+  c = TheCase();
+  c.limited = 42;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NOT_THE_CASE));
+}
+
+TEST(TestAEPcmChannels, SurroundAsDolbyThroughAChangeOfMode)
+{
+  // the start of 2026-10-21 again: the audio data kept while the TV has none give the same choice
+  DisplayAudio kept;
+  const std::vector<uint8_t> eld = Eld("LG TV SSCR2", LG_2);
+  KeepWhileAway(DisplayAudioOfEld(eld.data(), eld.size()), true, kept);
+  const DisplayAudio inTheChange = KeepWhileAway({}, false, kept);
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(TheCase(inTheChange), true, true), DolbyEncode::EAC3,
+                 DolbyWhy::ENCODED));
+}
