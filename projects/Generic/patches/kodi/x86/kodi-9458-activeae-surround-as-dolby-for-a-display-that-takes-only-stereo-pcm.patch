+//! What the choice is made of (CActiveAE::LoadSettings())
+struct StereoDisplayCase
+{
+  bool enabled{true}; //!< the setting audiooutput.hadessurroundtodolby
+  int setting{0}; //!< "Number of channels" (an AEStdChLayout)
+  int limited{0}; //!< the same, limited to the display (LimitLayout())
+  bool passthrough{false};
+  bool ac3Passthrough{false};
+  bool eac3Passthrough{false};
+  DisplayAudio display; //!< of the passthrough output
+};
+
+/*!
+ * \brief Decoded multichannel sound for a display of stereo PCM that takes Dolby in more channels
+ *
+ * A TV that declares PCM in 2 channels and Dolby Digital (Plus) in 6 or 8, as an LG C5 does when it
+ * declares its own audio, while its sound bar on eARC takes what it passes on (2026-10-21: TrueHD
+ * Atmos passed through played on the bar, and a DTS track, which the TV does not take, was decoded
+ * and mixed down to stereo). Where "Number of channels" asks for more than 2 and the display takes
+ * 2 channels of PCM, a multichannel track that Kodi decodes is encoded to Dolby Digital Plus 5.1
+ * (where the display declares it in more than 2 channels and its passthrough is on), else to Dolby
+ * Digital 5.1 (where the display declares it in more than 2 channels), and passed through, as
+ * "Enable Dolby Digital transcoding" does for "Number of channels" at 2.0. Fail closed: nothing
+ * declared, passthrough or Dolby Digital passthrough off, or no encoder that opens, and it is mixed
+ * down to stereo PCM as before. A display that takes the channels of the setting in PCM gets PCM.
+ *
+ * \param eac3Opens, ac3Opens whether the encoder of each opens (CActiveAE::EncoderOpens())
+ */
+constexpr DolbyChoice DolbyForStereoDisplay(const StereoDisplayCase& c, bool eac3Opens, bool ac3Opens)
+{
+  const unsigned int limited = ChannelsOfLayout(c.limited);
+  if (ChannelsOfLayout(c.setting) <= 2 || limited == 0 || limited > 2)
+    return {DolbyEncode::NONE, DolbyWhy::NOT_THE_CASE};
+  if (!c.enabled)
+    return {DolbyEncode::NONE, DolbyWhy::SETTING_OFF};
+  if (!c.passthrough || !c.ac3Passthrough)
+    return {DolbyEncode::NONE, DolbyWhy::NO_PASSTHROUGH};
+
+  const bool eac3 = c.eac3Passthrough && c.display.eac3 > 2;
+  const bool ac3 = c.display.ac3 > 2;
+  if (!eac3 && !ac3)
+    return {DolbyEncode::NONE, DolbyWhy::NO_DOLBY};
+  if (eac3 && eac3Opens)
+    return {DolbyEncode::EAC3, DolbyWhy::ENCODED};
+  if (ac3 && ac3Opens)
+    return {DolbyEncode::AC3, DolbyWhy::ENCODED};
+  return {DolbyEncode::NONE, DolbyWhy::NO_ENCODER};
+}
