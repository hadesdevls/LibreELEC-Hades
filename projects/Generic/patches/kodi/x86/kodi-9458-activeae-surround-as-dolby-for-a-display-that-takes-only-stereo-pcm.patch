--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -4035,6 +4035,27 @@
           </dependencies>
           <control type="toggle" />
         </setting>
+        <!-- Hades: decoded multichannel sound as Dolby for a display of stereo PCM (CActiveAE::DolbyForDisplay()) -->
