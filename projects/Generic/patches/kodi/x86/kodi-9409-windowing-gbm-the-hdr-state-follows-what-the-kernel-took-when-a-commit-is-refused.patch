From f57c7c482d7bb842abaea4c590b45a403ecad90b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:53:51 +0000
Subject: [PATCH] windowing/gbm: the HDR state follows what the kernel took
 when a commit is refused

CHDRSignal (the HDR signalling of the output as Kodi holds it: what GetEotf()
says, the blob of the metadata, and the value that a modeset queues again)
changes with what a request carries. Whether the commit that carries it goes
out was not looked at: a commit that the driver refuses, or whose test it
refuses (CDRMAtomic then sends the frame with the request before it), leaves
the output as it was, and Kodi went on as if the change had gone out. An HDR
video whose commit was refused went on with GetEotf() saying PQ on an output
that signals no HDR (its PGS subtitles taken for HDR, a capture tagged PQ, the
depth of an HDR output asked of an SDR one); the end of a video, refused, left
the display in HDR with Kodi taking it for SDR; and a modeset after either
queued again a value that the kernel never took. The blob of the metadata
before was destroyed as soon as a new one was queued.

Now the state before a change is kept, with its blob, until the request that
carries the change is finished (CDRMAtomic::RequestGeneration(): one more for
each request that went out or was dropped). At the next frame, or the next
change, the window system reads HDR_OUTPUT_METADATA of the connector from the
kernel (CWinSystemGbm::SettleHDR(): one read for each change), and the state
is the change, or the state before it again, which the log then says. A
request that is queued again (a modeset, or the 8-bit output that a refusal
with the half-float one puts back) carries the change from then on, so what it
queues is still the change. Where the kernel cannot be read, the change is
taken as made, as before.

Until the frame after the refused commit, GetEotf() still says what was asked.
What is shown does not change: the renderer still sends the picture as HDR
where SetHDR() said that it goes out; whether it should map it to SDR when the
driver refuses the signalling is not decided here.

Host test (hdrsettle_test.cpp, with doubles of the blob, the request and the
kernel): 13 cases (taken, the test refused, the commit failed, PQ to HLG, the
end of a video, two changes before one commit, a refused request queued again
and taken or refused again, the kernel not readable), 58 checks; with the code
before, 22 fail, now none. Eight mutations of the change each make it fail.
The test of CHDRSignal (132 checks) passes unchanged. Not run on a GPU.
---
 xbmc/windowing/gbm/HDRSignal.h       | 107 ++++++++++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp  |  50 ++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.h    |   7 ++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp |   1 +
 xbmc/windowing/gbm/drm/DRMAtomic.h   |   5 ++
 5 files changed, 165 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/HDRSignal.h b/xbmc/windowing/gbm/HDRSignal.h
index 21a144f..bbee1de 100644
--- a/xbmc/windowing/gbm/HDRSignal.h
+++ b/xbmc/windowing/gbm/HDRSignal.h
@@ -41,8 +41,11 @@ namespace GBM
  *   queued is taken away (where none is, nothing is queued: no modeset that changes nothing);
  * - where not even that can be queued, the state stays as it was, since it is what the kernel
  *   still has, and the blob stays alive while its id may be queued again.
- * Whether a commit that carries the request is then accepted is not decided here (a refused
- * commit falls back to the request before it: CDRMAtomic).
+ * Whether a commit that carries the request is then accepted is not known here: a commit that the
+ * driver refuses, or whose test it refuses (the frame then goes out with the request before it:
+ * CDRMAtomic), leaves the output as it was. So the state before a change is kept (Before), with
+ * its blob, until the request that carries the change is finished; then the state is what the
+ * kernel has (Settle()): the change, or the state before it again.
  *
  * Nothing of DRM is here: a test runs it on the host, with doubles of the request and the blob.
  */
@@ -80,6 +83,30 @@ public:
     bool Sent() const { return reason == Reason::SENT; }
   };
 
+  /*!
+   * \brief The state before changes that are not known to have gone out yet: what GetEotf() said,
+   *        the blob (alive: the kernel may still have its id, and a modeset queues it again), the
+   *        value queued, and the generation of the request that carries the changes
+   *        (CDRMAtomic::RequestGeneration())
+   */
+  template<typename Blob>
+  struct Before
+  {
+    UTILS::Eotf eotf = UTILS::Eotf::TRADITIONAL_SDR;
+    Blob blob;
+    std::optional<uint64_t> queued;
+    uint64_t request = 0;
+  };
+
+  //! What Settle() found
+  enum class Settled
+  {
+    NOTHING, //!< no change waits, or its request is not finished yet
+    TAKEN, //!< the kernel has the change (or could not be asked: taken as made)
+    REFUSED, //!< the kernel has the state before it: the commit did not carry it
+    OTHER, //!< the kernel has neither: the state is what it has
+  };
+
   //! Whether the output can be asked for the HDR of a picture: SENT where it can
   static Reason Admit(const Display& display)
   {
@@ -106,6 +133,8 @@ public:
    *        the driver does not); Queue(value) adds HDR_OUTPUT_METADATA = value to it, false when
    *        it was not; Modeset() makes its commit a modeset; Along() queues what goes with HDR
    *        metadata of a picture.
+   * \param before where the state before a change that is queued is kept until Settle(), and
+   *        request the generation of the request that it goes in (none: the state changes for good)
    */
   template<typename Blob, typename Out>
   static Outcome Request(UTILS::Eotf& eotf,
@@ -114,7 +143,9 @@ public:
                          std::optional<UTILS::Eotf> want,
                          const Display& display,
                          bool always,
-                         Out& out)
+                         Out& out,
+                         std::optional<Before<Blob>>* before = nullptr,
+                         uint64_t request = 0)
   {
     Outcome outcome;
     if (want)
@@ -133,6 +164,7 @@ public:
         {
           out.Along();
           out.Modeset();
+          Remember(eotf, blob, queued, before, request);
           queued = made.Get();
           blob = std::move(made);
           eotf = *want;
@@ -162,6 +194,7 @@ public:
       return outcome;
     }
     out.Modeset();
+    Remember(eotf, blob, queued, before, request);
     queued = 0;
     blob.Reset();
     eotf = UTILS::Eotf::TRADITIONAL_SDR;
@@ -169,6 +202,55 @@ public:
     return outcome;
   }
 
+  //! What was queued last is queued again, in another request (a modeset, or after a refused
+  //! commit): a change that waits is carried by that one now
+  template<typename Blob>
+  static void Requeued(std::optional<Before<Blob>>& before, uint64_t request)
+  {
+    if (before)
+      before->request = request;
+  }
+
+  /*!
+   * \brief Once the request that carried a change is finished, the state is what the kernel has
+   * \param request the generation of the request that is being filled now
+   * \param read reads HDR_OUTPUT_METADATA of the connector from the kernel (nothing where it
+   *        cannot be read: the change is taken as made, as before there was this)
+   */
+  template<typename Blob, typename Read>
+  static Settled Settle(UTILS::Eotf& eotf,
+                        Blob& blob,
+                        std::optional<uint64_t>& queued,
+                        std::optional<Before<Blob>>& before,
+                        uint64_t request,
+                        Read read)
+  {
+    if (!before || before->request == request)
+      return Settled::NOTHING;
+    Before<Blob> was = std::move(*before);
+    before.reset();
+    const std::optional<uint64_t> kernel = read();
+    // (the blob before goes with was: the kernel has the new one, or holds its own reference)
+    if (!kernel || *kernel == queued.value_or(0))
+      return Settled::TAKEN;
+    if (*kernel == was.queued.value_or(0))
+    {
+      // the commit did not carry the change: the blob of the change goes, the one before stays
+      eotf = was.eotf;
+      blob = std::move(was.blob);
+      queued = was.queued;
+      return Settled::REFUSED;
+    }
+    // Neither (another request carried something else): what the output signals is what the
+    // kernel has. A blob that is not the kernel's would not be queued again.
+    if (blob.Get() != *kernel)
+      blob.Reset();
+    queued = *kernel;
+    if (*kernel == 0)
+      eotf = UTILS::Eotf::TRADITIONAL_SDR;
+    return Settled::OTHER;
+  }
+
   /*!
    * \brief Whether why a picture of HDR goes out without it is written to the log: once for the
    *        same reason, until HDR goes out or a request without HDR comes (the end of a video)
@@ -189,6 +271,25 @@ public:
     return true;
   }
 
+private:
+  // The state before a change, unless one is kept already (the kernel still has that one); the
+  // change goes in the request of this generation
+  template<typename Blob>
+  static void Remember(UTILS::Eotf& eotf,
+                       Blob& blob,
+                       std::optional<uint64_t>& queued,
+                       std::optional<Before<Blob>>* before,
+                       uint64_t request)
+  {
+    if (!before)
+      return;
+    if (!*before)
+      *before = Before<Blob>{eotf, std::move(blob), queued, request};
+    else
+      (*before)->request = request;
+  }
+
+public:
   //! The reason, for the log
   static const char* Why(Reason reason)
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 7fcc623..9aab768 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1949,6 +1949,9 @@ void CWinSystemGbm::NotifyLimitedInput()
 
 void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
 {
+  // Hades: what the commits before this one did with a change of the HDR signalling
+  SettleHDR();
+
   if (m_videoLayerBridge && !videoLayer)
   {
     // disable video plane when video layer no longer is active
@@ -2229,6 +2232,8 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   auto connector = drm->GetConnector();
   if (!connector)
     return false;
+  // (Hades: from what the kernel has, where a change before this one is not settled yet)
+  SettleHDR();
 
   // Only enable HDR for PQ (HDR10/HDR10+/DV) or HLG transfer functions
   std::optional<KODI::UTILS::Eotf> want;
@@ -2361,8 +2366,9 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
     }
   } request{*this, *drm, *connector, hdr_metadata, *settings};
 
-  const CHDRSignal::Outcome outcome = CHDRSignal::Request(
-      m_eotf, m_hdrBlob, m_queuedHdrMetadata, want, display, !videoPicture, request);
+  const CHDRSignal::Outcome outcome =
+      CHDRSignal::Request(m_eotf, m_hdrBlob, m_queuedHdrMetadata, want, display, !videoPicture,
+                          request, &m_hdrBefore, drm->RequestGeneration());
   if (CHDRSignal::Tell(want, outcome, m_hdrTold))
     CLog::Log(LOGINFO, "HDR output: no HDR signalling for this {} video: {}",
               eotf == KODI::UTILS::Eotf::HLG ? "HLG" : "PQ", CHDRSignal::Why(outcome.reason));
@@ -2386,13 +2392,53 @@ void CWinSystemGbm::RequeueOutputProperties()
   if (m_queuedColorspace)
     drm->AddProperty(connector, "Colorspace", *m_queuedColorspace);
   if (m_queuedHdrMetadata)
+  {
     drm->AddProperty(connector, "HDR_OUTPUT_METADATA", *m_queuedHdrMetadata);
+    // (Hades: a change of it that waits is carried by this request now)
+    CHDRSignal::Requeued(m_hdrBefore, drm->RequestGeneration());
+  }
   // (Hades: ... and with HDR metadata, what SetHDR() takes away with them)
   if (m_queuedHdrMetadata && *m_queuedHdrMetadata)
     DropEndedStereoInfoFrame();
   drm->AllowModeset();
 }
 
+void CWinSystemGbm::SettleHDR()
+{
+  if (!m_hdrBefore)
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return;
+  const auto* connector = drm->GetConnector();
+  const KODI::UTILS::Eotf asked = m_eotf;
+  const auto settled =
+      CHDRSignal::Settle(m_eotf, m_hdrBlob, m_queuedHdrMetadata, m_hdrBefore,
+                         drm->RequestGeneration(),
+                         [connector]
+                         {
+                           return connector ? connector->ReadPropertyValue("HDR_OUTPUT_METADATA")
+                                            : std::optional<uint64_t>{};
+                         });
+  const auto name = [](KODI::UTILS::Eotf eotf)
+  {
+    return eotf == KODI::UTILS::Eotf::PQ    ? "PQ"
+           : eotf == KODI::UTILS::Eotf::HLG ? "HLG"
+                                            : "no HDR";
+  };
+  if (settled == CHDRSignal::Settled::REFUSED)
+    CLog::Log(LOGWARNING,
+              "HDR output: the commit that carried the HDR signalling ({}) did not go out (the "
+              "driver refused it): the output signals what it did before ({}), and so does the "
+              "state of Kodi",
+              name(asked), name(m_eotf));
+  else if (settled == CHDRSignal::Settled::OTHER)
+    CLog::Log(LOGWARNING,
+              "HDR output: the connector has other HDR metadata than Kodi asked for ({}): the state "
+              "of Kodi is what it has ({})",
+              name(asked), name(m_eotf));
+}
+
 std::shared_ptr<const KODI::UTILS::CDisplayInfo> CWinSystemGbm::DisplayInfo() const
 {
   std::unique_lock lock(m_infoLock);
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index fbf44ee..bd7ca68 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -206,6 +206,11 @@ protected:
   //! \brief Queue again the colorimetry and the HDR metadata that were queued last: the driver
   //! takes them with a flip, and they are dropped with a flip that it refuses.
   void RequeueOutputProperties();
+  //! \brief Hades: once the request that carried a change of the HDR signalling is finished, the
+  //! state (GetEotf(), the blob, what a modeset queues again) is what the kernel took
+  //! (CHDRSignal::Settle()): a commit that the driver refused left the output as it was. From the
+  //! thread that draws.
+  void SettleHDR();
   //! \brief A video is being set up, the output is being put back after one, or its mode is
   //! being set: the outputs are not looked at for a while after it (CDRMDisplayWatch). From
   //! the thread that draws.
@@ -443,6 +448,8 @@ private:
   KODI::UTILS::Eotf m_eotf = KODI::UTILS::Eotf::TRADITIONAL_SDR;
   //! Hades: the reason written last for an HDR picture without HDR signalling
   std::optional<CHDRSignal::Reason> m_hdrTold;
+  //! Hades: the state before a change of it that is not known to have gone out (SettleHDR())
+  std::optional<CHDRSignal::Before<CDRMPropertyBlob>> m_hdrBefore;
   KODI::UTILS::Colorimetry m_colorimetry = KODI::UTILS::Colorimetry::DEFAULT;
 
   //! The display information from its EDID at Kodi's start, as in Kodi: HDR and colorimetry
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 759338f..50d71b5 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -352,6 +352,7 @@ void CDRMAtomic::FinishRequest(bool accepted)
   // Hades: the request that went out stays the one to fall back to, also when it was a fallback
   // itself (FinishAtomicRequest())
   FinishAtomicRequest(m_atomicRequestQueue, m_req, accepted);
+  ++m_requestGeneration;
 
   if (m_inFenceFd != -1)
   {
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 36c6250..1715bbf 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -68,6 +68,10 @@ public:
   //! Hades: the last commit did not go out as it was asked: the driver refused it, or its test
   //! (the frame then went out with the request before it), or there was no framebuffer
   bool LastCommitRefused() const { return m_lastCommitRefused; }
+  //! Hades: which request what is added now goes in: one more each time a request is finished
+  //! (it went out, or the driver refused it or its test and it was dropped). A change that was
+  //! added to the request of an earlier generation has gone out, or not, by now.
+  uint64_t RequestGeneration() const { return m_requestGeneration; }
 
   // Probe whether any DRM device supports atomic modesetting, with no
   // connector required. Used to decide atomic-vs-legacy before falling back.
@@ -128,6 +132,7 @@ private:
   bool m_flipRefused = false;
   bool m_flipDropped = false; //!< see TakeFlipDropped(); kept until it is asked
   bool m_lastCommitRefused = false; //!< Hades: see LastCommitRefused()
+  uint64_t m_requestGeneration = 0; //!< Hades: see RequestGeneration()
   //! Hades: a copy of the last request whose test was refused and told (TakeFlipRefused()), and
   //! the flags of its commit, for RefusedForBuffer()
   struct AtomicReqFree
