From 5b9eb3cbc9f4a448915d0960b7e26f997f217a0c Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 15 Oct 2026 18:59:36 +0100
Subject: [PATCH] [RetroPlayer] Don't leave a shader's GLSL profile in its
 source

Kodi reads the version from a shader's "#version" line and writes its
own, but kept the rest of that line as source. A shader declaring
"#version 330 core", or "#version 300 es" on OpenGL ES, then failed to
compile on the stray profile. Drop the profile too, and keep what
follows it on that line, which can only be a comment.
---
 cmake/treedata/linux/tests.txt                |  2 +
 cmake/treedata/osx/tests.txt                  |  1 +
 .../RetroPlayer/shaders/gl/ShaderUtilsGL.cpp  | 17 +++++-
 .../shaders/gl/test/CMakeLists.txt            |  5 ++
 .../shaders/gl/test/TestShaderUtilsGL.cpp     | 55 +++++++++++++++++++
 .../shaders/gles/ShaderUtilsGLES.cpp          | 17 +++++-
 .../shaders/gles/test/CMakeLists.txt          |  5 ++
 .../shaders/gles/test/TestShaderUtilsGLES.cpp | 47 ++++++++++++++++
 8 files changed, 145 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/cores/RetroPlayer/shaders/gl/test/CMakeLists.txt
 create mode 100644 xbmc/cores/RetroPlayer/shaders/gl/test/TestShaderUtilsGL.cpp
 create mode 100644 xbmc/cores/RetroPlayer/shaders/gles/test/CMakeLists.txt
 create mode 100644 xbmc/cores/RetroPlayer/shaders/gles/test/TestShaderUtilsGLES.cpp

diff --git a/cmake/treedata/linux/tests.txt b/cmake/treedata/linux/tests.txt
index 0ecb93b..ad809ae 100644
--- a/cmake/treedata/linux/tests.txt
+++ b/cmake/treedata/linux/tests.txt
@@ -1,2 +1,4 @@
+xbmc/cores/RetroPlayer/shaders/gl/test test/retroplayer/shaders/gl
+xbmc/cores/RetroPlayer/shaders/gles/test test/retroplayer/shaders/gles
 xbmc/platform/linux/test platform/linux/test
 xbmc/platform/posix/filesystem/test platform/posix/filesystem/test
diff --git a/cmake/treedata/osx/tests.txt b/cmake/treedata/osx/tests.txt
index e7bc83e..9377790 100644
--- a/cmake/treedata/osx/tests.txt
+++ b/cmake/treedata/osx/tests.txt
@@ -1,2 +1,3 @@
+xbmc/cores/RetroPlayer/shaders/gl/test test/retroplayer/shaders/gl
 xbmc/platform/darwin/osx/storage/test platform/darwin/osx/storage/test
 xbmc/platform/posix/filesystem/test platform/posix/filesystem/test
diff --git a/xbmc/cores/RetroPlayer/shaders/gl/ShaderUtilsGL.cpp b/xbmc/cores/RetroPlayer/shaders/gl/ShaderUtilsGL.cpp
index daf2666..8ab2fcb 100644
--- a/xbmc/cores/RetroPlayer/shaders/gl/ShaderUtilsGL.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gl/ShaderUtilsGL.cpp
@@ -11,6 +11,8 @@
 #include "ServiceBroker.h"
 #include "rendering/gl/RenderSystemGL.h"
 
+#include <string_view>
+
 using namespace KODI::SHADER;
 
 GLint CShaderUtilsGL::TranslateWrapType(WrapType wrapType)
@@ -54,8 +56,19 @@ std::string CShaderUtilsGL::GetGLSLVersion(std::string& source)
     {
       version = std::stoul(sourceVersion, &sourceVersionSize, 10);
 
-      // Keep only source code after the version define
-      source = sourceVersion.substr(sourceVersionSize);
+      // Keep only source code after the version and its profile, if any. The
+      // rest of that line can only be a comment, which may continue past it.
+      size_t versionEnd = sourceVersionSize;
+      const size_t profileStart = sourceVersion.find_first_not_of(" \t", sourceVersionSize);
+      if (profileStart != std::string::npos)
+      {
+        const size_t profileEnd = sourceVersion.find_first_of(" \t\r\n/", profileStart);
+        const std::string_view profile =
+            std::string_view(sourceVersion).substr(profileStart, profileEnd - profileStart);
+        if (profile == "core" || profile == "compatibility" || profile == "es")
+          versionEnd = profileStart + profile.size();
+      }
+      source = sourceVersion.substr(versionEnd);
     }
     else
     {
diff --git a/xbmc/cores/RetroPlayer/shaders/gl/test/CMakeLists.txt b/xbmc/cores/RetroPlayer/shaders/gl/test/CMakeLists.txt
new file mode 100644
index 0000000..b8b16d8
--- /dev/null
+++ b/xbmc/cores/RetroPlayer/shaders/gl/test/CMakeLists.txt
@@ -0,0 +1,5 @@
+if(TARGET ${APP_NAME_LC}::OpenGl)
+  set(SOURCES TestShaderUtilsGL.cpp)
+
+  core_add_test_library(retroplayer_shaders_gl_test)
+endif()
diff --git a/xbmc/cores/RetroPlayer/shaders/gl/test/TestShaderUtilsGL.cpp b/xbmc/cores/RetroPlayer/shaders/gl/test/TestShaderUtilsGL.cpp
new file mode 100644
index 0000000..2800e22
--- /dev/null
+++ b/xbmc/cores/RetroPlayer/shaders/gl/test/TestShaderUtilsGL.cpp
@@ -0,0 +1,55 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/RetroPlayer/shaders/gl/ShaderUtilsGL.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::SHADER;
+
+TEST(TestShaderUtilsGL, DropsTheProfileFromTheVersion)
+{
+  std::string source = "#version 330 core\nvoid main() {}\n";
+
+  EXPECT_EQ(CShaderUtilsGL::GetGLSLVersion(source), "#version 330\n");
+  EXPECT_EQ(source, "\nvoid main() {}\n");
+}
+
+TEST(TestShaderUtilsGL, KeepsACommentOnTheVersionLine)
+{
+  std::string source = "#version 330 core // note\nvoid main() {}\n";
+
+  EXPECT_EQ(CShaderUtilsGL::GetGLSLVersion(source), "#version 330\n");
+  EXPECT_EQ(source, " // note\nvoid main() {}\n");
+}
+
+TEST(TestShaderUtilsGL, KeepsABlockCommentStartedOnTheVersionLine)
+{
+  std::string source = "#version 330 /* comment\ncontinued */\nvoid main() {}\n";
+
+  EXPECT_EQ(CShaderUtilsGL::GetGLSLVersion(source), "#version 330\n");
+  EXPECT_EQ(source, " /* comment\ncontinued */\nvoid main() {}\n");
+}
+
+TEST(TestShaderUtilsGL, KeepsAWordThatIsNotAProfile)
+{
+  std::string source = "#version 330 corelike\nvoid main() {}\n";
+
+  EXPECT_EQ(CShaderUtilsGL::GetGLSLVersion(source), "#version 330\n");
+  EXPECT_EQ(source, " corelike\nvoid main() {}\n");
+}
+
+TEST(TestShaderUtilsGL, KeepsAVersionWithoutAProfile)
+{
+  std::string source = "#version 120\nvoid main() {}\n";
+
+  EXPECT_EQ(CShaderUtilsGL::GetGLSLVersion(source), "#version 120\n");
+  EXPECT_EQ(source, "\nvoid main() {}\n");
+}
diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
index 4081fdc..a664283 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
@@ -11,6 +11,8 @@
 #include "ServiceBroker.h"
 #include "rendering/gles/RenderSystemGLES.h"
 
+#include <string_view>
+
 using namespace KODI::SHADER;
 
 GLint CShaderUtilsGLES::TranslateWrapType(WrapType wrapType)
@@ -54,8 +56,19 @@ std::string CShaderUtilsGLES::GetGLSLVersion(std::string& source)
     {
       version = std::stoul(sourceVersion, &sourceVersionSize, 10);
 
-      // Keep only source code after the version define
-      source = sourceVersion.substr(sourceVersionSize);
+      // Keep only source code after the version and its profile, if any. The
+      // rest of that line can only be a comment, which may continue past it.
+      size_t versionEnd = sourceVersionSize;
+      const size_t profileStart = sourceVersion.find_first_not_of(" \t", sourceVersionSize);
+      if (profileStart != std::string::npos)
+      {
+        const size_t profileEnd = sourceVersion.find_first_of(" \t\r\n/", profileStart);
+        const std::string_view profile =
+            std::string_view(sourceVersion).substr(profileStart, profileEnd - profileStart);
+        if (profile == "core" || profile == "compatibility" || profile == "es")
+          versionEnd = profileStart + profile.size();
+      }
+      source = sourceVersion.substr(versionEnd);
     }
     else
     {
