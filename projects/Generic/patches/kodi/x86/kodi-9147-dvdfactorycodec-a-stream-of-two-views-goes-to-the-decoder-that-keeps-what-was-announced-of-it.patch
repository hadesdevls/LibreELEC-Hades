From a9f8611a7e79e32861ca6cf6e03585e3fb3767b9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] DVDFactoryCodec: a stream of two views goes to the decoder
 that keeps what was announced of it

A stream that is marked as two views is announced as one picture of both
eyes. Only the FFmpeg codec keeps that word: it gives such a picture or,
where the second view cannot be had, pictures that say that they are not
one. Any other codec that opened the stream would give its base view,
and a half of that would be taken for each eye. The one other codec of
this build refuses such a stream; the rule is now where codecs are
chosen, for the ones to come.
---
 xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp
index 958a109..71373a9 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp
@@ -89,6 +89,15 @@ std::unique_ptr<CDVDVideoCodec> CDVDFactoryCodec::CreateVideoCodec(CDVDStreamInf
     pCodec.reset();
   }
 #endif
+  // Hades: a stream that is marked as two views (KODI::MULTIVIEW) was announced as one picture
+  // of both eyes. Only this decoder keeps that word: it gives such a picture or, where the
+  // second view cannot be had, pictures that say that they are not one. No other decoder is
+  // tried for it: one that gave the base view alone would have a half of it taken for each eye.
+  if (hint.multiview)
+  {
+    pCodec = std::make_unique<CDVDVideoCodecFFmpeg>(processInfo);
+    return pCodec->Open(hint, options) ? std::move(pCodec) : nullptr;
+  }
   // platform specific video decoders
   if (!(hint.codecOptions & CODEC_FORCE_SOFTWARE))
   {
