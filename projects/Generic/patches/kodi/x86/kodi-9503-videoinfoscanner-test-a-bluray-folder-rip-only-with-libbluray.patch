From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Fri, 30 Oct 2026 23:22:15 +0100
Subject: [PATCH] [VideoInfoScanner] Test a bluray folder rip only with
 libbluray.

Without libbluray a BDMV folder is not a disc, so the rip can't be added
as one movie; kodi-test crashes there in a build without it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/test/TestVideoInfoScanner.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 7b963eb..d247105 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -792,6 +792,7 @@ TEST_F(TestVideoInfoScanner, AMovieADiscJoinsIsNotNamedByItsOtherDisc)
   EXPECT_EQ("Film", m_db.GetMovieTitle(idMovie));
 }
 
+#ifdef HAVE_LIBBLURAY
 TEST_F(TestVideoInfoScanner, ABlurayFolderRipIsOneMovie)
 {
   const std::string folder{Folder(m_root, "Film (2010)")};
@@ -803,6 +804,7 @@ TEST_F(TestVideoInfoScanner, ABlurayFolderRipIsOneMovie)
   EXPECT_EQ(1, CountMovies());
   EXPECT_GT(m_db.GetMovieId(disc), 0);
 }
+#endif
 
 TEST_F(TestVideoInfoScanner, PlaylistsOfADiscAlreadyInTheLibraryKeepTheirMovie)
 {
-- 
2.53.0

