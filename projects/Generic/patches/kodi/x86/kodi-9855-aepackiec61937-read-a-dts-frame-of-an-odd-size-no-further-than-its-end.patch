From fe14077402076c7babd726c66e5bb193d7d7cdea Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:06:30 +0000
Subject: [PATCH] AEPackIEC61937: read a DTS frame of an odd size no further
 than its end

PackDTS() and PackDTSHD() swap the frame into 16-bit words for a little-endian sink, rounding an
odd size up first, so the last word takes the byte after the frame. The parser hands a frame out
in a buffer of exactly its size (CAEStreamParser::GetPacket()), and a DTS core may have an odd
size (FSIZE + 1, which nothing requires to be even): one byte past the buffer was read, and sent
to the receiver in the padding after the frame. AddressSanitizer reports it as a heap buffer
overflow for a 2013-byte core.

The last byte of an odd frame is now swapped with a zero. Frames of an even size are packed as
before, byte for byte. The other packers are not changed: an AC-3 or E-AC-3 frame is a whole
number of 16-bit words by its own header, and a TrueHD MAT frame is 61432 bytes.
---
 .../AudioEngine/Utils/AEPackIEC61937.cpp      | 24 +++++++++---
 .../Utils/test/TestAEPackIEC61937.cpp         | 38 ++++++++++++++++++-
 2 files changed, 55 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
index 62f0f8b..dcb6659 100644
--- a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
@@ -22,6 +22,22 @@ inline void SwapEndian(uint16_t *dst, uint16_t *src, unsigned int size)
     *dst = ((*src & 0xFF00) >> 8) | ((*src & 0x00FF) << 8);
 }
 
+// Hades: byte-swaps the 16-bit words of a frame of `size` bytes into dst (which may be src) and
+// returns the size written, rounded up to a whole word. A frame of an odd size ends in half a word:
+// its last byte is swapped with a zero, as the byte after the frame is not the frame's to read.
+inline unsigned int SwapEndianFrame(uint8_t* dst, uint8_t* src, unsigned int size)
+{
+  const uint8_t last = (size & 0x1) ? src[size - 1] : 0;
+  SwapEndian(reinterpret_cast<uint16_t*>(dst), reinterpret_cast<uint16_t*>(src), size >> 1);
+  if (size & 0x1)
+  {
+    dst[size - 1] = 0;
+    dst[size] = last;
+    ++size;
+  }
+  return size;
+}
+
 int CAEPackIEC61937::PackAC3(uint8_t *data, unsigned int size, uint8_t *dest)
 {
   assert(size <= OUT_FRAMESTOBYTES(AC3_FRAME_SIZE));
@@ -156,8 +172,7 @@ int CAEPackIEC61937::PackDTSHD(uint8_t *data, unsigned int size, uint8_t *dest,
   else
     memcpy(packet->m_data, data, size);
 #else
-  size += size & 0x1;
-  SwapEndian((uint16_t*)packet->m_data, (uint16_t*)data, size >> 1);
+  size = SwapEndianFrame(packet->m_data, data, size);
 #endif
 
   memset(packet->m_data + size, 0, burstsize - IEC61937_DATA_OFFSET - size);
@@ -207,10 +222,7 @@ int CAEPackIEC61937::PackDTS(uint8_t *data, unsigned int size, uint8_t *dest, bo
     memcpy(dataTo, data, size);
 
   if (byteSwapNeeded)
-  {
-    size += size & 0x1;
-    SwapEndian((uint16_t*)dataTo, (uint16_t*)data, size >> 1);
-  }
+    size = SwapEndianFrame(dataTo, data, size);
 
   if (size != frameSize)
     memset(packet->m_data + size, 0, frameSize - IEC61937_DATA_OFFSET - size);
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
index e98e922..703ffdc 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
@@ -47,7 +47,7 @@ TEST(TestAEPackIEC61937, APeriod16384BurstFitsTheDestinationBuffer)
   std::vector<uint8_t> frame(1000, 0x11);
   std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
 
-  ASSERT_EQ(65536u, MAX_IEC61937_PACKET);
+  ASSERT_EQ(65536, MAX_IEC61937_PACKET);
   EXPECT_EQ(65536, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
   EXPECT_EQ(0x11u, dest[IEC61937_DATA_OFFSET]);
   EXPECT_EQ(0u, dest[MAX_IEC61937_PACKET - 1]);
@@ -71,6 +71,42 @@ TEST(TestAEPackIEC61937, AFrameThatFillsAPeriod16384BurstIsPackedAndOneMoreIsDro
     ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written";
 }
 
+//! A DTS frame of an odd size, followed in memory by a byte that is not the frame's: the packed
+//! frame ends with its last byte and a zero, swapped, and the byte after it is not read.
+TEST(TestAEPackIEC61937, AnOddSizedDtsHdFrameIsReadNoFurtherThanItsEnd)
+{
+  constexpr unsigned int SIZE = 8001;
+  std::vector<uint8_t> memory(SIZE + 1, 0x11);
+  memory[SIZE - 1] = 0x33; // the frame's last byte
+  memory[SIZE] = 0xEE; // not the frame's
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  EXPECT_EQ(8192, CAEPackIEC61937::PackDTSHD(memory.data(), SIZE, dest.data(), 2048));
+  EXPECT_EQ(0x11u, dest[IEC61937_DATA_OFFSET + SIZE - 2]);
+  EXPECT_EQ(0x00u, dest[IEC61937_DATA_OFFSET + SIZE - 1]);
+  EXPECT_EQ(0x33u, dest[IEC61937_DATA_OFFSET + SIZE]);
+  EXPECT_EQ(0x00u, dest[IEC61937_DATA_OFFSET + SIZE + 1]);
+}
+
+TEST(TestAEPackIEC61937, AnOddSizedDtsCoreFrameIsReadNoFurtherThanItsEnd)
+{
+  constexpr unsigned int SIZE = 2013;
+  std::vector<uint8_t> memory(SIZE + 1, 0x11);
+  memory[SIZE - 1] = 0x33;
+  memory[SIZE] = 0xEE;
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  // big-endian data, packed for a little-endian sink: swapped
+  EXPECT_EQ(2048, CAEPackIEC61937::PackDTS_512(memory.data(), SIZE, dest.data(), false));
+  EXPECT_EQ(static_cast<uint16_t>(SIZE << 3),
+            static_cast<uint16_t>(dest[6] | (dest[7] << 8))); // length in bits, of the frame
+  EXPECT_EQ(0x00u, dest[IEC61937_DATA_OFFSET + SIZE - 1]);
+  EXPECT_EQ(0x33u, dest[IEC61937_DATA_OFFSET + SIZE]);
+  EXPECT_EQ(0x00u, dest[IEC61937_DATA_OFFSET + SIZE + 1]);
+  for (unsigned int i = 2048; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written past the burst";
+}
+
 //! A period IEC 61937 has no DTS type IV subtype for writes nothing
 TEST(TestAEPackIEC61937, AnUnknownPeriodIsDropped)
 {
