From 42211200a851a291773f85db06f20f3434cae9b5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:01:50 +0000
Subject: [PATCH] VideoPlayerAudio: say in the log whether the audio of a
 stream passes through, and why not

For AC-3, E-AC-3, DTS (and DTS-HD) and TrueHD, one INFO line when the stream
is opened: it passes through, or it is decoded to PCM and why. That is
"Allow passthrough" or the receiver setting of the format that is off, the
player that does not allow it for this stream (the lines before it say why:
"Sync playback to display", or a live stream), or the output that does not
take it (the passthrough device, or what the display or receiver says it
takes). A report of "no Atmos" can be answered from kodi.log.

The idea of one line of the decision is CroqueMr's (libreelec-x86-DV,
R1.0.0 RC3).
---
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp | 82 +++++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
index 67b633a..7c3b412 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
@@ -18,6 +18,7 @@
 #include "cores/VideoPlayer/Interface/DemuxPacket.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/StringUtils.h"
 #include "utils/MathUtils.h"
 #include "utils/log.h"
 
@@ -158,6 +159,73 @@ CVideoPlayerAudio::~CVideoPlayerAudio()
   // CloseStream(true);
 }
 
+namespace
+{
+// Hades: why a stream that could pass through (AC-3, E-AC-3, DTS, TrueHD) does not, in words, from
+// the settings that ActiveAE asks (CActiveAE::SupportsRaw()); what is left is the output: the
+// passthrough device, or what the display or receiver says it takes (its ELD). (A line of the
+// decision is CroqueMr's idea, R1.0.0 RC3.)
+const char* PassthroughCodecName(AVCodecID codec, int profile)
+{
+  switch (codec)
+  {
+    case AV_CODEC_ID_AC3:
+      return "AC-3";
+    case AV_CODEC_ID_EAC3:
+      return "E-AC-3";
+    case AV_CODEC_ID_TRUEHD:
+      return "TrueHD";
+    case AV_CODEC_ID_DTS:
+      return profile == AV_PROFILE_DTS_HD_MA || profile == AV_PROFILE_DTS_HD_MA_X ||
+                     profile == AV_PROFILE_DTS_HD_MA_X_IMAX
+                 ? "DTS-HD MA"
+                 : profile == AV_PROFILE_DTS_HD_HRA ? "DTS-HD HRA" : "DTS";
+    default:
+      return nullptr;
+  }
+}
+
+std::string PassthroughRefusal(AVCodecID codec, int profile)
+{
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGH))
+    return "\"Allow passthrough\" is off (Settings > System > Audio)";
+  const char* setting = nullptr;
+  const char* name = nullptr;
+  switch (codec)
+  {
+    case AV_CODEC_ID_AC3:
+      setting = CSettings::SETTING_AUDIOOUTPUT_AC3PASSTHROUGH;
+      name = "Dolby Digital (AC3) capable receiver";
+      break;
+    case AV_CODEC_ID_EAC3:
+      setting = CSettings::SETTING_AUDIOOUTPUT_EAC3PASSTHROUGH;
+      name = "Dolby Digital Plus (E-AC3) capable receiver";
+      break;
+    case AV_CODEC_ID_TRUEHD:
+      setting = CSettings::SETTING_AUDIOOUTPUT_TRUEHDPASSTHROUGH;
+      name = "Dolby TrueHD capable receiver";
+      break;
+    case AV_CODEC_ID_DTS:
+      if (!settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_DTSPASSTHROUGH))
+        return "\"DTS capable receiver\" is off (Settings > System > Audio)";
+      if (profile == AV_PROFILE_DTS_HD_MA || profile == AV_PROFILE_DTS_HD_MA_X ||
+          profile == AV_PROFILE_DTS_HD_MA_X_IMAX || profile == AV_PROFILE_DTS_HD_HRA)
+      {
+        setting = CSettings::SETTING_AUDIOOUTPUT_DTSHDPASSTHROUGH;
+        name = "DTS-HD capable receiver";
+      }
+      break;
+    default:
+      break;
+  }
+  if (setting && !settings->GetBool(setting))
+    return StringUtils::Format("\"{}\" is off (Settings > System > Audio)", name);
+  return "the output does not take it (the passthrough device, or what the display or receiver "
+         "on it says it takes)";
+}
+} // namespace
+
 bool CVideoPlayerAudio::OpenStream(CDVDStreamInfo hints)
 {
   CLog::Log(LOGINFO, "Finding audio codec for: {}", hints.codec);
@@ -192,6 +260,20 @@ bool CVideoPlayerAudio::OpenStream(CDVDStreamInfo hints)
     CLog::Log(LOGERROR, "Unsupported audio codec");
     return false;
   }
+  // Hades: whether this audio passes through, and why not (once for each stream that is opened)
+  if (const char* name = PassthroughCodecName(hints.codec, hints.profile))
+  {
+    if (codec->NeedPassthrough())
+      CLog::Log(LOGINFO, "CVideoPlayerAudio: {} at {} Hz passes through", name, hints.samplerate);
+    else
+      CLog::Log(LOGINFO, "CVideoPlayerAudio: {} at {} Hz is decoded to PCM: {}", name,
+                hints.samplerate,
+                streamType == CAEStreamInfo::STREAM_TYPE_NULL
+                    ? PassthroughRefusal(hints.codec, hints.profile)
+                : !allowpassthrough ? std::string("the player does not allow it for this stream "
+                                                  "(the lines above say why)")
+                                    : std::string("the passthrough decoder could not open it"));
+  }
 
   if(m_messageQueue.IsInited())
   {
-- 
