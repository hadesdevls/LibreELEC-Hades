From c671f2a8d4021a6694123661e05c12dceb920d79 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 20:24:26 +0100
Subject: [PATCH] [Video][VideoInfoScanner] Fix the clean after a scan missing
 video extras.

When a movie folder is rescanned, its extras folder is read for extras
but not scanned as a directory of its own, so it is never queued for
the clean that follows the scan. On an update of the whole library an
extra deleted from disk stayed until a full clean. Queue the extras
folders of a scanned directory with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.cpp | 5 +++--
 xbmc/video/VideoInfoScanner.h   | 2 ++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 237e3d1..a5236d3 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -2808,12 +2808,13 @@ CVideoInfoScanner::~CVideoInfoScanner()
   {
     m_pathsToClean.insert(m_database.GetPathId(directory));
 
-    // Pick up the base paths of directory's disc rips and archives
+    // Pick up the base paths of directory's disc rips and archives, and its video extras folders
     std::vector<std::pair<int, std::string>> subPaths;
     m_database.GetSubPaths(directory, subPaths, false);
     for (const auto& [idPath, path] : subPaths)
     {
-      if (!URIUtils::PathHasParent(path, directory) || URIUtils::IsDiscPath(path))
+      if (!URIUtils::PathHasParent(path, directory) || URIUtils::IsDiscPath(path) ||
+          !GetExtrasFolder(directory, path).empty())
         m_pathsToClean.insert(idPath);
     }
   }
diff --git a/xbmc/video/VideoInfoScanner.h b/xbmc/video/VideoInfoScanner.h
index 33e43e0..09cc0ec 100644
--- a/xbmc/video/VideoInfoScanner.h
+++ b/xbmc/video/VideoInfoScanner.h
@@ -274,6 +274,8 @@ namespace KODI::VIDEO
      A disc rip or archive is not anchored in the folder that was scanned but under a
      bluray:// or zip:// path of its own. Those are queued too, otherwise the clean never
      looks at them and media removed with the disc stays in the library.
+     The video extras folders of the directory are queued too, as the scan adds their
+     extras without scanning them as directories of their own.
      \param directory the directory that was scanned
      */
     void AddPathToClean(const std::string& directory);
-- 
