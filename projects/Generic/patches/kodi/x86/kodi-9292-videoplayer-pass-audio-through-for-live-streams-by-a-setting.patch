diff --git a/xbmc/cores/VideoPlayer/LivePassthrough.h b/xbmc/cores/VideoPlayer/LivePassthrough.h
new file mode 100644
index 0000000..8dc89fc
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/LivePassthrough.h
@@ -0,0 +1,66 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \brief Hades: what CVideoPlayerAudio does with the audio of a realtime (live) stream, by the
+ *        setting audiooutput.hadeslivepassthrough
+ *
+ * For a realtime stream VideoPlayer slows the clock while the audio queue runs low, and decoded
+ * audio is resampled to follow it (SYNC_RESAMPLE). Audio that is passed through cannot follow it:
+ * VideoPlayer leaves the clock alone for it, and it is kept in sync as that of any other stream
+ * (SYNC_DISCON: the clock follows the audio), so a live source whose clock runs slower than this
+ * device's ends in a short rebuffer now and then.
+ *
+ * With the setting off, these are Kodi's rules: no passthrough for a realtime stream or while the
+ * audio is resampled, and a codec that passes through is made again when the stream turns out to
+ * be realtime. With it on, a live stream passes through as any other; its decoded audio is still
+ * resampled. "Sync playback to display" rules passthrough out either way.
+ */
+namespace LIVEAUDIO
+{
+//! A codec that is made now may pass the audio through.
+//! \param resampling the audio of the stream is resampled now (SYNC_RESAMPLE)
+constexpr bool MayPassThrough(bool syncToDisplay,
+                              bool livePassthrough,
+                              bool realtime,
+                              bool resampling)
+{
+  if (syncToDisplay)
+    return false;
+  if (livePassthrough)
+    return true;
+  return !realtime && !resampling;
+}
+
+//! The audio of a stream that opens is resampled (SYNC_RESAMPLE), not kept in sync by the clock.
+//! \param passthrough its codec passes it through
+constexpr bool ResampleAtOpen(bool syncToDisplay,
+                              bool livePassthrough,
+                              bool realtime,
+                              bool passthrough)
+{
+  if (syncToDisplay)
+    return true;
+  return realtime && !(livePassthrough && passthrough);
+}
+
+//! A stream that turns out to be realtime once it plays: its audio is resampled from now on.
+constexpr bool ResampleWhenRealtime(bool livePassthrough, bool passthrough)
+{
+  return !(livePassthrough && passthrough);
+}
+
+//! ... and its codec is made again (Kodi's rule: one that passes through gives way to one that
+//! decodes).
+constexpr bool RemakeCodecWhenRealtime(bool livePassthrough)
+{
+  return !livePassthrough;
+}
+} // namespace LIVEAUDIO
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 1bb3e92..949ca06 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2348,6 +2348,11 @@ void CVideoPlayer::HandlePlaySpeed()
             m_clock.SetSpeedAdjust(adjust);
           }
         }
+        // Hades: a slow-down set while the audio was decoded does not outlive a switch to
+        // passthrough, which cannot follow it (the clock would drift from the audio until a
+        // correction of 100 ms made it jump)
+        else if (m_CurrentAudio.id >= 0 && m_clock.GetSpeedAdjust() != 0)
+          m_clock.SetSpeedAdjust(0);
       }
     }
   }
