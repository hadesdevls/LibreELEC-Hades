From 19e1a20a66b082c9e8bf78bcadad75e906abf83f Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Fri, 9 Oct 2026 20:06:12 +0100
Subject: [PATCH] [Video][CVideoDatabase] List a TV show director's shows when
 found by search (#29601)

GetTvShowsDirectorsByName() linked each director to
videodb://tvshows/directors/<id>/, but the TV shows node has no
directors child, so choosing one in the video library search opened an
empty list. It now links to the TV show titles filtered to the director,
videodb://tvshows/titles/?directorid=<id>, which the TV show listing
already supports.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 14e94addded41219a791971f0079d72f895a430b)
---
 xbmc/video/VideoDatabase.cpp          |  5 +++--
 xbmc/video/test/TestVideoDatabase.cpp | 21 +++++++++++++++++++++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index e9b8dde..f793389 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -10145,10 +10145,11 @@ void CVideoDatabase::GetTvShowsDirectorsByName(const std::string& strSearch, CFi
           continue;
         }
 
-      std::string strDir = StringUtils::Format("{}/", m_pDS->fv(0).get_asInt());
       auto pItem = std::make_shared<CFileItem>(m_pDS->fv(1).get_asString());
 
-      pItem->SetPath("videodb://tvshows/directors/"+ strDir);
+      // TV shows have no directors node, so the director's shows are their titles filtered
+      pItem->SetPath(
+          StringUtils::Format("videodb://tvshows/titles/?directorid={}", m_pDS->fv(0).get_asInt()));
       pItem->SetFolder(true);
       items.Add(std::move(pItem));
       m_pDS->next();
diff --git a/xbmc/video/test/TestVideoDatabase.cpp b/xbmc/video/test/TestVideoDatabase.cpp
index a82a1cf..bce7fdf 100644
--- a/xbmc/video/test/TestVideoDatabase.cpp
+++ b/xbmc/video/test/TestVideoDatabase.cpp
@@ -381,6 +381,27 @@ TEST_F(TestVideoDatabase, AddPathReusesRowAcrossZipAndArchiveProtocols)
   EXPECT_LT(m_db.GetPathId(archive), 0);
 }
 
+TEST_F(TestVideoDatabase, ATvShowDirectorFoundBySearchListsTheirShows)
+{
+  CVideoInfoTag directed;
+  directed.m_strTitle = "Directed";
+  directed.m_strPath = "/tv/directed/";
+  directed.SetDirector({"Jane Director"});
+  const int idShow{m_db.SetDetailsForTvShow({directed.m_strPath}, directed, KODI::ART::Artwork{},
+                                            KODI::ART::SeasonsArtwork{})};
+  ASSERT_GT(idShow, 0);
+  ASSERT_GT(AddTvShow("/tv/undirected/"), 0);
+
+  CFileItemList directors;
+  m_db.GetTvShowsDirectorsByName("Jane", directors);
+  ASSERT_EQ(1, directors.Size());
+
+  CFileItemList shows;
+  ASSERT_TRUE(m_db.GetTvShowsByWhere(directors[0]->GetPath(), CDatabase::Filter(), shows));
+  ASSERT_EQ(1, shows.Size());
+  EXPECT_EQ(idShow, shows[0]->GetVideoInfoTag()->m_iDbId);
+}
+
 TEST_F(TestVideoDatabase, GetPlayCountsListingInsideArchiveAcrossZipAndArchiveProtocols)
 {
   MarkPlayed(ArchivePath("zip", "/tv/season.zip", "e01.mkv"), 1);
-- 
