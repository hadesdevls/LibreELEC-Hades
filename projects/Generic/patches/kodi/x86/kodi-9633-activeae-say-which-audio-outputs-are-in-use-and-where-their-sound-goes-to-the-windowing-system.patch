 using namespace std::chrono_literals;
 
+namespace
+{
+// Hades: "0000:01:00.1", as sysfs names a PCI device
+bool IsPciAddress(const std::string& name)
+{
+  if (name.size() != 12 || name[4] != ':' || name[7] != ':' || name[10] != '.')
+    return false;
+  for (std::size_t i = 0; i < name.size(); ++i)
+  {
+    if (i != 4 && i != 7 && i != 10 && !std::isxdigit(static_cast<unsigned char>(name[i])))
+      return false;
+  }
+  return true;
+}
+
+/*!
+ * \brief Hades: where a sound card is, for the windowing system, which keeps on the graphics
+ *        output whose sound is in use (KODI::UTILS::CSoundOutputsInUse)
+ *
+ * The PCI device of the card is the nearest one on the way of its device in sysfs (the device of
+ * an HD Audio card is the controller itself, "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.1";
+ * the one of a SOF machine driver is a platform device under it). The devices that the controller
+ * is a consumer of are the links in its folder named "supplier:pci:<address>" (Linux,
+ * drivers/base/core.c, devlink_add_symlinks()): the one that the i915 audio component adds to the
+ * Intel graphics (intel_audio.c, device_link_add()). Only sysfs is read: no device is opened.
+ */
+void CardDeviceOf(int cardNr, std::string& pci, std::vector<std::string>& suppliers)
+{
+  const std::string link = "/sys/class/sound/card" + std::to_string(cardNr) + "/device";
+  char resolved[PATH_MAX];
+  if (!realpath(link.c_str(), resolved))
+    return;
+  std::string dir = resolved;
+  while (dir.size() > 1)
+  {
+    const std::size_t slash = dir.find_last_of('/');
+    if (slash == std::string::npos)
+      return;
+    if (IsPciAddress(dir.substr(slash + 1)))
+    {
+      pci = dir.substr(slash + 1);
+      break;
+    }
+    dir.erase(slash);
+  }
+  if (pci.empty())
+    return;
+
+  if (DIR* folder = opendir(dir.c_str()))
+  {
+    constexpr std::string_view PREFIX = "supplier:pci:";
+    while (const dirent* entry = readdir(folder))
+    {
+      const std::string name = entry->d_name;
+      if (name.starts_with(PREFIX) && IsPciAddress(name.substr(PREFIX.size())))
+        suppliers.push_back(name.substr(PREFIX.size()));
+    }
+    closedir(folder);
+    std::ranges::sort(suppliers);
+  }
+}
+
+/*!
+ * \brief Hades: whether the PCM of an output that is not named as an HDMI one has an ELD control
+ *        (CAEDeviceInfo::m_displayPcm), and who its display is when it has one. Nothing else of
+ *        the output is changed: what it takes stays as Kodi lists it.
+ */
+void AskDisplayPcm(int cardNr, int device, CAEDeviceInfo& info, snd_config_t* config)
+{
+  snd_ctl_t* ctlhandle = nullptr;
+  const std::string hw = "hw:" + std::to_string(cardNr);
+  if (snd_ctl_open_lconf(&ctlhandle, hw.c_str(), 0, config) != 0)
+    return;
+  snd_hctl_t* hctl = nullptr;
+  if (snd_hctl_open_ctl(&hctl, ctlhandle) != 0)
+  {
+    snd_ctl_close(ctlhandle);
+    return;
+  }
+  if (snd_hctl_load(hctl) == 0)
+  {
+    snd_ctl_elem_id_t* id;
+    snd_ctl_elem_id_alloca(&id);
+    memset(id, 0, snd_ctl_elem_id_sizeof());
+    snd_ctl_elem_id_set_interface(id, SND_CTL_ELEM_IFACE_PCM);
+    snd_ctl_elem_id_set_name(id, "ELD");
+    snd_ctl_elem_id_set_device(id, device);
+    snd_hctl_elem_t* elem = snd_hctl_find_elem(hctl, id);
+    info.m_displayPcm = elem ? CAEDeviceInfo::DisplayPcm::YES : CAEDeviceInfo::DisplayPcm::NO;
+    snd_ctl_elem_info_t* einfo;
+    snd_ctl_elem_info_alloca(&einfo);
+    memset(einfo, 0, snd_ctl_elem_info_sizeof());
+    snd_ctl_elem_value_t* control;
+    snd_ctl_elem_value_alloca(&control);
+    memset(control, 0, snd_ctl_elem_value_sizeof());
+    if (elem && snd_hctl_elem_info(elem, einfo) == 0 && snd_ctl_elem_info_is_readable(einfo) &&
+        snd_ctl_elem_info_get_type(einfo) == SND_CTL_ELEM_TYPE_BYTES &&
+        snd_hctl_elem_read(elem, control) == 0 && snd_ctl_elem_info_get_count(einfo) > 0)
+      info.m_displayIdentity = KODI::UTILS::IdentityOfEld(
+          static_cast<const uint8_t*>(snd_ctl_elem_value_get_bytes(control)),
+          snd_ctl_elem_info_get_count(einfo));
+  }
+  // (snd_hctl_close() also closes ctlhandle)
+  snd_hctl_close(hctl);
+}
+} // unnamed namespace
+
