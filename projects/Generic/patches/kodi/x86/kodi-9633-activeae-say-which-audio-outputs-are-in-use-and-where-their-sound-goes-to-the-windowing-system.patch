diff --git a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
index ed224d8..afe7b29 100644
--- a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
+++ b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
@@ -67,6 +67,24 @@ public:
   //! KODI::UTILS::IdentityOfEld()); maker 0 when not known
   KODI::UTILS::DisplayIdentity m_displayIdentity;
 
+  //! Hades: where the sound card of the output is, for the windowing system, which keeps on the
+  //! graphics output whose sound is in use (KODI::UTILS::CSoundOutputsInUse): the PCI address of
+  //! the device of the card ("0000:01:00.1"; CAESinkALSA, from sysfs), empty when not known
+  std::string m_cardDevice;
+  //! Hades: the PCI addresses of the devices that the card's device is a consumer of (the device
+  //! link that the i915 audio component adds from an Intel HD Audio controller to the graphics)
+  std::vector<std::string> m_cardSuppliers;
+  //! Hades: whether the PCM of the output has an ELD control, which ALSA gives the PCMs of HDMI
+  //! and DisplayPort outputs: YES, it plays to a graphics output; NO, it does not; UNKNOWN where
+  //! it could not be asked (no card or no PCM device known, or a sink that is not ALSA)
+  enum class DisplayPcm
+  {
+    UNKNOWN,
+    NO,
+    YES,
+  };
+  DisplayPcm m_displayPcm{DisplayPcm::UNKNOWN};
+
   operator std::string();
   static std::string DeviceTypeToString(enum AEDeviceType deviceType);
   std::string GetFriendlyName() const;
