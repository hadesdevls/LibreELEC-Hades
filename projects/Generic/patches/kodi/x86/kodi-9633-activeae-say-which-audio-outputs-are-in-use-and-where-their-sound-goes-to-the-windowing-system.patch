+
+// Hades: the outputs whose sound the engine uses, for the windowing system, which keeps on the
+// graphics output that carries it (KODI::UTILS::CSoundOutputsInUse, KEEP_OUTPUTS::OutputsForSound()):
+// the outputs of the two settings, the ones used for them (FollowDisplay(), in place of one that
+// is not there), and the one that the sink opened. Of each: whether a graphics output carries it,
+// who its display is (its ELD, or, while it has none, the last one read of it in this run: the
+// windowing system may have turned its output off, and an output that is off has no ELD), and
+// where its sound card is. Runs on the engine's thread, with the outputs as listed last.
+void CActiveAE::PublishSoundOutputs()
+{
+  using KODI::UTILS::SoundOutput;
+  const std::vector<std::pair<std::string, CAEDeviceInfo>> listed = m_sink.ListedOutputs();
+
+  // (an output that has a display now: what is known of it is kept for when it has none)
+  for (const auto& [key, info] : listed)
+  {
+    if (info.m_display == CAEDeviceInfo::Display::PRESENT && info.m_displayIdentity.Known())
+      m_soundSeen[key] = {info.m_displayIdentity, info.m_cardDevice, info.m_cardSuppliers};
+  }
+
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  std::vector<std::pair<std::string, std::string>> asks; // (device, role)
+  if (settings)
+    asks.emplace_back(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE),
+                      "the audio output of the settings");
+  asks.emplace_back(m_settings.device, "the audio output in use");
+  if (m_settings.passthrough)
+  {
+    if (settings)
+      asks.emplace_back(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE),
+                        "the passthrough output of the settings");
+    asks.emplace_back(m_settings.passthroughdevice, "the passthrough output in use");
+  }
+  if (!m_openedDriver.empty() && !m_openedDevice.empty())
+    asks.emplace_back(m_openedDriver + ':' + m_openedDevice, "the output that the sink opened");
+
+  std::vector<SoundOutput> outputs;
+  for (const auto& [asked, role] : asks)
+  {
+    AESinkDevice dev = CAESinkFactory::ParseDevice(asked);
+    // (a value that names no driver, Kodi's "Default": the sink opens the first output for it,
+    // CActiveAESink::OpenSink())
+    if (dev.driver.empty() || dev.name.empty())
+    {
+      const bool passthrough = role.find("passthrough") != std::string::npos;
+      dev = CAESinkFactory::ParseDevice(m_sink.FallbackOutput(passthrough));
+      if (dev.driver.empty() || dev.name.empty())
+        continue;
+    }
+    const std::string key = dev.driver + ':' + dev.name;
+    auto same =
+        std::ranges::find_if(outputs, [&key](const SoundOutput& o) { return o.device == key; });
+    if (same != outputs.end())
+    {
+      if (same->role.find(role) == std::string::npos)
+        same->role += ", " + role;
+      continue;
+    }
+
+    SoundOutput out;
+    out.device = key;
+    out.role = role;
+    const auto info =
+        std::ranges::find_if(listed, [&key](const auto& l) { return l.first == key; });
+    const auto seen = m_soundSeen.find(key);
+    if (info == listed.end())
+    {
+      // (an output that is not there in this start plays nothing; one seen before is what was seen)
+      if (seen == m_soundSeen.end())
+        continue;
+      out.kind = SoundOutput::Kind::DISPLAY;
+      out.identity = seen->second.identity;
+      out.fromBefore = true;
+      out.card = seen->second.card;
+      out.cardSuppliers = seen->second.suppliers;
+      out.why = "it is not listed now";
+      outputs.push_back(std::move(out));
+      continue;
+    }
+
+    const CAEDeviceInfo& d = info->second;
+    out.card = d.m_cardDevice;
+    out.cardSuppliers = d.m_cardSuppliers;
+    if (d.m_deviceType == AE_DEVTYPE_HDMI || d.m_deviceType == AE_DEVTYPE_DP ||
+        d.m_displayPcm == CAEDeviceInfo::DisplayPcm::YES)
+      out.kind = SoundOutput::Kind::DISPLAY;
+    else if (d.m_displayPcm == CAEDeviceInfo::DisplayPcm::NO)
+    {
+      out.kind = SoundOutput::Kind::OTHER;
+      out.why = "ALSA gives its PCM no ELD: it is no HDMI or DisplayPort output";
+    }
+    else if (dev.driver != "ALSA")
+    {
+      out.kind = SoundOutput::Kind::OTHER;
+      out.why = "its sink gives it the type " + CAEDeviceInfo::DeviceTypeToString(d.m_deviceType);
+    }
+    else
+    {
+      out.kind = SoundOutput::Kind::UNKNOWN;
+      out.why = "ALSA does not say which sound card it plays to";
+    }
+
+    if (out.kind == SoundOutput::Kind::DISPLAY)
+    {
+      if (d.m_display == CAEDeviceInfo::Display::PRESENT && d.m_displayIdentity.Known())
+        out.identity = d.m_displayIdentity;
+      else if (seen != m_soundSeen.end())
+      {
+        out.identity = seen->second.identity;
+        out.fromBefore = true;
+        if (out.card.empty())
+        {
+          out.card = seen->second.card;
+          out.cardSuppliers = seen->second.suppliers;
+        }
+      }
+      else
+        out.why = d.m_display == CAEDeviceInfo::Display::ABSENT
+                      ? "its ELD names no display now, nor did it since Kodi started"
+                      : "ALSA gives it no ELD that names its display";
+    }
+    outputs.push_back(std::move(out));
+  }
+
+  if (KODI::UTILS::CSoundOutputsInUse::Set(outputs))
+  {
+    for (const SoundOutput& o : outputs)
+      CLog::Log(LOGDEBUG, "ActiveAE - for the windowing system: '{}' ({}): {}{}, card {}{}",
+                o.device, o.role,
+                o.kind == SoundOutput::Kind::DISPLAY ? "an HDMI or DisplayPort output, "
+                : o.kind == SoundOutput::Kind::OTHER ? "no graphics output"
+                                                     : "not known",
+                o.kind == SoundOutput::Kind::DISPLAY
+                    ? o.identity.Describe() + (o.fromBefore ? " (seen before)" : "")
+                    : std::string(),
+                o.card.empty() ? "not known" : o.card, o.why.empty() ? "" : " (" + o.why + ")");
+  }
 }
 
