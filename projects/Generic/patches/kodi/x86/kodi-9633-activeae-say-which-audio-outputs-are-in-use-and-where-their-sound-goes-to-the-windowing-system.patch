+#pragma once
+
+#include "utils/DisplayIdentity.h"
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace KODI::UTILS
+{
+/*!
+ * \brief Hades: an audio output that the audio engine uses, as the windowing system needs to know
+ *        it to keep on the graphics output that carries its sound
+ *
+ * An HDMI or DisplayPort output carries sound only while its CRTC is on. The windowing system
+ * turns off the outputs that Kodi does not draw on (CDRMAtomic::DisableOtherOutputs(),
+ * CDRMUtils::DisableOtherDevices()); the one whose sound is in use is kept on
+ * (KEEP_OUTPUTS::OutputsForSound()). The kernel has no link from a PCM to a connector: the sound
+ * card is matched to its graphics device by where both are on the PCI bus, and the display of the
+ * PCM (its ELD) to the display of a connector (its EDID) by who the display is.
+ */
+struct SoundOutput
+{
+  //! What the audio engine knows of where its sound goes
+  enum class Kind
+  {
+    DISPLAY, //!< an HDMI or DisplayPort output of a sound card
+    OTHER, //!< no graphics output carries it (analog, S/PDIF, USB, Bluetooth)
+    UNKNOWN, //!< not known (see why)
+  };
+
+  std::string device; //!< as the settings name it ("ALSA:hdmi:CARD=NVidia,DEV=1")
+  std::string role; //!< for the log ("the audio output", "the passthrough output", ...)
+  Kind kind{Kind::UNKNOWN};
+  //! The display on it, by its ELD; maker 0: not known
+  DisplayIdentity identity;
+  //! identity is as an earlier listing of the outputs read it: the output has no display now (its
+  //! graphics output was turned off, or the display was)
+  bool fromBefore{false};
+  //! The PCI address of the device of its sound card ("0000:01:00.1"); empty when not known
+  std::string card;
+  //! The PCI addresses of the devices that the device of its card is a consumer of (the device
+  //! link that the i915 audio component adds from an Intel HD Audio controller to the graphics)
+  std::vector<std::string> cardSuppliers;
+  //! Why kind or identity is not known, or why it is OTHER, for the log
+  std::string why;
+
+  bool operator==(const SoundOutput&) const = default;
+};
+
+/*!
+ * \brief Hades: the audio outputs that the audio engine uses, as it last said: written by the
+ *        audio engine on its own thread when it loads its settings or opens its sink
+ *        (CActiveAE::PublishSoundOutputs()), read by the windowing system on its own when it turns
+ *        off the outputs that Kodi does not use. No lock is held but while a copy is made.
+ */
+class CSoundOutputsInUse
+{
+public:
+  //! \return whether this changed what was said (the generation then goes up)
+  static bool Set(const std::vector<SoundOutput>& outputs)
+  {
+    std::unique_lock lock(Lock());
+    State& state = Value();
+    if (state.generation.load() != 0 && state.outputs == outputs)
+      return false;
+    state.outputs = outputs;
+    state.generation.fetch_add(1);
+    return true;
+  }
+
+  //! \param[out] generation 0 while the audio engine has said nothing; else it goes up each time
+  //!             that what it says changes
+  static std::vector<SoundOutput> Get(uint64_t& generation)
+  {
+    std::unique_lock lock(Lock());
+    generation = Value().generation.load();
+    return Value().outputs;
+  }
+
+  //! The generation alone, without the lock (the windowing system asks at each commit)
+  static uint64_t Generation() { return Value().generation.load(); }
+
+private:
+  struct State
+  {
+    std::atomic<uint64_t> generation{0};
+    std::vector<SoundOutput> outputs;
+  };
+  static std::mutex& Lock()
+  {
+    static std::mutex lock;
+    return lock;
+  }
+  static State& Value()
+  {
+    static State value;
+    return value;
+  }
+};
+} // namespace KODI::UTILS
