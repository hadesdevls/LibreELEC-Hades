From c74a4b87375b9c621a3713f181122b3603a45acd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:50:54 +0000
Subject: [PATCH] skin.estuary: the reason of a display with the older Dolby
 Vision signalling fits its row

On the Dolby Vision page of the player information, "Reason: older Dolby Vision signalling (HDMI
1.4b), not sent" was 908 pixels wide with Estuary's font14, and its label is 885 (the dialog that
system/hades gives the other skins has the same row and takes the same string). It says "older DV
signalling (HDMI 1.4b), not sent" now, 761 pixels, as the row of the display already says "DV
Standard, older signalling (HDMI 1.4b)" and the translations already said "DV". The msgid changes in
the four files; the translations, which fit (878 pixels in es_ES, es_AR and es_MX), stay as they
are.

Checked on the host: every row of the page, in each state, fits its 885 pixels in en_GB, es_ES,
es_AR and es_MX, measured with Estuary's font14 (Noto Sans at 33 pixels); the widest is 878.2. The
four .po files are well formed, with the same msgid for each id.
---
 addons/skin.estuary/language/resource.language.en_gb/strings.po | 2 +-
 addons/skin.estuary/language/resource.language.es_ar/strings.po | 2 +-
 addons/skin.estuary/language/resource.language.es_es/strings.po | 2 +-
 addons/skin.estuary/language/resource.language.es_mx/strings.po | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index 817b1bb..b7294ea 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -1218,7 +1218,7 @@ msgstr ""
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the display offers Dolby Vision only with the older signalling, which is not sent
 msgctxt "#31684"
-msgid "older Dolby Vision signalling (HDMI 1.4b), not sent"
+msgid "older DV signalling (HDMI 1.4b), not sent"
 msgstr ""
 
 #: /xml/DialogPlayerProcessInfo.xml
diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index ca67c62..6f62f04 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -1052,7 +1052,7 @@ msgstr "DV Standard, señalización antigua (HDMI 1.4b)"
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the display offers Dolby Vision only with the older signalling, which is not sent
 msgctxt "#31684"
-msgid "older Dolby Vision signalling (HDMI 1.4b), not sent"
+msgid "older DV signalling (HDMI 1.4b), not sent"
 msgstr "señalización DV antigua (HDMI 1.4b), no se envía"
 
 #: /xml/DialogPlayerProcessInfo.xml
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index 08fcd0f..1e85fef 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -1072,7 +1072,7 @@ msgstr "DV Standard, señalización antigua (HDMI 1.4b)"
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the display offers Dolby Vision only with the older signalling, which is not sent
 msgctxt "#31684"
-msgid "older Dolby Vision signalling (HDMI 1.4b), not sent"
+msgid "older DV signalling (HDMI 1.4b), not sent"
 msgstr "señalización DV antigua (HDMI 1.4b), no se envía"
 
 #: /xml/DialogPlayerProcessInfo.xml
diff --git a/addons/skin.estuary/language/resource.language.es_mx/strings.po b/addons/skin.estuary/language/resource.language.es_mx/strings.po
index c84336f..6da80db 100644
--- a/addons/skin.estuary/language/resource.language.es_mx/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -1072,7 +1072,7 @@ msgstr "DV Standard, señalización antigua (HDMI 1.4b)"
 #: /xml/DialogPlayerProcessInfo.xml
 #. Reason: the display offers Dolby Vision only with the older signalling, which is not sent
 msgctxt "#31684"
-msgid "older Dolby Vision signalling (HDMI 1.4b), not sent"
+msgid "older DV signalling (HDMI 1.4b), not sent"
 msgstr "señalización DV antigua (HDMI 1.4b), no se envía"
 
 #: /xml/DialogPlayerProcessInfo.xml
-- 
2.53.0

