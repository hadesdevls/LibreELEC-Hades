@@ -3396,6 +3397,34 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
         if (m_bMatroska && pStream->avg_frame_rate.num > 0 && pStream->avg_frame_rate.den > 0)
           frameRate = pStream->avg_frame_rate;
 
+#ifdef HAVE_LIBBLURAY
+        // Hades: a VC-1 stream of a Blu-ray whose rate FFmpeg gives as its field rate, because its
+        // analysis stopped before the third picture (BlurayVc1Rate.h): the rate its sequence header
+        // and the disc's playlist declare
+        if (pStream->codecpar->codec_id == AV_CODEC_ID_VC1 &&
+            m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY))
+        {
+          int num = 0;
+          int den = 0;
+          const auto bluray = std::static_pointer_cast<CDVDInputStreamBluray>(m_pInput);
+          const AVRational declared = pStream->codecpar->framerate;
+          if (bluray->GetVideoStreamRate(pStream->id, num, den) &&
+              KODI::BLURAYVC1::IsFieldRate(
+                  {frameRate.num, frameRate.den},
+                  {pStream->avg_frame_rate.num, pStream->avg_frame_rate.den},
+                  {declared.num, declared.den}, {num, den}))
+          {
+            CLog::Log(
+                LOGINFO,
+                "CDVDDemuxFFmpeg::AddStream - stream {}: VC-1 at {}/{} from FFmpeg, twice the "
+                "{}/{} that its sequence header and the disc's playlist declare (FFmpeg's "
+                "analysis ended before it had the average rate): {}/{} is taken",
+                pStream->index, frameRate.num, frameRate.den, num, den, declared.num, declared.den);
+            frameRate = declared;
+          }
+        }
+#endif
+
         if (frameRate.num > 0 && frameRate.den > 0)
         {
           st->iFpsRate = frameRate.num;
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 90658d9..491ff91 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -2036,6 +2036,49 @@ void CDVDInputStreamBluray::GetStreamInfo(int pid, std::string &language)
               pid);
 }
 
+bool CDVDInputStreamBluray::GetVideoStreamRate(int pid, int& num, int& den) const
+{
+  if (!m_titleInfo || !m_clip)
+    return false;
+
+  for (int i = 0; i < m_clip->video_stream_count; ++i)
+  {
+    const BLURAY_STREAM_INFO& stream{m_clip->video_streams[i]};
+    if (stream.pid != static_cast<uint16_t>(pid))
+      continue;
+    switch (stream.rate)
+    {
+      case BLURAY_VIDEO_RATE_24000_1001:
+        num = 24000;
+        den = 1001;
+        return true;
+      case BLURAY_VIDEO_RATE_24:
+        num = 24;
+        den = 1;
+        return true;
+      case BLURAY_VIDEO_RATE_25:
+        num = 25;
+        den = 1;
+        return true;
+      case BLURAY_VIDEO_RATE_30000_1001:
+        num = 30000;
+        den = 1001;
+        return true;
+      case BLURAY_VIDEO_RATE_50:
+        num = 50;
+        den = 1;
+        return true;
+      case BLURAY_VIDEO_RATE_60000_1001:
+        num = 60000;
+        den = 1001;
+        return true;
+      default:
+        return false;
+    }
+  }
+  return false;
+}
+
 bool CDVDInputStreamBluray::IsDefaultStream(int pid) const
 {
   if (!m_titleInfo || !m_clip)
