+
+#pragma once
+
+/*!
+ * \file BlurayVc1Rate.h
+ * \brief Hades: the frame rate of a VC-1 stream of a Blu-ray, where FFmpeg gives its field rate.
+ *
+ * FFmpeg sets r_frame_rate of a stream whose codec can code fields (AV_CODEC_PROP_FIELDS, VC-1 among
+ * them) to twice the rate its sequence header declares (libavformat/demux.c, avformat_find_stream_info()).
+ * av_guess_frame_rate(), which Kodi takes, gives the declared rate back only where the average rate is
+ * known, and avformat_find_stream_info() knows it only once it has read three pictures of the stream:
+ * it stops as soon as every stream of the file has its parameters, which on a Blu-ray clip (its audio,
+ * its PG streams) can be before that. The stream then opens at 47.952 instead of 23.976 (or 50 for 25,
+ * 59.94 for 29.97, 48 for 24, 100 for 50), and the rate measured while it plays switches the display
+ * again a few seconds into it. Measured with Hades' FFmpeg 9.0.2 on synthetic VC-1 clips: the field
+ * rate stays whenever the analysis stops before the third picture, with or without pulldown.
+ *
+ * The declared rate is taken where FFmpeg's is exactly twice it, the average is not known, and the
+ * stream number table of the disc's playlist declares the same rate: then it is the rate FFmpeg itself
+ * gives once its analysis reads the third picture.
+ */
+
+#include <cstdint>
+
+namespace KODI::BLURAYVC1
+{
+struct Rate
+{
+  int num{0};
+  int den{0};
+  bool Known() const { return num > 0 && den > 0; }
+};
+
+inline bool SameRate(Rate a, Rate b)
+{
+  return a.Known() && b.Known() &&
+         static_cast<int64_t>(a.num) * b.den == static_cast<int64_t>(b.num) * a.den;
+}
+
+/*!
+ * \param guessed What av_guess_frame_rate() gives for the stream
+ * \param average Its avg_frame_rate
+ * \param declared The rate its sequence header declares (codecpar->framerate)
+ * \param playlist The rate the stream number table of the play item declares for it
+ * \return Whether the rate guessed is the field rate of the declared one, which is the stream's
+ */
+inline bool IsFieldRate(Rate guessed, Rate average, Rate declared, Rate playlist)
+{
+  // (a rate the header does not declare is the playlist's rate of no stream: SameRate() is false)
+  if (average.Known() || !SameRate(declared, playlist))
+    return false;
+  return SameRate(guessed, Rate{declared.num * 2, declared.den});
+}
+} // namespace KODI::BLURAYVC1
