diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index 8a46707..bb06b6c 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -119,11 +119,12 @@ struct dvbridge_hdr10_mapping {
     /* Hades: with DVBRIDGE_HDR10_GAMUT_CUSTOM, the gamut of the display: CIE 1931 xy of red,
      * green, blue and white, inside BT.2020 (of an HDR10 target only; see dvbridge_hdr10_custom_xy()) */
     float target_xy[8];
-    /* Hades: the black of the display, cd/m2, of an HDR10 target, for Dolby Vision Low-Latency: the black of the
-     * source is taken to it with the black level lift of ITU-R BT.2390, so that what is just above black does
-     * not sink into the display's own black (mask_low_latency() in dvbridge_render.c). 0: the black of the
-     * source kept, as before, bit for bit. At most DVBRIDGE_HDR10_BLACK_MAX. A mapping of a picture for output
-     * as HDR10 (dvbridge_render_hdr10_mapping()) does not apply it. */
+    /* Hades: the black of the display, cd/m2, of an HDR10 target: the black of the source is taken to it with
+     * the black level lift of ITU-R BT.2390, so that what is just above black does not sink into the display's
+     * own black: for Dolby Vision Low-Latency (mask_low_latency() in dvbridge_render.c) and, Hades, for a picture
+     * mapped for output as HDR10 (dvbridge_render_hdr10_mapping(): Dolby Vision as HDR10 mapped to the display,
+     * HDR10 adapted to the display; clamp_to_display()). 0: the black of the source kept, as before, bit for
+     * bit. At most DVBRIDGE_HDR10_BLACK_MAX. */
     float black;
     /* Hades: an SDR target with the pure 2.2 power as its EOTF, not BT.1886's 2.4
        (dvbridge_sdr_mapping_for()).
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 2ebee84..7bf806c 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1855,22 +1855,51 @@ struct display_clamp {
     float peak; /* in PQ */
     bool codes; /* Hades: quantized to the codes of 10 bits (clamp_picture()) */
     float levels;
+    /* Hades: the display's black as a share of its peak in PQ (dvbridge_hdr10_mapping::black); 0: none, and the
+     * shader is the one before, its text and its variables */
+    float black;
 };
 
+/* Hades: the black level lift of the EETF of ITU-R BT.2390 (5.4.1: E3 = E2 + b (1 - E2)^4, b the display's
+ * minimum on the scale of the range) on each of R', G' and B' of the mapped picture, in PQ over [0, the peak],
+ * where the mapping has the display's black: as mask_low_latency() lifts a picture of Low-Latency, after
+ * libplacebo's mapping and not as its target's black (that turns its tone mapping on for a scene that fits the
+ * display, and changes saturated highlights: mask_low_latency()). The black of the source goes to the display's
+ * black, what is above it rises less the brighter it is, the peak stays. */
+#define DISPLAY_BLACK_LIFT                                                     \
+    "{\n"                                                                      \
+    "    vec3 e = clamp(color.rgb / dvbridge_peak, 0.0, 1.0);\n"               \
+    "    vec3 f = 1.0 - e;\n"                                                  \
+    "    color.rgb = (e + dvbridge_black * f * f * f * f) * dvbridge_peak;\n" \
+    "}\n"
+
 static struct pl_hook_res clamp_to_display(void *priv, const struct pl_hook_params *p)
 {
     struct display_clamp *c = priv;
     struct pl_shader_var vars[] = {
         {.var = pl_var_float("dvbridge_peak"), .data = &c->peak, .dynamic = true},
-        {.var = pl_var_float("dvbridge_levels"), .data = &c->levels, .dynamic = true}};
+        {.var = pl_var_float("dvbridge_levels"), .data = &c->levels, .dynamic = true},
+        {.var = pl_var_float("dvbridge_black"), .data = &c->black, .dynamic = true}};
+    const bool black = c->black > 0.0f;
+    /* (Hades: with a black, its variable follows the levels where they are there, else the peak) */
+    if (black && !c->codes)
+        vars[1] = vars[2];
     const struct pl_custom_shader shader = {
         .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
-        .body = c->codes ? "color = clamp(color, 0.0, 1.0);\n"
+        .body = black ? (c->codes ? "color = clamp(color, 0.0, 1.0);\n" DISPLAY_BLACK_LIFT
+                                    "color.rgb = min(color.rgb, vec3(dvbridge_peak));\n" QUANTIZE_CODES
+                                  : "color = clamp(color, 0.0, 1.0);\n" DISPLAY_BLACK_LIFT
+                                    "color.rgb = min(color.rgb, vec3(dvbridge_peak));")
+              : c->codes ? "color = clamp(color, 0.0, 1.0);\n"
                            "color.rgb = min(color.rgb, vec3(dvbridge_peak));\n" QUANTIZE_CODES
                          : "color = clamp(color, 0.0, 1.0);\n"
                            "color.rgb = min(color.rgb, vec3(dvbridge_peak));",
-        .variables = vars, .num_variables = c->codes ? 2 : 1,
-        .description = c->codes ? "DV picture within the peak of the display it is mapped to, as "
+        .variables = vars, .num_variables = (c->codes ? 2 : 1) + (black ? 1 : 0),
+        .description = black ? (c->codes ? "DV picture within the peak of the display it is mapped to, its "
+                                           "black lifted to the display's, as 10-bit codes"
+                                         : "DV picture within the peak of the display it is mapped to, its "
+                                           "black lifted to the display's")
+                     : c->codes ? "DV picture within the peak of the display it is mapped to, as "
                                   "10-bit codes"
                                 : "DV picture within the peak of the display it is mapped to"};
     c->called = p->stage == PL_HOOK_OUTPUT && pl_shader_custom(p->sh, &shader);
@@ -2622,10 +2651,15 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
      * holds it within) */
     struct pl_color_map_params mapping;
     struct display_clamp to_display = {.codes = codes, .levels = 1023.0f};
+    /* Hades: with the display's black (an HDR10 target: dvbridge_hdr10_mapping::black), a shader of its own and
+     * signatures of their own; without it, the hook as before */
+    const bool lifted = r->hdr10_mapping.enabled && r->hdr10_mapping.target == DVBRIDGE_HDR10_TARGET_HDR10 &&
+                        r->hdr10_mapping.black > 0.0f;
     const struct pl_hook display_hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &to_display,
         .hook = clamp_to_display,
-        .signature = codes ? 0x4456424844523133ULL : 0x4456424844523131ULL};
+        .signature = lifted ? (codes ? 0x4456424844523135ULL : 0x4456424844523134ULL)
+                            : codes ? 0x4456424844523133ULL : 0x4456424844523131ULL};
     const struct pl_hook *display_hooks[] = {&display_hook};
     const bool peak_hook =
         r->hdr10_mapping.enabled && r->hdr10_mapping.target != DVBRIDGE_HDR10_TARGET_SDR;
@@ -2643,6 +2677,9 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     if (peak_hook) {
         to_display.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->hdr10_mapping.peak);
+        /* (Hades: the display's black on the scale of [0, its peak] in PQ, as for Low-Latency) */
+        if (lifted)
+            to_display.black = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->hdr10_mapping.black) / to_display.peak;
         params.hooks = display_hooks;
     }
     /* Hades: the trim pass of the display's target, before the clamp (dvbridge_trims.h) */
