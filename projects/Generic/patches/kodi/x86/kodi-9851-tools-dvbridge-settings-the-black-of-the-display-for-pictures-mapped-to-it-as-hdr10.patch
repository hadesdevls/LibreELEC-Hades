diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index f617ae2..75c04e8 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3457,6 +3457,28 @@ bool CWinSystemGbmGLESContext::Hdr10AdaptWanted(const VideoPicture& picture)
 
 namespace
 {
+//! Hades: the black of the display for a picture mapped to it as HDR10 (videoscreen.hadesdvhdr10black), within
+//! what the mapping takes (dvbridge_hdr10_mapping::black: 0 to 0.5 here, as the setting); 0 without it
+template<typename Settings>
+float Hdr10MappingBlack(const Settings& settings)
+{
+  const double black =
+      settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10BLACK)
+          ? settings->GetNumber(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10BLACK)
+          : 0.0;
+  return std::isfinite(black) ? static_cast<float>(std::clamp(black, 0.0, 0.5)) : 0.0f;
+}
+
+//! ... for the log
+std::string BlackText(float black)
+{
+  return black > 0.0f
+             ? StringUtils::Format("the black of the source lifted to the display's, {:.4f} cd/m2 "
+                                   "(the black level lift of BT.2390)",
+                                   black)
+             : std::string("the black of the source kept");
+}
+
 //! Hades: the EOTF of an SDR target, for the log
 std::string SdrEotfText(const dvbridge_hdr10_mapping& m)
 {
@@ -3495,6 +3517,8 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeHdr10AdaptMapping(const Vid
     if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE) &&
         settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE) != 1)
       mapping.curve = DVBRIDGE_HDR10_CURVE_SPLINE;
+    // Hades: and its black (videoscreen.hadesdvhdr10black)
+    mapping.black = Hdr10MappingBlack(settings);
   }
   if (picture.hasDisplayMetadata && picture.displayMetadata.has_primaries)
   {
@@ -3519,7 +3543,7 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeHdr10AdaptMapping(const Vid
   if (mapping.enabled)
     CLog::Log(LOGINFO,
               "DVBridge: an {} picture is adapted to the display: to {:.0f} cd/m2 and {}, with the "
-              "{} curve, guided by {}; the colours of the source within {}",
+              "{} curve, guided by {}; the colours of the source within {}; {}",
               picture.hdr10PlusDynamic ? "HDR10+" : "HDR10", mapping.peak, gamuts[mapping.gamut],
               mapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
