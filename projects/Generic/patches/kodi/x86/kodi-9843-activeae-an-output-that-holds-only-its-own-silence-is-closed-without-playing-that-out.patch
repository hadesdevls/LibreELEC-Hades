From c16b29877b772e73341c92237fb6d0bbc87ab977 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:12:47 +0000
Subject: [PATCH] ActiveAE: an output that holds only its own silence is closed
 without playing that out

CActiveAESink::CloseSink() drained the device before it closed it (Drain():
snd_pcm_drain() waits until what the device holds has played), also where
all it held was the silence that the sink writes while nothing plays, or
its pause bursts for passthrough. The start of a video does that twice.
The change of format closes the output of the menus, on the thread of the
audio engine. Then the output opened for the video is fed that silence
until the first frame is shown, and the change of the display mode that
goes out with that frame closes it (CActiveAE::OnLostDisplay(), DISPLAYLOST
for an HDMI output, UnconfigureSink()), while the thread of the interface
waits for the answer with the picture held. Each close waited for what the
device holds: 200 ms for passthrough at 192 kHz. In the users' logs that
time it (NVIDIA and Intel; HDR10 and Dolby Vision), the passes of the
interface of 379 to 614 ms that started a video spent 207 to 288 ms
between the notice of the change of mode and the video player's, which is
told after the audio engine (issue #3).

The sink now keeps when the last sound that it wrote (anything but its own
silence) will have been heard: the delay that the device gave just after
that write, and one period more (CSinkSound). CloseSink() plays the output
out until then, as before; after it, what is left is silence, which is let
go of at once, and kodi.log says so with what the device holds. That
silence was coming anyway: nothing that plays is cut, and the other drains
of the sink are as they were.

Measured on the host with a device of 200 ms fed as the sink feeds it: an
output that holds only silence closes in 0.0 ms instead of 200 ms; one
that holds a sound, or the end of one, is played out as before (200 ms).
---
 xbmc/cores/AudioEngine/CMakeLists.txt         |  1 +
 .../Engines/ActiveAE/ActiveAESink.cpp         | 24 ++++++-
 .../Engines/ActiveAE/ActiveAESink.h           |  4 ++
 .../Engines/ActiveAE/ActiveAESinkSound.h      | 70 +++++++++++++++++++
 4 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESinkSound.h

diff --git a/xbmc/cores/AudioEngine/CMakeLists.txt b/xbmc/cores/AudioEngine/CMakeLists.txt
index f945ac6..73bf306 100644
--- a/xbmc/cores/AudioEngine/CMakeLists.txt
+++ b/xbmc/cores/AudioEngine/CMakeLists.txt
@@ -27,6 +27,7 @@ set(HEADERS AEResampleFactory.h
             Engines/ActiveAE/ActiveAEFollowDisplay.h
             Engines/ActiveAE/ActiveAEFilter.h
             Engines/ActiveAE/ActiveAESink.h
+            Engines/ActiveAE/ActiveAESinkSound.h
             Engines/ActiveAE/ActiveAESound.h
             Engines/ActiveAE/ActiveAEStream.h
             Engines/ActiveAE/ActiveAESettings.h
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index d39fef1..d79fb93 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -1231,6 +1231,9 @@ void CActiveAESink::OpenSink()
   m_reopening = true;
   CloseSink();
   m_reopening = false;
+  // Hades: (an output opened anew holds nothing: also where it went without CloseSink(), after an
+  // error)
+  m_sound.Closed();
 
   // get the display name of the device
   GetDeviceFriendlyName(dev.name);
@@ -1359,8 +1362,17 @@ void CActiveAESink::CloseSink(const bool drain)
   if (!m_sink)
     return;
 
-  if (drain)
+  // Hades: played out only where it may hold a sound; the silence that the sink writes itself is
+  // let go of at once (CSinkSound)
+  if (drain && m_sound.Holds(std::chrono::steady_clock::now()))
     m_sink->Drain();
+  else if (drain)
+    CLog::LogF(
+        LOGINFO,
+        "the output held only the silence that it is fed while nothing plays: closed without "
+        "playing that out (it holds up to {:.0f} ms)",
+        m_sink->GetCacheTotal() * 1000.0);
+  m_sound.Closed();
 
   m_sink->Deinitialize();
   m_sink.reset();
@@ -1484,6 +1496,10 @@ unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples)
         m_sink->AddPause(samples->pkt->pause_burst_ms);
         m_sink->GetDelay(status);
         m_stats->UpdateSinkDelay(status, samples->pool ? 1 : 0);
+        // Hades: (as below: what the engine sent is played out when the output is closed)
+        if (samples != &m_sampleOfSilence && m_sinkFormat.m_sampleRate > 0)
+          m_sound.Wrote(std::chrono::steady_clock::now(), status.delay,
+                        static_cast<double>(m_sinkFormat.m_frames) / m_sinkFormat.m_sampleRate);
         return status.delay * 1000;
       }
     }
@@ -1543,6 +1559,12 @@ unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples)
     m_stats->UpdateSinkDelay(status, samples->pool ? 1 : 0);
   }
 
+  // Hades: a sound (anything but the sink's own silence) went to the device: the output is played
+  // out when it is closed, until that has been heard (CSinkSound)
+  if (samples != &m_sampleOfSilence && m_sinkFormat.m_sampleRate > 0)
+    m_sound.Wrote(std::chrono::steady_clock::now(), status.delay,
+                  static_cast<double>(m_sinkFormat.m_frames) / m_sinkFormat.m_sampleRate);
+
   return status.delay * 1000;
 }
 
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
index a8f8c9f..fe78590 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
@@ -11,6 +11,7 @@
 #include "cores/AudioEngine/AESinkFactory.h"
 #include "cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.h"
 #include "cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h"
+#include "cores/AudioEngine/Engines/ActiveAE/ActiveAESinkSound.h"
 #include "cores/AudioEngine/Interfaces/AE.h"
 #include "cores/AudioEngine/Interfaces/AESink.h"
 #include "cores/AudioEngine/Utils/AEPcmChannels.h"
@@ -185,6 +186,9 @@ protected:
   XbmcThreads::EndTime<> m_extSilenceTimer;
 
   CSampleBuffer m_sampleOfSilence;
+  //! Hades: whether what the output holds may be part of a sound, or is only m_sampleOfSilence:
+  //! the silence is let go of at once when the output is closed (CloseSink(), CSinkSound)
+  CSinkSound m_sound;
   enum
   {
     CHECK_SWAP,
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESinkSound.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESinkSound.h
new file mode 100644
index 0000000..618f4f2
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESinkSound.h
@@ -0,0 +1,70 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+
+namespace ActiveAE
+{
+/*!
+ * \brief Hades: whether what an output still holds may be part of a sound, or is only the silence
+ *        that the sink writes itself (CActiveAESink::CloseSink())
+ *
+ * CloseSink() plays out what the output holds before it closes it (IAESink::Drain()), so that the
+ * end of a sound is heard. Often it holds nothing but the silence that the sink writes while
+ * nothing plays (m_sampleOfSilence: silence, or its pause bursts for passthrough): at the start of
+ * a video the output is opened for the video's format and fed that silence until the first frame
+ * of the video is shown, and the change of the display mode that goes out with that frame closes
+ * it (CActiveAE, DISPLAYLOST, for an HDMI output); a change of format closes the output that was
+ * open (OpenSink()). Playing that silence out took as long as the device holds, 200 ms for
+ * passthrough at 192 kHz, and the thread that closes the output waits for it: at the change of
+ * mode, the thread of the interface, which tells the audio engine of it and waits for its answer,
+ * with the picture held (issue #3: the passes of the interface of 380 to 790 ms at the start of a
+ * video spent 200 to 290 ms of that between the notice of the change of mode and the video
+ * player's).
+ *
+ * A sound that the sink writes has been heard once the delay that the device gave just after that
+ * write has passed (AEDelayStatus::delay, what it holds ahead of the next frame), and one more
+ * period is allowed for a device that tells it late. From then on the output holds only silence,
+ * which is let go of at once: the same silence, cut short by the closing, which was coming anyway.
+ * A sound is played out as before.
+ */
+class CSinkSound
+{
+public:
+  using Clock = std::chrono::steady_clock;
+
+  //! The sink wrote a sound (anything but its own silence) at now; the device then held delay
+  //! seconds ahead of the next frame, and takes periods of period seconds
+  void Wrote(Clock::time_point now, double delay, double period)
+  {
+    const double ahead = std::max(delay, 0.0) + std::max(period, 0.0);
+    const Clock::time_point heard =
+        now + std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double>(ahead));
+    if (!m_wrote || heard > m_heardBy)
+      m_heardBy = heard;
+    m_wrote = true;
+  }
+
+  //! What the output holds at now may be part of a sound: it is played out before it is closed
+  bool Holds(Clock::time_point now) const { return m_wrote && now < m_heardBy; }
+
+  //! The output was closed, or opened anew: it holds nothing
+  void Closed()
+  {
+    m_wrote = false;
+    m_heardBy = {};
+  }
+
+private:
+  bool m_wrote = false;
+  Clock::time_point m_heardBy{};
+};
+} // namespace ActiveAE
