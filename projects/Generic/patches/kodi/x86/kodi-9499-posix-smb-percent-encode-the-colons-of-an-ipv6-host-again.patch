From 4044c430206b4dcdb46a2372c3507339fdcd77f0 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 19 Oct 2026 00:59:26 +0100
Subject: [PATCH] [posix][smb] percent encode the colons of an IPv6 host again

libsmbclient's SMBC_parse_path() splits the server at the first literal
':' to find a port and has no notion of brackets, so a bracketed IPv6
host makes smbc_opendir() fail with EINVAL + 8194. That is the "Unknown
error: 8216" seen when a share's host name resolves to an IPv6 address.

The server is URL-decoded after the port split, so the encoded form is
the one libsmbclient reads back as an address, with or without a port.

Undoes the host handling of commit a0633794326b.

Fixes #29933

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/platform/posix/filesystem/SMBFile.cpp       | 16 +++-------------
 .../posix/filesystem/test/TestSMBFile.cpp        | 12 ++++++------
 2 files changed, 9 insertions(+), 19 deletions(-)

diff --git a/xbmc/platform/posix/filesystem/SMBFile.cpp b/xbmc/platform/posix/filesystem/SMBFile.cpp
index cc5c449..840436f 100644
--- a/xbmc/platform/posix/filesystem/SMBFile.cpp
+++ b/xbmc/platform/posix/filesystem/SMBFile.cpp
@@ -676,19 +676,9 @@ std::string CSMB::URLEncode(const CURL& url)
     }
     flat += "@";
   }
-  const std::string& hostName = url.GetHostName();
-  if (hostName.find(':') != std::string::npos)
-  {
-    /* an IPv6 literal has to be bracketed and its colons must stay unencoded, otherwise
-       libsmbclient cannot read it back as an address */
-    flat += '[';
-    flat += hostName;
-    flat += ']';
-  }
-  else
-  {
-    flat += URLEncode(hostName);
-  }
+  /* libsmbclient takes the first literal ':' in the server as the port separator and
+     doesn't understand brackets, so the colons of an IPv6 host have to stay encoded */
+  flat += URLEncode(url.GetHostName());
 
   if (url.HasPort())
   {
diff --git a/xbmc/platform/posix/filesystem/test/TestSMBFile.cpp b/xbmc/platform/posix/filesystem/test/TestSMBFile.cpp
index 789af0c..404fe9b 100644
--- a/xbmc/platform/posix/filesystem/test/TestSMBFile.cpp
+++ b/xbmc/platform/posix/filesystem/test/TestSMBFile.cpp
@@ -752,21 +752,21 @@ TEST(TestSMBUrlEncode, FileNameIsEncoded)
   EXPECT_EQ(smb.URLEncode(url), "smb://MEDIABOX/MEDIA/TEST/01%20Mr.%20Blue%20Sky.flac");
 }
 
-TEST(TestSMBUrlEncode, IPv6HostNameIsBracketed)
+TEST(TestSMBUrlEncode, IPv6HostNameIsEncoded)
 {
   const CURL url("smb://kodi:secret@[fd00::1]/MEDIA/TEST");
-  EXPECT_EQ(smb.URLEncode(url), "smb://kodi:secret@[fd00::1]/MEDIA/TEST");
+  EXPECT_EQ(smb.URLEncode(url), "smb://kodi:secret@fd00%3a%3a1/MEDIA/TEST");
 }
 
-TEST(TestSMBUrlEncode, IPv6HostNameWithPortIsBracketed)
+TEST(TestSMBUrlEncode, IPv6HostNameWithPortIsEncoded)
 {
   const CURL url("smb://[fd00::1]:445/MEDIA/TEST");
-  EXPECT_EQ(smb.URLEncode(url), "smb://[fd00::1]:445/MEDIA/TEST");
+  EXPECT_EQ(smb.URLEncode(url), "smb://fd00%3a%3a1:445/MEDIA/TEST");
 }
 
-TEST(TestSMBUrlEncode, IPv6HostNameSubstitutedForAResolvedNameIsBracketed)
+TEST(TestSMBUrlEncode, IPv6HostNameSubstitutedForAResolvedNameIsEncoded)
 {
   CURL url("smb://kodi:secret@MEDIABOX/MEDIA/TEST");
   url.SetHostName("fd00::1");
-  EXPECT_EQ(smb.URLEncode(url), "smb://kodi:secret@[fd00::1]/MEDIA/TEST");
+  EXPECT_EQ(smb.URLEncode(url), "smb://kodi:secret@fd00%3a%3a1/MEDIA/TEST");
 }
