+bool CDRMAtomic::MakeBlackPicture(BlackPicture& picture, uint32_t width, uint32_t height) const
+{
+  drm_mode_create_dumb create{};
+  create.width = width;
+  create.height = height;
+  create.bpp = 32;
+  if (drmIoctl(m_fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) != 0)
+    return false;
+  const auto destroy = [this, &create]
+  {
+    drm_mode_destroy_dumb d{};
+    d.handle = create.handle;
+    drmIoctl(m_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &d);
+  };
+  // (black: XRGB8888 of zeros, written here rather than taken from the driver)
+  drm_mode_map_dumb map{};
+  map.handle = create.handle;
+  if (drmIoctl(m_fd, DRM_IOCTL_MODE_MAP_DUMB, &map) != 0)
+  {
+    destroy();
+    return false;
+  }
+  void* pixels = mmap(nullptr, create.size, PROT_WRITE, MAP_SHARED, m_fd, map.offset);
+  if (pixels == MAP_FAILED)
+  {
+    destroy();
+    return false;
+  }
+  std::memset(pixels, 0, create.size);
+  munmap(pixels, create.size);
+  uint32_t handles[4] = {create.handle, 0, 0, 0};
+  uint32_t pitches[4] = {create.pitch, 0, 0, 0};
+  uint32_t offsets[4] = {0, 0, 0, 0};
+  uint32_t fb = 0;
+  if (drmModeAddFB2(m_fd, width, height, DRM_FORMAT_XRGB8888, handles, pitches, offsets, &fb, 0) !=
+      0)
+  {
+    destroy();
+    return false;
+  }
+  picture.handle = create.handle;
+  picture.fb = fb;
+  picture.size = create.size;
+  return true;
+}
+
+bool CDRMAtomic::BringBack(int flags)
+{
+  using KEEP_OUTPUTS::BringBackResult;
+  using KEEP_OUTPUTS::BringBackWay;
+  std::vector<std::string> pending;
+  pending.swap(m_soundBringBack); // (what is to be asked again goes back in)
+  for (const std::string& name : pending)
+  {
+    const auto it = std::ranges::find_if(GetConnectors(),
+                                         [&name](const auto& c) { return c->GetName() == name; });
+    CDRMConnector* connector = it != GetConnectors().end() ? it->get() : nullptr;
+    if (!connector || connector == m_connector)
+      continue;
+    if (connector->GetPropertyValue("CRTC_ID").value_or(0) != 0)
+    {
+      CLog::LogF(LOGINFO, "{} drives a CRTC again: nothing to light for the sound in use", name);
+      continue;
+    }
+    if (!connector->IsConnected())
+    {
+      CLog::LogF(LOGINFO, "{}: nothing is connected to it now: it is not lit again", name);
+      continue;
+    }
+
+    // its mode: the one it had when Kodi turned it off, else the one its display prefers (of its
+    // modes without a 3D layout), else the largest (PlanOutputMove())
+    drmModeModeInfo mode{};
+    bool hasMode = false;
+    const auto off = m_offOutputs.find(name);
+    if (off != m_offOutputs.end() && off->second.hasMode)
+    {
+      mode = off->second.mode;
+      hasMode = true;
+    }
+    for (int i = 0, area = 0; !hasMode && i < connector->GetModesCount(); i++)
+    {
+      const drmModeModeInfo* m = connector->GetModeForIndex(i);
+      if (m->flags & DRM_MODE_FLAG_3D_MASK)
+        continue;
+      if (m->type & DRM_MODE_TYPE_PREFERRED || m->hdisplay * m->vdisplay > area)
+      {
+        mode = *m;
+        area = m->hdisplay * m->vdisplay;
+        if (m->type & DRM_MODE_TYPE_PREFERRED)
+          hasMode = true;
+      }
+    }
+    if (!hasMode && mode.hdisplay == 0)
+    {
+      CLog::LogF(LOGWARNING, "{}: its display has no mode: it is not lit again", name);
+      continue;
+    }
+
+    // its CRTC: the one it had, where that is free, else a free one that can drive it
+    uint32_t possible = 0;
+    const std::vector<uint32_t> encoders = connector->GetEncoderIds();
+    for (const auto& encoder : GetEncoders())
+    {
+      if (std::ranges::find(encoders, encoder->GetEncoderId()) != encoders.end())
+        possible |= encoder->GetPossibleCrtcsMask();
+    }
+    uint32_t busy = 0;
+    int had = -1;
+    const auto& crtcs = GetCrtcs();
+    for (std::size_t i = 0; i < crtcs.size() && i < 32; ++i)
+    {
+      const uint64_t id = crtcs[i]->GetId();
+      const bool named = std::ranges::any_of(GetConnectors(), [id](const auto& c)
+                                             { return c->GetPropertyValue("CRTC_ID") == id; }) ||
+                         m_req->Value(crtcs[i].get(), "ACTIVE").value_or(0) != 0;
+      if (crtcs[i]->GetPropertyValue("ACTIVE").value_or(0) != 0 || named)
+        busy |= uint32_t{1} << i;
+      if (off != m_offOutputs.end() && crtcs[i]->GetCrtcId() == off->second.crtcId)
+        had = static_cast<int>(i);
+    }
+    const int at = KEEP_OUTPUTS::BringBackCrtc(
+        possible, busy, had, static_cast<int>(m_crtc->GetOffset()), static_cast<int>(crtcs.size()));
+    if (at < 0)
+    {
+      CLog::LogF(LOGWARNING,
+                 "{} carries the sound in use, but no CRTC that is off can drive it: it stays off; "
+                 "its sound comes back when Kodi starts again",
+                 name);
+      continue;
+    }
+    CDRMCrtc* crtc = crtcs[at].get();
+    LitAgain& lit = m_litAgain[name];
+    // (the blob of an earlier try lives on: a request that the driver took may name it)
+    if (lit.mode.IsValid())
+      lit.before.push_back(std::move(lit.mode));
+    lit.mode = CDRMPropertyBlob(m_fd, &mode, sizeof(mode));
+    if (!lit.mode.IsValid())
+    {
+      CLog::LogF(LOGWARNING, "{}: its mode could not be given to the driver: it stays off", name);
+      continue;
+    }
+
+    using Property = std::tuple<CDRMObject*, const char*, uint64_t>;
+    std::optional<std::vector<Property>> taken;
+    std::string how;
+    int error = 0;
+    for (const BringBackWay way : KEEP_OUTPUTS::BringBackWays(HasQuirk(QUIRK_NEEDSPRIMARY)))
+    {
+      std::vector<Property> properties{{connector, "CRTC_ID", crtc->GetCrtcId()},
+                                       {crtc, "MODE_ID", lit.mode.Get()},
+                                       {crtc, "ACTIVE", 1}};
+      if (way == BringBackWay::BLACK_PICTURE)
+      {
+        // a primary plane of that CRTC that shows nothing now, and a black picture of the size of
+        // the mode, made once
+        CDRMPlane* plane = nullptr;
+        for (const auto& p : m_planes)
+        {
+          if (p.get() == m_gui_plane || p.get() == m_video_plane ||
+              p->GetPropertyValue("CRTC_ID").value_or(0) != 0)
+            continue;
+          if (p->Check(mode.hdisplay, mode.vdisplay, DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_LINEAR,
+                       crtc, PLANE_TYPE_PRIMARY) ||
+              p->Check(mode.hdisplay, mode.vdisplay, DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_INVALID,
+                       crtc, PLANE_TYPE_PRIMARY))
+          {
+            plane = p.get();
+            break;
+          }
+        }
+        if (!plane)
+        {
+          how = "no primary plane of its CRTC is free";
+          continue;
+        }
+        if (!lit.black.fb && !MakeBlackPicture(lit.black, mode.hdisplay, mode.vdisplay))
+        {
+          how = "no black picture could be made for it";
+          continue;
+        }
+        properties.insert(properties.end(), {{plane, "FB_ID", lit.black.fb},
+                                             {plane, "CRTC_ID", crtc->GetCrtcId()},
+                                             {plane, "SRC_X", 0},
+                                             {plane, "SRC_Y", 0},
+                                             {plane, "SRC_W", uint64_t{mode.hdisplay} << 16},
+                                             {plane, "SRC_H", uint64_t{mode.vdisplay} << 16},
+                                             {plane, "CRTC_X", 0},
+                                             {plane, "CRTC_Y", 0},
+                                             {plane, "CRTC_W", mode.hdisplay},
+                                             {plane, "CRTC_H", mode.vdisplay}});
+      }
+
+      // the whole commit with it, asked first (TEST_ONLY)
+      drmModeAtomicReqPtr test = drmModeAtomicDuplicate(m_req->Get());
+      bool made = test != nullptr;
+      for (const auto& [object, property, value] : properties)
+      {
+        const uint32_t id = object->GetPropertyId(property);
+        made = made && id != 0 && drmModeAtomicAddProperty(test, object->GetId(), id, value) >= 0;
+      }
+      const bool ok = made && drmModeAtomicCommit(m_fd, test,
+                                                  flags | DRM_MODE_ATOMIC_TEST_ONLY |
+                                                      DRM_MODE_ATOMIC_ALLOW_MODESET,
+                                                  nullptr) == 0;
+      error = made ? errno : EINVAL;
+      if (test)
+        drmModeAtomicFree(test);
+      if (ok)
+      {
+        taken = std::move(properties);
+        how = way == BringBackWay::BLACK ? "black, with nothing on it"
+                                         : "black, with a black picture of its own";
+        break;
+      }
+      how = std::string("the driver would not take it ") +
+            (way == BringBackWay::BLACK ? "with nothing on it" : "with a black picture") + " (" +
+            strerror(error) + ")";
+    }
+
+    const bool without =
+        !taken &&
+        drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr) == 0;
+    switch (KEEP_OUTPUTS::BringBackVerdict(taken.has_value(), without))
+    {
+      case BringBackResult::TAKEN:
+        for (const auto& [object, property, value] : *taken)
+          AddProperty(object, property, value);
+        m_bringingBack.push_back(name);
+        CLog::LogF(LOGINFO,
+                   "{} carries the sound in use: it is lit again in this change of mode, on CRTC "
+                   "{} in {}x{} @ {} Hz, {}",
+                   name, crtc->GetCrtcId(), mode.hdisplay, mode.vdisplay, mode.vrefresh, how);
+        break;
+      case BringBackResult::REFUSED:
+        CLog::LogF(LOGWARNING,
+                   "{} carries the sound in use, but the driver takes this change of mode only "
+                   "without it lit again ({}): it stays off; its sound comes back when Kodi starts "
+                   "again",
+                   name, how);
+        break;
+      case BringBackResult::LATER:
+        // (the driver does not take this commit even without it: nothing is known of it)
+        m_soundBringBack.push_back(name);
+        CLog::LogF(LOGDEBUG, "{}: the commit is refused on its own: asked with the next one", name);
+        break;
+    }
+  }
+  return !m_bringingBack.empty();
+}
