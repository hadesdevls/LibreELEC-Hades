+void CDRMUtils::QueueSoundBringBack(CDRMConnector& connector, const char* why)
+{
+  const std::string output = connector.GetName();
+  if (std::ranges::find(m_soundBringBack, output) != m_soundBringBack.end())
+    return;
+  m_soundBringBack.push_back(output);
+  CLog::LogF(LOGINFO,
+             "{}: {} carries the sound in use, but {}: it is lit again in the next commit that "
+             "changes a display mode anyway (a video that changes it), or when Kodi starts again; "
+             "the user is told",
+             m_node, output, why);
+  const std::string display =
+      connector.IsConnected() ? IdentityOf(connector.GetEDID(), output).Describe() : output;
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Info,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(292),
+      StringUtils::Format(CGUIUtils::GetHadesString(41010, 32440), display), 10000);
+}
