+/*!
+ * \brief Hades: how an output of Kodi's own device that Kodi turned off, and whose sound is in use
+ *        now, is lit again (CDRMAtomic::BringBack()), in the order in which the driver is asked:
+ *        black with nothing on it where the driver keeps a CRTC on with no plane; then with a black
+ *        picture of its own on a primary plane (amdgpu needs one, QUIRK_NEEDSPRIMARY)
+ */
+enum class BringBackWay
+{
+  BLACK, //!< its CRTC on in its mode, no plane on it
+  BLACK_PICTURE, //!< ... with a black buffer that Kodi makes for it on a primary plane
+};
+
+inline std::vector<BringBackWay> BringBackWays(bool needsPrimary)
+{
+  if (needsPrimary)
+    return {BringBackWay::BLACK_PICTURE};
+  return {BringBackWay::BLACK, BringBackWay::BLACK_PICTURE};
+}
+
+/*!
+ * \brief Hades: the CRTC to light such an output on: the one it had, where that is free (not the
+ *        one in use, not on, not named by another output), else the first free one that can drive
+ *        it; -1 when there is none
+ * \param busy the CRTCs that are on or that an output names (a mask by index)
+ * \param had the index of the CRTC it had when Kodi turned it off; -1 when not known
+ */
+inline int BringBackCrtc(uint32_t possible, uint32_t busy, int had, int inUse, int count)
+{
+  if (had >= 0 && had < count && had < 32 && had != inUse && ((possible >> had) & 1) &&
+      !((busy >> had) & 1))
+    return had;
+  return FreeCrtcForMove(possible, busy, inUse, count);
+}
+
+//! Hades: what became of lighting such an output again in a commit that changes a mode
+enum class BringBackResult
+{
+  TAKEN, //!< the driver takes the commit with it: it goes with the commit
+  REFUSED, //!< the driver takes the commit without it only: it stays off, and is not asked again
+  LATER, //!< the driver does not take the commit even without it: asked again with the next one
+};
+
+inline BringBackResult BringBackVerdict(bool takenWithIt, bool takenWithout)
+{
+  if (takenWithIt)
+    return BringBackResult::TAKEN;
+  return takenWithout ? BringBackResult::REFUSED : BringBackResult::LATER;
+}
