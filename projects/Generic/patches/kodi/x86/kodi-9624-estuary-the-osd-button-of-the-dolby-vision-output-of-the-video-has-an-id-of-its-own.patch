From 5a549102482c2dc311df926b9e47927363ad3cc0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 20:28:37 +0000
Subject: [PATCH] estuary: the OSD button of the Dolby Vision output of the
 video has an id of its own

75a5d02 gave the button of "Dolby Vision output (this video)" in the
video OSD the control id 70050. Estuary already uses 70050 for the RDS
button of its music OSD (MusicOSD.xml), and OSDHelpTextVar
(Variables.xml), the help line that both OSDs show, maps that id to
"RadioText Plus info" (#29900): focusing the Dolby Vision button showed
that text (seen on screen in 1.0 RC6).

The button is now 70056, which no control of Estuary has and nothing
refers to (searched in every XML file of Estuary, in xbmc/ and in the
Hades files of the LibreELEC tree: nothing named 70050 but Estuary's own
RDS button, its help line and an ondown of MyWeather.xml, a control of
that window). Nothing else referred to the button by its id: it is
reached by the order of its grouplist, and it opens the choice with
PlayerControl(HadesDVOutput). Its help line is the name of the button,
$LOCALIZE[31762] (Estuary's translation of #39820).

Looked for the same fault in the other controls of Hades: the other
button of Hades in the video OSD, 70049 (the player information), has
its own line in OSDHelpTextVar (#31682) and no other control of Estuary
has that id; the controls of Hades in the player information (5555,
5556, 5560) are each once in that window.

Only the screen shows the help line: focus the button with a Dolby
Vision video that has more than one output to choose from.
---
 addons/skin.estuary/xml/Variables.xml | 2 ++
 addons/skin.estuary/xml/VideoOSD.xml  | 6 ++++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index bb251bf..e47d7be 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -378,6 +378,8 @@
 		<value condition="Control.HasFocus(70054) + Playlist.IsRandom">$LOCALIZE[590]: $LOCALIZE[16041]</value>
 		<value condition="Control.HasFocus(70054)">$LOCALIZE[590]: $LOCALIZE[16039]</value>
 		<value condition="Control.HasFocus(70055)">$LOCALIZE[24013]</value>
+		<!-- Hades: the button of "Dolby Vision output (this video)" of the video OSD -->
+		<value condition="Control.HasFocus(70056)">$LOCALIZE[31762]</value>
 	</variable>
 	<variable name="SkinSettingsHelpTextVar">
 		<value condition="Container(9000).HasFocus(1)">$LOCALIZE[31129]</value>
diff --git a/addons/skin.estuary/xml/VideoOSD.xml b/addons/skin.estuary/xml/VideoOSD.xml
index bc59d33..59b7d97 100644
--- a/addons/skin.estuary/xml/VideoOSD.xml
+++ b/addons/skin.estuary/xml/VideoOSD.xml
@@ -187,8 +187,10 @@
 						<onclick>Dialog.Close(VideoOSD)</onclick>
 						<onclick>ActivateWindow(playerprocessinfo)</onclick>
 					</control>
-					<!-- Hades: "Dolby Vision output (this video)", where there is more than one to choose from -->
-					<control type="radiobutton" id="70050">
+					<!-- Hades: "Dolby Vision output (this video)", where there is more than one to choose from.
+					     (70056: no other control of Estuary has it; 70050 is the RDS button of MusicOSD.xml, and
+					     OSDHelpTextVar, which both OSDs show, names that one) -->
+					<control type="radiobutton" id="70056">
 						<include content="OSDButton">
 							<param name="texture" value="osd/fullscreen/buttons/dvoutput.png"/>
 						</include>
-- 
2.53.0

