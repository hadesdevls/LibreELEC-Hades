From 3c367fab57dce6a159e8ae2aac2d4f8e0aa6ce12 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:12:48 +0000
Subject: [PATCH] utils: YCbCr 4:2:2 of an EDID with more than one CTA block is
 what its last block says, as the kernel reads it

EdidDeclaresYcbcr422() is to say what the kernel reads of the display (drm_edid.c), for
HDR over the tunnel as YCbCr 4:2:2, which the kernel allows only where the display info
has that format (linux-9974, linux-9975: display_info.color_formats). It said yes where
any CTA block had the bit. drm_parse_cea_ext() of Linux 7.3, the kernel of this build,
sets the colour formats again from each CTA block in turn, so for an EDID with two CTA
blocks it is the last that counts: with the bit in the first only, Hades chose the tunnel
and the kernel refused it.

The bit of the last valid CTA block is the answer. One block, and the bit in the last of
two, are as before.

Host test (outside the tree): the host test of the tunnel (hdr10t_kodi_test.cpp) with one more EDID, the bit in the first CTA block only; it fails
with the header before and passes after (51272 checks).
---
 xbmc/utils/EdidYcbcr422.h | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/xbmc/utils/EdidYcbcr422.h b/xbmc/utils/EdidYcbcr422.h
index 8812115..f0b437d 100644
--- a/xbmc/utils/EdidYcbcr422.h
+++ b/xbmc/utils/EdidYcbcr422.h
@@ -20,6 +20,8 @@ namespace KODI::UTILS
  *        kernel reads it (drm_edid.c: EDID_CEA_YCRCB422), which is what the tunnel of HDR as
  *        YCbCr 4:2:2 asks of the display (drm_dvbridge_hdr10t.h)
  *
+ * The kernel of this build (drm_parse_cea_ext() of Linux 7.3) sets the colour formats again from
+ * each CTA block in turn, so that of an EDID with more than one it is the last block that says.
  * A block with a wrong checksum counts for nothing (DRM takes such blocks out before a driver reads
  * the EDID). The 4:2:2 bit that EDID 1.4 has in its base block is not read: where only that says
  * it, the kernel says yes and this says no, which keeps the tunnel off, the safe side.
@@ -29,16 +31,17 @@ inline bool EdidDeclaresYcbcr422(const std::vector<uint8_t>& edid)
   const size_t size = edid.size();
   if (size < 256 || size % 128)
     return false;
+  bool declared = false;
   for (size_t block = 1; block < size / 128; ++block)
   {
     const uint8_t* b = edid.data() + block * 128;
     unsigned int sum = 0;
     for (unsigned int i = 0; i < 128; ++i)
       sum += b[i];
-    if ((sum & 0xff) == 0 && b[0] == 0x02 && (b[3] & 0x10))
-      return true;
+    if ((sum & 0xff) == 0 && b[0] == 0x02)
+      declared = (b[3] & 0x10) != 0;
   }
-  return false;
+  return declared;
 }
 
 } // namespace KODI::UTILS
