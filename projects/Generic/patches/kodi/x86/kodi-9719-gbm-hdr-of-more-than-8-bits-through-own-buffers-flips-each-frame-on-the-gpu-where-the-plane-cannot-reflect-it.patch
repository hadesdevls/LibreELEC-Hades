-    return false;
-  }
+  // these buffers is upside down for the display: the plane reflects it (CDRMUtils::SetReflectY()),
+  // or, where the plane cannot, the GPU flips each frame when it is swapped (COwnScanout, one
+  // blit of the picture that copies every value as it is).
+  const bool flipOnGpu = !CDRMUtils::CanReflectY(plane);
 
   std::vector<const outputformat*> candidates;
   for (const auto& format : m_DRM->GetOutputFormats())
@@ -875,12 +869,14 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
       continue;
     std::string failed;
     auto own = COwnScanout::Create(m_GBM->GetDevice().Get(), m_eglContext.GetEGLDisplay(), m_nWidth,
-                                   m_nHeight, format->drm, format->modifiers, failed);
-    if (own)
+                                   m_nHeight, format->drm, format->modifiers, flipOnGpu, failed);
+    if (own && !flipOnGpu)
       m_DRM->SetReflectY(true);
     if (own && !m_DRM->TestFramebuffer(own->FirstBuffer()))
     {
-      failed = "the driver refused, in a test, a commit of the plane with one of them";
+      failed = flipOnGpu ? "the driver refused, in a test, a commit of the plane with one of them"
+                         : "the driver refused, in a test, a commit of the plane with one of them "
+                           "and its reflection";
       own.reset();
     }
     if (!own)
@@ -923,14 +919,18 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
       m_DRM->AllowModeset();
     CLog::LogF(LOGINFO,
                "HDR output: video of more than 8 bits goes out at {} bits through {} buffers of {} "
-               "(modifier {}) that Kodi allocates itself and draws into, {}x{}, reflected from top "
-               "to bottom by the plane: {}; checked before use (values of more than 8 bits written "
-               "and read back, and a test commit with the reflection)",
+               "(modifier {}) that Kodi allocates itself and draws into, {}x{}, {}: {}; checked "
+               "before use (values of more than 8 bits written and read back, {})",
                own->OutputBits() == 16 ? "more than 10" : "10", COwnScanout::BUFFERS,
                DRMHELPERS::FourCCToString(own->Format()),
                DRMHELPERS::ModifierToString(own->Modifier()), m_nWidth, m_nHeight,
+               flipOnGpu ? "flipped from top to bottom by the GPU when each frame is swapped (the "
+                           "plane cannot reflect them)"
+                         : "reflected from top to bottom by the plane",
                m_floatOutputSupported ? "the EGL of nvidia-drm offers no window of that depth"
-                                      : "asked for in advancedsettings.xml (hdrownbuffersalways)");
+                                      : "asked for in advancedsettings.xml (hdrownbuffersalways)",
+               flipOnGpu ? "a frame flipped by the GPU and read back, and a test commit"
+                         : "and a test commit with the reflection");
     return true;
   }
   return false;
