 tools/dvbridge/dvbridge_render.c |  55 ++++-
 tools/dvbridge/dvbridge_render.h |  13 ++
 tools/dvbridge/dvbridge_source.c | 335 ++++++++++++++++++++++++++++---
 tools/dvbridge/dvbridge_source.h |  23 ++-
 4 files changed, 401 insertions(+), 25 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b7b8ee7..99fbe22 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -74,6 +74,9 @@ struct dvbridge_renderer {
