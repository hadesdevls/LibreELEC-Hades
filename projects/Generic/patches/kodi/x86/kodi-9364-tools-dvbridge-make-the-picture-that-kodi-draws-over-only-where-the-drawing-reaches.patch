     pl_tex window;
+    /* Hades: what will be drawn over the next composed picture (dvbridge_render_set_drawn()) */
+    unsigned drawn_gui;
+    int drawn_w, drawn_h;
 };
 
 /* Hades: the alpha of the picture of the composed way, that Kodi draws over: its blend functions
@@ -676,6 +679,9 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         ok = ok && source_pack(r, 0, fbo, flip);
     } else if (ok) {
         pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, &fbo);
+        /* Hades: in the tiles that what will be drawn over it may reach, where the caller said what
+         * that is (dvbridge_render_set_drawn()) */
+        dvbridge_source_drawn(r->source_packer, r->drawn_gui, r->drawn_w, r->drawn_h);
         ok = fbo && dvbridge_source_picture(r->source_packer, &r->source_params, luma,
                                             geometry.source_width, geometry.source_height,
                                             geometry.x, geometry.y, margins, fbo);
@@ -704,6 +710,9 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     r->packed = packed != NULL;
     dvbridge_candidate_destroy(r->pending);
     r->pending = NULL;
+    /* Hades: the picture that a composed render of the source transport made in the tiles of what
+     * was drawn over it is another frame's */
+    dvbridge_source_forget(r->source_packer);
     if (!source || !isfinite(pts) || source->num_planes < 1 || source->num_planes > 4 || source->rotation ||
         source->crop.x0 != 0 || source->crop.y0 != 0 ||
         source->crop.x1 != geometry.source_width || source->crop.y1 != geometry.source_height)
@@ -903,6 +912,9 @@ bool dvbridge_render_rgb(struct dvbridge_renderer *r, const struct pl_frame *sou
     save_gl_state(&state);
     bool ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, NULL, false);
     restore_gl_state(&state);
+    /* Hades: what was to be drawn over this frame (dvbridge_render_set_drawn()) is this frame's */
+    if (r)
+        r->drawn_gui = 0;
     return ok;
 }
 
@@ -910,8 +922,12 @@ bool dvbridge_render_packed(struct dvbridge_renderer *r, const struct pl_frame *
                            const void *metadata, size_t bytes, double pts, double el_pts,
                            struct dvbridge_geometry geometry, pl_tex target, bool flip)
 {
-    if (r)
+    if (r) {
         r->ready = false;
+        /* (Hades: nothing is drawn over a frame drawn directly; a frame that is composed after
+         * this one was refused is told again) */
+        r->drawn_gui = 0;
+    }
     /* (Hades: the converted transport's direct way also needs quad operations and a picture that
      * fills the raster, which render() checks: the source transport packs a picture drawn at its own
      * size anywhere, without them) */
@@ -1328,10 +1344,17 @@ struct kept_state {
     bool source;
     const char *source_why;
     struct dvbridge_geometry geometry;
+    unsigned drawn_gui;
+    int drawn_w, drawn_h;
 };
 
 static void keep_state(struct dvbridge_renderer *r, struct kept_state *k)
 {
+    /* Hades: (what is to be drawn over the next frame is not drawn over these) */
+    k->drawn_gui = r->drawn_gui;
+    k->drawn_w = r->drawn_w;
+    k->drawn_h = r->drawn_h;
+    r->drawn_gui = 0;
     k->pending = r->pending;
     r->pending = NULL;
     k->ready = r->ready;
@@ -1372,6 +1395,11 @@ static void give_back_state(struct dvbridge_renderer *r, const struct kept_state
     r->source = k->source;
     r->source_why = k->source_why;
     r->geometry = k->geometry;
+    r->drawn_gui = k->drawn_gui;
+    r->drawn_w = k->drawn_w;
+    r->drawn_h = k->drawn_h;
+    /* (the picture that these made is not the frames') */
+    dvbridge_source_forget(r->source_packer);
     /* the picture was drawn into: what is outside the place of the next one is not known to be
      * black (it is cleared then, which writes the same bytes) */
     r->rgb_clean = false;
@@ -1508,6 +1536,31 @@ void dvbridge_render_set_window(struct dvbridge_renderer *r, pl_tex window)
         r->window = window;
 }
 
+void dvbridge_render_set_drawn(struct dvbridge_renderer *r, unsigned gui, int width, int height)
+{
+    if (!r)
+        return;
+    r->drawn_gui = gui;
+    r->drawn_w = width;
+    r->drawn_h = height;
+}
+
+bool dvbridge_render_complete(struct dvbridge_renderer *r)
+{
+    /* only the composed way of the source transport makes its picture in tiles */
+    if (!r || !r->ready || r->packed || !r->source || !r->source_packer)
+        return true;
+    unsigned margins[4], fbo = 0;
+    if (!r->pending || !dvbridge_active_area(r->pending, margins))
+        return false;
+    pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, &fbo);
+    const unsigned luma = pl_opengl_unwrap(r->gpu, r->planes[0], NULL, NULL, NULL);
+    return fbo && luma &&
+           dvbridge_source_complete(r->source_packer, &r->source_params, luma,
+                                    r->geometry.source_width, r->geometry.source_height,
+                                    r->geometry.x, r->geometry.y, margins, fbo);
+}
+
 bool dvbridge_render_source(const struct dvbridge_renderer *r, const char **why)
 {
     if (why)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 34f5737..a1f6457 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -236,6 +236,19 @@ bool dvbridge_render_source_planes(const struct dvbridge_renderer *renderer, uns
  * or destroyed (another object may take its address). */
 #define DVBRIDGE_RENDER_WINDOW 1
 void dvbridge_render_set_window(struct dvbridge_renderer *renderer, pl_tex window);
+/* Hades: what will be drawn over the picture of the next dvbridge_render_rgb(), where it is known
+ * before: the GL texture gui (width x height) composited over it as Kodi composites its GUI
+ * (dvbridge_source_drawn()), and nothing else. The composed way of the source transport then makes
+ * the picture that Kodi draws over only where that may reach, and packs the frame reading it there
+ * only (the same bytes: nothing is drawn over it elsewhere). 0: not known, the whole picture, as
+ * without it. For that frame only. Anything else that is to be drawn over the picture (subtitles
+ * drawn into it, a capture that reads it) asks for the rest of it first: dvbridge_render_complete(). */
+#define DVBRIDGE_RENDER_DRAWN 1
+void dvbridge_render_set_drawn(struct dvbridge_renderer *renderer, unsigned gui, int width,
+                               int height);
+/* Hades: the picture of the last dvbridge_render_rgb() whole, if it was made in tiles; false where
+ * that could not be done (the picture is then whole only in those tiles) */
+bool dvbridge_render_complete(struct dvbridge_renderer *renderer);
 /* Whether dvbridge_render_packed() may draw a picture of this geometry: full raster, or, with the
  * source transport, a picture drawn at its own size anywhere */
 bool dvbridge_render_direct_fits(const struct dvbridge_renderer *renderer,
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 7124a90..3f241af 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -179,7 +179,24 @@ bool dvbridge_source_setup(struct dvbridge_source_params *out, const void *metad
  *  4. the transport: per pixel its luma, the chroma of its pair, the metadata bit
  *     (dvbridge_source_pack()).
  * The planes hold h / 2^bits, and passes 1, 2 and the pixels of 4 that nothing was drawn over are
- * integer arithmetic: they get the same bytes on any GPU. */
+ * integer arithmetic: they get the same bytes on any GPU.
+ * Hades: where what is drawn over the picture is known before it is drawn (Kodi's GUI, composited
+ * from a texture: dvbridge_source_drawn()), the tiles of the raster (DRAWN_TILE x DRAWN_TILE
+ * pixels) that it may reach are found first (passes 6 and 7), and passes 3 and 4 read and write the
+ * picture that Kodi draws over in those tiles only: everywhere else nothing is drawn over the
+ * picture, and pass 4 takes the codes of the transport there, as it did where it read an alpha of
+ * 2. What else is drawn over it (PQ subtitles, a capture) asks for the rest of that picture first
+ * (dvbridge_source_complete()). */
+#define DRAWN_TILE 16
+#define DRAWN_COLUMNS ((3840 + DRAWN_TILE - 1) / DRAWN_TILE)
+#define DRAWN_ROWS ((2160 + DRAWN_TILE - 1) / DRAWN_TILE)
+#define DRAWN_STRING2(x) #x
+#define DRAWN_STRING(x) DRAWN_STRING2(x)
+/* the GUI texels beyond those that a sample of the composite reads (its bilinear footprint), on
+ * every side, that a tile takes as reachable: for the precision of the interpolated coordinates of
+ * a shader that may run at medium precision (half a step of a 16-bit float at 1 is 0.94 texels of a
+ * 3840 texel wide GUI) */
+#define DRAWN_MARGIN 4
 
 static const char VERTEX[] =
     "#version 300 es\n"
@@ -325,7 +342,46 @@ static const char ROWS[] =
     "    return inside(p.x, p.y) ? clamp(decode(codes_at(p)), 0.0, 1.0) : vec3(0.0);\n"           \
     "}\n"
 
-/* 3. The picture that Kodi draws over. */
+/* Hades: the vertices of passes 3 and 4: the triangle over the whole raster, as for the other passes
+ * (tiles_mode 0), or a quad for each tile of the raster (DRAWN_TILE x DRAWN_TILE pixels), whose flag
+ * (pass 7: something may be drawn over it) the vertices read and hand on to its fragments: 1 the
+ * tiles with the flag only, 2 those without it only, 3 all of them. A tile that is not drawn has its
+ * vertices outside the clip volume: it has no fragments. The quads meet at the edges of the pixels,
+ * so every pixel of a tile drawn is drawn once. tiles_flip: the rows of the framebuffer are those of
+ * the raster the other way up (a window). */
+static const char TILED_VERTEX[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D drawn_tiles;\n"
+    "uniform int tiles_mode;\n"
+    "uniform int tiles_flip;\n"
+    "flat out int tile_drawn;\n"
+    "const int corner_x[6] = int[6](0, 1, 0, 0, 1, 1);\n"
+    "const int corner_y[6] = int[6](0, 0, 1, 1, 0, 1);\n"
+    "void main()\n"
+    "{\n"
+    "    if (tiles_mode == 0) {\n"
+    "        vec2 position = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+    "        gl_Position = vec4(position * 2.0 - 1.0, 0.0, 1.0);\n"
+    "        tile_drawn = 1;\n"
+    "        return;\n"
+    "    }\n"
+    "    int quad = gl_VertexID / 6, corner = gl_VertexID - quad * 6;\n"
+    "    ivec2 t = ivec2(quad % " DRAWN_STRING(DRAWN_COLUMNS) ", quad / " DRAWN_STRING(DRAWN_COLUMNS) ");\n"
+    "    tile_drawn = texelFetch(drawn_tiles, t, 0).r > 0.5 ? 1 : 0;\n"
+    "    if ((tiles_mode == 1 && tile_drawn == 0) || (tiles_mode == 2 && tile_drawn != 0)) {\n"
+    "        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    ivec2 a = t * " DRAWN_STRING(DRAWN_TILE) ";\n"
+    "    ivec2 b = min(a + " DRAWN_STRING(DRAWN_TILE) ", ivec2(3840, 2160));\n"
+    "    ivec2 q = ivec2(corner_x[corner] != 0 ? b.x : a.x, corner_y[corner] != 0 ? b.y : a.y);\n"
+    "    float y = tiles_flip != 0 ? float(2160 - q.y) : float(q.y);\n"
+    "    gl_Position = vec4(float(q.x) / 1920.0 - 1.0, y / 1080.0 - 1.0, 0.0, 1.0);\n"
+    "}\n";
+
+/* 3. The picture that Kodi draws over (Hades: over the whole raster, or the tiles asked for). */
 static const char PICTURE[] =
     "#version 300 es\n"
     COMMON
@@ -345,6 +401,7 @@ static const char PACK[] =
     "uniform uvec4 metadata_words[128];\n"
     "uniform uint packet_count;\n"
     "uniform uint flip_y;\n"
+    "flat in int tile_drawn;\n" /* Hades: (TILED_VERTEX) something may be drawn over this tile */
     "out vec4 color;\n"
     "uint parity(uint v)\n"
     "{\n"
@@ -390,7 +447,9 @@ static const char PACK[] =
     "    int ex = p.x & ~1;\n"
     "    bool odd = (p.x & 1) != 0;\n"
     "    vec4 own = vec4(0.0, 0.0, 0.0, 2.0), even = own;\n"
-    "    if (has_layer != 0) {\n"
+    /* (Hades: outside the tiles that what is drawn over may reach, nothing is drawn over the
+     * picture; a pair is in the tile of its even pixel) */
+    "    if (has_layer != 0 && tile_drawn != 0) {\n"
     "        own = texelFetch(drawn, p, 0);\n"
     "        even = odd ? texelFetch(drawn, ivec2(ex, p.y), 0) : own;\n"
     "    }\n"
@@ -425,23 +484,28 @@ static const char PACK[] =
  * OSD that spans the width), 2.1 million of them, which took about 40 ms of the 41.7 ms of a film
  * refresh on a Radeon RX 7600 (issue 3), and made the frames that are not presented a frame ahead late:
  * the GPU time that called for that, and those frames, measured nothing. The edges are the same. */
-#define COVER_BLOCK 16
-#define COVER_COLUMNS ((3840 + COVER_BLOCK - 1) / COVER_BLOCK)
-#define COVER_ROWS ((2160 + COVER_BLOCK - 1) / COVER_BLOCK)
-#define COVER_STRING2(x) #x
-#define COVER_STRING(x) COVER_STRING2(x)
+/* Hades: the blocks are the tiles of what is drawn over (DRAWN_TILE): where those are known, a block
+ * outside them has nothing drawn over it */
+#define COVER_BLOCK DRAWN_TILE
+#define COVER_COLUMNS DRAWN_COLUMNS
+#define COVER_ROWS DRAWN_ROWS
+#define COVER_STRING(x) DRAWN_STRING(x)
 static const char COVER[] =
     "#version 300 es\n"
     "precision highp float;\n"
     "precision highp int;\n"
     "uniform highp sampler2D drawn;\n"
     "uniform ivec4 active_rect;\n" /* x0, y0, x1, y1 */
+    "uniform highp sampler2D drawn_tiles;\n"
+    "uniform int tiles_mode;\n"
     "out vec4 color;\n"
     "void main()\n"
     "{\n"
     "    ivec2 b0 = ivec2(gl_FragCoord.xy) * " COVER_STRING(COVER_BLOCK) ";\n"
     "    ivec2 b1 = min(b0 + " COVER_STRING(COVER_BLOCK) ", ivec2(3840, 2160));\n"
     "    vec4 edges = vec4(0.0);\n"
+    "    if (tiles_mode != 0 && texelFetch(drawn_tiles, ivec2(gl_FragCoord.xy), 0).r < 0.5)\n"
+    "        b1.y = b0.y;\n"
     "    for (int y = b0.y; y < b1.y; ++y) {\n"
     /* a row of the bars: the block's columns; a row of the active picture: those left of it and those
      * right of it */
@@ -460,6 +524,70 @@ static const char COVER[] =
     "    color = edges;\n"
     "}\n";
 
+/* Hades: 6. The tiles of the GUI texture (DRAWN_TILE x DRAWN_TILE texels of it) that hold anything
+ * drawn (an alpha above 0), in two draws that each take 4 x 4 texels of what they read for a
+ * fragment: from the GUI texture (its alpha) to a quarter of its size, and from that (its red) to
+ * the tiles. (One fragment for each tile, reading its 256 texels one after the other, took about 10
+ * ms on an integrated Radeon.) A texel beyond the texture read is the last one of its row or column,
+ * which is in the same 4 x 4. */
+_Static_assert(DRAWN_TILE == 16, "pass 6 takes 4 x 4 twice");
+static const char GUI_TILES[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D gui;\n"
+    "uniform ivec2 gui_size;\n" /* of the texture read */
+    "uniform int from_alpha;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 b0 = ivec2(gl_FragCoord.xy) * 4;\n"
+    "    ivec2 last = gui_size - 1;\n"
+    "    float most = 0.0;\n"
+    "    for (int y = 0; y < 4; ++y)\n"
+    "        for (int x = 0; x < 4; ++x) {\n"
+    "            vec4 t = texelFetch(gui, min(b0 + ivec2(x, y), last), 0);\n"
+    "            most = max(most, from_alpha != 0 ? t.a : t.r);\n"
+    "        }\n"
+    "    color = vec4(most > 0.0 ? 1.0 : 0.0);\n"
+    "}\n";
+
+/* Hades: 7. The tiles of the raster that the composite of that texture may draw on, one fragment
+ * for each. The composite (Kodi's CompositeGui()) draws the whole texture over the whole raster, the
+ * texture's rows the other way up (its last row on the first of the raster), sampling it with its
+ * bilinear filter clamped to its edges: a raster pixel x, y takes the texels around
+ * ((x + 0.5) w / 3840 - 0.5, h - 0.5 - (y + 0.5) h / 2160), and is drawn on only where one of them
+ * has an alpha above 0. A tile takes the texels around those of all its pixels, DRAWN_MARGIN more on
+ * every side, and is reachable where a tile of pass 6 among them holds anything drawn. */
+static const char DRAWN[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D gui_tiles;\n"
+    "uniform ivec2 gui_size;\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 t = ivec2(gl_FragCoord.xy);\n"
+    "    vec2 scale = vec2(gui_size) / vec2(3840.0, 2160.0);\n"
+    "    float x0 = float(t.x * " DRAWN_STRING(DRAWN_TILE) ") + 0.5;\n"
+    "    float x1 = float(min(t.x * " DRAWN_STRING(DRAWN_TILE) " + " DRAWN_STRING(DRAWN_TILE) ", 3840) - 1) + 0.5;\n"
+    "    float y0 = float(t.y * " DRAWN_STRING(DRAWN_TILE) ") + 0.5;\n"
+    "    float y1 = float(min(t.y * " DRAWN_STRING(DRAWN_TILE) " + " DRAWN_STRING(DRAWN_TILE) ", 2160) - 1) + 0.5;\n"
+    "    int c0 = int(floor(x0 * scale.x - 0.5)) - " DRAWN_STRING(DRAWN_MARGIN) ";\n"
+    "    int c1 = int(floor(x1 * scale.x - 0.5)) + 1 + " DRAWN_STRING(DRAWN_MARGIN) ";\n"
