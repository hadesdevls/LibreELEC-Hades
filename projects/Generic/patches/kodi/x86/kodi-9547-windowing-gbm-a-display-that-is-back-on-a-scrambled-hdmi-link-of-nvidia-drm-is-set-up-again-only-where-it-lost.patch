+
+// Hades: the i2c adapters that the NVIDIA kernel module registers for the I2C ports of the GPU of a
+// DRM device (nv-i2c.c: "NVIDIA i2c adapter <port> at <bus>:<slot>.<function>", a child of the PCI
+// device; the adapters over DisplayPort AUX are named so too, and give no SCDC): their numbers, the
+// N of /dev/i2c-N
+std::vector<int> NvidiaI2cAdapters(int drmFd)
+{
+  std::vector<int> adapters;
+  struct stat st = {};
+  if (fstat(drmFd, &st) != 0 || !S_ISCHR(st.st_mode))
+    return adapters;
+  const std::string link = StringUtils::Format("/sys/dev/char/{}:{}/device", major(st.st_rdev),
+                                               minor(st.st_rdev));
+  char* real = realpath(link.c_str(), nullptr);
+  if (!real)
+    return adapters;
+  const std::string device = real;
+  free(real);
+  DIR* dir = opendir("/sys/bus/i2c/devices");
+  if (!dir)
+    return adapters;
+  while (const dirent* entry = readdir(dir))
+  {
+    int number = -1;
+    char tail = 0;
+    if (std::sscanf(entry->d_name, "i2c-%d%c", &number, &tail) != 1 || number < 0)
+      continue;
+    const std::string path = std::string("/sys/bus/i2c/devices/") + entry->d_name;
+    char* adapter = realpath(path.c_str(), nullptr);
+    if (!adapter)
+      continue;
+    const std::string where = adapter;
+    free(adapter);
+    const auto slash = where.rfind('/');
+    if (slash == std::string::npos || where.compare(0, slash, device) != 0 ||
+        slash != device.size())
+      continue;
+    std::ifstream file(path + "/name");
+    std::string name;
+    std::getline(file, name);
+    if (name.rfind("NVIDIA i2c adapter ", 0) == 0)
+      adapters.push_back(number);
+  }
+  closedir(dir);
+  std::sort(adapters.begin(), adapters.end());
+  return adapters;
+}
+
+// Hades: reads through /dev/i2c-N, and nothing else: a byte at an offset (SMBus "read byte data":
+// the offset written to the register pointer of the device, then the byte read), or 32 bytes from
+// one (SMBus "I2C block read"). The NVIDIA module makes each transfer under the locks of its
+// resource manager (rm_i2c_transfer()), as its own reads of the display.
+class CI2cRead
+{
+public:
+  explicit CI2cRead(int adapter)
+  {
+    const std::string path = StringUtils::Format("/dev/i2c-{}", adapter);
+    m_fd = open(path.c_str(), O_RDWR | O_CLOEXEC);
+    unsigned long funcs = 0;
+    if (m_fd < 0 || ioctl(m_fd, I2C_FUNCS, &funcs) != 0)
+      m_error = errno;
+    else
+      m_funcs = funcs;
+  }
+  ~CI2cRead()
+  {
+    if (m_fd >= 0)
+      close(m_fd);
+  }
+  CI2cRead(const CI2cRead&) = delete;
+  CI2cRead& operator=(const CI2cRead&) = delete;
+
+  bool Byte(uint8_t address, uint8_t offset, uint8_t& value)
+  {
+    if (!(m_funcs & I2C_FUNC_SMBUS_READ_BYTE_DATA))
+      return Refused();
+    i2c_smbus_data data = {};
+    if (!Transfer(address, offset, I2C_SMBUS_BYTE_DATA, data))
+      return false;
+    value = data.byte;
+    return true;
+  }
+  bool Block32(uint8_t address, uint8_t offset, uint8_t* out)
+  {
+    if (!(m_funcs & I2C_FUNC_SMBUS_READ_I2C_BLOCK))
+      return Refused();
+    i2c_smbus_data data = {};
+    data.block[0] = 32;
+    if (!Transfer(address, offset, I2C_SMBUS_I2C_BLOCK_DATA, data))
+      return false;
+    if (data.block[0] != 32)
+    {
+      m_error = EIO;
+      return false;
+    }
+    std::memcpy(out, &data.block[1], 32);
+    return true;
+  }
+  int Error() const { return m_error; }
+
+private:
+  bool Refused()
+  {
+    if (!m_error)
+      m_error = EOPNOTSUPP;
+    return false;
+  }
+  bool Transfer(uint8_t address, uint8_t offset, int size, i2c_smbus_data& data)
+  {
+    if (m_fd < 0)
+      return false;
+    if (ioctl(m_fd, I2C_SLAVE, static_cast<unsigned long>(address)) != 0)
+    {
+      m_error = errno;
+      return false;
+    }
+    i2c_smbus_ioctl_data args = {};
+    args.read_write = I2C_SMBUS_READ;
+    args.command = offset;
+    args.size = size;
+    args.data = &data;
+    if (ioctl(m_fd, I2C_SMBUS, &args) != 0)
+    {
+      m_error = errno;
+      return false;
+    }
+    return true;
+  }
+  int m_fd = -1;
+  unsigned long m_funcs = 0;
+  int m_error = 0;
+};
 } // namespace
 
