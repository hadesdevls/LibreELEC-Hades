     if (const char* why = HOTPLUG_RELINK::Why(verdict))
       CLog::Log(HOTPLUG_RELINK::TellsAtInfo(verdict) ? LOGINFO : LOGDEBUG,
-                "Hot-plug: after the event, the output of {} is not turned off and on again: {}",
-                name, why);
+                "Hot-plug: after the event, the output of {} is not turned off and on again: {}{}",
+                name, why, scdc.empty() ? std::string() : " (" + scdc + ")");
     return;
   }
 
@@ -1384,9 +1534,9 @@ void CWinSystemGbmGLESContext::LookForRelink()
             "Hot-plug: the display of {} is there again after the event, with the output on in "
             "{}x{} @ {} Hz, whose HDMI link is scrambled (TMDS {} kHz at {} bpc): the output is "
             "turned off and on again once, so that the driver sets the link up from scratch and "
-            "tells the display the scrambling again (nvidia-drm does not after a hot-plug event; "
-            "advancedsettings.xml: hotplugrelink)",
-            name, mode->hdisplay, mode->vdisplay, mode->vrefresh, facts.tmdsKHz, bpc);
+            "tells the display the scrambling again ({}; nvidia-drm does not after a hot-plug "
+            "event; advancedsettings.xml: hotplugrelink)",
+            name, mode->hdisplay, mode->vdisplay, mode->vrefresh, facts.tmdsKHz, bpc, scdc);
   m_relinkDone = true;
   m_relinkAt = now;
   // As when the screen is blanked and woken (and as FlipStalled() does): Hide() ends the menus in
@@ -1417,6 +1567,82 @@ void CWinSystemGbmGLESContext::LookForRelink()
   OutputLeftOff();
 }
 
+HOTPLUG_RELINK::Sink CWinSystemGbmGLESContext::ReadScdc(int fd,
+                                                         const std::vector<uint8_t>& edid,
+                                                         std::string& said)
+{
+  using namespace HOTPLUG_RELINK;
+  const char* const unknown = "so whether the display lost the setup is not known";
+  // The adapter of the connector: the one whose DDC port gives the display's EDID; found again
+  // where the EDID is another, or after a read that failed
+  if (m_relinkAdapter < 0 || m_relinkAdapterEdid != edid)
+  {
+    m_relinkAdapter = -1;
+    m_relinkAdapterEdid.clear();
+    const std::vector<int> adapters = NvidiaI2cAdapters(fd);
+    if (adapters.empty())
+    {
+      said = StringUtils::Format(
+          "its SCDC could not be read: the NVIDIA kernel module registered no i2c adapter for this "
+          "graphics card, {}",
+          unknown);
+      return Sink::UNKNOWN;
+    }
+    std::vector<std::pair<int, std::vector<uint8_t>>> reads;
+    for (const int adapter : adapters)
+    {
+      CI2cRead i2c(adapter);
+      std::vector<uint8_t> bytes(128);
+      bool read = true;
+      for (int offset = 0; read && offset < 128; offset += 32)
+        read = i2c.Block32(EDID_ADDRESS, static_cast<uint8_t>(offset), bytes.data() + offset);
+      if (read)
+        reads.emplace_back(adapter, std::move(bytes));
+    }
+    m_relinkAdapter = AdapterOfEdid(reads, edid);
+    if (m_relinkAdapter < 0)
+    {
+      const auto same = std::count_if(
+          reads.begin(), reads.end(),
+          [&edid](const auto& one)
+          {
+            return edid.size() >= 128 &&
+                   std::equal(one.second.begin(), one.second.begin() + 128, edid.begin());
+          });
+      said = StringUtils::Format(
+          "its SCDC could not be read: of the {} i2c adapters of the graphics card, {} gave an "
+          "EDID and {} gave this display's, so the one of its DDC port is not known, {}",
+          adapters.size(), reads.size(), same, unknown);
+      return Sink::UNKNOWN;
+    }
+    m_relinkAdapterEdid = edid;
+  }
+  CI2cRead i2c(m_relinkAdapter);
+  uint8_t config = 0;
+  if (!i2c.Byte(SCDC_ADDRESS, SCDC_TMDS_CONFIG, config))
+  {
+    said = StringUtils::Format("its SCDC could not be read through i2c-{} ({}), {}",
+                               m_relinkAdapter, std::strerror(i2c.Error()), unknown);
+    m_relinkAdapter = -1;
+    return Sink::UNKNOWN;
+  }
+  uint8_t status = 0;
+  uint8_t flags = 0;
+  const bool more = i2c.Byte(SCDC_ADDRESS, SCDC_SCRAMBLER_STATUS, status) &&
+                    i2c.Byte(SCDC_ADDRESS, SCDC_STATUS_FLAGS_0, flags);
+  const Sink sink = SinkOf(config);
+  said = StringUtils::Format(
+      "SCDC of the display, read through i2c-{}: TMDS_Config {:#04x}{}: the display {} the "
+      "scrambling setup",
+      m_relinkAdapter, static_cast<unsigned int>(config),
+      more ? StringUtils::Format(", Scrambler_Status {:#04x}, Status_Flags_0 {:#04x}",
+                                 static_cast<unsigned int>(status),
+                                 static_cast<unsigned int>(flags))
+           : std::string(", the other registers not read"),
+      sink == Sink::KEPT ? "has" : "lost");
+  return sink;
+}
+
 bool CWinSystemGbmGLESContext::SetGuiCompositing(int colorTransfer)
