From c62756db17d7621ea103c6257581d78e435b49f1 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Fri, 30 Oct 2026 20:01:46 +0000
Subject: [PATCH] [Bluray] Don't read past the end of the BD-J overlay image

For a changed region, libbluray passes a pointer into its full width
image, so copying stride * height pixels reads past the end of that
image when the region reaches its last line. Copy only the width of the
region from each line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp          | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 4dfe4d2..eb9906a 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1035,11 +1035,14 @@ void CDVDInputStreamBluray::OverlayCallbackARGB(const struct bd_argb_overlay_s *
     SOverlay overlay = std::make_shared<CDVDOverlayImage>();
 
     overlay->palette.clear();
-    size_t bytes = static_cast<size_t>(ov->stride * ov->h * 4);
-    overlay->pixels.resize(bytes);
-    memcpy(overlay->pixels.data(), ov->argb, bytes);
+    overlay->linesize = ov->w * 4;
+    overlay->pixels.resize(static_cast<size_t>(overlay->linesize) * ov->h);
+
+    // argb points into libbluray's full width image, so the last line's stride runs past its end
+    for (int row = 0; row < ov->h; ++row)
+      memcpy(overlay->pixels.data() + static_cast<size_t>(row) * overlay->linesize,
+             ov->argb + static_cast<size_t>(row) * ov->stride, overlay->linesize);
 
-    overlay->linesize = ov->stride * 4;
     overlay->x = ov->x;
     overlay->y = ov->y;
     overlay->height = ov->h;
