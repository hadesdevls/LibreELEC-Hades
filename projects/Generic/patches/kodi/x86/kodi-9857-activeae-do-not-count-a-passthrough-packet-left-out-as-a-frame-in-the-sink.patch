From 2b8d6908a2fbb20ee66a8ec7c21ef2ff1442fb88 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:56:42 +0000
Subject: [PATCH] ActiveAE: do not count a passthrough packet left out as a
 frame in the sink

To put a passthrough stream that is behind the picture back in sync, SyncStream() leaves packets out:
they go to the sink with nothing in them. The engine still counted each as a frame of the stream
until the sink had taken it (CEngineStats, one GetDuration() a packet), and with TrueHD the sink
holds up to 400 ms of packets: for that long a measurement did not see the packets already left
out, took the place of the error left after them, and the correction went on past the error and
came back with pauses. A TrueHD stream 300 ms behind lost 29 packets (580 ms) and then had 280 ms of
pauses, two cuts in the sound where one is needed.

A packet with neither frames nor a pause is no longer counted, by the engine (RunStages()) nor by
the sink (OutputSamples()), so the delay of the sink is what it holds. Measured in the host harness:
16 packets left out for the same stream, and no pauses back.
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp     | 7 ++++++-
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp | 5 ++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 01f0598..a52a451 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2683,7 +2683,12 @@ bool CActiveAE::RunStages()
             buffer = (*it)->m_processingBuffers->m_outputSamples.front();
             (*it)->m_processingBuffers->m_outputSamples.pop_front();
           }
-          m_stats.AddSamples(1, m_streams);
+          // Hades: a packet left out for the sync (SyncStream()) holds nothing: counted as a frame
+          // of the stream until the sink has it, it hid its own correction from the measurements
+          // meanwhile, and a correction went on past the error (CActiveAESink::OutputSamples() does
+          // not count it either)
+          const bool counted{buffer->pkt->nb_samples > 0 || buffer->pkt->pause_burst_ms > 0};
+          m_stats.AddSamples(counted ? 1 : 0, m_streams);
           m_sinkBuffers->m_inputSamples.push_back(buffer);
         }
       }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index 384fffc..e8d9b38 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -1556,7 +1556,10 @@ unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples)
     // sync error measurements are off by the whole sink delay.
     if (!m_needIecPack && totalFrames == 0)
       m_sink->GetDelay(status);
-    m_stats->UpdateSinkDelay(status, samples->pool ? 1 : 0);
+    // (Hades: a packet left out for the sync was not counted by the engine, CActiveAE::RunStages())
+    const bool counted{samples->pool &&
+                       (samples->pkt->nb_samples > 0 || samples->pkt->pause_burst_ms > 0)};
+    m_stats->UpdateSinkDelay(status, counted ? 1 : 0);
   }
 
   // Hades: a sound (anything but the sink's own silence) went to the device: the output is played
