From 5629acb60b239a5f707c6e25905eba48eba4345c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:46:05 +0000
Subject: [PATCH] VideoPlayerVideo: a wait for a buffer that was called off is
 no timeout

OutputPicture() logged "timeout waiting for buffer" as a warning also
when the wait was called off (a flush, or the stream closing, sets
m_bAbortOutput): after every stop, among the lines of kodi.log that are
no fault (75 such lines in the diagnostics of 1.0 RC3 and RC4). Now that
case is a debug line ("the wait for a buffer was called off"); a real
timeout is still a warning, and what follows is as before (OUTPUT_AGAIN).
The case was found in CroqueMr's build.
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index f0ca405..36deceb 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -1052,7 +1052,12 @@ CVideoPlayerVideo::EOutputState CVideoPlayerVideo::OutputPicture(const VideoPict
       return OUTPUT_DROPPED;
     }
 
-    if (m_speed != DVD_PLAYSPEED_PAUSE)
+    // Hades: a wait that was called off (a flush or the stream closing set m_bAbortOutput) is no
+    // timeout: only a real one is a warning (idea of CroqueMr's build; seen after every stop in
+    // the logs of 1.0 RC3 and RC4). What follows is as before.
+    if (m_bAbortOutput)
+      CLog::Log(LOGDEBUG, "{} - the wait for a buffer was called off", __FUNCTION__);
+    else if (m_speed != DVD_PLAYSPEED_PAUSE)
       CLog::Log(LOGWARNING, "{} - timeout waiting for buffer", __FUNCTION__);
 
     return OUTPUT_AGAIN;
