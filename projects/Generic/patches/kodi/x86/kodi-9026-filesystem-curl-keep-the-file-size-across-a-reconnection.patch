From 534c24bfd00762f9a4303cd44c08e1c300acae89 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:00:09 +0000
Subject: [PATCH] filesystem/curl: keep the file size across a reconnection

The source reopening of CFileCache (after a range request answered with
HTTP 429 or 503) mostly did not work. CCurlFile::Seek() reconnects
through Disconnect(), which sets the file size to 0, and a failed
Connect() returns before the size is read again. CFileCache takes the
size from GetLength() on every loop, saw 0, skipped the reopening that
needs a known size and reported the end of the file: after the first
retry (the other multisession state, then Disconnect()), or at once
without multisession, playback ended as in vanilla Kodi.

The known size is now kept across the reconnection. A successful
Connect() still sets it from the response, as before.
---
 xbmc/filesystem/CurlFile.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/xbmc/filesystem/CurlFile.cpp b/xbmc/filesystem/CurlFile.cpp
index c1a811b..0dafd9d 100644
--- a/xbmc/filesystem/CurlFile.cpp
+++ b/xbmc/filesystem/CurlFile.cpp
@@ -1510,6 +1510,12 @@ int64_t CCurlFile::Seek(int64_t iFilePosition, int iWhence)
   if(m_state->Seek(nextPos))
     return nextPos;
 
+  // The size of the file stays known across the reconnection: Disconnect() forgets it, and a
+  // range request that the server answers with an error (HTTP 429 or 503 from a streaming
+  // service) would otherwise make the file look empty, and the cache report its end.
+  const int64_t knownSize =
+      std::max(m_state->m_fileSize, m_oldState ? m_oldState->m_fileSize : int64_t{0});
+
   if (m_multisession)
   {
     if (!m_oldState)
@@ -1534,10 +1540,14 @@ int64_t CCurlFile::Seek(int64_t iFilePosition, int iWhence)
         return nextPos;
 
       m_state->Disconnect();
+      m_state->m_fileSize = knownSize;
     }
   }
   else
+  {
     m_state->Disconnect();
+    m_state->m_fileSize = knownSize;
+  }
 
   // re-setup common curl options
   SetCommonOptions(m_state);
