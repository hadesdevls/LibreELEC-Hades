 tools/dvbridge/dvbridge_hdr10plus.c |  25 +-
 tools/dvbridge/dvbridge_hdr10plus.h |   6 +
 tools/dvbridge/dvbridge_measure.c   | 363 ++++++++++++++++++++++++
 tools/dvbridge/dvbridge_measure.h   |  39 +++
 tools/dvbridge/dvbridge_measured.c  | 413 ++++++++++++++++++++++++++++
 tools/dvbridge/dvbridge_measured.h  | 107 +++++++
 7 files changed, 951 insertions(+), 5 deletions(-)
 create mode 100644 tools/dvbridge/dvbridge_measure.c
 create mode 100644 tools/dvbridge/dvbridge_measure.h
