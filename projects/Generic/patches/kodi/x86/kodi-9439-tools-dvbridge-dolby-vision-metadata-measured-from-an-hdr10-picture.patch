--- /dev/null
+++ b/tools/dvbridge/dvbridge_measured.h
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef DVBRIDGE_MEASURED_H
+#define DVBRIDGE_MEASURED_H
+/* Hades: HDR10 sent as Dolby Vision with metadata measured from the picture. An HDR10 video has no dynamic
+ * metadata of its studio: what is sent is measured by Hades on each picture, in real time, as ST 2094-10:2021 6.1
+ * defines level 1 (the reduced pixel set of 2x2 means of R'G'B', over the active area: min of minRGB, mean and max
+ * of maxRGB, in PQ), and held per scene as Dolby Vision metadata are: a scene cut that is detected refreshes the
+ * scene, and within a scene the level 1 block changes only when the scene so far says otherwise by more than a
+ * step. The active area (level 5) is the area of the picture that is ever not black. Nothing else is sent: no
+ * trims (there is no colourist's grade to translate), no level 3 (CCM 001 reserves it).
+ *
+ * This part decides from the measurements (dvbridge_measure.c makes them on the GPU); it holds no GL. The
+ * pictures are given in the order of presentation, ahead of their presentation as far as they are measured
+ * (Kodi measures the pictures queued for presentation: a cut is detected before its first picture is shown when
+ * that picture and the one after it are measured in time), and taken when they are presented. */
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DVBRIDGE_MEASURED_BANDS 16       /* column bands of the measurement of the rows */
+#define DVBRIDGE_MEASURED_ROW_GROUPS 9   /* ... and groups of rows of the grid that cuts are told by */
+#define DVBRIDGE_MEASURED_COLUMN_BANDS 8 /* row bands of the measurement of the columns */
+#define DVBRIDGE_MEASURED_GRID (DVBRIDGE_MEASURED_BANDS * DVBRIDGE_MEASURED_ROW_GROUPS)
+/* a block whose maxRGB (PQ) is above it is picture; the bars are what is never above it */
+#define DVBRIDGE_MEASURED_BLACK 0.02f
+
+/* What the measurement of one picture gives (dvbridge_measure.c), on the reduced pixel set of blocks_w x blocks_h */
+struct dvbridge_measured_raw {
+    double pts;
+    int blocks_w, blocks_h;
+    int window[2]; /* the block columns [window[0], window[1]) that the values "in the window" are of */
+    /* per block row r and band b, at (r * DVBRIDGE_MEASURED_BANDS + b) * 4: the max of maxRGB, the sum of maxRGB and
+     * the min of minRGB of its blocks in the window (2 where none), and the max of maxRGB of all of its blocks */
+    const float *rows;
+    /* per block column c and row band k, at c * DVBRIDGE_MEASURED_COLUMN_BANDS + k: the max of maxRGB */
+    const float *columns;
+};
+
+/* One picture, as the decisions take it */
+struct dvbridge_measured_picture {
+    double pts;
+    bool content; /* it has blocks above the black level */
+    float min, avg, max; /* level 1 over the active area, PQ in [0, 1] */
+    float grid[DVBRIDGE_MEASURED_GRID]; /* the mean maxRGB of each cell of the active area (PQ) */
+    int active[4]; /* its own rows [0], [1) and columns [2], [3) with blocks above the black level */
+    int blocks_w, blocks_h;
+};
+
+/* A scene cut is a picture whose grid differs from the one before by more than cut on average (PQ), and by more than
+ * motion times the median of the last 12 such differences (a camera or a scene that moves differs much every
+ * picture); where the picture after it is measured as well, that one has to be within step of it (a cut is a step:
+ * the next picture is of the new scene) and away from the one before by more than cut (else it was one bright
+ * picture: a flash, no cut). */
+struct dvbridge_measured_params {
+    float cut, motion, step;
+    unsigned avg_step, max_step, min_step; /* within a scene, the level 1 sent changes by more than these (codes) */
+};
+
+/* What a picture is sent with */
+struct dvbridge_measured_l1 {
+    bool measured; /* from measurements (else nothing was measured yet: none) */
+    bool refresh;  /* the picture is the first of a scene */
+    unsigned min_pq, max_pq, avg_pq;  /* level 1, as a level 1 block carries it, clamped as dovi_tool clamps one */
+    unsigned area[4]; /* level 5: the offsets left, right, top, bottom, in pixels of the picture */
+};
+
+struct dvbridge_measured;
+/* params: NULL for the defaults (dvbridge_measured_default_params) */
+struct dvbridge_measured *dvbridge_measured_create(const struct dvbridge_measured_params *params);
+void dvbridge_measured_destroy(struct dvbridge_measured *m);
+/* A seek, or a new stream: what was measured goes; the active area stays only with keep_area (the same stream) */
+void dvbridge_measured_reset(struct dvbridge_measured *m, bool keep_area);
+extern const struct dvbridge_measured_params dvbridge_measured_default_params;
+
+/* The picture of what the GPU measured, over the rows of the active area known now (the area grows with it) */
+bool dvbridge_measured_reduce(struct dvbridge_measured *m, const struct dvbridge_measured_raw *raw,
+                              struct dvbridge_measured_picture *picture);
+/* A picture measured, in the order of presentation (one with the time of one given before replaces it) */
+void dvbridge_measured_add(struct dvbridge_measured *m, const struct dvbridge_measured_picture *picture);
+/* The metadata of the picture of pts, which is presented now: pictures before it that were given and not taken
+ * (not presented) go into the scene as they were. false: it was not measured; *l1 then holds what was sent
+ * last (measured false when nothing was), without a refresh. */
+bool dvbridge_measured_take(struct dvbridge_measured *m, double pts, struct dvbridge_measured_l1 *l1);
+/* The block columns that the next measurements are to be made over: those of the active area known now, all
+ * of them before any is known */
+void dvbridge_measured_window(const struct dvbridge_measured *m, int blocks_w, int window[2]);
+
+struct AVDOVIMetadata;
+struct AVMasteringDisplayMetadata;
+struct AVContentLightMetadata;
+/* The metadata that a picture of such a stream carries from its decoder (dvbridge_profile81_metadata(): profile 8.1,
+ * identity mapping, the mastering display as the source range), with level 1 from the static metadata until it is
+ * measured: max PQ(MaxCLL) (or of the mastering display's peak), average PQ(MaxFALL), clamped as dovi_tool clamps
+ * one. NULL without the luminance of the mastering display: no Dolby Vision. */
+struct AVDOVIMetadata *dvbridge_measured_placeholder(const struct AVMasteringDisplayMetadata *mastering,
+                                                     const struct AVContentLightMetadata *light, size_t *size);
+/* The metadata of a picture made from those, as it is presented: its level 1 block, its scene refresh and its level
+ * 5 block (added, or replaced) from l1. false: they cannot take it (no level 1 block, no room). */
+bool dvbridge_measured_apply(struct AVDOVIMetadata *metadata, size_t size, const struct dvbridge_measured_l1 *l1);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
