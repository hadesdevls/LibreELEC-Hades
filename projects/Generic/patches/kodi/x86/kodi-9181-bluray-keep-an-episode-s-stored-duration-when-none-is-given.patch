From ffba726c728abdae558005af1753105f0cf9ee73 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 13:06:27 +0100
Subject: [PATCH] [Bluray] Keep an episode's stored duration when none is
 given.

The duration from the bluray:// url replaced the one read from the
database, so a url without one set the episode's duration to 0 and lost
what narrows the candidate playlists.
---
 xbmc/filesystem/BlurayDirectory.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/filesystem/BlurayDirectory.cpp b/xbmc/filesystem/BlurayDirectory.cpp
index 1b7441e..3846bd1 100644
--- a/xbmc/filesystem/BlurayDirectory.cpp
+++ b/xbmc/filesystem/BlurayDirectory.cpp
@@ -919,7 +919,8 @@ bool CBlurayDirectory::GetDirectory(const CURL& url, CFileItemList& items)
         episodeIndex = static_cast<int>(std::distance(episodesOnDisc.begin(), it));
 
         // Add duration and title from scraper
-        it->duration = duration;
+        if (duration > 0)
+          it->duration = duration;
         if (!title.empty())
           it->strTitle = title;
       }
