 #   system/hades/DialogHadesPlayerInfo.xml  the pages as a dialog of their own (CGUIDialogHadesPlayerInfo),
 #                                           for a skin that has none: includes expanded, Estuary's control defaults
 #                                           written into each control, Estuary's strings as $ADDON[skin.estuary n],
-#                                           its colours as values and its textures from system/hades;
+#                                           its colours as values and its textures from system/hades; its labels
+#                                           scroll where their text does not fit, as the fonts of another skin
+#                                           are not Estuary's (for_any_font());
 #   system/hades/*.png                      those textures, copied from Estuary's media;
 #   system/hades/README.txt                 where those textures come from, and the licences of what is here.
 # The XML files are made of Estuary's and go under the licence of Estuary's code (GPL version 2.0); the textures
@@ -206,6 +208,55 @@ def expand_includes(e):
         e[-1].tail = tail
 
 
+def for_any_font(e):
+    """A skin without these pages may have none of Estuary's fonts (font10, font12, font20_title...): Kodi then
+    takes its font13 (GUIFontManager::GetFont()), of a size nobody here knows. So that no text of the dialog is cut
+    where it cannot be read, every label scrolls when its text is wider than it (Kodi moves a label only while its
+    text does not fit, CGUILabel::Process(): with fonts of Estuary's sizes nothing moves and nothing is drawn again
+    for it), and a label that wraps on two lines takes one line that scrolls (two lines of a larger font do not fit
+    its height). A button scrolls its text only while it has the focus (CGUIButtonControl::ProcessText()): one whose
+    text does not change colour with the focus says it with a label over it that scrolls, and keeps none of its own.
+    What Estuary says is kept as the attribute estuary="..." of <scroll>, <wrapmultiline> and a button's <label>,
+    which Kodi does not read, for the tools that measure the pages as Estuary shows them."""
+    parent = {c: p for p in e.iter() for c in p}
+    for b in [c for c in e.iter("control") if c.get("type") == "button"]:
+        label = b.find("label")
+        if label is None or not (label.text or "").strip():
+            continue
+        if (b.findtext("textcolor") or "") != (b.findtext("focusedcolor") or ""):
+            continue  # (a tab: its text changes colour with the focus; they are short)
+        if any(b.find(tag) is None for tag in ("left", "top", "width", "height")):
+            fail("a button of the pages has no position of its own: its text cannot be put over it")
+        offset = float(b.findtext("textoffsetx") or 0)
+        over = ET.Element("control", {"type": "label"})
+        for tag, value in (("left", "%g" % (float(b.findtext("left")) + offset)), ("top", b.findtext("top")),
+                           ("width", "%g" % (float(b.findtext("width")) - 2 * offset)), ("height", b.findtext("height")),
+                           ("font", b.findtext("font") or "font13"), ("align", b.findtext("align") or "left"),
+                           ("aligny", b.findtext("aligny") or "center"), ("textcolor", b.findtext("textcolor")),
+                           ("label", label.text), ("scroll", "true"), ("scrollspeed", "40")):
+            ET.SubElement(over, tag).text = value
+        for v in b.findall("visible"):
+            over.append(copy.deepcopy(v))
+        label.set("estuary", label.text)
+        label.text = ""
+        siblings = list(parent[b])
+        parent[b].insert(siblings.index(b) + 1, over)
+    for c in e.iter("control"):
+        if c.get("type") != "label":
+            continue
+        scroll = c.find("scroll")
+        if scroll is None:
+            scroll = ET.SubElement(c, "scroll")
+            scroll.text = "false"
+        if (scroll.text or "").strip() != "true":
+            scroll.set("estuary", (scroll.text or "").strip())
+            scroll.text = "true"
+        wrap = c.find("wrapmultiline")
+        if wrap is not None and (wrap.text or "").strip() == "true":
+            wrap.set("estuary", "true")
+            wrap.text = "false"
+
+
 def apply_defaults(e):
     """Estuary's <default> of each control's type, for what the control does not say (as CGUIIncludes does)."""
     for c in e.iter("control"):
@@ -251,6 +302,7 @@ out_controls = ET.SubElement(window, "controls")
 out_controls.append(panel)
 expand_includes(out_controls)
 apply_defaults(out_controls)
+for_any_font(out_controls)
 rewrite(window)
 
