+// The Dolby VSVDB, read from the raw EDID with the rule of the amdgpu kernel backend
+// (amdgpu_dm_dvbridge_edid_standard) so that Kodi and the kernel take the same displays: valid
+// blocks (an HDMI Forum EEODB may make the EDID longer than its extension count) and exactly one
+// Dolby VSVDB. libdisplay-info gives neither the length of a version 1 block nor its whole
+// low-latency field, and stops at the extension count.
+// - Version 2 with interface 2 or 3 advertises the Standard mode; 2160p60 is always there.
+// - A 12-byte version 1 block with the low-latency field 1 advertises the Standard mode with the
+//   same Dolby vendor InfoFrame (0 there, the 15-byte form and version 0 mean the HDMI 1.4b
+//   vendor InfoFrame), taken with display management 4 or later only: the metadata sent is the
+//   one of that version, and nothing reports whether an older display reads it.
+DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
+{
+  static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+  const size_t size = edid.size();
+  if (size < 128 || size % 128 || size < (edid[126] + 1u) * 128 ||
+      !std::equal(std::begin(magic), std::end(magic), edid.begin()))
+    return {};
+  DolbyVideoBlock result;
+  result.eeodb = size > (edid[126] + 1u) * 128;
+  unsigned int found = 0;
+  for (size_t block = 0; block < size / 128; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    unsigned int sum = 0;
+    for (size_t i = 0; i < 128; ++i)
+      sum += b[i];
+    if (sum % 256)
+      return {};
+    if (block == 0 || b[0] != 0x02 || b[1] < 3)
+      continue;
+    const unsigned int end = b[2];
+    if (end == 0)
+      continue;
+    if (end < 4 || end > 127)
+      return {};
+    for (unsigned int pos = 4; pos < end;)
+    {
+      const unsigned int len = b[pos] & 31;
+      const uint8_t* data = b + pos + 1;
+      if (pos + len + 1 > end)
+        return {};
+      // Extended vendor-specific video data block, little-endian Dolby OUI
+      if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 && data[1] == 0x46 && data[2] == 0xd0 &&
+          data[3] == 0)
+      {
+        if (++found != 1 || len < 5)
+          return {};
+        result.valid = true;
+        result.length = len;
+        result.version = data[4] >> 5;
+        if (result.version == 1 || result.version == 2)
+          result.dmVersion = ((data[4] >> 2) & 7) + 2;
+        if (result.version == 2 && len >= 11)
+        {
+          result.standard = (data[6] & 3) >= 2;
+          result.at2160p60 = true;
+        }
+        else if (result.version == 1 && len == 11)
+        {
+          result.standard = (data[7] & 3) == 1 && result.dmVersion >= 4;
+          result.at2160p60 = (data[4] & 2) != 0;
+        }
+      }
+      pos += len + 1;
+    }
+  }
+  return result;
+}
