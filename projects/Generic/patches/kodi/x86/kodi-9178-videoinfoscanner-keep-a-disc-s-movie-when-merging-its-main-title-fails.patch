From 3c9c1d68cf210fa2d843bc067ee1534384cae331 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 13:05:02 +0100
Subject: [PATCH] [VideoInfoScanner] Keep a disc's movie when merging its main
 title fails.

A declined or failed merge of the disc's main title as a version of
another movie deleted it, as is right for the disc's other playlists.
The disc's movie was lost (e.g. in AUTO mode with several similar
movies), while the scan still reported it added and stored the hash.

The main title now stays a movie in its own right, as any other movie
does, and the disc's other playlists become versions of it.
---
 xbmc/video/VideoInfoScanner.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 4627b04..b9940dc 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -3050,6 +3050,12 @@ CVideoInfoScanner::~CVideoInfoScanner()
         targetDbId = chosenTargetMovieDbId;
         versioned = true;
       }
+      else if (isMainPlaylist)
+      {
+        // Not merged into another movie, so the disc's main title stays one and the other
+        // playlists become versions of it
+        targetDbId = newMovieDbId;
+      }
       else if (result == VersionConversionResult::FAILED ||
                result == VersionConversionResult::CANCELLED)
       {
@@ -3062,7 +3068,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
       }
     }
 
-    if (added && targetDbId >= 0)
+    if (versioned)
       RemovePartNumberFromTitle(targetDbId, VideoDbContentType::MOVIES, m_database);
     return !added ? InfoRet::INFO_ERROR : (versioned ? InfoRet::HAVE_ALREADY : InfoRet::ADDED);
   }
