+
+bool CWinSystemGbmGLESContext::HdrAsSdr(const VideoPicture& picture) const
+{
+  const int setting = m_hdrAsSdr.load(std::memory_order_relaxed);
+  if (setting == static_cast<int>(DVBRIDGE::HdrAsSdr::NEVER))
+    return false;
+  const bool pq = picture.color_transfer == AVCOL_TRC_SMPTE2084;
+  const bool hlg = picture.color_transfer == AVCOL_TRC_ARIB_STD_B67;
+  if (!DVBRIDGE::HdrAsSdrFor(setting, picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION, pq,
+                             hlg))
+    return false;
+  if (!m_hdrAsSdrTold.exchange(true))
+    CLog::Log(LOGINFO,
+              "HDR output: this {} video goes out as SDR, without HDR signalling, as the user "
+              "chose (videoscreen.hadeshdrassdr: {}), on an output that takes HDR; its picture "
+              "is mapped to SDR as on a display without HDR: by the bridge with the tone mapping "
+              "\"Reference (BT.2390)\" (to the display that videoscreen.hadesdvsdrtarget says), by "
+              "Kodi with its own methods",
+              hlg ? "HLG" : "PQ (HDR10 or HDR10+)",
+              setting == static_cast<int>(DVBRIDGE::HdrAsSdr::HLG) ? "HLG videos"
+                                                                   : "HLG, HDR10 and HDR10+ videos");
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::PlainMappingChosen(const VideoPicture& picture) const
+{
+  return m_renderableType == EGL_OPENGL_ES3_BIT && !m_plainDisabled && HdrAsSdr(picture);
+}
