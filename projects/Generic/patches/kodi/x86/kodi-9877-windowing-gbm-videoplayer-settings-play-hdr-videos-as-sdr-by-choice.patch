+
+#. Hades: value of setting "videoscreen.hadeshdrassdr": never; translated in Estuary (#32592)
+#: system/settings/settings.xml
+msgctxt "#41112"
+msgid "Never"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadeshdrassdr": HLG videos; translated in Estuary (#32593)
+#: system/settings/settings.xml
+msgctxt "#41113"
+msgid "HLG videos"
