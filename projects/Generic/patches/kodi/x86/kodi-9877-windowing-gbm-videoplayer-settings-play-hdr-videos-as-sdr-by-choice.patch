         dolbyVision, hdr10Plus,
@@ -5270,11 +5279,13 @@ bool CVideoPlayer::OpenVideoStream(CDVDStreamInfo& hint, bool reset)
       // Hades: the window system may hold this change of mode for the commit that sets up the
