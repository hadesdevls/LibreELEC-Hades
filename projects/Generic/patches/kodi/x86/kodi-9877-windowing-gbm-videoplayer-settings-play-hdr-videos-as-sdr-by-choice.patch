+//! Hades: the values of videoscreen.hadeshdrassdr, "Play HDR videos as SDR": which videos a display
+//! that takes HDR is sent as SDR, by the user's choice (HdrAsSdrFor())
+enum class HdrAsSdr
+{
+  NEVER = 0, //!< none: HDR goes out as HDR, as before (the default)
+  HLG = 1, //!< HLG videos
+  ALL = 2, //!< HLG, HDR10 and HDR10+ videos
+};
+
+/*!
+ * \brief Hades: whether a picture goes out as SDR, by the user's choice, on an output that would
+ *        send it with HDR signalling (videoscreen.hadeshdrassdr)
+ *
+ * For a display whose own mode for that HDR is worse than its SDR one (a TV that shows HLG badly, a
+ * projector). The output takes the picture as it takes an SDR video: no HDR signalling (no
+ * HDR_OUTPUT_METADATA, no HDR10+ InfoFrame), and the picture mapped to SDR. With the tone mapping
+ * method of a reference display (the default) that is the bridge's mapping, the one of a display
+ * without HDR (PlainMappingEligible(): the BT.2390 curve guided by the stream's metadata, to the
+ * display that videoscreen.hadesdvsdrtarget says); with Kodi's own methods, Kodi's. HLG with HLG or
+ * ALL, HDR10 and HDR10+ (PQ) with ALL. Never a picture of Dolby Vision: native, rebuilt, or measured
+ * from HDR10, HDR10+ or HLG (the settings that make Dolby Vision of a video come first), nor a
+ * picture whose transfer is neither PQ nor HLG.
+ * \param setting the value of the setting (HdrAsSdr), as it was when the video started, NEVER where
+ *        the output takes no HDR anyway (the window system's latch: nothing changes there)
+ * \param dolbyVision the picture is of a Dolby Vision stream (VideoPicture::hdrType)
+ * \param pq its transfer is ST 2084
+ * \param hlg its transfer is ARIB STD-B67
+ */
+constexpr bool HdrAsSdrFor(int setting, bool dolbyVision, bool pq, bool hlg)
+{
+  return !dolbyVision &&
+         ((hlg && (setting == static_cast<int>(HdrAsSdr::HLG) ||
+                   setting == static_cast<int>(HdrAsSdr::ALL))) ||
+          (pq && setting == static_cast<int>(HdrAsSdr::ALL)));
+}
+
+//! Hades: HdrAsSdrFor() of a video stream that opens, by what the stream says before its decoder is
+//! open (VideoPlayer: the output it tells of for the change of mode, OutputOfStream(), is then that
+//! of an SDR video); with the setting as the window system took it for this video
+bool HdrAsSdrOfStream(bool dolbyVision, bool pq, bool hlg);
+
 //! Hades: a luminance of the HDR10 metadata that the mapping can take as a peak: (0, 10000] cd/m2
 constexpr bool UsablePeak(double nits)
 {
