+bool CFileCache::ReaderWaitsOutStalls() const
+{
+  // a reader that can stop at once (READ_ABORT) and waits (READ_WAIT), a file whose length is
+  // known and not yet read to its end: the silence of its source is not its end. A source of
+  // unknown length (a live stream) keeps the 10 s after which no data is the end, as before.
+  return m_readWait && m_readAbort && m_fileSize > 0 && m_readPos < m_fileSize;
+}
+
+int64_t CFileCache::WaitOutStall(bool& aborted)
+{
+  // The cache thread reopens the source at the byte it stopped at for as long as it stays silent,
+  // and ends the input when it gives up on it (ReopenStalledSource()); data, the end of the input,
+  // a failed seek or the reader's abort end this wait. Between slices of 100 ms the reader is told
+  // how long it has waited.
+  const auto start = std::chrono::steady_clock::now();
+  bool told = false;
+  for (;;)
+  {
+    const int64_t avail = WaitForCacheData(1, 100ms, aborted);
+    if (aborted || avail > 0 || m_pCache->IsEndOfInput() || !m_sourcePositionValid ||
+        !CThread::IsRunning())
+    {
+      if (told)
+        CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> the wait at {} ends after {} ms", __FUNCTION__,
+                  m_sourcePath, m_readPos.load(),
+                  std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+      return avail;
+    }
+    const auto waited = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - start);
+    if (!told && waited >= 1s)
+    {
+      told = true;
+      CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> the reader waits for the source at {} of {}",
+                __FUNCTION__, m_sourcePath, m_readPos.load(), m_fileSize.load());
+    }
+    (*m_readWait)(waited);
+  }
+}
+
+bool CFileCache::ReopenStalledSource(ssize_t iRead)
+{
+  // a cache that is being stopped neither pauses, nor reopens, nor logs (the caller leaves)
+  if (m_bStop)
+    return true;
+  const auto now = std::chrono::steady_clock::now();
+  const auto silent =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now - m_lastSourceData);
+  const bool waits = m_readerWaits;
+  if (waits)
+  {
+    // what the latest answer of the source says (an HTTP source; others answer nothing)
+    int code = 0;
+    IFile* imp = m_source->GetImplementation();
+    const SourceAnswer answer =
+        imp ? ClassifyAnswer(imp->GetProperty(FileProperty::RESPONSE_PROTOCOL), code)
+            : SourceAnswer::NONE;
+    if (answer == SourceAnswer::SHORTER)
+    {
+      CLog::Log(LOGWARNING,
+                "CFileCache::{} - <{}> the source has nothing from byte {} of the {} it announced "
+                "(HTTP {}): taken as the end of the file",
+                __FUNCTION__, m_sourcePath, m_writePos, m_fileSize.load(), code);
+      return false;
+    }
+    if (answer == SourceAnswer::REFUSED)
+    {
+      CLog::Log(LOGERROR,
+                "CFileCache::{} - <{}> the source refuses the file at byte {} of {} (HTTP {}): "
+                "given up on, the read fails",
+                __FUNCTION__, m_sourcePath, m_writePos, m_fileSize.load(), code);
+      m_sourceFailed = true;
+      return false;
+    }
+    if (m_seekPossible == 0)
+    {
+      // it cannot be reopened at the byte it stopped at (a server without ranges): the end of
+      // what it sent, as before
+      CLog::Log(LOGWARNING,
+                "CFileCache::{} - <{}> the source stopped at byte {} of {} and cannot be reopened "
+                "there (it cannot seek): taken as the end of the file",
+                __FUNCTION__, m_sourcePath, m_writePos, m_fileSize.load());
+      return false;
+    }
+    if (silent >= m_sourceSilenceLimit)
+    {
+      CLog::Log(LOGERROR,
+                "CFileCache::{} - <{}> the source has sent nothing for {} s, at byte {} of {}: "
+                "given up on after {} reopening(s), the read fails",
+                __FUNCTION__, m_sourcePath, silent.count() / 1000, m_writePos, m_fileSize.load(),
+                m_sourceReopens);
+      m_sourceFailed = true;
+      return false;
+    }
+  }
+
+  const auto pause =
+      std::min<std::chrono::milliseconds>(FIRST_REOPEN_PAUSE * (1 << std::min(m_sourceReopens, 4)),
+                                          MAX_REOPEN_PAUSE);
+  m_sourceReopens++;
+  // every attempt of the first ones; then, for a source that stays silent, a line every 30 s
+  const bool log = m_sourceReopens <= MAX_SOURCE_REOPENS || now - m_lastStallLog >= STALL_LOG_INTERVAL;
+  if (log)
+  {
+    m_lastStallLog = now;
+    if (!waits)
+      CLog::Log(LOGWARNING,
+                "CFileCache::{} - <{}> source read returned {} at {} of {} bytes, reopening it in "
+                "{} ms (attempt {} of {})",
+                __FUNCTION__, m_sourcePath, iRead, m_writePos, m_fileSize.load(), pause.count(),
+                m_sourceReopens, MAX_SOURCE_REOPENS);
+    else
+      CLog::Log(LOGWARNING,
+                "CFileCache::{} - <{}> source read returned {} at {} of {} bytes, {} ms without "
+                "data: reopening it in {} ms (attempt {}; the reader waits, given up on after {} "
+                "s without data)",
+                __FUNCTION__, m_sourcePath, iRead, m_writePos, m_fileSize.load(), silent.count(),
+                pause.count(), m_sourceReopens,
+                std::chrono::duration_cast<std::chrono::seconds>(m_sourceSilenceLimit).count());
+  }
+  if (m_seekEvent.Wait(pause))
+  {
+    if (!m_bStop)
+      m_seekEvent.Set(); // hack so that later we realize seek is needed
+    return true;
+  }
+  if (m_bStop)
+    return true;
+  const int64_t reopened = m_source->Seek(m_writePos, SEEK_SET);
+  if (reopened != m_writePos && !m_bStop && log)
+    CLog::Log(LOGWARNING, "CFileCache::{} - <{}> reopening at {} returned {}", __FUNCTION__,
+              m_sourcePath, m_writePos, reopened);
+  return true;
+}
+
 void CFileCache::Close()
 {
   StopThread();
@@ -867,5 +1049,18 @@ int CFileCache::IoControl(IOControl request, void* param)
     return 0;
   }
 
+  if (request == IOControl::READ_WAIT)
+  {
+    // the reader's function, set and cleared on its own thread around its reads; once given, the
+    // cache thread keeps reopening a source that stalls (ReopenStalledSource())
+    m_readWait = static_cast<const std::function<void(std::chrono::milliseconds)>*>(param);
+    if (m_readWait)
+      m_readerWaits = true;
+    return 0;
+  }
+
+  if (request == IOControl::SOURCE_FAILED)
+    return m_sourceFailed ? 1 : 0;
+
   return -1;
 }
