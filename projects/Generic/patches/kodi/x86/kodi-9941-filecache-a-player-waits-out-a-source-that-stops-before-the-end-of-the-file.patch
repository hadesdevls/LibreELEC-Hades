+void CDVDInputStreamFile::SetReadWait(const std::function<void(std::chrono::milliseconds)>* wait)
+{
+  // only for the file a player reads itself (RetryFailedReads() without the flag of an outer
+  // stream), which can stop its reads at once (IOControl::READ_ABORT, set in Open()): the file of a
