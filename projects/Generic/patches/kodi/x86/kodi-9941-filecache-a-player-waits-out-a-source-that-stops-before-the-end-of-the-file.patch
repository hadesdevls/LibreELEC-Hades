+// For a reader that waits out a stall (IOControl::READ_WAIT: a player, which buffers meanwhile and
+// can stop at once), the source is reopened for as long as it stays silent, every 4 s after the
+// first pauses, and given up on after m_sourceSilenceLimit (FileCache.h)
+constexpr std::chrono::milliseconds MAX_REOPEN_PAUSE{4000};
+constexpr std::chrono::seconds STALL_LOG_INTERVAL{30};
+
+// What the latest answer of an HTTP source says of reopening it: nothing (no answer, or one that
+// may change: 408, 425, 429, 5xx), that the server refuses the file (any other 4xx: an expired or
+// removed link, no access), or that the file is shorter than its announced length (416: the range
+// starts after its end)
+enum class SourceAnswer
+{
+  NONE,
+  REFUSED,
+  SHORTER,
+};
+
+SourceAnswer ClassifyAnswer(const std::string& protoLine, int& code)
+{
+  code = 0;
+  // "HTTP/1.1 404 Not Found", "HTTP/2 404"
+  const size_t sp = protoLine.find(' ');
+  if (protoLine.compare(0, 5, "HTTP/") != 0 || sp == std::string::npos)
+    return SourceAnswer::NONE;
+  code = std::atoi(protoLine.c_str() + sp + 1);
+  if (code == 416)
+    return SourceAnswer::SHORTER;
+  if (code >= 400 && code < 500 && code != 408 && code != 425 && code != 429)
+    return SourceAnswer::REFUSED;
+  return SourceAnswer::NONE;
+}
