+      read.sink == Sink::KEPT   ? "has the setup of the link"
+      : read.sink == Sink::LOST ? "lost the setup of the link"
+                                : "says nothing that can be read for this link");
+  if (read.sink == Sink::UNKNOWN)
+    read.said += StringUtils::Format(" ({}, {})", std::strerror(i2c.Error()), unknown);
