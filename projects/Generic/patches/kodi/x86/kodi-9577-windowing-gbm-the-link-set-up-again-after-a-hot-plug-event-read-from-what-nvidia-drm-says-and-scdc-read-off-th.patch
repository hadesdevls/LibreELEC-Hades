+    found = number;
   }
   closedir(dir);
-  std::sort(adapters.begin(), adapters.end());
-  return adapters;
+  return twice ? -1 : found;
 }
 
 // Hades: reads through /dev/i2c-N, and nothing else: a byte at an offset (SMBus "read byte data":
@@ -1442,21 +1452,84 @@ private:
   unsigned long m_funcs = 0;
   int m_error = 0;
 };
+
+// Hades: the display's SCDC, read through the adapter of the DDC port of its connector, on a
+// thread of its own (a transfer of the NVIDIA module waits for the locks of its resource manager,
+// and an I2C transfer for the display): its EDID first (that the port is the connector's: the
+// bytes that nvidia-drm has), then TMDS_Config and Config_1 (FRL_Rate), and for the log
+// Scrambler_Status and Status_Flags_0. Only reads; only that bus.
+HOTPLUG_RELINK::ScdcRead ReadScdcOf(std::string device,
+                                    unsigned int port,
+                                    std::vector<uint8_t> edid,
+                                    HOTPLUG_RELINK::Link link)
+{
+  using namespace HOTPLUG_RELINK;
+  ScdcRead read;
+  const char* const unknown = "so whether the display lost the setup is not known";
+  const int adapter = NvidiaI2cAdapter(device, port);
+  if (adapter < 0)
+  {
+    read.said = StringUtils::Format("its SCDC could not be read: the NVIDIA kernel module has no "
+                                    "single i2c adapter for the DDC port {} of the connector, {}",
+                                    port, unknown);
+    return read;
+  }
+  CI2cRead i2c(adapter);
