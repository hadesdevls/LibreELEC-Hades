From 0de71a552916948eaca44acbfd1cab5f5073acd3 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 29 Sep 2026 23:02:12 +0100
Subject: [PATCH] [video] Don't save the default icon as art when refreshing

The refresh job rebuilds library items from their video info tag, which
gives them the default icon. That icon was then saved as "icon" art for
every refreshed movie, show and music video. Clear the art from the
rebuilt items, as was done for the library import.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index ab3ca67..89c472a 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -454,6 +454,10 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     else
       items.Add(std::make_shared<CFileItem>(*m_item));
 
+    // an item created from a video info tag is given the default icon, which is not art to save
+    for (const auto& item : items)
+      item->ClearArt();
+
     // set the proper path of the list of items to lookup
     items.SetPath(VIDEO::IsBrowsableFolder(*m_item) ? URIUtils::GetParentPath(path)
                                                     : URIUtils::GetDirectory(path));
-- 
