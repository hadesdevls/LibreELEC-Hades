     m_Mouse.SetActive(false);
 
   // Consume ACTION_NOOP.
@@ -229,7 +250,9 @@ bool CInputManager::ProcessEventServer(int windowId, float frameTime)
           if (appPower->WakeUpScreenSaverAndDPMS())
