 #include <math.h>
 #include <mutex>
 
@@ -62,7 +66,23 @@ constexpr auto keyComposeactionEventMap = make_map<uint8_t, int>({
     {XBMC_KEYCOMPOSING_CANCELLED, ACTION_KEYBOARD_COMPOSING_KEY_CANCELLED},
     {XBMC_KEYCOMPOSING_FINISHED, ACTION_KEYBOARD_COMPOSING_KEY_FINISHED},
 });
+
+// Hades: whether a key leaves the mouse pointer on screen, as whatever drives the pointer asks with
+// Window(Home).Property(MousePointerStays) (MousePointerStays.h); kodi.log says it when it changes
+MOUSE::PointerStays PointerStaysAsked()
+{
+  const auto gui = CServiceBroker::GetGUI();
+  const CGUIWindow* home = gui ? gui->GetWindowManager().GetWindow(WINDOW_HOME) : nullptr;
+  const MOUSE::PointerStays stays =
+      home ? MOUSE::ParsePointerStays(home->GetProperty("MousePointerStays").asString())
+           : MOUSE::PointerStays::NO;
+  static std::atomic<MOUSE::PointerStays> told{MOUSE::PointerStays::NO};
+  if (told.exchange(stays) != stays)
+    CLog::Log(LOGINFO, "InputManager: Window(Home).Property(MousePointerStays) is {}",
+              MOUSE::PointerStaysText(stays));
+  return stays;
 }
+} // namespace
 
