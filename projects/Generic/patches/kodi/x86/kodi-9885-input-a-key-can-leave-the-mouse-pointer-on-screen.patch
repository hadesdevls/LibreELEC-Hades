+            m_Mouse.SetActive(false);
 
           CLog::Log(LOGDEBUG, "EventServer: key {} translated to action {}", wKeyID, actionName);
 
@@ -552,7 +575,10 @@ bool CInputManager::OnKey(const CKey& key)
 bool CInputManager::HandleKey(const CKey& key)
 {
   // Turn the mouse off, as we've just got a keypress from controller or remote
-  m_Mouse.SetActive(false);
+  // (Hades: unless the pointer is asked to stay, MousePointerStays.h; unasked, as before)
+  const MOUSE::PointerStays stays = PointerStaysAsked();
+  if (stays == MOUSE::PointerStays::NO)
+    m_Mouse.SetActive(false);
 
   // get the current active window
   int iWin = CServiceBroker::GetGUI()->GetWindowManager().GetActiveWindowOrDialog();
@@ -561,6 +587,10 @@ bool CInputManager::HandleKey(const CKey& key)
   // special handling if the screensaver is active
   CAction action = m_buttonTranslator->GetAction(iWin, key);
 
+  // (Hades: asked to stay at every key but the ones that move the focus: those hide it)
+  if (stays != MOUSE::PointerStays::NO && !MOUSE::PointerStaysAt(stays, action.GetID()))
+    m_Mouse.SetActive(false);
+
   // a key has been pressed.
   // reset Idle Timer
   auto& components = CServiceBroker::GetAppComponents();
