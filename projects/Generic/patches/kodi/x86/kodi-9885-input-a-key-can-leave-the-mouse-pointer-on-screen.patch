+
+#pragma once
+
+#include "input/actions/ActionIDs.h"
+
+#include <cstddef>
+#include <string_view>
+
+namespace KODI
+{
+namespace MOUSE
+{
+
+/*!
+ * \brief Hades: whether a key leaves the mouse pointer on screen
+ *
+ * Kodi hides the pointer at every key of a keyboard, a remote, CEC or the event server, and at a
+ * button of the mouse that keymaps turn into something other than a mouse action
+ * (CInputManager::HandleKey(), ProcessMouse(), ProcessEventServer()). A remote that drives the
+ * pointer and has keys too (a TV remote with a pointer, through an add-on) then loses its pointer at
+ * each key. Whatever drives the pointer can ask it to stay with Window(Home).Property(MousePointerStays):
+ * "true" for every key, "nomove" for every key but the four that move the focus (up, down, left and
+ * right). These are the names and values of the YBLOD build, so an add-on made for it does the same
+ * here; any case is taken. Unset, or any other value: every key hides the pointer, as in Kodi. A
+ * pointer that stays still is hidden after its time without movement all the same (CMouseStat).
+ */
+enum class PointerStays
+{
+  NO, //!< every key hides the pointer (Kodi)
+  ALWAYS, //!< "true": no key does
+  UNLESS_MOVE, //!< "nomove": only the four that move the focus do
+};
+
+//! The value of Window(Home).Property(MousePointerStays)
+inline PointerStays ParsePointerStays(std::string_view value)
+{
+  const auto is = [value](std::string_view word)
+  {
+    if (value.size() != word.size())
+      return false;
+    for (size_t i = 0; i < word.size(); ++i)
+    {
+      char c = value[i];
+      if (c >= 'A' && c <= 'Z')
+        c = static_cast<char>(c - 'A' + 'a');
+      if (c != word[i])
+        return false;
+    }
+    return true;
+  };
+  if (is("true"))
+    return PointerStays::ALWAYS;
+  if (is("nomove"))
+    return PointerStays::UNLESS_MOVE;
+  return PointerStays::NO;
+}
+
+//! Whether the pointer stays on screen at a key whose action is \p actionId
+inline bool PointerStaysAt(PointerStays stays, int actionId)
+{
+  switch (stays)
+  {
+    case PointerStays::ALWAYS:
+      return true;
+    case PointerStays::UNLESS_MOVE:
+      return actionId != ACTION_MOVE_LEFT && actionId != ACTION_MOVE_RIGHT &&
+             actionId != ACTION_MOVE_UP && actionId != ACTION_MOVE_DOWN;
+    case PointerStays::NO:
+      break;
+  }
+  return false;
+}
+
+//! What kodi.log says when the value changes
+inline const char* PointerStaysText(PointerStays stays)
+{
+  switch (stays)
+  {
+    case PointerStays::ALWAYS:
+      return "\"true\": no key hides the mouse pointer";
+    case PointerStays::UNLESS_MOVE:
+      return "\"nomove\": only up, down, left and right hide the mouse pointer";
+    case PointerStays::NO:
+      break;
+  }
+  return "neither \"true\" nor \"nomove\": every key hides the mouse pointer, as in Kodi";
+}
+
+} // namespace MOUSE
+} // namespace KODI
