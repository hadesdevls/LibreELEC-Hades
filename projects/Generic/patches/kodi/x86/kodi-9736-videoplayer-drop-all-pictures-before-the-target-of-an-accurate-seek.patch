From 7a4126e68e2e361f6cd4145f2b03b3e806aafc55 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Sun, 25 Oct 2026 15:31:41 +0100
Subject: [PATCH] [VideoPlayer] Drop all pictures before the target of an
 accurate seek

VideoPlayer drops the packets before the target, but decoders apply the
drop flag to the pictures they output rather than to the packets they
were decoded from. A decoder with latency, like FFmpeg with frame
threads or MediaCodec, therefore still output pictures of dropped
packets, so skipping a commercial break showed up to half a second of
its end. A picture without a timestamp must not end the dropping, as
it would report the stream as started without a start time.
---
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 52 +++++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.h   |  7 +++
 2 files changed, 59 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 1a9f6c0..f0ca405 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -23,6 +23,7 @@
 #include "windowing/GraphicContext.h"
 #include "windowing/WinSystem.h"
 
+#include <algorithm>
 #include <iomanip>
 #include <iterator>
 #include <memory>
@@ -236,9 +237,18 @@ void CVideoPlayerVideo::OpenStream(CDVDStreamInfo& hint, std::unique_ptr<CDVDVid
   m_rewindStalled = false;
   m_packets.clear();
   m_syncState = IDVDStreamPlayer::SYNC_STARTING;
+  ResetSeekDrop();
   m_renderManager.ShowVideo(false);
 }
 
+void CVideoPlayerVideo::ResetSeekDrop()
+{
+  m_awaitingFirstKeptPacket = true;
+  m_seekDropping = false;
+  m_seekDropBeforePts = DVD_NOPTS_VALUE;
+  m_seekDroppedPictures = 0;
+}
+
 void CVideoPlayerVideo::CloseStream(bool bWaitForBuffers)
 {
   // wait until buffers are empty
@@ -470,6 +480,7 @@ void CVideoPlayerVideo::Process()
       m_packets.clear();
       pts = 0;
       m_rewindStalled = false;
+      ResetSeekDrop();
 
       m_ptsTracker.Flush();
       //we need to recalculate the framerate
@@ -543,6 +554,26 @@ void CVideoPlayerVideo::Process()
       DemuxPacket* pPacket = std::static_pointer_cast<CDVDMsgDemuxerPacket>(pMsg)->GetPacket();
       bool bPacketDrop = std::static_pointer_cast<CDVDMsgDemuxerPacket>(pMsg)->GetPacketDrop();
 
+      // After a flush, VideoPlayer drops the packets before the target of an accurate seek.
+      // Decoders apply the drop flag to the pictures they output rather than to the packets
+      // they were decoded from, so a decoder with latency still outputs some of them.
+      if (m_awaitingFirstKeptPacket)
+      {
+        if (bPacketDrop)
+        {
+          m_seekDropping = true;
+        }
+        else
+        {
+          m_awaitingFirstKeptPacket = false;
+          if (m_seekDropping)
+          {
+            m_seekDropping = false;
+            m_seekDropBeforePts = pPacket->dts != DVD_NOPTS_VALUE ? pPacket->dts : pPacket->pts;
+          }
+        }
+      }
+
       if (m_stalled)
       {
         CLog::Log(LOGDEBUG, "CVideoPlayerVideo - Stillframe left, switching to normal playback");
@@ -788,6 +819,27 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       pts = m_picture.pts;
     }
 
+    // Drop the pictures before the first kept packet. Pictures output while packets are still
+    // being dropped all stem from dropped packets. A picture without a timestamp must not end
+    // this either, as it would report the stream as started without a start time.
+    if (m_seekDropping || m_seekDropBeforePts != DVD_NOPTS_VALUE)
+    {
+      constexpr int MAX_SEEK_DROPPED_PICTURES = 250;
+      const bool before = m_seekDropping || !hasTimestamp || m_picture.pts < m_seekDropBeforePts;
+      if (before && ++m_seekDroppedPictures <= MAX_SEEK_DROPPED_PICTURES)
+      {
+        m_picture.iFlags |= DVP_FLAG_DROPPED;
+      }
+      else
+      {
+        CLog::Log(LOGDEBUG, "CVideoPlayerVideo - dropped {} pictures before the seek target {:f}",
+                  std::min(m_seekDroppedPictures, MAX_SEEK_DROPPED_PICTURES), m_picture.pts);
+        m_awaitingFirstKeptPacket = false;
+        m_seekDropping = false;
+        m_seekDropBeforePts = DVD_NOPTS_VALUE;
+      }
+    }
+
     double extraDelay = 0.0;
     if (m_picture.iRepeatPicture)
     {
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
index 45e62ee..dad9fc3 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.h
@@ -108,6 +108,7 @@ protected:
   void CalcFrameRate();
   void TakeDeclaredFrameRate(double pts);
   int CalcDropRequirement(double pts);
+  void ResetSeekDrop();
 
   double m_iSubtitleDelay;
 
@@ -133,6 +134,12 @@ protected:
   IDVDStreamPlayer::ESyncState m_syncState;
   std::atomic_bool m_bAbortOutput;
 
+  // Pictures of packets dropped to reach a seek target, see ProcessDecoderOutput()
+  bool m_awaitingFirstKeptPacket{true};
+  bool m_seekDropping{false};
+  double m_seekDropBeforePts{DVD_NOPTS_VALUE};
+  int m_seekDroppedPictures{0};
+
   BitstreamStats m_videoStats;
 
   CDVDMessageQueue m_messageQueue;
-- 
