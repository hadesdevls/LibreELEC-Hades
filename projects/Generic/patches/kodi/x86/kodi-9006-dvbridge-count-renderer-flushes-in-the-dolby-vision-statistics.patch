From c5bb347e998d3a953ad87fd14c808d03814a4f21 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 01:05:06 +0000
Subject: [PATCH] dvbridge: count renderer flushes in the Dolby Vision
 statistics

The 10-s statistics showed gaps of about 0.5 s between shown frames.
They match the 500 ms that VideoPlayer waits for a free render buffer
("OutputPicture - timeout waiting for buffer"), so they are the symptom
of the main loop not presenting, not the cause, and most of them came
next to subtitle or audio stream changes, which seek. Count the
renderer flushes (every seek and stream change flushes the renderer on
the main thread) in each window, so that a gap with no flush points to
a real stall.
---
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp | 6 ++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp          | 5 +++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h            | 7 +++++++
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 561263a..7fe4fd6 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -465,6 +465,12 @@ bool CRenderManager::Flush(bool wait, bool saveBuffers)
       }
 
       m_flushEvent.Set();
+#ifdef HAVE_DVBRIDGE
+      // lets the DV statistics tell seek/stream-change gaps from stalls
+      if (auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+              CServiceBroker::GetWinSystem()))
+        dvWindow->DVBridgeFlushed();
+#endif
     }
   }
   else
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index dd06386..5dbcc6b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -804,11 +804,12 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   CLog::Log(LOGINFO,
             "DVBridge: {}: {} frames shown, {} not shown, {} composed with GUI elements; "
             "prepare avg {:.1f} ms max {:.1f} ms; present avg {:.1f} ms max {:.1f} ms; "
-            "longest gap between shown frames {:.1f} ms",
+            "longest gap between shown frames {:.1f} ms; {} renderer flushes (seeks, stream "
+            "changes)",
             period, m_dvStats.shown, m_dvStats.notShown, m_dvStats.withGui,
             m_dvStats.prepared ? m_dvStats.prepareSumMs / m_dvStats.prepared : 0.0,
             m_dvStats.prepareMaxMs, attempts ? m_dvStats.presentSumMs / attempts : 0.0,
-            m_dvStats.presentMaxMs, m_dvStats.gapMaxMs);
+            m_dvStats.presentMaxMs, m_dvStats.gapMaxMs, m_dvStats.flushes);
   m_dvLastWindow.valid = true;
   m_dvLastWindow.shown = m_dvStats.shown;
   m_dvLastWindow.notShown = m_dvStats.notShown;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 1f0bfba..4726e1c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -70,6 +70,12 @@ public:
   bool EndDVBridge();
   //! Outcome of one Dolby Vision frame; enough failures in a row fall back to the ordinary output.
   void DVBridgeFrameShown(bool shown);
+  //! The renderer was flushed (seek, stream change); counted in the DV statistics. Main thread.
+  void DVBridgeFlushed()
+  {
+    if (m_dvSignalling)
+      m_dvStats.flushes++;
+  }
   bool SetVideoOutput(const VideoPicture* picture) override;
   bool DestroyWindowSystem() override;
 #endif
@@ -114,6 +120,7 @@ private:
     unsigned int notShown = 0;
     unsigned int withGui = 0;
     unsigned int prepared = 0;
+    unsigned int flushes = 0;
     double prepareSumMs = 0;
     double prepareMaxMs = 0;
     double presentSumMs = 0;
