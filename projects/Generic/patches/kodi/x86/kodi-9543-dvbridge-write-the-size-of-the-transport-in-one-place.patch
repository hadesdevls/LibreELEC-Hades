From a39f601026c7cef12a1a80300b2e6c0347634072 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:47:21 +0000
Subject: [PATCH] [DVBridge] Write the size of the transport in one place

The size of a frame of the transport of native Dolby Vision, 3840x2160, was written as numbers in
seven places: the check of the mode (DVBRIDGE::IsTransportMode() and RefreshRateKeepsOrdinary()),
the check of the window at the start of native output (BeginDVBridge()), the check of the buffer of
each frame (FlipDVBridgePage()), the size of the picture that a capture reads
(GetCaptureFramebuffer()) and the viewport of the GUI and of the overlays drawn over the picture
(CompositeGui(), BeginDVBridgeHDROverlays()). They are one quantity: DVBRIDGE::TRANSPORT_WIDTH and
TRANSPORT_HEIGHT, in DVPlaybackPolicy.h next to the rule of the transport mode. Nothing that runs
changes (the same values, the same comparisons).
---
 .../VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h    | 11 +++++++++--
 xbmc/windowing/gbm/WinSystemGbm.cpp                   |  3 ++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp        | 11 ++++++-----
 3 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 9e67ee1..4552850 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -37,12 +37,18 @@ constexpr bool RpuRepeated(bool hevc, bool codedRpu)
   return hevc && !codedRpu;
 }
 
+// Hades: the size of a frame of the transport of native Dolby Vision, and of its mode: the window,
+// the buffers that go out, the picture that a capture reads and the viewport of what is drawn
+// over it are this size (one place for what was written in seven)
+constexpr int TRANSPORT_WIDTH = 3840;
+constexpr int TRANSPORT_HEIGHT = 2160;
+
 // Native Dolby Vision Standard output is sent as 3840x2160 progressive at a CTA rate from 23.976
 // to 60 Hz (VICs 93 to 97 and their 1000/1001 variants): Dolby Vision Standard over HDMI goes up
 // to 60 Hz, and the kernel backends accept only these timings.
 inline bool IsTransportMode(int width, int height, double refresh, bool interlaced)
 {
-  if (width != 3840 || height != 2160 || interlaced)
+  if (width != TRANSPORT_WIDTH || height != TRANSPORT_HEIGHT || interlaced)
     return false;
   for (const double rate :
        {24000.0 / 1001, 24.0, 25.0, 30000.0 / 1001, 30.0, 50.0, 60000.0 / 1001, 60.0})
@@ -60,7 +66,8 @@ inline bool IsTransportMode(int width, int height, double refresh, bool interlac
  */
 inline bool RefreshRateKeepsOrdinary(bool refreshFixed, double modeRate, bool interlacedOr3D)
 {
-  return refreshFixed && !interlacedOr3D && !IsTransportMode(3840, 2160, modeRate, false);
+  return refreshFixed && !interlacedOr3D &&
+         !IsTransportMode(TRANSPORT_WIDTH, TRANSPORT_HEIGHT, modeRate, false);
 }
 
 //! Hades: a mode of an output, as the rule of native output looks at it
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 089f99a..da17f65 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1778,7 +1778,8 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore, DVFlip
   {
     const auto mode = drm->GetSelectedMode();
     const auto format = gbm_bo_get_format(bo);
-    valid = gbm_bo_get_width(bo) == 3840 && gbm_bo_get_height(bo) == 2160 &&
+    valid = gbm_bo_get_width(bo) == DVBRIDGE::TRANSPORT_WIDTH &&
+            gbm_bo_get_height(bo) == DVBRIDGE::TRANSPORT_HEIGHT &&
             (format == DRM_FORMAT_XRGB8888 || format == DRM_FORMAT_ARGB8888) && mode &&
             IsDVTransportMode(*mode);
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 81ee444..bb55bc3 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1213,7 +1213,7 @@ void CWinSystemGbmGLESContext::CompositeGui()
     previousScissor = glIsEnabled(GL_SCISSOR_TEST);
     glDisable(GL_SCISSOR_TEST);
     glBindFramebuffer(GL_FRAMEBUFFER, target);
-    glViewport(0, 0, 3840, 2160);
+    glViewport(0, 0, DVBRIDGE::TRANSPORT_WIDTH, DVBRIDGE::TRANSPORT_HEIGHT);
     // Hades: the GUI goes over the bars too: they are cleared again before the next picture
     m_dvBridge->PQTextureDrawn();
   }
@@ -2173,7 +2173,8 @@ bool CWinSystemGbmGLESContext::BeginDVBridge()
   m_dvBeginCode = "";
   if (NativeDVOutputDisabled())
     return DVBridgeBeginRejected("disabled-after-a-failure");
-  if (m_nWidth != 3840 || m_nHeight != 2160 || GetOutputBitDepth() != 8 ||
+  if (m_nWidth != DVBRIDGE::TRANSPORT_WIDTH || m_nHeight != DVBRIDGE::TRANSPORT_HEIGHT ||
+      GetOutputBitDepth() != 8 ||
       m_renderableType != EGL_OPENGL_ES3_BIT)
     return DVBridgeBeginRejected("output-mode-depth-or-gles3");
   if (m_dvState.Captured())
@@ -2365,8 +2366,8 @@ unsigned int CWinSystemGbmGLESContext::GetCaptureFramebuffer(int& width, int& he
   // Hades: the capture reads the whole picture (it may have been made where the GUI reaches only)
   if (!m_dvBridge->CompletePicture())
     return 0;
-  width = 3840;
-  height = 2160;
+  width = DVBRIDGE::TRANSPORT_WIDTH;
+  height = DVBRIDGE::TRANSPORT_HEIGHT;
   return m_dvBridge->GetPQFramebuffer();
 }
 
@@ -2804,7 +2805,7 @@ bool CWinSystemGbmGLESContext::BeginDVBridgeHDROverlays()
   m_dvBridge->PQTextureDrawn();
   // (Hades: and they are drawn over the picture: see PresentRender())
   m_dvDrawnOver = true;
-  glViewport(0, 0, 3840, 2160);
+  glViewport(0, 0, DVBRIDGE::TRANSPORT_WIDTH, DVBRIDGE::TRANSPORT_HEIGHT);
   glDisable(GL_SCISSOR_TEST);
   // The PQ texture stores the logical top at row zero (see CompositeGui()): flip the clip-space
   // Y of the current projection, leaving the screen coordinates of the overlays unchanged.
-- 
