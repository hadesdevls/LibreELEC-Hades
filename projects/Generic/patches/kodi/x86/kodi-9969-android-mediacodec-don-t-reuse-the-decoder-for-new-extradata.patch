From 12799af276793533e9e7eb673972978202bc4e64 Mon Sep 17 00:00:00 2001
From: thexai <58434170+thexai@users.noreply.github.com>
Date: Wed, 11 Nov 2026 17:36:38 +0100
Subject: [PATCH] [Android] MediaCodec: don't reuse the decoder for new
 extradata

Reconfigure() accepted a stream whose extradata differs, but the codec
and the bitstream converter keep the SPS/PPS they were set up with. A
playlist switch between two Blu-ray files with the same format but
different SPS/PPS then reused the decoder, and video froze while audio
continued.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9828872c37b500b4d032dce34bdd03e2e7c49ef1)
---
 .../DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp        | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
index 85c7d2c..6617b01 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
@@ -1257,8 +1257,8 @@ void CDVDVideoCodecAndroidMediaCodec::Reset()
 
 bool CDVDVideoCodecAndroidMediaCodec::Reconfigure(CDVDStreamInfo &hints)
 {
-  if (m_hints.Equal(hints, CDVDStreamInfo::COMPARE_ALL &
-                               ~(CDVDStreamInfo::COMPARE_ID | CDVDStreamInfo::COMPARE_EXTRADATA)))
+  // The codec and the bitstream converter are set up with the SPS/PPS of the extradata
+  if (m_hints.Equal(hints, CDVDStreamInfo::COMPARE_ALL & ~CDVDStreamInfo::COMPARE_ID))
   {
     CLog::Log(LOGDEBUG, "CDVDVideoCodecAndroidMediaCodec::Reconfigure: true");
     m_hints = hints;
-- 
