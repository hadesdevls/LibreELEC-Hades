@@ -279,4 +280,76 @@ inline size_t DefaultEdition(const File& file)
   return 0;
 }
 
+inline std::string FormatMs(int64_t ms)
+{
+  if (ms < 0)
+    ms = 0;
+  const int64_t s = (ms + 500) / 1000;
+  char buf[32];
+  std::snprintf(buf, sizeof(buf), "%lld:%02lld:%02lld", static_cast<long long>(s / 3600),
+                static_cast<long long>(s / 60 % 60), static_cast<long long>(s % 60));
+  return buf;
+}
+
+// What kodi.log says about the editions of a file: nothing for a file without editions or with a
+// single one that is not ordered (an ordinary file with chapters).
+inline std::vector<std::string> Describe(const File& file, int64_t fileDurationMs)
+{
+  std::vector<std::string> out;
+  if (file.editions.empty() || (file.editions.size() == 1 && !file.editions[0].ordered))
+    return out;
+  const size_t offered = Offered(file, fileDurationMs).size();
+  out.push_back(std::to_string(file.editions.size()) + " edition(s), " + std::to_string(offered) +
+                " that can be offered, default " + std::to_string(DefaultEdition(file)) +
+                (offered >= 2 ? "" : " (nothing to choose: the file plays as it is stored)"));
+  for (size_t i = 0; i < file.editions.size(); i++)
+  {
+    const Edition& ed = file.editions[i];
+    const Plan plan = PlanEdition(file, i, fileDurationMs);
+    std::string line = "[" + std::to_string(i) + "] \"" + ed.name + "\" uid " + std::to_string(ed.uid) +
+                       (ed.ordered ? ", ordered, " : ", not ordered, ") +
+                       std::to_string(ed.chapters.size()) + " chapter(s): ";
+    if (!plan.offered)
+      line += std::string("not offered, ") + ReasonName(plan.reason);
+    else if (!ed.ordered)
+      line += "the whole file, " + FormatMs(plan.durationMs);
+    else
+      line += FormatMs(plan.durationMs) + " with " + std::to_string(plan.cuts.size()) + " cut(s)";
+    out.push_back(line);
+  }
+  return out;
+}
+
+struct Choice
+{
+  bool play = false; // false: the file plays as it is stored
+  size_t index = 0;
+  Plan plan;
+  std::string why; // when it does not play an edition although one was asked for
+};
+
+// The edition chosen before playback (index and uid, as MatroskaEditionChoice put them in the item),
+// checked against what the player's own demuxer reads. requestedIndex < 0: none was chosen.
+inline Choice Chosen(const File& file, int64_t requestedIndex, uint64_t requestedUid, int64_t fileDurationMs)
+{
+  Choice choice;
+  if (requestedIndex < 0)
+    return choice;
+  if (static_cast<uint64_t>(requestedIndex) >= file.editions.size() ||
+      file.editions[static_cast<size_t>(requestedIndex)].uid != requestedUid)
+  {
+    choice.why = "the edition chosen is not in the file the player opened";
+    return choice;
+  }
+  choice.index = static_cast<size_t>(requestedIndex);
+  choice.plan = PlanEdition(file, choice.index, fileDurationMs);
+  if (!choice.plan.offered)
+  {
+    choice.why = std::string("the edition chosen cannot be played: ") + ReasonName(choice.plan.reason);
+    return choice; // (a plan that is not offered has no cuts)
+  }
+  choice.play = true;
+  return choice;
+}
+
 } // namespace MKV_EDITIONS
