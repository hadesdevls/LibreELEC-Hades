+++ b/xbmc/cores/VideoPlayer/MatroskaEditionChoice.h
@@ -0,0 +1,35 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <optional>
+
+class CFileItem;
+
+namespace MKV_EDITIONS
+{
+
+//! Item properties that carry the edition chosen before playback to VideoPlayer, which checks
+//! them against its own demuxer (Chosen() in DVDDemuxers/MatroskaEditions.h).
+constexpr const char* PROPERTY_INDEX = "hades.mkvedition";
+constexpr const char* PROPERTY_UID = "hades.mkveditionuid";
+
+/*!
+ * \brief With "Ask which edition when a file has several" (videoplayer.hadesmkveditions) on, and a
+ *        Matroska file with two or more editions that can be played, asks which one. Called on the
+ *        application thread before the player opens the file (a question from the player's thread
+ *        could leave Kodi waiting on itself if playback were stopped meanwhile). Only the header of
+ *        the file is read, with a deadline of 10 s.
+ * \return a copy of the item with the choice in its properties, or nothing: the setting is off, the
+ *         file is not a Matroska file with editions to choose from, it could not be read, or the
+ *         question was not answered with a choice. With nothing, the file plays as it is stored.
+ */
+std::optional<CFileItem> AskBeforePlayback(const CFileItem& item);
+
+} // namespace MKV_EDITIONS
