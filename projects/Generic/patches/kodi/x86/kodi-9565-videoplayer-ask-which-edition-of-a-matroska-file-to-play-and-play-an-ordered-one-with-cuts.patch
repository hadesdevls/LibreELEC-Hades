+}
+
+namespace
+{
+using namespace std::chrono_literals;
+
+struct Probe
+{
+  XFILE::CFile file;
+  std::chrono::steady_clock::time_point deadline;
+};
+
+int ProbeRead(void* opaque, uint8_t* buf, int size)
+{
+  auto* probe = static_cast<Probe*>(opaque);
+  const ssize_t n = probe->file.Read(buf, static_cast<size_t>(size));
+  if (n < 0)
+    return AVERROR(EIO);
+  return n == 0 ? AVERROR_EOF : static_cast<int>(n);
+}
+
+int64_t ProbeSeek(void* opaque, int64_t pos, int whence)
+{
+  auto* probe = static_cast<Probe*>(opaque);
+  if (whence == AVSEEK_SIZE)
+    return probe->file.GetLength();
+  return probe->file.Seek(pos, whence & ~AVSEEK_FORCE);
+}
+
+int ProbeInterrupt(void* opaque)
+{
+  return std::chrono::steady_clock::now() > static_cast<Probe*>(opaque)->deadline ? 1 : 0;
+}
+
+// Reads the header of a Matroska file (no stream probing, no packets) and what the demuxer exports
+// of its editions.
+bool ReadEditions(const std::string& path, MKV_EDITIONS::File& out, int64_t& durationMs)
+{
+  Probe probe;
+  probe.deadline = std::chrono::steady_clock::now() + 10s;
+  if (!probe.file.Open(path, XFILE::READ_TRUNCATED))
+    return false;
+
+  constexpr int BUFFER_SIZE = 32768;
+  auto* buffer = static_cast<unsigned char*>(av_malloc(BUFFER_SIZE));
+  if (!buffer)
+    return false;
+  AVIOContext* io = avio_alloc_context(buffer, BUFFER_SIZE, 0, &probe, ProbeRead, nullptr, ProbeSeek);
+  if (!io)
+  {
+    av_free(buffer);
+    return false;
+  }
+
+  bool ok = false;
+  const AVInputFormat* format = av_find_input_format("matroska");
+  AVFormatContext* fc = format ? avformat_alloc_context() : nullptr;
+  if (fc)
+  {
+    fc->pb = io;
+    fc->flags |= AVFMT_FLAG_CUSTOM_IO;
+    fc->interrupt_callback.callback = ProbeInterrupt;
+    fc->interrupt_callback.opaque = &probe;
+    // on failure avformat_open_input() frees the context, not the custom I/O
+    if (avformat_open_input(&fc, "", format, nullptr) >= 0)
+    {
+      AVDictionary* editions = nullptr;
+      if (av_opt_get_dict_val(fc, "editions", AV_OPT_SEARCH_CHILDREN, &editions) >= 0 && editions)
+      {
+        out = MKV_EDITIONS::Parse(
+            [editions](const char* key) -> const char*
+            {
+              const AVDictionaryEntry* e = av_dict_get(editions, key, nullptr, AV_DICT_MATCH_CASE);
+              return e ? e->value : nullptr;
+            });
+        ok = true;
+      }
+      av_dict_free(&editions);
+      durationMs = fc->duration > 0 ? fc->duration / (AV_TIME_BASE / 1000) : 0;
+      avformat_close_input(&fc);
+    }
+  }
+  av_freep(&io->buffer);
+  avio_context_free(&io);
+  return ok;
+}
+} // namespace
+
+namespace MKV_EDITIONS
+{
+
+std::optional<CFileItem> AskBeforePlayback(const CFileItem& item)
+{
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_HADESMKVEDITIONS))
+    return std::nullopt;
+  if (item.IsFolder() || item.HasPVRChannelInfoTag())
+    return std::nullopt;
+  const std::string path = item.GetDynPath();
+  if (!URIUtils::HasExtension(path, ".mkv|.mk3d"))
+    return std::nullopt;
+
+  File file;
+  int64_t durationMs = 0;
+  const auto start = std::chrono::steady_clock::now();
+  if (!ReadEditions(path, file, durationMs))
+  {
+    CLog::Log(LOGINFO, "MKV editions: could not read the editions of {}: it plays as it is stored",
+              CURL::GetRedacted(path));
+    return std::nullopt;
+  }
+  const auto took =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start);
+  const std::vector<size_t> offered = Offered(file, durationMs);
+  CLog::Log(LOGINFO, "MKV editions: {} edition(s) in {} ({} ms to read), {} that can be offered",
+            file.editions.size(), CURL::GetRedacted(path), took.count(), offered.size());
+  if (offered.size() < 2)
+    return std::nullopt;
+
+  auto* dialog =
+      CServiceBroker::GetGUI()->GetWindowManager().GetWindow<CGUIDialogSelect>(WINDOW_DIALOG_SELECT);
+  if (!dialog)
+    return std::nullopt;
+  dialog->Reset();
+  const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  dialog->SetHeading(CVariant{strings.Get(39807)});
+  const size_t fileDefault = DefaultEdition(file);
+  int preselect = 0;
+  for (size_t k = 0; k < offered.size(); k++)
+  {
+    const size_t i = offered[k];
+    const Plan plan = PlanEdition(file, i, durationMs);
+    const std::string label = file.editions[i].name.empty()
+                                  ? StringUtils::Format(strings.Get(39808), i + 1)
+                                  : file.editions[i].name;
+    CFileItem entry(label);
+    entry.SetLabel2(StringUtils::SecondsToTimeString(static_cast<long>(plan.durationMs / 1000)));
+    dialog->Add(entry);
+    if (i == fileDefault)
+      preselect = static_cast<int>(k);
+  }
+  dialog->SetSelected(preselect);
+  dialog->Open();
+
+  // Only a choice the user confirmed counts: a dialog closed by anything else plays the file as
+  // it is stored, as without the setting.
+  const int selected = dialog->GetSelectedItem();
+  if (!dialog->IsConfirmed() || selected < 0 || static_cast<size_t>(selected) >= offered.size())
+  {
+    CLog::Log(LOGINFO, "MKV editions: no edition chosen: the file plays as it is stored");
+    return std::nullopt;
+  }
+  const size_t chosen = offered[static_cast<size_t>(selected)];
+  CFileItem withEdition(item);
+  withEdition.SetProperty(PROPERTY_INDEX, static_cast<int>(chosen));
+  withEdition.SetProperty(PROPERTY_UID, std::to_string(file.editions[chosen].uid));
+  CLog::Log(LOGINFO, "MKV editions: edition {} \"{}\" chosen", chosen, file.editions[chosen].name);
+  return withEdition;
+}
+
+} // namespace MKV_EDITIONS
diff --git a/xbmc/cores/VideoPlayer/MatroskaEditionChoice.h b/xbmc/cores/VideoPlayer/MatroskaEditionChoice.h
