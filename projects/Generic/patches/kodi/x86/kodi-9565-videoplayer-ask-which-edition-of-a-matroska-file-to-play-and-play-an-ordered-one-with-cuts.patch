+  // Hades: the edition of a Matroska file chosen before playback, checked against this demuxer;
+  // an ordered one plays as the file with the parts it leaves out cut (added to the edit list below)
+  m_editionCuts.clear();
+  if (const auto* ffmpeg = dynamic_cast<CDVDDemuxFFmpeg*>(m_pDemuxer.get());
+      ffmpeg && !ffmpeg->GetMatroskaEditions().editions.empty())
+  {
+    const CVariant index = m_item.GetProperty(MKV_EDITIONS::PROPERTY_INDEX);
+    const CVariant uid = m_item.GetProperty(MKV_EDITIONS::PROPERTY_UID);
+    const MKV_EDITIONS::File& editions = ffmpeg->GetMatroskaEditions();
+    const MKV_EDITIONS::Choice choice = MKV_EDITIONS::Chosen(
+        editions, index.isNull() ? -1 : index.asInteger(),
+        uid.isNull() ? 0 : std::strtoull(uid.asString().c_str(), nullptr, 10),
+        m_pDemuxer->GetStreamLength());
+    if (choice.play)
+    {
+      for (const MKV_EDITIONS::Cut& cut : choice.plan.cuts)
+        m_editionCuts.push_back({std::chrono::milliseconds(cut.startMs),
+                                 std::chrono::milliseconds(cut.endMs), EDL::Action::CUT});
+      CLog::Log(LOGINFO, "MKV editions: playing edition {} \"{}\": {}, {} cut(s)", choice.index,
+                editions.editions[choice.index].name, MKV_EDITIONS::FormatMs(choice.plan.durationMs),
+                m_editionCuts.size());
+      for (const MKV_EDITIONS::Cut& cut : choice.plan.cuts)
+        CLog::Log(LOGINFO, "MKV editions: cut {} - {}", MKV_EDITIONS::FormatMs(cut.startMs),
+                  MKV_EDITIONS::FormatMs(cut.endMs));
+    }
+    else if (!index.isNull())
+      CLog::Log(LOGINFO, "MKV editions: {}: the file plays as it is stored", choice.why);
+  }
+
   m_SelectionStreams.Clear(StreamType::NONE, STREAM_SOURCE_DEMUX);
   m_SelectionStreams.Clear(StreamType::NONE, STREAM_SOURCE_NAV);
   m_SelectionStreams.Update(m_pInputStream, m_pDemuxer.get());
@@ -5020,6 +5050,13 @@ bool CVideoPlayer::OpenVideoStream(CDVDStreamInfo& hint, bool reset)
     if (m_CurrentVideo.hint.fpsscale > 0.0f)
       fFramesPerSecond = static_cast<float>(m_CurrentVideo.hint.fpsrate) / static_cast<float>(m_CurrentVideo.hint.fpsscale);
     m_Edl.ReadEditDecisionLists(m_item, fFramesPerSecond, GetSourceStreamLength());
+    if (!m_editionCuts.empty())
+    {
+      const size_t added = m_Edl.AddCuts(m_editionCuts);
