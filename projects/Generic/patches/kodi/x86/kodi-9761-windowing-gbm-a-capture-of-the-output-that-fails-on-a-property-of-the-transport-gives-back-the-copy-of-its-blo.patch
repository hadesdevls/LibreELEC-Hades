From 298728870eda41dacf9ed218933b666348094558 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:17:58 +0000
Subject: [PATCH] windowing/gbm: a capture of the output that fails on a
 property of the transport gives back the copy of its blob

CSnapshot::Capture() copies the blob of every blob property that it
keeps (its bytes, so that it can be put back once the transport has
replaced it) before it looks at what the transport sets on that
property. Where that fails (the blob of the signal cannot be read, an
enum has no value of the name, a required value is not taken), the
capture returns through fail(), which gives back the blobs of the
entries made so far: the copy of the property being read was not one of
them yet, and stayed with the descriptor until Kodi ended. On nvidia-drm
that is the copy of the HDMI vendor InfoFrame of Kodi's 3D output, which
TakeOver() lets native output take.

The failures after the copy give it back first. A test on the host
(a model of the kernel that counts the blobs that a user still holds)
fails without this and passes with it.
---
 xbmc/windowing/gbm/drm/OutputState.h | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/OutputState.h b/xbmc/windowing/gbm/drm/OutputState.h
index 9520493..bee9296 100644
--- a/xbmc/windowing/gbm/drm/OutputState.h
+++ b/xbmc/windowing/gbm/drm/OutputState.h
@@ -442,6 +442,15 @@ public:
             continue;
           }
         }
+        // (a failure from here on gives back the copy of this property's blob too: it is not among
+        // the entries that Release() destroys yet)
+        const auto failHere = [&](std::string why)
+        {
+          if (entry.copy)
+            kms.DestroyBlob(entry.copy);
+          entry.copy = 0;
+          return fail(std::move(why));
+        };
         entry.restorable = info.kind == Kind::BLOB || info.Accepts(entry.original);
         if (!entry.restorable)
           ++m_notRestorable;
@@ -455,7 +464,7 @@ public:
             {
               const auto named = info.EnumValue(spec->enumName);
               if (!named)
-                return fail(label + "has no value \"" + spec->enumName + "\"");
+                return failHere(label + "has no value \"" + spec->enumName + "\"");
               entry.transportValue = *named;
               break;
             }
@@ -463,7 +472,7 @@ public:
             {
               const auto data = kms.BlobData(spec->number);
               if (!data)
-                return fail(label + "could not be given its blob (the signal)");
+                return failHere(label + "could not be given its blob (the signal)");
               entry.transportValue = spec->number;
               entry.transportData = *data;
               break;
@@ -472,7 +481,8 @@ public:
               if (!info.Accepts(spec->number))
               {
                 if (spec->required)
-                  return fail(label + "does not take the value " + std::to_string(spec->number));
+                  return failHere(label + "does not take the value " +
+                                  std::to_string(spec->number));
                 taken = false;
               }
               entry.transportValue = spec->number;
-- 
