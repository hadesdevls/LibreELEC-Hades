From b55e325adc30f5a2b86d1e2b20dcafdbb250de92 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:45:42 +0000
Subject: [PATCH] windowing/gbm: layers that could not be imported, counted in
 the 10 s lines of Dolby Vision

A picture of the base layer that VAAPI could not export (or whose
textures could not be made) is not drawn, and one of the enhancement
layer that could not be imported is drawn without it. Each says so in
kodi.log, but the log folds a message that repeats within ten seconds
into "Skipped N duplicate messages": one diagnostic of a GT 1030 showed
138 warnings of the base layer where there had been 1247 failures, and
133 of the enhancement layer where there had been 177, and no line of
the bridge counted either.

The window system counts the failures of the base layer
(DVBaseImportFailed(), from CRendererVAAPIGLES::UploadTexture()) and the
bridge those of the enhancement layer (PrepareHardware()), and the line
of each 10 s of native output says both where there were any: "layers
that could not be imported: the base layer N times (the picture not
drawn), the enhancement layer N times (the picture drawn without it)".
Both start again with each output.
---
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.cpp     |  2 ++
 .../cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h |  7 +++++++
 .../HwDecRender/RendererVAAPIGLES.cpp               |  9 +++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp      | 13 +++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h        |  6 ++++++
 5 files changed, 37 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index e8126ae..2fefc58 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1328,6 +1328,8 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancemen
     const std::string stage =
         std::string("enhancement-dmabuf-import ") + dvbridge_dmabuf_last_error();
     Fail(stage.c_str());
+    // (Hades: for the 10 s lines, where the repeated message is folded)
+    m_layerImportFailures.fetch_add(1, std::memory_order_relaxed);
     const bool result = Prepare(base, nullptr, metadata, geometry, allowPacked);
     if (result)
       ReportLayers(base, nullptr, enhancement, nullptr, false, false, metadata);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index fb51959..93fef6f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -235,6 +235,12 @@ public:
   const PresentedDetail& GetPresentedDetail() const { return m_presentedDetail; }
   //! Presented frames whose L1 differed from the previous presented frame, since the last call.
   unsigned int TakeL1Changes();
+  //! Hades: the pictures of the enhancement layer that could not be imported (PrepareHardware(),
+  //! drawn without the layer) since the last call
+  unsigned int TakeLayerImportFailures()
+  {
+    return m_layerImportFailures.exchange(0, std::memory_order_relaxed);
+  }
   //! Hades: the GPU time of each pass of the frames, where advancedsettings.xml asks for it
   //! (<video><dvpasstimes>true</dvpasstimes></video>, read when the bridge is first initialized): the
   //! passes since the last call, the most time first, up to max (dvbridge_render_take_pass_times());
@@ -579,6 +585,7 @@ private:
   PresentedDetail m_pendingDetail;
   PresentedDetail m_presentedDetail;
   unsigned int m_l1Changes = 0;
+  std::atomic<unsigned int> m_layerImportFailures{0}; //!< Hades: TakeLayerImportFailures()
   unsigned m_pendingInfo = 0;
   unsigned int m_framebuffer = 0;
   bool m_sourceWanted = false; //!< see UseSourceTransport()
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 52e7dca..1ae97e7 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -511,7 +511,16 @@ bool CRendererVAAPIGLES::UploadTexture(int index)
 
   m_vaapiTextures[index] = m_texturePool.Get(pic, m_vaapiTextures);
   if (!m_vaapiTextures[index])
+  {
+#ifdef HAVE_DVBRIDGE
+    // Hades: counted for the 10 s lines of Dolby Vision in kodi.log, where the repeated warning of
+    // the pool is folded into "Skipped N duplicate messages"
+    if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+            CServiceBroker::GetWinSystem()))
+      window->DVBaseImportFailed();
+#endif
     return false;
+  }
 
   YuvImage &im = buf.image;
   CYuvPlane (&planes)[3] = buf.fields[0];
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2133925..fe01ae3 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -744,8 +744,12 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
           m_dvStats.start = std::chrono::steady_clock::now();
           m_dvLastWindow = {};
           m_dvDiscards.store(0, std::memory_order_relaxed);
+          m_dvBaseImportFailures.store(0, std::memory_order_relaxed);
           if (m_dvBridge)
+          {
             m_dvBridge->TakeL1Changes();
+            m_dvBridge->TakeLayerImportFailures();
+          }
         }
       }
     }
@@ -8270,6 +8274,15 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
         "between flips and those against the player's clock (from asking for each to its first "
         "frame: the longest {:.0f} ms)",
         m_dvStats.seeks, m_dvStats.seekMaxMs);
+  // Hades: the pictures whose layers could not be imported, which kodi.log folds into "Skipped N
+  // duplicate messages" after the first warning of each kind
+  const unsigned int baseFailed = m_dvBaseImportFailures.exchange(0, std::memory_order_relaxed);
+  const unsigned int layerFailed = m_dvBridge ? m_dvBridge->TakeLayerImportFailures() : 0;
+  if (baseFailed || layerFailed)
+    ioctls += StringUtils::Format(
+        "; layers that could not be imported: the base layer {} times (the picture not drawn), the "
+        "enhancement layer {} times (the picture drawn without it)",
+        baseFailed, layerFailed);
   // Hades: the frames whose GUI the packer composited itself (video/dvguiinplace)
   if (m_dvStats.guiInPlace)
     ioctls += StringUtils::Format("; {} frames with GUI elements composited by the packer, from "
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index b41495a..059e69b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -323,6 +323,11 @@ public:
     m_dvDiscards.fetch_add(1, std::memory_order_relaxed);
     m_dvStepSeeks.fetch_add(1, std::memory_order_relaxed);
   }
+  //! Hades: a picture of the base layer could not be imported for the GPU (with VAAPI, its surface
+  //! not exported or its textures not made: CVaapiTexturePool::Get()), and is not drawn; counted
+  //! in the DV statistics, since kodi.log folds the repeated warning into "Skipped N duplicate
+  //! messages". Any thread.
+  void DVBaseImportFailed() { m_dvBaseImportFailures.fetch_add(1, std::memory_order_relaxed); }
   //! Hades: the render manager chose a frame for the screen, whose time by the player's clock is
   //! dueNs (steady clock, CPresentLag). Main thread, before the pass that presents it.
   //! Hades: ... and soundNs, when its sound is played (the clock with its adjustment to the
@@ -851,6 +856,7 @@ private:
   } m_dvStats;
   void LogDVStats(const char* period);
   std::atomic<unsigned int> m_dvDiscards{0};
+  std::atomic<unsigned int> m_dvBaseImportFailures{0}; //!< Hades: DVBaseImportFailed()
   //! GPU time of the Dolby Vision work of a frame, from before PrepareHardware() to after the
   //! pack: GL timestamps (GL_EXT_disjoint_timer_query) read back on a later frame, never waited
   //! for. The queries exist while native output is captured.
-- 
2.53.0

