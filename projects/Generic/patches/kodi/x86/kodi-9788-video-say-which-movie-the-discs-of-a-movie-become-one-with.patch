From 99f2558fe1d51e1f88749c3aaf81d06770262523 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 28 Oct 2026 21:51:21 +0000
Subject: [PATCH] [Video] Say which movie the discs of a movie become one with.

Of the movies already in the library, the one of the lowest disc is
kept, and the movie just added joins it, though its disc is lower. The
comment said the lowest disc's movie was kept whichever disc was added.

The movie just added holds only what its scraper or nfo gave it, while
those already there may hold what the user set on them, which a movie
made a version loses. A test now covers a lower disc being added.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dialogs/GUIDialogVideoManagerVersions.cpp |  4 +++-
 xbmc/video/test/TestVideoInfoScanner.cpp      | 24 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp b/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
index 3179053..b692126 100644
--- a/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
@@ -830,7 +830,9 @@ bool MergeMoviesBeside(const CFileItem& item, CFileItemList& list, CVideoDatabas
     }
   }
 
-  // The movie of the lowest disc keeps its details, whichever of the discs is added
+  // Of the movies already in the library, the one of the lowest disc is kept and the others join
+  // it, as does the item. The item has just been added from its scraper or nfo, while they may
+  // hold what the user set on them, which a movie made a version loses.
   std::ranges::sort(beside, {},
                     [](const std::shared_ptr<CFileItem>& movie)
                     {
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index c0d5c69..fc95cf4 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -858,6 +858,30 @@ TEST_F(TestVideoInfoScanner, DiscsOfAMovieInItsFolderBecomeOneMovie)
   EXPECT_EQ(idFirst, m_db.GetMovieId(third));
 }
 
+// The movie of the lowest disc of those already in the library is kept, though the disc added is
+// lower, as they may hold what the user set on them
+TEST_F(TestVideoInfoScanner, ALowerDiscAddedJoinsTheMovieOfTheLowestDiscAlreadyThere)
+{
+  GroupSimilarVideosAutomatically();
+  const std::string folder{URIUtils::AddFileToFolder(m_root, "Film (2010)")};
+  const std::string first{URIUtils::AddFileToFolder(folder, "Disc 1", "Film.mkv")};
+  const std::string second{URIUtils::AddFileToFolder(folder, "Disc 2", "Film.mkv")};
+  const std::string third{URIUtils::AddFileToFolder(folder, "Disc 3", "Film.mkv")};
+  ASSERT_GT(AddFilm(third), 0);
+  const int idSecond{AddFilm(second)};
+  ASSERT_GT(idSecond, 0);
+  const int idFirst{AddFilm(first)};
+  ASSERT_GT(idFirst, 0);
+
+  TestScanner scanner{m_settings};
+  EXPECT_EQ(VersionConversionResult::SUCCESS, scanner.GroupWithSimilar(idFirst).first);
+
+  EXPECT_EQ(1, CountMovies());
+  EXPECT_EQ(idSecond, m_db.GetMovieId(first));
+  EXPECT_EQ(idSecond, m_db.GetMovieId(second));
+  EXPECT_EQ(idSecond, m_db.GetMovieId(third));
+}
+
 // A copy elsewhere may be kept apart on purpose, so only the disc beside the movie joins it
 TEST_F(TestVideoInfoScanner, ACopyOfAMovieInAnotherFolderStaysApart)
 {
