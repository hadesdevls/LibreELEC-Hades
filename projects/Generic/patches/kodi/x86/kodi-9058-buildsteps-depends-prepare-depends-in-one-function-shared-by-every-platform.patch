 XBMC_PLATFORM_DIR=android
 . $WORKSPACE/tools/buildsteps/defaultenv
 
-#clean without depends for skipping depends build if possible
-#also skip binary addons (pvr, audioencoder) as long as they are deployed in tree
-cd $WORKSPACE;git clean -xfd -e "cmake/.last_success_revision" -e "tools/depends" -e "/$BUILD_CACHE_NAME" ${DEPLOYED_BINARY_ADDONS}
-
-# if depends path has changed - cleanout everything and restore a cached build of this revision or do a full rebuild
-if [ "$(pathChanged $WORKSPACE/tools/depends)" == "1" ]
-then
-  cacheBuild $WORKSPACE/tools/depends
-  #clean up the rest too
-  cd $WORKSPACE;git clean -xffd -e "/$BUILD_CACHE_NAME"
-  if ! restoreCachedBuild $WORKSPACE/tools/depends
-  then
-    cd $WORKSPACE/tools/depends/;./bootstrap
-  fi
-fi
+prepareDepends
