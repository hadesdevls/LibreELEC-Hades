+
+#pragma once
+
+#include <cstdint>
+
+namespace KODI
+{
+namespace GUILIB
+{
+
+/*!
+ * \brief Hades: the processing passes of the GUI and of each window, so that a control can tell
+ *        whether it stayed on screen since it was last processed
+ *
+ * A control is processed only while it is shown: CGUIControl::DoProcess() calls Process() only for a
+ * visible control, a group processes its controls only while it is processed itself, and a window
+ * only while it is open. A control cannot see the passes it was left out of; these counters tell it.
+ *
+ * The window manager starts a pass of the GUI each time it processes the windows
+ * (CGUIWindowManager::Process()); no pass is started while the GUI is not processed at all (the
+ * display asleep, a change of the display mode that holds the thread), so a wait is no gap. A window
+ * counts passes of its own: one for each pass that processes its controls, and one more when it was
+ * not shown in the pass of the GUI before (closed, or another window was the active one). A window
+ * that is shown but not processed again, as advancedsettings.xml <gui><smartredraw> leaves a window
+ * where nothing is dirty, keeps its count: its controls stay on screen as they were. A processing of
+ * a window from inside its own (a modal loop) is in the same pass. A control that its window
+ * processes in two of its passes that do not follow each other was not on screen in between: it, a
+ * group around it or its window was hidden.
+ *
+ * Only the application thread processes the GUI (CGUIWindowManager::Process() asserts it). This
+ * header only counts and decides; a test builds it on the host.
+ */
+class CGUIProcessPass
+{
+public:
+  //! The window manager starts a pass of the GUI
+  static void StartGuiPass() { ++s_guiPass; }
+
+  //! The pass of the window whose controls are being processed (0: none is)
+  static uint64_t WindowPass() { return s_windowPass; }
+
+  class CProcessing;
+
+  //! The passes of a window
+  class CWindow
+  {
+  public:
+    //! The window is shown in this pass of the GUI, processed or not: a window that was not shown
+    //! in the pass before counts one pass more, which its controls see as a pass they missed
+    void Shown()
+    {
+      if (s_guiPass - m_shownIn > 1)
+        ++m_pass;
+      m_shownIn = s_guiPass;
+    }
+
+  private:
+    friend class CProcessing;
+    uint64_t m_shownIn{0};
+    uint64_t m_pass{0};
+    unsigned int m_depth{0};
+  };
+
+  //! A window processes its controls: they are processed in a pass of it while this lives, and the
+  //! pass of the window that was being processed before (if any) is put back after
+  class CProcessing
+  {
+  public:
+    explicit CProcessing(CWindow& window) : m_window(window), m_outer(s_windowPass)
+    {
+      if (m_window.m_depth++ == 0)
+        ++m_window.m_pass;
+      s_windowPass = m_window.m_pass;
+    }
+    ~CProcessing()
+    {
+      --m_window.m_depth;
+      s_windowPass = m_outer;
+    }
+    CProcessing(const CProcessing&) = delete;
+    CProcessing& operator=(const CProcessing&) = delete;
+
+  private:
+    CWindow& m_window;
+    uint64_t m_outer;
+  };
+
+  //! What a control keeps: the last pass of its window that processed it
+  class CControl
+  {
+  public:
+    //! The control is processed now. Returns whether its window had a pass without it since it was
+    //! last processed (it was not on screen in between). Only a later pass than the last one kept is
+    //! kept: the same pass again is no gap, nor is 0 (outside the pass of a window), nor a pass of
+    //! another window that processes the control too and counts lower.
+    bool Processed()
+    {
+      const uint64_t pass = s_windowPass;
+      const bool missed = pass > m_last + 1;
+      if (pass > m_last)
+        m_last = pass;
+      return missed;
+    }
+
+  private:
+    uint64_t m_last{0};
+  };
+
+private:
+  static inline uint64_t s_guiPass{0};
+  static inline uint64_t s_windowPass{0};
+};
+
+} // namespace GUILIB
+} // namespace KODI
