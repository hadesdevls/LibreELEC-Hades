diff --git a/xbmc/guilib/GUIProcessPass.h b/xbmc/guilib/GUIProcessPass.h
new file mode 100644
index 0000000..42f6352
--- /dev/null
+++ b/xbmc/guilib/GUIProcessPass.h
@@ -0,0 +1,122 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
