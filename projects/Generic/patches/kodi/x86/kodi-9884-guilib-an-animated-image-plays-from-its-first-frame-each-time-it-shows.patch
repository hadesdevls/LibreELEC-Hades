--- a/xbmc/guilib/GUIImage.cpp
+++ b/xbmc/guilib/GUIImage.cpp
@@ -131,6 +131,14 @@ void CGUIImage::AllocateOnDemand()
 
 void CGUIImage::Process(unsigned int currentTime, CDirtyRegionList &dirtyregions)
 {
+  // Hades: an image that was not on screen since it was last processed (it, a group around it or
+  // its window was hidden) plays its animated texture from the first frame, as one that is loaded
+  // again when it shows does: only an image whose resources are freed while it is hidden used to
+  // (the pointer window keeps its images, and a hidden group does not process what is in it). One
+  // that stayed on screen goes on, however long the GUI waited.
+  if (m_passes.Processed() && m_textureCurrent->RestartAnimation())
+    MarkDirtyRegion();
+
   ProcessState();
 
   ProcessAllocation();
