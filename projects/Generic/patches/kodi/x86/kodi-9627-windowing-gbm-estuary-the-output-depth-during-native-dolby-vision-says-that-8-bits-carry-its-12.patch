@@ -3157,6 +3157,12 @@ msgctxt "#32427"
 msgid "Dolby Vision as HDR10+"
 msgstr ""
 
+#: addons/skin.estuary/xml/Variables.xml
+#. Output depth during native Dolby Vision: the 8-bit RGB of its transport, which carries its 12-bit picture (the "Transport" row, #31828, says the format)
+msgctxt "#32428"
+msgid "8 bits: Dolby Vision carries its 12 bits in them"
+msgstr ""
+
 #: addons/skin.estuary/xml/Variables.xml
 #. Reason on the Dolby Vision page of the player information: its own HDR10+ metadata were chosen over its Dolby Vision ("With Dolby Vision and HDR10+ in one video", or the output chosen for the video)
 msgctxt "#32426"
