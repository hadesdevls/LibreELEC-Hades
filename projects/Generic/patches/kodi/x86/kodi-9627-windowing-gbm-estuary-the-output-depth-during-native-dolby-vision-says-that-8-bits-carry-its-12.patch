+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -3012,6 +3012,12 @@ msgctxt "#32427"
 msgid "Dolby Vision as HDR10+"
 msgstr "Dolby Vision como HDR10+"
 
+#: addons/skin.estuary/xml/Variables.xml
+#. Output depth during native Dolby Vision: the 8-bit RGB of its transport, which carries its 12-bit picture (the "Transport" row, #31828, says the format)
+msgctxt "#32428"
+msgid "8 bits: Dolby Vision carries its 12 bits in them"
+msgstr "8 bits: Dolby Vision lleva en ellos sus 12 bits"
+
 #: addons/skin.estuary/xml/Variables.xml
 #. Reason on the Dolby Vision page of the player information: its own HDR10+ metadata were chosen over its Dolby Vision ("With Dolby Vision and HDR10+ in one video", or the output chosen for the video)
 msgctxt "#32426"
diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index e47d7be..f1d5219 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -927,6 +927,8 @@
 	     "upto", at most that many, the driver chooses; "driver", the driver chooses. Hades: "link",
 	     exactly that many in that format, as i915 and amdgpu said of HDR output, and at 8 bits why) -->
 	<variable name="HadesOutDepthVar">
+		<!-- Hades: native Dolby Vision, 8-bit RGB that carries its 12-bit picture (the Transport row) -->
+		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),dv)">$LOCALIZE[32428]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),setting)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31985])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31984])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31986])</value>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 224cb24..e3d29a5 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -178,6 +178,7 @@
 		<value>$ADDON[skin.estuary 31853]</value>
 	</variable>
 	<variable name="HadesOutDepthVar">
+		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),dv)">$ADDON[skin.estuary 32428]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),setting)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($ADDON[skin.estuary 31985])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($ADDON[skin.estuary 31984])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($ADDON[skin.estuary 31986])</value>
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index dd2870f..3382e0d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -8601,6 +8601,17 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
             info["hades.out.depthwhy"] = HDRShallowWhy();
         }
       }
+      // Hades: native Dolby Vision goes over HDMI as 8-bit RGB on every driver (the transport, the
+      // row above it: nvidia-drm with "max bpc" 8, i915 and amdgpu at the depth the tunnel sets),
+      // and its 12-bit picture travels in those 8 bits: the depth says so, not "8 bits (fixed)" or
+      // "up to", which read as a limit to raise (a user asked how to get 12 bits)
+      if (native)
+      {
+        info["hades.out.depthkind"] = "dv";
+        info["hades.out.depth"] = "8";
+        info["hades.out.linkformat"] = "";
+        info["hades.out.depthwhy"] = "";
+      }
 #endif
       // What the display is told of the picture: native Dolby Vision, or the EOTF of the HDR
       // static metadata InfoFrame that the driver has, with its mastering display and light
-- 
