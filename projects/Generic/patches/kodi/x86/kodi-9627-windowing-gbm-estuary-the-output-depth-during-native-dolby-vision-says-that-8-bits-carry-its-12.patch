diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index a98eb03..9829c54 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -3012,6 +3012,12 @@ msgctxt "#32427"
 msgid "Dolby Vision as HDR10+"
 msgstr "Dolby Vision como HDR10+"
 
+#: addons/skin.estuary/xml/Variables.xml
+#. Output depth during native Dolby Vision: the 8-bit RGB of its transport, which carries its 12-bit picture (the "Transport" row, #31828, says the format)
+msgctxt "#32428"
+msgid "8 bits: Dolby Vision carries its 12 bits in them"
+msgstr "8 bits: Dolby Vision lleva en ellos sus 12 bits"
+
 #: addons/skin.estuary/xml/Variables.xml
