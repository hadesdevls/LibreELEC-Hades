diff --git a/xbmc/cores/AudioEngine/Utils/DownmixLevels.h b/xbmc/cores/AudioEngine/Utils/DownmixLevels.h
new file mode 100644
index 0000000..414915d
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/DownmixLevels.h
@@ -0,0 +1,75 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: the level at which a downmix mixes the centre channel into the front ones, for whoever plays
+// 5.1 or 7.1 on a TV, a stereo sound bar or headphones.
+//
+// Kodi takes the centre level that the track asks for (FFmpeg's AV_FRAME_DATA_DOWNMIX_INFO: AC-3's
+// cmixlev, E-AC-3's), or -3 dB for a track that asks for none, and adds the level of the video (its
+// audio settings, in steps of 1 dB, kept in the library as a whole number). Hades adds, in Settings >
+// System > Audio, a level in steps of 0.5 dB (audiooutput.hadescentrelevel), and the choice not to take
+// the track's (audiooutput.hadesdownmixlevels). The engine's resampler uses the level only where it
+// downmixes (swresample's center_mix_level): sound that is passed through, or that plays on as many
+// speakers as it has, does not change. With the track's level taken and 0.0 dB, the level is Kodi's own
+// expression, bit for bit.
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <optional>
+#include <string>
+
+namespace KODI::AE::DOWNMIX
+{
+
+//! The centre level of a downmix, as a gain
+inline double CentreMixLevel(std::optional<double> trackLevel,
+                             bool useTrackLevel,
+                             int videoDb,
+                             double settingDb)
+{
+  const double clev = trackLevel && useTrackLevel ? *trackLevel : M_SQRT1_2;
+  const double curDB = 20 * log10(clev);
+  return pow(10, (curDB + videoDb + settingDb) / 20);
+}
+
+//! Whether a centre level is not the one Kodi would use: the track's set aside, or a level of the
+//! setting
+inline bool HadesLevel(std::optional<double> trackLevel, bool useTrackLevel, double settingDb)
+{
+  return settingDb != 0.0 || (trackLevel && !useTrackLevel);
+}
+
+//! What kodi.log says of it
+inline std::string Describe(std::optional<double> trackLevel,
+                            bool useTrackLevel,
+                            int videoDb,
+                            double settingDb,
+                            double level)
+{
+  const auto db = [](double gain) { return gain > 0 ? 20 * log10(gain) : -std::numeric_limits<double>::infinity(); };
+  char from[160];
+  if (!trackLevel)
+    std::snprintf(from, sizeof(from), "-3.0 dB (the track asks for none)");
+  else if (useTrackLevel)
+    std::snprintf(from, sizeof(from), "%.1f dB, the track's", db(*trackLevel));
+  else
+    std::snprintf(from, sizeof(from),
+                  "-3.0 dB (the track's %.1f dB set aside: setting \"audiooutput.hadesdownmixlevels\")",
+                  db(*trackLevel));
+  char line[400];
+  std::snprintf(line, sizeof(line),
+                "in a downmix, the centre is mixed at %.1f dB: %s, %+d dB of the video, %+.1f dB of "
+                "the setting \"audiooutput.hadescentrelevel\"",
+                db(level), from, videoDb, settingDb);
+  return line;
+}
+
+} // namespace KODI::AE::DOWNMIX
