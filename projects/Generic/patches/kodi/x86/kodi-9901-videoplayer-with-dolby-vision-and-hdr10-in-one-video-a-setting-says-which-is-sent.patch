+ * \param setting videoscreen.hadesdualhdr (DualHdr)
+ * \param choice the output chosen for the video
+ * \param profile, compatibility its Dolby Vision profile and base layer compatibility
+ * \param nativeDV the display takes native Dolby Vision in a mode that carries it
+ * \param hdr10Plus HDR10+ metadata can be sent to the display (its block, and the connector's
+ *        HDR10PLUS_VSIF: CWinSystemGbm::HDR10PlusOutputVersion())
+ *
+ * HDR10+ only where its base layer is HDR10 (BaseLayerIsHdr10(): profile 7 of a Blu-ray disc, 8.1), whose
+ * HDR10+ metadata describe that picture; only where the display takes both; with the output chosen for the
+ * video as the settings say (AUTOMATIC) or as HDR10+. Everything else is sent as before.
+ */
+constexpr DualVerdict DualVerdictOf(
+    int setting, OutputChoice choice, int profile, int compatibility, bool nativeDV, bool hdr10Plus)
+{
+  if (!BaseLayerIsHdr10(profile, compatibility))
+    return DualVerdict::BASE_LAYER;
+  if (choice != OutputChoice::AUTOMATIC && choice != OutputChoice::DOLBY_VISION &&
+      choice != OutputChoice::HDR10PLUS)
+    return DualVerdict::OTHER_CHOICE;
+  if (!nativeDV || !hdr10Plus)
+    return DualVerdict::DISPLAY;
+  if (choice == OutputChoice::HDR10PLUS)
+    return DualVerdict::HDR10PLUS_CHOSEN;
+  if (choice == OutputChoice::DOLBY_VISION)
+    return DualVerdict::DOLBY_VISION_CHOSEN;
+  return setting == static_cast<int>(DualHdr::HDR10PLUS) ? DualVerdict::HDR10PLUS
+                                                         : DualVerdict::DOLBY_VISION;
