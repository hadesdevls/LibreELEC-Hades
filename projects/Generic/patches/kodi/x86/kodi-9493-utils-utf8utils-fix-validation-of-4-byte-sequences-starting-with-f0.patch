From 32af5b97da075bae708f6a2c9b3751f308402b71 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Wed, 21 Oct 2026 11:39:14 +0200
Subject: [PATCH] [utils] Utf8Utils: Fix validation of 4-byte sequences
 starting with F0

The range check was applied to the third byte instead of the second, so
e.g. U+1F30D was rejected and overlong encodings were accepted.
---
 xbmc/utils/Utf8Utils.cpp                 | 8 ++++----
 xbmc/utils/test/TestCharsetConverter.cpp | 7 +++++++
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/xbmc/utils/Utf8Utils.cpp b/xbmc/utils/Utf8Utils.cpp
index a45002a..7200160 100644
--- a/xbmc/utils/Utf8Utils.cpp
+++ b/xbmc/utils/Utf8Utils.cpp
@@ -124,10 +124,10 @@ inline size_t CUtf8Utils::SizeOfUtf8Char(const char* const str)
     return 3; // valid UTF-8 3 bytes sequence
 
   /* U+10000 - U+3FFFF in UTF-8 */
-  if (chr == 0xF0                                   /* F0=1111 0000 */
-      && (strU[1] & 0xE0) == 0x80     /* E0=1110 0000, 80=1000 0000 - 9F=1001 1111 */
-      && strU[2] >= 0x90 && strU[2] <= 0xBF         /* 90=1001 0000 - BF=1011 1111 */
-      && (strU[3] & 0xC0) == 0x80)    /* C0=1100 0000, 80=1000 0000 - BF=1011 1111 */
+  if (chr == 0xF0 /* F0=1111 0000 */
+      && strU[1] >= 0x90 && strU[1] <= 0xBF /* 90=1001 0000 - BF=1011 1111 */
+      && (strU[2] & 0xC0) == 0x80 /* C0=1100 0000, 80=1000 0000 - BF=1011 1111 */
+      && (strU[3] & 0xC0) == 0x80) /* C0=1100 0000, 80=1000 0000 - BF=1011 1111 */
     return 4; // valid UTF-8 4 bytes sequence
 
   /* U+40000 - U+FFFFF in UTF-8 */
diff --git a/xbmc/utils/test/TestCharsetConverter.cpp b/xbmc/utils/test/TestCharsetConverter.cpp
index 378eae0..571ce78 100644
--- a/xbmc/utils/test/TestCharsetConverter.cpp
+++ b/xbmc/utils/test/TestCharsetConverter.cpp
@@ -241,6 +241,13 @@ TEST_F(TestCharsetConverter, isValidUtf8_4)
   EXPECT_FALSE(CUtf8Utils::isValidUtf8(refutf16LE3));
 }
 
+TEST_F(TestCharsetConverter, isValidUtf8_FourByteSequences)
+{
+  EXPECT_TRUE(CUtf8Utils::isValidUtf8("\xF0\x90\x80\x80")); // U+10000
+  EXPECT_TRUE(CUtf8Utils::isValidUtf8("\xF0\x9F\x8C\x8D")); // U+1F30D
+  EXPECT_FALSE(CUtf8Utils::isValidUtf8("\xF0\x8F\xBF\xBF")); // overlong U+FFFF
+}
+
