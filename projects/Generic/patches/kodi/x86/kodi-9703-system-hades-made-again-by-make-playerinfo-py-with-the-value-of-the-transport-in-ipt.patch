From 62cc28e1477b4d412bc55faa6352eeb559cc1b54 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:16:15 +0000
Subject: [PATCH] system/hades: made again by make-playerinfo.py, with the
 value of the transport in IPT

The player information of the other skins (system/hades) is what
tools/hades-playerinfo/make-playerinfo.py makes of Estuary's files. The
value "As licensed players send (IPT)" of the transport row, added to
Estuary's Variables.xml with the IPT tunnel, was not in
HadesIncludes.xml: the other skins would have shown nothing there.
Made again by the tool.
---
 system/hades/HadesIncludes.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 37b00ff..8cf6e7c 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -134,6 +134,7 @@
 	</variable>
 	<variable name="HadesDVTransportVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),lowlatency)">$ADDON[skin.estuary 31925]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source) + String.IsEqual(Window(Home).Property(hades.dv.signal),ipt)">$ADDON[skin.estuary 32006]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source) + String.IsEqual(Window(Home).Property(hades.dv.signal),ictcp)">$ADDON[skin.estuary 32002] (ICtCp)</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source)">$ADDON[skin.estuary 32002] (YCbCr)</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),fallback) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$ADDON[skin.estuary 32003] ($ADDON[skin.estuary 31912])</value>
