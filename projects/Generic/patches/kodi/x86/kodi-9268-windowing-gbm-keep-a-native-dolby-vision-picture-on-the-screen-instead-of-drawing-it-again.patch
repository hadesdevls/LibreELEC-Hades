+void CWinSystemGbmGLESContext::KeepDVBridgeFrame()
+{
+  // Hades: instead of drawing the picture on the screen again, and committing it again, the
+  // screen keeps it; the loop goes on as the commit of that frame would have had it go on:
+  //  - presented the way that waits (the frame before was): the commit would have returned with
+  //    the next refresh;
+  //  - presented a frame ahead: it would have waited first for the flip of the frame before
+  //    (that one's out-fence, or a refresh of a picture kept before it), and returned at once,
+  //    its own flip to come with the next refresh, which the commit after it would wait for.
+  //    The picture that a frame shows stays one refresh later than it was drawn, as the render
+  //    manager has it chosen (GetFrameLatencyAdjustment()).
+  // What cannot be paced so (the vblank ioctl fails, the flip of the frame before does not come)
+  // forgets the frame on the screen: the next frame is drawn and presented as before, which deals
+  // with it.
+  const auto start = std::chrono::steady_clock::now();
+  bool paced = true;
+  uint32_t now = 0;
+  if (m_dvAheadPending)
+  {
+    int64_t flippedNs = 0;
+    const int flipBefore = m_DRM->TakeOutFenceFd();
+    paced = flipBefore >= 0 && WaitFence(flipBefore, DV_FLIP_WAIT_MS, &flippedNs);
+    if (paced)
+    {
+      DVAheadFlipped(flippedNs);
+      m_dvAheadPending = false;
+    }
+  }
+  if (paced && m_dvRepeatFlipPending)
+    paced = WaitDVBridgeVBlank(true, m_dvRepeatFlip, now);
+  m_dvRepeatFlipPending = false;
+  paced = paced && WaitDVBridgeVBlank(false, 0, now);
+  if (paced && m_dvAheadShown)
+  {
+    m_dvRepeatFlip = now + 1;
+    m_dvRepeatFlipPending = true;
+    ++m_dvAheadRepeats;
+  }
+  else if (paced)
+    paced = WaitDVBridgeVBlank(true, now + 1, now);
+  if (!paced)
+  {
+    // (not counted either way: the next frame is presented, and tells)
+    m_dvShown = {};
+    m_dvRepeatFlipPending = false;
+    DVAheadForgetFlip();
+    // (as when nothing is prepared: nothing has paced this pass)
+    KODI::TIME::Sleep(10ms);
+    return;
+  }
+  // Counted as a presentation of that picture: it is shown for this refresh
+  const auto end = std::chrono::steady_clock::now();
+  const double presentMs = std::chrono::duration<double, std::milli>(end - start).count();
+  m_dvStats.presentSumMs += presentMs;
+  m_dvStats.presentMaxMs = std::max(m_dvStats.presentMaxMs, presentMs);
+  if (const double periodMs = DVRefreshPeriodMs(); periodMs > 0 && presentMs > 1.5 * periodMs)
+    m_dvStats.late++;
+  if (m_dvStats.hasLastShown)
+    m_dvStats.gapMaxMs = std::max(
+        m_dvStats.gapMaxMs, std::chrono::duration<double, std::milli>(end - m_dvStats.lastShown).count());
+  m_dvStats.lastShown = end;
+  m_dvStats.hasLastShown = true;
+  m_dvStats.shown++;
+  m_dvStats.kept++;
+  if (m_dvBridge)
+  {
+    const auto& detail = m_dvBridge->GetPresentedDetail();
+    m_dvStats.fel += detail.fel ? 1 : 0;
+    m_dvStats.felWithoutLayer += detail.felWithoutLayer ? 1 : 0;
+  }
+  if (m_dvSignalling && end - m_dvStats.start >= std::chrono::seconds(10))
+    LogDVStats("last 10 s");
+  DVBridgeFrameShown(true, m_dvFramePts);
+}
