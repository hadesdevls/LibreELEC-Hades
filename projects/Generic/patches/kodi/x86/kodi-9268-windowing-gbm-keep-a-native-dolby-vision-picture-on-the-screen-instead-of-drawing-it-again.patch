+bool CWinSystemGbmGLESContext::WaitDVBridgeVBlank(bool absolute,
+                                                  uint32_t sequence,
+                                                  uint32_t& reached) const
+{
+  // The legacy vblank ioctl, which takes the index of the CRTC (the high-CRTC form, for any
+  // index); the kernel answers a sequence that has passed at once, and gives up after 3 s.
+  const CDRMCrtc* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+  if (!crtc)
+    return false;
+  drmVBlank vblank{};
+  vblank.request.type = static_cast<drmVBlankSeqType>(
+      (absolute ? DRM_VBLANK_ABSOLUTE : DRM_VBLANK_RELATIVE) |
+      ((crtc->GetOffset() << DRM_VBLANK_HIGH_CRTC_SHIFT) & DRM_VBLANK_HIGH_CRTC_MASK));
+  vblank.request.sequence = sequence;
+  if (drmWaitVBlank(m_DRM->GetFileDescriptor(), &vblank) != 0)
+    return false;
+  reached = vblank.reply.sequence;
+  return true;
+}
