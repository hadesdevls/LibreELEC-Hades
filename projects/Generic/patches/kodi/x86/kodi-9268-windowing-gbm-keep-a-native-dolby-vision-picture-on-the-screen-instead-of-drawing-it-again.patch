+bool CWinSystemGbmGLESContext::DVKeepsPicture(const DVPicture& frame) const
+{
+  // The frame on the screen was presented (and is no other one: what changes it, or the output,
+  // forgets it), and was drawn from the same picture, at the same place, with nothing over it,
+  // the way and at the fidelity step-down level that this one would be drawn: then this one
+  // would be the same bytes, metadata
+  // included (dvbridge_dv_metadata(): a picture of the same time gives the same payload, and the
+  // same metadata id). Not when the next commit would carry more than a frame (properties that
+  // Kodi has set since, a modeset), nor while the output is off.
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto same = [](const dvbridge_geometry& a, const dvbridge_geometry& b)
+  {
+    return a.source_width == b.source_width && a.source_height == b.source_height &&
+           a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height;
+  };
+  return m_dvKeepRepeats && frame.valid && frame.serial != 0 && frame.clean && m_dvShown.valid &&
+         m_dvShown.clean && m_dvShown.serial == frame.serial &&
+         m_dvShown.layered == frame.layered && m_dvShown.allowPacked == frame.allowPacked &&
+         m_dvShown.step == frame.step && same(m_dvShown.geometry, frame.geometry) &&
+         m_dvSignalling && !m_dvEndDeferred &&
+         m_dvState.TransportLive() && drm && drm->IsActive() && !drm->HasPendingRequest();
+}
