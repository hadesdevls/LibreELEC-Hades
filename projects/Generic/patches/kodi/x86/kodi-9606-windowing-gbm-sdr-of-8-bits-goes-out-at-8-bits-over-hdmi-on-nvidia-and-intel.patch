index 0000000..c105301
--- /dev/null
+++ b/xbmc/windowing/gbm/LinkDepth.h
@@ -0,0 +1,171 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: the depth of the link to the display ("max bpc") for what the output carries
+ *
+ * Where nothing asks for a depth, the drivers send as many bits per component as the display and
+ * the mode take. nvidia-drm leaves it to NVKMS, which takes 10 (its max_output_color_depth) and
+ * goes over HDMI FRL as soon as TMDS does not carry the mode at that depth, without trying a lower
+ * one (GetDfpHdmiProtocol()); i915 takes 12, 10 or 8, the first that TMDS carries
+ * (intel_hdmi_compute_bpc()). So the GUI at 2160p60 went out over FRL at 10 bits on an RTX 40, and
+ * at 2160p24 to 30 over TMDS at 371.25 MHz (445.5 MHz on Intel, at 12 bits) with scrambling, for a
+ * picture of 8 bits per component: Kodi draws the GUI in a buffer of 8 bits, and an SDR video of 8
+ * bits too. Windows sends SDR at 8 bits there (2160p60 over TMDS at 594 MHz).
+ *
+ * SDR goes out at 8 bits where the picture has 8 (LinkContent::SDR) on an HDMI link of nvidia-drm
+ * (with NV_OUTPUT_BPC: the Hades patches) or of i915 and xe. An SDR picture of more than 8 bits (a
+ * video of 10 bits in a half-float or 10-bit buffer, SDR_DEEP) keeps the drivers' choice, so that
+ * no code of it is lost. HDR keeps the drivers' choice, or 8 bits where the user chose that
+ * ("HDR output depth", videoscreen.hadeshdrdepth, nvidia-drm only). Native Dolby Vision sets 8
+ * bits for its transport itself (CDVBridgeState) and puts back what it found.
+ *
+ * Not amdgpu: its display core dithers an 8-bit stream by default (DITHER_OPTION_SPATIAL8) and
+ * not a 12-bit one (resource_build_bit_depth_reduction_params()), so the GUI at 2160p24 goes out
+ * at 12 bits with its codes as they are, and at 8 bits it would be dithered.
+ *
+ * A change of "max bpc" is a modeset in the kernel (drm_atomic_helper_check_modeset():
+ * connectors_changed), and on nvidia-drm a modeset of NVKMS that sets the head again
+ * (NvKmsKapiApplyModeSetConfig(): colorBpcChanged). So the depth changes only in a request that
+ * sets the head again anyway (setsHead): a change of mode, the first commit on an output, a
+ * change of the HDR signalling (on nvidia-drm the HDR InfoFrame and the colorimetry are a modeset
+ * where the GPU has no flip-synchronized InfoFrames, which is every GPU with a DisplayPort
+ * connector, and Turing to Blackwell in any case: nvkms-evo.c, SetCoreFid; on i915 and amdgpu the
+ * HDR signalling on or off is a full modeset), and the end of native Dolby Vision. A lower depth
+ * that would come in another request waits for the next such one. A higher one is for a picture
+ * that has more bits: it goes with the request that needs it, which becomes a modeset where it was
+ * not (an SDR video of 10 bits that starts without a change of mode).
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+
+//! What the output carries, as far as the depth of its link goes
+enum class LinkContent
+{
+  SDR, //!< no HDR signalling, a picture of 8 bits per component (the GUI's buffer, an 8-bit video)
+  SDR_DEEP, //!< no HDR signalling, a picture of more (a video of 10 bits, in a deeper buffer)
+  HDR, //!< HDR signalling: HDR10, HLG, HDR10+, Dolby Vision rebuilt as HDR10
+  DV, //!< native Dolby Vision: its transport sets 8 bits itself
+};
+
+//! The output, as LinkDepthFor() looks at it (read when Kodi takes it)
+struct LinkDepthOutput
+{
+  //! Kodi sets "max bpc" on this output: a connector of nvidia-drm with NV_OUTPUT_BPC, or an HDMI
+  //! connector of i915 or xe
+  bool managed = false;
+  //! ... and SDR of 8 bits goes out at 8 bits there: an HDMI link (an HDMI connector, or a
+  //! dual-mode DisplayPort one that nvidia-drm drives as HDMI)
+  bool sdrAt8 = false;
+  //! the top of the range of "max bpc": the drivers' own choice
+  uint64_t maximum = 0;
+};
+
+//! "max bpc" holds the link at 8 bits (below 10: nvidia-drm asks NVKMS for 8 there and for
+//! nothing from 10 on, nv_drm_connector_requested_bpc(); Kodi sets only 8 or the maximum)
+constexpr bool LinkHeldAt8(uint64_t maxBpc)
+{
+  return maxBpc < 10;
+}
+
+//! What the depth of the link is for this content: 8, or the drivers' choice (the maximum)
+//! \param hdrSetting the setting "HDR output depth": 8 holds HDR at 8 bits, anything else does not
+constexpr uint64_t LinkDepthWanted(const LinkDepthOutput& out, LinkContent content, int hdrSetting)
+{
+  switch (content)
+  {
+    case LinkContent::HDR:
+      return hdrSetting == 8 ? 8 : out.maximum;
+    case LinkContent::SDR_DEEP:
+      return out.maximum;
+    case LinkContent::SDR:
+    case LinkContent::DV:
+      break;
+  }
+  return out.sdrAt8 ? 8 : out.maximum;
+}
+
+//! What LinkDepthFor() decided
+struct LinkDepthStep
+{
+  //! the value to add to the request now; nothing: "max bpc" is not touched
+  std::optional<uint64_t> maxBpc;
+  //! a lower depth is wanted, and waits for a request that sets the head again anyway
+  bool waits = false;
+  //! a higher depth is wanted: the request is a modeset for it, where it was not one already
+  bool raises = false;
+};
+
+/*!
+ * \brief The depth of the link with a request
+ * \param content what the output carries after the request
+ * \param hdrSetting see LinkDepthWanted()
+ * \param current "max bpc" in the request being built, or else on the connector (the value of
+ *        the last commit that the driver took)
+ * \param setsHead the request sets the head again whatever its depth (see above)
+ */
+constexpr LinkDepthStep LinkDepthFor(const LinkDepthOutput& out,
+                                     LinkContent content,
+                                     int hdrSetting,
+                                     uint64_t current,
+                                     bool setsHead)
+{
+  if (!out.managed || out.maximum < 8)
+    return {};
+  const uint64_t wanted = LinkDepthWanted(out, content, hdrSetting);
+  if (LinkHeldAt8(wanted) == LinkHeldAt8(current))
+    return {};
+  if (LinkHeldAt8(wanted))
+  {
+    if (!setsHead)
+      return {std::nullopt, true, false};
+    return {wanted, false, false};
+  }
+  return {wanted, false, !setsHead};
+}
+
+//! What a request of SetHDR() leaves on the output: the GUI once the video goes (no picture: its
+//! buffer of 8 bits comes back with it), HDR where the request signals it, otherwise an SDR
+//! picture of its own depth (deep: more than 8 bits per component, in the picture or the buffer)
+constexpr LinkContent LinkContentOfPicture(bool picture, bool hdrSent, bool deep)
+{
+  if (!picture)
+    return LinkContent::SDR;
+  if (hdrSent)
+    return LinkContent::HDR;
+  return deep ? LinkContent::SDR_DEEP : LinkContent::SDR;
+}
+
+//! What the change of mode for a video that opens will carry (VideoPlayer told of it):
+//! nativeDV the stream goes out natively; hdr it is HDR and the output sends HDR signalling for
+//! it; deep the stream has more than 8 bits per component
+constexpr LinkContent LinkContentOfVideo(bool nativeDV, bool hdr, bool deep)
+{
+  if (nativeDV)
+    return LinkContent::DV;
+  if (hdr)
+    return LinkContent::HDR;
+  return deep ? LinkContent::SDR_DEEP : LinkContent::SDR;
+}
+
+//! A request of SetHDR() sets the head again anyway: it turns the HDR signalling on or off, or a
+//! change of mode goes in it (the mode selected is not the one on the output)
+constexpr bool HDRRequestSetsHead(bool signalledBefore, bool signalledAfter, bool modePending)
+{
+  return signalledBefore != signalledAfter || modePending;
+}
+
+} // namespace KODI::WINDOWING::GBM
