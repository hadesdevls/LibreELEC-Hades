From bd769eac70c9b4d85de80addc421d159d69d4bc2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:12:11 +0000
Subject: [PATCH] LICENSES/README.md: what the build without ENABLE_DVBRIDGE
 leaves out, made true

LICENSES/README.md said that a build without ENABLE_DVBRIDGE leaves the
GPL-3.0-or-later helpers out. Two files that are compiled whatever the
option says included one of their headers, DVViewGeometry.h, outside
HAVE_DVBRIDGE: WinSystemGbmGLESContext.cpp and RendererVAAPIGLES.cpp
(each use of it was inside HAVE_DVBRIDGE already). With the option off,
those two lines did not even find the header's own include,
dvbridge_core.h. Both includes now go under HAVE_DVBRIDGE. The build of
LibreELEC Hades has the option on, which defines HAVE_DVBRIDGE=1 for
every file, so its files are as before: each is the old one once the
two guard lines are taken out, and both pass the syntax check with the
commands of the last build.

The text now says that this is the only build LibreELEC Hades makes,
which files are GPL-3.0-or-later, that with the option off none of them
is compiled or included by a file that is (every other include of their
headers is under HAVE_DVBRIDGE or in a file compiled only with the
option), and that a build with the option off is not tested.
---
 LICENSES/README.md                                   | 12 ++++++++----
 .../VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp |  2 ++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp       |  2 ++
 3 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/LICENSES/README.md b/LICENSES/README.md
index d453dbe..6082e6a 100644
--- a/LICENSES/README.md
+++ b/LICENSES/README.md
@@ -3,10 +3,14 @@
 # Kodi's licensing rules
 Kodi is provided under the terms of the GNU General Public License v2.0 or later, as provided in **[LICENSES/GPL-2.0-or-later](GPL-2.0-or-later)**.
 
-The experimental `ENABLE_DVBRIDGE` build includes GPL-3.0-or-later DVBridge
-helpers. That combined build is distributed under GPL-3.0-or-later; see
-**[LICENSES/GPL-3.0-or-later](GPL-3.0-or-later)**. Existing files retain their
-original notices. Disabling the adapter excludes its helpers from the build.
+The `ENABLE_DVBRIDGE` build, the only one that LibreELEC Hades makes, includes
+GPL-3.0-or-later DVBridge helpers: `tools/dvbridge` and the files of `xbmc`
+whose SPDX line says GPL-3.0-or-later. That combined build is distributed under
+GPL-3.0-or-later; see **[LICENSES/GPL-3.0-or-later](GPL-3.0-or-later)**.
+Existing files retain their original notices. With the option off, those files
+are not compiled, and no file that is compiled includes their headers: they are
+included under `HAVE_DVBRIDGE`, or by files that are compiled only with the
+option. A build with the option off is not tested.
 
 This file provides a description of how each source file should be annotated to make its license clear and unambiguous. **It doesn't replace Kodi's license**.
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 88e0b3f..5974324 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -8,7 +8,9 @@
 
 #include "RendererVAAPIGLES.h"
 
+#ifdef HAVE_DVBRIDGE
 #include "DVViewGeometry.h"
+#endif
 
 #include "../RenderFactory.h"
 #include "cores/VideoPlayer/DVDCodecs/DVDCodecUtils.h"
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1df73ed..18a2728 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -25,7 +25,9 @@
 #include "cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h"
 #include "cores/VideoPlayer/Process/gbm/ProcessInfoGBM.h"
 #include "cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIME.h"
+#ifdef HAVE_DVBRIDGE
 #include "cores/VideoPlayer/VideoRenderers/HwDecRender/DVViewGeometry.h"
+#endif
 #include "cores/VideoPlayer/VideoRenderers/HwDecRender/RendererDRMPRIMEGLES.h"
 #include "cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h"
 #include "cores/VideoPlayer/VideoRenderers/RenderFactory.h"
