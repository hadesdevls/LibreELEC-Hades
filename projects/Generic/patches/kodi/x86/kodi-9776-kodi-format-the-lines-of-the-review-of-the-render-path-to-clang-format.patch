From eba72f6c98443752d3b706d9f263ea1cd6c3ae6a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:42:42 +0000
Subject: [PATCH] kodi: format the lines of the review of the render path to
 .clang-format

git clang-format-21 over the lines in xbmc/ that the commits of this review before it
changed: two conditions of dvbridge_hdr10_mapping_same() wrapped as the style wants
them. Nothing else changes.
---
 xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp | 3 +--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp         | 4 ++--
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index d99525d..e57d9f0 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -2543,8 +2543,7 @@ void CDVBridgeGLES::SetConversionMapping(const dvbridge_hdr10_mapping& mapping)
 {
   // (Hades: every value of the mapping: the trims of "leave out the trims" were left out of this
   // comparison, and a change of that setting alone kept the pictures on the old pass)
-  const bool same =
-      m_convertMappingSet && dvbridge_hdr10_mapping_same(&mapping, &m_convertMapping);
+  const bool same = m_convertMappingSet && dvbridge_hdr10_mapping_same(&mapping, &m_convertMapping);
   if (same || !m_renderer)
     return;
   m_convertMappingSet = true;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index be6894f..55cb753 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4714,8 +4714,8 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
       mapping = dvbridge_hdr10_mapping{};
     }
   }
-  if (mapping.enabled && (!m_dvLowLatencyMappingSet ||
-                          !dvbridge_hdr10_mapping_same(&mapping, &m_dvLowLatencyMapping)))
+  if (mapping.enabled &&
+      (!m_dvLowLatencyMappingSet || !dvbridge_hdr10_mapping_same(&mapping, &m_dvLowLatencyMapping)))
     CLog::Log(LOGINFO,
               "DVBridge: Dolby Vision Low-Latency is mapped to the display by LibreELEC Hades (not by "
               "Dolby's display management): to {:.0f} cd/m2 and the primaries {:.4f},{:.4f} "
-- 
2.53.0

