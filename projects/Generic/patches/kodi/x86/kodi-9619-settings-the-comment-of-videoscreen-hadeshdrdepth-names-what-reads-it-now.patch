From 96a965c985174bcf52a05015ed3d01eac14676d4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:50:54 +0000
Subject: [PATCH] settings: the comment of videoscreen.hadeshdrdepth names what
 reads it now

HDRDepthFor() went with HDRDepth.h, which LinkDepth.h replaced; the setting is read by
LinkDepthWanted() (windowing/gbm/LinkDepth.h). The comment only.
---
 xbmc/settings/Settings.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 3c04849..d62acdb 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -405,7 +405,8 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESGUIWHITE = "videoscreen.hadesguiwhite";
   //! Video of more than 8 bits through a half-float output where there is no 10-bit one (NVIDIA)
   static constexpr auto SETTING_VIDEOSCREEN_HADESFLOATOUTPUT = "videoscreen.hadesfloatoutput";
-  //! Hades: the depth of the link for HDR10 and HLG: 0 automatic, 8 at most 8 bits (HDRDepthFor())
+  //! Hades: the depth of the link for HDR10 and HLG: 0 automatic, 8 at most 8 bits
+  //! (LinkDepthWanted(), windowing/gbm/LinkDepth.h)
   static constexpr auto SETTING_VIDEOSCREEN_HADESHDRDEPTH = "videoscreen.hadeshdrdepth";
   //! Hades: HDR where RGB would be 8 bits: 0 in YCbCr 4:2:0 at 10 bits (the default), 1 in RGB
   //! at 8 bits (the connector property DVBRIDGE_HDR_YCBCR420 of i915 and amdgpu)
