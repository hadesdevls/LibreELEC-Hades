From a6c5eff19d4da4da7452f6019e953860d918664d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:29:26 +0000
Subject: [PATCH] tools/dvbridge, settings: measured Dolby Vision without
 dovi_tool's average floor, as an expert switch

HDR10 sent as Dolby Vision with metadata measured from the picture clamps
level 1 as dovi_tool clamps a CM v2.9 block, the average to at least 819.
Dolby's own analysis writes averages of 0 to 812 (the XML of Cosmos
Laundromat), and why dovi_tool has that floor is not known. Without it the
average sent came nearer to the studio's in Cosmos Laundromat (296.5 to
169.0 codes from it on average, picture by picture) and in the shots of Sol
Levante (182.6 to 173.8), but not picture by picture in Sol Levante (210.8
to 218.8): two titles do not settle it, a display with a dark scene will.

dvbridge_measured_params::avg_floor holds the floor (819 by default, the
behaviour as before, bit for bit); <video><dvmeasurednoavgfloor>true
</dvmeasurednoavgfloor></video> in advancedsettings.xml sets it to 0, and
kodi.log says so. The top of the minimum (12) and the floor of the maximum
(2081) stay: the maximum's changes nothing in either title, and the
minimum's is mixed.
---
 tools/dvbridge/dvbridge_measured.c             | 12 +++++++-----
 tools/dvbridge/dvbridge_measured.h             | 12 +++++++++++-
 xbmc/settings/AdvancedSettings.cpp             |  2 ++
 xbmc/settings/AdvancedSettings.h               |  4 ++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 18 +++++++++++++++++-
 5 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_measured.c b/tools/dvbridge/dvbridge_measured.c
index f495f52..adcf32b 100644
--- a/tools/dvbridge/dvbridge_measured.c
+++ b/tools/dvbridge/dvbridge_measured.c
@@ -21,6 +21,7 @@
 
 const struct dvbridge_measured_params dvbridge_measured_default_params = {
     .cut = 0.05f, .motion = 2.5f, .step = 0.7f, .avg_step = 24, .max_step = 16, .min_step = 4, .avg_window = 192,
+    .avg_floor = DVBRIDGE_MEASURED_AVG_FLOOR,
 };
 
 struct scene {
@@ -230,14 +231,15 @@ static unsigned code(double v)
     return c < 0 ? 0 : c > 4095 ? 4095 : (unsigned)c;
 }
 
-/* level 1 of a scene, clamped as dovi_tool clamps a level 1 block for CM v2.9 (as dvbridge_hdr10plus.c) */
-static void codes(const struct scene *s, unsigned out[3])
+/* level 1 of a scene, clamped as dovi_tool clamps a level 1 block for CM v2.9 (as dvbridge_hdr10plus.c);
+ * Hades: the average to avg_floor (dovi_tool's 819 by default, dvbridge_measured_params) */
+static void codes(const struct scene *s, unsigned avg_floor, unsigned out[3])
 {
     const double mean = s->recent_n ? s->recent_sum / s->recent_n : s->n ? s->sum / s->n : 0;
     unsigned mn = code(s->min), mx = code(s->max), avg = code(mean);
     mn = mn > 12 ? 12 : mn;
     mx = mx < 2081 ? 2081 : mx;
-    avg = avg < 819 ? 819 : avg;
+    avg = avg < avg_floor ? avg_floor : avg;
     if (avg > mx - 1)
         avg = mx - 1;
     out[0] = mn;
@@ -326,7 +328,7 @@ static bool step(struct dvbridge_measured *m, unsigned i)
     }
     if (known.n) {
         unsigned c[3];
-        codes(&known, c);
+        codes(&known, m->p.avg_floor, c);
         if (cut || !m->sent.measured) {
             m->sent.min_pq = c[0];
             m->sent.max_pq = c[1];
@@ -399,7 +401,7 @@ struct AVDOVIMetadata *dvbridge_measured_placeholder(const struct AVMasteringDis
     const double peak = light && light->MaxCLL ? light->MaxCLL : av_q2d(mastering->max_luminance);
     struct scene s = {.max = pq(peak), .min = 0, .sum = light && light->MaxFALL ? pq(light->MaxFALL) : 0, .n = 1};
     unsigned c[3];
-    codes(&s, c);
+    codes(&s, DVBRIDGE_MEASURED_AVG_FLOOR, c); /* (static metadata, before anything is measured) */
     return dvbridge_profile81_metadata(c[0], c[1], c[2], NULL, mastering, light, false, size);
 }
 
diff --git a/tools/dvbridge/dvbridge_measured.h b/tools/dvbridge/dvbridge_measured.h
index a9eb952..58f44d9 100644
--- a/tools/dvbridge/dvbridge_measured.h
+++ b/tools/dvbridge/dvbridge_measured.h
@@ -67,13 +67,23 @@ struct dvbridge_measured_params {
     float cut, motion, step;
     unsigned avg_step, max_step, min_step; /* within a scene, the level 1 sent changes by more than these (codes) */
     unsigned avg_window; /* pictures, at most DVBRIDGE_MEASURED_AVG_WINDOW_MAX; 0: the whole scene */
+    /* Hades: the level 1 average sent is at least this (codes of 4095): dovi_tool's floor of content
+     * mapping v2.9, DVBRIDGE_MEASURED_AVG_FLOOR, by default; 0, none (an expert switch,
+     * video/dvmeasurednoavgfloor). The tops of the minimum (12) and the floor of the maximum (2081) stay. Why
+     * dovi_tool has that floor is not known: Dolby's own analysis writes averages of 0 to 812 (the XML of
+     * Cosmos Laundromat), and without it the average sent came nearer to that of the studio in Cosmos
+     * (296.5 to 169.0 codes from it on average, picture by picture) and in the shots of Sol Levante (182.6 to
+     * 173.8), but not picture by picture in Sol Levante (210.8 to 218.8). */
+    unsigned avg_floor;
 };
+#define DVBRIDGE_MEASURED_AVG_FLOOR 819
 
 /* What a picture is sent with */
 struct dvbridge_measured_l1 {
     bool measured; /* from measurements (else nothing was measured yet: none) */
     bool refresh;  /* the picture is the first of a scene */
-    unsigned min_pq, max_pq, avg_pq;  /* level 1, as a level 1 block carries it, clamped as dovi_tool clamps one */
+    unsigned min_pq, max_pq, avg_pq;  /* level 1, as a level 1 block carries it, clamped as dovi_tool clamps one
+                                       * (Hades: the floor of the average, params.avg_floor) */
     unsigned area[4]; /* level 5: the offsets left, right, top, bottom, in pixels of the picture */
 };
 
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index 3fb6dde..79433a9 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -218,6 +218,7 @@ void CAdvancedSettings::Initialize()
   m_videoDVStartSignal = true;
   m_videoDVMmrTable = false;
   m_videoDVCm40Default = false;
+  m_videoDVMeasuredNoAvgFloor = false;
   m_videoDVWarmup = true;
   m_videoSmoothPercentToTimeSeeking = true;
   m_videoTimeSeekForward = 30;
@@ -730,6 +731,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
     XMLUtils::GetBoolean(pElement, "dvstartsignal", m_videoDVStartSignal);
     XMLUtils::GetBoolean(pElement, "dvmmrtable", m_videoDVMmrTable);
     XMLUtils::GetBoolean(pElement, "dvcm40default", m_videoDVCm40Default);
+    XMLUtils::GetBoolean(pElement, "dvmeasurednoavgfloor", m_videoDVMeasuredNoAvgFloor);
     XMLUtils::GetBoolean(pElement, "dvwarmup", m_videoDVWarmup);
     XMLUtils::GetBoolean(pElement, "smoothpercenttotimeseeking", m_videoSmoothPercentToTimeSeeking);
     XMLUtils::GetInt(pElement, "timeseekforward", m_videoTimeSeekForward, 0, 6000);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index b2231fe..a7b69ba 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -226,6 +226,10 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! video/dvcm40default; dvbridge_render_add_cm40_default()): a test of what a display of display
     //! management 4 does with it. Off, the default
     bool m_videoDVCm40Default;
+    //! Hades: HDR10 sent as Dolby Vision with metadata measured from the picture: the level 1 average is
+    //! sent as measured, without dovi_tool's floor of content mapping v2.9 (819 codes;
+    //! video/dvmeasurednoavgfloor; dvbridge_measured_params::avg_floor). Off, the default (with the floor)
+    bool m_videoDVMeasuredNoAvgFloor;
     //! Hades: the GPU programs of the ways a native Dolby Vision session can draw its frames are
     //! made ready before its first frame (video/dvwarmup; dvbridge_render_warm()). Off to have each
     //! made when a frame first needs it, as before
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index fd1454e..4d376fd 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3170,7 +3170,23 @@ bool CWinSystemGbmGLESContext::DVMeasureReady()
     dvbridge_measured_reset(m_dvMeasured.get(), false);
   }
   if (!m_dvMeasured)
-    m_dvMeasured.reset(dvbridge_measured_create(nullptr));
+  {
+    // Hades: the level 1 average sent as measured, without dovi_tool's floor of content mapping v2.9
+    // (819 codes), where advancedsettings.xml asks for it (<video><dvmeasurednoavgfloor>true
+    // </dvmeasurednoavgfloor></video>): an expert switch, off by default, to judge on a display with
+    // dark scenes (Dolby's own analysis writes averages under that floor)
+    dvbridge_measured_params params = dvbridge_measured_default_params;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    const bool noFloor = advanced && advanced->m_videoDVMeasuredNoAvgFloor;
+    if (noFloor)
+      params.avg_floor = 0;
+    m_dvMeasured.reset(dvbridge_measured_create(&params));
+    if (noFloor && m_dvMeasured)
+      CLog::Log(LOGINFO, "DVBridge: HDR10 sent as Dolby Vision measured from the picture: the level 1 "
+                         "average goes out as measured, without dovi_tool's floor of 819, as "
+                         "advancedsettings.xml asks (dvmeasurednoavgfloor)");
+  }
   if (!m_dvMeasure && !m_dvMeasureFailed)
   {
     m_dvMeasure.reset(dvbridge_measure_create());
-- 
2.53.0

