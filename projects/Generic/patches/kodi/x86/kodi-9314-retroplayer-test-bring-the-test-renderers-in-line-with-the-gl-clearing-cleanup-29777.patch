From a1b13a68213efad22057c590c050a2d134030dee Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Sun, 11 Oct 2026 00:12:33 +0100
Subject: [PATCH] [RetroPlayer][test] Bring the test renderers in line with the
 GL clearing cleanup (#29777)

3a7a163da5 took the clear parameter off RenderInternal() and removed the
black bars vertex array from the FBO renderer, and two test renderers
still used both, so kodi-test no longer compiled:

- TestRPRenderManager's renderer overrode RenderInternal(bool, uint8_t).
- The macOS FBO renderer test overrode the same signature, and its
  vertex array lifetime test listed m_blackbarsVAO. It now expects the
  one array the renderer owns, and the two buffers bound to it.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../rendering/test/TestHwRenderingContextOSX.mm       | 11 +++++------
 .../rendering/test/TestRPRenderManager.cpp            |  2 +-
 2 files changed, 6 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
index d5d97ca..9450732 100644
--- a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
+++ b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
@@ -1107,7 +1107,7 @@ class CTestFBORenderer : public CRPRendererFBO
 public:
   using CRPRendererFBO::CRPRendererFBO;
 
-  std::vector<GLuint> VertexArrays() const { return {m_mainVAO, m_blackbarsVAO}; }
+  std::vector<GLuint> VertexArrays() const { return {m_mainVAO}; }
 
   CDirectionalTestPreset* UseDirectionalPreset(bool sRGBPass = false)
   {
@@ -1137,11 +1137,11 @@ public:
   }
 
 protected:
-  void RenderInternal(bool clear, uint8_t alpha) override
+  void RenderInternal(uint8_t alpha) override
   {
     m_sourceRect = m_crop;
     m_shaderPreset->SetVideoSize(m_renderBuffer->GetWidth(), m_renderBuffer->GetHeight());
-    CRPRendererFBO::RenderInternal(clear, alpha);
+    CRPRendererFBO::RenderInternal(alpha);
   }
 
 private:
@@ -1472,8 +1472,7 @@ TEST_F(TestRPRendererFBOOSX, RendererOwnsInitializedVertexArraysUntilDestruction
     {
       CTestFBORenderer renderer({}, context, m_pool);
       arrays = renderer.VertexArrays();
-      ASSERT_EQ(arrays.size(), 2u);
-      EXPECT_NE(arrays[0], arrays[1]);
+      ASSERT_EQ(arrays.size(), 1u);
       GLint binding = 0;
       for (size_t i = 0; i < arrays.size(); ++i)
       {
@@ -1509,7 +1508,7 @@ TEST_F(TestRPRendererFBOOSX, RendererOwnsInitializedVertexArraysUntilDestruction
       glBindVertexArray(guiVertexArray);
       std::sort(buffers.begin(), buffers.end());
       buffers.erase(std::unique(buffers.begin(), buffers.end()), buffers.end());
-      EXPECT_EQ(buffers.size(), 3u);
+      EXPECT_EQ(buffers.size(), 2u);
     }
     for (const auto array : arrays)
       EXPECT_FALSE(glIsVertexArray(array));
diff --git a/xbmc/cores/RetroPlayer/rendering/test/TestRPRenderManager.cpp b/xbmc/cores/RetroPlayer/rendering/test/TestRPRenderManager.cpp
index a71bb74..0ab64c3 100644
--- a/xbmc/cores/RetroPlayer/rendering/test/TestRPRenderManager.cpp
+++ b/xbmc/cores/RetroPlayer/rendering/test/TestRPRenderManager.cpp
@@ -170,7 +170,7 @@ protected:
     return true;
   }
 
-  void RenderInternal(bool, uint8_t) override {}
+  void RenderInternal(uint8_t) override {}
   void FlushInternal() override
   {
     const auto& callback = static_cast<CTestPool*>(GetBufferPool())->onRendererFlush;
-- 
2.53.0

