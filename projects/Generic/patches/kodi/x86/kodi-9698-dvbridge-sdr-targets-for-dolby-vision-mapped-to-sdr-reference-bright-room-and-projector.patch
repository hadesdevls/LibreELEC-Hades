+            <option label="41133">1</option> <!-- bright room: 300 cd/m2, gamma 2.2 -->
+            <option label="41134">2</option> <!-- projector: 100 cd/m2, gamma 2.4 -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
