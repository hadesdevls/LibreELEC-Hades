diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index b97f9a4..58b3e44 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -159,6 +159,9 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     if (!(m->black >= 0.0f && m->black <= DVBRIDGE_HDR10_BLACK_MAX) ||
         (m->black > 0.0f && m->target != DVBRIDGE_HDR10_TARGET_HDR10))
         return false;
+    /* Hades: the 2.2 EOTF is of an SDR target only */
+    if (m->gamma22 && m->target != DVBRIDGE_HDR10_TARGET_SDR)
+        return false;
     /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
     if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 &&
         (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamut != DVBRIDGE_HDR10_GAMUT_BT709))
@@ -177,6 +180,11 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
 }
 
 struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy)
+{
+    return dvbridge_sdr_mapping_for(DVBRIDGE_SDR_TARGET_REFERENCE, source_xy);
+}
+
+struct dvbridge_hdr10_mapping dvbridge_sdr_mapping_for(int sdr_target, const float *source_xy)
 {
     struct dvbridge_hdr10_mapping m = {
         .enabled = true,
@@ -185,6 +193,12 @@ struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy)
         .curve = DVBRIDGE_HDR10_CURVE_BT2390,
         .target = DVBRIDGE_HDR10_TARGET_SDR,
     };
+    if (sdr_target == DVBRIDGE_SDR_TARGET_BRIGHT_ROOM) {
+        m.peak = DVBRIDGE_SDR_WHITE_BRIGHT_ROOM;
+        m.gamma22 = true;
+    } else if (sdr_target == DVBRIDGE_SDR_TARGET_PROJECTOR) {
+        m.peak = DVBRIDGE_SDR_WHITE_PROJECTOR;
+    }
     if (source_xy) {
         m.source_known = true;
         for (int i = 0; i < 8; ++i)
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index d1e0133..bf95fb7 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -74,6 +74,19 @@ enum dvbridge_hdr10_target {
  * white of ITU-R BT.2408, which an SDR picture's white stands for in its conversions (libplacebo's
  * PL_COLOR_SDR_WHITE). A scene that is no brighter goes out as mastered. */
 #define DVBRIDGE_SDR_WHITE 203.0f
+/* Hades: the display that an SDR output is made for (videoscreen.hadesdvsdrtarget), as the white that it
+ * shows in cd/m2 and the gamma of its EOTF. REFERENCE is the output as it always was (DVBRIDGE_SDR_WHITE,
+ * the pure 2.4 power of BT.1886 with no black). BRIGHT_ROOM is a display that shows white at 300 cd/m2 with
+ * gamma 2.2: the picture keeps the luminance that it was made for on a brighter display, so its codes are
+ * lower. PROJECTOR is one that shows white at 100 cd/m2: the codes are higher and the highlights above its
+ * white are compressed (the BT.2390 curve maps the scene to that peak). */
+enum dvbridge_sdr_target {
+    DVBRIDGE_SDR_TARGET_REFERENCE = 0,
+    DVBRIDGE_SDR_TARGET_BRIGHT_ROOM = 1,
+    DVBRIDGE_SDR_TARGET_PROJECTOR = 2,
+};
+#define DVBRIDGE_SDR_WHITE_BRIGHT_ROOM 300.0f
+#define DVBRIDGE_SDR_WHITE_PROJECTOR 100.0f
 struct dvbridge_hdr10_mapping {
     bool enabled;
     float peak;                      /* of the display, cd/m2 (for SDR, its white) */
@@ -95,6 +108,9 @@ struct dvbridge_hdr10_mapping {
      * source kept, as before, bit for bit. At most DVBRIDGE_HDR10_BLACK_MAX. A mapping of a picture for output
      * as HDR10 (dvbridge_render_hdr10_mapping()) does not apply it. */
     float black;
+    /* Hades: an SDR target with the pure 2.2 power as its EOTF, not BT.1886's 2.4 (dvbridge_sdr_mapping_for()).
+     * Of an SDR target only. false where nothing sets it: as before, bit for bit. */
+    bool gamma22;
 };
 #define DVBRIDGE_HDR10_BLACK_MAX 1.0f
 /* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
@@ -104,6 +120,8 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m);
 /* Hades: the mapping of a picture to an SDR output: on, to DVBRIDGE_SDR_WHITE, in BT.709, with the
  * BT.2390 curve. source_xy as for any mapping (NULL: not known). */
 struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy);
+/* ... for the display that dvbridge_sdr_target says (an unknown value is REFERENCE) */
+struct dvbridge_hdr10_mapping dvbridge_sdr_mapping_for(int sdr_target, const float *source_xy);
 /* The primaries and white (CIE 1931 xy: red, green, blue, white) of a display gamut (Hades: not
  * of DVBRIDGE_HDR10_GAMUT_CUSTOM, which has none of its own: false). */
 /* Hades: the gamut that a mapping of DVBRIDGE_HDR10_GAMUT_CUSTOM maps to: its target_xy, with a primary that
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 5e9dd2b..4861c32 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1846,7 +1846,7 @@ static void map_to_display(struct dvbridge_renderer *r, const struct dvbridge_hd
     const bool sdr = m->target == DVBRIDGE_HDR10_TARGET_SDR;
     *target = (struct pl_color_space){
         .primaries = sdr ? PL_COLOR_PRIM_BT_709 : PL_COLOR_PRIM_BT_2020,
-        .transfer = sdr ? PL_COLOR_TRC_BT_1886 : PL_COLOR_TRC_PQ,
+        .transfer = sdr ? (m->gamma22 ? PL_COLOR_TRC_GAMMA22 : PL_COLOR_TRC_BT_1886) : PL_COLOR_TRC_PQ,
         .hdr = {.min_luma = PL_COLOR_HDR_BLACK, .max_luma = m->peak,
                 .prim = {.red = {xy[0], xy[1]}, .green = {xy[2], xy[3]}, .blue = {xy[4], xy[5]},
                          .white = {xy[6], xy[7]}}},
