From 78f6c1d589b49c6d95cee3bad0727e6c01b63bfa Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sat, 3 Oct 2026 09:12:08 +0100
Subject: [PATCH] [GL] Give rotated controls their perspective back

The GUI shaders were changed to read only x and y of each vertex, so the
depth a rotatex or rotatey animation gives a control never reaches the
projection. On OpenGL a turned control is squeezed flat instead of being
drawn in perspective, while GLES, whose shaders still read the depth,
draws it as intended. GUITextureGL already passes three components, so
read all three again.
---
 system/shaders/GL/1.2/gl_shader_vert.glsl         | 4 ++--
 system/shaders/GL/1.2/gl_shader_vert_clip.glsl    | 8 ++++----
 system/shaders/GL/1.2/gl_shader_vert_default.glsl | 4 ++--
 system/shaders/GL/1.2/gl_shader_vert_simple.glsl  | 4 ++--
 system/shaders/GL/1.5/gl_shader_vert.glsl         | 4 ++--
 system/shaders/GL/1.5/gl_shader_vert_clip.glsl    | 8 ++++----
 system/shaders/GL/1.5/gl_shader_vert_default.glsl | 4 ++--
 system/shaders/GL/1.5/gl_shader_vert_simple.glsl  | 4 ++--
 8 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/system/shaders/GL/1.2/gl_shader_vert.glsl b/system/shaders/GL/1.2/gl_shader_vert.glsl
index 4bb40f2..eef00e3 100644
--- a/system/shaders/GL/1.2/gl_shader_vert.glsl
+++ b/system/shaders/GL/1.2/gl_shader_vert.glsl
@@ -8,7 +8,7 @@
 
 #version 120
 
-attribute vec2 m_attrpos;
+attribute vec3 m_attrpos;
 attribute vec4 m_attrcol;
 attribute vec2 m_attrcord0;
 attribute vec2 m_attrcord1;
@@ -22,7 +22,7 @@ uniform float m_depth;
 void main()
 {
   mat4 mvp = m_proj * m_model;
-  gl_Position = mvp * vec4(m_attrpos, 0., 1.);
+  gl_Position = mvp * vec4(m_attrpos, 1.);
   gl_Position.z = m_depth * gl_Position.w;
   m_colour = m_attrcol;
   m_cord0 = m_attrcord0;
diff --git a/system/shaders/GL/1.2/gl_shader_vert_clip.glsl b/system/shaders/GL/1.2/gl_shader_vert_clip.glsl
index 87b14f3..2fab779 100644
--- a/system/shaders/GL/1.2/gl_shader_vert_clip.glsl
+++ b/system/shaders/GL/1.2/gl_shader_vert_clip.glsl
@@ -8,7 +8,7 @@
 
 #version 120
 
-attribute vec2 m_attrpos;
+attribute vec3 m_attrpos;
 attribute vec4 m_attrcol;
 attribute vec2 m_attrcord0;
 attribute vec2 m_attrcord1;
@@ -27,15 +27,15 @@ uniform float m_depth;
 void main()
 {
   // limit the vertices to the clipping area
-  vec4 position = vec4(0., 0., 0., 1.);
-  position.xy = clamp(m_attrpos, m_shaderClip.xy, m_shaderClip.zw);
+  vec4 position = vec4(m_attrpos, 1.);
+  position.xy = clamp(m_attrpos.xy, m_shaderClip.xy, m_shaderClip.zw);
   gl_Position = m_matrix * position;
 
   // set rendering depth
   gl_Position.z = m_depth * gl_Position.w;
 
   // correct texture coordinates for clipped vertices
-  vec2 clipDist = m_attrpos - position.xy;
+  vec2 clipDist = m_attrpos.xy - position.xy;
   m_cord0 = m_attrcord0 - clipDist * m_cordStep.xy;
   m_cord1 = m_attrcord1 - clipDist * m_cordStep.zw;
 
diff --git a/system/shaders/GL/1.2/gl_shader_vert_default.glsl b/system/shaders/GL/1.2/gl_shader_vert_default.glsl
index e08682b..e22c4c2 100644
--- a/system/shaders/GL/1.2/gl_shader_vert_default.glsl
+++ b/system/shaders/GL/1.2/gl_shader_vert_default.glsl
@@ -8,13 +8,13 @@
 
 #version 120
 
-attribute vec2 m_attrpos;
+attribute vec3 m_attrpos;
 uniform mat4 m_proj;
 uniform mat4 m_model;
 
 void main()
 {
   mat4 mvp = m_proj * m_model;
-  gl_Position = mvp * vec4(m_attrpos, 0., 1.);
+  gl_Position = mvp * vec4(m_attrpos, 1.);
   gl_Position.z = -1. * gl_Position.w;
 }
