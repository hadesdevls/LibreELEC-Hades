From c7274a8bcc4653a1c1e2c5377a7d4d6df38af9c1 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 19 Oct 2026 01:00:39 +0100
Subject: [PATCH] [posix][smb] read errno before strerror() when reporting
 failures

strerror() is allowed to change errno, and does on macOS (EINVAL for
unknown values), while the open/seek/close error paths read errno again
afterwards, or pass errno and strerror(errno) as arguments of the same
call. The log then shows a different error than the one that occurred,
e.g. EINVAL instead of the 8216 that libsmbclient actually returned.

Save errno immediately after the failing libsmbclient call.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../platform/posix/filesystem/SMBDirectory.cpp | 18 +++++++++++-------
 xbmc/platform/posix/filesystem/SMBFile.cpp     |  6 ++++--
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/xbmc/platform/posix/filesystem/SMBDirectory.cpp b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
index 22dc2c8..709b938 100644
--- a/xbmc/platform/posix/filesystem/SMBDirectory.cpp
+++ b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
@@ -169,8 +169,9 @@ bool CSMBDirectory::GetDirectory(const CURL& url, CFileItemList& items)
   {
     if (smbc_lseekdir(fd, 0) < 0)
     {
+      const int seekErrno = errno;
       CLog::LogF(LOGERROR, "Unable to seek directory : '{}'\nunix_err:'{:x}' error: '{}'",
-                 CURL::GetRedacted(strAuth), errno, strerror(errno));
+                 CURL::GetRedacted(strAuth), seekErrno, strerror(seekErrno));
       return false;
     }
 
@@ -211,8 +212,9 @@ bool CSMBDirectory::GetDirectory(const CURL& url, CFileItemList& items)
 
   if (smbc_closedir(fd) < 0)
   {
+    const int closeErrno = errno;
     CLog::LogF(LOGERROR, "Unable to close directory : '{}'\nunix_err:'{:x}' error: '{}'",
-               CURL::GetRedacted(strAuth), errno, strerror(errno));
+               CURL::GetRedacted(strAuth), closeErrno, strerror(closeErrno));
     return true; // we already got our listing
   }
 
@@ -261,18 +263,20 @@ int CSMBDirectory::OpenDir(const CURL& url, std::string& strAuth)
 
   CLog::LogFC(LOGDEBUG, LOGSAMBA, "Using authentication url {}", CURL::GetRedacted(s));
 
+  int openErrno = 0;
   {
     std::unique_lock lock(smb);
     if (!smb.IsSmbValid())
       return -1;
     fd = smbc_opendir(s.c_str());
+    openErrno = errno;
   }
 
   while (fd < 0) /* only to avoid goto in following code */
   {
     std::string cError;
 
-    if (errno == EACCES || errno == EPERM || errno == EAGAIN || errno == EINVAL)
+    if (openErrno == EACCES || openErrno == EPERM || openErrno == EAGAIN || openErrno == EINVAL)
     {
       if (m_flags & DIR_FLAG_ALLOW_PROMPT)
       {
@@ -286,12 +290,12 @@ int CSMBDirectory::OpenDir(const CURL& url, std::string& strAuth)
       break;
     }
 
-    if (errno == ENODEV || errno == ENOENT)
+    if (openErrno == ENODEV || openErrno == ENOENT)
       cError = fmt::format(
           fmt::runtime(CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(770)),
-          errno);
+          openErrno);
     else
-      cError = strerror(errno);
+      cError = strerror(openErrno);
 
     if (m_flags & DIR_FLAG_ALLOW_PROMPT)
       SetErrorDialog(257, cError.c_str());
@@ -302,7 +306,7 @@ int CSMBDirectory::OpenDir(const CURL& url, std::string& strAuth)
   {
     // write error to logfile
     CLog::LogF(LOGERROR, "Unable to open directory : '{}'\nunix_err:'{:x}' error : '{}'",
-               CURL::GetRedacted(strAuth), errno, strerror(errno));
+               CURL::GetRedacted(strAuth), openErrno, strerror(openErrno));
   }
 
   return fd;
diff --git a/xbmc/platform/posix/filesystem/SMBFile.cpp b/xbmc/platform/posix/filesystem/SMBFile.cpp
index 840436f..79d98e1 100644
--- a/xbmc/platform/posix/filesystem/SMBFile.cpp
+++ b/xbmc/platform/posix/filesystem/SMBFile.cpp
@@ -821,13 +821,14 @@ bool CSMBFile::Open(const CURL& url)
 
   std::string strFileName;
   m_fd = OpenFile(url, strFileName);
+  const int openErrno = errno;
 
   CLog::Log(LOGDEBUG, "CSMBFile::Open - opened {}, fd={}", url.GetRedacted(), m_fd);
   if (m_fd == -1)
   {
     // write error to logfile
     CLog::Log(LOGERROR, "SMBFile->Open: Unable to open file : '{}'\nunix_err:'{:x}' error : '{}'",
-              CURL::GetRedacted(strFileName), errno, strerror(errno));
+              CURL::GetRedacted(strFileName), openErrno, strerror(openErrno));
     return false;
   }
 
@@ -1540,9 +1541,10 @@ bool CSMBFile::OpenForWrite(const CURL& url, bool bOverWrite)
 
   if (m_fd == -1)
   {
+    const int openErrno = errno;
     // write error to logfile
     CLog::Log(LOGERROR, "SMBFile->Open: Unable to open file : '{}'\nunix_err:'{:x}' error : '{}'",
-              CURL::GetRedacted(strFileName), errno, strerror(errno));
+              CURL::GetRedacted(strFileName), openErrno, strerror(openErrno));
     return false;
   }
 
