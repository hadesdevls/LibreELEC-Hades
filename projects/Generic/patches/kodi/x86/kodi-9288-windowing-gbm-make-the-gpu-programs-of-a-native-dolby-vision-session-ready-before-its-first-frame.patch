+  /*!
+   * \brief Hades: the GPU programs of the ways the frames of this stream can be drawn, made ready
+   *        with its first frame before that is prepared (dvbridge_render_warm()), so that the frame
+   *        that first needs one (GUI elements or subtitles over a picture drawn directly, another
+   *        fidelity step-down level, the enhancement layer resynchronizing after a seek) is not
+   *        late for it on a GPU with little time to spare. Nothing that is presented changes.
+   * \param levels the step-down levels that the frames can be drawn at (bit n: level n)
+   * \param allowPacked frames without GUI elements may be drawn directly
+   * \param budgetMs renders are made while less time than this has passed
+   */
+  void Warm(const Layer& base,
+            const AVFrame* enhancement,
+            const CDVMetadataBuffer& metadata,
+            dvbridge_geometry geometry,
+            unsigned int levels,
+            bool allowPacked,
+            double budgetMs);
+
   // Hades: a Dolby Vision picture reconstructed for output as HDR10. A bridge is set up for
   // this or for native output, not for both.
   bool InitializeConversion(bool allowSoftware = false);
@@ -197,6 +215,8 @@ private:
   //! m_gl; and what was made since, written for the next ones
   void UseShaderCache();
   static void SaveShaderCache();
+  //! Hades: the cache that UseShaderCache() gave m_gl (nullptr: none)
+  pl_cache m_shaderCache = nullptr;
   //! Hades: the enhancement surfaces imported so far, kept (see dvbridge_dmabuf.h); and how
   //! many imports reused one and made one, when that was last logged
   dvbridge_dmabuf_cache* m_layerCache = nullptr;
