@@ -1607,6 +1607,9 @@ bool CWinSystemGbmGLESContext::BeginDVBridge()
   DVEngineRead();
   // Hades: whether its frames reach the display is found for this native output
   m_dvPresentStall.Reset();
+  // Hades: the warm-up, for this native output (its first frame)
+  m_dvWarmed = false;
+  m_dvExtraWork = false;
   return true;
 }
 
@@ -1771,7 +1774,37 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   frame.clean = overlayFree;
   frame.allowPacked = overlayFree && direct;
   frame.step = m_dvStepLevel;
+  // Hades: an enhancement picture whose residual the metadata does not reconstruct (MEL, or NLQ
+  // that changes nothing) is not imported. libplacebo leaves such a layer out before it draws
+  // anything (pass_init()), so the frame is the same without it, to the bit.
+  const bool layerWithoutResidual = layered && foresaw && !residual;
   const auto prepareStart = std::chrono::steady_clock::now();
+  // Hades: what is not the preparation of the frame itself (the warm-up), left out of its time
+  double extraMs = 0;
+  // Hades: the GPU programs of the ways this native output can draw its frames, made ready with
+  // its first frame (video/dvwarmup): the levels that the frames can be drawn at are the one that
+  // is set (videoscreen.hadesdvstepmode, or advancedsettings.xml), else those that Kodi can step
+  // down to where the setting lets it; and the direct way only where the way of drawing is not
+  // set to always composed (videoscreen.hadesdvpathmode).
+  if (!m_dvWarmed)
+  {
+    m_dvWarmed = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    if (!advanced || advanced->m_videoDVWarmup)
+    {
+      unsigned int levels = 1u << m_dvStepLevel;
+      if (m_dvStepForced < 0 && m_dvStepAuto)
+        levels |= m_dvBridge->StepLevels(CDVFrameLoad::WithResidual(foreseen));
+      m_dvBridge->Warm(layer, layerWithoutResidual ? nullptr : enhancement, metadata, geometry,
+                       levels, m_dvEngine.path != CDVEngineSettings::Path::COMPOSED,
+                       DV_WARM_BUDGET_MS);
+      extraMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
