diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 28a6eaf..b8d8d13 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -9,6 +9,7 @@
 #include <GLES3/gl31.h>
 #include <math.h>
 #include <stdlib.h>
+#include <time.h>
 
 /* Hades: what dvbridge_render_take_notes() reports, once each in a stream */
 enum {
@@ -990,3 +991,162 @@ void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *r, bool use)
     if (r)
         r->legacy_composer = !use;
 }
+
+/* Hades: what dvbridge_render_warm() keeps of the renderer while it draws */
+struct kept_state {
+    struct dvbridge_candidate *pending;
+    bool ready, packed, early_mask, residual_omitted, residual_drawn, early_unusable[2];
+    unsigned char early_failures[2];
+    int step;
+    unsigned noted, fresh;
+    struct dvbridge_render_notes notes;
+};
+
+static void keep_state(struct dvbridge_renderer *r, struct kept_state *k)
+{
+    k->pending = r->pending;
+    r->pending = NULL;
+    k->ready = r->ready;
+    k->packed = r->packed;
+    k->early_mask = r->early_mask;
+    k->residual_omitted = r->residual_omitted;
+    k->residual_drawn = r->residual_drawn;
+    for (int i = 0; i < 2; ++i) {
+        k->early_unusable[i] = r->early_unusable[i];
+        k->early_failures[i] = r->early_failures[i];
+    }
+    k->step = r->step;
+    k->noted = r->noted;
+    k->fresh = r->fresh;
+    k->notes = r->notes;
+}
+
+static void give_back_state(struct dvbridge_renderer *r, const struct kept_state *k)
+{
+    dvbridge_candidate_destroy(r->pending);
+    r->pending = k->pending;
+    r->ready = k->ready;
+    r->packed = k->packed;
+    r->early_mask = k->early_mask;
+    r->residual_omitted = k->residual_omitted;
+    r->residual_drawn = k->residual_drawn;
+    for (int i = 0; i < 2; ++i) {
+        r->early_unusable[i] = k->early_unusable[i];
+        r->early_failures[i] = k->early_failures[i];
+    }
+    r->step = k->step;
+    r->noted = k->noted;
+    r->fresh = k->fresh;
+    r->notes = k->notes;
+    /* the picture was drawn into: what is outside the place of the next one is not known to be
+     * black (it is cleared then, which writes the same bytes) */
+    r->rgb_clean = false;
+    /* a render of these that failed leaves nothing turned off for the frames */
+    pl_renderer_reset_errors(r->renderer, NULL);
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+}
+
+static double now_ms(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+int dvbridge_render_warm(struct dvbridge_renderer *r, const struct pl_frame *source,
+                         const void *metadata, size_t bytes, double pts, double el_pts,
+                         struct dvbridge_geometry geometry, unsigned levels, pl_tex scanout,
+                         struct dvbridge_gl_packer *packer, unsigned framebuffer, double budget_ms,
+                         struct dvbridge_warm_report *report)
+{
+    struct dvbridge_warm_report done = {0};
+    if (!r || !r->rgb || !source || !metadata) {
+        if (report)
+            *report = done;
+        return 0;
+    }
+    const double start = now_ms();
+    struct kept_state kept;
+    keep_state(r, &kept);
+    /* The frame as it comes, and, when it has the residual of an enhancement layer, without it:
+     * as it is drawn while the decoder resynchronizes the layer after a seek */
+    struct pl_frame bare = *source;
+    bare.enhancement_layer = NULL;
+    const bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
+    struct dvbridge_color mapped;
+    bool omitted = false;
+    const bool residual = paired && dvbridge_map_color(&mapped, metadata, bytes, true, &omitted) &&
+                          mapped.dovi.nlq_active;
+    /* the level that the frames are drawn at first, then the others that they can be drawn at,
+     * the nearest first */
+    levels = (levels | 1u << kept.step) & ((1u << DVBRIDGE_STEP_LEVELS) - 1);
+    int order[DVBRIDGE_STEP_LEVELS], n = 0;
+    order[n++] = kept.step;
+    for (int d = 1; d < DVBRIDGE_STEP_LEVELS; ++d) {
+        if (kept.step + d < DVBRIDGE_STEP_LEVELS)
+            order[n++] = kept.step + d;
+        if (kept.step - d >= 0)
+            order[n++] = kept.step - d;
+    }
+    /* Without a residual, every level above 1 draws what level 1 draws (no plane of a layer is
+     * scaled up: dvbridge_render_step_levels()): one of them is made, the first of the order */
+    const unsigned changes = dvbridge_render_step_levels(r, false);
+    unsigned bare_done = 0;
+    bool packed_once = false;
+    for (int i = 0; i < n; ++i) {
+        const int level = order[i];
+        if (!(levels & (1u << level)))
+            continue;
+        for (int form = 0; form < (residual ? 2 : 1); ++form) {
+            /* form 1: the frame without its layer */
+            const bool bare_form = form == 1;
+            if (!residual || bare_form) {
+                int same = level;
+                while (same > 0 && !(changes & (1u << same)))
+                    --same;
+                if (bare_done & (1u << same))
+                    continue;
+                bare_done |= 1u << same;
+            }
+            for (int way = 0; way < 2; ++way) {
+                if (way == 1 && !(scanout && r->fragment_quad))
+                    continue;
+                ++done.asked;
+                if (now_ms() - start >= budget_ms) {
+                    ++done.left;
+                    continue;
+                }
+                r->step = level;
+                const struct pl_frame *frame = bare_form ? &bare : source;
+                const double frame_el = bare_form ? (double)NAN : el_pts;
+                bool ok;
+                if (way == 0) {
+                    ok = dvbridge_render_rgb(r, frame, metadata, bytes, pts, frame_el, geometry);
+                    if (ok && packer && !packed_once) {
+                        /* and the packing of a composed picture, once: into the target of the
+                         * frames, which the first one writes whole */
+                        unsigned count = 0;
+                        const uint32_t *words = dvbridge_packets(r->pending, &count);
+                        packed_once = dvbridge_gl_pack(packer,
+                            pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, NULL), framebuffer,
+                            3840, 2160, words, count, true);
+                    }
+                } else {
+                    ok = dvbridge_render_packed(r, frame, metadata, bytes, pts, frame_el, geometry,
+                                                scanout, true);
+                }
+                /* each one waited for, so that the time is the time it took */
+                glFinish();
+                done.made += ok;
+                done.failed += !ok;
+                pl_renderer_reset_errors(r->renderer, NULL);
+            }
+        }
+    }
+    give_back_state(r, &kept);
+    done.ms = now_ms() - start;
+    if (report)
+        *report = done;
+    return done.made;
+}
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 8402b4a..a82843c 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -155,4 +155,33 @@ bool dvbridge_render_ccm_composer(const struct dvbridge_renderer *renderer);
  * reshaping, as before, to compare on hardware. A picture outside the clause's scope is composed
  * by libplacebo's reshaping either way (libplacebo logs why). */
 void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *renderer, bool use);
+
+/* Hades: the GPU programs of the ways a session can draw the frames of a stream, made ready before
+ * the first one is presented, with that frame (dvbridge_render_warm()). Each program is made when a
+ * frame first needs it: the first frame with GUI elements or subtitles over a picture drawn directly
+ * (it is composed), the first frame at another fidelity step-down level, the first frame of an
+ * enhancement layer that is resynchronizing after a seek (drawn without its residual). On a GPU that
+ * has little time to spare, that frame is late. What is drawn here: the frame composed and, where
+ * scanout is given and the GPU can, drawn directly; at every level of the mask levels (the level
+ * the renderer is set to always, first, then the nearest), and when it has the residual of its
+ * enhancement layer, also without that layer. Composed into the renderer's picture, directly into
+ * scanout, and one composed picture packed with packer into framebuffer (the target of the frames,
+ * which the next frame writes whole); each render waited for. Nothing is presented, and nothing of
+ * the renderer's state changes: not its candidate, transport state, notes, level or what it has
+ * found of the bars written first; libplacebo's errors are reset. Renders are made while the time
+ * since the start is under budget_ms. Returns how many renders were made. */
+#define DVBRIDGE_RENDER_WARM 1
+struct dvbridge_gl_packer;
+struct dvbridge_warm_report {
+    unsigned asked;  /* renders of the list */
+    unsigned made;   /* ... made */
+    unsigned failed; /* ... that failed (libplacebo or the metadata refused them) */
+    unsigned left;   /* ... not made: the time was up */
+    double ms;       /* the time it took */
+};
+int dvbridge_render_warm(struct dvbridge_renderer *renderer, const struct pl_frame *source,
+                         const void *metadata, size_t bytes, double pts, double el_pts,
+                         struct dvbridge_geometry geometry, unsigned levels, pl_tex scanout,
+                         struct dvbridge_gl_packer *packer, unsigned framebuffer, double budget_ms,
+                         struct dvbridge_warm_report *report);
 #endif
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 1c133dc..7c230ce 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -276,7 +276,10 @@ CDVBridgeGLES::~CDVBridgeGLES()
 void CDVBridgeGLES::UseShaderCache()
 {
   if (const pl_cache cache = OpenShaderCache())
+  {
     pl_gpu_set_cache(m_gl->gpu, cache);
+    m_shaderCache = cache;
+  }
 }
 
 void CDVBridgeGLES::SaveShaderCache()
@@ -724,6 +727,70 @@ void CDVBridgeGLES::PQTextureDrawn()
     dvbridge_render_texture_drawn(m_renderer);
 }
 
+void CDVBridgeGLES::Warm(const Layer& base,
+                         const AVFrame* enhancement,
+                         const CDVMetadataBuffer& metadata,
+                         dvbridge_geometry geometry,
+                         unsigned int levels,
+                         bool allowPacked,
+                         double budgetMs)
+{
+  if (!m_renderer || !metadata.Data())
+    return;
+  TakeStaleGLErrors("the ways of drawing are made ready");
+  dvbridge_gl_frame bl{}, el{};
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
+    return;
+  // the layer as the frame will import it (with the images kept of its surface)
+  if (enhancement && !m_layerCache)
+    m_layerCache = dvbridge_dmabuf_cache_create();
+  dvbridge_dmabuf imported{};
+  bool mapped = false;
+  bool layered = false;
+  double elPts = std::numeric_limits<double>::quiet_NaN();
+  if (enhancement)
+  {
+    mapped = dvbridge_dmabuf_import_cached(m_layerCache, &imported, enhancement);
+    layered = mapped && dvbridge_gl_frame_import(&el, m_gl->gpu, imported.layout, enhancement->width,
+                                                 enhancement->height, imported.planes,
+                                                 enhancement->chroma_location);
+    if (layered)
+    {
+      bl.frame.enhancement_layer = &el.frame;
+      elPts = static_cast<double>(enhancement->pts);
+    }
+  }
+  const bool whole = !geometry.x && !geometry.y && geometry.width == 3840 && geometry.height == 2160;
+  const int programs = m_shaderCache ? pl_cache_objects(m_shaderCache) : -1;
+  dvbridge_warm_report report{};
+  dvbridge_render_warm(m_renderer, &bl.frame, metadata.Data(), metadata.Size(), base.pts, elPts,
+                       geometry, levels, allowPacked && m_directUsable && whole ? m_scanout : nullptr,
+                       m_packer, 0, budgetMs, &report);
+  if (layered)
+    dvbridge_gl_frame_release(&el);
+  if (mapped)
+    dvbridge_dmabuf_release(&imported);
+  dvbridge_gl_frame_release(&bl);
+  TakeStaleGLErrors("the ways of drawing were made ready");
+  const std::string compiled =
+      programs >= 0
+          ? StringUtils::Format(", {} GPU programs compiled (the others were taken from the cache of "
+                                "earlier sessions, or made before)",
+                                pl_cache_objects(m_shaderCache) - programs)
+          : std::string();
+  CLog::Log(LOGINFO,
+            "DVBridge: {} of {} ways of drawing the frames of this stream made ready before its "
+            "first frame, in {:.0f} ms{}{}{}",
+            report.made, report.asked, report.ms, compiled,
+            report.left ? StringUtils::Format("; {} left for the frame that first needs them (the "
+                                              "{:.0f} ms were up)",
+                                              report.left, budgetMs)
+                        : std::string(),
+            report.failed ? StringUtils::Format("; {} could not be drawn", report.failed)
+                          : std::string());
+}
+
 unsigned int CDVBridgeGLES::GetPQTexture() const
 {
   const auto texture = m_prepared ? dvbridge_render_texture(m_renderer) : nullptr;
