From d1aa2511293856b832cb0c995cf066e2876be1d7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 02:44:06 +0000
Subject: [PATCH] MPLSParser: a sub play item keeps the type of its sub-path

The parser puts the sub play items of all sub-paths of a list into one list, and the type of
the sub-path was not read. For the extension data of a playlist that made every sub-path a
second view: the stereoscopic video (type 8), but also the stereoscopic menu graphics (type 9)
and whatever else stands there.

The type is read (a byte of the sub-path header, before one that was read already) and kept
with each sub play item. CStreamParser counts as the clips of the dependent view only those
of the sub-path of the stereoscopic video (KODI::MULTIVIEW::IsSecondViewSubPath()), which is
what tells one stereoscopic presentation from another when playlists are compared; the helper
of its test gives its sub play items that type.

For a playlist without extension data nothing changes; for any playlist, nothing but one
field more in what is kept of a sub play item.
---
 xbmc/filesystem/bluray/MPLSParser.cpp     | 4 ++++
 xbmc/filesystem/bluray/MPLSParser.h       | 5 +++++
 xbmc/filesystem/bluray/StreamParser.cpp   | 8 +++++++-
 xbmc/filesystem/test/TestStreamParser.cpp | 1 +
 4 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/xbmc/filesystem/bluray/MPLSParser.cpp b/xbmc/filesystem/bluray/MPLSParser.cpp
index 7b6eef7..bc435ba 100644
--- a/xbmc/filesystem/bluray/MPLSParser.cpp
+++ b/xbmc/filesystem/bluray/MPLSParser.cpp
@@ -710,6 +710,7 @@ constexpr uint8_t MPLS_APP_INFO_MVC_BASE_VIEW_R = 0x10;
 constexpr unsigned int OFFSET_MPLS_NUM_PLAYITEMS = 6;
 constexpr unsigned int OFFSET_MPLS_NUM_SUBPATHS = 8;
 constexpr unsigned int OFFSET_MPLS_SUBPATH_NUM_SUBPLAYITEMS = 9;
+constexpr unsigned int OFFSET_MPLS_SUBPATH_TYPE = 5; // Hades: read for each sub play item
 constexpr unsigned int OFFSET_MPLS_NUM_PLAYLISTMARKS = 4;
 constexpr unsigned int OFFSET_MPLS_PLAYLISTMARK_TYPE = 1;
 constexpr unsigned int OFFSET_MPLS_PLAYLISTMARK_PLAYITEM = 2;
@@ -766,6 +767,8 @@ bool ParseSubPath(std::vector<std::byte>& buffer,
 
   const unsigned int numSubPlayItems{
       GetByte(buffer, offset + OFFSET_MPLS_SUBPATH_NUM_SUBPLAYITEMS)};
+  // Hades: (a byte before the one that was just read)
+  const unsigned int subPathType{GetByte(buffer, offset + OFFSET_MPLS_SUBPATH_TYPE)};
   offset += 10;
 
   if (numSubPlayItems == 0)
@@ -780,6 +783,7 @@ bool ParseSubPath(std::vector<std::byte>& buffer,
       subPlayItems.pop_back();
       return false;
     }
+    subPlayItem.subPathType = subPathType;
   }
 
   return true;
diff --git a/xbmc/filesystem/bluray/MPLSParser.h b/xbmc/filesystem/bluray/MPLSParser.h
index 1942bac..6b231cc 100644
--- a/xbmc/filesystem/bluray/MPLSParser.h
+++ b/xbmc/filesystem/bluray/MPLSParser.h
@@ -170,6 +170,11 @@ struct SubPlayItemInformation
   std::chrono::milliseconds outTime{0ms};
   unsigned int syncPlayItemId{0};
   std::vector<ClipInformation> clips;
+
+  //! Hades: the type of the sub-path that the sub play item is of (BLURAY_SUBPATH_TYPE). The sub
+  //! play items of all sub-paths of a list are kept in one list, and only those of the
+  //! stereoscopic video name the second view of a 3D disc.
+  unsigned int subPathType{0};
 };
 
 struct SubPathInformation
diff --git a/xbmc/filesystem/bluray/StreamParser.cpp b/xbmc/filesystem/bluray/StreamParser.cpp
index 1a8d7f0..1816c93 100644
--- a/xbmc/filesystem/bluray/StreamParser.cpp
+++ b/xbmc/filesystem/bluray/StreamParser.cpp
@@ -8,6 +8,8 @@
 
 #include "StreamParser.h"
 
+#include "cores/VideoPlayer/MultiviewChoice.h"
+
 #include "M2TSParser.h"
 #include "PlaylistStructure.h"
 #include "filesystem/DiscDirectoryHelper.h"
@@ -416,7 +418,11 @@ void CStreamParser::ConvertBlurayPlaylistInformation(const BlurayPlaylistInforma
   p.dependentViewClips.reserve(b.extensionSubPlayItems.size());
   for (const SubPlayItemInformation& subPlayItem : b.extensionSubPlayItems)
   {
-    if (!subPlayItem.clips.empty())
+    // Hades: of the sub-paths of the extension data only the stereoscopic video is a second
+    // view. (The clip is that of the first angle: this tells presentations apart, it plays
+    // nothing.)
+    if (KODI::MULTIVIEW::IsSecondViewSubPath(subPlayItem.subPathType) &&
+        !subPlayItem.clips.empty())
       p.dependentViewClips.emplace_back(subPlayItem.clips.front().clip);
   }
   p.baseViewIsRightEye = b.baseViewIsRightEye;
diff --git a/xbmc/filesystem/test/TestStreamParser.cpp b/xbmc/filesystem/test/TestStreamParser.cpp
index 0984a71..939b9c1 100644
--- a/xbmc/filesystem/test/TestStreamParser.cpp
+++ b/xbmc/filesystem/test/TestStreamParser.cpp
@@ -82,6 +82,7 @@ void AddDependentView(BlurayPlaylistInformation& info, const std::vector<unsigne
   {
     SubPlayItemInformation subPlayItem;
     subPlayItem.syncPlayItemId = i;
+    subPlayItem.subPathType = 8; // Hades: the stereoscopic video
     subPlayItem.clips.emplace_back(clips[i], "M2TS");
     info.extensionSubPlayItems.emplace_back(std::move(subPlayItem));
   }
-- 
