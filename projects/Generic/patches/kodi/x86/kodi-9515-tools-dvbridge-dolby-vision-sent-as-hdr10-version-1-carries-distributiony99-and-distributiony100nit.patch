diff --git a/tools/dvbridge/dvbridge_dvplus.c b/tools/dvbridge/dvbridge_dvplus.c
index d656ee9..6866e78 100644
--- a/tools/dvbridge/dvbridge_dvplus.c
+++ b/tools/dvbridge/dvbridge_dvplus.c
@@ -24,11 +24,19 @@ static const double QUANTILES[DVBRIDGE_DVPLUS_PLACES] = {0.01, 0.05, 0.10, 0.25,
 const struct dvbridge_dvplus_params dvbridge_dvplus_default_params = {
     .hysteresis = 0, .pq_step = 32, .lost = 48, .interval = 24, .big_step = 64};
 
+/* (version 1: DistributionY100nit is a percentage, not a luminance; within a scene a move of it by more than DARK_STEP
+ * points counts as a move, by more than DARK_BIG_STEP as one that may change what is sent at any time, as pq_step and
+ * big_step do for a luminance. Chosen, not measured on the bench of the others: what a display does with this place
+ * is not known) */
+#define DARK_STEP 2
+#define DARK_BIG_STEP 10
+
 #define RING 64
 
 struct dvbridge_dvplus {
     struct dvbridge_dvplus_params params;
     double nits[65536]; /* cd/m2 of each 16-bit PQ code */
+    int version;        /* of the metadata sent: 0 or 1 */
     /* the scene of now: what is measured of it, pooled */
     bool open;
     unsigned scene;
@@ -37,6 +45,12 @@ struct dvbridge_dvplus {
     double sum;
     unsigned pictures;
     unsigned since_change; /* measured pictures of the scene since what is sent last changed */
+    /* ... and of each picture measured, its luminance: the highest 99.99th percentile, and the sum of the percentages
+     * at or below 100 cd/m2 of the pictures that had samples */
+    unsigned y99;
+    double dark_sum;
+    unsigned dark_pictures;
+    uint64_t scratch[DVBRIDGE_DVPLUS_BINS];
     /* the picture presented last */
     bool presented;
     double last_pts;
@@ -82,6 +96,28 @@ static unsigned units(double nits)
     return u < 0 ? 0 : u > 100000 ? 100000 : (unsigned)u;
 }
 
+/* the quantile q of a histogram of count samples, in PQ: the quantile function through the bins, within a bin its
+ * samples taken as spread evenly over it in PQ */
+static double quantile_pq(const uint64_t *hist, unsigned bins, uint64_t count, double q)
+{
+    const double target = q * (double)count;
+    uint64_t below = 0;
+    unsigned b = 0;
+    for (; b < bins; ++b) {
+        if (hist[b] && (double)(below + hist[b]) >= target)
+            break;
+        below += hist[b];
+    }
+    if (b == bins) { /* (only by rounding) the highest bin that has any */
+        for (b = bins; b-- > 0 && !hist[b];)
+            ;
+        below = count - hist[b];
+    }
+    double frac = (target - (double)below) / (double)hist[b];
+    frac = frac < 0 ? 0 : frac > 1 ? 1 : frac;
+    return (b + frac) / bins;
+}
+
 void dvbridge_dvplus_stats_of(const uint64_t *hist, unsigned bins, uint64_t count, double sum,
                               struct dvbridge_dvplus_stats *stats)
 {
@@ -89,26 +125,10 @@ void dvbridge_dvplus_stats_of(const uint64_t *hist, unsigned bins, uint64_t coun
     if (!hist || !bins || !count)
         return;
     stats->average = units(sum / (double)count);
-    /* the quantile function through the bins: within a bin, its samples taken as spread evenly over it in PQ */
     for (unsigned i = 0; i < DVBRIDGE_DVPLUS_PLACES; ++i) {
         if (!QUANTILES[i])
             continue;
-        const double target = QUANTILES[i] * (double)count;
-        uint64_t below = 0;
-        unsigned b = 0;
-        for (; b < bins; ++b) {
-            if (hist[b] && (double)(below + hist[b]) >= target)
-                break;
-            below += hist[b];
-        }
-        if (b == bins) { /* (only by rounding) the highest bin that has any */
-            for (b = bins; b-- > 0 && !hist[b];)
-                ;
-            below = count - hist[b];
-        }
-        double frac = (target - (double)below) / (double)hist[b];
-        frac = frac < 0 ? 0 : frac > 1 ? 1 : frac;
-        stats->percentiles[i] = units(dvbridge_dvplus_nits((b + frac) / bins));
+        stats->percentiles[i] = units(dvbridge_dvplus_nits(quantile_pq(hist, bins, count, QUANTILES[i])));
     }
     unsigned top = bins;
     while (top-- > 0 && !hist[top])
@@ -122,11 +142,29 @@ struct dvbridge_dvplus *dvbridge_dvplus_create(const struct dvbridge_dvplus_para
     if (!m)
         return NULL;
     m->params = params ? *params : dvbridge_dvplus_default_params;
+    m->version = 1;
     for (unsigned i = 0; i < 65536; ++i)
         m->nits[i] = dvbridge_dvplus_nits(i / 65535.0);
     return m;
 }
 
+void dvbridge_dvplus_set_version(struct dvbridge_dvplus *m, int version)
+{
+    if (m)
+        m->version = version == 0 ? 0 : 1;
+}
+
+static void scene_clear(struct dvbridge_dvplus *m)
+{
+    m->count = 0;
+    m->sum = 0;
+    m->pictures = 0;
+    memset(m->hist, 0, sizeof(m->hist));
+    m->y99 = 0;
+    m->dark_sum = 0;
+    m->dark_pictures = 0;
+}
+
 void dvbridge_dvplus_destroy(struct dvbridge_dvplus *m)
 {
     free(m);
@@ -143,10 +181,7 @@ void dvbridge_dvplus_reset(struct dvbridge_dvplus *m)
     m->presented = false;
     m->have = false;
     m->unmeasured = 0;
-    m->count = 0;
-    m->sum = 0;
-    m->pictures = 0;
-    memset(m->hist, 0, sizeof(m->hist));
+    scene_clear(m);
     memset(m->ring, 0, sizeof(m->ring));
     m->ring_next = 0;
     m->counts = counts;
@@ -223,18 +258,24 @@ void dvbridge_dvplus_area(const void *metadata, size_t size, int width, int heig
 }
 
 void dvbridge_dvplus_picture_add(const struct dvbridge_dvplus *m, struct dvbridge_dvplus_picture *picture,
-                                 const uint16_t *codes, size_t count)
+                                 const uint16_t *codes, const uint16_t *luminance, size_t count)
 {
     if (!m || !picture || !codes)
         return;
+    if (!luminance)
+        luminance = codes;
     double sum = 0;
+    uint32_t dark = 0;
     for (size_t i = 0; i < count; ++i) {
-        const uint16_t c = codes[i];
+        const uint16_t c = codes[i], y = luminance[i];
         ++picture->hist[c >> 4];
         sum += m->nits[c];
+        ++picture->luminance_hist[y >> 4];
+        dark += m->nits[y] <= DVBRIDGE_DVPLUS_DARK_NITS;
     }
     picture->sum += sum;
     picture->count += (uint32_t)count;
+    picture->dark += dark;
 }
 
 static bool same_scene(const struct dvbridge_dvplus_rpu *a, const struct dvbridge_dvplus_rpu *b)
@@ -272,11 +313,8 @@ bool dvbridge_dvplus_present(struct dvbridge_dvplus *m, double pts, const struct
     if (cut) {
         ++m->scene;
         m->open = true;
-        m->count = 0;
-        m->sum = 0;
-        m->pictures = 0;
+        scene_clear(m);
         m->since_change = 0;
-        memset(m->hist, 0, sizeof(m->hist));
         ++m->counts.scenes;
     }
     m->ring[m->ring_next].pts = pts;
@@ -323,14 +361,22 @@ static bool value_moves(unsigned a, unsigned b, unsigned step, unsigned pq_step)
     return !pq_step || fabs(pq_code(a) - pq_code(b)) > pq_step;
 }
 
+/* whether what is sent moves; version 1: its places of 5 and 10 percent carry y99 and y100nit, not those percentiles
+ * (dark_step: the move of y100nit, in points, that counts) */
 static bool moves(const struct dvbridge_dvplus_stats *a, const struct dvbridge_dvplus_stats *b, unsigned step,
-                  unsigned pq_step)
+                  unsigned pq_step, int version, unsigned dark_step)
 {
     if (value_moves(a->average, b->average, step, pq_step))
         return true;
-    for (unsigned i = 0; i < DVBRIDGE_DVPLUS_PLACES; ++i)
+    for (unsigned i = 0; i < DVBRIDGE_DVPLUS_PLACES; ++i) {
+        if (version && (i == 1 || i == 2))
+            continue;
         if (QUANTILES[i] && value_moves(a->percentiles[i], b->percentiles[i], step, pq_step))
             return true;
+    }
+    if (version)
+        return value_moves(a->y99, b->y99, step, pq_step) ||
+               (unsigned)abs((int)a->y100nit - (int)b->y100nit) > dark_step;
     return false;
 }
 
@@ -361,17 +407,30 @@ bool dvbridge_dvplus_measured(struct dvbridge_dvplus *m, const struct dvbridge_d
     ++m->pictures;
     m->unmeasured = 0;
     ++m->counts.measured;
+    /* the luminance of the picture: its 99.99th percentile (the highest of the scene's is DistributionY99), and the
+     * percentage of its samples at or below 100 cd/m2 (their average over the scene's pictures is
+     * DistributionY100nit); the same samples as maxRGB, so the same count */
+    for (unsigned b = 0; b < DVBRIDGE_DVPLUS_BINS; ++b)
+        m->scratch[b] = picture->luminance_hist[b];
+    const unsigned y99 = units(
+        dvbridge_dvplus_nits(quantile_pq(m->scratch, DVBRIDGE_DVPLUS_BINS, picture->count, DVBRIDGE_DVPLUS_Y99_QUANTILE)));
+    m->y99 = y99 > m->y99 ? y99 : m->y99;
+    m->dark_sum += 100.0 * (picture->dark < picture->count ? picture->dark : picture->count) / picture->count;
+    ++m->dark_pictures;
     struct dvbridge_dvplus_stats made;
     dvbridge_dvplus_stats_of(m->hist, DVBRIDGE_DVPLUS_BINS, m->count, m->sum, &made);
+    made.y99 = m->y99;
+    made.y100nit = (unsigned)floor(m->dark_sum / m->dark_pictures + 0.5);
     ++m->since_change;
     if (m->pictures == 1 || !m->have) {
         /* the scene's own, from its first picture measured */
         m->sent = made;
         m->have = true;
         m->since_change = 0;
-    } else if (moves(&made, &m->sent, m->params.hysteresis, m->params.pq_step) &&
+    } else if (moves(&made, &m->sent, m->params.hysteresis, m->params.pq_step, m->version, DARK_STEP) &&
                (m->since_change >= m->params.interval ||
-                (m->params.big_step && moves(&made, &m->sent, m->params.hysteresis, m->params.big_step)))) {
+                (m->params.big_step &&
+                 moves(&made, &m->sent, m->params.hysteresis, m->params.big_step, m->version, DARK_BIG_STEP)))) {
         m->sent = made;
         m->since_change = 0;
         ++m->counts.changes;
@@ -400,6 +459,12 @@ void dvbridge_dvplus_metadata_version(const struct dvbridge_dvplus_stats *s, int
         w->distribution_maxrgb[i].percentage = dvbridge_dvplus_percentages[i];
         w->distribution_maxrgb[i].percentile = (AVRational){(int)s->percentiles[i], 100000};
     }
+    if (out->application_version == 1) {
+        /* DistributionY99, a luminance in the units of the others; DistributionY100nit, a percentage, which the
+         * InfoFrame carries as it is coded (MakeVsif()) */
+        w->distribution_maxrgb[1].percentile = (AVRational){(int)s->y99, 100000};
+        w->distribution_maxrgb[2].percentile = (AVRational){(int)(s->y100nit > 100 ? 100 : s->y100nit), 100000};
+    }
     w->fraction_bright_pixels = (AVRational){0, 1000};
     w->tone_mapping_flag = 0;
     w->color_saturation_mapping_flag = 0;
@@ -424,6 +489,13 @@ bool dvbridge_dvplus_provisional(const struct dvbridge_dvplus_rpu *rpu, struct d
     for (unsigned i = 0; i < DVBRIDGE_DVPLUS_PLACES; ++i)
         stats->percentiles[i] = units(dvbridge_dvplus_nits(DVPLUS_L1_Q(QUANTILES[i])));
     stats->maxrgb = units(dvbridge_dvplus_nits(mx));
+    /* (that function taken as the luminance: the quantile of DistributionY99, and the share of it at or below 100
+     * cd/m2, found on it as it never decreases) */
+    stats->y99 = units(dvbridge_dvplus_nits(DVPLUS_L1_Q(DVBRIDGE_DVPLUS_Y99_QUANTILE)));
+    unsigned dark = 0;
+    for (int i = 0; i < n; ++i)
+        dark += dvbridge_dvplus_nits(DVPLUS_L1_Q((i + 0.5) / n)) <= DVBRIDGE_DVPLUS_DARK_NITS;
+    stats->y100nit = (unsigned)floor(100.0 * dark / n + 0.5);
 #undef DVPLUS_L1_Q
     return true;
 }
