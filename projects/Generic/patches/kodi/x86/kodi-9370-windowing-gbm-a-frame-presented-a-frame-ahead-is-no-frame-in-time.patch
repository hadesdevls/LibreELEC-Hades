From 1ac3747ad22fbd56b839da15b687c8a4edf0888b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:47:32 +0000
Subject: [PATCH] windowing/gbm: a frame presented a frame ahead is no frame in
 time

CDVPresentStall ends native Dolby Vision output when the frames whose commit
the kernel takes do not reach the display: two stalls of over 2 s in a row,
or one of over 5 s. A frame in time between two stalls starts the count
again. A frame presented a frame ahead counted as one: its commit returns at
once, before its flip, also when the display engine is dead. With nvidia-drm
and a dead engine the frames went ahead, stalled, ahead, stalled, and native
output ended after some 15 s instead of 6 (a host model with the real
classes), while nothing new reached the display.

Such a frame now counts neither way. That its flip came is told when its
out-fence signals while it is waited for (DVAheadFlipped(), and the wait for
a third buffer in DVAheadEnd()), which starts the count again: single flips
that are lost far apart still end nothing. That it did not come is told by
the frame after it, which waits for it in vain and is presented the way that
waits.
---
 xbmc/windowing/gbm/DVPresentStall.h            | 18 +++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 11 ++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  6 +++---
 3 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/DVPresentStall.h b/xbmc/windowing/gbm/DVPresentStall.h
index 0750646..55d40f6 100644
--- a/xbmc/windowing/gbm/DVPresentStall.h
+++ b/xbmc/windowing/gbm/DVPresentStall.h
@@ -32,6 +32,13 @@ namespace GBM
  * STALL_MS stalled; two in a row, or one that took longer than GIVE_UP_MS (the 10 s of the
  * kernel's helpers), end the native output. A frame in time between them starts again.
  *
+ * Hades: a frame presented a frame ahead (CDVAhead) is no frame in time: its commit returns
+ * before its flip, at once, also when the display engine is dead. It counts neither way: that its
+ * flip came is told when its out-fence signals (Flipped()), and that it did not by the frame after
+ * it, which then waits for it in vain and is presented the way that waits. Taken as in time, a
+ * frame ahead between two stalls started the count again, and with nvidia-drm native output ended
+ * after some 15 s of a dead display instead of 6.
+ *
  * This class only decides.
  */
 class CDVPresentStall
@@ -46,10 +53,11 @@ public:
 
   //! What a frame whose commit was taken that took this long (the presentation, ms) means.
   //! plain: the commit changed nothing but the picture (the output was carrying the transport,
-  //! and Kodi had asked for nothing else since the frame before).
-  Verdict Presented(bool plain, double ms)
+  //! and Kodi had asked for nothing else since the frame before). ahead: the commit did not wait
+  //! for the flip of the frame (see the class).
+  Verdict Presented(bool plain, double ms, bool ahead = false)
   {
-    if (!plain)
+    if (!plain || ahead)
       return Verdict::NONE;
     if (!(ms >= STALL_MS))
     {
@@ -65,6 +73,10 @@ public:
     return Verdict::STALLED;
   }
 
+  //! The flip of a frame presented a frame ahead came while it was waited for: that frame was in
+  //! time (the kernel signals the out-fence of a commit with its flip)
+  void Flipped() { m_stalls = 0; }
+
   //! Frames that stalled in a row, until the one that gave up
   unsigned int Stalls() const { return m_stalls; }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index d8bd0ad..75754be 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -351,6 +351,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     const bool attempted = m_dvFrame && m_dvBridge;
     const auto presentStart = std::chrono::steady_clock::now();
     bool presented = false;
+    bool presentedAhead = false; //!< Hades: ... and its commit did not wait for its flip
     // Hades: the commit of this frame changes nothing but the picture (CDVPresentStall): the
     // output carries the transport already, and Kodi has asked for nothing else since
     bool plainFrame = false;
@@ -467,6 +468,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         plainFrame = m_dvState.TransportLive() && atomic && !atomic->HasPendingRequest();
         AnnounceHeldModeChange(true);
         presented = FlipDVBridgePage(m_dvState, false, &flip);
+        presentedAhead = presented && flip.ahead;
         HeldModeChangeCommitted(presented, true);
         DVAheadEnd(presented, flip);
         if (presented && !m_dvSignalling)
@@ -533,7 +535,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         m_dvStats.late++;
       // Hades: a frame that was taken and whose flip did not come; the output ends when they do
       // not reach the display (the ordinary output, restored, is told from here on)
-      if (presented && DVPresentStalled(plainFrame, presentMs))
+      if (presented && DVPresentStalled(plainFrame, presentMs, presentedAhead))
       {
         SendDisplayReset();
         return;
@@ -3222,6 +3224,8 @@ bool CWinSystemGbmGLESContext::DVAheadFence()
 
 void CWinSystemGbmGLESContext::DVAheadFlipped(int64_t ns)
 {
+  // Hades: that frame reached the display in time (CDVPresentStall)
+  m_dvPresentStall.Flipped();
   // The time between the flips of two frames in a row, as the kernel tells them: what says
   // whether a refresh was missed while frames are presented a frame ahead, where the time that
   // a presentation takes says little.
@@ -3274,6 +3278,7 @@ void CWinSystemGbmGLESContext::DVAheadEnd(bool presented, const DVFlip& flip)
       {
         surface.ReleaseRetiredBuffer();
         m_dvAheadPending = false;
+        m_dvPresentStall.Flipped(); // (Hades: it came in time)
       }
       ahead = false;
       DVAheadFailed("the output has no third buffer", true);
@@ -3617,10 +3622,10 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   m_dvStats.hasLastShown = hasLastShown;
 }
 
-bool CWinSystemGbmGLESContext::DVPresentStalled(bool plain, double presentMs)
+bool CWinSystemGbmGLESContext::DVPresentStalled(bool plain, double presentMs, bool ahead)
 {
   const unsigned int stalls = m_dvPresentStall.Stalls();
-  const auto verdict = m_dvPresentStall.Presented(plain, presentMs);
+  const auto verdict = m_dvPresentStall.Presented(plain, presentMs, ahead);
   if (verdict == CDVPresentStall::Verdict::NONE)
     return false;
   if (verdict == CDVPresentStall::Verdict::STALLED)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 712daea..0d4041a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -331,9 +331,9 @@ private:
   std::chrono::steady_clock::time_point m_dvFirstFailedFrame;
   //! Hades: whether the frames that the kernel takes reach the display (their flips come)
   CDVPresentStall m_dvPresentStall;
-  //! ... told of a frame whose commit was taken (plain: it changed nothing but the picture); true
-  //! when native output was ended for it
-  bool DVPresentStalled(bool plain, double presentMs);
+  //! ... told of a frame whose commit was taken (plain: it changed nothing but the picture; ahead:
+  //! the commit did not wait for its flip); true when native output was ended for it
+  bool DVPresentStalled(bool plain, double presentMs, bool ahead);
   //! Presentation statistics of native Dolby Vision output, logged every 10 s and at the end.
   struct DVStats
   {
-- 
2.53.0

