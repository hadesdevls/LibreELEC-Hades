From 732dabb50fa808f0c4c767786bdbccf225604d44 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Thu, 5 Nov 2026 20:05:58 -0800
Subject: [PATCH] [cmake] Pass target processor to WindowsStore dependencies

WindowsStore dependency builds can receive an empty processor with NMake.
Reuse Windows target detection so dependencies such as libjpeg-turbo
configure for the selected compiler target.

(cherry picked from commit 83d7ac6f17ea5b2b82ba747f862ffee7531b8a7d)
---
 cmake/scripts/common/HandleDepends.cmake |  2 +-
 cmake/scripts/common/PrepareEnv.cmake    | 10 +++++++---
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/cmake/scripts/common/HandleDepends.cmake b/cmake/scripts/common/HandleDepends.cmake
index 81c680c..b267bde 100644
--- a/cmake/scripts/common/HandleDepends.cmake
+++ b/cmake/scripts/common/HandleDepends.cmake
@@ -80,7 +80,7 @@ function(add_addon_depends addon searchpath)
         # windows args
         if (CMAKE_SYSTEM_NAME STREQUAL WindowsStore OR CMAKE_SYSTEM_NAME STREQUAL Windows)
           list(APPEND BUILD_ARGS -DCMAKE_SYSTEM_NAME=${CMAKE_SYSTEM_NAME})
-          if(CMAKE_SYSTEM_NAME STREQUAL Windows AND ADDON_SYSTEM_PROCESSOR AND NOT CMAKE_TOOLCHAIN_FILE)
+          if(ADDON_SYSTEM_PROCESSOR AND NOT CMAKE_TOOLCHAIN_FILE)
             list(APPEND BUILD_ARGS -DCMAKE_SYSTEM_PROCESSOR=${ADDON_SYSTEM_PROCESSOR})
           endif()
           list(APPEND BUILD_ARGS -DCMAKE_SYSTEM_VERSION=${CMAKE_SYSTEM_VERSION})
diff --git a/cmake/scripts/common/PrepareEnv.cmake b/cmake/scripts/common/PrepareEnv.cmake
index dc0e614..8be52b3 100644
--- a/cmake/scripts/common/PrepareEnv.cmake
+++ b/cmake/scripts/common/PrepareEnv.cmake
@@ -63,13 +63,15 @@ elseif(CORE_SYSTEM_NAME STREQUAL darwin_embedded)
   endif()
 elseif(CORE_SYSTEM_NAME STREQUAL osx)
   set(PLATFORM_TAG ${PLATFORM_TAG}-${CPU})
-elseif(CORE_SYSTEM_NAME STREQUAL windows)
+elseif(CORE_SYSTEM_NAME STREQUAL windows OR CORE_SYSTEM_NAME STREQUAL windowsstore)
   include(CheckSymbolExists)
   check_symbol_exists(_X86_ "Windows.h" _X86_)
   check_symbol_exists(_AMD64_ "Windows.h" _AMD64_)
   check_symbol_exists(_ARM64_ "Windows.h" _ARM64_)
 
-  if(_X86_)
+  if(CORE_SYSTEM_NAME STREQUAL windowsstore AND CMAKE_SYSTEM_PROCESSOR)
+    set(ADDON_SYSTEM_PROCESSOR ${CMAKE_SYSTEM_PROCESSOR})
+  elseif(_X86_)
     set(ADDON_SYSTEM_PROCESSOR i686)
   elseif(_AMD64_)
     set(ADDON_SYSTEM_PROCESSOR x86_64)
@@ -79,7 +81,9 @@ elseif(CORE_SYSTEM_NAME STREQUAL windows)
     message(FATAL_ERROR "Unsupported architecture")
   endif()
 
-  set(PLATFORM_TAG ${PLATFORM_TAG}-${ADDON_SYSTEM_PROCESSOR})
+  if(CORE_SYSTEM_NAME STREQUAL windows)
+    set(PLATFORM_TAG ${PLATFORM_TAG}-${ADDON_SYSTEM_PROCESSOR})
+  endif()
 
   unset(_X86_)
   unset(_AMD64_)
-- 
