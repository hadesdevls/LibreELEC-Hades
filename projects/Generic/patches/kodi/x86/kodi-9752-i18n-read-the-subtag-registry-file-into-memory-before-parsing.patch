From b05be037e8b9821eac00c2c2d9221ab74bf0965f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Wed, 21 Oct 2026 17:53:07 +0200
Subject: [PATCH] [i18n] Read the subtag registry file into memory before
 parsing

Reading it line by line costs several file system calls per line. On wasm,
where each one is a round trip to the browser main thread, that took 10 s
of the startup on a Samsung TV.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../i18n/Bcp47Registry/SubTagRegistryFile.cpp | 28 +++++++++++++++----
 .../i18n/Bcp47Registry/SubTagRegistryFile.h   | 21 ++++++++++++--
 2 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.cpp b/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.cpp
index caf3e5d..a83bdb6 100644
--- a/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.cpp
+++ b/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.cpp
@@ -8,6 +8,7 @@
 
 #include "utils/i18n/Bcp47Registry/SubTagRegistryFile.h"
 
+#include "filesystem/File.h"
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 
@@ -22,11 +23,7 @@ bool CRegistryFile::Load()
   if (!file)
     return false;
 
-  bool result = Parse(file.get());
-
-  file->Close();
-
-  return result;
+  return Parse(file.get());
 }
 
 std::unique_ptr<CRegistryFile::CRegFile> CRegistryFile::Open()
@@ -159,6 +156,27 @@ std::vector<RegistryFileField> CRegistryFile::ProcessRecordLines(
   return fields;
 }
 
+bool CRegistryFile::CRegFile::Open(const std::string& filePath)
+{
+  m_pos = 0;
+  return XFILE::CFile().LoadFile(filePath, m_data) >= 0;
+}
+
+bool CRegistryFile::CRegFile::ReadLine(std::string& line)
+{
+  if (m_pos >= m_data.size())
+    return false;
+
+  const auto begin = m_data.begin() + m_pos;
+  auto end = std::find(begin, m_data.end(), '\n');
+  if (end != m_data.end())
+    ++end;
+
+  line.assign(reinterpret_cast<const char*>(m_data.data()) + m_pos, end - begin);
+  m_pos = end - m_data.begin();
+  return true;
+}
+
 bool CRegistryFile::CRegFile::ReadRecord(std::vector<std::string>& lines)
 {
   std::string line;
diff --git a/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.h b/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.h
index 9607853..bcbc7e0 100644
--- a/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.h
+++ b/xbmc/utils/i18n/Bcp47Registry/SubTagRegistryFile.h
@@ -8,9 +8,10 @@
 
 #pragma once
 
-#include "filesystem/File.h"
 #include "utils/i18n/Bcp47Registry/RegistryRecordProvider.h"
 
+#include <cstddef>
+#include <cstdint>
 #include <memory>
 #include <string>
 #include <vector>
@@ -20,15 +21,31 @@ namespace KODI::UTILS::I18N
 class CRegistryFile : public IRegistryRecordProvider
 {
 public:
-  class CRegFile : public XFILE::CFile
+  /*!
+   * \brief The registry file, read into memory in one go.
+   */
+  class CRegFile
   {
   public:
+    /*!
+     * \brief Load the whole file
+     * \param[in] filePath path of the file
+     * \return true for success, otherwise false
+     */
+    bool Open(const std::string& filePath);
+
     /*!
      * \brief Read the file record by record
      * \param[out] lines the fetched record
      * \return true for success, otherwise false for EOF or error
      */
     bool ReadRecord(std::vector<std::string>& lines);
+
+  private:
+    bool ReadLine(std::string& line);
+
+    std::vector<uint8_t> m_data;
+    std::size_t m_pos{0};
   };
 
   CRegistryFile(std::string filePath) : m_filePath(filePath) {}
-- 
