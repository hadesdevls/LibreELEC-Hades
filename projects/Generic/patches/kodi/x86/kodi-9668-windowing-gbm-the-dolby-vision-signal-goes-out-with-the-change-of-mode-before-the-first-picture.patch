+#pragma once
+
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: the Dolby Vision signal set up with the change of mode of a video that opens, before
+ *        the player's clock starts (CWinSystemGbmGLESContext::DVStartSignal())
+ *
+ * The change of mode that VideoPlayer makes for a video that goes out natively was held for its
+ * first frame of native output, which carried it with the transport in one commit (CModeChangeHold,
+ * START), and the other subsystems were told of it with that commit (CHeldModeAnnouncement): by
+ * then VideoPlayer had decoded and queued the first pictures and the audio engine had opened its
+ * HDMI sink for the stream. Told then, VideoPlayer pauses its clock and flushes its renderer (the
+ * pictures queued after the first one are dropped), and the audio engine closes that sink and opens
+ * it again once the display is back. On the RTX 4080 SUPER with the LG C5 (kodi.log of 2026-10-28,
+ * a profile 7 stream with TrueHD): the change of mode chosen at 0 s, the passthrough sink open at
+ * 0.37 s, the first picture at 0.59 s, the commit of the mode and the transport at 0.92 s, the sink
+ * open again at 1.53 s.
+ *
+ * Here that commit is made when the change of mode is: native output begins (the output captured),
+ * a transport frame of black with valid metadata is drawn (CDVBridgeGLES::DrawStartSignal()) and
+ * committed with the mode, the commit that the first frame would make, told as the change of mode
+ * that it is (the display lost before it, back once the delay that the user set has passed). The
+ * subsystems are told before the decoder and the audio stream open, as they are of every other
+ * change of the refresh rate in Kodi, and the display sets itself up while the video opens. The
+ * renderer of the video takes the output (CDVModeMove::HandsOver()): its first frame is one more
+ * frame of the transport, with no modeset. Idea from YBLOD 0.3.0 (its native startup handoff, a
+ * black transport frame committed during the refresh change), written again for Hades: the frame
+ * goes through the transport and the commit of native output as they are, its metadata through the
+ * serializer of the renderer, so that the first frame of the video takes another metadata id and
+ * refreshes the scene; the mode is the one Kodi chose (the cadence does not change).
+ *
+ * Only where nothing is in doubt (Refuses()): VideoPlayer told of the change for a video that goes
+ * out natively, of a profile whose pictures are composed whatever each of them says (5, 7, and 8
+ * with a base layer in PQ: 8.1 and 8.6; not 8.2 or 8.4, nor AV1); the change could be held (atomic
+ * modesetting, the output on, the same window, no 3D, another mode, not a link brought up from
+ * scratch); the mode carries the transport at a rate that the display takes for native output; the
+ * display is sent Dolby Vision Standard (not Low-Latency, not the HDMI 1.4b signalling); native
+ * output is not disabled after a failure; no video has its output set up; nothing else holds or
+ * keeps the output; the window is that of the transport (3840x2160, 8 bits, OpenGL ES 3). Anything
+ * else: the hold, as before.
+ *
+ * Fail closed: where native output cannot begin or the frame cannot be drawn, nothing is committed
+ * and the hold is made as before; where the commit is refused, the ordinary output is restored
+ * with the mode in its commit and the video begins native output with its first frame, as before
+ * (the frame not tried again until Kodi is started again). The output waits for the video while
+ * the player plays, WAIT_MS at most: where the player stops first, the time passes, or the renderer
+ * of the video does not take it (it does not draw natively), the ordinary output is restored; two
+ * videos in a row that do not take it, and it is not tried again until Kodi is started again.
+ * Switched off with <video><dvstartsignal>false</dvstartsignal></video> in advancedsettings.xml.
+ *
+ * This class only decides.
+ */
+class CDVStartSignal
+{
+public:
+  //! What is known when VideoPlayer changes the mode for a video that opens
+  struct Change
+  {
+    bool switchedOn = true; //!< video/dvstartsignal (on by default)
+    //! VideoPlayer told of this change for a video that goes out natively
+    //! (DVBRIDGE::OpenedOutput::NATIVE_DV)
+    bool nativeOpens = false;
+    //! the change could be held for its output (CModeChangeHold::StartHolds(), NATIVE_DV)
+    bool holds = false;
+    //! the mode carries the transport at a rate that the display takes for native output
+    bool transportMode = false;
+    //! native output is Dolby Vision Standard: not Low-Latency, not the HDMI 1.4b signalling
+    bool standard = false;
+    bool disabled = false; //!< native output is disabled after a failure
+    bool videoOutput = false; //!< the output of a video is set up (a renderer is configured)
+    int profile = 0; //!< of the stream (dv_profile)
+    int compatibility = 0; //!< ... and its base layer (dv_bl_signal_compatibility_id)
+    //! something else holds or keeps the output: a hold (CModeChangeHold), native output (captured,
+    //! its end that waits, a move), the composition of the GUI over HDR
+    bool busy = false;
+    //! the window is that of the transport: 3840x2160, 8 bits, OpenGL ES 3
+    bool windowFits = false;
+  };
+
+  enum class Refusal
+  {
+    NONE,
+    SWITCHED_OFF,
+    NOT_TAKEN_BEFORE, //!< videos did not take it, or its commit was refused, since Kodi started
+    NOT_NATIVE,
+    NO_HOLD,
+    NOT_TRANSPORT_MODE,
+    NOT_STANDARD,
+    DISABLED,
+    VIDEO_OUTPUT,
+    PROFILE,
+    BUSY,
+    WINDOW,
+  };
+
+  static const char* Why(Refusal refusal)
+  {
+    switch (refusal)
+    {
+      case Refusal::NONE:
+        return "nothing";
+      case Refusal::SWITCHED_OFF:
+        return "advancedsettings.xml: dvstartsignal false";
+      case Refusal::NOT_TAKEN_BEFORE:
+        return "it did not work before in this run of Kodi";
+      case Refusal::NOT_NATIVE:
+        return "the video does not go out natively";
+      case Refusal::NO_HOLD:
+        return "the change of mode cannot go out with the transport (another window, 3D, the "
+               "output off, the same mode, or a link brought up from scratch)";
+      case Refusal::NOT_TRANSPORT_MODE:
+        return "the mode does not carry the transport at a rate the display takes";
+      case Refusal::NOT_STANDARD:
+        return "native output is not Dolby Vision Standard";
+      case Refusal::DISABLED:
+        return "native output is disabled after a failure";
+      case Refusal::VIDEO_OUTPUT:
+        return "the output of another video is set up";
+      case Refusal::PROFILE:
+        return "a profile whose pictures say each whether they go out natively";
+      case Refusal::BUSY:
+        return "something else holds or keeps the output";
+      case Refusal::WINDOW:
+        return "the window is not that of the transport";
+    }
+    return "?";
+  }
+
+  //! Profiles 5 and 7, and 8 over a base layer in PQ (8.1, 8.6): their pictures are composed
+  //! whatever each of them says. Not 8.2 (SDR) or 8.4 (HLG), whose composition each picture's RPU
+  //! decides (VideoPicture::doviBaseRefused), nor AV1 (profile 10), nor any other.
+  static constexpr bool ProfileTaken(int profile, int compatibility)
+  {
+    return profile == 5 || profile == 7 ||
+           (profile == 8 && (compatibility == 1 || compatibility == 6));
+  }
+
+  //! Why the signal is not set up with this change (Refusal::NONE: it is)
+  Refusal Refuses(const Change& c) const
+  {
+    if (!c.nativeOpens)
+      return Refusal::NOT_NATIVE;
+    if (!c.switchedOn)
+      return Refusal::SWITCHED_OFF;
+    if (Off())
+      return Refusal::NOT_TAKEN_BEFORE;
+    if (!ProfileTaken(c.profile, c.compatibility))
+      return Refusal::PROFILE;
+    if (c.disabled)
+      return Refusal::DISABLED;
+    if (!c.standard)
+      return Refusal::NOT_STANDARD;
+    if (!c.holds)
+      return Refusal::NO_HOLD;
+    if (!c.transportMode)
+      return Refusal::NOT_TRANSPORT_MODE;
+    if (c.videoOutput)
+      return Refusal::VIDEO_OUTPUT;
+    if (c.busy)
+      return Refusal::BUSY;
+    if (!c.windowFits)
+      return Refusal::WINDOW;
+    return Refusal::NONE;
+  }
+
+  //! Its commit was taken at nowMs: the output waits for the video
+  void Sent(int64_t nowMs)
+  {
+    m_pending = true;
+    m_sentMs = nowMs;
+  }
+  bool Pending() const { return m_pending; }
+  int64_t SentMs() const { return m_sentMs; }
+
+  enum class Wait
+  {
+    NONE, //!< nothing waits
+    WAITING, //!< the video may still take it
+    STOPPED, //!< the player stopped first: the ordinary output comes back
+    DEADLINE, //!< WAIT_MS passed: the ordinary output comes back
+  };
+  //! While it waits, each pass of the window system: playing, the player plays (or opens) a file
+  Wait Waiting(int64_t nowMs, bool playing) const
+  {
+    if (!m_pending)
+      return Wait::NONE;
+    if (!playing)
+      return Wait::STOPPED;
+    if (nowMs - m_sentMs >= WAIT_MS)
+      return Wait::DEADLINE;
+    return Wait::WAITING;
+  }
+
+  //! The renderer of the video took the output: it worked
+  void Taken()
+  {
+    m_pending = false;
+    m_notTaken = 0;
+  }
+  //! The time passed, or the renderer of the video did not take it: one more in a row
+  void NotTaken()
+  {
+    m_pending = false;
+    ++m_notTaken;
+  }
+  //! The player stopped first, or the output was ended otherwise (a change of mode, the window):
+  //! neither worked nor failed
+  void Ended() { m_pending = false; }
+  //! Native output could not begin, the frame could not be drawn, or its commit was refused: not
+  //! tried again until Kodi is started again
+  void Refused()
+  {
+    m_pending = false;
+    m_refused = true;
+  }
+  //! Not tried any more (until Kodi is started again)
+  bool Off() const { return m_refused || m_notTaken >= NOT_TAKEN_LIMIT; }
+
+  //! How long the output waits for the video: its renderer is configured with its first picture,
+  //! well under a second after the change of mode (0.53 s in the test of 2026-10-28, from a server
+  //! on the Internet); the player that stops ends it at once
+  static constexpr int64_t WAIT_MS = 10000;
+  //! Videos in a row that did not take it
+  static constexpr unsigned int NOT_TAKEN_LIMIT = 2;
+
+private:
+  bool m_pending = false;
+  int64_t m_sentMs = 0;
+  unsigned int m_notTaken = 0;
+  bool m_refused = false;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
