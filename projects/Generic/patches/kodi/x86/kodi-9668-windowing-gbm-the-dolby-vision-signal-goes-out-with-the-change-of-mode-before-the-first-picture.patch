+bool CWinSystemGbmGLESContext::DVStartSignal(const RESOLUTION_INFO& res)
+{
+  // Only the change that VideoPlayer told of for a video that goes out natively, and only where
+  // nothing is in doubt (CDVStartSignal::Refuses()); else the change is held, as before
+  if (OutputToldFor(res) != static_cast<int>(DVBRIDGE::OpenedOutput::NATIVE_DV))
+    return false;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  CDVStartSignal::Change change;
+  change.switchedOn = !advanced || advanced->m_videoDVStartSignal;
+  change.nativeOpens = true;
+  change.holds =
+      CModeChangeHold::StartHolds(CModeChangeHold::Video::NATIVE_DV, ModeChangeOf(res));
+  change.transportMode = DVTransportModeOf(res);
+  change.standard = !NativeDVLowLatency() && !NativeDVHdmi14b();
+  change.disabled = NativeDVOutputDisabled();
+  change.videoOutput = m_videoOutputUp;
+  change.profile = g_dvStreamProfile;
+  change.compatibility = g_dvStreamCompatibility;
+  change.busy = m_modeHold.Holding() != CModeChangeHold::Kind::NONE || m_dvState.Captured() ||
+                m_dvEndDeferred || m_dvMovePending || m_dvHandOver || m_dvStartWaits ||
+                m_guiCompositing;
+  change.windowFits = m_nWidth == DVBRIDGE::TRANSPORT_WIDTH &&
+                      m_nHeight == DVBRIDGE::TRANSPORT_HEIGHT && GetOutputBitDepth() == 8 &&
+                      m_renderableType == EGL_OPENGL_ES3_BIT;
