+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: the Dolby Vision signal is not set up with the change of mode to {}x{} @ "
+              "{:.3f} Hz ({}): it goes out with the first frame of the video, as before",
+              res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, CDVStartSignal::Why(refusal));
+    return false;
+  }
+  const auto started = std::chrono::steady_clock::now();
+  // (the output is being set up: the outputs are not looked at for a while)
+  VideoSeen();
+  // Native output begins in the mode on the screen, nothing committed: what it captures to put
+  // back is what the screen has (BeginDVBridge() says in the log why where it cannot)
+  if (!BeginDVBridge())
+  {
+    DVStartRelease();
+    m_dvStart.Refused();
+    CLog::Log(LOGWARNING, "DVBridge: the Dolby Vision signal could not be set up with the change of "
+                          "mode (native output could not begin): the change of mode waits for the "
+                          "first frame of the video, as before; not tried so again until Kodi is "
+                          "started again");
+    return false;
+  }
+  unsigned int packets = 0;
+  const char* why = nullptr;
+  if (!m_dvBridge->DrawStartSignal(0, m_nWidth, m_nHeight, true, packets, why))
+  {
+    m_dvBridge->StartSignalPresented(false);
+    DVStartRelease();
+    m_dvStart.Refused();
+    CLog::Log(LOGWARNING,
+              "DVBridge: the frame that sets the Dolby Vision signal up could not be drawn ({}): the "
+              "change of mode waits for the first frame of the video, as before; not tried so "
+              "again until Kodi is started again",
+              why ? why : "no reason given");
+    return false;
+  }
+  // The mode of the video, selected as a change that is held is (HoldModeChange()): the commit of
+  // the frame carries it, with the transport, as the first frame of the video would have
+  if (!m_DRM->SetMode(res))
+  {
+    m_dvBridge->StartSignalPresented(false);
+    DVStartRelease();
+    m_dvStart.Refused();
+    CLog::Log(LOGWARNING, "DVBridge: the mode of the video could not be selected for the Dolby "
+                          "Vision signal: the change of mode is made as before");
+    return false;
+  }
+  m_DRM->SetVideoMode(res, nullptr);
+  // The change of mode is told with the commit that makes it (CHeldModeAnnouncement): this frame's,
+  // or, where it does not go out, the restoration's below
+  m_modeAnnounce.Held();
