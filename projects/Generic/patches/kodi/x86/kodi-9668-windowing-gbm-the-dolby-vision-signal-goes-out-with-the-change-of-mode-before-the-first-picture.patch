+  {
+    // Told as the change of mode that it makes: lost now, back once the delay that the user set has
+    // passed after it (SendDisplayReset()), as every other change of the refresh rate is
+    AnnounceHeldModeChange(true);
+    presented = FlipDVBridgePage(m_dvState, false);
+    HeldModeChangeCommitted(presented, true);
+    failed = "its commit was refused";
+  }
+  m_dvBridge->StartSignalPresented(presented);
+  const auto sent = std::chrono::steady_clock::now();
+  const double ms = std::chrono::duration<double, std::milli>(sent - started).count();
+  if (!presented)
+  {
+    // Fail closed: the ordinary output, with the mode of the video in its commit (as after a first
+    // frame of native output that the driver refused); the video begins native output with its
+    // first frame, as before. A restoration that is refused too is made again (PresentRender()).
+    m_dvStart.Refused();
+    CLog::Log(LOGWARNING,
+              "DVBridge: the change of mode to {}x{} @ {:.3f} Hz with the Dolby Vision signal set "
+              "up for the video did not go out ({}, {:.0f} ms): the ordinary output is restored "
+              "with the mode, and the video begins native output with its first frame, as before; "
+              "not tried so again until Kodi is started again",
+              res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, failed, ms);
