+  m_dvStartAt = sent;
+  m_dvStartFirstFrame = true;
+  m_dvStartReset = true;
+  CLog::Log(LOGINFO,
+            "DVBridge: the change of mode to {}x{} @ {:.3f} Hz went out with the Dolby Vision "
+            "signal set up for the video that opens, before its first picture: a transport frame "
+            "of black with {} metadata packet{}, in one commit, {:.0f} ms after the change was "
+            "asked for; the video takes it with its first frame (within {} ms; "
+            "video/dvstartsignal)",
+            res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, packets, packets == 1 ? "" : "s",
+            ms, CDVStartSignal::WAIT_MS);
+  return true;
+}
