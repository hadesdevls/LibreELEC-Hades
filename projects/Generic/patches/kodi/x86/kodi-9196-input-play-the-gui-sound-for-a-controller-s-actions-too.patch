From 5ef7226b91b7207d19b11f37536ba1f59fa9056c Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 1 Oct 2026 19:37:06 +0100
Subject: [PATCH] [input] Play the GUI sound for a controller's actions too

A key press plays the skin's sound for its action, but an action that
arrives queued -- from a game controller's keymap, the tvOS remote or a
Windows media key -- went straight to the application and played none.
Navigating with a controller was silent wherever a remote was not. A
queued action now runs through the same path as a key press, sound and
all.
---
 xbmc/input/InputManager.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/input/InputManager.cpp b/xbmc/input/InputManager.cpp
index f6724f2..4097ac6 100644
--- a/xbmc/input/InputManager.cpp
+++ b/xbmc/input/InputManager.cpp
@@ -317,7 +317,7 @@ void CInputManager::ProcessQueuedActions()
   }
 
   for (const CAction& action : queuedActions)
-    g_application.OnAction(action);
+    ExecuteInputAction(action);
 
   // Process CEC keys
   std::vector<CKey> queuedCecKeys;
