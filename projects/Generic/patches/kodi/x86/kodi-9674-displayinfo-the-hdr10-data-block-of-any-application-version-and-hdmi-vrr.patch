+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <vector>
+
+namespace KODI
+{
+namespace UTILS
+{
+
+/*!
+ * \brief Hades: the application version of the HDR10+ vendor-specific video data block of an EDID,
+ *        the highest of several; -1 without one
+ *
+ * The block: a CTA-861 data block of extended tag 1 (vendor-specific video), IEEE OUI 90-84-8B
+ * (least significant byte first), then a byte whose bits 1 and 0 are the application version.
+ * Read from the raw EDID with the walk of i915 (intel_hdr10plus_edid_version() of the Hades kernel,
+ * linux-9997, which a host test runs on the same EDIDs), because libdisplay-info 0.4.0 keeps a block
+ * of version 1 only ("We were expecting application version 1", cta.c): a display of version 0
+ * would not be seen as one at all. Amlogic reads the same bits (hdmi_tx_edid.c,
+ * application_version = dat[pos] & 0x3). A CTA extension whose data block collection does not
+ * parse is left at the block that does not fit.
+ */
+inline int Hdr10PlusBlockVersion(const std::vector<uint8_t>& edid)
+{
+  static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+  const std::size_t size = edid.size();
+  if (size < 128 || size % 128 || !std::equal(std::begin(magic), std::end(magic), edid.begin()))
+    return -1;
+  int version = -1;
+  for (std::size_t block = 1; block < size / 128; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    if (b[0] != 0x02)
+      continue;
+    const unsigned int end = b[2];
+    if (end < 4 || end > 127)
+      continue;
+    for (unsigned int pos = 4; pos < end;)
+    {
+      const unsigned int tag = b[pos] >> 5;
+      const unsigned int len = b[pos] & 31;
+      const uint8_t* data = b + pos + 1;
+      if (pos + 1 + len > end)
+        break;
+      if (tag == 7 && len >= 5 && data[0] == 0x01 && data[1] == 0x8b && data[2] == 0x84 &&
+          data[3] == 0x90)
+        version = std::max(version, static_cast<int>(data[4] & 3));
+      pos += 1 + len;
+    }
+  }
+  return version;
+}
+
+} // namespace UTILS
+} // namespace KODI
