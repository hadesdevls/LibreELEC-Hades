From faa2d3a7282d9bc93f9f0fddeffbfd3a9cc4cdb8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:22:48 +0000
Subject: [PATCH] DisplayInfo: the HDR10+ data block of any application
 version, and HDMI VRR

libdisplay-info 0.4.0 keeps the HDR10+ vendor-specific video data block
only with application version 1 ("We were expecting application
version 1", cta.c) and drops one of version 0, so a display of version 0
was not seen as HDR10+ at all. The version is now read from the raw
EDID, as the Dolby block is, with the walk that i915 uses for the same
block (KODI::UTILS::Hdr10PlusBlockVersion(), utils/EdidHdr10Plus.h): the
highest version of the blocks, bits 1 and 0 of the byte after the OUI,
as Amlogic reads them too.

SupportsHDR10Plus() keeps its meaning (version 1 or later): it is what
add-ons are told through System.SupportedHDRTypes and what the choice of
HDR10+ sent as Dolby Vision reads, and almost all HDR10+ metadata are of
version 1, which a display of version 0 is not sent. Whether such a
display should be advertised to add-ons is left to the user to decide.
DeclaresHDR10Plus() is the block of any version, for the output.

SupportsHdmiVrr(): the display gives a VRRmin in its HDMI Forum block
(HF-VSDB or HF-SCDB), the field that NVKMS logs for HDMI VRR. The log
says the HDR10+ version and HDMI VRR of the display.
---
 xbmc/utils/DisplayInfo.cpp | 26 ++++++++++++++-
 xbmc/utils/DisplayInfo.h   | 15 +++++++--
 xbmc/utils/EdidHdr10Plus.h | 67 ++++++++++++++++++++++++++++++++++++++
 3 files changed, 105 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/utils/EdidHdr10Plus.h

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index a00dad2..42dd763 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -8,6 +8,7 @@
 
 #include "DisplayInfo.h"
 
+#include "utils/EdidHdr10Plus.h"
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 
@@ -249,6 +250,8 @@ CDisplayInfo::CDisplayInfo(const std::vector<uint8_t>& edid)
   m_dolbyVideo = ScanDolbyVideo(edid);
   m_dolbyVision = m_dolbyVideo.valid;
   m_uhd420Only = ScanUhd420Only(edid);
+  // Hades: the HDR10+ block of any application version, 0 too (HDR10PlusVersion())
+  m_hdr10PlusVersion = Hdr10PlusBlockVersion(edid);
 }
 
 CDisplayInfo::~CDisplayInfo() = default;
@@ -319,12 +322,26 @@ void CDisplayInfo::Parse()
             }
             case DI_CTA_DATA_BLOCK_HDR10PLUS:
             {
-              // Hades: the highest application version that a block declares (SupportsHDR10Plus())
+              // Hades: the highest application version that a block declares (SupportsHDR10Plus());
+              // the raw EDID gave it already, version 0 too (the constructor)
               const auto* hdr10Plus = di_cta_data_block_get_hdr10plus(block);
               if (hdr10Plus && hdr10Plus->version > m_hdr10PlusVersion)
                 m_hdr10PlusVersion = hdr10Plus->version;
               break;
             }
+            case DI_CTA_DATA_BLOCK_VENDOR_HDMI_FORUM:
+            {
+              // Hades: HDMI VRR (SupportsHdmiVrr())
+              const auto* hf = di_cta_data_block_get_vendor_hdmi_forum(block);
+              m_hdmiVrr |= hf && hf->scds.vrr_min_hz > 0;
+              break;
+            }
+            case DI_CTA_DATA_BLOCK_HDMI_SINK_CAP:
+            {
+              const auto* hf = di_cta_data_block_get_hdmi_sink_cap(block);
+              m_hdmiVrr |= hf && hf->scds.vrr_min_hz > 0;
+              break;
+            }
             case DI_CTA_DATA_BLOCK_VIDEO_CAP:
             {
               const auto* cap = di_cta_data_block_get_video_cap(block);
@@ -397,6 +414,13 @@ void CDisplayInfo::LogInfo() const
                                   : std::string("no"));
   }
 
+  // Hades: HDR10+ and HDMI VRR, as the output reads them
+  if (m_hdr10PlusVersion >= 0)
+    CLog::Log(LOGINFO, "[display-info] hdr10+: application version {}{}", m_hdr10PlusVersion,
+              m_hdr10PlusVersion == 0 ? " (only metadata of version 0 go out to it)" : "");
+  if (m_hdmiVrr)
+    CLog::Log(LOGINFO, "[display-info] hdmi vrr: declared");
+
   if (m_hdr_static_metadata)
   {
     CLog::Log(LOGINFO, "[display-info] supports hdr static metadata type1: {}",
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 8848a59..1df2c5d 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -123,10 +123,20 @@ public:
 
   bool SupportsDolbyVision() const { return m_dolbyVision; }
   //! Hades: HDR10+, by its vendor-specific video data block (IEEE OUI 90-84-8B) of application
-  //! version 1 or later, what the sources that send its InfoFrame require
+  //! version 1 or later, what the sources that send its InfoFrame require. This is what add-ons
+  //! are told (System.SupportedHDRTypes) and what the choice of HDR10+ sent as Dolby Vision reads:
+  //! a display of version 0 is not told as one, because almost all HDR10+ metadata are of version
+  //! 1, which it is not sent (CHDR10PlusOutput::VersionFits()). Whether it should be is the user's
+  //! decision. What may go out to the display: DeclaresHDR10Plus() and HDR10PlusVersion().
   bool SupportsHDR10Plus() const { return m_hdr10PlusVersion >= 1; }
-  //! ... the application version of that block, -1 without one
+  //! ... a block of any application version, 0 too: libdisplay-info 0.4.0 does not keep a block of
+  //! version 0 (it expects 1), so the version is read from the raw EDID (Hdr10PlusBlockVersion())
+  bool DeclaresHDR10Plus() const { return m_hdr10PlusVersion >= 0; }
+  //! ... the application version of that block, the highest of several, -1 without one
   int HDR10PlusVersion() const { return m_hdr10PlusVersion; }
+  //! Hades: the display declares HDMI VRR: a VRRmin in its HDMI Forum block (HF-VSDB or HF-SCDB),
+  //! the field NVKMS logs for HDMI VRR (nvDpyUpdateHdmiVRRCaps())
+  bool SupportsHdmiVrr() const { return m_hdmiVrr; }
   //! Dolby Vision Standard (TV-led) with the Dolby vendor InfoFrame, by the rule of the kernel
   //! backends (amdgpu, and i915/xe since linux-9965: the same one): exactly one Dolby VSVDB in
   //! valid EDID blocks, of version 2 with the Standard interface, or of version 1 in its 12-byte
@@ -237,6 +247,7 @@ private:
   const di_cta_hdr_static_metadata_block* m_hdr_static_metadata = nullptr;
   bool m_dolbyVision = false;
   int m_hdr10PlusVersion{-1}; //!< Hades: see HDR10PlusVersion()
+  bool m_hdmiVrr = false; //!< Hades: see SupportsHdmiVrr()
   DolbyVideoBlock m_dolbyVideo; //!< read from the raw EDID, see the constructor
   bool m_uhd420Only = false; //!< read from the raw EDID, see UhdLimitedToHdmi14()
   bool m_rgbQuantizationSelectable = false;
