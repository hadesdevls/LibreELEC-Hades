+double CDVDVideoCodecFFmpeg::GetDeclaredFrameRate()
+{
+  // VideoPlayer never sets it: what the decoder read from the bitstream, or nothing
+  if (!m_pCodecContext || m_pCodecContext->framerate.num <= 0 ||
+      m_pCodecContext->framerate.den <= 0)
+    return 0.0;
+  return av_q2d(m_pCodecContext->framerate);
+}
