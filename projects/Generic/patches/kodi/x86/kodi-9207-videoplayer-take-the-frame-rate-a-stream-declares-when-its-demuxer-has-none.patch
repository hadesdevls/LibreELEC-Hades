diff --git a/xbmc/cores/VideoPlayer/DeclaredFrameRate.h b/xbmc/cores/VideoPlayer/DeclaredFrameRate.h
new file mode 100644
index 0000000..b7ac8ae
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DeclaredFrameRate.h
@@ -0,0 +1,80 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cmath>
+
+/*!
+ * \brief Hades: the frame rate that a video stream declares, once the timestamps of its pictures
+ *        confirm it
+ *
+ * For a stream whose demuxer gives no frame rate (a transport stream joined live is opened without
+ * avformat_find_stream_info()), VideoPlayerVideo configures the renderer with none and measures one
+ * from the timestamps, which takes some 150 pictures: the display then changes its refresh rate
+ * several seconds into the video. The decoder knows the rate the bitstream declares (the timing of
+ * the VUI of H.264 and HEVC, the sequence header of MPEG-2), but a declaration is not always the
+ * rate: the VUI timing of H.264 and HEVC is a clock tick, which is the frame rate only when the
+ * stream says its rate is fixed (and FFmpeg does not look), a field-coded HEVC stream declares its
+ * field rate, and encoders exist that declare half or twice the rate.
+ *
+ * So the declaration is taken only when the timestamps say the same: RUN intervals in a row,
+ * between pictures in the order they are shown, each within TOLERANCE of one period of the
+ * declared rate. A variable rate, a declaration that is not the rate of the pictures, a picture
+ * without its own timestamp, or timestamps with a coarser clock (milliseconds) leave it untaken,
+ * and the rate is measured as before.
+ */
+class CDeclaredFrameRate
+{
+public:
+  static constexpr int RUN = 8;
+  static constexpr double TOLERANCE = 0.005; //!< of one period
+  static constexpr double MIN_RATE = 5.0; //!< the range VideoPlayerVideo takes from a demuxer
+  static constexpr double MAX_RATE = 120.0;
+
+  void Reset()
+  {
+    m_rate = 0.0;
+    m_lastPts = DVD_NOPTS_VALUE;
+    m_run = 0;
+  }
+
+  /*!
+   * \brief A picture in the order it is shown
+   * \param pts its own timestamp (DVD_NOPTS_VALUE when it has none), in DVD_TIME_BASE units
+   * \param declaredRate the rate the bitstream declares now, 0 when none
+   * \return the declared rate once the timestamps confirm it, else 0
+   */
+  double Add(double pts, double declaredRate)
+  {
+    if (!(declaredRate >= MIN_RATE && declaredRate <= MAX_RATE) || pts == DVD_NOPTS_VALUE)
+    {
+      Reset();
+      return 0.0;
+    }
+    if (declaredRate != m_rate)
+    {
+      m_rate = declaredRate;
+      m_run = 0;
+    }
+    const double period = DVD_TIME_BASE / declaredRate;
+    if (m_lastPts != DVD_NOPTS_VALUE && std::fabs(pts - m_lastPts - period) <= period * TOLERANCE)
+      ++m_run;
+    else
+      m_run = 0;
+    m_lastPts = pts;
+    return m_run >= RUN ? m_rate : 0.0;
+  }
+
+private:
+  double m_rate = 0.0;
+  double m_lastPts = DVD_NOPTS_VALUE;
+  int m_run = 0;
+};
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index e8aa535..40d0c4f 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -721,6 +721,11 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
   {
     bool hasTimestamp = true;
 
+    // Hades: a stream whose demuxer gave no frame rate takes the one it declares as soon as the
+    // timestamps of its pictures confirm it (each with its own timestamp, not one made up below)
+    if (m_bFpsInvalid)
+      TakeDeclaredFrameRate(m_picture.pts);
+
     m_picture.iDuration = frametime;
 
     // validate picture timing,
@@ -1057,8 +1062,30 @@ int CVideoPlayerVideo::GetVideoBitrate()
   return (int)m_videoStats.GetBitrate();
 }
 
+void CVideoPlayerVideo::TakeDeclaredFrameRate(double pts)
+{
+  // As CalcFrameRate(): videofpsdetect 0 asks for the rate of the container only. Without this,
+  // the renderer is configured with no frame rate, and the rate measured from some 150 pictures
+  // changes the refresh rate of the display a few seconds into the video.
+  if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_videoFpsDetect == 0)
+    return;
+
+  const double rate = m_declaredFrameRate.Add(pts, m_pVideoCodec->GetDeclaredFrameRate());
+  if (rate == 0.0)
+    return;
+
+  m_fFrameRate = DVD_TIME_BASE / CDVDCodecUtils::NormalizeFrameduration(DVD_TIME_BASE / rate);
+  m_bFpsInvalid = false;
+  m_processInfo.SetVideoFps(static_cast<float>(m_fFrameRate));
+  CLog::Log(LOGINFO,
+            "CVideoPlayerVideo - no frame rate from the demuxer: {:.3f} fps, which the stream "
+            "declares and the timestamps of {} pictures in a row confirm",
+            m_fFrameRate, CDeclaredFrameRate::RUN + 1);
+}
+
 void CVideoPlayerVideo::ResetFrameRateCalc()
 {
+  m_declaredFrameRate.Reset();
   m_fStableFrameRate = 0.0;
   m_iFrameRateCount = 0;
   m_iFrameRateLength = 1;
