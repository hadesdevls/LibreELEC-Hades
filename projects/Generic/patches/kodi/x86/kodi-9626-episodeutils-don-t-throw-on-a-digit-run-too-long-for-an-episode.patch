From fa80bffa3a48d13c10617e5a31534acce1cb77c5 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:02:49 +0100
Subject: [PATCH] [EpisodeUtils] Don't throw on a digit run too long for an
 episode

A file name with a long run of digits after the episode, such as a
recording timestamp (foo.S02E03_20231105123456.ts), made std::stoi throw
out_of_range. Nothing caught it below the scanner's top level, so every
scan stopped at that file. Parse the number with std::from_chars and end
the search for further episodes when it doesn't fit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7d4b977980deaad04d7ca57e8fff79ee97ca1aff)
---
 xbmc/test/TestEpisodeUtils.cpp |  1 +
 xbmc/utils/EpisodeUtils.cpp    | 10 +++++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/xbmc/test/TestEpisodeUtils.cpp b/xbmc/test/TestEpisodeUtils.cpp
index c597050..5b932b9 100644
--- a/xbmc/test/TestEpisodeUtils.cpp
+++ b/xbmc/test/TestEpisodeUtils.cpp
@@ -102,6 +102,7 @@ static const TestEntry TestData[] = {
      {{3, 1}, {3, 2}, {3, 3}, {3, 4}},
      {{1, 3}, {2, 2}, {3, 1}, {3, 4}}}, // first range invalid
     {"foo.S02E03-1080p.mkv", {{2, 3}}, {{2, 3}}}, // resolution
+    {"foo.S02E03_20231105123456.mkv", {{2, 3}}, {{2, 3}}}, // timestamp
     {"foo.S02E03-special.mkv", {{2, 3}}, {{2, 3}}}, // comment (starting with s)
     {"foo.S02E03-extended.mkv", {{2, 3}}, {{2, 3}}}, // comment (starting with e)
 };
diff --git a/xbmc/utils/EpisodeUtils.cpp b/xbmc/utils/EpisodeUtils.cpp
index 56a79ac..f583be3 100644
--- a/xbmc/utils/EpisodeUtils.cpp
+++ b/xbmc/utils/EpisodeUtils.cpp
@@ -21,6 +21,7 @@
 #include "utils/log.h"
 
 #include <cctype>
+#include <charconv>
 #include <iterator>
 #include <map>
 #include <memory>
@@ -355,7 +356,14 @@ bool CEpisodeUtils::EnumerateEpisodeItem(const CFileItem* item,
                  (reg2Position >= 0 && regPosition == -1))
         {
           const std::string result{multiPartRegex->GetMatch(2)};
-          const int last{std::stoi(result)};
+          int last{0};
+          // A run of digits too long for an episode number (eg. a timestamp) ends the search
+          if (std::from_chars(result.data(), result.data() + result.size(), last).ec != std::errc{})
+          {
+            CLog::LogF(LOGDEBUG, "VideoInfoScanner: '{}' is not an episode number - ignoring",
+                       result);
+            break;
+          }
           const std::string prefix{
               offset < remainder.length()
                   ? StringUtils::ToLower(std::string_view(remainder).substr(offset, 2))
-- 
2.53.0

