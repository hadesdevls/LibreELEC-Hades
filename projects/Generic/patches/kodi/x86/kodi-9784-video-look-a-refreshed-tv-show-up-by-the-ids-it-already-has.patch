From fab5efa5592f2e5cfed3c2a0c83b0b62e1328f6d Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 28 Oct 2026 14:26:03 +0000
Subject: [PATCH] [Video] Look a refreshed tv show up by the ids it already
 has.

A refresh with nobody to choose from what a search finds, such as a
refresh of a whole source, searched for a tv show by its folder's name.
A show the search couldn't find, as when the name lacks a colon of the
title, wasn't refreshed, and one it found as another show came back as
that show.

Such a refresh now looks a show up with a python scraper by the ids it
already has, as it does a movie, and is searched for as before if the
scraper can't. A show is removed before it is added again, so its
details are now read first, as a movie's are. A show they can't be read
for is left as it is, as is one the search finds with ids that
contradict its own.

A show's ids likewise come before an identifier in its folder name. Its
override nfo or embedded title gives only some of its details, so they
are looked up first too, as a movie's are, rather than the show and its
episodes being removed and then lost when the scraper can't give them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.cpp               | 18 +++++---
 xbmc/video/VideoInfoScanner.h                 | 12 +++---
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 24 +++++++----
 xbmc/video/test/TestVideoInfoScanner.cpp      | 42 +++++++++++++++++++
 4 files changed, 74 insertions(+), 22 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 9606c30..50746f5 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -1092,10 +1092,16 @@ CVideoInfoScanner::~CVideoInfoScanner()
     std::string identifierType;
     std::string identifier;
     long lResult = -1;
-    if (info2->IsPython() &&
-        CFilenameAttributes(movieTitle, &m_regexpCache).GetIdentifier(identifierType, identifier))
+    ADDON::CScraper::UniqueIDs uniqueIDs;
+    // The ids a refresh looks the show up by are those it has, which an identifier in its name
+    // may contradict, and are those its details were already read by
+    if (info2->IsPython() && !m_uniqueIDs.empty() && !(pURL && pURL->HasUrls()))
+      uniqueIDs = m_uniqueIDs;
+    else if (info2->IsPython() && CFilenameAttributes(movieTitle, &m_regexpCache)
+                                      .GetIdentifier(identifierType, identifier))
+      uniqueIDs = {{identifierType, identifier}};
+    if (!uniqueIDs.empty())
     {
-      const ADDON::CScraper::UniqueIDs uniqueIDs{{identifierType, identifier}};
       if (GetDetails(pItem, uniqueIDs, url, info2,
                      (result == InfoType::COMBINED || result == InfoType::OVERRIDE) ? loader.get()
                                                                                     : nullptr,
@@ -1665,7 +1671,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
     std::string identifier;
     // The ids a refresh looks the movie up by come first: an identifier in the file name may name
     // another film, and the ids are those its details were already read by
-    if (info2->IsPython() && m_movieUniqueIDs.empty() &&
+    if (info2->IsPython() && m_uniqueIDs.empty() &&
         filenameAttributes.GetIdentifier(identifierType, identifier))
     {
       const ADDON::CScraper::UniqueIDs uniqueIDs{{identifierType, identifier}};
@@ -1676,8 +1682,8 @@ CVideoInfoScanner::~CVideoInfoScanner()
         return HandleMovieSetAndVersions();
     }
 
-    if (info2->IsPython() && !m_movieUniqueIDs.empty() && !(pURL && pURL->HasUrls()) &&
-        GetDetails(pItem, m_movieUniqueIDs, url, info2,
+    if (info2->IsPython() && !m_uniqueIDs.empty() && !(pURL && pURL->HasUrls()) &&
+        GetDetails(pItem, m_uniqueIDs, url, info2,
                    (result == InfoType::COMBINED || result == InfoType::OVERRIDE) ? loader.get()
                                                                                   : nullptr,
                    pDlgProgress))
diff --git a/xbmc/video/VideoInfoScanner.h b/xbmc/video/VideoInfoScanner.h
index 612fc9b..f7c8594 100644
--- a/xbmc/video/VideoInfoScanner.h
+++ b/xbmc/video/VideoInfoScanner.h
@@ -132,12 +132,10 @@ namespace KODI::VIDEO
       m_scraperCache.insert(scrapers.begin(), scrapers.end());
     }
 
-    /*! \brief Look the movies up by these ids with a python scraper, rather than search for them.
+    /*! \brief Look the movies or tv shows up by these ids with a python scraper, rather than search
+     for them.
      */
-    void LookUpMoviesBy(const ADDON::CScraper::UniqueIDs& uniqueIDs)
-    {
-      m_movieUniqueIDs = uniqueIDs;
-    }
+    void LookUpBy(const ADDON::CScraper::UniqueIDs& uniqueIDs) { m_uniqueIDs = uniqueIDs; }
 
     static bool DownloadFailed(CGUIDialogProgress* pDlgProgress);
 
@@ -361,8 +359,8 @@ namespace KODI::VIDEO
     SimilarVideoScanAction m_similarVideoAction{SimilarVideoScanAction::NONE};
     bool m_ignoreVideoExtras{false};
 
-    //! The ids RetrieveVideoInfo() looks movies up by, where it would otherwise search
-    ADDON::CScraper::UniqueIDs m_movieUniqueIDs;
+    //! The ids RetrieveVideoInfo() looks movies and tv shows up by, where it would otherwise search
+    ADDON::CScraper::UniqueIDs m_uniqueIDs;
 
     //! Whether the folder a movie is in names it (the scraper's "movies are in separate folders")
     bool m_useFolderNames{false};
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index 05969da..bf1914a 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -210,6 +210,12 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
   // copy the scraper in case we need it again
   ScraperPtr originalScraper(scraper);
 
+  // a tv show, rather than one of its seasons or episodes, is refreshed as a movie is: removed and
+  // added again
+  const bool isTvShow{scraper->Content() == ADDON::ContentType::TVSHOWS &&
+                      m_item->HasVideoInfoTag() &&
+                      m_item->GetVideoInfoTag()->m_type == MediaTypeTvShow};
+
   // get the item's correct title
   std::string itemTitle = m_searchTitle;
   if (itemTitle.empty())
@@ -287,9 +293,9 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       // if there's no NFO remember it in case we have to refresh again
       if (nfoResult == CInfoScanner::InfoType::ERROR_NFO)
         ignoreNfo = true;
-      // a movie's embedded title or override nfo still needs its details looked up
+      // a movie's or tv show's embedded title or override nfo still needs its details looked up
       else if (nfoResult != CInfoScanner::InfoType::NONE &&
-               (scraper->Content() != ADDON::ContentType::MOVIES ||
+               ((scraper->Content() != ADDON::ContentType::MOVIES && !isTvShow) ||
                 (nfoResult != CInfoScanner::InfoType::TITLE &&
                  nfoResult != CInfoScanner::InfoType::OVERRIDE)))
         hasDetails = true;
@@ -321,11 +327,11 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     if (scraper->Content() == ADDON::ContentType::TVSHOWS && !m_item->IsFolder())
       hasDetails = true;
 
-    // Without anyone to choose from what a search finds, a movie is looked up by the ids it already
-    // has, as a search by its title may find another
+    // Without anyone to choose from what a search finds, a movie or tv show is looked up by the ids
+    // it already has, as a search by its title may find another or nothing
     CScraper::UniqueIDs uniqueIDs;
     if (lookUpByIds && !hasDetails && !IsModal() && m_searchTitle.empty() && scraper->IsPython() &&
-        scraper->Content() == ADDON::ContentType::MOVIES && m_item->HasVideoInfoTag())
+        (scraper->Content() == ADDON::ContentType::MOVIES || isTvShow) && m_item->HasVideoInfoTag())
     {
       for (const auto& [type, value] : m_item->GetVideoInfoTag()->GetUniqueIDs())
       {
@@ -458,9 +464,9 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       break;
     }
 
-    // A movie is removed before it is added again, so its details are read first. One the scraper
-    // can't give them for, as when its site doesn't answer, is left as it is.
-    if (scraper->Content() == ADDON::ContentType::MOVIES &&
+    // A movie or tv show is removed before it is added again, so its details are read first. One the
+    // scraper can't give them for, as when its site doesn't answer, is left as it is.
+    if ((scraper->Content() == ADDON::ContentType::MOVIES || isTvShow) &&
         (scraperUrl.HasUrls() || !uniqueIDs.empty()))
     {
       // the search closed a modal progress dialog, and the download pumps the GUI through it
@@ -672,7 +678,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     // finally download the information for the item
     VIDEO::CVideoInfoScanner scanner;
     scanner.UseScrapers(scrapers);
-    scanner.LookUpMoviesBy(uniqueIDs);
+    scanner.LookUpBy(uniqueIDs);
     if (!scanner.RetrieveVideoInfo(items, scanSettings.parent_name,
                                    scraper->Content(), !ignoreNfo,
                                    scraperUrl.HasUrls() ? &scraperUrl : nullptr,
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 73baa7b..f01c72e 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -1301,6 +1301,35 @@ protected:
     m_textureCache = true;
   }
 
+  //! A refresh of a show with all its episodes removes it before adding it again, so one whose
+  //! details can't be read is kept. The show has no nfo, or one that overrides some of the
+  //! details it is looked up for.
+  void RefreshThatCantReadTheDetails(bool overrideNfo)
+  {
+    UseTestScraper(ADDON::AddonType::SCRAPER_TVSHOWS);
+    InstallTestScraper();
+    Found("Show");
+    Details("Show", "<details><title>Show</title></details>");
+    const std::string show{Folder(m_root, "Show")};
+    const std::string episode{Episode(Folder(show, "Season 1"), "Show S01E01.mkv")};
+    Scan();
+    const int idShow{m_db.GetSingleValueInt("SELECT idShow FROM tvshow")};
+    ASSERT_GT(idShow, 0);
+    ASSERT_GT(m_db.GetEpisodeId(episode, 1, 1), 0);
+
+    if (overrideNfo)
+      File(show, "tvshow.nfo", R"(<tvshow override="true"><title>Show</title></tvshow>)");
+    DetailsFail("Show");
+    CVideoInfoTag tag;
+    ASSERT_TRUE(m_db.GetTvShowInfo({}, tag, idShow));
+    TestRefreshingJob refresh{std::make_shared<CFileItem>(tag), true, true};
+    refresh.Work(m_db);
+
+    EXPECT_EQ(idShow, m_db.GetSingleValueInt("SELECT idShow FROM tvshow"));
+    EXPECT_EQ(1, CountShows());
+    EXPECT_GT(m_db.GetEpisodeId(episode, 1, 1), 0);
+  }
+
   int CountShows() { return m_db.GetSingleValueInt("SELECT COUNT(*) FROM tvshow"); }
   int CountEpisodes() { return m_db.GetSingleValueInt("SELECT COUNT(*) FROM episode"); }
 
@@ -1434,6 +1463,19 @@ TEST_F(TestVideoInfoScannerTvShows, AShowWhoseDetailsFailedIsLookedUpAgain)
   EXPECT_GT(m_db.GetEpisodeId(episode, 1, 1), 0);
 }
 
+// A refresh of a show with all its episodes removes it before adding it again, so one whose
+// details can't be read is kept
+TEST_F(TestVideoInfoScannerTvShows, ARefreshThatCantReadTheDetailsKeepsTheShow)
+{
+  RefreshThatCantReadTheDetails(false);
+}
+
+// An override nfo gives some of the details, and the rest are still looked up
+TEST_F(TestVideoInfoScannerTvShows, ARefreshWithAnOverrideNfoThatCantReadTheDetailsKeepsTheShow)
+{
+  RefreshThatCantReadTheDetails(true);
+}
+
 TEST_F(TestVideoInfoScannerTvShows, AnEpisodeWithAnNfoIsAddedWhenTheEpisodeGuideFails)
 {
   UseTestScraper(ADDON::AddonType::SCRAPER_TVSHOWS);
-- 
