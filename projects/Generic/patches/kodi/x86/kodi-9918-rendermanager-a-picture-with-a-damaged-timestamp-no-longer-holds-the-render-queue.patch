From 37b4348b2e7133a33d89842a4b734ae60e5d037a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:18:24 +0000
Subject: [PATCH] RenderManager: a picture with a damaged timestamp no longer
 holds the render queue

A corrupt PTS far ahead (a damaged recording or download) reaches the render
queue as it comes: FFmpeg's decoder, which VAAPI decoding also goes through,
hands the picture on with that time (measured: one PTS moved 100 s ahead comes
out with it, and the pictures after it with their own). The queue is presented
in order, its first picture when the clock reaches it, so that one picture held
every picture queued behind it: the decoder ran out of buffers ("timeout waiting
for buffer" again and again) and playback stopped until the clock got there.

The queue is in the order the pictures were decoded, which is the order they
are shown in. A picture timed later than one queued after it that is already
due is out of that order: it now goes, with a warning in kodi.log, and the
queue goes on (RenderQueueOrder.h, pure). Not while the clock runs backwards,
with a forced next picture, or for a picture without a time; a queue in order
is never touched.

Tested on the host: the rule in 12 cases, and a model of the queue fed with
the pictures FFmpeg's decoder gives for a stream with one PTS 100 s ahead:
without it 155 of 288 pictures and 6.5 s without a new one, with it 287 and
the damaged one left out; a clean stream and one with a key picture sent again
play the same with and without it.

Idea of pannal's CoreELEC builds (p3i T4c), which recover from such a picture
with a seek; here none is needed.
---
 .../VideoPlayer/VideoRenderers/CMakeLists.txt |  1 +
 .../VideoRenderers/RenderManager.cpp          | 23 ++++++++
 .../VideoRenderers/RenderQueueOrder.h         | 52 +++++++++++++++++++
 3 files changed, 76 insertions(+)
 create mode 100644 xbmc/cores/VideoPlayer/VideoRenderers/RenderQueueOrder.h

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/CMakeLists.txt b/xbmc/cores/VideoPlayer/VideoRenderers/CMakeLists.txt
index 2280ef5..2df49fd 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/CMakeLists.txt
@@ -14,6 +14,7 @@ set(HEADERS BaseRenderer.h
             OverlayRendererUtil.h
             RenderFactory.h
             RenderFlags.h
+            RenderQueueOrder.h
             RenderInfo.h
             RenderManager.h
             DebugRenderer.h)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 473a568..b32b0f6 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -13,6 +13,7 @@
 #include "FileModeChoice.h"
 #include "RenderFactory.h"
 #include "RenderFlags.h"
+#include "RenderQueueOrder.h"
 #include "ServiceBroker.h"
 #include "application/Application.h"
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
@@ -32,6 +33,7 @@
 
 #include <memory>
 #include <mutex>
+#include <vector>
 #ifdef HAVE_DVBRIDGE
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "windowing/gbm/WinSystemGbmGLESContext.h"
@@ -1351,6 +1353,27 @@ void CRenderManager::PrepareNextRender()
   if (!isPaused)
     renderPts += m_displayLatency;
 
+  // Hades: a picture timed later than one queued after it that is already due (a damaged
+  // timestamp far ahead) would hold the whole queue until the clock reached it: it goes
+  // (RenderQueueOrder.h). Not in reverse, where the queue runs backwards.
+  if (!m_forceNext && m_dvdClock.GetClockSpeed() > 0 && m_queued.size() > 1)
+  {
+    std::vector<double> queuedPts;
+    queuedPts.reserve(m_queued.size());
+    for (const int idx : m_queued)
+      queuedPts.push_back(m_Queue[idx].pts);
+    for (size_t drop = KODI::RENDERQUEUE::OutOfOrderHead(queuedPts, renderPts); drop > 0; --drop)
+    {
+      CLog::Log(LOGWARNING,
+                "CRenderManager::PrepareNextRender - a picture timed {:.3f} s, later than the ones "
+                "queued behind it that are due at {:.3f} s (a damaged timestamp), is left out",
+                m_Queue[m_queued.front()].pts / DVD_TIME_BASE, renderPts / DVD_TIME_BASE);
+      m_discard.push_back(m_queued.front());
+      m_queued.pop_front();
+      m_QueueSkip++;
+    }
+  }
+
   const double nextFramePts =
       m_dvdClock.GetClockSpeed() < 0 ? renderPts : m_Queue[m_queued.front()].pts;
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderQueueOrder.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderQueueOrder.h
new file mode 100644
index 0000000..1b454a2
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderQueueOrder.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: a picture whose timestamp was damaged, far ahead of the pictures around it (a corrupt PTS
+// in a damaged recording or download: FFmpeg's decoder hands it on as it comes), reaches the render
+// queue in its place. The queue is presented in order, its first picture when the clock reaches it:
+// that one picture holds every picture queued behind it, and so the decoding and the playback, until
+// the clock reaches its time, seconds or minutes later. The queue is in the order the pictures were
+// decoded, which is the order they are shown in; a picture timed later than one queued after it is
+// out of that order. Once a picture after it is due, it goes.
+// After pannal's build of CoreELEC (p3i T4c), which recovers from such a picture by seeking. Pure,
+// for the tests.
+
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cstddef>
+#include <vector>
+
+namespace KODI::RENDERQUEUE
+{
+
+/*!
+ * \brief How many pictures at the head of the render queue are left out before one is presented.
+ * \param queuedPts The times of the queued pictures, in the queue's order
+ * \param renderPts The time the picture presented now is for
+ * \return The pictures at the head that are timed later than the last queued picture that is due
+ *         (none while no picture after the first is due, or the first is)
+ */
+inline size_t OutOfOrderHead(const std::vector<double>& queuedPts, double renderPts)
+{
+  if (queuedPts.size() < 2 || queuedPts[0] == DVD_NOPTS_VALUE || renderPts >= queuedPts[0])
+    return 0;
+  size_t due = 0;
+  for (size_t i = 1; i < queuedPts.size(); ++i)
+    if (queuedPts[i] != DVD_NOPTS_VALUE && renderPts >= queuedPts[i])
+      due = i;
+  if (due == 0)
+    return 0;
+  size_t drop = 0;
+  while (drop < due && queuedPts[drop] != DVD_NOPTS_VALUE && queuedPts[drop] > queuedPts[due])
+    ++drop;
+  return drop;
+}
+
+} // namespace KODI::RENDERQUEUE
