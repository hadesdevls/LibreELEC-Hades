From dc6b7960051c3928de8a2956761ed9ec46c57ed9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:33:48 +0000
Subject: [PATCH] videoplayer: say it when the source of a file stops
 delivering data

When nothing could be read of a file for 20 s the demuxer returns null and
the player writes "eof reading from demuxer", as if the file had ended. With
a drive or a driver that answers with zeros instead of an error (issue #21)
nothing else was written, so the log of a video that ended two minutes in
looked like a file that ended there.

The demuxer now writes one line, at error level, when the read was ended by
that 20 s and not by Abort() or by a cancel check: the file, the byte the read
was at, the length of the input, and that this is not the end of the file.
Playback behaves as before.
---
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp | 18 ++++++++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h   |  2 ++
 2 files changed, 20 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 8b9dc1d..3bdb637 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1960,6 +1960,20 @@ void CDVDDemuxFFmpeg::ConvertBlurayTimestamps(DemuxPacket* packet, const AVStrea
 }
 #endif
 
+void CDVDDemuxFFmpeg::LogReadTimeout() const
+{
+  // the position libavformat has read up to, as it is kept (avio_tell() could call the seek of the
+  // input), and the length of the input: a position far from the end is not an end of the file
+  const int64_t position =
+      m_pFormatContext && m_pFormatContext->pb ? m_pFormatContext->pb->pos : -1;
+  CLog::Log(LOGERROR,
+            "CDVDDemuxFFmpeg: no packet could be read from {} within 20 s, with the read at byte "
+            "{} of {}: the source stopped delivering data, this is not the end of the file; the "
+            "player will take it for the end of the stream",
+            CURL::GetRedacted(m_pInput ? m_pInput->GetFileName() : std::string()), position,
+            m_pInput ? m_pInput->GetLength() : -1);
+}
+
 DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
 {
   DemuxPacket* pPacket = NULL;
@@ -1984,6 +1998,10 @@ DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
         // timeout reads after 100ms
         m_timeout.Set(20s);
         m_pkt.result = ReadFrame(&m_pkt.pkt);
+        // Hades: the 20 s ended the read, nobody asked for it (Abort(), SetCancelCheck())
+        if (m_pkt.result == AVERROR_EXIT && !m_abortRequested && m_timeout.IsTimePast() &&
+            !(m_cancelCheck && m_cancelCheck()))
+          LogReadTimeout();
         m_timeout.SetInfinite();
 #ifdef HAVE_DVBRIDGE
         m_dvLayerChecked = false;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 91fb47b..a98c3b6 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -295,6 +295,8 @@ protected:
 
   //! \brief av_read_frame(), with the two tracks of a Dolby Vision stream joined
   int ReadFrame(AVPacket* packet);
+  //! Hades: says that the source of the file stopped delivering data (ReadInternal())
+  void LogReadTimeout() const;
 #ifdef HAVE_DVBRIDGE
   // Dolby Vision in two video tracks (see CDVLayerMerge): the streams of the two layers, or -1
   int m_dvBaseIndex = -1;
-- 
