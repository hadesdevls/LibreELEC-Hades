+bool CDVBridgeGLES::SetTunnel(bool on)
+{
+  const bool was = m_tunnelOn;
+  m_tunnelOn = on;
+  bool taken = true;
+  if (m_renderer)
+    taken = dvbridge_render_set_tunnel(m_renderer, on);
+  if (!taken)
+    m_tunnelOn = false;
+  if (m_tunnelOn != was)
+  {
+    m_tunnelDrawn = 0;
+    CLog::Log(LOGINFO, "DVBridge: native output {}",
+              m_tunnelOn ? "carries HDR over the tunnel (YCbCr 4:2:2 at 12 bits in the RGB 8 bpc "
+                           "transport, no Dolby Vision)"
+                         : "no longer carries HDR over the tunnel");
+  }
+  return taken;
+}
+
+bool CDVBridgeGLES::PrepareTunnel(const Layer& base, const dvbridge_plain& plain, dvbridge_view view)
+{
+  m_prepared = m_packed = false;
+  m_direct = false;
+  m_pendingInfo = 0;
+  m_pendingDetail = {};
+  if (!m_renderer || !m_tunnelOn)
+    return Fail("renderer-or-tunnel-missing");
+  const CKeptGLState kept;
+  TakeStaleGLErrors("a picture of HDR over the tunnel is drawn");
+  dvbridge_gl_frame bl{};
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
+    return Fail("tunnel-picture-import");
+  // (the raster of the output: the bridge refuses any other size)
+  const bool drawn = dvbridge_render_plain(m_renderer, &bl.frame, &plain, view, 3840, 2160);
+  LogNotes();
+  dvbridge_gl_frame_release(&bl);
+  if (!drawn)
+  {
+    LogWhy(NOT_DRAWN, dvbridge_render_not_drawn(m_renderer));
+    dvbridge_renderer_recover(m_renderer);
+    return Fail("tunnel-picture-drawing");
+  }
+  m_prepared = true;
+  if (!m_tunnelDrawn++)
+    CLog::Log(LOGINFO,
+              "DVBridge: an {} picture drawn as it is for the tunnel: {}x{} into {}x{} of the 3840x2160 "
+              "raster, its mastering display {} to {} cd/m2, its light {} (largest) and {} (average) "
+              "cd/m2 (0: not known); packed as YCbCr 4:2:2 at 12 bits with no metadata in the pixels",
+              plain.hlg ? "HLG" : "HDR10", base.width, base.height, view.dst_width, view.dst_height,
+              plain.min_luma, plain.max_luma, plain.max_cll, plain.max_fall);
+  if (m_failures.Count())
+    m_failures.Reset();
+  return true;
+}
