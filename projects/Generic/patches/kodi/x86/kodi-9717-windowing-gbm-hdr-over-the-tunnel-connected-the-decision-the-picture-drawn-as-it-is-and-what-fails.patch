+void CWinSystemGbm::DisplayTunnelFacts(bool hlg, bool& ycbcr422, bool& hdr) const
+{
+  ycbcr422 = hdr = false;
+  const auto info = DVDisplayInfo();
+  if (!info)
+    return;
+  ycbcr422 = info->SupportsYCbCr422();
+  hdr = info->SupportsHDRStaticMetadataType1() &&
+        info->SupportsEOTF(hlg ? KODI::UTILS::Eotf::HLG : KODI::UTILS::Eotf::PQ);
+}
+
+void CWinSystemGbm::DisableHdr10Tunnel(const char* reason, const char* code)
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const std::vector<std::string> refused = drm ? drm->DVRefused() : std::vector<std::string>{};
+  if (m_hdr10TunnelDisabled.exchange(true))
+    return;
+  CLog::Log(LOGERROR,
+            "DVBridge: HDR over the tunnel is turned off: {}{}{}; the video continues on the ordinary "
+            "output, and it is not tried again until the display changes (Dolby Vision is not "
+            "affected)",
+            reason,
+            refused.empty() ? std::string()
+                            : " (the driver refused it for: " + DVBRIDGE::REFUSED::Join(refused) +
+                                  "; the kernel log says what it found)",
+            code ? std::string(" [") + code + "]" : std::string());
+}
+
 void CWinSystemGbm::DisableNativeDVOutput(const char* reason, const char* code)
 {
+  // Hades: the output that failed is that of HDR over the tunnel: that is what is turned off
+  if (Hdr10TunnelOwnsOutput())
+  {
+    DisableHdr10Tunnel(reason, code);
+    return;
+  }
   // Hades: what the driver said of the refusals of this native output (DVBRIDGE_REFUSED), for the
   // player information and the log: the refusals since the output was captured for it, or since
   // a commit of it was last accepted
@@ -1883,6 +1917,9 @@ bool CWinSystemGbm::DVNewVideo()
   }
   if (!changed)
     return another;
+  // Hades: and a tunnel for HDR that failed on the display before is tried again with the new one
+  if (m_hdr10TunnelDisabled.exchange(false))
+    CLog::Log(LOGINFO, "DVBridge: HDR over the tunnel is tried again, after the display changed");
   std::unique_lock lock(m_dvRetryLock);
   m_dvRetryBackoff = 0;
   m_dvRetryWait = 0;
