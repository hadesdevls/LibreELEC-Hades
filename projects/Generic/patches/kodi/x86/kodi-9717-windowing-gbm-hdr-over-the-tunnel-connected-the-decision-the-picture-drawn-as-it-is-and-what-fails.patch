+bool CWinSystemGbmGLESContext::Hdr10TunnelOwnsOutput() const
+{
+  return m_dvState.CapturedHdr10Tunnel();
+}
+
+// Hades: what the ordinary output sends of HDR10 in a mode, asked once for each mode with a TEST_ONLY commit of
+// what a video of HDR10 would set (as ProbeHdr10DepthAhead() does for its depth): the answer of the driver
+// (DVBRIDGE_LINK_FORMAT) as the link that HDR10Tunnel.h knows, or "not known" (a "no": fail closed)
+int CWinSystemGbmGLESContext::Hdr10TunnelOrdinaryLink(const drmModeModeInfo& mode)
+{
+  namespace T = KODI::WINDOWING::GBM::HDR10_TUNNEL;
+  const uint64_t key = (static_cast<uint64_t>(mode.hdisplay) << 48) ^
+                       (static_cast<uint64_t>(mode.vdisplay) << 36) ^
+                       (static_cast<uint64_t>(mode.clock) << 12) ^ mode.htotal ^
+                       (static_cast<uint64_t>(mode.vtotal) << 24) ^ 1;
+  std::unique_lock lock(m_hdr10TunnelLock);
+  if (m_hdr10TunnelLinkKey == key)
+    return m_hdr10TunnelLink;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  const char* const guard = "DVBRIDGE_HDR10_DEEP_COLOR";
+  // (the mode must be the one on the output, and the output must not be one that native output has
+  // captured: the answer is that of the ordinary configuration. Not asked then: the verdict stays "not
+  // known" and is asked again with the next picture.)
+  if (!connector || !drm->SelectedModeOnOutput() || m_dvState.Captured() ||
+      !connector->SupportsProperty(guard) ||
+      !connector->SupportsProperty(DVBRIDGE::LINK::PROPERTY) ||
+      !connector->SupportsProperty("HDR_OUTPUT_METADATA") || !connector->SupportsProperty("Colorspace"))
+    return static_cast<int>(T::Link::UNKNOWN);
+  hdr_output_metadata metadata{};
+  metadata.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  metadata.hdmi_metadata_type1.eotf = static_cast<uint8_t>(KODI::UTILS::Eotf::PQ);
+  metadata.hdmi_metadata_type1.metadata_type = KODI::UTILS::HDMI_STATIC_METADATA_TYPE1;
+  const uint16_t primaries[3][2] = {{35400, 14600}, {8500, 39850}, {6550, 2300}};
+  for (int i = 0; i < 3; i++)
+  {
+    metadata.hdmi_metadata_type1.display_primaries[i].x = primaries[i][0];
+    metadata.hdmi_metadata_type1.display_primaries[i].y = primaries[i][1];
+  }
+  metadata.hdmi_metadata_type1.white_point.x = 15635;
+  metadata.hdmi_metadata_type1.white_point.y = 16450;
+  metadata.hdmi_metadata_type1.max_display_mastering_luminance = 1000;
+  metadata.hdmi_metadata_type1.min_display_mastering_luminance = 50;
+  metadata.hdmi_metadata_type1.max_cll = 1000;
+  metadata.hdmi_metadata_type1.max_fall = 400;
+  CDRMPropertyBlob blob(drm->GetFileDescriptor(), &metadata, sizeof(metadata));
+  const auto colorspace = connector->GetPropertyEnumValue("Colorspace", "BT2020_RGB");
+  std::string where = StringUtils::Format(
+      "{}x{} @ {:.3f} Hz", mode.hdisplay, mode.vdisplay,
+      mode.htotal && mode.vtotal
+          ? mode.clock * 1000.0 / (static_cast<double>(mode.htotal) * mode.vtotal)
+          : 0.0);
+  int answer = static_cast<int>(T::Link::UNKNOWN);
+  if (blob.IsValid() && colorspace)
+  {
+    std::vector<std::pair<const char*, uint64_t>> properties{
+        {"HDR_OUTPUT_METADATA", blob.Get()}, {"Colorspace", *colorspace}, {guard, 1}};
+    // (the rule of the driver for HDR in YCbCr 4:2:0: "deep", its default, the way HDR10 goes out
+    // unless the user chose otherwise, which Hdr10TunnelWanted() steps aside for)
+    if (connector->SupportsProperty(DVBRIDGE::LINK::HDR_YCBCR420))
+      if (const auto value = connector->GetPropertyEnumValue(DVBRIDGE::LINK::HDR_YCBCR420, "deep"))
+        properties.emplace_back(DVBRIDGE::LINK::HDR_YCBCR420, *value);
+    const auto test = drm->TestConnectorProperties(properties);
+    DVBRIDGE::LINK::Format link;
+    if (test != CDRMAtomic::PropertyTest::UNSUPPORTED)
+      if (const auto value = connector->ReadPropertyValue(DVBRIDGE::LINK::PROPERTY); value && *value)
+        link = DVBRIDGE::LINK::Parse(
+            connector->GetPropertyBitmaskNames(DVBRIDGE::LINK::PROPERTY, *value));
+    const auto refused =
+        test == CDRMAtomic::PropertyTest::REFUSED ? drm->ReadRefused() : std::vector<std::string>{};
+    const bool shallow = DVBRIDGE::REFUSED::Has(refused, DVBRIDGE::REFUSED::HDR10_DEPTH);
+    if (link.Known() && (test == CDRMAtomic::PropertyTest::ACCEPTED || shallow))
+      answer = static_cast<int>(T::LinkOf(link.format, link.bpc));
+    CLog::Log(LOGINFO,
+              "HDR over the tunnel: HDR10 in {} would go out as {}{}, as the driver answers a TEST_ONLY "
+              "commit of it",
+              where,
+              link.Known() ? DVBRIDGE::LINK::DisplayName(link.format) + " at " +
+                                 std::to_string(link.bpc) + " bits"
+                           : std::string("a format that the driver does not say"),
+              answer == static_cast<int>(T::Link::UNKNOWN) ? " (not known to the rule: no tunnel)"
+                                                            : "");
+  }
+  m_hdr10TunnelLinkKey = key;
+  m_hdr10TunnelLink = answer;
+  return answer;
+}
+
+bool CWinSystemGbmGLESContext::Hdr10TunnelWanted(const VideoPicture& picture)
+{
+  namespace T = KODI::WINDOWING::GBM::HDR10_TUNNEL;
+  // (asked for every picture that configures: an SDR picture, and one of Dolby Vision, which goes its own
+  // ways, are no business of this, and cost nothing here)
+  if ((picture.color_transfer != AVCOL_TRC_SMPTE2084 && picture.color_transfer != AVCOL_TRC_ARIB_STD_B67) ||
+      picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+    return false;
+  const auto settings = SettingsNow();
+  T::Input in;
+  in.setting = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESHDR10TUNNEL, true);
+  in.disabled = Hdr10TunnelDisabled();
+  // (a choice of the user's for this output is theirs: the colour format, RGB at 8 bits for HDR, the HDR10
+  // picture adapted to the display; the tunnel carries the picture as it is)
+  in.formatChosen =
+      (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESCOLORFORMAT) &&
+       settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESCOLORFORMAT) != 0) ||
+      (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDR420) &&
+       settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESHDR420) == 1) ||
+      (picture.hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION && Hdr10AdaptWanted(picture));
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  const drmModeModeInfo* mode = drm ? drm->GetSelectedMode() : nullptr;
+  if (connector)
+  {
+    in.kernelBackend = CDVBridgeState::GetBackend(*connector) == CDVBridgeState::Backend::KERNEL;
+    in.hasProperty = CDVBridgeState::SupportsHdr10Tunnel(*connector);
+    in.hdmiTmds = connector->GetType().rfind("HDMI", 0) == 0;
+  }
+  const bool pq = picture.color_transfer == AVCOL_TRC_SMPTE2084;
+  const bool hlg = picture.color_transfer == AVCOL_TRC_ARIB_STD_B67;
+  DisplayTunnelFacts(hlg, in.displayYcbcr422, in.displayHdr);
+  const bool dolbyVision = picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION;
+  in.hdrPicture = T::IsHdrPicture(pq, hlg, dolbyVision);
+  in.pictureTaken =
+      T::PictureTaken(pq, hlg, picture.color_primaries == AVCOL_PRI_BT2020,
+                      picture.color_space == AVCOL_SPC_BT2020_NCL,
+                      (picture.iFlags & DVP_FLAG_INTERLACED) != 0, !picture.stereoMode.empty());
+  in.nativeDolbyVision = PictureEligible(&picture, false);
+  if (mode)
+  {
+    in.width = mode->hdisplay;
+    in.height = mode->vdisplay;
+    in.refresh = mode->htotal && mode->vtotal
+                     ? mode->clock * 1000.0 / (static_cast<double>(mode->htotal) * mode->vtotal)
+                     : 0.0;
+  }
+  // (what the ordinary output sends is asked only where every other condition holds: a TEST_ONLY commit
+  // for a video that cannot go over the tunnel anyway is no use)
+  T::Input without = in;
+  without.ordinary = T::Link::RGB8;
+  T::Why why = T::Decide(without);
+  if (why == T::Why::USE && mode)
+  {
+    in.ordinary = static_cast<T::Link>(Hdr10TunnelOrdinaryLink(*mode));
+    why = T::Decide(in);
+  }
+  // Hades: told when it changes (the picture is asked about often: for every frame that configures)
+  const uint64_t key = mode ? (static_cast<uint64_t>(mode->hdisplay) << 40) ^
+                                  (static_cast<uint64_t>(mode->vdisplay) << 20) ^ mode->clock
+                            : 0;
+  {
+    std::unique_lock lock(m_hdr10TunnelLock);
+    if (m_hdr10TunnelToldWhy != static_cast<int>(why) || m_hdr10TunnelToldKey != key)
+    {
+      m_hdr10TunnelToldWhy = static_cast<int>(why);
+      m_hdr10TunnelToldKey = key;
+      if (why == T::Why::USE)
+        CLog::Log(LOGINFO,
+                  "HDR over the tunnel: used for this {} video in {}x{} @ {:.3f} Hz: the display takes "
+                  "YCbCr 4:2:2, and the ordinary output would send {}",
+                  hlg ? "HLG" : "HDR10", in.width, in.height, in.refresh,
+                  in.ordinary == T::Link::RGB8 ? "RGB at 8 bits" : "YCbCr 4:2:0");
+      else if (why != T::Why::SETTING)
+        CLog::Log(LOGINFO, "HDR over the tunnel: not used for this video ({}): the ordinary output as before",
+                  T::Code(why));
+    }
+  }
+  return why == T::Why::USE;
+}
+
+int CWinSystemGbmGLESContext::RenderHdr10Tunnel(const CDVBridgeGLES::Layer& layer,
+                                                const dvbridge_plain& plain,
+                                                const CRect& source,
+                                                const CRect& dest)
+{
+  m_dvFrame = false;
+  m_dvRepeat = false;
+  m_dvPrepared = {}; // (a picture of the tunnel is never kept on the screen in place of a new one)
+  m_dvFramePts = layer.pts;
+  m_dvStepFrame = {};
+  m_dvGpuTimerFrame = -1;
+  m_dvDrawnOver = false;
+  if (!BeginDVBridge(true, m_compositeTransfer))
+  {
+    m_dvShown = {};
+    return -1;
+  }
+  const DVBRIDGE::ConversionPlace place =
+      DVBRIDGE::PlaceConversion(source.x1, source.y1, source.x2, source.y2, dest.x1, dest.y1, dest.x2,
+                                dest.y2, layer.width, layer.height, m_nWidth, m_nHeight);
+  if (!place.valid)
+    return -1;
+  dvbridge_view view{};
+  view.src_x0 = place.srcX0;
+  view.src_y0 = place.srcY0;
+  view.src_x1 = place.srcX1;
+  view.src_y1 = place.srcY1;
+  view.dst_x = place.dstX;
+  view.dst_y = place.dstY;
+  view.dst_width = place.dstWidth;
+  view.dst_height = place.dstHeight;
+  m_dvFrame = m_dvBridge && m_dvBridge->PrepareTunnel(layer, plain, view);
+  if (!m_dvFrame)
+  {
+    m_dvShown = {};
+    return -1;
+  }
+  if (m_gpuPower)
+    m_gpuPower->Drawn(GPUPOWER::Drawing::NATIVE);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  return 1;
+}
