From 234f0f904bf33e24df78b202b3dd9b2eb5c61b86 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Thu, 29 Oct 2026 00:08:43 +0100
Subject: [PATCH] [Video] Stop the thumb loader before the list item is read

UpdateMovieListItem() stopped the thumb loader only before it changed the
list item. A refresh read the item before that, and copied it whole in the
files view, while the loader thread could still be setting its art and
properties. The loader is now stopped as soon as the item is found.
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 868905b..b3654f6 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -635,6 +635,10 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
   if (!listItem)
     return false;
 
+  // stop before the item is read or changed, the loader thread writes it
+  if (m_thumbLoader.IsLoading())
+    m_thumbLoader.StopThread();
+
   std::shared_ptr<CFileItem> newItem;
   if (infoRefreshed)
   {
@@ -683,10 +687,6 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
       return false;
   }
 
-  // stop before the item is changed, the loader thread reads it
-  if (m_thumbLoader.IsLoading())
-    m_thumbLoader.StopThread();
-
   if (newItem)
   {
     const bool selected{listItem->IsSelected()};
-- 
