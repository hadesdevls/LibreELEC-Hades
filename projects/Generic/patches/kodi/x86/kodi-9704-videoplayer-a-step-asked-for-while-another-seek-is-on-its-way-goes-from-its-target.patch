From 38c302b8c35f05b7001eb2cee2315b800930277f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:53:57 +0000
Subject: [PATCH] VideoPlayer: a step asked for while another seek is on its
 way goes from its target

Since the GUI thread no longer waits for a seek (CSeekPending), a relative
step can be put while an absolute seek is still queued, typically while the
player is held in a network read. The player leaves out a seek message when a
newer one is queued behind it (PLAYER_SEEK with GetPacketCount() == 0), and
takes a relative step from its clock, the time from before the seek on its
way, while SeekTimeRelative() had announced GetTime() + delta, the target
plus the step. The bar dragged to 1:00:00 and then +30 s landed at the old
time plus 30 s. (Found by the review of kodi-9646.)

- SeekTimeRelative(), the one way of every relative step in VideoPlayer (the
  seek handler, JSON-RPC, Python, CApplicationPlayer), asks CSeekPending
  for the target of a seek on its way: while there is one, the step is put as
  an absolute seek to that target plus the step (CSeekPending::
  RelativeTarget()), as it already was with EDL cuts. With nothing on its
  way, it stays relative, as Kodi has it.
- Every seek put to the player holds its ticket, from any thread, and so does
  a relative step (to the time it announced): a step after a step, or after a
  seek of an add-on that waits for it, goes from where that one goes. Chapter
  and scene seeks are taken from GetTime(), which reports that target.
- The player reports the offset that the asker announced (SeekFinished()) as
  it handles the seek, instead of 0, which now came after the asker's and
  wiped the offset that the skin shows after a seek.

Host test (seek_test.cpp): a model of the player's queue and of the askers
as Hades has them: the bar then +30 s lands at the target plus 30 s, two steps
after it add up, steps alone add up; the step from the clock (the code
before this, mutation M12) and a step without its delta (M13) are caught.
---
 xbmc/cores/VideoPlayer/DVDMessage.h    |  5 ++++
 xbmc/cores/VideoPlayer/SeekPending.h   | 13 +++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 32 ++++++++++++++++++++------
 xbmc/cores/VideoPlayer/VideoPlayer.h   |  2 +-
 4 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDMessage.h b/xbmc/cores/VideoPlayer/DVDMessage.h
index 5207610..c7cdf44 100644
--- a/xbmc/cores/VideoPlayer/DVDMessage.h
+++ b/xbmc/cores/VideoPlayer/DVDMessage.h
@@ -225,6 +225,10 @@ public:
   //! Hades: the ticket of a seek that its asker did not wait for (CSeekPending): it goes with the
   //! message
   void SetPending(std::shared_ptr<void> ticket) { m_pending = std::move(ticket); }
+  //! Hades: the offset that the asker of the seek announced (SeekFinished()), which the player
+  //! reports again as it handles the seek, instead of 0
+  void SetOffset(int64_t offsetMs) { m_offsetMs = offsetMs; }
+  int64_t GetOffset() const { return m_offsetMs; }
 
   double GetTime() { return m_mode.time; }
   bool GetRelative() { return m_mode.relative; }
@@ -240,6 +244,7 @@ private:
                           std::chrono::steady_clock::now().time_since_epoch())
                           .count();
   std::shared_ptr<void> m_pending;
+  int64_t m_offsetMs = 0;
 };
 
 class CDVDMsgPlayerSeekChapter : public CDVDMsg
diff --git a/xbmc/cores/VideoPlayer/SeekPending.h b/xbmc/cores/VideoPlayer/SeekPending.h
index 9c63982..905f4cb 100644
--- a/xbmc/cores/VideoPlayer/SeekPending.h
+++ b/xbmc/cores/VideoPlayer/SeekPending.h
@@ -11,6 +11,7 @@
 #include <cstdint>
 #include <memory>
 #include <mutex>
+#include <optional>
 
 /*!
  * \brief Hades: the seeks asked for that the player has not handled yet
@@ -52,6 +53,18 @@ public:
     std::lock_guard lock(m_mutex);
     return m_done < m_asked ? m_target : timeMs;
   }
+  //! Hades: where a relative seek of deltaMs asked for now goes, as an absolute seek, while a
+  //! seek is on its way: from that seek's target. The player takes a relative step from its clock,
+  //! the time from before the seek on its way, and leaves that seek out for the newer one: the step
+  //! would land from where the playback was (the bar dragged to 1:00:00, then +30 s: the old time
+  //! plus 30 s). No value while nothing is on its way: the step is relative, as Kodi has it.
+  std::optional<double> RelativeTarget(double deltaMs) const
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_done < m_asked)
+      return m_target + deltaMs;
+    return std::nullopt;
+  }
   //! A seek is on its way
   bool Pending() const
   {
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index a0e1b7b..f361ba1 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3010,9 +3010,13 @@ void CVideoPlayer::CheckAutoSceneSkip()
   }
 }
 
-void CVideoPlayer::PutSeek(const CDVDMsgPlayerSeek::CMode& mode, double targetMs)
+void CVideoPlayer::PutSeek(const CDVDMsgPlayerSeek::CMode& mode, double targetMs, int64_t offsetMs)
 {
   auto message = std::make_shared<CDVDMsgPlayerSeek>(mode);
+  // (Hades: from any thread the seek is on its way until its message is gone, CSeekPending, and the
+  // player reports the offset that was announced for it)
+  message->SetPending(m_seekPending->Ticket(targetMs));
+  message->SetOffset(offsetMs);
   // Hades: the thread that draws the interface and the video does not wait: the wait, of up to
   // 500 ms, kept both from being drawn for as long as the player took to seek the stream, which
   // over a network takes longer. While the seek is on its way GetTime() reports its target, as it
@@ -3020,7 +3024,6 @@ void CVideoPlayer::PutSeek(const CDVDMsgPlayerSeek::CMode& mode, double targetMs
   // way, as with a relative seek (SeekTimeRelative()).
   if (CServiceBroker::GetAppMessenger()->IsProcessThread() && !IsCurrentThread())
   {
-    message->SetPending(m_seekPending->Ticket(targetMs));
     m_processInfo->SetStateSeeking(true);
     m_messenger.Put(message);
     return;
@@ -3269,7 +3272,7 @@ void CVideoPlayer::HandleMessages()
 
       if (!msg.GetTrickPlay())
       {
-        m_processInfo->SeekFinished(0);
+        m_processInfo->SeekFinished(msg.GetOffset()); // (Hades: what the asker announced)
         SetCaching(CACHESTATE_FLUSH);
       }
 
@@ -3331,7 +3334,7 @@ void CVideoPlayer::HandleMessages()
       // set flag to indicate we have finished a seeking request
       if(!msg.GetTrickPlay())
       {
-        m_processInfo->SeekFinished(0);
+        m_processInfo->SeekFinished(msg.GetOffset()); // (Hades: what the asker announced)
         // Hades: the stream is sought and the buffers flushed: the frames added from now on are
         // after the seek (CSeekTrace)
         trace.doneNs = SeekTraceNowNs();
@@ -3960,7 +3963,8 @@ void CVideoPlayer::ExecuteTimeSeek(int64_t target, Direction direction, bool acc
   mode.restore = true;
   mode.trickplay = false;
   mode.sync = true;
-  PutSeek(mode, static_cast<double>(std::max<int64_t>(target, 0))); // (Hades)
+  PutSeek(mode, static_cast<double>(std::max<int64_t>(target, 0)),
+          std::max<int64_t>(target, 0) - time); // (Hades)
   if (target < 0)
     target = 0;
   m_callback.OnPlayBackSeek(target, target - time);
@@ -4301,13 +4305,22 @@ void CVideoPlayer::SeekTime(int64_t iTime)
   mode.trickplay = false;
   mode.sync = true;
 
-  PutSeek(mode, static_cast<double>(iTime)); // (Hades)
+  PutSeek(mode, static_cast<double>(iTime), seekOffset); // (Hades)
   m_callback.OnPlayBackSeek(iTime, seekOffset);
   m_processInfo->SeekFinished(seekOffset);
 }
 
 bool CVideoPlayer::SeekTimeRelative(int64_t iTime)
 {
+  // Hades: a step asked for while another seek is on its way goes from that seek's target, as an
+  // absolute seek (CSeekPending::RelativeTarget()); the player would take it from its clock and
+  // leave the other seek out. EDL cuts are seeks to an absolute time already, below.
+  if (const auto target = m_seekPending->RelativeTarget(static_cast<double>(iTime)))
+  {
+    SeekTime(std::max<int64_t>(llrint(*target), 0));
+    return true;
+  }
+
   int64_t abstime = GetTime() + iTime;
 
   // if the file has EDL cuts we can't rely on m_clock for relative seeks
@@ -4328,7 +4341,12 @@ bool CVideoPlayer::SeekTimeRelative(int64_t iTime)
   mode.trickplay = false;
   mode.sync = true;
 
-  m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
+  // Hades: the step is on its way until its message is gone (CSeekPending): one asked for after it
+  // goes from its target, and the time reported meanwhile is where it goes
+  auto message = std::make_shared<CDVDMsgPlayerSeek>(mode);
+  message->SetPending(m_seekPending->Ticket(static_cast<double>(abstime)));
+  message->SetOffset(iTime);
+  m_messenger.Put(message);
   m_processInfo->SetStateSeeking(true);
 
   m_callback.OnPlayBackSeek(abstime, iTime);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index ca8d20a..6392210 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -505,7 +505,7 @@ protected:
   //! Hades: puts a seek to targetMs (as GetTime() reports it) to the player. Asked for from the
   //! thread that draws the interface and the video, it is not waited for (CSeekPending); from any
   //! other thread, as before, for up to 500 ms (SynchronizeDemuxer()).
-  void PutSeek(const CDVDMsgPlayerSeek::CMode& mode, double targetMs);
+  void PutSeek(const CDVDMsgPlayerSeek::CMode& mode, double targetMs, int64_t offsetMs);
   std::shared_ptr<CSeekPending> m_seekPending = std::make_shared<CSeekPending>();
   void QueueAutoSceneSkip(std::chrono::milliseconds seekTime);
   void CheckAutoSceneSkip();
-- 
