 {
-  return choice == OutputChoice::HDR10                                       ? ConversionSetting::EVERY
-         : choice == OutputChoice::KODI || choice == OutputChoice::MEASURED ? ConversionSetting::NEVER
-                                                                             : settings;
+  return RebuiltChoice(choice) ? ConversionSetting::EVERY
+         : choice == OutputChoice::KODI || choice == OutputChoice::MEASURED
+             ? ConversionSetting::NEVER
+             : settings;
 }
 
 //! Hades: what the video that plays is, for the choice of its output (ChoiceSourceOf())
@@ -603,6 +626,129 @@ constexpr bool ConversionEligibleForHDR10Plus(bool hdr10Plus,
          !stereo && profile == 8 && BaseLayerIsHdr10(profile, compatibility) && !enhancementLayer;
 }
 
+//! Hades: what goes out with a picture of a Dolby Vision stream rebuilt for output as HDR10, and
+//! why (RebuiltHdr10PlusOf())
+enum class RebuiltHdr10Plus
+{
+  SETTING, //!< HDR10+, as videoscreen.hadesdvashdr10plus says
+  CHOSEN, //!< HDR10+, as the user chose for the video (OutputChoice::REBUILT_HDR10PLUS)
+  SETTING_OFF, //!< HDR10: that setting, or videoscreen.hadesdvashdr10 that it is under, is off
+  CHOSEN_HDR10, //!< HDR10, as the user chose for the video (OutputChoice::REBUILT_HDR10)
+  DISPLAY, //!< HDR10: the display does not declare HDR10+, or its driver cannot send it
+  MAPPED, //!< HDR10: the picture is mapped to the display (HDR10+ describes it as it was mastered)
+};
+
+/*!
+ * \brief Hades: whether a picture of a Dolby Vision stream rebuilt for output as HDR10 goes out as
+ *        HDR10+ (dynamic metadata that Hades measures from the rebuilt picture, dvbridge_dvplus.h)
+ *        or as plain HDR10
+ * \param choice the output chosen for the video
+ * \param setting videoscreen.hadesdvashdr10plus is on, and so is videoscreen.hadesdvashdr10 that it
+ *        is under (the settings window greys it out while that is off)
+ * \param display the display declares HDR10+ and its driver can send it (HDR10PLUS_VSIF:
+ *        CWinSystemGbm::HDR10PlusOutputVersion())
+ * \param mapped the picture is mapped to the display (videoscreen.hadesdvhdr10map)
+ *
+ * The choice for the video stands for the setting: REBUILT_HDR10 is plain HDR10 and
+ * REBUILT_HDR10PLUS is HDR10+, whatever the setting says. Every other choice follows the setting,
+ * as before 1.0 RC7 (AUTOMATIC, and HDR10 as it was kept for a file then). HDR10+ only where the
+ * display takes it and the picture is not mapped to it: where the user chose it and it cannot be
+ * had, plain HDR10, and the log says why.
+ */
+constexpr RebuiltHdr10Plus RebuiltHdr10PlusOf(OutputChoice choice,
+                                              bool setting,
+                                              bool display,
+                                              bool mapped)
+{
+  if (choice == OutputChoice::REBUILT_HDR10)
+    return RebuiltHdr10Plus::CHOSEN_HDR10;
+  const bool chosen = choice == OutputChoice::REBUILT_HDR10PLUS;
+  if (!chosen && !setting)
+    return RebuiltHdr10Plus::SETTING_OFF;
+  if (!display)
+    return RebuiltHdr10Plus::DISPLAY;
+  if (mapped)
+    return RebuiltHdr10Plus::MAPPED;
+  return chosen ? RebuiltHdr10Plus::CHOSEN : RebuiltHdr10Plus::SETTING;
+}
+
+//! Hades: the rebuilt picture goes out as HDR10+ (RebuiltHdr10PlusOf())
+constexpr bool RebuiltHdr10PlusSent(RebuiltHdr10Plus verdict)
+{
+  return verdict == RebuiltHdr10Plus::SETTING || verdict == RebuiltHdr10Plus::CHOSEN;
+}
+
+/*!
+ * \brief Hades: whether "Dolby Vision as HDR10+" (OutputChoice::REBUILT_HDR10PLUS) is offered for a
+ *        Dolby Vision video: it can be rebuilt for output as HDR10 (the display takes HDR10, and
+ *        the reconstruction has not failed in this video), the display takes HDR10+, and the
+ *        picture is not mapped to it, where HDR10+ is never sent (RebuiltHdr10PlusOf()). Where it
+ *        is not offered, the setting cannot send HDR10+ either: "Dolby Vision as HDR10" is then
+ *        what any choice of the two would give.
+ */
+constexpr bool RebuiltHdr10PlusOffered(bool conversion, bool display, bool mapped)
+{
+  return conversion && display && !mapped;
+}
+
+/*!
+ * \brief Hades: the value that the list of "Dolby Vision output (this video)" shows a choice as
+ *
+ * The list offers REBUILT_HDR10 ("Dolby Vision as HDR10") and, where it is offered,
+ * REBUILT_HDR10PLUS ("Dolby Vision as HDR10+"). HDR10, as it was kept for a file before 1.0 RC7, is
+ * not in it: it is shown as the value that gives what it gives now (RebuiltHdr10PlusOf()):
+ * REBUILT_HDR10PLUS where that is offered and the setting is on, REBUILT_HDR10 otherwise. Every
+ * other choice is shown as itself.
+ * \param offered RebuiltHdr10PlusOffered() for the video
+ * \param setting as RebuiltHdr10PlusOf() takes it
+ */
+constexpr OutputChoice ListedOutputChoiceOf(OutputChoice choice, bool offered, bool setting)
+{
+  if (choice != OutputChoice::HDR10)
+    return choice;
+  return offered && setting ? OutputChoice::REBUILT_HDR10PLUS : OutputChoice::REBUILT_HDR10;
+}
+
+//! Hades: the verdict for the log: what goes out, and who decided it (the setting or the user, for
+//! this video)
+inline std::string RebuiltHdr10PlusText(RebuiltHdr10Plus verdict, OutputChoice choice)
+{
+  const std::string setting =
+      "\"Send it as HDR10+ where the display takes it\" (videoscreen.hadesdvashdr10plus)";
+  const std::string kept =
+      choice == OutputChoice::HDR10
+          ? " (the output kept for this file, \"Dolby Vision as HDR10\" as it was chosen "
+            "before 1.0 RC7, follows that setting)"
+          : "";
+  const std::string asked =
+      choice == OutputChoice::REBUILT_HDR10PLUS
+          ? ", although the user chose \"Dolby Vision as HDR10+\" for this video"
+          : "";
+  switch (verdict)
+  {
+    case RebuiltHdr10Plus::SETTING:
+      return "as HDR10+, as " + setting + " says" + kept;
+    case RebuiltHdr10Plus::CHOSEN:
+      return "as HDR10+, as the user chose for this video (\"Dolby Vision as HDR10+\"), whatever " +
+             setting + " says";
+    case RebuiltHdr10Plus::SETTING_OFF:
+      return "as HDR10, as the settings say: " + setting +
+             " is off, or \"Dolby Vision as HDR10 when needed\" that it is under" + kept;
+    case RebuiltHdr10Plus::CHOSEN_HDR10:
