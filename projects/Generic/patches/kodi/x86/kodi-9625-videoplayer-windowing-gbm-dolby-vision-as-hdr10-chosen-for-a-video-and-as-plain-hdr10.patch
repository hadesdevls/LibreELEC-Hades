+//! Hades: a choice that reconstructs every Dolby Vision stream for output as HDR10, and never sends
+//! it natively: HDR10 (as kept for a file before 1.0 RC7), REBUILT_HDR10 and REBUILT_HDR10PLUS,
+//! which differ only in what goes out with the rebuilt picture (RebuiltHdr10PlusOf())
+constexpr bool RebuiltChoice(OutputChoice choice)
+{
+  return choice == OutputChoice::HDR10 || choice == OutputChoice::REBUILT_HDR10 ||
+         choice == OutputChoice::REBUILT_HDR10PLUS;
+}
+
 //! What decides whether a stream is reconstructed and sent as HDR10, with this choice (MEASURED:
 //! never; where native output is not to be had, its HDR10 base layer plays as Kodi plays it;
-//! DOLBY_VISION, a choice for an HDR10+ stream: as the settings say, as AUTOMATIC)
+//! DOLBY_VISION, a choice for an HDR10+ stream: as the settings say, as AUTOMATIC; Hades: every one
