diff --git a/xbmc/windowing/gbm/DVDisplaySignal.h b/xbmc/windowing/gbm/DVDisplaySignal.h
index a4cb040..72c3693 100644
--- a/xbmc/windowing/gbm/DVDisplaySignal.h
+++ b/xbmc/windowing/gbm/DVDisplaySignal.h
@@ -37,20 +37,36 @@ enum class Signal
   //! Dolby Vision Low-Latency (player-led), where the display offers no other and it is turned
   //! on in the settings (videoscreen.hadesdvlowlatency)
   LOW_LATENCY,
+  //! the tunnel of the Standard mode told by the older signalling, the HDMI 1.4b vendor InfoFrame
+  //! (DVHdmi14b.h), where the display asks for it (CDisplayInfo::SupportsHdmi14bDolbyVision()) and
+  //! it is turned on in the settings (videoscreen.hadesdvhdmi14b)
+  HDMI14B,
 };
 
+//! The setting of the HDMI 1.4b signalling is offered for the display: it asks for that signalling
+inline bool OffersHdmi14b(const UTILS::CDisplayInfo* info)
+{
+  return info && info->SupportsHdmi14bDolbyVision();
+}
+
 /*!
  * \brief How native output signals Dolby Vision to a display
  * \param info its display information (nullptr: none)
  * \param lowLatencyOn whether Dolby Vision Low-Latency is turned on, as read for the video: asked
  *        only of a display that offers Low-Latency only
+ * \param hdmi14bOn whether the HDMI 1.4b signalling is turned on, as read for the video: asked
+ *        only of a display that asks for it (the two kinds of display have nothing in common:
+ *        Low-Latency only is a version 2 block, the HDMI 1.4b signalling a version 0 or 1 one)
  */
-template<typename LowLatencyOn>
-Signal SignalOf(const UTILS::CDisplayInfo* info, LowLatencyOn lowLatencyOn)
+template<typename LowLatencyOn, typename Hdmi14bOn>
+Signal SignalOf(const UTILS::CDisplayInfo* info, LowLatencyOn lowLatencyOn, Hdmi14bOn hdmi14bOn)
 {
   if (info && !info->SupportsStandardDolbyVision() && info->SupportsLowLatencyDolbyVisionOnly() &&
       lowLatencyOn())
     return Signal::LOW_LATENCY;
+  if (info && !info->SupportsStandardDolbyVision() && info->SupportsHdmi14bDolbyVision() &&
+      hdmi14bOn())
+    return Signal::HDMI14B;
   return Signal::STANDARD;
 }
 
@@ -60,26 +76,28 @@ Signal SignalOf(const UTILS::CDisplayInfo* info, LowLatencyOn lowLatencyOn)
  *        not valid, or several), legacy (Dolby Vision with the older signalling only), lloff
