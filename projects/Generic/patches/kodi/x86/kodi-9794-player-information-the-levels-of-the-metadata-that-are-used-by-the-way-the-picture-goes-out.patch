From 7ab423fcad9c35468c5e3e6e5829545051d2df63 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:55:37 +0000
Subject: [PATCH] player information: the levels of the metadata that are used,
 by the way the picture goes out

The table of the levels on the Dolby Vision page of the player information has a row
"used" (LevelUsed()), which knew two ways out: native, and rebuilt. It did not follow
what is drawn:

- Low-Latency, which is native output, is mapped to the display by Hades: guided by
  level 1 with the offsets of level 3 (map_to_display() with level1_noted()), with the
  bars of level 5 and the trim pass of level 2 (trim_prepare()). L3 was not marked. An
  HLG picture sent so has nothing to map, and its L1 was marked.
- A rebuilt picture that is mapped, to the display or to SDR, takes level 1 with the
  offsets of level 3 and the trim pass of level 2 where the trims are on
  (TakeDVConversionMapping() sets mapping.trims); L2 was never marked there. A picture
  mapped to SDR has no HDR InfoFrame, and its L6 was marked.
- A rebuilt picture sent as mastered (the default) is not mapped: of the levels only the
  static values of L6 go into its InfoFrame (ConversionOutput()), and L1 and L3 were
  marked.

LevelUsed() and LevelTable() take the way out (LevelPath: native, Low-Latency, Low-Latency
of HLG, as mastered, mapped to HDR10, mapped to SDR) with whether the trims are on for it.
The window system names it: transport 3 is Low-Latency, origin 3 an HLG video sent as
Dolby Vision; for a rebuilt picture, the mapping that its renderer took
(m_dvConvertMapping), with its own trims. Nothing but the page changes.

Host test (outside the tree): the test of the header with the table checked for every way
out, in both directions; against the header before, 7 of its checks fail.
---
 xbmc/utils/HadesPlayerInfo.h                  | 68 +++++++++++++++----
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 27 +++++---
 2 files changed, 72 insertions(+), 23 deletions(-)

diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 2a6d86c..51006ba 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -727,38 +727,76 @@ inline const std::vector<int>& MetadataLevels()
   return levels;
 }
 
+/*!
+ * \brief How a Dolby Vision picture goes out, for the levels of its metadata that Hades acts on
+ *        (LevelUsed())
+ */
+enum class LevelPath
+{
+  NONE, //!< not drawn by Hades
+  NATIVE, //!< native output, Standard: the display maps the picture
+  LOW_LATENCY, //!< native output as Low-Latency: Hades maps the picture to the display
+  LOW_LATENCY_HLG, //!< ... a picture of HLG sent so, which has nothing to map
+  AS_MASTERED, //!< rebuilt and sent as HDR10 as it was mastered: the display maps it
+  MAPPED_HDR10, //!< rebuilt and sent as HDR10, mapped to the display by Hades
+  MAPPED_SDR, //!< rebuilt and mapped to SDR by Hades
+};
+
 /*!
  * \brief Whether Hades reads the values of a level and acts on them, and does not only carry its
- *        bytes. Read from the code (dvbridge_metadata.h, dvbridge_placebo.c):
- *        native output: L1 (checked, clamped), L2 (checked; not where the settings send no
- *        trims), L5 (the active area, remade from what is drawn over the bars);
- *        a picture rebuilt as HDR10 or SDR: L1 and L3 (the content range, with its offsets) and
- *        L6 (the static values).
+ *        bytes. Read from the code (dvbridge_metadata.h, dvbridge_placebo.c, dvbridge_render.c):
+ *        native output: L1 (checked, clamped), L5 (the active area, remade from what is drawn
+ *        over the bars);
+ *        Low-Latency, and a picture rebuilt and mapped (to the display or to SDR): L1 with the
+ *        offsets of L3, which guide the mapping (map_to_display(): not for a picture of HLG,
+ *        which has nothing to map), and L5 in Low-Latency (the bars);
+ *        a picture rebuilt as HDR10: L6, the static values of its InfoFrame (as mastered; mapped,
+ *        the black of the source);
+ *        L2 where the trims are on, wherever the picture is not sent as mastered: sent to the
+ *        display (native output), or its trim pass applied where Hades maps the picture
+ *        (dvbridge_trims.h).
  *        The others (L3, L4, L8, L9, L10, L11, L254 for native output) go to the display as they
  *        are in the RPU, converted for the tunnel; L255 is the encoder's own data.
+ * \param trims the trims are on (videoscreen.hadesdvnotrims off), for this way out
  */
-inline bool LevelUsed(int level, bool native, bool converted, bool trims)
+inline bool LevelUsed(int level, LevelPath path, bool trims)
 {
-  if (native)
-    return level == 1 || level == 5 || (level == 2 && trims);
-  if (converted)
-    return level == 1 || level == 3 || level == 6;
+  if (level == 2)
+    return trims && path != LevelPath::NONE && path != LevelPath::AS_MASTERED;
+  switch (path)
+  {
+    case LevelPath::NATIVE:
+      return level == 1 || level == 5;
+    case LevelPath::LOW_LATENCY:
+      return level == 1 || level == 3 || level == 5;
+    case LevelPath::LOW_LATENCY_HLG:
+      return level == 5;
+    case LevelPath::AS_MASTERED:
+      return level == 6;
+    case LevelPath::MAPPED_HDR10:
+      return level == 1 || level == 3 || level == 6;
+    case LevelPath::MAPPED_SDR:
+      return level == 1 || level == 3;
+    case LevelPath::NONE:
+      return false;
+  }
   return false;
 }
 
 /*!
- * \brief The table of the levels as three lines of text of a monospaced font, a column of five
- *        characters for each level, "+" where it holds and "-" where it does not
+ * \brief The table of the levels as four lines of text of a monospaced font (the header and three
+ *        rows), a column of five characters for each level, "+" where it holds and "-" where it
+ *        does not
  * \param file the levels of the extension blocks of the RPU
  * \param sent the levels of the blocks that the display is sent; sentKnown false where that is not
  *        known (nothing is shown as sent then)
+ * \param path how the picture goes out, and trims whether the trims are on for it (LevelUsed())
  * \return {header, file, used, sent}
  */
 inline std::vector<std::string> LevelTable(const std::vector<int>& file,
                                            const std::vector<int>& sent,
                                            bool sentKnown,
-                                           bool native,
-                                           bool converted,
+                                           LevelPath path,
                                            bool trims)
 {
   std::string head, in, used, out;
@@ -772,7 +810,7 @@ inline std::vector<std::string> LevelTable(const std::vector<int>& file,
     const bool inSent = sentKnown && std::find(sent.begin(), sent.end(), level) != sent.end();
     head += cell(name);
     in += cell(inFile ? "+" : "-");
-    used += cell(inFile && LevelUsed(level, native, converted, trims) ? "+" : "-");
+    used += cell(inFile && LevelUsed(level, path, trims) ? "+" : "-");
     out += cell(inSent ? "+" : "-");
   }
   return {head, in, used, out};
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 8efbe32..a0248d9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7557,8 +7557,7 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
                         const CDVBridgeGLES::LevelDetail& lv,
                         const std::vector<int>& sent,
                         bool sentKnown,
-                        bool native,
-                        bool converted,
+                        KODI::UTILS::PLAYERINFO::LevelPath path,
                         bool trims)
 {
   using namespace KODI::UTILS::PLAYERINFO;
@@ -7598,7 +7597,7 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
   if (lv.count)
   {
     const std::vector<int> file(lv.levels, lv.levels + lv.count);
-    const auto table = LevelTable(file, sent, sentKnown, native, converted, trims);
+    const auto table = LevelTable(file, sent, sentKnown, path, trims);
     info["hades.dv.lvhead"] = table[0];
     info["hades.dv.lvfile"] = table[1];
     info["hades.dv.lvused"] = table[2];
@@ -7907,10 +7906,15 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       info["hades.dv.l5origin"] = d.sentL5Drawn ? "drawn" : d.l5[0] >= 0 ? "rpu" : "picture";
     }
     // Hades: and what every level of the RPU says, with the table of the levels (the page of the
-    // Dolby Vision metadata of the player information)
+    // Dolby Vision metadata of the player information). Low-Latency (transport 3) is mapped to the
+    // display by Hades, from HLG with nothing to map where an HLG video is sent so (origin 3).
+    using KODI::UTILS::PLAYERINFO::LevelPath;
+    const LevelPath path = d.transport != 3 ? LevelPath::NATIVE
+                           : origin == 3    ? LevelPath::LOW_LATENCY_HLG
+                                            : LevelPath::LOW_LATENCY;
     PublishLevelValues(info, d.levelDetail,
                        std::vector<int>(d.sent, d.sent + (d.sentCount > 0 ? d.sentCount : 0)),
-                       d.sentCount >= 0, true, false, m_dvEngine.trims);
+                       d.sentCount >= 0, path, m_dvEngine.trims);
     // Hades: how the picture was composed, where it was not as CCM 001 composes it
     if (d.composed == DVBRIDGE_COMPOSED_RESHAPING)
       info["hades.dv.composer"] = "reshaping";
@@ -7931,9 +7935,16 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
   if (converted)
   {
     info["hades.dv.layers"] = m_dvConvertBridge->ConversionLayers();
-    // (Hades: the levels of the RPU of the picture rebuilt; what the display is sent is not read)
-    PublishLevelValues(info, m_dvConvertBridge->ConversionLevels(), {}, false, false, true,
-                       m_dvEngine.trims);
+    // (Hades: the levels of the RPU of the picture rebuilt; what the display is sent is not read.
+    // As mastered, or mapped to the display or to SDR with the trim pass of the mapping that the
+    // renderer took: TakeDVConversionMapping())
+    using KODI::UTILS::PLAYERINFO::LevelPath;
+    const bool mapped = m_dvConvertMapping.enabled;
+    PublishLevelValues(info, m_dvConvertBridge->ConversionLevels(), {}, false,
+                       !mapped        ? LevelPath::AS_MASTERED
+                       : convertedSdr ? LevelPath::MAPPED_SDR
+                                      : LevelPath::MAPPED_HDR10,
+                       mapped && m_dvConvertMapping.trims);
   }
   if (native || converted)
   {
