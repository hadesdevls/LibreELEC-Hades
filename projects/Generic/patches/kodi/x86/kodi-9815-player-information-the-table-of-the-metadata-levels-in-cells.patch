+/*!
+ * \brief The cells of a row of LevelTable(), one per level of MetadataLevels(): "L1", "+", "-"...
+ *        (its columns of five characters, without their spaces), for a page that draws each in a
+ *        column of its own
+ */
+inline std::vector<std::string> LevelCells(const std::string& row)
+{
+  std::vector<std::string> cells;
+  for (size_t i = 0; i < MetadataLevels().size(); ++i)
+  {
+    std::string cell = i * 5 < row.size() ? row.substr(i * 5, 5) : std::string();
+    cell.erase(cell.find_last_not_of(' ') + 1);
+    cells.push_back(cell);
+  }
+  return cells;
+}
