From fb24637edba282659875e0961d60d0bd67bbf971 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:23:42 +0000
Subject: [PATCH] windowing/gbm: HDR10+ only of an application version that the
 display takes

A display may declare HDR10+ of application version 0 (DeclaresHDR10Plus()).
The payload of a frame now goes out only where its own version is not
above the display's, nor above 1, the highest that Kodi codes
(CHDR10PlusOutput::VersionFits()): metadata of version 0 go to displays
of version 0 and 1 as they are; metadata of version 1 do not go to a
display of version 0, because in version 1 the places of 5 and 10 % of
the distribution are not the percentiles that a display of version 0
reads there, and a payload is never given another version than its own.
Such a video goes out as HDR10, as Amlogic does for any display that is
not of version 1 ("HDR10+ not supported, treat as hdr10"), and kodi.log
says why once per video.

Dolby Vision sent as HDR10+ is offered to a display of either version
(HDR10PlusOutputVersion()); what add-ons are told is unchanged.
---
 xbmc/windowing/gbm/HDR10PlusOutput.h          | 32 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 32 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.h             |  4 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  5 +--
 4 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index 3184f74..2cd7596 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include <algorithm>
 #include <array>
 #include <cstddef>
 #include <cstdint>
@@ -35,9 +36,10 @@ namespace GBM
  *
  * The payload of a frame goes out only while the HDR of its video is signalled as PQ (HDR10:
  * HDR10+ is HDR10 and its metadata), the display declares HDR10+ (its HDR10+ vendor-specific
- * video data block, application version 1 or later) and the connector has HDR10PLUS_VSIF.
- * Otherwise, and for a frame without HDR10+ metadata, what was queued is taken away: the output
- * is plain HDR10, exactly as without this. The decoder gives a picture without metadata of its
+ * video data block, of any application version: Hades reads one of version 0 too) with an
+ * application version that takes the payload's (VersionFits()), and the connector has
+ * HDR10PLUS_VSIF. Otherwise, and for a frame without HDR10+ metadata, what was queued is taken
+ * away: the output is plain HDR10, exactly as without this. The decoder gives a picture without metadata of its
  * own the InfoFrame of the last one that had it, over fewer than 12 in a row
  * (KODI::UTILS::HDR10PLUS::CGap). The HDR InfoFrame is never touched here.
  *
@@ -78,7 +80,9 @@ public:
   struct Output
   {
     bool pq = false; //!< the HDR of the video is signalled, as PQ
-    bool display = false; //!< the display declares HDR10+
+    bool display = false; //!< the display declares HDR10+ (a block of any application version)
+    //! Hades: the application version of the display's block, -1 without one (VersionFits())
+    int receiverVersion = -1;
     bool driver = false; //!< the connector has HDR10PLUS_VSIF
     //! the request of the frame carries no change of the HDR signalling and no modeset. A payload
     //! is never queued with one: a driver that refuses it would take the HDR10 or the mode of the
@@ -90,11 +94,29 @@ public:
     bool withMode = false;
   };
 
+  //! Hades: the application version of a payload (PB4, bits 7 and 6)
+  static int PayloadVersion(const Payload& payload) { return payload[3] >> 6; }
+
+  /*!
+   * \brief Hades: whether a payload goes out to a display whose block declares receiverVersion
+   *        (-1: none): only of a version not above that one, and not above 1, the highest that
+   *        Kodi codes (KODI::UTILS::HDR10PLUS::MakeVsif()). Metadata of version 1 do not go to a
+   *        display of version 0: in version 1 the places of 5 and 10 % of the distribution are not
+   *        what a display of version 0 reads there (percentiles), and a payload is never given
+   *        another version than its own. The display then gets HDR10, as Amlogic does it
+   *        ("HDR10+ not supported, treat as hdr10", for any display that is not of version 1).
+   *        Metadata of version 0 go to a display of version 1 as they are.
+   */
+  static bool VersionFits(const Payload& payload, int receiverVersion)
+  {
+    return receiverVersion >= 0 && PayloadVersion(payload) <= std::min(receiverVersion, 1);
+  }
+
   //! What to queue for a frame (payload: its HDR10+ metadata, nothing without)
   Step Next(const Output& output, const std::optional<Payload>& payload) const
   {
     const bool on = output.pq && output.display && output.driver && !m_refused;
-    if (on && payload)
+    if (on && payload && VersionFits(*payload, output.receiverVersion))
       return m_queued == payload || !(output.alone || output.withMode) ? Step::NOTHING : Step::SEND;
     return m_queued ? Step::CLEAR : Step::NOTHING;
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 14337c6..1e74b23 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3401,9 +3401,20 @@ enum HDR10PlusTold : unsigned int
   TOLD_SENDING = 1,
   TOLD_NO_DRIVER = 2,
   TOLD_MISSING = 4,
+  TOLD_VERSION = 8,
 };
 } // namespace
 
+int CWinSystemGbm::HDR10PlusOutputVersion() const
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto info = DisplayInfo();
+  if (!info || !info->DeclaresHDR10Plus() || !connector ||
+      !connector->SupportsProperty(CHDR10PlusOutput::PROPERTY))
+    return -1;
+  return std::min(info->HDR10PlusVersion(), 1);
+}
+
 void CWinSystemGbm::ResetHDR10Plus()
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
@@ -3447,7 +3458,9 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
   const auto info = DisplayInfo();
   CHDR10PlusOutput::Output output;
   output.pq = m_eotf == KODI::UTILS::Eotf::PQ;
-  output.display = info && info->SupportsHDR10Plus();
+  // (Hades: a block of any application version, and the payload only of one it takes)
+  output.display = info && info->DeclaresHDR10Plus();
+  output.receiverVersion = info ? info->HDR10PlusVersion() : -1;
   output.driver = connector->SupportsProperty(CHDR10PlusOutput::PROPERTY);
   output.alone = !drm->ModesetPending() &&
                  !drm->RequestValue(connector, "HDR_OUTPUT_METADATA") &&
@@ -3465,6 +3478,23 @@ void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& o
               CHDR10PlusOutput::PROPERTY);
   }
 
+  // Hades: metadata of a version the display does not take go out as nothing (VersionFits())
+  if (payload && output.pq && output.display && output.driver &&
+      !CHDR10PlusOutput::VersionFits(*payload, output.receiverVersion) &&
+      !(m_hdr10PlusTold & TOLD_VERSION))
+  {
+    m_hdr10PlusTold |= TOLD_VERSION;
+    CLog::Log(LOGINFO,
+              "HDR10+: the display declares HDR10+ application version {}, and the metadata of "
+              "this video are of version {}{}: they are not sent to it, and the video goes out as "
+              "HDR10",
+              output.receiverVersion, CHDR10PlusOutput::PayloadVersion(*payload),
+              CHDR10PlusOutput::PayloadVersion(*payload) == 1
+                  ? ", whose places of 5 and 10 % are not the percentiles that a display of "
+                    "version 0 reads there"
+                  : "");
+  }
+
   switch (m_hdr10Plus.Next(output, payload))
   {
     case CHDR10PlusOutput::Step::SEND:
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 1b6709d..9a28973 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -300,6 +300,10 @@ protected:
   bool HDR10PlusInVideo() const { return m_hdr10PlusInVideo; }
   //! Hades: HDR10+ metadata are queued for the display (CHDR10PlusOutput::Active())
   bool HDR10PlusQueued() const { return m_hdr10Plus.Active(); }
+  //! Hades: the application version of the HDR10+ metadata that may go out to this display: the
+  //! version its block declares, 1 at most (what Kodi codes), where the connector has
+  //! HDR10PLUS_VSIF; -1 where none may (CHDR10PlusOutput::VersionFits())
+  int HDR10PlusOutputVersion() const;
   //! \brief Hades: native Dolby Vision output has the output. Its transport is no picture
   //! that the display could take as two eyes: no 3D output is chosen meanwhile.
   virtual bool NativeDVOutputInUse() const { return false; }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b3b1d49..66ff929 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2092,7 +2092,8 @@ void CWinSystemGbmGLESContext::DVPlusFree::operator()(dvbridge_dvplus_picture* p
 
 bool CWinSystemGbmGLESContext::DVPlusPossible() const
 {
-  return Hdr10PlusSettingOn(SettingsNow()) && GetDisplayHDRCapabilities().SupportsHDR10Plus();
+  // (Hades: a display of any application version of HDR10+: HDR10PlusOutputVersion())
+  return Hdr10PlusSettingOn(SettingsNow()) && HDR10PlusOutputVersion() >= 0;
 }
 
 void CWinSystemGbmGLESContext::DVPlusEnd()
@@ -2178,7 +2179,7 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
     if (Hdr10PlusSettingOn(SettingsNow()))
     {
       const char* why = nullptr;
-      if (!GetDisplayHDRCapabilities().SupportsHDR10Plus())
+      if (HDR10PlusOutputVersion() < 0)
         why = "the display does not declare HDR10+, or its driver cannot send it (HDR10PLUS_VSIF)";
       else if (m_dvConvertMapping.enabled)
         why = "the picture is mapped to the display (System > Display), and HDR10+ describes the "
-- 
