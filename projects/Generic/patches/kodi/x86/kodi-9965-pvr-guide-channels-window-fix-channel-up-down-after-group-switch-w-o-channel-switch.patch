From 1513297e821103b096120f2e5861a555f2be3e3a Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Fri, 13 Nov 2026 07:43:13 +0100
Subject: [PATCH] [PVR] Guide, Channels window: Fix channel up/down after group
 switch w/o channel switch

Switching the group in the guide or channels window makes the new group
the active group. If the window was closed without selecting a channel
from that group, channel up/down could not find the playing channel in
the active group and did nothing.

Restore the playing channel's group on close in this case, sharing the
logic with the channels OSD. Like there, don't remember the selected
channel of the abandoned group then.

Fixes #30489

(cherry picked from commit 5288896acd962fa23989ee3e14440f74ddf2405c)
(cherry picked from commit 52f1405349e7cf8e929691df245935e72e487f4b)
---
 xbmc/pvr/PVRPlaybackState.cpp                | 15 +++++++++++++++
 xbmc/pvr/PVRPlaybackState.h                  |  6 ++++++
 xbmc/pvr/dialogs/GUIDialogPVRChannelsOSD.cpp |  7 +------
 xbmc/pvr/windows/GUIWindowPVRBase.cpp        |  4 +++-
 4 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/xbmc/pvr/PVRPlaybackState.cpp b/xbmc/pvr/PVRPlaybackState.cpp
index 52d5234..dd94854 100644
--- a/xbmc/pvr/PVRPlaybackState.cpp
+++ b/xbmc/pvr/PVRPlaybackState.cpp
@@ -682,6 +682,21 @@ void CPVRPlaybackState::SetActiveChannelGroup(
   SetActiveChannelGroup(group);
 }
 
+bool CPVRPlaybackState::RestorePlayingChannelGroup()
+{
+  const std::shared_ptr<CPVRChannelGroupMember> playingMember{GetPlayingChannelGroupMember()};
+  if (!playingMember)
+    return false;
+
+  const std::shared_ptr<const CPVRChannelGroup> activeGroup{
+      GetActiveChannelGroup(playingMember->IsRadio())};
+  if (activeGroup && activeGroup->GroupID() == playingMember->GroupID())
+    return false;
+
+  SetActiveChannelGroup(playingMember);
+  return true;
+}
+
 std::shared_ptr<CPVRChannelGroup> CPVRPlaybackState::GetActiveChannelGroup(bool bRadio) const
 {
   if (bRadio)
diff --git a/xbmc/pvr/PVRPlaybackState.h b/xbmc/pvr/PVRPlaybackState.h
index 0fe8152..57f01a5 100644
--- a/xbmc/pvr/PVRPlaybackState.h
+++ b/xbmc/pvr/PVRPlaybackState.h
@@ -228,6 +228,12 @@ public:
    */
   void SetActiveChannelGroup(const std::shared_ptr<CPVRChannelGroupMember>& channel);
 
+  /*!
+   * @brief Make the playing channel's group the active group, if another group is active.
+   * @return True if the active group was changed, false otherwise.
+   */
+  bool RestorePlayingChannelGroup();
+
   /*!
    * @brief Get the active channel group.
    * @param bRadio True to get the active radio group, false to get the active TV group.
diff --git a/xbmc/pvr/dialogs/GUIDialogPVRChannelsOSD.cpp b/xbmc/pvr/dialogs/GUIDialogPVRChannelsOSD.cpp
index e1122ab..7c81171 100644
--- a/xbmc/pvr/dialogs/GUIDialogPVRChannelsOSD.cpp
+++ b/xbmc/pvr/dialogs/GUIDialogPVRChannelsOSD.cpp
@@ -101,13 +101,8 @@ void CGUIDialogPVRChannelsOSD::OnDeinitWindow(int nextWindowID)
   if (m_group)
   {
     CPVRManager& pvrMgr = CServiceBroker::GetPVRManager();
-    const std::shared_ptr<CPVRChannelGroupMember> playingMember =
-        pvrMgr.PlaybackState()->GetPlayingChannelGroupMember();
-
     // Group was switched without selecting one of its channels.
-    if (playingMember && playingMember->GroupID() != m_group->GroupID())
-      pvrMgr.PlaybackState()->SetActiveChannelGroup(playingMember);
-    else
+    if (!pvrMgr.PlaybackState()->RestorePlayingChannelGroup())
       pvrMgr.Get<PVR::GUI::Channels>().SetSelectedChannelPath(m_group->IsRadio(),
                                                               m_viewControl.GetSelectedItemPath());
 
diff --git a/xbmc/pvr/windows/GUIWindowPVRBase.cpp b/xbmc/pvr/windows/GUIWindowPVRBase.cpp
index b175239..f64e858 100644
--- a/xbmc/pvr/windows/GUIWindowPVRBase.cpp
+++ b/xbmc/pvr/windows/GUIWindowPVRBase.cpp
@@ -295,7 +295,9 @@ void CGUIWindowPVRBase::OnInitWindow()
 void CGUIWindowPVRBase::OnDeinitWindow(int nextWindowID)
 {
   HideProgressDialog();
-  UpdateSelectedItemPath();
+  // Group was switched without selecting one of its channels.
+  if (!CServiceBroker::GetPVRManager().PlaybackState()->RestorePlayingChannelGroup())
+    UpdateSelectedItemPath();
   CGUIMediaWindow::OnDeinitWindow(nextWindowID);
 }
 
