+#ifdef HAVE_DVBRIDGE
+bool CLinuxRendererGLES::WantsDVBridge(const VideoPicture& picture) const
+{
+  return KODI::WINDOWING::GBM::CWinSystemGbmGLESContext::DVBridgeRequested(&picture) &&
+         CanRenderDVBridge(picture);
+}
+
+bool CLinuxRendererGLES::DVBridgeConfigChanged(const VideoPicture& picture) const
+{
+  // Native output follows what the pictures ask for and what this renderer can draw now. It
+  // starts with a picture that asks for it: the first pictures may come without their RPU, or
+  // the output may switch to a transport mode after the renderer was configured. It ends when
+  // the output mode, the geometry (zoom, stretch, shift) or a session-wide disable no longer
+  // allows it; that is not a failure, and native output starts again when they allow it. A
+  // picture without Dolby Vision metadata is only not drawn and does not end it: the decoder
+  // moves a stream whose metadata stays missing to the ordinary output by changing its hdrType.
+  // The conditions change only with the mode, the view settings or a failure (which disables
+  // native output for the session), so this cannot alternate from picture to picture.
+  if (!m_dvRequested)
+    return WantsDVBridge(picture);
+  const auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  return !window || !window->SupportsNativeDVOutput() || !CanRenderDVBridge(picture);
+}
+#endif
