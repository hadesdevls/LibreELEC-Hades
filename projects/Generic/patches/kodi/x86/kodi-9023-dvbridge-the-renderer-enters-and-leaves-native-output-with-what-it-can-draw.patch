-    return DVFrameRejected("cropped-source");
-  dvbridge_geometry geometry{layer.width, layer.height,
-      static_cast<int>(std::lround(m_destRect.x1)), static_cast<int>(std::lround(m_destRect.y1)),
-      static_cast<int>(std::lround(m_destRect.Width())),
-      static_cast<int>(std::lround(m_destRect.Height()))};
+  dvbridge_geometry geometry{};
+  if (!DVGeometry(geometry))
+    return DVFrameRejected("geometry");
   const bool prepared =
       window->RenderDVBridge(layer, buffer.doviEnhancement.get(), buffer.doviMetadata, geometry);
   if (prepared && m_dvRejected.Count())
