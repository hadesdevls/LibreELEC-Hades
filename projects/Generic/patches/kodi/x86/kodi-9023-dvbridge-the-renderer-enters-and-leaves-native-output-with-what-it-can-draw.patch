+bool CRendererVAAPIGLES::DVGeometry(dvbridge_geometry& geometry) const
+{
+  // Native output draws the whole picture, at its own aspect ratio, inside the 3840x2160
+  // raster. Zoom (a cropped source), stretching or a shift out of the raster keep the ordinary
+  // output.
+  if (m_sourceWidth == 0 || m_sourceHeight == 0 || m_sourceWidth > 3840 || m_sourceHeight > 2160 ||
+      m_sourceRect.x1 != 0 || m_sourceRect.y1 != 0 ||
+      m_sourceRect.Width() != m_sourceWidth || m_sourceRect.Height() != m_sourceHeight)
+    return false;
+  if (m_destRect.x1 < -0.5f || m_destRect.y1 < -0.5f || m_destRect.x2 > 3840.5f ||
+      m_destRect.y2 > 2160.5f)
+    return false;
+  const double aspect = static_cast<double>(m_sourceHeight) / m_sourceWidth;
+  if (std::abs(static_cast<double>(m_destRect.Width()) * aspect -
+               static_cast<double>(m_destRect.Height())) > 1.5)
+    return false;
+  // The 4:2:2 transport needs an even horizontal position and width (for example a 3586-pixel
+  // wide picture pillarboxed at x = 127): move each side inwards to an even column, at most one
+  // pixel, and take the height from that width, centred where Kodi placed the picture.
+  const int left = std::clamp(2 * static_cast<int>(std::ceil(m_destRect.x1 / 2.0f - 0.01f)), 0, 3840);
+  const int right =
+      std::clamp(2 * static_cast<int>(std::floor(m_destRect.x2 / 2.0f + 0.01f)), 0, 3840);
+  const int width = right - left;
+  if (width <= 0)
+    return false;
+  const int height = std::min(2160, static_cast<int>(std::lround(width * aspect)));
+  if (height <= 0)
+    return false;
+  const int top = std::clamp(
+      static_cast<int>(std::lround(static_cast<double>(m_destRect.y1 + m_destRect.y2) / 2.0 -
+                                   height / 2.0)),
+      0, 2160 - height);
+  geometry = {static_cast<int>(m_sourceWidth), static_cast<int>(m_sourceHeight), left, top, width,
+              height};
+  return true;
+}
+
+bool CRendererVAAPIGLES::CanRenderDVBridge(const VideoPicture& picture) const
+{
+  // Native decoder textures only. Postprocessed or rotated images need their own explicit
+  // metadata/geometry mapping.
+  const auto* pic = dynamic_cast<const CVaapiRenderPicture*>(picture.videoBuffer);
+  if (!pic || pic->procPic.videoSurface == VA_INVALID_ID || m_textureTarget != GL_TEXTURE_2D ||
+      m_renderOrientation != 0)
+    return false;
+  switch (pic->procPic.fourcc)
+  {
+    case VA_FOURCC_NV12:
+    case VA_FOURCC_P010:
+    case VA_FOURCC_P012:
+    case VA_FOURCC_P016:
+      break;
+    default:
+      return false;
+  }
+  // Called on the player thread: the geometry itself is computed by the render thread.
+  return m_dvGeometryUsable;
+}
+
+void CRendererVAAPIGLES::ManageRenderArea()
+{
+  CLinuxRendererGLES::ManageRenderArea();
+  dvbridge_geometry geometry{};
+  m_dvGeometryUsable = DVGeometry(geometry);
+}
