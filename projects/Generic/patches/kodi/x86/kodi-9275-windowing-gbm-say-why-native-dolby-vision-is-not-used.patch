   list(APPEND SOURCES DVBridgeState.cpp)
-  list(APPEND HEADERS DVBridgeState.h)
+  list(APPEND HEADERS DVBridgeRefused.h
+                      DVBridgeState.h)
 endif()
 core_add_library(windowing_gbm_drm)
