--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeRefused.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/*
+ * Hades: what the kernel said of a refused request of native Dolby Vision output (the names of
+ * the bits of the read-only connector property DVBRIDGE_REFUSED, from i915 and amdgpu with the
+ * Hades patches), as a reason of the player information (hades.dv.reason). Pure: a test builds
+ * it on the host.
+ */
+namespace DVBRIDGE::REFUSED
+{
+//! The name of the property, and the bit of the HDR10 depth guard (DVBRIDGE_HDR10_DEEP_COLOR)
+constexpr std::string_view PROPERTY = "DVBRIDGE_REFUSED";
+constexpr std::string_view HDR10_DEPTH = "hdr10-depth";
+
+inline bool Has(const std::vector<std::string>& names, std::string_view name)
+{
+  return std::ranges::find(names, name) != names.end();
+}
+
+/*!
+ * \brief The reason code for the player information, from the names the kernel gave, or ""
+ *        when they say nothing that a user can act on (or nothing at all)
+ *
+ * What is in the path or in the link comes first (it holds for any request), what the request
+ * itself had last. Codes: converter (not a native HDMI link: an LSPCON, a DisplayPort adaptor or
+ * converter), sink (the display is driven as DVI or takes no HDMI InfoFrames), frl (the link
+ * runs HDMI FRL), link (the link does not carry the mode in 8-bit RGB: TMDS clock, or YCbCr 4:2:0
+ * only), driveredid (the driver does not take the display's Dolby Vision block), rate (the
+ * display takes Dolby Vision at 2160p up to 30 Hz only), output (the tunnel is off in the driver
+ * or not offered for this hardware), refused (the driver refused what Kodi asked for: the
+ * kernel log says what it found).
+ */
+inline std::string Code(const std::vector<std::string>& names)
+{
+  if (Has(names, "converter"))
+    return "converter";
+  if (Has(names, "sink"))
+    return "sink";
+  if (Has(names, "frl"))
+    return "frl";
+  if (Has(names, "tmds") || Has(names, "ycbcr420"))
+    return "link";
+  if (Has(names, "edid"))
+    return "driveredid";
+  if (Has(names, "edid-2160p30"))
+    return "rate";
+  if (Has(names, "disabled"))
+    return "output";
+  if (Has(names, "format") || Has(names, "mode") || Has(names, "clone") ||
+      Has(names, "scanout") || Has(names, "other"))
+    return "refused";
+  return "";
+}
+
+//! The names, separated by commas, for the log
+inline std::string Join(const std::vector<std::string>& names)
+{
+  std::string joined;
+  for (const auto& name : names)
+  {
+    if (!joined.empty())
+      joined += ", ";
+    joined += name;
+  }
+  return joined;
+}
+} // namespace DVBRIDGE::REFUSED
