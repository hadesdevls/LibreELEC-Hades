diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 019dd5d..79039fb 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -18,6 +18,7 @@
 #include "drm/DRMDisplayWatch.h"
 #ifdef HAVE_DVBRIDGE
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
+#include "drm/DVBridgeRefused.h"
 #include "drm/DVBridgeState.h"
 #endif
 #include "drm/DRMLegacy.h"
@@ -1063,6 +1064,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
   const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
   auto backend = CDVBridgeState::Backend::NONE;
+  // (Hades: the code of the failure, where the driver said why it refused)
+  std::string failedCode;
   if (DVTurnedOff())
   {
     // Hades: the user's own choice, before anything of the display
@@ -1072,7 +1075,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   }
   else if (m_dvDisabled)
   {
-    code = "failed";
+    failedCode = DVFailedCode();
+    code = failedCode.c_str();
     reason = "disabled after a failure (see the DVBridge errors above); tried again with a later "
              "video";
   }
@@ -1110,7 +1114,17 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
     reason = "no connected output";
   }
   else if ((backend = CDVBridgeState::GetBackend(*connector)) ==
-           CDVBridgeState::Backend::NONE)
+               CDVBridgeState::Backend::NONE &&
+           connector->GetType() == "DP")
+  {
+    // Hades: a TV with Dolby Vision Standard on a DisplayPort output is behind a converter
+    // (an LSPCON on the board, as on many Intel desktops, or a DisplayPort or USB-C adapter):
+    // the tunnel is an HDMI one, and only a native HDMI output of the graphics card has it.
+    code = "converter";
+    reason = "the display is on a DisplayPort output, through a converter (an LSPCON on the board, "
+             "or a DisplayPort or USB-C to HDMI adapter); native output needs a native HDMI output";
+  }
+  else if (backend == CDVBridgeState::Backend::NONE)
   {
     code = "output";
     reason = "the output driver has no Dolby Vision backend";
@@ -1119,7 +1133,7 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
            (info->StandardDolbyVisionVersion() != 2 || !info->StandardDolbyVisionBlockIs12Bytes() ||
             info->EdidExtendedByEEODB()))
   {
-    code = "output";
+    code = "driveredid";
     reason = "the driver's Dolby Vision backend takes 12-byte version 2 Dolby Vision blocks only, "
              "in an EDID without an extension override (EEODB)";
   }
@@ -1142,6 +1156,17 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   {
     code = "mode";
     reason = "the output mode is not 3840x2160 progressive at 23.976 to 60 Hz";
+    // Hades: ... and none that is, on this output (an HDMI 1.4 port, cable, adapter or TV input
+    // at a lower clock than 3840x2160 needs, as a DisplayPort dual-mode adapter of the first type)
+    bool offered = false;
+    for (int i = 0; !offered && i < connector->GetModesCount(); ++i)
+      offered = IsDVTransportMode(*connector->GetModeForIndex(i));
+    if (!offered)
+    {
+      code = "nomode";
+      reason = "the output offers no 3840x2160 progressive mode at 23.976 to 60 Hz (an HDMI 1.4 "
+               "port, cable, adapter or TV input, or a DisplayPort dual-mode adapter, limits it)";
+    }
   }
   if (anyMode)
     return reason == nullptr;
@@ -1188,7 +1213,7 @@ std::string CWinSystemGbm::NativeDVOutputReason() const
   if (DVTurnedOff())
     return "settings";
   if (m_dvDisabled)
-    return "failed";
+    return DVFailedCode();
   std::unique_lock lock(m_dvOutputStatusLock);
   return m_dvOutputReason;
 }
@@ -1229,20 +1254,32 @@ bool CWinSystemGbm::NativeDVTakesRate(double refresh) const
 
 void CWinSystemGbm::DisableNativeDVOutput(const char* reason)
 {
+  // Hades: what the driver said of the refusals of this native output (DVBRIDGE_REFUSED), for the
+  // player information and the log: the refusals since the output was captured for it, or since
+  // a commit of it was last accepted
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const std::vector<std::string> refused = drm ? drm->DVRefused() : std::vector<std::string>{};
   unsigned int wait;
   {
     std::unique_lock lock(m_dvRetryLock);
     if (m_dvDisabled)
       return;
+    {
+      std::unique_lock statusLock(m_dvOutputStatusLock);
+      m_dvFailedCode = DVBRIDGE::REFUSED::Code(refused);
+    }
     m_dvDisabled = true;
     m_dvRetryBackoff = std::min(m_dvRetryBackoff ? m_dvRetryBackoff * 2 : 1u, 8u);
     m_dvRetryWait = m_dvRetryBackoff;
     wait = m_dvRetryWait;
   }
   CLog::Log(LOGERROR,
-            "DVBridge: native Dolby Vision output disabled: {}; the video continues on the "
+            "DVBridge: native Dolby Vision output disabled: {}{}; the video continues on the "
             "ordinary output. It is tried again with {}",
             reason,
+            refused.empty() ? std::string()
+                            : " (the driver refused it for: " + DVBRIDGE::REFUSED::Join(refused) +
+                                  "; the kernel log says what it found)",
             wait == 1 ? std::string("the next video")
                       : "the video that starts " + std::to_string(wait) +
                             " videos after this one, or the next one if the display changes");
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index fd280f7..33e07db 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -118,7 +118,11 @@ public:
   void DVStreamWithoutNativeOutput();
   //! Short code of the reason why native Dolby Vision output is unavailable, from the last
   //! SupportsNativeDVOutput() verdict: settings (turned off by the user), failed, edid, invalid,
-  //! legacy, display, output, range, rate or mode; empty if available.
+  //! legacy, display, output, range, rate or mode; empty if available. Hades: also converter (the
+  //! display is on a DisplayPort output, or the driver found a converter in the path), driveredid
+  //! (the driver does not take the display's Dolby Vision block), nomode (no 3840x2160 mode at 24
+  //! to 60 Hz on this output), and, in place of failed when the driver said why it refused
+  //! (DVBRIDGE::REFUSED::Code()): sink, frl, link, rate, output or refused.
   std::string NativeDVOutputReason() const;
   //! The Dolby Vision support the display advertises: standard, invalid (a Dolby Vision block that
   //! is not read: an EDID block that is not valid, or several), legacy (Dolby Vision Standard in an
@@ -235,6 +239,15 @@ protected:
   mutable std::mutex m_dvOutputStatusLock;
   mutable std::string m_dvOutputStatus;
   mutable std::string m_dvOutputReason;
+  //! Hades: the reason code of the failure that disabled native output, from what the driver
+  //! said of its refusal (DisableNativeDVOutput()); empty when it said nothing (under
+  //! m_dvOutputStatusLock)
+  std::string m_dvFailedCode;
+  std::string DVFailedCode() const
+  {
+    std::unique_lock lock(m_dvOutputStatusLock);
+    return m_dvFailedCode.empty() ? "failed" : m_dvFailedCode;
+  }
   //! A display that offers Dolby Vision was seen in this session (at init, or by a later look): it
   //! is looked at again with each video even while its EDID offers no Dolby Vision (an input
   //! setting, a failed read), so that what it offers again is seen.
