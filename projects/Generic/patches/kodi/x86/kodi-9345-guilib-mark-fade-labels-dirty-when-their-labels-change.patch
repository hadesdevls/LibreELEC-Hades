From 20c18bb7637dc038ff9eee273e951cde24911883 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sun, 11 Oct 2026 03:47:10 +0200
Subject: [PATCH] [guilib] Mark fade labels dirty when their labels change

Setting a fade label's text by message resets its "all labels shown"
state, which is only updated again in Process(). The control wasn't
marked dirty, so with smart redraw an idle window was not processed.
The notification dialog waits for its fade labels to be shown before
it shows the next queued notification or closes, so it got stuck when
a notification was queued while another one was shown.

(cherry picked from commit bfe67cfba71f8c4ff110c3d1b932f90d5b7b8209)
---
 xbmc/guilib/GUIFadeLabelControl.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/guilib/GUIFadeLabelControl.cpp b/xbmc/guilib/GUIFadeLabelControl.cpp
index 65bb580..8866ef6 100644
--- a/xbmc/guilib/GUIFadeLabelControl.cpp
+++ b/xbmc/guilib/GUIFadeLabelControl.cpp
@@ -228,6 +228,7 @@ bool CGUIFadeLabelControl::OnMessage(CGUIMessage& message)
     if (message.GetMessage() == GUI_MSG_LABEL_ADD)
     {
       AddLabel(message.GetLabel());
+      MarkDirtyRegion();
       return true;
     }
     if (message.GetMessage() == GUI_MSG_LABEL_RESET)
@@ -236,6 +237,7 @@ bool CGUIFadeLabelControl::OnMessage(CGUIMessage& message)
       m_infoLabels.clear();
       m_allLabelsShown = true;
       m_scrollInfo.Reset();
+      MarkDirtyRegion();
       return true;
     }
     if (message.GetMessage() == GUI_MSG_LABEL_SET)
@@ -245,6 +247,7 @@ bool CGUIFadeLabelControl::OnMessage(CGUIMessage& message)
       m_allLabelsShown = true;
       m_scrollInfo.Reset();
       AddLabel(message.GetLabel());
+      MarkDirtyRegion();
       return true;
     }
   }
