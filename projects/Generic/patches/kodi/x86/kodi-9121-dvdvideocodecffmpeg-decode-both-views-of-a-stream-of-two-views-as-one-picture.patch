 #ifdef HAVE_DVBRIDGE
   // Submit the enhancement layer once for each base packet the decoder took, also when it
   // reported an error for it (it may still output a picture, which then waits for its
@@ -935,10 +1057,15 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPicture(VideoPicture* pVideoPi
   VCReturn result = GetPairedPicture(pVideoPicture);
   if (result == VC_PICTURE)
     CheckNativeDVPicture(pVideoPicture);
-  return result;
 #else
-  return GetBasePicture(pVideoPicture);
