+#pragma once
+
+#include "cores/VideoPlayer/MultiviewChoice.h"
+
+#include <cstdint>
+#include <optional>
+
+struct AVCodecContext;
+struct AVFrame;
+
+/*!
+ * \brief Makes one picture of the two views of an access unit
+ *
+ * The decoder of a stream that codes its two eyes as two views (H.264 MVC) gives each view as
+ * a picture of its own. Kodi shows a stereoscopic video from one picture that holds both eyes,
+ * so the two pictures of an access unit are put side by side here, at their full size, the left
+ * eye on the left, and that picture goes on as the picture of the decoder.
+ *
+ * What is decided is in KODI::MULTIVIEW (MultiviewChoice.h): which pictures belong together,
+ * and that a base view without its second view goes out alone, in both halves, while a second
+ * view without its base view is never shown. Here are the pictures themselves.
+ */
+class CMultiviewPacker
+{
+public:
+  explicit CMultiviewPacker(KODI::MULTIVIEW::BaseEye baseEye);
+  ~CMultiviewPacker();
+
+  CMultiviewPacker(const CMultiviewPacker&) = delete;
+  CMultiviewPacker& operator=(const CMultiviewPacker&) = delete;
+
+  //! Whether it can be used (it could get what it needs)
+  bool IsValid() const { return m_waiting && m_packed; }
+
+  enum class Result
+  {
+    NONE, //!< no picture goes out yet
+    PICTURE, //!< the frame holds the picture that goes out
+    FAILED, //!< a picture could not be made: the second view is given up (see GivenUp())
+  };
+
+  /*!
+   * \brief Takes a picture that the decoder gave
+   * \param frame the picture. It is taken; when a picture goes out, it holds that one, and else
+   *        nothing
+   * \param decoder the decoder, asked once which of its views is the base view
+   */
+  Result Add(AVFrame* frame, AVCodecContext* decoder);
+
+  /*!
+   * \brief The decoder has no more pictures: a base view that still waits goes out alone
+   * \param frame as for Add(), with nothing in it at first
+   */
+  Result Flush(AVFrame* frame);
+
+  //! The pictures from before are not followed by those to come (a seek)
+  void Reset();
+
+  //! A packet went to the decoder, which took it or refused it
+  void Sent(bool refused);
+
+  //! The second view cannot be had for this stream, for a reason that is not one of the pictures
+  void Fail(const char* reason);
+
+  //! Whether the stream should go back to the decoder of every other stream, for its base view
+  bool GivenUp() const;
+  //! ... and why, in words for the log
+  const char* Reason() const;
+
+  uint64_t Paired() const { return m_paired; }
+  uint64_t Alone() const { return m_alone; }
+  uint64_t Unshown() const { return m_unshown; }
+
+private:
+  bool Pack(const AVFrame* base, const AVFrame* other);
+  void Keep(AVFrame* frame, const KODI::MULTIVIEW::View& view);
+  void Forget();
+  Result Out(AVFrame* frame, bool packed, bool paired);
+
+  const KODI::MULTIVIEW::BaseEye m_baseEye;
+  AVFrame* m_waiting{nullptr}; //!< the picture that waits for the other view of its access unit
+  std::optional<KODI::MULTIVIEW::View> m_waitingView; //!< ... and what it is, when one waits
+  AVFrame* m_packed{nullptr}; //!< where a picture of two views is made
+  std::optional<int> m_baseId; //!< the view that is the base view, once a picture named its view
+  uint64_t m_paired{0}; //!< pictures of two views gone out
+  uint64_t m_alone{0}; //!< base views gone out alone
+  uint64_t m_unshown{0}; //!< second views that came without their base view
+  unsigned int m_refused{0}; //!< packets in a row that the decoder refused
+  const char* m_failure{nullptr};
+};
