+  // is decoded (the decoder of both views could not be had, or was given up): its pictures say
+  // that they are no such picture, so that nothing takes a half of them for an eye.
+  if (result == VC_PICTURE && m_multiviewFailed && m_hints.multiview)
+    pVideoPicture->stereoMode = KODI::MULTIVIEW::BASE_ONLY_STEREO_MODE;
+  return result;
 }
 
