+bool CDVDVideoCodecFFmpeg::OpenWithoutMultiview(CDVDStreamInfo& hints,
+                                                CDVDCodecOptions& options,
+                                                int decoderState,
+                                                const char* reason)
+{
+  CLog::Log(LOGINFO,
+            "CDVDVideoCodecFFmpeg::Open() the decoder of both views ({}) is not used for this "
+            "stream ({}): its base view plays, as before",
+            KODI::MULTIVIEW::DECODER_NAME, reason);
+  avcodec_free_context(&m_pCodecContext);
+  m_multiview.reset();
+  m_multiviewFailed = true;
+  // as it was before that decoder was tried: the stream is opened as it would have been
+  m_decoderState = decoderState;
+  return Open(hints, options);
+}
+
+int CDVDVideoCodecFFmpeg::ReceiveMultiviewFrame(int result)
+{
+  // The decoder gives the two views of an access unit one after the other, as two pictures.
+  // They are taken until they make one picture, so that a packet gives a picture as it does
+  // with any other stream. At the end of the stream a base view that still waits for its
+  // second view goes out alone.
+  for (;;)
+  {
+    CMultiviewPacker::Result made = CMultiviewPacker::Result::NONE;
+    if (result == 0)
+      made = m_multiview->Add(m_pDecodedFrame, m_pCodecContext);
+    else if (result == AVERROR_EOF)
+      made = m_multiview->Flush(m_pDecodedFrame);
+    else
+      return result;
+
+    if (made == CMultiviewPacker::Result::PICTURE)
+      return 0;
+    if (result == AVERROR_EOF)
+      return result;
+    // no picture could be made: the second view is given up, by the caller
+    if (made == CMultiviewPacker::Result::FAILED)
+      return AVERROR(EAGAIN);
+    result = avcodec_receive_frame(m_pCodecContext, m_pDecodedFrame);
+  }
+}
+
+CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::LeaveMultiview()
+{
+  CLog::Log(LOGINFO,
+            "CDVDVideoCodecFFmpeg: the decoder of both views is given up for this stream ({}): "
+            "its base view plays, as before",
+            m_multiview->Reason());
+  av_frame_unref(m_pDecodedFrame);
+  m_multiviewFailed = true;
+  // The stream is opened again as at first: with the decoder of every other stream, and with
+  // hardware decoding where there is. The player sends the packets since the last key frame
+  // again (VC_REOPEN).
+  m_decoderState = STATE_NONE;
+  return VC_REOPEN;
+}
+
 void CDVDVideoCodecFFmpeg::Dispose()
 {
+  if (m_multiview)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecFFmpeg: of this stream of two views, {} pictures went out with both "
+              "views and {} with the base view alone; {} second views came without their base "
+              "view and were not shown",
+              m_multiview->Paired(), m_multiview->Alone(), m_multiview->Unshown());
+    m_multiview.reset();
+  }
 #ifdef HAVE_DVBRIDGE
   // The pictures that went out without their enhancement picture kept the metadata carried with
   // their base picture, which in such a stream is the one of a neighbouring picture.
@@ -789,6 +907,10 @@ bool CDVDVideoCodecFFmpeg::AddData(const DemuxPacket &packet)
     }
   }
 
+  // Hades: the decoder of both views is given up when it takes nothing of the stream
