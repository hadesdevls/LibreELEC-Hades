+namespace
+{
+// a picture without a presentation time has none for KODI::MULTIVIEW either
+static_assert(NO_TIME == AV_NOPTS_VALUE);
+
+View Describe(const AVFrame* frame)
+{
+  View view;
+  // the decoder names the view of a picture when it outputs more than one view
+  const AVFrameSideData* side = av_frame_get_side_data(frame, AV_FRAME_DATA_VIEW_ID);
+  if (side && side->size >= sizeof(int))
+  {
+    view.hasId = true;
+    std::memcpy(&view.id, side->data, sizeof(int));
+  }
+  view.time = frame->pts;
+  view.width = frame->width;
+  view.height = frame->height;
+  view.format = frame->format;
+  return view;
+}
+
+// The base view is the first of the views that the decoder lists. Where it lists none, it is
+// the view of the picture that asks, the first one that came with the name of its view.
+int BaseView(AVCodecContext* decoder, int asking)
+{
+  unsigned int count = 0;
+  int64_t first = 0;
+  if (decoder &&
+      av_opt_get_array_size(decoder, DECODER_VIEW_LIST_OPTION, AV_OPT_SEARCH_CHILDREN, &count) >=
+          0 &&
+      count > 0 &&
+      av_opt_get_array(decoder, DECODER_VIEW_LIST_OPTION, AV_OPT_SEARCH_CHILDREN, 0, 1,
+                       AV_OPT_TYPE_INT64, &first) >= 0)
+    return static_cast<int>(first);
+  return asking;
+}
+} // namespace
+
+CMultiviewPacker::CMultiviewPacker(BaseEye baseEye)
+  : m_baseEye(baseEye),
+    m_waiting(av_frame_alloc()),
+    m_packed(av_frame_alloc())
+{
+}
+
+CMultiviewPacker::~CMultiviewPacker()
+{
+  av_frame_free(&m_waiting);
+  av_frame_free(&m_packed);
+}
+
+bool CMultiviewPacker::Pack(const AVFrame* base, const AVFrame* other)
+{
+  av_frame_unref(m_packed);
+
+  // only pictures that are in memory as whole bytes
+  const auto format = static_cast<AVPixelFormat>(base->format);
+  const AVPixFmtDescriptor* desc = av_pix_fmt_desc_get(format);
+  if (!desc || (desc->flags & (AV_PIX_FMT_FLAG_HWACCEL | AV_PIX_FMT_FLAG_PAL |
+                               AV_PIX_FMT_FLAG_BITSTREAM)))
+    return false;
+  // a picture that the decoder left to be cropped by whoever shows it
+  if (base->crop_left || base->crop_right || base->crop_top || base->crop_bottom)
+    return false;
+
+  const auto size =
+      PackedPicture(base->width, base->height, base->sample_aspect_ratio.num,
+                    base->sample_aspect_ratio.den, desc->log2_chroma_w);
+  if (!size)
+    return false;
+
+  m_packed->format = base->format;
+  m_packed->width = size->width;
+  m_packed->height = size->height;
+  // the times, the flags and the colours of the picture are those of its base view
+  if (av_frame_get_buffer(m_packed, 0) < 0 || av_frame_copy_props(m_packed, base) < 0)
+  {
+    av_frame_unref(m_packed);
+    return false;
+  }
+
+  // a base view that goes out alone is what both eyes see
+  const AVFrame* second = other ? other : base;
+  const AVFrame* halves[2] = {BaseOnLeft(m_baseEye) ? base : second,
+                              BaseOnLeft(m_baseEye) ? second : base};
+  for (int half = 0; half < 2; ++half)
+  {
+    uint8_t* data[4] = {};
+    int linesize[4] = {};
+    const uint8_t* source[4] = {};
+    int sourceLinesize[4] = {};
+    for (int plane = 0; plane < 4; ++plane)
+    {
+      if (!m_packed->data[plane])
+        continue;
+      // what a row of one view takes in this plane, which is where the right half starts
+      const int bytes = av_image_get_linesize(format, base->width, plane);
+      if (bytes <= 0 || !halves[half]->data[plane] || halves[half]->linesize[plane] < bytes ||
+          m_packed->linesize[plane] < 2 * bytes)
+      {
+        av_frame_unref(m_packed);
+        return false;
+      }
+      data[plane] = m_packed->data[plane] + half * bytes;
+      linesize[plane] = m_packed->linesize[plane];
+      source[plane] = halves[half]->data[plane];
+      sourceLinesize[plane] = halves[half]->linesize[plane];
+    }
+    av_image_copy(data, linesize, source, sourceLinesize, format, base->width, base->height);
+  }
+
+  m_packed->sample_aspect_ratio = AVRational{size->sarNum, size->sarDen};
+  av_frame_remove_side_data(m_packed, AV_FRAME_DATA_VIEW_ID);
+  // The picture says what it is. The stream was announced the same way, but what a picture
+  // says of itself is believed first.
+  if (av_dict_set(&m_packed->metadata, "stereo_mode", PACKED_STEREO_MODE, 0) < 0)
+  {
+    av_frame_unref(m_packed);
+    return false;
+  }
+  return true;
+}
+
+void CMultiviewPacker::Keep(AVFrame* frame, const View& view)
+{
+  av_frame_unref(m_waiting);
+  av_frame_move_ref(m_waiting, frame);
+  m_waitingView = view;
+}
+
+void CMultiviewPacker::Forget()
+{
+  av_frame_unref(m_waiting);
+  m_waitingView.reset();
+}
+
+CMultiviewPacker::Result CMultiviewPacker::Out(AVFrame* frame, bool packed, bool paired)
+{
+  if (!packed)
+  {
+    Fail("a picture of its two views could not be made");
+    return Result::FAILED;
+  }
+  av_frame_move_ref(frame, m_packed);
+  if (paired)
+    ++m_paired;
+  else
+    ++m_alone;
+  return Result::PICTURE;
+}
+
+CMultiviewPacker::Result CMultiviewPacker::Add(AVFrame* frame, AVCodecContext* decoder)
+{
+  const View view = Describe(frame);
+  if (view.hasId && !m_baseId)
+  {
+    m_baseId = BaseView(decoder, view.id);
+    CLog::Log(LOGINFO,
+              "CMultiviewPacker: the decoder gives the views of the stream; view {} is the base "
+              "view, which is the {} eye",
+              *m_baseId, BaseOnLeft(m_baseEye) ? "left" : "right");
+  }
+  const int baseId = m_baseId.value_or(0);
+
+  switch (Take(m_waitingView, view, baseId))
+  {
+    case Step::KEEP:
+      Keep(frame, view);
+      return Result::NONE;
+    case Step::REPLACE:
+      ++m_unshown;
+      Keep(frame, view);
+      return Result::NONE;
+    case Step::PAIR:
+    {
+      const bool packed =
+          IsBase(*m_waitingView, baseId) ? Pack(m_waiting, frame) : Pack(frame, m_waiting);
+      Forget();
+      av_frame_unref(frame);
+      return Out(frame, packed, true);
+    }
+    case Step::ALONE_THEN_KEEP:
+    {
+      const bool packed = Pack(m_waiting, nullptr);
+      Keep(frame, view);
+      return Out(frame, packed, false);
+    }
+  }
+  return Result::NONE;
+}
+
+CMultiviewPacker::Result CMultiviewPacker::Flush(AVFrame* frame)
+{
+  if (!AloneAtEnd(m_waitingView, m_baseId.value_or(0)))
+  {
+    if (m_waitingView)
+      ++m_unshown;
+    Forget();
+    return Result::NONE;
+  }
+  const bool packed = Pack(m_waiting, nullptr);
+  Forget();
+  av_frame_unref(frame);
+  return Out(frame, packed, false);
+}
+
+void CMultiviewPacker::Reset()
+{
+  Forget();
+  av_frame_unref(m_packed);
+  m_refused = 0;
+}
+
+void CMultiviewPacker::Sent(bool refused)
+{
+  m_refused = refused ? m_refused + 1 : 0;
+}
+
+void CMultiviewPacker::Fail(const char* reason)
+{
+  if (!m_failure)
+    m_failure = reason;
+}
+
+bool CMultiviewPacker::GivenUp() const
+{
+  return m_failure || GiveUp(m_paired, m_alone, m_refused);
+}
+
+const char* CMultiviewPacker::Reason() const
+{
+  if (m_failure)
+    return m_failure;
+  if (m_refused >= REFUSED_UNTIL_GIVEN_UP)
+    return "the decoder refuses its packets";
+  return "its second view does not come";
+}
