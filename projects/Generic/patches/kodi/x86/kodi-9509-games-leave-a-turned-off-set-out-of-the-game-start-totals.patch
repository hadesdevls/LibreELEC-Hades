From bdb471885f515de051b9d273a59b23a44b3a076a Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 23 Oct 2026 18:03:59 +0100
Subject: [PATCH] [Games] Leave a turned-off set out of the game-start totals

The game-start toast counted every achievement, including those of a set
the player turned off. The client reports its sets after the game has
loaded, and the set is only turned off again then. When a set is turned
off and the client reports sets, the toast now waits for them and counts
what they leave.

(cherry picked from commit a639646f694fb06e6c360b374b6bdb17d7432674)
---
 xbmc/games/GameSettings.cpp                   |  5 +++
 xbmc/games/GameSettings.h                     |  5 +++
 .../addons/cheevos/GameClientCheevos.cpp      | 42 +++++++++++++++----
 xbmc/games/addons/cheevos/GameClientCheevos.h | 21 ++++++++++
 4 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/xbmc/games/GameSettings.cpp b/xbmc/games/GameSettings.cpp
index 93040ee..a9d5c3f 100644
--- a/xbmc/games/GameSettings.cpp
+++ b/xbmc/games/GameSettings.cpp
@@ -155,6 +155,11 @@ bool CGameSettings::IsAchievementSetDisabled(unsigned int setId) const
   return std::ranges::find(disabled, std::to_string(setId)) != disabled.end();
 }
 
+bool CGameSettings::HasDisabledAchievementSets() const
+{
+  return !m_settings->GetString(SETTING_GAMES_ACHIEVEMENTS_DISABLED_SETS).empty();
+}
+
 void CGameSettings::SetAchievementSetDisabled(unsigned int setId, bool disabled)
 {
   std::vector<std::string> sets =
diff --git a/xbmc/games/GameSettings.h b/xbmc/games/GameSettings.h
index 5a5daee..fa480cc 100644
--- a/xbmc/games/GameSettings.h
+++ b/xbmc/games/GameSettings.h
@@ -90,6 +90,11 @@ public:
    */
   bool IsAchievementSetDisabled(unsigned int setId) const;
 
+  /*!
+   * \brief Whether the player turned any achievement set off
+   */
+  bool HasDisabledAchievementSets() const;
+
   /*!
    * \brief Remember whether the player turned an achievement set off
    */
diff --git a/xbmc/games/addons/cheevos/GameClientCheevos.cpp b/xbmc/games/addons/cheevos/GameClientCheevos.cpp
index 4b27f2d..2236963 100644
--- a/xbmc/games/addons/cheevos/GameClientCheevos.cpp
+++ b/xbmc/games/addons/cheevos/GameClientCheevos.cpp
@@ -197,9 +197,29 @@ void CGameClientCheevos::OnGameLoaded(const game_rc_game_loaded& data)
 
   NotifyDialogs();
 
+  m_startupToast.reset();
   if (achievementState.totalAchievements == 0)
     return;
 
+  // Kodi's texture cache resolves remote URLs; an empty path falls back to
+  // the default icon
+  m_startupToast =
+      StartupToast{SafeString(data.icon_url), !gameTitle.empty() ? gameTitle : Localize(35264)};
+
+  // A set the player turned off is turned off again once the client reports
+  // its sets, which takes it out of the totals
+  if (!CServiceBroker::GetGameServices().GameSettings().HasDisabledAchievementSets() ||
+      !ReportsAchievementSets())
+    QueueStartupToast();
+}
+
+void CGameClientCheevos::QueueStartupToast()
+{
+  if (!m_startupToast)
+    return;
+
+  const AchievementState state = CServiceBroker::GetGameServices().AchievementRuntime().GetState();
+
   // RetroAchievements asks for the mode to be shown as a game starts. The
   // setting is the mode in force by now: resuming a save state has already
   // dropped it to casual.
@@ -207,15 +227,12 @@ void CGameClientCheevos::OnGameLoaded(const game_rc_game_loaded& data)
   // "Hardcore mode: {0:d} of {1:d} achievements unlocked" or
   // "{0:d} of {1:d} achievements unlocked"
   const bool hardcore = CServiceBroker::GetGameServices().GameSettings().GetAchievementsHardcore();
-  const std::string description =
-      StringUtils::Format(Localize(hardcore ? 35703 : 35284), achievementState.unlockedAchievements,
-                          achievementState.totalAchievements);
+  const std::string description = StringUtils::Format(
+      Localize(hardcore ? 35703 : 35284), state.unlockedAchievements, state.totalAchievements);
 
-  // Kodi's texture cache resolves remote URLs; an empty path falls back to
-  // the default icon
-  CGUIDialogKaiToast::QueueNotification(
-      SafeString(data.icon_url), !gameTitle.empty() ? gameTitle : Localize(35264), description,
-      TOAST_DISPLAY_TIME_MS, false, TOAST_MESSAGE_TIME_MS);
+  CGUIDialogKaiToast::QueueNotification(m_startupToast->icon, m_startupToast->title, description,
+                                        TOAST_DISPLAY_TIME_MS, false, TOAST_MESSAGE_TIME_MS);
+  m_startupToast.reset();
 }
 
 void CGameClientCheevos::OnAchievementTriggered(const game_rc_achievement_triggered& data)
@@ -352,6 +369,7 @@ void CGameClientCheevos::OnAchievementSets(const game_rc_achievement_sets& data)
                                    { return OnAchievementSetToggled(setId, enabled); });
 
   NotifyDialogs();
+  QueueStartupToast();
 }
 
 bool CGameClientCheevos::OnAchievementSetToggled(unsigned int setId, bool enabled)
@@ -725,6 +743,14 @@ void CGameClientCheevos::DropHardcore()
                                         Localize(35306));
 }
 
+bool CGameClientCheevos::ReportsAchievementSets() const
+{
+  std::unique_lock lock(m_clientAccess);
+
+  // Left unset by a client older than game API 8.5.0
+  return m_struct.toAddon->RCSetAchievementSetEnabled != nullptr;
+}
+
 bool CGameClientCheevos::SetAchievementSetEnabled(unsigned int setId, bool enabled)
 {
   std::unique_lock lock(m_clientAccess);
diff --git a/xbmc/games/addons/cheevos/GameClientCheevos.h b/xbmc/games/addons/cheevos/GameClientCheevos.h
index d3ce19b..9978203 100644
--- a/xbmc/games/addons/cheevos/GameClientCheevos.h
+++ b/xbmc/games/addons/cheevos/GameClientCheevos.h
@@ -11,6 +11,7 @@
 #include "utils/Observer.h"
 
 #include <atomic>
+#include <optional>
 #include <string>
 
 class CCriticalSection;
@@ -164,6 +165,11 @@ private:
    */
   bool SetEncoreModeEnabled(bool enabled);
 
+  /*!
+   * \brief Whether the client reports a game's achievement sets
+   */
+  bool ReportsAchievementSets() const;
+
   /*!
    * \brief Tell the client to turn an achievement set on or off
    */
@@ -176,6 +182,17 @@ private:
    */
   bool OnAchievementSetToggled(unsigned int setId, bool enabled);
 
+  /*!
+   * \brief Show the game's achievement totals, if the toast is waiting
+   */
+  void QueueStartupToast();
+
+  struct StartupToast
+  {
+    std::string icon;
+    std::string title;
+  };
+
   CGameClient& m_gameClient;
   AddonInstance_Game& m_struct;
   CCriticalSection& m_clientAccess;
@@ -190,6 +207,10 @@ private:
   //! change on the player's thread as well as Kodi's.
   std::atomic<bool> m_hardcoreEnabled{false};
 
+  //! The game-start toast until it is shown. Only touched on the add-on's
+  //! thread.
+  std::optional<StartupToast> m_startupToast;
+
   //! Whether this instance is registered with the game settings. Only touched
   //! on Kodi's thread, either side of a game.
   bool m_observingSettings{false};
