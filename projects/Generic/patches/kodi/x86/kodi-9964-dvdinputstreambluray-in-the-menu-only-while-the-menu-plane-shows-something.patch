From 8ebb865b8d9511cf482219727426291671c9b7bb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 5 Nov 2026 07:32:08 +0000
Subject: [PATCH] DVDInputStreamBluray: in the menu only while the menu plane
 shows something

IsInMenu() took a Blu-ray played with its menus to be in its menu whenever
any graphics were up: a BD-J disc keeps its graphics plane open, and fully
transparent, through the whole film, and PG subtitles counted too. Kodi
then sent every key to the disc, with the key map of the video menu, so
nothing could seek, the arrows did not move through the film and the
player information did not open.

The disc is now in its menu while its IG plane (the menus of HDMV, the
graphics of BD-J) has an image with a palette, or an ARGB pixel that is
not fully transparent, or while the disc says so (BD_EVENT_MENU). PG alone
is subtitles. What the start of a disc with no playlist goes by
(HasOverlayGraphics(), CheckMenuOnlyStart()) is as it was. kodi.log says
when the menu plane starts or stops showing something.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 37 ++++++++++++++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    |  5 +++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 0dd6123..875f35f 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1205,6 +1205,7 @@ void CDVDInputStreamBluray::OverlayClose()
   group->SetOverlayContainerFlushable(false);
   m_player->OnDiscNavResult(static_cast<void*>(&group), BD_EVENT_MENU_OVERLAY);
   m_hasOverlay = false;
+  m_menuShows = false;
 #endif
 }
 
@@ -1256,6 +1257,27 @@ void CDVDInputStreamBluray::OverlayClear(SPlane& plane, int x, int y, int w, int
 #endif
 }
 
+bool CDVDInputStreamBluray::PlaneShows(const SPlane& plane)
+{
+#if(BD_OVERLAY_INTERFACE_VERSION >= 2)
+  for (const SOverlay& o : plane.o)
+  {
+    if (!o->palette.empty())
+      return true;
+    // ARGB as libbluray gives it: one 32-bit word for each pixel, alpha in its top byte
+    const size_t count = o->pixels.size() / 4;
+    for (size_t i = 0; i < count; ++i)
+    {
+      uint32_t pixel;
+      memcpy(&pixel, o->pixels.data() + i * 4, sizeof(pixel));
+      if (pixel >> 24)
+        return true;
+    }
+  }
+#endif
+  return false;
+}
+
 void CDVDInputStreamBluray::OverlayFlush(int64_t pts)
 {
 #if(BD_OVERLAY_INTERFACE_VERSION >= 2)
@@ -1281,6 +1303,16 @@ void CDVDInputStreamBluray::OverlayFlush(int64_t pts)
   // background plane alone, which is a picture behind the video, not a menu
   if (!(m_planes[0].o.empty() && m_planes[1].o.empty() && !m_planes[2].o.empty()))
     m_hasOverlay = true;
+  // Hades: but the disc is in its menu (IsInMenu()) only while the IG plane (the menus of HDMV,
+  // the graphics of BD-J) shows something. A BD-J disc keeps its plane open, and fully
+  // transparent, through the film, and PG alone is subtitles: taken as a menu, as before, they
+  // sent every key to the disc (no seeking, no arrows, no player information) for the whole
+  // film. The menus of HDMV are also told by the disc itself (m_menu, BD_EVENT_MENU).
+  const bool shows = PlaneShows(m_planes[1]);
+  if (shows != m_menuShows.exchange(shows))
+    CLog::Log(LOGINFO, "CDVDInputStreamBluray - the menu plane of the disc {}",
+              shows ? "shows something: keys go to the disc"
+                    : "shows nothing: keys go to the player");
 #endif
 }
 
@@ -1415,6 +1447,8 @@ void CDVDInputStreamBluray::OverlayCallbackARGB(const struct bd_argb_overlay_s *
       // the menu graphics closed and the background stays: no menu, as a close said before
       if (m_planes[0].o.empty() && m_planes[1].o.empty())
         m_hasOverlay = false;
+      if (m_planes[1].o.empty())
+        m_menuShows = false;
     }
     return;
   }
@@ -2187,7 +2221,8 @@ bool CDVDInputStreamBluray::IsInMenu()
   // since there is no way to tell in a BD-J blu-ray when a popup menu actually is visible,
   // we have to assume that the blu-ray is in menu/navigation mode when there is an overlay
   // on screen, even if it might be invisible (which is impossible to detect)
-  if(m_menu || m_hasOverlay)
+  // (Hades: an overlay that shows nothing is no menu: m_menuShows, OverlayFlush())
+  if(m_menu || m_menuShows)
     return true;
   return false;
 }
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index e52bd46..31310a8 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -328,6 +328,9 @@ protected:
   void OverlayClose();
   static void OverlayClear(SPlane& plane, int x, int y, int w, int h);
   static void OverlayInit (SPlane& plane, int w, int h);
+  //! Hades: whether a plane shows anything: an image with a palette (HDMV) always, an ARGB one
+  //! (BD-J) only with a pixel that is not fully transparent
+  static bool PlaneShows(const SPlane& plane);
 
   IVideoPlayer* m_player = nullptr;
   //! Hades: set by Abort(); stops the tries of a read of the image (m_pstream), from another thread
@@ -347,6 +350,8 @@ protected:
   // Hades: written by the overlay callbacks (BD-J's on the JVM's graphics thread), read by the
   // player and the GUI
   std::atomic<bool> m_hasOverlay{false};
+  //! Hades: the IG plane shows something (PlaneShows()): what IsInMenu() goes by
+  std::atomic<bool> m_menuShows{false};
   //! Hades: the HAVi background plane is shown (no playlist open); read by OverlayFlush()
   std::atomic<bool> m_bgVisible{true};
   //! Hades: BD-J presentation timing is on for this disc (navigation mode)
-- 
