   HdmiVicSink m_hdmiVicSink; //!< Hades: see GetHdmiVicSink()
   DolbyVideoBlock m_dolbyVideo; //!< read from the raw EDID, see the constructor
   bool m_uhd420Only = false; //!< read from the raw EDID, see UhdLimitedToHdmi14()
diff --git a/xbmc/utils/EdidYcbcr422.h b/xbmc/utils/EdidYcbcr422.h
new file mode 100644
index 0000000..8812115
--- /dev/null
+++ b/xbmc/utils/EdidYcbcr422.h
@@ -0,0 +1,44 @@
+/*
