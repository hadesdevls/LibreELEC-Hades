+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace KODI::UTILS
+{
+
+/*!
+ * \brief Hades: the EDID declares YCbCr 4:2:2 in a CTA-861 extension block (byte 3, bit 4), as the
+ *        kernel reads it (drm_edid.c: EDID_CEA_YCRCB422), which is what the tunnel of HDR as
+ *        YCbCr 4:2:2 asks of the display (drm_dvbridge_hdr10t.h)
+ *
+ * A block with a wrong checksum counts for nothing (DRM takes such blocks out before a driver reads
+ * the EDID). The 4:2:2 bit that EDID 1.4 has in its base block is not read: where only that says
+ * it, the kernel says yes and this says no, which keeps the tunnel off, the safe side.
+ */
+inline bool EdidDeclaresYcbcr422(const std::vector<uint8_t>& edid)
+{
+  const size_t size = edid.size();
+  if (size < 256 || size % 128)
+    return false;
+  for (size_t block = 1; block < size / 128; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    unsigned int sum = 0;
+    for (unsigned int i = 0; i < 128; ++i)
+      sum += b[i];
+    if ((sum & 0xff) == 0 && b[0] == 0x02 && (b[3] & 0x10))
+      return true;
+  }
+  return false;
+}
+
+} // namespace KODI::UTILS
diff --git a/xbmc/windowing/gbm/HDR10Tunnel.h b/xbmc/windowing/gbm/HDR10Tunnel.h
new file mode 100644
index 0000000..1aa8fd5
--- /dev/null
+++ b/xbmc/windowing/gbm/HDR10Tunnel.h
@@ -0,0 +1,133 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: when HDR is sent over the tunnel as YCbCr 4:2:2 at 12 bits (DVBRIDGE_HDR10_TUNNEL_LAB,
+ *        linux-9932 to 9934), and why not
+ *
+ * The tunnel carries the picture packed as YCbCr 4:2:2 at 12 bits in RGB 8 bpc pixels, which the
+ * display reads as HDR in 4:2:2 (the AVI InfoFrame says so, and the HDR static metadata goes with
+ * it). It is for what the ordinary output cannot carry as well: HDR over HDMI 2.0 at 3840x2160 50
+ * and 60 Hz, where the link does not fit RGB at 10 bits and the driver sends RGB at 8 bits or YCbCr
+ * 4:2:0 at 10 (linux-9966, 9968, 9969). Where the driver itself sends 4:2:2 at 10 bits or more
+ * (amdgpu on DCN that can, linux-9972), or RGB at 10 or 12 (any other mode), the ordinary output is
+ * as good or better and the tunnel is not used.
+ *
+ * Fail closed: the format of the ordinary output must be known (DVBRIDGE_LINK_FORMAT, asked with a
+ * test commit) and worse than the tunnel's; anything not known is "no". The rule is this header
+ * alone, so that a test runs it on the host.
+ *
+ * What is NOT here: the engine that makes the picture for the tunnel (it is the one of native Dolby
+ * Vision, which takes Dolby Vision streams only: DVBRIDGE::Eligible()). See docs.
+ */
+namespace HDR10_TUNNEL
+{
+
+//! The format of the link, as DVBRIDGE_LINK_FORMAT says it for a request of the ordinary output
+enum class Link
+{
+  UNKNOWN, //!< not asked, or the driver does not say
+  RGB8, //!< RGB at 8 bits
+  RGB_DEEP, //!< RGB at 10 bits or more
+  YCBCR420,
+  YCBCR422, //!< at 10 bits or more (the driver's own 4:2:2)
+};
+
+struct Input
+{
+  bool setting = false; //!< the user allows HDR over the tunnel
+  bool kernelBackend = false; //!< the connector has DVBRIDGE_DV_STANDARD_LAB (i915, xe, amdgpu)
+  bool hasProperty = false; //!< ... and DVBRIDGE_HDR10_TUNNEL_LAB
+  bool hdmiTmds = false; //!< an HDMI connector that the driver drives as TMDS (no FRL)
+  bool displayYcbcr422 = false; //!< the EDID declares YCbCr 4:2:2 (CDisplayInfo::SupportsYCbCr422())
+  bool displayHdr = false; //!< the EDID has an HDR static metadata block
+  bool hdrPicture = false; //!< what is shown is HDR10, HLG, HDR10+ or Dolby Vision as HDR10
+  bool nativeDolbyVision = false; //!< native Dolby Vision output has the output (the other tunnel)
+  int width = 0;
+  int height = 0;
+  double refresh = 0.0;
+  Link ordinary = Link::UNKNOWN;
+};
+
+enum class Why
+{
+  USE,
+  SETTING,
+  DRIVER, //!< no kernel backend, or a kernel without the property
+  LINK, //!< not HDMI over TMDS
+  DISPLAY, //!< no 4:2:2 or no HDR in the EDID
+  PICTURE, //!< not HDR
+  DOLBY_VISION, //!< native Dolby Vision has the output
+  MODE, //!< not 3840x2160 at 50 or 60 Hz
+  ORDINARY, //!< the ordinary output is as good, or not known
+};
+
+//! 3840x2160 at 50 or 60 Hz, fractional rates included: what HDMI 2.0 does not carry as RGB at
+//! 10 bits (CTA VIC 96 and 97)
+constexpr bool IsUhd2160p50Or60(int width, int height, double refresh)
+{
+  return width == 3840 && height == 2160 && refresh >= 49.5 && refresh < 60.5;
+}
+
+constexpr Why Decide(const Input& in)
+{
+  if (!in.setting)
+    return Why::SETTING;
+  if (!in.kernelBackend || !in.hasProperty)
+    return Why::DRIVER;
+  if (!in.hdmiTmds)
+    return Why::LINK;
+  if (!in.displayYcbcr422 || !in.displayHdr)
+    return Why::DISPLAY;
+  if (!in.hdrPicture)
+    return Why::PICTURE;
+  if (in.nativeDolbyVision)
+    return Why::DOLBY_VISION;
+  if (!IsUhd2160p50Or60(in.width, in.height, in.refresh))
+    return Why::MODE;
+  if (in.ordinary != Link::RGB8 && in.ordinary != Link::YCBCR420)
+    return Why::ORDINARY;
+  return Why::USE;
+}
+
+//! The short form of a verdict, for the log and the player information
+constexpr const char* Code(Why why)
+{
+  switch (why)
+  {
+    case Why::USE:
+      return "use";
+    case Why::SETTING:
+      return "setting";
+    case Why::DRIVER:
+      return "driver";
+    case Why::LINK:
+      return "link";
+    case Why::DISPLAY:
+      return "display";
+    case Why::PICTURE:
+      return "picture";
+    case Why::DOLBY_VISION:
+      return "dolbyvision";
+    case Why::MODE:
+      return "mode";
+    case Why::ORDINARY:
+      return "ordinary";
+  }
+  return "";
+}
+
+} // namespace HDR10_TUNNEL
+} // namespace KODI::WINDOWING::GBM
