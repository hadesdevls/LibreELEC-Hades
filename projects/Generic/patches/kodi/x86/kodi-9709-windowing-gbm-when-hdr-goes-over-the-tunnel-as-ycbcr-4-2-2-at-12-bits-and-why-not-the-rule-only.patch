+++ b/xbmc/utils/DisplayInfo.cpp
@@ -9,6 +9,7 @@
 #include "DisplayInfo.h"
 
 #include "utils/EdidHdr10Plus.h"
+#include "utils/EdidYcbcr422.h"
 #include "utils/StringUtils.h"
 #include "utils/log.h"
 
@@ -398,6 +399,8 @@ CDisplayInfo::CDisplayInfo(const std::vector<uint8_t>& edid)
   m_baseBlockCopy = EdidBaseBlockCopy(edid);
   m_edidShape = EdidShapeOf(edid);
   m_uhd420Only = ScanUhd420Only(edid);
+  // Hades: YCbCr 4:2:2 as the kernel reads it, for HDR over the tunnel (EdidYcbcr422.h)
+  m_ycbcr422 = EdidDeclaresYcbcr422(edid);
   // Hades: the HDR10+ block of any application version, 0 too (HDR10PlusVersion())
   m_hdr10PlusVersion = Hdr10PlusBlockVersion(edid);
   // Hades: and what NVIDIA's driver names 4K modes by (GetHdmiVicSink())
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index dceb72f..84e19d6 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -253,6 +253,9 @@ public:
   }
   //! The sink lets the source select the RGB quantization range (VCDB QS bit)
   bool SupportsRGBQuantizationSelection() const { return m_rgbQuantizationSelectable; }
+  //! Hades: the EDID declares YCbCr 4:2:2 in a CTA-861 block, as the kernel reads it: what HDR over
+  //! the tunnel as YCbCr 4:2:2 asks of the display (EdidYcbcr422.h)
+  bool SupportsYCbCr422() const { return m_ycbcr422; }
 
   bool SupportsColorimetry(Colorimetry colorimetry) const;
 
@@ -282,6 +285,7 @@ private:
   bool m_dolbyVision = false;
   int m_hdr10PlusVersion{-1}; //!< Hades: see HDR10PlusVersion()
   bool m_hdmiVrr = false; //!< Hades: see SupportsHdmiVrr()
