From 651a0376128604ad99c015b71495f08940235f45 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 27 Oct 2026 10:41:54 -0700
Subject: [PATCH] [filesystem] Skip redundant stats for extensionless and stack
 paths

Neither case needs a preliminary stat to select a file-directory loader.
---
 xbmc/filesystem/DirectoryFactory.cpp   |  5 +++--
 xbmc/filesystem/test/TestDirectory.cpp | 22 ++++++++++++++++++++++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/xbmc/filesystem/DirectoryFactory.cpp b/xbmc/filesystem/DirectoryFactory.cpp
index eeb5f1c..767e07f 100644
--- a/xbmc/filesystem/DirectoryFactory.cpp
+++ b/xbmc/filesystem/DirectoryFactory.cpp
@@ -133,10 +133,11 @@ IDirectory* CDirectoryFactory::Create(const CURL& url)
 
   struct __stat64 st = {};
   static constexpr auto excludedProtocols =
-      make_set<std::string_view>({"upnp", "addons", "favourites", "sources"});
+      make_set<std::string_view>({"upnp", "addons", "favourites", "sources", "stack"});
   // Stat-ing an internet stream costs a network round trip on every playback
+  // File-directory loaders are chosen by extension, so extensionless paths need no stat
   const bool exclude{excludedProtocols.contains(url.GetProtocol()) ||
-                     URIUtils::IsInternetStream(url)};
+                     URIUtils::IsInternetStream(url) || url.GetFileType().empty()};
   if (!exclude && CFile::Stat(URIUtils::SubstitutePath(url), &st) == 0)
   {
     item.SetFolder(S_ISDIR(st.st_mode));
diff --git a/xbmc/filesystem/test/TestDirectory.cpp b/xbmc/filesystem/test/TestDirectory.cpp
index a0a54ee..58a39d5 100644
--- a/xbmc/filesystem/test/TestDirectory.cpp
+++ b/xbmc/filesystem/test/TestDirectory.cpp
@@ -8,6 +8,7 @@
 
 #include "FileItem.h"
 #include "FileItemList.h"
+#include "URL.h"
 #include "filesystem/Directory.h"
 #include "filesystem/DirectoryFactory.h"
 #include "filesystem/IDirectory.h"
@@ -16,6 +17,9 @@
 #include "utils/URIUtils.h"
 #include "video/VideoInfoTag.h"
 
+#include <memory>
+#include <string>
+
 #include <gtest/gtest.h>
 
 TEST(TestDirectory, General)
@@ -58,6 +62,24 @@ TEST(TestDirectory, CreateRecursive)
   EXPECT_TRUE(XFILE::CDirectory::RemoveRecursive(path1));
 }
 
+TEST(TestDirectory, CreateForDotM3uFolder)
+{
+  const std::string dir{
+      URIUtils::AddFileToFolder(CSpecialProtocol::TranslatePath("special://temp/"), "game.m3u")};
+  ASSERT_TRUE(XFILE::CDirectory::Create(dir));
+  std::string dirWithSlash{dir};
+  URIUtils::AddSlashAtEnd(dirWithSlash);
+
+  for (const std::string& path : {dir, dirWithSlash})
+  {
+    const CURL url{path};
+    const std::unique_ptr<XFILE::IDirectory> pDir{XFILE::CDirectoryFactory::Create(url)};
+    ASSERT_NE(nullptr, pDir) << path;
+    EXPECT_TRUE(pDir->Exists(url)) << path;
+  }
+  EXPECT_TRUE(XFILE::CDirectory::RemoveRecursive(dir));
+}
+
 #ifdef HAVE_LIBBLURAY
 TEST(TestDirectory, BlurayResolve)
 {
