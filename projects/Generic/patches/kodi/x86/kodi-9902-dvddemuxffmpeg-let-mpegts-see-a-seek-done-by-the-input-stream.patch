From 2937c7d904285756f5bb3404cee946d4191e3b4e Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Wed, 21 Oct 2026 01:32:07 +0000
Subject: [PATCH] DVDDemuxFFmpeg: let mpegts see a seek done by the input
 stream

A Blu-ray seek runs in the input stream, then Flush drops the AVIO
buffer. mpegts only discards its partial packets when the read position
changes. When the buffer was fully read, the position stays put, and a
stale video packet swallows the keyframe at the seek point.

(cherry picked from xbmc/xbmc master e5a50069a8e038226ba7668c6b119135e7ce229a)

Hades: taken as it is. On Hades' tree the position that is set back to 0
is kept in m_blurayReadBase, which Hades already has for the playlist's
timeline and the video preroll (base plus a packet's position is where the
input read it), so both go on as before. Measured on a synthetic disc
played directly: a seek made right when the demuxer's 4096-byte buffer had
been read to its end gave, as its first video packet, the rest of a PES
read before the seek in 12 attempts out of 12; with this change, in none.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 19 +++++++++++++++++--
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  1 +
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index fc32dcc..8fbb606 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -2756,6 +2756,21 @@ bool CDVDDemuxFFmpeg::GetMatroskaStream(int streamId, MatroskaStream& out)
   return false;
 }
 
+void CDVDDemuxFFmpeg::FlushInputSeek()
+{
+  Flush();
+
+#ifdef HAVE_LIBBLURAY
+  // mpegts only drops its partial packets when the position changes
+  if (m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY) && m_ioContext && m_pFormatContext &&
+      m_pFormatContext->pb == m_ioContext && !m_ioContext->seekable)
+  {
+    m_blurayReadBase += m_ioContext->pos;
+    m_ioContext->pos = 0;
+  }
+#endif
+}
+
 bool CDVDDemuxFFmpeg::SeekTime(double time, bool backwards, double* startpts)
 {
   bool hitEnd = false;
@@ -2785,7 +2800,7 @@ bool CDVDDemuxFFmpeg::SeekTime(double time, bool backwards, double* startpts)
     if (startpts)
       *startpts = DVD_NOPTS_VALUE;
 
-    Flush();
+    FlushInputSeek();
 
     return true;
   }
@@ -3976,7 +3991,7 @@ bool CDVDDemuxFFmpeg::SeekChapter(int chapter, double* startpts)
           DVD_SEC_TO_TIME(std::chrono::duration<double>(ich->GetChapterPos(chapter)).count());
     }
 
-    Flush();
+    FlushInputSeek();
     return true;
   }
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 3517723..241c4f8 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -228,6 +228,7 @@ protected:
   TRANSPORT_STREAM_STATE TransportStreamVideoState();
   bool IsTransportStreamReady();
   void ResetVideoStreams();
+  void FlushInputSeek();
   AVDictionary* GetFFMpegOptionsFromInput();
   double ConvertTimestamp(int64_t pts, int den, int num);
 #ifdef HAVE_LIBBLURAY
-- 
2.53.0

