From f91a876cfd32ea6493acba7e69b78f72165dcddc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:27:18 +0000
Subject: [PATCH] VideoPlayer, ActiveAE: make a DTS stream passed through again
 when its period changes

The audio sink of the player takes a frame passed through as long as its type is the same
(CAudioSinkAE::IsValidFormat()), and the engine opens the sink again only for another type
(CActiveAE::CompareFormat()). The DTS repetition period that the sink packs every burst with comes
from the stream info it was opened with (CActiveAESink::OutputSamples()). A DTS-HD stream whose core
goes from 512 to 1024 samples keeps its type, so its frames went on being packed with the period of
the first ones: a 1024-sample frame in the burst of a 512-sample one, at the wrong rate.

Both now compare the period too, for a stream passed through: a change of it makes the stream and
the sink again, once. A stream that keeps its period is not affected. Tested in a host test with
the parser and the packer as built, and the two comparisons taken from the tree: a DTS-HD MA stream
that goes from a 512- to a 1024-sample core in the middle had 6 of 12 frames packed with the period
of the others, and none now; the same stream without the change is made again nowhere.
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 5 +++++
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp               | 6 ++++++
 xbmc/cores/VideoPlayer/AudioSinkAE.h                 | 2 ++
 3 files changed, 13 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index dd56d0c..5535ccb 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -4247,6 +4247,11 @@ bool CActiveAE::CompareFormat(const AEAudioFormat& lhs, const AEAudioFormat& rhs
   else if (lhs.m_dataFormat == AE_FMT_RAW && rhs.m_dataFormat == AE_FMT_RAW &&
            lhs.m_streamInfo.m_type != rhs.m_streamInfo.m_type)
     return false;
+  // Hades: and the DTS repetition period, which the sink packs a burst with (see
+  // CAudioSinkAE::IsValidFormat())
+  else if (lhs.m_dataFormat == AE_FMT_RAW && rhs.m_dataFormat == AE_FMT_RAW &&
+           lhs.m_streamInfo.m_dtsPeriod != rhs.m_streamInfo.m_dtsPeriod)
+    return false;
   else
     return true;
 }
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
index 306a62e..8c3c91a 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -79,6 +79,7 @@ bool CAudioSinkAE::Create(const DVDAudioFrame &audioframe, AVCodecID codec, bool
   m_bPassthrough = audioframe.passthrough;
   m_channelLayout = audioframe.format.m_channelLayout;
   m_dataType = audioframe.format.m_streamInfo.m_type;
+  m_dtsPeriod = audioframe.format.m_streamInfo.m_dtsPeriod; // (Hades)
 
   return true;
 }
@@ -283,6 +284,11 @@ bool CAudioSinkAE::IsValidFormat(const DVDAudioFrame &audioframe)
       m_dataType != audioframe.format.m_streamInfo.m_type)
     return false;
 
+  // Hades: nor its DTS repetition period. A DTS core that changes its number of samples keeps the
+  // type of the stream, and the sink packs every burst with the period it was opened with.
+  if (m_bPassthrough && m_dtsPeriod != audioframe.format.m_streamInfo.m_dtsPeriod)
+    return false;
+
   return true;
 }
 
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.h b/xbmc/cores/VideoPlayer/AudioSinkAE.h
index 1321d92..965de3d 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.h
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.h
@@ -82,6 +82,8 @@ protected:
   bool m_bPassthrough;
   CAEChannelInfo m_channelLayout;
   CAEStreamInfo::DataType m_dataType;
+  //! Hades: the DTS repetition period of the stream passed through (CAEStreamInfo::m_dtsPeriod)
+  unsigned int m_dtsPeriod{0};
   bool m_bPaused;
 
   std::atomic_bool m_bAbort;
-- 
