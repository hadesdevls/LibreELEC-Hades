From 1028d55ad0c59973c9805c94c0242a7dd4e04280 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sat, 3 Oct 2026 05:48:52 +0000
Subject: [PATCH] ActiveAE: answer at once while there is no sink, and say so

While the sink cannot be opened (AE_TOP_ERROR), or there is no device to
open (AE_TOP_WAIT_PRECOND), the engine did not answer two requests that
their callers wait for:

- NEWSTREAM: MakeStream() waited ten seconds and failed all the same,
  even if the sink was back by then, because the request had been
  dropped. Every video started ten seconds late, and stopping it could
  hold the user interface for as long;
- DISPLAYLOST: OnLostDisplay(), called by the thread of the user
  interface at every change of the display mode, waited five seconds.

Both are answered now: no stream can be made (a caller that wants to
wait asks again), and there is nothing to suspend. Seen with a TV on the
HDMI output of one GPU and the audio device set to an output of the
other.

A third request was answered, but not done: FREESTREAM. Outside the
configured states its handler read the message as a pointer to the
structure that the message itself carries, so the stream was never found
and stayed in the engine's list for good; a leftover passthrough stream
makes CreateStream() refuse every stream after it (no sound until Kodi
is started again, for example after a TV was switched off during a film
and the film was stopped). It is read as the other handler reads it, and
an engine in error then tries its sink again at once, since it may open
without the stream.

IAE::HasNoSink() tells a player that the engine is in one of those two
states, which it cannot tell from a suspended engine or from one that is
busy opening its sink: in those the output comes in the end, in these
there is nothing to wait for.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 49 ++++++++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  3 ++
 xbmc/cores/AudioEngine/Interfaces/AE.h        | 10 ++++
 3 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index c0e801d..0a0cca3 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -452,9 +452,18 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           return;
         case CActiveAEDataProtocol::FREESTREAM:
           MsgStreamFree *msgStreamFree;
-          msgStreamFree = *(MsgStreamFree**)msg->data;
+          // The message carries the structure itself, as the handler of the configured states
+          // reads it. Read as a pointer to it, the stream was never found: it stayed in the list
+          // for good, and a leftover passthrough stream makes CreateStream() refuse every other.
+          msgStreamFree = reinterpret_cast<MsgStreamFree*>(msg->data);
           DiscardStream(msgStreamFree->stream);
           msg->Reply(CActiveAEDataProtocol::ACC);
+          // the sink may open without the stream: do not wait for the next retry
+          if (m_state == AE_TOP_ERROR)
+          {
+            m_extErrorRetries = 0;
+            m_extTimeout = 0ms;
+          }
           return;
         case CActiveAEDataProtocol::FREESOUND:
           sound = *(CActiveAESound**)msg->data;
@@ -524,6 +533,24 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
             }
             return;
 
+          // see AE_TOP_ERROR
+          case CActiveAEControlProtocol::DISPLAYLOST:
+            msg->Reply(CActiveAEControlProtocol::ACC);
+            return;
+
+          default:
+            break;
+        }
+      }
+      else if (port == &m_dataPort)
+      {
+        switch (signal)
+        {
+          // see AE_TOP_ERROR
+          case CActiveAEDataProtocol::NEWSTREAM:
+            msg->Reply(CActiveAEDataProtocol::ERR);
+            return;
+
           default:
             break;
         }
@@ -549,6 +576,25 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
             m_extErrorRetries = 0;
             m_extTimeout = 0ms;
             return;
+          // There is no sink to suspend. Without an answer the caller, which is the thread of the
+          // user interface, waits five seconds at every change of the display mode.
+          case CActiveAEControlProtocol::DISPLAYLOST:
+            msg->Reply(CActiveAEControlProtocol::ACC);
+            return;
+          default:
+            break;
+        }
+      }
+      else if (port == &m_dataPort)
+      {
+        switch (signal)
+        {
+          // No stream can be served without a sink. Without an answer the caller waits ten seconds
+          // and fails all the same, even when the sink is back by then, because the request is
+          // dropped here. A caller that wants to wait for the sink asks again.
+          case CActiveAEDataProtocol::NEWSTREAM:
+            msg->Reply(CActiveAEDataProtocol::ERR);
+            return;
           default:
             break;
         }
@@ -1123,6 +1169,7 @@ void CActiveAE::Process()
   {
     gotMsg = false;
     timer.Set(m_extTimeout);
+    m_noSink = m_state == AE_TOP_ERROR || m_state == AE_TOP_WAIT_PRECOND;
 
     if (m_bStateMachineSelfTrigger)
     {
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index 1c040d7..ec1f32d 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -16,6 +16,7 @@
 #include "threads/SystemClock.h"
 #include "threads/Thread.h"
 
+#include <atomic>
 #include <list>
 #include <memory>
 #include <queue>
@@ -245,6 +246,7 @@ public:
   bool Suspend() override;
   bool Resume() override;
   bool IsSuspended() override;
+  bool HasNoSink() override { return m_noSink; }
   bool YieldDevice() override;
   bool ReclaimDevice() override;
   void OnSettingsChange();
@@ -351,6 +353,7 @@ protected:
   CActiveAEControlProtocol m_controlPort;
   CActiveAEDataProtocol m_dataPort;
   int m_state;
+  std::atomic<bool> m_noSink{false}; //!< m_state for other threads, see HasNoSink()
   bool m_bStateMachineSelfTrigger;
   std::chrono::milliseconds m_extTimeout;
   bool m_extError;
diff --git a/xbmc/cores/AudioEngine/Interfaces/AE.h b/xbmc/cores/AudioEngine/Interfaces/AE.h
index a90ff4a..c578983 100644
--- a/xbmc/cores/AudioEngine/Interfaces/AE.h
+++ b/xbmc/cores/AudioEngine/Interfaces/AE.h
@@ -128,6 +128,16 @@ public:
    */
   virtual bool IsSuspended() {return true;}
 
+  /*!
+   * \brief Whether the engine is without a sink
+   *
+   * None can be opened (the engine goes on trying by itself) or there is no audio device. No
+   * stream can be made or played meanwhile. A suspended engine has not lost its sink.
+   *
+   * \return True if the engine has no sink
+   */
+  virtual bool HasNoSink() { return false; }
+
   /*!
    * \brief Stop using the audio device so an external media pipeline can have it
    *
-- 
2.53.0

