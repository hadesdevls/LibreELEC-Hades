   //! Hades: the next commit would carry more than a framebuffer: properties added since the last
   //! one, or a modeset that is pending
   bool HasPendingRequest() const { return m_need_modeset || (m_req && !m_req->Empty()); }
@@ -177,6 +185,11 @@ private:
   std::vector<std::string> m_dvRefused; //!< see DVRefused()
 
   bool m_need_modeset{true};
+  //! Hades: a change of mode that the driver refused, asked for again (CModesetRetry), and
+  //! whether one was given up (TakeModesetGivenUp())
+  CModesetRetry m_modesetRetry;
+  bool m_modesetGivenUp = false;
+  void SettleModeset(bool accepted, CModesetRetry::Clock::time_point now);
   //! Hades: the mode that the commits put on the CRTC (IsSelectedModeCommitted())
   CCommittedMode<drmModeModeInfo> m_committedMode;
   //! Hades: which commits are tested first, and what the frames of native output took
diff --git a/xbmc/windowing/gbm/drm/DRMModesetRetry.h b/xbmc/windowing/gbm/drm/DRMModesetRetry.h
new file mode 100644
index 0000000..0963a36
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DRMModesetRetry.h
@@ -0,0 +1,129 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
