 xbmc/windowing/gbm/WinSystemGbm.cpp      |  17 +++
 xbmc/windowing/gbm/WinSystemGbm.h        |   2 +
 xbmc/windowing/gbm/drm/DRMAtomic.cpp     |  53 +++++++++-
 xbmc/windowing/gbm/drm/DRMAtomic.h       |  15 ++-
 xbmc/windowing/gbm/drm/DRMModesetRetry.h | 129 +++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h        |   3 +
 6 files changed, 215 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/DRMModesetRetry.h

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 3a8325c..530ff53 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2453,6 +2453,20 @@ bool CWinSystemGbm::FlipHeldGui()
   return false;
 }
 
+void CWinSystemGbm::AnnounceModesetGivenUp()
+{
+  // Hades: the output keeps the mode it had (CModesetRetry). What waits for a change of mode (the
+  // renderer, the audio of the display) is told of a loss and of the return of the display, as
+  // SetFullScreen() tells of a change, so that it looks again at the mode that is on the output.
+  OnLostDevice();
+  const auto delay =
+      std::chrono::milliseconds(CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+                                    "videoscreen.delayrefreshchange") *
+                                100);
+  if (delay > 0ms)
+    m_dispResetTimer.Set(delay);
+}
+
 void CWinSystemGbm::AnnounceHeldModeChange(bool transport)
 {
   if (!m_modeAnnounce.Before(transport))
@@ -2904,6 +2918,9 @@ void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
   // Hades: ... and Kodi's limited range asked of the driver, in a commit with a mode set (CRgbRange)
   StageRgbRange();
   m_DRM->FlipPage(bo, rendered, videoLayer, async);
+  // Hades: a change of mode that the driver kept refusing was given up (CModesetRetry)
+  if (m_DRM->TakeModesetGivenUp())
+    AnnounceModesetGivenUp();
   // Hades: whether the driver took the HDR10+ metadata that the request carried
   HDR10PlusCommitted();
   HdmiVrrOffCommitted();
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index d45f7ce..482dc7d 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -284,6 +284,8 @@ public:
 
 protected:
   void OnLostDevice();
+  //! Hades: a change of mode that the driver kept refusing was given up (CModesetRetry)
+  void AnnounceModesetGivenUp();
   void OnResetDisplay();
   //! \brief Queue again the colorimetry and the HDR metadata that were queued last: the driver
   //! takes them with a flip, and they are dropped with a flip that it refuses.
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index f5921fb..26a8f51 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -775,6 +775,11 @@ void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, boo
 {
   struct drm_fb* drm_fb = nullptr;
   uint32_t flags = 0;
+  // Hades: ... or a change of mode that the driver refused, asked for again (CModesetRetry). The
+  // flag of a pending modeset is cleared as before: what waits for it (ModesetPending(), the
+  // frames of native output, FlipPageTransactional()) sees no modeset pending between the retries.
+  const auto now = CModesetRetry::Clock::now();
+  const bool modeset = CommitsModeset(m_need_modeset, m_active, m_modesetRetry, now);
 
   if (rendered)
   {
@@ -789,18 +794,58 @@ void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, boo
       return;
     }
 
-    if (async && !m_need_modeset)
+    if (async && !modeset)
       flags |= DRM_MODE_ATOMIC_NONBLOCK;
   }
 
-  if (m_need_modeset)
+  if (modeset)
   {
     flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
     m_need_modeset = false;
     CLog::LogF(LOGDEBUG, "Execute modeset at next commit");
   }
 
-  DrmAtomicCommit(!drm_fb ? 0 : drm_fb->fb_id, flags, rendered, videoLayer);
+  const bool accepted = DrmAtomicCommit(!drm_fb ? 0 : drm_fb->fb_id, flags, rendered, videoLayer);
+  if (modeset)
+    SettleModeset(accepted, now);
+}
+
+void CDRMAtomic::SettleModeset(bool accepted, CModesetRetry::Clock::time_point now)
+{
+  // (an output that is meant to be off shows no mode: nothing to ask for again)
+  if (!m_active || !m_mode)
+  {
+    m_modesetRetry.Forget();
+    return;
+  }
+  const auto outcome = m_modesetRetry.Result(accepted && SelectedModeOnOutput(), now);
+  const unsigned int refusals = m_modesetRetry.Refusals();
+  switch (outcome)
+  {
+    case CModesetRetry::Outcome::TAKEN:
+      if (refusals)
+        CLog::LogF(LOGINFO, "the driver took the mode {}x{} {} Hz after {} refusal(s)",
+                   m_mode->hdisplay, m_mode->vdisplay, m_mode->vrefresh, refusals);
+      break;
+    case CModesetRetry::Outcome::AGAIN:
+      if (refusals == 1)
+        CLog::LogF(LOGWARNING,
+                   "the driver refused the change to the mode {}x{} {} Hz: the output stays in the "
+                   "mode it has; the change is asked for again with the next {} frames, then every "
+                   "{} s, {} times in all",
+                   m_mode->hdisplay, m_mode->vdisplay, m_mode->vrefresh, CModesetRetry::QUICK,
+                   CModesetRetry::SPACING.count() / 1000, CModesetRetry::ATTEMPTS);
+      break;
+    case CModesetRetry::Outcome::GIVEN_UP:
+      CLog::LogF(LOGERROR,
+                 "the driver refused the change to the mode {}x{} {} Hz {} times: given up, the "
+                 "output keeps the mode it has; the display is told as lost and back",
+                 m_mode->hdisplay, m_mode->vdisplay, m_mode->vrefresh, refusals);
+      m_modesetGivenUp = true;
+      break;
+    case CModesetRetry::Outcome::NONE:
+      break;
+  }
 }
 
 bool CDRMAtomic::InitDrm()
@@ -913,6 +958,7 @@ std::optional<bool> CDRMAtomic::SelectedModeOnCrtc() const
 bool CDRMAtomic::SetVideoMode(const RESOLUTION_INFO& res, struct gbm_bo* bo)
 {
   m_need_modeset = true;
+  m_modesetRetry.Asked(); // (Hades)
 
   return true;
 }
@@ -920,6 +966,7 @@ bool CDRMAtomic::SetVideoMode(const RESOLUTION_INFO& res, struct gbm_bo* bo)
 bool CDRMAtomic::SetActive(bool active)
 {
   m_need_modeset = true;
+  m_modesetRetry.Asked(); // (Hades)
   m_active = active;
 
   return true;
