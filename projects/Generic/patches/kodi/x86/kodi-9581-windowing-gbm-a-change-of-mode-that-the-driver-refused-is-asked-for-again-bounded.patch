+
+#pragma once
+
+#include <chrono>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: a change of mode that the driver refused is asked for again, a bounded number of
+ *        times, until the selected mode is on the output
+ *
+ * Kodi clears its pending modeset when it assembles the commit that carries it
+ * (CDRMAtomic::FlipPage()). A commit of the ordinary output whose test the driver refuses falls
+ * back to the request before it (CDRMAtomic::DrmAtomicCommit()), which goes out in the mode on the
+ * output; and a commit that the driver refuses outright changes nothing. Either way the selected
+ * mode is not on the output (CCommittedMode) and nothing asked for it again: the display stayed in
+ * the mode before while Kodi drew for the new one, until the next change of mode. (The idea of
+ * keeping the modeset pending until the selected mode is committed is CroqueMr's, R1.0.0 RC3.)
+ *
+ * Here the change is asked for again with the next two frames of the ordinary output (a refusal
+ * that comes of a passing state of the link, while it trains, or of a commit the driver was still
+ * busy with), then once every SPACING, up to ATTEMPTS commits in all: about seven seconds. Then
+ * it is given up, and the caller tells the other subsystems that the display was lost and is back
+ * (CWinSystemGbm), as after a change of mode, so that what waits for the mode on the output looks
+ * at the one that is there. A new choice of mode (or of the state of the output) starts again.
+ * Only the commits of the ordinary output take part: the frames of native Dolby Vision are
+ * committed without a modeset when nothing is pending (CDRMAtomic::FlipPageTransactional()), and a
+ * retry is never added to them.
+ *
+ * This class only decides; the time is given to it, so that a test runs it on the host.
+ */
+class CModesetRetry
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  static constexpr unsigned int QUICK = 2; //!< retries with the next frames
+  static constexpr unsigned int ATTEMPTS = 6; //!< commits of the change in all (the first one too)
+  static constexpr std::chrono::milliseconds SPACING{2000};
+
+  enum class Outcome
+  {
+    NONE, //!< the commit did not carry a change that is followed here
+    TAKEN, //!< the selected mode is on the output
+    AGAIN, //!< refused: asked for again later
+    GIVEN_UP, //!< refused ATTEMPTS times: not asked for again until a new choice
+  };
+
+  //! A change of mode, or of the state of the output, was chosen: it is followed from its first
+  //! commit
+  void Asked()
+  {
+    m_refusals = 0;
+    m_pending = false;
+    m_followed = true;
+  }
+
+  //! Nothing is followed (an output that is meant to be off shows no mode)
+  void Forget()
+  {
+    m_refusals = 0;
+    m_pending = false;
+    m_followed = false;
+  }
+
+  //! Whether a commit of the ordinary output made now carries the change again
+  bool Due(Clock::time_point now) const { return m_pending && now >= m_next; }
+
+  //! A commit that carried the change went out (accepted) or not; onOutput: the selected mode is
+  //! the one on the output after it (CCommittedMode)
+  Outcome Result(bool onOutput, Clock::time_point now)
+  {
+    if (!m_followed)
+      return Outcome::NONE;
+    if (onOutput)
+    {
+      m_pending = false;
+      m_followed = false;
+      return Outcome::TAKEN;
+    }
+    ++m_refusals;
+    if (m_refusals >= ATTEMPTS)
+    {
+      m_pending = false;
+      m_followed = false;
+      return Outcome::GIVEN_UP;
+    }
+    m_pending = true;
+    m_next = m_refusals <= QUICK ? now : now + SPACING;
+    return Outcome::AGAIN;
+  }
+
+  //! Refusals of the change followed now, or of the one that was just taken or given up
+  unsigned int Refusals() const { return m_refusals; }
+  //! A retry is waiting for its time
+  bool Pending() const { return m_pending; }
+
+private:
+  unsigned int m_refusals = 0;
+  bool m_pending = false;
+  bool m_followed = false;
+  Clock::time_point m_next{};
+};
+
+//! Hades: whether a commit of the ordinary output (CDRMAtomic::FlipPage()) allows a modeset: one is
+//! pending, or a change of mode that the driver refused is due to be asked for again (never while
+//! the output is meant to be off)
+inline bool CommitsModeset(bool pending,
+                           bool active,
+                           const CModesetRetry& retry,
+                           CModesetRetry::Clock::time_point now)
+{
+  return pending || (active && retry.Due(now));
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 0feeebc..ca9701e 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -79,6 +79,9 @@ public:
   //! asked, for whatever reason: also the ones that TakeFlipRefused() does not tell of, but for
   //! a commit made while the output is meant to be off. What such a commit carried is lost.
   virtual bool TakeFlipDropped() { return false; }
+  //! \brief Hades: a change of mode that the driver kept refusing was given up since this was
+  //! asked last (CDRMAtomic, CModesetRetry)
+  virtual bool TakeModesetGivenUp() { return false; }
   //! \brief Hades: what the last refusal that TakeFlipRefused() told of was about, as the driver
   //! answers when it is asked again with bo, an 8-bit buffer of the output, in place of the
   //! frame's (JudgeFloatRefusal()). Asked once for each refusal; UNKNOWN when it cannot be asked
