From 461799a6b57e8a85fc4730cea2e69aee9a271938 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:53:43 +0000
Subject: [PATCH] system/hades: Estuary's name and licences on what is made of
 it

DialogHadesPlayerInfo.xml and HadesIncludes.xml are made by
make-playerinfo.py of Estuary's XML files, and four of the images of the
folder are copies of Estuary's. Their header said only "Copyright (C)
2026 Hades" and GPL-2.0-or-later, and the images said nothing. Estuary's
LICENSE.txt licenses its code under the GNU General Public License,
version 2.0, without "or later", and its artwork under Creative Commons
Attribution-ShareAlike 4.0.

The header that the script writes now names Estuary (phil65, Team Kodi)
and its licence, and the XML files are GPL-2.0-only, as the code they are
made of; what the script adds is Hades'. The script also writes
system/hades/README.txt: where each image comes from in Estuary's media,
and the licences of both kinds of file. The script itself stays
GPL-2.0-or-later. Nothing else of the XML files changes (their bodies
are the same bytes), and make-playerinfo.py --check and pi_check.py pass.
---
 system/hades/DialogHadesPlayerInfo.xml    |  8 ++++---
 system/hades/HadesIncludes.xml            |  8 ++++---
 system/hades/README.txt                   | 17 +++++++++++++
 tools/hades-playerinfo/make-playerinfo.py | 29 +++++++++++++++++++----
 4 files changed, 52 insertions(+), 10 deletions(-)
 create mode 100644 system/hades/README.txt

diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index c42059a..4c72043 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -1,8 +1,10 @@
 <?xml version="1.0" encoding="UTF-8"?>
 <!--
-  Generated by tools/hades-playerinfo/make-playerinfo.py from Estuary's DialogPlayerProcessInfo.xml,
-  Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml and Defaults.xml: do not edit; change
-  those and run it again. Copyright (C) 2026 Hades; SPDX-License-Identifier: GPL-2.0-or-later.
+  Generated by tools/hades-playerinfo/make-playerinfo.py from the files of Estuary (skin.estuary: Estuary by
+  phil65, Team Kodi): DialogPlayerProcessInfo.xml, Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml
+  and Defaults.xml. Do not edit; change those and run it again. Estuary's code is under the GNU General Public
+  License, version 2.0 (addons/skin.estuary/LICENSE.txt), and so is this file, which is made of it; what the
+  script adds is Copyright (C) 2026 Hades. SPDX-License-Identifier: GPL-2.0-only
   The player information of Hades as a dialog of its own (CGUIDialogHadesPlayerInfo), for a skin that does not have one.
 -->
 <window>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index de3eb49..14b274e 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -1,8 +1,10 @@
 <?xml version="1.0" encoding="UTF-8"?>
 <!--
-  Generated by tools/hades-playerinfo/make-playerinfo.py from Estuary's DialogPlayerProcessInfo.xml,
-  Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml and Defaults.xml: do not edit; change
-  those and run it again. Copyright (C) 2026 Hades; SPDX-License-Identifier: GPL-2.0-or-later.
+  Generated by tools/hades-playerinfo/make-playerinfo.py from the files of Estuary (skin.estuary: Estuary by
+  phil65, Team Kodi): DialogPlayerProcessInfo.xml, Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml
+  and Defaults.xml. Do not edit; change those and run it again. Estuary's code is under the GNU General Public
+  License, version 2.0 (addons/skin.estuary/LICENSE.txt), and so is this file, which is made of it; what the
+  script adds is Copyright (C) 2026 Hades. SPDX-License-Identifier: GPL-2.0-only
   What every skin is given (CSkinInfo::LoadIncludes(), after the skin's own includes): the variables, maps and row includes of the player information of Hades.
 -->
 <includes>
diff --git a/system/hades/README.txt b/system/hades/README.txt
new file mode 100644
index 0000000..aacc988
--- /dev/null
+++ b/system/hades/README.txt
@@ -0,0 +1,17 @@
+What is in this folder (system/hades of LibreELEC Hades): the player information of Hades for every skin,
+made by tools/hades-playerinfo/make-playerinfo.py from the files of Estuary, Kodi's skin. Do not edit it: change
+Estuary's files and run the script again.
+
+The images are Estuary's artwork, copied unchanged:
+
+  buttons-button-fo.png       addons/skin.estuary/media/buttons/button-fo.png
+  buttons-button-nofo.png     addons/skin.estuary/media/buttons/button-nofo.png
+  colors-white.png            addons/skin.estuary/media/colors/white.png
+  dialogs-dialog-bg-nobo.png  addons/skin.estuary/media/dialogs/dialog-bg-nobo.png
+
+Estuary by phil65 (Team Kodi). Estuary Artwork is licensed under the Creative Commons Attribution-ShareAlike 4.0
+licence (https://creativecommons.org/licenses/by-sa/4.0/), and so are these copies.
+
+HadesIncludes.xml and DialogHadesPlayerInfo.xml are made of Estuary's code, which is licensed under the GNU General
+Public License, version 2.0, and they are under that licence; what the script adds to them is Copyright (C) 2026
+Hades. Estuary's licence: addons/skin.estuary/LICENSE.txt of Kodi's source.
diff --git a/tools/hades-playerinfo/make-playerinfo.py b/tools/hades-playerinfo/make-playerinfo.py
index 7184adc..9a95904 100644
--- a/tools/hades-playerinfo/make-playerinfo.py
+++ b/tools/hades-playerinfo/make-playerinfo.py
@@ -16,7 +16,10 @@
 #                                           for a skin that has none: includes expanded, Estuary's control defaults
 #                                           written into each control, Estuary's strings as $ADDON[skin.estuary n],
 #                                           its colours as values and its textures from system/hades;
-#   system/hades/*.png                      those textures, copied from Estuary's media.
+#   system/hades/*.png                      those textures, copied from Estuary's media;
+#   system/hades/README.txt                 where those textures come from, and the licences of what is here.
+# The XML files are made of Estuary's and go under the licence of Estuary's code (GPL version 2.0); the textures
+# are Estuary's artwork, under its licence (CC BY-SA 4.0): see addons/skin.estuary/LICENSE.txt.
 #
 # Run from the root of the tree after a change to those pages: tools/hades-playerinfo/make-playerinfo.py
 # With --check it only says whether the files are those it would write (exit 1 if not).
@@ -310,9 +313,11 @@ for n in sorted(INCLUDES):
     includes.append(copy.deepcopy(INCLUDES[n]))
 rewrite(includes)
 
-HEADER = ("\n  Generated by tools/hades-playerinfo/make-playerinfo.py from Estuary's DialogPlayerProcessInfo.xml,\n"
-          "  Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml and Defaults.xml: do not edit; change\n"
-          "  those and run it again. Copyright (C) 2026 Hades; SPDX-License-Identifier: GPL-2.0-or-later.\n  %s\n")
+HEADER = ("\n  Generated by tools/hades-playerinfo/make-playerinfo.py from the files of Estuary (skin.estuary: Estuary by\n"
+          "  phil65, Team Kodi): DialogPlayerProcessInfo.xml, Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml\n"
+          "  and Defaults.xml. Do not edit; change those and run it again. Estuary's code is under the GNU General Public\n"
+          "  License, version 2.0 (addons/skin.estuary/LICENSE.txt), and so is this file, which is made of it; what the\n"
+          "  script adds is Copyright (C) 2026 Hades. SPDX-License-Identifier: GPL-2.0-only\n  %s\n")
 
 
 def serialize(root, what):
@@ -331,6 +336,22 @@ outputs = {
 for skin_path, name in TEXTURES.items():
     with open(os.path.join(SKIN, "media", skin_path), "rb") as f:
         outputs[name] = f.read()
+width = max(len(n) for n in TEXTURES.values()) if TEXTURES else 0
+outputs["README.txt"] = (
+    "What is in this folder (system/hades of LibreELEC Hades): the player information of Hades for every skin,\n"
+    "made by tools/hades-playerinfo/make-playerinfo.py from the files of Estuary, Kodi's skin. Do not edit it: change\n"
+    "Estuary's files and run the script again.\n"
+    "\n"
+    "The images are Estuary's artwork, copied unchanged:\n"
+    "\n"
+    + "".join("  %s  addons/skin.estuary/media/%s\n" % (n.ljust(width), s) for s, n in sorted(TEXTURES.items(), key=lambda x: x[1]))
+    + "\n"
+    "Estuary by phil65 (Team Kodi). Estuary Artwork is licensed under the Creative Commons Attribution-ShareAlike 4.0\n"
+    "licence (https://creativecommons.org/licenses/by-sa/4.0/), and so are these copies.\n"
+    "\n"
+    "HadesIncludes.xml and DialogHadesPlayerInfo.xml are made of Estuary's code, which is licensed under the GNU General\n"
+    "Public License, version 2.0, and they are under that licence; what the script adds to them is Copyright (C) 2026\n"
+    "Hades. Estuary's licence: addons/skin.estuary/LICENSE.txt of Kodi's source.\n")
 
 check = "--check" in sys.argv
 stale = []
-- 
2.53.0

