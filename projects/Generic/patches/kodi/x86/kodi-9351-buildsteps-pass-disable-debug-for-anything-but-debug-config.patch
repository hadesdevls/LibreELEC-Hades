From d86699b48d8acc0ea8953227e69b427174dc739b Mon Sep 17 00:00:00 2001
From: Andrey Filipenkov <decapitator@ukr.net>
Date: Sat, 10 Oct 2026 11:48:04 +0300
Subject: [PATCH] [buildsteps] pass `--disable-debug` for anything but Debug
 config

(cherry picked from commit b0dbf25c9b6c1538462f49ca8efe44221f537ed0)
---
 tools/buildsteps/defaultenv | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/buildsteps/defaultenv b/tools/buildsteps/defaultenv
index b5dc0ed..c9c404b 100644
--- a/tools/buildsteps/defaultenv
+++ b/tools/buildsteps/defaultenv
@@ -118,7 +118,7 @@ then
   Configuration=$DEFAULT_CONFIGURATION
 fi
 
-if [ "$Configuration" == "Release" ]
+if [ "$Configuration" != "Debug" ]
 then
   DEBUG_SWITCH='--disable-debug'
 fi
@@ -144,6 +144,7 @@ function getBuildHash ()
   local hashStr
   hashStr="$(git rev-list HEAD --max-count=1  -- $checkPath)"
   hashStr="$hashStr $Configuration $SDK_PATH $NDK_PATH $NDK_VERSION $SDK_VERSION $TOOLCHAIN $XBMC_DEPENDS_ROOT $XCODE_APP"
+  [ -z "$DEBUG_SWITCH" ] || hashStr="$hashStr $DEBUG_SWITCH"
   echo $hashStr
 }
 
