 void CWinSystemGbm::DisableNativeDVOutput(const char* reason)
 {
-  if (!m_dvDisabled.exchange(true))
-    CLog::Log(LOGERROR,
-              "DVBridge: native Dolby Vision output disabled until Kodi restarts: {}; "
-              "the video continues on the ordinary output",
-              reason);
+  unsigned int wait;
+  {
+    std::unique_lock lock(m_dvRetryLock);
+    if (m_dvDisabled)
+      return;
+    m_dvDisabled = true;
+    m_dvRetryBackoff = std::min(m_dvRetryBackoff ? m_dvRetryBackoff * 2 : 1u, 8u);
+    m_dvRetryWait = m_dvRetryBackoff;
+    wait = m_dvRetryWait;
+  }
+  CLog::Log(LOGERROR,
+            "DVBridge: native Dolby Vision output disabled: {}; the video continues on the "
+            "ordinary output. It is tried again with {}",
+            reason,
+            wait == 1 ? std::string("the next video")
+                      : "the video that starts " + std::to_string(wait) +
+                            " videos after this one, or the next one if the display changes");
+}
+
+void CWinSystemGbm::DVNewVideo()
+{
+  if (!CheckDisplayChange())
+    return;
+  std::unique_lock lock(m_dvRetryLock);
+  m_dvRetryBackoff = 0;
+  m_dvRetryWait = 0;
+  if (!m_dvDisabled.exchange(false))
+    return;
+  if (m_dvEdidUnread)
+    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is allowed again after the display "
+                       "changed, from the next video whose EDID can be read");
+  else
+    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is tried again with this video, "
+                       "after the display changed");
+}
+
+void CWinSystemGbm::DVVideoOpened()
+{
+  std::unique_lock lock(m_dvRetryLock);
+  if (!m_dvDisabled)
+    return;
+  if (m_dvRetryWait > 1)
+  {
+    --m_dvRetryWait;
+    return;
+  }
+  m_dvRetryWait = 0;
+  m_dvDisabled = false;
+  CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is tried again with this video, after "
+                     "an earlier failure");
+}
+
+void CWinSystemGbm::DVOutputWorked()
+{
+  std::unique_lock lock(m_dvRetryLock);
+  m_dvRetryBackoff = 0;
+}
+
+bool CWinSystemGbm::CheckDisplayChange()
+{
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector)
+    return false;
+  // Nothing changes for a display without Dolby Vision: as in Kodi, it is not probed again.
+  if (!m_dvDisabled && !m_dvDisplaySeen)
+    return false;
+  const auto info = DVDisplayInfo();
+  // A probe (a TV switched off and on, an input setting that changes its EDID): nvidia-drm and
+  // i915 read the display's state and EDID again, amdgpu reports what its hotplug handling found.
+  drmModeConnector* probed =
+      drmModeGetConnector(m_DRM->GetFileDescriptor(), *connector->GetConnectorId());
+  if (!probed)
+    return false;
+  const uint32_t edidProperty = connector->GetPropertyId("EDID");
+  uint64_t blob = 0;
+  for (int i = 0; edidProperty && i < probed->count_props; ++i)
+    if (probed->props[i] == edidProperty)
+      blob = probed->prop_values[i];
+  const bool disconnected = probed->connection == DRM_MODE_DISCONNECTED;
+  drmModeFreeConnector(probed);
+  if (disconnected)
+  {
+    if (!m_displayGone.exchange(true))
+      CLog::Log(LOGINFO, "DVBridge: the display is disconnected");
+    return false;
+  }
+  const bool back = m_displayGone.exchange(false);
+  if (back)
+    CLog::Log(LOGINFO, "DVBridge: the display is connected again");
+  // The contents are compared: the kernel can give a new EDID the id of an earlier one.
+  std::vector<uint8_t> edid;
+  if (blob)
+  {
+    if (drmModePropertyBlobPtr data = drmModeGetPropertyBlob(m_DRM->GetFileDescriptor(), blob))
+    {
+      const auto* bytes = static_cast<const uint8_t*>(data->data);
+      edid.assign(bytes, bytes + data->length);
+      drmModeFreePropertyBlob(data);
+    }
+  }
+  // No EDID, or one that cannot be read (a TV waking up): native output waits for the next video,
+  // and the display information stays as it was.
+  std::shared_ptr<const UTILS::CDisplayInfo> changed;
+  if (!edid.empty() && edid != m_displayEdid)
+    changed = UTILS::CDisplayInfo::Create(edid);
+  if (edid.empty() || (edid != m_displayEdid && !changed))
+  {
+    if (!m_dvEdidUnread.exchange(true))
+      CLog::Log(LOGINFO, "DVBridge: the display's EDID could not be read; native Dolby Vision "
+                         "output waits for the next video");
+    return back;
+  }
+  m_dvEdidUnread = false;
+  if (edid == m_displayEdid)
+    return back;
+  m_displayEdid = edid;
+  {
+    std::unique_lock lock(m_infoLock);
+    m_dvInfo = changed;
+  }
+  if (changed->SupportsDolbyVision())
+    m_dvDisplaySeen = true;
+  CLog::Log(LOGINFO, "DVBridge: the display's EDID changed; Dolby Vision Standard: {}",
+            changed->SupportsStandardDolbyVision() ? "yes" : "no");
+  // Only a change of what native output depends on counts (not, for example, the audio formats of
+  // a sound bar behind the TV).
+  return back || DVCapabilities(info.get()) != DVCapabilities(changed.get());
 }
 
