From c49317b602a72d6b4f1a5adeb542bef6e797082a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Fri, 23 Oct 2026 02:22:03 +0200
Subject: [PATCH] [guilib] Include the alignment offset in the grouplist render
 region

A right or center aligned grouplist draws its items with an offset,
but its render region started at its position, so dirty marks of the
grouplist missed the area its items are actually drawn in.
---
 xbmc/guilib/GUIControlGroupList.cpp | 11 +++++++++++
 xbmc/guilib/GUIControlGroupList.h   |  1 +
 2 files changed, 12 insertions(+)

diff --git a/xbmc/guilib/GUIControlGroupList.cpp b/xbmc/guilib/GUIControlGroupList.cpp
index aca3bf0..697d894 100644
--- a/xbmc/guilib/GUIControlGroupList.cpp
+++ b/xbmc/guilib/GUIControlGroupList.cpp
@@ -589,6 +589,17 @@ void CGUIControlGroupList::CalculateItemGap()
   }
 }
 
+CRect CGUIControlGroupList::CalcRenderRegion() const
+{
+  // the items are drawn with the alignment offset
+  CRect rect = CGUIControlGroup::CalcRenderRegion();
+  if (m_orientation == VERTICAL)
+    rect += CPoint(0, GetAlignOffset());
+  else
+    rect += CPoint(GetAlignOffset(), 0);
+  return rect;
+}
+
 float CGUIControlGroupList::GetAlignOffset() const
 {
   if (m_totalSize < Size())
diff --git a/xbmc/guilib/GUIControlGroupList.h b/xbmc/guilib/GUIControlGroupList.h
index 3d4dcba..e3269f8 100644
--- a/xbmc/guilib/GUIControlGroupList.h
+++ b/xbmc/guilib/GUIControlGroupList.h
@@ -37,6 +37,7 @@ public:
 
   float GetWidth() const override;
   float GetHeight() const override;
+  CRect CalcRenderRegion() const override;
   virtual float Size() const;
   void SetInvalid() override;
 
