From 8821c1f73fb1fc49b6f5749e13eb20db9603cb0a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:22:18 +0000
Subject: [PATCH] system/hades: made again by make-playerinfo.py, without the
 comment it does not write

The player information of the other skins (system/hades) is what
tools/hades-playerinfo/make-playerinfo.py makes of Estuary's files, and
its --check says whether it still is. HadesIncludes.xml had, above the
variable of Dolby Vision for the menus (HadesInfoDVMenusVar), the
comment of Estuary's Variables.xml, which the tool does not copy for a
variable: the check said the file was stale. Made again by the tool: the
comment goes, the variable is the same.
---
 system/hades/HadesIncludes.xml | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 700ad33..37b00ff 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -141,9 +141,6 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$ADDON[skin.estuary 32003] ($ADDON[skin.estuary 31912])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020)">$ADDON[skin.estuary 32003]</value>
 	</variable>
-	<!-- Hades: Dolby Vision for the menus (hades.dv.menus): this video took the output from the menus in
-	     Dolby Vision (dv), they were in it and this video goes out in its own format (own), or they were not
-	     (sdr); nothing while the setting is off -->
 	<variable name="HadesInfoDVMenusVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.menus),dv)">$ADDON[skin.estuary 32193]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.menus),own)">$ADDON[skin.estuary 32194]</value>
-- 
2.53.0

