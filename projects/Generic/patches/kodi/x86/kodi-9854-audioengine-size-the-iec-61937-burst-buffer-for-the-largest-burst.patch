From 12903e097634632d4333c4c1df2350ef7b928ae8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:01:51 +0000
Subject: [PATCH] AudioEngine: size the IEC 61937 burst buffer for the largest
 burst

A DTS type IV (DTS-HD) burst with a repetition period of 16384 frames is 65536 bytes, the largest
burst IEC 61937 defines (FFmpeg's spdif muxer writes it too). It is the period of a DTS-HD MA
stream with a 1024-sample core at 48 kHz (768000 * 1024 / 48000), and PackDTSHD() has a subtype
for it, but its destination, MAX_IEC61937_PACKET, was 61440 bytes. Before the two previous commits
that burst was written 4096 bytes past the packer's buffer; since them it is dropped, so such a
stream would play nothing.

MAX_IEC61937_PACKET is now 65536. It also sizes the stream parser's buffer, so that a frame of such
a burst is assembled whole, and the raw packets of the engine: its buffer pools and the frames of
the passthrough sink used the literal 61440, and a raw packet larger than its buffer is split in
two.

Nothing else changes. A TrueHD MAT burst stays 61440 bytes (PackTrueHD() and CPackerMAT size it
themselves), and a pause burst is at most one frame of the stream, which fits 61440 bytes already
(PackPause() bounds it with the same constant).
---
 .../Engines/ActiveAE/ActiveAEBuffer.cpp       |  5 ++-
 .../Engines/ActiveAE/ActiveAESink.cpp         |  2 +-
 xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h |  6 ++-
 .../Utils/test/TestAEPackIEC61937.cpp         | 37 +++++++++++++++++--
 4 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
index ad95330..c657dee 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
@@ -11,6 +11,7 @@
 #include "ActiveAE.h"
 #include "ActiveAEFilter.h"
 #include "cores/AudioEngine/AEResampleFactory.h"
+#include "cores/AudioEngine/Utils/AEPackIEC61937.h"
 #include "cores/AudioEngine/Utils/AEUtil.h"
 #include "cores/AudioEngine/Utils/AudioSettingsLive.h"
 
@@ -50,7 +51,7 @@ CActiveAEBufferPool::CActiveAEBufferPool(const AEAudioFormat& format) : m_format
   if (m_format.m_dataFormat == AE_FMT_RAW)
   {
     m_format.m_frameSize = 1;
-    m_format.m_frames = 61440;
+    m_format.m_frames = MAX_IEC61937_PACKET;
     m_format.m_channelLayout.Reset();
     m_format.m_channelLayout += AE_CH_FC;
   }
@@ -133,7 +134,7 @@ CActiveAEBufferPoolResample::CActiveAEBufferPoolResample(const AEAudioFormat& in
   if (m_inputFormat.m_dataFormat == AE_FMT_RAW)
   {
     m_format.m_frameSize = 1;
-    m_format.m_frames = 61440;
+    m_format.m_frames = MAX_IEC61937_PACKET;
     m_inputFormat.m_channelLayout.Reset();
     m_inputFormat.m_channelLayout += AE_CH_FC;
   }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index d79fb93..384fffc 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -336,7 +336,7 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
             //! for raw packets frameSize is set to 1
             if (m_requestedFormat.m_dataFormat == AE_FMT_RAW)
             {
-              reply.format.m_frames = 61440;
+              reply.format.m_frames = MAX_IEC61937_PACKET;
             }
             reply.cacheTotal = m_sink->GetCacheTotal();
             reply.latency = m_sink->GetLatency();
diff --git a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h
index 7a6e727..7eede02 100644
--- a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h
+++ b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h
@@ -11,7 +11,11 @@
 #include <list>
 #include <stdint.h>
 
-#define MAX_IEC61937_PACKET  61440
+// The largest burst IEC 61937 defines: DTS type IV (DTS-HD) with a repetition period of 16384
+// frames of 4 bytes, which a DTS-HD MA stream with a 1024-sample core at 48 kHz has
+// (CAEStreamParser::SyncDTS(), CAEPackIEC61937::PackDTSHD()). Also the largest packet of a
+// passthrough stream (raw buffers of the engine, CAEStreamParser).
+#define MAX_IEC61937_PACKET  65536
 #define IEC61937_DATA_OFFSET 8
 
 #define DTS1_FRAME_SIZE   512
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
index 1522f2e..e98e922 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
@@ -40,13 +40,44 @@ TEST(TestAEPackIEC61937, ADtsHdFrameLargerThanItsBurstIsDropped)
     ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written";
 }
 
-//! A period of 16384 is a 65536-byte burst, larger than the MAX_IEC61937_PACKET destination.
-TEST(TestAEPackIEC61937, ABurstLargerThanTheDestinationBufferIsDropped)
+//! A period of 16384 is a 65536-byte burst, the largest IEC 61937 defines: it is packed whole, in
+//! the MAX_IEC61937_PACKET destination and not a byte past it.
+TEST(TestAEPackIEC61937, APeriod16384BurstFitsTheDestinationBuffer)
 {
   std::vector<uint8_t> frame(1000, 0x11);
   std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
 
-  EXPECT_EQ(0, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
+  ASSERT_EQ(65536u, MAX_IEC61937_PACKET);
+  EXPECT_EQ(65536, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
+  EXPECT_EQ(0x11u, dest[IEC61937_DATA_OFFSET]);
+  EXPECT_EQ(0u, dest[MAX_IEC61937_PACKET - 1]);
+  for (unsigned int i = MAX_IEC61937_PACKET; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written past the destination buffer";
+}
+
+//! The largest frame a period of 16384 takes, and one byte more
+TEST(TestAEPackIEC61937, AFrameThatFillsAPeriod16384BurstIsPackedAndOneMoreIsDropped)
+{
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+  std::vector<uint8_t> frame(MAX_IEC61937_PACKET - IEC61937_DATA_OFFSET, 0x22);
+  EXPECT_EQ(65536, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
   for (unsigned int i = MAX_IEC61937_PACKET; i < dest.size(); ++i)
     ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written past the destination buffer";
+
+  std::fill(dest.begin(), dest.end(), CANARY);
+  frame.push_back(0x22);
+  EXPECT_EQ(0, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
+  for (unsigned int i = 0; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written";
+}
+
+//! A period IEC 61937 has no DTS type IV subtype for writes nothing
+TEST(TestAEPackIEC61937, AnUnknownPeriodIsDropped)
+{
+  std::vector<uint8_t> frame(1000, 0x11);
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  EXPECT_EQ(0, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 32768));
+  for (unsigned int i = 0; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written";
 }
