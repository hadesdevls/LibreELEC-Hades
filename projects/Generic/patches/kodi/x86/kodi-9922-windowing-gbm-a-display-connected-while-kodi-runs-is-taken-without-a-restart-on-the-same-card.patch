+/*!
+ * \brief How Kodi takes a display that the display watch offers (CDRMDisplayWatch)
+ */
+enum class DRMTake
+{
+  //! it moves there while it runs (CWinSystemGbm::MoveOutputTo(), as a change of the Monitor
+  //! setting moves it), and is started again only where that cannot be done
+  LIVE,
+  RESTART, //!< a start of Kodi takes it
+};
+
+/*!
+ * \brief Whether a display that the display watch offers is taken while Kodi runs, or by a start
+ *        of Kodi
+ * \param look the look at the outputs of every device in which the display is new
+ * \param node the node of the device in use
+ * \param inUse the output that Kodi shows itself on, named as the look names it (LabelInUse());
+ *        one without a name when it shows itself on none
+ * \param offered the display that is offered (BetterNewOutput() of that look)
+ * \param asked the output that the settings name now
+ * \param[out] why what keeps it from being taken while Kodi runs, for the log; nullptr for LIVE
+ *
+ * Only where it ends as a start would end it: on an output of the device in use (what Kodi draws
+ * with lives in that device: its EGL display and OpenGL context, the buffers of its window, every
+ * texture of the interface, the decoders that hand it their pictures; none of it can be made anew
+ * on another device while Kodi runs), and where a start would take that very output (MoveFor(),
+ * with every display that is connected counting as one that can be used). Kodi on no output has
+ * no CRTC and no plane to move: a start takes the display then.
+ */
+inline DRMTake HowToTake(const DRMLook& look,
+                         const std::string& node,
+                         const DRMOutput& inUse,
+                         const DRMOutput& offered,
+                         const std::string& asked,
+                         const char*& why)
+{
+  why = nullptr;
+  if (inUse.name.empty())
+  {
+    why = "Kodi shows itself on no output, and has none to move from";
+    return DRMTake::RESTART;
+  }
+
+  // The device in use, the output in use and the one offered, in the look
+  int device = -1;
+  for (std::size_t i = 0; i < look.nodes.size() && i < look.outputs.size(); ++i)
+  {
+    if (look.nodes[i] == node)
+      device = static_cast<int>(i);
+  }
+  if (device < 0 || static_cast<std::size_t>(device) >= look.read.size() || !look.read[device])
+  {
+    why = "the graphics device in use is not in the look at the outputs";
+    return DRMTake::RESTART;
+  }
+  const std::vector<DRMOutput>& own = look.outputs[device];
+  int current = -1;
+  int target = -1;
+  for (std::size_t i = 0; i < own.size(); ++i)
+  {
+    if (own[i].name == inUse.name)
+      current = static_cast<int>(i);
+    if (QualifiedOutputName(own[i]) == QualifiedOutputName(offered))
+      target = static_cast<int>(i);
+  }
+  if (current < 0)
+  {
+    why = "the output in use is not in the look at the outputs";
+    return DRMTake::RESTART;
+  }
+  if (target < 0)
+  {
+    why = "the display is on another graphics device, whose output only a start of Kodi takes";
+    return DRMTake::RESTART;
+  }
+  if (!own[target].connected)
+  {
+    why = "nothing is connected to the output any more";
+    return DRMTake::RESTART;
+  }
+
+  // Where a start would take Kodi now: that output, and none other
+  const DRMMove move = MoveFor(look.outputs, device, current, asked);
+  if (move.kind != DRMMove::Kind::HERE || move.device != device || move.output != target)
+  {
+    why = move.kind == DRMMove::Kind::ELSEWHERE ? "a start would take an output of another device"
+          : move.kind == DRMMove::Kind::STAY    ? "a start would leave Kodi on the output in use"
+                                                : "a start would take another output of the device";
+    return DRMTake::RESTART;
+  }
+  return DRMTake::LIVE;
+}
+
+/*!
+ * \brief What came of a move to a display while Kodi runs (CWinSystemGbm::MoveForDisplayWatch())
+ */
+enum class DRMLiveMove
+{
+  MOVED, //!< Kodi shows itself there now
+  NOT_NOW, //!< it was not tried: Kodi cannot move now (its display sleeps, a video plays...)
+  REFUSED, //!< the driver would not take it, or did not: Kodi is on the output it was on
+  LOST, //!< neither the move nor the way back was taken
+};
+
+/*!
+ * \brief Whether Kodi is started again to take the display, after a move while it runs was tried
+ *        or not (HowToTake())
+ *
+ * The start is what Kodi always did, and it takes the display whatever happened here: Kodi moves
+ * where it was to move, in one way or the other. Only a move that was made spares it.
+ */
+inline bool RestartAfterLiveMove(DRMTake take, DRMLiveMove result)
+{
+  return take != DRMTake::LIVE || result != DRMLiveMove::MOVED;
+}
