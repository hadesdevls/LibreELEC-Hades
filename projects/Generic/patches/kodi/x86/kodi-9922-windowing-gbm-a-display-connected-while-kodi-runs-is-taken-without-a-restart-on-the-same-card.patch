+  DRMLiveMove MoveForDisplayWatch(const std::string& output, bool asked, std::string& why);
   //! ... what Kodi knows of its output becomes what it knows of this one, as at a start
   //! (InitWindowSystem()): the information of its display, its 3D, its HDR choices; the
   //! colorimetry and the HDR signalling of the interface are queued for it
diff --git a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
index 3dc7994..5a46232 100644
--- a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
+++ b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
@@ -86,7 +86,8 @@ constexpr std::chrono::seconds ASK_AGAIN_MAX_TIME = 120s;
 // look is given up, and the longest that is waited between two of those looks
 constexpr unsigned int LOOK_TRIES = 6;
 // How often Kodi is started again without anyone having said so, in one run of the system (the
-// file is in memory and goes when the system stops), and never twice for one output
+// file is in memory and goes when the system stops), and never twice for one output. (Hades: a
+// move while Kodi runs counts as one: the same rules decide when it is made.)
 constexpr std::size_t UNASKED_MOVES = 2;
 constexpr const char* MOVES_FILE = "/run/hades-display-moves";
 // How many outputs the notice names
@@ -121,6 +122,8 @@ enum : int
   ANSWER_MOVED_UNSEEN, //!< nobody could be asked (Kodi does not draw): the same
   NOTICE_LATER,
   NOTICE_DONE,
+  ANSWER_MOVED_LIVE, //!< (Hades) the user said to move: Kodi moved while it runs
+  ANSWER_MOVED_LIVE_UNASKED, //!< (Hades) nobody answered: Kodi moved while it runs
 };
 
 // What became of an offer (CDRMDisplayWatch::Offer())
@@ -129,6 +132,7 @@ enum : int
   OFFER_SETTLED, //!< Kodi stays, and the display is not offered again as it is
   OFFER_LATER, //!< nothing came of it: it is made again, when the display is still there then
   OFFER_MOVED, //!< Kodi is being started again
+  OFFER_MOVED_LIVE, //!< (Hades) Kodi moved to it while it runs, and goes on
 };
 
 // Something for the application thread to do. It is posted and never waited for: the result is
@@ -232,6 +236,44 @@ bool SpendUnaskedMove(const std::string& output)
   return file.good();
 }
 
+// Hades: Kodi takes the display: while it runs, where that was decided (HowToTake()) and can be
+// done now, else by a start of Kodi, as it always was (RestartAfterLiveMove()). The log says which
+// way, and why not the other. \param asked the user said to move. \return whether Kodi moved while
+// it runs.
+bool TakeDisplay(const std::string& plain,
+                 const std::string& qualified,
+                 DRMTake take,
+                 const CDRMDisplayWatch::LiveMover& mover,
+                 bool asked)
+{
+  DRMLiveMove result = DRMLiveMove::NOT_NOW;
+  std::string why;
+  if (take == DRMTake::LIVE)
+  {
+    if (mover)
+    {
+      const auto start = std::chrono::steady_clock::now();
+      result = mover(plain, asked, why);
+      if (result == DRMLiveMove::MOVED)
+        CLog::LogF(LOGINFO, "Kodi shows itself on {} now, moved while it runs in {} ms", qualified,
+                   std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::steady_clock::now() - start)
+                       .count());
+    }
+    else
+      why = "this window system cannot move while Kodi runs";
+  }
+  if (!RestartAfterLiveMove(take, result))
+    return true;
+
+  if (take == DRMTake::LIVE)
+    CLog::LogF(result == DRMLiveMove::NOT_NOW ? LOGINFO : LOGWARNING,
+               "Kodi does not move to {} while it runs ({}): it is started again, which takes it",
+               qualified, why.empty() ? std::string("no reason was given") : why);
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+  return false;
