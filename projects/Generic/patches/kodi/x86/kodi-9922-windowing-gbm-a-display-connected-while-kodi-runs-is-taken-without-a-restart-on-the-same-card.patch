+DRMLiveMove CWinSystemGbm::MoveForDisplayWatch(const std::string& output,
+                                               bool asked,
+                                               std::string& why)
+{
+  const auto messenger = CServiceBroker::GetAppMessenger();
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto gui = CServiceBroker::GetGUI();
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  // The conditions of a move for the Monitor setting (ChangeScreen()); music, which a start of Kodi
+  // would end, only where the user said to move
+  if (!messenger || !messenger->IsProcessThread())
+    why = "not on the thread that draws";
+  else if (!drm)
+    why = "the output is not set by atomic modesetting";
+  else if (!drm->IsActive())
+    why = "the display of Kodi sleeps";
+  else if (!gui || !gui->GetSkinInfo())
+    why = "the interface is not up";
+  else if (player && player->IsPlayingVideo())
+    why = "a video plays";
+  else if (player && player->IsPlaying() && !asked)
+    why = "something plays, and nobody said to move";
+  else if (OutputMoveBlocked())
+    why = "the output carries more than the interface";
+  if (!why.empty())
+    return DRMLiveMove::NOT_NOW;
+
+  // Where a start would take Kodi now, with the outputs of this device as the kernel has them (as a
+  // change of the Monitor setting asks it): that very output of this device, or nothing is moved
+  std::vector<std::vector<DRMOutput>> devices;
+  int here = -1;
+  const DRMMove move = m_DRM->OutputMoveFor(m_monitorSetting, true, devices, here);
+  if (move.kind != DRMMove::Kind::HERE || move.device != here || move.device < 0 ||
+      move.output < 0 || devices[move.device][move.output].name != output)
+  {
+    why = move.kind == DRMMove::Kind::ELSEWHERE ? "a start would take an output of another device"
+          : move.kind == DRMMove::Kind::STAY    ? "a start would leave Kodi where it is"
+                                                : "a start would take " +
+                                                      devices[move.device][move.output].name;
+    return DRMLiveMove::NOT_NOW;
+  }
+
+  switch (MoveOutputTo(m_DRM->GetOwnConnector(move.output), "a display was connected to it"))
+  {
+    case OutputMoved::MOVED:
+      return DRMLiveMove::MOVED;
+    case OutputMoved::STAYED:
+      why = "the driver would not take the move, or did not: Kodi is on the output it was on";
+      return DRMLiveMove::REFUSED;
+    case OutputMoved::LOST:
+      break;
+  }
+  why = "neither the move nor the way back went out";
+  return DRMLiveMove::LOST;
+}
