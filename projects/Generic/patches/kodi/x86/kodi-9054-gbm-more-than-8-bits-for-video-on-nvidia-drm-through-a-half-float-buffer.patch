+bool CWinSystemGbmEGLContext::HasFloatOutput() const
+{
+  return IsFloatFormat(static_cast<uint32_t>(m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID)));
+}
+
+// A half-float buffer is chosen for video of more than 8 bits only:
+// - on nvidia-drm, known by the NV_INPUT_COLORSPACE property of its planes. With that property
+//   at "None" the plane has no input colour space, and NVKMS takes a half-float buffer without
+//   its input table and, like a fixed-point one, through identity matrices and the identity
+//   output table: the values that Kodi draws (PQ, HLG or SDR code values between 0 and 1) go out
+//   as they are, at the depth of the link. What another driver does with such a buffer is not
+//   known here;
+// - while the setting for it is on;
+// - while it has not failed: then it is left for the rest of that video, and after
+//   FLOAT_OUTPUT_ATTEMPTS videos in a row for FLOAT_OUTPUT_WAIT more each time, or until the
+//   display is seen to change (VideoStarted()).
+bool CWinSystemGbmEGLContext::FloatOutputUsable() const
+{
+  if (m_floatOutputBlocked || !m_floatOutputSupported)
+    return false;
+
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESFLOATOUTPUT) &&
+      !settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESFLOATOUTPUT))
+    return false;
+
+  CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane();
+  if (!plane)
+    return false;
+
+  const auto none = plane->GetPropertyEnumValue("NV_INPUT_COLORSPACE", "None");
+  return none && plane->GetPropertyValue("NV_INPUT_COLORSPACE") == none;
+}
+
+void CWinSystemGbmEGLContext::FloatOutputFailed(const char* reason)
+{
+  m_floatOutputBlocked = true;
+  ++m_floatOutputFailures;
+  m_floatOutputWait = m_floatOutputFailures >= FLOAT_OUTPUT_ATTEMPTS ? FLOAT_OUTPUT_WAIT : 0;
+  if (m_floatOutputWait)
+    CLog::LogF(LOGWARNING,
+               "the half-float output could not be used ({}); it has failed in each of the last "
+               "{} videos it was tried with: video of more than 8 bits keeps the 8-bit output "
+               "for this video and the {} after it, or until the display is seen to change",
+               reason, m_floatOutputFailures, m_floatOutputWait);
+  else
+    CLog::LogF(LOGWARNING,
+               "the half-float output could not be used ({}): video of more than 8 bits keeps "
+               "the 8-bit output for this video",
+               reason);
+}
