+  if (drmModeAtomicCommit(m_fd, request.Get(),
+                          DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr) < 0)
+  {
+    CLog::LogF(LOGWARNING, "the driver does not take a framebuffer of format {} on plane {}: {}",
+               DRMHELPERS::FourCCToString(fb->format), plane->GetId(), strerror(errno));
+    return false;
+  }
+  return true;
+}
