+++ b/system/shaders/GLES/2.0/gles_shader_rgba_bob_oes.frag
@@ -54,5 +54,8 @@ void main ()
   color *= m_contrast;
   color += m_brightness;
 
-  gl_FragColor = color;
+  // Hades: the same value on a fixed-point output, which clamps what is written to it. A
+  // floating-point one (the half-float output of nvidia-drm) keeps what is outside [0, 1], and
+  // this shader is built before the output of a video is known.
+  gl_FragColor = clamp(color, 0.0, 1.0);
 }
