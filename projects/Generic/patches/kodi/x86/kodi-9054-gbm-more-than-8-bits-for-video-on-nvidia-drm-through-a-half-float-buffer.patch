+void CWinSystemGbmEGLContext::CheckFloatOutput(bool rendered)
+{
+  // Taken whatever the output is: what the driver refused of an 8-bit output says nothing about
+  // a half-float one that is made later.
+  const bool refused = m_DRM->TakeFlipRefused();
+  const bool dropped = m_DRM->TakeFlipDropped();
+  if (!m_floatOutputSupported || !HasFloatOutput())
+    return;
+
+  if (!refused)
+  {
+    // A commit that the driver did not take as it was, and that is not held against the buffer
+    // (the driver was busy, or the commit also turned off the outputs Kodi does not use): the
+    // properties it carried are lost, also where its picture went out with the request before
+    // it. Without the colorimetry and the HDR metadata of the video the picture is wrong through
+    // any buffer: they are queued again.
+    if (dropped)
+      RequeueOutputProperties();
+    else
+      m_floatOutputShown = m_floatOutputShown || rendered;
+    return;
+  }
+
+  // The driver took a half-float buffer when it was asked (TestFramebuffer()) and has refused a
+  // commit since: the flip of a frame, with the colorimetry and the HDR metadata of the video
+  // that the question did not have, or a change of mode that came later (Kodi commits such a
+  // change with the old mode when it is refused, and does not try it again). The 8-bit output is
+  // put back, through which the video plays as it did before there was a half-float one; a
+  // modeset is allowed again, and what the refused commit carried is queued again. (With an
+  // 8-bit output a refused commit is left as Kodi leaves it.) Whether the output is on is not
+  // touched: SetActive(true) would turn on a display that is meant to be off.
+  // Counted once: when the 8-bit output cannot be put back, this comes again with every refusal.
+  const bool first = !m_floatOutputBlocked;
+  if (first)
+    FloatOutputFailed("the driver refused a commit with it");
+
+  struct gbm_bo* bo = nullptr;
+  if (!ChooseEGLConfig(m_renderableType, 8) ||
+      !CreateOutputSurface(m_eglContext.GetConfigAttrib(EGL_NATIVE_VISUAL_ID), bo))
+  {
+    if (first)
+      CLog::LogF(LOGERROR, "the 8-bit output could not be put back");
+    return;
+  }
+  SetOutputPlaneFormat(bo);
+  m_DRM->AllowModeset();
+  RequeueOutputProperties();
+}
