From c7f8a732d8ba8cf3199d1afab7cc34f59d438dbd Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sun, 4 Oct 2026 16:08:45 +0100
Subject: [PATCH] fixed: resolve no resource path through a parent segment

CanResolve accepted any path ending in a slash, so resource://<id>/../
reached the add-on directory above resources for every type, language
and UI sounds included. A path with a .. segment no longer resolves.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: ported to Piers from e1d9aef96cb4bc468e2b5772198ae7ab1f2ca86d. Piers has no CanResolve():
each resource type answers IsAllowed(), and CResourceFile::TranslatePath(),
through which every resource:// file and directory goes, now refuses a path
with a .. segment before asking it. In Piers the font and game types allow
every path and the image type every directory, so resource://<id>/../ and
deeper paths reached files outside the add-on. The GCC part of the commit
does not apply to Piers.]
---
 xbmc/filesystem/ResourceFile.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/xbmc/filesystem/ResourceFile.cpp b/xbmc/filesystem/ResourceFile.cpp
index 10f1d98..7455d32 100644
--- a/xbmc/filesystem/ResourceFile.cpp
+++ b/xbmc/filesystem/ResourceFile.cpp
@@ -20,9 +20,28 @@
 
 #include <array>
 
+#include <string_view>
+
 using namespace ADDON;
 using namespace XFILE;
 
+namespace
+{
+//! A path with a ".." segment can leave the resources directory of the add-on.
+bool HasParentSegment(std::string_view path)
+{
+  while (true)
+  {
+    const size_t end{path.find_first_of("/\\")};
+    if (path.substr(0, end) == "..")
+      return true;
+    if (end == std::string_view::npos)
+      return false;
+    path.remove_prefix(end + 1);
+  }
+}
+} // unnamed namespace
+
 CResourceFile::CResourceFile()
   : COverrideFile(false)
 { }
@@ -48,6 +67,10 @@ bool CResourceFile::TranslatePath(const CURL &url, std::string &translatedPath)
   if (url.GetFileName().length() > addonId.length())
     filePath = url.GetFileName().substr(addonId.size() + 1);
 
+  // No resource path resolves through a parent segment, whatever its type allows
+  if (HasParentSegment(filePath))
+    return false;
+
   if (addonId.empty())
     return false;
 
