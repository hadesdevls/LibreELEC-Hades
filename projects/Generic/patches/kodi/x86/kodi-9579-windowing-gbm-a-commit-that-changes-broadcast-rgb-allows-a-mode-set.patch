From 5459fe486a017d1a393feb3922743b6496627397 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:08:56 +0000
Subject: [PATCH] windowing/gbm: a commit that changes Broadcast RGB allows a
 mode set

nvidia-drm now sets mode_changed when "Broadcast RGB" changes the range of a
head (nvidia-open-kernel-modules-9056 and nvidia-legacy-open-9067, as i915 and
xe do in intel_digital_connector_atomic_check()), so DRM refuses such a
commit without DRM_MODE_ATOMIC_ALLOW_MODESET instead of letting NVKMS make a
mode set that Kodi did not ask for. Found by an independent review of 1.0 RC6.

Kodi asks for a change of it only in a commit that allows one already
(CRgbRange::Stage(): its own mode set, or one that is pending), and the
transport of native Dolby Vision, which sets it on i915 and amdgpu and whose
Dolby vendor InfoFrame makes nvidia-drm keep a head at full range, enters and
leaves in mode sets. CDRMAtomic::DrmAtomicCommit() now makes sure of it for any
request that carries a change of it (CRgbRange::ChangesRange()), and says so in
kodi.log ("the commit changes Broadcast RGB on HDMI-A-1: it allows a mode set").
---
 xbmc/windowing/gbm/RgbRange.h        | 12 ++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 16 ++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/xbmc/windowing/gbm/RgbRange.h b/xbmc/windowing/gbm/RgbRange.h
index 8d8e6f0..2042154 100644
--- a/xbmc/windowing/gbm/RgbRange.h
+++ b/xbmc/windowing/gbm/RgbRange.h
@@ -133,6 +133,18 @@ public:
   };
 
   //! What came of a commit that carried staged (the kernel has kernel after it)
+  /*!
+   * \brief Hades: whether a request that carries "Broadcast RGB" (asked) changes what the kernel
+   *        has (kernel, as Kodi read or committed it): such a commit has to allow a mode set. The
+   *        drivers set mode_changed for a change of it (i915 and xe in
+   *        intel_digital_connector_atomic_check(), nvidia-drm with nvidia-open-kernel-modules-9056
+   *        and nvidia-legacy-open-9067), and DRM refuses the commit otherwise.
+   */
+  static bool ChangesRange(std::optional<uint64_t> asked, std::optional<uint64_t> kernel)
+  {
+    return asked && (!kernel || *asked != *kernel);
+  }
+
   static Outcome AfterCommit(std::optional<uint64_t> staged,
                              std::optional<uint64_t> kernel,
                              bool refused)
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 0df75d1..f5921fb 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -8,6 +8,8 @@
 
 #include "DRMAtomic.h"
 
+#include "windowing/gbm/RgbRange.h"
+
 #include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
 #include "windowing/gbm/HDR10PlusOutput.h"
@@ -163,6 +165,20 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
       tells = false;
   }
 
+  // Hades: a commit that changes "Broadcast RGB" allows a mode set (CRgbRange::ChangesRange()).
+  // Kodi asks for a change of it only in a commit that allows one already (CRgbRange::Stage():
+  // its own mode set, or one that is pending; the transport of native Dolby Vision and its
+  // restoration, which set it on i915 and amdgpu, are mode sets): this is the guard for any other
+  // request that carries it, which the driver would refuse without it.
+  if (!(flags & DRM_MODE_ATOMIC_ALLOW_MODESET) && m_connector &&
+      CRgbRange::ChangesRange(RequestValue(m_connector, CRgbRange::PROPERTY),
+                              m_connector->GetPropertyValue(CRgbRange::PROPERTY)))
+  {
+    flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
+    CLog::LogF(LOGINFO, "the commit changes {} on {}: it allows a mode set", CRgbRange::PROPERTY,
+               m_connector->GetName());
+  }
+
   if (m_old_crtc != nullptr)
   {
     if (m_old_crtc->GetId() != m_crtc->GetId())
-- 
2.53.0

