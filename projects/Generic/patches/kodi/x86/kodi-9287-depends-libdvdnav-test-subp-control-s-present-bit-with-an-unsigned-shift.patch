From 6a41f8449112a2aadae563fb27bb6deec8526717 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:40:20 +0000
Subject: [PATCH] [depends] libdvdnav: test subp_control's present bit with an
 unsigned shift

libdvdnav 7.0.0 tests bit 31 of a PGC's subp_control entry with (1<<31)
at three places: dvdnav_get_number_of_streams() (dvdnav.c:1167),
dvdnav_set_active_stream() (dvdnav.c:1305) and
vm_get_subp_active_stream() (vm/vmget.c:199). Shifting a 1 into the
sign bit of an int is undefined behaviour; with libdvdnav built under
UBSan, every DVD with subpicture streams reports it at the first and
the third. libdvdnav's master branch (8147ccd35e5a) still has the three.

05-all-unsigned-subp-control-shift.patch, a Hades patch on top of 03 and
04, writes them 1u << 31, as vm/vmget.c:147 already does. subp_control
is uint32_t, so in each & the int operand was converted to unsigned int
anyway: the & gives the same unsigned int value and each use (an if, or
negated by !) the same truth value. No other signed 1 shifted into bit
31, nor a signed 1 shifted by a variable, is in libdvdnav 7.0.0 (with 03
and 04) or libdvdread 7.1.1 (with this tree's patches).

Wired like 03 and 04: FindLibDvdNav.cmake's Linux patch list and the
tools/depends Makefile.
---
 cmake/modules/FindLibDvdNav.cmake             |  3 +-
 .../05-all-unsigned-subp-control-shift.patch  | 58 +++++++++++++++++++
 tools/depends/target/libdvdnav/Makefile       |  4 +-
 3 files changed, 63 insertions(+), 2 deletions(-)
 create mode 100644 tools/depends/target/libdvdnav/05-all-unsigned-subp-control-shift.patch

diff --git a/cmake/modules/FindLibDvdNav.cmake b/cmake/modules/FindLibDvdNav.cmake
index 2f1c405..b8ad3b4 100644
--- a/cmake/modules/FindLibDvdNav.cmake
+++ b/cmake/modules/FindLibDvdNav.cmake
@@ -19,7 +19,8 @@ if(NOT TARGET LIBRARY::${CMAKE_FIND_PACKAGE_NAME})
     find_package(LibDvdRead 7.0.0 REQUIRED ${SEARCH_QUIET})
 
     set(patches "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/03-all-fix-cell_find-for-cell-boundary.patch"
-                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/04-all-fix-null-cell_playback.patch")
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/04-all-fix-null-cell_playback.patch"
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/05-all-unsigned-subp-control-shift.patch")
 
     if(WIN32 OR WINDOWS_STORE)
       set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_libType shared)
diff --git a/tools/depends/target/libdvdnav/05-all-unsigned-subp-control-shift.patch b/tools/depends/target/libdvdnav/05-all-unsigned-subp-control-shift.patch
new file mode 100644
index 0000000..c26ec21
--- /dev/null
+++ b/tools/depends/target/libdvdnav/05-all-unsigned-subp-control-shift.patch
@@ -0,0 +1,58 @@
+From d649ddc2f6e61b35ce7fd21ca837c9b516a8423e Mon Sep 17 00:00:00 2001
+From: Hades <15710513+hadesdevls@users.noreply.github.com>
+Date: Thu, 15 Oct 2026 22:39:32 +0000
+Subject: [PATCH] Test the present bit of subp_control with an unsigned shift
+
+dvdnav_get_number_of_streams(), dvdnav_set_active_stream() and
+vm_get_subp_active_stream() test bit 31 of a PGC's subp_control entry
+with (1<<31). Shifting a 1 into the sign bit of an int is undefined
+behaviour (C17 6.5.7p4); UBSan reports it at dvdnav.c:1167 and
+vm/vmget.c:199 on every DVD with subpicture streams, and the same
+expression is at dvdnav.c:1305.
+
+subp_control is uint32_t, so in each & the int operand is converted to
+unsigned int by the usual arithmetic conversions anyway. With 1u << 31
+the operand is 0x80000000 directly, the & gives the same unsigned int
+value, and each use (an if, or negated by !) sees the same truth value.
+vm/vmget.c:147 already writes the test as 1u<<31. libdvdnav's master
+branch (8147ccd35e5a) still has the three signed shifts.
+---
+ src/dvdnav.c   | 4 ++--
+ src/vm/vmget.c | 2 +-
+ 2 files changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/src/dvdnav.c b/src/dvdnav.c
+index f24c5d3..8fb2d7e 100644
+--- a/src/dvdnav.c
++++ b/src/dvdnav.c
+@@ -1164,7 +1164,7 @@ int8_t dvdnav_get_number_of_streams(dvdnav_t *this, dvdnav_stream_type_t stream_
+   case DVD_SUBTITLE_STREAM:
+     for (int i = 0; i < 32; i++)
+     {
+-      if (this->vm->state.pgc->subp_control[i] & (1<<31))
++      if (this->vm->state.pgc->subp_control[i] & (1u<<31))
+         count++;
+     }
+     break;
+@@ -1302,7 +1302,7 @@ dvdnav_status_t dvdnav_set_active_stream(dvdnav_t *this, uint8_t stream_num, dvd
+   switch (stream_type) {
+   case DVD_SUBTITLE_STREAM:
+     if (stream_num >= 32 ||
+-        !(this->vm->state.pgc->subp_control[stream_num] & (1 << 31))) {
++        !(this->vm->state.pgc->subp_control[stream_num] & (1u << 31))) {
+       printerr("Invalid stream index not allowed");
+       pthread_mutex_unlock(&this->vm_lock);
+       return DVDNAV_STATUS_ERR;
+diff --git a/src/vm/vmget.c b/src/vm/vmget.c
+index 5816f2c..8b90c06 100644
+--- a/src/vm/vmget.c
++++ b/src/vm/vmget.c
+@@ -196,7 +196,7 @@ int vm_get_subp_active_stream(vm_t *vm, int mode) {
+   /* If no such stream, then select the first one that exists. */
+   if(streamN == -1) {
+     for(subpN = 0; subpN < 32; subpN++) {
+-      if((vm->state).pgc->subp_control[subpN] & (1<<31)) {
++      if((vm->state).pgc->subp_control[subpN] & (1u<<31)) {
+         if ((streamN = vm_get_subp_stream(vm, subpN, mode)) >= 0)
+           break;
+       }
diff --git a/tools/depends/target/libdvdnav/Makefile b/tools/depends/target/libdvdnav/Makefile
index 7875717..4e05b42 100644
--- a/tools/depends/target/libdvdnav/Makefile
+++ b/tools/depends/target/libdvdnav/Makefile
@@ -3,7 +3,8 @@ DEPS = ../../Makefile.include LIBDVDNAV-VERSION Makefile ../../download-files.in
                                   01-win-uwpcompat.patch \
                                   02-win-remove-lib-version.patch \
                                   03-all-fix-cell_find-for-cell-boundary.patch \
-                                  04-all-fix-null-cell_playback.patch
+                                  04-all-fix-null-cell_playback.patch \
+                                  05-all-unsigned-subp-control-shift.patch
 
 MESON_BUILD_TYPE=release
 
@@ -40,6 +41,7 @@ all: .installed-$(PLATFORM)
 	cd $(PLATFORM); $(ARCHIVE_TOOL) $(ARCHIVE_TOOL_FLAGS) $(TARBALLS_LOCATION)/$(ARCHIVE)
 	cd $(PLATFORM); patch -p1 -i ../03-all-fix-cell_find-for-cell-boundary.patch
 	cd $(PLATFORM); patch -p1 -i ../04-all-fix-null-cell_playback.patch
+	cd $(PLATFORM); patch -p1 -i ../05-all-unsigned-subp-control-shift.patch
 ifeq ($(TARGET_PLATFORM),windows)
 	cd $(PLATFORM); patch -p1 -i ../01-win-uwpcompat.patch
 	cd $(PLATFORM); patch -p1 -i ../02-win-remove-lib-version.patch
-- 
