From 35f40f85c25e7342e852366b1367da601f280e26 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 29 Sep 2026 02:31:58 +0000
Subject: [PATCH] filecache: compute the memory cache size without overflow

settings->GetInt(filecache.memorysize) * 1024 * 1024 is computed in int, and 2048
MB, one of the setting's choices, is 2^31 bytes: a signed overflow, undefined
behaviour. The size is now computed in size_t. A value outside the setting's
choices, possible only in a hand-edited guisettings.xml (values from an options
filler are not range-checked), is bounded: a negative one counts as 0 (the cache
on disk) instead of turning into a huge unsigned size, one above 2048 MB as 2048
MB instead of failing to allocate (an uncaught std::bad_alloc).
---
 xbmc/filesystem/FileCache.cpp | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index 38afbfe..b38dfaf 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -154,8 +154,13 @@ bool CFileCache::Open(const CURL& url)
   if (!settings)
     return false;
 
-  const unsigned int cacheMemSize =
-      settings->GetInt(CSettings::SETTING_FILECACHE_MEMORYSIZE) * 1024 * 1024;
+  // In size_t: 2048 MB, one of the setting's choices, does not fit in an int. A value outside the
+  // choices, possible only in a hand-edited guisettings.xml, is bounded: a negative one counts as 0
+  // (the cache on disk), one above the largest choice as 2048 MB (it could not be allocated).
+  const size_t cacheMemSize =
+      static_cast<size_t>(
+          std::clamp(settings->GetInt(CSettings::SETTING_FILECACHE_MEMORYSIZE), 0, 2048)) *
+      1024 * 1024;
 
   m_source->IoControl(IOControl::SET_CACHE, this);
 
@@ -186,7 +191,8 @@ bool CFileCache::Open(const CURL& url)
     else
     {
       size_t cacheSize;
-      if (m_fileSize > 0 && m_fileSize < cacheMemSize && !(m_flags & READ_AUDIO_VIDEO))
+      if (m_fileSize > 0 && static_cast<uint64_t>(m_fileSize) < cacheMemSize &&
+          !(m_flags & READ_AUDIO_VIDEO))
       {
         // Cap cache size by filesize, but not for audio/video files as those may grow.
         // We don't need to take into account READ_MULTI_STREAM here as that's only used for audio/video
