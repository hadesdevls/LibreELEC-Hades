 xbmc/windowing/gbm/WinSystemGbm.cpp | 126 +++++++++-------
 xbmc/windowing/gbm/WinSystemGbm.h   |   7 +
 3 files changed, 299 insertions(+), 54 deletions(-)
 create mode 100644 xbmc/windowing/gbm/HDRSignal.h

