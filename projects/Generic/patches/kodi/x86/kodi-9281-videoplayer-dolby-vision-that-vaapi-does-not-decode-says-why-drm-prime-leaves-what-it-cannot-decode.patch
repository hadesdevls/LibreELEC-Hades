diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
index ad24e5b..80af159 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
@@ -25,6 +25,9 @@
 #if defined(HAVE_GBM)
 #include "windowing/gbm/WinSystemGbm.h"
 #endif
+#ifdef HAVE_DVBRIDGE
+#include "DVPlaybackPolicy.h"
+#endif
 
 extern "C"
 {
@@ -181,6 +184,34 @@ static const AVCodecHWConfig* FindHWConfig(const AVCodec* codec)
   return nullptr;
 }
 
+#ifdef HAVE_DVBRIDGE
+bool DVBRIDGE::PrimeHardwareDecoders()
+{
+  // (FindHWConfig() without its setting: whether this build could decode anything to DRM PRIME in
+  // hardware at all)
+  static const bool any = []
+  {
+    void* at = nullptr;
+    const AVCodec* codec = nullptr;
+    while ((codec = av_codec_iterate(&at)))
+    {
+      if (!av_codec_is_decoder(codec))
+        continue;
+      const AVCodecHWConfig* config = nullptr;
+      for (int n = 0; (config = avcodec_get_hw_config(codec, n)); n++)
+      {
+        if (config->pix_fmt == AV_PIX_FMT_DRM_PRIME &&
+            (config->methods & (AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX |
+                                AV_CODEC_HW_CONFIG_METHOD_INTERNAL)))
+          return true;
+      }
+    }
+    return false;
+  }();
+  return any;
+}
+#endif
+
 static const AVCodec* FindDecoder(CDVDStreamInfo& hints)
 {
   const AVCodec* codec = nullptr;
@@ -302,6 +333,30 @@ bool CDVDVideoCodecDRMPRIME::Open(CDVDStreamInfo& hints, CDVDCodecOptions& optio
     return false;
   }
 
+#ifdef HAVE_DVBRIDGE
+  // Hades: decoded in software (no decoder decodes this stream to DRM PRIME in hardware), only
+  // 8-bit pictures can be had: a stream of more bits would never give one (see
+  // DVBRIDGE::PrimeSoftwareTakes()). It is left to the next decoder, which decodes it as with this
+  // one off.
+  const bool deepProfile =
+      (hints.codec == AV_CODEC_ID_HEVC && hints.profile == AV_PROFILE_HEVC_MAIN_10) ||
+      (hints.codec == AV_CODEC_ID_H264 && (hints.profile == AV_PROFILE_H264_HIGH_10 ||
+                                           hints.profile == AV_PROFILE_H264_HIGH_10_INTRA)) ||
+      (hints.codec == AV_CODEC_ID_VP9 &&
+       (hints.profile == AV_PROFILE_VP9_2 || hints.profile == AV_PROFILE_VP9_3));
+  if (!FindHWConfig(pCodec) && !DVBRIDGE::PrimeSoftwareTakes(hints.bitdepth, deepProfile))
+  {
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecDRMPRIME::{} - no decoder decodes this stream to DRM PRIME in "
+              "hardware, and decoded in software this decoder takes 8-bit pictures only (this "
+              "stream: {}): it is left to the next decoder",
+              __FUNCTION__,
+              hints.bitdepth ? StringUtils::Format("{} bits", hints.bitdepth)
+                             : std::string("more than 8 bits, by its profile"));
+    return false;
+  }
+#endif
+
   CLog::Log(LOGINFO, "CDVDVideoCodecDRMPRIME::{} - using decoder {}", __FUNCTION__,
             pCodec->long_name ? pCodec->long_name : pCodec->name);
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
