   // ... and never natively, where the user chose another output for this video: its pictures say
   // so, and keep it while the output they were decoded for is still the one in use
   m_dvNoNative = !DVBRIDGE::NativeAllowed(DVBRIDGE::GetOutputChoice());
+  m_dvDecoderTold = false;
   m_dvDisplayMetadata.reset();
   m_dvLightMetadata.reset();
   // Hades: what the stream says it is, in the log without debugging, with the metadata of its
@@ -1049,6 +1050,14 @@ void CDVDVideoCodecFFmpeg::CheckNativeDVPicture(VideoPicture* picture)
   if (!(m_dvNativeOutput || m_dvConvert) ||
       picture->hdrType != StreamHdrType::HDR_TYPE_DOLBYVISION)
     return;
