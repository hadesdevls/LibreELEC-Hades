+void DVBRIDGE::DecoderTook(bool hardware, const CDVDStreamInfo& stream)
+{
+  // What decides whether VAAPI decodes a stream (VAAPI.cpp): the hardware decoder "vaapi" is there
+  // (the GPU has VAAPI), "Allow hardware acceleration - VAAPI" is on (CDecoder::Create()), and so
+  // is the setting of VAAPI for the codec of the stream, which counts only when it is shown
+  // (CDecoder::Open()); and then the driver has to decode that stream.
+  constexpr auto USEVAAPI = "videoplayer.usevaapi";
+  const char* codec = stream.codec == AV_CODEC_ID_HEVC  ? "videoplayer.usevaapihevc"
+                      : stream.codec == AV_CODEC_ID_AV1  ? "videoplayer.usevaapiav1"
+                      : stream.codec == AV_CODEC_ID_H264 ? "videoplayer.usevaapiavc"
+                                                         : nullptr;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const auto accels = CDVDFactoryCodec::GetHWAccels();
+  const bool there = std::find(accels.begin(), accels.end(), "vaapi") != accels.end();
+  const bool vaapiOn = !settings || !settings->GetSetting(USEVAAPI) || settings->GetBool(USEVAAPI);
+  const auto codecSetting = settings && codec ? settings->GetSetting(codec) : nullptr;
+  const bool codecOn = !codecSetting || (settings->GetBool(codec) && codecSetting->IsVisible());
+  const DecoderShortfall shortfall = DecoderShortfallOf(hardware, there, vaapiOn, codecOn);
+  g_dvDecoderShortfall = static_cast<int>(shortfall);
+  if (shortfall == DecoderShortfall::NONE)
+    return;
+  CLog::Log(LOGWARNING,
+            "DVBridge: this Dolby Vision stream is decoded by the processor ({}): native Dolby "
+            "Vision output, and its reconstruction for output as HDR10, need its pictures decoded "
+            "with VAAPI; it plays as Kodi plays it",
+            shortfall == DecoderShortfall::VAAPI_OFF
+                ? "\"Allow hardware acceleration - VAAPI\" is off in the settings, Player > Videos"
+            : shortfall == DecoderShortfall::CODEC_OFF
+                ? StringUtils::Format("VAAPI is off for its codec in the settings ({})", codec)
+            : there ? "VAAPI could not decode it"
+                    : "there is no VAAPI for this graphics card");
+}
+
+DVBRIDGE::DecoderShortfall DVBRIDGE::DecoderShortfallNow()
+{
+  const int shortfall = g_dvDecoderShortfall;
+  return shortfall == static_cast<int>(DecoderShortfall::VAAPI_OFF)   ? DecoderShortfall::VAAPI_OFF
+         : shortfall == static_cast<int>(DecoderShortfall::CODEC_OFF) ? DecoderShortfall::CODEC_OFF
+         : shortfall == static_cast<int>(DecoderShortfall::SOFTWARE)  ? DecoderShortfall::SOFTWARE
+                                                                      : DecoderShortfall::NONE;
+}
