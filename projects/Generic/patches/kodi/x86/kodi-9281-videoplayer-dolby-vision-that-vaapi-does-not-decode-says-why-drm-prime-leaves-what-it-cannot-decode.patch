+/*!
+ * \brief Hades: why the pictures of a Dolby Vision stream that is decoded for native output or for
+ *        output as HDR10 do not come from VAAPI
+ *
+ * Both need them: what the bridge imports are the VAAPI surfaces of the base layer and of the
+ * enhancement layer. The pictures of a stream that VAAPI does not decode are drawn by Kodi's
+ * ordinary renderer, as Kodi plays them (and the enhancement layer is not decoded). Kodi's DRM
+ * PRIME decoder does not come into it: the decoder factory gives such a stream to
+ * CDVDVideoCodecFFmpeg, which uses VAAPI, whatever "Allow using DRM PRIME decoder" says.
+ */
+enum class DecoderShortfall
+{
+  NONE, //!< VAAPI decodes it
+  VAAPI_OFF, //!< "Allow hardware acceleration - VAAPI" is off
+  CODEC_OFF, //!< ... it is on, and the setting of VAAPI for the codec of the stream is off
+  SOFTWARE, //!< both are on, or there is no VAAPI: VAAPI did not decode the stream
+};
+
+//! \param hardware the pictures come from VAAPI; \param vaapiThere VAAPI is there (its hardware
+//! decoder is registered); \param vaapiOn, codecOn the settings
+constexpr DecoderShortfall DecoderShortfallOf(bool hardware,
+                                              bool vaapiThere,
+                                              bool vaapiOn,
+                                              bool codecOn)
+{
+  return hardware      ? DecoderShortfall::NONE
+         : !vaapiThere ? DecoderShortfall::SOFTWARE
+         : !vaapiOn    ? DecoderShortfall::VAAPI_OFF
+         : !codecOn    ? DecoderShortfall::CODEC_OFF
+                       : DecoderShortfall::SOFTWARE;
+}
+
+//! ... as the player information names it (hades.dv.reason); "" for NONE
+constexpr const char* DecoderShortfallCode(DecoderShortfall shortfall)
+{
+  return shortfall == DecoderShortfall::VAAPI_OFF   ? "vaapioff"
+         : shortfall == DecoderShortfall::CODEC_OFF ? "vaapicodec"
+         : shortfall == DecoderShortfall::SOFTWARE  ? "software"
+                                                    : "";
+}
+
+//! The decoder of a stream that is decoded for native output or for output as HDR10 gave its first
+//! picture, from VAAPI or not (VideoPlayer, each time the stream opens): in the log when not, and
+//! for the player information until the next video
+void DecoderTook(bool hardware, const CDVDStreamInfo& stream);
+DecoderShortfall DecoderShortfallNow();
+
+/*!
+ * \brief Hades: whether Kodi's DRM PRIME decoder can decode a stream that no decoder of this build
+ *        decodes to DRM PRIME in hardware
+ *
+ * It decodes such a stream in software into pictures of the formats that its renderer takes:
+ * 8-bit ones only (IsSupportedSwFormat() of CDVDVideoCodecDRMPRIME). A stream of more bits finds no
+ * format to take: FFmpeg then refuses every packet with EPERM (measured with the HEVC Main 10 of
+ * a Dolby Vision stream, with the decoder's software path on the host), which VideoPlayer sends to
+ * the decoder again and again, and no picture ever comes. Such a stream goes to the next decoder.
+ * \param bitDepth of the stream (CDVDStreamInfo::bitdepth, from the format the demuxer found; 0
+ *        when not known)
+ * \param deepProfile its profile is one of more than 8 bits (HEVC Main 10, H.264 High 10, VP9
+ *        profile 2 or 3): what decides when the bit depth is not known
+ */
+constexpr bool PrimeSoftwareTakes(int bitDepth, bool deepProfile)
+{
+  return bitDepth > 8 ? false : bitDepth > 0 ? true : !deepProfile;
+}
+
+//! Whether any decoder of this build decodes to DRM PRIME in hardware (with the hardware
+//! configurations that CDVDVideoCodecDRMPRIME looks for); asked once
+bool PrimeHardwareDecoders();
 } // namespace DVBRIDGE
