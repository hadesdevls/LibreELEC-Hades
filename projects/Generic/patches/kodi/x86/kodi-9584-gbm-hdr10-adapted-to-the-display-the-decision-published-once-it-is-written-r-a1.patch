+/*!
+ * \brief The decision of a video, decided once and read from any thread
+ *
+ * The renderer asks it from VideoPlayer's thread (DVBridgeConfigChanged()) and from the render thread
+ * (Configure()), and the player information reads it from the GUI. The first caller of a video decides:
+ * it computes the decision in local, with make(), and publishes it with release; one that comes while it
+ * is being decided computes its own in local and uses it without publishing it; once it is published,
+ * every caller and reader takes the published one (acquire). A new video (Reset(), any thread) makes the
+ * next caller decide again, and a decision begun before it is not published for the new video.
+ *
+ * Everything the readers take is in one atomic word, with the state and the video it is of (a
+ * generation): there is no data beside it to be read half written. The word holds what the readers use:
+ * the verdict, the mode, whether the video's peak is its MaxCLL, the video's peak in cd/m2 (rounded: it
+ * is shown so) and the display's as a float (the mapping takes it as one). (Hades: until the second
+ * independent review of 1.0 RC6, R-A1, the decision was marked decided before it was written, and read
+ * with no synchronisation.)
+ */
+class CState
+{
+public:
+  struct Snapshot
+  {
+    bool ready = false; //!< (Read()) a decision is published for this video
+    Mode mode = Mode::OFF;
+    Decision decision{};
+  };
+
+  //! A new video (any thread)
+  void Reset()
+  {
+    uint64_t word = m_word.load(std::memory_order_relaxed);
+    while (!m_word.compare_exchange_weak(word, Generation(Next(word)) | NONE,
+                                         std::memory_order_acq_rel, std::memory_order_relaxed))
+      ;
+  }
+
+  /*!
+   * \brief The decision for this caller (see the class)
+   * \param make Snapshot(): the decision made in local
+   * \param published (may be nullptr) set where this caller's decision is the one published, to tell
+   *        it once
+   */
+  template<typename Make>
+  Snapshot Get(Make make, bool* published = nullptr)
+  {
+    if (published)
+      *published = false;
+    uint64_t word = m_word.load(std::memory_order_acquire);
+    if ((word & PHASE) == READY)
+      return Unpack(word);
+    if ((word & PHASE) == NONE)
+    {
+      const uint64_t deciding = Generation(word) | DECIDING;
+      if (m_word.compare_exchange_strong(word, deciding, std::memory_order_acquire,
+                                         std::memory_order_acquire))
+      {
+        Snapshot made = make();
+        made.ready = true;
+        uint64_t expected = deciding;
+        // (not where a new video came meanwhile: the decision is of the one before)
+        if (m_word.compare_exchange_strong(expected, Pack(deciding, made), std::memory_order_release,
+                                           std::memory_order_relaxed) &&
+            published)
+          *published = true;
+        return made;
+      }
+      if ((word & PHASE) == READY)
+        return Unpack(word);
+    }
+    // (another caller decides now: this one's own, not published)
+    Snapshot made = make();
+    made.ready = true;
+    return made;
+  }
+
+  //! What is published for this video (acquire); ready false where nothing is yet
+  Snapshot Read() const
+  {
+    const uint64_t word = m_word.load(std::memory_order_acquire);
+    return (word & PHASE) == READY ? Unpack(word) : Snapshot{};
+  }
+
+  //! The video it is of (a number that changes with each Reset(); for what a thread keeps of a video)
+  uint32_t Video() const
+  {
+    return static_cast<uint32_t>((m_word.load(std::memory_order_acquire) >> GEN_SHIFT) & GEN_MASK);
+  }
+
+  //! (for the tests) the word of a snapshot, and back
+  static uint64_t PackForTest(const Snapshot& s) { return Pack(READY, s); }
+  static Snapshot UnpackForTest(uint64_t word) { return Unpack(word); }
+
+private:
+  // bits 0-1 the state, 2-8 the video, 9-12 the verdict, 13-14 the mode, 15 from MaxCLL, 16-31 the
+  // video's peak (cd/m2, rounded), 32-63 the display's peak (the bits of a float)
+  static constexpr uint64_t PHASE = 3, NONE = 0, DECIDING = 1, READY = 2;
+  static constexpr int GEN_SHIFT = 2;
+  static constexpr uint64_t GEN_MASK = 127;
+  static uint64_t Generation(uint64_t word) { return word & (GEN_MASK << GEN_SHIFT); }
+  static uint64_t Next(uint64_t word)
+  {
+    return (((word >> GEN_SHIFT) + 1) & GEN_MASK) << GEN_SHIFT;
+  }
+  static uint64_t Pack(uint64_t generation, const Snapshot& s)
+  {
+    const double source = std::isfinite(s.decision.sourcePeak) && s.decision.sourcePeak > 0
+                              ? std::fmin(std::round(s.decision.sourcePeak), 65535.0)
+                              : 0.0;
+    const float display = static_cast<float>(s.decision.displayPeak);
+    uint32_t displayBits = 0;
+    std::memcpy(&displayBits, &display, sizeof(displayBits));
+    return Generation(generation) | READY |
+           (static_cast<uint64_t>(static_cast<unsigned>(s.decision.verdict) & 15) << 9) |
+           (static_cast<uint64_t>(static_cast<unsigned>(s.mode) & 3) << 13) |
+           (static_cast<uint64_t>(s.decision.fromMaxCll ? 1 : 0) << 15) |
+           (static_cast<uint64_t>(source) << 16) | (static_cast<uint64_t>(displayBits) << 32);
+  }
+  static Snapshot Unpack(uint64_t word)
+  {
+    Snapshot s;
+    s.ready = (word & PHASE) == READY;
+    s.decision.verdict = static_cast<Verdict>((word >> 9) & 15);
+    s.mode = static_cast<Mode>((word >> 13) & 3);
+    s.decision.fromMaxCll = ((word >> 15) & 1) != 0;
+    s.decision.sourcePeak = static_cast<double>((word >> 16) & 0xFFFF);
+    const uint32_t displayBits = static_cast<uint32_t>(word >> 32);
+    float display = 0;
+    std::memcpy(&display, &displayBits, sizeof(display));
+    s.decision.displayPeak = display;
+    return s;
+  }
+  std::atomic<uint64_t> m_word{0};
+};
+
