+}
+
+void CWinSystemGbmGLESContext::Hdr10AdaptTell(const HDR10_ADAPT::CState::Snapshot& s, bool peakSet,
+                                              bool hdr10Plus) const
+{
+  namespace A = HDR10_ADAPT;
+  // (told where there is something to say: not with the setting off, nor for a video that is not
+  // HDR10)
+  if (s.decision.verdict == A::Verdict::OFF || s.decision.verdict == A::Verdict::NOT_HDR10)
+    return;
+  CLog::Log(LOGINFO,
+            "DVBridge: HDR10 adapted to the display ({}, videoscreen.hadeshdr10adapt): {}; the "
+            "video's peak {} ({}), the display's {} ({}){}",
+            s.mode == A::Mode::ALWAYS ? "always" : "automatic", A::Why(s.decision.verdict),
+            s.decision.sourcePeak > 0 ? StringUtils::Format("{:.0f} cd/m2", s.decision.sourcePeak)
+                                      : std::string("not given"),
+            s.decision.fromMaxCll ? "its MaxCLL" : "its mastering display",
+            A::Usable(s.decision.displayPeak)
+                ? StringUtils::Format("{:.0f} cd/m2", s.decision.displayPeak)
+                : std::string("not given"),
+            peakSet ? "set for the mapping to the display" : "of its EDID",
+            hdr10Plus && s.decision.verdict == A::Verdict::ADAPTED
+                ? "; its HDR10+ metadata are not sent with the mapped picture"
+                : "");
+}
+
+bool CWinSystemGbmGLESContext::Hdr10AdaptWanted(const VideoPicture& picture)
+{
+  // (a picture of Dolby Vision is never asked this: it goes its own way, native or reconstructed)
+  if (picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+    return false;
+  // Hades: decided once a video: the first caller decides in local and publishes it, one that comes
+  // meanwhile uses its own (HDR10_ADAPT::CState; the second independent review of 1.0 RC6, R-A1)
+  bool peakSet = false, published = false;
+  const HDR10_ADAPT::CState::Snapshot s =
+      m_hdr10Adapt.Get([&] { return Hdr10AdaptDecide(picture, peakSet); }, &published);
+  if (published)
+    Hdr10AdaptTell(s, peakSet, picture.hdr10PlusVsif.has_value());
+  return s.decision.verdict == HDR10_ADAPT::Verdict::ADAPTED && !m_plainDisabled &&
          m_dvConvertDisplay;
 }
 
