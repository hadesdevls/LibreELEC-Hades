+                   format ? std::optional<unsigned int>(static_cast<unsigned int>(*format))
+                          : std::nullopt,
+                   bpc)
+          : Made::NOTHING;
+  m_hdrLockKey = key;
+  m_hdrLockLink = HOTPLUG_RELINK::LinkOf(link);
+  m_hdrLockArmed = m_hdrOnOutput != Made::NOTHING;
+  m_hdrLockAt = std::chrono::steady_clock::now();
