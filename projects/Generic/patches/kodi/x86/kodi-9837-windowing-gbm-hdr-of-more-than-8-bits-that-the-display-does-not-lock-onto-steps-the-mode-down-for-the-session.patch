+
+// Hades: HDR of more than 8 bits that the parameters of nvidia-modeset made, and whether the display
+// locked onto it: its SCDC, read CHECK_AFTER_MS after the commit that put it out (and again after
+// the output was turned off and on for a hot-plug event), through the DDC port of the connector, on
+// a thread of its own, as LookForRelink() reads it. Not locked: one level less for this mode for the
+// rest of the session, written to nvidia-modeset, and the output turned off and on so that NVKMS
+// sets it so now (as for a hot-plug event); the log says it. HdrMoreBits.h.
+void CWinSystemGbmGLESContext::LookForHdrLock()
+{
+  using namespace HDR_MORE_BITS;
+  if (!m_hdrLockArmed && !m_hdrLockRead.valid())
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  Check check;
+  check.made = m_hdrLockArmed ? m_hdrOnOutput : Made::NOTHING;
+  check.sinceMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - m_hdrLockAt)
+                      .count();
+  check.outputOn = connector && drm->IsActive() && drm->GetCrtc() &&
+                   drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0;
+#ifdef HAVE_DVBRIDGE
+  check.outputOn = check.outputOn && !m_outputHandover.HoldsOutput();
+#endif
+  check.readInFlight = m_relinkRead.valid() || m_hdrLockRead.valid();
+  std::string said;
+  if (m_hdrLockRead.valid())
+  {
+    if (m_hdrLockRead.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+      return;
+    const HOTPLUG_RELINK::ScdcRead read = m_hdrLockRead.get();
+    if (check.made == Made::NOTHING)
+      return; // (the output changed while it was read)
+    check.readInFlight = false;
+    check.lock = LockOf(read.flags, read.config,
+                        m_hdrLockLink == HOTPLUG_RELINK::Link::TMDS_SCRAMBLED);
+    said = read.said;
+  }
+  const Step step = Next(check);
+  if (step == Step::WAIT)
+    return;
+  const std::string what = std::string(Name(m_hdrOnOutput));
+  const std::string where = m_hdrLockKey;
+  if (step == Step::DROP)
+  {
+    m_hdrLockArmed = false;
+    return;
+  }
+  if (step == Step::READ)
+  {
+    const int fd = drm->GetFileDescriptor();
+    const auto port = connector->SupportsProperty("NV_DDC_I2C_PORT")
+                          ? connector->ReadPropertyValue("NV_DDC_I2C_PORT")
+                          : std::optional<uint64_t>{};
+    const auto outputs = OutputsOfDevice(fd, false);
+    const auto own = outputs.find(*connector->GetConnectorId());
+    const std::string device = PciDeviceOf(fd);
+    std::string why;
+    if (!port || *port >= HOTPLUG_RELINK::NO_DDC_PORT)
+      why = "nvidia-drm names no DDC port of the connector (NV_DDC_I2C_PORT)";
+    else if (own == outputs.end() || own->second.second.empty() || device.empty())
+      why = "the EDID of the connector or its graphics card could not be read";
+    else
+    {
+      try
+      {
+        m_hdrLockRead = std::async(std::launch::async, ReadScdcOf, device,
+                                   static_cast<unsigned int>(*port), own->second.second,
+                                   m_hdrLockLink);
+        return;
+      }
+      catch (const std::system_error& error)
+      {
+        why = StringUtils::Format("no thread could be started for it ({})", error.what());
+      }
+    }
+    CLog::Log(LOGINFO,
+              "HDR output: whether the display locked onto HDR in {} in {} is not known: its SCDC "
+              "could not be read ({}); it stays so",
+              what, where, why);
+    m_hdrLockArmed = false;
+    return;
+  }
+  if (step == Step::KEEP || step == Step::UNKNOWN)
+  {
+    CLog::Log(LOGINFO, "HDR output: {} in {} ({}){}", what, where, said,
+              step == Step::KEEP ? ": the display locked onto it"
+                                 : ": what the display locked onto cannot be told from it; it "
+                                   "stays so");
+    m_hdrLockArmed = false;
+    return;
+  }
+
+  // Step::STEP_DOWN
+  const Level below = Below(m_hdrOnOutput);
+  m_hdrMoreBitsCap[where] = below;
+  CLog::Log(LOGWARNING,
+            "HDR output: the display did not lock onto HDR in {} in {} ({}): for the rest of the "
+            "session this mode goes out with {}, and the output is turned off and on so that the "
+            "driver sets it so now (HdrMoreBits.h)",
+            what, where, said, Name(below));
+  m_hdrLockArmed = false;
+  m_hdrOnOutput = Made::NOTHING;
+  ApplyHdrMoreBits();
+  // As RelinkDecide() does: the display's answer to it is taken as an echo of it
+  m_relinkDone = true;
+  m_relinkAt = std::chrono::steady_clock::now();
+  const auto active = [&drm]
+  { return drm->GetCrtc() && drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0; };
+  Hide();
+  const bool off = !drm->LastCommitRefused() && !active();
+  Show(true);
+  // (the depth is asked again, and what goes out now looked at again)
+  ResetOutputDepth();
+  if (!off)
+  {
+    CLog::Log(LOGWARNING,
+              "HDR output: turning the output off was refused: {} goes out with the next change of "
+              "mode",
+              Name(below));
+    return;
+  }
+  if (!active())
+  {
+    CLog::Log(LOGERROR, "HDR output: the output could not be turned on again: it is asked to "
+                        "again, after 1 s and then less often");
+    drm->AllowModeset();
+    OutputLeftOff();
+  }
+}
