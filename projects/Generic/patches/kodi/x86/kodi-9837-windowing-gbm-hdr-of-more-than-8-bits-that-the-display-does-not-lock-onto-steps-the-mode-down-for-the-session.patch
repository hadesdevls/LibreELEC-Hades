index 9e19ff5..ad16022 100644
--- a/xbmc/windowing/gbm/HotplugRelink.h
+++ b/xbmc/windowing/gbm/HotplugRelink.h
@@ -227,6 +227,8 @@ struct ScdcRead
 {
   Sink sink = Sink::UNKNOWN;
   std::string said;
+  std::optional<uint8_t> config; //!< TMDS_Config, where it was read
+  std::optional<uint8_t> flags; //!< Status_Flags_0, where it was read (HDR_MORE_BITS::LockOf())
 };
 
 enum class Verdict
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index ec58558..6ae37a4 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -542,6 +542,9 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   LookAtModes();
   // Hades: ... and its link, where it came back on a scrambled HDMI link of nvidia-drm
   LookForRelink();
+  // Hades: ... and whether the display locked onto HDR of more than 8 bits that the parameters of
+  // nvidia-modeset made (HdrMoreBits.h)
+  LookForHdrLock();
 
 #ifdef HAVE_DVBRIDGE
   // Hades: the frame that the render manager chose for this pass, if it chose one (CPresentLag)
@@ -1664,6 +1667,10 @@ HOTPLUG_RELINK::ScdcRead ReadScdcOf(std::string device,
                     i2c.Byte(SCDC_ADDRESS, SCDC_STATUS_FLAGS_0, flags);
   read.sink = SinkOf(link, configRead ? std::optional<uint8_t>(config) : std::nullopt,
                      frlRead ? std::optional<uint8_t>(frl) : std::nullopt);
+  if (configRead)
