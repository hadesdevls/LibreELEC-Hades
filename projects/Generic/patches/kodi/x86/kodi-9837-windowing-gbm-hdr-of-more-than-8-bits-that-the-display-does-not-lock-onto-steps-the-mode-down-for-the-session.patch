+// parameters of nvidia-modeset made it (a format of more than 8 bits that NVKMS would not have
+// chosen), the display is looked at a moment later (LookForHdrLock())
+void CWinSystemGbmGLESContext::HdrMoreBitsWentOut(std::optional<uint64_t> link, unsigned int bpc)
+{
+  using namespace HDR_MORE_BITS;
