From 0c630a8bc08ab3de8b87c32f71b1aec80138e24a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:16:02 +0000
Subject: [PATCH] DVDInputStreamBluray: decode the menus of a disc in the
 matrix of its video (BT.709 for HD)

The palette entries of a disc's graphics (Y, Cr, Cb) are in the matrix of the video they go over.
libbluray says so where it hands them to the player (overlay.h, BD_PG_PALETTE_ENTRY: "Y, Cr and Cb
have the same color matrix as the associated video stream"), as the Blu-ray specification has it for
the palette definition segment ("Y, Cr and Cb shall have the same color matrix as the associated HDMV
Video stream": BT.601 for 525-60 and 625-50, BT.709 for 1080i and 720p, as quoted on ffmpeg-devel in
April 2016 for FFmpeg commit 9779b6262471, which made its PGS decoder take BT.709 for a video over 576
lines). Kodi decodes the subtitles of a disc with FFmpeg, in BT.709 on a Blu-ray of HD video, but
decoded the palettes of its menus, which libbluray hands over as they are, with the coefficients of
BT.601 on every disc.

Measured over every Y'CbCr of the range that is a BT.709 colour (2721508 of them): with the BT.601
coefficients a channel was up to 38 codes of 255 off BT.709, the largest channel of a colour 12.0
codes off on average, over 2 codes for 95 % of them and over 10 for 52 %; the red of the BT.709 colour
bars came out 233 0 2, its green 20 255 9, the 75 % green 15 223 5. Now every one is as BT.709
defines it, rounded (0 codes off), and within one code of FFmpeg's decoding of the subtitles of the
same video.

The matrix is the one of the clip's video: the colour space an Ultra HD Blu-ray clip declares
(BT.709 or BT.2020), else its format, 720p, 1080i and 1080p being BT.709. 480i, 576i, 480p, 576p and
a video not known keep the conversion Kodi had, byte for byte, and PQ graphics are unchanged.
kodi.log says the matrix of each disc and each change. What BD-J draws is ARGB and is not concerned.

Tests (outside the tree): bd_matrix_test: the matrix of every format and colour space; SD byte for
byte as Kodi's build_rgba() for every Y'CbCr and two alphas; PQ byte for byte as before, whatever
the matrix; BT.709 and BT.2020 in SDR as their definitions for every Y'CbCr; the error before and
after; FFmpeg's own macros; eight mutants, each caught. bd_wiring.py: the matrix comes from the
format and colour space of the clip's video, is told in the log, read once per image by the overlay
callback and given to the one caller of PaletteEntryToRGBA(); it fails on the tree before, and four
mutants are caught.
---
 .../DVDInputStreams/BlurayGraphicsRange.h     | 91 +++++++++++++++----
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 35 ++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    | 13 ++-
 3 files changed, 114 insertions(+), 25 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
index f471717..3411084 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayGraphicsRange.h
@@ -48,6 +48,45 @@ constexpr const char* RangeName(Range range)
   return range == Range::PQ ? "PQ (BT.2020, ST 2084)" : "SDR";
 }
 
+/*!
+ * \brief (Hades) The matrix of the Y'CbCr of the palettes of a disc's graphics in SDR
+ *
+ * The colours of a palette of a disc's graphics are in the matrix of the video they go over:
+ * "Y, Cr and Cb have the same color matrix as the associated video stream" (libbluray, overlay.h,
+ * BD_PG_PALETTE_ENTRY), as the Blu-ray specification has it for its palette definition segment:
+ * ITU-R BT.601 for 525-60 and 625-50 video, ITU-R BT.709 for 1080i and 720p. FFmpeg's PGS decoder,
+ * which decodes the subtitles of the same disc in Kodi, takes BT.709 for a video over 576 lines.
+ * Kodi decoded the palettes of the menus libbluray draws (HDMV's interactive graphics; Kodi decodes
+ * the subtitles itself) with the coefficients of BT.601 on every disc: on a Blu-ray of HD video
+ * their colours were not the disc's, nor the ones of its subtitles. A disc of SD video, or one
+ * whose video is not known, keeps them as they were.
+ */
+enum class Matrix
+{
+  BT601, //!< ITU-R BT.601, as Kodi has always converted them: 480i, 576i, 480p, 576p, not known
+  BT709, //!< ITU-R BT.709: 720p, 1080i, 1080p, and a clip that declares BT.709
+  BT2020, //!< ITU-R BT.2020 (non-constant luminance): a clip that declares it (Ultra HD Blu-ray)
+};
+
+//! The matrix of the video of a clip: the colour space an Ultra HD Blu-ray clip declares
+//! (bd_color_space_e: 1 BT.709, 2 BT.2020; 0 on a Blu-ray before Ultra HD), else its format
+//! (bd_video_format_e: 4 1080i, 5 720p and 6 1080p are BT.709; 1 480i, 2 576i, 3 480p, 7 576p,
+//! and a format not known, are BT.601 as they were)
+constexpr Matrix MatrixOfVideo(uint8_t format, uint8_t colorSpace)
+{
+  if (colorSpace == 2)
+    return Matrix::BT2020;
+  if (colorSpace == 1 || format == 4 || format == 5 || format == 6)
+    return Matrix::BT709;
+  return Matrix::BT601;
+}
+
+//! The text of a matrix for kodi.log
+constexpr const char* MatrixName(Matrix matrix)
+{
+  return matrix == Matrix::BT709 ? "BT.709" : (matrix == Matrix::BT2020 ? "BT.2020" : "BT.601");
+}
+
 namespace DETAIL
 {
 constexpr uint8_t Clamp(double v)
@@ -61,31 +100,47 @@ constexpr uint32_t Pack(uint8_t t, double r, double g, double b)
          static_cast<uint32_t>(Clamp(g)) << PIXEL_GSHIFT |
          static_cast<uint32_t>(Clamp(b)) << PIXEL_BSHIFT;
 }
+
+//! A limited-range Y'CbCr of the matrix of Kr and Kb (non-constant luminance) as R'G'B'
+constexpr uint32_t FromMatrix(uint8_t y, uint8_t cr, uint8_t cb, uint8_t t, double kr, double kb)
+{
+  const double kg = 1.0 - kr - kb;
+  const double luma = 255.0 / 219.0 * (y - 16);
+  const double pb = 255.0 / 224.0 * (cb - 128);
+  const double pr = 255.0 / 224.0 * (cr - 128);
+  return Pack(t, luma + 2.0 * (1.0 - kr) * pr,
+              luma - 2.0 * kb * (1.0 - kb) / kg * pb - 2.0 * kr * (1.0 - kr) / kg * pr,
+              luma + 2.0 * (1.0 - kb) * pb);
+}
 } // namespace DETAIL
 
 /*!
  * \brief The colour of an entry of a palette of a disc's graphics (Y, Cr, Cb and its alpha T, as
  * BD_PG_PALETTE_ENTRY has them), packed as Kodi's overlays are (PIXEL_*SHIFT)
  *
- * SDR: as Kodi has always converted them (BT.601 coefficients), byte for byte. PQ: with the
- * coefficients of ITU-R BT.2020 (non-constant luminance, Kr 0.2627, Kb 0.0593), limited range, as
- * the subtitles of the same video (FFmpeg's PGS decoder, told the video's BT.2020 matrix).
+ * PQ: with the coefficients of ITU-R BT.2020 (non-constant luminance, Kr 0.2627, Kb 0.0593),
+ * limited range, as the subtitles of the same video (FFmpeg's PGS decoder, told the video's BT.2020
+ * matrix). SDR: in the matrix of the video (MatrixOfVideo); BT.601 as Kodi has always converted
+ * them, byte for byte; BT.709 (Kr 0.2126, Kb 0.0722) and BT.2020 from their definitions, limited
+ * range.
  */
-constexpr uint32_t PaletteEntryToRGBA(uint8_t y, uint8_t cr, uint8_t cb, uint8_t t, Range range)
+constexpr uint32_t PaletteEntryToRGBA(
+    uint8_t y, uint8_t cr, uint8_t cb, uint8_t t, Range range, Matrix matrix)
 {
-  if (range == Range::SDR)
-    return DETAIL::Pack(t, 1.164 * (y - 16) + 1.596 * (cr - 128),
-                        1.164 * (y - 16) - 0.391 * (cb - 128) - 0.813 * (cr - 128),
-                        1.164 * (y - 16) + 2.018 * (cb - 128));
-
-  constexpr double kr = 0.2627;
-  constexpr double kb = 0.0593;
-  constexpr double kg = 1.0 - kr - kb;
-  const double luma = 255.0 / 219.0 * (y - 16);
-  const double pb = 255.0 / 224.0 * (cb - 128);
-  const double pr = 255.0 / 224.0 * (cr - 128);
-  return DETAIL::Pack(t, luma + 2.0 * (1.0 - kr) * pr,
-                      luma - 2.0 * kb * (1.0 - kb) / kg * pb - 2.0 * kr * (1.0 - kr) / kg * pr,
-                      luma + 2.0 * (1.0 - kb) * pb);
+  if (range == Range::PQ || matrix == Matrix::BT2020)
+  {
+    constexpr double kr = 0.2627;
+    constexpr double kb = 0.0593;
+    return DETAIL::FromMatrix(y, cr, cb, t, kr, kb);
+  }
+  if (matrix == Matrix::BT709)
+  {
+    constexpr double kr = 0.2126;
+    constexpr double kb = 0.0722;
+    return DETAIL::FromMatrix(y, cr, cb, t, kr, kb);
+  }
+  return DETAIL::Pack(t, 1.164 * (y - 16) + 1.596 * (cr - 128),
+                      1.164 * (y - 16) - 0.391 * (cb - 128) - 0.813 * (cr - 128),
+                      1.164 * (y - 16) + 2.018 * (cb - 128));
 }
 } // namespace KODI::BLURAYGRAPHICS
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 7066365..b8f67f0 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -341,6 +341,10 @@ bool CDVDInputStreamBluray::Open()
 
   m_stereoscopicDisc = disc_info->content_exist_3D != 0;
 
+  // Hades: the matrix of the disc's graphics is told by the video of its first playlist
+  // (UpdateGraphicsRange())
+  m_graphicsMatrixSet = false;
+
 #if (BLURAY_VERSION >= BLURAY_VERSION_CODE(1, 5, 0))
   // Hades: the range of the disc's graphics until a playlist tells its own: what a BD-J disc draws
   // while it starts is made for the range it starts in (BlurayGraphicsRange.h)
@@ -1367,15 +1371,21 @@ int CDVDInputStreamBluray::ReadBlocks(uint8_t* buf, int lba, int num_blocks)
 
 void CDVDInputStreamBluray::UpdateGraphicsRange()
 {
-#if (BLURAY_VERSION >= BLURAY_VERSION_CODE(1, 5, 0))
   const BLURAY_CLIP_INFO* clip = m_clip;
   if (!clip && m_titleInfo && m_titleInfo->clip_count > 0)
     clip = &m_titleInfo->clips[0];
   if (!clip || !clip->video_streams || clip->video_stream_count == 0)
     return;
-  SetGraphicsRange(KODI::BLURAYGRAPHICS::RangeOfVideo(clip->video_streams[0].dynamic_range_type),
-                   m_clip ? "the video of the play item" : "the video of the playlist");
+  const BLURAY_STREAM_INFO& video = clip->video_streams[0];
+  const char* from = m_clip ? "the video of the play item" : "the video of the playlist";
+#if (BLURAY_VERSION >= BLURAY_VERSION_CODE(1, 5, 0))
+  SetGraphicsRange(KODI::BLURAYGRAPHICS::RangeOfVideo(video.dynamic_range_type), from);
+  // the colour space an Ultra HD Blu-ray clip declares (0 on a Blu-ray before Ultra HD)
+  const uint8_t colorSpace = video.color_space;
+#else
+  const uint8_t colorSpace = 0;
 #endif
+  SetGraphicsMatrix(KODI::BLURAYGRAPHICS::MatrixOfVideo(video.format, colorSpace), from);
 }
 
 void CDVDInputStreamBluray::SetGraphicsRange(KODI::BLURAYGRAPHICS::Range range, const char* from)
@@ -1390,6 +1400,18 @@ void CDVDInputStreamBluray::SetGraphicsRange(KODI::BLURAYGRAPHICS::Range range,
             KODI::BLURAYGRAPHICS::RangeName(range), from);
 }
 
+void CDVDInputStreamBluray::SetGraphicsMatrix(KODI::BLURAYGRAPHICS::Matrix matrix, const char* from)
+{
+  if (m_graphicsMatrixSet && m_graphicsMatrix == matrix)
+    return;
+  m_graphicsMatrixSet = true;
+  m_graphicsMatrix = matrix;
+  CLog::Log(LOGINFO,
+            "CDVDInputStreamBluray - the palettes of the disc's graphics in SDR (its menus) are "
+            "in the {} matrix, the one of {}",
+            KODI::BLURAYGRAPHICS::MatrixName(matrix), from);
+}
+
 void CDVDInputStreamBluray::OverlayClose()
 {
 #if(BD_OVERLAY_INTERFACE_VERSION >= 2)
@@ -1588,8 +1610,10 @@ void CDVDInputStreamBluray::OverlayCallback(const BD_OVERLAY * const ov)
     // sees them one by one, without the group (CRenderer::SubtitleDepth())
     overlay->SetDiscMenu(true);
     // Hades: in the range the disc's graphics are made in: PQ on an HDR playlist of an Ultra HD
-    // Blu-ray (BlurayGraphicsRange.h), drawn as the PGS of a PQ video are
+    // Blu-ray (BlurayGraphicsRange.h), drawn as the PGS of a PQ video are; in SDR, in the matrix
+    // of the video they go over (BT.709 on a disc of HD video)
     const KODI::BLURAYGRAPHICS::Range range = m_graphicsRange;
+    const KODI::BLURAYGRAPHICS::Matrix matrix = m_graphicsMatrix;
     overlay->m_isHDROverlay = range == KODI::BLURAYGRAPHICS::Range::PQ;
 
     if (ov->palette)
@@ -1598,7 +1622,8 @@ void CDVDInputStreamBluray::OverlayCallback(const BD_OVERLAY * const ov)
 
       for(unsigned i = 0; i < 256; i++)
         overlay->palette[i] = KODI::BLURAYGRAPHICS::PaletteEntryToRGBA(
-            ov->palette[i].Y, ov->palette[i].Cr, ov->palette[i].Cb, ov->palette[i].T, range);
+            ov->palette[i].Y, ov->palette[i].Cr, ov->palette[i].Cb, ov->palette[i].T, range,
+            matrix);
     }
     else
       overlay->palette.clear();
