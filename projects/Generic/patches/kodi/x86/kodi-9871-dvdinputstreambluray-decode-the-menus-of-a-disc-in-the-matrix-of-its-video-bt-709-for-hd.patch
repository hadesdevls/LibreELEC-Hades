   IVideoPlayer* m_player = nullptr;
   BLURAY* m_bd = nullptr;
@@ -391,6 +395,11 @@ protected:
   std::atomic<KODI::BLURAYGRAPHICS::Range> m_graphicsRange{KODI::BLURAYGRAPHICS::Range::SDR};
   //! Hades: (player thread) the range was set once since the disc was opened
   bool m_graphicsRangeSet = false;
+  //! Hades: the matrix of the palettes of the disc's graphics in SDR (BlurayGraphicsRange.h,
+  //! the one of the video they go over): set on the player thread, read by the overlay callbacks
+  std::atomic<KODI::BLURAYGRAPHICS::Matrix> m_graphicsMatrix{KODI::BLURAYGRAPHICS::Matrix::BT601};
+  //! Hades: (player thread) the matrix was set once since the disc was opened
+  bool m_graphicsMatrixSet = false;
   //! Hades: BD-J presentation timing is on for this disc (navigation mode)
   bool m_bdjTiming = false;
