From 5ad7471aedb364ccb0929b641161823d51f391b9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:54:29 +0000
Subject: [PATCH] windowing/gbm: the buffer that nvidia-drm takes a
 frame-packed frame from

nvidia-drm, with the patch of Hades that gives it HDMI frame packing,
lists a frame-packed mode like the other drivers and takes the frame as
they do, in one buffer of vdisplay + vtotal lines. Its display hardware
does the packing out of one surface for each eye, so the driver makes
those two surfaces out of the lines of that buffer, and refuses the
commit of a buffer with which it cannot:
- the lines have to lie one after another in memory, not in blocks, and
  the framebuffer has to say so: made with DRM_FORMAT_MOD_LINEAR. Kodi
  gives a surface the modifiers of the plane to choose from, and makes
  the framebuffer of a linear buffer without saying its layout (the
  modifier is 0);
- the second eye begins at line vtotal, pitch x vtotal bytes into the
  buffer, and NVKMS takes a surface only at a multiple of 1024 bytes.
  A buffer 1280 pixels wide has that at line 750; one 1920 wide does
  not have it at line 1125, one 2048 wide does.

So, only where the selected mode is frame packed and the driver is
nvidia-drm (CDRMUtils::FramePackedBufferDemands()):
- the surface of the window is made with DRM_FORMAT_MOD_LINEAR alone
  and as wide as that asks, 2048 for 1080p, in CreateNewWindow() and in
  CreateOutputSurface(). What is drawn, and the part of the buffer that
  the plane shows (SRC_W), stay as wide as the mode;
- the first buffer of that surface is asked whether it is such a one:
  one plane, linear, a pitch that puts the second eye where it can be,
  large enough (FramePackedBufferUsable()). A surface is also made when
  what was asked of it cannot be had. If it is not, the window is not
  made, one line at info level says what is wrong, and the window of
  the resolution without its 3D output is made instead (the commit
  before this one): from CreateNewWindow() the driver is never given
  such a buffer in a mode. CreateOutputSurface(), which makes the
  surface of another pixel format for a video, has no window to make
  in its place: it fails, as when the surface cannot be made at all;
- the framebuffer is made saying DRM_FORMAT_MOD_LINEAR.

In every other mode, and with every other driver, the surface has the
width and the modifiers it had and the framebuffer is made as it was:
each of the three places first asks whether the mode is frame packed,
and only then which driver it is.

What the driver refuses for another reason (a plane that is not the
primary one, a display that no longer advertises frame packing) is
found after the commit, as for any driver.

Not known: whether the EGL and GBM of NVIDIA give a surface with
DRM_FORMAT_MOD_LINEAR at all, and one that can be drawn to. Where they
do not, frame packing is refused here and the half layouts or the 2D
mode are used; nothing is copied.

Read and compiled (syntax check of DRMUtils.cpp, DRMAtomic.cpp and
WinSystemGbmEGLContext.cpp with the commands of the last build). The
width and the pitch have their host test (drmstereo_test.cpp). Not run
on a GPU.
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 36 +++++++-
 xbmc/windowing/gbm/drm/DRMUtils.cpp           | 82 +++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h             | 21 +++++
 3 files changed, 137 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index 35ce09c..2402dc0 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -209,7 +209,17 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
     }
   }
 
-  if (!m_GBM->GetDevice().CreateSurface(res.iWidth, res.iHeight, format, modifiers->data(),
+  // Hades: where the mode is frame packed and the driver makes the two eyes out of the lines
+  // of the one buffer (nvidia-drm), the buffer has to be one whose lines lie one after
+  // another, and wide enough that the second eye begins where the driver takes a surface
+  // (CDRMUtils::FramePackedBufferDemands()). What is drawn and shown stays the width of the
+  // window. In every other case the width is that of the window, and the modifiers the ones
+  // found above.
+  int surfaceWidth = res.iWidth;
+  if (m_DRM->FramePackedBufferDemands(format, surfaceWidth))
+    modifiers = &fallbackModifiers;
+
+  if (!m_GBM->GetDevice().CreateSurface(surfaceWidth, res.iHeight, format, modifiers->data(),
                                         modifiers->size()))
   {
     CLog::Log(LOGERROR, "CWinSystemGbmEGLContext::{} - failed to initialize GBM", __FUNCTION__);
@@ -244,6 +254,17 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
     return false;
   }
 
+  // Hades: ... and the buffer that was made has to be such a one: a surface is also made when
+  // what was asked of it cannot be had. Known here, before any mode is set with it.
+  if (std::string wrong; !m_DRM->FramePackedBufferUsable(bo, wrong))
+  {
+    CLog::Log(LOGINFO,
+              "CWinSystemGbmEGLContext::{} - the driver cannot be given a frame-packed frame "
+              "in this buffer: {}",
+              __FUNCTION__, wrong);
+    return false;
+  }
+
 #if defined(HAS_GBM_MODIFIERS)
   uint64_t modifier = gbm_bo_get_modifier(bo);
 #else
@@ -403,7 +424,12 @@ bool CWinSystemGbmEGLContext::CreateOutputSurface(uint32_t format, struct gbm_bo
     }
   }
 
-  if (!m_GBM->GetDevice().CreateSurface(m_nWidth, m_nHeight, format, modifiers->data(),
+  // Hades: as in CreateNewWindow(), for a frame-packed mode of nvidia-drm
+  int surfaceWidth = m_nWidth;
+  if (m_DRM->FramePackedBufferDemands(format, surfaceWidth))
+    modifiers = &fallbackModifiers;
+
+  if (!m_GBM->GetDevice().CreateSurface(surfaceWidth, m_nHeight, format, modifiers->data(),
                                         modifiers->size()))
   {
     CLog::LogF(LOGERROR, "failed to create GBM surface");
@@ -428,6 +454,12 @@ bool CWinSystemGbmEGLContext::CreateOutputSurface(uint32_t format, struct gbm_bo
   }
 
   bo = m_GBM->GetDevice().GetSurface().LockFrontBuffer().Get();
+  if (std::string wrong; !m_DRM->FramePackedBufferUsable(bo, wrong))
+  {
+    CLog::LogF(LOGINFO, "the driver cannot be given a frame-packed frame in this buffer: {}",
+               wrong);
+    return false;
+  }
   return true;
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index bb45c3e..0f1ebdc 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -370,6 +370,13 @@ drm_fb* CDRMUtils::DrmFbGetFromBo(struct gbm_bo* bo)
     flags |= DRM_MODE_FB_MODIFIERS;
     CLog::LogF(LOGDEBUG, "Using modifier: {}", DRMHELPERS::ModifierToString(modifiers[0]));
   }
+#if defined(HAS_GBM_MODIFIERS)
+  // Hades: DRM_FORMAT_MOD_LINEAR is 0, so the framebuffer of such a buffer is made without
+  // saying how its lines lie. nvidia-drm takes a frame-packed frame only from a framebuffer
+  // that says that they lie one after another (FramePackedBufferUsable() has asked the buffer).
+  else if (modifiers[0] == DRM_FORMAT_MOD_LINEAR && FramePackedByOffsets())
+    flags |= DRM_MODE_FB_MODIFIERS;
+#endif
 
   int ret = drmModeAddFB2WithModifiers(m_fd, width, height, fb->format, handles, strides, offsets,
                                        modifiers, &fb->fb_id, flags);
@@ -1422,6 +1429,81 @@ bool CDRMUtils::GetOutputModeFlags(uint32_t& flags) const
   return valid;
 }
 
+bool CDRMUtils::FramePackedByOffsets() const
+{
+  // (the mode first: no other mode asks the driver for its name)
+  return m_mode && STEREO::LayoutOf(m_mode->flags) == STEREO::Layout::FRAME_PACKING &&
+         DriverOf(m_fd) == "nvidia-drm";
+}
+
+bool CDRMUtils::FramePackedBufferDemands(uint32_t format, int& width) const
+{
+  if (!FramePackedByOffsets())
+    return false;
+
+  uint32_t bytesPerPixel = 0;
+  switch (format)
+  {
+    case DRM_FORMAT_ARGB8888:
+    case DRM_FORMAT_XRGB8888:
+    case DRM_FORMAT_ARGB2101010:
+    case DRM_FORMAT_XRGB2101010:
+    case DRM_FORMAT_ABGR2101010:
+    case DRM_FORMAT_XBGR2101010:
+      bytesPerPixel = 4;
+      break;
+    case DRM_FORMAT_ABGR16161616F:
+      bytesPerPixel = 8;
+      break;
+    default:
+      // not a format whose pitch is known here: the width of the mode, and the buffer that
+      // is made is asked (FramePackedBufferUsable())
+      break;
+  }
+
+  const int needed = STEREO::FramePackedBufferWidth(StereoModeOf(*m_mode), bytesPerPixel,
+                                                    STEREO::NVKMS_SURFACE_OFFSET_ALIGNMENT);
+  if (needed > width)
+    width = needed;
+  return true;
+}
+
+bool CDRMUtils::FramePackedBufferUsable(struct gbm_bo* bo, std::string& wrong) const
+{
+  if (!FramePackedByOffsets())
+    return true;
+
+  if (!bo)
+  {
+    wrong = "there is no buffer";
+    return false;
+  }
+
+#if defined(HAS_GBM_MODIFIERS)
+  const uint64_t modifier = gbm_bo_get_modifier(bo);
+  const uint32_t pitch = gbm_bo_get_stride_for_plane(bo, 0);
+  if (gbm_bo_get_plane_count(bo) != 1)
+    wrong = "it has more than one plane";
+  else if (modifier != DRM_FORMAT_MOD_LINEAR)
+    wrong = StringUtils::Format("its lines do not lie one after another (it was made with the "
+                                "modifier {}, not DRM_FORMAT_MOD_LINEAR)",
+                                DRMHELPERS::ModifierToString(modifier));
+  else if (!STEREO::SecondEyeAligned(pitch, StereoModeOf(*m_mode),
+                                     STEREO::NVKMS_SURFACE_OFFSET_ALIGNMENT))
+    wrong = StringUtils::Format("with its pitch of {} bytes the second eye begins at byte {}, "
+                                "which is no multiple of {}",
+                                pitch, static_cast<uint64_t>(pitch) * m_mode->vtotal,
+                                STEREO::NVKMS_SURFACE_OFFSET_ALIGNMENT);
+  else if (gbm_bo_get_width(bo) < m_mode->hdisplay || gbm_bo_get_height(bo) < ScanoutHeight())
+    wrong = StringUtils::Format("it is {}x{}, smaller than the frame of {}x{}",
+                                gbm_bo_get_width(bo), gbm_bo_get_height(bo), m_mode->hdisplay,
+                                ScanoutHeight());
+#else
+  wrong = "how its lines lie cannot be asked (GBM without modifiers)";
+#endif
+  return wrong.empty();
+}
+
 uint32_t CDRMUtils::ScanoutHeight() const
 {
   return static_cast<uint32_t>(STEREO::ScanoutHeight(StereoModeOf(*m_mode)));
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 7239c0b..806a92a 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -155,6 +155,24 @@ public:
   //! the last commit of a mode left there, whether the driver took that commit or not
   //! \return whether the output has a mode
   bool GetOutputModeFlags(uint32_t& flags) const;
+  /*!
+   * \brief What the driver asks of the buffer that is shown in the selected mode, where that
+   *        mode is frame packed and the driver is nvidia-drm
+   *
+   * nvidia-drm makes the two eyes of a frame-packed frame out of the lines of the one buffer
+   * (STEREO::NVKMS_SURFACE_OFFSET_ALIGNMENT in DRMStereo.h tells how), and refuses the commit
+   * of a buffer it cannot do that with. Nothing is asked in any other mode or by any other
+   * driver.
+   *
+   * \param format of the buffer
+   * \param[in,out] width the width of the mode; made the width to create the buffer with
+   * \return whether something is asked: the buffer is then also to be created with
+   *         DRM_FORMAT_MOD_LINEAR and nothing else
+   */
+  bool FramePackedBufferDemands(uint32_t format, int& width) const;
+  //! \brief Whether a buffer that was made meets it; true where nothing is asked
+  //! \param[out] wrong what does not, for the log
+  bool FramePackedBufferUsable(struct gbm_bo* bo, std::string& wrong) const;
 
   void SetInFenceFd(int fd) { m_inFenceFd = fd; }
   int TakeOutFenceFd()
@@ -202,6 +220,9 @@ protected:
   std::vector<std::unique_ptr<CDRMPlane>> m_planes;
 
 private:
+  //! The selected mode is frame packed, and the driver makes the eyes out of the lines of the
+  //! one buffer (see FramePackedBufferDemands())
+  bool FramePackedByOffsets() const;
   bool FindConnector();
   bool FindEncoder();
   bool FindCrtc();
-- 
2.53.0

