From bd9e32cff459ecec907db432ecb141d98da92a49 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:03:51 +0000
Subject: [PATCH] windowing/gbm: on nvidia-drm, Dolby Vision presented a frame
 ahead only where measured misses call for it

With egl-gbm's FIFO of three (nvidia_egl-gbm-9001) a window on nvidia-drm has
a third buffer, and CDVAhead would choose frames ahead wherever the frames take
half of the refresh period on average. An RTX 4080 SUPER at 50 or 60 Hz takes
7 to 18 ms of the 16.7 of a refresh for a frame with its enhancement layer, so
it would go the way that has never run on nvidia-drm (commits that do not wait,
out-fences, the buffer kept on the screen), where Dolby Vision at 60 Hz works
today the way that waits (1.0 RC2: 601 frames in 10 s). Found by an
independent review of 1.0 RC6.

On nvidia-drm, with "when needed", only measured misses call for frames ahead:
frames presented the way that waits that miss their refreshes again and again
(CDVAhead::PresentedWaiting(): 3 of 240 in two of the last three runs), never
their GPU time (CDVAhead::SetMissesOnly()). A GT 1030 (46 to 49 ms of 41.7)
still gets them; the 4080 keeps the way it was tried on. <dvaheadalways> still
asks for them anywhere. kodi.log says the rule once, when native output starts
there.
---
 xbmc/windowing/gbm/DVAhead.h                  | 19 +++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 13 +++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  1 +
 3 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
index 2de1c10..6cd4203 100644
--- a/xbmc/windowing/gbm/DVAhead.h
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -115,7 +115,7 @@ public:
     // end the other)
     const bool byTime = m_needed && SamePeriod(periodMs, m_neededPeriod);
     const bool byMisses = MissesCallForIt(periodMs);
-    if (!byTime && !byMisses && m_average >= (aside ? 1.0 : HEAVY) * periodMs)
+    if (!m_missesOnly && !byTime && !byMisses && m_average >= (aside ? 1.0 : HEAVY) * periodMs)
     {
       m_needed = true;
       m_neededPeriod = periodMs;
@@ -132,6 +132,19 @@ public:
   //! The average that Measured() last decided with
   double Average() const { return m_average; }
 
+  /*!
+   * \brief Hades: only measured misses call for frames ahead (PresentedWaiting()), never the GPU
+   *        time of the frames (Measured()), where frames ahead have not been tried on the driver:
+   *        on nvidia-drm, its commits that do not wait, its out-fences and the buffer kept on the
+   *        screen have never run in Hades' tests. An RTX 4080 SUPER at 50 or 60 Hz takes 7 to 18 ms
+   *        of the 16.7 of a refresh for a frame with its enhancement layer, which the half of the
+   *        period takes for frames ahead, while Dolby Vision at 60 Hz works there the way that
+   *        waits (1.0 RC2: 601 frames in 10 s). A GPU whose frames miss their refreshes again and
+   *        again (a GT 1030: 46 to 49 ms of 41.7) still gets them. ALWAYS still asks for them.
+   */
+  void SetMissesOnly(bool missesOnly) { m_missesOnly = missesOnly; }
+  bool MissesOnly() const { return m_missesOnly; }
+
   /*!
    * \brief Hades: a frame presented the way that waits, of the video playing, without GUI elements
    *        and with nothing but the picture in its commit, and whether it came later than one and a
@@ -222,7 +235,8 @@ public:
   //! one video to the next: the first frames of the next one then have it too.
   bool Needed(double periodMs) const
   {
-    return (m_needed && SamePeriod(periodMs, m_neededPeriod)) || MissesCallForIt(periodMs);
+    return (!m_missesOnly && m_needed && SamePeriod(periodMs, m_neededPeriod)) ||
+           MissesCallForIt(periodMs);
   }
 
   //! Hades: ... because frames presented the way that waits missed their refreshes
@@ -335,6 +349,7 @@ private:
   double m_sum = 0.0;
   double m_windowPeriod = 0.0;
   double m_average = 0.0;
+  bool m_missesOnly = false; //!< Hades: SetMissesOnly()
   bool m_needed = false;
   double m_neededPeriod = 0.0;
   unsigned int m_failures = 0;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b51e26d..476cdfd 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7218,6 +7218,19 @@ bool CWinSystemGbmGLESContext::DVAheadWanted()
     m_dvAheadMode = m_dvEngine.ahead == CDVEngineSettings::Ahead::NEVER    ? CDVAhead::Mode::NEVER
                     : m_dvEngine.ahead == CDVEngineSettings::Ahead::ALWAYS ? CDVAhead::Mode::ALWAYS
                                                                            : CDVAhead::Mode::NEEDED;
+    // Hades: on nvidia-drm, frames ahead only where frames presented the way that waits miss their
+    // refreshes again and again, measured, and not because of their GPU time
+    // (CDVAhead::SetMissesOnly()): the way that waits is the one tried on NVIDIA
+    const bool missesOnly =
+        m_dvAheadMode == CDVAhead::Mode::NEEDED && DriverName() == "nvidia-drm";
+    m_dvAhead.SetMissesOnly(missesOnly);
+    if (missesOnly && !std::exchange(m_dvAheadMissesTold, true))
+      CLog::Log(LOGINFO,
+                "DVBridge: on nvidia-drm, Dolby Vision is presented a frame ahead only where "
+                "frames presented the way that waits miss their refreshes again and again (as "
+                "measured), not because of the time that the GPU takes for them: the way that "
+                "waits is the one tried on NVIDIA (advancedsettings.xml: dvaheadalways asks for "
+                "frames ahead always)");
   }
   return m_dvAhead.Wanted(m_dvAheadMode, DVRefreshPeriodMs());
 #else
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index cb95077..51b7b62 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -875,6 +875,7 @@ private:
   //! the settings (m_dvEngine), taken for this native output with its first frame presented ...
   CDVAhead::Mode m_dvAheadMode = CDVAhead::Mode::NEEDED;
   bool m_dvAheadModeRead = false; //!< ... in a transport mode (DVAheadWanted())
+  bool m_dvAheadMissesTold = false; //!< ... nvidia-drm's rule told in the log (DVAheadWanted())
   //! The commit of the last frame did not wait for its flip, which is not known to have come
   bool m_dvAheadPending = false;
   bool m_dvAheadLost = false; //!< ... and did not come when it was waited for (told once)
-- 
2.53.0

