From 00b359387c81f0f11a9d299f790e539b30739a28 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:26:28 +0000
Subject: [PATCH] windowing/gbm: another display on the output in use is known
 at once, not from the next video

When the display on the output that Kodi uses was replaced while Kodi ran
(another monitor in the same socket, a switch between two displays, a TV
whose input setting changes its EDID), the look that follows the hot-plug
event (RefreshModes()) took the new display's modes, but what Kodi knows of
the display itself stayed that of the display before until the next video
started (CheckDisplayChange()): the HDR that the settings and add-ons are
told of (IsHDRDisplay(), GetDisplayHDRCapabilities()), Dolby Vision (the
setting of Dolby Vision for the menus, the rank of the output for the
display watch), 3D, and the notice of a TV input in its HDMI 1.4 mode. Who
the display is for the audio engine (UTILS::CDrivenDisplay: the output
that the sound follows while the user has chosen none) was not told on the
same output at all, not even when a video started.

Now that look, which probes the display anyway, takes another EDID that
can be read the way the start of a video takes it (AdoptDisplayEdid(),
which both use now, under the same lock), and tells the audio engine who
the display is. What failed on the display before counts no more, as after
a video that found another display (ForgetDisplayFailures(): native Dolby
Vision and HDR over the tunnel are tried again; the half-float output, as
after a move to another output). The EDID that is known, no EDID, and one
that cannot be read (a TV that wakes up) change nothing, as before; the
look of the next video then finds the display known and does nothing more.
The start of a video that finds another EDID tells the audio engine too.

Nothing changes while the display stays the same: the bytes of the EDID
are compared first, and a TV that is turned off and on has the same ones.

kodi.log, at info level:
  "Display: after a hot-plug event the display on HDMI-A-1 is another one
   (<name in its EDID>): what Kodi knows of it (HDR, Dolby Vision, 3D, its
   sound) is of this one from now on"
  "DVBridge: the display's EDID changed (probed after a hot-plug event),
   and what it takes: Dolby Vision Standard yes -> no, HDR10 yes -> no,
   HLG yes -> no"
The line of the start of a video is the same as before ("... (probed when
this video started) ...").
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 116 ++++++++++++++++++++++------
 xbmc/windowing/gbm/WinSystemGbm.h   |  28 ++++++-
 2 files changed, 121 insertions(+), 23 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index c363b46..9d52403 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1946,20 +1946,9 @@ bool CWinSystemGbm::DVNewVideo()
   }
   if (!changed)
     return another;
-  // Hades: and a tunnel for HDR that failed on the display before is tried again with the new one
-  if (m_hdr10TunnelDisabled.exchange(false))
-    CLog::Log(LOGINFO, "DVBridge: HDR over the tunnel is tried again, after the display changed");
-  std::unique_lock lock(m_dvRetryLock);
-  m_dvRetryBackoff = 0;
-  m_dvRetryWait = 0;
-  if (!m_dvDisabled.exchange(false))
-    return true;
-  if (m_dvEdidUnread)
-    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is allowed again after the display "
-                       "changed, from the next video whose EDID can be read");
-  else
-    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is tried again with this video, "
-                       "after the display changed");
+  // Hades: and a tunnel for HDR that failed on the display before is tried again with the new one,
+  // as native output is
+  ForgetDisplayFailures("this video");
   return true;
 }
 
@@ -2035,7 +2024,6 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   // Vision used not to be looked at again: one that had none when Kodi started (the TV was off or
   // on another setting) stayed without it, and with the HDR of that EDID, until Kodi started again.
   const auto info = DVDisplayInfo();
-  const auto hdrInfo = DisplayInfo();
   const unsigned int hotplugs = m_displayWatch ? m_displayWatch->Hotplugs() : 0;
   const bool hotplug = hotplugs != m_lookHotplugs;
   m_lookHotplugs = hotplugs;
@@ -2118,8 +2106,23 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
     m_dvEdidUnread = false;
   if (!outcome.adopt)
     return back;
-  m_displayEdid = edid;
   another = true;
+  const bool dvChanged = AdoptDisplayEdid(
+      edid, changed,
+      std::string(how == CDisplayLook::Read::PROBE ? "probed" : "read from the kernel") +
+          " when this video started");
+  return back || dvChanged;
+}
+
+bool CWinSystemGbm::AdoptDisplayEdid(const std::vector<uint8_t>& edid,
+                                     const std::shared_ptr<const UTILS::CDisplayInfo>& changed,
+                                     const std::string& when)
+{
+  CDRMConnector* const connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  // What was known of the display, against which the log tells what it takes now
+  const auto info = DVDisplayInfo();
+  const auto hdrInfo = DisplayInfo();
+  m_displayEdid = edid;
   {
     // Hades: of the decisions of HDR too: both are of the display that is there now
     std::unique_lock lock(m_infoLock);
@@ -2130,6 +2133,15 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   if (SetStereoEdid(edid))
     CLog::Log(LOGINFO, "3D output: the display now {} that it takes stereoscopic 3D",
               m_stereoDisplay ? "says" : "does not say");
+  // Hades: ... and who it is, for the audio engine (as InitWindowSystem() says it): the audio output
+  // of this display is the one used while the user has chosen none, the next time the engine
+  // chooses (ActiveAE::INTERNAL::OutputOfTheDisplay())
+  {
+    UTILS::DisplayIdentity driven = UTILS::IdentityOfEdid(edid);
+    driven.model = EdidDisplayName(edid);
+    driven.output = connector ? connector->GetName() : std::string();
+    UTILS::CDrivenDisplay::Set(driven);
+  }
   // Only a change of what native output depends on counts (not, for example, the audio formats of
   // a sound bar behind the TV); it also allows the Low-Latency notification again.
   const bool hdmi14bOn = DVHdmi14bOn();
@@ -2148,22 +2160,75 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   const bool hdrChanged = hdr10(hdrInfo.get()) != hdr10(changed.get()) ||
                           hlg(hdrInfo.get()) != hlg(changed.get());
   CLog::Log(LOGINFO,
-            "DVBridge: the display's EDID changed ({} when this video started){}: Dolby Vision "
-            "Standard {} -> {}, HDR10 {} -> {}, HLG {} -> {}",
-            how == CDisplayLook::Read::PROBE ? "probed" : "read from the kernel",
-            dvChanged || hdrChanged ? ", and what it takes" : "",
+            "DVBridge: the display's EDID changed ({}){}: Dolby Vision Standard {} -> {}, HDR10 {} "
+            "-> {}, HLG {} -> {}",
+            when, dvChanged || hdrChanged ? ", and what it takes" : "",
             yes(info && info->SupportsStandardDolbyVision()),
             yes(changed->SupportsStandardDolbyVision()), yes(hdr10(hdrInfo.get())),
             yes(hdr10(changed.get())), yes(hlg(hdrInfo.get())), yes(hlg(changed.get())));
   // ... and the following of displays ranks the output in use by what it has now
-  if (m_displayWatch)
+  if (m_displayWatch && connector)
     m_displayWatch->SetInUseDolbyVision(connector->GetType() == "HDMI-A" &&
                                         changed->SupportsStandardDolbyVision());
   // told again only when the display enters that state (not for another change of its EDID, such
   // as the audio formats of a sound bar that wakes up)
   if (changed->UhdLimitedToHdmi14() && !(info && info->UhdLimitedToHdmi14()))
     m_limitedInputPending = true;
-  return back || dvChanged;
+  return dvChanged;
+}
+
+void CWinSystemGbm::AdoptDisplayAfterHotplug(const std::vector<uint8_t>& edid)
+{
+  bool back = false;
+  bool dvChanged = false;
+  {
+    std::unique_lock lookLock(m_displayLookLock);
+    // (the bytes are compared: the kernel can give a new EDID the id of an earlier one. The display
+    // that is known, connected again, is left to the look of the next video, as before.)
+    if (edid.empty() || edid == m_displayEdid)
+      return;
+    const std::shared_ptr<const UTILS::CDisplayInfo> changed = UTILS::CDisplayInfo::Create(edid);
+    // One that cannot be read replaces nothing, as when a video starts (CDisplayLook::Of())
+    if (!changed)
+    {
+      CLog::Log(LOGINFO, "Display: after a hot-plug event the display has an EDID that cannot be "
+                         "read: what is known of the display stays until it can be read");
+      return;
+    }
+    back = m_displayGone.exchange(false);
+    m_dvEdidUnread = false;
+    CLog::Log(LOGINFO,
+              "Display: after a hot-plug event the display on {} is another one ({}): what Kodi "
+              "knows of it (HDR, Dolby Vision, 3D, its sound) is of this one from now on",
+              m_DRM && m_DRM->GetConnector() ? m_DRM->GetConnector()->GetName() : "the output",
+              EdidDisplayName(edid).empty() ? std::string("no name in its EDID")
+                                            : EdidDisplayName(edid));
+    dvChanged = AdoptDisplayEdid(edid, changed, "probed after a hot-plug event");
+  }
+  // As DVNewVideo() does after a look that found another display, and as a move to another output
+  // does (OnOutputMoved()): what failed on the display before counts no more
+  if (back || dvChanged)
+    ForgetDisplayFailures("the next video");
+  OnOutputMoved();
+}
+
+void CWinSystemGbm::ForgetDisplayFailures(const char* video)
+{
+  if (m_hdr10TunnelDisabled.exchange(false))
+    CLog::Log(LOGINFO, "DVBridge: HDR over the tunnel is tried again, after the display changed");
+  std::unique_lock lock(m_dvRetryLock);
+  m_dvRetryBackoff = 0;
+  m_dvRetryWait = 0;
+  if (!m_dvDisabled.exchange(false))
+    return;
+  if (m_dvEdidUnread)
+    CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output is allowed again after the display "
+                       "changed, from the next video whose EDID can be read");
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: native Dolby Vision output is tried again with {}, after the display "
+              "changed",
+              video);
 }
 
 const char* CWinSystemGbm::DVEndOfStreamUnfit() const
@@ -2954,6 +3019,13 @@ void CWinSystemGbm::RefreshModes()
       EdidOfProbed(drm->GetFileDescriptor(), *probed, connector->GetPropertyId("EDID"));
   const std::vector<drmModeModeInfo> now(probed->modes, probed->modes + probed->count_modes);
   const bool connected = probed->connection == DRM_MODE_CONNECTED;
+#ifdef HAVE_DVBRIDGE
+  // Hades: another display on this output (another monitor in the same socket, a TV whose EDID
+  // changed): what Kodi knows of it is of that one from now on, not only from the next video; its
+  // modes follow below
+  if (connected)
+    AdoptDisplayAfterHotplug(edid);
+#endif
   const std::vector<drmModeModeInfo> before = drm->GetConnectorModes();
   // (the bytes are compared: the kernel can give a new EDID the id of an earlier one)
   const bool sameEdid = !edid.empty() && edid == m_modesEdid;
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 21530b8..88e771a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -543,8 +543,34 @@ protected:
   //!             in it
   bool CheckDisplayChange(bool& another);
   //! Hades: held around CheckDisplayChange(): by DVNewVideo() (VideoPlayer) and by the menus' own look
-  //! (DVMenusLookAtDisplay(), render thread)
+  //! (DVMenusLookAtDisplay(), render thread); and by the look after a hot-plug event
+  //! (AdoptDisplayAfterHotplug())
   std::mutex m_displayLookLock;
+  /*!
+   * \brief Hades: what Kodi knows of the display becomes what this EDID says, which can be read
+   *        (\p changed): the display information of the decisions of Dolby Vision and of HDR, its
+   *        3D, the rank of the output for the display watch, who the display is for the audio
+   *        engine (UTILS::CDrivenDisplay), and the notice of an HDMI 1.4 input. The log says what
+   *        the display takes now against what was known of it. Under m_displayLookLock.
+   * \param when how and when it was read, for the log
+   * \return whether what native output depends on changed
+   */
+  bool AdoptDisplayEdid(const std::vector<uint8_t>& edid,
+                        const std::shared_ptr<const UTILS::CDisplayInfo>& changed,
+                        const std::string& when);
+  /*!
+   * \brief Hades: after a hot-plug event of the device in use, another display on the output in
+   *        use (another monitor in the same socket, or a TV whose EDID changed): what Kodi knows of
+   *        it is of that display from now on (AdoptDisplayEdid()), as the next video would find it
+   *        (CheckDisplayChange()), not only from then; and what failed on the display before
+   *        counts no more, as then. From RefreshModes(), which probed it. Nothing for the EDID
+   *        known, or one that cannot be read (a TV that wakes up).
+   */
+  void AdoptDisplayAfterHotplug(const std::vector<uint8_t>& edid);
+  //! Hades: what failed on the display before counts no more (DVNewVideo(), after another display
+  //! was found): HDR over the tunnel, and native Dolby Vision, are tried again
+  //! \param video the video they are tried with, for the log ("this video", "the next video")
+  void ForgetDisplayFailures(const char* video);
   //! Hades: Dolby Vision for the menus (CWinSystemGbmGLESContext, CDVMenus): ended before the output
   //! changes under them (the display put to sleep, the system woke), on the render thread
   virtual void DVMenusStop(const char* why) {}
-- 
