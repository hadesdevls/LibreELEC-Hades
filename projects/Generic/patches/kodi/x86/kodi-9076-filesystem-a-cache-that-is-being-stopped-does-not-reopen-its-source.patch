From 6720b996b97fa12c3a42e65c5ae39fbdd4a3c316 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:22:01 +0000
Subject: [PATCH] filesystem: a cache that is being stopped does not reopen its
 source

When the source of a file cache stops before the end of the file, the
cache thread waits (half a second, then one, two and four) and reopens
it. StopThread() interrupts that wait by setting the seek event, but
the thread also looks at that event, without waiting, at the top of its
loop: when it takes it there, between the test of the stop flag and
the read that returns no data, the wait runs to its end and the source
is reopened over the network before the thread ends, and whoever
closes the file waits for that.

The stop flag is looked at before the pause and before the reopening.
---
 xbmc/filesystem/FileCache.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index 72e1d39..dc19920 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -446,6 +446,10 @@ void CFileCache::Process()
         // CCurlFile then reports a successful seek followed by no data, and reporting EOF here
         // would end playback. Reopen the source at the write position after a short pause that
         // grows with each attempt; a seek request or StopThread() interrupts the pause.
+        // (StopThread() sets the seek event, and the wait for a seek at the top of this loop can
+        // take it: a cache that is being stopped neither pauses nor reopens.)
+        if (m_bStop)
+          break; // while (!m_bStop)
         const auto pause = FIRST_REOPEN_PAUSE * (1 << m_sourceReopens);
         m_sourceReopens++;
         CLog::Log(LOGWARNING,
@@ -459,6 +463,8 @@ void CFileCache::Process()
             m_seekEvent.Set(); // hack so that later we realize seek is needed
           continue; // while (!m_bStop)
         }
+        if (m_bStop)
+          break; // while (!m_bStop)
         const int64_t reopened = m_source->Seek(m_writePos, SEEK_SET);
         if (reopened != m_writePos)
           CLog::Log(LOGWARNING, "CFileCache::{} - <{}> reopening at {} returned {}", __FUNCTION__,
