 #: system/settings/settings.xml
 #. Setting label: HDR10+ sent as Dolby Vision (core #40922)
diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 81a81ec..b8738d9 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3704,6 +3704,9 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the trims of the metadata are sent to a display on native output and are applied by the player where it
+           maps Dolby Vision to the display itself (HDR10 adapted to it, SDR, Low-Latency): available whichever of them
+           runs, so with no dependency on the native output -->
       <setting id="videoscreen.hadesdvnotrims" type="boolean" label="40920" help="40921">
         <requirement>
           <and>
@@ -3711,10 +3714,6 @@
             <condition>HAS_GLES</condition>
           </and>
         </requirement>
-        <dependencies>
-          <dependency type="visible" on="property" name="supportsdv"/>
-          <dependency type="enable" setting="videoscreen.hadesdvnative">true</dependency>
-        </dependencies>
         <level>3</level>
         <default>false</default>
         <control type="toggle" />
