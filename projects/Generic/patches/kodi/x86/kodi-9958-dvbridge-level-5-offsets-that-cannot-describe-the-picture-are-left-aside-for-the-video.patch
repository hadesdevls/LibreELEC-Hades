From 3e73f404c0000e6b13d2b120b4adefff72727d12 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:18:30 +0000
Subject: [PATCH] dvbridge: level 5 offsets that cannot describe the picture
 are left aside for the video

What a level 5 block that describes bars a picture does not have does
in native output: the transport is black outside the active area
(dvbridge_source.h), the converted transport is masked there
(mask_active_area()), and the display is told that those rows are bars;
the rows of the picture there are lost. (The conversion to HDR10 does
not blank by the level 5 block; HDR10+ sent as Dolby Vision samples
inside it, dvbridge_dvplus_area().) An encode cropped on one axis that
kept the RPU of its master was already read right: dvbridge_dv_margins()
reads the offsets also as those of a 3840x2160 master and takes the
smaller margin on each side.

Offsets that fit no reading of the picture (more bars than it has, as
offsets of the picture and as those of a master) refused the frame, and
after the refusals the video left native output. They are now left
aside for the rest of the video (dvbridge_dv_l5()): its frames go out
with the active area of the place of the picture, as frames without a
level 5 block do (dvbridge_dv_made_area()), nothing of the picture is
blanked, and the decision is said once in kodi.log. It is of the video
(cm40_video, as the decision of the content mapping v4.0 is) and kept
through dvbridge_dv_restart(): the area does not come and go with the
scenes, and the next video reads its own offsets. Offsets that fit are
never changed.

For the other wrong level 5 (a picture with content where the offsets
say bars: an "open matte" encode with the RPU of the letterboxed one, a
picture cropped on both axes from its master) the decision can be made
from a measurement of the picture: dvbridge_dv_picture_bars() gives the
bars that the offsets make inside the picture, dvbridge_dv_l5_contradicted()
says whether measured content (dvbridge_measured_reduce()) fills more
than half of a bar of 8 samples or more (a dirty edge or a dark scene
does not; the picture of an open matte encode and subtitles burnt into a
bar do), and dvbridge_dv_ignore_l5() leaves the offsets aside for the
video. Nothing measures the pictures of a Dolby Vision stream yet: the
measurement of the bridge runs for HDR10 measured as Dolby Vision only.
That part is not wired, and says nothing.

Tested on the host (l5_test.c of the front): offsets that fit give the
margins they gave (4K with bars, a crop read as its master's, 1080p, a
pillarbox), offsets that fit no reading are left aside for their video
and only for it, also after a restart; built against the header of
1.0 RC6, the same test fails on those three cases and passes the
others. The render test of the battery through dvbridge_dv_metadata(),
with offsets of 1100 + 1100 rows added: refused with the bridge of
1.0 RC6, drawn with this one; without them, the same bytes as before.

kodi.log: "DVBridge: the level 5 offsets of this video (l r t b) cannot
describe its picture: <why>. They are left aside for the rest of the
video ...", once a stream.
---
 tools/dvbridge/dvbridge_core.c                |   1 +
 tools/dvbridge/dvbridge_core.h                |   3 +
 tools/dvbridge/dvbridge_metadata.h            | 102 +++++++++++++++++-
 tools/dvbridge/dvbridge_render.c              |   4 +
 tools/dvbridge/dvbridge_render.h              |   2 +
 .../VideoRenderers/DVBridgeGLES.cpp           |   8 ++
 6 files changed, 117 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 478edac..012fabf 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -246,6 +246,7 @@ bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
     memcpy(reading->l5, r->l5, sizeof(reading->l5));
     memcpy(reading->as_given, r->as_given, sizeof(reading->as_given));
     memcpy(reading->margins, candidate->state.margins, sizeof(reading->margins));
+    reading->l5_ignored = r->l5_ignored;
     reading->skipped = r->skipped;
     reading->skipped_level = r->skipped_level;
     reading->cm40_left_out = r->cm40_left_out;
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 2b287c9..2acd09d 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -173,6 +173,9 @@ struct dvbridge_reading {
     unsigned l5[4];       /* left, right, top, bottom offsets of the level 5 block (0: none) */
     unsigned as_given[4]; /* ... as offsets of the picture, in the raster; 0 when they do not fit */
     unsigned margins[4];  /* the margins taken */
+    /* Hades: the level 5 offsets were left aside for the video, and why (dvbridge_dv_l5() in dvbridge_metadata.h);
+     * NULL when they were not */
+    const char *l5_ignored;
     /* Extension blocks of reserved levels, left out (a display ignores them): how many, and the
      * level of the first one */
     unsigned skipped, skipped_level;
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 5622738..4cfc7ae 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -35,6 +35,8 @@ struct dvbridge_dv_reading {
     bool l5_master;
     unsigned l5[4];       /* the offsets of the level 5 block: left, right, top, bottom */
     unsigned as_given[4]; /* the margins they make as offsets of the picture; 0 when they do not fit it */
+    /* Hades: the level 5 offsets were left aside for the video, and why (dvbridge_dv_l5()); NULL when not */
+    const char *l5_ignored;
     /* Extension blocks of a level that CCM 001 reserves, which a display ignores: left out. */
     unsigned skipped, skipped_level;
     /* Hades: blocks of the content mapping v4.0 part of the metadata (levels 3, 8 to 11 and 254),
@@ -149,6 +151,12 @@ struct dvbridge_dv {
      * Vision for the menus), which make no decision and take back none. */
     unsigned cm40_video;
     bool cm40_menus;
+    /* Hades: the level 5 offsets of the video l5_ignored_video (cm40_video when it was decided) are left aside, and
+     * why (a fixed text): they cannot describe its pictures (dvbridge_dv_l5()). Kept through dvbridge_dv_restart(),
+     * as the decision of the content mapping v4.0 is: it is of the video. */
+    bool l5_ignored;
+    unsigned l5_ignored_video;
+    const char *l5_ignored_why;
 };
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
@@ -282,6 +290,7 @@ static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned
  * the offsets fit only the second reading (more bars than the picture has rows), that one is
  * taken; when they fit neither, the frame is refused as before. Not covered: a picture cropped on
  * both axes from the master; the first reading then holds as before. */
+#define DVBRIDGE_DV_L5_NO_PICTURE "the level 5 offsets leave no picture"
 static inline bool dvbridge_dv_margins(struct dvbridge_dv *d, unsigned l, unsigned r,
                                        unsigned t, unsigned b, unsigned v[4])
 {
@@ -295,7 +304,7 @@ static inline bool dvbridge_dv_margins(struct dvbridge_dv *d, unsigned l, unsign
     memcpy(d->reading.l5, offsets, sizeof(offsets));
     memcpy(d->reading.as_given, given, sizeof(given));
     d->reading.l5_master = false;
-    const char *none = "the level 5 offsets leave no picture";
+    const char *none = DVBRIDGE_DV_L5_NO_PICTURE;
     if (w == 3840 && h == 2160) {
         DV_REFUSE(fits, none);
         memcpy(v, given, sizeof(given));
@@ -331,6 +340,85 @@ static inline bool dvbridge_dv_margins(struct dvbridge_dv *d, unsigned l, unsign
     }
     return true;
 }
+/* Hades: the level 5 offsets of the video that a frame is of (cm40_video) are left aside */
+static inline bool dvbridge_dv_l5_ignored(const struct dvbridge_dv *d)
+{
+    return d->l5_ignored && d->l5_ignored_video == d->cm40_video;
+}
+/* Hades: the level 5 offsets of the video of now are left aside from the next frame on, for the rest of it; why: a
+ * fixed text, for the log. Where a level 5 block describes bars that the picture does not have (the RPU of another
+ * framing of the film: an encode cropped on both axes or re-framed from its master, a picture "open matte" with the
+ * RPU of the letterboxed one), every way of native output loses those rows of the picture: the transport is black
+ * outside the active area (dvbridge_source.h), the converted transport is masked there (mask_active_area()), and the
+ * display is told that they are bars. Once a video, so that the area does not come and go with its scenes. */
+static inline void dvbridge_dv_ignore_l5(struct dvbridge_dv *d, const char *why)
+{
+    if (dvbridge_dv_l5_ignored(d))
+        return;
+    d->l5_ignored = true;
+    d->l5_ignored_video = d->cm40_video;
+    d->l5_ignored_why = why;
+}
+/* Hades: the blanking margins of a frame and the level 5 values sent from its level 5 offsets, as
+ * dvbridge_dv_margins() reads them; or, where they are left aside for its video, from the place of its picture, as for
+ * metadata without a level 5 block (dvbridge_dv_made_area()): nothing inside the place is blanked, and the display is
+ * told that the active area is the picture. Offsets that fit no reading (more bars than the picture has, as offsets of
+ * the picture and as those of a 3840x2160 master) cannot describe the picture: they are left aside from this frame
+ * on. Before, such a frame was refused, and the video left native output. Offsets that fit are never changed here. */
+static inline bool dvbridge_dv_l5(struct dvbridge_dv *d, unsigned l, unsigned r, unsigned t, unsigned b,
+                                  unsigned v[4])
+{
+    d->reading.l5_ignored = NULL;
+    if (!dvbridge_dv_l5_ignored(d)) {
+        if (dvbridge_dv_margins(d, l, r, t, b, v))
+            return true;
+        /* (any other refusal stands) */
+        if (!d->refused || strcmp(d->refused, DVBRIDGE_DV_L5_NO_PICTURE))
+            return false;
+        dvbridge_dv_ignore_l5(d, "they fit no reading of the picture: more bars than it has, as offsets of the "
+                                 "picture and as those of a 3840x2160 master");
+    }
+    if (!dvbridge_dv_margins(d, 0, 0, 0, 0, v))
+        return false; /* (d->refused says why) */
+    const unsigned offsets[4] = {l, r, t, b};
+    memcpy(d->reading.l5, offsets, sizeof(offsets));
+    d->reading.l5_master = false;
+    d->reading.l5_ignored = d->l5_ignored_why;
+    d->refused = NULL;
+    return true;
+}
+/* Hades: the bars inside the picture that the blanking margins of the last frame made (left, right, top, bottom, in
+ * samples of the picture: the margins less the place's own, at the picture's scale); false where the picture is drawn
+ * through a view (zoom, a shift, stretching), whose bars are not those of the picture. */
+static inline bool dvbridge_dv_picture_bars(const struct dvbridge_dv *d, unsigned bars[4])
+{
+    if (d->has_view || !d->dest_w || !d->dest_h || !d->source_w || !d->source_h)
+        return false;
+    const long in[4] = {(long)d->margins[0] - d->dest_x, (long)d->margins[1] - (3840 - d->dest_x - d->dest_w),
+                        (long)d->margins[2] - d->dest_y, (long)d->margins[3] - (2160 - d->dest_y - d->dest_h)};
+    for (int i = 0; i < 4; i++)
+        bars[i] = in[i] <= 0 ? 0u
+                             : (unsigned)lround((double)in[i] * (i < 2 ? d->source_w : d->source_h) /
+                                                (i < 2 ? d->dest_w : d->dest_h));
+    return true;
+}
+/* Hades: whether what was measured of a picture says that its level 5 offsets cannot be right: content (blocks above
+ * the black level: dvbridge_measured_reduce(), whose active rows and columns are of 2x2 blocks: here in samples) in
+ * more than half of a bar of 8 samples or more. bars: as dvbridge_dv_picture_bars() gives them; active: the measured
+ * rows [0], [1) and columns [2], [3) of the w x h picture that hold content. A picture without content, a dark one, or
+ * a dirty edge of a few rows at the edge of a bar is no contradiction; the picture of an "open matte" encode is, and
+ * so are the lines of subtitles burnt into a bar (which the active area would blank). */
+static inline bool dvbridge_dv_l5_contradicted(const unsigned bars[4], const int active[4], int w, int h)
+{
+    if (!bars || !active || w <= 0 || h <= 0 || active[0] >= active[1] || active[2] >= active[3])
+        return false;
+    const long into[4] = {(long)bars[0] - active[2], active[3] - ((long)w - bars[1]), (long)bars[2] - active[0],
+                          active[1] - ((long)h - bars[3])};
+    for (int i = 0; i < 4; i++)
+        if (bars[i] >= 8 && 2 * into[i] > (long)bars[i])
+            return true;
+    return false;
+}
 /* Whether the enhancement layer of a stream that does not set disable_residual_flag adds nothing to
  * the picture (a MEL, as a profile 7 stream may carry), by libplacebo's criterion: the non-linear
  * inverse quantization (CCM 001 clause 5) of each of the three components is the linear dead zone
@@ -392,7 +480,14 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     const bool cm40_auto_decided = d->cm40_auto_decided, cm40_auto_on = d->cm40_auto_on,
                cm40_auto_revoked = d->cm40_auto_revoked, cm40_menus = d->cm40_menus;
     const unsigned cm40_auto_source = d->cm40_auto_source, cm40_video = d->cm40_video;
+    /* (Hades: and the level 5 offsets left aside for a video: dvbridge_dv_l5()) */
+    const bool l5_ignored = d->l5_ignored;
+    const unsigned l5_ignored_video = d->l5_ignored_video;
+    const char *l5_ignored_why = d->l5_ignored_why;
     memset(d, 0, sizeof(*d));
+    d->l5_ignored = l5_ignored;
+    d->l5_ignored_video = l5_ignored_video;
+    d->l5_ignored_why = l5_ignored_why;
     d->cm40_auto_decided = cm40_auto_decided;
     d->cm40_auto_on = cm40_auto_on;
     d->cm40_auto_revoked = cm40_auto_revoked;
@@ -544,6 +639,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             taken |= 1u << j;
     }
     d->reading.skipped = d->reading.skipped_level = 0;
+    d->reading.l5_ignored = NULL;
     d->reading.cm40_left_out = d->reading.cm40_dropped = d->reading.cm40_added = 0;
     /* 6.2.1 table 3: dm_metadata() */
     d->size = 0;
@@ -685,8 +781,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             DV_REFUSE(area == 1, "two level 5 blocks");
             DV_REFUSE(l1 == 1,
                       l1 ? "two level 1 blocks" : "a level 5 block without a level 1 block");
-            if (!dvbridge_dv_margins(d, e->l5.left_offset, e->l5.right_offset,
-                                     e->l5.top_offset, e->l5.bottom_offset, v))
+            if (!dvbridge_dv_l5(d, e->l5.left_offset, e->l5.right_offset, e->l5.top_offset,
+                                e->l5.bottom_offset, v))
                 return false; /* (d->refused says why) */
             memcpy(d->margins, v, sizeof(d->margins));
             for (int j = 0; j < 4; j++)
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 2f1fe73..e2d6029 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -32,6 +32,7 @@ enum {
     NOTE_LEVEL3 = 64,
     NOTE_LEVEL3_REFUSED = 128,
     NOTE_CM40_ADDED = 256,
+    NOTE_L5_IGNORED = 512,
 };
 
 /* Hades: the bridge's own passes that are timed (dvbridge_render_time_passes()), each with a few
@@ -663,6 +664,7 @@ bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_ren
         return false;
     *notes = r->notes;
     notes->l5_master = r->fresh & NOTE_L5_MASTER;
+    notes->l5_ignored = r->fresh & NOTE_L5_IGNORED;
     notes->level_skipped = r->fresh & NOTE_LEVEL_SKIPPED;
     notes->bl_depth = r->fresh & NOTE_BL_DEPTH;
     notes->el_depth = r->fresh & NOTE_EL_DEPTH;
@@ -907,6 +909,8 @@ static void note_reading(struct dvbridge_renderer *r)
         bool fresh = false;
         if (reading.l5_master)
             fresh = note(r, NOTE_L5_MASTER) || fresh;
+        if (reading.l5_ignored)
+            fresh = note(r, NOTE_L5_IGNORED) || fresh;
         if (reading.skipped)
             fresh = note(r, NOTE_LEVEL_SKIPPED) || fresh;
         if (reading.cm40_dropped)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 21214a0..ae79c62 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -48,6 +48,8 @@ void dvbridge_render_texture_drawn(struct dvbridge_renderer *renderer);
 #define DVBRIDGE_RENDER_CM40_NOTE 1
 struct dvbridge_render_notes {
     bool l5_master;     /* level 5 offsets read as those of a 3840x2160 master (reading) */
+    /* Hades: the level 5 offsets of the video left aside (reading: l5, l5_ignored, margins) */
+    bool l5_ignored;
     bool level_skipped; /* extension blocks of reserved levels left out (reading) */
     /* Hades: the content mapping v4.0 part of the metadata cannot be carried in this stream and is
      * left out from here on (reading: cm40_why, cm40_level, cm40_length) */
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index d5a017e..117b969 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -969,6 +969,14 @@ void CDVBridgeGLES::LogNotes()
               r.as_given[0] + r.as_given[1] + r.as_given[2] + r.as_given[3] == 0
                   ? ", which do not fit it"
                   : "");
+  if (notes.l5_ignored)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the level 5 offsets of this video ({} {} {} {}) cannot describe its "
+              "picture: {}. They are left aside for the rest of the video: its frames go out with "
+              "the active area of the picture's place (blanking margins {} {} {} {}), and nothing "
+              "of the picture is blanked as bars",
+              r.l5[0], r.l5[1], r.l5[2], r.l5[3], r.l5_ignored ? r.l5_ignored : "", r.margins[0],
+              r.margins[1], r.margins[2], r.margins[3]);
   if (notes.level_skipped)
     CLog::Log(LOGINFO,
               "DVBridge: extension blocks of a level that CCM 001 reserves are left out of the "
