+// For playing a new item, previous playing item's callback may already
+// pushed some delay message into the threadmessage list, they are not
+// expected be processed after or during the new item playback starting.
+// so we clean up previous playing item's playback callback delay messages here.
+constexpr std::array previousMsgsIgnoredByNewPlaying{
+    GUI_MSG_PLAYBACK_STARTED,       GUI_MSG_PLAYBACK_ENDED,         GUI_MSG_PLAYBACK_STOPPED,
+    GUI_MSG_PLAYLIST_CHANGED,       GUI_MSG_PLAYLISTPLAYER_STOPPED, GUI_MSG_PLAYLISTPLAYER_STARTED,
+    GUI_MSG_PLAYLISTPLAYER_CHANGED, GUI_MSG_QUEUE_NEXT_ITEM,        0};
+
+int RemovePreviousPlaybackMessages()
+{
+  return CServiceBroker::GetGUI()->GetWindowManager().RemoveThreadMessageByMessageIds(
+      &previousMsgsIgnoredByNewPlaying[0]);
+}
+
+// Hades: PlayFile() asks which edition of a Matroska file to play while this is above 0. The
+// loops of its dialogs (the busy dialog of the reading, the question) dispatch the thread messages
+// through CApplication::Process(), the only place they are dispatched: there, while it is above 0,
+// the messages above are removed first, as PlayFile() removes them before it opens the new item,
+// so that none of them is handled meanwhile (a delayed GUI_MSG_PLAYBACK_ENDED would start the next
+// item of a playlist inside the question). The application thread only.
+int g_askingBeforePlayback = 0;
+} // namespace
