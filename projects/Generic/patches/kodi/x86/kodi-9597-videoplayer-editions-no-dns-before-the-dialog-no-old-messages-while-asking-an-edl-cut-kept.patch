 {
-  size_t added = 0;
+  size_t count = 0;
   for (const Edit& cut : cuts)
     if (cut.action == Action::CUT && AddEdit(cut))
-      added++;
-  return added;
+    {
+      count++;
+      if (added)
+        added->push_back(cut);
+    }
+  return count;
 }
 
