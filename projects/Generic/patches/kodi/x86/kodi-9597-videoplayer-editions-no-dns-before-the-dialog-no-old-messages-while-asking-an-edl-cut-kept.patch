   return true;
 }
 
+// An edit of the edit list of a session (CEdl::GetRawEditList()), in milliseconds
+struct ListEdit
+{
+  int64_t startMs;
+  int64_t endMs;
+  bool cut;
+};
+
+// The edits of the edit list of this session that come from edit decision list files, for
+// FileTimeOfSaved(): the list less the cuts of the edition that CEdl::AddEdit() took into it
+// (editionInList, CEdl::AddCuts()). A cut of a file identical to one of the edition is in the
+// list once: as the file's, which came first, and AddEdit() refused the edition's (an edit is not
+// applied twice); it is the file's, and stays.
+inline void EditsOfFiles(const std::vector<ListEdit>& list,
+                         const std::vector<Cut>& editionInList,
+                         std::vector<Cut>& otherCuts,
+                         std::vector<Cut>& otherEdits)
+{
+  for (const ListEdit& e : list)
+  {
+    const Cut c{e.startMs, e.endMs};
+    if (e.cut && std::find(editionInList.begin(), editionInList.end(), c) != editionInList.end())
+      continue;
+    (e.cut ? otherCuts : otherEdits).push_back(c);
+  }
+}
+
 // Where in the file a position saved with `saved` is. otherCuts: the cuts that do not come from an
 // edition (edit decision list files), which were there when it was saved too; otherEdits: the other
 // edits of those files (mutes, commercial breaks), which cut nothing but refuse an edition's cut
