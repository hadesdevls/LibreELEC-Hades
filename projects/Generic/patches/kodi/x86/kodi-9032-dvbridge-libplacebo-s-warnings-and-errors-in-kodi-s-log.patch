From 02a6cce0398a403a20febd211bea888e9b2af15a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 18:19:41 +0000
Subject: [PATCH] dvbridge: libplacebo's warnings and errors in Kodi's log

The libplacebo OpenGL context and renderer of the Dolby Vision path were
created without a log, so libplacebo's own explanation of a failure (a
shader that does not compile, a texture or framebuffer that cannot be
created, an unsupported format) was lost; Kodi's log only said that the
render was rejected at some stage.

They now log warnings and errors into Kodi's log, prefixed "DVBridge
libplacebo:", bounded for each renderer (a new one comes with each
change of the full-screen mode): the first 64 messages, then one in
1000, since a failing frame repeats the same messages. The source of a
shader that fails to compile, which libplacebo logs line by line, goes
to the debug log without counting, so that it cannot use up the bound
before the messages that follow it. Nothing unwinds through libplacebo's
C code from the callback. Nothing else changes.

Idea from the diagnostics of the Intel Dolby Vision fork (R0.2.1a-opt1),
implemented independently.
---
 tools/dvbridge/dvbridge_render.c              |  4 +-
 tools/dvbridge/dvbridge_render.h              |  3 +-
 .../VideoRenderers/DVBridgeGLES.cpp           | 56 ++++++++++++++++++-
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  4 ++
 4 files changed, 62 insertions(+), 5 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 20f21d8..7c15544 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -83,7 +83,7 @@ static struct pl_hook_res mask_active_area(void *priv, const struct pl_hook_para
     return (struct pl_hook_res){.failed = mask->failed, .output = PL_HOOK_SIG_NONE};
 }
 
-struct dvbridge_renderer *dvbridge_renderer_create(pl_gpu gpu)
+struct dvbridge_renderer *dvbridge_renderer_create(pl_gpu gpu, pl_log log)
 {
     if (!gpu)
         return NULL;
@@ -102,7 +102,7 @@ struct dvbridge_renderer *dvbridge_renderer_create(pl_gpu gpu)
         r->fragment_quad = size >= 4 && size <= 128 && !(size & (size-1)) &&
                            (stages & GL_FRAGMENT_SHADER_BIT) && (features & 0x81) == 0x81;
     }
-    r->renderer = pl_renderer_create(NULL, gpu);
+    r->renderer = pl_renderer_create(log, gpu);
     r->context = dvbridge_create();
     pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32,
                              PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 05e0b1c..45beaa2 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -5,7 +5,8 @@
 #include "dvbridge_core.h"
 
 struct dvbridge_renderer;
-struct dvbridge_renderer *dvbridge_renderer_create(pl_gpu gpu);
+/* log: where libplacebo reports why a render or a GPU object failed (may be NULL). */
+struct dvbridge_renderer *dvbridge_renderer_create(pl_gpu gpu, pl_log log);
 void dvbridge_renderer_destroy(struct dvbridge_renderer *renderer);
 void dvbridge_renderer_reset(struct dvbridge_renderer *renderer);
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index bc4f4c2..add6aa0 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -2,7 +2,9 @@
 #include "DVBridgeGLES.h"
 
 #include <algorithm>
+#include <atomic>
 #include <iterator>
+#include <string_view>
 #include "DVBridgeShaders.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h"
 #include "utils/log.h"
@@ -18,6 +20,47 @@ extern "C"
 #include <GLES3/gl3.h>
 #include <limits>
 
+namespace
+{
+// A line of shader source, which libplacebo logs line by line ("[ 12] ...") after a shader that
+// failed to compile.
+bool IsShaderSourceLine(std::string_view text)
+{
+  if (text.size() < 4 || text.front() != '[')
+    return false;
+  const size_t close = text.find("] ");
+  if (close == std::string_view::npos || close < 2 || text[close - 1] < '0' || text[close - 1] > '9')
+    return false;
+  return std::all_of(text.begin() + 1, text.begin() + close,
+                     [](char c) { return c == ' ' || (c >= '0' && c <= '9'); });
+}
+
+// libplacebo says why a GPU object or a render failed, where Kodi's own log only says that the
+// render was rejected. Bounded for each renderer (priv is its counter): the first 64 messages,
+// then one in 1000, since a failing frame repeats the same messages. The source of a shader that
+// failed goes to the debug log and is not counted. Nothing may unwind through libplacebo's C code.
+void LogPlacebo(void* priv, pl_log_level level, const char* msg)
+{
+  try
+  {
+    const std::string_view text = std::string_view(msg ? msg : "").substr(0, 512);
+    if (IsShaderSourceLine(text))
+    {
+      CLog::Log(LOGDEBUG, "DVBridge libplacebo: {}", text);
+      return;
+    }
+    const unsigned int n = ++*static_cast<std::atomic<unsigned int>*>(priv);
+    if (n > 64 && n % 1000 != 0)
+      return;
+    CLog::Log(level <= PL_LOG_ERR ? LOGERROR : LOGWARNING, "DVBridge libplacebo: {}{}", text,
+              n == 64 ? " (further messages: one in 1000)" : "");
+  }
+  catch (...)
+  {
+  }
+}
+} // namespace
+
 CDVBridgeGLES::~CDVBridgeGLES()
 {
   CDVPlaybackInfo::presented.store(0);
@@ -27,6 +70,7 @@ CDVBridgeGLES::~CDVBridgeGLES()
   if (m_gl)
     pl_tex_destroy(m_gl->gpu, &m_scanout);
   pl_opengl_destroy(&m_gl);
+  pl_log_destroy(&m_log);
 }
 
 bool CDVBridgeGLES::Fail(const char* stage)
@@ -49,14 +93,22 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   params.allow_software = allowSoftware;
   if (params.egl_context == EGL_NO_CONTEXT)
     return Fail("egl-context");
-  m_gl = pl_opengl_create(nullptr, &params);
+  if (!m_log)
+  {
+    pl_log_params logging{};
+    logging.log_cb = LogPlacebo;
+    logging.log_priv = &m_logMessages;
+    logging.log_level = PL_LOG_WARN;
+    m_log = pl_log_create(PL_API_VER, &logging);
+  }
+  m_gl = pl_opengl_create(m_log, &params);
   if (!m_gl)
     return Fail("libplacebo-opengl");
   // GUI alpha blending takes place in the 32F PQ target, before transport packing.
   if (!pl_opengl_has_ext(m_gl, "GL_EXT_float_blend") ||
       !pl_opengl_has_ext(m_gl, "GL_OES_texture_float_linear"))
     return Fail("float-blend-or-float-linear-capability");
-  m_renderer = dvbridge_renderer_create(m_gl->gpu);
+  m_renderer = dvbridge_renderer_create(m_gl->gpu, m_log);
   pl_opengl_wrap_params output{};
   output.width = 3840;
   output.height = 2160;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 317c917..2dcf7b3 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -4,6 +4,8 @@
 #include "cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h"
 #include "utils/DVBridgeDiagnosticState.h"
 
+#include <atomic>
+
 extern "C"
 {
 #include "dvbridge_gl_frame.h"
@@ -65,6 +67,8 @@ private:
   DVBRIDGE::DiagnosticFailures m_failures;
   bool m_reportedFrame{false};
   // All methods, including destruction, require the owning GL context/thread.
+  pl_log m_log = nullptr; //!< libplacebo's warnings and errors, into Kodi's log
+  std::atomic<unsigned int> m_logMessages{0}; //!< libplacebo messages of this renderer
   pl_opengl m_gl = nullptr;
   dvbridge_renderer* m_renderer = nullptr;
   dvbridge_gl_packer* m_packer = nullptr;
