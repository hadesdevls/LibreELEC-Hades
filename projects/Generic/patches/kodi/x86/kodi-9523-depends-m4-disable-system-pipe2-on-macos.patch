From dc04d82c32aebb4663ddcc24368b2011b01a71ae Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 13 Oct 2026 04:30:39 -0700
Subject: [PATCH] [depends][m4] Disable system pipe2 on macOS

The macOS 27 SDK exposes pipe2 to configure checks, but calling it on
older macOS versions crashes m4. Select the gnulib fallback to preserve
compatibility with the deployment target.
---
 tools/depends/native/m4/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tools/depends/native/m4/Makefile b/tools/depends/native/m4/Makefile
index af740ae..974be70 100644
--- a/tools/depends/native/m4/Makefile
+++ b/tools/depends/native/m4/Makefile
@@ -6,6 +6,11 @@ DEPS = ../../Makefile.include M4-VERSION Makefile ../../download-files.include
 # configuration settings
 CONFIGURE=./configure --prefix=$(PREFIX)
 
+ifeq ($(NATIVE_OS), osx)
+  # Use gnulib's pipe2 fallback for macOS versions before 27.
+  CONFIGURE+= ac_cv_func_pipe2=no
+endif
+
 LIBDYLIB=$(PLATFORM)/src/$(LIBNAME)
 
 all: .installed-$(PLATFORM)
-- 
2.53.0

