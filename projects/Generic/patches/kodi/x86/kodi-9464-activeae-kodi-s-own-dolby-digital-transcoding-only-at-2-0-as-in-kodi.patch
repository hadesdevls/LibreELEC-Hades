From 680eb213fa8a2d5606e387956d138ac398bb5164 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 08:50:20 +0000
Subject: [PATCH] ActiveAE: Kodi's own Dolby Digital transcoding only at 2.0,
 as in Kodi

"Enable Dolby Digital transcoding" (audiooutput.ac3transcode) is shown,
and acted on, where "Number of channels" is 2.0. Turned on there once,
it stays on, hidden, when the setting is raised to 7.1, where Kodi
never transcoded. Since the channels of PCM are limited to the display,
the layout of the engine became 2.0 again for a display of stereo PCM,
and that hidden setting acted: a multichannel track was encoded to
Dolby even with "Surround as Dolby when the display takes only stereo
PCM" off, which its help says gives stereo, and with Kodi's own choice
of format, which does not look at what the display declares. Found by a
review.

The engine now takes it only where the user's own "Number of channels"
(before the limit to the display; 2.0 for S/PDIF, as before) is 2.0 or
less (AE::PCM::KodiTranscodeCounts()): above that, the new setting
alone decides. The setting itself is not changed, and at 2.0 everything
is as in Kodi.

Host test (TestAEPcmChannels): left on at 7.1 or 5.1 it does not count,
at 2.0 and in mono it does; with the code before (the setting as it is)
it fails, and so with one more mutation.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp     |  6 +++++-
 xbmc/cores/AudioEngine/Utils/AEPcmChannels.h      | 15 +++++++++++++++
 .../AudioEngine/Utils/test/TestAEPcmChannels.cpp  | 14 ++++++++++++++
 3 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 07d1c22..b31a37a 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2977,7 +2977,11 @@ void CActiveAE::LoadSettings()
   if (!m_sink.HasPassthroughDevice())
     m_settings.passthrough = false;
   m_settings.ac3passthrough = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_AC3PASSTHROUGH);
-  m_settings.ac3transcode = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_AC3TRANSCODE);
+  // Hades: only where the user's own "Number of channels" is 2.0, as in Kodi (see
+  // AE::PCM::KodiTranscodeCounts()); above, "Surround as Dolby when the display takes only stereo
+  // PCM" decides
+  m_settings.ac3transcode = AE::PCM::KodiTranscodeCounts(
+      m_channelsSetting, settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_AC3TRANSCODE));
   m_settings.eac3passthrough = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_EAC3PASSTHROUGH);
   m_settings.truehdpassthrough = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_TRUEHDPASSTHROUGH);
   m_settings.dtspassthrough = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_DTSPASSTHROUGH);
diff --git a/xbmc/cores/AudioEngine/Utils/AEPcmChannels.h b/xbmc/cores/AudioEngine/Utils/AEPcmChannels.h
index c958d4d..dd6c684 100644
--- a/xbmc/cores/AudioEngine/Utils/AEPcmChannels.h
+++ b/xbmc/cores/AudioEngine/Utils/AEPcmChannels.h
@@ -189,6 +189,21 @@ inline DisplayAudio KeepWhileAway(const DisplayAudio& read, bool displayThere, D
   return kept;
 }
 
+/*!
+ * \brief Whether Kodi's own "Enable Dolby Digital transcoding" (audiooutput.ac3transcode) acts
+ *
+ * Kodi shows it, and acts on it, where "Number of channels" is 2.0 (or less, or the output is
+ * S/PDIF, which the engine takes as 2.0). Set there once, it stays on, hidden, when the setting is
+ * raised to 7.1, where Kodi never transcoded. With the channels limited to the display, the
+ * engine's layout became 2.0 again and that hidden setting acted, whatever "Surround as Dolby when
+ * the display takes only stereo PCM" said. It now counts only where the user's own setting is 2.0.
+ * \param setting "Number of channels" before it is limited to the display (2.0 for S/PDIF)
+ */
+constexpr bool KodiTranscodeCounts(int setting, bool ac3transcode)
+{
+  return ac3transcode && ChannelsOfLayout(setting) > 0 && ChannelsOfLayout(setting) <= 2;
+}
+
 //! What decoded multichannel sound goes out as, for a display that takes stereo PCM only
 enum class DolbyEncode
 {
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
index 9cc6c21..e2588d8 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
@@ -286,6 +286,20 @@ TEST(TestAEPcmChannels, SurroundAsDolbyOnlyWhereTheOutputTakesIt)
   EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_DOLBY));
 }
 
+TEST(TestAEPcmChannels, KodisOwnTranscodeOnlyAtTwoChannels)
+{
+  // "Enable Dolby Digital transcoding" left on from an earlier 2.0, hidden at 7.1: Kodi never acted
+  // on it there, and with the channels limited to the display it does not either
+  EXPECT_FALSE(KodiTranscodeCounts(L7_1, true));
+  EXPECT_FALSE(KodiTranscodeCounts(L5_1, true));
+  // at 2.0 (and for S/PDIF, taken as 2.0), and in mono, as in Kodi
+  EXPECT_TRUE(KodiTranscodeCounts(L2_0, true));
+  EXPECT_TRUE(KodiTranscodeCounts(0, true));
+  EXPECT_FALSE(KodiTranscodeCounts(L2_0, false));
+  // a value that is no layout: no
+  EXPECT_FALSE(KodiTranscodeCounts(42, true));
+}
+
 TEST(TestAEPcmChannels, NothingChangesWhereTheDisplayTakesTheChannels)
 {
   // the TV with its sound bar's audio data (PCM in 8), the bar, a display of 5.1 PCM: PCM
-- 
