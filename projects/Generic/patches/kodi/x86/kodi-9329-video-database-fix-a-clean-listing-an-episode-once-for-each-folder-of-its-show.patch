From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 13 Oct 2026 13:23:27 +0100
Subject: [PATCH] [Video][Database] Fix a clean listing an episode once for
 each folder of its show.

The clean finds an episode's source through the folders of its show, so
a show with more than one folder returns each episode once per folder.
Each removed episode was then listed again for every folder, and
announced as removed as many times.
---
 xbmc/video/VideoDatabase.cpp          |   4 +-
 xbmc/video/test/TestVideoDatabase.cpp | 105 ++++++++++++++++++++++++++
 2 files changed, 108 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 75dbc76..b3077e0 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -11086,6 +11086,8 @@ std::vector<int> CVideoDatabase::CleanMediaType(const std::string &mediaType, co
   std::map<int, std::pair<bool, bool> > sourcePathsDeleteDecisions;
   // Each source path is checked once, as loose assets don't share their decisions
   std::map<int, bool> sourcePathsExist;
+  // An episode is listed once for each folder of its show
+  std::set<int> cleaned;
   m_pDS2->query(sql);
   while (!m_pDS2->eof())
   {
@@ -11174,7 +11176,7 @@ std::vector<int> CVideoDatabase::CleanMediaType(const std::string &mediaType, co
         pathsDeleteDecisions.insert(std::make_pair(m_pDS2->fv(2).get_asInt(), del));
     }
 
-    if (del)
+    if (del && (!isEpisode || cleaned.insert(m_pDS2->fv(0).get_asInt()).second))
     {
       deletedFileIDs += m_pDS2->fv(1).get_asString() + ",";
       cleanedIDs.emplace_back(m_pDS2->fv(0).get_asInt());
