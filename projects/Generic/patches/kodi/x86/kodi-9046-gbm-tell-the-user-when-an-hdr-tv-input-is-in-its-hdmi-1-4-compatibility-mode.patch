diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index a44d9f6..e4913e7 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -94,6 +94,51 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
   }
   return result;
 }
+
+// 2160p at 50 or 60 Hz offered only as YCbCr 4:2:0 (a YCbCr 4:2:0 Video Data Block with one of
+// those modes) by an EDID without an HDMI Forum block: what fits in the HDMI 1.4 rate. Read from
+// the raw EDID, as the Dolby block above.
+bool ScanUhd420Only(const std::vector<uint8_t>& edid)
+{
+  static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+  const size_t size = edid.size();
+  if (size < 128 || size % 128 || !std::equal(std::begin(magic), std::end(magic), edid.begin()))
+    return false;
+  bool uhd420 = false;
+  bool hdmiForum = false;
+  for (size_t block = 1; block < size / 128; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    if (b[0] != 0x02 || b[1] < 3)
+      continue;
+    const unsigned int end = b[2];
+    if (end < 4 || end > 127)
+      continue;
+    for (unsigned int pos = 4; pos < end;)
+    {
+      const unsigned int tag = b[pos] >> 5;
+      const unsigned int len = b[pos] & 31;
+      const uint8_t* data = b + pos + 1;
+      if (pos + len + 1 > end)
+        return false;
+      // HDMI Forum vendor-specific data block (OUI C4-5D-D8) or sink capability data block
+      if ((tag == 3 && len >= 3 && data[0] == 0xd8 && data[1] == 0x5d && data[2] == 0xc4) ||
+          (tag == 7 && len >= 1 && data[0] == 0x79))
+        hdmiForum = true;
+      // YCbCr 4:2:0 Video Data Block: 2160p50/60 at 16:9, 256:135 and 64:27
+      if (tag == 7 && len >= 2 && data[0] == 0x0e)
+      {
+        for (unsigned int i = 1; i < len; ++i)
+        {
+          const unsigned int vic = data[i];
+          uhd420 |= vic == 96 || vic == 97 || vic == 101 || vic == 102 || vic == 106 || vic == 107;
+        }
+      }
+      pos += len + 1;
+    }
+  }
+  return uhd420 && !hdmiForum;
+}
 } // namespace
 
 void CDisplayInfo::DiInfoDeleter::operator()(di_info* p)
@@ -119,6 +164,7 @@ CDisplayInfo::CDisplayInfo(const std::vector<uint8_t>& edid)
   m_info.reset(di_info_parse_edid(edid.data(), edid.size()));
   m_dolbyVideo = ScanDolbyVideo(edid);
   m_dolbyVision = m_dolbyVideo.valid;
+  m_uhd420Only = ScanUhd420Only(edid);
 }
 
 CDisplayInfo::~CDisplayInfo() = default;
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index d622c08..ac35f00 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -119,6 +119,13 @@ public:
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version == 2 &&
            m_dolbyVideo.length >= 11;
   }
+  //! An HDR TV input in its HDMI 1.4 compatibility mode (LG "HDMI Deep Colour" off, and the like
+  //! of other makers): the EDID offers 2160p at 50 and 60 Hz only as YCbCr 4:2:0 and has no HDMI
+  //! Forum block, although an HDR TV has inputs for the full HDMI 2.0 rate.
+  bool UhdLimitedToHdmi14() const
+  {
+    return m_uhd420Only && (m_hdr_static_metadata != nullptr || m_dolbyVision);
+  }
   //! The sink lets the source select the RGB quantization range (VCDB QS bit)
   bool SupportsRGBQuantizationSelection() const { return m_rgbQuantizationSelectable; }
 
@@ -145,6 +152,7 @@ private:
   const di_cta_hdr_static_metadata_block* m_hdr_static_metadata = nullptr;
   bool m_dolbyVision = false;
   DolbyVideoBlock m_dolbyVideo; //!< read from the raw EDID, see the constructor
+  bool m_uhd420Only = false; //!< read from the raw EDID, see UhdLimitedToHdmi14()
   bool m_rgbQuantizationSelectable = false;
 };
 
