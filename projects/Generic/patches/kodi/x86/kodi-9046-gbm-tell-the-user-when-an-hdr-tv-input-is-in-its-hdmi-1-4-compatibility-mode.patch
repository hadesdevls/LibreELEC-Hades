@@ -195,6 +196,7 @@ bool CWinSystemGbm::InitWindowSystem()
     {
       m_info = UTILS::CDisplayInfo::Create(edid);
     }
+    m_limitedInputPending = m_info && m_info->UhdLimitedToHdmi14();
 #ifdef HAVE_DVBRIDGE
     m_displayEdid = edid;
     m_dvInfo = m_info;
@@ -646,6 +648,10 @@ bool CWinSystemGbm::CheckDisplayChange()
     m_dvDisplaySeen = true;
   CLog::Log(LOGINFO, "DVBridge: the display's EDID changed; Dolby Vision Standard: {}",
             changed->SupportsStandardDolbyVision() ? "yes" : "no");
+  // told again only when the display enters that state (not for another change of its EDID, such
+  // as the audio formats of a sound bar that wakes up)
+  if (changed->UhdLimitedToHdmi14() && !(info && info->UhdLimitedToHdmi14()))
+    m_limitedInputPending = true;
   return back || dvChanged;
 }
 
@@ -723,6 +729,21 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore)
 }
 #endif
 
+void CWinSystemGbm::NotifyLimitedInput()
+{
+  if (!m_limitedInputPending.load(std::memory_order_relaxed))
+    return;
+  // not before the skin and its language files are loaded
+  const auto gui = CServiceBroker::GetGUI();
+  if (!gui || !gui->GetSkinInfo() || !m_limitedInputPending.exchange(false))
+    return;
+  CLog::Log(LOGWARNING, "The display offers 2160p at 50 and 60 Hz only as YCbCr 4:2:0 and has no "
+                        "HDMI Forum block: an HDR TV input in its HDMI 1.4 compatibility mode; "
+                        "the user is told");
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, "HDMI",
+                                        CGUIUtils::GetHadesString(39995, 31693), 20000);
+}
