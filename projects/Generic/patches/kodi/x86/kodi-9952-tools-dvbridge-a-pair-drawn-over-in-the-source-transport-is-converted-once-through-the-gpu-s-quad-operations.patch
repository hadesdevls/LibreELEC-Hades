+/* Hades: the codes of a pixel of pass 4 (its luma, and the chroma of its pair) from own, what is drawn
+ * over it, and even, what is drawn over the even pixel of its pair (alpha 2: nothing), in PACK and
+ * PACK_GUI. Where fragment shaders have the quad operations of GL_KHR_shader_subgroup
+ * (DVBRIDGE_SOURCE_QUAD), each pixel converts what is drawn over it once (drawn_over()), and the odd
+ * pixel takes what its even pixel made of it (the two chroma codes, and whether anything is drawn
+ * over it) from the invocation next to it, instead of making the even pixel's picture again (EVEN:
+ * the composite of the GUI, or a fetch of pass 3) and converting it again: a pair drawn over is made
+ * and converted twice, not three or four times (a frame with nothing drawn over it is packed by PACK
+ * as it is written). The swap is outside any branch, so that every invocation of the quad takes part
+ * in it; what comes with it is tagged with the raster position it is of (below 2^24: exact in a
+ * float), and where the invocation next to an odd pixel is not its even pixel, the odd pixel makes
+ * it as before. The same expressions on the same values: the same codes, which a check of the bytes
+ * compares with the form without quads (dvbridge_source_packer_create_plain()). The idea of handing
+ * the pair's value through the quad is that of CroqueMr's composite of the GUI (CB1_GUI_QUAD,
+ * cb1_composite_glsl.h); the form without it is the one PACK and PACK_GUI had. */
+#define PAIR_CODES(EVEN)                                                                          \
+    "#ifdef DVBRIDGE_SOURCE_QUAD\n"                                                               \
+    "    vec3 mine = own.a != 2.0 ? drawn_over(p, own) : vec3(0.0);\n"                            \
+    "    vec4 got = subgroupQuadSwapHorizontal(vec4(mine.yz, own.a, float(p.y * 4096 + p.x)));\n"  \
+    "    uint y = own.a != 2.0 ? code(mine.x) : luma_code(p);\n"                                  \
+    "    vec3 e = mine;\n"                                                                        \
+    "    even = own;\n"                                                                           \
+    "    if (odd) {\n"                                                                            \
+    "        if (got.w == float(p.y * 4096 + ex)) {\n"                                            \
+    "            e = vec3(0.0, got.xy);\n"                                                        \
+    "            even.a = got.z;\n"                                                               \
+    "        } else {\n"                                                                          \
+    "            even = has_layer != 0 && tile_drawn != 0 ? " EVEN " : vec4(0.0, 0.0, 0.0, 2.0);\n" \
+    "            e = even.a != 2.0 ? drawn_over(ivec2(ex, p.y), even) : vec3(0.0);\n"            \
+    "        }\n"                                                                                 \
+    "    }\n"                                                                                     \
+    "    uint c;\n"                                                                               \
+    "    if (even.a != 2.0) {\n"                                                                  \
+    "        c = code(odd ? e.z : e.y);\n"                                                        \
+    "    } else {\n"                                                                              \
+    "        uvec2 cc = pair_chroma(ex, p.y);\n"                                                  \
+    "        c = odd ? cc.y : cc.x;\n"                                                            \
+    "    }\n"                                                                                     \
+    "#else\n"                                                                                     \
+    "    uint y = own.a != 2.0 ? code(drawn_over(p, own).x) : luma_code(p);\n"                   \
+    "    uint c;\n"                                                                               \
+    "    if (even.a != 2.0) {\n"                                                                  \
+    "        vec3 e = drawn_over(ivec2(ex, p.y), even);\n"                                        \
+    "        c = code(odd ? e.z : e.y);\n"                                                        \
+    "    } else {\n"                                                                              \
+    "        uvec2 cc = pair_chroma(ex, p.y);\n"                                                  \
+    "        c = odd ? cc.y : cc.x;\n"                                                            \
+    "    }\n"                                                                                     \
+    "#endif\n"
+
 /* 4. The transport. */
 static const char PACK[] =
     "#version 300 es\n"
@@ -828,17 +878,11 @@ static const char PACK[] =
      * picture; a pair is in the tile of its even pixel) */
     "    if (has_layer != 0 && tile_drawn != 0) {\n"
