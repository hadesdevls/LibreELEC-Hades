@@ -1936,9 +1982,78 @@ static bool locate(GLuint program, GLint *out, const char *const *names, size_t
     return true;
 }
 
+/* Hades: a shader whose first line, #version 300 es, is replaced by first; 0 where it does not
+ * compile (not reported: link_quad() is tried before the form as written) */
+static GLuint compile_first(GLenum type, const char *source, const char *first)
+{
+    static const char written[] = "#version 300 es\n";
+    if (strncmp(source, written, sizeof(written) - 1))
+        return 0;
+    const char *parts[2] = {first, source + sizeof(written) - 1};
+    GLuint shader = glCreateShader(type);
+    glShaderSource(shader, 2, parts, NULL);
+    glCompileShader(shader);
+    GLint ok = 0;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+/* Hades: a program of pass 4 made with the quad operations of GL_KHR_shader_subgroup (PAIR_CODES):
+ * both stages as ESSL 3.10, the version that the subgroup extensions need in Mesa (shaders of two ES
+ * versions do not link), as the packer of the converted transport makes its own
+ * (dvbridge_gl_pack.c). 0 where it is not made: the caller makes it as it is written. */
+static GLuint link_quad(const char *vertex, const char *fragment)
+{
+    static const char version[] = "#version 310 es\n";
+    static const char prelude[] = "#version 310 es\n"
+                                  "#extension GL_KHR_shader_subgroup_basic : require\n"
+                                  "#extension GL_KHR_shader_subgroup_quad : require\n"
+                                  "#define DVBRIDGE_SOURCE_QUAD 1\n";
+    GLuint vs = compile_first(GL_VERTEX_SHADER, vertex, version);
+    GLuint fs = vs ? compile_first(GL_FRAGMENT_SHADER, fragment, prelude) : 0;
+    GLuint program = 0;
+    if (vs && fs) {
+        program = glCreateProgram();
+        glAttachShader(program, vs);
+        glAttachShader(program, fs);
+        glLinkProgram(program);
+        GLint linked = 0;
+        glGetProgramiv(program, GL_LINK_STATUS, &linked);
+        if (!linked) {
+            glDeleteProgram(program);
+            program = 0;
+        }
+    }
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    dvbridge_gl_drain_errors();
+    return program;
+}
+
 #define COUNT(a) (sizeof(a) / sizeof(*(a)))
 
+static struct dvbridge_source_packer *create_packer(bool allow_quad);
