-    "    } else {\n"
-    "        uvec2 cc = pair_chroma(ex, p.y);\n"
-    "        c = odd ? cc.y : cc.x;\n"
-    "    }\n"
+    PAIR_CODES("texelFetch(drawn, ivec2(ex, p.y), 0)")
     CCM_END;
 
