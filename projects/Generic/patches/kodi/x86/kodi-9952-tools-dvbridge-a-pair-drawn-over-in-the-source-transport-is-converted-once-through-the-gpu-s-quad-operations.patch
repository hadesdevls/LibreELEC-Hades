+{
+    return p ? (p->quad_pack ? 1u : 0u) | (p->quad_gui ? 2u : 0u) : 0u;
+}
+
+static struct dvbridge_source_packer *create_packer(bool allow_quad)
 {
     struct dvbridge_source_packer *p = calloc(1, sizeof(*p));
     if (!p)
@@ -1976,6 +2091,21 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     _Static_assert(sizeof(p->s_more) == COUNT(pairs_simple) * sizeof(GLint), "pairs_simple uniforms");
     /* (Hades: passes 3 and 4 over the raster or over its tiles) */
     p->pack = link_with(TILED_VERTEX, PACK);
+    /* (Hades: and PACK with quad operations, for the frames with something drawn over them, where it
+     * is made and has every uniform: PAIR_CODES; a frame with nothing drawn over it is packed by PACK
+     * as it is written, as before) */
+    const bool quad_ops = allow_quad && dvbridge_gl_fragment_quad();
+    p->pack_quad = quad_ops ? link_quad(TILED_VERTEX, PACK) : 0;
+    if (p->pack_quad &&
+        (!locate(p->pack_quad, &p->qpc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+         !locate(p->pack_quad, &p->qu.drawn, pack, COUNT(pack)) ||
+         (p->qpc_tiles = glGetUniformLocation(p->pack_quad, "drawn_tiles")) < 0 ||
+         (p->qpc_mode = glGetUniformLocation(p->pack_quad, "tiles_mode")) < 0 ||
+         (p->qpc_flip = glGetUniformLocation(p->pack_quad, "tiles_flip")) < 0)) {
+        glDeleteProgram(p->pack_quad);
+        p->pack_quad = 0;
+    }
+    p->quad_pack = p->pack_quad != 0;
     p->picture = link_with(TILED_VERTEX, PICTURE);
     p->resite = link(RESITE);
     p->rows = link(ROWS);
@@ -2160,11 +2290,15 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
             "lms_inverse", "metadata_words", "packet_count", "flip_y", "gui", "gui_peak",
             "drawn_tiles", "tiles_mode", "tiles_flip"};
         _Static_assert(sizeof(p->g) == COUNT(pack_gui) * sizeof(GLint), "pack_gui uniforms");
-        p->pack_gui = link_with(TILED_VERTEX, PACK_GUI);
-        if (p->pack_gui && (!locate(p->pack_gui, &p->gc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
-                            !locate(p->pack_gui, &p->g.has_layer, pack_gui, COUNT(pack_gui)))) {
-            glDeleteProgram(p->pack_gui);
-            p->pack_gui = 0;
+        /* (Hades: with quad operations where they are made, else as it is written: PAIR_CODES) */
+        for (int form = quad_ops ? 0 : 1; form < 2 && !p->pack_gui; ++form) {
+            p->pack_gui = form == 0 ? link_quad(TILED_VERTEX, PACK_GUI) : link_with(TILED_VERTEX, PACK_GUI);
+            if (p->pack_gui && (!locate(p->pack_gui, &p->gc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+                                !locate(p->pack_gui, &p->g.has_layer, pack_gui, COUNT(pack_gui)))) {
+                glDeleteProgram(p->pack_gui);
+                p->pack_gui = 0;
+            }
+            p->quad_gui = form == 0 && p->pack_gui;
         }
         if (!p->pack_gui)
