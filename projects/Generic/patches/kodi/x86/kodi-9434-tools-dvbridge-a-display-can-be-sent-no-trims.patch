From 3de753e52d2ce7ad95718d6af47e546d13626e06 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:26:43 +0000
Subject: [PATCH] tools/dvbridge: a display can be sent no trims

Some displays map Dolby Vision better without the trims of the metadata:
a projector whose blacks were washed out (a report in the Kodi forum)
came right when the level 2 trims were removed from the RPU with dovi_tool.

dvbridge_set_trims() (dvbridge_render_send_trims() for the renderer)
leaves out the blocks of levels 2 and 8, and those of level 10, which only
describe the targets of level 8 blocks. What is left (level 1, level 5 and
the rest of the CM v4.0 group: 3, 9, 11 and 254) is what an RPU without
trims carries; dovi_tool's "safe" CM v4.0 default is that same set
(levels 3, 9, 11 and 254, without 8 and 10). The setting is the
display's, so it holds over dvbridge_reset().

Nothing changes by default: the packets are byte for byte those of the
serializer before (host test, with a CM v2.9 and a CM v4.0 RPU).
---
 tools/dvbridge/PROVENANCE.json     |  2 +-
 tools/dvbridge/dvbridge_core.c     |  6 ++++++
 tools/dvbridge/dvbridge_core.h     |  4 ++++
 tools/dvbridge/dvbridge_metadata.h | 15 ++++++++++++++-
 tools/dvbridge/dvbridge_render.c   |  6 ++++++
 tools/dvbridge/dvbridge_render.h   |  3 +++
 6 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/PROVENANCE.json b/tools/dvbridge/PROVENANCE.json
index ce520a6..80aaf17 100644
--- a/tools/dvbridge/PROVENANCE.json
+++ b/tools/dvbridge/PROVENANCE.json
@@ -8,5 +8,5 @@
     "dvbridge_metadata.h": "bc38347df1488546b80fe0e7613840a0437a7f075c9bac114e1f9111c9e99196",
     "mpv_dvbridge_cm4.h": "f6762808f5d7a5824983d72b0188098f19e86bd2a6db7b997ef63e2d35612661"
   },
-  "note": "upstream_files_sha256 are the SHA-256 of the two headers as they were integrated (the derivation described above), not of the files in this tree: LibreELEC Hades changed both since (the git history of this directory says what and why), so these hashes are not expected to match them. The changes after integration (scene refresh in microseconds and by the frame period, L255 and reserved levels left out, the L1 average clamped, level 5 offsets of a cropped or scaled master, a payload of up to 512 bytes in packets of four bytes to a word, the metadata id that goes on across streams, the level 11 checks of dovi_tool, metadata without extension blocks readable, the content mapping v4.0 part left out for a display of display management 2 or 3) are Hades' own and do not come from that source."
+  "note": "upstream_files_sha256 are the SHA-256 of the two headers as they were integrated (the derivation described above), not of the files in this tree: LibreELEC Hades changed both since (the git history of this directory says what and why), so these hashes are not expected to match them. The changes after integration (scene refresh in microseconds and by the frame period, L255 and reserved levels left out, the L1 average clamped, level 5 offsets of a cropped or scaled master, a payload of up to 512 bytes in packets of four bytes to a word, the metadata id that goes on across streams, the level 11 checks of dovi_tool, metadata without extension blocks readable, the content mapping v4.0 part left out for a display of display management 2 or 3, the trims left out for a display that is to be sent none) are Hades' own and do not come from that source."
 }
diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index c5ede31..b60e548 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -53,6 +53,12 @@ void dvbridge_set_display_management(struct dvbridge_context *context, unsigned
         context->cm29_only = version == 2 || version == 3;
 }
 
+void dvbridge_set_trims(struct dvbridge_context *context, bool send)
+{
+    if (context)
+        context->state.no_trims = !send;
+}
+
 struct dvbridge_candidate *dvbridge_prepare(
     const struct dvbridge_context *context, const void *metadata, size_t bytes,
     double pts, struct dvbridge_geometry geometry, bool fel_reconstructed)
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 4341f25..4bfe784 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -34,6 +34,10 @@ void dvbridge_set_frame_period(struct dvbridge_context *context, double period);
  * metadata only (levels 1, 2, 4 and 5; see dvbridge_dv::cm29_only in dvbridge_metadata.h); with 4
  * or later, or 0 (not known), all of it, as before. */
 void dvbridge_set_display_management(struct dvbridge_context *context, unsigned version);
+/* Hades: whether the display is sent the trims of the metadata (levels 2 and 8, and 10, the targets
+ * of level 8); true until said otherwise. Set before the frames of a stream (a frame prepared before
+ * it was made with what held then), and kept by dvbridge_reset(). */
+void dvbridge_set_trims(struct dvbridge_context *context, bool send);
 
 /* No state advances until presentation succeeds and commit is called. */
 struct dvbridge_candidate *dvbridge_prepare(
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 1b21219..d8a8d17 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -74,6 +74,10 @@ struct dvbridge_dv {
      * displays, defines levels 1, 2 and 5 and has the others reserved. Set for each frame from its
      * context (dvbridge_set_display_management()). */
     bool cm29_only;
+    /* Hades: the display is sent no trims (dvbridge_set_trims()): the blocks of levels 2 and 8 are
+     * left out, and those of level 10, which only describe the targets of level 8 blocks. Kept from
+     * one stream to the next (dvbridge_dv_restart()): it is the display's, not the stream's. */
+    bool no_trims;
 };
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
@@ -233,8 +237,10 @@ static inline uint32_t dvbridge_dv_crc(const uint8_t *p, size_t n)
 static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
 {
     const unsigned id = d->id;
+    const bool no_trims = d->no_trims;
     memset(d, 0, sizeof(*d));
     d->id = id;
+    d->no_trims = no_trims;
     d->restart = true;
 }
 /* Hades: the extension levels that a display uses (CCM 001, Table 7). The others are reserved:
@@ -302,7 +308,12 @@ static inline bool dvbridge_dv_gap_refresh(struct dvbridge_dv *d, double gap)
  * the bars does not make one, and the content range and trims of levels 1 and 2 stay the scene's).
  * It was: every change of the area refreshed the scene, so every line of subtitles in a bar, the
  * OSD, and every switch of the presentation a frame ahead made the display start its mapping again
- * in the middle of a scene. */
+ * in the middle of a scene.
+ * Hades: no_trims, the trims are left out (levels 2 and 8, and 10, the targets of level 8): for a
+ * display whose own mapping does better without them (a projector whose blacks the trims of its
+ * target lift). What is left is what an RPU without trims carries: the content range of level 1
+ * and the rest, which the display maps from itself. dovi_tool's "safe" CM v4.0 default is such a
+ * set as well (levels 3, 9, 11 and 254, without 8 and 10). */
 static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetadata *m, double pts,
                                         bool source, unsigned cover)
 {
@@ -390,6 +401,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
                 d->reading.skipped_level = e->level;
             continue;
         }
+        if (d->no_trims && (e->level == 2 || e->level == 8 || e->level == 10))
+            continue; /* Hades: the display is sent no trims */
         switch (e->level) {
         case 1:
             DV_REQUIRE(!area); l1++; n = 3;
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 9436ea6..e0dd41a 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1780,6 +1780,12 @@ void dvbridge_render_use_source_transport(struct dvbridge_renderer *r, bool use)
         r->source_wanted = use;
 }
 
+void dvbridge_render_send_trims(struct dvbridge_renderer *r, bool send)
+{
+    if (r)
+        dvbridge_set_trims(r->context, send);
+}
+
 void dvbridge_render_set_window(struct dvbridge_renderer *r, pl_tex window)
 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 2b5531a..c6690b6 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -290,6 +290,9 @@ int dvbridge_render_warm(struct dvbridge_renderer *renderer, const struct pl_fra
  * the renderer): reconstructed and converted to BT.2020 YCbCr, as before. */
 #define DVBRIDGE_RENDER_SOURCE 1
 void dvbridge_render_use_source_transport(struct dvbridge_renderer *renderer, bool use);
+/* Hades: whether the display is sent the trims of the metadata (dvbridge_set_trims()); true by
+ * default */
+void dvbridge_render_send_trims(struct dvbridge_renderer *renderer, bool send);
 /* Whether the last picture prepared goes out in the source transport; *why, where it is asked
  * for and it does not: why (else NULL) */
 bool dvbridge_render_source(const struct dvbridge_renderer *renderer, const char **why);
