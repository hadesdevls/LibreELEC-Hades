+#pragma once
+
+extern "C"
+{
+#include <libavutil/mastering_display_metadata.h>
+#include <libavutil/rational.h>
+}
+
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace VIDEOPLAYER::HDR_STATIC
+{
+
+/*!
+ * \brief Hades: the HDR10 static metadata of a stream (SMPTE ST 2086 mastering display, and the
+ *        content light levels), the same from one picture to the next, and kept for its pictures
+ *        that come without it
+ *
+ * Whether two pictures have the same mastering display decides whether the renderer is made again
+ * (VideoPicture::IsSameParams(), CRenderManager::Configure()), which sets the output up again: the
+ * display is told the new metadata, and native Dolby Vision output ends and starts again. The same
+ * mastering display comes in more than one form: the SEI of HEVC and H.264 codes its luminances in
+ * steps of 0.0001 cd/m2 and its chromaticities in steps of 0.00002, which FFmpeg gives as fractions
+ * of those steps (10000000/10000 for 1000 cd/m2), and a container gives its own fractions
+ * (Matroska's floats, av_d2q(): 1000/1; or 5368709/1073741824 for a minimum of 0.005 cd/m2 stored
+ * as a 32-bit float). Their numerators and denominators differ, and so would a comparison of exact
+ * fractions (av_cmp_q()) for the float. They are compared here as the bitstream and the HDMI
+ * InfoFrame code them, in those steps (SameMasteringDisplay()); the luminance only where both have
+ * one, the primaries and white point only where both have them.
+ *
+ * The SEI of HEVC applies to the coded layer video sequence (CLVS) of its picture (H.265, the
+ * semantics of the mastering display colour volume SEI message: it persists from its picture to the
+ * end of the CLVS, and all that apply to one CLVS have the same content), and FFmpeg gives it to
+ * every picture of that sequence (libavcodec/hevc/hevcdec.c: its presence counts down at each IRAP
+ * picture with NoRaslOutputFlag set), and to none of the next sequence that does not carry it again.
+ * An encoder may carry it on the first IRAP picture of the stream only: from the next IDR picture
+ * on, the pictures take the container's mastering display (another form, or none at all), and the
+ * renderer is made again at every such change, and after every seek (a flush makes FFmpeg forget
+ * the SEI). The static metadata describes the content, not one sequence of it: a picture without
+ * any takes the last that the stream carried in band while its transfer function is the same
+ * (CInBandHdrMetadata); a new SEI replaces it, the container's is used before any SEI has come, and
+ * nothing is kept from one stream to the next.
+ */
+
+//! The steps of the luminances of a mastering display: 0.0001 cd/m2 (the SEI; CTA-861 codes the
+//! minimum so, and the maximum in 1 cd/m2)
+constexpr int LUMINANCE_STEPS = 10000;
+//! The steps of its chromaticities: 0.00002 (the SEI and CTA-861)
+constexpr int CHROMATICITY_STEPS = 50000;
+
+//! A fraction in steps of 1 / steps, rounded; nothing where it is no number (a denominator of 0)
+inline std::optional<int64_t> Steps(AVRational value, int steps)
+{
+  if (value.den == 0)
+    return std::nullopt;
+  const double v = av_q2d(value) * steps;
+  if (!std::isfinite(v) || std::fabs(v) > 1e15)
+    return std::nullopt;
+  return std::llround(v);
+}
+
+//! Two fractions are the same value in steps of 1 / steps (the same fraction always is)
+inline bool SameValue(AVRational a, AVRational b, int steps)
+{
+  if (a.num == b.num && a.den == b.den)
+    return true;
+  const auto x = Steps(a, steps);
+  const auto y = Steps(b, steps);
+  return x && y && *x == *y;
+}
+
+/*!
+ * \brief Two pictures have the same mastering display: both have none, or both have one with the
+ *        same luminances (where they have them) and the same primaries and white point (where they
+ *        have them), in the steps that the bitstream and the InfoFrame code them in
+ */
+inline bool SameMasteringDisplay(bool hasA,
+                                 const AVMasteringDisplayMetadata& a,
+                                 bool hasB,
+                                 const AVMasteringDisplayMetadata& b)
+{
+  if (hasA != hasB)
+    return false;
+  if (!hasA)
+    return true;
+  if (!a.has_luminance != !b.has_luminance || !a.has_primaries != !b.has_primaries)
+    return false;
+  if (a.has_luminance && (!SameValue(a.max_luminance, b.max_luminance, LUMINANCE_STEPS) ||
+                          !SameValue(a.min_luminance, b.min_luminance, LUMINANCE_STEPS)))
+    return false;
+  if (a.has_primaries)
+  {
+    for (int i = 0; i < 3; ++i)
+      for (int j = 0; j < 2; ++j)
+        if (!SameValue(a.display_primaries[i][j], b.display_primaries[i][j], CHROMATICITY_STEPS))
+          return false;
+    for (int j = 0; j < 2; ++j)
+      if (!SameValue(a.white_point[j], b.white_point[j], CHROMATICITY_STEPS))
+        return false;
+  }
+  return true;
+}
+
+/*!
+ * \brief The static metadata that a stream carried in band, for its pictures that come without it
+ *        (see above); one for each stream: Reset() when another opens
+ */
+class CInBandHdrMetadata
+{
+public:
+  void Reset()
+  {
+    m_display.reset();
+    m_light.reset();
+  }
+
+  /*!
+   * \brief The mastering display of a picture
+   * \param carried what the picture carries in band (its side data), or null
+   * \param transfer its transfer function (AVColorTransferCharacteristic)
+   * \param container the container's, or null
+   * \param out set where the picture has one
+   * \return whether it has one: what it carries (kept for the pictures after it), else the last
+   *         one that the stream carried with the same transfer function, else the container's
+   */
+  bool Display(const AVMasteringDisplayMetadata* carried,
+               int transfer,
+               const AVMasteringDisplayMetadata* container,
+               AVMasteringDisplayMetadata& out)
+  {
+    return Take(m_display, carried, transfer, container, out);
+  }
+
+  //! The content light levels of a picture, as Display() takes the mastering display
+  bool Light(const AVContentLightMetadata* carried,
+             int transfer,
+             const AVContentLightMetadata* container,
+             AVContentLightMetadata& out)
+  {
+    return Take(m_light, carried, transfer, container, out);
+  }
+
+private:
+  template<typename T>
+  struct Kept
+  {
+    T value;
+    int transfer;
+  };
+
+  template<typename T>
+  static bool Take(
+      std::optional<Kept<T>>& kept, const T* carried, int transfer, const T* container, T& out)
+  {
+    if (carried)
+    {
+      out = *carried;
+      kept = Kept<T>{*carried, transfer};
+      return true;
+    }
+    if (kept && kept->transfer == transfer)
+    {
+      out = kept->value;
+      return true;
+    }
+    if (container)
+    {
+      out = *container;
+      return true;
+    }
+    return false;
+  }
+
+  std::optional<Kept<AVMasteringDisplayMetadata>> m_display;
+  std::optional<Kept<AVContentLightMetadata>> m_light;
+};
+
+} // namespace VIDEOPLAYER::HDR_STATIC
