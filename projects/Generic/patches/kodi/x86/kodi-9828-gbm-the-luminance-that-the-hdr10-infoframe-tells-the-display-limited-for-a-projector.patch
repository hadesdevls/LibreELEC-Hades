diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 4865089..10b1ecc 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3415,6 +3415,44 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the luminance that the HDR10 InfoFrame tells the display, limited (a projector that maps less
+           with smaller values): off by default; the picture is not changed -->
+      <setting id="videoscreen.hadeshdr10limiton" type="boolean" label="40974" help="40975">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+        </dependencies>
+        <level>3</level>
+        <default>false</default>
+        <control type="toggle" />
+      </setting>
+      <setting id="videoscreen.hadeshdr10limit" type="integer" parent="videoscreen.hadeshdr10limiton" label="40976" help="40977">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <dependencies>
+          <dependency type="visible" on="property" name="ishdrdisplay"/>
+          <dependency type="enable" setting="videoscreen.hadeshdr10limiton" operator="is">true</dependency>
+        </dependencies>
+        <level>3</level>
+        <default>1000</default>
+        <constraints>
+          <minimum>100</minimum>
+          <step>10</step>
+          <maximum>4000</maximum>
+        </constraints>
+        <control type="spinner" format="string">
+          <formatlabel>39838</formatlabel>
+        </control>
+      </setting>
       <setting id="videoscreen.hadeshdr420" type="integer" label="39848" help="39849">
         <requirement>
           <and>
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 4ac5b13..88b0118 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -411,6 +411,9 @@ public:
   //! Hades: the depth of the link for HDR10 and HLG: 0 automatic, 8 at most 8 bits
   //! (LinkDepthWanted(), windowing/gbm/LinkDepth.h)
   static constexpr auto SETTING_VIDEOSCREEN_HADESHDRDEPTH = "videoscreen.hadeshdrdepth";
+  //! Hades: the luminance that the HDR10 InfoFrame tells the display, limited (CWinSystemGbm::SetHDR())
+  static constexpr auto SETTING_VIDEOSCREEN_HADESHDR10LIMITON = "videoscreen.hadeshdr10limiton";
+  static constexpr auto SETTING_VIDEOSCREEN_HADESHDR10LIMIT = "videoscreen.hadeshdr10limit";
   //! Hades: HDR where RGB would be 8 bits: 0 in YCbCr 4:2:0 at 10 bits (the default), 1 in RGB
   //! at 8 bits (the connector property DVBRIDGE_HDR_YCBCR420 of i915 and amdgpu)
   static constexpr auto SETTING_VIDEOSCREEN_HADESHDR420 = "videoscreen.hadeshdr420";
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index 485a839..7f87938 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -596,6 +596,9 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // (System > Display): labels, help, values
   if (labelId >= 40960 && labelId <= 40973)
     return CGUIUtils::GetHadesString(labelId, 32250 + (labelId - 40960));
+  // the luminance told to the display by the HDR10 InfoFrame, limited (System > Display): labels, help
+  if (labelId >= 40974 && labelId <= 40977)
+    return CGUIUtils::GetHadesString(labelId, 32264 + (labelId - 40974));
   // the help of the Monitor setting (System > Display), in place of Kodi's #40803
   if (labelId == 39853)
     return CGUIUtils::GetHadesString(39853, 31724);
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 29e91e5..5a90814 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3814,6 +3814,35 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
         CLog::Log(LOGDEBUG, LOGVIDEO, "CWinSystemGbm::{} - max_fall: {}", __FUNCTION__,
                   hdr_metadata.hdmi_metadata_type1.max_fall);
       }
+      // Hades: the luminance told to the display limited (videoscreen.hadeshdr10limiton), for a
+      // projector, or a display that adapts its picture to those values: the peak of the mastering
+      // display, MaxCLL and MaxFALL at most the one set (0, not given, stays 0). The picture is not
+      // changed, only what is said of it. Told once for each set of values.
+      const auto component = CServiceBroker::GetSettingsComponent();
+      const auto settings = component ? component->GetSettings() : nullptr;
+      if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDR10LIMITON) &&
+          settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDR10LIMITON) &&
+          settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDR10LIMIT))
+      {
+        auto& t = hdr_metadata.hdmi_metadata_type1;
+        const uint16_t limit = static_cast<uint16_t>(
+            std::clamp(settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESHDR10LIMIT), 100, 4000));
+        const std::array<uint16_t, 3> given{t.max_display_mastering_luminance, t.max_cll, t.max_fall};
+        t.max_display_mastering_luminance = std::min(t.max_display_mastering_luminance, limit);
+        t.max_cll = std::min(t.max_cll, limit);
+        t.max_fall = std::min(t.max_fall, limit);
+        const std::array<uint16_t, 4> told{limit, given[0], given[1], given[2]};
+        if (told != m_hdrLimitTold)
+        {
+          m_hdrLimitTold = told;
+          CLog::Log(LOGINFO,
+                    "HDR: the display is told at most {} cd/m2 (videoscreen.hadeshdr10limiton): the "
+                    "mastering display {} -> {}, MaxCLL {} -> {}, MaxFALL {} -> {} cd/m2; the picture "
+                    "is not changed",
+                    limit, given[0], t.max_display_mastering_luminance, given[1], t.max_cll, given[2],
+                    t.max_fall);
+        }
+      }
     }
   }
   else if (!videoPicture && display.property)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index c394f03..f080833 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -473,6 +473,9 @@ protected:
   std::atomic<bool> m_dvEdidUnread{false};
   std::mutex m_dvRetryLock; //!< held for every change of the retry state, m_dvDisabled included
   std::atomic<bool> m_dvDisabled{false};
+  //! Hades: the limit and the values of the video that the limited HDR10 InfoFrame was told of last
+  //! (SetHDR(), videoscreen.hadeshdr10limiton), for the log
+  std::array<uint16_t, 4> m_hdrLimitTold{};
   //! Hades: native output is turned off in the settings (videoscreen.hadesdvnative), as read
   //! when the last video started (DVNewVideo()), or when first asked: -1 not read yet
   mutable std::atomic<int> m_dvTurnedOff{-1};
