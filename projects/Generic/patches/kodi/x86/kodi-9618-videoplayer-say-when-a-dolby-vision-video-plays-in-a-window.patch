From bdb275c74d86a51794bb23d7beefc891c89b4924 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:18:24 +0000
Subject: [PATCH] VideoPlayer: say when a Dolby Vision video plays in a window

A video screensaver (or a skin's video control) plays its video in a window:
no mode is chosen for it, so it goes out as native Dolby Vision only where
the mode of the menus carries the transport, and by the ordinary output
otherwise. kodi.log now says so when such a video opens, and whether a
screensaver runs, so that a test of a screensaver with a Dolby Vision video
can be read from the log: this line, then the window system's own lines when
native output starts and ends. Nothing else changes.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index d9fd89d..6804c0b 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -37,6 +37,8 @@
 #include "VideoPlayerRadioRDS.h"
 #include "VideoPlayerVideo.h"
 #include "application/Application.h"
+#include "application/ApplicationComponents.h"
+#include "application/ApplicationPowerHandling.h"
 #include "cores/DataCacheCore.h"
 #include "cores/EdlEdit.h"
 #include "cores/FFmpeg.h"
@@ -5196,6 +5198,20 @@ bool CVideoPlayer::OpenVideoStream(CDVDStreamInfo& hint, bool reset)
     m_renderManager.SetNativeDVStream(nativeDV);
     if (!nativeDV && hint.dovi.dv_profile != 0)
       DVBRIDGE::DolbyVisionWithoutNativeOutput();
+    // Hades: a video played in a window (a video screensaver, a skin's video control) gets no
+    // mode of its own: it goes out natively where the mode of the menus carries the transport,
+    // and the window system says when it starts and ends. Said, for the logs of a test.
+    if (nativeDV && !m_playerOptions.fullscreen)
+    {
+      const auto power =
+          CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+      CLog::Log(
+          LOGINFO,
+          "CVideoPlayer::OpenVideoStream - a Dolby Vision video played in a window{}: no mode "
+          "is chosen for it, it goes out natively only if the mode of the menus carries the "
+          "transport",
+          power && power->IsInScreenSaver() ? " while a screensaver runs" : "");
+    }
   }
 #endif
 
