From 86b30f9c6e22e4ab6ccd412403881beb2a2b0b73 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] DVBridge: the size of the enhancement layer in the line of
 the first picture

The first picture of a Dolby Vision stream says in kodi.log, without
debugging, the size of its base layer, and of its enhancement layer only
whether there is one and whether its residual is drawn. A layer of a size
that the composer does not expect, or a FEL title whose layer is 1080p
under a 4K base beside one that has it at the size of the base, could not
be told apart in the log.

Now that line, for native output and for output as HDR10 or SDR, gives the
size of the layer beside that of the base and how the two relate: 1:1,
2:1 (half the base in each dimension) or sizes that do not match. It is
the size of the layer given to the bridge, also where the layer is not
imported or reconstructs nothing (MEL); a stream without one says nothing
more. The idea comes from CroqueMr's build.

Checked on the host with the function as it is in the file: a 1080p layer
under a 4K base, 1080p and 4K layers at 1:1, a 1920x804 layer under a
cropped 3840x1608 base, a 1920x1088 layer under a 4K base, and no layer.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 32 ++++++++++++++++---
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index b5eec70..53982d5 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -143,6 +143,22 @@ std::string DescribeMetadata(const void* metadata)
       static_cast<unsigned int>(color->source_max_pq), levels.empty() ? "none" : levels);
 }
 
+// Hades: the size of the enhancement layer of a picture beside that of its base, for the first
+// picture's line in the log (an idea from CroqueMr's build): a dual-layer stream has its layer at
+// the size of the base (a 1080p base) or at half of it in each dimension (1920x1080 under
+// 3840x2160), and a layer of another size is said to be one. Nothing without a layer (width 0).
+std::string DescribeLayerSize(int baseWidth, int baseHeight, int width, int height)
+{
+  if (width <= 0 || height <= 0)
+    return {};
+  const char* relation =
+      width == baseWidth && height == baseHeight ? "1:1, the size of the base"
+      : 2 * width == baseWidth && 2 * height == baseHeight
+          ? "2:1, half the base in each dimension"
+          : "sizes that do not match: neither that of the base nor half of it";
+  return StringUtils::Format(", enhancement layer {}x{} ({})", width, height, relation);
+}
+
 // Hades: the GPU programs that libplacebo makes, kept from one session to the next (see
 // dvbridge_cache.h). Each program of a video is linked when it is first drawn, and a new one at
 // any frame that needs another (an enhancement layer, the bars written first, a frame with GUI
@@ -602,6 +618,9 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   // Hades: a gap of more than 1.5 frames between presented frames refreshes the scene (a frame that
   // was not shown may have started one)
   dvbridge_render_set_frame_period(m_renderer, base.duration);
+  // (Hades: the size of the layer given, for the log, also where it is not imported)
+  const int layerWidth = enhancement ? enhancement->width : 0;
+  const int layerHeight = enhancement ? enhancement->height : 0;
   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
                                 base.chroma))
@@ -767,8 +786,9 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
       // Hades: in the log without debugging, to tell a stream whose picture comes out wrong
       // from one that plays right
       CLog::Log(LOGINFO,
-                "DVBridge: the first picture of this stream: base {}x{} (layout {}{}), {}, content "
-                "mapping {}; {}; {} bytes of metadata; drawn at {},{} {}x{} by the {} render, sent {}",
+                "DVBridge: the first picture of this stream: base {}x{} (layout {}{}){}, {}, "
+                "content mapping {}; {}; {} bytes of metadata; drawn at {},{} {}x{} by the {} "
+                "render, sent {}",
                 base.width, base.height, static_cast<int>(base.layout),
                 base.baseTransfer == DVBRIDGE_BASE_SDR
                     ? "; SDR in BT.1886, composed at 14 bits and converted to SMPTE ST 2084 as ETSI GS "
@@ -777,6 +797,7 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
                     ? "; HLG, its RPU declaring its HDR picture in SMPTE ST 2084, composed as ETSI GS CCM "
                       "001 composes a base layer in ST 2084"
                     : "",
+                DescribeLayerSize(base.width, base.height, layerWidth, layerHeight),
                 fel       ? "with the residual of its enhancement layer"
                 : omitted ? "without the residual of its enhancement layer, which is missing"
                 : !enhancement && m_layerNotDecoded
@@ -1742,6 +1763,9 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
   // one in HLG (profile 8.4) as one in SMPTE ST 2084 where its RPU declares that (one whose RPU does
   // not never comes here: VideoPicture::doviBaseRefused)
   dvbridge_render_set_base_transfer(m_renderer, base.baseTransfer);
+  // (Hades: the size of the layer given, for the log, also where it is not imported)
+  const int layerWidth = enhancement ? enhancement->width : 0;
+  const int layerHeight = enhancement ? enhancement->height : 0;
   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
                                 base.chroma))
@@ -1811,10 +1835,10 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
                     (fel ? CDVPlaybackInfo::FEL : 0u);
     if (!m_converted++)
       CLog::Log(LOGINFO,
-                "DVBridge: Dolby Vision reconstructed for output {}: base {}x{}, {}, into "
+                "DVBridge: Dolby Vision reconstructed for output {}: base {}x{}{}, {}, into "
                 "{}x{} of a {}x{} output; {}",
                 sdr ? "as SDR (mapped to an output that takes no HDR10)" : "as HDR10", base.width,
-                base.height,
+                base.height, DescribeLayerSize(base.width, base.height, layerWidth, layerHeight),
                 fel       ? "with the residual of its enhancement layer"
                 : omitted ? "without the residual of its enhancement layer, which is missing"
                 : !layered && layerNotDecoded
