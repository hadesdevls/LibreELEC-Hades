From 1ab7d60ad6a59c0e5dc7745913a03c6eeccf5efb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:46:33 +0000
Subject: [PATCH] tools/dvbridge: name in the headers the chroma location of
 the import and the packer's quad form

dvbridge_gl_frame_import() takes the chroma location of the picture since
"tools/dvbridge: chroma where the stream has it, and the chroma of the
even pixel in the transport", and the packer may pack with quad
operations since "tools/dvbridge: pack a composed picture with one fetch
a pixel where fragment shaders have quad operations". The
host test of the bridge (dvrender_test.c) is built against more than one
version of these sources, as it is for DVBRIDGE_RENDER_HDR10: with
DVBRIDGE_GL_FRAME_CHROMA it imports each layer with the chroma location of
its decoded picture, as Kodi does, and with DVBRIDGE_GL_PACKER_QUAD it
checks the packing against the one with two fetches.
---
 tools/dvbridge/dvbridge_gl_frame.h | 1 +
 tools/dvbridge/dvbridge_gl_pack.h  | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tools/dvbridge/dvbridge_gl_frame.h b/tools/dvbridge/dvbridge_gl_frame.h
index 4e67824..dd0f24b 100644
--- a/tools/dvbridge/dvbridge_gl_frame.h
+++ b/tools/dvbridge/dvbridge_gl_frame.h
@@ -23,6 +23,7 @@ struct dvbridge_gl_frame {
  * of libplacebo. Without it the planes were taken as centred between the luma samples, which is
  * not where an HEVC stream has them: half a luma pixel off horizontally, and also vertically for
  * the "top left" of UHD Blu-ray. */
+#define DVBRIDGE_GL_FRAME_CHROMA 1
 bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
                              enum dvbridge_gl_layout layout, int width, int height,
                              const struct dvbridge_gl_plane planes[3],
diff --git a/tools/dvbridge/dvbridge_gl_pack.h b/tools/dvbridge/dvbridge_gl_pack.h
index 6f3b9c6..bc9f1b9 100644
--- a/tools/dvbridge/dvbridge_gl_pack.h
+++ b/tools/dvbridge/dvbridge_gl_pack.h
@@ -9,6 +9,7 @@ void dvbridge_gl_packer_destroy(struct dvbridge_gl_packer *packer);
 /* Hades: the packer was made with DVBRIDGE_PACK_QUAD defined in its fragment shader (the two
  * shaders as ESSL 3.10, the fragment one with the extensions it needs, in place of their #version
  * line): fragment shaders have quad operations here. */
+#define DVBRIDGE_GL_PACKER_QUAD 1
 bool dvbridge_gl_packer_quad(const struct dvbridge_gl_packer *packer);
 /* Current GLES3 context; PQ texture and destination must both be 3840x2160.
  * Destination must be linear RGB8/RGBA8, without multisampling.
-- 
2.53.0

