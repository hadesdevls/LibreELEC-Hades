From 6e70a504c85627d697afdd32bcb8fb905e5b8b88 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:39:07 +0000
Subject: [PATCH] dvbridge: HDR over the tunnel, a picture drawn as it is into
 the picture of the transport and packed with no metadata

DVBRIDGE_HDR10_TUNNEL_LAB (linux-9999-x1-tunnel) sends HDR10, HLG and HDR10+ as YCbCr 4:2:2 at
12 bits packed in the RGB 8 bpc tunnel, with the AVI InfoFrame of 4:2:2 and the HDR static
metadata of the stream, and no Dolby VSIF. This is the bridge's part of it.

dvbridge_render_set_tunnel() makes dvbridge_render_plain() and dvbridge_render_hdr10() draw
their picture (the colour of the stream as it is, BT.2020 with its transfer, held within [0, 1],
or the reconstruction of Dolby Vision as HDR10) into the 3840x2160 picture of the transport
instead of the texture of the output as HDR10: the picture that Kodi draws its GUI over
(dvbridge_render_texture()). Black around the place of a picture that does not fill the raster,
written when what is there is not known to be black (as for Dolby Vision). dvbridge_render_pack()
then packs it with the packer of Low-Latency without metadata, and dvbridge_render_commit() has
nothing to send. Fail closed: a renderer without the picture of the transport, one with
Low-Latency on, and an output that is not 3840x2160 refuse (false, nothing drawn, the reason in
dvbridge_render_not_drawn()); a picture that is not drawn leaves no frame to pack. Off by default:
nothing changes for any other use of the bridge.

The packer takes the chroma of a pair from its even pixel (co-sited, as the receiver puts it),
with no filter: for a video that is the stream's own chroma sample, exactly; a [1 2 1]/4 filter
changes 1 % of the samples of a test picture by up to 350 codes of 12 bits at its colour edges.
What the GUI draws over the picture with sharp colour edges in single pixels is decimated the
same way as in the Dolby Vision tunnel, which has been on screen since RC1.

Host test (the bridge as it is on Mesa zink/lavapipe, tests in work/tunnel): the packed
transport against an independent reference in float64 from the same float picture, on a
real HDR10 stream (the base layer of a 4K 10-bit HEVC), synthetic 3840x2160 pictures, HLG, with
a GUI of one-pixel saturated columns and translucent edges over the picture, and at a smaller
place; both forms of the packer (quad operations and as written) give the same bytes. Eight mutants of the
packer and one of the bridge are caught. Not tried on hardware.
---
 tools/dvbridge/dvbridge_render.c | 141 ++++++++++++++++++++++++++-----
 tools/dvbridge/dvbridge_render.h |  13 +++
 2 files changed, 135 insertions(+), 19 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 42d50b5..6da1583 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -76,6 +76,10 @@ struct dvbridge_renderer {
     bool hdr10_codes;
     /* Hades: its mapping to the display (dvbridge_render_hdr10_mapping()); off when calloc'd */
     struct dvbridge_hdr10_mapping hdr10_mapping;
+    /* Hades: HDR over the tunnel (dvbridge_render_set_tunnel()): the pictures of dvbridge_render_hdr10() and
+     * dvbridge_render_plain() are drawn into the 3840x2160 picture of the transport (rgb), as they are (or as
+     * mapped), and packed with no metadata; tunnel_frame: the last of them was drawn whole and is that frame */
+    bool tunnel, tunnel_frame;
     struct dvbridge_context *context;
     struct dvbridge_candidate *pending;
     /* Hades: why the metadata of the last render could not be mapped or sent (dvbridge_render_refused()) */
@@ -661,6 +665,7 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *r)
     r->ready = false;
     r->packed = false;
     r->hdr10_ready = false;
+    r->tunnel_frame = false;
     if (r->renderer)
         pl_renderer_reset_errors(r->renderer, NULL);
 }
@@ -1371,6 +1376,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     if (!r)
         return false;
     r->ready = false;
+    r->tunnel_frame = false;
     r->refused = NULL;
     r->not_drawn = NULL;
     r->early_mask = false;
@@ -2198,6 +2204,11 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     /* Hades: (why nothing is drawn, for the log: dvbridge_render_refused(), dvbridge_render_not_drawn()) */
     r->refused = NULL;
     r->not_drawn = NULL;
+    /* (HDR over the tunnel: a picture that is not drawn leaves no frame to pack) */
+    if (r->tunnel) {
+        r->tunnel_frame = false;
+        r->ready = false;
+    }
     if (!source || !isfinite(pts) || width < 1 || height < 1 || width > 16384 || height > 16384 ||
         source->num_planes < 1 || source->num_planes > 4 || source->rotation ||
         !view_fits(view, source, width, height)) {
@@ -2236,11 +2247,21 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
         return false;
     }
     r->residual_drawn = paired && mapped.dovi.nlq_active;
+    /* Hades: HDR over the tunnel: drawn into the picture that the transport is packed from, which
+     * is the raster of the output: nothing else (fail closed). Never as 10-bit codes: the packer
+     * reads floats. */
+    const bool tunnel = r->tunnel;
+    if (tunnel && (!r->rgb || width != 3840 || height != 2160)) {
+        r->not_drawn = "HDR over the tunnel is drawn into the 3840x2160 picture of the transport, and the "
+                       "output is not that";
+        return false;
+    }
+    const bool codes = r->hdr10_codes && !tunnel;
     /* The format of the picture that the transport is packed from. A half-float one would be half
      * the memory, and it is not as good: stored in one by a software renderer, the picture came
      * out up to half a code of 1023 below this one (the values were cut off, not rounded).
      * Hades: or the codes of a 10-bit target in full range (dvbridge_render_hdr10_store()) */
-    pl_fmt fmt = r->hdr10_codes ? hdr10_codes_format(r->gpu)
+    pl_fmt fmt = codes ? hdr10_codes_format(r->gpu)
                                 : pl_find_fmt(r->gpu, PL_FMT_FLOAT, 4, 32, 32,
                                               PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
     if (!fmt) {
@@ -2249,16 +2270,18 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     /* Hades: a whole picture of another size is of no use any more (it is never copied to an output
      * of another size, CDVBridgeGLES::CopyConversion()), nor one of the other form */
-    const pl_tex held = r->hdr10[r->hdr10_shown];
-    if (!held || held->params.w != width || held->params.h != height || held->params.format != fmt)
-        r->hdr10_whole = false;
-    /* the texture to draw into: the other one while the one shown holds a whole picture */
     int into = r->hdr10_shown;
-    if (r->hdr10_whole && hdr10_texture(r, fmt, &r->hdr10[!r->hdr10_shown], width, height))
-        into = !r->hdr10_shown;
-    if (!hdr10_texture(r, fmt, &r->hdr10[into], width, height)) {
-        r->not_drawn = "the texture to draw the picture into could not be made";
-        return false;
+    if (!tunnel) {
+        const pl_tex held = r->hdr10[r->hdr10_shown];
+        if (!held || held->params.w != width || held->params.h != height || held->params.format != fmt)
+            r->hdr10_whole = false;
+        /* the texture to draw into: the other one while the one shown holds a whole picture */
+        if (r->hdr10_whole && hdr10_texture(r, fmt, &r->hdr10[!r->hdr10_shown], width, height))
+            into = !r->hdr10_shown;
+        if (!hdr10_texture(r, fmt, &r->hdr10[into], width, height)) {
+            r->not_drawn = "the texture to draw the picture into could not be made";
+            return false;
+        }
     }
     struct pl_frame layer;
     struct pl_frame image = frame_for_render(source, &mapped, &layer);
@@ -2267,7 +2290,8 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
      * is mapped to the display, below). */
     struct pl_frame target = {
         .num_planes = 1,
-        .planes = {{.texture = r->hdr10[into], .components = 4, .component_mapping = {0, 1, 2, 3}}},
+        .planes = {{.texture = tunnel ? r->rgb : r->hdr10[into], .components = 4,
+                    .component_mapping = {0, 1, 2, 3}}},
         .repr = pl_color_repr_rgb,
         .color = mapped.color,
         .crop = {view.dst_x, view.dst_y, view.dst_x + view.dst_width, view.dst_y + view.dst_height},
@@ -2279,11 +2303,11 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     /* (a plain picture is no Dolby Vision one: libplacebo looks at this only for one) */
     if (plain)
         params.dovi_ccm_bl_transfer = PL_COLOR_TRC_UNKNOWN;
-    struct picture_clamp clamped = {.codes = r->hdr10_codes, .levels = 1023.0f};
+    struct picture_clamp clamped = {.codes = codes, .levels = 1023.0f};
     const struct pl_hook hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &clamped,
         .hook = clamp_picture,
-        .signature = r->hdr10_codes ? 0x4456424844523132ULL : 0x4456424844523130ULL};
+        .signature = codes ? 0x4456424844523132ULL : 0x4456424844523130ULL};
     const struct pl_hook *hooks[] = {&hook};
     params.hooks = hooks;
     params.num_hooks = 1;
@@ -2296,11 +2320,11 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
      * and then held within its peak (in an SDR signal the peak is 1.0, which the clamp to [0, 1]
      * holds it within) */
     struct pl_color_map_params mapping;
-    struct display_clamp to_display = {.codes = r->hdr10_codes, .levels = 1023.0f};
+    struct display_clamp to_display = {.codes = codes, .levels = 1023.0f};
     const struct pl_hook display_hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &to_display,
         .hook = clamp_to_display,
-        .signature = r->hdr10_codes ? 0x4456424844523133ULL : 0x4456424844523131ULL};
+        .signature = codes ? 0x4456424844523133ULL : 0x4456424844523131ULL};
     const struct pl_hook *display_hooks[] = {&display_hook};
     const bool peak_hook =
         r->hdr10_mapping.enabled && r->hdr10_mapping.target != DVBRIDGE_HDR10_TARGET_SDR;
@@ -2334,8 +2358,35 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     /* from here on the texture drawn into may hold a part of this picture over an earlier one: the
      * one shown keeps its picture unless it is that texture */
-    if (into == r->hdr10_shown)
+    if (!tunnel && into == r->hdr10_shown)
         r->hdr10_whole = false;
+    /* Hades: HDR over the tunnel: the area outside the place of the picture is black (the codes of
+     * PQ 0, which the packer makes the black of the limited range of), as for a picture of Dolby
+     * Vision that does not fill the raster; written when what is outside is not known to be black
+     * (a new texture, another place, something drawn over it) and not for a picture that fills it */
+    struct dvbridge_geometry place = {.x = view.dst_x, .y = view.dst_y, .width = view.dst_width,
+                                      .height = view.dst_height};
+    const bool fills = view.dst_x == 0 && view.dst_y == 0 && view.dst_width == 3840 &&
+                       view.dst_height == 2160;
+    if (tunnel) {
+        r->tunnel_frame = false;
+        r->ready = false;
+        r->packed = false;
+        dvbridge_candidate_destroy(r->pending);
+        r->pending = NULL;
+        r->source = false;
+        r->scaled_source = false;
+        r->gui_drawn = 0;
+        dvbridge_source_forget(r->source_packer);
+        if (!fills && (!r->rgb_clean || !same_place(r->clean_place, place))) {
+            pl_tex_clear(r->gpu, r->rgb, (float[4]){0, 0, 0, 2});
+            r->rgb_clean = true;
+            r->clean_place[0] = place.x;
+            r->clean_place[1] = place.y;
+            r->clean_place[2] = place.width;
+            r->clean_place[3] = place.height;
+        }
+    }
     time_render(r, &params);
     const bool rendered = pl_render_image(r->renderer, &image, &target, &params);
     bool ok = rendered && (peak_hook ? to_display.called : clamped.called) && (!plain || signal_clamped) &&
@@ -2354,7 +2405,13 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     r->composed = !ok || plain   ? DVBRIDGE_COMPOSED_NONE
                   : ccm_composed ? DVBRIDGE_COMPOSED_CCM
                                  : DVBRIDGE_COMPOSED_RESHAPING;
-    if (ok) {
+    if (tunnel) {
+        /* (a frame that is drawn whole, or that failed, leaves what is outside a place not known) */
+        if (fills || !ok)
+            r->rgb_clean = false;
+        r->ready = ok;
+        r->tunnel_frame = ok;
+    } else if (ok) {
         r->hdr10_shown = into;
         r->hdr10_whole = true;
     }
@@ -2391,7 +2448,12 @@ bool dvbridge_render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *s
         trim_kept(r, r->hdr10_ready);
     }
     restore_gl_state(&state);
-    return r->hdr10_ready;
+    {
+        const bool drawn = r->hdr10_ready;
+        if (r->tunnel)
+            r->hdr10_ready = false;
+        return drawn;
+    }
 }
 
 bool dvbridge_render_plain(struct dvbridge_renderer *r, const struct pl_frame *source,
@@ -2414,7 +2476,12 @@ bool dvbridge_render_plain(struct dvbridge_renderer *r, const struct pl_frame *s
         gamut_table_kept(r, r->hdr10_ready);
     }
     restore_gl_state(&state);
-    return r->hdr10_ready;
+    {
+        const bool drawn = r->hdr10_ready;
+        if (r->tunnel)
+            r->hdr10_ready = false;
+        return drawn;
+    }
 }
 
 pl_tex dvbridge_render_hdr10_texture(const struct dvbridge_renderer *r)
@@ -2440,6 +2507,9 @@ const struct dvbridge_candidate *dvbridge_render_candidate(const struct dvbridge
 
 bool dvbridge_render_commit(struct dvbridge_renderer *r)
 {
+    /* Hades: a frame of HDR over the tunnel has no metadata to commit: it is shown or not */
+    if (r && r->tunnel_frame)
+        return r->ready;
     return r && r->ready && r->pending && dvbridge_commit(r->context, r->pending);
 }
 
@@ -2457,6 +2527,7 @@ bool dvbridge_render_signal(struct dvbridge_renderer *r, const void *metadata, s
     const struct dvbridge_geometry whole = {3840, 2160, 0, 0, 3840, 2160, {0, 0, 0, 0}};
     r->pending = dvbridge_prepare_why(r->serializer ? r->serializer : r->context, metadata, bytes,
                                       0.0, whole, false, false, why);
+    r->tunnel_frame = false;
     r->ready = r->pending != NULL;
     /* (no picture: as for a frame drawn into its target, dvbridge_render_texture() gives none) */
     r->packed = r->ready;
@@ -3104,6 +3175,14 @@ bool dvbridge_render_pack(struct dvbridge_renderer *r, struct dvbridge_gl_packer
 {
     if (r)
         r->gui_drawn = 0; /* (Hades: until a pack in the source transport says otherwise) */
+    /* Hades: HDR over the tunnel: the picture alone, in the layout of the converted transport, with no
+     * metadata in the chroma LSBs (the picture is HDR as the display takes it) */
+    if (r && r->tunnel_frame) {
+        if (!r->ready || r->packed || !r->rgb)
+            return false;
+        const unsigned picture = pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, NULL);
+        return picture && dvbridge_gl_pack_no_metadata(packer, picture, framebuffer, width, height, flip);
+    }
     if (!r || !r->ready || r->packed || !r->pending)
         return false;
     const unsigned rgb = pl_opengl_unwrap(r->gpu, r->rgb, NULL, NULL, NULL);
@@ -3143,6 +3222,7 @@ bool dvbridge_render_graphics(struct dvbridge_renderer *r, const void *metadata,
         return false;
     /* as render() begins: nothing of the frame before is left */
     r->ready = false;
+    r->tunnel_frame = false;
     r->refused = NULL;
     r->not_drawn = NULL;
     r->early_mask = false;
@@ -3196,6 +3276,29 @@ bool dvbridge_render_low_latency(const struct dvbridge_renderer *r)
     return r && r->low_latency;
 }
 
+bool dvbridge_render_set_tunnel(struct dvbridge_renderer *r, bool tunnel)
+{
+    if (!r)
+        return false;
+    /* only a renderer that has the picture of the transport, and never with Low-Latency, which maps
+     * the picture of Dolby Vision to the display and is the other tunnel */
+    if (tunnel && (!r->rgb || r->low_latency))
+        return false;
+    if (r->tunnel != tunnel) {
+        r->tunnel = tunnel;
+        r->tunnel_frame = false;
+        r->ready = false;
+        /* (what is outside a place is not known: the other kind of frame drew into the same texture) */
+        r->rgb_clean = false;
+    }
+    return true;
+}
+
+bool dvbridge_render_tunnel(const struct dvbridge_renderer *r)
+{
+    return r && r->tunnel_frame;
+}
+
 void dvbridge_render_set_ll_pattern(struct dvbridge_renderer *r, bool pattern)
 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 147b48b..bf4fe10 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -220,6 +220,19 @@ bool dvbridge_render_gamut_table(const struct dvbridge_renderer *renderer,
 bool dvbridge_render_set_low_latency(struct dvbridge_renderer *renderer,
                                      const struct dvbridge_hdr10_mapping *mapping);
 bool dvbridge_render_low_latency(const struct dvbridge_renderer *renderer);
+/* Hades: HDR over the tunnel (DVBRIDGE_HDR10_TUNNEL_LAB): an HDR10, HLG or HDR10+ picture (or a Dolby Vision
+ * one reconstructed as HDR10) that is sent as YCbCr 4:2:2 at 12 bits packed in the RGB 8 bpc transport, as it is:
+ * with the tunnel set, dvbridge_render_plain() and dvbridge_render_hdr10() draw their picture into the 3840x2160
+ * picture of the transport (dvbridge_render_texture(), what the GUI is drawn over), BT.2020 with the transfer of
+ * the stream, in [0, 1], black outside the place of the picture; the output is the raster, so another size is
+ * refused (false, nothing drawn). dvbridge_render_pack() then packs it with no metadata (the picture alone: the
+ * layout and the arithmetic of the converted transport, dvbridge_gl_pack_no_metadata()) and
+ * dvbridge_render_commit() has nothing to send. False where the renderer has no picture of the transport (the one
+ * of dvbridge_renderer_create_hdr10()) or Low-Latency is on. Off by default. dvbridge_render_tunnel(): the last
+ * picture drawn was such a frame, and is ready to pack. */
+#define DVBRIDGE_RENDER_TUNNEL 1
+bool dvbridge_render_set_tunnel(struct dvbridge_renderer *renderer, bool tunnel);
+bool dvbridge_render_tunnel(const struct dvbridge_renderer *renderer);
 /* Hades: with Low-Latency on, a test pattern instead of the picture, for the first look at a display
  * (the tunnel's layout as the display reads its Low-Latency input): from the top, in quarters of the
  * raster, eight BT.709 bars at 100 cd/m2 (white, yellow, cyan, green, magenta, red, blue, black) in
-- 
