+
+void CWinSystemGbmGLESContext::ProbeDVConversionDepth()
+{
+  // Asked once the HDR10 signalling is on the output: the guard acts only then. It is waited for
+  // a few seconds of swaps (the commit that carries it can be refused and made again).
+  constexpr unsigned int WAITS = 240;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  const char* const guard = "DVBRIDGE_HDR10_DEEP_COLOR";
+  if (!connector || !connector->SupportsProperty(guard))
+  {
+    m_dvConvertDepth = DVDepth::UNANSWERED;
+    return;
+  }
+  const auto hdr = connector->ReadPropertyValue("HDR_OUTPUT_METADATA");
+  if (!hdr || !*hdr)
+  {
+    if (++m_dvConvertDepthWaits >= WAITS)
+    {
+      m_dvConvertDepth = DVDepth::UNANSWERED;
+      CLog::Log(LOGINFO, "DVBridge: the depth of Dolby Vision rebuilt as HDR10 is not known: the "
+                         "output has no HDR signalling to ask about");
+    }
+    return;
+  }
+  m_dvConvertDepthWaits = 0;
+  const auto* mode = drm->GetSelectedMode();
+  const std::string where =
+      mode ? StringUtils::Format("{}x{} @ {:.3f} Hz", mode->hdisplay, mode->vdisplay,
+                                 mode->htotal && mode->vtotal
+                                     ? mode->clock * 1000.0 /
+                                           (static_cast<double>(mode->htotal) * mode->vtotal)
+                                     : 0.0)
+           : std::string("this mode");
+  switch (drm->TestConnectorProperty(guard, 1))
+  {
+    case CDRMAtomic::PropertyTest::ACCEPTED:
+      m_dvConvertDepth = DVDepth::DEEP;
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision rebuilt as HDR10 goes out at 10 bits or more in {}", where);
+      break;
+    case CDRMAtomic::PropertyTest::REFUSED:
+    {
+      const auto refused = drm->ReadRefused();
+      if (DVBRIDGE::REFUSED::Has(refused, DVBRIDGE::REFUSED::HDR10_DEPTH))
+      {
+        m_dvConvertDepth = DVDepth::EIGHT;
+        CLog::Log(LOGWARNING,
+                  "DVBridge: Dolby Vision rebuilt as HDR10 goes out at 8 bits in {}: the link to "
+                  "the display carries no more in this mode (the kernel log says why: "
+                  "\"DVBRIDGE refused: hdr10-depth\"); it plays as it would without this question",
+                  where);
+      }
+      else
+      {
+        m_dvConvertDepth = DVDepth::UNANSWERED;
+        CLog::Log(LOGINFO,
+                  "DVBridge: the depth of Dolby Vision rebuilt as HDR10 is not known: the driver "
+                  "did not answer the question{}",
+                  refused.empty() ? std::string()
+                                  : " (it refused it for: " + DVBRIDGE::REFUSED::Join(refused) +
+                                        ")");
+      }
+      break;
+    }
+    case CDRMAtomic::PropertyTest::UNSUPPORTED:
+      m_dvConvertDepth = DVDepth::UNANSWERED;
+      break;
+  }
+  PublishDVInfo(true);
 }
 
