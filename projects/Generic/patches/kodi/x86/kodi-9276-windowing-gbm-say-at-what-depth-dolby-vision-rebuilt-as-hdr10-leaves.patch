--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -242,6 +242,25 @@ private:
   //! and whether one was taken yet; render thread
   dvbridge_hdr10_mapping m_dvConvertMapping{};
   bool m_dvConvertMappingSet = false;
+  /*!
+   * Hades: the depth at which such a picture leaves, as the HDR10 depth guard of the driver
+   * (DVBRIDGE_HDR10_DEEP_COLOR, i915 and amdgpu with the Hades patches) answers a question about
+   * the output in use (ProbeDVConversionDepth()): asked once a picture has gone out with its HDR
+   * signalling, and again after a change of mode or with another video. Nothing is changed for
+   * it: the picture goes out as it would without the question. UNANSWERED where the driver has
+   * no such guard (NVIDIA) or did not answer.
+   */
+  enum class DVDepth
+  {
+    UNKNOWN, //!< not asked (no picture drawn that way since the output last changed)
+    PENDING, //!< to be asked after the next buffer swap
+    DEEP, //!< 10 bits per component or more
+    EIGHT, //!< fewer than 10: the link does not carry more in this mode
+    UNANSWERED,
+  };
+  std::atomic<DVDepth> m_dvConvertDepth{DVDepth::UNKNOWN};
+  unsigned int m_dvConvertDepthWaits{0}; //!< swaps that the question has waited for the HDR signalling
+  void ProbeDVConversionDepth();
   CDVBridgeState m_dvState;
   std::atomic<bool> m_dvRendererNative{false};
   std::atomic<bool> m_dvViewKeepsOrdinary{false};
