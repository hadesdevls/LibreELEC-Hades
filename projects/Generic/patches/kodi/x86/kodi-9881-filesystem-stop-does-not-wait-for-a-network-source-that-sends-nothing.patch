diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index dc19920..ec2e303 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -14,6 +14,7 @@
 #include "URL.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
+#include "threads/SystemClock.h"
 #include "threads/Thread.h"
 #include "utils/log.h"
 
@@ -167,6 +168,11 @@ bool CFileCache::Open(const CURL& url)
   bool retry = false;
   m_source->IoControl(IOControl::SET_RETRY, &retry); // We already handle retrying ourselves
 
+  // A source read that waits for the network ends when the cache thread is told to stop: whoever
+  // closes the file (on Stop, the thread of the interface) does not wait for the network timeout of
+  // a source that sends nothing. m_bStop is false again once the thread is created.
+  m_source->IoControl(IOControl::READ_ABORT, &m_bStop);
+
   // check if source can seek
   m_seekPossible = m_source->IoControl(IOControl::SEEK_POSSIBLE, NULL);
 
@@ -318,6 +324,9 @@ void CFileCache::Process()
       {
         const int64_t sourceSeekResult = m_source->Seek(cacheMaxPos, SEEK_SET);
         const DWORD sourceSeekError = GetLastError();
+        // a seek that StopThread() ended is no error (OnExit() releases whoever waits for it)
+        if (m_bStop)
+          break; // while (!m_bStop)
         if (sourceSeekResult != cacheMaxPos)
         {
           CLog::Log(LOGERROR, "CFileCache::{} - <{}> error {} seeking. Seek returned {}",
@@ -422,6 +431,10 @@ void CFileCache::Process()
       iRead = m_source->Read(buffer.get(), maxSourceRead);
     if (iRead <= 0)
     {
+      // A read that StopThread() ended is no end of the file and no error of the source
+      if (m_bStop)
+        break; // while (!m_bStop)
+
       // Check for actual EOF and retry as long as we still have data in our cache
       if (m_writePos < m_fileSize && m_pCache->WaitForData(0, 0ms) > 0)
       {
@@ -466,7 +479,7 @@ void CFileCache::Process()
         if (m_bStop)
           break; // while (!m_bStop)
         const int64_t reopened = m_source->Seek(m_writePos, SEEK_SET);
-        if (reopened != m_writePos)
+        if (reopened != m_writePos && !m_bStop)
           CLog::Log(LOGWARNING, "CFileCache::{} - <{}> reopening at {} returned {}", __FUNCTION__,
                     m_sourcePath, m_writePos, reopened);
         continue; // while (!m_bStop)
@@ -613,7 +626,14 @@ retry:
     }
 
     // just wait for some data to show up
-    iRc = m_pCache->WaitForData(1, 10s);
+    bool aborted = false;
+    iRc = WaitForCacheData(1, 10s, aborted);
+    if (aborted)
+    {
+      CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> read aborted by the reader", __FUNCTION__,
+                m_sourcePath);
+      return -1;
+    }
     if (iRc > 0)
       goto retry;
     if (!m_sourcePositionValid)
@@ -696,6 +716,13 @@ int64_t CFileCache::Seek(int64_t iFilePosition, int iWhence)
       // SeekEnded will never be set if FileCache thread is not running
       if (!CThread::IsRunning())
         return -1;
+      // the reader closes: it does not wait for a source seek that the network holds up
+      if (ReadAborted())
+      {
+        CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> seek aborted by the reader", __FUNCTION__,
+                  m_sourcePath);
+        return -1;
+      }
     }
 
     if (m_nSeekResult != m_seekPos)
@@ -709,11 +736,16 @@ int64_t CFileCache::Seek(int64_t iFilePosition, int iWhence)
     {
       CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> waiting for position {}", __FUNCTION__,
                 m_sourcePath, iTarget);
-      if (m_pCache->WaitForData(static_cast<uint32_t>(iTarget - m_seekPos), 10s) <
+      bool aborted = false;
+      if (WaitForCacheData(static_cast<uint32_t>(iTarget - m_seekPos), 10s, aborted) <
           iTarget - m_seekPos)
       {
-        CLog::Log(LOGWARNING, "CFileCache::{} - <{}> failed to get remaining data", __FUNCTION__,
-                  m_sourcePath);
+        if (aborted)
+          CLog::Log(LOGDEBUG, "CFileCache::{} - <{}> seek aborted by the reader", __FUNCTION__,
+                    m_sourcePath);
+        else
+          CLog::Log(LOGWARNING, "CFileCache::{} - <{}> failed to get remaining data", __FUNCTION__,
+                    m_sourcePath);
         return -1;
       }
       m_pCache->Seek(iTarget);
@@ -726,6 +758,35 @@ int64_t CFileCache::Seek(int64_t iFilePosition, int iWhence)
   return iTarget;
 }
 
+int64_t CFileCache::WaitForCacheData(uint32_t minimum,
+                                     std::chrono::milliseconds timeout,
+                                     bool& aborted)
+{
+  aborted = false;
+  if (!m_readAbort)
+    return m_pCache->WaitForData(minimum, timeout);
+
+  // The same wait, in slices of at most 100 ms between which the abort flag of the reader is
+  // looked at. Between the slices nothing is lost: the data stays in the cache. A slice that ends
+  // before its time ended the wait itself (the data is there, or the end of the input), whatever
+  // minimum the cache strategy settled for; one that runs out only goes on to the next.
+  XbmcThreads::EndTime<> deadline{timeout};
+  for (;;)
+  {
+    if (*m_readAbort)
+    {
+      aborted = true;
+      return 0;
+    }
+    const auto left = deadline.GetTimeLeft();
+    const auto slice = std::min(left, 100ms);
+    const auto start = std::chrono::steady_clock::now();
+    const int64_t avail = m_pCache->WaitForData(minimum, slice);
+    if (avail >= minimum || left <= 100ms || std::chrono::steady_clock::now() - start < slice)
+      return avail;
+  }
+}
+
 void CFileCache::Close()
 {
   StopThread();
@@ -798,5 +859,13 @@ int CFileCache::IoControl(IOControl request, void* param)
   if (request == IOControl::SEEK_POSSIBLE)
     return m_seekPossible;
 
+  if (request == IOControl::READ_ABORT)
+  {
+    // the reader's flag (set before its reads): its waits for data end when it is true. The
+    // source is not given it: the source stops with the cache thread (StopThread()).
+    m_readAbort = static_cast<const std::atomic<bool>*>(param);
+    return 0;
+  }
+
   return -1;
 }
diff --git a/xbmc/filesystem/FileCache.h b/xbmc/filesystem/FileCache.h
index 2a38082..1ac7963 100644
--- a/xbmc/filesystem/FileCache.h
+++ b/xbmc/filesystem/FileCache.h
@@ -96,6 +96,11 @@ public:
     // the events
     friend class ::TestFileCache;
 
+    //! true once the reader has aborted its reads (IOControl::READ_ABORT)
+    bool ReadAborted() const { return m_readAbort && *m_readAbort; }
+    //! m_pCache->WaitForData(), ended early (aborted = true) when the reader aborts its reads
+    int64_t WaitForCacheData(uint32_t minimum, std::chrono::milliseconds timeout, bool& aborted);
+
     std::unique_ptr<CCacheStrategy> m_pCache;
     int m_seekPossible = 0;
     std::unique_ptr<IFileCacheSource> m_source;
@@ -120,6 +125,8 @@ public:
     unsigned int m_flags;
     CCriticalSection m_sync;
     std::chrono::milliseconds m_processWait{100ms};
+    //! IOControl::READ_ABORT of the reader (a player sets it when it closes)
+    const std::atomic<bool>* m_readAbort = nullptr;
   };
 
 }
diff --git a/xbmc/filesystem/IFileTypes.h b/xbmc/filesystem/IFileTypes.h
index ba0eec0..8c90df1 100644
--- a/xbmc/filesystem/IFileTypes.h
+++ b/xbmc/filesystem/IFileTypes.h
@@ -74,6 +74,8 @@ enum class IOControl
   CACHE_SETRATE = 4, /**< unsigned int with speed limit for caching in bytes per second */
   SET_CACHE = 8, /**< CFileCache */
   SET_RETRY = 16, /**< Enable/disable retry within the protocol handler (if supported) */
+  READ_ABORT = 32, /**< const std::atomic<bool>*: a read that waits for data ends when it is true,
+                        and so does every later one (nullptr: none). Set before the reads. */
 };
 
 enum class CURLOptionType
diff --git a/xbmc/filesystem/ShoutcastFile.cpp b/xbmc/filesystem/ShoutcastFile.cpp
index 0adf4df..0a35eea 100644
--- a/xbmc/filesystem/ShoutcastFile.cpp
+++ b/xbmc/filesystem/ShoutcastFile.cpp
@@ -336,6 +336,8 @@ int CShoutcastFile::IoControl(IOControl control, void* payload)
     m_cacheReader = static_cast<CFileCache*>(payload);
     Create();
   }
+  else if (control == IOControl::READ_ABORT)
+    return m_file.IoControl(control, payload); // the reads wait in the Curl file
 
   return IFile::IoControl(control, payload);
 }
