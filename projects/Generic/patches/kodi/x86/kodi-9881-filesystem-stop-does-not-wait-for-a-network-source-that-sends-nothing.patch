From 9254192bfe95100f72ddc73db6ec9d6cbfeb6d81 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:05:31 +0000
Subject: [PATCH] filesystem: Stop does not wait for a network source that
 sends nothing

When the source of a cached file (an HTTP stream) stops sending, the
cache thread waits in CCurlFile's FillBuffer() until curl's low-speed
limit ends the transfer (20 s, about 26 s in all on the host test), and
the player can wait up to 10 s in CFileCache::Read() for data that does
not come. Stop closes the player from the thread of the interface:
VideoPlayer waits for its thread, which waits in that read, and then
closes the file, whose CFileCache::Close() joins the cache thread that
waits in curl. Nobody called CCurlFile::Cancel(), and Cancel() would
block until the file is closed. Measured with the read path of
CCurlFile against a local server that stalls after 1 MiB: the read
ended by itself after 26.0 s; with the stop flag of this change, 193 ms
after it is set.

A new IOControl::READ_ABORT gives a file a std::atomic<bool> that ends a
read that waits for data when it becomes true:

- CFileCache gives its source the stop flag of the cache thread when it
  opens it, so StopThread() also ends a source read or seek that waits
  for the network. A read or seek that the stop ended is no end of the
  file and no error: the thread leaves without logging one, and the
  reopening of a source that stopped early (a Hades change) logs
  nothing either when the stop ends it.
- CCurlFile ends FillBuffer() when the flag is set, and, while it is
  armed, waits in select() for at most 200 ms at a time (curl's own
  timer can be a second). CShoutcastFile hands the flag to its Curl
  file.
- CFileCache takes the flag of its reader: a read or a seek of the
  reader that waits for data (a read waits up to 10 s, a seek for as
  long as the source takes) waits in slices of at most 100 ms and ends,
  with an error, once the flag is set. Without the flag, and while it is
  not set, the waits are the same as before.
- CDVDInputStreamFile gives the file of a player the flag that its
  Abort() sets (VideoPlayer::CloseFile() calls it), the one it already
  gives to the read retries of a local drive.

Host test of CFileCache (FileCache.cpp and CircularCache.cpp of the
tree, with a source that stalls like a network source): a waiting read
ends within 300 ms of the abort and reports an error, not the end of
the file (before: 10 s, then the end of the file); Close() returns
within 400 ms while the source sends nothing (before: until the source
gave up); a seek that waits for the source ends with the abort; a short
stall loses no byte; the end of the file is still reported at once; a
stop logs no warning or error.

The idea comes from primez (pannal's Kodi tree, "FileCache: End a
stalled source read when the cache thread stops" and
"DVDInputStreamFile: End a read that waits for cached data when the
player closes").
---
 .../DVDInputStreams/DVDInputStreamFile.cpp    | 10 ++-
 xbmc/filesystem/CurlFile.cpp                  | 17 +++-
 xbmc/filesystem/CurlFile.h                    |  5 ++
 xbmc/filesystem/FileCache.cpp                 | 79 +++++++++++++++++--
 xbmc/filesystem/FileCache.h                   |  7 ++
 xbmc/filesystem/IFileTypes.h                  |  2 +
 xbmc/filesystem/ShoutcastFile.cpp             |  2 +
 7 files changed, 115 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
index 5be1fd8..84ad72b 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
@@ -88,6 +88,13 @@ bool CDVDInputStreamFile::Open()
   }
 #endif
 
+  // Hades: for a player, a read or a seek that waits for data of the cache (a network source that
+  // sends nothing) ends when the player closes (Abort()), instead of after up to 10 s, or for as
+  // long as the source takes to seek. A file without a cache, or a cache-less source, ignores it.
+  if (m_retryReads)
+    m_pFile->IoControl(IOControl::READ_ABORT,
+                       const_cast<std::atomic<bool>*>(m_retryAbort ? m_retryAbort : &m_aborted));
+
   if (m_pFile->GetImplementation() && (content.empty() || content == "application/octet-stream"))
     m_content = m_pFile->GetImplementation()->GetProperty(XFILE::FileProperty::CONTENT_TYPE);
 
@@ -111,7 +118,8 @@ void CDVDInputStreamFile::Close()
 
 void CDVDInputStreamFile::Abort()
 {
-  // another thread: only the flag, which the reads of m_pFile look at while they wait
+  // another thread: only the flag, which the reads of m_pFile look at while they wait (the read
+  // retries of a local drive, and the waits of a cache: IOControl::READ_ABORT)
   m_aborted = true;
 }
 
diff --git a/xbmc/filesystem/CurlFile.cpp b/xbmc/filesystem/CurlFile.cpp
index d8d7c08..5b487b8 100644
--- a/xbmc/filesystem/CurlFile.cpp
+++ b/xbmc/filesystem/CurlFile.cpp
@@ -1524,6 +1524,7 @@ int64_t CCurlFile::Seek(int64_t iFilePosition, int iWhence)
       m_oldState          = m_state;
       m_state             = new CReadState();
       m_state->m_fileSize = m_oldState->m_fileSize;
+      m_state->m_readAbort = m_readAbort;
       g_curlInterface.easy_acquire(url.GetProtocol().c_str(),
                                   url.GetHostName().c_str(),
                                   &m_state->m_easyHandle,
@@ -1787,7 +1788,7 @@ int8_t CCurlFile::CReadState::FillBuffer(unsigned int want)
   // doesn't exceed required size already
   while (m_buffer.getMaxReadSize() < want && m_buffer.getMaxWriteSize() > 0 )
   {
-    if (m_cancelled)
+    if (m_cancelled || (m_readAbort && *m_readAbort))
       return FILLBUFFER_NO_DATA;
 
     /* if there is data in overflow buffer, try to use that first */
@@ -1934,6 +1935,10 @@ int8_t CCurlFile::CReadState::FillBuffer(unsigned int want)
         long timeout = 0;
         if (CURLM_OK != g_curlInterface.multi_timeout(m_multiHandle, &timeout) || timeout == -1 || timeout < 200)
           timeout = 200;
+        // A read that can be aborted (IOControl::READ_ABORT) looks at its flag at least every 200 ms
+        // while the source sends nothing; curl's own timer can be a second.
+        if (m_readAbort && timeout > 200)
+          timeout = 200;
 
         XbmcThreads::EndTime<> endTime{std::chrono::milliseconds(timeout)};
         int rc;
@@ -2205,6 +2210,16 @@ int CCurlFile::IoControl(IOControl request, void* param)
     return 0;
   }
 
+  if (request == IOControl::READ_ABORT)
+  {
+    // on the thread that reads, before the reads: only the flag is looked at from then on
+    m_readAbort = static_cast<const std::atomic<bool>*>(param);
+    m_state->m_readAbort = m_readAbort;
+    if (m_oldState)
+      m_oldState->m_readAbort = m_readAbort;
+    return 0;
+  }
+
   return -1;
 }
 
