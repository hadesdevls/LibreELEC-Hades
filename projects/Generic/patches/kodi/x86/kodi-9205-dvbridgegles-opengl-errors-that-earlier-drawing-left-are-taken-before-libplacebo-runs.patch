From 2439d4138d282427758f2c566f71b6b570b55576 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 14 Oct 2026 08:14:02 +0000
Subject: [PATCH] DVBridgeGLES: OpenGL errors that earlier drawing left are
 taken before libplacebo runs

libplacebo reads glGetError() after its own calls and takes whatever it
finds as its own failure: it logs it as its own error, marks the GPU as
failed, and where it was making a texture, a pass or a buffer, that one
is not made. Seen on hardware as "pl_gpu_create_gl: OpenGL error:
GL_INVALID_VALUE" when a bridge was set up and "gl_tex_destroy: OpenGL
error: GL_INVALID_VALUE" when one was destroyed, once each in a session
of eight videos. Those two did no harm: libplacebo goes on after the
first ("ignoring"), and a texture is deleted before the check of the
second. Where it would do harm, the making of a texture, a pass or a
buffer while a picture is drawn, the bridge's C code already clears them
before its own GL work (dvbridge_render_rgb(), dvbridge_render_packed(),
dvbridge_render_hdr10()).

Setting libplacebo up, importing the layers of a picture, resetting the
renderer (which destroys what libplacebo had cached) and destroying the
bridge did not clear them. They are cleared there too, and logged as
what they are: the first eight times, then one time in 1000.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 44 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  4 ++
 2 files changed, 48 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 85ff88b..ce8c141 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -92,6 +92,8 @@ bool SameView(const dvbridge_view& a, const dvbridge_view& b)
 CDVBridgeGLES::~CDVBridgeGLES()
 {
   CDVPlaybackInfo::presented.store(0);
+  if (m_gl)
+    TakeStaleGLErrors("the bridge is destroyed");
   glDeleteFramebuffers(1, &m_framebuffer);
   dvbridge_gl_packer_destroy(m_packer);
   dvbridge_gl_copier_destroy(m_copier);
@@ -102,6 +104,36 @@ CDVBridgeGLES::~CDVBridgeGLES()
   pl_log_destroy(&m_log);
 }
 
+void CDVBridgeGLES::TakeStaleGLErrors(const char* before)
+{
+  // libplacebo reads glGetError() after its own calls and takes whatever it finds as its own
+  // failure: a texture, a pass or a buffer that it makes is then not made, and its log blames
+  // itself ("pl_gpu_create_gl: OpenGL error", "gl_tex_destroy: OpenGL error"). The bridge's own C
+  // code clears them before its GL work (dvbridge_render_rgb()); this does it where libplacebo
+  // runs from here, and says in the log whose they were. Bounded: glGetError() returns each
+  // recorded error flag once, but a lost context can keep returning one.
+  GLenum first = GL_NO_ERROR;
+  unsigned int count = 0;
+  while (count < 16)
+  {
+    const GLenum error = glGetError();
+    if (error == GL_NO_ERROR)
+      break;
+    if (!count)
+      first = error;
+    ++count;
+  }
+  if (!count)
+    return;
+  // the first eight times, then one in 1000
+  if (++m_staleGLErrors <= 8 || m_staleGLErrors % 1000 == 0)
+    CLog::Log(LOGINFO,
+              "DVBridge: {} OpenGL error{} that earlier drawing left in the context, taken before "
+              "{} (the first: 0x{:04x}){}",
+              count, count == 1 ? "" : "s", before, static_cast<unsigned int>(first),
+              m_staleGLErrors == 8 ? "; from now on one time in 1000 is logged" : "");
+}
+
 bool CDVBridgeGLES::Fail(const char* stage)
 {
   const auto now = std::chrono::duration_cast<std::chrono::milliseconds>(
@@ -130,6 +162,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
     logging.log_level = PL_LOG_WARN;
     m_log = pl_log_create(PL_API_VER, &logging);
   }
+  TakeStaleGLErrors("libplacebo is set up");
   m_gl = pl_opengl_create(m_log, &params);
   if (!m_gl)
     return Fail("libplacebo-opengl");
@@ -188,6 +221,9 @@ void CDVBridgeGLES::Reset()
   m_l1Changes = 0;
   m_prepared = m_packed = false;
   m_direct = false;
+  // (resetting the renderer destroys what libplacebo had cached, and it checks for errors then)
+  if (m_gl)
+    TakeStaleGLErrors("the renderer is reset");
   dvbridge_renderer_reset(m_renderer);
 }
 
@@ -198,6 +234,7 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   m_direct = false;
   if (!m_renderer || !metadata.Data())
     return Fail("renderer-or-metadata-missing");
+  TakeStaleGLErrors("a picture is prepared");
   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes))
     return Fail("base-layer-import");
@@ -371,6 +408,8 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancemen
   m_prepared = m_packed = false;
   if (!enhancement)
     return Prepare(base, nullptr, metadata, geometry, allowPacked);
+  // (the import of the layer clears them too, without a word)
+  TakeStaleGLErrors("a picture is prepared");
   dvbridge_dmabuf imported{};
   if (!dvbridge_dmabuf_import(&imported, enhancement))
   {
@@ -453,6 +492,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
     logging.log_level = PL_LOG_WARN;
     m_log = pl_log_create(PL_API_VER, &logging);
   }
+  TakeStaleGLErrors("libplacebo is set up");
   m_gl = pl_opengl_create(m_log, &params);
   if (!m_gl)
     return Fail("libplacebo-opengl");
@@ -492,6 +532,7 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
   }
   // Kodi goes on drawing its frame after this (the GUI over the video).
   const CKeptGLState kept;
+  TakeStaleGLErrors("a picture is reconstructed");
   dvbridge_gl_frame bl{}, el{};
   if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes))
   {
@@ -648,7 +689,10 @@ bool CDVBridgeGLES::Presented(bool success)
     m_failures.Reset();
   }
   if (!committed)
+  {
+    TakeStaleGLErrors("the renderer is reset after a frame that was not shown");
     dvbridge_renderer_reset(m_renderer);
+  }
   m_prepared = m_packed = false;
   m_direct = false;
   return committed;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 1a5c64b..f7d8e75 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -121,7 +121,11 @@ public:
 private:
   bool Fail(const char* stage);
   void LogEarlyMask(bool packed);
+  //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
+  //! \param before what runs next, for the log
+  void TakeStaleGLErrors(const char* before);
   DVBRIDGE::DiagnosticFailures m_failures;
+  unsigned int m_staleGLErrors = 0; //!< times that TakeStaleGLErrors() found some
   bool m_reportedFrame{false};
   // All methods, including destruction, require the owning GL context/thread.
   pl_log m_log = nullptr; //!< libplacebo's warnings and errors, into Kodi's log
-- 
