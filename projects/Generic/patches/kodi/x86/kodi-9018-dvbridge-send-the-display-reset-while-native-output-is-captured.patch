From c979a41fa2baf1e72ab90b3ebc0d469ab5db6b09 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 07:31:24 +0000
Subject: [PATCH] dvbridge: send the display reset while native output is
 captured

Every mode switch calls OnLostDevice(): VideoPlayer pauses its players
and the clock, flushes the renderer keeping its buffers, and the audio
engine closes the HDMI sink until the display is reset. The reset is
sent by PresentRender() once the configured delay has passed, but the
Dolby Vision branch of PresentRender() returned before that point.

When the mode changed while a Dolby Vision renderer was configured (the
refresh-rate adjustment after the first picture, a GUI resolution
change, "adjust refresh rate: always" when leaving fullscreen), the
kept frame was drawn again, native output was captured again before the
next present, and from then on the reset was never sent: the picture
stayed frozen without audio until playback was stopped.

Send the reset from both branches. The Dolby Vision branch also waits
10 ms when nothing was prepared in the pass, as the ordinary branch
does, instead of spinning without a buffer swap to pace the loop.
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 15 +++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  4 ++++
 2 files changed, 19 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 25a78f8..ffb4f25 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -230,6 +230,16 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         LogDVStats("last 10 s");
       DVBridgeFrameShown(presented, m_dvFramePts);
     }
+    else
+    {
+      // Nothing was prepared this pass (before the first frame, after a flush): no buffer swap
+      // paces the loop, so wait as the ordinary path does when nothing is rendered.
+      KODI::TIME::Sleep(10ms);
+    }
+    // A mode switch while native output is captured (refresh-rate adjustment, GUI resolution)
+    // must still tell VideoPlayer and the audio engine that the display is back, or playback
+    // stays paused by OnLostDisplay().
+    SendDisplayReset();
     return;
   }
 #endif
@@ -277,6 +287,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     KODI::TIME::Sleep(10ms);
   }
 
+  SendDisplayReset();
+}
+
+void CWinSystemGbmGLESContext::SendDisplayReset()
+{
   if (m_dispReset && m_dispResetTimer.IsTimePast())
   {
     m_dispReset = false;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 8c51453..71235e4 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -96,6 +96,10 @@ protected:
 #endif
 
 private:
+  //! Tell the display resources (VideoPlayer, audio engine) that the display is back after a
+  //! mode switch, once the configured delay has passed.
+  void SendDisplayReset();
+
   bool m_guiCompositing{false};
   CFrameBufferObject m_guiFbo;
   int m_guiFboWidth{0};
-- 
