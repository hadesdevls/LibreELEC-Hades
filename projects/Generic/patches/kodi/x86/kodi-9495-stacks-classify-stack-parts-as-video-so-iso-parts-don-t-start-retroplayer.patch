From 3a40dbe578f193d3a410422fef9059147b3e1947 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sat, 17 Oct 2026 22:27:22 +0100
Subject: [PATCH] [Stacks] Classify stack parts as video so .iso parts don't
 start RetroPlayer.

The first part of a stack reaches the player without a video tag, unlike
a single file which gets one in GetOptionsAndUpdateItem(). IsGame() then
falls back to the extension and, since RetroPlayer is now forced for
games, a stack of .iso files claimed by an emulator asks for a game
client instead of playing.

Fixes #29924
---
 xbmc/application/ApplicationStackHelper.cpp |  3 +++
 xbmc/video/test/TestStacks.cpp              | 24 +++++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/xbmc/application/ApplicationStackHelper.cpp b/xbmc/application/ApplicationStackHelper.cpp
index d720a9e..d0636fe 100644
--- a/xbmc/application/ApplicationStackHelper.cpp
+++ b/xbmc/application/ApplicationStackHelper.cpp
@@ -75,6 +75,9 @@ bool CApplicationStackHelper::InitializeStack(const CFileItem& item)
   const auto stack{std::make_shared<CFileItem>(item)};
   for (int i = 0; const auto& file : m_originalStackItems)
   {
+    // This adds a blank VideoInfoTag, if none exists, to avoid mis-identification as a game
+    file->GetVideoInfoTag();
+
     const std::string& path{file->GetPath()};
     const auto& part{GetOrCreateStackPartInformation(path)};
     part->stackItem = stack;
diff --git a/xbmc/video/test/TestStacks.cpp b/xbmc/video/test/TestStacks.cpp
index 0da248f..df4c9ff 100644
--- a/xbmc/video/test/TestStacks.cpp
+++ b/xbmc/video/test/TestStacks.cpp
@@ -10,6 +10,8 @@
 #include "FileItemList.h"
 #include "ServiceBroker.h"
 #include "URL.h"
+#include "application/ApplicationStackHelper.h"
+#include "cores/IPlayer.h"
 #include "filesystem/Directory.h"
 #include "filesystem/StackDirectory.h"
 #include "settings/AdvancedSettings.h"
@@ -109,6 +111,28 @@ TEST_F(TestStacks, TestMovieFilesStackDvdIso)
   }
 }
 
+TEST_F(TestStacks, TestStackPartToPlayIsVideo)
+{
+  // A part without a video tag would be classified by its extension, which a
+  // game client may claim (eg. .iso), and then played by RetroPlayer.
+  const std::string movieFolder =
+      XBMC_REF_FILE_PATH("xbmc/video/test/testdata/moviestack_dvdiso/Movie_(2001)");
+  CFileItemList items;
+  CDirectory::GetDirectory(movieFolder, items, VIDEO_EXTENSIONS, DIR_FLAG_DEFAULTS);
+  items.Stack();
+  ASSERT_EQ(items.Size(), 1);
+  ASSERT_TRUE(items.Get(0)->IsStack());
+
+  CApplicationStackHelper stackHelper;
+  ASSERT_TRUE(stackHelper.InitializeStack(*items.Get(0)));
+
+  CFileItem part{*items.Get(0)};
+  CPlayerOptions options;
+  stackHelper.GetStackPartAndOptions(part, options, true);
+  EXPECT_FALSE(part.IsStack());
+  EXPECT_TRUE(part.HasVideoInfoTag());
+}
+
 TEST_F(TestStacks, TestMovieFilesStackBlurayIso)
 {
   const std::string movieFolder =
