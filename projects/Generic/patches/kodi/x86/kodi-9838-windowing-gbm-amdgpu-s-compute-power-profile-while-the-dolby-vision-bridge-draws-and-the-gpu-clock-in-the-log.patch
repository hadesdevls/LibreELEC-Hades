+namespace GBM
+{
+/*!
+ * \brief The power profile of an amdgpu GPU while the Dolby Vision bridge draws with it, and its
+ * clock, for the log
+ *
+ * The bridge's frames are short bursts of GPU work, one per refresh period: the power management
+ * of amdgpu, which raises the clock on the GPU's sustained activity, can keep it low while each
+ * frame takes most of its period (idea and measurement on a Vega 8 by big-fella, dv-engine-vk
+ * 0.1.0-9, taken up by YBLOD; written again here). The COMPUTE profile is the driver's own answer
+ * to that kind of load. What is drawn does not change: the same bytes, at another clock.
+ *
+ * What amdgpu gives (Linux 7.3, drivers/gpu/drm/amd/pm), and what is done with it:
+ * - pp_power_profile_mode exists only where the driver can set a profile (amdgpu_pm.c: an
+ *   attribute whose get gives -EOPNOTSUPP is not made). The profile marked with '*' is, with the
+ *   SMU driver of newer GPUs (swsmu), the user's preference (smu->power_profile_mode), which a
+ *   write keeps until another write changes it: back to the performance level "auto" does not
+ *   take it away (amdgpu_smu.c, smu_set_power_profile_mode(): a reference counted per profile).
+ *   So the preference that was there is written back, which puts COMPUTE's count back to 0 and
+ *   that profile's back to 1, as they were. With the older powerplay driver (Raven, Polaris,
+ *   Vega 10 and 20) the profile can only be set at the performance level "manual"
+ *   (amd_powerplay.c, pp_set_power_profile_mode()), and the '*' is the profile applied, which the
+ *   driver chooses from the work that is running (the video decoder asks for VIDEO): there,
+ *   "manual" and COMPUTE, and "auto" again, which applies the driver's own choice again
+ *   (pp_psm.c, psm_adjust_power_state_dynamic()). Which of the two it is is asked without
+ *   changing anything: the profile marked is written again, which swsmu takes as nothing to do and
+ *   powerplay refuses (EINVAL) outside "manual".
+ * - Nothing is touched where someone else made a choice: a performance level that is not "auto",
+ *   or (swsmu) a preference that is not BOOTUP_DEFAULT, the one the driver starts with. At the
+ *   end, what was set is undone only if it is still what was set.
+ * - GPUs whose driver has no profiles (Raphael, Phoenix, Rembrandt, Strix: smu_v13_0_5,
+ *   smu_v13_0_4, yellow_carp, smu_v14_0_0): only an option of advancedsettings.xml, off by
+ *   default, holds the clock at its highest level ("high") while the bridge draws: more power
+ *   used, which is the user's choice (video/dvgpuforcehigh).
+ * - A Kodi that ends without undoing it (a crash, SIGKILL) leaves a record in /run, which the
+ *   next Kodi reads when it starts: what the record says was set is undone there, if it is still
+ *   so. /run is in memory: a restart of the system starts the GPU again as its driver sets it.
+ * - Fail closed: a write that the driver refuses undoes what was done, and nothing more is tried
+ *   until Kodi is started again.
+ * - The clock, while the bridge draws, once a second: average_gfxclk_frequency of gpu_metrics
+ *   (the firmware's own average; its place in each version of the table as
+ *   kgd_pp_interface.h has it), or else the level marked '*' in pp_dpm_sclk. Its average over
+ *   10 s goes into the line of the bridge of every 10 s.
+ *
+ * Reading and writing these files can wait for the SMU firmware: it is all done by a thread of
+ * its own, which the drawing thread never waits for. That thread sleeps without a time limit
+ * outside a session of frames, and wakes once a second during one, to read the clock and to see
+ * whether the frames stopped (3 s after the last one, or when the video ends).
+ */
+namespace GPUPOWER
+{
+constexpr int PROFILE_BOOTUP_DEFAULT = 0; //!< PP_SMC_POWER_PROFILE_BOOTUP_DEFAULT
+constexpr int PROFILE_COMPUTE = 5; //!< PP_SMC_POWER_PROFILE_COMPUTE
+constexpr int PROFILE_CUSTOM = 6; //!< PP_SMC_POWER_PROFILE_CUSTOM
+
+//! The names that amdgpu gives the profiles, by their number (amdgpu_pm.c, amdgpu_pp_profile_name)
+inline const char* ProfileName(int index)
+{
+  static const char* const names[] = {"BOOTUP_DEFAULT", "3D_FULL_SCREEN", "POWER_SAVING", "VIDEO",
+                                      "VR", "COMPUTE", "CUSTOM", "WINDOW_3D", "CAPPED", "UNCAPPED"};
+  return index >= 0 && index < static_cast<int>(sizeof(names) / sizeof(names[0])) ? names[index]
+                                                                                   : nullptr;
+}
+
+//! What pp_power_profile_mode lists
+struct Profiles
+{
+  std::map<int, std::string> listed; //!< the profiles of the table, by their number
+  std::optional<int> active; //!< the one marked '*'
+  bool Has(int index) const { return listed.count(index) != 0; }
+};
+
+/*!
+ * \brief The profiles of pp_power_profile_mode. Its lines differ by driver (a header or none,
+ * settings after a ':' or on lines of their own), but each profile's line begins with its number
+ * and its name, with '*' after the name for the one marked: "  5        COMPUTE*", "  5
+ * COMPUTE *: ...", "5 COMPUTE*:". A line that does not begin so (a header, the lines of
+ * settings of navi10 and later, "   0(       GFXCLK) ...") is not a profile's.
+ */
+inline Profiles ParseProfiles(const std::string& text)
+{
+  Profiles profiles;
+  size_t at = 0;
+  while (at < text.size())
+  {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos)
+      end = text.size();
+    const std::string line = text.substr(at, end - at);
+    at = end + 1;
+    size_t i = line.find_first_not_of(' ');
+    if (i == std::string::npos || !std::isdigit(static_cast<unsigned char>(line[i])))
+      continue;
+    int number = 0;
+    while (i < line.size() && std::isdigit(static_cast<unsigned char>(line[i])) && number < 1000)
+      number = number * 10 + (line[i++] - '0');
+    if (i >= line.size() || line[i] != ' ')
+      continue;
+    i = line.find_first_not_of(' ', i);
+    if (i == std::string::npos)
+      continue;
+    size_t nameEnd = i;
+    while (nameEnd < line.size() &&
+           (std::isupper(static_cast<unsigned char>(line[nameEnd])) ||
+            std::isdigit(static_cast<unsigned char>(line[nameEnd])) || line[nameEnd] == '_'))
+      ++nameEnd;
+    const std::string name = line.substr(i, nameEnd - i);
+    const char* known = ProfileName(number);
+    if (!known || name != known)
+      continue;
+    profiles.listed[number] = name;
+    const size_t after = line.find_first_not_of(' ', nameEnd);
+    if (after != std::string::npos && line[after] == '*' && !profiles.active)
+      profiles.active = number;
+  }
+  return profiles;
+}
+
+//! A text without the spaces and ends of line around it
+inline std::string Trim(const std::string& text)
+{
+  const size_t first = text.find_first_not_of(" \t\n");
+  if (first == std::string::npos)
+    return {};
+  const size_t last = text.find_last_not_of(" \t\n");
+  return text.substr(first, last - first + 1);
+}
+
+/*!
+ * \brief The clock of the level marked '*' in pp_dpm_sclk ("1: 1200Mhz *", "S: 25Mhz *"), in MHz
+ */
+inline std::optional<unsigned int> MarkedSclk(const std::string& text)
+{
+  size_t at = 0;
+  while (at < text.size())
+  {
+    size_t end = text.find('\n', at);
+    if (end == std::string::npos)
+      end = text.size();
+    const std::string line = Trim(text.substr(at, end - at));
+    at = end + 1;
+    if (line.empty() || line.back() != '*')
+      continue;
+    const size_t colon = line.find(':');
+    if (colon == std::string::npos)
+      continue;
+    size_t i = line.find_first_not_of(' ', colon + 1);
+    if (i == std::string::npos || !std::isdigit(static_cast<unsigned char>(line[i])))
+      continue;
+    unsigned long value = 0;
+    while (i < line.size() && std::isdigit(static_cast<unsigned char>(line[i])) && value < 100000)
+      value = value * 10 + static_cast<unsigned long>(line[i++] - '0');
+    if (line.compare(i, 3, "Mhz") != 0 && line.compare(i, 3, "MHz") != 0)
+      continue;
+    if (value == 0 || value >= 100000)
+      continue;
+    return static_cast<unsigned int>(value);
+  }
+  return std::nullopt;
+}
+
+//! Where average_gfxclk_frequency is in a version of gpu_metrics: the size of the table and the
+//! place of the field, as kgd_pp_interface.h of Linux 7.3 has them (x86-64)
+struct MetricsLayout
+{
+  uint8_t format;
+  uint8_t content;
+  uint16_t size;
+  uint16_t gfxclk;
+};
+
+inline const std::vector<MetricsLayout>& MetricsLayouts()
+{
+  // (versions 1.4 to 1.9, those of MI300 and later, have no average of the graphics clock; they
+  // go by pp_dpm_sclk)
+  static const std::vector<MetricsLayout> layouts = {
+      {1, 0, 80, 40},  {1, 1, 96, 40},  {1, 2, 104, 40}, {1, 3, 120, 40}, {2, 0, 120, 68},
+      {2, 1, 120, 64}, {2, 2, 128, 64}, {2, 3, 152, 64}, {2, 4, 168, 64}, {3, 0, 264, 174}};
+  return layouts;
+}
+
+/*!
+ * \brief average_gfxclk_frequency of the content of gpu_metrics, in MHz; none where the version
+ * is not one known here, the table is not whole, or the driver did not fill the field (0xFFFF,
+ * smu_cmn_init_soft_gpu_metrics())
+ */
+inline std::optional<unsigned int> MetricsGfxclk(const std::string& bytes, std::string& how)
+{
+  if (bytes.size() < 4)
+  {
+    how = "gpu_metrics gave no table";
+    return std::nullopt;
+  }
+  const auto byte = [&bytes](size_t i) { return static_cast<unsigned int>(static_cast<uint8_t>(bytes[i])); };
+  const unsigned int size = byte(0) | (byte(1) << 8);
+  const unsigned int format = byte(2);
+  const unsigned int content = byte(3);
+  how = "gpu_metrics v" + std::to_string(format) + "." + std::to_string(content);
+  for (const auto& layout : MetricsLayouts())
+  {
+    if (layout.format != format || layout.content != content)
+      continue;
+    if (size != layout.size || bytes.size() < layout.size)
+    {
+      how += " has a size that is not its version's";
+      return std::nullopt;
+    }
+    const unsigned int mhz = byte(layout.gfxclk) | (byte(layout.gfxclk + 1u) << 8);
+    if (mhz == 0 || mhz == 0xFFFF)
+    {
+      how += " gives no average_gfxclk_frequency";
+      return std::nullopt;
+    }
+    how += " average_gfxclk_frequency";
+    return mhz;
+  }
+  how += " is not a version known here";
+  return std::nullopt;
+}
+
+//! The calls to the files of sysfs and /run, apart for a test
+struct Files
+{
+  //! The text of a small file; none when it cannot be read
+  std::function<std::optional<std::string>(const std::string& path)> read;
+  //! Writes a value to a sysfs attribute in one write: 0, or the errno
+  std::function<int(const std::string& path, const std::string& value)> write;
+  std::function<bool(const std::string& path)> exists;
+  //! The real path of a path (the PCI device of a DRM node)
+  std::function<std::optional<std::string>(const std::string& path)> realPath;
+  //! The last part of what a symbolic link points to (the name of a device's driver)
+  std::function<std::optional<std::string>(const std::string& link)> linkName;
+  //! Writes a whole file, made aside and renamed into place: false when it could not
+  std::function<bool(const std::string& path, const std::string& text)> replace;
+  std::function<void(const std::string& path)> remove;
+
+  static Files System()
+  {
+    Files files;
+    files.read = [](const std::string& path) -> std::optional<std::string> {
+      const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+        return std::nullopt;
+      std::string text;
+      char buffer[4096];
+      for (;;)
+      {
+        const ssize_t length = ::read(fd, buffer, sizeof(buffer));
+        if (length < 0 && errno == EINTR)
+          continue;
+        if (length < 0)
+        {
+          ::close(fd);
+          return std::nullopt;
+        }
+        if (length == 0 || text.size() > 65536)
+          break;
+        text.append(buffer, static_cast<size_t>(length));
+      }
+      ::close(fd);
+      return text;
+    };
+    files.write = [](const std::string& path, const std::string& value) {
+      const int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC);
+      if (fd < 0)
+        return errno ? errno : EIO;
+      ssize_t length;
+      do
+        length = ::write(fd, value.data(), value.size());
+      while (length < 0 && errno == EINTR);
+      const int error = length < 0 ? (errno ? errno : EIO)
+                                   : (static_cast<size_t>(length) == value.size() ? 0 : EIO);
+      ::close(fd);
+      return error;
+    };
+    files.exists = [](const std::string& path) { return access(path.c_str(), F_OK) == 0; };
+    files.realPath = [](const std::string& path) -> std::optional<std::string> {
+      char real[PATH_MAX];
+      if (!realpath(path.c_str(), real))
+        return std::nullopt;
+      return std::string(real);
+    };
+    files.linkName = [](const std::string& link) -> std::optional<std::string> {
+      char target[PATH_MAX];
+      const ssize_t length = readlink(link.c_str(), target, sizeof(target) - 1);
+      if (length <= 0)
+        return std::nullopt;
+      target[length] = '\0';
+      const std::string text(target);
+      const size_t slash = text.rfind('/');
+      return slash == std::string::npos ? text : text.substr(slash + 1);
+    };
+    files.replace = [](const std::string& path, const std::string& text) {
+      const std::string aside = path + ".new";
+      const int fd = open(aside.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+      if (fd < 0)
+        return false;
+      ssize_t length;
+      do
+        length = ::write(fd, text.data(), text.size());
+      while (length < 0 && errno == EINTR);
+      const bool whole = length == static_cast<ssize_t>(text.size());
+      ::close(fd);
+      if (!whole || rename(aside.c_str(), path.c_str()) != 0)
+      {
+        unlink(aside.c_str());
+        return false;
+      }
+      return true;
+    };
+    files.remove = [](const std::string& path) { unlink(path.c_str()); };
+    return files;
+  }
+};
+
+//! What is wanted, as advancedsettings.xml says when a session begins
+struct Wanted
+{
+  bool profile{true}; //!< COMPUTE where the driver has profiles (video/dvgpuprofile)
+  bool forceHigh{false}; //!< "high" where it has none (video/dvgpuforcehigh)
+};
+
+//! What was set, to be undone
+enum class Kind
+{
+  NONE,
+  SWSMU, //!< the preference COMPUTE written over the one that was there
+  POWERPLAY, //!< "manual" and COMPUTE, over "auto"
+  HIGH, //!< "high" over "auto", where there are no profiles
+};
+
+inline const char* KindName(Kind kind)
+{
+  switch (kind)
+  {
+    case Kind::SWSMU:
+      return "swsmu";
+    case Kind::POWERPLAY:
+      return "powerplay";
+    case Kind::HIGH:
+      return "high";
+    default:
+      return "none";
+  }
+}
+
+/*!
+ * \brief What is set and undone, without a thread of its own: each call reads and writes the
+ * files there and then, and gives back what it did for the log
+ */
+class CController
+{
+public:
+  struct Options
+  {
+    std::string root; //!< where /sys is ("" on the system; a tree of its own in a test)
+    std::string record{"/run/hades-gpu-profile"};
+  };
+  //! A line for the log
+  struct Line
+  {
+    bool warning{false};
+    std::string text;
+  };
+
+  CController(Files files, Options options) : m_files(std::move(files)), m_options(std::move(options)) {}
+
+  /*!
+   * \brief The GPU of a DRM device number: true for amdgpu, whose files are then used; false for
+   * any other driver (nothing is done there, and nothing logged)
+   */
+  bool Open(dev_t node)
+  {
+    const std::string link = m_options.root + "/sys/dev/char/" + std::to_string(major(node)) + ":" +
+                             std::to_string(minor(node)) + "/device";
+    const auto device = m_files.realPath(link);
+    if (!device)
+      return false;
+    const auto driver = m_files.linkName(*device + "/driver");
+    if (!driver || *driver != "amdgpu")
+      return false;
+    m_device = *device;
+    const size_t slash = m_device.rfind('/');
+    m_name = "amdgpu " + (slash == std::string::npos ? m_device : m_device.substr(slash + 1));
+    return true;
+  }
+  bool Opened() const { return !m_device.empty(); }
+  const std::string& Name() const { return m_name; }
+  bool Disabled() const { return m_disabled; }
+  Kind Set() const { return m_set; }
+  //! The profile that was there, for the line of the end
+  int Previous() const { return m_previous; }
+
+  /*!
+   * \brief A session of frames begins: COMPUTE (or "high") where it may be set. Lines that say
+   * why nothing was set are given once for each reason, not at every session.
+   */
+  std::vector<Line> Begin(const Wanted& wanted)
+  {
+    std::vector<Line> lines;
+    if (!Opened() || m_disabled || m_set != Kind::NONE)
+      return lines;
+    const auto levelText = m_files.read(Path(LEVEL));
+    if (!levelText)
+    {
+      Once(lines, "level-unreadable",
+           "its performance level (power_dpm_force_performance_level) cannot be read: the power "
+           "management is left as the driver sets it");
+      return lines;
+    }
+    const std::string level = Trim(*levelText);
+    const bool hasProfiles = m_files.exists(Path(PROFILE));
+    if (hasProfiles && wanted.profile)
+      BeginProfile(level, lines);
+    else if (hasProfiles)
+      Once(lines, "profile-off",
+           "the power profile is left as the driver sets it, as advancedsettings.xml asks "
+           "(video/dvgpuprofile)");
+    else if (wanted.forceHigh)
+      BeginHigh(level, lines);
+    else
+      Once(lines, "no-profiles",
+           "this GPU's driver has no power profiles (no pp_power_profile_mode): its clock is left "
+           "as the driver sets it; <video><dvgpuforcehigh>true</dvgpuforcehigh></video> holds it "
+           "at its highest level while the bridge draws (more power used)");
+    return lines;
+  }
+
+  //! The session ends: what was set is undone, if it is still so
+  std::vector<Line> End()
+  {
+    std::vector<Line> lines;
+    if (m_set == Kind::NONE)
+      return lines;
+    const Kind kind = m_set;
+    m_set = Kind::NONE;
+    Undo(kind, m_device, m_previous, "", lines);
+    return lines;
+  }
+
+  /*!
+   * \brief What a Kodi that ended without undoing it set, from its record: undone if it is still
+   * so. The record is removed (one whose undoing the driver refused is kept, for the next start).
+   */
+  std::vector<Line> RestoreRecord()
+  {
+    std::vector<Line> lines;
+    const auto text = m_files.read(m_options.record);
+    if (!text)
+      return lines;
+    std::string device;
+    std::string kindName;
+    int previous = -1;
+    size_t at = 0;
+    while (at < text->size())
+    {
+      size_t end = text->find('\n', at);
+      if (end == std::string::npos)
+        end = text->size();
+      const std::string line = text->substr(at, end - at);
+      at = end + 1;
+      const size_t equals = line.find('=');
+      if (equals == std::string::npos)
+        continue;
+      const std::string key = line.substr(0, equals);
+      const std::string value = line.substr(equals + 1);
+      if (key == "device")
+        device = value;
+      else if (key == "kind")
+        kindName = value;
+      else if (key == "profile" && value.size() == 1 && std::isdigit(static_cast<unsigned char>(value[0])))
+        previous = value[0] - '0';
+    }
+    Kind kind = Kind::NONE;
+    if (kindName == "swsmu" && previous >= 0)
+      kind = Kind::SWSMU;
+    else if (kindName == "powerplay")
+      kind = Kind::POWERPLAY;
+    else if (kindName == "high")
+      kind = Kind::HIGH;
+    // only a device of amdgpu in sysfs (the record is Kodi's own, in /run, written by root)
+    const auto driver =
+        device.empty() ? std::nullopt : m_files.linkName(m_options.root + device + "/driver");
+    if (kind == Kind::NONE || !driver || *driver != "amdgpu")
+    {
+      m_files.remove(m_options.record);
+      if (kind != Kind::NONE || !device.empty())
+        lines.push_back({false, "DVBridge: a record of a GPU power profile in " + m_options.record +
+                                    " that names no GPU of amdgpu now: removed"});
+      return lines;
+    }
+    const size_t slash = device.rfind('/');
+    const std::string name = "amdgpu " + (slash == std::string::npos ? device : device.substr(slash + 1));
+    Undo(kind, m_options.root + device, previous,
+         " (set by a Kodi that ended without undoing it, as its record in " + m_options.record +
+             " says)",
+         lines, name);
+    return lines;
+  }
+
+  //! The clock of the GPU now, in MHz, and where it was read from
+  std::optional<unsigned int> ReadClock(std::string& how)
+  {
+    if (!Opened())
+      return std::nullopt;
+    std::string metricsHow;
+    if (const auto bytes = m_files.read(Path("gpu_metrics")))
+    {
+      if (const auto mhz = MetricsGfxclk(*bytes, metricsHow))
+      {
+        how = metricsHow;
+        return mhz;
+      }
+    }
+    else
+      metricsHow = "no gpu_metrics";
+    if (const auto text = m_files.read(Path("pp_dpm_sclk")))
+      if (const auto mhz = MarkedSclk(*text))
+      {
+        how = "the level marked in pp_dpm_sclk (" + metricsHow + ")";
+        return mhz;
+      }
+    how = metricsHow + ", and no level marked in pp_dpm_sclk";
+    return std::nullopt;
+  }
+
+private:
+  static constexpr const char* LEVEL = "power_dpm_force_performance_level";
+  static constexpr const char* PROFILE = "pp_power_profile_mode";
+
+  std::string Path(const char* name) const { return m_device + "/" + name; }
+
+  void Once(std::vector<Line>& lines, const std::string& reason, const std::string& text)
+  {
+    if (m_told.count(reason))
+      return;
+    m_told[reason] = true;
+    lines.push_back({false, "DVBridge: " + m_name + ": " + text});
+  }
+
+  //! Off until Kodi is started again, after something the driver refused
+  void Fail(std::vector<Line>& lines, const std::string& text)
+  {
+    m_disabled = true;
+    lines.push_back({true, "DVBridge: " + m_name + ": " + text +
+                               ": the power profile is not set again until Kodi is started again"});
+  }
+
+  bool Record(Kind kind, int previous)
+  {
+    // (the device as sysfs names it: without the root of a test)
+    const bool rooted = m_device.compare(0, m_options.root.size(), m_options.root) == 0;
+    std::string text = "device=" + (rooted ? m_device.substr(m_options.root.size()) : m_device) +
+                       "\nkind=" + KindName(kind) + "\n";
+    if (kind == Kind::SWSMU)
+      text += "profile=" + std::to_string(previous) + "\n";
+    text += "level=auto\n";
+    return m_files.replace(m_options.record, text);
+  }
+
+  std::string ProfileText(const Profiles& profiles, int index) const
+  {
+    const auto found = profiles.listed.find(index);
+    return found != profiles.listed.end() ? found->second : std::to_string(index);
+  }
+
+  void BeginProfile(const std::string& level, std::vector<Line>& lines)
+  {
+    if (level != "auto")
+    {
+      Once(lines, "level-" + level,
+           "the power profile is left as it is: the performance level is \"" + level +
+               "\", which someone else set");
+      return;
+    }
+    const auto text = m_files.read(Path(PROFILE));
+    const Profiles profiles = text ? ParseProfiles(*text) : Profiles{};
+    if (!profiles.Has(PROFILE_COMPUTE))
+    {
+      Once(lines, "no-compute",
+           "the power profile is left as it is: its driver lists no COMPUTE profile");
+      return;
+    }
+    if (!profiles.active)
+    {
+      Once(lines, "no-active",
+           "the power profile is left as it is: pp_power_profile_mode marks no profile");
+      return;
+    }
+    const int active = *profiles.active;
+    if (active == PROFILE_COMPUTE || active == PROFILE_CUSTOM)
+    {
+      Once(lines, "active-" + std::to_string(active),
+           "the power profile is left as it is: " + ProfileText(profiles, active) +
+               " is set, which someone else chose");
+      return;
+    }
+    // Which driver it is, without changing anything: swsmu takes the profile it has as nothing to
+    // do, powerplay refuses any profile outside "manual" (EINVAL)
+    const int probe = m_files.write(Path(PROFILE), std::to_string(active));
+    if (probe == 0)
+    {
+      if (active != PROFILE_BOOTUP_DEFAULT)
+      {
+        Once(lines, "preference-" + std::to_string(active),
+             "the power profile is left as it is: " + ProfileText(profiles, active) +
+                 " is set, which someone else chose");
+        return;
+      }
+      // the record before the change: a Kodi that ends right after it still has it undone
+      if (!Record(Kind::SWSMU, active))
+      {
+        Once(lines, "no-record",
+             "the power profile is left as it is: there is no record of it to be kept in " +
+                 m_options.record);
+        return;
+      }
+      if (const int error = m_files.write(Path(PROFILE), std::to_string(PROFILE_COMPUTE)))
+      {
+        m_files.remove(m_options.record);
+        Fail(lines, "the driver refused the COMPUTE profile (" + std::string(std::strerror(error)) + ")");
+        return;
+      }
+      const auto after = m_files.read(Path(PROFILE));
+      if (!after || ParseProfiles(*after).active != PROFILE_COMPUTE)
+      {
+        m_files.write(Path(PROFILE), std::to_string(active));
+        m_files.remove(m_options.record);
+        Fail(lines, "the COMPUTE profile was written but is not the one marked: written back");
+        return;
+      }
+      m_set = Kind::SWSMU;
+      m_previous = active;
+      m_since = std::chrono::steady_clock::now();
+      lines.push_back({false, "DVBridge: GPU power profile COMPUTE on " + m_name +
+                                  " while the bridge draws (it was " + ProfileText(profiles, active) +
+                                  ", the performance level auto; swsmu): the same pictures, at a "
+                                  "higher clock (video/dvgpuprofile)"});
+      return;
+    }
+    if (probe != EINVAL)
+    {
+      Fail(lines, "the driver refused the profile it has (" + std::string(std::strerror(probe)) + ")");
+      return;
+    }
+    if (!Record(Kind::POWERPLAY, -1))
+    {
+      Once(lines, "no-record",
+           "the power profile is left as it is: there is no record of it to be kept in " +
+               m_options.record);
+      return;
+    }
+    if (const int error = m_files.write(Path(LEVEL), "manual"))
+    {
+      m_files.remove(m_options.record);
+      Fail(lines, "the driver refused the performance level manual (" +
+                      std::string(std::strerror(error)) + ")");
+      return;
+    }
+    if (const int error = m_files.write(Path(PROFILE), std::to_string(PROFILE_COMPUTE)))
+    {
+      m_files.write(Path(LEVEL), "auto");
+      m_files.remove(m_options.record);
+      Fail(lines, "the driver refused the COMPUTE profile at the performance level manual (" +
+                      std::string(std::strerror(error)) + "): back to auto");
+      return;
+    }
+    const auto levelAfter = m_files.read(Path(LEVEL));
+    const auto profileAfter = m_files.read(Path(PROFILE));
+    if (!levelAfter || Trim(*levelAfter) != "manual" || !profileAfter ||
+        ParseProfiles(*profileAfter).active != PROFILE_COMPUTE)
+    {
+      m_files.write(Path(LEVEL), "auto");
+      m_files.remove(m_options.record);
+      Fail(lines, "COMPUTE was written but is not what the driver says: back to auto");
+      return;
+    }
+    m_set = Kind::POWERPLAY;
+    m_previous = active;
+    m_since = std::chrono::steady_clock::now();
+    lines.push_back({false, "DVBridge: GPU power profile COMPUTE on " + m_name +
+                                " while the bridge draws (it was " + ProfileText(profiles, active) +
+                                " at the performance level auto, which this driver, powerplay, "
+                                "chooses from the work that runs; COMPUTE needs the level manual): "
+                                "the same pictures, at a higher clock (video/dvgpuprofile)"});
+  }
+
+  void BeginHigh(const std::string& level, std::vector<Line>& lines)
+  {
+    if (level != "auto")
+    {
+      Once(lines, "level-" + level,
+           "the performance level is left as it is: it is \"" + level + "\", which someone else set");
+      return;
+    }
+    if (!Record(Kind::HIGH, -1))
+    {
+      Once(lines, "no-record",
+           "the performance level is left as it is: there is no record of it to be kept in " +
+               m_options.record);
+      return;
+    }
+    if (const int error = m_files.write(Path(LEVEL), "high"))
+    {
+      m_files.remove(m_options.record);
+      Fail(lines, "the driver refused the performance level high (" + std::string(std::strerror(error)) + ")");
+      return;
+    }
+    const auto after = m_files.read(Path(LEVEL));
+    if (!after || Trim(*after) != "high")
+    {
+      m_files.write(Path(LEVEL), "auto");
+      m_files.remove(m_options.record);
+      Fail(lines, "the performance level high was written but is not what the driver says: back to auto");
+      return;
+    }
+    m_set = Kind::HIGH;
+    m_since = std::chrono::steady_clock::now();
+    lines.push_back({false, "DVBridge: GPU performance level high on " + m_name +
+                                " while the bridge draws (it was auto; the clock held at its highest "
+                                "level, more power used, as advancedsettings.xml asks: "
+                                "video/dvgpuforcehigh)"});
+  }
+
+  //! Undoes what was set on a device, if it is still so; the record goes once it is undone
+  void Undo(Kind kind,
+            const std::string& device,
+            int previous,
+            const std::string& why,
+            std::vector<Line>& lines,
+            const std::string& nameOverride = "")
+  {
+    const std::string name = nameOverride.empty() ? m_name : nameOverride;
+    const std::string level = device + "/" + LEVEL;
+    const std::string profile = device + "/" + PROFILE;
+    const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                             std::chrono::steady_clock::now() - m_since)
+                             .count();
+    const std::string after = why.empty() ? " after " + std::to_string(seconds) + " s" : why;
+    int error = 0;
+    std::string what;
+    std::string left;
+    if (kind == Kind::SWSMU)
+    {
+      const auto text = m_files.read(profile);
+      if (text && ParseProfiles(*text).active == PROFILE_COMPUTE)
+      {
+        error = m_files.write(profile, std::to_string(previous));
+        what = "GPU power profile of " + name + " back to " +
+               (ProfileName(previous) ? ProfileName(previous) : std::to_string(previous));
+      }
+      else
+        left = "GPU power profile of " + name + " left as it is: it is no longer COMPUTE";
+    }
+    else if (kind == Kind::POWERPLAY || kind == Kind::HIGH)
+    {
+      const std::string set = kind == Kind::POWERPLAY ? "manual" : "high";
+      const auto text = m_files.read(level);
+      if (text && Trim(*text) == set)
+      {
+        error = m_files.write(level, "auto");
+        what = (kind == Kind::POWERPLAY ? "GPU power profile of " + name +
+                                              " back to the driver's own (performance level auto)"
+                                        : "GPU performance level of " + name + " back to auto");
+      }
+      else
+        left = "GPU performance level of " + name + " left as it is: it is no longer " + set;
+    }
+    if (error)
+    {
+      lines.push_back({true, "DVBridge: " + what + after + " was refused by the driver (" +
+                                 std::strerror(error) + "): its record stays in " +
+                                 m_options.record + ", for the next start of Kodi"});
+      m_disabled = true;
+      return;
+    }
+    m_files.remove(m_options.record);
+    lines.push_back({false, "DVBridge: " + (what.empty() ? left : what + after)});
+  }
+
+  Files m_files;
+  Options m_options;
+  std::string m_device; //!< the PCI device in sysfs
+  std::string m_name; //!< "amdgpu 0000:03:00.0", for the log
+  Kind m_set{Kind::NONE};
+  int m_previous{-1};
+  bool m_disabled{false};
+  std::map<std::string, bool> m_told;
+  std::chrono::steady_clock::time_point m_since{};
+};
+
+//! What drew the frames of a session, for its own line of every 10 s
+enum class Drawing
+{
+  NATIVE, //!< native Dolby Vision output (its line of every 10 s takes the clock: TakeClockText())
+  CONVERSION, //!< Dolby Vision converted to HDR10 or SDR
+  MAPPING, //!< HDR mapped to SDR by the bridge
+};
+
+/*!
+ * \brief The power profile while the bridge draws, by a thread of its own that the drawing
+ * thread never waits for
+ *
+ * Drawn() with each frame that the bridge draws (not a picture kept on the screen or one that
+ * stands still), VideoEnded() when a video's output by the bridge ends, TakeClockText() from the
+ * line of every 10 s. The thread is made with the first frame (or at once, where a record of an
+ * earlier Kodi is to be undone) and ends with this object, after undoing what it set.
+ */
+class CGPUPowerProfile
+{
+public:
+  struct Config
+  {
+    Files files{Files::System()};
+    CController::Options options;
+    //! What is wanted, asked on the drawing thread with the first frame of each session
+    std::function<Wanted()> wanted;
+    //! A line for the log, from the thread of this object
+    std::function<void(bool warning, const std::string& line)> log;
+    std::chrono::milliseconds linger{3000}; //!< after the last frame, the end of a session
+    std::chrono::milliseconds sample{1000}; //!< between two readings of the clock
+    std::chrono::milliseconds window{10000}; //!< the span of the line of its own
+  };
+
+  CGPUPowerProfile(Config config, dev_t node)
+    : m_config(std::move(config)), m_controller(m_config.files, m_config.options), m_node(node)
+  {
+    if (m_config.files.exists(m_config.options.record))
+      Start(true);
+  }
+  ~CGPUPowerProfile()
+  {
+    {
+      std::unique_lock lock(m_lock);
+      m_stop = true;
+    }
+    m_wake.notify_all();
+    if (m_thread.joinable())
+      m_thread.join();
+  }
+  CGPUPowerProfile(const CGPUPowerProfile&) = delete;
+  CGPUPowerProfile& operator=(const CGPUPowerProfile&) = delete;
+
+  //! A frame that the bridge drew (never waits, but for a moment with the first of a session)
+  void Drawn(Drawing what)
+  {
+    if (m_other.load(std::memory_order_relaxed))
+      return;
+    m_last.store(std::chrono::steady_clock::now().time_since_epoch().count(),
+                 std::memory_order_relaxed);
+    m_drawing.store(static_cast<int>(what), std::memory_order_relaxed);
+    if (m_inSession.exchange(true))
+      return;
+    const Wanted wanted = m_config.wanted ? m_config.wanted() : Wanted{};
+    {
+      std::unique_lock lock(m_lock);
+      m_begin = true;
+      m_wantedNext = wanted;
+    }
+    Start(false);
+    m_wake.notify_all();
+  }
+
+  //! The output of a video by the bridge ended: the session too, without waiting for the 3 s
+  void VideoEnded()
+  {
+    if (!m_inSession.load())
+      return;
+    {
+      std::unique_lock lock(m_lock);
+      m_end = true;
+    }
+    m_wake.notify_all();
+  }
+
+  /*!
+   * \brief The clock since it was last taken, for the line of every 10 s ("; GPU clock ..."); empty
+   * where nothing was read (no amdgpu, or not yet). Never waits: empty if the thread holds it.
+   */
+  std::string TakeClockText()
+  {
+    std::unique_lock lock(m_clockLock, std::try_to_lock);
+    if (!lock.owns_lock() || !m_clock.opened)
+      return {};
+    std::string text = ClockText(m_clock);
+    m_clock.Reset();
+    return text.empty() ? text : "; " + text;
+  }
+
+private:
+  struct Clock
+  {
+    bool opened{false};
+    unsigned int readings{0};
+    unsigned long long sum{0};
+    unsigned int low{0};
+    unsigned int high{0};
+    unsigned int unread{0};
+    std::string how;
+    std::string set; //!< what is set, for the line
+    void Reset()
+    {
+      readings = 0;
+      sum = 0;
+      low = high = 0;
+      unread = 0;
+    }
+  };
+
+  static std::string ClockText(const Clock& clock)
+  {
+    if (clock.readings == 0 && clock.unread == 0)
+      return {};
+    std::string text;
+    if (clock.readings)
+      text = "GPU clock " + std::to_string((clock.sum + clock.readings / 2) / clock.readings) +
+             " MHz on average (" + std::to_string(clock.readings) + " readings of " + clock.how +
+             ", " + std::to_string(clock.low) + " to " + std::to_string(clock.high) + " MHz)";
+    else
+      text = "GPU clock not known (" + clock.how + ")";
+    return text + ", " + clock.set;
+  }
+
+  void Start(bool restore)
+  {
+    std::unique_lock lock(m_lock);
+    if (restore)
+      m_restore = true;
+    if (m_started)
+      return;
+    try
+    {
+      m_thread = std::thread(&CGPUPowerProfile::Run, this);
+      m_started = true;
+    }
+    catch (const std::system_error&)
+    {
+      // no thread: nothing is set (and nothing is left set)
+      m_other = true;
+    }
+  }
+
+  void Log(const std::vector<CController::Line>& lines)
+  {
+    if (!m_config.log)
+      return;
+    for (const auto& line : lines)
+      m_config.log(line.warning, line.text);
+  }
+
+  std::string SetText() const
+  {
+    switch (m_controller.Set())
+    {
+      case Kind::SWSMU:
+      case Kind::POWERPLAY:
+        return "power profile COMPUTE";
+      case Kind::HIGH:
+        return "performance level high";
+      default:
+        return "power management as the driver sets it";
+    }
+  }
+
+  void Run()
+  {
+    pthread_setname_np(pthread_self(), "GPUPower");
+    bool opened = false;
+    bool session = false;
+    auto lastSample = std::chrono::steady_clock::time_point{};
+    auto windowStart = std::chrono::steady_clock::time_point{};
+    for (;;)
+    {
+      bool stop;
+      bool begin;
+      bool end;
+      bool restore;
+      Wanted wanted;
+      {
+        std::unique_lock lock(m_lock);
+        const auto due = [this] { return m_stop || m_begin || m_end || m_restore; };
+        if (session)
+          m_wake.wait_for(lock, m_config.sample, due);
+        else
+          m_wake.wait(lock, due);
+        stop = m_stop;
+        begin = std::exchange(m_begin, false);
+        end = std::exchange(m_end, false);
+        restore = std::exchange(m_restore, false);
+        wanted = m_wantedNext;
+      }
+      if (restore)
+        Log(m_controller.RestoreRecord());
+      const auto now = std::chrono::steady_clock::now();
+      if (begin && !session && !stop)
+      {
+        if (!opened)
+        {
+          opened = true;
+          if (!m_controller.Open(m_node))
+          {
+            // not amdgpu: nothing is done for this GPU, and its frames are not looked at again
+            m_other = true;
+            m_inSession = false;
+            if (stop)
+              break;
+            continue;
+          }
+          std::unique_lock lock(m_clockLock);
+          m_clock.opened = true;
+        }
+        session = true;
+        // (a video whose end came as the frames of another began: the frames are what counts)
+        end = false;
+        windowStart = now;
+        lastSample = {};
+        Log(m_controller.Begin(wanted));
+        std::unique_lock lock(m_clockLock);
+        m_clock.Reset();
+        m_clock.set = SetText();
+      }
+      if (!session)
+      {
+        if (stop)
+          break;
+        continue;
+      }
+      if (now - lastSample >= m_config.sample - std::chrono::milliseconds(50) || stop || end)
+      {
+        lastSample = now;
+        std::string how;
+        const auto mhz = m_controller.ReadClock(how);
+        std::unique_lock lock(m_clockLock);
+        m_clock.how = how;
+        if (mhz)
+        {
+          m_clock.low = m_clock.readings ? std::min(m_clock.low, *mhz) : *mhz;
+          m_clock.high = m_clock.readings ? std::max(m_clock.high, *mhz) : *mhz;
+          m_clock.sum += *mhz;
+          m_clock.readings++;
+        }
+        else
+          m_clock.unread++;
+      }
+      const auto last = std::chrono::steady_clock::time_point(
+          std::chrono::steady_clock::duration(m_last.load(std::memory_order_relaxed)));
+      // Native output has a line of its own every 10 s, which takes the clock (TakeClockText(),
+      // also its last line, "until the end"); the frames of a conversion have this one
+      const int drawing = m_drawing.load(std::memory_order_relaxed);
+      const bool native = drawing == static_cast<int>(Drawing::NATIVE);
+      const char* what = drawing == static_cast<int>(Drawing::CONVERSION) ? "Dolby Vision converted"
+                                                                         : "HDR mapped to SDR";
+      if (stop || end || now - last >= m_config.linger)
+      {
+        std::string clock;
+        if (!native)
+        {
+          std::unique_lock lock(m_clockLock);
+          clock = ClockText(m_clock);
+          m_clock.Reset();
+        }
+        if (!clock.empty() && m_config.log)
+          m_config.log(false, std::string("DVBridge: the last pictures drawn by the bridge (") +
+                                  what + "): " + clock);
+        Log(m_controller.End());
+        session = false;
+        m_inSession = false;
+        if (stop)
+          break;
+        continue;
+      }
+      if (now - windowStart >= m_config.window)
+      {
+        windowStart = now;
+        std::string clock;
+        if (!native)
+        {
+          std::unique_lock lock(m_clockLock);
+          clock = ClockText(m_clock);
+          m_clock.Reset();
+        }
+        if (!clock.empty() && m_config.log)
+          m_config.log(false, std::string("DVBridge: last 10 s of pictures drawn by the bridge (") +
+                                  what + "): " + clock);
+      }
+    }
+  }
+
+  Config m_config;
+  CController m_controller;
+  dev_t m_node;
+  std::thread m_thread;
+  std::mutex m_lock;
+  std::condition_variable m_wake;
+  bool m_started{false};
+  bool m_stop{false};
+  bool m_begin{false};
+  bool m_end{false};
+  bool m_restore{false};
+  Wanted m_wantedNext;
+  std::atomic<bool> m_inSession{false};
+  std::atomic<bool> m_other{false}; //!< not amdgpu, or no thread: nothing to do
+  std::atomic<std::chrono::steady_clock::rep> m_last{0};
+  std::atomic<int> m_drawing{0};
+  std::mutex m_clockLock;
+  Clock m_clock;
+};
