+// Hades: a HEVC stream that no Dolby Vision record declares, whose packets bring no RPU, and whose HDR10+
+// metadata are to be sent as Dolby Vision (DVBRIDGE::Hdr10PlusAsDolbyVision(),
+// videoscreen.hadesdvfromhdr10plus): the first access unit that can make it so (CDVHdr10Plus) makes it Dolby
+// Vision of profile 8.1 from here on, and the decoder makes the metadata of each of its pictures from that
+// picture's own HDR10+ metadata. Anything else stays as it is.
+void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
+                                     int streamIdx,
+                                     const uint8_t* data,
+                                     int size,
+                                     unsigned int& probed,
+                                     unsigned int done)
+{
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  const CDVHdr10Plus::AccessUnit unit = CDVHdr10Plus::Read(
+      data, static_cast<size_t>(size), CDVLayerMerge::LengthSize(avStream->codecpar));
+  if (unit.t35.empty())
+    return;
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  const bool containerMastering =
+      video->masteringMetaData && video->masteringMetaData->has_luminance;
+  const CDVHdr10Plus::Verdict verdict =
+      CDVHdr10Plus::Judge(unit, avStream->codecpar, containerMastering);
+  if (verdict != CDVHdr10Plus::Verdict::HDR10PLUS)
+  {
+    // (the last access unit looked at, or one that says that it never will be: said once)
+    if (verdict != CDVHdr10Plus::Verdict::NOT_YET || probed >= done)
+    {
+      probed = done;
+      CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: stream {} has HDR10+ metadata; not as Dolby Vision: {}",
+                streamIdx, CDVHdr10Plus::Why(unit, avStream->codecpar, containerMastering));
+    }
+    return;
+  }
+  probed = done;
+  if (!DVBRIDGE::Hdr10PlusAsDolbyVision())
+  {
+    CLog::Log(LOGDEBUG,
+              "CDVDDemuxFFmpeg: stream {} has HDR10+ metadata; not sent as Dolby Vision (the setting "
+              "is off, or the display takes HDR10+, or no native Dolby Vision)",
+              streamIdx);
+    return;
+  }
+  AVDOVIDecoderConfigurationRecord record{};
+  const AVRational rate =
+      av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  if (!CDVHdr10Plus::Record(avStream->codecpar, rate, record))
+    return;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is HDR10+ without Dolby Vision: it is Dolby Vision profile 8.1 "
+            "from here on, with metadata made from its HDR10+ metadata (HDR10+ as Dolby Vision)",
+            streamIdx);
+  m_dvPromoted[streamIdx] = record;
+  m_dvFromHdr10Plus[streamIdx] = true;
+  video->doviFromHdr10Plus = true;
+  PromoteDolbyVision(stream, record, nullptr);
+}
