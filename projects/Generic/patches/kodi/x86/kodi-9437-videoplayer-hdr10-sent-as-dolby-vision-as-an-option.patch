 //! Native output can be had for the video that plays, in a mode that carries it (what AUTOMATIC
 //! then gives): for the player's video settings
 bool NativeOutputAvailable();
+//! Hades: whether an HDR10+ stream is sent as native Dolby Vision, with metadata made from its HDR10+
+//! metadata (videoscreen.hadesdvfromhdr10plus): the setting is on, the user chose no other output
+//! for the video, the display takes native Dolby Vision in a mode that carries it, and it is not sent
+//! HDR10+ (CHDRCapabilities::SupportsHDR10Plus()). Asked by the demuxer when a stream's packets bring
+//! HDR10+ metadata and no RPU (CDVHdr10Plus).
+bool Hdr10PlusAsDolbyVision();
+//! Hades: what Hdr10PlusAsDolbyVision() decides on what it reads: never for a display that is sent
+//! HDR10+ (it declares HDR10+ and its driver sends the metadata of each frame,
+//! CWinSystemGbm::GetDisplayHDRCapabilities()), which keeps the video's own dynamic metadata
+inline bool Hdr10PlusAsDolbyVisionFor(bool settingOn,
+                                      bool nativeAllowed,
+                                      bool nativeOutput,
+                                      bool displaySentHdr10Plus)
+{
+  return settingOn && nativeAllowed && nativeOutput && !displaySentHdr10Plus;
+}
 
