diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
new file mode 100644
index 0000000..ebe553a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
@@ -0,0 +1,137 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "DVHdr10Plus.h"
+
+#include "DVLayerMerge.h"
+#include "utils/HevcSei.h"
+
+#include <memory>
+
+extern "C"
+{
+#include "dvbridge_hdr10plus.h"
+#include "dvbridge_probe.h"
+
+#include <libavutil/hdr_dynamic_metadata.h>
+#include <libavutil/mem.h>
+}
+
+namespace
+{
+bool TakeUnit(const uint8_t* unit, size_t size, void* context)
+{
+  auto* au = static_cast<CDVHdr10Plus::AccessUnit*>(context);
+  if (size < 2 || (unit[0] & 0x80))
+    return true;
+  const unsigned int type = unit[0] >> 1 & 0x3f;
+  const unsigned int layer = (unit[0] & 1) << 5 | unit[1] >> 3;
+  if (type == 62 || type == 63)
+    au->dolbyVision = true;
+  else if (type < 32 && layer == 0)
+    au->picture = true;
+  else if (type == 39 && layer == 0 && size > 2)
+  {
+    // a prefix SEI: Kodi's parser (the NAL unit from its header, the emulation prevention taken out)
+    std::vector<uint8_t> buf;
+    const std::vector<CHevcSei> messages = CHevcSei::ParseSeiRbspUnclearedEmulation(unit, size, buf);
+    for (const CHevcSei& sei : messages)
+      if (sei.m_payloadType == 137)
+        au->mastering = true;
+    if (au->t35.empty())
+      if (const auto hdr10plus = CHevcSei::FindHdr10PlusSeiMessage(buf, messages))
+      {
+        const CHevcSei* sei = *hdr10plus;
+        if (sei->m_payloadOffset + sei->m_payloadSize <= buf.size())
+          au->t35.assign(buf.begin() + sei->m_payloadOffset,
+                         buf.begin() + sei->m_payloadOffset + sei->m_payloadSize);
+      }
+  }
+  return true;
+}
+
+bool Pq(const AVCodecParameters* parameters)
+{
+  return parameters && parameters->color_trc == AVCOL_TRC_SMPTE2084 &&
+         parameters->color_primaries == AVCOL_PRI_BT2020;
+}
+} // namespace
+
+CDVHdr10Plus::AccessUnit CDVHdr10Plus::Read(const uint8_t* data, size_t size, int lengthSize)
+{
+  AccessUnit au;
+  dvbridge_hdr10plus_units(data, size, lengthSize, TakeUnit, &au);
+  return au;
+}
+
+bool CDVHdr10Plus::MakesLevel1(const std::vector<uint8_t>& t35)
+{
+  // (FFmpeg's parser takes the payload after its header: the country code 0xB5, the provider code and the
+  // provider oriented code of two bytes each, and the application identifier, which CHevcSei checked)
+  constexpr size_t HEADER = 6;
+  if (t35.size() <= HEADER)
+    return false;
+  size_t size = 0;
+  std::unique_ptr<AVDynamicHDRPlus, decltype(&av_free)> metadata(av_dynamic_hdr_plus_alloc(&size), &av_free);
+  if (!metadata ||
+      av_dynamic_hdr_plus_from_t35(metadata.get(), t35.data() + HEADER, t35.size() - HEADER) < 0)
+    return false;
+  struct dvbridge_hdr10plus_l1 l1;
+  return dvbridge_hdr10plus_level1(metadata.get(), &l1);
+}
+
+CDVHdr10Plus::Verdict CDVHdr10Plus::Judge(const AccessUnit& unit,
+                                          const AVCodecParameters* parameters,
+                                          bool containerMastering)
+{
+  if (unit.dolbyVision)
+    return Verdict::DOLBY_VISION;
+  if (!Pq(parameters))
+    return Verdict::NOT_PQ;
+  if (!unit.picture || unit.t35.empty() || !(containerMastering || unit.mastering) ||
+      !MakesLevel1(unit.t35))
+    return Verdict::NOT_YET;
+  return Verdict::HDR10PLUS;
+}
+
+const char* CDVHdr10Plus::Why(const AccessUnit& unit,
+                              const AVCodecParameters* parameters,
+                              bool containerMastering)
+{
+  if (unit.dolbyVision)
+    return "it has units of Dolby Vision";
+  if (!Pq(parameters))
+    return "its colour is not BT.2020 PQ";
+  if (!unit.picture)
+    return "no picture in the access unit";
+  if (unit.t35.empty())
+    return "no HDR10+ metadata in the access unit";
+  if (!(containerMastering || unit.mastering))
+    return "the luminance of its mastering display is not known";
+  if (!MakesLevel1(unit.t35))
+    return "its HDR10+ metadata describe no distribution of the picture";
+  return "";
+}
+
+bool CDVHdr10Plus::Record(const AVCodecParameters* parameters,
+                          AVRational rate,
+                          AVDOVIDecoderConfigurationRecord& record)
+{
+  if (!Pq(parameters))
+    return false;
+  // what CDVLayerMerge::RecordFromRpu() makes of the RPU of a profile 8 stream whose base layer is BT.2020 PQ:
+  // the RPU that the decoder makes of the HDR10+ metadata (vdr_rpu_profile 1, no enhancement layer)
+  dvbridge_rpu_probe probe{};
+  probe.rpu = true;
+  probe.rpu_profile = 1;
+  probe.vdr_bit_depth = 12;
+  probe.residual_disabled = true;
+  probe.profile = 8;
+  return CDVLayerMerge::RecordFromRpu(probe, parameters, rate, record) && record.dv_profile == 8 &&
+         record.dv_bl_signal_compatibility_id == 1;
+}
