+// Hades: the Dolby Vision metadata of a picture of a stream made Dolby Vision from its HDR10+ metadata
+// (CDVDStreamInfo::doviFromHdr10Plus, CDVHdr10Plus), from that picture's own HDR10+ metadata and the
+// static metadata of the stream (dvbridge_hdr10plus_next()): made once a scene (as hdr10plus_tool tells
+// the scenes of HDR10+), the first picture of a scene with a scene refresh. A picture without HDR10+
+// metadata of its own, with metadata from which no level 1 block can be made, or without the luminance
+// of its mastering display, gets the metadata made last as a repeated RPU, as FFmpeg's HEVC decoder
+// gives the last RPU to a picture without one: it counts as a picture without metadata
+// (CheckNativeDVPicture()), and a stretch of them goes to the ordinary output.
+void CDVDVideoCodecFFmpeg::MakeHdr10PlusMetadata(VideoPicture* picture)
+{
+  const AVFrameSideData* sd = av_frame_get_side_data(m_pFrame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+  const auto* hdr10plus = sd && sd->size >= sizeof(AVDynamicHDRPlus)
+                              ? reinterpret_cast<const AVDynamicHDRPlus*>(sd->data)
+                              : nullptr;
+  size_t size = 0;
+  bool repeated = false;
+  const AVDOVIMetadata* made = dvbridge_hdr10plus_next(
+      m_dvHdr10PlusScene, hdr10plus, picture->hasDisplayMetadata ? &picture->displayMetadata : nullptr,
+      picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size, &repeated);
+  if (made && picture->doviMetadata.Assign(reinterpret_cast<const uint8_t*>(made), size))
+    picture->doviRpuRepeated = repeated;
+}
+
 void CDVDVideoCodecFFmpeg::CheckNativeDVPicture(VideoPicture* picture)
 {
   if (!(m_dvNativeOutput || m_dvConvert) ||
@@ -1783,6 +1826,8 @@ void CDVDVideoCodecFFmpeg::Reset()
   m_dvMissingRpu = 0;
   m_dvPresentRpu = 0;
   m_dvLateInRow = 0;
+  // (Hades: the first picture after it refreshes the scene, and none gets metadata from before)
+  dvbridge_hdr10plus_scene_reset(m_dvHdr10PlusScene);
 #endif
   m_hdr10PlusGap.Flush(); // Hades
   m_started = false;
@@ -1945,6 +1990,11 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   pVideoPicture->qscale_type = 0;
 
   pVideoPicture->hdrType = m_hints.hdrType;
+#ifdef HAVE_DVBRIDGE
+  // Hades: Dolby Vision made from HDR10+ is that for native output only (Open())
+  if (m_dvFromHdr10Plus && !m_dvNativeOutput)
+    pVideoPicture->hdrType = StreamHdrType::HDR_TYPE_HDR10;
+#endif
 
   AVFrameSideData* sd;
 
@@ -2109,6 +2159,11 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
         }
       }
     }
+#ifdef HAVE_DVBRIDGE
+    // Hades: made from the picture's own HDR10+ metadata (FFmpeg makes none of an RPU there is not)
+    else if (m_dvFromHdr10Plus)
+      MakeHdr10PlusMetadata(pVideoPicture);
+#endif
   }
 
   pVideoPicture->hdr10PlusVsif.reset();
