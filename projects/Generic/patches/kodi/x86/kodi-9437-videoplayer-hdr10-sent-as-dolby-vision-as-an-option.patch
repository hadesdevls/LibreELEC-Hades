+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+extern "C"
+{
+#include <libavcodec/codec_par.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/rational.h>
+}
+
+/*!
+ * \brief Hades: HDR10+ sent as Dolby Vision (videoscreen.hadesdvfromhdr10plus): what an access unit of a HEVC
+ *        stream says of its HDR10+ metadata before it is decoded, whether such a stream can be sent so, and its
+ *        Dolby Vision record then
+ *
+ * A stream that no Dolby Vision record declares, whose packets bring no RPU, and whose access units carry HDR10+
+ * metadata (the SEI of ITU-T T.35 for SMPTE ST 2094-40, read with CHevcSei) becomes Dolby Vision of profile 8.1
+ * when an access unit with a picture has HDR10+ metadata from which a level 1 block can be made
+ * (dvbridge_hdr10plus_level1()), its colour is BT.2020 PQ, and the luminance of its mastering display is known (in
+ * the container, or in an SEI of the access unit): the decoder then makes the metadata of each picture from its own
+ * HDR10+ metadata (dvbridge_hdr10plus_metadata()). A stream with a unit of an RPU or of an enhancement layer is
+ * left to the probe of Dolby Vision (CDVDDemuxFFmpeg::ProbeDolbyVision()): its own metadata always win.
+ */
+class CDVHdr10Plus
+{
+public:
+  struct AccessUnit
+  {
+    bool picture = false; //!< a unit of a coded picture (VCL, nuh_layer_id 0)
+    bool dolbyVision = false; //!< a unit of type 62 or 63 (an RPU, or the enhancement layer)
+    bool mastering = false; //!< an SEI of the mastering display colour volume (payload type 137)
+    //! the payload of the first HDR10+ SEI, from its country code on (CHevcSei::FindHdr10PlusSeiMessage())
+    std::vector<uint8_t> t35;
+  };
+  //! \param lengthSize the bytes of the length before each unit (CDVLayerMerge::LengthSize()), 0 for start codes
+  static AccessUnit Read(const uint8_t* data, size_t size, int lengthSize);
+
+  enum class Verdict
+  {
+    HDR10PLUS, //!< it can be sent as Dolby Vision from its HDR10+ metadata
+    NOT_YET, //!< nothing in this access unit says (no picture, no HDR10+, no level 1, no mastering display yet)
+    DOLBY_VISION, //!< it has units of Dolby Vision: not here
+    NOT_PQ, //!< its colour is not BT.2020 PQ
+  };
+  //! \param containerMastering the container gives the luminance of the mastering display
+  static Verdict Judge(const AccessUnit& unit, const AVCodecParameters* parameters, bool containerMastering);
+  //! What NOT_YET, DOLBY_VISION and NOT_PQ were about, for the log
+  static const char* Why(const AccessUnit& unit,
+                         const AVCodecParameters* parameters,
+                         bool containerMastering);
+
+  //! The record of such a stream: profile 8.1, the level from its size and rate (CDVLayerMerge::Level())
+  static bool Record(const AVCodecParameters* parameters,
+                     AVRational rate,
+                     AVDOVIDecoderConfigurationRecord& record);
+
+  //! A level 1 block can be made of the HDR10+ metadata of a payload of AccessUnit::t35
+  static bool MakesLevel1(const std::vector<uint8_t>& t35);
+};
