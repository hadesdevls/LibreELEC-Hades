From 19ad553fc5af13d242e1c43d3c63bf4c45a03daf Mon Sep 17 00:00:00 2001
From: kel-mo <kelvmod@gmail.com>
Date: Fri, 9 Oct 2026 18:51:39 +1000
Subject: [PATCH] [application] Keep the frame move guard released after Stop()
 (#29569)

Stop() releases m_frameMoveGuard so script threads can finish, but it
can run inside a nested render loop such as CGUIDialogBusy::WaitOnEvent.
When that loop keeps processing, CApplication::Process() and the
FrameMove() external call window each unlock and relock the guard.
The unlock fails because the main thread no longer owns the mutex, and
the lock succeeds, so the main thread holds the guard again when it
reaches Cleanup() and joins the Python invokers. Any add-on thread
blocked in a GuiLock call then deadlocks shutdown.

Skip both unlock/lock pairs once m_bStop is set.

Assisted-By: Claude
(cherry picked from commit 0929e56b09c852df85669e5c421d2a75b84b2f4d)
---
 xbmc/application/Application.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 114d179..8d5ad47 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1578,7 +1578,8 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
 
     // Open the door for external calls e.g python exactly here.
     // Window size can be between 2 and 10ms and depends on number of continuous requests
-    if (m_WaitingExternalCalls)
+    // Stop() has already released the guard; don't take it back on the way out
+    if (m_WaitingExternalCalls && !m_bStop)
     {
       CSingleExit ex(CServiceBroker::GetWinSystem()->GetGfxContext());
       m_frameMoveGuard.unlock();
@@ -2544,10 +2545,14 @@ void CApplication::Process()
 
   {
     // Allow processing of script threads to let them shut down properly.
+    // Stop() has already released the guard; don't take it back on the way out
+    const bool releaseGuard = !m_bStop;
     CSingleExit ex(CServiceBroker::GetWinSystem()->GetGfxContext());
-    m_frameMoveGuard.unlock();
+    if (releaseGuard)
+      m_frameMoveGuard.unlock();
     CScriptInvocationManager::GetInstance().Process();
-    m_frameMoveGuard.lock();
+    if (releaseGuard)
+      m_frameMoveGuard.lock();
   }
 
   // process messages, even if a movie is playing
