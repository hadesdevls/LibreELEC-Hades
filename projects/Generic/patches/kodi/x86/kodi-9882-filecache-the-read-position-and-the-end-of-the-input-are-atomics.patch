From 679a8349e727999b5b513bddb5321a746e58c6a1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:06:03 +0000
Subject: [PATCH] filecache: the read position and the end of the input are
 atomics

CFileCache::m_readPos is set by the reader (Read(), Seek()) and read and
set by the cache thread (Process(): the read-ahead limit, the handling
of a seek), and CCacheStrategy::m_bEndOfInput is set by the cache thread
and read by the reader (CCircularCache::WaitForData()), with no lock
shared by the two. ThreadSanitizer reports both races on the host test
of CFileCache (FileCache.cpp and CircularCache.cpp of this tree): six
reports in a run, the same in the code before the abort change. They
are now std::atomic; every use reads or writes them as before.
---
 xbmc/filesystem/CacheStrategy.h | 3 ++-
 xbmc/filesystem/FileCache.h     | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/xbmc/filesystem/CacheStrategy.h b/xbmc/filesystem/CacheStrategy.h
index 93da325..193364f 100644
--- a/xbmc/filesystem/CacheStrategy.h
+++ b/xbmc/filesystem/CacheStrategy.h
@@ -10,6 +10,7 @@
 
 #include "threads/Event.h"
 
+#include <atomic>
 #include <stdint.h>
 #include <string>
 
@@ -57,7 +58,7 @@ public:
 
   CEvent m_space;
 protected:
-  bool  m_bEndOfInput = false;
+  std::atomic<bool> m_bEndOfInput{false}; // set by the cache thread, read by the reader
 };
 
 /**
diff --git a/xbmc/filesystem/FileCache.h b/xbmc/filesystem/FileCache.h
index 1ac7963..004000d 100644
--- a/xbmc/filesystem/FileCache.h
+++ b/xbmc/filesystem/FileCache.h
@@ -111,7 +111,7 @@ public:
     DWORD m_seekError = 0;
     std::atomic<bool> m_sourcePositionValid{true};
     int64_t m_seekPos = 0;
-    int64_t m_readPos = 0;
+    std::atomic<int64_t> m_readPos{0}; // the reader's; the cache thread reads and sets it too
     int64_t m_writePos = 0;
     unsigned m_chunkSize = 0;
     uint32_t m_writeRate = 0;
-- 
