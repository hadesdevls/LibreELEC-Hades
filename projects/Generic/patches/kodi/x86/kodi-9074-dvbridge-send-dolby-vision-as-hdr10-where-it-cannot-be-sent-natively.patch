+//! Hades: what the settings say of a Dolby Vision stream that is not sent natively
+enum class ConversionSetting
+{
+  NEEDED, //!< reconstructed and sent as HDR10 when its base layer is no picture by itself
+  ALSO_ENHANCEMENT, //!< ... and also when it has an enhancement layer
+  NEVER,
+};
+
+/*!
+ * \brief Whether the base layer of a Dolby Vision stream is no picture by itself
+ *
+ * The base layer of profile 5 is not HDR10, HLG or SDR (it is in IPTPQc2): played as it is, which
+ * is how Kodi plays it, its colours are wrong, and the reconstruction is the only picture there
+ * is. The same goes for an AV1 stream of profile 10 whose record says that its base layer is
+ * compatible with nothing (bl_signal_compatibility_id 0; by the profile, no such stream was at
+ * hand). The base layer of every other stream is a picture by itself, the version made for
+ * displays without Dolby Vision.
+ */
+constexpr bool BaseLayerIsNoPicture(int profile, int compatibility)
+{
+  return profile == 5 || (profile == 10 && compatibility == 0);
+}
+
+/*!
+ * \brief Whether a Dolby Vision stream is one that is reconstructed and sent as HDR10 where it
+ *        is not sent natively
+ *
+ * One whose base layer is no picture by itself (BaseLayerIsNoPicture()). Every other stream is
+ * played as before; a stream of profile 7 with an enhancement layer is reconstructed too when
+ * the setting says so. Never what is kept from the Dolby Vision renderer anyway: software
+ * decoding, interlaced or stereoscopic video.
+ */
+constexpr bool ConversionEligible(ConversionSetting setting,
+                                  int profile,
+                                  int compatibility,
+                                  bool enhancementLayer,
+                                  bool softwareProbe,
+                                  bool interlaced,
+                                  bool stereo)
+{
+  if (setting == ConversionSetting::NEVER || softwareProbe || interlaced || stereo)
+    return false;
+  return BaseLayerIsNoPicture(profile, compatibility) ||
+         (setting == ConversionSetting::ALSO_ENHANCEMENT && profile == 7 && enhancementLayer);
+}
+
+//! Where such a picture goes in the window
+struct ConversionPlace
+{
+  bool valid = false; //!< there is something to draw
+  float srcX0 = 0, srcY0 = 0, srcX1 = 0, srcY1 = 0; //!< the part of the picture that is drawn
+  int dstX = 0, dstY = 0, dstWidth = 0, dstHeight = 0; //!< ... and where, from the top left
+};
+
+/*!
+ * \brief The place of a reconstructed picture, from the two rectangles that Kodi's renderer draws
+ *        with (the part of the source that is shown, and where in the window, both from the top
+ *        left)
+ *
+ * The destination is cut to the window, which a zoom reaches past, and the source is cut by the
+ * same part; then the destination goes to whole pixels (the reconstruction is drawn into a
+ * rectangle of pixels), which moves an edge by half a pixel at most.
+ */
+inline ConversionPlace PlaceConversion(float srcX1, float srcY1, float srcX2, float srcY2,
+                                       float dstX1, float dstY1, float dstX2, float dstY2,
+                                       int pictureWidth, int pictureHeight,
+                                       int windowWidth, int windowHeight)
+{
+  ConversionPlace place;
+  for (const float edge : {srcX1, srcY1, srcX2, srcY2, dstX1, dstY1, dstX2, dstY2})
+  {
+    if (!std::isfinite(edge))
+      return place;
+  }
+  if (!(srcX2 - srcX1 >= 1) || !(srcY2 - srcY1 >= 1) || !(dstX2 - dstX1 >= 1) ||
+      !(dstY2 - dstY1 >= 1) || pictureWidth < 1 || pictureHeight < 1 || windowWidth < 1 ||
+      windowHeight < 1)
+    return place;
+  const float perX = (srcX2 - srcX1) / (dstX2 - dstX1);
+  const float perY = (srcY2 - srcY1) / (dstY2 - dstY1);
+  const auto width = static_cast<float>(windowWidth);
+  const auto height = static_cast<float>(windowHeight);
+  if (dstX1 >= width || dstY1 >= height || dstX2 <= 0 || dstY2 <= 0)
+    return place; // outside the window
+  if (dstX1 < 0)
+  {
+    srcX1 -= dstX1 * perX;
+    dstX1 = 0;
+  }
+  if (dstY1 < 0)
+  {
+    srcY1 -= dstY1 * perY;
+    dstY1 = 0;
+  }
+  if (dstX2 > width)
+  {
+    srcX2 -= (dstX2 - width) * perX;
+    dstX2 = width;
+  }
+  if (dstY2 > height)
+  {
+    srcY2 -= (dstY2 - height) * perY;
+    dstY2 = height;
+  }
+  place.srcX0 = std::clamp(srcX1, 0.0f, static_cast<float>(pictureWidth));
+  place.srcY0 = std::clamp(srcY1, 0.0f, static_cast<float>(pictureHeight));
+  place.srcX1 = std::clamp(srcX2, 0.0f, static_cast<float>(pictureWidth));
+  place.srcY1 = std::clamp(srcY2, 0.0f, static_cast<float>(pictureHeight));
+  place.dstX = static_cast<int>(std::lround(dstX1));
+  place.dstY = static_cast<int>(std::lround(dstY1));
+  place.dstWidth = static_cast<int>(std::lround(dstX2)) - place.dstX;
+  place.dstHeight = static_cast<int>(std::lround(dstY2)) - place.dstY;
+  place.valid = place.dstWidth >= 1 && place.dstHeight >= 1 && place.srcX1 - place.srcX0 >= 1 &&
+                place.srcY1 - place.srcY0 >= 1;
+  return place;
+}
+
