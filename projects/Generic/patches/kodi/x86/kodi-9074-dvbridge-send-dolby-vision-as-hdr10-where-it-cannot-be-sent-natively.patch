+                                           base.pts, elPts, view, width, height);
+  if (drawn)
+  {
+    // FEL only when the mapping that the renderer used reconstructs residuals, as for native
+    // output
+    const bool omitted = dvbridge_render_residual_omitted(m_renderer);
+    dvbridge_color color{};
+    const bool fel = layered && !omitted &&
+                     dvbridge_map_color(&color, metadata.Data(), metadata.Size(), true, nullptr) &&
+                     color.dovi.nlq_active;
+    m_convertView = view;
+    m_convertWidth = width;
+    m_convertHeight = height;
+    m_convertedFel += fel ? 1 : 0;
+    m_convertLayers = fel ? "FEL" : omitted ? "FELGAP" : layered ? "MEL" : "BL";
+    m_convertInfo = CDVPlaybackInfo::HDR10 | (fel ? CDVPlaybackInfo::FEL : 0u);
+    if (!m_converted++)
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision reconstructed for output as HDR10: base {}x{}, {}, into "
+                "{}x{} of a {}x{} output",
+                base.width, base.height,
+                fel       ? "with the residual of its enhancement layer"
+                : omitted ? "without the residual of its enhancement layer, which is missing"
+                : layered ? "with an enhancement layer that carries no residual"
+                          : "no enhancement layer",
+                view.dst_width, view.dst_height, width, height);
+  }
+  if (layered)
+    dvbridge_gl_frame_release(&el);
+  if (mapped)
+    dvbridge_dmabuf_release(&imported);
+  dvbridge_gl_frame_release(&bl);
+  if (!drawn)
+  {
+    // libplacebo keeps what failed turned off until its errors are reset
+    m_convertFailed += again ? 0 : 1;
+    dvbridge_renderer_reset(m_renderer);
+    return Fail("metadata-validation-or-reconstruction");
+  }
+  if (m_failures.Count())
+    m_failures.Reset();
+  m_convertDrawn = true;
+  return true;
+}
+
+bool CDVBridgeGLES::CopyConversion(unsigned int framebuffer, int width, int height, bool limited)
+{
+  // The picture just reconstructed, or the one before it when nothing of this one was drawn: the
+  // texture still holds that one, at its place. None when the draw of this one failed.
+  const pl_tex picture = m_renderer ? dvbridge_render_hdr10_last(m_renderer) : nullptr;
+  if (!picture || !m_copier || width != m_convertWidth || height != m_convertHeight)
+    return false;
+  const unsigned int texture = pl_opengl_unwrap(m_gl->gpu, picture, nullptr, nullptr, nullptr);
+  if (!texture || !dvbridge_gl_copy(m_copier, texture, framebuffer, width, height,
+                                    m_convertView.dst_x, m_convertView.dst_y,
+                                    m_convertView.dst_width, m_convertView.dst_height, true,
+                                    limited))
+    return false;
+  // the picture is in the frame that goes out next
+  CDVPlaybackInfo::presented.store(m_convertInfo);
+  return true;
+}
+
+void CDVBridgeGLES::LogConversion() const
+{
+  if (m_converted || m_convertFailed)
+    CLog::Log(LOGINFO,
+              "DVBridge: {} pictures were reconstructed for output as HDR10, {} of them with the "
+              "residual of their enhancement layer; {} could not be",
+              m_converted, m_convertedFel, m_convertFailed);
+}
+
+bool CDVBridgeGLES::ConversionOutput(const VideoPicture& picture, VideoPicture& output)
+{
+  output.SetParams(picture);
+  output.color_transfer = AVCOL_TRC_SMPTE2084;
+  output.color_primaries = AVCOL_PRI_BT2020;
+  output.color_space = AVCOL_SPC_BT2020_NCL;
+  output.colorBits = 10;
+  if (!output.hasDisplayMetadata)
+    output.displayMetadata = {};
+  // What the stream says of its light levels and of the luminance of its mastering display, it
+  // says of its base layer, which is another picture: of this one they are what its Dolby
+  // Vision metadata gives, and not known where that gives none.
+  output.hasLightMetadata = false;
+  output.lightMetadata = {};
+  output.displayMetadata.has_luminance = 0;
+  // (a function has the name of the structure too, which hides it in C++)
+  struct dvbridge_hdr10_static fixed{};
+  if (!picture.doviMetadata.Data() ||
+      !dvbridge_hdr10_static(&fixed, picture.doviMetadata.Data(), picture.doviMetadata.Size()))
+    return picture.doviMetadata.Data() != nullptr;
+  output.hasDisplayMetadata = true;
+  output.displayMetadata.has_luminance = 1;
+  output.displayMetadata.max_luminance = av_make_q(static_cast<int>(fixed.max_luminance), 1);
+  output.displayMetadata.min_luminance = av_make_q(static_cast<int>(fixed.min_luminance), 10000);
+  output.hasLightMetadata = fixed.max_cll != 0 || fixed.max_fall != 0;
+  output.lightMetadata.MaxCLL = fixed.max_cll;
+  output.lightMetadata.MaxFALL = fixed.max_fall;
+  CLog::Log(LOGINFO,
+            "DVBridge: the HDR10 output of a reconstructed Dolby Vision picture: mastering "
+            "display {} to {} cd/m2 ({}), MaxCLL {} MaxFALL {}",
+            static_cast<double>(fixed.min_luminance) / 10000.0, fixed.max_luminance,
+            fixed.level6 ? "level 6 of the metadata" : "the range of the source", fixed.max_cll,
+            fixed.max_fall);
+  return true;
+}
