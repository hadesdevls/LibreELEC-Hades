+bool DVBRIDGE::ConversionEligible(const CDVDStreamInfo& stream)
+{
+  // Only where the picture can be sent as HDR10: on an output that does not take it, the stream
+  // goes to the decoder it went to before, which decodes it as before.
+  const auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  return window && window->SupportsDVConversion() &&
+         ConversionEligible(ConversionSettingNow(), stream.dovi.dv_profile,
+                            stream.dovi.dv_bl_signal_compatibility_id,
+                            stream.dovi.el_present_flag != 0,
+                            (stream.codecOptions & CODEC_FORCE_SOFTWARE) != 0, stream.interlaced,
+                            !stream.stereo_mode.empty());
+}
+
+bool DVBRIDGE::WantsConversion(const VideoPicture* picture)
+{
+  // Not by whether this picture has its metadata: one without it is only not reconstructed, and
+  // the decoder moves a stream whose metadata stays missing to the ordinary output by changing
+  // its hdrType.
+  auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  return window && picture && picture->doviConvert &&
+         picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION &&
+         !(picture->iFlags & DVP_FLAG_INTERLACED) && picture->stereoMode.empty() &&
+         window->SupportsDVConversion();
+}
+
+void DVBRIDGE::ConversionFailed(const char* reason)
+{
+  if (auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem()))
+    window->DisableDVConversion(reason);
+}
+
+void CWinSystemGbmGLESContext::DVConversionNewVideo()
+{
+  // The display as Kodi's own HDR output takes it, which is the output the picture goes through:
+  // by the setting, and by what Kodi read of the display when it started (that is not read again
+  // for a video; only what the display says of Dolby Vision is).
+  m_dvConvertDisplay = m_renderableType == EGL_OPENGL_ES3_BIT && IsHDRDisplaySettingEnabled() &&
+                       GetDisplayHDRCapabilities().SupportsHDR10();
+  m_dvConvertDisabled = false;
+}
+
+void CWinSystemGbmGLESContext::DisableDVConversion(const char* reason)
+{
+  if (!m_dvConvertDisabled.exchange(true))
+    CLog::Log(LOGWARNING,
+              "DVBridge: Dolby Vision is not reconstructed for output as HDR10 in this video "
+              "({}); it plays as Kodi plays it",
+              reason);
+}
+
+void CWinSystemGbmGLESContext::EndDVConversion()
+{
+  if (!m_dvConvertBridge)
+    return;
+  m_dvConvertBridge->LogConversion();
+  m_dvConvertBridge.reset();
+  m_dvConvertShown = {};
+  PublishDVInfo(true);
+}
+
+int CWinSystemGbmGLESContext::RenderDVConversion(const CDVBridgeGLES::Layer& layer,
+                                                 const AVFrame* enhancement,
+                                                 const CDVMetadataBuffer& metadata,
+                                                 const CRect& source,
+                                                 const CRect& dest,
+                                                 unsigned int serial)
+{
+  // Where the picture goes: the part of the source that Kodi shows, at the place Kodi gives it.
+  const DVBRIDGE::ConversionPlace place =
+      DVBRIDGE::PlaceConversion(source.x1, source.y1, source.x2, source.y2, dest.x1, dest.y1,
+                                dest.x2, dest.y2, layer.width, layer.height, m_nWidth, m_nHeight);
+  if (!place.valid)
+    return -1;
+  dvbridge_view view{};
+  view.src_x0 = place.srcX0;
+  view.src_y0 = place.srcY0;
+  view.src_x1 = place.srcX1;
+  view.src_y1 = place.srcY1;
+  view.dst_x = place.dstX;
+  view.dst_y = place.dstY;
+  view.dst_width = place.dstWidth;
+  view.dst_height = place.dstHeight;
+
+  // Only into the window, whose size and rows are known here.
+  GLint target = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &target);
+  if (target != 0)
+    return -1;
+  if (!m_dvConvertBridge)
+    m_dvConvertBridge = std::make_unique<CDVBridgeGLES>();
+  if (!m_dvConvertBridge->InitializeConversion())
+    return -1;
+  const bool reconstructed = m_dvConvertBridge->PrepareConversion(
+      layer, enhancement, metadata, view, m_nWidth, m_nHeight, serial);
+  // ... or the picture before it, when this one could not be reconstructed and that one is
+  // still whole
+  if (!m_dvConvertBridge->CopyConversion(0, m_nWidth, m_nHeight, UseLimitedColor()))
+    return -1;
+  m_dvConvertShown = std::chrono::steady_clock::now();
+  return reconstructed ? 1 : 0;
 }
 
