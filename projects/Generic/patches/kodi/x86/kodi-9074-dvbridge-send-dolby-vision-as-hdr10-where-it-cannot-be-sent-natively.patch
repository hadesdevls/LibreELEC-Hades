+bool CRendererVAAPIGLES::CanConvertDV(const VideoPicture& picture) const
+{
+  // Native decoder textures only, as for native output. The place and the size on the screen are
+  // free: the reconstruction is scaled to where Kodi puts the picture. The picture itself is of
+  // 3840x2160 at most, which is what the bridge takes (dvbridge_gl_frame_import()).
+  const auto* pic = dynamic_cast<const CVaapiRenderPicture*>(picture.videoBuffer);
+  if (!pic || pic->procPic.videoSurface == VA_INVALID_ID || m_textureTarget != GL_TEXTURE_2D ||
+      m_renderOrientation != 0 || picture.iWidth < 1 || picture.iWidth > 3840 ||
+      picture.iHeight < 1 || picture.iHeight > 2160)
+    return false;
+  switch (pic->procPic.fourcc)
+  {
+    case VA_FOURCC_NV12:
+    case VA_FOURCC_P010:
+    case VA_FOURCC_P012:
+    case VA_FOURCC_P016:
+      return true;
+    default:
+      return false;
+  }
+}
+
+int CRendererVAAPIGLES::RenderDVConversion(int idx)
+{
+  if (!m_isVAAPIBuffer || m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0)
+    return -1;
+  auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+      CServiceBroker::GetWinSystem());
+  if (!window)
+    return -1;
+  auto& buffer = m_buffers[idx];
+  CDVBridgeGLES::Layer layer{};
+  switch (m_vaapiFourcc)
+  {
+    case VA_FOURCC_NV12: layer.layout = DVBRIDGE_NV12; break;
+    case VA_FOURCC_P010: layer.layout = DVBRIDGE_P010; break;
+    case VA_FOURCC_P012: layer.layout = DVBRIDGE_P012; break;
+    case VA_FOURCC_P016: layer.layout = DVBRIDGE_P016; break;
+    default: return -1;
+  }
+  layer.width = m_sourceWidth;
+  layer.height = m_sourceHeight;
+  // A picture without a time has no enhancement picture either (they are paired by it)
+  const bool timed = buffer.doviPts != DVD_NOPTS_VALUE;
+  layer.pts = timed ? buffer.doviPts : 0.0;
+  for (int p = 0; p < 2; ++p)
+  {
+    const auto& plane = buffer.fields[FIELD_FULL][p];
+    layer.planes[p] = {plane.id, static_cast<int>(plane.texwidth),
+                      static_cast<int>(plane.texheight)};
+  }
+  return window->RenderDVConversion(layer, timed ? buffer.doviEnhancement.get() : nullptr,
+                                    buffer.doviMetadata, m_sourceRect, m_destRect,
+                                    buffer.doviSerial);
+}
