diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayVisibleSet.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayVisibleSet.h
new file mode 100644
index 0000000..2a4f1ff
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayVisibleSet.h
@@ -0,0 +1,63 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
