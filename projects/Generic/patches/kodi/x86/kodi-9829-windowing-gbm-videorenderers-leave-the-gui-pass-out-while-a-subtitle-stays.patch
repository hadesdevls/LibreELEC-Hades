+      window->SetGuiPassDebug(m_renderDebug);
       // Hades: the GUI pass was left out (CWinSystemGbmGLESContext::GuiPassReusable()): it is the
       // one that updates the renderer's areas (a change of view mode, of the window), so it is
       // done here
diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index b080060..d46c80e 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -40,12 +40,15 @@ namespace GBM
  * the setting, a GUI that is not composited, an FBO
  * that was made after the last frame was drawn (or has not been drawn into yet), the menus in
  * Dolby Vision (their frames are made of the FBO), partial redraws (the FBO would hold only what
- * changed), stereoscopic 3D (two passes), overlays on the picture that are drawn in the GUI pass
- * (subtitles, the debug information of the player: they are not left to the dirty regions alone),
+ * changed), stereoscopic 3D (two passes), the debug information of the player over the picture
+ * (it changes without marking anything dirty),
  * a frame with the GUI that was not seen yet by the picture's pass (what it was over was not
  * known), a frame before without a picture of the video drawn by RenderEx() (graphics of a disc
  * menu without a picture are drawn by the GUI pass). A capture marks the window manager dirty
- * itself (CApplication::FrameMove()).
+ * itself (CApplication::FrameMove()). Subtitles are no reason: they mark the GUI dirty where they
+ * come, change or go (OVERLAY::CRenderer::PrepareOverlays(), OverlayVisibleSet.h), and a mark made
+ * after the windows were processed takes the skip back in that frame (CApplication::FrameMove()),
+ * so the GUI pass is drawn for a subtitle in the frame it comes with, and left out while it stays.
  */
 class CDVGuiReuse
 {
@@ -59,7 +62,7 @@ public:
     bool menus = false; //!< the menus in Dolby Vision are on, or the setting is
     bool partial = false; //!< advancedsettings.xml asks for partial redraws
     bool stereo = false; //!< a stereoscopic mode
-    bool overlays = false; //!< subtitles or the debug information are over the picture
+    bool overlays = false; //!< the debug information of the player is over the picture
     bool seen = false; //!< a frame whose GUI was drawn went through the picture's pass since
     //!< the FBO was made, and its elements are known
     bool video = false; //!< RenderEx() drew the picture in the frame before: a disc
@@ -123,7 +126,8 @@ public:
       case Why::STEREO:
         return "a stereoscopic mode";
       case Why::OVERLAYS:
-        return "subtitles or the debug information are over the picture";
+        return "the debug information of the player is over the picture (subtitles mark the GUI "
+               "dirty where they change)";
       case Why::NOT_SEEN:
         return "no frame of the GUI has been seen by the picture's pass yet";
       case Why::NO_VIDEO:
