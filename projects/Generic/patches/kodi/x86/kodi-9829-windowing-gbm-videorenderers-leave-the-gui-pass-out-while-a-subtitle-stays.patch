+
+#pragma once
+
+#include <vector>
+
+namespace OVERLAY
+{
+
+/*!
+ * \brief Hades: which subtitles are on screen in a frame, to tell that they changed
+ *
+ * The GUI pass of a frame draws the subtitles that are not drawn with the picture, and where the
+ * GUI pass of a frame can be left out (where nothing is dirty: the dirty-driven skip of
+ * CApplication::FrameMove(), CDVGuiReuse) a subtitle that changes has to mark the GUI dirty itself,
+ * or the frame before is shown again. A text subtitle says that it changed (libass's detect_change),
+ * and a bitmap subtitle that arrives is a new overlay with no texture yet; what neither says is a
+ * subtitle that goes without another coming: one of two bitmap overlays that ends, text subtitles
+ * that are turned off (their overlay is no longer given to the frame). So the frame's set is kept:
+ * the bitmap overlays on screen, in the order the player gives them, and whether text subtitles
+ * gave images; a set that is not the one of the frame before is a change.
+ *
+ * Kept from one frame to the next without allocating once the vectors have grown.
+ */
+class CVisibleSet
+{
+public:
+  //! The subtitles of a frame begin
+  void Begin()
+  {
+    m_now.clear();
+    m_text = false;
+  }
+
+  //! A bitmap overlay (PGS, DVB, DVD SPU) is on screen in this frame
+  void Bitmap(const void* overlay) { m_now.push_back(overlay); }
+
+  //! Text subtitles gave images for this frame
+  void Text() { m_text = true; }
+
+  //! Whether the set of this frame is not the one of the frame before; it becomes the one before
+  bool Changed()
+  {
+    const bool changed = m_now != m_last || m_text != m_lastText;
+    m_last.swap(m_now);
+    m_lastText = m_text;
+    return changed;
+  }
+
+private:
+  std::vector<const void*> m_now;
+  std::vector<const void*> m_last;
+  bool m_text{false};
+  bool m_lastText{false};
+};
+
+} // namespace OVERLAY
