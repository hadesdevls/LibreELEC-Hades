From d7f158b15fd7497b27bb9aa046a8435688bbfe97 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:25:09 +0000
Subject: [PATCH] windowing/gbm: the HDR10/HLG composite under scissor
 rectangles takes them within Kodi's scissor box

The composite of the GUI over a frame whose GUI pass was left out is drawn under
the scissor rectangles of the tile mask of the GUI (cb7e27c), but only where the
scissor test was off. Kodi's render system keeps it on, with the box of what it
draws (CRenderSystemGLES::ResetRenderSystem() enables it, SetScissors() only
moves the box), so in the HDR10/HLG composite the rectangles were never used: the
whole quad was drawn every frame, and the mask of each content of the GUI (two
small draws and a read-back) was made for nothing. The host test that found the
rectangles exact had the test off. Only the Dolby Vision composite, which turns
it off itself, used them.

The rectangles are now used whatever the state of the test: where it is on, each
rectangle is taken within the box (dvbridge_tiles_scissor()), since the whole
quad draws only the fragments inside the box, and the box and the test are left
as they were. The count of the log is that of the rectangles drawn. The block of
defines of the tiles, which dvbridge_tiles.h had twice, is there once.

Host tests (outside the tree): scissor_box_test on llvmpipe and zink, with
Kodi's composite shaders and the mask of dvbridge_guimask.c, at 3840x2160,
1920x1080 and 1366x768: the whole quad under Kodi's box, a box through the GUI, a
box off the tiles and one with nothing of the GUI against the rectangles within
it: 0 pixels differ in every case (the Dolby Vision composite with the test off
too), the scissor state is left as it was, and the rectangles taken without the
box differ (the test tells); scissor_wiring.py. Before this change the first does not
build and the second fails 3 of 3.
---
 tools/dvbridge/dvbridge_tiles.h               | 38 +++++++++++++++----
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 23 +++++++----
 2 files changed, 46 insertions(+), 15 deletions(-)

diff --git a/tools/dvbridge/dvbridge_tiles.h b/tools/dvbridge/dvbridge_tiles.h
index 8f7ca26..86b521b 100644
--- a/tools/dvbridge/dvbridge_tiles.h
+++ b/tools/dvbridge/dvbridge_tiles.h
@@ -24,6 +24,7 @@
  * Rectangles of tiles are disjoint, so no fragment is drawn twice (it would blend twice). */
 #ifndef DVBRIDGE_TILES_H
 #define DVBRIDGE_TILES_H
+#include <stdbool.h>
 #include <stdint.h>
 
 #define DVBRIDGE_TILE_RECTS_MAX 24
@@ -34,13 +35,6 @@
 #define DVBRIDGE_SOURCE_TILE 16
 #define DVBRIDGE_SOURCE_TILE_COLUMNS 240
 #define DVBRIDGE_SOURCE_TILE_ROWS 135
-/* the tiles of the raster of the source transport: DVBRIDGE_SOURCE_TILE x DVBRIDGE_SOURCE_TILE
-   pixels, in
- * DVBRIDGE_SOURCE_TILE_COLUMNS columns and DVBRIDGE_SOURCE_TILE_ROWS rows (dvbridge_source.c checks
- * them) */
-#define DVBRIDGE_SOURCE_TILE 16
-#define DVBRIDGE_SOURCE_TILE_COLUMNS 240
-#define DVBRIDGE_SOURCE_TILE_ROWS 135
 
 /* in tiles */
 struct dvbridge_tile_rect {
@@ -107,4 +101,34 @@ static inline int dvbridge_tiles_merge(const uint8_t *mask, unsigned cols, unsig
     }
     return (int)count;
 }
+
+/* The scissor rectangle of a rectangle of tiles of tile x tile pixels (x, y, width, height in the
+ * pixels of the target, as glScissor() takes them), within box where the quad is drawn under a
+ * scissor rectangle of its own (Kodi's render system keeps the scissor test on, with the box of
+ * what it draws: CRenderSystemGLES::SetScissors()); box NULL: the scissor test is off. The whole
+ * quad under box draws the fragments inside box; the quad under each rectangle within box draws
+ * those of the rectangles inside box, the same where the quad draws anything (see the top).
+ * false: nothing of the rectangle is within box (not drawn). */
+static inline bool dvbridge_tiles_scissor(const struct dvbridge_tile_rect *r, unsigned tile,
+                                          const int box[4], int out[4])
+{
+    long long x0 = (long long)r->x * tile, y0 = (long long)r->y * tile;
+    long long x1 = x0 + (long long)r->w * tile, y1 = y0 + (long long)r->h * tile;
+    if (box) {
+        const long long bx0 = box[0], by0 = box[1];
+        const long long bx1 = bx0 + box[2], by1 = by0 + box[3];
+        x0 = x0 > bx0 ? x0 : bx0;
+        y0 = y0 > by0 ? y0 : by0;
+        x1 = x1 < bx1 ? x1 : bx1;
+        y1 = y1 < by1 ? y1 : by1;
+    }
+    if (x1 <= x0 || y1 <= y0 || x0 < -2147483647LL || y0 < -2147483647LL ||
+        x1 - x0 > 2147483647LL || y1 - y0 > 2147483647LL)
+        return false;
+    out[0] = (int)x0;
+    out[1] = (int)y0;
+    out[2] = (int)(x1 - x0);
+    out[3] = (int)(y1 - y0);
+    return true;
+}
 #endif
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 743cc15..454cd2c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2318,27 +2318,34 @@ void CWinSystemGbmGLESContext::CompositeGui()
   // Hades: the same quad, drawn under glScissor for each rectangle of the tile mask of the GUI that
   // this frame composites (the GUI pass was left out, and the mask is that of its content): the
   // fragments inside the rectangles are those of the whole quad, and outside them the whole quad
-  // discards (dvbridge_tiles.h). Any doubt (no mask yet, another GUI): the whole quad.
+  // discards (dvbridge_tiles.h). Any doubt (no mask yet, another GUI): the whole quad. Kodi's
+  // render system keeps the scissor test on (the HDR10/HLG composite: the box of what it draws),
+  // and the whole quad is drawn within that box: each rectangle is taken within it, and the box
+  // and the test are left as they were (the Dolby Vision composite has the test off).
   if (m_guiCompositing)
     HdrTilesUpdate(dvComposite);
   const bool maskFits = dvComposite ? (m_tilesKind == TILES_PACKER || m_tilesKind == TILES_GUI_DV)
                                     : m_tilesKind == TILES_GUI_HDR;
-  if (m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && maskFits && !m_tilesRects.empty() &&
-      glIsEnabled(GL_SCISSOR_TEST) == GL_FALSE)
+  if (m_guiReusing && m_tilesUse && m_tilesGen == m_guiGen && maskFits && !m_tilesRects.empty())
   {
-    constexpr int TILE = DVBRIDGE_SOURCE_TILE;
+    const GLboolean scissorOn = glIsEnabled(GL_SCISSOR_TEST);
     GLint box[4]{};
     glGetIntegerv(GL_SCISSOR_BOX, box);
     glEnable(GL_SCISSOR_TEST);
+    unsigned int drawn = 0;
     for (const auto& r : m_tilesRects)
     {
-      glScissor(static_cast<GLint>(r.x) * TILE, static_cast<GLint>(r.y) * TILE,
-                static_cast<GLsizei>(r.w) * TILE, static_cast<GLsizei>(r.h) * TILE);
+      int rect[4];
+      if (!dvbridge_tiles_scissor(&r, DVBRIDGE_SOURCE_TILE, scissorOn ? box : nullptr, rect))
+        continue;
+      glScissor(rect[0], rect[1], rect[2], rect[3]);
       glDrawElements(GL_TRIANGLE_STRIP, 4, GL_UNSIGNED_BYTE, idx);
+      ++drawn;
     }
-    glDisable(GL_SCISSOR_TEST);
     glScissor(box[0], box[1], box[2], box[3]);
-    m_dvGuiReuse.Scissored(static_cast<unsigned int>(m_tilesRects.size()), dvComposite);
+    if (!scissorOn)
+      glDisable(GL_SCISSOR_TEST);
+    m_dvGuiReuse.Scissored(drawn, dvComposite);
   }
   else
 #endif
