From d757a651dc9cb7488e8fbed88042d1f89079be7f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:18:05 +0000
Subject: [PATCH] gles: the GUI over HDR converted exactly, without crushing
 its dark tones

Over HDR10, HLG, Dolby Vision (native, shown as HDR10 or HDR10+) and the menus in Dolby Vision, the
GUI, the OSD and text and SDR image subtitles are made PQ or HLG by one shader, gles_gui_composite.frag,
with two LUTs that GuiCompositeShaderGLES makes: the sRGB EOTF, and the PQ signal of linear light.
Both have 256 entries and are sampled at the value itself, which GL takes as a place between texel
centres: the degamma LUT was up to half an entry off (code 1 came out as half of its light), and the
PQ LUT is linear in light, where PQ is steepest near black, so the light between its first entries
was taken on a straight line between their codes. Measured on a software renderer against the
conversion in double precision, at the reference white: a grey of sRGB code 13 at 12-bit luma 494
instead of 746, code 1 black instead of 433, Estuary's dark grey (28, 32, 40) 39 codes low, and up to
452 codes of 4095 off in PQ (664 at a GUI white of 300 %, 58 in HLG). The brighter the GUI white,
the worse, since the LUT then spreads the same entries over more light.

The transfer stays the one this shader and Kodi's OpenGL composite (gl_gui_composite.frag) define:
the sRGB EOTF of IEC 61966-2-1, BT.709 to BT.2020 in linear light, the GUI white of
videoscreen.hadesguiwhite (203 cd/m2 at 100 %, the BT.2408 reference white) and the PQ signal of
SMPTE ST 2084, or Kodi's HLG GUI path unchanged after the EOTF. Where fragment shaders have highp
(every OpenGL ES 3 GPU), the shader now computes it in highp as the OpenGL one does, with the BT.709
to BT.2020 matrix of ITU-R BT.2087 (rounded to four decimals it put the green of a BT.709 blue
0.33 % off, a code in PQ); GuiCompositeShaderGLES gives it the white the LUTs have baked in, taken
with them. Without highp the LUTs stay, as before. Every PQ and HLG path of the GUI goes through
this shader; HDR image subtitles (UHD Blu-ray PGS) do not, and keep their own levels.

Measured on zink over lavapipe with the shader of the tree and with that of 1.0 RC4, every code
0..255 of a grey, a red, a green and a blue ramp and greys over 128 levels of coverage, at GUI
whites of 25, 100 and 300 %: within 0.031 codes of 4095 of the double-precision conversion in PQ
and 0.001 in HLG (1.0 RC4: 261, 452 and 664 in PQ, 23 to 58 in HLG). Every pixel that the GUI does
not cover keeps its bits. Six mutations of the new shader (a 2.4 power for the EOTF, no BT.2020, the
white not taken in PQ or in HLG, the LUTs, the alpha not squared) are caught. Packed in the Dolby
Vision tunnel as the menus are, the codes of known GUI colours are those of the exact conversion
within one code of 4096.
---
 .../shaders/GLES/2.0/gles_gui_composite.frag  | 60 ++++++++++++++++++-
 .../rendering/gles/GuiCompositeShaderGLES.cpp | 12 ++++
 xbmc/rendering/gles/GuiCompositeShaderGLES.h  |  7 +++
 3 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/system/shaders/GLES/2.0/gles_gui_composite.frag b/system/shaders/GLES/2.0/gles_gui_composite.frag
index 7479730..c5a7f90 100644
--- a/system/shaders/GLES/2.0/gles_gui_composite.frag
+++ b/system/shaders/GLES/2.0/gles_gui_composite.frag
@@ -8,20 +8,68 @@
 
 #version 100
 
+// Hades: where fragment shaders have highp (every OpenGL ES 3 GPU), the GUI is converted exactly, as
+// the OpenGL composite shader does (gl_gui_composite.frag): the sRGB EOTF of IEC 61966-2-1, BT.709 to
+// BT.2020 in linear light, and the PQ or HLG signal of that light, all in highp. The LUTs of 256
+// entries, linear in light and sampled off the centres of their texels, darkened the dark tones of the
+// GUI by up to a third of the PQ range (a grey of sRGB code 13 at 12-bit luma 494 where it is 746,
+// code 1 black), and the more the brighter the GUI white. Without highp the LUTs stay, as before.
+#if defined(GL_FRAGMENT_PRECISION_HIGH)
+#define KODI_GUI_EXACT 1
+precision highp float;
+uniform highp sampler2D u_samp; // GUI FBO texture (sRGB, rendered by GUI shaders)
+#else
 precision mediump float;
-varying vec2 v_tex;
 uniform sampler2D u_samp;       // GUI FBO texture (sRGB, rendered by GUI shaders)
+#endif
+varying vec2 v_tex;
 uniform sampler2D u_lutDegamma; // sRGB -> linear LUT (IEC 61966-2-1)
 uniform sampler2D u_lutTF;      // linear -> PQ LUT (1024 entries, sdrPeak baked in)
 uniform float u_ootfGamma;      // HLG: OOTF gamma (1.2 for BT.2100 1000-nit ref)
                                 // PQ: 0.0 (use LUT path instead)
+#if defined(KODI_GUI_EXACT)
+// Hades: PQ: the GUI white in units of 10000 cd/m2 (what the PQ LUT has baked in); HLG: the GUI white
+// against the reference white (what the degamma LUT has baked in)
+uniform float u_pqPeak;
+uniform float u_hlgWhite;
+#endif
 
 // BT.709 -> BT.2020 color space conversion matrix (applied in linear light)
+#if defined(KODI_GUI_EXACT)
+// Hades: as ITU-R BT.2087 gives it: rounded to 4 decimals, the green of a BT.709 blue was 0.33 % off, a code
+// of 4095 in PQ at the reference white
+const mat3 bt709_to_bt2020 = mat3(
+  0.627403896, 0.069097289, 0.016391439,
+  0.329283038, 0.919540395, 0.088013308,
+  0.043313066, 0.011362316, 0.895595253
+);
+#else
 const mat3 bt709_to_bt2020 = mat3(
   0.6274,  0.0691,  0.0164,
   0.3293,  0.9195,  0.0880,
   0.0433,  0.0114,  0.8956
 );
+#endif
+
+#if defined(KODI_GUI_EXACT)
+// IEC 61966-2-1 sRGB EOTF (as GuiCompositeShaderGLES::SRGBToLinear() and gl_gui_composite.frag)
+vec3 srgbToLinear(vec3 c)
+{
+  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
+}
+
+// SMPTE ST 2084 inverse EOTF of linear light in units of 10000 cd/m2
+vec3 forwardPQ(vec3 L)
+{
+  const float m1 = 0.1593017578125; // 2610/16384
+  const float m2 = 78.84375;        // 2523/4096 * 128
+  const float c1 = 0.8359375;       // 3424/4096
+  const float c2 = 18.8515625;      // 2413/4096 * 32
+  const float c3 = 18.6875;         // 2392/4096 * 32
+  vec3 Lm1 = pow(max(L, vec3(0.0)), vec3(m1));
+  return pow((c1 + c2 * Lm1) / (1.0 + c3 * Lm1), vec3(m2));
+}
+#endif
 
 void main()
 {
@@ -33,12 +81,18 @@ void main()
   if (gui.a == 0.0)
     discard;
 
+#if defined(KODI_GUI_EXACT)
+  vec3 linear = srgbToLinear(clamp(gui.rgb, 0.0, 1.0));
+  if (u_ootfGamma > 0.0)
+    linear *= u_hlgWhite;
+#else
   // sRGB -> linear via LUT (IEC 61966-2-1 EOTF, replaces inline pow)
   vec3 linear = vec3(
     texture2D(u_lutDegamma, vec2(gui.r, 0.5)).r,
     texture2D(u_lutDegamma, vec2(gui.g, 0.5)).r,
     texture2D(u_lutDegamma, vec2(gui.b, 0.5)).r
   );
+#endif
 
   // BT.709 -> BT.2020 gamut mapping
   linear = bt709_to_bt2020 * linear;
@@ -70,12 +124,16 @@ void main()
   }
   else
   {
+#if defined(KODI_GUI_EXACT)
+    result = forwardPQ(linear * u_pqPeak);
+#else
     // PQ path: LUT lookup (sdrPeak baked into LUT range)
     result = vec3(
       texture2D(u_lutTF, vec2(linear.r, 0.5)).r,
       texture2D(u_lutTF, vec2(linear.g, 0.5)).r,
       texture2D(u_lutTF, vec2(linear.b, 0.5)).r
     );
+#endif
   }
 
   // Limited-range encoding at the BO write boundary. Canonical normalized
diff --git a/xbmc/rendering/gles/GuiCompositeShaderGLES.cpp b/xbmc/rendering/gles/GuiCompositeShaderGLES.cpp
index 105c1ce..ccd5c8f 100644
--- a/xbmc/rendering/gles/GuiCompositeShaderGLES.cpp
+++ b/xbmc/rendering/gles/GuiCompositeShaderGLES.cpp
@@ -63,6 +63,9 @@ void CGuiCompositeShaderGLES::OnCompiledAndLinked()
   m_hLutTF = glGetUniformLocation(ProgramHandle(), "u_lutTF");
   m_hProj = glGetUniformLocation(ProgramHandle(), "u_proj");
   m_hOotfGamma = glGetUniformLocation(ProgramHandle(), "u_ootfGamma");
+  // Hades: (-1 where the shader converts with the LUTs: no highp)
+  m_hPqPeak = glGetUniformLocation(ProgramHandle(), "u_pqPeak");
+  m_hHlgWhite = glGetUniformLocation(ProgramHandle(), "u_hlgWhite");
   glUseProgram(ProgramHandle());
   glUniform1i(m_hSamp, 0);
   glUniform1i(m_hLutDegamma, 1);
@@ -76,6 +79,10 @@ bool CGuiCompositeShaderGLES::OnEnabled()
     glUniformMatrix4fv(m_hProj, 1, GL_FALSE, m_proj);
 
   glUniform1f(m_hOotfGamma, m_ootfGamma);
+  if (m_hPqPeak >= 0)
+    glUniform1f(m_hPqPeak, m_pqPeak);
+  if (m_hHlgWhite >= 0)
+    glUniform1f(m_hHlgWhite, m_hlgWhite);
 
   glActiveTexture(GL_TEXTURE1);
   glBindTexture(GL_TEXTURE_2D, m_lutDegammaTexId);
@@ -176,6 +183,8 @@ bool CGuiCompositeShaderGLES::CreateLUTs(int colorTransfer, int referenceWhite)
   GLuint degamma = 0;
   GLuint tf = 0;
   float ootfGamma = 0.0f;
+  float pqPeak = 203.0f * white / 10000.0f;
+  float hlgWhite = 1.0f;
   if (colorTransfer == AVCOL_TRC_SMPTE2084)
   {
     // PQ is absolute: the TF LUT covers [0, white * 203 nits]
@@ -204,6 +213,7 @@ bool CGuiCompositeShaderGLES::CreateLUTs(int colorTransfer, int referenceWhite)
     // HLG is relative to its 1000-nit reference display, where the shader puts linear 1.0 at
     // 203 nits: the linear GUI light itself is scaled.
     degamma = CreateLUTTexture(GenerateDegammaLUT(white));
+    hlgWhite = white;
     if (!degamma)
     {
       CLog::Log(LOGERROR, "CGuiCompositeShaderGLES::CreateLUTs - failed to create degamma LUT");
@@ -229,6 +239,8 @@ bool CGuiCompositeShaderGLES::CreateLUTs(int colorTransfer, int referenceWhite)
   m_lutDegammaTexId = degamma;
   m_lutTFTexId = tf;
   m_ootfGamma = ootfGamma;
+  m_pqPeak = pqPeak;
+  m_hlgWhite = hlgWhite;
   m_referenceWhite = referenceWhite;
   return true;
 }
diff --git a/xbmc/rendering/gles/GuiCompositeShaderGLES.h b/xbmc/rendering/gles/GuiCompositeShaderGLES.h
index 4f4f4c3..71b6d96 100644
--- a/xbmc/rendering/gles/GuiCompositeShaderGLES.h
+++ b/xbmc/rendering/gles/GuiCompositeShaderGLES.h
@@ -48,6 +48,11 @@ private:
   GLuint m_lutDegammaTexId{0};
   GLuint m_lutTFTexId{0};
   float m_ootfGamma{0.0f};
+  //! Hades: what the LUTs have baked in, for the exact conversion of the shader where it has highp
+  //! (gles_gui_composite.frag, KODI_GUI_EXACT): the GUI white in PQ units (PQ), and against the
+  //! reference white (HLG); taken with the LUTs, so that a failed rebuild keeps both
+  float m_pqPeak{0.0203f};
+  float m_hlgWhite{1.0f};
 
   GLint m_hPos{-1};
   GLint m_hTex{-1};
@@ -56,4 +61,6 @@ private:
   GLint m_hLutTF{-1};
   GLint m_hProj{-1};
   GLint m_hOotfGamma{-1};
+  GLint m_hPqPeak{-1};
+  GLint m_hHlgWhite{-1};
 };
-- 
2.53.0

