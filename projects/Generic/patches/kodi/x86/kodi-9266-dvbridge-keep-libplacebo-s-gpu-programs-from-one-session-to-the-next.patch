 }
 
@@ -128,6 +136,123 @@ std::string DescribeMetadata(const void* metadata)
       static_cast<unsigned int>(color->source_min_pq),
       static_cast<unsigned int>(color->source_max_pq), levels.empty() ? "none" : levels);
 }
+
+// Hades: the GPU programs that libplacebo makes, kept from one session to the next (see
+// dvbridge_cache.h). Each program of a video is linked when it is first drawn, and a new one at
+// any frame that needs another (an enhancement layer, the bars written first, a frame with GUI
+// elements, the other way of drawing): at the start of every video, and in the middle of some.
+// A program that the driver gives back as a binary is taken from here the next time, and linked
+// from that. One cache for each GPU, driver and build (the GL strings, which with Mesa carry its
+// version and the kernel's, the name and version of the system, and libplacebo's version): each
+// in a file of its own under Kodi's temporary folder, of which the four written last are kept,
+// for a disk that is started on more than one computer. A cache is never freed: a pl_gpu that
+// was given one may use it until it goes.
+constexpr size_t SHADER_CACHE_BYTES = 32 * 1024 * 1024;
+constexpr size_t SHADER_CACHE_FILES = 4;
+constexpr const char* SHADER_CACHE_FOLDER = "special://temp/dvbridge/";
+constexpr const char* SHADER_CACHE_SUFFIX = ".plcache";
+
+struct ShaderCache
+{
+  std::string path;
+  dvbridge_shader_cache* cache = nullptr;
+  bool failed = false; //!< writing it failed, which was logged
+};
+
+// (made once and never destroyed, so that a bridge that goes after the static objects of the
+// process finds them)
+std::mutex& ShaderCacheLock()
+{
+  static auto* lock = new std::mutex();
+  return *lock;
+}
+
+std::vector<ShaderCache>& ShaderCaches()
+{
+  static auto* caches = new std::vector<ShaderCache>();
+  return *caches;
+}
+
+uint64_t TextKey(const std::string& text)
+{
+  // FNV-1a
+  uint64_t key = UINT64_C(14695981039346656037);
+  for (const char c : text)
+  {
+    key ^= static_cast<unsigned char>(c);
+    key *= UINT64_C(1099511628211);
+  }
+  return key;
+}
+
+std::string GLText(GLenum name)
+{
+  const GLubyte* value = glGetString(name);
+  return value ? reinterpret_cast<const char*>(value) : "";
+}
+
+// The cache for the GPU, driver and build of the current GL context; nullptr when that cannot be
+// told (no GL strings) or there is no memory for it.
+pl_cache OpenShaderCache()
+{
+  const std::string renderer = GLText(GL_RENDERER);
+  if (renderer.empty())
+    return nullptr;
+  const std::string identity = GLText(GL_VENDOR) + '\n' + renderer + '\n' + GLText(GL_VERSION) +
+                               '\n' + CSysInfo::GetOsPrettyNameWithVersion() + '\n' + pl_version();
+  const std::string folder = CSpecialProtocol::TranslatePath(SHADER_CACHE_FOLDER);
+  const std::string path =
+      folder + StringUtils::Format("shaders-{:016x}{}", TextKey(identity), SHADER_CACHE_SUFFIX);
+  std::lock_guard lock(ShaderCacheLock());
+  for (const auto& known : ShaderCaches())
+    if (known.path == path)
+      return dvbridge_shader_cache_get(known.cache);
+  std::error_code error;
+  std::filesystem::create_directories(folder, error);
+  // what a write that did not end left (a write goes to a file of its own, renamed when whole)
+  for (auto entry = std::filesystem::directory_iterator(folder, error);
+       !error && entry != std::filesystem::directory_iterator(); entry.increment(error))
+  {
+    std::error_code ignored;
+    if (entry->path().extension() == ".tmp")
+      std::filesystem::remove(entry->path(), ignored);
+  }
+  dvbridge_shader_cache* cache = dvbridge_shader_cache_open(path.c_str(), SHADER_CACHE_BYTES, nullptr);
+  if (!cache)
+    return nullptr;
+  ShaderCaches().push_back({path, cache, false});
+  int entries = 0;
+  size_t bytes = 0;
+  dvbridge_shader_cache_size(cache, &entries, &bytes);
+  CLog::Log(LOGINFO,
+            "DVBridge: GPU programs of earlier sessions with this GPU, driver and build: {} taken "
+            "from {} ({} KiB)",
+            dvbridge_shader_cache_loaded(cache), path, bytes / 1024);
+  return dvbridge_shader_cache_get(cache);
+}
+
+// The files of the most recently written caches are kept, the others deleted
+void PruneShaderCaches(const std::string& folder)
+{
+  std::vector<std::pair<std::filesystem::file_time_type, std::filesystem::path>> files;
+  std::error_code error;
+  for (auto entry = std::filesystem::directory_iterator(folder, error);
+       !error && entry != std::filesystem::directory_iterator(); entry.increment(error))
+  {
+    std::error_code ignored;
+    if (entry->path().extension() == SHADER_CACHE_SUFFIX)
+      files.emplace_back(entry->last_write_time(ignored), entry->path());
+  }
+  if (files.size() <= SHADER_CACHE_FILES)
+    return;
+  std::sort(files.begin(), files.end(),
+            [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (size_t n = SHADER_CACHE_FILES; n < files.size(); ++n)
+  {
+    std::error_code ignored;
+    std::filesystem::remove(files[n].second, ignored);
+  }
+}
 } // namespace
 
 CDVBridgeGLES::~CDVBridgeGLES()
@@ -135,6 +260,7 @@ CDVBridgeGLES::~CDVBridgeGLES()
   CDVPlaybackInfo::presented.store(0);
   if (m_gl)
     TakeStaleGLErrors("the bridge is destroyed");
+  SaveShaderCache();
   LogLayerCache();
   dvbridge_dmabuf_cache_destroy(m_layerCache);
   glDeleteFramebuffers(1, &m_framebuffer);
@@ -147,6 +273,41 @@ CDVBridgeGLES::~CDVBridgeGLES()
   pl_log_destroy(&m_log);
 }
 
+void CDVBridgeGLES::UseShaderCache()
+{
+  if (const pl_cache cache = OpenShaderCache())
+    pl_gpu_set_cache(m_gl->gpu, cache);
+}
+
+void CDVBridgeGLES::SaveShaderCache()
+{
+  // At the end of native output, and of a bridge: not while a video plays. Rarely anything:
+  // only what was linked since the file was read or written.
+  std::lock_guard lock(ShaderCacheLock());
+  bool written = false;
+  for (auto& known : ShaderCaches())
+  {
+    const int saved = dvbridge_shader_cache_save(known.cache);
+    if (saved > 0)
+    {
+      int entries = 0;
+      size_t bytes = 0;
+      dvbridge_shader_cache_size(known.cache, &entries, &bytes);
+      CLog::Log(LOGINFO, "DVBridge: {} GPU programs kept for the next sessions in {} ({} KiB)",
+                entries, known.path, bytes / 1024);
+      known.failed = false;
+      written = true;
+    }
+    else if (saved < 0 && !known.failed)
+    {
+      known.failed = true;
+      CLog::Log(LOGWARNING, "DVBridge: the GPU programs could not be kept in {}", known.path);
+    }
+  }
+  if (written)
+    PruneShaderCaches(CSpecialProtocol::TranslatePath(SHADER_CACHE_FOLDER));
+}
+
 void CDVBridgeGLES::LogLayerCache()
 {
   unsigned long reused = 0, made = 0;
@@ -223,6 +384,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   m_gl = pl_opengl_create(m_log, &params);
   if (!m_gl)
     return Fail("libplacebo-opengl");
+  UseShaderCache();
   // GUI alpha blending takes place in the 32F PQ target, before transport packing.
   if (!pl_opengl_has_ext(m_gl, "GL_EXT_float_blend") ||
       !pl_opengl_has_ext(m_gl, "GL_OES_texture_float_linear"))
@@ -282,9 +444,11 @@ void CDVBridgeGLES::Reset()
   if (m_gl)
     TakeStaleGLErrors("the renderer is reset");
   dvbridge_renderer_reset(m_renderer);
-  // The end of native output: the surfaces of the enhancement layer of this video are let go.
+  // The end of native output: the surfaces of the enhancement layer of this video are let go, and
+  // the programs that were linked for it kept for the next sessions.
   LogLayerCache();
   dvbridge_dmabuf_cache_clear(m_layerCache);
+  SaveShaderCache();
 }
 
 bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
@@ -638,6 +802,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   m_gl = pl_opengl_create(m_log, &params);
   if (!m_gl)
     return Fail("libplacebo-opengl");
+  UseShaderCache();
   m_conversion = true;
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
   m_copier = dvbridge_gl_copier_create();
