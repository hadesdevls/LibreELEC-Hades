@@ -481,6 +481,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
                        "reconstruction, as advancedsettings.xml asks (dvearlymask)");
   }
   UseComposerSetting();
+  UseGamutSetting();
   // Hades: the transport that UseSourceTransport() asked for, also for a renderer made after it
   dvbridge_render_use_source_transport(m_renderer, m_sourceWanted);
   // ... and Low-Latency (SetLowLatency())
@@ -794,6 +795,8 @@ void CDVBridgeGLES::LogEarlyMask(bool packed)
 
 void CDVBridgeGLES::LogNotes()
 {
+  // Hades: and the gamut mapping table of a picture that was mapped
+  LogGamutTable();
   dvbridge_render_notes notes{};
   if (!m_renderer || !dvbridge_render_take_notes(m_renderer, &notes))
     return;
@@ -1263,6 +1266,49 @@ void CDVBridgeGLES::UseComposer(bool ccm)
   UseComposerSetting();
 }
 
+void CDVBridgeGLES::UseGamutSetting()
+{
+  if (m_renderer)
+    dvbridge_render_set_gamut_table(m_renderer, m_fineGamut ? DVBRIDGE_GAMUT_TABLE_FINE
+                                                            : DVBRIDGE_GAMUT_TABLE_STANDARD);
+}
+
+void CDVBridgeGLES::UseGamutTable(bool fine)
+{
+  m_fineGamut = fine;
+  UseGamutSetting();
+}
+
+void CDVBridgeGLES::LogGamutTable()
+{
+  dvbridge_gamut_table table{};
+  if (!m_renderer || !dvbridge_render_gamut_table(m_renderer, &table))
+    return;
+  if (m_gamutLogged && table.asked == m_gamutLast.asked && table.used == m_gamutLast.used &&
+      table.fine_failed == m_gamutLast.fine_failed && table.format == m_gamutLast.format)
+    return;
+  m_gamutLogged = true;
+  m_gamutLast = table;
+  if (!table.format)
+  {
+    // (libplacebo-9950: none of 16-bit unorm, 32-bit or 16-bit floats with linear filtering)
+    CLog::Log(LOGWARNING, "DVBridge: the graphics card filters no texture format that the gamut "
+                          "mapping table can be kept in: libplacebo maps the colours that the "
+                          "display cannot show by saturation, not perceptually");
+    return;
+  }
+  const bool fine = table.used == DVBRIDGE_GAMUT_TABLE_FINE;
+  CLog::Log(table.fine_failed ? LOGWARNING : LOGINFO,
+            "DVBridge: the gamut mapping table is the {} one, {}x{}x{} in {}, {:.0f} MiB of the "
+            "graphics card's memory{}",
+            fine ? "finer" : "standard", table.size[0], table.size[1], table.size[2], table.format,
+            static_cast<double>(table.bytes) / 1048576.0,
+            table.fine_failed ? ": the finer one that the settings ask for "
+                                "(videoscreen.hadesdvgamutfine) could not be made"
+            : fine            ? ", as the settings ask (videoscreen.hadesdvgamutfine)"
+                              : "");
+}
+
 bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
 {
   if (m_gl)
@@ -1293,6 +1339,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   m_conversion = true;
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
   UseComposerSetting();
+  UseGamutSetting();
   m_copier = dvbridge_gl_copier_create();
   CLog::Log(LOGDEBUG, "DVBridge: GL initialized for output as HDR10 renderer={} copier={}",
             m_renderer != nullptr, m_copier != nullptr);
