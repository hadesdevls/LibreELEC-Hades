+  void UseGamutTable(bool fine);
   /*!
    * \brief What the work of preparing a frame depends on, from its metadata, before it is prepared
    * \param enhancement the frame comes with a picture of its enhancement layer
@@ -368,6 +374,11 @@ private:
   void LogRefusal(const char* why);
   //! The composer of the renderer, as UseComposer() asked (with a renderer that has just been made)
   void UseComposerSetting();
+  //! The gamut mapping table of the renderer, as UseGamutTable() asked
+  void UseGamutSetting();
+  //! Hades: which gamut mapping table the last mapping took, when that is new (once for a table
+  //! and its format)
+  void LogGamutTable();
   //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
   //! \param before what runs next, for the log
   void TakeStaleGLErrors(const char* before);
@@ -388,6 +399,9 @@ private:
   bool m_layerWithoutResidual = false;
   bool m_layerNotDecoded = false;
   bool m_ccmComposer = true; //!< Hades: see UseComposer()
+  bool m_fineGamut = false; //!< Hades: see UseGamutTable()
+  bool m_gamutLogged = false; //!< Hades: see LogGamutTable()
+  dvbridge_gamut_table m_gamutLast{};
   DVBRIDGE::DiagnosticFailures m_failures;
   unsigned int m_staleGLErrors = 0; //!< times that TakeStaleGLErrors() found some
   bool m_reportedFrame{false};
