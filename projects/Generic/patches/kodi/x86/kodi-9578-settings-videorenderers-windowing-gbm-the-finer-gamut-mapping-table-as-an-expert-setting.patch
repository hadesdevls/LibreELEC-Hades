 }
+
+// Hades: the gamut mapping table of a picture rebuilt for output as HDR10 or mapped to SDR, as the
+// settings say now (videoscreen.hadesdvgamutfine): a bridge for it takes it when it is made; native
+// output reads it when it starts (CWinSystemGbmGLESContext::DVEngineRead())
+bool ConversionFineGamut()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  return BoolSetting(component ? component->GetSettings() : nullptr,
+                     CSettings::SETTING_VIDEOSCREEN_HADESDVGAMUTFINE, false);
+}
 } // namespace
 
