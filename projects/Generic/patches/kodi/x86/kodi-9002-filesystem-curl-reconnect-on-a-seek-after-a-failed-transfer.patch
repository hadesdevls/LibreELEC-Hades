From 5991540b1f1846df0aee58651c66e12ed85e456d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 00:44:24 +0000
Subject: [PATCH] filesystem/curl: reconnect on a seek after a failed transfer

When a transfer ends with an error that FillBuffer() does not retry,
for example HTTP 429 on the range request of a seek, the read state
keeps its position and an empty buffer. A later Seek() to that same
position returned true from CReadState::Seek() without any request (a
zero-byte skip also succeeds on an empty buffer), so every read after
it returned no data. CFileCache now reopens such a source at its write
position; for that to reach the server, the seek must reconnect.

Mark the read state when FillBuffer() gives up on an error, and let
CReadState::Seek() fail while the mark is set, so that CCurlFile::Seek()
takes its usual reconnect path (the other multisession state or a new
connection). Connect() and Disconnect() clear the mark. Nothing waits
or retries here, so callers on the GUI thread are not slowed down.
---
 xbmc/filesystem/CurlFile.cpp | 9 +++++++++
 xbmc/filesystem/CurlFile.h   | 1 +
 2 files changed, 10 insertions(+)

diff --git a/xbmc/filesystem/CurlFile.cpp b/xbmc/filesystem/CurlFile.cpp
index be9e0c2..c1a811b 100644
--- a/xbmc/filesystem/CurlFile.cpp
+++ b/xbmc/filesystem/CurlFile.cpp
@@ -325,6 +325,11 @@ CCurlFile::CReadState::~CReadState()
 
 bool CCurlFile::CReadState::Seek(int64_t pos)
 {
+  // A failed transfer has nothing to seek in, not even at its own position: let the caller
+  // reconnect instead of reporting a seek that did not happen.
+  if (m_transferFailed)
+    return false;
+
   if(pos == m_filePos)
     return true;
 
@@ -390,6 +395,8 @@ void CCurlFile::CReadState::SetResume(void)
 
 long CCurlFile::CReadState::Connect(unsigned int size)
 {
+  m_transferFailed = false;
+
   if (m_filePos != 0)
     CLog::Log(LOGDEBUG, "CurlFile::CReadState::{} - ({}) Resume from position {}", __FUNCTION__,
               fmt::ptr(this), m_filePos);
@@ -451,6 +458,7 @@ void CCurlFile::CReadState::Disconnect()
   m_fileSize = 0;
   m_bufferSize = 0;
   m_readBuffer = 0;
+  m_transferFailed = false;
 
   /* cleanup */
   if( m_curlHeaderList )
@@ -1846,6 +1854,7 @@ int8_t CCurlFile::CReadState::FillBuffer(unsigned int want)
             else
             {
               // For all other errors, abort the operation
+              m_transferFailed = true;
               return FILLBUFFER_FAIL;
             }
           }
diff --git a/xbmc/filesystem/CurlFile.h b/xbmc/filesystem/CurlFile.h
index 2bc40ed..e4eee95 100644
--- a/xbmc/filesystem/CurlFile.h
+++ b/xbmc/filesystem/CurlFile.h
@@ -119,6 +119,7 @@ namespace XFILE
           bool m_sendRange;
           bool m_bLastError;
           bool m_bRetry;
+          bool m_transferFailed = false; // ended with an error that FillBuffer does not retry
 
           char* m_readBuffer;
 
