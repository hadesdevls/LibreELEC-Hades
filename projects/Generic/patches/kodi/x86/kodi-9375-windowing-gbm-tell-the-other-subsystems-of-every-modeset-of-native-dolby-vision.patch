From e13166d97faa5a6be1ebf8c47e90bab5f4e47e77 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:58:12 +0000
Subject: [PATCH] windowing/gbm: tell the other subsystems of every modeset of
 native Dolby Vision

The first frame of the transport and the restoration of the ordinary output
after it are full modesets with every backend: the depth, the dither and the
InfoFrames change, and with i915 and amdgpu the tunnel property of the
connector. Only those that carried a change of mode that was held
(CHeldModeAnnouncement) were told to the display resources. The audio
engine closes its HDMI sink only when it is told that the display is lost
(DISPLAYLOST), and so went on writing through the others: the start of
native output where the mode does not change (the refresh rate not adjusted,
a video at the rate of the GUI, the second video of a list once the first
ended with the change of mode), its end where it is not joined with a change
of mode, and the return to the ordinary output after a failure in the middle
of a video. That is the issue #3 of CroqueMr's fork (i5-1135G7: 3 s of stop
when native output starts, and a crash when it stops).

CHeldModeAnnouncement::Modeset() now has such a commit told like a held
change, unless one is told with it already: the frame that sets up the
transport (never presented a frame ahead), and the first attempt of each
restoration. Not the restoration that goes with the change of mode (it is
told by SetFullScreen()), its retries after a refusal, nor the one made while
the window or the window system goes (EndDVBridge(false)).
---
 xbmc/windowing/gbm/ModeChangeHold.h            | 10 ++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 16 +++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  4 +++-
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/gbm/ModeChangeHold.h b/xbmc/windowing/gbm/ModeChangeHold.h
index d1456e4..1ddec60 100644
--- a/xbmc/windowing/gbm/ModeChangeHold.h
+++ b/xbmc/windowing/gbm/ModeChangeHold.h
@@ -261,6 +261,16 @@ public:
     m_step = Step::BEFORE_NEXT;
     m_alone = false;
   }
+  //! Hades: a commit that is a full modeset without being a change of mode is about to be made:
+  //! the first frame of native Dolby Vision output, or the restoration of the ordinary output
+  //! after it (every backend makes a modeset for the transport). It is told like a held change,
+  //! unless one is told with it already. Before, only those that carried a held change were: the
+  //! audio engine went on writing to the HDMI output through the others (on i915, a stop of 3 s).
+  void Modeset()
+  {
+    if (m_step == Step::NONE)
+      Held();
+  }
   //! Another change of mode is made, which tells of itself: this one is not told
   void Dropped()
   {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index ebc4b34..68eb626 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -462,6 +462,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         flip.ahead = ahead;
         const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
         plainFrame = m_dvState.TransportLive() && atomic && !atomic->HasPendingRequest();
+        // Hades: the frame that sets up the transport is a full modeset with every backend: told
+        // as a change of mode (CHeldModeAnnouncement::Modeset()). It is not presented a frame
+        // ahead (DVAheadWanted() waits for the transport).
+        if (!m_dvState.TransportLive())
+          m_modeAnnounce.Modeset();
         AnnounceHeldModeChange(true);
         presented = FlipDVBridgePage(m_dvState, false, &flip);
         presentedAhead = presented && flip.ahead;
@@ -2323,7 +2328,7 @@ bool CWinSystemGbmGLESContext::DestroyWindow()
   // made while the window is still there: Kodi can stop (quit, restart, power off) without a
   // change of mode, and its window goes before its window system, whose end restores too late.
   if (m_dvState.Captured())
-    EndDVBridge();
+    EndDVBridge(false);
   // Hades: nothing waits for a window that goes (the next commit is of another one)
   if (m_modeHold.Cancel())
     TellModeHoldEnd();
@@ -2331,7 +2336,7 @@ bool CWinSystemGbmGLESContext::DestroyWindow()
   return CWinSystemGbmEGLContext::DestroyWindow();
 }
 
-bool CWinSystemGbmGLESContext::EndDVBridge()
+bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset)
 {
   // (Any restoration ends the wait of EndDVBridgeAfterVideo(). One that ends it puts back, after the
   // output state of before the video, what Kodi has asked for since: the renderer that went cleared
@@ -2372,6 +2377,11 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
     glClearColor(0, 0, 0, 1);
     glClear(GL_COLOR_BUFFER_BIT);
     glFinish();
+    // Hades: leaving the transport is a full modeset with every backend: told as a change of mode
+    // (CHeldModeAnnouncement::Modeset()), unless the change of mode that it goes with tells of
+    // itself, it is made again after a refusal, or the window goes
+    if (tellModeset && m_dvState.TransportLive() && !m_dvRestoreWithMode && !m_dvRestoreFailures)
+      m_modeAnnounce.Modeset();
     if (!m_eglContext.TrySwapBuffers() || !FlipDVBridgePage(m_dvState, true))
     {
       // Retried once a second while the display refuses it (switched off): logged sparingly.
@@ -3805,7 +3815,7 @@ void CWinSystemGbmGLESContext::DVBridgeFrameShown(bool shown, double pts)
 
 bool CWinSystemGbmGLESContext::DestroyWindowSystem()
 {
-  if (!EndDVBridge())
+  if (!EndDVBridge(false))
     return false;
   m_dvBridge.reset();
   EndDVConversion();
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index b45922b..a26e3be 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -106,7 +106,9 @@ public:
                        dvbridge_geometry geometry,
                        unsigned int serial = 0,
                        bool layerNotDecoded = false);
-  bool EndDVBridge();
+  //! \param tellModeset (Hades) the other subsystems are told of the modeset that leaving the
+  //!        transport is (not while the window or the window system goes)
+  bool EndDVBridge(bool tellModeset = true);
   //! Hades: the end of native Dolby Vision output when its video stops (renderer teardown). Where
   //! Kodi then sets another mode of the size of the window (DVEndWaitsForMode(): with every
   //! backend), the ordinary output waits for that change of mode, DV_END_WAIT at most, with the
-- 
