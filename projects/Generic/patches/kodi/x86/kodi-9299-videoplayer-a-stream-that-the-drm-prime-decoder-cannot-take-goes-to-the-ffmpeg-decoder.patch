+        else if (!m_packets.empty())
+          m_packets.clear();
 
         m_videoStats.AddSampleBytes(pPacket->iSize);
         UpdatePlayerInfo();
@@ -613,6 +617,33 @@ void CVideoPlayerVideo::Process()
   }
 }
 
+// Hades: the decoder cannot decode the stream (CDVDVideoCodecDRMPRIME, offered no picture format
+// that it takes): the packets kept for it go again, ahead of the one it left (put back), to a
+// decoder that is not one of the platform's. Once: only those hand a stream back.
+void CVideoPlayerVideo::HandBack()
+{
+  CLog::Log(LOGINFO,
+            "CVideoPlayerVideo - the video decoder {} cannot decode this stream: it goes, with "
+            "the {} packet(s) kept for it, to a decoder that is not the platform's",
+            m_pVideoCodec->GetName(), m_packets.size());
+  while (!m_packets.empty())
+  {
+    auto msg = std::static_pointer_cast<CDVDMsgDemuxerPacket>(m_packets.front().message);
+    m_packets.pop_front();
+    SendMessage(msg, 10);
+  }
+
+  CDVDStreamInfo hint(m_hints);
+  hint.codecOptions |= CODEC_HANDED_BACK;
+  m_pVideoCodec.reset();
+  OpenStream(hint, nullptr);
+  if (m_picture.videoBuffer)
+  {
+    m_picture.videoBuffer->Release();
+    m_picture.videoBuffer = nullptr;
+  }
+}
