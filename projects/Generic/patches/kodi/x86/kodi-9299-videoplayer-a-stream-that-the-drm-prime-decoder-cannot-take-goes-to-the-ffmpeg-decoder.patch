     av_strerror(ret, err, AV_ERROR_MAX_STRING_SIZE);
     CLog::Log(LOGERROR, "CDVDVideoCodecDRMPRIME::{} - receive frame failed: {} ({})", __FUNCTION__,
               err, ret);
-    return VC_ERROR;
+    return m_handBack.HandBack() ? HandBack() : VC_ERROR;
   }
 
