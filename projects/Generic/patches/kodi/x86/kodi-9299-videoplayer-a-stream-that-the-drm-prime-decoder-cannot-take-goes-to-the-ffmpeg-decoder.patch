       (hints.codec == AV_CODEC_ID_H264 && (hints.profile == AV_PROFILE_H264_HIGH_10 ||
@@ -479,6 +487,10 @@ bool CDVDVideoCodecDRMPRIME::AddData(const DemuxPacket& packet)
   if (!packet.pData)
