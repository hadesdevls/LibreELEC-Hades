   if (ret == AVERROR(EAGAIN))
     return false;
   else if (ret)
@@ -518,6 +534,7 @@ bool CDVDVideoCodecDRMPRIME::AddData(const DemuxPacket& packet)
       return false;
   }
 
+  m_handBack.Took();
   return true;
 }
 
@@ -547,6 +564,7 @@ void CDVDVideoCodecDRMPRIME::Reset()
 
   CLog::Log(LOGDEBUG, "CDVDVideoCodecDRMPRIME::{} - flush buffers", __FUNCTION__);
