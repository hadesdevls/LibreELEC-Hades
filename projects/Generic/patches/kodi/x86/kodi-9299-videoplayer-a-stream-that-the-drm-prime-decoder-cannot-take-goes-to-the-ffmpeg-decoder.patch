diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DRMPRIMEHandBack.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DRMPRIMEHandBack.h
new file mode 100644
index 0000000..8e8ed0a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DRMPRIMEHandBack.h
@@ -0,0 +1,64 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <atomic>
+
+/*!
+ * \brief Hades: when CDVDVideoCodecDRMPRIME gives its stream back to a decoder of VideoPlayer's own
+ *
+ * Its FFmpeg decoder asks it for a picture format (get_format()). One that it does not take (in
+ * software, any of more than 8 bits) leaves FFmpeg without a format: every packet is then refused
+ * (EPERM), and VideoPlayer, told to send it again, sent the same packet for ever, with no picture.
+ * Open() declines a stream whose hints say more than 8 bits, but the hints can be wrong: a
+ * transport stream that is joined live is opened without avformat_find_stream_info(), and the hint
+ * of a 10-bit HEVC channel says 8 bits. So the format that the decoder offers decides, whatever the
+ * hints said:
+ *  - a format refused: AddData() leaves every packet with VideoPlayer (false), and GetPicture()
+ *    answers VC_HANDBACK, on which VideoPlayer gives the stream to a decoder that is not one of the
+ *    platform's (CODEC_HANDED_BACK), with the packets it kept for this one;
+ *  - until a format is taken, VideoPlayer keeps the packets that this decoder took (its converge
+ *    count: as many, and at most 300, as CDVDVideoCodecFFmpeg keeps since a key frame), so that the
+ *    next decoder starts where this one started; once one is taken, none.
+ * A format refused after one was taken (a stream that changes to more bits) has no packets kept:
+ * the next decoder starts at the packet that VideoPlayer still has, and gives pictures from the
+ * next key frame on.
+ */
+class CDRMPRIMEHandBack
+{
+public:
+  static constexpr unsigned MAX_KEPT = 300;
+
+  //! A decoder is opened for the stream
+  void Open()
+  {
+    m_refused = false;
+    m_taken = false;
+    m_took = 0;
+  }
+  //! get_format() took a format, or found none to take (on any of the decoder's threads)
+  void Format(bool taken) { (taken ? m_taken : m_refused).store(true); }
+  //! The decoder cannot decode the stream: it goes to the next one
+  bool HandBack() const { return m_refused; }
+  //! AddData() gave a packet to the decoder
+  void Took()
+  {
+    if (m_took < MAX_KEPT)
+      ++m_took;
+  }
+  //! The decoder was flushed (VideoPlayer drops what it kept)
+  void Flushed() { m_took = 0; }
+  //! How many of the packets that it took VideoPlayer is to keep (GetConvergeCount())
+  unsigned Kept() const { return m_taken ? 0 : m_took; }
+
+private:
+  std::atomic<bool> m_refused{false};
+  std::atomic<bool> m_taken{false};
+  unsigned m_took = 0;
+};
