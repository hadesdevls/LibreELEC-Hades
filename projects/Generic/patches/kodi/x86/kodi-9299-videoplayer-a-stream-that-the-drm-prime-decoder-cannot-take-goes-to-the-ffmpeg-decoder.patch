+  if (m_handBack.HandBack())
+    return false;
+
   AVPacket* avpkt = av_packet_alloc();
   if (!avpkt)
   {
@@ -506,6 +518,10 @@ bool CDVDVideoCodecDRMPRIME::AddData(const DemuxPacket& packet)
   av_buffer_unref(&avpkt->buf);
   av_free(avpkt);
 
+  // (refused for that, or taken by a decoder that is going away: the next one has it)
