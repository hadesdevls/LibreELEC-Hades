+CDVDVideoCodec::VCReturn CDVDVideoCodecDRMPRIME::HandBack()
+{
+  if (!m_handBackTold)
+  {
+    m_handBackTold = true;
+    CLog::Log(LOGINFO,
+              "CDVDVideoCodecDRMPRIME::{} - the decoder offers no picture format that this decoder "
+              "takes: the stream goes to the next decoder",
+              __FUNCTION__);
+  }
+  return VC_HANDBACK;
+}
+
