From cecfe2c64b84a0b1b99f816a470ecc97bacf08e5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:42:18 +0000
Subject: [PATCH] skins: with another skin, Estuary's strings are loaded too

The player information of Hades is given to every skin (system/hades:
the dialog for a skin without its pages, and the variables and maps that
any skin may use), and it says its words with Estuary's strings,
$ADDON[skin.estuary n], so that they come translated with the skin that
is always installed. But Kodi loads the strings of a skin only while it
is the skin (CApplicationSkinHandling::LoadSkin(), from its language/),
and those of the other add-ons from their resources/language/
(CLangInfo::SetLanguage()), where a skin has none: with another skin,
Estuary's strings are not there, and every $ADDON[skin.estuary n] of the
dialog is empty (its names, headings and words: only the values would be
left). A change of language even empties them where Estuary was loaded
before: CLangInfo::SetLanguage() loads the empty set from
resources/language/ in their place.

LoadSkin() now also loads Estuary's strings, from its language/, when the
skin is another one; it runs again with each language (which reloads the
skin). With Estuary nothing changes.

ApplicationSkinHandling.cpp compiles with the commands of the last build.
Found by reading the code: not seen in Kodi with another skin, which the
image does not carry (to try: install a skin without
DialogPlayerProcessInfo.xml, start Kodi with it, open the player
information while a video plays: before, the rows have no names).
---
 xbmc/application/ApplicationSkinHandling.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/xbmc/application/ApplicationSkinHandling.cpp b/xbmc/application/ApplicationSkinHandling.cpp
index ff16a8c..3fc8bfe 100644
--- a/xbmc/application/ApplicationSkinHandling.cpp
+++ b/xbmc/application/ApplicationSkinHandling.cpp
@@ -161,6 +161,20 @@ bool CApplicationSkinHandling::LoadSkin(const std::string& skinID)
   const std::string langPath = URIUtils::AddFileToFolder(skin->Path(), "language/");
   CServiceBroker::GetResourcesComponent().GetLocalizeStrings().LoadAddonStrings(
       langPath, settings->GetString(CSettings::SETTING_LOCALE_LANGUAGE), skin->ID());
+  // Hades: the player information of Hades says its words with Estuary's strings in every skin
+  // ($ADDON[skin.estuary n] in system/hades, for a skin without its pages). The strings of an
+  // add-on are loaded from its resources/language/ (CLangInfo::SetLanguage()), and those of a skin
+  // from its language/ only while it is the skin: with another skin, Estuary's are loaded here too
+  // (again with each language, which reloads the skin).
+  if (skin->ID() != "skin.estuary")
+  {
+    ADDON::AddonPtr estuary;
+    if (CServiceBroker::GetAddonMgr().GetAddon("skin.estuary", estuary, ADDON::AddonType::SKIN,
+                                               ADDON::OnlyEnabled::CHOICE_NO))
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().LoadAddonStrings(
+          URIUtils::AddFileToFolder(estuary->Path(), "language/"),
+          settings->GetString(CSettings::SETTING_LOCALE_LANGUAGE), "skin.estuary");
+  }
   skin->LoadTimers();
 
   const auto start = std::chrono::steady_clock::now();
