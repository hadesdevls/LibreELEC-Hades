From 890d984819e5b866124743c9ea76f675b0885fec Mon Sep 17 00:00:00 2001
From: Keith Herrington <keith@kodi.tv>
Date: Tue, 27 Oct 2026 23:48:34 -0700
Subject: [PATCH] [macOS] Match USB interface lookup formatting

---
 xbmc/platform/darwin/osx/peripherals/PeripheralBusUSB.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xbmc/platform/darwin/osx/peripherals/PeripheralBusUSB.cpp b/xbmc/platform/darwin/osx/peripherals/PeripheralBusUSB.cpp
index c9c98b3..7609bcb 100644
--- a/xbmc/platform/darwin/osx/peripherals/PeripheralBusUSB.cpp
+++ b/xbmc/platform/darwin/osx/peripherals/PeripheralBusUSB.cpp
@@ -185,8 +185,8 @@ void CPeripheralBusUSB::DeviceAttachCallback(CPeripheralBusUSB* refCon, io_itera
       const bool validInterfaceClass =
           interfaceClassProperty != nullptr &&
           CFGetTypeID(interfaceClassProperty) == CFNumberGetTypeID() &&
-          CFNumberGetValue(static_cast<CFNumberRef>(interfaceClassProperty),
-                           kCFNumberSInt32Type, &interfaceClassValue) &&
+          CFNumberGetValue(static_cast<CFNumberRef>(interfaceClassProperty), kCFNumberSInt32Type,
+                           &interfaceClassValue) &&
           interfaceClassValue >= 0 && interfaceClassValue <= 255;
       if (interfaceClassProperty != nullptr)
         CFRelease(interfaceClassProperty);
-- 
2.53.0

