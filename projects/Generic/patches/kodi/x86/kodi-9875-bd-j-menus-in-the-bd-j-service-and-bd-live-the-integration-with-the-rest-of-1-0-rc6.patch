From 8c73598374c3a650f956c694787827eb5bb57cb2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:50:49 +0000
Subject: [PATCH] BD-J menus in the BD-J service, and BD-Live: the integration
 with the rest of 1.0 RC6

What the integration of this change resolved, as one commit after its own.

Six commits on the change of the discs: why BD-J menus can or cannot run in the
BD-J service is said; the HAVi background plane and a BD-J screen that
plays no playlist are shown; the BD-J application is told what the
reader passed when the picture gets there; a link out of a disc in a
local folder is not followed; BD-Live, Internet for the Java menus of a
disc, off by default (bluray.hadesbdlive); and kodi.log says what the
BD-J service says.

The other side was made on the change of the discs, before the integrated tree moved the
Estuary ids of the picture subtitles and of the Java notices from
#32280-#32288 to #32290-#32298 and gave #32286-#32289 to the editions of
Matroska files. Its string changes are taken with the ids of the integrated tree,
entry by entry (the four Estuary files):
- the notice of Java 24 or later goes, as on the other side (BD-J no
  longer runs with an installed Java): #32297 removed (#32287 there),
  and its case in BlurayJava.h (conflict) with it;
- the notice when the menus do not start has the other side's text and
  form (no {0}): #32298 (#32288 there), and its case in BlurayJava.h;
- BD-Live's label and help: #32299 and #32300 (#32289 and #32290 there,
  which the integrated tree uses), in the mapping of GUIDialogSettingsBase.cpp and
  in the comments of the core entries #39885 to #39887;
- the four notices of the BD-J service, #32119 to #32122, as the other
  side has them.
---
 addons/resource.language.en_gb/resources/strings.po | 6 +++---
 xbmc/filesystem/BlurayJava.h                        | 2 +-
 xbmc/settings/dialogs/GUIDialogSettingsBase.cpp     | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index b7ddbbf..7d93def 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25737,19 +25737,19 @@ msgstr ""
 
 #empty string with id 39884
 
-#. Hades: Notification: the BD-J service was given the disc, and its menus did not start; translated in Estuary (#32288)
+#. Hades: Notification: the BD-J service was given the disc, and its menus did not start; translated in Estuary (#32298)
 #: xbmc/filesystem/BlurayJava.cpp
 msgctxt "#39885"
 msgid "The Java menus of this Blu-ray could not start in the BD-J service. kodi.log says what libbluray reported."
 msgstr ""
 
-#. Hades: label of setting "bluray.hadesbdlive"; translated in Estuary (#32289)
+#. Hades: label of setting "bluray.hadesbdlive"; translated in Estuary (#32299)
 #: system/settings/settings.xml
 msgctxt "#39886"
 msgid "BD-Live: Internet for disc menus"
 msgstr ""
 
-#. Hades: help of setting "bluray.hadesbdlive"; translated in Estuary (#32290)
+#. Hades: help of setting "bluray.hadesbdlive"; translated in Estuary (#32300)
 #: system/settings/settings.xml
 msgctxt "#39887"
 msgid "Lets the Java menus of a Blu-ray reach the Internet, as BD-Live discs do for trailers, extras or updates. Only addresses of the Internet over IPv4: never this system, your home network, other local addresses or IPv6, and names are resolved by Kodi. The menus run apart from Kodi in either case. Off: the disc has no network at all. kodi.log lists each connection allowed or refused."
diff --git a/xbmc/filesystem/BlurayJava.h b/xbmc/filesystem/BlurayJava.h
index 795012d..e42567d 100644
--- a/xbmc/filesystem/BlurayJava.h
+++ b/xbmc/filesystem/BlurayJava.h
@@ -111,7 +111,7 @@ inline BdjMessageIds BdjMessage(BdjState state)
     case BdjState::NO_JAR:
       return {39869, 32122}; // {0}: the version of libbluray
     case BdjState::START_FAILED:
-      return {39885, 32288};
+      return {39885, 32298};
     case BdjState::READY:
       break;
   }
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index 8e47305..505143b 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -591,7 +591,7 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
     return CGUIUtils::GetHadesString(labelId, 31755 + (labelId - 39230));
   // BD-Live (Player > Discs, Blu-ray): label, help
   if (labelId == 39886 || labelId == 39887)
-    return CGUIUtils::GetHadesString(labelId, 32289 + (labelId - 39886));
+    return CGUIUtils::GetHadesString(labelId, 32299 + (labelId - 39886));
   // the image based subtitles (Player > Subtitles): the group, labels, help
   if (labelId >= 39220 && labelId <= 39226)
     return CGUIUtils::GetHadesString(labelId, 32290 + (labelId - 39220));
-- 
