+void CWinSystemGbm::MoveToScreen(unsigned int /*screenIdx*/)
+{
+  // The output is chosen when Kodi starts (CDRMUtils::OpenDrm()): another one is used from the
+  // next start on, and nothing else shows that the choice was taken. Not told when the output
+  // that was named is the one in use, nor before the skin and its texts are there.
+  const auto gui = CServiceBroker::GetGUI();
+  const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+  if (!gui || !gui->GetSkinInfo() || !settingsComponent || !settingsComponent->GetSettings() ||
+      !m_DRM)
+    return;
+
+  const std::string asked =
+      settingsComponent->GetSettings()->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR);
+  if (m_DRM->IsCurrentOutput(asked))
+    return;
+
+  CLog::Log(LOGINFO, "The monitor in the settings is now \"{}\": used when Kodi is started again",
+            asked);
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Info,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246),
+      CGUIUtils::GetHadesString(39986, 31703), 10000);
+}
