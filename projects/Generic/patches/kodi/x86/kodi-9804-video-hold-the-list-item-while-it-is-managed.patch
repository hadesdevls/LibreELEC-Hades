From b28e914b637f02356cc7ad45fc5d5a352b6e9510 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Thu, 29 Oct 2026 13:02:32 +0100
Subject: [PATCH] [Video] Hold the list item while it is managed

The Manage menu and Choose art write the art and other details straight
to the list item, while the thumb loader thread may still be setting its
art and properties. The item is now held back from the loader while they
are open, and the loader goes on with the other items meanwhile.
---
 xbmc/video/windows/GUIWindowVideoNav.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/video/windows/GUIWindowVideoNav.cpp b/xbmc/video/windows/GUIWindowVideoNav.cpp
index 405c310..efc99ae 100644
--- a/xbmc/video/windows/GUIWindowVideoNav.cpp
+++ b/xbmc/video/windows/GUIWindowVideoNav.cpp
@@ -932,6 +932,8 @@ bool CGUIWindowVideoNav::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
   {
   case CONTEXT_BUTTON_EDIT:
     {
+      // the dialogs change the list item, which the loader thread writes
+      const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, item.get()};
       const int ret{CGUIDialogVideoInfo::ManageVideoItem(item)};
 
       // changed art of a movie only needs its own list item updated
@@ -953,6 +955,7 @@ bool CGUIWindowVideoNav::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
     }
     case CONTEXT_BUTTON_SET_ART:
     {
+      const CBackgroundInfoLoader::CItemHold itemHold{m_thumbLoader, item.get()};
       const bool result{
           CGUIDialogVideoInfo::ChooseAndManageVideoItemArtwork(m_vecItems->Get(itemNumber))};
       Refresh();
-- 
