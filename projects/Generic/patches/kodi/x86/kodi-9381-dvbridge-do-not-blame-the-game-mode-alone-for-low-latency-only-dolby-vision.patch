 //! Hades: what the settings say of a Dolby Vision stream that is not sent natively
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 4cce2d7..c4f7c0a 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -141,7 +141,8 @@ public:
     return m_dolbyVideo.valid && m_dolbyVideo.lowLatency;
   }
   //! Dolby Vision Low-Latency only: a version 2 block of 12 bytes or more without the Standard
-  //! interface, what a TV input in its game mode advertises.
+  //! interface. A TV input in its game mode advertises it (LG with Quick Frame Transport), and so
+  //! does a display that has only the low-latency (player-led) form, whatever its settings.
   bool SupportsLowLatencyDolbyVisionOnly() const
   {
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version == 2 &&
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
