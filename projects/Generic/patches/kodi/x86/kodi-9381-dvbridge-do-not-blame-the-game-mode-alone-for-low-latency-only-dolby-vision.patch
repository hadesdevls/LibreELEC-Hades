     return;
   CLog::Log(LOGINFO, "DVBridge: the display offers Dolby Vision Low-Latency only (a TV input in its "
-                     "game mode); the user is told how to get native Dolby Vision");
+                     "game mode, or a display that has no other form); the user is told why, and "
