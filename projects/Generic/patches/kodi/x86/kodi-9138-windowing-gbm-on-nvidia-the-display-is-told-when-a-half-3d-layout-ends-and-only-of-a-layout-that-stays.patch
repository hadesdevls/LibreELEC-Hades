+/*!
+ * \brief Whether HDMI has a format number of its own (HDMI_VIC) for a 2D mode
+ *
+ * The 2160p formats of HDMI 1.4: 3840x2160 at 24, 25 and 30 Hz (and at 1000/1001 of them) and
+ * 4096x2160 at 24 Hz. A driver tells the display of such a mode in the HDMI vendor InfoFrame,
+ * the one that also tells of a 3D layout.
+ */
+inline bool HasHdmiVic(const Mode& mode)
+{
+  if ((mode.flags & (FLAG_INTERLACE | FLAG_DBLSCAN)) != 0 || mode.vscan > 1 ||
+      mode.vdisplay != 2160 || (mode.hdisplay != 3840 && mode.hdisplay != 4096))
+    return false;
+
+  const double rate = RefreshRate(mode);
+  const auto is = [rate](double nominal)
+  {
+    return std::fabs(rate - nominal) < 0.02 || std::fabs(rate - nominal * 1000.0 / 1001.0) < 0.02;
+  };
+  return is(24.0) || (mode.hdisplay == 3840 && (is(25.0) || is(30.0)));
+}
+
 /*!
  * \brief What the EDID of a display says of 3D (HDMI 1.4, in its HDMI vendor block)
  */
@@ -750,6 +771,20 @@ constexpr InfoFramePayload HalfLayoutInfoFrame(Layout layout)
   }
 }
 
+/*!
+ * \brief The contents of the HDMI vendor InfoFrame that tells a display that there is no 3D
+ *        layout (any more)
+ *
+ * HDMI_Video_Format 0, with nothing after it. A display is told so when a 3D layout ends,
+ * rather than left to notice that the InfoFrame of the layout stopped coming, which some do
+ * not (HDMI 2.0, appendix F; the kernel's HDMI code sends this InfoFrame in every 2D mode to a
+ * display that takes one).
+ */
+constexpr InfoFramePayload NoLayoutInfoFrame()
+{
+  return {4, {0x03, 0x0C, 0x00, 0x00}};
+}
