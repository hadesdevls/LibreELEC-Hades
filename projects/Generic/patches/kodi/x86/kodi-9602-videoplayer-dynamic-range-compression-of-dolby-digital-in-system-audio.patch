diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
index cbc8060..b5f613c 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
@@ -114,10 +114,31 @@ bool CDVDAudioCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
     }
   }
 
+  // Hades: the dynamic range compression of AC-3 and E-AC-3 (FFmpeg's drc_scale) from Settings >
+  // System > Audio, 100 % being FFmpeg's default, which Kodi left in place. <applydrc> in
+  // advancedsettings.xml, when it is there, applies as it did, to any decoder.
   float applyDrc = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_audioApplyDrc;
+  const bool dolby = hints.codec == AV_CODEC_ID_AC3 || hints.codec == AV_CODEC_ID_EAC3;
   if (applyDrc >= 0.0f)
+  {
     av_opt_set_double(m_pCodecContext, "drc_scale", static_cast<double>(applyDrc),
                       AV_OPT_SEARCH_CHILDREN);
+    if (dolby)
+      CLog::Log(LOGINFO,
+                "CDVDAudioCodecFFmpeg::Open() dynamic range compression {:.0f} % (<applydrc> of "
+                "advancedsettings.xml, in place of the setting \"{}\")",
+                applyDrc * 100.0f, CSettings::SETTING_AUDIOOUTPUT_HADESDRC);
+  }
+  else if (dolby)
+  {
+    const int percent = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+        CSettings::SETTING_AUDIOOUTPUT_HADESDRC);
+    av_opt_set_double(m_pCodecContext, "drc_scale", percent / 100.0, AV_OPT_SEARCH_CHILDREN);
+    CLog::Log(LOGINFO,
+              "CDVDAudioCodecFFmpeg::Open() dynamic range compression {} % of what the stream asks "
+              "for (setting \"{}\")",
+              percent, CSettings::SETTING_AUDIOOUTPUT_HADESDRC);
+  }
 
   if (avcodec_open2(m_pCodecContext, pCodec, NULL) < 0)
   {
