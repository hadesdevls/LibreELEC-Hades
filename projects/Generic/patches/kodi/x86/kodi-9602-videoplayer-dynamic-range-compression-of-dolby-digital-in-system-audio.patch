   static constexpr auto SETTING_AUDIOOUTPUT_HADESPCMLIMIT = "audiooutput.hadespcmlimit";
   static constexpr auto SETTING_AUDIOOUTPUT_HADESSURROUNDTODOLBY =
       "audiooutput.hadessurroundtodolby";
