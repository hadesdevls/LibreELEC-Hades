From 73fcbf21872fba61ffdba5605675d10854f95d66 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:03:50 +0100
Subject: [PATCH] [VideoInfoScanner] Carry on with a show's episodes after a
 lookup fails

A failure to fetch a show's episode guide, or the details of one of its
episodes, returned at once, leaving the show's remaining episodes - even
those with a full nfo - out of the library until a later scan. Log the
failure and carry on with the other episodes instead. The result is
still NOT_FOUND, so the folder isn't hashed and the next scan tries the
failed episodes again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ac591f620d653ab1b7081a130a4e72d7a5323330)
---
 xbmc/video/VideoInfoScanner.cpp          | 34 +++++++++++-----
 xbmc/video/test/TestVideoInfoScanner.cpp | 50 ++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 10 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index cd2906e..7a5e7b4 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -2461,6 +2461,9 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
     EPISODELIST episodes;
     bool hasEpisodeGuide = false;
+    // A failed lookup doesn't stop the other episodes being added, but makes the result NOT_FOUND
+    // so that the folder isn't hashed and the next scan tries the failed episodes again
+    bool lookupFailed{false};
 
     std::unordered_map<std::string, int> episodeMap;
     for (const auto& file : files)
@@ -2557,7 +2560,11 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
           CVideoInfoDownloader imdb(scraper);
           if (!imdb.GetEpisodeList(url, episodes))
-            return InfoRet::NOT_FOUND;
+          {
+            CLog::Log(LOGWARNING, "VideoInfoScanner: Unable to fetch the episode guide of '{}'",
+                      showInfo.m_strTitle);
+            lookupFailed = true;
+          }
 
           hasEpisodeGuide = true;
         }
@@ -2565,13 +2572,15 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
       if (episodes.empty())
       {
-        CLog::Log(LOGERROR,
-                  "VideoInfoScanner: Asked to lookup episode {}"
-                  " online, but we have either no episode guide or"
-                  " we are using the local scraper. Check your tvshow.nfo and make"
-                  " sure the <episodeguide> tag is in place and/or use an online"
-                  " scraper.",
-                  CURL::GetRedacted(file->strPath));
+        // An episode guide that couldn't be fetched has been reported already
+        if (!hasEpisodeGuide)
+          CLog::Log(LOGERROR,
+                    "VideoInfoScanner: Asked to lookup episode {}"
+                    " online, but we have either no episode guide or"
+                    " we are using the local scraper. Check your tvshow.nfo and make"
+                    " sure the <episodeguide> tag is in place and/or use an online"
+                    " scraper.",
+                    CURL::GetRedacted(file->strPath));
         continue;
       }
 
@@ -2678,7 +2687,12 @@ CVideoInfoScanner::~CVideoInfoScanner()
         scraperItem.SetPath(file->strPath);
         if (!imdb.GetEpisodeDetails(guide->cScraperUrl, *scraperItem.GetVideoInfoTag(),
                                     pDlgProgress))
-          return InfoRet::NOT_FOUND; //! @todo should we just skip to the next episode?
+        {
+          CLog::Log(LOGWARNING, "VideoInfoScanner: Unable to fetch the details of episode {}",
+                    CURL::GetRedacted(file->strPath));
+          lookupFailed = true;
+          continue;
+        }
 
         if (result == InfoType::COMBINED || result == InfoType::OVERRIDE)
           scraperItem.GetVideoInfoTag()->Merge(*item.GetVideoInfoTag());
@@ -2709,7 +2723,7 @@ CVideoInfoScanner::~CVideoInfoScanner()
             file->cDate.GetAsLocalizedDate(), file->strTitle);
       }
     }
-    return InfoRet::ADDED;
+    return lookupFailed ? InfoRet::NOT_FOUND : InfoRet::ADDED;
   }
 
   bool CVideoInfoScanner::GetDetails(CFileItem* pItem,
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 0000ba4..e92400b 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -708,3 +708,53 @@ TEST_F(TestVideoInfoScannerTvShows, AShowWhoseDetailsFailedIsLookedUpAgain)
   EXPECT_EQ(1, CountShows());
   EXPECT_GT(m_db.GetEpisodeId(episode, 1, 1), 0);
 }
+
+TEST_F(TestVideoInfoScannerTvShows, AnEpisodeWithAnNfoIsAddedWhenTheEpisodeGuideFails)
+{
+  UseTestScraper(ADDON::AddonType::SCRAPER_TVSHOWS);
+  const std::string show{Folder(m_root, "Show")};
+  File(show, "tvshow.nfo",
+       "<tvshow><title>Show</title><episodeguide><url cache=\"guide.xml\">"
+       "http://scraper.invalid/guide</url></episodeguide></tvshow>");
+  ScraperFile("guide.xml", "<error/>");
+  const std::string season{Folder(show, "Season 1")};
+  const std::string first{File(season, "Show S01E01.mkv")};
+  const std::string second{Episode(season, "Show S01E02.mkv")};
+  Scan();
+  EXPECT_GT(m_db.GetEpisodeId(second, 2, 1), 0);
+  ASSERT_EQ(1, CountEpisodes());
+
+  ScraperFile("guide.xml", "<episodeguide><episode><title>First</title><url cache=\"first.xml\">"
+                           "http://scraper.invalid/first</url><epnum>1</epnum><season>1</season>"
+                           "</episode></episodeguide>");
+  ScraperFile("first.xml", "<details><title>First</title></details>");
+  Scan();
+
+  EXPECT_GT(m_db.GetEpisodeId(first, 1, 1), 0);
+  EXPECT_EQ(2, CountEpisodes());
+}
+
+TEST_F(TestVideoInfoScannerTvShows, AnEpisodeWhoseDetailsFailedIsLookedUpAgain)
+{
+  UseTestScraper(ADDON::AddonType::SCRAPER_TVSHOWS);
+  const std::string show{Folder(m_root, "Show")};
+  File(show, "tvshow.nfo",
+       "<tvshow><title>Show</title><episodeguide><url cache=\"guide.xml\">"
+       "http://scraper.invalid/guide</url></episodeguide></tvshow>");
+  ScraperFile("guide.xml", "<episodeguide><episode><title>First</title><url cache=\"first.xml\">"
+                           "http://scraper.invalid/first</url><epnum>1</epnum><season>1</season>"
+                           "</episode></episodeguide>");
+  ScraperFile("first.xml", "<error/>");
+  const std::string season{Folder(show, "Season 1")};
+  const std::string first{File(season, "Show S01E01.mkv")};
+  const std::string second{Episode(season, "Show S01E02.mkv")};
+  Scan();
+  EXPECT_GT(m_db.GetEpisodeId(second, 2, 1), 0);
+  ASSERT_EQ(1, CountEpisodes());
+
+  ScraperFile("first.xml", "<details><title>First</title></details>");
+  Scan();
+
+  EXPECT_GT(m_db.GetEpisodeId(first, 1, 1), 0);
+  EXPECT_EQ(2, CountEpisodes());
+}
