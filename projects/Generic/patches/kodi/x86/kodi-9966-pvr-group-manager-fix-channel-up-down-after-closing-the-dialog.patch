From f501e9321506b5972f9bac515e58ee4cf07ddcb1 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Fri, 13 Nov 2026 08:06:26 +0100
Subject: [PATCH] [PVR] Group manager: Fix channel up/down after closing the
 dialog

The group manager makes the selected group the active group, starting
with the first group as soon as it opens. If a channel from another
group was playing, channel up/down did nothing after closing the dialog.

Restore the playing channel's group on close in this case.

(cherry picked from commit ff0303675715d82e2e7849b1cf9861862d38f99a)
(cherry picked from commit c2284eb9711c462183f2b7453a57aebe42734442)
---
 xbmc/pvr/dialogs/GUIDialogPVRGroupManager.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/xbmc/pvr/dialogs/GUIDialogPVRGroupManager.cpp b/xbmc/pvr/dialogs/GUIDialogPVRGroupManager.cpp
index 39e14ce..ecd32a5 100644
--- a/xbmc/pvr/dialogs/GUIDialogPVRGroupManager.cpp
+++ b/xbmc/pvr/dialogs/GUIDialogPVRGroupManager.cpp
@@ -553,6 +553,7 @@ void CGUIDialogPVRGroupManager::OnInitWindow()
 void CGUIDialogPVRGroupManager::OnDeinitWindow(int nextWindowID)
 {
   Clear();
+  CServiceBroker::GetPVRManager().PlaybackState()->RestorePlayingChannelGroup();
   CGUIDialog::OnDeinitWindow(nextWindowID);
 }
 
