From 22ec0623947adf4831dd6a03a1f5b98c0ada2447 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:41:29 +0000
Subject: [PATCH] VideoPlayer: the compression of Dolby Digital changes in the
 decoder that plays

A change of audiooutput.hadesdrc during playback opened the AC-3/E-AC-3
decoder again at the next frame, and that frame of sound was lost (and the
first block after it had no overlap); a slider moved in steps of 5 % lost one
for every step.

FFmpeg's AC-3/E-AC-3 decoder reads drc_scale for each block that it decodes
(ac3dec.c, decode_audio_block()), on the thread that decodes: it has no
threads of its own, and the player changes it on that thread, between two
packets. CDVDAudioCodec::UpdateDecoderSettings() (false by default: the
decoder is opened again, as before) does it for CDVDAudioCodecFFmpeg with the
call that Open() makes, av_opt_set_double(..., "drc_scale", ...,
AV_OPT_SEARCH_CHILDREN), and reads the value back. FFmpeg 9.0.2 lets the
option be set on an open decoder (libavcodec keeps no
AV_CLASS_STATE_INITIALIZED); if a later FFmpeg refuses it, the set or the
read back fails and the decoder is opened again. <applydrc> in
advancedsettings.xml still takes priority.

Tested on the host with FFmpeg 9.0.2 with ffmpeg-9945 and 9946
(drclive_test.c, FATE's AC-3 4.0 and E-AC-3 5.1 samples, 100 % to 50 % and
50 % to 0): the option is taken, no frame is lost, the frames before the
change are those of the whole decode with the old value, the frame after it
differs from the whole decode with the new value in its first block only
(the overlap of the block before), and every frame from the next one on is
that decode's, bit for bit. With the option not set, the test fails.
---
 system/settings/settings.xml                  |  5 +--
 .../AudioEngine/Utils/AudioSettingsLive.h     |  7 ++--
 .../DVDCodecs/Audio/DVDAudioCodec.h           |  8 +++++
 .../DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp   | 35 +++++++++++++++++++
 .../DVDCodecs/Audio/DVDAudioCodecFFmpeg.h     |  1 +
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp   | 11 ++++--
 6 files changed, 59 insertions(+), 8 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index ab3f37e..54cb366 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -4288,8 +4288,9 @@
           <control type="toggle" />
         </setting>
         <!-- Hades: the dynamic range compression of decoded AC-3 and E-AC-3, FFmpeg's drc_scale in percent
-             (CDVDAudioCodecFFmpeg::Open()); 100 is FFmpeg's default, which Kodi left in place. Applies at once
-             (CVideoPlayerAudio::OnSettingChanged()); <audio><applydrc> of advancedsettings.xml takes priority -->
+             (CDVDAudioCodecFFmpeg::Open()); 100 is FFmpeg's default, which Kodi left in place. Applies at once,
+             in the decoder that plays (CDVDAudioCodec::UpdateDecoderSettings(); the player learns of the change
+             from AudioSettingsWatch.h); <audio><applydrc> of advancedsettings.xml takes priority -->
         <setting id="audiooutput.hadesdrc" type="integer" label="39762" help="39763">
           <level>2</level>
           <default>100</default>
diff --git a/xbmc/cores/AudioEngine/Utils/AudioSettingsLive.h b/xbmc/cores/AudioEngine/Utils/AudioSettingsLive.h
index 24d7264..1ca47f8 100644
--- a/xbmc/cores/AudioEngine/Utils/AudioSettingsLive.h
+++ b/xbmc/cores/AudioEngine/Utils/AudioSettingsLive.h
@@ -25,9 +25,10 @@
 // - passthrough, its device's mode (audiooutput.config: fixed has none), each format's passthrough
 //   and the core of DTS-HD: whether the stream passes through, and which way (all of DTS-HD, or its
 //   core). Switching costs what a switch for a reset display costs: the sink opens again.
-// - the dynamic range compression of Dolby Digital (audiooutput.hadesdrc): a decoder of AC-3 or
-//   E-AC-3 that decodes the stream now is opened again with it (one frame of sound is lost: FFmpeg
-//   offers no way to change it while it decodes).
+// - the dynamic range compression of Dolby Digital (audiooutput.hadesdrc): the decoder of AC-3 or
+//   E-AC-3 that decodes the stream now takes it as it decodes, from its next frame, with no sound
+//   lost (CDVDAudioCodec::UpdateDecoderSettings()); one that cannot is opened again with it (one
+//   frame of sound is lost).
 // - the upmix of stereo and the LFE in a downmix: the engine's resampler of the stream is made
 //   again (CActiveAEBufferPoolResample::ConfigureResampler()), as it already was for the quality
 //   and the normalisation of levels.
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodec.h
index b92f41a..daea3b0 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodec.h
@@ -118,6 +118,14 @@ public:
    */
   virtual int GetProfile() { return 0; }
 
+  /*!
+   * \brief Hades: takes, while it decodes, the settings of the decoder that may change during
+   * playback (the compression of AC-3 and E-AC-3, audiooutput.hadesdrc), from its next frame.
+   * Called on the thread that decodes, between two packets.
+   * \return false if it cannot: it is then opened again with them
+   */
+  virtual bool UpdateDecoderSettings() { return false; }
+
 protected:
   CProcessInfo &m_processInfo;
 };
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
index b5f613c..d16e3cb 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
@@ -166,6 +166,41 @@ bool CDVDAudioCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   return true;
 }
 
+bool CDVDAudioCodecFFmpeg::UpdateDecoderSettings()
+{
+  // Hades: FFmpeg's AC-3/E-AC-3 decoder reads drc_scale for every block it decodes (ac3dec.c,
+  // decode_audio_block()), on the thread that decodes: it has no threads of its own, and this is
+  // called on that thread, between two packets. Set here, it applies from the next frame, and no
+  // frame is lost, as one would be with a decoder opened again. FFmpeg 9.0.2 lets an option be set
+  // on a decoder that is open (libavcodec keeps no AV_CLASS_STATE_INITIALIZED); if a later one does
+  // not, the set fails, and the decoder is opened again as before.
+  if (!m_pCodecContext ||
+      (m_pCodecContext->codec_id != AV_CODEC_ID_AC3 && m_pCodecContext->codec_id != AV_CODEC_ID_EAC3))
+    return false;
+  // <applydrc> in advancedsettings.xml takes priority: the setting changes nothing
+  if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_audioApplyDrc >= 0.0f)
+    return true;
+  const int percent = CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_AUDIOOUTPUT_HADESDRC);
+  const double scale = percent / 100.0;
+  double now = -1.0;
+  if (av_opt_set_double(m_pCodecContext, "drc_scale", scale, AV_OPT_SEARCH_CHILDREN) < 0 ||
+      av_opt_get_double(m_pCodecContext, "drc_scale", AV_OPT_SEARCH_CHILDREN, &now) < 0 ||
+      now < scale - 1e-6 || now > scale + 1e-6)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDAudioCodecFFmpeg: dynamic range compression {} %: the decoder does not take it "
+              "while it decodes, and is opened again with it",
+              percent);
+    return false;
+  }
+  CLog::Log(LOGINFO,
+            "CDVDAudioCodecFFmpeg: dynamic range compression {} % of what the stream asks for "
+            "(setting \"{}\"), from the next frame, in the decoder that plays",
+            percent, CSettings::SETTING_AUDIOOUTPUT_HADESDRC);
+  return true;
+}
+
 void CDVDAudioCodecFFmpeg::Dispose()
 {
   av_frame_free(&m_pFrame);
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.h
index 3441d8f..eaff2f3 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.h
@@ -37,6 +37,7 @@ public:
   enum AVMatrixEncoding GetMatrixEncoding() override;
   enum AVAudioServiceType GetAudioServiceType() override;
   int GetProfile() override;
+  bool UpdateDecoderSettings() override;
 
 protected:
   int GetData(uint8_t** dst);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
index 357950c..e9199b7 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
@@ -771,12 +771,17 @@ bool CVideoPlayerAudio::ProcessDecoderOutput(DVDAudioFrame &audioframe)
                                           m_streaminfo.codec == AV_CODEC_ID_EAC3,
                                       &check))
     {
+      // (the compression changes in the decoder that plays, with no sound lost; only a decoder
+      // that cannot take it while it decodes is opened again: UpdateDecoderSettings())
       const std::string before = m_pAudioCodec->GetName();
-      const bool switched = SwitchCodecIfNeeded(check);
+      const bool inPlace =
+          check == CodecCheck::DECODER && m_pAudioCodec->UpdateDecoderSettings();
+      const bool switched = !inPlace && SwitchCodecIfNeeded(check);
       CLog::Log(LOGINFO, "CVideoPlayerAudio: an audio setting changed during playback ({}): {}",
                 check == CodecCheck::DECODER ? "of the decoder" : "of passthrough",
-                !switched ? std::string("the stream plays as it did")
-                          : "it applies now: " + before + " -> " + m_pAudioCodec->GetName());
+                inPlace ? "it applies now, in the decoder that plays (" + before + ")"
+                : !switched ? std::string("the stream plays as it did")
+                            : "it applies now: " + before + " -> " + m_pAudioCodec->GetName());
       if (switched)
       {
         audioframe.nb_frames = 0;
