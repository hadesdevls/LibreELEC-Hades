 #include "utils/DisplayInfo.h"
 
+#include <string_view>
 #include <tuple>
 
 namespace KODI
@@ -74,10 +75,14 @@ Signal SignalOf(const UTILS::CDisplayInfo* info, LowLatencyOn lowLatencyOn, Hdmi
  * \brief What of the display keeps native output away from it, as the reason code of the player
  *        information: invalid (a Dolby Vision block that is not read: in an EDID block that is
  *        not valid, or several), legacy (Dolby Vision with the older signalling only), lloff
- *        (Low-Latency only, turned off in the settings), display (no Dolby Vision Standard, or no
- *        display information); "" where the display takes the signal. What of the output stands
- *        in the way is asked after this. A display that asks for the HDMI 1.4b signalling is
- *        "legacy" as before where the setting of it is off (the signal is not HDMI14B then).
+ *        (Low-Latency only, turned off in the settings), nodv (no Dolby Vision block in an EDID
+ *        read whole: the TV input offers none), edidpart (no Dolby Vision block in an EDID that
+ *        was not read whole, CDisplayInfo::EdidMissingBlocks() or BaseBlockCopy(): the block may
+ *        be in the part that is missing), display (a Dolby Vision block without a mode that native
+ *        output sends, or no display information); "" where the display takes the signal. What of
+ *        the output stands in the way is asked after this. A display that asks for the HDMI 1.4b
+ *        signalling is "legacy" as before where the setting of it is off (the signal is not
+ *        HDMI14B then).
  */
 inline const char* Reason(const UTILS::CDisplayInfo* info, Signal signal)
 {
@@ -90,10 +95,47 @@ inline const char* Reason(const UTILS::CDisplayInfo* info, Signal signal)
       signal != Signal::LOW_LATENCY)
     return "lloff";
   if (!info || !(info->SupportsStandardDolbyVision() || signal != Signal::STANDARD))
+  {
+    // Hades: no Dolby Vision block at all in what was read: the EDID was not read whole (the
+    // block may be in what is missing), or the TV input offers none (a TV in its 4K120/VRR input
+    // mode may leave it out)
+    if (info && !info->SupportsDolbyVision())
+      return info->EdidMissingBlocks() || info->BaseBlockCopy() ? "edidpart" : "nodv";
     return "display";
+  }
   return "";
 }
 
+/*!
+ * \brief What the display offers of Dolby Vision, for the Display row of the player information
+ *        (hades.dv.display): standard, invalid (a block that is not read), legacy (the older
+ *        signalling only), lowlatency (a block without the Standard mode), part (no block in an
+ *        EDID that was not read whole: the block may be in what is missing), none; "" without
+ *        display information
+ */
+inline const char* DisplayState(const UTILS::CDisplayInfo* info)
+{
+  if (!info)
+    return "";
+  if (info->SupportsStandardDolbyVision())
+    return "standard";
+  if (info->DolbyVisionBlockInvalid())
+    return "invalid";
+  if (info->SupportsLegacyDolbyVisionOnly())
+    return "legacy";
+  if (info->SupportsDolbyVision())
+    return "lowlatency";
+  return info->EdidMissingBlocks() || info->BaseBlockCopy() ? "part" : "none";
+}
+
+//! The reasons (Reason()) for which the log gives the shape of the display's EDID, once for each
+//! EDID: those that its Dolby Vision block, or the lack of one, decides
+inline bool LogsEdidShape(std::string_view code)
+{
+  return code == "display" || code == "invalid" || code == "legacy" || code == "lloff" ||
+         code == "nodv" || code == "edidpart";
+}
+
 //! The AVI InfoFrame of the signal says full range RGB, which needs the display to let the source
 //! select the RGB range (QS): every signal but Low-Latency, whose AVI InfoFrame says YCbCr in the
 //! limited range (a display that asks for the HDMI 1.4b signalling is taken only with QS in its
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index b4af848..d3257b2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1351,6 +1351,14 @@ const char* DVDisplayReasonText(std::string_view code)
   if (code == "lloff")
     return "the display offers Dolby Vision Low-Latency only (a TV input in its game mode), which "
            "is turned off in the settings (System > Display)";
+  // Hades: no Dolby Vision block at all (DV_DISPLAY::Reason())
+  if (code == "nodv")
+    return "the display's EDID has no Dolby Vision block: this TV input offers no Dolby Vision (a "
+           "TV may leave it out in an input mode of 4K120 or VRR; see the line on the EDID below)";
+  if (code == "edidpart")
+    return "the display's EDID was not read whole (it counts more blocks than were read, or a "
+           "block repeats block 0) and has no Dolby Vision block in what was read: the block may "
+           "be in the part that is missing (see the line on the EDID below)";
   return "the display does not advertise Dolby Vision Standard";
 }
 } // namespace
@@ -1559,7 +1567,7 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
     // (without debug logging: the next report of "the display does not advertise Dolby Vision
     // Standard" says whether its block is missing, somewhere that is not read, or broken)
     const std::string_view why = code;
-    if (info && (why == "display" || why == "invalid") && info->EdidShape() != m_dvEdidShapeLogged)
+    if (info && DV_DISPLAY::LogsEdidShape(why) && info->EdidShape() != m_dvEdidShapeLogged)
     {
       m_dvEdidShapeLogged = info->EdidShape();
       CLog::Log(LOGINFO, "DVBridge: the display's EDID, as native output reads it: {}",
@@ -1758,16 +1766,9 @@ std::string CWinSystemGbm::NativeDVOutputReason() const
 
 std::string CWinSystemGbm::DisplayDolbyVisionSupport() const
 {
+  // (Hades: DV_DISPLAY::DisplayState(), which a host test asks of many EDIDs)
   const auto info = DVDisplayInfo();
-  if (!info)
-    return "";
-  if (info->SupportsStandardDolbyVision())
-    return "standard";
-  if (info->DolbyVisionBlockInvalid())
-    return "invalid";
-  if (info->SupportsLegacyDolbyVisionOnly())
-    return "legacy";
-  return info->SupportsDolbyVision() ? "lowlatency" : "none";
+  return DV_DISPLAY::DisplayState(info.get());
 }
 
 unsigned int CWinSystemGbm::DisplayDolbyVisionDmVersion() const
