From e7bc7f7ad356574a94266a5a619df24f08cd2e60 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Thu, 8 Oct 2026 19:28:19 +0100
Subject: [PATCH] [guilib][GUIFontManager] Divide a stretched font's aspect by
 the skin's pixel ratio

A font that stretches with the interface multiplied its aspect by the skin resolution's pixel
ratio, which matched the inverted ratio RESOLUTION_INFO's constructor used to store. With the
ratio now the declared aspect over the pixel shape, a layout whose pixels are not square drew its
text out of shape by the square of the correction: a 720x576 4:3 layout on a square-pixel 4:3 screen came
out about 14% wide, Estuary's 21:9 layout about 3% narrow. The aspect is now divided by it.

StretchedFontAspect() holds the calculation so TestGUIFontManager can pin it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 75e28ddbd7c08a99d05746dc53466c37e95705b1)
---
 xbmc/guilib/GUIFontManager.cpp          | 14 +++++---
 xbmc/guilib/GUIFontManager.h            | 11 +++++++
 xbmc/guilib/test/CMakeLists.txt         |  1 +
 xbmc/guilib/test/TestGUIFontManager.cpp | 44 +++++++++++++++++++++++++
 4 files changed, 65 insertions(+), 5 deletions(-)
 create mode 100644 xbmc/guilib/test/TestGUIFontManager.cpp

diff --git a/xbmc/guilib/GUIFontManager.cpp b/xbmc/guilib/GUIFontManager.cpp
index d1334d6..bb96829 100644
--- a/xbmc/guilib/GUIFontManager.cpp
+++ b/xbmc/guilib/GUIFontManager.cpp
@@ -107,16 +107,20 @@ void GUIFontManager::RescaleFontSizeAndAspect(CGraphicContext& context,
   else
   {
     // font stretched like the rest of the UI, aspect parameter being the original aspect
-
-    // adjust aspect ratio
-    *aspect *= sourceRes.fPixelRatio;
-
-    *aspect *= scaleY / scaleX;
+    *aspect = StretchedFontAspect(*aspect, sourceRes, scaleX, scaleY);
   }
 
   *size /= scaleY;
 }
 
+float GUIFontManager::StretchedFontAspect(float aspect,
+                                          const RESOLUTION_INFO& sourceRes,
+                                          float scaleX,
+                                          float scaleY)
+{
+  return aspect / sourceRes.fPixelRatio * scaleY / scaleX;
+}
+
 static bool CheckFont(std::string& strPath, const std::string& newPath, const std::string& filename)
 {
   if (!CFileUtils::Exists(strPath))
diff --git a/xbmc/guilib/GUIFontManager.h b/xbmc/guilib/GUIFontManager.h
index 27e85ff..a1f8d06 100644
--- a/xbmc/guilib/GUIFontManager.h
+++ b/xbmc/guilib/GUIFontManager.h
@@ -112,6 +112,17 @@ public:
    */
   std::vector<std::string> GetUserFontsFamilyNames();
 
+  /*!
+   * \brief The aspect a font that stretches with the interface is rasterised at
+   * \param aspect The font's own aspect
+   * \param sourceRes The skin resolution the font is declared in
+   * \param scaleX, scaleY The skin to screen scaling, as GetGUIScaling() gives it
+   */
+  static float StretchedFontAspect(float aspect,
+                                   const RESOLUTION_INFO& sourceRes,
+                                   float scaleX,
+                                   float scaleY);
+
 protected:
   void ReloadTTFFonts();
   static void RescaleFontSizeAndAspect(CGraphicContext& context,
diff --git a/xbmc/guilib/test/CMakeLists.txt b/xbmc/guilib/test/CMakeLists.txt
index ebb993a..bfb89eb 100644
--- a/xbmc/guilib/test/CMakeLists.txt
+++ b/xbmc/guilib/test/CMakeLists.txt
@@ -2,6 +2,7 @@ set(SOURCES TestGUIControlFactory.cpp
             TestGUIControlGroup.cpp
             TestGamesGUIInfo.cpp
             TestGUIFixedListContainer.cpp
+            TestGUIFontManager.cpp
             TestGUIImage.cpp
             TestGUIPanelContainer.cpp
             TestGUILabel.cpp
diff --git a/xbmc/guilib/test/TestGUIFontManager.cpp b/xbmc/guilib/test/TestGUIFontManager.cpp
new file mode 100644
index 0000000..bd3f9c2
--- /dev/null
+++ b/xbmc/guilib/test/TestGUIFontManager.cpp
@@ -0,0 +1,44 @@
