From 9ebf686c17ba53050c9c10371d68c8c528c20479 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:33:00 +0000
Subject: [PATCH] windowing/gbm: HDR over the tunnel is told as the HDR10 or
 HLG it carries, not as Dolby Vision

The player information took native output for native Dolby Vision wherever the
transport was on (m_dvSignalling), and HDR over the tunnel (c50a565) goes out in
that transport too. With an HDR10 or HLG video over the tunnel, what the display
is sent (hades.out.hdrtype, Player.Process(videooutputhdrtype) for skins) and the
heading of the overview page said Dolby Vision, the Dolby Vision page said native
output, the notice of the playback mode would name Dolby Vision, and the output
page gave the depth of the Dolby Vision transport ("8 bits: Dolby Vision carries
its 12 bits in them").

HDR10_TUNNEL::InfoNativeDolbyVision() says native Dolby Vision for the player
information only where the transport is on and it is not the tunnel. Over the
tunnel, what the display is sent is read from the static metadata InfoFrame the
driver holds (HDR10 or HLG, as for any HDR video), and the output page gives the
link the AVI InfoFrame of the tunnel tells the display: YCbCr 4:2:2 at 12 bits.
Native Dolby Vision is told as before.

Host tests (outside the tree): tunnel_info_test (the decision and the depth that
the page shows) and tunnel_info_wiring.py (both publications). Before this change the first does not build and the second fails 3 of 3.
---
 xbmc/windowing/gbm/HDR10Tunnel.h              | 13 +++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 19 +++++++++++++++++--
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/HDR10Tunnel.h b/xbmc/windowing/gbm/HDR10Tunnel.h
index c5eeac9..b805f66 100644
--- a/xbmc/windowing/gbm/HDR10Tunnel.h
+++ b/xbmc/windowing/gbm/HDR10Tunnel.h
@@ -163,6 +163,19 @@ constexpr Why Decide(const Input& in)
   return Why::USE;
 }
 
+//! Whether the output is native Dolby Vision for the player information (what the display is
+//! sent, the Dolby Vision page, the badge, the notice of the playback mode): the transport of
+//! native output is on (transportOn: its first frame went out) and it is not HDR over the tunnel,
+//! which carries an HDR10 or HLG picture as it is, told as such by the static metadata InfoFrame
+constexpr bool InfoNativeDolbyVision(bool transportOn, bool tunnel)
+{
+  return transportOn && !tunnel;
+}
+
+//! What the display takes over the tunnel (the AVI InfoFrame says so), for the player information
+constexpr unsigned LINK_DEPTH = 12;
+constexpr const char* LINK_FORMAT = "ycbcr422";
+
 //! The short form of a verdict, for the log and the player information
 constexpr const char* Code(Why why)
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 4912a8a..be6894f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7655,7 +7655,9 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
     return;
 
   // Every key is always set, empty when it does not apply, so that stale values are cleared.
-  const bool native = m_dvSignalling;
+  // (Hades: HDR over the tunnel is the HDR10 or HLG it carries, not Dolby Vision)
+  const bool native = KODI::WINDOWING::GBM::HDR10_TUNNEL::InfoNativeDolbyVision(
+      m_dvSignalling, m_outputHandover.HeldHdr10Tunnel());
   // Hades: reconstructed and sent as HDR10, when a picture was drawn that way in the last second
   // (or mapped to SDR, where the output takes no HDR10)
   const bool converted = !native && m_dvConvertBridge &&
@@ -9801,7 +9803,10 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     const int fd = m_DRM ? m_DRM->GetFileDescriptor() : -1;
 #ifdef HAVE_DVBRIDGE
     info["hades.out.display"] = DisplayModel();
-    const bool native = m_dvSignalling;
+    // (Hades: HDR over the tunnel is the HDR10 or HLG it carries, not Dolby Vision)
+    const bool tunnel = m_dvSignalling && m_outputHandover.HeldHdr10Tunnel();
+    const bool native =
+        KODI::WINDOWING::GBM::HDR10_TUNNEL::InfoNativeDolbyVision(m_dvSignalling, tunnel);
 #else
     const bool native = false;
 #endif
@@ -9898,6 +9903,16 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
         info["hades.out.linkformat"] = "";
         info["hades.out.depthwhy"] = "";
       }
+      // Hades: HDR over the tunnel: the display takes YCbCr 4:2:2 at 12 bits, as the AVI
+      // InfoFrame of the tunnel tells it; not what the ordinary output was found to send before
+      if (tunnel)
+      {
+        namespace T = KODI::WINDOWING::GBM::HDR10_TUNNEL;
+        info["hades.out.depthkind"] = "link";
+        info["hades.out.depth"] = std::to_string(T::LINK_DEPTH);
+        info["hades.out.linkformat"] = DVBRIDGE::LINK::DisplayName(T::LINK_FORMAT);
+        info["hades.out.depthwhy"] = "";
+      }
 #endif
       // What the display is told of the picture: native Dolby Vision, or the EOTF of the HDR
       // static metadata InfoFrame that the driver has, with its mastering display and light
-- 
2.53.0

