From cc04e0138bedbb1839352c791d3bec012ac4c5ca Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:30:00 +0000
Subject: [PATCH] VideoPlayer: the layer of a Dolby Vision profile 7 stream
 goes into the details of what is played

The library keeps the profile of a profile 7 file as "7FEL" or "7MEL" when it
scans it (GetDetailsFromFrame()). The details that VideoPlayer writes for a
file that is filled in by playing it (a disc, a stream) and the player's
HdrDetail label said only "7", because GetVideoStreamInfo() knows the
profile from the demuxer and the layer is only known from the pictures.

The decoded pictures carry it (strDVELType, the rule of the bridge). The
video player gives it to the process info as it decodes
(NoteVideoDVELType(): FEL from the first picture that says it and for the
rest of the stream, else MEL) and GetVideoStreamInfo() adds it to a "7", so
the details that are kept at the end of playback are "7FEL" / "7MEL" in
the format of Kodi 22. Reset with the codec info of each stream.

Not done: files that are in the library with "7" (scanned before) are not
changed by playing them: the details of a file that has some are not
replaced by what the player knows (they would lose the second video stream
of HDR10+ and the subtitles that the scan found).
---
 xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp | 16 ++++++++++++++++
 xbmc/cores/VideoPlayer/Process/ProcessInfo.h   |  5 +++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp         |  5 +++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp    |  4 ++++
 4 files changed, 30 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
index 78f58c3..270e539 100644
--- a/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
+++ b/xbmc/cores/VideoPlayer/Process/ProcessInfo.cpp
@@ -78,6 +78,7 @@ void CProcessInfo::ResetVideoCodecInfo()
   m_videoQueueLevel = 0;
   m_videoQueueDataLevel = 0;
   m_videoIsInterlaced = false;
+  m_videoDVELType.clear();
   m_deintMethods.clear();
   m_deintMethods.push_back(EINTERLACEMETHOD::VS_INTERLACEMETHOD_NONE);
   m_deintMethodDefault = EINTERLACEMETHOD::VS_INTERLACEMETHOD_NONE;
@@ -262,6 +263,21 @@ float CProcessInfo::GetVideoFps()
   return m_videoFPS;
 }
 
+void CProcessInfo::NoteVideoDVELType(const std::string& elType)
+{
+  if (elType.empty())
+    return;
+  std::unique_lock lock(m_videoCodecSection);
+  if (m_videoDVELType != "FEL")
+    m_videoDVELType = elType;
+}
+
+std::string CProcessInfo::GetVideoDVELType() const
+{
+  std::unique_lock lock(m_videoCodecSection);
+  return m_videoDVELType;
+}
+
 void CProcessInfo::SetVideoDAR(float dar)
 {
   std::unique_lock lock(m_videoCodecSection);
diff --git a/xbmc/cores/VideoPlayer/Process/ProcessInfo.h b/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
index 5aee51f..20ad3d9 100644
--- a/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
+++ b/xbmc/cores/VideoPlayer/Process/ProcessInfo.h
@@ -56,6 +56,10 @@ public:
   int GetVideoQueueDataLevel();
   void SetVideoInterlaced(bool interlaced);
   bool GetVideoInterlaced();
+  //! Hades: what the decoded pictures of a Dolby Vision profile 7 stream say of its enhancement
+  //! layer ("FEL" or "MEL"): "FEL" as soon as one picture says it, and for the rest of the stream
+  void NoteVideoDVELType(const std::string& elType);
+  std::string GetVideoDVELType() const;
   virtual EINTERLACEMETHOD GetFallbackDeintMethod();
   virtual void SetSwDeinterlacingMethods();
   void UpdateDeinterlacingMethods(std::list<EINTERLACEMETHOD> &methods);
@@ -160,6 +164,7 @@ protected:
   int m_videoQueueLevel = 0;
   int m_videoQueueDataLevel = 0;
   bool m_videoIsInterlaced;
+  std::string m_videoDVELType;
   std::list<EINTERLACEMETHOD> m_deintMethods;
   EINTERLACEMETHOD m_deintMethodDefault;
   mutable CCriticalSection m_videoCodecSection;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 6804c0b..37edec3 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -7471,6 +7471,11 @@ void CVideoPlayer::GetVideoStreamInfo(int streamId, VideoStreamInfo& info) const
     if (info.hdrDetail.length() == 0)
       info.hdrDetail =
           s.dovi.dv_profile == 0 ? "" : std::to_string(static_cast<int>(s.dovi.dv_profile));
+    // Hades: a profile 7 stream says which layer it has once its pictures have been decoded
+    // ("7FEL", "7MEL", as the library keeps it), so the details of a file that is filled in by
+    // playing it (a disc, a stream) carry it
+    if (s.dovi.dv_profile == 7 && info.hdrDetail == "7")
+      info.hdrDetail += m_processInfo->GetVideoDVELType();
     // distinguish HDR10 from HLG base
     if (s.dovi.dv_profile == 8)
     {
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 8447b06..9154db8 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -844,6 +844,10 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
       }
     }
 
+    // Hades: the layer of a Dolby Vision profile 7 stream, for the details that are kept of it
+    if (!m_picture.strDVELType.empty())
+      m_processInfo.NoteVideoDVELType(m_picture.strDVELType);
+
     if (m_softTelecine && m_speed == DVD_PLAYSPEED_NORMAL &&
         !(m_picture.iFlags & DVP_FLAG_INTERLACED))
     {
