From 4034e4dc15fa3cb97f1c3f6d2cbcbb610c0506b4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:03:45 +0000
Subject: [PATCH] dvbridge: report Dolby Vision only when native output is
 possible

Kodi on GBM did not report Dolby Vision in the display's HDR
capabilities; the dvbridge patch reported it for any Dolby Vision data
block, including Low-Latency-only displays, whatever the output driver.
On GBM the capability is read by System.SupportedHDRTypes, which
add-ons can use to choose streams, and a Dolby Vision stream (profile
5 in particular) plays correctly only through native output. It is now
reported when native output is possible in a transport mode: a display
with Dolby Vision Standard, an output backend, the RGB range selectable
where NVIDIA needs it, and native output not disabled.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 85e35a5..2e0b27d 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -777,8 +777,16 @@ CHDRCapabilities CWinSystemGbm::GetDisplayHDRCapabilities() const
   if (m_info->SupportsEOTF(UTILS::Eotf::HLG))
     caps.SetHLG();
 
+#ifdef HAVE_DVBRIDGE
+  // Dolby Vision plays correctly only through native output: report it (System.SupportedHDRTypes,
+  // which add-ons may use to choose streams) when native output is possible in a transport mode,
+  // not for any Dolby Vision block (a Low-Latency-only TV shows a profile 5 stream in wrong colours).
+  if (SupportsNativeDVOutput(true))
+    caps.SetDolbyVision();
+#else
   if (m_info->SupportsDolbyVision())
     caps.SetDolbyVision();
+#endif
 
   return caps;
 }
