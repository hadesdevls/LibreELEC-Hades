From cad7de12eee524e412252b42d7ad50c0c2628cae Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] MultiviewPacker: the base view is the view of the first
 picture that names its view

Which view is the base view was asked of the decoder's list of the views
of the stream, and only without one taken from the first picture that
named its view. The list is filled in by the thread that decodes, and
the decoder's user does not see it when there are several: measured, it
could be read with one thread and never with eight. On any machine with
more than one core the rule in use was the second one.

That is now the rule that is written down, with what it rests on (the
decoder gives the base view of an access unit before its other view, and
no other view before a base view), and the reading of the list is gone.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   |  2 +-
 .../DVDCodecs/Video/MultiviewPacker.cpp       | 23 +++----------------
 .../DVDCodecs/Video/MultiviewPacker.h         |  4 +---
 xbmc/cores/VideoPlayer/MultiviewChoice.h      |  8 +++----
 4 files changed, 9 insertions(+), 28 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index b3579e8..1ad5393 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -630,7 +630,7 @@ int CDVDVideoCodecFFmpeg::ReceiveMultiviewFrame(int result)
   {
     CMultiviewPacker::Result made = CMultiviewPacker::Result::NONE;
     if (result == 0)
-      made = m_multiview->Add(m_pDecodedFrame, m_pCodecContext);
+      made = m_multiview->Add(m_pDecodedFrame);
     else if (result == AVERROR_EOF)
       made = m_multiview->Flush(m_pDecodedFrame);
     else
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
index 91bdc98..faa3735 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -14,12 +14,10 @@
 
 extern "C"
 {
-#include <libavcodec/avcodec.h>
 #include <libavutil/avutil.h>
 #include <libavutil/dict.h>
 #include <libavutil/frame.h>
 #include <libavutil/imgutils.h>
-#include <libavutil/opt.h>
 #include <libavutil/pixdesc.h>
 }
 
@@ -46,22 +44,6 @@ View Describe(const AVFrame* frame)
   view.format = frame->format;
   return view;
 }
-
-// The base view is the first of the views that the decoder lists. Where it lists none, it is
-// the view of the picture that asks, the first one that came with the name of its view.
-int BaseView(AVCodecContext* decoder, int asking)
-{
-  unsigned int count = 0;
-  int64_t first = 0;
-  if (decoder &&
-      av_opt_get_array_size(decoder, DECODER_VIEW_LIST_OPTION, AV_OPT_SEARCH_CHILDREN, &count) >=
-          0 &&
-      count > 0 &&
-      av_opt_get_array(decoder, DECODER_VIEW_LIST_OPTION, AV_OPT_SEARCH_CHILDREN, 0, 1,
-                       AV_OPT_TYPE_INT64, &first) >= 0)
-    return static_cast<int>(first);
-  return asking;
-}
 } // namespace
 
 CMultiviewPacker::CMultiviewPacker(BaseEye baseEye)
@@ -183,12 +165,13 @@ CMultiviewPacker::Result CMultiviewPacker::Out(AVFrame* frame, bool packed, bool
   return Result::PICTURE;
 }
 
-CMultiviewPacker::Result CMultiviewPacker::Add(AVFrame* frame, AVCodecContext* decoder)
+CMultiviewPacker::Result CMultiviewPacker::Add(AVFrame* frame)
 {
   const View view = Describe(frame);
   if (view.hasId && !m_baseId)
   {
-    m_baseId = BaseView(decoder, view.id);
+    // the first picture that names its view is a base view (see KODI::MULTIVIEW::IsBase())
+    m_baseId = view.id;
     CLog::Log(LOGINFO,
               "CMultiviewPacker: the decoder gives the views of the stream; view {} is the base "
               "view, which is the {} eye",
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
index b991ffc..d91867b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
@@ -13,7 +13,6 @@
 #include <cstdint>
 #include <optional>
 
-struct AVCodecContext;
 struct AVFrame;
 
 /*!
@@ -51,9 +50,8 @@ public:
    * \brief Takes a picture that the decoder gave
    * \param frame the picture. It is taken; when a picture goes out, it holds that one, and else
    *        nothing
-   * \param decoder the decoder, asked once which of its views is the base view
    */
-  Result Add(AVFrame* frame, AVCodecContext* decoder);
+  Result Add(AVFrame* frame);
 
   /*!
    * \brief The decoder has no more pictures: a base view that still waits goes out alone
diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index eb84bff..c59089c 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -45,8 +45,6 @@ inline constexpr const char* DECODER_NAME = "h264_mvc";
 //! The option of that decoder that names the views to output, and its value for all of them
 inline constexpr const char* DECODER_VIEWS_OPTION = "view_ids";
 inline constexpr const char* DECODER_ALL_VIEWS = "-1";
-//! ... and the option in which it lists the views of the stream, the base view first
-inline constexpr const char* DECODER_VIEW_LIST_OPTION = "view_ids_available";
 
 //! The stereo mode of the picture that is made of the two views
 inline constexpr const char* PACKED_STEREO_MODE = "left_right";
@@ -272,8 +270,10 @@ struct View
  *
  * The decoder names the view of each picture when it outputs more than one view; a picture
  * without that name is the only view of its access unit, the base view. The base view of the
- * others is the first one of the list of views that the decoder gives, and where it gives no
- * list, the view of the first picture that had a name.
+ * others is the view of the first picture that had a name: the decoder gives the base view of
+ * an access unit before its other view, and gives no other view before it has given a base
+ * view. (The decoder also lists the views of the stream, the base view first, but not where
+ * its user can read the list while it decodes with several threads.)
  */
 inline bool IsBase(const View& view, int baseId)
 {
-- 
