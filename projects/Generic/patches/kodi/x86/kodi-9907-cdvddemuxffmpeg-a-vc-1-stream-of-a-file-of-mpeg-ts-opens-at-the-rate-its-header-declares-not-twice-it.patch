 .../VideoPlayer/DVDDemuxers/BlurayVc1Rate.h   | 45 ++++++++++----
 .../VideoPlayer/DVDDemuxers/CMakeLists.txt    |  4 +-
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 58 +++++++++++++------
 3 files changed, 74 insertions(+), 33 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayVc1Rate.h b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayVc1Rate.h
index 999a774..6fd922d 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayVc1Rate.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayVc1Rate.h
@@ -10,24 +10,35 @@
 
 /*!
  * \file BlurayVc1Rate.h
- * \brief Hades: the frame rate of a VC-1 stream of a Blu-ray, where FFmpeg gives its field rate.
+ * \brief Hades: the frame rate of a VC-1 stream of a Blu-ray, or of a file of MPEG-TS, where FFmpeg gives
+ *        its field rate.
  *
  * FFmpeg sets r_frame_rate of a stream whose codec can code fields (AV_CODEC_PROP_FIELDS, VC-1 among
  * them) to twice the rate its sequence header declares (libavformat/demux.c, avformat_find_stream_info()).
  * av_guess_frame_rate(), which Kodi takes, gives the declared rate back only where the average rate is
- * known, and avformat_find_stream_info() knows it only once it has read three pictures of the stream:
- * it stops as soon as every stream of the file has its parameters, which on a Blu-ray clip (its audio,
- * its PG streams) can be before that. The stream then opens at 47.952 instead of 23.976 (or 50 for 25,
- * 59.94 for 29.97, 48 for 24, 100 for 50), and the rate measured while it plays switches the display
- * again a few seconds into it. Measured with Hades' FFmpeg 9.0.2 on synthetic VC-1 clips: the field
- * rate stays whenever the analysis stops before the third picture, with or without pulldown.
+ * known and FFmpeg's own codec context of the stream has read the header, and avformat_find_stream_info()
+ * knows the average only once it has read three pictures of the stream: it stops as soon as every stream
+ * of the file has its parameters, which on a Blu-ray clip (its audio, its PG streams) can be before that.
+ * The stream then opens at 47.952 instead of 23.976 (or 50 for 25, 59.94 for 29.97, 48 for 24, 100 for
+ * 50), and the rate measured while it plays switches the display again a few seconds into it. Measured
+ * with Hades' FFmpeg 9.0.2 on synthetic VC-1 clips: the field rate stays whenever the analysis stops
+ * before the third picture, with or without pulldown.
  *
- * The declared rate is taken where FFmpeg's is exactly twice it, the average is not known, and the
- * stream number table of the disc's playlist declares the same rate: then it is the rate FFmpeg itself
- * gives once its analysis reads the third picture.
+ * A file of MPEG-TS played on its own (a .m2ts of a disc, a .ts) without HD audio is analysed for half a
+ * second and opened again (CDVDDemuxFFmpeg::Open()): the streams of the second opening are built from
+ * what the first one found, before FFmpeg has read anything of them, so its codec context has no rate
+ * and FFmpeg gives the field rate even where the first opening had found the average.
+ *
+ * The declared rate is taken where FFmpeg's is exactly twice it, the average is either not known or the
+ * declared rate itself, and the stream number table of the disc's playlist declares the same rate: then
+ * it is the rate FFmpeg itself gives once its analysis has read three pictures and its codec context the
+ * header. A file of MPEG-TS played on its own has no playlist: there the stream's own header is what
+ * declares it. Any other container (Matroska gives the duration of each picture, so FFmpeg knows its
+ * average) is left as it is.
  */
 
 #include <cstdint>
+#include <cstring>
 
 namespace KODI::BLURAYVC1
 {
@@ -44,17 +55,27 @@ inline bool SameRate(Rate a, Rate b)
          static_cast<int64_t>(a.num) * b.den == static_cast<int64_t>(b.num) * a.den;
 }
 
+//! Whether a file is read by FFmpeg's MPEG-TS demuxer (its name, AVInputFormat::name)
+inline bool IsTransportStream(const char* format)
+{
+  return format && std::strcmp(format, "mpegts") == 0;
+}
+
 /*!
  * \param guessed What av_guess_frame_rate() gives for the stream
  * \param average Its avg_frame_rate
  * \param declared The rate its sequence header declares (codecpar->framerate)
- * \param playlist The rate the stream number table of the play item declares for it
+ * \param playlist The rate the stream number table of the play item declares for it (for a file of
+ *        MPEG-TS played on its own, the declared rate itself)
  * \return Whether the rate guessed is the field rate of the declared one, which is the stream's
  */
 inline bool IsFieldRate(Rate guessed, Rate average, Rate declared, Rate playlist)
 {
   // (a rate the header does not declare is the playlist's rate of no stream: SameRate() is false)
-  if (average.Known() || !SameRate(declared, playlist))
+  if (!SameRate(declared, playlist))
+    return false;
+  // an average that FFmpeg measured and that is not the declared rate is the stream's: left as it is
+  if (average.Known() && !SameRate(average, declared))
     return false;
   return SameRate(guessed, Rate{declared.num * 2, declared.den});
 }
