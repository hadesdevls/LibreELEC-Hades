index 4a19de0..bc3bf26 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
@@ -20,6 +20,7 @@ if(TARGET ${APP_NAME_LC}::Bluray)
 endif()
 
 set(HEADERS BlurayOffsetMetadata.h
+            BlurayVc1Rate.h
             DemuxMultiSource.h
             DemuxReadStall.h
             DVDDemux.h
@@ -46,8 +47,7 @@ set(HEADERS BlurayOffsetMetadata.h
             DVDFactoryDemuxer.h)
 
 if(TARGET ${APP_NAME_LC}::Bluray)
-  list(APPEND HEADERS BlurayVc1Rate.h
-                      DVDDemuxBluray3D.h)
+  list(APPEND HEADERS DVDDemuxBluray3D.h)
 endif()
 
 if(ENABLE_DVBRIDGE)
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index db57e28..3e8cca7 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -8,12 +8,12 @@
 
 #include "DVDDemuxFFmpeg.h"
 
+#include "BlurayVc1Rate.h"
 #include "DVDDemuxUtils.h"
 #include "DVDInputStreams/DVDInputStream.h"
 #include "DVDInputStreams/DVDInputStreamNavigator.h"
 #include "Mpeg2SoftTelecine.h"
 #ifdef HAVE_LIBBLURAY
-#include "BlurayVc1Rate.h"
 #include "DVDInputStreams/BluraySecondaryStreams.h"
 #include "DVDInputStreams/DVDInputStreamBluray.h"
 #endif
@@ -3271,6 +3271,11 @@ void CDVDDemuxFFmpeg::RestoreProbedStreamParameters()
         cur->color_space = probed->color_space;
       if (cur->chroma_location == AVCHROMA_LOC_UNSPECIFIED)
         cur->chroma_location = probed->chroma_location;
+      // Hades: the rate that the sequence header of a VC-1 stream declares: only the analysis fills
+      // it in, and AddStream() needs it to tell FFmpeg's field rate from the stream's own
+      // (BlurayVc1Rate.h)
+      if (cur->codec_id == AV_CODEC_ID_VC1 && (cur->framerate.num == 0 || cur->framerate.den == 0))
+        cur->framerate = probed->framerate;
 
       if (st->r_frame_rate.num == 0 || st->r_frame_rate.den == 0)
         st->r_frame_rate = it->second.rFrameRate;
@@ -3397,33 +3402,48 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
         if (m_bMatroska && pStream->avg_frame_rate.num > 0 && pStream->avg_frame_rate.den > 0)
           frameRate = pStream->avg_frame_rate;
 
-#ifdef HAVE_LIBBLURAY
-        // Hades: a VC-1 stream of a Blu-ray whose rate FFmpeg gives as its field rate, because its
-        // analysis stopped before the third picture (BlurayVc1Rate.h): the rate its sequence header
-        // and the disc's playlist declare
-        if (pStream->codecpar->codec_id == AV_CODEC_ID_VC1 &&
-            m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY))
+        // Hades: a VC-1 stream whose rate FFmpeg gives as its field rate, because its analysis stopped
+        // before the third picture or, in a file opened again, its codec context has not read the
+        // header yet (BlurayVc1Rate.h): the rate its sequence header declares, where the disc's
+        // playlist declares it too, or, in a file of MPEG-TS (a .m2ts of a disc, a .ts), by itself
+        if (pStream->codecpar->codec_id == AV_CODEC_ID_VC1)
         {
-          int num = 0;
-          int den = 0;
-          const auto bluray = std::static_pointer_cast<CDVDInputStreamBluray>(m_pInput);
           const AVRational declared = pStream->codecpar->framerate;
-          if (bluray->GetVideoStreamRate(pStream->id, num, den) &&
-              KODI::BLURAYVC1::IsFieldRate(
-                  {frameRate.num, frameRate.den},
-                  {pStream->avg_frame_rate.num, pStream->avg_frame_rate.den},
-                  {declared.num, declared.den}, {num, den}))
+          KODI::BLURAYVC1::Rate stated;
+          const char* by = nullptr;
+          bool disc = false;
+#ifdef HAVE_LIBBLURAY
+          if (m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY))
+          {
+            disc = true;
+            const auto bluray = std::static_pointer_cast<CDVDInputStreamBluray>(m_pInput);
+            if (bluray->GetVideoStreamRate(pStream->id, stated.num, stated.den))
+              by = "its sequence header and the disc's playlist declare";
+          }
+#endif
+          if (!disc && KODI::BLURAYVC1::IsTransportStream(
+                           m_pFormatContext->iformat ? m_pFormatContext->iformat->name : nullptr))
+          {
+            stated = {declared.num, declared.den};
+            by = "its sequence header declares";
+          }
+          if (by && KODI::BLURAYVC1::IsFieldRate(
+                        {frameRate.num, frameRate.den},
+                        {pStream->avg_frame_rate.num, pStream->avg_frame_rate.den},
+                        {declared.num, declared.den}, stated))
           {
             CLog::Log(
                 LOGINFO,
                 "CDVDDemuxFFmpeg::AddStream - stream {}: VC-1 at {}/{} from FFmpeg, twice the "
-                "{}/{} that its sequence header and the disc's playlist declare (FFmpeg's "
-                "analysis ended before it had the average rate): {}/{} is taken",
-                pStream->index, frameRate.num, frameRate.den, num, den, declared.num, declared.den);
+                "{}/{} that {} ({}): {}/{} is taken",
+                pStream->index, frameRate.num, frameRate.den, stated.num, stated.den, by,
+                pStream->avg_frame_rate.num > 0 && pStream->avg_frame_rate.den > 0
+                    ? "FFmpeg has not read the header again since the file was opened again"
+                    : "FFmpeg's analysis ended before it had the average rate",
+                declared.num, declared.den);
             frameRate = declared;
           }
         }
-#endif
 
         if (frameRate.num > 0 && frameRate.den > 0)
         {
