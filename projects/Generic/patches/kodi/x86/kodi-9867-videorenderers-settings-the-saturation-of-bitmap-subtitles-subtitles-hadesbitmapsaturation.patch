+}
+
+float BitmapSubtitleSaturation(const CDVDOverlay& o)
+{
+  if (!o.IsBitmapSubtitle())
+    return 1.0f;
+  const int perc{CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+      CSettings::SETTING_SUBTITLES_HADESBITMAPSATURATION)};
+  if (perc >= 100 || perc < 0)
+    return 1.0f;
+  return static_cast<float>(perc) / 100.0f;
+}
