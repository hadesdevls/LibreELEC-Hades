diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayColour.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayColour.h
index aba77f0..922e88a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayColour.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayColour.h
@@ -24,7 +24,7 @@ namespace OVERLAY
  * PIXEL_A/R/G/BSHIFT-packed colours that are not premultiplied (PlatformDefs.h)
  *
  * Hades: Kodi's own functions of OverlayRendererUtil.cpp, unchanged, in a header that a test can
- * build without the rest of Kodi.
+ * build without the rest of Kodi; and the saturation of bitmap subtitles beside their light.
  */
 namespace COLOUR
 {
@@ -241,4 +241,38 @@ inline uint32_t ScaleLight(uint32_t colour, float factor, bool pq)
          scale((colour >> PIXEL_GSHIFT) & 0xff) << PIXEL_GSHIFT |
          scale((colour >> PIXEL_BSHIFT) & 0xff) << PIXEL_BSHIFT;
 }
+
+/*!
+ * \brief Hades: the light of a colour scaled by light (0 to 1) and its saturation by saturation
+ * (0 to 1: 0 is the grey of its luma), in linear light: decoded with the sRGB curve and taken
+ * around its BT.709 luma, or with ST 2084 (PQ) around its BT.2020 luma where pq; its luma is kept
+ * (then scaled by light). At a saturation of 1 it is ScaleLight(), byte for byte. Alpha is
+ * untouched.
+ */
+inline uint32_t AdjustColour(uint32_t colour, float light, float saturation, bool pq)
+{
+  if (saturation >= 1.0f)
+    return ScaleLight(colour, light, pq);
+  using namespace COLOUR;
+  const int shift[3] = {PIXEL_RSHIFT, PIXEL_GSHIFT, PIXEL_BSHIFT};
+  const float weight[3] = {pq ? 0.2627f : 0.2126f, pq ? 0.6780f : 0.7152f, pq ? 0.0593f : 0.0722f};
+  float linear[3];
+  float luma = 0.0f;
+  for (int i = 0; i < 3; i++)
+  {
+    const float code = static_cast<float>((colour >> shift[i]) & 0xff) / 255.0f;
+    linear[i] = pq ? DecodePQ(code) : SrgbToLinearComponent(code);
+    luma += weight[i] * linear[i];
+  }
+  const float s = std::max(saturation, 0.0f);
+  uint32_t out = colour & (0xffu << PIXEL_ASHIFT);
+  for (int i = 0; i < 3; i++)
+  {
+    const float value = (luma + s * (linear[i] - luma)) * light;
+    const float code = pq ? EncodePQ(value) : LinearToSrgbComponent(value);
+    out |= static_cast<uint32_t>(std::clamp(static_cast<int>(code * 255.0f + 0.5f), 0, 255))
+           << shift[i];
+  }
+  return out;
+}
 } // namespace OVERLAY
