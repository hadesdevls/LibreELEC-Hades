From 9210d7025fd2d909464eeac1e2aee125c6db6042 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sun, 11 Oct 2026 11:19:11 +0100
Subject: [PATCH] [VideoPlayer] Give a picture's display size without masking
 it

A decoder works out the size a picture is displayed at from its height
and its aspect ratio. The FFmpeg and DRM PRIME decoders then masked the
result with "& -3", which clears bit 1 and nothing else, so a width or
height with that bit set came out 2 smaller: 1279 as 1277, 1366 as
1364, 854 as 852. A renderer takes the picture's shape from the display
size, so such a picture was drawn narrower than it is and resampled. At
its original size a 1279 wide picture lost its one pixel detail in
bands across the width.

The expression came from ffplay, which wanted an even size for its
overlay and corrected it to "& ~1" in 2008 (FFmpeg r15173). In Kodi the
Android decoder had it changed to "& ~3" in 2016 and the add-on decoder
was written that way. That rounds down to a multiple of 4, which
squeezes the same pictures, and 1277 and 1278 wide ones as well.

Nothing that reads the display size needs it even or a multiple of 4,
and the webOS pipeline computes it with no mask. The four decoders now
do the same.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: the unit test, its two .mkv test files and their entries in
test-reference-data.txt are left out: the image does not build the
tests of Kodi, and the patches of the tree are applied with patch(1),
which does not take binary diffs.]
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp  | 6 ++++--
 .../DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp      | 4 ++--
 .../VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp   | 6 ++----
 .../VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp     | 4 ++--
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
index b39c552..8ee587d 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AddonVideoCodec.cpp
@@ -443,11 +443,13 @@ CDVDVideoCodec::VCReturn CAddonVideoCodec::GetPicture(VideoPicture* pVideoPictur
     pVideoPicture->iDisplayHeight = pVideoPicture->iHeight;
     if (m_displayAspect > 0.0f)
     {
-      pVideoPicture->iDisplayWidth = ((int)lrint(pVideoPicture->iHeight * m_displayAspect)) & ~3;
+      pVideoPicture->iDisplayWidth =
+          static_cast<int>(lrint(pVideoPicture->iHeight * m_displayAspect));
       if (pVideoPicture->iDisplayWidth > pVideoPicture->iWidth)
       {
         pVideoPicture->iDisplayWidth = pVideoPicture->iWidth;
-        pVideoPicture->iDisplayHeight = ((int)lrint(pVideoPicture->iWidth / m_displayAspect)) & ~3;
+        pVideoPicture->iDisplayHeight =
+            static_cast<int>(lrint(pVideoPicture->iWidth / m_displayAspect));
       }
     }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
index b5f395d..67bb605 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecAndroidMediaCodec.cpp
@@ -1801,11 +1801,11 @@ void CDVDVideoCodecAndroidMediaCodec::ConfigureOutputFormat(CJNIMediaFormat& med
 
   if (m_hints.aspect > 1.0 && !m_hints.forced_aspect)
   {
-    m_videobuffer.iDisplayWidth  = ((int)lrint(m_videobuffer.iHeight * m_hints.aspect)) & ~3;
+    m_videobuffer.iDisplayWidth = static_cast<int>(lrint(m_videobuffer.iHeight * m_hints.aspect));
     if (m_videobuffer.iDisplayWidth > m_videobuffer.iWidth)
     {
       m_videobuffer.iDisplayWidth  = m_videobuffer.iWidth;
-      m_videobuffer.iDisplayHeight = ((int)lrint(m_videobuffer.iWidth / m_hints.aspect)) & ~3;
+      m_videobuffer.iDisplayHeight = static_cast<int>(lrint(m_videobuffer.iWidth / m_hints.aspect));
     }
   }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
index 6943e68..13d30de 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
@@ -614,14 +614,12 @@ void CDVDVideoCodecDRMPRIME::SetPictureParams(VideoPicture* pVideoPicture)
     m_processInfo.SetVideoDAR(static_cast<float>(m_DAR));
   }
 
-  pVideoPicture->iDisplayWidth =
-      (static_cast<int>(lrint(pVideoPicture->iHeight * aspect_ratio))) & -3;
+  pVideoPicture->iDisplayWidth = static_cast<int>(lrint(pVideoPicture->iHeight * aspect_ratio));
   pVideoPicture->iDisplayHeight = pVideoPicture->iHeight;
   if (pVideoPicture->iDisplayWidth > pVideoPicture->iWidth)
   {
     pVideoPicture->iDisplayWidth = pVideoPicture->iWidth;
-    pVideoPicture->iDisplayHeight =
-        (static_cast<int>(lrint(pVideoPicture->iWidth / aspect_ratio))) & -3;
+    pVideoPicture->iDisplayHeight = static_cast<int>(lrint(pVideoPicture->iWidth / aspect_ratio));
   }
 
   pVideoPicture->color_range =
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index be7e905..e30f183 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -2246,11 +2246,11 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
 
   /* XXX: we suppose the screen has a 1.0 pixel ratio */ // CDVDVideo will compensate it.
   pVideoPicture->iDisplayHeight = pVideoPicture->iHeight;
-  pVideoPicture->iDisplayWidth  = ((int)RINT(pVideoPicture->iHeight * aspect_ratio)) & -3;
+  pVideoPicture->iDisplayWidth = static_cast<int>(RINT(pVideoPicture->iHeight * aspect_ratio));
   if (pVideoPicture->iDisplayWidth > pVideoPicture->iWidth)
   {
     pVideoPicture->iDisplayWidth  = pVideoPicture->iWidth;
-    pVideoPicture->iDisplayHeight = ((int)RINT(pVideoPicture->iWidth / aspect_ratio)) & -3;
+    pVideoPicture->iDisplayHeight = static_cast<int>(RINT(pVideoPicture->iWidth / aspect_ratio));
   }
 
 
