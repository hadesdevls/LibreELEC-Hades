From a639cd6b93eee4eb7df886f72edb466177545d75 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:46:06 +0000
Subject: [PATCH] DVStartSignal: the video has its time to take the signal from
 the display coming back

The Dolby Vision signal set up with the change of mode of a video waited
CDVStartSignal::WAIT_MS (10 s) from its commit for the renderer of the
video to take it. That commit starts Kodi's own wait after a change of
the refresh rate (videoscreen.delayrefreshchange, up to 20 s), during
which VideoPlayer does nothing: with a long delay, or a slow opening
after it, the time ran out, the ordinary output was restored, the video
started Dolby Vision again with one more HDMI negotiation, and it counted
as not taken: two in a row turned the signal off until Kodi started
again.

- The 10 s count from the display coming back (SendDisplayReset(),
  CDVStartSignal::DisplayBack()); until then, from the commit, 10 s more
  than the longest delay that can be set (DISPLAY_WAIT_MS, 25 s).
- Any renderer configured for the video takes the signal or refuses it
  (SetVideoOutput()), so a deadline means that the video was still
  opening: it ends the wait as neither taken nor refused (Ended()), and the
  signal is set up again for the next video. kodi.log says how long after
  the display came back, and how long Kodi waited for the display.

The case was found in CroqueMr's build, in his own start of conversion;
the start signal is YBLOD's idea. Test (host): the 1.0 RC5 test of the class
with the wait rewritten (99 checks: delays of 0, 5, 15 and 20 s, an
opening of 20 s, the display never said to be back); the deadline from
the commit, put back, fails 9 of them.
---
 xbmc/windowing/gbm/DVStartSignal.h            | 31 +++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 30 +++++++++++++-----
 2 files changed, 52 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/DVStartSignal.h b/xbmc/windowing/gbm/DVStartSignal.h
index a15e853..d1adf36 100644
--- a/xbmc/windowing/gbm/DVStartSignal.h
+++ b/xbmc/windowing/gbm/DVStartSignal.h
@@ -184,9 +184,25 @@ public:
   {
     m_pending = true;
     m_sentMs = nowMs;
+    m_back = false;
+    m_backMs = 0;
   }
   bool Pending() const { return m_pending; }
   int64_t SentMs() const { return m_sentMs; }
+  //! Hades: VideoPlayer and the audio engine were told at nowMs that the display is back
+  //! (SendDisplayReset(), after the delay that the user set for a change of the refresh rate,
+  //! videoscreen.delayrefreshchange): the time the video has to take the output counts from here.
+  //! Until then VideoPlayer does nothing (the idea of counting the time from there, not from the
+  //! commit, is from CroqueMr's build, where his own start had the same fault)
+  void DisplayBack(int64_t nowMs)
+  {
+    if (!m_pending || m_back)
+      return;
+    m_back = true;
+    m_backMs = nowMs;
+  }
+  bool Back() const { return m_back; }
+  int64_t BackMs() const { return m_backMs; }
 
   enum class Wait
   {
@@ -195,14 +211,20 @@ public:
     STOPPED, //!< the player stopped first: the ordinary output comes back
     DEADLINE, //!< WAIT_MS passed: the ordinary output comes back
   };
-  //! While it waits, each pass of the window system: playing, the player plays (or opens) a file
+  //! While it waits, each pass of the window system: playing, the player plays (or opens) a file.
+  //! Hades: WAIT_MS from the display coming back (DisplayBack()); before that, WAIT_MS more than the
+  //! longest delay the user can set (DISPLAY_WAIT_MS), in case the display is never said to be back.
+  //! Any renderer that is configured for the video takes the output or refuses it
+  //! (CWinSystemGbmGLESContext::SetVideoOutput()), so DEADLINE means that none was in that time:
+  //! the video was still opening (a slow server), which says nothing of the signal (the caller
+  //! ends the wait as neither taken nor refused, Ended())
   Wait Waiting(int64_t nowMs, bool playing) const
   {
     if (!m_pending)
       return Wait::NONE;
     if (!playing)
       return Wait::STOPPED;
-    if (nowMs - m_sentMs >= WAIT_MS)
+    if (m_back ? nowMs - m_backMs >= WAIT_MS : nowMs - m_sentMs >= WAIT_MS + DISPLAY_WAIT_MS)
       return Wait::DEADLINE;
     return Wait::WAITING;
   }
@@ -236,12 +258,17 @@ public:
   //! well under a second after the change of mode (0.53 s in the test of 2026-10-28, from a server
   //! on the Internet); the player that stops ends it at once
   static constexpr int64_t WAIT_MS = 10000;
+  //! Hades: the longest delay after a change of the refresh rate that the user can set
+  //! (videoscreen.delayrefreshchange: 20 s), and a margin
+  static constexpr int64_t DISPLAY_WAIT_MS = 25000;
   //! Videos in a row that did not take it
   static constexpr unsigned int NOT_TAKEN_LIMIT = 2;
 
 private:
   bool m_pending = false;
   int64_t m_sentMs = 0;
+  bool m_back = false;
+  int64_t m_backMs = 0;
   unsigned int m_notTaken = 0;
   bool m_refused = false;
 };
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2d1d804..0b363a1 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -826,14 +826,23 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
                 std::chrono::duration<double, std::milli>(now - m_dvStartAt).count();
             if (wait == CDVStartSignal::Wait::DEADLINE)
             {
-              m_dvStart.NotTaken();
+              // Hades: no renderer was configured for the video in that time (one that is takes
+              // the signal or refuses it, SetVideoOutput()): the video was still opening, which
+              // says nothing of the signal; it is set up again for the next video
+              const bool back = m_dvStart.Back();
+              m_dvStart.Ended();
               CLog::Log(LOGWARNING,
-                        "DVBridge: no video took the Dolby Vision signal set up with the change "
-                        "of mode within {} ms; the ordinary output is restored in that mode{}",
-                        CDVStartSignal::WAIT_MS,
-                        m_dvStart.Off() ? " (the signal is not set up so again until Kodi is "
-                                          "started again)"
-                                        : "");
+                        "DVBridge: the video was still opening {:.0f} ms after the Dolby Vision "
+                        "signal set up with the change of mode went out ({}); the ordinary "
+                        "output is restored in that mode, and the signal is set up again for the "
+                        "next video",
+                        waited,
+                        back ? StringUtils::Format(
+                                   "{} ms after the display was back; Kodi waited {} ms for "
+                                   "it after the change of the refresh rate",
+                                   nowMs - m_dvStart.BackMs(),
+                                   m_dvStart.BackMs() - m_dvStart.SentMs())
+                             : std::string("the display was never said to be back"));
             }
             else
             {
@@ -1087,12 +1096,19 @@ void CWinSystemGbmGLESContext::SendDisplayReset()
 #ifdef HAVE_DVBRIDGE
     // Hades: ... after the Dolby Vision signal set up with the change of mode (CDVStartSignal)
     if (std::exchange(m_dvStartReset, false))
+    {
+      // (the video has CDVStartSignal::WAIT_MS from here to take the signal; the clock of
+      // NowMs(), defined further down)
+      m_dvStart.DisplayBack(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
       CLog::Log(LOGINFO,
                 "DVBridge: VideoPlayer and the audio engine are told that the display is back {:.0f} "
                 "ms after the Dolby Vision signal went out with the change of mode",
                 std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
                                                           m_dvStartAt)
                     .count());
+    }
 #endif
     CWinSystemGbm::OnResetDisplay();
   }
-- 
2.53.0

