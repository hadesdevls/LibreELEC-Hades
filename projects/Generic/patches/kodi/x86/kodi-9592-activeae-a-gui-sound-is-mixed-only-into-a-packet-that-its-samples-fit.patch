From faff3a55fe94deb73f788f9ecdd46741a889beea Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:32:32 +0000
Subject: [PATCH] ActiveAE: a GUI sound is mixed only into a packet that its
 samples fit

Issue #4 (wright96d, 1.0 RC3 f605197, HP ZBook 17 G6 with a Quadro RTX 4000): Kodi ended on a
SIGSEGV in CAEUtil::SSEMulAddArray(), called from CActiveAE::MixSounds() in the engine's thread
(RunStages()), at 05:05:05, idle: no thread of the player was left, and the sink thread was writing
to ALSA. The tail of kodi.log in the crash log says what came before: a native Dolby Vision video
with TrueHD stopped at 05:04:22; the output was turned off and on again to leave native output;
during that reset of the display the player's free of its audio stream timed out ("CActiveAE::
FreeStream - failed", 05:04:26.589: data messages are deferred while the engine is suspended for
the display); after the display came back the outputs were listed again twice and the engine was
configured each time to encode to Dolby Digital and pass it through ("CAEEncoderFFmpeg::Initialize
- AC3 encoder ready", "ALSA is open for passthrough: STREAM_TYPE_AC3", 05:04:27.117 and 27.625),
which it does only with a stream there; and nothing more was logged in the 38 s before the crash
(kodi.log flushes every line). The display takes PCM in 2 channels and Dolby Digital in 6, so the
encoding is that of "surround as Dolby for a display that takes only stereo PCM". The log of that
session was not kept (the start folder was reused after an update) and the core was not
sent: what put a sound and a packet of different formats together is not known.

What the crash says is what MixSounds() does with such a pair: it takes as many planes as the packet
has from the sound's array of plane pointers (CActiveAE::AllocSoundSample() makes it with as many
entries as the sound has planes) and reads from each as many values a frame as the packet has. A
sound converted for an interleaved format (one plane) mixed into a packet of the planar float that
the engine uses when it encodes (six planes) reads five pointers past that array, and dereferences
them in SSEMulAddArray(). The sounds are converted for the engine's format (ResampleSound()) and
marked again only when Configure() sees that format change and the GUI sound mode lets sounds play
at that moment.

Now a sound whose samples are not those of the packet (sample format, channels, planes:
SoundFitsPacket()) is converted again for the engine's format before it is mixed; one that would
still be read past its samples (SoundSafeInPacket()) is left out, and one that would not is mixed
as before. kodi.log says it once, without debugging, with both formats, the mode, the streams and
the engine's format:

  ActiveAE - a GUI sound converted for 2 channels in 1 planes, flt, 48000 Hz was to be mixed into a
  packet of 6 channels in 6 planes, fltp, 48000 Hz (mode 1, 1 streams, the engine's format 6
  channels, AE_FMT_FLOATP): converted again for it

(figures made up; the mode is the engine's: 0 raw, 1 transcoding, 2 PCM). Where a sound and its
packet agree, which is how it goes but for this, nothing changes but one comparison.

Not run: the engine is not built on the host, and the crash is not reproduced. Compiled with the
compile commands of the build folder. If it happens again, that line says which formats met, and
the crash, if it was this, does not.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 60 +++++++++++++++++++
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  4 ++
 2 files changed, 64 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 61c3cde..da09d20 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -56,6 +56,33 @@ constexpr double MAX_LATE_START_MS = 500.0; // late start of audio left to the p
 // 6.2 s (NVIDIA, leaving native Dolby Vision for a mode on FRL).
 constexpr std::chrono::milliseconds DISPLAY_LOST_RETRY{10000};
 
+// Hades: whether the samples of a GUI sound, as it was converted, are those of a packet: the same
+// sample format, number of channels and of planes (CActiveAE::MixSounds())
+bool SoundFitsPacket(const CSoundPacket* sound, const CSoundPacket& packet)
+{
+  return sound && sound->data && sound->planes == packet.planes &&
+         sound->config.channels == packet.config.channels && sound->config.fmt == packet.config.fmt;
+}
+
+// ... and whether mixing them into it stays within them all the same: MixSounds() takes as many
+// planes as the packet has, and reads from each as many values a frame as a plane of the packet has
+bool SoundSafeInPacket(const CSoundPacket* sound, const CSoundPacket& packet)
+{
+  return sound && sound->data && packet.planes >= 1 && packet.planes <= sound->planes &&
+         packet.config.channels * sound->planes <= sound->config.channels * packet.planes &&
+         av_get_bytes_per_sample(sound->config.fmt) == av_get_bytes_per_sample(packet.config.fmt);
+}
+
+std::string SoundPacketText(const CSoundPacket* packet)
+{
+  if (!packet)
+    return "none";
+  const char* format = av_get_sample_fmt_name(packet->config.fmt);
+  return StringUtils::Format("{} channels in {} planes, {}, {} Hz", packet->config.channels,
+                             packet->planes, format ? format : "no format",
+                             packet->config.sample_rate);
+}
+
 //! \brief Retry interval for a sink that will not open, doubling to a ceiling.
 //! A device that returns announces itself, so only a fault that clears by itself needs the
 //! interval to stay short.
@@ -2934,6 +2961,39 @@ void CActiveAE::MixSounds(CSoundPacket &dstSample)
   {
     if (!it->sound->IsConverted())
       ResampleSound(it->sound);
+    // Hades: a sound is mixed into a packet of the format that it was converted for. Mixed into
+    // one of more planes or channels, the loop below takes pointers to planes that the sound does
+    // not have and reads past its samples. Issue #4 had Kodi end on a SIGSEGV in SSEMulAddArray()
+    // called from here, idle after a video, with the engine encoding to Dolby Digital; what led to
+    // it is not known. Such a sound is converted again for the format of the engine; one that would
+    // still be read past its samples is left out (one that would not is mixed as before), and the
+    // log says it once.
+    if (!SoundFitsPacket(it->sound->GetSound(false), dstSample))
+    {
+      const std::string before = SoundPacketText(it->sound->GetSound(false));
+      it->sound->SetConverted(false);
+      ResampleSound(it->sound);
+      const bool fits = SoundFitsPacket(it->sound->GetSound(false), dstSample);
+      const bool safe = SoundSafeInPacket(it->sound->GetSound(false), dstSample);
+      if (!m_soundMismatchTold)
+      {
+        m_soundMismatchTold = true;
+        CLog::Log(LOGWARNING,
+                  "ActiveAE - a GUI sound converted for {} was to be mixed into a packet of {} "
+                  "(mode {}, {} streams, the engine's format {} channels, {}): {}",
+                  before, SoundPacketText(&dstSample), static_cast<int>(m_mode), m_streams.size(),
+                  m_internalFormat.m_channelLayout.Count(),
+                  CAEUtil::DataFormatToStr(m_internalFormat.m_dataFormat),
+                  fits   ? "converted again for it"
+                  : safe ? "converted again, and mixed as before though it does not fit"
+                         : "it is not played");
+      }
+      if (!safe)
+      {
+        it = m_sounds_playing.erase(it);
+        continue;
+      }
+    }
     int available_samples = it->sound->GetSound(false)->nb_samples - it->samples_played;
     int mix_samples = std::min(max_samples, available_samples);
     int start = it->samples_played *
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index 06d09cd..3650c70 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -507,6 +507,10 @@ protected:
   bool m_aeMuted;
   bool m_aeGUISoundForce;
 
+  // Hades: a GUI sound whose samples did not fit the packet they were to be mixed into was told of
+  // in the log (MixSounds())
+  bool m_soundMismatchTold{false};
+
   float m_targetBufferLevel{0.0f};
   float m_initialTargetBufferLevel{0.0f};
 };
