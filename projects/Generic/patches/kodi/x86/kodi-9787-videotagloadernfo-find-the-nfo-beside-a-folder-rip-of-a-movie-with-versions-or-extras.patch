From e630758aeb449bce33f98c3c5befe73c1f8be677 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 28 Oct 2026 20:04:48 +0000
Subject: [PATCH] [VideoTagLoaderNFO] Find the nfo beside a folder rip of a
 movie with versions or extras.

A movie with versions or extras is listed in the library as a folder,
and the disc's file it was looked for as stayed one. The folder holding
the rip was then taken to be the disc's file itself, so its nfo was
still missed when the movie was refreshed.

The disc's file is now looked for as a file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/tags/VideoTagLoaderNFO.cpp     |  4 +++-
 xbmc/video/test/TestVideoTagLoaderNFO.cpp | 29 ++++++++++++++++-------
 2 files changed, 23 insertions(+), 10 deletions(-)

diff --git a/xbmc/video/tags/VideoTagLoaderNFO.cpp b/xbmc/video/tags/VideoTagLoaderNFO.cpp
index e84ee1c..2981bf1 100644
--- a/xbmc/video/tags/VideoTagLoaderNFO.cpp
+++ b/xbmc/video/tags/VideoTagLoaderNFO.cpp
@@ -189,9 +189,11 @@ std::string CVideoTagLoaderNFO::FindNFO(const CFileItem& item,
       const std::string path{URIUtils::GetDiscFile(item.GetPath())};
       if (!path.empty())
       {
-        // as the disc, which a library item's playlist would otherwise remain as
+        // as the disc's file, which a library item's playlist would otherwise remain as, or a
+        // movie with versions or extras listed as a folder
         item2.SetPath(path);
         item2.SetDynPath(path);
+        item2.SetFolder(false);
         nfoFile = FindNFO(item2, movieFolder);
         return nfoFile;
       }
diff --git a/xbmc/video/test/TestVideoTagLoaderNFO.cpp b/xbmc/video/test/TestVideoTagLoaderNFO.cpp
index 521223f..be6f206 100644
--- a/xbmc/video/test/TestVideoTagLoaderNFO.cpp
+++ b/xbmc/video/test/TestVideoTagLoaderNFO.cpp
@@ -142,6 +142,7 @@ struct DiscNfoTest
 {
   bool image; // a disc image FILM.iso in Film, or a folder rip of Film
   bool dynPath; // the playlist is the item's dynamic path too, as in a library item
+  bool hybridFolder; // a library item of a movie with versions or extras, listed as a folder
   bool movieFolder;
   std::vector<std::string> nfoFiles; // relative to the folder Film
   std::string expected;
@@ -149,17 +150,22 @@ struct DiscNfoTest
 
 const DiscNfoTest disc_nfo_tests[] = {
     // A folder rip's movie.nfo, or the index.nfo an export writes in its BDMV folder
-    {false, false, true, {"movie.nfo"}, "movie.nfo"},
-    {false, true, true, {"movie.nfo"}, "movie.nfo"},
-    {false, true, false, {"movie.nfo"}, "movie.nfo"},
-    {false, true, true, {"BDMV/index.nfo"}, "BDMV/index.nfo"},
+    {false, false, false, true, {"movie.nfo"}, "movie.nfo"},
+    {false, true, false, true, {"movie.nfo"}, "movie.nfo"},
+    {false, true, false, false, {"movie.nfo"}, "movie.nfo"},
+    {false, true, true, true, {"movie.nfo"}, "movie.nfo"},
+    {false, true, true, false, {"movie.nfo"}, "movie.nfo"},
+    {false, true, false, true, {"BDMV/index.nfo"}, "BDMV/index.nfo"},
+    {false, true, true, true, {"BDMV/index.nfo"}, "BDMV/index.nfo"},
     // Beside BDMV the folder can take any nfo, if it is the only one there
-    {false, true, true, {"Film.nfo"}, "Film.nfo"},
-    {false, true, true, {"anything.nfo"}, "anything.nfo"},
-    {false, true, true, {"movie.nfo", "Film.nfo"}, ""},
+    {false, true, false, true, {"Film.nfo"}, "Film.nfo"},
+    {false, true, false, true, {"anything.nfo"}, "anything.nfo"},
+    {false, true, false, true, {"movie.nfo", "Film.nfo"}, ""},
     // A disc image's movie.nfo, or the nfo named after it
-    {true, true, true, {"movie.nfo"}, "movie.nfo"},
-    {true, true, false, {"FILM.nfo"}, "FILM.nfo"},
+    {true, true, false, true, {"movie.nfo"}, "movie.nfo"},
+    {true, true, false, false, {"FILM.nfo"}, "FILM.nfo"},
+    {true, true, true, true, {"movie.nfo"}, "movie.nfo"},
+    {true, true, true, false, {"FILM.nfo"}, "FILM.nfo"},
 };
 } // namespace
 
@@ -190,6 +196,11 @@ TEST_P(DiscNfoTestFixture, FindNFO)
   CFileItem item(playlist, false);
   if (GetParam().dynPath)
     item.SetDynPath(playlist);
+  if (GetParam().hybridFolder)
+  {
+    item.SetFolder(true);
+    item.SetProperty("IsHybridFolder", true);
+  }
   const CVideoTagLoaderNFO loader(item, nullptr, GetParam().movieFolder);
 
   EXPECT_EQ(loader.GetNFOPath(), GetParam().expected.empty()
-- 
