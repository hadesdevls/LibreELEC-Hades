+void CDVBridgeGLES::UseDisplayManagement(unsigned int version)
+{
+  const auto older = [](unsigned int v) { return v == 2 || v == 3; };
+  if (older(version) && version != m_displayManagement)
+    CLog::Log(LOGINFO,
+              "DVBridge: the display reads Dolby Vision display management {}: frames carry the "
+              "content mapping v2.9 part of their metadata (levels 1, 2, 4 and 5), and the v4.0 "
+              "part (levels 3, 8 to 11 and 254), which a display of that version does not read, "
+              "is left out",
+              version);
+  else if (!older(version) && older(m_displayManagement))
+    CLog::Log(LOGINFO, "DVBridge: the display reads Dolby Vision display management {}: frames "
+                       "carry all of their metadata",
+              version ? std::to_string(version) : std::string("(not known)"));
+  m_displayManagement = version;
+  dvbridge_render_set_display_management(m_renderer, version);
+}
