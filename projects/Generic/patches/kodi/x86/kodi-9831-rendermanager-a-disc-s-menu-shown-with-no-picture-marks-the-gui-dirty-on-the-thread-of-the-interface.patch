From f226823ff9374e01ebefd829676599e7a38ffeb2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:21:43 +0000
Subject: [PATCH] RenderManager: a disc's menu shown with no picture marks the
 GUI dirty on the thread of the interface

CRenderManager::SetDiscMenuWithoutPicture() (a BD-J screen that plays no
playlist, drawn by the GUI pass over black, 8a02216) runs on the thread of
the player: from the loop of CVideoPlayer::Process() while such a screen
is shown (every 20 ms, with each new composition of the disc), from
OpenInputStream() and from OpenVideoStream(). Where the composition
changed it marked the GUI dirty there (OVERLAY::MarkDirty(),
CGUIWindowManager::MarkDirty()), and the dirty regions of the window
manager are a vector without a lock (CDirtyRegionTracker) that the thread
of the interface adds to in Process(), and reads and cleans in Render():
a data race, as often as an animated menu of a disc changes, with a list
that may be reallocated while the other thread walks it.

The player now only notes the change (m_menuWithoutPictureChanged), and
CRenderManager::FrameMove(), on the thread of the interface
(CWinSystemBase::DriveRenderLoop(), after the windows were processed),
marks the GUI dirty from it, before its return for a renderer that is not
configured: the screen with no picture has no video. A mark made there
takes back the skip of the GUI pass in that frame
(CGUIWindowManager::MarkedSinceProcess()), so the composition is drawn in
the same frame as before. Nothing else changes.

Tests (outside the tree): nopicture_wiring.py, the calls in the tree (5 of
its checks fail before this change); tracker_race_test.cpp with
ThreadSanitizer on Kodi's CDirtyRegionTracker from the tree, two threads
in the order of the frame: the mark made by the player is a data race in
MarkDirtyRegion(), the mark made by the interface from the flag is none.
---
 .../VideoPlayer/VideoRenderers/RenderManager.cpp     | 12 +++++++++++-
 .../cores/VideoPlayer/VideoRenderers/RenderManager.h |  4 ++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 49e51a0..ff8f8fc 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -332,6 +332,13 @@ bool CRenderManager::IsPresenting()
 
 void CRenderManager::FrameMove()
 {
+  // Hades: a disc's menu composition shown with no picture changed (SetDiscMenuWithoutPicture(),
+  // on the thread of the player): the GUI is marked dirty here, on the thread of the interface,
+  // also while no video is configured; after the windows were processed, so that the GUI pass of
+  // this frame draws it (CGUIWindowManager::MarkedSinceProcess())
+  if (m_menuWithoutPictureChanged.exchange(false))
+    OVERLAY::MarkDirty();
+
   bool firstFrame = false;
   UpdateResolution();
 
@@ -683,8 +690,11 @@ RESOLUTION CRenderManager::GetResolution()
 void CRenderManager::SetDiscMenuWithoutPicture(std::shared_ptr<CDVDOverlay> group)
 {
   m_menuWithoutPicture = group != nullptr;
+  // Hades: this runs on the thread of the player, and the dirty regions of the window manager are
+  // not guarded (CDirtyRegionTracker: the thread of the interface adds, reads and removes them in
+  // Process() and Render()): the change is marked on that thread, by FrameMove()
   if (m_overlays.SetNoPicture(group))
-    OVERLAY::MarkDirty();
+    m_menuWithoutPictureChanged = true;
 }
 
 void CRenderManager::RenderWithoutPicture()
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
index 582fb5d..5cfc75c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
@@ -152,6 +152,7 @@ public:
    * \brief Hades: a disc's menu composition (a group) to draw while no video is configured - a
    *        BD-J screen with no playlist, which a player shows over black - or nullptr. Drawn
    *        full screen in the fullscreen video window only. Player thread; cheap when unchanged.
+   *        A change marks the GUI dirty on the thread of the interface (FrameMove()).
    */
   void SetDiscMenuWithoutPicture(std::shared_ptr<CDVDOverlay> group);
   void ShowVideo(bool enable);
@@ -202,6 +203,9 @@ protected:
   void RenderWithoutPicture();
   //! Hades: SetDiscMenuWithoutPicture() holds a composition
   std::atomic<bool> m_menuWithoutPicture{false};
+  //! Hades: ... and it changed since the GUI was last marked dirty for it: marked by FrameMove(),
+  //! on the thread of the interface (the window manager's dirty regions are that thread's alone)
+  std::atomic<bool> m_menuWithoutPictureChanged{false};
 
   void PresentSingle(bool clear, DWORD flags, DWORD alpha);
   void PresentFields(bool clear, DWORD flags, DWORD alpha);
-- 
