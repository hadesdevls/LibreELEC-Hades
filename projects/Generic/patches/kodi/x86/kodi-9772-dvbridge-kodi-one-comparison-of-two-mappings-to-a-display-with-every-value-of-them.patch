From acafcd21889b3f48be997f3ebd76758d9e8d0656 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:26:49 +0000
Subject: [PATCH] dvbridge, kodi: one comparison of two mappings to a display,
 with every value of them

Three places compared two mappings of a picture to a display by listing their
values by hand, each a different part of them: CDVBridgeGLES::SetConversionMapping()
(which gives the renderer a mapping only where it changed) left out the trims of
the trim pass (83eb0f8) and the black; the log of TakeDVConversionMapping() the
2.2 EOTF of an SDR target and the black; the log of TakeDVLowLatencyMapping()
the gamut and the curve. Today none of it changes a picture: the conversion
bridge is made again with every configuration of the renderer (EndDVConversion()
in its UnInit()), and the mappings are taken only then. But a comparison that
leaves a value out keeps the renderer on the old mapping the day that value
changes alone, as the trims did when they were added.

dvbridge_hdr10_mapping_same() (dvbridge_placebo.h) compares every value that the
renderer takes of a mapping: the peak, the gamut, the curve, the target, the
black, the 2.2 EOTF of an SDR target, the trims, the primaries of the source
where they are known and the gamut of the display where it is its own; two that
are off are the same. The three comparisons are that one now. The pictures are
the bytes of before.

Host test (outside the tree): mapping_same_test (each value changed alone, and
the values that are not used where they are not), and the three uses. Before this change the test does not build and the uses are not there.
---
 tools/dvbridge/dvbridge_placebo.h             | 22 +++++++++++++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 12 +++------
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 27 +++----------------
 3 files changed, 29 insertions(+), 32 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index 4cb1bc5..71786c4 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -132,6 +132,28 @@ struct dvbridge_hdr10_mapping {
  * one in the gamut BT.709 only; Hades: one of DVBRIDGE_HDR10_GAMUT_CUSTOM to HDR10 only, with a
  * target_xy that is a gamut inside BT.2020). */
 bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m);
+/* Hades: two mappings that draw the same picture: every value that dvbridge_render_hdr10_mapping()
+ * and dvbridge_render_set_low_latency() take of one, the primaries of the source where they are
+ * known and the gamut of the display where it is its own (two that are off are the same). For
+ * whoever sets a mapping again only where it changed: one value left out of the comparison keeps
+ * the renderer on the old mapping when only that value changes. */
+static inline bool dvbridge_hdr10_mapping_same(const struct dvbridge_hdr10_mapping *a,
+                                               const struct dvbridge_hdr10_mapping *b)
+{
+    if (a->enabled != b->enabled)
+        return false;
+    if (!a->enabled)
+        return true;
+    if (a->peak != b->peak || a->gamut != b->gamut || a->curve != b->curve ||
+        a->target != b->target || a->source_known != b->source_known || a->black != b->black ||
+        a->gamma22 != b->gamma22 || a->trims != b->trims)
+        return false;
+    for (int i = 0; i < 8; ++i)
+        if ((a->source_known && a->source_xy[i] != b->source_xy[i]) ||
+            (a->gamut == DVBRIDGE_HDR10_GAMUT_CUSTOM && a->target_xy[i] != b->target_xy[i]))
+            return false;
+    return true;
+}
 /* Hades: the mapping of a picture to an SDR output: on, to DVBRIDGE_SDR_WHITE, in BT.709, with the
  * BT.2390 curve. source_xy as for any mapping (NULL: not known). */
 struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 480548b..d99525d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -2541,16 +2541,10 @@ void CDVBridgeGLES::SetConversionTarget(unsigned int framebuffer, bool limited)
 
 void CDVBridgeGLES::SetConversionMapping(const dvbridge_hdr10_mapping& mapping)
 {
+  // (Hades: every value of the mapping: the trims of "leave out the trims" were left out of this
+  // comparison, and a change of that setting alone kept the pictures on the old pass)
   const bool same =
-      m_convertMappingSet && mapping.enabled == m_convertMapping.enabled &&
-      (!mapping.enabled ||
-       (mapping.peak == m_convertMapping.peak && mapping.gamut == m_convertMapping.gamut &&
-        mapping.curve == m_convertMapping.curve && mapping.target == m_convertMapping.target &&
-        mapping.gamma22 == m_convertMapping.gamma22 &&
-        mapping.source_known == m_convertMapping.source_known &&
-        (!mapping.source_known ||
-         std::equal(std::begin(mapping.source_xy), std::end(mapping.source_xy),
-                    std::begin(m_convertMapping.source_xy)))));
+      m_convertMappingSet && dvbridge_hdr10_mapping_same(&mapping, &m_convertMapping);
   if (same || !m_renderer)
     return;
   m_convertMappingSet = true;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 454cd2c..a2d819f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4589,18 +4589,8 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
   // (videoscreen.hadesdvnotrims) is on
   if (mapping.enabled)
     mapping.trims = !BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVNOTRIMS, false);
-  const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
-    if (a.enabled != b.enabled)
-      return false;
-    if (!a.enabled)
-      return true;
-    for (int i = 0; i < 8; ++i)
-      if (a.source_known && a.source_xy[i] != b.source_xy[i])
-        return false;
-    return a.peak == b.peak && a.gamut == b.gamut && a.curve == b.curve &&
-           a.source_known == b.source_known && a.target == b.target && a.trims == b.trims;
-  };
-  if (!m_dvConvertMappingSet || !same(mapping, m_dvConvertMapping) ||
+  // (Hades: told where it changed: dvbridge_hdr10_mapping_same(), every value of it)
+  if (!m_dvConvertMappingSet || !dvbridge_hdr10_mapping_same(&mapping, &m_dvConvertMapping) ||
       plain != m_dvConvertMappingPlain)
   {
     static const char* const gamuts[] = {"BT.2020", "DCI-P3 (D65)", "BT.709"};
@@ -4719,17 +4709,8 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
       mapping = dvbridge_hdr10_mapping{};
     }
   }
-  const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b)
-  {
-    if (a.enabled != b.enabled || a.source_known != b.source_known || a.peak != b.peak ||
-        a.black != b.black || a.trims != b.trims)
-      return false;
-    for (int i = 0; i < 8; ++i)
-      if (a.target_xy[i] != b.target_xy[i] || a.source_xy[i] != b.source_xy[i])
-        return false;
-    return true;
-  };
-  if (mapping.enabled && (!m_dvLowLatencyMappingSet || !same(mapping, m_dvLowLatencyMapping)))
+  if (mapping.enabled && (!m_dvLowLatencyMappingSet ||
+                          !dvbridge_hdr10_mapping_same(&mapping, &m_dvLowLatencyMapping)))
     CLog::Log(LOGINFO,
               "DVBridge: Dolby Vision Low-Latency is mapped to the display by LibreELEC Hades (not by "
               "Dolby's display management): to {:.0f} cd/m2 and the primaries {:.4f},{:.4f} "
-- 
