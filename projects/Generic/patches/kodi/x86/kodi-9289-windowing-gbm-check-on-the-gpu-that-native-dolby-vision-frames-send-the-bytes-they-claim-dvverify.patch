@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Hades: a check, for a test on a GPU, that what native Dolby Vision output does to save GPU time
+ * sends the bytes it says it sends (<video><dvverify>N</dvverify></video>, CDVBridgeGLES).
+ *
+ * A frame is drawn a second time, by a renderer of its own with every one of those optimisations
+ * off (dvbridge_render_reference()): no picture kept on the screen in place of drawing it again,
+ * no images of an enhancement surface kept from an earlier frame (the caller imports the layer
+ * anew), no bars left uncleared, no bars written before the reconstruction, no packing with quad
+ * operations, no GPU program taken from the cache of earlier sessions, nothing kept by the
+ * renderer from one frame to the next. The transport that goes out is copied
+ * (dvbridge_verify_keep()) and the two are compared on the GPU, a block of 16x16 pixels for each
+ * value of a small target that is read back without waiting for it (dvbridge_verify_compare(),
+ * dvbridge_verify_take()). The idea of checking an optimised way against the plain one on the
+ * GPU, frame by frame, is that of the "verify" switches of the YBLOD fork.
+ *
+ * What it costs while it is in use: the second render, a copy of the 3840x2160 transport, the
+ * comparison, and GPU memory: the reference's RGBA32F picture (132 MB) and the intermediate
+ * textures of its renderer, the two RGBA8 transports (33 MB each). Nothing of it exists while it
+ * is not in use. All calls on the GL context of the renderer whose frames are checked. */
+#ifndef DVBRIDGE_VERIFY_H
+#define DVBRIDGE_VERIFY_H
+#include "dvbridge_render.h"
+#include <libplacebo/cache.h>
+#include <stdint.h>
+
+struct dvbridge_verifier;
+/* gpu: that of the renderer whose frames are checked. pack_vertex, pack_fragment: the shaders of
+ * the packer of a composed picture (made with two fetches a pixel). NULL when something cannot be
+ * made. */
+struct dvbridge_verifier *dvbridge_verifier_create(pl_gpu gpu, pl_log log, const char *pack_vertex,
+                                                   const char *pack_fragment);
+void dvbridge_verifier_destroy(struct dvbridge_verifier *verifier);
+
+/* The reference of a frame (dvbridge_render_reference()): the picture that main draws, or would
+ * draw now, the way it was drawn (direct), into the verifier's own transport. cache: the program
+ * cache that gpu has (pl_gpu_set_cache(), NULL for none): taken off while the reference draws and
+ * put back, so that the reference's programs are compiled from their source and are not kept. */
+bool dvbridge_verify_draw(struct dvbridge_verifier *verifier, const struct dvbridge_renderer *main,
+                          const struct pl_frame *source, const void *metadata, size_t bytes,
+                          double pts, double el_pts, struct dvbridge_geometry geometry, bool direct,
+                          pl_cache cache);
+/* The last reference was drawn with the residual of an enhancement layer: a frame drawn without it
+ * (its layer could not be imported) is another picture, not a fault of an optimisation. */
+bool dvbridge_verify_residual(const struct dvbridge_verifier *verifier);
+
+/* The transport of a frame as it goes out, in a 3840x2160 framebuffer of 8 bits a component, first
+ * row at the bottom (0: the window), copied: what the screen shows from then on. */
+bool dvbridge_verify_keep(struct dvbridge_verifier *verifier, unsigned framebuffer);
+
+/* The last reference against the transport copied last, compared on the GPU; the result is taken
+ * with dvbridge_verify_take(). false when there is nothing to compare (no reference since the last
+ * comparison, or no copy), or when DVBRIDGE_VERIFY_SLOTS comparisons wait for their results. */
+#define DVBRIDGE_VERIFY_SLOTS 4
+bool dvbridge_verify_compare(struct dvbridge_verifier *verifier, unsigned tag);
+
+struct dvbridge_verify_first {
+    unsigned x, y;                /* in the raster, from the top left */
+    uint32_t sent, reference;     /* the transport bytes, 0xRRGGBB */
+    bool metadata;                /* the pixel carries a metadata bit */
+};
+struct dvbridge_verify_result {
+    unsigned tag;                 /* that of dvbridge_verify_compare() */
+    unsigned long differing;      /* pixels whose transport bytes (RGB) differ */
+    unsigned blocks;              /* blocks of 16x16 pixels with such pixels */
+    unsigned largest;             /* the largest difference of a 12-bit luma or chroma code */
+    unsigned metadata;            /* blocks whose first differing pixel carries a metadata bit */
+    unsigned listed;              /* first[]: the first differing pixel of each of the first blocks
+                                   * that have one, in the order of the raster */
+    struct dvbridge_verify_first first[4];
+};
+/* The result of the oldest comparison that waits: 1 when it is back (within timeout_ms), with it;
+ * 0 when it is not back yet; -1 when no comparison waits; -2 when it was lost (the GPU gave no
+ * answer to the wait), and it no longer waits. */
+int dvbridge_verify_take(struct dvbridge_verifier *verifier, struct dvbridge_verify_result *result,
+                         unsigned timeout_ms);
+unsigned dvbridge_verify_waiting(const struct dvbridge_verifier *verifier);
+#endif
