+bool CWinSystemGbmGLESContext::DVVerifyOn()
+{
+  // Hades: <video><dvverify>N</dvverify></video> in advancedsettings.xml, read for each native
+  // output: at most N of its frames are checked. Without it nothing of the check is made.
+  if (!m_dvVerifyRead)
+  {
+    m_dvVerifyRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    const int budget = advanced ? std::max(advanced->m_videoDVVerify, 0) : 0;
+    m_dvVerify.Start(static_cast<unsigned int>(budget));
+    m_dvVerifyPending = false;
+    m_dvVerifyShownCopied = false;
+    m_dvVerifyIdentical = m_dvVerifyDiffering = m_dvVerifyLost = 0;
+    if (budget > 0)
+    {
+      if (m_dvBridge && m_dvBridge->VerifyBegin())
+        CLog::Log(LOGINFO,
+                  "DVBridge: dvverify: up to {} frames of this native output are checked against "
+                  "the same picture drawn once more with every optimisation that must not change "
+                  "its bytes turned off (advancedsettings.xml, dvverify). A check costs a second "
+                  "render and a copy of the transport; frames that keep a picture on the screen "
+                  "are checked where they come",
+                  budget);
+      else
+      {
+        CLog::Log(LOGWARNING, "DVBridge: dvverify: what the check needs could not be made (GPU "
+                              "memory): no frame of this native output is checked");
+        m_dvVerify.Start(0);
+      }
+    }
+  }
+  return m_dvVerify.On();
+}
+
+bool CWinSystemGbmGLESContext::DVVerifyTake(
+    bool kept, bool clean, bool direct, bool residual, bool bars, double pts)
+{
+  CDVVerify::Refresh refresh;
+  refresh.kept = kept;
+  refresh.clean = clean;
+  refresh.level = m_dvStepLevel;
+  refresh.kind = CDVVerify::Kind(direct, residual, m_dvStepLevel, bars, kept);
+  // room for a second render: twice the GPU time of a frame (on average, as last measured) within
+  // three quarters of what a frame has (a refresh; two when frames are presented a frame ahead)
+  const double period = DVRefreshPeriodMs();
+  const double average = m_dvAhead.Average();
+  refresh.room = average > 0 && period > 0 &&
+                 2 * average <= 0.75 * period * (m_dvAheadShown ? 2.0 : 1.0);
+  refresh.copied = m_dvVerifyShownCopied;
+  const auto why = m_dvVerify.Take(refresh, m_dvBridge->VerifyWaiting() < DVBRIDGE_VERIFY_SLOTS);
+  if (why == CDVVerify::Why::NONE)
+    return false;
+  m_dvVerifyFrame = {why, m_dvVerify.Made(), direct, kept, residual, bars, m_dvStepLevel, pts};
+  return true;
+}
+
+void CWinSystemGbmGLESContext::DVVerifyCompared(const DVVerifyCheck& check)
+{
+  // (no more than DVBRIDGE_VERIFY_SLOTS wait, with numbers one after another)
+  m_dvVerifyWaiting[check.number % m_dvVerifyWaiting.size()] = check;
+}
+
+void CWinSystemGbmGLESContext::DVVerifyCollect(unsigned int timeoutMs)
+{
+  if (!m_dvBridge || !m_dvBridge->Verifying())
+    return;
+  for (;;)
+  {
+    dvbridge_verify_result result{};
+    const int got = m_dvBridge->VerifyTake(result, timeoutMs);
+    if (got == 0 || got == -1)
+      return;
+    if (got < 0)
+    {
+      ++m_dvVerifyLost;
+      CLog::Log(LOGWARNING, "DVBridge: dvverify: a check gave no result (the GPU did not answer)");
+      continue;
+    }
+    const DVVerifyCheck& check = m_dvVerifyWaiting[result.tag % m_dvVerifyWaiting.size()];
+    const std::string what = StringUtils::Format(
+        "{}; {}{}, {}, fidelity step-down level {}{}; the picture at {:.3f} s",
+        CDVVerify::Name(check.why), check.direct ? "drawn directly" : "composed",
+        check.kept ? ", kept on the screen" : "",
+        check.residual ? "with the residual of its enhancement layer" : "without a residual",
+        check.level, check.bars ? ", with bars" : "", check.pts / DVD_TIME_BASE);
+    if (!result.differing)
+    {
+      ++m_dvVerifyIdentical;
+      CLog::Log(LOGINFO, "DVBridge: dvverify: frame {} identical ({})", check.number, what);
+      continue;
+    }
+    ++m_dvVerifyDiffering;
+    std::string where;
+    for (unsigned int i = 0; i < result.listed; ++i)
+      where += StringUtils::Format("{}{},{}{}: sent {:06x}, reference {:06x}", i ? "; " : "",
+                                   result.first[i].x, result.first[i].y,
+                                   result.first[i].metadata ? " (a metadata bit)" : "",
+                                   result.first[i].sent, result.first[i].reference);
+    CLog::Log(LOGWARNING,
+              "DVBridge: dvverify: frame {} DIFFERS: {} pixels in {} blocks of 16x16, the largest "
+              "difference {} codes of 4096; the first of the first blocks at {} ({})",
+              check.number, result.differing, result.blocks, result.largest, where, what);
+  }
+}
+
+void CWinSystemGbmGLESContext::DVVerifyEnd()
+{
+  if (!m_dvVerifyRead)
+    return;
+  m_dvVerifyRead = false;
+  if (m_dvBridge && m_dvBridge->Verifying())
+  {
+    DVVerifyCollect(2000);
+    CLog::Log(LOGINFO,
+              "DVBridge: dvverify: {} frames of this native output checked: {} identical, {} "
+              "differing, {} without a result; {} checks could not be made (the frame was drawn "
+              "another way than its reference, or the reference could not be drawn)",
+              m_dvVerifyIdentical + m_dvVerifyDiffering + m_dvVerifyLost, m_dvVerifyIdentical,
+              m_dvVerifyDiffering, m_dvVerifyLost, m_dvVerify.MissedChecks());
+    m_dvBridge->VerifyEnd();
+  }
+  m_dvVerify.Start(0);
+  m_dvVerifyPending = false;
+  m_dvVerifyShownCopied = false;
+}
