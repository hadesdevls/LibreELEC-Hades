         r->legacy_composer = !use;
 }
 
+struct dvbridge_renderer *dvbridge_renderer_create_reference(pl_gpu gpu, pl_log log)
+{
+    struct dvbridge_renderer *r = create_renderer(gpu, log, true);
+    if (r)
+        r->early_off = true;
+    return r;
+}
+
+/* Hades: a framebuffer of the target, filled with a value that no transport pixel has: the green
+ * byte is the high bits of a luma code, which is 256 at the least (16), never 0 */
+static void fill_unwritten(unsigned framebuffer)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glViewport(0, 0, 3840, 2160);
+    glClearColor(1.0f, 0.0f, 1.0f, 0.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+}
+
+bool dvbridge_render_reference(struct dvbridge_renderer *ref, const struct dvbridge_renderer *main,
+                               const struct pl_frame *source, const void *metadata, size_t bytes,
+                               double pts, double el_pts, struct dvbridge_geometry geometry,
+                               bool direct, pl_tex target, unsigned framebuffer,
+                               struct dvbridge_gl_packer *packer, unsigned *packets)
+{
+    if (packets)
+        *packets = 0;
+    if (!ref || !main || ref == main || !framebuffer || (direct ? !target : !packer))
+        return false;
+    /* Nothing of what a renderer keeps from one frame to the next: no frame of libplacebo's, no
+     * hook that it turned off, no candidate, nothing learnt of the bars written first; the area
+     * outside the active picture written with the rest. The metadata, the transport state and what
+     * chooses another picture on purpose (the fidelity step-down level, the composer) are those of
+     * the renderer whose frame this checks. */
+    dvbridge_renderer_recover(ref);
+    ref->early_off = true;
+    ref->early_unusable[0] = ref->early_unusable[1] = false;
+    ref->early_failures[0] = ref->early_failures[1] = 0;
+    ref->rgb_clean = false;
+    ref->step = main->step;
+    ref->legacy_composer = main->legacy_composer;
+    ref->serializer = main->context;
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    save_gl_state(&state);
+    bool ok;
+    if (direct) {
+        /* a pixel that the render does not write reads as no transport pixel does */
+        fill_unwritten(framebuffer);
+        ok = dvbridge_render_packed(ref, source, metadata, bytes, pts, el_pts, geometry, target, true);
+    } else {
+        /* the whole picture black first, also where the render is to write it all */
+        pl_tex_clear(ref->gpu, ref->rgb, (float[4]){0, 0, 0, 1});
+        ok = dvbridge_render_rgb(ref, source, metadata, bytes, pts, el_pts, geometry);
+        unsigned count = 0;
+        const uint32_t *words = ok ? dvbridge_packets(ref->pending, &count) : NULL;
+        fill_unwritten(framebuffer);
+        ok = ok && dvbridge_gl_pack(packer, pl_opengl_unwrap(ref->gpu, ref->rgb, NULL, NULL, NULL),
+                                    framebuffer, 3840, 2160, words, count, true);
+    }
+    if (ok && packets)
+        dvbridge_packets(ref->pending, packets);
+    ref->serializer = NULL;
+    restore_gl_state(&state);
+    return ok && glGetError() == GL_NO_ERROR;
+}
+
 /* Hades: what dvbridge_render_warm() keeps of the renderer while it draws */
 struct kept_state {
     struct dvbridge_candidate *pending;
