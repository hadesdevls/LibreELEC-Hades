+/*!
+ * \brief Hades: which refreshes of native Dolby Vision output are checked against the same picture
+ *        drawn once more with every optimisation that must not change bytes turned off
+ *        (<video><dvverify>N</dvverify></video> in advancedsettings.xml; dvbridge_verify.h)
+ *
+ * For a test on a GPU. At most N checks in a native output, one at a time for each refresh, of a
+ * refresh without GUI elements, overlays or a capture (what is drawn over the picture is not part of
+ * the reference). A check is due:
+ *  - KIND: at the first refresh of each kind of render in the native output (the way it is drawn,
+ *    with or without the residual of an enhancement layer, the fidelity step-down level, with the
+ *    bars written first or not, drawn or kept on the screen): the first use of the programs of
+ *    that kind, which come from the cache of earlier sessions where it has them;
+ *  - LEVEL: at the first refresh after a change of the step-down level (the picture kept on the
+ *    screen across it is the one of the level before, which is what such a check finds);
+ *  - AFTER_GUI: at the first refresh without GUI elements after refreshes with them (the GUI drew
+ *    over the bars, which the frame after it clears again);
+ *  - KEPT: at the first refresh that keeps a picture on the screen in the native output;
+ *  - SAMPLE: every PERIOD refreshes, spread over the playback. A sampled check waits for a refresh
+ *    with room for it: one that keeps the picture on the screen (nothing else is drawn in it), or a
+ *    frame whose GPU time leaves room for the second render; after WAIT refreshes without one, it is
+ *    made at the next refresh all the same (on a GPU without room, one refresh can then be late).
+ * A check of any reason does for all the reasons due at that refresh. A refresh that keeps the
+ * picture on the screen is checked against the transport copied when that picture was presented,
+ * which is copied only where pictures are kept on the screen (one was in the last PERIOD
+ * refreshes) and a check might come at such a refresh (WantsCopy()): a film at the refresh rate of
+ * the display has no copies made.
+ */
+class CDVVerify
+{
+public:
+  static constexpr unsigned int PERIOD = 100; //!< refreshes between two sampled checks
+  static constexpr unsigned int WAIT = 240; //!< refreshes that a sampled check waits for room
+  static constexpr unsigned int KINDS = 64; //!< kinds of render told apart in a native output
+
+  enum class Why
+  {
+    NONE,
+    KIND,
+    LEVEL,
+    AFTER_GUI,
+    KEPT,
+    SAMPLE,
+  };
+
+  static const char* Name(Why why)
+  {
+    switch (why)
+    {
+      case Why::KIND:
+        return "the first refresh of its kind";
+      case Why::LEVEL:
+        return "the first refresh after a change of the fidelity step-down level";
+      case Why::AFTER_GUI:
+        return "the first refresh without GUI elements after some with them";
+      case Why::KEPT:
+        return "the first refresh that keeps a picture on the screen";
+      case Why::SAMPLE:
+        return "sampled";
+      default:
+        return "none";
+    }
+  }
+
+  //! What tells the kinds of render apart (see KIND)
+  static uint32_t Kind(bool direct, bool residual, int level, bool bars, bool kept)
+  {
+    return (direct ? 1u : 0u) | (residual ? 2u : 0u) | (bars ? 4u : 0u) | (kept ? 8u : 0u) |
+           (static_cast<uint32_t>(level & 7) << 4);
+  }
+
+  //! A native output starts: at most budget checks in it (0: none)
+  void Start(unsigned int budget)
+  {
+    *this = CDVVerify();
+    m_budget = budget;
+  }
+
+  //! Checks are still to be made in this native output
+  bool On() const { return m_made < m_budget; }
+  unsigned int Budget() const { return m_budget; }
+  unsigned int Made() const { return m_made; }
+
+  //! A refresh of native output, before anything of it is drawn
+  struct Refresh
+  {
+    bool kept = false; //!< it keeps the picture on the screen (nothing is drawn)
+    bool clean = false; //!< without GUI elements, overlays or a capture
+    uint32_t kind = 0; //!< Kind()
+    int level = 0; //!< its fidelity step-down level
+    bool room = false; //!< (drawn) its GPU time leaves room for the second render
+    bool copied = false; //!< (kept) the transport on the screen was copied when it was presented
+  };
+
+  /*!
+   * \brief Whether the refresh is checked
+   * \param free a comparison can be made now (not too many wait for their results)
+   * \return why, or NONE
+   */
+  Why Take(const Refresh& r, bool free)
+  {
+    ++m_refreshes;
+    if (r.kept)
+      m_keptAt = m_refreshes;
+    if (m_level >= 0 && r.level != m_level)
+      m_levelDue = true;
+    m_level = r.level;
+    if (!r.clean)
+    {
+      m_gui = true;
+      return Why::NONE;
+    }
+    if (m_gui)
+    {
+      m_gui = false;
+      m_afterGuiDue = true;
+    }
+    if (!m_sampleDue && m_refreshes - m_sampled >= PERIOD)
+    {
+      m_sampleDue = true;
+      m_sampleSince = m_refreshes;
+    }
+    if (!On() || !free || (r.kept && !r.copied))
+      return Why::NONE;
+    Why why = Why::NONE;
+    if (r.kept && !m_keptChecked)
+      why = Why::KEPT;
+    else if (!Known(r.kind))
+      why = Why::KIND;
+    else if (m_levelDue)
+      why = Why::LEVEL;
+    else if (m_afterGuiDue)
+      why = Why::AFTER_GUI;
+    else if (m_sampleDue && (r.kept || r.room || m_refreshes - m_sampleSince >= WAIT))
+      why = Why::SAMPLE;
+    if (why == Why::NONE)
+      return why;
+    // (what Missed() puts back)
+    m_undo = {m_levelDue, m_afterGuiDue, m_keptChecked, m_sampleDue, m_sampled, m_kinds, true};
+    Remember(r.kind);
+    m_levelDue = false;
+    m_afterGuiDue = false;
+    m_keptChecked = m_keptChecked || r.kept;
+    m_sampleDue = false;
+    m_sampled = m_refreshes;
+    ++m_made;
+    return why;
+  }
+
+  //! The check that Take() asked for last could not be made (the frame was drawn another way, or
+  //! the reference could not be drawn): what it was for is due again
+  void Missed()
+  {
+    if (!m_undo.valid)
+      return;
+    m_levelDue = m_undo.levelDue;
+    m_afterGuiDue = m_undo.afterGuiDue;
+    m_keptChecked = m_undo.keptChecked;
+    m_sampleDue = m_undo.sampleDue;
+    m_sampled = m_undo.sampled;
+    m_kinds = m_undo.kinds;
+    m_undo.valid = false;
+    --m_made;
+    ++m_missed;
+  }
+  //! Checks that Take() asked for and that could not be made
+  unsigned int MissedChecks() const { return m_missed; }
+
+  //! Whether the transport of a frame without GUI elements that is presented without a check is
+  //! copied: a refresh that keeps it on the screen may be checked
+  bool WantsCopy() const
+  {
+    return On() && m_keptAt && m_refreshes - m_keptAt < PERIOD &&
+           (!m_keptChecked || m_levelDue || m_afterGuiDue || m_sampleDue);
+  }
+
+private:
+  bool Known(uint32_t kind) const
+  {
+    for (unsigned int i = 0; i < m_kinds; ++i)
+      if (m_kind[i] == kind)
+        return true;
+    // (more kinds than are told apart: the others are taken as known)
+    return m_kinds == KINDS;
+  }
+  void Remember(uint32_t kind)
+  {
+    if (!Known(kind) && m_kinds < KINDS)
+      m_kind[m_kinds++] = kind;
+  }
+
+  unsigned int m_budget = 0;
+  unsigned int m_made = 0;
+  unsigned int m_missed = 0;
+  unsigned long m_refreshes = 0;
+  int m_level = -1;
+  bool m_gui = false;
+  bool m_levelDue = false;
+  bool m_afterGuiDue = false;
+  bool m_keptChecked = false;
+  bool m_sampleDue = false;
+  unsigned long m_sampled = 0; //!< the refresh of the last check
+  unsigned long m_sampleSince = 0; //!< the refresh since which a sampled check is due
+  unsigned long m_keptAt = 0; //!< the last refresh that kept a picture on the screen (0: none)
+  std::array<uint32_t, KINDS> m_kind{};
+  unsigned int m_kinds = 0;
+  struct Undo
+  {
+    bool levelDue = false, afterGuiDue = false, keptChecked = false, sampleDue = false;
+    unsigned long sampled = 0;
+    unsigned int kinds = 0;
+    bool valid = false;
+  } m_undo;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
