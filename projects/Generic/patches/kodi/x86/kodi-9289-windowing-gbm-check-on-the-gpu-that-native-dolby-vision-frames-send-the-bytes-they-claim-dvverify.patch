+bool CDVBridgeGLES::VerifyBegin()
+{
+  if (m_verifier)
+    return true;
+  if (!m_gl || !m_renderer)
+    return false;
+  TakeStaleGLErrors("the check of the bytes is set up");
+  m_verifier = dvbridge_verifier_create(m_gl->gpu, m_log, DVBRIDGE_VERTEX, DVBRIDGE_FRAGMENT);
+  return m_verifier != nullptr;
+}
+
+void CDVBridgeGLES::VerifyEnd()
+{
+  if (!m_verifier)
+    return;
+  dvbridge_verifier_destroy(m_verifier);
+  m_verifier = nullptr;
+}
+
+bool CDVBridgeGLES::VerifyDraw(const Layer& base,
+                               const AVFrame* enhancement,
+                               const CDVMetadataBuffer& metadata,
+                               dvbridge_geometry geometry,
+                               bool direct)
+{
+  if (!m_verifier || !m_renderer || !metadata.Data())
+    return false;
+  TakeStaleGLErrors("a frame is checked");
+  dvbridge_gl_frame bl{}, el{};
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
+    return false;
+  // The enhancement picture anew, with images of its own: not those that the cache keeps of its
+  // surface (dvbridge_dmabuf_import_cached()), whatever its metadata says of its residual
+  dvbridge_dmabuf imported{};
+  bool mapped = false;
+  bool layered = false;
+  double elPts = std::numeric_limits<double>::quiet_NaN();
+  if (enhancement)
+  {
+    mapped = dvbridge_dmabuf_import(&imported, enhancement);
+    layered = mapped && dvbridge_gl_frame_import(&el, m_gl->gpu, imported.layout, enhancement->width,
+                                                 enhancement->height, imported.planes,
+                                                 enhancement->chroma_location);
+    if (layered)
+    {
+      bl.frame.enhancement_layer = &el.frame;
+      elPts = static_cast<double>(enhancement->pts);
+    }
+  }
+  // (a layer that cannot be imported here leaves nothing to check the frame against)
+  const bool drawn = (!enhancement || layered) &&
+                     dvbridge_verify_draw(m_verifier, m_renderer, &bl.frame, metadata.Data(),
+                                          metadata.Size(), base.pts, elPts, geometry, direct,
+                                          m_shaderCache);
+  if (layered)
+    dvbridge_gl_frame_release(&el);
+  if (mapped)
+    dvbridge_dmabuf_release(&imported);
+  dvbridge_gl_frame_release(&bl);
+  return drawn;
+}
+
+bool CDVBridgeGLES::VerifyResidual() const
+{
+  return dvbridge_verify_residual(m_verifier);
+}
+
+bool CDVBridgeGLES::VerifyKeep()
+{
+  return m_verifier && dvbridge_verify_keep(m_verifier, 0);
+}
+
+bool CDVBridgeGLES::VerifyCompare(unsigned int tag)
+{
+  return m_verifier && dvbridge_verify_compare(m_verifier, tag);
+}
+
+int CDVBridgeGLES::VerifyTake(dvbridge_verify_result& result, unsigned int timeoutMs)
+{
+  return m_verifier ? dvbridge_verify_take(m_verifier, &result, timeoutMs) : -1;
+}
+
 void CDVBridgeGLES::Warm(const Layer& base,
                          const AVFrame* enhancement,
                          const CDVMetadataBuffer& metadata,
