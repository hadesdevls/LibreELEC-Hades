  * by libplacebo's reshaping either way (libplacebo logs why). */
 void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *renderer, bool use);
 
+/* Hades: a check of the bytes that a renderer sends (dvbridge_verify.h). The reference renderer is
+ * one of its own, made with dvbridge_renderer_create_reference(), never committed, and set up for
+ * every render it makes as a new renderer is: it keeps no frame, no hook turned off and nothing
+ * learnt of the bars written first, writes the area outside the active picture with the rest and
+ * its picture black first. dvbridge_render_reference() draws with it the picture that the other
+ * renderer (main) draws or would draw now, at its fidelity step-down level, with its composer and
+ * from its transport state (the candidate is prepared from main's context, which it does not
+ * change), into the framebuffer of a 3840x2160 RGBA8 texture, first row at the bottom as in a
+ * window. (What chooses another picture on purpose is taken from main; what is to give the same
+ * bytes as without it is off in the reference: a switch of either kind added to the renderer has
+ * to be one or the other here.) The ways:
+ *  - direct: the way that writes the transport directly (dvbridge_render_packed(), into target,
+ *    which is that texture), as main draws a frame without GUI elements when it can; the two ways
+ *    differ by a code here and there, so a check draws the way that main drew;
+ *  - else composed: the picture into the reference's own RGBA32F texture, packed by packer (one
+ *    with two fetches a pixel: dvbridge_gl_packer_create_plain()).
+ * Every pixel that the render does not write reads as no transport pixel does (0xff00ff).
+ * packets: the transport packets that the frame carries, for where its metadata bits are. */
+#define DVBRIDGE_RENDER_REFERENCE 1
+struct dvbridge_gl_packer;
+struct dvbridge_renderer *dvbridge_renderer_create_reference(pl_gpu gpu, pl_log log);
+bool dvbridge_render_reference(struct dvbridge_renderer *reference,
+                               const struct dvbridge_renderer *main, const struct pl_frame *source,
+                               const void *metadata, size_t bytes, double pts, double el_pts,
+                               struct dvbridge_geometry geometry, bool direct, pl_tex target,
+                               unsigned framebuffer, struct dvbridge_gl_packer *packer,
+                               unsigned *packets);
+
 /* Hades: the GPU programs of the ways a session can draw the frames of a stream, made ready before
  * the first one is presented, with that frame (dvbridge_render_warm()). Each program is made when a
  * frame first needs it: the first frame with GUI elements or subtitles over a picture drawn directly
diff --git a/tools/dvbridge/dvbridge_verify.c b/tools/dvbridge/dvbridge_verify.c
new file mode 100644
index 0000000..83a44ee
--- /dev/null
+++ b/tools/dvbridge/dvbridge_verify.c
@@ -0,0 +1,353 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Hades: a check of the bytes that native Dolby Vision output sends (see dvbridge_verify.h). */
+#include "dvbridge_verify.h"
+#include "dvbridge_gl_pack.h"
+#include <GLES3/gl31.h>
+#include <libplacebo/opengl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define W 3840
+#define H 2160
+#define BLOCK 16
+#define BW (W / BLOCK)
+#define BH (H / BLOCK)
+
+struct slot {
+    GLuint buffer;      /* the results of the blocks, read back into it */
+    GLsync fence;
+    unsigned tag, packets;
+};
+
+struct dvbridge_verifier {
+    pl_gpu gpu;
+    struct dvbridge_renderer *reference;
+    struct dvbridge_gl_packer *packer;
+    GLuint reference_texture, reference_framebuffer;
+    pl_tex reference_target;
+    GLuint kept_texture, kept_framebuffer;
+    GLuint result_texture, result_framebuffer;
+    GLuint program, vertex_array, sampler;
+    GLint sent_location, reference_location;
+    bool drawn, kept;
+    unsigned packets; /* of the last reference */
+    struct slot slots[DVBRIDGE_VERIFY_SLOTS];
+    unsigned first, waiting;
+};
+
+static const char COMPARE_VERTEX[] =
+    "#version 300 es\n"
+    "void main()\n"
+    "{\n"
+    "    vec2 position = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+    "    gl_Position = vec4(position * 2.0 - 1.0, 0.0, 1.0);\n"
+    "}\n";
+
+/* One value for each block of 16x16 pixels, the blocks in the order of the raster (the first row of
+ * the target is the top of the picture; the transports have their first row at the bottom, as a
+ * window): how many pixels differ in their three bytes, the first of them in the block (its index,
+ * row by row) and the largest difference of a 12-bit code, and the bytes of that pixel in both. The
+ * codes as the packing writes them: luma y = G << 4 | B & 15, chroma c = R << 4 | B >> 4. */
+static const char COMPARE_FRAGMENT[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D sent;\n"
+    "uniform highp sampler2D reference;\n"
+    "out uvec4 result;\n"
+    "uint packed_rgb(uvec3 c) { return c.r << 16 | c.g << 8 | c.b; }\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 block = ivec2(gl_FragCoord.xy);\n"
+    "    uint count = 0u, first = 0u, largest = 0u, s0 = 0u, r0 = 0u;\n"
+    "    for (int j = 0; j < 16; ++j) {\n"
+    "        int row = 2159 - (block.y * 16 + j);\n"
+    "        for (int i = 0; i < 16; ++i) {\n"
+    "            ivec2 p = ivec2(block.x * 16 + i, row);\n"
+    "            uvec3 s = uvec3(texelFetch(sent, p, 0).rgb * 255.0 + 0.5);\n"
+    "            uvec3 r = uvec3(texelFetch(reference, p, 0).rgb * 255.0 + 0.5);\n"
+    "            if (s != r) {\n"
+    "                int ys = int(s.g << 4 | s.b & 15u), yr = int(r.g << 4 | r.b & 15u);\n"
+    "                int cs = int(s.r << 4 | s.b >> 4), cr = int(r.r << 4 | r.b >> 4);\n"
+    "                largest = max(largest, uint(max(abs(ys - yr), abs(cs - cr))));\n"
+    "                if (count == 0u) {\n"
+    "                    first = uint(j * 16 + i);\n"
+    "                    s0 = packed_rgb(s);\n"
+    "                    r0 = packed_rgb(r);\n"
+    "                }\n"
+    "                ++count;\n"
+    "            }\n"
+    "        }\n"
+    "    }\n"
+    "    result = uvec4(count, first | largest << 16, s0, r0);\n"
+    "}\n";
+
+static GLuint shader(GLenum type, const char *source)
+{
+    GLuint s = glCreateShader(type);
+    glShaderSource(s, 1, &source, NULL);
+    glCompileShader(s);
+    GLint ok = 0;
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[2048];
+        glGetShaderInfoLog(s, sizeof(log), NULL, log);
+        fprintf(stderr, "DV verify shader: %s\n", log);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+static bool target(GLenum format, int width, int height, GLuint *texture, GLuint *framebuffer)
+{
+    glGenTextures(1, texture);
+    glBindTexture(GL_TEXTURE_2D, *texture);
+    glTexStorage2D(GL_TEXTURE_2D, 1, format, width, height);
+    glGenFramebuffers(1, framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, *framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, *texture, 0);
+    return *texture && *framebuffer &&
+           glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+}
+
+struct dvbridge_verifier *dvbridge_verifier_create(pl_gpu gpu, pl_log log, const char *pack_vertex,
+                                                   const char *pack_fragment)
+{
+    if (!gpu)
+        return NULL;
+    struct dvbridge_verifier *v = calloc(1, sizeof(*v));
+    if (!v)
+        return NULL;
+    v->gpu = gpu;
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    dvbridge_gl_state_save(&state);
+    GLint pack = 0;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    bool ok = target(GL_RGBA8, W, H, &v->reference_texture, &v->reference_framebuffer) &&
+              target(GL_RGBA8, W, H, &v->kept_texture, &v->kept_framebuffer) &&
+              target(GL_RGBA32UI, BW, BH, &v->result_texture, &v->result_framebuffer);
+    if (ok) {
+        const GLuint vs = shader(GL_VERTEX_SHADER, COMPARE_VERTEX);
+        const GLuint fs = shader(GL_FRAGMENT_SHADER, COMPARE_FRAGMENT);
+        if (vs && fs) {
+            v->program = glCreateProgram();
+            glAttachShader(v->program, vs);
+            glAttachShader(v->program, fs);
+            glLinkProgram(v->program);
+            GLint linked = 0;
+            glGetProgramiv(v->program, GL_LINK_STATUS, &linked);
+            v->sent_location = glGetUniformLocation(v->program, "sent");
+            v->reference_location = glGetUniformLocation(v->program, "reference");
+            ok = linked && v->sent_location >= 0 && v->reference_location >= 0;
+        } else {
+            ok = false;
+        }
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+    }
+    if (ok) {
+        glGenVertexArrays(1, &v->vertex_array);
+        glGenSamplers(1, &v->sampler);
+        glSamplerParameteri(v->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glSamplerParameteri(v->sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glSamplerParameteri(v->sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glSamplerParameteri(v->sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        for (int i = 0; i < DVBRIDGE_VERIFY_SLOTS; ++i) {
+            glGenBuffers(1, &v->slots[i].buffer);
+            glBindBuffer(GL_PIXEL_PACK_BUFFER, v->slots[i].buffer);
+            glBufferData(GL_PIXEL_PACK_BUFFER, (GLsizeiptr)BW * BH * 16, NULL, GL_STREAM_READ);
+            ok = ok && v->slots[i].buffer;
+        }
+        ok = ok && v->vertex_array && v->sampler;
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    ok = ok && glGetError() == GL_NO_ERROR;
+    dvbridge_gl_state_restore(&state);
+    if (ok) {
+        v->reference_target = pl_opengl_wrap(gpu, pl_opengl_wrap_params(
+            .texture = v->reference_texture, .target = GL_TEXTURE_2D, .iformat = GL_RGBA8,
+            .width = W, .height = H));
+        v->reference = dvbridge_renderer_create_reference(gpu, log);
+        v->packer = dvbridge_gl_packer_create_plain(pack_vertex, pack_fragment);
+        ok = v->reference_target && v->reference && v->packer;
+    }
+    if (!ok) {
+        dvbridge_verifier_destroy(v);
+        return NULL;
+    }
+    return v;
+}
+
+void dvbridge_verifier_destroy(struct dvbridge_verifier *v)
+{
+    if (!v)
+        return;
+    for (int i = 0; i < DVBRIDGE_VERIFY_SLOTS; ++i) {
+        if (v->slots[i].fence)
+            glDeleteSync(v->slots[i].fence);
+        glDeleteBuffers(1, &v->slots[i].buffer);
+    }
+    dvbridge_gl_packer_destroy(v->packer);
+    dvbridge_renderer_destroy(v->reference);
+    pl_tex_destroy(v->gpu, &v->reference_target);
+    glDeleteProgram(v->program);
+    glDeleteVertexArrays(1, &v->vertex_array);
+    glDeleteSamplers(1, &v->sampler);
+    const GLuint framebuffers[] = {v->reference_framebuffer, v->kept_framebuffer,
+                                   v->result_framebuffer};
+    const GLuint textures[] = {v->reference_texture, v->kept_texture, v->result_texture};
+    glDeleteFramebuffers(3, framebuffers);
+    glDeleteTextures(3, textures);
+    free(v);
+}
+
+bool dvbridge_verify_draw(struct dvbridge_verifier *v, const struct dvbridge_renderer *main,
+                          const struct pl_frame *source, const void *metadata, size_t bytes,
+                          double pts, double el_pts, struct dvbridge_geometry geometry, bool direct,
+                          pl_cache cache)
+{
+    if (!v)
+        return false;
+    pl_gpu_set_cache(v->gpu, NULL);
+    v->drawn = dvbridge_render_reference(v->reference, main, source, metadata, bytes, pts, el_pts,
+                                         geometry, direct, v->reference_target,
+                                         v->reference_framebuffer, v->packer, &v->packets);
+    pl_gpu_set_cache(v->gpu, cache);
+    return v->drawn;
+}
+
+bool dvbridge_verify_residual(const struct dvbridge_verifier *v)
+{
+    return v && v->drawn && dvbridge_render_residual_drawn(v->reference);
+}
+
+bool dvbridge_verify_keep(struct dvbridge_verifier *v, unsigned framebuffer)
+{
+    if (!v)
+        return false;
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    dvbridge_gl_state_save(&state);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, v->kept_framebuffer);
+    glBlitFramebuffer(0, 0, W, H, 0, 0, W, H, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    v->kept = glGetError() == GL_NO_ERROR;
+    dvbridge_gl_state_restore(&state);
+    return v->kept;
+}
+
+bool dvbridge_verify_compare(struct dvbridge_verifier *v, unsigned tag)
+{
+    if (!v || !v->drawn || !v->kept || v->waiting >= DVBRIDGE_VERIFY_SLOTS)
+        return false;
+    struct slot *s = &v->slots[(v->first + v->waiting) % DVBRIDGE_VERIFY_SLOTS];
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    dvbridge_gl_state_save(&state);
+    GLint pack = 0, alignment = 4;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    static const GLenum caps[] = {GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_SCISSOR_TEST,
+        GL_DITHER, GL_CULL_FACE, GL_RASTERIZER_DISCARD, GL_SAMPLE_ALPHA_TO_COVERAGE,
+        GL_SAMPLE_COVERAGE};
+    for (unsigned i = 0; i < sizeof(caps) / sizeof(*caps); ++i)
+        glDisable(caps[i]);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBindFramebuffer(GL_FRAMEBUFFER, v->result_framebuffer);
+    glViewport(0, 0, BW, BH);
+    glUseProgram(v->program);
+    glBindVertexArray(v->vertex_array);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, v->kept_texture);
+    glBindSampler(0, v->sampler);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, v->reference_texture);
+    glBindSampler(1, v->sampler);
+    glUniform1i(v->sent_location, 0);
+    glUniform1i(v->reference_location, 1);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, s->buffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, BW, BH, GL_RGBA_INTEGER, GL_UNSIGNED_INT, NULL);
+    s->fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    const bool ok = s->fence && glGetError() == GL_NO_ERROR;
+    dvbridge_gl_state_restore(&state);
+    if (!ok) {
+        if (s->fence)
+            glDeleteSync(s->fence);
+        s->fence = NULL;
+        return false;
+    }
+    s->tag = tag;
+    s->packets = v->packets;
+    ++v->waiting;
+    /* the reference is compared once */
+    v->drawn = false;
+    return true;
+}
+
+int dvbridge_verify_take(struct dvbridge_verifier *v, struct dvbridge_verify_result *result,
+                         unsigned timeout_ms)
+{
+    if (!v || !v->waiting)
+        return -1;
+    struct slot *s = &v->slots[v->first];
+    const GLenum waited = glClientWaitSync(s->fence, GL_SYNC_FLUSH_COMMANDS_BIT,
+                                           (GLuint64)timeout_ms * 1000000u);
+    if (waited == GL_TIMEOUT_EXPIRED)
+        return 0;
+    glDeleteSync(s->fence);
+    s->fence = NULL;
+    v->first = (v->first + 1) % DVBRIDGE_VERIFY_SLOTS;
+    --v->waiting;
+    if (waited != GL_ALREADY_SIGNALED && waited != GL_CONDITION_SATISFIED)
+        return -2;
+    GLint pack = 0;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, s->buffer);
+    const uint32_t *d = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, (GLsizeiptr)BW * BH * 16,
+                                         GL_MAP_READ_BIT);
+    struct dvbridge_verify_result r = {.tag = s->tag};
+    if (d) {
+        const unsigned long metadata = 3072ul * s->packets;
+        for (unsigned by = 0; by < BH; ++by)
+            for (unsigned bx = 0; bx < BW; ++bx) {
+                const uint32_t *b = d + ((size_t)by * BW + bx) * 4;
+                if (!b[0])
+                    continue;
+                r.differing += b[0];
+                ++r.blocks;
+                if (b[1] >> 16 > r.largest)
+                    r.largest = b[1] >> 16;
+                const unsigned index = b[1] & 0xffff;
+                const unsigned x = bx * BLOCK + index % BLOCK, y = by * BLOCK + index / BLOCK;
+                const bool bit = (unsigned long)y * W + x < metadata;
+                r.metadata += bit;
+                if (r.listed < sizeof(r.first) / sizeof(*r.first))
+                    r.first[r.listed++] = (struct dvbridge_verify_first){x, y, b[2], b[3], bit};
+            }
+        glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    if (!d)
+        return -2;
+    if (result)
+        *result = r;
+    return 1;
+}
+
+unsigned dvbridge_verify_waiting(const struct dvbridge_verifier *v)
+{
+    return v ? v->waiting : 0;
+}
diff --git a/tools/dvbridge/dvbridge_verify.h b/tools/dvbridge/dvbridge_verify.h
