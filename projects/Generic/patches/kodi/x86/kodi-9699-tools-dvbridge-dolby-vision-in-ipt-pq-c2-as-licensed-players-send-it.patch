 /* Hades: the candidate made again with the level 5 block taken out to what is drawn over the bars:
diff --git a/tools/dvbridge/dvbridge_ipt.h b/tools/dvbridge/dvbridge_ipt.h
new file mode 100644
index 0000000..9121212
--- /dev/null
+++ b/tools/dvbridge/dvbridge_ipt.h
@@ -0,0 +1,25 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+/* Hades: the matrices of the IPT-PQ-c2 tunnel. Licensed players are reported to send Dolby Vision in
+ * IPT-PQ-c2 whatever the profile (the TV-led output mode of Amlogic's licensed driver is "IPT
+ * tunnel" for every source; captures of licensed Amlogic and MediaTek players carry IPT matrices in
+ * their metadata). ETSI GS CCM 001 V1.1.1 allows it (6.2.2, table 6: signal_color_space 2) and gives
+ * no matrices for it; these are the ones that the RPUs of profile 5 carry (as dovi_tool writes
+ * them), in the units of the DM header: YCCtoRGB (IPT -> L'M'S', 13 fractional bits), its offsets
+ * (28) and RGBtoLMS (the crosstalk of L, M and S, 14). The packer converts with their exact inverses
+ * (dvbridge_source_to_ipt()), so a display decodes what was encoded. */
+#ifndef DVBRIDGE_IPT_H
+#define DVBRIDGE_IPT_H
+
+#define DVBRIDGE_IPT_YCC {8192, 799, 1681, 8192, -933, 1091, 8192, 267, -5545}
+#define DVBRIDGE_IPT_OFFSETS {0u, 134217728u, 134217728u}
+#define DVBRIDGE_IPT_LMS {17081, -349, -349, -349, 17081, -349, -349, -349, 17081}
+/* the RGBtoLMS of BT.2020 (that of the RPUs of profiles 7 and 8) */
+#define DVBRIDGE_LMS_2020 {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962}
+
+#endif
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 35ea14c..0400f6b 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -3,6 +3,7 @@
  */
 #ifndef MPV_DVBRIDGE_DV_H
 #define MPV_DVBRIDGE_DV_H
+#include "dvbridge_ipt.h"
 #include <stdint.h>
 #include <stdbool.h>
 #include <string.h>
@@ -422,8 +423,10 @@ static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken,
  * target lift). What is left is what an RPU without trims carries: the content range of level 1
  * and the rest, which the display maps from itself. dovi_tool's "safe" CM v4.0 default is such a
  * set as well (levels 3, 9, 11 and 254, without 8 and 10). */
+/* Hades: source: 0 the picture converted to BT.2020, 1 the composer's picture as it is, 2 the
+ * composer's YCbCr picture in IPT-PQ-c2 (dvbridge_source_to_ipt(), dvbridge_ipt.h) */
 static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetadata *m, double pts,
-                                        bool source, unsigned cover)
+                                        int source, unsigned cover)
 {
     d->refused = NULL;
     DV_REFUSE(m && isfinite(pts), "no metadata, or no time of presentation");
@@ -492,6 +495,25 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         }
         depth = hd->vdr_bit_depth;
         space = c->signal_color_space;
+        if (source == 2) {
+            /* Hades: the IPT tunnel: a picture in YCbCr whose RGBtoLMS is that of BT.2020, sent in
+             * IPT-PQ-c2 with the matrices of the RPUs of profile 5 and signal_color_space 2 */
+            static const int ycc_ipt[9] = DVBRIDGE_IPT_YCC, lms_ipt[9] = DVBRIDGE_IPT_LMS,
+                             lms_2020[9] = DVBRIDGE_LMS_2020;
+            static const unsigned off_ipt[3] = DVBRIDGE_IPT_OFFSETS;
+            bool ycc2020 = space == 0;
+            for (int i = 0; i < 9; i++)
+                ycc2020 = ycc2020 && lms[i] == lms_2020[i];
+            DV_REFUSE(ycc2020, "the IPT tunnel for a picture that is not YCbCr with the RGBtoLMS of "
+                               "BT.2020");
+            for (int i = 0; i < 9; i++) {
+                matrix[i] = ycc_ipt[i];
+                lms[i] = lms_ipt[i];
+            }
+            for (int i = 0; i < 3; i++)
+                offsets[i] = off_ipt[i];
+            space = 2;
+        }
     }
     for (int i = 0; i < 9; i++) dvbridge_dv_u16(d, (uint16_t)matrix[i]);
     for (int i = 0; i < 3; i++) dvbridge_dv_u32(d, offsets[i]);
