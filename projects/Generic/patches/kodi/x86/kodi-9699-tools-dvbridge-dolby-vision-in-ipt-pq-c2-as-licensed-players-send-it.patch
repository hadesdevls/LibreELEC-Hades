+/* Hades: the IPT tunnel (dvbridge_source.h, dvbridge_ipt.h) */
+bool dvbridge_source_ipt_setup(struct dvbridge_source_params *ipt,
+                               const struct dvbridge_source_params *src)
+{
+    if (!ipt || !src || !src->affine || src->bits != 12)
+        return false;
+    static const int ycc[9] = DVBRIDGE_IPT_YCC, lms[9] = DVBRIDGE_IPT_LMS,
+                     lms2020[9] = DVBRIDGE_LMS_2020;
+    static const unsigned offsets[3] = DVBRIDGE_IPT_OFFSETS;
+    double yccm[9], yccinv[9], l[9], linv[9], l2020[9], l2020inv[9], forward[9], inverse[9];
+    for (int i = 0; i < 9; ++i) {
+        yccm[i] = ycc[i] / 8192.0;
+        l[i] = lms[i] / 16384.0;
+        l2020[i] = lms2020[i] / 16384.0;
+    }
+    if (!invert3(yccm, yccinv) || !invert3(l, linv) || !invert3(l2020, l2020inv))
+        return false;
+    /* as dvbridge_source_setup() makes them for an RPU of profile 5 */
+    *ipt = *src;
+    multiply3(l2020inv, l, forward);
+    multiply3(linv, l2020, inverse);
+    for (int i = 0; i < 9; ++i) {
+        ipt->ycc_forward[i] = (float)yccm[i];
+        ipt->ycc_inverse[i] = (float)yccinv[i];
+        ipt->lms_forward[i] = (float)forward[i];
+        ipt->lms_inverse[i] = (float)inverse[i];
+    }
+    for (int i = 0; i < 3; ++i) {
+        ipt->offset[i] = (float)(offsets[i] / (double)(1 << 28));
+        ipt->black[i] = (int)((((int64_t)offsets[i] << 12) + (1 << 27)) >> 28);
+    }
+    ipt->affine = 0;
+    return true;
+}
+
+bool dvbridge_source_can_ipt(const struct dvbridge_source_packer *p)
+{
+    return p && p->ipt_luma_program && p->ipt_rows_program;
+}
+
+bool dvbridge_source_to_ipt(struct dvbridge_source_packer *p,
+                            const struct dvbridge_source_params *src, unsigned luma, int width,
+                            int height, int x, int y, const unsigned margins[4],
+                            unsigned *ipt_luma)
+{
+    if (ipt_luma)
+        *ipt_luma = 0;
+    if (!picture_fits(p, src, width, height, x, y, margins) || !luma || !ipt_luma ||
+        !src->affine || !dvbridge_source_can_ipt(p) || !rows_of(p, width, height, x, y, margins) ||
+        p->rows_ipt)
+        return false;
+    /* the active picture in the picture, and its pairs (those whose even pixel is in it, as pass 2) */
+    const int x0 = (int)margins[0], x1 = 3840 - (int)margins[1];
+    const int y0 = (int)margins[2], y1 = 2160 - (int)margins[3];
+    const int a = (x0 > x ? x0 : x) - x, b = (x1 < x + width ? x1 : x + width) - x;
+    const int c = (y0 > y ? y0 : y) - y, d = (y1 < y + height ? y1 : y + height) - y;
+    const int first_pair = (a + 1) / 2, last_pair = (b + 1) / 2 - 1;
+    if (a >= b || c >= d || first_pair > last_pair)
+        return false;
+    int weights[DVBRIDGE_SOURCE_TAPS], first = 0, taps = 0;
+    dvbridge_source_filter(0.5, weights, &first, &taps);
+    if (taps != 12 || first != -5)
+        return false;
+    /* YCCtoRGB of the RPU; the linear BT.2020 RGB to the LMS of profile 5 without its crosstalk; and
+     * the inverse of YCCtoRGB of profile 5 (row-major here, set_matrix() transposes) */
+    static const int ycc[9] = DVBRIDGE_IPT_YCC, lms[9] = DVBRIDGE_IPT_LMS,
+                     lms2020[9] = DVBRIDGE_LMS_2020;
+    double yccm[9], yccinv[9], l[9], linv[9], l2020[9], to_lms[9];
+    for (int i = 0; i < 9; ++i) {
+        yccm[i] = ycc[i] / 8192.0;
+        l[i] = lms[i] / 16384.0;
+        l2020[i] = lms2020[i] / 16384.0;
+    }
+    if (!invert3(yccm, yccinv) || !invert3(l, linv))
+        return false;
+    multiply3(linv, l2020, to_lms);
+    float to_lmsf[9], to_iptf[9];
+    for (int i = 0; i < 9; ++i) {
+        to_lmsf[i] = (float)to_lms[i];
+        to_iptf[i] = (float)yccinv[i];
+    }
+    struct dvbridge_gl_state state;
+    begin(p, &state);
+    const int cw = (width + 1) / 2, half = (height + 1) / 2;
+    for (int k = 0; k < 2; ++k) {
+        const struct ipt_uniforms *u = k ? &p->ir : &p->il;
+        struct texture *into = k ? &p->ipt_rows : &p->ipt_luma;
+        if (!target(into, k ? GL_RGBA16UI : GL_R32F, k ? cw : width, k ? half : height))
+            return end(&state, false);
+        glUseProgram(k ? p->ipt_rows_program : p->ipt_luma_program);
+        bind(p, 0, luma);
+        bind(p, 1, p->chroma.texture);
+        glUniform1i(u->luma, 0);
+        glUniform1i(u->rows, 1);
+        glUniform1f(u->code_scale, (float)(1 << src->bits));
+        set_matrix(u->ycc_src, src->ycc_forward);
+        set_matrix(u->to_lms, to_lmsf);
+        set_matrix(u->to_ipt, to_iptf);
+        glUniform3fv(u->off_src, 1, src->offset);
+        glUniform4i(u->active, a, c, b, d);
+        glUniform2i(u->pairs, first_pair, last_pair);
+        glUniform1iv(u->hweights, DVBRIDGE_SOURCE_TAPS, weights);
+        if (k)
+            glUniform1i(p->ir_rows, height);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    const bool ok = end(&state, true);
+    if (ok) {
+        p->rows_ipt = true;
+        *ipt_luma = p->ipt_luma.texture;
+    }
+    return ok;
+}
