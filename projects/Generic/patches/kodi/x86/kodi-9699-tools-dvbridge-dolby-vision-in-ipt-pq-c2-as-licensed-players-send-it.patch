+}
+
 /* Hades: the transport of the composed planes (and of the picture drawn over, layer) into a framebuffer */
 static bool source_pack(struct dvbridge_renderer *r, unsigned layer, unsigned framebuffer, bool flip)
 {
@@ -929,7 +940,7 @@ static bool source_pack(struct dvbridge_renderer *r, unsigned layer, unsigned fr
     const unsigned luma = r->pack_luma;
     if (luma)
         timer_begin(r, TIMER_PACK_SOURCE);
-    const bool packed = luma && dvbridge_source_pack(r->source_packer, &r->source_params, luma,
+    const bool packed = luma && dvbridge_source_pack(r->source_packer, transport_params(r), luma,
                                                      r->pack_w, r->pack_h, r->geometry.x,
                                                      r->geometry.y, layer, margins, framebuffer,
                                                      packets, count, flip);
@@ -957,12 +968,18 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
 {
     *composed = false;
     const char *why = NULL;
+    /* Hades: in IPT-PQ-c2 where it is asked for, the picture is YCbCr with the RGBtoLMS of BT.2020
+     * (profiles 7 and 8), the passes were made, and the fidelity step-down is below level 3, which
+     * sends the composer's YCbCr (dvbridge_render_step_levels()) */
+    r->ipt = r->ipt_wanted && r->step < 3 && dvbridge_source_can_ipt(r->source_packer) &&
+             dvbridge_source_ipt_setup(&r->ipt_params, &r->source_params);
     r->pending = dvbridge_prepare_why(r->serializer ? r->serializer : r->context, metadata,
                                       bytes, pts, geometry,
-                                      r->residual_drawn || r->residual_omitted, true, &why);
+                                      r->residual_drawn || r->residual_omitted, r->ipt ? 2 : 1,
+                                      &why);
     if (!r->pending) {
         /* Hades: the frame then goes out converted, where its metadata take that (the log says why
-         * it does not go out as certified source devices send it) */
+         * it does not go out in the source transport) */
         r->source_why = why;
         return false;
     }
@@ -1026,6 +1043,15 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
              dvbridge_source_rows(r->source_packer, &r->source_params, chroma,
                                   geometry.source_width, geometry.source_height, geometry.x,
                                   geometry.y, margins, r->all_rows);
+    /* Hades: the codes of the IPT tunnel (pass 9 of dvbridge_source.c), timed with the rows */
+    if (ok && r->ipt) {
