+                                    r->pack_h, geometry.x, geometry.y, margins, &ipt_luma);
+        luma = ipt_luma;
+        if (!ok)
+            r->source_why = "the codes of the IPT tunnel could not be made";
+    }
     timer_end(r, TIMER_ROWS);
     if (ok)
         r->pack_luma = luma;
@@ -1049,7 +1075,7 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         dvbridge_source_drawn_key(r->source_packer, r->drawn_gui ? r->drawn_key : 0);
         if (fbo)
             timer_begin(r, TIMER_PICTURE);
-        ok = fbo && dvbridge_source_picture(r->source_packer, &r->source_params, r->pack_luma,
+        ok = fbo && dvbridge_source_picture(r->source_packer, transport_params(r), r->pack_luma,
                                             r->pack_w, r->pack_h, geometry.x, geometry.y,
                                             margins, fbo);
         timer_end(r, TIMER_PICTURE);
@@ -1106,7 +1132,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
     r->residual_drawn = paired && mapped.dovi.nlq_active;
-    /* Hades: the transport of this picture: as certified source devices send it, where that
+    /* Hades: the transport of this picture: the source transport (the composer's picture), where that
      * covers the picture (render_source()); else converted to BT.2020, below (always so for
      * Low-Latency: the picture is the one mapped to the display) */
     r->geometry = geometry;
@@ -1978,11 +2004,17 @@ unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *r, bool
      * (whatever level it is drawn at, so that its ladder stays one) */
     if (r && r->scaled_source)
         return residual ? 0xfu : 0xbu;
+    /* Hades: the IPT tunnel, whose level 3 sends the composer's YCbCr instead (no conversion of
+     * its pixels): the last of the levels, the largest change where a display interpolates the
+     * chroma between the pairs (measured: up to 9 to 120 codes of I on pictures of a profile 7
+     * stream with linear interpolation, against at most 15 at level 2) */
+    const bool ipt = r && r->source && r->ipt_wanted && dvbridge_source_can_ipt(r->source_packer) &&
+                     r->source_params.affine;
     if (residual)
-        return r && r->source ? 0x7u : 0xfu;
+        return r && r->source ? (ipt ? 0xfu : 0x7u) : 0xfu;
     /* Hades: the source transport scales up no composed plane (its last picture went out so) */
     if (r && r->source)
-        return 0x1u;
+        return ipt ? 0x9u : 0x1u;
     return r && !r->legacy_composer ? 0x9u : 0x3u;
 }
 
@@ -2078,11 +2110,12 @@ bool dvbridge_render_reference(struct dvbridge_renderer *ref, const struct dvbri
     ref->mmr_table = false;
     /* (Hades: the transfer of the base layer: as main's pictures have it) */
     ref->base_transfer = main->base_transfer;
-    /* the transport: as certified source devices send it, or converted (it changes the bytes on
+    /* the transport: the source transport, or converted (it changes the bytes on
