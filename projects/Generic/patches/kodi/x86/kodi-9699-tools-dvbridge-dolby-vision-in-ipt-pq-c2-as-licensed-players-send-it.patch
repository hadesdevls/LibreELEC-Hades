diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index a18fe11..1784dae 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -5,8 +5,10 @@
  *  SPDX-License-Identifier: GPL-3.0-or-later
  *  See LICENSES/README.md for more information.
  */
-/* Hades: the Dolby Vision signal as a certified source device sends it (see dvbridge_source.h). */
+/* Hades: the Dolby Vision signal of the composer's picture, as composed or in IPT-PQ-c2 (see
+ * dvbridge_source.h). */
 #include "dvbridge_source.h"
+#include "dvbridge_ipt.h"
 #include "dvbridge_gl_pack.h"
 #include <GLES3/gl3.h>
 #include <libavutil/dovi_meta.h>
@@ -1285,6 +1287,97 @@ struct texture {
 struct common_uniforms {
     GLint luma, rows, picture, active, black, code_scale, ycc_forward, lms_forward, offset, affine;
 };
+/* 9. Hades: the IPT tunnel (dvbridge_source_to_ipt()): the codes of a pixel of the composer's YCbCr
+ * picture in IPT-PQ-c2, in floats; the luma of the picture (9a, a float a pixel) and its rows of
+ * 4:2:2 (9b, as pass 2 lays them out). The chroma between the pairs is Lanczos 6 in integers, the
+ * filter of pass 2. Outside the active picture nothing is read: the transport is black there. */
+#define IPT_HEAD                                                                                  \
+    "#version 300 es\n"                                                                           \
+    "precision highp float;\n"                                                                    \
+    "precision highp int;\n"                                                                      \
+    "uniform highp sampler2D luma_plane;\n"                                                       \
+    "uniform highp usampler2D chroma_rows;\n" /* pass 2: the YCbCr rows of 4:2:2 */               \
+    "uniform float code_scale;\n"                                                                 \
+    "uniform mat3 ycc_src, to_lms, to_ipt;\n"                                                     \
+    "uniform vec3 off_src;\n"                                                                     \
+    "uniform ivec4 active_box;\n" /* x0, y0, x1, y1 of the active picture, in the picture */          \
+    "uniform ivec2 pairs;\n"  /* the first and the last pair of the active picture */             \
+    "uniform int hweights[12];\n"                                                                 \
+    "const float m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;\n"                          \
+    "const float c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0, c3 = 2392.0 / 4096.0 * 32.0;\n" \
+    "vec3 eotf(vec3 e)\n"                                                                         \
+    "{\n"                                                                                         \
+    "    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / m2));\n"                                     \
+    "    return pow(max(p - vec3(c1), 0.0) / (vec3(c2) - vec3(c3) * p), vec3(1.0 / m1));\n"       \
+    "}\n"                                                                                         \
+    "vec3 oetf(vec3 l)\n"                                                                         \
+    "{\n"                                                                                         \
