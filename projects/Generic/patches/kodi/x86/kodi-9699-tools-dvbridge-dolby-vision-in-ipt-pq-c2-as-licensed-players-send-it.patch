     ref->source_wanted = main->source_wanted;
+    ref->ipt_wanted = main->ipt_wanted;
     ref->all_rows = true;
     ref->serializer = main->context;
     /* Hades: Low-Latency and its pattern change the picture on purpose: as main has them */
@@ -2337,6 +2370,17 @@ void dvbridge_render_use_source_transport(struct dvbridge_renderer *r, bool use)
         r->source_wanted = use;
 }
 
+void dvbridge_render_use_ipt(struct dvbridge_renderer *r, bool use)
+{
+    if (r)
+        r->ipt_wanted = use;
+}
+
+bool dvbridge_render_ipt(const struct dvbridge_renderer *r)
+{
+    return r && r->ready && r->source && r->ipt;
+}
