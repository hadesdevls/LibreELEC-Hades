+  //! a steady clock)
   std::vector<std::unique_ptr<drmModeConnector, DrmModeConnectorDeleter>> m_before;
+  std::vector<int64_t> m_beforeSince;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 4dd4887..e939047 100644
