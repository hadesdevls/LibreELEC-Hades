diff --git a/xbmc/utils/RetiredKept.h b/xbmc/utils/RetiredKept.h
new file mode 100644
index 0000000..085183c
--- /dev/null
+++ b/xbmc/utils/RetiredKept.h
@@ -0,0 +1,81 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+/*!
+ * \brief Hades: how long what a replacement retires is kept, where other code may still point into
+ *        it: the resolutions of the display that CDisplaySettings::ReplaceCustomResolutions()
+ *        replaced, and what CDRMConnector read of the connector in use before it read it again
+ *        (Adopt())
+ *
+ * Both were kept until Kodi ended: a few KB each time the display came with other modes
+ * (CWinSystemGbm::RefreshModes()), with no bound. What points into them: a reference that
+ * CDisplaySettings::GetResolutionInfo() gave, read for the time of a call (a JSON-RPC request, a
+ * setting's options), by any thread; a mode of the connector, looked up and read in one function;
+ * and the selected mode of CDRMUtils, which stays one of the modes of the read it was selected in
+ * until another mode is selected (CDRMUtils::TakeConnectorModes()). Nothing else stores a pointer
+ * into them.
+ *
+ * A retired one goes only when it is older than the KEPT newest ones, and was retired KEPT_MS ago or
+ * more, and the caller does not say that something stored points into it (the selected mode). The
+ * modes are made again only after a hot-plug event and SETTLE_MS without one, while nothing plays
+ * and no dialog is open (ModeListRefresh.h): a reference that is still read after sixteen of those
+ * and a minute is not one of a call.
+ *
+ * Only what is decided is here, with nothing of Kodi in it, so that it can be tested by itself.
+ */
+namespace RETIRED_KEPT
+{
+
+//! The newest ones that are always kept
+inline constexpr std::size_t KEPT = 16;
+//! ... and how long any of them is kept after it was retired
+inline constexpr int64_t KEPT_MS = 60000;
+
+/*!
+ * \brief The places of the retired ones that go now, oldest first
+ * \param since when each was retired (ms of a steady clock), the oldest first
+ * \param nowMs now, on that clock
+ * \param held held(i): something stored points into the one at place i
+ */
+template<typename Held>
+std::vector<std::size_t> ThatGo(const std::vector<int64_t>& since, int64_t nowMs, Held&& held)
+{
+  std::vector<std::size_t> go;
+  if (since.size() <= KEPT)
+    return go;
+  for (std::size_t i = 0; i < since.size() - KEPT; ++i)
+  {
+    if (nowMs - since[i] >= KEPT_MS && !held(i))
+      go.push_back(i);
+  }
+  return go;
+}
+
+/*!
+ * \brief The retired ones at the places that ThatGo() gave let go, and their times with them
+ *
+ * The others are moved within retired, which moves the objects that own them (a list, a pointer), and
+ * not what they own: what points into them still does.
+ */
+template<typename T>
+void LetGo(std::vector<T>& retired, std::vector<int64_t>& since, const std::vector<std::size_t>& go)
+{
+  for (auto it = go.rbegin(); it != go.rend(); ++it)
+  {
+    retired.erase(retired.begin() + static_cast<std::ptrdiff_t>(*it));
+    since.erase(since.begin() + static_cast<std::ptrdiff_t>(*it));
+  }
+}
+
+} // namespace RETIRED_KEPT
diff --git a/xbmc/windowing/gbm/drm/DRMConnector.cpp b/xbmc/windowing/gbm/drm/DRMConnector.cpp
index 5900a44..d4027d3 100644
--- a/xbmc/windowing/gbm/drm/DRMConnector.cpp
+++ b/xbmc/windowing/gbm/drm/DRMConnector.cpp
@@ -8,10 +8,13 @@
 
 #include "DRMConnector.h"
 
+#include "utils/RetiredKept.h"
 #include "utils/XTimeUtils.h"
 #include "utils/log.h"
 
 #include <algorithm>
+#include <chrono>
+#include <functional>
 #include <map>
 
 using namespace KODI::WINDOWING::GBM;
@@ -48,6 +51,14 @@ std::map<drmModeConnection, std::string> connectorStatusNames = {
     {DRM_MODE_UNKNOWNCONNECTION, "unknown"},
 };
 
+// Hades: ms of a steady clock (RetiredKept.h)
+int64_t NowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
 } // namespace
 
 CDRMConnector::CDRMConnector(int fd, uint32_t connector)
@@ -100,9 +111,25 @@ void CDRMConnector::Adopt(drmModeConnector* connector)
   // (the one read before is kept: m_connector is never empty for another thread that reads it)
   m_connector.swap(now);
   m_before.emplace_back(std::move(now));
+  m_beforeSince.push_back(NowMs());
   RefreshPropertyValues();
 }
 
+void CDRMConnector::ForgetBefore(std::initializer_list<const drmModeModeInfo*> inUse)
+{
+  const auto held = [&](std::size_t i)
+  {
+    const drmModeConnector* read = m_before[i].get();
+    const drmModeModeInfo* first = read->modes;
+    const drmModeModeInfo* end = first ? first + read->count_modes : first;
+    return std::ranges::any_of(inUse, [&](const drmModeModeInfo* mode)
+                               { return mode && std::less_equal<>()(first, mode) &&
+                                        std::less<>()(mode, end); });
+  };
+  RETIRED_KEPT::LetGo(m_before, m_beforeSince,
+                      RETIRED_KEPT::ThatGo(m_beforeSince, NowMs(), held));
+}
+
 std::string CDRMConnector::GetType()
 {
   auto typeName = connectorTypeNames.find(m_connector->connector_type);
