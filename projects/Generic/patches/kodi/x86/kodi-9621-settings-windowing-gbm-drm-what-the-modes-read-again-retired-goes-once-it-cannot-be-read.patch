@@ -321,12 +321,20 @@ CDRMUtils::~CDRMUtils()
 
 bool CDRMUtils::SetMode(const RESOLUTION_INFO& res)
 {
+  // Hades: CheckConnector() may read the connector again; of what was read before, what can no
+  // longer be read goes, but the read that the selected mode is a mode of, before and after this
+  // (CDRMConnector::ForgetBefore())
+  const drmModeModeInfo* was = m_mode;
   if (!m_connector->CheckConnector())
+  {
+    m_connector->ForgetBefore({was});
     return false;
+  }
 
   m_mode = m_connector->GetModeForIndex(std::atoi(res.strId.c_str()));
   m_width = res.iWidth;
   m_height = res.iHeight;
+  m_connector->ForgetBefore({was, m_mode});
 
   CLog::LogF(LOGDEBUG, "Found crtc mode: {}x{}{} @ {} Hz", m_mode->hdisplay, m_mode->vdisplay,
              m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "", m_mode->vrefresh);
@@ -366,9 +374,13 @@ void CDRMUtils::TakeConnectorModes(drmModeConnector* probed, int screenPlace)
     return;
   }
 
+  const drmModeModeInfo* was = m_mode;
   m_connector->Adopt(probed);
   if (screenPlace >= 0 && screenPlace < m_connector->GetModesCount())
     m_mode = m_connector->GetModeForIndex(screenPlace);
+  // Hades: ... and of what was read before, what can no longer be read goes, but the read that the
+  // selected mode is a mode of (CDRMConnector::ForgetBefore())
+  m_connector->ForgetBefore({was, m_mode});
 }
 
