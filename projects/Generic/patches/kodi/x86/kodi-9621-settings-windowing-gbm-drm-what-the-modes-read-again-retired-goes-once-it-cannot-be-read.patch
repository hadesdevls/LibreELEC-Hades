 private:
   struct DrmModeConnectorDeleter
@@ -69,8 +76,10 @@ private:
   };
 
   std::unique_ptr<drmModeConnector, DrmModeConnectorDeleter> m_connector;
-  //! Hades: what was read of it before Refresh() (see there)
