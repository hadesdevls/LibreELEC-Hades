From 4be63ac0a8be17356addee5931b82148dc0f4140 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:02:49 +0000
Subject: [PATCH] PeripheralCecAdapter: make the flag that the adapter is ready
 an atomic

m_bIsReady is written by the update thread once the keys may be accepted
(SetInitialConfiguration()), without m_critSection, and read without it
by libCEC's callback thread (CecCommand()) and by Announce(). Commands
from the bus that arrive while the adapter settles made that a data race.
It is now a std::atomic<bool>; what it gates does not change.

Tests (outside the tree): the real PeripheralCecAdapter.cpp built on the
host with ThreadSanitizer, with commands delivered as libCEC's callback
thread delivers them while the adapter settles (a data race on
m_bIsReady before, none after).
---
 xbmc/peripherals/devices/PeripheralCecAdapter.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/xbmc/peripherals/devices/PeripheralCecAdapter.h b/xbmc/peripherals/devices/PeripheralCecAdapter.h
index 3d66604..dab89ae 100644
--- a/xbmc/peripherals/devices/PeripheralCecAdapter.h
+++ b/xbmc/peripherals/devices/PeripheralCecAdapter.h
@@ -48,6 +48,7 @@ public:
 #include "threads/CriticalSection.h"
 #include "threads/Thread.h"
 
+#include <atomic>
 #include <chrono>
 #include <queue>
 #include <vector>
@@ -197,7 +198,9 @@ private:
   CEC::ICECAdapter* m_cecAdapter{nullptr};
   bool m_bStarted;
   bool m_bHasButton;
-  bool m_bIsReady;
+  /* set by the update thread once the keys may be accepted, without m_critSection, and read
+     without it by libCEC's callback thread and by the announcements */
+  std::atomic<bool> m_bIsReady;
   /* device that receives volume and mute commands, or CECDEVICE_UNKNOWN when Kodi's own mixer
      handles them */
   CEC::cec_logical_address m_volumeTarget;
