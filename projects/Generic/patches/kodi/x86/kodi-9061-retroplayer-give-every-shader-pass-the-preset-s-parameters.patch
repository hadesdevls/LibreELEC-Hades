From e0230933ede016b4a639a55a544c1948c6662d5f Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sat, 3 Oct 2026 18:26:16 +0100
Subject: [PATCH] [RetroPlayer] Give every shader pass the preset's parameters

A preset's parameters are shared by all of its passes, but each pass
only got the ones its own source declares with "#pragma parameter".
Presets that declare them once, like crt-royale in its last pass, left
every other pass with zeros and rendered black.

Give every pass all of the preset's parameters. A pass without a
uniform for one ignores it.
---
 xbmc/addons/ShaderPreset.cpp                  |  3 --
 .../RetroPlayer/shaders/ShaderPreset.cpp      | 42 +++++--------------
 xbmc/cores/RetroPlayer/shaders/ShaderPreset.h |  3 +-
 .../RetroPlayer/shaders/gl/ShaderPresetGL.cpp |  3 +-
 .../shaders/gles/ShaderPresetGLES.cpp         |  3 +-
 .../shaders/windows/ShaderPresetDX.cpp        |  3 +-
 6 files changed, 14 insertions(+), 43 deletions(-)

diff --git a/xbmc/addons/ShaderPreset.cpp b/xbmc/addons/ShaderPreset.cpp
index 7534dd0..567613d 100644
--- a/xbmc/addons/ShaderPreset.cpp
+++ b/xbmc/addons/ShaderPreset.cpp
@@ -136,9 +136,6 @@ bool CShaderPresetAddon::LoadPreset(const std::string& presetPath,
   return bSuccess;
 }
 
-//! @todo Instead of copying every parameter to every pass and resolving them
-//! later in GetShaderParameters, we should resolve which param goes to which
-//! shader in the add-on
 void CShaderPresetAddon::TranslateShaderPreset(const video_shader& shader,
                                                SHADER::IShaderPreset& shaderPreset)
 {
diff --git a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
index 4f57ba5..4d6a2e6 100644
--- a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.cpp
@@ -17,8 +17,6 @@
 #include "utils/URIUtils.h"
 #include "utils/log.h"
 
-#include <regex>
-
 using namespace KODI::SHADER;
 
 CShaderPreset::CShaderPreset(RETRO::CRenderContext& context,
@@ -256,39 +254,19 @@ bool CShaderPreset::HasPathFailed(const std::string& path) const
 }
 
 ShaderParameterMap CShaderPreset::GetShaderParameters(
-    const std::vector<ShaderParameter>& parameters, const std::string& sourceStr) const
+    const std::vector<ShaderParameter>& parameters) const
 {
-  static const std::regex pragmaParamRegex("#pragma parameter ([a-zA-Z_][a-zA-Z0-9_]*)");
-
-  std::vector<std::string> validParams;
-  std::smatch matches;
-
-  auto searchStart(sourceStr.cbegin());
-  while (regex_search(searchStart, sourceStr.cend(), matches, pragmaParamRegex))
-  {
-    validParams.push_back(matches[1].str());
-    searchStart += matches.position() + matches.length();
-  }
-
-  ShaderParameterMap matchParams;
+  // Parameters belong to the whole preset, not just the pass that declares
+  // them with "#pragma parameter"
+  ShaderParameterMap shaderParams;
 
-  // For each param found in the source code
-  for (const std::string& match : validParams)
+  for (const ShaderParameter& parameter : parameters)
   {
-    // For each param found in the preset file
-    for (const ShaderParameter& parameter : parameters)
-    {
-      // Check if they match
-      if (match == parameter.strId)
-      {
-        // The add-on has already handled parsing and overwriting default
-        // parameter values from the preset file. The final value we
-        // should use is in the 'current' field.
-        matchParams[match] = parameter.current;
-        break;
-      }
-    }
+    // The add-on has already handled parsing and overwriting default
+    // parameter values from the preset file. The final value we
+    // should use is in the 'current' field.
+    shaderParams[parameter.strId] = parameter.current;
   }
 
-  return matchParams;
+  return shaderParams;
 }
diff --git a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.h b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.h
index aeca22f..296c7df 100644
--- a/xbmc/cores/RetroPlayer/shaders/ShaderPreset.h
+++ b/xbmc/cores/RetroPlayer/shaders/ShaderPreset.h
@@ -69,8 +69,7 @@ protected:
   void DisposeShaders();
   void DisposeShaderTextures();
   bool HasPathFailed(const std::string& path) const;
-  ShaderParameterMap GetShaderParameters(const std::vector<ShaderParameter>& parameters,
-                                         const std::string& sourceStr) const;
+  ShaderParameterMap GetShaderParameters(const std::vector<ShaderParameter>& parameters) const;
 
   // Construction parameters
   RETRO::CRenderContext& m_context;
diff --git a/xbmc/cores/RetroPlayer/shaders/gl/ShaderPresetGL.cpp b/xbmc/cores/RetroPlayer/shaders/gl/ShaderPresetGL.cpp
index 1baf18b..9cf412a 100644
--- a/xbmc/cores/RetroPlayer/shaders/gl/ShaderPresetGL.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gl/ShaderPresetGL.cpp
@@ -52,8 +52,7 @@ bool CShaderPresetGL::CreateShaders()
     const std::string& shaderSource = pass.vertexSource; // Also contains fragment source
     const std::string& shaderPath = pass.sourcePath;
 
-    // Get only the parameters belonging to this specific shader
-    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters, pass.vertexSource);
+    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters);
 
     // Create the shader
     auto videoShader = std::make_unique<CShaderGL>();
diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderPresetGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderPresetGLES.cpp
index d33307c..d29260e 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderPresetGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderPresetGLES.cpp
@@ -52,8 +52,7 @@ bool CShaderPresetGLES::CreateShaders()
     const std::string& shaderSource = pass.vertexSource; // Also contains fragment source
     const std::string& shaderPath = pass.sourcePath;
 
-    // Get only the parameters belonging to this specific shader
-    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters, pass.vertexSource);
+    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters);
 
     // Create the shader
     auto videoShader = std::make_unique<CShaderGLES>();
diff --git a/xbmc/cores/RetroPlayer/shaders/windows/ShaderPresetDX.cpp b/xbmc/cores/RetroPlayer/shaders/windows/ShaderPresetDX.cpp
index 8552ce4..0b60653 100644
--- a/xbmc/cores/RetroPlayer/shaders/windows/ShaderPresetDX.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/windows/ShaderPresetDX.cpp
@@ -53,8 +53,7 @@ bool CShaderPresetDX::CreateShaders()
     const std::string& shaderSource = pass.vertexSource; // Also contains fragment source
     const std::string& shaderPath = pass.sourcePath;
 
-    // Get only the parameters belonging to this specific shader
-    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters, pass.vertexSource);
+    ShaderParameterMap passParameters = GetShaderParameters(pass.parameters);
 
     // Create the shader
     auto videoShader = std::make_unique<CShaderDX>();
