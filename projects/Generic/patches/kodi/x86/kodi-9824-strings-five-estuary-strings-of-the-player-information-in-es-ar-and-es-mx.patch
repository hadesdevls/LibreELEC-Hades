From 83177fe78d46243873d034be28ff1b35268e97ea Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 16:07:28 +0000
Subject: [PATCH] strings: five Estuary strings of the player information in
 es_ar and es_mx
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The rows "Audio decoder" (#31599), "Video bitrate" (#31603), "Audio
bitrate" (#31606), "System rendering speed" (#31608) and "Subtitle
decoder" (#31613) of the player information had no translation in es_ar
(the five) and es_mx (#31599 and #31613): they were shown in English.
They now say what es_es and es_mx say already, in the forms of these
two languages: "Decodificador de audio", "Tasa de bits de video", "Tasa
de bits de audio", "Velocidad de renderizado del sistema",
"Decodificador de subtítulos" ("decodificador", as Kodi's own es_ar and
es_mx say "Decodificadores de audio").

Host test (outside the tree): skin_check.py of the battery, every string
that the panel uses translated in es_es, es_ar and es_mx: 7 strings not
translated before, none after.
---
 .../language/resource.language.es_ar/strings.po        | 10 +++++-----
 .../language/resource.language.es_mx/strings.po        |  4 ++--
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index 5e91381..7f30a27 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -728,7 +728,7 @@ msgstr ""
 #. Label to show the video codec name
 msgctxt "#31599"
 msgid "Audio decoder"
-msgstr ""
+msgstr "Decodificador de audio"
 
 # empty strings from id 31170 to 31599
 #. Label to show the video codec name
@@ -749,7 +749,7 @@ msgstr "Aspecto de video"
 #. Label to show the video bitrate
 msgctxt "#31603"
 msgid "Video bitrate"
-msgstr ""
+msgstr "Tasa de bits de video"
 
 #. Label to show the audio codec name
 msgctxt "#31604"
@@ -764,7 +764,7 @@ msgstr "Canales de audio"
 #. Label to show the audio bitrate
 msgctxt "#31606"
 msgid "Audio bitrate"
-msgstr ""
+msgstr "Tasa de bits de audio"
 
 #. Label to show the screen resolution
 msgctxt "#31607"
@@ -774,7 +774,7 @@ msgstr "Resolución de pantalla"
 #. Label to show the system rendering speed
 msgctxt "#31608"
 msgid "System rendering speed"
-msgstr ""
+msgstr "Velocidad de renderizado del sistema"
 
 #. Label to show the system CPU usage
 msgctxt "#31609"
@@ -799,7 +799,7 @@ msgstr ""
 #. Label to show the subtitle decoder name
 msgctxt "#31613"
 msgid "Subtitle decoder"
-msgstr ""
+msgstr "Decodificador de subtítulos"
 
 #. Label to show the subtitle codec name
 msgctxt "#31614"
diff --git a/addons/skin.estuary/language/resource.language.es_mx/strings.po b/addons/skin.estuary/language/resource.language.es_mx/strings.po
index 4d77264..cc5e718 100644
--- a/addons/skin.estuary/language/resource.language.es_mx/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -728,7 +728,7 @@ msgstr ""
 #. Label to show the video codec name
 msgctxt "#31599"
 msgid "Audio decoder"
-msgstr ""
+msgstr "Decodificador de audio"
 
 # empty strings from id 31170 to 31599
 #. Label to show the video codec name
@@ -799,7 +799,7 @@ msgstr ""
 #. Label to show the subtitle decoder name
 msgctxt "#31613"
 msgid "Subtitle decoder"
-msgstr ""
+msgstr "Decodificador de subtítulos"
 
 #. Label to show the subtitle codec name
 msgctxt "#31614"
-- 
2.53.0

