From 0eb0e147f356b54f074f324ae16829b0181ed33c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:40:31 +0000
Subject: [PATCH] tools/dvbridge: the composer's notes once for a stream, not
 after every recovery

dvbridge_renderer_recover(), called for every frame that was not
presented (a seek, a late frame), flushed libplacebo's frame cache, which
also clears the notes of the composer of CCM 001 (libplacebo-9930: that it
composed, and why a picture was not composed so, each said once): they came
back to the log after every such frame. The flush keeps nothing else that
the bridge uses: no frame mixer, no single frame cached, no peak detection.
Now only dvbridge_renderer_reset() (a new stream) flushes it.

Tested with the render test of the bridge on Mesa's zink, with a renderer of
its own on the first picture: the note "composed as ETSI GS CCM 001 clause
5.4 does" said once by the first picture, not again after two recoveries
(before: twice), once more after a reset. Every drawing of the test, the
same bytes.
---
 tools/dvbridge/dvbridge_render.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 1147710..d861b62 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -416,6 +416,11 @@ static struct dvbridge_renderer *create_renderer(pl_gpu gpu, pl_log log, bool tr
     return r;
 }
 
+/* Hades: what libplacebo keeps of the last frames is not flushed here: the bridge keeps nothing in it
+ * (no frame mixer, no single frame cached, no peak detection), and the flush also clears the notes of
+ * the composer of CCM 001 (libplacebo-9930: why a picture is not composed so, said once), which then
+ * came back to the log after every frame that was not presented. A new stream flushes it
+ * (dvbridge_renderer_reset()). */
 void dvbridge_renderer_recover(struct dvbridge_renderer *r)
 {
     if (!r)
@@ -425,10 +430,8 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *r)
     r->ready = false;
     r->packed = false;
     r->hdr10_ready = false;
-    if (r->renderer) {
-        pl_renderer_flush_cache(r->renderer);
+    if (r->renderer)
         pl_renderer_reset_errors(r->renderer, NULL);
-    }
 }
 
 void dvbridge_renderer_reset(struct dvbridge_renderer *r)
@@ -436,6 +439,8 @@ void dvbridge_renderer_reset(struct dvbridge_renderer *r)
     if (!r)
         return;
     dvbridge_renderer_recover(r);
+    if (r->renderer)
+        pl_renderer_flush_cache(r->renderer);
     dvbridge_reset(r->context);
     r->noted = r->fresh = 0;
 }
