 tools/dvbridge/dvbridge_core.h                |  6 +++
 tools/dvbridge/dvbridge_metadata.h            | 54 +++++++++++++++++--
 tools/dvbridge/dvbridge_render.c              | 10 ++++
 tools/dvbridge/dvbridge_render.h              |  5 ++
 .../VideoRenderers/DVBridgeGLES.cpp           | 24 +++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  3 ++
 xbmc/settings/AdvancedSettings.cpp            |  2 +
 xbmc/settings/AdvancedSettings.h              |  5 ++
 9 files changed, 113 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 343c0f3..a5dec59 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -59,6 +59,12 @@ void dvbridge_set_trims(struct dvbridge_context *context, bool send)
         context->state.no_trims = !send;
 }
 
+void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add)
+{
+    if (context)
+        context->state.cm40_default = add;
+}
+
 struct dvbridge_candidate *dvbridge_prepare(
     const struct dvbridge_context *context, const void *metadata, size_t bytes,
     double pts, struct dvbridge_geometry geometry, bool fel_reconstructed)
@@ -198,6 +204,7 @@ bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
     reading->cm40_why = candidate->state.cm40_why;
     reading->cm40_level = candidate->state.cm40_level;
     reading->cm40_length = candidate->state.cm40_length;
+    reading->cm40_added = r->cm40_added;
     reading->packets = candidate->state.count;
     reading->scene_refresh = candidate->state.size > 1 && candidate->state.payload[1] == 1;
     reading->metadata_id = candidate->state.id;
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index a5ddedf..dc38e5e 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -68,6 +68,10 @@ void dvbridge_set_display_management(struct dvbridge_context *context, unsigned
  * of level 8); true until said otherwise. Set before the frames of a stream (a frame prepared before
  * it was made with what held then), and kept by dvbridge_reset(). */
 void dvbridge_set_trims(struct dvbridge_context *context, bool send);
+/* Hades: whether a frame whose RPU has no content mapping v4.0 part is sent with dovi_tool's default one
+ * (dvbridge_dv::cm40_default in dvbridge_metadata.h); false until said otherwise. Set and kept as
+ * dvbridge_set_trims(). */
+void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add);
 
 /* No state advances until presentation succeeds and commit is called. */
 struct dvbridge_candidate *dvbridge_prepare(
@@ -134,6 +138,8 @@ struct dvbridge_reading {
     unsigned cm40_dropped;
     const char *cm40_why;
     unsigned cm40_level, cm40_length;
+    /* Hades: blocks of the default v4.0 part added to this frame (dvbridge_set_cm40_default()) */
+    unsigned cm40_added;
     unsigned packets;     /* transport packets of the payload */
     bool scene_refresh;   /* the frame refreshes the scene */
     unsigned metadata_id;
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 1ecf6e0..35ea14c 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -36,6 +36,8 @@ struct dvbridge_dv_reading {
     /* Hades: blocks of the v4.0 part left out because that part cannot be carried in this stream
      * (dvbridge_dv::cm40_dropped) */
     unsigned cm40_dropped;
+    /* Hades: blocks of the default v4.0 part added to this frame (dvbridge_dv::cm40_default) */
+    unsigned cm40_added;
 };
 
 struct dvbridge_dv {
@@ -101,6 +103,17 @@ struct dvbridge_dv {
      * left out, and those of level 10, which only describe the targets of level 8 blocks. Kept from
      * one stream to the next (dvbridge_dv_restart()): it is the display's, not the stream's. */
     bool no_trims;
+    /* Hades: cm40_default, a frame whose RPU has no content mapping v4.0 part at all is sent with the one
+     * that dovi_tool adds as its "safe" default (add_cmv4_default_metadata, CmV40DmData::default_safe():
+     * level 3 with no offsets, level 9 DCI-P3 D65, level 11 cinema with a D65 white point and no
+     * reference mode, level 254 of CM v4.0.2; no level 8, no level 10). An expert switch for a test on a
+     * display of display management 4 (advancedsettings.xml, video/dvcm40default), off by default: it is
+     * no conversion of the v2.9 trims (level 8 has no public definition to convert them to), dovi_tool
+     * itself calls it unsafe, and what a display does with it is only seen on the display. Not for a
+     * display of display management 2 or 3 (cm29_only), nor where the v4.0 part is left out
+     * (cm40_dropped); a frame whose payload has no room for it goes out without it. Kept from one stream
+     * to the next (dvbridge_dv_restart()), as no_trims. */
+    bool cm40_default;
 };
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
@@ -309,10 +322,11 @@ static inline uint32_t dvbridge_dv_crc(const uint8_t *p, size_t n)
 static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
 {
     const unsigned id = d->id;
-    const bool no_trims = d->no_trims;
+    const bool no_trims = d->no_trims, cm40_default = d->cm40_default;
     memset(d, 0, sizeof(*d));
     d->id = id;
     d->no_trims = no_trims;
+    d->cm40_default = cm40_default;
     d->restart = true;
 }
 /* Hades: the extension levels that the serializer knows. ETSI GS CCM 001 V1.1.1 defines 1, 2 and 5
@@ -445,7 +459,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             taken |= 1u << j;
     }
     d->reading.skipped = d->reading.skipped_level = 0;
-    d->reading.cm40_left_out = d->reading.cm40_dropped = 0;
+    d->reading.cm40_left_out = d->reading.cm40_dropped = d->reading.cm40_added = 0;
     d->size = 0;
     d->payload[d->size++] = 0;
     d->payload[d->size++] = repeat ? d->previous[1] : refresh ? 1 : c->scene_refresh_flag;
@@ -498,10 +512,11 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     bool v40_begun = false;
     const AVDOVIDmData *ordered[AV_DOVI_MAX_EXT_BLOCKS];
     unsigned order[AV_DOVI_MAX_EXT_BLOCKS];
+    bool rpu_v40 = false; /* (Hades: the RPU has a block of the v4.0 part, cm40_default) */
     for(int i=0;i<m->num_ext_blocks;i++) {
         const AVDOVIDmData *e=av_dovi_get_ext(m,i);
         unsigned rank=e->level;
-        if(e->level==3 || (e->level>=8 && e->level<=11) || e->level==254)rank+=256;
+        if(e->level==3 || (e->level>=8 && e->level<=11) || e->level==254){rank+=256;rpu_v40=true;}
         int j=i;
         while(j>0 && order[j-1]>rank) {ordered[j]=ordered[j-1];order[j]=order[j-1];j--;}
         ordered[j]=e;order[j]=rank;
@@ -629,6 +644,39 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     DV_REFUSE(l1 == 1, l1 ? "two level 1 blocks" : "no level 1 block");
     if (!area && !dvbridge_dv_made_area(d, taken, count_pos))
         return false; /* (d->refused says why) */
+    /* Hades: the default v4.0 part (cm40_default), after the v2.9 part as an RPU has it, converted for
+     * the tunnel as the blocks of an RPU are (dvbridge_cm4_wire() of their bytes in the RPU) */
+    if (d->cm40_default && !rpu_v40 && !d->cm29_only && !d->cm40_dropped) {
+        static const struct {
+            uint8_t level, length, raw[5];
+        } defaults[] = {
+            {3, 5, {0x80, 0x08, 0x00, 0x80, 0x00}}, /* offsets 2048, 2048, 2048: none */
+            {9, 1, {0}},                            /* source primaries: DCI-P3 D65 */
+            {11, 4, {1, 0, 0, 0}},                  /* cinema, white point D65, no reference mode */
+            {254, 2, {0, 2}},                       /* dm_mode 0, dm_version_index 2 */
+        };
+        const unsigned size0 = d->size, count0 = d->payload[count_pos];
+        bool fits = true;
+        for (unsigned k = 0; fits && k < sizeof(defaults) / sizeof(defaults[0]); k++) {
+            uint8_t wire[32];
+            const int n = dvbridge_cm4_wire(defaults[k].level, defaults[k].raw, defaults[k].length, wire);
+            fits = n >= 0 && d->size + 5 + (unsigned)n <= DVBRIDGE_DV_MAX_PAYLOAD &&
+                   d->payload[count_pos] + 1u <= AV_DOVI_MAX_EXT_BLOCKS;
+            if (fits) {
+                dvbridge_dv_u32(d, (uint32_t)n);
+                d->payload[d->size++] = defaults[k].level;
+                memcpy(d->payload + d->size, wire, (size_t)n);
+                d->size += (unsigned)n;
+                d->payload[count_pos]++;
+            }
+        }
+        if (fits) {
+            d->reading.cm40_added = sizeof(defaults) / sizeof(defaults[0]);
+        } else {
+            d->size = size0;
+            d->payload[count_pos] = count0;
+        }
+    }
     DV_REFUSE(d->size<=DVBRIDGE_DV_MAX_PAYLOAD && d->payload[count_pos]<=AV_DOVI_MAX_EXT_BLOCKS,
               "a payload over 512 bytes, or of more than 32 blocks");
     if (d->frames && (d->previous_size != d->size || memcmp(d->previous, d->payload, d->size))) {
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index d93634e..5752184 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -22,6 +22,7 @@ enum {
     NOTE_CM40_DROPPED = 32,
     NOTE_LEVEL3 = 64,
     NOTE_LEVEL3_REFUSED = 128,
+    NOTE_CM40_ADDED = 256,
 };
 
 /* Hades: the bridge's own passes that are timed (dvbridge_render_time_passes()), each with a few
@@ -489,6 +490,7 @@ bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_ren
     notes->cm40_dropped = r->fresh & NOTE_CM40_DROPPED;
     notes->level3_added = r->fresh & NOTE_LEVEL3;
     notes->level3_refused = r->fresh & NOTE_LEVEL3_REFUSED;
+    notes->cm40_added = r->fresh & NOTE_CM40_ADDED;
     r->fresh = 0;
     return true;
 }
@@ -729,6 +731,8 @@ static void note_reading(struct dvbridge_renderer *r)
             fresh = note(r, NOTE_LEVEL_SKIPPED) || fresh;
         if (reading.cm40_dropped)
             fresh = note(r, NOTE_CM40_DROPPED) || fresh;
+        if (reading.cm40_added)
+            fresh = note(r, NOTE_CM40_ADDED) || fresh;
         if (fresh)
             r->notes.reading = reading;
     }
@@ -2339,6 +2343,12 @@ void dvbridge_render_send_trims(struct dvbridge_renderer *r, bool send)
         dvbridge_set_trims(r->context, send);
 }
 
+void dvbridge_render_add_cm40_default(struct dvbridge_renderer *r, bool add)
+{
+    if (r)
+        dvbridge_set_cm40_default(r->context, add);
+}
+
 void dvbridge_render_set_window(struct dvbridge_renderer *r, pl_tex window)
 {
     if (r)
