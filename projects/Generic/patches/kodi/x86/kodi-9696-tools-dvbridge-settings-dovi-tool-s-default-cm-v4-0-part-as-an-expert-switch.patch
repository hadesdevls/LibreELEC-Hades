     bool cm40_dropped;
+    /* Hades: frames of this stream go out with the default v4.0 part (reading: cm40_added) */
+    bool cm40_added;
     bool bl_depth;      /* a frame refused: its base layer is not of the depth of its RPU */
     bool el_depth;      /* an enhancement layer not used: not of the depth of its RPU */
     /* Hades: the pixels drawn over a picture of profile 5 converted by the transport itself, as
@@ -411,6 +413,9 @@ void dvbridge_render_use_source_transport(struct dvbridge_renderer *renderer, bo
 /* Hades: whether the display is sent the trims of the metadata (dvbridge_set_trims()); true by
  * default */
 void dvbridge_render_send_trims(struct dvbridge_renderer *renderer, bool send);
+/* Hades: whether a frame whose RPU has no content mapping v4.0 part is sent with dovi_tool's default one
+ * (dvbridge_set_cm40_default()); false by default */
+void dvbridge_render_add_cm40_default(struct dvbridge_renderer *renderer, bool add);
 /* Whether the last picture prepared goes out in the source transport; *why, where it is asked
  * for and it does not: why (else NULL) */
 bool dvbridge_render_source(const struct dvbridge_renderer *renderer, const char **why);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 9ed58a3..1ee05f7 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -511,6 +511,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   UseComposerSetting();
   UseGamutSetting();
   UseMmrTableSetting();
+  UseCm40DefaultSetting();
   // Hades: the transport that UseSourceTransport() asked for, also for a renderer made after it
   dvbridge_render_use_source_transport(m_renderer, m_sourceWanted);
   // ... and Low-Latency (SetLowLatency())
@@ -878,6 +879,11 @@ void CDVBridgeGLES::LogNotes()
               "v2.9 part only (levels 1, 2, 4 and 5, which CCM 001 defines), as to a display of "
               "display management 2 or 3, until the stream ends",
               r.cm40_why ? r.cm40_why : "", r.cm40_level, r.cm40_length);
+  if (notes.cm40_added)
+    CLog::Log(LOGINFO,
+              "DVBridge: the RPUs of this stream have no content mapping v4.0 part: the frames go out "
+              "with dovi_tool's default one ({} blocks), as advancedsettings.xml asks (dvcm40default)",
+              r.cm40_added);
   if (notes.bl_depth)
     CLog::Log(LOGWARNING,
               "DVBridge: the base layer is decoded to {} bits and its RPU is for {}: such frames are "
@@ -1534,6 +1540,24 @@ void CDVBridgeGLES::UseMmrTableSetting()
                 : ", but this libplacebo has no such table: every term is computed");
 }
 
+// Hades: a frame whose RPU has no content mapping v4.0 part is sent with the one that dovi_tool adds as
+// its "safe" default (levels 3 with no offsets, 9 DCI-P3 D65, 11 cinema and 254 of CM v4.0.2; no level 8
+// trims, no level 10), where advancedsettings.xml asks for it (<video><dvcm40default>true</dvcm40default>
+// </video>, dvbridge_render_add_cm40_default()). A test of what a display of display management 4 does
+// with it, to be judged on the display; not a conversion of the v2.9 trims. Off by default.
+void CDVBridgeGLES::UseCm40DefaultSetting()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent();
+  if (!m_renderer || !settings || !settings->GetAdvancedSettings()->m_videoDVCm40Default)
+    return;
+  dvbridge_render_add_cm40_default(m_renderer, true);
+  CLog::Log(LOGINFO,
+            "DVBridge: RPUs without a content mapping v4.0 part are sent with dovi_tool's default one "
+            "(levels 3 with no offsets, 9 DCI-P3 D65, 11 cinema and 254 of CM v4.0.2; no level 8 "
+            "trims), as advancedsettings.xml asks (dvcm40default): a test for a display of display "
+            "management 4, not a conversion of the v2.9 trims");
+}
+
 void CDVBridgeGLES::UseGamutTable(bool fine)
 {
   m_fineGamut = fine;
