--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -43,6 +43,8 @@ struct dvbridge_render_notes {
     /* Hades: the content mapping v4.0 part of the metadata cannot be carried in this stream and is
