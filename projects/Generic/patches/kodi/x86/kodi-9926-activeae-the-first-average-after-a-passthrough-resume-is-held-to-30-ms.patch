From 77af9c5c6794d21f3cde09ef84474b37d4088967 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:19:05 +0000
Subject: [PATCH] ActiveAE: the first average after a passthrough resume is
 held to 30 ms

A passthrough stream that resumed in sync from a pause that kept its sound
stays in sync on Kodi's threshold: 100 ms, 222 ms of TrueHD. Its first
average is now said in kodi.log, and held to the 30 ms that a correction
lands in: a resume that the reckoning got wrong (an output closed while
paused and opened again, a player that heard of the resume late) is put
back once. Sound that is late is left to the player's clock where it
follows the sound (not TrueHD), as at a start.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 29 +++++++++++++++++--
 .../Engines/ActiveAE/ActiveAEStream.h         |  3 ++
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 8709287..5f4c6f8 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2124,6 +2124,7 @@ bool CActiveAE::HoldRawStream(CActiveAEStream* stream)
     hold.averageSoFar = soFar;
   hold.at = now;
   stream->m_rawHold = std::move(hold);
+  stream->m_rawResumeCheck = false;
 
   const double scale{IsTrueHDPassthrough() ? TRUEHD_SYNC_ERROR_SCALE : 1.0};
   CLog::Log(LOGINFO,
@@ -2232,9 +2233,10 @@ bool CActiveAE::ResumeRawStream(CActiveAEStream* stream)
   switch (hold.syncState)
   {
     case CAESyncInfo::AESyncState::SYNC_INSYNC:
-      // what the player was told stays told
+      // what the player was told stays told; its first average is held to the band of a correction
       stream->m_syncError.Flush(stream->GetErrorInterval());
       stream->m_lateStartHandedOver = false;
+      stream->m_rawResumeCheck = true;
       break;
     case CAESyncInfo::AESyncState::SYNC_ADJUST:
       // the error left to correct stays (m_lastError)
@@ -2272,6 +2274,7 @@ bool CActiveAE::ResumeRawStream(CActiveAEStream* stream)
 
 void CActiveAE::DropRawHold(CActiveAEStream* stream, const char* why)
 {
+  stream->m_rawResumeCheck = false;
   // the pools of copies go with the stream's buffers: deleted once the last of them is back, as
   // those of a stream (ClearDiscardedBuffers())
   for (auto& copies : stream->m_rawCopyPools)
@@ -3235,7 +3238,26 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
            (clockFollowsAudio && syncError < 0 && -syncError <= MAX_LATE_START_MS);
   };
 
-  if (newerror && fabs(error) > threshold && stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
+  // Hades: the first average of a passthrough stream that resumed in sync from a pause
+  // (ResumeRawStream()) is said, and held to the 30 ms that a correction lands in rather than to
+  // the threshold: a resume that the reckoning got wrong is put back once. Sound that is late is
+  // left to the player's clock where it follows the sound, as at a start.
+  bool resumeOff{false};
+  if (newerror && stream->m_rawResumeCheck &&
+      stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
+  {
+    stream->m_rawResumeCheck = false;
+    resumeOff = fabs(error) >= 30 * scale && !(clockFollowsAudio && error < 0);
+    CLog::Log(LOGINFO,
+              "ActiveAE::SyncStream - the passthrough stream ({}) that resumed from a pause is "
+              "{:.0f} ms {} the video{}",
+              CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error) / scale,
+              error > 0 ? "ahead of" : "behind",
+              resumeOff ? ", more than the 30 ms a correction lands in" : "");
+  }
+
+  if (newerror && (fabs(error) > threshold || resumeOff) &&
+      stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
   {
     stream->m_syncState = CAESyncInfo::AESyncState::SYNC_ADJUST;
     stream->m_processingBuffers->SetRR(1.0, m_settings.atempoThreshold);
@@ -3258,7 +3280,8 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
                 "ActiveAE::SyncStream - the passthrough stream ({}) is {:.0f} ms {} the video, "
                 "more than the {:.0f} ms allowed: it is put back with {}, each a cut in the sound",
                 CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), fabs(error) / scale,
-                error > 0 ? "ahead of" : "behind", threshold / scale,
+                error > 0 ? "ahead of" : "behind",
+                (fabs(error) > threshold ? threshold : 30 * scale) / scale,
                 error > 0 ? "pauses" : "packets left out");
     }
   }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index 034f1ef..1c45f65 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -304,6 +304,9 @@ protected:
   std::vector<std::unique_ptr<CActiveAEBufferPool>> m_rawCopyPools;
   //! Hades: where the video clock last ran (PassthroughPause.h, NoteClock())
   std::optional<AE::PTPAUSE::ClockRead> m_rawClockRead;
+  //! Hades: resumed in sync from a pause: the first average is held to the band of a correction
+  //! (CActiveAE::SyncStream())
+  bool m_rawResumeCheck{false};
 };
 }
 
