From a71d376533351c0842fd9f68a456793ea0826280 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:45:20 +0000
Subject: [PATCH] windowing/gbm: an output whose display cannot take sound is
 not kept on for sound that is not certain to be its own

Where it is not certain which output carries the sound in use (the audio
engine has not said yet, ALSA names no card or no ELD, no output has the
display of the ELD), every output of the device that can carry sound and
has a display was kept on, black, so that none would be silenced. On a
card with a TV and several monitors that left every monitor on with a
black picture instead of asleep.

A display carries sound only if its EDID has audio descriptors: the
codec builds the ELD from them, and without one no sound can be played to
it. The outputs kept on in those cases are now only those whose display
can (EdidCarriesAudio(): a valid EDID without a CTA-861 extension, or
with neither the basic audio flag nor an Audio Data Block, cannot; an
EDID that cannot be judged, such as DisplayID or a broken one, can). An
exact match of the ELD with a display still keeps that output whatever
its EDID says, and the log lines that say what stays on and why are
unchanged.

Not verified on hardware: that the monitors of the report have no audio
descriptors, or that the case is one of these; the selection by ELD
(only the output that carries the chosen sound) is as before.
---
 xbmc/utils/DisplayIdentity.h             | 51 ++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMSoundOutputs.h | 13 ++++--
 xbmc/windowing/gbm/drm/DRMUtils.cpp      | 12 +++++-
 3 files changed, 71 insertions(+), 5 deletions(-)

diff --git a/xbmc/utils/DisplayIdentity.h b/xbmc/utils/DisplayIdentity.h
index 514f796..1eda56e 100644
--- a/xbmc/utils/DisplayIdentity.h
+++ b/xbmc/utils/DisplayIdentity.h
@@ -113,6 +113,57 @@ inline DisplayIdentity IdentityOfEdid(const std::vector<uint8_t>& edid)
   return id;
 }
 
+/*!
+ * \brief Whether the display of an EDID can take sound at all
+ *
+ * An audio codec builds the ELD of an output from the short audio descriptors of the CTA-861
+ * extension of the display's EDID: a display whose EDID has none has no ELD, and no sound can be
+ * played to it. A valid EDID is judged without audio when it has no CTA-861 extension, or one with
+ * neither the basic audio flag (byte 3, bit 6) nor an Audio Data Block. Where the EDID cannot be
+ * judged (empty, not valid, a block of another kind such as DisplayID), it may: the answer is "can"
+ * wherever it is not certain that it cannot, for a decision that keeps an output on must not
+ * silence a display that has sound.
+ */
+inline bool EdidCarriesAudio(const std::vector<uint8_t>& edid)
+{
+  constexpr std::size_t BLOCK = 128;
+  constexpr uint8_t HEADER[8] = {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00};
+  const auto valid = [&edid](std::size_t at)
+  {
+    unsigned int sum = 0;
+    for (std::size_t i = 0; i < BLOCK; ++i)
+      sum += edid[at + i];
+    return sum % 256 == 0;
+  };
+  if (edid.size() < BLOCK || !std::equal(std::begin(HEADER), std::end(HEADER), edid.begin()) ||
+      !valid(0))
+    return true;
+  const std::size_t extensions = std::min<std::size_t>(edid[126], edid.size() / BLOCK - 1);
+  if (extensions < edid[126])
+    return true; // (a truncated EDID: not judged)
+  for (std::size_t n = 1; n <= extensions; ++n)
+  {
+    const std::size_t at = n * BLOCK;
+    const uint8_t tag = edid[at];
+    if (tag == 0xF0) // (a block map)
+      continue;
+    if (tag != 0x02 || !valid(at))
+      return true; // (DisplayID, or a block that does not add up: not judged)
+    if (edid[at + 1] >= 2 && (edid[at + 3] & 0x40))
+      return true;
+    const std::size_t end = std::min<std::size_t>(edid[at + 2], BLOCK);
+    for (std::size_t i = at + 4; i < at + end;)
+    {
+      const unsigned int tagOfBlock = edid[i] >> 5;
+      const std::size_t length = edid[i] & 0x1F;
+      if (tagOfBlock == 1)
+        return true;
+      i += 1 + length;
+    }
+  }
+  return false;
+}
+
 /*!
  * \brief The maker, product and name of the display of an HDMI or DisplayPort output from its ELD
  *        (HDA 1.0a, 7.3.3.34.1: version 2, CEA-861-D; ALSA also passes version 31, partial)
diff --git a/xbmc/windowing/gbm/drm/DRMSoundOutputs.h b/xbmc/windowing/gbm/drm/DRMSoundOutputs.h
index c367b2e..4d8a415 100644
--- a/xbmc/windowing/gbm/drm/DRMSoundOutputs.h
+++ b/xbmc/windowing/gbm/drm/DRMSoundOutputs.h
@@ -37,6 +37,10 @@ struct GraphicsOutput
   //! An HDMI, DisplayPort or DVI output, which can carry sound (an eDP, LVDS or VGA one cannot)
   bool sound{false};
   bool connected{false};
+  //! Its display can take sound at all, by its EDID (KODI::UTILS::EdidCarriesAudio(); true where
+  //! that is not known): an output whose display cannot is never kept on for sound that is not
+  //! certain to be its own, because no sound can be played to it
+  bool audio{true};
   //! It drives a CRTC now (for whoever comes back to it; OutputsForSound() does not ask)
   bool lit{false};
   //! Its display, by its EDID (KODI::UTILS::IdentityOfEdid(), EdidDisplayName()); maker 0: none
@@ -140,7 +144,10 @@ struct SoundDecision
  * the same display (two displays of one model) are both kept. Wherever it is not certain which
  * output carries the sound, every output that can carry sound and has a display connected is
  * kept, of the graphics device of the card where that is known and of all of them where it is
- * not: that is what Kodi did before this build turned unused outputs off. An audio output that no
+ * not: that is what Kodi did before this build turned unused outputs off. Only a display that can
+ * take sound counts then (GraphicsOutput::audio): a monitor whose EDID has no audio descriptors
+ * has no ELD and cannot carry what is not certain to be its own, and would stay on as a black
+ * screen for nothing. An audio output that no
  * graphics output carries (analog, S/PDIF, USB) keeps nothing.
  */
 inline SoundDecision OutputsForSound(const std::vector<UTILS::SoundOutput>& sound,
@@ -161,7 +168,7 @@ inline SoundDecision OutputsForSound(const std::vector<UTILS::SoundOutput>& soun
     if (std::ranges::find(it->why, why) == it->why.end())
       it->why.push_back(why);
   };
-  // (every output that can carry sound and has a display, of these devices)
+  // (every output that can carry sound and has a display that takes sound, of these devices)
   const auto keepAll = [&](const std::vector<const GraphicsDevice*>& among, const std::string& why)
   {
     unsigned int kept = 0;
@@ -169,7 +176,7 @@ inline SoundDecision OutputsForSound(const std::vector<UTILS::SoundOutput>& soun
     {
       for (const GraphicsOutput& output : device->outputs)
       {
-        if (output.sound && output.connected)
+        if (output.sound && output.connected && output.audio)
         {
           keep(*device, output, why);
           ++kept;
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index edc3922..fed6410 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1401,7 +1401,11 @@ KEEP_OUTPUTS::GraphicsDevice CDRMUtils::SurveyDevice(int fd, const std::string&
     output.sound = type && KEEP_OUTPUTS::CarriesSound(type);
     output.connected = connector->connection == DRM_MODE_CONNECTED;
     if (output.connected)
-      output.identity = IdentityOf(EdidOf(fd, *connector), output.name);
+    {
+      const std::vector<uint8_t> edid = EdidOf(fd, *connector);
+      output.identity = IdentityOf(edid, output.name);
+      output.audio = KODI::UTILS::EdidCarriesAudio(edid);
+    }
     const std::optional<uint64_t> atomicCrtc =
         atomic ? AtomicCrtcOf(fd, connector->connector_id) : std::nullopt;
     uint32_t encoderCrtc = 0;
@@ -1433,7 +1437,11 @@ KEEP_OUTPUTS::GraphicsDevice CDRMUtils::SurveyOwnDevice() const
     output.sound = KEEP_OUTPUTS::CarriesSound(connector->GetType());
     output.connected = connector->IsConnected();
     if (output.connected)
-      output.identity = IdentityOf(connector->GetEDID(), output.name);
+    {
+      const std::vector<uint8_t> edid = connector->GetEDID();
+      output.identity = IdentityOf(edid, output.name);
+      output.audio = KODI::UTILS::EdidCarriesAudio(edid);
+    }
     output.lit = connector->GetPropertyValue("CRTC_ID").value_or(0) != 0;
     device.outputs.push_back(std::move(output));
   }
