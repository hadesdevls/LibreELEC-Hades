From b28f9e600ae552b6ecb112c7882bd6922fc84a2c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:59:07 +0000
Subject: [PATCH] windowing/gbm: a 3D mode is never the mode that Kodi starts
 in

Two places take a mode of the output without going through the list of
modes, from which the 3D modes are now left out:
- FindCrtc() takes the mode that the output is in when Kodi starts. An
  output that a Kodi left in a 3D mode (it ended while it showed 3D, and
  nothing set a mode since) would be started in that mode, which is no
  mode of the list: the desktop resolution would match none of them.
  Such a mode is now not taken, and Kodi starts in the preferred mode,
  as where the output has no mode;
- FindPreferredMode() looks for the preferred mode, or the largest one,
  among all the modes of the connector. A driver may copy the preferred
  mode into its 3D variant. A mode with a 3D layout is passed over.

With these, no mode with a 3D layout is chosen for the GUI or for a 2D
picture while Kodi runs, by any driver: such a mode is set only as the
3D output of a resolution while the eyes are drawn split.

For an output that is in a 2D mode, and for the modes of a display
without 3D, both functions run the statements they ran.

Read and compiled (syntax check of DRMUtils.cpp with the commands of the
last build). Not run.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 0f1ebdc..b375f17 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -453,6 +453,11 @@ bool CDRMUtils::FindPreferredMode()
   {
     drmModeModeInfo* current_mode = m_connector->GetModeForIndex(i);
 
+    // Hades: not a mode with a 3D layout (a driver may copy the preferred mode into one):
+    // such a mode is set only for what is drawn stereoscopically
+    if (current_mode->flags & DRM_MODE_FLAG_3D_MASK)
+      continue;
+
     if (current_mode->type & DRM_MODE_TYPE_PREFERRED)
     {
       m_mode = current_mode;
@@ -1120,7 +1125,15 @@ bool CDRMUtils::FindCrtc()
       continue;
     m_orig_crtc = crtc;
     m_crtc = m_orig_crtc;
-    if (m_orig_crtc->GetModeValid())
+    // Hades: an output that was left in a mode with a 3D layout (by a Kodi that ended while it
+    // showed 3D) is not taken to be in a mode: Kodi starts in the preferred one, which is one
+    // of its list, as where the output has no mode (FindPreferredMode()).
+    if (m_orig_crtc->GetModeValid() &&
+        (m_orig_crtc->GetMode()->flags & DRM_MODE_FLAG_3D_MASK) != 0)
+    {
+      CLog::LogF(LOGINFO, "the output was left in a 3D mode: Kodi starts in the preferred mode");
+    }
+    else if (m_orig_crtc->GetModeValid())
     {
       m_mode = m_orig_crtc->GetMode();
       CLog::LogF(LOGDEBUG, "Original crtc id: {}, mode: {}x{}{} @ {} Hz", m_crtc->GetCrtcId(),
-- 
