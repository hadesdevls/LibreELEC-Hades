From 63da6be262bb3b3b07755c616bd9a8e9de168974 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:48:03 +0000
Subject: [PATCH] windowing/gbm: a failure of native Dolby Vision output keeps
 Dolby Vision in the supported HDR types

What is told of the display (System.SupportedHDRTypes, which System
Information > Video lists and add-ons read, from
GetDisplayHDRCapabilities()) asked NativeDVOutputReachable(), which asked
SupportsNativeDVOutput(true), and that counts a failure that turned native
output off until a later video (DisableNativeDVOutput()). After a video
that fell back to HDR10 the list said HDR10, HLG and HDR10+ without Dolby
Vision, as if the display had lost it (reported on an AMD 3400G with a
Philips OLED, forum post 209039), and an add-on that chooses its streams
by the list would have taken an HDR10 one for the very video that tries
Dolby Vision again.

A failure is no property of the display or of the settings: the next
video tries native output again (after failures in a row, a later one),
and the log and the Dolby Vision page of the player information say that
it was turned off and why. So the first reasons of the verdict (the
user's setting, a failure, an EDID that was not read) are taken out into
DVBRIDGE::NativeStateOf(), where the failure does not count for the
report, and SupportsNativeDVOutput() takes a second argument for it, which
only NativeDVOutputReachable() gives. The verdict for the output itself,
its log line and the player information do not change. Native output
turned off in the settings is still not reported.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 34 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp           | 16 ++++++---
 xbmc/windowing/gbm/WinSystemGbm.h             |  6 +++-
 3 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index b3c3191..384fda4 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -138,6 +138,40 @@ inline TransportModes TransportModesOf(const std::vector<ModeTraits>& modes, dou
   return any ? TransportModes::OTHER_RATES : TransportModes::NONE;
 }
 
+/*!
+ * \brief Hades: what of the state of native Dolby Vision output keeps it from being had, before
+ *        anything of the display, the output or its mode (the first reasons of
+ *        CWinSystemGbm::SupportsNativeDVOutput())
+ * \param turnedOff turned off in the settings by the user (videoscreen.hadesdvnative)
+ * \param disabled turned off after a failure, until a later video tries it again
+ *        (CWinSystemGbm::DisableNativeDVOutput())
+ * \param edidUnread the display's EDID could not be read when the video started
+ * \param report the question is the one of what is told of the display: the HDR types that the
+ *        system information lists and add-ons read (System.SupportedHDRTypes,
+ *        CWinSystemGbm::GetDisplayHDRCapabilities(), through NativeDVOutputReachable())
+ *
+ * A failure does not count for the report: it is no property of the display or of the settings.
+ * The next video tries native output again (after failures in a row, a later one), and the log and
+ * the Dolby Vision page of the player information say that it was turned off, and why. Counted
+ * there, it took Dolby Vision out of the list after a video that fell back to HDR10, as if the
+ * display had lost it, and an add-on that chooses its streams by the list would have taken an HDR10
+ * one for the very video that tries Dolby Vision again.
+ */
+enum class NativeState
+{
+  NONE, //!< none of these
+  SETTINGS, //!< turned off in the settings ("settings")
+  FAILED, //!< turned off after a failure (the code of the failure)
+  EDID, //!< the EDID was not read ("edid")
+};
+constexpr NativeState NativeStateOf(bool turnedOff, bool disabled, bool edidUnread, bool report)
+{
+  return turnedOff              ? NativeState::SETTINGS
+         : disabled && !report ? NativeState::FAILED
+         : edidUnread          ? NativeState::EDID
+                               : NativeState::NONE;
+}
+
 /*!
  * \brief Hades: why the output mode keeps a video from native output, as a reason code of the
  *        player information ("" where it does not)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index b1e6922..9ccb14a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1340,7 +1340,7 @@ const char* DVDisplayReasonText(std::string_view code)
 }
 } // namespace
 
-bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
+bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
 {
   const auto info = DVDisplayInfo();
   const char* reason = nullptr;
@@ -1355,21 +1355,24 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   const DV_DISPLAY::Signal signal = NativeDVSignal();
   const bool lowLatency = signal == DV_DISPLAY::Signal::LOW_LATENCY;
   const bool hdmi14b = signal == DV_DISPLAY::Signal::HDMI14B;
-  if (DVTurnedOff())
+  // Hades: the state of native output first; a failure not for the report (NativeStateOf())
+  const DVBRIDGE::NativeState state =
+      DVBRIDGE::NativeStateOf(DVTurnedOff(), m_dvDisabled, m_dvEdidUnread, report);
+  if (state == DVBRIDGE::NativeState::SETTINGS)
   {
     // Hades: the user's own choice, before anything of the display
     code = "settings";
     reason = "turned off in the settings (System > Display); Dolby Vision plays as on a display "
              "without it";
   }
-  else if (m_dvDisabled)
+  else if (state == DVBRIDGE::NativeState::FAILED)
   {
     failedCode = DVFailedCode();
     code = failedCode.c_str();
     reason = "disabled after a failure (see the DVBridge errors above); tried again with a later "
              "video";
   }
-  else if (m_dvEdidUnread)
+  else if (state == DVBRIDGE::NativeState::EDID)
   {
     code = "edid";
     reason = "the display's EDID could not be read when this video started";
@@ -1525,7 +1528,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
 
 bool CWinSystemGbm::NativeDVOutputReachable() const
 {
-  if (!SupportsNativeDVOutput(true))
+  // (Hades: whatever a failure did, which says nothing of the display: DVBRIDGE::NativeStateOf())
+  if (!SupportsNativeDVOutput(true, true))
     return false;
   // The verdict in any mode leaves out the refresh rate (SupportsNativeDVOutput()): a mode of
   // another rate may come with the video. Not when the rate is not adjusted to it and the output
@@ -4732,6 +4736,8 @@ CHDRCapabilities CWinSystemGbm::GetDisplayHDRCapabilities() const
   // displays without Dolby Vision: an add-on that is told so can pick that version, or an HDR10
   // stream, for it. (Hades: also not where a refresh rate that is not adjusted to the video keeps
   // every video from a transport mode, NativeDVOutputReachable(); before, it was reported there.)
+  // (Hades: still reported after a video whose native output failed: that is no property of the
+  // display, and the next video tries it again; it was left out until then.)
   if (NativeDVOutputReachable())
     caps.SetDolbyVision();
 #else
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index c2d2639..7ad0df7 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -138,7 +138,9 @@ public:
   //! Native Dolby Vision output is possible now. With anyMode, possible in a transport mode
   //! (3840x2160 at 23.976 to 60 Hz) even if the current mode is another one: that query does not
   //! change the verdict that is logged and shown in the player information.
-  bool SupportsNativeDVOutput(bool anyMode = false) const;
+  //! Hades: \param report (with anyMode) the question of what is told of the display: a failure
+  //! that turned native output off until a later video does not count (DVBRIDGE::NativeStateOf())
+  bool SupportsNativeDVOutput(bool anyMode = false, bool report = false) const;
   //! Hades: native output is Dolby Vision Low-Latency (player-led): it is turned on in the settings
   //! (videoscreen.hadesdvlowlatency, as read when the last video started) and the display offers Dolby
   //! Vision Low-Latency only (CDisplayInfo::SupportsLowLatencyDolbyVisionOnly(): a TV input in its
@@ -162,6 +164,8 @@ public:
   //! transport mode (SupportsNativeDVOutput(true)), and not kept from every one by a refresh rate
   //! that is not adjusted to the video and is none of the transport's (Dolby Vision never changes
   //! the refresh rate the video gets). What is reported to add-ons (GetDisplayHDRCapabilities()).
+  //! Hades: also after a failure that turned native output off until a later video, which is no
+  //! property of the display (the log and the player information say it).
   bool NativeDVOutputReachable() const;
   //! Stop using native Dolby Vision output after a failure, until a later video tries it again:
   //! the next one after a first failure, then the one after 2, 4 and at most 8 videos, or the next
-- 
2.53.0

