+std::vector<STEREO::Mode> CDRMUtils::GetStereoModes() const
+{
+  std::vector<STEREO::Mode> modes;
+  if (!m_connector)
+    return modes;
+
+  modes.reserve(m_connector->GetModesCount());
+  for (int i = 0; i < m_connector->GetModesCount(); i++)
+    modes.push_back(StereoModeOf(*m_connector->GetModeForIndex(i)));
+  return modes;
+}
+
+bool CDRMUtils::GetModeInfo(int index, RESOLUTION_INFO& info)
+{
+  if (!m_connector || index < 0 || index >= m_connector->GetModesCount())
+    return false;
+
+  info = GetResolutionInfo(m_connector->GetModeForIndex(index));
+  info.strId = std::to_string(index);
+  return true;
+}
+
+uint32_t CDRMUtils::ScanoutHeight() const
+{
+  return static_cast<uint32_t>(STEREO::ScanoutHeight(StereoModeOf(*m_mode)));
