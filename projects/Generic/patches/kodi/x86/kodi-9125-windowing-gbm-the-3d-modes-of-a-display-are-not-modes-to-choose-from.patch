+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace STEREO
+{
+
+/*!
+ * \brief Stereoscopic 3D over HDMI: what is decided
+ *
+ * A 3D display takes the two eyes of a picture in one of the layouts of HDMI 1.4: frame
+ * packing (both eyes whole, one above the other with a gap between them, in a frame of twice
+ * the lines), top-and-bottom and side-by-side (half) (each eye squeezed into half of an
+ * ordinary frame). It knows which one it is given from the HDMI vendor InfoFrame, and then
+ * shows it as 3D by itself; without it, it shows the two halves as they come.
+ *
+ * The drivers tell the display through the mode: a DRM mode carries the layout in its flags,
+ * the display's EDID says which modes exist with which layout, and the driver sends the
+ * InfoFrame of the mode it is given. Kodi draws the eyes where the layout has them. Where a
+ * driver has no such modes and takes the bytes of the vendor InfoFrame from its user
+ * (nvidia-drm), the two half layouts, which change nothing in the frame, are told that way.
+ *
+ * Only what is decided is here, with nothing of DRM or of Kodi in it, so that it can be tested
+ * by itself: what the flags of a mode say, the size of a frame-packed frame, which modes the
+ * display offers for a picture, which of them is used, what the EDID says of 3D and the bytes
+ * of the InfoFrame.
+ */
+
+//! The flags of a DRM mode that matter here, with their values in drm_mode.h
+inline constexpr uint32_t FLAG_INTERLACE = 1u << 4;
+inline constexpr uint32_t FLAG_DBLSCAN = 1u << 5;
+//! The 3D layout is a number in five bits of the flags, not a bit for each layout:
+//! top-and-bottom is 7 and frame packing is 1, so the bit of the one is also set in the other.
+inline constexpr uint32_t FLAG_3D_MASK = 0x1fu << 14;
+inline constexpr uint32_t FLAG_3D_FRAME_PACKING = 1u << 14;
+inline constexpr uint32_t FLAG_3D_TOP_AND_BOTTOM = 7u << 14;
+inline constexpr uint32_t FLAG_3D_SIDE_BY_SIDE_HALF = 8u << 14;
+
+enum class Layout
+{
+  NONE, //!< an ordinary mode
+  FRAME_PACKING,
+  TOP_AND_BOTTOM,
+  SIDE_BY_SIDE_HALF,
+  OTHER, //!< a layout that is not drawn here (field or line alternative, full side-by-side...)
+};
+
+constexpr Layout LayoutOf(uint32_t flags)
+{
+  switch (flags & FLAG_3D_MASK)
+  {
+    case 0:
+      return Layout::NONE;
+    case FLAG_3D_FRAME_PACKING:
+      return Layout::FRAME_PACKING;
+    case FLAG_3D_TOP_AND_BOTTOM:
+      return Layout::TOP_AND_BOTTOM;
+    case FLAG_3D_SIDE_BY_SIDE_HALF:
+      return Layout::SIDE_BY_SIDE_HALF;
+    default:
+      return Layout::OTHER;
+  }
+}
+
+constexpr const char* LayoutName(Layout layout)
+{
+  switch (layout)
+  {
+    case Layout::FRAME_PACKING:
+      return "frame packing";
+    case Layout::TOP_AND_BOTTOM:
+      return "top-and-bottom";
+    case Layout::SIDE_BY_SIDE_HALF:
+      return "side-by-side (half)";
+    case Layout::OTHER:
+      return "another 3D layout";
+    default:
+      return "none";
+  }
+}
+
+/*!
+ * \brief A DRM mode (drmModeModeInfo), in its units
+ */
+struct Mode
+{
+  uint32_t clock{0}; //!< kHz
+  uint16_t hdisplay{0};
+  uint16_t hsyncStart{0};
+  uint16_t hsyncEnd{0};
+  uint16_t htotal{0};
+  uint16_t hskew{0};
+  uint16_t vdisplay{0};
+  uint16_t vsyncStart{0};
+  uint16_t vsyncEnd{0};
+  uint16_t vtotal{0};
+  uint16_t vscan{0};
+  uint32_t flags{0};
+};
+
+/*!
+ * \brief The lines that are scanned out with a mode
+ *
+ * A 3D mode has the timing of the 2D mode it comes from. For frame packing the driver doubles
+ * it when the mode is set (the kernel: drm_mode_set_crtcinfo() with CRTC_STEREO_DOUBLE): the
+ * first eye, as many lines as the 2D mode has of vertical blanking, the second eye. 1080p24
+ * becomes 1920x2205 with a gap of 45 lines, 720p50 and 720p60 become 1280x1470 with one of
+ * 30. That is the framebuffer the driver wants. The other layouts keep the lines of the mode.
+ */
+constexpr int ScanoutHeight(const Mode& mode)
+{
+  return LayoutOf(mode.flags) == Layout::FRAME_PACKING ? mode.vdisplay + mode.vtotal
+                                                       : mode.vdisplay;
+}
+
+//! \brief The lines between the two eyes of a frame-packed frame; none in any other mode
+constexpr int ActiveSpace(const Mode& mode)
+{
+  return LayoutOf(mode.flags) == Layout::FRAME_PACKING && mode.vtotal > mode.vdisplay
+             ? mode.vtotal - mode.vdisplay
+             : 0;
+}
+
+//! \brief Frames (fields of an interlaced mode) in a second, as Kodi works it out for a mode
+inline double RefreshRate(const Mode& mode)
+{
+  if (mode.htotal == 0 || mode.vtotal == 0)
+    return 0.0;
+
+  double denominator = static_cast<double>(mode.vtotal) * mode.htotal;
+  if (mode.flags & FLAG_INTERLACE)
+    denominator /= 2;
+  if (mode.flags & FLAG_DBLSCAN)
+    denominator *= 2;
+  if (mode.vscan > 1)
+    denominator *= mode.vscan;
+  return mode.clock * 1000.0 / denominator;
+}
+
+//! \brief Whether two modes are the same but for their 3D layout
+constexpr bool SameTiming(const Mode& a, const Mode& b)
+{
+  return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsyncStart == b.hsyncStart &&
+         a.hsyncEnd == b.hsyncEnd && a.htotal == b.htotal && a.hskew == b.hskew &&
+         a.vdisplay == b.vdisplay && a.vsyncStart == b.vsyncStart && a.vsyncEnd == b.vsyncEnd &&
+         a.vtotal == b.vtotal && a.vscan == b.vscan &&
+         (a.flags & ~FLAG_3D_MASK) == (b.flags & ~FLAG_3D_MASK);
+}
+
+/*!
+ * \brief What the display offers for one of its 2D modes
+ */
+struct Offer
+{
+  int base{-1}; //!< the index of the 2D mode
+  int width{0};
+  int height{0};
+  double refresh{0.0};
+  bool interlaced{false};
+  //! The index of the mode that sends that timing in each layout, or -1 when there is none.
+  //! Never a frame-packed mode of interlaced or double-scanned timing: its frame is not one
+  //! picture above another, and it is not drawn here.
+  int framePacking{-1};
+  int topAndBottom{-1};
+  int sideBySide{-1};
+  //! Where the driver has no mode for a half layout: whether the display says that it takes
+  //! it with this timing, and the driver can be given the InfoFrame that tells it. Set by
+  //! whoever knows the driver and the EDID (see Parse() and Supports()).
+  bool infoFrameTopAndBottom{false};
+  bool infoFrameSideBySide{false};
+};
+
+/*!
+ * \brief The 2D modes of a display, each with the modes that send it in a 3D layout
+ * \param modes the modes of the connector, in its order: the indices are into it
+ */
+inline std::vector<Offer> Offers(std::span<const Mode> modes)
+{
+  std::vector<Offer> offers;
+  for (std::size_t i = 0; i < modes.size(); ++i)
+  {
+    const Mode& mode = modes[i];
+    if (LayoutOf(mode.flags) != Layout::NONE)
+      continue;
+
+    Offer offer;
+    offer.base = static_cast<int>(i);
+    offer.width = mode.hdisplay;
+    offer.height = mode.vdisplay;
+    offer.refresh = RefreshRate(mode);
+    offer.interlaced = (mode.flags & FLAG_INTERLACE) != 0;
+
+    for (std::size_t j = 0; j < modes.size(); ++j)
+    {
+      if (!SameTiming(mode, modes[j]))
+        continue;
+
+      const int index = static_cast<int>(j);
+      switch (LayoutOf(modes[j].flags))
+      {
+        case Layout::FRAME_PACKING:
+          if (offer.framePacking < 0 && !(mode.flags & (FLAG_INTERLACE | FLAG_DBLSCAN)))
+            offer.framePacking = index;
+          break;
+        case Layout::TOP_AND_BOTTOM:
+          if (offer.topAndBottom < 0)
+            offer.topAndBottom = index;
+          break;
+        case Layout::SIDE_BY_SIDE_HALF:
+          if (offer.sideBySide < 0)
+            offer.sideBySide = index;
+          break;
+        default:
+          break;
+      }
+    }
+    offers.push_back(offer);
+  }
+  return offers;
+}
+
+/*!
+ * \brief How Kodi draws the two eyes: one above the other, or one beside the other
+ *
+ * Its split stereoscopic modes of the GUI. A frame-packed frame is drawn as the first, with the
+ * gap between the eyes.
+ */
+enum class Arrangement
+{
+  TOP_AND_BOTTOM,
+  SIDE_BY_SIDE,
+};
+
+/*!
+ * \brief What may be used
+ */
+struct Allowed
+{
+  bool framePacking{true};
+  bool halfModes{true}; //!< the modes of top-and-bottom and of side-by-side (half)
+  bool infoFrame{true}; //!< those layouts told by the InfoFrame alone
+  //! A mode of another size than the one Kodi chose, at the same refresh rate: where Kodi
+  //! may change the mode for a video at all (the adjustment of the refresh rate is on)
+  bool otherSize{true};
+};
+
+/*!
+ * \brief The output for what Kodi draws
+ */
+struct Choice
+{
+  Layout layout{Layout::NONE}; //!< none: the 2D mode, as without any of this
+  int base{-1}; //!< the 2D mode whose size is drawn
+  //! the mode to set: the 3D one or, where the display is told by the InfoFrame, the 2D one
+  int mode{-1};
+  bool infoFrame{false};
+
+  bool operator==(const Choice&) const = default;
+};
+
+/*!
+ * \brief Chooses the output for what Kodi draws
+ * \param offers what the display offers (Offers())
+ * \param base the index of the 2D mode that Kodi chose, by its own rules, for what it shows
+ * \param arrangement how Kodi draws the two eyes
+ *
+ * The refresh rate is the one of the mode that Kodi chose, always: nothing here changes the
+ * cadence.
+ *
+ * - Frame packing, when the eyes are drawn one above the other: each eye keeps all of its
+ *   lines. With the timing that Kodi chose or, where another size may be taken, with the
+ *   largest timing of that refresh rate that the display takes frame packed (HDMI has it for
+ *   1080p at 24 Hz and for 720p at 50 and 60 Hz: a 3D display that shows a 2160p desktop takes
+ *   3D films at 1080p).
+ * - Else the half layout that is drawn, with the timing that Kodi chose or, where another size
+ *   may be taken, with the largest timing of that refresh rate, not larger than the one Kodi
+ *   chose, that the display takes in that layout. By a mode where the driver has one, else by
+ *   the InfoFrame.
+ * - Else nothing: the 2D mode, in which the display shows the two halves as they are and is
+ *   switched to 3D by hand, as it always was.
+ */
+inline Choice Choose(std::span<const Offer> offers,
+                     int base,
+                     Arrangement arrangement,
+                     const Allowed& allowed)
+{
+  const auto found =
+      std::ranges::find_if(offers, [base](const Offer& offer) { return offer.base == base; });
+  if (base < 0 || found == offers.end())
+    return {};
+  const Offer& own = *found;
+
+  const auto sameRate = [&own](const Offer& offer)
+  { return offer.interlaced == own.interlaced && std::fabs(offer.refresh - own.refresh) < 0.01; };
+  const auto area = [](const Offer& offer) { return offer.width * offer.height; };
+
+  if (arrangement == Arrangement::TOP_AND_BOTTOM && allowed.framePacking && !own.interlaced)
+  {
+    if (own.framePacking >= 0)
+      return {Layout::FRAME_PACKING, own.base, own.framePacking, false};
+
+    if (allowed.otherSize)
+    {
+      const Offer* best = nullptr;
+      for (const Offer& offer : offers)
+      {
+        if (offer.framePacking >= 0 && sameRate(offer) && (!best || area(offer) > area(*best)))
+          best = &offer;
+      }
+      if (best)
+        return {Layout::FRAME_PACKING, best->base, best->framePacking, false};
+    }
+  }
+
+  const Layout layout = arrangement == Arrangement::TOP_AND_BOTTOM ? Layout::TOP_AND_BOTTOM
+                                                                  : Layout::SIDE_BY_SIDE_HALF;
+  const auto half = [&](const Offer& offer) -> Choice
+  {
+    const int mode =
+        arrangement == Arrangement::TOP_AND_BOTTOM ? offer.topAndBottom : offer.sideBySide;
+    if (allowed.halfModes && mode >= 0)
+      return {layout, offer.base, mode, false};
+
+    const bool told = arrangement == Arrangement::TOP_AND_BOTTOM ? offer.infoFrameTopAndBottom
+                                                                 : offer.infoFrameSideBySide;
+    if (allowed.infoFrame && told)
+      return {layout, offer.base, offer.base, true};
+    return {};
+  };
+
+  if (const Choice choice = half(own); choice.layout != Layout::NONE)
+    return choice;
+
+  if (allowed.otherSize)
+  {
+    const Offer* best = nullptr;
+    for (const Offer& offer : offers)
+    {
+      if (sameRate(offer) && area(offer) <= area(own) && half(offer).layout != Layout::NONE &&
+          (!best || area(offer) > area(*best)))
+        best = &offer;
+    }
+    if (best)
+      return half(*best);
+  }
+
+  return {};
+}
+
+/*!
+ * \brief Whether the eyes are to be drawn one above the other although they were asked for
+ * beside each other: where that gives frame packing, which no side-by-side drawing can be sent
+ * as. The picture is the same either way: each eye is cut from the source by the layout of the
+ * source, whatever the layout of the output.
+ */
+inline bool PrefersTopAndBottom(std::span<const Offer> offers, int base, const Allowed& allowed)
+{
+  return Choose(offers, base, Arrangement::TOP_AND_BOTTOM, allowed).layout ==
+         Layout::FRAME_PACKING;
+}
+
+/*!
+ * \brief The video format number of CTA-861 (VIC) of a 2D mode, of those HDMI has 3D for
+ * \return the number of its 16:9 form, or 0 for any other mode
+ *
+ * The EDID names the formats that a display takes in 3D by these numbers.
+ */
+inline uint8_t VicOf(const Mode& mode)
+{
+  if ((mode.flags & FLAG_DBLSCAN) != 0 || mode.vscan > 1)
+    return 0;
+
+  struct Rate
+  {
+    double nominal;
+    bool video; //!< it also comes as 1000/1001 of itself, which is the same format
+    uint8_t p720;
+    uint8_t p1080;
+    uint8_t i1080; //!< by its field rate
+  };
+  constexpr std::array<Rate, 5> RATES = {{{24.0, true, 60, 32, 0},
+                                          {25.0, false, 61, 33, 0},
+                                          {30.0, true, 62, 34, 0},
+                                          {50.0, false, 19, 31, 20},
+                                          {60.0, true, 4, 16, 5}}};
+
+  const double rate = RefreshRate(mode);
+  const bool interlaced = (mode.flags & FLAG_INTERLACE) != 0;
+  for (const Rate& row : RATES)
+  {
+    if (std::fabs(rate - row.nominal) >= 0.02 &&
+        !(row.video && std::fabs(rate - row.nominal * 1000.0 / 1001.0) < 0.02))
+      continue;
+
+    if (mode.hdisplay == 1280 && mode.vdisplay == 720 && !interlaced)
+      return row.p720;
+    if (mode.hdisplay == 1920 && mode.vdisplay == 1080)
+      return interlaced ? row.i1080 : row.p1080;
+  }
+  return 0;
+}
+
+/*!
+ * \brief What the EDID of a display says of 3D (HDMI 1.4, in its HDMI vendor block)
+ */
+struct Edid3D
+{
+  //! An HDMI vendor block was found and read: without one nothing is known, and nothing is
+  //! told to the display
+  bool read{false};
+  //! 3D_present: the display takes the formats that are mandatory for a 3D display (those
+  //! whose 2D format it has): 1080p at 24 Hz and 720p at 50 and 60 Hz frame packed and
+  //! top-and-bottom, 1080i at 50 and 60 Hz side-by-side (half)
+  bool present{false};
+
+  struct Format
+  {
+    uint8_t vic{0};
+    //! bit 0: frame packing, bit 6: top-and-bottom, bit 8: side-by-side (half)
+    uint16_t structures{0};
+  };
+  std::vector<Format> listed; //!< the formats that it lists with a 3D structure of their own
+};
+
+inline constexpr uint16_t STRUCTURE_FRAME_PACKING = 1u << 0;
+inline constexpr uint16_t STRUCTURE_TOP_AND_BOTTOM = 1u << 6;
+inline constexpr uint16_t STRUCTURE_SIDE_BY_SIDE_HALF = 1u << 8;
+
+/*!
+ * \brief Reads what an EDID says of 3D
+ * \param edid all of its blocks
+ *
+ * An EDID that cannot be read, or that has no HDMI vendor block, says nothing (Edid3D::read
+ * stays false). The fields are those of HDMI 1.4b, 8.3.2: 3D_present, 3D_Multi_present with
+ * 3D_Structure_ALL and 3D_MASK over the first sixteen video formats of the EDID, and the
+ * entries of 2D_VIC_order with a 3D_Structure of their own. Only frame packing, top-and-bottom
+ * and side-by-side (half) with horizontal sub-sampling are kept.
+ */
+inline Edid3D Parse(std::span<const uint8_t> edid)
+{
+  constexpr std::size_t BLOCK = 128;
+  constexpr std::array<uint8_t, 8> HEADER = {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00};
+
+  const auto sumsToZero = [](std::span<const uint8_t> block)
+  {
+    unsigned int sum = 0;
+    for (const uint8_t byte : block)
+      sum += byte;
+    return (sum & 0xFF) == 0;
+  };
+
+  Edid3D result;
+  if (edid.size() < 2 * BLOCK || !std::equal(HEADER.begin(), HEADER.end(), edid.begin()) ||
+      !sumsToZero(edid.first(BLOCK)))
+    return result;
+
+  // The video formats in the order of the EDID, and its HDMI vendor block (the first one): a
+  // 3D structure names a format by its place among them, wherever the vendor block comes.
+  std::vector<uint8_t> vics;
+  std::span<const uint8_t> hdmi;
+  for (std::size_t at = BLOCK; at + BLOCK <= edid.size(); at += BLOCK)
+  {
+    const std::span<const uint8_t> block = edid.subspan(at, BLOCK);
+    // a CTA-861 extension of revision 3: the one that has data blocks
+    if (block[0] != 0x02 || block[1] < 3 || !sumsToZero(block))
+      continue;
+
+    // the data blocks lie between byte 4 and the first detailed timing
+    const std::size_t end = std::min<std::size_t>(block[2], BLOCK - 1);
+    for (std::size_t i = 4; i < end;)
+    {
+      const unsigned int tag = block[i] >> 5;
+      const std::size_t length = block[i] & 0x1F;
+      if (i + 1 + length > end)
+        break;
+
+      if (tag == 2) // video data block
+      {
+        for (std::size_t n = 1; n <= length; ++n)
+        {
+          const uint8_t svd = block[i + n];
+          // (the formats 1 to 64 can carry a mark for "native" in their top bit)
+          vics.push_back((svd >= 1 && svd <= 64) || (svd >= 129 && svd <= 192) ? svd & 0x7F
+                                                                              : svd);
+        }
+      }
+      else if (tag == 3 && length >= 3 && hdmi.empty() && block[i + 1] == 0x03 &&
+               block[i + 2] == 0x0C && block[i + 3] == 0x00) // vendor block of HDMI Licensing
+      {
+        hdmi = block.subspan(i, 1 + length);
+      }
+      i += 1 + length;
+    }
+  }
+
+  if (hdmi.empty())
+    return result;
+  result.read = true;
+
+  // db[n] is byte n of the block, db[0] its header; the last byte is db[length]
+  const std::span<const uint8_t> db = hdmi;
+  const std::size_t length = db.size() - 1;
+  if (length < 8 || !(db[8] & 0x20)) // no HDMI_Video_present
+    return result;
+
+  // latency fields, when present, come before the 3D fields
+  std::size_t at = 9;
+  if (db[8] & 0x80)
+    at += db[8] & 0x40 ? 4 : 2;
+  if (at + 1 > length) // the byte of 3D_present and the one of the lengths
+    return result;
+
+  result.present = (db[at] & 0x80) != 0;
+  const unsigned int multi = result.present ? (db[at] & 0x60) >> 5 : 0;
+  ++at;
+  const std::size_t vicLength = db[at] >> 5;
+  const std::size_t length3D = db[at] & 0x1F;
+  at += 1 + vicLength; // past the lengths and the HDMI_VIC entries: the first byte of the 3D part
+
+  const std::size_t multiLength = multi == 1 ? 2 : multi == 2 ? 4 : 0;
+  if (length3D < multiLength || at + length3D > length + 1)
+    return result;
+
+  constexpr uint16_t KEPT =
+      STRUCTURE_FRAME_PACKING | STRUCTURE_TOP_AND_BOTTOM | STRUCTURE_SIDE_BY_SIDE_HALF;
+  const auto add = [&](std::size_t index, uint16_t structures)
+  {
+    structures &= KEPT;
+    if (index >= vics.size() || structures == 0)
+      return;
+    for (Edid3D::Format& format : result.listed)
+    {
+      if (format.vic == vics[index])
+      {
+        format.structures |= structures;
+        return;
+      }
+    }
+    result.listed.push_back({vics[index], structures});
+  };
+
+  if (multiLength > 0)
+  {
+    const uint16_t all = static_cast<uint16_t>(db[at] << 8 | db[at + 1]);
+    const uint16_t mask =
+        multi == 2 ? static_cast<uint16_t>(db[at + 2] << 8 | db[at + 3]) : uint16_t{0xFFFF};
+    for (std::size_t i = 0; i < 16; ++i)
+    {
+      if (mask & (1u << i))
+        add(i, all);
+    }
+  }
+  at += multiLength;
+
+  // 2D_VIC_order and 3D_Structure, with a second byte (3D_Detail) for the structures from 8 on
+  const std::size_t entries = length3D - multiLength;
+  for (std::size_t i = 0; i < entries; ++i)
+  {
+    const uint8_t entry = db[at + i];
+    const unsigned int structure = entry & 0x0F;
+    const bool detailed = structure >= 8;
+    if (detailed && i + 1 >= entries)
+      break;
+
+    if (structure == 0)
+      add(entry >> 4, STRUCTURE_FRAME_PACKING);
+    else if (structure == 6)
+      add(entry >> 4, STRUCTURE_TOP_AND_BOTTOM);
+    else if (structure == 8 && (db[at + i + 1] >> 4) == 1) // horizontal sub-sampling
+      add(entry >> 4, STRUCTURE_SIDE_BY_SIDE_HALF);
+
+    if (detailed)
+      ++i;
+  }
+
+  return result;
+}
+
+/*!
+ * \brief Whether the EDID says that the display takes a format in a 3D layout
+ * \param vic the format (VicOf()); 0 is none
+ */
+inline bool Supports(const Edid3D& edid, uint8_t vic, Layout layout)
+{
+  const uint16_t structure = layout == Layout::FRAME_PACKING       ? STRUCTURE_FRAME_PACKING
+                             : layout == Layout::TOP_AND_BOTTOM    ? STRUCTURE_TOP_AND_BOTTOM
+                             : layout == Layout::SIDE_BY_SIDE_HALF ? STRUCTURE_SIDE_BY_SIDE_HALF
+                                                                   : uint16_t{0};
+  if (!edid.read || vic == 0 || structure == 0)
+    return false;
+
+  if (edid.present)
+  {
+    if ((vic == 32 || vic == 4 || vic == 19) &&
+        (layout == Layout::FRAME_PACKING || layout == Layout::TOP_AND_BOTTOM))
+      return true;
+    if ((vic == 5 || vic == 20) && layout == Layout::SIDE_BY_SIDE_HALF)
+      return true;
+  }
+
+  return std::ranges::any_of(edid.listed, [vic, structure](const Edid3D::Format& format)
+                             { return format.vic == vic && (format.structures & structure); });
+}
+
+/*!
+ * \brief What a driver is given to send as the HDMI vendor InfoFrame of a half layout
+ */
+struct InfoFramePayload
+{
+  uint8_t size{0}; //!< 0: there is none for this layout
+  std::array<uint8_t, 6> bytes{};
+};
+
+/*!
+ * \brief The contents of the HDMI vendor InfoFrame that tells a display of a half layout
+ *
+ * From the registration number of HDMI Licensing (00-0C-03, its low byte first) on, without
+ * the header and the checksum, which the driver adds: HDMI_Video_Format 2 (a 3D format
+ * follows), then the 3D_Structure, 8 for side-by-side (half) and 6 for top-and-bottom. Only
+ * side-by-side (half) has a further byte, 3D_Ext_Data, 0 for horizontal sub-sampling.
+ *
+ * None for frame packing, which changes the timing: a driver that has it sends its InfoFrame
+ * with its mode, and one that is given these bytes sends them in place of its own.
+ */
+constexpr InfoFramePayload HalfLayoutInfoFrame(Layout layout)
+{
+  switch (layout)
+  {
+    case Layout::SIDE_BY_SIDE_HALF:
+      return {6, {0x03, 0x0C, 0x00, 0x40, 0x80, 0x00}};
+    case Layout::TOP_AND_BOTTOM:
+      return {5, {0x03, 0x0C, 0x00, 0x40, 0x60, 0x00}};
+    default:
+      return {};
+  }
+}
