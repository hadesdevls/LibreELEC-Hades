From e7a8ed44d6bf66468a19bccacf819d9cb2c92a2c Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 13 Oct 2026 03:55:42 -0700
Subject: [PATCH] [depends][python3] Disable dup3 and pipe2 on macOS

The macOS 27 SDK exposes these functions to configure link checks, but
Python calls them without availability guards. Disable their detection
for native and target macOS builds to preserve macOS 11 compatibility.
---
 tools/depends/native/python3/Makefile | 1 +
 tools/depends/target/python3/Makefile | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tools/depends/native/python3/Makefile b/tools/depends/native/python3/Makefile
index e4c0d66..1bcafc4 100644
--- a/tools/depends/native/python3/Makefile
+++ b/tools/depends/native/python3/Makefile
@@ -13,6 +13,7 @@ endif
 
 LIBDYLIB=$(PLATFORM)/python
 ifeq ($(NATIVE_OS), osx)
+    CONFIGURE += ac_cv_func_dup3=no ac_cv_func_pipe2=no
     # Case insensitive FS will add .exe to buildexe regardless of --with-suffix=no
 	LIBDYLIB=$(PLATFORM)/python.exe
 endif
diff --git a/tools/depends/target/python3/Makefile b/tools/depends/target/python3/Makefile
index a2bdee5..5483071 100644
--- a/tools/depends/target/python3/Makefile
+++ b/tools/depends/target/python3/Makefile
@@ -27,6 +27,7 @@ ifeq ($(findstring apple-darwin, $(HOST)), apple-darwin)
     export SDKROOT
   endif
   ifeq ($(OS), osx)
+    EXTRA_CONFIGURE+= ac_cv_func_dup3=no ac_cv_func_pipe2=no
     export SDKROOT
   endif
   # required for _localemodule
-- 
