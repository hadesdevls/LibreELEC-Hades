diff --git a/xbmc/settings/SettingConditions.cpp b/xbmc/settings/SettingConditions.cpp
index b292a27..d7598de 100644
--- a/xbmc/settings/SettingConditions.cpp
+++ b/xbmc/settings/SettingConditions.cpp
@@ -165,6 +165,15 @@ bool SupportsHDRYCbCr420Choice(const std::string& /*condition*/,
   return winSystem && winSystem->SupportsHDRYCbCr420Choice();
 }
 
+// Hades: the setting of Dolby Vision through the converter of the board, where the output has one
+bool SupportsDVConverterChoice(const std::string& /*condition*/,
+                               const std::string& /*value*/,
+                               const SettingConstPtr& /*setting*/)
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  return winSystem && winSystem->SupportsDVConverterChoice();
+}
+
 // Hades: the setting of the HDMI 1.4b Dolby Vision signalling, where the display asks for it
 bool SupportsDVHdmi14bChoice(const std::string& /*condition*/,
                              const std::string& /*value*/,
@@ -547,6 +556,7 @@ void CSettingConditions::Initialize()
   m_complexConditions.try_emplace("supportshdrdepthchoice", SupportsHDRDepthChoice);
   m_complexConditions.try_emplace("supportshdrmorebits", SupportsHDRMoreBits);
   m_complexConditions.try_emplace("supportsdvhdmi14b", SupportsDVHdmi14bChoice);
+  m_complexConditions.try_emplace("supportsdvconverter", SupportsDVConverterChoice);
   m_complexConditions.try_emplace("supportsdvmenus", SupportsDVMenusChoice);
   m_complexConditions.try_emplace("supportsdv", SupportsDVDisplay);
   m_complexConditions.try_emplace("ismasteruser", IsMasterUser);
