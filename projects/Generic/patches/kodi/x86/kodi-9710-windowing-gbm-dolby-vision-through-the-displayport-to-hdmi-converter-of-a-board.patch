+            <option label="41303">1</option> <!-- on -->
+            <option label="41304">2</option> <!-- off -->
+          </options>
+        </constraints>
+        <dependencies>
+          <dependency type="enable" setting="videoscreen.hadesdvnative" operator="is">true</dependency>
+          <dependency type="visible" on="property" name="supportsdvconverter"/>
+        </dependencies>
+        <control type="spinner" format="string" />
+      </setting>
