@@ -3522,6 +3522,30 @@
         </dependencies>
         <control type="toggle" />
       </setting>
+      <!-- Hades: shown only where the output is a DisplayPort connector that can carry the tunnel
+           through the converter of its board (the kernel's DVBRIDGE_DV_CONVERTER) -->
+      <setting id="videoscreen.hadesdvconverter" type="integer" label="41300" help="41301">
