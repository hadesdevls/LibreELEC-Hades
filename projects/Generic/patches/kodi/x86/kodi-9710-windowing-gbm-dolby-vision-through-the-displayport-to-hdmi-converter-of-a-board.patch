+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: Dolby Vision through the DisplayPort to HDMI converter that some boards have
+ *        between the graphics port and their HDMI socket (i915 and xe, linux-9999-pcon)
+ *
+ * Such a port is a DisplayPort connector for the driver, not an HDMI one, and native output was
+ * offered on HDMI connectors only. The kernel gives a DisplayPort connector of a port that can
+ * carry the tunnel through a converter the tunnel property (DVBRIDGE_DV_STANDARD_LAB) and
+ * DVBRIDGE_DV_CONVERTER, read only, with what it found behind the port: no converter that it
+ * takes, a converter that nobody has seen carry the Dolby vendor InfoFrame, a board that is on its
+ * list of those where that was seen working, or every converter taken as verified on the command
+ * line (dv_pcon=1). A converter that does not carry the vendor InfoFrame leaves the display
+ * without Dolby Vision, or without a picture, so the default is to offer it only where somebody
+ * has seen it work (the list is the kernel's); the user can ask for it anywhere (videoscreen.hadesdvconverter)
+ * or turn it off where the board is on the list.
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+namespace DV_CONVERTER
+{
+
+constexpr std::string_view PROPERTY = "DVBRIDGE_DV_CONVERTER";
+
+//! The setting videoscreen.hadesdvconverter
+enum class Use
+{
+  AUTO = 0, //!< a converter on the list of boards where it was seen working (or dv_pcon=1)
+  ON = 1, //!< any converter that the kernel takes: the user takes the risk
+  OFF = 2, //!< never: as before this existed
+};
+
+//! DVBRIDGE_DV_CONVERTER (the enum of the property, intel_dv_pcon_policy.h)
+enum class Verdict : uint64_t
+{
+  NONE = 0,
+  UNLISTED = 1,
+  LISTED = 2,
+  FORCED = 3,
+};
+
+inline Use UseOf(int setting)
+{
+  return setting == 1 ? Use::ON : setting == 2 ? Use::OFF : Use::AUTO;
+}
+
+//! What the policy decides for a connector
+struct Offer
+{
+  //! the policy applies at all: a DisplayPort connector that has the property
+  bool applies = false;
+  //! the tunnel is offered through it (where it applies)
+  bool offered = false;
+  //! the reason code of the Dolby Vision page of the player information when it is not
+  const char* code = "";
+  //! ... and in a sentence, for the log
+  const char* reason = "";
+};
+
+/*!
+ * \param use the setting
+ * \param displayPort the connector is a DisplayPort one (an HDMI one has no converter in the way)
+ * \param verdict the value of DVBRIDGE_DV_CONVERTER, nothing where the connector has no such
+ *        property (a kernel without it: what it said before stands, native output on whatever
+ *        connector has the tunnel property)
+ */
+inline Offer Decide(Use use, bool displayPort, const std::optional<uint64_t>& verdict)
+{
+  Offer offer;
+  if (!displayPort || !verdict)
+    return offer;
+  offer.applies = true;
+  const auto v = static_cast<Verdict>(*verdict > 3 ? 0 : *verdict);
+  if (use == Use::OFF)
+  {
+    offer.code = "converteroff";
+    offer.reason = "Dolby Vision through the converter of the board is turned off in the settings "
+                   "(System > Display)";
+    return offer;
+  }
+  if (v == Verdict::NONE)
+  {
+    offer.code = "converter";
+    offer.reason = "the display is on a connector that the driver calls DisplayPort, and no "
+                   "DisplayPort to HDMI converter that the driver takes is behind it (a DisplayPort "
+                   "or USB-C adapter, a converter that may go to FRL, or no converter); native "
+                   "output needs an HDMI connector or such a converter";
+    return offer;
+  }
+  if (use == Use::AUTO && v == Verdict::UNLISTED)
+  {
+    offer.code = "converterunlisted";
+    offer.reason = "a DisplayPort to HDMI converter is behind this port, and this board is not on "
+                   "the list of those where Dolby Vision was seen working through it; "
+                   "\"Dolby Vision through a display converter\" (System > Display) set to On tries "
+                   "it";
+    return offer;
+  }
+  offer.offered = true;
+  return offer;
+}
+
+//! What kodi.log says of the way in, for the status of native output
+inline std::string Way(Use use, const std::optional<uint64_t>& verdict)
+{
+  if (!verdict)
+    return {};
+  switch (static_cast<Verdict>(*verdict > 3 ? 0 : *verdict))
+  {
+    case Verdict::LISTED:
+      return ", through the DisplayPort to HDMI converter of the board (a board where it was seen "
+             "working)";
+    case Verdict::FORCED:
+      return ", through the DisplayPort to HDMI converter of the board (the kernel takes every "
+             "converter as verified: dv_pcon=1; not tried on this board)";
+    case Verdict::UNLISTED:
+      return use == Use::ON ? ", through the DisplayPort to HDMI converter of the board (nobody has "
+                              "seen it carry Dolby Vision; the setting is On)"
+                            : std::string();
+    default:
+      return {};
+  }
+}
+
+} // namespace DV_CONVERTER
+} // namespace KODI::WINDOWING::GBM
