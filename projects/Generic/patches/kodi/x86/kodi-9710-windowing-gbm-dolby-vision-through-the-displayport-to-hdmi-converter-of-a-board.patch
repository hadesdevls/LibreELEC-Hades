+// Hades: what the output says of the converter of its board (DVBRIDGE_DV_CONVERTER), once when the
+// output is taken: the setting for it is shown where the connector has the property
+void CWinSystemGbm::ReadDVConverterOutput(CDRMConnector& connector)
+{
+  const auto verdict = CDVBridgeState::ConverterVerdict(connector);
+  m_dvConverterChoice = verdict.has_value();
+  if (!verdict)
+    return;
+  static const char* const names[] = {"none", "unlisted", "listed", "forced"};
+  CLog::Log(LOGINFO,
+            "DVBridge: {} can carry Dolby Vision through the DisplayPort to HDMI converter of the "
+            "board (DVBRIDGE_DV_CONVERTER is {}): {}",
+            connector.GetName(), *verdict < 4 ? names[*verdict] : "unknown",
+            *verdict == 0 ? "no such converter is behind the port now"
+            : *verdict == 2 ? "the board is on the list of those where it was seen working: "
+                              "offered by default"
+            : *verdict == 3 ? "the kernel takes every converter as verified (dv_pcon=1): offered "
+                              "by default"
+                            : "offered only where \"Dolby Vision through a display converter\" is "
+                              "On, as nobody has seen it carry Dolby Vision on this board");
+}
+
+int CWinSystemGbm::DVConverterUse() const
+{
+  int use = m_dvConverterUse;
+  if (use < 0)
+  {
+    // not read yet (no video has started): as the setting says now (automatic where it is not there)
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    use = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVCONVERTER)
+              ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVCONVERTER)
+              : 0;
+    use = use == 1 || use == 2 ? use : 0;
+    if (settings)
+      m_dvConverterUse = use;
+  }
+  CDVBridgeState::SetConverterUse(DV_CONVERTER::UseOf(use));
+  return use;
+}
+#else
+void CWinSystemGbm::ReadDVConverterOutput(CDRMConnector&)
+{
+}
+
+int CWinSystemGbm::DVConverterUse() const
+{
+  return 0;
+}
