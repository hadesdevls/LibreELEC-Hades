index 820d1dc..0504f00 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -434,6 +434,9 @@ public:
   //! Hades: native Dolby Vision output at all (off: as on a display without it); from the next
   //! video
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVNATIVE = "videoscreen.hadesdvnative";
+  //! Hades: native output through the DisplayPort to HDMI converter of a board (i915 and xe): 0
+  //! automatic (boards where it was seen working), 1 on, 2 off; from the next video
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVCONVERTER = "videoscreen.hadesdvconverter";
   //! Hades: native output as Dolby Vision Low-Latency where the display offers no other (its game
   //! mode), mapped to the display by Hades; from the next video
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLOWLATENCY = "videoscreen.hadesdvlowlatency";
