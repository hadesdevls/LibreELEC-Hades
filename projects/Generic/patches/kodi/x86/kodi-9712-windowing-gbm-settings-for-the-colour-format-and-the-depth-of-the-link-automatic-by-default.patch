+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: the colour format and the bits of the link that the user chooses
+ *        (videoscreen.hadescolorformat, videoscreen.hadesmaxbpc)
+ *
+ * Linux 7.3 has a connector property "color format" (drm_connector_attach_color_format_property():
+ * AUTO, RGB, YUV 4:4:4, YUV 4:2:2, YUV 4:2:0), which amdgpu attaches to its HDMI and DisplayPort
+ * connectors (not MST ones); i915, xe and nvidia-drm do not have it. "max bpc" is the depth the
+ * drivers may use (i915, amdgpu, and nvidia-drm with the Hades patches).
+ *
+ * "Automatic" is what Hades does without the settings, byte for byte: nothing is added to any
+ * request for it, except that a connector that another program left on a format that is not AUTO
+ * (a compositor that had the display before Kodi) is put back to AUTO with the mode set that Kodi
+ * makes anyway.
+ *
+ * A choice goes out only in a request that sets a mode (a change of either is a mode set in the
+ * kernel: drm_atomic_helper_check_modeset(), connectors_changed). A mode that the driver cannot
+ * carry in the format or at the depth that the user chose must not stop the change of mode of a
+ * video: the request that the driver refuses is tested again without the choice (CDRMAtomic: a
+ * "soft" property), goes out as with Automatic, and the log says so. Native Dolby Vision, whose
+ * tunnel is RGB at 8 bits, sets AUTO and 8 itself and puts back what it found (CDVBridgeState).
+ *
+ * Nothing of DRM is here: a test runs it on the host.
+ */
+namespace OUTPUT_FORMAT
+{
+
+//! The property of the connector
+constexpr const char* PROPERTY = "color format";
+
+//! The values of the setting videoscreen.hadescolorformat
+enum class Format
+{
+  AUTO = 0,
+  RGB = 1,
+  YCBCR444 = 2,
+  YCBCR422 = 3,
+  YCBCR420 = 4,
+};
+
+constexpr int FORMAT_COUNT = 5;
+
+//! The name that the kernel gives the value of the property (drm_hdmi_connector_get_output_format_name())
+constexpr std::string_view KernelName(Format format)
+{
+  switch (format)
+  {
+    case Format::RGB:
+      return "RGB";
+    case Format::YCBCR444:
+      return "YUV 4:4:4";
+    case Format::YCBCR422:
+      return "YUV 4:2:2";
+    case Format::YCBCR420:
+      return "YUV 4:2:0";
+    case Format::AUTO:
+      break;
+  }
+  return "AUTO";
+}
+
+//! The name of the choice as the log says it
+constexpr std::string_view LogName(Format format)
+{
+  switch (format)
+  {
+    case Format::RGB:
+      return "RGB";
+    case Format::YCBCR444:
+      return "YCbCr 4:4:4";
+    case Format::YCBCR422:
+      return "YCbCr 4:2:2";
+    case Format::YCBCR420:
+      return "YCbCr 4:2:0";
+    case Format::AUTO:
+      break;
+  }
+  return "automatic";
+}
+
+//! A setting value as a format (anything that is not one of them: AUTO)
+constexpr Format FormatOfSetting(int value)
+{
+  return value >= 1 && value < FORMAT_COUNT ? static_cast<Format>(value) : Format::AUTO;
+}
+
+/*!
+ * \brief The value of "color format" to add to a request (nothing: leave it)
+ * \param modesetPending the request sets a mode (a change of the property needs one)
+ * \param nativeDV native Dolby Vision has the output: its transport owns the property
+ * \param chosen the value of the property for the choice of the user (AUTO is 0): nothing where the
+ *        connector has no value of that name, which the caller leaves to the kernel's
+ * \param kernel what the connector has now (what the last request that the driver took set), nothing
+ *        without the property
+ * \param hasProperty the connector has "color format"
+ * \param refusedForThisMode the driver refused this choice for the mode that the request carries:
+ *        it is not asked again for it (the request would go through a test that fails every time)
+ */
+inline std::optional<uint64_t> Stage(bool modesetPending,
+                                     bool nativeDV,
+                                     bool hasProperty,
+                                     std::optional<uint64_t> chosen,
+                                     std::optional<uint64_t> kernel,
+                                     bool refusedForThisMode)
+{
+  if (!hasProperty || !modesetPending || nativeDV || !chosen || !kernel)
+    return std::nullopt;
+  if (*chosen == *kernel)
+    return std::nullopt;
+  // (Automatic after another program left a format: put back whatever was asked)
+  if (refusedForThisMode && *chosen != 0)
+    return std::nullopt;
+  return *chosen;
+}
+
+//! The depths that the user can choose for "max bpc" (0: the drivers' choice)
+constexpr bool ValidBits(int bits)
+{
+  return bits == 0 || bits == 8 || bits == 10 || bits == 12;
+}
+
+/*!
+ * \brief The depth to ask for "max bpc", inside the range that the connector has
+ * \return 0 when the user chose none (the drivers' own choice stays: LinkDepth.h)
+ */
+constexpr uint64_t BitsWanted(int chosen, uint64_t minimum, uint64_t maximum)
+{
+  if (!ValidBits(chosen) || chosen == 0 || maximum < minimum)
+    return 0;
+  return std::clamp<uint64_t>(static_cast<uint64_t>(chosen), minimum, maximum);
+}
+
+//! What happens to "max bpc" with a request when the user chose a depth
+struct BitsStep
+{
+  //! the value to add to the request now; nothing: leave it
+  std::optional<uint64_t> maxBpc;
+  //! the depth goes out with the next request that sets a mode
+  bool waits = false;
+};
+
+/*!
+ * \param wanted BitsWanted() (not 0)
+ * \param current "max bpc" in the request being built, or else on the connector
+ * \param setsMode the request sets a mode (its head again): the first commit on an output, a change
+ *        of mode, a change of the HDR signalling
+ * \param refusedForThisMode the driver refused this depth for the mode of the request
+ */
+constexpr BitsStep BitsFor(uint64_t wanted, uint64_t current, bool setsMode, bool refusedForThisMode)
+{
+  if (wanted == 0 || wanted == current)
+    return {};
+  if (!setsMode)
+    return {std::nullopt, true};
+  if (refusedForThisMode)
+    return {};
+  return {wanted, false};
+}
+
+//! The request of a refused test goes out again without the choice: the value that stands for
+//! Automatic, where the request carries another one (nothing where it does not)
+constexpr std::optional<uint64_t> FormatWithout(std::optional<uint64_t> inRequest, uint64_t autoValue)
+{
+  if (!inRequest || *inRequest == autoValue)
+    return std::nullopt;
+  return autoValue;
+}
+
+} // namespace OUTPUT_FORMAT
+} // namespace KODI::WINDOWING::GBM
