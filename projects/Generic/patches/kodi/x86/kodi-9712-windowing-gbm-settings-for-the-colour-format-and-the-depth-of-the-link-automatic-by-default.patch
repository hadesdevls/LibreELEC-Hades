+// Hades: what the output offers of the colour format and the bits that the user can choose
+void CWinSystemGbm::ReadOutputFormat(CDRMConnector& connector)
+{
+  m_formatStaged.reset();
+  m_formatStagedKey.clear();
+  m_formatRefusedKey.clear();
+  m_formatToldKey.clear();
+  m_bitsStagedKey.clear();
+  m_bitsRefusedKey.clear();
+  m_outputFormatChoice = connector.SupportsProperty(OUTPUT_FORMAT::PROPERTY) &&
+                         connector.GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY, "AUTO");
+  const auto limits = connector.GetRangePropertyLimits("max bpc");
+  m_maxBitsChoice = limits && limits->second >= 8 && !m_hdrDepthChoice;
+  if (m_outputFormatChoice || m_maxBitsChoice)
+  {
+    const auto format = connector.ReadPropertyValue(OUTPUT_FORMAT::PROPERTY);
+    const auto name = format ? connector.GetPropertyEnumName(OUTPUT_FORMAT::PROPERTY, *format)
+                             : std::nullopt;
+    CLog::Log(LOGINFO,
+              "Output format: {}: the choice of the colour format is {}{}; the choice of the depth of "
+              "the link is {} (\"max bpc\" {} to {}); \"Automatic\" adds nothing to any request",
+              connector.GetName(), m_outputFormatChoice ? "there" : "not there (no \"color format\")",
+              name ? std::string(", the connector has \"") + *name + "\"" : std::string(),
+              m_maxBitsChoice ? "there" : "not there", limits ? limits->first : 0,
+              limits ? limits->second : 0);
+  }
+}
+
+std::string CWinSystemGbm::OutputModeKey() const
+{
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  return mode ? std::to_string(mode->hdisplay) + "x" + std::to_string(mode->vdisplay) + "@" +
+                    std::to_string(mode->clock)
+              : std::string("none");
+}
+
+void CWinSystemGbm::StageOutputFormat()
+{
+  m_formatStaged.reset();
+  if (!m_outputFormatChoice)
+    return;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!connector || !settings)
+    return;
+  const auto format = OUTPUT_FORMAT::FormatOfSetting(
+      settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESCOLORFORMAT));
+  const auto chosen = connector->GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY,
+                                                      OUTPUT_FORMAT::KernelName(format));
+  const std::string key = OutputModeKey() + ":" + std::to_string(static_cast<int>(format));
+  const auto value =
+      OUTPUT_FORMAT::Stage(drm->ModesetPending(), NativeDVOutputInUse(), true, chosen,
+                           connector->GetPropertyValue(OUTPUT_FORMAT::PROPERTY),
+                           m_formatRefusedKey == key);
+  const auto autoValue = connector->GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY, "AUTO");
+  if (value && autoValue && drm->AddSoftProperty(connector, OUTPUT_FORMAT::PROPERTY, *value, *autoValue))
+  {
+    m_formatStaged = value;
+    m_formatStagedKey = key;
+  }
+}
+
+void CWinSystemGbm::OutputFormatCommitted()
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return;
+  for (const auto& [name, value] : drm->TakeSoftRefused())
+  {
+    if (name == OUTPUT_FORMAT::PROPERTY)
+    {
+      m_formatRefusedKey = m_formatStagedKey;
+      CLog::Log(LOGWARNING,
+                "Output format: the driver refused the colour format of the setting ({}) for {}: "
+                "this mode goes out as with \"Automatic\", and it is not asked for again in it",
+                connector->GetPropertyEnumName(OUTPUT_FORMAT::PROPERTY, value).value_or("?"),
+                OutputModeKey());
+    }
+    else if (name == "max bpc")
+    {
+      m_bitsRefusedKey = m_bitsStagedKey;
+      CLog::Log(LOGWARNING,
+                "Output depth: the driver refused \"max bpc\" {} of the setting for {}: this mode "
+                "goes out as with \"Automatic\", and it is not asked for again in it",
+                value, OutputModeKey());
+    }
+  }
+  if (m_formatStaged && m_formatStagedKey != m_formatToldKey &&
+      connector->GetPropertyValue(OUTPUT_FORMAT::PROPERTY) == m_formatStaged)
+  {
+    m_formatToldKey = m_formatStagedKey;
+    CLog::Log(LOGINFO,
+              "Output format: {} goes out with the colour format \"{}\" ({} of the setting); the "
+              "kernel log says how the link goes",
+              connector->GetName(),
+              connector->GetPropertyEnumName(OUTPUT_FORMAT::PROPERTY, *m_formatStaged).value_or("?"),
+              OutputModeKey());
+  }
+  m_formatStaged.reset();
+}
