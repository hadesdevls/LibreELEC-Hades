+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -27304,3 +27304,81 @@ msgstr ""
 msgctxt "#41304"
 msgid "Off"
 msgstr ""
+
+#. Hades: label of setting "videoscreen.hadescolorformat"; translated in Estuary (#32910)
+#: system/settings/settings.xml
+msgctxt "#41310"
+msgid "Colour format"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadescolorformat"; translated in Estuary (#32911)
+#: system/settings/settings.xml
+msgctxt "#41311"
+msgid "The colour format that the graphics card sends to the display, where the driver lets Kodi choose it (AMD graphics). Automatic is what LibreELEC Hades does without this setting. A format that the driver cannot carry in a mode (for example YCbCr 4:4:4 at 3840x2160 and 60 Hz over HDMI 2.0) goes out as Automatic in that mode, and the log says so. Dolby Vision always goes out as RGB at 8 bits. Applies with the next change of mode, or the next video that signals HDR."
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadescolorformat"; translated in Estuary (#32912)
+#: system/settings/settings.xml
+msgctxt "#41312"
+msgid "Automatic"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadescolorformat"; translated in Estuary (#32913)
+#: system/settings/settings.xml
+msgctxt "#41313"
+msgid "RGB"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadescolorformat"; translated in Estuary (#32914)
+#: system/settings/settings.xml
+msgctxt "#41314"
+msgid "YCbCr 4:4:4"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadescolorformat"; translated in Estuary (#32915)
+#: system/settings/settings.xml
+msgctxt "#41315"
+msgid "YCbCr 4:2:2"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadescolorformat"; translated in Estuary (#32916)
+#: system/settings/settings.xml
+msgctxt "#41316"
+msgid "YCbCr 4:2:0"
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesmaxbpc"; translated in Estuary (#32917)
+#: system/settings/settings.xml
+msgctxt "#41317"
+msgid "Maximum bit depth"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesmaxbpc"; translated in Estuary (#32918)
+#: system/settings/settings.xml
+msgctxt "#41318"
+msgid "The most bits per colour component that the link to the display may carry, where Kodi can set it (not on NVIDIA graphics, which have their own setting for HDR). Automatic leaves the choice to the driver. A depth that the driver cannot carry in a mode goes out as Automatic in that mode, and the log says so. Dolby Vision always goes out at 8 bits. Applies with the next change of mode, or the next video that signals HDR."
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesmaxbpc"; translated in Estuary (#32919)
+#: system/settings/settings.xml
+msgctxt "#41319"
+msgid "Automatic"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesmaxbpc"; translated in Estuary (#32920)
+#: system/settings/settings.xml
+msgctxt "#41320"
+msgid "8 bits"
+msgstr ""
+
+#. Hades: value of setting "videoscreen.hadesmaxbpc"; translated in Estuary (#32921)
+#: system/settings/settings.xml
+msgctxt "#41321"
+msgid "10 bits"
+msgstr ""
