+ */
+
+#pragma once
+
+#include <cmath>
+
+namespace KODI::RENDERQUEUE
+{
+
+/*!
+ * \brief Hades: the offset of the frames from the refreshes that the clock sync of the render
+ *        manager finds (CRenderManager::PrepareNextRender(), m_syncOffset), from its samples
+ *
+ * With the clock sync on (a refresh rate that is a whole multiple of the frame rate), the render
+ * manager takes at every refresh a sample of fmod(renderPts - nextFramePts, frametime) and, every
+ * WINDOW samples, their mean. It chooses the frames by it (renderPts += frametime / 2 - mean) and
+ * moves the clock that the audio engine follows by it (SetVsyncAdjust(-mean)): the sound goes with
+ * the refreshes the frames are shown at.
+ *
+ * The samples are of a quantity that goes round, and fmod takes the sign of what it divides: one
+ * offset is sampled on two branches a period apart. Kodi averages them as plain numbers, which
+ * gives a mixture that is no offset at all:
+ *  - where the frames come every second or fifth refresh (25 fps at 50 Hz, 29.97 at 59.94,
+ *    23.976 at 119.88), the refreshes that show no new frame sample the offset a period below the
+ *    others whenever it is above zero;
+ *  - where it is near a whole period (an offset that drifts with a clock that is not the
+ *    display's, the default without "Sync playback to display", gets there in time), the samples
+ *    fall on either side of it.
+ * The frames are then chosen at a refresh that the offset does not say, and the sound follows an
+ * offset that is not there: with "Sync playback to display" it is moved to it (resampled), without
+ * it the player's clock is moved by whole frames once the error it seems to have passes its limit.
+ *
+ * Here each sample is taken on the branch nearest a reference before it is averaged, so that the
+ * mean is the middle of the samples. The reference is the first sample, on its branch nearest
+ * zero (where the frames are chosen while the clock sync has no mean yet: renderPts = clock +
+ * latency + frametime / 2), and then the mean of each window, brought back within a period of zero
+ * (the range of fmod) so that an offset that drifts round does not take it away; it is kept
+ * between windows, so the branch does not change from one window to the next. Samples on one
+ * branch near the reference (a new frame at every refresh, an offset away from a whole period)
+ * give the very mean that Kodi takes.
+ *
+ * This class only counts; a test builds it on the host.
+ */
+class CVsyncPhase
+{
+public:
+  //! As Kodi: the mean of each window of this many samples
+  static constexpr int WINDOW = 31;
+
+  void Reset()
+  {
+    m_sum = 0.0;
+    m_count = 0;
+    m_reference = 0.0;
+    m_referenced = false;
+  }
+
+  /*!
+   * \brief A sample, fmod(renderPts - nextFramePts, frametime) as the render manager takes it
+   * \return true when it completes a window, with the mean of the window in mean
+   */
+  bool Add(double sample, double frametime, double& mean)
+  {
+    if (!(frametime > 0.0) || !std::isfinite(sample))
+      return false;
+    if (!m_referenced)
+    {
+      m_reference = sample - frametime * std::round(sample / frametime);
+      m_referenced = true;
+    }
+    sample -= frametime * std::round((sample - m_reference) / frametime);
+    m_sum += sample;
+    if (++m_count < WINDOW)
+      return false;
+    mean = m_sum / m_count;
+    m_sum = 0.0;
+    m_count = 0;
+    m_reference = mean;
+    if (m_reference > frametime)
+      m_reference -= frametime;
+    else if (m_reference <= -frametime)
+      m_reference += frametime;
+    return true;
+  }
+
+private:
+  double m_sum = 0.0;
+  int m_count = 0;
+  double m_reference = 0.0;
+  bool m_referenced = false;
+};
+
+} // namespace KODI::RENDERQUEUE
