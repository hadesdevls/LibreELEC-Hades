From 8126451026af30a1cb81208dcabc3d97a9b6407c Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Wed, 21 Oct 2026 10:43:37 +0200
Subject: [PATCH] [FileItemList] Leave the sort order of an added sort method
 to the view

CFileItemList::AddSortMethod() created its sort description with the
default ascending order, so the view never applied its own default
order per method. Sorting a plugin listing by date therefore started
with the oldest items, while Kodi's own windows start with the newest.
The same holds for sorting RSS, UPnP and Blu-ray listings by date or
size.

(cherry picked from commit cf3582c7bfcc6ee6c4b219ecc24daee6e07a40d3)
---
 xbmc/FileItemList.cpp      |  2 ++
 xbmc/test/TestFileItem.cpp | 12 ++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/xbmc/FileItemList.cpp b/xbmc/FileItemList.cpp
index d5f83f1..1a3f8c6 100644
--- a/xbmc/FileItemList.cpp
+++ b/xbmc/FileItemList.cpp
@@ -1071,6 +1071,8 @@ void CFileItemList::AddSortMethod(SortBy sortBy,
   SortDescription sorting;
   sorting.sortBy = sortBy;
   sorting.sortAttributes = sortAttributes;
+  // Left to the view, which sorts e.g. by date descending by default
+  sorting.sortOrder = SortOrder::NONE;
 
   AddSortMethod(sorting, buttonLabel, labelMasks);
 }
diff --git a/xbmc/test/TestFileItem.cpp b/xbmc/test/TestFileItem.cpp
index 340bb25..8973d0f 100644
--- a/xbmc/test/TestFileItem.cpp
+++ b/xbmc/test/TestFileItem.cpp
@@ -1544,3 +1544,15 @@ TEST(TestFileItemIsSamePath, OriginalListItemUrlIsTheIdentity)
   EXPECT_TRUE(Same(resolved, MakeItem("plugin://source/item/1")));
   EXPECT_FALSE(Same(resolved, MakeItem("plugin://source/item/2")));
 }
+
+TEST(TestFileItemList, AddSortMethodLeavesTheSortOrderToTheView)
+{
+  CFileItemList items;
+  items.AddSortMethod(SortBy::DATE, 552, LABEL_MASKS());
+  items.AddSortMethod(SortBy::LABEL, SortAttributeNone, 551, LABEL_MASKS());
+
+  const auto& details = items.GetSortDetails();
+  ASSERT_EQ(2u, details.size());
+  for (const auto& sort : details)
+    EXPECT_EQ(SortOrder::NONE, sort.m_sortDescription.sortOrder);
+}
