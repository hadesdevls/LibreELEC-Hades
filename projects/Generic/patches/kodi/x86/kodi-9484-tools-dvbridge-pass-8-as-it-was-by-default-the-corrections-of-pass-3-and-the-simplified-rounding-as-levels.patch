-    return r && r->source_packer && dvbridge_source_simplified(r->source_packer);
+    return r ? r->gui_drawn : 0;
+}
+
+void dvbridge_render_gui_release(struct dvbridge_renderer *r)
+{
+    if (r)
+        dvbridge_source_gui_release(r->source_packer);
+}
+
+void dvbridge_render_gui_targets(const struct dvbridge_renderer *r, unsigned names[2])
+{
