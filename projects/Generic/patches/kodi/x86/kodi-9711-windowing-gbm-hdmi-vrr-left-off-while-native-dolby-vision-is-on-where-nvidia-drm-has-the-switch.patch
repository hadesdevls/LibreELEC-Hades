From 79694e0dfd6fff7d661173a862c40e46e9f6c1a7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:04:09 +0000
Subject: [PATCH] windowing/gbm: HDMI VRR left off while native Dolby Vision is
 on, where nvidia-drm has the switch

NVKMS turns HDMI VRR on in every mode set of 50 Hz and up on a display that declares it, and
sends the EMP of HDMI VRR with every frame although Kodi never flips with VRR. Kodi left it off
(NV_HDMI_VRR_OFF) only for HDR10+. Native Dolby Vision now captures the property with the
rest of the state of its transport, sets 1 with it and puts the original back with its end;
the property is not required (nvidia-drm gives it to Turing and Ampere only, where it frees the
InfoFrame slot), so Ada and Blackwell are as before. While native Dolby Vision has the output,
the staging of HDMI VRR for HDR10+ does not put a 0 over the transport's 1. amdgpu already had
VRR_ENABLED captured and refuses the tunnel with VRR on; i915 gives no HDMI connector VRR
(intel_vrr_is_capable()).

Promise of issue 4 ("Dolby Vision goes out with HDMI VRR off where the driver lets Kodi turn
it off"). Host test of Stage() in both directions (8 checks, and a mutation it catches). Not
tried on hardware: a Turing or Ampere card with a DV display that declares HDMI VRR.
---
 xbmc/windowing/gbm/HdmiVrrOff.h          | 12 ++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.cpp      |  3 ++-
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 12 ++++++++++++
 3 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/HdmiVrrOff.h b/xbmc/windowing/gbm/HdmiVrrOff.h
index a1d1dcc..2e431e9 100644
--- a/xbmc/windowing/gbm/HdmiVrrOff.h
+++ b/xbmc/windowing/gbm/HdmiVrrOff.h
@@ -39,6 +39,12 @@ namespace GBM
  * which changes nothing that Kodi uses (the display does not get the EMP of VRR). A test of the
  * request that fails with it is made again without it and without the HDR10+ payload (Without()):
  * the video then goes out as it would without this, as HDR10, and the log says so.
+ *
+ * Native Dolby Vision leaves it off too, with the rest of the state of its transport
+ * (CDVBridgeState: the property is captured, set to 1 with the transport and put back with its
+ * end): the EMP of HDMI VRR would go out beside the Dolby InfoFrame in every mode of 50 Hz and up on
+ * a display that declares HDMI VRR, and Kodi never flips with VRR. While native Dolby Vision has the
+ * output, nothing here stages it (Stage(): nativeDV).
  */
 class CHdmiVrrOff
 {
@@ -84,9 +90,11 @@ public:
    */
   static std::optional<uint64_t> Stage(bool modesetPending,
                                        bool wanted,
-                                       std::optional<uint64_t> kernel)
+                                       std::optional<uint64_t> kernel,
+                                       bool nativeDV = false)
   {
-    if (!modesetPending || !kernel)
+    // (native Dolby Vision owns the property for as long as it has the output)
+    if (nativeDV || !modesetPending || !kernel)
       return std::nullopt;
     const uint64_t want = wanted ? 1 : 0;
     if (*kernel == want)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index cca9bce..b7c976e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -3761,7 +3761,8 @@ void CWinSystemGbm::StageHdmiVrrOff()
     return;
   }
   const auto value = CHdmiVrrOff::Stage(drm->ModesetPending(), m_hdmiVrrOffWanted,
-                                        connector->GetPropertyValue(CHdmiVrrOff::PROPERTY));
+                                        connector->GetPropertyValue(CHdmiVrrOff::PROPERTY),
+                                        NativeDVOutputInUse());
   if (value && drm->AddProperty(connector, CHdmiVrrOff::PROPERTY, *value))
     m_hdmiVrrOffStaged = value;
 }
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index 403e05b..e30c422 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -3,6 +3,7 @@
 
 #include "NvidiaDualMode.h"
 #include "windowing/gbm/HDR10PlusOutput.h"
+#include "windowing/gbm/HdmiVrrOff.h"
 #include "DRMAtomic.h"
 #include "DRMConnector.h"
 
@@ -320,6 +321,9 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
     // bpc, the default colorimetry and no HDR metadata)
     if ((lowLatency && !save(connector, "NV_HDMI_DV_LOW_LATENCY", 1, true, false)) ||
         (hdmi14b && !save(connector, "NV_HDMI_DV_HDMI14B", 1, true, false)) ||
+        // Hades: HDMI VRR left off while the transport is on, where nvidia-drm has the property
+        // (Turing and Ampere: CHdmiVrrOff); not required, and put back with the end of the transport
+        !save(connector, CHdmiVrrOff::PROPERTY, 1, false, false) ||
         !save(connector, "HDR_OUTPUT_METADATA", 0, true, true) ||
         !save(connector, "max bpc", 8, true, false) ||
         !save(connector, "dithering mode", 0, true, false, "off") ||
@@ -396,8 +400,16 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
   // Hades: what the driver said of an earlier native output is not about this one
   drm.ClearDVRefused();
   for (const auto& property : m_saved)
+  {
     CLog::Log(LOGDEBUG, "DVBridge: capture object={} property={} original={} transport={}",
               property.object->GetId(), property.name, property.original, property.transport);
+    if (property.name == CHdmiVrrOff::PROPERTY)
+      CLog::Log(LOGINFO,
+                "DVBridge: HDMI VRR is left off while Dolby Vision is on ({} 1, it had {}): the "
+                "display gets no EMP of HDMI VRR beside the Dolby InfoFrame; the end of native "
+                "output puts it back",
+                CHdmiVrrOff::PROPERTY, property.original);
+  }
   CLog::Log(LOGDEBUG,
             "DVBridge: output state captured connector={} crtc={} plane={} properties={} "
             "low_latency={} hdmi14b={}",
-- 
2.53.0

