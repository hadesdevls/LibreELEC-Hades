+/*!
+ * \brief The text subtitle packets decoded since the last flush, by their times and bytes: a line
+ *        that a search after a seek found in the file (SubtitleSeekSearch.h) and that the demuxer
+ *        reads too, or that the memory gave back, is decoded once, whichever comes first.
+ */
+class CSubtitleSeekSeen
+{
+public:
+  static constexpr size_t MAX_PACKETS = 1024; //!< since the flush; the oldest is forgotten first
+
+  //! True if a packet with these times and bytes was decoded since Clear(); if not, it is noted
+  bool SeenOrNote(double pts, double duration, const uint8_t* data, size_t size)
+  {
+    const Key key{pts, duration, size, Hash(data, size)};
+    for (const Key& k : m_keys)
+    {
+      if (k.pts == key.pts && k.duration == key.duration && k.size == key.size &&
+          k.hash == key.hash)
+        return true;
+    }
+    m_keys.push_back(key);
+    if (m_keys.size() > MAX_PACKETS)
+      m_keys.pop_front();
+    return false;
+  }
+
+  void Clear() { m_keys.clear(); }
+  size_t Size() const { return m_keys.size(); }
+
+private:
+  struct Key
+  {
+    double pts;
+    double duration;
+    size_t size;
+    uint64_t hash;
+  };
+
+  //! FNV-1a, 64 bits
+  static uint64_t Hash(const uint8_t* data, size_t size)
+  {
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (size_t i = 0; data && i < size; i++)
+    {
+      h ^= data[i];
+      h *= 0x100000001b3ULL;
+    }
+    return h;
+  }
+
+  std::deque<Key> m_keys;
+};
