+bool CDVDDemuxFFmpeg::GetMatroskaStream(int streamId, MatroskaStream& out)
+{
+  std::unique_lock lock(m_critSection);
+  if (!m_pFormatContext || !m_pInput || !m_bMatroska || m_checkTransportStream || m_bSup ||
+      std::dynamic_pointer_cast<CDVDInputStream::IMenus>(m_pInput))
+    return false;
+  CDemuxStream* stream = GetStream(streamId);
+  if (!stream || stream->type != StreamType::SUBTITLE)
+    return false;
+  // the streams of the file's tracks come first (matroska_parse_tracks()), its attachments after
+  unsigned tracks = 0;
+  while (tracks < m_pFormatContext->nb_streams &&
+         m_pFormatContext->streams[tracks]->codecpar->codec_type != AVMEDIA_TYPE_ATTACHMENT &&
+         !(m_pFormatContext->streams[tracks]->disposition & AV_DISPOSITION_ATTACHED_PIC))
+    tracks++;
+  for (unsigned i = 0; i < tracks; i++)
+  {
+    const AVStream* st = m_pFormatContext->streams[i];
+    if (st != stream->pPrivate)
+      continue;
+    out.index = i;
+    out.trackStreams = tracks;
+    out.timeBaseNum = st->time_base.num;
+    out.timeBaseDen = st->time_base.den;
+    // as ConvertTimestamp() takes it off for an input stream without menus
+    out.startTime = m_pFormatContext->start_time != static_cast<int64_t>(AV_NOPTS_VALUE)
+                        ? static_cast<double>(m_pFormatContext->start_time) / AV_TIME_BASE
+                        : 0.0;
+    return true;
+  }
+  return false;
+}
