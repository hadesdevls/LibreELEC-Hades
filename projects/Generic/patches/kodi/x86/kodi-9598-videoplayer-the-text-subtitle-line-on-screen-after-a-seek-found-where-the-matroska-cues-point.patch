+namespace
+{
+using namespace std::chrono_literals;
+using Clock = std::chrono::steady_clock;
+
+//! Kodi is closing: every search stops, and none starts
+std::atomic<bool> g_closing{false};
+
+//! The threads of the searches that have not ended. Never freed, so that a thread that outlives
+//! StopSearches() does not touch a freed object when it ends.
+struct InFlight
+{
+  std::mutex lock;
+  std::condition_variable ended;
+  int threads = 0;
+};
+
+InFlight& Threads()
+{
+  static InFlight* threads = new InFlight;
+  return *threads;
+}
+
+enum class Kind
+{
+  NONE, //!< not searched: neither on this device, the local network nor over HTTP
+  LOCAL, //!< this device
+  LAN, //!< a file server of the local network (SMB, NFS...)
+  LAN_HTTP, //!< HTTP to an address of the local network
+  INTERNET, //!< HTTP over the internet
+};
+
+const char* Name(Kind k)
+{
+  switch (k)
+  {
+    case Kind::LOCAL:
+      return "on this device";
+    case Kind::LAN:
+      return "on the local network";
+    case Kind::LAN_HTTP:
+      return "over HTTP on the local network";
+    case Kind::INTERNET:
+      return "over the internet";
+    default:
+      return "not searched";
+  }
+}
+
+// What a search may read, by where the file is (measured on files made for the test: with the
+// cues of the track, 1 to 4 reads of 4 KiB; a walk of the 30 s before the target, about 1700
+// reads and 7 MB; the clusters of the 10 s before the one the player reads from, 46 MB)
+struct Limits
+{
+  MKV_SUBSEEK::Budget budget;
+  double window = 30.0; //!< s before the target a line without a known end may start
+  std::chrono::milliseconds deadline{2000};
+  int64_t recvSpeed = 0; //!< bytes/s, over HTTP (0: as fast as it comes)
+};
+
+Limits LimitsFor(Kind kind, uint32_t readRate)
+{
+  Limits l;
+  MKV_SUBSEEK::Budget& b = l.budget;
+  switch (kind)
+  {
+    case Kind::LOCAL:
+      b.maxBytes = 32 << 20;
+      b.maxFetches = 4000;
+      b.chunk = 4096;
+      b.walk = true;
+      b.maxIndexBytes = 32 << 20;
+      l.window = 30.0;
+      l.deadline = 2000ms;
+      break;
+    case Kind::LAN:
+    case Kind::LAN_HTTP:
+      // a read on a local network costs a round trip (about a millisecond): fewer, larger
+      b.maxBytes = 16 << 20;
+      b.maxFetches = 1500;
+      b.chunk = 16384;
+      b.walk = true;
+      b.maxIndexBytes = 16 << 20;
+      l.window = 15.0;
+      l.deadline = 3000ms;
+      break;
+    case Kind::INTERNET:
+      // a request costs a round trip (40 ms and more) and is shared with the player's own: two for
+      // each line, no walk; without cues for the track, one range of at most what the player read
+      // in a second before the seek, taken at a quarter of that rate
+      b.maxFetches = 12;
+      b.chunk = 4096;
+      b.walk = false;
+      b.wholeRange = readRate ? std::min<int64_t>(8 << 20, readRate) : 0;
+      b.maxBytes = (1 << 20) + b.wholeRange;
+      b.maxIndexBytes = 8 << 20;
+      l.window = 10.0;
+      l.deadline = b.wholeRange ? 6000ms : 4000ms;
+      l.recvSpeed = readRate / 4;
+      break;
+    default:
+      break;
+  }
+  return l;
+}
+
+Kind Classify(const std::string& path)
+{
+  if (path.empty() || URIUtils::IsPlugin(path))
+    return Kind::NONE;
+  const CURL url(path);
+  const std::string protocol = url.GetTranslatedProtocol();
+  const bool lan = URIUtils::IsLocalOrLAN(path);
+  if (protocol == "http" || protocol == "https")
+    return lan ? Kind::LAN_HTTP : Kind::INTERNET;
+  if (!lan)
+    return Kind::NONE;
+  return URIUtils::IsHD(path) ? Kind::LOCAL : Kind::LAN;
+}
+
+// The file through XFILE::CFile (this device, the local network): a handle of its own
+class FileSource : public MKV_SUBSEEK::ByteSource
+{
+public:
+  bool Open(const std::string& path)
+  {
+    return m_file.Open(path, XFILE::READ_TRUNCATED | XFILE::READ_NO_CACHE);
+  }
+  int64_t Length() { return m_file.GetLength(); }
+  void SetStop(std::function<bool()> stop) { m_stop = std::move(stop); }
+
+  bool Fetch(int64_t offset, int64_t length, std::string& out) override
+  {
+    out.assign(static_cast<size_t>(length), '\0');
+    if (m_stop && m_stop())
+      return false;
+    if (m_file.Seek(offset, SEEK_SET) != offset)
+      return false;
+    int64_t done = 0;
+    while (done < length)
+    {
+      if (m_stop && m_stop())
+        return false;
+      // at most 64 KiB a read: a file server's client is held for the whole of one (SMB)
+      const ssize_t n = m_file.Read(out.data() + done,
+                                    static_cast<size_t>(std::min<int64_t>(length - done, 65536)));
+      if (n <= 0)
+        return false;
+      done += n;
+    }
+    return true;
+  }
+
+private:
+  XFILE::CFile m_file;
+  std::function<bool()> m_stop;
+};
+
+// The curl session of a server, as MatroskaEditionChoice.cpp takes it (DllLibCurlGlobal keeps
+// sessions by protocol and server, and the connections in their multi handle), with the options
+// of any request of Kodi's: user agent, proxy, certificates, the headers of the path. The player
+// holds its own session while it plays: this is another one, released (idle) when destroyed.
+// (DllLibCurlGlobal::easy_release() resets the session's options: the speed limit goes with it.)
+class CSearchCurl : public XFILE::CCurlFile
+{
+public:
+  bool Acquire(const std::string& path)
+  {
+    CURL url(path);
+    ParseAndCorrectUrl(url);
+    g_curlInterface.easy_acquire(url.GetProtocol().c_str(), url.GetHostName().c_str(),
+                                 &m_state->m_easyHandle, &m_state->m_multiHandle);
+    if (!m_state->m_easyHandle || !m_state->m_multiHandle)
+      return false;
+    SetCommonOptions(m_state);
+    SetRequestHeaders(m_state);
+    return true;
+  }
+  void LimitSpeed(int64_t bytesPerSecond)
+  {
+    curl_easy_setopt(m_state->m_easyHandle, CURLOPT_MAX_RECV_SPEED_LARGE,
+                     static_cast<curl_off_t>(bytesPerSecond));
+  }
+  CURL_HANDLE* Easy() const { return m_state->m_easyHandle; }
+  CURLM* Multi() const { return m_state->m_multiHandle; }
+};
+
+void LowerPriority()
+{
+#if defined(TARGET_LINUX)
+  // the lowest CPU priority for this thread, and the idle I/O class (IOPRIO_WHO_PROCESS with 0:
+  // this thread; IOPRIO_CLASS_IDLE): what the player reads comes first where the scheduler of the
+  // disk keeps classes
+  const auto tid = static_cast<id_t>(syscall(SYS_gettid));
+  setpriority(PRIO_PROCESS, tid, 19);
+  syscall(SYS_ioprio_set, 1, 0, 3 << 13);
+#endif
+}
+
+int64_t Ms(Clock::time_point from)
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - from).count();
+}
+
+std::string Cost(int reads, int64_t bytes, int64_t ms)
+{
+  return std::to_string(reads) + " read(s), " + std::to_string(bytes) + " bytes, " +
+         std::to_string(ms) + " ms";
+}
+
+//! ", from S s": where a walk started, in the player's time
+std::string From(int64_t fileTime, uint64_t timeScale, double startTime)
+{
+  char text[64];
+  std::snprintf(text, sizeof(text), ", from %.3f s",
+                static_cast<double>(fileTime) * static_cast<double>(timeScale) / 1e9 - startTime);
+  return text;
+}
+
+// The packet FFmpeg's demuxer makes of the block (MatroskaSubtitlePacket.h), as
+// CDVDDemuxFFmpeg::ReadInternal() makes a DemuxPacket of one
+DemuxPacket* MakePacket(const MKV_SUBSEEK::Index& ix,
+                        const MKV_SUBSEEK::Track& track,
+                        const MKV_SUBSEEK::Block& block,
+                        const CSubtitleSeekSearch::Target& t)
+{
+  AVPacket* av = av_packet_alloc();
+  if (!av)
+    return nullptr;
+  AVRational timeBase{};
+  DemuxPacket* pkt = nullptr;
+  if (MKV_SUBSEEK::DemuxMiniFile(MKV_SUBSEEK::MiniFile(ix, track, block), av, timeBase) &&
+      timeBase.num == t.timeBaseNum && timeBase.den == t.timeBaseDen && av->size >= 0)
+  {
+    pkt = CDVDDemuxUtils::AllocateDemuxPacket(av->size);
+    if (pkt)
+    {
+      pkt->iSize = av->size;
+      if (av->data && av->size > 0)
+        std::memcpy(pkt->pData, av->data, static_cast<size_t>(av->size));
+      pkt->pts = av->pts == AV_NOPTS_VALUE
+                     ? DVD_NOPTS_VALUE
+                     : MKV_SUBSEEK::PlayerTime(av->pts, timeBase.num, timeBase.den, t.startTime);
+      pkt->dts = av->dts == AV_NOPTS_VALUE
+                     ? DVD_NOPTS_VALUE
+                     : MKV_SUBSEEK::PlayerTime(av->dts, timeBase.num, timeBase.den, t.startTime);
+      pkt->duration =
+          DVD_SEC_TO_TIME(static_cast<double>(av->duration) * timeBase.num / timeBase.den);
+      CDVDDemuxUtils::StoreSideData(pkt, av);
+      pkt->iStreamId = t.streamId;
+      pkt->demuxerId = t.demuxerId;
+    }
+  }
+  av_packet_free(&av);
+  return pkt;
+}
+} // namespace
+
+struct CSubtitleSeekSearch::Shared
+{
+  std::mutex lock;
+  std::condition_variable wake;
+  std::atomic<bool> quit{false};
+  bool running = false; //!< the thread
+  uint64_t generation = 0; //!< of the latest Start() or Stop()
+  std::atomic<uint64_t> current{0}; //!< the same, for the thread to look at without the lock
+  std::optional<Target> pending;
+  uint64_t pendingGeneration = 0;
+  std::vector<std::pair<uint64_t, DemuxPacket*>> found;
+  std::atomic<double> clock{DVD_NOPTS_VALUE};
+  double latestTarget = DVD_NOPTS_VALUE;
+
+  // the thread's own: the file it knows, kept from one seek to the next
+  struct File
+  {
+    std::string path;
+    Kind kind = Kind::NONE;
+    std::unique_ptr<FileSource> file;
+    std::shared_ptr<const MKV_SUBSEEK::Index> index;
+    std::string httpUrl; //!< after the redirections
+    int64_t size = -1;
+    bool failed = false; //!< not searched again (it was said why)
+    bool told = false;
+    std::set<unsigned> toldStreams;
+    std::set<unsigned> toldNoCues;
+  } file;
+
+  void Free(std::vector<std::pair<uint64_t, DemuxPacket*>>& packets)
+  {
+    for (auto& [g, p] : packets)
+      CDVDDemuxUtils::FreeDemuxPacket(p);
+    packets.clear();
+  }
+
+  void Push(uint64_t gen, DemuxPacket* p)
+  {
+    std::unique_lock l(lock);
+    if (!quit && gen == generation)
+      found.emplace_back(gen, p);
+    else
+      CDVDDemuxUtils::FreeDemuxPacket(p);
+  }
+
+  bool ReadIndex(const std::function<bool()>& stopped);
+  void Search(const Target& t, uint64_t gen);
+  static void Work(std::shared_ptr<Shared> self);
+};
+
+bool CSubtitleSeekSearch::Shared::ReadIndex(const std::function<bool()>& stopped)
+{
+  File& f = file;
+  const std::string name = CURL::GetRedacted(f.path);
+  const auto start = Clock::now();
+  const auto deadline = start + (f.kind == Kind::INTERNET ? 6000ms : 4000ms);
+  const auto stop = [&] { return stopped() || Clock::now() > deadline; };
+  const Limits limits = LimitsFor(f.kind, 0);
+  MKV_SUBSEEK::Index ix;
+  int requests = 0;
+  if (f.kind == Kind::LOCAL || f.kind == Kind::LAN)
+  {
+    auto source = std::make_unique<FileSource>();
+    if (!source->Open(f.path))
+    {
+      CLog::Log(LOGINFO,
+                "CSubtitleSeekSearch: {} could not be opened a second time: the subtitle lines "
+                "stored before where a seek reads again are not searched in it",
+                name);
+      f.failed = true;
+      return false;
+    }
+    source->SetStop(stop);
+    ix = MKV_SUBSEEK::ReadIndex(*source, source->Length(), limits.budget.maxIndexBytes, stop);
+    source->SetStop(nullptr);
+    f.file = std::move(source);
+  }
+  else
+  {
+    CSearchCurl session;
+    if (!session.Acquire(f.path))
+    {
+      CLog::Log(LOGINFO, "CSubtitleSeekSearch: no curl session for {}: not searched", name);
+      f.failed = true;
+      return false;
+    }
+    MKV_EDITIONS::HTTP::RangeSource range(session.Easy(), session.Multi(), session.GetURL(), stop,
+                                          deadline);
+    if (range.Begin(MKV_SUBSEEK::FIRST_BYTES))
+    {
+      f.httpUrl = range.Url();
+      f.size = range.Size();
+      ix = MKV_SUBSEEK::ReadIndex(range, range.Size(), limits.budget.maxIndexBytes, stop);
+    }
+    else
+    {
+      ix.outcome = range.GetFailure() == MKV_EDITIONS::HTTP::Failure::STOPPED ||
+                           range.GetFailure() == MKV_EDITIONS::HTTP::Failure::LATE
+                       ? MKV_SUBSEEK::Outcome::STOPPED
+                       : MKV_SUBSEEK::Outcome::FETCH_FAILED;
+      ix.why = range.Why();
+    }
+    requests = range.Requests();
+  }
+  if (ix.outcome == MKV_SUBSEEK::Outcome::STOPPED && stopped())
+    return false; // a newer seek: the next one reads it
+  if (ix.outcome != MKV_SUBSEEK::Outcome::READ)
+  {
+    CLog::Log(
+        LOGINFO,
+        "CSubtitleSeekSearch: the index of {} ({}) could not be read ({}: {}{}): the subtitle "
+        "lines stored before where a seek reads again are not searched in it",
+        name, Name(f.kind), MKV_SUBSEEK::Name(ix.outcome),
+        ix.outcome == MKV_SUBSEEK::Outcome::STOPPED ? "not within the deadline" : ix.why,
+        requests ? ", " + std::to_string(requests) + " request(s)" : "");
+    f.failed = true;
+    f.file.reset();
+    return false;
+  }
+  size_t subtitleCues = 0;
+  for (const MKV_SUBSEEK::Track& tr : ix.tracks)
+    if (tr.type == MKV_SUBSEEK::TRACK_SUBTITLE && ix.cues.count(tr.number))
+      subtitleCues++;
+  CLog::Log(
+      LOGINFO,
+      "CSubtitleSeekSearch: {} ({}): {} track(s), cues {}for {} of them, {} subtitle track(s) "
+      "with cues; read in {} ms ({} read(s), {} bytes)",
+      name, Name(f.kind), ix.tracks.size(), ix.cuesRead ? "" : "not found, ", ix.cues.size(),
+      subtitleCues, Ms(start), f.kind == Kind::LOCAL || f.kind == Kind::LAN ? ix.fetches : requests,
+      ix.bytes);
+  f.index = std::make_shared<const MKV_SUBSEEK::Index>(std::move(ix));
+  if (f.size < 0)
+    f.size = f.index->size;
+  return true;
+}
+
+void CSubtitleSeekSearch::Shared::Search(const Target& t, uint64_t gen)
+{
+  const auto stopped = [this, gen] { return g_closing || quit || current.load() != gen; };
+  File& f = file;
+  if (f.path != t.path)
+  {
+    f = File{};
+    f.path = t.path;
+    f.kind = Classify(t.path);
+  }
+  const std::string name = CURL::GetRedacted(f.path);
+  if (f.kind == Kind::NONE)
+  {
+    if (!f.told)
+      CLog::Log(
+          LOGINFO,
+          "CSubtitleSeekSearch: {} is neither on this device, on the local network nor over "
+          "HTTP: the subtitle lines stored before where a seek reads again are not searched in "
+          "it",
+          name);
+    f.told = true;
+    return;
+  }
+  if (f.failed)
+    return;
+  if (!f.index && !ReadIndex(stopped))
+    return;
+  const MKV_SUBSEEK::Index& ix = *f.index;
+  const MKV_SUBSEEK::Track* track = ix.TrackOfStream(t.stream, t.trackStreams);
+  const bool sameTime =
+      static_cast<double>(t.timeBaseNum) * 1e9 == static_cast<double>(ix.timeScale) * t.timeBaseDen;
+  if (!track || track->type != MKV_SUBSEEK::TRACK_SUBTITLE || !sameTime)
+  {
+    if (f.toldStreams.insert(t.stream).second)
+      CLog::Log(
+          LOGINFO,
+          "CSubtitleSeekSearch: stream {} of FFmpeg's demuxer is not a subtitle track of {} as "
+          "the file stores its tracks (or not on its timescale): not searched",
+          t.stream, name);
+    return;
+  }
+  Limits limits = LimitsFor(f.kind, t.readRate);
+  const auto cues = ix.cues.find(track->number);
+  const bool cued = cues != ix.cues.end() && !cues->second.empty();
+  bool placed = cued;
+  if (cued)
+    for (const MKV_SUBSEEK::Cue& c : cues->second)
+      placed = placed && c.relative.has_value();
+  if (!cued && f.kind == Kind::INTERNET && !limits.budget.wholeRange)
+  {
+    if (f.toldNoCues.insert(t.stream).second)
+      CLog::Log(LOGINFO,
+                "CSubtitleSeekSearch: subtitle track {} of {} has no cues, and how fast the player "
+                "reads it is not known yet: not searched over the internet",
+                track->number, name);
+    return;
+  }
+  // without the cues of the track (or where they point in their cluster) a walk or a range comes
+  // after the player's own reading: it waits for playback to resume (4 s at most)
+  const bool walks = !cued || !placed;
+  if (walks && (limits.budget.walk || (!cued && limits.budget.wholeRange)))
+  {
+    const auto waitEnd = Clock::now() + 4000ms;
+    while (!stopped() && Clock::now() < waitEnd)
+    {
+      const double now = clock.load();
+      if (now != DVD_NOPTS_VALUE && now > t.target + DVD_MSEC_TO_TIME(300))
+        break;
+      std::this_thread::sleep_for(50ms);
+    }
+    if (stopped())
+      return;
+  }
+  const auto searchStart = Clock::now();
+  const auto deadline = searchStart + limits.deadline;
+  const auto stop = [&] { return stopped() || Clock::now() > deadline; };
+
+  MKV_SUBSEEK::Request rq;
+  rq.track = track->number;
+  rq.target = MKV_SUBSEEK::FileTime(t.target, t.startTime, ix.timeScale);
+  rq.window = static_cast<int64_t>(limits.window * 1e9 / static_cast<double>(ix.timeScale));
+  rq.now = [this, &t, &ix, &rq]
+  {
+    const double now = clock.load();
+    return now == DVD_NOPTS_VALUE ? rq.target
+                                  : MKV_SUBSEEK::FileTime(now, t.startTime, ix.timeScale);
+  };
+  int unmade = 0;
+  rq.found = [&](const MKV_SUBSEEK::Block& b)
+  {
+    if (DemuxPacket* p = MakePacket(ix, *track, b, t))
+      Push(gen, p);
+    else
+      unmade++;
+  };
+
+  MKV_SUBSEEK::Search r;
+  int requests = 0;
+  std::string sourceWhy;
+  if (f.kind == Kind::LOCAL || f.kind == Kind::LAN)
+  {
+    f.file->SetStop(stop);
+    r = MKV_SUBSEEK::Find(ix, *f.file, limits.budget, rq, stop);
+    f.file->SetStop(nullptr);
+  }
+  else
+  {
+    CSearchCurl session;
+    if (!session.Acquire(f.path))
+    {
+      CLog::Log(LOGINFO, "CSubtitleSeekSearch: no curl session for {}: not searched", name);
+      return;
+    }
+    if (limits.recvSpeed > 0)
+      session.LimitSpeed(limits.recvSpeed);
+    MKV_EDITIONS::HTTP::RangeSource range(session.Easy(), session.Multi(), f.httpUrl, stop,
+                                          deadline);
+    range.Known(f.size);
+    r = MKV_SUBSEEK::Find(ix, range, limits.budget, rq, stop);
+    requests = range.Requests();
+    if (range.GetFailure() == MKV_EDITIONS::HTTP::Failure::HTTP_ERROR ||
+        range.GetFailure() == MKV_EDITIONS::HTTP::Failure::NO_RANGES ||
+        range.GetFailure() == MKV_EDITIONS::HTTP::Failure::NOT_THE_PART)
+    {
+      // a server that refuses (429, 403...) or answers something else is not asked again
+      f.failed = true;
+      sourceWhy = range.Why() + "; not asked again for this file";
+    }
+  }
+  const bool newer = r.outcome == MKV_SUBSEEK::Outcome::STOPPED && stopped();
+  const int reads = f.kind == Kind::LOCAL || f.kind == Kind::LAN ? r.fetches : requests;
+  const std::string cost = Cost(reads, r.bytes, Ms(searchStart));
+  const double at = t.target / DVD_TIME_BASE;
+  if (r.found > 0)
+    CLog::Log(
+        LOGINFO,
+        "CSubtitleSeekSearch: after the seek to {:.3f} s, {} subtitle line(s) on screen there "
+        "found in {} ({}), stored before where the demuxer reads again (by {}{}; {}){}",
+        at, r.found, name, Name(f.kind), MKV_SUBSEEK::Name(r.way),
+        r.walkedFrom >= 0 ? From(r.walkedFrom, ix.timeScale, t.startTime) : "", cost,
+        unmade ? "; " + std::to_string(unmade) + " not made into a packet by FFmpeg" : "");
+  if (newer)
+    CLog::Log(LOGDEBUG,
+              "CSubtitleSeekSearch: the search after the seek to {:.3f} s gave way to a "
+              "newer one",
+              at);
+  else if (r.outcome != MKV_SUBSEEK::Outcome::READ || !r.why.empty() || !sourceWhy.empty())
+    CLog::Log(
+        LOGINFO,
+        "CSubtitleSeekSearch: after the seek to {:.3f} s in {} ({}), the subtitle lines stored "
+        "before where the demuxer reads again could not all be searched: {}{}{} ({})",
+        at, name, Name(f.kind), MKV_SUBSEEK::Name(r.outcome), r.why.empty() ? "" : ", " + r.why,
+        sourceWhy.empty() ? "" : ", " + sourceWhy, cost);
+  else if (r.found == 0)
+    CLog::Log(
+        LOGDEBUG,
+        "CSubtitleSeekSearch: after the seek to {:.3f} s, no subtitle line stored before where "
+        "the demuxer reads again is on screen there (by {}; {})",
+        at, MKV_SUBSEEK::Name(r.way), cost);
+  if (r.mismatched > 0)
+    CLog::Log(
+        LOGINFO,
+        "CSubtitleSeekSearch: {} cue(s) of subtitle track {} of {} do not point at a block of "
+        "the track at their time: those lines are not taken from them",
+        r.mismatched, track->number, name);
+  if (r.skippedEnded > 0)
+    CLog::Log(
+        LOGDEBUG,
+        "CSubtitleSeekSearch: {} line(s) on screen at {:.3f} s had ended before they could be "
+        "read",
+        r.skippedEnded, at);
+}
+
+void CSubtitleSeekSearch::Shared::Work(std::shared_ptr<Shared> self)
+{
+  LowerPriority();
+  while (true)
+  {
+    Target t;
+    uint64_t gen = 0;
+    {
+      std::unique_lock l(self->lock);
+      self->wake.wait(l, [&self] { return self->quit || self->pending.has_value(); });
+      if (self->quit)
+        break;
+      t = std::move(*self->pending);
+      gen = self->pendingGeneration;
+      self->pending.reset();
+    }
+    if (!g_closing)
+      self->Search(t, gen);
+  }
+  {
+    std::unique_lock l(self->lock);
+    self->Free(self->found);
+    self->running = false;
+  }
+  // the file and the index go with this thread (a file server's close may block)
+  self->file = File{};
+  InFlight& threads = Threads();
+  {
+    std::lock_guard l(threads.lock);
+    threads.threads--;
+  }
+  threads.ended.notify_all();
+}
+
+CSubtitleSeekSearch::CSubtitleSeekSearch() : m_shared(std::make_shared<Shared>())
+{
+}
+
+CSubtitleSeekSearch::~CSubtitleSeekSearch()
+{
+  std::unique_lock l(m_shared->lock);
+  m_shared->quit = true;
+  m_shared->generation++;
+  m_shared->current = m_shared->generation;
+  m_shared->pending.reset();
+  m_shared->Free(m_shared->found);
+  m_shared->wake.notify_all();
+  // the thread ends on its own (at its next read at most), with its own reference to what is shared
+}
+
+void CSubtitleSeekSearch::Start(const Target& target)
+{
+  if (g_closing)
+    return;
+  std::unique_lock l(m_shared->lock);
+  m_shared->generation++;
+  m_shared->current = m_shared->generation;
+  m_shared->pending = target;
+  m_shared->pendingGeneration = m_shared->generation;
+  m_shared->latestTarget = target.target;
+  m_shared->Free(m_shared->found);
+  if (!m_shared->running)
+  {
+    InFlight& threads = Threads();
+    {
+      std::lock_guard tl(threads.lock);
+      threads.threads++;
+    }
+    try
+    {
+      std::thread(&Shared::Work, m_shared).detach();
+      m_shared->running = true;
+    }
+    catch (const std::system_error&)
+    {
+      {
+        std::lock_guard tl(threads.lock);
+        threads.threads--;
+      }
+      m_shared->pending.reset();
+      CLog::Log(LOGWARNING, "CSubtitleSeekSearch: no thread for the search: not searched");
+      return;
+    }
+  }
+  m_shared->wake.notify_all();
+}
+
+void CSubtitleSeekSearch::Stop()
+{
+  std::unique_lock l(m_shared->lock);
+  m_shared->generation++;
+  m_shared->current = m_shared->generation;
+  m_shared->pending.reset();
+  m_shared->Free(m_shared->found);
+}
+
+void CSubtitleSeekSearch::SetClock(double now)
+{
+  m_shared->clock = now;
+}
+
+std::vector<DemuxPacket*> CSubtitleSeekSearch::Take()
+{
+  std::vector<DemuxPacket*> out;
+  std::unique_lock l(m_shared->lock);
+  if (m_shared->found.empty())
+    return out;
+  for (auto& [g, p] : m_shared->found)
+  {
+    if (g == m_shared->generation)
+      out.push_back(p);
+    else
+      CDVDDemuxUtils::FreeDemuxPacket(p);
+  }
+  m_shared->found.clear();
+  return out;
+}
+
+double CSubtitleSeekSearch::LatestTarget() const
+{
+  std::unique_lock l(m_shared->lock);
+  return m_shared->latestTarget;
+}
+
+namespace SUBTITLE_SEEK
+{
+void StopSearches()
+{
+  g_closing = true;
+  InFlight& threads = Threads();
+  std::unique_lock lock(threads.lock);
+  if (threads.threads == 0)
+    return;
+  // a search over HTTP stops within 100 ms; one blocked in a call to a file server (SMB, NFS)
+  // returns at the timeout of that client: it is waited for, so that it does not use the client
+  // that CApplication::Stop() frees right after this
+  const auto advanced = CServiceBroker::GetSettingsComponent()->GetAdvancedSettings();
+  const std::chrono::seconds limit(std::max<int64_t>(advanced->m_sambaclienttimeout,
+                                                     static_cast<int64_t>(advanced->m_nfsTimeout)) +
+                                   2);
+  CLog::Log(LOGINFO,
+            "CSubtitleSeekSearch: {} search thread(s) left: they are stopped (at most {} s)",
+            threads.threads, limit.count());
+  if (!threads.ended.wait_for(lock, limit, [&threads] { return threads.threads == 0; }))
+    CLog::Log(LOGWARNING, "CSubtitleSeekSearch: {} search thread(s) did not stop within {} s: left",
+              threads.threads, limit.count());
+}
+} // namespace SUBTITLE_SEEK
