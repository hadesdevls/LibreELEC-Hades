+
+bool CVideoPlayerSubtitle::GiveFound(DemuxPacket* pPacket)
+{
+  std::unique_lock lock(m_section);
+
+  if (!m_pOverlayCodec || !m_searchable || !pPacket)
+    return false;
+  const size_t size = static_cast<size_t>(pPacket->iSize);
+  if (m_seen.SeenOrNote(pPacket->pts, pPacket->duration, pPacket->pData, size))
+    return false;
+  if (m_seekMemoryOn)
+    m_seekMemory.Remember(pPacket->pts, pPacket->dts, pPacket->duration, pPacket->m_ptsOffset,
+                          pPacket->pData, size);
+  DecodePacket(pPacket);
+  return true;
+}
