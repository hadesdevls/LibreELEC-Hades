+#pragma once
+
+// The packet that FFmpeg's Matroska demuxer makes of a block that MatroskaSubtitleSeek.h found:
+// the demuxer itself reads the file of that one block (MiniFile()) from memory, so that the
+// packet's data, timestamps, duration and side data are what reading the file gives (content
+// encodings, WebVTT's identifier and settings, ASS as FFmpeg passes it). Only libavformat.
+
+extern "C"
+{
+#include <libavformat/avformat.h>
+#include <libavutil/mem.h>
+}
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+namespace MKV_SUBSEEK
+{
+namespace DETAIL
+{
+struct Memory
+{
+  const std::string* data = nullptr;
+  int64_t at = 0;
+};
+
+inline int MemoryRead(void* opaque, uint8_t* buf, int size)
+{
+  auto* m = static_cast<Memory*>(opaque);
+  const int64_t left = static_cast<int64_t>(m->data->size()) - m->at;
+  if (left <= 0)
+    return AVERROR_EOF;
+  const int n = static_cast<int>(std::min<int64_t>(left, size));
+  std::memcpy(buf, m->data->data() + m->at, static_cast<size_t>(n));
+  m->at += n;
+  return n;
+}
+
+inline int64_t MemorySeek(void* opaque, int64_t pos, int whence)
+{
+  auto* m = static_cast<Memory*>(opaque);
+  const int64_t size = static_cast<int64_t>(m->data->size());
+  switch (whence & ~AVSEEK_FORCE)
+  {
+    case AVSEEK_SIZE:
+      return size;
+    case SEEK_SET:
+      break;
+    case SEEK_CUR:
+      pos += m->at;
+      break;
+    case SEEK_END:
+      pos += size;
+      break;
+    default:
+      return AVERROR(EINVAL);
+  }
+  if (pos < 0 || pos > size)
+    return AVERROR(EINVAL);
+  m->at = pos;
+  return pos;
+}
+} // namespace DETAIL
+
+/*!
+ * \brief The packet of the one block of file (MiniFile()), in out (which the caller unrefs), and
+ *        the time base of its stream
+ * \return false: FFmpeg's demuxer made no packet of it
+ */
+inline bool DemuxMiniFile(const std::string& file, AVPacket* out, AVRational& timeBase)
+{
+  DETAIL::Memory memory{&file, 0};
+  constexpr int BUFFER = 4096;
+  auto* buffer = static_cast<unsigned char*>(av_malloc(BUFFER));
+  if (!buffer)
+    return false;
+  AVIOContext* io = avio_alloc_context(buffer, BUFFER, 0, &memory, DETAIL::MemoryRead, nullptr,
+                                       DETAIL::MemorySeek);
+  if (!io)
+  {
+    av_free(buffer);
+    return false;
+  }
+  bool made = false;
+  const AVInputFormat* format = av_find_input_format("matroska");
+  AVFormatContext* fc = format ? avformat_alloc_context() : nullptr;
+  if (fc)
+  {
+    fc->pb = io;
+    fc->flags |= AVFMT_FLAG_CUSTOM_IO;
+    // on failure avformat_open_input() frees the context, not the custom I/O
+    if (avformat_open_input(&fc, "", format, nullptr) >= 0)
+    {
+      if (fc->nb_streams == 1)
+      {
+        timeBase = fc->streams[0]->time_base;
+        while (!made && av_read_frame(fc, out) >= 0)
+        {
+          if (out->stream_index == 0)
+            made = true;
+          else
+            av_packet_unref(out);
+        }
+      }
+      avformat_close_input(&fc);
+    }
+  }
+  av_freep(&io->buffer);
+  avio_context_free(&io);
+  return made;
+}
+
+} // namespace MKV_SUBSEEK
