+ */
+
+#pragma once
+
+// The subtitle lines of a Matroska file that are on screen at a time, found without reading what
+// lies between: for a seek to a part of the file that the player has not read. FFmpeg's demuxer
+// seeks on the video track and starts reading at the cluster of the keyframe at or before the
+// target (matroska_read_seek()); a line stored before that cluster started earlier and is never
+// read, so it stays off screen until the next one.
+//
+// What a search leans on, in this order:
+// - The Cues of the subtitle track. mkvmerge (by default: "iframes" for video and subtitle tracks,
+//   and every subtitle block is one) and FFmpeg's muxer (every subtitle packet of a seekable
+//   output) write one for every subtitle block, with CueRelativePosition and CueDuration. The lines
+//   whose cue says they are on screen at the target are read where the cue points: the head of
+//   their cluster and the block, a few hundred bytes, nothing between.
+// - Without CueDuration, the lines whose cue starts in the window before the target are read, and
+//   their own duration decides.
+// - Without CueRelativePosition, or without cues for the track: the clusters from the window before
+//   the target are walked by the headers of their elements, the bodies of the blocks of the other
+//   tracks skipped, where the source allows a fetch per block (a file on this device or on the
+//   local network); or the clusters before the one the player reads from are fetched whole in one
+//   range where that fits in what the source allows (over HTTP).
+// Every block is checked against what pointed to it (its track; with a cue, its time), and blocks
+// are returned as stored. The packet is then made by FFmpeg's own demuxer from a file of that one
+// block (MiniFile()): the track's entry as the file has it (codec, private data, content
+// encodings), the cluster's timestamp, the block. It is the packet a read from the start gives.
+//
+// Pure: no Kodi, curl or FFmpeg; the bytes come through MKV_EDITIONS::HEADER::ByteSource.
+
+#include "MatroskaHeaderRead.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace MKV_SUBSEEK
+{
+using MKV_EDITIONS::HEADER::ByteSource;
+
+namespace ID
+{
+//! RFC 9559 element IDs, with their length marker
+enum : uint32_t
+{
+  EBML = 0x1A45DFA3,
+  EBMLVERSION = 0x4286,
+  EBMLREADVERSION = 0x42F7,
+  EBMLMAXIDLENGTH = 0x42F2,
+  EBMLMAXSIZELENGTH = 0x42F3,
+  DOCTYPE = 0x4282,
+  DOCTYPEVERSION = 0x4287,
+  DOCTYPEREADVERSION = 0x4285,
+  SEGMENT = 0x18538067,
+  SEEKHEAD = 0x114D9B74,
+  SEEK = 0x4DBB,
+  SEEKID = 0x53AB,
+  SEEKPOSITION = 0x53AC,
+  INFO = 0x1549A966,
+  TIMESTAMPSCALE = 0x2AD7B1,
+  TRACKS = 0x1654AE6B,
+  TRACKENTRY = 0xAE,
+  TRACKNUMBER = 0xD7,
+  TRACKTYPE = 0x83,
+  CODECID = 0x86,
+  TRACKTIMESTAMPSCALE = 0x23314F,
+  DEFAULTDURATION = 0x23E383,
+  CODECDELAY = 0x56AA,
+  CUES = 0x1C53BB6B,
+  CUEPOINT = 0xBB,
+  CUETIME = 0xB3,
+  CUETRACKPOSITIONS = 0xB7,
+  CUETRACK = 0xF7,
+  CUECLUSTERPOSITION = 0xF1,
+  CUERELATIVEPOSITION = 0xF0,
+  CUEDURATION = 0xB2,
+  CLUSTER = 0x1F43B675,
+  TIMESTAMP = 0xE7,
+  SIMPLEBLOCK = 0xA3,
+  BLOCKGROUP = 0xA0,
+  BLOCK = 0xA1,
+  BLOCKDURATION = 0x9B,
+  TAGS = 0x1254C367,
+  CHAPTERS = 0x1043A770,
+  ATTACHMENTS = 0x1941A469,
+  VOID = 0xEC,
+  CRC32 = 0xBF,
+};
+} // namespace ID
+
+constexpr uint64_t TRACK_VIDEO = 1;
+constexpr uint64_t TRACK_SUBTITLE = 17;
+
+//! The first fetch of a file: its EBML header and the start of its Segment
+constexpr int64_t FIRST_BYTES = 64 * 1024;
+//! A block of a subtitle track larger than this is not read
+constexpr int64_t MAX_BLOCK = 1024 * 1024;
+
+enum class Outcome
+{
+  READ,
+  NOT_MATROSKA, //!< no EBML header and Segment, or one FFmpeg's demuxer refuses
+  MALFORMED, //!< an element that is needed is not well formed
+  TOO_LARGE, //!< what is needed does not fit in what may be fetched
+  FETCH_FAILED, //!< the source could not give a range
+  STOPPED, //!< the caller stopped it (a newer seek, the end of playback, the deadline)
+};
+
+inline const char* Name(Outcome o)
+{
+  switch (o)
+  {
+    case Outcome::READ:
+      return "read";
+    case Outcome::NOT_MATROSKA:
+      return "not a Matroska file";
+    case Outcome::MALFORMED:
+      return "not well formed";
+    case Outcome::TOO_LARGE:
+      return "more than may be read";
+    case Outcome::FETCH_FAILED:
+      return "a read failed";
+    case Outcome::STOPPED:
+      return "stopped";
+  }
+  return "?";
+}
+
+//! What one fetch may cost, and how many: what a kind of source allows
+struct Budget
+{
+  int64_t maxBytes = 0; //!< fetched by one search (the index apart)
+  int maxFetches = 0; //!< fetches of one search (reads of a file, requests over HTTP)
+  int64_t chunk = 4096; //!< a fetch reads at least this much (a page of a file, a part over HTTP)
+  bool walk = false; //!< the headers of the blocks may be read one by one
+  int64_t wholeRange = 0; //!< without cues for the track: the clusters fetched whole, at most
+  int64_t maxIndexBytes = 0; //!< the start of the file, its Tracks and its Cues, once per file
+};
+
+namespace DETAIL
+{
+using MKV_EDITIONS::HEADER::DETAIL::Children;
+using MKV_EDITIONS::HEADER::DETAIL::ElementHeader;
+using MKV_EDITIONS::HEADER::DETAIL::Float;
+using MKV_EDITIONS::HEADER::DETAIL::Header;
+using MKV_EDITIONS::HEADER::DETAIL::Uint;
+
+//! The bytes of a file through a ByteSource, counted against a budget, with what was fetched
+//! kept for the reads that follow (the head of a cluster, the headers of blocks in a row)
+class Fetcher
+{
+public:
+  enum class Got
+  {
+    OK,
+    OUTSIDE, //!< beyond the end of the file
+    BUDGET, //!< over the bytes or the fetches allowed
+    FAILED, //!< the source could not give it
+    STOPPED,
+  };
+
+  Fetcher(ByteSource& source, int64_t size, std::function<bool()> stop)
+    : m_source(source),
+      m_size(size),
+      m_stop(std::move(stop))
+  {
+  }
+
+  void Allow(int64_t maxBytes, int maxFetches, int64_t chunk)
+  {
+    m_maxBytes = m_bytes + maxBytes;
+    m_maxFetches = m_fetches + maxFetches;
+    m_chunk = std::max<int64_t>(chunk, 16);
+  }
+
+  //! Exactly [offset, offset + length), from what was fetched or by a fetch of at least a chunk
+  Got Get(int64_t offset, int64_t length, std::string& out)
+  {
+    out.clear();
+    if (offset < 0 || length < 0 || offset > m_size || length > m_size - offset)
+      return Got::OUTSIDE;
+    if (length == 0)
+      return Got::OK;
+    for (const Piece& p : m_pieces)
+      if (offset >= p.offset && offset + length <= p.offset + static_cast<int64_t>(p.data.size()))
+      {
+        out = p.data.substr(static_cast<size_t>(offset - p.offset), static_cast<size_t>(length));
+        return Got::OK;
+      }
+    int64_t want = std::min(std::max(length, m_chunk), m_size - offset);
+    if (m_bytes + want > m_maxBytes)
+      want = std::max(length, m_maxBytes - m_bytes);
+    if (const Got g = Fetch(offset, want); g != Got::OK)
+      return g;
+    out = m_pieces.back().data.substr(0, static_cast<size_t>(length));
+    return Got::OK;
+  }
+
+  //! [offset, offset + length) as one fetch, kept for the reads that follow
+  Got Load(int64_t offset, int64_t length)
+  {
+    if (offset < 0 || length <= 0 || offset > m_size || length > m_size - offset)
+      return Got::OUTSIDE;
+    return Fetch(offset, length);
+  }
+
+  int64_t Size() const { return m_size; }
+  int64_t Bytes() const { return m_bytes; }
+  int Fetches() const { return m_fetches; }
+
+private:
+  struct Piece
+  {
+    int64_t offset = 0;
+    std::string data;
+  };
+
+  Got Fetch(int64_t offset, int64_t length)
+  {
+    if (m_stop && m_stop())
+      return Got::STOPPED;
+    if (m_fetches >= m_maxFetches || m_bytes + length > m_maxBytes)
+      return Got::BUDGET;
+    m_fetches++;
+    m_bytes += length;
+    Piece p;
+    p.offset = offset;
+    if (!m_source.Fetch(offset, length, p.data) || static_cast<int64_t>(p.data.size()) != length)
+      return m_stop && m_stop() ? Got::STOPPED : Got::FAILED;
+    m_pieces.push_back(std::move(p));
+    // a few pieces: the Cues or a range read whole, a cluster's head, the block it points to
+    if (m_pieces.size() > 4)
+      m_pieces.erase(m_pieces.begin());
+    return Got::OK;
+  }
+
+  ByteSource& m_source;
+  int64_t m_size;
+  std::function<bool()> m_stop;
+  int64_t m_maxBytes = 0;
+  int m_maxFetches = 0;
+  int64_t m_chunk = 4096;
+  int64_t m_bytes = 0;
+  int m_fetches = 0;
+  std::vector<Piece> m_pieces;
+};
+
+using Got = Fetcher::Got;
+
+//! The header of the element at pos
+inline Got ReadHeader(Fetcher& f, int64_t pos, Header& h)
+{
+  std::string head;
+  const int64_t n = std::min<int64_t>(12, f.Size() - pos);
+  if (n < 2)
+    return Got::OUTSIDE;
+  if (const Got g = f.Get(pos, n, head); g != Got::OK)
+    return g;
+  if (!ElementHeader(reinterpret_cast<const uint8_t*>(head.data()), head.size(), h))
+    return Got::OUTSIDE;
+  return Got::OK;
+}
+
+//! The data of the element at pos whose header is h (known size, within the file and max)
+inline Got ReadData(Fetcher& f, int64_t pos, const Header& h, int64_t max, std::string& data)
+{
+  if (h.unknownSize || h.size > static_cast<uint64_t>(f.Size() - pos - h.length))
+    return Got::OUTSIDE;
+  if (static_cast<int64_t>(h.size) > max)
+    return Got::BUDGET;
+  return f.Get(pos + h.length, static_cast<int64_t>(h.size), data);
+}
+
+//! The track number (a vint), the timestamp relative to the cluster and the flags at the start of
+//! the data of a Block or a SimpleBlock
+inline bool BlockHead(std::string_view d, uint64_t& track, int16_t& relative, uint8_t& flags)
+{
+  if (d.empty())
+    return false;
+  const auto* p = reinterpret_cast<const uint8_t*>(d.data());
+  if (!p[0])
+    return false;
+  int n = 1;
+  while (!(p[0] & (0x80 >> (n - 1))))
+    n++;
+  if (n > 8 || d.size() < static_cast<size_t>(n) + 3)
+    return false;
+  track = p[0] & ((0x80u >> (n - 1)) - 1);
+  for (int i = 1; i < n; i++)
+    track = (track << 8) | p[i];
+  relative = static_cast<int16_t>((p[n] << 8) | p[n + 1]);
+  flags = p[n + 2];
+  return true;
+}
+
+inline bool IsLevel1(uint32_t id)
+{
+  switch (id)
+  {
+    case ID::SEEKHEAD:
+    case ID::INFO:
+    case ID::TRACKS:
+    case ID::CUES:
+    case ID::CLUSTER:
+    case ID::TAGS:
+    case ID::CHAPTERS:
+    case ID::ATTACHMENTS:
+      return true;
+    default:
+      return false;
+  }
+}
+
+inline void PutId(std::string& out, uint32_t id)
+{
+  int n = id > 0xFFFFFF ? 4 : id > 0xFFFF ? 3 : id > 0xFF ? 2 : 1;
+  for (int i = n - 1; i >= 0; i--)
+    out += static_cast<char>((id >> (8 * i)) & 0xFF);
+}
+
+//! An element size in 8 bytes (always valid, never "unknown")
+inline void PutSize(std::string& out, uint64_t size)
+{
+  out += static_cast<char>(0x01);
+  for (int i = 6; i >= 0; i--)
+    out += static_cast<char>((size >> (8 * i)) & 0xFF);
+}
+
+inline void PutElement(std::string& out, uint32_t id, std::string_view data)
+{
+  PutId(out, id);
+  PutSize(out, data.size());
+  out.append(data);
+}
+
+inline void PutUint(std::string& out, uint32_t id, uint64_t v)
+{
+  std::string d;
+  int n = 1;
+  while (n < 8 && (v >> (8 * n)))
+    n++;
+  for (int i = n - 1; i >= 0; i--)
+    d += static_cast<char>((v >> (8 * i)) & 0xFF);
+  PutElement(out, id, d);
+}
+} // namespace DETAIL
+
+struct Track
+{
+  uint64_t number = 0;
+  uint64_t type = 0;
+  std::string codec;
+  double timeScale = 1.0; //!< TrackTimestampScale (deprecated): FFmpeg divides the cluster's by it
+  uint64_t defaultDuration = 0; //!< ns
+  uint64_t codecDelay = 0; //!< ns
+  std::string entry; //!< the TrackEntry element as stored, its header included
+};
+
+struct Cue
+{
+  uint64_t time = 0; //!< CueTime, in TimestampScale units
+  uint64_t cluster = 0; //!< CueClusterPosition, from the start of the Segment's data
+  std::optional<uint64_t> relative; //!< CueRelativePosition, from the start of the cluster's data
+  std::optional<uint64_t> duration; //!< CueDuration, in TimestampScale units
+};
+
+//! What a search needs of a file, read once
+struct Index
+{
+  Outcome outcome = Outcome::MALFORMED;
+  std::string why; //!< when not READ
+  std::string docType;
+  int64_t size = 0; //!< of the file
+  int64_t segment = 0; //!< the start of the Segment's data
+  int64_t segmentEnd = 0;
+  int64_t firstCluster = -1;
+  uint64_t timeScale = 1000000;
+  std::vector<Track> tracks;
+  bool cuesRead = false; //!< a Cues element was found and read
+  std::map<uint64_t, std::vector<Cue>> cues; //!< by track number, in time order
+  int64_t bytes = 0; //!< fetched to read it
+  int fetches = 0;
+
+  const Track* Find(uint64_t number) const
+  {
+    for (const Track& t : tracks)
+      if (number && t.number == number)
+        return &t;
+    return nullptr;
+  }
+  /*!
+   * \brief The track of the stream number index of FFmpeg's demuxer: matroska_parse_tracks() makes
+   *        a stream of each TrackEntry in order but those of a type it does not read, those
+   *        without a CodecID and those whose CodecID does not fit their type (its attachments come
+   *        after them); null where the streams it made cannot be the entries read here (streams:
+   *        how many it made of tracks)
+   */
+  const Track* TrackOfStream(unsigned index, unsigned streams) const
+  {
+    std::vector<const Track*> made;
+    for (const Track& t : tracks)
+    {
+      const char c = t.codec.empty() ? '\0' : t.codec[0];
+      const bool fits = (t.type == 1 && c == 'V') || (t.type == 2 && c == 'A') ||
+                        ((t.type == 0x11 || t.type == 0x21) && (c == 'D' || c == 'S'));
+      if (fits)
+        made.push_back(&t);
+    }
+    if (made.size() != streams || index >= made.size())
+      return nullptr;
+    return made[index];
+  }
+  //! The first video track, which FFmpeg seeks on (av_find_default_stream_index())
+  const Track* Video() const
+  {
+    for (const Track& t : tracks)
+      if (t.type == TRACK_VIDEO)
+        return &t;
+    return nullptr;
+  }
+};
+
+/*!
+ * \brief The EBML header, the Segment, the Info's TimestampScale, the Tracks and the Cues of a file
+ *        of size bytes: the start of the file, then what the SeekHead points to (at most
+ *        maxBytes in all)
+ */
+inline Index ReadIndex(ByteSource& source,
+                       int64_t size,
+                       int64_t maxBytes,
+                       std::function<bool()> stop = {})
+{
+  using namespace DETAIL;
+  Index ix;
+  ix.size = size;
+  Fetcher f(source, size, std::move(stop));
+  f.Allow(maxBytes, 64, 16 * 1024);
+  const auto fail = [&ix, &f](Outcome o, std::string why)
+  {
+    ix.outcome = o;
+    ix.why = std::move(why);
+    ix.bytes = f.Bytes();
+    ix.fetches = f.Fetches();
+    return ix;
+  };
+  const auto failed = [&fail](Got g, const std::string& what)
+  {
+    switch (g)
+    {
+      case Got::BUDGET:
+        return fail(Outcome::TOO_LARGE, what + " does not fit in what may be read");
+      case Got::FAILED:
+        return fail(Outcome::FETCH_FAILED, what + " could not be read");
+      case Got::STOPPED:
+        return fail(Outcome::STOPPED, "stopped");
+      default:
+        return fail(Outcome::MALFORMED, what + " is not well formed");
+    }
+  };
+  if (size <= 0)
+    return fail(Outcome::NOT_MATROSKA, "the file is empty");
+  std::string first;
+  if (const Got g = f.Get(0, std::min(FIRST_BYTES, size), first); g != Got::OK)
+    return failed(g, "the start of the file");
+
+  // the EBML header, as matroska_read_header() takes it
+  Header h;
+  std::string data;
+  if (const Got g = ReadHeader(f, 0, h); g != Got::OK || h.id != ID::EBML)
+    return g == Got::FAILED || g == Got::STOPPED ? failed(g, "the EBML header")
+                                                 : fail(Outcome::NOT_MATROSKA, "no EBML header");
+  if (const Got g = ReadData(f, 0, h, 4096, data); g != Got::OK)
+    return failed(g, "the EBML header");
+  uint64_t readVersion = 1;
+  uint64_t maxIdLength = 4;
+  uint64_t maxSizeLength = 8;
+  uint64_t docTypeReadVersion = 1;
+  ix.docType = "matroska";
+  if (!Children(data,
+                [&](uint32_t id, std::string_view v)
+                {
+                  switch (id)
+                  {
+                    case ID::EBMLREADVERSION:
+                      return Uint(v, 1, readVersion);
+                    case ID::EBMLMAXIDLENGTH:
+                      return Uint(v, 4, maxIdLength);
+                    case ID::EBMLMAXSIZELENGTH:
+                      return Uint(v, 8, maxSizeLength);
+                    case ID::DOCTYPEREADVERSION:
+                      return Uint(v, 1, docTypeReadVersion);
+                    case ID::DOCTYPE:
+                      ix.docType = std::string(v.substr(0, v.find('\0')));
+                      return true;
+                    default:
+                      return true;
+                  }
+                }))
+    return fail(Outcome::MALFORMED, "the EBML header is not well formed");
+  if (readVersion > 1 || maxSizeLength > 8 || maxIdLength > 4 || docTypeReadVersion > 3)
+    return fail(Outcome::NOT_MATROSKA, "an EBML header that the demuxer does not read");
+  if (ix.docType != "matroska" && ix.docType != "webm")
+    return fail(Outcome::NOT_MATROSKA, "an EBML document that is not Matroska or WebM");
+
+  // the Segment (an element that is not one, before it, is passed over)
+  int64_t pos = h.length + static_cast<int64_t>(h.size);
+  bool segment = false;
+  for (int k = 0; k < 8 && pos < size && !segment; k++)
+  {
+    Header sh;
+    if (const Got g = ReadHeader(f, pos, sh); g != Got::OK)
+      return g == Got::FAILED || g == Got::STOPPED ? failed(g, "the Segment")
+                                                   : fail(Outcome::NOT_MATROSKA, "no Segment");
+    if (sh.id == ID::SEGMENT)
+    {
+      segment = true;
+      ix.segment = pos + sh.length;
+      ix.segmentEnd = size;
+      if (!sh.unknownSize && sh.size < static_cast<uint64_t>(size - ix.segment))
+        ix.segmentEnd = ix.segment + static_cast<int64_t>(sh.size);
+    }
+    else if (sh.unknownSize)
+      break;
+    else
+      pos += sh.length + static_cast<int64_t>(std::min<uint64_t>(sh.size, size));
+  }
+  if (!segment)
+    return fail(Outcome::NOT_MATROSKA, "no Segment");
+
+  // the level-1 elements in the first fetch, up to the first Cluster; then the SeekHeads
+  std::optional<int64_t> info;
+  std::optional<int64_t> tracks;
+  std::optional<int64_t> cues;
+  std::vector<int64_t> seekHeads;
+  std::vector<int64_t> seekHeadsRead;
+  pos = ix.segment;
+  while (pos < ix.segmentEnd && pos < static_cast<int64_t>(first.size()))
+  {
+    Header lh;
+    if (!ElementHeader(reinterpret_cast<const uint8_t*>(first.data()) + pos,
+                       first.size() - static_cast<size_t>(pos), lh))
+      break;
+    if (lh.id == ID::CLUSTER)
+    {
+      ix.firstCluster = pos;
+      break;
+    }
+    if (lh.unknownSize)
+      break;
+    if (lh.id == ID::INFO && !info)
+      info = pos;
+    else if (lh.id == ID::TRACKS && !tracks)
+      tracks = pos;
+    else if (lh.id == ID::CUES && !cues)
+      cues = pos;
+    else if (lh.id == ID::SEEKHEAD)
+      seekHeads.push_back(pos);
+    if (lh.size > static_cast<uint64_t>(ix.segmentEnd - pos))
+      break;
+    pos += lh.length + static_cast<int64_t>(lh.size);
+  }
+  for (size_t s = 0; s < seekHeads.size() && seekHeads.size() <= 8; s++)
+  {
+    const int64_t at = seekHeads[s];
+    if (std::find(seekHeadsRead.begin(), seekHeadsRead.end(), at) != seekHeadsRead.end())
+      continue;
+    seekHeadsRead.push_back(at);
+    Header sh;
+    if (const Got g = ReadHeader(f, at, sh); g != Got::OK || sh.id != ID::SEEKHEAD)
+    {
+      if (g == Got::FAILED || g == Got::STOPPED || g == Got::BUDGET)
+        return failed(g, "the SeekHead");
+      continue;
+    }
+    if (const Got g = ReadData(f, at, sh, 1024 * 1024, data); g != Got::OK)
+      return failed(g, "the SeekHead");
+    const bool ok = Children(data,
+                             [&](uint32_t id, std::string_view v)
+                             {
+                               if (id != ID::SEEK)
+                                 return true;
+                               uint64_t sid = 0;
+                               uint64_t spos = ~uint64_t{0};
+                               if (!Children(v,
+                                             [&sid, &spos](uint32_t eid, std::string_view ev)
+                                             {
+                                               if (eid == ID::SEEKID)
+                                                 return Uint(ev, 0, sid);
+                                               if (eid == ID::SEEKPOSITION)
+                                                 return Uint(ev, ~uint64_t{0}, spos);
+                                               return true;
+                                             }))
+                                 return false;
+                               if (spos >= static_cast<uint64_t>(ix.segmentEnd - ix.segment))
+                                 return true;
+                               const int64_t at1 = ix.segment + static_cast<int64_t>(spos);
+                               if (sid == ID::INFO && !info)
+                                 info = at1;
+                               else if (sid == ID::TRACKS && !tracks)
+                                 tracks = at1;
+                               else if (sid == ID::CUES && !cues)
+                                 cues = at1;
+                               else if (sid == ID::CLUSTER && ix.firstCluster < 0)
+                                 ix.firstCluster = at1;
+                               else if (sid == ID::SEEKHEAD)
+                                 seekHeads.push_back(at1);
+                               return true;
+                             });
+    if (!ok)
+      return fail(Outcome::MALFORMED, "the SeekHead is not well formed");
+  }
+
+  // the Info's TimestampScale (FFmpeg: 0 is the default)
+  if (info)
+  {
+    Header ih;
+    if (const Got g = ReadHeader(f, *info, ih); g != Got::OK || ih.id != ID::INFO)
+    {
+      if (g != Got::OK && g != Got::OUTSIDE)
+        return failed(g, "the Info element");
+    }
+    else
+    {
+      if (const Got g = ReadData(f, *info, ih, 1024 * 1024, data); g != Got::OK)
+        return failed(g, "the Info element");
+      if (!Children(data, [&ix](uint32_t id, std::string_view v)
+                    { return id != ID::TIMESTAMPSCALE || Uint(v, 1000000, ix.timeScale); }))
+        return fail(Outcome::MALFORMED, "the Info element is not well formed");
+      if (!ix.timeScale)
+        ix.timeScale = 1000000;
+    }
+  }
+
+  // the Tracks, each entry kept as stored
+  if (!tracks)
+    return fail(Outcome::MALFORMED, "no Tracks element found");
+  {
+    Header th;
+    if (const Got g = ReadHeader(f, *tracks, th); g != Got::OK || th.id != ID::TRACKS)
+      return g != Got::OK ? failed(g, "the Tracks element")
+                          : fail(Outcome::MALFORMED, "the SeekHead does not point at the Tracks");
+    if (const Got g = ReadData(f, *tracks, th, maxBytes, data); g != Got::OK)
+      return failed(g, "the Tracks element");
+    size_t at = 0;
+    while (at < data.size())
+    {
+      Header eh;
+      if (!ElementHeader(reinterpret_cast<const uint8_t*>(data.data()) + at, data.size() - at,
+                         eh) ||
+          eh.unknownSize || eh.size > data.size() - at - static_cast<size_t>(eh.length))
+        return fail(Outcome::MALFORMED, "the Tracks element is not well formed");
+      if (eh.id == ID::TRACKENTRY)
+      {
+        Track t;
+        t.entry = data.substr(at, static_cast<size_t>(eh.length + eh.size));
+        const std::string_view body =
+            std::string_view(data).substr(at + eh.length, static_cast<size_t>(eh.size));
+        if (!Children(body,
+                      [&t](uint32_t id, std::string_view v)
+                      {
+                        switch (id)
+                        {
+                          case ID::TRACKNUMBER:
+                            return Uint(v, 0, t.number);
+                          case ID::TRACKTYPE:
+                            return Uint(v, 0, t.type);
+                          case ID::CODECID:
+                            t.codec = std::string(v.substr(0, v.find('\0')));
+                            return true;
+                          case ID::TRACKTIMESTAMPSCALE:
+                            return Float(v, 1.0, t.timeScale);
+                          case ID::DEFAULTDURATION:
+                            return Uint(v, 0, t.defaultDuration);
+                          case ID::CODECDELAY:
+                            return Uint(v, 0, t.codecDelay);
+                          default:
+                            return true;
+                        }
+                      }))
+          return fail(Outcome::MALFORMED, "a TrackEntry is not well formed");
+        // every entry, in order (TrackOfStream() counts them as the demuxer does)
+        ix.tracks.push_back(std::move(t));
+      }
+      at += eh.length + static_cast<size_t>(eh.size);
+    }
+  }
+
+  // the Cues: CuePoint by CuePoint, each CueTrackPositions by its track
+  if (cues)
+  {
+    // the Cues and what follows them up to 1 MiB in one fetch (over HTTP, one request): they are
+    // usually the last element but the Tags
+    if (*cues < size)
+      if (const Got lg = f.Load(
+              *cues, std::min<int64_t>({size - *cues, int64_t{1024 * 1024}, maxBytes - f.Bytes()}));
+          lg == Got::FAILED || lg == Got::STOPPED)
+        return failed(lg, "the Cues element");
+    Header ch;
+    const Got hg = ReadHeader(f, *cues, ch);
+    if (hg != Got::OK && hg != Got::OUTSIDE)
+      return failed(hg, "the Cues element");
+    if (hg == Got::OK && ch.id == ID::CUES)
+    {
+      if (const Got g = ReadData(f, *cues, ch, maxBytes - f.Bytes(), data); g != Got::OK)
+        return failed(g, "the Cues element");
+      const bool ok =
+          Children(data,
+                   [&ix](uint32_t id, std::string_view v)
+                   {
+                     if (id != ID::CUEPOINT)
+                       return true;
+                     uint64_t time = 0;
+                     bool hasTime = false;
+                     if (!Children(v,
+                                   [&](uint32_t pid, std::string_view pv)
+                                   {
+                                     if (pid != ID::CUETIME)
+                                       return true;
+                                     hasTime = true;
+                                     return Uint(pv, 0, time);
+                                   }))
+                       return false;
+                     return Children(v,
+                                     [&](uint32_t pid, std::string_view pv)
+                                     {
+                                       if (pid != ID::CUETRACKPOSITIONS || !hasTime)
+                                         return true;
+                                       uint64_t track = 0;
+                                       Cue c;
+                                       c.time = time;
+                                       bool hasCluster = false;
+                                       if (!Children(pv,
+                                                     [&](uint32_t qid, std::string_view qv)
+                                                     {
+                                                       uint64_t u = 0;
+                                                       switch (qid)
+                                                       {
+                                                         case ID::CUETRACK:
+                                                           return Uint(qv, 0, track);
+                                                         case ID::CUECLUSTERPOSITION:
+                                                           hasCluster = true;
+                                                           return Uint(qv, 0, c.cluster);
+                                                         case ID::CUERELATIVEPOSITION:
+                                                           if (!Uint(qv, 0, u))
+                                                             return false;
+                                                           c.relative = u;
+                                                           return true;
+                                                         case ID::CUEDURATION:
+                                                           if (!Uint(qv, 0, u))
+                                                             return false;
+                                                           c.duration = u;
+                                                           return true;
+                                                         default:
+                                                           return true;
+                                                       }
+                                                     }))
+                                         return false;
+                                       if (track && hasCluster)
+                                         ix.cues[track].push_back(c);
+                                       return true;
+                                     });
+                   });
+      if (!ok)
+        return fail(Outcome::MALFORMED, "the Cues element is not well formed");
+      ix.cuesRead = true;
+      for (auto& [track, list] : ix.cues)
+        std::stable_sort(list.begin(), list.end(),
+                         [](const Cue& a, const Cue& b) { return a.time < b.time; });
+    }
+  }
+  ix.outcome = Outcome::READ;
+  ix.bytes = f.Bytes();
+  ix.fetches = f.Fetches();
+  return ix;
+}
+
+//! A block of the subtitle track, as stored
+struct Block
+{
+  int64_t position = 0; //!< of the element in the file
+  std::string element; //!< the SimpleBlock or BlockGroup, its header included
+  uint64_t clusterTime = 0; //!< the Timestamp of its cluster
+  int64_t time = 0; //!< cluster + relative (TimestampScale units)
+  int64_t duration = -1; //!< BlockDuration, or the track's DefaultDuration; -1: none
+};
+
+//! How a search found its lines
+enum class Way
+{
+  NONE,
+  CUES, //!< the cues of the track, each read where it points
+  CUES_WALK, //!< the cues of the track, the block found by walking its cluster
+  WALK, //!< the clusters walked by the headers of their elements
+  WHOLE, //!< the clusters fetched whole in one range
+};
+
+inline const char* Name(Way w)
+{
+  switch (w)
+  {
+    case Way::NONE:
+      return "none";
+    case Way::CUES:
+      return "the cues of the track";
+    case Way::CUES_WALK:
+      return "the cues of the track, each cluster walked to its block";
+    case Way::WALK:
+      return "the headers of the clusters' elements";
+    case Way::WHOLE:
+      return "the clusters before the target, in one range";
+  }
+  return "?";
+}
+
+struct Request
+{
+  uint64_t track = 0;
+  int64_t target = 0; //!< the time the lines must be on screen at (TimestampScale units)
+  int64_t window = 0; //!< how long before the target a line without a known end may start
+  //! the player's time now (same units): a line that ends before it is not read; empty: the target
+  std::function<int64_t()> now;
+  //! each block on screen at the target, as soon as it is found
+  std::function<void(const Block&)> found;
+};
+
+struct Search
+{
+  Outcome outcome = Outcome::READ;
+  Way way = Way::NONE;
+  std::string why; //!< what could not be done, for the log
+  int found = 0;
+  int looked = 0; //!< blocks of the track read
+  int skippedEnded = 0; //!< lines whose cue said they had ended by the time they could be read
+  int mismatched = 0; //!< cues that did not point at a block of the track at their time
+  int hops = 0; //!< clusters passed over by their heads alone (WHOLE)
+  int64_t walkedFrom = -1; //!< the timestamp of the first cluster looked into (WALK, WHOLE)
+  int64_t bytes = 0;
+  int fetches = 0;
+};
+
+namespace DETAIL
+{
+class Searcher
+{
+public:
+  Searcher(const Index& ix,
+           ByteSource& source,
+           const Budget& budget,
+           const Request& rq,
+           std::function<bool()> stop)
+    : m_ix(ix),
+      m_budget(budget),
+      m_rq(rq),
+      m_f(source, ix.size, std::move(stop))
+  {
+    m_f.Allow(budget.maxBytes, budget.maxFetches, budget.chunk);
+    m_track = ix.Find(rq.track);
+  }
+
+  Search Run()
+  {
+    if (!m_track)
+      return Done(Outcome::MALFORMED, "the track is not in the file");
+    if (m_track->type != TRACK_SUBTITLE)
+      return Done(Outcome::MALFORMED, "the track is not a subtitle track");
+    if (m_track->timeScale != 1.0)
+      return Done(Outcome::READ, "the track has its own timestamp scale (TrackTimestampScale)");
+    const auto it = m_ix.cues.find(m_rq.track);
+    if (it != m_ix.cues.end() && !it->second.empty())
+      return ByCues(it->second);
+    if (m_budget.walk)
+      return Walk(false);
+    if (m_budget.wholeRange > 0)
+      return Walk(true);
+    m_s.why = "the track has no cues, and this source is not walked block by block";
+    return Done(Outcome::READ, m_s.why);
+  }
+
+private:
+  Search Done(Outcome o, std::string why)
+  {
+    m_s.outcome = o;
+    if (!why.empty())
+      m_s.why = std::move(why);
+    m_s.bytes = m_f.Bytes();
+    m_s.fetches = m_f.Fetches();
+    return m_s;
+  }
+
+  Search Failed(Got g, const std::string& what)
+  {
+    switch (g)
+    {
+      case Got::BUDGET:
+        return Done(Outcome::TOO_LARGE, what + ": over what this source allows");
+      case Got::FAILED:
+        return Done(Outcome::FETCH_FAILED, what + " could not be read");
+      case Got::STOPPED:
+        return Done(Outcome::STOPPED, "stopped");
+      default:
+        return Done(Outcome::MALFORMED, what + " is not well formed");
+    }
+  }
+
+  int64_t Now() const { return m_rq.now ? std::max(m_rq.now(), m_rq.target) : m_rq.target; }
+
+  //! The cluster at pos: its header and its Timestamp (the first of its children that is one)
+  Got ClusterHead(int64_t pos, Header& h, uint64_t& time, int64_t& dataStart)
+  {
+    if (const Got g = ReadHeader(m_f, pos, h); g != Got::OK)
+      return g;
+    if (h.id != ID::CLUSTER)
+      return Got::OUTSIDE;
+    dataStart = pos + h.length;
+    const int64_t end = h.unknownSize ? m_ix.segmentEnd
+                                      : std::min<int64_t>(m_ix.segmentEnd,
+                                                          dataStart + static_cast<int64_t>(h.size));
+    int64_t at = dataStart;
+    for (int k = 0; k < 8 && at < end; k++)
+    {
+      Header ch;
+      if (const Got g = ReadHeader(m_f, at, ch); g != Got::OK)
+        return g;
+      if (ch.unknownSize)
+        return Got::OUTSIDE;
+      if (ch.id == ID::TIMESTAMP)
+      {
+        std::string v;
+        if (const Got g = ReadData(m_f, at, ch, 8, v); g != Got::OK)
+          return g;
+        return Uint(v, 0, time) ? Got::OK : Got::OUTSIDE;
+      }
+      if (ch.id != ID::CRC32 && ch.id != ID::VOID)
+        break; // FFmpeg takes the Timestamp from before the first block
+      at += ch.length + static_cast<int64_t>(ch.size);
+    }
+    return Got::OUTSIDE;
+  }
+
+  //! The element at pos inside a cluster whose Timestamp is clusterTime: a block of the track, or
+  //! not (isOurs false; its size in skip either way)
+  Got ReadBlockAt(int64_t pos, uint64_t clusterTime, Block& b, bool& isOurs, int64_t& skip)
+  {
+    isOurs = false;
+    Header h;
+    if (const Got g = ReadHeader(m_f, pos, h); g != Got::OK)
+      return g;
+    if (h.unknownSize)
+      return Got::OUTSIDE;
+    skip = h.length + static_cast<int64_t>(h.size);
+    if (h.id != ID::SIMPLEBLOCK && h.id != ID::BLOCKGROUP)
+      return Got::OK;
+    uint64_t track = 0;
+    int16_t relative = 0;
+    uint8_t flags = 0;
+    int64_t duration = -1;
+    std::string head;
+    if (h.id == ID::SIMPLEBLOCK)
+    {
+      if (const Got g = m_f.Get(pos + h.length, std::min<int64_t>(11, h.size), head); g != Got::OK)
+        return g;
+      if (!BlockHead(head, track, relative, flags))
+        return Got::OUTSIDE;
+      if (track != m_rq.track)
+        return Got::OK;
+    }
+    else
+    {
+      // a group: its Block's head first; another track's group is passed over unread
+      const int64_t end = pos + skip;
+      int64_t at = pos + h.length;
+      bool block = false;
+      for (int k = 0; k < 16 && at < end && !block; k++)
+      {
+        Header ch;
+        if (const Got g = ReadHeader(m_f, at, ch); g != Got::OK)
+          return g;
+        if (ch.unknownSize || ch.size > static_cast<uint64_t>(end - at - ch.length))
+          return Got::OUTSIDE;
+        if (ch.id == ID::BLOCK)
+        {
+          if (const Got g = m_f.Get(at + ch.length, std::min<int64_t>(11, ch.size), head);
+              g != Got::OK)
+            return g;
+          if (!BlockHead(head, track, relative, flags))
+            return Got::OUTSIDE;
+          block = true;
+        }
+        at += ch.length + static_cast<int64_t>(ch.size);
+      }
+      if (!block || track != m_rq.track)
+        return Got::OK;
+    }
+    if (skip > MAX_BLOCK)
+      return Got::BUDGET;
+    std::string element;
+    if (const Got g = m_f.Get(pos, skip, element); g != Got::OK)
+      return g;
+    if (h.id == ID::BLOCKGROUP)
+    {
+      const std::string_view body = std::string_view(element).substr(static_cast<size_t>(h.length));
+      if (!Children(body,
+                    [&duration](uint32_t id, std::string_view v)
+                    {
+                      uint64_t d = 0;
+                      if (id != ID::BLOCKDURATION)
+                        return true;
+                      if (!Uint(v, 0, d))
+                        return false;
+                      duration = static_cast<int64_t>(d);
+                      return true;
+                    }))
+        return Got::OUTSIDE;
+    }
+    if (duration < 0 && m_track->defaultDuration)
+      duration = static_cast<int64_t>(m_track->defaultDuration / m_ix.timeScale);
+    isOurs = true;
+    b.position = pos;
+    b.element = std::move(element);
+    b.clusterTime = clusterTime;
+    b.time = static_cast<int64_t>(clusterTime) + relative;
+    b.duration = duration;
+    m_s.looked++;
+    return Got::OK;
+  }
+
+  //! On screen at the target: it starts at or before it and ends after it
+  bool OnScreen(const Block& b) const
+  {
+    return b.time <= m_rq.target && b.duration > 0 && b.time + b.duration > m_rq.target;
+  }
+
+  void Found(const Block& b)
+  {
+    // a block that two cues point at is given once
+    if (std::find(m_given.begin(), m_given.end(), b.position) != m_given.end())
+      return;
+    m_given.push_back(b.position);
+    m_s.found++;
+    if (m_rq.found)
+      m_rq.found(b);
+  }
+
+  Search ByCues(const std::vector<Cue>& cues)
+  {
+    m_s.way = Way::CUES;
+    // the cues of the lines that can be on screen at the target, the latest first
+    std::vector<const Cue*> wanted;
+    for (auto it = cues.rbegin(); it != cues.rend(); ++it)
+    {
+      const Cue& c = *it;
+      if (static_cast<int64_t>(c.time) > m_rq.target)
+        continue;
+      if (c.duration)
+      {
+        if (static_cast<int64_t>(c.time + *c.duration) > m_rq.target)
+          wanted.push_back(&c);
+      }
+      else if (static_cast<int64_t>(c.time) >= m_rq.target - m_rq.window)
+        wanted.push_back(&c);
+    }
+    std::map<int64_t, std::pair<uint64_t, int64_t>> heads; // cluster -> its time, its data
+    for (const Cue* c : wanted)
+    {
+      if (c->duration && static_cast<int64_t>(c->time + *c->duration) <= Now())
+      {
+        m_s.skippedEnded++;
+        continue;
+      }
+      const int64_t cluster = m_ix.segment + static_cast<int64_t>(c->cluster);
+      auto head = heads.find(cluster);
+      if (head == heads.end())
+      {
+        Header h;
+        uint64_t time = 0;
+        int64_t data = 0;
+        const Got g = ClusterHead(cluster, h, time, data);
+        if (g == Got::OUTSIDE)
+        {
+          m_s.mismatched++;
+          continue;
+        }
+        if (g != Got::OK)
+          return Failed(g, "the cluster a cue points at");
+        head = heads.emplace(cluster, std::make_pair(time, data)).first;
+      }
+      const auto [clusterTime, dataStart] = head->second;
+      Block b;
+      bool ours = false;
+      if (c->relative)
+      {
+        int64_t skip = 0;
+        const Got g =
+            ReadBlockAt(dataStart + static_cast<int64_t>(*c->relative), clusterTime, b, ours, skip);
+        if (g != Got::OK && g != Got::OUTSIDE)
+          return Failed(g, "a block a cue points at");
+        if (g == Got::OUTSIDE || !ours || b.time != static_cast<int64_t>(c->time))
+        {
+          m_s.mismatched++;
+          continue;
+        }
+      }
+      else
+      {
+        if (!m_budget.walk)
+        {
+          m_s.why = "the cues of the track do not say where in their cluster each block is "
+                    "(CueRelativePosition), and this source is not walked block by block";
+          return Done(Outcome::READ, "");
+        }
+        m_s.way = Way::CUES_WALK;
+        const Got g = FindInCluster(cluster, dataStart, clusterTime, c->time, b, ours);
+        if (g != Got::OK)
+          return Failed(g, "the cluster a cue points at");
+        if (!ours)
+        {
+          m_s.mismatched++;
+          continue;
+        }
+      }
+      if (OnScreen(b))
+        Found(b);
+    }
+    return Done(Outcome::READ, "");
+  }
+
+  //! Walk a cluster for the block of the track at time
+  Got FindInCluster(
+      int64_t cluster, int64_t dataStart, uint64_t clusterTime, uint64_t time, Block& b, bool& ours)
+  {
+    ours = false;
+    Header h;
+    if (const Got g = ReadHeader(m_f, cluster, h); g != Got::OK)
+      return g;
+    const int64_t end = h.unknownSize ? m_ix.segmentEnd
+                                      : std::min<int64_t>(m_ix.segmentEnd,
+                                                          dataStart + static_cast<int64_t>(h.size));
+    for (int64_t at = dataStart; at < end;)
+    {
+      Header ch;
+      if (const Got g = ReadHeader(m_f, at, ch); g != Got::OK)
+        return g;
+      if (ch.unknownSize || (h.unknownSize && IsLevel1(ch.id)))
+        return Got::OK;
+      int64_t skip = 0;
+      Block found;
+      bool isOurs = false;
+      if (const Got g = ReadBlockAt(at, clusterTime, found, isOurs, skip); g != Got::OK)
+        return g;
+      if (isOurs && found.time == static_cast<int64_t>(time) &&
+          std::find(m_given.begin(), m_given.end(), found.position) == m_given.end())
+      {
+        b = std::move(found);
+        ours = true;
+        return Got::OK;
+      }
+      at += skip;
+    }
+    return Got::OK;
+  }
+
+  //! The clusters from the window before the target (or before the one the player reads from)
+  Search Walk(bool whole)
+  {
+    m_s.way = whole ? Way::WHOLE : Way::WALK;
+    const int64_t from = m_rq.target - m_rq.window;
+    // where to start: the latest cluster that a cue of any track puts at or before the window
+    int64_t start = m_ix.firstCluster;
+    uint64_t startTime = 0;
+    for (const auto& [track, list] : m_ix.cues)
+      for (const Cue& c : list)
+        if (static_cast<int64_t>(c.time) <= from && c.time >= startTime)
+        {
+          startTime = c.time;
+          start = m_ix.segment + static_cast<int64_t>(c.cluster);
+        }
+    if (start < 0)
+      return Done(Outcome::READ, "neither cues nor the first cluster are known");
+    // where the player's demuxer starts after the seek: the cluster of the video track's cue at
+    // or before the target (matroska_read_seek() on the first video stream); its blocks reach the
+    // player without this
+    int64_t stopAt = m_ix.segmentEnd;
+    if (const Track* video = m_ix.Video())
+      if (const auto it = m_ix.cues.find(video->number); it != m_ix.cues.end())
+        for (const Cue& c : it->second)
+          if (static_cast<int64_t>(c.time) <= m_rq.target)
+            stopAt = m_ix.segment + static_cast<int64_t>(c.cluster);
+    if (whole)
+    {
+      if (stopAt >= m_ix.segmentEnd)
+        return Done(Outcome::READ, "the video track has no cues: where the player reads from is "
+                                   "not known");
+      if (stopAt <= start)
+        return Done(Outcome::READ, "");
+      // closer: from the latest cluster a cue knows that leaves at least the range to fetch, then
+      // cluster by cluster by their heads alone while what is left does not fit in what may be
+      // fetched whole; the window is then shorter (walkedFrom says from where)
+      if (stopAt - start > m_budget.wholeRange)
+        for (const auto& [track, list] : m_ix.cues)
+          for (const Cue& c : list)
+          {
+            const int64_t p = m_ix.segment + static_cast<int64_t>(c.cluster);
+            if (p > start && p <= stopAt - m_budget.wholeRange)
+              start = p;
+          }
+      while (stopAt - start > m_budget.wholeRange)
+      {
+        Header h;
+        uint64_t time = 0;
+        int64_t data = 0;
+        const Got g = ClusterHead(start, h, time, data);
+        if (g != Got::OK && g != Got::OUTSIDE)
+          return Failed(g, "the clusters before the target");
+        if (g == Got::OUTSIDE || h.unknownSize)
+          return Done(Outcome::TOO_LARGE, "the clusters before the target cannot be passed over by "
+                                          "their heads");
+        m_s.hops++;
+        start = data + static_cast<int64_t>(h.size);
+        if (start >= stopAt)
+          return Done(Outcome::TOO_LARGE,
+                      "the cluster before the one the player reads from is over the " +
+                          std::to_string(m_budget.wholeRange) + " bytes this source allows now");
+      }
+      // the range, then the walk inside it
+      if (const Got g = m_f.Load(start, stopAt - start); g != Got::OK)
+        return Failed(g, "the clusters before the target");
+    }
+    // a walk goes on to the cluster of the target: it costs little, and the player may read from a
+    // later keyframe than the cues give (one it indexed while reading); what both read, it takes once
+    const int64_t walkEnd = whole ? stopAt : m_ix.segmentEnd;
+    for (int64_t pos = start; pos < m_ix.segmentEnd && pos < walkEnd;)
+    {
+      Header h;
+      uint64_t clusterTime = 0;
+      int64_t dataStart = 0;
+      const Got g = ReadHeader(m_f, pos, h);
+      if (g != Got::OK)
+        return g == Got::OUTSIDE ? Done(Outcome::READ, "") : Failed(g, "a cluster");
+      if (h.id != ID::CLUSTER)
+      {
+        if (h.unknownSize || (!IsLevel1(h.id) && h.id != ID::VOID))
+          return Done(Outcome::READ, "");
+        pos += h.length + static_cast<int64_t>(h.size);
+        continue;
+      }
+      if (const Got cg = ClusterHead(pos, h, clusterTime, dataStart); cg != Got::OK)
+        return cg == Got::OUTSIDE ? Done(Outcome::MALFORMED, "a cluster without its timestamp")
+                                  : Failed(cg, "a cluster");
+      if (static_cast<int64_t>(clusterTime) > m_rq.target)
+        break;
+      const int64_t end =
+          h.unknownSize
+              ? m_ix.segmentEnd
+              : std::min<int64_t>(m_ix.segmentEnd, dataStart + static_cast<int64_t>(h.size));
+      // a cluster wholly before the window is passed over: the next one starts at or before it
+      bool before = false;
+      if (!h.unknownSize && end < m_ix.segmentEnd && end < walkEnd)
+      {
+        Header nh;
+        uint64_t nextTime = 0;
+        int64_t nextData = 0;
+        const Got ng = ClusterHead(end, nh, nextTime, nextData);
+        if (ng != Got::OK && ng != Got::OUTSIDE)
+          return Failed(ng, "a cluster");
+        before = ng == Got::OK && static_cast<int64_t>(nextTime) <= from;
+      }
+      if (!before && m_s.walkedFrom < 0)
+        m_s.walkedFrom = static_cast<int64_t>(clusterTime);
+      int64_t at = dataStart;
+      while (!before && at < end)
+      {
+        Header ch;
+        const Got hg = ReadHeader(m_f, at, ch);
+        if (hg != Got::OK)
+          return hg == Got::OUTSIDE ? Done(Outcome::MALFORMED, "a cluster is not well formed")
+                                    : Failed(hg, "a block");
+        if (ch.unknownSize || (h.unknownSize && IsLevel1(ch.id)))
+          break;
+        Block b;
+        bool ours = false;
+        int64_t skip = 0;
+        const Got bg = ReadBlockAt(at, clusterTime, b, ours, skip);
+        if (bg != Got::OK)
+          return bg == Got::OUTSIDE ? Done(Outcome::MALFORMED, "a block is not well formed")
+                                    : Failed(bg, "a block");
+        if (ours && OnScreen(b))
+        {
+          if (b.time + b.duration > Now())
+            Found(b);
+          else
+            m_s.skippedEnded++;
+        }
+        at += skip;
+      }
+      pos = end;
+    }
+    return Done(Outcome::READ, "");
+  }
+
+  const Index& m_ix;
+  const Budget m_budget;
+  const Request& m_rq;
+  Fetcher m_f;
+  const Track* m_track = nullptr;
+  std::vector<int64_t> m_given; //!< the positions of the blocks given
+  Search m_s;
+};
+} // namespace DETAIL
+
+/*!
+ * \brief The blocks of a subtitle track on screen at a time (see above), each given to rq.found as
+ *        it is found
+ */
+inline Search Find(const Index& ix,
+                   ByteSource& source,
+                   const Budget& budget,
+                   const Request& rq,
+                   std::function<bool()> stop = {})
+{
+  return DETAIL::Searcher(ix, source, budget, rq, std::move(stop)).Run();
+}
+
+/*!
+ * \brief A Matroska file of one block: an EBML header of the file's DocType, a Segment with the
+ *        Info's TimestampScale, the TrackEntry of the track as the file stores it, and a Cluster
+ *        with the block's cluster Timestamp and the block as stored. FFmpeg's demuxer makes of it
+ *        the packet it makes of that block in the file.
+ */
+inline std::string MiniFile(const Index& ix, const Track& track, const Block& block)
+{
+  using namespace DETAIL;
+  std::string ebml;
+  PutUint(ebml, ID::EBMLVERSION, 1);
+  PutUint(ebml, ID::EBMLREADVERSION, 1);
+  PutUint(ebml, ID::EBMLMAXIDLENGTH, 4);
+  PutUint(ebml, ID::EBMLMAXSIZELENGTH, 8);
+  PutElement(ebml, ID::DOCTYPE, ix.docType);
+  PutUint(ebml, ID::DOCTYPEVERSION, 4);
+  PutUint(ebml, ID::DOCTYPEREADVERSION, 2);
+  std::string info;
+  PutUint(info, ID::TIMESTAMPSCALE, ix.timeScale);
+  std::string cluster;
+  PutUint(cluster, ID::TIMESTAMP, block.clusterTime);
+  cluster += block.element;
+  std::string segment;
+  PutElement(segment, ID::INFO, info);
+  PutElement(segment, ID::TRACKS, track.entry);
+  PutElement(segment, ID::CLUSTER, cluster);
+  std::string file;
+  PutElement(file, ID::EBML, ebml);
+  PutElement(file, ID::SEGMENT, segment);
+  return file;
+}
+
+/*!
+ * \brief CDVDDemuxFFmpeg::ConvertTimestamp() of a timestamp in the time base num/den, with the
+ *        start time (s) of the file as that demuxer subtracts it: DVD_TIME_BASE (1e6) units
+ */
+inline double PlayerTime(int64_t pts, int num, int den, double startTime)
+{
+  double timestamp = static_cast<double>(pts) * num / den;
+  if (timestamp > startTime)
+    timestamp -= startTime;
+  else if (timestamp + 0.5 > startTime)
+    timestamp = 0;
+  return timestamp * 1000000.0;
+}
+
+/*!
+ * \brief The other way: a player time (DVD_TIME_BASE units) as a timestamp of the file
+ *        (TimestampScale units)
+ */
+inline int64_t FileTime(double playerTime, double startTime, uint64_t timeScale)
+{
+  return static_cast<int64_t>(
+      std::llround((playerTime / 1000000.0 + startTime) * 1e9 / static_cast<double>(timeScale)));
+}
+
+} // namespace MKV_SUBSEEK
