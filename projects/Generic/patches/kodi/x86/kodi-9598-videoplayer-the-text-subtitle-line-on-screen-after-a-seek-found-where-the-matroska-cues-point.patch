+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct DemuxPacket;
+
+/*!
+ * \brief Hades: after a seek in a Matroska file, the text subtitle lines that are on screen at the
+ *        target but stored before the cluster the demuxer starts reading at, found in the file on a
+ *        thread of its own (DVDDemuxers/MatroskaSubtitleSeek.h says how).
+ *
+ * FFmpeg's demuxer seeks on the video keyframe at or before the target: a line that started before
+ * that keyframe's cluster is not read again, and stays off screen until the next one. The search
+ * reads only what the cues point at where they can (the line's cluster head and block, a few
+ * hundred bytes), and nothing that the player is waiting for: it has its own reader of the file,
+ * runs at the lowest priority, is stopped by a newer seek, and never holds the player's thread. The
+ * packets it finds are those FFmpeg's demuxer makes of those blocks; the player takes them on its
+ * own thread (Take()) and shows the ones still on screen.
+ *
+ * What it may read, by where the file is:
+ * - on this device: the cues (KB), or without them the clusters of the 30 s before the target
+ *   walked by the headers of their elements; 32 MiB, 4000 reads, 2 s at most;
+ * - on the local network (SMB, NFS, or HTTP to a local address): the cues, or the clusters of the
+ *   15 s before the target walked by their headers; 16 MiB, 1500 reads, 3 s at most;
+ * - over the internet (HTTP): the cues, two small requests for each line (12 at most); without
+ *   them, the clusters just before the one the player reads from, fetched in one range of at most
+ *   what the player received in a second before the seek (8 MiB at most), at a quarter of that rate,
+ *   once playback has resumed. A server that refuses a range (429, 403...) is not asked again for
+ *   that file.
+ * Without cues for the track a walk or a range waits for playback to resume after the seek, so that
+ * the player's own reading after the seek comes first. kodi.log says what was found, and what could
+ * not be searched and why.
+ */
+class CSubtitleSeekSearch
+{
+public:
+  struct Target
+  {
+    std::string path; //!< what the player opened (an add-on's item resolved: its URL)
+    int64_t size = -1; //!< of the file, as the player's input stream has it
+    unsigned stream = 0; //!< FFmpeg's stream
+    unsigned trackStreams = 0; //!< the streams FFmpeg made of the file's tracks
+    int timeBaseNum = 0;
+    int timeBaseDen = 0;
+    double startTime = 0.0; //!< s, as CDVDDemuxFFmpeg::ConvertTimestamp() takes it off
+    int streamId = -1; //!< of the packets, as the demuxer gives them
+    int64_t demuxerId = -1;
+    double target = 0.0; //!< the time the subtitles are looked up at (DVD_TIME_BASE)
+    uint32_t readRate = 0; //!< bytes/s the player's cache read before the seek (0: not known)
+    double durationSeconds = 0.0; //!< of the file (0: not known)
+  };
+
+  CSubtitleSeekSearch();
+  ~CSubtitleSeekSearch();
+  CSubtitleSeekSearch(const CSubtitleSeekSearch&) = delete;
+  CSubtitleSeekSearch& operator=(const CSubtitleSeekSearch&) = delete;
+
+  //! A search for target: the one before it stops, and what it found is not given
+  void Start(const Target& target);
+  //! No search: the one running stops, and what it found is not given
+  void Stop();
+  //! The player's time the subtitles are at (DVD_TIME_BASE): a line that ended is not read
+  void SetClock(double now);
+  //! What the latest search found since the last call, oldest first: the caller frees them
+  std::vector<DemuxPacket*> Take();
+  //! The latest search's target (DVD_TIME_BASE)
+  double LatestTarget() const;
+
+  struct Shared;
+
+private:
+  std::shared_ptr<Shared> m_shared;
+};
+
+namespace SUBTITLE_SEEK
+{
+/*!
+ * \brief Kodi is closing (CApplication::Stop(), before the network services and the SMB client go
+ *        away): every search stops, none starts, and those blocked in a read of a file server
+ *        are waited for (that client's timeout); one left after that is said in the log
+ */
+void StopSearches();
+} // namespace SUBTITLE_SEEK
