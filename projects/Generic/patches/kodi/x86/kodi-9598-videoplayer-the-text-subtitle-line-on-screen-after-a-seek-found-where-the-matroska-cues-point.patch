+void CVideoPlayer::StartSubtitleSearch(double target)
+{
+  m_subtitleSearch->Stop();
+  // a stream of the file's own demuxer, of a file that is not realtime, on the player's timeline
+  if (m_CurrentSubtitle.id < 0 || m_CurrentSubtitle.source != STREAM_SOURCE_DEMUX ||
+      !m_pInputStream || m_pInputStream->IsRealtime() ||
+      !m_pInputStream->IsStreamType(DVDSTREAM_TYPE_FILE) || m_offset_pts != 0.0 ||
+      m_State.time_offset != 0.0 || !m_VideoPlayerSubtitle->SearchesAfterSeek())
+    return;
+  auto* ffmpeg = dynamic_cast<CDVDDemuxFFmpeg*>(m_pDemuxer.get());
+  if (!ffmpeg || ffmpeg->GetDemuxerId() != m_CurrentSubtitle.demuxerId)
+    return;
+  CDVDDemuxFFmpeg::MatroskaStream stream;
+  if (!ffmpeg->GetMatroskaStream(m_CurrentSubtitle.id, stream))
+    return;
+  CSubtitleSeekSearch::Target t;
+  t.path = m_item.GetDynPath();
+  t.size = m_pInputStream->GetLength();
+  t.stream = stream.index;
+  t.trackStreams = stream.trackStreams;
+  t.timeBaseNum = stream.timeBaseNum;
+  t.timeBaseDen = stream.timeBaseDen;
+  t.startTime = stream.startTime;
+  t.streamId = m_CurrentSubtitle.id;
+  t.demuxerId = m_CurrentSubtitle.demuxerId;
+  t.target = target;
+  t.readRate = m_cacheReadRate;
+  m_subtitleSearch->Start(t);
+}
+
+void CVideoPlayer::DeliverFoundSubtitles()
+{
+  const double now =
+      m_clock.GetClock() + m_State.time_offset - m_VideoPlayerVideo->GetSubtitleDelay();
+  m_subtitleSearch->SetClock(now);
+  std::vector<DemuxPacket*> found = m_subtitleSearch->Take();
+  if (found.empty())
+    return;
+  // a line is shown while it is on screen: from the target (the clock is set to it at the seek) on
+  const double from = std::max(now, m_subtitleSearch->LatestTarget());
+  int ended = 0;
+  for (DemuxPacket* pkt : found)
+  {
+    if (pkt->iStreamId == m_CurrentSubtitle.id && pkt->demuxerId == m_CurrentSubtitle.demuxerId)
+    {
+      UpdateCorrection(pkt, m_offset_pts);
+      if (pkt->pts != DVD_NOPTS_VALUE && pkt->pts + pkt->duration > from)
+        m_VideoPlayerSubtitle->GiveFound(pkt);
+      else
+        ended++;
+    }
+    CDVDDemuxUtils::FreeDemuxPacket(pkt);
+  }
+  if (ended > 0)
+    CLog::Log(LOGINFO,
+              "CSubtitleSeekSearch: {} subtitle line(s) found after the seek to {:.3f} s had ended "
+              "by the time they were found: not shown",
+              ended, m_subtitleSearch->LatestTarget() / DVD_TIME_BASE);
+}
