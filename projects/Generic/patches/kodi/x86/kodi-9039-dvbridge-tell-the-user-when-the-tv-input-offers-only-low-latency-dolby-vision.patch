 }
 
+void CWinSystemGbm::DVStreamWithoutNativeOutput()
+{
+  // Not while the display's information may be old: its EDID could not be read, or it is gone
+  if (m_dvEdidUnread || m_displayGone)
+    return;
+  const auto info = DVDisplayInfo();
+  if (!info || !info->SupportsLowLatencyDolbyVisionOnly())
+    return;
+  const unsigned int generation = m_dvDisplayGeneration;
+  if (m_dvLowLatencyTold.exchange(generation) == generation)
+    return;
+  CLog::Log(LOGINFO, "DVBridge: the display offers Dolby Vision Low-Latency only (a TV input in its "
+                     "game mode); the user is told how to get native Dolby Vision");
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, "Dolby Vision",
+                                        CGUIUtils::GetHadesString(39999, 31689), 15000);
+}
+
 bool CWinSystemGbm::CheckDisplayChange()
 {
   auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
@@ -618,13 +637,16 @@ bool CWinSystemGbm::CheckDisplayChange()
     std::unique_lock lock(m_infoLock);
     m_dvInfo = changed;
   }
+  // Only a change of what native output depends on counts (not, for example, the audio formats of
+  // a sound bar behind the TV); it also allows the Low-Latency notification again.
+  const bool dvChanged = DVCapabilities(info.get()) != DVCapabilities(changed.get());
+  if (dvChanged)
+    m_dvDisplayGeneration++;
   if (changed->SupportsDolbyVision())
     m_dvDisplaySeen = true;
   CLog::Log(LOGINFO, "DVBridge: the display's EDID changed; Dolby Vision Standard: {}",
             changed->SupportsStandardDolbyVision() ? "yes" : "no");
-  // Only a change of what native output depends on counts (not, for example, the audio formats of
-  // a sound bar behind the TV).
-  return back || DVCapabilities(info.get()) != DVCapabilities(changed.get());
+  return back || dvChanged;
 }
 
 bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 7a9c455..a298339 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -77,6 +77,12 @@ public:
   void DVVideoOpened();
   //! Native output has worked for a minute: after a later failure, the next video tries it again.
   void DVOutputWorked();
+  //! A Dolby Vision video opened without native output (VideoPlayer): when the display offers Dolby
+  //! Vision Low-Latency only (a TV input in its game mode, which native output does not use), a
+  //! notification tells the user how to get native output, once for each state of the display
+  //! (again after what native output depends on changes, or after a restart), instead of a silent
+  //! fallback. Not while the display's information may be old (EDID not read, display gone).
+  void DVStreamWithoutNativeOutput();
   //! Short code of the reason why native Dolby Vision output is unavailable, from the last
   //! SupportsNativeDVOutput() verdict: failed, edid, invalid, legacy, display, output, range, rate
   //! or mode; empty if available.
@@ -160,6 +166,10 @@ protected:
   unsigned int m_dvRetryBackoff{0}; //!< the wait after the last failure: 1, 2, 4, 8
   std::vector<uint8_t> m_displayEdid; //!< set at init, then only by DVNewVideo (VideoPlayer)
   std::atomic<bool> m_displayGone{false};
+  //! Counts the changes of what native output depends on in the display information (m_dvInfo)
+  std::atomic<unsigned int> m_dvDisplayGeneration{0};
+  //! The m_dvDisplayGeneration the Low-Latency notification was shown for, none yet
+  std::atomic<unsigned int> m_dvLowLatencyTold{~0u};
   //! The kernel Dolby Vision backend is amdgpu's, which takes the displays of the rule of
   //! CDisplayInfo::SupportsStandardDolbyVision(); the i915/xe one takes 12-byte version 2 blocks
   //! only, in an EDID without an extension override.
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0dd61de..91de313 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -661,6 +661,12 @@ void DVBRIDGE::VideoOpened()
     window->DVVideoOpened();
 }
 
+void DVBRIDGE::DolbyVisionWithoutNativeOutput()
+{
+  if (auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem()))
+    window->DVStreamWithoutNativeOutput();
+}
+
 bool CWinSystemGbmGLESContext::DVBridgeRequested(const VideoPicture* picture)
 {
   return DVBRIDGE::WantsNativeOutput(picture);
