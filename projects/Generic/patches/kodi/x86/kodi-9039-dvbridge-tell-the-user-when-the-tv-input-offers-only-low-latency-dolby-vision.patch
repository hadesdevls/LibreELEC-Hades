diff --git a/xbmc/guilib/GUIUtils.cpp b/xbmc/guilib/GUIUtils.cpp
index 089f2b0..4df7dca 100644
--- a/xbmc/guilib/GUIUtils.cpp
+++ b/xbmc/guilib/GUIUtils.cpp
@@ -29,3 +29,21 @@ std::string CGUIUtils::GetLocalizedString(uint32_t id)
   }
   return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(id);
 }
+
+std::string CGUIUtils::GetHadesString(uint32_t coreId, uint32_t estuaryId)
+{
+  auto gui = CServiceBroker::GetGUI();
+  if (gui)
+  {
+    auto skin = gui->GetSkinInfo();
+    if (skin && skin->ID() == "skin.estuary")
+    {
+      std::string text =
+          CServiceBroker::GetResourcesComponent().GetLocalizeStrings().GetAddonString(skin->ID(),
+                                                                                    estuaryId);
+      if (!text.empty())
+        return text;
+    }
+  }
+  return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(coreId);
+}
