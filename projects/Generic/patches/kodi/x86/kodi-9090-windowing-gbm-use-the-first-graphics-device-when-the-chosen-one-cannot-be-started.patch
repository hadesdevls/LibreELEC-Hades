From c2e0ea542e5d34d4eee0de7e42a458a913ddfa62 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 11 Oct 2026 09:14:48 +0000
Subject: [PATCH] windowing/gbm: use the first graphics device when the chosen
 one cannot be started

Of several graphics devices, the one whose display ranks highest is
used, if it can be opened, has outputs, can draw and has atomic
modesetting. A device can pass all of that and still fail to start (its
planes, or the GBM device that Kodi draws with). Before the choice
existed, Kodi would have come up on the first device that has a
display; with it, there was no picture at all.

When the device that was chosen among several cannot be started, Kodi
starts once more with the choice turned off for good: the first device
that has a display, as it always was. A failure later than that, in
EGL, is not covered.

Asked for by the independent review. Read, not run: no machine at hand
has a device that fails that way.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 30 ++++++++++++++++++++++++++++-
 xbmc/windowing/gbm/drm/DRMUtils.cpp |  4 +++-
 xbmc/windowing/gbm/drm/DRMUtils.h   | 11 +++++++++++
 3 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 0101ac3..2b68a8e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -147,7 +147,22 @@ bool CWinSystemGbm::InitWindowSystem()
 
   m_DRM = std::make_shared<CDRMAtomic>();
 
-  if (!m_DRM->InitDrm())
+  bool started = m_DRM->InitDrm();
+  if (!started && CDRMUtils::ChosenAmongDevices())
+  {
+    // One of several graphics devices was chosen for its display (CDRMUtils::OpenDrm()) and
+    // cannot be started: the first device that has a display is taken, as it was before that
+    // choice existed. What that device cannot do either is found as it always was, below.
+    CLog::Log(LOGWARNING,
+              "CWinSystemGbm::{} - the graphics device chosen for its display cannot be started: "
+              "the first one that has a display is used",
+              __FUNCTION__);
+    CDRMUtils::UseFirstDevice();
+    m_DRM = std::make_shared<CDRMAtomic>();
+    started = m_DRM->InitDrm();
+  }
+
+  if (!started)
   {
     CLog::Log(LOGERROR, "CWinSystemGbm::{} - failed to initialize Atomic DRM", __FUNCTION__);
     m_DRM.reset();
@@ -208,6 +223,19 @@ bool CWinSystemGbm::InitWindowSystem()
 
   if (!m_GBM->CreateDevice(m_DRM->GetFileDescriptor()))
   {
+    if (CDRMUtils::ChosenAmongDevices())
+    {
+      // (as above, when it is drawing with that device that cannot be set up: once more from
+      // the start, with the first device that has a display)
+      CLog::Log(LOGWARNING,
+                "CWinSystemGbm::{} - the graphics device chosen for its display cannot draw: "
+                "the first one that has a display is used",
+                __FUNCTION__);
+      CDRMUtils::UseFirstDevice();
+      m_DRM.reset();
+      return InitWindowSystem();
+    }
+
     m_GBM.reset();
     m_DRM.reset();
     return false;
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index dd51190..eace926 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -708,7 +708,7 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
   m_deviceName.clear();
   m_otherOutputs.clear();
   m_otherDeviceNodes.clear();
-  if (needConnector)
+  if (needConnector && !m_useFirstDevice)
   {
     std::string asked = "Default";
     const auto settingsComponent = CServiceBroker::GetSettingsComponent();
@@ -754,6 +754,8 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
     }
   }
 
+  m_chosenAmongDevices = chosen != nullptr;
+
   for (const auto device : devices)
   {
     if (!(device->available_nodes & 1 << DRM_NODE_PRIMARY))
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index c23a365..893bdcd 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -97,6 +97,15 @@ public:
   bool HasQuirk(int quirk) const { return m_drm_quirks & quirk; }
 
   std::vector<std::string> GetConnectedConnectorNames();
+  //! With several graphics devices: whether the one that is open was chosen among them for its
+  //! display (OpenDrm()); and a way to have the first one that has a display taken from then on,
+  //! as it was before that choice existed, for when the one that was chosen cannot be started.
+  static bool ChosenAmongDevices() { return m_chosenAmongDevices; }
+  static void UseFirstDevice()
+  {
+    m_useFirstDevice = true;
+    m_chosenAmongDevices = false;
+  }
   //! Whether an output named in the settings is the one in use
   bool IsCurrentOutput(const std::string& asked);
 
@@ -159,6 +168,8 @@ private:
   const char* m_renderDevicePath{nullptr};
 
   int m_drm_quirks{0};
+  static inline bool m_chosenAmongDevices{false};
+  static inline bool m_useFirstDevice{false};
   //! What tells this device from the others in the name of an output (DRMOutputChoice.h), when
   //! it was chosen among several. Empty when there was nothing to choose: it is the driver then.
   std::string m_deviceName;
-- 
