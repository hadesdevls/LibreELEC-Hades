From c4af9b8d671c04dff54fbed81acc87635641a47e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:13:23 +0000
Subject: [PATCH] windowing/gbm: the GUI pass is left out only after a Dolby
 Vision picture was drawn

A disc menu without a picture draws its graphics in the GUI pass (RenderManager::
RenderWithoutPicture()), and an unconfigured renderer draws nothing: in both the
frame before had no Dolby Vision picture, and the GUI may change where no dirty
region says so. GuiPassReusable() now also asks that RenderDVBridge() ran in the
frame before (Facts::video, rotated in CompositeGui() so that the decision in
FrameMove() and the one in BeginGuiComposite() see the same value).

Host test (outside the tree): dvguireuse_test with the new fact in both directions.
---
 xbmc/windowing/gbm/DVGuiReuse.h                | 11 ++++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp |  6 ++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  3 +++
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index e529d8c..ca812e2 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -40,7 +40,8 @@ namespace GBM
  * changed), stereoscopic 3D (two passes), overlays on the picture that are drawn in the GUI pass
  * (subtitles, the debug information of the player: they are not left to the dirty regions alone),
  * a frame with the GUI that was not seen yet by the picture's pass (what it was over was not
- * known). A capture marks the window manager dirty itself (CApplication::FrameMove()).
+ * known), a frame before without a Dolby Vision picture (graphics of a disc menu without a picture
+ * are drawn by the GUI pass). A capture marks the window manager dirty itself (CApplication::FrameMove()).
  */
 class CDVGuiReuse
 {
@@ -57,6 +58,9 @@ public:
     bool overlays = false; //!< subtitles or the debug information are over the picture
     bool seen = false; //!< a frame whose GUI was drawn went through the picture's pass since
                        //!< the FBO was made, and its elements are known
+    bool video = false; //!< the picture's pass (RenderDVBridge()) ran in the frame before: a disc
+                        //!< menu without a picture, or a renderer that is not configured, draws its
+                        //!< graphics in the GUI pass, and changes them where nothing says so
   };
 
   enum class Why
@@ -71,6 +75,7 @@ public:
     STEREO,
     OVERLAYS,
     NOT_SEEN,
+    NO_VIDEO,
   };
 
   static Why Check(const Facts& f)
@@ -93,6 +98,8 @@ public:
       return Why::OVERLAYS;
     if (!f.seen)
       return Why::NOT_SEEN;
+    if (!f.video)
+      return Why::NO_VIDEO;
     return Why::NONE;
   }
 
@@ -120,6 +127,8 @@ public:
         return "subtitles or the debug information are over the picture";
       case Why::NOT_SEEN:
         return "no frame of the GUI has been seen by the picture's pass yet";
+      case Why::NO_VIDEO:
+        return "the frame before had no Dolby Vision picture";
     }
     return "?";
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 34a42fe..5381705 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2087,6 +2087,10 @@ void CWinSystemGbmGLESContext::EndGuiComposite()
 // the next frame's rendering sets its own state.
 void CWinSystemGbmGLESContext::CompositeGui()
 {
+  // Hades: whether the picture's pass ran in this frame is what the next frame may rely on
+  m_guiVideoLast = m_guiVideoNow;
+  m_guiVideoNow = false;
+
   if (!m_guiFbo.IsValid() || !m_guiFbo.IsBound() || !m_compositeShader)
     return;
 
@@ -5331,6 +5335,7 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
                                             bool measuredPicture,
                                             unsigned int hdr10Plus)
 {
+  m_guiVideoNow = true; // (Hades: GuiPassReusable())
   m_dvFrame = false;
   m_dvRepeat = false;
   m_dvPrepared = {};
@@ -6158,6 +6163,7 @@ CDVGuiReuse::Facts CWinSystemGbmGLESContext::GuiReuseFacts() const
              RenderStereoMode::OFF;
   f.overlays = m_dvOverlays;
   f.seen = m_guiSeen;
+  f.video = m_guiVideoLast;
   return f;
 }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index d2cc079..3ac40e8 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -450,6 +450,9 @@ private:
   bool m_guiReusing{false};
   //! Hades: a frame whose GUI was drawn was composited since the FBO was made (CDVGuiReuse::Facts)
   bool m_guiSeen{false};
+  //! Hades: RenderDVBridge() ran in this frame, and in the frame before it
+  bool m_guiVideoNow{false};
+  bool m_guiVideoLast{false};
   CDVGuiReuse m_dvGuiReuse;
   CDVGuiReuse::Facts GuiReuseFacts() const;
   void DVGuiReuseTell();
-- 
2.53.0

