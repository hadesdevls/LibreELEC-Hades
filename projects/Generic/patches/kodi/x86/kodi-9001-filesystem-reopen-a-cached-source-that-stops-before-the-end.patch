From 43b77bd80102fc276fa145fc05c0c5f789f99837 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 00:42:54 +0000
Subject: [PATCH] filesystem: reopen a cached source that stops before the end
 of the file

A debrid CDN answered the range request that Kodi sent after a subtitle
stream change (VideoPlayer seeks back to the current time for embedded
subtitles) with HTTP 429. CCurlFile::Seek() only treats a negative
response from Connect() as a failure, so the seek looked successful,
CFileCache reset the cache for it, the next read returned no data, and
CFileCache::Process() reported the end of the file: the demuxer hit EOF
and playback ended 13 % into the film.

CFileCache already retries a read that returns nothing while data is
left in the cache. When the cache is empty and the source stopped before
the known file size, reopen the source at the write position (a new
range request) up to 4 times, after pauses of 0.5, 1, 2 and 4 s. That is
7.5 s in all, within the 10 s that CFileCache::Read() waits for data,
so the reader keeps waiting instead of seeing EOF. A seek request or
StopThread() interrupts the pause. The counter restarts after any
successful read or seek. Sources of unknown size (live streams) and a
real end of file behave as before.

The change stays in the cache thread: CCurlFile, which the GUI thread
also uses, is unchanged.
---
 xbmc/filesystem/FileCache.cpp | 36 +++++++++++++++++++++++++++++++++++
 xbmc/filesystem/FileCache.h   |  1 +
 2 files changed, 37 insertions(+)

diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index 4131947..38afbfe 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -37,6 +37,11 @@ using namespace XFILE;
 
 namespace
 {
+// A source that stops before the end of the file is reopened this many times, after pauses of
+// 0.5, 1, 2 and 4 s: 7.5 s in all, within the 10 s that Read() waits for data.
+constexpr int MAX_SOURCE_REOPENS = 4;
+constexpr std::chrono::milliseconds FIRST_REOPEN_PAUSE{500};
+
 class CFileCacheSource final : public IFileCacheSource
 {
 public:
@@ -347,6 +352,7 @@ void CFileCache::Process()
         m_nSeekResult = m_seekPos;
         m_seekError = 0;
         m_sourcePositionValid = true;
+        m_sourceReopens = 0;
         if (bCompleteReset)
         {
           CLog::Log(LOGDEBUG,
@@ -426,6 +432,33 @@ void CFileCache::Process()
         // and retry:
         continue; // while (!m_bStop)
       }
+      else if (m_fileSize != 0 && m_writePos < m_fileSize &&
+               m_sourceReopens < MAX_SOURCE_REOPENS)
+      {
+        // The source stopped before the end of the file and nothing is left in the cache. An HTTP
+        // server may answer the range request of a seek with 429 (too many requests) or 503;
+        // CCurlFile then reports a successful seek followed by no data, and reporting EOF here
+        // would end playback. Reopen the source at the write position after a short pause that
+        // grows with each attempt; a seek request or StopThread() interrupts the pause.
+        const auto pause = FIRST_REOPEN_PAUSE * (1 << m_sourceReopens);
+        m_sourceReopens++;
+        CLog::Log(LOGWARNING,
+                  "CFileCache::{} - <{}> source read returned {} at {} of {} bytes, reopening it in "
+                  "{} ms (attempt {} of {})",
+                  __FUNCTION__, m_sourcePath, iRead, m_writePos, m_fileSize.load(),
+                  pause.count(), m_sourceReopens, MAX_SOURCE_REOPENS);
+        if (m_seekEvent.Wait(pause))
+        {
+          if (!m_bStop)
+            m_seekEvent.Set(); // hack so that later we realize seek is needed
+          continue; // while (!m_bStop)
+        }
+        const int64_t reopened = m_source->Seek(m_writePos, SEEK_SET);
+        if (reopened != m_writePos)
+          CLog::Log(LOGWARNING, "CFileCache::{} - <{}> reopening at {} returned {}", __FUNCTION__,
+                    m_sourcePath, m_writePos, reopened);
+        continue; // while (!m_bStop)
+      }
       else
       {
         if (iRead < 0)
@@ -457,6 +490,9 @@ void CFileCache::Process()
       }
     }
 
+    if (iRead > 0)
+      m_sourceReopens = 0;
+
     int iTotalWrite = 0;
     while (!m_bStop && (iTotalWrite < iRead))
     {
diff --git a/xbmc/filesystem/FileCache.h b/xbmc/filesystem/FileCache.h
index c5cb97a..de4b221 100644
--- a/xbmc/filesystem/FileCache.h
+++ b/xbmc/filesystem/FileCache.h
@@ -109,6 +109,7 @@ public:
     int64_t m_forwardCacheSize = 0;
     int64_t m_maxForward = 0;
     bool m_bFilling = false;
+    int m_sourceReopens = 0; // consecutive reopens of a source that stopped before the end
     std::atomic<int64_t> m_fileSize;
     unsigned int m_flags;
     CCriticalSection m_sync;
