+using namespace KODI::WINDOWING::GBM;
+using namespace KODI::MESSAGING;
+namespace BO = KODI::WINDOWING::GBM::BOOT_OPTION;
+
+namespace
+{
+
+// (a setting that is being set to what the boot menus say is not acted on: OnSettingChanged() runs
+// in the thread that sets it)
+thread_local bool t_showing = false;
+
+// The strings of these settings and messages are core ones, translated in Estuary from 32970 on
+// (CGUIUtils::GetHadesString(), CGUIDialogSettingsBase::GetLocalizedString())
+std::string Text(uint32_t core)
+{
+  return CGUIUtils::GetHadesString(core, 32970 + (core - 41090));
+}
+
+// What the running kernel has: /sys/module/<module>/parameters/<parameter>
+const char* Running(const BO::Option& option)
+{
+  std::ifstream file(std::string("/sys/module/") + option.module + "/parameters/" +
+                     option.parameter);
+  std::string text;
+  if (!file || !std::getline(file, text))
+    return "unknown";
+  return BO::RunningOf(text);
+}
+
+// A change of the boot menus, run while the busy dialog is shown
+class CChange : public IRunnable
+{
+public:
+  explicit CChange(std::vector<std::string> arguments) : m_arguments(std::move(arguments)) {}
+  void Run() override { m_status = CBootOptions::Run(m_arguments, m_output, m_errors); }
+
+  const std::vector<std::string> m_arguments;
+  int m_status = -1;
+  std::string m_output;
+  std::string m_errors;
+};
+
+std::string Words(const std::string& text)
+{
+  std::string out = text;
+  StringUtils::Replace(out, "\n", " | ");
+  StringUtils::Trim(out);
+  return out;
+}
+
+} // namespace
+
+CBootOptions::~CBootOptions()
+{
+  Unregister();
+}
+
+void CBootOptions::Register()
+{
+  if (m_registered)
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings)
+    return;
+  std::set<std::string, std::less<>> ids;
+  for (const auto& option : BO::OPTIONS)
+    ids.insert(option.setting);
+  settings->GetSettingsManager()->RegisterCallback(this, ids);
+  m_registered = true;
+}
+
+void CBootOptions::Unregister()
+{
+  if (!m_registered)
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (settings)
+    settings->GetSettingsManager()->UnregisterCallback(this);
+  m_registered = false;
+}
+
+bool CBootOptions::Offers(std::string_view setting) const
+{
+  const BO::Option* offered = m_offered;
+  return offered && setting == offered->setting;
+}
+
+BO::State CBootOptions::Ask(const BO::Option& option, std::string& said)
+{
+  std::string output;
+  std::string errors;
+  const int status = Run(BO::Arguments(option), output, errors);
+  said = StringUtils::Format("exit status {}: {}{}{}", status, Words(output),
+                             errors.empty() ? "" : " / ", Words(errors));
+  return BO::StateOf(status, output);
+}
+
+void CBootOptions::Show(const BO::Option& option, bool on)
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(option.setting) || settings->GetBool(option.setting) == on)
+    return;
+  t_showing = true;
+  settings->SetBool(option.setting, on);
+  t_showing = false;
+}
+
+void CBootOptions::Read(CDRMConnector& connector)
+{
+  std::string name;
+  const BO::Option* named = nullptr;
+  if (const auto value = connector.GetPropertyValue(BO::PROPERTY))
+  {
+    if (const auto enumName = connector.GetPropertyEnumName(BO::PROPERTY, *value))
+      name = *enumName;
+    named = BO::OfKernel(name);
+  }
+  if (!named)
+  {
+    m_offered = nullptr;
+    if (!name.empty())
+      CLog::Log(
+          LOGINFO,
+          "BootOption: {} names the kernel option {} ({}), which this Kodi has no setting for",
+          connector.GetName(), name, BO::PROPERTY);
+    else
+      CLog::Log(
+          LOGDEBUG,
+          "BootOption: {} names no kernel option of the boot menus ({}): no setting is offered",
+          connector.GetName(), BO::PROPERTY);
+    return;
+  }
+
+  std::string said;
+  const BO::State state = Ask(*named, said);
+  if (!BO::Offered(named, state))
+  {
+    m_offered = nullptr;
+    CLog::Log(LOGWARNING,
+              "BootOption: {} names {} ({}), but what the boot menus say of it cannot be told ({} "
+              "{}: {}): the "
+              "setting \"{}\" is not offered",
+              connector.GetName(), named->kernel, BO::PROPERTY, BO::PROGRAM, named->kernel, said,
+              named->setting);
+    return;
+  }
+  Show(*named, BO::ShownOn(state));
+  m_offered = named;
+  CLog::Log(LOGINFO,
+            "BootOption: {} names {} ({}): the setting \"{}\" is offered; the boot menus start the "
+            "system with it "
+            "{}, and the running kernel has it {}",
+            connector.GetName(), named->kernel, BO::PROPERTY, named->setting, BO::NameOf(state),
+            Running(*named));
+  if (state == BO::State::MIXED || state == BO::State::OTHER)
+    CLog::Log(LOGWARNING,
+              "BootOption: the entries of the boot menus do not all have {} the same way ({}): the "
+              "setting shows it "
+              "off, and turning it on or off writes it in every entry",
+              named->kernel, BO::NameOf(state));
+}
+
+void CBootOptions::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (t_showing || !setting)
+    return;
+  const BO::Option* option = BO::OfSetting(setting->GetId());
+  if (!option || setting->GetType() != SettingType::Boolean)
+    return;
+  const bool on = std::static_pointer_cast<const CSettingBool>(setting)->GetValue();
+
+  CChange change(BO::Arguments(*option, on));
+  CGUIDialogBusy::Wait(&change, 100, false);
+  const BO::Outcome outcome = BO::OutcomeOf(change.m_status);
+  CLog::Log(outcome == BO::Outcome::DONE ? LOGINFO : LOGERROR,
+            "BootOption: {} turned {} in the boot menus: {} {} {} {}: exit status {}: {}{}{}",
+            option->kernel, on ? "on" : "off", BO::PROGRAM, "option", option->kernel,
+            on ? "on" : "off", change.m_status, Words(change.m_output),
+            change.m_errors.empty() ? "" : " / ", Words(change.m_errors));
+
+  const std::string heading = Text(option->label);
+  if (outcome == BO::Outcome::DONE)
+  {
+    CLog::Log(LOGINFO, "BootOption: {} applies from the next start (the running kernel has it {})",
+              option->kernel, Running(*option));
+    if (HELPERS::ShowYesNoDialogText(heading, Text(BO::MessageOf(outcome))) ==
+        HELPERS::DialogResponse::CHOICE_YES)
+    {
+      CLog::Log(LOGINFO, "BootOption: the system restarts, as asked, for {}", option->kernel);
+      CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTART);
+    }
+    return;
+  }
+  HELPERS::ShowOKDialogText(heading, Text(BO::MessageOf(outcome)));
+  // the setting shows again what the boot menus say
+  std::string said;
+  const BO::State state = Ask(*option, said);
+  CLog::Log(LOGINFO, "BootOption: the boot menus now have {} {} ({})", option->kernel,
+            BO::NameOf(state), said);
+  Show(*option, BO::ShownOn(state));
+}
+
+int CBootOptions::Run(const std::vector<std::string>& arguments,
+                      std::string& output,
+                      std::string& errors)
+{
+  output.clear();
+  errors.clear();
+  if (arguments.empty())
+    return -1;
+  int out[2] = {-1, -1};
+  int err[2] = {-1, -1};
+  if (pipe2(out, O_CLOEXEC) != 0)
+    return -1;
+  if (pipe2(err, O_CLOEXEC) != 0)
+  {
+    close(out[0]);
+    close(out[1]);
+    return -1;
+  }
+  posix_spawn_file_actions_t actions;
+  posix_spawn_file_actions_init(&actions);
+  posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0);
+  posix_spawn_file_actions_adddup2(&actions, out[1], 1);
+  posix_spawn_file_actions_adddup2(&actions, err[1], 2);
+  std::vector<char*> argv;
+  for (const auto& a : arguments)
+    argv.push_back(const_cast<char*>(a.c_str()));
+  argv.push_back(nullptr);
+  // (not the environment of Kodi, where add-ons put folders of their own into PATH and
+  // LD_LIBRARY_PATH)
+  char path[] = "PATH=/usr/bin:/usr/sbin";
+  char locale[] = "LC_ALL=C";
+  char* envp[] = {path, locale, nullptr};
+  pid_t pid = -1;
+  const int spawned = posix_spawn(&pid, argv[0], &actions, nullptr, argv.data(), envp);
+  posix_spawn_file_actions_destroy(&actions);
+  close(out[1]);
+  close(err[1]);
+  if (spawned != 0)
+  {
+    close(out[0]);
+    close(err[0]);
+    CLog::Log(LOGERROR, "BootOption: {} cannot be run: {}", argv[0], strerror(spawned));
+    return -1;
+  }
+  // both outputs until they end (what the program says is short; read both so that neither fills
+  // up)
+  pollfd fds[2] = {{out[0], POLLIN, 0}, {err[0], POLLIN, 0}};
+  std::string* into[2] = {&output, &errors};
+  int open = 2;
+  while (open > 0)
+  {
+    if (poll(fds, 2, -1) < 0)
+    {
+      if (errno == EINTR)
+        continue;
+      break;
+    }
+    for (int i = 0; i < 2; ++i)
+    {
+      if (fds[i].fd < 0 || !(fds[i].revents & (POLLIN | POLLHUP | POLLERR)))
+        continue;
+      char buffer[1024];
+      const ssize_t n = read(fds[i].fd, buffer, sizeof(buffer));
+      if (n > 0)
+      {
+        if (into[i]->size() < 65536)
+          into[i]->append(buffer, static_cast<size_t>(n));
+        continue;
+      }
+      if (n < 0 && errno == EINTR)
+        continue;
+      close(fds[i].fd);
+      fds[i].fd = -1;
+      --open;
+    }
+  }
+  for (const auto& f : fds)
+    if (f.fd >= 0)
+      close(f.fd);
+  int status = 0;
+  pid_t ended;
+  do
+    ended = waitpid(pid, &status, 0);
+  while (ended < 0 && errno == EINTR);
+  if (ended < 0 || !WIFEXITED(status))
+    return -1;
+  return WEXITSTATUS(status);
+}
