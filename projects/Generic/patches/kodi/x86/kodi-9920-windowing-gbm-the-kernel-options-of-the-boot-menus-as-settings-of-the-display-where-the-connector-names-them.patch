diff --git a/xbmc/windowing/gbm/drm/BootOption.h b/xbmc/windowing/gbm/drm/BootOption.h
new file mode 100644
index 0000000..db4451b
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/BootOption.h
@@ -0,0 +1,197 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*
+ * Hades: the kernel options of the boot menus that Kodi offers as settings of the display. Two
+ * parameters of drivers that are built into the kernel change what an HDMI output offers, and reach
+ * those drivers only from the kernel line: i915.hdmi_hdr_gmp (HDR over the HDMI port of Intel
+ * graphics of display version 9) and amdgpu.dvbridge_dce (the Dolby Vision tunnel on the display
+ * cores of AMD Polaris and Vega). The kernel names the one that changes a connector in the
+ * immutable property HADES_BOOT_OPTION, whatever its value is now, and the setting is shown where
+ * the connector of the output has it. Its value is the one of the boot menus, which keep it
+ * ("internal-disks option NAME [on|off]" reads and writes it there): it applies from the next
+ * start. What the running kernel has is in /sys/module. This file holds what decides, with nothing
+ * of Kodi in it, so that it can be tested on the host.
+ */
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM::BOOT_OPTION
+{
+
+//! The property of the connector, and the program that reads and writes the boot menus
+inline constexpr const char* PROPERTY = "HADES_BOOT_OPTION";
+inline constexpr const char* PROGRAM = "/usr/lib/libreelec/internal-disks";
+
+struct Option
+{
+  const char* kernel; //!< the parameter as it is written on the kernel line
+  const char* setting; //!< the setting of Kodi
+  const char* module; //!< /sys/module/<module>/parameters/<parameter>
+  const char* parameter;
+  uint32_t label; //!< core strings: label, then help
+};
+
+inline constexpr std::array<Option, 2> OPTIONS{{
+    {"i915.hdmi_hdr_gmp", "videoscreen.hadeshdrgmp", "i915", "hdmi_hdr_gmp", 41090},
+    {"amdgpu.dvbridge_dce", "videoscreen.hadesdvdce", "amdgpu", "dvbridge_dce", 41092},
+}};
+
+//! The option of a name of the property (or of a setting), none for any other
+inline const Option* OfKernel(std::string_view name)
+{
+  for (const auto& option : OPTIONS)
+    if (name == option.kernel)
+      return &option;
+  return nullptr;
+}
+
+inline const Option* OfSetting(std::string_view id)
+{
+  for (const auto& option : OPTIONS)
+    if (id == option.setting)
+      return &option;
+  return nullptr;
+}
+
+//! What the boot menus say of an option: the answer of "internal-disks option NAME"
+enum class State
+{
+  ON,
+  OFF,
+  MIXED, //!< on in some of the entries that start the system and not in others (a menu changed by hand)
+  OTHER, //!< a line with the word twice, or with another value than 0 or 1
+  UNAVAILABLE, //!< no boot menu, or one that this system does not make (exit status 10, 11)
+  FAILED, //!< the program could not be run, or said something else
+};
+
+inline const char* NameOf(State state)
+{
+  switch (state)
+  {
+    case State::ON:
+      return "on";
+    case State::OFF:
+      return "off";
+    case State::MIXED:
+      return "mixed";
+    case State::OTHER:
+      return "other";
+    case State::UNAVAILABLE:
+      return "unavailable";
+    default:
+      return "failed";
+  }
+}
+
+//! The state, from the exit status of the program (-1: it could not be run) and what it wrote: its
+//! first line, as a word
+inline State StateOf(int exitStatus, std::string_view output)
+{
+  const std::string_view line = output.substr(0, output.find('\n'));
+  if (exitStatus == 10 || exitStatus == 11)
+    return State::UNAVAILABLE;
+  if (exitStatus != 0)
+    return State::FAILED;
+  if (line == "on")
+    return State::ON;
+  if (line == "off")
+    return State::OFF;
+  if (line == "mixed")
+    return State::MIXED;
+  if (line == "other")
+    return State::OTHER;
+  return State::FAILED;
+}
+
+//! What the setting shows for a state: on only where every entry starts the system with it
+inline bool ShownOn(State state)
+{
+  return state == State::ON;
+}
+
+//! The setting is offered where the connector names the option, and the menus can be told and
+//! changed
+inline bool Offered(const Option* named, State state)
+{
+  return named && state != State::UNAVAILABLE && state != State::FAILED;
+}
+
+//! The arguments of the program: ask (no value), or set
+inline std::vector<std::string> Arguments(const Option& option)
+{
+  return {PROGRAM, "option", option.kernel};
+}
+
+inline std::vector<std::string> Arguments(const Option& option, bool on)
+{
+  return {PROGRAM, "option", option.kernel, on ? "on" : "off"};
+}
+
+//! The outcome of a change, from the exit status of the program (internal-disks: 0 done; 14 the
+//! boot partition is busy or not read-only, nothing written; 20 not changed, the menus as they
+//! were; 21 and 22 not certain)
+enum class Outcome
+{
+  DONE,
+  BUSY,
+  AS_IT_WAS,
+  NOT_CERTAIN,
+};
+
+inline Outcome OutcomeOf(int exitStatus)
+{
+  switch (exitStatus)
+  {
+    case 0:
+      return Outcome::DONE;
+    case 14:
+      return Outcome::BUSY;
+    case 21:
+    case 22:
+      return Outcome::NOT_CERTAIN;
+    default:
+      return Outcome::AS_IT_WAS;
+  }
+}
+
+//! The core string of the message of an outcome (41094 to 41097)
+inline uint32_t MessageOf(Outcome outcome)
+{
+  switch (outcome)
+  {
+    case Outcome::DONE:
+      return 41094;
+    case Outcome::BUSY:
+      return 41097;
+    case Outcome::NOT_CERTAIN:
+      return 41096;
+    default:
+      return 41095;
+  }
+}
+
+//! What the running kernel has: the text of /sys/module/<module>/parameters/<parameter> ("Y", "N"),
+//! as a word
+inline const char* RunningOf(std::string_view text)
+{
+  const std::string_view word = text.substr(0, text.find('\n'));
+  if (word == "Y" || word == "1")
+    return "on";
+  if (word == "N" || word == "0")
+    return "off";
+  return "unknown";
+}
+
+} // namespace KODI::WINDOWING::GBM::BOOT_OPTION
