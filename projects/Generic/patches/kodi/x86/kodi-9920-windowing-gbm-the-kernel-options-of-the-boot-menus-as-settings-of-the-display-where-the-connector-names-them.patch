+
+#pragma once
+
+#include "settings/lib/ISettingCallback.h"
+#include "windowing/gbm/drm/BootOption.h"
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+class CSetting;
+
+namespace KODI::WINDOWING::GBM
+{
+
+class CDRMConnector;
+
+/*!
+ * Hades: the settings of the kernel options of the boot menus (drm/BootOption.h): which one the
+ * connector of the output names, what the boot menus say of it, and changing it there when the
+ * setting is changed.
+ */
+class CBootOptions : public ISettingCallback
+{
+public:
+  CBootOptions() = default;
+  ~CBootOptions() override;
+
+  //! The callbacks of the settings (once the settings are there); and taken away again
+  void Register();
+  void Unregister();
+
+  //! When the output is read: the option that its connector names, what the boot menus say of it
+  //! (the setting is set to that), and what the running kernel has; all of it in kodi.log
+  void Read(CDRMConnector& connector);
+
+  //! The setting is offered on the output that Kodi uses
+  bool Offers(std::string_view setting) const;
+
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override;
+
+  //! Runs a program of the system without a shell, in the C locale and with only its own PATH; its
+  //! exit status (-1: it could not be run or did not end normally), and what it wrote on its output
+  //! and on its errors
+  static int Run(const std::vector<std::string>& arguments,
+                 std::string& output,
+                 std::string& errors);
+
+private:
+  //! The setting of the option shows on or off, without acting on it
+  void Show(const BOOT_OPTION::Option& option, bool on);
+  //! What the boot menus say of the option now
+  static BOOT_OPTION::State Ask(const BOOT_OPTION::Option& option, std::string& said);
+
+  std::atomic<const BOOT_OPTION::Option*> m_offered{nullptr};
+  bool m_registered{false};
+};
+
+} // namespace KODI::WINDOWING::GBM
