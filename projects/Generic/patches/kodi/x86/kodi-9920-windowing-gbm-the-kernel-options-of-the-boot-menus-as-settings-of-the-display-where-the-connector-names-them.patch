diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 19fcad8..b96ee79 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -27214,6 +27214,54 @@ msgctxt "#41014"
 msgid "Only for GeForce GTX 16 and RTX 20 cards, which have no 10 bits in RGB over HDMI. On: where the TV takes 36-bit deep colour and the mode fits (up to 4K at 30 Hz on HDMI 2.0), HDR goes out in RGB at 12 bits rather than YCbCr 4:2:2, which keeps the full colour detail of menus and subtitles but runs the link 1.5 times faster. Where the TV does not lock onto it, that mode goes back to YCbCr 4:2:2 by itself, but some TVs lock and still show nothing: if yours does, stop the video and turn this off."
 msgstr ""
 
+#. Hades: label of setting "videoscreen.hadeshdrgmp"; translated in Estuary (#32970)
+#: system/settings/settings.xml
+msgctxt "#41090"
+msgid "HDR over HDMI on this Intel graphics"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadeshdrgmp"; translated in Estuary (#32971)
+#: system/settings/settings.xml
+msgctxt "#41091"
+msgid "For experts. The HDMI port of this Intel graphics (HD and UHD 6xx) has no packet of its own to tell the TV that a picture is HDR, so Hades sends HDR10 and HLG videos as Dolby Vision to a TV that has Dolby Vision, and in SDR to one that does not. On: they go to the TV as HDR10 and HLG, with the HDR information in another packet of the graphics chip. Nobody has tried this on a TV yet: if HDR videos then look washed out or pale, the TV does not take it, and you turn this off again. Off by default. Takes effect from the next start: Hades asks whether to restart now."
+msgstr ""
+
+#. Hades: label of setting "videoscreen.hadesdvdce"; translated in Estuary (#32972)
+#: system/settings/settings.xml
+msgctxt "#41092"
+msgid "Dolby Vision on this Radeon (experimental)"
+msgstr ""
+
+#. Hades: help of setting "videoscreen.hadesdvdce"; translated in Estuary (#32973)
+#: system/settings/settings.xml
+msgctxt "#41093"
+msgid "For experts. Plays Dolby Vision as Dolby Vision on this Radeon (RX 400 and 500, Vega and Radeon VII: the older display hardware of AMD). Off by default, and then Dolby Vision plays as HDR10, which works. It has been tried on one card only, an RX 550 with an LG G3, and the TV showed its Dolby Vision logo over a black picture. If the picture goes black, stop the video: the menus come back, and you can turn this off here. The button \"Check the Dolby Vision output\" (LibreELEC settings > System > Submit Log) checks what the card sends. Takes effect from the next start: Hades asks whether to restart now."
+msgstr ""
+
+#. Hades: question after a kernel option of the boot menus was changed; translated in Estuary (#32974)
+#: xbmc/windowing/gbm/BootOptions.cpp
+msgctxt "#41094"
+msgid "This takes effect from the next start. Restart now?"
+msgstr ""
+
+#. Hades: message: a kernel option of the boot menus could not be changed; translated in Estuary (#32975)
+#: xbmc/windowing/gbm/BootOptions.cpp
+msgctxt "#41095"
+msgid "The boot menu could not be changed: it is as it was."
+msgstr ""
+
+#. Hades: message: a kernel option of the boot menus could not be changed for certain; translated in Estuary (#32976)
+#: xbmc/windowing/gbm/BootOptions.cpp
+msgctxt "#41096"
+msgid "The boot menu could not be changed for certain. Look at this setting again after the next start."
+msgstr ""
+
+#. Hades: message: the boot partition is being written by something else; translated in Estuary (#32977)
+#: xbmc/windowing/gbm/BootOptions.cpp
+msgctxt "#41097"
+msgid "Something else is writing to the boot partition right now. Try again in a moment."
+msgstr ""
+
 
