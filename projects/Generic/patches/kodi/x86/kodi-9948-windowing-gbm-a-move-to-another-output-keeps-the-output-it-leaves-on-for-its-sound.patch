+/*!
+ * \brief Hades: in a move of Kodi to another output of its device, the CRTC to move to where the
+ *        output that Kodi leaves is kept on for its sound: one that is off and is not the one in
+ *        use, so that the output left keeps its own; -1 when there is none (the move then takes the
+ *        CRTC it always took, and the output left goes off with it)
+ * \param possible the CRTCs that can drive the output that Kodi moves to (a mask by index)
+ * \param active the CRTCs that are on (a mask by index)
+ * \param inUse the index of the CRTC in use
+ * \param count how many CRTCs the device has
+ */
+inline int FreeCrtcForMove(uint32_t possible, uint32_t active, int inUse, int count)
+{
+  for (int i = 0; i < count && i < 32; ++i)
+  {
+    const uint32_t bit = uint32_t{1} << i;
+    if (i != inUse && (possible & bit) && !(active & bit))
+      return i;
+  }
+  return -1;
+}
+
+/*!
+ * \brief Hades: whether the output that Kodi leaves in a move stays on, kept for its sound
+ * \param kept it is kept on (hades-keep-outputs, or its sound is in use)
+ * \param ownCrtc it keeps its own CRTC: Kodi moves to another one (FreeCrtcForMove())
+ * \param mode how the outputs kept on are left by the commit of the move (KeepModes())
+ *
+ * Only black, with its planes detached. As it was, it would show the buffer that Kodi showed on
+ * it last, which Kodi goes on drawing its next frames into: it goes off then, as where the driver
+ * needs a plane on a CRTC that is on (amdgpu), and the log says so.
+ */
+inline bool LeftOutputStays(bool kept, bool ownCrtc, KeepMode mode)
+{
+  return kept && ownCrtc && mode == KeepMode::DETACHED;
+}
+
 } // namespace KEEP_OUTPUTS
 } // namespace GBM
 } // namespace WINDOWING
