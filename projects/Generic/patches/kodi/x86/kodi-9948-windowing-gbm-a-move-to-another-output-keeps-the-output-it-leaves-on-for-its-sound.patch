+void CDRMUtils::DecideSoundBeforeMove()
+{
+  if (m_otherOutputsDone)
+  {
+    if (SoundOutputsChanged())
+      ReconsiderSoundOutputs();
+    return;
+  }
+  // (as the turning off of the outputs that Kodi does not use waits: WaitsForSoundOutputs())
+  if (KODI::UTILS::CSoundOutputsInUse::Generation() == 0 && m_soundWaits < SOUND_WAITS)
+  {
+    if (!m_moveBeforeSoundTold)
+      CLog::LogF(LOGINFO, "the audio engine has not said yet which audio output it uses: in this "
+                          "move, only hades-keep-outputs keeps outputs on");
+    m_moveBeforeSoundTold = true;
+    return;
+  }
+  // The other devices are asked what they drive and closed: nothing of them was turned off yet,
+  // and DisableOtherDevices() opens them again, and decides again with them, when it does.
+  std::vector<KEEP_OUTPUTS::GraphicsDevice> others;
+  for (const std::string& node : m_otherDeviceNodes)
+  {
+    const int fd = open(node.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+      continue;
+    others.push_back(SurveyDevice(fd, node));
+    close(fd);
+  }
+  DecideSoundOutputs(others);
+}
