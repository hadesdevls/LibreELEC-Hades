+  };
+
+  // Hades: the output that Kodi leaves, where it is kept on for its sound (hades-keep-outputs, or
+  // its sound in use: DecideSoundBeforeMove()), keeps its CRTC: Kodi moves to one that is off and
+  // can show it there (KEEP_OUTPUTS::FreeCrtcForMove()), else to the one it always took, and the
+  // output left goes off with the move
+  DecideSoundBeforeMove();
+  const bool leftKept = KeepsOutputOn(m_node, m_connector->GetName());
+  const int freeCrtc =
+      leftKept
+          ? KEEP_OUTPUTS::FreeCrtcForMove(possible, active, static_cast<int>(m_crtc->GetOffset()),
+                                          static_cast<int>(m_crtcs.size()))
+          : -1;
+  const bool onFree = freeCrtc >= 0 && fits(freeCrtc);
+  if (!onFree)
+    fits(crtcIndex);
+  if (leftKept)
+  {
+    if (onFree)
+      CLog::LogF(LOGINFO,
+                 "{} is kept on for its sound ({}): Kodi moves to {} on CRTC {}, another than its "
+                 "own, so that it can stay on",
+                 m_connector->GetName(), KeptBy(m_node, {m_connector->GetName()}),
+                 connector->GetName(), move.crtc->GetCrtcId());
+    else
+      CLog::LogF(LOGWARNING,
+                 "{} is kept on for its sound ({}), but no CRTC that is off can show Kodi on {}: "
+                 "it goes off with the move",
+                 m_connector->GetName(), KeptBy(m_node, {m_connector->GetName()}),
+                 connector->GetName());
   }
   if (!move.encoder || !move.plane)
   {
