diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 5ab3df6..0aa3043 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25318,7 +25318,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadesdvhdr10map"; translated in Estuary (#31773)
 #: system/settings/settings.xml
 msgctxt "#39833"
-msgid "For projectors and HDR10 displays that adapt HDR10 poorly. Off: the picture is sent as it was mastered and the display adapts it, as before. To this display: the picture rebuilt from its Dolby Vision data is adapted here to the peak and the colours of the display below, shot by shot with the brightness data of each shot (Dolby Vision level 1), with libplacebo's tone and gamut mapping, and the display is told that the picture now fits it. While \"Dolby Vision as HDR10 when needed\" is on, every Dolby Vision video that is not sent natively is then sent this way, whatever its kind; a video for which \"Dolby Vision as HDR10\" is chosen in the player is mapped too. Turn off the display's own dynamic tone mapping for HDR10. The creative trims of Dolby Vision (levels 2 and 8) are not applied. Applies from the next video."
+msgid "For projectors and HDR10 displays that adapt HDR10 poorly. Off: the picture is sent as it was mastered and the display adapts it, as before. To this display: the picture rebuilt from its Dolby Vision data is adapted here to the peak and the colours of the display below, shot by shot with the brightness data of each shot (Dolby Vision level 1), with libplacebo's tone and gamut mapping, and the display is told that the picture now fits it. While \"Dolby Vision as HDR10 when needed\" is on, every Dolby Vision video that is not sent natively is then sent this way, whatever its kind, and while it is off, a profile 5 one, which is always rebuilt; a video for which \"Dolby Vision as HDR10\" is chosen in the player is mapped too. Turn off the display's own dynamic tone mapping for HDR10. The creative trims of Dolby Vision (levels 2 and 8) are not applied. Applies from the next video."
 msgstr ""
 
 #. Hades: value of setting "videoscreen.hadesdvhdr10map"; translated in Estuary (#31774)
@@ -25917,7 +25917,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadesdvashdr10"; translated in Estuary (#31697)
 #: system/settings/settings.xml
 msgctxt "#39990"
-msgid "When Dolby Vision cannot be sent as such (a display without it, or a TV input in its game mode): a Dolby Vision video whose base picture is not HDR10 (profile 5, as streaming services use it) is rebuilt from its Dolby Vision data and sent as HDR10; without this it plays with wrong colours. Other Dolby Vision videos play their HDR10 picture, as before. Turn it off if such a video shows a black or broken picture. Applies from the next video."
+msgid "When Dolby Vision cannot be sent as such (a display without it, or a TV input in its game mode), a Dolby Vision video whose base layer is no picture by itself (profile 5, as streaming services use it) is always rebuilt from its Dolby Vision data and sent as HDR10, whatever this setting says: played as it is, its colours would be wrong. This setting is for the other Dolby Vision videos (such as profiles 7 and 8), which play their own base picture, as before: while it is on, the settings below can have them rebuilt too and have what is rebuilt sent as HDR10+, and \"map to the display\" rebuilds every Dolby Vision video; while it is off, they always play their base picture. Where rebuilding fails, the video plays as Kodi plays it. Applies from the next video."
 msgstr ""
 
 #. Hades: label of setting "videoscreen.hadesdvashdr10fel"; translated in Estuary (#31698)
