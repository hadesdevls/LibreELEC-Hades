From 528cdb15f2068a2295bcb6b65fe14cae63473024 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:22:15 +0000
Subject: [PATCH] DVDInputStreamBluray: a playlist played directly opens its
 demuxer again for a play item that does not join seamlessly

A play item that does not join the one before seamlessly (connection
condition 1) is told by libbluray with the read of its first bytes
(BD_EVENT_DISCONTINUITY). Played directly (no menus), the input posted
DEMUXER_RESET for it, which the player handles before the next packet:
by then the demuxer of the play item before had already read those first
bytes, and the reset one began inside the play item's first picture. Its
video began at the next random-access picture (half a second later on
the test disc, up to a second on a film), a picture late on the
playlist's timeline, and audio and video of the play item a picture
apart; with a first play item shorter than the demuxer's probe (10 MB),
the reset dropped the whole second one.

Now the read that tells it keeps its bytes and gives the demuxer of the
play item before the end of its data (0, as with the menus while the
input holds), NextStream() answers NEXTSTREAM_OPEN, and the demuxer that
the player opens for the play item gets those bytes first: what the
player does at the same join with the disc's menus. A read that told it
with no bytes resets the demuxer as before. A seek while the bytes are
held drops them: the demuxer goes on from where the seek landed. Seamless
joins are not told so and do not change.

Measured on the synthetic disc of the join test, played directly
(playlists 2 and 4, a play item that is not joined seamlessly, the
second with IN in the middle of a group): before, one reset, the second
play item's video from its clip's 13th picture on (0.5 s lost, in both),
and in playlist 2 +0.0417 s on the timeline, audio and video 0.0417 s
apart; now, one demuxer opened again, its video from its clip's first
picture, nothing of it read by the demuxer before, the timeline and
audio and video as authored. From the last packet of the first play
item to the first video packet of the second, 7.1 ms (with the menus at
the same join 15.3 ms); with Kodi's probe of 10 MB, 14.9 ms (15.3 ms).
What the player does after NEXTSTREAM_OPEN (the old streams played to
their end, the new ones opened and started together) is the same code as
with the menus.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 62 +++++++++++++++++++
 .../DVDInputStreams/DVDInputStreamBluray.h    |  6 ++
 2 files changed, 68 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 50b4e91..d86d520 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -680,6 +680,16 @@ void CDVDInputStreamBluray::ProcessEvent() {
 
   case BD_EVENT_DISCONTINUITY:
     CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_DISCONTINUITY");
+    // Hades: a playlist played directly: the player opens its demuxer and its streams again for the
+    // play item, which gets the bytes of the read that told it (Read()), as with the disc's menus.
+    // The demuxer reset (DEMUXER_RESET) came after the demuxer of the play item before had read
+    // those first bytes: the new one began inside the play item's first picture.
+    if (!m_navmode)
+    {
+      m_directJoin = true;
+      m_directJoinParam = m_event.param;
+      break;
+    }
     m_player->OnDiscNavResult(&m_event.param, BD_EVENT_DISCONTINUITY);
     m_hold = HOLD_NONE;
     break;
@@ -1005,7 +1015,22 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
   }
   else
   {
+    // Hades: a play item that does not join the one before seamlessly: the demuxer of the one
+    // before ends here, and the player opens its demuxer and streams again (NextStream()); the new
+    // demuxer gets the first bytes of the play item, held
+    if (m_hold == HOLD_HELD)
+      return 0;
+    if (!m_heldBytes.empty())
+    {
+      const int held = std::min(buf_size, static_cast<int>(m_heldBytes.size()));
+      std::memcpy(buf, m_heldBytes.data(), static_cast<size_t>(held));
+      m_heldBytes.erase(m_heldBytes.begin(), m_heldBytes.begin() + held);
+      m_readPos += static_cast<uint64_t>(held);
+      m_hold = HOLD_NONE;
+      return held;
+    }
     unsigned int readErrors{0};
+    m_directJoin = false;
     do
     {
       if (m_aborted || HasGivenUpReading())
@@ -1021,8 +1046,28 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
       // A unit libbluray skips as broken is reported and read as nothing, which the demuxer would
       // take for the end of the title
     } while (result == 0 && m_readErrors > readErrors);
+    if (m_directJoin)
+    {
+      m_directJoin = false;
+      if (result > 0)
+      {
+        m_heldBytes.assign(buf, buf + result);
+        m_hold = HOLD_HELD;
+        CLog::Log(LOGINFO,
+                  "CDVDInputStreamBluray - play item {} does not join the one before seamlessly: "
+                  "the player opens its streams again for it, its demuxer with its first bytes",
+                  m_playItem.load());
+        return 0;
+      }
+      // (nothing read with it: the demuxer is reset, as before)
+      m_player->OnDiscNavResult(&m_directJoinParam, BD_EVENT_DISCONTINUITY);
+    }
     if (result > 0)
+    {
       m_readPos += static_cast<uint64_t>(result);
+      if (m_hold == HOLD_DATA)
+        m_hold = HOLD_NONE;
+    }
   }
   return result;
 }
@@ -1037,6 +1082,15 @@ void CDVDInputStreamBluray::BeginClipSpan(bool restart)
     return;
   }
 
+  // Hades: a seek between a play item that does not join seamlessly and its demuxer: the bytes held
+  // for it are of before the seek, and the demuxer opened next reads from where it landed
+  if (restart)
+  {
+    m_heldBytes.clear();
+    if (m_hold == HOLD_HELD)
+      m_hold = HOLD_DATA;
+  }
+
   std::optional<KODI::BLURAYTIMELINE::ClipTime> time;
   std::optional<uint64_t> inTime;
   if (m_clip)
@@ -2081,6 +2135,14 @@ CDVDInputStream::ENextStream CDVDInputStreamBluray::NextStream()
 {
   // Hades: (the events of the disc are taken by one thread at a time)
   std::unique_lock lock(m_eventLock);
+  // Hades: a playlist played directly opens its demuxer again for a play item that does not join
+  // the one before seamlessly (Read())
+  if (!m_navmode && !m_aborted && !HasGivenUpReading() &&
+      (m_hold == HOLD_HELD || m_hold == HOLD_DATA))
+  {
+    m_hold = HOLD_DATA;
+    return NEXTSTREAM_OPEN;
+  }
   if (!m_navmode || m_aborted || m_hold == HOLD_ERROR || HasGivenUpReading())
     return NEXTSTREAM_NONE;
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index 4aa6da4..56f48a6 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -579,6 +579,12 @@ protected:
     KODI::BLURAYPREROLL::CPresentationStarts m_presentationStarts;
     //! Hades: libbluray took BLURAY_PLAYER_SETTING_VIDEO_PREROLL (BlurayPreroll.h)
     bool m_videoPreroll{false};
+    //! Hades: a playlist played directly, a play item that does not join the one before seamlessly:
+    //! the read told it (BD_EVENT_DISCONTINUITY), with its parameter
+    bool m_directJoin{false};
+    uint32_t m_directJoinParam{0};
+    //! Hades: ... and the first bytes of the play item, held for the demuxer opened for it (Read())
+    std::vector<uint8_t> m_heldBytes;
     //! Hades: navigation mode, guards m_clipSpans, m_navAnchor, m_navKept, m_connections and
     //! m_connectionsPlaylist: the events of the disc are also processed by the thread of the
     //! application (UserInput()). Also m_presentationStarts, in both modes.
-- 
