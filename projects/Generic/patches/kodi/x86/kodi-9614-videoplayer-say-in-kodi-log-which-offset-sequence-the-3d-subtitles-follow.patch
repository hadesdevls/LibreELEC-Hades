From b776933960d96c867e65a91b14e5d3e7c5920388 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:47:16 +0000
Subject: [PATCH] VideoPlayer: say in kodi.log which offset sequence the 3D
 subtitles follow

Which offset sequence places the subtitles of a Blu-ray 3D title in depth,
and whether the dependent view carries any, was said only with debug
logging. Now it is said without it:
- each time the subtitle stream of a title that places its subtitles in
  depth, or its sequence, changes: the stream, the sequence or none, and
  where that comes from (the playlist, a 3d-plane tag, the stream's place
  among the PGS streams) or why there is none;
- once per title, that the dependent view carries plane offsets (how many
  sequences, and frames in the first GOP), or that none were found in its
  first 120 access units (the disc's demuxer did not say that before).

CDVDInputStreamBluray::GetSubtitleOffsetSequence() tells where its answer
comes from. A 2D title, and a 3D one whose second view is not read, log
nothing new.
---
 .../DVDDemuxers/DVDDemuxBluray3D.cpp          | 20 ++++++-
 .../DVDDemuxers/DVDDemuxBluray3D.h            |  5 ++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 12 ++--
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 22 ++++++-
 .../DVDInputStreams/DVDInputStreamBluray.h    |  4 +-
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 57 ++++++++++++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  2 +
 7 files changed, 105 insertions(+), 17 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
index 7f3420c..d3728d9 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
@@ -356,18 +356,34 @@ void CDVDDemuxBluray3D::ReadOffsetMetadata(const DemuxPacket& dependent, double
   if (m_frameDuration <= 0.0 || pts == DVD_NOPTS_VALUE)
     return;
 
+  // Hades: enough access units to cover a couple of GOPs before saying the title has none
+  constexpr unsigned int ACCESS_UNITS_BEFORE_GIVING_UP{120};
+
   KODI::VIDEO::BLURAY::OffsetMetadata metadata;
   if (!KODI::VIDEO::BLURAY::ParseOffsetMetadata(dependent.pData, dependent.iSize, metadata))
   {
     m_bluray->GetOffsetMetadata()->NoteFrame(pts);
+
+    if (!m_loggedOffsetMetadata && !m_loggedOffsetMetadataMissing &&
+        ++m_offsetAccessUnitsWithout == ACCESS_UNITS_BEFORE_GIVING_UP)
+    {
+      m_loggedOffsetMetadataMissing = true;
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - no plane offsets in the first {} access units of the "
+                "dependent view: the depth setting places the subtitles",
+                m_offsetAccessUnitsWithout);
+    }
     return;
   }
 
+  // Hades: without debug logging, as the subtitles' depth depends on it
   if (!m_loggedOffsetMetadata)
   {
     m_loggedOffsetMetadata = true;
-    CLog::Log(LOGDEBUG, "CDVDDemuxBluray3D - dependent view carries plane offsets, {} sequences",
-              metadata.sequences);
+    CLog::Log(LOGINFO,
+              "CDVDDemuxBluray3D - the dependent view carries plane offsets: {} sequence(s), {} "
+              "frame(s) in the first GOP",
+              metadata.sequences, metadata.frames);
   }
 
   m_bluray->GetOffsetMetadata()->Add(pts, m_frameDuration, std::move(metadata));
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
index d767bde..5352361 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
@@ -198,6 +198,11 @@ private:
   //! Whether the title has been said to carry plane offsets, which is said once.
   bool m_loggedOffsetMetadata{false};
 
+  //! Hades: dependent view access units read without plane offsets before the first that has
+  //! them, and whether their absence has been said (once, like their presence).
+  unsigned int m_offsetAccessUnitsWithout{0};
+  bool m_loggedOffsetMetadataMissing{false};
+
   //! Dependent view packet held back because it is ahead of the base view.
   DemuxPacket* m_pendingDependent{nullptr};
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index e2a36c6..77473b6 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -3521,9 +3521,10 @@ void CDVDDemuxFFmpeg::ReadOffsetMetadata(const DemuxPacket& packet)
         ++m_offsetAccessUnitsWithout == ACCESS_UNITS_BEFORE_GIVING_UP)
     {
       m_loggedOffsetMetadataMissing = true;
-      CLog::Log(LOGDEBUG,
+      // Hades: without debug logging, as the subtitles' depth depends on it
+      CLog::Log(LOGINFO,
                 "CDVDDemuxFFmpeg - expected plane offsets in the MVC dependent view, found none "
-                "in {} access units",
+                "in {} access units: the depth setting places the subtitles",
                 m_offsetAccessUnitsWithout);
     }
     return;
@@ -3533,9 +3534,10 @@ void CDVDDemuxFFmpeg::ReadOffsetMetadata(const DemuxPacket& packet)
   if (!m_loggedOffsetMetadata)
   {
     m_loggedOffsetMetadata = true;
-    CLog::Log(LOGDEBUG,
-              "CDVDDemuxFFmpeg - the MVC dependent view carries plane offsets, {} sequences",
-              metadata.sequences);
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg - the MVC dependent view carries plane offsets: {} sequence(s), "
+              "{} frame(s) in the first GOP",
+              metadata.sequences, metadata.frames);
   }
 
   m_offsetMetadata->Add(packet.pts, m_offsetFrameDuration, std::move(metadata));
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index e5953d0..45b77f5 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1569,13 +1569,22 @@ bool CDVDInputStreamBluray::IsBaseViewRightEye() const
   return m_titleInfo && m_titleInfo->mvc_base_view_r_flag != 0;
 }
 
-int CDVDInputStreamBluray::GetSubtitleOffsetSequence(unsigned int pid) const
+int CDVDInputStreamBluray::GetSubtitleOffsetSequence(unsigned int pid, const char*& why) const
 {
+  why = nullptr;
+
   // Hades: the playlist is exchanged under its lock (UpdatePlaylistInformation())
   std::unique_lock lock(m_playlistInfoLock);
   if (!m_playlistInfoValid || m_playlistInfo.playItems.empty())
     return -1;
 
+  // Hades: a playlist of the disc that has no second view (a 2D extra of a 3D disc) places
+  // nothing in depth either, and says nothing in the log
+  if (std::ranges::none_of(m_playlistInfo.extensionSubPlayItems,
+                           [](const XFILE::SubPlayItemInformation& subItem)
+                           { return KODI::MULTIVIEW::IsSecondViewSubPath(subItem.subPathType); }))
+    return -1;
+
   const auto& playItems{m_playlistInfo.playItems};
   const uint32_t item{m_playItem};
   const auto& playItem{item < playItems.size() ? playItems[item] : playItems.front()};
@@ -1585,12 +1594,23 @@ int CDVDInputStreamBluray::GetSubtitleOffsetSequence(unsigned int pid) const
     if (stream.packetIdentifier != pid)
       continue;
 
+    if (!stream.offsetSequenceRead)
+    {
+      why = "the playlist's stereoscopic table does not reach this stream";
+      return -1;
+    }
+
     if (stream.offsetSequenceId == XFILE::NO_OFFSET_SEQUENCE)
+    {
+      why = "the playlist names none for it";
       return -1;
+    }
 
+    why = "named by the playlist";
     return static_cast<int>(stream.offsetSequenceId);
   }
 
+  why = "the playlist does not list this stream";
   return -1;
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index 453fb2f..8052b9d 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -226,9 +226,11 @@ public:
   /*!
    * \brief The offset sequence a subtitle stream follows, which places it in depth.
    * \param pid the packet identifier of the subtitle stream
+   * \param why (Hades) set to where the answer comes from, for the log; nullptr where the
+   *        playlist is not read for 3D (a 2D title, or one whose second view is not read)
    * \return the sequence, or -1 when the playlist gives the stream none
    */
-  int GetSubtitleOffsetSequence(unsigned int pid) const;
+  int GetSubtitleOffsetSequence(unsigned int pid, const char*& why) const;
 
   /*!
    * \brief Open a clip that libbluray is not itself playing.
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 66cdc24..d9fd89d 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1006,6 +1006,7 @@ bool CVideoPlayer::OpenInputStream()
 #endif
   }
   m_subtitleOffsetSequence = -1;
+  m_subtitleOffsetLogStream = -1;
 
   m_clock.Reset();
   m_dvd.Clear();
@@ -1178,6 +1179,7 @@ void CVideoPlayer::CloseDemuxer()
     std::unique_lock lock(m_offsetMetadataSection);
     m_offsetMetadata.reset();
     m_subtitleOffsetSequence = -1;
+    m_subtitleOffsetLogStream = -1;
   }
 
   m_pDemuxer.reset();
@@ -5471,27 +5473,45 @@ void CVideoPlayer::UpdateSubtitleOffsetSequence(const CDemuxStream* stream)
 {
   int sequence{-1};
   bool isBluray{false};
+  // Hades: where the answer comes from, for kodi.log. It stays nullptr where the title does not
+  // place its subtitles in depth (a 2D title, or a 3D one whose second view is not read), and
+  // then nothing is logged.
+  const char* why{nullptr};
 
 #if defined(HAVE_LIBBLURAY)
   const auto bluray = std::dynamic_pointer_cast<CDVDInputStreamBluray>(m_pInputStream);
   isBluray = bluray != nullptr;
   if (bluray && stream && stream->dvdNavId > 0)
-    sequence = bluray->GetSubtitleOffsetSequence(static_cast<unsigned int>(stream->dvdNavId));
+    sequence = bluray->GetSubtitleOffsetSequence(static_cast<unsigned int>(stream->dvdNavId), why);
+  else if (bluray && stream && bluray->IsStereoscopic())
+    why = "it does not come from the disc";
 #endif
 
   // MakeMKV copies the playlist's sequence into a "3d-plane" tag. Without one, guess that PG
   // stream n follows sequence n, which many discs do not.
-  if (!isBluray && stream && m_pDemuxer && stream->codec == AV_CODEC_ID_HDMV_PGS_SUBTITLE &&
-      stream->demuxerId == m_pDemuxer->GetDemuxerId())
+  if (!isBluray && stream && m_pDemuxer)
   {
     std::unique_lock lock(m_offsetMetadataSection);
     const auto* tagged = dynamic_cast<const CDemuxStreamSubtitleFFmpeg*>(stream);
-    if (m_offsetMetadata && tagged && tagged->m_offsetSequence)
+    if (!m_offsetMetadata)
+    {
+      // not a remux decoded in its two views: the title places nothing in depth
+    }
+    else if (stream->demuxerId != m_pDemuxer->GetDemuxerId())
+      why = "it does not come from the video's file";
+    else if (stream->codec != AV_CODEC_ID_HDMV_PGS_SUBTITLE)
+      why = "it is not a Blu-ray subtitle stream";
+    else if (tagged && tagged->m_offsetSequence)
     {
       if (*tagged->m_offsetSequence != KODI::VIDEO::BLURAY::NO_OFFSET_SEQUENCE)
+      {
         sequence = static_cast<int>(*tagged->m_offsetSequence);
+        why = "named by its 3d-plane tag";
+      }
+      else
+        why = "its 3d-plane tag names none";
     }
-    else if (m_offsetMetadata)
+    else
     {
       int index{0};
       for (const CDemuxStream* candidate : m_pDemuxer->GetStreams())
@@ -5501,6 +5521,7 @@ void CVideoPlayer::UpdateSubtitleOffsetSequence(const CDemuxStream* stream)
         if (candidate->uniqueId == stream->uniqueId)
         {
           sequence = index;
+          why = "guessed from its place among the PGS streams, as it has no 3d-plane tag";
           break;
         }
         ++index;
@@ -5508,9 +5529,29 @@ void CVideoPlayer::UpdateSubtitleOffsetSequence(const CDemuxStream* stream)
     }
   }
 
-  if (sequence != m_subtitleOffsetSequence.exchange(sequence) && sequence >= 0)
-    CLog::Log(LOGDEBUG, "CVideoPlayer::{} - subtitles follow plane offset sequence {}",
-              __FUNCTION__, sequence);
+  // Hades: one line without debug logging each time the subtitle stream of a title that places
+  // its subtitles in depth, or the sequence it follows, changes
+  const int previous{m_subtitleOffsetSequence.exchange(sequence)};
+  const int streamId{stream ? stream->uniqueId : -1};
+  if (!why || (sequence == previous && streamId == m_subtitleOffsetLogStream))
+    return;
+
+  m_subtitleOffsetLogStream = streamId;
+  const std::string name{isBluray && stream && stream->dvdNavId > 0
+                             ? StringUtils::Format("PID {:#06x}", stream->dvdNavId)
+                             : StringUtils::Format("stream {}", streamId)};
+  const std::string language{stream && !stream->language.IsEmpty() ? stream->language.AsBcp47()
+                                                                   : "-"};
+  if (sequence >= 0)
+    CLog::Log(LOGINFO,
+              "CVideoPlayer::{} - 3D subtitles: {} [{}] follows plane offset sequence {} ({}), "
+              "applied while the output is 3D; the disc's own menus keep the depth setting",
+              __FUNCTION__, name, language, sequence, why);
+  else
+    CLog::Log(LOGINFO,
+              "CVideoPlayer::{} - 3D subtitles: {} [{}] follows no plane offset sequence ({}): "
+              "the depth setting places it",
+              __FUNCTION__, name, language, why);
 }
 
 std::optional<int> CVideoPlayer::GetSubtitlePlaneOffset(double pts)
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index 7d294a0..98e879e 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -805,6 +805,8 @@ protected:
   /*! Blu-ray 3D: the offset sequence the subtitle stream being shown follows, which is
       what places its plane in depth, or -1 when the title gives it none. */
   std::atomic<int> m_subtitleOffsetSequence{-1};
+  //! Hades: the subtitle stream (uniqueId) whose depth kodi.log last told, or -1
+  int m_subtitleOffsetLogStream{-1};
 
   /*! Blu-ray 3D: the plane offsets of the title being played, filled in by the demuxer as
       the dependent view is read. Asked for by the render thread, so guarded. */
-- 
