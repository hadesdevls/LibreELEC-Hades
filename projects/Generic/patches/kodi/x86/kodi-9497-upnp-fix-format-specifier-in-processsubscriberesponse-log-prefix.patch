From f725b70b55130f0b52762bf61c6017149c5bcf9e Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:04 +0000
Subject: [PATCH] [upnp] Fix format specifier in ProcessSubscribeResponse log
 prefix

CodeQL cpp/wrong-type-format-argument: "%ubscribe" passed a char* to
%u, printing a pointer value (undefined behaviour) instead of
"Subscribe"/"Unsubscribe". The (const char*) cast applied to the
bool condition, not the result, so drop it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/libUPnP/Platinum/Source/Core/PltCtrlPoint.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/libUPnP/Platinum/Source/Core/PltCtrlPoint.cpp b/lib/libUPnP/Platinum/Source/Core/PltCtrlPoint.cpp
index 7d476d1..ac899af 100644
--- a/lib/libUPnP/Platinum/Source/Core/PltCtrlPoint.cpp
+++ b/lib/libUPnP/Platinum/Source/Core/PltCtrlPoint.cpp
@@ -1614,8 +1614,8 @@ PLT_CtrlPoint::ProcessSubscribeResponse(NPT_Result                    res,
     PLT_EventSubscriberReference sub;
     bool                 subscription = (request.GetMethod().ToUppercase() == "SUBSCRIBE");
 
-    NPT_String prefix = NPT_String::Format("PLT_CtrlPoint::ProcessSubscribeResponse %ubscribe for service \"%s\" (result = %d, status code = %d)", 
-        (const char*)subscription?"S":"Uns",
+    NPT_String prefix = NPT_String::Format("PLT_CtrlPoint::ProcessSubscribeResponse %subscribe for service \"%s\" (result = %d, status code = %d)",
+        subscription?"S":"Uns",
         (const char*)service->GetServiceID(),
         res,
         response?response->GetStatusCode():0);
-- 
2.53.0

