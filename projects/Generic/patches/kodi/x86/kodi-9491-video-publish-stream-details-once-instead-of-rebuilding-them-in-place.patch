From 498c0eafffc7e821742f7a302960baceb29e93f2 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 13 Oct 2026 16:38:46 +0100
Subject: [PATCH] [Video] Publish stream details once instead of rebuilding
 them in place.

CVideoDatabase::GetStreamDetails() and CDVDFileInfo::GetFileStreamDetails()
reset the live item's details and added streams one at a time while the
GUI could read them, so a list could briefly show the details empty or
half filled. DemuxerToStreamDetails() also changed a video stream's HDR
detail and the Blu-ray duration after adding it, without holding the
details lock, racing with the GUI's reads.

Fill a local CStreamDetails and assign it to the item at the end, so
readers see either the old or the new details.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 74ee3ae14658787fc14b0e3eed0f22931873239e)
---
 xbmc/cores/VideoPlayer/DVDFileInfo.cpp | 19 ++++++++++---------
 xbmc/cores/VideoPlayer/DVDFileInfo.h   |  5 +++--
 xbmc/video/VideoDatabase.cpp           | 11 ++++++-----
 3 files changed, 19 insertions(+), 16 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
index 3f4b06a..9a494de 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
@@ -426,11 +426,14 @@ bool CDVDFileInfo::GetFileStreamDetails(CFileItem *pItem)
   CDVDDemux* pDemuxer = CDVDFactoryDemuxer::CreateDemuxer(pInputStream, true);
   if (pDemuxer)
   {
-    bool retVal = DemuxerToStreamDetails(
-        pInputStream, pDemuxer, pItem->GetVideoInfoTag()->m_streamDetails, strFileNameAndPath);
+    // Filled locally and published once, as the item may be shown while its streams are probed
+    CStreamDetails details;
+    bool retVal = DemuxerToStreamDetails(pInputStream, pDemuxer, details, strFileNameAndPath);
 
     if (!pInputStream->IsStreamType(DVDSTREAM_TYPE_PVRMANAGER))
-      ProcessExternalSubtitles(pItem);
+      ProcessExternalSubtitles(*pItem, details);
+
+    pItem->GetVideoInfoTag()->m_streamDetails = details;
 
     delete pDemuxer;
     return retVal;
@@ -675,10 +678,10 @@ bool CDVDFileInfo::DemuxerToStreamDetails(const std::shared_ptr<CDVDInputStream>
   return retVal;
 }
 
-void CDVDFileInfo::ProcessExternalSubtitles(CFileItem* item)
+void CDVDFileInfo::ProcessExternalSubtitles(const CFileItem& item, CStreamDetails& details)
 {
   std::vector<std::string> externalSubtitles;
-  const std::string videoPath = item->GetDynPath();
+  const std::string videoPath = item.GetDynPath();
 
   CUtil::ScanForExternalSubtitles(videoPath, externalSubtitles);
 
@@ -689,15 +692,13 @@ void CDVDFileInfo::ProcessExternalSubtitles(CFileItem* item)
     {
       std::string subFile;
       if (CUtil::FindVobSubPair(externalSubtitles, externalSubtitle, subFile))
-        AddExternalSubtitleToDetails(videoPath, item->GetVideoInfoTag()->m_streamDetails,
-                                     externalSubtitle, subFile);
+        AddExternalSubtitleToDetails(videoPath, details, externalSubtitle, subFile);
     }
     else
     {
       if (!CUtil::IsVobSub(externalSubtitles, externalSubtitle))
       {
-        AddExternalSubtitleToDetails(videoPath, item->GetVideoInfoTag()->m_streamDetails,
-                                     externalSubtitle);
+        AddExternalSubtitleToDetails(videoPath, details, externalSubtitle);
       }
     }
   }
diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.h b/xbmc/cores/VideoPlayer/DVDFileInfo.h
index 2ac92e9..d46e7d7 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.h
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.h
@@ -72,9 +72,10 @@ private:
   */
   static bool AddExternalSubtitleToDetails(const std::string &path, CStreamDetails &details, const std::string& filename, const std::string& subfilename = "");
 
-  /** \brief Checks external subtitles for a given item and adds any existing ones to the item stream details
+  /** \brief Checks external subtitles for a given item and adds any existing ones to the stream details
   *   \param item The video item
+  *   \param[out] details The stream details to add the subtitles to
   *   \sa AddExternalSubtitleToDetails
   */
-  static void ProcessExternalSubtitles(CFileItem* item);
+  static void ProcessExternalSubtitles(const CFileItem& item, CStreamDetails& details);
 };
diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index b3077e0..5abf7e8 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -4852,8 +4852,8 @@ bool CVideoDatabase::GetStreamDetails(CVideoInfoTag& tag)
 
   bool retVal = false;
 
-  CStreamDetails& details = tag.m_streamDetails;
-  details.Reset();
+  // Filled locally and published once, so the GUI never sees the details empty or half filled
+  CStreamDetails details;
 
   std::unique_ptr<Dataset> pDS(m_pDB->CreateDataset());
   try
@@ -4873,10 +4873,11 @@ bool CVideoDatabase::GetStreamDetails(CVideoInfoTag& tag)
   {
     CLog::LogF(LOGERROR, "({}) failed", tag.m_iFileId);
   }
-  details.DetermineBestStreams();
+  // Assigning determines the best streams, which GetVideoDuration() reads
+  tag.m_streamDetails = details;
 
-  if (details.GetVideoDuration() > 0)
-    tag.SetDuration(details.GetVideoDuration());
+  if (const int duration{tag.m_streamDetails.GetVideoDuration()}; duration > 0)
+    tag.SetDuration(duration);
 
   return retVal;
 }
-- 
