From 012988661e06f05cd38147436ca8c0da600e908f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:44:06 +0000
Subject: [PATCH] DVDDemuxFFmpeg: a read of a network file that waits gives its
 time back

The demuxer gives libavformat 20 s for a packet, and its read callback
takes a deadline that has passed for an abort (AVERROR_EXIT), which the
Matroska demuxer takes for the end of its input. A read of a local file
that waits for its drive has had that time given back (DemuxReadStall.h);
a read of a file on a network path was left as it was, and a read that
waits out a stall of its source (IOControl::READ_WAIT) can wait longer
than the deadline: the next read would end the video once the data is
back.

The time that a read of a file on a network path waits (1 s or more) is
given back the same way. A disc on a network path, and the streams that do
not go through the input of a file, are as before. The line in the log
says "source" for those reads, "drive" for local ones as before.

Host test of DemuxReadStall.h (7 checks): before, a network file's read
that waited 1.6 s with 1 s left leaves the deadline past; after, it runs
on; the local, disc and stream inputs are unchanged.
---
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp     | 14 ++++++++++----
 .../cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h |  6 ++++--
 .../cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h |  9 +++++++++
 3 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 7bd5607..da2d98b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -260,13 +260,13 @@ bool CDVDDemuxFFmpeg::Aborted()
 
 void CDVDDemuxFFmpeg::InputReadBegins()
 {
-  if (m_inputLocalFile)
+  if (m_inputReadsWait)
     m_readStall.Begin(m_timeout);
 }
 
 void CDVDDemuxFFmpeg::InputReadEnded()
 {
-  if (!m_inputLocalFile)
+  if (!m_inputReadsWait)
     return;
 
   const std::chrono::milliseconds waited = m_readStall.End(m_timeout, m_abortRequested);
@@ -281,10 +281,11 @@ void CDVDDemuxFFmpeg::InputReadEnded()
     return;
   }
   CLog::Log(LOGINFO,
-            "CDVDDemuxFFmpeg: a read of {} waited {} ms for its drive; that wait does not count "
+            "CDVDDemuxFFmpeg: a read of {} waited {} ms for its {}; that wait does not count "
             "against the time the demuxer has for a packet, whose end would be taken for an abort "
             "and end the video ({} more such reads since the last line)",
-            CURL::GetRedacted(m_pInput->GetFileName()), waited.count(), m_readStallsUntold);
+            CURL::GetRedacted(m_pInput->GetFileName()), waited.count(),
+            m_inputLocalFile ? "drive" : "source", m_readStallsUntold);
   m_readStallToldAt = now;
   m_readStallsUntold = 0;
 }
@@ -333,6 +334,11 @@ bool CDVDDemuxFFmpeg::Open(const std::shared_ptr<CDVDInputStream>& pInput, bool
                                                  m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY) ||
                                                      m_pInput->IsStreamType(DVDSTREAM_TYPE_DVD),
                                                  URIUtils::IsHD(strFile));
+  // and a file on a network path, whose read can wait for its source (DemuxReadStall.h)
+  m_inputReadsWait = CDemuxReadStall::InputReadsWait(
+      m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE),
+      m_pInput->IsStreamType(DVDSTREAM_TYPE_BLURAY) || m_pInput->IsStreamType(DVDSTREAM_TYPE_DVD),
+      URIUtils::IsHD(strFile));
   m_readStallToldAt.reset();
   m_readStallsUntold = 0;
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index fbe68c6..25a82e0 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -151,8 +151,9 @@ public:
 
   /*!
    * \brief Hades: around each read of the input by libavformat (dvd_file_read()). The time that a
-   *        read of a local file waits for its drive does not count against m_timeout, which would
-   *        end the video with the data back (DemuxReadStall.h).
+   *        read of a local file waits for its drive, or a read of a file on a network path for its
+   *        source, does not count against m_timeout, which would end the video with the data back
+   *        (DemuxReadStall.h).
    */
   void InputReadBegins();
   void InputReadEnded();
@@ -293,6 +294,7 @@ protected:
   std::function<bool()> m_cancelCheck;
   //! Hades: InputReadBegins() and InputReadEnded()
   bool m_inputLocalFile{false};
+  bool m_inputReadsWait{false};
   CDemuxReadStall m_readStall;
   std::optional<std::chrono::steady_clock::time_point> m_readStallToldAt;
   unsigned int m_readStallsUntold{0};
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h
index dcc8392..23012cb 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h
@@ -37,6 +37,15 @@ public:
     return (file || disc) && localPath;
   }
 
+  //! The inputs whose reads may wait, and whose waits are given back: those of LocalInput(), and a
+  //! file on a network path, whose read can wait for its source (a cache whose source stopped
+  //! sending: a player waits it out, IOControl::READ_WAIT; the read ends with data, the end of the
+  //! file, an error, or the player's abort). A disc on a network path is left as it was.
+  static bool InputReadsWait(bool file, bool disc, bool localPath)
+  {
+    return LocalInput(file, disc, localPath) || file;
+  }
+
   //! Before a read of the input: what the deadline has left, when it runs.
   void Begin(const XbmcThreads::EndTime<>& deadline)
   {
-- 
2.53.0

