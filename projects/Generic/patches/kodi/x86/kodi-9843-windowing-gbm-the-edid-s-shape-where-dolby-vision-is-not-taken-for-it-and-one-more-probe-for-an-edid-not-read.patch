From fd52acbc35499ed3f27353bd014fd6ed6e392052 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:13:02 +0000
Subject: [PATCH] windowing/gbm: the EDID's shape where Dolby Vision is not
 taken for it, and one more probe for an EDID not read whole

Where native Dolby Vision is unavailable for the display ("display": no
Dolby Vision Standard, or "invalid": a block that is not read), kodi.log
now has, once for each EDID and without debug logging, the shape of that
EDID (CDisplayInfo::EdidShape()): its bytes and blocks, the extension
count of the base block, the HDMI Forum EEODB, the tag and validity of
each block, where the Dolby OUI is in its bytes and the bytes of each
Dolby VSVDB. A report of "the display does not advertise Dolby Vision
Standard" then says whether the block is missing, past what a reader
reads, or in a block that is broken, which a user's log could not say
(the RTX 5090 with an LG G6 that gave HDR10 where a mini PC on the same
TV gave Dolby Vision).

An EDID with a copy of its block 0 as an extension block was not read
whole: a read of its E-DDC segments that ignores the segment gives
blocks 0 and 1 again for 2 and 3, and the blocks of the display that are
there are not read. The display is then probed once more when a video
starts (CDisplayLook::HowToRead(), baseCopy), once for each such EDID,
where it would otherwise be read from the kernel without a probe; the
log says so, and what the probe found. The copy itself is no CTA block,
and nothing of it is taken; another EDID from the probe is adopted as
any other.

The reason "invalid" in the log names the forms it now covers.
---
 xbmc/windowing/gbm/DisplayLook.h    |  6 ++++--
 xbmc/windowing/gbm/WinSystemGbm.cpp | 32 ++++++++++++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbm.h   |  6 ++++++
 3 files changed, 39 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/DisplayLook.h b/xbmc/windowing/gbm/DisplayLook.h
index 2648379..66cbaca 100644
--- a/xbmc/windowing/gbm/DisplayLook.h
+++ b/xbmc/windowing/gbm/DisplayLook.h
@@ -55,9 +55,11 @@ public:
   //! \param dvSeen a display that offered Dolby Vision was seen in this session
   //! \param dvDisabled native output is disabled after a failure
   //! \param hotplug a hot-plug event of the device came since the last look
-  static Read HowToRead(bool dvSeen, bool dvDisabled, bool hotplug)
+  //! \param baseCopy (Hades) the EDID known has a copy of its block 0 and was not probed again for
+  //!        it (CDisplayInfo::BaseBlockCopy()): it was not read whole, and is probed once more
+  static Read HowToRead(bool dvSeen, bool dvDisabled, bool hotplug, bool baseCopy = false)
   {
-    return dvSeen || dvDisabled || hotplug ? Read::PROBE : Read::CURRENT;
+    return dvSeen || dvDisabled || hotplug || baseCopy ? Read::PROBE : Read::CURRENT;
   }
 
   //! What a look that found an EDID changes
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index da1ce29..3c544a6 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1248,8 +1248,9 @@ bool RefreshRateFixed()
 const char* DVDisplayReasonText(std::string_view code)
 {
   if (code == "invalid")
-    return "the display's Dolby Vision block is in an EDID block that is not valid, or there are "
-           "several (see [display-info] above)";
+    return "the display's Dolby Vision block is not read: it is in an EDID block that is not "
+           "valid, or there are several different ones, or it is too short (see [display-info] "
+           "above and the line on the EDID below)";
   if (code == "legacy")
     return "the display advertises Dolby Vision only with the older signalling, the HDMI 1.4b "
            "vendor InfoFrame (a version 0 block, the 15-byte version 1 block, or the 12-byte one "
@@ -1431,6 +1432,16 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
       m_dvOutputStatus = status;
       CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output {}", status);
     }
+    // Hades: where the display is not taken for its EDID, the shape of that EDID, once for each
+    // (without debug logging: the next report of "the display does not advertise Dolby Vision
+    // Standard" says whether its block is missing, somewhere that is not read, or broken)
+    const std::string_view why = code;
+    if (info && (why == "display" || why == "invalid") && info->EdidShape() != m_dvEdidShapeLogged)
+    {
+      m_dvEdidShapeLogged = info->EdidShape();
+      CLog::Log(LOGINFO, "DVBridge: the display's EDID, as native output reads it: {}",
+                m_dvEdidShapeLogged);
+    }
   }
   return reason == nullptr;
 }
@@ -1775,7 +1786,19 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   const unsigned int hotplugs = m_displayWatch ? m_displayWatch->Hotplugs() : 0;
   const bool hotplug = hotplugs != m_lookHotplugs;
   m_lookHotplugs = hotplugs;
-  const CDisplayLook::Read how = CDisplayLook::HowToRead(m_dvDisplaySeen, m_dvDisabled, hotplug);
+  // Hades: an EDID with a copy of its block 0 was not read whole (CDisplayInfo::BaseBlockCopy()):
+  // the output is probed once more for it, with the first video that starts after it was read
+  // (where it is probed anyway, nothing more is asked of the display)
+  const bool baseCopy = info && info->BaseBlockCopy() && m_displayEdid != m_baseCopyProbedEdid;
+  if (baseCopy)
+    m_baseCopyProbedEdid = m_displayEdid;
+  const CDisplayLook::Read how =
+      CDisplayLook::HowToRead(m_dvDisplaySeen, m_dvDisabled, hotplug, baseCopy);
+  if (baseCopy)
+    CLog::Log(LOGINFO,
+              "DVBridge: the display's EDID has a copy of its block 0 at block {} (it was not read "
+              "whole): the output is probed again, once for that EDID",
+              info->BaseBlockCopy());
   const auto lookStart = std::chrono::steady_clock::now();
   drmModeConnector* probed =
       how == CDisplayLook::Read::PROBE
@@ -1825,6 +1848,9 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
             std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - lookStart)
                 .count(),
             outcome.adopt ? "another EDID" : same ? "the same EDID" : "no EDID that can be read");
+  if (baseCopy && same)
+    CLog::Log(LOGINFO, "DVBridge: the EDID read again is the same one, with the copy of block 0: "
+                       "it is used as it is (the copy is no CTA block, and nothing of it is taken)");
   if (outcome.unread)
   {
     if (!m_dvEdidUnread.exchange(true))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 12ed4f6..3427f2e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -397,6 +397,9 @@ protected:
   mutable std::mutex m_dvOutputStatusLock;
   mutable std::string m_dvOutputStatus;
   mutable std::string m_dvOutputReason;
+  //! Hades: the shape of the EDID last written to the log where native output did not take the
+  //! display for it, "display" or "invalid" (CDisplayInfo::EdidShape(); under m_dvOutputStatusLock)
+  mutable std::string m_dvEdidShapeLogged;
   //! Hades: the reason code of the failure that disabled native output, from what the driver
   //! said of its refusal (DisableNativeDVOutput()); empty when it said nothing (under
   //! m_dvOutputStatusLock)
@@ -503,6 +506,9 @@ protected:
   //! Hades: the hot-plug events of the device that the last look at the display had heard of
   //! (CDRMDisplayWatch::Hotplugs()); only DVNewVideo (VideoPlayer)
   unsigned int m_lookHotplugs{0};
+  //! Hades: the EDID with a copy of its block 0 (CDisplayInfo::BaseBlockCopy()) for which the
+  //! output was probed again, once (CheckDisplayChange()); only DVNewVideo (VideoPlayer)
+  std::vector<uint8_t> m_baseCopyProbedEdid;
   std::atomic<bool> m_displayGone{false};
   //! Counts the changes of what native output depends on in the display information (m_dvInfo)
   std::atomic<unsigned int> m_dvDisplayGeneration{0};
-- 
2.53.0

