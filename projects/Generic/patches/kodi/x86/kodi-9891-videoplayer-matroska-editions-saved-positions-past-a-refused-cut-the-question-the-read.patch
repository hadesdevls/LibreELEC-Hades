   return ok;
 }
+
+// What a reading on its own thread leaves for the application thread, which may stop waiting for it
+// before it ends: shared by both, freed by the last
+struct Reading
+{
+  Probe probe;
+  std::string path;
+  MKV_EDITIONS::File file;
+  int64_t durationMs = 0;
+  bool ok = false;
+  std::atomic<bool> finished{false};
+  CEvent done{true}; // manual reset: the busy dialog and the deadline both wait on it
+};
+
+enum class ReadResult
+{
+  READ,
+  FAILED,
+  LATE, //!< not done within the deadline: abandoned
+  CANCELLED, //!< the user cancelled the busy dialog: abandoned
+};
+
+// The header is read on a thread of its own, and the application thread waits with the busy dialog,
+// which keeps the interface drawn and can be cancelled: a server that does not answer (an open or a
+// read of the network that does not return, which no deadline of FFmpeg's reaches) never freezes
+// the interface. At the deadline, or when cancelled, the reading is abandoned: it stops at its next
+// read, or when its server gives up, and frees what it holds; its answer is not used.
+ReadResult ReadEditionsWaiting(const std::string& path,
+                               MKV_EDITIONS::File& out,
+                               int64_t& durationMs)
+{
+  auto reading = std::make_shared<Reading>();
+  reading->path = path;
+  reading->probe.deadline = std::chrono::steady_clock::now() + PROBE_DEADLINE;
+  std::thread(
+      [reading]
+      {
+        reading->ok =
+            ReadEditions(reading->probe, reading->path, reading->file, reading->durationMs);
+        reading->finished = true;
+        reading->done.Set();
+      })
+      .detach();
+  // the deadline, for a reading that hangs where FFmpeg's interrupt is not asked
+  std::thread(
+      [reading]
+      {
+        if (!reading->done.Wait(
+                std::chrono::duration_cast<std::chrono::milliseconds>(PROBE_DEADLINE + 1s)))
+          reading->done.Set();
+      })
+      .detach();
+  const bool waited = CGUIDialogBusy::WaitOnEvent(reading->done, 100, true);
+  if (!reading->finished)
+  {
+    reading->probe.abandoned = true;
+    return waited ? ReadResult::LATE : ReadResult::CANCELLED;
+  }
+  if (!reading->ok)
+    return ReadResult::FAILED;
+  out = reading->file;
+  durationMs = reading->durationMs;
+  return ReadResult::READ;
+}
 } // namespace
 
