+inline std::optional<Saved> SavedOfState(const std::string& state)
+{
+  if (state.empty())
+    return Saved{};
+  return ParseStateTag(state);
+}
+
+// Whether two saved editions are the same (the file as stored counts as one)
+inline bool SameSaved(const Saved& a, const Saved& b)
+{
+  return a.chosen == b.chosen && (!a.chosen || a.uid == b.uid);
