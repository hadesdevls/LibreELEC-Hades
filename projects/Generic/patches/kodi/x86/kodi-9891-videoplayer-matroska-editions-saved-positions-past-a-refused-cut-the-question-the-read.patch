 // The same arithmetic as CEdl::GetTimeWithoutCuts() and CEdl::GetTimeAfterRestoringCuts(), for cuts
 // in ascending order that do not overlap.
 inline int64_t RemoveCuts(const std::vector<Cut>& cuts, int64_t t)
@@ -475,14 +492,38 @@ inline int64_t RestoreCuts(const std::vector<Cut>& cuts, int64_t t)
   return t;
 }
 
+// The rule of CEdl::AddEdit() for an edit added to a list: refused when its times are the wrong way
+// round or before the start, when its start, or its end less 1 ms, lies in an edit that is there
+// (start <= t < end, as CEdl::InEdit() reads it), or when it surrounds one. `there`: every edit of
+// the list, cuts or not (a mute or a commercial break of an edit decision list file refuses a cut
+// that falls in it as well).
+inline bool EditAccepted(const std::vector<Cut>& there, const Cut& e)
+{
+  if (e.startMs < 0 || e.startMs >= e.endMs)
+    return false;
+  for (const Cut& h : there)
+  {
+    const auto in = [&h](int64_t t) { return t >= h.startMs && t < h.endMs; };
+    if (in(e.startMs) || in(e.endMs - 1) || (e.startMs < h.startMs && e.endMs > h.endMs))
+      return false;
+  }
+  return true;
+}
+
 // Where in the file a position saved with `saved` is. otherCuts: the cuts that do not come from an
-// edition (edit decision list files), which were there when it was saved too. Nothing when that
-// edition is not in this file or cannot be played: the position cannot be placed.
+// edition (edit decision list files), which were there when it was saved too; otherEdits: the other
+// edits of those files (mutes, commercial breaks), which cut nothing but refuse an edition's cut
+// that falls in them. The session that saved the position read those files first and then added the
+// cuts of its edition one by one through CEdl::AddEdit(), which refuses a cut that overlaps an edit
+// already there: such a cut was not removed from the time it saved, and is not added back here
+// (EditAccepted()). The result lies within the file (0 to its duration, where that is known).
+// Nothing when that edition is not in this file or cannot be played: the position cannot be placed.
 inline std::optional<int64_t> FileTimeOfSaved(const File& file,
                                               const Saved& saved,
                                               std::vector<Cut> otherCuts,
                                               int64_t savedMs,
-                                              int64_t fileDurationMs)
+                                              int64_t fileDurationMs,
+                                              const std::vector<Cut>& otherEdits = {})
 {
   if (saved.chosen)
   {
@@ -492,11 +533,22 @@ inline std::optional<int64_t> FileTimeOfSaved(const File& file,
     const Plan plan = PlanEdition(file, i, fileDurationMs); // not in the file: not offered
     if (!plan.offered)
       return std::nullopt;
-    otherCuts.insert(otherCuts.end(), plan.cuts.begin(), plan.cuts.end());
+    std::vector<Cut> there = otherCuts;
+    there.insert(there.end(), otherEdits.begin(), otherEdits.end());
+    for (const Cut& cut : plan.cuts)
+    {
+      if (!EditAccepted(there, cut))
+        continue;
+      there.push_back(cut);
+      otherCuts.push_back(cut);
+    }
   }
   std::sort(otherCuts.begin(), otherCuts.end(),
             [](const Cut& a, const Cut& b) { return a.startMs < b.startMs; });
-  return RestoreCuts(otherCuts, savedMs);
+  int64_t t = RestoreCuts(otherCuts, savedMs);
+  if (fileDurationMs > 0)
+    t = std::min(t, fileDurationMs);
+  return std::max<int64_t>(t, 0);
 }
 
