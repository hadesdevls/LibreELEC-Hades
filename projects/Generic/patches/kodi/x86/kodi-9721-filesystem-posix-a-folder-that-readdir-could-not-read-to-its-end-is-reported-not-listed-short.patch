diff --git a/xbmc/platform/posix/filesystem/DirEntry.h b/xbmc/platform/posix/filesystem/DirEntry.h
new file mode 100644
index 0000000..3068ea1
--- /dev/null
+++ b/xbmc/platform/posix/filesystem/DirEntry.h
@@ -0,0 +1,36 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cerrno>
+
+#include <dirent.h>
+
+namespace XFILE
+{
+/*!
+ * \brief Hades: read the next entry of an open directory stream and tell the end of the
+ *        directory from a failure
+ *
+ * readdir() returns NULL both at the end of the directory and when it fails, and says which only
+ * through errno, which it leaves alone at the end. A file system that cannot read a part of a
+ * directory (a damaged index of NTFS, a device that fails in the middle) used to end the listing
+ * for a caller that only looks at the pointer: a folder that looks complete and lacks files.
+ *
+ * \param dir the open directory stream
+ * \param entry the next entry, or nullptr at the end or after a failure
+ * \return 0, or the errno of the failure when no entry came because readdir() failed
+ */
+inline int ReadNextDirEntry(DIR* dir, dirent*& entry)
+{
+  errno = 0;
+  entry = readdir(dir);
+  return entry ? 0 : errno;
+}
+} // namespace XFILE
diff --git a/xbmc/platform/posix/filesystem/PosixDirectory.cpp b/xbmc/platform/posix/filesystem/PosixDirectory.cpp
index b8a74cc..744e5b3 100644
--- a/xbmc/platform/posix/filesystem/PosixDirectory.cpp
+++ b/xbmc/platform/posix/filesystem/PosixDirectory.cpp
@@ -8,11 +8,14 @@
 
 #include "PosixDirectory.h"
 
+#include "DirEntry.h"
 #include "FileItem.h"
 #include "FileItemList.h"
 #include "URL.h"
+#include "guilib/GUIUtils.h"
 #include "utils/AliasShortcutUtils.h"
 #include "utils/CharsetConverter.h"
+#include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
 #include "utils/XTimeUtils.h"
 #include "utils/log.h"
@@ -51,8 +54,14 @@ bool CPosixDirectory::GetDirectory(const CURL& url, CFileItemList& items)
 
   std::vector<std::shared_ptr<CFileItem>> fileItems;
   struct dirent* entry;
-  while ((entry = readdir(dir)) != NULL)
+  int readError = 0;
+  while (true)
   {
+    // Hades: a readdir() that fails ends the listing like the end of the directory does; only
+    // errno tells them apart
+    readError = ReadNextDirEntry(dir, entry);
+    if (!entry)
+      break;
     const std::string& name = entry->d_name;
 
     if (std::ranges::find(exclusions, name) == exclusions.end())
@@ -98,9 +107,23 @@ bool CPosixDirectory::GetDirectory(const CURL& url, CFileItemList& items)
         item->SetProperty("file:hidden", true);
     }
   }
-  items.AddItems(std::move(fileItems));
-
   closedir(dir);
+
+  if (readError != 0)
+  {
+    // Hades: what was read is not shown: a folder that lacks files without saying so is worse than
+    // one that says it could not be read (the kernel gives EIO for a damaged index of NTFS)
+    const std::string reason = strerror(readError);
+    CLog::Log(LOGERROR,
+              "CPosixDirectory::{} - reading the folder {} failed after {} entries: {} ({}); "
+              "the list is not shown because it would be incomplete",
+              __FUNCTION__, url.GetRedacted(), fileItems.size(), reason, readError);
+    if (m_flags & DIR_FLAG_ALLOW_PROMPT)
+      SetErrorDialog(257, StringUtils::Format(CGUIUtils::GetHadesString(41800, 33800), reason));
+    return false;
+  }
+
+  items.AddItems(std::move(fileItems));
   return true;
 }
 
@@ -152,8 +175,20 @@ bool CPosixDirectory::RemoveRecursive(const CURL& url)
 
   bool success(true);
   struct dirent* entry;
-  while ((entry = readdir(dir)) != NULL)
+  while (true)
   {
+    const int readError = ReadNextDirEntry(dir, entry);
+    if (!entry)
+    {
+      // Hades: a folder that could not be read to its end is not removed
+      if (readError != 0)
+      {
+        CLog::Log(LOGERROR, "CPosixDirectory::{} - reading the folder {} failed: {} ({})",
+                  __FUNCTION__, CURL::GetRedacted(root), strerror(readError), readError);
+        success = false;
+      }
+      break;
+    }
     if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
       continue;
 
