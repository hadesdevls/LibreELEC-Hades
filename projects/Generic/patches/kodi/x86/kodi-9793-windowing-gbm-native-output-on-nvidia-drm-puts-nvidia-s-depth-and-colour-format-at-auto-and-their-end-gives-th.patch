diff --git a/xbmc/windowing/gbm/drm/TransportSpecs.h b/xbmc/windowing/gbm/drm/TransportSpecs.h
new file mode 100644
index 0000000..a584d00
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/TransportSpecs.h
@@ -0,0 +1,143 @@
+/*
