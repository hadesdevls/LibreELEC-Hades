+
+#pragma once
+
+#include "OutputState.h"
+#include "windowing/gbm/HdmiVrrOff.h"
+#include "windowing/gbm/OutputFormat.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM::OUTPUT_STATE::TRANSPORT
+{
+
+// ---- what the drivers call the signals of the transport ----
+
+constexpr const char* KERNEL_DV = "DVBRIDGE_DV_STANDARD_LAB";
+constexpr const char* KERNEL_LOW_LATENCY = "DVBRIDGE_DV_LOW_LATENCY_LAB";
+constexpr const char* KERNEL_HDMI14B = "DVBRIDGE_DV_HDMI14B_LAB";
+constexpr const char* KERNEL_HDR_TUNNEL = "DVBRIDGE_HDR10_TUNNEL_LAB";
+constexpr const char* NVIDIA_VSIF = "NV_HDMI_VSIF_METADATA";
+constexpr const char* NVIDIA_LOW_LATENCY = "NV_HDMI_DV_LOW_LATENCY";
+constexpr const char* NVIDIA_HDMI14B = "NV_HDMI_DV_HDMI14B";
+
+//! The depth that NVIDIA's driver 620 asks NVKMS for, whatever "max bpc" says ("auto", "6", "8",
+//! "10", "12"; HDMI connectors)
+constexpr const char* NVIDIA_OUTPUT_BPC = "NV_CONNECTOR_OUTPUT_BPC";
+
+//! 1.0 in the S31.32 fixed point of NV_PLANE_DEGAMMA_MULTIPLIER and NV_CRTC_REGAMMA_DIVISOR
+constexpr uint64_t NVIDIA_ONE = uint64_t{1} << 32;
+//! "rotation" unrotated: DRM_MODE_ROTATE_0, bit 0 (OutputHandover.cpp checks it against the kernel's)
+constexpr uint64_t ROTATE_0 = 1;
+
+//! What native output is on the output
+struct Kind
+{
+  bool nvidia{false}; //!< nvidia-drm (else the kernel's dvbridge properties: i915/xe, amdgpu)
+  bool lowLatency{false}; //!< Dolby Vision Low-Latency
+  bool hdmi14b{false}; //!< the HDMI 1.4b signalling of Dolby Vision
+  bool hdr10Tunnel{false}; //!< HDR over the tunnel (the kernel's backends only)
+  uint32_t signal{0}; //!< nvidia-drm: the blob of the vendor InfoFrame (made by the caller)
+};
+
+/*!
+ * \brief What the transport sets (COutputHandover::TakeOver()): the properties of the output that
+ *        must be as they are in it so that what is scanned out reaches the display bit for bit. A
+ *        property that is not there is no transport where it is not required. What each is to the
+ *        end of native output (a signal, a setting) is PartOf()'s.
+ */
+inline std::vector<Spec> TransportSpecs(const Kind& kind)
+{
+  std::vector<Spec> specs;
+  const auto number = [&specs](Role role, const char* name, uint64_t value, bool required)
+  { specs.push_back({role, name, Spec::How::NUMBER, value, {}, required}); };
+  const auto named = [&specs](Role role, const char* name, const char* value, bool required)
+  { specs.push_back({role, name, Spec::How::ENUM_NAME, 0, value, required}); };
+  constexpr auto CONNECTOR = Role::CONNECTOR;
+  constexpr auto CRTC = Role::CRTC;
+  constexpr auto PLANE = Role::PLANE;
+
+  if (!kind.nvidia)
+  {
+    number(CONNECTOR, KERNEL_DV, 1, true);
+    if (kind.lowLatency)
+      number(CONNECTOR, KERNEL_LOW_LATENCY, 1, true);
+    if (kind.hdmi14b)
+      number(CONNECTOR, KERNEL_HDMI14B, 1, true);
+    // HDR over the tunnel: the kernel requires the HDR metadata that Kodi sets for the stream, and
+    // sends no Dolby VSIF. Otherwise HDR_OUTPUT_METADATA goes to 0, and may not be there: i915
+    // offers the tunnel from display version 9 on and attaches it to an HDMI connector from
+    // version 10 on, and the kernel refuses the tunnel with HDR metadata in the connector state;
+    // without the property there can be none to keep.
+    if (kind.hdr10Tunnel)
+      number(CONNECTOR, KERNEL_HDR_TUNNEL, 1, true);
+    else
+      number(CONNECTOR, "HDR_OUTPUT_METADATA", 0, false);
+    number(CONNECTOR, "max bpc", 8, true);
+    named(CONNECTOR, "Broadcast RGB", "Full", true);
+    named(CONNECTOR, "Colorspace", "Default", true);
+    // The tunnel is RGB (amdgpu refuses another colour format than AUTO or RGB): AUTO with it; what
+    // the user chose, or another program left, goes back with its end
+    named(CONNECTOR, OUTPUT_FORMAT::PROPERTY, "AUTO", false);
+  }
+  else
+  {
+    // Broadcast RGB is not touched on nvidia-drm: RGB output is full range by default, and with
+    // the Dolby VSIF in the state the kernel keeps the head in full range whatever it says
+    // (nvidia-open-kernel-modules-9056)
+    specs.push_back({CONNECTOR, NVIDIA_VSIF, Spec::How::BLOB, kind.signal, {}, true});
+    if (kind.lowLatency)
+      number(CONNECTOR, NVIDIA_LOW_LATENCY, 1, true);
+    if (kind.hdmi14b)
+      number(CONNECTOR, NVIDIA_HDMI14B, 1, true);
+    // HDMI VRR is left off while the transport is on, where nvidia-drm has the property (Turing and
+    // Ampere: CHdmiVrrOff)
+    number(CONNECTOR, CHdmiVrrOff::PROPERTY, 1, false);
+    number(CONNECTOR, "HDR_OUTPUT_METADATA", 0, true);
+    number(CONNECTOR, "max bpc", 8, true);
+    named(CONNECTOR, "dithering mode", "off", true);
+    // The tunnel is RGB at 8 bpc, in Standard, Low-Latency (whose AVI InfoFrame of YCbCr 4:2:2
+    // NVKMS makes itself from NV_HDMI_DV_LOW_LATENCY, over the same RGB bytes) and the HDMI 1.4b
+    // signalling alike: driver 620's own colour format and depth are "auto" with it, so that
+    // "max bpc" 8 decides the depth (nvidia-open-kernel-modules-9000), and the driver refuses a
+    // state with Dolby Vision where either is another than "auto" (or RGB, 8):
+    // nvidia-open-kernel-modules-9062. What the user chose (the colour format of the settings,
+    // videoscreen.hadescolorformat) or another program left goes back with its end, as a setting
+    // (PartOf()). Kodi does not set NV_CONNECTOR_OUTPUT_BPC itself (its depth goes through "max
+    // bpc").
+    named(CONNECTOR, OUTPUT_FORMAT::PROPERTY_NVIDIA, "auto", false);
+    named(CONNECTOR, NVIDIA_OUTPUT_BPC, "auto", false);
+    named(CONNECTOR, "Colorspace", "Default", true);
+    named(CRTC, "NV_CRTC_REGAMMA_TF", "Default", false);
+    number(CRTC, "NV_CRTC_REGAMMA_LUT", 0, false);
+    number(CRTC, "NV_CRTC_REGAMMA_DIVISOR", NVIDIA_ONE, false);
+    number(CRTC, "NV_CRTC_COLOR_PASSTHROUGH", 0, false);
+    named(PLANE, "NV_INPUT_COLORSPACE", "None", false);
+    for (const char* blob : {"NV_HDR_STATIC_METADATA", "NV_PLANE_LMS_CTM",
+                             "NV_PLANE_LMS_TO_ITP_CTM", "NV_PLANE_ITP_TO_LMS_CTM",
+                             "NV_PLANE_BLEND_CTM", "NV_PLANE_DEGAMMA_LUT", "NV_PLANE_TMO_LUT"})
+      number(PLANE, blob, 0, false);
+    named(PLANE, "NV_PLANE_DEGAMMA_TF", "Default", false);
+    number(PLANE, "NV_PLANE_DEGAMMA_MULTIPLIER", NVIDIA_ONE, false);
+    number(PLANE, "NV_PLANE_COLOR_PASSTHROUGH", 0, false);
+  }
+  // Neutral colour processing and an opaque, unrotated plane, for either driver
+  number(CRTC, "CTM", 0, false);
+  number(CRTC, "GAMMA_LUT", 0, false);
+  number(CRTC, "DEGAMMA_LUT", 0, false);
+  number(CRTC, "VRR_ENABLED", 0, false);
+  number(PLANE, "rotation", ROTATE_0, false);
+  number(PLANE, "alpha", 65535, false);
+  number(PLANE, "COLOR_PIPELINE", 0, false);
+  named(PLANE, "pixel blend mode", "None", false);
+  return specs;
+}
+
+} // namespace KODI::WINDOWING::GBM::OUTPUT_STATE::TRANSPORT
