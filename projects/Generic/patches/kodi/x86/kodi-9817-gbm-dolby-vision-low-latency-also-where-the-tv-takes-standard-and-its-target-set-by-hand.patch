+  // Hades: Low-Latency also to a display that takes Dolby Vision Standard, where it offers Low-Latency
+  // too and that is asked (videoscreen.hadesdvllalways, off by default: the mapping is then that of
+  // Hades, not that of the display)
+  const auto info = DVDisplayInfo();
+  return info && info->SupportsStandardDolbyVision() && info->GetDolbyVideoBlock().valid &&
+         info->GetDolbyVideoBlock().lowLatency && DVLowLatencyAlways();
+}
+
 DV_DISPLAY::Signal CWinSystemGbm::NativeDVSignal() const
 {
+  if (NativeDVLowLatencyOverStandard())
+    return DV_DISPLAY::Signal::LOW_LATENCY;
   // (the settings are read only where the display makes them matter)
   return DV_DISPLAY::SignalOf(
       DVDisplayInfo().get(), [this] { return DVLowLatencyOn(); }, [this] { return DVHdmi14bOn(); });
