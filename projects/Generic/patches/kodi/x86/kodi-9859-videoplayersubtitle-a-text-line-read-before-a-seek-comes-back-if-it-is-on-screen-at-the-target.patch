+
+// Hades: the codecs whose Flush() drops every line they were given (CSubtitlesAdapter), so a line
+// read before a seek is lost. The ASS codec keeps its libass track on a flush (its Flush() does not
+// flush the events, and libass drops a packet read again by its ReadOrder): it does not need this.
+// Image subtitles (PGS, VobSub) are not text: a display set can depend on the ones before it.
+bool KeepsLinesForSeek(const CDVDStreamInfo& hints)
+{
+  switch (hints.codec)
+  {
+    case AV_CODEC_ID_SUBRIP:
+    case AV_CODEC_ID_TEXT:
+    case AV_CODEC_ID_MOV_TEXT:
+      return true;
+    case AV_CODEC_ID_WEBVTT:
+      // the cues of FFmpeg's demuxer (it alone sets the flag), timed by their packet; not WebVTT
+      // that an add-on sends as one file or as segments (its own timing, maybe never flushed)
+      return (hints.flags & FLAG_WEBVTT_DATA_PACKETS) != 0;
+    default:
+      return false;
+  }
+}
