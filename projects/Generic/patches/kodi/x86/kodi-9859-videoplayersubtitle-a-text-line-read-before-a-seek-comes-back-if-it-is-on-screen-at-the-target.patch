+/*!
+ * \brief The text subtitle packets of one stream as they were read, to give back after a seek.
+ *
+ * A seek of the FFmpeg demuxer lands on the video keyframe at or before the target, and in
+ * Matroska it starts reading at the cluster of that keyframe: a subtitle line stored before it
+ * (it started earlier) is not read again, even if it is still on screen at the target. The text
+ * codecs flush every line they had on a seek, so that line only comes back if it was read again.
+ *
+ * This memory keeps the packets of one stream as they are read, bounded in bytes and in time
+ * around the newest one. After a seek, Recall() gives back the packets whose line is on screen
+ * at the target (or ended shortly before it: a seek that is not accurate starts on the keyframe),
+ * and remembers them: when the demuxer reads one of them again, TakeRecalled() says so and it is
+ * not decoded twice. It holds only packets read from the file, so what it gives back is what a
+ * read from the start of the line would have given.
+ *
+ * Only a packet with a known start and a duration is kept. A packet with a timestamp correction
+ * of the player (a discontinuity) empties the memory and is not kept: the seek target and the
+ * remembered times could then be on different timelines.
+ */
+class CSubtitleSeekMemory
+{
+public:
+  struct Packet
+  {
+    double pts{DVD_NOPTS_VALUE};
+    double dts{DVD_NOPTS_VALUE};
+    double duration{0.0};
+    std::vector<uint8_t> data;
+    uint64_t order{0}; //!< insertion order, the oldest is dropped first
+
+    double Start() const { return pts != DVD_NOPTS_VALUE ? pts : dts; }
+    double End() const { return Start() + duration; }
+    bool Same(double p, double d, double dur, const uint8_t* bytes, size_t size) const
+    {
+      return pts == p && dts == d && duration == dur && data.size() == size &&
+             (size == 0 || std::memcmp(data.data(), bytes, size) == 0);
+    }
+  };
+
+  static constexpr size_t MAX_BYTES = 2 * 1024 * 1024;
+  static constexpr size_t PACKET_OVERHEAD = 64; //!< counted for each packet besides its data
+  //! packets further than this from the newest one (film time) are dropped
+  static constexpr double MAX_SPAN = 10.0 * 60.0 * DVD_TIME_BASE;
+  //! lines that ended up to this long before the target are given back too
+  static constexpr double RECALL_LEAD = 20.0 * DVD_TIME_BASE;
+
+  /*!
+   * \brief Keep a packet as it was read
+   * \return true if it is kept now; false if it has no start or duration, is too big, has a
+   *         timestamp correction, or is kept already (read again after a seek back)
+   */
+  bool Remember(
+      double pts, double dts, double duration, double ptsOffset, const uint8_t* data, size_t size)
+  {
+    if (ptsOffset != 0.0)
+    {
+      Clear();
+      return false;
+    }
+    const double start = pts != DVD_NOPTS_VALUE ? pts : dts;
+    if (start == DVD_NOPTS_VALUE || duration == DVD_NOPTS_VALUE || !(duration > 0.0) ||
+        size == 0 || data == nullptr || size + PACKET_OVERHEAD > MAX_BYTES)
+      return false;
+
+    auto it = std::lower_bound(m_packets.begin(), m_packets.end(), start,
+                               [](const Packet& p, double t) { return p.Start() < t; });
+    for (auto same = it; same != m_packets.end() && same->Start() == start; ++same)
+    {
+      if (same->Same(pts, dts, duration, data, size))
+        return false;
+    }
+
+    Packet packet;
+    packet.pts = pts;
+    packet.dts = dts;
+    packet.duration = duration;
+    packet.data.assign(data, data + size);
+    packet.order = m_order++;
+    auto at = std::upper_bound(m_packets.begin(), m_packets.end(), start,
+                               [](double t, const Packet& p) { return t < p.Start(); });
+    m_packets.insert(at, std::move(packet));
+    m_bytes += size + PACKET_OVERHEAD;
+    Trim(start);
+    return true;
+  }
+
+  /*!
+   * \brief The packets to give back after a seek to target, in time order
+   *
+   * Those that start at or before target and end after target - RECALL_LEAD. They are kept as
+   * given back until EndRecall(), for TakeRecalled().
+   */
+  std::vector<Packet> Recall(double target)
+  {
+    m_recalled.clear();
+    m_recalledLast = DVD_NOPTS_VALUE;
+    if (target == DVD_NOPTS_VALUE)
+      return {};
+    for (const Packet& p : m_packets)
+    {
+      if (p.Start() > target)
+        break;
+      if (p.End() > target - RECALL_LEAD)
+        m_recalled.push_back(p);
+    }
+    if (!m_recalled.empty())
+      m_recalledLast = m_recalled.back().Start();
+    return m_recalled;
+  }
+
+  /*!
+   * \brief A packet read after a seek: true if Recall() gave it back already
+   *
+   * Packets of one stream come in time order: once one starts after the last given back,
+   * nothing more is expected.
+   */
+  bool TakeRecalled(double pts, double dts, double duration, const uint8_t* data, size_t size)
+  {
+    if (m_recalled.empty())
+      return false;
+    const double start = pts != DVD_NOPTS_VALUE ? pts : dts;
+    for (auto it = m_recalled.begin(); it != m_recalled.end(); ++it)
+    {
+      if (it->Same(pts, dts, duration, data, size))
+      {
+        m_recalled.erase(it);
+        return true;
+      }
+    }
+    if (start != DVD_NOPTS_VALUE && m_recalledLast != DVD_NOPTS_VALUE && start > m_recalledLast)
+      EndRecall();
+    return false;
+  }
+
+  void EndRecall()
+  {
+    m_recalled.clear();
+    m_recalledLast = DVD_NOPTS_VALUE;
+  }
+
+  void Clear()
+  {
+    m_packets.clear();
+    m_bytes = 0;
+    EndRecall();
+  }
+
+  size_t Size() const { return m_packets.size(); }
+  size_t Bytes() const { return m_bytes; }
+  size_t Expected() const { return m_recalled.size(); }
+
+private:
+  void Trim(double newest)
+  {
+    // further than MAX_SPAN from the newest packet, on either side (a seek far back starts anew)
+    const size_t before = m_packets.size();
+    m_packets.erase(std::remove_if(m_packets.begin(), m_packets.end(),
+                                   [newest](const Packet& p)
+                                   {
+                                     return p.Start() < newest - MAX_SPAN ||
+                                            p.Start() > newest + MAX_SPAN;
+                                   }),
+                    m_packets.end());
+    if (m_packets.size() != before)
+      Recount();
+
+    while (m_bytes > MAX_BYTES && !m_packets.empty())
+    {
+      auto oldest = std::min_element(m_packets.begin(), m_packets.end(),
+                                     [](const Packet& a, const Packet& b)
+                                     { return a.order < b.order; });
+      m_bytes -= oldest->data.size() + PACKET_OVERHEAD;
+      m_packets.erase(oldest);
+    }
+  }
+
+  void Recount()
+  {
+    m_bytes = 0;
+    for (const Packet& p : m_packets)
+      m_bytes += p.data.size() + PACKET_OVERHEAD;
+  }
+
+  std::vector<Packet> m_packets; //!< in order of start
+  size_t m_bytes{0};
+  uint64_t m_order{0};
+  std::vector<Packet> m_recalled;
+  double m_recalledLast{DVD_NOPTS_VALUE};
+};
