From 43b31ec1995934f50c83269950cc1f6bbdaf82d1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:18:04 +0000
Subject: [PATCH] DVDDemuxFFmpeg: find the H.264 track that carries a second
 view (MVC)

A Matroska file made of a 3D Blu-ray carries both views of the video
in one track. Nothing in what libavformat gives of the container says
so: the track is plain H.264 by its codec, and its stereo mode, where
the file has one, is "both eyes in one block", a layout that Kodi has
no way to show. The file played in 2D, as its base view.

The second view is declared in the private data of the codec only, as
a box 'mvcC' behind the record of the base view. A track that has it
(KODI::MULTIVIEW::HasMvcConfiguration) is now marked as two views when
the setting videoplayer.hades3dmvc is on, this build has the decoder
that outputs both views ("h264_mvc", looked up by its name) and the
container names no layout within the picture. Its stereo mode becomes
"left_right", which is the picture that its decoder gives (both eyes
side by side, the left one on the left), so that whatever reads the
mode of a stream before a picture is decoded sees a stereoscopic
video; and the eye of its base view goes with the mark: the left one,
unless the container says that the right eye comes first.

A track that is not H.264, or whose private data has no such box, takes
nothing of this beyond the look at its private data, and is announced
as before. A track whose box is there while the setting is off, the
decoder is missing or the container names another layout is announced
as before too, and a line in the log says which of the three it was.

Not covered: a 3D Blu-ray itself (disc, folder or image), whose second
view is in another clip, and a transport stream file with the second
view in a track of its own. They play their base view, as before.

Finding the track by its 'mvcC' box is what Dom Cobley (popcornmix)
does in his Kodi branch fix-stereoscopic-3d-gbm-upstream; the code here
is written anew, and what is decided is in MultiviewChoice.h with its
host test.

Read and compiled; not run, there is no such file here. What a file
made by MakeMKV has to show: the log line "H.264 with a second view
(MVC)" of the demuxer, the decoder ff-h264_mvc in the player
information (which gives the size of one view, as the decoder codes
it), a picture of 3840x1080 shown as 16:9 in what the renderer logs,
and at the end the count of pictures that went out with both views.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 44 +++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 711af42..dfc43d9 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -20,6 +20,7 @@
 #include "commons/Exception.h"
 #include "cores/FFmpeg.h"
 #include "cores/MenuType.h"
+#include "cores/VideoPlayer/MultiviewChoice.h"
 #include "filesystem/CurlFile.h"
 #include "filesystem/Directory.h"
 #include "filesystem/File.h"
@@ -2199,6 +2200,49 @@ CDemuxStream* CDVDDemuxFFmpeg::AddStream(int streamIdx)
         if (!stereoMode.empty())
           st->stereo_mode = stereoMode;
 
+        // Hades: a track whose two eyes are coded as two views (H.264 MVC, as a Matroska file
+        // made of a 3D Blu-ray has it) is announced as what its decoder gives, one picture with
+        // both eyes side by side, and marked for that decoder. Only when the private data of the
+        // codec says that there is a second view, the setting allows it, this build has that
+        // decoder and the container names no layout within the picture
+        // (KODI::MULTIVIEW::TwoViews): any other track is the stream it always was.
+        if (pStream->codecpar->codec_id == AV_CODEC_ID_H264 &&
+            pStream->codecpar->extradata_size > 0 &&
+            KODI::MULTIVIEW::HasMvcConfiguration(pStream->codecpar->extradata,
+                                                 pStream->codecpar->extradata_size))
+        {
+          const std::string containerMode = st->stereo_mode;
+          KODI::MULTIVIEW::Track track;
+          track.h264 = true;
+          track.allowed = CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+              CSettings::SETTING_VIDEOPLAYER_HADES3DMVC);
+          track.decoder = avcodec_find_decoder_by_name(KODI::MULTIVIEW::DECODER_NAME) != nullptr;
+          track.extradata = pStream->codecpar->extradata;
+          track.extradataSize = pStream->codecpar->extradata_size;
+          track.stereoMode = containerMode;
+          if (const auto baseEye = KODI::MULTIVIEW::TwoViews(track))
+          {
+            st->multiview = true;
+            st->multiviewBaseRight = *baseEye == KODI::MULTIVIEW::BaseEye::RIGHT;
+            st->stereo_mode = KODI::MULTIVIEW::PACKED_STEREO_MODE;
+            CLog::Log(LOGINFO,
+                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC); "
+                      "both views are to be decoded, the base view as the {} eye (the container "
+                      "says \"{}\")",
+                      pStream->index, st->multiviewBaseRight ? "right" : "left", containerMode);
+          }
+          else
+          {
+            CLog::Log(LOGINFO,
+                      "CDVDDemuxFFmpeg::AddStream - stream {}: H.264 with a second view (MVC) "
+                      "that is not decoded ({}); its base view plays, as before",
+                      pStream->index,
+                      !track.allowed   ? "the setting is off"
+                      : !track.decoder ? "this build has no decoder for it"
+                                       : "the container names another layout");
+          }
+        }
+
 
         if (m_pInput->IsStreamType(DVDSTREAM_TYPE_DVD))
         {
-- 
