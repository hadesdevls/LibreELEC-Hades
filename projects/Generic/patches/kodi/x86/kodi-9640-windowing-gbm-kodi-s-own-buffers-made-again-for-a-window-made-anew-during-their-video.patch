From 17efb5fac7be0fd77f6de83c39e2dace70454784 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:18:13 +0000
Subject: [PATCH] windowing/gbm: Kodi's own buffers made again for a window
 made anew during their video

A window made anew during a video (CreateNewWindow(): another size) turned Kodi's own buffers off,
and nothing asked for them again: SetVideoOutput() is called only by a renderer's Configure(), and
CRenderManager configures the renderer before it chooses the mode of the video (Configure() sets
m_bTriggerUpdateResolution; UpdateResolution() then sets the resolution and only updates the
renderer). A GUI at 1080p and a video in 3840x2160 with the adjustment of the refresh rate, a GUI
resolution set during a video, or a mode of another size chosen again during a file (ModeChosenAgain())
would have left the video at 8 bits until it ended.

Now the depth that the buffers were made for is kept, and once the new window is made, its mode set
and its plane found, they are made again for it (OwnScanoutFollow()): made, probed and tested in a
commit as in SetVideoOutput() (another size, mode or display is another key: checked again), and put
on a plane that takes their format. Where any of it fails, the window's buffers, which are in place,
take the video at 8 bits, with a line that says so. The commit of the change of mode (SetFullScreen())
then carries one of them, as it carries a half-float window, which CreateNewWindow() keeps.

Read, and unchanged, because they keep the window and Kodi's own buffers as they are: a change of the
refresh rate alone (SetFullScreen() with the same size, or the change held for the output of the
video, CModeChangeHold: the same size only), a change of mode that the driver refused and that is asked
for again with later frames (CModesetRetry), the end of the HDR signalling asked for again
(CHDRSignal::EndRetry), the output turned off and on (the hot-plug relink, a flip that does not come,
blanking: commits of the buffer locked last), and a change of mode given up (OnLostDevice() and back).
A display connected later restarts Kodi (CDRMDisplayWatch). A frame-packed (3D) mode takes no such
buffers: it says so once.

Tested on the host (tests/ownscanout_test.cpp, llvmpipe: 24 of 24): a new surface whose first buffer is
locked as the window is made, then new buffers of Kodi's own at once: a buffer in each of 30 frames,
never one held for the screen, the window's buffer given back; the buffers of before destroyed while
the old queue still names them, which gives nothing back to them when it goes. Not run: the
CreateNewWindow() path itself (no GPU).
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 46 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbmEGLContext.h   |  6 +++
 2 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index 546c34e..592a3fe 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -186,9 +186,13 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
   //Notify other subsystems that we change resolution
   OnLostDevice();
 
-  // Hades: Kodi's own buffers are of the size of the window that goes: the new one is the window's
-  // own (of the EGL config in use, 8 bits), until the output of a video asks for them again
-  if (OwnScanoutOn())
+  // Hades: Kodi's own buffers are of the size of the window that goes: they go with it, and are
+  // made again for the new one below, for the video they were made for. Nothing else asks for them
+  // again during that video: the renderer is configured (SetVideoOutput()) before the mode of the
+  // video is chosen (CRenderManager::UpdateResolution(), which only updates the renderer), and the
+  // GUI resolution set during a video changes the window too.
+  const int ownDepth = OwnScanoutOn() ? m_ownDepth : 0;
+  if (ownDepth)
     OwnScanoutStop("the window is made again, for another mode", false);
 
   if (!DestroyWindow())
@@ -295,9 +299,38 @@ bool CWinSystemGbmEGLContext::CreateNewWindow(const std::string& name,
   m_nHeight = res.iHeight;
   m_fRefreshRate = res.fRefreshRate;
   CLog::Log(LOGDEBUG, "CWinSystemGbmEGLContext::{} - initialized GBM", __FUNCTION__);
+  if (ownDepth)
+    OwnScanoutFollow(ownDepth);
   return true;
 }
 
+void CWinSystemGbmEGLContext::OwnScanoutFollow(int bitDepth)
+{
+  // Hades: the video that went out through Kodi's own buffers goes on in this window: they are made
+  // for it, checked again (another size, mode or display: another key) and put in place of the
+  // window's, on a plane that takes their format, as SetVideoOutput() puts them. Where that fails,
+  // the window's buffers, which are in place, take the video, at 8 bits, as before.
+  if (!m_DRM->GetCrtc() || !OwnScanoutStart(bitDepth))
+  {
+    CLog::LogF(LOGWARNING, "HDR output: Kodi's own buffers could not be made again for the new "
+                           "window ({}x{} @ {:.3f} Hz): the video goes on at 8 bits",
+               m_nWidth, m_nHeight, m_fRefreshRate);
+    return;
+  }
+  const uint32_t format = m_ownScanout->Format();
+  const uint64_t modifier = m_ownScanout->Modifier();
+  if (!m_DRM->FindGuiPlane(format, modifier))
+  {
+    OwnScanoutStop("no plane takes them in the new mode", true);
+    // (the plane of the window's buffers again; it was found for them above)
+    m_DRM->FindGuiPlane(m_ownWindowFormat, m_ownWindowModifier);
+    return;
+  }
+  CLog::LogF(LOGINFO, "HDR output: Kodi's own buffers made again for the new window ({}x{} @ "
+                      "{:.3f} Hz): the video goes on at more than 8 bits",
+             m_nWidth, m_nHeight, m_fRefreshRate);
+}
+
 bool CWinSystemGbmEGLContext::DestroyWindow()
 {
   m_eglContext.DestroySurface();
@@ -818,7 +851,12 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
     // A frame-packed (3D) mode of nvidia-drm wants a buffer of its own kind
     // (FramePackedBufferDemands()): not one of these
     if (int width = m_nWidth; m_DRM->FramePackedBufferDemands(format->drm, width))
+    {
+      if (m_ownFailedKeys.insert("frame-packed").second)
+        CLog::LogF(LOGINFO, "HDR output: not through Kodi's own buffers in a frame-packed (3D) "
+                            "mode: video of more than 8 bits goes out at 8 bits in it");
       return false;
+    }
     const std::string key =
         StringUtils::Format("{}x{}@{:.3f} display {} {}", m_nWidth, m_nHeight, m_fRefreshRate,
                             m_displayChanges.load(), DRMHELPERS::FourCCToString(format->drm));
@@ -854,6 +892,7 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
     m_ownScanout = own;
     m_ownFloat = own->Floating();
     m_ownBits = own->OutputBits();
+    m_ownDepth = bitDepth;
     plane->SetFormat(own->Format());
     plane->SetModifier(own->Modifier());
     BindOwnBack();
@@ -893,6 +932,7 @@ void CWinSystemGbmEGLContext::OwnScanoutStop(const std::string& why, bool failed
   m_ownRetiredFlips = 0;
   m_ownBits = 0;
   m_ownFloat = false;
+  m_ownDepth = 0;
   m_ownFullFrames = COwnScanout::BUFFERS + 1;
   COwnScanout::UnbindAll();
   if (CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane())
diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
index c9fd885..656f000 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
@@ -135,6 +135,9 @@ protected:
   //! \brief Back to the window's buffers (which stayed, unswapped); a failure keeps Kodi's own
   //! from this video, as a half-float output that failed
   void OwnScanoutStop(const std::string& why, bool failed);
+  //! \brief Kodi's own buffers made again for a window made anew during the video they were made
+  //! for (CreateNewWindow()); the window's buffers otherwise
+  void OwnScanoutFollow(int bitDepth);
   //! \brief Once in every presentation pass: Kodi's own buffers that went are destroyed once they
   //! are off the screen
   void OwnScanoutRetire(bool rendered, bool refused);
@@ -162,6 +165,9 @@ protected:
   //! The format and the modifier of the plane with the window's buffers, put back with them
   uint32_t m_ownWindowFormat{0};
   uint64_t m_ownWindowModifier{0};
+  //! The depth of the video that Kodi's own buffers were made for (0: none in use): a window made
+  //! anew for another mode during that video has them made again for it (CreateNewWindow())
+  int m_ownDepth{0};
 
   EGLint m_renderableType{0};
   bool m_highBitDepthReported{false};
-- 
2.53.0

