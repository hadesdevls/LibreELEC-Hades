+/*!
+ * \brief Hades: whether the base layer of a Dolby Vision stream is the HDR10 version of its film:
+ *        profile 7 (whose base layer compatibility is 6, the HDR10 of a Blu-ray disc) and 8.1
+ *
+ * A picture by itself, made for displays without Dolby Vision, in PQ and BT.2020. The
+ * reconstruction (the RPU and, in profile 7 with a full enhancement layer, its residual) is the
+ * picture as it was graded, with the metadata of each picture.
+ */
+constexpr bool BaseLayerIsHdr10(int profile, int compatibility)
+{
+  return (profile == 7 && compatibility == 6) || (profile == 8 && compatibility == 1);
+}
