From 4c97d6c72cd2cf8804a5227c5e694da52fb44c04 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 6 Oct 2026 19:41:39 +0100
Subject: [PATCH] [RetroPlayer] Keep the shader frame count in medium precision
 on GLES

Shaders declare FrameCount at medium precision on GLES, which some
drivers implement as a 16-bit float. A count past 65504 is then infinite:
crt-royale's picture went black 18 minutes into a game at 60 fps on an
AMD Radeon 780M. Wrap the count at 2^15, the range medium precision is
guaranteed to hold. The wrap is even, so shaders that tell odd frames
from even ones keep doing so.
---
 xbmc/cores/RetroPlayer/shaders/gles/ShaderGLES.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderGLES.cpp
index 33046cc..e1ea3a8 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderGLES.cpp
@@ -21,6 +21,14 @@
 
 using namespace KODI::SHADER;
 
+namespace
+{
+// Shaders take the frame count at medium precision on GLES, which need not
+// reach past 2^15 and on some drivers is a 16-bit float. A count past 65504
+// is then infinite, and the picture goes black after 18 minutes at 60 fps.
+constexpr uint64_t MEDIUMP_FRAME_COUNT_LIMIT = 1 << 15;
+} // namespace
+
 CShaderGLES::CShaderGLES() = default;
 
 CShaderGLES::~CShaderGLES()
@@ -316,6 +324,7 @@ CShaderGLES::UniformInputs CShaderGLES::GetInputData(uint64_t frameCount) const
 {
   if (m_frameCountMod != 0)
     frameCount %= m_frameCountMod;
+  frameCount %= MEDIUMP_FRAME_COUNT_LIMIT;
 
   const UniformInputs input = {
       {m_inputSize}, // video_size
-- 
