From 74560df236b6ac6079e2632e2a16c41c3a1261a5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:23:39 +0000
Subject: [PATCH] DiscSoftTelecine: a title of a DVD is told by what most of it
 is, not only by its start

As for a file: a title that begins with a logo or an intro in video and is film
after it was not film, and one that begins with film and is video was. The
scan of the titles (on its own thread, before they play) now also reads points
further in a title (Nav::Seek(): dvdnav_get_position() and
dvdnav_sector_search()), the middle first, and 10 % and 75 % where the middle
does not say what the start said; the majority decides (TitleResult::start,
TitleResult::points). The log of the scan says what the start and the points
said.

Tested on the host against libdvdnav 7.0.0 with a disc authored with
dvdauthor: a title of 10 s of video before 2 min of film is film (its start
said not film, its three points film), one of 8 s of film before 2 min of video
is not film; the titles of the discs of the media tests are told as before
(where a title cannot be sought in, its start decides). A majority that never
decides leaves the first title as not film.
---
 .../DVDInputStreams/DiscSoftTelecine.h        | 112 ++++++++++++------
 .../DVDInputStreams/DiscSoftTelecineScan.cpp  |  35 ++++--
 2 files changed, 100 insertions(+), 47 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecine.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecine.h
index bf19d4a..7523468 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecine.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecine.h
@@ -85,9 +85,14 @@ private:
 //! \brief What was found of a title
 struct TitleResult
 {
+  //! what the title is: its points by majority, else its start (MPEG2::MajorityOf())
   MPEG2::CSoftTelecineDetector::Verdict verdict = MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN;
-  size_t pictures = 0; //!< pictures that were read
-  size_t videoBytes = 0;
+  //! what its start says
+  MPEG2::CSoftTelecineDetector::Verdict start = MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN;
+  //! what the points further on say (MPEG2::SAMPLE_POINTS), where they were read
+  std::vector<MPEG2::CSoftTelecineDetector::Verdict> points;
+  size_t pictures = 0; //!< pictures that were read at its start
+  size_t videoBytes = 0; //!< bytes of video read in all
   bool outOfBudget = false; //!< stopped by a limit, with no verdict
 };
 
@@ -112,65 +117,94 @@ inline MPEG2::CSoftTelecineDetector::Verdict VerdictOfVideo(const std::vector<ui
 }
 
 /*!
- * \brief Reads the start of a title with a navigator and tells whether its video is soft telecine
+ * \brief Reads a title with a navigator and tells whether its video is soft telecine: its start,
+ *        and points further on (MPEG2::SAMPLE_POINTS), so that a title whose start is not what the
+ *        rest is (a logo or an intro in video before the film) is told by what most of it is
+ *        (MPEG2::MajorityOf())
  *
  * \tparam Nav needs: `bool Play(int title)`; `Nav::Event Next(const uint8_t*& data, int& size)`
- * that
- *         returns Nav::Event::BLOCK for a sector (2048 bytes), STILL or WAIT for a still frame or a
- *         wait (they are skipped with `Skip()`), STOP or ERROR to end, and anything else for an
- *         event
- *         that does not matter; `void Skip()`.
+ *         that returns Nav::Event::BLOCK for a sector (2048 bytes), STILL or WAIT for a still
+ *         frame or a wait (they are skipped with `Skip()`), STOP or ERROR to end, and anything
+ *         else for an event that does not matter; `void Skip()`; `bool Seek(double part)` to a
+ *         part of the title (0 its start, 1 its end), false where it cannot.
  * \param stop called often: true to give up (the disc is closed)
  */
 template<class Nav, class Stop>
 TitleResult ScanTitle(Nav& nav, int title, Stop&& stop)
 {
-  static constexpr size_t MAX_VIDEO_BYTES = 3 * 1024 * 1024; //!< of video read
+  static constexpr size_t MAX_VIDEO_BYTES = 3 * 1024 * 1024; //!< of video read at the start
+  static constexpr size_t MAX_POINT_BYTES = 2 * 1024 * 1024; //!< ... at each point further on
   static constexpr size_t CHECK_EVERY = 256 * 1024;
   static constexpr unsigned MAX_EVENTS = 4000; //!< that are not sectors (a menu that never ends)
-  static constexpr auto MAX_TIME = std::chrono::seconds(4);
+  static constexpr auto MAX_TIME = std::chrono::seconds(4); //!< for the start, and for each point
+  using Verdict = MPEG2::CSoftTelecineDetector::Verdict;
 
   TitleResult result;
   if (!nav.Play(title))
     return result;
-  CVideoCollector collector;
-  const auto begin = std::chrono::steady_clock::now();
-  size_t checked = 0;
-  unsigned events = 0;
-  for (;;)
+
+  // reads the video from where the navigator is until `told` gives a verdict, the title ends or a
+  // limit is reached (false)
+  const auto read = [&nav, &stop](CVideoCollector& collector, size_t maxBytes, const auto& told)
   {
-    if (stop() || std::chrono::steady_clock::now() - begin > MAX_TIME ||
-        collector.Video().size() >= MAX_VIDEO_BYTES || events > MAX_EVENTS)
-    {
-      result.outOfBudget = true;
-      break;
-    }
-    const uint8_t* data = nullptr;
-    int size = 0;
-    const auto ev = nav.Next(data, size);
-    if (ev == Nav::Event::BLOCK)
+    const auto begin = std::chrono::steady_clock::now();
+    size_t checked = 0;
+    unsigned events = 0;
+    for (;;)
     {
-      collector.AddSector(data, static_cast<size_t>(size));
-      if (collector.Video().size() >= checked + CHECK_EVERY)
+      if (stop() || std::chrono::steady_clock::now() - begin > MAX_TIME ||
+          collector.Video().size() >= maxBytes || events > MAX_EVENTS)
+        return false;
+      const uint8_t* data = nullptr;
+      int size = 0;
+      const auto ev = nav.Next(data, size);
+      if (ev == Nav::Event::BLOCK)
+      {
+        collector.AddSector(data, static_cast<size_t>(size));
+        if (collector.Video().size() >= checked + CHECK_EVERY)
+        {
+          checked = collector.Video().size();
+          if (told(collector.Video()) != Verdict::UNKNOWN)
+            return true;
+        }
+      }
+      else if (ev == Nav::Event::STOP || ev == Nav::Event::ERROR)
+        return true;
+      else
       {
-        checked = collector.Video().size();
-        if (VerdictOfVideo(collector.Video()) != MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN)
-          break;
+        ++events;
+        if (ev == Nav::Event::STILL || ev == Nav::Event::WAIT)
+          nav.Skip();
       }
     }
-    else if (ev == Nav::Event::STOP || ev == Nav::Event::ERROR)
+  };
+
+  CVideoCollector start;
+  result.outOfBudget = !read(start, MAX_VIDEO_BYTES,
+                             [](const std::vector<uint8_t>& v) { return VerdictOfVideo(v); });
+  result.videoBytes = start.Video().size();
+  result.start = VerdictOfVideo(start.Video(), &result.pictures);
+  if (result.start != Verdict::UNKNOWN)
+    result.outOfBudget = false;
+
+  for (const double point : MPEG2::SAMPLE_POINTS)
+  {
+    if (stop() || MPEG2::FirstPointAgrees(result.start, result.points))
       break;
-    else
+    Verdict verdict = Verdict::UNKNOWN;
+    if (nav.Seek(point))
     {
-      ++events;
-      if (ev == Nav::Event::STILL || ev == Nav::Event::WAIT)
-        nav.Skip();
+      // (from the first sequence header or group of pictures on: MPEG2::SampleVerdict())
+      CVideoCollector at;
+      int film = 0;
+      read(at, MAX_POINT_BYTES,
+           [&film](const std::vector<uint8_t>& v) { return MPEG2::SampleVerdict(v, 0, film); });
+      result.videoBytes += at.Video().size();
+      verdict = MPEG2::SampleVerdict(at.Video(), 0, film);
     }
+    result.points.push_back(verdict);
   }
-  result.videoBytes = collector.Video().size();
-  result.verdict = VerdictOfVideo(collector.Video(), &result.pictures);
-  if (result.verdict != MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN)
-    result.outOfBudget = false;
+  result.verdict = MPEG2::MajorityOf(result.start, result.points);
   return result;
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecineScan.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecineScan.cpp
index 2dcc3c9..73cb2e8 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecineScan.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DiscSoftTelecineScan.cpp
@@ -124,6 +124,17 @@ struct Nav
     dll.dvdnav_still_skip(nav);
     dll.dvdnav_wait_skip(nav);
   }
+
+  //! To a part of the title that plays (0 its start, 1 its end), by its blocks
+  bool Seek(double part)
+  {
+    uint32_t pos = 0;
+    uint32_t len = 0;
+    if (dll.dvdnav_get_position(nav, &pos, &len) != DVDNAV_STATUS_OK || len == 0)
+      return false;
+    return dll.dvdnav_sector_search(nav, static_cast<int64_t>(static_cast<double>(len) * part),
+                                    SEEK_SET) == DVDNAV_STATUS_OK;
+  }
 };
 } // namespace
 
@@ -248,14 +259,22 @@ void CDiscSoftTelecineScan::Run(const CFileItem& item,
     films += state == CScanResults::State::FILM;
     if (results.Stopped())
       break; // (the player is gone: what was read of this title is not told, nor logged)
-    CLog::Log(
-        LOGDEBUG,
-        "CDiscSoftTelecineScan: title {} ({:.0f} s): {} after {} pictures, {} bytes of video{}",
-        title.second, static_cast<double>(title.first) / 90000.0,
-        state == CScanResults::State::FILM       ? "soft telecine"
-        : state == CScanResults::State::NOT_FILM ? "not soft telecine"
-                                                 : "not told",
-        r.pictures, r.videoBytes, r.outOfBudget ? " (a limit was reached)" : "");
+    std::string points;
+    for (const auto point : r.points)
+      points += point == CSoftTelecineDetector::Verdict::FILM       ? " film"
+                : point == CSoftTelecineDetector::Verdict::NOT_FILM ? " not-film"
+                                                                    : " not-told";
+    CLog::Log(LOGDEBUG,
+              "CDiscSoftTelecineScan: title {} ({:.0f} s): {} (its start: {} after {} pictures; "
+              "points further on:{}), {} bytes of video{}",
+              title.second, static_cast<double>(title.first) / 90000.0,
+              state == CScanResults::State::FILM       ? "soft telecine"
+              : state == CScanResults::State::NOT_FILM ? "not soft telecine"
+                                                       : "not told",
+              r.start == CSoftTelecineDetector::Verdict::FILM       ? "film"
+              : r.start == CSoftTelecineDetector::Verdict::NOT_FILM ? "not film"
+                                                                    : "not told",
+              r.pictures, points, r.videoBytes, r.outOfBudget ? " (a limit was reached)" : "");
     results.Set(title.second, state);
   }
   if (!results.Stopped())
