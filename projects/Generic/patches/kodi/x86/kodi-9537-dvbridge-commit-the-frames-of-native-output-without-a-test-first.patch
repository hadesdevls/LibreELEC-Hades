From 89d6399350b6edcc77ae2eedcdd468137b42e69e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:22:39 +0000
Subject: [PATCH] [DVBridge] Commit the frames of native output without a test
 first

Every atomic commit was tested first (DRM_MODE_ATOMIC_TEST_ONLY) and then made. A commit of the
ordinary output needs that: when its test is refused, the request before it goes out instead with
the new framebuffer. A commit of native Dolby Vision ("strict") never falls back: a refused test
and a refused commit are both a frame that is not shown (reject(), KeepDVRefused(), the same error
in LogDVFailure()); an atomic commit that fails changes nothing; and the kernel backends write
DVBRIDGE_REFUSED from their atomic check "for a TEST_ONLY request as well"
(include/drm/drm_dvbridge_refused.h), so the reasons of a refused commit are those of a refused
test. For a frame that changes nothing but the picture, the test was a second check of every frame
by the driver (in nvidia-drm a validation by NVKMS) for the same result. The fork tests them too.

CDVFrameTest decides: a commit of native output without a modeset (a frame of the transport, a
picture kept by a commit) is committed without its test, but for the first 240 after each modeset
of native output (its first frame, a change of mode). Those are still tested, and their tests are
timed, so that what the frames after them no longer spend is measured in the same video, on the
GPU that plays it. Modesets and the ordinary output are tested as before. The line of every 10 s
says it:

  ...; commits of frames: N tested first (the test x ms on average, the longest y ms), M without a
  test, K that did not wait for their flip (z ms on average, the longest w ms)

A refused frame commit is logged as "atomic-commit" (or "atomic-commit-not-waiting") instead of
"atomic-test"; nothing else of its handling changes.

Host test: dvframetest_test, 8 checks; against the rule before (every commit tested), 3 fail. The
cost of the test on each driver can only be read in a log of real hardware.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 22 ++++++-
 xbmc/windowing/gbm/drm/DRMAtomic.cpp          | 37 ++++++++++-
 xbmc/windowing/gbm/drm/DRMAtomic.h            | 18 +++++
 xbmc/windowing/gbm/drm/DVFrameTest.h          | 66 +++++++++++++++++++
 4 files changed, 140 insertions(+), 3 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/DVFrameTest.h

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6cee9b2..993858b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4453,6 +4453,23 @@ void CWinSystemGbmGLESContext::DVVerifyEnd()
 void CWinSystemGbmGLESContext::LogDVStats(const char* period)
 {
   const unsigned int attempts = m_dvStats.shown + m_dvStats.notShown;
+  // Hades: the ioctls of the commits of the frames (CDVFrameTest): the tests that the first ones
+  // after a modeset still have, which the ones after them no longer spend, and the commits that did
+  // not wait for their flip
+  std::string ioctls;
+  if (const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+  {
+    const auto io = atomic->TakeDVFrameIoctls();
+    if (io.tested + io.untested > 0)
+      ioctls = StringUtils::Format(
+          "; commits of frames: {} tested first (the test {:.2f} ms on average, the longest {:.2f} "
+          "ms), {} without a test",
+          io.tested, io.tested ? io.testSumMs / io.tested : 0.0, io.testMaxMs, io.untested);
+    if (io.quick > 0)
+      ioctls += StringUtils::Format(", {} that did not wait for their flip ({:.2f} ms on average, "
+                                    "the longest {:.2f} ms)",
+                                    io.quick, io.quickSumMs / io.quick, io.quickMaxMs);
+  }
   CLog::Log(LOGINFO,
             "DVBridge: {}: {} frames shown ({} of them keeping the picture on the screen, which "
             "was not drawn again), {} not shown, {} composed with GUI elements; "
@@ -4466,7 +4483,7 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
             "with the picture standing still); {} renderer flushes, {} buffer discards "
             "(seeks, stream changes, decoder resets); FEL residual reconstructed on {} "
             "presentations, {} FEL presentations without it (enhancement layer resynchronizing); "
-            "{} pictures that were on the screen drawn again{}",
+            "{} pictures that were on the screen drawn again{}{}",
             period, m_dvStats.shown, m_dvStats.kept, m_dvStats.notShown, m_dvStats.withGui,
             m_dvStats.prepared ? m_dvStats.prepareSumMs / m_dvStats.prepared : 0.0,
             m_dvStats.prepareMaxMs, attempts ? m_dvStats.presentSumMs / attempts : 0.0,
@@ -4485,7 +4502,8 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
             m_dvKeep.ByCommit() || m_dvStats.keptByCommit
                 ? StringUtils::Format("; {} of the pictures kept were committed again",
                                       m_dvStats.keptByCommit)
-                : std::string());
+                : std::string(),
+            ioctls);
   m_dvLastWindow.valid = true;
   m_dvLastWindow.shown = m_dvStats.shown;
   m_dvLastWindow.notShown = m_dvStats.notShown;
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 3f3db58..3fa7d84 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -285,7 +285,27 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     return reject();
   }
 
-  auto ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
+  // Hades: a commit of native output that changes nothing but the picture is made without its test
+  // (CDVFrameTest), but for the first ones after a modeset of it, whose tests are timed
+  const bool modeset = (flags & DRM_MODE_ATOMIC_ALLOW_MODESET) != 0;
+  const bool frame = strict && !modeset;
+  int ret = 0;
+  if (m_dvFrameTest.Tests(strict, modeset))
+  {
+    const auto testStart = std::chrono::steady_clock::now();
+    ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
+    if (frame)
+    {
+      const double ms =
+          std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - testStart)
+              .count();
+      m_dvFrameIoctls.tested++;
+      m_dvFrameIoctls.testSumMs += ms;
+      m_dvFrameIoctls.testMaxMs = std::max(m_dvFrameIoctls.testMaxMs, ms);
+    }
+  }
+  else
+    m_dvFrameIoctls.untested++;
   // Hades: an HDR10+ InfoFrame that the driver refuses takes nothing else of the request with it:
   // the request is tested again without it (CHDR10PlusOutput::Without())
   if (ret < 0 && !strict && m_connector)
@@ -350,7 +370,21 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
                   { AddProperty(object, name, value); });
   }
 
+  const auto commitStart = std::chrono::steady_clock::now();
   ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags, nullptr);
+  // Hades: (the time of a commit that does not wait for its flip is the time of the ioctl; one that
+  // waits takes the rest of the refresh)
+  if (frame && (flags & DRM_MODE_ATOMIC_NONBLOCK))
+  {
+    const int error = errno;
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - commitStart)
+            .count();
+    m_dvFrameIoctls.quick++;
+    m_dvFrameIoctls.quickSumMs += ms;
+    m_dvFrameIoctls.quickMaxMs = std::max(m_dvFrameIoctls.quickMaxMs, ms);
+    errno = error;
+  }
   if (ret < 0)
   {
     const int error = errno;
@@ -395,6 +429,7 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   // Hades: the request assembled with a modeset carried the selected mode in MODE_ID; the one
   // before it, which a refused test fell back to, left the mode as it was
   m_committedMode.Accepted((flags & DRM_MODE_ATOMIC_ALLOW_MODESET) != 0 && !fellBack, m_mode);
+  m_dvFrameTest.Accepted(strict, modeset);
   FinishRequest(true);
   return true;
 }
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index e38765a..5f0741d 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -10,6 +10,7 @@
 
 #include "DRMCommittedMode.h"
 #include "DRMUtils.h"
+#include "DVFrameTest.h"
 #include "utils/log.h"
 #include "utils/DVBridgeDiagnosticState.h"
 
@@ -71,6 +72,20 @@ public:
   //! Hades: the selected mode is the one on the output: a commit carried it, and no modeset is
   //! pending (CCommittedMode)
   bool IsSelectedModeCommitted() const { return m_committedMode.Is(m_mode, m_need_modeset); }
+  //! Hades: the ioctls of the commits of native output that change nothing but the picture since
+  //! the last call (CDVFrameTest): the tests made before them, the ones committed without a test,
+  //! and the time of the commits that did not wait for their flip
+  struct DVFrameIoctls
+  {
+    unsigned int tested = 0;
+    double testSumMs = 0.0;
+    double testMaxMs = 0.0;
+    unsigned int untested = 0;
+    unsigned int quick = 0;
+    double quickSumMs = 0.0;
+    double quickMaxMs = 0.0;
+  };
+  DVFrameIoctls TakeDVFrameIoctls() { return std::exchange(m_dvFrameIoctls, {}); }
   //! Hades: the value of a property in the request being built, nothing when it does not carry it
   std::optional<uint64_t> RequestValue(CDRMObject* object, const char* name) const
   {
@@ -151,6 +166,9 @@ private:
   bool m_need_modeset{true};
   //! Hades: the mode that the commits put on the CRTC (IsSelectedModeCommitted())
   CCommittedMode<drmModeModeInfo> m_committedMode;
+  //! Hades: which commits are tested first, and what the frames of native output took
+  CDVFrameTest m_dvFrameTest;
+  DVFrameIoctls m_dvFrameIoctls;
   bool m_active = true;
   bool m_propertyFailure = false;
   //! See TakeFlipRefused(). Kept until it is asked: a commit that is accepted afterwards does
diff --git a/xbmc/windowing/gbm/drm/DVFrameTest.h b/xbmc/windowing/gbm/drm/DVFrameTest.h
new file mode 100644
index 0000000..5f26436
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVFrameTest.h
@@ -0,0 +1,66 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: whether a commit is tested (DRM_MODE_ATOMIC_TEST_ONLY) before it is made
+ *
+ * Every commit used to be tested first (CDRMAtomic::DrmAtomicCommit()). A commit of the ordinary
+ * output needs it: when its test is refused, the request before it goes out instead, with the new
+ * framebuffer. A commit of native Dolby Vision ("strict") does not fall back to anything: a refused
+ * test and a refused commit are both a frame that is not shown, with the same error, and the same
+ * reasons of the driver (the kernel backends write DVBRIDGE_REFUSED from their atomic check, which
+ * the commit runs as the test does), and an atomic commit that fails changes nothing. A commit of
+ * native output that changes nothing but the picture (a frame of the transport, or a picture kept
+ * by a commit) is therefore committed without its test, which was a second check of each frame by
+ * the driver for nothing: in nvidia-drm a validation by NVKMS. A modeset is still tested first.
+ *
+ * The first FRAMES_TESTED of them after each modeset of native output (its start, a change of mode)
+ * are tested still, and the time of their tests is told (CDRMAtomic::TakeDVFrameIoctls()): what the
+ * frames after them no longer spend is measured in the same video, on the GPU that plays it.
+ *
+ * This class only decides; a test builds it on the host.
+ */
+class CDVFrameTest
+{
+public:
+  //! frames of native output tested after a modeset of it (ten seconds of film)
+  static constexpr unsigned int FRAMES_TESTED = 240;
+
+  //! A commit is about to be made: of native output or not (strict), allowing a modeset or not
+  bool Tests(bool strict, bool modeset) const
+  {
+    return !strict || modeset || m_framesSinceModeset < FRAMES_TESTED;
+  }
+
+  //! ... and the driver took it
+  void Accepted(bool strict, bool modeset)
+  {
+    if (!strict)
+      return;
+    if (modeset)
+      m_framesSinceModeset = 0;
+    else if (m_framesSinceModeset < FRAMES_TESTED)
+      ++m_framesSinceModeset;
+  }
+
+private:
+  unsigned int m_framesSinceModeset = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
