From dc8ec75d5e6a174f1b72c16f142a3cf8494ef335 Mon Sep 17 00:00:00 2001
From: thexai <58434170+thexai@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:32:01 +0100
Subject: [PATCH] [ActiveAE][Android] discard AudioTrack RAW sink audio on
 pause

On resume, a RAW Android AudioTrack played the audio it held from before
the pause, followed by the sync correction: in AC3 transcode a short
sound, a gap, then normal playback. Discard it on pause as on a stream
flush, so resume starts on an empty sink like a seek and the receiver
locks on to the encoded silence of the correction.

Discarding the queued audio on pause lengthens the gap on resume. Limit
it to AC3 transcode and TrueHD, DTS-HD MA and DTS-HD passthrough, where
the queued audio disturbs the resume.

Only the RAW AudioTrack sink implements Flush(), so other sinks are
unaffected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Hades: merged with the pause of passthrough of Hades, which keeps what
the sink had not played (HoldRawStream()): the discard decided here
applies when that pause is refused, as the flush it replaces did. Only
the RAW AudioTrack sink of Android implements Flush(); the sinks of
Hades (ALSA, PulseAudio, the null sink) do not, so on Hades the pause
does the same as before.]
(cherry picked from commit 5a03ee22b7fcd2a52fa6c9bc0a75859846871a99)
---
 .../cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 13 ++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAESink.cpp   |  2 +-
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 91c631b..50ed459 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -890,7 +890,18 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           {
             // (Hades: a passthrough stream keeps what the sink had not played, PassthroughPause.h)
             if (!HoldRawStream(stream))
-              FlushEngine();
+            {
+              // A RAW AudioTrack would otherwise play its queued audio on resume, ahead of the sync
+              // correction. Discarding it makes resume start on an empty sink, as after a seek. As
+              // that lengthens the gap on resume, only where the queued audio disturbs it.
+              const CAEStreamInfo::DataType type{m_sinkFormat.m_streamInfo.m_type};
+              const bool discard =
+                  m_mode == MODE_TRANSCODE ||
+                  (m_mode == MODE_RAW && (type == CAEStreamInfo::STREAM_TYPE_TRUEHD ||
+                                          type == CAEStreamInfo::STREAM_TYPE_DTSHD_MA ||
+                                          type == CAEStreamInfo::STREAM_TYPE_DTSHD));
+              FlushEngine(discard);
+            }
             streaming = false;
             m_sink.m_controlPort.SendOutMessage(CSinkControlProtocol::STREAMING, &streaming, sizeof(bool));
           }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index e22b708..62f2e3d 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -371,7 +371,7 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
           m_extHeldPause = false; // (Hades)
           m_resumeGap.reset();
           ReturnBuffers();
-          // Pause also clears AE queues: only explicit stream flush discards device audio.
+          // Only discards device audio when asked to, as on a stream flush or pause.
           if (m_sink && *reinterpret_cast<const bool*>(msg->data))
             m_sink->Flush();
           msg->Reply(CSinkControlProtocol::ACC);
