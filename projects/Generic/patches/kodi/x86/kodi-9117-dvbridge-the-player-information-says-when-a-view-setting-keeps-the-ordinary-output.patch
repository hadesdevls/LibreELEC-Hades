--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -12,6 +12,7 @@
 #include "cores/VideoPlayer/DVDCodecs/DVDCodecUtils.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/VAAPI.h"
 #include "settings/AdvancedSettings.h"
+#include "settings/DisplaySettings.h"
 #include "settings/Settings.h"
 #include "utils/EGLFence.h"
 #include "utils/GLUtils.h"
@@ -319,6 +320,18 @@ void CRendererVAAPIGLES::ManageRenderArea()
   CLinuxRendererGLES::ManageRenderArea();
   dvbridge_geometry geometry{};
   m_dvGeometryUsable = DVGeometry(geometry);
+  // Hades: for the player information, when it is a view setting of the user (zoom, stretch,
+  // shift) that keeps a picture that asks for native Dolby Vision output on the ordinary
+  // output. Not when the geometry is not usable with the view as it comes (a stream whose
+  // pixels are not square), and not for a rotation, which may be the stream's own.
+  if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem()))
+  {
+    const CDisplaySettings& view = CDisplaySettings::GetInstance();
+    const bool changed = view.GetZoomAmount() != 1.0f || view.GetVerticalShift() != 0.0f ||
+                         view.GetPixelRatio() != 1.0f || view.IsNonLinearStretched();
+    window->SetDVBridgeViewKeepsOrdinary(m_dvAsked && !m_dvGeometryUsable && changed);
+  }
 }
 
 bool CRendererVAAPIGLES::RenderDVBridge(int idx)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 5643391..bbe717a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -332,8 +332,10 @@ bool CLinuxRendererGLES::ConfigChanged(const VideoPicture &picture)
 #ifdef HAVE_DVBRIDGE
 bool CLinuxRendererGLES::WantsDVBridge(const VideoPicture& picture) const
 {
-  return KODI::WINDOWING::GBM::CWinSystemGbmGLESContext::DVBridgeRequested(&picture) &&
-         CanRenderDVBridge(picture);
+  const bool asked =
+      KODI::WINDOWING::GBM::CWinSystemGbmGLESContext::DVBridgeRequested(&picture);
+  m_dvAsked = asked;
+  return asked && CanRenderDVBridge(picture);
 }
 
 bool CLinuxRendererGLES::DVBridgeConfigChanged(const VideoPicture& picture) const
@@ -1230,6 +1232,11 @@ void CLinuxRendererGLES::UnInit()
   glFinish();
 
 #ifdef HAVE_DVBRIDGE
+  // (first: the end of the native output publishes the player information once more)
+  m_dvAsked = false;
+  if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem()))
+    window->SetDVBridgeViewKeepsOrdinary(false);
   if (m_dvRequested)
   {
     auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
index 8bd81cb..fc980b5 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
@@ -144,6 +144,10 @@ protected:
   //! Native output starts or ends with this picture: the renderer is configured again.
   bool DVBridgeConfigChanged(const VideoPicture& picture) const;
   std::atomic<bool> m_dvRequested{false};
+  //! Hades: the last picture asked for native Dolby Vision output and the output takes it,
+  //! whatever this renderer can draw. With a view setting that keeps the picture on the
+  //! ordinary output, that is the reason the player information gives.
+  mutable std::atomic<bool> m_dvAsked{false};
   /*!
    * \brief Hades: draw a Dolby Vision picture reconstructed, for output as HDR10
    * \return 1: this picture; 0: it could not be reconstructed, and the one before it is shown
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 3c93b79..e64aa62 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1208,9 +1208,14 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
   // Hades: reconstructed and sent as HDR10, when a picture was drawn that way in the last second
   const bool converted = !native && m_dvConvertBridge &&
                          now - m_dvConvertShown < std::chrono::seconds(1);
+  // Hades: nothing of the output stands in the way and the picture asks for native output: it
+  // is a view setting that keeps it on the ordinary one
+  std::string reason = native ? "" : NativeDVOutputReason();
+  if (!native && reason.empty() && m_dvViewKeepsOrdinary)
+    reason = "view";
   std::map<std::string, std::string> info{
       {"hades.dv.state", native ? "native" : converted ? "hdr10" : ""},
-      {"hades.dv.reason", native ? "" : NativeDVOutputReason()},
+      {"hades.dv.reason", reason},
       {"hades.dv.display", DisplayDolbyVisionSupport()},
       {"hades.dv.layers", ""}, {"hades.dv.cm", ""}, {"hades.dv.l1", ""}, {"hades.dv.l2", ""},
       {"hades.dv.l5", ""}, {"hades.dv.l6", ""}, {"hades.dv.mode", ""}, {"hades.dv.shown", ""},
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 751623b..559e756 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -65,6 +65,10 @@ public:
   //! Whether the configured video renderer draws its pictures natively; set before its output
   //! transition. Only then does the output use the 8-bit transport format.
   void SetDVBridgeRendererNative(bool native) { m_dvRendererNative = native; }
+  //! Hades: the picture asks for native Dolby Vision output and the output takes it, but a view
+  //! setting of the user (zoom, stretch, shift) keeps it on the ordinary output: said in the
+  //! player information. Set by the renderer on every pass, cleared first thing when it goes.
+  void SetDVBridgeViewKeepsOrdinary(bool keeps) { m_dvViewKeepsOrdinary = keeps; }
   //! Restorations of the ordinary output that succeeded only on a later retry, over the output
   //! state of a renderer configured meanwhile: such a renderer is configured again.
   unsigned int DVOutputRestores() const { return m_dvOutputRestores; }
@@ -171,6 +175,7 @@ private:
   std::chrono::steady_clock::time_point m_dvConvertShown{};
   CDVBridgeState m_dvState;
   std::atomic<bool> m_dvRendererNative{false};
+  std::atomic<bool> m_dvViewKeepsOrdinary{false};
   std::chrono::steady_clock::time_point m_dvRestoreRetry; //!< last retry of a failed restore
   unsigned int m_dvRestoreFailures = 0; //!< failed restorations in a row (log rate)
   std::atomic<unsigned int> m_dvOutputRestores{0};
