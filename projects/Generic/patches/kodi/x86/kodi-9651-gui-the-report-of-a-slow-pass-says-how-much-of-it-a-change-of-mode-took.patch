From 1f4cbbc7994e31d202abd673c5294f573a4c8786 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:24:34 +0000
Subject: [PATCH] GUI: the report of a slow pass says how much of it a change
 of mode took

The passes of the GUI that a hardware test shows at the start and the end of
a video ("a pass of the nested loop took 686 ms (process 0, frame move 1,
render 686)" when native Dolby Vision starts on the AMD integrated graphics,
"took 933 ms ... frame move 933" when it ends) read as a slow interface.
Read against the log of that test, they hold the commit that changes the
display mode: the first frame
of the video goes out with the change to the video's refresh rate, and the
GUI comes back with the change to its own, and the kernel's commit waits for
the output, and the TV with it, to be set up again (from OnLostDisplay to
OnResetDisplay, 0.4 to 0.8 s on amdgpu). The commits that change the mode
now tell how long they took (CModeChangeTime), and the report of a slow pass
says it, as in "(process 0, frame move 1, render 686; a change of the
display mode took N ms of it, in the kernel and the display)". The passes of
683 and 516 ms at the start of playback on an RX 7600 (issue #3) are most
likely the same; without that log it is not verified, and the next one will
say. Nothing else changes.
---
 xbmc/application/Application.cpp     | 12 ++++++--
 xbmc/utils/ModeChangeTime.h          | 45 ++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp |  4 +++
 3 files changed, 59 insertions(+), 2 deletions(-)
 create mode 100644 xbmc/utils/ModeChangeTime.h

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 7d633ae..99874bd 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -153,6 +153,7 @@
 #include "utils/TimeUtils.h"
 #include "utils/URIUtils.h"
 #include "utils/Variant.h"
+#include "utils/ModeChangeTime.h"
 #include "utils/log.h"
 #include "video/PlayerController.h"
 #include "video/VideoLibraryQueue.h"
@@ -1850,6 +1851,8 @@ void CApplication::EndPass(std::chrono::steady_clock::time_point start,
   m_passMark = now;
   if (m_stallWatch)
     m_stallWatch->Mark();
+  // Hades: the commits that changed the display mode during this pass (CModeChangeTime)
+  const long long modeChangeMs = CModeChangeTime::TakeMs();
   if (m_passDepth > 0)
     m_passDepth--;
 
@@ -1871,10 +1874,15 @@ void CApplication::EndPass(std::chrono::steady_clock::time_point start,
     return;
 
   CLog::Log(LOGINFO,
-            "GUI: a pass of the {} loop took {} ms (process {}, frame move {}, render {}); window "
+            "GUI: a pass of the {} loop took {} ms (process {}, frame move {}, render {}{}); window "
             "{}; {} more since the last report",
             nested ? "nested" : "main", PassMs(now - start), PassMs(processed - start),
-            PassMs(moved - processed), PassMs(now - moved), PassWindows(), m_passesUnreported);
+            PassMs(moved - processed), PassMs(now - moved),
+            modeChangeMs > 0 ? StringUtils::Format("; a change of the display mode took {} ms of it, "
+                                                   "in the kernel and the display",
+                                                   modeChangeMs)
+                             : std::string(),
+            PassWindows(), m_passesUnreported);
   m_passesUnreported = 0;
 }
 
diff --git a/xbmc/utils/ModeChangeTime.h b/xbmc/utils/ModeChangeTime.h
new file mode 100644
index 0000000..b7dcfc9
--- /dev/null
+++ b/xbmc/utils/ModeChangeTime.h
@@ -0,0 +1,45 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+/*!
+ * \brief Hades: how long the commits that changed the display mode took, for the report of a slow
+ *        pass of the GUI
+ *
+ * A pass that changes the mode (the start or the end of a video at another refresh rate) waits in
+ * the kernel's commit for the output to be set up again, and the TV with it: on amdgpu 0.4 to 0.8 s.
+ * The report of the pass said only "render 686 ms", which read as a slow interface. The commit tells
+ * how long it took (Add()), and the report of the pass takes what was told since the pass before it
+ * (Take()). Any thread.
+ */
+class CModeChangeTime
+{
+public:
+  static void Add(std::chrono::steady_clock::time_point start)
+  {
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now() - start)
+                        .count();
+    if (ns > 0)
+      Ns().fetch_add(ns, std::memory_order_relaxed);
+  }
+  //! The ms told since the last call
+  static long long TakeMs() { return Ns().exchange(0, std::memory_order_relaxed) / 1000000; }
+
+private:
+  static std::atomic<int64_t>& Ns()
+  {
+    static std::atomic<int64_t> ns{0};
+    return ns;
+  }
+};
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 3fa7d84..10ff8ae 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -18,6 +18,7 @@
 #include "guilib/GUIWindowManager.h"
 #include "settings/Settings.h"
 #include "utils/DRMHelpers.h"
+#include "utils/ModeChangeTime.h"
 #include "utils/log.h"
 
 #include <chrono>
@@ -372,6 +373,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 
   const auto commitStart = std::chrono::steady_clock::now();
   ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags, nullptr);
+  // Hades: how long a commit that changes the mode took, for the report of a slow pass of the GUI
+  if (modeset)
+    CModeChangeTime::Add(commitStart);
   // Hades: (the time of a commit that does not wait for its flip is the time of the ioctl; one that
   // waits takes the rest of the refresh)
   if (frame && (flags & DRM_MODE_ATOMIC_NONBLOCK))
