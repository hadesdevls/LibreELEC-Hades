diff --git a/xbmc/windowing/gbm/DVLatency.h b/xbmc/windowing/gbm/DVLatency.h
new file mode 100644
index 0000000..4ebc458
--- /dev/null
+++ b/xbmc/windowing/gbm/DVLatency.h
@@ -0,0 +1,49 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: how much later than for the ordinary output the render manager chooses a frame of
+ *        native Dolby Vision output (GetFrameLatencyAdjustment(), in ms)
+ *
+ * The render manager chooses a frame for the display latency that Kodi takes, the same for every
+ * way of presenting it: the buffers plus one, three refresh periods. The ordinary output draws the
+ * frame chosen in a pass, waits for the flip of the frame before it and commits without waiting:
+ * the frame flips two periods after it was chosen. Native Dolby Vision presented the way that waits
+ * commits and returns with the flip: one period after it was chosen, one period earlier against
+ * the sound than the ordinary output of Kodi. A frame presented a frame ahead commits without
+ * waiting and flips two periods after it was chosen, as the ordinary output. Measured in the
+ * hardware test of 1.0 RC4 (the flips against the player's clock): the two ways of native output
+ * within 4 ms of each other (CDVAhead had them chosen a period apart), and on the AMD integrated
+ * graphics 50 to 77 ms before the ordinary output of the same title at 23.976 Hz, one period of
+ * 41.7 ms by the code plus where in its period each playback starts.
+ *
+ * So a frame of native output presented the way that waits is chosen one period later than Kodi's
+ * latency says, and one presented a frame ahead as the ordinary output: what is seen against what
+ * is heard is the same with and without native output, and with and without frames ahead. Nothing
+ * changes which frames are shown at which refresh rate (the cadence): only which refresh a frame
+ * starts at, by one, as the way of presenting changes.
+ */
+inline double DVFrameLatencyAdjustmentMs(bool nativeOutput, bool ahead, double periodMs)
+{
+  if (!nativeOutput || !(periodMs > 0.0))
+    return 0.0;
+  return ahead ? 0.0 : periodMs;
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/PresentLag.h b/xbmc/windowing/gbm/PresentLag.h
index ea4e69e..a77cc8e 100644
--- a/xbmc/windowing/gbm/PresentLag.h
+++ b/xbmc/windowing/gbm/PresentLag.h
@@ -107,6 +107,32 @@ public:
            text + tail;
   }
 
+  //! Hades: the counts of a CPresentLag that was given, instead of when the clock calls for each
+  //! frame, when its sound is played (the player's clock with its adjustment to the refreshes, as
+  //! the audio engine takes it: CRenderManager::PrepareNextRender()): the A/V offset of the
+  //! picture at the output, after its sound when positive
+  std::string AvText() const
+  {
+    std::string text;
+    static constexpr const char* NAMES[] = {"the way that waits", "a frame ahead",
+                                            "the ordinary output"};
+    for (size_t i = 0; i < m_ways.size(); ++i)
+    {
+      const auto& w = m_ways[i];
+      if (!w.count)
+        continue;
+      char part[160];
+      std::snprintf(part, sizeof(part), "%s%+.1f ms (%+.1f to %+.1f) over %u frames, %s",
+                    text.empty() ? "" : "; ", w.sumMs / w.count, w.minMs, w.maxMs, w.count,
+                    NAMES[i]);
+      text += part;
+    }
+    if (text.empty())
+      return text;
+    return "the picture went out against its sound by " + text +
+           " (positive: after it; at the output of this computer, before the display)";
+  }
+
   void Reset() { m_ways = {}; }
 
