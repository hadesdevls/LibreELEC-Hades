From b5a0c3ac0a9569eb0a8e2241472b28c1232ba928 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 03:55:56 +0000
Subject: [PATCH] windowing/gbm: an offer of which nothing came waits for its
 own display

When nothing came of an offer, the outputs were taken as they were before
the look, so that the display would be new again at the next one. With
two displays that were plugged in together that brought back the one
that had been settled already: the TV for which the watch had stopped
asking was asked for again because the monitor still waited.

Now the display of the offer counts as not seen yet (AsNotSeen()), and
with it the lesser ones that were new in the same look and have not had
their turn. What was settled stays seen.

Found while reading the commit before this one again; in the host test
(five checks).
---
 xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp | 15 +++++++++++---
 xbmc/windowing/gbm/drm/DRMOutputChoice.h   | 24 ++++++++++++++++++++++
 2 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
index 6634718..6f2a864 100644
--- a/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
+++ b/xbmc/windowing/gbm/drm/DRMDisplayWatch.cpp
@@ -881,9 +881,18 @@ void CDRMDisplayWatch::Watch()
 
       if (offer == OFFER_LATER)
       {
-        // Nothing came of it. With the outputs taken as they were before, the display is new
-        // again at the next look, when it is still there then: only then is it offered again.
-        m_seen = std::move(before);
+        // Nothing came of it. Its display counts as not seen yet: it is new again at the next
+        // look, when it is still there then, and only then is it offered again. So do the
+        // lesser displays that were new with it and have not had their turn. One that was
+        // settled in this look stays seen.
+        const DRMLook looked = m_seen;
+        std::vector<std::string> counted = settled;
+        for (DRMOutput next = better; !next.name.empty();
+             next = BetterNewOutput(before, looked, m_inUse, asked, counted))
+        {
+          m_seen = AsNotSeen(std::move(m_seen), next);
+          counted.emplace_back(QualifiedOutputName(next));
+        }
         pending = true;
         notBefore = std::chrono::steady_clock::now() + askAgain;
         askAgain = std::min<std::chrono::seconds>(askAgain * 2, ASK_AGAIN_MAX_TIME);
diff --git a/xbmc/windowing/gbm/drm/DRMOutputChoice.h b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
index edfe94a..eb82f87 100644
--- a/xbmc/windowing/gbm/drm/DRMOutputChoice.h
+++ b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
@@ -387,6 +387,30 @@ inline void ForgetGone(std::vector<std::string>& declined, const DRMLook& now)
   });
 }
 
+/*!
+ * \brief A look in which the display of one output counts as not seen yet
+ * \param output that output, as the look names it (QualifiedOutputName())
+ *
+ * For a display that was offered and of which nothing came: at the next look it is new again
+ * when it is still there, and only then is it offered again. The other displays of the look
+ * stay seen: one that was settled is not offered again because another one waits.
+ */
+inline DRMLook AsNotSeen(DRMLook look, const DRMOutput& output)
+{
+  for (auto& outputs : look.outputs)
+  {
+    for (DRMOutput& one : outputs)
+    {
+      if (QualifiedOutputName(one) == QualifiedOutputName(output))
+      {
+        one.connected = false;
+        one.usable = false;
+      }
+    }
+  }
+  return look;
+}
+
 /*!
  * \brief What came back from the question whether to move to a display
  */
