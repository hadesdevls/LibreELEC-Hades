From 30ed9a8f205bd1b3988394df81ba9a3986674b60 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 05:04:07 +0000
Subject: [PATCH] [cosmetics] Audio: clang-format the lines that the audio
 commits change

The lines that the commits of the dialogue normalisation, the compression
of Dolby Digital, the live audio settings and the downmix change, formatted
with clang-format and Kodi's .clang-format, those lines only. Nothing but
line breaks and indentation changes, save one block of includes in
VideoPlayerAudio.cpp that clang-format sorts (utils/MathUtils.h before
utils/StringUtils.h).
---
 .../Engines/ActiveAE/ActiveAEBuffer.cpp       |  3 +-
 .../AudioEngine/Utils/DialnormOverride.h      | 31 ++++++++++---------
 xbmc/cores/AudioEngine/Utils/DownmixLevels.h  | 19 +++++++-----
 .../DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp   |  4 +--
 .../Audio/DVDAudioCodecPassthrough.cpp        | 23 ++++++++------
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp   | 22 ++++++-------
 6 files changed, 54 insertions(+), 48 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
index 3052ce8..ad95330 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
@@ -365,8 +365,7 @@ void CActiveAEBufferPoolResample::ConfigureResampler(bool normalizelevels,
   // m_resampler->Init(); see AudioSettingsLive.h)
   if (LIVEAUDIO::SETTINGS::RemakeResampler(m_resampler != nullptr, m_normalize != normalize,
                                            m_resampleQuality != quality,
-                                           m_stereoUpmix != stereoupmix,
-                                           m_mixSubLevel != sublevel))
+                                           m_stereoUpmix != stereoupmix, m_mixSubLevel != sublevel))
   {
     m_changeResampler = true;
   }
diff --git a/xbmc/cores/AudioEngine/Utils/DialnormOverride.h b/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
index 62b1d01..0a56f5e 100644
--- a/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
+++ b/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
@@ -70,7 +70,7 @@ enum class Skip
   BAD_CRC, //!< a syncframe that fails its own CRC
   ATMOS, //!< E-AC-3 with Dolby Atmos (joint object coding, or object audio metadata)
   DTS_FORM, //!< DTS that is not a core frame of 16-bit big-endian words (14-bit, little-endian,
-            //!< or DTS-HD without a core)
+  //!< or DTS-HD without a core)
   DTS_HEADER_CRC, //!< DTS core with a header CRC (CPF = 1)
   DTS_VERSION_6, //!< DTS core with VERNUM 6: its field cannot say 0 dB
   DTS_NO_DIALNORM, //!< DTS core with a VERNUM other than 6 and 7: the field says nothing
@@ -337,8 +337,8 @@ inline SAC3Fields ReadAC3Fields(const uint8_t* data, size_t size)
     if (bits.Flag())
       bits.Skip(8);
   }
-  f.parsed = ReadEAC3ExtensionTypeA(bits, strmtyp, acmod, lfeon, numblks, reducedRate,
-                                    &f.extensionTypeA);
+  f.parsed =
+      ReadEAC3ExtensionTypeA(bits, strmtyp, acmod, lfeon, numblks, reducedRate, &f.extensionTypeA);
   return f;
 }
 
@@ -437,8 +437,9 @@ private:
       if (f.bytes == 0)
       {
         // the syncword is there: a frame of a size that fits that fails its CRC, or no frame
-        result.skip = (size - at >= 8 && data[at] == 0x0B && data[at + 1] == 0x77) ? Skip::BAD_CRC
-                                                                                   : Skip::NOT_A_FRAME;
+        result.skip = (size - at >= 8 && data[at] == 0x0B && data[at + 1] == 0x77)
+                          ? Skip::BAD_CRC
+                          : Skip::NOT_A_FRAME;
         return result;
       }
       if (!f.parsed)
@@ -448,7 +449,8 @@ private:
       }
       if (f.eac3)
         result.codec = Codec::EAC3;
-      if (f.extensionTypeA || (f.eac3 && KODI::AE::PRESENTATION::DETAIL::FindOAMD(data + at, f.bytes)))
+      if (f.extensionTypeA ||
+          (f.eac3 && KODI::AE::PRESENTATION::DETAIL::FindOAMD(data + at, f.bytes)))
       {
         result.skip = Skip::ATMOS;
         return result;
@@ -524,9 +526,8 @@ private:
         if (frame[i] == old[i])
           continue;
         const bool crc = f.eac3 ? i >= f.bytes - 3 : (i == 2 || i == 3);
-        const bool field =
-            (i == f.dialnorm / 8 || i == (f.dialnorm + 4) / 8) ||
-            (f.dialnorm2 && (i == f.dialnorm2 / 8 || i == (f.dialnorm2 + 4) / 8));
+        const bool field = (i == f.dialnorm / 8 || i == (f.dialnorm + 4) / 8) ||
+                           (f.dialnorm2 && (i == f.dialnorm2 / 8 || i == (f.dialnorm2 + 4) / 8));
         if (!crc && !field)
           return false;
         if (f.eac3 && i == f.bytes - 3 && ((frame[i] ^ old[i]) & 0xFE) && !field)
@@ -689,7 +690,8 @@ public:
       return {};
     if (r.skip != Skip::NONE)
     {
-      const std::string key = std::string(CodecName(r.codec)) + std::to_string(static_cast<int>(r.skip));
+      const std::string key =
+          std::string(CodecName(r.codec)) + std::to_string(static_cast<int>(r.skip));
       for (const auto& said : m_said)
         if (said == key)
           return {};
@@ -708,10 +710,11 @@ public:
     if (r.codec == Codec::DTS)
       return std::string(CodecName(r.codec)) + " passed through: dialogue normalisation gain -" +
              std::to_string(r.attenuation) + " dB, sent as 0 dB";
-    const std::string level =
-        r.reservedCode ? std::string("in the reserved code 0 (reproduced as -31 dBFS)")
-                       : std::to_string(r.dialogueLevel) + " dBFS (the receiver lowers the sound by " +
-                             std::to_string(r.attenuation) + " dB)";
+    const std::string level = r.reservedCode
+                                  ? std::string("in the reserved code 0 (reproduced as -31 dBFS)")
+                                  : std::to_string(r.dialogueLevel) +
+                                        " dBFS (the receiver lowers the sound by " +
+                                        std::to_string(r.attenuation) + " dB)";
     return std::string(CodecName(r.codec)) + " passed through: dialogue level " + level +
            ", sent as -31 dBFS (no attenuation)";
   }
diff --git a/xbmc/cores/AudioEngine/Utils/DownmixLevels.h b/xbmc/cores/AudioEngine/Utils/DownmixLevels.h
index 414915d..0f91191 100644
--- a/xbmc/cores/AudioEngine/Utils/DownmixLevels.h
+++ b/xbmc/cores/AudioEngine/Utils/DownmixLevels.h
@@ -54,21 +54,24 @@ inline std::string Describe(std::optional<double> trackLevel,
                             double settingDb,
                             double level)
 {
-  const auto db = [](double gain) { return gain > 0 ? 20 * log10(gain) : -std::numeric_limits<double>::infinity(); };
+  const auto db = [](double gain)
+  { return gain > 0 ? 20 * log10(gain) : -std::numeric_limits<double>::infinity(); };
   char from[160];
   if (!trackLevel)
     std::snprintf(from, sizeof(from), "-3.0 dB (the track asks for none)");
   else if (useTrackLevel)
     std::snprintf(from, sizeof(from), "%.1f dB, the track's", db(*trackLevel));
   else
-    std::snprintf(from, sizeof(from),
-                  "-3.0 dB (the track's %.1f dB set aside: setting \"audiooutput.hadesdownmixlevels\")",
-                  db(*trackLevel));
+    std::snprintf(
+        from, sizeof(from),
+        "-3.0 dB (the track's %.1f dB set aside: setting \"audiooutput.hadesdownmixlevels\")",
+        db(*trackLevel));
   char line[400];
-  std::snprintf(line, sizeof(line),
-                "in a downmix, the centre is mixed at %.1f dB: %s, %+d dB of the video, %+.1f dB of "
-                "the setting \"audiooutput.hadescentrelevel\"",
-                db(level), from, videoDb, settingDb);
+  std::snprintf(
+      line, sizeof(line),
+      "in a downmix, the centre is mixed at %.1f dB: %s, %+d dB of the video, %+.1f dB of "
+      "the setting \"audiooutput.hadescentrelevel\"",
+      db(level), from, videoDb, settingDb);
   return line;
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
index d16e3cb..f0ed5b9 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecFFmpeg.cpp
@@ -174,8 +174,8 @@ bool CDVDAudioCodecFFmpeg::UpdateDecoderSettings()
   // frame is lost, as one would be with a decoder opened again. FFmpeg 9.0.2 lets an option be set
   // on a decoder that is open (libavcodec keeps no AV_CLASS_STATE_INITIALIZED); if a later one does
   // not, the set fails, and the decoder is opened again as before.
-  if (!m_pCodecContext ||
-      (m_pCodecContext->codec_id != AV_CODEC_ID_AC3 && m_pCodecContext->codec_id != AV_CODEC_ID_EAC3))
+  if (!m_pCodecContext || (m_pCodecContext->codec_id != AV_CODEC_ID_AC3 &&
+                           m_pCodecContext->codec_id != AV_CODEC_ID_EAC3))
     return false;
   // <applydrc> in advancedsettings.xml takes priority: the setting changes nothing
   if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_audioApplyDrc >= 0.0f)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
index a48d230..10c7705 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Audio/DVDAudioCodecPassthrough.cpp
@@ -87,7 +87,8 @@ bool CDVDAudioCodecPassthrough::Open(CDVDStreamInfo &hints, CDVDCodecOptions &op
   // Hades: a new stream for the dialogue normalisation (DialnormOverride.h); its demuxer's profile
   // says whether it is E-AC-3 with Dolby Atmos
   m_dialnorm.Reset();
-  m_dialnorm.SetAtmos(hints.codec == AV_CODEC_ID_EAC3 && hints.profile == AV_PROFILE_EAC3_DDP_ATMOS);
+  m_dialnorm.SetAtmos(hints.codec == AV_CODEC_ID_EAC3 &&
+                      hints.profile == AV_PROFILE_EAC3_DDP_ATMOS);
   m_dialnormOn.reset();
 
   m_dataSize = 0;
@@ -238,11 +239,12 @@ void CDVDAudioCodecPassthrough::Dialnorm()
   {
     // (said when it is on, and when it changes; not for a stream that starts with it off)
     if (on || m_dialnormOn.has_value())
-      CLog::Log(LOGINFO,
-                "CDVDAudioCodecPassthrough: the dialogue normalisation of the stream passed through "
-                "({}) is {} (setting \"{}\")",
-                m_codecName, on ? "sent as 0 dB where its form allows it" : "left as the stream says",
-                CSettings::SETTING_AUDIOOUTPUT_HADESDIALNORM);
+      CLog::Log(
+          LOGINFO,
+          "CDVDAudioCodecPassthrough: the dialogue normalisation of the stream passed through "
+          "({}) is {} (setting \"{}\")",
+          m_codecName, on ? "sent as 0 dB where its form allows it" : "left as the stream says",
+          CSettings::SETTING_AUDIOOUTPUT_HADESDIALNORM);
     if (on && trueHD)
       CLog::Log(LOGINFO, "CDVDAudioCodecPassthrough: TrueHD passed through: dialogue normalisation "
                          "left as the stream says: nothing public describes its dialogue norm");
@@ -266,10 +268,11 @@ void CDVDAudioCodecPassthrough::PublishDialnormSent(std::optional<int> sent)
 void CDVDAudioCodecPassthrough::DialnormSummary()
 {
   if (m_dialnorm.Frames())
-    CLog::Log(LOGINFO,
-              "CDVDAudioCodecPassthrough: dialogue normalisation sent as 0 dB in {} of the {} frames "
-              "passed through with the setting on",
-              m_dialnorm.Rewritten(), m_dialnorm.Frames());
+    CLog::Log(
+        LOGINFO,
+        "CDVDAudioCodecPassthrough: dialogue normalisation sent as 0 dB in {} of the {} frames "
+        "passed through with the setting on",
+        m_dialnorm.Rewritten(), m_dialnorm.Frames());
   m_dialnorm.Reset();
   m_dialnormOn.reset();
   PublishDialnormSent(std::nullopt);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
