@@ -762,26 +762,24 @@ bool CVideoPlayerAudio::ProcessDecoderOutput(DVDAudioFrame &audioframe)
     LIVEAUDIO::SETTINGS::Since(m_settingsSeen, LIVEAUDIO::SETTINGS::CWatch::Get().Now(),
                                passthroughSetting, decoderSetting);
     // (a compression set in advancedsettings.xml takes priority: the setting then changes nothing)
-    decoderSetting = decoderSetting && CServiceBroker::GetSettingsComponent()
-                                               ->GetAdvancedSettings()
-                                               ->m_audioApplyDrc < 0.0f;
+    decoderSetting =
+        decoderSetting &&
+        CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_audioApplyDrc < 0.0f;
     using LIVEAUDIO::SETTINGS::CodecCheck;
     CodecCheck check;
-    if (LIVEAUDIO::SETTINGS::CheckFor(passthroughSetting, decoderSetting,
-                                      m_pAudioCodec->NeedPassthrough(),
-                                      m_streaminfo.codec == AV_CODEC_ID_AC3 ||
-                                          m_streaminfo.codec == AV_CODEC_ID_EAC3,
-                                      &check))
+    if (LIVEAUDIO::SETTINGS::CheckFor(
+            passthroughSetting, decoderSetting, m_pAudioCodec->NeedPassthrough(),
+            m_streaminfo.codec == AV_CODEC_ID_AC3 || m_streaminfo.codec == AV_CODEC_ID_EAC3,
+            &check))
     {
       // (the compression changes in the decoder that plays, with no sound lost; only a decoder
       // that cannot take it while it decodes is opened again: UpdateDecoderSettings())
       const std::string before = m_pAudioCodec->GetName();
-      const bool inPlace =
-          check == CodecCheck::DECODER && m_pAudioCodec->UpdateDecoderSettings();
+      const bool inPlace = check == CodecCheck::DECODER && m_pAudioCodec->UpdateDecoderSettings();
       const bool switched = !inPlace && SwitchCodecIfNeeded(check);
       CLog::Log(LOGINFO, "CVideoPlayerAudio: an audio setting changed during playback ({}): {}",
                 check == CodecCheck::DECODER ? "of the decoder" : "of passthrough",
-                inPlace ? "it applies now, in the decoder that plays (" + before + ")"
+                inPlace     ? "it applies now, in the decoder that plays (" + before + ")"
                 : !switched ? std::string("the stream plays as it did")
                             : "it applies now: " + before + " -> " + m_pAudioCodec->GetName());
       if (switched)
