From da6da6110cde15c8a12aac8c3f05cf5d22c7a7c1 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 13:05:49 +0100
Subject: [PATCH] [Bluray] Don't take a seconds-long named segment as the
 single title.

A single title prefers the plain feature the disc names, and
SEG_MainFeature counts as one. Where the feature itself was only named
as e.g. an extended cut, a seconds-long SEG_MainFeature was the only
plain feature and became the single title. The plain feature must now be
of comparable length to the longest the disc names.
---
 xbmc/filesystem/DiscDirectoryHelper.cpp       | 12 ++++++++++-
 .../test/TestDiscDirectoryHelperProject.cpp   | 20 +++++++++++++++++++
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/xbmc/filesystem/DiscDirectoryHelper.cpp b/xbmc/filesystem/DiscDirectoryHelper.cpp
index 66accd3..2081f48 100644
--- a/xbmc/filesystem/DiscDirectoryHelper.cpp
+++ b/xbmc/filesystem/DiscDirectoryHelper.cpp
@@ -3456,10 +3456,20 @@ void CDiscDirectoryHelper::ApplyPlaylistHintsToMovie(const CURL& url,
   std::vector<PlaylistInformation> selected;
   if (job == GetTitle::SINGLE)
   {
+    // The plain feature is of comparable length to the longest the disc names, not a seconds-long
+    // segment it also calls SEG_MainFeature
     const PlaylistHintMap& hints{m_hints->GetHints()};
+    const auto longest{std::ranges::max(
+        features | std::views::transform([&playlistMap](unsigned int playlist)
+                                         { return playlistMap.at(playlist).duration; }))};
     std::vector<unsigned int> base{features};
     std::erase_if(base,
-                  [&hints](unsigned int playlist) { return !hints.at(playlist).basePresentation; });
+                  [&hints, &playlistMap, longest](unsigned int playlist)
+                  {
+                    return !hints.at(playlist).basePresentation ||
+                           playlistMap.at(playlist).duration <
+                               longest * MAIN_TITLE_LENGTH_PERCENT / 100;
+                  });
     if (!base.empty())
       selected = select(base);
 
diff --git a/xbmc/filesystem/test/TestDiscDirectoryHelperProject.cpp b/xbmc/filesystem/test/TestDiscDirectoryHelperProject.cpp
index 6b9de29..356399c 100644
--- a/xbmc/filesystem/test/TestDiscDirectoryHelperProject.cpp
+++ b/xbmc/filesystem/test/TestDiscDirectoryHelperProject.cpp
@@ -542,6 +542,26 @@ TEST_F(TestDiscDirectoryHelperProject, Movie_SingleTitlePrefersThePlainFeatureOv
   EXPECT_EQ(GetPlaylists(items), std::vector<unsigned int>{800u});
 }
 
+TEST_F(TestDiscDirectoryHelperProject, Movie_SingleTitleIsNotASegmentNamedAsTheFeature)
+{
+  // The feature is only named as an extended cut, and a seconds-long segment is SEG_MainFeature
+  CDiscDirectoryHelper helper;
+  CURL url;
+  CFileItemList items;
+  CFileItemList allTitles;
+
+  PlaylistMap playlists{{800u, MakePlaylist(800u, 130min, {1u})},
+                        {801u, MakePlaylist(801u, 5s, {2u})}};
+  ClipMap clips{{1u, MakeClip(130min, {800u})}, {2u, MakeClip(5s, {801u})}};
+
+  helper.SetPlaylistHints(MakeProject(
+      {MakeNamed(800u, "FPL_MainFeature_EXT", 130min), MakeNamed(801u, "SEG_MainFeature", 5s)}));
+
+  EXPECT_TRUE(
+      helper.GetMoviePlaylists(url, items, allTitles, -1, GetTitle::SINGLE, clips, playlists));
+  EXPECT_EQ(GetPlaylists(items), std::vector<unsigned int>{800u});
+}
+
 TEST_F(TestDiscDirectoryHelperProject, Movie_SingleTitleKeepsTheDiscInfMainPlaylist)
 {
   // disc.inf names playlist 801 as the main title. The project names 800 as the feature
