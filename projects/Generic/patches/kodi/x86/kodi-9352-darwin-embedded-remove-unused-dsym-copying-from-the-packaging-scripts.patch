From 3febb761bfe62c44d578d5248c80efcb743d598a Mon Sep 17 00:00:00 2001
From: Andrey Filipenkov <decapitator@ukr.net>
Date: Sun, 4 Oct 2026 08:41:24 +0300
Subject: [PATCH] [darwin_embedded] remove unused dSYM copying from the
 packaging scripts

(cherry picked from commit 562dd54c8b55f4f5246e8b30f9b47e879ccc5fa2)
---
 cmake/scripts/darwin_embedded/Install.cmake   |  2 -
 .../cpack_install-darwin_embedded.cmake.in    | 24 +----------
 .../mkdeb-darwin_embedded.sh.in               | 31 +------------
 .../test/TestDebPackaging.cmake               | 43 +++----------------
 4 files changed, 8 insertions(+), 92 deletions(-)

diff --git a/cmake/scripts/darwin_embedded/Install.cmake b/cmake/scripts/darwin_embedded/Install.cmake
index 4a74c8e..64b0e45 100644
--- a/cmake/scripts/darwin_embedded/Install.cmake
+++ b/cmake/scripts/darwin_embedded/Install.cmake
@@ -108,8 +108,6 @@ add_custom_command(TARGET ${APP_NAME_LC} POST_BUILD
 set(DEPENDS_ROOT_FOR_XCODE ${NATIVEPREFIX}/..)
 
 set(DARWIN_EMBEDDED_CPACK_DIR ${CMAKE_BINARY_DIR}/tools/darwin/packaging/darwin_embedded)
-set(DARWIN_EMBEDDED_DSYM_TARGET_DIR /Users/Shared/xbmc-depends/dSyms)
-set(DARWIN_EMBEDDED_DSYM_FILENAME ${APP_NAME}.app.dSYM)
 set(DARWIN_EMBEDDED_PACKAGE ${PLATFORM_BUNDLE_IDENTIFIER})
 set(DARWIN_EMBEDDED_PACKAGE_ARM64 ${DARWIN_EMBEDDED_PACKAGE}64)
 set(DARWIN_EMBEDDED_VERSION ${APP_VERSION_MAJOR}.${APP_VERSION_MINOR})
diff --git a/tools/darwin/packaging/darwin_embedded/cpack_install-darwin_embedded.cmake.in b/tools/darwin/packaging/darwin_embedded/cpack_install-darwin_embedded.cmake.in
index bf5294b..c461348 100644
--- a/tools/darwin/packaging/darwin_embedded/cpack_install-darwin_embedded.cmake.in
+++ b/tools/darwin/packaging/darwin_embedded/cpack_install-darwin_embedded.cmake.in
@@ -2,18 +2,8 @@ if(NOT CPACK_BUILD_CONFIG)
   set(CPACK_BUILD_CONFIG "@CORE_BUILD_CONFIG@")
 endif()
 
-string(TOLOWER "${CPACK_BUILD_CONFIG}" _build_config_lc)
-if(_build_config_lc MATCHES "debug")
-  set(_core_build_type Debug)
-elseif(_build_config_lc MATCHES "release")
-  set(_core_build_type Release)
-else()
-  message(FATAL_ERROR "You need to specify the build target")
-endif()
-
 set(_install_prefix "$ENV{CMAKE_INSTALL_PREFIX}")
-set(_app "@CMAKE_BINARY_DIR@/build/${_core_build_type}-@PLATFORM@/@APP_NAME@.app")
-set(_dsym "@CMAKE_BINARY_DIR@/build/${_core_build_type}-@PLATFORM@/@DARWIN_EMBEDDED_DSYM_FILENAME@")
+set(_app "@CMAKE_BINARY_DIR@/build/${CPACK_BUILD_CONFIG}/@APP_NAME@.app")
 
 if(NOT _install_prefix)
   message(FATAL_ERROR "CMAKE_INSTALL_PREFIX is not set by CPack")
@@ -23,18 +13,6 @@ if(NOT IS_DIRECTORY "${_app}")
   message(FATAL_ERROR "@APP_NAME@.app not found! are you sure you built ${CPACK_BUILD_CONFIG} target?")
 endif()
 
-if(IS_DIRECTORY "${_dsym}" AND IS_DIRECTORY "@DARWIN_EMBEDDED_DSYM_TARGET_DIR@")
-  execute_process(
-    COMMAND "@DARWIN_EMBEDDED_CPACK_DIR@/../gitrev-posix"
-    OUTPUT_VARIABLE _gitrev
-    OUTPUT_STRIP_TRAILING_WHITESPACE)
-  execute_process(
-    COMMAND tar -C "${_dsym}/.." -c "@DARWIN_EMBEDDED_DSYM_FILENAME@/"
-    COMMAND bzip2
-    OUTPUT_FILE "@DARWIN_EMBEDDED_DSYM_TARGET_DIR@/${_gitrev}-@DARWIN_EMBEDDED_DSYM_FILENAME@.tar.bz2"
-    COMMAND_ERROR_IS_FATAL ANY)
-endif()
-
 if(DARWIN_EMBEDDED_CPACK_KIND STREQUAL "ipa")
   set(_destination "${_install_prefix}/Payload")
 elseif(DARWIN_EMBEDDED_CPACK_KIND STREQUAL "deb")
diff --git a/tools/darwin/packaging/darwin_embedded/mkdeb-darwin_embedded.sh.in b/tools/darwin/packaging/darwin_embedded/mkdeb-darwin_embedded.sh.in
index 0dcd7de..dc952d6 100644
--- a/tools/darwin/packaging/darwin_embedded/mkdeb-darwin_embedded.sh.in
+++ b/tools/darwin/packaging/darwin_embedded/mkdeb-darwin_embedded.sh.in
@@ -2,42 +2,15 @@
 
 set -ex
 
-# usage: ./mkdeb-ios.sh release/debug (case insensitive)
-# Allows us to run mkdeb-ios.sh from anywhere in the tree, rather than the tools/darwin/packaging/ios folder only
 NATIVEPREFIX=@NATIVEPREFIX@
-SWITCH=`echo $1 | tr [A-Z] [a-z]`
 DIRNAME=`dirname $0`
-DSYM_TARGET_DIR=@DARWIN_EMBEDDED_DSYM_TARGET_DIR@
-DSYM_FILENAME=@APP_NAME@.app.dSYM
 PP_DEVICE=iOS
 if [ "@PLATFORM@" = "appletvos" ]; then
   PP_DEVICE=tvOS
 fi
 
-if [ "${SWITCH#*debug}" != "${SWITCH}" ]; then
-  echo "Packaging Debug target for ${PP_DEVICE}"
-  APP="$DIRNAME/../../../../build/Debug-@PLATFORM@/@APP_NAME@.app"
-  DSYM="$DIRNAME/../../../../build/Debug-@PLATFORM@/$DSYM_FILENAME"
-elif [ "${SWITCH#*release}" != "${SWITCH}" ]; then
-  echo "Packaging Release target for ${PP_DEVICE}"
-  APP="$DIRNAME/../../../../build/Release-@PLATFORM@/@APP_NAME@.app"
-  DSYM="$DIRNAME/../../../../build/Release-@PLATFORM@/$DSYM_FILENAME"
-else
-  echo "You need to specify the build target"
-  exit 1
-fi
-
-# copy bzip2 of dsym to xbmc-depends install dir
-if [ -d "$DSYM" ] && [ -d "$DSYM_TARGET_DIR" ]; then
-  GITREV=$("$DIRNAME/../gitrev-posix")
-  case "$GITREV" in
-    ""|*[!A-Za-z0-9._-]*)
-      echo "Invalid git revision: $GITREV" >&2
-      exit 1
-      ;;
-  esac
-  tar -C "$DSYM/.." -c "$DSYM_FILENAME/" | bzip2 > "$DSYM_TARGET_DIR/${GITREV}-${DSYM_FILENAME}.tar.bz2"
-fi
+echo "Packaging target for $PP_DEVICE built as $1"
+APP="$DIRNAME/../../../../build/$1/@APP_NAME@.app"
 
 if [ ! -d "$APP" ]; then
   echo "@APP_NAME@.app not found! are you sure you built $1 target?"
diff --git a/tools/darwin/packaging/darwin_embedded/test/TestDebPackaging.cmake b/tools/darwin/packaging/darwin_embedded/test/TestDebPackaging.cmake
index 6cabd7b..ba28521 100644
--- a/tools/darwin/packaging/darwin_embedded/test/TestDebPackaging.cmake
+++ b/tools/darwin/packaging/darwin_embedded/test/TestDebPackaging.cmake
@@ -8,18 +8,11 @@ endif()
 
 set(_test_root "${TEST_BINARY_DIR}/darwin-embedded-deb-${TEST_PLATFORM}")
 set(_packaging_dir "${_test_root}/tools/darwin/packaging/darwin_embedded")
-set(_app_dir "${_test_root}/build/Debug-${TEST_PLATFORM}/Kodi.app")
-set(_dsym_dir "${_test_root}/build/Debug-${TEST_PLATFORM}/Kodi.app.dSYM")
-set(DARWIN_EMBEDDED_DSYM_TARGET_DIR "${_test_root}/dsyms")
+set(_build_config "Debug-${TEST_PLATFORM}")
+set(_app_dir "${_test_root}/build/${_build_config}/Kodi.app")
 file(REMOVE_RECURSE "${_test_root}")
-file(MAKE_DIRECTORY "${_packaging_dir}" "${_app_dir}" "${_dsym_dir}"
-                    "${DARWIN_EMBEDDED_DSYM_TARGET_DIR}")
+file(MAKE_DIRECTORY "${_packaging_dir}" "${_app_dir}")
 file(WRITE "${_app_dir}/payload.txt" "packaged\n")
-file(WRITE "${_dsym_dir}/symbols" "symbols\n")
-file(WRITE "${_packaging_dir}/../gitrev-posix" "#!/bin/sh\nprintf 'safe-revision'\n")
-file(CHMOD "${_packaging_dir}/../gitrev-posix"
-     PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
-                 WORLD_READ WORLD_EXECUTE)
 
 get_filename_component(_dpkg_bin_dir "${DPKG_DEB_EXECUTABLE}" DIRECTORY)
 get_filename_component(NATIVEPREFIX "${_dpkg_bin_dir}" DIRECTORY)
@@ -37,7 +30,7 @@ configure_file(
   @ONLY)
 
 execute_process(
-  COMMAND sh "${_packaging_dir}/mkdeb-darwin_embedded.sh" Debug
+  COMMAND sh "${_packaging_dir}/mkdeb-darwin_embedded.sh" ${_build_config}
   RESULT_VARIABLE _package_result
   OUTPUT_VARIABLE _package_output
   ERROR_VARIABLE _package_error)
@@ -51,10 +44,6 @@ set(_package
 if(NOT EXISTS "${_package}")
   message(FATAL_ERROR "Expected package was not created: ${_package}")
 endif()
-if(NOT EXISTS
-   "${DARWIN_EMBEDDED_DSYM_TARGET_DIR}/safe-revision-Kodi.app.dSYM.tar.bz2")
-  message(FATAL_ERROR "Expected dSYM archive was not created")
-endif()
 
 execute_process(
   COMMAND "${DPKG_DEB_EXECUTABLE}" --contents "${_package}"
@@ -100,7 +89,7 @@ configure_file(
   "${_packaging_dir}/mkdeb-unsafe.sh"
   @ONLY)
 execute_process(
-  COMMAND sh "${_packaging_dir}/mkdeb-unsafe.sh" Debug
+  COMMAND sh "${_packaging_dir}/mkdeb-unsafe.sh" ${_build_config}
   RESULT_VARIABLE _unsafe_result
   OUTPUT_VARIABLE _unsafe_output
   ERROR_VARIABLE _unsafe_error)
@@ -113,25 +102,3 @@ endif()
 if(NOT EXISTS "${_unsafe_dir}/sentinel")
   message(FATAL_ERROR "Unsafe package identifier removed a directory outside its staging path")
 endif()
-
-set(PLATFORM_BUNDLE_IDENTIFIER "${TEST_BUNDLE_IDENTIFIER}")
-file(WRITE "${_packaging_dir}/../gitrev-posix" "#!/bin/sh\nprintf '../unsafe-revision'\n")
-configure_file(
-  "${KODI_SOURCE_DIR}/tools/darwin/packaging/darwin_embedded/mkdeb-darwin_embedded.sh.in"
-  "${_packaging_dir}/mkdeb-unsafe-revision.sh"
-  @ONLY)
-execute_process(
-  COMMAND sh "${_packaging_dir}/mkdeb-unsafe-revision.sh" Debug
-  RESULT_VARIABLE _unsafe_revision_result
-  OUTPUT_VARIABLE _unsafe_revision_output
-  ERROR_VARIABLE _unsafe_revision_error)
-if(_unsafe_revision_result EQUAL 0)
-  message(FATAL_ERROR "Packaging accepted an unsafe git revision")
-endif()
-if(NOT "${_unsafe_revision_output}${_unsafe_revision_error}" MATCHES
-   "Invalid git revision")
-  message(FATAL_ERROR "dSYM packaging failed for the wrong reason")
-endif()
-if(EXISTS "${DARWIN_EMBEDDED_DSYM_TARGET_DIR}/../unsafe-revision-Kodi.app.dSYM.tar.bz2")
-  message(FATAL_ERROR "Unsafe git revision wrote a dSYM archive outside its target directory")
-endif()
-- 
2.53.0

