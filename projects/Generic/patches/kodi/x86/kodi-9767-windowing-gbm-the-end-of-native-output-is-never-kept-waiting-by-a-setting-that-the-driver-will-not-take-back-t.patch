+/*!
+ * \brief What a property that the transport sets is to the end of native output
+ *
+ *  - SIGNAL: what tells the display that the transport is on (the flag of the tunnel of the kernel,
+ *    the Dolby vendor InfoFrame of nvidia-drm, and the signalling that goes with them). It goes
+ *    back in every attempt, whatever else the driver refuses: the end of native output is the end
+ *    of these.
+ *  - SETTING: a setting of the output that the transport makes neutral (the depth of the link, the
+ *    range, the colorimetry, the dithering, the colour processing of the CRTC and the plane, HDMI
+ *    VRR): a choice of the user or a state of Kodi, none of it Dolby Vision. What was found goes
+ *    back where the driver takes it; where it does not, the property stays at the transport's
+ *    value, with which the menus show as they are, and Kodi asks for its own again with its next
+ *    change of mode (StageOutputFormat(), StageRgbRange(), QueueLinkDepth(), SetHDR()).
+ *  - MODE_SETTING: such a setting whose value depends on the mode or on the display (the colour
+ *    format that the user chose: amdgpu takes YCbCr 4:2:0 only in the modes that the display lists
+ *    for it; the HDR metadata of a video: only an EOTF that the display declares). Besides, it is
+ *    the first to stay at the transport's value when the commit that gives the output back keeps
+ *    being refused while its plan alone is taken: what the driver refuses is then the change of
+ *    mode that goes with it, which its tests do not carry.
+ *
+ * A property that is not named here is a signal: it always goes back.
+ */
+enum class Part
+{
+  SIGNAL,
+  SETTING,
+  MODE_SETTING,
+};
+
+inline Part PartOf(Role role, std::string_view name)
+{
+  struct Row
+  {
+    Role role;
+    const char* name;
+    Part part;
+  };
+  static const Row rows[] = {
+      {Role::CONNECTOR, "color format", Part::MODE_SETTING},
+      {Role::CONNECTOR, "NV_CONNECTOR_COLOR_FORMAT", Part::MODE_SETTING},
+      {Role::CONNECTOR, "HDR_OUTPUT_METADATA", Part::MODE_SETTING},
+      {Role::CONNECTOR, "max bpc", Part::SETTING},
+      {Role::CONNECTOR, "Broadcast RGB", Part::SETTING},
+      {Role::CONNECTOR, "Colorspace", Part::SETTING},
+      {Role::CONNECTOR, "dithering mode", Part::SETTING},
+      {Role::CONNECTOR, "NV_HDMI_VRR_OFF", Part::SETTING},
+      {Role::CRTC, "CTM", Part::SETTING},
+      {Role::CRTC, "GAMMA_LUT", Part::SETTING},
+      {Role::CRTC, "DEGAMMA_LUT", Part::SETTING},
+      {Role::CRTC, "VRR_ENABLED", Part::SETTING},
+      {Role::CRTC, "NV_CRTC_REGAMMA_TF", Part::SETTING},
+      {Role::CRTC, "NV_CRTC_REGAMMA_LUT", Part::SETTING},
+      {Role::CRTC, "NV_CRTC_REGAMMA_DIVISOR", Part::SETTING},
+      {Role::CRTC, "NV_CRTC_COLOR_PASSTHROUGH", Part::SETTING},
+      {Role::PLANE, "rotation", Part::SETTING},
+      {Role::PLANE, "alpha", Part::SETTING},
+      {Role::PLANE, "COLOR_PIPELINE", Part::SETTING},
+      {Role::PLANE, "pixel blend mode", Part::SETTING},
+      {Role::PLANE, "NV_INPUT_COLORSPACE", Part::SETTING},
+      {Role::PLANE, "NV_HDR_STATIC_METADATA", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_LMS_CTM", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_LMS_TO_ITP_CTM", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_ITP_TO_LMS_CTM", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_BLEND_CTM", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_DEGAMMA_LUT", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_TMO_LUT", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_DEGAMMA_TF", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_DEGAMMA_MULTIPLIER", Part::SETTING},
+      {Role::PLANE, "NV_PLANE_COLOR_PASSTHROUGH", Part::SETTING},
+  };
+  for (const auto& row : rows)
+    if (row.role == role && name == row.name)
+      return row.part;
+  return Part::SIGNAL;
+}
