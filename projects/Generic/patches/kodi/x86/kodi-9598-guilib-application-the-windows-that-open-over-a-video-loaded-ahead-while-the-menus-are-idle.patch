diff --git a/xbmc/guilib/WindowPreload.h b/xbmc/guilib/WindowPreload.h
new file mode 100644
index 0000000..f5601ee
--- /dev/null
+++ b/xbmc/guilib/WindowPreload.h
@@ -0,0 +1,136 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdio>
+#include <string>
+#include <utility>
+#include <vector>
+
+/*!
+ * \brief Hades: the windows that open over a video, loaded ahead while the menus are idle
+ *        (CGUIWindowManager::PreloadForVideo())
+ *
+ * A window of the KEEP_IN_MEMORY kind (the video OSD, its settings, the player information, the
+ * Settings window) loads its skin file and makes its controls the first time it opens in a session,
+ * and allocates its textures each time it opens. Opened over a video, that happens on the thread
+ * that also presents the frames of the video: issue #3 (cinema-ONE, RX 7600) had frames 83 ms
+ * apart once, one refresh missed, as the Settings window opened over native Dolby Vision. Such a
+ * window is loaded here the way Kodi loads the windows it keeps (CGUIWindow::Initialize(), as
+ * CGUIWindowManager::LoadNotOnDemandWindows() does for LOAD_ON_GUI_INIT ones), one a pass of the
+ * loop, while nothing plays, no modal dialog is open, the screen is awake and no input came for a
+ * while. Then its first open is as its second: the skin file is not read again (unless conditions of
+ * its includes changed, as Kodi checks: CGUIWindow::NeedLoad()), and the textures that the load
+ * allocated are those of the first open; closing it frees them, as before.
+ *
+ * This class only keeps the list and says what was done; a test builds it on the host.
+ */
+class CWindowPreload
+{
+public:
+  //! seconds without input before a window is loaded
+  static constexpr int IDLE_SECONDS = 2;
+
+  //! the menus are idle for it: the windows are there, nothing plays, no modal dialog is open, the
+  //! screen is awake (no screensaver, no DPMS) and no input came for IDLE_SECONDS
+  static constexpr bool Idle(
+      bool initialized, bool playing, bool modal, bool screenOff, int idleSeconds)
+  {
+    return initialized && !playing && !modal && !screenOff && idleSeconds >= IDLE_SECONDS;
+  }
+
+  enum class Result
+  {
+    LOADED, //!< loaded now
+    ALREADY, //!< it had been loaded (opened before, or open)
+    NOT_IN_SKIN, //!< there is no such window, or the skin has no file for it
+    NOT_KEPT, //!< not of the KEEP_IN_MEMORY kind: Kodi loads it every time, or at start already
+    FAILED, //!< its skin file did not load
+  };
+
+  //! the windows to load, in order (when the window manager is initialized: the skin loads)
+  void Reset(std::vector<int> ids)
+  {
+    m_ids = std::move(ids);
+    m_next = 0;
+    m_done.clear();
+    m_told = false;
+  }
+
+  bool Pending() const { return m_next < m_ids.size(); }
+
+  //! the next one (Pending() first)
+  int Next() { return m_ids[m_next++]; }
+
+  void Took(const std::string& file, Result result, double ms)
+  {
+    m_done.push_back({file, result, ms});
+  }
+
+  //! the line of the log, once, after the last one; empty before and after
+  std::string Summary()
+  {
+    if (m_told || m_ids.empty() || Pending())
+      return {};
+    m_told = true;
+    std::string loaded;
+    std::string others[4];
+    double total = 0.0;
+    double longest = 0.0;
+    unsigned int count = 0;
+    for (const auto& done : m_done)
+    {
+      if (done.result == Result::LOADED)
+      {
+        char item[96];
+        std::snprintf(item, sizeof(item), "%s%s %.1f ms", loaded.empty() ? "" : ", ",
+                      done.file.c_str(), done.ms);
+        loaded += item;
+        total += done.ms;
+        longest = done.ms > longest ? done.ms : longest;
+        ++count;
+        continue;
+      }
+      std::string& list = others[static_cast<int>(done.result) - 1];
+      list += (list.empty() ? "" : ", ") + (done.file.empty() ? std::string("?") : done.file);
+    }
+    char head[160];
+    std::snprintf(head, sizeof(head),
+                  "GUI: %u windows that open over a video were loaded ahead while the menus were "
+                  "idle, one a pass",
+                  count);
+    std::string text = head;
+    if (count)
+    {
+      char tail[96];
+      std::snprintf(tail, sizeof(tail), "; %.1f ms in all, the longest %.1f ms", total, longest);
+      text += ": " + loaded + tail;
+    }
+    static const char* const names[4] = {"loaded already", "not in the skin",
+                                         "not kept in memory", "failed"};
+    for (int i = 0; i < 4; ++i)
+    {
+      if (!others[i].empty())
+        text += std::string("; ") + names[i] + ": " + others[i];
+    }
+    return text;
+  }
+
+private:
+  struct Done
+  {
+    std::string file;
+    Result result;
+    double ms;
+  };
+  std::vector<int> m_ids;
+  size_t m_next = 0;
+  std::vector<Done> m_done;
+  bool m_told = false;
+};
