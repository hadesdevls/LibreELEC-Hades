+  m_preload.Reset({WINDOW_DIALOG_VIDEO_OSD, WINDOW_DIALOG_PLAYER_PROCESS_INFO, WINDOW_SETTINGS_MENU,
+                   WINDOW_DIALOG_VIDEO_OSD_SETTINGS, WINDOW_DIALOG_AUDIO_OSD_SETTINGS,
+                   WINDOW_DIALOG_SUBTITLE_OSD_SETTINGS, WINDOW_DIALOG_FULLSCREEN_INFO});
+
   CServiceBroker::GetAppMessenger()->RegisterReceiver(this);
 }
 
@@ -1851,6 +1861,35 @@ bool CGUIWindowManager::IsWindowVisible(const std::string &xmlFile) const
   return IsWindowActive(xmlFile, false);
 }
 
+void CGUIWindowManager::PreloadForVideo(bool idle)
+{
+  if (!idle || !m_preload.Pending())
+    return;
+  const int id = m_preload.Next();
+  CGUIWindow* window = GetWindow(id);
+  const std::string file = window ? window->GetProperty("xmlfile").asString() : std::string();
+  const auto skin = CServiceBroker::GetGUI()->GetSkinInfo();
+  if (!window || file.empty() || !skin)
+    m_preload.Took(file, CWindowPreload::Result::NOT_IN_SKIN, 0.0);
+  else if (window->GetLoadType() != CGUIWindow::KEEP_IN_MEMORY)
+    m_preload.Took(file, CWindowPreload::Result::NOT_KEPT, 0.0);
+  else if (window->IsActive() || !window->WouldLoad())
+    m_preload.Took(file, CWindowPreload::Result::ALREADY, 0.0);
+  else if (!XFILE::CFile::Exists(skin->GetSkinPath(file)))
+    m_preload.Took(file, CWindowPreload::Result::NOT_IN_SKIN, 0.0);
+  else
+  {
+    const auto start = std::chrono::steady_clock::now();
+    const bool loaded = window->Initialize();
+    const std::chrono::duration<double, std::milli> took = std::chrono::steady_clock::now() - start;
+    m_preload.Took(file, loaded ? CWindowPreload::Result::LOADED : CWindowPreload::Result::FAILED,
+                   took.count());
+  }
+  const std::string summary = m_preload.Summary();
+  if (!summary.empty())
+    CLog::Log(LOGINFO, "{}", summary);
+}
+
 void CGUIWindowManager::LoadNotOnDemandWindows()
 {
   std::unique_lock lock(CServiceBroker::GetWinSystem()->GetGfxContext());
