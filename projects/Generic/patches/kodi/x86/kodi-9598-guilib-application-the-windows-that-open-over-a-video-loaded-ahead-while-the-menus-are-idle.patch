@@ -2681,6 +2681,20 @@ void CApplication::Process()
   // is what a deferred skin reload is waiting for
   GetComponent<CApplicationSkinHandling>()->ProcessPendingSkinReload();
 
+  // Hades: one of the windows that open over a video is loaded ahead a pass while the menus are
+  // idle, so that it is not loaded on the thread that presents the video (CWindowPreload)
+  CGUIWindowManager& windowManager = CServiceBroker::GetGUI()->GetWindowManager();
+  if (windowManager.PreloadForVideoPending())
+  {
+    const auto appPlayer = GetComponent<CApplicationPlayer>();
+    const auto appPower = GetComponent<CApplicationPowerHandling>();
+    windowManager.PreloadForVideo(CWindowPreload::Idle(
+        windowManager.Initialized(), appPlayer && appPlayer->IsPlaying(),
+        windowManager.HasModalDialog(true),
+        appPower && (appPower->IsDPMSActive() || appPower->IsInScreenSaver()),
+        appPower ? appPower->GlobalIdleTime() : 0));
+  }
+
   // do any processing that isn't needed on each run
   if( m_slowTimer.GetElapsedMilliseconds() > 500 )
   {
