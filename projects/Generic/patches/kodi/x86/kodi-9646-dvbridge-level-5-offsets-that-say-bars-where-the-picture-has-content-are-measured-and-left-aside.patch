+// Hades: level 5 offsets that say bars where the picture has content (dvbridge_l5check.h). Native output only, where
+// the offsets blank the rows they say are bars. A few pictures of the video are measured on the GPU as HDR10 measured
+// as Dolby Vision measures its pictures (P010: the measurement reads the 10 bits at the top of 16), and what the GPU
+// finished is collected at a later frame, without waiting. Any other picture asks nothing of the GPU.
+void CWinSystemGbmGLESContext::DVCheckL5(const CDVBridgeGLES::Layer& layer,
+                                         const CDVMetadataBuffer& metadata,
+                                         bool skip)
+{
+  if (m_dvL5InFlight && m_dvL5Measure)
+    m_dvL5InFlight = dvbridge_measure_collect(
+        m_dvL5Measure.get(), [](const dvbridge_measured_raw* raw, uint64_t tag, void* context)
+        { static_cast<CWinSystemGbmGLESContext*>(context)->DVL5Measured(raw, tag); }, this);
+  // (the video of the picture; one without a number is not measured)
+  if (!layer.video)
+    return;
+  dvbridge_l5check_video(&m_dvL5Check, layer.video);
+  unsigned int bars[4];
+  if (!m_dvFrame || skip || layer.layout != DVBRIDGE_P010 || m_dvL5MeasureFailed || !m_dvBridge ||
+      !m_dvBridge->PreparedPictureBars(bars))
+    return;
+  const auto* dovi = reinterpret_cast<const AVDOVIMetadata*>(metadata.Data());
+  const bool refresh = dovi && metadata.Size() >= sizeof(AVDOVIMetadata) &&
+                       av_dovi_get_color(dovi)->scene_refresh_flag;
+  const double t = layer.pts / DVD_TIME_BASE;
+  if (!dvbridge_l5check_wanted(&m_dvL5Check, t, refresh, bars))
+    return;
+  if (!m_dvL5Measure)
+  {
+    m_dvL5Measure.reset(dvbridge_measure_create());
+    m_dvL5Reduce.reset(dvbridge_measured_create(nullptr));
+    if (!m_dvL5Measure || !m_dvL5Reduce)
+    {
+      m_dvL5MeasureFailed = true;
+      m_dvL5Measure.reset();
+      CLog::Log(LOGWARNING,
+                "DVBridge: the measurement of Dolby Vision pictures against their level 5 "
+                "offsets could not be set up: the offsets are taken as they are (as before)");
+      return;
+    }
+  }
+  const int window[2] = {0, layer.width / 2};
+  if (dvbridge_measure_submit(m_dvL5Measure.get(), layer.planes[0].texture, layer.planes[1].texture,
+                              layer.width, layer.height, window, layer.pts, layer.video))
+  {
+    dvbridge_l5check_submitted(&m_dvL5Check, t, layer.pts, bars, layer.width, layer.height);
+    ++m_dvL5InFlight;
+  }
+}
+
+void CWinSystemGbmGLESContext::DVL5Measured(const dvbridge_measured_raw* raw, uint64_t tag)
+{
+  dvbridge_measured_picture picture;
+  if (!raw || tag != m_dvL5Check.video ||
+      !dvbridge_measured_reduce(m_dvL5Reduce.get(), raw, &picture) ||
+      !dvbridge_l5check_result(&m_dvL5Check, raw->pts, raw->pts / DVD_TIME_BASE, &picture))
+    return;
+  const dvbridge_l5check& c = m_dvL5Check;
+  CLog::Log(
+      LOGWARNING,
+      "DVBridge: the level 5 offsets of this video make bars of {} {} {} {} samples (left, right, "
+      "top, bottom) in its {}x{} picture, and {} of the {} pictures measured have content there "
+      "({:.1f} s to {:.1f} s; the last one in rows {} to {} and columns {} to {}): they are left "
+      "aside for the rest of the video",
+      c.last_bars[0], c.last_bars[1], c.last_bars[2], c.last_bars[3], c.width, c.height,
+      c.contradicted, c.measured, c.contradicted_first, c.contradicted_last, c.last_active[0],
+      c.last_active[1], c.last_active[2], c.last_active[3]);
+  if (m_dvBridge)
+    m_dvBridge->IgnoreL5(c.video, "measured pictures have content where they say bars");
+}
