diff --git a/tools/dvbridge/dvbridge_l5check.h b/tools/dvbridge/dvbridge_l5check.h
new file mode 100644
index 0000000..254c4b6
--- /dev/null
+++ b/tools/dvbridge/dvbridge_l5check.h
@@ -0,0 +1,160 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_L5CHECK_H
+#define DVBRIDGE_L5CHECK_H
+/* Hades: level 5 offsets that say bars where the picture has content. Such a block (the RPU of another framing of the
+ * film: an "open matte" encode with the RPU of the letterboxed one, a picture cropped on both axes from its master)
+ * blanks rows of the picture in native output (dvbridge_dv_l5() in dvbridge_metadata.h says how). Whether it does is
+ * measured on a few pictures of the video, with the measurement of HDR10 measured as Dolby Vision
+ * (dvbridge_measure.h, dvbridge_measured_reduce(): the rows and columns that hold blocks above its black level), and
+ * decided over several of them, never on one: a dark scene has black where the picture is, and is no contradiction.
+ *
+ * Which pictures (dvbridge_l5check_wanted()), and only while the offsets make bars inside the picture: one a second in
+ * the first DVBRIDGE_L5CHECK_OPENING seconds of the video, then one at a cut of its RPU (scene_refresh_flag) at most
+ * every DVBRIDGE_L5CHECK_SCENE_STEP seconds, and one every DVBRIDGE_L5CHECK_STEADY_STEP seconds without a cut. The
+ * other pictures are not measured and cost nothing on the GPU. The decision (dvbridge_l5check_result()):
+ * DVBRIDGE_L5CHECK_NEEDED measured pictures with content in more than half of a bar (dvbridge_dv_l5_contradicted()),
+ * the first and the last at least DVBRIDGE_L5CHECK_SPAN seconds apart (not one shot with a flash). Then the offsets are
+ * left aside for the rest of the video (dvbridge_dv_ignore_l5()), and nothing more is measured of it. Plain C, no GL:
+ * the caller measures. */
+#include <math.h>
+#include <stdbool.h>
+#include <string.h>
+
+#include "dvbridge_measured.h"
+
+#define DVBRIDGE_L5CHECK_OPENING 10.0
+#define DVBRIDGE_L5CHECK_OPENING_STEP 1.0
+#define DVBRIDGE_L5CHECK_SCENE_STEP 10.0
+#define DVBRIDGE_L5CHECK_STEADY_STEP 30.0
+#define DVBRIDGE_L5CHECK_NEEDED 3
+#define DVBRIDGE_L5CHECK_SPAN 2.0
+#define DVBRIDGE_L5CHECK_PENDING 8
+
+/* Hades: whether what was measured of a picture says that its level 5 offsets cannot be right: content (blocks above
+ * the black level, in samples) in more than half of a bar of 8 samples or more. bars: left, right, top, bottom, in
+ * samples of the picture (dvbridge_dv_picture_bars()); active: the measured rows [0], [1) and columns [2], [3) of the
+ * w x h picture that hold content. A picture without content, a dark one, or a dirty edge of a few rows at the edge
+ * of a bar is no contradiction; the picture of an "open matte" encode is, and so are the lines of subtitles burnt
+ * into a bar (which the active area would blank). */
+static inline bool dvbridge_dv_l5_contradicted(const unsigned bars[4], const int active[4], int w, int h)
+{
+    if (!bars || !active || w <= 0 || h <= 0 || active[0] >= active[1] || active[2] >= active[3])
+        return false;
+    const long into[4] = {(long)bars[0] - active[2], active[3] - ((long)w - bars[1]), (long)bars[2] - active[0],
+                          active[1] - ((long)h - bars[3])};
+    for (int i = 0; i < 4; i++)
+        if (bars[i] >= 8 && 2 * into[i] > (long)bars[i])
+            return true;
+    return false;
+}
+
+struct dvbridge_l5check {
+    unsigned video;    /* the video this is of (0: none yet) */
+    bool started;      /* a picture with bars came: first is its time */
+    double first, last; /* the first picture with bars, and the last one given to the measurement (seconds) */
+    bool any;          /* one was given */
+    unsigned submitted, measured, contradicted;
+    double contradicted_first, contradicted_last;
+    bool decided;      /* the offsets are left aside for the video */
+    /* what the last contradicting picture showed: its bars and its rows and columns with content (samples) */
+    unsigned last_bars[4];
+    int last_active[4];
+    int width, height;
+    /* the pictures given to the measurement and not measured yet: their time (as given) and bars */
+    struct {
+        bool used;
+        double pts;
+        unsigned bars[4];
+        int w, h;
+    } pending[DVBRIDGE_L5CHECK_PENDING];
+};
+
+/* Hades: the pictures from now on are of video: another one than before starts the check again (true) */
+static inline bool dvbridge_l5check_video(struct dvbridge_l5check *c, unsigned video)
+{
+    if (c->video == video)
+        return false;
+    memset(c, 0, sizeof(*c));
+    c->video = video;
+    return true;
+}
+
+/* Hades: whether the picture at t (seconds of the video), a cut of its RPU where refresh, whose level 5 offsets make
+ * bars inside it (bars: dvbridge_dv_picture_bars()), is given to the measurement. A jump back (a seek) measures the
+ * next picture. */
+static inline bool dvbridge_l5check_wanted(struct dvbridge_l5check *c, double t, bool refresh, const unsigned bars[4])
+{
+    if (c->decided || !isfinite(t) || !bars || !(bars[0] || bars[1] || bars[2] || bars[3]))
+        return false;
+    if (!c->started) {
+        c->started = true;
+        c->first = t;
+    }
+    if (t < c->first)
+        c->first = t;
+    const double since = c->any && t >= c->last ? t - c->last : (double)INFINITY;
+    if (t - c->first < DVBRIDGE_L5CHECK_OPENING)
+        return since >= DVBRIDGE_L5CHECK_OPENING_STEP;
+    return since >= (refresh ? DVBRIDGE_L5CHECK_SCENE_STEP : DVBRIDGE_L5CHECK_STEADY_STEP);
+}
+
+/* Hades: the picture at t, pts as the measurement gives it back, with its bars, was given to the measurement */
+static inline void dvbridge_l5check_submitted(struct dvbridge_l5check *c, double t, double pts, const unsigned bars[4],
+                                              int w, int h)
+{
+    c->any = true;
+    c->last = t;
+    c->submitted++;
+    int slot = 0;
+    for (int i = 0; i < DVBRIDGE_L5CHECK_PENDING; i++)
+        if (!c->pending[i].used || c->pending[i].pts < c->pending[slot].pts) {
+            slot = i;
+            if (!c->pending[i].used)
+                break;
+        }
+    c->pending[slot].used = true;
+    c->pending[slot].pts = pts;
+    memcpy(c->pending[slot].bars, bars, sizeof(c->pending[slot].bars));
+    c->pending[slot].w = w;
+    c->pending[slot].h = h;
+}
+
+/* Hades: what the measurement gave of the picture of pts (seconds of the video: t); true when the offsets are left
+ * aside now, on this picture */
+static inline bool dvbridge_l5check_result(struct dvbridge_l5check *c, double pts, double t,
+                                           const struct dvbridge_measured_picture *picture)
+{
+    int slot = -1;
+    for (int i = 0; i < DVBRIDGE_L5CHECK_PENDING && slot < 0; i++)
+        if (c->pending[i].used && c->pending[i].pts == pts)
+            slot = i;
+    if (slot < 0 || !picture || c->decided)
+        return false;
+    c->pending[slot].used = false;
+    c->measured++;
+    /* (the rows and columns of 2x2 blocks, in samples) */
+    const int active[4] = {2 * picture->active[0], 2 * picture->active[1], 2 * picture->active[2],
+                           2 * picture->active[3]};
+    if (!picture->content ||
+        !dvbridge_dv_l5_contradicted(c->pending[slot].bars, active, c->pending[slot].w, c->pending[slot].h))
+        return false;
+    if (!c->contradicted || t < c->contradicted_first)
+        c->contradicted_first = t;
+    if (!c->contradicted || t > c->contradicted_last)
+        c->contradicted_last = t;
+    c->contradicted++;
+    memcpy(c->last_bars, c->pending[slot].bars, sizeof(c->last_bars));
+    memcpy(c->last_active, active, sizeof(c->last_active));
+    c->width = c->pending[slot].w;
+    c->height = c->pending[slot].h;
+    c->decided = c->contradicted >= DVBRIDGE_L5CHECK_NEEDED &&
+                 c->contradicted_last - c->contradicted_first >= DVBRIDGE_L5CHECK_SPAN;
+    return c->decided;
+}
+#endif
