+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace KODI::WINDOWING::GBM
+{
+//! Hades: what the depth of the link does with a request of the HDR signalling (HDRDepthFor())
+struct HDRDepthStep
+{
+  //! the value to queue for "max bpc" with this request; nothing: it is not touched
+  std::optional<uint64_t> maxBpc;
+  //! the link is held at 8 bits by this, after the request
+  bool capped{false};
+};
+
+/*!
+ * \brief Hades: the depth of the link for HDR10 and HLG where the user chose it
+ *        (videoscreen.hadeshdrdepth, on nvidia-drm with NV_OUTPUT_BPC)
+ * \param choice the output has the choice (CWinSystemGbm::SupportsHDRDepthChoice())
+ * \param setting the setting: 0 automatic (as many bits as the display and the mode take, the
+ *        driver's choice), 8 at most 8 bits
+ * \param hdrSent this request signals HDR for a picture (CHDRSignal::Outcome::Sent())
+ * \param capped the link was held at 8 bits by this before the request
+ * \param modeset this request is a modeset: "max bpc" may change in it
+ * \param maximum the highest "max bpc" the driver takes, what it is put back to
+ *
+ * Some TVs with an 8-bit panel (with FRC) show more banding with 10 or 12 bits at their input
+ * than with 8 (issue #4, 2026-10-26: the HDR10 that NVIDIA sent at 8 bits through a dual-mode
+ * port looked right, the 10 bits through an adapter did not). With 8 bits chosen, "max bpc" goes
+ * to 8 with every request that signals HDR (the transport of Dolby Vision puts back what it found,
+ * which can be another value) and back to the maximum with the first modeset after it: SDR and
+ * Dolby Vision are never held by it. Automatic leaves "max bpc" as it is.
+ */
+inline HDRDepthStep HDRDepthFor(
+    bool choice, int setting, bool hdrSent, bool capped, bool modeset, uint64_t maximum)
+{
+  if (!choice)
+    return {std::nullopt, false};
+  if (hdrSent && setting == 8)
+    return {8, true};
+  if (capped && modeset)
+    return {maximum, false};
+  return {std::nullopt, capped};
+}
