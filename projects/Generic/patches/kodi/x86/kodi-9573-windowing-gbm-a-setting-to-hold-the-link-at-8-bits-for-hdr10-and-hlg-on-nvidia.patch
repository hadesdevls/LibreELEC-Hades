+// Hades: the setting of the depth of HDR on the link, where the output has the choice
+bool SupportsHDRDepthChoice(const std::string& /*condition*/,
+                            const std::string& /*value*/,
+                            const SettingConstPtr& /*setting*/)
+{
+  const auto* winSystem = CServiceBroker::GetWinSystem();
+  return winSystem && winSystem->SupportsHDRDepthChoice();
+}
