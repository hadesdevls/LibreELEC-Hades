+// with the first modeset (HDRDepthFor()), as at the end of HDR.
+void CWinSystemGbm::TakeHDRDepthLeftover(CDRMConnector& connector)
+{
+  m_hdrDepthCapped = false;
+  if (!m_hdrDepthChoice)
+    return;
+  const auto limits = connector.GetRangePropertyLimits("max bpc");
+  const auto value = connector.ReadPropertyValue("max bpc");
+  if (limits && value && *value == 8 && limits->second > 8)
+  {
+    m_hdrDepthCapped = true;
+    CLog::Log(LOGINFO, "HDR output: {} was left at 8 bits (max bpc) by a session before; it is put "
+                       "back to {} with the next change of mode",
+              connector.GetName(), limits->second);
+  }
+}
