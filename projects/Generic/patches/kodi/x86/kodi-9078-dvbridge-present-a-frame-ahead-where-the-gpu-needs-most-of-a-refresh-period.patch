+bool CWinSystemGbmGLESContext::DVAheadWanted()
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  // Between transport frames only: the first one sets the output up, in a commit that waits.
+  // And not while the output is meant to be off: the kernel refuses a commit that asks to be
+  // told of its flip on an output that is off and stays off.
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!m_eglFence || !drm || !drm->IsActive() || !m_dvState.TransportLive())
+    return false;
+  if (!m_dvAheadModeRead)
+  {
+    m_dvAheadModeRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+    const bool on = !settings ||
+                    !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVAHEAD) ||
+                    settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVAHEAD);
+    m_dvAheadMode = !on                                          ? CDVAhead::Mode::NEVER
+                    : advanced && advanced->m_videoDVAheadAlways ? CDVAhead::Mode::ALWAYS
+                                                                 : CDVAhead::Mode::NEEDED;
+  }
+  return m_dvAhead.Wanted(m_dvAheadMode, DVRefreshPeriodMs());
+#else
+  return false;
+#endif
+}
