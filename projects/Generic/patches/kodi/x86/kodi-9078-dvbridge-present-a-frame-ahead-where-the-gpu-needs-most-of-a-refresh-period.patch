diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
new file mode 100644
index 0000000..c3d6d44
--- /dev/null
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -0,0 +1,197 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cmath>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Whether the frames of native Dolby Vision output are presented a frame ahead
+ *
+ * A Dolby Vision frame used to be presented the way that waits: for the GPU to finish the
+ * frame, and then for the commit that shows it, which returns with the flip. The frame after
+ * it could only be drawn from then on, so the GPU had one refresh period for each frame, less
+ * what the rest of the loop takes. Where a frame takes most of that (the reconstruction of a
+ * 2160p picture with its enhancement layer on an integrated GPU: 30 to 37 ms of the 41.7 ms
+ * of a film refresh) any frame that takes a little longer misses its refresh.
+ *
+ * Presented a frame ahead, a frame is handed to the kernel with the fence of its GPU work in
+ * a commit that does not wait (the means that Kodi has for its ordinary frames), and the next
+ * frame is drawn while that one waits for its refresh: a frame then has up to two periods.
+ * The price is that a frame is chosen one period earlier, which the render manager is told
+ * (CWinSystemGbmGLESContext::GetFrameLatencyAdjustment()), so that the GUI over the video is
+ * one frame later. It is therefore done where the frames call for it, and not elsewhere,
+ * unless it is asked for always.
+ *
+ * This class only decides. A frame that cannot be presented a frame ahead is presented the
+ * way that waits, by the window system, and is told here: after a few of them that come
+ * close together nothing is tried again in that native output, and after a few such
+ * outputs, not until Kodi starts again.
+ */
+class CDVAhead
+{
+public:
+  enum class Mode
+  {
+    NEEDED, //!< where the frames take a large part of the refresh period
+    ALWAYS, //!< wherever it can be done (advancedsettings.xml, video/dvaheadalways: to try it)
+    NEVER,
+  };
+
+  enum class Change
+  {
+    NONE,
+    NEEDED,
+    NOT_NEEDED,
+  };
+
+  /*!
+   * \brief The GPU time of a frame of a video that is playing
+   * \return what the average of the last frames changed, to be logged
+   */
+  Change Measured(double ms, double periodMs)
+  {
+    if (!(ms > 0.0) || !(periodMs > 0.0))
+      return Change::NONE;
+    // Frames at another refresh rate are another matter: what was found says nothing of them.
+    if (!SamePeriod(periodMs, m_windowPeriod))
+    {
+      m_windowPeriod = periodMs;
+      m_count = 0;
+      m_sum = 0.0;
+    }
+    m_sum += ms;
+    if (++m_count < WINDOW)
+      return Change::NONE;
+    m_average = m_sum / m_count;
+    m_count = 0;
+    m_sum = 0.0;
+    const bool needed = Needed(periodMs);
+    if (!needed && m_average >= HEAVY * periodMs)
+    {
+      m_needed = true;
+      m_neededPeriod = periodMs;
+      return Change::NEEDED;
+    }
+    if (needed && m_average <= LIGHT * periodMs)
+    {
+      m_needed = false;
+      return Change::NOT_NEEDED;
+    }
+    return Change::NONE;
+  }
+
+  //! The average that Measured() last decided with
+  double Average() const { return m_average; }
+
+  //! The frames at this refresh rate call for it, as far as they have been measured. Kept from
+  //! one video to the next: the first frames of the next one then have it too.
+  bool Needed(double periodMs) const { return m_needed && SamePeriod(periodMs, m_neededPeriod); }
+
+  //! Whether the next frame is to be presented a frame ahead
+  bool Wanted(Mode mode, double periodMs) const
+  {
+    if (mode == Mode::NEVER || m_off || m_gone || !(periodMs > 0.0))
+      return false;
+    return mode == Mode::ALWAYS || Needed(periodMs);
+  }
+
+  /*!
+   * \brief A frame could not be presented a frame ahead
+   * \param forGood for a reason that does not pass (the output has too few buffers)
+   * \return this was the last time: it is not tried again in this native output, or with
+   *         forGood until Kodi starts again
+   */
+  bool Failed(bool forGood = false)
+  {
+    if (m_gone)
+      return false;
+    if (forGood)
+    {
+      m_gone = true;
+      return true;
+    }
+    m_since = 0;
+    if (m_off || ++m_failures < FAILURES)
+      return false;
+    m_off = true;
+    return true;
+  }
+
+  //! A frame was presented a frame ahead
+  void Presented()
+  {
+    m_presented = true;
+    // A minute of them: the failures before it are forgotten. What gives it up is three
+    // that come close together, not three in a film.
+    if (m_failures > 0 && ++m_since >= WORKED)
+    {
+      m_failures = 0;
+      m_since = 0;
+    }
+  }
+
+  /*!
+   * \brief The native output ended: the next one tries again
+   * \return ... unless too many in a row gave it up: not until Kodi starts again
+   */
+  bool Ended()
+  {
+    bool gone = false;
+    if (m_off && !m_gone)
+      gone = m_gone = ++m_outputsOff >= OUTPUTS;
+    else if (m_presented)
+      m_outputsOff = 0; // one that had it to its end
+    m_off = false;
+    m_failures = 0;
+    m_since = 0;
+    m_presented = false;
+    m_count = 0;
+    m_sum = 0.0;
+    return gone;
+  }
+
+  //! Given up, in this native output or until Kodi starts again
+  bool Off() const { return m_off || m_gone; }
+
+private:
+  static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
+
+  static constexpr unsigned int WINDOW = 24; //!< frames of an average (a second of film)
+  //! part of the refresh period from which the frames call for it: with half the period left,
+  //! a frame that takes half as long again is still in time without it
+  static constexpr double HEAVY = 0.5;
+  static constexpr double LIGHT = 0.35; //!< ... and under which they no longer do
+  static constexpr unsigned int FAILURES = 3; //!< frames that give it up for a native output
+  static constexpr unsigned int WORKED = 1440; //!< frames (a minute of film) that forget them
+  static constexpr unsigned int OUTPUTS = 3; //!< such outputs in a row that give it up for good
+
+  unsigned int m_count = 0;
+  double m_sum = 0.0;
+  double m_windowPeriod = 0.0;
+  double m_average = 0.0;
+  bool m_needed = false;
+  double m_neededPeriod = 0.0;
+  unsigned int m_failures = 0;
+  unsigned int m_since = 0; //!< frames presented a frame ahead since the last failure
+  bool m_presented = false;
+  unsigned int m_outputsOff = 0;
+  bool m_off = false;
+  bool m_gone = false;
+};
