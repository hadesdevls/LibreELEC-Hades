+bool CWinSystemGbmGLESContext::DVAheadFence()
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  // A fence has its file once the commands before it are flushed.
+  m_eglFence->CreateGPUFence();
+  glFlush();
+  const int fence = m_eglFence->FlushFence();
+  if (fence >= 0)
+  {
+    m_DRM->SetInFenceFd(fence);
+    return true;
+  }
+  DVAheadFailed("the GPU gave no fence for it");
+#endif
+  return false;
+}
+
+void CWinSystemGbmGLESContext::DVAheadFlipped(int64_t ns)
+{
+  // The time between the flips of two frames in a row, as the kernel tells them: what says
+  // whether a refresh was missed while frames are presented a frame ahead, where the time that
+  // a presentation takes says little.
+  if (ns > 0 && m_dvAheadLastFlipNs > 0 && ns > m_dvAheadLastFlipNs)
+  {
+    const double gapMs = static_cast<double>(ns - m_dvAheadLastFlipNs) / 1e6;
+    m_dvStats.flips++;
+    m_dvStats.flipGapMaxMs = std::max(m_dvStats.flipGapMaxMs, gapMs);
+    if (const double periodMs = DVRefreshPeriodMs(); periodMs > 0 && gapMs > 1.5 * periodMs)
+      m_dvStats.flipsLate++;
+  }
+  m_dvAheadLastFlipNs = ns;
+}
+
+void CWinSystemGbmGLESContext::DVAheadEnd(bool presented, const DVFlip& flip)
+{
+  // A commit that is refused without its fences too says nothing of them: the output does
+  // not take the frame at all (see DVBridgeFrameShown()).
+  if (flip.refused && presented)
+    DVAheadFailed("the commit was refused with the fence of the frame");
+  // (the times between flips are those of frames presented a frame ahead one after the other)
+  if (!presented || !flip.ahead)
+    m_dvAheadLastFlipNs = 0;
+  if (!presented)
+    return;
+  bool ahead = flip.ahead;
+  m_dvAheadPending = ahead;
+  m_dvAheadLost = false;
+  if (ahead)
+  {
+    m_dvAhead.Presented();
+    m_dvStats.ahead++;
+    // The next frame is drawn while the buffer of this one and the one on the screen are kept:
+    // that takes a third one. Without it, the flip of this frame is waited for after all.
+    auto& surface = m_GBM->GetDevice().GetSurface();
+    if (!surface.HasFreeBuffers())
+    {
+      if (const int flipNow = m_DRM->TakeOutFenceFd();
+          flipNow >= 0 && WaitFence(flipNow, DV_FLIP_WAIT_MS))
+      {
+        surface.ReleaseRetiredBuffer();
+        m_dvAheadPending = false;
+      }
+      ahead = false;
+      DVAheadFailed("the output has no third buffer", true);
+    }
+  }
+  if (ahead != m_dvAheadShown)
+  {
+    m_dvAheadShown = ahead;
+    m_dvAheadLatencyMs = ahead ? -static_cast<float>(DVRefreshPeriodMs()) : 0.0f;
+    CLog::Log(LOGINFO, "DVBridge: frames are {} presented a frame ahead",
+              ahead ? "now" : "no longer");
+  }
+}
+
+void CWinSystemGbmGLESContext::DVAheadFailed(const char* what, bool forGood)
+{
+  const bool last = m_dvAhead.Failed(forGood);
+  CLog::Log(LOGWARNING,
+            "DVBridge: a frame could not be presented a frame ahead ({}); it is presented the way "
+            "that waits{}",
+            what,
+            !last     ? ""
+            : forGood ? ", and so are all frames until Kodi is started again"
+                      : ", and so are the frames after it in this video");
+}
+
+void CWinSystemGbmGLESContext::FinishDVBridgeRendering()
+{
+  glFinish();
+}
+
+void CWinSystemGbmGLESContext::WaitDVBridgeFlip()
+{
+  m_dvAheadLastFlipNs = 0;
+  if (!m_dvAheadPending)
+    return;
+  if (const int flip = m_DRM->TakeOutFenceFd(); flip >= 0 && WaitFence(flip, DV_FLIP_WAIT_MS))
+    m_dvAheadPending = false;
+}
