From ae386a68d3552c051d3f7c614900fc8d8df0e6bc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 01:37:49 +0000
Subject: [PATCH] MultiviewChoice: what is decided about a 3D Blu-ray disc

A 3D Blu-ray has its second view in a clip of its own, beside the clip that every player
plays, and the three commits before this one read it. They do it for every disc and every
display: the player profile is no longer announced, the playlists of a disc are compared by
their second view, and a disc that declares 3D content gets another demuxer.

Here is what decides where that happens, and nothing else, next to what decides it for a
file. The second view of a disc is wanted where the setting for the two views has them
decoded on this display, this build has the decoder of both views, and the user does not
have stereoscopic videos played as 2D (DiscWanted()). Where it is not wanted, each of the
functions says "as before": the profile is announced before the disc is opened
(ProfileBeforeOpen()), the disc is read by the demuxer of every disc (DiscSecondView()), and
no playlist counts as one with a second view (PlaylistSecondView()). Where it is wanted, a
disc that turns out to declare no 3D content has the profile announced once it is open
(ProfileAfterOpen()), so that it too finds the registers that it always found.

Also the eye of the base view by the flag of the playlist, and how much of the second view
may be read for one picture of the base view before that picture goes on alone.

Nothing uses them yet.
---
 xbmc/cores/VideoPlayer/MultiviewChoice.h | 88 ++++++++++++++++++++++++
 1 file changed, 88 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index a37b99f..c13673e 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -457,6 +457,94 @@ inline std::optional<BaseEye> TwoViews(const Track& track)
 
 //! @}
 
+/*!
+ * \name The disc
+ * @{
+ */
+
+/*!
+ * \brief What is known before a Blu-ray disc is opened
+ *
+ * A 3D Blu-ray has its second view in a clip of its own, beside the clip that every player
+ * plays. That clip is read where both views of a file would be decoded, and only there.
+ */
+struct Player
+{
+  bool allowed{false}; //!< the setting has both views decoded on this display (Allowed())
+  bool decoder{false}; //!< this build has the decoder that outputs both views
+  bool mono{false}; //!< the user has stereoscopic videos played as 2D (their playback mode)
+};
+
+/*!
+ * \brief Whether the second view of a 3D Blu-ray disc is wanted
+ *
+ * Everything has to hold. Where it does not, a disc is opened, listed and played as it always
+ * was, whatever it holds: each of the functions below says "as before" then.
+ */
+constexpr bool DiscWanted(const Player& player)
+{
+  return player.allowed && player.decoder && !player.mono;
+}
+
+/*!
+ * \brief Whether the player profile is announced before the disc is opened, as it always was
+ *
+ * Kodi announces the profile of a UHD player (profile 6) before it opens a disc. The library
+ * that plays the disc gives a 3D disc the registers of a 3D player (profile 5) when it reads
+ * the index of the disc, but not over a profile that was announced: the disc then takes the
+ * player for one without 3D, which is what happens today. Only where the second view is wanted
+ * is the profile held back until the disc has said what it is.
+ */
+constexpr bool ProfileBeforeOpen(bool wanted)
+{
+  return !wanted;
+}
+
+/*!
+ * \brief Whether the profile that was held back is announced once the disc is open
+ *
+ * For every disc that does not declare 3D content: before anything of it plays it has the
+ * registers that it always had. A disc that declares 3D content keeps what the library gave it.
+ */
+constexpr bool ProfileAfterOpen(bool wanted, bool declares3D)
+{
+  return wanted && !declares3D;
+}
+
+/*!
+ * \brief Whether a disc is read by the demuxer that reads the second view too
+ * \param fileinfo the disc is opened for its details or a thumbnail, not to be played
+ */
+constexpr bool DiscSecondView(bool wanted, bool declares3D, bool fileinfo)
+{
+  return wanted && declares3D && !fileinfo;
+}
+
+/*!
+ * \brief Whether what a playlist says of its second view counts when the playlists of a disc
+ *        are compared (whether two are the same presentation, and which of two is kept)
+ *
+ * Where it does not, a playlist with a second view is compared as the playlist without one
+ * that it was until now.
+ */
+constexpr bool PlaylistSecondView(bool wanted)
+{
+  return wanted;
+}
+
+//! The eye of the base view, by the flag of the playlist (MVC_Base_view_R_flag)
+constexpr BaseEye BaseEyeOfPlaylist(bool baseViewIsRight)
+{
+  return baseViewIsRight ? BaseEye::RIGHT : BaseEye::LEFT;
+}
+
+//! Access units of the second view that are read for one picture of the base view, after which
+//! that picture goes on without its second view. The clip of the second view is placed up to
+//! 13 seconds before the base view, which at 60 pictures a second is 780 of them.
+inline constexpr unsigned int DISC_READS_PER_PICTURE = 1024;
+
+//! @}
+
 /*!
  * \name The pictures
  * @{
-- 
