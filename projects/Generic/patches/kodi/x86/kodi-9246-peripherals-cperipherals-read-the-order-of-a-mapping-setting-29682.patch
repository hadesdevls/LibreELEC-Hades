From cd93c137cc8a390f57135d8985a3b87b7e8aefac Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Sat, 10 Oct 2026 20:47:14 +0100
Subject: [PATCH] [peripherals][CPeripherals] Read the order of a mapping
 setting (#29682)

The tinyxml2 migration in 567960ee8e replaced TinyXML's
Attribute("order", &iOrder), which read the value, with tinyxml2's
Attribute("order", "0"), which only tests whether the attribute equals
"0". iOrder stayed 0 and every setting was added at the end, so a
device's settings appeared in file order whatever its mapping asked for.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 0939c0f8244885540181cf47e7fdaee39fc337ad)
---
 xbmc/peripherals/Peripherals.cpp                 |  2 +-
 xbmc/peripherals/test/TestPeripheralMappings.cpp | 14 ++++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/xbmc/peripherals/Peripherals.cpp b/xbmc/peripherals/Peripherals.cpp
index c41d16c..75f5029 100644
--- a/xbmc/peripherals/Peripherals.cpp
+++ b/xbmc/peripherals/Peripherals.cpp
@@ -686,7 +686,7 @@ void CPeripherals::GetSettingsFromMappingsFile(
 
       /* set the order */
       int iOrder = 0;
-      currentNode->Attribute("order", std::to_string(iOrder).c_str());
+      currentNode->QueryIntAttribute("order", &iOrder);
       /* if the order attribute is invalid or 0, then the setting will be added at the end */
       if (iOrder < 0)
         iOrder = 0;
diff --git a/xbmc/peripherals/test/TestPeripheralMappings.cpp b/xbmc/peripherals/test/TestPeripheralMappings.cpp
index 7e28b8d..8db29c9 100644
--- a/xbmc/peripherals/test/TestPeripheralMappings.cpp
+++ b/xbmc/peripherals/test/TestPeripheralMappings.cpp
@@ -64,3 +64,17 @@ TEST_F(TestPeripheralMappings, SkipsASettingWithoutAKey)
   EXPECT_EQ(1u, settings->size());
   EXPECT_TRUE(settings->contains("enabled"));
 }
+
+TEST_F(TestPeripheralMappings, ReadsTheOrderOfASetting)
+{
+  const auto settings = SettingsFrom(R"(<peripheral>
+                                          <setting key="first" type="bool" value="1" label="1" order="2"/>
+                                          <setting key="second" type="bool" value="1" label="2" order="1"/>
+                                        </peripheral>)");
+
+  ASSERT_TRUE(settings.has_value()) << "reading the settings did not finish";
+  ASSERT_TRUE(settings->contains("first"));
+  ASSERT_TRUE(settings->contains("second"));
+  EXPECT_EQ(2, settings->at("first").m_order);
+  EXPECT_EQ(1, settings->at("second").m_order);
+}
