diff --git a/xbmc/utils/test/TestSampledValues.cpp b/xbmc/utils/test/TestSampledValues.cpp
new file mode 100644
index 0000000..a1ac1e6
--- /dev/null
+++ b/xbmc/utils/test/TestSampledValues.cpp
@@ -0,0 +1,66 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "utils/SampledValues.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+using KODI::UTILS::CSampledValues;
+
+TEST(TestSampledValues, ReadsOnceAnInterval)
+{
+  CSampledValues values(500);
+  int reads = 0;
+  auto read = [&reads] { return std::to_string(++reads); };
+
+  // a frame every 16 ms for two seconds: the text changes four times, not 125
+  std::string last;
+  int changes = 0;
+  for (uint32_t now = 1000; now < 3000; now += 16)
+  {
+    const std::string text = values.Get(7, now, read);
+    if (text != last)
+    {
+      ++changes;
+      last = text;
+    }
+  }
+  EXPECT_EQ(4, changes);
+  EXPECT_EQ(4, reads);
+}
+
+TEST(TestSampledValues, ValuesAreIndependent)
+{
+  CSampledValues values(500);
+  EXPECT_EQ("a", values.Get(1, 100, [] { return std::string("a"); }));
+  EXPECT_EQ("b", values.Get(2, 100, [] { return std::string("b"); }));
+  EXPECT_EQ("a", values.Get(1, 200, [] { return std::string("x"); }));
+  EXPECT_EQ("b", values.Get(2, 200, [] { return std::string("y"); }));
+  EXPECT_EQ("x", values.Get(1, 600, [] { return std::string("x"); }));
+  EXPECT_EQ("b", values.Get(2, 599, [] { return std::string("z"); }));
+}
+
+TEST(TestSampledValues, TheClockMayWrap)
+{
+  CSampledValues values(500);
+  EXPECT_EQ("a", values.Get(1, 0xFFFFFF00u, [] { return std::string("a"); }));
+  // 0x100 ms later, across the wrap: still inside the interval
+  EXPECT_EQ("a", values.Get(1, 0x00000000u, [] { return std::string("b"); }));
+  // 0x200 ms later: out of it
+  EXPECT_EQ("c", values.Get(1, 0x00000100u, [] { return std::string("c"); }));
+}
+
+TEST(TestSampledValues, ResetReadsAgain)
+{
+  CSampledValues values(500);
+  EXPECT_EQ("a", values.Get(1, 100, [] { return std::string("a"); }));
+  values.Reset();
+  EXPECT_EQ("b", values.Get(1, 110, [] { return std::string("b"); }));
+}
