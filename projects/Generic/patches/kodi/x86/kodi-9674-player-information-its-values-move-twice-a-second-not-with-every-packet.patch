diff --git a/xbmc/utils/SampledValues.h b/xbmc/utils/SampledValues.h
new file mode 100644
index 0000000..0c4e9d1
--- /dev/null
+++ b/xbmc/utils/SampledValues.h
@@ -0,0 +1,63 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace KODI::UTILS
+{
+
+//! \brief Values that the GUI reads on every frame but that need not be read that often.
+//!
+//! The fill of the queues of the player and the live bit rates change with every packet of the
+//! stream. A label that shows one of them has a new text on almost every frame, so the skin marks
+//! it dirty and the whole GUI is drawn again, on every frame, while the player information is
+//! open. Here such a value is read at most once in an interval (500 ms) and the text of the
+//! last reading is given in between, so that a label changes twice a second.
+class CSampledValues
+{
+public:
+  explicit CSampledValues(uint32_t intervalMs = 500) : m_intervalMs(intervalMs) {}
+
+  //! \brief The text of value \a id. \a read is called, to make it, when there is none yet or
+  //!        the last one is \a intervalMs old or older. \a nowMs is any clock in ms that goes
+  //!        forward (it may wrap: an interval is taken as the difference of unsigned values).
+  template<typename Read>
+  std::string Get(int id, uint32_t nowMs, Read&& read)
+  {
+    std::unique_lock lock(m_mutex);
+    auto it = m_values.find(id);
+    if (it != m_values.end() && static_cast<uint32_t>(nowMs - it->second.first) < m_intervalMs)
+      return it->second.second;
+    // not called under the lock: a reading may take a lock of its own
+    lock.unlock();
+    std::string text = read();
+    lock.lock();
+    m_values[id] = {nowMs, text};
+    return text;
+  }
+
+  //! \brief Forgets every value (a new playback starts: the first reading is a new one).
+  void Reset()
+  {
+    std::unique_lock lock(m_mutex);
+    m_values.clear();
+  }
+
+private:
+  const uint32_t m_intervalMs;
+  std::mutex m_mutex;
+  std::map<int, std::pair<uint32_t, std::string>> m_values;
+};
+
+} // namespace KODI::UTILS
