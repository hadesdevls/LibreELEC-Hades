 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 59 +++++------
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 11 +--
 3 files changed, 132 insertions(+), 37 deletions(-)
 create mode 100644 xbmc/windowing/gbm/FlipStallRecovery.h

diff --git a/xbmc/windowing/gbm/FlipStallRecovery.h b/xbmc/windowing/gbm/FlipStallRecovery.h
new file mode 100644
index 0000000..dc78d8b
--- /dev/null
+++ b/xbmc/windowing/gbm/FlipStallRecovery.h
@@ -0,0 +1,99 @@
+/*
