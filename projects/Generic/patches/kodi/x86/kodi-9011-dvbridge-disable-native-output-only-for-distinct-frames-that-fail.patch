From 88c705cc6d0400bd5a8e0364cdf6ec4abdaf5c1e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 02:54:10 +0000
Subject: [PATCH] dvbridge: disable native output only for distinct frames that
 fail

Two cases turned a passing condition into the ordinary output for the
rest of the playback or of the Kodi session:

- ConfigChanged() reconfigured the renderer for the ordinary output as
  soon as one picture did not request native output, which includes a
  single picture whose RPU FFmpeg could not parse. The ordinary
  renderer never returns to native output during the playback, so one
  bad RPU meant HDR10 until the end. Reconfigure only when native output
  was disabled for the session; a picture without Dolby Vision metadata
  is just not drawn, and the decoder moves a stream whose metadata stays
  missing to the ordinary output by changing its hdrType.
- Every attempt to draw a frame counted towards the 24 failures over two
  seconds that disable native output until Kodi restarts. Since Kodi 22
  (xbmc/xbmc#28939) a flush that saves the buffers keeps the last frame,
  which is then drawn again on every GUI refresh while paused, for
  example after a mode change. Count a frame that cannot be shown once,
  by its pts, so that only distinct frames failing in a row disable
  native output.
---
 .../HwDecRender/RendererVAAPIGLES.cpp               | 11 ++++++++---
 .../VideoRenderers/LinuxRendererGLES.cpp            | 13 +++++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp      | 11 +++++++++--
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h        |  6 +++++-
 4 files changed, 31 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 8f1faad..bdb5123 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -123,9 +123,14 @@ bool CRendererVAAPIGLES::Configure(const VideoPicture& picture, float fps, unsig
 bool CRendererVAAPIGLES::ConfigChanged(const VideoPicture& picture)
 {
 #ifdef HAVE_DVBRIDGE
-  // Native Dolby Vision was given up during playback: reconfigure for the ordinary output.
-  if (m_dvRequested && !KODI::WINDOWING::GBM::CWinSystemGbmGLESContext::DVBridgeRequested(&picture))
-    return true;
+  // Native Dolby Vision was disabled during playback: reconfigure for the ordinary output.
+  // A single picture without Dolby Vision metadata is only not drawn; the decoder moves a
+  // stream whose metadata stays missing to the ordinary output by changing its hdrType.
+  if (m_dvRequested)
+    if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+            CServiceBroker::GetWinSystem());
+        window && window->NativeDVOutputDisabled())
+      return true;
 #endif
   CVaapiRenderPicture *pic = dynamic_cast<CVaapiRenderPicture*>(picture.videoBuffer);
   if ((pic->procPic.videoSurface != VA_INVALID_ID && !m_isVAAPIBuffer) ||
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 535d311..0cc2b0a 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -267,9 +267,14 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
 bool CLinuxRendererGLES::ConfigChanged(const VideoPicture &picture)
 {
 #ifdef HAVE_DVBRIDGE
-  // Native Dolby Vision was given up during playback: reconfigure for the ordinary output.
-  if (m_dvRequested && !KODI::WINDOWING::GBM::CWinSystemGbmGLESContext::DVBridgeRequested(&picture))
-    return true;
+  // Native Dolby Vision was disabled during playback: reconfigure for the ordinary output.
+  // A single picture without Dolby Vision metadata is only not drawn; the decoder moves a
+  // stream whose metadata stays missing to the ordinary output by changing its hdrType.
+  if (m_dvRequested)
+    if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+            CServiceBroker::GetWinSystem());
+        window && window->NativeDVOutputDisabled())
+      return true;
 #endif
   if (picture.videoBuffer->GetFormat() != m_format)
   {
@@ -1249,7 +1254,7 @@ bool CLinuxRendererGLES::Render(unsigned int flags, int index)
     if (!rendered)
       if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
               CServiceBroker::GetWinSystem()))
-        window->DVBridgeFrameShown(false);
+        window->DVBridgeFrameShown(false, m_buffers[index].doviPts);
     AfterRenderHook(index);
     return rendered;
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index d4f4ab4..ee99870 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -222,7 +222,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         m_dvStats.notShown++;
       if (m_dvSignalling && now - m_dvStats.start >= std::chrono::seconds(10))
         LogDVStats("last 10 s");
-      DVBridgeFrameShown(presented);
+      DVBridgeFrameShown(presented, m_dvFramePts);
     }
     return;
   }
@@ -640,6 +640,7 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
                                             dvbridge_geometry geometry)
 {
   m_dvFrame = false;
+  m_dvFramePts = layer.pts;
   if (!BeginDVBridge())
     return false;
   const bool overlayFree = m_guiWillRender && GetGUIElementCount() == 0 && !m_dvOverlays;
@@ -935,7 +936,7 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   m_dvStats.hasLastShown = hasLastShown;
 }
 
-void CWinSystemGbmGLESContext::DVBridgeFrameShown(bool shown)
+void CWinSystemGbmGLESContext::DVBridgeFrameShown(bool shown, double pts)
 {
   // Give up only on a sustained failure: 24 frames in a row that could not be shown, over at
   // least two seconds, so that a short hiccup (start, seek) never disables native output.
@@ -944,8 +945,14 @@ void CWinSystemGbmGLESContext::DVBridgeFrameShown(bool shown)
   if (shown)
   {
     m_dvFailedFrames = 0;
+    m_dvLastFailedPts = DVD_NOPTS_VALUE;
     return;
   }
+  // The same picture drawn again (paused, or kept by a flush that saves the buffers since
+  // Kodi 22) counts once: only distinct frames that cannot be shown mean a broken output.
+  if (pts != DVD_NOPTS_VALUE && pts == m_dvLastFailedPts)
+    return;
+  m_dvLastFailedPts = pts;
   const auto now = std::chrono::steady_clock::now();
   if (m_dvFailedFrames++ == 0)
     m_dvFirstFailedFrame = now;
