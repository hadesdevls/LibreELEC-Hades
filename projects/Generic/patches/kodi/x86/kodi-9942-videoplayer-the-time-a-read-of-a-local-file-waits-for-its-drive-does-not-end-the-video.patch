   bool Aborted();
 
+  /*!
+   * \brief Hades: around each read of the input by libavformat (dvd_file_read()). The time that a
+   *        read of a local file waits for its drive does not count against m_timeout, which would
+   *        end the video with the data back (DemuxReadStall.h).
+   */
+  void InputReadBegins();
+  void InputReadEnded();
+
   /*!
    * \brief The plane offset metadata an H.264 MVC stream carries in its dependent view,
    *        for placing subtitles in depth. Null until such a stream has been added; the
@@ -250,6 +262,13 @@ protected:
   bool m_loggedOffsetMetadataMissing{false};
 
   XbmcThreads::EndTime<> m_timeout;
+  //! Hades: Abort() was called; Aborted() answers true from then on, whatever sets m_timeout
+  std::atomic<bool> m_abortRequested{false};
+  //! Hades: InputReadBegins() and InputReadEnded()
+  bool m_inputLocalFile{false};
+  CDemuxReadStall m_readStall;
+  std::optional<std::chrono::steady_clock::time_point> m_readStallToldAt;
+  unsigned int m_readStallsUntold{0};
 
   // Due to limitations of ffmpeg, we only can detect a program change
   // with a packet. This struct saves the packet for the next read and
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h
new file mode 100644
index 0000000..b9a2a7e
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h
@@ -0,0 +1,67 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// The time that a read of the input waits for its drive, given back to the deadline of the
+// demuxer. CDVDDemuxFFmpeg gives libavformat a deadline for each packet (20 s; 30 s to open a
+// file), and its read callback takes a deadline that has passed for an abort (AVERROR_EXIT). A
+// read of a local file that its drive does not answer waits in the kernel, where nothing
+// interrupts it: a USB drive that stops answering is reset by the kernel after its 30 s command
+// timeout, and the read then gets its data (the page cache reads again what the reset failed).
+// The deadline had passed meanwhile, so the next callback for the same packet answered
+// AVERROR_EXIT, libavformat's Matroska demuxer took the error for the end of its input, and the
+// player ended the video with the data back (issue #16: "eof reading from demuxer" 1 s after the
+// reset, with the input not at its end).
+
+#include "threads/SystemClock.h"
+
+#include <chrono>
+
+class CDemuxReadStall
+{
+public:
+  //! A read that waits this long or more has waited for its drive, not for the demuxer: the reads
+  //! of a file take milliseconds
+  static constexpr std::chrono::milliseconds STALL{1000};
+
+  //! Before a read of the input: what the deadline has left, when it runs.
+  void Begin(const XbmcThreads::EndTime<>& deadline)
+  {
+    m_start = std::chrono::steady_clock::now();
+    m_total = deadline.GetInitialTimeoutValue();
+    m_running =
+        m_total != XbmcThreads::EndTime<>::Max() && m_total > std::chrono::milliseconds::zero();
+    m_left = m_running ? deadline.GetTimeLeft() : std::chrono::milliseconds::zero();
+  }
+
+  /*!
+   * \brief After the read. When it waited STALL or more, the deadline runs again from now with
+   *        what it had left before the read: the wait does not count against it. Nothing changes
+   *        when an abort was asked for (the deadline stays as the abort left it), when the deadline
+   *        was set anew during the read (an abort sets it to zero), or when it was not running.
+   * \return how long the read waited when its time was given back, zero otherwise
+   */
+  std::chrono::milliseconds End(XbmcThreads::EndTime<>& deadline, bool aborted)
+  {
+    const auto waited = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - m_start);
+    if (!m_running || waited < STALL || aborted || deadline.GetInitialTimeoutValue() != m_total ||
+        m_left <= std::chrono::milliseconds::zero())
+      return std::chrono::milliseconds::zero();
+
+    deadline.Set(m_left);
+    return waited;
+  }
+
+private:
+  std::chrono::steady_clock::time_point m_start;
+  std::chrono::milliseconds m_total{0};
+  std::chrono::milliseconds m_left{0};
+  bool m_running{false};
+};
