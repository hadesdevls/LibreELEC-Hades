 .../VideoPlayer/DVDDemuxers/CMakeLists.txt    |  1 +
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 46 ++++++++++++-
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  | 19 ++++++
 .../VideoPlayer/DVDDemuxers/DemuxReadStall.h  | 67 +++++++++++++++++++
 4 files changed, 132 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/cores/VideoPlayer/DVDDemuxers/DemuxReadStall.h

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt b/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
index e8e58a8..2463d92 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/CMakeLists.txt
@@ -21,6 +21,7 @@ endif()
 
 set(HEADERS BlurayOffsetMetadata.h
             DemuxMultiSource.h
+            DemuxReadStall.h
             DVDDemux.h
             DVDDemuxBXA.h
             DVDDemuxCC.h
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 2842570..f792547 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -180,8 +180,11 @@ static int dvd_file_read(void* h, uint8_t* buf, int size)
   if (interrupt_cb(h))
     return AVERROR_EXIT;
 
-  std::shared_ptr<CDVDInputStream> pInputStream = static_cast<CDVDDemuxFFmpeg*>(h)->m_pInput;
+  CDVDDemuxFFmpeg* demuxer = static_cast<CDVDDemuxFFmpeg*>(h);
+  std::shared_ptr<CDVDInputStream> pInputStream = demuxer->m_pInput;
+  demuxer->InputReadBegins();
   int len = pInputStream->Read(buf, size);
+  demuxer->InputReadEnded();
   if (len == 0)
     return AVERROR_EOF;
   else
@@ -233,6 +236,9 @@ CDVDDemuxFFmpeg::~CDVDDemuxFFmpeg()
 
 bool CDVDDemuxFFmpeg::Aborted()
 {
+  if (m_abortRequested)
+    return true;
+
   if (m_timeout.IsTimePast())
     return true;
 
@@ -243,6 +249,37 @@ bool CDVDDemuxFFmpeg::Aborted()
   return false;
 }
 
+void CDVDDemuxFFmpeg::InputReadBegins()
+{
+  if (m_inputLocalFile)
+    m_readStall.Begin(m_timeout);
+}
+
+void CDVDDemuxFFmpeg::InputReadEnded()
+{
+  if (!m_inputLocalFile)
+    return;
+
+  const std::chrono::milliseconds waited = m_readStall.End(m_timeout, m_abortRequested);
+  if (waited <= std::chrono::milliseconds::zero())
+    return;
+
+  // a line a minute at most: a drive that answers slowly would write one for each read
+  const auto now = std::chrono::steady_clock::now();
+  if (m_readStallToldAt && now - *m_readStallToldAt < std::chrono::minutes(1))
+  {
+    ++m_readStallsUntold;
+    return;
+  }
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: a read of {} waited {} ms for its drive; that wait does not count "
+            "against the time the demuxer has for a packet, whose end would be taken for an abort "
+            "and end the video ({} more such reads since the last line)",
+            CURL::GetRedacted(m_pInput->GetFileName()), waited.count(), m_readStallsUntold);
+  m_readStallToldAt = now;
+  m_readStallsUntold = 0;
+}
+
 bool CDVDDemuxFFmpeg::IsStreaming() const
 {
   if (m_pInput && m_pInput->IsStreaming())
@@ -281,6 +318,12 @@ bool CDVDDemuxFFmpeg::Open(const std::shared_ptr<CDVDInputStream>& pInput, bool
   m_pInput = pInput;
   strFile = m_pInput->GetFileName();
 
+  // Hades: a read of a local file that waits for its drive (DemuxReadStall.h)
+  m_abortRequested = false;
+  m_inputLocalFile = m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE) && URIUtils::IsHD(strFile);
+  m_readStallToldAt.reset();
+  m_readStallsUntold = 0;
+
   if (!m_pInput->GetContent().empty())
   {
     std::string content = m_pInput->GetContent();
@@ -892,6 +935,7 @@ void CDVDDemuxFFmpeg::Flush()
 
 void CDVDDemuxFFmpeg::Abort()
 {
+  m_abortRequested = true;
   m_timeout.SetExpired();
 }
 
