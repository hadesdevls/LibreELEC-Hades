From 959fb5b6db8db4d0879a17e3baa0e9909415ac22 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 27 Oct 2026 21:46:53 -0700
Subject: [PATCH] [tests] Stabilize TCP server tests on Windows

Prevent shared-port collisions between parallel CTest processes. Ensure
JSON-RPC setup is complete and flood serialization does not consume the
announcement delivery deadline.
---
 CMakeLists.txt                      |   7 +
 xbmc/network/TCPServer.h            |   2 +
 xbmc/network/test/TestTCPServer.cpp | 243 +++++++++++++++++++++-------
 3 files changed, 196 insertions(+), 56 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6a72e7a..1324ea9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -618,6 +618,13 @@ if(HOST_CAN_EXECUTE_TARGET AND ENABLE_TESTING)
   # Enable unit-test related targets
   enable_testing()
   gtest_add_tests(${APP_NAME_LC}-test "" ${test_sources})
+  # Windows permits concurrent servers to bind the listening port these tests share.
+  get_property(tcp_server_tests DIRECTORY PROPERTY TESTS)
+  list(FILTER tcp_server_tests INCLUDE REGEX "^TestTCPServer\\.")
+  if(tcp_server_tests)
+    set_tests_properties(${tcp_server_tests} PROPERTIES RESOURCE_LOCK tcp_server_port)
+  endif()
+  unset(tcp_server_tests)
   find_program(TEST_DPKG_DEB_EXECUTABLE NAMES dpkg-deb)
   find_program(TEST_RSYNC_EXECUTABLE NAMES rsync)
   if(TEST_DPKG_DEB_EXECUTABLE AND TEST_RSYNC_EXECUTABLE)
