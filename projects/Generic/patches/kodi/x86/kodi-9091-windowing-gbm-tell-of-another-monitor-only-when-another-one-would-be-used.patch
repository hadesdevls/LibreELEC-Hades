From ff1c1b82f56257b13576e160f8b40e97a730fd63 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 11 Oct 2026 09:14:48 +0000
Subject: [PATCH] windowing/gbm: tell of another monitor only when another one
 would be used

The notice that the display changes when Kodi is started again was
shown whenever the Monitor setting named anything but the output in
use: also for "Default" where Default is that output, and again when
Kodi put the old value back because the change was not confirmed.

It is shown when the next start would use another output: the choice of
the start is made again with what the setting names now, over the
outputs of this device and those of the others as they were seen, with
every connected display counted as one that will be on by then.

Also: the reason logged when a driver refuses to turn an output off is
the one of that refusal, not of a later call.

Found by the independent review. The decision is in the host test of
the choice of an output; the notice itself is seen on a display only.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp      |  8 +++--
 xbmc/windowing/gbm/drm/DRMOutputChoice.h | 27 ++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.cpp      | 45 ++++++++++++++++++++++--
 xbmc/windowing/gbm/drm/DRMUtils.h        |  8 +++--
 4 files changed, 80 insertions(+), 8 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 2b68a8e..1930a79 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -921,8 +921,10 @@ std::vector<std::string> CWinSystemGbm::GetConnectedOutputs()
 void CWinSystemGbm::MoveToScreen(unsigned int /*screenIdx*/)
 {
   // The output is chosen when Kodi starts (CDRMUtils::OpenDrm()): another one is used from the
-  // next start on, and nothing else shows that the choice was taken. Not told when the output
-  // that was named is the one in use, nor before the skin and its texts are there.
+  // next start on, and nothing else shows that the choice was taken. Told only when what is
+  // named now would make that start use another output than the one in use (naming the one in
+  // use, or "Default" where that is what it gives, changes nothing), and not before the skin
+  // and its texts are there.
   const auto gui = CServiceBroker::GetGUI();
   const auto settingsComponent = CServiceBroker::GetSettingsComponent();
   if (!gui || !gui->GetSkinInfo() || !settingsComponent || !settingsComponent->GetSettings() ||
@@ -931,7 +933,7 @@ void CWinSystemGbm::MoveToScreen(unsigned int /*screenIdx*/)
 
   const std::string asked =
       settingsComponent->GetSettings()->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR);
-  if (m_DRM->IsCurrentOutput(asked))
+  if (!m_DRM->WouldUseAnotherOutput(asked))
     return;
 
   CLog::Log(LOGINFO, "The monitor in the settings is now \"{}\": used when Kodi is started again",
diff --git a/xbmc/windowing/gbm/drm/DRMOutputChoice.h b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
index de4d896..58b810f 100644
--- a/xbmc/windowing/gbm/drm/DRMOutputChoice.h
+++ b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
@@ -156,6 +156,33 @@ inline bool AnyOutputOff(const std::vector<std::vector<DRMOutput>>& devices)
   return false;
 }
 
+/*!
+ * \brief Whether Kodi would show itself on another output when it is started again
+ * \param devices the outputs of each device, in the order of the devices
+ * \param device the device in use, and \param output its output in use
+ * \param asked the output that the settings name now
+ *
+ * By then every display that is connected is on (see AnyOutputOff()), also one that Kodi
+ * itself turned off since it started: a connected output counts as one that can be used.
+ */
+inline bool WouldChooseAnother(std::vector<std::vector<DRMOutput>> devices,
+                               int device,
+                               int output,
+                               const std::string& asked)
+{
+  for (auto& outputs : devices)
+  {
+    for (DRMOutput& one : outputs)
+      one.usable = one.connected;
+  }
+
+  const int best = BestDevice(devices, asked);
+  if (best < 0)
+    return false;
+
+  return best != device || BestOutput(devices[best], asked) != output;
+}
+
 /*!
  * \brief What tells each device from the others: its driver, and where two of them have the
  * same driver, the driver and the place of the device (its address on the bus)
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index eace926..483f589 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -708,6 +708,7 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
   m_deviceName.clear();
   m_otherOutputs.clear();
   m_otherDeviceNodes.clear();
+  m_devicePosition = 0;
   if (needConnector && !m_useFirstDevice)
   {
     std::string asked = "Default";
@@ -742,7 +743,11 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
         for (std::size_t i = 0; i < outputs.size(); ++i)
         {
           if (static_cast<int>(i) != best && !outputs[i].empty())
+          {
             m_otherOutputs.emplace_back(outputs[i]);
+            if (static_cast<int>(i) < best)
+              ++m_devicePosition;
+          }
 
           // A device that is not used and drives a display, whether Kodi could use it or not:
           // that display is turned off once Kodi is up (DisableOtherDevices()).
@@ -1063,6 +1068,7 @@ void CDRMUtils::DisableOtherDevices()
 
     int off = 0;
     int kept = 0;
+    int refused = 0; // why the driver refused, the last time it did
     if (drmModeResPtr resources = drmModeGetResources(fd))
     {
       for (int i = 0; i < resources->count_crtcs; i++)
@@ -1075,9 +1081,14 @@ void CDRMUtils::DisableOtherDevices()
 
         // (a CRTC with no framebuffer and no mode drives nothing: its display goes to standby)
         if (drmModeSetCrtc(fd, resources->crtcs[i], 0, 0, 0, nullptr, 0, nullptr) == 0)
+        {
           ++off;
+        }
         else
+        {
+          refused = errno;
           ++kept;
+        }
       }
       drmModeFreeResources(resources);
     }
@@ -1094,7 +1105,7 @@ void CDRMUtils::DisableOtherDevices()
     {
       if (kept > 0)
         CLog::LogF(LOGWARNING, "{}: its outputs stay on, the driver refused: {}", node,
-                   strerror(errno));
+                   strerror(refused));
       close(fd);
     }
   }
@@ -1223,13 +1234,41 @@ std::vector<RESOLUTION_INFO> CDRMUtils::GetModes()
   return resolutions;
 }
 
-bool CDRMUtils::IsCurrentOutput(const std::string& asked)
+bool CDRMUtils::WouldUseAnotherOutput(const std::string& asked)
 {
   if (!m_connector)
     return false;
 
+  // The outputs of this device as they are now, and those of the other devices as they were
+  // when this one was chosen (no device is opened for this), in the order in which the devices
+  // are looked at when Kodi starts.
   const std::string device = m_deviceName.empty() ? DriverOf(m_fd) : m_deviceName;
-  return IsAskedOutput(Describe(*m_connector, device, false), asked);
+  std::vector<DRMOutput> own;
+  int current = -1;
+  for (std::size_t i = 0; i < m_connectors.size(); ++i)
+  {
+    if (m_connectors[i].get() == m_connector)
+      current = static_cast<int>(i);
+
+    DRMOutput output = Describe(*m_connectors[i], device, true);
+    // (the display of an output that Kodi turned off is looked at too: it will be on by then)
+    if (output.connected && !output.usable && output.type == "HDMI-A" && !output.nonDesktop)
+    {
+      const auto info = KODI::UTILS::CDisplayInfo::Create(m_connectors[i]->GetEDID());
+      output.dolbyVision = info && info->SupportsStandardDolbyVision();
+    }
+    own.emplace_back(output);
+  }
+
+  const std::size_t before =
+      std::min(static_cast<std::size_t>(m_devicePosition), m_otherOutputs.size());
+  const auto position = m_otherOutputs.begin() + static_cast<std::ptrdiff_t>(before);
+  std::vector<std::vector<DRMOutput>> devices(m_otherOutputs.begin(), position);
+  const int here = static_cast<int>(devices.size());
+  devices.emplace_back(own);
+  devices.insert(devices.end(), position, m_otherOutputs.end());
+
+  return WouldChooseAnother(devices, here, current, asked);
 }
 
 std::vector<std::string> CDRMUtils::GetConnectedConnectorNames()
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 893bdcd..c14ef14 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -106,8 +106,9 @@ public:
     m_useFirstDevice = true;
     m_chosenAmongDevices = false;
   }
-  //! Whether an output named in the settings is the one in use
-  bool IsCurrentOutput(const std::string& asked);
+  //! Whether, with this output named in the settings, Kodi would show itself on another output
+  //! than the one in use when it is started again
+  bool WouldUseAnotherOutput(const std::string& asked);
 
   virtual RESOLUTION_INFO GetCurrentMode();
   virtual std::vector<RESOLUTION_INFO> GetModes();
@@ -173,6 +174,9 @@ private:
   //! What tells this device from the others in the name of an output (DRMOutputChoice.h), when
   //! it was chosen among several. Empty when there was nothing to choose: it is the driver then.
   std::string m_deviceName;
+  //! How many of the other devices that have outputs (m_otherOutputs) come before this one in
+  //! the order in which the devices are looked at
+  int m_devicePosition{0};
   //! The outputs of the other graphics devices that Kodi could use, as they were when this one
   //! was chosen: the settings offer the connected ones after those of this device.
   std::vector<std::vector<DRMOutput>> m_otherOutputs;
-- 
