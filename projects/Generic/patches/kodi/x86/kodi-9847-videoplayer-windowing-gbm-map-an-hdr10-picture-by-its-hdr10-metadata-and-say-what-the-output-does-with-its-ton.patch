+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1204,6 +1204,47 @@ void CDVBridgeGLES::LogNotes()
               "DVBridge: the trim pass (level 2) could not be drawn on this GPU: the pictures of "
               "the rest of this stream mapped to the display go out without it (no picture was "
               "lost)");
+  // Hades: the mapping of a video guided by its HDR10+ metadata (dvbridge_hdr10plus_map.h): how
+  if (notes.hdr10plus_curve || notes.hdr10plus_statistics)
+  {
+    const dvbridge_plain_hdr10plus& h = notes.hdr10plus;
+    const double brightest = std::max({h.scene_max[0], h.scene_max[1], h.scene_max[2]});
+    const double peak = notes.hdr10plus_peak;
+    const std::string to =
+        notes.hdr10plus_sdr ? StringUtils::Format("SDR (its white {:.0f} cd/m2)", peak)
+                            : StringUtils::Format("the display ({:.0f} cd/m2)", peak);
+    if (notes.hdr10plus_curve)
+    {
+      const double target = h.target;
+      const std::string fit =
+          std::fabs(target - peak) < 0.5
+              ? "the display's peak is that target: the curve as the studio made it"
+              : StringUtils::Format(
+                    "the display's peak is {} than that target: libplacebo adapts the curve to it "
+                    "(SMPTE ST 2094-40 leaves that to the device), towards the identity for a "
+                    "brighter display (a scene that fits is not mapped), towards a clip for a "
+                    "darker one",
+                    peak > target ? "higher" : "lower");
+      CLog::Log(LOGINFO,
+                "DVBridge: this video's HDR10+ tone curve maps its pictures to {}: the curve of "
+                "SMPTE ST 2094-40 8.7.4 for a display of {:.0f} cd/m2 (knee point {:.4f}, {:.4f}; "
+                "{} Bezier curve anchors), on the maxRGB of each pixel over the brightest of its "
+                "scene (the highest MaxSCL, {:.0f} cd/m2 in the first picture), by libplacebo's "
+                "pl_tone_map_st2094_40; {}. Scene by scene, from each picture's own HDR10+ "
+                "metadata (the first picture that has them)",
+                to, target, static_cast<double>(h.knee_x), static_cast<double>(h.knee_y),
+                h.anchors, brightest, fit);
+    }
+    if (notes.hdr10plus_statistics)
+      CLog::Log(LOGINFO,
+                "DVBridge: this video's HDR10+ statistics guide the mapping of its pictures to {}: "
+                "the {} curve maps each scene from its brightest (the highest MaxSCL, {:.0f} cd/m2 "
+                "in the first picture; its average of maxRGB {:.0f} cd/m2) instead of from the "
+                "peak of the mastering display; no tone curve of its own is used (the first "
+                "picture that has them)",
+                to, m_convertMapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
