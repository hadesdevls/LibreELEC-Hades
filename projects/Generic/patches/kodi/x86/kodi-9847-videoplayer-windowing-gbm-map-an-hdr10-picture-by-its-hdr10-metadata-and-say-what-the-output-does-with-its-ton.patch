+
+void CLinuxRendererGLES::PlainHdr10Plus(const std::shared_ptr<const AVDynamicHDRPlus>& metadata,
+                                        AVColorTransferCharacteristic transfer,
+                                        dvbridge_plain& plain,
+                                        const char** curveWhy)
+{
+  plain.hdr10plus = {};
+  if (curveWhy)
+    *curveWhy = nullptr;
+  // (a PQ picture only: HDR10+ is of SMPTE ST 2084)
+  if (!metadata || transfer != AVCOL_TRC_SMPTE2084)
+    return;
+  dvbridge_hdr10plus_plain(metadata.get(), &plain.hdr10plus, nullptr, curveWhy);
+}
+
+void CLinuxRendererGLES::TellHdr10Plus(int index)
+{
+  namespace H = KODI::UTILS::HDR10PLUS;
+  if (m_hdr10PlusTold || index < 0 || index >= NUM_BUFFERS)
+    return;
+  const CPictureBuffer& buffer = m_buffers[index];
+  if (!buffer.hdr10PlusDynamic || buffer.m_srcColTransfer != AVCOL_TRC_SMPTE2084)
+    return;
+  const H::Curve curve = H::CurveOf(*buffer.hdr10PlusDynamic);
+  // (the first picture that carries a curve, or the display its metadata are for)
+  if (!curve.curve && !(curve.target > 0))
+    return;
+  const char* refused = nullptr;
+  H::CurveWay way;
+  if (m_plainMap)
+  {
+    dvbridge_plain plain{};
+    PlainHdr10Plus(buffer.hdr10PlusDynamic, buffer.m_srcColTransfer, plain, &refused);
+    // (no statistics at all: the static metadata map it; the curve is not used either)
+    if (!plain.hdr10plus.present && curve.curve)
+      refused = "its HDR10+ statistics give no scene to map from";
+    way = H::CurveWay::MAPPED;
+  }
+  else if (m_dvRequested && !m_hdr10Tunnel)
+  {
+    // (Dolby Vision of its own, with HDR10+ beside it: its HDR10+ are left aside, said elsewhere)
+    if (!buffer.doviFromHdr10Plus)
+    {
+      m_hdr10PlusTold = true;
+      return;
+    }
+    way = H::CurveWay::DOLBY_VISION;
+  }
+  else if (m_dvConvert)
+  {
+    m_hdr10PlusTold = true; // (a picture rebuilt from its own Dolby Vision)
+    return;
+  }
+  else if (m_passthroughHDR)
+  {
+    // (sent where the window system queued the InfoFrame of this frame: SetHDR10Plus(), just before.
+    // It may hold the first ones while the mode of the video goes out: not sent is said only after a
+    // second of frames that queued none)
+    auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+        CServiceBroker::GetWinSystem());
+    if (buffer.hdr10PlusVsif && window && window->Hdr10PlusInfoFrameQueued())
+      way = H::CurveWay::INFOFRAME;
+    else if (buffer.hdr10PlusVsif && ++m_hdr10PlusUnqueued < 24)
+      return;
+    else
+      way = H::CurveWay::STATIC_ONLY;
+  }
+  else
+    way = H::CurveWay::KODI_SDR;
+  m_hdr10PlusTold = true;
+  const std::string text = H::CurveTold(curve, way, refused);
+  if (!text.empty())
+    CLog::Log(LOGINFO, "{}", text);
+}
 #endif
 
