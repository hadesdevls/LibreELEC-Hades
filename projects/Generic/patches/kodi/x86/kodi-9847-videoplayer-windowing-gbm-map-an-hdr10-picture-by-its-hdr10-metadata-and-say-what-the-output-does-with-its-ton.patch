+/*!
+ * \brief Hades: the HDR10+ metadata of each picture of a stream as the player maps it to the display
+ *        itself (VideoPicture::hdr10PlusDynamic, dvbridge_plain::hdr10plus), across pictures without
+ *        metadata of their own, as CGap holds its InfoFrame
+ *
+ * Fewer than MISSING_MAX pictures in a row without keep those of the last picture that had them (a
+ * gap in a scene); from the MISSING_MAX-th on, none: those pictures are mapped by their static HDR10
+ * metadata, so that no curve of a scene goes on being applied to pictures that may be of another. A
+ * flush (a seek) and a new stream keep nothing: the first picture after them is mapped by its own, or
+ * by the static metadata. (FFmpeg's HEVC decoder gives the metadata of the last SEI to the pictures
+ * after it until a flush, CGap: in such a stream this acts at its start and after a seek.) The
+ * pictures with the same metadata share one copy of them.
+ */
+class CMetadataHold
+{
+public:
+  static constexpr unsigned int MISSING_MAX = CGap::MISSING_MAX;
+
+  //! The metadata of the next picture, whose own are own (nullptr: none)
+  std::shared_ptr<const AVDynamicHDRPlus> Picture(const AVDynamicHDRPlus* own)
+  {
+    if (own)
+    {
+      m_missing = 0;
+      if (!m_last || std::memcmp(m_last.get(), own, sizeof(*own)) != 0)
+        m_last = std::make_shared<const AVDynamicHDRPlus>(*own);
+      return m_last;
+    }
+    if (!m_last)
+      return nullptr;
+    if (++m_missing < MISSING_MAX)
+      return m_last;
+    m_last.reset();
+    m_missing = 0;
+    return nullptr;
+  }
+
+  //! A flush (a seek), or a new stream: nothing of the pictures before is held
+  void Flush()
+  {
+    m_last.reset();
+    m_missing = 0;
+  }
+
+private:
+  std::shared_ptr<const AVDynamicHDRPlus> m_last;
+  unsigned int m_missing = 0;
+};
+
+/*!
+ * \brief Hades: the tone curve that the HDR10+ metadata of a picture carry (ST 2094-40 8.7, of its first
+ *        processing window) and the display it is for (7.1, TargetedSystemDisplayMaximumLuminance), for
+ *        the log: what the output of the video does with them (CurveTold())
+ */
+struct Curve
+{
+  bool curve = false; //!< tone_mapping_flag
+  double target = 0; //!< cd/m2, 0 not given
+  double kneeX = 0, kneeY = 0;
+  unsigned int anchors = 0;
+  unsigned int version = 0; //!< the application version
+};
+
+inline Curve CurveOf(const AVDynamicHDRPlus& m)
+{
+  Curve c;
+  c.version = m.application_version;
+  const AVRational t = m.targeted_system_display_maximum_luminance;
+  c.target = t.den > 0 && t.num > 0 ? static_cast<double>(t.num) / t.den : 0.0;
+  if (m.num_windows < 1)
+    return c;
+  const AVHDRPlusColorTransformParams& w = m.params[0];
+  c.curve = w.tone_mapping_flag != 0;
+  if (c.curve)
+  {
+    c.kneeX = w.knee_point_x.den > 0 ? static_cast<double>(w.knee_point_x.num) / w.knee_point_x.den : 0;
+    c.kneeY = w.knee_point_y.den > 0 ? static_cast<double>(w.knee_point_y.num) / w.knee_point_y.den : 0;
+    c.anchors = w.num_bezier_curve_anchors;
+  }
+  return c;
+}
+
+//! What the output of a video does with the HDR10+ metadata of its pictures (CurveTold())
+enum class CurveWay
+{
+  //! the player maps the picture to the display or to SDR (the bridge: "HDR10 and HDR10+ adapted to
+  //! the display", or the tone mapping method "Reference (BT.2390)" on an SDR output); its tone curve
+  //! is applied where it is one the bridge takes, and the bridge's own note says how
+  MAPPED,
+  //! sent as Dolby Vision made from its HDR10+ statistics ("Play HDR10+ videos as Dolby Vision")
+  DOLBY_VISION,
+  //! passed through as HDR10 with the HDR10+ InfoFrame of each picture
+  INFOFRAME,
+  //! passed through as HDR10 without HDR10+ (the display or its driver takes none, or the InfoFrame
+  //! cannot carry these metadata)
+  STATIC_ONLY,
+  //! mapped to SDR by Kodi's own tone mapping (a method other than "Reference (BT.2390)")
+  KODI_SDR,
+};
+
+/*!
+ * \brief The line of the log that says what the output does with the tone curve of a video and the
+ *        display it is made for, once a video, with its first picture that carries either; empty
+ *        where there is nothing to say: neither is carried, or the picture is mapped by its curve (the
+ *        bridge says that, and how: CDVBridgeGLES::LogNotes())
+ * \param refused for MAPPED: why the bridge does not take the curve (dvbridge_hdr10plus_plain()),
+ *        nullptr where it takes it
+ */
+inline std::string CurveTold(const Curve& c, CurveWay way, const char* refused = nullptr)
+{
+  if (!c.curve && !(c.target > 0))
+    return {};
+  if (way == CurveWay::MAPPED && c.curve && !refused)
+    return {};
+  char head[256];
+  if (c.curve)
+  {
+    char target[64];
+    if (c.target > 0)
+      std::snprintf(target, sizeof(target), "a display of %.0f cd/m2", c.target);
+    else
+      std::snprintf(target, sizeof(target), "a display it does not name");
+    std::snprintf(head, sizeof(head),
+                  "this video's HDR10+ metadata carry a tone curve for %s (knee point %.4f, %.4f; "
+                  "%u Bezier curve anchors)",
+                  target, c.kneeX, c.kneeY, c.anchors);
+  }
+  else
+    std::snprintf(head, sizeof(head),
+                  "this video's HDR10+ metadata are made for a display of %.0f cd/m2 (they carry no "
+                  "tone curve)",
+                  c.target);
+  std::string text = std::string("HDR10+: ") + head;
+  switch (way)
+  {
+    case CurveWay::MAPPED:
+      // (a curve the bridge does not take, or none: the statistics guide the mapping)
+      if (c.curve)
+        text += std::string("; the curve is not used: ") + (refused ? refused : "") +
+                "; the picture is mapped by the curve of the mapping, from the brightest of each "
+                "scene that its HDR10+ statistics give";
+      else
+        text += "; the picture is mapped by the curve of the mapping, from the brightest of each "
+                "scene that its HDR10+ statistics give";
+      break;
+    case CurveWay::DOLBY_VISION:
+      text += std::string("; Dolby Vision has no place for ") + (c.curve ? "a tone curve" : "it") +
+              ", so it is not carried: each scene goes out with level 1 made from the HDR10+ "
+              "statistics (the highest MaxSCL and the percentiles of maxRGB), and the TV maps it "
+              "by its own curve (in Low-Latency, Hades maps it from that level 1). "
+              "With \"Play HDR10+ videos as Dolby Vision\" off, \"HDR10 and HDR10+ adapted to the "
+              "display\" has Hades map it by " +
+              (c.curve ? "this curve" : "its HDR10+ statistics");
+      break;
+    case CurveWay::INFOFRAME:
+      if (c.curve)
+      {
+        char carried[320];
+        std::snprintf(carried, sizeof(carried),
+                      "; it goes to the display in the HDR10+ InfoFrame of each picture, as the "
+                      "InfoFrame carries it: the knee point in 10 of its 12 bits, %s in 8 of their "
+                      "10 bits, the target in steps of 32 cd/m2 up to 976 and more",
+                      c.anchors > 9 ? "the first 9 anchors of its curve" : "the anchors");
+        text += carried;
+      }
+      else
+        text += "; it goes to the display in the HDR10+ InfoFrame of each picture, in steps of 32 "
+                "cd/m2 up to 976 and more";
+      break;
+    case CurveWay::STATIC_ONLY:
+      text += std::string("; the display is not sent HDR10+ (it takes none, or its driver cannot "
+                          "send it, or the InfoFrame cannot carry these metadata), so ") +
+              (c.curve ? "the curve is" : "this is") +
+              " not used: the display maps the picture from its static HDR10 metadata by its own "
+              "curve. \"HDR10 and HDR10+ adapted to the display\" has Hades map it by " +
+              (c.curve ? "this curve" : "its HDR10+ statistics");
+      break;
+    case CurveWay::KODI_SDR:
+      text += std::string("; Kodi's own tone mapping maps the picture to SDR from its static HDR10 "
+                          "metadata and does not use ") +
+              (c.curve ? "the curve" : "them") +
+              ": the tone mapping method \"Reference (BT.2390)\" maps it by " +
+              (c.curve ? "this curve" : "its HDR10+ statistics");
+      break;
+  }
+  return text;
+}
+
