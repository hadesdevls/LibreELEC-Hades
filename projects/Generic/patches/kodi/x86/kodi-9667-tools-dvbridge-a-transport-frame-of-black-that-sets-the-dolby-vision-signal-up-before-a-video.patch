From 853d3f5e4717f32cf5c22ceb27ceb7238d74c9a8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:29:00 +0000
Subject: [PATCH] tools/dvbridge: a transport frame of black that sets the
 Dolby Vision signal up before a video

For the change of mode of a video that goes out natively to carry the Dolby Vision signal before
the first picture of the video is decoded (windowing/gbm, CDVStartSignal), the bridge has to send
one transport frame that is no picture of the video: black, with valid metadata.

dvbridge_render_signal() prepares the metadata of such a frame in the renderer's own serializer,
as for a picture of the whole raster in the transport converted to BT.2020, and makes it the
renderer's prepared frame: dvbridge_render_candidate() gives its packets, and
dvbridge_render_commit() commits it once it is presented. Nothing is drawn by the renderer, and it
has no picture of the frame.

CDVBridgeGLES::DrawStartSignal() makes the metadata of a black picture of profile 8.1
(dvbridge_profile81_metadata(): identity mapping, BT.2020 PQ, level 1 of black as dovi_tool clamps
it for content mapping v2.9, a mastering display of 1000 to 0.005 cd/m2), takes the codes of black
from their DM header (dvbridge_eos_packets()) and draws the frame with the program of the frame
that marks the end of the signal (dvbridge_gl_eos_draw()), with the packets as they are, EOS 0.
StartSignalPresented() commits the metadata of the frame that was presented and starts the next
frame as a new stream (dvbridge_renderer_reset()), as after the end of a native output.

The metadata go through the renderer's serializer, not one of their own, so that the first frame
of the video takes another metadata id than the frame of black and refreshes the scene. With a
serializer of its own, or without the commit, the first frame of the video took the id of the
frame of black after an earlier native output, and a display could keep the metadata of black for
the first scene of the video.

Measured on the software OpenGL ES (zink on lavapipe), with the bridge of this tree: the frame
reads as ETSI GS CCM 001 says a transport is sent (an independent reader: three copies of each
packet with their CRC, headers, table 3, blocks and their order), with EOS 0, 12 bits, one level 1
and one level 5 block over the whole raster, the codes of black 256, 2048 and 2048 that its DM
header gives in all 8,294,400 pixels; the first frame after it takes the next metadata id and
refreshes the scene, both for a fresh renderer and for one reset after an earlier native output.
Without the commit, after an earlier native output, the id repeats: caught. A 1080p geometry for
the frame, a serializer of its own and a frame that is not ready are caught as well.
---
 tools/dvbridge/dvbridge_render.c              | 20 ++++++
 tools/dvbridge/dvbridge_render.h              | 12 ++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 72 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h | 18 +++++
 4 files changed, 122 insertions(+)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 789f30b..a0c6cea 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1865,6 +1865,26 @@ bool dvbridge_render_commit(struct dvbridge_renderer *r)
     return r && r->ready && r->pending && dvbridge_commit(r->context, r->pending);
 }
 
+bool dvbridge_render_signal(struct dvbridge_renderer *r, const void *metadata, size_t bytes,
+                            const char **why)
+{
+    if (why)
+        *why = NULL;
+    if (!r || !metadata) {
+        if (why)
+            *why = "no renderer, or no metadata";
+        return false;
+    }
+    dvbridge_renderer_recover(r);
+    const struct dvbridge_geometry whole = {3840, 2160, 0, 0, 3840, 2160, {0, 0, 0, 0}};
+    r->pending = dvbridge_prepare_why(r->serializer ? r->serializer : r->context, metadata, bytes,
+                                      0.0, whole, false, false, why);
+    r->ready = r->pending != NULL;
+    /* (no picture: as for a frame drawn into its target, dvbridge_render_texture() gives none) */
+    r->packed = r->ready;
+    return r->ready;
+}
+
 bool dvbridge_render_residual_omitted(const struct dvbridge_renderer *r)
 {
     return r && r->residual_omitted;
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 6c29be7..b6bd09e 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -196,6 +196,18 @@ bool dvbridge_render_packed(struct dvbridge_renderer *renderer, const struct pl_
 pl_tex dvbridge_render_texture(const struct dvbridge_renderer *renderer);
 const struct dvbridge_candidate *dvbridge_render_candidate(const struct dvbridge_renderer *renderer);
 bool dvbridge_render_commit(struct dvbridge_renderer *renderer);
+/* Hades: the frame that sets the Dolby Vision signal up with the change of mode of a video that
+ * opens, before its first picture (CDVBridgeGLES::DrawStartSignal()): no picture; the candidate of
+ * metadata (bytes of them) is prepared in the renderer's own serializer as for a picture of the
+ * whole raster in the transport converted to BT.2020, and is the renderer's prepared frame:
+ * dvbridge_render_candidate() gives its packets, and dvbridge_render_commit() commits it once it is
+ * presented, so that the frame after it takes another metadata id. What was prepared before is
+ * dropped first (dvbridge_renderer_recover()); nothing is drawn, and there is no picture of it
+ * (dvbridge_render_texture() gives none). False where the serializer refuses the metadata: *why
+ * (may be NULL) says why, and nothing is prepared. */
+#define DVBRIDGE_RENDER_SIGNAL 1
+bool dvbridge_render_signal(struct dvbridge_renderer *renderer, const void *metadata, size_t bytes,
+                            const char **why);
 /* Hades: the last prepared picture is FEL drawn without its residual (no enhancement picture). */
 bool dvbridge_render_residual_omitted(const struct dvbridge_renderer *renderer);
 /* Hades: the last prepared picture was drawn with the residual of its enhancement layer: the
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 4a1719f..8c76c2e 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -28,7 +28,9 @@ extern "C"
 #include <libavutil/dovi_meta.h>
 #include "dvbridge_cache.h"
 #include "dvbridge_eos.h"
+#include "dvbridge_hdr10plus.h"
 #include "dvbridge_placebo.h"
+#include <libavutil/mem.h>
 }
 
 #include <EGL/egl.h>
@@ -1170,6 +1172,76 @@ bool CDVBridgeGLES::DrawEndOfStream(unsigned int framebuffer,
   return true;
 }
 
+bool CDVBridgeGLES::DrawStartSignal(unsigned int framebuffer,
+                                    int width,
+                                    int height,
+                                    bool flipY,
+                                    unsigned int& packets,
+                                    const char*& why)
+{
+  packets = 0;
+  why = nullptr;
+  if (!m_renderer)
+  {
+    why = "the bridge is not set up";
+    return false;
+  }
+  // A black picture: level 1 as dovi_tool clamps a block of black for content mapping v2.9 (min 0,
+  // max 2081, average 819, as HDR10 measured as Dolby Vision would send one), the mastering display
+  // of dovi_tool's profile 8.1 (1000 to 0.005 cd/m2); the display maps the codes of black to black
+  // whatever they say, and they are valid metadata of the tunnel
+  AVMasteringDisplayMetadata mastering{};
+  mastering.has_luminance = 1;
+  mastering.max_luminance = AVRational{1000, 1};
+  mastering.min_luminance = AVRational{50, 10000};
+  size_t size = 0;
+  AVDOVIMetadata* metadata =
+      dvbridge_profile81_metadata(0, 2081, 819, nullptr, &mastering, nullptr, true, &size);
+  const char* refused = nullptr;
+  if (!metadata)
+    why = "its metadata could not be made";
+  else if (!dvbridge_render_signal(m_renderer, metadata, size, &refused))
+    why = refused ? refused : "the serializer refused its metadata";
+  av_free(metadata);
+  unsigned int count = 0;
+  const uint32_t* words =
+      why ? nullptr : dvbridge_packets(dvbridge_render_candidate(m_renderer), &count);
+  // (the codes of black of the picture that their DM header describes; the copy that
+  // dvbridge_eos_packets() marks with EOS is not sent)
+  uint32_t marked[512] = {};
+  unsigned int black[3] = {};
+  if (!why)
+  {
+    if (!words || !count)
+      why = "its metadata gave no packets";
+    else if (!dvbridge_eos_packets(words, count, marked, black))
+      why = "its packets are not those of a frame";
+    else if (!m_eos && !(m_eos = dvbridge_gl_eos_create()))
+      why = "its GPU program could not be made";
+    else if (!dvbridge_gl_eos_draw(m_eos, framebuffer, width, height, words, count, black, flipY))
+      why = "it could not be drawn";
+  }
+  if (why)
+  {
+    dvbridge_renderer_recover(m_renderer);
+    return false;
+  }
+  packets = count;
+  return true;
+}
+
+void CDVBridgeGLES::StartSignalPresented(bool presented)
+{
+  if (!m_renderer)
+    return;
+  if (presented && !dvbridge_render_commit(m_renderer))
+    CLog::Log(LOGWARNING, "DVBridge: the metadata of the frame that set the Dolby Vision signal up "
+                          "could not be committed");
+  dvbridge_renderer_reset(m_renderer);
+  m_prepared = m_packed = false;
+  m_direct = false;
+}
+
 bool CDVBridgeGLES::Pack(unsigned int framebuffer, int width, int height, bool flipY, Cover cover)
 {
   m_packed = false;
