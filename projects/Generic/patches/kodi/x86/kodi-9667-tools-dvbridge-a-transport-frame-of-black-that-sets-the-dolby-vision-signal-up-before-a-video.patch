+  bool DrawStartSignal(unsigned int framebuffer,
+                       int width,
+                       int height,
+                       bool flipY,
+                       unsigned int& packets,
+                       const char*& why);
+  //! Hades: ... it was presented (its metadata are committed: the first frame of the video takes
+  //! another metadata id) or not; either way the renderer starts the video as a new stream
+  //! (dvbridge_renderer_reset(): its first frame refreshes the scene), as after a native output
+  void StartSignalPresented(bool presented);
   bool Presented(bool success);
   //! Hades: something was drawn into the PQ picture (GetPQFramebuffer()): the GUI, subtitles. Its
   //! area outside the place of the video is cleared again before the next picture; it is not
