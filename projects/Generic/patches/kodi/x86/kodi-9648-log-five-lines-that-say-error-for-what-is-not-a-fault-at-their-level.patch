From 7d1766d3a7aabe1e097a025186a9f43613277fef Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:09:45 +0000
Subject: [PATCH] log: five lines that say "error" for what is not a fault, at
 their level

The hardware test of 1.0 RC4 has, in every session, ERROR lines that are no
fault of Kodi. Each is told once now, at the level it deserves; what is a
real error stays an error.

- "Window Translator: Can't find window sources_results.xml" (and
  sources_playback.xml, nextep_handoff.xml, extras.xml, 6 to 9 times each per
  session): an add-on (Red Light) names its own WindowXML windows by their
  file in calls that the GUI thread runs (builtins that take a window, such
  as Dialog.Close(sources_results.xml); which one it uses is not verified).
  Kodi numbers such windows as it opens them and does not know them by the
  name of their file, so the call does nothing, as it always did. A name ending in .xml that is none of
  Kodi's windows is now information, once per name; any other unknown name
  is still an error.
- "Control N in window N has been asked to focus, but it can't" (lists 500
  and 55 of the videos window as it comes back after playback, list 2000 of
  an add-on's window): Kodi leaves the focus where it was. A list without
  items yet (its folder still being read) gets the focus once it has some:
  information. A hidden or disabled control that a skin or an add-on asked
  for: a warning. Once per control of a window, with the reason.
- "VAAPI/vpp vaQueryVideoProcFilters error: the requested function is not
  implemented (20)", at every opening on NVIDIA: nvidia-vaapi-driver has no
  video post-processing, Kodi asks to know which deinterlacers VAAPI offers,
  and deinterlaces with FFmpeg or its shaders without them. Told once, as
  information, with the driver; any other failure is still an error.
- "CDVDAudio::AddPacketsRenderer - timeout adding data to renderer", at the
  start of a DTS video on the AMD integrated graphics: the audio stream is
  made paused and plays when the playback starts; while the audio engine was
  busy (listing its outputs again after the display was reset, twice, about
  0.6 to 0.9 s each) and the change of mode held the start, it took nothing
  of a packet for more than the 2 s that AddPackets() waits. The wait has to
  end there (this thread hears of the start only after it), and the rest of
  the packet is left out, as before. While the stream is paused that is
  information; while it plays it is an error, as before. The line now says
  how much of the packet the engine took and whether the stream was paused.
- "EXCEPTION: Unknown addon id 'plugin.video.redlight'": an add-on asked
  xbmcaddon.Addon() for one that is not installed and was given a
  RuntimeError, which it may catch (a check of whether an add-on is there).
  The exception goes to the script as before; Kodi's line is information
  with the name of the call, and a script that does not catch it ends with
  its traceback logged as an error by the invoker, as before.
---
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp        | 15 +++++++++-
 .../VideoPlayer/DVDCodecs/Video/VAAPI.cpp     | 22 ++++++++++++--
 xbmc/guilib/GUIControl.cpp                    | 29 ++++++++++++++++---
 xbmc/input/WindowTranslator.cpp               | 24 +++++++++++++++
 xbmc/interfaces/swig/kodi_addonclass.i        | 12 ++++++--
 5 files changed, 93 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
index b38d13a..e52d309 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -63,6 +63,7 @@ bool CAudioSinkAE::Create(const DVDAudioFrame &audioframe, AVCodecID codec, bool
   );
   if (!m_pAudioStream)
     return false;
+  m_bPaused = true; // (Hades: made paused, AESTREAM_PAUSED)
 
   m_dataFormat = audioframe.format.m_dataFormat;
   m_sampleRate = audioframe.format.m_sampleRate;
@@ -151,7 +152,17 @@ unsigned int CAudioSinkAE::AddPackets(const DVDAudioFrame &audioframe)
 
     if (copied == 0 && std::chrono::steady_clock::now() >= deadline)
     {
-      CLog::Log(LOGERROR, "CDVDAudio::AddPacketsRenderer - timeout adding data to renderer");
+      // Hades: the engine took no more of this packet for that long. While the stream is paused
+      // (the playback waiting to start, or paused) nothing is played: that the engine takes
+      // nothing then is no fault, and the wait ends here so that this thread hears of the start
+      // (an engine busy for long, listing its outputs again after the display was reset, takes
+      // that long). While the stream plays it is an error, as before. Either way the frames left
+      // are not added, and the log says how many.
+      CLog::Log(m_bPaused ? LOGINFO : LOGERROR,
+                "CDVDAudio::AddPacketsRenderer - timeout adding data to renderer: the audio engine "
+                "took {} of the {} frames of this packet, while its stream {}; the rest is left "
+                "out",
+                total - frames, total, m_bPaused ? "was paused (the playback waiting to start, or paused)" : "played");
       break;
     }
 
@@ -192,6 +203,7 @@ void CAudioSinkAE::Pause()
   std::unique_lock lock(m_critSection);
   if (m_pAudioStream)
     m_pAudioStream->Pause();
+  m_bPaused = true; // (Hades)
   CLog::Log(LOGDEBUG,"CDVDAudio::Pause - pausing audio stream");
   m_playingPts = DVD_NOPTS_VALUE;
 }
@@ -201,6 +213,7 @@ void CAudioSinkAE::Resume()
   std::unique_lock lock(m_critSection);
   if (m_pAudioStream)
     m_pAudioStream->Resume();
+  m_bPaused = false; // (Hades)
   CLog::Log(LOGDEBUG,"CDVDAudio::Resume - resume audio stream");
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
index cb82e8b..17d9b55 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
@@ -25,6 +25,7 @@
 #include "windowing/WinSystem.h"
 
 #include <array>
+#include <atomic>
 #include <mutex>
 #include <optional>
 #ifdef HAVE_DVBRIDGE
@@ -2572,8 +2573,25 @@ bool CVppPostproc::PreInit(CVaapiConfig &config, SDiMethods *methods)
   VAProcFilterCapDeinterlacing deinterlacingCaps[VAProcDeinterlacingCount];
   unsigned int numDeinterlacingCaps = VAProcDeinterlacingCount;
 
-  if (!CheckSuccess(vaQueryVideoProcFilters(m_config.dpy, m_contextId, filters, &numFilters),
-      "vaQueryVideoProcFilters"))
+  const VAStatus filtersStatus =
+      vaQueryVideoProcFilters(m_config.dpy, m_contextId, filters, &numFilters);
+  // Hades: a driver without video post-processing (nvidia-vaapi-driver, on NVIDIA) says so to this
+  // question, which Kodi asks each time a decoder opens: no VAAPI deinterlacing is offered, and Kodi
+  // deinterlaces with FFmpeg or its own shaders, as it did. That is no fault: told once, as
+  // information. Any other failure is an error, as before.
+  if (filtersStatus == VA_STATUS_ERROR_UNIMPLEMENTED ||
+      filtersStatus == VA_STATUS_ERROR_UNSUPPORTED_ENTRYPOINT)
+  {
+    static std::atomic<bool> told{false};
+    const char* vendor = vaQueryVendorString(m_config.dpy);
+    CLog::Log(told.exchange(true) ? LOGDEBUG : LOGINFO,
+              "VAAPI/vpp: the driver ({}) has no video post-processing (vaQueryVideoProcFilters: "
+              "{}): no deinterlacing by VAAPI is offered; Kodi deinterlaces with FFmpeg or its "
+              "own shaders",
+              vendor ? vendor : "unknown", vaErrorStr(filtersStatus));
+    return false;
+  }
+  if (!CheckSuccess(filtersStatus, "vaQueryVideoProcFilters"))
   {
     CLog::Log(LOGDEBUG, LOGVIDEO, "CVppPostproc::PreInit  - VPP init failed in vaQueryVideoProcFilters");
 
diff --git a/xbmc/guilib/GUIControl.cpp b/xbmc/guilib/GUIControl.cpp
index ee6d807..992f61f 100644
--- a/xbmc/guilib/GUIControl.cpp
+++ b/xbmc/guilib/GUIControl.cpp
@@ -24,6 +24,10 @@
 #include "utils/log.h"
 #include "windowing/WinSystem.h"
 
+#include <mutex>
+#include <set>
+#include <utility>
+
 using namespace KODI;
 using namespace GUILIB;
 
@@ -362,10 +366,27 @@ bool CGUIControl::OnMessage(CGUIMessage& message)
       // if control is disabled then move 2 the next control
       if ( !CanFocus() )
       {
-        CLog::Log(LOGERROR,
-                  "Control {} in window {} has been asked to focus, "
-                  "but it can't",
-                  GetID(), GetParentID());
+        // Hades: Kodi leaves the focus where it was. A list without items yet (a folder that is
+        // still being read, a window of an add-on that fills it next) cannot take it until it has
+        // some, and it is given the focus then: that is information. A control that is hidden or
+        // disabled was asked for by a skin or an add-on that should not have: a warning. Told once
+        // for each control of a window; again only in the debug log.
+        static std::mutex toldMutex;
+        static std::set<std::pair<int, int>> told;
+        bool first;
+        {
+          std::lock_guard lock(toldMutex);
+          first = told.emplace(GetParentID(), GetID()).second;
+        }
+        const bool emptyList = IsContainer() && (IsVisible() || m_allowHiddenFocus) && !IsDisabled();
+        const char* why = emptyList          ? "a list without items yet"
+                          : IsDisabled()     ? "it is disabled"
+                          : !IsVisible()     ? "it is hidden"
+                                             : "it takes no focus";
+        CLog::Log(!first ? LOGDEBUG : emptyList ? LOGINFO : LOGWARNING,
+                  "Control {} in window {} has been asked to focus, but it can't ({}): the focus "
+                  "stays where it was{}",
+                  GetID(), GetParentID(), why, first ? " (told once for this control)" : "");
         return false;
       }
       SetFocus(true);
diff --git a/xbmc/input/WindowTranslator.cpp b/xbmc/input/WindowTranslator.cpp
index 2429650..c3bc8eb 100644
--- a/xbmc/input/WindowTranslator.cpp
+++ b/xbmc/input/WindowTranslator.cpp
@@ -21,6 +21,8 @@
 
 #include <algorithm>
 #include <cstring>
+#include <mutex>
+#include <set>
 #include <stdlib.h>
 
 const CWindowTranslator::WindowMapByName CWindowTranslator::WindowMappingByName = {
@@ -260,6 +262,28 @@ int CWindowTranslator::TranslateWindow(const std::string& window)
   if (it != WindowMappingByName.end())
     return it->windowId;
 
+  // Hades: a name that ends in .xml and is none of Kodi's windows is the file of a window of an
+  // add-on (a WindowXML, which Kodi numbers as it opens it) or of the skin: Kodi does not know it
+  // by that name, and the call that names it (Dialog.Close(sources_results.xml) of an add-on) does
+  // nothing, as it always did. That is no fault of Kodi: told once for each name, as information.
+  // Any other name that Kodi does not know is an error, as before.
+  if (StringUtils::EndsWithNoCase(window, ".xml"))
+  {
+    static std::mutex toldMutex;
+    static std::set<std::string> told;
+    bool first;
+    {
+      std::lock_guard lock(toldMutex);
+      first = told.insert(strWindow).second;
+    }
+    CLog::Log(first ? LOGINFO : LOGDEBUG,
+              "Window Translator: no window of Kodi is called {} (the window of an add-on or of "
+              "the skin is not known by the name of its file): the call that names it does "
+              "nothing{}",
+              window, first ? " (told once for this name)" : "");
+    return WINDOW_INVALID;
+  }
+
   CLog::Log(LOGERROR, "Window Translator: Can't find window {}", window);
 
   return WINDOW_INVALID;
diff --git a/xbmc/interfaces/swig/kodi_addonclass.i b/xbmc/interfaces/swig/kodi_addonclass.i
index f04adbe..a2da602 100644
--- a/xbmc/interfaces/swig/kodi_addonclass.i
+++ b/xbmc/interfaces/swig/kodi_addonclass.i
@@ -92,10 +92,18 @@ namespace
         XBMCAddon::Python::PythonLanguageHook::GetIfExists(PyThreadState_Get()->interp).get());
     $action
   } catch (const XBMCAddon::WrongTypeException& e) {
-    CLog::Log(LOGERROR, "EXCEPTION: {}", e.GetExMessage());
+    /* Hades: the script is given the exception and decides what follows (an add-on that asks
+       whether another one is installed, xbmcaddon.Addon('plugin.video.x'), catches it); one that
+       it does not catch ends it, and Kodi logs its traceback as an error then. Here it is
+       information, not an error of Kodi. */
+    CLog::Log(LOGINFO, "Python: the call \"$symname\" gave the script a TypeError (the script "
+              "may catch it; if it does not, its traceback follows as an error): {}",
+              e.GetExMessage());
     SWIG_exception_fail(SWIG_TypeError, e.GetExMessage());
   } catch (const XbmcCommons::Exception& e) {
-    CLog::Log(LOGERROR, "EXCEPTION: {}", e.GetExMessage());
+    CLog::Log(LOGINFO, "Python: the call \"$symname\" gave the script a RuntimeError (the script "
+              "may catch it; if it does not, its traceback follows as an error): {}",
+              e.GetExMessage());
     SWIG_exception_fail(SWIG_RuntimeError, e.GetExMessage());
   } catch (...) {
     CLog::Log(LOGERROR, "EXCEPTION: Unknown exception thrown from the call \"$symname\"");
-- 
2.53.0

