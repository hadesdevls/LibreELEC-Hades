+@@ -655,13 +655,21 @@ static int libc_read ( dvdcss_t dvdcss, void *p_buffer, int i_blocks )
      off_t i_size, i_ret, i_ret_blocks;
  
      i_size = (off_t)i_blocks * (off_t)DVDCSS_BLOCK_SIZE;
