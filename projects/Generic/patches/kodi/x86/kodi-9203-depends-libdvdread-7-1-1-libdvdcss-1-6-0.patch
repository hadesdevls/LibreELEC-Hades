diff --git a/tools/depends/target/libdvdread/01-all-disableopendir.patch b/tools/depends/target/libdvdread/01-all-disableopendir.patch
index 8b0356d..4779f49 100644
--- a/tools/depends/target/libdvdread/01-all-disableopendir.patch
+++ b/tools/depends/target/libdvdread/01-all-disableopendir.patch
@@ -1,27 +1,30 @@
 --- a/src/dvd_reader.c
 +++ b/src/dvd_reader.c
-@@ -861,6 +861,16 @@ static dvd_file_t *DVDOpenFileUDF( dvd_reader_t *ctx, const char *filename,
+@@ -927,6 +927,19 @@ static dvd_file_t *DVDOpenFileUDF( dvd_reader_t *ctx, const char *filename,
   */
- static int findDirFile( const char *path, const char *file, char *filename )
+ static int findDirFile(dvd_reader_t *ctx, const char *path, const char *file, char *filename )
  {
 +#if defined(_XBMC)
-+  struct stat fileinfo;
++  dvdstat_t fileinfo;
 +
-+       // no emulated opendir function in xbmc, so we'll
-+       // check if the file exists by stat'ing it ...
-+  sprintf(filename, "%s%s%s", path, ((path[strlen(path) - 1] == '/') ? "" : "/"), file);
++  /* Kodi: do not search the directory, look the file up by its exact
++   * name and check that it exists by stat'ing it */
++  sprintf( filename, "%s%s%s", path,
++           ( ( path[ strlen( path ) - 1 ] == '/' ) ? "" : "/" ), file );
 +
-+  if (stat(filename, &fileinfo) == 0) return 0;
++  if( ctx->fs->stat( ctx->fs, filename, &fileinfo ) == 0 )
++    return 0;
 +
++  return -1;
 +#else
-   DIR *dir;
-   struct dirent *ent;
+   dvd_dirent_t entry;
+   void *dir = ctx->fs->dir_open(ctx->fs, path);
+   if( !dir ) {
+@@ -954,6 +967,7 @@ static int findDirFile(dvd_reader_t *ctx, const char *path, const char *file, ch
  
-@@ -877,6 +887,7 @@ static int findDirFile( const char *path, const char *file, char *filename )
-     }
-   }
-   closedir(dir);
-+#endif // _XBMC
-   return -1;
+   ctx->fs->dir_close(dir);
+   return ret;
++#endif /* _XBMC */
  }
  
+ static int findDVDFile( dvd_reader_t *dvd, const char *file, char *filename )
