From 1f18e5bfc6547724aee934c37787c67a002d40ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:00:40 +0000
Subject: [PATCH] tools/dvbridge: the warm-up says what it cleared

The warm-up of a native output (dvbridge_render_warm()) clears what its renders leave, so that the
frames do not inherit it: libplacebo's errors and the hooks it turned off, after each render and once
more at the end (give_back_state()), and the OpenGL errors at the end. The OpenGL errors were dropped
without a record: the window system's look for errors after the warm-up found none left, and nothing
logged them. libplacebo's errors were logged by libplacebo when they happened, within the bridge's
limit on its messages, but the report only counted the renders that failed.

Now what each render left goes into the report before it is cleared (dvbridge_warm_report:
placebo_errors, disabled_hooks, gl_errors, gl_first), and CDVBridgeGLES::Warm() logs it when there is
anything, naming a failure of the composer of ETSI GS CCM 001 (the frames try it again). Nothing else
changes: the same renders, the same errors cleared.

Whether a failure of the composer from before the warm-up is lost: none can be there.
The renderer is reset at the end of each native output (CDVBridgeGLES::Reset()), which clears
libplacebo's errors, and the warm-up runs with the first frame of the next one; within it, the
renders' own errors are those that are now reported.

Host test (conv_test.c): a good frame reports nothing; a frame whose layer cannot be sampled, composed
by libplacebo's reshaping, reports libplacebo's sampling error (0x2). Without the change the report has
no record of it; with the record taken only at the end, the test fails.
---
 tools/dvbridge/dvbridge_render.c              | 21 ++++++++++++++++
 tools/dvbridge/dvbridge_render.h              | 11 +++++++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 24 +++++++++++++++++++
 3 files changed, 56 insertions(+)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 381e9f2..b23e3a7 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1405,6 +1405,24 @@ static void keep_state(struct dvbridge_renderer *r, struct kept_state *k)
     k->geometry = r->geometry;
 }
 
+/* Hades: what a render of the warm-up left (libplacebo's errors and hooks turned off, OpenGL errors)
+ * into the report, before it is cleared: it was cleared without a record. libplacebo logged its own
+ * when they happened (within the bridge's limit on its messages); the OpenGL errors were never
+ * logged, and the window system's look for errors after the warm-up found none left. */
+static void take_warm_errors(struct dvbridge_renderer *r, struct dvbridge_warm_report *done)
+{
+    const struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
+    done->placebo_errors |= (unsigned)errors.errors;
+    done->disabled_hooks += (unsigned)errors.num_disabled_hooks;
+    for (int i = 0; i < 16; ++i) {
+        const GLenum error = glGetError();
+        if (error == GL_NO_ERROR)
+            break;
+        if (!done->gl_errors++)
+            done->gl_first = (unsigned)error;
+    }
+}
+
 static void give_back_state(struct dvbridge_renderer *r, const struct kept_state *k)
 {
     dvbridge_candidate_destroy(r->pending);
@@ -1536,6 +1554,7 @@ int dvbridge_render_warm(struct dvbridge_renderer *r, const struct pl_frame *sou
                 glFinish();
                 done.made += ok;
                 done.failed += !ok;
+                take_warm_errors(r, &done);
                 pl_renderer_reset_errors(r->renderer, NULL);
                 if (ok && !transport_known) {
                     transport_known = true;
@@ -1547,6 +1566,8 @@ int dvbridge_render_warm(struct dvbridge_renderer *r, const struct pl_frame *sou
             }
         }
     }
+    /* (what the packing of the composed picture left, after the last render) */
+    take_warm_errors(r, &done);
     give_back_state(r, &kept);
     done.ms = now_ms() - start;
     if (report)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 93e0884..16695fa 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -214,6 +214,17 @@ struct dvbridge_warm_report {
     unsigned failed; /* ... that failed (libplacebo or the metadata refused them) */
     unsigned left;   /* ... not made: the time was up */
     double ms;       /* the time it took */
+    /* Hades: what the renders left, which is cleared so that the frames do not inherit it (it was
+     * cleared without a record): libplacebo's errors (a mask of enum pl_render_error; libplacebo
+     * logs each when it happens, PL_RENDER_ERR_DOVI_COMPOSER among them) and the hooks it turned
+     * off, and the OpenGL errors that they left (none of which was logged; a render that writes
+     * the transport directly takes those it raises as its failure, counted in failed) with the
+     * first of them */
+#define DVBRIDGE_WARM_REPORT_ERRORS 1
+    unsigned placebo_errors;
+    unsigned disabled_hooks;
+    unsigned gl_errors;
+    unsigned gl_first;
 };
 int dvbridge_render_warm(struct dvbridge_renderer *renderer, const struct pl_frame *source,
                          const void *metadata, size_t bytes, double pts, double el_pts,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 361ccd2..3b8108d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -922,6 +922,30 @@ void CDVBridgeGLES::Warm(const Layer& base,
                         : std::string(),
             report.failed ? StringUtils::Format("; {} could not be drawn", report.failed)
                           : std::string());
+  // Hades: what those renders left is cleared, so that the frames do not inherit it; it was
+  // cleared without a record (libplacebo logs its own errors when they happen, within the limit
+  // on its messages; the OpenGL errors were not logged at all)
+  if (report.placebo_errors || report.disabled_hooks || report.gl_errors)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the ways of drawing made ready left {}{}{}, cleared before the first "
+              "frame{}",
+              report.placebo_errors
+                  ? StringUtils::Format("libplacebo errors 0x{:x} (enum pl_render_error)",
+                                        report.placebo_errors)
+                  : std::string(),
+              report.disabled_hooks ? StringUtils::Format("{}{} hook(s) turned off",
+                                                          report.placebo_errors ? ", " : "",
+                                                          report.disabled_hooks)
+                                    : std::string(),
+              report.gl_errors
+                  ? StringUtils::Format("{}{} OpenGL error(s), the first 0x{:04x}",
+                                        report.placebo_errors || report.disabled_hooks ? ", " : "",
+                                        report.gl_errors, report.gl_first)
+                  : std::string(),
+              (report.placebo_errors & PL_RENDER_ERR_DOVI_COMPOSER)
+                  ? "; among them the composer of ETSI GS CCM 001 failed (the frames try it again, "
+                    "and compose by libplacebo's reshaping where it fails)"
+                  : "");
 }
 
 unsigned int CDVBridgeGLES::GetPQTexture() const
-- 
