+namespace
+{
+// Hades: the lines of the log of HDR10+, once per video each (CWinSystemGbm::m_hdr10PlusTold)
+enum HDR10PlusTold : unsigned int
+{
+  TOLD_SENDING = 1,
+  TOLD_NO_DRIVER = 2,
+  TOLD_MISSING = 4,
+};
+} // namespace
+
+void CWinSystemGbm::ResetHDR10Plus()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (m_hdr10Plus.Active() && connector &&
+      connector->SupportsProperty(CHDR10PlusOutput::PROPERTY))
+    drm->AddProperty(connector, CHDR10PlusOutput::PROPERTY, 0);
+  m_hdr10Plus.NewVideo();
+  m_hdr10PlusTold = 0;
+}
+
+void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& payload)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return;
+
+  const auto info = DisplayInfo();
+  CHDR10PlusOutput::Output output;
+  output.pq = m_eotf == KODI::UTILS::Eotf::PQ;
+  output.display = info && info->SupportsHDR10Plus();
+  output.driver = connector->SupportsProperty(CHDR10PlusOutput::PROPERTY);
+
+  if (payload && output.pq && output.display && !output.driver &&
+      !(m_hdr10PlusTold & TOLD_NO_DRIVER))
+  {
+    m_hdr10PlusTold |= TOLD_NO_DRIVER;
+    CLog::Log(LOGINFO, "HDR10+: the display declares HDR10+, but its driver has no {} on this "
+                       "connector: the video goes out as HDR10",
+              CHDR10PlusOutput::PROPERTY);
+  }
+
+  switch (m_hdr10Plus.Next(output, payload))
+  {
+    case CHDR10PlusOutput::Step::SEND:
+    {
+      CDRMPropertyBlob& blob = m_hdr10PlusBlobs[m_hdr10PlusNextBlob];
+      blob = CDRMPropertyBlob(drm->GetFileDescriptor(), payload->data(), payload->size());
+      m_hdr10PlusNextBlob = (m_hdr10PlusNextBlob + 1) % m_hdr10PlusBlobs.size();
+      if (!blob.IsValid() || !drm->AddProperty(connector, CHDR10PlusOutput::PROPERTY, blob.Get()))
+      {
+        CLog::Log(LOGWARNING, "HDR10+: the metadata of a frame could not be queued: it goes out "
+                              "as HDR10");
+        break;
+      }
+      m_hdr10Plus.Queued(blob.Get(), payload);
+      if (!(m_hdr10PlusTold & TOLD_SENDING))
+      {
+        m_hdr10PlusTold |= TOLD_SENDING;
+        CLog::Log(LOGINFO, "HDR10+: the dynamic metadata of each frame goes out with it ({}; the "
+                           "display declares application version {})",
+                  CHDR10PlusOutput::PROPERTY, info->HDR10PlusVersion());
+      }
+      break;
+    }
+    case CHDR10PlusOutput::Step::CLEAR:
+      if (drm->AddProperty(connector, CHDR10PlusOutput::PROPERTY, 0))
+        m_hdr10Plus.Queued(0, std::nullopt);
+      if (!payload && output.pq && !(m_hdr10PlusTold & TOLD_MISSING))
+      {
+        m_hdr10PlusTold |= TOLD_MISSING;
+        CLog::Log(LOGINFO, "HDR10+: a frame without HDR10+ metadata goes out as HDR10 (the next "
+                           "one with metadata sends it again)");
+      }
+      break;
+    case CHDR10PlusOutput::Step::NOTHING:
+      break;
+  }
+}
+
+void CWinSystemGbm::HDR10PlusCommitted()
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty(CHDR10PlusOutput::PROPERTY))
+    return;
