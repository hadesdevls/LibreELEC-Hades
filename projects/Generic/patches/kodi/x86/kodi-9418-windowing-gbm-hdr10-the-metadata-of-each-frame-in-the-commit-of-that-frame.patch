+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief HDR10+ out of the window system: the dynamic metadata of each frame, in the commit that
+ *        flips that frame (CWinSystemGbm::SetHDR10Plus())
+ *
+ * One path for every driver. A driver that can send the HDR10+ vendor-specific InfoFrame next to
+ * the HDR one, and change it with a flip and never with a change of mode, gives its connectors
+ * HDR10PLUS_VSIF: a blob of the 27 bytes of its payload (KODI::UTILS::HDR10PLUS), 0 for none.
+ * The Hades patches give it: nvidia-open-kernel-modules-9020 (Turing, Ampere and Ada over HDMI,
+ * Ada over DisplayPort, T239 and Blackwell over both), linux-9980 (amdgpu) and linux-9981
+ * (i915 and xe). A driver refuses, in the commit, what it cannot send.
+ *
+ * The payload of a frame goes out only while the HDR of its video is signalled as PQ (HDR10:
+ * HDR10+ is HDR10 and its metadata), the display declares HDR10+ (its HDR10+ vendor-specific
+ * video data block, application version 1 or later) and the connector has HDR10PLUS_VSIF.
+ * Otherwise, and for a frame without HDR10+ metadata, what was queued is taken away: the output
+ * is plain HDR10, exactly as without this. The HDR InfoFrame is never touched here.
+ *
+ * A driver that does not take it: the commits that carried it fall back to the request before
+ * (CDRMAtomic), so what the kernel keeps for HDR10PLUS_VSIF (the values that accepted commits
+ * set: CDRMObject::GetPropertyValue()) is never one that was queued. After REFUSED_AFTER commits
+ * like that HDR10+ stops for the video, and the output is HDR10. A new video tries again
+ * (NewVideo()).
+ *
+ * Only what is decided is here, with nothing of DRM in it, so that a test can run it.
+ */
+class CHDR10PlusOutput
+{
+public:
+  static constexpr const char* PROPERTY = "HDR10PLUS_VSIF";
+  static constexpr std::size_t PAYLOAD_SIZE = 27;
+  using Payload = std::array<uint8_t, PAYLOAD_SIZE>;
+  //! Commits whose HDR10PLUS_VSIF in the kernel is none of the values queued, before the driver
+  //! is taken as refusing it
+  static constexpr unsigned int REFUSED_AFTER = 8;
+
+  enum class Step
+  {
+    NOTHING, //!< the request carries what it needs already
+    SEND, //!< queue the payload of this frame
+    CLEAR, //!< queue 0: no HDR10+ InfoFrame
+  };
+
+  struct Output
+  {
+    bool pq = false; //!< the HDR of the video is signalled, as PQ
+    bool display = false; //!< the display declares HDR10+
+    bool driver = false; //!< the connector has HDR10PLUS_VSIF
+  };
+
+  //! What to queue for a frame (payload: its HDR10+ metadata, nothing without)
+  Step Next(const Output& output, const std::optional<Payload>& payload) const
+  {
+    const bool on = output.pq && output.display && output.driver && !m_refused;
+    if (on && payload)
+      return m_queued == payload ? Step::NOTHING : Step::SEND;
+    return m_queued ? Step::CLEAR : Step::NOTHING;
+  }
+
+  //! value was queued for HDR10PLUS_VSIF (a blob id, 0 for none), for payload (nothing for none)
+  void Queued(uint64_t value, const std::optional<Payload>& payload)
+  {
+    m_queued = payload;
+    m_recent[m_next] = value;
+    m_next = (m_next + 1) % m_recent.size();
+    m_pending = true;
+  }
+
+  //! A commit was made; kernel is HDR10PLUS_VSIF as the kernel keeps it after it. True when this
+  //! commit makes the driver taken as refusing HDR10+ (once).
+  bool Committed(std::optional<uint64_t> kernel)
+  {
+    if (!m_pending || m_refused)
+      return false;
+    for (uint64_t value : m_recent)
+    {
+      if (kernel && value == *kernel && (value != 0 || !m_queued))
+      {
+        m_pending = false;
+        m_unseen = 0;
+        return false;
+      }
+    }
+    if (++m_unseen < REFUSED_AFTER)
+      return false;
+    m_refused = true;
+    return true;
+  }
+
+  //! A new video, or the end of one: nothing is queued from here, and a driver that refused gets
+  //! another try
+  void NewVideo()
+  {
+    m_queued.reset();
+    m_recent.fill(UINT64_MAX);
+    m_pending = false;
+    m_unseen = 0;
+    m_refused = false;
+  }
+
+  bool Refused() const { return m_refused; }
+  bool Active() const { return m_queued.has_value(); }
+
+private:
+  std::optional<Payload> m_queued;
+  std::array<uint64_t, 4> m_recent{UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX};
+  std::size_t m_next = 0;
+  bool m_pending = false;
+  unsigned int m_unseen = 0;
+  bool m_refused = false;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
