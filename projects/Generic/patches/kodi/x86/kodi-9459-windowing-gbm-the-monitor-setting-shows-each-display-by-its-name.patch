+/*!
+ * \brief The name that a display gives itself: the text of the display product name descriptor
+ *        (tag 0xFC) of the base block of its EDID (VESA E-EDID 1.4, 3.10.3), without the line
+ *        feed that ends it and the spaces that pad it
+ *
+ * libdisplay-info reads the same text for the model of a display (di_info_get_model(), which
+ * Kodi logs as the "model" of the display in use). It is read here on its own, without the rest
+ * of the EDID: the settings ask for it each time they list the monitors, and the parser of
+ * libdisplay-info writes its warnings about an EDID to the log each time it reads one.
+ *
+ * \return empty for an EDID without one; for a base block that is not valid (its header or its
+ *         checksum), which says nothing that can be trusted; for a text that is not printable
+ *         ASCII
+ */
+inline std::string EdidDisplayName(const std::vector<uint8_t>& edid)
+{
+  constexpr std::size_t BLOCK = 128;
+  constexpr uint8_t HEADER[8] = {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00};
+  if (edid.size() < BLOCK || !std::equal(std::begin(HEADER), std::end(HEADER), edid.begin()))
+    return {};
+
+  unsigned int sum = 0;
+  for (std::size_t i = 0; i < BLOCK; ++i)
+    sum += edid[i];
+  if (sum % 256 != 0)
+    return {};
+
+  // The four 18-byte descriptors of the base block; a display descriptor, not a detailed
+  // timing, begins with three zero bytes and has its tag in the fourth
+  for (const std::size_t at : {std::size_t{54}, std::size_t{72}, std::size_t{90}, std::size_t{108}})
+  {
+    if (edid[at] != 0 || edid[at + 1] != 0 || edid[at + 2] != 0 || edid[at + 3] != 0xFC)
+      continue;
+
+    std::string name;
+    for (std::size_t i = at + 5; i < at + 18 && edid[i] != 0x0A; ++i)
+    {
+      if (edid[i] < 0x20 || edid[i] > 0x7E)
+        return {};
+      name += static_cast<char>(edid[i]);
+    }
+    while (!name.empty() && name.back() == ' ')
+      name.pop_back();
+    while (!name.empty() && name.front() == ' ')
+      name.erase(name.begin());
+    return name;
+  }
+  return {};
+}
+
+/*!
+ * \brief How a graphics device is shown to the user: the maker for its driver ("nvidia-drm":
+ *        NVIDIA; "amdgpu": AMD; "i915", "xe": Intel), with the place of the device on its bus
+ *        where two devices have the same driver (DeviceNames()); the driver itself for another
+ */
+inline std::string DeviceLabel(const std::string& device)
+{
+  const std::size_t space = device.find(' ');
+  const std::string driver = device.substr(0, space);
+  const std::string place = space == std::string::npos ? std::string() : device.substr(space);
+  if (driver == "nvidia-drm" || driver == "nouveau")
+    return "NVIDIA" + place;
+  if (driver == "amdgpu" || driver == "radeon")
+    return "AMD" + place;
+  if (driver == "i915" || driver == "xe")
+    return "Intel" + place;
+  return device;
+}
+
+/*!
+ * \brief How an output is shown to the user: the name that its display gives itself, with the
+ *        name of the output ("LG TV SSCR2 (HDMI-A-2)"), and with its graphics device where
+ *        \p withDevice ("Odyssey G60SD (DP-2, NVIDIA)"); without a name of its display, the name
+ *        of the output, alone or with its device ("HDMI-A-1 (AMD)")
+ */
+inline std::string OutputLabel(const DRMOutput& output, bool withDevice)
+{
+  const bool device = withDevice && !output.device.empty();
+  if (output.model.empty())
+    return device ? output.name + " (" + DeviceLabel(output.device) + ")" : output.name;
+  return output.model + " (" + output.name + (device ? ", " + DeviceLabel(output.device) : "") +
+         ")";
+}
+
+/*!
+ * \brief An output as the settings offer it: what is kept in the settings when it is chosen,
+ *        and what is shown for it
+ */
+struct DRMOutputOption
+{
+  std::string value; //!< as OfferedOutputNames() names it
+  std::string label; //!< as OutputLabel() shows it
+};
+
+/*!
+ * \brief The connected outputs of all the devices as the settings offer them: under the names
+ *        of OfferedOutputNames(), in its order, each shown by OutputLabel(), with its graphics
+ *        device where connected outputs of more than one device are offered
+ *
+ * The names that are kept do not change: a choice saved by an earlier build still names its
+ * output.
+ */
+inline std::vector<DRMOutputOption> OfferedOutputs(
+    const std::vector<std::vector<DRMOutput>>& devices)
+{
+  const std::vector<std::string> names = OfferedOutputNames(devices);
+
+  const auto withConnected = std::ranges::count_if(
+      devices, [](const std::vector<DRMOutput>& outputs)
+      { return std::ranges::any_of(outputs, [](const DRMOutput& o) { return o.connected; }); });
+
+  std::vector<DRMOutputOption> options;
+  std::size_t next = 0;
+  for (const auto& outputs : devices)
+  {
+    for (const DRMOutput& output : outputs)
+    {
+      if (!output.connected || next >= names.size())
+        continue;
+      options.push_back({names[next++], OutputLabel(output, withConnected > 1)});
+    }
+  }
+  return options;
+}
+
 } // namespace GBM
 } // namespace WINDOWING
 } // namespace KODI
