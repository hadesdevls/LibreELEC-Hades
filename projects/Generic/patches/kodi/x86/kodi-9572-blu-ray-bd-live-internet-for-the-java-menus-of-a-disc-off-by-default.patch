diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index ab2ced6..2c67ad7 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -1889,6 +1889,17 @@ void CDVDInputStreamBluray::SetupPlayerSettings()
     region = BLURAY_REGION_A;
   }
   bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_REGION_CODE, static_cast<uint32_t>(region));
+#ifdef BD_HAVE_BDJ_NETWORK_SETTING
+  // Hades, BD-Live: the Internet for the Java of a disc, off by default (bluray.hadesbdlive);
+  // libbluray takes it before the disc is handed to the BD-J service
+  const bool bdLive = CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+      std::string(KODI::BLURAYJAVA::BDLIVE_SETTING));
+  bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_BDJ_NETWORK,
+                        bdLive ? BLURAY_BDJ_NETWORK_INTERNET : BLURAY_BDJ_NETWORK_NONE);
+  CLog::Log(LOGINFO, "CDVDInputStreamBluray::Open - BD-Live: {}",
+            bdLive ? "on: the Java of a disc may reach IPv4 addresses of the Internet only"
+                   : "off: the Java of a disc has no network");
+#endif
   bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_PARENTAL, 99);
   bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_3D_CAP, 0xffffffff);
 #if (BLURAY_VERSION >= BLURAY_VERSION_CODE(1, 0, 2))
diff --git a/xbmc/filesystem/BlurayCallback.cpp b/xbmc/filesystem/BlurayCallback.cpp
index e351f0a..a69c104 100644
--- a/xbmc/filesystem/BlurayCallback.cpp
+++ b/xbmc/filesystem/BlurayCallback.cpp
@@ -84,7 +84,9 @@ void CBlurayCallback::bluray_logger(const char* msg)
   // of bdj.c, and with the mask that Kodi sets (DBG_CRIT | DBG_BLURAY | DBG_NAV) only the
   // critical ones of that file reach here: a few per disc. They answer "why is there no menu",
   // so they go to the log without debug logging.
-  const bool bdj = msg && std::string_view(msg).starts_with("bdj.c:");
+  // BD-Live: each name and connection, allowed or refused (libbluray and the BD-J service)
+  const bool bdj = msg && (std::string_view(msg).starts_with("bdj.c:") ||
+                           std::string_view(msg).find("BD-Live: ") != std::string_view::npos);
   CLog::Log(bdj ? LOGINFO : LOGDEBUG, "CBlurayCallback::Logger - {}", msg);
 }
 
