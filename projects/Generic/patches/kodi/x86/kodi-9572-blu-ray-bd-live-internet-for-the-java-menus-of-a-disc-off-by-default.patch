 //! The Java runtime add-on of LibreELEC's repository, no longer used
 inline constexpr std::string_view JRE_ADDON_ID = "tools.jre.zulu";
 /*!
- * rief Whether the BD-J service of this build lets the Java of a disc reach the Internet when
- *        BD-Live is on. It does not yet: the service has no network (its unit, hades-bdj@.service,
- *        has PrivateNetwork=), because the names of the Internet are resolved by a server of the
- *        local network, which the service must not reach. To be changed with the unit.
+ * \brief Whether the BD-J service of this build lets the Java of a disc reach the Internet when
+ *        BD-Live is on: with it on, libbluray hands the disc to hades-bdj-net@.service, which
+ *        reaches IPv4 addresses of the Internet only, with names resolved by Kodi's libbluray.
  */
-inline constexpr bool SERVICE_HAS_NETWORK = false;
+inline constexpr bool SERVICE_HAS_NETWORK = true;
 
 struct BdjFacts
 {
