From 5989c77a45d6f8dfd296fb2c7ae10977cd69932b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:52:22 +0000
Subject: [PATCH] VideoPlayer: a decoded picture says only what it is, not what
 a picture before it was

The FFmpeg video codec sets the other HDR type of a picture (HDR10+ of a
Dolby Vision picture) and the layer of its Dolby Vision (strDVELType) only
where the picture has them, and VideoPicture::Reset() cleared neither. The
player decodes every picture into the same VideoPicture
(CVideoPlayerVideo::m_picture, kept from one file to the next of a
playlist), whose default constructor leaves hdrTypeAlt unset. So a picture
of HDR10 that came after one of Dolby Vision with HDR10+ said HDR10+ too,
and before the first such picture the value was whatever that memory held.

CRenderManager::UpdateWholeMultipleVideo() reads hdrTypeAlt to tell whether
the frame rate of the video may go out at a whole-number multiple (SDR and
HDR10 only), and the player keeps the layer of a profile 7 stream for the
details of the library (NoteVideoDVELType()), which an earlier picture
could give.

Both are now set for every picture, as the DRM PRIME codec already does for
hdrTypeAlt, and Reset() clears them. A picture that has them says them as
before.
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp     | 4 ++++
 .../VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp      | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
index 9da9908..0b044ba 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.cpp
@@ -55,6 +55,10 @@ void VideoPicture::Reset()
   pict_type = 0;
 
   hdrType = StreamHdrType::HDR_TYPE_NONE;
+  // Hades: and the other HDR type of the picture and the layer of its Dolby Vision, which a codec
+  // sets only where the picture has them (they were left from an earlier picture, or not set)
+  hdrTypeAlt = StreamHdrType::HDR_TYPE_NONE;
+  strDVELType.clear();
   doviRpuNal.reset();
   doviMetadata.Reset();
   doviSourcePts = AV_NOPTS_VALUE;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 38d89ea..1cf596c 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -2563,6 +2563,11 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   pVideoPicture->qscale_type = 0;
 
   pVideoPicture->hdrType = m_hints.hdrType;
+  // Hades: what this picture is, not what one before it was: the other HDR type (HDR10+ of a
+  // Dolby Vision picture, below) and the layer of its Dolby Vision are set only where the picture
+  // has them, and the player gives the same VideoPicture for every picture it decodes
+  pVideoPicture->hdrTypeAlt = StreamHdrType::HDR_TYPE_NONE;
+  pVideoPicture->strDVELType.clear();
 #ifdef HAVE_DVBRIDGE
   // Hades: Dolby Vision made from HDR10+ or measured is that for native output only (Open())
   if ((m_dvFromHdr10Plus || m_dvMeasured) && !m_dvNativeOutput)
-- 
