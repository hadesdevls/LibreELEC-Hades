From e5e84742db37100ecdf6b0a2f44e907dd16b6e0f Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 11 Oct 2026 16:28:21 +0100
Subject: [PATCH] [pictures] Don't stall a slideshow on a picture that won't
 load

The check for a video looked the slide up by its image slot (0 or 1)
instead of the current slide. When one of the first two slides was a
video, a picture that failed to load was neither marked unplayable nor
skipped, and a running slideshow stopped on it for good.
---
 xbmc/pictures/GUIWindowSlideShow.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/xbmc/pictures/GUIWindowSlideShow.cpp b/xbmc/pictures/GUIWindowSlideShow.cpp
index cac7031..8b1f44b 100644
--- a/xbmc/pictures/GUIWindowSlideShow.cpp
+++ b/xbmc/pictures/GUIWindowSlideShow.cpp
@@ -467,13 +467,13 @@ void CGUIWindowSlideShow::Process(unsigned int currentTime, CDirtyRegionList &re
       {
         CLog::Log(LOGERROR, "Error loading the current image {}: {}", m_iCurrentSlide,
                   m_slides.at(m_iCurrentSlide)->GetPath());
-        if (!IsVideo(*m_slides.at(m_iCurrentPic)))
+        if (!IsVideo(*m_slides.at(m_iCurrentSlide)))
         {
           // try next if we are in slideshow
           CLog::Log(LOGINFO, "set image {} unplayable", m_slides.at(m_iCurrentSlide)->GetPath());
           m_slides.at(m_iCurrentSlide)->SetProperty("unplayable", true);
         }
-        if (m_bLoadNextPic || (bSlideShow && !m_bPause && !IsVideo(*m_slides.at(m_iCurrentPic))))
+        if (m_bLoadNextPic || (bSlideShow && !m_bPause && !IsVideo(*m_slides.at(m_iCurrentSlide))))
         {
           // change to next item, wait loading.
           m_iCurrentSlide = m_iNextSlide;
-- 
