From 9af714f75a3a328f946a7f67daed2568a6e1f05e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:52:09 +0000
Subject: [PATCH] VideoRenderers: tell the display the colours that the shaders
 draw

Without HDR passthrough, the shaders of the GLES renderer draw a picture
of BT.2020 primaries in BT.709 (their destination primaries are BT.709
then), and the display was told the colorimetry of the picture's own
matrix, BT.2020. An SDR video in BT.2020, an HLG video on an output that
sends no HDR with one of Kodi's own tone mapping methods, and a PQ video
with the tone mapping off went out as BT.709 pixels in an AVI InfoFrame
that says BT.2020, which a display that honours it shows too saturated.
Kodi's fix of #28468 covers a tone mapped PQ picture alone.

KODI::UTILS::DrawnColorSpace() is the matrix by which the display is told
the colours of a drawn picture: the picture's own with HDR passthrough,
none (the default colorimetry, BT.709 for HD video) without it. Configure()
tells it once HDR passthrough is known, and a change of the tone mapping
tells the same. A picture whose HDR is passed through, one mapped by the
bridge (told BT.709 already), and every picture of BT.709 or BT.601 are
told what they were before.

Measured on the host with Kodi's own GetColorimetry() and the rule of the
connector: the display is told BT.2020 exactly when the pixels are BT.2020
in all 20 cases; with the rule before, 8 of them were told BT.2020
for pixels drawn in BT.709.
---
 .../VideoRenderers/LinuxRendererGLES.cpp      | 21 ++++++++++++++++++-
 xbmc/utils/HDRUtils.h                         | 18 ++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index d4d1d0e3..42a6d93 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -438,6 +438,22 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     CServiceBroker::GetWinSystem()->SetColorimetry(&picture);
     m_passthroughHDR = CServiceBroker::GetWinSystem()->SetHDR(&picture);
   }
+  // Hades: the display is told the colours as they are drawn (KODI::UTILS::DrawnColorSpace()). The
+  // colorimetry set above is that of the matrix of the picture; without HDR passthrough the shaders
+  // draw a BT.2020 picture in BT.709 (an SDR one in BT.2020, an HLG one, a PQ one with the tone
+  // mapping off), and the display was told BT.2020 for it.
+  {
+    const VideoPicture& told = convert || plain ? hdr10 : picture;
+    if (!m_passthroughHDR && (told.color_space == AVCOL_SPC_BT2020_NCL ||
+                              told.color_space == AVCOL_SPC_BT2020_CL))
+    {
+      VideoPicture drawn{};
+      drawn.color_space = KODI::UTILS::DrawnColorSpace(told.color_space, m_passthroughHDR);
+      drawn.iWidth = told.iWidth;
+      drawn.iHeight = told.iHeight;
+      CServiceBroker::GetWinSystem()->SetColorimetry(&drawn);
+    }
+  }
   // Hades: the player information tells what the video says of itself, which SetHDR() took from the
   // picture made for the output (HDR10 or SDR of BT.709 for Dolby Vision reconstructed, SDR for an
   // HDR10 or HLG picture mapped to SDR, the peak told for one adapted to the display): it is told of
@@ -3123,7 +3139,10 @@ void CLinuxRendererGLES::CheckVideoParameters(int index)
     if (toneMap != m_toneMap)
     {
       VideoPicture tmp{};
-      tmp.color_space = toneMap ? AVCOL_SPC_UNSPECIFIED : buf.m_srcColSpace;
+      // (Hades: and without tone mapping, the colours as they are drawn: BT.709 where the HDR is
+      // not passed through, KODI::UTILS::DrawnColorSpace(); before, the picture's BT.2020 again)
+      tmp.color_space = toneMap ? AVCOL_SPC_UNSPECIFIED
+                                : KODI::UTILS::DrawnColorSpace(buf.m_srcColSpace, m_passthroughHDR);
       tmp.iWidth = m_sourceWidth;
       tmp.iHeight = m_sourceHeight;
       CServiceBroker::GetWinSystem()->SetColorimetry(&tmp);
diff --git a/xbmc/utils/HDRUtils.h b/xbmc/utils/HDRUtils.h
index e488625..5f2183f 100644
--- a/xbmc/utils/HDRUtils.h
+++ b/xbmc/utils/HDRUtils.h
@@ -29,6 +29,24 @@ enum hdmi_metadata_type
 
 Colorimetry GetColorimetry(const VideoPicture& picture);
 const char* ColorimetryToString(Colorimetry colorimetry);
+
+/*!
+ * \brief Hades: the colour matrix by which the display is told the colours of a picture that a
+ *        renderer draws (GetColorimetry() reads the picture's color_space)
+ *
+ * The picture's own where its HDR is passed through: it is drawn in its own primaries. None
+ * (AVCOL_SPC_UNSPECIFIED, which GetColorimetry() takes as BT.709 for HD video and BT.601 for SD:
+ * the default colorimetry of the connector either way) where it is not: the renderer's shaders then
+ * draw it in BT.709, converting other primaries (CLinuxRendererGLES::LoadShaders(): the destination
+ * primaries are BT.709 without HDR passthrough). Told the picture's own, an SDR picture in BT.2020,
+ * an HLG one on an output without HDR, or a PQ one with the tone mapping off, went out in BT.709 with
+ * the display told BT.2020, and a display that takes BT.2020 showed its colours too saturated (the
+ * fix of Kodi #28468 covers a tone mapped PQ picture alone).
+ */
+constexpr AVColorSpace DrawnColorSpace(AVColorSpace picture, bool hdrPassedThrough)
+{
+  return hdrPassedThrough ? picture : AVCOL_SPC_UNSPECIFIED;
+}
 Eotf GetEOTF(const VideoPicture& picture);
 const AVMasteringDisplayMetadata* GetMasteringDisplayMetadata(const VideoPicture& picture);
 const AVContentLightMetadata* GetContentLightMetadata(const VideoPicture& picture);
-- 
