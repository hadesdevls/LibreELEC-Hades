From 2bbf7e2bdef537996caca6b202f3f92044a0fab1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:31:01 +0000
Subject: [PATCH] DVBridge: the line that gives up the direct way says why it
 failed

Where the direct way into the transport fails on a frame and the
composed way draws it, nothing is logged of the direct one (the frame is
shown); after three such frames the direct way is given up for the rest
of the bridge's life with "packed render unavailable; retaining
full-precision composition path", which did not say why. That line now
gives the reason of the last failure (dvbridge_render_refused(), else
dvbridge_render_not_drawn()), so that a GPU on which the direct way does
not work can be told from one on which a stream's metadata keep it out.
---
 xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 2fefc58..faaaa02 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -690,6 +690,9 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   // frames and non-fullscreen geometry retain the original 32F composition.
   // (Hades: with the source transport, also a picture drawn at its own size elsewhere on the raster.)
   bool packedFailed = false;
+  // Hades: why the direct way failed, for the line that gives it up (the composed way that drew the
+  // frame after it has said nothing of it)
+  const char* packedWhy = nullptr;
   if (allowPacked && m_directUsable && m_scanout && dvbridge_render_direct_fits(m_renderer, geometry))
   {
     m_direct = dvbridge_render_packed(m_renderer, &bl.frame, metadata.Data(), metadata.Size(),
@@ -698,6 +701,8 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
     if (!m_direct)
     {
       packedFailed = true;
+      packedWhy = dvbridge_render_refused(m_renderer) ? dvbridge_render_refused(m_renderer)
+                                                      : dvbridge_render_not_drawn(m_renderer);
       // Hades: libplacebo's errors and cache only; the metadata goes on from the last presented
       // frame (a reset here restarted its id and refreshed the scene of the next frame)
       dvbridge_renderer_recover(m_renderer);
@@ -712,7 +717,10 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   // frame that neither path accepts (its metadata) says nothing about the packed path.
   if (packedFailed && m_prepared && ++m_directFailures >= 3)
   {
-    CLog::Log(LOGINFO, "DVBridge: packed render unavailable; retaining full-precision composition path");
+    CLog::Log(LOGINFO,
+              "DVBridge: packed render unavailable; retaining full-precision composition path (the "
+              "last time it failed: {})",
+              packedWhy ? packedWhy : "no reason given");
     m_directUsable = false;
   }
   else if (m_direct)
