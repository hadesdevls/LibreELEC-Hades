diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1fd656b..881f365 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1243,6 +1243,8 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   const bool direct = m_dvPath[layered].Direct(foreseen);
   m_dvFrame = m_dvBridge->PrepareHardware(layer, enhancement, metadata, geometry,
                                           overlayFree && direct);
+  if (m_dvFrame && overlayFree)
+    m_dvPlainDirect = m_dvBridge->Direct() ? 1 : 0;
   // The load it turned out to be of: the same frame, with or without its residual.
   uint64_t load = 0;
   if (m_dvFrame && foreseen != 0)
@@ -1406,6 +1408,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
   m_dvAheadLatencyMs = 0.0f;
   m_dvAheadModeRead = false;
   m_dvStepRead = false;
+  m_dvPlainDirect = -1;
   if (m_dvAhead.Ended())
     CLog::Log(LOGWARNING,
               "DVBridge: frames could not be presented a frame ahead in several videos in a row: "
@@ -1494,7 +1497,8 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.layers", ""}, {"hades.dv.cm", ""}, {"hades.dv.l1", ""}, {"hades.dv.l2", ""},
       {"hades.dv.l5", ""}, {"hades.dv.l6", ""}, {"hades.dv.mode", ""}, {"hades.dv.shown", ""},
       {"hades.dv.notshown", ""}, {"hades.dv.gap", ""}, {"hades.dv.l1changes", ""},
-      {"hades.dv.fel", ""}};
+      {"hades.dv.fel", ""}, {"hades.dv.gpu", ""}, {"hades.dv.headroom", ""},
+      {"hades.dv.path", ""}, {"hades.dv.ahead", ""}, {"hades.dv.step", ""}};
   if (native && m_dvBridge && m_dvBridge->GetPresentedDetail().valid)
   {
     const auto& d = m_dvBridge->GetPresentedDetail();
