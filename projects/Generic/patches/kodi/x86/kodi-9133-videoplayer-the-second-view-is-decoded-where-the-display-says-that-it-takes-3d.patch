+//! The values of the setting for the two views (videoplayer.hades3dmvc): never,
+inline constexpr int SETTING_OFF = 0;
+//! ... where the display says that it takes stereoscopic 3D,
+inline constexpr int SETTING_AUTOMATIC = 1;
+//! ... on any display
+inline constexpr int SETTING_ALWAYS = 2;
+
+/*!
+ * \brief Whether the setting has both views of a stream decoded
+ * \param setting its value; one that is none of the three is taken as off
+ * \param stereoDisplay the display says that it takes stereoscopic 3D
+ *
+ * Decoding the second view takes the decoding of the video from the hardware, and makes of it
+ * a stereoscopic video, with all that Kodi asks and does for one. Where nothing says that the
+ * second view can be shown, a video of two views stays the 2D video that it always was, unless
+ * the user says otherwise (for anaglyph glasses, or for a 3D display that does not say what it
+ * is).
+ */
+constexpr bool Allowed(int setting, bool stereoDisplay)
+{
+  return setting == SETTING_ALWAYS || (setting == SETTING_AUTOMATIC && stereoDisplay);
+}
