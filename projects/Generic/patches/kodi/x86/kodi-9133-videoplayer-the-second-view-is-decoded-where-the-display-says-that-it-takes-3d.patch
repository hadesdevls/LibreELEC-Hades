+/*!
+ * \brief Whether a display says that it takes stereoscopic 3D
+ * \param modes the modes of its connector: a driver that has 3D lists those of the display that
+ *        have a 3D layout
+ * \param edid what its EDID says (Parse()), for a driver that lists no such modes
+ */
+inline bool TakesStereo(std::span<const Mode> modes, const Edid3D& edid)
+{
+  const bool listed = std::ranges::any_of(modes, [](const Mode& mode)
+  {
+    const Layout layout = LayoutOf(mode.flags);
+    return layout == Layout::FRAME_PACKING || layout == Layout::TOP_AND_BOTTOM ||
+           layout == Layout::SIDE_BY_SIDE_HALF;
+  });
+  return listed || (edid.read && (edid.present || !edid.listed.empty()));
+}
