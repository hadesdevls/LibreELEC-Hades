index 3dd536d..b2f3120 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -687,6 +687,70 @@ constexpr DualVerdict DualVerdictOf(
                                                          : DualVerdict::DOLBY_VISION;
 }
 
+//! Hades: a file that carries the picture twice, as a video stream with Dolby Vision of its own and one
+//! of HDR10 or HDR10+ without it (CDVDDemuxFFmpeg::ChooseHdrStream()): which of the two plays
+enum class TwoStreams
+{
+  KODI, //!< the one Kodi opens: the display takes neither, or HDR10+ only and that stream has none
+  DOLBY_VISION, //!< the Dolby Vision stream
+  HDR10PLUS, //!< the HDR10+ stream
+};
+
+/*!
+ * \brief Hades: which of the two streams of such a file plays
+ * \param setting videoscreen.hadesdualhdr (DualHdr), as for one stream with both
+ * \param nativeDV, hdr10Plus what the display takes, as for one stream with both (DualVerdictOf())
+ * \param hdr10PlusSeen the first packets of the other stream carry HDR10+ metadata (it is HDR10+, not
+ *        only HDR10)
+ *
+ * On a display that takes both, the setting chooses, as for one stream with both, HDR10+ only where that
+ * stream has HDR10+ metadata (an HDR10 picture alone is not what it asks for). On a display that takes
+ * one of the two, that one: the stream's own Dolby Vision natively, or its own HDR10+ metadata, rather
+ * than the other one made into it. Anywhere else, the stream Kodi opens.
+ */
+constexpr TwoStreams TwoStreamsOf(int setting, bool nativeDV, bool hdr10Plus, bool hdr10PlusSeen)
+{
+  if (nativeDV && hdr10Plus)
+    return setting == static_cast<int>(DualHdr::HDR10PLUS) && hdr10PlusSeen
+               ? TwoStreams::HDR10PLUS
+               : TwoStreams::DOLBY_VISION;
+  if (nativeDV)
+    return TwoStreams::DOLBY_VISION;
+  if (hdr10Plus && hdr10PlusSeen)
+    return TwoStreams::HDR10PLUS;
+  return TwoStreams::KODI;
+}
+
+//! Hades: TwoStreamsOf() depends on whether the other stream has HDR10+ metadata (its first packets are
+//! then read before the streams open)
+constexpr bool TwoStreamsNeedHdr10Plus(int setting, bool nativeDV, bool hdr10Plus)
+{
+  return TwoStreamsOf(setting, nativeDV, hdr10Plus, true) !=
+         TwoStreamsOf(setting, nativeDV, hdr10Plus, false);
+}
+
+//! Hades: the stream of the two that plays (their ids; -1: the one Kodi opens)
+constexpr int TwoStreamsPick(TwoStreams verdict, int dolbyVision, int hdr10)
+{
+  return verdict == TwoStreams::DOLBY_VISION ? dolbyVision
+         : verdict == TwoStreams::HDR10PLUS  ? hdr10
+                                             : -1;
+}
+
+//! Hades: the verdict, for the log
+inline const char* TwoStreamsText(TwoStreams verdict)
+{
+  switch (verdict)
+  {
+    case TwoStreams::DOLBY_VISION:
+      return "the Dolby Vision stream plays";
+    case TwoStreams::HDR10PLUS:
+      return "the HDR10+ stream plays";
+    default:
+      return "the stream Kodi opens plays";
+  }
+}
+
 //! Hades: the video is sent as the HDR10+ it also is (CDVDStreamInfo::doviHdr10PlusWins)
 constexpr bool Hdr10PlusWins(DualVerdict verdict)
 {
@@ -1352,6 +1416,9 @@ void Hdr10PlusFound();
 //! sent with now (DualVerdictOf(), as the settings, the choice of the video and the display say), told in
 //! the log. Any thread.
 DualVerdict DualHdr10PlusFound(int profile, int compatibility);
+//! Hades: for TwoStreamsOf(), of a file with a Dolby Vision video stream and an HDR10+ one:
+//! videoscreen.hadesdualhdr and what the display takes. Any thread.
+void TwoStreamsDisplay(int& setting, bool& nativeDV, bool& hdr10Plus);
 //! The video stream of the video that plays opened (VideoPlayer, each time it opens): its profile
 //! and the compatibility of its base layer, for OutputChoiceAvailable()
 void VideoStreamOpened(const CDVDStreamInfo& stream);
