+// Hades: a file that carries the picture twice, as a video stream with a Dolby Vision record of its own
+// and one of HDR10 (or HDR10+) without Dolby Vision, plays the one that videoscreen.hadesdualhdr and the
+// display choose (DVBRIDGE::TwoStreamsOf()), as a stream with both does; Kodi opened the first stream
+// flagged default, or the first. Whether the HDR10 stream has HDR10+ metadata is known from its first
+// packets, read ahead only where the choice depends on it (FindHdr10Plus()). Two tracks of one Dolby
+// Vision picture (CDVLayerMerge) are one stream here, not two; a stream the user chose for the file
+// stays (VideoPlayer).
+void CDVDDemuxFFmpeg::ChooseHdrStream()
+{
+  m_preferredVideo = -1;
+  int dolbyVision = -1;
+  int hdr10 = -1;
+  int profile = 0;
+  for (const auto& [index, stream] : m_streams)
+  {
+    if (!stream || stream->type != StreamType::VIDEO)
+      continue;
+    const auto* video = static_cast<const CDemuxStreamVideo*>(stream);
+    if (video->hdr_type == StreamHdrType::HDR_TYPE_DOLBYVISION && video->dovi.dv_profile != 0)
+    {
+      if (dolbyVision < 0)
+      {
+        dolbyVision = index;
+        profile = video->dovi.dv_profile;
+      }
+    }
+    else if ((video->hdr_type == StreamHdrType::HDR_TYPE_HDR10 ||
+              video->hdr_type == StreamHdrType::HDR_TYPE_HDR10PLUS) &&
+             video->dovi.dv_profile == 0 && hdr10 < 0)
+      hdr10 = index;
+  }
+  if (dolbyVision < 0 || hdr10 < 0)
+    return;
+  int setting = 0;
+  bool nativeDV = false;
+  bool hdr10Plus = false;
+  DVBRIDGE::TwoStreamsDisplay(setting, nativeDV, hdr10Plus);
+  bool seen = false;
+  std::string looked = "not needed for the choice";
+  if (DVBRIDGE::TwoStreamsNeedHdr10Plus(setting, nativeDV, hdr10Plus))
+    looked = FindHdr10Plus(hdr10, seen);
+  const DVBRIDGE::TwoStreams verdict = DVBRIDGE::TwoStreamsOf(setting, nativeDV, hdr10Plus, seen);
+  m_preferredVideo = DVBRIDGE::TwoStreamsPick(verdict, m_streams[dolbyVision]->uniqueId,
+                                              m_streams[hdr10]->uniqueId);
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: the picture twice, Dolby Vision (stream {}, profile {}) and HDR10 "
+            "(stream {}; HDR10+ metadata in its first packets: {}); the display takes native Dolby "
+            "Vision: {}, HDR10+: {}; \"Videos with both Dolby Vision and HDR10+\" "
+            "(videoscreen.hadesdualhdr): {}: {}",
+            dolbyVision, profile, hdr10, looked, nativeDV ? "yes" : "no", hdr10Plus ? "yes" : "no",
+            setting == static_cast<int>(DVBRIDGE::DualHdr::HDR10PLUS) ? "HDR10+" : "Dolby Vision",
+            DVBRIDGE::TwoStreamsText(verdict));
+}
