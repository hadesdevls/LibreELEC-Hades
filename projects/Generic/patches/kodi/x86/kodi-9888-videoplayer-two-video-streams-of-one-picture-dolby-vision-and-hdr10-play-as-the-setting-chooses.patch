+// Hades: only a file read from its start by a plain input, as PrefetchForSoftTelecine(): a disc has
+// its navigation run inside the reading, and a stream that is live must not be read ahead; the
+// packets go to the player after, as if they had not been read (ReadFrame())
+std::string CDVDDemuxFFmpeg::FindHdr10Plus(int index, bool& seen)
+{
+  static constexpr unsigned int MAX_UNITS = 24;
+  static constexpr size_t MAX_PACKETS = 600;
+  static constexpr size_t MAX_BYTES = 32 * 1024 * 1024;
+  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
+
+  seen = false;
+  if (!m_pFormatContext || !m_pInput || !m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE) ||
+      m_pInput->IsRealtime() || m_checkTransportStream || !m_prefetched.empty() ||
+      m_dvBaseIndex >= 0 || index < 0 ||
+      static_cast<unsigned int>(index) >= m_pFormatContext->nb_streams)
+    return "not known (not read ahead: not a file read from its start by a plain input)";
+  const AVCodecParameters* par = m_pFormatContext->streams[index]->codecpar;
+  if (par->codec_id != AV_CODEC_ID_HEVC)
+    return "not known (not HEVC)";
+  const int lengthSize = CDVLayerMerge::LengthSize(par);
+  unsigned int units = 0;
+  size_t bytes = 0;
+  const auto begin = std::chrono::steady_clock::now();
+  m_timeout.Set(2s);
+  while (!seen && units < MAX_UNITS && m_prefetched.size() < MAX_PACKETS && bytes < MAX_BYTES &&
+         std::chrono::steady_clock::now() - begin < MAX_TIME)
+  {
+    AVPacket* packet = av_packet_alloc();
+    if (!packet)
+      break;
+    if (av_read_frame(m_pFormatContext, packet) < 0)
+    {
+      av_packet_free(&packet);
+      break;
+    }
+    bytes += static_cast<size_t>(std::max(packet->size, 0));
+    m_prefetched.push_back(packet);
+    if (packet->stream_index != index || packet->size <= 0)
+      continue;
+    ++units;
+    seen = !CDVHdr10Plus::Read(packet->data, static_cast<size_t>(packet->size), lengthSize)
+                .t35.empty();
+  }
+  m_timeout.SetInfinite();
+  return seen ? StringUtils::Format("yes, in its access unit {}", units)
+              : StringUtils::Format("none in its first {} access units ({} packets, {} KiB read "
+                                    "ahead)",
+                                    units, m_prefetched.size(), bytes / 1024);
+}
