From 973a9a3755b0f5f3abe9a16fcb58564deddaf860 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 22 Oct 2026 01:37:02 +0100
Subject: [PATCH] fixed: list local drives when browsing for a subtitle

Browse for subtitle offers the video sources as the browser root. The
add-ons virtual source is always among them, so the list is never empty
and CGUIDialogFileBrowser never falls back to local drives. Without a
configured source the root shows only "Video add-ons", which holds no
subtitle files, and a file outside every source cannot be reached.

Drop the add-ons source and add local drives and network locations, as
the other file pickers do.

Fixes #29161
---
 xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp b/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
index d87ea1c..b32c83a 100644
--- a/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
+++ b/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
@@ -35,6 +35,7 @@
 #include "settings/lib/Setting.h"
 #include "settings/lib/SettingDefinitions.h"
 #include "settings/lib/SettingsManager.h"
+#include "storage/MediaManager.h"
 #include "utils/FileUtils.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
@@ -155,6 +156,13 @@ std::string CGUIDialogSubtitleSettings::BrowseForSubtitle()
     strPath.clear();
   }
 
+  // The add-ons virtual source holds no subtitle files, and while present it keeps the file
+  // browser from falling back to local drives, leaving nothing to pick from without a source.
+  std::erase_if(shares,
+                [](const CMediaSource& share) { return URIUtils::IsAddonsPath(share.strPath); });
+  CServiceBroker::GetMediaManager().GetLocalDrives(shares);
+  CServiceBroker::GetMediaManager().GetNetworkLocations(shares);
+
   std::string strMask =
       ".utf|.utf8|.utf-8|.sub|.srt|.smi|.rt|.txt|.ssa|.aqt|.jss|.ass|.vtt|.idx|.zip|.sup";
 
