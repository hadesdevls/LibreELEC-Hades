From f8dd2a8fd1b19648c4316650e234564d4b7eda76 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:16:14 +0000
Subject: [PATCH] windowing/gbm: the HDR output depth that nvidia-drm says
 (NV_OUTPUT_BPC)

On nvidia-drm Kodi could only say that the output goes "up to 10 bits",
from the module parameters: wrong on Turing, where HDR over HDMI went out at
8 (no 10 bpc over HDMI there), and blind to what NVKMS chooses for a display
and a mode. nvidia-open-kernel-modules-9013 adds NV_OUTPUT_BPC, read-only,
the depth NVKMS drives the connector at, set with each commit that sets the
head again (as the one that brings the HDR signalling).

Once the HDR signalling is on, ProbeOutputDepth() reads it and logs "HDR
output: HDR10 goes out at N bits in <mode>, as the driver says
(NV_OUTPUT_BPC)" (a warning, with the possible reasons, at 8), and the
player information shows that depth ("N bits (as the driver says)", and
for Dolby Vision rebuilt as HDR10). Where the property is absent, as
before. Nothing that is sent changes.
---
 addons/skin.estuary/xml/Variables.xml         |  1 +
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 53 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  2 +
 3 files changed, 56 insertions(+)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 936ffa8..cd4bd8e 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -896,6 +896,7 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),setting)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31985])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link) + String.IsEqual(Window(Home).Property(hades.out.depthwhy),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31984])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),link)">$INFO[Window(Home).Property(hades.out.depth)] bits, $INFO[Window(Home).Property(hades.out.linkformat)] ($LOCALIZE[31986])</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),reported)">$INFO[Window(Home).Property(hades.out.depth)] bits ($LOCALIZE[31986])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),fixed)">$INFO[Window(Home).Property(hades.out.depth)] bits ($LOCALIZE[31867])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),upto)">$LOCALIZE[31868] $INFO[Window(Home).Property(hades.out.depth)] bits; $LOCALIZE[31869]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.out.depthkind),driver)">$LOCALIZE[31869]</value>
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index c5fc101..fa3c692 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1486,6 +1486,7 @@ std::string HDRShallowWhy()
 void CWinSystemGbmGLESContext::ResetOutputDepth()
 {
   m_outDepth = DVDepth::UNKNOWN;
+  m_outNvidiaBpc = 0;
   std::unique_lock lock(m_outLinkLock);
   m_outLink = {};
 }
@@ -1504,6 +1505,47 @@ void CWinSystemGbmGLESContext::ProbeOutputDepth()
   const char* what = m_outDepthEotf == KODI::UTILS::Eotf::HLG ? "HLG" : "HDR10";
   if (converting)
     what = "Dolby Vision rebuilt as HDR10";
+  // Hades: nvidia-drm says the depth at which NVKMS drives the connector (NV_OUTPUT_BPC,
+  // nvidia-open-kernel-modules-9013), set with each commit that sets the head again, as the one
+  // that brings the HDR signalling does there. That depth exactly; the format is not said.
+  if (connector && connector->SupportsProperty("NV_OUTPUT_BPC"))
+  {
+    const auto hdr = connector->ReadPropertyValue("HDR_OUTPUT_METADATA");
+    const auto bpc =
+        hdr && *hdr ? connector->ReadPropertyValue("NV_OUTPUT_BPC") : std::optional<uint64_t>{};
+    if (!bpc || !*bpc)
+    {
+      if (++m_outDepthWaits >= WAITS)
+      {
+        m_outDepth = DVDepth::UNANSWERED;
+        CLog::Log(LOGINFO, "{}: the depth of {} is not known: the driver did not say it", prefix,
+                  what);
+      }
+      return;
+    }
+    m_outDepthWaits = 0;
+    m_outNvidiaBpc = static_cast<unsigned int>(*bpc);
+    m_outDepth = *bpc >= 10 ? DVDepth::DEEP : DVDepth::EIGHT;
+    const auto* mode = drm->GetSelectedMode();
+    const std::string where =
+        mode ? StringUtils::Format("{}x{} @ {:.3f} Hz", mode->hdisplay, mode->vdisplay,
+                                   mode->htotal && mode->vtotal
+                                       ? mode->clock * 1000.0 /
+                                             (static_cast<double>(mode->htotal) * mode->vtotal)
+                                       : 0.0)
+             : std::string("this mode");
+    if (*bpc >= 10)
+      CLog::Log(LOGINFO, "{}: {} goes out at {} bits in {}, as the driver says (NV_OUTPUT_BPC)",
+                prefix, what, *bpc, where);
+    else
+      CLog::Log(LOGWARNING,
+                "{}: {} goes out at {} bits in {}, as the driver says (NV_OUTPUT_BPC): it chose no "
+                "more for this display and mode (over HDMI: a display without deep colour, a "
+                "graphics card without 10 bits over HDMI and a display without 12, or a mode that "
+                "does not fit at more); it plays as it would without this question",
+                prefix, what, *bpc, where);
+    return;
+  }
   if (!connector || !connector->SupportsProperty(guard))
   {
     m_outDepth = DVDepth::UNANSWERED;
@@ -2715,6 +2757,10 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       info["hades.dv.depth"] = std::to_string(link.bpc);
       info["hades.dv.depthformat"] = DVBRIDGE::LINK::DisplayName(link.format);
     }
+    // Hades: nvidia-drm said the depth (NV_OUTPUT_BPC), without the format
+    else if (const unsigned int nvidiaBpc = m_outNvidiaBpc;
+             nvidiaBpc && (depth == DVDepth::DEEP || depth == DVDepth::EIGHT))
+      info["hades.dv.depth"] = std::to_string(nvidiaBpc);
     else
       info["hades.dv.depth"] = depth == DVDepth::DEEP ? "10" : depth == DVDepth::EIGHT ? "8" : "";
     if (depth == DVDepth::EIGHT)
@@ -4196,6 +4242,13 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
           info["hades.out.depthkind"] = "fixed";
           info["hades.out.depth"] = "8";
         }
+        // Hades: the depth NVKMS drives the output at, where nvidia-drm says it
+        // (NV_OUTPUT_BPC, nvidia-open-kernel-modules-9013)
+        else if (const auto said = connector->ReadPropertyValue("NV_OUTPUT_BPC"); said && *said)
+        {
+          info["hades.out.depthkind"] = "reported";
+          info["hades.out.depth"] = std::to_string(*said);
+        }
         else if (const int most = NvidiaOutputDepthLimit(connector->GetType() == "HDMI-A"))
         {
           info["hades.out.depthkind"] = "upto";
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 7078af0..ff4a96a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -292,6 +292,8 @@ private:
     UNANSWERED,
   };
   std::atomic<DVDepth> m_outDepth{DVDepth::UNKNOWN};
+  //! Hades: the depth that nvidia-drm said for the output with HDR on (NV_OUTPUT_BPC), 0 if none
+  std::atomic<unsigned int> m_outNvidiaBpc{0};
   unsigned int m_outDepthWaits{0}; //!< swaps that the question has waited for the HDR signalling
   //! the HDR signalling the question is about (render thread: FlipPage() asks again when it changes)
   KODI::UTILS::Eotf m_outDepthEotf{KODI::UTILS::Eotf::TRADITIONAL_SDR};
-- 
