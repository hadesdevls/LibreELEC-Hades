 .../VideoPlayer/DVDInputStreams/BlurayJoin.h  | 36 +++++++++++--------
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 11 ++++--
 .../DVDInputStreams/DVDInputStreamBluray.h    |  9 ++---
 3 files changed, 35 insertions(+), 21 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayJoin.h b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayJoin.h
index 2ac02e2..26a33be 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayJoin.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayJoin.h
@@ -18,10 +18,15 @@
 // a reference player does not make. Here a join goes on without opening the streams again only
 // where nothing a demuxer or a decoder sees changes across it:
 //   - the play item is the next one of the playlist, reached by reading to the end of the one
-//     before: libbluray tells it with the first bytes of its clip (the read that opens a clip
-//     returns its first bytes; a jump - a seek, a menu's command, a BD-J application - queues the
-//     play item before anything is read, and libbluray hands it on without bytes), and those bytes
-//     are where the play item begins in the playlist;
+//     before: libbluray tells it with a read of the disc (not with the events that a key press
+//     queued), and that read began where the play item begins in the playlist. With Hades'
+//     libbluray (libbluray-9090) the read that opens the clip of the next play item returns
+//     nothing and its bytes come with the next read, so that a demuxer opened for the play item
+//     gets them all; a libbluray without it returns the first bytes of the clip with the play
+//     item, and those begin where it begins. A jump (a seek, a menu's command, a BD-J application)
+//     lands elsewhere, and where one lands on the start of the next play item, libbluray queues
+//     BD_EVENT_SEEK after the play item (every seek does, _seek_internal()): the player holds on
+//     that and opens the streams again, with nothing read in between;
 //   - its connection condition, in the playlist, is 5 or 6 (libbluray reads such a clip from its
 //     first packet and raises no discontinuity);
 //   - the play item before has no still at its end;
@@ -56,8 +61,8 @@ namespace KODI::BLURAYJOIN
 enum class Verdict
 {
   KEEP, //!< the streams go on
-  NO_BYTES, //!< told without the first bytes of its clip: a jump, not the end of the one before
-  POSITION, //!< its bytes are not where it begins in the playlist
+  NOT_READ, //!< told with the events of a key press, not by a read of the disc: a jump
+  POSITION, //!< the read that told it did not begin where it begins in the playlist
   NO_CONNECTION, //!< its connection condition is not known
   NOT_SEAMLESS, //!< its connection condition is not 5 or 6
   STILL, //!< the play item before ends with a still
@@ -72,8 +77,11 @@ enum class Verdict
 //! What is known at the join, when libbluray tells the next play item
 struct Facts
 {
-  int readBytes{0}; //!< what the read that told the play item returned
-  std::optional<uint64_t> readStart; //!< where those bytes begin in the playlist
+  bool read{false}; //!< a read of the disc told the play item (not the events of a key press)
+  int readBytes{0}; //!< what that read returned: the first bytes of the clip, or nothing
+  //! where that read began in the playlist: its position less its bytes (with nothing read, the
+  //! position libbluray is at)
+  std::optional<uint64_t> readStart;
   uint64_t itemStart{0}; //!< where the play item begins in the playlist (PlayItemStart())
   int connectionCondition{-1}; //!< of the play item, from its playlist; -1 not known
   uint8_t stillBefore{0}; //!< the still mode of the play item before (bd_still_mode_e)
@@ -210,8 +218,8 @@ inline bool SameClipStreams(const CLPI_CL& a, const CLPI_CL& b, std::string* wha
 //! Whether the streams go on at the join, and if not, why (the first that does not hold)
 inline Verdict Decide(const Facts& facts, std::string* what = nullptr)
 {
-  if (facts.readBytes <= 0)
-    return Verdict::NO_BYTES;
+  if (!facts.read || facts.readBytes < 0)
+    return Verdict::NOT_READ;
   if (!facts.readStart || *facts.readStart != facts.itemStart)
     return Verdict::POSITION;
   if (facts.connectionCondition < 0)
@@ -244,11 +252,11 @@ inline const char* Reason(Verdict verdict)
   {
     case Verdict::KEEP:
       return "the join is seamless and the streams are the same";
-    case Verdict::NO_BYTES:
-      return "libbluray told it without the first bytes of its clip: it was jumped to, not "
-             "reached at the end of the play item before";
+    case Verdict::NOT_READ:
+      return "libbluray told it with the events of a key press, not with a read of the disc: it "
+             "was jumped to, not reached at the end of the play item before";
     case Verdict::POSITION:
-      return "its first bytes are not where it begins in the playlist";
+      return "the read that told it did not begin where it begins in the playlist";
     case Verdict::NO_CONNECTION:
       return "its connection condition is not known (the playlist could not be read)";
     case Verdict::NOT_SEAMLESS:
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index c9960b8..e369e4c 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -910,10 +910,12 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
 
       // Hades: an event that the thread of the application took from the queue and left for this
       // one (UserInput()) is taken as if this read had returned it, with nothing read
+      bool fromRead = false;
       if (m_event.event != BD_EVENT_NONE)
         result = 0;
       else
       {
+        fromRead = true;
         // the disc is read without the lock, so that the thread of the application never waits
         // for a read of the disc there; meanwhile it leaves the events to this thread
         BD_EVENT got{};
@@ -952,7 +954,7 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
             // where the join is seamless and nothing that its demuxer and decoders see changes
             // (BlurayJoin.h). Any other change here is held as before: the player opens its
             // streams again. Each join is said, with why, for the logs.
-            if (m_event.event == BD_EVENT_PLAYITEM && KeepStreamsAtJoin(result))
+            if (m_event.event == BD_EVENT_PLAYITEM && KeepStreamsAtJoin(result, fromRead))
               break;
             if (result > 0)
               m_readPos += static_cast<uint64_t>(result);
@@ -1051,7 +1053,7 @@ std::optional<KODI::BLURAYTIMELINE::ClipTime> CDVDInputStreamBluray::GetClipTime
   return m_clipSpans.At(readPos);
 }
 
-bool CDVDInputStreamBluray::KeepStreamsAtJoin(int readBytes)
+bool CDVDInputStreamBluray::KeepStreamsAtJoin(int readBytes, bool fromRead)
 {
   namespace JOIN = KODI::BLURAYJOIN;
   {
@@ -1068,8 +1070,11 @@ bool CDVDInputStreamBluray::KeepStreamsAtJoin(int readBytes)
   const BLURAY_CLIP_INFO& after = m_titleInfo->clips[item];
 
   JOIN::Facts facts;
+  facts.read = fromRead;
   facts.readBytes = readBytes;
-  if (readBytes > 0)
+  // where the read began: its bytes are the first of the clip (a libbluray that returns them with
+  // the play item), or it read nothing (libbluray-9090: they come with the next read)
+  if (fromRead && readBytes >= 0)
   {
     const uint64_t position = bd_tell(m_bd);
     if (position >= static_cast<uint64_t>(readBytes))
