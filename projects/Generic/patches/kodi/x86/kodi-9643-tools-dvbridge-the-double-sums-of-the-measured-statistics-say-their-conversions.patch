From 65b81041acb0850b5fadded9aa2ed3838e311369 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:26:41 +0000
Subject: [PATCH] tools/dvbridge: the double sums of the measured statistics
 say their conversions

Eight places where a float was added to, subtracted from or compared with a double were promoted implicitly, which -Wdouble-promotion reports. They are written as conversions to double now; the code that is compiled is the same instruction for instruction.
---
 tools/dvbridge/dvbridge_measured.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/tools/dvbridge/dvbridge_measured.c b/tools/dvbridge/dvbridge_measured.c
index 57d6c94..f495f52 100644
--- a/tools/dvbridge/dvbridge_measured.c
+++ b/tools/dvbridge/dvbridge_measured.c
@@ -178,9 +178,9 @@ bool dvbridge_measured_reduce(struct dvbridge_measured *m, const struct dvbridge
             const float *v = &raw->rows[(r * DVBRIDGE_MEASURED_BANDS + b) * 4];
             mx = fmaxf(mx, v[0]);
             mn = fminf(mn, v[2]);
-            sum += v[1];
+            sum += (double)v[1];
             count += per_band[b];
-            grid_sum[gy * DVBRIDGE_MEASURED_BANDS + b] += v[1];
+            grid_sum[gy * DVBRIDGE_MEASURED_BANDS + b] += (double)v[1];
             grid_count[gy * DVBRIDGE_MEASURED_BANDS + b] += per_band[b];
         }
     }
@@ -220,7 +220,7 @@ static float mad(const float *a, const float *b)
 {
     double d = 0;
     for (int i = 0; i < DVBRIDGE_MEASURED_GRID; ++i)
-        d += fabs((double)a[i] - b[i]);
+        d += fabs((double)a[i] - (double)b[i]);
     return (float)(d / DVBRIDGE_MEASURED_GRID);
 }
 
@@ -249,20 +249,20 @@ static void scene_add(struct scene *s, const struct dvbridge_measured_picture *p
 {
     if (!p->content)
         return; /* (a black picture: nothing to measure; the scene keeps what it had) */
-    if (!s->n || p->max > s->max)
+    if (!s->n || (double)p->max > s->max)
         s->max = p->max;
-    if (!s->n || p->min < s->min)
+    if (!s->n || (double)p->min < s->min)
         s->min = p->min;
-    s->sum += p->avg;
+    s->sum += (double)p->avg;
     ++s->n;
     if (window) {
         if (s->recent_n == window) {
-            s->recent_sum -= s->recent[s->recent_at];
+            s->recent_sum -= (double)s->recent[s->recent_at];
             s->recent[s->recent_at] = p->avg;
             s->recent_at = (s->recent_at + 1) % window;
         } else
             s->recent[s->recent_n++] = p->avg;
-        s->recent_sum += p->avg;
+        s->recent_sum += (double)p->avg;
     }
 }
 
