From 331b80c87f874cbabd348b5d8e3cf2b5fd6e4fa8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:22:34 +0000
Subject: [PATCH] windowing/gbm: with a whitelist, the 3D mode of another size
 is taken where the whitelist has that mode

With a whitelist of modes, the 3D output of a resolution was looked for
only at the timing of the mode that Kodi chose. A film of two whole
pictures side by side, which is what both views of an MVC video are
decoded into (3840x1080), is as wide as a 2160p mode: with 2160p and
1080p at the film's rate in the whitelist Kodi chooses 2160p, which has
no frame-packed form, and the film went out as the two halves of a 2D
picture, on a display that takes it frame packed at 1080p.

The reason for the rule was that a mode of another size is another mode,
which the whitelist may not have. So the timing of another size is taken
where the whitelist has its 2D mode. Without a whitelist nothing
changes, and the rule that a picture is not given fewer lines than a film
has holds with the whitelist too.

Host test: drmstereo_test (the choices with a whitelist).
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 18 +++++++++++
 xbmc/windowing/gbm/drm/DRMStereo.h  | 49 +++++++++++++++--------------
 2 files changed, 44 insertions(+), 23 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index b2f3a4d..83c5f28 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -500,7 +500,25 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
   allowed.framePacking = !m_stereoRefusedFramePacking;
   allowed.halfModes = !m_stereoRefusedHalfModes;
   allowed.infoFrame = !m_stereoRefusedInfoFrame;
+  // With a whitelist of modes, a timing of another size than the one Kodi chose is taken only
+  // where the whitelist has its 2D mode
   allowed.otherSize = !CResolutionUtils::HasWhitelist();
+  if (!allowed.otherSize)
+  {
+    for (const auto& listed : settings->GetList(CSettings::SETTING_VIDEOSCREEN_WHITELIST))
+    {
+      const RESOLUTION_INFO info = CDisplaySettings::GetInstance().GetResolutionInfo(
+          CDisplaySettings::GetInstance().GetResFromString(listed.asString()));
+      if (info.strId.empty())
+        continue;
+      const int index = std::atoi(info.strId.c_str());
+      for (STEREO::Offer& offer : offers)
+      {
+        if (offer.base == index)
+          offer.whitelisted = true;
+      }
+    }
+  }
 
   // A driver that takes the HDMI vendor InfoFrame from its user (nvidia-drm) can tell the
   // display of a half layout in the 2D mode, for the timings that the display's EDID says it
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index 744e43f..905a52b 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -190,6 +190,9 @@ struct Offer
   //! whoever knows the driver and the EDID (see Parse() and Supports()).
   bool infoFrameTopAndBottom{false};
   bool infoFrameSideBySide{false};
+  //! Where the user has a whitelist of modes: this 2D mode is one of it. Set by whoever
+  //! knows the whitelist (see Allowed::otherSize).
+  bool whitelisted{false};
 };
 
 /*!
@@ -261,9 +264,12 @@ struct Allowed
   bool framePacking{true};
   bool halfModes{true}; //!< the modes of top-and-bottom and of side-by-side (half)
   bool infoFrame{true}; //!< those layouts told by the InfoFrame alone
-  //! A mode of another size than the one Kodi chose, at the same refresh rate: where the user
-  //! has no whitelist of modes. (The 3D mode of a mode of the whitelist is that mode, sent
-  //! another way; a mode of another size is another mode, which the whitelist may not have.)
+  //! A mode of another size than the one Kodi chose, at the same refresh rate, whichever it
+  //! is: where the user has no whitelist of modes. (The 3D mode of a mode of the whitelist is
+  //! that mode, sent another way; a mode of another size is another mode.) With a whitelist,
+  //! only the timing of a 2D mode that the whitelist has (Offer::whitelisted): a film of two
+  //! whole pictures side by side is as wide as a 2160p mode, which Kodi then chooses, and
+  //! frame packing is of 1080p.
   bool otherSize{true};
 };
 
@@ -326,24 +332,24 @@ inline Choice Choose(std::span<const Offer> offers,
     constexpr int FILM_LINES = 1080;
     return offer.height >= (own.height < FILM_LINES ? own.height : FILM_LINES);
   };
+  // (a timing of another size than the one Kodi chose)
+  const auto otherSize = [&allowed](const Offer& offer)
+  { return allowed.otherSize || offer.whitelisted; };
 
   if (arrangement == Arrangement::TOP_AND_BOTTOM && allowed.framePacking && !own.interlaced)
   {
     if (own.framePacking >= 0)
       return {Layout::FRAME_PACKING, own.base, own.framePacking, false};
 
-    if (allowed.otherSize)
+    const Offer* best = nullptr;
+    for (const Offer& offer : offers)
     {
-      const Offer* best = nullptr;
-      for (const Offer& offer : offers)
-      {
-        if (offer.framePacking >= 0 && sameRate(offer) && enoughLines(offer) &&
-            (!best || area(offer) > area(*best)))
-          best = &offer;
-      }
-      if (best)
-        return {Layout::FRAME_PACKING, best->base, best->framePacking, false};
+      if (otherSize(offer) && offer.framePacking >= 0 && sameRate(offer) && enoughLines(offer) &&
+          (!best || area(offer) > area(*best)))
+        best = &offer;
     }
+    if (best)
+      return {Layout::FRAME_PACKING, best->base, best->framePacking, false};
   }
 
   const Layout layout = arrangement == Arrangement::TOP_AND_BOTTOM ? Layout::TOP_AND_BOTTOM
@@ -365,18 +371,15 @@ inline Choice Choose(std::span<const Offer> offers,
   if (const Choice choice = half(own); choice.layout != Layout::NONE)
     return choice;
 
-  if (allowed.otherSize)
+  const Offer* best = nullptr;
+  for (const Offer& offer : offers)
   {
-    const Offer* best = nullptr;
-    for (const Offer& offer : offers)
-    {
-      if (sameRate(offer) && area(offer) <= area(own) && enoughLines(offer) &&
-          half(offer).layout != Layout::NONE && (!best || area(offer) > area(*best)))
-        best = &offer;
-    }
-    if (best)
-      return half(*best);
+    if (otherSize(offer) && sameRate(offer) && area(offer) <= area(own) && enoughLines(offer) &&
+        half(offer).layout != Layout::NONE && (!best || area(offer) > area(*best)))
+      best = &offer;
   }
+  if (best)
+    return half(*best);
 
   return {};
 }
