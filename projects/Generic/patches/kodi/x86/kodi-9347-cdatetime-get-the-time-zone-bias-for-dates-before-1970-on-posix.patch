From 4f728fc3ec57686f56047d46cc3d8a0dbae12a2a Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 15 Oct 2026 19:44:42 +0100
Subject: [PATCH] [CDateTime] Get the time zone bias for dates before 1970 on
 POSIX

GetTimezoneBias() treated a negative time_t as SystemTimeToTimeT()
failing, but a time before 1970 is negative too. Any earlier date, such
as a premiered date of 1969-12-31, logged "Unable to obtain time zone
bias!" and was converted with no bias. Return no value on failure
instead, as Windows already handles these dates.
---
 xbmc/platform/posix/XTimeUtils.cpp | 14 ++++++++------
 xbmc/test/TestDateTime.cpp         | 11 +++++++++++
 2 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/xbmc/platform/posix/XTimeUtils.cpp b/xbmc/platform/posix/XTimeUtils.cpp
index 5d97229..f3e52c2 100644
--- a/xbmc/platform/posix/XTimeUtils.cpp
+++ b/xbmc/platform/posix/XTimeUtils.cpp
@@ -10,6 +10,7 @@
 
 #include <errno.h>
 #include <mutex>
+#include <optional>
 #include <time.h>
 
 #include <sys/times.h>
@@ -36,13 +37,13 @@ int64_t days_from_civil(int64_t y, unsigned m, unsigned d)
   return era * 146097LL + static_cast<int64_t>(doe) - 719468LL;
 }
 
-time_t SystemTimeToTimeT(const KODI::TIME::SystemTime& systemTime)
+std::optional<time_t> SystemTimeToTimeT(const KODI::TIME::SystemTime& systemTime)
 {
   // Basic range validation
   if (systemTime.month < 1 || systemTime.month > 12 || systemTime.day < 1 || systemTime.day > 31 ||
       systemTime.hour > 23u || systemTime.minute > 59u ||
       systemTime.second > 60u /* allow 60 for leap second */)
-    return static_cast<time_t>(-1); // error
+    return {}; // error
 
   // Compute days since epoch
   const int64_t days{
@@ -55,7 +56,7 @@ time_t SystemTimeToTimeT(const KODI::TIME::SystemTime& systemTime)
 
   // Validate range for time_t
   if (seconds < std::numeric_limits<time_t>::min() || seconds > std::numeric_limits<time_t>::max())
-    return static_cast<time_t>(-1); // error
+    return {}; // error
 
   return seconds;
 }
@@ -67,12 +68,13 @@ namespace TIME
 {
 std::tuple<bool, int64_t> GetTimezoneBias(const SystemTime& time)
 {
-  const time_t t{SystemTimeToTimeT(time)};
-  if (t < 0)
+  // Times before 1970 are negative, not errors
+  const std::optional<time_t> t{SystemTimeToTimeT(time)};
+  if (!t)
     return {false, 0}; // error
 
   struct tm tms;
-  if (!localtime_r(&t, &tms))
+  if (!localtime_r(&*t, &tms))
     return {false, 0}; // error
 
   return {true, -tms.tm_gmtoff / 60};
diff --git a/xbmc/test/TestDateTime.cpp b/xbmc/test/TestDateTime.cpp
index cd6a9ce..8e39bf4 100644
--- a/xbmc/test/TestDateTime.cpp
+++ b/xbmc/test/TestDateTime.cpp
@@ -12,6 +12,7 @@
 #include "interfaces/legacy/ModuleXbmc.h" //Needed to test getRegion()
 #include "resources/LocalizeStrings.h"
 #include "resources/ResourcesComponent.h"
+#include "utils/XTimeUtils.h"
 
 #include <array>
 #include <cstdint>
@@ -752,6 +753,16 @@ TEST_F(TestDateTime, GetAsTimeStamp)
   EXPECT_TRUE(dateTime == fileTime);
 }
 
+TEST_F(TestDateTime, GetTimezoneBiasBefore1970)
+{
+  KODI::TIME::SystemTime time{};
+  time.year = 1969;
+  time.month = 12;
+  time.day = 31;
+
+  EXPECT_TRUE(std::get<0>(KODI::TIME::GetTimezoneBias(time)));
+}
+
 TEST_F(TestDateTime, GetAsUTCDateTime)
 {
   CDateTime dateTime1;
