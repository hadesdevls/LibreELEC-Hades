From 17268a12ade9f623813a08e9eed8fc0fc1c76bf0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:44:30 +0000
Subject: [PATCH] windowing/gbm: after a Kodi that ended during native output,
 the colour format and the HDR metadata found are left for Kodi to set

The record of the transport (/run/hades-dv-state) puts back, with the
first commit of the next Kodi, each property that is still as the
transport made it. That commit is the first mode set of the menus, and it
also carries the end of the signals of the transport. The colour format
and the HDR metadata found were those of the mode and the video in which
native output began: a colour format that the mode of the menus cannot
carry (YCbCr 4:2:0 on amdgpu in a mode that the display does not list for
it) had that first commit refused, and with it the end of the signals;
and the request that it was refused for is the one that carried them.

The settings that depend on the mode or the display (Part::MODE_SETTING)
are not put back from the record: they stay at the transport's value
(AUTO, no HDR metadata) and the first mode set of Kodi sets its own, the
colour format of its setting through StageOutputFormat() with its
fallback, no HDR metadata through SetHDR(nullptr). The log names them.
The host test of the output state says so of the record; a mutant that
puts them back fails it.
---
 xbmc/windowing/gbm/drm/OutputHandover.cpp | 11 +++++++++--
 xbmc/windowing/gbm/drm/OutputState.h      | 14 +++++++++++++-
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/OutputHandover.cpp b/xbmc/windowing/gbm/drm/OutputHandover.cpp
index 35c7102..278a58f 100644
--- a/xbmc/windowing/gbm/drm/OutputHandover.cpp
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -238,13 +238,20 @@ size_t StageRecord(CDRMAtomic& drm)
   std::string left;
   for (const auto& name : plan.skipped)
     left += (left.empty() ? "" : ", ") + name;
+  std::string toKodi;
+  for (const auto& name : plan.toKodi)
+    toKodi += (toKodi.empty() ? "" : ", ") + name;
   CLog::Log(LOGINFO,
-            "DVBridge: {} propert{} put back from the record of the previous session ({}){}{}",
+            "DVBridge: {} propert{} put back from the record of the previous session ({}){}{}{}{}",
             staged, staged == 1 ? "y" : "ies",
             names.empty() ? "none was still as the transport "
                             "made it"
                           : names,
-            left.empty() ? "" : "; not touched, as they are not what the transport left: ", left);
+            left.empty() ? "" : "; not touched, as they are not what the transport left: ", left,
+            toKodi.empty() ? ""
+                           : "; left at the value of the transport, for the first change of "
+                             "mode of Kodi to set its own (they depend on the mode): ",
+            toKodi);
   return staged;
 }
 
diff --git a/xbmc/windowing/gbm/drm/OutputState.h b/xbmc/windowing/gbm/drm/OutputState.h
index 864548f..c258b78 100644
--- a/xbmc/windowing/gbm/drm/OutputState.h
+++ b/xbmc/windowing/gbm/drm/OutputState.h
@@ -1136,12 +1136,19 @@ public:
     std::vector<Change> changes;
     std::vector<uint32_t> blobs; //!< made for the changes: to be kept until they are committed
     std::vector<std::string> skipped; //!< not as the transport left it: somebody else's now
+    //! settings that depend on the mode or the display (Part::MODE_SETTING): left at the
+    //! transport's value, for the first change of mode of Kodi to set its own
+    std::vector<std::string> toKodi;
   };
 
   /*!
    * \brief The changes that give an output back that a Kodi left with the transport set: of each
    *        property that is still what the transport made it, what it was. One that is not (the
-   *        user, or another Kodi, changed it since) is not touched.
+   *        user, or another Kodi, changed it since) is not touched. The settings that depend on
+   *        the mode or the display are not put back either: what was found is of the mode of a
+   *        video, which the first commit of this Kodi, in the mode of its menus, may not take
+   *        (and that commit carries the end of the signals); Kodi sets its own with it (the colour
+   *        format of its setting, with its fallback; no HDR metadata).
    */
   static LeftoverPlan PlanLeftover(const Leftover& left, IKms& kms)
   {
@@ -1150,6 +1157,11 @@ public:
     for (const auto& item : left.items)
     {
       const std::string label = std::string(RoleName(item.role)) + " \"" + item.name + "\"";
+      if (PartOf(item.role, item.name) == Part::MODE_SETTING)
+      {
+        plan.toKodi.push_back(label);
+        continue;
+      }
       const auto& values = Values(kms, reads, item.role, item.object);
       std::optional<uint64_t> now;
       if (values)
-- 
