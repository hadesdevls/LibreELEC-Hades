From 0971fdbd59629dcbd6799e340d318ab612116e40 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 11 Oct 2026 19:09:05 +0100
Subject: [PATCH] [pictures] Show HDR video in a slideshow

With HDR passthrough the GUI is composited over the video, which is
drawn underneath it by the window below the slideshow. The slideshow
cleared the GUI to opaque black, so an HDR video in a slideshow played
on a black screen. Clear to transparent while it shows such a video.
---
 xbmc/pictures/GUIWindowSlideShow.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/xbmc/pictures/GUIWindowSlideShow.cpp b/xbmc/pictures/GUIWindowSlideShow.cpp
index 3e4facd..e8bd98b 100644
--- a/xbmc/pictures/GUIWindowSlideShow.cpp
+++ b/xbmc/pictures/GUIWindowSlideShow.cpp
@@ -713,7 +713,10 @@ void CGUIWindowSlideShow::Render()
     return;
 
   CGraphicContext& gfxCtx = CServiceBroker::GetWinSystem()->GetGfxContext();
-  gfxCtx.Clear(0xff000000);
+  // HDR video is drawn underneath the GUI, by the window below the slideshow
+  const bool hdrVideo =
+      IsVideo(*m_slides.at(m_iCurrentSlide)) && CServiceBroker::GetWinSystem()->IsHdrComposite();
+  gfxCtx.Clear(hdrVideo ? 0 : 0xff000000);
 
   if (IsVideo(*m_slides.at(m_iCurrentSlide)))
   {
