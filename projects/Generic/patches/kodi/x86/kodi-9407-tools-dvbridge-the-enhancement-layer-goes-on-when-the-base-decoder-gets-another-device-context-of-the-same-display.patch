From 3c51d051c93286b10bc1e8188e60b5cd264715a9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:48:36 +0000
Subject: [PATCH] tools/dvbridge: the enhancement layer goes on when the base
 decoder gets another device context of the same display

Kodi makes a device context for every VAAPI decoder it opens (VAAPI.cpp,
CDecoder::Open()), and it opens one each time FFmpeg's base decoder asks
for a format again: for a sequence of other parameters, which can come at the
start of a stream when its parameter sets in the stream differ from those of
its configuration. Every one of them is on the one display of the window
system. dvbridge_fel_device() compared the device contexts themselves, so each
new one opened the enhancement decoder anew and reset the layer: it then
waited for a random-access picture to start at again, which by picture order,
where the two layers do not share one, never came.

The enhancement decoder has its own surfaces, made on its own device context,
which it keeps a reference to. On the same display they are what they were:
the decoder and the layer go on. A device context of another display, or one
that is not VAAPI, opens the decoder anew and starts the layer again, as
before.

Tested on the host with device contexts made for the test (the host FFmpeg has
no VAAPI; only their display is read): a new one of the same display after
packet 600 of the FEL test stream leaves every picture paired as in the whole
run; with the comparison before this change the decoder is opened anew and the
layer starts again. One of another display starts it again.
---
 tools/dvbridge/dvbridge_fel.c | 26 +++++++++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index b9e30dc..cfefe18 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -5,6 +5,7 @@
 #include <libavcodec/bsf.h>
 #include <libavutil/dict.h>
 #include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_vaapi.h>
 #include <libavutil/mathematics.h>
 #include <limits.h>
 #include <stdlib.h>
@@ -1088,14 +1089,33 @@ static bool open_decoder(struct dvbridge_fel *f, AVBufferRef *device)
     return f->decoder->hw_device_ctx && avcodec_open2(f->decoder, codec, NULL) >= 0;
 }
 
+/* Hades: whether two device contexts are of the same VAAPI display. Kodi makes a device context for every
+ * VAAPI decoder it opens (VAAPI.cpp, CDecoder::Open()), and opens one each time the base decoder asks for a
+ * format again (a new sequence of other parameters), always on the one display of its window system. The
+ * enhancement decoder has its own surfaces on its own device context, which it keeps: on the same display
+ * they are what they were, and the layer goes on. Another display is another device: the layer starts there
+ * again, as before. */
+static bool same_display(const AVBufferRef *a, const AVBufferRef *b)
+{
+    if (a->data == b->data)
+        return true;
+    const AVHWDeviceContext *x = (const AVHWDeviceContext *)a->data;
+    const AVHWDeviceContext *y = (const AVHWDeviceContext *)b->data;
+    if (x->type != AV_HWDEVICE_TYPE_VAAPI || y->type != AV_HWDEVICE_TYPE_VAAPI || !x->hwctx || !y->hwctx)
+        return false;
+    const AVVAAPIDeviceContext *u = x->hwctx, *v = y->hwctx;
+    return u->display && u->display == v->display;
+}
+
 bool dvbridge_fel_device(struct dvbridge_fel *f, AVBufferRef *device, bool picture)
 {
     if (!f || !device || ((AVHWDeviceContext *)device->data)->type != AV_HWDEVICE_TYPE_VAAPI)
         return false;
-    if (f->opened && f->decoder->hw_device_ctx && f->decoder->hw_device_ctx->data == device->data)
+    if (f->opened && f->decoder->hw_device_ctx && same_display(f->decoder->hw_device_ctx, device))
         return pump(f);
-    /* First use, or the base layer's decoder was set up again on another device (a new
-     * sequence): the enhancement decoder follows it, from the next common random-access point. */
+    /* First use, or the base layer's decoder was set up again on another device (Hades: on another
+     * display): the enhancement decoder follows it, from the next random-access point it can start
+     * at. */
     if (f->open_wait) {
         if (picture)
             --f->open_wait;
-- 
