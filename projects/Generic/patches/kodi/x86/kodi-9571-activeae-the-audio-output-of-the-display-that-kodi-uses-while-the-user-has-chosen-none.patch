+TEST(TestActiveAEFollowDisplay, NoOtherDisplaysOutputIsTakenForKodisDisplay)
+{
+  DisplayOutputFound found = DisplayOutputFound::NONE;
+  // Kodi on a monitor without audio, a TV with audio on another output: the TV's is not taken
+  EXPECT_EQ(-1, OutputOfTheDisplay(Issue6(), Edid(PANASONIC, "Panasonic-TV"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::NOT_THIS_DISPLAY);
+  // no display at all (the TV is off): nothing
+  std::vector<DisplayOutputCandidate> off = Issue6();
+  off[2].display = ABSENT;
+  EXPECT_EQ(-1, OutputOfTheDisplay(off, Edid(ISP, "ISP Elite MK2"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::NONE);
+  EXPECT_EQ(-1, OutputOfTheDisplay(off, DisplayIdentity{}, found));
+  EXPECT_TRUE(found == DisplayOutputFound::NONE);
+  // a driver that cannot tell is no display
+  off[2].display = UNKNOWN;
+  EXPECT_EQ(-1, OutputOfTheDisplay(off, DisplayIdentity{}, found));
+  EXPECT_TRUE(found == DisplayOutputFound::NONE);
+}
+
+TEST(TestActiveAEFollowDisplay, OnlyAnOutputThatCanBeUsedIsTheDisplaysOutput)
+{
+  DisplayOutputFound found = DisplayOutputFound::NONE;
+  // passthrough, and the display's output only takes PCM
+  std::vector<DisplayOutputCandidate> outputs = TwoDisplays();
+  outputs[3].usable = false;
+  EXPECT_EQ(-1, OutputOfTheDisplay(outputs, Edid(ISP, "ISP Elite MK2"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::NOT_THIS_DISPLAY);
+  // ... and with Kodi's display not known, it does not make two
+  EXPECT_EQ(1, OutputOfTheDisplay(outputs, DisplayIdentity{}, found));
+  EXPECT_TRUE(found == DisplayOutputFound::ONE);
+}
