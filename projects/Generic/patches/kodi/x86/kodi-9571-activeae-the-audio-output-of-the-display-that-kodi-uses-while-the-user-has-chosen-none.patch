+namespace
+{
+// Hades: a change of a device setting that is made without the user, in this thread: by the
+// engine (SetAutomaticOutput()), or by the list of the settings, which puts an output in a
+// setting whose value is not among them (CSettingString::UpdateDynamicOptions(), from the filler)
+struct AutomaticChange
+{
+  std::string id;
+  std::string value;
+  bool byEngine{false};
+};
+thread_local AutomaticChange t_automatic;
+
+const char* AutomaticIdOf(const std::string& id)
+{
+  if (id == CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE)
+    return CSettings::SETTING_AUDIOOUTPUT_HADESAUTODEVICE;
+  if (id == CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE)
+    return CSettings::SETTING_AUDIOOUTPUT_HADESAUTOPASSTHROUGHDEVICE;
+  return nullptr;
+}
+} // namespace
+
 void CActiveAESettings::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
 {
   std::unique_lock lock(m_cs);
+
+  // Hades: whose choice a device setting holds (INTERNAL::ChosenByUser()): a change made without
+  // the user keeps the value it put there; any other change is the user's (the list of the
+  // settings, JSON-RPC, a reset to the default), and the engine no longer chooses for it
+  const char* automaticId = setting ? AutomaticIdOf(setting->GetId()) : nullptr;
+  if (automaticId)
+  {
+    const std::string value = std::static_pointer_cast<const CSettingString>(setting)->GetValue();
+    const bool automatic = t_automatic.id == setting->GetId() && t_automatic.value == value;
+    const bool byEngine = automatic && t_automatic.byEngine;
+    if (t_automatic.id == setting->GetId())
+      t_automatic = {};
+
+    const std::shared_ptr<CSettings> settings =
+        CServiceBroker::GetSettingsComponent()->GetSettings();
+    if (automatic)
+    {
+      if (!byEngine)
+        settings->SetString(automaticId, value);
+    }
+    else if (!settings->GetString(automaticId).empty())
+    {
+      settings->SetString(automaticId, "");
+      CLog::Log(LOGINFO,
+                "ActiveAE - the {} output was chosen in the settings: '{}'; it is kept from now on",
+                setting->GetId() == CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE
+                    ? "passthrough"
+                    : "audio",
+                value);
+    }
+    // (the engine loads its settings right after its own change)
+    if (byEngine)
+      return;
+  }
+
   m_instance->m_audioEngine.OnSettingsChange();
 }
 
+void CActiveAESettings::SetAutomaticOutput(const std::string& id,
+                                           const std::string& automaticId,
+                                           const std::string& device)
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings)
+    return;
+  settings->SetString(automaticId, device);
+  t_automatic = {id, device, true};
+  settings->SetString(id, device);
+  t_automatic = {};
+  settings->Save();
+}
+
