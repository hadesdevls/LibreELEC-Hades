+TEST(TestActiveAEFollowDisplay, AnEdidOrEldThatCannotBeTrustedNamesNoDisplay)
+{
+  std::vector<uint8_t> edid = ISP;
+  edid[20] ^= 1; // the checksum no longer adds up
+  EXPECT_FALSE(KODI::UTILS::IdentityOfEdid(edid).Known());
+  const std::vector<uint8_t> half(ISP.begin(), ISP.begin() + 64);
+  EXPECT_FALSE(KODI::UTILS::IdentityOfEdid(half).Known());
+  std::vector<uint8_t> eld = EldOf(ISP, "ISP Elite MK2");
+  eld[0] = 3 << 3; // a version that is not read
+  EXPECT_FALSE(KODI::UTILS::IdentityOfEld(eld.data(), eld.size()).Known());
+  EXPECT_FALSE(KODI::UTILS::IdentityOfEld(eld.data(), 19).Known());
+  // an unknown display is no display that matches
+  EXPECT_FALSE(KODI::UTILS::SameDisplay(DisplayIdentity{}, DisplayIdentity{}));
+}
