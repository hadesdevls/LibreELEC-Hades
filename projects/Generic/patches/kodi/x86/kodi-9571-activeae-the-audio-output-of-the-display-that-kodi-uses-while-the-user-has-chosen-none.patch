+std::vector<DisplayOutputCandidate> Issue6()
+{
+  return {Out(UNKNOWN), Out(UNKNOWN), Out(PRESENT, Eld(ISP, "ISP Elite MK2")), Out(ABSENT),
+          Out(ABSENT), Out(ABSENT)};
+}
+
+// The diagnostic of 2026-10-17: two graphics chips, a display with audio data on each
+std::vector<DisplayOutputCandidate> TwoDisplays()
+{
+  return {Out(UNKNOWN), Out(PRESENT, Eld(PANASONIC, "Panasonic-TV")), Out(ABSENT),
+          Out(PRESENT, Eld(ISP, "ISP Elite MK2"))};
