+// Hades: the outputs as EnumerateOutputDevices() lists them for the settings, of every driver
+std::string CActiveAESink::OutputOfTheDisplay(bool passthrough,
+                                              const KODI::UTILS::DisplayIdentity& driven,
+                                              INTERNAL::DisplayOutputFound& found) const
+{
+  using INTERNAL::FollowCandidate;
+  std::vector<INTERNAL::DisplayOutputCandidate> outputs;
+  std::vector<std::string> devices;
+  for (const auto& sink : m_sinkInfoList)
+  {
+    for (const auto& d : sink.m_deviceInfoList)
+    {
+      if ((passthrough && d.m_deviceType == AE_DEVTYPE_PCM) ||
+          (d.m_onlyPassthrough && !passthrough) || (d.m_onlyPCM && passthrough))
+        continue;
+
+      INTERNAL::DisplayOutputCandidate candidate;
+      candidate.display = d.m_display == CAEDeviceInfo::Display::PRESENT
+                              ? FollowCandidate::Display::PRESENT
+                          : d.m_display == CAEDeviceInfo::Display::ABSENT
+                              ? FollowCandidate::Display::ABSENT
+                              : FollowCandidate::Display::UNKNOWN;
+      candidate.usable = IsUsableFor(d, passthrough);
+      candidate.identity = d.m_displayIdentity;
+      outputs.push_back(std::move(candidate));
+      devices.push_back(d.ToDeviceString(sink.m_sinkName));
+    }
+  }
+  const int at = INTERNAL::OutputOfTheDisplay(outputs, driven, found);
+  return at >= 0 ? devices[at] : std::string();
+}
