+void CActiveAE::ChooseOutputsForTheDisplay()
+{
+  const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings)
+    return;
+
+  const KODI::UTILS::DisplayIdentity driven = KODI::UTILS::CDrivenDisplay::Get();
+  for (const bool passthrough : {false, true})
+  {
+    const char* id = passthrough ? CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE
+                                 : CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE;
+    const char* automaticId = passthrough ? CSettings::SETTING_AUDIOOUTPUT_HADESAUTOPASSTHROUGHDEVICE
+                                          : CSettings::SETTING_AUDIOOUTPUT_HADESAUTODEVICE;
+    const char* kind = passthrough ? "passthrough" : "audio";
+    const std::string value = settings->GetString(id);
+    std::string& told = m_displayOutputTold[passthrough ? 1 : 0];
+
+    if (INTERNAL::ChosenByUser(value, settings->GetString(automaticId)))
+    {
+      if (told != "user " + value)
+        CLog::Log(LOGINFO, "ActiveAE - the {} output '{}' was chosen in the settings: it is kept",
+                  kind, value);
+      told = "user " + value;
+      continue;
+    }
+
+    INTERNAL::DisplayOutputFound found = INTERNAL::DisplayOutputFound::NONE;
+    const std::string output = m_sink.OutputOfTheDisplay(passthrough, driven, found);
+    const std::string state =
+        std::to_string(static_cast<int>(found)) + ' ' + output + ' ' + driven.Describe();
+    if (state != told)
+    {
+      const std::string display = driven.Known() ? "the display that Kodi uses, " + driven.Describe()
+                                                 : "the only output with a display";
+      switch (found)
+      {
+        case INTERNAL::DisplayOutputFound::ONE:
+          if (output == value)
+            CLog::Log(LOGINFO,
+                      "ActiveAE - the {} output '{}' is the output of {}: it follows that display "
+                      "while no output is chosen in the settings",
+                      kind, value, display);
+          else
+            CLog::Log(LOGINFO,
+                      "ActiveAE - no {} output has been chosen in the settings: using '{}', the "
+                      "output of {}, in place of '{}' (an output chosen in Settings > System > "
+                      "Audio is kept from then on)",
+                      kind, output, display, value);
+          break;
+        case INTERNAL::DisplayOutputFound::NONE:
+          CLog::Log(LOGINFO,
+                    "ActiveAE - no {} output has been chosen in the settings, and no output has a "
+                    "display with audio now: '{}' stays",
+                    kind, value);
+          break;
+        case INTERNAL::DisplayOutputFound::SEVERAL:
+          CLog::Log(LOGINFO,
+                    "ActiveAE - no {} output has been chosen in the settings: several outputs have "
+                    "a display, and none is known to be the one that Kodi uses ({}): '{}' stays",
+                    kind, driven.Describe(), value);
+          break;
+        case INTERNAL::DisplayOutputFound::NOT_THIS_DISPLAY:
+          CLog::Log(LOGINFO,
+                    "ActiveAE - no {} output has been chosen in the settings: the display that "
+                    "Kodi uses ({}) has no audio output of its own, and no other display's output "
+                    "is taken for it: '{}' stays",
+                    kind, driven.Describe(), value);
+          break;
+      }
+      told = state;
+    }
+
+    if (!output.empty() && output != value)
+      CActiveAESettings::SetAutomaticOutput(id, automaticId, output);
+  }
+}
