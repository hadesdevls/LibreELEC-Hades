+TEST(TestActiveAEFollowDisplay, WhatTheUserChoseIsTheUsers)
+{
+  // Kodi's default is no choice, in any case
+  EXPECT_FALSE(ChosenByUser("Default", ""));
+  EXPECT_FALSE(ChosenByUser("default", ""));
+  EXPECT_FALSE(ChosenByUser("", ""));
+  // what was put there without the user, while the user has not changed it
+  EXPECT_FALSE(ChosenByUser("ALSA:hdmi:CARD=NVidia,DEV=0", "ALSA:hdmi:CARD=NVidia,DEV=0"));
+  // the user changed it after that
+  EXPECT_TRUE(ChosenByUser("ALSA:@:CARD=PCH,DEV=0", "ALSA:hdmi:CARD=NVidia,DEV=0"));
+  // a value from before this was kept (an earlier version): the user's, whatever it is
+  EXPECT_TRUE(ChosenByUser("ALSA:@", ""));
+  EXPECT_TRUE(ChosenByUser("ALSA:hdmi:CARD=NVidia,DEV=0", ""));
+}
