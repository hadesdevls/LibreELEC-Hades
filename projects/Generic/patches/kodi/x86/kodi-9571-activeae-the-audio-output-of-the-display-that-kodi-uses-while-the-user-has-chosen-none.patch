+
+namespace KODI::UTILS
+{
+/*!
+ * \brief Hades: who a display is, as its EDID names it: the codes of its maker and of its product,
+ *        and the name it gives itself
+ *
+ * The audio data of an HDMI or DisplayPort output (its ELD, which the graphics driver builds from
+ * the EDID of the display on that output) repeats the same four bytes and the same name (HDA ELD,
+ * bytes 16 to 19 and the monitor name string; VESA E-EDID 1.4, bytes 8 to 11 and the display
+ * product name descriptor): the audio engine finds the audio output of the display that Kodi
+ * shows its picture on by them (ActiveAE::INTERNAL::OutputOfTheDisplay()).
+ */
+struct DisplayIdentity
+{
+  //! The maker, as the two bytes of its PNP ID (EDID bytes 8 and 9, big-endian); 0: not known
+  uint16_t maker{0};
+  //! The product code (EDID bytes 10 and 11, little-endian)
+  uint16_t product{0};
+  //! The name that the display gives itself, without the spaces around it; empty when it has none
+  std::string model;
+  //! The output that it is on, for the log ("HDMI-A-1"); empty when not known
+  std::string output;
+
+  bool Known() const { return maker != 0; }
+
+  //! The maker's PNP ID as its three letters ("GSM"); "?" for a code that is not three letters
+  std::string MakerLetters() const
+  {
+    std::string letters;
+    for (const int shift : {10, 5, 0})
+    {
+      const int letter = (maker >> shift) & 0x1F;
+      if (letter < 1 || letter > 26)
+        return "?";
+      letters += static_cast<char>('A' + letter - 1);
+    }
+    return letters;
+  }
+
+  //! For the log: "GSM LG TV SSCR2 (product 0xC0A0) on HDMI-A-1"
+  std::string Describe() const
+  {
+    if (!Known())
+      return "a display that is not known";
+    static constexpr char HEX[] = "0123456789ABCDEF";
+    std::string text = MakerLetters();
+    if (!model.empty())
+      text += ' ' + model;
+    text += " (product 0x";
+    for (const int shift : {12, 8, 4, 0})
+      text += HEX[(product >> shift) & 0xF];
+    text += ')';
+    if (!output.empty())
+      text += " on " + output;
+    return text;
+  }
+};
+
+namespace DISPLAY_IDENTITY
+{
+//! Without the spaces at either end
+inline std::string Trimmed(std::string text)
+{
+  const auto notSpace = [](char c) { return c != ' '; };
+  text.erase(text.begin(), std::find_if(text.begin(), text.end(), notSpace));
+  text.erase(std::find_if(text.rbegin(), text.rend(), notSpace).base(), text.end());
+  return text;
+}
+} // namespace DISPLAY_IDENTITY
+
+/*!
+ * \brief The maker and product of a display from its EDID (the name is the caller's: the windowing
+ *        system reads it with its own rules)
+ * \return a DisplayIdentity whose maker is 0 for a base block that is not valid (its header or its
+ *         checksum), which says nothing that can be trusted
+ */
+inline DisplayIdentity IdentityOfEdid(const std::vector<uint8_t>& edid)
+{
+  constexpr std::size_t BLOCK = 128;
+  constexpr uint8_t HEADER[8] = {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00};
+  DisplayIdentity id;
+  if (edid.size() < BLOCK || !std::equal(std::begin(HEADER), std::end(HEADER), edid.begin()))
+    return id;
+
+  unsigned int sum = 0;
+  for (std::size_t i = 0; i < BLOCK; ++i)
+    sum += edid[i];
+  if (sum % 256 != 0)
+    return id;
+
+  id.maker = static_cast<uint16_t>((edid[8] << 8) | edid[9]);
+  id.product = static_cast<uint16_t>(edid[10] | (edid[11] << 8));
+  return id;
+}
+
+/*!
+ * \brief The maker, product and name of the display of an HDMI or DisplayPort output from its ELD
+ *        (HDA 1.0a, 7.3.3.34.1: version 2, CEA-861-D; ALSA also passes version 31, partial)
+ * \return a DisplayIdentity whose maker is 0 for an ELD that is too short or of another version
+ */
+inline DisplayIdentity IdentityOfEld(const uint8_t* eld, std::size_t length)
+{
+  DisplayIdentity id;
+  if (!eld || length < 20)
+    return id;
+  const int version = (eld[0] & 0xF8) >> 3;
+  if (version != 2 && version != 31)
+    return id;
+
+  id.maker = static_cast<uint16_t>((eld[16] << 8) | eld[17]);
+  id.product = static_cast<uint16_t>(eld[18] | (eld[19] << 8));
+  const std::size_t nameLength = eld[4] & 0x1F;
+  if (nameLength <= 16 && 20 + nameLength <= length)
+  {
+    std::string name(reinterpret_cast<const char*>(eld + 20), nameLength);
+    // (a name shorter than its field ends with a zero byte)
+    name.erase(std::find(name.begin(), name.end(), '\0'), name.end());
+    id.model = DISPLAY_IDENTITY::Trimmed(name);
+  }
+  return id;
+}
+
+/*!
+ * \brief Whether two identities are the same display: the same maker and product, and the same
+ *        name where both have one
+ */
+inline bool SameDisplay(const DisplayIdentity& a, const DisplayIdentity& b)
+{
+  if (!a.Known() || a.maker != b.maker || a.product != b.product)
+    return false;
+  const std::string nameA = DISPLAY_IDENTITY::Trimmed(a.model);
+  const std::string nameB = DISPLAY_IDENTITY::Trimmed(b.model);
+  return nameA.empty() || nameB.empty() || nameA == nameB;
+}
+
+/*!
+ * \brief The display that Kodi shows its picture on, as the windowing system last said: written
+ *        by the windowing system when it chooses its output (CWinSystemGbm::InitWindowSystem()),
+ *        read by the audio engine on its own thread
+ */
+class CDrivenDisplay
+{
+public:
+  static void Set(const DisplayIdentity& id)
+  {
+    std::unique_lock lock(Lock());
+    Value() = id;
+  }
+
+  //! A DisplayIdentity whose maker is 0 while no windowing system has said it
+  static DisplayIdentity Get()
+  {
+    std::unique_lock lock(Lock());
+    return Value();
+  }
+
+private:
+  static std::mutex& Lock()
+  {
+    static std::mutex lock;
+    return lock;
+  }
+  static DisplayIdentity& Value()
+  {
+    static DisplayIdentity value;
+    return value;
+  }
+};
+} // namespace KODI::UTILS
