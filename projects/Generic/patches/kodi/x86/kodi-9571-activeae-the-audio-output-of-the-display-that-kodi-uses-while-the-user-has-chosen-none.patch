                                                          std::vector<StringSettingOption>& list,
                                                          std::string& current)
@@ -166,6 +241,7 @@ void CActiveAESettings::SettingOptionsAudioDevicesFillerGeneral(
 {
   current = std::static_pointer_cast<const CSettingString>(setting)->GetValue();
   std::string firstDevice;
+  t_automatic = {};
 
   std::unique_lock lock(m_instance->m_cs);
 
@@ -189,6 +265,21 @@ void CActiveAESettings::SettingOptionsAudioDevicesFillerGeneral(
   }
 
   if (!foundValue)
-    current = firstDevice;
+  {
+    // Hades: in a setting that the user has not chosen, the output of the display that Kodi uses,
+    // and that change is not the user's (OnSettingChanged()); else Kodi's first output, as before
+    const std::shared_ptr<CSettings> settings =
+        CServiceBroker::GetSettingsComponent()->GetSettings();
+    const char* automaticId = AutomaticIdOf(setting->GetId());
+    if (settings && automaticId &&
+        !INTERNAL::ChosenByUser(current, settings->GetString(automaticId)))
+    {
+      const std::string output = m_instance->m_audioEngine.OutputOfTheDisplay(passthrough);
+      current = output.empty() ? firstDevice : output;
+      t_automatic = {setting->GetId(), current, false};
+    }
+    else
+      current = firstDevice;
+  }
 }
 }
