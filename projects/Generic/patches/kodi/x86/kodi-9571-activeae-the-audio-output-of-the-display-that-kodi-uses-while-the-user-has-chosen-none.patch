+// An ELD as the HDA driver builds it from an EDID (HDA 1.0a, 7.3.3.34.1): version 2, CEA-861-D,
+// the monitor name, one SAD, HDMI; bytes 16 to 19 are bytes 8 to 11 of the EDID
+std::vector<uint8_t> EldOf(const std::vector<uint8_t>& edid, const std::string& name)
+{
+  std::vector<uint8_t> eld(20, 0);
+  eld[0] = 2 << 3;
+  eld[4] = static_cast<uint8_t>((3 << 5) | name.size());
+  eld[5] = (1 << 4) | 0x02;
+  eld[7] = 0x4f;
+  for (int i = 0; i < 4; ++i)
+    eld[16 + i] = edid[8 + i];
+  eld.insert(eld.end(), name.begin(), name.end());
+  for (const uint8_t sad : {0x09, 0x7f, 0x07})
+    eld.push_back(sad);
+  eld[2] = static_cast<uint8_t>((eld.size() - 4 + 3) / 4);
+  return eld;
+}
+
+DisplayIdentity Edid(const std::vector<uint8_t>& edid, const std::string& model)
+{
+  DisplayIdentity id = KODI::UTILS::IdentityOfEdid(edid);
+  id.model = model; // (the windowing system reads the name: EdidDisplayName())
+  return id;
+}
+
+DisplayIdentity Eld(const std::vector<uint8_t>& edid, const std::string& name)
+{
+  const std::vector<uint8_t> eld = EldOf(edid, name);
+  return KODI::UTILS::IdentityOfEld(eld.data(), eld.size());
+}
+
+DisplayOutputCandidate Out(FollowCandidate::Display display,
+                           const DisplayIdentity& identity = {},
+                           bool usable = true)
+{
+  DisplayOutputCandidate c;
+  c.display = display;
+  c.usable = usable;
+  c.identity = identity;
+  return c;
+}
