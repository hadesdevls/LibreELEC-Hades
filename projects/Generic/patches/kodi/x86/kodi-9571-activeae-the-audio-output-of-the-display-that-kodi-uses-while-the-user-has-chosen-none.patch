+TEST(TestActiveAEFollowDisplay, TheEdidAndTheEldOfADisplayNameTheSameDisplay)
+{
+  const DisplayIdentity edid = Edid(ISP, "ISP Elite MK2");
+  const DisplayIdentity eld = Eld(ISP, "ISP Elite MK2");
+  EXPECT_EQ(0x25A6, edid.maker);
+  EXPECT_EQ(0x0001, edid.product);
+  // what ALSA read of the same display: the two bytes of the maker in the order of the ELD
+  EXPECT_EQ(0xa625, static_cast<uint16_t>((eld.maker >> 8) | (eld.maker << 8)));
+  EXPECT_EQ(0x1, eld.product);
+  EXPECT_EQ(std::string("ISP Elite MK2"), eld.model);
+  EXPECT_TRUE(KODI::UTILS::SameDisplay(edid, eld));
+  EXPECT_EQ(std::string("MEI"), Edid(PANASONIC, "").MakerLetters());
+  EXPECT_EQ(0xA296, Edid(PANASONIC, "").product);
+  EXPECT_FALSE(KODI::UTILS::SameDisplay(edid, Eld(PANASONIC, "Panasonic-TV")));
+  // the same codes with another name are another display; a name that one of them lacks is no
+  // difference; spaces around a name are none either
+  EXPECT_FALSE(KODI::UTILS::SameDisplay(edid, Eld(ISP, "ISP Elite MK3")));
+  EXPECT_TRUE(KODI::UTILS::SameDisplay(Edid(ISP, ""), eld));
+  EXPECT_TRUE(KODI::UTILS::SameDisplay(edid, Eld(ISP, " ISP Elite MK2 ")));
+  DisplayIdentity onItsOutput = edid;
+  onItsOutput.output = "HDMI-A-2";
+  EXPECT_EQ(std::string("IMF ISP Elite MK2 (product 0x0001) on HDMI-A-2"),
+            onItsOutput.Describe());
+}
