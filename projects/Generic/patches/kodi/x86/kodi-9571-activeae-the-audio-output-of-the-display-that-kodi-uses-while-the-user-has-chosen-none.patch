+TEST(TestActiveAEFollowDisplay, TheOutputOfTheDisplayIsUsedInPlaceOfKodisDefault)
+{
+  DisplayOutputFound found = DisplayOutputFound::NONE;
+  // Kodi's display known (GBM): the output whose ELD names it
+  EXPECT_EQ(2, OutputOfTheDisplay(Issue6(), Edid(ISP, "ISP Elite MK2"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::ONE);
+  // not known (another windowing system): the only output with a display
+  EXPECT_EQ(2, OutputOfTheDisplay(Issue6(), DisplayIdentity{}, found));
+  EXPECT_TRUE(found == DisplayOutputFound::ONE);
+}
+
+TEST(TestActiveAEFollowDisplay, WithTwoDisplaysTheOneKodiUsesDecides)
+{
+  DisplayOutputFound found = DisplayOutputFound::NONE;
+  EXPECT_EQ(3, OutputOfTheDisplay(TwoDisplays(), Edid(ISP, "ISP Elite MK2"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::ONE);
+  EXPECT_EQ(1, OutputOfTheDisplay(TwoDisplays(), Edid(PANASONIC, "Panasonic-TV"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::ONE);
+  // Kodi's display not known: no guess between two
+  EXPECT_EQ(-1, OutputOfTheDisplay(TwoDisplays(), DisplayIdentity{}, found));
+  EXPECT_TRUE(found == DisplayOutputFound::SEVERAL);
+  // two displays of one model: neither is known to be Kodi's
+  std::vector<DisplayOutputCandidate> twins = TwoDisplays();
+  twins[1] = Out(PRESENT, Eld(ISP, "ISP Elite MK2"));
+  EXPECT_EQ(-1, OutputOfTheDisplay(twins, Edid(ISP, "ISP Elite MK2"), found));
+  EXPECT_TRUE(found == DisplayOutputFound::SEVERAL);
+}
