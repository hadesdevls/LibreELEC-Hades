+
+//! An output of any driver, as OutputOfTheDisplay() needs to know it
+struct DisplayOutputCandidate
+{
+  FollowCandidate::Display display{FollowCandidate::Display::UNKNOWN};
+  bool usable{false}; //!< it can be used for this kind of output (PCM, or passthrough)
+  KODI::UTILS::DisplayIdentity identity; //!< of the display on it, by its ELD; maker 0: not known
+};
+
+//! What OutputOfTheDisplay() found
+enum class DisplayOutputFound
+{
+  ONE, //!< the output of the display Kodi uses, or the only output with a display
+  NONE, //!< no output that can be used has a display
+  SEVERAL, //!< several outputs have a display, and none of them is known to be Kodi's alone
+  NOT_THIS_DISPLAY, //!< outputs have displays, none of them the display Kodi uses
+};
+
+/*!
+ * \brief Hades: the audio output of the display that Kodi shows its picture on, for a device
+ *        setting that the user has not chosen (CActiveAE::ChooseOutputsForTheDisplay())
+ * \param outputs the outputs of every driver, as the settings list them
+ * \param driven the display that Kodi uses (KODI::UTILS::CDrivenDisplay); maker 0: not known
+ * \param found set to what was found
+ * \return the index in outputs of that output; -1: none
+ *
+ * Kodi's own default is the first output of the list, which on a PC is the analog output of its
+ * sound chip: with the TV on the HDMI output of the graphics card, and a sound bar on the TV, there
+ * was no sound until the output was found in the settings (issue #6, 2026-10-25). The audio data
+ * of an HDMI or DisplayPort output names its display with the same codes as the EDID that Kodi
+ * reads, so the output of that display is known, not guessed. Where Kodi's display is not known
+ * (another windowing system), only an output that is the one with a display at all is taken.
+ * Nothing is taken from several displays of which none is known to be Kodi's (two TVs of one
+ * model), and no other display's output is taken when Kodi's own has no audio (a monitor without
+ * speakers): Kodi's default stays.
+ */
+inline int OutputOfTheDisplay(const std::vector<DisplayOutputCandidate>& outputs,
+                              const KODI::UTILS::DisplayIdentity& driven,
+                              DisplayOutputFound& found)
+{
+  int first = -1;
+  unsigned int displays = 0;
+  int matched = -1;
+  unsigned int matches = 0;
+  for (size_t i = 0; i < outputs.size(); ++i)
+  {
+    const DisplayOutputCandidate& output = outputs[i];
+    if (output.display != FollowCandidate::Display::PRESENT || !output.usable)
+      continue;
+    if (displays++ == 0)
+      first = static_cast<int>(i);
+    if (driven.Known() && KODI::UTILS::SameDisplay(driven, output.identity) && matches++ == 0)
+      matched = static_cast<int>(i);
+  }
+
+  if (displays == 0)
+  {
+    found = DisplayOutputFound::NONE;
+    return -1;
+  }
+  if (driven.Known())
+  {
+    found = matches == 1   ? DisplayOutputFound::ONE
+            : matches == 0 ? DisplayOutputFound::NOT_THIS_DISPLAY
+                           : DisplayOutputFound::SEVERAL;
+    return matches == 1 ? matched : -1;
+  }
+  found = displays == 1 ? DisplayOutputFound::ONE : DisplayOutputFound::SEVERAL;
+  return displays == 1 ? first : -1;
+}
+
+/*!
+ * \brief Hades: whether a device setting holds the user's choice
+ * \param value the value of the setting
+ * \param automatic the value that was put in it without the user (by
+ *        CActiveAE::ChooseOutputsForTheDisplay(), or by the list of the settings when the value
+ *        was not among the outputs); empty when the user changed the setting after that
+ *
+ * Kodi's default ("Default", which is no output: Kodi takes the first one for it) is no choice.
+ * A value that was in the setting before Hades kept what it put there (from an earlier version,
+ * where the list of the settings also put the first output there by itself) counts as the user's:
+ * what may be the user's choice is never changed.
+ */
+inline bool ChosenByUser(const std::string& value, const std::string& automatic)
+{
+  const auto lower = [](std::string text)
+  {
+    for (char& c : text)
+      c = static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c);
+    return text;
+  };
+  if (value.empty() || lower(value) == "default")
+    return false;
+  return automatic.empty() || value != automatic;
+}
 } // namespace ActiveAE::INTERNAL
