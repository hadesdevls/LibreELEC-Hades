+void CDVLayerMerge::SetTimeBases(AVRational base, AVRational enhancement)
+{
+  m_timeBase = base;
+  m_enhancementTimeBase = enhancement;
+}
+
+// What the packet already has in its strings metadata stays. False when it could not be set:
+// the packet then has what it had, or no strings metadata at all.
+bool CDVLayerMerge::SetLayerTime(AVPacket* packet, const char* value)
+{
+  AVDictionary* dictionary = nullptr;
+  size_t size = 0;
+  bool set = false;
+  const uint8_t* old = av_packet_get_side_data(packet, AV_PKT_DATA_STRINGS_METADATA, &size);
+  if ((!old || av_packet_unpack_dictionary(old, size, &dictionary) >= 0) &&
+      av_dict_set(&dictionary, LAYER_TIME, value, 0) >= 0)
+  {
+    uint8_t* data = av_packet_pack_dictionary(dictionary, &size);
+    if (data)
+    {
+      av_packet_side_data_remove(packet->side_data, &packet->side_data_elems,
+                                 AV_PKT_DATA_STRINGS_METADATA);
+      set = av_packet_add_side_data(packet, AV_PKT_DATA_STRINGS_METADATA, data, size) >= 0;
+      if (!set)
+        av_free(data);
+    }
+  }
+  av_dict_free(&dictionary);
+  return set;
+}
+
+// See LAYER_TIME.
+void CDVLayerMerge::AttachLayerTime(AVPacket* base, int64_t enhancementPts) const
+{
+  if (m_timeBase.num <= 0 || m_timeBase.den <= 0 || m_enhancementTimeBase.num <= 0 ||
+      m_enhancementTimeBase.den <= 0 || base->pts == AV_NOPTS_VALUE ||
+      enhancementPts == AV_NOPTS_VALUE)
+    return;
+
+  // av_rescale_q() gives AV_NOPTS_VALUE for what does not fit
+  const int64_t pts = av_cmp_q(m_enhancementTimeBase, m_timeBase) == 0
+                          ? enhancementPts
+                          : av_rescale_q(enhancementPts, m_enhancementTimeBase, m_timeBase);
+  const int64_t limit = av_rescale(MAX_LAYER_APART, m_timeBase.den, m_timeBase.num);
+  if (pts == AV_NOPTS_VALUE || limit <= 0)
+    return;
+
+  const bool later = pts > base->pts;
+  const uint64_t apart = later ? static_cast<uint64_t>(pts) - static_cast<uint64_t>(base->pts)
+                               : static_cast<uint64_t>(base->pts) - static_cast<uint64_t>(pts);
+  if (apart > static_cast<uint64_t>(limit))
+    return;
+
+  char value[80];
+  std::snprintf(value, sizeof(value), "%s%" PRIu64 " %d %d", later || apart == 0 ? "" : "-", apart,
+                m_timeBase.num, m_timeBase.den);
+  SetLayerTime(base, value);
+}
