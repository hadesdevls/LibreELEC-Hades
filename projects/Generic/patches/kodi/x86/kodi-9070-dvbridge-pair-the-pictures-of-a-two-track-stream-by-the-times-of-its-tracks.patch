@@ -15,6 +17,19 @@
 #define SURFACES_MAX 32
 /* Base pictures between two attempts to open an enhancement decoder that failed to open. */
 #define OPEN_RETRY_PICTURES 240
+/* Hades: in a stream that gives the times of its enhancement access units, more of them without
+ * one than UNTIMED_MAX, with never UNTIMED_CLEAR in a row that have one in between: the stream is
+ * paired by picture order from then on. A few are holes in the layer; many are a stream that
+ * times only some of its access units, which picture order pairs and times do not. Only those
+ * count that picture order would pair: the packet has its own time, and the stream says nothing
+ * of the time of its enhancement access unit. */
+#define UNTIMED_MAX 8
+#define UNTIMED_CLEAR 240
+/* Seconds between the presentation times of the two layers of a packet; more is no time
+ * (CDVLayerMerge::MAX_LAYER_APART). */
+#define LAYER_APART_MAX 10
+/* The times of this many base packets are kept, to know a time that two of them had. */
+#define BASE_TIMES_MAX MAP_MAX
 /* Independently coded layers can have different decode
  * order and IDR boundaries. Use FFmpeg's HEVC parser rather than assigning
  * the BL packet timestamp blindly to the encapsulated EL access unit. */
@@ -123,6 +138,26 @@ struct dvbridge_fel {
     bool opened, failed, draining, sent_eof, eof;
     struct picture_order base_order, enhancement_order;
     int64_t packet_order[QUEUE_MAX];
+    /* Hades: DVBRIDGE_FEL_LAYER_TIME. The time that the stream gave each queued access unit,
+     * and whether the pictures are paired by those times. */
+    int64_t packet_time[QUEUE_MAX];
+    bool timed;
+    bool order_only;   /* too many access units came without a time: by picture order for good */
+    int64_t tolerance; /* of a time that was converted on its way here */
+    int64_t apart_max; /* LAYER_APART_MAX in the time base */
+    unsigned untimed;  /* access units without a time while timed: not decoded */
+    unsigned untimed_recent, timed_run; /* for UNTIMED_MAX and UNTIMED_CLEAR */
+    /* The times of the last base packets, and whether two of them had the time that stands for
+     * 0 (dvbridge_fel_time_zero()): a time that two packets had is not the time of one
