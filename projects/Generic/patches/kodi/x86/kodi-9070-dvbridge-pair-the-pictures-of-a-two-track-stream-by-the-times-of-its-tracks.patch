@@ -300,30 +451,36 @@ static bool pump(struct dvbridge_fel *f)
     while (f->num_packets && f->num_frames < QUEUE_MAX) {
         AVPacket *packet = f->packets[0];
         unsigned match = 0;
-        while (match < f->num_times && f->times[match].order != f->packet_order[0])
+        /* Hades: an access unit that the stream gave its time has it; any other one takes the
+         * time of the base picture of its picture order. */
+        const bool timed = f->packet_time[0] != AV_NOPTS_VALUE;
+        while (!timed && match < f->num_times && f->times[match].order != f->packet_order[0])
             ++match;
-        if (match == f->num_times) {
+        if (!timed && match == f->num_times) {
             if (f->draining) {
                 f->reason = "an enhancement picture has no base picture at the end of the stream";
                 goto fail;
             }
             break; /* A reference EL picture can precede its corresponding BL. */
         }
-        packet->pts = f->times[match].pts;
+        packet->pts = timed ? f->packet_time[0] : f->times[match].pts;
         packet->dts = AV_NOPTS_VALUE;
         int result = avcodec_send_packet(f->decoder, packet);
         if (result == AVERROR(EAGAIN))
             break;
         if (result < 0)
             goto fail;
-        --f->num_times;
-        memmove(f->times + match, f->times + match + 1,
-                (f->num_times - match) * sizeof(*f->times));
+        if (!timed) {
+            --f->num_times;
+            memmove(f->times + match, f->times + match + 1,
+                    (f->num_times - match) * sizeof(*f->times));
+        }
         f->packet_bytes -= packet->size;
         av_packet_free(&packet);
         --f->num_packets;
         memmove(f->packets, f->packets + 1, f->num_packets * sizeof(*f->packets));
         memmove(f->packet_order, f->packet_order + 1, f->num_packets * sizeof(*f->packet_order));
+        memmove(f->packet_time, f->packet_time + 1, f->num_packets * sizeof(*f->packet_time));
         if (!receive_frames(f))
             goto fail;
     }
@@ -392,25 +549,67 @@ bool dvbridge_fel_device(struct dvbridge_fel *f, AVBufferRef *device, bool pictu
 
 bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
 {
-    if (!f || !packet || f->failed || f->draining || packet->size <= 0 ||
-        packet->pts == AV_NOPTS_VALUE)
+    if (!f || !packet || packet->size <= 0)
+        return false;
