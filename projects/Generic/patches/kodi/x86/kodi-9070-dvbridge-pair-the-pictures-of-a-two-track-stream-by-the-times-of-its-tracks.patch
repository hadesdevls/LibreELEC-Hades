+    int64_t base_pts[BASE_TIMES_MAX];
+    unsigned next_base_pts;
+    int64_t zero;
+    bool zero_twice;
+    /* base pictures that went out without the layer by an answer 2 of dvbridge_fel_take() that
+     * only a stream paired by its times gets: their enhancement picture was not decoded, or
+     * their time was not theirs alone */
+    unsigned passed_missing, passed_ambiguous;
     struct { int64_t order, pts; } times[MAP_MAX];
     unsigned num_times;
     bool synchronizing;
@@ -135,6 +170,114 @@ struct dvbridge_fel {
     unsigned open_wait; /* base pictures to wait before opening the decoder again */
 };
 
+/* Hades: whether two times are the same but for what a time may lose on its way here. */
+static bool same_time(int64_t a, int64_t b, int64_t tolerance)
+{
+    return (a > b ? (uint64_t)a - (uint64_t)b : (uint64_t)b - (uint64_t)a) <= (uint64_t)tolerance;
+}
+
+/* Hades: the times of the base packets that have come are forgotten. zero_too: also that any
+ * of them had the time that stands for 0; else one that had it counts on, and so does that two
+ * had it (dvbridge_fel_base_flushed()). */
+static void forget_base_times(struct dvbridge_fel *f, bool zero_too)
+{
+    bool zero = false;
+    for (unsigned i = 0; i < BASE_TIMES_MAX; ++i) {
+        zero |= f->base_pts[i] != AV_NOPTS_VALUE &&
+                same_time(f->base_pts[i], f->zero, f->tolerance);
+        f->base_pts[i] = AV_NOPTS_VALUE;
+    }
+    f->next_base_pts = 0;
+    if (zero_too)
+        f->zero_twice = false;
+    else if (zero)
+        f->base_pts[f->next_base_pts++] = f->zero;
+}
+
+/* Hades: takes the time of a base packet among those of the last ones, and returns whether one of
+ * them had it. When it is the time that stands for 0, that is remembered (zero_twice). */
+static bool note_base_time(struct dvbridge_fel *f, int64_t pts)
+{
+    if (pts == AV_NOPTS_VALUE)
+        return false;
+    bool again = false;
+    for (unsigned i = 0; i < BASE_TIMES_MAX && !again; ++i)
+        again = f->base_pts[i] != AV_NOPTS_VALUE && same_time(pts, f->base_pts[i], f->tolerance);
+    f->base_pts[f->next_base_pts++ % BASE_TIMES_MAX] = pts;
+    if (again && same_time(pts, f->zero, f->tolerance))
+        f->zero_twice = true;
+    return again;
+}
+
+/* A decimal number of at most max; *text is left at what follows it. */
+static bool parse_number(const char **text, int64_t max, int64_t *value)
+{
+    const char *p = *text;
+    int64_t v = 0;
+    if (*p < '0' || *p > '9')
+        return false;
+    for (; *p >= '0' && *p <= '9'; ++p) {
+        if (v > (max - (*p - '0')) / 10)
+            return false;
+        v = v * 10 + (*p - '0');
+    }
+    *text = p;
+    *value = v;
+    return true;
+}
+
+/* "<difference> <numerator> <denominator>": decimal, one space between them, nothing else. */
+static bool parse_layer_time(const char *text, int64_t *difference, AVRational *base)
+{
+    int64_t magnitude, num, den;
+    const bool negative = *text == '-';
+    if (negative)
+        ++text;
+    if (!parse_number(&text, INT64_MAX, &magnitude) || *text != ' ')
+        return false;
+    ++text;
+    if (!parse_number(&text, INT_MAX, &num) || *text != ' ')
+        return false;
+    ++text;
+    if (!parse_number(&text, INT_MAX, &den) || *text || !num || !den)
+        return false;
+    *difference = negative ? -magnitude : magnitude;
+    *base = (AVRational){(int)num, (int)den};
+    return true;
+}
+
+/* Hades: the presentation time of the enhancement access unit of a packet, when the stream
+ * gives it (DVBRIDGE_FEL_LAYER_TIME); AV_NOPTS_VALUE otherwise.
+ * said: the packet has the entry, whatever is in it: the stream times this access unit. When
+ * the time is not usable (DVBRIDGE_FEL_LAYER_TIME_UNUSABLE), the access unit is a hole in the
+ * layer and no sign of a stream that leaves the times of its access units out. */
+static int64_t layer_time(const struct dvbridge_fel *f, const AVPacket *packet, bool *said)
+{
+    size_t size = 0;
+    AVDictionary *dictionary = NULL;
+    int64_t time = AV_NOPTS_VALUE;
+    *said = false;
+    if (f->order_only)
+        return time;
+    const uint8_t *data = av_packet_get_side_data(packet, AV_PKT_DATA_STRINGS_METADATA, &size);
+    if (data && av_packet_unpack_dictionary(data, size, &dictionary) >= 0) {
+        const AVDictionaryEntry *entry = av_dict_get(dictionary, DVBRIDGE_FEL_LAYER_TIME, NULL, 0);
+        int64_t difference;
+        AVRational base;
+        *said = entry != NULL;
+        if (entry && packet->pts != AV_NOPTS_VALUE &&
+            parse_layer_time(entry->value, &difference, &base)) {
+            /* av_rescale_q() gives INT64_MIN for what does not fit */
+            int64_t apart = av_rescale_q(difference, base, f->time_base);
+            if (apart >= -f->apart_max && apart <= f->apart_max &&
+                (apart >= 0 ? packet->pts <= INT64_MAX - apart : packet->pts >= INT64_MIN - apart))
+                time = packet->pts + apart;
+        }
+    }
+    av_dict_free(&dictionary);
+    return time;
+}
+
