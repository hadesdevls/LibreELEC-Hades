+namespace
+{
+// "<difference> <numerator> <denominator>": decimal, one space between them, nothing else, as
+// the module that takes the entry reads it (parse_layer_time() in dvbridge_fel.c).
+bool ParseLayerTime(const char* text, int64_t& apart, int& num, int& den)
+{
+  const char* const end = text + std::strlen(text);
+  auto read = std::from_chars(text, end, apart);
+  // (the module reads the sign and then the number: the least value is none to it)
+  if (read.ec != std::errc() || read.ptr == end || *read.ptr != ' ' ||
+      apart == std::numeric_limits<int64_t>::min())
+    return false;
+  read = std::from_chars(read.ptr + 1, end, num);
+  if (read.ec != std::errc() || read.ptr == end || *read.ptr != ' ')
+    return false;
+  read = std::from_chars(read.ptr + 1, end, den);
+  return read.ec == std::errc() && read.ptr == end && num > 0 && den > 0;
+}
+} // namespace
+
+bool CDVLayerMerge::CheckLayerTime(AVPacket* packet,
+                                   const std::function<double(int64_t)>& microseconds)
+{
+  if (packet->pts == AV_NOPTS_VALUE)
+    return true;
+
+  // The difference as AttachLayerTime() wrote it, in the time base of the packet. An entry in
+  // another time base is one that was set right here before (a reader may keep a packet and
+  // look at it again): its difference is not one to add to the time of the packet.
+  size_t size = 0;
+  AVDictionary* dictionary = nullptr;
+  int64_t apart = 0;
+  int num = 0;
+  int den = 0;
+  bool written = false;
+  const uint8_t* data = av_packet_get_side_data(packet, AV_PKT_DATA_STRINGS_METADATA, &size);
+  if (data && av_packet_unpack_dictionary(data, size, &dictionary) >= 0)
+  {
+    const AVDictionaryEntry* entry = av_dict_get(dictionary, LAYER_TIME, nullptr, 0);
+    written = entry && ParseLayerTime(entry->value, apart, num, den) &&
+              av_cmp_q(AVRational{num, den}, m_timeBase) == 0;
+  }
+  av_dict_free(&dictionary);
+  if (!written)
+    return true;
+
+  // Both times as the reader has them, to a microsecond for the arithmetic: pictures are
+  // thousands of them apart.
+  const int64_t most = std::numeric_limits<int64_t>::max() - 1;
+  const int64_t least = std::numeric_limits<int64_t>::min() + 1;
+  const bool fits = apart >= 0 ? packet->pts <= most - apart : packet->pts >= least - apart;
+  bool usable = false;
+  if (fits)
+  {
+    // The base picture that is presented with the access unit has the time that the reader
+    // makes of the time of the access unit. A time that the reader also gives to the time
+    // after it is one that it makes of many (Kodi's: 0, of every time in the half second
+    // before the start), and names no picture.
+    const int64_t unit = packet->pts + apart;
+    const double layer = microseconds(unit);
+    if (microseconds(unit + 1) != layer)
+    {
+      const double wanted = static_cast<double>(apart) * num / den * 1e6;
+      const double found = layer - microseconds(packet->pts);
+      if (std::abs(found - wanted) < 1.0)
+        return true;
+
+      // The reader moved the two apart: the difference between its two times is the one that
+      // holds.
+      if (std::abs(found) <= MAX_LAYER_APART * 1e6)
+      {
+        char value[80];
+        std::snprintf(value, sizeof(value), "%lld 1 1000000", std::llround(found));
+        usable = SetLayerTime(packet, value);
+      }
+    }
+  }
+  if (usable)
+    return true;
+
+  // never a difference that names another picture: when the entry cannot be changed, it goes
+  if (!SetLayerTime(packet, LAYER_TIME_UNUSABLE))
+    av_packet_side_data_remove(packet->side_data, &packet->side_data_elems,
+                               AV_PKT_DATA_STRINGS_METADATA);
+  m_counts.unusable++;
+  return false;
+}
