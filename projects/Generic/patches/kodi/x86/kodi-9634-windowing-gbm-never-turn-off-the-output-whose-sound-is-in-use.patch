+
+std::string CDRMUtils::KeptBy(const std::string& node,
+                              const std::vector<std::string>& connectors) const
+{
+  bool byFile = false;
+  bool bySound = false;
+  for (const std::string& connector : connectors)
+  {
+    byFile = byFile || KeptOutputs().Keeps(node, connector);
+    bySound = bySound || m_soundKept.contains({node, connector});
+  }
+  if (byFile && bySound)
+    return "hades-keep-outputs; the sound in use";
+  return bySound ? "the sound in use" : "hades-keep-outputs";
+}
+
+namespace
+{
+// Hades: "0000:01:00.0" for a device on PCI; empty for one that is not
+std::string PciOf(int fd)
+{
+  drmDevicePtr device = nullptr;
+  if (drmGetDevice2(fd, 0, &device) != 0 || !device)
+    return {};
+  std::string pci;
+  if (device->bustype == DRM_BUS_PCI && device->businfo.pci)
+    pci =
+        fmt::format("{:04x}:{:02x}:{:02x}.{:x}", device->businfo.pci->domain,
+                    device->businfo.pci->bus, device->businfo.pci->dev, device->businfo.pci->func);
+  drmFreeDevice(&device);
+  return pci;
+}
+
+// Hades: the EDID of a connector, from its property EDID (a blob that the driver keeps while a
+// display is connected); empty when it has none
+std::vector<uint8_t> EdidOf(int fd, const drmModeConnector& connector)
+{
+  std::vector<uint8_t> edid;
+  for (int i = 0; i < connector.count_props && edid.empty(); i++)
+  {
+    drmModePropertyPtr property = drmModeGetProperty(fd, connector.props[i]);
+    if (property && strcmp(property->name, "EDID") == 0 && connector.prop_values[i] != 0)
+    {
+      if (drmModePropertyBlobPtr blob =
+              drmModeGetPropertyBlob(fd, static_cast<uint32_t>(connector.prop_values[i])))
+      {
+        const auto* data = static_cast<const uint8_t*>(blob->data);
+        edid.assign(data, data + blob->length);
+        drmModeFreePropertyBlob(blob);
+      }
+    }
+    drmModeFreeProperty(property);
+  }
+  return edid;
+}
+
+KODI::UTILS::DisplayIdentity IdentityOf(const std::vector<uint8_t>& edid, const std::string& name)
+{
+  KODI::UTILS::DisplayIdentity identity = KODI::UTILS::IdentityOfEdid(edid);
+  identity.model = EdidDisplayName(edid);
+  identity.output = name;
+  return identity;
+}
+} // unnamed namespace
+
+KEEP_OUTPUTS::GraphicsDevice CDRMUtils::SurveyDevice(int fd, const std::string& node)
+{
+  KEEP_OUTPUTS::GraphicsDevice device;
+  device.node = node;
+  device.pci = PciOf(fd);
+  drmModeResPtr resources = drmModeGetResources(fd);
+  if (!resources)
+    return device;
+  // (the CRTC of an output, as TurnOffOtherDevice() finds it: asking for atomic modesetting
+  // changes nothing else of this handle)
+  const bool atomic = drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) == 0;
+  for (int i = 0; i < resources->count_connectors; i++)
+  {
+    drmModeConnectorPtr connector = drmModeGetConnectorCurrent(fd, resources->connectors[i]);
+    if (!connector)
+      continue;
+    const char* type = drmModeGetConnectorTypeName(connector->connector_type);
+    KEEP_OUTPUTS::GraphicsOutput output;
+    output.name =
+        std::string(type ? type : "unknown") + "-" + std::to_string(connector->connector_type_id);
+    output.sound = type && KEEP_OUTPUTS::CarriesSound(type);
+    output.connected = connector->connection == DRM_MODE_CONNECTED;
+    if (output.connected)
+      output.identity = IdentityOf(EdidOf(fd, *connector), output.name);
+    const std::optional<uint64_t> atomicCrtc =
+        atomic ? AtomicCrtcOf(fd, connector->connector_id) : std::nullopt;
+    uint32_t encoderCrtc = 0;
+    if (!atomicCrtc && connector->encoder_id != 0)
+    {
+      if (drmModeEncoderPtr encoder = drmModeGetEncoder(fd, connector->encoder_id))
+      {
+        encoderCrtc = encoder->crtc_id;
+        drmModeFreeEncoder(encoder);
+      }
+    }
+    output.lit = KEEP_OUTPUTS::CrtcOfOutput(atomicCrtc, encoderCrtc) != 0;
+    device.outputs.push_back(std::move(output));
+    drmModeFreeConnector(connector);
+  }
+  drmModeFreeResources(resources);
+  return device;
+}
+
+KEEP_OUTPUTS::GraphicsDevice CDRMUtils::SurveyOwnDevice() const
+{
+  KEEP_OUTPUTS::GraphicsDevice device;
+  device.node = m_node;
+  device.pci = PciOf(m_fd);
+  for (const auto& connector : m_connectors)
+  {
+    KEEP_OUTPUTS::GraphicsOutput output;
+    output.name = connector->GetName();
+    output.sound = KEEP_OUTPUTS::CarriesSound(connector->GetType());
+    output.connected = connector->IsConnected();
+    if (output.connected)
+      output.identity = IdentityOf(connector->GetEDID(), output.name);
+    output.lit = connector->GetPropertyValue("CRTC_ID").value_or(0) != 0;
+    device.outputs.push_back(std::move(output));
+  }
+  return device;
+}
+
+void CDRMUtils::DecideSoundOutputs(const std::vector<KEEP_OUTPUTS::GraphicsDevice>& others)
+{
+  uint64_t generation = 0;
+  const std::vector<KODI::UTILS::SoundOutput> sound =
+      KODI::UTILS::CSoundOutputsInUse::Get(generation);
+  m_soundGeneration = generation;
+
+  std::vector<KEEP_OUTPUTS::GraphicsDevice> devices{SurveyOwnDevice()};
+  devices.insert(devices.end(), others.begin(), others.end());
+  const KEEP_OUTPUTS::SoundDecision decision =
+      KEEP_OUTPUTS::OutputsForSound(sound, generation != 0, devices);
+
+  for (const KEEP_OUTPUTS::SoundKeep& keep : decision.keep)
+  {
+    // (the output that Kodi draws on is on anyway: said only when nothing else is)
+    if (keep.node == m_node && m_connector && keep.output == m_connector->GetName())
+      continue;
+    if (!m_soundKept.insert({keep.node, keep.output}).second)
+      continue;
+    CLog::LogF(LOGINFO, "{}: {} ({}) stays on for {}", keep.node, keep.output,
+               keep.display.Known() ? keep.display.Describe() : "no display known",
+               StringUtils::Join(keep.why, "; "));
+  }
+  if (decision.notes != m_soundNotesTold)
+  {
+    for (const std::string& note : decision.notes)
+      CLog::LogF(LOGINFO, "{}", note);
+    m_soundNotesTold = decision.notes;
+  }
+  if (m_soundKept.empty() && decision.notes.empty() && !sound.empty())
+    CLog::LogF(LOGINFO,
+               "the sound in use is on the output that Kodi draws on ({}): no other "
+               "output is kept on for it",
+               m_connector ? m_connector->GetName() : "none");
+}
+
+bool CDRMUtils::SoundOutputsChanged() const
+{
+  return m_otherOutputsDone && KODI::UTILS::CSoundOutputsInUse::Generation() != m_soundGeneration;
+}
+
+bool CDRMUtils::WaitsForSoundOutputs()
+{
+  // (30 s at most: then every output that can carry sound and has a display stays on, which is
+  // what KEEP_OUTPUTS::OutputsForSound() keeps while the engine has said nothing)
+  constexpr int waits = 6;
+  if (m_otherOutputsDone || KODI::UTILS::CSoundOutputsInUse::Generation() != 0 ||
+      m_soundWaits >= waits)
+    return false;
+  if (m_soundWaits++ == 0)
+    CLog::LogF(LOGINFO, "the audio engine has not said yet which audio output it uses: the outputs "
+                        "that Kodi does not use are turned off once it has (30 s at most)");
+  return true;
+}
+
+void CDRMUtils::ReconsiderSoundOutputs()
+{
+  // The other devices as they are now where Kodi holds them (it turned outputs off there), else
+  // as they were found: one that Kodi does not hold is not opened again, because closing it gives
+  // it back to the console (DisableOtherDevices()), and nothing was turned off on it.
+  for (auto& survey : m_otherSurveys)
+  {
+    const auto held = std::ranges::find(m_otherDeviceFdNodes, survey.node);
+    if (held != m_otherDeviceFdNodes.end())
+      survey = SurveyDevice(m_otherDeviceFds[held - m_otherDeviceFdNodes.begin()], survey.node);
+  }
+  const std::set<std::pair<std::string, std::string>> before = m_soundKept;
+  DecideSoundOutputs(m_otherSurveys);
+
+  std::set<std::string> giveBack;
+  for (const auto& [node, output] : m_soundKept)
+  {
+    if (before.contains({node, output}))
+      continue;
+    if (node == m_node)
+    {
+      // An output of this device that Kodi turned off has no mode and nothing on it any more.
+      // Lighting it again is a mode set of another CRTC in the commit of Kodi's frame, which can
+      // change the mode of Kodi's own output too (where the two share a clock or the bandwidth of
+      // the device), and on amdgpu needs a picture on it that Kodi does not have: that is not done
+      // under a video. It is on again when Kodi starts again (the console lights it when Kodi
+      // ends, and its sound is in use then).
+      const auto connector = std::ranges::find_if(m_connectors, [&output](const auto& c)
+                                                  { return c->GetName() == output; });
+      if (connector != m_connectors.end() &&
+          (*connector)->GetPropertyValue("CRTC_ID").value_or(0) == 0)
+        CLog::LogF(LOGWARNING,
+                   "{}: {} carries the sound in use now, but it was turned off when Kodi came up "
+                   "and is not lit again under Kodi's picture: it is on again, and kept on, once "
+                   "Kodi starts again",
+                   node, output);
+      continue;
+    }
+    // (only where Kodi holds the device, and the output drives nothing now)
+    const auto survey =
+        std::ranges::find_if(m_otherSurveys, [&node](const auto& s) { return s.node == node; });
+    if (std::ranges::find(m_otherDeviceFdNodes, node) == m_otherDeviceFdNodes.end() ||
+        survey == m_otherSurveys.end())
+      continue;
+    const auto it = std::ranges::find_if(survey->outputs,
+                                         [&output](const auto& o) { return o.name == output; });
+    if (it != survey->outputs.end() && !it->lit)
+      giveBack.insert(node);
+  }
+
+  // (an output of another device that may have been turned off: that device is given back to the
+  // console, which lights its outputs as it does when Kodi ends, and the ones that are not kept on
+  // are turned off again)
+  for (const std::string& node : giveBack)
+  {
+    const auto held = std::ranges::find(m_otherDeviceFdNodes, node);
+    const std::size_t at = held - m_otherDeviceFdNodes.begin();
+    close(m_otherDeviceFds[at]);
+    m_otherDeviceFds.erase(m_otherDeviceFds.begin() + at);
+    m_otherDeviceFdNodes.erase(held);
+    const int fd = open(node.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+    {
+      CLog::LogF(LOGWARNING, "{}: {}: its outputs stay as the console has them", node,
+                 strerror(errno));
+      continue;
+    }
+    CLog::LogF(LOGINFO,
+               "{}: an output of it carries the sound in use now: the console has the device "
+               "back, and its outputs that are not kept on are turned off again",
+               node);
+    TurnOffOtherDevice(node, fd);
+  }
 }
 
