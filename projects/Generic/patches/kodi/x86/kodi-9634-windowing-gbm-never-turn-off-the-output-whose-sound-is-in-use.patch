+
+//! Hades: an output of a graphics device, as OutputsForSound() needs to know it
+struct GraphicsOutput
+{
+  std::string name; //!< as Kodi names it ("HDMI-A-1")
+  //! An HDMI, DisplayPort or DVI output, which can carry sound (an eDP, LVDS or VGA one cannot)
+  bool sound{false};
+  bool connected{false};
+  //! It drives a CRTC now (for whoever comes back to it; OutputsForSound() does not ask)
+  bool lit{false};
+  //! Its display, by its EDID (KODI::UTILS::IdentityOfEdid(), EdidDisplayName()); maker 0: none
+  UTILS::DisplayIdentity identity;
+};
+
+//! Hades: a graphics device, as OutputsForSound() needs to know it
+struct GraphicsDevice
+{
+  std::string node; //!< "/dev/dri/card1"
+  std::string pci; //!< its PCI address ("0000:01:00.0"); empty when it is not on PCI
+  std::vector<GraphicsOutput> outputs;
+};
+
+//! Hades: whether a type of connector (drmModeGetConnectorTypeName()) can carry sound
+inline bool CarriesSound(const std::string& type)
+{
+  return type == "HDMI-A" || type == "HDMI-B" || type == "DP" || type == "DVI-D" || type == "DVI-I";
+}
+
+//! Hades: a PCI address ("0000:01:00.1") as its domain, bus, device and function
+struct PciAddress
+{
+  unsigned int domain{0};
+  unsigned int bus{0};
+  unsigned int device{0};
+  unsigned int function{0};
+};
+
+inline std::optional<PciAddress> ParsePci(const std::string& text)
+{
+  PciAddress a;
+  char end = 0;
+  if (std::sscanf(text.c_str(), "%x:%x:%x.%x%c", &a.domain, &a.bus, &a.device, &a.function, &end) !=
+      4)
+    return std::nullopt;
+  return a;
+}
+
+/*!
+ * \brief Hades: whether a sound card is the one of a graphics device
+ *
+ * The HD Audio controller of an NVIDIA or AMD graphics card, and of the graphics of an AMD
+ * processor, is another function of the same PCI device (01:00.1 beside the graphics at 01:00.0).
+ * The one of Intel graphics is the controller of the chipset (00:1f.3), which the i915 audio
+ * component links to the graphics (00:02.0) as a consumer of it (i915_audio_component_bind():
+ * device_link_add(), visible in sysfs as "supplier:pci:0000:00:02.0").
+ */
+inline bool CardOfDevice(const UTILS::SoundOutput& sound, const GraphicsDevice& device)
+{
+  const std::optional<PciAddress> graphics = ParsePci(device.pci);
+  if (!graphics)
+    return false;
+  const std::optional<PciAddress> card = ParsePci(sound.card);
+  if (card && card->domain == graphics->domain && card->bus == graphics->bus &&
+      card->device == graphics->device)
+    return true;
+  return std::ranges::any_of(sound.cardSuppliers,
+                             [&graphics](const std::string& supplier)
+                             {
+                               const std::optional<PciAddress> s = ParsePci(supplier);
+                               return s && s->domain == graphics->domain &&
+                                      s->bus == graphics->bus && s->device == graphics->device &&
+                                      s->function == graphics->function;
+                             });
+}
+
+//! Hades: an output kept on for the sound of an audio output, and why, for the log
+struct SoundKeep
+{
+  std::string node;
+  std::string output;
+  UTILS::DisplayIdentity display; //!< its display by its EDID; maker 0 when it has none
+  std::vector<std::string> why; //!< one per audio output that keeps it: which, and how matched
+};
+
+//! Hades: what OutputsForSound() decided
+struct SoundDecision
+{
+  std::vector<SoundKeep> keep;
+  //! What was decided of the audio outputs that keep nothing, or that keep outputs because it is
+  //! not certain which one carries their sound
+  std::vector<std::string> notes;
+
+  bool Keeps(const std::string& node, const std::string& output) const
+  {
+    return std::ranges::any_of(keep, [&](const SoundKeep& k)
+                               { return k.node == node && k.output == output; });
+  }
+};
+
+/*!
+ * \brief Hades: the outputs of the graphics devices that carry the sound of the audio outputs in use
+ * \param sound the audio outputs that the audio engine uses (KODI::UTILS::CSoundOutputsInUse)
+ * \param published the audio engine has said them (its generation is not 0)
+ * \param devices the graphics devices: the one that Kodi uses and the others that drive a display
+ *
+ * Exact where it can be: the sound card is of one graphics device (CardOfDevice()), and of the
+ * outputs of that device one has the display that the ELD of the audio output names
+ * (KODI::UTILS::SameDisplay(): maker, product, and name where both have one). Two outputs with
+ * the same display (two displays of one model) are both kept. Wherever it is not certain which
+ * output carries the sound, every output that can carry sound and has a display connected is
+ * kept, of the graphics device of the card where that is known and of all of them where it is
+ * not: that is what Kodi did before this build turned unused outputs off. An audio output that no
+ * graphics output carries (analog, S/PDIF, USB) keeps nothing.
+ */
+inline SoundDecision OutputsForSound(const std::vector<UTILS::SoundOutput>& sound,
+                                     bool published,
+                                     const std::vector<GraphicsDevice>& devices)
+{
+  SoundDecision decision;
+  const auto keep = [&decision](const GraphicsDevice& device, const GraphicsOutput& output,
+                                const std::string& why)
+  {
+    auto it = std::ranges::find_if(decision.keep, [&](const SoundKeep& k)
+                                   { return k.node == device.node && k.output == output.name; });
+    if (it == decision.keep.end())
+    {
+      decision.keep.push_back({device.node, output.name, output.identity, {}});
+      it = decision.keep.end() - 1;
+    }
+    if (std::ranges::find(it->why, why) == it->why.end())
+      it->why.push_back(why);
+  };
+  // (every output that can carry sound and has a display, of these devices)
+  const auto keepAll = [&](const std::vector<const GraphicsDevice*>& among, const std::string& why)
+  {
+    unsigned int kept = 0;
+    for (const GraphicsDevice* device : among)
+    {
+      for (const GraphicsOutput& output : device->outputs)
+      {
+        if (output.sound && output.connected)
+        {
+          keep(*device, output, why);
+          ++kept;
+        }
+      }
+    }
+    return kept;
+  };
+  std::vector<const GraphicsDevice*> all;
+  for (const GraphicsDevice& device : devices)
+    all.push_back(&device);
+
+  if (!published)
+  {
+    keepAll(all, "the audio engine has not said which output it uses: not certain");
+    decision.notes.emplace_back("the audio engine has not said which audio output it uses: every "
+                                "output that can carry sound and has a display stays on");
+    return decision;
+  }
+
+  for (const UTILS::SoundOutput& s : sound)
+  {
+    const std::string named = "'" + s.device + "' (" + s.role + ")";
+    if (s.kind == UTILS::SoundOutput::Kind::OTHER)
+    {
+      decision.notes.push_back(named + " plays to no graphics output (" + s.why +
+                               "): nothing is kept on for it");
+      continue;
+    }
+    if (s.kind == UTILS::SoundOutput::Kind::UNKNOWN)
+    {
+      const unsigned int kept = keepAll(all, "the sound of " + named + ", not certain: " + s.why);
+      decision.notes.push_back(named + ": not certain which output carries it (" + s.why +
+                               "): every output that can carry sound and has a display stays on (" +
+                               std::to_string(kept) + ")");
+      continue;
+    }
+
+    std::vector<const GraphicsDevice*> ofCard;
+    for (const GraphicsDevice& device : devices)
+    {
+      if (CardOfDevice(s, device))
+        ofCard.push_back(&device);
+    }
+    if (ofCard.empty())
+    {
+      const std::string why =
+          s.card.empty() ? "where its sound card is is not known"
+                         : "its sound card (" + s.card + ") is of none of the graphics devices";
+      const unsigned int kept = keepAll(all, "the sound of " + named + ", not certain: " + why);
+      decision.notes.push_back(named + ": not certain which output carries it (" + why +
+                               "): every output that can carry sound and has a display stays on (" +
+                               std::to_string(kept) + ")");
+      continue;
+    }
+    if (!s.identity.Known())
+    {
+      const std::string why =
+          "its display is not known" + (s.why.empty() ? "" : " (" + s.why + ")");
+      const unsigned int kept = keepAll(ofCard, "the sound of " + named + ", not certain: " + why);
+      decision.notes.push_back(named + ": not certain which output of " + ofCard.front()->node +
+                               " carries it (" + why +
+                               "): every output of it that can carry sound and has a display "
+                               "stays on (" +
+                               std::to_string(kept) + ")");
+      continue;
+    }
+
+    std::vector<std::pair<const GraphicsDevice*, const GraphicsOutput*>> matches;
+    for (const GraphicsDevice* device : ofCard)
+    {
+      for (const GraphicsOutput& output : device->outputs)
+      {
+        if (output.sound && UTILS::SameDisplay(s.identity, output.identity))
+          matches.emplace_back(device, &output);
+      }
+    }
+    const std::string of = s.identity.Describe() + (s.fromBefore ? ", as it was seen before" : "");
+    if (matches.empty())
+    {
+      const std::string why = "no output of its graphics device has its display, " + of;
+      const unsigned int kept = keepAll(ofCard, "the sound of " + named + ", not certain: " + why);
+      decision.notes.push_back(named + ": not certain which output carries it (" + why +
+                               "): every output of " + ofCard.front()->node +
+                               " that can carry sound and has a display stays on (" +
+                               std::to_string(kept) + ")");
+      continue;
+    }
+    const std::string how =
+        matches.size() == 1
+            ? "the sound of " + named + ": its ELD names " + of + ", the display of this output"
+            : "the sound of " + named + ": its ELD names " + of + ", and " +
+                  std::to_string(matches.size()) +
+                  " outputs have a display of that maker, product and name: all of them stay on";
+    for (const auto& [device, output] : matches)
+      keep(*device, *output, how);
+  }
+  return decision;
+}
+
+} // namespace KEEP_OUTPUTS
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
