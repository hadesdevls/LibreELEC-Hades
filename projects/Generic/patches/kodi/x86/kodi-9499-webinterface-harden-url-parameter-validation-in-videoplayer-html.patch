From 58261c87422348923c01f4466ec6b8a12df6e1e0 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:38 +0000
Subject: [PATCH] [webinterface] Harden URL parameter validation in
 videoPlayer.html

CodeQL js/client-side-unvalidated-url-redirection: getParameterByName
checked for a scheme before stripping <, > and ", so a leading "<"
hid "javascript:" or "//" from the check (e.g. src=<javascript:...
reached the Stream link and window.location). Strip those characters
before validating.

Browsers also treat "\" as "/", so src=\\evil.com produced an off-site
link, and the embed/object players prefix src with "/", turning
src=/evil.com into a protocol-relative URL. Chorus only passes
relative vfs/ paths as src, so reject any leading slash there. bg keeps
the previous rule, as Chorus passes /image/... fanart paths.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 addons/webinterface.default/videoPlayer.html | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/addons/webinterface.default/videoPlayer.html b/addons/webinterface.default/videoPlayer.html
index bb415a4..94a188f 100644
--- a/addons/webinterface.default/videoPlayer.html
+++ b/addons/webinterface.default/videoPlayer.html
@@ -19,10 +19,12 @@
                     results = regex.exec(location.search);
             var res = results == null ? "" : results[1].replace(/\+/g, " ");
             try { res = decodeURIComponent(res); } catch (e) { return ""; }
-            res = res.replace(/[\u0000-\u001F\u007F]/g, "").trim();
+            res = res.replace(/[\u0000-\u001F\u007F<>"]/g, "").trim();
             // Reject any absolute/protocol-relative URL or URL with a scheme (prevents javascript:, data:, http:, etc.)
-            if (/^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|\/\/)/.test(res)) return "";
-            return res.replace(/[<>\"]/g, "");
+            // Browsers treat "\" like "/", and src is prefixed with "/" in places, so reject any leading slash in src.
+            if (/^(?:[a-zA-Z][a-zA-Z0-9+.-]*:|\/\/)/.test(res) ||
+                (name === "src" && /^[\/\\]/.test(res))) return "";
+            return res;
         }
         function getBaseURL() {
             var parts = window.location.href.split('videoPlayer.html');
-- 
