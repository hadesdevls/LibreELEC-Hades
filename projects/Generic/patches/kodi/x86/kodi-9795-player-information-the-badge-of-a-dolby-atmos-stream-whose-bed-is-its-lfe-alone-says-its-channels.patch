From 2b3ac01d60a14b75be62cd5f58d073c3e85dbee4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:58:09 +0000
Subject: [PATCH] player information: the badge of a Dolby Atmos stream whose
 bed is its LFE alone says its channels

The badge of the sound on the overview page takes the layout of the bed of an
object-based stream where it has one ("TrueHD Atmos 7.1.2"). A program of dynamic
objects (b_dyn_object_only_program, ETSI TS 103 420 5.5.3), which is how most streams of
Dolby Atmos in TrueHD and in E-AC-3 are made, has no bed but its LFE, and the audio
presentation names that bed "LFE" (Bed::Name()). The badge then read "TrueHD Atmos LFE"
or "DD+ Atmos LFE".

A bed is the layout of the badge only where it is one, with speakers around the listener
(BedLayout(): "main.lfe[.top]" with main above 0); otherwise the channels of the stream
say it, as for any other stream: "TrueHD Atmos 7.1". Speakers() already left such a bed
to the channels.

Host test (outside the tree): the test of the header, with the badge of such streams and
of a bed that is a layout; against the header before, 4 of its checks fail.
---
 xbmc/utils/HadesPlayerInfo.h | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 51006ba..075b75d 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -417,10 +417,25 @@ inline std::string ChannelsName(int channels)
   }
 }
 
+/*!
+ * \brief The bed of an object-based stream where it is a layout of speakers ("7.1.2", "5.1"), or
+ *        empty where it is not: a program of dynamic objects has no bed but its LFE, which the
+ *        audio presentation names "LFE" (KODI::AE::PRESENTATION::Bed::Name()), as most streams
+ *        of Dolby Atmos have it
+ */
+inline std::string BedLayout(const std::string& bed)
+{
+  int main = 0, lfe = 0;
+  if (std::sscanf(bed.c_str(), "%d.%d", &main, &lfe) < 2 || main <= 0)
+    return "";
+  return bed;
+}
+
 /*!
  * \brief "TrueHD Atmos 7.1.2", "DTS-HD MA 5.1", "Dolby Digital+ 5.1"
  * \param codec the codec of the stream as VideoPlayer.AudioCodec has it (truehd_atmos, ...)
- * \param bed the layout of the bed of an object-based stream (7.1.2), or empty
+ * \param bed the bed of an object-based stream (7.1.2), or empty; one that is no layout of
+ *        speakers (BedLayout(): an LFE alone) says nothing, and the channels do
  * \param channels the channels of the stream, where it has no bed
  */
 inline std::string AudioBadge(const std::string& codec, const std::string& bed, int channels)
@@ -450,7 +465,8 @@ inline std::string AudioBadge(const std::string& codec, const std::string& bed,
     for (auto& c : name)
       c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
   }
-  const std::string layout = !bed.empty() ? bed : ChannelsName(channels);
+  const std::string bedLayout = BedLayout(bed);
+  const std::string layout = !bedLayout.empty() ? bedLayout : ChannelsName(channels);
   return layout.empty() ? name : name + " " + layout;
 }
 
