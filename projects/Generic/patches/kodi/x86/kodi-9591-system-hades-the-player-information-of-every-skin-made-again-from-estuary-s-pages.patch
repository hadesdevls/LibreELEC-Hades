From 44cbeac8855c28dce0682b36a65de60628e4fb28 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:23:11 +0000
Subject: [PATCH] system/hades: the player information of every skin, made
 again from Estuary's pages

system/hades/HadesIncludes.xml and DialogHadesPlayerInfo.xml are generated from Estuary's
DialogPlayerProcessInfo.xml, Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml and
Defaults.xml (tools/hades-playerinfo/make-playerinfo.py), and were last made with the commit
in which the player information says HDR10+. What came into those pages since was missing for a
skin other than Estuary: "make-playerinfo.py --check" said both were stale.

Made again with the script, nothing edited by hand. HadesIncludes.xml gains the reason "sdrbase"
("the SDR base layer (BT.1886) could not be composed as ETSI GS CCM 001 says", Estuary #31874),
the transport of a picture that libplacebo's reshaping composed ("Converted to BT.2020
(libplacebo's reshaping)", #32003 and #31912, for the fallback and for BT.2020), and the step-down
level of frames with GUI elements ("level N" and "M with GUI", a middle dot between them, #31866
and #31788). DialogHadesPlayerInfo.xml gains the row "GPU by pass" (#31749) of the Dolby Vision
page and its taller background (418 in place of 374 while that row is shown), as in Estuary. The
textures are unchanged. "make-playerinfo.py --check" now says "up to date".
---
 system/hades/DialogHadesPlayerInfo.xml | 26 +++++++++++++++++++++++++-
 system/hades/HadesIncludes.xml         |  4 ++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index 0043d3d..3823e1c 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -2982,7 +2982,16 @@
 				<top>-220</top>
 				<height>374</height>
 				<texture border="40">special://xbmc/system/hades/dialogs-dialog-bg-nobo.png</texture>
-				<visible>String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555)</visible>
+				<visible>String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555) + String.IsEmpty(Window(Home).Property(hades.dv.passes))</visible>
+				<aspectratio>stretch</aspectratio>
+			</control>
+			<control type="image">
+				<left>0</left>
+				<width>100%</width>
+				<top>-220</top>
+				<height>418</height>
+				<texture border="40">special://xbmc/system/hades/dialogs-dialog-bg-nobo.png</texture>
+				<visible>String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555) + !String.IsEmpty(Window(Home).Property(hades.dv.passes))</visible>
 				<aspectratio>stretch</aspectratio>
 			</control>
 			<control type="grouplist">
@@ -3264,6 +3273,21 @@
 					<scroll>false</scroll>
 					<scrollspeed>40</scrollspeed>
 				</control>
+				<control type="label">
+					<width>885</width>
+					<height>44</height>
+					<aligny>bottom</aligny>
+					<label>$INFO[Window(Home).Property(hades.dv.passes),[COLOR FF12A0C7]$ADDON[skin.estuary 31749]:[/COLOR] ]</label>
+					<font>font14</font>
+					<shadowcolor>FF000000</shadowcolor>
+					<visible>!String.IsEmpty(Window(Home).Property(hades.dv.passes))</visible>
+					<align>left</align>
+					<textcolor>FFF0F0F0</textcolor>
+					<disabledcolor>40FFFFFF</disabledcolor>
+					<selectedcolor>FFFFB70F</selectedcolor>
+					<scroll>false</scroll>
+					<scrollspeed>40</scrollspeed>
+				</control>
 				<itemgap>0</itemgap>
 				<align>left</align>
 			</control>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index a6d433c..e6e230d 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -113,6 +113,7 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),refresh)">$ADDON[skin.estuary 31940]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),rate)">$ADDON[skin.estuary 31685]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),view)">$ADDON[skin.estuary 31710]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sdrbase)">$ADDON[skin.estuary 31874]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),converter)">$ADDON[skin.estuary 31890]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),sink)">$ADDON[skin.estuary 31891]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),frl)">$ADDON[skin.estuary 31892]</value>
@@ -131,10 +132,13 @@
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),lowlatency)">$ADDON[skin.estuary 31925]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source) + String.IsEqual(Window(Home).Property(hades.dv.signal),ictcp)">$ADDON[skin.estuary 32002] (ICtCp)</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),source)">$ADDON[skin.estuary 32002] (YCbCr)</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),fallback) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$ADDON[skin.estuary 32003] ($ADDON[skin.estuary 31912])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),fallback)">$ADDON[skin.estuary 32003] ($ADDON[skin.estuary 32004])</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020) + String.IsEqual(Window(Home).Property(hades.dv.composer),reshaping)">$ADDON[skin.estuary 32003] ($ADDON[skin.estuary 31912])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.transport),bt2020)">$ADDON[skin.estuary 32003]</value>
 	</variable>
 	<variable name="HadesInfoDVStepVar">
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.dv.step)) + !String.IsEmpty(Window(Home).Property(hades.dv.guistep))">$ADDON[skin.estuary 31866] $INFO[Window(Home).Property(hades.dv.step)] · $INFO[Window(Home).Property(hades.dv.guistep)] $ADDON[skin.estuary 31788]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.step),0) + !String.IsEmpty(Window(Home).Property(hades.dv.guiround))">$ADDON[skin.estuary 31865] · $ADDON[skin.estuary 31873]</value>
 		<value condition="!String.IsEmpty(Window(Home).Property(hades.dv.step)) + !String.IsEmpty(Window(Home).Property(hades.dv.guiround))">$ADDON[skin.estuary 31866] $INFO[Window(Home).Property(hades.dv.step)] · $ADDON[skin.estuary 31873]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.step),0)">$ADDON[skin.estuary 31865]</value>
-- 
2.53.0

