From 090ea94f85e2f45d783a2dd8409ff65a97ac5c2d Mon Sep 17 00:00:00 2001
From: Portisch <hugo.portisch@yahoo.de>
Date: Wed, 7 Oct 2026 10:50:34 +0200
Subject: [PATCH] [guilib] Keep retained list item layouts across container
 resets

c3938aa made Reset() free the layouts of all items. Static content items
are fetched again right after a reset (e.g. when the Home window is
re-initialised), so they lose their layout state. A freshly created
focused layout in an unfocused container never runs its UnFocus
animation, which leaves the Estuary main menu highlight visible while
the top bar has focus.

Keep the layouts on Reset() and track dropped items with weak_ptrs
instead; the destructor releases the layouts of any of them that are
still alive, which keeps the crash-on-exit fix from c3938aa intact.

Co-authored-by: Claude <noreply@anthropic.com>
(cherry picked from commit 6f8e592550ea100712da704bc113810c8a018e8d)
---
 xbmc/guilib/GUIBaseContainer.cpp           | 14 ++++++++++++--
 xbmc/guilib/GUIBaseContainer.h             |  6 ++++++
 xbmc/guilib/test/TestGUIListItemLayout.cpp | 11 ++++++++---
 3 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/xbmc/guilib/GUIBaseContainer.cpp b/xbmc/guilib/GUIBaseContainer.cpp
index 08c32aa..2a82fa8 100644
--- a/xbmc/guilib/GUIBaseContainer.cpp
+++ b/xbmc/guilib/GUIBaseContainer.cpp
@@ -149,6 +149,12 @@ CGUIBaseContainer::~CGUIBaseContainer(void)
   // release the container from items
   for (const auto& item : m_items)
     item->FreeMemory();
+
+  for (const auto& weakItem : m_releasedItems)
+  {
+    if (const auto item = weakItem.lock())
+      item->FreeMemory();
+  }
 }
 
 void CGUIBaseContainer::DoProcess(unsigned int currentTime, CDirtyRegionList &dirtyregions)
@@ -1361,8 +1367,12 @@ int CGUIBaseContainer::CorrectOffset(int offset, int cursor) const
 void CGUIBaseContainer::Reset()
 {
   m_wasReset = true;
-  for (const auto& item : m_items)
-    item->FreeMemory();
+
+  // Static items are fetched again right away and must keep their layout state
+  // (e.g. an already applied UnFocus animation).
+  std::erase_if(m_releasedItems, [](const auto& weakItem) { return weakItem.expired(); });
+  m_releasedItems.insert(m_items.begin(), m_items.end());
+
   m_items.clear();
   m_lastItem.reset();
   ResetAutoScrolling();
diff --git a/xbmc/guilib/GUIBaseContainer.h b/xbmc/guilib/GUIBaseContainer.h
index 898475a..e8c8426 100644
--- a/xbmc/guilib/GUIBaseContainer.h
+++ b/xbmc/guilib/GUIBaseContainer.h
@@ -20,6 +20,7 @@
 #include <list>
 #include <memory>
 #include <optional>
+#include <set>
 #include <utility>
 #include <vector>
 
@@ -179,6 +180,11 @@ protected:
   typedef std::vector<std::shared_ptr<CGUIListItem>>::iterator iItems;
   std::shared_ptr<CGUIListItem> m_lastItem;
 
+  // Items dropped by Reset(). The destructor releases the layouts of any that
+  // are still alive, while this container (their layouts' parent) exists.
+  std::set<std::weak_ptr<CGUIListItem>, std::owner_less<std::weak_ptr<CGUIListItem>>>
+      m_releasedItems;
+
   int m_pageControl;
   std::optional<int>
       m_lastPageControlOffset; // cached offset to avoid redundant page control messages
diff --git a/xbmc/guilib/test/TestGUIListItemLayout.cpp b/xbmc/guilib/test/TestGUIListItemLayout.cpp
index 3f7e2f0..59982d0 100644
--- a/xbmc/guilib/test/TestGUIListItemLayout.cpp
+++ b/xbmc/guilib/test/TestGUIListItemLayout.cpp
@@ -124,7 +124,7 @@ private:
 };
 } // namespace
 
-TEST_F(TestGUIListItemLayout, ResetReleasesRetainedItemLayouts)
+TEST_F(TestGUIListItemLayout, ResetKeepsLayoutsUntilContainerIsDestroyed)
 {
   auto item = std::make_shared<CFileItem>();
   auto ancestor = std::make_unique<CTestGroup>();
@@ -141,10 +141,15 @@ TEST_F(TestGUIListItemLayout, ResetReleasesRetainedItemLayouts)
 
   container->Reset();
 
-  EXPECT_EQ(item->GetLayout(), nullptr);
-  EXPECT_EQ(item->GetFocusedLayout(), nullptr);
+  // layouts survive a reset, so a re-fetched item keeps its state
+  EXPECT_NE(item->GetLayout(), nullptr);
+  EXPECT_NE(item->GetFocusedLayout(), nullptr);
   EXPECT_EQ(ancestor->GetLookup(), initialLookup);
+
+  // destroying the container releases layouts of items that outlive it
   ancestor.reset();
+  EXPECT_EQ(item->GetLayout(), nullptr);
+  EXPECT_EQ(item->GetFocusedLayout(), nullptr);
   item.reset();
 }
 
