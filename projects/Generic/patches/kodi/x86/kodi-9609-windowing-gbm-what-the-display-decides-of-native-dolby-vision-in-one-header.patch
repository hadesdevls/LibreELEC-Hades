index 284029d..f6121fe 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1222,17 +1222,22 @@ bool RefreshRateFixed()
                          ADJUST_REFRESHRATE_OFF;
 }
 
-// What native Dolby Vision output depends on in the display information.
-auto DVCapabilities(const KODI::UTILS::CDisplayInfo* info)
-{
-  return std::make_tuple(info != nullptr, info && info->SupportsDolbyVision(),
-                         info && info->SupportsStandardDolbyVision(),
-                         info ? info->StandardDolbyVisionVersion() : 0u,
-                         info && info->SupportsStandardDolbyVision2160p60(),
-                         info && info->SupportsRGBQuantizationSelection(),
-                         // Hades: Dolby Vision Low-Latency, and the display it maps to
-                         info && info->SupportsLowLatencyDolbyVisionOnly(),
-                         info ? info->GetDolbyVideoBlock().targetMaxPq : 0u);
+// Hades: the reason, for the log, of what of the display keeps native output away from it
+// (DV_DISPLAY::Reason())
+const char* DVDisplayReasonText(std::string_view code)
+{
+  if (code == "invalid")
+    return "the display's Dolby Vision block is in an EDID block that is not valid, or there are "
+           "several (see [display-info] above)";
+  if (code == "legacy")
+    return "the display advertises Dolby Vision only with the older signalling, the HDMI 1.4b "
+           "vendor InfoFrame (a version 0 block, the 15-byte version 1 block, or the 12-byte one "
+           "with the low-latency field 0), which native output does not send";
+  // Hades: Low-Latency would be there, and the user has not turned it on
+  if (code == "lloff")
+    return "the display offers Dolby Vision Low-Latency only (a TV input in its game mode), which "
+           "is turned off in the settings (System > Display)";
+  return "the display does not advertise Dolby Vision Standard";
 }
 } // namespace
 
@@ -1247,7 +1252,8 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   // (Hades: the code of the failure, where the driver said why it refused)
   std::string failedCode;
   // Hades: Dolby Vision Low-Latency, where the display offers no other and it is turned on
-  const bool lowLatency = NativeDVLowLatency();
+  const DV_DISPLAY::Signal signal = NativeDVSignal();
+  const bool lowLatency = signal == DV_DISPLAY::Signal::LOW_LATENCY;
   if (DVTurnedOff())
   {
     // Hades: the user's own choice, before anything of the display
@@ -1267,31 +1273,11 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
     code = "edid";
     reason = "the display's EDID could not be read when this video started";
   }
-  else if (info && info->DolbyVisionBlockInvalid())
+  // Hades: what of the display keeps it away (invalid, legacy, lloff, display)
+  else if (const char* displayCode = DV_DISPLAY::Reason(info.get(), signal); *displayCode)
   {
-    code = "invalid";
-    reason = "the display's Dolby Vision block is in an EDID block that is not valid, or there are "
-             "several (see [display-info] above)";
-  }
-  else if (info && info->SupportsLegacyDolbyVisionOnly())
-  {
-    code = "legacy";
-    reason = "the display advertises Dolby Vision only with the older signalling, the HDMI 1.4b "
-             "vendor InfoFrame (a version 0 block, the 15-byte version 1 block, or the 12-byte one "
-             "with the low-latency field 0), which native output does not send";
-  }
-  else if (info && !info->SupportsStandardDolbyVision() &&
-           info->SupportsLowLatencyDolbyVisionOnly() && !lowLatency)
-  {
-    // Hades: Low-Latency would be there, and the user has not turned it on
-    code = "lloff";
-    reason = "the display offers Dolby Vision Low-Latency only (a TV input in its game mode), which "
-             "is turned off in the settings (System > Display)";
-  }
-  else if (!info || !(info->SupportsStandardDolbyVision() || lowLatency))
-  {
-    code = "display";
-    reason = "the display does not advertise Dolby Vision Standard";
+    code = displayCode;
+    reason = DVDisplayReasonText(displayCode);
   }
   else if (!std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
   {
@@ -1339,15 +1325,14 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
   // default range of its CTA modes, and CTA-861 lets a source say so only to a display with QS.
   // amdgpu and i915 refuse the tunnel there too since Linux 7.3 (drm_dvbridge_sink_takes() of
   // drm_dvbridge.h); NVIDIA's driver sends the default range to such a display.)
-  else if (!lowLatency && !info->SupportsRGBQuantizationSelection())
+  else if (DV_DISPLAY::NeedsRangeSelection(signal) && !info->SupportsRGBQuantizationSelection())
   {
     code = "range";
     reason = "the display cannot select the RGB range (no VCDB with QS), which the full range RGB "
              "of the tunnel needs";
   }
-  else if (!(lowLatency ? info->SupportsLowLatencyDolbyVision2160p60()
-                          : info->SupportsStandardDolbyVision2160p60()) &&
-           mode && DVBRIDGE::TransportRateNeeds2160p60(ModeRate(*mode)) &&
+  else if (!DV_DISPLAY::Takes2160p60(*info, signal) && mode &&
+           DVBRIDGE::TransportRateNeeds2160p60(ModeRate(*mode)) &&
            (!anyMode || RefreshRateFixed()))
   {
     // Also when the mode is another one for this reason (no 3840x2160 mode is chosen above 30 Hz
@@ -1467,9 +1452,13 @@ bool CWinSystemGbm::DVLowLatencyOn() const
 
 bool CWinSystemGbm::NativeDVLowLatency() const
 {
-  const auto info = DVDisplayInfo();
-  return info && !info->SupportsStandardDolbyVision() && info->SupportsLowLatencyDolbyVisionOnly() &&
-         DVLowLatencyOn();
+  return NativeDVSignal() == DV_DISPLAY::Signal::LOW_LATENCY;
+}
+
+DV_DISPLAY::Signal CWinSystemGbm::NativeDVSignal() const
+{
+  // (the setting is read only where the display makes it matter)
+  return DV_DISPLAY::SignalOf(DVDisplayInfo().get(), [this] { return DVLowLatencyOn(); });
 }
 
 KODI::UTILS::DolbyVideoBlock CWinSystemGbm::DVDolbyVideoBlock() const
@@ -1505,7 +1494,7 @@ std::string CWinSystemGbm::DisplayDolbyVisionSupport() const
 unsigned int CWinSystemGbm::DisplayDolbyVisionDmVersion() const
 {
   const auto info = DVDisplayInfo();
-  return info ? info->StandardDolbyVisionDmVersion() : 0;
+  return info ? DV_DISPLAY::DmVersion(*info, NativeDVSignal()) : 0;
 }
 
 std::string CWinSystemGbm::DisplayModel() const
@@ -1524,10 +1513,8 @@ std::string CWinSystemGbm::DisplayModel() const
 bool CWinSystemGbm::NativeDVTakesRate(double refresh) const
 {
   const auto info = DVDisplayInfo();
-  // (Hades: of the Low-Latency mode where that is what native output sends)
-  return !info ||
-         (NativeDVLowLatency() ? info->SupportsLowLatencyDolbyVision2160p60()
-                               : info->SupportsStandardDolbyVision2160p60()) ||
+  // (Hades: of the signal that native output sends: the Low-Latency mode where it sends that)
+  return !info || DV_DISPLAY::Takes2160p60(*info, NativeDVSignal()) ||
          !DVBRIDGE::TransportRateNeeds2160p60(refresh);
 }
 
@@ -1756,7 +1743,8 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
               m_stereoDisplay ? "says" : "does not say");
   // Only a change of what native output depends on counts (not, for example, the audio formats of
   // a sound bar behind the TV); it also allows the Low-Latency notification again.
-  const bool dvChanged = DVCapabilities(info.get()) != DVCapabilities(changed.get());
+  const bool dvChanged =
+      DV_DISPLAY::Capabilities(info.get()) != DV_DISPLAY::Capabilities(changed.get());
   if (dvChanged)
     m_dvDisplayGeneration++;
   if (changed->SupportsDolbyVision())
