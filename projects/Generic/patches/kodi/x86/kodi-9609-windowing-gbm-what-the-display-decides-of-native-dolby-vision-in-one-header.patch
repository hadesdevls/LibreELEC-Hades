+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*
+ * Hades: what the display information decides of native Dolby Vision output: which signal it sends
+ * the display, what of the display keeps it away, and what the signal asks of the output (the RGB
+ * range, 2160p above 30 Hz) and of the metadata (the display management version). One place for
+ * what CWinSystemGbm asks of the display information for it, so that a host test can ask it of the
+ * EDIDs of many displays. Pure: the settings come in as functions, asked only where the display
+ * makes them matter (as before, so that what is read of them is read at the same moments).
+ */
+namespace DV_DISPLAY
+{
+//! How native output signals Dolby Vision to the display
+enum class Signal
+{
+  //! the tunnel of the Standard mode (TV-led), told by the Dolby vendor InfoFrame
+  STANDARD,
+  //! Dolby Vision Low-Latency (player-led), where the display offers no other and it is turned
+  //! on in the settings (videoscreen.hadesdvlowlatency)
+  LOW_LATENCY,
+};
+
+/*!
+ * \brief How native output signals Dolby Vision to a display
+ * \param info its display information (nullptr: none)
+ * \param lowLatencyOn whether Dolby Vision Low-Latency is turned on, as read for the video: asked
+ *        only of a display that offers Low-Latency only
+ */
+template<typename LowLatencyOn>
+Signal SignalOf(const UTILS::CDisplayInfo* info, LowLatencyOn lowLatencyOn)
+{
+  if (info && !info->SupportsStandardDolbyVision() && info->SupportsLowLatencyDolbyVisionOnly() &&
+      lowLatencyOn())
+    return Signal::LOW_LATENCY;
+  return Signal::STANDARD;
+}
+
+/*!
+ * \brief What of the display keeps native output away from it, as the reason code of the player
+ *        information: invalid (a Dolby Vision block that is not read: in an EDID block that is
+ *        not valid, or several), legacy (Dolby Vision with the older signalling only), lloff
+ *        (Low-Latency only, turned off in the settings), display (no Dolby Vision Standard, or no
+ *        display information); "" where the display takes the signal. What of the output stands
+ *        in the way is asked after this.
+ */
+inline const char* Reason(const UTILS::CDisplayInfo* info, Signal signal)
+{
+  if (info && info->DolbyVisionBlockInvalid())
+    return "invalid";
+  if (info && info->SupportsLegacyDolbyVisionOnly())
+    return "legacy";
+  // (Low-Latency would be there, and the user has not turned it on)
+  if (info && !info->SupportsStandardDolbyVision() && info->SupportsLowLatencyDolbyVisionOnly() &&
+      signal != Signal::LOW_LATENCY)
+    return "lloff";
+  if (!info || !(info->SupportsStandardDolbyVision() || signal == Signal::LOW_LATENCY))
+    return "display";
+  return "";
+}
+
+//! The AVI InfoFrame of the signal says full range RGB, which needs the display to let the source
+//! select the RGB range (QS): every signal but Low-Latency, whose AVI InfoFrame says YCbCr in the
+//! limited range
+constexpr bool NeedsRangeSelection(Signal signal)
+{
+  return signal != Signal::LOW_LATENCY;
+}
+
+//! The display takes the signal at 2160p above 30 Hz
+inline bool Takes2160p60(const UTILS::CDisplayInfo& info, Signal signal)
+{
+  return signal == Signal::LOW_LATENCY ? info.SupportsLowLatencyDolbyVision2160p60()
+                                       : info.SupportsStandardDolbyVision2160p60();
+}
+
+//! The version of Dolby Vision display management that the display reads with the signal (2 and
+//! up; 0 not known): which content mapping its metadata carry
+inline unsigned int DmVersion(const UTILS::CDisplayInfo& info, Signal /*signal*/)
+{
+  return info.StandardDolbyVisionDmVersion();
+}
+
+//! What native output depends on in the display information (nullptr: none): when it changes, the
+//! display counts as another one (CWinSystemGbm::CheckDisplayChange())
+inline auto Capabilities(const UTILS::CDisplayInfo* info)
+{
+  return std::make_tuple(info != nullptr, info && info->SupportsDolbyVision(),
+                         info && info->SupportsStandardDolbyVision(),
+                         info ? info->StandardDolbyVisionVersion() : 0u,
+                         info && info->SupportsStandardDolbyVision2160p60(),
+                         info && info->SupportsRGBQuantizationSelection(),
+                         // Hades: Dolby Vision Low-Latency, and the display it maps to
+                         info && info->SupportsLowLatencyDolbyVisionOnly(),
+                         info ? info->GetDolbyVideoBlock().targetMaxPq : 0u);
+}
+} // namespace DV_DISPLAY
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
