 xbmc/windowing/gbm/DVDisplaySignal.h | 119 +++++++++++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.cpp  |  86 +++++++++----------
 xbmc/windowing/gbm/WinSystemGbm.h    |   4 +
 4 files changed, 161 insertions(+), 49 deletions(-)
 create mode 100644 xbmc/windowing/gbm/DVDisplaySignal.h

