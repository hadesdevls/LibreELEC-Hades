 /* Pack transport bytes with isolated GL state; never apply ordinary RGB color processing. */
 #include "dvbridge_gl_pack.h"
 #include <GLES3/gl31.h>
@@ -534,43 +543,105 @@ restore:
     return ok && glGetError() == GL_NO_ERROR;
 }
 
-/* Hades: the fragment shader of dvbridge_gl_eos_draw(): pack_gles300.frag with the codes of black
- * in place of a picture */
+/* Hades: the fragment shader of dvbridge_gl_eos_draw(): a frame of black that carries the metadata
+ * packets (ETSI GS CCM 001 V1.1.1, clause 6.4), as every form of the transport packs them */
 static const char EOS_FRAGMENT[] =
     "#version 300 es\n"
+    /* EOS: a frame of black that carries HDR DM metadata transmission packets */
+    /* (ETSI GS CCM 001 V1.1.1, clause 6.4), sent as 12-bit YCbCr 4:2:2 through an */
+    /* RGB888 framebuffer. The functions and the end of main() are the same text as */
+    /* CCM_HELPERS and CCM_END of dvbridge_source.c. */
     "precision highp float;\n"
     "precision highp int;\n"
-    "uniform uvec4 metadata_words[128];\n"
-    "uniform uint packet_count;\n"
-    "uniform uint flip_y;\n"
-    "uniform uvec3 black;\n"
+    "uniform uvec4 metadata_words[128];\n" /* packet P is words P*32 .. P*32+31; word w is metadata_words[w / 4][w % 4] */
+    "uniform uint packet_count;\n" /* how many packets (1 .. 16) */
+    "uniform uint flip_y;\n" /* non-zero: framebuffer row r is raster row 2159 - r */
+    "uniform uvec3 black;\n" /* codes of black: x luma, y Cb, z Cr */
     "out vec4 color;\n"
-    "uint parity(uint value)\n"
+    /* (CCM_HELPERS) */
+    /* Parity of v: 1 when an odd number of its bits are set (the XOR of all bits). */
+    "highp uint ccm_parity(highp uint v)\n"
     "{\n"
-    "    value ^= value >> 16u;\n"
-    "    value ^= value >> 8u;\n"
-    "    value ^= value >> 4u;\n"
-    "    value ^= value >> 2u;\n"
-    "    value ^= value >> 1u;\n"
-    "    return value & 1u;\n"
+    "    v ^= v >> 16u;\n"
+    "    v ^= v >> 8u;\n"
+    "    v ^= v >> 4u;\n"
+    "    v ^= v >> 2u;\n"
+    "    v ^= v >> 1u;\n"
+    "    return v & 1u;\n"
     "}\n"
+    /* Bit b (0 .. 1023) of packet number packet (0-based), in transmission order. */
+    /* Clause 6.4.1: the first byte goes first and each byte goes most significant */
+    /* bit first, so bit b is bit[m] of byte[n] with b = n*8 + (7 - m). */
+    "highp uint ccm_packet_bit(highp uint packet, highp uint b)\n"
+    "{\n"
+    "    highp uint n = b / 8u;\n" /* byte of the packet, 0 .. 127 */
+    "    highp uint m = 7u - (b % 8u);\n" /* bit of that byte, 7 = most significant */
+    /* Packet P is words P*32 .. P*32+31; byte n is in word n/4, and the first */
+    /* byte of a word is in its bits 31..24, the next in 23..16, and so on. */
+    "    highp uint w = packet * 32u + n / 4u;\n"
+    "    highp uint word = metadata_words[int(w / 4u)][int(w % 4u)];\n"
+    "    highp uint byte_shift = 24u - 8u * (n % 4u);\n"
+    "    return (word >> (byte_shift + m)) & 1u;\n"
+    "}\n"
+    /* The chroma code c of pixel i (raster order, i = 3840*row + column) with the */
+    /* metadata bit that clause 6.4 places on that pixel; y is the luma code of the */
+    /* same pixel. A pixel that carries no metadata gets c back unchanged. */
+    "highp uint ccm_embed_metadata(highp uint i, highp uint y, highp uint c)\n"
+    "{\n"
+    /* metadata_words holds at most 16 packets of 32 words. */
+    "    highp uint count = min(packet_count, 16u);\n"
+    /* Clauses 6.4.3 and 6.4.4: packet P takes the 3072 pixels starting at */
+    /* P*3072, three consecutive copies of its 1024 bits. Pixels after the */
+    /* last packet carry nothing. */
+    "    if (i >= count * 3072u)\n"
+    "        return c;\n"
+    "    highp uint packet = i / 3072u;\n"
+    /* Position inside the copy: copies 1, 2 and 3 start at pixels 0, 1024 and */
+    /* 2048 of the packet's run and carry the same bits (clause 6.4.3). */
+    "    highp uint b = (i % 3072u) % 1024u;\n"
+    "    highp uint md_bit = ccm_packet_bit(packet, b);\n"
+    /* Clause 6.4.2: the bit is scrambled with the parity of bits 11..1 of this */
+    /* chroma sample combined (XOR) with the parity of bits 11..0 of the luma */
+    /* sample that follows it in the 4:2:2 stream (table 14: Cb0 Y0 Cr0 Y1 ...), */
+    /* which is the luma of the same pixel. */
+    "    highp uint scrambled = md_bit ^ ccm_parity((c >> 1u) & 0x7FFu) ^ ccm_parity(y & 0xFFFu);\n"
+    /* Clause 6.4.1: the result is the least significant bit of the chroma code. */
+    "    return (c & ~1u) | scrambled;\n"
+    "}\n"
+    /* The framebuffer value of a pixel with 12-bit codes y (luma) and c (chroma): */
+    /* HDMI "YCbCr 4:2:2, 12 bits" in RGB888, TMDS channels 0, 1, 2 being the blue, */
+    /* green and red components. */
+    "highp vec4 ccm_rgb888(highp uint y, highp uint c)\n"
+    "{\n"
+    "    highp uint r = (c >> 4u) & 0xFFu;\n" /* channel 2: chroma bits 11..4 */
+    "    highp uint g = (y >> 4u) & 0xFFu;\n" /* channel 1: luma bits 11..4 */
+    "    highp uint b = ((c & 0xFu) << 4u) | (y & 0xFu);\n" /* channel 0: chroma bits 3..0, luma bits 3..0 */
+    /* Normalized RGBA8: each 8-bit value v is written as v / 255.0; alpha 255. */
+    "    return vec4(float(r) / 255.0, float(g) / 255.0, float(b) / 255.0, 255.0 / 255.0);\n"
+    "}\n"
+    /* main() */
     "void main()\n"
     "{\n"
-    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
-    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    /* The fragment's pixel: (column, framebuffer row). */
+    "    ivec2 fb = ivec2(gl_FragCoord.xy);\n"
+    /* Raster position, row 0 at the top: with flip_y the framebuffer's rows */
+    /* are the raster's upside down (framebuffer row r is raster row 2159 - r). */
+    "    ivec2 p = ivec2(fb.x, (flip_y != 0u) ? (2159 - fb.y) : fb.y);\n"
+    /* Black: luma black.x; chroma Cb (black.y) on even columns, Cr (black.z) */
+    /* on odd ones (clause 6.4.1: Cb for even pixels, Cr for odd pixels). */
     "    uint y = black.x;\n"
-    "    uint c = (p.x & 1) == 0 ? black.y : black.z;\n"
-    "    uint index = uint(p.y * 3840 + p.x);\n"
-    "    uint packet = index / 3072u;\n"
-    "    if (packet < packet_count)\n"
-    "    {\n"
-    "        uint bit = index % 1024u;\n"
-    "        uint word = packet * 32u + bit / 32u;\n"
-    "        uint value = (metadata_words[word / 4u][int(word % 4u)] >> (31u - bit % 32u)) & 1u;\n"
-    "        c = (c & 4094u) | (value ^ parity(c >> 1u) ^ parity(y));\n"
+    "    uint c = ((p.x & 1) == 0) ? black.y : black.z;\n"
+    /* (CCM_END) */
+    /* END: the metadata of ETSI GS CCM 001 V1.1.1 clause 6.4, then the pixel bytes. */
+    /* Clause 6.4.1: raster-order index of the pixel, i = W*row + column with */
+    /* W = 3840 (row 0 at the top). Only a pixel inside the picture's columns */
+    /* and rows is indexed; every pixel of a 3840x2160 target is. */
+    "    if (p.x >= 0 && p.x < 3840 && p.y >= 0) {\n"
+    "        highp uint ccm_row = uint(p.y);\n"
+    "        highp uint ccm_i = ccm_row * 3840u + uint(p.x);\n"
+    "        c = ccm_embed_metadata(ccm_i, y, c);\n"
     "    }\n"
-    "    float b = float((y & 15u) | ((c & 15u) << 4u));\n"
-    "    color = vec4(float(c >> 4u), float(y >> 4u), b, 255.0) / 255.0;\n"
+    "    color = ccm_rgb888(y, c);\n"
     "}\n";
 
 struct dvbridge_gl_eos {
