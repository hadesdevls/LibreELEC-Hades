 /* Hades: the end of a Dolby Vision signal as ETSI GS CCM 001 V1.1.1 lets a source mark it (clause
@@ -25,15 +25,51 @@
 #include <stddef.h>
 #include <stdint.h>
 
+/*
+ * CRC32 of an HDR DM metadata transmission packet.
+ *
+ * ETSI GS CCM 001 V1.1.1, clause 6.3.4: the tail of each 128-byte packet holds
+ * CRC32[31:0], high byte first (tail bytes 0..3 = CRC32[31:24] .. CRC32[7:0]),
+ * computed over the first 992 bits (124 bytes) of the packet with the model of
+ * annex A of ISO/IEC 13818-1 (the CRC_32 of MPEG-2 systems):
+ *   - generator polynomial x^32 + x^26 + x^23 + x^22 + x^16 + x^12 + x^11 +
+ *     x^10 + x^8 + x^7 + x^5 + x^4 + x^2 + x + 1, i.e. 0x04C11DB7 without the
+ *     implicit x^32 term;
+ *   - every cell of the shift register set to 1 before the first bit;
+ *   - bits shifted in most significant bit of each byte first (the same bit
+ *     order clause 6.4.1 uses on the wire);
+ *   - neither input nor output reflected, no final XOR.
+ *
+ * Over a packet's first 124 bytes this returns the value to store in its tail.
+ * Over all 128 bytes of a packet with a correct tail it returns 0, which is the
+ * test a sink applies in clause 6.4.3.
+ * Check value: the 9 ASCII bytes "123456789" give 0x0376E6E7.
+ */
+
 static inline uint32_t dvbridge_eos_crc(const uint8_t *p, size_t n)
 {
-    uint32_t c = 0xffffffff;
-    for (size_t j = 0; j < n; j++) {
-        c ^= (uint32_t)p[j] << 24;
-        for (int i = 0; i < 8; i++)
-            c = (c << 1) ^ ((c >> 31) ? 0x04c11db7u : 0);
+    const uint32_t poly = 0x04C11DB7u; /* clause 6.3.4 polynomial, x^32 implicit */
+    uint32_t crc = 0xFFFFFFFFu;        /* annex A: register preset to all ones */
+
+    for (size_t k = 0; k < n; k++) {
+        /*
+         * Feeding the 8 bits of a byte one at a time, most significant first,
+         * is the same as adding the whole byte into the top 8 bits of the
+         * register and then shifting 8 times (the CRC is linear over GF(2)).
+         */
+        crc ^= (uint32_t)p[k] << 24;
+        for (int bit = 0; bit < 8; bit++) {
+            /* One shift of the register: when the bit leaving at x^31 is 1,
+             * subtract (XOR) the generator polynomial. */
+            if (crc & 0x80000000u)
+                crc = (crc << 1) ^ poly;
+            else
+                crc <<= 1;
+        }
     }
-    return c;
+
+    /* No output reflection and no final XOR: the register is the CRC. */
+    return crc;
 }
 
 /* False, with nothing written, where the packets are not those of a frame: none or more than 16,
diff --git a/tools/dvbridge/dvbridge_gl_pack.c b/tools/dvbridge/dvbridge_gl_pack.c
index f5fc29b..bd0813c 100644
--- a/tools/dvbridge/dvbridge_gl_pack.c
+++ b/tools/dvbridge/dvbridge_gl_pack.c
@@ -1,4 +1,13 @@
-/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ *  From the Dolby Vision module (dvbridge) of CroqueMr's Dolby Vision fork of LibreELEC
+ *  (kodi-9990-native-dv), whose author offers his original contributions under GPL-2.0-or-later
+ *  (CB1/docs/GPL2-MIGRATION.md and ADAPTER-MIGRATION.md of github.com/CroqueMr/libreelec-x86-DV).
