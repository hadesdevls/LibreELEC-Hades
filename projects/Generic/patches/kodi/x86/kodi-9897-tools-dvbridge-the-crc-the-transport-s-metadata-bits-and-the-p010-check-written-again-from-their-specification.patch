+ */
 /* Import validated VAAPI DMA-BUF planes without copying decoded video to the CPU. */
 #include "dvbridge_dmabuf.h"
 #include "dvbridge_fel.h"
@@ -58,35 +67,102 @@ static void describe_layout(const AVDRMFrameDescriptor *desc)
 #define DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH 4096
 #define DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT 2304
 
+/*
+ * Check of a P010 surface that a VAAPI decoder exported as DRM PRIME, before
+ * it is imported.
+ *
+ * P010 (drm_fourcc.h): a plane of 16-bit luma samples and an interleaved CbCr
+ * plane subsampled 2x2, 16 bits per component. Exported here as two layers of
+ * one plane each:
+ *   layer 0, luma:   DRM_FORMAT_R16    ([15:0] R, one 16-bit component, 2 bytes);
+ *   layer 1, chroma: DRM_FORMAT_GR1616 or DRM_FORMAT_RG1616 ([31:0] two 16-bit
+ *                    components, 4 bytes); drivers differ in the component
+ *                    order they declare, and both are accepted.
+ * Field names are those of AVDRMFrameDescriptor (libavutil/hwcontext_drm.h).
+ *
+ * Returns true only when the descriptor has that shape and every plane the two
+ * layers use lies inside its object. Reads the descriptor only: no side
+ * effects, no logging.
+ */
+
 bool dvbridge_dmabuf_validate_p010(const AVDRMFrameDescriptor *desc, int width, int height)
 {
-    if (!desc || width < 1 || width > DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH || height < 1 ||
-        height > DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT ||
-        desc->nb_layers != 2 || desc->nb_objects < 1 || desc->nb_objects > AV_DRM_MAX_PLANES)
+    /* 1. A descriptor, and a size in luma samples within the largest surface (4096 x 2304). */
+    if (desc == NULL)
         return false;
-    for (int i = 0; i < 2; ++i) {
-        const AVDRMLayerDescriptor *layer = &desc->layers[i];
+    if (width < 1 || width > DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH || height < 1 || height > DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT)
+        return false;
+
+    /* 2. Exactly two layers, and between 1 and AV_DRM_MAX_PLANES objects. */
+    if (desc->nb_layers != 2)
+        return false;
+    if (desc->nb_objects < 1 || desc->nb_objects > AV_DRM_MAX_PLANES)
+        return false;
+
+    /* Layer 0 (luma) is checked fully, then layer 1 (chroma). */
+    for (int l = 0; l < 2; l++) {
+        const AVDRMLayerDescriptor *layer = &desc->layers[l];
+
+        /* 3. One plane, the expected format, and an object index in range. */
+        if (layer->nb_planes != 1)
+            return false;
+        if (l == 0) {
+            if (layer->format != DRM_FORMAT_R16)
+                return false;
+        } else {
+            if (layer->format != DRM_FORMAT_GR1616 &&
+                layer->format != DRM_FORMAT_RG1616)
+                return false;
+        }
+
         const AVDRMPlaneDescriptor *plane = &layer->planes[0];
-        /* The interleaved CbCr plane is GR1616 from Intel's driver and RG1616 from
-         * nvidia-vaapi-driver. The import passes the declared format to EGL unchanged, as
-         * Kodi's own VAAPI importer does for the base layer, so both layers are sampled
-         * with the same component order on each driver. */
-        const bool format = i ? layer->format == DRM_FORMAT_GR1616 || layer->format == DRM_FORMAT_RG1616
-                              : layer->format == DRM_FORMAT_R16;
-        if (layer->nb_planes != 1 || !format ||
-            plane->object_index < 0 || plane->object_index >= desc->nb_objects)
+        if (plane->object_index < 0 || plane->object_index >= desc->nb_objects)
             return false;
+
         const AVDRMObjectDescriptor *object = &desc->objects[plane->object_index];
-        uint64_t row_bytes = i ? ((width + 1) / 2) * 4 : width * 2;
-        uint64_t rows = i ? (height + 1) / 2 : height;
-        if (object->fd < 0 || plane->offset < 0 || plane->offset > INT_MAX ||
-            plane->pitch <= 0 || plane->pitch > INT_MAX || (uint64_t)plane->pitch < row_bytes ||
-            (uint64_t)plane->offset >= object->size)
+
+        /*
+         * The plane's row in bytes and its number of rows, in 64-bit unsigned
+         * arithmetic:
+         *   luma:   width samples of R16 (2 bytes each), height rows;
+         *   chroma: ceil(width / 2) samples of a two-component 16-bit format
+         *           (4 bytes each), ceil(height / 2) rows (2x2 subsampling).
+         */
+        const uint64_t w = (uint64_t)width;
+        const uint64_t h = (uint64_t)height;
+        const uint64_t row_bytes = (l == 0) ? w * 2u : ((w + 1u) / 2u) * 4u;
+        const uint64_t rows = (l == 0) ? h : (h + 1u) / 2u;
+
+        /* 4. The object and where the plane sits in it. */
+        if (object->fd < 0)
             return false;
-        if (object->format_modifier == DRM_FORMAT_MOD_LINEAR &&
-            (uint64_t)plane->offset + (rows - 1) * plane->pitch + row_bytes > object->size)
+        if (plane->offset < 0 || plane->offset > INT_MAX)
             return false;
+        if (plane->pitch <= 0 || plane->pitch > INT_MAX)
+            return false;
+
+        /* Both are now known to be within 0..INT_MAX (pitch at least 1). */
+        const uint64_t offset = (uint64_t)plane->offset;
+        const uint64_t pitch = (uint64_t)plane->pitch;
+        const uint64_t size = (uint64_t)object->size;
+
+        if (pitch < row_bytes)
+            return false;
+        if (offset >= size)
+            return false;
+
+        /*
+         * Only a linear layout tells its extent this way: the last row starts
+         * (rows - 1) pitches after the offset and is row_bytes long. A tiled
+         * layout is not checked. No overflow: offset <= INT_MAX, rows - 1 <=
+         * 2303, pitch <= INT_MAX and row_bytes <= 8192 keep the sum below 2^43.
+         */
+        if (object->format_modifier == DRM_FORMAT_MOD_LINEAR) {
+            if (offset + (rows - 1u) * pitch + row_bytes > size)
+                return false;
+        }
     }
+
     return true;
 }
 
