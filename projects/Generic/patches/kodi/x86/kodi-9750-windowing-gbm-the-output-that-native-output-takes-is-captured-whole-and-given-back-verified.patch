diff --git a/xbmc/windowing/gbm/drm/LibdrmKms.h b/xbmc/windowing/gbm/drm/LibdrmKms.h
new file mode 100644
index 0000000..22b4a98
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/LibdrmKms.h
@@ -0,0 +1,168 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "OutputState.h"
+
+#include <cerrno>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace OUTPUT_STATE
+{
+
+inline uint32_t ObjectTypeOf(Role role)
+{
+  switch (role)
+  {
+    case Role::CONNECTOR:
+      return DRM_MODE_OBJECT_CONNECTOR;
+    case Role::CRTC:
+      return DRM_MODE_OBJECT_CRTC;
+    default:
+      return DRM_MODE_OBJECT_PLANE;
+  }
+}
+
+//! The kernel, by libdrm
+class CLibdrmKms : public IKms
+{
+public:
+  explicit CLibdrmKms(int fd) : m_fd(fd) {}
+
+  std::optional<std::map<uint32_t, uint64_t>> Values(Role role, uint32_t object) override
+  {
+    if (m_fd < 0)
+      return std::nullopt;
+    drmModeObjectProperties* props = drmModeObjectGetProperties(m_fd, object, ObjectTypeOf(role));
+    if (!props)
+      return std::nullopt;
+    std::map<uint32_t, uint64_t> values;
+    for (uint32_t i = 0; i < props->count_props; ++i)
+      values[props->props[i]] = props->prop_values[i];
+    drmModeFreeObjectProperties(props);
+    return values;
+  }
+
+  std::optional<std::vector<uint8_t>> BlobData(uint32_t blob) override
+  {
+    if (m_fd < 0 || blob == 0)
+      return std::nullopt;
+    drmModePropertyBlobRes* res = drmModeGetPropertyBlob(m_fd, blob);
+    if (!res)
+      return std::nullopt;
+    const auto* bytes = static_cast<const uint8_t*>(res->data);
+    std::vector<uint8_t> data(bytes, bytes + res->length);
+    drmModeFreePropertyBlob(res);
+    return data;
+  }
+
+  uint32_t CreateBlob(const std::vector<uint8_t>& data) override
+  {
+    uint32_t id = 0;
+    if (m_fd < 0 || data.empty() || drmModeCreatePropertyBlob(m_fd, data.data(), data.size(), &id))
+      return 0;
+    return id;
+  }
+
+  void DestroyBlob(uint32_t blob) override
+  {
+    if (m_fd >= 0 && blob != 0)
+      drmModeDestroyPropertyBlob(m_fd, blob);
+  }
+
+  int Commit(const std::vector<Change>& changes, bool testOnly) override
+  {
+    if (m_fd < 0)
+      return EBADF;
+    drmModeAtomicReq* request = drmModeAtomicAlloc();
+    if (!request)
+      return ENOMEM;
+    for (const auto& change : changes)
+      if (drmModeAtomicAddProperty(request, change.object, change.property, change.value) < 0)
+      {
+        drmModeAtomicFree(request);
+        return EINVAL;
+      }
+    const int flags = DRM_MODE_ATOMIC_ALLOW_MODESET | (testOnly ? DRM_MODE_ATOMIC_TEST_ONLY : 0);
+    const int result = drmModeAtomicCommit(m_fd, request, flags, nullptr);
+    const int error = errno;
+    drmModeAtomicFree(request);
+    return result < 0 ? (error ? error : EINVAL) : 0;
+  }
+
+  //! The definition of every property of an object
+  std::optional<ObjectInfo> Describe(Role role, uint32_t object)
+  {
+    if (m_fd < 0)
+      return std::nullopt;
+    drmModeObjectProperties* props = drmModeObjectGetProperties(m_fd, object, ObjectTypeOf(role));
+    if (!props)
+      return std::nullopt;
+    ObjectInfo info;
+    info.role = role;
+    info.id = object;
+    for (uint32_t i = 0; i < props->count_props; ++i)
+    {
+      drmModePropertyRes* prop = drmModeGetProperty(m_fd, props->props[i]);
+      if (!prop)
+        continue;
+      PropertyInfo out;
+      out.id = prop->prop_id;
+      out.name = prop->name;
+      out.immutable = (prop->flags & DRM_MODE_PROP_IMMUTABLE) != 0;
+      if (drm_property_type_is(prop, DRM_MODE_PROP_BLOB))
+        out.kind = Kind::BLOB;
+      else if (drm_property_type_is(prop, DRM_MODE_PROP_ENUM))
+        out.kind = Kind::ENUM;
+      else if (drm_property_type_is(prop, DRM_MODE_PROP_BITMASK))
+        out.kind = Kind::BITMASK;
+      else if (drm_property_type_is(prop, DRM_MODE_PROP_OBJECT))
+        out.kind = Kind::OBJECT;
+      else if (drm_property_type_is(prop, DRM_MODE_PROP_SIGNED_RANGE) && prop->count_values == 2)
+      {
+        out.kind = Kind::SIGNED_RANGE;
+        out.smin = static_cast<int64_t>(prop->values[0]);
+        out.smax = static_cast<int64_t>(prop->values[1]);
+      }
+      else if (drm_property_type_is(prop, DRM_MODE_PROP_RANGE) && prop->count_values == 2)
+      {
+        out.kind = Kind::RANGE;
+        out.min = prop->values[0];
+        out.max = prop->values[1];
+      }
+      if (out.kind == Kind::ENUM || out.kind == Kind::BITMASK)
+        for (int j = 0; j < prop->count_enums; ++j)
+          out.enums.emplace_back(prop->enums[j].name, prop->enums[j].value);
+      drmModeFreeProperty(prop);
+      info.properties.push_back(std::move(out));
+    }
+    drmModeFreeObjectProperties(props);
+    return info;
+  }
+
+private:
+  int m_fd;
+};
+
+} // namespace OUTPUT_STATE
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
