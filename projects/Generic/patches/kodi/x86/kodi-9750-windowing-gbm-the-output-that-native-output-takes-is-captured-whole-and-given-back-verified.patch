new file mode 100644
index 0000000..1b39bb3
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/OutputHandover.h
@@ -0,0 +1,179 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "DRMObject.h"
+#include "DVConverter.h"
+#include "DVHdmi14b.h"
+#include "OutputState.h"
+
+#include <array>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM
+{
+class CDRMAtomic;
+class CDRMConnector;
+
+/*!
+ * \brief Hades: the output that native Dolby Vision (or HDR over the tunnel) takes, and gives back
+ *
+ * Capture() reads the state of the output (OUTPUT_STATE::CSnapshot: every property of the
+ * connector, the CRTC and the plane that is not read-only, and a blob by its bytes) and fixes what
+ * the transport sets. Stage() puts the transport, or what gives the output back, into the request
+ * of the commit that the window system makes; the end is verified by reading the output back
+ * (Finish()). The transport that is on the output is kept in a file for a Kodi that ends in the
+ * middle of it (ClearLeftover()).
+ */
+class COutputHandover
+{
+public:
+  //! Dolby Vision output backends, told apart by the connector's DRM properties.
+  enum class Driver
+  {
+    NONE,
+    //! A kernel driver with the dvbridge connector property DVBRIDGE_DV_STANDARD_LAB (i915/xe and
+    //! amdgpu with the Hades patches): the kernel builds the Dolby VSIF and the AVI InfoFrame and
+    //! rejects any scanout that is not bit exact.
+    KMS_PROPERTIES,
+    //! nvidia-drm 615.71.09 or later with the "max bpc" property, on HDMI: user space supplies
+    //! the Dolby VSIF through NV_HDMI_VSIF_METADATA, and the scanout is kept bit exact by
+    //! neutral colour settings, 8 bpc and no dithering.
+    NVIDIA_DRM,
+  };
+  static Driver DriverOf(CDRMConnector& connector);
+  //! The setting of Dolby Vision through the converter of the board (videoscreen.hadesdvconverter),
+  //! as the window system latched it when the video started: DriverOf() follows it
+  static void SetConverterUse(DV_CONVERTER::Use use);
+  //! What DV_CONVERTER::Decide() says of this connector (read from the kernel now)
+  static DV_CONVERTER::Offer ConverterOffer(CDRMConnector& connector);
+  //! DVBRIDGE_DV_CONVERTER of a DisplayPort connector that has it (nothing otherwise)
+  static std::optional<uint64_t> ConverterVerdict(CDRMConnector& connector);
+  //! The driver of the connector can send Dolby Vision Low-Latency over its tunnel (the kernel:
+  //! DVBRIDGE_DV_LOW_LATENCY_LAB, linux-9948 to 9950; nvidia-drm: NV_HDMI_DV_LOW_LATENCY,
+  //! nvidia-open-kernel-modules-9030)
+  static bool SupportsLowLatency(CDRMConnector& connector);
+  //! The connector can send HDR as YCbCr 4:2:2 at 12 bits over its tunnel (the kernel:
+  //! DVBRIDGE_HDR10_TUNNEL_LAB, linux-9973 to 9975; i915 and amdgpu: not nvidia-drm)
+  static bool SupportsHdr10Tunnel(CDRMConnector& connector);
+  //! ... and the older signalling, the HDMI 1.4b vendor InfoFrame (DVHdmi14b.h; the kernel:
+  //! DVBRIDGE_DV_HDMI14B_LAB; nvidia-drm: NV_HDMI_DV_HDMI14B, nvidia-open-kernel-modules-9045 and
+  //! nvidia-legacy-open-9058)
+  static bool SupportsHdmi14b(CDRMConnector& connector);
+  //! The HDMI_VIC of a mode, which that InfoFrame names (DV_HDMI14B::HdmiVic())
+  static unsigned int Hdmi14bVic(const drmModeModeInfo& mode);
+
+  /*!
+   * \brief A Kodi that ended during native output (killed or crashed) leaves the transport set on
+   *        the connector: stages what puts it right for the first modeset of this session.
+   *
+   * Where the transport was kept (the file of Capture()) and the output is still as the transport
+   * made it, each property goes back to what it was; the signals and the settings that the
+   * transport changes, which the file does not name, go back to the defaults of the driver.
+   */
+  static void RepairAfterCrash(CDRMAtomic& drm);
+  //! Where the transport on the output is kept (default /run/hades-dv-state: a file of the
+  //! running system, gone with a reboot); a test says another
+  static void SetStatePath(std::string path);
+
+  //! \param ownVsif (nvidia-drm) the blob of an HDMI vendor InfoFrame that Kodi gave the driver
+  //!        itself and that says nothing of the picture (its 3D output: the end of a 3D layout),
+  //!        or 0. The only one that may be on the connector; it is not put back afterwards.
+  //! \param lowLatency the tunnel carries Dolby Vision Low-Latency (SupportsLowLatency()): the
+  //!        kernel or the module says so in the InfoFrames, the metadata of the frames is none
+  //! \param hdmi14b the tunnel is signalled with the HDMI 1.4b vendor InfoFrame
+  //!        (SupportsHdmi14b()): the kernel makes it for the mode of each commit; for nvidia-drm it
+  //!        is made here, and again by Stage() for the mode of a commit that changes it. Never with
+  //!        lowLatency.
+  //! \param hdr10Tunnel the tunnel carries HDR (HDR10, HLG, HDR10+) as YCbCr 4:2:2 at 12 bits
+  //!        (SupportsHdr10Tunnel()): no Dolby VSIF, and the HDR metadata of the stream is the
+  //!        output's, as Kodi sets it: it is not captured, and not set to 0. Never with lowLatency
+  //!        or hdmi14b.
+  bool TakeOver(CDRMAtomic& drm,
+                uint64_t ownVsif = 0,
+                bool lowLatency = false,
+                bool hdmi14b = false,
+                bool hdr10Tunnel = false);
+  //! Puts into the request of \p drm what the transport sets, or (restore) what gives the output
+  //! back: of what is not as it was found. False when the output is not the one that was captured,
+  //! or a property cannot be put in the request.
+  bool PutInRequest(CDRMAtomic& drm, bool handBack);
+  //! The commit that gave the output back was refused: the driver is asked about each change of it
+  //! (TEST_ONLY), and what it would not take is left out of the next one, and said
+  void HandBackRefused(CDRMAtomic& drm);
+  //! The commit that gave the output back was taken: the output is read back, what is not as it
+  //! was found is set again (a commit of its own), and what could not be is said; then the capture
+  //! is let go (LetGo()). True when everything is as it was found.
+  bool HandBackTaken(CDRMAtomic& drm);
+  //! The capture is let go: nothing of the transport was committed, or the output was given back
+  void LetGo();
+  bool HoldsOutput() const { return !m_snapshot.Empty(); }
+  //! Why the last Capture() did not capture the output (what the output lacks, or what stands in
+  //! the way), for the log; empty after one that did
+  const std::string& TakeOverFailure() const { return m_takeOverFailure; }
+  //! The driver of the captured output (NONE when nothing is captured).
+  Driver HeldDriver() const { return m_driver; }
+  //! The captured output sends Dolby Vision Low-Latency
+  bool HeldLowLatency() const { return HoldsOutput() && m_lowLatency; }
+  //! The captured output sends HDR over the tunnel (Capture(): hdr10Tunnel), not Dolby Vision
+  bool HeldHdr10Tunnel() const { return HoldsOutput() && m_hdr10Tunnel; }
+  //! The captured output signals Dolby Vision with the HDMI 1.4b vendor InfoFrame
+  bool HeldHdmi14b() const { return HoldsOutput() && m_hdmi14b; }
+  //! True once per capture, so that a refused restart of the output, retried once a second while
+  //! the display refuses it, is logged as a warning only once.
+  bool TakeRefusalNotice() { return std::exchange(m_refusalNoticeDue, false); }
+  //! The transport has been committed once since the capture: the output already has the
+  //! transport properties, so the next transport frames change only the framebuffer.
+  bool TransportOn() const { return m_transportOn; }
+  void MarkTransportOn() { m_transportOn = true; }
+  //! The captured output brings its link up from scratch for native output (nvidia-drm on a
+  //! dual-mode DisplayPort connector: NVIDIA_DUAL_MODE::LinkFromScratch()): the transport enters
+  //! only in the mode on the output, with the head turned off and on
+  bool HeldLinkFromScratch() const { return HoldsOutput() && m_linkFromScratch; }
+  //! ... true once per capture: the entry that turns the head off and on is tried once, and a
+  //! refusal of it leaves the next frames to the entry in place
+  bool TakeEntryRestart() { return std::exchange(m_entryRestart, false); }
+  //! ... true once per capture, for the log of an entry that waits for the mode
+  bool TakeEntryNotice() { return std::exchange(m_entryNotice, false); }
+
+private:
+  //! The objects that were captured, by what \p drm uses now; false (and in the log) when one of
+  //! them is not the object that was captured
+  bool ResolveOutput(CDRMAtomic& drm, std::array<CDRMObject*, 3>& objects) const;
+  //! The signal of the HDMI 1.4b vendor InfoFrame for the mode that the commit sets (nvidia-drm)
+  bool NameModeInSignal(CDRMAtomic& drm);
+  void SaveRecord() const;
+
+  OUTPUT_STATE::CSnapshot m_snapshot;
+  int m_fd = -1;
+  CDRMAtomic* m_drm = nullptr;
+  bool m_transportOn = false;
+  Driver m_driver = Driver::NONE;
+  bool m_refusalNoticeDue = true;
+  std::string m_takeOverFailure;
+  bool m_lowLatency = false;
+  bool m_hdr10Tunnel = false;
+  //! the blob of the Dolby vendor InfoFrame (not with the HDMI 1.4b signalling)
+  CDRMPropertyBlob m_vsif;
+  //! the HDMI 1.4b vendor InfoFrame (Capture(): hdmi14b); on nvidia-drm, its blob for each HDMI_VIC
+  //! that a mode of this capture has had (kept while it is captured: a commit refused after a change
+  //! of mode goes back to the blob of before), and the HDMI_VIC of the one staged last (-1: none)
+  bool m_hdmi14b = false;
+  std::array<CDRMPropertyBlob, DV_HDMI14B::HDMI_VICS> m_hdmi14bVsif;
+  int m_hdmi14bVic = -1;
+  bool m_linkFromScratch = false;
+  bool m_entryRestart = true;
+  bool m_entryNotice = true;
+  bool m_restoreSaid = false; //!< what Stage() gives back was said already for this attempt
+  mutable bool m_resolveSaid = false; //!< Resolve() said that the output is another
+};
+} // namespace KODI::WINDOWING::GBM
