-bool CDVBridgeState::UseHdmi14bVsif(CDRMAtomic& drm)
-{
-  const auto* mode = drm.GetSelectedMode();
-  const unsigned int vic = mode ? Hdmi14bVic(*mode) : 0;
-  if (static_cast<int>(vic) == m_hdmi14bVic)
-    return true;
-  auto& blob = m_hdmi14bVsif[vic];
-  if (!blob.IsValid())
-  {
-    const auto payload = DV_HDMI14B::Payload(vic);
-    blob = CDRMPropertyBlob(drm.GetFileDescriptor(), payload.data(), payload.size());
-    if (!blob.IsValid())
-    {
-      CLog::Log(LOGERROR, "DVBridge: the blob of the HDMI 1.4b vendor InfoFrame of HDMI_VIC {} "
-                          "could not be made",
-                vic);
-      return false;
-    }
-  }
-  for (auto& property : m_saved)
-  {
-    if (property.name == "NV_HDMI_VSIF_METADATA")
-    {
-      property.transport = blob.Get();
-      CLog::Log(LOGDEBUG,
-                "DVBridge: the HDMI 1.4b vendor InfoFrame names HDMI_VIC {} (was {}), for the "
-                "mode {}x{} ({} kHz)",
-                vic, m_hdmi14bVic, mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0,
-                mode ? mode->clock : 0);
-      m_hdmi14bVic = static_cast<int>(vic);
-      return true;
-    }
-  }
-  return false;
-}
-
-bool CDVBridgeState::Stage(CDRMAtomic& drm, bool restore)
-{
-  if (!Captured() || m_owner != &drm || m_saved.front().object != drm.GetConnector())
-    return false;
-  // Hades: the HDMI 1.4b vendor InfoFrame of nvidia-drm names the HDMI_VIC of the mode that this
-  // commit sets: it changes in the same commit as the mode (restored, it goes with the rest)
-  if (!restore && m_hdmi14b && m_backend == Backend::NVIDIA && !UseHdmi14bVsif(drm))
-    return false;
-  bool valid = true;
-  for (const auto& property : m_saved)
-    valid &= drm.AddProperty(property.object, property.name.c_str(),
-                             restore ? property.original : property.transport);
-  return valid;
-}
