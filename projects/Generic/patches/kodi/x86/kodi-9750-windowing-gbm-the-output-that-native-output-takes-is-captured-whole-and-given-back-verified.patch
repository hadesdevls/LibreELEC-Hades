new file mode 100644
index 0000000..38e1b27
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/OutputHandover.cpp
@@ -0,0 +1,816 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "OutputHandover.h"
+
+#include "DRMAtomic.h"
+#include "DRMConnector.h"
+#include "LibdrmKms.h"
+#include "NvidiaDualMode.h"
+#include "windowing/gbm/HDR10PlusOutput.h"
+#include "windowing/gbm/HdmiVrrOff.h"
+#include "windowing/gbm/OutputFormat.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <iterator>
+#include <map>
+#include <string>
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+using namespace KODI::WINDOWING::GBM;
+namespace OS = KODI::WINDOWING::GBM::OUTPUT_STATE;
+
+namespace
+{
+std::atomic<int> g_converterUse{0};
+
+// ---- what the drivers call things ----
+
+constexpr const char* KERNEL_DV = "DVBRIDGE_DV_STANDARD_LAB";
+constexpr const char* KERNEL_LOW_LATENCY = "DVBRIDGE_DV_LOW_LATENCY_LAB";
+constexpr const char* KERNEL_HDMI14B = "DVBRIDGE_DV_HDMI14B_LAB";
+constexpr const char* KERNEL_HDR_TUNNEL = "DVBRIDGE_HDR10_TUNNEL_LAB";
+constexpr const char* NVIDIA_VSIF = "NV_HDMI_VSIF_METADATA";
+constexpr const char* NVIDIA_LOW_LATENCY = "NV_HDMI_DV_LOW_LATENCY";
+constexpr const char* NVIDIA_HDMI14B = "NV_HDMI_DV_HDMI14B";
+
+//! The signals that say the transport is on, per kind of driver
+constexpr const char* KERNEL_SIGNALS[] = {KERNEL_DV, KERNEL_LOW_LATENCY, KERNEL_HDMI14B,
+                                          KERNEL_HDR_TUNNEL};
+constexpr const char* NVIDIA_SIGNALS[] = {NVIDIA_VSIF, NVIDIA_LOW_LATENCY, NVIDIA_HDMI14B};
+
+//! What nvidia-drm needs on a connector for native output
+constexpr const char* NVIDIA_NEEDS[] = {NVIDIA_VSIF, "max bpc", "dithering mode"};
+
+// Dolby VSIF payload: IEEE OUI 00-D0-46 (in the order that nvidia-drm takes it) followed by the
+// content bytes, with only the Dolby Vision signal bit set; the driver adds the InfoFrame header
+// (type 0x81, version 1, length 27) and the checksum.
+constexpr uint8_t DOLBY_VSIF[27] = {0x46, 0xD0, 0x00, 0x02};
+// ... and with the low-latency bit as well, for Dolby Vision Low-Latency; nvidia-drm takes it only
+// with NV_HDMI_DV_LOW_LATENCY, and NVKMS then sends the AVI InfoFrame of YCbCr 4:2:2 with it
+constexpr uint8_t DOLBY_VSIF_LOW_LATENCY[27] = {0x46, 0xD0, 0x00, 0x03};
+
+// 1.0 in the S31.32 fixed point of NV_PLANE_DEGAMMA_MULTIPLIER and NV_CRTC_REGAMMA_DIVISOR.
+constexpr uint64_t NVIDIA_ONE = uint64_t{1} << 32;
+
+std::string& StatePath()
+{
+  static std::string path = "/run/hades-dv-state";
+  return path;
+}
+
+//! Blobs made for the leftover of a previous session: they live until the next one is staged (the
+//! commit that carries them is made after), and the kernel gives them back with the descriptor
+std::vector<uint32_t>& LeftoverBlobs()
+{
+  static auto* blobs = new std::vector<uint32_t>();
+  return *blobs;
+}
+
+bool AnySet(CDRMConnector& connector, const char* const* names, size_t count)
+{
+  for (size_t i = 0; i < count; ++i)
+    if (connector.GetPropertyValue(names[i]).value_or(0) != 0)
+      return true;
+  return false;
+}
+
+//! The plane that \p drm sends the output through: the GUI plane or, with one plane, the video one
+CDRMPlane* OutputPlane(CDRMAtomic& drm)
+{
+  return drm.GetGuiPlane() ? drm.GetGuiPlane() : drm.GetVideoPlane();
+}
+
+} // namespace
+
+void COutputHandover::SetConverterUse(DV_CONVERTER::Use use)
+{
+  g_converterUse = static_cast<int>(use);
+}
+
+void COutputHandover::SetStatePath(std::string path)
+{
+  StatePath() = std::move(path);
+}
+
+std::optional<uint64_t> COutputHandover::ConverterVerdict(CDRMConnector& connector)
+{
+  if (connector.GetType() != "DP" || !connector.SupportsProperty(DV_CONVERTER::PROPERTY))
+    return std::nullopt;
+  // (the kernel writes it when the display is found, after the connector was read: so from the
+  // kernel, not from what was read at the start)
+  return connector.ReadPropertyValue(DV_CONVERTER::PROPERTY);
+}
+
+DV_CONVERTER::Offer COutputHandover::ConverterOffer(CDRMConnector& connector)
+{
+  return DV_CONVERTER::Decide(DV_CONVERTER::UseOf(g_converterUse), connector.GetType() == "DP",
+                              ConverterVerdict(connector));
+}
+
+COutputHandover::Driver COutputHandover::DriverOf(CDRMConnector& connector)
+{
+  if (connector.SupportsProperty(KERNEL_DV))
+  {
+    // A DisplayPort connector that reaches the display through the converter of its board
+    // (DVBRIDGE_DV_CONVERTER) is a kernel output only where the policy offers it: a board where it
+    // was seen working, or one the user asked for. Without that property: always.
+    const auto offer = ConverterOffer(connector);
+    return (!offer.applies || offer.offered) ? Driver::KMS_PROPERTIES : Driver::NONE;
+  }
+  // nvidia-drm: an HDMI connector, or a DisplayPort one that the card drives as HDMI now
+  // (NvidiaDualMode.h; the kernel sets the value when the display is found)
+  const std::string type = connector.GetType();
+  std::optional<uint64_t> dualMode;
+  if (type == "DP" && connector.SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+    dualMode = connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY);
+  if (!NVIDIA_DUAL_MODE::DrivenAsHdmi(type, dualMode))
+    return Driver::NONE;
+  const bool complete = std::ranges::all_of(NVIDIA_NEEDS, [&connector](const char* name)
+                                            { return connector.SupportsProperty(name); });
+  return complete ? Driver::NVIDIA_DRM : Driver::NONE;
+}
+
+bool COutputHandover::SupportsLowLatency(CDRMConnector& connector)
+{
+  switch (DriverOf(connector))
+  {
+    case Driver::KMS_PROPERTIES:
+      return connector.SupportsProperty(KERNEL_LOW_LATENCY);
+    case Driver::NVIDIA_DRM:
+      return connector.SupportsProperty(NVIDIA_LOW_LATENCY);
+    default:
+      return false;
+  }
+}
+
+bool COutputHandover::SupportsHdr10Tunnel(CDRMConnector& connector)
+{
+  return DriverOf(connector) == Driver::KMS_PROPERTIES &&
+         connector.SupportsProperty(KERNEL_HDR_TUNNEL);
+}
+
+bool COutputHandover::SupportsHdmi14b(CDRMConnector& connector)
+{
+  switch (DriverOf(connector))
+  {
+    case Driver::KMS_PROPERTIES:
+      return connector.SupportsProperty(KERNEL_HDMI14B);
+    case Driver::NVIDIA_DRM:
+      return connector.SupportsProperty(NVIDIA_HDMI14B);
+    default:
+      return false;
+  }
+}
+
+unsigned int COutputHandover::Hdmi14bVic(const drmModeModeInfo& mode)
+{
+  const bool notProgressive =
+      (mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0;
+  return DV_HDMI14B::HdmiVic(mode.hdisplay, mode.vdisplay, mode.clock, mode.htotal, mode.vtotal,
+                             notProgressive);
+}
+
+// ---- a transport that was left on the output ----
+
+namespace
+{
+//! Stages the properties of the record of a previous session that are still as the transport made
+//! them; how many
+size_t StageRecord(CDRMAtomic& drm)
+{
+  auto& blobs = LeftoverBlobs();
+  const int fd = drm.GetFileDescriptor();
+  for (const uint32_t blob : blobs)
+    drmModeDestroyPropertyBlob(fd, blob);
+  blobs.clear();
+
+  const auto text = OS::CSnapshot::ReadFile(StatePath());
+  if (!text)
+    return 0;
+  const auto record = OS::CSnapshot::Parse(*text);
+  if (!record)
+  {
+    CLog::Log(LOGWARNING,
+              "DVBridge: the record of the transport that a previous session left ({}) "
+              "cannot be read: the defaults of the driver are staged instead",
+              StatePath());
+    return 0;
+  }
+  CDRMObject* objects[3] = {drm.GetConnector(), drm.GetCrtc(), nullptr};
+  for (CDRMPlane* plane : {drm.GetGuiPlane(), drm.GetVideoPlane()})
+    if (plane && plane->GetId() == record->objects[2])
+      objects[2] = plane;
+  for (int i = 0; i < 3; ++i)
+    if (!objects[i] || objects[i]->GetId() != record->objects[i])
+    {
+      CLog::Log(LOGINFO,
+                "DVBridge: the record of a previous session is of another output "
+                "(connector {}, CRTC {}, plane {}): not used",
+                record->objects[0], record->objects[1], record->objects[2]);
+      return 0;
+    }
+
+  OS::CLibdrmKms kms(fd);
+  auto plan = OS::CSnapshot::PlanLeftover(*record, kms);
+  blobs = plan.blobs;
+  std::string names;
+  size_t staged = 0;
+  for (const auto& change : plan.changes)
+  {
+    if (!drm.AddProperty(objects[static_cast<int>(change.role)], change.name.c_str(), change.value))
+      continue;
+    names += (names.empty() ? "" : ", ") + change.name;
+    ++staged;
+  }
+  std::string left;
+  for (const auto& name : plan.skipped)
+    left += (left.empty() ? "" : ", ") + name;
+  CLog::Log(LOGINFO,
+            "DVBridge: {} propert{} put back from the record of the previous session ({}){}{}",
+            staged, staged == 1 ? "y" : "ies",
+            names.empty() ? "none was still as the transport "
+                            "made it"
+                          : names,
+            left.empty() ? "" : "; not touched, as they are not what the transport left: ", left);
+  return staged;
+}
+
+//! The values that a driver starts with, for what the transport changes, where the record does not
+//! say (it is gone, or the transport is of before it was kept)
+void StageDefaults(CDRMAtomic& drm, bool kmsSignals, bool nvidiaSignals)
+{
+  CDRMConnector* connector = drm.GetConnector();
+  const auto put = [&drm](CDRMObject* object, const char* name, std::optional<uint64_t> value)
+  {
+    if (object && value && !drm.RequestValue(object, name))
+      drm.AddProperty(object, name, *value);
+  };
+  const auto off = [&](const char* name)
+  {
+    if (connector->SupportsProperty(name))
+      put(connector, name, 0);
+  };
+  if (kmsSignals)
+    for (const char* name : KERNEL_SIGNALS)
+      off(name);
+  if (nvidiaSignals)
+  {
+    // (together: nvidia-drm takes neither without the other)
+    for (const char* name : NVIDIA_SIGNALS)
+      off(name);
+  }
+  // The transport limited the link to 8 bpc without dither; the ordinary output sets neither.
+  if (const auto limits = connector->GetRangePropertyLimits("max bpc"))
+    put(connector, "max bpc", limits->second);
+  put(connector, "dithering mode", connector->GetPropertyEnumValue("dithering mode", "auto"));
+  // It also forced full-range RGB and opaque, unblended planes, which the ordinary output never
+  // sets: the defaults of the drivers (Kodi's limited range, where the driver makes it, is asked
+  // again with the next mode set: CWinSystemGbm::StageRgbRange())
+  put(connector, "Broadcast RGB", connector->GetPropertyEnumValue("Broadcast RGB", "Automatic"));
+  for (CDRMPlane* plane : {drm.GetGuiPlane(), drm.GetVideoPlane()})
+  {
+    if (!plane)
+      continue;
+    put(plane, "pixel blend mode",
+        plane->GetPropertyEnumValue("pixel blend mode", "Pre-multiplied"));
+    if (const auto limits = plane->GetRangePropertyLimits("alpha"))
+      put(plane, "alpha", limits->second);
+  }
+}
+} // namespace
+
+void COutputHandover::RepairAfterCrash(CDRMAtomic& drm)
+{
+  CDRMConnector* connector = drm.GetConnector();
+  if (!connector)
+    return;
+  // An HDR10+ InfoFrame of a previous session, whatever else is left (CHDR10PlusOutput)
+  if (CHDR10PlusOutput::ClearLeftover(drm, *connector))
+    CLog::Log(LOGWARNING,
+              "HDR10+: {} of a previous session is still set on the connector; "
+              "cleared with the first modeset",
+              CHDR10PlusOutput::PROPERTY);
+  // Only where a transport signal proves it: otherwise nothing is touched, and a record of a
+  // transport that is gone is stale
+  const bool kmsSignals = AnySet(*connector, KERNEL_SIGNALS, std::size(KERNEL_SIGNALS));
+  const bool nvidiaSignals = AnySet(*connector, NVIDIA_SIGNALS, std::size(NVIDIA_SIGNALS));
+  if (!kmsSignals && !nvidiaSignals)
+  {
+    std::remove(StatePath().c_str());
+    return;
+  }
+  // (On nvidia-drm it may also be the vendor InfoFrame of Kodi's 3D output, which uses the same
+  // property: a Kodi that ended while a 3D display was told of a layout.)
+  CLog::Log(LOGWARNING,
+            "DVBridge: {} of a previous session is still set on the connector; resetting it "
+            "with the first modeset",
+            kmsSignals ? "native Dolby Vision output"
+                       : "an HDMI vendor InfoFrame (native Dolby Vision output, or 3D output)");
+  StageRecord(drm);
+  StageDefaults(drm, kmsSignals, nvidiaSignals);
+}
+
+// ---- the capture ----
+
+bool COutputHandover::ResolveOutput(CDRMAtomic& drm, std::array<CDRMObject*, 3>& objects) const
+{
+  const auto idOf = [](const CDRMObject* object) { return object ? object->GetId() : 0u; };
+  CDRMConnector* connector = drm.GetConnector();
+  CDRMCrtc* crtc = drm.GetCrtc();
+  CDRMPlane* gui = drm.GetGuiPlane();
+  CDRMPlane* video = drm.GetVideoPlane();
+  const uint32_t had[3] = {m_snapshot.ObjectOf(OS::Role::CONNECTOR),
+                           m_snapshot.ObjectOf(OS::Role::CRTC),
+                           m_snapshot.ObjectOf(OS::Role::PLANE)};
+  const auto found = OS::SameOutput(had, idOf(connector), idOf(crtc), idOf(gui), idOf(video));
+  if (!found.same)
+  {
+    CLog::Log(std::exchange(m_resolveSaid, true) ? LOGDEBUG : LOGWARNING,
+              "DVBridge: the output is not the one that was captured any more (the {} is {}, it "
+              "was {}): nothing is staged for it",
+              OS::RoleName(found.differs), found.has, found.had);
+    return false;
+  }
+  objects = {connector, crtc, found.plane == 0 ? gui : video};
+  return true;
+}
+
+bool COutputHandover::TakeOver(
+    CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency, bool hdmi14b, bool hdr10Tunnel)
+{
+  m_takeOverFailure.clear();
+  const auto fail = [this](std::string why)
+  {
+    m_takeOverFailure = std::move(why);
+    return false;
+  };
+  if (HoldsOutput())
+    return fail("an output is captured already");
+  CDRMConnector* connector = drm.GetConnector();
+  CDRMCrtc* crtc = drm.GetCrtc();
+  CDRMPlane* plane = OutputPlane(drm);
+  if (!connector || !crtc || !plane)
+    return fail("no connector, CRTC or plane is in use");
+  if (drm.GetGuiPlane() && drm.GetVideoPlane())
+    return fail("a GUI plane and a video plane are both in use");
+  const Driver driver = DriverOf(*connector);
+  if (driver == Driver::NONE)
+    return fail("the connector has no Dolby Vision output driver");
+  // Low-Latency only where the driver has it (fail closed: no other signal instead)
+  if (lowLatency && !SupportsLowLatency(*connector))
+    return fail("the driver of the connector cannot send Dolby Vision Low-Latency");
+  // ... and the HDMI 1.4b signalling likewise, never with Low-Latency (the drivers refuse both)
+  if (hdmi14b && lowLatency)
+    return fail("Low-Latency and the HDMI 1.4b signalling are asked for together");
+  // HDR over the tunnel is none of the Dolby Vision signals, and only the kernel's backends have it
+  if (hdr10Tunnel && (lowLatency || hdmi14b))
+    return fail("HDR over the tunnel is asked for together with a Dolby Vision signal");
+  if (hdr10Tunnel && !SupportsHdr10Tunnel(*connector))
+    return fail("the driver of the connector cannot send HDR over the tunnel (no "
+                "DVBRIDGE_HDR10_TUNNEL_LAB)");
+  if (hdmi14b && !SupportsHdmi14b(*connector))
+    return fail("the driver of the connector cannot send the older Dolby Vision signalling, the "
+                "HDMI 1.4b vendor InfoFrame");
+  if (driver == Driver::KMS_PROPERTIES && connector->GetPropertyValue(KERNEL_DV) != 0)
+    return fail("DVBRIDGE_DV_STANDARD_LAB is set on the connector already");
+  // Nothing else may be sending an HDMI vendor InfoFrame through the property already, but the
+  // one that Kodi's 3D output leaves there to tell the display that a 3D layout ended: it says
+  // nothing of the picture, and the Dolby one takes its place for good.
+  const auto vsifBefore = connector->GetPropertyValue(NVIDIA_VSIF);
+  const bool vsifOwn = ownVsif != 0 && vsifBefore == ownVsif;
+  if (driver == Driver::NVIDIA_DRM && vsifBefore != 0 && !vsifOwn)
+    return fail("another HDMI vendor InfoFrame is set on the connector (NV_HDMI_VSIF_METADATA)");
+
+  const int fd = drm.GetFileDescriptor();
+  OS::CLibdrmKms kms(fd);
+
+  // The signal of nvidia-drm, a blob: the Dolby vendor InfoFrame, or with the HDMI 1.4b signalling
+  // the one that names the HDMI_VIC of the mode selected (it is made again for the mode of a commit
+  // that changes it: UseHdmi14bVsif())
+  CDRMPropertyBlob vsif;
+  std::array<CDRMPropertyBlob, DV_HDMI14B::HDMI_VICS> hdmi14bVsif;
+  unsigned int vic = 0;
+  uint32_t signal = 0;
+  if (driver == Driver::NVIDIA_DRM)
+  {
+    if (hdmi14b)
+    {
+      const auto* mode = drm.GetSelectedMode();
+      vic = mode ? Hdmi14bVic(*mode) : 0;
+      const auto payload = DV_HDMI14B::Payload(vic);
+      hdmi14bVsif[vic] = CDRMPropertyBlob(fd, payload.data(), payload.size());
+      if (!hdmi14bVsif[vic].IsValid())
+        return fail("the blob of the HDMI 1.4b vendor InfoFrame could not be made");
+      signal = hdmi14bVsif[vic].Get();
+    }
+    else
+    {
+      const uint8_t* payload = lowLatency ? DOLBY_VSIF_LOW_LATENCY : DOLBY_VSIF;
+      vsif = CDRMPropertyBlob(fd, payload, sizeof(DOLBY_VSIF));
+      if (!vsif.IsValid())
+        return fail("the blob of the Dolby vendor InfoFrame could not be made");
+      signal = vsif.Get();
+    }
+  }
+
+  // What the transport sets: the properties of the output that must be as they are in it so that
+  // what is scanned out reaches the display bit for bit. A property that is not there is no
+  // transport where it is not required.
+  std::vector<OS::Spec> specs;
+  const auto number = [&specs](OS::Role role, const char* name, uint64_t value, bool required)
+  { specs.push_back({role, name, OS::Spec::How::NUMBER, value, {}, required}); };
+  const auto named = [&specs](OS::Role role, const char* name, const char* value, bool required)
+  { specs.push_back({role, name, OS::Spec::How::ENUM_NAME, 0, value, required}); };
+  constexpr auto CONNECTOR = OS::Role::CONNECTOR;
+  constexpr auto CRTC = OS::Role::CRTC;
+  constexpr auto PLANE = OS::Role::PLANE;
+
+  if (driver == Driver::KMS_PROPERTIES)
+  {
+    number(CONNECTOR, KERNEL_DV, 1, true);
+    if (lowLatency)
+      number(CONNECTOR, KERNEL_LOW_LATENCY, 1, true);
+    if (hdmi14b)
+      number(CONNECTOR, KERNEL_HDMI14B, 1, true);
+    // HDR over the tunnel: the kernel requires the HDR metadata that Kodi sets for the stream, and
+    // sends no Dolby VSIF. Otherwise HDR_OUTPUT_METADATA goes to 0, and may not be there: i915
+    // offers the tunnel from display version 9 on and attaches it to an HDMI connector from
+    // version 10 on, and the kernel refuses the tunnel with HDR metadata in the connector state;
+    // without the property there can be none to keep.
+    if (hdr10Tunnel)
+      number(CONNECTOR, KERNEL_HDR_TUNNEL, 1, true);
+    else
+      number(CONNECTOR, "HDR_OUTPUT_METADATA", 0, false);
+    number(CONNECTOR, "max bpc", 8, true);
+    named(CONNECTOR, "Broadcast RGB", "Full", true);
+    named(CONNECTOR, "Colorspace", "Default", true);
+    // The tunnel is RGB (amdgpu refuses another colour format than AUTO or RGB): AUTO with it; what
+    // the user chose, or another program left, goes back with its end
+    named(CONNECTOR, OUTPUT_FORMAT::PROPERTY, "AUTO", false);
+  }
+  else
+  {
+    // Broadcast RGB is not touched on nvidia-drm: RGB output is full range by default, and with
+    // the Dolby VSIF in the state the kernel keeps the head in full range whatever it says
+    // (nvidia-open-kernel-modules-9056)
+    specs.push_back({CONNECTOR, NVIDIA_VSIF, OS::Spec::How::BLOB, signal, {}, true});
+    if (lowLatency)
+      number(CONNECTOR, NVIDIA_LOW_LATENCY, 1, true);
+    if (hdmi14b)
+      number(CONNECTOR, NVIDIA_HDMI14B, 1, true);
+    // HDMI VRR is left off while the transport is on, where nvidia-drm has the property (Turing and
+    // Ampere: CHdmiVrrOff)
+    number(CONNECTOR, CHdmiVrrOff::PROPERTY, 1, false);
+    number(CONNECTOR, "HDR_OUTPUT_METADATA", 0, true);
+    number(CONNECTOR, "max bpc", 8, true);
+    named(CONNECTOR, "dithering mode", "off", true);
+    // The tunnel is RGB: the colour format of NVIDIA (driver 620) is "auto" with it
+    named(CONNECTOR, OUTPUT_FORMAT::PROPERTY_NVIDIA, "auto", false);
+    named(CONNECTOR, "Colorspace", "Default", true);
+    named(CRTC, "NV_CRTC_REGAMMA_TF", "Default", false);
+    number(CRTC, "NV_CRTC_REGAMMA_LUT", 0, false);
+    number(CRTC, "NV_CRTC_REGAMMA_DIVISOR", NVIDIA_ONE, false);
+    number(CRTC, "NV_CRTC_COLOR_PASSTHROUGH", 0, false);
+    named(PLANE, "NV_INPUT_COLORSPACE", "None", false);
+    for (const char* blob : {"NV_HDR_STATIC_METADATA", "NV_PLANE_LMS_CTM",
+                             "NV_PLANE_LMS_TO_ITP_CTM", "NV_PLANE_ITP_TO_LMS_CTM",
+                             "NV_PLANE_BLEND_CTM", "NV_PLANE_DEGAMMA_LUT", "NV_PLANE_TMO_LUT"})
+      number(PLANE, blob, 0, false);
+    named(PLANE, "NV_PLANE_DEGAMMA_TF", "Default", false);
+    number(PLANE, "NV_PLANE_DEGAMMA_MULTIPLIER", NVIDIA_ONE, false);
+    number(PLANE, "NV_PLANE_COLOR_PASSTHROUGH", 0, false);
+  }
+  // Neutral colour processing and an opaque, unrotated plane, for either driver
+  number(CRTC, "CTM", 0, false);
+  number(CRTC, "GAMMA_LUT", 0, false);
+  number(CRTC, "DEGAMMA_LUT", 0, false);
+  number(CRTC, "VRR_ENABLED", 0, false);
+  number(PLANE, "rotation", DRM_MODE_ROTATE_0, false);
+  number(PLANE, "alpha", 65535, false);
+  number(PLANE, "COLOR_PIPELINE", 0, false);
+  named(PLANE, "pixel blend mode", "None", false);
+
+  std::vector<OS::ObjectInfo> objects;
+  const std::pair<OS::Role, uint32_t> ids[] = {
+      {CONNECTOR, connector->GetId()}, {CRTC, crtc->GetId()}, {PLANE, plane->GetId()}};
+  for (const auto& [role, id] : ids)
+  {
+    auto info = kms.Describe(role, id);
+    if (!info)
+      return fail(std::string("the properties of the ") + OS::RoleName(role) +
+                  " could not be read");
+    objects.push_back(std::move(*info));
+  }
+
+  OS::Policy policy;
+  policy.hdrMetadataIsKodis = hdr10Tunnel;
+  const auto captured = m_snapshot.Capture(kms, objects, specs, policy);
+  if (!captured.ok)
+    return fail(captured.failure);
+  // (nvidia-drm: the InfoFrame of Kodi's 3D output is not put back when native output ends: the
+  // property is left empty)
+  if (vsifOwn)
+    m_snapshot.LeaveEmpty(kms, CONNECTOR, NVIDIA_VSIF);
+
+  // Do not silently corrupt tunnel bytes with another plane or a hardware cursor.
+  std::string clash;
+  if (drmModePlaneRes* planes = drmModeGetPlaneResources(fd))
+  {
+    for (uint32_t i = 0; i < planes->count_planes && clash.empty(); ++i)
+    {
+      drmModePlane* other = drmModeGetPlane(fd, planes->planes[i]);
+      if (!other)
+      {
+        clash = "a plane could not be read";
+        break;
+      }
+      if (other->plane_id != plane->GetId() && other->crtc_id == crtc->GetCrtcId())
+        clash = "another plane (" + std::to_string(other->plane_id) +
+                ") is on the CRTC: what it shows would mix with the transport";
+      drmModeFreePlane(other);
+    }
+    drmModeFreePlaneResources(planes);
+  }
+  else
+    clash = "the planes could not be listed";
+  if (!clash.empty())
+  {
+    m_snapshot.Release(kms);
+    return fail(clash);
+  }
+
+  m_fd = fd;
+  m_drm = &drm;
+  m_driver = driver;
+  m_lowLatency = lowLatency;
+  m_hdr10Tunnel = hdr10Tunnel;
+  m_hdmi14b = hdmi14b;
+  m_vsif = std::move(vsif);
+  m_hdmi14bVsif = std::move(hdmi14bVsif);
+  m_hdmi14bVic = hdmi14b && driver == Driver::NVIDIA_DRM ? static_cast<int>(vic) : -1;
+  // A dual-mode DisplayPort connector that nvidia-drm drives as HDMI brings its link up from
+  // scratch for native output (NVIDIA_DUAL_MODE::LinkFromScratch()); an HDMI one does not
+  {
+    const std::string type = connector->GetType();
+    std::optional<uint64_t> dualMode;
+    if (type == "DP" && connector->SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+      dualMode = connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY);
+    m_linkFromScratch =
+        driver == Driver::NVIDIA_DRM && NVIDIA_DUAL_MODE::LinkFromScratch(type, dualMode);
+  }
+  m_entryRestart = true;
+  m_entryNotice = true;
+  m_restoreSaid = false;
+  m_resolveSaid = false;
+  // What the driver said of an earlier native output is not about this one
+  drm.ClearDVRefused();
+  SaveRecord();
+
+  for (const auto& entry : m_snapshot.Entries())
+  {
+    if (entry.transport)
+      CLog::Log(LOGDEBUG, "DVBridge: {} found as {}, the transport makes it {}", entry.Label(),
+                OS::ValueText(entry, entry.original), OS::ValueText(entry, entry.transportValue));
+    else
+      CLog::Log(LOGDEBUG, "DVBridge: {} found as {}", entry.Label(),
+                OS::ValueText(entry, entry.original));
+    if (entry.info.name == CHdmiVrrOff::PROPERTY && entry.transport)
+      CLog::Log(LOGINFO,
+                "DVBridge: HDMI VRR is left off while Dolby Vision is on ({} 1, it had {}): the "
+                "display gets no EMP of HDMI VRR beside the Dolby InfoFrame; the end of native "
+                "output puts it back",
+                CHdmiVrrOff::PROPERTY, entry.original);
+  }
+  if (!connector->SupportsProperty("HDR_OUTPUT_METADATA"))
+    CLog::Log(
+        LOGINFO,
+        "DVBridge: the connector has no HDR_OUTPUT_METADATA (an HDMI output that sends no HDR "
+        "metadata, as on Intel graphics before display version 10): native output keeps and "
+        "puts back the rest of the output state");
+  CLog::Log(LOGINFO, "DVBridge: output state captured, connector {} crtc {} plane {}: {}",
+            connector->GetId(), crtc->GetId(), plane->GetId(), m_snapshot.Summary());
+  CLog::Log(LOGINFO, "DVBridge: set for the transport (found -> set): {}", m_snapshot.Notable());
+  CLog::Log(LOGDEBUG,
+            "DVBridge: signalling of this capture: low-latency {}, HDMI 1.4b {}, HDR tunnel {}",
+            lowLatency, hdmi14b, hdr10Tunnel);
+  return true;
+}
+
+void COutputHandover::SaveRecord() const
+{
+  if (!OS::CSnapshot::WriteFile(StatePath(), m_snapshot.Serialize()))
+    CLog::Log(LOGWARNING,
+              "DVBridge: the transport could not be kept in {}: if Kodi ends during native output, "
+              "the next start puts the output right with the defaults of the driver only",
+              StatePath());
+}
+
+bool COutputHandover::NameModeInSignal(CDRMAtomic& drm)
+{
+  const auto* mode = drm.GetSelectedMode();
+  const unsigned int vic = mode ? Hdmi14bVic(*mode) : 0;
+  if (static_cast<int>(vic) == m_hdmi14bVic)
+    return true;
+  auto& blob = m_hdmi14bVsif[vic];
+  if (!blob.IsValid())
+  {
+    const auto payload = DV_HDMI14B::Payload(vic);
+    blob = CDRMPropertyBlob(drm.GetFileDescriptor(), payload.data(), payload.size());
+    if (!blob.IsValid())
+    {
+      CLog::Log(LOGERROR,
+                "DVBridge: the blob of the HDMI 1.4b vendor InfoFrame of HDMI_VIC {} "
+                "could not be made",
+                vic);
+      return false;
+    }
+  }
+  const auto signal = DV_HDMI14B::Payload(vic);
+  if (!m_snapshot.SetTransport(OS::Role::CONNECTOR, NVIDIA_VSIF, blob.Get(),
+                               std::vector<uint8_t>(signal.begin(), signal.end())))
+    return false;
+  CLog::Log(LOGDEBUG,
+            "DVBridge: the HDMI 1.4b vendor InfoFrame names HDMI_VIC {} (was {}), for the mode "
+            "{}x{} ({} kHz)",
+            vic, m_hdmi14bVic, mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0,
+            mode ? mode->clock : 0);
+  m_hdmi14bVic = static_cast<int>(vic);
+  return true;
+}
+
+bool COutputHandover::PutInRequest(CDRMAtomic& drm, bool handBack)
+{
+  std::array<CDRMObject*, 3> objects{};
+  if (!HoldsOutput() || m_drm != &drm || !ResolveOutput(drm, objects))
+    return false;
+  // The HDMI 1.4b vendor InfoFrame of nvidia-drm names the HDMI_VIC of the mode that this commit
+  // sets: it changes in the same commit as the mode (given back, it goes with the rest)
+  if (!handBack && m_hdmi14b && m_driver == Driver::NVIDIA_DRM && !NameModeInSignal(drm))
+    return false;
+  std::vector<OS::Change> changes;
+  if (handBack)
+  {
+    OS::CLibdrmKms kms(m_fd);
+    auto plan = m_snapshot.PlanRestore(kms);
+    if (!std::exchange(m_restoreSaid, true))
+    {
+      const auto join = [](const std::vector<OS::Change>& list)
+      {
+        std::string text;
+        for (const auto& change : list)
+          text += (text.empty() ? "" : ", ") + change.name;
+        return text.empty() ? std::string("none") : text;
+      };
+      const auto joinNames = [](const std::vector<std::string>& list)
+      {
+        std::string text;
+        for (const auto& name : list)
+          text += (text.empty() ? "" : ", ") + name;
+        return text;
+      };
+      CLog::Log(
+          LOGINFO,
+          "DVBridge: giving the output back: {} propert{} to set ({}), {} already as found{}{}{}{}",
+          plan.changes.size(), plan.changes.size() == 1 ? "y" : "ies", join(plan.changes),
+          plan.inPlace.size(),
+          plan.notRestorable.empty() ? ""
+                                     : ", not put back (a value that its property does "
+                                       "not take): ",
+          joinNames(plan.notRestorable),
+          plan.left.empty() ? "" : ", left as they are for now: ", joinNames(plan.left));
+    }
+    changes = std::move(plan.changes);
+  }
+  else
+    changes = m_snapshot.Transport();
+  bool allAdded = true;
+  for (const auto& change : changes)
+    allAdded = drm.AddProperty(objects[static_cast<int>(change.role)], change.name.c_str(),
+                               change.value) &&
+               allAdded;
+  return allAdded;
+}
+
+void COutputHandover::HandBackRefused(CDRMAtomic& drm)
+{
+  if (!HoldsOutput() || m_drm != &drm)
+    return;
+  OS::CLibdrmKms kms(m_fd);
+  const auto refusal = m_snapshot.NoteRefusal(kms);
+  m_restoreSaid = false;
+  const unsigned int refusals = m_snapshot.Refusals();
+  if (refusal.baseRefused)
+    CLog::Log(refusals <= 3 ? LOGWARNING : LOGDEBUG,
+              "DVBridge: the driver refuses what ends the transport by itself ({}): the display is "
+              "refusing the output (switched off?); asked again as it is",
+              std::strerror(refusal.baseError));
+  for (const auto& [label, error] : refusal.dropped)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the driver would not take the {} back ({}): it is left as it is, and the "
+              "rest goes on",
+              label, std::strerror(error));
+  if (refusals == OS::CSnapshot::ESSENTIAL_ONLY_AFTER)
+    CLog::Log(LOGWARNING,
+              "DVBridge: {} refusals of the commit that gives the output back in a row: only what "
+              "ends the transport is asked now",
+              refusals);
+}
+
+bool COutputHandover::HandBackTaken(CDRMAtomic& drm)
+{
+  if (!HoldsOutput())
+    return true;
+  std::array<CDRMObject*, 3> objects{};
+  ResolveOutput(drm, objects);
+  OS::CLibdrmKms kms(m_fd);
+  // What Kodi set in the same commit (the HDR metadata of the video that follows): by the value
+  // that the commit left in the properties that Kodi keeps
+  const OS::CSnapshot::Acceptable kodis = [&objects](const OS::Entry& entry)
+  {
+    CDRMObject* object = objects[static_cast<int>(entry.role)];
+    return object ? object->GetPropertyValue(entry.info.name) : std::nullopt;
+  };
+  const size_t total = m_snapshot.Entries().size();
+  auto bad = m_snapshot.Verify(kms, kodis);
+  const auto say = [](const std::vector<OS::CSnapshot::Mismatch>& list)
+  {
+    std::string text;
+    for (const auto& mismatch : list)
+      text += (text.empty() ? "" : "; ") + mismatch.label + ": found " + mismatch.got +
+              ", it was " + mismatch.want;
+    return text;
+  };
+  if (!bad.empty())
+  {
+    CLog::Log(LOGWARNING,
+              "DVBridge: after giving the output back, {} of {} properties are not as they were "
+              "found: {}",
+              bad.size(), total, say(bad));
+    const auto fixes = m_snapshot.Corrections(bad);
+    if (!fixes.empty())
+    {
+      int error = kms.Commit(fixes, true);
+      if (!error)
+        error = kms.Commit(fixes, false);
+      if (error)
+        CLog::Log(LOGWARNING, "DVBridge: setting them again was refused by the driver ({})",
+                  std::strerror(error));
+      else
+      {
+        for (const auto& change : fixes)
+          if (CDRMObject* object = objects[static_cast<int>(change.role)])
+            object->CachePropertyValue(change.property, change.value);
+        bad = m_snapshot.Verify(kms, kodis);
+        CLog::Log(LOGINFO, "DVBridge: set again: {} of {} still not as found", bad.size(),
+                  fixes.size());
+      }
+    }
+  }
+  const bool good = bad.empty();
+  if (good)
+    CLog::Log(LOGINFO, "DVBridge: the output is as it was found: {} properties read back", total);
+  else
+    CLog::Log(LOGWARNING, "DVBridge: could not be put back: {}", say(bad));
+  LetGo();
+  return good;
+}
+
+void COutputHandover::LetGo()
+{
+  if (!m_snapshot.Empty())
+  {
+    OS::CLibdrmKms kms(m_fd);
+    m_snapshot.Release(kms);
+    std::remove(StatePath().c_str());
+  }
+  m_fd = -1;
+  m_drm = nullptr;
+  m_transportOn = false;
+  m_driver = Driver::NONE;
+  m_lowLatency = false;
+  m_hdr10Tunnel = false;
+  m_hdmi14b = false;
+  m_hdmi14bVic = -1;
+  m_vsif.Reset();
+  for (auto& blob : m_hdmi14bVsif)
+    blob.Reset();
+  m_refusalNoticeDue = true;
+  m_linkFromScratch = false;
+  m_entryRestart = true;
+  m_entryNotice = true;
+  m_restoreSaid = false;
+  m_resolveSaid = false;
+}
