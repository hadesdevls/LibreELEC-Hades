@@ -0,0 +1,1195 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <unistd.h>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace OUTPUT_STATE
+{
+
+/*!
+ * \file OutputState.h
+ * \brief Hades: the state of the display output that native output takes, and gives back.
+ *
+ * Native Dolby Vision, and HDR over the tunnel, change the output of the GPU (the connector, the
+ * CRTC and the plane that Kodi uses) so that what is scanned out reaches the display bit for bit;
+ * when they end, the output has to be as it was found. This is the part of that which does not need
+ * libdrm, so that a test builds it on the host against a model of a kernel (IKms).
+ *
+ * How a KMS driver describes an object is what drives it (drm-kms.rst, "KMS Properties"): an
+ * object has properties, each with a type (range, signed range, enum, bitmask, blob, object), flags
+ * (immutable, atomic) and a value; a blob is a reference to bytes that the kernel keeps for as long
+ * as something refers to it. From that:
+ *
+ *  - Capture reads every property of the three objects that is not read-only, with the value the
+ *    kernel has, and a blob by its bytes, of which a copy is made (the blob that the driver
+ *    refers to may be gone once the transport replaces it). What the transport sets itself is
+ *    named by the caller (Spec) and is validated against the definition of the property. What is
+ *    left out is left out for a reason that is written down (Exclusion()).
+ *  - PlanRestore gives back only what is not as it was found, in the form of the changes of one
+ *    commit; a value that its own property would refuse (not in the enum, outside the range) is
+ *    never part of it.
+ *  - NoteRefusal tests the plan change by change (the driver's TEST_ONLY) when the commit of it was
+ *    refused, and leaves out what the driver would not take, with the error it gave.
+ *  - Verify reads the output back, and says which property is not as captured.
+ *  - Serialize and Parse are the form in which the transport that is on the output is kept outside
+ *    the process, for a Kodi that ends in the middle of it.
+ */
+
+enum class Role
+{
+  CONNECTOR,
+  CRTC,
+  PLANE,
+};
+
+inline const char* RoleName(Role role)
+{
+  switch (role)
+  {
+    case Role::CONNECTOR:
+      return "connector";
+    case Role::CRTC:
+      return "CRTC";
+    default:
+      return "plane";
+  }
+}
+
+enum class Kind
+{
+  RANGE,
+  SIGNED_RANGE,
+  ENUM,
+  BITMASK,
+  BLOB,
+  OBJECT,
+  OTHER,
+};
+
+//! One property of an object, as its definition says
+struct PropertyInfo
+{
+  uint32_t id{0};
+  std::string name;
+  Kind kind{Kind::OTHER};
+  bool immutable{false};
+  uint64_t min{0}; //!< RANGE
+  uint64_t max{0};
+  int64_t smin{0}; //!< SIGNED_RANGE
+  int64_t smax{0};
+  //! ENUM: the value of each name; BITMASK: the number of the bit of each name
+  std::vector<std::pair<std::string, uint64_t>> enums;
+
+  //! Whether the property takes this value, by what its definition states (a blob or an object has
+  //! no limit that it states)
+  bool Accepts(uint64_t value) const
+  {
+    switch (kind)
+    {
+      case Kind::RANGE:
+        return value >= min && value <= max;
+      case Kind::SIGNED_RANGE:
+        return static_cast<int64_t>(value) >= smin && static_cast<int64_t>(value) <= smax;
+      case Kind::ENUM:
+        return std::any_of(enums.begin(), enums.end(),
+                           [value](const auto& e) { return e.second == value; });
+      case Kind::BITMASK:
+      {
+        uint64_t all = 0;
+        for (const auto& e : enums)
+          if (e.second < 64)
+            all |= uint64_t{1} << e.second;
+        return (value & ~all) == 0;
+      }
+      default:
+        return true;
+    }
+  }
+
+  std::optional<uint64_t> EnumValue(std::string_view valueName) const
+  {
+    if (kind != Kind::ENUM)
+      return std::nullopt;
+    for (const auto& e : enums)
+      if (e.first == valueName)
+        return e.second;
+    return std::nullopt;
+  }
+};
+
+//! An object of the output with its properties
+struct ObjectInfo
+{
+  Role role{Role::CONNECTOR};
+  uint32_t id{0};
+  std::vector<PropertyInfo> properties;
+};
+
+//! One property to set, for a request or a commit
+struct Change
+{
+  Role role{Role::CONNECTOR};
+  uint32_t object{0};
+  uint32_t property{0};
+  std::string name;
+  uint64_t value{0};
+};
+
+//! What the kernel says and does; the driver of a GPU in production, a model on the host
+class IKms
+{
+public:
+  virtual ~IKms() = default;
+  //! The value of every property of an object, as the kernel has it now (property id to value)
+  virtual std::optional<std::map<uint32_t, uint64_t>> Values(Role role, uint32_t object) = 0;
+  virtual std::optional<std::vector<uint8_t>> BlobData(uint32_t blob) = 0;
+  //! A blob of its own; 0 when it could not be made
+  virtual uint32_t CreateBlob(const std::vector<uint8_t>& data) = 0;
+  virtual void DestroyBlob(uint32_t blob) = 0;
+  //! These changes alone, with a modeset allowed (testOnly: only asked, nothing changes). 0 when
+  //! the driver takes them, an errno when it does not
+  virtual int Commit(const std::vector<Change>& changes, bool testOnly) = 0;
+};
+
+//! What the transport sets on a property of an object, and what it means for the capture
+struct Spec
+{
+  enum class How
+  {
+    NUMBER, //!< the value \p number
+    ENUM_NAME, //!< the value that the enum property gives to \p enumName
+    BLOB, //!< the blob \p number (made and kept by the caller, which keeps it alive)
+  };
+  Role role{Role::CONNECTOR};
+  std::string name;
+  How how{How::NUMBER};
+  uint64_t number{0};
+  std::string enumName;
+  //! The capture fails when the property is not there, is read-only, or does not take the value
+  bool required{false};
+};
+
+//! What of the output is not the transport's to give back
+struct Policy
+{
+  //! The HDR metadata of the output is Kodi's, as it sets it for the stream: not captured
+  bool hdrMetadataIsKodis{false};
+};
+
+/*!
+ * \brief Why a property that is not read-only is left out of the capture, or nullptr when it is
+ *        not (a property that a Spec names is never left out)
+ *
+ * Every exclusion is a property that something else owns, that cannot be put back, or that is not
+ * a state:
+ */
+inline const char* Exclusion(Role role, std::string_view name, const Policy& policy)
+{
+  struct Row
+  {
+    Role role;
+    const char* name;
+    const char* why;
+  };
+  static const Row rows[] = {
+      {Role::CONNECTOR, "CRTC_ID", "the routing of the output: every modeset of Kodi sets it"},
+      {Role::CONNECTOR, "DPMS",
+       "legacy only: the atomic interface refuses it (the power is ACTIVE)"},
+      {Role::CONNECTOR, "link-status",
+       "the kernel sets it (Good); asking for Bad is a request to retrain the link"},
+      {Role::CONNECTOR, "Content Protection", "a state machine of the kernel (HDCP)"},
+      {Role::CONNECTOR, "HDCP Content Type", "part of the HDCP state machine of the kernel"},
+      {Role::CONNECTOR, "HDR10PLUS_VSIF",
+       "its owner is CHDR10PlusOutput, which clears it with its own end"},
+      {Role::CONNECTOR, "DVBRIDGE_REFUSED", "what the driver says of a refusal: not a setting"},
+      {Role::CONNECTOR, "DVBRIDGE_DV_CONVERTER",
+       "the driver writes it when the display is found: a value kept from before is stale"},
+      {Role::CONNECTOR, "NV_DUAL_MODE_TMDS",
+       "the driver writes it when the display is found: a value kept from before is stale"},
+      {Role::CRTC, "ACTIVE", "the power of the output: every commit of Kodi with a mode sets it"},
+      {Role::CRTC, "MODE_ID", "the mode: every commit of Kodi with a mode sets it"},
+      {Role::CRTC, "OUT_FENCE_PTR", "a pointer into the process: never kept or put back"},
+      {Role::PLANE, "FB_ID", "the buffer of the frame: every frame sets it"},
+      {Role::PLANE, "CRTC_ID", "the routing of the plane: every frame sets it"},
+      {Role::PLANE, "IN_FENCE_FD", "a file descriptor of the frame: never kept or put back"},
+      {Role::PLANE, "FB_DAMAGE_CLIPS", "the damage of the frame: every frame sets it"},
+      {Role::PLANE, "SRC_X", "the place of the buffer: every frame sets it"},
+      {Role::PLANE, "SRC_Y", "the place of the buffer: every frame sets it"},
+      {Role::PLANE, "SRC_W", "the place of the buffer: every frame sets it"},
+      {Role::PLANE, "SRC_H", "the place of the buffer: every frame sets it"},
+      {Role::PLANE, "CRTC_X", "the place on the output: every frame sets it"},
+      {Role::PLANE, "CRTC_Y", "the place on the output: every frame sets it"},
+      {Role::PLANE, "CRTC_W", "the place on the output: every frame sets it"},
+      {Role::PLANE, "CRTC_H", "the place on the output: every frame sets it"},
+  };
+  for (const auto& row : rows)
+    if (row.role == role && name == row.name)
+      return row.why;
+  if (policy.hdrMetadataIsKodis && role == Role::CONNECTOR && name == "HDR_OUTPUT_METADATA")
+    return "the metadata of the stream that the tunnel carries is Kodi's, as it sets it";
+  return nullptr;
+}
+
+//! Whether the output that the window system uses now is the one that was captured
+struct Identity
+{
+  bool same{false};
+  Role differs{Role::CONNECTOR}; //!< the first object that is another
+  uint32_t had{0};
+  uint32_t has{0};
+  int plane{-1}; //!< 0: the GUI plane is the captured one, 1: the video plane
+};
+
+/*!
+ * rief The connector and the CRTC must be those captured, by their ids (an output that was
+ *        unplugged and found again is the same output; another display is not), and the plane the
+ *        GUI plane or the video plane, whichever has the id that was captured: Kodi may change which
+ *        of them it uses for the output (the one plane of a driver that has no other), and the
+ *        capture is of the plane, not of the name Kodi gives it.
+ * \param had the ids captured: connector, CRTC, plane
+ */
+inline Identity SameOutput(
+    const uint32_t had[3], uint32_t connector, uint32_t crtc, uint32_t gui, uint32_t video)
+{
+  Identity out;
+  if (connector == 0 || connector != had[0])
+  {
+    out.differs = Role::CONNECTOR;
+    out.had = had[0];
+    out.has = connector;
+    return out;
+  }
+  if (crtc == 0 || crtc != had[1])
+  {
+    out.differs = Role::CRTC;
+    out.had = had[1];
+    out.has = crtc;
+    return out;
+  }
+  if (gui != 0 && gui == had[2])
+    out.plane = 0;
+  else if (video != 0 && video == had[2])
+    out.plane = 1;
+  else
+  {
+    out.differs = Role::PLANE;
+    out.had = had[2];
+    out.has = gui ? gui : video;
+    return out;
+  }
+  out.same = true;
+  return out;
+}
+
+//! A property of the output as it was when native output took it
+struct Entry
+{
+  Role role{Role::CONNECTOR};
+  uint32_t object{0};
+  PropertyInfo info;
+  uint64_t original{0}; //!< the value found (for a blob, its id then)
+  std::vector<uint8_t> data; //!< ... and the bytes of that blob
+  uint32_t copy{0}; //!< a blob of our own with those bytes: what is put back
+  bool restorable{true}; //!< its property takes the value found
+  bool leaveEmpty{false}; //!< it goes back empty (0), not to the value found
+  bool transport{false}; //!< the transport sets it
+  bool required{false};
+  uint64_t transportValue{0};
+  std::vector<uint8_t> transportData; //!< for a blob: its bytes
+
+  uint64_t Target() const { return leaveEmpty ? 0 : (copy ? copy : original); }
+  std::string Label() const { return std::string(RoleName(role)) + " \"" + info.name + "\""; }
+  std::string Key() const { return std::string(RoleName(role)) + "/" + info.name; }
+};
+
+//! How a value is said in the log
+inline std::string ValueText(const Entry& entry, uint64_t value)
+{
+  if (entry.info.kind == Kind::ENUM)
+    for (const auto& e : entry.info.enums)
+      if (e.second == value)
+        return e.first + " (" + std::to_string(value) + ")";
+  if (entry.info.kind == Kind::BLOB)
+  {
+    if (value == 0)
+      return "empty";
+    if (value == entry.original || value == entry.copy)
+      return "blob of " + std::to_string(entry.data.size()) + " bytes";
+    return "blob " + std::to_string(value);
+  }
+  if (entry.info.kind == Kind::SIGNED_RANGE)
+    return std::to_string(static_cast<int64_t>(value));
+  return std::to_string(value);
+}
+
+//! The state of an output that native output took, and what it takes to give it back
+class CSnapshot
+{
+public:
+  struct Result
+  {
+    bool ok{false};
+    std::string failure;
+  };
+
+  //! Captures the objects. On failure nothing is kept (and the blobs made are destroyed).
+  Result Capture(IKms& kms,
+                 const std::vector<ObjectInfo>& objects,
+                 const std::vector<Spec>& specs,
+                 const Policy& policy)
+  {
+    Release(kms);
+    Result result;
+    const auto fail = [&](std::string why)
+    {
+      Release(kms);
+      result.failure = std::move(why);
+      return result;
+    };
+    std::set<size_t> found;
+    for (const auto& object : objects)
+    {
+      const auto values = kms.Values(object.role, object.id);
+      if (!values)
+        return fail(std::string("the properties of the ") + RoleName(object.role) +
+                    " could not be read");
+      m_objects[static_cast<int>(object.role)] = object.id;
+      for (const auto& info : object.properties)
+      {
+        const Spec* spec = nullptr;
+        for (size_t i = 0; i < specs.size() && !spec; ++i)
+          if (specs[i].role == object.role && specs[i].name == info.name)
+          {
+            spec = &specs[i];
+            found.insert(i);
+          }
+        const std::string label =
+            std::string("the ") + RoleName(object.role) + " property \"" + info.name + "\" ";
+        if (info.immutable)
+        {
+          if (spec && spec->required)
+            return fail(label + "is read-only");
+          ++m_readOnly;
+          continue;
+        }
+        if (!spec && Exclusion(object.role, info.name, policy))
+        {
+          ++m_excluded;
+          continue;
+        }
+        const auto value = values->find(info.id);
+        if (value == values->end())
+        {
+          if (spec && spec->required)
+            return fail(label + "is not there");
+          continue;
+        }
+        Entry entry;
+        entry.role = object.role;
+        entry.object = object.id;
+        entry.info = info;
+        entry.original = value->second;
+        if (info.kind == Kind::BLOB && entry.original != 0)
+        {
+          const auto data = kms.BlobData(entry.original);
+          if (!data)
+          {
+            if (spec)
+              return fail(label + "could not be read (its blob)");
+            ++m_notKept;
+            continue;
+          }
+          entry.data = *data;
+          entry.copy = kms.CreateBlob(entry.data);
+          if (!entry.copy)
+          {
+            if (spec)
+              return fail(label + "could not be copied (its blob)");
+            ++m_notKept;
+            continue;
+          }
+        }
+        entry.restorable = info.kind == Kind::BLOB || info.Accepts(entry.original);
+        if (!entry.restorable)
+          ++m_notRestorable;
+        if (spec)
+        {
+          entry.required = spec->required;
+          bool taken = true;
+          switch (spec->how)
+          {
+            case Spec::How::ENUM_NAME:
+            {
+              const auto named = info.EnumValue(spec->enumName);
+              if (!named)
+                return fail(label + "has no value \"" + spec->enumName + "\"");
+              entry.transportValue = *named;
+              break;
+            }
+            case Spec::How::BLOB:
+            {
+              const auto data = kms.BlobData(spec->number);
+              if (!data)
+                return fail(label + "could not be given its blob (the signal)");
+              entry.transportValue = spec->number;
+              entry.transportData = *data;
+              break;
+            }
+            default:
+              if (!info.Accepts(spec->number))
+              {
+                if (spec->required)
+                  return fail(label + "does not take the value " + std::to_string(spec->number));
+                taken = false;
+              }
+              entry.transportValue = spec->number;
+              break;
+          }
+          entry.transport = taken;
+        }
+        m_entries.push_back(std::move(entry));
+      }
+    }
+    for (size_t i = 0; i < specs.size(); ++i)
+      if (specs[i].required && !found.count(i))
+        return fail(std::string("the ") + RoleName(specs[i].role) + " property \"" + specs[i].name +
+                    "\" is not there");
+    m_refusals = 0;
+    m_dropped.clear();
+    result.ok = true;
+    return result;
+  }
+
+  //! Destroys the blobs that the capture made, and forgets it
+  void Release(IKms& kms)
+  {
+    for (auto& entry : m_entries)
+      if (entry.copy)
+        kms.DestroyBlob(entry.copy);
+    m_entries.clear();
+    m_objects.clear();
+    m_readOnly = m_excluded = m_notKept = m_notRestorable = 0;
+    m_refusals = 0;
+    m_baseAccepted = true;
+    m_dropped.clear();
+  }
+
+  bool Empty() const { return m_entries.empty(); }
+  const std::vector<Entry>& Entries() const { return m_entries; }
+  uint32_t ObjectOf(Role role) const
+  {
+    const auto it = m_objects.find(static_cast<int>(role));
+    return it == m_objects.end() ? 0 : it->second;
+  }
+  const Entry* Find(Role role, std::string_view name) const
+  {
+    for (const auto& entry : m_entries)
+      if (entry.role == role && entry.info.name == name)
+        return &entry;
+    return nullptr;
+  }
+
+  //! The property goes back empty, not to the value found (a blob that was not the output's to
+  //! keep)
+  void LeaveEmpty(IKms& kms, Role role, std::string_view name)
+  {
+    for (auto& entry : m_entries)
+      if (entry.role == role && entry.info.name == name)
+      {
+        entry.leaveEmpty = true;
+        if (entry.copy)
+          kms.DestroyBlob(entry.copy);
+        entry.copy = 0;
+      }
+  }
+
+  //! What the transport sets, as the changes of a commit
+  std::vector<Change> Transport() const
+  {
+    std::vector<Change> changes;
+    for (const auto& entry : m_entries)
+      if (entry.transport)
+        changes.push_back(ChangeOf(entry, entry.transportValue));
+    return changes;
+  }
+
+  //! A value of the transport that changes while it is on (the InfoFrame that names a mode)
+  bool SetTransport(Role role,
+                    std::string_view name,
+                    uint64_t value,
+                    std::vector<uint8_t> data = {})
+  {
+    for (auto& entry : m_entries)
+      if (entry.role == role && entry.info.name == name && entry.transport)
+      {
+        entry.transportValue = value;
+        entry.transportData = std::move(data);
+        return true;
+      }
+    return false;
+  }
+
+  struct Plan
+  {
+    std::vector<Change> changes;
+    std::vector<std::string> inPlace; //!< already as found
+    std::vector<std::string> notRestorable; //!< its value is not one that its property takes
+    std::vector<std::string> left; //!< left for a later attempt (refused, or not essential)
+  };
+
+  //! After this many refusals of the commit that gives the output back, while the driver would take
+  //! what the transport sets by itself (so the display is not refusing everything), only what the
+  //! transport set is asked: the colour policy and the signals always go, in every attempt
+  static constexpr unsigned int ESSENTIAL_ONLY_AFTER = 5;
+
+  //! What gives the output back, of what is not as found
+  Plan PlanRestore(IKms& kms) const
+  {
+    Plan plan;
+    Reads reads;
+    for (const auto& entry : m_entries)
+    {
+      if (!entry.restorable)
+      {
+        plan.notRestorable.push_back(entry.Label());
+        continue;
+      }
+      if (m_dropped.count(entry.Key()) ||
+          (m_refusals >= ESSENTIAL_ONLY_AFTER && m_baseAccepted && !entry.transport))
+      {
+        // (still not as found: Verify() says so)
+        if (!Matches(kms, entry, Current(kms, reads, entry)))
+          plan.left.push_back(entry.Label());
+        continue;
+      }
+      if (Matches(kms, entry, Current(kms, reads, entry)))
+      {
+        plan.inPlace.push_back(entry.Label());
+        continue;
+      }
+      plan.changes.push_back(ChangeOf(entry, entry.Target()));
+    }
+    return plan;
+  }
+
+  struct Refusal
+  {
+    bool baseRefused{false}; //!< what the transport cannot do without was refused too
+    int baseError{0};
+    std::vector<std::pair<std::string, int>> dropped; //!< left out, with the error of the driver
+  };
+
+  /*!
+   * \brief The commit that gives the output back was refused: the plan is tested again, what the
+   *        transport set first (the signals that go off and the colour policy: never left out, so
+   *        that every attempt carries all of it) and each of the rest on top of what was taken;
+   *        what the driver would not take is left out from now on. When what the transport set is
+   *        refused by itself, nothing is left out: the display is refusing, and the commit is made
+   *        again as it is.
+   */
+  Refusal NoteRefusal(IKms& kms)
+  {
+    ++m_refusals;
+    m_baseAccepted = true;
+    Refusal refusal;
+    const auto saved = m_dropped;
+    m_dropped.clear();
+    const unsigned int refusals = m_refusals;
+    m_refusals = 0;
+    const Plan plan = PlanRestore(kms);
+    m_refusals = refusals;
+    std::vector<Change> taken;
+    std::vector<const Change*> rest;
+    for (const auto& change : plan.changes)
+    {
+      const Entry* entry = Find(change.role, change.name);
+      if (entry && entry->transport)
+        taken.push_back(change);
+      else
+        rest.push_back(&change);
+    }
+    if (!taken.empty())
+    {
+      const int error = kms.Commit(taken, true);
+      if (error)
+      {
+        m_dropped = saved;
+        m_baseAccepted = false;
+        refusal.baseRefused = true;
+        refusal.baseError = error;
+        return refusal;
+      }
+    }
+    for (const Change* change : rest)
+    {
+      auto trial = taken;
+      trial.push_back(*change);
+      const int error = kms.Commit(trial, true);
+      if (error)
+      {
+        const Entry* entry = Find(change->role, change->name);
+        m_dropped.insert(entry ? entry->Key() : change->name);
+        refusal.dropped.emplace_back(entry ? entry->Label() : change->name, error);
+      }
+      else
+        taken = std::move(trial);
+    }
+    return refusal;
+  }
+  unsigned int Refusals() const { return m_refusals; }
+
+  struct Mismatch
+  {
+    std::string label;
+    std::string want;
+    std::string got;
+    const Entry* entry{nullptr};
+  };
+
+  //! What another value of an entry is as good as the one found (what Kodi set in the same commit)
+  using Acceptable = std::function<std::optional<uint64_t>(const Entry&)>;
+
+  /*!
+   * \brief Reads the output back: every captured property that is not as it was found, nor as
+   *        \p acceptable says
+   */
+  std::vector<Mismatch> Verify(IKms& kms, const Acceptable& acceptable = {}) const
+  {
+    std::vector<Mismatch> bad;
+    Reads reads;
+    for (const auto& entry : m_entries)
+    {
+      if (!entry.restorable)
+        continue;
+      const auto now = Current(kms, reads, entry);
+      if (Matches(kms, entry, now))
+        continue;
+      if (now && acceptable)
+      {
+        const auto other = acceptable(entry);
+        if (other && Same(kms, entry, *now, *other))
+          continue;
+      }
+      bad.push_back({entry.Label(), ValueText(entry, entry.Target()),
+                     now ? ValueText(entry, *now) : std::string("unreadable"), &entry});
+    }
+    return bad;
+  }
+
+  //! The changes that would put right what Verify() found, but for what the driver refused before
+  std::vector<Change> Corrections(const std::vector<Mismatch>& bad) const
+  {
+    std::vector<Change> changes;
+    for (const auto& mismatch : bad)
+      if (mismatch.entry && !m_dropped.count(mismatch.entry->Key()))
+        changes.push_back(ChangeOf(*mismatch.entry, mismatch.entry->Target()));
+    return changes;
+  }
+
+  //! In the log: how many properties of each object, and what was left out
+  std::string Summary() const
+  {
+    unsigned int count[3] = {0, 0, 0};
+    unsigned int transport = 0;
+    for (const auto& entry : m_entries)
+    {
+      ++count[static_cast<int>(entry.role)];
+      transport += entry.transport ? 1 : 0;
+    }
+    return std::to_string(m_entries.size()) + " properties (" + std::to_string(count[0]) +
+           " of the connector, " + std::to_string(count[1]) + " of the CRTC, " +
+           std::to_string(count[2]) + " of the plane), " + std::to_string(transport) +
+           " set by the transport; " + std::to_string(m_readOnly) + " read-only, " +
+           std::to_string(m_excluded) + " left out as another's, " + std::to_string(m_notKept) +
+           " not readable, " + std::to_string(m_notRestorable) +
+           " with a value that its property does not take";
+  }
+
+  //! The captured value of each property that is not the default of nothing: the ones that a
+  //! person reads in a log
+  std::string Notable() const
+  {
+    std::string text;
+    for (const auto& entry : m_entries)
+    {
+      if (!entry.transport)
+        continue;
+      if (!text.empty())
+        text += "; ";
+      text += entry.info.name + " " + ValueText(entry, entry.original) + " -> " +
+              ValueText(entry, entry.transportValue);
+    }
+    return text;
+  }
+
+  // The form in which the transport on the output is kept outside the process
+
+  /*!
+   * \brief What is needed to put right, in another process, an output that a Kodi that ended
+   *        during native output left set: the objects, and for each property that the transport
+   *        sets what it was and what the transport made it
+   */
+  std::string Serialize() const
+  {
+    std::string text = "HADES-DV-STATE 1\n";
+    text += "objects " + std::to_string(ObjectOf(Role::CONNECTOR)) + " " +
+            std::to_string(ObjectOf(Role::CRTC)) + " " + std::to_string(ObjectOf(Role::PLANE)) +
+            "\n";
+    for (const auto& entry : m_entries)
+    {
+      if (!entry.transport || !entry.restorable)
+        continue;
+      const bool blob = entry.info.kind == Kind::BLOB;
+      text += std::string("P ") + std::to_string(static_cast<int>(entry.role)) + " " +
+              std::to_string(entry.object) + " " + std::to_string(entry.info.id) + " " +
+              Escape(entry.info.name) + " " + (blob ? "B" : "N") + " ";
+      if (blob)
+        text += (entry.leaveEmpty || entry.original == 0 ? std::string("-") : Hex(entry.data)) +
+                " " + Hex(entry.transportData) + "\n";
+      else
+        text += std::to_string(entry.original) + " " + std::to_string(entry.transportValue) + "\n";
+    }
+    text += "END " + Checksum(text) + "\n";
+    return text;
+  }
+
+  struct Leftover
+  {
+    uint32_t objects[3]{0, 0, 0};
+    struct Item
+    {
+      Role role{Role::CONNECTOR};
+      uint32_t object{0};
+      uint32_t property{0};
+      std::string name;
+      bool blob{false};
+      uint64_t original{0};
+      uint64_t transport{0};
+      std::vector<uint8_t> originalData; //!< blob: empty is an empty property
+      std::vector<uint8_t> transportData;
+    };
+    std::vector<Item> items;
+  };
+
+  //! What Serialize() wrote; nothing for a text that is not that (damaged, cut, or another version)
+  static std::optional<Leftover> Parse(std::string_view text)
+  {
+    const size_t end = text.rfind("END ");
+    if (end == std::string_view::npos || (end != 0 && text[end - 1] != '\n'))
+      return std::nullopt;
+    const std::string body(text.substr(0, end));
+    std::string sum(text.substr(end + 4));
+    while (!sum.empty() && (sum.back() == '\n' || sum.back() == '\r'))
+      sum.pop_back();
+    if (sum != Checksum(body))
+      return std::nullopt;
+    Leftover out;
+    bool header = false;
+    bool objects = false;
+    size_t at = 0;
+    while (at < body.size())
+    {
+      size_t eol = body.find('\n', at);
+      if (eol == std::string::npos)
+        return std::nullopt;
+      const auto words = Split(body.substr(at, eol - at));
+      at = eol + 1;
+      if (words.empty())
+        return std::nullopt;
+      if (!header)
+      {
+        if (words.size() != 2 || words[0] != "HADES-DV-STATE" || words[1] != "1")
+          return std::nullopt;
+        header = true;
+      }
+      else if (words[0] == "objects")
+      {
+        if (words.size() != 4)
+          return std::nullopt;
+        for (int i = 0; i < 3; ++i)
+          if (!Number(words[1 + i], out.objects[i]))
+            return std::nullopt;
+        objects = true;
+      }
+      else if (words[0] == "P")
+      {
+        if (words.size() != 8)
+          return std::nullopt;
+        Leftover::Item item;
+        uint32_t role = 0;
+        if (!Number(words[1], role) || role > 2 || !Number(words[2], item.object) ||
+            !Number(words[3], item.property))
+          return std::nullopt;
+        item.role = static_cast<Role>(role);
+        item.name = Unescape(words[4]);
+        if (words[5] == "B")
+        {
+          item.blob = true;
+          if (words[6] != "-" && !Unhex(words[6], item.originalData))
+            return std::nullopt;
+          if (!Unhex(words[7], item.transportData))
+            return std::nullopt;
+        }
+        else if (words[5] == "N")
+        {
+          if (!Number(words[6], item.original) || !Number(words[7], item.transport))
+            return std::nullopt;
+        }
+        else
+          return std::nullopt;
+        out.items.push_back(std::move(item));
+      }
+      else
+        return std::nullopt;
+    }
+    if (!header || !objects)
+      return std::nullopt;
+    return out;
+  }
+
+  struct LeftoverPlan
+  {
+    std::vector<Change> changes;
+    std::vector<uint32_t> blobs; //!< made for the changes: to be kept until they are committed
+    std::vector<std::string> skipped; //!< not as the transport left it: somebody else's now
+  };
+
+  /*!
+   * \brief The changes that give an output back that a Kodi left with the transport set: of each
+   *        property that is still what the transport made it, what it was. One that is not (the
+   *        user, or another Kodi, changed it since) is not touched.
+   */
+  static LeftoverPlan PlanLeftover(const Leftover& left, IKms& kms)
+  {
+    LeftoverPlan plan;
+    Reads reads;
+    for (const auto& item : left.items)
+    {
+      const std::string label = std::string(RoleName(item.role)) + " \"" + item.name + "\"";
+      const auto& values = Values(kms, reads, item.role, item.object);
+      std::optional<uint64_t> now;
+      if (values)
+      {
+        const auto found = values->find(item.property);
+        if (found != values->end())
+          now = found->second;
+      }
+      if (!now)
+      {
+        plan.skipped.push_back(label + " (unreadable)");
+        continue;
+      }
+      uint64_t target = item.original;
+      if (item.blob)
+      {
+        // (by the bytes: the id of the blob that the transport made is not one that was kept)
+        std::optional<std::vector<uint8_t>> bytes = std::vector<uint8_t>{};
+        if (*now != 0)
+          bytes = kms.BlobData(*now);
+        if (item.originalData == item.transportData)
+          continue;
+        if (!bytes || *bytes != item.transportData)
+        {
+          // not what the transport made it: if it is what it was, there is nothing to do; if not,
+          // it is somebody else's now
+          if (!bytes || *bytes != item.originalData)
+            plan.skipped.push_back(label);
+          continue;
+        }
+        target = 0;
+        if (!item.originalData.empty())
+        {
+          const uint32_t id = kms.CreateBlob(item.originalData);
+          if (!id)
+          {
+            plan.skipped.push_back(label + " (no blob)");
+            continue;
+          }
+          plan.blobs.push_back(id);
+          target = id;
+        }
+      }
+      else
+      {
+        if (item.original == item.transport)
+          continue;
+        if (*now != item.transport)
+        {
+          if (*now != item.original)
+            plan.skipped.push_back(label);
+          continue;
+        }
+      }
+      plan.changes.push_back({item.role, item.object, item.property, item.name, target});
+    }
+    return plan;
+  }
+
+  // Files: written whole or not at all
+
+  static bool WriteFile(const std::string& path, const std::string& text)
+  {
+    const std::string temporary = path + ".new";
+    std::FILE* file = std::fopen(temporary.c_str(), "wb");
+    if (!file)
+      return false;
+    bool good = std::fwrite(text.data(), 1, text.size(), file) == text.size();
+    good = std::fflush(file) == 0 && good;
+    good = ::fsync(fileno(file)) == 0 && good;
+    good = std::fclose(file) == 0 && good;
+    if (!good || std::rename(temporary.c_str(), path.c_str()) != 0)
+    {
+      std::remove(temporary.c_str());
+      return false;
+    }
+    return true;
+  }
+
+  static std::optional<std::string> ReadFile(const std::string& path)
+  {
+    std::FILE* file = std::fopen(path.c_str(), "rb");
+    if (!file)
+      return std::nullopt;
+    std::string text;
+    char buffer[4096];
+    size_t got;
+    while ((got = std::fread(buffer, 1, sizeof(buffer), file)) > 0)
+      text.append(buffer, got);
+    std::fclose(file);
+    return text;
+  }
+
+private:
+  using Reads = std::map<std::pair<int, uint32_t>, std::optional<std::map<uint32_t, uint64_t>>>;
+
+  static const std::optional<std::map<uint32_t, uint64_t>>& Values(IKms& kms,
+                                                                   Reads& reads,
+                                                                   Role role,
+                                                                   uint32_t object)
+  {
+    const auto key = std::make_pair(static_cast<int>(role), object);
+    auto it = reads.find(key);
+    if (it == reads.end())
+      it = reads.emplace(key, kms.Values(role, object)).first;
+    return it->second;
+  }
+
+  static std::optional<uint64_t> Current(IKms& kms, Reads& reads, const Entry& entry)
+  {
+    const auto& values = Values(kms, reads, entry.role, entry.object);
+    if (!values)
+      return std::nullopt;
+    const auto it = values->find(entry.info.id);
+    if (it == values->end())
+      return std::nullopt;
+    return it->second;
+  }
+
+  static Change ChangeOf(const Entry& entry, uint64_t value)
+  {
+    return {entry.role, entry.object, entry.info.id, entry.info.name, value};
+  }
+
+  //! The output has the value found (a blob by its bytes: another id with the same ones is the same)
+  static bool Matches(IKms& kms, const Entry& entry, const std::optional<uint64_t>& now)
+  {
+    if (!now)
+      return false;
+    if (entry.leaveEmpty)
+      return *now == 0;
+    if (entry.info.kind != Kind::BLOB)
+      return *now == entry.original;
+    if (entry.original == 0)
+      return *now == 0;
+    if (*now == entry.original || *now == entry.copy)
+      return true;
+    if (*now == 0)
+      return false;
+    const auto data = kms.BlobData(*now);
+    return data && *data == entry.data;
+  }
+
+  static bool Same(IKms& kms, const Entry& entry, uint64_t a, uint64_t b)
+  {
+    if (a == b)
+      return true;
+    if (entry.info.kind != Kind::BLOB || a == 0 || b == 0)
+      return false;
+    const auto left = kms.BlobData(a);
+    const auto right = kms.BlobData(b);
+    return left && right && *left == *right;
+  }
+
+  static std::string Escape(const std::string& name)
+  {
+    std::string out;
+    for (const char c : name)
+    {
+      if (c == ' ')
+        out += "%20";
+      else if (c == '%')
+        out += "%25";
+      else if (c == '\n')
+        out += "%0A";
+      else
+        out += c;
+    }
+    return out;
+  }
+
+  static std::string Unescape(const std::string& text)
+  {
+    std::string out;
+    for (size_t i = 0; i < text.size(); ++i)
+    {
+      if (text[i] == '%' && i + 2 < text.size())
+      {
+        const std::string code = text.substr(i + 1, 2);
+        if (code == "20")
+          out += ' ';
+        else if (code == "25")
+          out += '%';
+        else if (code == "0A")
+          out += '\n';
+        else
+          out += '%' + code;
+        i += 2;
+      }
+      else
+        out += text[i];
+    }
+    return out;
+  }
+
+  static std::string Hex(const std::vector<uint8_t>& data)
+  {
+    static const char digits[] = "0123456789abcdef";
+    if (data.empty())
+      return "-";
+    std::string out;
+    for (const uint8_t byte : data)
+    {
+      out += digits[byte >> 4];
+      out += digits[byte & 15];
+    }
+    return out;
+  }
+
+  static bool Unhex(const std::string& text, std::vector<uint8_t>& out)
+  {
+    out.clear();
+    if (text == "-")
+      return true;
+    if (text.size() % 2)
+      return false;
+    const auto digit = [](char c) -> int
+    {
+      if (c >= '0' && c <= '9')
+        return c - '0';
+      if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+      return -1;
+    };
+    for (size_t i = 0; i < text.size(); i += 2)
+    {
+      const int high = digit(text[i]);
+      const int low = digit(text[i + 1]);
+      if (high < 0 || low < 0)
+        return false;
+      out.push_back(static_cast<uint8_t>(high * 16 + low));
+    }
+    return true;
+  }
+
+  static std::string Checksum(const std::string& text)
+  {
+    uint32_t hash = 2166136261u;
+    for (const unsigned char c : text)
+    {
+      hash ^= c;
+      hash *= 16777619u;
+    }
+    char out[16];
+    std::snprintf(out, sizeof(out), "%08x", hash);
+    return out;
+  }
+
+  static std::vector<std::string> Split(const std::string& line)
+  {
+    std::vector<std::string> words;
+    size_t at = 0;
+    while (at <= line.size())
+    {
+      const size_t space = line.find(' ', at);
+      const size_t stop = space == std::string::npos ? line.size() : space;
+      if (stop > at)
+        words.push_back(line.substr(at, stop - at));
+      if (space == std::string::npos)
+        break;
+      at = space + 1;
+    }
+    return words;
+  }
+
+  template<typename T>
+  static bool Number(const std::string& text, T& out)
+  {
+    if (text.empty() || text.size() > 20)
+      return false;
+    uint64_t value = 0;
+    for (const char c : text)
+    {
+      if (c < '0' || c > '9')
+        return false;
+      const uint64_t digit = static_cast<uint64_t>(c - '0');
+      if (value > (UINT64_MAX - digit) / 10)
+        return false;
+      value = value * 10 + digit;
+    }
+    if (value > static_cast<uint64_t>(static_cast<T>(~T{0})))
+      return false;
+    out = static_cast<T>(value);
+    return true;
+  }
+
+  std::vector<Entry> m_entries;
+  std::map<int, uint32_t> m_objects;
+  unsigned int m_readOnly{0};
+  unsigned int m_excluded{0};
+  unsigned int m_notKept{0};
+  unsigned int m_notRestorable{0};
+  unsigned int m_refusals{0};
+  bool m_baseAccepted{true}; //!< the driver took what the transport set, at the last refusal
+  std::set<std::string> m_dropped;
+};
