-
-namespace
-{
-// Dolby VSIF payload: IEEE OUI 00-D0-46 followed by 24 content bytes with only the Dolby
-// Vision signal bit set (no low latency, backlight, auxiliary or L11 data). These are the
-// bytes the Intel backend's kernel packs (hdmi_dolby_vendor_infoframe_pack); nvidia-drm adds
-// the InfoFrame header (type 0x81, version 1, length 27) and the checksum.
-constexpr uint8_t DOLBY_VSIF_PAYLOAD[27] = {0x46, 0xD0, 0x00, 0x02};
-// Hades: ... and with the low-latency bit as well, for Dolby Vision Low-Latency (what the Amlogic HDMI
-// transmitter sends for it, hdmitx_set_vsif_pkt()); nvidia-drm takes it only with
-// NV_HDMI_DV_LOW_LATENCY, and NVKMS then sends the AVI InfoFrame of YCbCr 4:2:2 with it
-constexpr uint8_t DOLBY_VSIF_PAYLOAD_LOW_LATENCY[27] = {0x46, 0xD0, 0x00, 0x03};
-
-// 1.0 in the S31.32 fixed point of NV_PLANE_DEGAMMA_MULTIPLIER and NV_CRTC_REGAMMA_DIVISOR.
-constexpr uint64_t NV_S31_32_ONE = uint64_t{1} << 32;
-} // namespace
-
-namespace
-{
-std::atomic<int> g_converterUse{0};
-} // namespace
-
-void CDVBridgeState::SetConverterUse(DV_CONVERTER::Use use)
-{
-  g_converterUse = static_cast<int>(use);
-}
-
-std::optional<uint64_t> CDVBridgeState::ConverterVerdict(CDRMConnector& connector)
-{
-  if (connector.GetType() != "DP" || !connector.SupportsProperty(DV_CONVERTER::PROPERTY))
-    return std::nullopt;
-  // (read from the kernel: detect writes it when the display is found, after the connector was
-  // read)
-  return connector.ReadPropertyValue(DV_CONVERTER::PROPERTY);
-}
-
-DV_CONVERTER::Offer CDVBridgeState::ConverterOffer(CDRMConnector& connector)
-{
-  return DV_CONVERTER::Decide(DV_CONVERTER::UseOf(g_converterUse), connector.GetType() == "DP",
-                              ConverterVerdict(connector));
-}
-
-CDVBridgeState::Backend CDVBridgeState::GetBackend(CDRMConnector& connector)
-{
-  if (connector.SupportsProperty("DVBRIDGE_DV_STANDARD_LAB"))
-  {
-    // Hades: a DisplayPort connector that carries the tunnel through the converter of its board
-    // (DVBRIDGE_DV_CONVERTER): only where the policy offers it (a board where it was seen working,
-    // or the user asked for it). A kernel without that property: as before.
-    const auto offer = ConverterOffer(connector);
-    return !offer.applies || offer.offered ? Backend::KERNEL : Backend::NONE;
-  }
-  // Hades: an HDMI connector, or a dual-mode DisplayPort one that the card drives as HDMI now
-  // (NvidiaDualMode.h): its value is read from the kernel, which sets it on detection
-  const std::string type = connector.GetType();
-  const auto dualMode = type == "DP" && connector.SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY)
-                            ? connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY)
-                            : std::nullopt;
-  if (NVIDIA_DUAL_MODE::DrivenAsHdmi(type, dualMode) &&
-      connector.SupportsProperty("NV_HDMI_VSIF_METADATA") &&
-      connector.SupportsProperty("max bpc") && connector.SupportsProperty("dithering mode"))
-    return Backend::NVIDIA;
-  return Backend::NONE;
-}
-
-bool CDVBridgeState::SupportsLowLatency(CDRMConnector& connector)
-{
-  switch (GetBackend(connector))
-  {
-    case Backend::KERNEL:
-      return connector.SupportsProperty("DVBRIDGE_DV_LOW_LATENCY_LAB");
-    case Backend::NVIDIA:
-      return connector.SupportsProperty("NV_HDMI_DV_LOW_LATENCY");
-    default:
-      return false;
-  }
-}
-
-bool CDVBridgeState::SupportsHdr10Tunnel(CDRMConnector& connector)
-{
-  return GetBackend(connector) == Backend::KERNEL &&
-         connector.SupportsProperty("DVBRIDGE_HDR10_TUNNEL_LAB");
-}
-
-bool CDVBridgeState::SupportsHdmi14b(CDRMConnector& connector)
-{
-  switch (GetBackend(connector))
-  {
-    case Backend::KERNEL:
-      return connector.SupportsProperty("DVBRIDGE_DV_HDMI14B_LAB");
-    case Backend::NVIDIA:
