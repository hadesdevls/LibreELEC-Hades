 core_add_library(application)
diff --git a/xbmc/application/VideoPasses.h b/xbmc/application/VideoPasses.h
new file mode 100644
index 0000000..cf55385
--- /dev/null
+++ b/xbmc/application/VideoPasses.h
@@ -0,0 +1,81 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+/*!
+ * \brief Hades diagnostics: the passes of the interface loop that took more than two refresh
+ *        periods while a video plays (CApplication::CountPassForFluency())
+ *
+ * A video paces the loop by its frames: a pass takes one refresh, and the figures of the frames
+ * (the line of every 10 s of native Dolby Vision output) say when a frame came late. What they do
+ * not say is why the loop itself did not come back: in issue #4 (1.0 RC3, start-8) frames were
+ * shown 208 to 251 ms apart once a minute, with none of them presented late, while an add-on
+ * window was over the video, and the minute's line of the interface counted only passes with no
+ * video playing. Those passes are counted here, the longest one with how its time went
+ * (processing the messages, the frame move of the windows, the render) and the window and dialog
+ * on top, for that line.
+ *
+ * This class only counts; a test builds it on the host.
+ */
+struct CVideoPasses
+{
+  unsigned int count = 0;
+  long long longestMs = 0;
+  double periodMs = 0.0; //!< of the refresh of the longest
+  long long processMs = -1; //!< ... how its time went (-1: not known, a gap around a nested loop)
+  long long frameMoveMs = -1;
+  long long renderMs = -1;
+  std::string windows; //!< ... the windows on top (set by the caller when Count() says so)
+  int64_t atMs = 0; //!< ... when it ended, by the caller's clock
+
+  //! A pass of the loop while a video plays, of tookMs, at a refresh of periodMs, ending at nowMs.
+  //! \return it is the longest of them so far: the caller names the windows on top
+  bool Count(long long tookMs,
+             double refreshMs,
+             long long processedMs,
+             long long movedMs,
+             long long renderedMs,
+             int64_t nowMs)
+  {
+    if (!(refreshMs > 0.0) || static_cast<double>(tookMs) <= 2.0 * refreshMs)
+      return false;
+    ++count;
+    if (tookMs <= longestMs)
+      return false;
+    longestMs = tookMs;
+    periodMs = refreshMs;
+    processMs = processedMs;
+    frameMoveMs = movedMs;
+    renderMs = renderedMs;
+    atMs = nowMs;
+    return true;
+  }
+
+  //! "; with a video playing, ..." for the line of the minute ending at nowMs; empty without any
+  std::string Text(int64_t nowMs) const
+  {
+    if (count == 0)
+      return {};
+    char text[512];
+    char split[160] = "";
+    if (processMs >= 0)
+      std::snprintf(split, sizeof(split), ": process %lld, frame move %lld, render %lld", processMs,
+                    frameMoveMs, renderMs);
+    std::snprintf(text, sizeof(text),
+                  "; with a video playing, %u passes took more than two refresh periods (the "
+                  "longest %lld ms, of refreshes of %.1f ms, %.1f s before this line%s; window %s)",
+                  count, longestMs, periodMs, static_cast<double>(nowMs - atMs) / 1000.0, split,
+                  windows.empty() ? "none" : windows.c_str());
+    return text;
+  }
+};
