From 223b477845766255aeca39efb9f9ea8c876696b5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:33:44 +0000
Subject: [PATCH] [application] Count the passes of the interface that miss
 refreshes while a video plays

The line of the minute about the interface ("GUI: in the last 60 s, ...") counted only the
passes of the loop that took 50 ms or more with no video playing: a video paces the loop and its
frames have their own figures. Those figures say that a frame came late, not why the loop did not
come back. In issue #4 (1.0 RC3, start-8, an add-on window of PlexMod over a native Dolby Vision
video) frames were shown 208 to 251 ms apart once a minute, about 13 s after each of those lines,
with no presentation late and no call of the add-on into the interface longer than 10 ms, and the
log said nothing else of them.

Now a pass of more than two refresh periods while a video plays (a refresh that the loop itself
missed: 83 ms at 23.976 Hz, 33 ms at 60 Hz) is counted for that line too (CVideoPasses), the
longest with how its time went, from the times that EndPass() already takes, and the window and
dialog on top, with the names of their skin files (the windows of add-ons have ids that say
nothing). The line is written when there was any, and gains, for example (figures made up):

  ; with a video playing, 13 passes took more than two refresh periods (the longest 208 ms, of
  refreshes of 41.7 ms, 12.3 s before this line: process 2, frame move 1, render 205; window 12005
  (VideoFullScreen.xml) under dialog 13001 (script-plex-seek_dialog.xml))

A gap around a nested loop has no split, and says so by leaving it out. Nothing else of the loop
changes; IsPlayingVideo() is now asked for a pass over two refresh periods as well as for one of
50 ms or more.

Host test: videopasses_test, 8 checks; with the rule before (nothing counted with a video
playing), 5 fail. What blocks the loop once a minute will be read in the next diagnostic.
---
 xbmc/application/Application.cpp | 56 ++++++++++++++++++----
 xbmc/application/Application.h   |  9 +++-
 xbmc/application/CMakeLists.txt  |  3 +-
 xbmc/application/VideoPasses.h   | 81 ++++++++++++++++++++++++++++++++
 4 files changed, 137 insertions(+), 12 deletions(-)
 create mode 100644 xbmc/application/VideoPasses.h

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index b22e5e5..aa21f90 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -78,6 +78,7 @@
 #include "guilib/GUIControlProfiler.h"
 #include "guilib/GUIFontManager.h"
 #include "guilib/GUIUtils.h"
+#include "guilib/GUIWindow.h"
 #include "guilib/GUIWindowManager.h"
 #include "guilib/StereoscopicsManager.h"
 #include "guilib/TextureManager.h"
@@ -1693,19 +1694,31 @@ long long PassMs(std::chrono::steady_clock::duration d)
   return std::chrono::duration_cast<std::chrono::milliseconds>(d).count();
 }
 
-// the active window and, when there is one, the modal dialog on top of it
-std::string PassWindows()
+// the active window and, when there is one, the modal dialog on top of it (Hades: with the names
+// of their skin files, where asked: the windows of add-ons have ids that say nothing)
+std::string PassWindows(bool files = false)
 {
   const auto gui = CServiceBroker::GetGUI();
   if (!gui)
     return "none";
 
+  const auto name = [&](int id)
+  {
+    std::string text = std::to_string(id);
+    if (!files)
+      return text;
+    const CGUIWindow* window = gui->GetWindowManager().GetWindow(id);
+    std::string file = window ? window->GetProperty("xmlfile").asString() : std::string();
+    if (const auto slash = file.find_last_of('/'); slash != std::string::npos)
+      file = file.substr(slash + 1);
+    return file.empty() ? text : text + " (" + file + ")";
+  };
   const int window = gui->GetWindowManager().GetActiveWindow();
   const int top = gui->GetWindowManager().GetActiveWindowOrDialog();
   if (top == window)
-    return std::to_string(window);
+    return name(window);
 
-  return std::to_string(window) + " under dialog " + std::to_string(top);
+  return name(window) + " under dialog " + name(top);
 }
 } // unnamed namespace
 
@@ -1723,14 +1736,33 @@ bool CApplication::SlowPassReportDue(std::chrono::steady_clock::time_point now,
 }
 
 void CApplication::CountPassForFluency(std::chrono::steady_clock::time_point now,
-                                       std::chrono::steady_clock::duration took)
+                                       std::chrono::steady_clock::duration took,
+                                       long long processMs,
+                                       long long frameMoveMs,
+                                       long long renderMs)
 {
   ReportFluency(now);
-  if (took < FLUENCY_PASS)
+  // Hades: a pass of more than two refresh periods while a video plays is a refresh that the loop
+  // itself missed (the frames' own figures do not say why): counted, the longest with how its time
+  // went and the windows on top (CVideoPasses)
+  const auto winSystem = CServiceBroker::GetWinSystem();
+  const float fps = winSystem ? winSystem->GetGfxContext().GetFPS() : 0.0f;
+  const double periodMs = fps > 0.0f ? 1000.0 / static_cast<double>(fps) : 0.0;
+  const long long tookMs = PassMs(took);
+  if (took < FLUENCY_PASS && !(periodMs > 0.0 && tookMs > 2.0 * periodMs))
     return;
   // (the loop is paced by the frames of a video that plays: they have their own figures)
   const auto appPlayer = GetComponent<CApplicationPlayer>();
   if (appPlayer && appPlayer->IsPlayingVideo())
+  {
+    if (m_fluency.video.Count(tookMs, periodMs, processMs, frameMoveMs, renderMs,
+                              std::chrono::duration_cast<std::chrono::milliseconds>(
+                                  now.time_since_epoch())
+                                  .count()))
+      m_fluency.video.windows = PassWindows(true);
+    return;
+  }
+  if (took < FLUENCY_PASS)
     return;
 
   m_fluency.slowPasses++;
@@ -1759,16 +1791,19 @@ void CApplication::ReportFluency(std::chrono::steady_clock::time_point now)
     merged = m_pMsgHandling->m_motionsMerged;
     m_pMsgHandling->m_motionsMerged = 0;
   }
-  if (m_fluency.slowPasses > 0 || m_fluency.addonMs >= 250)
+  if (m_fluency.slowPasses > 0 || m_fluency.addonMs >= 250 || m_fluency.video.count > 0)
     CLog::Log(LOGINFO,
               "GUI: in the last {} s, {} passes took 50 ms or more with no video playing ({} of "
               "them 100 ms or more; the longest {} ms, window {}); the interface let add-ons call "
               "into it {} times, for {} ms (the longest {} ms); {} motions of the mouse were left "
-              "for the one that followed them",
+              "for the one that followed them{}",
               std::chrono::duration_cast<std::chrono::seconds>(now - m_fluency.since).count(),
               m_fluency.slowPasses, m_fluency.verySlowPasses, m_fluency.longestMs,
               m_fluency.longestWindows.empty() ? "none" : m_fluency.longestWindows,
-              m_fluency.addonEntries, m_fluency.addonMs, m_fluency.addonLongestMs, merged);
+              m_fluency.addonEntries, m_fluency.addonMs, m_fluency.addonLongestMs, merged,
+              m_fluency.video.Text(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       now.time_since_epoch())
+                                       .count()));
 
   m_fluency = {};
   m_fluency.since = now;
@@ -1829,7 +1864,8 @@ void CApplication::EndPass(std::chrono::steady_clock::time_point start,
     return;
   }
 
-  CountPassForFluency(now, now - start);
+  CountPassForFluency(now, now - start, PassMs(processed - start), PassMs(moved - processed),
+                      PassMs(now - moved));
   if (now - start < SLOW_PASS || !SlowPassReportDue(now, now - start))
     return;
 
