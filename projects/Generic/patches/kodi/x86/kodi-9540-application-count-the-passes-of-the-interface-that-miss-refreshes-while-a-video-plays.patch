   Fluency m_fluency;
+  //! (Hades: processMs, frameMoveMs, renderMs: how the time of the pass went, -1 when not known)
   void CountPassForFluency(std::chrono::steady_clock::time_point now,
-                           std::chrono::steady_clock::duration took);
+                           std::chrono::steady_clock::duration took,
+                           long long processMs = -1,
+                           long long frameMoveMs = -1,
+                           long long renderMs = -1);
   void ReportFluency(std::chrono::steady_clock::time_point now);
 
   std::unique_ptr<MUSIC_INFO::CMusicInfoScanner> m_musicInfoScanner;
diff --git a/xbmc/application/CMakeLists.txt b/xbmc/application/CMakeLists.txt
index 2c82365..39bdc5f 100644
--- a/xbmc/application/CMakeLists.txt
+++ b/xbmc/application/CMakeLists.txt
@@ -32,6 +32,7 @@ set(HEADERS AppEnvironment.h
             AppParamParser.h
