From bc88c2a5276b7d92b82b82954f9ce1495e321004 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:19:06 +0000
Subject: [PATCH] VideoPlayer: look for the Dolby Vision pair again when
 libavformat finds the codec of one of its tracks while reading

The Dolby Vision specification for transport streams carries the enhancement layer as a private
stream (stream type 0x06, with the DOVI registration and descriptor). libavformat groups the pair by
the descriptor, but knows a private stream as HEVC only once it has looked into its packets. With the
analysis that Kodi does before it plays a file that is at once (the FEL test stream, with and without
the HDMV registration of its enhancement track, is joined); an input that is not analysed before
playback has the track as data at first and as HEVC some packets later, and the pair was not looked
for again. Now, when a track of a Dolby Vision group becomes HEVC and no pair is joined, it is; the
base stream becomes Dolby Vision, and the packet that told it is not joined.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 37 +++++++++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  3 ++
 2 files changed, 40 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 7163dfd..f3d554c 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1287,6 +1287,35 @@ void CDVDDemuxFFmpeg::PromoteDolbyVision(CDemuxStream* stream,
   video->changes++;
 }
 
+void CDVDDemuxFFmpeg::FindLateDVLayers(int streamIdx)
+{
+  if (m_dvBaseIndex >= 0 || streamIdx < 0 ||
+      static_cast<unsigned int>(streamIdx) >= m_pFormatContext->nb_streams)
+    return;
+  bool grouped = false;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_stream_groups && !grouped; ++i)
+  {
+    const AVStreamGroup* group = m_pFormatContext->stream_groups[i];
+    if (!group || group->type != AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
+      continue;
+    for (unsigned int j = 0; j < group->nb_streams; ++j)
+      grouped |= group->streams[j] && group->streams[j]->index == streamIdx;
+  }
+  if (!grouped)
+    return;
+
+  FindDVLayers();
+  KeepDVLayers();
+  if (m_dvBaseIndex < 0 || !m_dvVerified)
+    return;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} of the Dolby Vision group is known as HEVC only now: "
+            "stream {} is Dolby Vision profile 7 from here on",
+            streamIdx, m_dvBaseIndex);
+  if (CDemuxStream* base = GetStream(m_dvBaseIndex))
+    PromoteDolbyVision(base, m_dvRecord, m_pFormatContext->streams[m_dvEnhancementIndex]->codecpar);
+}
+
 void CDVDDemuxFFmpeg::LogDVNotJoined(const char* reason)
 {
   if (!reason || !*reason)
@@ -1656,6 +1685,14 @@ DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
         stream->pPrivate != m_pFormatContext->streams[pPacket->iStreamId] ||
         stream->codec != m_pFormatContext->streams[pPacket->iStreamId]->codecpar->codec_id)
     {
+#ifdef HAVE_DVBRIDGE
+      // (a track of a Dolby Vision group whose codec libavformat finds only while reading: the
+      // enhancement layer of a transport stream as a private stream, where the input was not
+      // analysed before playback; that packet itself is not joined)
+      if (stream && stream->pPrivate == m_pFormatContext->streams[pPacket->iStreamId] &&
+          m_pFormatContext->streams[pPacket->iStreamId]->codecpar->codec_id == AV_CODEC_ID_HEVC)
+        FindLateDVLayers(pPacket->iStreamId);
+#endif
       // content has changed, or stream did not yet exist
       stream = AddStream(pPacket->iStreamId);
     }
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 4de6c46..f4fbfb5 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -208,6 +208,9 @@ protected:
   //! the stream is Dolby Vision from here on: VideoPlayer opens its codec again
   void PromoteDolbyVision(CDemuxStream* stream, const AVDOVIDecoderConfigurationRecord& record,
                           const AVCodecParameters* enhancement);
+  //! A track of a Dolby Vision group that libavformat knows as HEVC only now (its packets told
+  //! it): the pair is looked for again, and the base stream becomes Dolby Vision if it is one.
+  void FindLateDVLayers(int streamIdx);
   //! Two HEVC tracks, or a Dolby Vision group, that are not joined: why, and what each track is
   //! (codec, size, framing, Dolby Vision record, PID or track number), once for each line.
   void LogDVNotJoined(const char* reason);
-- 
