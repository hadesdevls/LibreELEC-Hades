+namespace KODI
+{
+namespace MULTIVIEW
+{
+
+/*!
+ * \brief Whether the second view of a 3D Blu-ray disc is wanted here
+ *
+ * What KODI::MULTIVIEW::DiscWanted() says of the setting for the two views
+ * (videoplayer.hades3dmvc), of what the display says that it takes, of the decoder of both
+ * views in this build and of the playback mode of stereoscopic videos. Asked when a disc is
+ * opened, for what it is told of the player and for its demuxer, and when the playlists of a
+ * disc are compared. It is false where Kodi does not run (a test of a part of it).
+ *
+ * \param[out] why what it is that does not hold, for the log (nullptr where it is wanted)
+ */
+bool DiscSecondViewWanted(const char** why = nullptr);
+
+} // namespace MULTIVIEW
+} // namespace KODI
