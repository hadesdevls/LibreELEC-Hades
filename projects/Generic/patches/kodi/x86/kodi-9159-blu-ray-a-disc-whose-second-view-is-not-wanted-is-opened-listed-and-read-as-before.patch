+
+#include "MultiviewDisc.h"
+
+#include "MultiviewChoice.h"
+#include "ServiceBroker.h"
+#include "guilib/StereoscopicsManager.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "windowing/WinSystem.h"
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+}
+
+bool KODI::MULTIVIEW::DiscSecondViewWanted(const char** why)
+{
+  if (why)
+    *why = nullptr;
+
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings)
+  {
+    if (why)
+      *why = "there are no settings";
+    return false;
+  }
+
+  const int setting = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_HADES3DMVC);
+  CWinSystemBase* const winSystem = CServiceBroker::GetWinSystem();
+
+  Player player;
+  player.allowed = Allowed(setting, winSystem && winSystem->HasStereoDisplay());
+  player.decoder = avcodec_find_decoder_by_name(DECODER_NAME) != nullptr;
+  player.mono = settings->GetInt(CSettings::SETTING_VIDEOPLAYER_STEREOSCOPICPLAYBACKMODE) ==
+                STEREOSCOPIC_PLAYBACK_MODE_MONO;
+
+  if (why && !DiscWanted(player))
+    *why = !player.allowed && setting == SETTING_AUTOMATIC
+               ? "the setting for the two views is on automatic and the display does not say "
+                 "that it takes 3D"
+           : !player.allowed ? "the setting for the two views is off"
+           : !player.decoder ? "this build has no decoder for the two views"
+                             : "stereoscopic videos are set to be played as 2D";
+  return DiscWanted(player);
+}
