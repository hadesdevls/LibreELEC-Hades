From a44fa6e03e20a43d82eca8a04cf2cc2cfe33fb92 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:32:49 +0000
Subject: [PATCH] player information: why the sound is decoded where the
 settings are the reason, and the composer of the RPU

Two more things that the pages say:

- the sound is decoded to PCM where it could be passed through: besides
  "Sync playback to display" (which was known), where passthrough is off in
  the audio settings, or off for the format of this stream (AC-3, E-AC-3,
  TrueHD, DTS, DTS-HD). A setting decides it, so a note says which and what
  to turn on (PassthroughOffWhy(), tested for each format in both
  directions). A sink that does not take the format is not guessed at: no
  reason is given then;
- the composer of the RPU: the bit depths of the base layer, the
  enhancement layer and the result, how each of the three components is
  mapped (polynomial, MMR or both) and whether the residual is dequantised
  (NLQ), read with the other levels once for each frame.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 12 +++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  9 ++++
 xbmc/utils/HadesPlayerInfo.h                  | 52 ++++++++++++++++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 25 +++++++++
 4 files changed, 96 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 7af5408..480548b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -124,6 +124,18 @@ void CDVBridgeGLES::LevelDetail::Read(const AVDOVIMetadata* parsed)
         break;
     }
   }
+  // the composer: how the picture of the base layer is built up to Dolby Vision
+  const AVDOVIRpuDataHeader* header = av_dovi_get_header(parsed);
+  const AVDOVIDataMapping* mapping = av_dovi_get_mapping(parsed);
+  composer = true;
+  blBits = header->bl_bit_depth;
+  elBits = header->el_bit_depth;
+  vdrBits = header->vdr_bit_depth;
+  for (int c = 0; c < 3; ++c)
+    for (int piece = 0; piece + 1 < mapping->curves[c].num_pivots && piece < AV_DOVI_MAX_PIECES;
+         ++piece)
+      curve[c] |= mapping->curves[c].mapping_idc[piece] == AV_DOVI_MAPPING_MMR ? 2u : 1u;
+  nlq = mapping->nlq_method_idc != AV_DOVI_NLQ_NONE && !header->disable_residual_flag;
 }
 
 namespace
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 7b0290f..f54f760 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -207,6 +207,15 @@ public:
     bool l255 = false;
     int l255Mode = 0;
     int l255Version = 0;
+    //! the composer: the bit depths of the base layer, the enhancement layer and the result, how each
+    //! component is mapped (a bit for polynomial pieces, another for MMR ones), and whether the
+    //! residual of the enhancement layer is dequantised (NLQ); composer false where the RPU has none
+    bool composer = false;
+    int blBits = 0;
+    int elBits = 0;
+    int vdrBits = 0;
+    unsigned int curve[3] = {};
+    bool nlq = false;
     //! Reads the blocks of a validated RPU; nothing where it is null
     void Read(const AVDOVIMetadata* parsed);
   };
diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 73eee25..a0c0ddb 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -126,6 +126,55 @@ inline std::string TodoForReason(const std::string& reason)
   return "";
 }
 
+/*!
+ * \brief What to do about a reason that the sound is decoded where it could be passed through: the
+ *        sync to the display (sync), passthrough turned off (passthrough) or turned off for this
+ *        format (codec); nothing where the reason is not one that a setting changes
+ */
+inline std::string AudioTodo(const std::string& why)
+{
+  if (why == "syncdisplay")
+    return "sync";
+  if (why == "passthroughoff")
+    return "passthrough";
+  if (why == "codecoff")
+    return "codec";
+  return "";
+}
+
+/*!
+ * \brief Whether the settings are why a stream that can be passed through is not: "passthroughoff"
+ *        (passthrough is off), "codecoff" (it is on, and off for the format of this stream), or
+ *        empty (it is on for it, or the format cannot be passed through)
+ * \param codec the codec of the stream as VideoPlayer.AudioCodec has it (ac3, eac3, truehd, dts,
+ *        dtshd_ma, ..., with the "_atmos" and "_x" kinds)
+ */
+inline std::string PassthroughOffWhy(const std::string& codec,
+                                     bool passthrough,
+                                     bool ac3,
+                                     bool eac3,
+                                     bool dts,
+                                     bool truehd,
+                                     bool dtshd)
+{
+  bool formatOn;
+  if (codec == "ac3")
+    formatOn = ac3;
+  else if (codec.compare(0, 4, "eac3") == 0)
+    formatOn = eac3;
+  else if (codec.compare(0, 6, "truehd") == 0)
+    formatOn = truehd;
+  else if (codec.compare(0, 5, "dtshd") == 0)
+    formatOn = dtshd;
+  else if (codec == "dts")
+    formatOn = dts;
+  else
+    return "";
+  if (!passthrough)
+    return "passthroughoff";
+  return formatOn ? "" : "codecoff";
+}
+
 /*!
  * \brief The heading of the overview page: what the display is told, and, where it is not what
  *        the file is, that it is not
@@ -186,8 +235,7 @@ inline std::vector<Note> Notes(const SummaryInput& in)
   if (in.felGap)
     note.push_back({Severity::NOTE, "fel_resync", "", ""});
   if (!in.audioWhy.empty())
-    note.push_back({Severity::NOTE, "audio_decoded", in.audioWhy,
-                    in.audioWhy == "syncdisplay" ? "sync" : ""});
+    note.push_back({Severity::NOTE, "audio_decoded", in.audioWhy, AudioTodo(in.audioWhy)});
   // what the display is told could not be read (the connector has no such property): the page
   // says so, for a video that is not a plain SDR one
   const bool hdr = dv || in.source == "hdr10" || in.source == "hdr10plus" || in.source == "hlg";
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 92e3ded..70811ca 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7536,6 +7536,15 @@ void PublishLevelValues(std::map<std::string, std::string>& info,
     info["hades.dv.l254"] = StringUtils::Format("{} / {}", lv.l254Mode, lv.l254Version);
   if (lv.l255)
     info["hades.dv.l255"] = StringUtils::Format("{} / {}", lv.l255Mode, lv.l255Version);
+  if (lv.composer)
+  {
+    // "10/10/12 bit · poly/MMR/MMR · NLQ": bits of the base layer, the enhancement layer and the
+    // result; how the three components are mapped
+    static const char* const kinds[] = {"-", "poly", "MMR", "poly+MMR"};
+    info["hades.dv.compose"] = StringUtils::Format(
+        "{}/{}/{} bit \xc2\xb7 {}/{}/{}{}", lv.blBits, lv.elBits, lv.vdrBits, kinds[lv.curve[0] & 3],
+        kinds[lv.curve[1] & 3], kinds[lv.curve[2] & 3], lv.nlq ? " \xc2\xb7 NLQ" : "");
+  }
   if (lv.count)
   {
     const std::vector<int> file(lv.levels, lv.levels + lv.count);
@@ -7702,6 +7711,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.lvfile", ""},
       {"hades.dv.lvused", ""},
       {"hades.dv.lvsent", ""},
+      {"hades.dv.compose", ""},
       {"hades.dv.trims", ""},
       {"hades.dv.origin", ""},
       {"hades.dv.hdr10plus", ""},
@@ -10072,6 +10082,21 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     AudioStreamInfo audio;
     player->GetAudioStreamInfo(player->GetAudioStream(), audio);
     info["hades.sum.abadge"] = AudioBadge(audio.codecName, bed, audio.channels);
+    // decoded to PCM where the settings are why (passthrough off, or off for this format): the sync
+    // to the display is told where the sink is opened
+    if (info["hades.audio.path"] == "pcm" && info["hades.audio.why"].empty())
+    {
+      const auto component = CServiceBroker::GetSettingsComponent();
+      const auto settings = component ? component->GetSettings() : nullptr;
+      if (settings)
+        info["hades.audio.why"] = PassthroughOffWhy(
+            audio.codecName, settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGH),
+            settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_AC3PASSTHROUGH),
+            settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_EAC3PASSTHROUGH),
+            settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_DTSPASSTHROUGH),
+            settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_TRUEHDPASSTHROUGH),
+            settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_DTSHDPASSTHROUGH));
+    }
     // the picture: its badge, from what the stream is, its Dolby Vision record and its layers
     const std::string hdrType = dv("hades.src.hdrtype");
     int profile = 0, level = 0, compat = 0;
