 tools/dvbridge/dvbridge_render.h              |  12 ++
 tools/dvbridge/dvbridge_source.c              | 195 ++++++++++++++++++
 tools/dvbridge/dvbridge_source.h              |  14 ++
 .../VideoRenderers/DVBridgeGLES.cpp           |   9 +-
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  12 +-
 xbmc/rendering/gles/GuiCompositeShaderGLES.h  |   5 +
 xbmc/settings/AdvancedSettings.cpp            |   2 +
 xbmc/settings/AdvancedSettings.h              |   5 +
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  42 +++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   6 +
 11 files changed, 328 insertions(+), 5 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b134e69..eef2333 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -136,6 +136,9 @@ struct dvbridge_renderer {
     unsigned drawn_gui;
     int drawn_w, drawn_h;
     uint64_t drawn_key;
+    /* Hades: the GUI white for the GUI read in place by the packer, for the next frame
+     * (dvbridge_render_set_gui_in_place()); 0: not asked */
+    float inplace_peak;
     /* Hades: Dolby Vision Low-Latency (dvbridge_render_set_low_latency()): the picture mapped to
      * ll_mapping, packed without metadata; ll_pattern, the test pattern in its place */
     bool low_latency, ll_pattern;
@@ -1092,8 +1095,13 @@ static bool render_source(struct dvbridge_renderer *r, const struct pl_frame *so
         /* Hades: in the tiles that what will be drawn over it may reach, where the caller said what
          * that is (dvbridge_render_set_drawn()) */
         dvbridge_source_drawn(r->source_packer, r->drawn_gui, r->drawn_w, r->drawn_h);
+        /* Hades: the GUI read in place by the packer where it is asked (then without the GUI
+         * cache, which reads the picture with the GUI composited over it) */
+        const float inplace = r->drawn_gui ? r->inplace_peak : 0.0f;
+        dvbridge_source_gui_in_place(r->source_packer, inplace);
         /* (Hades: and the key of its composite, for the GUI cache) */
-        dvbridge_source_drawn_key(r->source_packer, r->drawn_gui ? r->drawn_key : 0);
+        dvbridge_source_drawn_key(r->source_packer,
+                                  r->drawn_gui && inplace <= 0.0f ? r->drawn_key : 0);
         if (fbo)
             timer_begin(r, TIMER_PICTURE);
         ok = fbo && dvbridge_source_picture(r->source_packer, transport_params(r), r->pack_luma,
@@ -1356,8 +1364,10 @@ bool dvbridge_render_rgb(struct dvbridge_renderer *r, const struct pl_frame *sou
     }
     restore_gl_state(&state);
     /* Hades: what was to be drawn over this frame (dvbridge_render_set_drawn()) is this frame's */
-    if (r)
+    if (r) {
         r->drawn_gui = 0;
+        r->inplace_peak = 0.0f;
+    }
     return ok;
 }
 
@@ -1370,6 +1380,7 @@ bool dvbridge_render_packed(struct dvbridge_renderer *r, const struct pl_frame *
         /* (Hades: nothing is drawn over a frame drawn directly; a frame that is composed after
          * this one was refused is told again) */
         r->drawn_gui = 0;
+        r->inplace_peak = 0.0f;
     }
     /* (Hades: the converted transport's direct way also needs quad operations and a picture that
      * fills the raster, which render() checks: the source transport packs a picture drawn at its own
@@ -2439,6 +2450,22 @@ void dvbridge_render_set_drawn(struct dvbridge_renderer *r, unsigned gui, int wi
     r->drawn_h = height;
 }
 
+void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *r, float peak)
+{
+    if (r)
+        r->inplace_peak = peak;
+}
+
+bool dvbridge_render_gui_in_place(const struct dvbridge_renderer *r)
+{
+    return r && r->ready && r->source && dvbridge_source_gui_in_placed(r->source_packer);
+}
+
+bool dvbridge_render_can_gui_in_place(const struct dvbridge_renderer *r)
+{
+    return r && dvbridge_source_can_gui_in_place(r->source_packer);
+}
+
 void dvbridge_render_use_gui_cache(struct dvbridge_renderer *r, bool use)
 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 3e694c1..809dc7d 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -462,6 +462,18 @@ void dvbridge_render_set_window(struct dvbridge_renderer *renderer, pl_tex windo
 #define DVBRIDGE_RENDER_DRAWN 1
 void dvbridge_render_set_drawn(struct dvbridge_renderer *renderer, unsigned gui, int width,
                                int height);
+/* Hades: Kodi's GUI read in place by the packer of the source transport (dvbridge_source_gui_in_place()),
+ * for the next frame that is composed with a GUI of dvbridge_render_set_drawn(), as that call: peak, the
+ * GUI white of Kodi's composite in units of 10000 cd/m2 (0: not asked). It takes that frame out of the
+ * GUI cache. dvbridge_render_gui_in_place(): the prepared frame takes it, and the caller does not
+ * composite its GUI over the picture of dvbridge_render_texture() (dvbridge_render_complete() draws the
+ * picture whole and gives the composite back: false after that); its level 5 block is then made with
+ * every edge that has bars (DVBRIDGE_COVER_MEASURE cannot measure it). can: the packer has the program,
+ * and no frame packed so failed. */
+#define DVBRIDGE_RENDER_GUI_IN_PLACE 1
+void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *renderer, float peak);
+bool dvbridge_render_gui_in_place(const struct dvbridge_renderer *renderer);
+bool dvbridge_render_can_gui_in_place(const struct dvbridge_renderer *renderer);
 /* Hades: the GUI cache of the source transport (dvbridge_source_gui_cache(): the bytes of the
  * tiles where the GUI is opaque and did not change are copied from the frame before that packed
  * them, not converted again; the same bytes). Off until asked for; it takes the frames whose
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 937b4f8..4097950 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -698,6 +698,81 @@ static const char PACK[] =
     "    }\n"
     PACK_END;
 
+/* Hades: 4 with Kodi's GUI read in place (dvbridge_source_gui_in_place()). What CompositeGui()
+ * would composite over the picture of pass 3 is composited here, at each pixel, with the arithmetic
+ * of Kodi's composite where fragment shaders have highp (gles_gui_composite.frag, KODI_GUI_EXACT: the
+ * sRGB EOTF of IEC 61966-2-1, BT.709 to BT.2020 in linear light, the PQ signal of the GUI white, the
+ * coverage squared) and then the blend of its factors (colour a + picture (1 - a); alpha a + 2 (1 -
+ * a)), from the GUI texture sampled where the composite samples it: the pixel centre of the raster,
+ * its last row on the first row of the raster, with the texture's own (bilinear, clamped) filter.
+ * Nothing is written into a picture of 32-bit floats: pass 3 (16 bytes a pixel), the composite's
+ * read and write of it (32) and pass 4's read (16) are not made where the GUI reaches, nor the
+ * composite's fragments over the rest of the raster. Where the sample's alpha is 0, which the
+ * composite discards, the pixel is the transport's, as in PACK: the same bytes wherever the GUI
+ * covers nothing. Under the GUI the same expressions; a GPU may round its blend unit apart from
+ * them by a code here and there. Affine decoding only (profiles 7 and 8 in YCbCr): profile 5 and the
+ * IPT tunnel convert what is drawn over in pass 8, from the picture of pass 3. */
+#define GUI_COMPOSITE                                                                             \
+    "uniform highp sampler2D gui;\n"                                                              \
+    "uniform float gui_peak;\n" /* the GUI white in units of 10000 cd/m2 (Kodi's u_pqPeak) */      \
+    "const mat3 bt709_to_bt2020 = mat3(0.627403896, 0.069097289, 0.016391439,\n"                  \
+    "                                  0.329283038, 0.919540395, 0.088013308,\n"                  \
+    "                                  0.043313066, 0.011362316, 0.895595253);\n"                 \
+    "vec3 srgb_to_linear(vec3 c)\n"                                                               \
+    "{\n"                                                                                         \
+    "    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));\n"   \
+    "}\n"                                                                                         \
+    "vec3 gui_pq(vec3 l)\n"                                                                       \
+    "{\n"                                                                                         \
+    "    vec3 t = pow(max(l, vec3(0.0)), vec3(m1));\n"                                            \
+    "    return pow((c1 + c2 * t) / (1.0 + c3 * t), vec3(m2));\n"                                 \
+    "}\n"                                                                                         \
+    /* the pixel as the composite leaves it in the picture of pass 3 (alpha 2: nothing drawn) */  \
+    "vec4 composited(ivec2 p)\n"                                                                  \
+    "{\n"                                                                                         \
+    "    vec4 g = texture(gui, vec2((float(p.x) + 0.5) / 3840.0, 1.0 - (float(p.y) + 0.5) / 2160.0));\n" \
+    "    if (g.a == 0.0)\n"                                                                       \
+    "        return vec4(0.0, 0.0, 0.0, 2.0);\n"                                                  \
+    "    vec3 colour = gui_pq((bt709_to_bt2020 * srgb_to_linear(clamp(g.rgb, 0.0, 1.0))) * gui_peak);\n" \
+    "    float a = g.a * g.a;\n"                                                                  \
+    "    return vec4(colour * a + picture_at(p) * (1.0 - a), a + 2.0 * (1.0 - a));\n"             \
+    "}\n"
+
+static const char PACK_GUI[] =
+    "#version 300 es\n"
+    COMMON
+    GUI_COMPOSITE
+    "uniform int has_layer, code_max;\n"
+    "uniform mat3 ycc_inverse, lms_inverse;\n"
+    "uniform uvec4 metadata_words[128];\n"
+    "uniform uint packet_count;\n"
+    "uniform uint flip_y;\n"
+    "flat in int tile_drawn;\n" /* (TILED_VERTEX) the GUI may reach this tile */
+    "out vec4 color;\n"
+    PACK_PARITY
+    DRAWN_OVER_CODE
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    "    int ex = p.x & ~1;\n"
+    "    bool odd = (p.x & 1) != 0;\n"
+    "    vec4 own = vec4(0.0, 0.0, 0.0, 2.0), even = own;\n"
+    "    if (has_layer != 0 && tile_drawn != 0) {\n"
+    "        own = composited(p);\n"
+    "        even = odd ? composited(ivec2(ex, p.y)) : own;\n"
+    "    }\n"
+    "    uint y = own.a != 2.0 ? code(drawn_over(p, own).x) : luma_code(p);\n"
+    "    uint c;\n"
+    "    if (even.a != 2.0) {\n"
+    "        vec3 e = drawn_over(ivec2(ex, p.y), even);\n"
+    "        c = code(odd ? e.z : e.y);\n"
+    "    } else {\n"
+    "        uvec2 cc = pair_chroma(ex, p.y);\n"
+    "        c = odd ? cc.y : cc.x;\n"
+    "    }\n"
+    PACK_END;
+
 /* Hades: 4 for the frames whose pixels drawn over pass 8 converted (pairs_made; the other branch is
  * that of PACK). A program of its own, so that PACK stays what it was for every other frame, and
  * where this one or PAIRS cannot be made on a GPU, the packer is made without them, as before. */
@@ -1492,6 +1567,19 @@ struct dvbridge_source_packer {
     int rows_of[8];
     struct common_uniforms pc, cc; /* of pass 4 and of pass 3 */
     struct pack_uniforms u;
+    /* Hades: pass 4 with the GUI read in place (PACK_GUI, dvbridge_source_gui_in_place()): its program
+     * and uniforms (gc, g); the GUI white asked for the next picture (0: not asked); inplace: the last
+     * picture is to be packed so (pass 3 was not drawn, and nothing is to be composited over it), with
+     * the GUI texture, its size and white; inplace_failed: a pack so failed on this GPU (never again). */
+    GLuint pack_gui;
+    struct common_uniforms gc;
+    struct {
+        GLint has_layer, code_max, ycc_inverse, lms_inverse, words, count, flip, gui, peak, tiles,
+            mode, tflip;
+    } g;
+    float inplace_asked, inplace_peak;
+    bool inplace, inplace_failed;
+    unsigned inplace_gui;
     /* Hades: pass 8, its uniforms, the codes that it writes, and the form of pass 4 that takes them
      * (pack_pairs: its uniforms w, wc and those of w_more). Both programs or neither: where one of
      * them cannot be made, pass 4 is PACK alone and converts the pixels drawn over itself, as it did
@@ -1874,6 +1962,23 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
         }
         p->cache_usable = made && p->drawn_usable;
     }
+    /* Hades: pass 4 with the GUI read in place; without it the GUI is composited over the picture
+     * of pass 3, as before */
+    {
+        static const char *const pack_gui[] = {"has_layer", "code_max", "ycc_inverse",
+            "lms_inverse", "metadata_words", "packet_count", "flip_y", "gui", "gui_peak",
+            "drawn_tiles", "tiles_mode", "tiles_flip"};
+        _Static_assert(sizeof(p->g) == COUNT(pack_gui) * sizeof(GLint), "pack_gui uniforms");
+        p->pack_gui = link_with(TILED_VERTEX, PACK_GUI);
+        if (p->pack_gui && (!locate(p->pack_gui, &p->gc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+                            !locate(p->pack_gui, &p->g.has_layer, pack_gui, COUNT(pack_gui)))) {
+            glDeleteProgram(p->pack_gui);
+            p->pack_gui = 0;
+        }
+        if (!p->pack_gui)
+            fprintf(stderr, "DV source transport: the packing that reads the GUI in place could not "
+                            "be made; the GUI is composited over the picture, as before\n");
+    }
     /* Hades: pass 9; without it the pictures go out as composed */
     {
         static const char *const ipt[] = {"luma_plane", "chroma_rows", "code_scale", "ycc_src",
@@ -1928,6 +2033,7 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     glDeleteVertexArrays(1, &p->vao);
     glDeleteSamplers(1, &p->sampler);
     glDeleteProgram(p->pack);
+    glDeleteProgram(p->pack_gui);
     glDeleteProgram(p->picture);
     glDeleteProgram(p->resite);
     glDeleteProgram(p->rows);
@@ -2468,10 +2574,28 @@ void dvbridge_source_drawn(struct dvbridge_source_packer *p, unsigned gui, int w
     p->gui_h = known ? height : 0;
 }
 
+void dvbridge_source_gui_in_place(struct dvbridge_source_packer *p, float peak)
+{
+    if (p)
+        p->inplace_asked = isfinite(peak) && peak > 0.0f && peak <= 1.0f ? peak : 0.0f;
+}
+
+bool dvbridge_source_can_gui_in_place(const struct dvbridge_source_packer *p)
+{
+    return p && p->pack_gui && !p->inplace_failed;
+}
+
+bool dvbridge_source_gui_in_placed(const struct dvbridge_source_packer *p)
+{
+    return p && p->inplace;
+}
+
 void dvbridge_source_forget(struct dvbridge_source_packer *p)
 {
     if (!p)
         return;
+    p->inplace = false;
+    p->inplace_asked = 0.0f;
     p->gui = 0;
     p->tiles_mode = 0;
     p->picture_level = 0;
@@ -2785,10 +2909,14 @@ bool dvbridge_source_picture(struct dvbridge_source_packer *p,
                              int height, int x, int y, const unsigned margins[4],
                              unsigned framebuffer)
 {
+    /* Hades: (the GUI read in place is asked for this picture only) */
+    const float inplace = p ? p->inplace_asked : 0.0f;
     if (p) {
         p->tiles_mode = 0;
         p->picture_level = 0;
         p->cache_frame = false;
+        p->inplace = false;
+        p->inplace_asked = 0.0f;
     }
     if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !framebuffer ||
         !rows_of(p, width, height, x, y, margins)) {
@@ -2805,10 +2933,24 @@ bool dvbridge_source_picture(struct dvbridge_source_packer *p,
      * the picture's). Hades: with the GUI cache, not in the tiles copied from it (unless check). */
     bool cached = false;
     const int how = make_tiles(p, params, &cached) ? 1 : 0;
+    const unsigned gui = p->gui;
     p->gui = 0;
     p->drawn_key = 0;
     if (!how)
         dvbridge_gl_drain_errors();
+    /* Hades: Kodi's GUI read in place by pass 4 (PACK_GUI): pass 3 is not drawn, and the caller does
+     * not composite the GUI (dvbridge_source_gui_in_placed()); in the tiles that it may reach, or
+     * over the whole raster where they could not be made. Not with the GUI cache, which reads the
+     * picture of pass 3 with the GUI composited over it. */
+    if (inplace > 0.0f && gui && params->affine && !cached && p->pack_gui && !p->inplace_failed) {
+        if (!end(&state, true))
+            return false;
+        p->inplace = true;
+        p->inplace_gui = gui;
+        p->inplace_peak = inplace;
+        p->tiles_mode = how;
+        return true;
+    }
     int level = 0;
     const bool drawn = draw_picture(p, params, luma, width, height, x, y, margins, framebuffer,
                                     how && cached && !p->cache_check ? 4 : how, p->gui_level,
@@ -2839,6 +2981,24 @@ bool dvbridge_source_complete(struct dvbridge_source_packer *p,
                               int height, int x, int y, const unsigned margins[4],
                               unsigned framebuffer)
 {
+    /* Hades: a picture whose GUI was to be read in place has no pass 3 at all: drawn whole now,
+     * and the GUI is composited over it by the caller, as before (dvbridge_source_gui_in_placed()) */
+    if (p && p->inplace) {
+        p->inplace = false;
+        p->tiles_mode = 0;
+        p->picture_level = 0;
+        p->cache_frame = false;
+        if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !framebuffer ||
+            !rows_of(p, width, height, x, y, margins))
+            return false;
+        struct dvbridge_gl_state whole;
+        begin(p, &whole);
+        int level = 0;
+        const bool drawn = draw_picture(p, params, luma, width, height, x, y, margins, framebuffer,
+                                        0, p->gui_level, &level);
+        p->picture_level = drawn ? level : 0;
+        return end(&whole, drawn);
+    }
     if (!p || !p->tiles_mode)
         return true;
     if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !framebuffer ||
@@ -2953,6 +3113,38 @@ bool dvbridge_source_pack(struct dvbridge_source_packer *p,
         glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
     }
     p->pairs_missed = layer && !params->affine && !pairs;
+    /* Hades: the GUI read in place: composited here from its texture (PACK_GUI), in the tiles that it
+     * may reach (or over the whole raster where they were not made) */
+    if (p->inplace && layer && params->affine) {
+        p->inplace = false;
+        glViewport(0, 0, 3840, 2160);
+        glUseProgram(p->pack_gui);
+        set_common(p, &p->gc, params, luma, width, height, x, y, margins);
+        /* (the texture's own filter, as Kodi's composite samples it: no sampler object) */
+        glActiveTexture(GL_TEXTURE2);
+        glBindTexture(GL_TEXTURE_2D, p->inplace_gui);
+        glBindSampler(2, 0);
+        glUniform1i(p->g.gui, 2);
+        glUniform1f(p->g.peak, p->inplace_peak);
+        glUniform1i(p->g.has_layer, 1);
+        const int how = p->tiles_mode ? 3 : 0;
+        set_tiles(p, p->g.tiles, p->g.mode, how);
+        glUniform1i(p->g.tflip, flip_y);
+        set_inverse(p->g.ycc_inverse, p->g.lms_inverse, p->g.code_max, params);
+        glUniform4uiv(p->g.words, 128, packets);
+        glUniform1ui(p->g.count, count);
+        glUniform1ui(p->g.flip, flip_y);
+        glDrawArrays(GL_TRIANGLES, 0, tiled_vertices(how));
+        const bool ok = glGetError() == GL_NO_ERROR;
+        if (!ok) {
+            dvbridge_gl_drain_errors();
+            p->inplace_failed = true;
+            fprintf(stderr, "DV source transport: the packing that reads the GUI in place failed; the "
+                            "GUI is composited over the picture from the next frame on\n");
+        }
+        return end(&state, ok);
+    }
+    p->inplace = false;
     /* Hades: PACK_PAIRS with the codes of pass 8; PACK, as it was, for every other frame */
     const struct pack_uniforms *u = pairs ? &p->w : &p->u;
     glViewport(0, 0, 3840, 2160);
@@ -3151,6 +3343,9 @@ void dvbridge_source_gui_targets(const struct dvbridge_source_packer *p, unsigne
 bool dvbridge_source_cover(struct dvbridge_source_packer *p, unsigned layer,
                            const unsigned margins[4], unsigned *edges)
