+/* Hades: the largest sum of the magnitudes of the weights of a table (the bound of its sums) */
+static double table_gain(const int *table, int n)
+{
+    double most = 0.0;
+    for (int o = 0; o < n; ++o) {
+        const int *e = table + (size_t)o * DVBRIDGE_SOURCE_ENTRY;
+        double s = 0.0;
+        for (int i = 0; i < e[1]; ++i)
+            s += abs(e[2 + i]);
+        most = fmax(most, s);
+    }
+    return most;
+}
+
+/* Hades: the tables of a scaled picture, made where they are not those of the last one */
+static bool scale_tables(struct dvbridge_source_packer *p,
+                         const struct dvbridge_source_params *params, int sw, int sh,
+                         const float v[4], int width, int height)
+{
+    const float key[12] = {(float)sw, (float)sh, v[0], v[1], v[2], v[3], (float)width,
+                           (float)height, params->shift_x, params->shift_y,
+                           (float)DVBRIDGE_SOURCE_LUMA_LANCZOS,
+                           (float)DVBRIDGE_SOURCE_SCALE_CHROMA_LANCZOS};
+    if (p->scale_made && !memcmp(p->scale_of, key, sizeof(key)))
+        return true;
+    p->scale_made = false;
+    const int n[4] = {width, height, width / 2, height};
+    if (!p->table_data &&
+        !(p->table_data = malloc((size_t)(3840 + 2160 + 1920 + 2160) * DVBRIDGE_SOURCE_ENTRY *
+                                 sizeof(int))))
+        return false;
+    int *t[4];
+    t[0] = p->table_data;
+    for (int i = 1; i < 4; ++i)
+        t[i] = t[i - 1] + (size_t)n[i - 1] * DVBRIDGE_SOURCE_ENTRY;
+    const double sx = ((double)v[2] - (double)v[0]) / width;
+    const double sy = ((double)v[3] - (double)v[1]) / height;
+    if (!dvbridge_source_axis(t[0], n[0], v[0], sx, 1, 0.0, 1, DVBRIDGE_SOURCE_LUMA_LANCZOS) ||
+        !dvbridge_source_axis(t[1], n[1], v[1], sy, 1, 0.0, 1, DVBRIDGE_SOURCE_LUMA_LANCZOS) ||
+        !dvbridge_source_axis(t[2], n[2], v[0], sx, 2, 0.5 + (double)params->shift_x, 2,
+                              DVBRIDGE_SOURCE_SCALE_CHROMA_LANCZOS) ||
+        !dvbridge_source_axis(t[3], n[3], v[1], sy, 1, 0.5 + (double)params->shift_y, 2,
+                              DVBRIDGE_SOURCE_SCALE_CHROMA_LANCZOS))
+        return false;
+    /* the sums stay within 31 bits: of the columns over codes, and of the rows over the columns
+     * (2 fractional bits) */
+    for (int k = 0; k < 2; ++k) {
+        const double cols = table_gain(t[k ? 2 : 0], n[k ? 2 : 0]);
+        const double rows = table_gain(t[k ? 3 : 1], n[k ? 3 : 1]);
+        const double read = params->code_max * cols / (1 << (DVBRIDGE_SOURCE_WEIGHT_BITS -
+                                                             DVBRIDGE_SOURCE_FRAC_BITS)) + 1.0;
+        if (params->code_max * cols >= 2147483647.0 || rows * read >= 2147483647.0)
+            return false;
+    }
+    /* (the pixel store as it is by default, from no buffer, for the uploads; then as it was) */
+    GLint unpack_buffer = 0, row_length = 0, skip_rows = 0, skip_pixels = 0;
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+    glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+    glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    bool ok = true;
+    for (int i = 0; i < 4 && ok; ++i) {
+        if (!p->tables[i] || p->table_rows[i] != n[i]) {
+            glDeleteTextures(1, &p->tables[i]);
+            glGenTextures(1, &p->tables[i]);
+            glBindTexture(GL_TEXTURE_2D, p->tables[i]);
+            glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA32I, DVBRIDGE_SOURCE_ENTRY / 4, n[i]);
+            p->table_rows[i] = n[i];
+        }
+        glBindTexture(GL_TEXTURE_2D, p->tables[i]);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, DVBRIDGE_SOURCE_ENTRY / 4, n[i], GL_RGBA_INTEGER,
+                        GL_INT, t[i]);
+        ok = glGetError() == GL_NO_ERROR;
+        if (!ok)
+            p->table_rows[i] = 0;
+    }
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack_buffer);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_UNPACK_SKIP_ROWS, skip_rows);
+    glPixelStorei(GL_UNPACK_SKIP_PIXELS, skip_pixels);
+    if (!ok)
+        return false;
+    memcpy(p->scale_of, key, sizeof(key));
+    p->scale_made = true;
+    return true;
+}
