+bool dvbridge_source_can_scale(const struct dvbridge_source_packer *p)
+{
+    return p && p->scale_columns;
+}
+
+bool dvbridge_source_scale(struct dvbridge_source_packer *p,
+                           const struct dvbridge_source_params *params, unsigned luma,
+                           unsigned chroma, int sw, int sh, const float view[4], int width,
+                           int height, int x, int y, const unsigned margins[4],
+                           unsigned *scaled_luma)
+{
+    if (scaled_luma)
+        *scaled_luma = 0;
+    if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !chroma ||
+        !scaled_luma || !p->scale_columns ||
+        !dvbridge_source_scale_covers(sw, sh, view, width, height, NULL))
+        return false;
+    p->rows_made = false;
+    const float v[4] = {view ? view[0] : 0.0f, view ? view[1] : 0.0f,
+                        view ? view[2] : (float)sw, view ? view[3] : (float)sh};
+    const int scw = (sw + 1) / 2, sch = (sh + 1) / 2;
+    struct dvbridge_gl_state state;
+    begin(p, &state);
+    if (!scale_tables(p, params, sw, sh, v, width, height))
+        return end(&state, false);
+    /* 1s: the columns of the luma (width x sh) and of the chroma (width / 2 x the chroma's rows) */
+    const float code_scale = (float)(1 << params->bits);
+    for (int k = 0; k < 2; ++k) {
+        struct texture *into = k ? &p->chroma_columns : &p->luma_columns;
+        if (!target(into, k ? GL_RG32F : GL_R32F, k ? width / 2 : width, k ? sch : sh))
+            return end(&state, false);
+        glUseProgram(p->scale_columns);
+        bind(p, 0, k ? chroma : luma);
+        bind(p, 1, p->tables[k ? 2 : 0]);
+        glUniform1i(p->sc_cols.plane, 0);
+        glUniform1i(p->sc_cols.table, 1);
+        glUniform1f(p->sc_cols.code_scale, code_scale);
+        glUniform1i(p->sc_cols.last_col, (k ? scw : sw) - 1);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    /* 2s: the luma at its size */
+    if (!target(&p->scaled_luma, GL_R32F, width, height))
+        return end(&state, false);
+    glUseProgram(p->scale_luma_rows);
+    bind(p, 0, p->luma_columns.texture);
+    bind(p, 1, p->tables[1]);
+    glUniform1i(p->sc_luma.columns, 0);
+    glUniform1i(p->sc_luma.table, 1);
+    glUniform1f(p->sc_luma.code_scale, code_scale);
+    glUniform1i(p->sc_luma.last_row, sh - 1);
+    glUniform1i(p->sc_luma.code_max, params->code_max);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    /* 3s: the rows of 4:2:2 chroma, two to a texel as pass 2 makes them */
+    if (!target(&p->chroma, GL_RGBA16UI, width / 2, (height + 1) / 2))
+        return end(&state, false);
+    glUseProgram(p->scale_chroma_rows);
+    bind(p, 0, p->chroma_columns.texture);
+    bind(p, 1, p->tables[3]);
+    glUniform1i(p->sc_chroma.columns, 0);
+    glUniform1i(p->sc_chroma.table, 1);
+    glUniform1i(p->sc_chroma.last_row, sch - 1);
+    glUniform1i(p->sc_chroma.code_max, params->code_max);
+    glUniform1i(p->sc_chroma.rows, height);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    const bool ok = end(&state, true);
+    if (ok) {
+        const int key[8] = {width, height, x, y, (int)margins[0], (int)margins[1],
+                            (int)margins[2], (int)margins[3]};
+        memcpy(p->rows_of, key, sizeof(key));
+        p->rows_made = true;
+        *scaled_luma = p->scaled_luma.texture;
+    }
+    return ok;
+}
