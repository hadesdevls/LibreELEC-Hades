From f01b74b79e041d87bf2a8dedf6eeaa45a5f44d1a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:11:48 +0000
Subject: [PATCH] windowing/gbm: frames with GUI elements over a single-layer
 Dolby Vision picture step to the converted transport where they do not keep
 up

CDVGuiLevel measured the frames with GUI elements of profile 5 pictures
only. The bridge now has a level 1 for pictures in YCbCr without an
enhancement residual (HDR10 and HDR10+ sent as Dolby Vision, profile 8,
profile 7 whose layer is not drawn): their frames with GUI elements go out
converted, which costs less than the source transport for those frames on
a small GPU (on a software renderer 20 % less with subtitles-sized GUI, 33 %
less with the player information over half of the picture). Those frames
are measured, raised and brought back by the same rule as before (two
windows behind on both GPU time and missed refreshes; left at once where
it saves nothing; back down when the source transport would fit with room
to spare), only where Kodi chooses the fidelity. The frames without GUI
elements and every GPU that keeps up are as before.

The log says it in its own words: a warning when those frames go out
converted, and a line when they go back to the source transport.
---
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  3 ++
 xbmc/windowing/gbm/DVGuiLevel.h               | 14 +++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 48 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  6 ++-
 4 files changed, 63 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 102dffa..60754b8 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -151,6 +151,9 @@ public:
   //! ... the highest the prepared frame can be drawn at (0: it is not one of those), the one the
   //! last frame packed was drawn at, and the targets of levels 1 and 2 freed
   int GuiTop() const { return dvbridge_render_gui_top(m_renderer); }
+  //! Hades: ... the prepared frame's level 1 is that of a picture in YCbCr without an enhancement
+  //! residual: a frame with GUI elements sent converted (not in the source transport)
+  bool GuiConverts() const { return dvbridge_render_gui_converts(m_renderer); }
   int GuiDrawn() const { return dvbridge_render_gui_drawn(m_renderer); }
   void ReleaseGui() { dvbridge_render_gui_release(m_renderer); }
   //! Hades: the renderer composes the picture as ETSI GS CCM 001 does (its step-down levels are
diff --git a/xbmc/windowing/gbm/DVGuiLevel.h b/xbmc/windowing/gbm/DVGuiLevel.h
index 50013ce..eb30e36 100644
--- a/xbmc/windowing/gbm/DVGuiLevel.h
+++ b/xbmc/windowing/gbm/DVGuiLevel.h
@@ -35,8 +35,20 @@ namespace GBM
  * is measured not to keep up either, level 2, the simplified rounding (a code apart in values
  * close to a half, under what is drawn over only).
  *
+ * Hades: a picture that the source transport carries in YCbCr without the residual of an
+ * enhancement layer drawn (HDR10 and HDR10+ sent as Dolby Vision, profile 8, profile 7 whose layer
+ * is not drawn), at its own size and not in the IPT tunnel, has level 1 only: its frames with GUI
+ * elements go out converted to BT.2020 (dvbridge_render_gui_converts()). Those frames cost more in
+ * the source transport than converted (the picture the GUI is drawn over, and what is drawn over it
+ * converted back), the frames without GUI elements less: only the frames with GUI elements go so,
+ * and only where they are measured not to keep up, as here. What it changes and saves, measured: see
+ * gui_converts() in dvbridge_render.c (on ten HDR10+ pictures the luma the same in 99.95 % of the
+ * pixels; with a panel over half of the raster 34 % less time on a software renderer). A picture
+ * with the residual drawn steps those frames down its ladder instead (CDVGuiStep).
+ *
  * The frames measured are those with GUI elements whose picture the bridge can draw above level 0
- * (profile 5 in the source transport, the programs of a level made: top), while the video plays.
+ * (profile 5 in the source transport, the programs of a level made; Hades: or a picture of level 1
+ * only, above: top), while the video plays.
  * Each picture format (CDVFrameLoad) at each fidelity step-down level (CDVStepDown: the frames of
  * another level are other work) and refresh period has a state of its own, at level 0 until its
  * frames are found not to keep up. Its frames are measured in windows of WINDOW frames of one
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 37dc56a..f38debc 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5526,7 +5526,7 @@ int CWinSystemGbmGLESContext::RenderHdr10Tunnel(const CDVBridgeGLES::Layer& laye
               "turned off only if they are not");
   }
   m_dvFrame = m_dvBridge && m_dvBridge->PrepareTunnel(layer, plain, view);
-  DVGpuTimerTag(false, false, false, false, false, 0, true, false, 0, false, 0, false, false);
+  DVGpuTimerTag(false, false, false, false, false, 0, true, false, 0, false, 0, false, false, false);
   if (!m_dvFrame)
   {
     m_dvShown = {};
@@ -6562,8 +6562,9 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
     // for its own, CDVStepDown::Measured())
     const unsigned int ladder = m_dvBridge->StepLevels(CDVFrameLoad::WithResidual(load));
     // Hades: a frame with GUI elements whose picture the bridge can draw above level 0 (as it was
-    // drawn: profile 5 in the source transport), while the video plays, is one that the decision
-    // of the level of the conversion under the GUI takes (CDVGuiLevel)
+    // drawn: profile 5 in the source transport; or a picture in YCbCr without an enhancement
+    // residual, whose level 1 sends such frames converted), while the video plays, is one that the
+    // decision of the level of the conversion under the GUI takes (CDVGuiLevel)
     const int guiTop = m_dvBridge->GuiTop();
     const bool guiMeasured = guiFrame && !still && guiTop > 0;
     // Hades: ... and one whose ladder, as it was drawn, has a level below that of the frames without
@@ -6574,7 +6575,8 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
     if (guiFrame && still)
       m_dvGuiStep.Interrupted();
     DVGpuTimerTag(measured, pathMeasured, direct, m_dvBridge->Direct(), layered, load, !still,
-                  comparing, ladder, guiMeasured, guiTop, !guiElements && !still, guiStepMeasured);
+                  comparing, ladder, guiMeasured, guiTop, m_dvBridge->GuiConverts(),
+                  !guiElements && !still, guiStepMeasured);
     // what its presentation is told with (DVStepPresented())
     m_dvStepFrame.valid = true;
     m_dvStepFrame.layered = layered;
@@ -8629,7 +8631,8 @@ void CWinSystemGbmGLESContext::DVGpuTimerPaced(CDVStepDown::Pace pace)
 
 void CWinSystemGbmGLESContext::DVGuiLevelReport(const CDVGuiLevel::Step& step,
                                                 uint64_t format,
-                                                int level)
+                                                int level,
+                                                bool converts)
 {
   using Change = CDVGuiLevel::Change;
   if (step.change == Change::NONE)
@@ -8650,6 +8653,37 @@ void CWinSystemGbmGLESContext::DVGuiLevelReport(const CDVGuiLevel::Step& step,
                      step.to == 0 && !m_dvGuiLevel.Above();
   if (freed && m_dvBridge)
     m_dvBridge->ReleaseGui();
+  // Hades: a picture in YCbCr without an enhancement residual (HDR10 and HDR10+ sent as Dolby
+  // Vision, profile 8, profile 7 without its layer drawn): its only level sends the frames with GUI
+  // elements converted to BT.2020 instead of in the source transport (the frames without them stay
+  // in the source transport)
+  if (converts)
+  {
+    if (step.change == Change::NO_GAIN)
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over a picture without an enhancement residual: "
+                "sent converted they took {:.1f} ms of {:.1f} ms, not less than in the source "
+                "transport ({:.1f} ms): it saves nothing, and they go out in the source transport "
+                "again ({}; {})",
+                step.averageMs, step.periodMs, step.estimateMs, which, window);
+    else if (step.change == Change::UP)
+      // (a warning: from here those frames are not the source transport's bytes)
+      CLog::Log(LOGWARNING,
+                "DVBridge: frames with GUI elements over a picture without an enhancement residual: "
+                "{:.1f} ms of {:.1f} ms in the source transport, they go out converted to BT.2020 "
+                "from now on (the luma the same but in a few pixels, the chroma rows between the "
+                "sited ones interpolated by another filter); the frames without GUI elements are as "
+                "before ({}; {})",
+                step.averageMs, step.periodMs, which, window);
+    else
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over a picture without an enhancement residual: "
+                "{:.1f} ms of {:.1f} ms in the source transport (by what they take converted now, "
+                "{:.1f} ms), which fits with room to spare: they go out in the source transport "
+                "again ({}; {})",
+                step.estimateMs, step.periodMs, step.averageMs, which, window);
+    return;
+  }
   if (step.change == Change::NO_GAIN)
     CLog::Log(
         LOGINFO,
@@ -8865,6 +8899,7 @@ void CWinSystemGbmGLESContext::DVGpuTimerTag(bool measured,
                                              unsigned int ladder,
                                              bool gui,
                                              int top,
+                                             bool converts,
                                              bool guiFree,
                                              bool guiStep)
 {
@@ -8875,6 +8910,7 @@ void CWinSystemGbmGLESContext::DVGpuTimerTag(bool measured,
     timer.base = m_dvStepBase;
     timer.guiStep = guiStep;
     timer.top = top;
+    timer.converts = converts;
     timer.drawn = 0; // (told once it is packed)
     timer.paced = false; // (... and once it is presented)
     timer.guiFree = guiFree;
@@ -9100,7 +9136,7 @@ void CWinSystemGbmGLESContext::DVGpuTimerCollect()
         DVGuiLevelReport(m_dvGuiLevel.Measured(timer.load, timer.base, timer.drawn, timer.top, ms,
                                                DVRefreshPeriodMs(),
                                                timer.paced ? timer.pace : DVStepPace()),
-                         timer.load, timer.base);
+                         timer.load, timer.base, timer.converts);
       else if (timer.guiFree)
         m_dvGuiLevel.Plain();
       // Hades: ... and the step-down level of the frames with GUI elements (CDVGuiStep), of the
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 0529642..1cf8f1f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -1103,6 +1103,9 @@ private:
     //! is one that the decision of that level takes ...
     bool gui = false;
     int top = 0;
