@@ -1445,6 +1448,7 @@ private:
                      unsigned int ladder,
                      bool gui,
                      int top,
+                     bool converts,
                      bool guiFree,
                      bool guiStep);
   //! A frame was drawn whose GPU time is not known (see CDVPathChoice::Untimed())
