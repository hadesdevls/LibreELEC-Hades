From 05585ca90c119c43e5819018c0fa7b630a3c8be4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:20:11 +0000
Subject: [PATCH] VideoRenderers: choose the mode of a native Dolby Vision file
 opened over another

Without the adjustment of the refresh rate, the 3840x2160 mode that native
Dolby Vision output needs (with the GUI at 1080p) is chosen by VideoPlayer
for a first file, and by CRenderManager::UpdateResolution() for a file
opened while another plays. UpdateResolution() only runs when something
triggers it: a renderer configured again, or a picture with another frame
rate or another progressive verdict. A native file opened over one whose
pictures have the same parameters and rate (a Dolby Vision video that
could not go out natively, or an HDR10 one of the same size) keeps the
renderer and triggers nothing: it stayed in the mode of the GUI, on the
ordinary output. The renderer itself only asks for native output in a mode
that can carry it, so nothing else moved it either.

Configure() now also triggers the choice for the first picture of such a
file: no mode chosen for it yet (NewFile()), and its stream goes out
natively (ModeChosenAgain(), in a header of its own so that a host test
drives it). The branch without the adjustment marks the mode of the file
as chosen, as the one with it does, so that this happens once per file. It
is the same flag that a change of frame rate sets, taken by the thread
that draws: nothing is asked synchronously of the thread of the player,
the deadlock that choosing the mode in UpdateResolution() avoids. With the
adjustment, the choice is the one Kodi makes for that stream. A file that
does not go out natively triggers nothing new.
---
 .../VideoRenderers/FileModeChoice.h           | 39 +++++++++++++++++++
 .../VideoRenderers/RenderManager.cpp          |  9 ++++-
 2 files changed, 46 insertions(+), 2 deletions(-)
 create mode 100644 xbmc/cores/VideoPlayer/VideoRenderers/FileModeChoice.h

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/FileModeChoice.h b/xbmc/cores/VideoPlayer/VideoRenderers/FileModeChoice.h
new file mode 100644
index 0000000..59d3a5c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/FileModeChoice.h
@@ -0,0 +1,39 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace VIDEOPLAYER
+{
+
+/*!
+ * \brief Hades: whether a picture that keeps the renderer (its parameters are those of the
+ *        picture before) has the display mode chosen again (CRenderManager::Configure(), which
+ *        then triggers CRenderManager::UpdateResolution())
+ *
+ * As in Kodi, when its frame rate or whether it is progressive changed. And the first picture of a
+ * file opened while another one played (no mode chosen for it yet: CRenderManager::NewFile()),
+ * whose video stream goes out natively in Dolby Vision (nativeDVIntent, from SetNativeDVStream()):
+ * its pictures can have every parameter of the ones before (a Dolby Vision video that could not go
+ * out natively, or an HDR10 one of the same size and rate), so nothing chose the mode that native
+ * output needs (3840x2160 where the refresh rate is not adjusted, as UpdateResolution() picks it),
+ * and the video stayed on the ordinary output. Only a flag is set, as for a change of frame rate:
+ * the choice is made by the thread that draws, never asked for synchronously from the thread of
+ * the player (that could hang Kodi if playback were stopped at that moment).
+ *
+ * This function only decides.
+ */
+inline bool ModeChosenAgain(bool fpsChanged,
+                            bool progressiveChanged,
+                            bool fileModeChosen,
+                            int nativeDVIntent)
+{
+  return fpsChanged || progressiveChanged || (!fileModeChosen && nativeDVIntent > 0);
+}
+
+} // namespace VIDEOPLAYER
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 2e4fb2d..4579ff8 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -10,6 +10,7 @@
 
 /* to use the same as player */
 #include "../VideoPlayer/DVDClock.h"
+#include "FileModeChoice.h"
 #include "RenderFactory.h"
 #include "RenderFlags.h"
 #include "ServiceBroker.h"
@@ -120,8 +121,10 @@ bool CRenderManager::Configure(const VideoPicture& picture,
         m_dvdClock.SetVsyncAdjust(0);
         m_lateframes = -1;
       }
-      // the trigger last, once everything the new choice reads is set
-      if (UpdateProgressive(progressive) || fpsChanged)
+      // the trigger last, once everything the new choice reads is set (Hades: also for the first
+      // picture of a file opened over another whose stream goes out natively: ModeChosenAgain())
+      if (VIDEOPLAYER::ModeChosenAgain(fpsChanged, UpdateProgressive(progressive),
+                                       m_fileModeChosen, m_nativeDVIntent))
         m_bTriggerUpdateResolution = true;
       return true;
     }
@@ -913,6 +916,8 @@ void CRenderManager::UpdateResolution()
         const int intent = m_nativeDVIntent;
         if (intent < 0)
           return;
+        // (Hades: the mode of this file is chosen, as with the adjustment: ModeChosenAgain())
+        m_fileModeChosen = true;
         auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
         const RESOLUTION res = CResolutionUtils::ChooseDVResolutionWithoutAdjustment(intent > 0);
         if (res != gfx.GetVideoResolution())
