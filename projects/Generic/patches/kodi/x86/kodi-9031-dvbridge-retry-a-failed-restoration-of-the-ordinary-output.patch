From aef3204a0a3b966ef3738b4249662999a10982b5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:08:56 +0000
Subject: [PATCH] dvbridge: retry a failed restoration of the ordinary output

When the commit restoring the ordinary output failed (a display that
refused the modeset while it was off, for example), the output stayed
captured: PresentRender() kept to the Dolby Vision branch and presented
nothing but prepared Dolby Vision frames, so the GUI stayed behind the
last Dolby Vision frame, with the Dolby Vision signalling on, until the
next video, mode switch or restart.

When the output is captured but no renderer draws natively any more,
PresentRender() now retries the restoration once a second. A renderer
whose teardown could not restore the output says so, and the retry
takes over; so does a renderer whose native setup failed in Configure()
(SetVideoOutput() or BeginDVBridge() refused), which went on claiming
to draw natively and kept the retry from ever starting.

A renderer configured while the output was still captured set its
output state (HDR signalling, GUI compositing, output depth) before
the late restoration wrote back the state from before Dolby Vision:
it is configured again after such a restoration. While the display
keeps refusing, the failure is logged for the first three attempts and
then once a minute.
---
 .../VideoRenderers/LinuxRendererGLES.cpp      | 18 ++++++++++--
 .../VideoRenderers/LinuxRendererGLES.h        |  2 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 28 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  6 ++++
 4 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 9a981e3..434f13c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -216,7 +216,10 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
       CServiceBroker::GetWinSystem());
   if (dvWindow)
+  {
+    m_dvOutputRestores = dvWindow->DVOutputRestores();
     dvWindow->SetDVBridgeRendererNative(WantsDVBridge(picture));
+  }
 #endif
 
   if (!CServiceBroker::GetWinSystem()->SetVideoOutput(&picture))
@@ -227,6 +230,8 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     if (dvWindow && WantsDVBridge(picture))
     {
       dvWindow->DisableNativeDVOutput("the Dolby Vision output mode could not be set");
+      // No renderer draws natively: a captured output is restored by the window system.
+      dvWindow->SetDVBridgeRendererNative(false);
       if (!CServiceBroker::GetWinSystem()->SetVideoOutput(&picture))
         CLog::Log(LOGWARNING, "LinuxRendererGLES::Configure: SetVideoOutput failed");
     }
@@ -249,7 +254,10 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     // unconfigured, which froze the picture while the audio went on.
     CLog::Log(LOGERROR, "DVBridge: native output initialization rejected; using the ordinary output");
     if (window)
+    {
       window->DisableNativeDVOutput("native output initialization was rejected");
+      window->SetDVBridgeRendererNative(false);
+    }
     m_dvRequested = false;
     m_hdrFboActive = false;
     // Replace the 8-bit transport configuration with the ordinary one.
@@ -303,10 +311,14 @@ bool CLinuxRendererGLES::DVBridgeConfigChanged(const VideoPicture& picture) cons
   // moves a stream whose metadata stays missing to the ordinary output by changing its hdrType.
   // The conditions change only with the mode, the view settings or a failure (which disables
   // native output for the session), so this cannot alternate from picture to picture.
-  if (!m_dvRequested)
-    return WantsDVBridge(picture);
   const auto* window =
       dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  // The output was restored after an earlier failure, over the output state that this renderer
+  // had set (HDR signalling, GUI compositing, output depth): it is configured again.
+  if (window && window->DVOutputRestores() != m_dvOutputRestores)
+    return true;
+  if (!m_dvRequested)
+    return WantsDVBridge(picture);
   return !window || !window->SupportsNativeDVOutput() || !CanRenderDVBridge(picture);
 }
 #endif
@@ -1159,7 +1171,9 @@ void CLinuxRendererGLES::UnInit()
         CServiceBroker::GetWinSystem());
     if (window && !window->EndDVBridge())
     {
+      // The window system retries the restoration once no renderer draws natively.
       CLog::Log(LOGERROR, "DVBridge: cannot restore output during renderer teardown");
+      window->SetDVBridgeRendererNative(false);
       return;
     }
     m_dvRequested = false;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
index fa1a1fd..4f150f7 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.h
@@ -144,6 +144,8 @@ protected:
   //! Native output starts or ends with this picture: the renderer is configured again.
   bool DVBridgeConfigChanged(const VideoPicture& picture) const;
   std::atomic<bool> m_dvRequested{false};
+  //! The window system's count of late output restorations when this renderer was configured.
+  unsigned int m_dvOutputRestores = 0;
 #endif
   virtual void AfterRenderHook(int idx) {}
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6f541bc..e20a200 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -232,6 +232,27 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     }
     else
     {
+      // The output is still captured but no renderer draws natively any more: its restoration
+      // failed (a commit refused while the display was off, for example). Try again once a
+      // second, so that the GUI comes back instead of staying behind the last Dolby Vision frame.
+      if (!m_dvRendererNative)
+      {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - m_dvRestoreRetry >= std::chrono::seconds(1))
+        {
+          m_dvRestoreRetry = now;
+          const unsigned int failures = m_dvRestoreFailures;
+          if (EndDVBridge())
+          {
+            CLog::Log(LOGINFO, "DVBridge: ordinary output restored after {} failed attempts",
+                      failures);
+            // A renderer configured meanwhile set its output state before this restoration.
+            ++m_dvOutputRestores;
+            SendDisplayReset();
+            return;
+          }
+        }
+      }
       // Nothing was prepared this pass (before the first frame, after a flush): no buffer swap
       // paces the loop, so wait as the ordinary path does when nothing is rendered.
       KODI::TIME::Sleep(10ms);
@@ -772,10 +793,15 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
     glFinish();
     if (!m_eglContext.TrySwapBuffers() || !FlipDVBridgePage(m_dvState, true))
     {
-      CLog::Log(LOGERROR, "DVBridge: output restoration failed; retaining scanout state");
+      // Retried once a second while the display refuses it (switched off): logged sparingly.
+      if (++m_dvRestoreFailures <= 3 || m_dvRestoreFailures % 60 == 0)
+        CLog::Log(LOGERROR,
+                  "DVBridge: output restoration failed; retaining scanout state ({} in a row)",
+                  m_dvRestoreFailures);
       glEnable(GL_SCISSOR_TEST);
       return false;
     }
+    m_dvRestoreFailures = 0;
     // The next back buffer can still hold a packed transport frame: the ordinary output starts
     // from black, never from tunnel pixels. Kodi's GUI relies on the scissor test staying on
     // (only ResetRenderSystem() and ApplyStateBlock() turn it on again).
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index f25518d..45e7f8b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -63,6 +63,9 @@ public:
   //! Whether the configured video renderer draws its pictures natively; set before its output
   //! transition. Only then does the output use the 8-bit transport format.
   void SetDVBridgeRendererNative(bool native) { m_dvRendererNative = native; }
+  //! Restorations of the ordinary output that succeeded only on a later retry, over the output
+  //! state of a renderer configured meanwhile: such a renderer is configured again.
+  unsigned int DVOutputRestores() const { return m_dvOutputRestores; }
   bool BeginDVBridge();
   void SetDVBridgeOverlays(bool visible) { m_dvOverlays = visible; }
   bool DVBridgeCaptured() const { return m_dvState.Captured(); }
@@ -117,6 +120,9 @@ private:
   std::unique_ptr<CDVBridgeGLES> m_dvBridge;
   CDVBridgeState m_dvState;
   std::atomic<bool> m_dvRendererNative{false};
+  std::chrono::steady_clock::time_point m_dvRestoreRetry; //!< last retry of a failed restore
+  unsigned int m_dvRestoreFailures = 0; //!< failed restorations in a row (log rate)
+  std::atomic<unsigned int> m_dvOutputRestores{0};
   bool m_dvFrame = false;
   double m_dvFramePts = DVD_NOPTS_VALUE; //!< picture prepared by RenderDVBridge()
   bool m_dvOverlays = true;
