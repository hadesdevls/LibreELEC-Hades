From fe8736c78233a581ef54175cb11e4d1d8339bbb9 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 7 Nov 2026 11:11:09 +1000
Subject: [PATCH] [Games] Don't disconnect a port whose saved controller isn't
 accepted

CPortManager restores each port's controller from ports.xml, and when
the port no longer accepts the saved controller it disconnects the
port. That happens when a game add-on gains a topology: Beetle Saturn
had none, so ports.xml has game.controller.default on port 1, and once
the add-on lists its ports, port 1 doesn't accept that and stays empty.
The pad then goes to port 2, and a second player has nowhere to go
until ports.xml is deleted.

Keep the saved connected state and leave the port on its default
controller instead. A port saved as disconnected stays disconnected,
and so does a port with no controllers to fall back to.

Assisted-by: Claude
(cherry picked from commit 8f6ef6f7385b4c4bbb9a85acb38d70744b407730)
(cherry picked from commit 181c87cd819d9bd9b1414da064d7f3ad591580e6)
---
 cmake/treedata/common/tests.txt               |   1 +
 xbmc/games/ports/input/PortManager.cpp        |  10 +-
 xbmc/games/ports/input/test/CMakeLists.txt    |   4 +
 .../ports/input/test/TestPortManager.cpp      | 135 ++++++++++++++++++
 4 files changed, 148 insertions(+), 2 deletions(-)
 create mode 100644 xbmc/games/ports/input/test/CMakeLists.txt
 create mode 100644 xbmc/games/ports/input/test/TestPortManager.cpp

diff --git a/cmake/treedata/common/tests.txt b/cmake/treedata/common/tests.txt
index 2bc9deb..66d217a 100644
--- a/cmake/treedata/common/tests.txt
+++ b/cmake/treedata/common/tests.txt
@@ -29,6 +29,7 @@ xbmc/games/addons/streams/test    test/games/addons/streams
 xbmc/games/controllers/input/test test/games/controllers/input
 xbmc/games/controllers/test       test/games/controllers
 xbmc/games/dialogs/disc/test      test/games/dialogs/disc
+xbmc/games/ports/input/test       test/games/ports/input
 xbmc/games/tags/test              test/games/tags
 xbmc/games/test                   test/games
 xbmc/guilib/test                  test/guilib
diff --git a/xbmc/games/ports/input/PortManager.cpp b/xbmc/games/ports/input/PortManager.cpp
index fb664b7..f825585 100644
--- a/xbmc/games/ports/input/PortManager.cpp
+++ b/xbmc/games/ports/input/PortManager.cpp
@@ -228,10 +228,16 @@ void CPortManager::DeserializePort(const tinyxml2::XMLElement* pPort, CPortNode&
   bool connected = (XMLUtils::GetAttribute(pPort, XML_ATTR_PORT_CONNECTED) == "true");
   port.SetConnected(connected);
 
-  // Controller
+  // Controller, or the port's default if it no longer accepts the saved one
   const std::string activeControllerId = XMLUtils::GetAttribute(pPort, XML_ATTR_PORT_CONTROLLER);
   if (!port.SetActiveController(activeControllerId))
-    port.SetConnected(false);
+  {
+    if (port.GetCompatibleControllers().empty())
+      port.SetConnected(false);
+    else if (!activeControllerId.empty())
+      CLog::Log(LOGDEBUG, "Port {} doesn't accept controller \"{}\", using its default",
+                port.GetAddress(), activeControllerId);
+  }
 
   DeserializeControllers(pPort, port.GetCompatibleControllers());
 }
diff --git a/xbmc/games/ports/input/test/CMakeLists.txt b/xbmc/games/ports/input/test/CMakeLists.txt
new file mode 100644
index 0000000..6653725
--- /dev/null
+++ b/xbmc/games/ports/input/test/CMakeLists.txt
