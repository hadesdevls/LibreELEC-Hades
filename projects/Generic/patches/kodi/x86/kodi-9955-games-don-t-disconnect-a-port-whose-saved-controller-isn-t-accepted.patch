diff --git a/xbmc/games/ports/input/test/TestPortManager.cpp b/xbmc/games/ports/input/test/TestPortManager.cpp
new file mode 100644
index 0000000..c0167a6
--- /dev/null
+++ b/xbmc/games/ports/input/test/TestPortManager.cpp
@@ -0,0 +1,135 @@
+/*
