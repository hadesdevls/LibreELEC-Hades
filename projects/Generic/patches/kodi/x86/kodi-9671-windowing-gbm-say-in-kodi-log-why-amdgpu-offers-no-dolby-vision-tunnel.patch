From 41f911dce412ddd7c6e9c1543256c495e90cb173 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:47:57 +0000
Subject: [PATCH] windowing/gbm: say in kodi.log why amdgpu offers no Dolby
 Vision tunnel

With the kernel no longer offering the tunnel on the display cores of
Polaris and Vega unless asked to (linux patch for issue 20: an RX 550 with
an LG G3 shows the Dolby Vision logo and black), a Dolby Vision video on
such a card finds no backend and plays as HDR10. The line of kodi.log that
says why native output is unavailable said only that the driver has no
backend; for amdgpu it now names the cause and the kernel option. The
reason code the player information shows is unchanged.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 9ccb14a..6394586 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1413,6 +1413,21 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
   {
     code = "output";
     reason = "the output driver has no Dolby Vision backend";
+    // Hades: amdgpu offers the tunnel on its DCN display cores only; on DCE 11.2 to 12 (Polaris,
+    // Vega) it is not offered unless the kernel is told so (amdgpu.dvbridge_dce=1): the one
+    // display tried with it, on an RX 550, showed the Dolby Vision logo and black (the reason code
+    // stays "output", which the player information already names)
+    if (drmVersionPtr version = m_DRM ? drmGetVersion(m_DRM->GetFileDescriptor()) : nullptr)
+    {
+      if (version->name && std::string_view(version->name) == "amdgpu")
+      {
+        reason = "the amdgpu driver offers no Dolby Vision tunnel on this graphics chip: on the "
+                 "display cores of Polaris and Vega (DCE) it is not offered unless the kernel is "
+                 "told so (amdgpu.dvbridge_dce=1), because it has not been seen to show a picture "
+                 "there (the kernel log says so); Dolby Vision plays converted to HDR10";
+      }
+      drmFreeVersion(version);
+    }
   }
   else if (lowLatency && !CDVBridgeState::SupportsLowLatency(*connector))
   {
-- 
