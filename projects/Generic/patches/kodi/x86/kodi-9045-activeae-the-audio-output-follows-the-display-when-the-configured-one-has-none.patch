diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 0a0cca3..3d0ad86 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2845,8 +2845,12 @@ void CActiveAE::LoadSettings()
 {
   const std::shared_ptr<CSettings> settings = CServiceBroker::GetSettingsComponent()->GetSettings();
 
-  m_settings.device = settings->GetString(CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE);
-  m_settings.passthroughdevice = settings->GetString(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE);
+  m_settings.device =
+      FollowDisplay(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_AUDIODEVICE),
+                    m_settings.device, false);
+  m_settings.passthroughdevice =
+      FollowDisplay(settings->GetString(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE),
+                    m_settings.passthroughdevice, true);
 
   m_settings.config = settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_CONFIG);
   m_settings.channels = (m_sink.GetDeviceType(m_settings.device) == AE_DEVTYPE_IEC958) ? AE_CH_LAYOUT_2_0 : settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_CHANNELS);
@@ -2876,6 +2880,19 @@ void CActiveAE::LoadSettings()
   m_settings.lowLatencyMode = settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_LOWLATENCY);
 }
 
+std::string CActiveAE::FollowDisplay(const std::string& device,
+                                     const std::string& inUse,
+                                     bool passthrough) const
+{
+  std::string followed = m_sink.FollowDisplay(device, passthrough);
+  if (followed != device && followed != inUse)
+    CLog::Log(LOGINFO,
+              "ActiveAE - the configured {} output '{}' has no display attached: using '{}', the "
+              "only output with one (the setting is not changed)",
+              passthrough ? "passthrough" : "audio", device, followed);
+  return followed;
+}
+
 void CActiveAE::ValidateOutputDevices(bool saveChanges)
 {
   std::string device = m_sink.ValidateOuputDevice(m_settings.device, false);
@@ -3037,7 +3054,12 @@ bool CActiveAE::SupportsRaw(AEAudioFormat &format)
   if (format.m_streamInfo.m_type == CAEStreamInfo::STREAM_TYPE_DTSHD_MA && !m_settings.dtshdpassthrough)
     return false;
 
-  if (!m_sink.SupportsFormat(CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE), format))
+  // (of the passthrough device in use, see FollowDisplay())
+  if (!m_sink.SupportsFormat(
+          m_sink.FollowDisplay(CServiceBroker::GetSettingsComponent()->GetSettings()->GetString(
+                                   CSettings::SETTING_AUDIOOUTPUT_PASSTHROUGHDEVICE),
+                               true),
+          format))
     return false;
 
   return true;
