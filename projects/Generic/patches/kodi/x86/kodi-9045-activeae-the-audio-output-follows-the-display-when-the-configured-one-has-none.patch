diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index ad939b7..c797ec7 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -753,6 +753,71 @@ void CActiveAESink::PrintSinks(std::string& driver)
   }
 }
 
+namespace
+{
+bool IsUsableFor(const CAEDeviceInfo& d, bool passthrough)
+{
+  if (passthrough && (d.m_deviceType == AE_DEVTYPE_PCM || d.m_onlyPCM))
+    return false;
+
+  return passthrough || !d.m_onlyPassthrough;
+}
+
+// An HDMI or DisplayPort output without a display plays to nothing, and with some drivers cannot
+// even be opened, which leaves the engine without a sink. When the driver says that the output
+// has no display, and exactly one other output of the same driver has one, that one is used in
+// its place: the TV of a machine with two GPUs was moved from one to the other, or the default
+// of a first start is an output of the GPU without the TV. With no display anywhere, with
+// several, or with an output whose driver cannot tell, nothing changes.
+const CAEDeviceInfo* DisplayOutputInstead(const AE::AESinkInfo& sink,
+                                          const CAEDeviceInfo& d,
+                                          bool passthrough)
+{
+  if (d.m_display != CAEDeviceInfo::Display::ABSENT)
+    return nullptr;
+
+  const CAEDeviceInfo* found = nullptr;
+  for (const auto& other : sink.m_deviceInfoList)
+  {
+    if (other.m_display != CAEDeviceInfo::Display::PRESENT || !IsUsableFor(other, passthrough))
+      continue;
+
+    if (found)
+      return nullptr; // several displays: the choice stays with the user
+
+    found = &other;
+  }
+  return found;
+}
+} // unnamed namespace
+
+// Used every time the engine loads its settings, so that everything it does with the device (the
+// formats it may pass through, the sink it opens) is about the output in use. The setting itself
+// is not touched: when the configured output has a display again, it is the one in use again
+// (a change of the display's audio data is a device change, which reloads the settings).
+std::string CActiveAESink::FollowDisplay(const std::string& device, bool passthrough) const
+{
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+  if (dev.driver.empty() || dev.name.empty())
+    return device;
+
+  for (const auto& sink : m_sinkInfoList)
+  {
+    if (sink.m_sinkName != dev.driver)
+      continue;
+
+    for (const auto& d : sink.m_deviceInfoList)
+    {
+      if (d.m_deviceName != dev.name)
+        continue;
+
+      const CAEDeviceInfo* other = DisplayOutputInstead(sink, d, passthrough);
+      return other ? other->ToDeviceString(sink.m_sinkName) : device;
+    }
+  }
+  return device;
+}
+
 std::string CActiveAESink::ValidateOuputDevice(const std::string& device, bool passthrough) const
 {
   if (m_sinkInfoList.empty())
@@ -823,7 +888,10 @@ std::string CActiveAESink::ValidateOuputDevice(const std::string& device, bool p
           continue;
 
         if (firstDevice.empty())
-          firstDevice = d.ToDeviceString(sink.m_sinkName);
+        {
+          const CAEDeviceInfo* other = DisplayOutputInstead(sink, d, passthrough);
+          firstDevice = (other ? *other : d).ToDeviceString(sink.m_sinkName);
+        }
 
         if (d.m_deviceName.find("default") != std::string::npos)
           return d.ToDeviceString(sink.m_sinkName);
@@ -852,7 +920,10 @@ std::string CActiveAESink::ValidateOuputDevice(const std::string& device, bool p
         continue;
 
       if (firstDevice.empty())
-        firstDevice = d.ToDeviceString(sink.m_sinkName);
+      {
+        const CAEDeviceInfo* other = DisplayOutputInstead(sink, d, passthrough);
+        firstDevice = (other ? *other : d).ToDeviceString(sink.m_sinkName);
+      }
 
       if (d.m_deviceName.find("default") != std::string::npos)
         return d.ToDeviceString(sink.m_sinkName);
@@ -967,11 +1038,15 @@ void CActiveAESink::OpenSink()
     CLog::LogF(LOGDEBUG, "trying to open device {}", device);
     m_sink = CAESinkFactory::Create(device, m_sinkFormat);
 
-    // try first device in out list
-    if (!m_sink && !m_sinkInfoList.empty())
+    // try first device in out list (or the output with the display in its place, as
+    // FollowDisplay() does)
+    if (!m_sink && !m_sinkInfoList.empty() && !m_sinkInfoList.front().m_deviceInfoList.empty())
     {
-      dev.driver = m_sinkInfoList.front().m_sinkName;
-      dev.name = m_sinkInfoList.front().m_deviceInfoList.front().m_deviceName;
+      const AE::AESinkInfo& firstSink = m_sinkInfoList.front();
+      const CAEDeviceInfo& first = firstSink.m_deviceInfoList.front();
+      const CAEDeviceInfo* other = DisplayOutputInstead(firstSink, first, passthrough);
+      dev.driver = firstSink.m_sinkName;
+      dev.name = (other ? *other : first).m_deviceName;
       GetDeviceFriendlyName(dev.name);
       device = dev.driver.empty() ? dev.name : dev.driver + ":" + dev.name;
       m_sinkFormat = m_requestedFormat;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
index aaec983..796398e 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
@@ -100,6 +100,11 @@ public:
   void EnumerateSinkList(bool force, std::string driver);
   void EnumerateOutputDevices(AEDeviceList &devices, bool passthrough);
   std::string ValidateOuputDevice(const std::string& device, bool passthrough) const;
+  /*!
+   * \brief The device to use for a configured one: itself, or the only HDMI output with a display
+   * when it is an HDMI output without one (see the definition).
+   */
+  std::string FollowDisplay(const std::string& device, bool passthrough) const;
   void Start();
   void Dispose();
   AEDeviceType GetDeviceType(const std::string &device);
diff --git a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
index 1287115..21490f5 100644
--- a/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
+++ b/xbmc/cores/AudioEngine/Sinks/AESinkALSA.cpp
@@ -1655,13 +1655,19 @@ bool CAESinkALSA::GetELD(snd_hctl_t *hctl, int device, CAEDeviceInfo& info, bool
   /* if there is no ELD data, then its a bad HDMI device, either nothing attached OR an invalid nVidia HDMI device
    * OR the driver doesn't properly support ELD (notably ATI/AMD, 2012-05) */
   if (!dataLength)
+  {
     badHDMI = true;
+    info.m_display = CAEDeviceInfo::Display::ABSENT;
+  }
   else
+  {
     CAEELDParser::Parse(
       (const uint8_t*)snd_ctl_elem_value_get_bytes(control),
       dataLength,
       info
     );
+    info.m_display = CAEDeviceInfo::Display::PRESENT;
+  }
 
   info.m_deviceType = AE_DEVTYPE_HDMI;
   return true;
diff --git a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.cpp
index 87dc678..4d5aa2c 100644
--- a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.cpp
@@ -19,6 +19,8 @@ CAEDeviceInfo::operator std::string()
   ss << "m_displayName     : " << m_displayName << '\n';
   ss << "m_displayNameExtra: " << m_displayNameExtra << '\n';
   ss << "m_deviceType      : " << DeviceTypeToString(m_deviceType) + '\n';
+  if (m_display != Display::UNKNOWN)
+    ss << "m_display         : " << (m_display == Display::PRESENT ? "attached" : "none") << '\n';
   ss << "m_channels        : " << (std::string)m_channels << '\n';
 
   ss << "m_sampleRates     : ";
diff --git a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
index c28c29c..af59a67 100644
--- a/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
+++ b/xbmc/cores/AudioEngine/Utils/AEDeviceInfo.h
@@ -45,6 +45,17 @@ public:
   bool m_onlyPassthrough{false}; // sink only only should be used for passthrough (audio PT device)
   bool m_onlyPCM{false}; // sink only should be used for PCM (audio device)
 
+  //! Whether a display is attached to an HDMI or DisplayPort output, for the sinks that can tell.
+  //! ABSENT is positive knowledge (the driver publishes the display's audio capabilities, and
+  //! there are none); an output whose driver says nothing stays UNKNOWN.
+  enum class Display
+  {
+    UNKNOWN,
+    ABSENT,
+    PRESENT,
+  };
+  Display m_display{Display::UNKNOWN};
+
   operator std::string();
   static std::string DeviceTypeToString(enum AEDeviceType deviceType);
   std::string GetFriendlyName() const;
