-// Whether the packets of a stream are start-code streams (Annex B) and not length-prefixed units
-// with their parameter sets in an hvcC record. As libavcodec tells them apart: such a record
-// starts with its version, 1.
-bool IsAnnexB(const AVCodecParameters* par)
+// Calls unit(pointer, size) for each unit of a buffer that has a length of lengthSize bytes before
+// each unit (MP4, Matroska), or of a start-code stream when lengthSize is 0. A length of 0 is no
+// unit, and fewer bytes at the end than a length are left, as libavcodec leaves them. False when
+// the buffer is no such stream: a length beyond its end, a unit shorter than its header, a unit
+// with the forbidden bit set, or no unit at all.
+template<typename F>
+bool ForEachUnit(const uint8_t* data, size_t size, int lengthSize, F&& unit)
+{
+  if (lengthSize == 0)
+    return ForEachStartCodeUnit(data, size, unit);
+  if (!data || lengthSize < 0 || lengthSize > 4)
+    return false;
+
+  const size_t prefix = static_cast<size_t>(lengthSize);
+  bool any = false;
+  size_t i = 0;
+  while (size - i >= prefix)
+  {
+    size_t length = 0;
+    for (size_t k = 0; k < prefix; ++k)
+      length = length << 8 | data[i + k];
+    i += prefix;
+    if (length > size - i)
+      return false;
+    if (length == 0)
+      continue;
+    if (length < 2 || (data[i] & 0x80))
+      return false;
+    unit(data + i, length);
+    any = true;
+    i += length;
+  }
+  return any;
+}
+
+// Whether an access unit holds a picture that a decoder can start at (a unit of an IRAP type).
+bool RandomAccess(const uint8_t* data, size_t size, int lengthSize)
+{
+  bool found = false;
+  if (data && size > 0)
+    ForEachUnit(data, size, lengthSize,
+                [&found](const uint8_t* unit, size_t)
+                {
+                  const unsigned int type = (unit[0] >> 1) & 0x3f;
+                  found |= type >= NAL_IRAP_FIRST && type <= NAL_IRAP_LAST;
+                });
+  return found;
+}
+
+bool SameTimeBase(AVRational a, AVRational b)
+{
+  return a.num > 0 && a.den > 0 && b.num > 0 && b.den > 0 && av_cmp_q(a, b) == 0;
