+// A time of the enhancement track in the time base of the base track (as it is when the two are
+// the same or not known; AV_NOPTS_VALUE when it does not fit).
+int64_t CDVLayerMerge::ToBase(int64_t time) const
+{
+  if (time == AV_NOPTS_VALUE || !KnownTimeBase(m_timeBase) ||
+      !KnownTimeBase(m_enhancementTimeBase) || SameTimeBase(m_timeBase, m_enhancementTimeBase))
+    return time;
+  return av_rescale_q(time, m_enhancementTimeBase, m_timeBase);
+}
+
 // The decoding time of an access unit is its own, or, when its PES packet gave it none (it was
 // not the first one in it), the one that follows from the unit before it in the track: that time
 // plus that duration. The duration is a rounded number, so a time that follows is only known to
 // half a duration.
-bool CDVLayerMerge::Queue(Track& track, AVPacket* packet)
+//
+// In Matroska the packets have no decoding times. There the time is made from the presentation
+// times (see REORDER): from a random-access packet of the track on, the times of its packets go
+// into a heap, and each time the heap holds more than REORDER of them, the least one is the time
+// of the oldest packet that waits for one. Packets of the track before such a packet have none.
+//
+// The times of the enhancement track are taken to the time base of the base track, with a slack
+// of one more for the rounding of that.
+bool CDVLayerMerge::Queue(Track& track, AVPacket* packet, bool enhancement)
 {
   Waiting waiting;
-  waiting.time = packet->dts;
-  if (packet->dts == AV_NOPTS_VALUE && track.known && track.time != AV_NOPTS_VALUE &&
-      track.duration > 0 && track.time <= std::numeric_limits<int64_t>::max() - track.duration)
-  {
-    waiting.time = track.time + track.duration;
-    waiting.slack = track.duration / 2;
-  }
-  track.time = waiting.time;
-  track.duration = packet->duration;
-  track.known = true;
-
   waiting.packet = av_packet_alloc();
   if (!waiting.packet)
   {
     av_packet_unref(packet);
     return false;
   }
+
+  const bool converted = enhancement && KnownTimeBase(m_timeBase) &&
+                         KnownTimeBase(m_enhancementTimeBase) &&
+                         !SameTimeBase(m_timeBase, m_enhancementTimeBase);
+  if (m_fromPresentation)
+  {
+    waiting.time = AV_NOPTS_VALUE;
+    if (!track.started)
+      track.started = RandomAccess(packet->data, static_cast<size_t>(std::max(packet->size, 0)),
+                                   track.lengthSize);
+    if (!track.started && track.unstarted < std::numeric_limits<unsigned int>::max())
+      ++track.unstarted;
+    const int64_t pts = enhancement ? ToBase(packet->pts) : packet->pts;
+    if (track.started && pts != AV_NOPTS_VALUE)
+    {
+      track.presented.push_back(pts);
+      std::push_heap(track.presented.begin(), track.presented.end(), std::greater<int64_t>());
+      waiting.pending = true;
+      // the two times of an access unit are the same but for the rounding of a time base: a
+      // quarter of a duration takes that, and is far from the time of the next picture
+      const int64_t duration = enhancement ? ToBase(packet->duration) : packet->duration;
+      waiting.slack = (duration > 0 ? duration / 4 : 0) + (converted ? 1 : 0);
+    }
+  }
+  else
+  {
+    waiting.time = packet->dts;
+    if (packet->dts == AV_NOPTS_VALUE && track.known && track.time != AV_NOPTS_VALUE &&
+        track.duration > 0 && track.time <= std::numeric_limits<int64_t>::max() - track.duration)
+    {
+      waiting.time = track.time + track.duration;
+      waiting.slack = track.duration / 2;
+    }
+    track.time = waiting.time;
+    track.duration = packet->duration;
+    track.known = true;
+    if (converted)
+    {
+      waiting.time = ToBase(waiting.time);
+      waiting.slack = waiting.time == AV_NOPTS_VALUE
+                          ? 0
+                          : std::max<int64_t>(ToBase(waiting.slack), 0) + 1;
+    }
+  }
+
   av_packet_move_ref(waiting.packet, packet);
   track.waiting.push_back(waiting);
+  if (m_fromPresentation)
+    GiveTimes(track, REORDER);
   return true;
 }
 
+// The least times of the heap go to the oldest packets that wait for theirs, until it holds keep
+// of them. Each packet that waits for a time put one in the heap, so there is always one.
+void CDVLayerMerge::GiveTimes(Track& track, size_t keep)
+{
+  while (track.presented.size() > keep)
+  {
+    std::pop_heap(track.presented.begin(), track.presented.end(), std::greater<int64_t>());
+    const int64_t time = track.presented.back();
