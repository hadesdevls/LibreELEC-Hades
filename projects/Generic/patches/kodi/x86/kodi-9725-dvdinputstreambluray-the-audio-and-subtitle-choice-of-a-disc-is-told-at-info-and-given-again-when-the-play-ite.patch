From 64afa1991b3deeb1f50e156b944bce3005c8ac5d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:00:00 +0000
Subject: [PATCH] DVDInputStreamBluray: the audio and subtitle choice of a disc
 is told at INFO and given again when the play item is known

libbluray tells the player which audio and subtitle stream a disc has chosen
(BD_EVENT_AUDIO_STREAM, BD_EVENT_PG_TEXTST_STREAM, from PSR1 and PSR2). The
number is turned into the PID of the stream of the current play item, and
the player opens the stream with that PID. A number that came while the play
item was not known (a menu that sets the language, then starts the playlist;
a disc that chooses while a playlist is being prepared) gave -1: no stream,
and the choice was lost for the playlist that follows (issue 1: "the subtitles
I selected in the menu are not selected when the movie starts").

The last numbers are kept; one that could not be given a stream because
there was no play item is given again at BD_EVENT_PLAYITEM, when the play
item is known. A number that the play item does not have (more than its
streams) stays "none", as before. The events were logged at debug level
and without the stream: they are now INFO lines that say the number, the
PID or why there is none, so that the next capture of a disc that does not
apply its choice says where it is lost.

From the capture of the issue (RC8, a Java menu disc): the disc's own code
asks for a stream while it prepares a playlist (kt.initializeStreams() at
PrefetchComplete) and libbluray's StreamControl.selectStreamNumber()
refuses (StreamControl.java:80: no streams for the clip at that moment or a
number beyond them), in the playlists of its menus, 30 to 40 s before the
feature and again for later menus; none is raised for the feature's playlist.
Whether the feature's choice then reaches the player with a play item, or
not, cannot be told from that capture (the events were not logged): the INFO
lines are for that. Nothing was run with a disc.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 63 ++++++++++++++++---
 .../DVDInputStreams/DVDInputStreamBluray.h    | 11 ++++
 2 files changed, 64 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index f3926bb..dd73b27 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -582,6 +582,22 @@ void CDVDInputStreamBluray::UpdateClipInfo(unsigned int playItem)
               playItem);
 }
 
+int CDVDInputStreamBluray::AudioPidOf(uint32_t number) const
+{
+  if (m_titleInfo && m_clip && number >= 1 &&
+      static_cast<uint32_t>(m_clip->audio_stream_count) >= number)
+    return m_clip->audio_streams[number - 1].pid;
+  return -1;
+}
+
+int CDVDInputStreamBluray::PgPidOf(uint32_t number) const
+{
+  if (m_titleInfo && m_clip && number >= 1 &&
+      static_cast<uint32_t>(m_clip->pg_stream_count) >= number)
+    return m_clip->pg_streams[number - 1].pid;
+  return -1;
+}
+
 void CDVDInputStreamBluray::ProcessEvent() {
 
   int pid = -1;
@@ -736,6 +752,24 @@ void CDVDInputStreamBluray::ProcessEvent() {
     {
       m_clip = &m_titleInfo->clips[m_event.param];
       UpdateClipInfo(m_event.param);
+      // Hades: a choice that was made before the play item was known (a menu that sets the
+      // language, then starts the playlist) is told to the player now
+      if (m_audioStreamPending)
+      {
+        m_audioStreamPending = false;
+        int audioPid = AudioPidOf(m_audioStreamNumber);
+        CLog::Log(LOGINFO, "CDVDInputStreamBluray - audio stream {} given now: {}", m_audioStreamNumber,
+                  audioPid >= 0 ? StringUtils::Format("PID 0x{:x}", audioPid) : std::string("none in this play item"));
+        m_player->OnDiscNavResult(static_cast<void*>(&audioPid), BD_EVENT_AUDIO_STREAM);
+      }
+      if (m_pgStreamPending)
+      {
+        m_pgStreamPending = false;
+        int pgPid = PgPidOf(m_pgStreamNumber);
+        CLog::Log(LOGINFO, "CDVDInputStreamBluray - subtitle stream {} given now: {}", m_pgStreamNumber,
+                  pgPid >= 0 ? StringUtils::Format("PID 0x{:x}", pgPid) : std::string("none in this play item"));
+        m_player->OnDiscNavResult(static_cast<void*>(&pgPid), BD_EVENT_PG_TEXTST_STREAM);
+      }
       // Hades: a playlist played directly goes on its own timeline (BlurayTitleTime.h). Each
       // join is told with the step between the two clocks that this puts away.
       if (!m_navmode && m_event.param > 0)
@@ -767,25 +801,34 @@ void CDVDInputStreamBluray::ProcessEvent() {
     /* stream selection */
 
   case BD_EVENT_AUDIO_STREAM:
-    pid = -1;
-    if (m_titleInfo && m_clip && static_cast<uint32_t>(m_clip->audio_stream_count) > (m_event.param - 1))
-      pid = m_clip->audio_streams[m_event.param - 1].pid;
-    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_AUDIO_STREAM {} {}", m_event.param, pid);
+    // Hades: told at INFO with what it says, and kept for when the play item is known
+    m_audioStreamNumber = m_event.param;
+    pid = AudioPidOf(m_event.param);
+    m_audioStreamPending = pid < 0 && m_event.param >= 1 && !(m_titleInfo && m_clip);
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - audio stream {} chosen: {}", m_event.param,
+              pid >= 0 ? StringUtils::Format("PID 0x{:x} of the play item", pid)
+              : m_audioStreamPending ? std::string("no play item yet, it is given again when there is one")
+                                     : StringUtils::Format("the play item has {} audio streams, none", m_clip ? m_clip->audio_stream_count : 0));
     m_player->OnDiscNavResult(static_cast<void*>(&pid), BD_EVENT_AUDIO_STREAM);
     break;
 
   case BD_EVENT_PG_TEXTST:
-    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_PG_TEXTST {}", m_event.param);
+    CLog::Log(LOGINFO, "CDVDInputStreamBluray - subtitles {}", m_event.param ? "on" : "off");
     pid = m_event.param;
     m_player->OnDiscNavResult(static_cast<void*>(&pid), BD_EVENT_PG_TEXTST);
     break;
 
   case BD_EVENT_PG_TEXTST_STREAM:
-    pid = -1;
-    if (m_titleInfo && m_clip && static_cast<uint32_t>(m_clip->pg_stream_count) > (m_event.param - 1))
-      pid = m_clip->pg_streams[m_event.param - 1].pid;
-    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_PG_TEXTST_STREAM {}, {}", m_event.param,
-              pid);
+    // Hades: told at INFO with what it says, and kept for when the play item is known
+    m_pgStreamNumber = m_event.param;
+    pid = PgPidOf(m_event.param);
+    m_pgStreamPending = pid < 0 && m_event.param >= 1 && !(m_titleInfo && m_clip);
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - subtitle stream {} chosen: {}", m_event.param,
+              pid >= 0 ? StringUtils::Format("PID 0x{:x} of the play item", pid)
+              : m_pgStreamPending ? std::string("no play item yet, it is given again when there is one")
+                                  : StringUtils::Format("the play item has {} subtitle streams, none", m_clip ? m_clip->pg_stream_count : 0));
     m_player->OnDiscNavResult(static_cast<void*>(&pid), BD_EVENT_PG_TEXTST_STREAM);
     break;
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index c9de238..122c5dd 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -338,6 +338,17 @@ protected:
   BLURAY_TITLE_INFO* m_titleInfo = nullptr;
   uint32_t m_playlist = MAX_PLAYLIST_ID + 1;
   BLURAY_CLIP_INFO* m_clip = nullptr;
+  //! Hades: the audio and subtitle stream numbers that libbluray last told (its registers PSR1 and
+  //! PSR2), and whether they could not be given a stream yet because the play item they are of was
+  //! not known (a menu or a disc that chooses before it starts a playlist). They are given again as
+  //! soon as the play item is known (ProcessEvent(), BD_EVENT_PLAYITEM).
+  uint32_t m_audioStreamNumber = 0;
+  uint32_t m_pgStreamNumber = 0;
+  bool m_audioStreamPending = false;
+  bool m_pgStreamPending = false;
+  //! Hades: the stream of the clip that has this number, as the player is told it (-1: none)
+  int AudioPidOf(uint32_t number) const;
+  int PgPidOf(uint32_t number) const;
 
   //! The clip information of the play item being played, ie. every stream its m2ts carries (see
   //! GetStreamInfo). Owned, and only valid while m_clip refers to the same play item.
-- 
