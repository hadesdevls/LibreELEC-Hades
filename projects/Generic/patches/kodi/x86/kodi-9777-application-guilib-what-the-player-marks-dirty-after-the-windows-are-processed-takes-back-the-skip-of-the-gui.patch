From 31746845b210c96e9b4117257f82e2b0acb88282 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:54:30 +0000
Subject: [PATCH] application, guilib: what the player marks dirty after the
 windows are processed takes back the skip of the GUI pass

Where the GUI is composited over the picture (native Dolby Vision and HDR10/HLG,
CDVGuiReuse), the GUI pass of a frame is left out when no control is dirty: the
dirty-driven skip of CApplication::FrameMove(), decided right after the windows
are processed. The player chooses the picture of the frame afterwards, in
DriveRenderLoop(), and CRenderManager::PrepareOverlays() marks the GUI dirty
there when a subtitle comes with it (a PGS, DVB or DVD picture that arrives or
ends, a change of the text that libass draws); the debug information of the
player and a change of the area of the video mark it the same way. The skip had
been decided by then: the subtitle went out a frame late, in the next frame,
whose Process() saw the window marked. Before the GUI pass was left out it was
drawn in every frame, and the subtitle went out with its picture.

CGUIWindowManager tells whether a region was marked dirty since Process() began
(MarkedSinceProcess(): set by MarkDirty() for a region that the tracker keeps,
forgotten when Process() begins), and FrameMove() takes the skip back after
DriveRenderLoop() where it was: the region is in the tracker, so the next
Render() draws the GUI pass whole. For DV and the HDR composite alike, and for
D2P, whose skip is the same. Where nothing is marked, nothing changes: a flag set
in MarkDirty() and one test of it in a frame whose pass is left out.

The other changes of a frame were looked at: the seek bar, the toasts and the
keys are handled before the windows are processed (FrameMove() of the seek
handler, CGUIDialogKaiToast::DoWork()), and a change of the state of the player
(pause) reaches the windows after them as GUI_MSG_STATE_CHANGED, which marks
them to be processed in the next frame: shown then whether or not the pass is
left out, as before.

Host tests (outside the tree): overlay_late_test (a model of the frame in the
order of its steps: the subtitle drawn in the frame of its picture, its end too,
a mark made while the windows are processed, and no GUI pass with nothing over
the picture; the code before this change and three mutants of the fix are late) and
overlay_late_wiring.py (the calls in Application.cpp and GUIWindowManager.cpp,
and four mutants of them, each caught). Before this change the wiring fails.
---
 xbmc/application/Application.cpp | 13 +++++++++++++
 xbmc/guilib/GUIWindowManager.cpp |  4 ++++
 xbmc/guilib/GUIWindowManager.h   | 10 ++++++++++
 3 files changed, 27 insertions(+)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index f7e7db1..33e87ac 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1706,6 +1706,19 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
 
   // this will go away when render systems gets its own thread
   CServiceBroker::GetWinSystem()->DriveRenderLoop();
+
+  // Hades: a frame whose GUI pass was to be left out by the dirty-driven skip above draws it after
+  // all where the GUI was marked dirty since its windows were processed: by the picture that the
+  // player chose for this frame in DriveRenderLoop() (its subtitles, CRenderManager::
+  // PrepareOverlays()), by the debug information of the player, by a change of the area of the
+  // video. They go out with the frame they come with, as where the GUI pass is drawn in every
+  // frame; the next frame was too late (CWinSystemGbmGLESContext::GuiPassReusable())
+  if (m_skipGuiRender)
+  {
+    auto* gui = CServiceBroker::GetGUI();
+    if (gui && gui->GetWindowManager().MarkedSinceProcess())
+      m_skipGuiRender = false;
+  }
 }
 
 
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index 539ae2c..d0161c1 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -1328,6 +1328,7 @@ void CGUIWindowManager::Process(unsigned int currentTime)
   assert(CServiceBroker::GetAppMessenger()->IsProcessThread());
   std::unique_lock lock(CServiceBroker::GetWinSystem()->GetGfxContext());
 
+  m_markedSinceProcess = false; // (Hades: MarkedSinceProcess())
   m_dirtyregions.clear();
 
   CGUIWindow* pWindow = GetWindow(GetActiveWindow());
@@ -1381,6 +1382,9 @@ void CGUIWindowManager::MarkDirty()
 void CGUIWindowManager::MarkDirty(const CRect& rect)
 {
   m_tracker.MarkDirtyRegion(CDirtyRegion(rect));
+  // (Hades: a region that the next Render() draws; an empty one is not kept by the tracker)
+  if (!rect.IsEmpty())
+    m_markedSinceProcess = true;
 
   CGUIWindow* pWindow = GetWindow(GetActiveWindow());
   if (pWindow)
diff --git a/xbmc/guilib/GUIWindowManager.h b/xbmc/guilib/GUIWindowManager.h
index 957e98d..c5e6b96 100644
--- a/xbmc/guilib/GUIWindowManager.h
+++ b/xbmc/guilib/GUIWindowManager.h
@@ -108,6 +108,15 @@ public:
    */
   bool HasDirtyRegions() const { return !m_dirtyregions.empty(); }
 
+  /*! \brief Hades: a region was marked dirty (MarkDirty()) since the last Process() began: the
+   *   next Render() draws it, though HasDirtyRegions() (what Process() collected) does not say so.
+   *   The dirty-driven skip of CApplication::FrameMove() is taken back for such a frame: what the
+   *   player marks after the windows were processed (the subtitles of the picture that it chose for
+   *   the frame, CRenderManager::PrepareOverlays()) goes out with that frame, as where the GUI
+   *   pass is drawn in every frame.
+   */
+  bool MarkedSinceProcess() const { return m_markedSinceProcess; }
+
   /*! \brief Rendering of the current window and any dialogs
    Render is called every frame to draw the current window and any dialogs.
    It should only be called from the application thread.
@@ -316,5 +325,6 @@ private:
 
   CDirtyRegionList m_dirtyregions;
   CDirtyRegionTracker m_tracker;
+  bool m_markedSinceProcess{false}; //!< Hades: see MarkedSinceProcess()
   bool m_presentedFrame{false};
 };
