+static enum pl_color_transfer base_transfer(const struct dvbridge_renderer *r);
+
+/* Hades: the parameters that every render of a picture here starts from: libplacebo's defaults without
+ * what would make a picture depend on the frames before it or add to it (peak detection, dithering, the
+ * frame mixer, the cache of a single frame) and without a border (PL_CLEAR_SKIP: each render writes the
+ * area around its picture itself, where it has to); the composer of ETSI GS CCM 001 as the renderer
+ * has it, with the transfer of the base layer and the MMR table; whether it composed the picture, into
+ * *composed; and the filters of the step-down level (step_down()). Each render adds its own. */
+static struct pl_render_params base_params(const struct dvbridge_renderer *r, bool *composed, int level)
+{
+    struct pl_render_params params = pl_render_default_params;
+    params.peak_detect_params = NULL;
+    params.dither_params = NULL;
+    params.frame_mixer = NULL;
+    params.skip_caching_single_frame = true;
+    params.border = PL_CLEAR_SKIP;
+    params.dovi_ccm = !r->legacy_composer;
+    params.dovi_ccm_bl_transfer = base_transfer(r);
+#ifdef PL_DOVI_CCM_MMR_TABLE
+    params.dovi_ccm_mmr_table = r->mmr_table;
+#endif
+    params.dovi_ccm_composed = composed;
+    step_down(&params, level);
+    return params;
+}
+
 /* Hades: the chroma of an enhancement layer on the chroma grid of the base layer. ETSI GS CCM 001
  * composes the two layers sample by sample at the resolution and in the chroma format of the base
  * layer: each plane of the enhancement layer is resampled onto the base layer's plane of the same
@@ -659,6 +685,29 @@ static void align_layer_chroma(const struct pl_frame *image, struct pl_frame *el
     }
 }
 
+/* Hades: the picture as libplacebo is given it, the same for every render: the source's planes with the
+ * colour that the metadata map them to (mapped, which takes the bit depth and alpha of the planes), no ICC
+ * profile or LUT of its own, and its enhancement layer, copied into *layer with its chroma on the base layer's
+ * chroma grid (align_layer_chroma()) */
+static struct pl_frame frame_for_render(const struct pl_frame *source, struct dvbridge_color *mapped,
+                                        struct pl_frame *layer)
+{
+    struct pl_frame image = *source;
+    if (source->enhancement_layer) {
+        *layer = *source->enhancement_layer;
+        align_layer_chroma(source, layer);
+        image.enhancement_layer = layer;
+    }
+    mapped->repr.bits = source->repr.bits;
+    mapped->repr.alpha = source->repr.alpha;
+    image.repr = mapped->repr;
+    image.color = mapped->color;
+    image.profile = (struct pl_icc_profile){0};
+    image.icc = NULL;
+    image.lut = NULL;
+    return image;
+}
