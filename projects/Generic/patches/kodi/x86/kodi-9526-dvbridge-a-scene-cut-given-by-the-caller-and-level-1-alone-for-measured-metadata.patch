From 1b587d49b5db2c392f7edba7155df32d4a1fc28d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:07 +0000
Subject: [PATCH] dvbridge: a scene cut given by the caller, and level 1 alone,
 for measured metadata

HDR10+ sent as Dolby Vision measures the scenes that have no HDR10+ statistics
of their own with the decisions of HDR10 measured as Dolby Vision. Two things
those decisions did not have:

- dvbridge_measured_take_cut(): the caller knows that a picture starts a scene
  (a cut of its HDR10+ metadata, or where the measurement takes over from
  them after pictures that were not measured), and the measurement starts one
  there whatever it sees. The pictures given before it and not taken go into
  the scene before, as dvbridge_measured_take() puts them; where the picture
  was not measured in time, the cut goes to the next picture that goes into a
  scene. Without it, two scenes whose pictures look alike would be one, with
  the higher maximum of the first; and the first picture measured after a
  stretch that was not would be compared with one of long ago. Such a given cut
  does not go into the history of picture to picture changes that tells motion
  from cuts: the picture before it may be of another stretch.
- dvbridge_measured_apply_level1(): the level 1 block and the scene refresh,
  without a level 5 block: the metadata made of HDR10+ statistics carry none,
  and the active area the display is told of must not change with the source
  of a scene's level 1.

dvbridge_measured_take() and dvbridge_measured_apply() do as before: the given
cut is only set by the new call (the earlier tests of the module give the same
lines on the code before and after).
---
 tools/dvbridge/dvbridge_measured.c | 39 ++++++++++++++++++++++++++++--
 tools/dvbridge/dvbridge_measured.h | 10 ++++++++
 2 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_measured.c b/tools/dvbridge/dvbridge_measured.c
index adcf32b..0c0e3eb 100644
--- a/tools/dvbridge/dvbridge_measured.c
+++ b/tools/dvbridge/dvbridge_measured.c
@@ -47,6 +47,7 @@ struct dvbridge_measured {
     struct scene scene;
     struct dvbridge_measured_l1 sent;
     bool late_cut; /* a cut among pictures not taken: the next picture taken refreshes the scene */
+    bool given_cut; /* the next picture that goes into a scene starts one (dvbridge_measured_take_cut()) */
     /* the grid differences of the last pictures (not of flashes), for the median that tells motion */
     float changes[12];
     unsigned changes_n, changes_at;
@@ -305,7 +306,10 @@ static bool step(struct dvbridge_measured *m, unsigned i)
 {
     const struct dvbridge_measured_picture *p = &m->kept[i];
     const struct dvbridge_measured_picture *next = i + 1 < m->count ? &m->kept[i + 1] : NULL;
-    bool cut = !m->started, flash = false;
+    /* (a cut given by the caller: the picture before may be of long ago, so its difference is no motion) */
+    const bool given = m->given_cut;
+    m->given_cut = false;
+    bool cut = !m->started || given, flash = false;
     float d = 0;
     if (!cut) {
         d = mad(p->grid, m->last_grid);
@@ -353,7 +357,7 @@ static bool step(struct dvbridge_measured *m, unsigned i)
     }
     if (!flash) {
         memcpy(m->last_grid, p->grid, sizeof(m->last_grid));
-        if (m->started) {
+        if (m->started && !given) {
             m->changes[m->changes_at] = d;
             m->changes_at = (m->changes_at + 1) % 12;
             if (m->changes_n < 12)
@@ -385,6 +389,17 @@ bool dvbridge_measured_take(struct dvbridge_measured *m, double pts, struct dvbr
     return found && m->sent.measured;
 }
 
+bool dvbridge_measured_take_cut(struct dvbridge_measured *m, double pts, struct dvbridge_measured_l1 *l1)
+{
+    if (!m || !l1)
+        return false;
+    /* (the pictures before it go into the scene before, as dvbridge_measured_take() would put them) */
+    while (m->count && m->kept[0].pts < pts - 1e-6 * fabs(pts) - 1e-9)
+        m->late_cut = step(m, 0) || m->late_cut;
+    m->given_cut = true;
+    return dvbridge_measured_take(m, pts, l1);
+}
+
 static double pq(double nits)
 {
     const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128;
@@ -438,3 +453,23 @@ bool dvbridge_measured_apply(struct AVDOVIMetadata *m, size_t size, const struct
     av_dovi_get_color(m)->scene_refresh_flag = l1->refresh;
     return true;
 }
+
+bool dvbridge_measured_apply_level1(struct AVDOVIMetadata *m, size_t size, const struct dvbridge_measured_l1 *l1)
+{
+    if (!m || !l1 || size < sizeof(*m) || m->num_ext_blocks < 0 || m->num_ext_blocks > AV_DOVI_MAX_EXT_BLOCKS ||
+        (m->num_ext_blocks && m->ext_block_offset + (size_t)m->num_ext_blocks * m->ext_block_size > size) ||
+        m->color_offset + sizeof(AVDOVIColorMetadata) > size || l1->min_pq > l1->max_pq || l1->max_pq > 4095 ||
+        l1->avg_pq > 4095)
+        return false;
+    AVDOVIDmData *level1 = NULL;
+    for (int i = 0; i < m->num_ext_blocks && !level1; ++i)
+        if (av_dovi_get_ext(m, i)->level == 1)
+            level1 = av_dovi_get_ext(m, i);
+    if (!level1)
+        return false;
+    level1->l1.min_pq = (uint16_t)l1->min_pq;
+    level1->l1.max_pq = (uint16_t)l1->max_pq;
+    level1->l1.avg_pq = (uint16_t)l1->avg_pq;
+    av_dovi_get_color(m)->scene_refresh_flag = l1->refresh;
+    return true;
+}
diff --git a/tools/dvbridge/dvbridge_measured.h b/tools/dvbridge/dvbridge_measured.h
index 58f44d9..0cdbe2a 100644
--- a/tools/dvbridge/dvbridge_measured.h
+++ b/tools/dvbridge/dvbridge_measured.h
@@ -105,6 +105,11 @@ void dvbridge_measured_add(struct dvbridge_measured *m, const struct dvbridge_me
  * them refreshes the scene on this picture (a cut found late). false: it was not measured; *l1 then holds what
  * was sent last (measured false when nothing was), with a refresh only for such a cut. */
 bool dvbridge_measured_take(struct dvbridge_measured *m, double pts, struct dvbridge_measured_l1 *l1);
+/* The same where the caller knows that the picture of pts starts a scene (HDR10+ sent as Dolby Vision, at a cut of
+ * its HDR10+ metadata or where the measurement takes over from them: CDVHdr10PlusFill): it starts one, whatever the
+ * measurement says, and the pictures given before it and not taken go into the scene before. Where it was not
+ * measured in time, the cut is the next picture's that goes into a scene (it, measured late, or the next one). */
+bool dvbridge_measured_take_cut(struct dvbridge_measured *m, double pts, struct dvbridge_measured_l1 *l1);
 /* The block columns that the next measurements are to be made over: those of the active area known now, all
  * of them before any is known */
 void dvbridge_measured_window(const struct dvbridge_measured *m, int blocks_w, int window[2]);
@@ -121,6 +126,11 @@ struct AVDOVIMetadata *dvbridge_measured_placeholder(const struct AVMasteringDis
 /* The metadata of a picture made from those, as it is presented: its level 1 block, its scene refresh and its level
  * 5 block (added, or replaced) from l1. false: they cannot take it (no level 1 block, no room). */
 bool dvbridge_measured_apply(struct AVDOVIMetadata *metadata, size_t size, const struct dvbridge_measured_l1 *l1);
+/* The same with the level 1 block and the scene refresh only: a level 5 block is left as the metadata have it, or
+ * none (HDR10+ sent as Dolby Vision, whose metadata of its own carry none: the active area does not change with the
+ * source of a scene's level 1) */
+bool dvbridge_measured_apply_level1(struct AVDOVIMetadata *metadata, size_t size,
+                                    const struct dvbridge_measured_l1 *l1);
 
 #ifdef __cplusplus
 }
-- 
