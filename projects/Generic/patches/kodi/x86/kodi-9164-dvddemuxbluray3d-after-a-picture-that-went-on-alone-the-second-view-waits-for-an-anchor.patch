   return base;
 }
 
+DemuxPacket* CDVDDemuxBluray3D::WentAlone(DemuxPacket* base)
+{
+  // Hades: once a picture has gone on with its second view, one that goes on alone leaves the
+  // decoder without what the second view of the next ones is predicted from. Nothing is
+  // appended from here on until an anchor picture (KODI::MULTIVIEW::Rejoin, in Append()).
+  KODI::MULTIVIEW::WentAlone(m_rejoin);
+  ++m_aloneInClip;
+  return base;
+}
+
+DemuxPacket* CDVDDemuxBluray3D::Append(DemuxPacket* base, DemuxPacket* dependent)
+{
+  // Hades: nothing is appended to a stream that is not marked as two views. The mark is asked
+  // for before every packet that is put together (it costs a look at the stream once it is
+  // there): a stream list that was rebuilt without this demuxer hearing of it is marked here.
+  if (!MarkBaseViewStereoscopic())
+  {
+    CDVDDemuxUtils::FreeDemuxPacket(dependent);
+    const int clip{m_dependentClip};
+    LogNoSecondView(static_cast<unsigned int>(clip),
+                    "the base view is no longer a stream that can be marked as two views");
+    CloseDependentView();
+    m_unopenableClip = clip;
+    return base;
+  }
+
+  // Hades: after pictures that went on alone, not before an anchor picture of the second
+  // view, and nothing that is shown before that anchor
+  const bool anchor{KODI::MULTIVIEW::IsAnchorOfSecondView(
+      dependent->pData, static_cast<size_t>(dependent->iSize))};
+  const unsigned int alone{m_rejoin.alone};
+  switch (KODI::MULTIVIEW::Offer(m_rejoin, anchor, static_cast<int64_t>(base->pts)))
+  {
+    case KODI::MULTIVIEW::Join::ALONE:
+      CDVDDemuxUtils::FreeDemuxPacket(dependent);
+      ++m_aloneInClip;
+      return base;
+    case KODI::MULTIVIEW::Join::APPEND_AT_ANCHOR:
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - clip {:05}: the second view is back, from an anchor picture "
+                "at {} ms on, after {} pictures of the base view alone (what is shown before "
+                "that picture still goes on alone)",
+                m_dependentClip, static_cast<int64_t>(DVD_TIME_TO_MSEC(base->pts)), alone);
+      break;
+    case KODI::MULTIVIEW::Join::APPEND_UNANCHORED:
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - clip {:05}: the second view is back at {} ms after {} "
+                "pictures of the base view alone, without an anchor picture: none came in that "
+                "time, so it is appended as it comes",
+                m_dependentClip, static_cast<int64_t>(DVD_TIME_TO_MSEC(base->pts)), alone);
+      break;
+    case KODI::MULTIVIEW::Join::APPEND:
+      break;
+  }
+
+  const int size{base->iSize};
+  MergeViews(base, dependent);
+  // (there was no memory for it, and MergeViews() said so)
+  if (base->iSize == size)
+    return WentAlone(base);
+
+  // Hades: one line when the pairing starts
+  if (m_pairedInClip++ == 0)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxBluray3D - clip {:05}: the second view is paired with the base view, "
+              "from {} ms on",
+              m_dependentClip, static_cast<int64_t>(DVD_TIME_TO_MSEC(base->pts)));
+
+  return base;
+}
+
 DemuxPacket* CDVDDemuxBluray3D::Read()
 {
   if (!m_base)
@@ -447,9 +536,15 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
 
   CheckDependentView();
 
-  if (!m_dependent || packet->pts == DVD_NOPTS_VALUE)
+  if (!m_dependent)
     return packet;
 
+  // Hades: with a second view open, every way out without it is a picture that went on alone
+  // (WentAlone()): one without a time, which cannot be paired; one of a clip that was given
+  // up; and one that the second view did not meet.
+  if (packet->pts == DVD_NOPTS_VALUE || m_placingGivenUp)
+    return WentAlone(packet);
+
   // Hades: (see ReadDependent())
   m_readsLeft = KODI::MULTIVIEW::DISC_READS_PER_PICTURE;
 
@@ -479,15 +574,24 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
     DemuxPacket* dependent{m_pendingDependent};
     m_pendingDependent = nullptr;
     m_unmergedBase = 0;
+    // (Hades: the two views met)
+    m_placedWithoutPair = 0;
 
-    // Hades: one line when the pairing starts
-    if (m_pairedInClip++ == 0)
-      CLog::Log(LOGINFO,
-                "CDVDDemuxBluray3D - clip {:05}: the second view is paired with the base view, "
-                "from {} ms on",
-                m_dependentClip, static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
+    return Append(packet, dependent);
+  }
 
-    return MergeViews(packet, dependent);
+  // Hades: one line when the second view ends before the base view does
+  if (m_dependentEnded && !m_loggedEnded && !m_aborted)
+  {
+    m_loggedEnded = true;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxBluray3D - clip {:05}: {}; the pictures of the base view that still "
+              "come go on alone",
+              m_dependentClip,
+              m_dependentEndedAtEnd
+                  ? "the second view has ended (the end of its clip was reached)"
+                  : "the second view cannot be read any further (a read failed before the end "
+                    "of its clip)");
   }
 
   // The dependent view is ahead and the base view has yet to catch up, which never lasts
@@ -500,17 +604,32 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
        std::abs(packet->pts - m_lastRealignPts) > REALIGN_INTERVAL))
   {
     m_lastRealignPts = packet->pts;
-    m_resyncPending = true;
-    // Hades: one line each time
-    CLog::Log(LOGINFO,
-              "CDVDDemuxBluray3D - clip {:05}: {} pictures in a row went on without their second "
-              "view; it is placed again at the base view ({} ms)",
-              m_dependentClip, m_unmergedBase,
-              static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
+    if (KODI::MULTIVIEW::PlacedAgain(m_placedWithoutPair))
+    {
+      ++m_placedWithoutPair;
+      m_resyncPending = true;
+      // Hades: one line each time
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - clip {:05}: {} pictures in a row went on without their "
+                "second view; it is placed again at the base view ({} ms)",
+                m_dependentClip, m_unmergedBase,
+                static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
+    }
+    else
+    {
+      // Hades: each placing is a seek in the clip and a read of it. A clip that was placed
+      // again and again without the two views ever meeting is left alone.
+      m_placingGivenUp = true;
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - clip {:05}: its second view was placed {} times at the "
+                "base view and never met it; the base view of this clip plays alone until a "
+                "seek ({} ms)",
+                m_dependentClip, m_placedWithoutPair,
+                static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
+    }
   }
-  ++m_aloneInClip;
 
-  return packet;
+  return WentAlone(packet);
 }
 
 void CDVDDemuxBluray3D::CheckDependentView()
@@ -527,8 +646,18 @@ void CDVDDemuxBluray3D::CheckDependentView()
     if (m_dependent)
       CloseDependentView();
     m_unopenableClip = -1;
+    // Hades: one line when that begins, not one for each picture
+    if (m_secondViewNamed != 0)
+    {
+      m_secondViewNamed = 0;
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - play item {} has no second view ({}): its base view plays "
+                "alone",
+                playItem, why ? why : "its playlist names none");
+    }
     return;
   }
+  m_secondViewNamed = 1;
 
   if (m_dependent && static_cast<int>(clip) == m_dependentClip)
     return;
@@ -559,6 +688,13 @@ void CDVDDemuxBluray3D::FlushDependent()
   m_resyncPending = true;
   m_lastRealignPts = DVD_NOPTS_VALUE;
   m_unopenableClip = -1;
+
+  // Hades: after a seek or a flush the second view is appended as at the start of a clip
+  // (KODI::MULTIVIEW::Rejoin), and a clip that was left alone gets another chance
+  m_rejoin = {};
+  m_placedWithoutPair = 0;
+  m_placingGivenUp = false;
+  m_loggedEnded = false;
 }
 
 void CDVDDemuxBluray3D::PlaceDependent(double targetMs)
