From c37f881e053d0fae9c3a376a8094a2a48b3305df Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:36:11 +0000
Subject: [PATCH] [application] Count the passes of the interface that miss one
 refresh while a video plays

Issue #3 (cinema-ONE, RX 7600, a profile 7 FEL video in native Dolby Vision at 23.976 Hz): with the
Settings window open all frames kept up, and the longest gap between frames was 42 ms but for one
of 83 ms as that window opened, one refresh missed on its first frame. What that frame waited on
was promised to be looked at; the log of that run was not sent, only the figures.

The line of the minute about the interface counts the passes of its loop that took more than two
refresh periods while a video plays (CVideoPasses, from the earlier commit that counts them), with
how the longest one went (processing messages, frame move, render) and the windows on top. That
bound misses exactly this case: a pass that waits for the flip of its frame takes a whole number of
refreshes, so the pass in which the loop misses one takes two, 83.4 ms at 23.976 Hz, and "more than
two periods" counted it or not by a millisecond. The bound is now 1.5 periods
(CVideoPasses::MISSED_PERIODS), that of the frames' own figures ("presentations over 1.5 refresh
periods"), in the class and in CountPassForFluency(); the line says "passes took more than 1.5
refresh periods".

What that pass did is not known yet. Read in the code: the Settings window is KEEP_IN_MEMORY
(CGUIWindowSettings), so its skin file is loaded and its controls made the first time it opens in
a session, on the thread that also presents the frames of the video, and kodi.log says when
("Loading skin file: Settings.xml, load type: KEEP_IN_MEMORY"); its textures are loaded as it is
first drawn. Whether that is the 83 ms, and which part, is what the next log of that case says:
the line of the minute names the window and splits the pass, for example (figures made up)

  ; with a video playing, 1 passes took more than 1.5 refresh periods (the longest 83 ms, of
  refreshes of 41.7 ms, 12.3 s before this line: process 2, frame move 70, render 11; window 10004
  (Settings.xml))

Nothing else of the loop changes.

Host test (videopasses_missed_test, 8 checks): 42 and 62 ms at 23.976 Hz are not counted, 63 and 83
are, 25 ms at 60 Hz is not and 26 ms is, and the line; with the header before, 4 of them fail. The
videopasses_test checked that 83 ms is not counted, the rule before; its copy is changed to 62 ms.
---
 xbmc/application/Application.cpp |  5 +++--
 xbmc/application/Application.h   |  2 +-
 xbmc/application/VideoPasses.h   | 18 ++++++++++++++----
 3 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index aa21f90..74e0878 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1742,14 +1742,15 @@ void CApplication::CountPassForFluency(std::chrono::steady_clock::time_point now
                                        long long renderMs)
 {
   ReportFluency(now);
-  // Hades: a pass of more than two refresh periods while a video plays is a refresh that the loop
+  // Hades: a pass of more than 1.5 refresh periods while a video plays is a refresh that the loop
   // itself missed (the frames' own figures do not say why): counted, the longest with how its time
   // went and the windows on top (CVideoPasses)
   const auto winSystem = CServiceBroker::GetWinSystem();
   const float fps = winSystem ? winSystem->GetGfxContext().GetFPS() : 0.0f;
   const double periodMs = fps > 0.0f ? 1000.0 / static_cast<double>(fps) : 0.0;
   const long long tookMs = PassMs(took);
-  if (took < FLUENCY_PASS && !(periodMs > 0.0 && tookMs > 2.0 * periodMs))
+  if (took < FLUENCY_PASS &&
+      !(periodMs > 0.0 && static_cast<double>(tookMs) > CVideoPasses::MISSED_PERIODS * periodMs))
     return;
   // (the loop is paced by the frames of a video that plays: they have their own figures)
   const auto appPlayer = GetComponent<CApplicationPlayer>();
diff --git a/xbmc/application/Application.h b/xbmc/application/Application.h
index 0b364d7..56b7e7d 100644
--- a/xbmc/application/Application.h
+++ b/xbmc/application/Application.h
@@ -281,7 +281,7 @@ protected:
     unsigned int addonEntries = 0; //!< times FrameMove() let calls of add-ons in
     long long addonMs = 0; //!< the time the interface waited for them there
     long long addonLongestMs = 0;
-    //! Hades: with a video playing, the passes over two refresh periods (VideoPasses.h)
+    //! Hades: with a video playing, the passes over 1.5 refresh periods (VideoPasses.h)
     CVideoPasses video;
   };
   Fluency m_fluency;
diff --git a/xbmc/application/VideoPasses.h b/xbmc/application/VideoPasses.h
index cf55385..1968384 100644
--- a/xbmc/application/VideoPasses.h
+++ b/xbmc/application/VideoPasses.h
@@ -13,8 +13,9 @@
 #include <string>
 
 /*!
- * \brief Hades diagnostics: the passes of the interface loop that took more than two refresh
- *        periods while a video plays (CApplication::CountPassForFluency())
+ * \brief Hades diagnostics: the passes of the interface loop that took more than one and a half
+ *        refresh periods while a video plays, so that the loop missed a refresh
+ *        (CApplication::CountPassForFluency())
  *
  * A video paces the loop by its frames: a pass takes one refresh, and the figures of the frames
  * (the line of every 10 s of native Dolby Vision output) say when a frame came late. What they do
@@ -25,10 +26,19 @@
  * (processing the messages, the frame move of the windows, the render) and the window and dialog
  * on top, for that line.
  *
+ * One missed refresh is enough: a pass that waits for the flip of its frame takes a whole number
+ * of refreshes, so the pass in which one is missed takes two, and a bound of two periods counted
+ * it or not by a millisecond either way. Issue #3 (cinema-ONE, RX 7600): frames 83 ms apart once,
+ * as the Settings window opened over a native Dolby Vision video at 23.976 Hz, and nothing else
+ * longer than 42 ms. The bound is that of the frames' own figures ("over 1.5 refresh periods").
+ *
  * This class only counts; a test builds it on the host.
  */
 struct CVideoPasses
 {
+  //! a pass is counted when it took more than this many refresh periods
+  static constexpr double MISSED_PERIODS = 1.5;
+
   unsigned int count = 0;
   long long longestMs = 0;
   double periodMs = 0.0; //!< of the refresh of the longest
@@ -47,7 +57,7 @@ struct CVideoPasses
              long long renderedMs,
              int64_t nowMs)
   {
-    if (!(refreshMs > 0.0) || static_cast<double>(tookMs) <= 2.0 * refreshMs)
+    if (!(refreshMs > 0.0) || static_cast<double>(tookMs) <= MISSED_PERIODS * refreshMs)
       return false;
     ++count;
     if (tookMs <= longestMs)
@@ -72,7 +82,7 @@ struct CVideoPasses
       std::snprintf(split, sizeof(split), ": process %lld, frame move %lld, render %lld", processMs,
                     frameMoveMs, renderMs);
     std::snprintf(text, sizeof(text),
-                  "; with a video playing, %u passes took more than two refresh periods (the "
+                  "; with a video playing, %u passes took more than 1.5 refresh periods (the "
                   "longest %lld ms, of refreshes of %.1f ms, %.1f s before this line%s; window %s)",
                   count, longestMs, periodMs, static_cast<double>(nowMs - atMs) / 1000.0, split,
                   windows.empty() ? "none" : windows.c_str());
-- 
