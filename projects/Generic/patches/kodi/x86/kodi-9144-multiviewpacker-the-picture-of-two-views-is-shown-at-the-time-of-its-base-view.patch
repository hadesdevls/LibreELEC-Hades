From 1bfd25f420bc61cee8c149d24508009a90bd90a7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] MultiviewPacker: the picture of two views is shown at the
 time of its base view

Kodi shows a picture at the time that the decoder guesses for it
(best_effort_timestamp), which FFmpeg takes from the presentation times
unless they look faulty, and then from the decoding times. The decoder
of both views gives two pictures with one presentation time, one for
each view, and that counts as a fault: on a host, with packets that
carry decoding times, a picture after each start and each flush came out
with its decoding time there.

The picture that goes on is given the presentation time of its base
view, which is the time its two views were paired by.
---
 xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
index 31e74e4..91bdc98 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -106,6 +106,12 @@ bool CMultiviewPacker::Pack(const AVFrame* base, const AVFrame* other)
     av_frame_unref(m_packed);
     return false;
   }
+  // The picture is shown at the presentation time of its base view, the time that the two
+  // views were paired by. Kodi shows a picture at the time that the decoder guesses for it,
+  // and for this decoder the guess is not that time everywhere: it takes a time that comes
+  // twice, once for each view, for a fault of the stream, and may then go by decoding times.
+  if (base->pts != AV_NOPTS_VALUE)
+    m_packed->best_effort_timestamp = base->pts;
 
   // a base view that goes out alone is what both eyes see
   const AVFrame* second = other ? other : base;
