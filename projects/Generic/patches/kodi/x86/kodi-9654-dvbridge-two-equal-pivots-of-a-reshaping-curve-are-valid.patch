From fc72deb9e020647bdccbd063318c8cf77a90f8f5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 8 Nov 2026 23:52:47 +0000
Subject: [PATCH] dvbridge: two equal pivots of a reshaping curve are valid

ETSI GS CCM 001 makes each pivot of a reshaping curve the one before it
plus pred_pivot_value, which can be 0, and picks the piece of a sample by
the first pivot above it (5.4.2.2): the piece between two equal pivots is
picked only for a sample below the first pivot where the first two are
equal, which is mapped at that pivot (5.4.2.3). dvbridge_map_color()
refused such metadata as if the pivots had to increase, so every picture
of a stream whose RPU repeats a pivot was refused, and after two seconds
of that native output gave way to the base layer in HDR10. Pivots that go
down are still refused.

Why dvbridge_map_color() does not map metadata is now a fixed text
(dvbridge_map_color_refused()), which the render gives as its refusal:
kodi.log says it once a stream ("the Dolby Vision metadata of a frame
cannot be sent natively: ..."), where it said only "render rejected
stage=metadata-validation-or-reconstruction".
---
 tools/dvbridge/dvbridge_placebo.c | 54 ++++++++++++++++++++-----------
 tools/dvbridge/dvbridge_placebo.h |  4 +++
 tools/dvbridge/dvbridge_render.c  |  5 ++-
 3 files changed, 44 insertions(+), 19 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 479d6a1..b97f9a4 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -220,51 +220,69 @@ bool dvbridge_hdr10_static_mapped(struct dvbridge_hdr10_static *out, const void
     return true;
 }
 
-bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
-                       size_t bytes, bool enhancement_layer_paired, bool *residual_omitted)
+/* Hades: why the metadata of a picture cannot be mapped, a fixed text; NULL when they can */
+static const char *color_refusal(const AVDOVIMetadata *m, size_t bytes)
 {
-    if (residual_omitted)
-        *residual_omitted = false;
-    if (!out || !metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata))
-        return false;
-    const AVDOVIMetadata *m = metadata;
     if (!dvbridge_dv_readable(m, bytes))
-        return false;
+        return "the metadata do not read as FFmpeg lays them out (their regions or blocks)";
     const AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
     const AVDOVIDataMapping *map = av_dovi_get_mapping(m);
     const AVDOVIColorMetadata *color = av_dovi_get_color(m);
     if (h->bl_bit_depth < 8 || h->bl_bit_depth > 16 || h->coef_log2_denom > 30)
-        return false;
+        return "a base layer of a bit depth outside 8 to 16, or coefficients of over 30 fractional bits";
     if (!h->disable_residual_flag &&
         (h->el_bit_depth < 8 || h->el_bit_depth > 16 ||
          map->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ))
-        return false;
+        return "a residual of a bit depth outside 8 to 16, or not quantized with NLQ_LINEAR_DZ";
     for (int c = 0; c < 3; ++c) {
         const AVDOVIReshapingCurve *curve = &map->curves[c];
         if (curve->num_pivots < 2 || curve->num_pivots > 9)
-            return false;
+            return "a reshaping curve of fewer than 2 or more than 9 pivots";
         if (!color->ycc_to_rgb_offset[c].den)
-            return false;
+            return "an offset of YCCtoRGB without a denominator";
+        /* Hades: two pivots can be the same: ETSI GS CCM 001 makes each one the one before plus
+         * pred_pivot_value, which can be 0, and picks the piece between them only for a sample below
+         * the first pivot where the first two are the same (5.4.2.2), mapped at that pivot (5.4.2.3) */
         for (int p = 0; p < curve->num_pivots; ++p) {
             if (curve->pivots[p] >= (1u << h->bl_bit_depth) ||
-                (p && curve->pivots[p] <= curve->pivots[p - 1]))
-                return false;
+                (p && curve->pivots[p] < curve->pivots[p - 1]))
+                return "pivots of a reshaping curve above the codes of the base layer, or going down";
         }
         for (int p = 0; p + 1 < curve->num_pivots; ++p) {
             if (curve->mapping_idc[p] == AV_DOVI_MAPPING_POLYNOMIAL) {
                 if (curve->poly_order[p] > 2)
-                    return false;
+                    return "a polynomial piece of an order over 2";
             } else if (curve->mapping_idc[p] == AV_DOVI_MAPPING_MMR) {
                 if (curve->mmr_order[p] < 1 || curve->mmr_order[p] > 3)
-                    return false;
+                    return "an MMR piece of an order outside 1 to 3";
             } else {
-                return false;
+                return "a piece of a mapping that is neither polynomial nor MMR";
             }
         }
     }
     for (int i = 0; i < 9; ++i)
         if (!color->ycc_to_rgb_matrix[i].den || !color->rgb_to_lms_matrix[i].den)
-            return false;
+            return "a coefficient of YCCtoRGB or RGBtoLMS without a denominator";
+    return NULL;
+}
+
+const char *dvbridge_map_color_refused(const void *metadata, size_t bytes)
+{
+    if (!metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata))
+        return "no metadata, or metadata out of their alignment";
+    return color_refusal(metadata, bytes);
+}
+
+bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
+                       size_t bytes, bool enhancement_layer_paired, bool *residual_omitted)
+{
+    if (residual_omitted)
+        *residual_omitted = false;
+    if (!out || !metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata))
+        return false;
+    const AVDOVIMetadata *m = metadata;
+    if (color_refusal(m, bytes))
+        return false;
     struct dvbridge_color candidate = {0};
     pl_map_avdovi_metadata(&candidate.color, &candidate.repr, &candidate.dovi, m);
     if (candidate.dovi.nlq_active && !enhancement_layer_paired) {
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index dfc0a77..d1e0133 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -132,6 +132,10 @@ bool dvbridge_hdr10_static_mapped(struct dvbridge_hdr10_static *out, const void
  * resynchronizes the layer. */
 bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
                        size_t bytes, bool enhancement_layer_paired, bool *residual_omitted);
+/* Hades: why dvbridge_map_color() does not map these metadata, a fixed text (the same reason is the
+ * same text, for a log that says each once); NULL where it maps them. Not the refusal of a FEL
+ * picture without its layer and without residual_omitted. */
+const char *dvbridge_map_color_refused(const void *metadata, size_t bytes);
 /* Hades: the level 1 of the metadata with the offsets of their level 3 block added where SMPTE ST
  * 2094-10:2021 6.1.9 allows it (struct dvbridge_level1 in dvbridge_core.h). Without a level 3 block, or
  * with one whose sums break 6.1.9, min, max and avg are those of level 1 exactly as libplacebo maps them
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index e889a53..3fff97f 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1314,8 +1314,11 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     if (packed && r->low_latency)
         return false;
     struct dvbridge_color mapped;
-    if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
+    if (!map_layers(r, &mapped, source, metadata, bytes, &paired)) {
+        /* Hades: why, for the log (a base layer of another depth is a note of its own) */
+        r->refused = dvbridge_map_color_refused(metadata, bytes);
         return false;
+    }
     r->residual_drawn = paired && mapped.dovi.nlq_active;
     /* Hades: the transport of this picture: the source transport (the composer's picture), where that
      * covers the picture (render_source()); else converted to BT.2020, below (always so for
-- 
2.53.0

