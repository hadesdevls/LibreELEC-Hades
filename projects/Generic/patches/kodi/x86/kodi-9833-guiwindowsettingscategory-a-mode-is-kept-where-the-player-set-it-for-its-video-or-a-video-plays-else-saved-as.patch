diff --git a/xbmc/settings/windows/SettingsWindowResize.h b/xbmc/settings/windows/SettingsWindowResize.h
index 41426f2..bdd1775 100644
--- a/xbmc/settings/windows/SettingsWindowResize.h
+++ b/xbmc/settings/windows/SettingsWindowResize.h
@@ -18,20 +18,22 @@
  * (CDisplaySettings::OnSettingChanging(): "Keep display mode?", 15 s), in a dialog that runs a
  * loop of its own on the thread of the interface, inside the change of mode.
  *
- * While the player is active, the mode is the player's: the one it chose for the video (its frame
- * rate, Dolby Vision). Saved, it became the resolution of the interface that the player goes back
- * to when the video stops. And VideoPlayer asks for the mode of a video it opens from its own
- * thread, before the video stream is open, waiting until the thread of the interface has set it
- * (TMSG_SETVIDEORESOLUTION): the question held the player in that wait, 15 s with the question on
- * the screen, or for good where the message that playback started reached the interface inside
- * the loop of the question. Its busy dialog (CGUIDialogBusy::WaitOnEvent(), which ends once the
- * player shows the video) then ran its own loop above that one, and the question could never
- * return: no video was ever shown, and stopping waited for the player for good, the interface
- * frozen with it.
+ * A mode that the player sets for its video (its frame rate, Dolby Vision) is not the resolution of
+ * the interface: saved, it became the one that the player goes back to when the video stops. And
+ * VideoPlayer asks for the mode of a video it opens from its own thread, before the video stream is
+ * open, waiting until the thread of the interface has set it (TMSG_SETVIDEORESOLUTION): the
+ * question held the player in that wait, 15 s with the question on the screen, or for good where
+ * the message that playback started reached the interface inside the loop of the question. Its
+ * busy dialog (CGUIDialogBusy::WaitOnEvent(), which ends once the player shows the video) then ran
+ * its own loop above that one, and the question could never return: no video was ever shown, and
+ * stopping waited for the player for good, the interface frozen with it.
  *
- * The player is active from the moment it opens a file (IsPlaying()), and has a video only once
- * that mode is set (IsPlayingVideo(), which was what was asked before, and is not true yet when
- * the mode for the first video of a file changes).
+ * So the mode is kept, and nobody is asked, where the player sets it for its video
+ * (KODI::WINDOWING::CVideoModeChange: VideoPlayer when it opens one, before it has a video, and
+ * CRenderManager during playback), and while a video plays (IsPlayingVideo(): a mode during
+ * playback is not the one of the interface, the next video of a list included). Anything else is
+ * Kodi's case, also while music plays: a mode that the window system set by itself (a display
+ * plugged in again, its modes read again) is saved, and the user asked to keep it.
  */
 class CSettingsWindowResize
 {
@@ -39,14 +41,20 @@ public:
   enum class Step
   {
     NOTHING, //!< the window is not active, or the mode is the resolution of the interface already
-    KEEP, //!< the mode is the player's: the resolution of the interface stays (said in kodi.log)
+    KEEP_PLAYER_MODE, //!< the player set the mode for its video: kept (said in kodi.log)
+    KEEP_VIDEO_PLAYS, //!< a video plays: the mode is not taken for the interface (said in kodi.log)
     SAVE, //!< the mode becomes the resolution of the interface, as Kodi does
   };
 
-  static constexpr Step Of(bool windowActive, bool modeDiffers, bool playerActive)
+  static constexpr Step Of(bool windowActive,
+                           bool modeDiffers,
+                           bool playerSetsVideoMode,
+                           bool videoPlays)
   {
     if (!windowActive || !modeDiffers)
       return Step::NOTHING;
-    return playerActive ? Step::KEEP : Step::SAVE;
+    if (playerSetsVideoMode)
+      return Step::KEEP_PLAYER_MODE;
+    return videoPlays ? Step::KEEP_VIDEO_PLAYS : Step::SAVE;
   }
 };
