diff --git a/xbmc/windowing/VideoModeChange.h b/xbmc/windowing/VideoModeChange.h
new file mode 100644
index 0000000..b573fcf
--- /dev/null
+++ b/xbmc/windowing/VideoModeChange.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <atomic>
+
+namespace KODI::WINDOWING
+{
+
+/*!
+ * \brief Hades: the player sets the mode of the display for its video, now
+ *
+ * VideoPlayer asks for the mode of a video that it opens from its own thread, before its video
+ * stream is open (CVideoPlayer::OpenVideoStream(): CGraphicContext::SetVideoResolution(), which the
+ * thread of the interface carries out, TMSG_SETVIDEORESOLUTION), and CRenderManager sets it again
+ * on the thread of the interface during playback (UpdateResolution()). The change of mode is told
+ * to every window inside that call (GUI_MSG_WINDOW_RESIZE), and a window that would take the mode
+ * for something else asks here whether the player is the one that set it: the settings window
+ * saves a mode as the resolution of the interface only where it is not the player's
+ * (CSettingsWindowResize). Each such call of the player is made under a CScope; any thread asks.
+ */
+class CVideoModeChange
+{
+public:
+  //! The player sets the mode of its video while this lives
+  class CScope
+  {
+  public:
+    CScope() { Count().fetch_add(1, std::memory_order_acq_rel); }
+    ~CScope() { Count().fetch_sub(1, std::memory_order_acq_rel); }
+    CScope(const CScope&) = delete;
+    CScope& operator=(const CScope&) = delete;
+  };
+
+  //! Whether the player sets the mode of its video now (any thread)
+  static bool Now() { return Count().load(std::memory_order_acquire) > 0; }
+
+private:
+  static std::atomic<int>& Count()
+  {
+    static std::atomic<int> count{0};
+    return count;
+  }
+};
+
+} // namespace KODI::WINDOWING
