From f5094e19e93e27caa0fc31b0b386bf6293577a07 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:30:50 +0000
Subject: [PATCH] tools/dvbridge: Dolby Vision sent as HDR10+, fewer changes
 within a scene

Within a scene the metadata sent follow the statistics of its pictures
measured so far, which move most in its first pictures: 51 changes per 1000
pictures on Cosmos Laundromat. A change now also needs 24 measured pictures
since the last one (one second at 24 Hz), unless a value moves by more than
64 codes of 4095 in PQ, which goes at once (params.interval, big_step).

Measured against the ideal of each scene (every pixel, all of its pictures,
float64), with the first picture of a scene waiting for its own measurement
(next commit); error in InfoFrame codes over the eight values sent, changes
within a scene per 1000 pictures:
- Cosmos Laundromat (100 scenes): no interval 2.868 / 45.7; 24 and 64 in PQ
  2.914 / 30.8, the error of the version before (2.916 / 51.3) with two
  fifths fewer changes; an interval alone costs more (12: 3.034 / 24.1, 24:
  3.231 / 16.0); 16 in PQ with 24 and 64: 2.882 / 35.5.
- The base layer of a profile 7 test stream (21 scenes of its RPU, its
  brightness drifting within them): 3.848 / 20.5 without, 3.854 / 20.5 with;
  16 in PQ with 24 and 64 would make 29.5 changes there.
24 and 64 is the one that has fewer changes in both, for no more error than
before in either.
---
 tools/dvbridge/dvbridge_dvplus.c | 15 ++++++++++++---
 tools/dvbridge/dvbridge_dvplus.h |  3 +++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_dvplus.c b/tools/dvbridge/dvbridge_dvplus.c
index 3e4a563..cd6af46 100644
--- a/tools/dvbridge/dvbridge_dvplus.c
+++ b/tools/dvbridge/dvbridge_dvplus.c
@@ -13,8 +13,10 @@ const uint8_t dvbridge_dvplus_percentages[DVBRIDGE_DVPLUS_PLACES] = {1, 5, 10, 2
 static const double QUANTILES[DVBRIDGE_DVPLUS_PLACES] = {0.01, 0, 0, 0.25, 0.50, 0.75, 0.90, 0.95, 0.9998};
 
 /* (measured, dvbridge_dvplus.h: of the steps tried, 32 in PQ with no step in codes moved what is sent least for what
- * it costs against the ideal) */
-const struct dvbridge_dvplus_params dvbridge_dvplus_default_params = {.hysteresis = 0, .pq_step = 32, .lost = 48};
+ * it costs against the ideal; and 24 measured pictures between two changes within a scene, unless a value moves by more
+ * than 64 in PQ, two fifths fewer changes for the same error) */
+const struct dvbridge_dvplus_params dvbridge_dvplus_default_params = {
+    .hysteresis = 0, .pq_step = 32, .lost = 48, .interval = 24, .big_step = 64};
 
 #define RING 64
 
@@ -28,6 +30,7 @@ struct dvbridge_dvplus {
     uint64_t count;
     double sum;
     unsigned pictures;
+    unsigned since_change; /* measured pictures of the scene since what is sent last changed */
     /* the picture presented last */
     bool presented;
     double last_pts;
@@ -268,6 +271,7 @@ bool dvbridge_dvplus_present(struct dvbridge_dvplus *m, double pts, const struct
         m->count = 0;
         m->sum = 0;
         m->pictures = 0;
+        m->since_change = 0;
         memset(m->hist, 0, sizeof(m->hist));
         ++m->counts.scenes;
     }
@@ -355,12 +359,17 @@ bool dvbridge_dvplus_measured(struct dvbridge_dvplus *m, const struct dvbridge_d
     ++m->counts.measured;
     struct dvbridge_dvplus_stats made;
     dvbridge_dvplus_stats_of(m->hist, DVBRIDGE_DVPLUS_BINS, m->count, m->sum, &made);
+    ++m->since_change;
     if (m->pictures == 1 || !m->have) {
         /* the scene's own, from its first picture measured */
         m->sent = made;
         m->have = true;
-    } else if (moves(&made, &m->sent, m->params.hysteresis, m->params.pq_step)) {
+        m->since_change = 0;
+    } else if (moves(&made, &m->sent, m->params.hysteresis, m->params.pq_step) &&
+               (m->since_change >= m->params.interval ||
+                (m->params.big_step && moves(&made, &m->sent, m->params.hysteresis, m->params.big_step)))) {
         m->sent = made;
+        m->since_change = 0;
         ++m->counts.changes;
     }
     return true;
diff --git a/tools/dvbridge/dvbridge_dvplus.h b/tools/dvbridge/dvbridge_dvplus.h
index 12caf57..f181b9b 100644
--- a/tools/dvbridge/dvbridge_dvplus.h
+++ b/tools/dvbridge/dvbridge_dvplus.h
@@ -86,6 +86,9 @@ struct dvbridge_dvplus_params {
     /* pictures presented in a row without a measurement taken: from there on nothing is sent (the display is sent
      * HDR10) until a measurement comes again */
     unsigned lost;
+    /* within a scene, measured pictures since the last change before the next one may be made (0: any time), unless a
+     * value moves by more than big_step in PQ (12-bit codes; 0: never) */
+    unsigned interval, big_step;
 };
 extern const struct dvbridge_dvplus_params dvbridge_dvplus_default_params;
 
-- 
