From 7d690c6c93080a679c9353e5a58da06869185cbd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 01:54:42 +0000
Subject: [PATCH] tools/dvbridge: measured HDR10: a drifting shot followed, a
 late cut signalled

Two things that the measurement of HDR10 as Dolby Vision did wrong.

The average of a scene was that of all of its pictures so far. Within a
long shot whose brightness drifts, which no cut divides (a fade, a
sunrise), it lags further and further behind the picture. On the profile 7
test stream decoded as HDR10, which brightens slowly over two minutes with
no cut to see, the average sent was 593 codes off the level 1 that Dolby's
own metadata give each of its 15 scenes. It is now the average of the last
192 pictures of the scene (avg_window; about 8 seconds at 24 pictures a
second), with the step as before: 149 codes off there, and on Cosmos
Laundromat 66 codes off on average against 65, with 787 changes within the
shots against 734 (the shots there are mostly shorter than the window).

A cut among pictures that are given and not taken (measured only after
their presentation, which is what Kodi does when no picture is queued
ahead of the one presented) changed the level 1 without a scene refresh.
The refresh now goes with the first picture taken after the cut, a
picture late.
---
 tools/dvbridge/dvbridge_measured.c | 41 ++++++++++++++++++++++--------
 tools/dvbridge/dvbridge_measured.h | 15 +++++++----
 2 files changed, 40 insertions(+), 16 deletions(-)

diff --git a/tools/dvbridge/dvbridge_measured.c b/tools/dvbridge/dvbridge_measured.c
index 043975c..f4370e1 100644
--- a/tools/dvbridge/dvbridge_measured.c
+++ b/tools/dvbridge/dvbridge_measured.c
@@ -14,12 +14,16 @@
 #define KEPT 32 /* pictures given and not yet taken, at most */
 
 const struct dvbridge_measured_params dvbridge_measured_default_params = {
-    .cut = 0.05f, .motion = 2.5f, .step = 0.7f, .avg_step = 24, .max_step = 16, .min_step = 4,
+    .cut = 0.05f, .motion = 2.5f, .step = 0.7f, .avg_step = 24, .max_step = 16, .min_step = 4, .avg_window = 192,
 };
 
 struct scene {
     double max, min, sum;
     unsigned n;
+    /* the averages of its last pictures (params avg_window), oldest at recent_at once it is full */
+    float recent[DVBRIDGE_MEASURED_AVG_WINDOW_MAX];
+    double recent_sum;
+    unsigned recent_n, recent_at;
 };
 
 struct dvbridge_measured {
@@ -35,6 +39,7 @@ struct dvbridge_measured {
     float last_grid[DVBRIDGE_MEASURED_GRID];
     struct scene scene;
     struct dvbridge_measured_l1 sent;
+    bool late_cut; /* a cut among pictures not taken: the next picture taken refreshes the scene */
     /* the grid differences of the last pictures (not of flashes), for the median that tells motion */
     float changes[12];
     unsigned changes_n, changes_at;
@@ -43,8 +48,11 @@ struct dvbridge_measured {
 struct dvbridge_measured *dvbridge_measured_create(const struct dvbridge_measured_params *params)
 {
     struct dvbridge_measured *m = calloc(1, sizeof(*m));
-    if (m)
+    if (m) {
         m->p = params ? *params : dvbridge_measured_default_params;
+        if (m->p.avg_window > DVBRIDGE_MEASURED_AVG_WINDOW_MAX)
+            m->p.avg_window = DVBRIDGE_MEASURED_AVG_WINDOW_MAX;
+    }
     return m;
 }
 
@@ -219,7 +227,8 @@ static unsigned code(double v)
 /* level 1 of a scene, clamped as dovi_tool clamps a level 1 block for CM v2.9 (as dvbridge_hdr10plus.c) */
 static void codes(const struct scene *s, unsigned out[3])
 {
-    unsigned mn = code(s->min), mx = code(s->max), avg = code(s->n ? s->sum / s->n : 0);
+    const double mean = s->recent_n ? s->recent_sum / s->recent_n : s->n ? s->sum / s->n : 0;
+    unsigned mn = code(s->min), mx = code(s->max), avg = code(mean);
     mn = mn > 12 ? 12 : mn;
     mx = mx < 2081 ? 2081 : mx;
     avg = avg < 819 ? 819 : avg;
@@ -230,7 +239,7 @@ static void codes(const struct scene *s, unsigned out[3])
     out[2] = avg;
 }
 
-static void scene_add(struct scene *s, const struct dvbridge_measured_picture *p)
+static void scene_add(struct scene *s, const struct dvbridge_measured_picture *p, unsigned window)
 {
     if (!p->content)
         return; /* (a black picture: nothing to measure; the scene keeps what it had) */
@@ -240,6 +249,15 @@ static void scene_add(struct scene *s, const struct dvbridge_measured_picture *p
         s->min = p->min;
     s->sum += p->avg;
     ++s->n;
+    if (window) {
+        if (s->recent_n == window) {
+            s->recent_sum -= s->recent[s->recent_at];
+            s->recent[s->recent_at] = p->avg;
+            s->recent_at = (s->recent_at + 1) % window;
+        } else
+            s->recent[s->recent_n++] = p->avg;
+        s->recent_sum += p->avg;
+    }
 }
 
 static float median(const float *v, unsigned n)
@@ -287,7 +305,7 @@ static bool step(struct dvbridge_measured *m, unsigned i)
     }
     if (cut)
         memset(&m->scene, 0, sizeof(m->scene));
-    scene_add(&m->scene, p);
+    scene_add(&m->scene, p, m->p.avg_window);
     /* what the scene is known to be: so far, and the pictures measured after this one that are of it */
     struct scene known = m->scene;
     const float *before = flash ? m->last_grid : p->grid;
@@ -296,7 +314,7 @@ static bool step(struct dvbridge_measured *m, unsigned i)
         if (is_cut(m, before, &m->kept[j], j + 1 < m->count ? &m->kept[j + 1] : NULL,
                    mad(m->kept[j].grid, before), &other))
             break;
-        scene_add(&known, &m->kept[j]);
+        scene_add(&known, &m->kept[j], m->p.avg_window);
         if (!other)
             before = m->kept[j].grid;
     }
@@ -344,17 +362,18 @@ bool dvbridge_measured_take(struct dvbridge_measured *m, double pts, struct dvbr
 {
     if (!m || !l1)
         return false;
-    /* (pictures given before it and not presented: into the scene as they were) */
+    /* (pictures given before it and not presented, or measured after their presentation: into the scene as they
+     * were; a cut among them is signalled now, on the first picture presented after it) */
     while (m->count && m->kept[0].pts < pts - 1e-6 * fabs(pts) - 1e-9)
-        step(m, 0);
+        m->late_cut = step(m, 0) || m->late_cut;
     bool found = m->count && fabs(m->kept[0].pts - pts) <= 1e-6 * fabs(pts) + 1e-9;
     bool cut = false;
     if (found)
         cut = step(m, 0);
     *l1 = m->sent;
-    l1->refresh = found && cut;
-    if (!found)
-        l1->refresh = false;
+    l1->refresh = m->sent.measured && (cut || m->late_cut);
+    if (m->sent.measured)
+        m->late_cut = false;
     return found && m->sent.measured;
 }
 
diff --git a/tools/dvbridge/dvbridge_measured.h b/tools/dvbridge/dvbridge_measured.h
index 92b58fe..438289f 100644
--- a/tools/dvbridge/dvbridge_measured.h
+++ b/tools/dvbridge/dvbridge_measured.h
@@ -5,8 +5,8 @@
  * metadata of its studio: what is sent is measured by Hades on each picture, in real time, as ST 2094-10:2021 6.1
  * defines level 1 (the reduced pixel set of 2x2 means of R'G'B', over the active area: min of minRGB, mean and max
  * of maxRGB, in PQ), and held per scene as Dolby Vision metadata are: a scene cut that is detected refreshes the
- * scene, and within a scene the level 1 block changes only when the scene so far says otherwise by more than a
- * step. The active area (level 5) is the area of the picture that is ever not black. Nothing else is sent: no
+ * scene, and within a scene the level 1 block changes only when the scene so far (for the average, its last
+ * pictures) says otherwise by more than a step. The active area (level 5) is the area of the picture that is ever not black. Nothing else is sent: no
  * trims (there is no colourist's grade to translate), no level 3 (CCM 001 reserves it).
  *
  * This part decides from the measurements (dvbridge_measure.c makes them on the GPU); it holds no GL. The
@@ -53,10 +53,14 @@ struct dvbridge_measured_picture {
  * motion times the median of the last 12 such differences (a camera or a scene that moves differs much every
  * picture); where the picture after it is measured as well, that one has to be within step of it (a cut is a step:
  * the next picture is of the new scene) and away from the one before by more than cut (else it was one bright
- * picture: a flash, no cut). */
+ * picture: a flash, no cut). The average of a scene is that of its last avg_window pictures (0: of all of them):
+ * within a long shot whose brightness drifts (a fade, a sunrise) the average of the whole shot so far lags behind
+ * the picture, and no cut tells it to start again. */
+#define DVBRIDGE_MEASURED_AVG_WINDOW_MAX 256
 struct dvbridge_measured_params {
     float cut, motion, step;
     unsigned avg_step, max_step, min_step; /* within a scene, the level 1 sent changes by more than these (codes) */
+    unsigned avg_window; /* pictures, at most DVBRIDGE_MEASURED_AVG_WINDOW_MAX; 0: the whole scene */
 };
 
 /* What a picture is sent with */
@@ -81,8 +85,9 @@ bool dvbridge_measured_reduce(struct dvbridge_measured *m, const struct dvbridge
 /* A picture measured, in the order of presentation (one with the time of one given before replaces it) */
 void dvbridge_measured_add(struct dvbridge_measured *m, const struct dvbridge_measured_picture *picture);
 /* The metadata of the picture of pts, which is presented now: pictures before it that were given and not taken
- * (not presented) go into the scene as they were. false: it was not measured; *l1 then holds what was sent
- * last (measured false when nothing was), without a refresh. */
+ * (not presented, or measured too late for their presentation) go into the scene as they were, and a cut among
+ * them refreshes the scene on this picture (a cut found late). false: it was not measured; *l1 then holds what
+ * was sent last (measured false when nothing was), with a refresh only for such a cut. */
 bool dvbridge_measured_take(struct dvbridge_measured *m, double pts, struct dvbridge_measured_l1 *l1);
 /* The block columns that the next measurements are to be made over: those of the active area known now, all
  * of them before any is known */
-- 
2.53.0

