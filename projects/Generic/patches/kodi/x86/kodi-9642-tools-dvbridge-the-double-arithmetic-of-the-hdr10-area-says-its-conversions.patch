From b7a1ba400ad45e6b3c35a61f2dbdc46621c89c47 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:58:44 +0000
Subject: [PATCH] tools/dvbridge: the double arithmetic of the HDR10+ area says
 its conversions

The four subtractions of a float of the source rectangle from a double were promoted implicitly, which -Wdouble-promotion reports. They are written as conversions to double now; the code that is compiled is the same instruction for instruction.
---
 tools/dvbridge/dvbridge_dvplus.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_dvplus.c b/tools/dvbridge/dvbridge_dvplus.c
index 845366c..00b7935 100644
--- a/tools/dvbridge/dvbridge_dvplus.c
+++ b/tools/dvbridge/dvbridge_dvplus.c
@@ -214,8 +214,8 @@ void dvbridge_dvplus_area(const void *metadata, size_t size, int width, int heig
     if (!(x1 > x0) || !(y1 > y0))
         return;
     const double sx = dst[2] / (src[2] - src[0]), sy = dst[3] / (src[3] - src[1]);
-    const int ax0 = dst[0] + (int)ceil((x0 - src[0]) * sx - 1e-6), ax1 = dst[0] + (int)floor((x1 - src[0]) * sx + 1e-6);
-    const int ay0 = dst[1] + (int)ceil((y0 - src[1]) * sy - 1e-6), ay1 = dst[1] + (int)floor((y1 - src[1]) * sy + 1e-6);
+    const int ax0 = dst[0] + (int)ceil((x0 - (double)src[0]) * sx - 1e-6), ax1 = dst[0] + (int)floor((x1 - (double)src[0]) * sx + 1e-6);
+    const int ay0 = dst[1] + (int)ceil((y0 - (double)src[1]) * sy - 1e-6), ay1 = dst[1] + (int)floor((y1 - (double)src[1]) * sy + 1e-6);
     if (ax1 - ax0 < 2 || ay1 - ay0 < 1)
         return;
     area[0] = ax0;
-- 
