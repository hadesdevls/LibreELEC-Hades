From 354777127970f9a5abbc0162944c93c6f0ca0a86 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Thu, 22 Oct 2026 02:36:55 +0200
Subject: [PATCH] [guilib] Keep dirty regions independently of the buffer age

Dirty regions were dropped after the current buffer age plus one
frames. The buffer age varies between frames though, e.g. KWin
alternates between ages 2 and 6, so an older buffer could miss
regions that were already dropped and show stale content.

Keep the regions for a fixed number of presented frames instead, only
age them when a frame was presented, and redraw the regions the
current buffer is missing. As before, they are redrawn for one more
frame, as some platforms report a fixed buffer age. Buffers older than
that are fully redrawn.
---
 xbmc/guilib/DirtyRegion.h          |  2 ++
 xbmc/guilib/DirtyRegionTracker.cpp |  9 +++++++--
 xbmc/guilib/DirtyRegionTracker.h   |  2 +-
 xbmc/guilib/GUIWindowManager.cpp   | 24 ++++++++++++++++++------
 xbmc/guilib/GUIWindowManager.h     |  1 +
 5 files changed, 29 insertions(+), 9 deletions(-)

diff --git a/xbmc/guilib/DirtyRegion.h b/xbmc/guilib/DirtyRegion.h
index 51af101..4373a28 100644
--- a/xbmc/guilib/DirtyRegion.h
+++ b/xbmc/guilib/DirtyRegion.h
@@ -20,6 +20,8 @@ public:
   CDirtyRegion() : CRect() { m_age = 0; }
 
   int UpdateAge() { return ++m_age; }
+  int GetAge() const { return m_age; }
+
 private:
   int m_age;
 };
diff --git a/xbmc/guilib/DirtyRegionTracker.cpp b/xbmc/guilib/DirtyRegionTracker.cpp
index 7bd5ca9..8df7fff 100644
--- a/xbmc/guilib/DirtyRegionTracker.cpp
+++ b/xbmc/guilib/DirtyRegionTracker.cpp
@@ -16,6 +16,7 @@
 #include "utils/log.h"
 
 #include <algorithm>
+#include <iterator>
 #include <stdio.h>
 
 CDirtyRegionTracker::CDirtyRegionTracker()
@@ -65,12 +66,16 @@ const CDirtyRegionList &CDirtyRegionTracker::GetMarkedRegions() const
   return m_markedRegions;
 }
 
-CDirtyRegionList CDirtyRegionTracker::GetDirtyRegions()
+CDirtyRegionList CDirtyRegionTracker::GetDirtyRegions(int maxAge)
 {
   CDirtyRegionList output;
 
+  CDirtyRegionList input;
+  std::ranges::copy_if(m_markedRegions, std::back_inserter(input),
+                       [maxAge](const CDirtyRegion& r) { return r.GetAge() <= maxAge; });
+
   if (m_solver)
-    m_solver->Solve(m_markedRegions, output);
+    m_solver->Solve(input, output);
 
   return output;
 }
diff --git a/xbmc/guilib/DirtyRegionTracker.h b/xbmc/guilib/DirtyRegionTracker.h
index 5776a15..30784ff 100644
--- a/xbmc/guilib/DirtyRegionTracker.h
+++ b/xbmc/guilib/DirtyRegionTracker.h
@@ -19,7 +19,7 @@ public:
   void MarkDirtyRegion(const CDirtyRegion &region);
 
   const CDirtyRegionList &GetMarkedRegions() const;
-  CDirtyRegionList GetDirtyRegions();
+  CDirtyRegionList GetDirtyRegions(int maxAge);
   void CleanMarkedRegions(int bufferAge);
 
 private:
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index 561f8a3..15eafdb 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -71,6 +71,12 @@
 #include <chrono>
 #include <mutex>
 
+namespace
+{
+// buffers older than this are fully redrawn
+constexpr int MAX_BUFFER_AGE = 10;
+} // namespace
+
 // Dialog includes
 #include "music/dialogs/GUIDialogMusicOSD.h"
 #include "music/dialogs/GUIDialogVisualisationPresetList.h"
@@ -1442,12 +1448,14 @@ bool CGUIWindowManager::Render()
       CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_guiVisualizeDirtyRegions;
   if (visualizeDirtyRegions)
     bufferAge = 20;
-  if (bufferAge)
-    m_tracker.CleanMarkedRegions(bufferAge + 1);
-  else
-    m_tracker.CleanMarkedRegions(10);
+  // the buffer age counts presented frames and varies between frames, so keep the regions
+  // independently of it and only age them when a frame was presented
+  if (m_presentedFrame)
+    m_tracker.CleanMarkedRegions(MAX_BUFFER_AGE + 1);
+  m_presentedFrame = false;
 
-  CDirtyRegionList dirtyRegions = m_tracker.GetDirtyRegions();
+  // one frame more than needed, as some platforms report a fixed buffer age
+  CDirtyRegionList dirtyRegions = m_tracker.GetDirtyRegions(bufferAge + 1);
 
   bool hasRendered = false;
   // If we visualize the regions we will always render the entire viewport
@@ -1459,7 +1467,10 @@ bool CGUIWindowManager::Render()
     RenderPass();
     hasRendered = true;
   }
-  else if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_guiAlgorithmDirtyRegions == DIRTYREGION_SOLVER_FILL_VIEWPORT_ON_CHANGE)
+  else if (bufferAge > MAX_BUFFER_AGE ||
+           CServiceBroker::GetSettingsComponent()
+                   ->GetAdvancedSettings()
+                   ->m_guiAlgorithmDirtyRegions == DIRTYREGION_SOLVER_FILL_VIEWPORT_ON_CHANGE)
   {
     if (!dirtyRegions.empty())
     {
@@ -1494,6 +1505,7 @@ bool CGUIWindowManager::Render()
       CGUITexture::DrawQuad(i, 0x4c00ff00);
   }
 
+  m_presentedFrame |= hasRendered;
   return hasRendered;
 }
 
diff --git a/xbmc/guilib/GUIWindowManager.h b/xbmc/guilib/GUIWindowManager.h
index 8b123b0..957e98d 100644
--- a/xbmc/guilib/GUIWindowManager.h
+++ b/xbmc/guilib/GUIWindowManager.h
@@ -316,4 +316,5 @@ private:
 
   CDirtyRegionList m_dirtyregions;
   CDirtyRegionTracker m_tracker;
+  bool m_presentedFrame{false};
 };
-- 
