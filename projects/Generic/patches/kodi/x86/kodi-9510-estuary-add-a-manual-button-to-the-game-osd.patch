From 8d7af76dbca3d69e3c0f2df51bbe83d2bd7d2d94 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 2 Oct 2026 17:00:18 +0100
Subject: [PATCH] Estuary: Add a Manual button to the game OSD

Manuals are read and found by an add-on, script.game.manuals, in the
same way shader presets and cheats come from add-ons. The button offers
to install or enable it when it is missing, using Kodi's own prompts,
and then opens the playing game's manual in the same press.

(cherry picked from commit a86d77bfb1e2d29f9e95826391aa5659f5278c21)
---
 addons/resource.language.en_gb/resources/strings.po | 8 +++++++-
 addons/skin.estuary/xml/GameOSD.xml                 | 9 +++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index e55966a..0810213 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -19635,7 +19635,13 @@ msgctxt "#35309"
 msgid "Rewind"
 msgstr ""
 
-#empty strings from id 35310 to 35319
+#. Label of the Manual button in the game OSD, which shows the game's instruction booklet
+#: addons/skin.estuary/xml/GameOSD.xml
+msgctxt "#35310"
+msgid "Manual"
+msgstr ""
+
+#empty strings from id 35311 to 35319
 
 #. Label of the Cheats button in the game OSD, heading of the cheats dialog, and
 #. of the cheats group in settings
diff --git a/addons/skin.estuary/xml/GameOSD.xml b/addons/skin.estuary/xml/GameOSD.xml
index a6331ab..c00e8e6 100644
--- a/addons/skin.estuary/xml/GameOSD.xml
+++ b/addons/skin.estuary/xml/GameOSD.xml
@@ -149,6 +149,15 @@
 							<description>Always show Achievements; its dialog explains sign-in requirements and missing achievement sets.</description>
 							<onclick>ActivateWindow(GameAchievements)</onclick>
 						</include>
+						<include content="GameOSDMenuButton">
+							<param name="id" value="1119" />
+							<param name="label" value="$LOCALIZE[35310]" />
+							<param name="icon" value="osd/fullscreen/buttons/information.png" />
+							<description>Manuals are shown by script.game.manuals, which is offered for install or enabling on first use. Every condition is read before any action runs, so the manual still opens in the same press once the add-on is installed or enabled.</description>
+							<onclick condition="!System.HasAddon(script.game.manuals)">InstallAddon(script.game.manuals)</onclick>
+							<onclick condition="System.HasAddon(script.game.manuals) + !System.AddonIsEnabled(script.game.manuals)">EnableAddon(script.game.manuals)</onclick>
+							<onclick>RunScript(script.game.manuals,game=$ESCINFO[Player.FilenameAndPath],title=$ESCINFO[RetroPlayer.Title])</onclick>
+						</include>
 						<include content="GameOSDMenuButton">
 							<param name="id" value="1118" />
 							<param name="label" value="$LOCALIZE[35320]" />
-- 
2.53.0

