diff --git a/xbmc/guilib/guiinfo/GUIInfoLabels.h b/xbmc/guilib/guiinfo/GUIInfoLabels.h
index 3fa64fd..915abb8 100644
--- a/xbmc/guilib/guiinfo/GUIInfoLabels.h
+++ b/xbmc/guilib/guiinfo/GUIInfoLabels.h
@@ -1081,6 +1081,9 @@ constexpr uint32_t LISTITEM_FIRST_SUBTITLE_LANGUAGE = LISTITEM_START + 229;
 constexpr uint32_t LISTITEM_FIRST_AUDIO_CODEC      = LISTITEM_START + 230;
 constexpr uint32_t LISTITEM_FIRST_AUDIO_CHANNELS   = LISTITEM_START + 231;
 constexpr uint32_t LISTITEM_ISDEFAULTVIDEOVERSION_NAME = LISTITEM_START + 232;
+constexpr uint32_t LISTITEM_PLATFORM                 = LISTITEM_START + 233;
+constexpr uint32_t LISTITEM_DEVELOPER                = LISTITEM_START + 234;
+constexpr uint32_t LISTITEM_PUBLISHER                = LISTITEM_START + 235;
 
 constexpr int      LISTITEM_END                      = LISTITEM_START + 2500;
 
diff --git a/xbmc/guilib/guiinfo/GamesGUIInfo.cpp b/xbmc/guilib/guiinfo/GamesGUIInfo.cpp
index 0299344..dc9b73a 100644
--- a/xbmc/guilib/guiinfo/GamesGUIInfo.cpp
+++ b/xbmc/guilib/guiinfo/GamesGUIInfo.cpp
@@ -110,6 +110,52 @@ bool CGamesGUIInfo::GetLabel(std::string& value,
 {
   switch (info.GetInfo())
   {
+    ///////////////////////////////////////////////////////////////////////////////////////////////
+    // LISTITEM_*
+    ///////////////////////////////////////////////////////////////////////////////////////////////
+    case LISTITEM_TITLE:
+    case LISTITEM_YEAR:
+    case LISTITEM_GENRE:
+    case LISTITEM_PLOT:
+    case LISTITEM_PLATFORM:
+    case LISTITEM_DEVELOPER:
+    case LISTITEM_PUBLISHER:
+    {
+      if (item == nullptr || !item->HasGameInfoTag())
+        break;
+
+      const CGameInfoTag* tag = item->GetGameInfoTag();
+
+      switch (info.GetInfo())
+      {
+        case LISTITEM_TITLE:
+          value = tag->GetTitle();
+          break;
+        case LISTITEM_YEAR:
+          if (tag->GetYear() > 0)
+            value = std::to_string(tag->GetYear());
+          break;
+        case LISTITEM_GENRE:
+          value =
+              StringUtils::Join(tag->GetGenres(), info.GetData3().empty() ? ", " : info.GetData3());
+          break;
+        case LISTITEM_PLOT:
+          value = tag->GetOverview();
+          break;
+        case LISTITEM_PLATFORM:
+          value = tag->GetPlatform();
+          break;
+        case LISTITEM_DEVELOPER:
+          value = tag->GetDeveloper();
+          break;
+        case LISTITEM_PUBLISHER:
+          value = tag->GetPublisher();
+          break;
+        default:
+          break;
+      }
+      return !value.empty();
+    }
     ///////////////////////////////////////////////////////////////////////////////////////////////
     // RETROPLAYER_*
     ///////////////////////////////////////////////////////////////////////////////////////////////
diff --git a/xbmc/guilib/test/TestGamesGUIInfo.cpp b/xbmc/guilib/test/TestGamesGUIInfo.cpp
index 3ae9ce2..064e9af 100644
--- a/xbmc/guilib/test/TestGamesGUIInfo.cpp
+++ b/xbmc/guilib/test/TestGamesGUIInfo.cpp
@@ -200,3 +200,63 @@ TEST_F(TestGamesGUIInfo, InitCurrentItemSetsTitleFromVfsHostnamePath)
   ASSERT_NE(tag, nullptr);
   EXPECT_EQ(tag->GetTitle(), "test");
 }
+
+TEST_F(TestGamesGUIInfo, AnswersListItemLabelsFromTheGameTag)
+{
+  CFileItem item{"/roms/test.rom", false};
+  CGameInfoTag* tag = item.GetGameInfoTag();
+  tag->SetTitle("Chrono Trigger");
+  tag->SetYear(1995);
+  tag->SetGenres({"Role-playing", "Adventure"});
+  tag->SetOverview("A band of adventurers travels through time.");
+
+  CGUIInfoManager infoManager;
+
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, LISTITEM_TITLE), "Chrono Trigger");
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, LISTITEM_YEAR), "1995");
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, LISTITEM_GENRE), "Role-playing, Adventure");
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, LISTITEM_PLOT),
+            "A band of adventurers travels through time.");
+}
+
+TEST_F(TestGamesGUIInfo, AnswersListItemLabelsForAGamesMakers)
+{
+  CFileItem item{"/roms/test.rom", false};
+  CGameInfoTag* tag = item.GetGameInfoTag();
+  tag->SetPlatform("Super Nintendo");
+  tag->SetDeveloper("Square");
+  tag->SetPublisher("Square");
+
+  CGUIInfoManager infoManager;
+
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, infoManager.TranslateString("ListItem.Platform")),
+            "Super Nintendo");
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, infoManager.TranslateString("ListItem.Developer")),
+            "Square");
+  EXPECT_EQ(infoManager.GetItemLabel(&item, 0, infoManager.TranslateString("ListItem.Publisher")),
+            "Square");
+}
+
+TEST_F(TestGamesGUIInfo, JoinsGenresWithTheSkinsSeparator)
+{
+  CFileItem item{"/roms/test.rom", false};
+  item.GetGameInfoTag()->SetGenres({"Role-playing", "Adventure"});
+
+  CGamesGUIInfo gamesGUIInfo;
+  std::string value;
+
+  EXPECT_TRUE(gamesGUIInfo.GetLabel(value, &item, 0, CGUIInfo(LISTITEM_GENRE, " / ", 0), nullptr));
+  EXPECT_EQ(value, "Role-playing / Adventure");
+}
+
+TEST_F(TestGamesGUIInfo, LeavesItemsWithoutAGameTagAlone)
+{
+  CFileItem item{"/videos/test.mkv", false};
+
+  CGamesGUIInfo gamesGUIInfo;
+  std::string value;
+
+  EXPECT_FALSE(gamesGUIInfo.GetLabel(value, &item, 0, CGUIInfo(LISTITEM_TITLE), nullptr));
+  EXPECT_FALSE(gamesGUIInfo.GetLabel(value, &item, 0, CGUIInfo(LISTITEM_PLATFORM), nullptr));
+  EXPECT_FALSE(item.HasGameInfoTag());
+}
