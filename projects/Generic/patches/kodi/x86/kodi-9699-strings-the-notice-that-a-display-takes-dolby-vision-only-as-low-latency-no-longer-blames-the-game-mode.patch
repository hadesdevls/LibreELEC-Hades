From d92d3e29d9a98e3c4e7f0bb02d846c22c9a68b3f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:55:49 +0000
Subject: [PATCH] strings: the notice that a display takes Dolby Vision only as
 Low-Latency no longer blames the game mode

The notice said "turn off the game settings of the TV input" as if that were the cause. Some
displays offer Dolby Vision only as Low-Latency whatever the input (a Sony of 2020 does), and
for them that advice does nothing. The notice now says the fact (a display takes it only as
Low-Latency, which some displays do and a TV input does in its game mode) and what to do
(turn on Dolby Vision Low-Latency in System > Display). Core 39872 and Estuary 31922, with
the Spanish of es_es, es_ar and es_mx.
---
 addons/resource.language.en_gb/resources/strings.po           | 2 +-
 .../skin.estuary/language/resource.language.en_gb/strings.po  | 2 +-
 .../skin.estuary/language/resource.language.es_ar/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_es/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_mx/strings.po  | 4 ++--
 5 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 4163051..7c4147f 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25775,7 +25775,7 @@ msgstr ""
 #. output driver can send it (one sentence: the details are in the log); translated in Estuary (#31922)
 #: xbmc/windowing/gbm/WinSystemGbm.cpp
 msgctxt "#39872"
-msgid "The display takes only Dolby Vision Low-Latency: turn it on in System > Display, or turn off the game settings of the TV input."
+msgid "The display takes Dolby Vision only as Low-Latency, which some displays do and a TV input does in its game mode. Turn on Dolby Vision Low-Latency in System > Display to use it."
 msgstr ""
 
 #. Hades: label of setting "videoscreen.hadesdvhdmi14b"; translated in Estuary (#31923)
diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
