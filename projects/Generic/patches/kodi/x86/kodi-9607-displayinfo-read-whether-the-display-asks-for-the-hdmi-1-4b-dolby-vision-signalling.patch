From 7e8271d26e3c3b3cfb3c89c360c09296b5db9602 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:25:30 +0000
Subject: [PATCH] DisplayInfo: read whether the display asks for the HDMI 1.4b
 Dolby Vision signalling

A display whose Dolby VSVDB is of version 0, the 15-byte version 1 form, or the 12-byte version 1
form with the low-latency field 0 does not take the Dolby vendor InfoFrame of the Standard mode:
it asks for the older signalling, the HDMI 1.4b vendor InfoFrame (24 bytes, OUI 00-0C-03, with the
HDMI_VIC of 3840x2160 at 24, 25 and 30 Hz) with the same tunnel. That is what the HDMI transmitter
of Amlogic sends for those forms (hdmitx_set_vsif_pkt(): "ver0 and ver1_15 and ver1_12bit with
ll= 0 use hdmi 1.4b VSIF"). Those TVs (2016 LG OLED among them) get HDR10 today, and Kodi says
"older signalling (HDMI 1.4b), not sent".

ScanDolbyVideo() now also says whether the display asks for it, the verdict that native output
needs to send it later, behind a setting:

- hdmi14bAsked: every block of the EDID valid as the function already requires (sizes, header,
  each checksum, CTA blocks and data blocks inside their block, over all of the blocks), exactly
  one Dolby VSVDB, and it is version 0 of 26 bytes, version 1 of 15 bytes, or version 1 of 12
  bytes with the low-latency field 0;
- hdmi14b: and a video capability data block with QS anywhere in the EDID (a payload of two bytes,
  as the kernel reads it), which the full range RGB of the tunnel's AVI InfoFrame needs, as for
  the Standard tunnel;
- hdmi14bAt2160p60: the 2160p60 bit of the block;
- hdmi14bDmVersion: the display management version, of version 1 its field + 2 as dmVersion, of
  version 0 the major version of its version byte (2.8 and 2.12 in the blocks known): a display of
  2 or 3 is sent the content mapping v2.9 part of the metadata, as the others of those versions.

CDisplayInfo gives them as SupportsHdmi14bDolbyVision(), SupportsHdmi14bDolbyVision2160p60() and
Hdmi14bDolbyVisionDmVersion(). The verdict is read once the walk has gone over every block; every
field that the function returned before keeps its value, and nothing uses the new ones yet.

Tested on the host: of the 603 EDIDs of the corpus, 42 ask
(30 of the 15-byte version 1 form, 10 of version 0, 2 of the 12-byte one with the low-latency field
0), 41 of them with QS, the same files as the scanner of the study; on those EDIDs and 913 258
mutations of them, every field of the function of before is the same and the verdict is that of a
reference written for the test. 13 of 13 mutations of the new code are caught.
---
 xbmc/utils/DisplayInfo.cpp | 33 +++++++++++++++++++++++++++++++++
 xbmc/utils/DisplayInfo.h   | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 267622c..a00dad2 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -38,6 +38,13 @@ namespace
 //   same Dolby vendor InfoFrame (0 there, the 15-byte form and version 0 mean the HDMI 1.4b
 //   vendor InfoFrame), of any display management version (Hades: a display of 2 or 3 is sent the
 //   content mapping v2.9 part of the metadata, which it reads: dvbridge_set_display_management()).
+// - Hades: the HDMI 1.4b vendor InfoFrame with the tunnel of the Standard mode is what the HDMI
+//   transmitter of Amlogic sends for the other forms (hdmitx_set_vsif_pkt(): "ver0 and ver1_15 and
+//   ver1_12bit with ll= 0 use hdmi 1.4b VSIF"), which its EDID reader takes as version 0 with a
+//   payload of 0x19 bytes and version 1 with 0x0E, or 0x0B with the low-latency field 0
+//   (hdmi14bAsked). With QS in a video capability data block anywhere in the EDID, as the Standard
+//   tunnel needs it (hdmi14b). Read at the end of the walk, which goes over every block and checks
+//   each as above; nothing else of the result depends on it.
 DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
 {
   static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
@@ -47,6 +54,10 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
     return {};
   DolbyVideoBlock result;
   unsigned int found = 0;
+  // Hades: for the HDMI 1.4b verdict (at the end): the payload of the Dolby VSVDB, and whether a
+  // video capability data block says QS
+  const uint8_t* dolby = nullptr;
+  bool qs = false;
   for (size_t block = 0; block < size / 128; ++block)
   {
     const uint8_t* b = edid.data() + block * 128;
@@ -68,12 +79,17 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       const uint8_t* data = b + pos + 1;
       if (pos + len + 1 > end)
         return {};
+      // Hades: video capability data block (extended tag 0) with QS, of a payload of two bytes as
+      // the kernel reads it
+      if ((b[pos] >> 5) == 7 && len == 2 && data[0] == 0 && (data[1] & 0x40))
+        qs = true;
       // Extended vendor-specific video data block, little-endian Dolby OUI
       if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 && data[1] == 0x46 && data[2] == 0xd0 &&
           data[3] == 0)
       {
         if (++found != 1 || len < 5)
           return {};
+        dolby = data;
         result.valid = true;
         result.length = len;
         result.version = data[4] >> 5;
@@ -130,6 +146,23 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       pos += len + 1;
     }
   }
+  // Hades: the HDMI 1.4b vendor InfoFrame (above), once the whole EDID is known to be valid with
+  // this block its only Dolby VSVDB
+  if (dolby)
+  {
+    const unsigned int len = result.length;
+    if ((result.version == 0 && len == 25) || (result.version == 1 && len == 14) ||
+        (result.version == 1 && len == 11 && (dolby[7] & 3) == 0))
+    {
+      result.hdmi14bAsked = true;
+      result.hdmi14b = qs;
+      result.hdmi14bAt2160p60 = (dolby[4] & 2) != 0;
+      // Version 1: the field of dmVersion. Version 0: the byte of its major and minor version,
+      // after the flags (dolby[4]), the 12 of the primaries and the white point and the 3 of the
+      // target's levels (Amlogic's hdmi_tx_edid.c), whose major version the metadata go by
+      result.hdmi14bDmVersion = result.version == 1 ? ((dolby[4] >> 2) & 7) + 2 : dolby[20] >> 4;
+    }
+  }
   return result;
 }
 
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 59b25b5..8848a59 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -88,6 +88,21 @@ struct DolbyVideoBlock
   //! Its primaries, CIE 1931 xy of red, green and blue (version 2, and version 1 in its 12-byte
   //! form), all 0 when not read
   double redX = 0, redY = 0, greenX = 0, greenY = 0, blueX = 0, blueY = 0;
+
+  //! Hades: the block asks for the older signalling, the HDMI 1.4b vendor InfoFrame (24 bytes, OUI
+  //! 00-0C-03) with the tunnel of the Standard mode, in one of its three forms: version 0 of 26
+  //! bytes, version 1 of 15 bytes, or version 1 of 12 bytes with the low-latency field 0 (TVs of
+  //! 2016, LG OLED among them, and some later ones). Every block of the EDID valid, as above, and
+  //! the block the only Dolby VSVDB. The fields above keep what they say without it.
+  bool hdmi14bAsked = false;
+  //! ... and the EDID lets the source select the RGB quantization range (a video capability data
+  //! block with QS anywhere in it), which the full range RGB of the tunnel's AVI InfoFrame needs:
+  //! a display that native output can send that signalling to
+  bool hdmi14b = false;
+  bool hdmi14bAt2160p60 = false; //!< ... the 2160p60 bit of that block
+  //! ... the version of Dolby Vision display management of that block: of version 1, its field + 2
+  //! (as dmVersion); of version 0, its major version (2: the blocks known say 2.8 and 2.12)
+  unsigned int hdmi14bDmVersion = 0;
 };
 
 //! Hades: cd/m2 of a 12-bit PQ signal level (SMPTE ST 2084 EOTF of level / 4095), as the Dolby
@@ -145,6 +160,23 @@ public:
   {
     return m_dolbyVideo.valid && !m_dolbyVideo.standard && m_dolbyVideo.version < 2;
   }
+  //! Hades: Dolby Vision with that older signalling, over the tunnel of the Standard mode: the
+  //! block asks for it (DolbyVideoBlock::hdmi14bAsked) and the display lets the source select the
+  //! RGB range (DolbyVideoBlock::hdmi14b), the rule that the kernel backends follow for it. Native
+  //! output sends it only where the user turns it on (videoscreen.hadesdvhdmi14b): whether a
+  //! display takes it cannot be known from here.
+  bool SupportsHdmi14bDolbyVision() const { return m_dolbyVideo.hdmi14b; }
+  //! ... at 2160p above 30 Hz: with the 2160p60 bit of the block
+  bool SupportsHdmi14bDolbyVision2160p60() const
+  {
+    return m_dolbyVideo.hdmi14b && m_dolbyVideo.hdmi14bAt2160p60;
+  }
+  //! ... the version of Dolby Vision display management that its block gives (2 and up), 0 without
+  //! it: which content mapping the display reads
+  unsigned int Hdmi14bDolbyVisionDmVersion() const
+  {
+    return m_dolbyVideo.hdmi14b ? m_dolbyVideo.hdmi14bDmVersion : 0;
+  }
   //! Hades: the display takes Dolby Vision Low-Latency (DolbyVideoBlock::lowLatency), with or
   //! without the Standard mode: by the rule of the kernel backends for it (drm_dvbridge_ll_edid(),
   //! which a host test compares with this one)
-- 
2.53.0

