From 25919e76a4b9a2c395e35a3954b1cfb209fc0e25 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:06:14 +0100
Subject: [PATCH] [VideoInfoScannerArt] Look for a tv show's actor thumbs in
 its folder

Local actor thumbs, and the folder a thumb is applied to, are taken from
the parent of the item's path. That is the folder holding a file, but
for a tv show, whose item is its folder, it is the folder above it. A
show's cast was looked for in <source>/.actors rather than
<show>/.actors, and the source folder could be given the show's thumb.
Use the folder itself for a folder item.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e578d3713dca6160d8160cc1bd9f11d10e5874d9)
---
 xbmc/video/VideoInfoScannerArt.cpp       |  6 ++--
 xbmc/video/test/TestVideoInfoScanner.cpp | 39 ++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoInfoScannerArt.cpp b/xbmc/video/VideoInfoScannerArt.cpp
index 6e96a2b..f3617ab 100644
--- a/xbmc/video/VideoInfoScannerArt.cpp
+++ b/xbmc/video/VideoInfoScannerArt.cpp
@@ -396,8 +396,10 @@ void CVideoInfoScannerArt::GetArtwork(CFileItem* pItem,
 
   pItem->SetArt(art);
 
-  // parent folder to apply the thumb to and to search for local actor thumbs
-  std::string parentDir = URIUtils::GetParentPath(pItem->GetPath());
+  // parent folder to apply the thumb to and to search for local actor thumbs - a folder item (a tv
+  // show) is its own
+  const std::string parentDir{pItem->IsFolder() ? pItem->GetPath()
+                                                : URIUtils::GetParentPath(pItem->GetPath())};
   if (CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
           CSettings::SETTING_VIDEOLIBRARY_ACTORTHUMBS))
   {
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index b7b13e2..c1bec0c 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -9,6 +9,7 @@
 #include "FileItem.h"
 #include "MediaSource.h"
 #include "ServiceBroker.h"
+#include "TextureCache.h"
 #include "addons/AddonManager.h"
 #include "addons/AddonVersion.h"
 #include "addons/IAddon.h"
@@ -20,6 +21,7 @@
 #include "filesystem/File.h"
 #include "filesystem/SpecialProtocol.h"
 #include "interfaces/AnnouncementManager.h"
+#include "jobs/JobManager.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/MediaSourceSettings.h"
 #include "settings/Settings.h"
@@ -663,6 +665,16 @@ protected:
 
   void TearDown() override
   {
+    if (m_textureCache)
+    {
+      // First, as its jobs are cancelled with the job manager
+      CServiceBroker::UnregisterTextureCache();
+      CServiceBroker::GetJobManager()->CancelJobs();
+      CServiceBroker::GetJobManager()->Restart();
+      CServiceBroker::UnregisterJobManager();
+      if (m_previousJobManager)
+        CServiceBroker::RegisterJobManager(m_previousJobManager);
+    }
     Settings()->SetBool(CSettings::SETTING_MYVIDEOS_EXTRACTTHUMB, m_extractThumb);
     TestVideoInfoScanner::TearDown();
   }
@@ -688,10 +700,21 @@ protected:
     return File(folder, name);
   }
 
+  //! Caches the art a scan finds, as the cast's thumbs are, in a texture cache of the test's own
+  void UseTextureCache()
+  {
+    m_previousJobManager = CServiceBroker::GetJobManager();
+    CServiceBroker::RegisterJobManager(std::make_shared<CJobManager>());
+    CServiceBroker::RegisterTextureCache(std::make_shared<CTextureCache>());
+    m_textureCache = true;
+  }
+
   int CountShows() { return m_db.GetSingleValueInt("SELECT COUNT(*) FROM tvshow"); }
   int CountEpisodes() { return m_db.GetSingleValueInt("SELECT COUNT(*) FROM episode"); }
 
   const bool m_extractThumb{Settings()->GetBool(CSettings::SETTING_MYVIDEOS_EXTRACTTHUMB)};
+  bool m_textureCache{false};
+  std::shared_ptr<CJobManager> m_previousJobManager;
 };
 } // namespace
 
@@ -785,6 +808,22 @@ TEST_F(TestVideoInfoScannerTvShows, ABlurayRipInAShowIsOneEpisode)
   EXPECT_EQ(1, episodes[0].iEpisode);
 }
 
+TEST_F(TestVideoInfoScannerTvShows, AShowsCastHaveTheThumbsInItsActorsFolder)
+{
+  UseTextureCache();
+  // A show's item is its folder, rather than a file in the folder
+  const std::string show{Folder(m_root, "Show")};
+  File(show, "tvshow.nfo",
+       "<tvshow><title>Show</title><actor><name>Actor Name</name></actor></tvshow>");
+  const std::string thumb{File(Folder(show, ".actors"), "Actor_Name.jpg")};
+  Episode(Folder(show, "Season 1"), "Show S01E01.mkv");
+
+  Scan();
+
+  EXPECT_EQ(thumb, m_db.GetSingleValue(
+                       "SELECT url FROM art WHERE media_type = 'actor' AND type = 'thumb'"));
+}
+
 // TV shows looked up with a scraper
 
 TEST_F(TestVideoInfoScannerTvShows, AShowWhoseDetailsFailedIsLookedUpAgain)
-- 
