+    } else {
+        const uint64_t id = dvbridge_rpu_bits_ue(&b);
+        DVBRIDGE_RPU_CHECK(id, DVBRIDGE_RPU_IDS - 1);
+        struct dvbridge_rpu_mapping *m = &s->mapping[id];
+        m->known = true;
+        dvbridge_rpu_bits_ue(&b); /* mapping_color_space */
+        dvbridge_rpu_bits_ue(&b); /* mapping_chroma_format_idc */
+        unsigned pivots[3];
+        for (int c = 0; c < 3; ++c) {
+            const uint64_t n = dvbridge_rpu_bits_ue(&b);
+            DVBRIDGE_RPU_CHECK(n, 7);
+            pivots[c] = (unsigned)n + 2;
+            for (unsigned i = 0; i < pivots[c]; ++i)
