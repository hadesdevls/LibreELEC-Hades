+                m->vdr_in_max[c] = dvbridge_rpu_ue_coef(&b, w.fixed, w.denom);
+                m->slope[c] = dvbridge_rpu_ue_coef(&b, w.fixed, w.denom);
+                m->threshold[c] = dvbridge_rpu_ue_coef(&b, w.fixed, w.denom);
