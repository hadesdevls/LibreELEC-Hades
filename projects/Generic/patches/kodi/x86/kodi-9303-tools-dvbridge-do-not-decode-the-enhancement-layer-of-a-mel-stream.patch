+    } while (0)
+    /* (an RPU of another type FFmpeg passes over, and its picture keeps the RPU before) */
+    if (dvbridge_rpu_bits_get(&b, 6) != 2)
+        return b.over ? DVBRIDGE_RPU_UNREAD : DVBRIDGE_RPU_NONE;
