+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef DVBRIDGE_MEL_H
+#define DVBRIDGE_MEL_H
+/* Hades: whether the enhancement layer of a profile 7 stream is decoded.
+ *
+ * An enhancement picture adds to its picture only the residual of its NLQ (the linear dead zone of
+ * ETSI GS CCM 001; FFmpeg's AVDOVINLQParams). For a sample e of the layer, in each component,
+ *     residual = sign(e - offset) * (|e - offset| * slope + threshold)
+ * (libplacebo's sh_dovi_compose_nlq(), which folds the half step of the slope into the threshold).
+ * The bridge draws a residual where libplacebo's mapping of the metadata says nlq_active
+ * (pl_map_dovi_metadata(), which dvbridge_map_color() calls) and leaves the layer out otherwise,
+ * before it draws anything (pass_init() of libplacebo's renderer). An RPU says that its picture has
+ * no residual, whatever the samples of its layer are, exactly when that mapping draws none:
+ *   - its residual is disabled (disable_residual_flag), or
+ *   - its NLQ is the linear dead zone with, in each of the three components, nlq_offset 0,
+ *     vdr_in_max 1 (1 << coef_log2_denom), linear_deadzone_slope 0 and linear_deadzone_threshold 0
+ *     (pl_avdovi_nlq_is_trivial(); the NLQ of a minimal enhancement layer, MEL, as dovi_tool
+ *     writes it and as Kodi's strDVELType reads it for the usual denominator of 23).
+ * A slope and a threshold of 0 make the residual 0 for every sample. Any other NLQ can carry a
+ * residual (FEL), also in a picture whose layer happens to sit at the offset everywhere: such a
+ * layer is decoded.
+ *
+ * dvbridge_rpu_nlq_packet() reads that from an access unit as it comes, before it is decoded: the
+ * RPU that FFmpeg's HEVC decoder takes from it, read as ff_dovi_rpu_parse() reads it as far as the
+ * NLQ, with the mappings that earlier RPUs sent and later ones use again. What it cannot read it
+ * says so (DVBRIDGE_RPU_UNREAD), and the layer is then decoded.
+ *
+ * dvbridge_layer_need_take() decides, access unit by access unit in decoding order, whether the
+ * enhancement access unit is decoded:
+ *   - The layer stops only at one of its random-access pictures whose RPU says no residual: an
+ *     enhancement picture refers only to pictures of its own group (from a random-access picture
+ *     to the next), so no picture of a group that is being decoded loses a reference.
+ *   - The metadata of a picture whose enhancement access unit is not decoded is the RPU of that
+ *     access unit all the same (dvbridge_fel_layer_metadata()): the module keeps it, and finds what
+ *     the base decoder made of it among the base pictures it gave (dvbridge_fel_base_metadata()),
+ *     which is another one than the picture of its time when the layers are coded in different
+ *     picture order. So every picture goes out with the metadata it has when the layer is decoded.
+ *   - While the layer is not decoded, an RPU that can carry a residual (FEL) starts it again at
+ *     its next random-access picture, the first it can start at. The pictures until then go
+ *     without their residual (DVBRIDGE_LAYER_WANTED), and from then on the layer is decoded for
+ *     good in that stream: its RPUs change between MEL and FEL within groups of pictures, where
+ *     leaving the layer out loses residuals. So that loss is once a stream at most, and never
+ *     longer than until the next random-access picture of the layer.
+ *   - An access unit without an RPU of its own changes nothing (its picture keeps the RPU before).
+ * A seek, or the layer starting again for any other reason, starts it at a random-access picture
+ * again (dvbridge_layer_need_restart()); what a stream showed stays. */
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
