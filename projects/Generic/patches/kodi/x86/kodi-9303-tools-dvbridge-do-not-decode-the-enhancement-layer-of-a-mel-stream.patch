+    w.el_bit_depth = (unsigned)(el & 0xff) + 8;
+    dvbridge_rpu_bits_get(&b, 1); /* spatial_resampling_filter_flag */
+    const uint64_t dm_compression = dvbridge_rpu_bits_get(&b, 3);
+    w.dm_compression = (unsigned)dm_compression;
+    dvbridge_rpu_bits_get(&b, 1); /* el_spatial_resampling_filter_flag */
+    w.disable_bit = b.bit;
+    const bool disabled = dvbridge_rpu_bits_get(&b, 1);
+    w.dm_present = dvbridge_rpu_bits_get(&b, 1);
+    /* (FFmpeg gives up without forgetting the mappings) */
+    if (b.over || dm_compression > 1 || (dm_compression && !w.dm_present))
+        return DVBRIDGE_RPU_UNREAD;
+    const bool use_prev = dvbridge_rpu_bits_get(&b, 1);
+    const struct dvbridge_rpu_mapping *mapping;
+    if (use_prev) {
+        uint64_t id = dvbridge_rpu_bits_ue(&b);
+        DVBRIDGE_RPU_CHECK(id, DVBRIDGE_RPU_IDS - 1);
+        if (!s->mapping[id].known)
+            id = 0;
+        if (!s->mapping[id].known)
