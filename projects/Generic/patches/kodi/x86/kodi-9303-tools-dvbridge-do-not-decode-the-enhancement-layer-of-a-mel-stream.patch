+        if (mapping->offset[c] || mapping->vdr_in_max[c] != UINT64_C(1) << w.denom ||
+            mapping->slope[c] || mapping->threshold[c])
+            return DVBRIDGE_RPU_RESIDUAL;
+    }
+    return DVBRIDGE_RPU_NO_RESIDUAL;
+}
+
+/* The units of an access unit, framed with a length of length_size bytes before each (hvcC) or
+ * with start codes (0). Calls take(unit, size, context) for each, in order, until it returns
+ * false. */
+static inline void dvbridge_rpu_units(const uint8_t *data, size_t size, int length_size,
+                                      bool (*take)(const uint8_t *, size_t, void *), void *context)
+{
+    const uint8_t *end = data + size;
+    if (length_size) {
+        while ((size_t)(end - data) > (size_t)length_size) {
+            size_t length = 0;
+            for (int i = 0; i < length_size; ++i)
+                length = length << 8 | *data++;
+            if (length > (size_t)(end - data))
+                return;
+            if (length && !take(data, length, context))
+                return;
+            data += length;
+        }
+        return;
+    }
+    /* a unit runs from after a start code to the next one; the zero bytes before that are not
+     * its own (trailing_zero_8bits, and the first byte of a start code of four) */
+    const uint8_t *unit = NULL;
+    for (const uint8_t *p = data; p + 3 <= end;) {
+        if (p[0] || p[1] || p[2] != 1) {
+            ++p;
+            continue;
+        }
+        if (unit) {
+            const uint8_t *last = p;
+            while (last > unit && !last[-1])
+                --last;
+            if (last > unit && !take(unit, (size_t)(last - unit), context))
+                return;
+        }
+        p += 3;
+        unit = p;
+    }
+    if (unit) {
+        const uint8_t *last = end;
+        while (last > unit && !last[-1])
+            --last;
+        if (last > unit)
+            take(unit, (size_t)(last - unit), context);
+    }
+}
+
+struct dvbridge_rpu_find {
+    unsigned index;
+    const uint8_t *rpu;
+    size_t size;
+};
+
+/* As FFmpeg's HEVC decoder takes the RPU of an access unit (decode_nal_units()): the last unit of
+ * type 62 that is not the first unit, of layer 0 and temporal id 0, with more than its header.
+ * A unit that FFmpeg's splitting leaves out (forbidden bit, temporal id 0 coded as -1) does not
+ * count. */
+static inline bool dvbridge_rpu_find_unit(const uint8_t *unit, size_t size, void *context)
+{
+    struct dvbridge_rpu_find *f = context;
+    if (size < 2 || unit[0] & 0x80 || !(unit[1] & 7))
+        return true;
+    const unsigned type = unit[0] >> 1 & 0x3f, layer = (unit[0] & 1) << 5 | unit[1] >> 3;
+    if (f->index++ && type == 62 && !layer && (unit[1] & 7) == 1 && size > 2) {
+        f->rpu = unit;
+        f->size = size;
+    }
+    return true;
+}
+
+/* The RPU of a unit after its two header bytes, without emulation prevention (00 00 03 is 00 00),
+ * into out; at most DVBRIDGE_RPU_BYTES. */
+static inline size_t dvbridge_rpu_unescape(const uint8_t *unit, size_t size, uint8_t *out)
+{
+    size_t n = 0;
+    unsigned zeros = 0;
+    for (size_t i = 2; i < size && n < DVBRIDGE_RPU_BYTES; ++i) {
+        if (zeros >= 2 && unit[i] == 3) {
+            zeros = 0;
+            continue;
+        }
+        zeros = unit[i] ? 0 : zeros + 1;
+        out[n++] = unit[i];
+    }
+    return n;
+}
+
+/* What the RPU of the access unit of a base packet (the units of both layers and the RPU) says. */
+static inline enum dvbridge_rpu_residual dvbridge_rpu_nlq_packet(struct dvbridge_rpu_nlq *s,
+                                                                 const uint8_t *data, size_t size,
+                                                                 int length_size)
+{
+    struct dvbridge_rpu_find find = {0};
+    if (!s || !data)
+        return DVBRIDGE_RPU_UNREAD;
+    dvbridge_rpu_units(data, size, length_size, dvbridge_rpu_find_unit, &find);
+    if (!find.rpu)
+        return DVBRIDGE_RPU_NONE;
+    uint8_t rpu[DVBRIDGE_RPU_BYTES];
+    const size_t n = dvbridge_rpu_unescape(find.rpu, find.size, rpu);
+    return dvbridge_rpu_nlq_read(s, rpu, n, NULL);
+}
+
+enum dvbridge_layer_verdict {
+    DVBRIDGE_LAYER_DECODE = 0,
+    DVBRIDGE_LAYER_NOT_NEEDED, /* not decoded: its picture has no residual (MEL) */
+    DVBRIDGE_LAYER_WANTED,     /* not decoded, though its picture needs it: until the next random-
+                                  access picture of the layer */
+};
+
+struct dvbridge_layer_need {
+    bool off;      /* every access unit is decoded */
+    bool kept;     /* decoded for good in this stream; kept_why says why */
+    bool skipping; /* not decoded, from a random-access picture whose RPU says no residual on */
+    bool wanted;   /* while not decoded, a picture came that needs it */
+    enum dvbridge_rpu_residual last; /* of the last RPU since the layer started */
+    const char *kept_why;
+    unsigned stops, resumes;
+};
+
+static inline void dvbridge_layer_need_restart(struct dvbridge_layer_need *n)
+{
+    n->skipping = n->wanted = false;
+    n->last = DVBRIDGE_RPU_NONE;
+}
+
+/* rpu: what the RPU of the access unit says (dvbridge_rpu_nlq_packet()). random_access: the
+ * enhancement access unit is a random-access picture. */
+static inline enum dvbridge_layer_verdict dvbridge_layer_need_take(struct dvbridge_layer_need *n,
+                                                                    enum dvbridge_rpu_residual rpu,
+                                                                    bool random_access)
+{
+    if (n->off)
+        return DVBRIDGE_LAYER_DECODE;
+    if (rpu != DVBRIDGE_RPU_NONE)
+        n->last = rpu;
+    /* (an access unit without an RPU of its own has the one before) */
+    const bool residual = n->last == DVBRIDGE_RPU_RESIDUAL || n->last == DVBRIDGE_RPU_UNREAD;
+    if (random_access) {
+        if (n->skipping) {
+            if (!n->kept && !residual)
+                return DVBRIDGE_LAYER_NOT_NEEDED;
+            n->skipping = n->wanted = false;
+            ++n->resumes;
+            return DVBRIDGE_LAYER_DECODE;
+        }
+        if (!n->kept && rpu == DVBRIDGE_RPU_NO_RESIDUAL) {
+            n->skipping = true;
+            ++n->stops;
+            return DVBRIDGE_LAYER_NOT_NEEDED;
+        }
+        return DVBRIDGE_LAYER_DECODE;
+    }
+    if (!n->skipping)
+        return DVBRIDGE_LAYER_DECODE;
+    if (residual && !n->wanted) {
+        n->wanted = true;
+        if (!n->kept) {
+            n->kept = true;
+            n->kept_why = "an RPU that can carry a residual came in a group of pictures whose "
+                          "layer was not decoded";
+        }
+    }
+    return residual ? DVBRIDGE_LAYER_WANTED : DVBRIDGE_LAYER_NOT_NEEDED;
+}
