+
+/* An unsigned coefficient as FFmpeg's get_ue_coef() gives it, as far as what is read here asks:
+ * 0, 1 << denom, or another value. In floating point that is the number times 2^32, made an
+ * integer: 0 for less than one in magnitude, 2^32 for exactly 1.0. */
+static inline uint64_t dvbridge_rpu_ue_coef(struct dvbridge_rpu_bits *b, bool fixed, unsigned denom)
+{
+    if (fixed) {
+        const uint64_t whole = dvbridge_rpu_bits_ue(b);
+        return whole << denom | dvbridge_rpu_bits_get(b, denom);
+    }
+    union { uint32_t u; float f; } v = {.u = (uint32_t)dvbridge_rpu_bits_get(b, 32)};
+    const double times = (double)v.f * 4294967296.0;
+    return times > -1.0 && times < 1.0 ? 0 : times == 4294967296.0 ? UINT64_C(1) << 32 : UINT64_MAX;
