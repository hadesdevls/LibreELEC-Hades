+
+static inline uint64_t dvbridge_rpu_bits_get(struct dvbridge_rpu_bits *b, unsigned n)
+{
+    uint64_t value = 0;
+    if (b->over || n > 64 || b->bit + n > b->size * 8) {
+        b->over = true;
+        return 0;
+    }
+    for (unsigned i = 0; i < n; ++i, ++b->bit)
+        value = value << 1 | (b->data[b->bit >> 3] >> (7 - (b->bit & 7)) & 1);
+    return value;
