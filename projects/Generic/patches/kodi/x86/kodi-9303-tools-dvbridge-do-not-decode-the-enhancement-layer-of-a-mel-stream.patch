+    uint64_t denom = 32;
+    if (w.fixed) {
+        denom = dvbridge_rpu_bits_ue(&b);
+        if (denom < 13)
+            return dvbridge_rpu_unread(s, true);
+        DVBRIDGE_RPU_CHECK(denom, 32);
+    }
+    w.denom = (unsigned)denom;
+    dvbridge_rpu_bits_get(&b, 3); /* vdr_rpu_normalized_idc, bl_video_full_range_flag */
+    if (format & 0x700)
+        return dvbridge_rpu_unread(s, true);
+    const uint64_t bl = dvbridge_rpu_bits_ue(&b), el = dvbridge_rpu_bits_ue(&b);
+    const uint64_t vdr = dvbridge_rpu_bits_ue(&b);
+    DVBRIDGE_RPU_CHECK(bl, 8);
+    DVBRIDGE_RPU_CHECK(el & 0xff, 8);
+    DVBRIDGE_RPU_CHECK(el >> 8, 0xff);
+    DVBRIDGE_RPU_CHECK(vdr, 8);
