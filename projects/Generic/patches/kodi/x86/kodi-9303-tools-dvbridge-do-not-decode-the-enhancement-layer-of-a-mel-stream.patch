+enum dvbridge_rpu_residual {
+    DVBRIDGE_RPU_NONE = 0,    /* no RPU that the base decoder takes, or one that changes nothing */
+    DVBRIDGE_RPU_NO_RESIDUAL, /* MEL, or the residual disabled */
+    DVBRIDGE_RPU_RESIDUAL,    /* can carry a residual (FEL) */
+    DVBRIDGE_RPU_UNREAD,      /* could not be read here: as one that can */
+};
+
+/* the ids of the mappings (vdr_rpu_id), DOVI_MAX_DM_ID + 1 */
+#define DVBRIDGE_RPU_IDS 16
+/* of an RPU, without emulation prevention, the bytes that are read: the NLQ comes well before */
+#define DVBRIDGE_RPU_BYTES 4096
