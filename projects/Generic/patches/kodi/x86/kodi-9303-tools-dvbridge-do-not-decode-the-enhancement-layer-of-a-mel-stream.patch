+
+static inline void dvbridge_rpu_se_coef(struct dvbridge_rpu_bits *b, bool fixed, unsigned denom)
+{
+    if (fixed)
+        dvbridge_rpu_bits_ue(b);
+    dvbridge_rpu_bits_get(b, fixed ? denom : 32);
