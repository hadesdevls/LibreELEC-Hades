+
+/* ue(v), as get_ue_golomb_long(): at most 31 zeros before the first one */
+static inline uint64_t dvbridge_rpu_bits_ue(struct dvbridge_rpu_bits *b)
+{
+    unsigned zeros = 0;
+    while (!b->over && !dvbridge_rpu_bits_get(b, 1)) {
+        if (++zeros > 31) {
+            b->over = true;
+            return 0;
+        }
+    }
+    return b->over ? 0 : ((uint64_t)1 << zeros) - 1 + dvbridge_rpu_bits_get(b, zeros);
