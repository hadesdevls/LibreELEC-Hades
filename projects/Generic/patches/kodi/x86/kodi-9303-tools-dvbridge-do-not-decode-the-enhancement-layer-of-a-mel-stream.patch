diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index b88caec..92fd517 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: GPL-3.0-or-later */
 /* Split and hardware-decode the enhancement layer; pair surfaces by exact presentation time. */
 #include "dvbridge_fel.h"
+#include "dvbridge_mel.h"
 #include <libavcodec/bsf.h>
 #include <libavutil/dict.h>
 #include <libavutil/hwcontext.h>
@@ -67,6 +68,16 @@ static bool picture_identity(struct picture_order *order, const AVPacket *packet
 /* HEVC unit type of a Dolby Vision RPU */
 #define RPU_UNIT 62
 
+/* Hades: an RPU as coded, without its unit header and the zero bytes after it (rpu_length()) */
+struct dvbridge_fel_rpu {
+    uint8_t *data;
+    size_t size;
+};
+/* the base pictures whose metadata is kept for a picture whose enhancement access unit is not
+ * decoded (dvbridge_fel_base_metadata()): more than the base decoder holds back, and than the
+ * pictures between an access unit and the base picture it is presented with */
+#define RING_MAX 32
+
 /* As dovi_split frames what it gives: a length of this many bytes before every unit when the
  * enhancement layer has an hvcC configuration, start codes (0) otherwise. */
 static int unit_length_size(const uint8_t *data, int size)
@@ -168,6 +179,31 @@ struct dvbridge_fel {
     int64_t first_mismatch_pts;
     AVRational time_base;
     unsigned open_wait; /* base pictures to wait before opening the decoder again */
+    /* Hades: the layer is not decoded while the RPUs say that it carries no residual (MEL;
+     * dvbridge_mel.h). The RPU of each base packet is read as the base decoder reads it
+     * (base_length_size: its framing, as unit_length_size()), and each enhancement access unit
+     * that is queued has a verdict (packet_need) and the RPU that the enhancement decoder would
+     * attach to its picture, as coded (packet_rpu). One that is not decoded leaves a mark of its
+     * time with that RPU (skipped), which answers for its base picture (dvbridge_fel_take()) with
+     * what the base decoder made of the same RPU (ring: the RPUs of the last base pictures, as
+     * coded, with their metadata; dvbridge_fel_base_metadata()). */
+    int base_length_size;
+    struct dvbridge_rpu_nlq rpu;
+    struct dvbridge_layer_need need;
+    uint8_t packet_need[QUEUE_MAX];
+    struct dvbridge_fel_rpu packet_rpu[QUEUE_MAX];
+    struct { int64_t pts; uint8_t need; struct dvbridge_fel_rpu rpu; } skipped[MAP_MAX];
+    unsigned num_skipped;
+    struct { struct dvbridge_fel_rpu coded; AVBufferRef *parsed; } ring[RING_MAX];
+    unsigned next_ring;
+    /* fed: the decoder was given access units since it was opened or flushed; stopping: it was
+     * given its end, so that it gives what it holds before the layer stops being decoded;
+     * stopped: and it has given it all; resume: the next access unit that is decoded starts the
+     * layer again */
+    bool fed, stopping, stopped, resume;
+    bool marked; /* a mark was made since the layer last started */
+    unsigned not_needed, wanted;  /* base pictures that went out with a mark, by its kind */
+    unsigned decoded, not_decoded; /* enhancement access units given to the decoder, and not */
 };
 
 /* Hades: whether two times are the same but for what a time may lose on its way here. */
@@ -301,10 +337,25 @@ static enum AVPixelFormat hardware_format(AVCodecContext *ctx, const enum AVPixe
     return AV_PIX_FMT_VAAPI;
 }
 
+/* Hades: the metadata of the last base pictures, forgotten */
+static void forget_ring(struct dvbridge_fel *f)
+{
+    for (unsigned i = 0; i < RING_MAX; ++i) {
+        av_freep(&f->ring[i].coded.data);
+        f->ring[i].coded.size = 0;
+        av_buffer_unref(&f->ring[i].parsed);
+    }
+    f->next_ring = 0;
+}
+
 static void clear_queues(struct dvbridge_fel *f)
 {
-    for (unsigned i = 0; i < f->num_packets; ++i)
+    for (unsigned i = 0; i < f->num_packets; ++i) {
         av_packet_free(&f->packets[i]);
+        av_freep(&f->packet_rpu[i].data);
+    }
+    for (unsigned i = 0; i < f->num_skipped; ++i)
+        av_freep(&f->skipped[i].rpu.data);
     for (unsigned i = 0; i < f->num_frames; ++i)
         av_frame_free(&f->frames[i]);
     f->num_packets = f->num_frames = 0;
@@ -312,6 +363,8 @@ static void clear_queues(struct dvbridge_fel *f)
     f->failed = f->draining = f->sent_eof = f->eof = false;
     f->num_times = 0;
     f->reason = NULL;
+    f->num_skipped = 0;
+    f->fed = f->stopping = f->stopped = f->resume = f->marked = false;
 }
 
 void dvbridge_fel_reset(struct dvbridge_fel *f)
@@ -323,6 +376,8 @@ void dvbridge_fel_reset(struct dvbridge_fel *f)
     f->anchor_pts = AV_NOPTS_VALUE;
     f->preroll_packets = 0;
     forget_base_times(f, false);
+    /* Hades: the layer starts again at a random-access picture, decoded or not by its RPU */
+    dvbridge_layer_need_restart(&f->need);
     struct picture_order *orders[] = {&f->base_order, &f->enhancement_order};
     for (unsigned i = 0; i < 2; ++i) {
         struct picture_order *order = orders[i];
@@ -346,6 +401,7 @@ void dvbridge_fel_destroy(struct dvbridge_fel *f)
     if (!f)
         return;
     clear_queues(f);
+    forget_ring(f);
     av_parser_close(f->base_order.parser);
     av_parser_close(f->enhancement_order.parser);
     avcodec_free_context(&f->base_order.context);
@@ -384,6 +440,9 @@ struct dvbridge_fel *dvbridge_fel_create(const AVCodecParameters *p, AVRational
         goto fail;
     f->layer_length_size = unit_length_size(f->split->par_out->extradata,
                                            f->split->par_out->extradata_size);
+    /* Hades: the framing of the base packets, which the filter and the base decoder read from
+     * the same configuration */
+    f->base_length_size = unit_length_size(p->extradata, p->extradata_size);
     f->decoder = avcodec_alloc_context3(codec);
     if (!f->decoder || avcodec_parameters_to_context(f->decoder, f->split->par_out) < 0)
         goto fail;
@@ -415,7 +474,11 @@ static bool receive_frames(struct dvbridge_fel *f)
         int result = avcodec_receive_frame(f->decoder, frame);
         if (result < 0) {
             av_frame_free(&frame);
-            if (result == AVERROR_EOF)
+            /* Hades: the end that was given because the layer stops being decoded is not the
+             * end of the layer */
+            if (result == AVERROR_EOF && f->stopping)
+                f->stopped = true;
+            else if (result == AVERROR_EOF)
                 f->eof = true;
             return result == AVERROR(EAGAIN) || result == AVERROR_EOF;
         }
@@ -440,6 +503,21 @@ static bool receive_frames(struct dvbridge_fel *f)
     return true;
 }
 
+/* Hades: a mark of the time pts for an access unit that is not decoded, which takes its RPU */
+static void add_mark(struct dvbridge_fel *f, int64_t pts, uint8_t need,
+                     struct dvbridge_fel_rpu *rpu)
+{
+    if (f->num_skipped == MAP_MAX) {
+        av_freep(&f->skipped[0].rpu.data);
+        --f->num_skipped;
+        memmove(f->skipped, f->skipped + 1, f->num_skipped * sizeof(*f->skipped));
+    }
+    f->skipped[f->num_skipped].pts = pts;
+    f->skipped[f->num_skipped].need = need;
+    f->skipped[f->num_skipped++].rpu = *rpu;
+    *rpu = (struct dvbridge_fel_rpu){0};
+}
+
 static bool pump(struct dvbridge_fel *f)
 {
     if (f->failed)
@@ -463,13 +541,70 @@ static bool pump(struct dvbridge_fel *f)
             }
             break; /* A reference EL picture can precede its corresponding BL. */
         }
-        packet->pts = timed ? f->packet_time[0] : f->times[match].pts;
-        packet->dts = AV_NOPTS_VALUE;
-        int result = avcodec_send_packet(f->decoder, packet);
-        if (result == AVERROR(EAGAIN))
-            break;
-        if (result < 0)
-            goto fail;
+        const int64_t pts = timed ? f->packet_time[0] : f->times[match].pts;
+        if (f->packet_need[0] != DVBRIDGE_LAYER_DECODE) {
+            /* Hades: not decoded (dvbridge_mel.h). What the decoder holds comes out first: it
+             * was given access units that come before this random-access picture in decoding
+             * order, whose pictures are presented before it, and nothing else will make it give
+             * them. Then the access unit leaves the mark of its time. */
+            if (f->fed && !f->stopped) {
+                if (!f->stopping) {
+                    int result = avcodec_send_packet(f->decoder, NULL);
+                    if (result == AVERROR(EAGAIN))
+                        break;
+                    if (result < 0 && result != AVERROR_EOF)
+                        goto fail;
+                    f->stopping = true;
+                }
+                if (!receive_frames(f))
+                    goto fail;
+                if (!f->stopped)
+                    break; /* its pictures fill the queue: once they are taken */
+            }
+            add_mark(f, pts, f->packet_need[0], &f->packet_rpu[0]);
+            f->resume = true;
+            f->marked = true;
+            ++f->not_decoded;
+        } else {
+            if (f->resume) {
+                /* Hades: the layer is decoded again from this random-access picture on. The
+                 * decoder starts again (it gave all it held), and a base picture presented before
+                 * this one that has no mark of its own goes out without the layer, as before
+                 * the picture that a layer starts at after a seek: its leading pictures, which a
+                 * decoder that starts at it does not give. */
+                if (f->stopping && !f->stopped) {
+                    if (!receive_frames(f))
+                        goto fail;
+                    if (!f->stopped)
+                        break;
+                }
+                if (f->stopping)
+                    avcodec_flush_buffers(f->decoder);
+                f->fed = f->stopping = f->stopped = f->resume = false;
+                f->anchor_pts = timed && pts >= INT64_MIN + f->tolerance ? pts - f->tolerance : pts;
+            } else if (f->marked && f->anchor_pts != AV_NOPTS_VALUE && pts < f->anchor_pts &&
+                       f->packet_rpu[0].size) {
+                /* Hades: a leading picture of the random-access picture that the layer started
+                 * again at: it refers to pictures that were not decoded, so its picture does not
+                 * come (as after a seek) and it goes out without the layer; with the metadata of
+                 * its own access unit (a mark, which answers before that). */
+                struct dvbridge_fel_rpu copy = {av_memdup(f->packet_rpu[0].data,
+                                                          f->packet_rpu[0].size),
