From b69a660a9c921241c30ca887dee0cacfdb73ca57 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Mon, 19 Oct 2026 01:55:57 +0200
Subject: [PATCH] [guilib] Keep processing multiimages with smart redraw

The image of a multiimage has no parent control, so its fade steps never
marked the window dirty, and the timer for the next image is only
checked while the window is processed. The same applies to directories
loaded in the background, which are only picked up while the window is
processed. With smart redraw this left fades stuck halfway, and delayed
image changes and the first image until another event.

Make the multiimage the parent of its image and keep the window
processed while the next image or the directory is pending.

(cherry picked from commit 8ba868899755e0644a8b7b36678d32e2f4393db3)
---
 xbmc/guilib/GUIMultiImage.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/xbmc/guilib/GUIMultiImage.cpp b/xbmc/guilib/GUIMultiImage.cpp
index 53e77a2..e8ae25e 100644
--- a/xbmc/guilib/GUIMultiImage.cpp
+++ b/xbmc/guilib/GUIMultiImage.cpp
@@ -36,6 +36,7 @@ CGUIMultiImage::CGUIMultiImage(int parentID, int controlID, float posX, float po
   m_timePerImage = timePerImage + fadeTime;
   m_timeToPauseAtEnd = timeToPauseAtEnd;
   m_image.SetCrossFade(fadeTime);
+  m_image.SetParentControl(this);
   m_randomized = randomized;
   m_loop = loop;
   ControlType = GUICONTROL_MULTI_IMAGE;
@@ -47,6 +48,7 @@ CGUIMultiImage::CGUIMultiImage(int parentID, int controlID, float posX, float po
 CGUIMultiImage::CGUIMultiImage(const CGUIMultiImage &from)
   : CGUIControl(from), m_texturePath(from.m_texturePath), m_imageTimer(), m_files(), m_image(from.m_image)
 {
+  m_image.SetParentControl(this);
   m_timePerImage = from.m_timePerImage;
   m_timeToPauseAtEnd = from.m_timeToPauseAtEnd;
   m_randomized = from.m_randomized;
@@ -132,11 +134,18 @@ void CGUIMultiImage::Process(unsigned int currentTime, CDirtyRegionList &dirtyre
 
         m_imageTimer.StartZero();
       }
+
+      // keep the window processed until the next image is due
+      MarkDirtyRegion(DIRTY_STATE_CHILD);
     }
   }
   else if (m_directoryStatus != LOADING)
     m_image.SetFileName("");
 
+  // keep the window processed until the loaded directory is picked up
+  if (m_directoryStatus == LOADING || m_directoryStatus == LOADED)
+    MarkDirtyRegion(DIRTY_STATE_CHILD);
+
   if (CServiceBroker::GetWinSystem()->GetGfxContext().SetClipRegion(m_posX, m_posY, m_width, m_height))
   {
     if (m_image.SetColorDiffuse(m_diffuseColor))
