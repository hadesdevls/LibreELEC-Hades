+                  int *taps)
+{
+    const double t = (parity - 0.5 - shift) / 2.0;
+    const double base = floor(t + 1e-9);
+    dvbridge_source_filter(t - base, weights, first, taps);
+    *first += (int)base;
+}
+
+static bool invert3(const double m[9], double out[9])
+{
+    const double c0 = m[4] * m[8] - m[5] * m[7], c1 = m[5] * m[6] - m[3] * m[8],
+                 c2 = m[3] * m[7] - m[4] * m[6];
+    const double det = m[0] * c0 + m[1] * c1 + m[2] * c2;
+    if (!isfinite(det) || fabs(det) < 1e-9)
+        return false;
+    const double inv[9] = {c0, m[2] * m[7] - m[1] * m[8], m[1] * m[5] - m[2] * m[4],
+                           c1, m[0] * m[8] - m[2] * m[6], m[2] * m[3] - m[0] * m[5],
+                           c2, m[1] * m[6] - m[0] * m[7], m[0] * m[4] - m[1] * m[3]};
+    for (int i = 0; i < 9; ++i)
+        out[i] = inv[i] / det;
+    return true;
+}
+
+static void multiply3(const double a[9], const double b[9], double out[9])
+{
+    for (int i = 0; i < 3; ++i)
+        for (int j = 0; j < 3; ++j)
+            out[i * 3 + j] = a[i * 3] * b[j] + a[i * 3 + 1] * b[3 + j] + a[i * 3 + 2] * b[6 + j];
+}
+
+#define WHY(text) do { if (why) *why = (text); return false; } while (0)
+
+bool dvbridge_source_setup(struct dvbridge_source_params *out, const void *metadata, size_t bytes,
+                           float shift_x, float shift_y, const char **why)
+{
+    if (why)
+        *why = NULL;
+    if (!out || !metadata || bytes < sizeof(AVDOVIMetadata))
+        WHY("no metadata");
+    const AVDOVIMetadata *m = metadata;
+    const AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
+    const AVDOVIColorMetadata *c = av_dovi_get_color(m);
+    memset(out, 0, sizeof(*out));
+    /* signal_bit_depth = hdr_bit_depth (CCM 001 6.2.2), and the samples of the tunnel have 12 bits
+     * (6.4.1): a composer output of 10 bits would need a placement the clause does not give */
+    if (h->vdr_bit_depth != 12)
+        WHY("the composer's output does not have 12 bits");
+    if (c->signal_color_space != 0 && c->signal_color_space != 2)
+        WHY("the colour space of the RPU is neither YCbCr nor ICtCp (CCM 001 table 6)");
+    double yccm[9], lms[9], yccinv[9];
+    for (int i = 0; i < 9; ++i) {
+        /* the integers of the RPU, which the DM header carries as they are */
+        if (c->ycc_to_rgb_matrix[i].den != 8192 || c->rgb_to_lms_matrix[i].den != 16384 ||
+            c->ycc_to_rgb_matrix[i].num < -32768 || c->ycc_to_rgb_matrix[i].num > 32767 ||
+            c->rgb_to_lms_matrix[i].num < -32768 || c->rgb_to_lms_matrix[i].num > 32767)
+            WHY("the matrices of the RPU are not in the units of the DM header");
+        yccm[i] = c->ycc_to_rgb_matrix[i].num / 8192.0;
+        lms[i] = c->rgb_to_lms_matrix[i].num / 16384.0;
+    }
+    if (!invert3(yccm, yccinv))
+        WHY("the YCCtoRGB matrix of the RPU cannot be inverted");
+    for (int i = 0; i < 3; ++i) {
+        if (c->ycc_to_rgb_offset[i].den != (1 << 28) || c->ycc_to_rgb_offset[i].num < 0)
+            WHY("the offsets of the RPU are not in the units of the DM header");
+        out->offset[i] = (float)(c->ycc_to_rgb_offset[i].num / (double)(1 << 28));
+        /* black: the code whose value h / 2^bits is the offset (T' = 0); the nearest one where
+         * the offset is not a whole code */
+        out->black[i] = (int)((((int64_t)c->ycc_to_rgb_offset[i].num << 12) + (1 << 27)) >> 28);
+        if (out->black[i] > 4095)
+            WHY("an offset of the RPU is beyond the codes of the signal");
+    }
+    /* What Kodi draws over the video is blended in PQ BT.2020 RGB, whose LMS for the display is
+     * that of the converted transport's header (RGBtoLMS of BT.2020). The header of this transport
+     * tells the display LMS = rgb_to_lms T, T = PQ EOTF(T'), T' = ycc_to_rgb (YCC - offset): the
+     * linear BT.2020 RGB of the same LMS is RGBtoLMS_2020^-1 rgb_to_lms T (lms_forward), and back
+     * T = rgb_to_lms^-1 RGBtoLMS_2020 RGB (lms_inverse). Where rgb_to_lms is that of BT.2020
+     * (profiles 7 and 8), T is RGB and T' is R'G'B': both ways are affine in R'G'B'. */
+    static const int lms2020[9] = {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962};
+    double l2020[9], l2020inv[9], lmsinv[9], forward[9], inverse[9];
+    for (int i = 0; i < 9; ++i)
+        l2020[i] = lms2020[i] / 16384.0;
+    if (!invert3(lms, lmsinv) || !invert3(l2020, l2020inv))
+        WHY("the RGBtoLMS matrix of the RPU cannot be inverted");
+    out->affine = 1;
+    for (int i = 0; i < 9; ++i)
+        out->affine &= c->rgb_to_lms_matrix[i].num == lms2020[i];
+    multiply3(l2020inv, lms, forward);
+    multiply3(lmsinv, l2020, inverse);
+    for (int i = 0; i < 9; ++i) {
+        out->ycc_forward[i] = (float)yccm[i];
+        out->ycc_inverse[i] = (float)yccinv[i];
+        out->lms_forward[i] = (float)forward[i];
+        out->lms_inverse[i] = (float)inverse[i];
+    }
+    if (!isfinite(shift_x) || !isfinite(shift_y) || fabsf(shift_x) > 1.0f || fabsf(shift_y) > 1.0f)
+        WHY("the chroma location is not one of 4:2:0");
+    for (int parity = 0; parity < 2; ++parity)
+        place(parity, shift_y, out->vweights[parity], &out->vfirst[parity], &out->vtaps[parity]);
+    place(0, shift_x, out->hweights, &out->hfirst, &out->htaps);
+    if (out->htaps == 1 && out->hfirst == 0)
+        out->htaps = 0; /* on the even luma column already */
+    /* the sums of the shaders stay within 31 bits: of the horizontal pass over codes, and of the
+     * vertical one over codes or over the values of the horizontal one (4 fractional bits) */
+    double hsum = 0.0, vsum = 0.0;
+    for (int i = 0; i < out->htaps; ++i)
+        hsum += abs(out->hweights[i]);
+    for (int parity = 0; parity < 2; ++parity) {
+        double s = 0.0;
+        for (int i = 0; i < out->vtaps[parity]; ++i)
+            s += abs(out->vweights[parity][i]);
+        vsum = fmax(vsum, s);
+    }
+    const double read = out->htaps ? 4095.0 * hsum / (1 << (DVBRIDGE_SOURCE_WEIGHT_BITS -
+                                                           DVBRIDGE_SOURCE_FRAC_BITS)) + 1.0
+                                   : 4095.0;
+    if (4095.0 * hsum >= 2147483647.0 || vsum * read >= 2147483647.0)
+        WHY("the filter of the chroma would overflow");
+    out->bits = 12;
+    out->code_max = 4095;
+    return true;
+}
+
+/* --- the packer ---
+ *  1. (chroma that is not on the even luma column only) the chroma moved onto it, horizontally;
+ *  2. the chroma of every row of 4:2:2, from the rows of 4:2:0: in a texture of 16-bit integers
+ *     whose first half holds the even rows of the picture and its second half the odd ones, drawn
+ *     in two draws so that every fragment of one runs the same filter (one sample, or 12)
+ *     (dvbridge_source_rows());
+ *  3. where Kodi draws over the video, the picture it draws over (dvbridge_source_picture());
+ *  4. the transport: per pixel its luma, the chroma of its pair, the metadata bit
+ *     (dvbridge_source_pack()).
+ * The planes hold h / 2^bits, and passes 1, 2 and the pixels of 4 that nothing was drawn over are
+ * integer arithmetic: they get the same bytes on any GPU. */
+
+static const char VERTEX[] =
+    "#version 300 es\n"
+    "void main()\n"
+    "{\n"
+    "    vec2 position = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+    "    gl_Position = vec4(position * 2.0 - 1.0, 0.0, 1.0);\n"
+    "}\n";
+
+/* 1. The chroma moved onto the even luma column (horizontally centred chroma): integer weights over
+ * 2^14, the result kept with DVBRIDGE_SOURCE_FRAC_BITS fractional bits (exact in a float). */
+_Static_assert(DVBRIDGE_SOURCE_FRAC_BITS == 2 && DVBRIDGE_SOURCE_WEIGHT_BITS == 14,
+               "the shader of the horizontal pass shifts by 12");
+static const char RESITE[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D chroma_plane;\n"
+    "uniform float code_scale;\n"
+    "uniform int taps, first, last_col;\n"
+    "uniform int weights[12];\n"
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    ivec2 acc = ivec2(0);\n"
+    "    for (int i = 0; i < taps; i++) {\n"
+    "        int col = clamp(p.x + first + i, 0, last_col);\n"
+    "        vec2 v = texelFetch(chroma_plane, ivec2(col, p.y), 0).rg;\n"
+    "        acc += weights[i] * ivec2(floor(v * code_scale + 0.5));\n"
+    "    }\n"
+    "    acc = (acc + (1 << 11)) >> 12;\n" /* 14 - DVBRIDGE_SOURCE_FRAC_BITS */
+    "    color = vec4(vec2(acc), 0.0, 1.0);\n"
+    "}\n";
+
+/* 2. The rows of 4:2:2 of one parity: fragment row i of the draw is row 2 i + parity of the picture,
+ * at row i + offset of the texture. Only the columns and rows that the transport reads (the active
+ * picture) are computed. */
+static const char ROWS[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D chroma_plane;\n"
+    "uniform float chroma_read;\n" /* the factor from a chroma value to an integer */
+    "uniform int chroma_shift;\n"  /* 14 + the fractional bits of the chroma read */
+    "uniform int taps, first, parity, row_offset, last_row, code_max;\n"
+    "uniform int weights[12];\n"
+    "uniform ivec4 needed;\n" /* columns x0..x1 and rows y0..y1 (of the picture) read */
+    "out uvec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 q = ivec2(gl_FragCoord.xy);\n"
+    "    int r = 2 * (q.y - row_offset) + parity;\n"
+    "    if (q.x < needed.x || q.x >= needed.y || r < needed.z || r >= needed.w) {\n"
+    "        color = uvec4(0u);\n"
+    "        return;\n"
+    "    }\n"
+    "    int base = (r >> 1) + first;\n"
+    "    ivec2 acc = ivec2(0);\n"
+    "    for (int i = 0; i < taps; i++) {\n"
+    "        vec2 v = texelFetch(chroma_plane, ivec2(q.x, clamp(base + i, 0, last_row)), 0).rg;\n"
+    "        acc += weights[i] * ivec2(floor(v * chroma_read + 0.5));\n"
+    "    }\n"
+    "    acc = (acc + (1 << (chroma_shift - 1))) >> chroma_shift;\n"
+    "    color = uvec4(uvec2(clamp(acc, ivec2(0), ivec2(code_max))), 0u, 0u);\n"
+    "}\n";
+
+/* What passes 3 and 4 share, the same code in both: the codes of the transport at a pixel and the
+ * chain of the DM header from them to PQ BT.2020 RGB. Pass 4 recomputes the picture of pass 3 where
+ * something was drawn over it, so they must compute it alike. */
+#define COMMON                                                                                    \
+    "precision highp float;\n"                                                                    \
+    "precision highp int;\n"                                                                      \
+    "uniform highp sampler2D luma_plane;\n"                                                       \
+    "uniform highp usampler2D chroma_rows;\n" /* pass 2: even rows, then odd ones from rows_half */ \
+    "uniform ivec4 picture_rect;\n" /* x, y, width, height on the raster */                       \
+    "uniform ivec4 active_rect;\n"  /* x0, y0, x1, y1 of the active picture */                    \
+    "uniform ivec3 black;\n"                                                                      \
+    "uniform float code_scale;\n" /* 2^bits */                                                    \
+    "uniform int rows_half;\n"                                                                    \
+    "uniform mat3 ycc_forward, lms_forward;\n"                                                    \
+    "uniform vec3 ycc_offset;\n"                                                                  \
+    "uniform int affine;\n"                                                                       \
+    "const float m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;\n"                          \
+    "const float c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0, c3 = 2392.0 / 4096.0 * 32.0;\n" \
+    "bool inside(int x, int y)\n"                                                                 \
+    "{\n"                                                                                         \
+    "    return x >= picture_rect.x && x < picture_rect.x + picture_rect.z &&\n"                  \
+    "           y >= picture_rect.y && y < picture_rect.y + picture_rect.w &&\n"                  \
+    "           x >= active_rect.x && x < active_rect.z && y >= active_rect.y && y < active_rect.w;\n" \
+    "}\n"                                                                                         \
+    "uint luma_code(ivec2 p)\n"                                                                   \
+    "{\n"                                                                                         \
+    "    return inside(p.x, p.y) ? uint(floor(texelFetch(luma_plane, p - picture_rect.xy, 0).r *\n" \
+    "                                         code_scale + 0.5)) : uint(black.x);\n"             \
+    "}\n"                                                                                         \
+    /* the chroma of the pair whose even pixel is ex */                                           \
+    "uvec2 pair_chroma(int ex, int y)\n"                                                          \
+    "{\n"                                                                                         \
+    "    if (!inside(ex, y))\n"                                                                   \
+    "        return uvec2(black.yz);\n"                                                           \
+    "    int r = y - picture_rect.y;\n"                                                           \
+    "    return texelFetch(chroma_rows, ivec2((ex - picture_rect.x) >> 1,\n"                      \
+    "                                         (r & 1) * rows_half + (r >> 1)), 0).rg;\n"          \
+    "}\n"                                                                                         \
+    /* the codes of a pixel: its luma, the chroma of its pair, at an odd pixel halfway to the next \
+     * pair's (the chroma of 4:2:2 is on the even pixels) */                                      \
+    "vec3 codes_at(ivec2 p)\n"                                                                    \
+    "{\n"                                                                                         \
+    "    int ex = p.x & ~1;\n"                                                                    \
+    "    vec2 c = vec2(pair_chroma(ex, p.y));\n"                                                  \
+    "    if ((p.x & 1) != 0 && inside(ex + 2, p.y))\n"                                            \
+    "        c = (c + vec2(pair_chroma(ex + 2, p.y))) * 0.5;\n"                                   \
+    "    return vec3(float(luma_code(p)), c);\n"                                                  \
+    "}\n"                                                                                         \
+    /* the PQ EOTF and OETF, odd functions, so that negative components (a colour out of the gamut \
+     * of BT.2020) go there and back; the divisor kept positive where the signal is beyond 1.99 */ \
+    "vec3 pq_eotf(vec3 v)\n"                                                                      \
+    "{\n"                                                                                         \
+    "    vec3 e = pow(abs(v), vec3(1.0 / m2));\n"                                                 \
+    "    return sign(v) * pow(max(e - vec3(c1), 0.0) / max(vec3(c2) - vec3(c3) * e, vec3(1e-6)),\n" \
+    "                         vec3(1.0 / m1));\n"                                                 \
+    "}\n"                                                                                         \
+    "vec3 pq_oetf(vec3 l)\n"                                                                      \
+    "{\n"                                                                                         \
+    "    vec3 t = pow(abs(l), vec3(m1));\n"                                                       \
+    "    return sign(l) * pow((vec3(c1) + vec3(c2) * t) / (vec3(1.0) + vec3(c3) * t), vec3(m2));\n" \
+    "}\n"                                                                                         \
+    /* codes -> T' -> (not affine: T = PQ EOTF of T' within [0, 1], the domain of the EOTF, then   \
+     * the linear BT.2020 RGB of the same LMS) -> PQ BT.2020 RGB, not clamped */                  \
+    "vec3 decode(vec3 codes)\n"                                                                   \
+    "{\n"                                                                                         \
+    "    vec3 tp = ycc_forward * (codes / code_scale - ycc_offset);\n"                            \
+    "    if (affine == 0)\n"                                                                      \
+    "        tp = pq_oetf(lms_forward * pq_eotf(clamp(tp, 0.0, 1.0)));\n"                         \
+    "    return tp;\n"                                                                            \
+    "}\n"                                                                                         \
+    /* the picture that Kodi draws over: the transport decoded, within [0, 1] as a picture        \
+     * of Kodi's is (as the converted transport's is, which captures read the same way), 0        \
+     * outside the active picture */                                                              \
+    "vec3 picture_at(ivec2 p)\n"                                                                  \
+    "{\n"                                                                                         \
+    "    return inside(p.x, p.y) ? clamp(decode(codes_at(p)), 0.0, 1.0) : vec3(0.0);\n"           \
+    "}\n"
+
+/* 3. The picture that Kodi draws over. */
+static const char PICTURE[] =
+    "#version 300 es\n"
+    COMMON
+    "out vec4 color;\n"
+    "void main()\n"
+    "{\n"
+    "    color = vec4(picture_at(ivec2(gl_FragCoord.xy)), 2.0);\n"
+    "}\n";
+
+/* 4. The transport. */
+static const char PACK[] =
+    "#version 300 es\n"
+    COMMON
+    "uniform highp sampler2D drawn;\n" /* the picture of pass 3, with what was drawn over it */
+    "uniform int has_layer, code_max;\n"
+    "uniform mat3 ycc_inverse, lms_inverse;\n"
+    "uniform uvec4 metadata_words[128];\n"
+    "uniform uint packet_count;\n"
+    "uniform uint flip_y;\n"
+    "out vec4 color;\n"
+    "uint parity(uint v)\n"
+    "{\n"
+    "    v ^= v >> 16u; v ^= v >> 8u; v ^= v >> 4u; v ^= v >> 2u; v ^= v >> 1u;\n"
+    "    return v & 1u;\n"
+    "}\n"
+    /* the inverse of decode(): PQ BT.2020 RGB -> codes, not rounded */
+    "vec3 to_source(vec3 rgb)\n"
+    "{\n"
+    "    vec3 tp = rgb;\n"
+    "    if (affine == 0)\n"
+    "        tp = pq_oetf(lms_inverse * pq_eotf(rgb));\n"
+    "    return (ycc_inverse * tp + ycc_offset) * code_scale;\n"
+    "}\n"
+    /* the codes of a pixel that something was drawn over: d.a = 2 - a, a the opacity of all that
+     * was drawn over it, and d.rgb = a colour + (1 - a) picture (dvbridge_source.h) */
+    "vec3 drawn_over(ivec2 p, vec4 d)\n"
+    "{\n"
+    "    float a = 2.0 - d.a;\n"
+    "    vec3 codes = codes_at(p), under = picture_at(p);\n"
+    /* the first form where decoding is invertible: affine, whatever the picture clamps; else with
+     * T' within [0, 1] and the picture not clamped */
+    "    bool exact = affine != 0;\n"
+    "    if (!exact) {\n"
+    "        vec3 tp = ycc_forward * (codes / code_scale - ycc_offset);\n"
+    "        vec3 raw = inside(p.x, p.y) ? decode(codes) : vec3(0.0);\n"
+    "        exact = all(greaterThanEqual(tp, vec3(0.0))) && all(lessThanEqual(tp, vec3(1.0))) &&\n"
+    "                raw == under;\n"
+    "    }\n"
+    "    if (exact)\n"
+    "        return to_source(d.rgb) + (1.0 - a) * (codes - to_source(under));\n"
+    "    vec3 colour = (d.rgb - (1.0 - a) * under) / a;\n"
+    "    return (1.0 - a) * codes + a * to_source(colour);\n"
+    "}\n"
+    "uint code(float v)\n"
+    "{\n"
+    "    return uint(clamp(int(floor(v + 0.5)), 0, code_max));\n"
+    "}\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    "    int ex = p.x & ~1;\n"
+    "    bool odd = (p.x & 1) != 0;\n"
+    "    vec4 own = vec4(0.0, 0.0, 0.0, 2.0), even = own;\n"
+    "    if (has_layer != 0) {\n"
+    "        own = texelFetch(drawn, p, 0);\n"
+    "        even = odd ? texelFetch(drawn, ivec2(ex, p.y), 0) : own;\n"
+    "    }\n"
+    "    uint y = own.a != 2.0 ? code(drawn_over(p, own).x) : luma_code(p);\n"
+    "    uint c;\n"
+    "    if (even.a != 2.0) {\n"
+    "        vec3 e = drawn_over(ivec2(ex, p.y), even);\n"
+    "        c = code(odd ? e.z : e.y);\n"
+    "    } else {\n"
+    "        uvec2 cc = pair_chroma(ex, p.y);\n"
+    "        c = odd ? cc.y : cc.x;\n"
+    "    }\n"
+    "    uint index = uint(p.y * 3840 + p.x), packet = index / 3072u;\n"
+    "    if (packet < packet_count) {\n"
+    "        uint bit = index % 1024u, word = packet * 32u + bit / 32u;\n"
+    "        uint value = (metadata_words[word / 4u][int(word % 4u)] >> (31u - bit % 32u)) & 1u;\n"
+    "        c = (c & 4094u) | (value ^ parity(c >> 1u) ^ parity(y));\n"
+    "    }\n"
+    "    color = vec4(float(c >> 4u), float(y >> 4u), float((y & 15u) | ((c & 15u) << 4u)), 255.0) / 255.0;\n"
+    "}\n";
+
+struct texture {
+    GLuint texture, framebuffer;
+    int w, h;
+};
+
+/* the uniforms of COMMON, in a program that has them */
+struct common_uniforms {
+    GLint luma, rows, picture, active, black, code_scale, half, ycc_forward, lms_forward, offset,
+        affine;
+};
+static const char *const COMMON_NAMES[] = {"luma_plane", "chroma_rows", "picture_rect",
+    "active_rect", "black", "code_scale", "rows_half", "ycc_forward", "lms_forward", "ycc_offset",
+    "affine"};
+
+struct dvbridge_source_packer {
+    GLuint pack, picture, resite, rows, vao, sampler;
+    struct texture resited, chroma;
+    /* what the rows of `chroma` are of (dvbridge_source_rows()) */
+    bool rows_made;
+    int rows_of[8], rows_half;
+    struct common_uniforms pc, cc; /* of pass 4 and of pass 3 */
+    struct {
+        GLint drawn, has_layer, code_max, ycc_inverse, lms_inverse, words, count, flip;
+    } u;
+    struct {
+        GLint chroma, code_scale, taps, first, last_col, weights;
+    } h;
+    struct {
+        GLint chroma, chroma_read, chroma_shift, taps, first, parity, offset, last_row, code_max,
+            weights, needed;
+    } v;
+};
+
+static GLuint compile(GLenum type, const char *source)
+{
+    GLuint shader = glCreateShader(type);
+    glShaderSource(shader, 1, &source, NULL);
+    glCompileShader(shader);
+    GLint ok = 0;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[4096];
+        glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+        fprintf(stderr, "DV source transport shader: %s\n", log);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+static GLuint link(const char *fragment)
+{
+    GLuint vs = compile(GL_VERTEX_SHADER, VERTEX), fs = compile(GL_FRAGMENT_SHADER, fragment);
+    GLuint program = 0;
+    if (vs && fs) {
+        program = glCreateProgram();
+        glAttachShader(program, vs);
+        glAttachShader(program, fs);
+        glLinkProgram(program);
+        GLint linked = 0;
+        glGetProgramiv(program, GL_LINK_STATUS, &linked);
+        if (!linked) {
+            glDeleteProgram(program);
+            program = 0;
+        }
+    }
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    return program;
+}
+
+/* the locations of the uniforms of a program, in the order of their names; false if one is missing */
+static bool locate(GLuint program, GLint *out, const char *const *names, size_t count)
+{
+    for (size_t i = 0; i < count; ++i)
+        if ((out[i] = glGetUniformLocation(program, names[i])) < 0)
+            return false;
+    return true;
+}
+
+#define COUNT(a) (sizeof(a) / sizeof(*(a)))
+
+struct dvbridge_source_packer *dvbridge_source_packer_create(void)
+{
+    struct dvbridge_source_packer *p = calloc(1, sizeof(*p));
+    if (!p)
+        return NULL;
+    GLint previous = 0;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &previous);
+    static const char *const pack[] = {"drawn", "has_layer", "code_max", "ycc_inverse",
+        "lms_inverse", "metadata_words", "packet_count", "flip_y"};
+    static const char *const resite[] = {"chroma_plane", "code_scale", "taps", "first", "last_col",
+                                         "weights"};
+    static const char *const rows[] = {"chroma_plane", "chroma_read", "chroma_shift", "taps",
+        "first", "parity", "row_offset", "last_row", "code_max", "weights", "needed"};
+    _Static_assert(sizeof(struct common_uniforms) == COUNT(COMMON_NAMES) * sizeof(GLint),
+                   "common uniforms");
+    _Static_assert(sizeof(p->u) == COUNT(pack) * sizeof(GLint), "pack uniforms");
+    _Static_assert(sizeof(p->h) == COUNT(resite) * sizeof(GLint), "resite uniforms");
+    _Static_assert(sizeof(p->v) == COUNT(rows) * sizeof(GLint), "rows uniforms");
+    p->pack = link(PACK);
+    p->picture = link(PICTURE);
+    p->resite = link(RESITE);
+    p->rows = link(ROWS);
+    if (!p->pack || !p->picture || !p->resite || !p->rows ||
+        !locate(p->pack, &p->pc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+        !locate(p->picture, &p->cc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+        !locate(p->pack, &p->u.drawn, pack, COUNT(pack)) ||
+        !locate(p->resite, &p->h.chroma, resite, COUNT(resite)) ||
+        !locate(p->rows, &p->v.chroma, rows, COUNT(rows))) {
+        glUseProgram(previous);
+        dvbridge_source_packer_destroy(p);
+        return NULL;
+    }
+    glGenVertexArrays(1, &p->vao);
+    glGenSamplers(1, &p->sampler);
+    glSamplerParameteri(p->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glSamplerParameteri(p->sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glSamplerParameteri(p->sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glSamplerParameteri(p->sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glUseProgram(previous);
+    return p;
+}
+
+static void texture_destroy(struct texture *t)
+{
+    glDeleteFramebuffers(1, &t->framebuffer);
+    glDeleteTextures(1, &t->texture);
+    *t = (struct texture){0};
+}
+
+void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
+{
+    if (!p)
+        return;
+    texture_destroy(&p->resited);
+    texture_destroy(&p->chroma);
+    glDeleteVertexArrays(1, &p->vao);
+    glDeleteSamplers(1, &p->sampler);
+    glDeleteProgram(p->pack);
+    glDeleteProgram(p->picture);
+    glDeleteProgram(p->resite);
+    glDeleteProgram(p->rows);
+    free(p);
+}
+
+/* a texture of the packer's, with its framebuffer bound and its viewport set */
+static bool target(struct texture *t, GLenum format, int w, int h)
+{
+    if (!t->texture || t->w != w || t->h != h) {
+        texture_destroy(t);
+        glGenTextures(1, &t->texture);
+        glBindTexture(GL_TEXTURE_2D, t->texture);
+        glTexStorage2D(GL_TEXTURE_2D, 1, format, w, h);
+        glGenFramebuffers(1, &t->framebuffer);
+        glBindFramebuffer(GL_FRAMEBUFFER, t->framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t->texture, 0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+            texture_destroy(t);
+            return false;
+        }
+        t->w = w;
+        t->h = h;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, t->framebuffer);
+    glViewport(0, 0, w, h);
+    return true;
+}
+
+static void bind(struct dvbridge_source_packer *p, int unit, GLuint texture)
+{
+    glActiveTexture(GL_TEXTURE0 + unit);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glBindSampler(unit, p->sampler);
+}
+
+static const GLenum CAPS[] = {GL_BLEND, GL_DEPTH_TEST, GL_STENCIL_TEST, GL_SCISSOR_TEST,
+    GL_DITHER, GL_CULL_FACE, GL_RASTERIZER_DISCARD, GL_SAMPLE_ALPHA_TO_COVERAGE,
+    GL_SAMPLE_COVERAGE};
+
+/* the arguments that every call takes alike, checked; the active picture in the raster */
+static bool picture_fits(const struct dvbridge_source_packer *p,
+                         const struct dvbridge_source_params *params, int width, int height,
+                         int x, int y, const unsigned margins[4])
+{
+    return p && params && margins && width >= 2 && height >= 2 && x >= 0 && y >= 0 && !(x & 1) &&
+           x <= 3840 - width && y <= 2160 - height && margins[0] + margins[1] < 3840 &&
+           margins[2] + margins[3] < 2160 && params->bits == 12;
+}
+
+/* the rows were made for this picture */
+static bool rows_of(const struct dvbridge_source_packer *p, int width, int height, int x, int y,
+                    const unsigned margins[4])
+{
+    const int key[8] = {width, height, x, y, (int)margins[0], (int)margins[1], (int)margins[2],
+                        (int)margins[3]};
+    return p->rows_made && !memcmp(p->rows_of, key, sizeof(key));
+}
+
+static void begin(struct dvbridge_source_packer *p, struct dvbridge_gl_state *state)
+{
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    dvbridge_gl_state_save(state);
+    for (unsigned i = 0; i < COUNT(CAPS); ++i)
+        glDisable(CAPS[i]);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBindVertexArray(p->vao);
+}
+
+static bool end(const struct dvbridge_gl_state *state, bool ok)
+{
+    ok = ok && glGetError() == GL_NO_ERROR;
+    dvbridge_gl_state_restore(state);
+    return ok && glGetError() == GL_NO_ERROR;
+}
+
+bool dvbridge_source_rows(struct dvbridge_source_packer *p,
+                          const struct dvbridge_source_params *params, unsigned chroma, int width,
+                          int height, int x, int y, const unsigned margins[4], bool all)
+{
+    if (!picture_fits(p, params, width, height, x, y, margins) || !chroma)
+        return false;
+    p->rows_made = false;
+    struct dvbridge_gl_state state;
+    begin(p, &state);
+    bool ok = false;
+    const int cw = (width + 1) / 2, ch = (height + 1) / 2, half = (height + 1) / 2;
+    /* the chroma columns and the rows of the picture that the transport reads: those of the pairs
+     * whose even pixel is in the active picture (x is even: so is that pixel's place in the picture) */
+    const int x0 = (int)margins[0], x1 = 3840 - (int)margins[1];
+    const int y0 = (int)margins[2], y1 = 2160 - (int)margins[3];
+    const int a = (x0 > x ? x0 : x) - x, b = (x1 < x + width ? x1 : x + width) - x;
+    const int needed[4] = {all ? 0 : (a + 1) / 2, all ? cw : (b + 1) / 2,
+                           all ? 0 : (y0 > y ? y0 : y) - y,
+                           all ? height : (y1 < y + height ? y1 : y + height) - y};
+    unsigned chroma_in = chroma;
+    if (params->htaps) {
+        if (!target(&p->resited, GL_RG32F, cw, ch))
+            return end(&state, false);
+        glUseProgram(p->resite);
+        bind(p, 0, chroma);
+        glUniform1i(p->h.chroma, 0);
+        glUniform1f(p->h.code_scale, (float)(1 << params->bits));
+        glUniform1i(p->h.taps, params->htaps);
+        glUniform1i(p->h.first, params->hfirst);
+        glUniform1i(p->h.last_col, cw - 1);
+        glUniform1iv(p->h.weights, DVBRIDGE_SOURCE_TAPS, params->hweights);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        chroma_in = p->resited.texture;
+    }
+    if (!target(&p->chroma, GL_RG16UI, cw, 2 * half))
+        return end(&state, false);
+    glUseProgram(p->rows);
+    bind(p, 0, chroma_in);
+    glUniform1i(p->v.chroma, 0);
+    glUniform1f(p->v.chroma_read, params->htaps ? 1.0f : (float)(1 << params->bits));
+    glUniform1i(p->v.chroma_shift, DVBRIDGE_SOURCE_WEIGHT_BITS +
+                                       (params->htaps ? DVBRIDGE_SOURCE_FRAC_BITS : 0));
+    glUniform1i(p->v.last_row, ch - 1);
+    glUniform1i(p->v.code_max, params->code_max);
+    glUniform4i(p->v.needed, needed[0], needed[1], needed[2], needed[3]);
+    for (int parity = 0; parity < 2; ++parity) {
+        /* rows parity, 2 + parity ... of the picture: rows parity * half ... of the texture */
+        glViewport(0, parity * half, cw, half);
+        glUniform1i(p->v.taps, params->vtaps[parity]);
+        glUniform1i(p->v.first, params->vfirst[parity]);
+        glUniform1i(p->v.parity, parity);
+        glUniform1i(p->v.offset, parity * half);
+        glUniform1iv(p->v.weights, DVBRIDGE_SOURCE_TAPS, params->vweights[parity]);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    ok = end(&state, true);
+    if (ok) {
+        const int key[8] = {width, height, x, y, (int)margins[0], (int)margins[1],
+                            (int)margins[2], (int)margins[3]};
+        memcpy(p->rows_of, key, sizeof(key));
+        p->rows_half = half;
+        p->rows_made = true;
+    }
+    return ok;
+}
+
+/* the uniforms of COMMON; the luma on unit 0, the rows on unit 1 */
+static void set_common(struct dvbridge_source_packer *p, const struct common_uniforms *u,
+                       const struct dvbridge_source_params *params, unsigned luma, int width,
+                       int height, int x, int y, const unsigned margins[4])
+{
+    bind(p, 0, luma);
+    bind(p, 1, p->chroma.texture);
+    glUniform1i(u->luma, 0);
+    glUniform1i(u->rows, 1);
+    glUniform4i(u->picture, x, y, width, height);
+    glUniform4i(u->active, (int)margins[0], (int)margins[2], 3840 - (int)margins[1],
+                2160 - (int)margins[3]);
+    glUniform3i(u->black, params->black[0], params->black[1], params->black[2]);
+    glUniform1f(u->code_scale, (float)(1 << params->bits));
+    glUniform1i(u->half, p->rows_half);
+    /* GLSL matrices are column-major */
+    float yf[9], lf[9];
+    for (int i = 0; i < 3; ++i)
+        for (int j = 0; j < 3; ++j) {
+            yf[j * 3 + i] = params->ycc_forward[i * 3 + j];
+            lf[j * 3 + i] = params->lms_forward[i * 3 + j];
+        }
+    glUniformMatrix3fv(u->ycc_forward, 1, GL_FALSE, yf);
+    glUniformMatrix3fv(u->lms_forward, 1, GL_FALSE, lf);
+    glUniform3fv(u->offset, 1, params->offset);
+    glUniform1i(u->affine, params->affine);
+}
+
+bool dvbridge_source_picture(struct dvbridge_source_packer *p,
+                             const struct dvbridge_source_params *params, unsigned luma, int width,
+                             int height, int x, int y, const unsigned margins[4],
+                             unsigned framebuffer)
+{
+    if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !framebuffer ||
+        !rows_of(p, width, height, x, y, margins))
+        return false;
+    struct dvbridge_gl_state state;
+    begin(p, &state);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    GLint red = 0, alpha = 0, type = 0;
+    glGetIntegerv(GL_RED_BITS, &red);
+    glGetIntegerv(GL_ALPHA_BITS, &alpha);
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                          GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &type);
+    /* 32-bit floats: the alpha of 2 and its 2 - a are exact */
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE || red != 32 ||
+        alpha != 32 || type != GL_FLOAT)
+        return end(&state, false);
+    glViewport(0, 0, 3840, 2160);
+    glUseProgram(p->picture);
+    set_common(p, &p->cc, params, luma, width, height, x, y, margins);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    return end(&state, true);
+}
+
+bool dvbridge_source_pack(struct dvbridge_source_packer *p,
+                          const struct dvbridge_source_params *params, unsigned luma, int width,
+                          int height, int x, int y, unsigned layer, const unsigned margins[4],
+                          unsigned framebuffer, const uint32_t packets[512], unsigned count,
+                          bool flip_y)
+{
+    if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !packets || !count ||
+        count > 16 || !rows_of(p, width, height, x, y, margins))
+        return false;
+    struct dvbridge_gl_state state;
+    begin(p, &state);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    {
+        GLint red = 0, green = 0, blue = 0, samples = 0, encoding = 0;
+        glGetIntegerv(GL_RED_BITS, &red);
+        glGetIntegerv(GL_GREEN_BITS, &green);
+        glGetIntegerv(GL_BLUE_BITS, &blue);
+        glGetIntegerv(GL_SAMPLES, &samples);
+        glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,
+            framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK,
+            GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE || red != 8 ||
+            green != 8 || blue != 8 || samples > 1 || encoding != GL_LINEAR)
+            return end(&state, false);
+    }
+    glViewport(0, 0, 3840, 2160);
+    glUseProgram(p->pack);
+    set_common(p, &p->pc, params, luma, width, height, x, y, margins);
+    bind(p, 2, layer);
+    glUniform1i(p->u.drawn, 2);
+    glUniform1i(p->u.has_layer, layer != 0);
+    glUniform1i(p->u.code_max, params->code_max);
+    float yi[9], li[9];
+    for (int i = 0; i < 3; ++i)
+        for (int j = 0; j < 3; ++j) {
+            yi[j * 3 + i] = params->ycc_inverse[i * 3 + j];
+            li[j * 3 + i] = params->lms_inverse[i * 3 + j];
+        }
+    glUniformMatrix3fv(p->u.ycc_inverse, 1, GL_FALSE, yi);
+    glUniformMatrix3fv(p->u.lms_inverse, 1, GL_FALSE, li);
+    glUniform4uiv(p->u.words, 128, packets);
+    glUniform1ui(p->u.count, count);
+    glUniform1ui(p->u.flip, flip_y);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    return end(&state, true);
+}
diff --git a/tools/dvbridge/dvbridge_source.h b/tools/dvbridge/dvbridge_source.h
new file mode 100644
index 0000000..68cad8d
--- /dev/null
+++ b/tools/dvbridge/dvbridge_source.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Hades: the Dolby Vision signal as a certified source device sends it (ETSI GS CCM 001 V1.1.1,
+ * clause 6). The picture of the tunnel is the output picture of the composer (clause 5.4) as it is,
+ * in the colour representation that its RPU describes (YCbCr for profiles 7 and 8, IPT-PQ-c2 in
+ * the places of Y, Cb and Cr for profile 5, clause 5.2.1 note), 12-bit 4:2:2, and the DM header
+ * describes that picture (clause 6.2.2: the YCCtoRGB matrix and offsets, RGBtoLMS, signal_bit_depth
+ * = hdr_bit_depth, signal_color_space). The chroma of the composer is 4:2:0; the rows of 4:2:2 are
+ * interpolated vertically (the clause gives no filter).
+ *
+ * Where something is drawn over the video (the GUI, subtitles), it is drawn over a picture made
+ * here from the transport itself: its codes decoded with the chain that its DM header describes,
+ * to PQ BT.2020 RGB within [0, 1] (dvbridge_source_picture()), with an alpha of 2. Kodi's blend functions leave
+ * a pixel drawn over with RGB = a colour + (1 - a) picture and alpha 2 - a (a + dst (1 - a)), a
+ * the opacity of all that was drawn over it. The packer recomputes the picture and converts the
+ * blended RGB back with the inverse of the chain, as Kodi blended it:
+ * to_source(blended) + (1 - a) (codes - to_source(picture)), whose second term gives the codes of
+ * the picture as a goes to 0 whatever the GPU's float arithmetic loses on the way there and back.
+ * Where decoding is not invertible (IPT with a component of T' out of [0, 1], which it clamps, or
+ * a picture out of [0, 1], which the picture clamps; affine, the first form holds as it is), it
+ * takes what was drawn, colour and a, from the blended RGB and blends the converted colour with
+ * the codes of the picture: (1 - a) codes + a to_source(colour). Both are the codes of the picture
+ * as a goes to 0 and the codes of what was drawn at a = 1. */
+#ifndef DVBRIDGE_SOURCE_H
+#define DVBRIDGE_SOURCE_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The filter that brings the 4:2:0 chroma to the rows of 4:2:2 (and, for chroma that is not on the
+ * even luma column, onto it first): Lanczos with a = 6, 12 taps, integer weights that sum to 2^14.
+ * Chosen by measurement against the band-limited interpolation (float64) of the composer's chroma
+ * of eight pictures of a profile 7 FEL stream and of band-limited noise: of the Lanczos windows 2
+ * to 8, bilinear (CCM 001 annex B.3, 64/192), the 6 and 8 taps of annex B.2 and Catmull-Rom (annex
+ * B.3's luma filter), the shortest whose magnitude response stays within 3 % of 1 up to 0.4 cycles
+ * per sample at every phase the chroma locations need (1/4, 1/2, 3/4: 0.973 to 1.022; Lanczos 5,
+ * 0.904 to 1.024), and the longest whose rows stay within the 6 chroma rows around the active
+ * picture that libplacebo's composer writes when it leaves the rows of the bars out
+ * (pl_render_params.active_rows). On the real pictures its error against that interpolation (RMS,
+ * codes of 4095) is 0.235 and 0.205 for the left and the top-left locations, Lanczos 8's 0.227 and
+ * 0.195, bilinear's 0.378 and 0.377. */
+#define DVBRIDGE_SOURCE_TAPS 12
+#define DVBRIDGE_SOURCE_LANCZOS 6
+#define DVBRIDGE_SOURCE_WEIGHT_BITS 14
+/* fractional bits kept by the horizontal pass (chroma that is not on the even luma column): the
+ * vertical sum over them stays within 31 bits (dvbridge_source_setup() checks it) */
+#define DVBRIDGE_SOURCE_FRAC_BITS 2
+
+struct dvbridge_source_params {
+    int bits;      /* hdr_bit_depth of the composer: 12 */
+    int code_max;  /* 2^bits - 1 */
+    int black[3];  /* the codes of black (T' = 0): the offsets of the RPU, in codes */
+    float ycc_forward[9]; /* the RPU's ycc_to_rgb: YCC - offset -> T', row-major */
+    float ycc_inverse[9]; /* its inverse: T' -> YCC */
+    float offset[3];      /* the RPU's ycc_to_rgb_offset (the units of h / 2^bits) */
+    /* The display computes LMS = rgb_to_lms T from the DM header of this transport, and LMS =
+     * RGBtoLMS RGB from that of the converted one (BT.2020's RGBtoLMS, the matrix of the RPUs of
+     * profile 8.1, dvbridge_metadata.h). lms_forward = RGBtoLMS_2020^-1 rgb_to_lms takes the T of
+     * the RPU to the linear BT.2020 RGB of the same LMS; lms_inverse is its inverse. Row-major. */
+    float lms_forward[9];
+    float lms_inverse[9];
+    /* the RPU's rgb_to_lms is that of BT.2020 (profiles 7 and 8): T' is BT.2020 R'G'B' itself, and
+     * decoding and its inverse are affine */
+    int affine;
+    /* the vertical filter for even [0] and odd [1] rows of the picture: it reads taps[i] chroma
+     * rows from (row >> 1) + first[i], with weights[i] (sum 2^14). One tap: the row itself. */
+    int vtaps[2], vfirst[2], vweights[2][DVBRIDGE_SOURCE_TAPS];
+    /* the horizontal one, for chroma that is not on the even luma column (htaps 0: it is) */
+    int htaps, hfirst, hweights[DVBRIDGE_SOURCE_TAPS];
+};
+
+/* For a picture with this metadata (an AVDOVIMetadata the caller has checked, as for the renderer)
+ * whose chroma planes are shifted by shift_x, shift_y luma samples (libplacebo's pl_plane shift:
+ * -0.5 left or top, 0 centred, 0.5 bottom). False, with *why set, where this transport does not
+ * cover it. */
+bool dvbridge_source_setup(struct dvbridge_source_params *out, const void *metadata, size_t bytes,
+                           float shift_x, float shift_y, const char **why);
+
+/* The filter at a phase in [0, 1) of a chroma sample: the sample at j + phase is
+ * sum weights[i] * c[j + first + i] / 2^14, i < *taps (for tests) */
+void dvbridge_source_filter(double phase, int weights[DVBRIDGE_SOURCE_TAPS], int *first, int *taps);
+
+struct dvbridge_source_packer;
+struct dvbridge_source_packer *dvbridge_source_packer_create(void);
+void dvbridge_source_packer_destroy(struct dvbridge_source_packer *packer);
+
+/* The composed planes are GL textures that hold h / 2^bits: luma (one float component) of the
+ * picture's size width x height, placed at x, y of the 3840x2160 raster, and chroma (Cb, Cr: two)
+ * at 4:2:0. margins: left, right, top, bottom of the active picture in the raster; outside it, and
