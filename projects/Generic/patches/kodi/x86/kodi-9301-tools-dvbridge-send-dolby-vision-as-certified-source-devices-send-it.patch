+/* Hades: what the reading of the metadata of the candidate noted (dvbridge_render_take_notes()) */
+static void note_reading(struct dvbridge_renderer *r)
+{
+    struct dvbridge_reading reading;
+    if (dvbridge_candidate_reading(r->pending, &reading)) {
+        bool fresh = false;
+        if (reading.l5_master)
+            fresh = note(r, NOTE_L5_MASTER) || fresh;
+        if (reading.skipped)
+            fresh = note(r, NOTE_LEVEL_SKIPPED) || fresh;
+        if (fresh)
+            r->notes.reading = reading;
+    }
+}
+
+/* Hades: the shift of the chroma planes of a picture (libplacebo's, in luma samples) */
+static bool chroma_shift(const struct pl_frame *f, float *sx, float *sy)
+{
+    for (int p = 0; p < f->num_planes; ++p)
+        for (int c = 0; c < f->planes[p].components; ++c)
+            if (f->planes[p].component_mapping[c] == PL_CHANNEL_CB) {
+                *sx = f->planes[p].shift_x;
+                *sy = f->planes[p].shift_y;
+                return true;
+            }
+    return false;
+}
+
+/* Hades: whether a picture goes out in the source transport: it is asked for, the composer of
+ * CCM 001 composes the picture (libplacebo may still decline it, see render()), the picture is
+ * drawn at its own size (the composer's picture is the one sent), and dvbridge_source_setup()
+ * covers its metadata. Sets source_why where it is asked for and is not. */
+static bool source_possible(struct dvbridge_renderer *r, const struct pl_frame *source,
+                            const void *metadata, size_t bytes, struct dvbridge_geometry g)
+{
+    r->source_why = NULL;
+    if (!r->source_wanted)
+        return false;
+    float sx = 0.0f, sy = 0.0f;
+    if (!r->source_packer)
+        r->source_why = "the packer of the transport could not be made on this GPU";
+    else if (r->legacy_composer)
+        r->source_why = "the composer of ETSI GS CCM 001 is turned off";
+    else if (g.width != g.source_width || g.height != g.source_height)
+        r->source_why = "the picture is scaled";
+    else if (!chroma_shift(source, &sx, &sy))
+        r->source_why = "the picture has no chroma plane";
+    else
+        return dvbridge_source_setup(&r->source_params, metadata, bytes, sx, sy, &r->source_why);
+    return false;
+}
+
+/* Hades: our textures for the composed planes, of the sizes of the picture's planes and in the
+ * formats that libplacebo's composer picks (pl_render_params.dovi_ccm_planes) */
+static bool source_planes(struct dvbridge_renderer *r, const struct pl_frame *source)
+{
+    pl_tex luma = NULL;
+    for (int p = 0; p < source->num_planes && !luma; ++p)
+        for (int c = 0; c < source->planes[p].components; ++c)
+            if (source->planes[p].component_mapping[c] == PL_CHANNEL_Y)
+                luma = source->planes[p].texture;
+    pl_fmt f1 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 1, 32, 32,
+                            PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    pl_fmt f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32, PL_FMT_CAP_SAMPLEABLE |
+                            PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_LINEAR);
+    if (!f2)
+        f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32,
+                         PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    if (!luma || !f1 || !f2 ||
+        !pl_tex_recreate(r->gpu, &r->planes[0], pl_tex_params(.w = luma->params.w,
+            .h = luma->params.h, .format = f1, .sampleable = true, .renderable = true)) ||
+        !pl_tex_recreate(r->gpu, &r->planes[1], pl_tex_params(.w = (luma->params.w + 1) / 2,
+            .h = (luma->params.h + 1) / 2, .format = f2, .sampleable = true, .renderable = true))) {
+        r->source_why = "no textures for the composed planes";
+        return false;
+    }
+    return true;
+}
