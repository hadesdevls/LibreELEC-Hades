+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Hades: the Dolby Vision signal as a certified source device sends it (see dvbridge_source.h). */
+#include "dvbridge_source.h"
+#include "dvbridge_gl_pack.h"
+#include <GLES3/gl3.h>
+#include <libavutil/dovi_meta.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static double sinc(double x)
+{
+    return x == 0.0 ? 1.0 : sin(M_PI * x) / (M_PI * x);
+}
+
+void dvbridge_source_filter(double phase, int weights[DVBRIDGE_SOURCE_TAPS], int *first, int *taps)
+{
+    memset(weights, 0, DVBRIDGE_SOURCE_TAPS * sizeof(*weights));
+    const int one = 1 << DVBRIDGE_SOURCE_WEIGHT_BITS;
+    if (phase < 1e-9 || phase > 1.0 - 1e-9) {
+        /* on a sample: the sample itself (a phase just below 1 is the next one) */
+        weights[0] = one;
+        *first = phase < 1e-9 ? 0 : 1;
+        *taps = 1;
+        return;
+    }
+    const int a = DVBRIDGE_SOURCE_LANCZOS;
+    double w[DVBRIDGE_SOURCE_TAPS], sum = 0.0;
+    for (int i = 0; i < 2 * a; ++i) {
+        const double d = (i - a + 1) - phase; /* samples j - a + 1 .. j + a */
+        w[i] = sinc(d) * sinc(d / a);
+        sum += w[i];
+    }
+    int total = 0, largest = 0;
+    for (int i = 0; i < 2 * a; ++i) {
+        weights[i] = (int)lround(w[i] / sum * one);
+        total += weights[i];
+        if (w[i] > w[largest])
+            largest = i;
+    }
+    weights[largest] += one - total; /* the sum is 2^14 exactly */
+    *first = 1 - a;
+    *taps = 2 * a;
+}
