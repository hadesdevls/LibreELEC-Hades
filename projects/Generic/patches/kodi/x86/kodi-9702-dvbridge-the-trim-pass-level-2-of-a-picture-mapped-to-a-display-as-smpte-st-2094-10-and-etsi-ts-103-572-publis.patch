+    bool trims;
 };
 #define DVBRIDGE_HDR10_BLACK_MAX 1.0f
 /* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
@@ -160,4 +166,9 @@ const char *dvbridge_map_color_refused(const void *metadata, size_t bytes);
  * (pl_map_avdovi_metadata(): code / 4095.0f). false where the metadata do not read or have no level 1. */
 #define DVBRIDGE_LEVEL1_EFFECTIVE 1
 bool dvbridge_level1_effective(const void *metadata, size_t bytes, struct dvbridge_level1 *out);
+/* Hades: the trim pass of the metadata of a picture for a display whose peak is `peak` cd/m2
+ * (dvbridge_trims.h says which block and why). false: the metadata do not read. true: out->found says
+ * whether a block of that target was found (out->blocks: how many level 2 blocks there are), out->active
+ * whether it changes the picture (a block of all codes 2048 does not). */
+bool dvbridge_trim_select(const void *metadata, size_t bytes, float peak, struct dvbridge_trim *out);
 #endif
