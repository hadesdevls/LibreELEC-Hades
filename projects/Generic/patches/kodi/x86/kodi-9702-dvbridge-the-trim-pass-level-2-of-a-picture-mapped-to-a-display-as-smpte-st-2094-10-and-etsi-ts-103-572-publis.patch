+/* Hades: the variables of DVBRIDGE_TRIM_GLSL (DVBRIDGE_TRIM_VARIABLES of them) */
+static void trim_variables(struct trim_pass *t, struct pl_shader_var *v)
+{
+    v[0] = (struct pl_shader_var){.var = pl_var_vec4("dvbridge_trim_a"), .data = t->a, .dynamic = true};
+    v[1] = (struct pl_shader_var){.var = pl_var_vec4("dvbridge_trim_b"), .data = t->b, .dynamic = true};
+    v[2] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_luma"), .data = t->luma, .dynamic = true};
+    v[3] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_to0"), .data = &t->to[0], .dynamic = true};
+    v[4] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_to1"), .data = &t->to[3], .dynamic = true};
+    v[5] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_to2"), .data = &t->to[6], .dynamic = true};
+    v[6] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_from0"), .data = &t->from[0], .dynamic = true};
+    v[7] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_from1"), .data = &t->from[3], .dynamic = true};
+    v[8] = (struct pl_shader_var){.var = pl_var_vec3("dvbridge_trim_from2"), .data = &t->from[6], .dynamic = true};
+}
