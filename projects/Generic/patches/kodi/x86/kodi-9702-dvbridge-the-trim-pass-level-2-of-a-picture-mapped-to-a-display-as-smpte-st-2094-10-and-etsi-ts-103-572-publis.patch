From 83eb0f88d820271f9760caf3b2682d33ac1bcf2c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:01:01 +0000
Subject: [PATCH] dvbridge: the trim pass (level 2) of a picture mapped to a
 display, as SMPTE ST 2094-10 and ETSI TS 103 572 publish it

A Dolby Vision picture mapped to a display (HDR10 output, SDR output, Low-Latency)
was mapped from its level 1 alone; the trims of its level 2 blocks were left
out because how Dolby's display management applies them is not public. What is
public is what the codes of a level 2 block mean (ETSI TS 103 572 4.3, equations
(4) to (8): slope, offset, power, chroma weight and saturation gain, 2048 when
absent) and what they do to a picture already mapped to the targeted display
(SMPTE ST 2094-10:2021 Annex B.3, equations (8) and (9): the clamp of the
component times the gain plus the offset, to the power, relative to the target's
peak; then the chroma compensation and the saturation gain by the luminance of
the display's primaries). Both texts are free since June 2026.

dvbridge_trims.h has the arithmetic (decoding, the pass in double precision as
the reference the tests use, the matrices of the display's primaries) and the
GLSL of the pass. dvbridge_trim_select() picks the block: the one whose
target_max_PQ is the display's peak in 12-bit PQ, to within one code. The standard
defines no way to take a pass to a display it was not made for (ST 2094-1 only says
a receiver can select the sets that fit best), so with no such block, or two
(a tie, or two of one target), the picture is mapped as before, bit for bit: no
interpolation between the targets of two blocks. ms_weight is reserved in
TS 103 572 and ignored (the streams at hand carry 2048 and 512, not the -1 its
text says). Level 8 is not applied: no public document defines it.

The pass is a hook of its own on the output of the render, before the clamp to the
display's peak (the HDR10 and SDR renders) or before the hook that blanks the bars,
writes the test pattern and lifts the black (Low-Latency), in the display's own RGB
(from the container's by the two matrices). dvbridge_hdr10_mapping::trims asks for
it; zero, as before, changes nothing: the shaders and hooks are the ones of before.
A pass that cannot be drawn on a GPU does not lose the picture: the render is made
again without it, for the rest of the stream, and the notes say so
(dvbridge_render_notes::trim_*, once each in a stream: the pass drawn, a block of
the target with nothing to do, level 2 blocks and none for the display's peak).
Never on native Dolby Vision output: the display does its own mapping there.
---
 tools/dvbridge/dvbridge_placebo.c |  46 ++++++
 tools/dvbridge/dvbridge_placebo.h |  15 +-
 tools/dvbridge/dvbridge_render.c  | 183 +++++++++++++++++++++-
 tools/dvbridge/dvbridge_render.h  |  13 ++
 tools/dvbridge/dvbridge_trims.h   | 246 ++++++++++++++++++++++++++++++
 5 files changed, 496 insertions(+), 7 deletions(-)
 create mode 100644 tools/dvbridge/dvbridge_trims.h

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 58b3e44..f33bf68 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -346,3 +346,49 @@ bool dvbridge_level1_effective(const void *metadata, size_t bytes, struct dvbrid
     out->avg += out->offset[2] / 2048.0f;
     return true;
 }
+
+bool dvbridge_trim_select(const void *metadata, size_t bytes, float peak, struct dvbridge_trim *out)
+{
+    if (!out || !metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata) ||
+        !dvbridge_dv_readable(metadata, bytes))
+        return false;
+    *out = (struct dvbridge_trim){0};
+    if (!(peak >= 1.0f) || peak > 10000.0f)
+        return true;
+    const AVDOVIMetadata *m = metadata;
+    const unsigned want = dvbridge_trim_pq12(peak);
+    int best = -1;
+    unsigned best_distance = 2;
+    bool tie = false;
+    for (int i = 0; i < m->num_ext_blocks; ++i) {
+        const AVDOVIDmData *e = av_dovi_get_ext(m, i);
+        if (e->level != 2)
+            continue;
+        const unsigned target = e->l2.target_max_pq;
+        if (out->blocks < 8)
+            out->targets[out->blocks] = target;
+        ++out->blocks;
+        const unsigned distance = target > want ? target - want : want - target;
+        if (distance > 1)
+            continue;
+        if (best < 0 || distance < best_distance) {
+            best = i;
+            best_distance = distance;
+            tie = false;
+        } else if (distance == best_distance) {
+            tie = true; /* two blocks of one target, or of the codes either side of it: no pass */
+        }
+    }
+    if (best < 0 || tie)
+        return true;
+    const AVDOVIDmData *e = av_dovi_get_ext(m, best);
+    const unsigned code[5] = {e->l2.trim_slope, e->l2.trim_offset, e->l2.trim_power,
+                              e->l2.trim_chroma_weight, e->l2.trim_saturation_gain};
+    const struct dvbridge_trim listed = *out;
+    if (!dvbridge_trim_decode(out, e->l2.target_max_pq, code))
+        *out = (struct dvbridge_trim){0};
+    out->blocks = listed.blocks;
+    for (int i = 0; i < 8; ++i)
+        out->targets[i] = listed.targets[i];
+    return true;
+}
