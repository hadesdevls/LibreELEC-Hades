diff --git a/tools/dvbridge/dvbridge_trims.h b/tools/dvbridge/dvbridge_trims.h
new file mode 100644
index 0000000..04662b4
--- /dev/null
+++ b/tools/dvbridge/dvbridge_trims.h
@@ -0,0 +1,246 @@
+/*
+ *  Copyright (C) 2026 Hades.
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_TRIMS_H
+#define DVBRIDGE_TRIMS_H
+/* Hades: the trim pass (level 2) of the metadata of a picture mapped to a display, as it is published.
+ *
+ * Sources, all public: ETSI TS 103 572 V1.2.1 (2020-10) 4.3 (what the 12-bit codes of a level 2 block
+ * mean, its equations (4) to (8)); SMPTE ST 2094-10:2021 (6.2.1 equation (1), 6.2.2 to 6.2.4, 6.3.1,
+ * 6.3.2; Annex B.3 equations (8) and (9), informative); SMPTE ST 2094-1:2016 (the introduction: "a
+ * receiver of the metadata can use the targeted system display metadata to select the metadata sets
+ * that are most applicable to the actual output device").
+ *
+ *   code (ETSI TS 103 572 (4) to (8))              meaning (SMPTE ST 2094-10)
+ *   trim_slope             = (S  - 0.5) * 4096     S  = ToneMappingGain          [0.5, 1.5]  6.2.3
+ *   trim_offset            = (O  + 0.5) * 4096     O  = ToneMappingOffset        [-0.5, 0.5] 6.2.2
+ *   trim_power             = (P  - 0.5) * 4096     P  = ToneMappingGamma         [0.5, 1.5]  6.2.4
+ *   trim_chroma_weight     = (CW + 0.5) * 4096     CW = ChromaCompensationWeight [-0.5, 0.5] 6.3.1
+ *   trim_saturation_gain   = (SG + 0.5) * 4096     SG = SaturationGain           [-0.5, 0.5] 6.3.2
+ *   all of them 2048 (= 1, 0, 1, 0, 0) when absent: no change.
+ *
+ * What it does to the colour components E of the picture already mapped to the targeted display
+ * (SMPTE ST 2094-10 Annex B.3, with y3 = TargetedSystemDisplayMaximumLuminance, the target_max_PQ of the
+ * block):
+ *   F_i = ( min( max( 0, (E_i / y3) * S + O ), 1 ) ) ^ P * y3                           (8)
+ *   G_i = F_i * ( (1 + CW) * F_i / Y ) ^ SG,  Y = the luminance of F from the primaries    (9)
+ * (Y = 0.22897 R + 0.69174 G + 0.07929 B for DCI-P3 primaries with a D65 white, ST 2094-10 Annex B.3
+ * quoting SMPTE EG 432-1; here from the primaries of the display it is mapped to.)
+ *
+ * Which block: the standard defines no way to take a trim pass to a display that is not the one it was
+ * made for (ST 2094-1 only says that a receiver can select the sets that fit the display best), so a
+ * pass is used only for the display it was made for: the block whose target_max_PQ is the display's
+ * peak in 12-bit PQ, to within one code (what the rounding of a peak in cd/m2 to a code is). With no
+ * such block the picture is mapped as it was before, bit for bit; no interpolation between the targets
+ * of two blocks, which no public document defines. ms_weight is reserved in TS 103 572 (a decoder
+ * ignores it; the streams at hand carry 2048 there, not the -1 that its text says).
+ *
+ * Header-only, no libplacebo or FFmpeg, so that the host tests include it; the metadata are read in
+ * dvbridge_placebo.c (dvbridge_trim_select()), the pass is drawn in dvbridge_render.c.
+ */
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#define DVBRIDGE_TRIM_NEUTRAL 2048u
+
+struct dvbridge_trim {
+    bool active;          /* a pass to draw (a block was found, and it is not the identity) */
+    bool found;           /* a block of this display's target was found */
+    unsigned blocks;      /* the level 2 blocks of the metadata */
+    unsigned targets[8];  /* ... the target_max_PQ of the first eight of them, for the log */
+    unsigned target_pq;   /* 12-bit PQ code of the block's target_max_PQ */
+    unsigned code[5];     /* slope, offset, power, chroma weight, saturation gain: as in the block */
+    float target_nits;    /* y3: the block's target_max_PQ as luminance */
+    float gain, offset, power, chroma, saturation; /* S, O, P, CW, SG */
+};
+
+/* SMPTE ST 2084 */
+static inline double dvbridge_trim_pq_to_nits(double pq)
+{
+    const double m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0, c1 = 3424.0 / 4096.0,
+                 c2 = 2413.0 / 4096.0 * 32.0, c3 = 2392.0 / 4096.0 * 32.0;
+    const double p = pow(pq < 0 ? 0 : pq > 1 ? 1 : pq, 1.0 / m2);
+    const double n = p - c1 > 0 ? p - c1 : 0;
+    return 10000.0 * pow(n / (c2 - c3 * p), 1.0 / m1);
+}
+static inline double dvbridge_trim_nits_to_pq(double nits)
+{
+    const double m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0, c1 = 3424.0 / 4096.0,
+                 c2 = 2413.0 / 4096.0 * 32.0, c3 = 2392.0 / 4096.0 * 32.0;
+    const double y = pow((nits < 0 ? 0 : nits > 10000 ? 10000 : nits) / 10000.0, m1);
+    return pow((c1 + c2 * y) / (1 + c3 * y), m2);
+}
+/* the 12-bit code of a luminance, as TS 103 572 (2) to (3) round PQ values */
+static inline unsigned dvbridge_trim_pq12(double nits)
+{
+    return (unsigned)floor(dvbridge_trim_nits_to_pq(nits) * 4095.0 + 0.5);
+}
+
+/* The meaning of the codes of one block (TS 103 572 (4) to (8) turned round). false: a code over 12 bits. */
+static inline bool dvbridge_trim_decode(struct dvbridge_trim *t, unsigned target_pq,
+                                        const unsigned code[5])
+{
+    if (target_pq > 4095)
+        return false;
+    for (int i = 0; i < 5; ++i)
+        if (code[i] > 4095)
+            return false;
+    t->target_pq = target_pq;
+    for (int i = 0; i < 5; ++i)
+        t->code[i] = code[i];
+    t->target_nits = (float)dvbridge_trim_pq_to_nits(target_pq / 4095.0);
+    t->gain = (float)(code[0] / 4096.0 + 0.5);
+    t->offset = (float)(code[1] / 4096.0 - 0.5);
+    t->power = (float)(code[2] / 4096.0 + 0.5);
+    t->chroma = (float)(code[3] / 4096.0 - 0.5);
+    t->saturation = (float)(code[4] / 4096.0 - 0.5);
+    t->found = true;
+    t->active = false;
+    for (int i = 0; i < 5; ++i)
+        t->active = t->active || code[i] != DVBRIDGE_TRIM_NEUTRAL;
+    return true;
+}
+
+/* The pass on a pixel in linear light, normalised so that 1 is the target's peak (E / y3), in the RGB of
+ * the display: equations (8) and (9), with the luminance coefficients yc of its primaries. Double
+ * precision: the reference the GLSL of the renderer is tested against. */
+static inline void dvbridge_trim_apply(const struct dvbridge_trim *t, const double yc[3],
+                                       const double in[3], double out[3])
+{
+    double f[3];
+    for (int i = 0; i < 3; ++i) {
+        double v = in[i] * (double)t->gain + (double)t->offset;
+        v = v < 0 ? 0 : v > 1 ? 1 : v;
+        f[i] = pow(v, (double)t->power);
+    }
+    const double y = yc[0] * f[0] + yc[1] * f[1] + yc[2] * f[2];
+    for (int i = 0; i < 3; ++i)
+        /* a component or a luminance of 0 stays 0: (0/0)^SG and 0^-SG are not numbers a pixel has */
+        out[i] = f[i] > 0 && y > 0 ? f[i] * pow((1.0 + (double)t->chroma) * f[i] / y, (double)t->saturation) : f[i];
+}
+
+/* The rows of the matrix that takes linear RGB of primaries a (CIE 1931 xy of red, green, blue, white) to
+ * XYZ, as SMPTE RP 177 derives it; row 1 is the luminance coefficients. false: primaries that are no gamut. */
+static inline bool dvbridge_trim_rgb2xyz(const float xy[8], double m[9])
+{
+    double p[3][3]; /* columns: X, Y, Z of each primary at Y = 1 */
+    for (int i = 0; i < 3; ++i) {
+        const double x = (double)xy[2 * i], y = (double)xy[2 * i + 1];
+        if (!(y > 0))
+            return false;
+        p[0][i] = x / y;
+        p[1][i] = 1.0;
+        p[2][i] = (1.0 - x - y) / y;
+    }
+    const double wx = (double)xy[6], wy = (double)xy[7];
+    if (!(wy > 0))
+        return false;
+    const double w[3] = {wx / wy, 1.0, (1.0 - wx - wy) / wy};
+    /* solve p * s = w (Cramer) */
+    const double det = p[0][0] * (p[1][1] * p[2][2] - p[1][2] * p[2][1]) -
+                       p[0][1] * (p[1][0] * p[2][2] - p[1][2] * p[2][0]) +
+                       p[0][2] * (p[1][0] * p[2][1] - p[1][1] * p[2][0]);
+    if (!(fabs(det) > 1e-12))
+        return false;
+    double s[3];
+    for (int k = 0; k < 3; ++k) {
+        double q[3][3];
+        for (int r = 0; r < 3; ++r)
+            for (int c = 0; c < 3; ++c)
+                q[r][c] = c == k ? w[r] : p[r][c];
+        s[k] = (q[0][0] * (q[1][1] * q[2][2] - q[1][2] * q[2][1]) -
+                q[0][1] * (q[1][0] * q[2][2] - q[1][2] * q[2][0]) +
+                q[0][2] * (q[1][0] * q[2][1] - q[1][1] * q[2][0])) / det;
+    }
+    for (int r = 0; r < 3; ++r)
+        for (int c = 0; c < 3; ++c)
+            m[3 * r + c] = p[r][c] * s[c];
+    return true;
+}
+
+/* 3x3 inverse (row-major); false when singular */
+static inline bool dvbridge_trim_inverse(const double a[9], double o[9])
+{
+    const double c00 = a[4] * a[8] - a[5] * a[7], c01 = a[5] * a[6] - a[3] * a[8], c02 = a[3] * a[7] - a[4] * a[6];
+    const double det = a[0] * c00 + a[1] * c01 + a[2] * c02;
+    if (!(fabs(det) > 1e-12))
+        return false;
+    o[0] = c00 / det;
+    o[1] = (a[2] * a[7] - a[1] * a[8]) / det;
+    o[2] = (a[1] * a[5] - a[2] * a[4]) / det;
+    o[3] = c01 / det;
+    o[4] = (a[0] * a[8] - a[2] * a[6]) / det;
+    o[5] = (a[2] * a[3] - a[0] * a[5]) / det;
+    o[6] = c02 / det;
+    o[7] = (a[1] * a[6] - a[0] * a[7]) / det;
+    o[8] = (a[0] * a[4] - a[1] * a[3]) / det;
+    return true;
+}
+static inline void dvbridge_trim_mul(const double a[9], const double b[9], double o[9])
+{
+    for (int r = 0; r < 3; ++r)
+        for (int c = 0; c < 3; ++c)
+            o[3 * r + c] = a[3 * r] * b[c] + a[3 * r + 1] * b[3 + c] + a[3 * r + 2] * b[6 + c];
+}
+
+/* The pass for a signal of linear RGB of the container primaries (xy) shown on a display of its own
+ * primaries (xy): the matrix into the display's RGB, the one back, and the luminance coefficients of the
+ * display's RGB. false: primaries that give none (or a container that does not hold the display's). */
+struct dvbridge_trim_space {
+    double to_display[9], from_display[9], luma[3];
+};
+static inline bool dvbridge_trim_space(const float container_xy[8], const float display_xy[8],
+                                       struct dvbridge_trim_space *s)
+{
+    double c[9], d[9], di[9];
+    if (!dvbridge_trim_rgb2xyz(container_xy, c) || !dvbridge_trim_rgb2xyz(display_xy, d) ||
+        !dvbridge_trim_inverse(d, di))
+        return false;
+    dvbridge_trim_mul(di, c, s->to_display);
+    dvbridge_trim_inverse(s->to_display, s->from_display);
+    s->luma[0] = d[3];
+    s->luma[1] = d[4];
+    s->luma[2] = d[5];
+    return true;
+}
+
+/* GLSL of the pass, as a body of a libplacebo custom shader over the signal in color.rgb (encoded: PQ, or
+ * for an SDR output the power law of its EOTF). Variables, all dynamic: vec4 dvbridge_trim_a = (S, O, P,
+ * 1 / y3 with y3 in cd/m2: PQ only), vec4 dvbridge_trim_b = (CW, SG, the power of an SDR output's EOTF, 0
+ * for PQ, 0), vec3 dvbridge_trim_luma, and the rows of the two matrices, vec3 dvbridge_trim_to0..2 (the
+ * container's linear RGB into the display's) and dvbridge_trim_from0..2 (back). The pixel comes out held
+ * within [0, 1] (the peak of the display: what a gain or a saturation gain can push above it is clipped
+ * there, as the display clamp that follows does for everything else). */
+#define DVBRIDGE_TRIM_VARIABLES 9
+#define DVBRIDGE_TRIM_GLSL \
+    "{\n" \
+    "    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;\n" \
+    "    bool pq = dvbridge_trim_b.z == 0.0;\n" \
+    "    vec3 s = clamp(color.rgb, 0.0, 1.0);\n" \
+    "    vec3 lin;\n" \
+    "    if (pq) {\n" \
+    "        vec3 p = pow(s, vec3(1.0 / m2));\n" \
+    "        lin = pow(max(p - c1, 0.0) / (c2 - c3 * p), vec3(1.0 / m1)) * (10000.0 * dvbridge_trim_a.w);\n" \
+    "    } else {\n" \
+    "        lin = pow(s, vec3(dvbridge_trim_b.z));\n" \
+    "    }\n" \
+    "    vec3 e = vec3(dot(dvbridge_trim_to0, lin), dot(dvbridge_trim_to1, lin), dot(dvbridge_trim_to2, lin));\n" \
+    "    vec3 f = pow(clamp(e * dvbridge_trim_a.x + dvbridge_trim_a.y, 0.0, 1.0), vec3(dvbridge_trim_a.z));\n" \
+    "    float y = dot(dvbridge_trim_luma, f);\n" \
+    "    vec3 g = f;\n" \
+    "    if (y > 0.0)\n" \
+    "        g = mix(f, f * pow((1.0 + dvbridge_trim_b.x) * f / y, vec3(dvbridge_trim_b.y)), greaterThan(f, vec3(0.0)));\n" \
+    "    lin = clamp(vec3(dot(dvbridge_trim_from0, g), dot(dvbridge_trim_from1, g), dot(dvbridge_trim_from2, g)), 0.0, 1.0);\n" \
+    "    if (pq) {\n" \
+    "        vec3 y1 = pow(lin * (1.0 / (10000.0 * dvbridge_trim_a.w)), vec3(m1));\n" \
+    "        color.rgb = pow((c1 + c2 * y1) / (1.0 + c3 * y1), vec3(m2));\n" \
+    "    } else {\n" \
+    "        color.rgb = pow(lin, vec3(1.0 / dvbridge_trim_b.z));\n" \
+    "    }\n" \
+    "}\n"
+#endif
