+    const struct pl_hook trim_hook = {
+        .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &trim, .hook = trim_hook_run,
+        .signature = 0x4456424844525431ULL};
+    const struct pl_hook *hooks[] = {&trim_hook, &hook};
+    params.hooks = trim.on ? hooks : hooks + 1;
+    params.num_hooks = trim.on ? 2 : 1;
     /* The area outside the place of a picture that does not fill the raster is black: libplacebo
