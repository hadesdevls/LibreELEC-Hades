         gamut_table_kept(r, ok);
     }
+    /* Hades: without the trim pass where it could not be drawn */
+    if (r && trim_retry(r, ok)) {
+        ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, NULL, false);
+        trim_kept(r, ok);
+    }
     restore_gl_state(&state);
     /* Hades: what was to be drawn over this frame (dvbridge_render_set_drawn()) is this frame's */
     if (r) {
@@ -1620,12 +1673,18 @@ bool dvbridge_render_packed(struct dvbridge_renderer *r, const struct pl_frame *
     struct dvbridge_gl_state state;
     save_gl_state(&state);
     const bool fine = fine_gamut_table(r, true);
+    r->trim_tried = false;
     bool ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, target, flip);
     /* Hades: with the standard gamut table where the finer one could not be made */
     if (gamut_table_retry(r, fine, ok)) {
         ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, target, flip);
         gamut_table_kept(r, ok);
     }
+    /* Hades: without the trim pass where it could not be drawn */
+    if (trim_retry(r, ok)) {
+        ok = render_bars_first(r, source, metadata, bytes, pts, el_pts, geometry, target, flip);
+        trim_kept(r, ok);
+    }
     const bool gl_clean = glGetError() == GL_NO_ERROR;
     if (ok && !gl_clean)
         r->not_drawn = WHY_DIRECT_GL;
@@ -1700,6 +1759,22 @@ static struct pl_hook_res clamp_to_display(void *priv, const struct pl_hook_para
     return (struct pl_hook_res){.failed = !c->called, .output = PL_HOOK_SIG_NONE};
 }
 
+/* Hades: the trim pass (dvbridge_trims.h) of a picture mapped to a display, as a hook of its own on the output of
+ * the render, before the clamp to the display's peak. */
+static struct pl_hook_res trim_hook_run(void *priv, const struct pl_hook_params *p)
+{
+    struct trim_pass *t = priv;
+    struct pl_shader_var vars[DVBRIDGE_TRIM_VARIABLES];
+    trim_variables(t, vars);
+    const struct pl_custom_shader shader = {
+        .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+        .body = DVBRIDGE_TRIM_GLSL,
+        .variables = vars, .num_variables = DVBRIDGE_TRIM_VARIABLES,
+        .description = "DV trim pass (level 2) of the display's target"};
+    t->called = p->stage == PL_HOOK_OUTPUT && pl_shader_custom(p->sh, &shader);
+    return (struct pl_hook_res){.failed = !t->called, .output = PL_HOOK_SIG_NONE};
+}
+
 static bool view_fits(struct dvbridge_view view, const struct pl_frame *source, int width,
                       int height)
 {
@@ -1874,6 +1949,62 @@ static void map_to_display(struct dvbridge_renderer *r, const struct dvbridge_hd
     params->lut3d_size[2] = size[2];
 }
 
+/* Hades: the trim pass of the metadata of a picture mapped to a display (dvbridge_hdr10_mapping::trims): the pass
+ * to draw, or false: none (the picture is mapped as before, bit for bit). The log notes (once each in a stream):
+ * a pass drawn; a block of the display's target that changes nothing; level 2 blocks and none for the peak. */
+static bool trim_prepare(struct dvbridge_renderer *r, const struct dvbridge_hdr10_mapping *m,
+                         const void *metadata, size_t bytes, struct trim_pass *t)
+{
+    *t = (struct trim_pass){0};
+    if (!m->trims || r->trim_failed || !metadata || !dvbridge_trim_select(metadata, bytes, m->peak, &t->trim) ||
+        !t->trim.blocks)
+        return false;
+    if (!t->trim.found) {
+        if (note(r, NOTE_TRIM_NONE)) {
+            r->notes.trim = t->trim;
+            r->notes.trim_peak = m->peak;
+        }
+        return false;
+    }
+    if (!t->trim.active) {
+        if (note(r, NOTE_TRIM_IDENTITY)) {
+            r->notes.trim = t->trim;
+            r->notes.trim_peak = m->peak;
+        }
+        return false;
+    }
+    /* The container is BT.2020 for an HDR10 output and BT.709 for an SDR one; the display's own primaries are
+     * inside it (what the gamut mapping wrote). Where they cannot be had, no pass. */
+    const bool sdr = m->target == DVBRIDGE_HDR10_TARGET_SDR;
+    float display[8], container[8];
+    struct dvbridge_trim_space space;
+    if (!(m->gamut == DVBRIDGE_HDR10_GAMUT_CUSTOM ? dvbridge_hdr10_custom_xy(m, display)
+                                                  : dvbridge_hdr10_gamut_xy(m->gamut, display)) ||
+        !dvbridge_hdr10_gamut_xy(sdr ? DVBRIDGE_HDR10_GAMUT_BT709 : DVBRIDGE_HDR10_GAMUT_BT2020, container) ||
+        !dvbridge_trim_space(container, display, &space))
+        return false;
+    t->a[0] = t->trim.gain;
+    t->a[1] = t->trim.offset;
+    t->a[2] = t->trim.power;
+    t->a[3] = 1.0f / t->trim.target_nits;
+    t->b[0] = t->trim.chroma;
+    t->b[1] = t->trim.saturation;
+    t->b[2] = sdr ? (m->gamma22 ? 2.2f : 2.4f) : 0.0f;
+    for (int i = 0; i < 3; ++i)
+        t->luma[i] = (float)space.luma[i];
+    for (int i = 0; i < 9; ++i) {
+        t->to[i] = (float)space.to_display[i];
+        t->from[i] = (float)space.from_display[i];
+    }
+    t->on = true;
+    r->trim_tried = true;
+    if (note(r, NOTE_TRIM)) {
+        r->notes.trim = t->trim;
+        r->notes.trim_peak = m->peak;
+    }
+    return true;
+}
+
 /* Hades: the render about to be made maps a picture with the finer gamut table: Low-Latency (ll) or
  * a mapping of the picture for output as HDR10 */
 static bool fine_gamut_table(const struct dvbridge_renderer *r, bool ll)
@@ -1901,6 +2032,28 @@ static void gamut_table_kept(struct dvbridge_renderer *r, bool ok)
         r->gamut_fine_failed = false;
 }
 
+/* Hades: after a render with a trim pass that failed: whether to make it again without the pass (the pass is noted
+ * as failed, for the rest of the stream, and the errors that libplacebo keeps reset). The caller makes it again;
+ * if that fails as well, the pass was not why (trim_kept()). A picture is never lost to a pass that this GPU
+ * cannot draw. */
+static bool trim_retry(struct dvbridge_renderer *r, bool ok)
