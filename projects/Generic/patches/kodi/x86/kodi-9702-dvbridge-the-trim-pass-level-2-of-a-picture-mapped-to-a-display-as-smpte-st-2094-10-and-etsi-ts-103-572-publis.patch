     mask.early_mask = early && !mask.pattern && dvbridge_geometry_whole(&geometry) &&
@@ -1477,9 +1517,15 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         .signature = packed            ? (mask.early_mask ? 0x4456425246555302ULL : 0x4456425246555301ULL)
                      : mask.low_latency ? (mask.early_mask ? 0x445642524c4c0002ULL : 0x445642524c4c0001ULL)
                                        : (mask.early_mask ? 0x445642524c350002ULL : 0x445642524c350001ULL)};
-    const struct pl_hook *hooks[] = {&hook};
-    params.hooks = hooks;
-    params.num_hooks = 1;
+    /* Hades: a Low-Latency render's trim pass (dvbridge_trims.h) is a hook of its own before the one above, which
