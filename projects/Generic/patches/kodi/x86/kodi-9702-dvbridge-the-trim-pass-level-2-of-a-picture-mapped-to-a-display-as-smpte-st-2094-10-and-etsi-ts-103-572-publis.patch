@@ -1568,12 +1614,19 @@ bool dvbridge_render_rgb(struct dvbridge_renderer *r, const struct pl_frame *sou
     struct dvbridge_gl_state state;
     save_gl_state(&state);
     const bool fine = r && fine_gamut_table(r, true);
+    if (r)
