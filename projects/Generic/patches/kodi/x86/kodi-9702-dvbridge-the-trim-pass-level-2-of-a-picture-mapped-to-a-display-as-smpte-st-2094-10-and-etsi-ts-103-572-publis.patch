         map_to_display(r, &r->ll_mapping, &image.color, &target.color, &ll_color,
@@ -1449,6 +1488,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                          ? pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->ll_mapping.black) / mask.peak
