@@ -1497,7 +1543,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     }
     time_render(r, &params);
     const bool rendered = pl_render_image(r->renderer, &image, &target, &params);
-    r->ready = rendered && mask.called && !mask.failed;
+    r->ready = rendered && mask.called && !mask.failed && (!trim.on || trim.called);
