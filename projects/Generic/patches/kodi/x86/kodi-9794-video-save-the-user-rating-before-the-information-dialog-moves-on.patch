From 7252ae4c5815d5b1e69c00254e116d48835a1a0f Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 22:26:06 +0100
Subject: [PATCH] [Video] Save the user rating before the information dialog
 moves on

The user rating set in the information dialog was only written to the
database when the dialog closed, compared with the rating of the item it
shows by then. Moving on to another movie through the cast or a movie set
replaces that item first, so the changed rating was never saved, while
the list already showed it. The rating is now saved before the dialog
moves on.
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 32 +++++++++++++++--------
 xbmc/video/dialogs/GUIDialogVideoInfo.h   |  1 +
 2 files changed, 22 insertions(+), 11 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index ecd8945..0129ce9 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -120,17 +120,7 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
   case GUI_MSG_WINDOW_DEINIT:
     {
       ClearCastList();
-
-      if (m_startUserrating != m_movieItem->GetVideoInfoTag()->m_iUserRating)
-      {
-        CVideoDatabase db;
-        if (db.Open())
-        {
-          m_hasUpdatedUserrating = true;
-          db.SetVideoUserRating(m_movieItem->GetVideoInfoTag()->m_iDbId, m_movieItem->GetVideoInfoTag()->m_iUserRating, m_movieItem->GetVideoInfoTag()->m_type);
-          db.Close();
-        }
-      }
+      SaveUserrating();
     }
     break;
 
@@ -239,6 +229,7 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
           std::string strItem = m_castList->Get(iItem)->GetLabel();
           if (m_movieItem->GetVideoInfoTag()->m_type == MediaTypeVideoCollection)
           {
+            SaveUserrating();
             SetMovie(m_castList->Get(iItem).get());
             const bool hasUpdatedThumb{m_hasUpdatedThumb};
             const bool hasUpdatedUserrating{m_hasUpdatedUserrating};
@@ -350,6 +341,23 @@ void CGUIDialogVideoInfo::SetUserrating(int userrating) const
   }
 }
 
+void CGUIDialogVideoInfo::SaveUserrating()
+{
+  if (m_startUserrating == m_movieItem->GetVideoInfoTag()->m_iUserRating)
+    return;
+
+  CVideoDatabase db;
+  if (db.Open())
+  {
+    m_hasUpdatedUserrating = true;
+    db.SetVideoUserRating(m_movieItem->GetVideoInfoTag()->m_iDbId,
+                          m_movieItem->GetVideoInfoTag()->m_iUserRating,
+                          m_movieItem->GetVideoInfoTag()->m_type);
+    db.Close();
+    m_startUserrating = m_movieItem->GetVideoInfoTag()->m_iUserRating;
+  }
+}
+
 void CGUIDialogVideoInfo::SetMovie(const CFileItem *item)
 {
   *m_movieItem = *item;
@@ -701,6 +709,8 @@ void CGUIDialogVideoInfo::DoSearch(std::string& strSearch, CFileItemList& items)
 
 void CGUIDialogVideoInfo::OnSearchItemFound(const CFileItem* pItem)
 {
+  SaveUserrating();
+
   VideoDbContentType type = pItem->GetVideoContentType();
 
   CVideoDatabase db;
diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.h b/xbmc/video/dialogs/GUIDialogVideoInfo.h
index 2fdc5a0..f9fb615 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.h
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.h
@@ -104,6 +104,7 @@ protected:
   void OnGetArt();
   void OnGetFanart();
   void OnSetUserrating() const;
+  void SaveUserrating();
   void PlayTrailer();
 
   static bool UpdateVideoItemSortTitle(const std::shared_ptr<CFileItem>& pItem);
-- 
