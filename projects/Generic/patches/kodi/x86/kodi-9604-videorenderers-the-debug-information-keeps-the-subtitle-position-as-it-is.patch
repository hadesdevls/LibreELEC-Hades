From 071d6f90e760294f4e1cb4d6b9aa89d95caab05f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 02:11:39 +0000
Subject: [PATCH] VideoRenderers: the debug information keeps the subtitle
 position as it is

Opening the player's debug information (ctrl+shift+o) put the subtitles
back where they start: a position moved by hand was lost. Its text is drawn
by a renderer of its own (CDebugRenderer), which is never given the settings
and starts with no position; the first time it draws,
ResetSubtitlePosition() computes its default and gives it to the player,
which gives it to the renderer of the subtitles.

A renderer now says whether its position is the player's
(m_positionIsPlayers, true as before); the debug information's is not, and
keeps what it computes to itself. Where its text is drawn does not change.
Kodi's Piers and master have the same code (read on 2026-11-03).

Found by pannal (CoreELEC builds, 1b5618e0cf); fixed here with a flag in
place of an override that repeats the computation.
---
 xbmc/cores/VideoPlayer/VideoRenderers/DebugRenderer.cpp   | 3 +++
 xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp | 6 ++++++
 xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h   | 4 ++++
 3 files changed, 13 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DebugRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DebugRenderer.cpp
index 8eacf26..969336b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DebugRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DebugRenderer.cpp
@@ -129,6 +129,9 @@ void CDebugRenderer::Flush()
 
 CDebugRenderer::CRenderer::CRenderer() : OVERLAY::CRenderer()
 {
+  // Hades: the debug information has its own place on the screen, not the subtitles' (see
+  // OVERLAY::CRenderer::m_positionIsPlayers)
+  m_positionIsPlayers = false;
 }
 
 void CDebugRenderer::CRenderer::Render(int idx, float depth)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
index 85a1394..ea5edd4 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -669,6 +669,12 @@ void CRenderer::ResetSubtitlePosition()
     pos = static_cast<int>(m_rv.Height()) - m_subtitleVerticalMargin + resInfo.Overscan.top;
   }
 
+  // Hades: a renderer whose position is not the subtitles' keeps it to itself: given to the
+  // player, it would replace the one the user set (the debug information, ctrl+shift+o, did that
+  // when it opened: its renderer is not given the settings and is at the default position)
+  if (!m_positionIsPlayers)
+    return;
+
   // Update player value (and callback to CRenderer::SetSubtitleVerticalPosition)
   auto& components = CServiceBroker::GetAppComponents();
   const auto appPlayer = components.GetComponent<CApplicationPlayer>();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
index 2eec15c..8a004d0 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.h
@@ -327,6 +327,10 @@ namespace OVERLAY {
     // Vertical margin setting the current baseline was computed from, in %
     float m_subtitleVerticalMarginPerc{0.0f};
     bool m_saveSubtitlePosition{false}; // To save subtitle position permanently
+    //! Hades: the subtitle position of this renderer is the player's (ResetSubtitlePosition() gives
+    //! it to the player, which gives it back). Not for a renderer of its own text, such as the
+    //! player's debug information (CDebugRenderer): its position is not the subtitles'.
+    bool m_positionIsPlayers{true};
     KODI::SUBTITLES::HorizontalAlign m_subtitleHorizontalAlign{
         KODI::SUBTITLES::HorizontalAlign::CENTER};
     KODI::SUBTITLES::Align m_subtitleAlign{KODI::SUBTITLES::Align::BOTTOM_OUTSIDE};
