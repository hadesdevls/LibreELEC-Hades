From b5ae06674968533494b477f6f10cb5a648cc3fb2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 07:38:29 +0000
Subject: [PATCH] Estuary: the output chosen for the video in two rows, its
 name and its value

The row "Dolby Vision output (this video): <choice>" of the Dolby Vision
page of the player information is a button of 885 px whose text has
855 px (textoffsetx on both sides); with its longer values (up to
1230 px in en_gb, five of its seven values in es_es) Kodi cut it with an
ellipsis wherever it did not have the focus, and the page opens with
the focus elsewhere. A button does not take <scroll>, and the column on
its right leaves no room to widen it. Now the name is a label of its
own, in the colour of the other names, and the button holds only the
value (730.8 px at most): same visibility, same navigation, no new
string. system/hades made again by make-playerinfo.py, which also brings the
reason "dualhdr" of the Dolby Vision page (the value of a video with both
Dolby Vision and HDR10+), added to Estuary without it.

Measured: the check of the skin in four languages passes with every
value of the row; make-playerinfo.py --check, pi_check2.py and
layout_rows.py pass. Not seen on a display.
---
 .../xml/DialogPlayerProcessInfo.xml             | 11 ++++++++++-
 system/hades/DialogHadesPlayerInfo.xml          | 17 ++++++++++++++++-
 system/hades/HadesIncludes.xml                  |  1 +
 3 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index ea132c2..6dae4b1 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -921,11 +921,20 @@
 				<visible>String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5555)</visible>
 				<!-- Hades: the output of this video, chosen here as in the video settings of the player
 				     (PlayerControl(HadesDVOutput)); only where there is more than one -->
+				<control type="label">
+					<width>885</width>
+					<height>50</height>
+					<aligny>bottom</aligny>
+					<label>[COLOR button_focus]$LOCALIZE[31762]:[/COLOR]</label>
+					<font>font14</font>
+					<shadowcolor>black</shadowcolor>
+					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
+				</control>
 				<control type="button" id="5560">
 					<width>885</width>
 					<height>50</height>
 					<textoffsetx>15</textoffsetx>
-					<label>$LOCALIZE[31762]: $INFO[Player.Process(videodvoutputchoice)]</label>
+					<label>$INFO[Player.Process(videodvoutputchoice)]</label>
 					<font>font14</font>
 					<texturenofocus />
 					<onup>5550</onup>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index 3946bb0..ea37e8a 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -3204,11 +3204,26 @@
 				<left>50</left>
 				<top>-204</top>
 				<visible>String.IsEqual(Window(Home).Property(HadesPlayerInfoPage),5555)</visible>
+				<control type="label">
+					<width>885</width>
+					<height>50</height>
+					<aligny>bottom</aligny>
+					<label>[COLOR FF12A0C7]$ADDON[skin.estuary 31762]:[/COLOR]</label>
+					<font>font14</font>
+					<shadowcolor>FF000000</shadowcolor>
+					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
+					<align>left</align>
+					<textcolor>FFF0F0F0</textcolor>
+					<disabledcolor>40FFFFFF</disabledcolor>
+					<selectedcolor>FFFFB70F</selectedcolor>
+					<scroll>false</scroll>
+					<scrollspeed>40</scrollspeed>
+				</control>
 				<control type="button" id="5560">
 					<width>885</width>
 					<height>50</height>
 					<textoffsetx>15</textoffsetx>
-					<label>$ADDON[skin.estuary 31762]: $INFO[Player.Process(videodvoutputchoice)]</label>
+					<label>$INFO[Player.Process(videodvoutputchoice)]</label>
 					<font>font14</font>
 					<texturenofocus />
 					<onup>5550</onup>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 435dd09..224cb24 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -102,6 +102,7 @@
 	<variable name="HadesDVReasonVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),settings)">$ADDON[skin.estuary 31760]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),choice)">$ADDON[skin.estuary 31761]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),dualhdr)">$ADDON[skin.estuary 32426]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),failed)">$ADDON[skin.estuary 31654]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),edid)">$ADDON[skin.estuary 31688]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.reason),display)">$ADDON[skin.estuary 31655]</value>
-- 
