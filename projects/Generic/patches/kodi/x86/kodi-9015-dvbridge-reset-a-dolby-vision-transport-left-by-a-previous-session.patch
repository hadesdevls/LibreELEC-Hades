From d68c73a789aec549301d0d3f5db71c6385b2700a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 04:45:58 +0000
Subject: [PATCH] dvbridge: reset a Dolby Vision transport left by a previous
 session

A Kodi that ends during native Dolby Vision output without restoring it
(killed by the service manager, or crashed) leaves DVBRIDGE_DV_STANDARD_LAB
or NV_HDMI_VSIF_METADATA set on the connector, with max bpc 8 and no
dither. The next Kodi then refused native output (Capture() requires the
property at 0) until a reboot; with the kernel backend the kernel even
refuses the ordinary 10-bit scanout, which is not bit exact.

At start, when one of these transport signals is set, stage its reset,
max bpc at the top of its range and dithering "auto" for the first
modeset. Nothing is touched otherwise.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp      |  5 +++++
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 24 ++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DVBridgeState.h   |  3 +++
 3 files changed, 32 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 35746aa..2669cfe 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -168,6 +168,11 @@ bool CWinSystemGbm::InitWindowSystem()
     }
   }
 
+#ifdef HAVE_DVBRIDGE
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+    CDVBridgeState::ClearLeftover(*drm);
+#endif
+
   CDRMConnector* connector = m_DRM->GetConnector();
   if (connector)
   {
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index 1ac5f3c..3b936a9 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -29,6 +29,30 @@ CDVBridgeState::Backend CDVBridgeState::GetBackend(CDRMConnector& connector)
   return Backend::NONE;
 }
 
+void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
+{
+  auto* connector = drm.GetConnector();
+  if (!connector)
+    return;
+  // Only when a transport signal proves it: otherwise nothing here is touched.
+  const bool kernel = connector->GetPropertyValue("DVBRIDGE_DV_STANDARD_LAB").value_or(0) != 0;
+  const bool nvidia = connector->GetPropertyValue("NV_HDMI_VSIF_METADATA").value_or(0) != 0;
+  if (!kernel && !nvidia)
+    return;
+  CLog::Log(LOGWARNING,
+            "DVBridge: native Dolby Vision output of a previous session is still set on the "
+            "connector; resetting it with the first modeset");
+  if (kernel)
+    drm.AddProperty(connector, "DVBRIDGE_DV_STANDARD_LAB", 0);
+  if (nvidia)
+    drm.AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0);
+  // The transport limited the link to 8 bpc without dither; the ordinary output sets neither.
+  if (auto limits = connector->GetRangePropertyLimits("max bpc"))
+    drm.AddProperty(connector, "max bpc", limits->second);
+  if (auto dither = connector->GetPropertyEnumValue("dithering mode", "auto"))
+    drm.AddProperty(connector, "dithering mode", *dither);
+}
+
 bool CDVBridgeState::Capture(CDRMAtomic& drm)
 {
   if (Captured())
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.h b/xbmc/windowing/gbm/drm/DVBridgeState.h
index 8b2fdd5..792cd15 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.h
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.h
@@ -27,6 +27,9 @@ public:
     NVIDIA,
   };
   static Backend GetBackend(CDRMConnector& connector);
+  //! A Kodi that ended during native output (killed or crashed) leaves the transport set on the
+  //! connector: stage its reset for the first modeset of this session.
+  static void ClearLeftover(CDRMAtomic& drm);
 
   bool Capture(CDRMAtomic& drm);
   bool Stage(CDRMAtomic& drm, bool restore);
