From b2d7d1145e433ac200e3e3dceb1becfb2ab156d3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 20:00:30 +0000
Subject: [PATCH] [depends] libdvdread: read every disc as DVD-Video, as before
 7.1

Since 7.1.0, DVDOpen2() and its siblings first open the medium one more
time (DVDProbeType()) to see whether it is a DVD-Audio or a DVD-VR disc,
and open it as that kind when it is. Kodi reads discs through libdvdnav
7.0.0, which only knows DVD-Video.

Seen on the build host with a path given to dvdnav_open2(), which is how
Kodi opens a folder and a drive (an image file goes through the stream
callbacks, where nothing is probed):

- a DVD-Video image that also carries /DVD_RTAV/VR_MANGR.IFO plays with
  libdvdread 7.0.1 and does not open with 7.1.1: libdvdnav is handed a
  DVD-VR reader and fails in ifoRead_TT_SRPT();
- the medium is opened one more time through libdvdcss for every open;
- for a folder, that extra open treats the directory as an image. Every
  read fails, UDFGetAVDP() returns the negative error, UDFFindPartition()
  only tests it for zero and goes on with a location that was never
  filled in, so the next seek goes wherever the stack says. The answer is
  still DVD-Video.

With _XBMC, DVDProbeType() answers DVD-Video at once, which is what 7.0.1
did for these calls.
---
 cmake/modules/FindLibDvdRead.cmake            |  3 ++-
 .../libdvdread/09-all-disableprobe.patch      | 25 +++++++++++++++++++
 tools/depends/target/libdvdread/Makefile      |  4 ++-
 3 files changed, 30 insertions(+), 2 deletions(-)
 create mode 100644 tools/depends/target/libdvdread/09-all-disableprobe.patch

diff --git a/cmake/modules/FindLibDvdRead.cmake b/cmake/modules/FindLibDvdRead.cmake
index b054ce4..b1b27eb 100644
--- a/cmake/modules/FindLibDvdRead.cmake
+++ b/cmake/modules/FindLibDvdRead.cmake
@@ -22,7 +22,8 @@ if(NOT TARGET LIBRARY::${CMAKE_FIND_PACKAGE_NAME})
     endif()
 
     set(patches "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/01-all-disableopendir.patch"
-                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/02-all-disablesymlink.patch")
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/02-all-disablesymlink.patch"
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/09-all-disableprobe.patch")
 
     if(WIN32 OR WINDOWS_STORE)
       list(APPEND patches "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/03-win-add_defines.patch"
diff --git a/tools/depends/target/libdvdread/09-all-disableprobe.patch b/tools/depends/target/libdvdread/09-all-disableprobe.patch
new file mode 100644
index 0000000..3071b13
--- /dev/null
+++ b/tools/depends/target/libdvdread/09-all-disableprobe.patch
@@ -0,0 +1,25 @@
+--- a/src/dvd_reader.c
++++ b/src/dvd_reader.c
+@@ -753,6 +753,14 @@ DVDOpen_error:
+ static dvd_type_t DVDProbeType( const char *ppath, void *stream,
+                                 dvd_reader_stream_cb *stream_cb  )
+ {
++#if defined(_XBMC)
++  /* Kodi: every disc is read as DVD-Video, the only kind libdvdnav plays,
++   * and is not opened a first time to look for DVD-Audio or DVD-VR */
++  (void)ppath;
++  (void)stream;
++  (void)stream_cb;
++  return DVD_V;
++#else
+   /* set DVD_V as the fallback */
+   dvd_type_t ret =  DVD_V;
+   int have_css;
+@@ -798,6 +806,7 @@ static dvd_type_t DVDProbeType( const char *ppath, void *stream,
+   DVDClose(ctx);
+ 
+   return ret;
++#endif /* _XBMC */
+ }
+ 
+ dvd_reader_t *DVDOpen( const char *ppath )
diff --git a/tools/depends/target/libdvdread/Makefile b/tools/depends/target/libdvdread/Makefile
index f74221e..8d54389 100644
--- a/tools/depends/target/libdvdread/Makefile
+++ b/tools/depends/target/libdvdread/Makefile
@@ -7,7 +7,8 @@ DEPS = ../../Makefile.include LIBDVDREAD-VERSION Makefile ../../download-files.i
                                   05-win-remove_stat.patch \
                                   06-win-remove_config_h.patch \
                                   07-emscripten-bswap.patch \
-                                  08-win-ssize_t.patch
+                                  08-win-ssize_t.patch \
+                                  09-all-disableprobe.patch
 
 MESON_BUILD_TYPE=release
 
@@ -44,6 +45,7 @@ all: .installed-$(PLATFORM)
 	cd $(PLATFORM); $(ARCHIVE_TOOL) $(ARCHIVE_TOOL_FLAGS) $(TARBALLS_LOCATION)/$(ARCHIVE)
 	cd $(PLATFORM); patch -p1 -i ../01-all-disableopendir.patch
 	cd $(PLATFORM); patch -p1 -i ../02-all-disablesymlink.patch
+	cd $(PLATFORM); patch -p1 -i ../09-all-disableprobe.patch
 ifeq ($(TARGET_PLATFORM),windows)
 	cd $(PLATFORM); patch -p1 -i ../03-win-add_defines.patch
 	cd $(PLATFORM); patch -p1 -i ../04-win-uwp_compat.patch
