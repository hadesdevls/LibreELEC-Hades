From 377574ea0b8b750c27add1d3bcf0e35e502f9818 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sun, 11 Oct 2026 14:51:38 -0700
Subject: [PATCH] [Windows] Enable ccache for Visual Studio builds

Route MSVC through ccache for Kodi, internal CMake/Meson dependencies,
and FFmpeg while retaining Visual Studio packaging.

Use embedded debug information and disable precompiled headers to
enable reliable caching. Resolve Chocolatey shims to the real
executable and validate compiler interception.

Preserve optional caching with AUTO as the default, ON to require
ccache, and OFF to disable it.
---
 cmake/modules/FindFFMPEG.cmake            |  5 ++
 cmake/modules/buildtools/FindCCache.cmake | 65 ++++++++++++++++++++---
 cmake/scripts/common/ModuleHelpers.cmake  | 19 ++++++-
 cmake/scripts/windows/CCache.cmake        | 29 ++++++++++
 cmake/scripts/windows/Macros.cmake        |  5 ++
 docs/README.Windows.md                    | 37 +++++++++++++
 tools/buildsteps/windows/buildffmpeg.sh   | 10 +++-
 7 files changed, 161 insertions(+), 9 deletions(-)
 create mode 100644 cmake/scripts/windows/CCache.cmake

diff --git a/cmake/modules/FindFFMPEG.cmake b/cmake/modules/FindFFMPEG.cmake
index f554103..ddddab1 100644
--- a/cmake/modules/FindFFMPEG.cmake
+++ b/cmake/modules/FindFFMPEG.cmake
@@ -59,6 +59,11 @@ macro(buildFFMPEG)
 
     set(msys_env MSYS2_PATH_TYPE=inherit
                  MSYS_INSTALL_PATH=${MSYS_INSTALL_PATH})
+    if(CCACHE_FOUND)
+      list(APPEND msys_env "CCACHE_PROGRAM=${CCACHE_PROGRAM}")
+    else()
+      list(APPEND msys_env "CCACHE_PROGRAM=")
+    endif()
 
     set(PROMPTLEVEL noprompt)
 
diff --git a/cmake/modules/buildtools/FindCCache.cmake b/cmake/modules/buildtools/FindCCache.cmake
index 7318e2d..043efcb 100644
--- a/cmake/modules/buildtools/FindCCache.cmake
+++ b/cmake/modules/buildtools/FindCCache.cmake
@@ -2,13 +2,54 @@
 # FindCCache
 # ----------
 # Finds ccache and sets it up as compiler wrapper.
-# This should ideally be called before the call to project().
+# Visual Studio support requires this to be called after project().
 #
 # See: https://crascit.com/2016/04/09/using-ccache-with-cmake/
 
+set(_ccache_explicit_program "${CCACHE_PROGRAM}")
 find_program(CCACHE_PROGRAM ccache)
 
-if(CCACHE_PROGRAM)
+set(_ccache_required_vars CCACHE_PROGRAM)
+if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_GENERATOR MATCHES "Visual Studio")
+  if(CCACHE_PROGRAM AND NOT _ccache_explicit_program)
+    get_filename_component(_ccache_directory "${CCACHE_PROGRAM}" DIRECTORY)
+    file(GLOB _ccache_chocolatey_programs
+         "${_ccache_directory}/../lib/ccache/tools/ccache.exe"
+         "${_ccache_directory}/../lib/ccache/tools/*/ccache.exe")
+    if(_ccache_chocolatey_programs)
+      list(SORT _ccache_chocolatey_programs COMPARE NATURAL ORDER DESCENDING)
+      list(GET _ccache_chocolatey_programs 0 CCACHE_PROGRAM)
+      set(CCACHE_PROGRAM "${CCACHE_PROGRAM}" CACHE FILEPATH "Path to ccache executable" FORCE)
+    endif()
+  endif()
+
+  # Package-manager shims may work as ccache.exe but fail when relocated as cl.exe.
+  set(CCACHE_MSVC_USABLE FALSE)
+  if(CCACHE_PROGRAM)
+    set(_ccache_probe "${CMAKE_BINARY_DIR}/CMakeFiles/ccache/cl.exe")
+    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/CMakeFiles/ccache")
+    file(COPY_FILE "${CCACHE_PROGRAM}" "${_ccache_probe}" ONLY_IF_DIFFERENT
+         RESULT _ccache_copy_result)
+    if(_ccache_copy_result STREQUAL "0")
+      execute_process(COMMAND "${CMAKE_COMMAND}" -E env CCACHE_DISABLE=1 CCACHE_NOSTATS=1
+                              "CCACHE_COMPILER=${CMAKE_CXX_COMPILER}"
+                              "${_ccache_probe}" /?
+                      RESULT_VARIABLE _ccache_probe_result
+                      OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
+      if(_ccache_probe_result STREQUAL "0")
+        set(CCACHE_MSVC_USABLE TRUE)
+      endif()
+    endif()
+  endif()
+  list(APPEND _ccache_required_vars CCACHE_MSVC_USABLE)
+  set(_ccache_failure_reason
+      "Visual Studio requires a real ccache executable that works when copied as cl.exe. Set CCACHE_PROGRAM to the real executable (for Chocolatey, under lib/ccache/tools), or use ENABLE_CCACHE=OFF.")
+  if(CCACHE_PROGRAM AND NOT CCACHE_MSVC_USABLE AND NOT CCache_FIND_REQUIRED)
+    message(WARNING "Disabling ccache: ${CCACHE_PROGRAM} cannot be used as cl.exe. ${_ccache_failure_reason}")
+  endif()
+endif()
+
+if(CCACHE_PROGRAM AND (NOT DEFINED CCACHE_MSVC_USABLE OR CCACHE_MSVC_USABLE))
   execute_process(COMMAND "${CCACHE_PROGRAM}" --version
                   OUTPUT_VARIABLE CCACHE_VERSION
                   OUTPUT_STRIP_TRAILING_WHITESPACE)
@@ -17,12 +58,24 @@ if(CCACHE_PROGRAM)
 endif()
 
 include(FindPackageHandleStandardArgs)
-find_package_handle_standard_args(CCache REQUIRED_VARS CCACHE_PROGRAM
-                                  VERSION_VAR CCACHE_VERSION)
+if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_GENERATOR MATCHES "Visual Studio")
+  set(CCache_FIND_VERSION 4.13.3)
+endif()
+find_package_handle_standard_args(CCache REQUIRED_VARS ${_ccache_required_vars}
+                                  VERSION_VAR CCACHE_VERSION
+                                  REASON_FAILURE_MESSAGE "${_ccache_failure_reason}")
 
 if(CCACHE_FOUND)
-  # Supports Unix Makefiles, Ninja and Xcode
-  if(XCODE)
+  # Supports Unix Makefiles, Ninja, Visual Studio and Xcode
+  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_GENERATOR MATCHES "Visual Studio")
+    include(${CMAKE_CURRENT_LIST_DIR}/../../scripts/windows/CCache.cmake)
+    set(CMAKE_CXX_SCAN_FOR_MODULES OFF PARENT_SCOPE)
+    # Embedded debug information can exceed the archive size limit.
+    set(ENABLE_STATIC_LIBS TRUE PARENT_SCOPE)
+    foreach(_variable IN LISTS _ccache_variables)
+      set(${_variable} "${${_variable}}" PARENT_SCOPE)
+    endforeach()
+  elseif(XCODE)
     file(WRITE "${CMAKE_BINARY_DIR}/launch-c" "#!/bin/sh\nexec \"${CCACHE_PROGRAM}\" \"${CMAKE_C_COMPILER}\" \"$@\"\n")
     file(WRITE "${CMAKE_BINARY_DIR}/launch-cxx" "#!/bin/sh\nexec \"${CCACHE_PROGRAM}\" \"${CMAKE_CXX_COMPILER}\" \"$@\"\n")
     execute_process(COMMAND chmod +x "${CMAKE_BINARY_DIR}/launch-c" "${CMAKE_BINARY_DIR}/launch-cxx")
diff --git a/cmake/scripts/common/ModuleHelpers.cmake b/cmake/scripts/common/ModuleHelpers.cmake
index 9be1dc4..6375a30 100644
--- a/cmake/scripts/common/ModuleHelpers.cmake
+++ b/cmake/scripts/common/ModuleHelpers.cmake
@@ -266,6 +266,15 @@ macro(BUILD_DEP_TARGET)
     # We can disable adding them with WIN_DISABLE_PROJECT_FLAGS. This is potentially required
     # for host build tools (eg flatc) that may be a different arch to the core app
     if(WIN32 OR WINDOWS_STORE)
+      if(CCACHE_FOUND AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND
+         CMAKE_GENERATOR MATCHES "Visual Studio")
+        list(APPEND CMAKE_ARGS "-DCCACHE_PROGRAM=${CCACHE_PROGRAM}"
+                               "-DCMAKE_PROJECT_INCLUDE=${PROJECTSOURCE}/cmake/scripts/windows/CCache.cmake"
+                               -DCMAKE_POLICY_DEFAULT_CMP0141=NEW)
+      elseif(CMAKE_GENERATOR MATCHES "Visual Studio")
+        # External projects retain their CMake cache when ccache is disabled.
+        list(APPEND CMAKE_ARGS -UCMAKE_PROJECT_INCLUDE -UCCACHE_PROGRAM)
+      endif()
       if(NOT (DEFINED WIN_DISABLE_PROJECT_FLAGS OR
          ${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}_LIB_TYPE STREQUAL "native"))
         list(APPEND CMAKE_ARGS "-DCMAKE_C_FLAGS=${CMAKE_C_FLAGS} $<$<CONFIG:Debug>:${CMAKE_C_FLAGS_DEBUG}> $<$<CONFIG:Release>:${CMAKE_C_FLAGS_RELEASE}> ${${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_C_FLAGS}"
@@ -855,8 +864,14 @@ function(create_mesonbinaries)
     set(input "${${cmake_binary_name}}")
     string(STRIP "${input}" input)
 
-    string(PREPEND input "${meson_label_name} = '")
-    string(APPEND input "'")
+    if(CCACHE_FOUND AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND
+       CMAKE_GENERATOR MATCHES "Visual Studio" AND
+       (meson_label_name STREQUAL "c" OR meson_label_name STREQUAL "cpp"))
+      set(input "${meson_label_name} = ['${CCACHE_PROGRAM}', '${input}']")
+    else()
+      string(PREPEND input "${meson_label_name} = '")
+      string(APPEND input "'")
+    endif()
     string(APPEND output_string "${input}\n")
   endforeach()
 
diff --git a/cmake/scripts/windows/CCache.cmake b/cmake/scripts/windows/CCache.cmake
new file mode 100644
index 0000000..43eb3b4
--- /dev/null
+++ b/cmake/scripts/windows/CCache.cmake
@@ -0,0 +1,29 @@
+if(NOT CMAKE_GENERATOR MATCHES "Visual Studio" OR
+   NOT (CMAKE_C_COMPILER_ID STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC"))
+  return()
+endif()
+
+file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/ccache")
+file(COPY_FILE "${CCACHE_PROGRAM}" "${CMAKE_BINARY_DIR}/ccache/cl.exe" ONLY_IF_DIFFERENT)
+list(APPEND CMAKE_VS_GLOBALS "CLToolExe=cl.exe"
+                           "CLToolPath=${CMAKE_BINARY_DIR}/ccache"
+                           "UseMultiToolTask=true"
+                           "EnforceProcessCountAcrossBuilds=true")
+if(DEFINED ENV{MAXTHREADS})
+  list(APPEND CMAKE_VS_GLOBALS "CL_MPCount=$ENV{MAXTHREADS}")
+endif()
+
+set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>")
+set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
+set(_ccache_variables CMAKE_VS_GLOBALS CMAKE_MSVC_DEBUG_INFORMATION_FORMAT
+                      CMAKE_DISABLE_PRECOMPILE_HEADERS)
+
+# Explicit debug flags take precedence over MSVC_DEBUG_INFORMATION_FORMAT.
+foreach(_language C CXX)
+  foreach(_configuration "" _DEBUG _RELEASE _RELWITHDEBINFO _MINSIZEREL)
+    set(_variable CMAKE_${_language}_FLAGS${_configuration})
+    string(REGEX REPLACE "(^|[ \t])[-/]Z[iI]([ \t]|$)" "\\1/Z7\\2"
+           ${_variable} "${${_variable}}")
+    list(APPEND _ccache_variables ${_variable})
+  endforeach()
+endforeach()
diff --git a/cmake/scripts/windows/Macros.cmake b/cmake/scripts/windows/Macros.cmake
index ac33024..0a96f44 100644
--- a/cmake/scripts/windows/Macros.cmake
+++ b/cmake/scripts/windows/Macros.cmake
@@ -37,6 +37,11 @@ function(add_precompiled_header target pch_header pch_source)
   endforeach()
   # A PCH compiled in C++ mode cannot be used for C code
   list(FILTER sources EXCLUDE REGEX "\\.c$")
+
+  if(CMAKE_DISABLE_PRECOMPILE_HEADERS)
+    set_source_files_properties(${sources} PROPERTIES COMPILE_FLAGS "/FI\"${pch_header}\"")
+    return()
+  endif()
   
   set_source_files_properties(${sources}
                               PROPERTIES COMPILE_FLAGS "/Yu\"${pch_header}\" /Fp\"${pch_binary}\" /FI\"${pch_header}\""
diff --git a/docs/README.Windows.md b/docs/README.Windows.md
index e7d7778..21d55c9 100644
--- a/docs/README.Windows.md
+++ b/docs/README.Windows.md
@@ -242,6 +242,43 @@ cmake --build . --config "Release"
 *Normal* 32bit, 64bit and ARM 64bit builds generate an `exe` file ready to run, located at `%userprofile%\kodi-build\Debug` or `%userprofile%\kodi-build\Release`, depending on the build config.
 UWP builds generate `msix`, `appxsym` and `cer` files, located inside directories at `%userprofile%\kodi-build\AppPackages\kodi\`. You can install them following this **[guide](https://kodi.wiki/view/HOW-TO:Install_Kodi_for_Universal_Windows_Platform)**.
 
+### Compiler caching
+
+MSVC builds using Visual Studio automatically use [ccache](https://ccache.dev/) 4.13.3 or newer
+when `ccache.exe` is on `PATH`. Add `-DENABLE_CCACHE=ON` to the configure command to
+require it, or `-DENABLE_CCACHE=OFF` to disable it. The default is `AUTO`.
+This also enables caching for internal dependencies built with MSVC through CMake
+or Meson, and the MSYS build of FFmpeg.
+
+Automatically discovered Chocolatey shims are resolved to the real executable
+under the installation's `lib\ccache\tools` directory. An explicit
+`CCACHE_PROGRAM` must point to the real executable, not a Chocolatey shim.
+If it cannot run when copied as `cl.exe`, `AUTO` disables caching with a warning
+and `ON` reports an error.
+
+Use a fresh Kodi build directory when enabling, disabling or relocating ccache.
+Existing Meson dependency builds retain their original compiler command;
+removing only `CMakeCache.txt` is not enough.
+
+With ccache enabled, Kodi uses embedded compiler debug information (`/Z7`) and
+disables precompiled headers and automatic C++ module scans. Per-directory
+libraries keep embedded symbols within MSVC's archive size limit. Linker PDBs are
+still produced. Cold builds can be slower and object files larger; subsequent
+compilations can reuse cached objects.
+
+For a persistent cache, set these variables in the environment used to configure
+and build Kodi, including the Jenkins agent service environment:
+
+```bat
+set CCACHE_DIR=%LOCALAPPDATA%\ccache
+set CCACHE_MAXSIZE=20G
+```
+
+Keep the cache outside directories cleaned between builds and keep source and
+build directory paths stable for reliable reuse of debug information. Inspect
+statistics with `ccache -s`, or reset only the counters with `ccache -s -z` before
+measuring a rebuild. Restart the agent service after changing its environment.
+
