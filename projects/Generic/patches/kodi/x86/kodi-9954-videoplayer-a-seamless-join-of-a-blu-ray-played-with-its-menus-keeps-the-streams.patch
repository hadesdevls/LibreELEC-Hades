+
+#pragma once
+
+// Hades: a Blu-ray played with the disc's menus (navigation mode, HDMV or BD-J) and the join of
+// two play items of its playlist.
+//
+// In navigation mode every play item that libbluray opens is a held event: the player drains its
+// streams, closes the demuxer and the stream players, and opens them again for the next play item.
+// Where the playlist joins the two seamlessly (connection_condition 5 or 6: a film with several
+// cuts made of shared and specific clips), that is a pause in picture and sound at each join that
+// a reference player does not make. Here a join goes on without opening the streams again only
+// where nothing a demuxer or a decoder sees changes across it:
+//   - the play item is the next one of the playlist, reached by reading to the end of the one
+//     before: libbluray tells it with the first bytes of its clip (the read that opens a clip
+//     returns its first bytes; a jump - a seek, a menu's command, a BD-J application - queues the
+//     play item before anything is read, and libbluray hands it on without bytes), and those bytes
+//     are where the play item begins in the playlist;
+//   - its connection condition, in the playlist, is 5 or 6 (libbluray reads such a clip from its
+//     first packet and raises no discontinuity);
+//   - the play item before has no still at its end;
+//   - the streams that the playlist presents in the two play items are the same (PID, coding,
+//     format, rate, language, aspect, sub-path, dynamic range, colour space and their flags), and
+//     so are the streams that the two clips carry (program map PID, every elementary stream of the
+//     transport stream and its attributes, the PCR PID of each STC sequence);
+//   - and the demuxer reading puts the packets on the timeline (BlurayTitleTime.h), which a 3D
+//     disc whose second view is read does not.
+// Anything else, or anything not known, plays as before: the streams are opened again.
+//
+// A play item kept goes on the timeline of the play item that the demuxer opened with: its
+// distance from its IN time, plus where it starts in the title less where that play item starts,
+// on that play item's own clock. Its packets go on where the play item before ends, as when the
+// playlist is played directly.
+//
+// Pure, for the tests.
+
+#include "BlurayTitleTime.h"
+
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <string>
+
+#include <libbluray/bluray.h>
+#include <libbluray/clpi_data.h>
+
+namespace KODI::BLURAYJOIN
+{
+
+enum class Verdict
+{
+  KEEP, //!< the streams go on
+  NO_BYTES, //!< told without the first bytes of its clip: a jump, not the end of the one before
+  POSITION, //!< its bytes are not where it begins in the playlist
+  NO_CONNECTION, //!< its connection condition is not known
+  NOT_SEAMLESS, //!< its connection condition is not 5 or 6
+  STILL, //!< the play item before ends with a still
+  SECOND_VIEW, //!< the second view of a 3D disc is read, from a clip of its own for each play item
+  NO_TIMELINE, //!< the demuxer reading does not put packets on the timeline
+  NO_ANCHOR, //!< the play item the demuxer opened with is not known
+  STREAMS, //!< the streams the playlist presents differ
+  NO_CLIP_INFO, //!< the clip information of one of the two is not known
+  CLIP_STREAMS, //!< the streams the two clips carry differ
+};
+
+//! What is known at the join, when libbluray tells the next play item
+struct Facts
+{
+  int readBytes{0}; //!< what the read that told the play item returned
+  std::optional<uint64_t> readStart; //!< where those bytes begin in the playlist
+  uint64_t itemStart{0}; //!< where the play item begins in the playlist (PlayItemStart())
+  int connectionCondition{-1}; //!< of the play item, from its playlist; -1 not known
+  uint8_t stillBefore{0}; //!< the still mode of the play item before (bd_still_mode_e)
+  bool secondView{false};
+  bool timeline{false};
+  bool anchor{false};
+  const BLURAY_CLIP_INFO* before{nullptr};
+  const BLURAY_CLIP_INFO* after{nullptr};
+  const CLPI_CL* clipBefore{nullptr};
+  const CLPI_CL* clipAfter{nullptr};
+};
+
+//! Where a play item of the playlist begins in it, in bytes, as libbluray counts its position:
+//! the packets libbluray reads of each play item before it
+inline uint64_t PlayItemStart(const BLURAY_TITLE_INFO& title, uint32_t item)
+{
+  uint64_t packets = 0;
+  for (uint32_t i = 0; i < item && i < title.clip_count; ++i)
+    packets += title.clips[i].pkt_count;
+  return packets * 192;
+}
+
+inline bool SameStream(const BLURAY_STREAM_INFO& a, const BLURAY_STREAM_INFO& b)
+{
+  return a.coding_type == b.coding_type && a.format == b.format && a.rate == b.rate &&
+         a.char_code == b.char_code && std::memcmp(a.lang, b.lang, sizeof(a.lang)) == 0 &&
+         a.pid == b.pid && a.aspect == b.aspect && a.subpath_id == b.subpath_id &&
+         a.dynamic_range_type == b.dynamic_range_type && a.color_space == b.color_space &&
+         a.cr_flag == b.cr_flag && a.hdr_plus_flag == b.hdr_plus_flag;
+}
+
+inline bool SameStreamList(unsigned countA,
+                           const BLURAY_STREAM_INFO* a,
+                           unsigned countB,
+                           const BLURAY_STREAM_INFO* b)
+{
+  if (countA != countB)
+    return false;
+  if (countA && (!a || !b))
+    return false;
+  for (unsigned i = 0; i < countA; ++i)
+    if (!SameStream(a[i], b[i]))
+      return false;
+  return true;
+}
+
+//! The streams that the playlist presents in two play items (what the player selects and decodes)
+inline bool SameStreams(const BLURAY_CLIP_INFO& a, const BLURAY_CLIP_INFO& b, std::string* what)
+{
+  struct List
+  {
+    const char* name;
+    unsigned countA, countB;
+    const BLURAY_STREAM_INFO *a, *b;
+  };
+  const List lists[] = {
+      {"video", a.video_stream_count, b.video_stream_count, a.video_streams, b.video_streams},
+      {"audio", a.audio_stream_count, b.audio_stream_count, a.audio_streams, b.audio_streams},
+      {"subtitle (PG)", a.pg_stream_count, b.pg_stream_count, a.pg_streams, b.pg_streams},
+      {"menu (IG)", a.ig_stream_count, b.ig_stream_count, a.ig_streams, b.ig_streams},
+      {"secondary audio", a.sec_audio_stream_count, b.sec_audio_stream_count, a.sec_audio_streams,
+       b.sec_audio_streams},
+      {"secondary video", a.sec_video_stream_count, b.sec_video_stream_count, a.sec_video_streams,
+       b.sec_video_streams},
+      {"Dolby Vision", a.dv_stream_count, b.dv_stream_count, a.dv_streams, b.dv_streams},
+  };
+  for (const List& list : lists)
+    if (!SameStreamList(list.countA, list.a, list.countB, list.b))
+    {
+      if (what)
+        *what = std::string(list.name) + " streams";
+      return false;
+    }
+  return true;
+}
+
+inline bool SameClipStream(const CLPI_PROG_STREAM& a, const CLPI_PROG_STREAM& b)
+{
+  return a.pid == b.pid && a.coding_type == b.coding_type && a.format == b.format &&
+         a.rate == b.rate && a.aspect == b.aspect && a.oc_flag == b.oc_flag &&
+         a.char_code == b.char_code && std::memcmp(a.lang, b.lang, sizeof(a.lang)) == 0 &&
+         a.cr_flag == b.cr_flag && a.dynamic_range_type == b.dynamic_range_type &&
+         a.color_space == b.color_space && a.hdr_plus_flag == b.hdr_plus_flag;
+}
+
+//! The streams that two clips carry, as their clip information describes their transport streams
+inline bool SameClipStreams(const CLPI_CL& a, const CLPI_CL& b, std::string* what)
+{
+  auto say = [what](const char* text)
+  {
+    if (what)
+      *what = text;
+    return false;
+  };
+  if (a.clip.clip_stream_type != b.clip.clip_stream_type ||
+      a.clip.application_type != b.clip.application_type)
+    return say("the type of the clips");
+  if (a.program.num_prog != b.program.num_prog || a.program.num_prog == 0 || !a.program.progs ||
+      !b.program.progs)
+    return say("the programs of the clips");
+  for (unsigned p = 0; p < a.program.num_prog; ++p)
+  {
+    const CLPI_PROG& pa = a.program.progs[p];
+    const CLPI_PROG& pb = b.program.progs[p];
+    if (pa.program_map_pid != pb.program_map_pid || pa.num_streams != pb.num_streams ||
+        (pa.num_streams && (!pa.streams || !pb.streams)))
+      return say("the program map of the clips");
+    for (unsigned s = 0; s < pa.num_streams; ++s)
+      if (!SameClipStream(pa.streams[s], pb.streams[s]))
+        return say("the elementary streams of the clips");
+  }
+  // one PCR PID for the two clips, in every STC sequence of each
+  std::optional<uint16_t> pcr;
+  for (const CLPI_CL* clip : {&a, &b})
+  {
+    if (clip->sequence.num_atc_seq && !clip->sequence.atc_seq)
+      return say("the sequences of the clips");
+    for (unsigned i = 0; i < clip->sequence.num_atc_seq; ++i)
+    {
+      const CLPI_ATC_SEQ& atc = clip->sequence.atc_seq[i];
+      if (atc.num_stc_seq && !atc.stc_seq)
+        return say("the sequences of the clips");
+      for (unsigned j = 0; j < atc.num_stc_seq; ++j)
+      {
+        if (pcr && *pcr != atc.stc_seq[j].pcr_pid)
+          return say("the PCR PID of the clips");
+        pcr = atc.stc_seq[j].pcr_pid;
+      }
+    }
+  }
+  return true;
+}
+
+//! Whether the streams go on at the join, and if not, why (the first that does not hold)
+inline Verdict Decide(const Facts& facts, std::string* what = nullptr)
+{
+  if (facts.readBytes <= 0)
+    return Verdict::NO_BYTES;
+  if (!facts.readStart || *facts.readStart != facts.itemStart)
+    return Verdict::POSITION;
+  if (facts.connectionCondition < 0)
+    return Verdict::NO_CONNECTION;
+  if (facts.connectionCondition != 5 && facts.connectionCondition != 6)
+    return Verdict::NOT_SEAMLESS;
+  if (facts.stillBefore != BLURAY_STILL_NONE)
+    return Verdict::STILL;
+  if (facts.secondView)
+    return Verdict::SECOND_VIEW;
+  if (!facts.timeline)
+    return Verdict::NO_TIMELINE;
+  if (!facts.anchor)
+    return Verdict::NO_ANCHOR;
+  if (!facts.before || !facts.after)
+    return Verdict::STREAMS;
+  if (!SameStreams(*facts.before, *facts.after, what))
+    return Verdict::STREAMS;
+  if (!facts.clipBefore || !facts.clipAfter)
+    return Verdict::NO_CLIP_INFO;
+  if (!SameClipStreams(*facts.clipBefore, *facts.clipAfter, what))
+    return Verdict::CLIP_STREAMS;
+  return Verdict::KEEP;
+}
+
+//! Why the streams are opened again, in plain words, for the log
+inline const char* Reason(Verdict verdict)
+{
+  switch (verdict)
+  {
+    case Verdict::KEEP:
+      return "the join is seamless and the streams are the same";
+    case Verdict::NO_BYTES:
+      return "libbluray told it without the first bytes of its clip: it was jumped to, not "
+             "reached at the end of the play item before";
+    case Verdict::POSITION:
+      return "its first bytes are not where it begins in the playlist";
+    case Verdict::NO_CONNECTION:
+      return "its connection condition is not known (the playlist could not be read)";
+    case Verdict::NOT_SEAMLESS:
+      return "its connection condition is not a seamless one (5 or 6)";
+    case Verdict::STILL:
+      return "the play item before ends with a still";
+    case Verdict::SECOND_VIEW:
+      return "the second view of the 3D disc is read from a clip of its own for each play item";
+    case Verdict::NO_TIMELINE:
+      return "the demuxer does not put its packets on the timeline of the playlist";
+    case Verdict::NO_ANCHOR:
+      return "the play item that the demuxer opened with is not known";
+    case Verdict::STREAMS:
+      return "the streams that the playlist presents differ";
+    case Verdict::NO_CLIP_INFO:
+      return "the clip information of the two play items is not known";
+    case Verdict::CLIP_STREAMS:
+      return "the streams that the two clips carry differ";
+  }
+  return "";
+}
+
+//! A play item kept on the timeline of the play item that the demuxer opened with (anchor: its IN
+//! time and where it starts in the title), 90 kHz: its IN time, and where it starts on that
+//! timeline. Nothing for a play item that starts before the anchor.
+inline std::optional<BLURAYTIMELINE::ClipTime> KeptTime(uint64_t inTime,
+                                                        uint64_t startTime,
+                                                        const BLURAYTIMELINE::ClipTime& anchor)
+{
+  if (startTime < anchor.startTime)
+    return {};
+  return BLURAYTIMELINE::ClipTime{inTime, startTime - anchor.startTime + anchor.inTime};
+}
+
+} // namespace KODI::BLURAYJOIN
