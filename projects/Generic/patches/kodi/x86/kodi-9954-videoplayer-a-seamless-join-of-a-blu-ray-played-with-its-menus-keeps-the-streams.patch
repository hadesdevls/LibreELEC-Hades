+bool CDVDInputStreamBluray::KeepStreamsAtJoin(int readBytes)
+{
+  namespace JOIN = KODI::BLURAYJOIN;
+  {
+    std::unique_lock lock(m_navTimelineLock);
+    m_navKept.reset();
+  }
+
+  // only the join of a play item with the one before it; any other play item (a jump) is held as
+  // before, unsaid
+  const uint32_t item = m_event.param;
+  if (!m_titleInfo || item == 0 || item != m_playItem + 1 || item >= m_titleInfo->clip_count)
+    return false;
+  const BLURAY_CLIP_INFO& before = m_titleInfo->clips[item - 1];
+  const BLURAY_CLIP_INFO& after = m_titleInfo->clips[item];
+
+  JOIN::Facts facts;
+  facts.readBytes = readBytes;
+  if (readBytes > 0)
+  {
+    const uint64_t position = bd_tell(m_bd);
+    if (position >= static_cast<uint64_t>(readBytes))
+      facts.readStart = position - static_cast<uint64_t>(readBytes);
+  }
+  facts.itemStart = JOIN::PlayItemStart(*m_titleInfo, item);
+  facts.stillBefore = before.still_mode;
+  facts.secondView = KODI::MULTIVIEW::DiscSecondView(m_secondViewWanted, m_stereoscopicDisc, false);
+  facts.timeline = m_timelineReader;
+  std::optional<KODI::BLURAYTIMELINE::ClipTime> anchor;
+  {
+    std::unique_lock lock(m_navTimelineLock);
+    anchor = m_navAnchor;
+    if (m_connectionsPlaylist == m_playlist && item < m_connections.size())
+      facts.connectionCondition = m_connections[item];
+  }
+  facts.anchor = anchor.has_value();
+  facts.before = &before;
+  facts.after = &after;
+
+  std::string what;
+  JOIN::Verdict verdict = JOIN::Decide(facts, &what);
+  if (verdict == JOIN::Verdict::NO_CLIP_INFO)
+  {
+    // the clip information of the two only once everything else holds (copies that libbluray
+    // read when it opened the title: no access to the disc)
+    CLPI_CL* clipBefore = bd_get_clpi(m_bd, item - 1);
+    CLPI_CL* clipAfter = bd_get_clpi(m_bd, item);
+    facts.clipBefore = clipBefore;
+    facts.clipAfter = clipAfter;
+    verdict = JOIN::Decide(facts, &what);
+    if (clipBefore)
+      bd_free_clpi(clipBefore);
+    if (clipAfter)
+      bd_free_clpi(clipAfter);
+  }
+
+  std::optional<KODI::BLURAYTIMELINE::ClipTime> kept;
+  if (verdict == JOIN::Verdict::KEEP)
+  {
+    kept = JOIN::KeptTime(after.in_time, after.start_time, *anchor);
+    if (!kept)
+      verdict = JOIN::Verdict::NO_ANCHOR;
+  }
+
+  if (verdict != JOIN::Verdict::KEEP)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - play item {} (clip {}) follows play item {} of playlist {}: "
+              "the player opens its streams again for it (connection condition {}): {}{}",
+              item, after.clip_id, item - 1, m_playlist,
+              facts.connectionCondition < 0 ? std::string("not known")
+                                            : std::to_string(facts.connectionCondition),
+              JOIN::Reason(verdict), what.empty() ? std::string() : " (" + what + ")");
+    return false;
+  }
+
+  {
+    std::unique_lock lock(m_navTimelineLock);
+    m_navKept = kept;
+  }
+  CLog::Log(LOGINFO,
+            "CDVDInputStreamBluray - play item {} (clip {}) follows play item {} of playlist {} "
+            "seamlessly (connection condition {}) with the same streams: they go on, without the "
+            "player opening them again; its packets go on the timeline at {:.3f} s (its IN time is "
+            "{:.3f} s, the play item before ended at {:.3f} s of its clip, a step of {:+.3f} s "
+            "between the two clocks)",
+            item, after.clip_id, item - 1, m_playlist, facts.connectionCondition,
+            kept->startTime / 90000.0, after.in_time / 90000.0, before.out_time / 90000.0,
+            (static_cast<double>(after.in_time) - static_cast<double>(before.out_time)) / 90000.0);
+  return true;
+}
+
+void CDVDInputStreamBluray::NavPlayItem(uint32_t item)
+{
+  std::unique_lock lock(m_navTimelineLock);
+  if (m_navKept)
+  {
+    // the bytes of this read are the first of the play item kept (counted after the event)
+    m_clipSpans.Begin(m_readPos, m_navKept);
+    m_navOverlayOffset =
+        static_cast<int64_t>(m_navKept->startTime) - static_cast<int64_t>(m_navKept->inTime);
+    m_navKept.reset();
+    return;
+  }
+  // any other play item that the reading goes on into (the first of a demuxer, one after a still,
+  // one a seek landed in): its packets keep the clock of its clip, as before, and the timeline of
+  // the joins after it is on that clock
+  m_clipSpans.Begin(m_readPos, std::nullopt);
+  m_navOverlayOffset = 0;
+  if (m_titleInfo && item < m_titleInfo->clip_count)
+    m_navAnchor = KODI::BLURAYTIMELINE::ClipTime{m_titleInfo->clips[item].in_time,
+                                                 m_titleInfo->clips[item].start_time};
+  else
+    m_navAnchor.reset();
+}
+
+void CDVDInputStreamBluray::NavRestart()
+{
+  std::unique_lock lock(m_navTimelineLock);
+  m_clipSpans.Clear();
+  m_navKept.reset();
+  m_navOverlayOffset = 0;
+  const uint32_t item = m_playItem;
+  if (m_titleInfo && item < m_titleInfo->clip_count)
+    m_navAnchor = KODI::BLURAYTIMELINE::ClipTime{m_titleInfo->clips[item].in_time,
+                                                 m_titleInfo->clips[item].start_time};
+  else
+    m_navAnchor.reset();
+}
+
+void CDVDInputStreamBluray::ReadConnections()
+{
+  // a playlist of one play item has no join; one read before is not read again
+  if (!m_titleInfo || m_titleInfo->clip_count < 2 || m_playlist > MAX_PLAYLIST_ID)
+    return;
+  {
+    std::unique_lock lock(m_navTimelineLock);
+    if (m_connectionsPlaylist == m_playlist)
+      return;
+  }
+  std::vector<int> connections(m_titleInfo->clip_count, -1);
+
+  // libbluray keeps the connection condition of a play item to itself: Kodi's own parser reads
+  // it from the playlist, as UpdatePlaylistInformation() reads the 3D extension data (a playlist
+  // is never scrambled, so the plain VFS is enough)
+  bool read = false;
+  size_t seamless = 0;
+  if (!m_vfsRoot.empty())
+  {
+    CURL url;
+    url.SetProtocol("bluray");
+    url.SetHostName(m_vfsRoot);
+    XFILE::BlurayPlaylistInformation playlistInfo;
+    std::map<unsigned int, XFILE::ClipInformation> clips;
+    if (XFILE::CMPLSParser::ReadMPLS(url, m_playlist, playlistInfo, clips,
+                                     XFILE::StreamDetails::DEFER) &&
+        playlistInfo.playItems.size() == m_titleInfo->clip_count)
+    {
+      read = true;
+      for (size_t i = 0; i < playlistInfo.playItems.size(); ++i)
+      {
+        connections[i] = static_cast<int>(playlistInfo.playItems[i].connectionCondition);
+        if (i > 0 && (connections[i] == 5 || connections[i] == 6))
+          ++seamless;
+      }
+    }
+  }
+  {
+    // (read by the thread that demuxes, KeepStreamsAtJoin())
+    std::unique_lock lock(m_navTimelineLock);
+    m_connections = std::move(connections);
+    m_connectionsPlaylist = m_playlist;
+  }
+  if (read)
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - playlist {}: {} play items, {} of the {} joins seamless "
+              "(connection condition 5 or 6)",
+              m_playlist, m_titleInfo->clip_count, seamless, m_titleInfo->clip_count - 1);
+  else
+    CLog::Log(LOGINFO,
+              "CDVDInputStreamBluray - playlist {}: the connection conditions of its {} play items "
+              "could not be read ({}): the player opens its streams again at each join, as before",
+              m_playlist, m_titleInfo->clip_count,
+              m_vfsRoot.empty() ? "there is no path by which Kodi's own parser could read it"
+                                : "Kodi's own parser did not read it");
+}
