From edc08d2943937241abb2356ae31682082cee9fa3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Sat, 31 Oct 2026 11:43:41 +0100
Subject: [PATCH] [depends][python3] drop the iOS patches Python 3.14.10
 already has

3.14.10 ships python/cpython#156116 and #156113, so patch reversed them,
which dropped the simulator deployment-target flag and broke the iOS
Simulator depends build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../17-ios-simulator-version-min.patch        | 17 --------------
 .../target/python3/18-ios-objc-fallback.patch | 23 -------------------
 tools/depends/target/python3/Makefile         |  7 +-----
 3 files changed, 1 insertion(+), 46 deletions(-)
 delete mode 100644 tools/depends/target/python3/17-ios-simulator-version-min.patch
 delete mode 100644 tools/depends/target/python3/18-ios-objc-fallback.patch

diff --git a/tools/depends/target/python3/17-ios-simulator-version-min.patch b/tools/depends/target/python3/17-ios-simulator-version-min.patch
deleted file mode 100644
index cf831c1..0000000
--- a/tools/depends/target/python3/17-ios-simulator-version-min.patch
+++ /dev/null
@@ -1,17 +0,0 @@
---- a/configure.ac
-+++ b/configure.ac
-@@ -979,8 +979,12 @@ AS_CASE([$host],
- )
- 
- dnl Add the compiler flag for the iOS minimum supported OS version.
--AS_CASE([$ac_sys_system],
--  [iOS], [
-+AS_CASE([$host],
-+  [*-apple-ios*-simulator], [
-+    AS_VAR_APPEND([CFLAGS], [" -mios-simulator-version-min=${IPHONEOS_DEPLOYMENT_TARGET}"])
-+    AS_VAR_APPEND([LDFLAGS], [" -mios-simulator-version-min=${IPHONEOS_DEPLOYMENT_TARGET}"])
-+  ],
-+  [*-apple-ios*], [
-     AS_VAR_APPEND([CFLAGS], [" -mios-version-min=${IPHONEOS_DEPLOYMENT_TARGET}"])
-     AS_VAR_APPEND([LDFLAGS], [" -mios-version-min=${IPHONEOS_DEPLOYMENT_TARGET}"])
-   ],
diff --git a/tools/depends/target/python3/18-ios-objc-fallback.patch b/tools/depends/target/python3/18-ios-objc-fallback.patch
deleted file mode 100644
index 04f5091..0000000
--- a/tools/depends/target/python3/18-ios-objc-fallback.patch
+++ /dev/null
@@ -1,23 +0,0 @@
---- a/Lib/_ios_support.py
-+++ b/Lib/_ios_support.py
-@@ -10,12 +10,15 @@
- else:
-     # ctypes is available. Load the ObjC library, and wrap the objc_getClass,
-     # sel_registerName methods
--    lib = util.find_library("objc")
--    if lib is None:
--        # Failed to load the objc library
--        raise ImportError("ObjC runtime library couldn't be loaded")
-+    # find_library() resolves a system library through the dyld shared cache,
-+    # which needs _dyld_shared_cache_contains_path(); that is unavailable before
-+    # iOS 14, so fall back to the bare name, which dyld resolves by itself.
-+    lib = util.find_library("objc") or "libobjc.dylib"
- 
--    objc = cdll.LoadLibrary(lib)
-+    try:
-+        objc = cdll.LoadLibrary(lib)
-+    except OSError:
-+        raise ImportError("ObjC runtime library couldn't be loaded")
-     objc.objc_getClass.restype = c_void_p
-     objc.objc_getClass.argtypes = [c_char_p]
-     objc.sel_registerName.restype = c_void_p
diff --git a/tools/depends/target/python3/Makefile b/tools/depends/target/python3/Makefile
index 5483071..3f8aead 100644
--- a/tools/depends/target/python3/Makefile
+++ b/tools/depends/target/python3/Makefile
@@ -9,8 +9,6 @@ DEPS = ../../Makefile.include Makefile PYTHON3-VERSION ../../download-files.incl
                                  14-wasm-build-wasm-default.patch \
                                  15-wasm-static-hacl.patch \
                                  16-ios-static-nonframework.patch \
-                                 17-ios-simulator-version-min.patch \
-                                 18-ios-objc-fallback.patch \
                                  19-tvos-disable-fork-exec.patch
 
 ifeq ($(findstring apple-darwin, $(HOST)), apple-darwin)
@@ -139,11 +137,8 @@ ifeq ($(OS),wasm)
 	cd $(PLATFORM); patch -p1 -i ../15-wasm-static-hacl.patch
 endif
 ifeq ($(findstring iphone,$(TARGET_PLATFORM)),iphone)
-# These three patches are all merged upstream now (python/cpython#156110,
-# #156116, #156113); drop them when we bump python past 3.16.
+# Merged upstream (python/cpython#156110); drop it when we bump python past 3.16.
 	cd $(PLATFORM); patch -p1 -i ../16-ios-static-nonframework.patch
-	cd $(PLATFORM); patch -p1 -i ../17-ios-simulator-version-min.patch
-	cd $(PLATFORM); patch -p1 -i ../18-ios-objc-fallback.patch
 endif
 ifeq ($(findstring appletv,$(TARGET_PLATFORM)),appletv)
 	# TODO: drop once tvOS is built as a real Python platform
-- 
2.53.0

