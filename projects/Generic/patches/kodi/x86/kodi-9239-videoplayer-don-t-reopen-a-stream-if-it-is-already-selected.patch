From 1adde10b65e28703348c0b7d596f29d2401f35e3 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Fri, 2 Oct 2026 21:11:43 +1000
Subject: [PATCH] [VideoPlayer] Don't reopen a stream if it is already selected

Selecting an audio, video or subtitle stream closes and reopens it, then
seeks back to resync, even when the stream is the one already playing.
Add-ons such as Jellyfin select the default audio and subtitle streams
just after playback starts, so each item briefly stalls with the busy
spinner and jumps back.

Skip the reopen and seek when the selected stream is already current.
A subtitle stream that was disabled in the demuxer, as when subtitles
are hidden, is still reopened, as only a reopen enables it again.

(cherry picked from commit c168ae8b1418d74b10498566674fbbc8d087bb74)
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 9 ++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.h   | 7 +++++++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 6401608..ec20748 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3383,7 +3383,7 @@ void CVideoPlayer::HandleMessages()
             m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
           }
         }
-        else
+        else if (!st.IsCurrent(m_CurrentAudio))
         {
           CloseStream(m_CurrentAudio, false);
           OpenStream(m_CurrentAudio, st.demuxerId, st.id, st.source);
@@ -3422,7 +3422,7 @@ void CVideoPlayer::HandleMessages()
             m_messenger.Put(std::make_shared<CDVDMsgPlayerSeek>(mode));
           }
         }
-        else
+        else if (!st.IsCurrent(m_CurrentVideo))
         {
           CloseStream(m_CurrentVideo, false);
           OpenStream(m_CurrentVideo, st.demuxerId, st.id, st.source);
@@ -3452,8 +3452,9 @@ void CVideoPlayer::HandleMessages()
             CloseStream(m_CurrentSubtitle, false);
           }
         }
-        else
+        else if (!st.IsCurrent(m_CurrentSubtitle) || m_CurrentSubtitle.demuxDisabled)
         {
+          // a stream disabled in the demuxer is only enabled again by a reopen
           CloseStream(m_CurrentSubtitle, false);
           OpenStream(m_CurrentSubtitle, st.demuxerId, st.id, st.source);
 
@@ -4145,6 +4146,7 @@ void CVideoPlayer::SetEnableStream(CCurrentStream& current, bool isEnabled)
       m_SelectionStreams.Contains(current.type, current.source, current.demuxerId, current.id))
   {
     m_pDemuxer->EnableStream(current.demuxerId, current.id, isEnabled);
+    current.demuxDisabled = !isEnabled;
   }
 }
 
@@ -4441,6 +4443,7 @@ bool CVideoPlayer::OpenStream(CCurrentStream& current, int64_t demuxerId, int iS
     current.id = iStream;
     current.demuxerId = demuxerId;
     current.source = source;
+    current.demuxDisabled = false;
     current.hint = hint;
     current.stream = (void*)stream;
     current.lastdts = DVD_NOPTS_VALUE;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index f7c1b75..c93fe59 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -131,6 +131,7 @@ public:
   void* stream; // pointer or integer, identifying stream playing. if it changes stream changed
   int changes; // remembered counter from stream to track codec changes
   bool inited;
+  bool demuxDisabled; // disabled in the demuxer since it was opened
   unsigned int packets;
   IDVDStreamPlayer::ESyncState syncState;
   double starttime;
@@ -169,6 +170,7 @@ public:
     stream = NULL;
     changes = 0;
     inited = false;
+    demuxDisabled = false;
     packets = 0;
     syncState = IDVDStreamPlayer::SYNC_STARTING;
     starttime = DVD_NOPTS_VALUE;
@@ -220,6 +222,11 @@ struct SelectionStream
   AVDOVIDecoderConfigurationRecord dovi{};
   uint32_t fpsScale{0};
   uint32_t fpsRate{0};
+
+  bool IsCurrent(const CCurrentStream& current) const
+  {
+    return demuxerId == current.demuxerId && id == current.id && source == current.source;
+  }
 };
 
 class CSelectionStreams
