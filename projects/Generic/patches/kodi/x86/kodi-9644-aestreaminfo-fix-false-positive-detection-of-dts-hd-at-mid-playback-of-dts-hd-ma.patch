From 58889939393beefe8cb2c238678e908fef0eac97 Mon Sep 17 00:00:00 2001
From: thexai <58434170+thexai@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:25:43 +0100
Subject: [PATCH] AEStreaminfo: Fix false positive detection of DTS-HD at mid
 playback of DTS-HD MA

---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp | 18 +++++++++++++++++-
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.h   |  1 +
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
index d30cf8e..9e7f72f 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
@@ -646,11 +646,27 @@ unsigned int CAEStreamParser::SyncDTS(uint8_t* data, unsigned int size)
       if (m_coreOnly)
         dataType = CAEStreamInfo::STREAM_TYPE_DTSHD_CORE;
       else if (hd_sync == DTS_PREAMBLE_XLL)
+      {
         dataType = CAEStreamInfo::STREAM_TYPE_DTSHD_MA;
+        m_skipCount = 0;
+      }
       else if (hd_sync == DTS_PREAMBLE_XCH || hd_sync == DTS_PREAMBLE_XXCH ||
                hd_sync == DTS_PREAMBLE_X96K || hd_sync == DTS_PREAMBLE_XBR ||
                hd_sync == DTS_PREAMBLE_LBR)
-        dataType = CAEStreamInfo::STREAM_TYPE_DTSHD;
+      {
+        // DTS-HD is only confirmed if no other preceding format detected or format is
+        // already DTS-HD or it's the third DTS-HD syncword, with no DTS-HD MA in between.
+        if (m_info.m_type == CAEStreamInfo::STREAM_TYPE_NULL ||
+            m_info.m_type == CAEStreamInfo::STREAM_TYPE_DTSHD || m_skipCount > 1)
+        {
+          dataType = CAEStreamInfo::STREAM_TYPE_DTSHD;
+        }
+        else
+        {
+          m_skipCount++;
+          dataType = m_info.m_type;
+        }
+      }
       else
         dataType = m_info.m_type;
 
diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
index acfa77d..4840ac7 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.h
@@ -84,6 +84,7 @@ private:
   ParseFunc m_syncFunc;
   bool m_hasSync = false;
 
+  unsigned int m_skipCount = 0;
   unsigned int m_coreSize = 0;         /* core size for dtsHD */
   unsigned int m_dtsBlocks = 0;
   unsigned int m_fsize = 0;
-- 
2.53.0

