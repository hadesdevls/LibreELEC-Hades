diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 035e549..73eee25 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -337,8 +337,9 @@ inline std::string AudioBadge(const std::string& codec, const std::string& bed,
 // ---- the speakers
 
 /*!
- * \brief The speakers that a layout lights, as ",FL,FR,FC,LFE,SL,SR,TFL,TFR," (a comma at each
- *        end, so that a skin tests one name as ",FL," and not as the end of another)
+ * \brief The speakers that a layout lights, as ";FL;FR;FC;LFE;SL;SR;TFL;TFR;" (a semicolon at each
+ *        end, so that a skin tests one name as ";FL;" and not as the end of another: a comma would
+ *        be taken for the separator of the parameters of the condition that tests it)
  * \param channels the channel names of Kodi's audio engine, as Player.Process(audiochannels) has
  *        them ("FL,FR,FC,LFE,BL,BR"), in any separator
  * \param bed the bed of an object-based stream ("7.1.2"); where it is given it says what is lit
@@ -411,9 +412,9 @@ inline std::string Speakers(const std::string& channels, const std::string& bed)
   }
   if (lit.empty())
     return "";
-  std::string out = ",";
+  std::string out = ";";
   for (const auto& name : lit)
-    out += name + ",";
+    out += name + ";";
   return out;
 }
 
