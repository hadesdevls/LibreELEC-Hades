diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h
new file mode 100644
index 0000000..fccb98e
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstddef>
+#include <list>
+#include <string>
+#include <utility>
+
+namespace DVBRIDGE
+{
+/*!
+ * \brief Hades: the output chosen for a file in the video settings of the player ("Dolby Vision
+ *        output (this video)", DVBRIDGE::OutputChoice), kept from one playback of it to the next
+ *
+ * A file is named by a key, the SHA-256 of its path in hexadecimal (64 characters): the paths
+ * themselves, which name films, are not written anywhere. Its text is one line per file,
+ * "<key> <choice>", the most recent first; a choice is one of DVBRIDGE::OutputChoice other than
+ * AUTOMATIC (1 to MAX_CHOICE). What is not such a line, and a key that comes again, is left out.
+ * Past LIMIT files the oldest are forgotten. (Kept apart from Kodi's video database, whose table of
+ * the settings of each file has fixed columns.)
+ */
+class CDVOutputMemory
+{
+public:
+  static constexpr std::size_t LIMIT = 1000;
+  static constexpr int MAX_CHOICE = 4;
+
+  //! A key as this memory takes it
+  static bool ValidKey(const std::string& key)
+  {
+    if (key.size() != 64)
+      return false;
+    for (const char c : key)
+    {
+      if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+        return false;
+    }
+    return true;
+  }
+
+  static bool ValidChoice(int choice) { return choice >= 1 && choice <= MAX_CHOICE; }
+
+  //! What a text says (what was kept before is replaced)
+  void Parse(const std::string& text)
+  {
+    m_entries.clear();
+    std::size_t start = 0;
+    while (start < text.size() && m_entries.size() < LIMIT)
+    {
+      std::size_t end = text.find('\n', start);
+      if (end == std::string::npos)
+        end = text.size();
+      const std::string line = text.substr(start, end - start);
+      start = end + 1;
+      // "<64 hexadecimal digits> <one digit>", nothing more
+      if (line.size() != 66 || line[64] != ' ')
+        continue;
+      const std::string key = line.substr(0, 64);
+      const int choice = line[65] - '0';
+      if (!ValidKey(key) || !ValidChoice(choice) || Find(key) >= 0)
+        continue;
+      m_entries.emplace_back(key, choice);
+    }
+  }
+
+  //! The text that says what is kept
+  std::string Text() const
+  {
+    std::string text;
+    for (const auto& [key, choice] : m_entries)
+    {
+      text += key;
+      text += ' ';
+      text += static_cast<char>('0' + choice);
+      text += '\n';
+    }
+    return text;
+  }
+
+  //! The choice kept for a file, -1 where none is
+  int Find(const std::string& key) const
+  {
+    for (const auto& [kept, choice] : m_entries)
+    {
+      if (kept == key)
+        return choice;
+    }
+    return -1;
+  }
+
+  /*!
+   * \brief Keeps a choice for a file, as the most recent; 0 (AUTOMATIC) forgets the file
+   * \return whether what is kept changed (the text is to be written again)
+   */
+  bool Keep(const std::string& key, int choice)
+  {
+    if (!ValidKey(key) || (choice != 0 && !ValidChoice(choice)))
+      return false;
+    if (choice != 0 && !m_entries.empty() && m_entries.front().first == key &&
+        m_entries.front().second == choice)
+      return false;
+    bool changed = false;
+    for (auto it = m_entries.begin(); it != m_entries.end(); ++it)
+    {
+      if (it->first == key)
+      {
+        m_entries.erase(it);
+        changed = true;
+        break;
+      }
+    }
+    if (choice == 0)
+      return changed;
+    m_entries.emplace_front(key, choice);
+    while (m_entries.size() > LIMIT)
+      m_entries.pop_back();
+    return true;
+  }
+
+  std::size_t Size() const { return m_entries.size(); }
+
+private:
+  std::list<std::pair<std::string, int>> m_entries;
+};
+} // namespace DVBRIDGE
