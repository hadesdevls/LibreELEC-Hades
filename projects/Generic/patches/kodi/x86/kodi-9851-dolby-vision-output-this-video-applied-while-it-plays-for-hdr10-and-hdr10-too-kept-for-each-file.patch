+//! Hades: what the video that plays is, for the choice of its output (ChoiceSourceOf())
+enum class ChoiceSource
+{
+  NONE, //!< SDR, HLG, or not known: there is nothing to choose
+  DOLBY_VISION, //!< the stream's own Dolby Vision
+  HDR10, //!< HDR10 without HDR10+ (also once it is measured as Dolby Vision)
+  HDR10PLUS, //!< HDR10+ (also once its HDR10+ metadata are sent as Dolby Vision)
+};
+
+/*!
+ * \brief Hades: what the video that plays is, for the choice of its output
+ * \param profile the Dolby Vision profile of its video stream (0: none)
+ * \param origin what its Dolby Vision is made from where it is not its own: 1 its HDR10+ metadata,
+ *        2 the picture, measured (CDVDStreamInfo::doviFromHdr10Plus, doviMeasured)
+ * \param pq the stream is coded with the PQ transfer, or its HDR type is HDR10 or HDR10+, as the
+ *        demuxer says it when the stream opens
+ * \param hdr10Plus HDR10+ metadata were found in its packets (CDVDDemuxFFmpeg::ProbeHdr10Plus())
+ */
+constexpr ChoiceSource ChoiceSourceOf(int profile, int origin, bool pq, bool hdr10Plus)
+{
+  return origin == 1               ? ChoiceSource::HDR10PLUS
+         : origin == 2             ? (hdr10Plus ? ChoiceSource::HDR10PLUS : ChoiceSource::HDR10)
+         : profile > 0             ? ChoiceSource::DOLBY_VISION
+         : hdr10Plus               ? ChoiceSource::HDR10PLUS
+         : pq                      ? ChoiceSource::HDR10
+                                   : ChoiceSource::NONE;
+}
+
+/*!
+ * \brief Hades: whether an HDR10 stream is measured as native Dolby Vision
+ *        (DVBRIDGE::Hdr10AsDolbyVision()), by the setting and the choice for the video
+ * \param setting videoscreen.hadesdvfromhdr10
+ * \param native the display takes native Dolby Vision in a mode that carries it
+ */
+constexpr bool Hdr10AsDolbyVisionFor(bool setting, OutputChoice choice, bool native)
+{
+  return native && (choice == OutputChoice::MEASURED || (choice == OutputChoice::AUTOMATIC && setting));
+}
+
 /*!
  * \brief The setting of the conversion (videoscreen.hadesdvashdr10, videoscreen.hadesdvashdr10fel)
  *        and of the mapping to the display (videoscreen.hadesdvhdr10map), as one
@@ -339,6 +390,47 @@ constexpr bool OutputChoiceOffered(OutputChoice choice, int profile, int compati
   return choice != OutputChoice::KODI || !BaseLayerIsNoPicture(profile, compatibility);
 }
 
+/*!
+ * \brief Hades: whether a choice of output is offered for a video of this kind
+ *
+ * Dolby Vision: as OutputChoiceOffered() says, and never DOLBY_VISION (it is Dolby Vision already).
+ * HDR10: AUTOMATIC, MEASURED and KODI. HDR10+: AUTOMATIC, DOLBY_VISION and KODI (MEASURED would
+ * leave its HDR10+ metadata aside, which the demuxer never does: its own metadata always win,
+ * CDVHdr10Plus). Anything else: AUTOMATIC only. Whether the display takes what is chosen is for
+ * the window system to say (DVBRIDGE::OutputChoiceAvailable()).
+ */
+constexpr bool ChoiceOffered(OutputChoice choice, ChoiceSource source, int profile, int compatibility)
+{
+  if (choice == OutputChoice::AUTOMATIC)
+    return true;
+  switch (source)
+  {
+    case ChoiceSource::DOLBY_VISION:
+      return choice != OutputChoice::DOLBY_VISION &&
+             OutputChoiceOffered(choice, profile, compatibility);
+    case ChoiceSource::HDR10:
+      return choice == OutputChoice::MEASURED || choice == OutputChoice::KODI;
+    case ChoiceSource::HDR10PLUS:
+      return choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::KODI;
+    default:
+      return false;
+  }
+}
+
+//! Hades: a choice kept for a file (the output memory, DVOutputMemory.h) is used again for it when
+//! it opens; whether it is still offered is known when its video stream opens. For its own Dolby
+//! Vision that is known then (ChoiceOffered()); an HDR10 stream is known to be HDR10+ only from its
+//! packets, so a choice kept for an HDR10 or HDR10+ stream stays until the demuxer looks at them
+//! (one that does not apply does nothing there: Hdr10AsDolbyVisionFor(), Hdr10PlusAsDolbyVision()).
+//! Anything else (SDR, HLG, a Dolby Vision file where an HDR10 one was) gives it up.
+constexpr bool KeptChoiceHolds(OutputChoice choice, ChoiceSource source, int profile, int compatibility)
+{
+  if (source == ChoiceSource::HDR10 || source == ChoiceSource::HDR10PLUS)
+    return choice == OutputChoice::AUTOMATIC || choice == OutputChoice::MEASURED ||
+           choice == OutputChoice::DOLBY_VISION || choice == OutputChoice::KODI;
+  return ChoiceOffered(choice, source, profile, compatibility);
+}
+
 /*!
  * \brief Hades: whether a stream that opens is measured as Dolby Vision in place of its own
  *        metadata (OutputChoice::MEASURED): its decoder leaves its RPU and its enhancement layer
@@ -614,7 +706,10 @@ constexpr ConversionTarget ConversionTargetOf(bool hdr10Output,
                                               bool stereo,
