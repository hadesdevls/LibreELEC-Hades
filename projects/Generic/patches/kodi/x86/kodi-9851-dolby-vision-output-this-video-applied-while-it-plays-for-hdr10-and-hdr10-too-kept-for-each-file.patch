+void CDVDDemuxFFmpeg::UnmakeFromHdr10Plus(CDemuxStream* stream, int streamIdx, const char* why)
+{
+  m_dvFromHdr10Plus.erase(streamIdx);
+  m_dvPromoted.erase(streamIdx);
+  const auto before = m_dvHdrBefore.find(streamIdx);
+  const StreamHdrType type =
+      before != m_dvHdrBefore.end() ? before->second : StreamHdrType::HDR_TYPE_HDR10;
+  m_dvHdrBefore.erase(streamIdx);
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (!video)
+    return;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is not made Dolby Vision from its HDR10+ metadata any "
+            "more: {}; it plays as it is",
+            streamIdx, why);
+  video->doviFromHdr10Plus = false;
+  video->dovi = {};
+  video->hdr_type = type;
+  video->changes++;
+}
+
+// Hades: the user chose another output for the video that plays (the video settings of the player,
+// DVBRIDGE::OutputChoice). Only the streams that this demuxer makes Dolby Vision are concerned: one
+// made so is given back where the choice now says no; one that it looked at and left as it was is
+// looked at again where it may now say yes (the packets after the seek that VideoPlayer makes).
+// A stream's own Dolby Vision is never touched.
+void CDVDDemuxFFmpeg::DVOutputChoiceChanged()
+{
+  if (!m_pFormatContext)
+    return;
+  const bool measured = DVBRIDGE::Hdr10AsDolbyVision();
+  const bool fromHdr10Plus = DVBRIDGE::Hdr10PlusAsDolbyVision();
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const int streamIdx = static_cast<int>(i);
+    CDemuxStream* stream = GetStream(streamIdx);
+    if (!stream || stream->type != StreamType::VIDEO)
+      continue;
+    auto* video = static_cast<CDemuxStreamVideo*>(stream);
+    if (m_dvMeasured.count(streamIdx))
+    {
+      if (!measured)
+      {
+        UnmakeMeasured(stream, streamIdx, "the user chose another output for this video");
+        // (looked at no more: the choice says no, and its own HDR10+ or Dolby Vision would have
+        // given it back already)
+        m_dvProbed[streamIdx] = std::numeric_limits<unsigned int>::max();
+      }
+      continue;
+    }
+    if (m_dvFromHdr10Plus.count(streamIdx))
+    {
+      if (!fromHdr10Plus)
+      {
+        UnmakeFromHdr10Plus(stream, streamIdx, "the user chose another output for this video");
+        m_dvProbed[streamIdx] = std::numeric_limits<unsigned int>::max();
+      }
+      continue;
+    }
+    // its own Dolby Vision (from the container or its RPUs), or not HEVC: not this demuxer's to make
+    if (video->hdr_type == StreamHdrType::HDR_TYPE_DOLBYVISION || video->dovi.dv_profile ||
+        stream->codec != AV_CODEC_ID_HEVC || streamIdx == m_dvBaseIndex ||
+        streamIdx == m_dvEnhancementIndex)
+      continue;
+    if (measured || fromHdr10Plus)
+    {
+      m_dvProbed[streamIdx] = 0;
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg: stream {} is looked at again for the output chosen for this video",
+                streamIdx);
+    }
+  }
+}
