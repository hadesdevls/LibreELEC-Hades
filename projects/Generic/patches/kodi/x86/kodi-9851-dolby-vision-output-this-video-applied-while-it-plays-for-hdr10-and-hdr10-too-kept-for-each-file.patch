+void ReadDVMemory()
+{
+  if (g_dvMemoryRead)
+    return;
+  g_dvMemoryRead = true;
+  XFILE::CFile file;
+  std::vector<uint8_t> data;
+  // (a file of LIMIT lines is 67 kB; anything much larger is not this file)
+  if (!XFILE::CFile::Exists(DV_OUTPUT_MEMORY, false) || file.LoadFile(DV_OUTPUT_MEMORY, data) < 0 ||
+      data.size() > 1024 * 1024)
+    return;
+  g_dvMemory.Parse(std::string(data.begin(), data.end()));
+}
+
+void WriteDVMemory()
+{
+  const std::string text = g_dvMemory.Text();
+  const std::string temporary = std::string(DV_OUTPUT_MEMORY) + ".new";
+  XFILE::CFile file;
+  if (!file.OpenForWrite(temporary, true) ||
+      file.Write(text.data(), text.size()) != static_cast<ssize_t>(text.size()))
+  {
+    CLog::Log(LOGWARNING, "DVBridge: the outputs chosen for files could not be written ({})",
+              DV_OUTPUT_MEMORY);
+    return;
+  }
+  file.Close();
+  if (!XFILE::CFile::Rename(temporary, DV_OUTPUT_MEMORY))
+    CLog::Log(LOGWARNING, "DVBridge: the outputs chosen for files could not be written ({})",
+              DV_OUTPUT_MEMORY);
