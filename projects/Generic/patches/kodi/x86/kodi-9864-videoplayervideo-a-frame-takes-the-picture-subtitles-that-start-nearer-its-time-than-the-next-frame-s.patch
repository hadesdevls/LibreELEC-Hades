+
+#pragma once
+
+namespace KODI::VIDEOPLAYER
+{
+/*!
+ * \brief (Hades) The time at which a frame takes the overlays it shows (CVideoPlayerVideo::
+ * ProcessOverlays())
+ *
+ * A picture subtitle (PGS, DVB, DVD) is made for a frame, but its start reaches the player as its
+ * container keeps it: Matroska rounds every time to the millisecond, the frame's and the
+ * subtitle's each its own way, so a set made for a frame can start a millisecond or two after the
+ * frame's time (in a remux of a UHD Blu-ray, up to one set in ten of a track). Taken against the
+ * frame's own time, such a set showed a frame late, and its end a frame late; one that the next
+ * set follows on the next frame never showed. A frame takes instead the overlays whose start is
+ * nearer its time than the next frame's: the middle of the frame. Half a frame cannot take a set
+ * that starts on the next frame, so a set made for a frame keeps it, and a start between two
+ * frames goes to the nearer one rather than always to the later one. A frame with no duration
+ * keeps its own time.
+ */
+constexpr double OverlayMatchTime(double framePts, double frameDuration)
+{
+  return frameDuration > 0.0 ? framePts + frameDuration / 2.0 : framePts;
+}
+
+//! (Hades) Whether an overlay that starts at start and stops at stop (0: when the next one starts)
+//! is on screen in the frame that takes its overlays at matchTime (OverlayMatchTime())
+constexpr bool OverlayShownAt(double start, double stop, double matchTime)
+{
+  return start <= matchTime && (stop > matchTime || stop == 0.0);
+}
+} // namespace KODI::VIDEOPLAYER
