+  // the frame's own time
+  const double matchPts{KODI::VIDEOPLAYER::OverlayMatchTime(pts, pSource->iDuration)};
+
   // remove any overlays that are out of time
   if (m_syncState == IDVDStreamPlayer::SYNC_INSYNC)
-    m_pOverlayContainer->CleanUp(pts - m_iSubtitleDelay);
+    m_pOverlayContainer->CleanUp(matchPts - m_iSubtitleDelay);
 
   VecOverlays overlays;
 
@@ -954,9 +960,10 @@ void CVideoPlayerVideo::ProcessOverlays(const VideoPicture* pSource, double pts)
       if(!pOverlay->bForced && !m_bRenderSubs)
         continue;
 
-      double pts2 = pOverlay->bForced ? pts : pts - m_iSubtitleDelay;
+      const double matchTime = pOverlay->bForced ? matchPts : matchPts - m_iSubtitleDelay;
 
-      if((pOverlay->iPTSStartTime <= pts2 && (pOverlay->iPTSStopTime > pts2 || pOverlay->iPTSStopTime == 0LL)))
+      if (KODI::VIDEOPLAYER::OverlayShownAt(pOverlay->iPTSStartTime, pOverlay->iPTSStopTime,
+                                            matchTime))
       {
         if(pOverlay->IsOverlayType(DVDOVERLAY_TYPE_GROUP))
           overlays.insert(overlays.end(),
