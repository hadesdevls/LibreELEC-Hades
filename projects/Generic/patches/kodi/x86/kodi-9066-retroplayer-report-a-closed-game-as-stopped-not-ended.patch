From 491844e89059a5bafbec4b654212d4bf88f1653c Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 1 Oct 2026 15:06:34 +0100
Subject: [PATCH] RetroPlayer: Report a closed game as stopped, not ended

Kodi closes the current game before it opens another item, and opens
that item once the player reports that playback stopped. RetroPlayer
reported every close as the end of playback instead, so Kodi looked
for the next playlist item, found none and closed the player, which
drops the waiting item. Starting a game or a video while a game was
playing ended the game and played nothing.

A game is only closed at Kodi's request, including when the core asks
to quit, so the close is reported as a stop, as VideoPlayer does.

The next game then opens on the same player, so closing leaves it as
it was constructed rather than without a playback, which the next
open dereferences.
---
 xbmc/cores/RetroPlayer/RetroPlayer.cpp | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/RetroPlayer.cpp b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
index 6281606..c93a068 100644
--- a/xbmc/cores/RetroPlayer/RetroPlayer.cpp
+++ b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
@@ -270,9 +270,7 @@ bool CRetroPlayer::CloseFile(bool reopen /* = false */)
       CLog::Log(LOGDEBUG, "RetroPlayer[SAVE]: Failed to save state at close");
   }
 
-  if (m_playback)
-    m_playback->Deinitialize();
-  m_playback.reset();
+  ResetPlayback();
 
   if (m_input)
     m_input->StopAgentManager();
@@ -303,8 +301,8 @@ bool CRetroPlayer::CloseFile(bool reopen /* = false */)
     m_processInfo->ResetInfo();
   }
   m_processInfo.reset();
-  CLog::Log(LOGDEBUG, "RetroPlayer[PLAYER]: Playback ended");
-  m_callback.OnPlayBackEnded();
+  CLog::Log(LOGDEBUG, "RetroPlayer[PLAYER]: Playback stopped");
+  m_callback.OnPlayBackStopped();
 
   return true;
 }
