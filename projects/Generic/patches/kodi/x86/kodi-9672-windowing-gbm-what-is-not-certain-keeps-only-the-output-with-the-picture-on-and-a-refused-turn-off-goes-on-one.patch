+/*!
+ * \brief Hades: how the turning off of the outputs that Kodi does not use is asked again when the
+ *        driver refuses it
+ *
+ * The commit that turns them off all at once may be refused for one of them (a monitor whose link
+ * the driver cannot drop with the rest), and giving up after a few tries left every monitor of the
+ * card on, black. After the first refusal the same commit is asked again once; after the second,
+ * the outputs go off one CRTC at a time: a CRTC that the driver refuses even alone is left on
+ * and said, and the others go off, however many there are.
+ */
+class COutputsOffRetry
+{
+public:
+  enum class Verdict
+  {
+    TAKE, //!< this CRTC goes off with this commit
+    LEAVE_FOR_NEXT, //!< one at a time: another one goes off with this commit, this one next
+    SKIP, //!< one at a time: the driver refused it alone, it stays on
+  };
+  //! \param taken how many CRTCs this commit turns off already
+  Verdict Consider(uint32_t crtc, unsigned int taken) const
+  {
+    if (!m_oneByOne)
+      return Verdict::TAKE;
+    if (m_skipped.contains(crtc))
+      return Verdict::SKIP;
+    return taken == 0 ? Verdict::TAKE : Verdict::LEAVE_FOR_NEXT;
+  }
+  //! What the commit that was built asks: the CRTC it turns off alone (0: all of them), and whether
+  //! more are left for later
+  void Built(uint32_t attempt, bool more)
+  {
+    m_attempt = m_oneByOne ? attempt : 0;
+    m_more = more;
+  }
+  //! Whether, once this commit is taken, another is to follow
+  bool MoreToFollow() const { return m_oneByOne && m_more; }
+
+  enum class Next
+  {
+    SAME_LATER, //!< the same commit again, later
+    ONE_BY_ONE, //!< from now on one CRTC at a time, soon
+    NEXT_SOON, //!< the CRTC that was asked alone stays on; the next one, soon
+    LEFT_ON, //!< what is left on stays on: nothing more to ask
+  };
+  Next Refused()
+  {
+    if (m_oneByOne)
+    {
+      if (m_attempt)
+        m_skipped.insert(m_attempt);
+      return m_more ? Next::NEXT_SOON : Next::LEFT_ON;
+    }
+    if (++m_tries < 2)
+      return Next::SAME_LATER;
+    m_oneByOne = true;
+    m_tries = 0;
+    return Next::ONE_BY_ONE;
+  }
+  //! The CRTC that was refused alone, for the log; 0 when it was not alone
+  uint32_t Attempt() const { return m_attempt; }
+  //! A new mode asks everything again (what was learned of the driver stays: one at a time)
+  void NewMode()
+  {
+    m_tries = 0;
+    m_skipped.clear();
+  }
+  const std::set<uint32_t>& Skipped() const { return m_skipped; }
+  bool OneByOne() const { return m_oneByOne; }
+
+private:
+  bool m_oneByOne{false};
+  int m_tries{0};
+  uint32_t m_attempt{0};
+  bool m_more{false};
+  std::set<uint32_t> m_skipped;
+};
