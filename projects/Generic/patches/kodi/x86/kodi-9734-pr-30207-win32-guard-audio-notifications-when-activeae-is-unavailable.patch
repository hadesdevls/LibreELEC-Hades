From 377b55e22ae9511a0ae8bd4aa601719d1981851b Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Thu, 29 Oct 2026 13:29:12 -0700
Subject: [PATCH] [PR 30207] [win32] Guard audio notifications when ActiveAE is
 unavailable

Windows can deliver device notifications after ActiveAE is unregistered.
---
 xbmc/platform/win32/IMMNotificationClient.h | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/xbmc/platform/win32/IMMNotificationClient.h b/xbmc/platform/win32/IMMNotificationClient.h
index 9a86d6d..93aae7c 100644
--- a/xbmc/platform/win32/IMMNotificationClient.h
+++ b/xbmc/platform/win32/IMMNotificationClient.h
@@ -162,12 +162,18 @@ public:
   void STDMETHODCALLTYPE NotifyAEDefaultDeviceChange()
   {
     if (!CWin32PowerSyscall::IsSuspending())
-      CServiceBroker::GetActiveAE()->DefaultDeviceChange();
+    {
+      if (auto* audioEngine = CServiceBroker::GetActiveAE())
+        audioEngine->DefaultDeviceChange();
+    }
   }
 
   void STDMETHODCALLTYPE NotifyAEDeviceCountChange()
   {
     if (!CWin32PowerSyscall::IsSuspending())
-      CServiceBroker::GetActiveAE()->DeviceCountChange("");
+    {
+      if (auto* audioEngine = CServiceBroker::GetActiveAE())
+        audioEngine->DeviceCountChange("");
+    }
   }
 };
