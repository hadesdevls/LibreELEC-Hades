From e6d04799a35496668db2760fb32739c189a6ae95 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:19:06 +0000
Subject: [PATCH] VideoPlayer: log when the base decoder of a Dolby Vision FEL
 stream is on another VAAPI device context

Kodi makes a VAAPI device context for each decoder it opens, and a new decoder each time the base
layer asks for its format again; the enhancement module is given that device with each picture. That
it changed, and whether it is of the same display, was nowhere in the log. Now it is: the first five
times and then every hundredth time for a stream.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 34 +++++++++++++++++++
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  8 +++++
 2 files changed, 42 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 1f170bd..43cb690 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -40,6 +40,7 @@ extern "C"
 {
 #include "dvbridge_fel.h"
 #include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_vaapi.h>
 }
 #endif
 
@@ -1351,6 +1352,7 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPairedPicture(VideoPicture* pV
     if (m_pCodecContext->hw_frames_ctx && !m_dvSoftware)
     {
       auto* frames = reinterpret_cast<AVHWFramesContext*>(m_pCodecContext->hw_frames_ctx->data);
+      NoteDVDevice(frames->device_ref);
       if (!dvbridge_fel_device(m_dvFel.get(), frames->device_ref, result == VC_PICTURE))
         ResyncDVEnhancement(dvbridge_fel_reason(m_dvFel.get()));
     }
@@ -1366,6 +1368,38 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPairedPicture(VideoPicture* pV
   }
   return GetBasePicture(pVideoPicture);
 }
+
+void CDVDVideoCodecFFmpeg::NoteDVDevice(const AVBufferRef* device)
+{
+  // Hades: Kodi makes a VAAPI device context for each decoder it opens, and opens one each time
+  // the base decoder asks for its format again (a new sequence of other parameters). The
+  // enhancement module is given the device context of the base decoder with each picture: the
+  // log says when that is another one than the module was given before, and whether it is of the
+  // same display (what the module does with it, its own lines say).
+  if (!device || !device->data)
+    return;
+  const auto* context = reinterpret_cast<const AVHWDeviceContext*>(device->data);
+  const void* display = nullptr;
+  if (context->type == AV_HWDEVICE_TYPE_VAAPI && context->hwctx)
+    display = static_cast<const AVVAAPIDeviceContext*>(context->hwctx)->display;
+  if (m_dvDeviceOf != m_dvFel.get())
+  {
+    // the first one of this enhancement module (a stream opened)
+    m_dvDeviceOf = m_dvFel.get();
+    m_dvDevices = 0;
+  }
+  else if (device->data != m_dvDevice)
+  {
+    ++m_dvDevices;
+    if (m_dvDevices <= 5 || m_dvDevices % 100 == 0)
+      CLog::Log(LOGINFO,
+                "DV FEL: the base decoder is on another VAAPI device context, of {} display ({} "
+                "of this stream)",
+                display && display == m_dvDisplay ? "the same" : "another", m_dvDevices);
+  }
+  m_dvDevice = device->data;
+  m_dvDisplay = display;
+}
 #endif
 
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetBasePicture(VideoPicture* pVideoPicture)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
index 358f1b3..32995a8 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.h
@@ -95,6 +95,14 @@ protected:
   unsigned int m_dvNotDecoded{0};
   bool m_dvNotDecodedLogged{false};
   unsigned int m_dvDecodedAgain{0}; //!< times the layer was decoded again after that
+  //! Hades: the VAAPI device context that the enhancement module of this stream was given last,
+  //! and its display (compared, never used), for the log: how often the base decoder is on
+  //! another one (NoteDVDevice())
+  const dvbridge_fel* m_dvDeviceOf{nullptr};
+  const void* m_dvDevice{nullptr};
+  const void* m_dvDisplay{nullptr};
+  unsigned int m_dvDevices{0};
+  void NoteDVDevice(const AVBufferRef* device);
   void UseLayerDVMetadata(VideoPicture& base, const AVFrame* enhancement, bool decoded = true);
   void ResyncDVEnhancement(const char* reason);
   CDVDVideoCodec::VCReturn GetPairedPicture(VideoPicture* picture);
-- 
