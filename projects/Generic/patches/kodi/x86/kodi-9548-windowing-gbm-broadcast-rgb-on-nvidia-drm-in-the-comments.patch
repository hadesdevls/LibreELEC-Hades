From cddd929624cfc1bbc93d06fcb3cd5d3f4694610c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:36:04 +0000
Subject: [PATCH] windowing/gbm: Broadcast RGB on nvidia-drm, in the comments

Hades' NVIDIA drivers add the standard "Broadcast RGB" property to
nvidia-drm (nvidia-open-kernel-modules-9056, nvidia-legacy-open-9067): with
it CRgbRange asks the driver for "Limited 16:235" there too, as on i915 and
amdgpu, and draws full range. Nothing in the code depends on the driver; the
two comments that said nvidia-drm has no such property now say what it does,
and that the transport of native Dolby Vision on nvidia-drm leaves it as it
is, because the kernel keeps a head with the Dolby VSIF in full range.
---
 xbmc/windowing/gbm/RgbRange.h            | 5 ++++-
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 6 ++++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/RgbRange.h b/xbmc/windowing/gbm/RgbRange.h
index 9d0ef8d..8d8e6f0 100644
--- a/xbmc/windowing/gbm/RgbRange.h
+++ b/xbmc/windowing/gbm/RgbRange.h
@@ -47,7 +47,10 @@ namespace GBM
  * already (native Dolby Vision, whose transport sets "Full" and puts back what it found; the
  * clean-up of a session that ended with it). A commit with it that the driver refuses is asked
  * again with the next mode set, REFUSALS times: then Kodi makes the range itself on that output,
- * as before (fail closed). nvidia-drm has no such property: Kodi makes the range there, as before.
+ * as before (fail closed). nvidia-drm has the property with Hades' drivers (nvidia-open-kernel-modules-9056,
+ * nvidia-legacy-open-9067: "Limited 16:235" makes NVKMS compress the range of the head and say so in the AVI
+ * InfoFrame; never with the Dolby VSIF, whatever the property says); a driver without it: Kodi makes the
+ * range there, as before.
  */
 class CRgbRange
 {
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index b531a50..3d11895 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -278,8 +278,10 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
       saved.back().original = 0;
     }
 
-    // No "Broadcast RGB" on nvidia-drm: RGB output is full range by default, and the AVI
-    // InfoFrame says so when the sink can select the RGB range (checked from the EDID).
+    // "Broadcast RGB" is not touched on nvidia-drm: RGB output is full range by default, and the
+    // AVI InfoFrame says so when the sink can select the RGB range (checked from the EDID). (Hades:
+    // with Hades' drivers the property exists, and with the Dolby VSIF in the state the kernel keeps
+    // the head in full range whatever it says, nvidia-open-kernel-modules-9056)
     // (Hades: with Low-Latency, NVKMS says YCbCr 4:2:2 there instead, nvidia-open-kernel-modules-9030)
     // (Hades: with the HDMI 1.4b signalling, NVKMS sends AVI VIC 0 in the modes of an HDMI_VIC,
     // nvidia-open-kernel-modules-9045; nvidia-drm takes that InfoFrame only with the property, 8
-- 
