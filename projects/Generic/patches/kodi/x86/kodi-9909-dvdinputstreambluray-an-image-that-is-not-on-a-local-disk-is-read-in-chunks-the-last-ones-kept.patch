From 97caf6e0e8f235af4ee2b223e70d3934fefe9474 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:50:43 +0000
Subject: [PATCH] DVDInputStreamBluray: an image that is not on a local disk is
 read in chunks, the last ones kept

Kodi opens a disc image directly in stream mode (bd_open_stream()) and
reads it without its cache (OpenStream()). Opening a disc reads many small
pieces of the image, here and there, so over HTTP (a .strm file that names
an image on a cloud drive) or a share most of them were a request of their
own, with its round trip, before the first picture.

libbluray-9099 reads such an image in aligned chunks of 64 KiB and keeps
the ones read last, where the player asks for it
(BLURAY_PLAYER_SETTING_IMAGE_CACHE). It is asked for here for an image
that is not on a local disk (URIUtils::IsHD(): an image over HTTP, FTP,
WebDAV, an SMB or NFS share, a udf:// or an archive over one of those),
with 4 MiB kept: the bytes read are the same, so there is no choice to
give, and it is said in the log. An image on a local disk, or on a share
that the system mounts (a local path, read through the system's own
cache), is read as before; a physical disc and a BDMV folder are not
opened in stream mode and are not touched. Without libbluray-9099
(BD_HAVE_IMAGE_CACHE) nothing is compiled in.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 3488a42..29a077f 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -61,6 +61,19 @@ namespace
 /*! libbluray skips an aligned unit (6144 bytes) it cannot read and reports each one. This many in
     a row, about 6 MB, is a disc that has gone rather than a damaged patch to play past */
 constexpr unsigned int MAX_CONSECUTIVE_READ_ERRORS{1000};
+
+#if defined(BD_HAVE_IMAGE_CACHE)
+/*! Hades: an image that libbluray reads itself (bd_open_stream(): an image that is opened directly)
+    is read in aligned chunks of 64 KiB, the last of them kept (BLURAY_PLAYER_SETTING_IMAGE_CACHE),
+    when it is not on a local disk: over HTTP or a share, the small reads of the opening, here and
+    there, would each be a request, since Kodi reads the image without its cache (OpenStream()). The
+    bytes read are the same. An image on a local disk, or on a share that the system mounts (a local
+    path, read through the system's own cache), is read as before. */
+bool ReadImageInChunks(const std::string& image)
+{
+  return !URIUtils::IsHD(image);
+}
+#endif
 } // namespace
 
 static int read_blocks(void* handle, void* buf, int lba, int num_blocks)
@@ -284,6 +297,14 @@ bool CDVDInputStreamBluray::Open()
 
   if (openStream)
   {
+#if defined(BD_HAVE_IMAGE_CACHE)
+    // Hades: (ReadImageInChunks())
+    if (ReadImageInChunks(m_pstream->GetFileName()) &&
+        bd_set_player_setting(m_bd, BLURAY_PLAYER_SETTING_IMAGE_CACHE, 4096))
+      CLog::Log(LOGINFO,
+                "CDVDInputStreamBluray::Open - the image is not on a local disk: it is read "
+                "in chunks of 64 KiB, the last 4 MiB of them kept");
+#endif
     if (!bd_open_stream(m_bd, this, read_blocks))
     {
       CLog::Log(LOGERROR, "CDVDInputStreamBluray::Open - failed to open {} in stream mode",
-- 
