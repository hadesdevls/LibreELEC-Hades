From 3bbfb7e9a57d4bfa1ea65bd5e132c0981532cec1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:52:22 +0000
Subject: [PATCH] video library: a .strm without stream details gets them from
 its first playback

A .strm (a playlist of one entry) is not read by a scan (CDVDFileInfo::
CanExtract()), and its playback filled in its details only where the file
it names is an Internet stream. A .strm that names a file of the home
network or of this system kept none, so its skin flags stayed empty.

ShouldUpdateStreamDetails() now asks the player for the details of a
.strm without any, as it does for a disc or a stream (the item that plays
keeps the .strm as its path).
---
 xbmc/application/ApplicationPlayerCallback.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/xbmc/application/ApplicationPlayerCallback.cpp b/xbmc/application/ApplicationPlayerCallback.cpp
index d4ff73f..7c6dd81 100644
--- a/xbmc/application/ApplicationPlayerCallback.cpp
+++ b/xbmc/application/ApplicationPlayerCallback.cpp
@@ -59,9 +59,11 @@ namespace
 bool ShouldUpdateStreamDetails(const CFileItem& file)
 {
   // If a title/playlist hasn't been selected for a bluray/dvds then the stream details may not be known
+  // (Hades: nor those of a .strm, whose video a scan reads only where it names one local file,
+  // CDVDFileInfo::StrmTarget(); the file played keeps the .strm as its path)
   const bool isDiscOrStream{VIDEO::IsBDFile(file) || VIDEO::IsDVDFile(file) || file.IsDiscImage() ||
                             URIUtils::IsBlurayMenuPath(file.GetDynPath()) ||
-                            NETWORK::IsInternetStream(file)};
+                            NETWORK::IsInternetStream(file) || file.IsStrm()};
 
   // Stream details may be already set from a previous playback or nfo
   const bool hasNoStreamDetails{!file.HasVideoInfoTag() ||
