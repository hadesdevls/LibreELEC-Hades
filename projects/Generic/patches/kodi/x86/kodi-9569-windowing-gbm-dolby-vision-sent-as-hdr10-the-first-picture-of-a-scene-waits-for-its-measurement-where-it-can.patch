diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index a386ece..40c8a24 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1887,9 +1887,47 @@ void CWinSystemGbmGLESContext::DVPlusEnd()
   m_dvPlusOn = -1;
   m_dvPlusMeasuredPts = DVD_NOPTS_VALUE;
   m_dvPlusFrames = 0;
+  m_dvPlusStartPts = DVD_NOPTS_VALUE;
+  m_dvPlusStartsWaited = m_dvPlusStartsLate = m_dvPlusStartsNoTime = 0;
+  m_dvPlusNoVBlankTold = false;
   m_dvPlusSending = false;
 }
 
+void CWinSystemGbmGLESContext::DVPlusCollect()
+{
+  // the samples that the GPU has finished, into the scenes of their pictures
+  dvbridge_dvplus_gl_collect(
+      m_dvPlusGl.get(),
+      [](double measured, const uint16_t* codes, size_t count, void* context)
+      {
+        auto* self = static_cast<CWinSystemGbmGLESContext*>(context);
+        dvbridge_dvplus_picture* picture = self->m_dvPlusPicture.get();
+        std::memset(picture, 0, sizeof(*picture));
+        picture->pts = measured;
+        dvbridge_dvplus_picture_add(self->m_dvPlus.get(), picture, codes, count);
+        dvbridge_dvplus_measured(self->m_dvPlus.get(), picture);
+      },
+      this);
+}
+
+int64_t CWinSystemGbmGLESContext::DVPlusLastVBlankNs() const
+{
+  // the legacy vblank ioctl, relative 0: the kernel answers at once with the count and the time of the
+  // last vblank (as WaitDVBridgeVBlank() asks it); nvidia-drm has none with its defaults
+  const CDRMCrtc* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+  if (!crtc)
+    return 0;
+  drmVBlank vblank{};
+  vblank.request.type = static_cast<drmVBlankSeqType>(
+      DRM_VBLANK_RELATIVE |
+      ((crtc->GetOffset() << DRM_VBLANK_HIGH_CRTC_SHIFT) & DRM_VBLANK_HIGH_CRTC_MASK));
+  vblank.request.sequence = 0;
+  if (drmWaitVBlank(m_DRM->GetFileDescriptor(), &vblank) != 0)
+    return 0;
+  return static_cast<int64_t>(vblank.reply.tval_sec) * 1000000000 +
+         static_cast<int64_t>(vblank.reply.tval_usec) * 1000;
+}
+
 std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR10Plus(
     double pts, const CDVMetadataBuffer& metadata)
 {
@@ -1937,31 +1975,25 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
       PublishDVInfo(true);
     return std::nullopt;
   }
-  // the samples that the GPU has finished, into the scenes of their pictures
-  dvbridge_dvplus_gl_collect(
-      m_dvPlusGl.get(),
-      [](double measured, const uint16_t* codes, size_t count, void* context)
-      {
-        auto* self = static_cast<CWinSystemGbmGLESContext*>(context);
-        dvbridge_dvplus_picture* picture = self->m_dvPlusPicture.get();
-        std::memset(picture, 0, sizeof(*picture));
-        picture->pts = measured;
-        dvbridge_dvplus_picture_add(self->m_dvPlus.get(), picture, codes, count);
-        dvbridge_dvplus_measured(self->m_dvPlus.get(), picture);
-      },
-      this);
+  DVPlusCollect();
   dvbridge_dvplus_rpu rpu{};
   dvbridge_dvplus_rpu_of(metadata.Data(), metadata.Size(), &rpu);
   dvbridge_dvplus_stats stats{};
-  const bool send = dvbridge_dvplus_present(m_dvPlus.get(), pts, &rpu, &stats, nullptr);
+  bool refresh = false;
+  const bool send = dvbridge_dvplus_present(m_dvPlus.get(), pts, &rpu, &stats, &refresh);
+  // (the first picture of a scene waits for its own measurement once it is drawn, where it can)
+  m_dvPlusStartPts = refresh ? pts : DVD_NOPTS_VALUE;
   if (++m_dvPlusFrames % 240 == 0)
   {
     dvbridge_dvplus_counts c{};
     dvbridge_dvplus_get_counts(m_dvPlus.get(), &c);
     CLog::Log(LOGINFO,
               "DVBridge: Dolby Vision sent as HDR10+: so far {} pictures with HDR10+ and {} without, "
-              "{} scenes, {} changes within a scene, {} pictures measured, {} dropped; now {}",
-              c.sent, c.unsent, c.scenes, c.changes, c.measured, c.dropped,
+              "{} scenes ({} first pictures with their own measurement, {} not measured by the "
+              "vblank, {} without a vblank to wait by), {} changes within a scene, {} pictures "
+              "measured, {} dropped; now {}",
+              c.sent, c.unsent, c.scenes, m_dvPlusStartsWaited, m_dvPlusStartsLate,
+              m_dvPlusStartsNoTime, c.changes, c.measured, c.dropped,
               send ? StringUtils::Format("maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2",
                                          stats.average / 10.0, stats.percentiles[8] / 10.0)
                    : std::string("nothing (the frames go out as HDR10)"));
@@ -2017,9 +2049,53 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
   int area[4];
   dvbridge_dvplus_area(metadata.Data(), metadata.Size(), layer.width, layer.height, source, at,
                        area);
-  if (dvbridge_dvplus_gl_submit(m_dvPlusGl.get(), texture, width, height, area[0], area[1],
-                                area[2], area[3], layer.pts))
-    m_dvPlusMeasuredPts = layer.pts;
+  if (!dvbridge_dvplus_gl_submit(m_dvPlusGl.get(), texture, width, height, area[0], area[1],
+                                 area[2], area[3], layer.pts))
+    return;
+  m_dvPlusMeasuredPts = layer.pts;
+  if (layer.pts != m_dvPlusStartPts)
+    return;
+  // The first picture of a scene: it went to the renderer with the metadata of the scene before.
+  // It waits for its own measurement, where that comes before the next vblank (with the margin of
+  // dvbridge_dvplus_wait_budget(): the commit is then made by that vblank, as without waiting), and
+  // goes out with its scene's own; where it does not come by then, as it was.
+  m_dvPlusStartPts = DVD_NOPTS_VALUE;
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  const int64_t period =
+      mode && mode->clock && mode->htotal && mode->vtotal
+          ? static_cast<int64_t>(1e9 * mode->htotal * mode->vtotal / (mode->clock * 1000.0))
+          : 0;
+  const int64_t vblank = DVPlusLastVBlankNs();
+  const int64_t budget =
+      dvbridge_dvplus_wait_budget(SteadyNowNs(), vblank, period, DVBRIDGE_DVPLUS_WAIT_MARGIN);
+  if (budget <= 0)
+  {
+    ++m_dvPlusStartsNoTime;
+    if (!vblank && !m_dvPlusNoVBlankTold)
+    {
+      m_dvPlusNoVBlankTold = true;
+      CLog::Log(LOGINFO, "DVBridge: Dolby Vision sent as HDR10+: the vblanks of the output cannot "
+                         "be read, so the first picture of a scene does not wait for its own "
+                         "measurement: it goes out with the metadata of the scene before");
+    }
+    return;
+  }
+  if (!dvbridge_dvplus_gl_wait(m_dvPlusGl.get(), layer.pts, static_cast<uint64_t>(budget)))
+  {
+    ++m_dvPlusStartsLate;
+    return;
+  }
+  DVPlusCollect();
+  dvbridge_dvplus_stats stats{};
+  if (!dvbridge_dvplus_present_again(m_dvPlus.get(), layer.pts, &stats))
+    return;
+  AVDynamicHDRPlus made{};
+  dvbridge_dvplus_metadata(&stats, &made);
+  if (const auto payload = KODI::UTILS::HDR10PLUS::MakeVsif(made))
+  {
+    ++m_dvPlusStartsWaited;
+    SetHDR10Plus(payload);
+  }
 }
 
 int CWinSystemGbmGLESContext::RenderDVConversion(const CDVBridgeGLES::Layer& layer,
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 3ed4167..5042eec 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -406,6 +406,15 @@ private:
   int m_dvPlusOn = -1;
