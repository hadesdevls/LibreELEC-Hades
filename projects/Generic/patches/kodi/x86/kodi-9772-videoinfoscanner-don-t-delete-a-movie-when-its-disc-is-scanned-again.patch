From 98339bcffb5a6a2706b06f0aeefba9392e33496b Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 14:35:48 +0000
Subject: [PATCH] [VideoInfoScanner] Don't delete a movie when its disc is
 scanned again.

A playlist already in the library was added again, which returned its
existing movie. A merge refused for that movie, as one with several
versions is when nobody is asked, then deleted it as though it had just
been added, taking all of the movie's versions with it. A disc found
again by a scan, such as after a refresh, lost its movie this way.

A playlist already in the library now keeps its movie, which the disc's
new playlists join.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.cpp          | 24 ++++++++++++----
 xbmc/video/test/TestVideoInfoScanner.cpp | 36 ++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 25c0406..114e45a 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -3076,9 +3076,25 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
     bool added{false};
     bool versioned{false};
+    bool known{false};
     int targetDbId{-1};
     for (const auto& item : blurayItems)
     {
+      // The playlists are ordered with the disc's main title first, so only that one may become
+      // the default version - otherwise each playlist added after it displaces it in turn, leaving
+      // the shortest of them as the default
+      const bool isMainPlaylist{item == blurayItems.Get(0)};
+
+      // A playlist already in the library keeps its movie, which the disc's new playlists join.
+      // Adding it again would return that movie, which a declined merge below would then delete.
+      if (const int knownDbId{m_database.GetMovieId(item->GetDynPath())}; knownDbId >= 0)
+      {
+        known = true;
+        if (isMainPlaylist)
+          targetDbId = knownDbId;
+        continue;
+      }
+
       const int newMovieDbId{static_cast<int>(
           AddVideo(item.get(), scraper, bDirNames, useLocal, nullptr, false, ContentType::MOVIES))};
       if (newMovieDbId < 0)
@@ -3095,10 +3111,6 @@ CVideoInfoScanner::~CVideoInfoScanner()
           m_similarVideoAction != SimilarVideoScanAction::AUTO)
         continue;
 
-      // The playlists are ordered with the disc's main title first, so only that one may become
-      // the default version - otherwise each playlist added after it displaces it in turn, leaving
-      // the shortest of them as the default
-      const bool isMainPlaylist{item == blurayItems.Get(0)};
       const auto [result, chosenTargetMovieDbId] = ProcessVideoVersion(
           ContentToVideoDbType(ContentType::MOVIES), newMovieDbId, targetDbId, isMainPlaylist);
       if (result == VersionConversionResult::SUCCESS)
@@ -3128,7 +3140,9 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
     if (versioned)
       RemovePartNumberFromTitle(targetDbId, VideoDbContentType::MOVIES, m_database);
-    return !added ? InfoRet::INFO_ERROR : (versioned ? InfoRet::HAVE_ALREADY : InfoRet::ADDED);
+    if (!added)
+      return known ? InfoRet::HAVE_ALREADY : InfoRet::INFO_ERROR;
+    return versioned ? InfoRet::HAVE_ALREADY : InfoRet::ADDED;
   }
 
   std::pair<VersionConversionResult, int> CVideoInfoScanner::ProcessVideoVersion(
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index 4342309..55c7773 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -26,10 +26,12 @@
 #include "settings/MediaSourceSettings.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/Artwork.h"
 #include "utils/URIUtils.h"
 #include "video/SetInfoTag.h"
 #include "video/VideoDatabase.h"
 #include "video/VideoInfoScanner.h"
+#include "video/VideoInfoTag.h"
 #include "video/VideoManagerTypes.h"
 #include "video/jobs/VideoLibraryScanningJob.h"
 
@@ -176,6 +178,13 @@ public:
       m_database.CleanDatabase(nullptr, m_pathsToClean, false);
   }
 
+  //! As a scan adds the main playlists found on a disc, with grouping of similar videos on
+  InfoRet AddPlaylists(const CFileItemList& playlists)
+  {
+    m_similarVideoAction = SimilarVideoScanAction::AUTO;
+    return AddBlurayPlaylistVersions(playlists, nullptr, true, false);
+  }
+
   using CVideoInfoScanner::EnumerateSeriesFolder;
   using EpisodeResult = CVideoInfoScanner::EpisodeResult;
 
@@ -561,6 +570,33 @@ TEST_F(TestVideoInfoScanner, ABlurayFolderRipIsOneMovie)
 }
 #endif
 
+TEST_F(TestVideoInfoScanner, PlaylistsOfADiscAlreadyInTheLibraryKeepTheirMovie)
+{
+  const std::string disc{File(Folder(m_root, "Film (2010)"), "FILM.iso")};
+  const std::string main{URIUtils::GetBlurayPlaylistPath(disc, 801)};
+  const std::string other{URIUtils::GetBlurayPlaylistPath(disc, 800)};
+
+  CVideoInfoTag tag;
+  tag.m_strTitle = "Film";
+  tag.m_strFileNameAndPath = main;
+  tag.m_strPath = URIUtils::GetDirectory(main);
+  const int idMovie{m_db.SetDetailsForMovie(tag, KODI::ART::Artwork{})};
+  ASSERT_GT(idMovie, 0);
+  CFileItem version{other, false};
+  ASSERT_TRUE(m_db.AddVideoAsset(VideoDbContentType::MOVIES, idMovie, VIDEO_VERSION_ID_DEFAULT,
+                                 VideoAssetType::VERSION, version));
+
+  CFileItemList playlists;
+  playlists.Add(std::make_shared<CFileItem>(main, false));
+  playlists.Add(std::make_shared<CFileItem>(other, false));
+  TestScanner scanner{m_settings};
+  EXPECT_EQ(CInfoScanner::InfoRet::HAVE_ALREADY, scanner.AddPlaylists(playlists));
+
+  EXPECT_EQ(1, CountMovies());
+  EXPECT_EQ(idMovie, m_db.GetMovieId(main));
+  EXPECT_EQ(idMovie, m_db.GetMovieId(other));
+}
+
 TEST_F(TestVideoInfoScanner, ADvdFolderRipIsOneMovie)
 {
   const std::string folder{Folder(m_root, "Film (2010)")};
-- 
