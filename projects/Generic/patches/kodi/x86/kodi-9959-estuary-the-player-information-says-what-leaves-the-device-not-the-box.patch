From af0fd0d71082d6047e44fdddd6d2ff01733b26cd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:23:16 +0000
Subject: [PATCH] estuary: the player information says "What leaves the
 device", not "the box"

The kicker of the column of the output (#32744) said "What leaves the box",
and its Spanish "Lo que sale de la caja". Hades runs on computers, not on a
box: "What leaves the device", "Lo que sale del dispositivo" in es_es, es_ar
and es_mx, next to "What the file carries" ("Lo que trae el archivo").
---
 .../skin.estuary/language/resource.language.en_gb/strings.po  | 2 +-
 .../skin.estuary/language/resource.language.es_ar/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_es/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_mx/strings.po  | 4 ++--
 4 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index 7c9f00f..ee9c201 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -4116,7 +4116,7 @@ msgstr ""
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, kicker of the third column
 msgctxt "#32744"
-msgid "What leaves the box"
+msgid "What leaves the device"
 msgstr ""
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
diff --git a/addons/skin.estuary/language/resource.language.es_ar/strings.po b/addons/skin.estuary/language/resource.language.es_ar/strings.po
index cd368d2..55be68a 100644
--- a/addons/skin.estuary/language/resource.language.es_ar/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_ar/strings.po
@@ -3922,8 +3922,8 @@ msgstr "Hades"
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, kicker of the third column
 msgctxt "#32744"
-msgid "What leaves the box"
-msgstr "Lo que sale de la caja"
+msgid "What leaves the device"
+msgstr "Lo que sale del dispositivo"
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, third column
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index 5368571..4a037e8 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -3930,8 +3930,8 @@ msgstr "Hades"
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, kicker of the third column
 msgctxt "#32744"
-msgid "What leaves the box"
-msgstr "Lo que sale de la caja"
+msgid "What leaves the device"
+msgstr "Lo que sale del dispositivo"
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, third column
diff --git a/addons/skin.estuary/language/resource.language.es_mx/strings.po b/addons/skin.estuary/language/resource.language.es_mx/strings.po
index eaac5b3..478ef57 100644
--- a/addons/skin.estuary/language/resource.language.es_mx/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_mx/strings.po
@@ -3930,8 +3930,8 @@ msgstr "Hades"
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, kicker of the third column
 msgctxt "#32744"
-msgid "What leaves the box"
-msgstr "Lo que sale de la caja"
+msgid "What leaves the device"
+msgstr "Lo que sale del dispositivo"
 
 #: addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
 #. Hades, third column
