From 0e2f0a01e9be475834c9b509522e7fe8305d7e79 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:35:32 +0000
Subject: [PATCH] VideoPlayer: wait for the next message when paused at the end
 of the input

Paused with the demuxer at the end of its input (the last seconds of any
file, whose queues are not full, so the branch of a pause that waits 10 ms
is not taken), the player loop asked the demuxer again at once for as long
as the pause lasted: ReadPacket() gives nothing, and the paused case went
round with no wait. Measured in a virtual machine with the image of 1.0
RC8, which has these lines as they are here: the VideoPlayer thread at 71 %
of a core while paused 1.5 s before the end of a clip.

It now waits on the event of its message queue together with its stop
(CThread::AbortableWait()), at most 10 ms, as long as a pause with full
queues waits, and goes round as before: a resume, a seek, a frame step,
another file to play (all messages) or a stop wake it at once, and what
the loop does while paused (the state for the GUI, the subtitles, the
display) goes on at that pace. CDVDMessageQueue::PrepareMessageWait()
clears the event where no message is queued, since Get() clears it only
when it waits, so a message taken at once before does not make the wait
return at once. Playback that is not paused does not reach the wait.

Found by SamuriHL in his CoreELEC builds (a sleep of 10 ms there); Kodi
master has the same loop.

Tests (outside the tree): a gtest of the real DVDMessageQueue.cpp and
threads/Event.cpp waited on as Process() waits (nothing queued, a message
queued before and after one taken at once, one from another thread, one
with a priority, a stop, an abort, the loop's pace over a second: 8 tests;
it does not build on the tree before), 4 mutants, each seen. In the
virtual machine, the binary of the image and one relinked from its objects
with this change: the thread from 71 % to 2.3 % of a core while paused at
the end, and from there resume, a seek back, a stop and the next item of a
playlist work as before.
---
 xbmc/cores/VideoPlayer/DVDMessageQueue.cpp | 12 ++++++++++++
 xbmc/cores/VideoPlayer/DVDMessageQueue.h   | 10 ++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp     |  7 +++++++
 3 files changed, 29 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp b/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
index f891833..7fe0fa4 100644
--- a/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
+++ b/xbmc/cores/VideoPlayer/DVDMessageQueue.cpp
@@ -221,6 +221,18 @@ MsgQueueReturnCode CDVDMessageQueue::Get(std::shared_ptr<CDVDMsg>& pMsg,
   return (MsgQueueReturnCode)ret;
 }
 
+CEvent& CDVDMessageQueue::PrepareMessageWait()
+{
+  std::unique_lock lock(m_section);
+  // Put() sets the event with each message and Abort() with the abort, but Get() clears it only
+  // when it waits: after a message that was taken at once (a timeout of 0) it is still set
+  if (m_bInitialized && !m_bAbortRequest && m_messages.empty() && m_prioMessages.empty())
+    m_hEvent.Reset();
+  else
+    m_hEvent.Set();
+  return m_hEvent;
+}
+
 void CDVDMessageQueue::UpdateTimeFront()
 {
   if (!m_messages.empty())
diff --git a/xbmc/cores/VideoPlayer/DVDMessageQueue.h b/xbmc/cores/VideoPlayer/DVDMessageQueue.h
index 6a8a038..da83562 100644
--- a/xbmc/cores/VideoPlayer/DVDMessageQueue.h
+++ b/xbmc/cores/VideoPlayer/DVDMessageQueue.h
@@ -79,6 +79,16 @@ public:
   bool ReceivedAbortRequest() { return m_bAbortRequest; }
   void WaitUntilEmpty();
 
+  /*!
+   * \brief Hades: for a thread that has nothing to do until a message comes (the player paused at
+   *        the end of its input): the event that Put() sets, clear unless a message is queued
+   *        already or the queue was aborted
+   *
+   * The thread waits on it together with whatever else is to wake it (CThread::AbortableWait()); the
+   * message stays in the queue for Get().
+   */
+  CEvent& PrepareMessageWait();
+
   // non messagequeue related functions
   bool IsFull() const { return GetLevel() == 100; }
 
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index dc94deb..d65de58 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2002,8 +2002,15 @@ void CVideoPlayer::Process()
     if (!pPacket)
     {
       // when paused, demuxer could be be returning empty
+      // Hades: as it does at the end of the input (the last queue's worth of a file), where the
+      // retry spun a core for as long as the pause lasted: wait for the next message (a resume, a
+      // seek, another file to play) or a stop, at most as long as a pause with full queues waits
+      // (above), and then go round as before
       if (m_playSpeed == DVD_PLAYSPEED_PAUSE)
+      {
+        AbortableWait(m_messenger.PrepareMessageWait(), 10ms);
         continue;
+      }
 
       // check for a still frame state
       if (std::shared_ptr<CDVDInputStream::IMenus> pStream = std::dynamic_pointer_cast<CDVDInputStream::IMenus>(m_pInputStream))
