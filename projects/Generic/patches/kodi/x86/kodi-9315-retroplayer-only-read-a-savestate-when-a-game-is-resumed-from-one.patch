From b64d208643511d6d263cbfc99ba287bb6b49760c Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Thu, 15 Oct 2026 08:24:52 +0100
Subject: [PATCH] [RetroPlayer] Only read a savestate when a game is resumed
 from one

Opening a game reads the savestate it is resumed from, to warn when
another emulator made it. A game that isn't resumed has no savestate,
so the empty path was read anyway and every such launch logged
"Failed to open savestate file" as an error. Skip the read when there
is no savestate, as the load later in Open() already does.
---
 xbmc/cores/RetroPlayer/RetroPlayer.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/cores/RetroPlayer/RetroPlayer.cpp b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
index 1b1fd8f..8f09e1e 100644
--- a/xbmc/cores/RetroPlayer/RetroPlayer.cpp
+++ b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
@@ -115,7 +115,7 @@ bool CRetroPlayer::Open(const CFileItem& file, const CPlayerOptions& options)
   // Asked before the game client is set up: the dialog runs the message loop,
   // and a game started from it once the client is playing would close this
   // player in the middle of opening
-  if (!bStandalone)
+  if (!bStandalone && !savestatePath.empty())
   {
     CSavestateDatabase savestateDb;
 
