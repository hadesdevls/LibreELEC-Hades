From 1f89fecf9735969a9d94c35688d7d01940f0e96d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:14:41 +0000
Subject: [PATCH] windowing/gbm: keep the Dolby Vision bridge across a change
 of mode

SetFullScreen() destroyed the bridge of native output (m_dvBridge.reset(),
from kodi-9990 of CroqueMr's fork) after ending native output. A change of
mode makes only the window surface anew (DestroyWindow(),
CreateNewWindow()); the GL context stays, and with it everything the
bridge owns: its pl_opengl, its renderer with the passes it has linked,
its 3840x2160 RGBA32F picture and its packer. So every video that changed
the mode set libplacebo up again, allocated that texture again and linked
all of its programs at its first frames. EndDVBridge() has already reset
the bridge then (transport state, libplacebo's errors and cached frames).

The one thing of the window it keeps is the wrapper of the default
framebuffer that a frame drawn directly writes into. UpdateScanout() looks
at the window again whenever native output starts, with the checks of
Initialize() (8-bit RGB, no multisampling, linear encoding), and wraps it
again when what libplacebo took of it differs; that was not done before
either when the bridge outlived a video without a change of mode.

The bridge now also stays in the GUI after a video that changed the mode,
as it already did after one that did not: its textures (132 MB for the
picture, plus libplacebo's intermediate ones) stay allocated until Kodi
stops. Not run on a GPU.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 52 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  5 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 10 +++-
 3 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index c91e622..21a6040 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -322,6 +322,58 @@ void CDVBridgeGLES::LogLayerCache()
   m_layerCacheLogged[1] = made;
 }
 
+void CDVBridgeGLES::UpdateScanout()
+{
+  if (!m_gl)
+    return;
+  // As in Initialize(): an 8-bit RGB window without multisampling or sRGB encoding, which the
+  // transport bytes go into as they are written.
+  GLint draw, read, red, green, blue, alpha, samples, encoding, type;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glGetIntegerv(GL_RED_BITS, &red);
+  glGetIntegerv(GL_GREEN_BITS, &green);
+  glGetIntegerv(GL_BLUE_BITS, &blue);
+  glGetIntegerv(GL_ALPHA_BITS, &alpha);
+  glGetIntegerv(GL_SAMPLES, &samples);
+  glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_BACK,
+      GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+  glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_BACK,
+      GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &type);
+  const bool usable = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE &&
+                      red == 8 && green == 8 && blue == 8 && samples <= 1 && encoding == GL_LINEAR;
+  // What libplacebo took of the window when it was wrapped (gl_fb_query(): the type and the depth
+  // of each component, the components without bits left out)
+  bool same = false;
+  if (m_scanout && usable)
+  {
+    const pl_fmt format = m_scanout->params.format;
+    same = format && format->type == (type == GL_UNSIGNED_NORMALIZED ? PL_FMT_UNORM : PL_FMT_UNKNOWN) &&
+           format->component_depth[0] == red && format->component_depth[1] == green &&
+           format->component_depth[2] == blue && format->num_components == (alpha ? 4 : 3) &&
+           (!alpha || format->component_depth[3] == alpha);
+  }
+  if (!same)
+  {
+    pl_tex_destroy(m_gl->gpu, &m_scanout);
+    if (usable)
+    {
+      // (libplacebo would take an error that is not its own as its failure)
+      TakeStaleGLErrors("the window is wrapped again");
+      pl_opengl_wrap_params output{};
+      output.width = 3840;
+      output.height = 2160;
+      m_scanout = pl_opengl_wrap(m_gl->gpu, &output);
+    }
+    CLog::Log(LOGDEBUG, "DVBridge: the window was looked at again: packed_scanout={} rgb_bits={}/{}/{}/{} "
+                        "samples={} linear_encoding={}",
+              m_scanout != nullptr, red, green, blue, alpha, samples, encoding == GL_LINEAR);
+  }
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+}
+
 void CDVBridgeGLES::TakeStaleGLErrors(const char* before)
 {
   // libplacebo reads glGetError() after its own calls and takes whatever it finds as its own
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index fb184ce..a28e87b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -38,6 +38,11 @@ public:
   CDVBridgeGLES& operator=(const CDVBridgeGLES&) = delete;
 
   bool Initialize(bool allowSoftware = false);
+  //! Hades: the output that a frame drawn directly goes into is the default framebuffer of the
+  //! context, whose surface the window system makes anew with a change of mode or of the output
+  //! format. Looked at again before native output starts with a bridge that was set up for
+  //! another surface: the direct way is used only into an 8-bit one, as Initialize() checks.
+  void UpdateScanout();
   void Reset();
   bool Prepare(const Layer& base, const Layer* enhancement,
                const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked = false);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 756e71e..95879a2 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -262,7 +262,13 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
       m_DRM->ReselectMode(before);
     return false;
   }
-  m_dvBridge.reset();
+  // Hades: the bridge of native output is kept. Its libplacebo and its renderer belong to the GL
+  // context, which a change of mode keeps (only the window surface is made anew: DestroyWindow(),
+  // CreateNewWindow()); EndDVBridge() has reset it (the transport state, libplacebo's errors and
+  // cached frames). Of the window it keeps only the wrapper of the default framebuffer, which
+  // BeginDVBridge() looks at again before native output starts (UpdateScanout()). Made anew here,
+  // as it used to be, every video that changes the mode set libplacebo up again and linked all
+  // of its programs at its first frames.
   EndDVConversion();
 #endif
   // Hades: what is set is res. Only when res is a 3D output whose window cannot be made (the
@@ -1199,6 +1205,8 @@ bool CWinSystemGbmGLESContext::BeginDVBridge()
     m_dvBridge = std::make_unique<CDVBridgeGLES>();
   if (!m_dvBridge->Initialize())
     return DVBridgeBeginRejected("bridge-initialize");
+  // (a bridge kept from an earlier native output: the window surface may be another one)
+  m_dvBridge->UpdateScanout();
   if (!m_dvState.Captured() && !m_dvState.Capture(*drm, EndedStereoInfoFrame()))
     return DVBridgeBeginRejected("output-state-capture");
   m_compositeShader.reset();
-- 
