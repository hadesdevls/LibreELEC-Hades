From ea8a21bca7bb2198b1bac08a4793d9c64779fc8f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:24:18 +0000
Subject: [PATCH] DVPlaybackPolicy, windowing/gbm: a mode carried only as YCbCr
 4:2:0 is in the driver's list

The comments of DVBRIDGE::TransportModesOf() and of OfferedDVTransportModes()
said that the driver lists no mode that the link cannot carry in 8-bit RGB.
i915 and amdgpu do list a mode that fits only as YCbCr 4:2:0 where the
display declares 4:2:0 for it (intel_hdmi_mode_valid() tries that format
when RGB is over the clock of the port): on an HDMI port of 340 MHz,
3840x2160 at 50 and 60 Hz is listed so. Such a mode counts as a transport
mode; the kernel refuses the tunnel on it (DVBRIDGE_REFUSED "ycbcr420"), and
native output falls back to the ordinary output with that refusal in the log
and the reason "link" in the player information, as for any refusal of the
driver. Only the comments change.
---
 .../VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h   | 12 ++++++++----
 xbmc/windowing/gbm/WinSystemGbm.cpp                  |  3 ++-
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 690a230..2a76b10 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -149,10 +149,14 @@ enum class TransportModes
 /*!
  * \brief Hades: what a list of modes offers native output at a refresh rate
  *
- * The list is the driver's: a mode that the source or the link cannot carry in 8-bit RGB is not in
- * it (on i915 and amdgpu the driver checks the TMDS clock of each mode before listing it), so a
- * transport mode is chosen only among those that fit. The rate is matched as Kodi matches the
- * refresh rate of a resolution (CResolutionUtils::FindDVTransportResolution(): 0.01 Hz).
+ * The list is the driver's: a mode that the source or the link cannot carry is not in it (on i915
+ * and amdgpu the driver checks the TMDS clock of each mode before listing it). A mode that fits only
+ * as YCbCr 4:2:0 is listed, where the display declares 4:2:0 for it (i915 and amdgpu try that format
+ * when RGB is over the clock): on an HDMI port of 340 MHz, 3840x2160 at 50 and 60 Hz. Such a mode
+ * counts here; the kernel refuses the tunnel on it (DVBRIDGE_REFUSED "ycbcr420"), and native output
+ * falls back to the ordinary output with that refusal in the log and the reason "link"
+ * (DVBRIDGE::REFUSED::Code()). The rate is matched as Kodi matches the refresh rate of a resolution
+ * (CResolutionUtils::FindDVTransportResolution(): 0.01 Hz).
  */
 inline TransportModes TransportModesOf(const std::vector<ModeTraits>& modes, double refresh)
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 6aa32bb..ef996ed 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1313,7 +1313,8 @@ bool DVModeInterlacedOr3D(const drmModeModeInfo& mode)
 // TransportModesOf(): none on an HDMI 1.4 port, cable, adapter or TV input at a lower clock than
 // 3840x2160 needs, or behind a DisplayPort dual-mode adapter of the first type; 24 to 30 Hz only on
 // an HDMI port of 300 MHz, as on Intel graphics of display version 9). The modes are the driver's,
-// which lists none that its link cannot carry.
+// which lists none that its link cannot carry; one that it carries only as YCbCr 4:2:0 is listed, and
+// the kernel refuses the tunnel on it (see TransportModesOf()).
 std::vector<DVBRIDGE::ModeTraits> DVModesOf(const CDRMConnector& connector)
 {
   std::vector<DVBRIDGE::ModeTraits> modes;
