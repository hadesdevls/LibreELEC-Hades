From db216307743a53a5cf8c34f33b6392441882005a Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 15 Oct 2026 20:03:46 +0100
Subject: [PATCH] [VideoTagLoaderFFmpeg] Don't throw on a track tag that isn't
 a number

An mp4's track tag was read with std::stoi, which throws on text that
doesn't start with a number - and nothing catches it below the top of a
library scan, which then stops at that file. Parse it with
std::from_chars and ignore a value that isn't a number.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7c2187700363dd56f5556e29119432a4aa7e7d84)
---
 xbmc/video/tags/VideoTagLoaderFFmpeg.cpp     | 11 ++-
 xbmc/video/test/CMakeLists.txt               |  1 +
 xbmc/video/test/TestVideoTagLoaderFFmpeg.cpp | 85 ++++++++++++++++++++
 3 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/video/test/TestVideoTagLoaderFFmpeg.cpp

diff --git a/xbmc/video/tags/VideoTagLoaderFFmpeg.cpp b/xbmc/video/tags/VideoTagLoaderFFmpeg.cpp
index b6ea81c..2033b23 100644
--- a/xbmc/video/tags/VideoTagLoaderFFmpeg.cpp
+++ b/xbmc/video/tags/VideoTagLoaderFFmpeg.cpp
@@ -17,6 +17,9 @@
 #include "utils/StringUtils.h"
 #include "video/VideoInfoTag.h"
 
+#include <charconv>
+#include <string_view>
+
 using namespace XFILE;
 
 namespace
@@ -261,7 +264,13 @@ CInfoScanner::InfoType CVideoTagLoaderFFmpeg::LoadMP4(CVideoInfoTag& tag,
       hasfull = true;
     }
     else if (strcmp(avtag->key, "track") == 0)
-      tag.m_iTrack = std::stoi(avtag->value);
+    {
+      // A number, possibly followed by the total ("3/12")
+      const std::string_view value{avtag->value};
+      if (int track{0};
+          std::from_chars(value.data(), value.data() + value.size(), track).ec == std::errc{})
+        tag.m_iTrack = track;
+    }
     else if (strcmp(avtag->key, "album") == 0)
       tag.SetAlbum(avtag->value);
     else if (strcmp(avtag->key, "artist") == 0)
diff --git a/xbmc/video/test/CMakeLists.txt b/xbmc/video/test/CMakeLists.txt
index 6cdcef7..6dc8d94 100644
--- a/xbmc/video/test/CMakeLists.txt
+++ b/xbmc/video/test/CMakeLists.txt
@@ -10,6 +10,7 @@ set(SOURCES TestBookmark.cpp
             TestVideoInfoScanner.cpp
             TestVideoInfoTag.cpp
             TestVideoStreamSelect.cpp
+            TestVideoTagLoaderFFmpeg.cpp
             TestVideoTagLoaderNFO.cpp
             TestVideoThumbLoader.cpp
             TestVideoUtils.cpp)
diff --git a/xbmc/video/test/TestVideoTagLoaderFFmpeg.cpp b/xbmc/video/test/TestVideoTagLoaderFFmpeg.cpp
new file mode 100644
index 0000000..a028ebd
--- /dev/null
+++ b/xbmc/video/test/TestVideoTagLoaderFFmpeg.cpp
@@ -0,0 +1,85 @@
