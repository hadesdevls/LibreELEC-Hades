   bool InitSink();
+  //! Hades: a resampler of the sink or of a stream did not open (CActiveAEBufferPoolResample::
+  //! ResamplerFailed()): the engine is set to open its output again, as after a sink that did not
+  //! open (m_sinkInitFailed, m_extError), which makes every resampler anew
+  bool ResamplerFailed();
   bool SendYieldDevice(bool yield);
   void DrainSink();
   void UnconfigureSink();
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEBuffer.cpp
