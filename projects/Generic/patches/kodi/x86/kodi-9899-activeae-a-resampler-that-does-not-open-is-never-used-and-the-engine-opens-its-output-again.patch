diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 5535ccb..a6e6264 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -743,6 +743,14 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
         switch (signal)
         {
         case CActiveAEControlProtocol::TIMEOUT:
+          // (Hades: a resampler that did not open drains nothing, and waiting for it was for good)
+          if (ResamplerFailed())
+          {
+            m_state = AE_TOP_ERROR;
+            m_extTimeout = 500ms;
+            m_extDeferData = false;
+            return;
+          }
           // drain
           if (RunStages())
           {
@@ -1211,7 +1219,7 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
         switch (signal)
         {
         case CActiveAEControlProtocol::TIMEOUT:
-          if (m_extError)
+          if (m_extError || ResamplerFailed()) // (Hades: ResamplerFailed())
           {
             m_state = AE_TOP_ERROR;
             m_extTimeout = 100ms;
@@ -1669,7 +1677,8 @@ void CActiveAE::Configure(AEAudioFormat *desiredFmt)
 
   // resample buffers for sink
   if (m_sinkBuffers &&
-     (!CompareFormat(m_sinkBuffers->m_format,m_sinkFormat) ||
+     (m_sinkBuffers->ResamplerFailed() || // (Hades: ResamplerFailed())
+      !CompareFormat(m_sinkBuffers->m_format,m_sinkFormat) ||
       !CompareFormat(m_sinkBuffers->m_inputFormat, sinkInputFormat) ||
       m_sinkBuffers->m_format.m_frames != m_sinkFormat.m_frames))
   {
@@ -1703,6 +1712,33 @@ void CActiveAE::Configure(AEAudioFormat *desiredFmt)
 
   ClearDiscardedBuffers();
   m_extDrain = false;
+
+  // (Hades: every caller of Configure() goes to AE_TOP_ERROR on m_extError)
+  ResamplerFailed();
+}
+
+bool CActiveAE::ResamplerFailed()
+{
+  // Hades: a resampler that did not open passes nothing on. Its stream would have waited for good,
+  // in silence, or the engine would have ended on a SIGSEGV in libswresample (reported by
+  // dangerouslaser). As after a sink that did not open, the engine goes to AE_TOP_ERROR,
+  // opens its output again after its retry interval and makes every resampler anew. The player
+  // sees no sink meanwhile: it plays the video, drops the sound of the stream as its time comes,
+  // and if that lasts it closes the stream and says so (CVideoPlayerAudio::OutputPacket());
+  // without the stream (FREESTREAM) the engine tries again at once.
+  bool failed = m_sinkBuffers && m_sinkBuffers->ResamplerFailed();
+  for (const CActiveAEStream* stream : m_streams)
+    failed = failed ||
+             (stream->m_processingBuffers && stream->m_processingBuffers->ResamplerFailed());
+  if (!failed)
+    return false;
+
+  if (!m_extError)
+    CLog::Log(LOGERROR, "CActiveAE - a resampler did not open: the output is opened again, and "
+                        "every resampler is made anew");
+  m_sinkInitFailed = true;
+  m_extError = true;
+  return true;
 }
 
 CActiveAEStream* CActiveAE::CreateStream(MsgStreamNew *streamMsg)
@@ -4516,9 +4552,15 @@ bool CActiveAE::ResampleSound(CActiveAESound *sound)
   std::unique_ptr<IAEResample> resampler =
       CAEResampleFactory::Create(AERESAMPLEFACTORY_QUICK_RESAMPLE);
 
-  resampler->Init(dst_config, orig_config, false, true, M_SQRT1_2,
-                  outChannels.Count() > 0 ? &outChannels : nullptr, m_settings.resampleQuality,
-                  false, 0.0f);
+  // Hades: a sound whose resampler does not open is converted to no samples: it stays silent,
+  // once, instead of being mixed with a count of -1 (and converted again at each mix)
+  const bool opened =
+      resampler->Init(dst_config, orig_config, false, true, M_SQRT1_2,
+                      outChannels.Count() > 0 ? &outChannels : nullptr, m_settings.resampleQuality,
+                      false, 0.0f);
+  if (!opened)
+    CLog::Log(LOGERROR, "CActiveAE::{} - the resampler of a GUI sound did not open: it stays silent",
+              __FUNCTION__);
 
   dst_samples = resampler->CalcDstSampleCount(sound->GetSound(true)->nb_samples,
                                               m_internalFormat.m_sampleRate,
@@ -4528,12 +4570,12 @@ bool CActiveAE::ResampleSound(CActiveAESound *sound)
   if (!dst_buffer)
     return false;
 
-  int samples = resampler->Resample(dst_buffer, dst_samples,
-                                    sound->GetSound(true)->data,
-                                    sound->GetSound(true)->nb_samples,
-                                    1.0);
+  int samples = opened ? resampler->Resample(dst_buffer, dst_samples,
+                                             sound->GetSound(true)->data,
+                                             sound->GetSound(true)->nb_samples, 1.0)
+                       : 0;
 
-  sound->GetSound(false)->nb_samples = samples;
+  sound->GetSound(false)->nb_samples = std::max(samples, 0);
 
   sound->SetConverted(true);
   return true;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
