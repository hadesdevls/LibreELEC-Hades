@@ -14,11 +14,24 @@
 #include "cores/AudioEngine/Utils/AEPackIEC61937.h"
 #include "cores/AudioEngine/Utils/AEUtil.h"
 #include "cores/AudioEngine/Utils/AudioSettingsLive.h"
+#include "utils/log.h"
 
 #include <memory>
+#include <string>
 
 using namespace ActiveAE;
 
+namespace
+{
+std::string SampleConfigText(const SampleConfig& config)
+{
+  const char* format = av_get_sample_fmt_name(config.fmt);
+  return std::to_string(config.channels) + " channels (layout " +
+         std::to_string(config.channel_layout) + "), " + (format ? format : "no format") + ", " +
+         std::to_string(config.sample_rate) + " Hz";
+}
+} // namespace
+
 CSoundPacket::CSoundPacket(const SampleConfig& conf, int samples) : config(conf)
 {
   data = CActiveAE::AllocSoundSample(config, samples, bytes_per_sample, planes, linesize);
@@ -166,7 +179,8 @@ bool CActiveAEBufferPoolResample::Create(
   {
     ChangeResampler();
   }
-  return true;
+  // Hades: and false where the resampler did not open (ChangeResampler())
+  return !m_resamplerFailed;
 }
 
 void CActiveAEBufferPoolResample::ChangeResampler()
@@ -188,9 +202,18 @@ void CActiveAEBufferPoolResample::ChangeResampler()
   srcConfig.bits_per_sample = CAEUtil::DataFormatToUsedBits(m_inputFormat.m_dataFormat);
   srcConfig.dither_bits = CAEUtil::DataFormatToDitherBits(m_inputFormat.m_dataFormat);
 
-  m_resampler->Init(dstConfig, srcConfig, m_stereoUpmix, m_normalize, m_centerMixLevel,
-                    m_remap ? &m_format.m_channelLayout : nullptr, m_resampleQuality,
-                    m_forceResampler, m_mixSubLevel);
+  // Hades: a resampler that did not open is never used: the input would go on in another format
+  // than the pool's (the samples of a stream into the sink as they are), or into libswresample
+  // without a context. The engine opens its output again (CActiveAE::ResamplerFailed()).
+  m_resamplerFailed = !m_resampler->Init(dstConfig, srcConfig, m_stereoUpmix, m_normalize,
+                                         m_centerMixLevel,
+                                         m_remap ? &m_format.m_channelLayout : nullptr,
+                                         m_resampleQuality, m_forceResampler, m_mixSubLevel);
+  if (m_resamplerFailed)
+    CLog::Log(LOGERROR,
+              "CActiveAEBufferPoolResample - the resampler from {} to {} did not open: nothing "
+              "goes through it",
+              SampleConfigText(srcConfig), SampleConfigText(dstConfig));
 
   m_changeResampler = false;
 }
@@ -200,6 +223,10 @@ bool CActiveAEBufferPoolResample::ResampleBuffers(int64_t timestamp)
   bool busy = false;
   CSampleBuffer *in;
 
+  // (Hades: see ChangeResampler())
+  if (m_resamplerFailed)
+    return false;
+
   if (!m_resampler)
   {
     if (m_changeResampler)
@@ -421,7 +448,8 @@ void CActiveAEBufferPoolResample::Flush()
     m_outputSamples.front()->Return();
     m_outputSamples.pop_front();
   }
-  if (m_resampler)
+  // (Hades: one that did not open is made anew by the engine, not here: ChangeResampler())
+  if (m_resampler && !m_resamplerFailed)
     ChangeResampler();
 }
 
