@@ -196,6 +199,13 @@ bool CActiveAEResampleFFMPEG::Init(SampleConfig dstConfig,
 
 int CActiveAEResampleFFMPEG::Resample(uint8_t **dst_buffer, int dst_samples, uint8_t **src_buffer, int src_samples, double ratio)
 {
+  // Hades: an Init() that failed leaves no context (it is freed there): nothing is resampled, and
+  // nothing is buffered (GetDelay(), GetBufferedSamples()). Each of these used to go on with a null
+  // context, or one that swr_init() had refused, into libswresample: a SIGSEGV in swr_get_delay(),
+  // or a division by its sample rate of 0.
+  if (!m_pContext)
+    return -1;
+
   if (ratio != 1.0)
   {
     // Compensation is in whole samples, and a ratio this close to 1, or a call
@@ -294,11 +304,15 @@ int CActiveAEResampleFFMPEG::Resample(uint8_t **dst_buffer, int dst_samples, uin
 
 int64_t CActiveAEResampleFFMPEG::GetDelay(int64_t base)
 {
+  if (!m_pContext) // (Hades: see Resample())
+    return 0;
   return swr_get_delay(m_pContext, base);
 }
 
 int CActiveAEResampleFFMPEG::GetBufferedSamples()
 {
+  if (!m_pContext) // (Hades: see Resample())
+    return 0;
   return av_rescale_rnd(swr_get_delay(m_pContext, m_src_rate),
                                     m_dst_rate, m_src_rate, AV_ROUND_UP);
 }
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index e8d9b38..8d863b1 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -1630,11 +1630,19 @@ void CActiveAESink::GenerateNoise()
   srcConfig.bits_per_sample = CAEUtil::DataFormatToUsedBits(m_sinkFormat.m_dataFormat);
   srcConfig.dither_bits = CAEUtil::DataFormatToDitherBits(m_sinkFormat.m_dataFormat);
 
-  resampler->Init(dstConfig, srcConfig, false, false, M_SQRT1_2, nullptr, AE_QUALITY_UNKNOWN, false,
-                  0.0);
-
-  resampler->Resample(m_sampleOfSilence.pkt->data, m_sampleOfSilence.pkt->max_nb_samples,
-                     (uint8_t**)&noise, m_sampleOfSilence.pkt->max_nb_samples, 1.0);
+  // Hades: where the resampler does not open, the packet is silence, as without noise: what
+  // av_samples_alloc() left in it was sent otherwise
+  if (resampler->Init(dstConfig, srcConfig, false, false, M_SQRT1_2, nullptr, AE_QUALITY_UNKNOWN,
+                      false, 0.0))
+    resampler->Resample(m_sampleOfSilence.pkt->data, m_sampleOfSilence.pkt->max_nb_samples,
+                        (uint8_t**)&noise, m_sampleOfSilence.pkt->max_nb_samples, 1.0);
+  else
+  {
+    CLog::Log(LOGERROR, "CActiveAESink::{} - the resampler did not open: silence without noise",
+              __FUNCTION__);
+    av_samples_set_silence(m_sampleOfSilence.pkt->data, 0, m_sampleOfSilence.pkt->max_nb_samples,
+                           config.channels, config.fmt);
+  }
 
   KODI::MEMORY::AlignedFree(noise);
 }
