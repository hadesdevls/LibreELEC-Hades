From 4a1e7ecb77ccd22a9288f05ce3b9e4a85ecad034 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 04:00:22 +0000
Subject: [PATCH] ActiveAE: TrueHD passthrough at the water level while its
 sync is measured

A start and a seek of a passthrough stream begin with a measure of its
sync (SyncStream(), SYNC_MUTE): for 100 ms every packet that goes to the
sink is turned into a pause of its own length, so that the receiver does
not lock on to sound that the correction after the measure would cut.
RunStages() lets packets go to the sink up to its water level: 200 ms,
or, in the low latency mode (on by default), 20 ms at a start, growing
to 200 ms in about 10 s. TrueHD passthrough is let past the water level,
since its frames come in unevenly, so its measure also turned into
pauses all that the player had cached before the start. Measured on the
host with a device of 200 ms: at each start and each seek, 680 ms of
TrueHD went out as pauses (its first sound 700 ms after the start),
against 288 ms of AC-3 and E-AC-3 and 331 ms of DTS-HD MA in the low
latency mode.

While the sync of a stream that plays is measured (SYNC_START,
SYNC_MUTE), TrueHD is now held to the water level as the other formats
are, and after the measure it passes it as before. What goes out during
the measure is the same: each packet as a pause of its own length, and
the error measured takes away the delay of every packet in the sink as
before. The cache that the measure no longer turns into pauses is what a
late start leaves out after it, at once (the commit before keeps that
from going past the video). Measured the same way, a start or a seek of
TrueHD now turns 300 ms into pauses in the low latency mode (its first
sound at 320 ms, as AC-3), 460 ms without it; the other formats send
the same as before. At the end of each measure of a passthrough stream,
kodi.log says how many of its packets went out as pauses.
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 31 ++++++++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  2 ++
 .../Engines/ActiveAE/ActiveAEStream.h         |  3 ++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index cbad83f..24f47ab 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -2728,6 +2728,12 @@ bool CActiveAE::RunStages()
   // TrueHD is very jumpy, meaning the frames don't come in equidistantly. They are only smoothed
   // at the end when the IEC packing happens. Therefore adjust earlier.
   const bool isTrueHDPassthrough{IsTrueHDPassthrough()};
+  // Hades: but not while the sync of a stream is measured. Every packet that goes to the sink then
+  // is turned into a pause (SyncStream(), SYNC_MUTE): past the water level, a start or a seek of
+  // TrueHD turned into pauses all that the player had cached (300 to 400 ms), where the water level
+  // lets out 20 ms at a start in the low latency mode, 200 ms without it. The measure is the same:
+  // the delay that it takes away counts every packet in the sink.
+  const bool trueHDBypass{isTrueHDPassthrough && !IsSyncMeasuring()};
 
   if (m_settings.lowLatencyMode)
   {
@@ -2741,7 +2747,7 @@ bool CActiveAE::RunStages()
   // The buffer level "GetWaterLevel()" always tries to follow m_targetBufferLevel because when it
   // is lower, audio samples are added, and when it is higher, audio samples stop being added
   // and the level goes down.
-  if ((m_stats.GetWaterLevel() < m_targetBufferLevel || isTrueHDPassthrough) &&
+  if ((m_stats.GetWaterLevel() < m_targetBufferLevel || trueHDBypass) &&
       (m_mode != MODE_TRANSCODE || (m_encoderBuffers && !m_encoderBuffers->m_freeSamples.empty())))
   {
     // calculate sync error
@@ -3176,6 +3182,18 @@ bool CActiveAE::IsTrueHDPassthrough() const
          m_sinkFormat.m_streamInfo.m_type == CAEStreamInfo::STREAM_TYPE_TRUEHD;
 }
 
+bool CActiveAE::IsSyncMeasuring() const
+{
+  // (a stream without a clock is never synced: SyncStream() leaves it as it is)
+  return std::any_of(m_streams.begin(), m_streams.end(),
+                     [](const CActiveAEStream* stream)
+                     {
+                       return !stream->m_paused && stream->m_pClock &&
+                              (stream->m_syncState == CAESyncInfo::AESyncState::SYNC_START ||
+                               stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE);
+                     });
+}
+
 CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
 {
   CSampleBuffer *ret = NULL;
@@ -3191,6 +3209,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     stream->m_processingBuffers->SetRR(1.0, m_settings.atempoThreshold);
     stream->m_resampleIntegral = 0;
     stream->m_lateStartHandedOver = false;
+    stream->m_rawMuted = 0; // (Hades)
     CLog::Log(LOGDEBUG,"ActiveAE - start sync of audio stream");
   }
 
@@ -3287,6 +3306,14 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
   }
   else if (newerror && stream->m_syncState == CAESyncInfo::AESyncState::SYNC_MUTE)
   {
+    // Hades: what the measure of a passthrough stream took of its sound (RunStages() holds TrueHD
+    // to the water level meanwhile)
+    if (m_mode == MODE_RAW)
+      CLog::Log(LOGINFO,
+                "ActiveAE::SyncStream - the sync of the passthrough stream ({}) is measured: {} of "
+                "its packets ({:.0f} ms of its sound) went out as pauses meanwhile",
+                CAEUtil::StreamTypeToStr(stream->m_format.m_streamInfo.m_type), stream->m_rawMuted,
+                stream->m_rawMuted * stream->m_format.m_streamInfo.GetDuration());
     if (clockFollowsAudio && error < 0 && -error <= MAX_LATE_START_MS)
     {
       stream->m_syncState = CAESyncInfo::AESyncState::SYNC_INSYNC;
@@ -3337,6 +3364,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
     {
       buf->pkt->nb_samples = 0;
       buf->pkt->pause_burst_ms = stream->m_processingBuffers->m_inputFormat.m_streamInfo.GetDuration();
+      stream->m_rawMuted++; // (Hades)
     }
     else
     {
@@ -3486,6 +3514,7 @@ CSampleBuffer* CActiveAE::SyncStream(CActiveAEStream *stream)
       {
         stream->m_syncState = CAESyncInfo::AESyncState::SYNC_MUTE;
         stream->m_syncError.Flush(100ms);
+        stream->m_rawMuted = 0; // (Hades)
         CLog::Log(LOGDEBUG, "ActiveAE::SyncStream - average error {:f}, last average error: {:f}",
                   error, stream->m_lastSyncError);
         stream->m_lastSyncError = error;
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index a0c9c57..30ebae4 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -407,6 +407,8 @@ protected:
   bool HasWork();
   CSampleBuffer* SyncStream(CActiveAEStream *stream);
   bool IsTrueHDPassthrough() const;
+  //! Hades: whether the sync of a stream that plays is being measured (SYNC_START, SYNC_MUTE)
+  bool IsSyncMeasuring() const;
 
   void ResampleSounds();
   bool ResampleSound(CActiveAESound *sound);
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
index 6e2ae72..47b17da 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEStream.h
@@ -285,6 +285,9 @@ protected:
   std::optional<std::chrono::steady_clock::time_point> m_rawSilenceWaitSince;
   unsigned int m_rawSilenceWaits{0};
   bool m_rawSilenceGaveUp{false};
+  //! Hades: the packets of a passthrough stream turned into pauses while its sync was measured
+  //! (CActiveAE::SyncStream(), SYNC_MUTE), said when the measure ends
+  unsigned int m_rawMuted{0};
   //! Hades: a passthrough stream paused with the sound that the output had not played kept for its
   //! resume (CActiveAE::HoldRawStream(), PassthroughPause.h)
   struct RawHold
-- 
