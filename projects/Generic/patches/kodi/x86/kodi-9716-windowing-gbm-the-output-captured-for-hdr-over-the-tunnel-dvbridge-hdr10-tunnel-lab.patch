From 43caf580a42606fd00c05a983cace8521c16c79a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:55:21 +0000
Subject: [PATCH] windowing/gbm: the output captured for HDR over the tunnel
 (DVBRIDGE_HDR10_TUNNEL_LAB)

CDVBridgeState::Capture() takes a fifth argument, hdr10Tunnel: the kernel's backends only (i915
and amdgpu with linux-9999-x1-tunnel; nvidia-drm has no such property: refused, with the reason
that CaptureFailure() gives), never together with Low-Latency or the HDMI 1.4b signal. What it
captures is the tunnel of Dolby Vision Standard (DVBRIDGE_DV_STANDARD_LAB, 8 bpc, full range RGB,
default colorspace, the colour format AUTO, no CTM, LUT or alpha blend of another plane) plus
DVBRIDGE_HDR10_TUNNEL_LAB = 1, required; and what it does not capture is HDR_OUTPUT_METADATA: the
kernel requires the HDR metadata of the stream in the connector state for it (the Dolby tunnel
refuses it), so it is Kodi's own, set for the picture, not set to 0 as native Dolby Vision does.
ClearLeftover() also takes DVBRIDGE_HDR10_TUNNEL_LAB of a Kodi that ended during one. Without the
argument nothing changes for any other output.

Read against linux-9999-x1-tunnel-2 (i915: val > 1 or not an HDMI connector is -EINVAL, a value
without enable_dv_lab is -EOPNOTSUPP, a change of it is a full modeset; the clear of the client
restore) and -3 (amdgpu). Not tried on hardware.
---
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 33 ++++++++++++++++++++----
 xbmc/windowing/gbm/drm/DVBridgeState.h   | 13 +++++++++-
 2 files changed, 40 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index 5d9694d..5febd15 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -91,6 +91,12 @@ bool CDVBridgeState::SupportsLowLatency(CDRMConnector& connector)
   }
 }
 
+bool CDVBridgeState::SupportsHdr10Tunnel(CDRMConnector& connector)
+{
+  return GetBackend(connector) == Backend::KERNEL &&
+         connector.SupportsProperty("DVBRIDGE_HDR10_TUNNEL_LAB");
+}
+
 bool CDVBridgeState::SupportsHdmi14b(CDRMConnector& connector)
 {
   switch (GetBackend(connector))
@@ -126,7 +132,8 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
   // (Hades: and the Low-Latency or the HDMI 1.4b signalling of either, which go with them)
   const bool kernel = connector->GetPropertyValue("DVBRIDGE_DV_STANDARD_LAB").value_or(0) != 0 ||
                       connector->GetPropertyValue("DVBRIDGE_DV_LOW_LATENCY_LAB").value_or(0) != 0 ||
-                      connector->GetPropertyValue("DVBRIDGE_DV_HDMI14B_LAB").value_or(0) != 0;
+                      connector->GetPropertyValue("DVBRIDGE_DV_HDMI14B_LAB").value_or(0) != 0 ||
+                      connector->GetPropertyValue("DVBRIDGE_HDR10_TUNNEL_LAB").value_or(0) != 0;
   const bool nvidia = connector->GetPropertyValue("NV_HDMI_VSIF_METADATA").value_or(0) != 0 ||
                       connector->GetPropertyValue("NV_HDMI_DV_LOW_LATENCY").value_or(0) != 0 ||
                       connector->GetPropertyValue("NV_HDMI_DV_HDMI14B").value_or(0) != 0;
@@ -145,6 +152,9 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
     drm.AddProperty(connector, "DVBRIDGE_DV_LOW_LATENCY_LAB", 0);
   if (kernel && connector->SupportsProperty("DVBRIDGE_DV_HDMI14B_LAB"))
     drm.AddProperty(connector, "DVBRIDGE_DV_HDMI14B_LAB", 0);
+  // (Hades: ... and HDR over the tunnel, whose own HDR metadata is Kodi's, not left by the transport)
+  if (kernel && connector->SupportsProperty("DVBRIDGE_HDR10_TUNNEL_LAB"))
+    drm.AddProperty(connector, "DVBRIDGE_HDR10_TUNNEL_LAB", 0);
   if (nvidia)
     drm.AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0);
   // (both in the one commit: nvidia-drm takes neither without the other)
@@ -174,7 +184,8 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
   }
 }
 
-bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency, bool hdmi14b)
+bool CDVBridgeState::Capture(
+    CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency, bool hdmi14b, bool hdr10Tunnel)
 {
   // Hades: what stands in the way is said (CaptureFailure()); nothing else changes with it
   m_captureFailure.clear();
@@ -202,6 +213,12 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
   // the two together)
   if (hdmi14b && lowLatency)
     return fail("Low-Latency and the HDMI 1.4b signalling are asked for together");
+  // Hades: HDR over the tunnel is none of the Dolby Vision signals, and only the kernel's backends have it
+  if (hdr10Tunnel && (lowLatency || hdmi14b))
+    return fail("HDR over the tunnel is asked for together with a Dolby Vision signal");
+  if (hdr10Tunnel && !SupportsHdr10Tunnel(*connector))
+    return fail("the driver of the connector cannot send HDR over the tunnel (no "
+                "DVBRIDGE_HDR10_TUNNEL_LAB)");
   if (hdmi14b && !SupportsHdmi14b(*connector))
     return fail("the driver of the connector cannot send the older Dolby Vision signalling, the "
                 "HDMI 1.4b vendor InfoFrame");
@@ -267,7 +284,11 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
         // Hades: ... or is signalled with the HDMI 1.4b vendor InfoFrame, which the kernel makes
         // for the mode of each commit
         (hdmi14b && !save(connector, "DVBRIDGE_DV_HDMI14B_LAB", 1, true, false)) ||
-        !save(connector, "HDR_OUTPUT_METADATA", 0, false, true) ||
+        // Hades: ... or carries HDR: the kernel then requires the HDR metadata that Kodi sets for the
+        // stream (HDR_OUTPUT_METADATA, which is not captured: the transport's 0 would be refused), and
+        // sends no Dolby VSIF
+        (hdr10Tunnel && !save(connector, "DVBRIDGE_HDR10_TUNNEL_LAB", 1, true, false)) ||
+        (!hdr10Tunnel && !save(connector, "HDR_OUTPUT_METADATA", 0, false, true)) ||
         !save(connector, "max bpc", 8, true, false) ||
         !save(connector, "Broadcast RGB", 0, true, false, "Full") ||
         !save(connector, "Colorspace", 0, true, false, "Default") ||
@@ -389,6 +410,7 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
   m_owner = &drm;
   m_backend = backend;
   m_lowLatency = lowLatency;
+  m_hdr10Tunnel = hdr10Tunnel;
   m_hdmi14b = hdmi14b;
   m_hdmi14bVsif = std::move(hdmi14bVsif);
   m_hdmi14bVic = hdmi14b && backend == Backend::NVIDIA ? static_cast<int>(hdmi14bVic) : -1;
@@ -419,8 +441,9 @@ bool CDVBridgeState::Capture(CDRMAtomic& drm, uint64_t ownVsif, bool lowLatency,
   }
   CLog::Log(LOGDEBUG,
             "DVBridge: output state captured connector={} crtc={} plane={} properties={} "
-            "low_latency={} hdmi14b={}",
-            connector->GetId(), crtc->GetId(), plane->GetId(), m_saved.size(), lowLatency, hdmi14b);
+            "low_latency={} hdmi14b={} hdr10_tunnel={}",
+            connector->GetId(), crtc->GetId(), plane->GetId(), m_saved.size(), lowLatency, hdmi14b,
+            hdr10Tunnel);
   return true;
 }
 
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.h b/xbmc/windowing/gbm/drm/DVBridgeState.h
index bf68605..13ed0c2 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.h
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.h
@@ -45,6 +45,9 @@ public:
   //! kernel: DVBRIDGE_DV_LOW_LATENCY_LAB, linux-9975 to 9977; nvidia-drm: NV_HDMI_DV_LOW_LATENCY,
   //! nvidia-open-kernel-modules-9030)
   static bool SupportsLowLatency(CDRMConnector& connector);
+  //! Hades: the connector can send HDR as YCbCr 4:2:2 at 12 bits over its tunnel (the kernel:
+  //! DVBRIDGE_HDR10_TUNNEL_LAB, linux-9999-x1-tunnel; i915 and amdgpu: not nvidia-drm)
+  static bool SupportsHdr10Tunnel(CDRMConnector& connector);
   //! Hades: ... and the older signalling, the HDMI 1.4b vendor InfoFrame (DVHdmi14b.h; the kernel:
   //! DVBRIDGE_DV_HDMI14B_LAB; nvidia-drm: NV_HDMI_DV_HDMI14B, nvidia-open-kernel-modules-9045 and
   //! nvidia-legacy-open-9058)
@@ -64,10 +67,14 @@ public:
   //!        (SupportsHdmi14b()): the kernel makes it for the mode of each commit; for nvidia-drm it
   //!        is made here, and again by Stage() for the mode of a commit that changes it. Never with
   //!        lowLatency.
+  //! \param hdr10Tunnel Hades: the tunnel carries HDR (HDR10, HLG, HDR10+) as YCbCr 4:2:2 at 12 bits
+  //!        (SupportsHdr10Tunnel()): no Dolby VSIF, and the HDR metadata of the stream is the output's,
+  //!        as Kodi sets it: it is not captured, and not set to 0. Never with lowLatency or hdmi14b.
   bool Capture(CDRMAtomic& drm,
                uint64_t ownVsif = 0,
                bool lowLatency = false,
-               bool hdmi14b = false);
+               bool hdmi14b = false,
+               bool hdr10Tunnel = false);
   bool Stage(CDRMAtomic& drm, bool restore);
   void Restored()
   {
@@ -76,6 +83,7 @@ public:
     m_transportLive = false;
     m_backend = Backend::NONE;
     m_lowLatency = false;
+    m_hdr10Tunnel = false;
     m_hdmi14b = false;
     m_hdmi14bVic = -1;
     for (auto& blob : m_hdmi14bVsif)
@@ -93,6 +101,8 @@ public:
   Backend CapturedBackend() const { return m_backend; }
   //! Hades: the captured output sends Dolby Vision Low-Latency
   bool CapturedLowLatency() const { return Captured() && m_lowLatency; }
+  //! Hades: the captured output sends HDR over the tunnel (Capture(): hdr10Tunnel), not Dolby Vision
+  bool CapturedHdr10Tunnel() const { return Captured() && m_hdr10Tunnel; }
   //! Hades: the captured output signals Dolby Vision with the HDMI 1.4b vendor InfoFrame
   bool CapturedHdmi14b() const { return Captured() && m_hdmi14b; }
   //! True once per capture, so that a refused restart of the output, retried once a second while
@@ -129,6 +139,7 @@ private:
   bool m_restartNotice = true;
   std::string m_captureFailure;
   bool m_lowLatency = false;
+  bool m_hdr10Tunnel = false;
   //! Hades: the HDMI 1.4b vendor InfoFrame (Capture(): hdmi14b); on nvidia-drm, its blob for each
   //! HDMI_VIC that a mode of this capture has had (kept while it is captured: a commit refused
   //! after a change of mode goes back to the blob of before), and the HDMI_VIC of the one staged
-- 
2.53.0

