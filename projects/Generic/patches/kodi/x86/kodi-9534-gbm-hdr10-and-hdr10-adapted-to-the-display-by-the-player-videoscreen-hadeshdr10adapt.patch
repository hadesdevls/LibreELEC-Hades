+bool CDVBridgeGLES::ConversionOutputAdapted(const VideoPicture& picture,
+                                            VideoPicture& output,
+                                            const dvbridge_hdr10_mapping& mapping)
+{
+  if (!mapping.enabled || mapping.target != DVBRIDGE_HDR10_TARGET_HDR10 || !(mapping.peak > 0))
+    return false;
+  output.SetParams(picture);
+  output.hdr10PlusVsif.reset();
+  const double mdl = picture.hasDisplayMetadata && picture.displayMetadata.has_luminance &&
+                             picture.displayMetadata.max_luminance.den
+                         ? av_q2d(picture.displayMetadata.max_luminance)
+                         : 0.0;
+  const double cll = picture.hasLightMetadata ? picture.lightMetadata.MaxCLL : 0.0;
+  // (the peak the curve maps from, as libplacebo takes it: the mastering display's, else MaxCLL)
+  const double from = mdl > 0 ? mdl : cll;
+  const double peak = mapping.peak;
+  if (from > peak)
+  {
+    output.hasDisplayMetadata = true;
+    output.displayMetadata.has_luminance = 1;
+    output.displayMetadata.max_luminance = av_make_q(static_cast<int>(std::lround(peak)), 1);
+    if (!picture.hasDisplayMetadata || !picture.displayMetadata.has_luminance)
+      output.displayMetadata.min_luminance = av_make_q(0, 1);
+    output.hasLightMetadata = true;
+    output.lightMetadata.MaxCLL =
+        static_cast<unsigned>(cll > 0 && cll < peak ? cll : std::lround(peak));
+    output.lightMetadata.MaxFALL = 0;
+  }
+  float xy[8];
+  if (dvbridge_hdr10_gamut_xy(mapping.gamut, xy))
+  {
+    const auto q = [](float v) { return av_make_q(static_cast<int>(std::lround(v * 50000)), 50000); };
+    output.hasDisplayMetadata = true;
+    output.displayMetadata.has_primaries = 1;
+    for (int i = 0; i < 3; ++i)
+    {
+      output.displayMetadata.display_primaries[i][0] = q(xy[2 * i]);
+      output.displayMetadata.display_primaries[i][1] = q(xy[2 * i + 1]);
+    }
+    output.displayMetadata.white_point[0] = q(xy[6]);
+    output.displayMetadata.white_point[1] = q(xy[7]);
+  }
+  CLog::Log(LOGINFO,
+            "DVBridge: the HDR10 output of a picture adapted to the display: {} (the curve maps "
+            "from {:.0f} cd/m2), the primaries of the gamut it is mapped into, no HDR10+",
+            from > peak ? StringUtils::Format("mastering display {:.0f} cd/m2 and MaxCLL {} told, "
+                                              "MaxFALL not known",
+                                              peak, output.lightMetadata.MaxCLL)
+                        : std::string("its luminance as the video gives it (it is not above the "
+                                      "display's)"),
+            from);
+  return true;
+}
