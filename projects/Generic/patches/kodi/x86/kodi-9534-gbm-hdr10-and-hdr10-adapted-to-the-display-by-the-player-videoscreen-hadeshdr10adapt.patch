+
+bool CWinSystemGbmGLESContext::Hdr10AdaptWanted(const VideoPicture& picture)
+{
+  // (a picture of Dolby Vision is never asked this: it goes its own way, native or reconstructed)
+  if (picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+    return false;
+  if (!m_hdr10AdaptDecided.exchange(true))
+  {
+    namespace A = HDR10_ADAPT;
+    const auto settings = SettingsNow();
+    const int mode = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDR10ADAPT)
+                         ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESHDR10ADAPT)
+                         : 0;
+    m_hdr10AdaptMode = mode == 1 ? A::Mode::ALWAYS : mode == 2 ? A::Mode::AUTOMATIC : A::Mode::OFF;
+    A::Picture p;
+    p.pq = picture.color_transfer == AVCOL_TRC_SMPTE2084;
+    p.bt2020 = picture.color_primaries == AVCOL_PRI_BT2020;
+    p.ncl = picture.color_space == AVCOL_SPC_BT2020_NCL;
+    p.interlaced = (picture.iFlags & DVP_FLAG_INTERLACED) != 0;
+    p.stereo = !picture.stereoMode.empty();
+    p.mdl = picture.hasDisplayMetadata && picture.displayMetadata.has_luminance &&
+                    picture.displayMetadata.max_luminance.den
+                ? av_q2d(picture.displayMetadata.max_luminance)
+                : 0.0;
+    p.maxCll = picture.hasLightMetadata ? picture.lightMetadata.MaxCLL : 0.0;
+    A::Display d;
+    d.hdr10Output = m_dvConvertDisplay && m_renderableType == EGL_OPENGL_ES3_BIT;
+    // (the peak set for the mapping to the display where that is on, else the EDID's)
+    const bool mapSet = settings &&
+                        settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) &&
+                        settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) != 0 &&
+                        settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK);
+    d.peakSet = mapSet;
+    d.peak = mapSet ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10PEAK)
+                    : DisplayHdrPeak();
+    m_hdr10Adapt = A::Decide(m_hdr10AdaptMode, p, d);
+    m_hdr10AdaptStats = {};
+    m_hdr10AdaptStats.start = std::chrono::steady_clock::now();
+    // (told where there is something to say: not with the setting off, nor for a video that is not
+    // HDR10)
+    if (m_hdr10Adapt.verdict != A::Verdict::OFF && m_hdr10Adapt.verdict != A::Verdict::NOT_HDR10)
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10 adapted to the display ({}, videoscreen.hadeshdr10adapt): {}; the "
+                "video's peak {} ({}), the display's {} ({}){}",
+                m_hdr10AdaptMode == A::Mode::ALWAYS ? "always" : "automatic",
+                A::Why(m_hdr10Adapt.verdict),
+                m_hdr10Adapt.sourcePeak > 0
+                    ? StringUtils::Format("{:.0f} cd/m2", m_hdr10Adapt.sourcePeak)
+                    : std::string("not given"),
+                m_hdr10Adapt.fromMaxCll ? "its MaxCLL" : "its mastering display",
+                A::Usable(m_hdr10Adapt.displayPeak)
+                    ? StringUtils::Format("{:.0f} cd/m2", m_hdr10Adapt.displayPeak)
+                    : std::string("not given"),
+                d.peakSet ? "set for the mapping to the display" : "of its EDID",
+                picture.hdr10PlusVsif && m_hdr10Adapt.verdict == A::Verdict::ADAPTED
+                    ? "; its HDR10+ metadata are not sent with the mapped picture"
+                    : "");
+  }
+  return m_hdr10Adapt.verdict == HDR10_ADAPT::Verdict::ADAPTED && !m_plainDisabled &&
+         m_dvConvertDisplay;
+}
+
+dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeHdr10AdaptMapping(const VideoPicture& picture)
+{
+  dvbridge_hdr10_mapping mapping{};
+  mapping.enabled = true;
+  mapping.target = DVBRIDGE_HDR10_TARGET_HDR10;
+  mapping.peak = static_cast<float>(m_hdr10Adapt.displayPeak);
+  mapping.gamut = DVBRIDGE_HDR10_GAMUT_BT2020;
+  mapping.curve = DVBRIDGE_HDR10_CURVE_BT2390;
+  // (the gamut and the curve of the mapping to the display where that is on: the same display)
+  const auto settings = SettingsNow();
+  if (settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) &&
+      settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10MAP) != 0)
+  {
+    if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10GAMUT))
+      switch (settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10GAMUT))
+      {
+        case 0: mapping.gamut = DVBRIDGE_HDR10_GAMUT_BT2020; break;
+        case 2: mapping.gamut = DVBRIDGE_HDR10_GAMUT_BT709; break;
+        default: mapping.gamut = DVBRIDGE_HDR10_GAMUT_P3_D65; break;
+      }
+    if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE) &&
+        settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE) != 1)
+      mapping.curve = DVBRIDGE_HDR10_CURVE_SPLINE;
+  }
+  if (picture.hasDisplayMetadata && picture.displayMetadata.has_primaries)
+  {
+    const auto& d = picture.displayMetadata;
+    const AVRational xy[8] = {d.display_primaries[0][0], d.display_primaries[0][1],
+                              d.display_primaries[1][0], d.display_primaries[1][1],
+                              d.display_primaries[2][0], d.display_primaries[2][1],
+                              d.white_point[0],          d.white_point[1]};
+    mapping.source_known = true;
+    for (int i = 0; i < 8; ++i)
+      mapping.source_xy[i] = xy[i].den ? static_cast<float>(av_q2d(xy[i])) : 0.0f;
+    if (!dvbridge_hdr10_mapping_valid(&mapping))
+    {
+      mapping.source_known = false;
+      std::fill(std::begin(mapping.source_xy), std::end(mapping.source_xy), 0.0f);
+    }
+  }
+  if (!dvbridge_hdr10_mapping_valid(&mapping))
+    mapping = dvbridge_hdr10_mapping{};
+  static const char* const gamuts[] = {"BT.2020", "DCI-P3 (D65)", "BT.709"};
+  if (mapping.enabled)
+    CLog::Log(LOGINFO,
+              "DVBridge: an HDR10 picture is adapted to the display: to {:.0f} cd/m2 and {}, with the "
+              "{} curve, guided by the stream's HDR10 metadata; the colours of the source within {}",
+              mapping.peak, gamuts[mapping.gamut],
+              mapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
+              mapping.source_known ? "the gamut of its mastering display"
+                                   : "BT.2020 (its mastering display is not known)");
+  m_dvConvertMapping = mapping;
+  m_dvConvertMappingSet = true;
+  m_dvConvertMappingPlain = true;
+  return mapping;
+}
+
+void CWinSystemGbmGLESContext::Hdr10AdaptTimerMark(bool begin)
+{
+  if (!m_hdr10AdaptTimersMade)
+  {
+    m_hdr10AdaptTimersMade = true;
+    if (IsExtSupported("GL_EXT_disjoint_timer_query"))
+    {
+      if (!m_glGenQueriesEXT)
+        m_glGenQueriesEXT =
+            reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+      if (!m_glDeleteQueriesEXT)
+        m_glDeleteQueriesEXT =
+            reinterpret_cast<PFNGLDELETEQUERIESEXTPROC>(eglGetProcAddress("glDeleteQueriesEXT"));
+      if (!m_glQueryCounterEXT)
+        m_glQueryCounterEXT =
+            reinterpret_cast<PFNGLQUERYCOUNTEREXTPROC>(eglGetProcAddress("glQueryCounterEXT"));
+      if (!m_glGetQueryObjectuivEXT)
+        m_glGetQueryObjectuivEXT = reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(
+            eglGetProcAddress("glGetQueryObjectuivEXT"));
+      if (!m_glGetQueryObjectui64vEXT)
+        m_glGetQueryObjectui64vEXT = reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(
+            eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    }
+    if (m_glGenQueriesEXT && m_glDeleteQueriesEXT && m_glQueryCounterEXT &&
+        m_glGetQueryObjectuivEXT && m_glGetQueryObjectui64vEXT)
+      for (auto& timer : m_hdr10AdaptTimers)
+      {
+        m_glGenQueriesEXT(1, &timer.begin);
+        m_glGenQueriesEXT(1, &timer.end);
+      }
+  }
+  auto& timer = m_hdr10AdaptTimers[m_hdr10AdaptTimerIndex];
+  if (!timer.begin || !timer.end)
+    return;
+  if (begin)
+  {
+    if (timer.pending)
+      return; // (its result is not back yet: this picture is not timed)
+    m_glQueryCounterEXT(timer.begin, GL_TIMESTAMP_EXT);
+    timer.begun = true;
+  }
+  else if (timer.begun)
+  {
+    m_glQueryCounterEXT(timer.end, GL_TIMESTAMP_EXT);
+    timer.begun = false;
+    timer.pending = true;
+    m_hdr10AdaptTimerIndex = (m_hdr10AdaptTimerIndex + 1) % m_hdr10AdaptTimers.size();
+  }
+}
+
+void CWinSystemGbmGLESContext::Hdr10AdaptTimerCollect()
+{
+  if (!m_glGetQueryObjectuivEXT || !m_hdr10AdaptTimers[0].begin)
+    return;
+  // (reading the disjoint state clears it; a disjoint period makes the results in flight useless)
+  GLint disjoint = 0;
+  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  for (size_t n = 0; n < m_hdr10AdaptTimers.size(); ++n)
+  {
+    auto& timer = m_hdr10AdaptTimers[(m_hdr10AdaptTimerIndex + n) % m_hdr10AdaptTimers.size()];
+    if (!timer.pending)
+      continue;
+    GLuint available = 0;
+    m_glGetQueryObjectuivEXT(timer.end, GL_QUERY_RESULT_AVAILABLE_EXT, &available);
+    if (!available)
+      break;
+    timer.pending = false;
+    GLuint64 start = 0, finish = 0;
+    m_glGetQueryObjectui64vEXT(timer.begin, GL_QUERY_RESULT_EXT, &start);
+    m_glGetQueryObjectui64vEXT(timer.end, GL_QUERY_RESULT_EXT, &finish);
+    if (disjoint || finish <= start)
+      continue;
+    const double ms = static_cast<double>(finish - start) / 1e6;
+    m_hdr10AdaptStats.timed++;
+    m_hdr10AdaptStats.gpuSumMs += ms;
+    m_hdr10AdaptStats.gpuMaxMs = std::max(m_hdr10AdaptStats.gpuMaxMs, ms);
+  }
+}
+
+void CWinSystemGbmGLESContext::Hdr10AdaptStatsLog(bool end)
+{
+  const auto now = std::chrono::steady_clock::now();
+  auto& s = m_hdr10AdaptStats;
+  if (!end && now - s.start < std::chrono::seconds(10))
+    return;
+  if (s.mapped || s.kept || s.notMapped)
