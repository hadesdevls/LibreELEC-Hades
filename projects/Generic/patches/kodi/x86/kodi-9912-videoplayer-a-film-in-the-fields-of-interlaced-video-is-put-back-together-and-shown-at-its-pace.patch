+// Hades: the picture that goes into the graph of a film in its fields, against the one before it
+// (KODI::FIELDCADENCE::CCadenceWatch): where the film's cadence breaks for longer than a cut (video
+// in the title) and where it comes back is said in the log, the first 20 times
+void CDVDVideoCodecFFmpeg::WatchFilmCadence(const AVFrame& frame)
+{
+  using namespace KODI::FIELDCADENCE;
+  static constexpr int MAX_LINES = 20;
+  if (!m_filmWatch || !frame.data[0] || frame.width < 16 || frame.height < 16 ||
+      av_pix_fmt_desc_get(static_cast<AVPixelFormat>(frame.format)) == nullptr ||
+      av_pix_fmt_desc_get(static_cast<AVPixelFormat>(frame.format))->comp[0].depth != 8)
+    return;
+  const size_t size = static_cast<size_t>(frame.width) * frame.height;
+  const bool interlaced = (frame.flags & AV_FRAME_FLAG_INTERLACED) != 0;
+  const bool topFirst = !interlaced || (frame.flags & AV_FRAME_FLAG_TOP_FIELD_FIRST) != 0;
+  if (m_filmBefore.size() == size)
+  {
+    const Plane before{m_filmBefore.data(), frame.width, frame.width, frame.height};
+    const Plane now{frame.data[0], frame.linesize[0], frame.width, frame.height};
+    const int change = m_filmWatch->Add(LabelOf(Measure(before, now, topFirst), interlaced));
+    if (change != 0 && m_filmWatchLines < MAX_LINES)
+    {
+      ++m_filmWatchLines;
+      const double seconds = frame.best_effort_timestamp != AV_NOPTS_VALUE
+                                 ? static_cast<double>(frame.best_effort_timestamp) / AV_TIME_BASE
+                                 : -1.0;
+      if (change < 0)
+        CLog::Log(LOGINFO,
+                  "CDVDVideoCodecFFmpeg - the cadence of the {} stopped at {:.1f} s (video, or a "
+                  "stretch edited as video): its frames are deinterlaced one by one, at the "
+                  "film's rate",
+                  NameOf(m_hints.filmCadence), seconds);
+      else
+        CLog::Log(LOGINFO,
+                  "CDVDVideoCodecFFmpeg - the cadence of the {} is back at {:.1f} s: its pictures "
+                  "are put back together again",
+                  NameOf(m_hints.filmCadence), seconds);
+    }
+  }
+  m_filmBefore.resize(size);
+  for (int y = 0; y < frame.height; ++y)
+    std::copy(frame.data[0] + static_cast<ptrdiff_t>(y) * frame.linesize[0],
+              frame.data[0] + static_cast<ptrdiff_t>(y) * frame.linesize[0] + frame.width,
+              m_filmBefore.data() + static_cast<size_t>(y) * frame.width);
+}
