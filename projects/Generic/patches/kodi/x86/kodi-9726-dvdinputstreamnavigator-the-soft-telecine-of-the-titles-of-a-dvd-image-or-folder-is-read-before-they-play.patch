+#pragma once
+
+#include "FileItem.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <thread>
+
+/*!
+ * \brief (Hades) Reads the first video of the titles of a DVD, with a navigator of its own, to tell
+ *        which ones are films with soft telecine (DiscSoftTelecine.h)
+ *
+ * Started when the player's navigator has opened the disc, on a second navigator on the same image
+ * or folder (nothing is shared with the first one: not the virtual machine, not the reads). It takes
+ * the titles of at least two minutes, the longest twelve, and plays each from its start until the
+ * cadence is known or a limit is reached. The player asks, when a title starts, what was found for
+ * it, and waits a little if that title is being read now.
+ */
+class CDiscSoftTelecineScan
+{
+public:
+  enum class State
+  {
+    UNKNOWN, //!< not read, not readable, or not enough to tell
+    FILM,
+    NOT_FILM,
+  };
+
+  CDiscSoftTelecineScan(const CFileItem& item, std::string path, bool image);
+  ~CDiscSoftTelecineScan();
+
+  void Start();
+  //! \brief Stop and wait for the thread (the disc is closed, or the player ends)
+  void Stop();
+
+  /*!
+   * \brief What was found for a title
+   * \param title the number of the title as libdvdnav counts them
+   * \param wait how long to wait, at the most, if the title has not been read yet but will be
+   */
+  State Get(int title, std::chrono::milliseconds wait);
+
+private:
+  void Run();
+
+  CFileItem m_item;
+  std::string m_path;
+  bool m_image;
+  std::thread m_thread;
+  std::atomic<bool> m_stop{false};
+  std::mutex m_mutex;
+  std::condition_variable m_changed;
+  bool m_planned = false; //!< which titles will be read is known
+  bool m_finished = false;
+  std::set<int> m_plan;
+  std::map<int, State> m_results;
+};
