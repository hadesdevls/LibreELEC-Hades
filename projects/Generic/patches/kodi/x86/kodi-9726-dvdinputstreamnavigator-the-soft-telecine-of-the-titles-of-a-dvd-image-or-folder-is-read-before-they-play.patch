+  const CSoftTelecineDetector::Verdict verdict = detector.GetVerdict();
 
   if (verdict == CSoftTelecineDetector::Verdict::FILM)
   {
@@ -2386,6 +2440,8 @@ DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
       if (stream && stream->codec == AV_CODEC_ID_H264)
         pPacket->recoveryPoint = m_seekToKeyFrame;
