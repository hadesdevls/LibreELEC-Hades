+// Hades: the player's navigator knows, when a title starts, whether it was read as soft telecined film
+// (CDiscSoftTelecineScan). Told here, at the first picture of the title, before the player has
+// opened its video: the stream says 23.976, not interlaced, and the mode is chosen for it once.
+void CDVDDemuxFFmpeg::ApplyDiscSoftTelecine(CDemuxStream* stream)
+{
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (!video || !m_pInput || !m_pInput->IsStreamType(DVDSTREAM_TYPE_DVD))
+    return;
+  const auto navigator = std::dynamic_pointer_cast<CDVDInputStreamNavigator>(m_pInput);
+  if (!navigator)
+    return;
+  unsigned int generation = 0;
+  int film = navigator->GetSoftTelecine(generation, std::chrono::milliseconds(0));
+  if (generation == m_discSoftTelecineGeneration)
+    return;
+  if (film < 0)
+  {
+    // not read yet: wait a little, once for this title (the reading goes on in the background)
+    film = navigator->GetSoftTelecine(generation, std::chrono::milliseconds(1500));
+  }
+  m_discSoftTelecineGeneration = generation;
+  const bool wanted = film == 1;
+  if (wanted == video->softTelecine)
+    return;
+  if (wanted)
+  {
+    m_discStream = {true, video->iFpsRate, video->iFpsScale, video->interlaced};
+    video->iFpsRate = 24000;
+    video->iFpsScale = 1001;
+    video->interlaced = false;
+    video->softTelecine = true;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: this DVD title is MPEG-2 video with soft telecine (the pictures of a "
+              "film at 23.976 that carry the flags to be shown at 29.97, as read before it started): "
+              "each is shown once, at the pace of the film");
+  }
+  else
+  {
+    if (m_discStream.saved)
+    {
+      video->iFpsRate = m_discStream.fpsRate;
+      video->iFpsScale = m_discStream.fpsScale;
+      video->interlaced = m_discStream.interlaced;
+    }
+    video->softTelecine = false;
+    CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: this title is shown as the stream says");
+  }
+  ++video->changes;
+}
+
