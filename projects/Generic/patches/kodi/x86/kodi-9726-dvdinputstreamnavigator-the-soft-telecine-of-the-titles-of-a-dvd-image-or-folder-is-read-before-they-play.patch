+#pragma once
+
+#include "cores/VideoPlayer/DVDDemuxers/Mpeg2SoftTelecine.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+/*!
+ * \file DiscSoftTelecine.h
+ * \brief (Hades) Soft telecine of a DVD title, read from its first video before it is played
+ *
+ * A disc cannot be read ahead from the demuxer: its navigation (menus, stills, a change of title
+ * set) runs inside the reads of the player. The titles are therefore read by a navigator of their
+ * own, on a copy of the disc that nothing else uses (CDiscSoftTelecineScan), which plays each title
+ * from its start, takes the video of the program stream and gives its picture headers to
+ * KODI::MPEG2::CSoftTelecineDetector, with no decoding. The player's navigator only asks, when a
+ * title starts, what was found for it.
+ *
+ * Nothing here depends on Kodi or on a library: the navigator is a template parameter, so that the
+ * same file is tested outside of Kodi against libdvdnav and authored discs.
+ */
+
+namespace KODI::DISC
+{
+/*!
+ * \brief The video elementary stream of the DVD sectors that are added
+ *
+ * A sector of a DVD is 2048 bytes: a pack header, and packets (a system header, the navigation
+ * packet, audio, subpictures, video). The payload of the packets of the video stream (0xE0 to
+ * 0xEF, the first one seen) is kept, in the order it comes in.
+ */
+class CVideoCollector
+{
+public:
+  void AddSector(const uint8_t* s, size_t size)
+  {
+    size_t i = 0;
+    if (size < 14 || s[0] != 0 || s[1] != 0 || s[2] != 1 || s[3] != 0xBA)
+      return;
+    i = 14 + (s[13] & 7); // pack header (MPEG-2: 14 bytes and the stuffing)
+    while (i + 6 <= size)
+    {
+      if (s[i] != 0 || s[i + 1] != 0 || s[i + 2] != 1)
+        return;
+      const uint8_t id = s[i + 3];
+      const size_t length = (static_cast<size_t>(s[i + 4]) << 8) | s[i + 5];
+      const size_t end = std::min(size, i + 6 + length);
+      if (id >= 0xE0 && id <= 0xEF && (m_id == 0 || m_id == id) && i + 9 <= end)
+      {
+        m_id = id;
+        const size_t payload = i + 9 + s[i + 8];
+        if (payload < end)
+          m_video.insert(m_video.end(), s + payload, s + end);
+      }
+      i = i + 6 + length;
+    }
+  }
+
+  const std::vector<uint8_t>& Video() const { return m_video; }
+
+private:
+  std::vector<uint8_t> m_video;
+  uint8_t m_id = 0;
+};
+
+//! \brief What was found of a title
+struct TitleResult
+{
+  MPEG2::CSoftTelecineDetector::Verdict verdict = MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN;
+  size_t pictures = 0; //!< pictures that were read
+  size_t videoBytes = 0;
+  bool outOfBudget = false; //!< stopped by a limit, with no verdict
+};
+
+//! \brief What the picture headers of a stretch of video say
+inline MPEG2::CSoftTelecineDetector::Verdict VerdictOfVideo(const std::vector<uint8_t>& video,
+                                                            size_t* pictures = nullptr)
+{
+  MPEG2::CSoftTelecineDetector detector;
+  bool progressiveSequence = false;
+  std::vector<MPEG2::PictureFlags> found;
+  MPEG2::ParsePictures(video.data(), video.size(), progressiveSequence, found);
+  // Only the groups of pictures that are complete count: the end of what was read is in the middle of
+  // one, whose last pictures (in display order) are not there, and which would look like a break
+  // in the cadence.
+  MPEG2::CSoftTelecineDetector::Verdict verdict = detector.GetVerdict();
+  for (const MPEG2::PictureFlags& p : found)
+    verdict = detector.Add(p);
+  if (pictures)
+    *pictures = detector.Count();
+  return verdict;
+}
+
+/*!
+ * \brief Reads the start of a title with a navigator and tells whether its video is soft telecine
+ *
+ * \tparam Nav needs: `bool Play(int title)`; `Nav::Event Next(const uint8_t*& data, int& size)` that
+ *         returns Nav::Event::BLOCK for a sector (2048 bytes), STILL or WAIT for a still frame or a
+ *         wait (they are skipped with `Skip()`), STOP or ERROR to end, and anything else for an event
+ *         that does not matter; `void Skip()`.
+ * \param stop called often: true to give up (the disc is closed)
+ */
+template<class Nav, class Stop>
+TitleResult ScanTitle(Nav& nav, int title, Stop&& stop)
+{
+  static constexpr size_t MAX_VIDEO_BYTES = 3 * 1024 * 1024; //!< of video read
+  static constexpr size_t CHECK_EVERY = 256 * 1024;
+  static constexpr unsigned MAX_EVENTS = 4000; //!< that are not sectors (a menu that never ends)
+  static constexpr auto MAX_TIME = std::chrono::seconds(4);
+
+  TitleResult result;
+  if (!nav.Play(title))
+    return result;
+  CVideoCollector collector;
+  const auto begin = std::chrono::steady_clock::now();
+  size_t checked = 0;
+  unsigned events = 0;
+  for (;;)
+  {
+    if (stop() || std::chrono::steady_clock::now() - begin > MAX_TIME ||
+        collector.Video().size() >= MAX_VIDEO_BYTES || events > MAX_EVENTS)
+    {
+      result.outOfBudget = true;
+      break;
+    }
+    const uint8_t* data = nullptr;
+    int size = 0;
+    const auto ev = nav.Next(data, size);
+    if (ev == Nav::Event::BLOCK)
+    {
+      collector.AddSector(data, static_cast<size_t>(size));
+      if (collector.Video().size() >= checked + CHECK_EVERY)
+      {
+        checked = collector.Video().size();
+        if (VerdictOfVideo(collector.Video()) != MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN)
+          break;
+      }
+    }
+    else if (ev == Nav::Event::STOP || ev == Nav::Event::ERROR)
+      break;
+    else
+    {
+      ++events;
+      if (ev == Nav::Event::STILL || ev == Nav::Event::WAIT)
+        nav.Skip();
+    }
+  }
+  result.videoBytes = collector.Video().size();
+  result.verdict = VerdictOfVideo(collector.Video(), &result.pictures);
+  if (result.verdict != MPEG2::CSoftTelecineDetector::Verdict::UNKNOWN)
+    result.outOfBudget = false;
+  return result;
+}
+} // namespace KODI::DISC
