+int CDVDInputStreamNavigator::GetSoftTelecine(unsigned int& generation,
+                                              std::chrono::milliseconds wait)
+{
+  generation = m_softTelecineGeneration;
+  if (!m_softTelecineScan || m_iTitle <= 0 || m_bInMenu)
+    return 0;
+  switch (m_softTelecineScan->Get(m_iTitle, wait))
+  {
+    case CDiscSoftTelecineScan::State::FILM:
+      return 1;
+    case CDiscSoftTelecineScan::State::NOT_FILM:
+      return 0;
+    default:
+      return -1;
+  }
+}
