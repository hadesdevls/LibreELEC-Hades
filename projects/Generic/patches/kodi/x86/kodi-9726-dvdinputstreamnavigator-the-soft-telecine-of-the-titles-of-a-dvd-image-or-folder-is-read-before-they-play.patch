+
+#include <algorithm>
+#include <cstdlib>
+#include <utility>
+#include <vector>
+
+namespace
+{
+using KODI::MPEG2::CSoftTelecineDetector;
+
+constexpr uint64_t MIN_TITLE_TICKS = 120ULL * 90000ULL; // two minutes, in 90 kHz ticks
+constexpr size_t MAX_TITLES = 12;
+
+// the reads of an image, as the player's navigator does them (its callbacks are private to it)
+int cbSeek(void* stream, uint64_t pos)
+{
+  return static_cast<CDVDInputStreamFile*>(stream)->Seek(pos, SEEK_SET) >= 0 ? 0 : -1;
+}
+
+int cbRead(void* stream, void* buffer, int count)
+{
+  auto* file = static_cast<CDVDInputStreamFile*>(stream);
+  int done = 0;
+  while (done < count)
+  {
+    const int r = file->Read(static_cast<uint8_t*>(buffer) + done, count - done);
+    if (r < 0)
+      return r;
+    if (r == 0)
+      break;
+    done += r;
+  }
+  return done;
+}
+
+// what libdvdnav's reads of the second navigator say goes to the log at debug level
+#if DVDNAV_VERSION >= 60100
+void cbLog(void* /*priv*/, dvdnav_logger_level_t /*level*/, const char* fmt, va_list va)
+{
+  char text[512];
+  vsnprintf(text, sizeof(text), fmt, va);
+  CLog::Log(LOGDEBUG, "CDiscSoftTelecineScan: libdvdnav: {}", text);
+}
+#endif
+
+//! The navigator that DiscSoftTelecine.h reads a title with
+struct Nav
+{
+  enum class Event
+  {
+    BLOCK,
+    STILL,
+    WAIT,
+    STOP,
+    ERROR,
+    OTHER,
+  };
+
+  DllDvdNav& dll;
+  dvdnav_t* nav;
+  uint8_t block[DVD_VIDEO_LB_LEN];
+
+  bool Play(int title) { return dll.dvdnav_title_play(nav, title) == DVDNAV_STATUS_OK; }
+
+  Event Next(const uint8_t*& data, int& size)
+  {
+    int32_t event = 0;
+    int32_t length = 0;
+    if (dll.dvdnav_get_next_block(nav, block, &event, &length) != DVDNAV_STATUS_OK)
+      return Event::ERROR;
+    data = block;
+    size = length;
+    switch (event)
+    {
+      case DVDNAV_BLOCK_OK:
+        return Event::BLOCK;
+      case DVDNAV_STILL_FRAME:
+        return Event::STILL;
+      case DVDNAV_WAIT:
+        return Event::WAIT;
+      case DVDNAV_STOP:
+        return Event::ERROR;
+      default:
+        return Event::OTHER;
+    }
+  }
+
+  void Skip()
+  {
+    dll.dvdnav_still_skip(nav);
+    dll.dvdnav_wait_skip(nav);
+  }
+};
+} // namespace
+
+CDiscSoftTelecineScan::CDiscSoftTelecineScan(const CFileItem& item, std::string path, bool image)
+  : m_item(item), m_path(std::move(path)), m_image(image)
+{
+}
+
+CDiscSoftTelecineScan::~CDiscSoftTelecineScan()
+{
+  Stop();
+}
+
+void CDiscSoftTelecineScan::Start()
+{
+  if (!m_thread.joinable())
+    m_thread = std::thread([this] { Run(); });
+}
+
+void CDiscSoftTelecineScan::Stop()
+{
+  m_stop = true;
+  m_changed.notify_all();
+  if (m_thread.joinable())
+    m_thread.join();
+}
+
+CDiscSoftTelecineScan::State CDiscSoftTelecineScan::Get(int title,
+                                                        std::chrono::milliseconds wait)
+{
+  std::unique_lock lock(m_mutex);
+  const auto known = [&] { return m_results.contains(title) || m_finished || m_stop; };
+  const auto expected = [&] { return !m_planned || m_plan.contains(title); };
+  if (!known() && expected() && wait.count() > 0)
+    m_changed.wait_for(lock, wait, [&] { return known() || (m_planned && !m_plan.contains(title)); });
+  const auto it = m_results.find(title);
+  return it == m_results.end() ? State::UNKNOWN : it->second;
+}
+
+void CDiscSoftTelecineScan::Run()
+{
+  using clock = std::chrono::steady_clock;
+  const auto begin = clock::now();
+
+  DllDvdNav dll;
+  dvdnav_t* nav = nullptr;
+  std::unique_ptr<CDVDInputStreamFile> stream;
+  dvdnav_stream_cb callbacks{};
+  callbacks.pf_read = cbRead;
+  callbacks.pf_seek = cbSeek;
+
+  const auto finish = [&]
+  {
+    if (nav)
+      dll.dvdnav_close(nav);
+    if (stream)
+      stream->Close();
+    std::lock_guard lock(m_mutex);
+    m_planned = true;
+    m_finished = true;
+    m_changed.notify_all();
+  };
+
+  if (!dll.Load())
+    return finish();
+  if (m_image)
+  {
+    stream = std::make_unique<CDVDInputStreamFile>(m_item, XFILE::READ_TRUNCATED | XFILE::READ_BITRATE);
+    if (!stream->Open())
+      return finish();
+#if DVDNAV_VERSION >= 60100
+    dvdnav_logger_cb logger;
+    logger.pf_log = cbLog;
+    if (dll.dvdnav_open_stream2(&nav, stream.get(), &logger, &callbacks) != DVDNAV_STATUS_OK)
+#else
+    if (dll.dvdnav_open_stream(&nav, stream.get(), &callbacks) != DVDNAV_STATUS_OK)
+#endif
+      return finish();
+  }
+  else
+  {
+#if DVDNAV_VERSION >= 60100
+    dvdnav_logger_cb logger;
+    logger.pf_log = cbLog;
+    if (dll.dvdnav_open2(&nav, nullptr, &logger, m_path.c_str()) != DVDNAV_STATUS_OK)
+#else
+    if (dll.dvdnav_open(&nav, m_path.c_str()) != DVDNAV_STATUS_OK)
+#endif
+      return finish();
+  }
+
+  int32_t mask = 0;
+  if (dll.dvdnav_get_disk_region_mask(nav, &mask) == DVDNAV_STATUS_ERR || mask == 0)
+    mask = 0xff;
+  dll.dvdnav_set_region_mask(nav, mask);
+  dll.dvdnav_set_readahead_flag(nav, 0);
+
+  int32_t count = 0;
+  dll.dvdnav_get_number_of_titles(nav, &count);
+  std::vector<std::pair<uint64_t, int>> titles; // duration, number
+  for (int t = 1; t <= count && t <= 99 && !m_stop; ++t)
+  {
+    uint64_t* times = nullptr;
+    uint64_t duration = 0;
+    dll.dvdnav_describe_title_chapters(nav, t, &times, &duration);
+    free(times);
+    if (duration >= MIN_TITLE_TICKS)
+      titles.emplace_back(duration, t);
+  }
+  std::sort(titles.begin(), titles.end(), [](const auto& a, const auto& b) { return a > b; });
+  if (titles.size() > MAX_TITLES)
+    titles.resize(MAX_TITLES);
+  {
+    std::lock_guard lock(m_mutex);
+    for (const auto& title : titles)
+      m_plan.insert(title.second);
+    m_planned = true;
+    m_changed.notify_all();
+  }
+
+  Nav reader{dll, nav, {}};
+  size_t films = 0;
+  for (const auto& title : titles)
+  {
+    if (m_stop)
+      break;
+    const KODI::DISC::TitleResult r =
+        KODI::DISC::ScanTitle(reader, title.second, [this] { return m_stop.load(); });
+    State state = State::UNKNOWN;
+    if (r.verdict == CSoftTelecineDetector::Verdict::FILM)
+      state = State::FILM;
+    else if (r.verdict == CSoftTelecineDetector::Verdict::NOT_FILM)
+      state = State::NOT_FILM;
+    films += state == State::FILM;
+    CLog::Log(LOGDEBUG,
+              "CDiscSoftTelecineScan: title {} ({:.0f} s): {} after {} pictures, {} bytes of video{}",
+              title.second, static_cast<double>(title.first) / 90000.0,
+              state == State::FILM       ? "soft telecine"
+              : state == State::NOT_FILM ? "not soft telecine"
+                                         : "not told",
+              r.pictures, r.videoBytes, r.outOfBudget ? " (a limit was reached)" : "");
+    std::lock_guard lock(m_mutex);
+    m_results[title.second] = state;
+    m_changed.notify_all();
+  }
+  CLog::Log(LOGINFO,
+            "CDiscSoftTelecineScan: {} of the {} titles of two minutes or more read in {} ms: {} "
+            "with soft telecine",
+            m_results.size(), titles.size(),
+            std::chrono::duration_cast<std::chrono::milliseconds>(clock::now() - begin).count(),
+            films);
+  finish();
+}
