--- a/xbmc/filesystem/CMakeLists.txt
+++ b/xbmc/filesystem/CMakeLists.txt
@@ -164,7 +164,8 @@ if(TARGET ${APP_NAME_LC}::Bluray)
 		      BlurayDiscCache.h
                       BlurayDirectory.h
                       BlurayFile.h
-                      BlurayJava.h)
+                      BlurayJava.h
+                      BlurayLog.h)
 endif()
 
 if(ENABLE_OPTICAL)
