From 3834183625ef1e55a1c41fb59ee8241ffd5554ae Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 02:22:17 +0000
Subject: [PATCH] [Blu-ray] Which lines of libbluray kodi.log shows without
 debug logging

The commit before sent every line of the BD-J service to LOGINFO. Measured with a test disc and
the debug mask that Kodi sets (DBG_CRIT | DBG_BLURAY | DBG_NAV), the service reports 84 lines for
it, and half of them are libbluray's core: the registers it sets (13), its start (11), the files
it does not find. In Kodi's own process those are debug, and so they are now from the service.

KODI::BLURAYLOG::IsInfoLine() (BlurayLog.h) decides it in one place. To the log go: the lines of
bdj.c, of the client of the BD-J service (bdr_*.c) and those of bluray.c that speak of BD-J, in
Kodi's process; in the service (the lines "bdj-host:0: ..."), the same files, libbluray's native
BD-J code, and every line of Java, which is the Java part of libbluray and the disc's own code
through it; and each BD-Live line from either side. Before, the client's lines in Kodi's process
("The isolated BD-J host could not start this disc", "BD-J host: ...") were debug too, because
only bdj.c counted.

A test on the host checks the rule on 30 lines taken from the logs of the BD-J service tests and
of issue #1, and fails when the rule for Java, for the BD-J lines of bluray.c or for libbluray's
core is changed.
---
 xbmc/filesystem/BlurayCallback.cpp | 17 +++-----
 xbmc/filesystem/BlurayLog.h        | 63 ++++++++++++++++++++++++++++++
 xbmc/filesystem/CMakeLists.txt     |  3 +-
 3 files changed, 71 insertions(+), 12 deletions(-)
 create mode 100644 xbmc/filesystem/BlurayLog.h

diff --git a/xbmc/filesystem/BlurayCallback.cpp b/xbmc/filesystem/BlurayCallback.cpp
index 4d6c2cf..1fc8d6b 100644
--- a/xbmc/filesystem/BlurayCallback.cpp
+++ b/xbmc/filesystem/BlurayCallback.cpp
@@ -8,6 +8,8 @@
 
 #include "BlurayCallback.h"
 
+#include "BlurayLog.h"
+
 #include "FileItem.h"
 #include "FileItemList.h"
 #include "filesystem/Directory.h"
@@ -80,17 +82,10 @@ bool InsideDisc(const std::string& root, const std::string& path, std::string& o
 
 void CBlurayCallback::bluray_logger(const char* msg)
 {
-  // Hades: libbluray says whether Blu-ray Java (BD-J) menus can run, and why not, only in lines
-  // of bdj.c, and with the mask that Kodi sets (DBG_CRIT | DBG_BLURAY | DBG_NAV) only the
-  // critical ones of that file reach here: a few per disc. They answer "why is there no menu",
-  // so they go to the log without debug logging.
-  // BD-Live: each name and connection, allowed or refused (libbluray and the BD-J service).
-  // The BD-J service: its lines (bdj-host:) are libbluray's critical ones there (the service takes
-  // Kodi's debug mask), at most 100 a second (its client in libbluray drops the rest and says how
-  // many); they are what says why the Java of a disc stopped or waits, and nothing else does.
-  const bool bdj = msg && (std::string_view(msg).starts_with("bdj.c:") ||
-                           std::string_view(msg).starts_with("bdj-host:") ||
-                           std::string_view(msg).find("BD-Live: ") != std::string_view::npos);
+  // Hades: what says whether the Java (BD-J) menus of a disc run, and why not, in Kodi's process
+  // and in the BD-J service, and BD-Live, goes to the log without debug logging; libbluray's other
+  // lines stay debug (KODI::BLURAYLOG::IsInfoLine())
+  const bool bdj = msg && KODI::BLURAYLOG::IsInfoLine(msg);
   CLog::Log(bdj ? LOGINFO : LOGDEBUG, "CBlurayCallback::Logger - {}", msg);
 }
 
diff --git a/xbmc/filesystem/BlurayLog.h b/xbmc/filesystem/BlurayLog.h
new file mode 100644
index 0000000..624defe
--- /dev/null
+++ b/xbmc/filesystem/BlurayLog.h
@@ -0,0 +1,63 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <string_view>
+
+namespace KODI
+{
+namespace BLURAYLOG
+{
+
+/*!
+ * \brief Whether a line of libbluray goes to kodi.log without debug logging (LOGINFO) or only with
+ *        it (LOGDEBUG). With the mask that Kodi sets (DBG_CRIT | DBG_BLURAY | DBG_NAV) libbluray
+ *        reports a few dozen lines for each disc; most of them (the registers it sets, the files it
+ *        opens) are for debugging, and stay so. What says whether the Java (BD-J) menus of a disc
+ *        run, and why not, goes to the log:
+ *        - Kodi's own process: the lines of bdj.c, of the client of the BD-J service (bdr_*.c),
+ *          and those of bluray.c that speak of BD-J;
+ *        - the BD-J service ("bdj-host:0: <source>:<line>: ..."): the same files there, libbluray's
+ *          native BD-J code (java_awt_*, org_videolan_*, the sandbox), and every line of Java (the
+ *          Java part of libbluray, and the disc's own code through it); not libbluray's core;
+ *        - BD-Live: each name and connection, from either side.
+ *        The service sends at most 100 lines a second (its client drops the rest and says how
+ *        many).
+ */
+inline bool IsInfoLine(std::string_view msg)
+{
+  const auto starts = [](std::string_view s, std::string_view p) { return s.substr(0, p.size()) == p; };
+  const auto bdjSource = [&](std::string_view line) {
+    if (starts(line, "bdj") || starts(line, "bdr_") || starts(line, "java_awt_") ||
+        starts(line, "org_videolan_") || starts(line, "hades_bdj"))
+      return true;
+    return starts(line, "bluray.c:") && line.find("BD-J") != std::string_view::npos;
+  };
+
+  if (msg.find("BD-Live: ") != std::string_view::npos)
+    return true;
+
+  constexpr std::string_view host = "bdj-host:";
+  if (!starts(msg, host))
+    return bdjSource(msg);
+
+  // the service: "bdj-host:0: " and then a line as libbluray writes it there
+  const size_t sep = msg.find(": ");
+  if (sep == std::string_view::npos)
+    return true;
+  const std::string_view line = msg.substr(sep + 2);
+  const std::string_view source = line.substr(0, line.find(':'));
+  // Java ("org.videolan.Libbluray", "BDJSocketImpl.java"...), never a C file
+  if (source.size() < 2 || source.substr(source.size() - 2) != ".c")
+    return true;
+  return bdjSource(line);
+}
+
+} // namespace BLURAYLOG
+} // namespace KODI
