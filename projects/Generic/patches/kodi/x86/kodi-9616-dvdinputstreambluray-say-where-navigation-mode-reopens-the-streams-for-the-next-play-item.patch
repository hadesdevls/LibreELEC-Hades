From 10513740ce6bc2d3a597551e7e2f5acce528dedb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:18:24 +0000
Subject: [PATCH] DVDInputStreamBluray: say where navigation mode reopens the
 streams for the next play item

In navigation mode (the disc's menus) BD_EVENT_PLAYITEM holds the read, and
the player then closes the demuxer and both stream players and opens them
again: a pause in picture and sound at every play item, also where the
playlist joins two of them seamlessly. Nothing in kodi.log said so without
debug logging. When the play item that comes is the next one of the
playlist, it is now said, so that the log of a test with a disc shows how
often a film played from its menus pauses there. Nothing else changes.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp           | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 6486c16..05e9bbf 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -857,6 +857,16 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
         case BD_EVENT_PLAYITEM:
           if(m_hold != HOLD_DATA)
           {
+            // Hades: the next play item of the playlist is played as any other change here: the
+            // player closes its streams and opens them again, also where the playlist joins the
+            // two seamlessly (a pause in picture and sound at the join), said for the logs
+            if (m_event.event == BD_EVENT_PLAYITEM && m_titleInfo &&
+                m_event.param == m_playItem + 1 && m_event.param < m_titleInfo->clip_count)
+              CLog::Log(LOGINFO,
+                        "CDVDInputStreamBluray - play item {} (clip {}) follows play item {} of "
+                        "playlist {}: in navigation mode the player reopens its streams for it",
+                        m_event.param, m_titleInfo->clips[m_event.param].clip_id, m_event.param - 1,
+                        m_playlist);
             m_hold = HOLD_HELD;
             return result;
           }
