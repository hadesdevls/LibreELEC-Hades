From 5d088e7d3d2026f5d437805fc268b7b3e98a800c Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Wed, 21 Oct 2026 08:41:16 +0100
Subject: [PATCH] [guiinfo] Lock the GUI while finding the current list item

Add-ons read list item labels from their own threads, as skin helper
services do while they poll. Finding the item looks up the window and
its view controls, which the main thread can be replacing at the same
time, so a window change during the lookup could crash Kodi in
CGUIControlLookup::GetControl().
---
 xbmc/guilib/guiinfo/GUIInfoHelper.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/xbmc/guilib/guiinfo/GUIInfoHelper.cpp b/xbmc/guilib/guiinfo/GUIInfoHelper.cpp
index 26c2fe1..e25e9c2 100644
--- a/xbmc/guilib/guiinfo/GUIInfoHelper.cpp
+++ b/xbmc/guilib/guiinfo/GUIInfoHelper.cpp
@@ -21,6 +21,8 @@
 #include "resources/ResourcesComponent.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
+#include "windowing/GraphicContext.h"
+#include "windowing/WinSystem.h"
 #include "windows/GUIMediaWindow.h"
 
 namespace KODI::GUILIB::GUIINFO
@@ -163,6 +165,10 @@ std::shared_ptr<CGUIListItem> GetCurrentListItem(int contextWindow,
                                                  int itemOffset /* = 0 */,
                                                  unsigned int itemFlags /* = 0 */)
 {
+  // Add-ons ask for list items from their own threads, and the window and its
+  // controls can change under them unless the GUI is locked
+  std::unique_lock lock(CServiceBroker::GetWinSystem()->GetGfxContext());
+
   std::shared_ptr<CGUIListItem> item;
 
   if (containerId == 0 && itemOffset == 0 && !(itemFlags & INFOFLAG_LISTITEM_CONTAINER) &&
-- 
