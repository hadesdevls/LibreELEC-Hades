       if (!SwapOutputBuffers())
       {
         CEGLUtils::Log(LOGERROR, "eglSwapBuffers failed");
@@ -1060,6 +1062,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
     int lagFd = -1; // (Hades: the out-fence of the frame before, to read when it flipped)
     if (rendered)
     {
+      // Hades: before the fence of the frame, which stands for all of its GPU work
+      ClearStereoGap();
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
       if (async)
       {
@@ -1205,6 +1209,33 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   SendDisplayReset();
 }
 
+void CWinSystemGbmGLESContext::ClearStereoGap()
+{
+  auto& gfx = GetGfxContext();
+  const RenderStereoMode mode = gfx.GetStereoMode();
+  if (mode != RenderStereoMode::SPLIT_HORIZONTAL && mode != RenderStereoMode::SPLIT_VERTICAL)
+    return;
+  // one eye, as CGraphicContext::StereoCorrection() places the eyes
+  const RESOLUTION_INFO eye = gfx.GetResInfo();
+  const bool topAndBottom = mode == RenderStereoMode::SPLIT_HORIZONTAL;
+  const auto gap = STEREO_GAP::GapOf(topAndBottom, !topAndBottom, eye.iWidth, eye.iHeight,
+                                     eye.iBlanking, m_width, m_height);
+  if (!gap)
+    return;
+  STEREO_GAP::Clear(*gap);
+  const std::array<int, 6> told{static_cast<int>(mode), eye.iWidth, eye.iHeight,
+                                eye.iBlanking,          m_width,    m_height};
+  if (told != m_stereoGapTold)
+  {
+    m_stereoGapTold = told;
+    CLog::Log(LOGINFO,
+              "3D: the {} {} between the two eyes ({}x{} each, in {}x{}), which no eye is drawn "
+              "on, are made black before each frame goes out",
+              eye.iBlanking, topAndBottom ? "lines" : "columns", eye.iWidth, eye.iHeight, m_width,
+              m_height);
+  }
+}
+
 void CWinSystemGbmGLESContext::SendDisplayReset()
 {
   if (m_dispReset && m_dispResetTimer.IsTimePast())
