From e04ee93b171cb809937e1674b707522251f9c39e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:39:17 +0000
Subject: [PATCH] windowing/gbm: the notice of the playback mode is told for
 every video, also the next one of a playlist

The notice of the playback mode (videoscreen.hadesplaybackmode, off by default) was to be
told once per video. CPlaybackModeAnnouncer took a video to begin where a video plays
after none did (CApplicationPlayer::IsPlayingVideo()), sampled with the hades.dv.*
properties twice a second. The next video of a playlist never looks so:
CVideoPlayer::OpenFile() of a player that runs only sends it PLAYER_OPENFILE, the player
opens the next file without stopping (IsPlaying() is !m_bStop), and m_HasVideo stays true
from the video before (UpdateHasVideoAudio() clears it only where no video stream
opened). After the first video of a playlist, none was told.

A video begins where its playback starts: CApplication handles GUI_MSG_PLAYBACK_AVSTARTED
(the first picture or sound is out, for every file, the next of a playlist too) and tells
the window system (CWinSystemBase::PlaybackAVStarted(), on the thread of the interface),
which counts them; the announcer starts its wait with each new count. Nothing is told
while no video plays (the output of the menus has a mode and says SDR), nor before the
first start, and a video whose output never settles is given up 8 s after its start, as
before.

Host test: TestPlaybackMode (in the tree), run with the minimal googletest of the host
tests: 7 cases, among them the next video of a playlist (a video plays all along, the
count goes on) and the menus while no video plays. Two mutants of the header are killed:
a new count taken only while no video plays (the bug: TheNextVideoOfAPlaylistIsTold and
TellsOnceAfterTheOutputSettles fail) and the test of whether a video plays taken out
(NothingIsToldWhileNoVideoPlays fails).
---
 .../ApplicationMessageHandling.cpp            |  4 +
 xbmc/utils/PlaybackMode.h                     | 41 ++++----
 xbmc/utils/test/TestPlaybackMode.cpp          | 94 ++++++++++++++-----
 xbmc/windowing/WinSystem.h                    |  4 +
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  3 +-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  6 ++
 6 files changed, 112 insertions(+), 40 deletions(-)

diff --git a/xbmc/application/ApplicationMessageHandling.cpp b/xbmc/application/ApplicationMessageHandling.cpp
index 27b733d..49cb010 100644
--- a/xbmc/application/ApplicationMessageHandling.cpp
+++ b/xbmc/application/ApplicationMessageHandling.cpp
@@ -732,6 +732,10 @@ bool CApplicationMessageHandling::OnMessage(const CGUIMessage& message)
 
     case GUI_MSG_PLAYBACK_AVSTARTED:
     {
+      // Hades: the window system is told that a video began (its notice of the playback mode),
+      // also the next one of a playlist, which the player opens without stopping
+      if (auto* winSystem = CServiceBroker::GetWinSystem())
+        winSystem->PlaybackAVStarted();
       CVariant param;
       param["player"]["speed"] = 1;
       param["player"]["playerid"] =
diff --git a/xbmc/utils/PlaybackMode.h b/xbmc/utils/PlaybackMode.h
index 06e2883..08fcb6d 100644
--- a/xbmc/utils/PlaybackMode.h
+++ b/xbmc/utils/PlaybackMode.h
@@ -59,11 +59,16 @@ inline std::string DescribePlaybackMode(const PlaybackModeInfo& info)
   return text;
 }
 
-//! \brief Says once per playback, a little after it has begun, what the mode is.
+//! \brief Says once per video, a little after it has begun, what the mode is.
 //!
-//! The output settles after the start (the display changes its mode, Dolby Vision begins): the
-//! mode is told when the same text has been the output's for SETTLE_MS. It is not told again until
-//! the playback stops, nor if the output stays unknown for GIVE_UP_MS.
+//! A video begins with each start of a playback (\a started changes: the window system counts the
+//! playbacks whose first picture or sound came out, GUI_MSG_PLAYBACK_AVSTARTED). The next video of
+//! a playlist is one too: the player opens it without stopping, and whether a video plays does not
+//! change between the two. The output settles after the start (the display changes its mode,
+//! Dolby Vision begins): the mode is told when the same text has been the output's for SETTLE_MS.
+//! It is not told again until the next video begins, nor if the output stays unknown for
+//! GIVE_UP_MS after the start, nor while no video plays (the output of the menus is no mode of a
+//! video).
 class CPlaybackModeAnnouncer
 {
 public:
@@ -72,29 +77,29 @@ public:
 
   //! \param nowMs a clock in ms that goes forward (may wrap)
   //! \param playing whether a video plays
+  //! \param started a number that changes with each video that begins (0 before the first)
   //! \return the text to show, or empty if there is nothing to show now
-  std::string Update(uint32_t nowMs, bool playing, const PlaybackModeInfo& info)
+  std::string Update(uint32_t nowMs,
+                     bool playing,
+                     unsigned int started,
+                     const PlaybackModeInfo& info)
   {
-    if (!playing)
-    {
-      m_active = false;
-      m_done = false;
-      return {};
-    }
-    if (m_done)
-      return {};
-    if (!m_active)
+    if (started != m_started)
     {
+      // a video began: its mode is told once, when its output has settled
+      m_started = started;
       m_active = true;
       m_begin = nowMs;
       m_known = false;
     }
+    if (!playing || !m_active)
+      return {};
     const std::string text = DescribePlaybackMode(info);
     if (text.empty())
     {
       m_known = false;
       if (static_cast<uint32_t>(nowMs - m_begin) >= GIVE_UP_MS)
-        m_done = true;
+        m_active = false;
       return {};
     }
     if (!m_known || text != m_lastText)
@@ -106,14 +111,14 @@ public:
     }
     if (static_cast<uint32_t>(nowMs - m_since) < SETTLE_MS)
       return {};
-    m_done = true;
+    m_active = false;
     return text;
   }
 
 private:
-  bool m_active{false};
-  bool m_done{false};
+  bool m_active{false}; //!< a video began, and its mode has not been told yet
   bool m_known{false};
+  unsigned int m_started{0};
   uint32_t m_begin{0};
   uint32_t m_since{0};
   std::string m_lastText;
diff --git a/xbmc/utils/test/TestPlaybackMode.cpp b/xbmc/utils/test/TestPlaybackMode.cpp
index a8b6b6c..d9cbf39 100644
--- a/xbmc/utils/test/TestPlaybackMode.cpp
+++ b/xbmc/utils/test/TestPlaybackMode.cpp
@@ -37,23 +37,74 @@ TEST(TestPlaybackMode, TellsOnceAfterTheOutputSettles)
   CPlaybackModeAnnouncer announcer;
   const PlaybackModeInfo hdr10{"hdr10", "hdr10", "", "3840x2160 @ 23.976 Hz"};
   uint32_t now = 5000;
-  // nothing known yet
-  EXPECT_EQ("", announcer.Update(now, true, {}));
+  // before a video began, nothing
+  EXPECT_EQ("", announcer.Update(now, true, 0, hdr10));
+  now += 2000;
+  EXPECT_EQ("", announcer.Update(now, true, 0, hdr10));
+  // it begins: nothing known yet
+  EXPECT_EQ("", announcer.Update(now, true, 1, {}));
   now += 500;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
   now += 1000;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
   now += 500;
-  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, 1, hdr10));
   // once
   now += 500;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
-  // and again after the playback stopped
-  EXPECT_EQ("", announcer.Update(now, false, {}));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
+  // a stop and a play again without a new video: nothing
+  EXPECT_EQ("", announcer.Update(now, false, 1, {}));
+  now += 2000;
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
+  // the next video, after a stop
+  EXPECT_EQ("", announcer.Update(now, false, 1, {}));
   now += 100;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 2, hdr10));
   now += 1500;
-  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, 2, hdr10));
+}
+
+// the next video of a playlist: the player opens it without stopping, and a video plays all along
+TEST(TestPlaybackMode, TheNextVideoOfAPlaylistIsTold)
+{
+  CPlaybackModeAnnouncer announcer;
+  const PlaybackModeInfo first{"hdr10", "hdr10", "", "3840x2160 @ 23.976 Hz"};
+  const PlaybackModeInfo next{"dolbyvision", "dolbyvision", "FEL", "3840x2160 @ 23.976 Hz"};
+  uint32_t now = 100;
+  EXPECT_EQ("", announcer.Update(now, true, 1, first));
+  now += 1500;
+  EXPECT_EQ("HDR10 \xC2\xB7 3840x2160 @ 23.976 Hz", announcer.Update(now, true, 1, first));
+  now += 30000;
+  EXPECT_EQ("", announcer.Update(now, true, 1, first));
+  // the next one begins
+  EXPECT_EQ("", announcer.Update(now, true, 2, next));
+  now += 1500;
+  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL \xC2\xB7 3840x2160 @ 23.976 Hz",
+            announcer.Update(now, true, 2, next));
+  // even where it plays in the same mode as the one before
+  now += 30000;
+  EXPECT_EQ("", announcer.Update(now, true, 3, next));
+  now += 1500;
+  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL \xC2\xB7 3840x2160 @ 23.976 Hz",
+            announcer.Update(now, true, 3, next));
+}
+
+TEST(TestPlaybackMode, NothingIsToldWhileNoVideoPlays)
+{
+  CPlaybackModeAnnouncer announcer;
+  // the output of the menus says SDR, in a mode
+  const PlaybackModeInfo menus{"", "sdr", "", "3840x2160 @ 60.000 Hz"};
+  uint32_t now = 100;
+  EXPECT_EQ("", announcer.Update(now, false, 1, menus));
+  now += 2000;
+  EXPECT_EQ("", announcer.Update(now, false, 1, menus));
+  now += 2000;
+  EXPECT_EQ("", announcer.Update(now, false, 1, menus));
+  // ... and a video that plays is told
+  const PlaybackModeInfo hdr10{"hdr10", "hdr10", "", ""};
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
+  now += 1500;
+  EXPECT_EQ("HDR10", announcer.Update(now, true, 1, hdr10));
 }
 
 TEST(TestPlaybackMode, ATextThatChangesRestartsTheWait)
@@ -62,26 +113,27 @@ TEST(TestPlaybackMode, ATextThatChangesRestartsTheWait)
   const PlaybackModeInfo hdr10{"dolbyvision", "hdr10", "", ""};
   const PlaybackModeInfo dv{"dolbyvision", "dolbyvision", "FEL", ""};
   uint32_t now = 100;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
   now += 1400;
   // the output became Dolby Vision just before the wait was over: the wait starts again
-  EXPECT_EQ("", announcer.Update(now, true, dv));
+  EXPECT_EQ("", announcer.Update(now, true, 1, dv));
   now += 1000;
-  EXPECT_EQ("", announcer.Update(now, true, dv));
+  EXPECT_EQ("", announcer.Update(now, true, 1, dv));
   now += 600;
-  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL", announcer.Update(now, true, dv));
+  EXPECT_EQ("Dolby Vision \xC2\xB7 FEL", announcer.Update(now, true, 1, dv));
 }
 
 TEST(TestPlaybackMode, GivesUpWhenTheOutputIsNeverKnown)
 {
   CPlaybackModeAnnouncer announcer;
   uint32_t now = 0;
+  EXPECT_EQ("", announcer.Update(now, true, 1, {}));
   for (; now < CPlaybackModeAnnouncer::GIVE_UP_MS + 500; now += 500)
-    EXPECT_EQ("", announcer.Update(now, true, {}));
-  // too late to be news: nothing is told for this playback
-  EXPECT_EQ("", announcer.Update(now, true, {"hdr10", "hdr10", "", ""}));
+    EXPECT_EQ("", announcer.Update(now, true, 1, {}));
+  // too late to be news: nothing is told for this video
+  EXPECT_EQ("", announcer.Update(now, true, 1, {"hdr10", "hdr10", "", ""}));
   now += 5000;
-  EXPECT_EQ("", announcer.Update(now, true, {"hdr10", "hdr10", "", ""}));
+  EXPECT_EQ("", announcer.Update(now, true, 1, {"hdr10", "hdr10", "", ""}));
 }
 
 TEST(TestPlaybackMode, TheClockMayWrap)
@@ -89,9 +141,9 @@ TEST(TestPlaybackMode, TheClockMayWrap)
   CPlaybackModeAnnouncer announcer;
   const PlaybackModeInfo hdr10{"hdr10", "hdr10", "", ""};
   uint32_t now = 0xFFFFFE00u;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
   now += 1000;
-  EXPECT_EQ("", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("", announcer.Update(now, true, 1, hdr10));
   now += 1000;
-  EXPECT_EQ("HDR10", announcer.Update(now, true, hdr10));
+  EXPECT_EQ("HDR10", announcer.Update(now, true, 1, hdr10));
 }
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index be3ca9a..161efa8 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -424,6 +424,10 @@ public:
   // Hades: a frame goes to the screen: its GUI pass drew, or was left out (GuiPassSkipped()); for
   // the frame counter of the GUI (System.FPS)
   virtual bool FrameShown(bool rendered) const { return rendered; }
+  // Hades: a playback has begun, its first picture or sound is out (GUI_MSG_PLAYBACK_AVSTARTED,
+  // on the thread of the interface): also the next video of a playlist, which the player opens
+  // without stopping
+  virtual void PlaybackAVStarted() {}
 
   /*!
    * \brief Gets debug info from video renderer for use in "Debug Info OSD" (Alt + O)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index a0248d9..8ada6ec 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -8034,7 +8034,8 @@ void CWinSystemGbmGLESContext::AnnouncePlaybackMode(const std::map<std::string,
     mode.mode = StringUtils::Format("{}x{} @ {:.3f} Hz", selected->hdisplay, selected->vdisplay,
                                     selected->clock * 1000.0 /
                                         (static_cast<double>(selected->htotal) * selected->vtotal));
-  const std::string text = m_modeAnnouncer.Update(CTimeUtils::GetFrameTime(), playing, mode);
+  const std::string text = m_modeAnnouncer.Update(
+      CTimeUtils::GetFrameTime(), playing, m_playbackStarts.load(std::memory_order_relaxed), mode);
   if (text.empty() || !on)
     return;
   CLog::Log(LOGINFO, "Playback mode: {}", text);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 1fd656c..9e24bcf 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -125,6 +125,10 @@ public:
   {
     return CDVGuiReuse::CountsAsFrame(rendered, m_guiReusing);
   }
+#ifdef HAVE_DVBRIDGE
+  //! Hades: for the notice of the playback mode (AnnouncePlaybackMode())
+  void PlaybackAVStarted() override { m_playbackStarts.fetch_add(1, std::memory_order_relaxed); }
+#endif
   //! Hades: the video was drawn by RenderEx() in this frame (CRenderManager::Render()): the GUI
   //! pass is what draws a disc menu without a picture, and what updates an unconfigured renderer
   void NoteVideoDrawnInRenderEx() { m_guiVideoNow = true; }
@@ -1365,6 +1369,8 @@ private:
   //! (videoscreen.hadesplaybackmode, KODI::UTILS::CPlaybackModeAnnouncer)
   KODI::UTILS::CPlaybackModeAnnouncer m_modeAnnouncer;
   void AnnouncePlaybackMode(const std::map<std::string, std::string>& info);
+  //! ... and the playbacks that began (PlaybackAVStarted()), by which it knows a video that begins
+  std::atomic<unsigned int> m_playbackStarts{0};
 #endif
 };
 
