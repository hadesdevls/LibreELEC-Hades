From a4702c44b4aa3e10e306a01dda6aab7ead17829b Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 28 Oct 2026 18:29:27 +0000
Subject: [PATCH] [Video] Keep the hashes of a refreshed episode's folders.

A refresh removes an episode before adding it again for the same file,
and removing it cleared the hashes of its folder and of its show's
folder. The next scan then looked at the whole show again, finding
nothing new in it.

The hashes are now kept, and are cleared only when the episode can't
be added again, as a refreshed movie's are.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoDatabase.cpp                  | 15 +++++++---
 xbmc/video/VideoDatabase.h                    | 11 +++++++-
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 20 ++++++++-----
 xbmc/video/test/TestVideoInfoScanner.cpp      | 28 +++++++++++++++++++
 4 files changed, 62 insertions(+), 12 deletions(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 81517e4..378c758 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -4323,7 +4323,9 @@ void CVideoDatabase::DeleteSeason(int idSeason, bool bKeepId /* = false */)
   }
 }
 
-void CVideoDatabase::DeleteEpisode(int idEpisode, bool bKeepId /* = false */)
+void CVideoDatabase::DeleteEpisode(int idEpisode,
+                                   bool bKeepId /* = false */,
+                                   DeleteMovieHashAction hashAction /* = HASH_DELETE */)
 {
   if (idEpisode < 0)
     return;
@@ -4346,9 +4348,14 @@ void CVideoDatabase::DeleteEpisode(int idEpisode, bool bKeepId /* = false */)
     // the ancillary tables are still purged
     if (!bKeepId)
     {
-      std::string path = GetSingleValue(PrepareSQL("SELECT strPath FROM path JOIN files ON files.idPath=path.idPath WHERE files.idFile=%i", idFile));
-      if (!path.empty())
-        InvalidatePathHash(path);
+      if (hashAction == DeleteMovieHashAction::HASH_DELETE)
+      {
+        std::string path = GetSingleValue(PrepareSQL(
+            "SELECT strPath FROM path JOIN files ON files.idPath=path.idPath WHERE files.idFile=%i",
+            idFile));
+        if (!path.empty())
+          InvalidatePathHash(path);
+      }
 
       // Removed first to avoid being orphaned
       DeleteBookMarkForEpisode(idEpisode);
diff --git a/xbmc/video/VideoDatabase.h b/xbmc/video/VideoDatabase.h
