diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index bf1914a..b1596f2 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -620,16 +620,16 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       db.GetBookMarksForFile(tag.m_strFileNameAndPath, discBookmarks);
     }
 
-    // A movie is added again for the same files, so the hashes of its folders are kept and the
