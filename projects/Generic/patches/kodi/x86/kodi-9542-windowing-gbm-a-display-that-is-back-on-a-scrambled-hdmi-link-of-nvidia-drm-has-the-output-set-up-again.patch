+  LookForRelink();
 
 #ifdef HAVE_DVBRIDGE
   // Hades: the frame that the render manager chose for this pass, if it chose one (CPresentLag)
@@ -1205,6 +1210,193 @@ void CWinSystemGbmGLESContext::FlipOutputOn()
   drm->AllowModeset();
 }
 
+namespace
+{
+// Hades: the outputs of a graphics device as the kernel has them now: connected or not, and the
+// bytes of their EDID (the kernel can give a new EDID the id of an earlier one). probe: as a probe
+// finds them (drmModeGetConnector()), or as the kernel last found them (...Current()).
+std::map<uint32_t, std::pair<bool, std::vector<uint8_t>>> OutputsOfDevice(int fd, bool probe)
+{
+  std::map<uint32_t, std::pair<bool, std::vector<uint8_t>>> outputs;
+  drmModeResPtr resources = drmModeGetResources(fd);
+  if (!resources)
+    return outputs;
+  for (int i = 0; i < resources->count_connectors; ++i)
+  {
+    drmModeConnectorPtr connector = probe ? drmModeGetConnector(fd, resources->connectors[i])
+                                          : drmModeGetConnectorCurrent(fd, resources->connectors[i]);
+    if (!connector)
+      continue;
+    std::vector<uint8_t> edid;
+    for (int p = 0; p < connector->count_props; ++p)
+    {
+      drmModePropertyPtr property = drmModeGetProperty(fd, connector->props[p]);
+      if (!property)
+        continue;
+      const bool isEdid = std::strcmp(property->name, "EDID") == 0;
+      drmModeFreeProperty(property);
+      if (!isEdid)
+        continue;
+      if (connector->prop_values[p])
+      {
+        if (drmModePropertyBlobPtr blob =
+                drmModeGetPropertyBlob(fd, static_cast<uint32_t>(connector->prop_values[p])))
+        {
+          const auto* bytes = static_cast<const uint8_t*>(blob->data);
+          edid.assign(bytes, bytes + blob->length);
+          drmModeFreePropertyBlob(blob);
+        }
+      }
+      break;
+    }
+    outputs[connector->connector_id] = {connector->connection == DRM_MODE_CONNECTED,
+                                        std::move(edid)};
+    drmModeFreeConnector(connector);
+  }
+  drmModeFreeResources(resources);
+  return outputs;
+}
+} // namespace
+
+void CWinSystemGbmGLESContext::LookForRelink()
+{
+  // (two loads a frame while no hot-plug event came)
+  if (!m_displayWatch)
+    return;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return;
+  const int fd = drm->GetFileDescriptor();
+  if (m_relinkDriver.empty())
+  {
+    if (drmVersionPtr version = drmGetVersion(fd))
+    {
+      m_relinkDriver = version->name ? version->name : "?";
+      drmFreeVersion(version);
+    }
+    else
+      m_relinkDriver = "?";
+  }
+  const bool nvidia = m_relinkDriver == "nvidia-drm";
+  // the outputs as the kernel last found them, with the first frame: what the first event is
+  // compared with (only where the driver is one that this is for)
+  if (nvidia && !m_relinkOutputsTaken)
+  {
+    m_relinkOutputs = OutputsOfDevice(fd, false);
+    m_relinkOutputsTaken = true;
+  }
+  const unsigned int hotplugs = m_displayWatch->Hotplugs();
+  if (hotplugs == m_relinkHotplugs ||
+      m_displayWatch->SinceHotplugMs() < HOTPLUG_RELINK::SETTLE_MS)
+    return;
+  m_relinkHotplugs = hotplugs;
+
+  HOTPLUG_RELINK::Facts facts;
+  facts.due = true;
+  facts.sinceHotplugMs = m_displayWatch->SinceHotplugMs();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  facts.setting = !advanced || advanced->m_videoHotplugRelink;
+  facts.nvidia = nvidia;
+  facts.drivenAsHdmi = NVIDIA_DUAL_MODE::DrivenAsHdmi(
+      connector->GetType(), connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY));
+  const uint32_t own = *connector->GetConnectorId();
+  if (nvidia)
+  {
+    // The display in use as a probe finds it, and every other output of the device: an event
+    // that another output explains is not taken as one of the display in use
+    auto outputs = OutputsOfDevice(fd, true);
+    const auto ownNow = outputs.find(own);
+    const auto ownBefore = m_relinkOutputs.find(own);
+    facts.connected = ownNow != outputs.end() && ownNow->second.first;
+    const bool ownChanged = ownNow == outputs.end() || ownBefore == m_relinkOutputs.end() ||
+                            ownNow->second != ownBefore->second;
+    bool otherChanged = false;
+    for (const auto& [id, state] : outputs)
+    {
+      if (id == own)
+        continue;
+      const auto before = m_relinkOutputs.find(id);
+      if (before == m_relinkOutputs.end() || before->second != state)
+        otherChanged = true;
+    }
+    for (const auto& [id, state] : m_relinkOutputs)
+    {
+      if (id != own && outputs.find(id) == outputs.end())
+        otherChanged = true;
+    }
+    facts.otherOutputChanged = otherChanged && !ownChanged;
+    m_relinkOutputs = std::move(outputs);
+  }
+  const auto active = [&drm]
+  { return drm->GetCrtc() && drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0; };
+  facts.on = drm->IsActive() && active();
+  const drmModeModeInfo* mode = drm->GetSelectedMode();
+  // (the depth that NVKMS drives the connector at, where nvidia-drm says it: NV_OUTPUT_BPC,
+  // nvidia-open-kernel-modules-9013; 8 bits otherwise)
+  const auto said = connector->SupportsProperty("NV_OUTPUT_BPC")
+                        ? connector->ReadPropertyValue("NV_OUTPUT_BPC")
+                        : std::optional<uint64_t>{};
+  const int bpc = said && *said >= 8 && *said <= 16 ? static_cast<int>(*said) : 8;
+  facts.tmdsKHz = mode ? HOTPLUG_RELINK::TmdsKHz(mode->clock, bpc) : 0;
+  const auto now = std::chrono::steady_clock::now();
+  facts.sinceRelinkMs =
+      m_relinkDone
+          ? std::chrono::duration_cast<std::chrono::milliseconds>(now - m_relinkAt).count()
+          : -1;
+#ifdef HAVE_DVBRIDGE
+  facts.nativeDV = m_dvState.Captured() && !m_dvMenus;
+#endif
+
+  const HOTPLUG_RELINK::Verdict verdict = HOTPLUG_RELINK::Decide(facts);
+  const std::string name = connector->GetName();
+  if (verdict != HOTPLUG_RELINK::Verdict::RELINK)
+  {
+    if (const char* why = HOTPLUG_RELINK::Why(verdict))
+      CLog::Log(HOTPLUG_RELINK::TellsAtInfo(verdict) ? LOGINFO : LOGDEBUG,
+                "Hot-plug: after the event, the output of {} is not turned off and on again: {}",
+                name, why);
+    return;
+  }
+
+  CLog::Log(LOGINFO,
+            "Hot-plug: the display of {} is there again after the event, with the output on in "
+            "{}x{} @ {} Hz, whose HDMI link is scrambled (TMDS {} kHz at {} bpc): the output is "
+            "turned off and on again once, so that the driver sets the link up from scratch and "
+            "tells the display the scrambling again (nvidia-drm does not after a hot-plug event; "
+            "advancedsettings.xml: hotplugrelink)",
+            name, mode->hdisplay, mode->vdisplay, mode->vrefresh, facts.tmdsKHz, bpc);
+  m_relinkDone = true;
+  m_relinkAt = now;
+  // As when the screen is blanked and woken (and as FlipStalled() does): Hide() ends the menus in
+  // Dolby Vision and what holds the output, and turns it off in a commit that waits; Show() turns
+  // it on in the mode it had. A refusal of the first falls back to the request before it (the
+  // output on): nothing changed then.
+  Hide();
+  const bool off = !drm->LastCommitRefused() && !active();
+  Show(true);
+  if (!off)
+  {
+    CLog::Log(LOGWARNING,
+              "Hot-plug: turning the output of {} off was refused: it stays as it was", name);
+    return;
+  }
+  if (active())
+  {
+    CLog::Log(LOGINFO, "Hot-plug: the output of {} is on again, set up from scratch", name);
+    return;
+  }
+  // The driver can refuse to turn it on: it is asked again with the frames after it, after 1 s
+  // and then less often (FlipOutputOn()), as after a flip that did not come
+  CLog::Log(LOGERROR,
+            "Hot-plug: the output of {} could not be turned on again: it is asked to again, after "
+            "1 s and then less often",
+            name);
+  drm->AllowModeset();
+  OutputLeftOff();
+}
