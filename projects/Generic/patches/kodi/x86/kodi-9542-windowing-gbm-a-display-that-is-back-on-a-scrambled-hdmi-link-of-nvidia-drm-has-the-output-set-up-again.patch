+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+/*
+ * Hades: a display that comes back on an HDMI link that the source scrambles, and that nvidia-drm
+ * does not set up again.
+ *
+ * Above a TMDS character rate of 340 MHz (HDMI 2.0) the source scrambles the link and tells the
+ * sink so through its SCDC registers (TMDS_Config: scrambling on, bit clock ratio 1/40). A sink
+ * that is switched off and on resets those registers, and gives a hot-plug pulse. Until the source
+ * writes them again the sink cannot read the link: no picture, while the source and its state are
+ * as before. i915 reads TMDS_Config at each hot-plug event and sets the link up again where the
+ * sink lost it (intel_hdmi_reset_link(), intel_ddi.c), and amdgpu does a commit for a sink it saw
+ * leave (dm_restore_drm_connector_state(); linux-9964 for one that it did not see leave). NVKMS
+ * writes them in the closed part of the driver, only when it sets a head up, and its open part
+ * cannot read them: after such a pulse nvidia-drm sends the event, reads the same EDID and does
+ * nothing more. Issue #11 (RTX 3050, LG B7, HDMI-A-3, 3840x2160 at 50 Hz, 594 MHz, scrambled): no
+ * picture after the TV was switched off and on; the kernel's log and the DRM state the same before
+ * and after; a change to 1080p (not scrambled) brought the picture back.
+ *
+ * So, on nvidia-drm, a hot-plug event after which the display in use is there, with the output on
+ * in a mode whose link is scrambled, has the output turned off and on again once, as when the
+ * screen is blanked and woken: NVKMS sets the head and the link up from scratch, SCDC included.
+ * The open part of the driver cannot tell whether the sink lost the setup (no SCDC read), so it is
+ * done for such an event whatever the sink kept: a picture that was there goes black for the time
+ * the TV takes to sync again, once, right after the event. It is not done:
+ * - where the link is not scrambled (at most 340 MHz: the sink needs nothing written);
+ * - where the event is explained by another output of the device, which changed (connected,
+ *   disconnected, or another EDID) while the one in use did not: that is not its display;
+ * - for an event that follows one of these within AFTER_OWN_MS (the sink's own answer to it), nor
+ *   twice within SPACING_MS: a display that keeps pulsing cannot keep the output going off;
+ * - while native Dolby Vision is on (leaving it turns the output off and on, or sets the mode of
+ *   the menus, either of which sets the link up again);
+ * - with video/hotplugrelink off in advancedsettings.xml.
+ * Pure: a test builds it on the host.
+ */
+namespace HOTPLUG_RELINK
+{
+//! after the last hot-plug event of a burst, before the display is looked at
+constexpr int64_t SETTLE_MS = 2000;
+//! an event this soon after the output was turned off and on is taken as the sink's answer to it
+constexpr int64_t AFTER_OWN_MS = 10000;
+//! the output is not turned off and on for this reason more often than this
+constexpr int64_t SPACING_MS = 30000;
+//! HDMI 2.0: above this TMDS character rate the source scrambles the link
+constexpr int64_t SCRAMBLED_ABOVE_KHZ = 340000;
+
+/*!
+ * \brief The TMDS character rate of a mode, in kHz: its pixel clock at bpc bits per component in
+ * RGB or YCbCr 4:4:4 (8 at least). A mode sent in YCbCr 4:2:0 has half of it, which is not known
+ * here: it is counted as at the full rate, which costs, at most, the output turned off and on
+ * when that was not needed. A mode sent over FRL is above the limit too, and is set up again
+ * the same way (its link is trained again).
+ */
+inline int64_t TmdsKHz(int64_t clockKHz, int bpc)
+{
+  return clockKHz * std::max(bpc, 8) / 8;
+}
+
+enum class Verdict
+{
+  NOT_DUE, //!< no hot-plug event since the last look
+  LATER, //!< one came less than SETTLE_MS ago
+  SETTING_OFF, //!< video/hotplugrelink is off
+  NOT_NVIDIA, //!< the driver sets the link up again itself (i915, amdgpu), or has no SCDC
+  NOT_HDMI, //!< the connector does not drive its display as HDMI now
+  NOT_CONNECTED, //!< the display in use is not there now
+  OFF, //!< the output is off (blanked, or meant to be off): its next turning on sets it up
+  NOT_SCRAMBLED, //!< at most 340 MHz: nothing to write again
+  ECHO, //!< within AFTER_OWN_MS of the last time: the sink's answer to it
+  OTHER_OUTPUT, //!< another output of the device changed and the one in use did not
+  TOO_SOON, //!< within SPACING_MS of the last time
+  NATIVE_DV, //!< native Dolby Vision is on: its end sets the link up again
+  RELINK, //!< the output is turned off and on again
+};
+
+struct Facts
+{
+  bool due = false; //!< a hot-plug event of the device in use came since the last look
+  int64_t sinceHotplugMs = 0; //!< since the last of them
+  bool setting = true; //!< video/hotplugrelink
+  bool nvidia = false; //!< the device is driven by nvidia-drm
+  bool drivenAsHdmi = false; //!< NVIDIA_DUAL_MODE::DrivenAsHdmi()
+  bool connected = false; //!< the display in use is there, as the kernel says after a probe
+  bool on = false; //!< Kodi has the output on and the kernel says that its CRTC is active
+  int64_t tmdsKHz = 0; //!< TmdsKHz() of the mode on the output
+  bool otherOutputChanged = false; //!< another output of the device changed since the last look
+  int64_t sinceRelinkMs = -1; //!< since the output was last turned off and on for this; -1: never
+  bool nativeDV = false; //!< native Dolby Vision is on (not the menus in Dolby Vision)
+};
+
+inline Verdict Decide(const Facts& f)
+{
+  if (!f.due)
+    return Verdict::NOT_DUE;
+  if (f.sinceHotplugMs < SETTLE_MS)
+    return Verdict::LATER;
+  if (!f.setting)
+    return Verdict::SETTING_OFF;
+  if (!f.nvidia)
+    return Verdict::NOT_NVIDIA;
+  if (!f.drivenAsHdmi)
+    return Verdict::NOT_HDMI;
+  if (!f.connected)
+    return Verdict::NOT_CONNECTED;
+  if (!f.on)
+    return Verdict::OFF;
+  if (f.tmdsKHz <= SCRAMBLED_ABOVE_KHZ)
+    return Verdict::NOT_SCRAMBLED;
+  if (f.sinceRelinkMs >= 0 && f.sinceRelinkMs < AFTER_OWN_MS)
+    return Verdict::ECHO;
+  if (f.otherOutputChanged)
+    return Verdict::OTHER_OUTPUT;
+  if (f.sinceRelinkMs >= 0 && f.sinceRelinkMs < SPACING_MS)
+    return Verdict::TOO_SOON;
+  if (f.nativeDV)
+    return Verdict::NATIVE_DV;
+  return Verdict::RELINK;
+}
+
+//! For the log: why nothing is done (nullptr for NOT_DUE, LATER and RELINK)
+inline const char* Why(Verdict v)
+{
+  switch (v)
+  {
+    case Verdict::SETTING_OFF:
+      return "video/hotplugrelink is off in advancedsettings.xml";
+    case Verdict::NOT_NVIDIA:
+      return "the driver sets the link up again itself";
+    case Verdict::NOT_HDMI:
+      return "the connector does not drive its display as HDMI";
+    case Verdict::NOT_CONNECTED:
+      return "the display is not there now";
+    case Verdict::OFF:
+      return "the output is off: turning it on sets the link up";
+    case Verdict::NOT_SCRAMBLED:
+      return "the link of the mode is not scrambled (340 MHz or less): the display needs nothing "
+             "written again";
+    case Verdict::ECHO:
+      return "it came within 10 s of the output turned off and on for the event before: the "
+             "display's answer to that";
+    case Verdict::OTHER_OUTPUT:
+      return "another output of the graphics card changed and this one did not: the event is "
+             "taken as that output's";
+    case Verdict::TOO_SOON:
+      return "the output was turned off and on for this less than 30 s ago";
+    case Verdict::NATIVE_DV:
+      return "native Dolby Vision is on: leaving it sets the link up again";
+    default:
+      return nullptr;
+  }
+}
+
+//! Whether the verdict is told at INFO (a case where a display may stay without a picture)
+inline bool TellsAtInfo(Verdict v)
+{
+  return v == Verdict::ECHO || v == Verdict::OTHER_OUTPUT || v == Verdict::TOO_SOON ||
+         v == Verdict::NATIVE_DV;
+}
+} // namespace HOTPLUG_RELINK
