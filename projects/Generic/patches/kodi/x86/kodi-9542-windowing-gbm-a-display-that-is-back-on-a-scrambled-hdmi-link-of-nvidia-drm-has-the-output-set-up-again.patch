@@ -418,6 +421,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   LookForWake();
   // Hades: the modes of the display, where a hot-plug event of the device came (nothing otherwise)
   LookAtModes();
