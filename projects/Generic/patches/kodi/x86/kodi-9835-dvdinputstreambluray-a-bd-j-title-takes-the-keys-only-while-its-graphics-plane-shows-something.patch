From e40e0e33031a2290e04268a25a75598d654608ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:36:41 +0000
Subject: [PATCH] DVDInputStreamBluray: a BD-J title takes the keys only while
 its graphics plane shows something

libbluray raises BD_EVENT_MENU 1 for a BD-J title when the title opens
its graphics plane, and 0 only when it closes it. Many BD-J discs open
the plane at their start and keep it open, fully transparent, through
the film: m_menu stayed true, IsInMenu() said that the disc was in its
menu, and the arrows, seeking and the player information went to the
disc for the whole film. What the plane shows was already followed
(m_menuShows, OverlayFlush()), but the event overrode it.

For a BD-J title the decision is now what the graphics plane shows: a
menu, the main one or a pop-up, takes the keys while it is on screen,
and the player has them back once it is gone. An HDMV disc tells its
menus itself, as before. The decision is in BlurayMenuState.h, and
kodi.log says at INFO when a BD-J title opens or closes its plane.

Checked: a host test of BlurayMenuState.h with the cases of a BD-J
film (plane open and transparent), its main menu, a pop-up menu shown
and gone, and HDMV menus and film (8 checks; three mutations each
fail); DVDInputStreamBluray.cpp compiled with the commands of the
image's build. Not run with a disc.

The idea of not taking BD_EVENT_MENU as a menu in a BD-J title is
CroqueMr's (libreelec-x86-DV), from skull-01's report with Back to the
Future Part II.
---
 .../DVDInputStreams/BlurayMenuState.h         | 34 +++++++++++++++++++
 .../DVDInputStreams/CMakeLists.txt            |  1 +
 .../DVDInputStreams/DVDInputStreamBluray.cpp  | 15 +++++---
 3 files changed, 46 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/cores/VideoPlayer/DVDInputStreams/BlurayMenuState.h

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayMenuState.h b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayMenuState.h
new file mode 100644
index 0000000..94e45ce
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayMenuState.h
@@ -0,0 +1,34 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: whether the keys of the remote go to the disc (a menu of it is on screen) or to the player
+// (seeking, the arrows, the player information).
+
+namespace KODI::BLURAYMENU
+{
+
+/*!
+ * \param bdjTitle the title that plays is a BD-J (Java) title
+ * \param menuEvent the disc said that its menu is open (BD_EVENT_MENU 1, or the HDMV top menu title)
+ * \param planeShows the graphics plane (IG: the menus of HDMV, the graphics of a BD-J title) shows
+ *        something (CDVDInputStreamBluray::OverlayFlush())
+ *
+ * libbluray raises BD_EVENT_MENU 1 for a BD-J title when the title opens its graphics plane, and 0
+ * only when it closes it (bluray.c, _bdj_osd_cb()); many discs open it at their start and keep it
+ * open, fully transparent, through the film, which then took every key. For a BD-J title the event
+ * says that the plane is open, not that a menu shows: what the plane shows does (its menu, a pop-up
+ * menu). An HDMV disc tells its menus itself, as before.
+ */
+constexpr bool DiscTakesKeys(bool bdjTitle, bool menuEvent, bool planeShows)
+{
+  return bdjTitle ? planeShows : (menuEvent || planeShows);
+}
+
+} // namespace KODI::BLURAYMENU
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt b/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
index 41174cb..60260a0 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/CMakeLists.txt
@@ -35,6 +35,7 @@ if(TARGET ${APP_NAME_LC}::Bluray)
   list(APPEND SOURCES DVDInputStreamBluray.cpp
                       DVDInputStreamBlurayFile.cpp)
   list(APPEND HEADERS BlurayJoin.h
+                      BlurayMenuState.h
                       BlurayPreroll.h
                       BlurayTitleTime.h
                       DVDInputStreamBluray.h
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index d86d520..1bb38c8 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -9,6 +9,7 @@
 #include "DVDInputStreamBluray.h"
 
 #include "BlurayJoin.h"
+#include "BlurayMenuState.h"
 #include "DVDCodecs/Overlay/DVDOverlay.h"
 #include "DVDCodecs/Overlay/DVDOverlayImage.h"
 #include "DVDInputStreamBlurayFile.h"
@@ -854,6 +855,13 @@ void CDVDInputStreamBluray::ProcessEvent() {
 
   case BD_EVENT_MENU:
     CLog::Log(LOGDEBUG, "CDVDInputStreamBluray - BD_EVENT_MENU {}", m_event.param);
+    // Hades: of a BD-J title, the event says that its graphics plane opened or closed, not that a
+    // menu shows: what the plane shows decides (IsInMenu(), BlurayMenuState.h)
+    if (m_title && m_title->bdj == 1)
+      CLog::Log(LOGINFO,
+                "CDVDInputStreamBluray - the BD-J title {} its graphics plane: keys go to the disc "
+                "only while the plane shows something",
+                m_event.param != 0 ? "opened" : "closed");
     m_menu = (m_event.param != 0);
     if (!m_menu)
       m_isInMainMenu = false;
@@ -2401,10 +2409,9 @@ bool CDVDInputStreamBluray::IsInMenu()
   // since there is no way to tell in a BD-J blu-ray when a popup menu actually is visible,
   // we have to assume that the blu-ray is in menu/navigation mode when there is an overlay
   // on screen, even if it might be invisible (which is impossible to detect)
-  // (Hades: an overlay that shows nothing is no menu: m_menuShows, OverlayFlush())
-  if(m_menu || m_menuShows)
-    return true;
-  return false;
+  // (Hades: an overlay that shows nothing is no menu: m_menuShows, OverlayFlush(); and a BD-J
+  // title is in a menu only while its graphics plane shows something: BlurayMenuState.h)
+  return KODI::BLURAYMENU::DiscTakesKeys(m_title && m_title->bdj == 1, m_menu, m_menuShows);
 }
 
 void CDVDInputStreamBluray::SkipStill()
