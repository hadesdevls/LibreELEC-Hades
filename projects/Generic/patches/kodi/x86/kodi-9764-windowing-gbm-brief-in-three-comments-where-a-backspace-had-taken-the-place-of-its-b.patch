From 58f679a8220c8528d4f7135b23786d1309734e5a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:20:47 +0000
Subject: [PATCH] windowing/gbm: \brief in three comments where a backspace had
 taken the place of its \b

Three doc comments added in this round began with a backspace character
(0x08) followed by "rief": an edit wrote "\b" of "\brief" as the control
character. The compiler does not mind (they are comments), but the text
said "rief", Doxygen did not take it as a brief, and an editor shows the
byte as ^H (OutputState.h: SameOutput(); OutputFormat.h: Hdr422Wanted();
WinSystemGbm.h: ReadOutputEotf()). They are "\brief" again. A check of
the sources of xbmc/windowing/gbm for control characters fails without
this and passes with it.
---
 xbmc/windowing/gbm/OutputFormat.h    | 2 +-
 xbmc/windowing/gbm/WinSystemGbm.h    | 2 +-
 xbmc/windowing/gbm/drm/OutputState.h | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/OutputFormat.h b/xbmc/windowing/gbm/OutputFormat.h
index 3f7537e..71949d2 100644
--- a/xbmc/windowing/gbm/OutputFormat.h
+++ b/xbmc/windowing/gbm/OutputFormat.h
@@ -169,7 +169,7 @@ struct Hdr422Input
 };
 
 /*!
- * rief HDR as YCbCr 4:2:2 at 12 bits: only where it is the exact choice
+ * \brief HDR as YCbCr 4:2:2 at 12 bits: only where it is the exact choice
  *
  * HDMI carries 4:2:2 at 12 bits in the clock of RGB at 8 bits (HDMI 2.0, 4.4.1: 12 bits in the
  * 24-bit container), so a TMDS link that carries a mode in RGB at 8 bits carries it in 4:2:2 at
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 4f3bb55..66ece41 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -338,7 +338,7 @@ protected:
   //! (CHDRSignal::Settle()): a commit that the driver refused left the output as it was. From the
   //! thread that draws.
   void SettleHDR();
-  //! rief Hades: what the output signals as its transfer function, as the driver holds it: the
+  //! \brief Hades: what the output signals as its transfer function, as the driver holds it: the
   //! EOTF of the blob of HDR_OUTPUT_METADATA, read once for each id of the blob (CHDROutputRead),
   //! not what Kodi asked for (GetEotf()). From the thread that draws.
   CHDROutputRead::Eotf ReadOutputEotf();
diff --git a/xbmc/windowing/gbm/drm/OutputState.h b/xbmc/windowing/gbm/drm/OutputState.h
index 5af443e..867c159 100644
--- a/xbmc/windowing/gbm/drm/OutputState.h
+++ b/xbmc/windowing/gbm/drm/OutputState.h
@@ -267,7 +267,7 @@ struct Identity
 };
 
 /*!
- * rief The connector and the CRTC must be those captured, by their ids (an output that was
+ * \brief The connector and the CRTC must be those captured, by their ids (an output that was
  *        unplugged and found again is the same output; another display is not), and the plane the
  *        GUI plane or the video plane, whichever has the id that was captured: Kodi may change which
  *        of them it uses for the output (the one plane of a driver that has no other), and the
