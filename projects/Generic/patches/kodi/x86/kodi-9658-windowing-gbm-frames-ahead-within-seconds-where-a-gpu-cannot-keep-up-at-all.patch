From a1b1ec573f70b73800f498414b70cd229675b0cd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:33:40 +0000
Subject: [PATCH] windowing/gbm: frames ahead within seconds where a GPU cannot
 keep up at all

CDVAhead called for frames ahead once frames presented the way that waits
had missed their refresh in two of the last three runs of 240. A GT 1030
with a profile 7 film missed with 44 to 51 % of its frames at about 10
frames a second, which those runs took 48 s to see; its test ended at 46,
and frames ahead never came. Two runs of 24 in a row with 6 or more late (a
quarter) now call for them at once, and the log says which rule did. An
RTX 4080 SUPER missed 11 of 61 200 frames at most. The seconds after a seek
are set aside as before, and a seek, another refresh rate or the end of the
output start the short runs again.

The first two seconds of a native output, and of a refresh rate, are set
aside for the short runs (START_ASIDE_MS, as long as a seek sets aside;
not for the runs of 240): the first frames draw what the warm-up left,
with the GPU's clocks still those of the menus, and on NVIDIA what the
runs call for stays for the session at that refresh rate, on a way of
presenting that has not been tried on nvidia-drm. A GPU that cannot keep
up at all still misses its refresh after them: the GT 1030 of that test
calls for frames ahead at its 95th frame, about 10 s in.

The times of the GT 1030 in the note of SetMissesOnly() follow 1.0 RC8.
---
 xbmc/windowing/gbm/DVAhead.h                  | 75 ++++++++++++++++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 23 ++++--
 2 files changed, 90 insertions(+), 8 deletions(-)

diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
index 6cd4203..036fa33 100644
--- a/xbmc/windowing/gbm/DVAhead.h
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -63,6 +63,16 @@ namespace GBM
  * frame cannot tell whether it would have missed its refresh while frames are presented a frame
  * ahead, so nothing would bring it back if it ended, and every few seconds it would begin and end
  * again.
+ *
+ * Hades: a GPU that cannot keep up at all misses its refresh with a large part of its frames: a
+ * GT 1030 with a profile 7 film and its enhancement layer, 44 to 51 % of them, at about 10
+ * frames a second, which the two runs of MISS_WINDOW took 48 s to see (its test ended at 46).
+ * Where QUICK_LATE or more of QUICK_WINDOW frames missed their refresh in QUICK_RUNS such runs
+ * in a row, frames ahead are called for at once (QuickRuns()). An RTX 4080 SUPER missed 11 of
+ * 61 200 at most. The first START_ASIDE_MS of a native output, and of a refresh rate, are set
+ * aside for the short runs (not for those of MISS_WINDOW): its first frames draw what the warm-up
+ * left, and the GPU's clocks are still those of the menus. A GPU that cannot keep up at all still
+ * misses its refresh after them.
  */
 class CDVAhead
 {
@@ -140,7 +150,8 @@ public:
    *        of the 16.7 of a refresh for a frame with its enhancement layer, which the half of the
    *        period takes for frames ahead, while Dolby Vision at 60 Hz works there the way that
    *        waits (1.0 RC2: 601 frames in 10 s). A GPU whose frames miss their refreshes again and
-   *        again (a GT 1030: 46 to 49 ms of 41.7) still gets them. ALWAYS still asks for them.
+   *        again (a GT 1030: 46 to 49 ms of 41.7 in 1.0 RC5; 29 to 33 ms in 1.0 RC8, half of its
+   *        frames still late) still gets them. ALWAYS still asks for them.
    */
   void SetMissesOnly(bool missesOnly) { m_missesOnly = missesOnly; }
   bool MissesOnly() const { return m_missesOnly; }
@@ -162,6 +173,8 @@ public:
       m_missFrames = 0;
       m_missLate = 0;
       m_missRuns = 0;
+      ForgetQuick();
+      m_quickAsideMs = START_ASIDE_MS;
     }
     // (the frames of the time set aside after a seek, or after GUI elements went, count for
     // nothing)
@@ -170,6 +183,32 @@ public:
       m_missAsideMs -= periodMs;
       return Change::NONE;
     }
+    // Hades: the short runs, for a GPU that cannot keep up at all (not the first frames of an
+    // output or of a refresh rate)
+    const bool quick = m_quickAsideMs <= 0.0;
+    if (!quick)
+      m_quickAsideMs -= periodMs;
+    m_quickLate += quick && late ? 1 : 0;
+    if (quick && ++m_quickFrames >= QUICK_WINDOW)
+    {
+      const unsigned int lateInRun = m_quickLate;
+      m_quickFrames = 0;
+      m_quickLate = 0;
+      m_quickRuns = lateInRun >= QUICK_LATE ? m_quickRuns + 1 : 0;
+      if (lateInRun >= QUICK_LATE)
+      {
+        m_quickLateBefore = m_quickLateLast;
+        m_quickLateLast = lateInRun;
+      }
+      if (m_quickRuns >= QUICK_RUNS && !Needed(periodMs))
+      {
+        m_quickRuns = 0;
+        m_missNeeded = true;
+        m_missNeededPeriod = periodMs;
+        m_quickCalled = true;
+        return Change::NEEDED;
+      }
+    }
     m_missLate += late ? 1 : 0;
     if (++m_missFrames < MISS_WINDOW)
       return Change::NONE;
@@ -192,6 +231,7 @@ public:
     m_missRuns = 0;
     m_missNeeded = true;
     m_missNeededPeriod = periodMs;
+    m_quickCalled = false;
     return Change::NEEDED;
   }
 
@@ -199,6 +239,12 @@ public:
   //! second), for the log
   unsigned int MissedBefore() const { return m_missLateBefore; }
   unsigned int MissedLast() const { return m_missLateLast; }
+  //! Hades: the short runs of QUICK_WINDOW frames called for it, the last time it was called
+  //! for, and the frames that missed their refresh in the last two of them (newest second), for
+  //! the log
+  bool QuickRuns() const { return m_quickCalled; }
+  unsigned int QuickMissedBefore() const { return m_quickLateBefore; }
+  unsigned int QuickMissedLast() const { return m_quickLateLast; }
 
   //! Hades: the video jumped (a seek, a change of stream): its frames are slow and late for that
   //! (the decoder starts again; the GPU's clocks go down while it waits, and the GUI comes with the
@@ -214,6 +260,7 @@ public:
     m_missFrames = 0;
     m_missLate = 0;
     m_missAsideMs = std::max(m_missAsideMs, SEEK_ASIDE_MS);
+    ForgetQuick();
   }
 
   //! Hades: GUI elements came over the video, or went: the first frames drawn the other way are
@@ -313,6 +360,8 @@ public:
     m_missLate = 0;
     m_missRuns = 0;
     m_missAsideMs = 0.0;
+    ForgetQuick();
+    m_quickAsideMs = START_ASIDE_MS;
     return gone;
   }
 
@@ -322,6 +371,13 @@ public:
 private:
   static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
 
+  void ForgetQuick()
+  {
+    m_quickFrames = 0;
+    m_quickLate = 0;
+    m_quickRuns = 0;
+  }
+
   static constexpr unsigned int WINDOW = 24; //!< frames of an average (a second of film)
   //! part of the refresh period from which the frames call for it: with half the period left,
   //! a frame that takes half as long again is still in time without it
@@ -342,6 +398,15 @@ public:
   static constexpr unsigned int MISS_RUNS = 2;
   //! ... where the first second after GUI elements came or went is set aside (the GPU's clocks)
   static constexpr double CHANGE_ASIDE_MS = 1000.0;
+  //! Hades: frames presented the way that waits in a short run (a second of film), ...
+  static constexpr unsigned int QUICK_WINDOW = 24;
+  //! ... the ones of it that missed their refresh from which it counts (a quarter) ...
+  static constexpr unsigned int QUICK_LATE = 6;
+  //! ... and such runs in a row that call for frames ahead
+  static constexpr unsigned int QUICK_RUNS = 2;
+  //! ... after the first time of a native output or of a refresh rate, which they set aside (as
+  //! much as a seek sets aside)
+  static constexpr double START_ASIDE_MS = SEEK_ASIDE_MS;
 
 private:
 
@@ -370,6 +435,14 @@ private:
   double m_missNeededPeriod = 0.0;
   unsigned int m_missLateBefore = 0;
   unsigned int m_missLateLast = 0;
+  // Hades: the short runs (QuickRuns())
+  unsigned int m_quickFrames = 0;
+  unsigned int m_quickLate = 0;
+  unsigned int m_quickRuns = 0; //!< in a row that counted
+  unsigned int m_quickLateBefore = 0;
+  unsigned int m_quickLateLast = 0;
+  bool m_quickCalled = false;
+  double m_quickAsideMs = START_ASIDE_MS; //!< of the start of an output or of a refresh rate
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 914c040..2133925 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7847,13 +7847,22 @@ void CWinSystemGbmGLESContext::DVAheadWaited(bool late, double periodMs)
     return;
   if (m_dvAhead.PresentedWaiting(late, periodMs) != CDVAhead::Change::NEEDED)
     return;
-  CLog::Log(LOGINFO,
-            "DVBridge: frames presented the way that waits missed their refresh again and again "
-            "({} and then {} of {} frames without GUI elements, in two of the last three runs of "
-            "them; GPU {:.1f} ms on average, of the {:.1f} ms of a refresh): presenting them a "
-            "frame ahead is now called for",
-            m_dvAhead.MissedBefore(), m_dvAhead.MissedLast(), CDVAhead::MISS_WINDOW,
-            m_dvAhead.Average(), periodMs);
+  if (m_dvAhead.QuickRuns())
+    CLog::Log(LOGINFO,
+              "DVBridge: frames presented the way that waits missed their refresh with a large "
+              "part of them ({} and then {} of {} frames without GUI elements, in two runs of "
+              "them in a row; GPU {:.1f} ms on average, of the {:.1f} ms of a refresh): "
+              "presenting them a frame ahead is now called for",
+              m_dvAhead.QuickMissedBefore(), m_dvAhead.QuickMissedLast(), CDVAhead::QUICK_WINDOW,
+              m_dvAhead.Average(), periodMs);
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: frames presented the way that waits missed their refresh again and again "
+              "({} and then {} of {} frames without GUI elements, in two of the last three runs of "
+              "them; GPU {:.1f} ms on average, of the {:.1f} ms of a refresh): presenting them a "
+              "frame ahead is now called for",
+              m_dvAhead.MissedBefore(), m_dvAhead.MissedLast(), CDVAhead::MISS_WINDOW,
+              m_dvAhead.Average(), periodMs);
 #endif
 }
 
-- 
2.53.0

