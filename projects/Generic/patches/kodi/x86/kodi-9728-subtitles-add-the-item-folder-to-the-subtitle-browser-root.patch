From 53761c67f3adb6102ecbc54acf2adda769faa125 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 26 Oct 2026 18:34:49 +0000
Subject: [PATCH] [Subtitles] Add the item folder to the subtitle browser root

Offer the playing item's folder as "* Item folder" at the top of the
browser root, as the extras picker does, so the video's folder stays one
step away after browsing elsewhere.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 addons/resource.language.en_gb/resources/strings.po |  1 +
 xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp    | 12 ++++++++++++
 2 files changed, 13 insertions(+)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 8ea10a6..b3466f4 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -20269,6 +20269,7 @@ msgstr ""
 #: xbmc/video/VideoItemArtworkHandler.cpp
 #: xbmc/video/dialogs/GUIDialogVideoInfo.cpp
 #: xbmc/music/dialogs/GUIDialogMusicInfo.cpp
+#: xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
 msgctxt "#36041"
 msgid "* Item folder"
 msgstr ""
diff --git a/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp b/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
index b32c83a..aa978d9 100644
--- a/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
+++ b/xbmc/video/dialogs/GUIDialogSubtitleSettings.cpp
@@ -22,6 +22,7 @@
 #include "cores/IPlayer.h"
 #include "dialogs/GUIDialogFileBrowser.h"
 #include "dialogs/GUIDialogYesNo.h"
+#include "filesystem/Directory.h"
 #include "guilib/GUIComponent.h"
 #include "guilib/GUIWindowManager.h"
 #include "profiles/ProfileManager.h"
@@ -163,6 +164,17 @@ std::string CGUIDialogSubtitleSettings::BrowseForSubtitle()
   CServiceBroker::GetMediaManager().GetLocalDrives(shares);
   CServiceBroker::GetMediaManager().GetNetworkLocations(shares);
 
+  const std::string itemDir{URIUtils::GetParentPath(strPath)};
+  // Exists() on an internet stream blocks the GUI thread on a network request.
+  if (!itemDir.empty() && !URIUtils::IsInternetStream(itemDir) &&
+      XFILE::CDirectory::Exists(itemDir))
+  {
+    CMediaSource& itemSource = shares.emplace_back();
+    itemSource.strName =
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36041); // * Item folder
+    itemSource.strPath = itemDir;
+  }
+
   std::string strMask =
       ".utf|.utf8|.utf-8|.sub|.srt|.smi|.rt|.txt|.ssa|.aqt|.jss|.ass|.vtt|.idx|.zip|.sup";
 
