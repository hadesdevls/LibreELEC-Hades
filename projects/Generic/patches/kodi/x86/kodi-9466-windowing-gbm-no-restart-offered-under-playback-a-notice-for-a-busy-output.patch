diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 846a353..172b9f2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2306,11 +2306,31 @@ CWinSystemBase::ScreenChange CWinSystemGbm::ChangeScreen(const std::string& scre
   const DRMOutput& target = devices[move.device][move.output];
   const std::string label = OutputLabel(target, withConnected > 1);
 
+  // Not taken: the setting keeps what it had, and the notification says why (playback, which
+  // neither a move nor a start of Kodi is made under; or an output that carries more than the
+  // interface for a moment yet)
+  const auto refuse = [&screen](bool whilePlaying)
+  {
+    CLog::Log(LOGINFO, "Monitor: \"{}\" is not taken while {}: the setting keeps what it had",
+              screen,
+              whilePlaying ? "something plays" : "the output carries more than the interface");
+    CGUIDialogKaiToast::QueueNotification(
+        CGUIDialogKaiToast::Info,
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246),
+        whilePlaying ? CGUIUtils::GetHadesString(39856, 31727)
+                     : CGUIUtils::GetHadesString(39857, 31728),
+        8000);
+    return ScreenChange::REFUSED;
+  };
+
   // Another graphics device: what Kodi draws with lives in that of this one (its OpenGL context,
   // the buffers of the window, every texture, the decoders that hand it their pictures). Only a
-  // start of Kodi takes another device.
+  // start of Kodi takes another device, which is not offered under playback (it would end it), as
+  // a move on this device is not made under it.
   if (move.kind == DRMMove::Kind::ELSEWHERE)
   {
+    if (playing)
+      return refuse(true);
     CLog::Log(LOGINFO, "Monitor: \"{}\" takes Kodi to {}, of another graphics device: only a start "
                        "of Kodi takes it; the user is asked whether to start Kodi again now",
               screen, QualifiedOutputName(target));
@@ -2334,15 +2354,7 @@ CWinSystemBase::ScreenChange CWinSystemGbm::ChangeScreen(const std::string& scre
 
   // Never under something that plays, nor while the output carries more than the interface
   if (playing || OutputMoveBlocked())
-  {
-    CLog::Log(LOGINFO, "Monitor: \"{}\" is not taken while {}: the setting keeps what it had",
-              screen, playing ? "something plays" : "the output carries more than the interface");
-    CGUIDialogKaiToast::QueueNotification(
-        CGUIDialogKaiToast::Info,
-        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246),
-        CGUIUtils::GetHadesString(39856, 31727), 8000);
-    return ScreenChange::REFUSED;
-  }
+    return refuse(playing);
 
   CDRMConnector* const from = m_DRM->GetConnector();
   switch (MoveOutputTo(m_DRM->GetOwnConnector(move.output), "chosen in the settings"))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 552cff5..ab2f99a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -223,7 +223,10 @@ public:
    *        Where it would take an output of another device, or the move cannot be made while Kodi
    *        runs, the user is asked whether to start Kodi again now, which takes it (DONE: the
    *        setting names it from then on). Nothing changes where a start would take the output in
-   *        use (DONE). While something plays the setting keeps what it had (REFUSED).
+   *        use (DONE). While something plays (a video or music), the setting keeps what it had,
+   *        and no start of Kodi is offered either: it would end what plays (REFUSED). The same is
+   *        done while the output still finishes a change of its own (OutputMoveBlocked()), with
+   *        a notification that says so.
    */
   ScreenChange ChangeScreen(const std::string& screen, bool reverting) override;
 
