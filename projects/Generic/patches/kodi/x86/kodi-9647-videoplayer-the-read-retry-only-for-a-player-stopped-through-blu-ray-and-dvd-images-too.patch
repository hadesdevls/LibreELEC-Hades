+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -98,6 +98,8 @@ CDVDInputStreamBluray::~CDVDInputStreamBluray()
 
 void CDVDInputStreamBluray::Abort()
 {
+  // Hades: a read of the image that waits to be tried again stops (not m_pstream itself: Close()
+  // may reset it meanwhile on the thread of the player)
   m_aborted = true;
 }
 
@@ -2327,6 +2329,10 @@ bool CDVDInputStreamBluray::OpenStream(CFileItem &item)
 {
   m_pstream = std::make_unique<CDVDInputStreamFile>(
       item, XFILE::READ_TRUNCATED | XFILE::READ_BITRATE | XFILE::READ_NO_CACHE);
+  // Hades: for a player, a read of the image that fails with an I/O error is tried again, and
+  // Abort() of this stream stops the tries
+  if (m_player)
+    m_pstream->RetryFailedReads(&m_aborted);
 
   if (!m_pstream->Open())
   {
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
index 53cc9d5..5be1fd8 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.cpp
@@ -75,13 +75,14 @@ bool CDVDInputStreamFile::Open()
   }
 
 #if defined(TARGET_POSIX)
-  // Hades: a read of a file on a drive of this machine that fails with an I/O error is tried
-  // again for a bounded time, as a drive that the kernel has reset answers again (issue #16);
-  // CFileStreamBuffer would take the error for the end of the file
-  if (auto* posix = dynamic_cast<CPosixFile*>(m_pFile->GetImplementation()))
+  // Hades: for a player (RetryFailedReads()), a read of a file on a drive of this machine that
+  // fails with an I/O error is tried again for a bounded time, as a drive that the kernel has
+  // reset answers again (issue #16); CFileStreamBuffer would take the error for the end of the file
+  auto* posix = m_retryReads ? dynamic_cast<CPosixFile*>(m_pFile->GetImplementation()) : nullptr;
+  if (posix)
   {
     CPosixFile::ReadRetry retry;
-    retry.abort = &m_aborted;
+    retry.abort = m_retryAbort ? m_retryAbort : &m_aborted;
     retry.name = CURL::GetRedacted(m_item.GetDynPath());
     posix->SetReadRetry(std::move(retry));
   }
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.h
index 4924700..b7d7757 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamFile.h
@@ -30,10 +30,27 @@ public:
   //! Hades: ends the wait of a read that is tried again (CPosixFile::SetReadRetry())
   void Abort() override;
 
+  /*!
+   * \brief Hades: called before Open() by a player: a read of a file on a drive of this machine
+   *        that fails with EIO is tried again (CPosixFile::SetReadRetry()). The tries stop when
+   *        abort is set, or this stream's Abort() when it is null: a stream inside another one
+   *        (the image of a Blu-ray or a DVD) is given the flag of the outer stream, whose Abort()
+   *        the player calls. Readers that are not a player (thumbnails, stream details) do not
+   *        ask: nothing would stop their tries.
+   */
+  void RetryFailedReads(const std::atomic<bool>* abort = nullptr)
+  {
+    m_retryReads = true;
+    m_retryAbort = abort;
+  }
+
 protected:
   XFILE::CFile* m_pFile = nullptr;
   bool m_eof = false;
   unsigned int m_flags = 0;
   //! Hades: set by Abort(), from the thread that closes the player
   std::atomic<bool> m_aborted{false};
+  //! Hades: RetryFailedReads()
+  bool m_retryReads = false;
+  const std::atomic<bool>* m_retryAbort = nullptr;
 };
