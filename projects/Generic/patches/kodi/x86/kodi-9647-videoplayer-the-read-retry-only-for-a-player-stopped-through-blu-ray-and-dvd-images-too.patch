+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDFactoryInputStream.cpp
@@ -180,8 +180,13 @@ std::shared_ptr<CDVDInputStream> CDVDFactoryInputStream::CreateInputStream(IVide
   }
 
   // our file interface handles all these types of streams
-  return std::make_shared<CDVDInputStreamFile>(finalFileitem,
-                                               XFILE::READ_TRUNCATED | XFILE::READ_BITRATE);
+  auto fileStream = std::make_shared<CDVDInputStreamFile>(finalFileitem, XFILE::READ_TRUNCATED |
+                                                                             XFILE::READ_BITRATE);
+  // Hades: the reads of a player are tried again after an I/O error, and its Abort() stops the
+  // tries; other readers (no player: thumbnails, stream details, subtitles) read as before
+  if (pPlayer)
+    fileStream->RetryFailedReads();
+  return fileStream;
 }
 
 std::shared_ptr<CDVDInputStream> CDVDFactoryInputStream::CreateInputStream(IVideoPlayer* pPlayer, const CFileItem &fileitem, const std::vector<std::string>& filenames)
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
