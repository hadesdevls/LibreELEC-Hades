From c9ed0cf529bde2e898f2587fcc47c8f9e7916b82 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:00:48 +0000
Subject: [PATCH] windowing/gbm: HDR over the tunnel gives a mode up where its
 frames do not keep up

The tunnel draws with libplacebo into a 3840x2160 picture in floats, composites the GUI and packs
it: the cost of native Dolby Vision, which on a small graphics processor at 3840x2160 and 50 or 60 Hz
may be more than the ordinary output, and a tunnel that is on by default must not make HDR10 worse
there. HDR10TunnelGuard.h (no GL, a host test runs it with timings it makes up): the GPU time of
each frame, from the timer of native output (GL_EXT_disjoint_timer_query: the frame's drawing and
packing are timed as native output's are), against the period of the refresh. A frame is late above
0.85 of the period; the first 30 frames are not counted; the last 90 decide: 36 late, or an average
above the whole period, and a frame that could not be shown counts as late. Then the mode is given
up for the tunnel for the session (HDR10_TUNNEL::Why::SLOW in the rule, so the renderer is
configured again for the ordinary output through the restoration that every change of renderer
makes, with no black frame of its own), and the log says the average, the maximum, the late count
and the period. A GPU without the timer queries says so once and keeps the tunnel while its frames
are shown (the existing failure path still turns it off if they are not).

Host test: 84 checks (frames that keep up never trip it at 50 and 60 Hz over 20000 frames, frames
that do not trip it at the first frame that can decide, the budget line, bursts below and at the
threshold, bursts apart that do not add up, the average rule, warm-up, missed frames, unknown
period, the verdict staying until Reset()); 11 mutants caught (one more is equivalent). The rule
of HDR10Tunnel.h gets the new reason (655360 combinations, 12 mutants). Not tried on hardware: the
thresholds are from the period and the window, not from measured iGPUs.
---
 xbmc/windowing/gbm/HDR10Tunnel.h              |   8 ++
 xbmc/windowing/gbm/HDR10TunnelGuard.h         | 120 ++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  70 +++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  10 ++
 4 files changed, 204 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/windowing/gbm/HDR10TunnelGuard.h

diff --git a/xbmc/windowing/gbm/HDR10Tunnel.h b/xbmc/windowing/gbm/HDR10Tunnel.h
index 4805d19..75a126c 100644
--- a/xbmc/windowing/gbm/HDR10Tunnel.h
+++ b/xbmc/windowing/gbm/HDR10Tunnel.h
@@ -50,6 +50,9 @@ struct Input
 {
   bool setting = false; //!< the user allows HDR over the tunnel
   bool disabled = false; //!< a tunnel of this display failed earlier in this session (until it changes)
+  //! the frames of the tunnel in this mode did not keep up earlier in this session (CHdr10TunnelGuard): not
+  //! tried again for the mode
+  bool tooSlow = false;
   bool formatChosen = false; //!< the user chose a colour format, or RGB at 8 bits for HDR: theirs
   bool kernelBackend = false; //!< the connector has DVBRIDGE_DV_STANDARD_LAB (i915, xe, amdgpu)
   bool hasProperty = false; //!< ... and DVBRIDGE_HDR10_TUNNEL_LAB
@@ -72,6 +75,7 @@ enum class Why
   USE,
   SETTING,
   DISABLED, //!< a tunnel failed on this display; not tried again until it changes
+  SLOW, //!< its frames did not keep up in this mode; not tried again for it in this session
   CHOICE, //!< the user chose the colour format (or RGB at 8 bits for HDR)
   DRIVER, //!< no kernel backend, or a kernel without the property
   LINK, //!< not HDMI over TMDS
@@ -126,6 +130,8 @@ constexpr Why Decide(const Input& in)
     return Why::SETTING;
   if (in.disabled)
     return Why::DISABLED;
+  if (in.tooSlow)
+    return Why::SLOW;
   if (in.formatChosen)
     return Why::CHOICE;
   if (!in.kernelBackend || !in.hasProperty)
@@ -158,6 +164,8 @@ constexpr const char* Code(Why why)
       return "setting";
     case Why::DISABLED:
       return "disabled";
+    case Why::SLOW:
+      return "slow";
     case Why::CHOICE:
       return "choice";
     case Why::DRIVER:
diff --git a/xbmc/windowing/gbm/HDR10TunnelGuard.h b/xbmc/windowing/gbm/HDR10TunnelGuard.h
new file mode 100644
index 0000000..88c6a98
--- /dev/null
+++ b/xbmc/windowing/gbm/HDR10TunnelGuard.h
@@ -0,0 +1,120 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
