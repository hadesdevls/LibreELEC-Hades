+  std::set<uint64_t> m_hdr10TunnelSlow;
+  bool m_hdr10TunnelSlowTold = false;
+  bool m_hdr10TunnelNoTimerTold = false;
+  void Hdr10TunnelGuardFrame(double gpuMs, bool missed);
   uint64_t m_hdr10TunnelLinkKey = 0;
   int m_hdr10TunnelLink = 0;
   uint64_t m_hdr10TunnelToldKey = 0;
