From a2fc679d65ec68bcb3c9d1882e18bf88109592f6 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:42:59 +0000
Subject: [PATCH] [Library] dialogs: the stream details of a new version or
 extra are read with the busy dialog

Making a file a version or an extra of a video
(CGUIDialogVideoManagerVersions, CGUIDialogVideoManagerExtras) reads its
stream details with CDVDFileInfo::GetFileStreamDetails() on the thread of the
interface: it opens the file and reads and decodes some of it, over the
network too, and the interface stands still meanwhile (it did in Kodi). Since
the library tells the enhancement layer of a Dolby Vision profile 7 stream
by its RPUs, it may read up to 48 access units (16 MiB at most) more there.

Both dialogs now read them with CGUIDialogBusy::Wait(), on a thread of its
own, as Kodi reads a directory or a playlist: the interface is drawn, and the
busy dialog shows after 100 ms. What is read, and what the library keeps, are
the same. It cannot be cancelled, as before; Wait() returns once the reading
has returned (without a cancel it waits for its end, and its waiter's
destructor waits for its thread), so the item on the stack outlives it.
---
 .../dialogs/GUIDialogVideoManagerExtras.cpp   | 23 ++++++++++++++++++-
 .../dialogs/GUIDialogVideoManagerVersions.cpp | 23 ++++++++++++++++++-
 2 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoManagerExtras.cpp b/xbmc/video/dialogs/GUIDialogVideoManagerExtras.cpp
index 7507971..c179a14 100644
--- a/xbmc/video/dialogs/GUIDialogVideoManagerExtras.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoManagerExtras.cpp
@@ -14,6 +14,7 @@
 #include "ServiceBroker.h"
 #include "URL.h"
 #include "cores/VideoPlayer/DVDFileInfo.h"
+#include "dialogs/GUIDialogBusy.h"
 #include "dialogs/GUIDialogFileBrowser.h"
 #include "dialogs/GUIDialogOK.h"
 #include "dialogs/GUIDialogYesNo.h"
@@ -25,6 +26,7 @@
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "storage/MediaManager.h"
+#include "threads/IRunnable.h"
 #include "utils/FileExtensionProvider.h"
 #include "utils/StringUtils.h"
 #include "utils/URIUtils.h"
@@ -37,6 +39,24 @@
 static constexpr unsigned int CONTROL_BUTTON_ADD_EXTRAS = 23;
 static constexpr unsigned int CONTROL_BUTTON_RENAME_EXTRA = 28;
 
+namespace
+{
+// Hades: the stream details of a file are read with the busy dialog, on a thread of their own: they
+// open the file and read and decode some of it (of a Dolby Vision profile 7 stream, up to 48 access
+// units more, to tell its enhancement layer), over the network too, which on the thread of the
+// interface held it still. CGUIDialogBusy::Wait() returns once Run() has returned (without a
+// cancel, it waits for the event; and CBusyWaiter's destructor waits for its thread).
+class CStreamDetailsRead : public IRunnable
+{
+public:
+  explicit CStreamDetailsRead(CFileItem& item) : m_item(item) {}
+  void Run() override { CDVDFileInfo::GetFileStreamDetails(&m_item); }
+
+private:
+  CFileItem& m_item;
+};
+} // namespace
+
 CGUIDialogVideoManagerExtras::CGUIDialogVideoManagerExtras()
   : CGUIDialogVideoManager(WINDOW_DIALOG_MANAGE_VIDEO_EXTRAS)
 {
@@ -232,7 +252,8 @@ bool CGUIDialogVideoManagerExtras::AddVideoExtra()
     if (newAsset.m_idFile <= 0 && CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
                                       CSettings::SETTING_MYVIDEOS_EXTRACTFLAGS))
     {
-      CDVDFileInfo::GetFileStreamDetails(&item);
+      CStreamDetailsRead read(item);
+      CGUIDialogBusy::Wait(&read, 100, false);
       CLog::LogF(LOGDEBUG, "Extracted filestream details from video file {}",
                  CURL::GetRedacted(item.GetPath()));
     }
diff --git a/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp b/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
index b692126..50bf556 100644
--- a/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoManagerVersions.cpp
@@ -15,6 +15,7 @@
 #include "URL.h"
 #include "Util.h"
 #include "cores/VideoPlayer/DVDFileInfo.h"
+#include "dialogs/GUIDialogBusy.h"
 #include "dialogs/GUIDialogFileBrowser.h"
 #include "dialogs/GUIDialogOK.h"
 #include "dialogs/GUIDialogSelect.h"
@@ -30,6 +31,7 @@
 #include "settings/SettingsComponent.h"
 #include "settings/VideoVersionsSettings.h"
 #include "storage/MediaManager.h"
+#include "threads/IRunnable.h"
 #include "utils/FileExtensionProvider.h"
 #include "utils/RegExp.h"
 #include "utils/StringUtils.h"
@@ -55,6 +57,24 @@ static constexpr unsigned int CONTROL_BUTTON_SET_DEFAULT = 25;
 static constexpr unsigned int CONTROL_BUTTON_UNGROUP_VERSION = 29;
 static constexpr int NO_VERSION = -1;
 
+namespace
+{
+// Hades: the stream details of a file are read with the busy dialog, on a thread of their own: they
+// open the file and read and decode some of it (of a Dolby Vision profile 7 stream, up to 48 access
+// units more, to tell its enhancement layer), over the network too, which on the thread of the
+// interface held it still. CGUIDialogBusy::Wait() returns once Run() has returned (without a
+// cancel, it waits for the event; and CBusyWaiter's destructor waits for its thread).
+class CStreamDetailsRead : public IRunnable
+{
+public:
+  explicit CStreamDetailsRead(CFileItem& item) : m_item(item) {}
+  void Run() override { CDVDFileInfo::GetFileStreamDetails(&m_item); }
+
+private:
+  CFileItem& m_item;
+};
+} // namespace
+
 CGUIDialogVideoManagerVersions::CGUIDialogVideoManagerVersions()
   : CGUIDialogVideoManager(WINDOW_DIALOG_MANAGE_VIDEO_VERSIONS),
     m_defaultVideoVersion(std::make_shared<CFileItem>())
@@ -1123,7 +1143,8 @@ bool CGUIDialogVideoManagerVersions::AddVideoVersionFilePicker()
     if (newAsset.m_idFile <= 0 && CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
                                       CSettings::SETTING_MYVIDEOS_EXTRACTFLAGS))
     {
-      CDVDFileInfo::GetFileStreamDetails(&item);
+      CStreamDetailsRead read(item);
+      CGUIDialogBusy::Wait(&read, 100, false);
       CLog::LogF(LOGDEBUG, "Extracted filestream details from video file {}",
                  CURL::GetRedacted(item.GetPath()));
     }
