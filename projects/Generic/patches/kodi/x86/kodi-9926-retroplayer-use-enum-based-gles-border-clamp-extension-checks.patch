From d4c275da8d91777a78d1fb245988b82e12374abd Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 2 Nov 2026 12:27:43 -0800
Subject: [PATCH] [RetroPlayer] Use enum-based GLES border clamp extension
 checks

---
 xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp | 5 +++--
 xbmc/rendering/GLExtensions.h                           | 4 ++++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
index 74e5f2a..7dfa9d1 100644
--- a/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
+++ b/xbmc/cores/RetroPlayer/shaders/gles/ShaderUtilsGLES.cpp
@@ -9,6 +9,7 @@
 #include "ShaderUtilsGLES.h"
 
 #include "ServiceBroker.h"
+#include "rendering/GLExtensions.h"
 #include "rendering/gles/RenderSystemGLES.h"
 
 #include <string_view>
@@ -29,8 +30,8 @@ bool SupportsBorderClamp()
   renderSystem->GetRenderVersion(major, minor);
 
   return major > 3 || (major == 3 && minor >= 2) ||
-         renderSystem->IsExtSupported("GL_EXT_texture_border_clamp") ||
-         renderSystem->IsExtSupported("GL_OES_texture_border_clamp");
+         CGLExtensions::IsExtensionSupported(CGLExtensions::EXT_texture_border_clamp) ||
+         CGLExtensions::IsExtensionSupported(CGLExtensions::OES_texture_border_clamp);
 }
 #endif
 } // namespace
diff --git a/xbmc/rendering/GLExtensions.h b/xbmc/rendering/GLExtensions.h
index 90267ea..5bcfb44 100644
--- a/xbmc/rendering/GLExtensions.h
+++ b/xbmc/rendering/GLExtensions.h
@@ -23,6 +23,7 @@ struct CGLExtensions
     ARB_texture_swizzle,
     EXT_color_buffer_float,
     EXT_framebuffer_object,
+    EXT_texture_border_clamp,
     EXT_texture_filter_anisotropic,
     EXT_texture_format_BGRA8888,
     EXT_texture_norm16,
@@ -33,6 +34,7 @@ struct CGLExtensions
     NVX_gpu_memory_info,
     NV_vdpau_interop,
     OES_EGL_image_external,
+    OES_texture_border_clamp,
     EXTENSION_MAX
   };
   using enum Extension;
@@ -45,6 +47,7 @@ struct CGLExtensions
       {ARB_texture_swizzle, "GL_ARB_texture_swizzle"},
       {EXT_color_buffer_float, "GL_EXT_color_buffer_float"},
       {EXT_framebuffer_object, "GL_EXT_framebuffer_object"},
+      {EXT_texture_border_clamp, "GL_EXT_texture_border_clamp"},
       {EXT_texture_filter_anisotropic, "GL_EXT_texture_filter_anisotropic"},
       {EXT_texture_format_BGRA8888, "GL_EXT_texture_format_BGRA8888"},
       {EXT_texture_norm16, "GL_EXT_texture_norm16"},
@@ -55,6 +58,7 @@ struct CGLExtensions
       {NVX_gpu_memory_info, "GL_NVX_gpu_memory_info"},
       {NV_vdpau_interop, "GL_NV_vdpau_interop"},
       {OES_EGL_image_external, "GL_OES_EGL_image_external"},
+      {OES_texture_border_clamp, "GL_OES_texture_border_clamp"},
   });
 
   static_assert(static_cast<size_t>(EXTENSION_MAX) == stringMap.size(),
-- 
2.53.0

