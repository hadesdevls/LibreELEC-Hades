+std::string CWinSystemGbm::HdrNotSentCode() const
+{
+  const int told = m_hdrNotSent.load(std::memory_order_relaxed);
+  if (told == HDR_NOT_SENT_SETTING)
+    return "setting";
+  if (told <= 0)
+    return "";
+  switch (static_cast<CHDRSignal::Reason>(told - 1))
+  {
+    case CHDRSignal::Reason::NO_PROPERTY:
+      return "noprop";
+    case CHDRSignal::Reason::NO_DISPLAY_INFO:
+      return "noedid";
+    case CHDRSignal::Reason::NO_STATIC_HDR:
+      return "nostatic";
+    case CHDRSignal::Reason::NO_EOTF:
+      return "noeotf";
+    case CHDRSignal::Reason::NO_BLOB:
+      return "noblob";
+    case CHDRSignal::Reason::NOT_QUEUED:
+      return "notqueued";
+    default:
+      return "";
+  }
+}
+
+CWinSystemGbm::SourceColour CWinSystemGbm::GetSourceColour() const
+{
+  std::unique_lock lock(m_sourceColourLock);
+  return m_sourceColour;
+}
+
+void CWinSystemGbm::NoteSourceColour(const VideoPicture* picture)
+{
+  SourceColour now;
+  if (picture)
+  {
+    using namespace KODI::UTILS::PLAYERINFO;
+    // (the primaries that the stream did not say and Kodi chose by the size of the picture, as
+    // CDVDVideoCodecFFmpeg does: VideoPicture::m_originalColorPrimaries is what the stream said)
+    now.colour = ColourText(
+        static_cast<int>(picture->color_primaries), static_cast<int>(picture->color_transfer),
+        picture->color_range != 0,
+        picture->m_originalColorPrimaries == AVCOL_PRI_UNSPECIFIED &&
+            picture->color_primaries != AVCOL_PRI_UNSPECIFIED);
+    now.matrix = MatrixText(static_cast<int>(picture->color_space));
+    if (const AVMasteringDisplayMetadata* mastering = KODI::UTILS::GetMasteringDisplayMetadata(*picture);
+        mastering && mastering->has_luminance)
+      now.mastering = StringUtils::Format("{} / {:.4f}", std::lround(av_q2d(mastering->max_luminance)),
+                                          av_q2d(mastering->min_luminance));
+    if (const AVContentLightMetadata* light = KODI::UTILS::GetContentLightMetadata(*picture))
+      now.cll = light->MaxCLL || light->MaxFALL
+                    ? StringUtils::Format("{} / {}", light->MaxCLL, light->MaxFALL)
+                    : "none";
+  }
+  std::unique_lock lock(m_sourceColourLock);
+  m_sourceColour = std::move(now);
+}
+
 bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
 {
   VideoSeen();
+  // Hades: what the video says of itself, for the player information
+  NoteSourceColour(videoPicture);
   // Hades: HDR10+ starts again with what this asks for (SetHDR10Plus() sends it with each frame)
   ResetHDR10Plus();
 
@@ -4284,6 +4346,13 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
 
   if (!settings->GetBool(SETTING_WINSYSTEM_IS_HDR_DISPLAY))
   {
+    // (Hades: the HDR of a PQ or HLG video is not signalled because HDR is off in the settings:
+    // the player information says so)
+    m_hdrNotSent.store(videoPicture && (videoPicture->color_transfer == AVCOL_TRC_SMPTE2084 ||
+                                        videoPicture->color_transfer == AVCOL_TRC_ARIB_STD_B67)
+                           ? HDR_NOT_SENT_SETTING
+                           : 0,
+                       std::memory_order_relaxed);
     // (Hades: the depth of the link for the picture, as below; HDR signalling is never sent then)
     const bool signalled = m_queuedHdrMetadata.value_or(0) != 0;
     QueuePictureLinkDepth(videoPicture, false, signalled, signalled);
@@ -4476,6 +4545,9 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   if (CHDRSignal::Tell(want, outcome, m_hdrTold))
     CLog::Log(LOGINFO, "HDR output: no HDR signalling for this {} video: {}",
               eotf == KODI::UTILS::Eotf::HLG ? "HLG" : "PQ", CHDRSignal::Why(outcome.reason));
+  // (Hades: for the player information: while an HDR picture goes out without HDR signalling)
+  m_hdrNotSent.store(want && !outcome.Sent() ? static_cast<int>(outcome.reason) + 1 : 0,
+                     std::memory_order_relaxed);
   if (outcome.cleared)
     CLog::Log(LOGINFO, "HDR output: the HDR metadata of the video before is taken away");
   if (outcome.kept)
