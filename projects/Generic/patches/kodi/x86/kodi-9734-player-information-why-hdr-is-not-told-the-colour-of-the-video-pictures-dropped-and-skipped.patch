   bool HDR10PlusInVideo() const { return m_hdr10PlusInVideo; }
   //! Hades: HDR10+ metadata are queued for the display (CHDR10PlusOutput::Active())
   bool HDR10PlusQueued() const { return m_hdr10Plus.Active(); }
+  //! \brief Hades, for the player information: why the display is not told that the HDR video that
+  //! plays is HDR (CHDRSignal::Reason as a word: noprop, noedid, nostatic, noeotf, noblob,
+  //! notqueued; or setting: HDR is off in the display settings); empty while it is told, or when
+  //! the video is not HDR. From any thread.
+  std::string HdrNotSentCode() const;
+  //! \brief Hades, for the player information: what the video that plays says of itself, as it was
+  //! when SetHDR() was given its picture: its colour (primaries, transfer function, range), its
+  //! matrix, its mastering display (max / min, cd/m2) and its light levels (MaxCLL / MaxFALL, or
+  //! "none"); an empty part is not given. Empty while no video plays. From any thread.
+  struct SourceColour
+  {
+    std::string colour;
+    std::string matrix;
+    std::string mastering;
+    std::string cll;
+  };
+  SourceColour GetSourceColour() const;
   //! Hades: the application version of the HDR10+ metadata that may go out to this display: the
   //! version its block declares, 1 at most (what Kodi codes), where the connector has
   //! HDR10PLUS_VSIF; -1 where none may (CHDR10PlusOutput::VersionFits())
@@ -855,6 +872,14 @@ private:
   std::optional<CHDRSignal::Reason> m_hdrTold;
   //! Hades: the EOTF of the blob that the kernel holds, for the labels of what the display is sent
   CHDROutputRead m_outputEotf;
+  //! Hades: ... as a number for the player information (HdrNotSentCode()): 0 none, the reason
+  //! plus 1, or HDR_NOT_SENT_SETTING
+  std::atomic<int> m_hdrNotSent{0};
+  static constexpr int HDR_NOT_SENT_SETTING = 100;
+  //! Hades: GetSourceColour()
+  mutable std::mutex m_sourceColourLock;
+  SourceColour m_sourceColour;
+  void NoteSourceColour(const VideoPicture* picture);
   //! Hades: the state before a change of it that is not known to have gone out (SettleHDR())
   std::optional<CHDRSignal::Before<CDRMPropertyBlob>> m_hdrBefore;
   //! Hades: ... and the end of the HDR signalling, followed until the kernel has it, and asked for
