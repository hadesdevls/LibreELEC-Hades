+
+// PassthroughPause.h: the reckoning of a pause of passthrough that keeps its sound, and what goes
+// out to the receiver around it, packed by the packer of the sink (CAEBitstreamPacker): IEC 61937
+// bursts of the stream, pause bursts while paused and before the sound comes back, nothing else.
+
+#include "cores/AudioEngine/Utils/AEBitstreamPacker.h"
+#include "cores/AudioEngine/Utils/AEStreamInfo.h"
+#include "cores/AudioEngine/Utils/PassthroughPause.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace AE::PTPAUSE;
+using namespace std::chrono_literals;
+
+namespace
+{
+Clock::time_point At(double ms)
+{
+  return Clock::time_point(std::chrono::microseconds(static_cast<long long>(ms * 1000)));
+}
+
+uint16_t Word(const uint8_t* b, size_t i)
+{
+  uint16_t w;
+  memcpy(&w, b + i * 2, 2);
+  return w;
+}
+
+// a burst of the stream: the preambles, its data type, and the length that the type has
+void ExpectBurst(const uint8_t* b, unsigned int size, unsigned int expectedSize, uint16_t type)
+{
+  ASSERT_EQ(expectedSize, size);
+  EXPECT_EQ(0xF872, Word(b, 0));
+  EXPECT_EQ(0x4E1F, Word(b, 1));
+  EXPECT_EQ(type, Word(b, 2) & 0x1F);
+  EXPECT_NE(0, Word(b, 3));
+}
+
+// pause bursts (IEC 61937-1, data type 3, 32 bits of payload) repeated every period, the first one
+// with the gap in samples of the stream, as long as the pause
+void ExpectPause(const uint8_t* b,
+                 unsigned int size,
+                 unsigned int periodBytes,
+                 unsigned int millis,
+                 unsigned int rate,
+                 unsigned int repetition,
+                 unsigned int encodedRate)
+{
+  const double periodMs = static_cast<double>(repetition) / rate * 1000;
+  const unsigned int periods = static_cast<unsigned int>(millis / periodMs);
+  ASSERT_EQ(periods * periodBytes, size);
+  for (unsigned int p = 0; p < periods; ++p)
+  {
+    const uint8_t* q = b + p * periodBytes;
+    ASSERT_EQ(0xF872, Word(q, 0)) << "period " << p;
+    ASSERT_EQ(0x4E1F, Word(q, 1)) << "period " << p;
+    ASSERT_EQ(3, Word(q, 2)) << "period " << p;
+    ASSERT_EQ(32, Word(q, 3)) << "period " << p;
+  }
+  EXPECT_EQ(static_cast<uint16_t>(encodedRate * millis / 1000), Word(b, 4));
+}
+
+struct Format
+{
+  CAEStreamInfo::DataType type;
+  unsigned int frameBytes; // the packet of the stream given to the packer
+  unsigned int burstBytes; // the burst it is packed in
+  uint16_t dataType;
+  unsigned int repetition; // of a pause burst, in frames
+  int frameMs; // GetDuration(), whole
+};
+
+CAEStreamInfo Info(const Format& f)
+{
+  CAEStreamInfo info;
+  info.m_type = f.type;
+  info.m_sampleRate = 48000;
+  info.m_channels = 2;
+  info.m_repeat = 1;
+  info.m_dtsPeriod = 2048;
+  return info;
+}
+
+const Format FORMATS[] = {
+    {CAEStreamInfo::STREAM_TYPE_AC3, 1792, 6144, 0x01, 3, 32},
+    {CAEStreamInfo::STREAM_TYPE_EAC3, 2560, 24576, 0x15, 4, 32},
+    {CAEStreamInfo::STREAM_TYPE_TRUEHD, 61440, 61440, 0x16, 4, 20},
+    {CAEStreamInfo::STREAM_TYPE_DTSHD_MA, 3000, 8192, 0x11, 3, 10},
+};
+} // namespace
+
+TEST(TestPassthroughPause, TheClockIsNotedOnlyWhileItRuns)
+{
+  std::optional<ClockRead> last;
+  NoteClock(last, At(0), 1000.0);
+  ASSERT_TRUE(last);
+  NoteClock(last, At(20), 1020.0);
+  EXPECT_EQ(At(20), last->at);
+  // it stopped: the reading of before stays
+  NoteClock(last, At(40), 1020.0);
+  NoteClock(last, At(60), 1020.0);
+  EXPECT_EQ(At(20), last->at);
+  EXPECT_DOUBLE_EQ(1020.0, last->clockMs);
+}
+
+TEST(TestPassthroughPause, TheClockStoppedBetweenTwoReadings)
+{
+  // read at 20 ms; at 52 ms it has run 10 ms only: it reached that at 30 ms and stood since
+  std::optional<ClockRead> last = ClockRead{At(20), 1020.0};
+  NoteClock(last, At(52), 1030.0);
+  EXPECT_EQ(At(30), last->at);
+  EXPECT_NEAR(22.0, *FrozenFor(last, At(52), 1030.0), 1e-9);
+  // and later readings of the clock standing still change nothing
+  NoteClock(last, At(80), 1030.0);
+  EXPECT_NEAR(50.0, *FrozenFor(last, At(80), 1030.0), 1e-9);
+  // a clock that ran (1 % slower), jumped ahead, or went back is taken as it reads
+  last = ClockRead{At(100), 2000.0};
+  NoteClock(last, At(132), 2031.7);
+  EXPECT_EQ(At(132), last->at);
+  NoteClock(last, At(140), 2100.0);
+  EXPECT_EQ(At(140), last->at);
+  NoteClock(last, At(150), 1900.0);
+  EXPECT_EQ(At(150), last->at);
+  EXPECT_DOUBLE_EQ(1900.0, last->clockMs);
+}
+
+TEST(TestPassthroughPause, HowLongTheClockStood)
+{
+  std::optional<ClockRead> last;
+  EXPECT_FALSE(FrozenFor(last, At(100), 1000.0));
+  last = ClockRead{At(100), 1000.0};
+  // read at 100 ms, it ran 30 ms more and then stopped; at 150 ms it has stood 20 ms
+  ASSERT_TRUE(FrozenFor(last, At(150), 1030.0));
+  EXPECT_NEAR(20.0, *FrozenFor(last, At(150), 1030.0), 1e-9);
+  // it never stopped
+  EXPECT_NEAR(0.0, *FrozenFor(last, At(150), 1050.0), 1e-9);
+  // too old a reading, a clock that went back, one that ran faster than time
+  EXPECT_FALSE(FrozenFor(last, At(100 + CLOCK_READ_MAX_AGE_MS + 1), 1030.0));
+  EXPECT_FALSE(FrozenFor(last, At(150), 990.0));
+  EXPECT_FALSE(FrozenFor(last, At(150), 1100.0));
+}
+
+TEST(TestPassthroughPause, WhatAPacketGivenBackIsKeptAs)
+{
+  EXPECT_EQ(Kept::SOUND, Classify(true, false, 61440, 0));
+  EXPECT_EQ(Kept::PAUSE, Classify(true, false, 0, 20)); // muted while the sync was measured
+  EXPECT_EQ(Kept::NOTHING, Classify(true, false, 0, 0)); // left out for the sync
+  EXPECT_EQ(Kept::PAUSE, Classify(false, true, 0, 13));
+  EXPECT_EQ(Kept::NOTHING, Classify(false, true, 0, 0));
+  EXPECT_EQ(Kept::UNKNOWN, Classify(false, false, 61440, 0));
+}
+
+TEST(TestPassthroughPause, TheGapBeforeTheSoundComesBack)
+{
+  // 215 ms played with the picture stopped, which moved 3 ms before the engine heard of the resume
+  // and 2 ms more since; the device holds 195 ms of silence: 15 ms more
+  EXPECT_NEAR(15.0, GapMs(212.0, 2.0, 195.0), 1e-9);
+  // the device holds more than that already: none (the sound is late by the rest)
+  EXPECT_DOUBLE_EQ(0.0, GapMs(212.0, 2.0, 230.0));
+  EXPECT_DOUBLE_EQ(0.0, GapMs(-40.0, 0.0, 0.0));
+}
+
+TEST(TestPassthroughPause, TheGapGoesInPiecesOfAFrame)
+{
+  for (const double total : {0.0, 0.4, 0.6, 1.0, 7.3, 19.5, 20.0, 47.0, 212.49})
+  {
+    double left = total;
+    int sum = 0;
+    int pieces = 0;
+    for (int piece = GapPiece(left, 20); piece > 0; piece = GapPiece(left, 20))
+    {
+      EXPECT_LE(piece, 20);
+      sum += piece;
+      left -= piece;
+      ASSERT_LT(++pieces, 100);
+    }
+    EXPECT_EQ(static_cast<int>(std::floor(total + 0.5)), sum) << total;
+  }
+  EXPECT_EQ(0, GapPiece(50.0, 0));
+}
+
+TEST(TestPassthroughPause, TheSilenceOfAPauseStaysUnderTheSoundThatWasThere)
+{
+  // a device of 200 ms, frames of 20: the silence is written up to 140 ms, never past 160
+  EXPECT_FALSE(HeldSilenceWaitMs(100.0, 200.0, 20.0));
+  EXPECT_FALSE(HeldSilenceWaitMs(120.0, 200.0, 20.0));
+  ASSERT_TRUE(HeldSilenceWaitMs(130.0, 200.0, 20.0));
+  EXPECT_NEAR(10.0, *HeldSilenceWaitMs(130.0, 200.0, 20.0), 1e-9);
+  EXPECT_NEAR(40.0, *HeldSilenceWaitMs(160.0, 200.0, 20.0), 1e-9);
+  // the sound held when the pause came (the sink writes it as the device has room for a frame) is
+  // at least 180 ms: more than the silence ever is
+  for (double device = 0; device <= 200.0; device += 0.5)
+  {
+    if (!HeldSilenceWaitMs(device, 200.0, 20.0))
+    {
+      EXPECT_LE(device + 20.0, 200.0 - 20.0 - 20.0);
+    }
+  }
+  // a device too small for that still gets a frame
+  EXPECT_FALSE(HeldSilenceWaitMs(0.0, 40.0, 20.0));
+  EXPECT_TRUE(HeldSilenceWaitMs(10.0, 40.0, 20.0));
+}
+
+TEST(TestPassthroughPause, PauseBurstsWhileTheSoundIsKept)
+{
+  for (const bool streaming : {false, true})
+    for (const uint8_t first : {uint8_t{0}, uint8_t{0x72}, uint8_t{0xF8}})
+    {
+      // not held: as Kodi has it (bool burst = m_extStreaming && (m_packer->GetBuffer()[0] != 0))
+      EXPECT_EQ(streaming && first != 0, AsBursts(streaming, false, first));
+      // held: pause bursts once the stream was packed
+      EXPECT_EQ(first != 0, AsBursts(streaming, true, first));
+    }
+}
+
+// What the sink sends to the receiver around a pause that keeps the sound, for every format: a
+// burst of the stream; while paused, the silence that keeps the device alive, one frame of pause
+// at a time (the packer packs it once and sends the same again); at the resume the gap, in pieces,
+// and then the stream again. Every buffer is a valid IEC 61937 burst, or valid pause bursts.
+TEST(TestPassthroughPause, WhatGoesOutAroundAPauseIsIEC61937)
+{
+  for (const Format& f : FORMATS)
+  {
+    SCOPED_TRACE(f.dataType);
+    CAEStreamInfo info = Info(f);
+    const unsigned int rate = CAEBitstreamPacker::GetOutputRate(info);
+    const unsigned int frameSize = CAEBitstreamPacker::GetOutputChannelMap(info).Count() * 2;
+    const unsigned int periodBytes = f.repetition * frameSize;
+    std::vector<uint8_t> frame(f.frameBytes, 0x5A);
+    frame[5] = 0; // (an AC-3 bitstream mode of 0)
+
+    CAEBitstreamPacker packer;
+    packer.Reset();
+    packer.Pack(info, frame.data(), static_cast<int>(frame.size()));
+    ExpectBurst(packer.GetBuffer(), packer.GetSize(), f.burstBytes, f.dataType);
+
+    // paused, the sound kept: not streaming, held
+    for (int i = 0; i < 3; ++i)
+    {
+      const bool burst = AsBursts(false, true, packer.GetBuffer()[0]);
+      EXPECT_TRUE(burst);
+      EXPECT_EQ(i == 0, packer.PackPause(info, f.frameMs, burst)); // then the same one again
+      ExpectPause(packer.GetBuffer(), packer.GetSize(), periodBytes, f.frameMs, rate, f.repetition,
+                  info.m_sampleRate);
+    }
+
+    // resumed: streaming; a gap of 7 ms and of a frame, then the stream
+    for (const int piece : {7, f.frameMs})
+    {
+      const bool burst = AsBursts(true, false, packer.GetBuffer()[0]);
+      EXPECT_TRUE(burst);
+      packer.PackPause(info, piece, burst);
+      ExpectPause(packer.GetBuffer(), packer.GetSize(), periodBytes, piece, rate, f.repetition,
+                  info.m_sampleRate);
+    }
+    packer.Reset();
+    packer.Pack(info, frame.data(), static_cast<int>(frame.size()));
+    ExpectBurst(packer.GetBuffer(), packer.GetSize(), f.burstBytes, f.dataType);
+  }
+}
+
+// As Kodi has it, the silence of a pause is zeros: no burst, which the receiver takes for the end
+// of the stream (and locks onto it again at the resume).
+TEST(TestPassthroughPause, APauseThatDoesNotKeepTheSoundSendsZerosAsBefore)
+{
+  for (const Format& f : FORMATS)
+  {
+    SCOPED_TRACE(f.dataType);
+    CAEStreamInfo info = Info(f);
+    std::vector<uint8_t> frame(f.frameBytes, 0x5A);
+    frame[5] = 0;
+    CAEBitstreamPacker packer;
+    packer.Pack(info, frame.data(), static_cast<int>(frame.size()));
+    const bool burst = AsBursts(false, false, packer.GetBuffer()[0]);
+    EXPECT_FALSE(burst);
+    packer.PackPause(info, f.frameMs, burst);
+    ASSERT_GT(packer.GetSize(), 0u);
+    const uint8_t* b = packer.GetBuffer();
+    EXPECT_TRUE(std::all_of(b, b + packer.GetSize(), [](uint8_t v) { return v == 0; }));
+  }
+}
+
+// A pause that kept the sound and is let go (a seek, a stop): the packer re-uses its last pause of
+// the same length whatever it is asked for, so the sink resets it (HOLDDROPPED) for the silence
+// that follows to be zeros, as after a pause that keeps nothing.
+TEST(TestPassthroughPause, ThePauseBurstsOfAPauseLetGoAreNotSentOn)
+{
+  for (const Format& f : FORMATS)
+  {
+    SCOPED_TRACE(f.dataType);
+    CAEStreamInfo info = Info(f);
+    std::vector<uint8_t> frame(f.frameBytes, 0x5A);
+    frame[5] = 0;
+    CAEBitstreamPacker packer;
+    packer.Pack(info, frame.data(), static_cast<int>(frame.size()));
+    ASSERT_TRUE(packer.PackPause(info, f.frameMs, AsBursts(false, true, packer.GetBuffer()[0])));
+    ASSERT_EQ(0xF872, Word(packer.GetBuffer(), 0));
+    // let go, not reset: the pause bursts again
+    EXPECT_FALSE(packer.PackPause(info, f.frameMs, AsBursts(false, false, packer.GetBuffer()[0])));
+    EXPECT_EQ(0xF872, Word(packer.GetBuffer(), 0));
+    // reset: zeros
+    packer.Reset();
+    EXPECT_TRUE(packer.PackPause(info, f.frameMs, AsBursts(false, false, packer.GetBuffer()[0])));
+    ASSERT_GT(packer.GetSize(), 0u);
+    const uint8_t* b = packer.GetBuffer();
+    EXPECT_TRUE(std::all_of(b, b + packer.GetSize(), [](uint8_t v) { return v == 0; }));
+  }
+}
