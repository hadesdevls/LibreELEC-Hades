diff --git a/xbmc/cores/AudioEngine/Utils/PassthroughPause.h b/xbmc/cores/AudioEngine/Utils/PassthroughPause.h
new file mode 100644
index 0000000..d833e32
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/PassthroughPause.h
@@ -0,0 +1,176 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: a stream passed through (IEC 61937) that is paused and resumed without losing or
+// repeating any of its sound.
+//
+// What Kodi does. A pause flushes the engine (CActiveAE, PAUSESTREAM): every packet sent to the
+// sink and not yet written to the device goes back to its pool, unplayed. For TrueHD, which the
+// engine does not hold to its water level, that is all the stream had buffered, 380 to 480 ms; for
+// the others about 200 ms. What the device holds plays out (up to 200 ms at 192 kHz, the buffer of
+// the ALSA sink) with the picture already stopped, and then the sink feeds the device silence
+// (zeros, not pause bursts) for as long as the setting that keeps the device alive says. The resume
+// starts the sync again as for a new stream (SYNC_START): the packets that come first are turned
+// into pauses while the error is averaged (SYNC_MUTE), and then the error of the packets lost at
+// the pause is corrected with more pauses. The sound picks up hundreds of milliseconds further on
+// than where it stopped, and the decoder of the receiver gets a stream with a hole in it.
+//
+// What this does, for a passthrough stream that the sink packs itself (CActiveAE::HoldRawStream(),
+// ResumeRawStream(), CActiveAESink, HOLD and RESUMEGAP):
+//  - at the pause the sink gives back, in order and unwritten, every packet it had not written
+//    (RETURNUNWRITTEN), and tells what the device holds; the engine keeps copies of them, packets
+//    and the pauses between them, in the order the device would have played them, and gives the
+//    packets back to the pool of the stream as a flush would (the player feeds it as before);
+//  - while paused, the silence that keeps the device alive goes out as IEC 61937 pause bursts,
+//    which keep the receiver on the stream, muted, as a correction of the sync does;
+//  - at the resume the kept packets go out first, then what the stream had, and the stream takes
+//    up its sync where it was (no SYNC_START, no packet turned into a pause). The sound that the
+//    device played after the picture stopped is not played again: just before it writes the first
+//    packet the sink puts a pause in front of it, long enough that the sound goes on at the place
+//    it would have reached with the picture (GapMs());
+//  - a stream in sync is held to the band of a correction (30 ms) at its first average after the
+//    resume (CActiveAE::SyncStream()): a resume that the reckoning got wrong is corrected once,
+//    and said.
+// A seek, a flush, a change of the output and a stop let the kept packets go, as before. Nothing of
+// this runs for PCM, nor for a sink that takes the stream unpacked.
+//
+// Nothing of Kodi is included: the reckoning is tested on the host (TestPassthroughPause.cpp).
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace AE
+{
+namespace PTPAUSE
+{
+using Clock = std::chrono::steady_clock;
+
+//! A reading of the video clock, ms, and when it was taken
+struct ClockRead
+{
+  Clock::time_point at;
+  double clockMs{0};
+};
+
+//! A reading older than this tells nothing of when the clock stopped
+constexpr double CLOCK_READ_MAX_AGE_MS = 1000.0;
+
+//! Keeps where the video clock last ran (CActiveAE::RunStages()): when it reached the value it has.
+//! A reading of a clock that has not moved since the last one is of a clock that stands still and
+//! changes nothing. One that moved less than the time since the last reading stopped in between,
+//! after it ran that much: it reached its value then, not at this reading. Any other (a clock that
+//! ran, jumped ahead or went back) is kept as it is.
+inline void NoteClock(std::optional<ClockRead>& last, Clock::time_point at, double clockMs)
+{
+  if (last && clockMs == last->clockMs)
+    return;
+  if (last && clockMs > last->clockMs)
+  {
+    const double since = std::chrono::duration<double, std::milli>(at - last->at).count();
+    const double ran = clockMs - last->clockMs;
+    // (1 ms and 1 % of slack: the clock is adjusted a little to the display)
+    if (ran + 1.0 + since * 0.01 < since)
+    {
+      last = ClockRead{last->at + std::chrono::duration_cast<Clock::duration>(
+                                      std::chrono::duration<double, std::milli>(ran)),
+                       clockMs};
+      return;
+    }
+  }
+  last = ClockRead{at, clockMs};
+}
+
+//! How long, in ms, the video clock has stood still at now, when it reads clockMs: the time since
+//! the last reading of it while it ran, less what it ran after that reading. nullopt when there is
+//! no such reading, when it is too old, or when the clock ran back or faster than time since.
+inline std::optional<double> FrozenFor(const std::optional<ClockRead>& last,
+                                       Clock::time_point now,
+                                       double clockMs)
+{
+  if (!last)
+    return std::nullopt;
+  const double since = std::chrono::duration<double, std::milli>(now - last->at).count();
+  if (since < 0.0 || since > CLOCK_READ_MAX_AGE_MS)
+    return std::nullopt;
+  const double ran = clockMs - last->clockMs;
+  // (1 ms and 5 % of slack: the clock is adjusted a little to the display)
+  if (ran < -1.0 || ran > since * 1.05 + 1.0)
+    return std::nullopt;
+  return std::clamp(since - ran, 0.0, since);
+}
+
+//! What a packet that the sink gives back unwritten is kept as
+enum class Kept
+{
+  SOUND, //!< a packet of the stream: kept, it is sound to play
+  PAUSE, //!< a pause, of the engine's pool or a packet of the stream turned into one: kept as a pause
+  NOTHING, //!< a packet left out for the sync, which writes nothing: not kept
+  UNKNOWN, //!< of a pool that is not the stream's nor the engine's pauses: nothing is kept
+};
+
+//! \param ofStream it is of the pool of the stream
+//! \param ofSilence it is of the pool of pauses of the engine
+//! \param frames its bytes (nb_samples of a passthrough packet)
+//! \param pauseMs the pause it is (pause_burst_ms)
+inline Kept Classify(bool ofStream, bool ofSilence, int frames, int pauseMs)
+{
+  if (ofStream)
+    return frames > 0 ? Kept::SOUND : (pauseMs > 0 ? Kept::PAUSE : Kept::NOTHING);
+  if (ofSilence)
+    return pauseMs > 0 ? Kept::PAUSE : Kept::NOTHING;
+  return Kept::UNKNOWN;
+}
+
+//! The pause, ms, that goes before the first packet written after a resume.
+//! \param aheadMs what the device played after the picture stopped, less what the picture moved
+//!        before the engine heard of the resume (CActiveAE::ResumeRawStream())
+//! \param sinceResumeMs the time since the engine heard of it: the picture has moved that much more
+//! \param deviceMs what the device holds now, which plays before the packet
+inline double GapMs(double aheadMs, double sinceResumeMs, double deviceMs)
+{
+  return std::max(0.0, aheadMs - sinceResumeMs - deviceMs);
+}
+
+//! The next piece of a pause of leftMs (rounded to whole ms), each at most frameMs, as a correction
+//! of the sync puts its pauses (CActiveAE::SyncStream()); 0 when nothing is left
+inline int GapPiece(double leftMs, int frameMs)
+{
+  const double whole = std::floor(leftMs + 0.5);
+  if (whole < 1.0 || frameMs < 1)
+    return 0;
+  return static_cast<int>(std::min(whole, static_cast<double>(frameMs)));
+}
+
+//! While a pause keeps the sound, the sink feeds the device its silence (pause bursts) no fuller
+//! than three frames under what it holds (cacheMs): what it held of sound when the pause came is
+//! never less than one frame under that, so at the resume the silence in the device is never more
+//! than the sound that played with the picture stopped, and the gap before the sound (GapMs()) is
+//! never less than nothing. nullopt: write the next frame of silence now; else, ms to wait first.
+inline std::optional<double> HeldSilenceWaitMs(double deviceMs, double cacheMs, double frameMs)
+{
+  const double target = std::max(frameMs, cacheMs - 3 * frameMs);
+  if (deviceMs + frameMs <= target)
+    return std::nullopt;
+  return deviceMs + frameMs - target;
+}
+
+//! Whether the sink packs a pause as IEC 61937 pause bursts (else as zeros, which the receiver
+//! takes for the end of the stream): while a stream plays, and while a stream is paused with its
+//! sound kept (held), once the sink has packed something of the stream (firstByte, the first byte
+//! of the last packet the packer made, is not 0)
+inline bool AsBursts(bool streaming, bool held, uint8_t firstByte)
+{
+  return (streaming || held) && firstByte != 0;
+}
+} // namespace PTPAUSE
+} // namespace AE
