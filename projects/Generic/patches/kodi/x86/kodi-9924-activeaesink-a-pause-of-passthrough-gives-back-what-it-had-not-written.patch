+void CActiveAESink::SetStreaming(bool streaming)
+{
+  m_extStreaming = streaming;
+  // (Hades: a pause that kept its sound ends when the stream streams again)
+  if (streaming)
+    m_extHeldPause = false;
+}
+
+std::optional<std::chrono::milliseconds> CActiveAESink::HeldSilenceWait()
+{
+  if (!m_extHeldPause || !m_sink || m_requestedFormat.m_dataFormat != AE_FMT_RAW || !m_needIecPack)
+    return std::nullopt;
+  AEDelayStatus status;
+  m_sink->GetDelay(status);
+  const auto wait =
+      AE::PTPAUSE::HeldSilenceWaitMs(status.GetDelay() * 1000, m_sink->GetCacheTotal() * 1000,
+                                     m_sinkFormat.m_streamInfo.GetDuration());
+  if (!wait)
+    return std::nullopt;
+  return std::chrono::milliseconds(static_cast<int>(std::ceil(*wait)));
+}
+
+void CActiveAESink::OutputResumeGap()
+{
+  const SinkResumeGap gap = *m_resumeGap;
+  m_resumeGap.reset();
+  if (!m_sink || m_requestedFormat.m_dataFormat != AE_FMT_RAW || !m_needIecPack)
+    return;
+
+  // what the device holds now plays before the packet; the picture has moved since the engine
+  // reckoned the gap
+  AEDelayStatus status;
+  m_sink->GetDelay(status);
+  const double deviceMs = status.GetDelay() * 1000;
+  const double sinceMs =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - gap.at).count();
+  double leftMs = AE::PTPAUSE::GapMs(gap.aheadMs, sinceMs, deviceMs);
+  CLog::LogF(LOGINFO,
+             "the passthrough stream resumes after a pause of {:.0f} ms (the sound played with the "
+             "picture stopped less what the picture moved, {:.0f} ms; {:.0f} ms since; the device "
+             "holds {:.0f} ms)",
+             leftMs, gap.aheadMs, sinceMs, deviceMs);
+
+  // in pauses of a frame of the stream at most, as a correction of the sync has them
+  const int silence = m_sampleOfSilence.pkt->pause_burst_ms;
+  const int frameMs = static_cast<int>(m_sinkFormat.m_streamInfo.GetDuration());
+  for (int piece = AE::PTPAUSE::GapPiece(leftMs, frameMs); piece > 0 && !m_extError;
+       piece = AE::PTPAUSE::GapPiece(leftMs, frameMs))
+  {
+    m_sampleOfSilence.pkt->pause_burst_ms = piece;
+    OutputSamples(&m_sampleOfSilence);
+    leftMs -= piece;
+  }
+  m_sampleOfSilence.pkt->pause_burst_ms = silence;
+}
