From 690c39771d81ac3b583169c7626e2b8307265de4 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 14:35:48 +0000
Subject: [PATCH] [VideoDatabase] Find the movie of a disc image left without
 one.

A refresh that finds a disc's movie on several of its playlists keeps
the disc image's own file, with the disc's watched state. That file has
no movie, so GetMovieId() said the disc wasn't in the library and the
next scan added it again.

The disc is now looked up by its playlists, as it is when it has no
file of its own. A disc that holds another movie too would be found as
that movie once the one being refreshed is removed, so such a movie is
refreshed from its own file rather than from the disc.

Looked up by the disc image's own file, which is none of the movie's
versions, the movie is read through its default version, so the
image's information is found as GetMovieId() finds its movie.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoDatabase.cpp                  | 28 ++++++++++++++--
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 13 ++++++++
 xbmc/video/test/TestVideoDatabase.cpp         | 33 +++++++++++++++++++
 3 files changed, 72 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index b776d35..146c4fc 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -1094,6 +1094,15 @@ int CVideoDatabase::GetMovieId(const std::string& strFilenameAndPath)
     bool isDisc{false};
     std::string strPath;
 
+    // A disc's own file is left without a movie when its movie moves onto the disc's playlists, so
+    // the disc is then looked up by its playlists as it is when it has no file
+    if (idFile >= 0 &&
+        (URIUtils::IsBDFile(strFilenameAndPath) || URIUtils::IsDiscImage(strFilenameAndPath)) &&
+        GetSingleValueInt(PrepareSQL("SELECT COUNT(1) FROM videoversion "
+                                     "WHERE idFile = %i AND media_type = '%s' AND itemType = %i",
+                                     idFile, MediaTypeMovie, VideoAssetType::VERSION)) == 0)
+      idFile = -1;
+
     if (idFile < 0)
     {
       if (URIUtils::IsBDFile(strFilenameAndPath) || URIUtils::IsDiscImage(strFilenameAndPath))
@@ -2058,6 +2067,8 @@ bool CVideoDatabase::GetMovieInfo(const std::string& strFilenameAndPath,
       return false;
 
     std::string sql;
+    // a file named by its path rather than by its id
+    bool fileOfPath{false};
     if (idFile >= 0)
     {
       sql = PrepareSQL("SELECT * FROM movie_view WHERE idMovie = %i AND videoVersionIdFile = %i",
@@ -2074,17 +2085,30 @@ bool CVideoDatabase::GetMovieInfo(const std::string& strFilenameAndPath,
     {
       idFile = GetFileId(strFilenameAndPath);
       if (idFile != -1)
+      {
         sql = PrepareSQL("SELECT * FROM movie_view WHERE idMovie = %i AND videoVersionIdFile = %i",
                          idMovie, idFile);
+        fileOfPath = true;
+      }
     }
 
+    const std::string defaultVersion{PrepareSQL(
+        "SELECT * FROM movie_view WHERE idMovie = %i AND isDefaultVersion = 1", idMovie)};
     if (sql.empty())
-      sql = PrepareSQL("SELECT * FROM movie_view WHERE idMovie = %i AND isDefaultVersion = 1",
-                       idMovie);
+      sql = defaultVersion;
 
     if (!m_pDS->query(sql))
       return false;
 
+    // The file of a disc image left by a refresh that found its movie on the disc's playlists is
+    // none of the movie's, so the movie found by those playlists is read through its default
+    if (fileOfPath && m_pDS->eof())
+    {
+      m_pDS->close();
+      if (!m_pDS->query(defaultVersion))
+        return false;
+    }
+
     details = GetDetailsForMovie(*m_pDS, getDetails);
     return !details.IsEmpty();
   }
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index 884eb85..d5ea1cb 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -447,6 +447,19 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
           discFile = URIUtils::GetDiscFile(filePath);
         else if (::UTILS::DISCS::IsBlurayDiscImage(filePath) || URIUtils::IsBDFile(filePath))
           discFile = filePath;
+
+        // A disc holding another movie too is found as that movie once this one is removed, so
+        // this one is refreshed from its own file alone
+        if (!discFile.empty())
+        {
+          const int playlistPathId{db.GetPathId(URIUtils::GetBlurayPlaylistPath(discFile))};
+          if (playlistPathId >= 0 &&
+              db.GetSingleValueInt(db.PrepareSQL(
+                  "SELECT COUNT(1) FROM movie JOIN files ON files.idFile = movie.idFile "
+                  "WHERE files.idPath = %i AND movie.idMovie <> %i",
+                  playlistPathId, m_item->GetVideoInfoTag()->m_iDbId)) > 0)
+            discFile.clear();
+        }
       }
 
       // for a tvshow we need to handle all paths of it
diff --git a/xbmc/video/test/TestVideoDatabase.cpp b/xbmc/video/test/TestVideoDatabase.cpp
index 89e6eb4..4c408ad 100644
--- a/xbmc/video/test/TestVideoDatabase.cpp
+++ b/xbmc/video/test/TestVideoDatabase.cpp
@@ -1430,3 +1430,36 @@ TEST_F(TestVideoDatabaseClean, EndsItsTransactionWhenThePathsHoldNoMedia)
 
   EXPECT_FALSE(m_db.InTransaction());
 }
+
+TEST_F(TestVideoDatabase, GetMovieIdFindsTheMovieOnTheDiscPlaylistsOfADiscImageWithoutOne)
+{
+  const std::string disc{"/movies/M3GAN 2.0 (2025)/M3GAN20_UPK1.iso"};
+
+  // Left by a refresh that found the movie on two of the disc's playlists
+  ASSERT_GT(m_db.AddFile(disc), 0);
+  EXPECT_EQ(-1, m_db.GetMovieId(disc));
+
+  const int idMovie{AddMovie(URIUtils::GetBlurayPlaylistPath(disc, 801))};
+  ASSERT_GT(idMovie, 0);
+  CFileItem version{URIUtils::GetBlurayPlaylistPath(disc, 800), false};
+  ASSERT_TRUE(m_db.AddVideoAsset(VideoDbContentType::MOVIES, idMovie, VIDEO_VERSION_ID_DEFAULT,
+                                 VideoAssetType::VERSION, version));
+
+  EXPECT_EQ(idMovie, m_db.GetMovieId(disc));
+}
+
+// The movie GetMovieId() finds for such a disc image is read through its default version, as the
+// image's own file is none of its versions
+TEST_F(TestVideoDatabase, GetMovieInfoReadsTheMovieOfADiscImageWithoutOne)
+{
+  const std::string disc{"/movies/M3GAN 2.0 (2025)/M3GAN20_UPK1.iso"};
+  ASSERT_GT(m_db.AddFile(disc), 0);
+  const std::string main{URIUtils::GetBlurayPlaylistPath(disc, 801)};
+  const int idMovie{AddMovie(main)};
+  ASSERT_GT(idMovie, 0);
+
+  CVideoInfoTag tag;
+  ASSERT_TRUE(m_db.GetMovieInfo(disc, tag));
+  EXPECT_EQ(idMovie, tag.m_iDbId);
+  EXPECT_EQ(main, tag.m_strFileNameAndPath);
+}
