     return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(36172) + " " +
            CGUIUtils::GetHadesString(39952, 31916);
 #endif
+  // Dolby Vision without its trims, HDR10+ as Dolby Vision, HDR10 as Dolby Vision measured: labels, help
