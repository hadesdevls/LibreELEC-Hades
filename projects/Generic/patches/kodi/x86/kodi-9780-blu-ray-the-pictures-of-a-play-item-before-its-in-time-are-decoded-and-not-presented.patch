+void CDVDDemuxFFmpeg::MarkBlurayPreroll(DemuxPacket* packet, const AVStream* stream)
+{
+  // the primary video (PIDs 0x1011 to 0x101f, the streams libbluray gives from before IN), with
+  // its time as the transport stream gives it
+  if (stream->codecpar->codec_type != AVMEDIA_TYPE_VIDEO || stream->id < 0x1011 ||
+      stream->id > 0x101f || m_pkt.pkt.pts == AV_NOPTS_VALUE)
+    return;
+
+  // a packet without a position is of the play item of its stream's last packet
+  const auto readPos =
+      m_blurayReadPos.try_emplace(m_pkt.pkt.stream_index, m_blurayPrerollInput->GetReadPos()).first;
+  if (m_pkt.pkt.pos >= 0)
+    readPos->second = m_blurayReadBase + static_cast<uint64_t>(m_pkt.pkt.pos);
+
+  const std::optional<uint64_t> inTime =
+      m_blurayPrerollInput->GetPresentationStart(readPos->second);
+  if (!inTime)
+    return;
+  constexpr AVRational CLIP_TIME_BASE = {1, 90000};
+  const int64_t pts = av_rescale_q(m_pkt.pkt.pts, stream->time_base, CLIP_TIME_BASE);
+  if (!KODI::BLURAYPREROLL::BeforeIn(pts, *inTime))
+    return;
+
+  packet->decodeOnly = true;
+  if (++m_blurayPrerolled <= 3 || m_blurayPrerolled % 100 == 0)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: the picture at {:.3f} s of its clip is before the IN time of its "
+              "play item ({:.3f} s): decoded for the pictures after it, not presented ({} so far)",
+              static_cast<double>(pts) / 90000.0, static_cast<double>(*inTime) / 90000.0,
+              m_blurayPrerolled);
+}
