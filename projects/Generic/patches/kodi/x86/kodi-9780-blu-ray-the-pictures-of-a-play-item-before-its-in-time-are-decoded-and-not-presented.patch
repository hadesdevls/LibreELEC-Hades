+
+#pragma once
+
+// Hades: the pictures of a Blu-ray play item before its IN time.
+//
+// libbluray gives the primary video of a play item that is not joined seamlessly from the
+// random-access picture at or before its IN time (BLURAY_PLAYER_SETTING_VIDEO_PREROLL,
+// libbluray-9091), not from the first picture presented at IN: where IN is not the time of a
+// random-access picture, the pictures after IN are predicted from pictures before it, and without
+// them the video of the play item could begin only at its next random-access picture, up to a second
+// later (and the enhancement layer of Dolby Vision with it). The pictures before IN are decoded for
+// the ones after them and never presented: the demuxer marks their packets (DemuxPacket::decodeOnly)
+// by the time each one is presented, on the clock of its clip, against the IN time of the play item
+// its bytes were read for; the decoder leaves their pictures out.
+//
+// Pure, for the tests.
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace KODI::BLURAYPREROLL
+{
+
+//! The IN time (90 kHz, on the clock of its clip) of the play item of each byte that the input read
+class CPresentationStarts
+{
+public:
+  //! The bytes from readPos on are of a play item with this IN time; nothing when not known
+  void Begin(uint64_t readPos, std::optional<uint64_t> inTime)
+  {
+    // a play item opened again where nothing was read of the one before replaces it
+    while (!m_starts.empty() && m_starts.back().readPos >= readPos)
+      m_starts.pop_back();
+    if (!m_starts.empty() && m_starts.back().inTime == inTime)
+      return;
+    if (m_starts.size() == MAX_STARTS)
+      m_starts.erase(m_starts.begin());
+    m_starts.push_back({readPos, inTime});
+  }
+
+  //! A demuxer opens or a seek was made: what was read before is not asked for again
+  void Restart(uint64_t readPos, std::optional<uint64_t> inTime)
+  {
+    m_starts.clear();
+    m_starts.push_back({readPos, inTime});
+  }
+
+  void Clear() { m_starts.clear(); }
+
+  //! The IN time of the play item of the byte at readPos, or nothing
+  std::optional<uint64_t> At(uint64_t readPos) const
+  {
+    const auto it =
+        std::upper_bound(m_starts.begin(), m_starts.end(), readPos,
+                         [](uint64_t pos, const Start& start) { return pos < start.readPos; });
+    if (it == m_starts.begin())
+      return {};
+    return std::prev(it)->inTime;
+  }
+
+private:
+  struct Start
+  {
+    uint64_t readPos{0};
+    std::optional<uint64_t> inTime;
+  };
+  //! more than the play items of any playlist (999)
+  static constexpr size_t MAX_STARTS = 1024;
+  std::vector<Start> m_starts;
+};
+
+/*!
+ * \brief Whether a picture presented at \p pts (90 kHz, as the transport stream gives it, which
+ *        libavformat may have taken past the 33 bits of the clock) is presented before the IN time
+ *        \p inTime (90 kHz) of its play item. On the 33-bit clock: before by less than half of it.
+ */
+inline bool BeforeIn(int64_t pts, uint64_t inTime)
+{
+  constexpr int64_t WRAP = INT64_C(1) << 33;
+  const int64_t difference = (pts - static_cast<int64_t>(inTime % WRAP)) & (WRAP - 1);
+  return difference >= WRAP / 2;
+}
+
+} // namespace KODI::BLURAYPREROLL
