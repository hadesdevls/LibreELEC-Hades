From 28895be3bf43d1142b56a49d4412c5deb6069cd9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:59:48 +0000
Subject: [PATCH] tools/dvbridge: the enhancement layer's chroma on the base
 layer's chroma grid

"tools/dvbridge: chroma where the stream has it, and the chroma of the
even pixel in the transport" placed the chroma planes of an enhancement
layer by the layer's own chroma location, relative to the layer's luma,
which libplacebo then aligns with the base layer. That is not how Dolby
Vision composes the layers. ETSI GS CCM 001 composes them sample by
sample at the resolution and in the chroma format of the base layer: the
dequantization of the layer works on chroma blocks of PicWidthC x
PicHeightC (5.4.3.2), the residual is added to the base layer's mapped
chroma, and the chroma is upsampled afterwards. A layer of another size
is first resampled plane by plane onto the base layer's planes (annex B,
the reference: co-sited horizontally, centred vertically, the layer
siting that libplacebo gives the luma of a smaller layer). So a chroma
sample of the layer adds to the base layer's chroma sample it is
resampled to, wherever the base layer's chroma is, and the layer's own
chroma location does not enter.

align_layer_chroma() gives the layer's chroma planes, for each render,
the offset that puts them there in libplacebo's sample_el(): for a layer
k times smaller (1 or 2) and a base layer whose chroma has the offset
(bx, by), (1 + bx - k - layer_x) / k and by / k, with layer_x the
horizontal layer offset of sample_el() (-0.5 for a smaller layer). For a
1920x1080 layer on a top-left 3840x2160 base layer: chroma sample (m, q)
of the layer on base pixel 4m and row 4q + 1 (that commit: row 4q + 0.5;
before it: 4m + 1, 4q + 1.5). Anything but two 4:2:0 layers is left as
imported.

Measured on a software OpenGL ES, not on a GPU or a display: the response
to a raised chroma sample of the layer is where this says for both chroma
locations of each layer (siting test, model "layered"); in eight pictures
of a profile 7 FEL stream the reconstructed picture changes in 28 to 44 %
of the pixels of the six with a residual, mostly by one code of 4095, by
up to 9. The chroma sample of the layer now falls on a row of the base
layer every fourth row, where a scaled sample of an area at the offset
lands a few ULP beside it, and with libplacebo's dequantization as it was
the composed and the direct way took different sides there in up to
29208 chroma values of a picture (19 of them by two codes): this needs
libplacebo-9913 of the LibreELEC tree, with which they differ by one
code at most, in at most 0.05 % of the pixels.

On top of the composer of ETSI GS CCM 001 ("tools/dvbridge: compose the
picture as the composer of ETSI GS CCM 001 does", the default), which
resamples the enhancement layer onto the base layer as annex B.3 does
by itself: the chroma planes placed here reach the picture only where
libplacebo composes by its reshaping (dvccmcomposer off in
advancedsettings.xml, or a picture the clause does not cover). On top
of the notes of the renderer ("dvbridge: send the Dolby Vision metadata
as CCM 001 and dovi_tool describe it"): the layer is placed after them.
---
 tools/dvbridge/dvbridge_gl_frame.c |  6 ++--
 tools/dvbridge/dvbridge_gl_frame.h |  3 +-
 tools/dvbridge/dvbridge_render.c   | 53 ++++++++++++++++++++++++++++--
 3 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/tools/dvbridge/dvbridge_gl_frame.c b/tools/dvbridge/dvbridge_gl_frame.c
index 4916ea1..a84934c 100644
--- a/tools/dvbridge/dvbridge_gl_frame.c
+++ b/tools/dvbridge/dvbridge_gl_frame.c
@@ -64,9 +64,9 @@ bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
             plane->component_mapping[1] = 2;
     }
     /* Hades: the place of the chroma samples, as an offset of the subsampled planes (libplacebo
-     * takes them centred without one). It also reaches the planes of an enhancement layer, which
-     * libplacebo aligns with the base layer by it. A plane that is not subsampled (4:4:4) gets
-     * none. */
+     * takes them centred without one). A plane that is not subsampled (4:4:4) gets none. The
+     * chroma planes of an enhancement layer get theirs from the base layer when the two are
+     * drawn (align_layer_chroma() in dvbridge_render.c). */
     pl_frame_set_chroma_location(&candidate.frame, pl_chroma_from_av(chroma_location));
     *out = candidate;
     return true;
diff --git a/tools/dvbridge/dvbridge_gl_frame.h b/tools/dvbridge/dvbridge_gl_frame.h
index dd0f24b..1a36736 100644
--- a/tools/dvbridge/dvbridge_gl_frame.h
+++ b/tools/dvbridge/dvbridge_gl_frame.h
@@ -22,7 +22,8 @@ struct dvbridge_gl_frame {
  * the picture (AVFrame::chroma_location); unspecified is taken as "left", the default of HEVC and
  * of libplacebo. Without it the planes were taken as centred between the luma samples, which is
  * not where an HEVC stream has them: half a luma pixel off horizontally, and also vertically for
- * the "top left" of UHD Blu-ray. */
+ * the "top left" of UHD Blu-ray. For an enhancement layer the renderer places the chroma planes on
+ * the base layer's chroma grid instead, as Dolby Vision composes the layers. */
 #define DVBRIDGE_GL_FRAME_CHROMA 1
 bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
                              enum dvbridge_gl_layout layout, int width, int height,
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 1042c19..28a6eaf 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -425,6 +425,45 @@ static void step_down(struct pl_render_params *params, int level)
     params->dovi_ccm_plane_upscaler = level >= 3 ? &pl_filter_bilinear : faithful;
 }
 
+/* Hades: the chroma of an enhancement layer on the chroma grid of the base layer. ETSI GS CCM 001
+ * composes the two layers sample by sample at the resolution and in the chroma format of the base
+ * layer: each plane of the enhancement layer is resampled onto the base layer's plane of the same
+ * kind (annex B, the reference: co-sited horizontally, centred vertically, the layer siting that
+ * libplacebo gives the luma of a smaller layer), so a chroma sample of the layer adds to the base
+ * layer's chroma sample at that place, wherever the base layer's chroma is. The layer's own chroma
+ * location does not enter. libplacebo samples the layer's planes from the layer's luma grid
+ * (sample_el()), and places them by the offset of each plane: this is the offset of its chroma
+ * planes that puts them there. Both layers 4:2:0, the layer 1 or 2 times smaller; anything else is
+ * left as it was imported. */
+static void align_layer_chroma(const struct pl_frame *image, struct pl_frame *el)
+{
+    pl_tex bl_ref = image->planes[0].texture, el_ref = el->planes[0].texture;
+    const struct pl_plane *bl_chroma = NULL;
+    for (int i = 1; i < image->num_planes; ++i) {
+        pl_tex t = image->planes[i].texture;
+        if (2 * t->params.w == bl_ref->params.w && 2 * t->params.h == bl_ref->params.h)
+            bl_chroma = &image->planes[i];
+    }
+    const float kx = (float) bl_ref->params.w / el_ref->params.w;
+    const float ky = (float) bl_ref->params.h / el_ref->params.h;
+    if (!bl_chroma || (kx != 1 && kx != 2) || (ky != 1 && ky != 2))
+        return;
+    /* where sample_el() puts the layer's luma: half a sample of the base layer to the left of a
+     * centred one horizontally when the layer is smaller, centred vertically */
+    const float layer_x = kx > 1 ? -0.5f : 0.0f;
+    for (int i = 1; i < el->num_planes; ++i) {
+        struct pl_plane *plane = &el->planes[i];
+        pl_tex t = plane->texture;
+        if (2 * t->params.w != el_ref->params.w || 2 * t->params.h != el_ref->params.h)
+            continue;
+        /* chroma sample m of the layer lands on the base layer's chroma sample kx * m
+         * horizontally and between ky * q and ky * q + ky - 1 vertically; solved for the offset
+         * that sample_el() turns into that place */
+        plane->shift_x = (1.0f + bl_chroma->shift_x - kx - layer_x) / kx;
+        plane->shift_y = bl_chroma->shift_y / ky;
+    }
+}
+
 static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
                         const void *metadata, size_t bytes, double pts, double el_pts,
                         struct dvbridge_geometry geometry, pl_tex packed, bool flip,
@@ -475,7 +514,12 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         if (fresh)
             r->notes.reading = reading;
     }
-    struct pl_frame image = *source;
+    struct pl_frame image = *source, layer;
+    if (el) {
+        layer = *el;
+        align_layer_chroma(source, &layer);
+        image.enhancement_layer = &layer;
+    }
     mapped.repr.bits = source->repr.bits;
     mapped.repr.alpha = source->repr.alpha;
     image.repr = mapped.repr;
@@ -782,7 +826,12 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
                 .format = fmt, .sampleable = true, .renderable = true)))
             return false;
     }
-    struct pl_frame image = *source;
+    struct pl_frame image = *source, layer;
+    if (el) {
+        layer = *el;
+        align_layer_chroma(source, &layer);
+        image.enhancement_layer = &layer;
+    }
     mapped.repr.bits = source->repr.bits;
     mapped.repr.alpha = source->repr.alpha;
     image.repr = mapped.repr;
-- 
2.53.0

