From 1cec3faeec84327bec68b37413b2d429f5c1a0dc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 11 Oct 2026 09:14:48 +0000
Subject: [PATCH] windowing/gbm: hold no graphics device open while they are
 looked at

A display on a graphics device that the kernel's console does not drive
is connected and off, and it comes on when the last one to have that
device open closes it: the choice of the output relies on that, looking
at every device twice. When no display has answered yet, right after a
cold boot, the pass ends with the last device it tried still open, and
is made again half a second later. The device that was left open then
could not be closed for the last time by the look, and its display
stayed off: Kodi came up on the display of the other device, and on
this one at every later start.

What an earlier pass left open is closed before the devices are looked
at. The log says when they are looked at a second time.

Found by the independent review of the choice of the output. Read, not
run: it takes two graphics devices and displays that answer late.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 1dff522..dd51190 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -212,7 +212,10 @@ std::vector<SurveyedDevice> Survey(const std::vector<drmDevicePtr>& devices, boo
   // look finds it on. Without it the first start after a boot would show Kodi on one display
   // and every later one on another.
   if (AnyOutputOff(FitOutputs(found)))
+  {
+    CLog::LogF(LOGINFO, "a display is connected and off: the graphics devices are looked at again");
     look();
+  }
 
   return found;
 }
@@ -713,6 +716,18 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
     if (settings)
       asked = settings->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR);
 
+    // A pass that found no display leaves the last device that it tried open (it is tried again:
+    // CDRMAtomic::InitDrm()). A device that is held open does not put its console back when
+    // Look() closes it, so its display would stay off for this look as well: nothing is held
+    // while the devices are looked at.
+    m_connector = nullptr;
+    m_connectors.clear();
+    if (m_fd >= 0)
+    {
+      close(m_fd);
+      m_fd = -1;
+    }
+
     const std::vector<SurveyedDevice> found = Survey(devices, atomic);
     if (!found.empty())
     {
