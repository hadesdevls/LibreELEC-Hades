diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h
new file mode 100644
index 0000000..0fc6c5f
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h
@@ -0,0 +1,101 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace ActiveAE::INTERNAL
+{
+//! An output of the driver of a configured one, as FollowedDisplayOutput() needs to know it
+struct FollowCandidate
+{
+  //! As CAEDeviceInfo::Display: what the driver says of a display on the output
+  enum class Display
+  {
+    UNKNOWN,
+    ABSENT,
+    PRESENT,
+  };
+
+  std::string name; //!< the driver's name of the output (CAEDeviceInfo::m_deviceName)
+  Display display{Display::UNKNOWN};
+  bool usable{false}; //!< it can be used for this kind of output (PCM, or passthrough)
+};
+
+/*!
+ * \brief Hades: the output that the engine uses for a configured one (CActiveAESink::FollowDisplay())
+ * \param outputs the outputs of the driver of the configured output
+ * \param configured the name of the configured output
+ * \param configuredIsDisplayOutput the configured output is an HDMI or DisplayPort one by its name;
+ *        asked only when it is not among the outputs
+ * \param followed the name of the output of that driver that this setting followed before; empty
+ *        when none
+ * \return the index in outputs of the output to use in place of the configured one; -1: the
+ *         configured one
+ *
+ * An HDMI or DisplayPort output without a display plays to nothing. When the driver says that the
+ * configured output has no display, and exactly one output of the driver that can be used for this
+ * kind of output has one, that one is used. The same goes for a configured HDMI or DisplayPort
+ * output that is not there at all in this start: the output of a graphics chip that is turned off
+ * (a laptop switched to its dedicated graphics, where the output of the integrated one was
+ * chosen before). With several displays the choice stays with the user. With none, the output
+ * that was followed to stays in use while it is there, has no display either and is not the
+ * configured one (a TV that is switched off, and an instant of every change of the display mode).
+ * An output whose driver cannot tell (UNKNOWN), and a configured output that is not there and is
+ * no HDMI or DisplayPort one, are not followed away from.
+ */
+inline int FollowedDisplayOutput(const std::vector<FollowCandidate>& outputs,
+                                 const std::string& configured,
+                                 bool configuredIsDisplayOutput,
+                                 const std::string& followed)
+{
+  int at = -1;
+  for (size_t i = 0; i < outputs.size(); ++i)
+  {
+    if (outputs[i].name == configured)
+    {
+      at = static_cast<int>(i);
+      break;
+    }
+  }
+
+  if (at >= 0 ? outputs[at].display != FollowCandidate::Display::ABSENT
+              : !configuredIsDisplayOutput)
+    return -1;
+
+  int first = -1;
+  unsigned int displays = 0;
+  for (size_t i = 0; i < outputs.size(); ++i)
+  {
+    if (outputs[i].display != FollowCandidate::Display::PRESENT || !outputs[i].usable)
+      continue;
+
+    if (displays++ == 0)
+      first = static_cast<int>(i);
+  }
+
+  if (displays == 1)
+    return first;
+
+  // several displays: the choice stays with the user
+  if (displays > 1 || followed.empty() || followed == configured)
+    return -1;
+
+  for (size_t i = 0; i < outputs.size(); ++i)
+  {
+    if (outputs[i].name == followed)
+      return outputs[i].display == FollowCandidate::Display::ABSENT && outputs[i].usable
+                 ? static_cast<int>(i)
+                 : -1;
+  }
+  return -1;
+}
+} // namespace ActiveAE::INTERNAL
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index 626aa53..6a8749f 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -9,6 +9,7 @@
 #include "ActiveAESink.h"
 
 #include "ActiveAE.h"
+#include "ActiveAEFollowDisplay.h"
 #include "cores/AudioEngine/AEResampleFactory.h"
 #include "cores/AudioEngine/Sinks/AESinkNULL.h"
 #include "cores/AudioEngine/Utils/AEBitstreamPacker.h"
@@ -800,25 +801,13 @@ const CAEDeviceInfo* DisplayOutputInstead(const AE::AESinkInfo& sink,
   return DisplayOutputs(sink, passthrough, found) == 1 ? found : nullptr;
 }
 
-// The output that was followed to, when it is another output of the same driver that reports
-// displays and, like every other one, has none right now.
-const CAEDeviceInfo* FollowedOutput(const AE::AESinkInfo& sink,
-                                    const CAEDeviceInfo& configured,
-                                    const std::string& followed,
-                                    bool passthrough)
+// Hades: whether a device that is not there was an HDMI or DisplayPort output, by its name: the
+// ALSA sink names those outputs "hdmi:CARD=...,DEV=..." (CAESinkALSA, from the "hdmi" PCM of each
+// card, HDMI and DisplayPort alike). Other sinks have no such names: their devices that are not
+// there are not followed away from.
+bool NamesDisplayOutput(const AESinkDevice& dev)
 {
-  const AESinkDevice dev = CAESinkFactory::ParseDevice(followed);
-  if (dev.driver != sink.m_sinkName || dev.name.empty() || dev.name == configured.m_deviceName)
-    return nullptr;
-
-  for (const auto& other : sink.m_deviceInfoList)
-  {
-    if (other.m_deviceName == dev.name)
-      return other.m_display == CAEDeviceInfo::Display::ABSENT && IsUsableFor(other, passthrough)
-                 ? &other
-                 : nullptr;
-  }
-  return nullptr;
+  return dev.driver == "ALSA" && dev.name.starts_with("hdmi:");
 }
 } // unnamed namespace
 
@@ -833,10 +822,21 @@ const CAEDeviceInfo* FollowedOutput(const AE::AESinkInfo& sink,
 // sink (two times of 0.65 s in a session of 2026-10-03, when the output returned from HDR to
 // SDR). Only an output that was followed to is kept: the configured output is never left for one
 // without a display.
+//
+// Hades: a configured HDMI or DisplayPort output that is not there at all is followed away from
+// the same way: the output of the integrated graphics of a laptop that was started with its
+// dedicated graphics only (no such device in this start). Kodi validated it to another output of
+// the same card when it started (ValidateOutputDevices(), its analog output there), but every new
+// stream reloads the settings and opened the device that is not there, which left the engine
+// without a sink (a report of 2026-10-17: no sound in a whole session, with the TV on the only
+// HDMI output that had a display). The decision is ActiveAE::INTERNAL::FollowedDisplayOutput().
 std::string CActiveAESink::FollowDisplay(const std::string& device,
                                          const std::string& followed,
-                                         bool passthrough) const
+                                         bool passthrough,
+                                         bool* missing) const
 {
+  if (missing)
+    *missing = false;
   const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
   if (dev.driver.empty() || dev.name.empty())
     return device;
@@ -846,23 +846,32 @@ std::string CActiveAESink::FollowDisplay(const std::string& device,
     if (sink.m_sinkName != dev.driver)
       continue;
 
+    using INTERNAL::FollowCandidate;
+    std::vector<FollowCandidate> outputs;
+    outputs.reserve(sink.m_deviceInfoList.size());
+    bool there = false;
     for (const auto& d : sink.m_deviceInfoList)
     {
-      if (d.m_deviceName != dev.name)
-        continue;
-
-      if (d.m_display != CAEDeviceInfo::Display::ABSENT)
-        return device;
-
-      const CAEDeviceInfo* other = nullptr;
-      const unsigned int displays = DisplayOutputs(sink, passthrough, other);
-      if (displays == 0)
-        other = FollowedOutput(sink, d, followed, passthrough);
-      else if (displays > 1)
-        other = nullptr; // several displays: the choice stays with the user
-
-      return other ? other->ToDeviceString(sink.m_sinkName) : device;
+      FollowCandidate candidate;
+      candidate.name = d.m_deviceName;
+      candidate.display = d.m_display == CAEDeviceInfo::Display::PRESENT
+                              ? FollowCandidate::Display::PRESENT
+                          : d.m_display == CAEDeviceInfo::Display::ABSENT
+                              ? FollowCandidate::Display::ABSENT
+                              : FollowCandidate::Display::UNKNOWN;
+      candidate.usable = IsUsableFor(d, passthrough);
+      outputs.push_back(std::move(candidate));
+      there = there || d.m_deviceName == dev.name;
     }
+
+    // (only an output of the same driver is followed to)
+    const AESinkDevice was = CAESinkFactory::ParseDevice(followed);
+    const int other = INTERNAL::FollowedDisplayOutput(
+        outputs, dev.name, NamesDisplayOutput(dev),
+        was.driver == sink.m_sinkName ? was.name : std::string());
+    if (missing)
+      *missing = !there;
+    return other >= 0 ? sink.m_deviceInfoList[other].ToDeviceString(sink.m_sinkName) : device;
   }
   return device;
 }
