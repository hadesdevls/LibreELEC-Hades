diff --git a/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp
new file mode 100644
index 0000000..22cee45
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Sinks/test/TestActiveAEFollowDisplay.cpp
@@ -0,0 +1,142 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/AudioEngine/Engines/ActiveAE/ActiveAEFollowDisplay.h"
+
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using ActiveAE::INTERNAL::FollowCandidate;
+using ActiveAE::INTERNAL::FollowedDisplayOutput;
+
+namespace
+{
+constexpr auto PRESENT = FollowCandidate::Display::PRESENT;
+constexpr auto ABSENT = FollowCandidate::Display::ABSENT;
+constexpr auto UNKNOWN = FollowCandidate::Display::UNKNOWN;
+
+FollowCandidate Output(const char* name, FollowCandidate::Display display, bool usable = true)
+{
+  FollowCandidate c;
+  c.name = name;
+  c.display = display;
+  c.usable = usable;
+  return c;
+}
+
+// The outputs of the ALSA driver of a laptop started with its dedicated graphics only, as a
+// report of 2026-10-17 lists them: the HDMI output of the integrated graphics
+// ("hdmi:CARD=PCH,DEV=0", chosen in an earlier start) is not there; the TV is on the first output
+// of the NVIDIA graphics.
+std::vector<FollowCandidate> ZBook()
+{
+  return {Output("@", UNKNOWN), Output("@:CARD=PCH,DEV=0", UNKNOWN),
+          Output("hdmi:CARD=NVidia,DEV=0", PRESENT), Output("hdmi:CARD=NVidia,DEV=1", ABSENT),
+          Output("hdmi:CARD=NVidia,DEV=2", ABSENT), Output("hdmi:CARD=NVidia,DEV=3", ABSENT)};
+}
+
+// Two graphics chips with HDMI outputs, the TV on the NVIDIA one
+std::vector<FollowCandidate> TwoChips()
+{
+  return {Output("hdmi:CARD=NVidia,DEV=0", PRESENT), Output("hdmi:CARD=NVidia,DEV=1", ABSENT),
+          Output("hdmi:CARD=Generic,DEV=0", ABSENT), Output("hdmi:CARD=Generic,DEV=1", ABSENT)};
+}
+} // namespace
+
+TEST(TestActiveAEFollowDisplay, AConfiguredOutputWithADisplayStays)
+{
+  EXPECT_EQ(-1, FollowedDisplayOutput(TwoChips(), "hdmi:CARD=NVidia,DEV=0", true, ""));
+}
+
+TEST(TestActiveAEFollowDisplay, AnOutputWithoutADisplayFollowsTheOnlyOneWithADisplay)
+{
+  // the setting on the HDMI output of the other graphics chip
+  EXPECT_EQ(0, FollowedDisplayOutput(TwoChips(), "hdmi:CARD=Generic,DEV=0", true, ""));
+}
+
+TEST(TestActiveAEFollowDisplay, AnOutputWhoseDriverCannotTellStays)
+{
+  std::vector<FollowCandidate> outputs = TwoChips();
+  outputs[2].display = UNKNOWN;
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true, ""));
+}
+
+TEST(TestActiveAEFollowDisplay, SeveralDisplaysLeaveTheChoiceToTheUser)
+{
+  std::vector<FollowCandidate> outputs = TwoChips();
+  outputs[1].display = PRESENT;
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true, ""));
+  // ... also for an output that is not there
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=PCH,DEV=0", true, ""));
+  // ... and an output that was followed before is not kept then
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true,
+                                      "hdmi:CARD=Generic,DEV=1"));
+}
+
+TEST(TestActiveAEFollowDisplay, OnlyAnOutputThatCanBeUsedCounts)
+{
+  // passthrough: the output with the display cannot pass through (an analog one, or only PCM)
+  std::vector<FollowCandidate> outputs = TwoChips();
+  outputs[0].usable = false;
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true, ""));
+  // ... and a second display that cannot be used does not make two
+  outputs = TwoChips();
+  outputs[1].display = PRESENT;
+  outputs[1].usable = false;
+  EXPECT_EQ(0, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true, ""));
+}
+
+TEST(TestActiveAEFollowDisplay, WithoutADisplayTheOutputThatWasFollowedStays)
+{
+  std::vector<FollowCandidate> outputs = TwoChips();
+  outputs[0].display = ABSENT; // the TV is off
+  EXPECT_EQ(0, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true,
+                                     "hdmi:CARD=NVidia,DEV=0"));
+  // nothing was followed: the configured one
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true, ""));
+  // what was followed is the configured one, or not there, or cannot be used: the configured one
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true,
+                                      "hdmi:CARD=Generic,DEV=0"));
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true,
+                                      "hdmi:CARD=NVidia,DEV=9"));
+  outputs[0].usable = false;
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=Generic,DEV=0", true,
+                                      "hdmi:CARD=NVidia,DEV=0"));
+}
+
+TEST(TestActiveAEFollowDisplay, AnHdmiOutputThatIsNotThereFollowsTheOnlyDisplay)
+{
+  // the report of 2026-10-17: the TV's output, not the analog one that Kodi validated it to
+  EXPECT_EQ(2, FollowedDisplayOutput(ZBook(), "hdmi:CARD=PCH,DEV=0", true, ""));
+}
+
+TEST(TestActiveAEFollowDisplay, AnHdmiOutputThatIsNotThereWithoutADisplayAnywhere)
+{
+  std::vector<FollowCandidate> outputs = ZBook();
+  outputs[2].display = ABSENT;
+  // nothing followed before: the configured one (Kodi validates it, as before)
+  EXPECT_EQ(-1, FollowedDisplayOutput(outputs, "hdmi:CARD=PCH,DEV=0", true, ""));
+  // followed before: that one, while the TV is off
+  EXPECT_EQ(2, FollowedDisplayOutput(outputs, "hdmi:CARD=PCH,DEV=0", true,
+                                     "hdmi:CARD=NVidia,DEV=0"));
+}
+
+TEST(TestActiveAEFollowDisplay, AnOutputThatIsNotThereAndIsNoDisplayOutputStays)
+{
+  // a USB sound card that is unplugged: Kodi's own validation, as before
+  EXPECT_EQ(-1, FollowedDisplayOutput(ZBook(), "@:CARD=Device,DEV=0", false, ""));
+  EXPECT_EQ(-1, FollowedDisplayOutput(ZBook(), "@:CARD=Device,DEV=0", false,
+                                      "hdmi:CARD=NVidia,DEV=0"));
+}
+
+TEST(TestActiveAEFollowDisplay, ADriverWithoutOutputs)
+{
+  EXPECT_EQ(-1, FollowedDisplayOutput({}, "hdmi:CARD=PCH,DEV=0", true, ""));
+}
-- 
