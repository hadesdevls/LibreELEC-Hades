+void ReportBdjError(const BdjReport& opened, std::string_view where)
+{
+  BdjReport report = opened;
+  if (report.state == BdjState::READY)
+    report.state = BdjState::START_FAILED;
+  CLog::Log(LOGWARNING, "{} - {}", where, DescribeBdj(report.state, report.facts, report.version));
+  NotifyBdj(report);
+}
