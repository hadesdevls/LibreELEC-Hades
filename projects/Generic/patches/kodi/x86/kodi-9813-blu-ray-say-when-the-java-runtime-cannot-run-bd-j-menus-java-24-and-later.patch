diff --git a/xbmc/filesystem/BlurayJava.h b/xbmc/filesystem/BlurayJava.h
index 332e2fa..9323a9b 100644
--- a/xbmc/filesystem/BlurayJava.h
+++ b/xbmc/filesystem/BlurayJava.h
@@ -38,8 +38,54 @@ enum class BdjState
   RESTART_NEEDED, //!< the add-on is installed, but this Kodi was started before it
   RUNTIME_NOT_LOADABLE, //!< JAVA_HOME is in effect (the add-on's or another), no JVM loads from it
   NO_JAR, //!< a JVM loads, the jar of this libbluray version was not found
+  RUNTIME_TOO_NEW, //!< a JVM loads and the jar was found, but it is Java 24 or later
+  START_FAILED, //!< everything was found, and libbluray could not start the disc's Java
 };
 
+/*!
+ * \brief The first Java without a security manager (JEP 486, Java 24).
+ *
+ * libbluray runs the Java code of a disc only under its own security manager
+ * (org.videolan.BDJSecurityManager), which keeps that code to the disc: it fails closed when it
+ * cannot install it, and from Java 24 on System.setSecurityManager() always throws. Such a
+ * runtime loads, and libbluray's own check says yes; the menus then do not start
+ * (BD_ERROR_BDJ).
+ */
+inline constexpr int FIRST_JAVA_WITHOUT_SECURITY_MANAGER = 24;
+
+/*!
+ * \brief The feature version of a Java version string, as JAVA_VERSION of a runtime's
+ *        "release" file gives it: "1.8.0_462" is 8, "25.0.4" is 25, "17" is 17; 0 when it is
+ *        not one.
+ */
+inline int JavaFeatureVersion(std::string_view version)
+{
+  const auto number = [](std::string_view s, size_t& pos)
+  {
+    int n = 0;
+    size_t digits = 0;
+    while (pos < s.size() && s[pos] >= '0' && s[pos] <= '9' && digits < 6)
+    {
+      n = n * 10 + (s[pos] - '0');
+      pos++;
+      digits++;
+    }
+    return digits ? n : -1;
+  };
+  size_t pos = 0;
+  const int first = number(version, pos);
+  if (first <= 0)
+    return 0;
+  if (first != 1)
+    return first;
+  // the old scheme, 1.<feature>.<...>
+  if (pos >= version.size() || version[pos] != '.')
+    return 0;
+  pos++;
+  const int second = number(version, pos);
+  return second > 0 ? second : 0;
+}
+
 //! The Java runtime add-on of LibreELEC's repository
 inline constexpr std::string_view JRE_ADDON_ID = "tools.jre.zulu";
 
@@ -51,6 +97,7 @@ struct BdjFacts
   std::string libraryPath; //!< LD_LIBRARY_PATH of this process
   bool addonInstalled = false; //!< the Java runtime add-on is installed, enabled or not
   std::string addonPath; //!< its folder
+  std::string javaVersion; //!< JAVA_VERSION of $JAVA_HOME/release, empty when not known
 };
 
 //! A folder without the slashes at its end ("/" stays "/")
@@ -98,7 +145,9 @@ inline bool AddonInEffect(const BdjFacts& facts)
 inline BdjState DecideBdj(const BdjFacts& facts)
 {
   if (facts.bdjHandled)
-    return BdjState::READY;
+    return JavaFeatureVersion(facts.javaVersion) >= FIRST_JAVA_WITHOUT_SECURITY_MANAGER
+               ? BdjState::RUNTIME_TOO_NEW
+               : BdjState::READY;
   if (facts.libjvmDetected)
     return BdjState::NO_JAR;
   if (facts.addonInstalled)
@@ -125,6 +174,10 @@ inline BdjMessageIds BdjMessage(BdjState state)
       return {39868, 32121}; // {0}: JAVA_HOME
     case BdjState::NO_JAR:
       return {39869, 32122}; // {0}: the version of libbluray
+    case BdjState::RUNTIME_TOO_NEW:
+      return {39884, 32287}; // {0}: the version of Java
+    case BdjState::START_FAILED:
+      return {39885, 32288}; // {0}: JAVA_HOME
     case BdjState::READY:
       break;
   }
@@ -168,6 +221,17 @@ inline std::string DescribeBdj(BdjState state, const BdjFacts& facts, std::strin
       return "Blu-ray Java menus cannot run: a JVM loads (JAVA_HOME " + home + "), but " + jar +
              " and libbluray-awt-j2se-" + std::string(version) +
              ".jar were not found; the jar of another libbluray version cannot be used";
+    case BdjState::RUNTIME_TOO_NEW:
+      return "Blu-ray Java menus cannot run: the JVM of JAVA_HOME " + home + " is Java " +
+             facts.javaVersion +
+             ", which has no security manager (Java 24 and later), and libbluray does not run "
+             "the Java code of a disc without its own";
+    case BdjState::START_FAILED:
+      return "Blu-ray Java menus did not start: libbluray " + std::string(version) +
+             " found a JVM (JAVA_HOME " + home + ", Java " +
+             (facts.javaVersion.empty() ? std::string("of a version not known")
+                                        : facts.javaVersion) +
+             ") and " + jar + ", and reported a BD-J error (its lines above say which)";
   }
   return {};
 }
@@ -193,5 +257,12 @@ std::string BdjUserText(const BdjReport& report);
 //! A notification with that message (nothing for READY)
 void NotifyBdj(const BdjReport& report);
 
+/*!
+ * \brief libbluray reported a BD-J error (BD_ERROR_BDJ) on a disc that was opened with this
+ *        report: say it in kodi.log, and tell the user why where Kodi knows. A report that said
+ *        the menus can run becomes START_FAILED; one that said why not is told as it is.
+ */
+void ReportBdjError(const BdjReport& opened, std::string_view where);
+
 } // namespace BLURAYJAVA
 } // namespace KODI
