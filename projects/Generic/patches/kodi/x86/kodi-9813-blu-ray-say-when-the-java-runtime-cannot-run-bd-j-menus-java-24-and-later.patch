+      std::string value = line.substr(key.size());
+      StringUtils::Trim(value);
+      StringUtils::Trim(value, "\"");
+      if (value.size() < 32)
+        facts.javaVersion = value;
+      break;
+    }
+  }
 
   ADDON::AddonPtr addon;
   if (CServiceBroker::GetAddonMgr().GetAddon(std::string(JRE_ADDON_ID), addon,
@@ -85,6 +104,12 @@ std::string BdjUserText(const BdjReport& report)
                                                        : report.facts.javaHome);
   else if (report.state == BdjState::NO_JAR)
     StringUtils::Replace(text, "{0}", report.version);
+  else if (report.state == BdjState::RUNTIME_TOO_NEW)
+    StringUtils::Replace(text, "{0}", report.facts.javaVersion);
+  else if (report.state == BdjState::START_FAILED)
+    StringUtils::Replace(text, "{0}",
+                         report.facts.javaHome.empty() ? std::string("JAVA_HOME")
