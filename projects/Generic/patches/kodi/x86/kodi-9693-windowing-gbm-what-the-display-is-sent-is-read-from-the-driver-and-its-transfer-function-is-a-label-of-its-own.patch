+CHDROutputRead::Eotf CWinSystemGbm::ReadOutputEotf()
+{
+  // (the layout that CHDROutputRead::Parse() reads, as the kernel has it)
+  static_assert(sizeof(hdr_output_metadata) == CHDROutputRead::BLOB_SIZE);
+  static_assert(offsetof(hdr_output_metadata, metadata_type) == CHDROutputRead::TYPE_OFFSET);
+  static_assert(offsetof(hdr_output_metadata, hdmi_metadata_type1.eotf) ==
+                CHDROutputRead::EOTF_OFFSET);
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty("HDR_OUTPUT_METADATA"))
+    return CHDROutputRead::Eotf::NO_PROPERTY;
+  // (the value as the kernel took it with the last commit that it accepted: no call to the kernel)
+  return ReadOutputEotfOf(connector->GetPropertyValue("HDR_OUTPUT_METADATA"));
+}
+
+CHDROutputRead::Eotf CWinSystemGbm::ReadOutputEotfOf(std::optional<uint64_t> id)
+{
+  const int fd = m_DRM ? m_DRM->GetFileDescriptor() : -1;
+  return m_outputEotf.Get(id,
+                          [fd](uint64_t blobId)
+                          {
+                            std::unique_ptr<drmModePropertyBlobRes,
+                                            decltype(&drmModeFreePropertyBlob)>
+                                blob(fd >= 0 ? drmModeGetPropertyBlob(fd, static_cast<uint32_t>(blobId))
+                                             : nullptr,
+                                     &drmModeFreePropertyBlob);
+                            return blob ? CHDROutputRead::Parse(
+                                              static_cast<const uint8_t*>(blob->data), blob->length)
+                                        : CHDROutputRead::Eotf::UNREADABLE;
+                          });
+}
