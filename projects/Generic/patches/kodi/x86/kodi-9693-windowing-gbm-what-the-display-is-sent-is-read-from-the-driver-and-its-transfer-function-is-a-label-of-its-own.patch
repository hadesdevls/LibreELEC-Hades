+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <optional>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief What the HDMI output signals as its transfer function (EOTF), as the driver holds it
+ *
+ * Kodi's own state (CWinSystemGbm::GetEotf()) is what Kodi asked for; the kernel may hold
+ * something else (a commit that it refused, metadata that another request carried). The truth for
+ * a skin, an add-on or a person is the blob of the connector's HDR_OUTPUT_METADATA property: its
+ * `hdmi_metadata_type1.eotf` (0 traditional gamma SDR, 1 traditional gamma HDR, 2 PQ, 3 HLG,
+ * CTA-861-G). It is read once for each id of the blob (an id names a blob that never changes), not
+ * for each frame, and the labels that say what the display is sent (Player.Process(
+ * videooutputhdrtype, videooutputeotf)) come from that reading.
+ *
+ * Nothing of DRM is here: the layout of struct hdr_output_metadata (include/uapi/drm/drm_mode.h,
+ * 32 bytes: a u32 metadata_type, then struct hdr_metadata_infoframe, whose first byte is the EOTF)
+ * is written out, and WinSystemGbm.cpp checks it against the real structure at compile time. A
+ * test runs it on the host with blobs made by hand.
+ */
+class CHDROutputRead
+{
+public:
+  //! What the output signals
+  enum class Eotf
+  {
+    NO_PROPERTY, //!< the connector has no HDR_OUTPUT_METADATA: not known
+    NO_BLOB, //!< it has it, with no blob set: no HDR InfoFrame goes out (SDR)
+    SDR, //!< traditional gamma, SDR luminance range
+    HDR_GAMMA, //!< traditional gamma, HDR luminance range
+    PQ, //!< SMPTE ST 2084
+    HLG, //!< ARIB STD-B67
+    UNREADABLE, //!< a blob that is not what the kernel makes, or one that could not be read: not known
+  };
+
+  static constexpr size_t BLOB_SIZE = 32; //!< sizeof(struct hdr_output_metadata)
+  static constexpr size_t TYPE_OFFSET = 0; //!< metadata_type (u32)
+  static constexpr size_t EOTF_OFFSET = 4; //!< hdmi_metadata_type1.eotf (u8)
+
+  //! What the content of a blob says; the kernel makes only blobs of this size (it refuses the
+  //! property otherwise), with metadata_type 0 (HDMI static metadata type 1, the only one there is)
+  static Eotf Parse(const uint8_t* data, size_t length)
+  {
+    if (!data || length < BLOB_SIZE)
+      return Eotf::UNREADABLE;
+    uint32_t type = 0;
+    std::memcpy(&type, data + TYPE_OFFSET, sizeof(type));
+    if (type != 0)
+      return Eotf::UNREADABLE;
+    switch (data[EOTF_OFFSET])
+    {
+      case 0:
+        return Eotf::SDR;
+      case 1:
+        return Eotf::HDR_GAMMA;
+      case 2:
+        return Eotf::PQ;
+      case 3:
+        return Eotf::HLG;
+      default:
+        return Eotf::UNREADABLE;
+    }
+  }
+
+  //! Player.Process(videooutputeotf): `sdr`, `hdrgamma`, `pq`, `hlg`; empty where it is not known.
+  //! No blob is no HDR InfoFrame, which a display takes as SDR.
+  static const char* Label(Eotf eotf)
+  {
+    switch (eotf)
+    {
+      case Eotf::NO_BLOB:
+      case Eotf::SDR:
+        return "sdr";
+      case Eotf::HDR_GAMMA:
+        return "hdrgamma";
+      case Eotf::PQ:
+        return "pq";
+      case Eotf::HLG:
+        return "hlg";
+      default:
+        return "";
+    }
+  }
+
+  /*!
+   * \brief Player.Process(videooutputhdrtype): what the display is sent
+   * \param nativeDV native Dolby Vision has the output: it goes in the vendor InfoFrame, and the
+   *        HDR static metadata InfoFrame is not what says it
+   * \param plus HDR10+ metadata go with the PQ
+   * \return `dolbyvision`, `hdr10plus`, `hdr10` (PQ with static metadata), `hlg`, `sdr`; empty where
+   *         the driver does not say (no property, a blob that cannot be read) or says an HDR
+   *         range with traditional gamma, which has no name among these
+   */
+  static std::string HdrType(bool nativeDV, Eotf eotf, bool plus)
+  {
+    if (nativeDV)
+      return "dolbyvision";
+    switch (eotf)
+    {
+      case Eotf::PQ:
+        return plus ? "hdr10plus" : "hdr10";
+      case Eotf::HLG:
+        return "hlg";
+      case Eotf::SDR:
+      case Eotf::NO_BLOB:
+        return "sdr";
+      default:
+        return "";
+    }
+  }
+
+  /*!
+   * \brief The reading of the blob for an id: the blob is read (with \p readBlob, which gives the
+   *        EOTF of the blob of an id) only when the id is not the one read last
+   * \param id the value of HDR_OUTPUT_METADATA; none where the connector has no such property
+   */
+  template<typename ReadBlob>
+  Eotf Get(std::optional<uint64_t> id, ReadBlob readBlob)
+  {
+    if (!id)
+      return Eotf::NO_PROPERTY;
+    if (*id == 0)
+      return Eotf::NO_BLOB;
+    std::lock_guard lock(m_lock);
+    if (!m_id || *m_id != *id)
+    {
+      const Eotf read = readBlob(*id);
+      ++m_reads;
+      // (a blob that could not be read is asked for again: it may be a call that failed)
+      if (read == Eotf::UNREADABLE)
+        return read;
+      m_eotf = read;
+      m_id = *id;
+    }
+    return m_eotf;
+  }
+
+  //! How many blobs were read (for the test, and the log)
+  unsigned Reads() const
+  {
+    std::lock_guard lock(m_lock);
+    return m_reads;
+  }
+
+private:
+  mutable std::mutex m_lock;
+  std::optional<uint64_t> m_id;
+  Eotf m_eotf = Eotf::UNREADABLE;
+  unsigned m_reads = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
