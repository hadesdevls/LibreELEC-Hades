From 97ec79891419c77ae023d284c1e6d66c4cbad561 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 10 Oct 2026 01:32:48 +0200
Subject: [PATCH] [filesystem] Lock the cache in CDirectoryCache::ClearFile()

ClearFile() erases from m_cache without holding m_cs, unlike every other
function that accesses the cache. CFile::Delete() calls it on job
threads, while other threads look up the cache in FileExists() or
GetDirectory().

(cherry picked from commit f66b6c42342ffc3c25e7fe5f6b4c0dd8c07095e3)
---
 xbmc/filesystem/DirectoryCache.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/xbmc/filesystem/DirectoryCache.cpp b/xbmc/filesystem/DirectoryCache.cpp
index bf23248..78a938a 100644
--- a/xbmc/filesystem/DirectoryCache.cpp
+++ b/xbmc/filesystem/DirectoryCache.cpp
@@ -126,6 +126,8 @@ void CDirectoryCache::SetDirectory(const CURL& url, const CFileItemList& items,
 
 void CDirectoryCache::ClearFile(const CURL& url)
 {
+  std::unique_lock lock(m_cs);
+
   const std::string dirPath = getDirKey(url);
   m_cache.erase(dirPath);
 }
