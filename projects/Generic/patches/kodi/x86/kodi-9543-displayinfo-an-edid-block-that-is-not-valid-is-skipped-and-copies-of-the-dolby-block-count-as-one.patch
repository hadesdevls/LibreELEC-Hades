From 84934ae4f37f56d77ca9664feb89d24fe03fed13 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:13:02 +0000
Subject: [PATCH] DisplayInfo: an EDID block that is not valid is skipped, and
 copies of the Dolby block count as one

ScanDolbyVideo(), the Dolby VSVDB rule that Kodi shares with the kernel
backends (drm_dvbridge.h of linux-9984), refused the whole EDID for one
extension block with a wrong checksum or a CTA block that is not well
formed, and for the Dolby block twice. DRM takes the blocks with a wrong
checksum out before amdgpu and i915 read the EDID (and before Kodi reads
it from them); NVIDIA's driver passes on the blocks past the extension
count of the base block without checking them, so on NVIDIA one bad
block there left a TV without native Dolby Vision ("the display does not
advertise Dolby Vision Standard", RTX 5090 with an LG G6: the cause is
not known, and this is one of the two that fit what was seen).

Now, with the same rule in the kernel:
- an extension block that is not valid (a wrong checksum, a CTA block
  whose data blocks end out of it, a data block that runs past them) is
  skipped and nothing of it is taken: not its Dolby VSVDB (fail closed),
  not its QS; a base block that is not valid still refuses the EDID;
- copies of the Dolby VSVDB, byte for byte the same, count as one (an
  EDID read with blocks twice, as when a read of its E-DDC segments gives
  the first ones again, has it twice); two different ones are refused;
- a Dolby VSVDB that is seen and not taken (in a skipped block, several,
  too short) makes SupportsDolbyVision() true, so that the reason is
  "invalid", also past the extension count, where libdisplay-info 0.4
  does not read;
- QS is also read from the blocks past the extension count, as the
  kernel reads it for the Standard tunnel (libdisplay-info stops at the
  count);
- the log says how many blocks were skipped and whether the block was
  there more than once, and EdidShapeOf() gives the shape of an EDID in
  one line: bytes and blocks, the extension count of the base block, the
  HDMI Forum EEODB, the tag and the validity of each block, every place
  of the Dolby OUI (46 d0 00) and the bytes of each Dolby VSVDB, bounded;
- EdidBaseBlockCopy(): the first extension block that is block 0 again,
  a sign of an EDID not read whole.

Tested on the host: the three-way test of the rule against i915's and
amdgpu's copies and the walk of drm_dvbridge.h (every form of one block,
also twice, next to a different one, next to blocks that are not valid
and after a base block that is not, and 2 000 000 mutations), the corpus
of real EDIDs against an independent writing of the rule (none of the
614 distinct EDIDs changes its verdict), the shape line under ASan and
UBSan, and mutations of both rules, each caught.
---
 xbmc/utils/DisplayInfo.cpp | 193 ++++++++++++++++++++++++++++++++++---
 xbmc/utils/DisplayInfo.h   |  40 +++++++-
 2 files changed, 217 insertions(+), 16 deletions(-)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 1d3fb09..bfb6a9b 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -30,10 +30,18 @@ namespace
 {
 // The Dolby VSVDB, read from the raw EDID with the rule of the kernel backends (amdgpu's
 // amdgpu_dm_dvbridge_edid_standard() and, since linux-9965, i915's intel_dv_lab_edid(), which a
-// host test compares with this function) so that Kodi and the kernel take the same displays: valid
-// blocks (an HDMI Forum EEODB may make the EDID longer than its extension count) and exactly one
+// host test compares with this function) so that Kodi and the kernel take the same displays: every
+// block (an HDMI Forum EEODB may make the EDID longer than its extension count) and exactly one
 // Dolby VSVDB. libdisplay-info gives neither the length of a version 1 block nor its whole
 // low-latency field, and stops at the extension count.
+// - Hades: an extension block that is not valid (a wrong checksum, a CTA block whose data blocks
+//   end out of it, a data block that runs past them) is skipped, and nothing of it is taken: not
+//   its Dolby VSVDB, not its QS. It used to make the whole EDID refused, which DRM does not do (it
+//   takes out the blocks with a wrong checksum, edid_filter_invalid_blocks()); NVIDIA's driver
+//   passes on the blocks past the extension count of the base block without checking them. A base
+//   block that is not valid still refuses the EDID: its extension count is not known.
+// - Hades: copies of the Dolby VSVDB, byte for byte the same, count as one (an EDID read with
+//   blocks twice); two different Dolby VSVDBs are still refused.
 // - Version 2 with interface 2 or 3 advertises the Standard mode; 2160p60 is always there.
 // - A 12-byte version 1 block with the low-latency field 1 advertises the Standard mode with the
 //   same Dolby vendor InfoFrame (0 there, the 15-byte form and version 0 mean the HDMI 1.4b
@@ -54,7 +62,8 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       !std::equal(std::begin(magic), std::end(magic), edid.begin()))
     return {};
   DolbyVideoBlock result;
-  unsigned int found = 0;
+  // (what is known of the EDID once it is refused: that it has a Dolby VSVDB)
+  DolbyVideoBlock refused;
   // Hades: for the HDMI 1.4b verdict (at the end): the payload of the Dolby VSVDB, and whether a
   // video capability data block says QS
   const uint8_t* dolby = nullptr;
@@ -65,21 +74,49 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
     unsigned int sum = 0;
     for (size_t i = 0; i < 128; ++i)
       sum += b[i];
+    // Hades: (an extension block that is not valid is skipped: see above)
+    const auto skip = [&]
+    {
+      result.skippedBlocks++;
+      refused.skippedBlocks++;
+      // (a Dolby VSVDB in it is seen, not taken: as far as its data blocks can be followed)
+      if (b[0] == 0x02 && b[1] >= 3 && b[2] >= 4 && b[2] <= 127)
+        for (unsigned int pos = 4; pos < b[2] && pos + (b[pos] & 31u) + 1 <= b[2];
+             pos += (b[pos] & 31u) + 1)
+          if ((b[pos] >> 5) == 7 && (b[pos] & 31u) >= 4 && b[pos + 1] == 1 &&
+              b[pos + 2] == 0x46 && b[pos + 3] == 0xd0 && b[pos + 4] == 0)
+            result.seen = refused.seen = true;
+    };
     if (sum % 256)
-      return {};
+    {
+      if (block == 0)
+        return {};
+      skip();
+      continue;
+    }
     if (block == 0 || b[0] != 0x02 || b[1] < 3)
       continue;
     const unsigned int end = b[2];
     if (end == 0)
       continue;
     if (end < 4 || end > 127)
-      return {};
+    {
+      skip();
+      continue;
+    }
+    // Hades: every data block inside the CTA block, before anything of it is taken
+    unsigned int at = 4;
+    while (at < end && at + (b[at] & 31u) + 1 <= end)
+      at += (b[at] & 31u) + 1;
+    if (at < end)
+    {
+      skip();
+      continue;
+    }
     for (unsigned int pos = 4; pos < end;)
     {
       const unsigned int len = b[pos] & 31;
       const uint8_t* data = b + pos + 1;
-      if (pos + len + 1 > end)
-        return {};
       // Hades: video capability data block (extended tag 0) with QS, of a payload of two bytes as
       // the kernel reads it
       if ((b[pos] >> 5) == 7 && len == 2 && data[0] == 0 && (data[1] & 0x40))
@@ -88,8 +125,16 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 && data[1] == 0x46 && data[2] == 0xd0 &&
           data[3] == 0)
       {
-        if (++found != 1 || len < 5)
-          return {};
+        result.seen = refused.seen = true;
+        // Hades: a copy of the one found, byte for byte (its length too), counts as that one
+        if (dolby && b[pos] == dolby[-1] && std::equal(data, data + len, dolby))
+        {
+          result.dolbyCopies++;
+          pos += len + 1;
+          continue;
+        }
+        if (dolby || len < 5)
+          return refused;
         dolby = data;
         result.valid = true;
         result.length = len;
@@ -147,8 +192,9 @@ DolbyVideoBlock ScanDolbyVideo(const std::vector<uint8_t>& edid)
       pos += len + 1;
     }
   }
-  // Hades: the HDMI 1.4b vendor InfoFrame (above), once the whole EDID is known to be valid with
-  // this block its only Dolby VSVDB
+  result.qs = qs;
+  // Hades: the HDMI 1.4b vendor InfoFrame (above), once the whole EDID has been read with this
+  // block its only Dolby VSVDB
   if (dolby)
   {
     const unsigned int len = result.length;
@@ -211,8 +257,104 @@ bool ScanUhd420Only(const std::vector<uint8_t>& edid)
   }
   return uhd420 && !hdmiForum;
 }
+
+// Hades: "aa bb cc" of n bytes
+std::string Hex(const uint8_t* bytes, size_t n)
+{
+  std::string out;
+  for (size_t i = 0; i < n; ++i)
+    out += StringUtils::Format("{}{:02x}", i ? " " : "", bytes[i]);
+  return out;
+}
 } // namespace
 
+unsigned int KODI::UTILS::EdidBaseBlockCopy(const std::vector<uint8_t>& edid)
+{
+  for (size_t block = 1; edid.size() >= 256 && block < edid.size() / 128; ++block)
+    if (std::equal(edid.begin(), edid.begin() + 128, edid.begin() + block * 128))
+      return static_cast<unsigned int>(block);
+  return 0;
+}
+
+std::string KODI::UTILS::EdidShapeOf(const std::vector<uint8_t>& edid)
+{
+  static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+  const size_t size = edid.size();
+  const size_t blocks = size / 128;
+  std::string out = StringUtils::Format("{} bytes", size);
+  if (size < 128 || !std::equal(std::begin(magic), std::end(magic), edid.begin()))
+    return out + (size < 128 ? ", no whole block" : ", without the EDID header");
+  out += StringUtils::Format(", {} block{}{}; the base block counts {} extension{}", blocks,
+                             blocks == 1 ? "" : "s", size % 128 ? " and a part of one" : "",
+                             edid[126], edid[126] == 1 ? "" : "s");
+  // The HDMI Forum EEODB: the first data block of block 1, extended tag 0x78
+  if (blocks > 1 && edid[128] == 0x02 && edid[129] >= 3 && edid[130] >= 7 && edid[132] == 0xe2 &&
+      edid[133] == 0x78)
+    out += StringUtils::Format(", an HDMI Forum EEODB of {} extension{}", edid[134],
+                               edid[134] == 1 ? "" : "s");
+  std::vector<std::string> dolbyBlocks;
+  out += "; blocks:";
+  for (size_t block = 0; block < blocks; ++block)
+  {
+    const uint8_t* b = edid.data() + block * 128;
+    unsigned int sum = 0;
+    for (size_t i = 0; i < 128; ++i)
+      sum += b[i];
+    std::string what;
+    if (block == 0)
+      what = "base";
+    else if (std::equal(edid.begin(), edid.begin() + 128, edid.begin() + block * 128))
+      what = "a copy of block 0";
+    else if (b[0] == 0x02)
+      what = StringUtils::Format("CTA rev {}", b[1]);
+    else if (b[0] == 0x70)
+      what = "DisplayID";
+    else if (b[0] == 0xf0)
+      what = "block map";
+    else
+      what = StringUtils::Format("tag {:02x}", b[0]);
+    if (sum % 256)
+      what += ", checksum wrong";
+    if (block > 0 && block > edid[126])
+      what += ", past the extension count";
+    if (block > 0 && b[0] == 0x02 && b[1] >= 3)
+    {
+      const unsigned int end = b[2];
+      if (end != 0 && (end < 4 || end > 127))
+        what += StringUtils::Format(", its data blocks end at {}", end);
+      else
+      {
+        unsigned int pos = 4;
+        for (; pos < end && pos + (b[pos] & 31u) + 1 <= end; pos += (b[pos] & 31u) + 1)
+          if ((b[pos] >> 5) == 7 && (b[pos] & 31u) >= 4 && b[pos + 1] == 1 && b[pos + 2] == 0x46 &&
+              b[pos + 3] == 0xd0 && b[pos + 4] == 0 && dolbyBlocks.size() < 4)
+            dolbyBlocks.emplace_back(StringUtils::Format(
+                "block {} at {}: {}", block, pos, Hex(b + pos, (b[pos] & 31u) + 1)));
+        if (pos < end)
+          what += StringUtils::Format(", a data block at {} runs past {}", pos, end);
+      }
+    }
+    if (block < 16)
+      out += StringUtils::Format("{} {} {}", block ? ";" : "", block, what);
+    else if (block == 16)
+      out += StringUtils::Format("; and {} more", blocks - 16);
+  }
+  // Every place of the Dolby OUI in the bytes, as a Dolby VSVDB has it (46 d0 00)
+  std::string places;
+  unsigned int count = 0;
+  for (size_t i = 0; i + 3 <= size; ++i)
+    if (edid[i] == 0x46 && edid[i + 1] == 0xd0 && edid[i + 2] == 0x00 && ++count <= 8)
+      places += StringUtils::Format("{}{} (block {}, at {})", places.empty() ? "" : ", ", i,
+                                    i / 128, i % 128);
+  out += count ? StringUtils::Format("; the Dolby OUI 46 d0 00 at byte {}{}", places,
+                                     count > 8 ? StringUtils::Format(" and {} more", count - 8)
+                                               : std::string())
+               : std::string("; the Dolby OUI 46 d0 00 nowhere");
+  for (const auto& block : dolbyBlocks)
+    out += "; Dolby VSVDB in " + block;
+  return out;
+}
+
 double KODI::UTILS::PqLevelToNits(unsigned int level)
 {
   // SMPTE ST 2084 EOTF, with the level of a 12-bit signal over 4095
@@ -248,7 +390,13 @@ CDisplayInfo::CDisplayInfo(const std::vector<uint8_t>& edid)
 {
   m_info.reset(di_info_parse_edid(edid.data(), edid.size()));
   m_dolbyVideo = ScanDolbyVideo(edid);
-  m_dolbyVision = m_dolbyVideo.valid;
+  // Hades: a Dolby VSVDB that is seen and not taken counts too (DolbyVisionBlockInvalid()), also
+  // where libdisplay-info does not see it (past the extension count of the base block)
+  m_dolbyVision = m_dolbyVideo.valid || m_dolbyVideo.seen;
+  // Hades: QS where libdisplay-info does not read (Parse()): past the extension count too
+  m_rgbQuantizationSelectable = m_dolbyVideo.qs;
+  m_baseBlockCopy = EdidBaseBlockCopy(edid);
+  m_edidShape = EdidShapeOf(edid);
   m_uhd420Only = ScanUhd420Only(edid);
   // Hades: the HDR10+ block of any application version, 0 too (HDR10PlusVersion())
   m_hdr10PlusVersion = Hdr10PlusBlockVersion(edid);
@@ -389,8 +537,25 @@ void CDisplayInfo::LogInfo() const
               : SupportsLegacyDolbyVisionOnly() ? "older signalling (HDMI 1.4b), not sent"
                                                 : "without the standard mode");
   else if (m_dolbyVision)
-    CLog::Log(LOGINFO, "[display-info] dolby vision: not taken (an invalid EDID block, or several "
-                       "Dolby Vision blocks)");
+    CLog::Log(LOGINFO, "[display-info] dolby vision: not taken (its block is in an EDID block that "
+                       "is not valid, or there are several different ones, or one too short)");
+  // Hades: what of the EDID was not read
+  if (m_dolbyVideo.skippedBlocks)
+    CLog::Log(LOGINFO, "[display-info] {} EDID block{} not valid, and nothing of {} is taken",
+              m_dolbyVideo.skippedBlocks, m_dolbyVideo.skippedBlocks == 1 ? " is" : "s are",
+              m_dolbyVideo.skippedBlocks == 1 ? "it" : "them");
+  if (m_dolbyVideo.dolbyCopies)
+    CLog::Log(LOGINFO, "[display-info] dolby vision: the block is {} more time{} in the EDID, the "
+                       "same bytes, and counts once",
+              m_dolbyVideo.dolbyCopies, m_dolbyVideo.dolbyCopies == 1 ? "" : "s");
+  if (m_baseBlockCopy)
+    CLog::Log(LOGWARNING,
+              "[display-info] block {} of the EDID is a copy of block 0: the EDID was not read "
+              "whole (a read of its segments that gave the first blocks again), and blocks of the "
+              "display may be missing; the output is probed again when a video starts",
+              m_baseBlockCopy);
+  if (m_dolbyVideo.skippedBlocks || m_dolbyVideo.dolbyCopies || m_baseBlockCopy)
+    CLog::Log(LOGINFO, "[display-info] EDID: {}", m_edidShape);
 
   if (m_dolbyVideo.valid && m_dolbyVideo.lowLatency)
   {
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index fa67845..dceb72f 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -59,7 +59,24 @@ enum class Colorimetry
 //! The Dolby vendor-specific video data block (VSVDB) of an EDID, read from its raw bytes.
 struct DolbyVideoBlock
 {
-  bool valid = false; //!< valid EDID blocks with exactly one Dolby VSVDB
+  //! exactly one Dolby VSVDB in the EDID blocks that are read (identical copies of it count as
+  //! one), of 5 bytes of payload or more
+  bool valid = false;
+  //! Hades: a Dolby VSVDB was seen, taken or not (in a block that is skipped, several different
+  //! ones, one too short): what tells "a block that is not read" from "no block"
+  bool seen = false;
+  //! Hades: the extension blocks that are skipped, of which nothing is taken: a wrong checksum, a
+  //! CTA block whose data blocks end out of it (byte 2), or a data block that runs past them. The
+  //! kernel takes out blocks with a wrong checksum before user space sees the EDID (amdgpu, i915);
+  //! NVIDIA's driver passes on those that it does not check (past the extension count of the base
+  //! block). A skipped block used to make the whole EDID refused.
+  unsigned int skippedBlocks = 0;
+  //! Hades: copies of the Dolby VSVDB after the first, byte for byte the same, which count as one
+  //! (an EDID read with a block twice, as when a read of its E-DDC segments gives the first again)
+  unsigned int dolbyCopies = 0;
+  //! Hades: a video capability data block with QS in the blocks that are read (all of them, past
+  //! the extension count of the base block too), as the kernel reads it (drm_dvbridge.h)
+  bool qs = false;
   unsigned int version = 0;
   unsigned int length = 0; //!< of the block's payload: 11 for the 12-byte form
   unsigned int dmVersion = 0; //!< display management version (version 1 and 2 blocks)
@@ -163,8 +180,17 @@ public:
     return m_dolbyVideo.standard ? m_dolbyVideo.dmVersion : 0;
   }
   //! The EDID has a Dolby Vision block that the rule above does not read: in an EDID block that is
-  //! not valid, or with several Dolby Vision blocks.
+  //! skipped (not valid), several different Dolby Vision blocks, or one too short.
   bool DolbyVisionBlockInvalid() const { return m_dolbyVision && !m_dolbyVideo.valid; }
+  //! Hades: the first extension block that is byte for byte block 0 (0: none). A display's EDID is
+  //! read in segments of two blocks (E-DDC); a read that ignores the segment gives blocks 0 and 1
+  //! again for 2 and 3, and the blocks of the display that are there are not read. Kodi probes the
+  //! output once more when a video starts (CWinSystemGbm::CheckDisplayChange()).
+  unsigned int BaseBlockCopy() const { return m_baseBlockCopy; }
+  //! Hades: the shape of the EDID, for the log where Dolby Vision is not taken from it: its size,
+  //! its blocks and how each was read, the HDMI Forum EEODB, where the Dolby OUI is in its bytes
+  //! and the Dolby VSVDBs (EdidShapeOf())
+  const std::string& EdidShape() const { return m_edidShape; }
   //! Dolby Vision Standard at 2160p above 30 Hz: always with a version 2 block, with a version 1
   //! block only when it advertises 2160p60.
   bool SupportsStandardDolbyVision2160p60() const
@@ -260,7 +286,17 @@ private:
   DolbyVideoBlock m_dolbyVideo; //!< read from the raw EDID, see the constructor
   bool m_uhd420Only = false; //!< read from the raw EDID, see UhdLimitedToHdmi14()
   bool m_rgbQuantizationSelectable = false;
+  unsigned int m_baseBlockCopy = 0; //!< Hades: see BaseBlockCopy()
+  std::string m_edidShape; //!< Hades: see EdidShape()
 };
 
+//! Hades: the shape of an EDID (CDisplayInfo::EdidShape()), one line: its bytes and blocks, the
+//! extension count of the base block, the HDMI Forum EEODB, the tag and the validity of each block
+//! (up to 16 of them), every place of the Dolby OUI (46 d0 00) in its bytes (up to 8) and the bytes
+//! of each Dolby VSVDB (up to 4)
+std::string EdidShapeOf(const std::vector<uint8_t>& edid);
+//! Hades: the first extension block of the EDID that is byte for byte its block 0; 0 for none
+unsigned int EdidBaseBlockCopy(const std::vector<uint8_t>& edid);
+
 } // namespace UTILS
 } // namespace KODI
