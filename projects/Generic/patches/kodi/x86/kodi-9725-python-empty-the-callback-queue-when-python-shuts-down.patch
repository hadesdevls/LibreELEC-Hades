From 2f4e8f2b2ab780111628e5e181048c4bd04ff44b Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Wed, 28 Oct 2026 15:25:44 +0000
Subject: [PATCH] [python] Empty the callback queue when Python shuts down

A callback queued for a script that has already stopped stays in the
queue. Destroying the queue at exit releases it, which can release its
handler, and the handler's destructor then removes its messages from
the queue that is being destroyed. A message was freed twice and Kodi
aborted as it quit, most often when a game was still stopping late in
shutdown.

The queue is now emptied when Python shuts down, once its scripts have
stopped, and takes nothing after that. Its messages are released away
from the queue, so a handler going with them can still tidy it.
---
 xbmc/interfaces/legacy/CallbackHandler.cpp | 20 ++++++++++++++++++++
 xbmc/interfaces/legacy/CallbackHandler.h   |  5 +++++
 xbmc/interfaces/python/XBPython.cpp        |  4 ++++
 3 files changed, 29 insertions(+)

diff --git a/xbmc/interfaces/legacy/CallbackHandler.cpp b/xbmc/interfaces/legacy/CallbackHandler.cpp
index f2f9854..4c184c4 100644
--- a/xbmc/interfaces/legacy/CallbackHandler.cpp
+++ b/xbmc/interfaces/legacy/CallbackHandler.cpp
@@ -34,11 +34,18 @@ namespace XBMCAddon
 
   static CCriticalSection critSection;
   static CallbackQueue g_callQueue;
+  static bool g_callQueueClosed = false;
 
   void RetardedAsyncCallbackHandler::invokeCallback(Callback* cb)
   {
     XBMC_TRACE;
     std::unique_lock lock(critSection);
+    if (g_callQueueClosed)
+    {
+      // Nothing runs callbacks any more, so let the callback go
+      AddonClass::Ref<Callback> discard(cb);
+      return;
+    }
     g_callQueue.push_back(new AsyncCallbackMessage(cb,this));
   }
 
@@ -122,6 +129,19 @@ namespace XBMCAddon
     }
   }
 
+  void RetardedAsyncCallbackHandler::clearAllPendingCalls()
+  {
+    XBMC_TRACE;
+    CallbackQueue pending;
+    {
+      std::unique_lock lock(critSection);
+      g_callQueueClosed = true;
+      pending.swap(g_callQueue);
+    }
+    // Released here, outside the lock and the queue: releasing a message can
+    // release its handler, which then removes its messages from the queue.
+  }
+
   void RetardedAsyncCallbackHandler::clearPendingCalls(void* userData)
   {
     XBMC_TRACE;
diff --git a/xbmc/interfaces/legacy/CallbackHandler.h b/xbmc/interfaces/legacy/CallbackHandler.h
index 223c74a..9377bf5 100644
--- a/xbmc/interfaces/legacy/CallbackHandler.h
+++ b/xbmc/interfaces/legacy/CallbackHandler.h
@@ -51,6 +51,11 @@ namespace XBMCAddon
     static void makePendingCalls();
     static void clearPendingCalls(void* userData);
 
+    /*!
+     * \brief Drop every pending call and take no more, once scripts have stopped
+     */
+    static void clearAllPendingCalls();
+
     virtual bool isStateOk(AddonClass* obj) =  0;
     virtual bool shouldRemoveCallback(AddonClass* obj, void* userData) = 0;
   };
diff --git a/xbmc/interfaces/python/XBPython.cpp b/xbmc/interfaces/python/XBPython.cpp
index 5acd7d1..21af8cc 100644
--- a/xbmc/interfaces/python/XBPython.cpp
+++ b/xbmc/interfaces/python/XBPython.cpp
@@ -19,6 +19,7 @@
 #include "filesystem/SpecialProtocol.h"
 #include "interfaces/AnnouncementManager.h"
 #include "interfaces/legacy/AddonUtils.h"
+#include "interfaces/legacy/CallbackHandler.h"
 #include "interfaces/legacy/Monitor.h"
 #include "interfaces/python/AddonPythonInvoker.h"
 #include "interfaces/python/PythonInvoker.h"
@@ -490,6 +491,9 @@ void XBPython::Uninitialize()
 
   // cleanup threads that are still running
   tmpvec.clear();
+
+  // callbacks for the stopped scripts can still be queued
+  XBMCAddon::RetardedAsyncCallbackHandler::clearAllPendingCalls();
 }
 
 void XBPython::Process()
