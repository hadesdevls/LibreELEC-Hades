From 81c377783751174f603835bda1a01f09b189eafb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] settings: the texts of videoplayer.hades3dmvc say which files

The label and the help read as if a 3D Blu-ray disc, an image of one or
a folder of one were covered. What is recognised is a Matroska track
with the record of a second view; a disc still plays in 2D. They also
said "the display that Kodi started on", which is not all of it since
the display's word is taken again when a video starts on a display with
Dolby Vision: now "where the display says that it takes 3D (it has to be
on when Kodi starts)". The Spanish of Argentina and of Mexico use their
own word for glasses.
---
 addons/resource.language.en_gb/resources/strings.po       | 4 ++--
 .../language/resource.language.en_gb/strings.po           | 4 ++--
 .../language/resource.language.es_ar/strings.po           | 8 ++++----
 .../language/resource.language.es_es/strings.po           | 8 ++++----
 .../language/resource.language.es_mx/strings.po           | 8 ++++----
 5 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 4b67670..94bc759 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25211,13 +25211,13 @@ msgstr ""
 #. Hades: label of setting "videoplayer.hades3dmvc"; translated in Estuary (#31721)
 #: system/settings/settings.xml
 msgctxt "#39960"
-msgid "Decode both views of 3D Blu-ray video (MVC)"
+msgid "Decode both views of 3D Blu-ray video in MKV files (MVC)"
 msgstr ""
 
 #. Hades: help of setting "videoplayer.hades3dmvc"; translated in Estuary (#31722)
 #: system/settings/settings.xml
 msgctxt "#39961"
-msgid "A 3D Blu-ray holds the picture of each eye as a view of its own (H.264 MVC), and so does a Matroska file made of one. Automatic: both views are decoded, by the processor, where the display that Kodi started on says that it takes 3D, and the video is then shown as a stereoscopic one; on any other display the video plays in 2D as before, with hardware decoding. Always: both views on any display, for anaglyph glasses or for a 3D display that does not say what it is. Off: never. Where the second view cannot be decoded the video plays in 2D. Applies from the next video."
+msgid "A 3D Blu-ray holds the picture of each eye as a view of its own (H.264 MVC). Kodi decodes both from a Matroska (MKV) file made of such a disc; a disc, an image of one or a folder of one still plays in 2D. Automatic: both views are decoded, by the processor, where the display says that it takes 3D (it has to be on when Kodi starts), and the video is then shown as a stereoscopic one; on any other display the video plays in 2D as before, with hardware decoding. Always: both views on any display, for anaglyph glasses or for a 3D display that does not say what it is. Off: never. Where the second view cannot be decoded the video plays in 2D. Applies from the next video."
 msgstr ""
 
 #empty strings from id 39962 to 39977
