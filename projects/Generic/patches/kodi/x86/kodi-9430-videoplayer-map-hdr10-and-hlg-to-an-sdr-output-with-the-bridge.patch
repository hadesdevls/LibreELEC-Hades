diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 71b2310..7eb5d5d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1352,6 +1352,69 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
   return true;
 }
 
+bool CDVBridgeGLES::PreparePlain(const Layer& base,
+                                 const dvbridge_plain& plain,
+                                 dvbridge_view view,
+                                 int width,
+                                 int height,
+                                 unsigned int serial)
+{
+  // The same picture for the same place again: the texture holds it (as PrepareConversion())
+  const bool again = serial != 0 && serial == m_convertSerial && width == m_convertAskedWidth &&
+                     height == m_convertAskedHeight && SameView(view, m_convertAsked);
+  if (again && m_convertDrawn)
+    return true;
+  m_convertSerial = serial;
+  m_convertAsked = view;
+  m_convertAskedWidth = width;
+  m_convertAskedHeight = height;
+  m_convertDrawn = false;
+  if (!m_conversion || !m_renderer)
+  {
+    m_plainFailed += again ? 0 : 1;
+    return Fail("renderer-missing");
+  }
+  if (m_convertSdrRefused)
+  {
+    m_plainFailed += again ? 0 : 1;
+    return Fail("sdr-mapping-not-valid");
+  }
+  const CKeptGLState kept;
+  TakeStaleGLErrors("an HDR picture is mapped");
+  dvbridge_gl_frame bl{};
+  if (!dvbridge_gl_frame_import(&bl, m_gl->gpu, base.layout, base.width, base.height, base.planes,
+                                base.chroma))
+  {
+    m_plainFailed += again ? 0 : 1;
+    return Fail("plain-picture-import");
+  }
+  const bool drawn = dvbridge_render_plain(m_renderer, &bl.frame, &plain, view, width, height);
+  LogNotes();
+  dvbridge_gl_frame_release(&bl);
+  if (!drawn)
+  {
+    m_plainFailed += again ? 0 : 1;
+    dvbridge_renderer_recover(m_renderer);
+    return Fail("plain-picture-mapping");
+  }
+  m_convertView = view;
+  m_convertWidth = width;
+  m_convertHeight = height;
+  // (nothing of Dolby Vision for the player information)
+  m_convertInfo = 0;
+  if (!m_plainMapped++)
+    CLog::Log(LOGINFO,
+              "DVBridge: an {} picture mapped to SDR: {}x{}, its mastering display {} to {} cd/m2, "
+              "its light {} (largest) and {} (average) cd/m2 (0: not known), into {}x{} of a {}x{} "
+              "output",
+              plain.hlg ? "HLG" : "HDR10", base.width, base.height, plain.min_luma, plain.max_luma,
+              plain.max_cll, plain.max_fall, view.dst_width, view.dst_height, width, height);
+  if (m_failures.Count())
+    m_failures.Reset();
+  m_convertDrawn = true;
+  return true;
+}
