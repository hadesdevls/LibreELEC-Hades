+bool DVBRIDGE::WantsPlainMapping(const VideoPicture* picture, int toneMapMethod)
+{
+  const auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window || !picture)
+    return false;
+  const bool peak =
+      (picture->hasDisplayMetadata && picture->displayMetadata.has_luminance &&
+       picture->displayMetadata.max_luminance.den &&
+       UsablePeak(av_q2d(picture->displayMetadata.max_luminance))) ||
+      (picture->hasLightMetadata && UsablePeak(picture->lightMetadata.MaxCLL));
+  return PlainMappingEligible(
+      window->SupportsPlainMapping(), toneMapMethod == VS_TONEMAPMETHOD_BT2390,
+      picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION && !picture->doviBaseIsPicture,
+      picture->color_transfer == AVCOL_TRC_SMPTE2084,
