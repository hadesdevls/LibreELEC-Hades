From c1eea19de35acc7c885fa6620aee074feaeb56ab Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Sat, 10 Oct 2026 20:47:09 +0100
Subject: [PATCH] [utils][LabelFormatter] Read a rating from a file name as a
 number (#29677)

The %R and %r label masks passed the first character of the matched text
to SetRating and SetUserrating, so a rating of 7 became the character
code 55, which the setters then clamp to 10. Every rating read this way
has been stored as 10 since c5b281b2ed changed both setters to take
numbers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f41d80660b036360d87de4647507c4d4c73029cf)
---
 xbmc/utils/LabelFormatter.cpp          |  4 ++--
 xbmc/utils/test/TestLabelFormatter.cpp | 19 +++++++++++++++++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/xbmc/utils/LabelFormatter.cpp b/xbmc/utils/LabelFormatter.cpp
index 7832db8..26a132c 100644
--- a/xbmc/utils/LabelFormatter.cpp
+++ b/xbmc/utils/LabelFormatter.cpp
@@ -489,10 +489,10 @@ void CLabelFormatter::FillMusicMaskContent(const char mask, const std::string &v
     tag->SetDuration(StringUtils::TimeStringToSeconds(value));
     break;
   case 'R': // rating
-    tag->SetRating(value[0]);
+    tag->SetRating(static_cast<float>(atof(value.c_str())));
     break;
   case 'r': // userrating
-    tag->SetUserrating(value[0]);
+    tag->SetUserrating(atoi(value.c_str()));
     break;
   case 'b': // total discs
     tag->SetTotalDiscs(atol(value.c_str()));
diff --git a/xbmc/utils/test/TestLabelFormatter.cpp b/xbmc/utils/test/TestLabelFormatter.cpp
index b12c1fd..7eae305 100644
--- a/xbmc/utils/test/TestLabelFormatter.cpp
+++ b/xbmc/utils/test/TestLabelFormatter.cpp
@@ -9,6 +9,7 @@
 #include "FileItem.h"
 #include "ServiceBroker.h"
 #include "filesystem/File.h"
+#include "music/tags/MusicInfoTag.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "test/TestUtils.h"
@@ -67,3 +68,21 @@ TEST_F(TestLabelFormatter, FormatLabel2)
 
   EXPECT_TRUE(XBMC_DELETETEMPFILE(tmpfile));
 }
+
+TEST_F(TestLabelFormatter, FillMusicTagReadsTheRatingAsANumber)
+{
+  CLabelFormatter formatter("%A - %R", "");
+  MUSIC_INFO::CMusicInfoTag tag;
+
+  ASSERT_TRUE(formatter.FillMusicTag("Artist - 7", &tag));
+  EXPECT_EQ(7.0f, tag.GetRating());
+}
+
+TEST_F(TestLabelFormatter, FillMusicTagReadsTheUserRatingAsANumber)
+{
+  CLabelFormatter formatter("%A - %r", "");
+  MUSIC_INFO::CMusicInfoTag tag;
+
+  ASSERT_TRUE(formatter.FillMusicTag("Artist - 7", &tag));
+  EXPECT_EQ(7, tag.GetUserrating());
+}
-- 
