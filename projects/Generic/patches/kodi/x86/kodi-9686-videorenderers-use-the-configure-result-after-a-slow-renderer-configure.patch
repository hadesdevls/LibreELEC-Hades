From 7f334bb96b1c9cb6e0fe052fd78efb52659eefe9 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Fri, 2 Oct 2026 12:49:48 +0100
Subject: [PATCH] [VideoRenderers] Use the configure result after a slow
 renderer configure.

CRenderManager::Configure() waits 1000 ms for the render thread to
configure the renderer. On timeout it took m_statelock and returned
false. The render thread holds m_statelock for the whole configure, so
that lock already waited until the configure had finished, but its
result was discarded.

On Windows the renderer configure can switch Windows HDR on or off,
which blocks for several seconds. The renderer was configured
successfully, but the video thread still logged "failed to configure
renderer" and dropped the picture (OUTPUT_ABORT).

Wait for the lock and check the configure state in both cases. If the
render thread has not started configuring yet, the state is still
STATE_CONFIGURING and false is returned as before.
---
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 3f85d7c..3f7b3ec 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -187,12 +187,9 @@ bool CRenderManager::Configure(const VideoPicture& picture,
   }
 
   if (!m_stateEvent.Wait(1000ms))
-  {
     CLog::Log(LOGWARNING, "CRenderManager::Configure - timeout waiting for configure");
-    std::unique_lock lock(m_statelock);
-    return false;
-  }
 
+  // a configure still in progress holds m_statelock, wait for it and use its result
   std::unique_lock lock(m_statelock);
   if (m_renderState != STATE_CONFIGURED)
   {
