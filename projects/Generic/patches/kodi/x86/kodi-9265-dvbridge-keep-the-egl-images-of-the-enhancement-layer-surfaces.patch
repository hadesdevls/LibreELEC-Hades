diff --git a/tools/dvbridge/dvbridge_dmabuf.h b/tools/dvbridge/dvbridge_dmabuf.h
index 642fa43..294a016 100644
--- a/tools/dvbridge/dvbridge_dmabuf.h
+++ b/tools/dvbridge/dvbridge_dmabuf.h
@@ -12,6 +12,9 @@ struct dvbridge_dmabuf {
     EGLImage images[2];
     struct dvbridge_gl_plane planes[3];
     enum dvbridge_gl_layout layout;
+    /* Hades: the images and textures are those of a dvbridge_dmabuf_cache, which keeps them:
+     * dvbridge_dmabuf_release() frees the mapping alone */
+    bool cached;
 };
 bool dvbridge_dmabuf_validate_p010(const AVDRMFrameDescriptor *desc, int width, int height);
 /* Current EGL/GLES context required. Does not transfer pixels through the CPU. */
@@ -19,4 +22,28 @@ bool dvbridge_dmabuf_import(struct dvbridge_dmabuf *out, const AVFrame *frame);
 void dvbridge_dmabuf_release(struct dvbridge_dmabuf *frame);
 /* Why the last dvbridge_dmabuf_import() failed, for diagnostics; empty after a success. */
 const char *dvbridge_dmabuf_last_error(void);
+
+/* Hades: the EGL images and the textures of the surfaces of a decoder, kept from one frame to
+ * the next. A frame is mapped as dvbridge_dmabuf_import() maps it, every time (the mapping waits
+ * for the decoder to finish the surface, and says which memory it is): when that memory is a
+ * surface that was imported before (the same dma-buf, by its device and inode, with the same
+ * layout), its images and textures are used again, as Kodi's own VAAPI texture pool does for the
+ * base layer; else they are made and kept. A decoder has a fixed pool of surfaces (32 at most),
+ * which fits. Frames of another pool of surfaces empty the cache first; the least recently used
+ * entry makes room when it is full. All calls on the GL context and thread of the importer. */
+#define DVBRIDGE_DMABUF_CACHE 1
+struct dvbridge_dmabuf_cache;
+struct dvbridge_dmabuf_cache *dvbridge_dmabuf_cache_create(void);
+/* Deletes what the cache holds (current GL context required); NULL does nothing. */
+void dvbridge_dmabuf_cache_destroy(struct dvbridge_dmabuf_cache *cache);
+/* Deletes what the cache holds and keeps the cache (current GL context required). */
+void dvbridge_dmabuf_cache_clear(struct dvbridge_dmabuf_cache *cache);
+/* dvbridge_dmabuf_import() with the cache; without a cache (NULL) the same as that. The planes
+ * stay valid until the cache is cleared or destroyed, or the entry is reused for another surface
+ * by a later import: release the frame before the next import. */
+bool dvbridge_dmabuf_import_cached(struct dvbridge_dmabuf_cache *cache, struct dvbridge_dmabuf *out,
+                                   const AVFrame *frame);
+/* Imports since the cache was made: answered by the cache, and that made images. */
+void dvbridge_dmabuf_cache_counts(const struct dvbridge_dmabuf_cache *cache, unsigned long *reused,
+                                  unsigned long *made);
 #endif
