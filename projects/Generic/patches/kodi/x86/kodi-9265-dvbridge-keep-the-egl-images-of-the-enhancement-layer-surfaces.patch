diff --git a/tools/dvbridge/dvbridge_dmabuf.c b/tools/dvbridge/dvbridge_dmabuf.c
index 73ad2ac..21eabd9 100644
--- a/tools/dvbridge/dvbridge_dmabuf.c
+++ b/tools/dvbridge/dvbridge_dmabuf.c
@@ -10,7 +10,9 @@
 #include <libavutil/pixdesc.h>
 #include <limits.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
+#include <sys/stat.h>
 
 /* Reason of the last failed import, for diagnostics only. */
 static char last_error[192];
@@ -73,22 +75,196 @@ bool dvbridge_dmabuf_validate_p010(const AVDRMFrameDescriptor *desc, int width,
     return true;
 }
 
+/* The EGL entry points that an import uses, and the display it imports into. */
+struct egl_entry {
+    EGLDisplay display;
+    PFNEGLCREATEIMAGEKHRPROC create;
+    PFNEGLDESTROYIMAGEKHRPROC destroy;
+    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind;
+    bool modifiers;
+};
+
+static void delete_planes(EGLDisplay display, PFNEGLDESTROYIMAGEKHRPROC destroy,
+                          EGLImage images[2], struct dvbridge_gl_plane planes[3])
+{
+    for (int i = 0; i < 2; ++i) {
+        if (planes[i].texture)
+            glDeleteTextures(1, &planes[i].texture);
+        if (images[i] && destroy)
+            destroy(display, images[i]);
+        planes[i] = (struct dvbridge_gl_plane){0};
+        images[i] = NULL;
+    }
+}
+
+/* The two planes of a mapped surface as EGL images and textures. On failure nothing is left. */
+static bool make_planes(const struct egl_entry *egl, const AVDRMFrameDescriptor *desc, int pool_width,
+                        int pool_height, EGLImage images[2], struct dvbridge_gl_plane planes[3])
+{
+    for (int i = 0; i < 2; ++i) {
+        const AVDRMLayerDescriptor *layer = &desc->layers[i];
+        const AVDRMPlaneDescriptor *plane = &layer->planes[0];
+        const AVDRMObjectDescriptor *object = &desc->objects[plane->object_index];
+        int width = i ? (pool_width + 1) / 2 : pool_width;
+        int height = i ? (pool_height + 1) / 2 : pool_height;
+        if (object->format_modifier != DRM_FORMAT_MOD_INVALID &&
+            object->format_modifier != DRM_FORMAT_MOD_LINEAR && !egl->modifiers) {
+            snprintf(last_error, sizeof(last_error), "modifier=0x%llx without EGL_EXT_image_dma_buf_import_modifiers",
+                     (unsigned long long)object->format_modifier);
+            goto fail;
+        }
+        EGLint attrs[24] = {
+            EGL_WIDTH, width, EGL_HEIGHT, height, EGL_LINUX_DRM_FOURCC_EXT, (EGLint)layer->format,
+            EGL_DMA_BUF_PLANE0_FD_EXT, object->fd, EGL_DMA_BUF_PLANE0_OFFSET_EXT, (EGLint)plane->offset,
+            EGL_DMA_BUF_PLANE0_PITCH_EXT, (EGLint)plane->pitch, EGL_NONE};
+        if (egl->modifiers && object->format_modifier != DRM_FORMAT_MOD_INVALID) {
+            attrs[12] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT;
+            attrs[13] = (EGLint)(object->format_modifier & UINT32_MAX);
+            attrs[14] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT;
+            attrs[15] = (EGLint)(object->format_modifier >> 32);
+            attrs[16] = EGL_NONE;
+        }
+        images[i] = egl->create(egl->display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, NULL, attrs);
+        if (!images[i]) {
+            snprintf(last_error, sizeof(last_error), "egl-image plane=%d egl_error=0x%x", i, (unsigned)eglGetError());
+            goto fail;
+        }
+        /* Errors left by earlier, unrelated GL work are not ours: clear them (bounded), so that
+         * the check below sees only what this import raised. */
+        for (int e = 0; e < 16 && glGetError() != GL_NO_ERROR; ++e)
+            ;
+        GLint previous;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+        glGenTextures(1, &planes[i].texture);
+        glBindTexture(GL_TEXTURE_2D, planes[i].texture);
+        egl->bind(GL_TEXTURE_2D, images[i]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, previous);
+        const GLenum error = glGetError();
+        if (error != GL_NO_ERROR) {
+            snprintf(last_error, sizeof(last_error), "gl-texture plane=%d gl_error=0x%x", i, (unsigned)error);
+            goto fail;
+        }
+        planes[i].width = width;
+        planes[i].height = height;
+    }
+    return true;
+fail:
+    delete_planes(egl->display, egl->destroy, images, planes);
+    return false;
+}
+
 void dvbridge_dmabuf_release(struct dvbridge_dmabuf *frame)
 {
     if (!frame)
         return;
-    PFNEGLDESTROYIMAGEKHRPROC destroy = (void *)eglGetProcAddress("eglDestroyImageKHR");
-    for (int i = 0; i < 2; ++i) {
-        if (frame->planes[i].texture)
-            glDeleteTextures(1, &frame->planes[i].texture);
-        if (frame->images[i] && destroy)
-            destroy(frame->display, frame->images[i]);
+    if (!frame->cached) {
+        PFNEGLDESTROYIMAGEKHRPROC destroy = (void *)eglGetProcAddress("eglDestroyImageKHR");
+        delete_planes(frame->display, destroy, frame->images, frame->planes);
     }
     av_frame_free(&frame->mapping);
     memset(frame, 0, sizeof(*frame));
 }
 
+/* Hades: what tells one surface from another: its memory (the device and inode of each dma-buf,
+ * which stay the same for as long as that memory exists and are not given to other memory
+ * meanwhile) and everything else that the import passes to EGL. */
+struct surface_identity {
+    int nb_objects;
+    unsigned long long dev[AV_DRM_MAX_PLANES], ino[AV_DRM_MAX_PLANES];
+    unsigned long long size[AV_DRM_MAX_PLANES], modifier[AV_DRM_MAX_PLANES];
+    unsigned long long format[2], object[2], offset[2], pitch[2];
+    int width, height;
+};
+
+#define CACHE_ENTRIES 32
+
+struct cache_entry {
+    bool used;
+    unsigned long long last; /* the import that used it last */
+    struct surface_identity identity;
+    EGLImage images[2];
+    struct dvbridge_gl_plane planes[3];
+};
+
+struct dvbridge_dmabuf_cache {
+    struct egl_entry egl; /* display NULL until the first import */
+    const void *pool;     /* the hardware frames context of the frames last imported */
+    unsigned long long clock;
+    unsigned long reused, made;
+    struct cache_entry entries[CACHE_ENTRIES];
+};
+
+static bool identify(struct surface_identity *id, const AVDRMFrameDescriptor *desc, int width, int height)
+{
+    memset(id, 0, sizeof(*id));
+    id->nb_objects = desc->nb_objects;
+    for (int i = 0; i < desc->nb_objects; ++i) {
+        struct stat st;
+        if (fstat(desc->objects[i].fd, &st) != 0)
+            return false;
+        id->dev[i] = (unsigned long long)st.st_dev;
+        id->ino[i] = (unsigned long long)st.st_ino;
+        id->size[i] = (unsigned long long)desc->objects[i].size;
+        id->modifier[i] = (unsigned long long)desc->objects[i].format_modifier;
+    }
+    for (int i = 0; i < 2; ++i) {
+        id->format[i] = desc->layers[i].format;
+        id->object[i] = (unsigned long long)desc->layers[i].planes[0].object_index;
+        id->offset[i] = (unsigned long long)desc->layers[i].planes[0].offset;
+        id->pitch[i] = (unsigned long long)desc->layers[i].planes[0].pitch;
+    }
+    id->width = width;
+    id->height = height;
+    return true;
+}
+
+static void cache_drop(struct dvbridge_dmabuf_cache *cache, struct cache_entry *entry)
+{
+    if (entry->used)
+        delete_planes(cache->egl.display, cache->egl.destroy, entry->images, entry->planes);
+    memset(entry, 0, sizeof(*entry));
+}
+
+struct dvbridge_dmabuf_cache *dvbridge_dmabuf_cache_create(void)
+{
+    return calloc(1, sizeof(struct dvbridge_dmabuf_cache));
+}
+
+void dvbridge_dmabuf_cache_clear(struct dvbridge_dmabuf_cache *cache)
+{
+    if (!cache)
+        return;
+    for (int i = 0; i < CACHE_ENTRIES; ++i)
+        cache_drop(cache, &cache->entries[i]);
+    cache->pool = NULL;
+}
+
+void dvbridge_dmabuf_cache_destroy(struct dvbridge_dmabuf_cache *cache)
+{
+    dvbridge_dmabuf_cache_clear(cache);
+    free(cache);
+}
+
+void dvbridge_dmabuf_cache_counts(const struct dvbridge_dmabuf_cache *cache, unsigned long *reused,
+                                  unsigned long *made)
+{
+    if (reused)
+        *reused = cache ? cache->reused : 0;
+    if (made)
+        *made = cache ? cache->made : 0;
+}
+
 bool dvbridge_dmabuf_import(struct dvbridge_dmabuf *out, const AVFrame *source)
+{
+    return dvbridge_dmabuf_import_cached(NULL, out, source);
+}
+
+bool dvbridge_dmabuf_import_cached(struct dvbridge_dmabuf_cache *cache, struct dvbridge_dmabuf *out,
+                                   const AVFrame *source)
 {
     if (!out || out->mapping || !source || source->format != AV_PIX_FMT_VAAPI ||
         !source->hw_frames_ctx || source->width < 1 || source->height < 1 ||
@@ -97,10 +273,18 @@ bool dvbridge_dmabuf_import(struct dvbridge_dmabuf *out, const AVFrame *source)
                  source ? source->width : 0, source ? source->height : 0);
         return false;
     }
-    PFNEGLCREATEIMAGEKHRPROC create = (void *)eglGetProcAddress("eglCreateImageKHR");
-    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind = (void *)eglGetProcAddress("glEGLImageTargetTexture2DOES");
+    struct egl_entry egl;
     EGLDisplay display = eglGetCurrentDisplay();
-    if (!create || !bind || display == EGL_NO_DISPLAY) {
+    if (cache && cache->egl.display && cache->egl.display == display) {
+        egl = cache->egl;
+    } else {
+        egl.create = (void *)eglGetProcAddress("eglCreateImageKHR");
+        egl.destroy = (void *)eglGetProcAddress("eglDestroyImageKHR");
+        egl.bind = (void *)eglGetProcAddress("glEGLImageTargetTexture2DOES");
+        egl.display = display;
+        egl.modifiers = false;
+    }
+    if (!egl.create || !egl.bind || display == EGL_NO_DISPLAY) {
         snprintf(last_error, sizeof(last_error), "egl-entry-points-or-display");
         return false;
     }
@@ -118,6 +302,8 @@ bool dvbridge_dmabuf_import(struct dvbridge_dmabuf *out, const AVFrame *source)
         return false;
     }
     candidate.mapping->format = AV_PIX_FMT_DRM_PRIME;
+    /* (vaapi: waits for the decoder to finish the surface, then exports it; done for every frame,
+     * also when the images of the surface are kept) */
     if (av_hwframe_map(candidate.mapping, source, AV_HWFRAME_MAP_READ | AV_HWFRAME_MAP_DIRECT) < 0) {
         snprintf(last_error, sizeof(last_error), "drm-prime-map");
         goto fail;
@@ -127,58 +313,56 @@ bool dvbridge_dmabuf_import(struct dvbridge_dmabuf *out, const AVFrame *source)
         describe_layout(desc);
         goto fail;
     }
-    const char *extensions = eglQueryString(display, EGL_EXTENSIONS);
-    bool modifiers = extensions && strstr(extensions, "EGL_EXT_image_dma_buf_import_modifiers");
-    for (int i = 0; i < 2; ++i) {
-        const AVDRMLayerDescriptor *layer = &desc->layers[i];
