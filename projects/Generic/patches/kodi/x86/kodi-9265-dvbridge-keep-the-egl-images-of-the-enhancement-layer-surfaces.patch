@@ -135,6 +135,8 @@ CDVBridgeGLES::~CDVBridgeGLES()
   CDVPlaybackInfo::presented.store(0);
   if (m_gl)
     TakeStaleGLErrors("the bridge is destroyed");
+  LogLayerCache();
+  dvbridge_dmabuf_cache_destroy(m_layerCache);
   glDeleteFramebuffers(1, &m_framebuffer);
   dvbridge_gl_packer_destroy(m_packer);
   dvbridge_gl_copier_destroy(m_copier);
@@ -145,6 +147,20 @@ CDVBridgeGLES::~CDVBridgeGLES()
   pl_log_destroy(&m_log);
 }
 
+void CDVBridgeGLES::LogLayerCache()
+{
+  unsigned long reused = 0, made = 0;
+  dvbridge_dmabuf_cache_counts(m_layerCache, &reused, &made);
+  if (reused == m_layerCacheLogged[0] && made == m_layerCacheLogged[1])
+    return;
+  CLog::Log(LOGINFO,
+            "DVBridge: enhancement pictures imported: {} with the images of their surface kept "
+            "from an earlier one, {} with new images",
+            reused - m_layerCacheLogged[0], made - m_layerCacheLogged[1]);
+  m_layerCacheLogged[0] = reused;
+  m_layerCacheLogged[1] = made;
+}
+
 void CDVBridgeGLES::TakeStaleGLErrors(const char* before)
 {
   // libplacebo reads glGetError() after its own calls and takes whatever it finds as its own
@@ -266,6 +282,9 @@ void CDVBridgeGLES::Reset()
   if (m_gl)
     TakeStaleGLErrors("the renderer is reset");
   dvbridge_renderer_reset(m_renderer);
