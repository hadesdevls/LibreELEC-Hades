From 870cf4e117a68899ef495bc27e73e5b7b670d006 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Thu, 8 Oct 2026 12:46:00 +0100
Subject: [PATCH] [Video][CVideoInfoTag] Restart the cast at an NFO actor
 marked clear="true"

The clear attribute's test lacked == 0, so clear="true" kept the cast
gathered so far and any other value cleared it. The clear also ran after
the actor carrying the attribute had been added, so it discarded that
actor as well. The test now runs before the actor is added: clear="true"
keeps only that actor and those after it, as the artist list's clear
attribute already does. The comparison came over from stricmp unchanged
in d7f57665b2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 24bd3e8338191a7d34a6cac034d75be611a91c6b)
---
 xbmc/video/VideoInfoTag.cpp          |  7 +++---
 xbmc/video/test/TestVideoInfoTag.cpp | 33 ++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/VideoInfoTag.cpp b/xbmc/video/VideoInfoTag.cpp
index dc3a0eb..f87fa45 100644
--- a/xbmc/video/VideoInfoTag.cpp
+++ b/xbmc/video/VideoInfoTag.cpp
@@ -1500,6 +1500,10 @@ void CVideoInfoTag::ParseNative(const TiXmlElement* movie, bool prioritise)
     const TiXmlNode *actor = node->FirstChild("name");
     if (actor && actor->FirstChild())
     {
+      const char* clear = node->Attribute("clear");
+      if (clear && StringUtils::CompareNoCase(clear, "true") == 0)
+        m_cast.clear();
+
       SActorInfo& info = m_cast.emplace_back();
 
       info.strName = actor->FirstChild()->Value();
@@ -1514,9 +1518,6 @@ void CVideoInfoTag::ParseNative(const TiXmlElement* movie, bool prioritise)
         info.thumbUrl.ParseAndAppendUrl(thumbnode);
         thumbnode = thumbnode->NextSiblingElement("thumb");
       }
-      const char* clear=node->Attribute("clear");
-      if (clear && StringUtils::CompareNoCase(clear, "true"))
-        m_cast.clear();
     }
     node = node->NextSiblingElement("actor");
   }
diff --git a/xbmc/video/test/TestVideoInfoTag.cpp b/xbmc/video/test/TestVideoInfoTag.cpp
index ab8e4d1..7b72fb0 100644
--- a/xbmc/video/test/TestVideoInfoTag.cpp
+++ b/xbmc/video/test/TestVideoInfoTag.cpp
@@ -21,6 +21,7 @@
 
 #include <map>
 #include <string>
+#include <vector>
 
 #include <gtest/gtest.h>
 
@@ -568,3 +569,35 @@ TEST_F(AudioSortKeyTester, SortKeyFollowsTheLanguageDetailsSetting)
   tag.ToSortable(sortable, Field::AUDIO_LANGUAGE);
   EXPECT_EQ("ger", sortable[Field::AUDIO_LANGUAGE].asString());
 }
+
+namespace
+{
+std::vector<std::string> CastAfterLoading(const std::string& clear)
+{
+  const std::string document = R"(<movie>
+                                    <actor><name>First</name></actor>
+                                    <actor clear=")" +
+                               clear + R"("><name>Second</name></actor>
+                                  </movie>)";
+  CXBMCTinyXML doc;
+  doc.Parse(document, TIXML_ENCODING_UNKNOWN);
+
+  CVideoInfoTag details;
+  EXPECT_TRUE(details.Load(doc.RootElement(), true, false));
+
+  std::vector<std::string> names;
+  for (const auto& actor : details.m_cast)
+    names.push_back(actor.strName);
+  return names;
+}
+} // unnamed namespace
+
+TEST(TestVideoInfoTag, ActorClearTrueStartsTheCastAgainFromThatActor)
+{
+  EXPECT_EQ(std::vector<std::string>{"Second"}, CastAfterLoading("true"));
+}
+
+TEST(TestVideoInfoTag, ActorClearFalseKeepsTheCast)
+{
+  EXPECT_EQ((std::vector<std::string>{"First", "Second"}), CastAfterLoading("false"));
+}
