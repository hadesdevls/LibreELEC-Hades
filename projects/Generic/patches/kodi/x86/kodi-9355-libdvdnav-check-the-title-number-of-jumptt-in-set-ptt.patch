From b5115b6f91401da4ef3ce1bbe7e46f3de9cf6d60 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:51:05 +0000
Subject: [PATCH] libdvdnav: check the title number of JumpTT in set_PTT()

libdvdnav 7.0.0's set_PTT() (vm/getset.c) indexes the title table of
the disc with only an assert on the title number. A disc whose First
Play or VMG menu program chain issues JumpTT with title 0 makes
libdvdnav read before the title table, and in a build with NDEBUG (the
Linux build of this tree has -DNDEBUG in all 13 compile commands of
libdvdnav) a number above the title count makes it read past the table
too (CVE-2026-112058). libdvdnav's master (8147ccd35e5a) still has the
assert.

06-all-set_PTT-check-the-title-number.patch, a Hades patch on top of 03,
04 and 05, makes set_PTT() return 0 for a title outside
1..nr_of_srpts, the range dvdnav_part_play() already checks. JumpTT
then becomes Exit, libdvdnav stops the VM and reports DVDNAV_STOP, and
CDVDInputStreamNavigator ends playback as it does for a disc that stops
itself.

Wired like 03, 04 and 05: the patch list of FindLibDvdNav.cmake (the
one applied on every platform, after 05) and the tools/depends Makefile
(DEPS and the patch commands, after 05).
---
 cmake/modules/FindLibDvdNav.cmake             |  3 +-
 ...6-all-set_PTT-check-the-title-number.patch | 46 +++++++++++++++++++
 tools/depends/target/libdvdnav/Makefile       |  4 +-
 3 files changed, 51 insertions(+), 2 deletions(-)
 create mode 100644 tools/depends/target/libdvdnav/06-all-set_PTT-check-the-title-number.patch

diff --git a/cmake/modules/FindLibDvdNav.cmake b/cmake/modules/FindLibDvdNav.cmake
index b8ad3b4..c966605 100644
--- a/cmake/modules/FindLibDvdNav.cmake
+++ b/cmake/modules/FindLibDvdNav.cmake
@@ -20,7 +20,8 @@ if(NOT TARGET LIBRARY::${CMAKE_FIND_PACKAGE_NAME})
 
     set(patches "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/03-all-fix-cell_find-for-cell-boundary.patch"
                 "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/04-all-fix-null-cell_playback.patch"
-                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/05-all-unsigned-subp-control-shift.patch")
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/05-all-unsigned-subp-control-shift.patch"
+                "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/06-all-set_PTT-check-the-title-number.patch")
 
     if(WIN32 OR WINDOWS_STORE)
       set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_libType shared)
diff --git a/tools/depends/target/libdvdnav/06-all-set_PTT-check-the-title-number.patch b/tools/depends/target/libdvdnav/06-all-set_PTT-check-the-title-number.patch
new file mode 100644
index 0000000..6614d98
--- /dev/null
+++ b/tools/depends/target/libdvdnav/06-all-set_PTT-check-the-title-number.patch
@@ -0,0 +1,46 @@
+From c413c232e3a8e6fc1125f55e20d0fd473afe2fd6 Mon Sep 17 00:00:00 2001
+From: Hades <15710513+hadesdevls@users.noreply.github.com>
+Date: Tue, 20 Oct 2026 16:50:05 +0000
+Subject: [PATCH] Check the title number in set_PTT() instead of asserting it
+
+CVE-2026-112058. set_PTT() (vm/getset.c) indexes
+vm->vmgi->tt_srpt->title[tt - 1] with only
+assert(tt <= vm->vmgi->tt_srpt->nr_of_srpts). A disc's First Play or
+VMG menu program chain can issue JumpTT with title 0 or with a number
+above nr_of_srpts; process_command() passes it to set_TT(), which calls
+set_PTT(). With tt == 0 the assert passes and title[-1] is read; in a
+build with NDEBUG the assert is gone and an oversized tt is read as
+well: a heap out-of-bounds read, then its title_set_nr and vts_ttn are
+used to open a title set.
+
+set_PTT() now returns 0 for tt < 1 or tt > nr_of_srpts, the same range
+dvdnav_part_play() and vm_get_title_ifo() check. Every caller already
+treats 0 as failure: JumpTT turns it into Exit, which sets vm->stopped,
+and dvdnav_get_next_block() then reports DVDNAV_STOP;
+vm_jump_title_part() returns 0, and its caller dvdnav_part_play() has
+already rejected an out-of-range title anyway. title_set_nr and vts_ttn
+of a valid title are checked further down by set_VTS_PTT()
+(ifoOpenNewVTSI() and the vts_ptt_srpt bounds).
+
+libdvdnav's master (8147ccd35e5a) still has the assert.
+---
+ src/vm/getset.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/src/vm/getset.c b/src/vm/getset.c
+index 4132b1c..413c6be 100644
+--- a/src/vm/getset.c
++++ b/src/vm/getset.c
+@@ -48,7 +48,8 @@ int set_TT(vm_t *vm, int tt) {
+ }
+ 
+ int set_PTT(vm_t *vm, int tt, int ptt) {
+-  assert(tt <= vm->vmgi->tt_srpt->nr_of_srpts);
++  if (tt < 1 || tt > vm->vmgi->tt_srpt->nr_of_srpts)
++    return 0;
+   return set_VTS_PTT(vm, vm->vmgi->tt_srpt->title[tt - 1].title_set_nr,
+                      vm->vmgi->tt_srpt->title[tt - 1].vts_ttn, ptt);
+ }
+-- 
+2.53.0
+
diff --git a/tools/depends/target/libdvdnav/Makefile b/tools/depends/target/libdvdnav/Makefile
index 4e05b42..3b1a5f4 100644
--- a/tools/depends/target/libdvdnav/Makefile
+++ b/tools/depends/target/libdvdnav/Makefile
@@ -4,7 +4,8 @@ DEPS = ../../Makefile.include LIBDVDNAV-VERSION Makefile ../../download-files.in
                                   02-win-remove-lib-version.patch \
                                   03-all-fix-cell_find-for-cell-boundary.patch \
                                   04-all-fix-null-cell_playback.patch \
-                                  05-all-unsigned-subp-control-shift.patch
+                                  05-all-unsigned-subp-control-shift.patch \
+                                  06-all-set_PTT-check-the-title-number.patch
 
 MESON_BUILD_TYPE=release
 
@@ -42,6 +43,7 @@ all: .installed-$(PLATFORM)
 	cd $(PLATFORM); patch -p1 -i ../03-all-fix-cell_find-for-cell-boundary.patch
 	cd $(PLATFORM); patch -p1 -i ../04-all-fix-null-cell_playback.patch
 	cd $(PLATFORM); patch -p1 -i ../05-all-unsigned-subp-control-shift.patch
+	cd $(PLATFORM); patch -p1 -i ../06-all-set_PTT-check-the-title-number.patch
 ifeq ($(TARGET_PLATFORM),windows)
 	cd $(PLATFORM); patch -p1 -i ../01-win-uwpcompat.patch
 	cd $(PLATFORM); patch -p1 -i ../02-win-remove-lib-version.patch
