+
+#pragma once
+
+#include "DVStepDown.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The fidelity step-down level of native Dolby Vision frames with GUI elements over the
+ *        picture, where those frames do not keep up at the level of the frames without them
+ *
+ * CDVStepDown measures the frames without GUI elements only, and every frame of a format is drawn
+ * at the level that it finds for them (the base of the format). A frame with GUI elements over the
+ * picture (the player information, the OSD, a window over the dimmed video) is composed with them
+ * and takes longer: on a small GPU (an integrated Vega 8 with a profile 7 film with its full
+ * enhancement layer, reported on LibreELEC's forum) those frames miss their refreshes while the
+ * others keep up, and nothing measured them. Here they are measured, as CDVGuiLevel measures the
+ * frames with GUI elements of a profile 5 picture, and stepped down the levels of their ladder
+ * (dvbridge_render_step_levels()) below the base, by the rule of CDVStepDown, from the base:
+ *  - only frames with GUI elements over the picture, and only where those frames are measured not
+ *    to keep up; the frames without GUI elements are drawn at the base as before, and so are the
+ *    frames with GUI elements on a GPU where they keep up: the same bytes as without this;
+ *  - only levels of the ladder below the base (with the composer of ETSI GS CCM 001 in the source
+ *    transport, the resampling of the enhancement layer: levels 1 and 2), and only those that are
+ *    not measured to save nothing;
+ *  - back up when the level above (never above the base) would fit with room to spare.
+ *
+ * Each picture format (CDVFrameLoad), at each base level, ladder and refresh period, has a state of
+ * its own, at the base until its frames with GUI elements are found not to keep up. Its frames are
+ * measured in windows of WINDOW frames of one level drawn and one pace, leaving out the first
+ * seconds of a video and after a seek (SETTLE_MS), the first second after GUI elements come
+ * (GUI_SETTLE_MS: the GUI that appears is drawn and faded in meanwhile), the first frames after a
+ * change of level or of pace and after a picture that stood still (SKIP), and the frames drawn at
+ * another level than the format's (frames in flight). A window is behind as a window of
+ * CDVStepDown is (both its GPU times and its missed refreshes say so), and two windows in a row
+ * that are behind, or one in which the GPU could not keep up in any case, take the format down to
+ * the next level of its ladder that is not measured to save nothing (it takes GAIN of the level in
+ * use or more, or less by no more than the two measurements could be apart by chance). That level
+ * is measured before anything more is decided. When none keeps up, the format goes to the fastest
+ * level measured (of those that are not measured to save time on each other, the most faithful),
+ * and stays there while the pace stays. While frames are still to be presented a frame ahead
+ * (CDVStepDown::Pace::PENDING), that comes first: nothing goes down.
+ *
+ * Back up: the level above in the ladder, never above the base, when what it would take now (what
+ * the level in use takes, times what the level above took for what this one took, measured in two
+ * windows next to each other) fits with RELEASE_AHEAD or RELEASE_WAITING of the period, and only
+ * RELEASE_WAIT measured frames after the format last went down; where the level it went up to does
+ * not keep up after all, it goes down again, and the wait doubles. Nothing goes up on a guess.
+ *
+ * What is found stays from one video to the next (Restart()), not from one session to the next:
+ * the frames without GUI elements of a format that needs a level are drawn at it from the first
+ * one (CDVStepDown::Recall()), and their frames with GUI elements begin from there.
+ *
+ * This class only decides. The window system asks it for the level of each frame with GUI
+ * elements, tells it their GPU times and presentations, and logs what changes.
+ */
+class CDVGuiStep
+{
+public:
+  using Pace = CDVStepDown::Pace;
+  using Why = CDVStepDown::Why;
+  static constexpr int LEVELS = CDVStepDown::LEVELS;
+  static constexpr unsigned int WINDOW = CDVStepDown::WINDOW;
+
+  struct Step
+  {
+    bool changed = false; //!< the level of the format changed
+    Why why = Why::NONE; //!< BEHIND, NO_GAIN, NOTHING_KEEPS_UP (it stays) or FITS
+    int from = 0;
+    int to = 0;
+    int base = 0; //!< the level of the frames of the format without GUI elements
+    unsigned int ladder = 1;
+    Pace pace = Pace::PENDING; //!< of the window
+    double averageMs = 0; //!< ... its GPU time, without its slowest frame
+    double budgetMs = 0; //!< ... the mark of a frame at that pace and refresh period
+    double periodMs = 0;
+    unsigned int frames = 0;
+    unsigned int over = 0;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+    double estimateMs = 0; //!< FITS: what the level above would take now
+    std::array<double, LEVELS> knownMs{}; //!< what each level took (0: not known)
+  };
+
+  //! Whether the frames with GUI elements of frames of that base level and ladder are ones that
+  //! this decides for: a level of their ladder below the base changes anything
+  static bool Applies(int base, unsigned int ladder)
+  {
+    return CDVStepDown::In(CDVStepDown::Ladder(ladder), base) &&
+           CDVStepDown::Below(CDVStepDown::Ladder(ladder), base) >= 0;
+  }
+
+  //! The level to draw a frame with GUI elements of that format at: the base (the level of its
+  //! frames without GUI elements, CDVStepDown) unless its frames with GUI elements were measured
+  //! to need a level below it
+  int Level(uint64_t format, int base, unsigned int ladder, double periodMs) const
+  {
+    const Format* const f = Lookup(format, base, CDVStepDown::Ladder(ladder), periodMs);
+    return f ? f->level : base;
+  }
+
+  /*!
+   * \brief The GPU time of a frame with GUI elements whose picture did not stand still
+   * \param drawn the level it was drawn at (one at another level than its format's is not taken)
+   * \param ladder the levels that changed anything for it, as the renderer told them once it was
+   *        drawn
+   */
+  Step Measured(uint64_t format, int base, unsigned int ladder, int drawn, double ms, double periodMs,
+                Pace pace)
+  {
+    if (format == 0 || !Applies(base, ladder) || !(ms > 0) || !std::isfinite(ms) ||
+        !(periodMs > 0) || !std::isfinite(periodMs))
+      return Step();
+    Format& f = *Find(format, base, CDVStepDown::Ladder(ladder), periodMs);
+    if (drawn != f.level)
+      return Step();
+    Window& w = f.window;
+    if (w.count > 0 && w.pace != pace)
+    {
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+    }
+    const bool settling = m_settlingMs > 0 || m_guiSettlingMs > 0 || f.skip > 0;
+    if (m_settlingMs > 0)
+      m_settlingMs -= periodMs;
+    if (m_guiSettlingMs > 0)
+      m_guiSettlingMs -= periodMs;
+    if (f.skip > 0)
+      --f.skip;
+    if (settling)
+      return Step();
+    if (w.count == 0)
+    {
+      w = Window();
+      w.pace = pace;
+    }
+    w.sum += ms;
+    w.squares += ms * ms;
+    w.max = std::max(w.max, ms);
+    w.over += ms > LOADED_WAITING * periodMs ? 1 : 0;
+    if (++w.count < WINDOW)
+      return Step();
+    return Decide(f);
+  }
+
+  //! A frame with GUI elements whose picture did not stand still was presented, at that pace, and
+  //! whether it came with its refresh is known
+  void Presented(uint64_t format, int base, unsigned int ladder, int drawn, bool late, Pace pace,
+                 double periodMs)
+  {
+    Format* const f = Lookup(format, base, CDVStepDown::Ladder(ladder), periodMs);
+    if (!f || drawn != f->level || f->window.count == 0 || f->window.pace != pace)
+      return;
+    ++f->window.presented;
+    f->window.lost += late ? 1 : 0;
+  }
+
+  //! A frame without GUI elements was drawn while the video played: the first ones with GUI
+  //! elements that come after it are left out
+  void Plain()
+  {
+    m_guiSettlingMs = GUI_SETTLE_MS;
+    for (Format& f : m_formats)
+      f.Drop();
+  }
+
+  //! A frame with GUI elements whose picture stood still (a pause): the first frames after it
+  //! also carry the change
+  void Interrupted()
+  {
+    for (Format& f : m_formats)
+      f.skip = std::max(f.skip, SKIP);
+  }
+
+  //! The video jumped (a seek, a change of stream): the frames around it say nothing
+  void Seeked()
+  {
+    for (Format& f : m_formats)
+      f.Drop();
+    m_settlingMs = SETTLE_MS;
+  }
+
+  //! Native output ended: what is found stays, the windows begin again with the next video
+  void Restart() { Seeked(); }
+
+private:
+  static constexpr unsigned int SKIP = 6; //!< frames left out after a change
+  static constexpr double SETTLE_MS = 2000; //!< the start of a video, and after a seek
+  static constexpr double GUI_SETTLE_MS = 1000; //!< after GUI elements come
+  static constexpr size_t FORMATS = 8; //!< formats and refresh periods known at a time
+  // (the marks of CDVStepDown, for the same frames presented the same ways)
+  static constexpr double LOADED_AHEAD = 0.85;
+  static constexpr double LOADED_WAITING = 0.8;
+  static constexpr double RELEASE_AHEAD = 0.75;
+  static constexpr double RELEASE_WAITING = 0.7;
+  static constexpr double LOST_PART = 0.05;
+  static constexpr unsigned int LOST_MIN = 3;
+  static constexpr unsigned int KNOWN_MIN = WINDOW / 2;
+  static constexpr double GAIN = 0.95;
+  //! measured frames after a format went down before it goes up again (a minute of film), doubled
+  //! when the level it went up to did not keep up, up to about an hour of film
+  static constexpr unsigned int RELEASE_WAIT = 1440;
+  static constexpr unsigned int RELEASE_MAX_WAIT = 64 * RELEASE_WAIT;
+
+  struct Window
+  {
+    unsigned int count = 0;
+    double sum = 0;
+    double squares = 0;
+    double max = 0;
+    unsigned int over = 0; //!< frames over LOADED_WAITING of the period
+    Pace pace = Pace::PENDING;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+  };
+
+  struct Format
+  {
+    uint64_t id = 0; //!< 0: none
+    int base = 0;
+    unsigned int ladder = 1;
+    double periodMs = 0;
+    uint64_t used = 0; //!< m_clock of its last frame measured
+    int level = 0;
+    std::array<double, LEVELS> ms{}; //!< what each level took, the last window of it (0: not known)
+    std::array<double, LEVELS> error{}; //!< ... the standard error of that average
+    //! [n]: what the level above n in the ladder took for what level n took, in two windows next
+    //! to each other (0: not known)
+    std::array<double, LEVELS> ratio{};
+    int cameFrom = -1; //!< the level of before its last change, until a window at the new one ...
+    double leftMs = 0; //!< ... and what it took
+    Window window;
+    unsigned int skip = SKIP;
+    unsigned int behind = 0; //!< windows in a row that were behind, at its level
+    //! no level keeps up, at the pace of then: it is at the fastest
+    bool exhausted = false;
+    Pace exhaustedPace = Pace::PENDING;
+    unsigned int sinceDown = 0; //!< measured frames since it last went down
+    unsigned int releaseWait = RELEASE_WAIT;
+    bool upToKeep = false; //!< it went up, and no window has kept up there yet
+
+    void Drop()
+    {
+      window = Window();
+      behind = 0;
+    }
+  };
+
+  static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
+
+  static double Release(Pace pace) { return pace == Pace::AHEAD ? RELEASE_AHEAD : RELEASE_WAITING; }
+
+  static unsigned int Mark(unsigned int count)
+  {
+    return std::max(LOST_MIN, static_cast<unsigned int>(std::ceil(LOST_PART * count)));
+  }
+
+  //! The next level of the ladder above a level, never above the base; -1: none
+  static int Up(const Format& f, int level)
+  {
+    const int above = CDVStepDown::Above(f.ladder, level);
+    return above >= f.base ? above : -1;
+  }
+
+  Format* Lookup(uint64_t id, int base, unsigned int ladder, double periodMs)
+  {
+    for (Format& f : m_formats)
+    {
+      if (id != 0 && f.id == id && f.base == base && f.ladder == ladder &&
+          SamePeriod(f.periodMs, periodMs))
+        return &f;
+    }
+    return nullptr;
+  }
+  const Format* Lookup(uint64_t id, int base, unsigned int ladder, double periodMs) const
+  {
+    return const_cast<CDVGuiStep*>(this)->Lookup(id, base, ladder, periodMs);
+  }
+
+  //! The format, or a place for it: a free one, else the one measured longest ago of those at
+  //! their base, else the one measured longest ago
+  Format* Find(uint64_t id, int base, unsigned int ladder, double periodMs)
+  {
+    ++m_clock;
+    if (Format* const f = Lookup(id, base, ladder, periodMs))
+    {
+      f->used = m_clock;
+      return f;
+    }
+    const auto rank = [](const Format& g) { return g.id == 0 ? 0 : g.level != g.base ? 2 : 1; };
+    Format* place = &m_formats[0];
+    for (Format& f : m_formats)
+    {
+      if (rank(f) < rank(*place) || (rank(f) == rank(*place) && f.used < place->used))
+        place = &f;
+    }
+    *place = Format();
+    place->id = id;
+    place->base = base;
+    place->ladder = ladder;
+    place->periodMs = periodMs;
+    place->level = base;
+    place->used = m_clock;
+    return place;
+  }
+
+  //! What each level from the base down takes now, as far as it is known (as CDVStepDown::Now())
+  static std::array<double, LEVELS> Now(const Format& f)
+  {
+    std::array<double, LEVELS> now = f.ms;
+    for (int n = f.level, above = Up(f, n); above >= 0; n = above, above = Up(f, n))
+    {
+      const size_t at = static_cast<size_t>(n);
+      if (f.ratio[at] > 0 && now[at] > 0)
+        now[static_cast<size_t>(above)] = now[at] * f.ratio[at];
+    }
+    for (int n = f.level, below = CDVStepDown::Below(f.ladder, n); below >= 0;
+         n = below, below = CDVStepDown::Below(f.ladder, n))
+    {
+      const size_t at = static_cast<size_t>(below);
+      if (f.ratio[at] > 0 && now[static_cast<size_t>(n)] > 0)
+        now[at] = now[static_cast<size_t>(n)] / f.ratio[at];
+    }
+    return now;
+  }
+
+  //! Whether a level is measured to save time on another one (as CDVStepDown::Saves())
+  static bool Saves(const Format& f, const std::array<double, LEVELS>& now, int level, int other)
+  {
+    const size_t a = static_cast<size_t>(level);
+    const size_t b = static_cast<size_t>(other);
+    const auto error = [&f, &now](size_t n) {
+      return f.ms[n] > 0 ? f.error[n] * now[n] / f.ms[n] : 0.0;
+    };
+    return now[a] > 0 && now[b] > 0 && now[a] < GAIN * now[b] &&
+           now[b] - now[a] > 2 * std::hypot(error(a), error(b));
+  }
+
+  //! The fastest level from the base down that was measured; of those that are not measured to
+  //! save time on each other, the most faithful
+  static int Fastest(const Format& f)
+  {
+    const std::array<double, LEVELS> now = Now(f);
+    int best = -1;
+    for (int level = f.base; level < LEVELS; ++level)
+    {
+      if (CDVStepDown::In(f.ladder, level) && now[static_cast<size_t>(level)] > 0 &&
+          (best < 0 || Saves(f, now, level, best)))
+        best = level;
+    }
+    return best < 0 ? f.base : best;
+  }
+
+  Step Change(Format& f, int to, Why why, Step step)
+  {
+    step.changed = true;
+    step.why = why;
+    step.from = f.level;
+    step.to = to;
+    f.cameFrom = f.level;
+    f.leftMs = f.ms[static_cast<size_t>(f.level)];
+    f.level = to;
+    f.Drop();
+    f.skip = std::max(f.skip, SKIP);
+    return step;
+  }
+
+  //! A window of the format has ended (as CDVStepDown::Decide(), from the base down)
+  Step Decide(Format& f)
+  {
+    const Window w = f.window;
+    f.window = Window();
+    const size_t at = static_cast<size_t>(f.level);
+    // without the slowest frame: one that waited for something else says nothing of the level
+    const double n = w.count - 1;
+    const double average = (w.sum - w.max) / n;
+    f.ms[at] = average;
+    f.error[at] = std::sqrt(std::max(0.0, (w.squares - w.max * w.max) / n - average * average) / n);
+    // the first window after a change between two levels next to each other in the ladder: how
+    // they compare
+    if (f.cameFrom >= 0)
+    {
+      const int lower = std::max(f.cameFrom, f.level);
+      if (CDVStepDown::Above(f.ladder, lower) == std::min(f.cameFrom, f.level) && f.leftMs > 0)
+      {
+        const bool down = f.cameFrom < f.level;
+        f.ratio[static_cast<size_t>(lower)] = down ? f.leftMs / average : average / f.leftMs;
+      }
+      f.cameFrom = -1;
+    }
+
+    Step step;
+    step.from = step.to = f.level;
+    step.base = f.base;
+    step.ladder = f.ladder;
+    step.pace = w.pace;
+    step.averageMs = average;
+    step.periodMs = f.periodMs;
+    step.budgetMs = (w.pace == Pace::AHEAD ? LOADED_AHEAD : LOADED_WAITING) * f.periodMs;
+    step.frames = w.count;
+    step.over = w.over;
+    step.presented = w.presented;
+    step.lost = w.lost;
+    step.knownMs = f.ms;
+    f.sinceDown += w.count;
+
+    const bool known = w.presented >= KNOWN_MIN;
+    const bool missed = w.lost >= Mark(w.presented);
+    bool behind = false;
+    bool beyond = false; // the GPU could not keep up with these frames in any case
+    if (w.pace == Pace::AHEAD)
+    {
+      behind = known && missed && average > step.budgetMs;
+      beyond = average > f.periodMs;
+    }
+    else
+    {
+      behind = known && missed && w.over >= Mark(w.count);
+      beyond = 2 * w.over > w.count;
+    }
+    // what was found when no level kept up is of that pace (the period is the format's own)
+    if (f.exhausted && w.pace != Pace::PENDING && f.exhaustedPace != w.pace)
+      f.exhausted = false;
+
+    if (behind)
+    {
+      // frame ahead comes first; one window could have been slow for another reason
+      if (w.pace == Pace::PENDING || f.exhausted)
+        return step;
+      if (!beyond && ++f.behind < 2)
+        return step;
+      f.behind = 0;
+      // a level it went up to that does not keep up after all: it waits longer before it goes up
+      // again
+      if (f.upToKeep)
+      {
+        f.upToKeep = false;
+        f.releaseWait = std::min(2 * f.releaseWait, RELEASE_MAX_WAIT);
+      }
+      f.sinceDown = 0;
+      // down to the next level of the ladder that is not measured to save nothing
+      const std::array<double, LEVELS> now = Now(f);
+      for (int level = CDVStepDown::Below(f.ladder, f.level); level >= 0;
+           level = CDVStepDown::Below(f.ladder, level))
+      {
+        if (!(now[static_cast<size_t>(level)] > 0) || Saves(f, now, level, f.level))
+          return Change(f, level, Why::BEHIND, step);
+      }
+      // no level keeps up: the fastest, and there it stays
+      f.exhausted = true;
+      f.exhaustedPace = w.pace;
+      const int fastest = Fastest(f);
+      if (fastest != f.level)
+        return Change(f, fastest, Why::NO_GAIN, step);
+      step.why = Why::NOTHING_KEEPS_UP;
+      return step;
+    }
+
+    f.behind = 0;
+    if (!known)
+      return step;
+    // it keeps up here
+    if (f.upToKeep)
+    {
+      f.upToKeep = false;
+      f.releaseWait = RELEASE_WAIT;
+    }
+    const int above = Up(f, f.level);
+    if (above < 0 || f.sinceDown < f.releaseWait)
+      return step;
+    // up: what the level above would take now, by what it took for what this one took
+    const double estimate = Now(f)[static_cast<size_t>(above)];
+    if (estimate > 0 && estimate <= Release(w.pace) * f.periodMs)
+    {
+      step.estimateMs = estimate;
+      f.exhausted = false;
+      f.upToKeep = true;
+      return Change(f, above, Why::FITS, step);
+    }
+    return step;
+  }
+
+  std::array<Format, FORMATS> m_formats{};
+  uint64_t m_clock = 0;
