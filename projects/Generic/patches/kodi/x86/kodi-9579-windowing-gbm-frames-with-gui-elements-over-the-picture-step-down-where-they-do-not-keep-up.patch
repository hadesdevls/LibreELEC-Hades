+void CWinSystemGbmGLESContext::DVGuiStepReport(const CDVGuiStep::Step& step, uint64_t format)
+{
+  using Why = CDVGuiStep::Why;
+  if (!step.changed && step.why != Why::NOTHING_KEEPS_UP)
+    return;
+  // which frames, and what the window that decided found
+  const std::string which = StringUtils::Format(
+      "{}/64 of the picture active{}, the frames without GUI elements at level {}",
+      CDVFrameLoad::Active64ths(format),
+      CDVFrameLoad::WithResidual(format) ? ", the residual of the enhancement layer drawn" : "",
+      step.base);
+  const std::string window =
+      step.pace == CDVStepDown::Pace::AHEAD
+          ? StringUtils::Format("{:.1f} ms on average against {:.1f} ms, presented a frame ahead, "
+                                "{} of {} refreshes missed",
+                                step.averageMs, step.budgetMs, step.lost, step.presented)
+          : StringUtils::Format("presented the way that waits, {} of {} frames over {:.1f} ms "
+                                "({:.1f} ms on average), {} of {} refreshes missed",
+                                step.over, step.frames, step.budgetMs, step.averageMs, step.lost,
+                                step.presented);
+  std::string known = "what the levels took:";
+  for (int level = step.base; level < CDVStepDown::LEVELS; ++level)
+  {
+    if (!CDVStepDown::In(step.ladder, level))
+      continue;
+    const double ms = step.knownMs[static_cast<size_t>(level)];
+    known += ms > 0 ? StringUtils::Format(" {}: {:.1f} ms", level, ms)
+                    : StringUtils::Format(" {}: not measured", level);
+  }
+  const bool ccm = m_dvBridge && m_dvBridge->CCMComposer();
+  switch (step.why)
+  {
+    case Why::BEHIND:
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over the picture do not keep up at fidelity "
+                "step-down level {}: they are drawn at level {} ({}) while GUI elements are over "
+                "the picture, from now on ({}; {}; {})",
+                step.from, step.to, DVStepWhat(step.to, ccm), which, window, known);
+      break;
+    case Why::NO_GAIN:
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over the picture do not keep up at any "
+                "fidelity step-down level, and none below level {} is measured to save time: they "
+                "are drawn at level {} ({}) from now on ({}; {}; {})",
+                step.to, step.to, DVStepWhat(step.to, ccm), which, window, known);
+      break;
+    case Why::NOTHING_KEEPS_UP:
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over the picture do not keep up at any "
+                "fidelity step-down level: they stay at level {}, the fastest that was measured "
+                "({}; {}; {})",
+                step.to, which, window, known);
+      break;
+    case Why::FITS:
+      CLog::Log(LOGINFO,
+                "DVBridge: frames with GUI elements over the picture: level {} would take {:.1f} ms "
+                "now, which fits the {:.1f} ms of a refresh with room to spare: they are drawn at "
+                "level {} ({}) from now on, not {} ({}; {}; {})",
+                step.to, step.estimateMs, step.periodMs, step.to, DVStepWhat(step.to, ccm),
+                step.from, which, window, known);
+      break;
+    default:
+      break;
+  }
+}
