+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: bits per sample and sample rate of the audio
+msgctxt "#31815"
+msgid "Sample format"
+msgstr "Muestras"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: how the audio goes to the audio output (a bitstream, or PCM)
+msgctxt "#31816"
+msgid "Sent as"
+msgstr "Se envía como"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the signal of the audio output (channels, sample rate)
+msgctxt "#31817"
+msgid "Output signal"
+msgstr "Señal de salida"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the language of the audio
+msgctxt "#31818"
+msgid "Language"
+msgstr "Idioma"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the subtitles shown
+msgctxt "#31819"
+msgid "Subtitles"
+msgstr "Subtítulos"
+
+#: /xml/Variables.xml
+#. The audio output is sent the bitstream of the source, undecoded
+msgctxt "#31820"
+msgid "passthrough"
+msgstr "paso directo"
+
+#: /xml/Variables.xml
+#. The audio output is sent PCM, decoded from the source
+msgctxt "#31821"
+msgid "PCM, decoded"
+msgstr "PCM, decodificado"
+
+#: /xml/Variables.xml
+#. There is no audio output
+msgctxt "#31822"
+msgid "no audio output"
+msgstr "sin salida de audio"
+
+#: /xml/Variables.xml
+#. PCM samples in floating point
+msgctxt "#31823"
+msgid "float"
+msgstr "flotante"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the display mode (resolution and refresh rate) that is set
+msgctxt "#31824"
+msgid "Mode"
+msgstr "Modo"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the colorimetry that the display is told (connector property Colorspace)
+msgctxt "#31825"
+msgid "Colorimetry"
+msgstr "Colorimetría"
+
+#: /xml/Variables.xml
+#. Colorimetry: the default one, which the display takes from the mode (BT.709 for HD, BT.601 for SD)
+msgctxt "#31826"
+msgid "default (by the mode)"
+msgstr "predeterminada (del modo)"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the transport of native Dolby Vision
+msgctxt "#31827"
+msgid "Transport"
+msgstr "Transporte"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Native Dolby Vision: an 8-bit RGB signal that carries the 12-bit 4:2:2 Dolby Vision picture
+msgctxt "#31828"
+msgid "RGB 8-bit · DV 12-bit 4:2:2"
+msgstr "RGB 8 bits · DV 12 bits 4:2:2"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the picture that is scanned out (its pixel format)
+msgctxt "#31829"
+msgid "Framebuffer"
+msgstr "Búfer de imagen"
+
+#: /xml/Variables.xml
+#. The video is scanned out on a plane of its own, not in the framebuffer of the interface
+msgctxt "#31830"
+msgid "video on a plane of its own"
+msgstr "video en un plano propio"
+
+#: /xml/Variables.xml
+#. A framebuffer of 16-bit floating-point RGB
+msgctxt "#31831"
+msgid "RGB 16-bit float"
+msgstr "RGB 16 bits flotante"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the bits per colour of the output, as far as the driver says: exactly, or at most (what it sends is not reported)
+msgctxt "#31832"
+msgid "Output depth"
+msgstr "Profundidad de salida"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the mastering display of the HDR metadata sent (max / min luminance, primaries)
+msgctxt "#31833"
+msgid "Mastering display"
+msgstr "Masterización"
+
+#: /xml/Variables.xml
+#. A value that the metadata leaves unspecified (0)
+msgctxt "#31834"
+msgid "not given"
+msgstr "sin indicar"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: FEL frames shown with the residual of the enhancement layer, of all FEL frames, in the last 10 s
+msgctxt "#31835"
+msgid "FEL residual"
+msgstr "Residuo FEL"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the source (mastering) display of the RPU, min / max
+msgctxt "#31836"
+msgid "Source display"
+msgstr "Pantalla de origen"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the L2 trims of the RPU and their target displays
+msgctxt "#31837"
+msgid "L2 trims"
+msgstr "Ajustes L2"
+
+#: /xml/Variables.xml
+#. None (of trims, of blocks held back, of audio)
+msgctxt "#31838"
+msgid "none"
+msgstr "ninguno"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the L5 active area offsets of the RPU (left / right / top / bottom)
+msgctxt "#31839"
+msgid "L5 in the RPU"
+msgstr "L5 en el RPU"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the L5 active area sent to the display, on the 3840x2160 raster
+msgctxt "#31840"
+msgid "L5 sent"
+msgstr "L5 enviado"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the L5 active area sent to the display, made from the place of the picture because the RPU has none
+msgctxt "#31841"
+msgid "L5 sent (made)"
+msgstr "L5 enviado (creado)"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the extension blocks of the RPU, by level
+msgctxt "#31842"
+msgid "RPU blocks"
+msgstr "Bloques del RPU"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the extension blocks of the metadata that the display is sent, by level
+msgctxt "#31843"
+msgid "Blocks sent"
+msgstr "Bloques enviados"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the extension blocks of the RPU that the display is not sent
+msgctxt "#31844"
+msgid "Not sent"
+msgstr "No enviados"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: how native Dolby Vision frames without GUI elements are drawn (#31743 direct, #31744 composed)
+msgctxt "#31847"
+msgid "Drawing without GUI"
+msgstr "Dibujo sin interfaz"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: native Dolby Vision frames presented a frame ahead
+msgctxt "#31850"
+msgid "Frame ahead"
+msgstr "Fotograma adelantado"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the fidelity step-down level of native Dolby Vision drawing (#31746 on the Dolby Vision page)
+msgctxt "#31851"
+msgid "Fidelity step-down"
+msgstr "Reducción de fidelidad"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the memory in use
+msgctxt "#31852"
+msgid "Memory"
+msgstr "Memoria"
+
+#: /xml/Variables.xml
+#. A value that is not known
+msgctxt "#31853"
+msgid "not known"
+msgstr "no se sabe"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Note: an SDR video
+msgctxt "#31854"
+msgid "This video has no HDR or Dolby Vision metadata."
+msgstr "Este video no tiene metadatos HDR ni Dolby Vision."
+
+#: /xml/Variables.xml
+#. Primaries row: the mastering primaries are not P3-D65, BT.2020 or BT.709
+msgctxt "#31855"
+msgid "other"
+msgstr "otros"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. The fill of a queue by the amount of data in it
+msgctxt "#31856"
+msgid "data"
+msgstr "datos"
+
+#: /xml/Variables.xml
+#. The audio output is sent a bitstream that Kodi encoded from the decoded audio
+msgctxt "#31857"
+msgid "re-encoded"
+msgstr "recodificado"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Note: an HDR video whose output is SDR
+msgctxt "#31858"
+msgid "No HDR metadata is sent to the display."
+msgstr "No se envían metadatos HDR a la pantalla."
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: the primaries of the mastering display (P3-D65, BT.2020, BT.709, other)
+msgctxt "#31860"
+msgid "Primaries"
+msgstr "Primarios"
+
+#: /xml/Variables.xml
+#. Layers: the FEL enhancement layer is being resynchronized (short form of #31680)
+msgctxt "#31861"
+msgid "FEL resynchronizing"
+msgstr "FEL resincronizando"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Heading of the column of the source: its video
+msgctxt "#31862"
+msgid "Video"
+msgstr "Video"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Heading of the column of the source: its audio
+msgctxt "#31863"
+msgid "Audio"
+msgstr "Audio"
+
+#: /xml/DialogPlayerProcessInfo.xml
+#. Row: how full the player cache is (#31598 of Estuary, translated in every Spanish file)
+msgctxt "#31864"
+msgid "Player cache"
+msgstr "Caché del reproductor"
+
+#: /xml/Variables.xml
+#. Fidelity step-down level 0: the picture is drawn faithfully
+msgctxt "#31865"
+msgid "none (faithful)"
+msgstr "ninguna (imagen fiel)"
+
+#: /xml/Variables.xml
+#. Fidelity step-down: before its number (level 2)
+msgctxt "#31866"
+msgid "level"
+msgstr "nivel"
+
+#: /xml/Variables.xml
+#. Output depth: exactly that many bits (nvidia-drm with max bpc below 10)
+msgctxt "#31867"
+msgid "fixed"
+msgstr "fija"
+
+#: /xml/Variables.xml
+#. Output depth: before the most bits that the driver may choose (up to 10 bits)
+msgctxt "#31868"
+msgid "up to"
+msgstr "hasta"
+
+#: /xml/Variables.xml
+#. Output depth: the driver chooses the bits per colour, and does not report them
+msgctxt "#31869"
+msgid "the driver chooses"
+msgstr "elige el controlador"
