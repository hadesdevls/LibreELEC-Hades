+void CWinSystemGbmGLESContext::PublishPlayerInfo()
+{
+  auto* gui = CServiceBroker::GetGUI();
+  if (!gui)
+    return;
+  auto& windows = gui->GetWindowManager();
+  const bool shown = windows.IsWindowVisible(WINDOW_DIALOG_PLAYER_PROCESS_INFO);
+  if (!shown && !m_playerInfoShown)
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (shown && m_playerInfoShown && now - m_playerInfoTime < std::chrono::milliseconds(500))
+    return;
+  m_playerInfoShown = shown;
+  m_playerInfoTime = now;
+  CGUIWindow* home = windows.GetWindow(WINDOW_HOME);
+  if (!home)
+    return;
+
+  // Every key is always set, empty when it does not apply or is not known; all of them once the
+  // dialog closes.
+  std::map<std::string, std::string> info{
+      {"hades.out.display", ""},   {"hades.out.connector", ""}, {"hades.out.driver", ""},
+      {"hades.out.mode", ""},      {"hades.out.signal", ""},    {"hades.out.colorspace", ""},
+      {"hades.out.depthkind", ""}, {"hades.out.depth", ""},     {"hades.out.plane", ""},
+      {"hades.out.fbformat", ""},  {"hades.out.fbdepth", ""},   {"hades.out.mastering", ""},
+      {"hades.out.primaries", ""}, {"hades.out.cll", ""},       {"hades.audio.path", ""},
+      {"hades.audio.format", ""},  {"hades.audio.channels", ""}, {"hades.audio.rate", ""},
+      {"hades.audio.bits", ""},    {"hades.audio.srcrate", ""}, {"hades.audio.srcbits", ""},
+      {"hades.audio.bitrate", ""}, {"hades.video.size", ""},    {"hades.video.bitrate", ""},
+      {"hades.sys.cpu", ""},       {"hades.sys.memory", ""}};
+  if (shown)
+  {
+    // The display and the output: the mode that is set, and the properties of the connector as
+    // the kernel took them with the last commit that it accepted (CDRMAtomic keeps them then:
+    // asking the kernel would take all its mode-setting locks from the thread that draws), with
+    // the content of the HDR metadata blob, when there is one
+    CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+    const int fd = m_DRM ? m_DRM->GetFileDescriptor() : -1;
+#ifdef HAVE_DVBRIDGE
+    info["hades.out.display"] = DisplayModel();
+    const bool native = m_dvSignalling;
+#else
+    const bool native = false;
+#endif
+    if (fd >= 0 && m_playerInfoDriver.empty())
+    {
+      if (drmVersionPtr version = drmGetVersion(fd))
+      {
+        m_playerInfoDriver = version->name ? version->name : "";
+        drmFreeVersion(version);
+      }
+    }
+    info["hades.out.driver"] = m_playerInfoDriver;
+    if (const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+        mode && mode->htotal && mode->vtotal)
+    {
+      // as the kernel takes the refresh rate of a mode (drm_mode_vrefresh()): in fields for an
+      // interlaced one
+      const bool interlaced = (mode->flags & DRM_MODE_FLAG_INTERLACE) != 0;
+      const double refresh = mode->clock * 1000.0 /
+                             (static_cast<double>(mode->htotal) * mode->vtotal) *
+                             (interlaced ? 2 : 1);
+      info["hades.out.mode"] = StringUtils::Format("{}x{}{} @ {:.3f} Hz", mode->hdisplay,
+                                                   mode->vdisplay, interlaced ? "i" : "", refresh);
+    }
+    if (connector && fd >= 0)
+    {
+      info["hades.out.connector"] = connector->GetName();
+      const auto value = [&](const char* name) { return connector->GetPropertyValue(name); };
+      if (const auto colorspace = value("Colorspace"))
+        info["hades.out.colorspace"] =
+            connector->GetPropertyEnumName("Colorspace", *colorspace).value_or("");
+      // The bits per colour on the link are not reported by any of the drivers: what is known is
+      // what they may choose from. "max bpc" is an upper limit on amdgpu, i915 and xe, which
+      // choose the most that the display and the link take up to it. On nvidia-drm (Hades' own
+      // property, nvidia-open-kernel-modules-9000) a value below 10 drives the output at exactly
+      // 8 bpc, and 10 or more leaves it to NVKMS, at most nvidia-modeset's
+      // max_output_color_depth (10 unless set; 8 on HDMI without hdmi_deepcolor).
+      const auto bpc = value("max bpc");
+      if (m_playerInfoDriver == "nvidia-drm")
+      {
+        if (bpc && *bpc < 10)
+        {
+          info["hades.out.depthkind"] = "fixed";
+          info["hades.out.depth"] = "8";
+        }
+        else if (const int most = NvidiaOutputDepthLimit(connector->GetType() == "HDMI-A"))
+        {
+          info["hades.out.depthkind"] = "upto";
+          info["hades.out.depth"] = std::to_string(most);
+        }
+        else
+          info["hades.out.depthkind"] = "driver";
+      }
+      else if (bpc)
+      {
+        info["hades.out.depthkind"] = "upto";
+        info["hades.out.depth"] = std::to_string(*bpc);
+      }
+      // What the display is told of the picture: native Dolby Vision, or the EOTF of the HDR
+      // static metadata InfoFrame that the driver has, with its mastering display and light
+      // levels; no such metadata: SDR. Only where the connector has that property: elsewhere
+      // it is not known.
+      if (native)
+        info["hades.out.signal"] = "dv";
+      if (const auto hdr = value("HDR_OUTPUT_METADATA"))
+      {
+        if (!native)
+          info["hades.out.signal"] = "sdr";
+        std::unique_ptr<drmModePropertyBlobRes, decltype(&drmModeFreePropertyBlob)> blob(
+            *hdr ? drmModeGetPropertyBlob(fd, static_cast<uint32_t>(*hdr)) : nullptr,
+            &drmModeFreePropertyBlob);
+        hdr_output_metadata metadata{};
+        if (blob && blob->data && blob->length >= sizeof(metadata))
+        {
+          std::memcpy(&metadata, blob->data, sizeof(metadata));
+          // (metadata type 0: HDMI static metadata type 1, the only one there is)
+          if (metadata.metadata_type == 0)
+          {
+            const auto& frame = metadata.hdmi_metadata_type1;
+            if (!native)
+            {
+              switch (frame.eotf)
+              {
+                case 0:
+                  info["hades.out.signal"] = "sdr";
+                  break;
+                case 1:
+                  info["hades.out.signal"] = "hdrgamma";
+                  break;
+                case 2:
+                  info["hades.out.signal"] = "pq";
+                  break;
+                case 3:
+                  info["hades.out.signal"] = "hlg";
+                  break;
+                default:
+                  info["hades.out.signal"] = "";
+                  break;
+              }
+            }
+            // max in cd/m2, min in 0.0001 cd/m2; 0 is "not given" (CTA-861.3)
+            if (frame.max_display_mastering_luminance)
+              info["hades.out.mastering"] =
+                  StringUtils::Format("{} / {:.4f}", frame.max_display_mastering_luminance,
+                                      frame.min_display_mastering_luminance / 10000.0);
+            info["hades.out.primaries"] = MasteringPrimaries(frame);
+            info["hades.out.cll"] = frame.max_cll || frame.max_fall
+                                        ? StringUtils::Format("{} / {}", frame.max_cll,
+                                                              frame.max_fall)
+                                        : "none";
+          }
+        }
+      }
+    }
+    // The picture that is scanned out: the window's framebuffer, unless a renderer has the
+    // video on a plane of its own
+    if (GetVideoLayerBridge())
+      info["hades.out.plane"] = "video";
+    else if (const CDRMPlane* plane = m_DRM ? m_DRM->GetGuiPlane() : nullptr)
+    {
+      info["hades.out.fbformat"] = FourccName(plane->GetFormat());
+      info["hades.out.fbdepth"] = FourccDepth(plane->GetFormat());
+    }
+
+    // The audio output: what the audio engine's sink was opened with. A bitstream (passthrough,
+    // or Kodi's own AC-3 encoding) has its kind in it; PCM has none.
+    if (IAE* ae = CServiceBroker::GetActiveAE())
+    {
+      AEAudioFormat sink;
+      if (ae->HasNoSink())
+        info["hades.audio.path"] = "none";
+      else if (ae->GetCurrentSinkFormat(sink) && sink.m_dataFormat != AE_FMT_INVALID &&
+               sink.m_sampleRate)
+      {
+        info["hades.audio.channels"] = std::to_string(sink.m_channelLayout.Count());
+        info["hades.audio.rate"] = KiloHertz(sink.m_sampleRate);
+        if (sink.m_streamInfo.m_type != CAEStreamInfo::STREAM_TYPE_NULL)
+        {
+          info["hades.audio.path"] = "bitstream";
+          info["hades.audio.format"] = BitstreamName(sink.m_streamInfo.m_type);
+        }
+        else
+        {
+          info["hades.audio.path"] = "pcm";
+          info["hades.audio.bits"] =
+              sink.m_dataFormat == AE_FMT_FLOAT || sink.m_dataFormat == AE_FMT_DOUBLE ||
+                      sink.m_dataFormat == AE_FMT_FLOATP || sink.m_dataFormat == AE_FMT_DOUBLEP
+                  ? "float"
+                  : std::to_string(CAEUtil::DataFormatToUsedBits(sink.m_dataFormat));
+        }
+      }
+    }
+
+    // The numbers of the stream as Kodi's player information computes them (same source, same
+    // units: Kb/s of 1024 bits, Mb/s of 1048576), without the thousands separator that
+    // StringUtils::FormatNumber() puts in by the region: next to the decimals of the page,
+    // which Kodi writes with a point in every language ({:.3f} of Player.Process(videofps)), a
+    // "5.421" or "5,421" could be read as a decimal. No number on the page has one.
+    auto& cache = CServiceBroker::GetDataCacheCore();
+    if (cache.GetVideoWidth() > 0 && cache.GetVideoHeight() > 0)
+      info["hades.video.size"] =
+          StringUtils::Format("{}x{}", cache.GetVideoWidth(), cache.GetVideoHeight());
+    if (const int rate = cache.GetAudioSampleRate(); rate > 0)
+      info["hades.audio.srcrate"] = std::to_string(rate);
+    if (const int bits = cache.GetAudioBitsPerSample(); bits > 0)
+      info["hades.audio.srcbits"] = std::to_string(bits);
+    if (const int bitrate = cache.GetAudioLiveBitRate(); bitrate > 0)
+      info["hades.audio.bitrate"] = std::to_string(bitrate / 1024);
+    if (const int bitrate = cache.GetVideoLiveBitRate(); bitrate > 0)
+      info["hades.video.bitrate"] = StringUtils::Format("{:.1f}", bitrate / 1048576.0);
+
+    // The use of all processors, as System.CpuUsage gives it on other systems (on Linux it
+    // gives each processor); the memory in use and in all, in MB as System.Memory() has them
+    if (const auto cpu = CServiceBroker::GetCPUInfo(); cpu && cpu->SupportsCPUUsage())
+      info["hades.sys.cpu"] = std::to_string(cpu->GetUsedPercentage());
+    KODI::MEMORY::MemoryStatus memory{};
+    KODI::MEMORY::GetMemoryStatus(&memory);
+    if (memory.totalPhys)
+      info["hades.sys.memory"] = StringUtils::Format(
+          "{} / {}", static_cast<unsigned int>((memory.totalPhys - memory.availPhys) / MB),
+          static_cast<unsigned int>(memory.totalPhys / MB));
+  }
+  for (const auto& [key, value] : info)
+  {
+    auto& published = m_playerInfoPublished[key];
+    if (published != value)
+    {
+      home->SetProperty(key, value);
+      published = value;
+    }
+  }
+}
