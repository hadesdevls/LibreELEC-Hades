diff --git a/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
new file mode 100644
index 0000000..9627a25
--- /dev/null
+++ b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
@@ -0,0 +1,129 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hades: the parts of the overview page of the player information (DialogPlayerProcessInfo.xml).
+     Coordinates are those of Estuary's 1920x1080 skin, which Kodi scales to the GUI resolution.
+     A column is a vertical grouplist of these, 590 wide: a hidden part takes no room. What a row
+     is named goes in the smaller grey font, its value in the larger white one. -->
+<includes>
+	<!-- The heading of a section of a column; top: the room above it -->
+	<include name="HadesInfoHeading">
+		<param name="label"></param>
+		<param name="visible">true</param>
+		<param name="top">0</param>
+		<definition>
+			<control type="group">
+				<top>$PARAM[top]</top>
+				<width>590</width>
+				<height>46</height>
+				<visible>$PARAM[visible]</visible>
+				<control type="label">
+					<left>0</left>
+					<top>4</top>
+					<width>590</width>
+					<height>34</height>
+					<aligny>center</aligny>
+					<font>font25_title</font>
+					<textcolor>button_focus</textcolor>
+					<shadowcolor>black</shadowcolor>
+					<label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
+				</control>
+				<control type="image">
+					<left>0</left>
+					<top>40</top>
+					<width>590</width>
+					<height>1</height>
+					<texture colordiffuse="40FFFFFF">colors/white.png</texture>
+				</control>
+			</control>
+		</definition>
+	</include>
+	<!-- A row: what it is on the left, its value on the right -->
+	<include name="HadesInfoRow">
+		<param name="name"></param>
+		<param name="value"></param>
+		<param name="visible">true</param>
+		<param name="font">font12</param>
+		<definition>
+			<control type="group">
+				<width>590</width>
+				<height>30</height>
+				<visible>$PARAM[visible]</visible>
+				<control type="label">
+					<left>0</left>
+					<top>0</top>
+					<width>250</width>
+					<height>30</height>
+					<aligny>center</aligny>
+					<font>font10</font>
+					<textcolor>grey</textcolor>
+					<shadowcolor>black</shadowcolor>
+					<label>$PARAM[name]</label>
+				</control>
+				<control type="label">
+					<left>250</left>
+					<top>0</top>
+					<width>340</width>
+					<height>30</height>
+					<align>right</align>
+					<aligny>center</aligny>
+					<font>$PARAM[font]</font>
+					<textcolor>white</textcolor>
+					<shadowcolor>black</shadowcolor>
+					<label>$PARAM[value]</label>
+				</control>
+			</control>
+		</definition>
+	</include>
+	<!-- A row for a long value: what it is, and under it its value across the column -->
+	<include name="HadesInfoRowWide">
+		<param name="name"></param>
+		<param name="value"></param>
+		<param name="visible">true</param>
+		<definition>
+			<control type="group">
+				<width>590</width>
+				<height>58</height>
+				<visible>$PARAM[visible]</visible>
+				<control type="label">
+					<left>0</left>
+					<top>0</top>
+					<width>590</width>
+					<height>28</height>
+					<aligny>center</aligny>
+					<font>font10</font>
+					<textcolor>grey</textcolor>
+					<shadowcolor>black</shadowcolor>
+					<label>$PARAM[name]</label>
+				</control>
+				<control type="label">
+					<left>0</left>
+					<top>26</top>
+					<width>590</width>
+					<height>30</height>
+					<align>right</align>
+					<aligny>center</aligny>
+					<font>font12</font>
+					<textcolor>white</textcolor>
+					<shadowcolor>black</shadowcolor>
+					<label>$PARAM[value]</label>
+				</control>
+			</control>
+		</definition>
+	</include>
+	<!-- A line across a column, for a note -->
+	<include name="HadesInfoNote">
+		<param name="label"></param>
+		<param name="visible">true</param>
+		<definition>
+			<control type="label">
+				<width>590</width>
+				<height>30</height>
+				<aligny>center</aligny>
+				<font>font12</font>
+				<textcolor>grey</textcolor>
+				<shadowcolor>black</shadowcolor>
+				<label>$PARAM[label]</label>
+				<visible>$PARAM[visible]</visible>
+			</control>
+		</definition>
+	</include>
+</includes>
