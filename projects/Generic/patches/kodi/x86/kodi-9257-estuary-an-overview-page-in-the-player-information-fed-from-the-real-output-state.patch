+// Hades: a DRM pixel format by its four letters ("XR30")
+std::string FourccName(uint32_t format)
+{
+  std::string name;
+  for (int i = 0; i < 4; ++i)
+  {
+    const char c = static_cast<char>((format >> (8 * i)) & 0xff);
+    if (c > ' ' && c < 0x7f)
+      name += c;
+  }
+  return name;
+}
+
+// ... and the depth of each of its RGB components, for the formats of a picture that Kodi scans
+// out: "8", "10", "16f" (half float); empty for another one
+const char* FourccDepth(uint32_t format)
+{
+  switch (format)
+  {
+    case DRM_FORMAT_XRGB8888:
+    case DRM_FORMAT_ARGB8888:
+    case DRM_FORMAT_XBGR8888:
+    case DRM_FORMAT_ABGR8888:
+      return "8";
+    case DRM_FORMAT_XRGB2101010:
+    case DRM_FORMAT_ARGB2101010:
+    case DRM_FORMAT_XBGR2101010:
+    case DRM_FORMAT_ABGR2101010:
+      return "10";
+    case DRM_FORMAT_XRGB16161616F:
+    case DRM_FORMAT_ARGB16161616F:
+    case DRM_FORMAT_XBGR16161616F:
+    case DRM_FORMAT_ABGR16161616F:
+      return "16f";
+    default:
+      return "";
+  }
+}
+
+// The primaries and the white point of the mastering display in HDR static metadata (CTA-861.3,
+// in units of 0.00002) as one of the standard ones: "p3" (P3 with the D65 white point), "bt2020",
+// "bt709"; "other"; empty when the metadata gives none. The order of the three primaries is
+// not taken for granted.
+std::string MasteringPrimaries(const hdr_metadata_infoframe& m)
+{
+  bool given = m.white_point.x || m.white_point.y;
+  for (const auto& p : m.display_primaries)
+    given = given || p.x || p.y;
+  if (!given)
+    return "";
+  const auto near = [](uint16_t value, double reference)
+  { return std::abs(value / 50000.0 - reference) <= 0.002; };
+  if (!near(m.white_point.x, 0.3127) || !near(m.white_point.y, 0.3290))
+    return "other";
+  struct Space
+  {
+    const char* name;
+    double xy[3][2];
+  };
+  static constexpr Space spaces[] = {
+      {"p3", {{0.680, 0.320}, {0.265, 0.690}, {0.150, 0.060}}},
+      {"bt2020", {{0.708, 0.292}, {0.170, 0.797}, {0.131, 0.046}}},
+      {"bt709", {{0.640, 0.330}, {0.300, 0.600}, {0.150, 0.060}}}};
+  for (const auto& space : spaces)
+  {
+    bool all = true;
+    for (const auto& reference : space.xy)
+    {
+      bool found = false;
+      for (const auto& p : m.display_primaries)
+        found = found || (near(p.x, reference[0]) && near(p.y, reference[1]));
+      all = all && found;
+    }
+    if (all)
+      return space.name;
+  }
+  return "other";
+}
+
+// The most bits per colour at which NVKMS drives an output, by nvidia-modeset's parameters as
+// nvkms_max_output_color_bpc() takes max_output_color_depth (6, 8 or 12; anything else is 10)
+// and nvkms-hdmi.c takes hdmi_deepcolor (without it, HDMI stays at 8); 0 when they cannot be
+// read. They are read once: they are fixed when the module loads (permission 0444).
+int NvidiaOutputDepthLimit(bool hdmi)
+{
+  static const std::pair<int, bool> parameters = []
+  {
+    std::string depth;
+    std::string deepColour;
+    std::ifstream depthFile("/sys/module/nvidia_modeset/parameters/max_output_color_depth");
+    std::ifstream deepColourFile("/sys/module/nvidia_modeset/parameters/hdmi_deepcolor");
+    if (!(depthFile >> depth) || !(deepColourFile >> deepColour))
+      return std::make_pair(0, true);
+    const int value = std::atoi(depth.c_str());
+    return std::make_pair(value == 6 || value == 8 || value == 12 ? value : 10, deepColour != "N");
+  }();
+  if (!parameters.first)
+    return 0;
+  return hdmi && !parameters.second ? std::min(parameters.first, 8) : parameters.first;
+}
+
+// A sample rate in kHz: "48", "44.1"
+std::string KiloHertz(unsigned int rate)
+{
+  return rate % 1000 ? StringUtils::Format("{:.1f}", rate / 1000.0) : std::to_string(rate / 1000);
+}
