+ * \brief What the log and the player information say of the GPU time of each pass of native Dolby
+ *        Vision frames, where advancedsettings.xml asks for it (<video><dvpasstimes>true</dvpasstimes>
+ *        </video>; CDVBridgeGLES::TakePassTimes(), dvbridge_passtime.h)
+ *
+ * The passes of a window come the most time first (their sum), merged by name. A pass is named by
+ * libplacebo's description of it (its steps, separated by commas) or, for the bridge's own passes,
+ * "bridge: <what> (<transport>)": the log has the whole name, the page a short one (Short()).
+ */
+struct CDVPassTimes
+{
+  //! the passes that the 10-s line of the log names, and how long the text of the Dolby Vision page is
+  //! (36: with the label of the row, "GPU by pass" and its translations, within the 885 pixels of a label
+  //! of the page in Estuary's font14, as measured with that font)
+  static constexpr unsigned int LOGGED = 6;
+  static constexpr size_t SHOWN_CHARS = 36;
+  static constexpr size_t SHORT_CHARS = 18;
+
+  //! The name that the Dolby Vision page shows, at most most characters and without a comma:
+  //!  - a pass of the bridge's own: what it does ("bridge: 4:2:2 rows (source transport)": "4:2:2 rows");
+  //!  - a pass of the composer of CCM 001 (libplacebo-9930): its plane ("DV composer: EL luma, vertical
+  //!    (CCM 001 annex B.3)": "EL luma");
+  //!  - libplacebo's pass that draws into the target (its steps are several: sampling, scaling, the colour
+  //!    decoding, the hooks of the bridge): "output";
+  //!  - a pass of libplacebo's scaling in one direction ("ortho (vert) upscaling (lanczos)"): "vertical
+  //!    scaling", "horizontal scaling";
+  //!  - any other: the first of its steps, without what is in parentheses.
+  static std::string Short(const std::string& name, size_t most = SHORT_CHARS)
+  {
+    std::string s = name;
+    const auto has = [&s](const char* what) { return s.find(what) != std::string::npos; };
+    if (s.rfind("bridge: ", 0) == 0)
+      s.erase(0, 8);
+    else if (const auto composer = s.find("DV composer: "); composer != std::string::npos)
+      s.erase(0, composer + 13);
+    else if (has(", ") && (has("color decoding") || has("DV ") || has("Skip reconstruction")))
+      return "output";
+    else if (s.rfind("ortho (vert)", 0) == 0)
+      return "vertical scaling";
+    else if (s.rfind("ortho (horiz)", 0) == 0)
+      return "horizontal scaling";
+    if (const auto comma = s.find(','); comma != std::string::npos)
+      s.erase(comma);
+    if (const auto paren = s.find(" ("); paren != std::string::npos)
+      s.erase(paren);
+    if (s.size() > most)
+    {
+      s.erase(most);
+      // (not in the middle of a UTF-8 sequence)
+      while (!s.empty() && (static_cast<unsigned char>(s.back()) & 0xC0) == 0x80)
+        s.pop_back();
+      if (!s.empty() && (static_cast<unsigned char>(s.back()) & 0xC0) == 0xC0)
+        s.pop_back();
+    }
+    while (!s.empty() && (s.back() == ' ' || s.back() == ':'))
+      s.pop_back();
+    return s.empty() ? std::string("?") : s;
+  }
+
+  static double Average(const dvbridge_pass_time& p) { return p.count ? p.sum_ms / p.count : 0.0; }
+
+  //! The end of the 10-s line of the log: "; GPU time by pass, the most first (average / longest ms,
+  //! times): "<name>" 3.10 / 4.02 x240; ..."; empty without passes
+  static std::string Line(const std::vector<dvbridge_pass_time>& passes)
+  {
+    if (passes.empty())
+      return {};
+    std::string text = "; GPU time by pass, the most first (average / longest ms, times):";
+    char buffer[DVBRIDGE_PASS_NAME + 64];
+    for (size_t i = 0; i < passes.size(); ++i)
+    {
+      std::snprintf(buffer, sizeof(buffer), "%s \"%s\" %.2f / %.2f x%u", i ? ";" : "", passes[i].name,
+                    Average(passes[i]), passes[i].max_ms, passes[i].count);
+      text += buffer;
+    }
+    return text;
+  }
+
+  //! The Dolby Vision page: the passes that take the most, "name average" each, as many as fit in most
+  //! characters, and "ms" at the end; empty without passes
+  static std::string Compact(const std::vector<dvbridge_pass_time>& passes, size_t most = SHOWN_CHARS)
+  {
+    std::string text;
+    char number[32];
+    for (const auto& p : passes)
+    {
+      std::snprintf(number, sizeof(number), " %.1f", Average(p));
+      const std::string part = (text.empty() ? "" : " \xc2\xb7 ") + Short(p.name) + number; // ·
+      // (the middle dot is one character of two bytes)
+      const size_t shown = Chars(text) + Chars(part) + 3;
+      if (!text.empty() && shown > most)
+        break;
+      text += part;
+    }
+    return text.empty() ? text : text + " ms";
+  }
+
+  //! characters of a UTF-8 text
+  static size_t Chars(const std::string& s)
+  {
+    size_t n = 0;
+    for (const char c : s)
+      n += (static_cast<unsigned char>(c) & 0xC0) != 0x80;
+    return n;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
