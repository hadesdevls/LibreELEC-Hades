diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index aa3652a..42255ac 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -431,6 +431,13 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   params.egl_display = eglGetCurrentDisplay();
   params.egl_context = eglGetCurrentContext();
   params.allow_software = allowSoftware;
+  // Hades: the GPU time of each pass, to measure on a GPU what each part of a frame costs:
+  // <video><dvpasstimes>true</dvpasstimes></video>. libplacebo times its passes on OpenGL ES only
+  // where it is made so (libplacebo-9944): every pass then begins and ends a timer query, which is
+  // why it is off by default
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const bool passTimes = component && component->GetAdvancedSettings()->m_videoDVPassTimes;
+  params.gles_timer_queries = passTimes;
   if (params.egl_context == EGL_NO_CONTEXT)
     return Fail("egl-context");
   if (!m_log)
@@ -451,6 +458,19 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
       !pl_opengl_has_ext(m_gl, "GL_OES_texture_float_linear"))
     return Fail("float-blend-or-float-linear-capability");
   m_renderer = dvbridge_renderer_create(m_gl->gpu, m_log);
+  if (passTimes && m_renderer)
+  {
+    dvbridge_render_time_passes(m_renderer, true);
+    m_passTimes = true;
+    bool placebo = false;
+    bool own = false;
+    dvbridge_render_passes_timed(m_renderer, &placebo, &own);
+    CLog::Log(LOGINFO,
+              "DVBridge: the GPU time of each pass of a frame is measured, as advancedsettings.xml "
+              "asks (dvpasstimes): libplacebo's passes {}, the bridge's own {}",
+              placebo ? "timed" : "not timed (no GL_EXT_disjoint_timer_query)",
+              own ? "timed" : "not timed (no GL_EXT_disjoint_timer_query)");
+  }
   // To measure on hardware what it saves, advancedsettings.xml can turn off the writing of the
   // bars before the reconstruction: <video><dvearlymask>false</dvearlymask></video>
   if (const auto settings = CServiceBroker::GetSettingsComponent();
@@ -1189,6 +1209,22 @@ unsigned int CDVBridgeGLES::TakeL1Changes()
   return changes;
 }
 
+std::vector<dvbridge_pass_time> CDVBridgeGLES::TakePassTimes(unsigned int max)
+{
+  if (!m_passTimes)
+    return {};
+  std::vector<dvbridge_pass_time> passes(max);
+  const unsigned int all = dvbridge_render_take_pass_times(m_renderer, passes.data(), max);
+  passes.resize(std::min(all, max));
+  return passes;
+}
+
+void CDVBridgeGLES::PassTimesLost()
+{
+  if (m_passTimes)
+    dvbridge_render_pass_times_lost(m_renderer);
+}
