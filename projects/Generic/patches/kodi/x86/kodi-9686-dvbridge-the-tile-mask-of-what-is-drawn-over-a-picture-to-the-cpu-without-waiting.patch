@@ -1077,6 +1077,16 @@ bool CDVBridgeGLES::GuiInPlace() const
   return m_prepared && !m_direct && dvbridge_render_gui_in_place(m_renderer);
 }
 
+bool CDVBridgeGLES::RequestDrawnTiles(unsigned int serial)
+{
+  return m_prepared && !m_direct && m_renderer && dvbridge_render_tiles_request(m_renderer, serial);
+}
+
+int CDVBridgeGLES::PollDrawnTiles(uint8_t* mask, unsigned int& serial)
+{
+  return m_renderer ? dvbridge_render_tiles_poll(m_renderer, mask, &serial) : -1;
+}
