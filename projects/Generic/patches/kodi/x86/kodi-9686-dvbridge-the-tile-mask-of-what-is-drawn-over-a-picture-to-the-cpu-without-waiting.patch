 bool CDVBridgeGLES::CompletePicture()
 {
   // (a frame drawn directly has no picture to draw into; one composed by the converted transport
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
