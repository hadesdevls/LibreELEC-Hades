 tools/dvbridge/dvbridge_render.h              |   4 +
 tools/dvbridge/dvbridge_source.c              |  94 ++++++++++++++++
 tools/dvbridge/dvbridge_source.h              |  11 ++
 tools/dvbridge/dvbridge_tiles.h               | 105 ++++++++++++++++++
 .../VideoRenderers/DVBridgeGLES.cpp           |  10 ++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |   7 ++
 7 files changed, 241 insertions(+)
 create mode 100644 tools/dvbridge/dvbridge_tiles.h

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 4d2cafb..5e9dd2b 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -2757,6 +2757,16 @@ bool dvbridge_render_can_gui_in_place(const struct dvbridge_renderer *r)
     return r && dvbridge_source_can_gui_in_place(r->source_packer);
 }
 
+bool dvbridge_render_tiles_request(struct dvbridge_renderer *r, unsigned serial)
+{
+    return r && r->ready && r->source && dvbridge_source_tiles_request(r->source_packer, serial);
+}
+
+int dvbridge_render_tiles_poll(struct dvbridge_renderer *r, uint8_t *mask, unsigned *serial)
+{
+    return r && r->source_packer ? dvbridge_source_tiles_poll(r->source_packer, mask, serial) : -1;
+}
