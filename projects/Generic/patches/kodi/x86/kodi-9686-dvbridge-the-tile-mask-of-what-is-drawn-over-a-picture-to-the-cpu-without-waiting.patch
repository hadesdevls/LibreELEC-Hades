 bool dvbridge_source_can_gui_in_place(const struct dvbridge_source_packer *packer);
 bool dvbridge_source_gui_in_placed(const struct dvbridge_source_packer *packer);
+/* Hades: the tile mask of what is drawn over the picture of the last dvbridge_source_picture(), to the CPU
+ * without waiting for it: the tiles of the raster (DVBRIDGE_SOURCE_TILE x DVBRIDGE_SOURCE_TILE pixels, row 0
+ * the top of the raster) that the composite of the GUI texture may draw on (pass 7). request: copies the
+ * mask into a buffer read back by the GPU on its own time (a fence), tagged serial; false where the last
+ * picture has no mask (a picture whose tiles were not made, or a frame with none drawn over it), or where
+ * a request is still waiting. poll: 1 and the mask (one byte a tile, 0 or 1, columns x rows) and the
+ * serial of its request where it is back, 0 where it is not back yet, -1 where nothing waits or the
+ * request was lost. For the composite to draw its quad under glScissor (dvbridge_tiles.h). */
+bool dvbridge_source_tiles_request(struct dvbridge_source_packer *packer, unsigned serial);
+int dvbridge_source_tiles_poll(struct dvbridge_source_packer *packer, uint8_t *mask, unsigned *serial);
 /* Hades: no picture of dvbridge_source_picture() is taken from now on (another render) */
 void dvbridge_source_forget(struct dvbridge_source_packer *packer);
 
diff --git a/tools/dvbridge/dvbridge_tiles.h b/tools/dvbridge/dvbridge_tiles.h
new file mode 100644
index 0000000..8c7ed39
--- /dev/null
+++ b/tools/dvbridge/dvbridge_tiles.h
@@ -0,0 +1,105 @@
+/*
