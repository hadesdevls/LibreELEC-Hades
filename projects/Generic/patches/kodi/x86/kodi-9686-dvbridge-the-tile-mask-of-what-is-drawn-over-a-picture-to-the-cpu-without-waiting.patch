 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index eddadd6..9594559 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -515,6 +515,10 @@ void dvbridge_render_set_drawn(struct dvbridge_renderer *renderer, unsigned gui,
 void dvbridge_render_set_gui_in_place(struct dvbridge_renderer *renderer, float peak);
 bool dvbridge_render_gui_in_place(const struct dvbridge_renderer *renderer);
 bool dvbridge_render_can_gui_in_place(const struct dvbridge_renderer *renderer);
+/* Hades: the tile mask of what is drawn over the prepared frame (dvbridge_source_tiles_request(), _poll()):
+ * only for a frame prepared in the source transport with its GUI told (dvbridge_render_set_drawn()) */
+bool dvbridge_render_tiles_request(struct dvbridge_renderer *renderer, unsigned serial);
+int dvbridge_render_tiles_poll(struct dvbridge_renderer *renderer, uint8_t *mask, unsigned *serial);
 /* Hades: the GUI cache of the source transport (dvbridge_source_gui_cache(): the bytes of the
  * tiles where the GUI is opaque and did not change are copied from the frame before that packed
  * them, not converted again; the same bytes). Off until asked for; it takes the frames whose
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 7667611..f3fbead 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -1823,6 +1823,12 @@ struct dvbridge_source_packer {
     struct texture gui_prev, blocks_quarter, blocks, ctiles, state[2], opaque_quarter, cache, again,
         differ;
     GLuint tiles_texture;
+    /* Hades: the read-back of the tile mask (dvbridge_source_tiles_request()): the framebuffer that the
+     * tiles are attached to for it, the buffer it is read into, the fence of that read, the serial of
+     * the request that waits */
+    GLuint tr_framebuffer, tr_buffer;
+    GLsync tr_fence;
+    unsigned tr_serial;
     int state_now, cache_level;
     struct cache_key key;
     unsigned stats[4];
@@ -2225,6 +2231,10 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     texture_destroy(&p->gui_tiles);
     texture_destroy(&p->tiles);
     texture_destroy(&p->pairs);
+    if (p->tr_fence)
+        glDeleteSync(p->tr_fence);
+    glDeleteFramebuffers(1, &p->tr_framebuffer);
+    glDeleteBuffers(1, &p->tr_buffer);
     dvbridge_source_gui_release(p);
     glDeleteVertexArrays(1, &p->vao);
     glDeleteSamplers(1, &p->sampler);
@@ -2835,6 +2845,90 @@ bool dvbridge_source_gui_in_placed(const struct dvbridge_source_packer *p)
     return p && p->inplace;
 }
 
+_Static_assert(DVBRIDGE_SOURCE_TILE == DRAWN_TILE && DVBRIDGE_SOURCE_TILE_COLUMNS == DRAWN_COLUMNS &&
+                   DVBRIDGE_SOURCE_TILE_ROWS == DRAWN_ROWS,
+               "the tile mask of dvbridge_source.h is that of the passes");
+
+bool dvbridge_source_tiles_request(struct dvbridge_source_packer *p, unsigned serial)
+{
+    /* (the tiles of this picture: made by dvbridge_source_picture(), and still those of it) */
+    if (!p || !p->tiles_mode || !p->tiles_texture || p->tr_fence)
+        return false;
+    const size_t bytes = (size_t)DRAWN_COLUMNS * DRAWN_ROWS * 4;
+    dvbridge_gl_drain_errors();
+    struct dvbridge_gl_state state;
+    dvbridge_gl_state_save(&state);
+    GLint pack = 0, alignment = 4;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    bool ok = true;
+    if (!p->tr_framebuffer)
+        glGenFramebuffers(1, &p->tr_framebuffer);
+    if (!p->tr_buffer) {
+        glGenBuffers(1, &p->tr_buffer);
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, p->tr_buffer);
+        glBufferData(GL_PIXEL_PACK_BUFFER, (GLsizeiptr)bytes, NULL, GL_STREAM_READ);
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, p->tr_framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, p->tiles_texture, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+        ok = false;
+    if (ok) {
+        /* (RGBA and unsigned bytes: what every implementation reads from an 8-bit target; the tiles
+         * of the passes are R8 or RGBA8, the flag in red) */
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, p->tr_buffer);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, DRAWN_COLUMNS, DRAWN_ROWS, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        p->tr_fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        glFlush();
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+        glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        ok = p->tr_fence && glGetError() == GL_NO_ERROR;
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    dvbridge_gl_state_restore(&state);
+    if (!ok) {
+        if (p->tr_fence)
+            glDeleteSync(p->tr_fence);
+        p->tr_fence = NULL;
+        dvbridge_gl_drain_errors();
+        return false;
+    }
+    p->tr_serial = serial;
+    return true;
+}
+
+int dvbridge_source_tiles_poll(struct dvbridge_source_packer *p, uint8_t *mask, unsigned *serial)
+{
+    if (!p || !p->tr_fence)
+        return -1;
+    /* (not waited for: a read that is not done is asked again next time) */
+    const GLenum waited = glClientWaitSync(p->tr_fence, 0, 0);
+    if (waited == GL_TIMEOUT_EXPIRED)
+        return 0;
+    glDeleteSync(p->tr_fence);
+    p->tr_fence = NULL;
+    if (waited != GL_ALREADY_SIGNALED && waited != GL_CONDITION_SATISFIED)
+        return -1;
+    GLint pack = 0;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, p->tr_buffer);
+    const uint8_t *d = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0,
+                                        (GLsizeiptr)DRAWN_COLUMNS * DRAWN_ROWS * 4, GL_MAP_READ_BIT);
+    if (d && mask) {
+        for (unsigned i = 0; i < DRAWN_COLUMNS * DRAWN_ROWS; ++i)
+            mask[i] = d[4 * i] > 127;
+    }
+    if (d)
+        glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, (GLuint)pack);
+    if (!d)
+        return -1;
+    if (serial)
+        *serial = p->tr_serial;
+    return 1;
+}
+
 void dvbridge_source_forget(struct dvbridge_source_packer *p)
 {
     if (!p)
