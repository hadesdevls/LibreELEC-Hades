+/* Hades: the rectangles of the tile mask of what is drawn over a picture (dvbridge_source.h,
+ * dvbridge_source_tiles_poll()), for the composite of Kodi's GUI to draw its quad under glScissor.
+ *
+ * Why that is exact. The composite is one quad over the whole raster whose fragment shader samples
+ * the GUI texture and discards a fragment whose sample has an alpha of 0. The tile mask marks every
+ * tile of the raster where a sample can have an alpha above 0 (pass 7 of the source packer: the
+ * texels around those of all its pixels, with a margin, in a tile of the GUI texture that holds
+ * anything drawn). The same quad drawn once for each rectangle of marked tiles, under glScissor,
+ * has the fragments of the whole quad inside the rectangles and none outside: the scissor test is
+ * a per-fragment test after rasterisation that does not change what rasterisation produces or what
+ * the fragment shader computes for a fragment (OpenGL ES 3.0.6, section 4.1.2, Scissor Test: a
+ * fragment outside the scissor rectangle is discarded; the rasterisation of a primitive, section
+ * 3.5, does not depend on it, so the window coordinates and the varyings of each fragment are those
+ * of the draw without it). The bytes inside
+ * the rectangles are the whole quad's, and outside them the whole quad writes nothing (it discards).
+ * Rectangles of tiles are disjoint, so no fragment is drawn twice (it would blend twice). */
+#ifndef DVBRIDGE_TILES_H
+#define DVBRIDGE_TILES_H
+#include <stdint.h>
+
+#define DVBRIDGE_TILE_RECTS_MAX 24
+/* the tiles of the raster of the source transport: DVBRIDGE_SOURCE_TILE x DVBRIDGE_SOURCE_TILE pixels, in
+ * DVBRIDGE_SOURCE_TILE_COLUMNS columns and DVBRIDGE_SOURCE_TILE_ROWS rows (dvbridge_source.c checks them) */
+#define DVBRIDGE_SOURCE_TILE 16
+#define DVBRIDGE_SOURCE_TILE_COLUMNS 240
+#define DVBRIDGE_SOURCE_TILE_ROWS 135
+/* the tiles of the raster of the source transport: DVBRIDGE_SOURCE_TILE x DVBRIDGE_SOURCE_TILE pixels, in
+ * DVBRIDGE_SOURCE_TILE_COLUMNS columns and DVBRIDGE_SOURCE_TILE_ROWS rows (dvbridge_source.c checks them) */
+#define DVBRIDGE_SOURCE_TILE 16
+#define DVBRIDGE_SOURCE_TILE_COLUMNS 240
+#define DVBRIDGE_SOURCE_TILE_ROWS 135
+
+/* in tiles */
+struct dvbridge_tile_rect {
+    unsigned x, y, w, h;
+};
+
+/* The marked tiles of mask (cols x rows, row 0 first, nonzero: marked) as rectangles whose tiles
+ * are all marked and that hold every marked tile once: runs of marked tiles in a row, joined with
+ * the run of the row below where both have the same columns. Returns the number of rectangles
+ * (0: no tile is marked), or -1 where there are more than max (the whole quad is then drawn), or
+ * where the marked tiles are more than percent of all of them (not worth it). */
+static inline int dvbridge_tiles_merge(const uint8_t *mask, unsigned cols, unsigned rows,
+                                       struct dvbridge_tile_rect *out, unsigned max,
+                                       unsigned percent)
+{
+    if (!mask || !out || !cols || !rows || max > DVBRIDGE_TILE_RECTS_MAX)
+        return -1;
+    unsigned marked = 0;
+    for (unsigned i = 0; i < cols * rows; ++i)
+        marked += mask[i] != 0;
+    if (!marked)
+        return 0;
+    if ((unsigned long)marked * 100ul > (unsigned long)cols * rows * percent)
+        return -1;
+    /* open[]: the rectangles whose last row is the row before */
+    unsigned count = 0;
+    unsigned open[DVBRIDGE_TILE_RECTS_MAX], opened = 0;
+    for (unsigned y = 0; y < rows; ++y) {
+        unsigned still[DVBRIDGE_TILE_RECTS_MAX], kept = 0;
+        unsigned x = 0;
+        while (x < cols) {
+            if (!mask[y * cols + x]) {
+                ++x;
+                continue;
+            }
+            unsigned end = x;
+            while (end < cols && mask[y * cols + end])
+                ++end;
+            int joined = -1;
+            for (unsigned k = 0; k < opened; ++k) {
+                const struct dvbridge_tile_rect *r = &out[open[k]];
+                if (r->x == x && r->w == end - x && r->y + r->h == y) {
+                    joined = (int)open[k];
+                    break;
+                }
+            }
+            if (joined >= 0) {
+                ++out[joined].h;
+                still[kept++] = (unsigned)joined;
+            } else {
+                if (count == max)
+                    return -1;
+                out[count].x = x;
+                out[count].y = y;
+                out[count].w = end - x;
+                out[count].h = 1;
+                still[kept++] = count++;
+            }
+            x = end;
+        }
+        opened = kept;
+        for (unsigned k = 0; k < kept; ++k)
+            open[k] = still[k];
+    }
+    return (int)count;
+}
+#endif
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index faaaa02..0e55f32 100644
