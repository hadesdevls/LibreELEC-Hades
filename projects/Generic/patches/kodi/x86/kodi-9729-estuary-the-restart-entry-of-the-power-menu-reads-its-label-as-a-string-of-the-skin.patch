From 48fdf1b0738a07d7cfd85de59d41f5ee0bf0f2cd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:13:10 +0000
Subject: [PATCH] estuary: the "Restart" entry of the power menu reads its
 label as a string of the skin

Kodi reads $LOCALIZE[n] as a string of the skin only for 31000 to 31999 (ADDON::IsSkinStringId); any
other id is one of Kodi's own strings, so the label of this entry, Estuary's 32501, came out blank.
$ADDON[skin.estuary 32501] reads it from the skin's own file, as the pages of Hades for other
skins already read theirs.
---
 addons/skin.estuary/xml/DialogButtonMenu.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/addons/skin.estuary/xml/DialogButtonMenu.xml b/addons/skin.estuary/xml/DialogButtonMenu.xml
index 2ce50b7..6042dba 100644
--- a/addons/skin.estuary/xml/DialogButtonMenu.xml
+++ b/addons/skin.estuary/xml/DialogButtonMenu.xml
@@ -56,7 +56,7 @@
 						<visible>System.CanReboot</visible>
 					</item>
 					<item>
-						<label>$LOCALIZE[32501]</label>
+						<label>$ADDON[skin.estuary 32501]</label>
 						<onclick>RestartApp()</onclick>
 						<visible>System.Platform.Linux</visible>
 					</item>
-- 
2.53.0

