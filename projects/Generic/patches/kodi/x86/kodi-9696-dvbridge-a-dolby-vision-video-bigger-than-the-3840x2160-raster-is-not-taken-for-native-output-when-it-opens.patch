From 69d39643cf13a9156f78b5a5a0de17474896b1db Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:46:55 +0000
Subject: [PATCH] dvbridge: a Dolby Vision video bigger than the 3840x2160
 raster is not taken for native output when it opens

The size of the picture was not looked at when a video was taken for native Dolby Vision
output. A 4096-wide video (DCI 4K, scope or flat) was: the display entered Dolby Vision, the
bridge refused every picture because it imports a picture only up to the raster of its
transport (dvbridge_prepare_why(), dvbridge_gl_frame_import()), Kodi gave native output up
after two seconds of refused pictures with a second change of the display mode, and a
profile 5 picture then came out as its base layer, in the wrong colours.

It is now decided where the other conditions are, when the video opens (the size that the
stream says, in CDVDStreamInfo; 0 is not a reason) and again for each picture
(VideoPicture), and the video plays as Kodi plays it, with one line in the log that says why.
DVBRIDGE::SourceFitsRaster() is the rule, in the policy header so that a test runs on the
host.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 22 +++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 31 ++++++++++++++-----
 2 files changed, 44 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 384fda4..186bc45 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -14,10 +14,28 @@ namespace DVBRIDGE
 {
 // Keep software metadata probes and ordinary HDR/SDR playback on Kodi's path.
 constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
-                        bool dolbySource, bool softwareProbe, bool interlaced, bool stereo)
+                        bool dolbySource, bool softwareProbe, bool interlaced, bool stereo,
+                        bool fitsRaster = true)
 {
   return standardDVDisplay && transportAvailable && dolbySource &&
-         !softwareProbe && !interlaced && !stereo;
+         !softwareProbe && !interlaced && !stereo && fitsRaster;
+}
+
+/*!
+ * \brief Hades: whether a picture of this size can go out natively: the transport is the
+ *        3840x2160 raster, and the bridge imports a picture only up to that size
+ *        (dvbridge_prepare_why(), dvbridge_gl_frame_import(), the import of the layers)
+ *
+ * A picture wider or taller than that (a 4096x2160 cinema video) was taken as eligible, since the
+ * size was not looked at: the display entered Dolby Vision, the bridge refused every picture, and
+ * Kodi gave native output up after two seconds of them, with a second change of the display mode,
+ * and a profile 5 picture then came out as its base layer, in the wrong colours. This is decided
+ * when the video opens, as it must be, with the size the stream says (0: not said yet, which is
+ * not a reason). The pictures themselves are checked again (VideoPicture).
+ */
+constexpr bool SourceFitsRaster(int width, int height)
+{
+  return width <= 3840 && height <= 2160;
 }
 
 /*!
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2954fc0..e673cb6 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2310,13 +2310,19 @@ void CWinSystemGbmGLESContext::CompositeGui()
 #ifdef HAVE_DVBRIDGE
 namespace
 {
-bool NativeDVEligible(bool source, bool software, bool interlaced, bool stereo, bool anyMode)
+bool NativeDVEligible(bool source,
+                      bool software,
+                      bool interlaced,
+                      bool stereo,
+                      bool anyMode,
+                      bool fitsRaster = true)
 {
   if (!source || software)
     return false;
   auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
   const bool available = window && window->SupportsNativeDVOutput(anyMode);
-  return DVBRIDGE::Eligible(available, available, source, software, interlaced, stereo);
+  return DVBRIDGE::Eligible(available, available, source, software, interlaced, stereo,
+                            fitsRaster);
 }
 
 // Hades: the output that the user chose for the video that plays (DVBRIDGE::OutputChoice)
@@ -2367,15 +2373,24 @@ bool StreamEligible(const CDVDStreamInfo& stream, bool anyMode)
   // (Hades: nor a video sent as the HDR10+ it also is: CDVDStreamInfo::doviHdr10PlusWins)
   const bool chosen =
       DVBRIDGE::NativeAllowed(DVBRIDGE::GetOutputChoice()) && !stream.doviHdr10PlusWins;
+  // (Hades: not a picture bigger than the raster that the output carries, decided here, before the
+  // display enters Dolby Vision: DVBRIDGE::SourceFitsRaster())
+  const bool fits = DVBRIDGE::SourceFitsRaster(stream.width, stream.height);
+  if (!fits && stream.dovi.dv_profile != 0 && !anyMode)
+    CLog::Log(LOGINFO,
+              "DVBridge: native Dolby Vision output is not used for this video: its picture is "
+              "{}x{}, and the output carries at most 3840x2160. It plays as Kodi plays it",
+              stream.width, stream.height);
   const bool eligible = chosen && NativeDVEligible(stream.dovi.dv_profile != 0, software,
                                                    stream.interlaced, !stream.stereo_mode.empty(),
-                                                   anyMode);
+                                                   anyMode, fits);
   CLog::Log(LOGDEBUG,
             "DVBridge: stream selection codec={} profile={} level={} software={} interlaced={} "
-            "stereo={} any_mode={} chosen={} selected={}; selection is provisional until kernel "
-            "atomic validation",
+            "stereo={} any_mode={} chosen={} fits_raster={} selected={}; selection is provisional "
+            "until kernel atomic validation",
             static_cast<int>(stream.codec), stream.dovi.dv_profile, stream.dovi.dv_level,
-            software, stream.interlaced, !stream.stereo_mode.empty(), anyMode, chosen, eligible);
+            software, stream.interlaced, !stream.stereo_mode.empty(), anyMode, chosen, fits,
+            eligible);
   return eligible;
 }
 
@@ -2386,7 +2401,9 @@ bool PictureEligible(const VideoPicture* picture, bool anyMode)
   return picture && !picture->doviNoNative && !picture->doviBaseRefused &&
          NativeDVEligible(picture->doviMetadata.Data() != nullptr, false,
                           (picture->iFlags & DVP_FLAG_INTERLACED) != 0,
-                          !picture->stereoMode.empty(), anyMode);
+                          !picture->stereoMode.empty(), anyMode,
+                          DVBRIDGE::SourceFitsRaster(static_cast<int>(picture->iWidth),
+                                                     static_cast<int>(picture->iHeight)));
 }
 } // namespace
 
