@@ -218,7 +220,27 @@ public:
   void HeldModeReleased(bool released) { m_heldMode = released; }
 
   //! A commit was made (CWinSystemGbm::FlipPage()): the one a hold released went out with it
-  void HeldModeCommitted() { m_heldMode = false; }
+  //! (Hades: with or without a payload queued, ModeCommitWithout())
+  void HeldModeCommitted()
+  {
+    if (m_heldMode)
+    {
+      m_modeCommitSeen = true;
+      m_modeCommitCarried = m_queued.has_value();
+    }
+    m_heldMode = false;
+  }
+
+  /*!
+   * \brief Hades: no commit of the mode of this video carried an HDR10+ payload: the one the hold
+   *        released went without, or the video made no change of mode. Where the driver signals
+   *        the mode otherwise with HDR10+ (i915 at 2160p24, 25 and 30:
+   *        CDVPlusModeStart::NeededFor()), that is the likely reason why it refuses every commit
+   *        with HDR10+: the log of the refusal says so.
+   */
+  bool ModeCommitWithout() const { return !(m_modeCommitSeen && m_modeCommitCarried); }
+  //! ... a commit of the mode of this video went out (with or without a payload)
+  bool ModeCommitSeen() const { return m_modeCommitSeen; }
 
   /*!
    * \brief Output::withMode of a frame: the request is the one the hold released (HeldModeReleased()),
@@ -258,6 +280,8 @@ private:
   bool m_refused = false;
   int m_testError = 0;
   bool m_heldMode = false;
+  bool m_modeCommitSeen = false; //!< Hades: see ModeCommitWithout()
+  bool m_modeCommitCarried = false;
 };
 
 } // namespace GBM
