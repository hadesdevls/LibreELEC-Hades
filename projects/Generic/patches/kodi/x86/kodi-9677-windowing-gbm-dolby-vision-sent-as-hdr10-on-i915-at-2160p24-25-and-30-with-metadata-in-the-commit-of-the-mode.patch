+bool CWinSystemGbmGLESContext::DVPlusModeStart(const CDVBridgeGLES::Layer& layer,
+                                               const CDVMetadataBuffer& metadata)
+{
+  // (cheap first: the commit of the mode of the video, once a video, before anything went out)
+  if (m_dvPlusModeStartDone || m_dvPlusSending || !HDR10PlusWithModeNow())
+    return false;
+  m_dvPlusModeStartDone = true;
+  std::string driver;
+  if (drmVersionPtr version = drmGetVersion(m_DRM->GetFileDescriptor()))
+  {
+    if (version->name)
+      driver = version->name;
+    drmFreeVersion(version);
+  }
+  const auto* mode = m_DRM->GetSelectedMode();
+  const double refresh =
+      mode && mode->htotal && mode->vtotal ? mode->clock * 1000.0 / (mode->htotal * mode->vtotal)
+                                           : 0;
+  const bool needed =
+      mode && CDVPlusModeStart::NeededFor(driver, mode->hdisplay, mode->vdisplay, refresh);
+  if (CDVPlusModeStart::For(needed, true, false) != CDVPlusModeStart::Then::WAIT)
+    return false;
+  const int version = HDR10PlusOutputVersion();
+  std::optional<std::array<uint8_t, 27>> measured, provisional;
+  const auto start = std::chrono::steady_clock::now();
+  if (dvbridge_dvplus_gl_wait(m_dvPlusGl.get(), layer.pts,
+                              static_cast<uint64_t>(CDVPlusModeStart::WaitNs(DVPlusPeriodNs()))))
+  {
+    DVPlusCollect();
+    dvbridge_dvplus_stats stats{};
+    if (dvbridge_dvplus_present_again(m_dvPlus.get(), layer.pts, &stats))
+    {
+      AVDynamicHDRPlus made{};
+      dvbridge_dvplus_metadata_version(&stats, version, &made);
+      measured = KODI::UTILS::HDR10PLUS::MakeVsif(made);
+    }
+  }
+  const double waitedMs =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+  dvbridge_dvplus_stats stats{};
+  if (!measured)
+  {
+    dvbridge_dvplus_rpu rpu{};
+    if (dvbridge_dvplus_rpu_of(metadata.Data(), metadata.Size(), &rpu) &&
+        dvbridge_dvplus_provisional(&rpu, &stats))
+    {
+      AVDynamicHDRPlus made{};
+      dvbridge_dvplus_metadata_version(&stats, version, &made);
+      provisional = KODI::UTILS::HDR10PLUS::MakeVsif(made);
+    }
+  }
+  m_dvPlusStartPts = DVD_NOPTS_VALUE; // (the wait of the first picture of a scene is this one)
+  switch (CDVPlusModeStart::After(measured.has_value(), provisional.has_value()))
+  {
+    case CDVPlusModeStart::Outcome::MEASURED:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision sent as HDR10+: {} at {}x{} {:.3f} Hz takes HDR10+ in the "
+                "commit of the mode only, so the first picture waited for its own measurement "
+                "({:.1f} ms) and goes out with it in that commit",
+                driver, mode->hdisplay, mode->vdisplay, refresh, waitedMs);
+      SetHDR10Plus(measured);
+      break;
+    case CDVPlusModeStart::Outcome::PROVISIONAL:
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision sent as HDR10+: {} at {}x{} {:.3f} Hz takes HDR10+ in the "
+                "commit of the mode only, and the first picture was not measured in {:.1f} ms: it "
+                "goes out in that commit with provisional metadata from the level 1 block of its "
+                "RPU (maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2), until the first measurement "
+                "replaces them",
+                driver, mode->hdisplay, mode->vdisplay, refresh, waitedMs, stats.average / 10.0,
+                stats.percentiles[8] / 10.0);
+      m_dvPlusProvisional = provisional;
+      m_dvPlusProvisionalFrames = 0;
+      SetHDR10Plus(provisional);
+      break;
+    case CDVPlusModeStart::Outcome::NONE:
+      CLog::Log(LOGWARNING,
+                "DVBridge: Dolby Vision sent as HDR10+: {} at {}x{} {:.3f} Hz takes HDR10+ in the "
+                "commit of the mode only, and the first picture was neither measured in {:.1f} ms "
+                "nor has a level 1 block to make provisional metadata of: the commit of the mode "
+                "goes without HDR10+, and the driver will likely refuse it after it",
+                driver, mode->hdisplay, mode->vdisplay, refresh, waitedMs);
+      break;
+  }
+  return true;
+}
