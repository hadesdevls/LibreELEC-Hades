+bool CWinSystemGbm::HDR10PlusWithModeNow() const
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  return connector && m_hdr10Plus.WithMode(drm->ModesetPending(),
+                                           drm->RequestValue(connector, "HDR_OUTPUT_METADATA"));
+}
