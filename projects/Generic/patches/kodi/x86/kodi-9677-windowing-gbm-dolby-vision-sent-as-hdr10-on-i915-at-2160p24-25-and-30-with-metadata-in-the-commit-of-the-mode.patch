+    const auto* mode = m_DRM->GetSelectedMode();
+    const double refresh = mode && mode->htotal && mode->vtotal
+                               ? mode->clock * 1000.0 / (mode->htotal * mode->vtotal)
+                               : 0;
+    if (mode && CDVPlusModeStart::NeededFor(driver, mode->hdisplay, mode->vdisplay, refresh))
+      likely = StringUtils::Format(
+          ". The likely reason: {} ({}x{} at {:.3f} Hz), and {} sends HDR10+ at this mode only "
+          "where a commit of the mode carries it (it then names the mode by its CTA VIC in place "
+          "of the HDMI VIC, which no commit after it can change)",
+          m_hdr10Plus.ModeCommitSeen()
+              ? "the commit of the mode of the video went without HDR10+ metadata"
+              : "the video made no change of mode, so no commit of the mode carried HDR10+ "
+                "metadata",
+          mode->hdisplay, mode->vdisplay, refresh, driver);
+  }
   if (m_hdr10Plus.TestError() != 0)
     CLog::Log(LOGWARNING,
               "HDR10+: the driver refused the dynamic metadata in the test of {} commits ({}; "
-              "its reason, where it gives one, is in the kernel log): the video goes on as HDR10",
-              CHDR10PlusOutput::REFUSED_AFTER, strerror(m_hdr10Plus.TestError()));
+              "its reason, where it gives one, is in the kernel log): the video goes on as "
+              "HDR10{}",
+              CHDR10PlusOutput::REFUSED_AFTER, strerror(m_hdr10Plus.TestError()), likely);
   else
     CLog::Log(LOGWARNING,
               "HDR10+: the driver took {} commits without keeping the dynamic metadata of any: the "
