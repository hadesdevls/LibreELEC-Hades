+/*!
+ * \brief Hades: Dolby Vision sent as HDR10+ (CWinSystemGbmGLESContext::DVConversionHDR10Plus()),
+ *        the first picture of a video, in the commit of its mode
+ *
+ * i915 and xe signal 2160p24, 25 and 30 (and 4096x2160p24, and their 1000/1001 rates) with the HDMI
+ * VIC in the HDMI vendor InfoFrame and VIC 0 in the AVI InfoFrame; HDR10+ takes that vendor DIP, so
+ * with HDR10+ the mode goes out with its CTA VIC in the AVI InfoFrame instead (linux-9982). Only a
+ * commit that may change the mode can change the AVI InfoFrame there, so HDR10+ has to be in the
+ * commit of the mode of the video (CHDR10PlusOutput::WithMode()); after it, every commit with HDR10+
+ * is refused, and after CHDR10PlusOutput::REFUSED_AFTER of them the video goes on as HDR10. A film's
+ * own HDR10+ is in that commit with its first frame. Dolby Vision sent as HDR10+ has nothing there
+ * as it was: the metadata of a picture are measured on the GPU once it is drawn, and read back a
+ * frame or more later. 1.0 RC4 thus sent every Dolby Vision video as HDR10 on i915 at 2160p23.976
+ * (issue #2: an i3-1005G1 with a Samsung S90H).
+ *
+ * Where the driver needs it (NeededFor()), the first picture of the video, drawn for the commit of
+ * the mode, waits for its own measurement (WaitNs(): two periods of the mode, 100 ms at most; a
+ * change of mode takes far longer at the display); it goes out with it. Where the measurement does
+ * not come by then, it goes out with provisional metadata from the level 1 block of its RPU
+ * (dvbridge_dvplus_provisional()), until the first measurement replaces them; without a level 1
+ * block, as before. Everywhere else (amdgpu, nvidia-drm, i915 at the other modes: HDR10+ starts
+ * with a flip there) nothing changes. The log says which of these it was (For(), After()).
+ */
+class CDVPlusModeStart
+{
+public:
+  static constexpr int64_t WAIT_MAX_NS = 100000000;
+
+  //! The driver signals this mode otherwise where HDR10+ goes with it: i915 and xe, at the modes
+  //! that DRM names by an HDMI VIC (3840x2160 up to 30 Hz, 4096x2160 at 24 Hz)
+  static bool NeededFor(std::string_view driver, int width, int height, double refreshHz)
+  {
+    return (driver == "i915" || driver == "xe") && height == 2160 &&
+           (width == 3840 || width == 4096) && refreshHz > 0 && refreshHz < 30.5;
+  }
+
+  //! How long the first picture waits for its own measurement, for a mode of periodNs a refresh
+  static int64_t WaitNs(int64_t periodNs)
+  {
+    return periodNs > 0 ? std::min<int64_t>(2 * periodNs, WAIT_MAX_NS) : WAIT_MAX_NS;
+  }
+
+  enum class Then
+  {
+    AS_BEFORE, //!< nothing of this: the first picture of a scene waits as it does (DVPlusMeasure())
+    WAIT, //!< this picture waits for its measurement, else goes out with provisional metadata
+  };
+
+  /*!
+   * \brief What a picture just drawn does. needed: NeededFor() the mode on the screen when the
+   *        commit is made; withMode: this frame's request is the commit of the mode of the video
+   *        (CHDR10PlusOutput::WithMode()); sent: HDR10+ went out already in this video (then the
+   *        mode went with it, or did not and this cannot change it)
+   */
+  static Then For(bool needed, bool withMode, bool sent)
+  {
+    return needed && withMode && !sent ? Then::WAIT : Then::AS_BEFORE;
+  }
+
+  enum class Outcome
+  {
+    MEASURED, //!< the picture's own measurement came in time
+    PROVISIONAL, //!< it did not: provisional metadata from the level 1 block
+    NONE, //!< neither: the commit of the mode goes without HDR10+ (as in 1.0 RC4)
+  };
+
+  static Outcome After(bool measured, bool provisional)
+  {
+    return measured ? Outcome::MEASURED : provisional ? Outcome::PROVISIONAL : Outcome::NONE;
+  }
+
+  /*!
+   * \brief A picture after the commit of the mode that its measurement does not describe yet
+   *        (nothing of the video measured): it goes out with the provisional metadata of the
+   *        commit of the mode while those were sent, the module sends nothing, and fewer than
+   *        lost pictures have gone so: the commits after the mode then keep HDR10+, and i915 the
+   *        CTA VIC, without an InfoFrame that comes and goes before the first measurement
+   */
+  static bool KeepProvisional(bool provisional, bool moduleSends, unsigned int since,
+                              unsigned int lost)
+  {
+    return provisional && !moduleSends && since < lost;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
