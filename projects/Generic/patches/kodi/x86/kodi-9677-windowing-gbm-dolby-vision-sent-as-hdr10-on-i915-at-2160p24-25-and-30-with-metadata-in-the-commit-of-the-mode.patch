 {
   CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
@@ -3547,11 +3556,39 @@ void CWinSystemGbm::HDR10PlusCommitted()
   }
   if (!m_hdr10Plus.Committed(connector->GetPropertyValue(CHDR10PlusOutput::PROPERTY)))
     return;
+  // Hades: where the commit of the mode went without metadata on a driver that signals the mode
+  // otherwise with HDR10+, that is the likely reason (CDVPlusModeStart)
+  std::string likely;
+  if (m_hdr10Plus.TestError() != 0 && m_hdr10Plus.ModeCommitWithout())
+  {
+    std::string driver;
+    if (drmVersionPtr version = drmGetVersion(m_DRM->GetFileDescriptor()))
+    {
+      if (version->name)
+        driver = version->name;
+      drmFreeVersion(version);
