From 3cefeb0cd0c388f8e3d62cb7f91dc46c39438afb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:58:10 +0000
Subject: [PATCH] tools/dvbridge: find the start codes of a packet by their
 last byte

The module looks at the units of every base packet as it comes, on the
decoder thread: the RPU that the base decoder will take
(dvbridge_rpu_nlq_packet()), and, while the layer waits for a picture to
start at, the type of the base picture; and at those of each access unit
of the layer that the split gives. With lengths before the units (hvcC:
Matroska, MP4) that is a jump from unit to unit. With start codes (a
transport stream, a disc) every byte was looked at, one at a time, in C:
both dvbridge_rpu_units() and has_layer_unit().

They now find each start code by its last byte with memchr(), and look
only at the two (three) bytes before it: the same start codes, in the
same order, and the same units (no start code ends before the first 1
that follows where the last search stopped).

Measured on the host, on the FEL test stream with start codes (2878
packets of 56 kB on average; -O2, the best of 5 rounds; the module's
decoder not opened): dvbridge_fel_submit() took 45.8 microseconds a
packet before and 21.7 now; the reading of the RPU alone 23.5 and 4.1, the
type of the picture 10.1 and 1.7. With lengths (the same stream in
Matroska) nothing changes (16.4 and 16.5): what is left there is FFmpeg's,
its HEVC parser on the whole packet (5.8) and the split (6.4). A packet of a
Blu-ray at 60 to 80 Mbit/s is five to seven times larger.

The scans give the same units as the scans byte by byte (copied into the
test as they were) on all 2878 packets with start codes and their 2876
access units of the layer, also where a reader stops early, and on 300000
made-up buffers of zeros and ones; moving where either search starts by
one byte makes that test fail. The pictures of the stream with start codes
(fel_rpu_test annexb, as Kodi) and of the two-track transport stream with
the FEL and MEL schedules of mel_test are byte for byte those of before.
---
 tools/dvbridge/dvbridge_fel.c | 15 +++++++++++----
 tools/dvbridge/dvbridge_mel.h | 11 +++++++++--
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index d0efa22..b231837 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -120,11 +120,18 @@ static bool has_layer_unit(const AVPacket *packet, int length_size)
         }
         return false;
     }
-    /* The filter writes 00 00 00 01 before every unit, and no unit contains that. */
-    for (; end - data >= 5; ++data)
-        if (!data[0] && !data[1] && !data[2] && data[3] == 1 &&
-            (data[4] >> 1 & 0x3f) != RPU_UNIT)
+    /* The filter writes 00 00 00 01 before every unit, and no unit contains that. Hades: found by
+     * its 1 (memchr(), as dvbridge_rpu_units()), with a byte after it, at the places a look at
+     * every byte finds it. */
+    while (end - data >= 5) {
+        const uint8_t *one = memchr(data + 3, 1, (size_t)(end - 1 - (data + 3)));
+        if (!one)
+            return false;
+        data = one - 3;
+        if (!data[0] && !data[1] && !data[2] && (data[4] >> 1 & 0x3f) != RPU_UNIT)
             return true;
+        ++data;
+    }
     return false;
 }
 
diff --git a/tools/dvbridge/dvbridge_mel.h b/tools/dvbridge/dvbridge_mel.h
index b16d728..57d648a 100644
--- a/tools/dvbridge/dvbridge_mel.h
+++ b/tools/dvbridge/dvbridge_mel.h
@@ -345,10 +345,17 @@ static inline void dvbridge_rpu_units(const uint8_t *data, size_t size, int leng
         return;
     }
     /* a unit runs from after a start code to the next one; the zero bytes before that are not
-     * its own (trailing_zero_8bits, and the first byte of a start code of four) */
+     * its own (trailing_zero_8bits, and the first byte of a start code of four). Hades: the
+     * start codes are found by their last byte (memchr(), which looks at many bytes at a time),
+     * the same ones and in the same order as a look at every byte would find them: no start code
+     * ends before the first 1 from p + 2 on. */
     const uint8_t *unit = NULL;
     for (const uint8_t *p = data; p + 3 <= end;) {
-        if (p[0] || p[1] || p[2] != 1) {
+        const uint8_t *one = memchr(p + 2, 1, (size_t)(end - (p + 2)));
+        if (!one)
+            break;
+        p = one - 2;
+        if (p[0] || p[1]) {
             ++p;
             continue;
         }
-- 
