+/*!
+ * \brief The highest rank that an output other than the one in use can have
+ * \param inUse the output that Kodi shows itself on
+ * \param asked the output that the settings name now
+ *
+ * The rank of the one named in the settings, when that is another output than the one in use;
+ * else that of an HDMI output whose display takes Dolby Vision Standard. Where the output in use
+ * ranks that high already, no display that is connected later can be a reason to move, and
+ * nothing has to be looked at to know it.
+ */
+inline int BestRankOfAnother(const DRMOutput& inUse, const std::string& asked)
+{
+  if (asked.empty() || asked == "Default" || IsAskedOutput(inUse, asked))
+    return OUTPUT_RANK_HDMI_DOLBY_VISION;
+  return OUTPUT_RANK_ASKED;
+}
+
+/*!
+ * \brief A display that was connected since the outputs were last looked at, and that Kodi
+ * would show itself on rather than where it is
+ * \param before the outputs of each device as they were, and \param now as they are: the same
+ * devices in the same order (with another number of devices there is nothing to compare, and
+ * nothing is told)
+ * \param inUse the output that Kodi shows itself on; one without a name when it shows itself
+ * on none
+ * \param asked the output that the settings name now
+ * \param declined the outputs (QualifiedOutputName()) for which the user said to stay
+ * \return the output, as it will be once Kodi has started again (see WouldChooseAnother());
+ * one without a name when there is none
+ *
+ * Only a display that was not there before, and only on an output that ranks above the one in
+ * use. A display that was there when Kodi started and was not chosen is never a reason to move;
+ * nor is one of the same rank as the output in use, whichever of the two comes first in the
+ * order of the devices; nor is what happens to the output in use itself. So a start of Kodi that
+ * follows this cannot lead back here: by then the display is one that was there at the start.
+ */
+inline DRMOutput BetterNewOutput(const std::vector<std::vector<DRMOutput>>& before,
+                                 const std::vector<std::vector<DRMOutput>>& now,
+                                 const DRMOutput& inUse,
+                                 const std::string& asked,
+                                 const std::vector<std::string>& declined)
+{
+  DRMOutput best;
+  if (before.size() != now.size())
+    return best;
+
+  int bestRank = OUTPUT_RANK_NONE;
+  if (!inUse.name.empty())
+  {
+    // (it is the output in use, whatever it reports of itself)
+    DRMOutput used = inUse;
+    used.usable = true;
+    bestRank = RankOutput(used, asked);
+  }
+
+  for (std::size_t i = 0; i < now.size(); ++i)
+  {
+    for (DRMOutput output : now[i])
+    {
+      if (!output.connected)
+        continue;
+
+      if (!inUse.name.empty() && QualifiedOutputName(output) == QualifiedOutputName(inUse))
+        continue;
+
+      if (std::ranges::any_of(before[i], [&output](const DRMOutput& old)
+                              { return old.connected && old.name == output.name; }))
+        continue;
+
+      if (std::ranges::find(declined, QualifiedOutputName(output)) != declined.end())
+        continue;
+
+      output.usable = true;
+      const int rank = RankOutput(output, asked);
+      if (rank > bestRank)
+      {
+        bestRank = rank;
+        best = output;
+      }
+    }
+  }
+  return best;
+}
+
+/*!
+ * \brief The outputs for a TV or a monitor that have nothing connected, when none of them has
+ * \return their names, each with its device where two of them have the same name; empty when
+ * a display is connected to one of them, or when there is no such output
+ *
+ * For a machine that shows Kodi on its own panel: whether that is because nothing else is seen.
+ * The panel of the machine itself, a head-mounted display and outputs that are not sockets
+ * (writeback, virtual) are not outputs for a TV.
+ */
+inline std::vector<std::string> EmptyDisplayOutputs(
+    const std::vector<std::vector<DRMOutput>>& devices)
+{
+  const auto forDisplay = [](const DRMOutput& output)
+  {
+    return !output.nonDesktop &&
+           (output.type == "HDMI-A" || output.type == "HDMI-B" || output.type == "DP" ||
+            output.type == "DVI-I" || output.type == "DVI-D" || output.type == "DVI-A" ||
+            output.type == "VGA");
+  };
+
+  std::vector<std::string> names;
+  for (std::size_t i = 0; i < devices.size(); ++i)
+  {
+    for (const DRMOutput& output : devices[i])
+    {
+      if (!forDisplay(output))
+        continue;
+      if (output.connected)
+        return {};
+
+      bool shared = false;
+      for (std::size_t j = 0; j < devices.size() && !shared; ++j)
+      {
+        if (j == i)
+          continue;
+        for (const DRMOutput& other : devices[j])
+          shared = shared || (forDisplay(other) && other.name == output.name);
+      }
+      names.emplace_back(shared ? QualifiedOutputName(output) : output.name);
+    }
+  }
+  return names;
+}
