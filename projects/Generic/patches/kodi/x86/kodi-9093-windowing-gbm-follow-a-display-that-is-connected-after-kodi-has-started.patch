+{
+namespace GBM
+{
+
+/*!
+ * \brief Follows the displays that are connected after Kodi has started
+ *
+ * Kodi chooses its output when it starts (CDRMUtils::OpenDrm()) and stays on it. A TV that is
+ * plugged in or turned on later was not there to be chosen: Kodi stayed on the panel of the
+ * laptop, or on no display at all, until it was started again by hand.
+ *
+ * This listens for the hot-plug events of the graphics devices (udev) and, after one, looks at
+ * the outputs of all of them the way the start does. When a display has appeared that the start
+ * would have chosen over the output in use (DRMOutputChoice.h: only a display that was not there
+ * before, and only one that ranks higher), the user is asked, with a dialog that closes by
+ * itself, and Kodi is started again, which is how it takes another output. Where Kodi shows
+ * itself on no output there is nobody to ask, and it is started again at once.
+ *
+ * It also tells, once, when Kodi is on the panel of the machine itself because nothing is seen
+ * on any output for a TV: the first thing to know when the TV stays dark.
+ *
+ * Nothing is looked at while a video plays (an output that is asked reads its display again,
+ * which its driver may hold a frame up for), nor where no other output could rank above the
+ * one in use (a TV that takes Dolby Vision, or the output named in the settings).
+ *
+ * What only the thread that draws may ask of Kodi (whether the interface is up, whether a
+ * video plays, what the settings name) is asked of it: this sets a flag, and the thread that
+ * draws answers with its next frame (CWinSystemGbm::FollowDisplays()).
+ */
+class CDRMDisplayWatch : private CThread
+{
+public:
+  /*!
+   * \param inUse the output that Kodi shows itself on; one without a name when it shows itself
+   * on none
+   * \param asked the output that the settings name
+   * \param atStart the outputs of every graphics device as they were when the output was
+   * chosen; empty when that is not known (they are looked at then)
+   */
+  CDRMDisplayWatch(DRMOutput inUse,
+                   std::string asked,
+                   std::vector<std::vector<DRMOutput>> atStart);
+  ~CDRMDisplayWatch() override;
+
+  //! \name For the thread that draws, with every frame
+  //!@{
+  //! Whether there is something to tell the user (TakeNotice())
+  bool NoticeDue() const { return m_noticeDue.load(std::memory_order_relaxed); }
+  //! The outputs for a TV that have nothing connected, Kodi being on the panel of the machine:
+  //! given once
+  std::vector<std::string> TakeNotice();
+  //! Whether an answer is waited for (Tell())
+  bool Asking() const { return m_asking.load(std::memory_order_relaxed); }
+  void Tell(bool interfaceUp, bool playingVideo, const std::string& asked);
+  //!@}
+
+private:
+  struct Answer
+  {
+    bool interfaceUp{false};
+    bool playingVideo{false};
+    std::string asked;
+  };
+
+  void Process() override;
+  //! Waits for the next frame to answer; nothing when none is drawn in a while
+  std::optional<Answer> Ask();
+  //! Whether an output other than the one in use could rank above it
+  bool CanDoBetter(const std::string& asked) const;
+  void NoticeNoDisplay();
+  enum class Asked
+  {
+    MOVE, //!< Kodi is to be started again to show itself on that output
+    STAY,
+    NOT_SHOWN, //!< the question could not be put
+  };
+  struct Question;
+  //! Has the user asked whether Kodi is to move to that output: a question that is left
+  //! unanswered for a while answers itself, to move
+  Asked AskToMove(const DRMOutput& output);
+
+  const DRMOutput m_inUse;
+  const std::string m_asked;
+  std::vector<std::vector<DRMOutput>> m_seen;
+  std::vector<std::string> m_declined;
+
+  CCriticalSection m_section; //!< m_notice and m_answer
+  std::vector<std::string> m_notice;
+  std::atomic<bool> m_noticeDue{false};
+  Answer m_answer;
+  std::atomic<bool> m_asking{false};
+  CEvent m_answered;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
