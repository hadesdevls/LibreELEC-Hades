+void CWinSystemGbm::FollowDisplays()
+{
+  if (!m_displayWatch)
+    return;
+
+  const bool notice = m_displayWatch->NoticeDue();
+  if (!notice && !m_displayWatch->Asking())
+    return;
+
+  // (nothing is told before the skin and its language files are loaded)
+  const auto gui = CServiceBroker::GetGUI();
+  const bool interfaceUp = gui && gui->GetSkinInfo();
+
+  if (notice && interfaceUp)
+  {
+    const std::vector<std::string> outputs = m_displayWatch->TakeNotice();
+    if (!outputs.empty())
+    {
+      std::string text = CGUIUtils::GetHadesString(39981, 31708);
+      StringUtils::Replace(text, "{0}", StringUtils::Join(outputs, ", "));
+      CGUIDialogKaiToast::QueueNotification(
+          CGUIDialogKaiToast::Info,
+          CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246), text, 15000);
+    }
+  }
+
+  if (!m_displayWatch->Asking())
+    return;
+
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const bool playingVideo = player && player->IsPlayingVideo();
+
+  std::string asked = "Default";
+  const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+  if (settingsComponent && settingsComponent->GetSettings())
+    asked = settingsComponent->GetSettings()->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR);
+
+  m_displayWatch->Tell(interfaceUp, playingVideo, asked);
+}
