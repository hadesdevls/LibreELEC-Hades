+std::vector<std::vector<DRMOutput>> CDRMUtils::LookAtOutputs()
+{
+  const int numDevices = drmGetDevices2(0, nullptr, 0);
+  if (numDevices <= 0)
+    return {};
+
+  std::vector<drmDevicePtr> devices(numDevices);
+  const int filled = drmGetDevices2(0, devices.data(), devices.size());
+  if (filled <= 0)
+    return {};
+  devices.resize(filled);
+
+  std::vector<SurveyedDevice> found = DevicesToLookAt(devices);
+  LookAtAll(found, m_atomicAsked, true);
+  std::vector<std::vector<DRMOutput>> outputs = FitOutputs(found);
+
+  drmFreeDevices(devices.data(), devices.size());
+  return outputs;
+}
