+namespace
+{
+// A display that is plugged in or turned on is announced several times while its driver reads
+// it: the outputs are looked at once it has been quiet for this long.
+constexpr auto SETTLE_TIME = 3s;
+// After a video the output may still be set up again (the end of Dolby Vision turns it off and
+// on): the outputs are not asked before this long after one was seen to play.
+constexpr auto AFTER_VIDEO_TIME = 10s;
+// When nothing can be asked now (no frame is drawn, the interface is not up yet)
+constexpr auto RETRY_TIME = 2s;
+// How long the user has to say that Kodi is to stay where it is
+constexpr unsigned int ASK_SECONDS = 20;
+// An answer to move that comes sooner than this was not given by a person
+constexpr auto TOO_SOON_TIME = 700ms;
+// How often the question is tried again when it could not be shown
+constexpr int ASK_TRIES = 3;
+} // namespace
+
+CDRMDisplayWatch::CDRMDisplayWatch(DRMOutput inUse,
+                                   std::string asked,
+                                   std::vector<std::vector<DRMOutput>> atStart)
+  : CThread("DRMDisplayWatch"),
+    m_inUse(std::move(inUse)),
+    m_asked(std::move(asked)),
+    m_seen(std::move(atStart))
+{
+  Create();
+}
+
+CDRMDisplayWatch::~CDRMDisplayWatch()
+{
+  StopThread(true);
+}
+
+std::vector<std::string> CDRMDisplayWatch::TakeNotice()
+{
+  std::unique_lock lock(m_section);
+  m_noticeDue.store(false);
+  return std::exchange(m_notice, {});
+}
+
+void CDRMDisplayWatch::Tell(bool interfaceUp, bool playingVideo, const std::string& asked)
+{
+  {
+    std::unique_lock lock(m_section);
+    m_answer = {interfaceUp, playingVideo, asked};
+  }
+  m_asking.store(false);
+  m_answered.Set();
+}
+
+std::optional<CDRMDisplayWatch::Answer> CDRMDisplayWatch::Ask()
+{
+  m_answered.Reset();
+  m_asking.store(true);
+  const WaitResponse response = AbortableWait(m_answered, 5000ms);
+  m_asking.store(false);
+  if (response != WAIT_SIGNALED)
+    return std::nullopt;
+
+  std::unique_lock lock(m_section);
+  return m_answer;
+}
+
+bool CDRMDisplayWatch::CanDoBetter(const std::string& asked) const
+{
+  if (m_inUse.name.empty())
+    return true;
+
+  // (it is the output in use, whatever it reports of itself)
+  DRMOutput used = m_inUse;
+  used.usable = true;
+  return RankOutput(used, asked) < BestRankOfAnother(m_inUse, asked);
+}
+
+void CDRMDisplayWatch::NoticeNoDisplay()
+{
+  if (m_inUse.name.empty())
+    return;
+
+  DRMOutput used = m_inUse;
+  used.usable = true;
+  if (RankOutput(used, m_asked) != OUTPUT_RANK_OWN_PANEL)
+    return;
+
+  std::vector<std::string> empty = EmptyDisplayOutputs(m_seen);
+  if (empty.empty())
+    return;
+
+  CLog::LogF(LOGINFO,
+             "Kodi is on {}, the panel of this machine: nothing is seen on {}; the user is told",
+             m_inUse.name, StringUtils::Join(empty, ", "));
+
+  std::unique_lock lock(m_section);
+  m_notice = std::move(empty);
+  m_noticeDue.store(true);
+}
+
+// The question, put by the application thread (it is a dialog of Kodi, and whoever waits for one
+// from another thread cannot be stopped until it closes: a Kodi that is told to stop while the
+// question is open would wait for this thread, and this thread for Kodi). The watch posts it and
+// looks now and then for the answer; neither waits for the other. It keeps itself until it has
+// been put, so that it is there whatever has become of the watch by then; one that is still in
+// the queue when Kodi stops is never put, and stays behind.
+struct CDRMDisplayWatch::Question
+{
+  enum : int
+  {
+    WAITING,
+    MOVE,
+    STAY,
+    NOT_SHOWN,
+  };
+
+  std::string output;
+  std::atomic<int> answer{WAITING};
+  KODI::MESSAGING::ThreadMessageCallback message{};
+  std::shared_ptr<Question> self;
+
+  static void Put(void* data)
+  {
+    using namespace KODI::MESSAGING::HELPERS;
+
+    const std::shared_ptr<Question> question = std::move(static_cast<Question*>(data)->self);
+    if (!question)
+      return;
+
+    std::string text = CGUIUtils::GetHadesString(39984, 31705);
+    StringUtils::Replace(text, "{0}", question->output);
+    StringUtils::Replace(text, "{1}", std::to_string(ASK_SECONDS));
+
+    // Staying is the button that says yes. A dialog that closes by itself, its time run out,
+    // has had neither button pressed and is not cancelled either: that is the answer of the
+    // other button, and Kodi moves. The other button is also the one that has the focus.
+    const auto start = std::chrono::steady_clock::now();
+    const DialogResponse response = ShowYesNoDialogText(
+        CVariant{CGUIUtils::GetHadesString(39985, 31704)}, CVariant{text},
+        CVariant{CGUIUtils::GetHadesString(39983, 31706)},
+        CVariant{CGUIUtils::GetHadesString(39982, 31707)}, ASK_SECONDS * 1000);
+
+    // (from here on Kodi may have been stopped, from within the dialog: nothing of it is used)
+    if (response != DialogResponse::CHOICE_NO)
+      question->answer.store(STAY);
+    // An answer that came at once was not given by anyone: the dialog could not be shown (it
+    // is one dialog for all of Kodi, and another question may have been open in it).
+    else if (std::chrono::steady_clock::now() - start < TOO_SOON_TIME)
+      question->answer.store(NOT_SHOWN);
+    else
+      question->answer.store(MOVE);
+  }
+};
+
+CDRMDisplayWatch::Asked CDRMDisplayWatch::AskToMove(const DRMOutput& output)
+{
+  const auto question = std::make_shared<Question>();
+  question->output = output.name;
+  question->message.callback = &Question::Put;
+  question->message.userptr = question.get();
+  question->self = question;
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_CALLBACK, -1, -1, &question->message);
+
+  // The time of the question, and as much again for the application thread to get to it
+  const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(2 * ASK_SECONDS);
+  while (!m_bStop && std::chrono::steady_clock::now() < until)
+  {
+    switch (question->answer.load())
+    {
+      case Question::MOVE:
+        return Asked::MOVE;
+      case Question::STAY:
+        return Asked::STAY;
+      case Question::NOT_SHOWN:
+        return Asked::NOT_SHOWN;
+      default:
+        break;
+    }
+    CThread::Sleep(200ms);
+  }
+
+  // (stopped, or the question was never put or never closed: nothing moves without an answer)
+  return Asked::STAY;
+}
+
+void CDRMDisplayWatch::Process()
+{
+  struct udev* udev = udev_new();
+  struct udev_monitor* monitor = udev ? udev_monitor_new_from_netlink(udev, "udev") : nullptr;
+  if (!monitor ||
+      udev_monitor_filter_add_match_subsystem_devtype(monitor, "drm", "drm_minor") < 0 ||
+      udev_monitor_enable_receiving(monitor) < 0)
+  {
+    CLog::LogF(LOGWARNING, "the graphics devices cannot be listened to: a display that is "
+                           "connected from now on is not followed");
+    if (monitor)
+      udev_monitor_unref(monitor);
+    if (udev)
+      udev_unref(udev);
+    return;
+  }
+
+  // What a later look is compared with: the outputs as they were when Kodi chose its own.
+  // Where that is not known (Kodi shows itself on no output), as they are now.
+  if (m_seen.empty() && CanDoBetter(m_asked))
+    m_seen = CDRMUtils::LookAtOutputs();
+
+  NoticeNoDisplay();
+
+  const int fd = udev_monitor_get_fd(monitor);
+  bool pending = false;
+  auto notBefore = std::chrono::steady_clock::now();
+
+  while (!m_bStop)
+  {
+    struct pollfd wait = {fd, POLLIN, 0};
+    const int ready = poll(&wait, 1, 500);
+    if (m_bStop)
+      break;
+
+    if (ready < 0 && errno != EINTR)
+    {
+      CLog::LogF(LOGWARNING, "{}: a display that is connected from now on is not followed",
+                 strerror(errno));
+      break;
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    if (ready > 0)
+    {
+      if (!(wait.revents & POLLIN))
+      {
+        CLog::LogF(LOGWARNING, "the graphics devices are not heard any more: a display that is "
+                               "connected from now on is not followed");
+        break;
+      }
+
+      // (the socket does not block: this ends when nothing more is queued)
+      while (struct udev_device* device = udev_monitor_receive_device(monitor))
+      {
+        const char* hotplug = udev_device_get_property_value(device, "HOTPLUG");
+        if (hotplug && strcmp(hotplug, "1") == 0)
+        {
+          pending = true;
+          notBefore = std::max(notBefore, now + SETTLE_TIME);
+        }
+        udev_device_unref(device);
+      }
+    }
+
+    if (!pending || now < notBefore)
+      continue;
+
+    const std::optional<Answer> answer = Ask();
+    if (m_bStop)
+      break;
+
+    if (!answer || !answer->interfaceUp)
+    {
+      notBefore = std::chrono::steady_clock::now() + RETRY_TIME;
+      continue;
+    }
+
+    if (answer->playingVideo)
+    {
+      notBefore = std::chrono::steady_clock::now() + AFTER_VIDEO_TIME;
+      continue;
+    }
+
+    pending = false;
+
+    if (!CanDoBetter(answer->asked))
+      continue;
+
+    std::vector<std::vector<DRMOutput>> found = CDRMUtils::LookAtOutputs();
+    const DRMOutput better = BetterNewOutput(m_seen, found, m_inUse, answer->asked, m_declined);
+    m_seen = std::move(found);
+    if (better.name.empty() || m_bStop)
+      continue;
+
+    const std::string name = QualifiedOutputName(better);
+    if (m_inUse.name.empty())
+    {
+      CLog::LogF(LOGINFO,
+                 "a display was connected to {} and Kodi shows itself on no output: Kodi is "
+                 "started again",
+                 name);
+      CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+      break;
+    }
+
+    CLog::LogF(LOGINFO,
+               "a display was connected to {}, which Kodi would use rather than {}: the user is "
+               "asked",
+               name, m_inUse.name);
+
+    Asked asked = Asked::NOT_SHOWN;
+    for (int i = 0; i < ASK_TRIES && asked == Asked::NOT_SHOWN && !m_bStop; ++i)
+    {
+      if (i > 0)
+        CThread::Sleep(RETRY_TIME);
+      if (!m_bStop)
+        asked = AskToMove(better);
+    }
+    if (m_bStop)
+      break;
+
+    if (asked == Asked::MOVE)
+    {
+      CLog::LogF(LOGINFO, "Kodi is started again to show itself on {}", name);
+      CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+      break;
+    }
+
+    if (asked == Asked::NOT_SHOWN)
+    {
+      // (it is among the outputs that were seen now: asked again only if it is connected anew)
+      CLog::LogF(LOGINFO, "the question could not be shown: Kodi stays on {}", m_inUse.name);
+      continue;
+    }
+
+    CLog::LogF(LOGINFO, "Kodi stays on {}: {} is not offered again until Kodi is started again",
+               m_inUse.name, name);
+    m_declined.emplace_back(name);
+  }
+
+  udev_monitor_unref(monitor);
+  udev_unref(udev);
+}
