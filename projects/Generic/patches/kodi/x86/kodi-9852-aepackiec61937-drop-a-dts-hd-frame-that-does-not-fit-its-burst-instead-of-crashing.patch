From ddb5790ce74882377c4584da9feb34343c5964d9 Mon Sep 17 00:00:00 2001
From: tanio99 <tanio99@wolke7.net>
Date: Wed, 28 Oct 2026 18:11:12 +0100
Subject: [PATCH] AEPackIEC61937: drop a DTS-HD frame that does not fit its
 burst instead of crashing

PackDTSHD() pads the burst with memset(..., burstsize - IEC61937_DATA_OFFSET - size). When the
frame is larger than the burst, that length is negative and, as an unsigned int, about 4 GB:
Kodi segfaults. It happens when a DTS-HD MA stream (8320-byte frames at peak bit rate) is
mistaken for HRA and packed with a 2048 period, i.e. an 8192-byte burst.

A period of 16384 overflowed as well, whatever the frame size: its 65536-byte burst does not fit
the MAX_IEC61937_PACKET (61440) destination buffer.

Check both before writing anything and drop the burst with an error log instead. The sink writes
nothing for a zero-sized burst, which is what an unsupported period already did. This is the
safety net; the misdetection itself is fixed in the stream parser.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

(Backported from xbmc/xbmc pull request 30440, commit 2ecd4a0763f4; the test list in
Utils/test/CMakeLists.txt is the one of this tree.)
---
 .../AudioEngine/Utils/AEPackIEC61937.cpp      | 14 ++++-
 .../AudioEngine/Utils/test/CMakeLists.txt     |  1 +
 .../Utils/test/TestAEPackIEC61937.cpp         | 52 +++++++++++++++++++
 3 files changed, 66 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp

diff --git a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
index 43bfbf3..62f0f8b 100644
--- a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
@@ -8,6 +8,8 @@
 
 #include "AEPackIEC61937.h"
 
+#include "utils/log.h"
+
 #include <cassert>
 #include <string.h>
 
@@ -128,6 +130,17 @@ int CAEPackIEC61937::PackDTSHD(uint8_t *data, unsigned int size, uint8_t *dest,
       return 0;
   }
 
+  /* The payload must fit the burst, and the burst the destination buffer. Otherwise the padding
+   * memset below gets a negative length, i.e. about 4 GB. Drop the burst instead. */
+  unsigned int burstsize = period << 2;
+  if (burstsize > MAX_IEC61937_PACKET || size + (size & 0x1) > burstsize - IEC61937_DATA_OFFSET)
+  {
+    CLog::Log(LOGERROR,
+              "CAEPackIEC61937::PackDTSHD - {} byte frame does not fit a period {} burst, dropped",
+              size, period);
+    return 0;
+  }
+
   struct IEC61937Packet *packet = (struct IEC61937Packet*)dest;
   packet->m_preamble1 = IEC61937_PREAMBLE1;
   packet->m_preamble2 = IEC61937_PREAMBLE2;
@@ -147,7 +160,6 @@ int CAEPackIEC61937::PackDTSHD(uint8_t *data, unsigned int size, uint8_t *dest,
   SwapEndian((uint16_t*)packet->m_data, (uint16_t*)data, size >> 1);
 #endif
 
-  unsigned int burstsize = period << 2;
   memset(packet->m_data + size, 0, burstsize - IEC61937_DATA_OFFSET - size);
   return burstsize;
 }
diff --git a/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt b/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
index e42b5be..f2e9339 100644
--- a/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
+++ b/xbmc/cores/AudioEngine/Utils/test/CMakeLists.txt
@@ -1,4 +1,5 @@
 set(SOURCES TestAEBitstreamPacker.cpp
+            TestAEPackIEC61937.cpp
             TestAEPcmChannels.cpp
             TestAEStreamParser.cpp
             TestGpuClockHold.cpp)
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
new file mode 100644
index 0000000..1522f2e
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPackIEC61937.cpp
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "cores/AudioEngine/Utils/AEPackIEC61937.h"
+
+#include <cstdint>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+namespace
+{
+// The packer pads to the burst size, so give it room past MAX_IEC61937_PACKET to see an overrun.
+constexpr unsigned int GUARD = 8192;
+constexpr uint8_t CANARY = 0xA5;
+} // namespace
+
+TEST(TestAEPackIEC61937, ADtsHdFrameThatFitsItsBurstIsPacked)
+{
+  std::vector<uint8_t> frame(8000, 0x11);
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  EXPECT_EQ(8192, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 2048));
+}
+
+//! A DTS-HD MA frame at peak bit rate taken for HRA: 8320 bytes into an 8192-byte burst. The
+//! padding length went negative and memset ran for about 4 GB.
+TEST(TestAEPackIEC61937, ADtsHdFrameLargerThanItsBurstIsDropped)
+{
+  std::vector<uint8_t> frame(8320, 0x11);
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  EXPECT_EQ(0, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 2048));
+  for (unsigned int i = 0; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written";
+}
+
+//! A period of 16384 is a 65536-byte burst, larger than the MAX_IEC61937_PACKET destination.
+TEST(TestAEPackIEC61937, ABurstLargerThanTheDestinationBufferIsDropped)
+{
+  std::vector<uint8_t> frame(1000, 0x11);
+  std::vector<uint8_t> dest(MAX_IEC61937_PACKET + GUARD, CANARY);
+
+  EXPECT_EQ(0, CAEPackIEC61937::PackDTSHD(frame.data(), frame.size(), dest.data(), 16384));
+  for (unsigned int i = MAX_IEC61937_PACKET; i < dest.size(); ++i)
+    ASSERT_EQ(CANARY, dest[i]) << "byte " << i << " written past the destination buffer";
+}
