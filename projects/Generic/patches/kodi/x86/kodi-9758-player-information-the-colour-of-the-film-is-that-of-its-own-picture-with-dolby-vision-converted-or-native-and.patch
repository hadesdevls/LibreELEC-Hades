+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -9774,6 +9774,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.sum.abadge", ""},
       {"hades.audio.spk", ""},
       {"hades.video.color", ""},
+      {"hades.video.colorkind", ""},
       {"hades.video.matrix", ""},
       {"hades.src.mastering", ""},
       {"hades.src.cll", ""},
@@ -10117,8 +10118,14 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     info["hades.play.dropped"] = std::to_string(cache.GetVideoDropped());
     info["hades.play.skipped"] = std::to_string(cache.GetVideoSkipped());
     const SourceColour source = GetSourceColour();
-    info["hades.video.color"] = source.colour;
-    info["hades.video.matrix"] = source.matrix;
+    // (Hades: of a Dolby Vision stream whose base layer is no picture by itself, the IPT-PQ-c2 its
+    // pictures are coded in: FilmColourOf(), from its configuration record)
+    const FilmColour film =
+        FilmColourOf(source.colour, source.matrix,
+                     DVBRIDGE::BaseLayerIsNoPicture(g_dvStreamProfile, g_dvStreamCompatibility));
+    info["hades.video.color"] = film.colour;
+    info["hades.video.colorkind"] = film.kind;
+    info["hades.video.matrix"] = film.matrix;
     info["hades.src.mastering"] = source.mastering;
     info["hades.src.cll"] = source.cll;
     info["hades.out.ratefit"] = FitRate(modeHz, cache.GetVideoFps());
