+/*!
+ * \brief The colour of the film, as the player information says it (hades.video.color and
+ *        hades.video.matrix, and hades.video.colorkind for the skin's own words)
+ *
+ * What the video says of itself (ColourText(), MatrixText(): CWinSystemGbm::SourceColour, of the
+ * picture of the video, also where it is converted for the output). A Dolby Vision stream whose
+ * base layer is no picture by itself (profile 5, and 10.0: DVBRIDGE::BaseLayerIsNoPicture()) is
+ * coded in IPT-PQ-c2, which the tags of its pictures do not say (they say nothing, and Kodi takes
+ * primaries by the size of the picture): it is named so, with no matrix, which IPT-PQ-c2 has of its
+ * own. Nothing while no colour is known (no video plays).
+ */
+struct FilmColour
+{
+  std::string colour; //!< hades.video.color
+  std::string matrix; //!< hades.video.matrix
+  std::string kind; //!< hades.video.colorkind: "iptpqc2", or empty
+};
+
+inline FilmColour FilmColourOf(const std::string& colour,
+                               const std::string& matrix,
+                               bool baseIsNoPicture)
+{
+  if (baseIsNoPicture && !colour.empty())
+    return {"IPT-PQ-c2 (Dolby Vision)", "", "iptpqc2"};
+  return {colour, matrix, ""};
+}
+
 /*!
  * \brief The name of the primaries that CIE xy coordinates are (red, green, blue), where they are
  *        those of BT.709, P3-D65 or BT.2020 within 0.003; "custom" for others
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 758abd5..910d308 100644
