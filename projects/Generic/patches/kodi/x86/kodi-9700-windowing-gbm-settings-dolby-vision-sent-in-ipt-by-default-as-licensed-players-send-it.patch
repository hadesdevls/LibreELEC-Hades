+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -514,6 +514,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   UseCm40DefaultSetting();
   // Hades: the transport that UseSourceTransport() asked for, also for a renderer made after it
   dvbridge_render_use_source_transport(m_renderer, m_sourceWanted);
+  dvbridge_render_use_ipt(m_renderer, m_iptWanted);
   // ... and Low-Latency (SetLowLatency())
   if (!dvbridge_render_set_low_latency(m_renderer, m_lowLatencyOn ? &m_lowLatency : nullptr))
     m_lowLatencyOn = false;
@@ -682,6 +683,7 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
                                 : m_sourceWanted  ? 2
                                                   : 1;
     m_pendingDetail.signalColorSpace = av_dovi_get_color(parsed)->signal_color_space;
+    m_pendingDetail.ipt = sourceTransport && dvbridge_render_ipt(m_renderer);
     if (!sourceTransport && m_sourceWanted && why && why != m_sourceWhyLogged)
     {
       CLog::Log(LOGINFO,
@@ -782,6 +784,9 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
                 m_pendingDetail.transport == 3
                     ? "as Dolby Vision Low-Latency (mapped to the display, YCbCr 4:2:2 at 12 bits, "
                       "no metadata)"
+                : m_pendingDetail.transport == 0 && m_pendingDetail.ipt
+                    ? "in IPT-PQ-c2, as licensed players send it (the composer's picture "
+                      "converted)"
