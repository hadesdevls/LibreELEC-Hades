+#pragma once
+
+#include "DVStepDown.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief The level of the conversion of the pixels drawn over a profile 5 picture in frames with
+ *        GUI elements (dvbridge_render_gui_level()), raised only where those frames do not keep up
+ *
+ * Converting a pixel drawn over a picture of profile 5 back to codes takes PQ round trips that the
+ * affine profiles do not, and on a small GPU the frames with GUI elements over most of the picture
+ * (the player information, a window over the dimmed video) can take more than a refresh while the
+ * others fit. Level 0, the conversion as it was, is that of every frame unless the frames with GUI
+ * elements of its format are measured not to keep up; then level 1, the same bytes with the
+ * picture under each pixel taken from pass 3 (and a target of 132.7 MB); and, only where level 1
+ * is measured not to keep up either, level 2, the simplified rounding (a code apart in values
+ * close to a half, under what is drawn over only).
+ *
+ * The frames measured are those with GUI elements whose picture the bridge can draw above level 0
+ * (profile 5 in the source transport, the programs of a level made: top), while the video plays.
+ * Each picture format (CDVFrameLoad) at each fidelity step-down level (CDVStepDown: the frames of
+ * another level are other work) and refresh period has a state of its own, at level 0 until its
+ * frames are found not to keep up. Its frames are measured in windows of WINDOW frames of one
+ * level drawn and one pace, leaving out the first seconds of a video and after a seek (SETTLE_MS),
+ * the first second after GUI elements come (GUI_SETTLE_MS: the GUI that appears is drawn and faded
+ * in meanwhile, and the GPU times of CDVAhead are set aside then too), the first frames after a
+ * change of level or of pace (SKIP), and the frames drawn at another level than the format's
+ * (frames in flight, or a level that the bridge could not draw). A window is behind as a window of
+ * CDVStepDown is: both its GPU times and its missed refreshes say so (frames presented a frame
+ * ahead that take more than LOADED_AHEAD of the period on average without the slowest, and
+ * LOST_PART of the presentations, LOST_MIN at least, late; frames that wait, LOST_PART of them over
+ * LOADED_WAITING of the period and as many presentations late); two windows in a row, or one in
+ * which the GPU could not keep up in any case, raise the level by one, up to top. While frames are
+ * still to be presented a frame ahead (CDVStepDown::Pace::PENDING), that comes first: nothing goes
+ * up.
+ *
+ * Raised: the first window at the new level says what it takes for what the level below took (the
+ * window that raised it). Down again by one only when the level below would take, by that, no more
+ * than RELEASE_AHEAD or RELEASE_WAITING of the period (room to spare below the marks), and only
+ * RELEASE_WAIT measured frames after the level was reached; where a level has to be raised to
+ * again after coming down from it, before the level below kept up for as long, its wait doubles.
+ * Nothing comes down on a guess.
+ *
+ * This class only decides. The window system asks it for each frame with GUI elements, tells it
+ * their GPU times and presentations, logs what changes and frees the targets of the levels when
+ * no format is above level 0 (Above()).
+ */
+class CDVGuiLevel
+{
+public:
+  using Pace = CDVStepDown::Pace;
+  static constexpr unsigned int WINDOW = CDVStepDown::WINDOW;
+  static constexpr int LEVELS = 3;
+
+  enum class Change
+  {
+    NONE,
+    UP, //!< the frames did not keep up at the level below: this one from now on
+    DOWN, //!< the level below would fit with room to spare: back to it
+  };
+
+  struct Step
+  {
+    Change change = Change::NONE;
+    int from = 0;
+    int to = 0;
+    Pace pace = Pace::PENDING;
+    double averageMs = 0; //!< the window's GPU time, without its slowest frame
+    double budgetMs = 0; //!< the mark of a frame at that pace and refresh period
+    double periodMs = 0;
+    unsigned int frames = 0;
+    unsigned int over = 0;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+    double estimateMs = 0; //!< DOWN: what the level below would take now
+  };
+
+  //! A frame with GUI elements of that format is to be drawn: at which level (0 where not known)
+  int Level(uint64_t format, int step, double periodMs) const
+  {
+    const Format* const f = Lookup(format, step, periodMs);
+    return f ? f->level : 0;
+  }
+
+  //! The GPU time of a frame with GUI elements whose picture the bridge can draw above level 0, up
+  //! to top, drawn at the level drawn, while the video played, presented at that pace
+  Step Measured(uint64_t format, int step, int drawn, int top, double ms, double periodMs, Pace pace)
+  {
+    if (format == 0 || !(ms > 0) || !std::isfinite(ms) || !(periodMs > 0) || !std::isfinite(periodMs))
+      return Step();
+    Format& f = *Find(format, step, periodMs);
+    // a frame drawn at another level than the format's (before a change, or one that the bridge
+    // could not draw): not taken
+    if (drawn != f.level)
+      return Step();
+    Window& w = f.window;
+    if (w.count > 0 && w.pace != pace)
+    {
+      f.Drop();
+      f.skip = std::max(f.skip, SKIP);
+    }
+    const bool settling = m_settlingMs > 0 || m_guiSettlingMs > 0 || f.skip > 0;
+    if (m_settlingMs > 0)
+      m_settlingMs -= periodMs;
+    if (m_guiSettlingMs > 0)
+      m_guiSettlingMs -= periodMs;
+    if (f.skip > 0)
+      --f.skip;
+    if (settling)
+      return Step();
+    if (w.count == 0)
+    {
+      w = Window();
+      w.pace = pace;
+    }
+    w.sum += ms;
+    w.max = std::max(w.max, ms);
+    w.over += ms > LOADED_WAITING * periodMs ? 1 : 0;
+    if (++w.count < WINDOW)
+      return Step();
+    return Decide(f, std::clamp(top, 0, LEVELS - 1));
+  }
+
+  //! A frame with GUI elements whose picture the bridge can draw above level 0 was presented, at
+  //! that pace, and whether it came with its refresh is known
+  void Presented(uint64_t format, int step, int drawn, bool late, Pace pace, double periodMs)
+  {
+    Format* const f = Lookup(format, step, periodMs);
+    if (!f || drawn != f->level || f->window.count == 0 || f->window.pace != pace)
+      return;
+    ++f->window.presented;
+    f->window.lost += late ? 1 : 0;
+  }
+
+  //! A frame without GUI elements was drawn while the video played: the first ones with GUI
+  //! elements that come after it are left out
+  void Plain()
+  {
+    m_guiSettlingMs = GUI_SETTLE_MS;
+    for (Format& f : m_formats)
+      f.Drop();
+  }
+
+  //! The video jumped (a seek, a change of stream): the frames around it say nothing
+  void Seeked()
+  {
+    for (Format& f : m_formats)
+      f.Drop();
+    m_settlingMs = SETTLE_MS;
+  }
+
+  //! Native output ended: what is found stays, the windows begin again with the next video
+  void Restart() { Seeked(); }
+
+  //! Whether a format is above level 0 (the targets of the levels are needed)
+  bool Above() const
+  {
+    return std::any_of(m_formats.begin(), m_formats.end(),
+                       [](const Format& f) { return f.id != 0 && f.level > 0; });
+  }
+
+private:
+  static constexpr unsigned int SKIP = 6; //!< frames left out after a change
+  static constexpr double SETTLE_MS = 2000; //!< the start of a video, and after a seek
+  static constexpr double GUI_SETTLE_MS = 1000; //!< after GUI elements come
+  static constexpr size_t FORMATS = 8; //!< formats and refresh periods known at a time
+  // (the marks of CDVStepDown, for the same frames presented the same ways)
+  static constexpr double LOADED_AHEAD = 0.85;
+  static constexpr double LOADED_WAITING = 0.8;
+  static constexpr double RELEASE_AHEAD = 0.75;
+  static constexpr double RELEASE_WAITING = 0.7;
+  static constexpr double LOST_PART = 0.05;
+  static constexpr unsigned int LOST_MIN = 3;
+  static constexpr unsigned int KNOWN_MIN = WINDOW / 2;
+  //! measured frames at a level before it comes down (a minute of film), doubled each time it had
+  //! to be raised to again, up to about an hour of film
+  static constexpr unsigned int RELEASE_WAIT = 1440;
+  static constexpr unsigned int RELEASE_MAX_WAIT = 64 * RELEASE_WAIT;
+
+  struct Window
+  {
+    unsigned int count = 0;
+    double sum = 0;
+    double max = 0;
+    unsigned int over = 0;
+    Pace pace = Pace::PENDING;
+    unsigned int presented = 0;
+    unsigned int lost = 0;
+  };
+
+  struct Format
+  {
+    uint64_t id = 0; //!< 0: none
+    int step = 0;
+    double periodMs = 0;
+    uint64_t used = 0; //!< m_clock of its last frame measured
+    int level = 0;
+    //! what the last window at each level took
+    std::array<double, LEVELS> knownMs{};
+    //! what level n takes for what level n + 1 takes (0: not known)
+    std::array<double, LEVELS - 1> ratio{};
+    bool justUp = false; //!< it went up, and no window at the new level has ended yet
+    //! it came down from that level, and has not kept up below it for RELEASE_WAIT measured
+    //! frames yet (downKept)
+    int downFrom = 0;
+    unsigned int downKept = 0;
+    unsigned int sinceLevel = 0; //!< measured frames at its level since it was reached
+    std::array<unsigned int, LEVELS> wait{0, RELEASE_WAIT, RELEASE_WAIT};
+    unsigned int behind = 0; //!< windows in a row that were behind
+    unsigned int skip = SKIP;
+    Window window;
+
+    void Drop()
+    {
+      window = Window();
+      behind = 0;
+    }
+  };
+
+  static bool SamePeriod(double a, double b) { return std::fabs(a - b) <= 0.02 * b; }
+
+  static unsigned int Mark(unsigned int count)
+  {
+    return std::max(LOST_MIN, static_cast<unsigned int>(std::ceil(LOST_PART * count)));
+  }
+
+  Format* Lookup(uint64_t id, int step, double periodMs)
+  {
+    for (Format& f : m_formats)
+    {
+      if (id != 0 && f.id == id && f.step == step && SamePeriod(f.periodMs, periodMs))
+        return &f;
+    }
+    return nullptr;
+  }
+  const Format* Lookup(uint64_t id, int step, double periodMs) const
+  {
+    return const_cast<CDVGuiLevel*>(this)->Lookup(id, step, periodMs);
+  }
+
+  //! The format at that step-down level and period, or a place for it: a free one, else the one
+  //! measured longest ago of those at level 0, else the one measured longest ago
+  Format* Find(uint64_t id, int step, double periodMs)
+  {
+    ++m_clock;
+    if (Format* const f = Lookup(id, step, periodMs))
+    {
+      f->used = m_clock;
+      return f;
+    }
+    const auto rank = [](const Format& g) { return g.id == 0 ? 0 : g.level > 0 ? 2 : 1; };
+    Format* place = &m_formats[0];
+    for (Format& f : m_formats)
+    {
+      if (rank(f) < rank(*place) || (rank(f) == rank(*place) && f.used < place->used))
+        place = &f;
+    }
+    *place = Format();
+    place->id = id;
+    place->step = step;
+    place->periodMs = periodMs;
+    place->used = m_clock;
+    return place;
+  }
+
+  Step To(Format& f, int level, Change change, Step step)
+  {
+    step.change = change;
+    step.from = f.level;
+    step.to = level;
+    f.level = level;
+    f.sinceLevel = 0;
+    f.Drop();
+    f.skip = std::max(f.skip, SKIP);
+    return step;
+  }
+
+  Step Decide(Format& f, int top)
+  {
+    const Window w = f.window;
+    f.window = Window();
+    const double average = (w.sum - w.max) / (w.count - 1);
+    Step step;
+    step.from = step.to = f.level;
+    step.pace = w.pace;
+    step.averageMs = average;
+    step.periodMs = f.periodMs;
+    step.budgetMs = (w.pace == Pace::AHEAD ? LOADED_AHEAD : LOADED_WAITING) * f.periodMs;
+    step.frames = w.count;
+    step.over = w.over;
+    step.presented = w.presented;
+    step.lost = w.lost;
+
+    const bool known = w.presented >= KNOWN_MIN;
+    const bool missed = w.lost >= Mark(w.presented);
+    bool behind = false;
+    bool beyond = false;
+    if (w.pace == Pace::AHEAD)
+    {
+      behind = known && missed && average > step.budgetMs;
+      beyond = average > f.periodMs;
+    }
+    else
+    {
+      behind = known && missed && w.over >= Mark(w.count);
+      beyond = 2 * w.over > w.count;
+    }
+
+    const int level = f.level;
+    // raised: the first window at it says what it takes for what the level below took
+    if (f.justUp)
+    {
+      f.justUp = false;
+      if (level > 0 && f.knownMs[level - 1] > 0 && average > 0)
+        f.ratio[level - 1] = f.knownMs[level - 1] / average;
+    }
+    f.knownMs[level] = average;
+
+    if (behind)
+    {
+      // frame ahead comes first; one window could have been slow for another reason
+      if (level >= top || w.pace == Pace::PENDING || (!beyond && ++f.behind < 2))
+        return step;
+      f.behind = 0;
+      // it came down from the level above and does not keep up after all: that level waits
+      // longer before it comes down again
+      if (f.downFrom == level + 1)
+        f.wait[level + 1] = std::min(2 * f.wait[level + 1], RELEASE_MAX_WAIT);
+      f.downFrom = 0;
+      f.justUp = true;
+      return To(f, level + 1, Change::UP, step);
+    }
+    f.behind = 0;
+    // it kept up for a minute of film after coming down: the wait of the level above is back to
+    // its start
+    if (known && f.downFrom == level + 1 && (f.downKept += w.count) >= RELEASE_WAIT)
+    {
+      f.downFrom = 0;
+      f.wait[level + 1] = RELEASE_WAIT;
+    }
+    if (level == 0)
+      return step;
+    f.sinceLevel += w.count;
+    if (!known || f.sinceLevel < f.wait[level] || !(f.ratio[level - 1] > 0))
+      return step;
+    const double estimate = average * f.ratio[level - 1];
+    const double release = (w.pace == Pace::AHEAD ? RELEASE_AHEAD : RELEASE_WAITING) * f.periodMs;
+    if (estimate > release)
+      return step;
+    step.estimateMs = estimate;
+    f.downFrom = level;
+    f.downKept = 0;
+    return To(f, level - 1, Change::DOWN, step);
+  }
+
+  std::array<Format, FORMATS> m_formats{};
+  uint64_t m_clock = 0;
+  double m_settlingMs = SETTLE_MS; //!< time of measured frames still left out, of any format
+  double m_guiSettlingMs = 0; //!< ... after GUI elements came
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
