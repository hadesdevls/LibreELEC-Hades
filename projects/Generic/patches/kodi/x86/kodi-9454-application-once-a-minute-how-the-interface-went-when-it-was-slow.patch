From 671ce2ce48659db44ad536590f48195d54bb52e4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 07:39:13 +0000
Subject: [PATCH] application: once a minute, how the interface went when it
 was slow

The lines of the GUI loops in the log are only for waits of 300 ms or more,
and the pointer of Kodi is drawn by the interface: shorter waits, which make
the pointer and the interface stutter, left nothing in the log, and a report
of "the mouse slows down at moments, and there are odd stutters with an
add-on" could not be told from the log of that test.

Once a minute, when there was anything, one line now says how many passes
or gaps of the GUI loops took 50 ms or more with no video playing (a video
paces the loop itself and has its own figures) and the longest of them with
its window; how many times and for how long FrameMove() let calls of add-ons
into the interface (a Python call that touches the interface waits for that
door, and the interface waits as long as the door is open: up to 80 ms a
frame when no video plays); and how many motions of the mouse were left for
the one after them. Nothing is logged in a minute without a slow pass and
with less than 250 ms for add-ons.
---
 xbmc/application/Application.cpp | 66 ++++++++++++++++++++++++++++++++
 xbmc/application/Application.h   | 28 ++++++++++++++
 2 files changed, 94 insertions(+)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index f2c48f8..cfd5262 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1598,8 +1598,17 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
       if (!appPlayer->IsPlayingVideo() || appPlayer->IsPausedPlayback())
         max_sleep = 80;
       unsigned int sleepTime = std::max(static_cast<unsigned int>(2), std::min(m_ProcessedExternalCalls >> 2, max_sleep));
+      const auto opened = std::chrono::steady_clock::now();
       KODI::TIME::Sleep(std::chrono::milliseconds(sleepTime));
       m_frameMoveGuard.lock();
+      // Hades diagnostics: how long the interface waited for add-ons here (the sleep, and the call
+      // that held the guard when it ended)
+      const long long waited = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                   std::chrono::steady_clock::now() - opened)
+                                   .count();
+      m_fluency.addonEntries++;
+      m_fluency.addonMs += waited;
+      m_fluency.addonLongestMs = std::max(m_fluency.addonLongestMs, waited);
       m_ProcessedExternalDecay = 5;
     }
     if (m_ProcessedExternalDecay && --m_ProcessedExternalDecay == 0)
@@ -1670,6 +1679,9 @@ namespace
 // window, a change of the display mode, the audio engine, the storage).
 // (300 ms: Kodi itself waits 100 to 220 ms for a job before it shows the busy dialog)
 constexpr auto SLOW_PASS = std::chrono::milliseconds(300);
+// For the line of the last minute (CApplication::ReportFluency()): three frames at 60 Hz
+constexpr auto FLUENCY_PASS = std::chrono::milliseconds(50);
+constexpr auto FLUENCY_PERIOD = std::chrono::seconds(60);
 
 long long PassMs(std::chrono::steady_clock::duration d)
 {
@@ -1705,10 +1717,63 @@ bool CApplication::SlowPassReportDue(std::chrono::steady_clock::time_point now,
   return true;
 }
 
+void CApplication::CountPassForFluency(std::chrono::steady_clock::time_point now,
+                                       std::chrono::steady_clock::duration took)
+{
+  ReportFluency(now);
+  if (took < FLUENCY_PASS)
+    return;
+  // (the loop is paced by the frames of a video that plays: they have their own figures)
+  const auto appPlayer = GetComponent<CApplicationPlayer>();
+  if (appPlayer && appPlayer->IsPlayingVideo())
+    return;
+
+  m_fluency.slowPasses++;
+  if (took >= 2 * FLUENCY_PASS)
+    m_fluency.verySlowPasses++;
+  if (const long long ms = PassMs(took); ms > m_fluency.longestMs)
+  {
+    m_fluency.longestMs = ms;
+    m_fluency.longestWindows = PassWindows();
+  }
+}
+
+void CApplication::ReportFluency(std::chrono::steady_clock::time_point now)
+{
+  if (m_fluency.since == std::chrono::steady_clock::time_point{})
+  {
+    m_fluency.since = now;
+    return;
+  }
+  if (now - m_fluency.since < FLUENCY_PERIOD)
+    return;
+
+  unsigned int merged = 0;
+  if (m_pMsgHandling)
+  {
+    merged = m_pMsgHandling->m_motionsMerged;
+    m_pMsgHandling->m_motionsMerged = 0;
+  }
+  if (m_fluency.slowPasses > 0 || m_fluency.addonMs >= 250)
+    CLog::Log(LOGINFO,
+              "GUI: in the last {} s, {} passes took 50 ms or more with no video playing ({} of "
+              "them 100 ms or more; the longest {} ms, window {}); the interface let add-ons call "
+              "into it {} times, for {} ms (the longest {} ms); {} motions of the mouse were left "
+              "for the one that followed them",
+              std::chrono::duration_cast<std::chrono::seconds>(now - m_fluency.since).count(),
+              m_fluency.slowPasses, m_fluency.verySlowPasses, m_fluency.longestMs,
+              m_fluency.longestWindows.empty() ? "none" : m_fluency.longestWindows,
+              m_fluency.addonEntries, m_fluency.addonMs, m_fluency.addonLongestMs, merged);
+
+  m_fluency = {};
+  m_fluency.since = now;
+}
+
 void CApplication::ReportFrameGap(std::chrono::steady_clock::time_point now,
                                   std::chrono::steady_clock::duration gap,
                                   const char* where)
 {
+  CountPassForFluency(now, gap);
   if (gap < SLOW_PASS || !SlowPassReportDue(now, gap))
     return;
 
@@ -1759,6 +1824,7 @@ void CApplication::EndPass(std::chrono::steady_clock::time_point start,
     return;
   }
 
+  CountPassForFluency(now, now - start);
   if (now - start < SLOW_PASS || !SlowPassReportDue(now, now - start))
     return;
 
diff --git a/xbmc/application/Application.h b/xbmc/application/Application.h
index e90bb8d..7fe8c00 100644
--- a/xbmc/application/Application.h
+++ b/xbmc/application/Application.h
@@ -258,6 +258,34 @@ protected:
   unsigned int m_passesUnreported = 0;
   std::unique_ptr<CGUIStallWatch> m_stallWatch; //!< says where this thread is when it makes no pass
 
+  /*!
+   * \brief Hades diagnostics: how the interface went in the last minute, logged when it was slow
+   *
+   * The lines of BeginPass() and EndPass() are only for waits of 300 ms or more, and the pointer
+   * of Kodi is drawn by the interface, so waits shorter than that, which make the pointer and the
+   * interface stutter, left nothing in the log. Once a minute, when there were any, one line says
+   * how many passes took 50 ms or more with no video playing (a video paces the loop itself and
+   * has its own figures), how long the interface let add-ons call into it in FrameMove() (Python
+   * calls that touch the interface wait for that, and the interface waits for them), and how many
+   * motions of the mouse were left for the one after them (MouseMotionMerge.h).
+   * Used by the thread of the main loop only.
+   */
+  struct Fluency
+  {
+    std::chrono::steady_clock::time_point since; //!< the start of the minute
+    unsigned int slowPasses = 0; //!< passes or gaps of 50 ms or more, no video playing
+    unsigned int verySlowPasses = 0; //!< of them, those of 100 ms or more
+    long long longestMs = 0;
+    std::string longestWindows;
+    unsigned int addonEntries = 0; //!< times FrameMove() let calls of add-ons in
+    long long addonMs = 0; //!< the time the interface waited for them there
+    long long addonLongestMs = 0;
+  };
+  Fluency m_fluency;
+  void CountPassForFluency(std::chrono::steady_clock::time_point now,
+                           std::chrono::steady_clock::duration took);
+  void ReportFluency(std::chrono::steady_clock::time_point now);
+
   std::unique_ptr<MUSIC_INFO::CMusicInfoScanner> m_musicInfoScanner;
 
   std::unique_ptr<CInertialScrollingHandler> m_pInertialScrollingHandler;
-- 
2.53.0

