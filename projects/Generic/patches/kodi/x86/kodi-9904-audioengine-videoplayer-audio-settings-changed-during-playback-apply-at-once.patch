+void CVideoPlayerAudio::OnSettingChanged(const std::shared_ptr<const CSetting>& setting)
+{
+  if (!setting)
+    return;
+  if (setting->GetId() == CSettings::SETTING_AUDIOOUTPUT_HADESDRC)
+    m_decoderSettingChanged = true;
+  else
+    m_passthroughSettingChanged = true;
+}
