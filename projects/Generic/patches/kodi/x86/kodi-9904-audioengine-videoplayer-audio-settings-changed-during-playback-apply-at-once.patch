index 0000000..f130475
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/AudioSettingsLive.h
@@ -0,0 +1,93 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: audio settings changed during playback that apply at once, not from the next video.
+//
+// Kodi chooses when a stream opens whether it passes through, and which decoder decodes it; a
+// change of those settings while it plays reached the audio engine (which reloads them) but not
+// the stream: it kept passing through after passthrough was turned off for its format, and stayed
+// decoded after it was turned on, until the next video. Now the player looks again at the next
+// frame (CVideoPlayerAudio::OnSettingChanged()), as it does when the display is reset, and the
+// engine answers with the settings as they are (CActiveAE::SupportsRaw()).
+//
+// The settings, and what each one needs:
+// - passthrough, its device's mode (audiooutput.config: fixed has none), each format's passthrough
+//   and the core of DTS-HD: whether the stream passes through, and which way (all of DTS-HD, or its
+//   core). Switching costs what a switch for a reset display costs: the sink opens again.
+// - the dynamic range compression of Dolby Digital (audiooutput.hadesdrc): a decoder of AC-3 or
+//   E-AC-3 that decodes the stream now is opened again with it (one frame of sound is lost: FFmpeg
+//   offers no way to change it while it decodes).
+// - the upmix of stereo and the LFE in a downmix: the engine's resampler of the stream is made
+//   again (CActiveAEBufferPoolResample::ConfigureResampler()), as it already was for the quality
+//   and the normalisation of levels.
+// Not at once, on purpose: the passthrough device (the engine moves the sound to it at once; which
+// formats the new one takes is known only once the engine has opened it), passthrough of live
+// streams (it decides how the player follows the clock of the source: see LivePassthrough.h).
+
+#include <string>
+
+namespace LIVEAUDIO::SETTINGS
+{
+
+//! Why the codec of a stream is looked at again
+enum class CodecCheck
+{
+  PROPERTIES, //!< the stream or the display changed: passthrough on or off (as Kodi)
+  SETTINGS, //!< a setting of passthrough changed: also which passthrough (DTS-HD or its core)
+  DECODER, //!< a setting of the decoder changed: a decoder is opened again with it
+};
+
+//! The look a change of settings needs at the next frame; false: none
+inline bool CheckFor(bool passthroughSetting,
+                     bool decoderSetting,
+                     bool passedThrough,
+                     bool dolbyCodec,
+                     CodecCheck* check)
+{
+  if (decoderSetting && !passedThrough && dolbyCodec)
+  {
+    *check = CodecCheck::DECODER;
+    return true;
+  }
+  if (passthroughSetting)
+  {
+    *check = CodecCheck::SETTINGS;
+    return true;
+  }
+  return false;
+}
+
+//! Whether the codec found for a check replaces the one in use (by their names: "pt-dtshd" passes
+//! all of DTS-HD through, "pt-dts" its core)
+inline bool Replace(CodecCheck check,
+                    bool newPassthrough,
+                    bool oldPassthrough,
+                    const std::string& newName,
+                    const std::string& oldName)
+{
+  if (newPassthrough != oldPassthrough)
+    return true;
+  if (check == CodecCheck::DECODER)
+    return true;
+  return check == CodecCheck::SETTINGS && newName != oldName;
+}
+
+//! Whether the engine's resampler of a stream is made again for settings that changed. Without
+//! one (the sound is not mixed), only the changes that Kodi made it for make one.
+inline bool RemakeResampler(bool hasResampler,
+                            bool normalizeChanged,
+                            bool qualityChanged,
+                            bool upmixChanged,
+                            bool subLevelChanged)
+{
+  return normalizeChanged || qualityChanged || (hasResampler && (upmixChanged || subLevelChanged));
+}
+
+} // namespace LIVEAUDIO::SETTINGS
