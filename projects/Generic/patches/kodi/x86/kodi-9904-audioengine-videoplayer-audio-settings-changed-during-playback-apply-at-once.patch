 bool CVideoPlayerAudio::OpenStream(CDVDStreamInfo hints)
 {
   CLog::Log(LOGINFO, "Finding audio codec for: {}", hints.codec);
@@ -730,6 +758,34 @@ bool CVideoPlayerAudio::ProcessDecoderOutput(DVDAudioFrame &audioframe)
       }
     }
 
+    // Hades: a setting of passthrough, or of the decoder, changed during playback: it applies now
+    // (the frame in hand is the last one of the codec that goes, as when the display is reset)
+    const bool passthroughSetting = m_passthroughSettingChanged.exchange(false);
+    // (a compression set in advancedsettings.xml takes priority: the setting then changes nothing)
+    const bool decoderSetting =
+        m_decoderSettingChanged.exchange(false) &&
+        CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_audioApplyDrc < 0.0f;
+    using LIVEAUDIO::SETTINGS::CodecCheck;
+    CodecCheck check;
+    if (LIVEAUDIO::SETTINGS::CheckFor(passthroughSetting, decoderSetting,
+                                      m_pAudioCodec->NeedPassthrough(),
+                                      m_streaminfo.codec == AV_CODEC_ID_AC3 ||
+                                          m_streaminfo.codec == AV_CODEC_ID_EAC3,
+                                      &check))
+    {
+      const std::string before = m_pAudioCodec->GetName();
+      const bool switched = SwitchCodecIfNeeded(check);
+      CLog::Log(LOGINFO, "CVideoPlayerAudio: an audio setting changed during playback ({}): {}",
+                check == CodecCheck::DECODER ? "of the decoder" : "of passthrough",
+                !switched ? std::string("the stream plays as it did")
+                          : "it applies now: " + before + " -> " + m_pAudioCodec->GetName());
+      if (switched)
+      {
+        audioframe.nb_frames = 0;
+        return false;
+      }
+    }
+
     // demuxer reads metatags that influence channel layout
     if (m_streaminfo.codec == AV_CODEC_ID_FLAC && m_streaminfo.channellayout)
       audioframe.format.m_channelLayout = CAEUtil::GetAEChannelLayout(m_streaminfo.channellayout);
@@ -1016,7 +1072,7 @@ bool CVideoPlayerAudio::AcceptsData() const
   return !full;
 }
 
-bool CVideoPlayerAudio::SwitchCodecIfNeeded()
+bool CVideoPlayerAudio::SwitchCodecIfNeeded(LIVEAUDIO::SETTINGS::CodecCheck check)
 {
   if (m_displayReset)
     CLog::Log(LOGINFO, "CVideoPlayerAudio: display reset occurred, checking for passthrough");
@@ -1037,11 +1093,12 @@ bool CVideoPlayerAudio::SwitchCodecIfNeeded()
   std::unique_ptr<CDVDAudioCodec> codec = CDVDFactoryCodec::CreateAudioCodec(
       m_streaminfo, m_processInfo, allowpassthrough, m_processInfo.AllowDTSHDDecode(), streamType);
 
-  if (!codec || codec->NeedPassthrough() == m_pAudioCodec->NeedPassthrough())
-  {
-    // passthrough state has not changed
+  // passthrough state has not changed (Hades: for a setting, nor which passthrough: the whole of
+  // DTS-HD or its core; for a setting of the decoder, a decoder is wanted again in any case)
+  if (!codec || !LIVEAUDIO::SETTINGS::Replace(check, codec->NeedPassthrough(),
+                                              m_pAudioCodec->NeedPassthrough(), codec->GetName(),
+                                              m_pAudioCodec->GetName()))
     return false;
-  }
 
   m_pAudioCodec = std::move(codec);
 
