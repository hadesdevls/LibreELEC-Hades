From 7701f030e9235aa3f097af54d3fd9a1081caf97f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:24:51 +0000
Subject: [PATCH] VAAPI: size the pool of an HEVC decoder from the level of the
 stream

The decoder was given 16 references for HEVC whatever the stream (22 surfaces, 28
for a dual-layer Dolby Vision one). A 3840x2160 picture at level 5.0 to 5.2 has a
DPB of at most 6 (ITU-T H.265 A.4.2, equation A-2 with maxDpbPicBuf 6): the rest
is memory that nothing uses, about 24 MiB for each surface with
nvidia-vaapi-driver, which gives each surface that is decoded into an image of
its own and NVDEC a decode surface for each one it is given (ulNumDecodeSurfaces
is the number of render targets, vabackend.c nvCreateContext()). A 2 GB card has
no room for them beside the rest of a profile 7 film.

CHevcDpb takes the DPB from general_level_idc, the size of the pictures and the
profile (Main and Main 10 only), and the references become that DPB and two
spare, never more than the 16 it was; Kodi's own 6 and the 6 of the enhancement
layer come on top as before. Anything that does not add up (an unknown level,
another profile, a picture larger than the level allows) keeps the 16. The count
and the reason are logged at the opening of the decoder. If a stream runs out of
surfaces for 600 frames in a row with a pool sized so, the decoders that follow in
the session have the 16 again, and the log says so.

Host test (outside the tree): hevcdpb_test, the levels and sizes by hand, the
refusals, and a sweep.
---
 .../VideoPlayer/DVDCodecs/Video/HevcDpb.h     | 103 ++++++++++++++++++
 .../VideoPlayer/DVDCodecs/Video/VAAPI.cpp     |  62 +++++++++++
 .../cores/VideoPlayer/DVDCodecs/Video/VAAPI.h |   4 +
 3 files changed, 169 insertions(+)
 create mode 100644 xbmc/cores/VideoPlayer/DVDCodecs/Video/HevcDpb.h

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/HevcDpb.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/HevcDpb.h
new file mode 100644
index 0000000..61ab098
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/HevcDpb.h
@@ -0,0 +1,103 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace KODI
+{
+namespace VIDEOPLAYER
+{
+
+/*!
+ * \brief The most pictures that the decoded picture buffer of an HEVC stream may hold (MaxDpbSize,
+ *        ITU-T H.265 A.4.2), from the level and the size of its pictures
+ *
+ * VAAPI gave an HEVC decoder 16 references whatever the stream, which is the DPB of a picture a
+ * fourth of what its level allows. A 3840x2160 picture at level 5.0 to 5.2 allows 6: the other ten
+ * surfaces are memory that nothing uses (about 24 MiB each in p010, which nvidia-vaapi-driver
+ * allocates for each surface that is decoded into, and which a 2 GB card has no room for beside the
+ * rest of a profile 7 film).
+ *
+ * Only what the Main and Main 10 profiles of the specification say (maxDpbPicBuf = 6). Anything
+ * that does not add up (an unknown level, another profile, a picture larger than the level allows,
+ * a size that is zero) gives 0, which is "not known": the caller keeps the 16 it always had.
+ */
+struct CHevcDpb
+{
+  //! general_level_idc (30 times the level) to MaxLumaPs (Table A.8), 0 where it is not a level of
+  //! the specification
+  static constexpr uint32_t MaxLumaPs(int level)
+  {
+    switch (level)
+    {
+      case 30: // 1
+        return 36864;
+      case 60: // 2
+        return 122880;
+      case 63: // 2.1
+        return 245760;
+      case 90: // 3
+        return 552960;
+      case 93: // 3.1
+        return 983040;
+      case 120: // 4
+      case 123: // 4.1
+        return 2228224;
+      case 150: // 5
+      case 153: // 5.1
+      case 156: // 5.2
+        return 8912896;
+      case 180: // 6
+      case 183: // 6.1
+      case 186: // 6.2
+        return 35651584;
+      default:
+        return 0;
+    }
+  }
+
+  //! profile_idc 1 (Main) and 2 (Main 10): AV_PROFILE_HEVC_MAIN and AV_PROFILE_HEVC_MAIN_10
+  static constexpr bool MainProfile(int profile) { return profile == 1 || profile == 2; }
+
+  //! MaxDpbSize of a stream (equation A-2 with maxDpbPicBuf 6), 0 where it is not known
+  static constexpr int MaxDpbSize(int profile, int level, int width, int height)
+  {
+    if (!MainProfile(profile) || width <= 0 || height <= 0 || width > 16384 || height > 16384)
+      return 0;
+    const uint64_t maxLumaPs = MaxLumaPs(level);
+    const uint64_t size = static_cast<uint64_t>(width) * static_cast<uint64_t>(height);
+    if (maxLumaPs == 0 || size > maxLumaPs)
+      return 0;
+    constexpr int MAX_DPB_PIC_BUF = 6;
+    if (size <= (maxLumaPs >> 2))
+      return std::min(4 * MAX_DPB_PIC_BUF, 16);
+    if (size <= (maxLumaPs >> 1))
+      return std::min(2 * MAX_DPB_PIC_BUF, 16);
+    if (size <= ((3 * maxLumaPs) >> 2))
+      return std::min((4 * MAX_DPB_PIC_BUF) / 3, 16);
+    return MAX_DPB_PIC_BUF;
+  }
+
+  //! Spare surfaces over the DPB, which the 6 that Kodi adds to every decoder (the picture being
+  //! decoded, those that FFmpeg's output holds, the render queue's) do not cover
+  static constexpr int SPARE = 2;
+
+  //! The references for the pool of a stream: its DPB and the spare, never more than the 16 that it
+  //! was, and 16 where the DPB is not known
+  static constexpr int References(int profile, int level, int width, int height)
+  {
+    const int dpb = MaxDpbSize(profile, level, width, height);
+    return dpb > 0 ? std::min(dpb + SPARE, 16) : 16;
+  }
+};
+
+} // namespace VIDEOPLAYER
+} // namespace KODI
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
index 7205a13..8f9e4ff 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
@@ -9,6 +9,7 @@
 #include "VAAPI.h"
 
 #include "DVDVideoCodec.h"
+#include "HevcDpb.h"
 #include "ServiceBroker.h"
 #include "VAAPIStreamFormat.h"
 #include "cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.h"
@@ -58,6 +59,18 @@ extern "C" {
 
 using namespace VAAPI;
 using namespace std::chrono_literals;
+using KODI::VIDEOPLAYER::CHevcDpb;
+
+namespace
+{
+// Hades: a stream of this process whose surfaces ran out with the pool sized from its level (the
+// decoder waited for one that nothing was going to give back): the next decoder takes the 16
+// references that it always had
+std::atomic<bool> g_hevcFullPool{false};
+// ... frames without a surface in a row after which that is taken to be so (about ten seconds at
+// 60 Hz; a pool that is only busy gives one back within a few frames)
+constexpr int HEVC_STARVED_FRAMES = 600;
+} // namespace
 
 #define NUM_RENDER_PICS 7
 
@@ -763,7 +776,19 @@ bool CDecoder::Open(AVCodecContext* avctx, AVCodecContext* mainctx, const enum A
       m_vaapiConfig.maxReferences = 5;
   }
   else if (avctx->codec_id == AV_CODEC_ID_HEVC)
+  {
     m_vaapiConfig.maxReferences = 16;
+    // Hades: not the 16 of a picture a fourth the size of what its level allows, but the DPB of
+    // its level (ITU-T H.265 A.4.2) and a spare; 16 where anything does not add up
+    if (!g_hevcFullPool.load(std::memory_order_relaxed))
+    {
+      m_hevcDpb = CHevcDpb::MaxDpbSize(avctx->profile, avctx->level, avctx->coded_width,
+                                       avctx->coded_height);
+      m_vaapiConfig.maxReferences = CHevcDpb::References(avctx->profile, avctx->level,
+                                                         avctx->coded_width, avctx->coded_height);
+      m_hevcReduced = m_vaapiConfig.maxReferences < 16;
+    }
+  }
   else if (avctx->codec_id == AV_CODEC_ID_VP9)
     m_vaapiConfig.maxReferences = 8;
   else if (avctx->codec_id == AV_CODEC_ID_AV1)
@@ -788,6 +813,31 @@ bool CDecoder::Open(AVCodecContext* avctx, AVCodecContext* mainctx, const enum A
     m_vaapiConfig.maxReferences += 6;
     m_vaapiOutput.ReserveRenderPictures(NUM_RENDER_PICS + 6);
   }
+  if (avctx->codec_id == AV_CODEC_ID_HEVC)
+  {
+    const auto* dvOwner = dynamic_cast<CDVDVideoCodecFFmpeg*>(
+        static_cast<ICallbackHWAccel*>(avctx->opaque));
+    const bool dvEnhancement = dvOwner && dvOwner->NeedsDVEnhancement();
+    const int surfaces = static_cast<int>(m_vaapiConfig.maxReferences);
+    const int before = 16 + 6 + (dvEnhancement ? 6 : 0);
+    std::string why;
+    if (m_hevcReduced)
+      why = StringUtils::Format("a DPB of at most {} pictures at that level, {} spare, 6 for the "
+                                "player{}; {} before, about {} MiB less of video memory with "
+                                "nvidia-vaapi-driver",
+                                m_hevcDpb, CHevcDpb::SPARE,
+                                dvEnhancement ? ", 6 for the enhancement layer" : "", before,
+                                (before - surfaces) * 24);
+    else if (g_hevcFullPool.load(std::memory_order_relaxed))
+      why = "the surfaces of an earlier stream of this session ran out with fewer: the 16 "
+            "references it always had";
+    else
+      why = "the level and the size of the pictures do not give a smaller DPB: the 16 references "
+            "it always had";
+    CLog::Log(LOGINFO, "VAAPI: HEVC {}x{} profile {} level {:.1f}: {} surfaces ({})",
+              avctx->coded_width, avctx->coded_height, avctx->profile, avctx->level / 30.0,
+              surfaces, why);
+  }
 #endif
 
   if (!ConfigVAAPI())
@@ -933,6 +983,18 @@ int CDecoder::FFGetBuffer(AVCodecContext *avctx, AVFrame *pic, int flags)
     CLog::Log(LOGWARNING, "VAAPI::FFGetBuffer - no surface available - dec: {}, render: {}",
               decoded, render);
     va->m_getBufferError++;
+    // Hades: the pool was sized from the level of the stream (HEVC) and nothing gives a surface
+    // back: this stream went beyond its level. The next decoder of the session has the 16
+    // references it always had.
+    if (va->m_hevcReduced && va->m_getBufferError == HEVC_STARVED_FRAMES)
+    {
+      g_hevcFullPool.store(true, std::memory_order_relaxed);
+      CLog::Log(LOGERROR,
+                "VAAPI::FFGetBuffer - no surface for {} frames in a row with a pool of {} sized "
+                "from the level of the stream (a DPB of at most {}): the decoders opened from now "
+                "on in this session have the 16 references they always had",
+                HEVC_STARVED_FRAMES, va->m_videoSurfaces.Size(), va->m_hevcDpb);
+    }
     return -1;
   }
 
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
index aee4811..f8b0fe1 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
@@ -603,6 +603,10 @@ protected:
   CVideoSurfaces m_videoSurfaces;
   //! Hades: surfaces go out last given back first, each synced as it goes out (ConfigVAAPI())
   bool m_reuseLast = false;
+  //! Hades: the pool of an HEVC stream was sized from its level (CHevcDpb), and the DPB that it was
+  //! sized from
+  bool m_hevcReduced = false;
+  int m_hevcDpb = 0;
   //! Hades: ... the surfaces handed out so, and those whose sync waited (Close())
   unsigned int m_reuseHanded = 0;
   unsigned int m_reuseWaited = 0;
