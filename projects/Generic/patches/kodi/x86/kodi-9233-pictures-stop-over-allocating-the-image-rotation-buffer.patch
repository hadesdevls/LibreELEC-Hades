From 86bfb678ea188aaf21235f61889fa8be3f41d560 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Sun, 11 Oct 2026 12:56:22 +0100
Subject: [PATCH] pictures: stop over-allocating the image rotation buffer

The four rotations allocate width * height * 4 uint32_t for a buffer
they only ever write width * height elements of, so every rotated image
costs 16 bytes per pixel instead of 4. At the largest size the texture
cache produces that is 31.6MB rather than 7.9MB.

(cherry picked from commit d16bbe69f5e4661b4d03d9f8648678c97deca732)
---
 xbmc/pictures/Picture.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/xbmc/pictures/Picture.cpp b/xbmc/pictures/Picture.cpp
index ed64166..0f3154a 100644
--- a/xbmc/pictures/Picture.cpp
+++ b/xbmc/pictures/Picture.cpp
@@ -489,7 +489,7 @@ bool CPicture::Rotate90CCW(std::unique_ptr<uint32_t[]>& pixels,
                            unsigned int& height,
                            unsigned int& stridePixels)
 {
-  auto dest = std::make_unique<uint32_t[]>(width * height * 4);
+  auto dest = std::make_unique<uint32_t[]>(width * height);
   unsigned int d_height = width, d_width = height;
   for (unsigned int y = 0; y < d_height; y++)
   {
@@ -512,7 +512,7 @@ bool CPicture::Rotate270CCW(std::unique_ptr<uint32_t[]>& pixels,
                             unsigned int& height,
                             unsigned int& stridePixels)
 {
-  auto dest = std::make_unique<uint32_t[]>(width * height * 4);
+  auto dest = std::make_unique<uint32_t[]>(width * height);
   unsigned int d_height = width, d_width = height;
   for (unsigned int y = 0; y < d_height; y++)
   {
@@ -537,7 +537,7 @@ bool CPicture::Transpose(std::unique_ptr<uint32_t[]>& pixels,
                          unsigned int& height,
                          unsigned int& stridePixels)
 {
-  auto dest = std::make_unique<uint32_t[]>(width * height * 4);
+  auto dest = std::make_unique<uint32_t[]>(width * height);
   unsigned int d_height = width, d_width = height;
   for (unsigned int y = 0; y < d_height; y++)
   {
@@ -561,7 +561,7 @@ bool CPicture::TransposeOffAxis(std::unique_ptr<uint32_t[]>& pixels,
                                 unsigned int& height,
                                 unsigned int& stridePixels)
 {
-  auto dest = std::make_unique<uint32_t[]>(width * height * 4);
+  auto dest = std::make_unique<uint32_t[]>(width * height);
   unsigned int d_height = width, d_width = height;
   for (unsigned int y = 0; y < d_height; y++)
   {
