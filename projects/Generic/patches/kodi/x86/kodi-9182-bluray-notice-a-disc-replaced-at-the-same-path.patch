From 73031c6db5c82a977d2dc74c2c64fc831640c6c3 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 13:08:28 +0100
Subject: [PATCH] [Bluray] Notice a disc replaced at the same path.

A disc's information is cached by its path, and only an optical drive's
was ever dropped, on eject. A disc folder or image replaced at the same
path was served from the cache until it fell out of it.

Each cached disc now holds the modification time and size of its index
or image, and is dropped when they change. The playlist maps are also
cached under the same key as the rest of the disc's information.
---
 xbmc/filesystem/BlurayDirectory.cpp          |  7 ++-
 xbmc/filesystem/BlurayDiscCache.cpp          | 15 ++++++
 xbmc/filesystem/BlurayDiscCache.h            | 10 ++++
 xbmc/filesystem/test/CMakeLists.txt          |  1 +
 xbmc/filesystem/test/TestBlurayDiscCache.cpp | 51 ++++++++++++++++++++
 5 files changed, 83 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/filesystem/test/TestBlurayDiscCache.cpp

diff --git a/xbmc/filesystem/BlurayDirectory.cpp b/xbmc/filesystem/BlurayDirectory.cpp
index 3846bd1..03719c0 100644
--- a/xbmc/filesystem/BlurayDirectory.cpp
+++ b/xbmc/filesystem/BlurayDirectory.cpp
@@ -536,7 +536,7 @@ bool CBlurayDirectory::GetPlaylistsInformation(const CURL& url,
   try
   {
     // Check cache
-    const std::string& path{url.GetHostName()};
+    const std::string path{GetCachePath(url, realPath)};
     if (CServiceBroker::GetBlurayDiscCache()->GetMaps(path, playlists, clips, allTitles))
     {
       CLog::LogF(LOGDEBUG, "Playlist information for {} retrieved from cache", path);
@@ -797,6 +797,11 @@ bool CBlurayDirectory::GetDirectory(const CURL& url, CFileItemList& items)
   // Neither needs libbluray or disc.inf, so both are deferred.
   SetRealPath(root);
 
+  // A disc folder or image can be replaced at the same path
+  if (struct __stat64 st{}; CFile::Stat(URIUtils::GetDiscFile(m_url.Get()), &st) == 0)
+    CServiceBroker::GetBlurayDiscCache()->CheckDisc(GetCachePath(m_url, m_realPath),
+                                                    fmt::format("{}:{}", st.st_mtime, st.st_size));
+
   //
   // These options also return 'All Titles' and 'Menu' options (if supported on disc)
   //
diff --git a/xbmc/filesystem/BlurayDiscCache.cpp b/xbmc/filesystem/BlurayDiscCache.cpp
index 58f42e2..382ba75 100644
--- a/xbmc/filesystem/BlurayDiscCache.cpp
+++ b/xbmc/filesystem/BlurayDiscCache.cpp
@@ -261,6 +261,21 @@ void CBlurayDiscCache::ClearDisc(const std::string& path)
   m_cache.erase(GetDiscKey(path));
 }
 
+void CBlurayDiscCache::CheckDisc(const std::string& path, const std::string& fingerprint)
+{
+  std::unique_lock lock(m_cs);
+
+  if (const Disc * disc{Find(path)};
+      disc && disc->fingerprint != fingerprint && !disc->fingerprint.empty())
+  {
+    CLog::LogF(LOGDEBUG, "Disc at {} has changed, dropping its cached information",
+               CURL::GetRedacted(path));
+    m_cache.erase(GetDiscKey(path));
+  }
+
+  FindOrCreate(path).fingerprint = fingerprint;
+}
+
 void CBlurayDiscCache::Clear()
 {
   std::unique_lock lock(m_cs);
diff --git a/xbmc/filesystem/BlurayDiscCache.h b/xbmc/filesystem/BlurayDiscCache.h
index 4c48481..4b9dccc 100644
--- a/xbmc/filesystem/BlurayDiscCache.h
+++ b/xbmc/filesystem/BlurayDiscCache.h
@@ -41,6 +41,9 @@ struct Disc
   //! What the disc's authoring project named, where it left one behind
   std::optional<XFILE::ProjectInformation> project;
 
+  //! Identifies the content held, so a disc replaced at the same path is noticed (see CheckDisc)
+  std::string fingerprint;
+
   //! When this disc was last used, to decide which to drop when the cache is full. Mutable as
   //! recency is not part of what the cache holds, so reading a disc's information updates it too.
   mutable uint64_t lastUsed{0};
@@ -124,6 +127,13 @@ public:
   //! Drop everything held for a disc, as its information no longer describes what is in the drive
   void ClearDisc(const std::string& path);
 
+  /*!
+   \brief Drop everything held for a disc if it is not the disc it was read from.
+   \param fingerprint identifies the disc's content, eg. the modification time and size of its
+   index or image
+   */
+  void CheckDisc(const std::string& path, const std::string& fingerprint);
+
 private:
   /*!
    \brief Find a disc, recording that it has been used. m_cs must be held.
diff --git a/xbmc/filesystem/test/CMakeLists.txt b/xbmc/filesystem/test/CMakeLists.txt
index f1d754e..6de7fba 100644
--- a/xbmc/filesystem/test/CMakeLists.txt
+++ b/xbmc/filesystem/test/CMakeLists.txt
@@ -11,6 +11,7 @@ set(SOURCES TestAudioBookFileDirectory.cpp
 
 if(TARGET ${APP_NAME_LC}::Bluray)
   list(APPEND SOURCES TestBlurayDirectory.cpp
+                      TestBlurayDiscCache.cpp
                       TestBlurayPlaylistHints.cpp
                       TestDiscDirectoryHelperProject.cpp
                       TestProjectParser.cpp
diff --git a/xbmc/filesystem/test/TestBlurayDiscCache.cpp b/xbmc/filesystem/test/TestBlurayDiscCache.cpp
new file mode 100644
index 0000000..80acd95
--- /dev/null
+++ b/xbmc/filesystem/test/TestBlurayDiscCache.cpp
@@ -0,0 +1,51 @@
