+/* Hades: the rows of 4:2:2 chroma of the source transport made by a compute shader with a shared tile
+ * of the rows of 4:2:0 (dvbridge_source_compute_rows(): the same bytes, fewer texture fetches). Off
+ * until asked for, and in the reference of a check of the bytes (dvbridge_render_reference(): its own
+ * packer, which is never asked), so that a check compares it with pass 2. usable: made on this GPU
+ * and not failed; computed: the rows of the last picture prepared in the source transport were made
+ * so. */
+#define DVBRIDGE_RENDER_COMPUTE_ROWS 1
+void dvbridge_render_use_compute_rows(struct dvbridge_renderer *renderer, bool use);
+bool dvbridge_render_compute_rows_usable(const struct dvbridge_renderer *renderer);
+bool dvbridge_render_rows_computed(const struct dvbridge_renderer *renderer);
 /* Hades: whether the display is sent the trims of the metadata (dvbridge_set_trims()); true by
  * default */
 void dvbridge_render_send_trims(struct dvbridge_renderer *renderer, bool send);
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 4097950..b349faf 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -10,7 +10,7 @@
 #include "dvbridge_source.h"
 #include "dvbridge_ipt.h"
 #include "dvbridge_gl_pack.h"
-#include <GLES3/gl3.h>
+#include <GLES3/gl31.h>
 #include <libavutil/dovi_meta.h>
 #include <math.h>
 #include <stdio.h>
@@ -357,6 +357,79 @@ static const char ROWS[] =
     "    color = uvec4(c0, c1);\n"
     "}\n";
 
+/* 2c. Hades: pass 2 as a compute shader (dvbridge_source_compute_rows()), with the technique of the
+ * pack of YBLOD's Vulkan engine (yblod-engine-vk 2e7f9bbc85, "the CB1 contract pack from a shared
+ * chroma tile"): a workgroup of 32 x 4 invocations makes 32 columns by 8 fragment rows of pass 2,
+ * two each (4 apart), from a tile of the rows of 4:2:0 that those read (8 + span - 1 of them, 20 at
+ * most) fetched into shared memory once. Pass 2 fetches span rows (12 or 13) for every fragment, each
+ * row once for every fragment that reads it; here a texel of the rows takes (8 + span - 1) / 8 = 2.4
+ * or 2.5 fetches. Each code is the fragment's: floor(c * chroma_read + 0.5) of the same texel, which
+ * is exact (a code times a power of 2, plus a half); and the same integer sums of the same codes:
+ * the same bytes as pass 2, every texel of the rows (those outside the columns and rows that the
+ * transport reads 0, as in pass 2). A workgroup that makes none of the texels that the transport
+ * reads (the rows of the bars) loads nothing, as YBLOD's pack leaves out its workgroups in the bars:
+ * pass 2 fetches nothing there either. */
+#define ROWS_GROUP_W 32
+#define ROWS_GROUP_H 8
+#define ROWS_TILE ((ROWS_GROUP_H + ROWS_SPAN - 1) * ROWS_GROUP_W)
+_Static_assert(ROWS_GROUP_W == 32 && ROWS_GROUP_H == 8 && ROWS_TILE == 640,
+               "the compute form of pass 2 is written for workgroups of 32 x 4, 2 rows each");
+static const char ROWS_COMPUTE[] =
+    "#version 310 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "layout(local_size_x = 32, local_size_y = 4) in;\n"
+    "uniform highp sampler2D chroma_plane;\n"
+    "layout(rgba16ui, binding = 0) writeonly uniform highp uimage2D rows_out;\n"
+    "uniform float chroma_read;\n" /* as in pass 2 */
+    "uniform int chroma_shift;\n"
+    "uniform int lo, span;\n"
+    "uniform int taps0, first0, taps1, first1, last_row, code_max;\n"
+    "uniform int weights0[12], weights1[12];\n"
+    "uniform ivec4 needed;\n"
+    "uniform ivec2 size;\n" /* of the rows: the columns of the chroma plane, the fragment rows of pass 2 */
+    "shared ivec2 tile[640];\n" /* rows g.y + lo ... g.y + lo + 8 + span - 2 of 4:2:0, 32 columns */
+    "void main()\n"
+    "{\n"
+    "    ivec2 g = ivec2(gl_WorkGroupID.xy) * ivec2(32, 8);\n"
+    "    bool used = g.x < needed.y && g.x + 32 > needed.x && 2 * g.y < needed.w &&\n"
+    "                2 * (g.y + 8) > needed.z;\n" /* (the same for the whole workgroup) */
+    "    int count = used ? (8 + span - 1) * 32 : 0;\n"
+    "    for (int e = int(gl_LocalInvocationIndex); e < count; e += 128) {\n"
+    "        int tr = e / 32, tc = e - tr * 32;\n"
+    "        int col = min(g.x + tc, size.x - 1);\n" /* (a column beyond the plane is never read) */
+    "        int row = clamp(g.y + lo + tr, 0, last_row);\n"
+    "        vec2 c = texelFetch(chroma_plane, ivec2(col, row), 0).rg;\n"
+    "        tile[e] = ivec2(floor(c * chroma_read + 0.5));\n"
+    "    }\n"
+    "    barrier();\n"
+    "    int lx = int(gl_LocalInvocationID.x);\n"
+    "    for (int h = 0; h < 2; h++) {\n"
+    "        int ly = int(gl_LocalInvocationID.y) + 4 * h;\n"
+    "        ivec2 q = g + ivec2(lx, ly);\n"
+    "        if (q.x >= size.x || q.y >= size.y)\n"
+    "            continue;\n"
+    "        bool column = q.x >= needed.x && q.x < needed.y;\n"
+    "        bool even = column && 2 * q.y >= needed.z && 2 * q.y < needed.w;\n"
+    "        bool odd = column && 2 * q.y + 1 >= needed.z && 2 * q.y + 1 < needed.w;\n"
+    "        uvec4 color = uvec4(0u);\n"
+    "        if (even || odd) {\n"
+    /* row q.y + lo + k of 4:2:0 (clamped) is tile row ly + k: the tile's rows start at g.y + lo */
+    "            ivec2 a0 = ivec2(0), a1 = ivec2(0);\n"
+    "            for (int k = 0; k < taps0; k++)\n"
+    "                a0 += weights0[k] * tile[(ly + first0 - lo + k) * 32 + lx];\n"
+    "            for (int k = 0; k < taps1; k++)\n"
+    "                a1 += weights1[k] * tile[(ly + first1 - lo + k) * 32 + lx];\n"
+    "            a0 = (a0 + (1 << (chroma_shift - 1))) >> chroma_shift;\n"
+    "            a1 = (a1 + (1 << (chroma_shift - 1))) >> chroma_shift;\n"
+    "            uvec2 c0 = even ? uvec2(clamp(a0, ivec2(0), ivec2(code_max))) : uvec2(0u);\n"
+    "            uvec2 c1 = odd ? uvec2(clamp(a1, ivec2(0), ivec2(code_max))) : uvec2(0u);\n"
+    "            color = uvec4(c0, c1);\n"
+    "        }\n"
+    "        imageStore(rows_out, q, color);\n"
+    "    }\n"
+    "}\n";
+
 /* Hades: the passes of a picture that is scaled (dvbridge_source_scale()), in place of 1 and 2. The
  * weights of each output position (dvbridge_source_axis()) are four texels of an integer texture:
  * first, taps, w0, w1 / w2 .. w5 / w6 .. w9 / w10, w11. */
@@ -1691,6 +1764,17 @@ struct dvbridge_source_packer {
     GLint ir_rows;
     struct texture ipt_luma, ipt_rows;
     bool rows_ipt;
+    /* Hades: pass 2 as a compute shader (2c, dvbridge_source_compute_rows()): its program and its
+     * uniforms (those of pass 2, in its order, and the size of the rows), whether it is asked for,
+     * whether it failed on this GPU (it is not tried again: pass 2 makes the rows), and whether it
+     * made the last rows */
+    GLuint rows_compute;
+    struct {
+        GLint chroma, chroma_read, chroma_shift, lo, span, taps0, first0, taps1, first1, last_row,
+            code_max, weights0, weights1, needed;
+    } vc;
+    GLint vc_size;
+    bool compute_rows, compute_failed, rows_computed;
 };
 
 static GLuint compile(GLenum type, const char *source)
@@ -1736,6 +1820,33 @@ static GLuint link(const char *fragment)
     return link_with(VERTEX, fragment);
 }
 
+/* Hades: a compute program (OpenGL ES 3.1), or 0 where the GL is older or does not make it */
+static GLuint link_compute(const char *source)
+{
+    GLint major = 0, minor = 0;
+    glGetIntegerv(GL_MAJOR_VERSION, &major);
+    glGetIntegerv(GL_MINOR_VERSION, &minor);
+    while (glGetError() != GL_NO_ERROR) {
+    }
+    if (major < 3 || (major == 3 && minor < 1))
+        return 0;
+    GLuint cs = compile(GL_COMPUTE_SHADER, source);
+    GLuint program = 0;
+    if (cs) {
+        program = glCreateProgram();
+        glAttachShader(program, cs);
+        glLinkProgram(program);
+        GLint linked = 0;
+        glGetProgramiv(program, GL_LINK_STATUS, &linked);
+        if (!linked) {
+            glDeleteProgram(program);
+            program = 0;
+        }
+    }
+    glDeleteShader(cs);
+    return program;
+}
+
 /* the locations of the uniforms of a program, in the order of their names; false if one is missing */
 static bool locate(GLuint program, GLint *out, const char *const *names, size_t count)
 {
@@ -2000,6 +2111,19 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
                             "the pictures go out as composed\n");
         }
     }
+    /* Hades: pass 2 as a compute shader (2c), where the GL makes it; without it, pass 2 */
+    {
+        _Static_assert(sizeof(p->vc) == sizeof(p->v), "the uniforms of 2c are those of pass 2");
+        p->rows_compute = link_compute(ROWS_COMPUTE);
+        p->vc_size = p->rows_compute ? glGetUniformLocation(p->rows_compute, "size") : -1;
+        if (p->rows_compute &&
+            (p->vc_size < 0 || !locate(p->rows_compute, &p->vc.chroma, rows, COUNT(rows)))) {
+            glDeleteProgram(p->rows_compute);
+            p->rows_compute = 0;
+        }
+        while (glGetError() != GL_NO_ERROR) {
+        }
+    }
     glGenVertexArrays(1, &p->vao);
     glGenSamplers(1, &p->sampler);
     glSamplerParameteri(p->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
@@ -2037,6 +2161,7 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     glDeleteProgram(p->picture);
     glDeleteProgram(p->resite);
     glDeleteProgram(p->rows);
+    glDeleteProgram(p->rows_compute);
     glDeleteProgram(p->cover);
     glDeleteProgram(p->cover_blocks);
     glDeleteProgram(p->gui_tiles_program);
@@ -2192,24 +2317,52 @@ bool dvbridge_source_rows(struct dvbridge_source_packer *p,
         return end(&state, false);
     if (!target(&p->chroma, GL_RGBA16UI, cw, half))
         return end(&state, false);
-    glUseProgram(p->rows);
-    bind(p, 0, chroma_in);
-    glUniform1i(p->v.chroma, 0);
-    glUniform1f(p->v.chroma_read, params->htaps ? 1.0f : (float)(1 << params->bits));
-    glUniform1i(p->v.chroma_shift, DVBRIDGE_SOURCE_WEIGHT_BITS +
-                                       (params->htaps ? DVBRIDGE_SOURCE_FRAC_BITS : 0));
-    glUniform1i(p->v.last_row, ch - 1);
-    glUniform1i(p->v.code_max, params->code_max);
-    glUniform4i(p->v.needed, needed[0], needed[1], needed[2], needed[3]);
-    glUniform1i(p->v.lo, lo);
-    glUniform1i(p->v.span, span);
-    glUniform1i(p->v.taps0, params->vtaps[0]);
-    glUniform1i(p->v.first0, params->vfirst[0]);
-    glUniform1i(p->v.taps1, params->vtaps[1]);
-    glUniform1i(p->v.first1, params->vfirst[1]);
-    glUniform1iv(p->v.weights0, DVBRIDGE_SOURCE_TAPS, params->vweights[0]);
-    glUniform1iv(p->v.weights1, DVBRIDGE_SOURCE_TAPS, params->vweights[1]);
-    glDrawArrays(GL_TRIANGLES, 0, 3);
+    /* Hades: by the compute form (2c) where it is asked for and was made; where it fails (a GL error),
+     * the rows are made again by pass 2 at once, and 2c is not tried again on this GPU */
+    bool compute = p->compute_rows && p->rows_compute && !p->compute_failed;
+    for (;;) {
+        glUseProgram(compute ? p->rows_compute : p->rows);
+        bind(p, 0, chroma_in);
+        /* (the uniforms of pass 2, in their order: of either program) */
+        const GLint *const u = compute ? &p->vc.chroma : &p->v.chroma;
+        enum { CHROMA, CHROMA_READ, CHROMA_SHIFT, LO, SPAN, TAPS0, FIRST0, TAPS1, FIRST1, LAST_ROW,
+               CODE_MAX, WEIGHTS0, WEIGHTS1, NEEDED };
+        glUniform1i(u[CHROMA], 0);
+        glUniform1f(u[CHROMA_READ], params->htaps ? 1.0f : (float)(1 << params->bits));
+        glUniform1i(u[CHROMA_SHIFT], DVBRIDGE_SOURCE_WEIGHT_BITS +
+                                         (params->htaps ? DVBRIDGE_SOURCE_FRAC_BITS : 0));
+        glUniform1i(u[LAST_ROW], ch - 1);
+        glUniform1i(u[CODE_MAX], params->code_max);
+        glUniform4i(u[NEEDED], needed[0], needed[1], needed[2], needed[3]);
+        glUniform1i(u[LO], lo);
+        glUniform1i(u[SPAN], span);
+        glUniform1i(u[TAPS0], params->vtaps[0]);
+        glUniform1i(u[FIRST0], params->vfirst[0]);
+        glUniform1i(u[TAPS1], params->vtaps[1]);
+        glUniform1i(u[FIRST1], params->vfirst[1]);
+        glUniform1iv(u[WEIGHTS0], DVBRIDGE_SOURCE_TAPS, params->vweights[0]);
+        glUniform1iv(u[WEIGHTS1], DVBRIDGE_SOURCE_TAPS, params->vweights[1]);
+        if (!compute) {
+            glDrawArrays(GL_TRIANGLES, 0, 3);
+            break;
+        }
+        glUniform2i(p->vc_size, cw, half);
+        /* what the GPU did before (the composer that wrote the plane, the passes of the frame before
+         * that read these rows) done first; the rows written for the passes that sample them */
+        glMemoryBarrier(GL_ALL_BARRIER_BITS);
+        glBindImageTexture(0, p->chroma.texture, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RGBA16UI);
+        glDispatchCompute((GLuint)((cw + ROWS_GROUP_W - 1) / ROWS_GROUP_W),
+                          (GLuint)((half + ROWS_GROUP_H - 1) / ROWS_GROUP_H), 1);
+        glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+        glBindImageTexture(0, 0, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RGBA16UI);
+        if (glGetError() == GL_NO_ERROR)
+            break;
+        p->compute_failed = true;
+        compute = false;
+        fprintf(stderr, "DV source transport: the compute form of pass 2 failed on this GPU; the "
+                        "rows are made by pass 2\n");
+    }
+    p->rows_computed = compute;
     ok = end(&state, true);
     if (ok) {
         const int key[8] = {width, height, x, y, (int)margins[0], (int)margins[1],
@@ -2469,6 +2622,22 @@ bool dvbridge_source_ipt_setup(struct dvbridge_source_params *ipt,
     return true;
 }
 
+void dvbridge_source_compute_rows(struct dvbridge_source_packer *p, bool use)
+{
+    if (p)
+        p->compute_rows = use;
+}
+
+bool dvbridge_source_compute_rows_usable(const struct dvbridge_source_packer *p)
+{
+    return p && p->rows_compute && !p->compute_failed;
+}
+
+bool dvbridge_source_rows_computed(const struct dvbridge_source_packer *p)
+{
+    return p && p->rows_made && p->rows_computed;
+}
+
 bool dvbridge_source_can_ipt(const struct dvbridge_source_packer *p)
 {
     return p && p->ipt_luma_program && p->ipt_rows_program;
diff --git a/tools/dvbridge/dvbridge_source.h b/tools/dvbridge/dvbridge_source.h
index 4134633..1b06591 100644
--- a/tools/dvbridge/dvbridge_source.h
+++ b/tools/dvbridge/dvbridge_source.h
@@ -302,6 +302,18 @@ bool dvbridge_source_ipt_setup(struct dvbridge_source_params *ipt,
                                const struct dvbridge_source_params *src);
 /* Hades: whether the passes of the IPT tunnel were made on this GPU */
 bool dvbridge_source_can_ipt(const struct dvbridge_source_packer *packer);
+
+/* Hades: the rows of 4:2:2 of dvbridge_source_rows() made by a compute shader (OpenGL ES 3.1) that
+ * fetches the rows of 4:2:0 that a workgroup of 32 columns by 8 of its rows reads into shared memory
+ * once, about 2.5 fetches a texel of the rows where the fragments of pass 2 make 12 or 13 (the
+ * technique of the pack of YBLOD's Vulkan engine). The same integer sums of the same codes: the same
+ * bytes. Off until asked for (use); where the GL does not make it, or it fails on the GPU (it is
+ * then not tried again), pass 2. usable: it was made and has not failed; computed: the last rows
+ * made were made by it. */
+#define DVBRIDGE_SOURCE_COMPUTE_ROWS 1
+void dvbridge_source_compute_rows(struct dvbridge_source_packer *packer, bool use);
+bool dvbridge_source_compute_rows_usable(const struct dvbridge_source_packer *packer);
+bool dvbridge_source_rows_computed(const struct dvbridge_source_packer *packer);
 /* Hades: after dvbridge_source_rows() or dvbridge_source_scale() of a picture of src, its codes in
  * IPT-PQ-c2, 12 bits, in two passes: the chroma of every pixel (between the pairs, Lanczos 6 in
  * integers, the filter of the rows, DVBRIDGE_SOURCE_LANCZOS), its YCbCr through YCCtoRGB of the RPU,
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 48ebd37..48194ef 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -525,6 +525,24 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
       CLog::Log(LOGINFO, "DVBridge: the GUI cache is checked, as advancedsettings.xml asks "
                          "(dvguicachecheck): the tiles copied are packed again and compared");
   }
+  // Hades: the rows of 4:2:2 chroma of the source transport by a compute shader that reads the rows
+  // of 4:2:0 of a tile once, where the GL makes it (OpenGL ES 3.1; the same bytes, fewer texture
+  // fetches, the technique of YBLOD's pack). advancedsettings.xml can turn it off, to measure what it
+  // saves (the GPU time of "DV rows" with dvpasstimes): <video><dvcomputerows>false</dvcomputerows></video>
+  {
+    const auto settings = CServiceBroker::GetSettingsComponent();
+    const bool computeRows = !settings || settings->GetAdvancedSettings()->m_videoDVComputeRows;
+    dvbridge_render_use_compute_rows(m_renderer, computeRows);
+    if (!computeRows)
+      CLog::Log(LOGINFO, "DVBridge: the rows of 4:2:2 chroma are made by the fragment pass, as "
+                         "advancedsettings.xml asks (dvcomputerows)");
+    else if (!dvbridge_render_compute_rows_usable(m_renderer))
+      CLog::Log(LOGINFO, "DVBridge: the rows of 4:2:2 chroma are made by the fragment pass: the "
+                         "compute pass could not be made on this GPU (it takes OpenGL ES 3.1)");
+    else
