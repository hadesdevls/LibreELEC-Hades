From 341f5565acc6283f91908b2568fccb05827181d7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:23:16 +0000
Subject: [PATCH] windowing/gbm: a capture made by a native output that did not
 start is given back

BeginDVBridge() captured the output and then, when the GUI compositing could
not be set up, rejected the start with the capture still held: the output was
taken for one that native output has, and every frame after it was refused for
"gui-compositing". The capture made by that call, before anything of native
output was committed, is given back now with the restoration that carries what
Kodi has asked for since, as DVMenusBegin() does; where the display refuses it,
it is tried again once a second.
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index e00a03c..05e654a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4812,7 +4812,17 @@ bool CWinSystemGbmGLESContext::BeginDVBridge(bool hdr10Tunnel, int guiTransfer)
   // (Hades: HDR over the tunnel composites the GUI for the transfer of the picture, as it is: PQ or
   // HLG)
   if (!SetGuiCompositing(hdr10Tunnel && guiTransfer ? guiTransfer : AVCOL_TRC_SMPTE2084))
-    return DVBridgeBeginRejected("gui-compositing-setup");
+  {
+    // Hades: the capture that this call made, before anything of native output was committed, is
+    // given back (as DVMenusBegin() does): left captured, the output would be taken for one that
+    // native output has while it is the ordinary one, and every frame after it would be refused
+    // for "gui-compositing". Given back by the restoration that carries what Kodi has asked for
+    // since (m_dvRestoreRequeue); where the display refuses it, it is tried again once a second.
+    const bool rejected = DVBridgeBeginRejected("gui-compositing-setup");
+    if (m_outputHandover.HoldsOutput() && !m_outputHandover.TransportOn() && !EndDVBridge())
+      m_dvRestoreRetry = std::chrono::steady_clock::now();
+    return rejected;
+  }
   if (m_dvBeginFailures.Count())
     m_dvBeginFailures.Reset();
   DVNativeOutputBegins();
