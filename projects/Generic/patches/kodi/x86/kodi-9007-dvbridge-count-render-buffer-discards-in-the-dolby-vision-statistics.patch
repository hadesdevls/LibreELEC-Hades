From e93327dd18eb7b0bbd32302be58cf799163a110f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 28 Sep 2026 02:07:11 +0000
Subject: [PATCH] dvbridge: count render buffer discards in the Dolby Vision
 statistics

The renderer flush counter added before stayed at 0 on real hardware,
also right after subtitle stream changes: seeks, stream changes and
decoder resets do not flush the renderer, they discard its queued
pictures (CRenderManager::DiscardBuffer(), called from the video player
thread). Count those discards with an atomic counter, reset when native
output starts and at each statistics line, next to the flush count.
---
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp | 5 +++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp          | 8 +++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h            | 5 +++++
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 7fe4fd6..3347730 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -1205,6 +1205,11 @@ void CRenderManager::PrepareNextRender()
 
 void CRenderManager::DiscardBuffer()
 {
+#ifdef HAVE_DVBRIDGE
+  if (auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem()))
+    dvWindow->DVBridgeDiscarded();
+#endif
   std::unique_lock lock2(m_presentlock);
 
   while(!m_queued.empty())
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 5dbcc6b..5c8fc39 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -183,6 +183,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
           m_dvStats = {};
           m_dvStats.start = std::chrono::steady_clock::now();
           m_dvLastWindow = {};
+          m_dvDiscards.store(0, std::memory_order_relaxed);
           if (m_dvBridge)
             m_dvBridge->TakeL1Changes();
         }
@@ -804,12 +805,13 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
   CLog::Log(LOGINFO,
             "DVBridge: {}: {} frames shown, {} not shown, {} composed with GUI elements; "
             "prepare avg {:.1f} ms max {:.1f} ms; present avg {:.1f} ms max {:.1f} ms; "
-            "longest gap between shown frames {:.1f} ms; {} renderer flushes (seeks, stream "
-            "changes)",
+            "longest gap between shown frames {:.1f} ms; {} renderer flushes, {} buffer discards "
+            "(seeks, stream changes, decoder resets)",
             period, m_dvStats.shown, m_dvStats.notShown, m_dvStats.withGui,
             m_dvStats.prepared ? m_dvStats.prepareSumMs / m_dvStats.prepared : 0.0,
             m_dvStats.prepareMaxMs, attempts ? m_dvStats.presentSumMs / attempts : 0.0,
-            m_dvStats.presentMaxMs, m_dvStats.gapMaxMs, m_dvStats.flushes);
+            m_dvStats.presentMaxMs, m_dvStats.gapMaxMs, m_dvStats.flushes,
+            m_dvDiscards.exchange(0, std::memory_order_relaxed));
   m_dvLastWindow.valid = true;
   m_dvLastWindow.shown = m_dvStats.shown;
   m_dvLastWindow.notShown = m_dvStats.notShown;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 4726e1c..6acfbc2 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -14,6 +14,7 @@
 #include "utils/EGLUtils.h"
 
 #include <chrono>
+#include <atomic>
 #include <map>
 #include <memory>
 #ifdef HAVE_DVBRIDGE
@@ -76,6 +77,9 @@ public:
     if (m_dvSignalling)
       m_dvStats.flushes++;
   }
+  //! Queued pictures were discarded (every seek, stream change and decoder reset); counted in
+  //! the DV statistics. Called from the video player thread.
+  void DVBridgeDiscarded() { m_dvDiscards.fetch_add(1, std::memory_order_relaxed); }
   bool SetVideoOutput(const VideoPicture* picture) override;
   bool DestroyWindowSystem() override;
 #endif
@@ -131,6 +135,7 @@ private:
     std::chrono::steady_clock::time_point lastShown;
   } m_dvStats;
   void LogDVStats(const char* period);
+  std::atomic<unsigned int> m_dvDiscards{0};
   //! The last complete 10-s window of DVStats, for the player information.
   struct DVWindow
   {
