From dfb1be2b116dd39218193841842a5031a3c3a183 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:20:06 +0000
Subject: [PATCH] settings: the comments of the settings of Hades next to what
 they describe

When the Dolby Vision and HDR settings were put in groups, eight comments of settings.xml
stayed behind in two stacks (above videoscreen.hadesdvahead and above
videoscreen.hadesdvsdrtarget), far from the settings they describe: HDR at more than 8
bits on NVIDIA, the HDR10 luminance limit, HDR10 adapted to the display, Low-Latency
everywhere, the black of the display for Low-Latency, the HDMI 1.4b signalling, the content
mapping v4.0 and its peak set by hand. Each is above its setting again, where it was
before the regrouping. In Settings.h the comment of the peak of v4.0 was above the SDR
target, and the new names were between those of Low-Latency; two comments were cut at odd
places by the wrapping. In GUIDialogSettingsBase.cpp the comment of "HDR where RGB would be
8 bits" was above another block. Only comments, and the order of three declarations,
change.

Host test (outside the tree): t_setcomments.py fails on a comment of Hades in
settings.xml that is followed by another one (8 before, none after), and checks that the
settings without their comments are the same as before.
---
 system/settings/settings.xml                  | 30 +++++++++----------
 xbmc/settings/Settings.h                      | 20 ++++++-------
 .../dialogs/GUIDialogSettingsBase.cpp         |  5 ++--
 3 files changed, 26 insertions(+), 29 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index a3147c9..b47fd0f 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3407,19 +3407,6 @@
         <default>false</default>
         <control type="toggle" />
       </setting>
-      <!-- Hades: HDR at more than 8 bits on NVIDIA graphics that send RGB at 8 bits at most over HDMI
-           (HdrMoreBits.h): off until it is confirmed on those cards -->
-      <!-- Hades: the luminance that the HDR10 InfoFrame tells the display, limited (a projector that maps less
-           with smaller values): off by default; the picture is not changed -->
-      <!-- Hades: HDR10 and HDR10+ adapted to the display by the player (a projector): off by default,
-           the display maps the video as it was mastered -->
-      <!-- Hades: Low-Latency also where the display takes Standard, and the target of its mapping set by
-           hand (a projector, a display measured): off by default, as they change the picture -->
-      <!-- Hades: the black of the display for Low-Latency, set by hand with its peak and colours: 0 keeps the
-           black of the source, as before -->
-      <!-- Hades: shown only where the display asks for the HDMI 1.4b signalling -->
-      <!-- Hades: the content mapping v4.0 of native output: as the video has it by default (the master);
-           the others change what the TV does, and are the user's choice -->
       <!-- Hades: taken over by videoscreen.hadesdvaheadmode; kept, hidden, as earlier builds read it -->
       <setting id="videoscreen.hadesdvahead" type="boolean">
         <requirement>
@@ -3507,6 +3494,7 @@
         </dependencies>
         <control type="toggle" />
       </setting>
+      <!-- Hades: shown only where the display asks for the HDMI 1.4b signalling -->
       <setting id="videoscreen.hadesdvhdmi14b" type="boolean" label="39878" help="39879">
         <requirement>
           <and>
@@ -3561,6 +3549,8 @@
         </dependencies>
         <control type="toggle" />
       </setting>
+      <!-- Hades: Low-Latency also where the display takes Standard, and the target of its mapping set by
+           hand (a projector, a display measured): off by default, as they change the picture -->
       <setting id="videoscreen.hadesdvllalways" type="boolean" parent="videoscreen.hadesdvlowlatency" label="40966" help="40967">
         <requirement>
           <and>
@@ -3651,6 +3641,8 @@
         </dependencies>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the black of the display for Low-Latency, set by hand with its peak and colours: 0 keeps the
+           black of the source, as before -->
       <setting id="videoscreen.hadesdvllblack" type="number" parent="videoscreen.hadesdvllmanual" label="40980" help="40981">
         <requirement>
           <and>
@@ -3766,6 +3758,8 @@
         <default>false</default>
         <control type="toggle" />
       </setting>
+      <!-- Hades: the content mapping v4.0 of native output: as the video has it by default (the master);
+           the others change what the TV does, and are the user's choice -->
       <setting id="videoscreen.hadesdvcm40" type="integer" label="40960" help="40961">
         <requirement>
           <and>
@@ -3790,8 +3784,6 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
-      <!-- Hades: the peak that the automatic choices of the content mapping v4.0 are decided against,
-           where the TV's Dolby block declares a wrong one -->
       <!-- Hades: the display that Dolby Vision mapped to SDR is made for: the white it shows and its gamma -->
       <setting id="videoscreen.hadesdvsdrtarget" type="integer" label="41130" help="41131">
         <requirement>
@@ -3811,6 +3803,8 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the peak that the automatic choices of the content mapping v4.0 are decided against,
+           where the TV's Dolby block declares a wrong one -->
       <setting id="videoscreen.hadesdvcm40manual" type="boolean" parent="videoscreen.hadesdvcm40" label="41120" help="41121">
         <requirement>
           <and>
@@ -3910,6 +3904,8 @@
         <default>false</default>
         <control type="toggle" />
       </setting>
+      <!-- Hades: HDR10 and HDR10+ adapted to the display by the player (a projector): off by default,
+           the display maps the video as it was mastered -->
       <setting id="videoscreen.hadeshdr10adapt" type="integer" label="40984" help="40985">
         <requirement>
           <and>
@@ -3931,6 +3927,8 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the luminance that the HDR10 InfoFrame tells the display, limited (a projector that maps less
+           with smaller values): off by default; the picture is not changed -->
       <setting id="videoscreen.hadeshdr10limiton" type="boolean" label="40974" help="40975">
         <requirement>
           <and>
@@ -4088,6 +4086,8 @@
         </constraints>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: HDR at more than 8 bits on NVIDIA graphics that send RGB at 8 bits at most over HDMI
+           (HdrMoreBits.h): off until it is confirmed on those cards -->
       <setting id="videoscreen.hadeshdrmorebits" type="boolean" label="41011" help="41012">
         <requirement>
           <and>
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index bc3e605..2132f42 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -434,15 +434,13 @@ public:
   //! Hades: native Dolby Vision output at all (off: as on a display without it); from the next
   //! video
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVNATIVE = "videoscreen.hadesdvnative";
-  //! Hades: the colour format of the output: 0 automatic (what Hades does without the setting), 1
-  //! RGB,
-  //! 2 YCbCr 4:4:4, 3 YCbCr 4:2:2, 4 YCbCr 4:2:0 (the connector property "color format" of Linux
-  //! 7.3,
-  //! amdgpu); OutputFormat.h
+  //! Hades: the colour format of the output: 0 automatic (what Hades does without the setting),
+  //! 1 RGB, 2 YCbCr 4:4:4, 3 YCbCr 4:2:2, 4 YCbCr 4:2:0 (the connector property "color format" of
+  //! Linux 7.3, amdgpu); OutputFormat.h
   static constexpr auto SETTING_VIDEOSCREEN_HADESCOLORFORMAT = "videoscreen.hadescolorformat";
   //! Hades: HDR10, HLG and HDR10+ over the tunnel as YCbCr 4:2:2 at 12 bits where the ordinary
-  //! output
-  //! would send 4:2:0 or RGB at 8 bits (3840x2160 at 50 and 60 Hz over HDMI 2.0): HDR10Tunnel.h
+  //! output would send 4:2:0 or RGB at 8 bits (3840x2160 at 50 and 60 Hz over HDMI 2.0):
+  //! HDR10Tunnel.h
   static constexpr auto SETTING_VIDEOSCREEN_HADESHDR10TUNNEL = "videoscreen.hadeshdr10tunnel";
   //! Hades: the depth of the link by the user's choice: 0 automatic, 8, 10 or 12 ("max bpc")
   static constexpr auto SETTING_VIDEOSCREEN_HADESMAXBPC = "videoscreen.hadesmaxbpc";
@@ -456,15 +454,15 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLALWAYS = "videoscreen.hadesdvllalways";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLMANUAL = "videoscreen.hadesdvllmanual";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLPEAK = "videoscreen.hadesdvllpeak";
-  //! Hades: the peak that the content mapping v4.0 is decided against, set by hand (cd/m2)
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLGAMUT = "videoscreen.hadesdvllgamut";
+  //! Hades: ... and its black, cd/m2 (0: the black of the source kept)
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLBLACK = "videoscreen.hadesdvllblack";
   //! Hades: the display that Dolby Vision mapped to SDR is made for (Reference, Bright room,
   //! Projector)
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVSDRTARGET = "videoscreen.hadesdvsdrtarget";
+  //! Hades: the peak that the content mapping v4.0 is decided against, set by hand (cd/m2)
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVCM40MANUAL = "videoscreen.hadesdvcm40manual";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVCM40PEAK = "videoscreen.hadesdvcm40peak";
-  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLGAMUT = "videoscreen.hadesdvllgamut";
-  //! Hades: ... and its black, cd/m2 (0: the black of the source kept)
-  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLBLACK = "videoscreen.hadesdvllblack";
   //! Hades: native output with the older signalling, the HDMI 1.4b vendor InfoFrame, where the
   //! display asks for it (TVs of 2016); off by default, from the next video
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVHDMI14B = "videoscreen.hadesdvhdmi14b";
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index efedbd6..a4b550d 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -627,8 +627,7 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   if (labelId >= 40980 && labelId <= 40983)
     return CGUIUtils::GetHadesString(labelId, 32276 + (labelId - 40980));
   // the video scaling method (the video settings of the player): Kodi's own label, and where it
-  // does
-  // not apply: the Dolby Vision bridge scales the picture itself, with its own filters
+  // does not apply: the Dolby Vision bridge scales the picture itself, with its own filters
 #ifdef HAVE_DVBRIDGE
   if (labelId == 16300)
     return CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(16300) + " " +
@@ -662,7 +661,6 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // Vision as HDR10+: labels, help
   if (labelId >= 40920 && labelId <= 40927)
     return CGUIUtils::GetHadesString(labelId, 32094 + (labelId - 40920));
-  // HDR where RGB would be 8 bits: label, help, values
   // Hades: the graphics card kept at full speed while HD audio plays through: label, help
   if (labelId == 41850 || labelId == 41851)
     return CGUIUtils::GetHadesString(labelId, 32950 + (labelId - 41850));
@@ -678,6 +676,7 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // Hades: Dolby Vision with the older signalling (HDMI 1.4b)
   if (labelId == 39878 || labelId == 39879)
     return CGUIUtils::GetHadesString(labelId, 31923 + (labelId - 39878));
+  // HDR where RGB would be 8 bits: label, help, values
   if (labelId >= 39848 && labelId <= 39851)
     return CGUIUtils::GetHadesString(labelId, 31980 + (labelId - 39848));
   // Hades: HDR over the tunnel as YCbCr 4:2:2 at 12 bits: label, help
-- 
2.53.0

