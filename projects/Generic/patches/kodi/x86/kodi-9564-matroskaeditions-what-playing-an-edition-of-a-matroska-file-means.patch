+
+#pragma once
+
+// The editions of a Matroska file, as the demuxer exports them (the read-only "editions" option of
+// FFmpeg's matroska demuxer, ffmpeg-9940), and what playing one of them means for Kodi.
+//
+// An edition that is not ordered plays the whole file: its chapters are only marks. An ordered edition
+// plays its enabled chapters, in their order; when they are parts of this same file, in ascending order
+// and without overlap, that is the whole file with the parts in between cut out, which Kodi's edit
+// decision list does (cuts with a seek). An ordered edition that uses parts of other files (segment
+// linking), plays parts out of order or twice, or has a chapter without a start or an end, cannot be
+// played that way and is not offered. A hidden edition is not offered either (RFC 9559: hidden editions
+// are not available to the user interface). A hidden chapter is still played (hiding is for menus).
+//
+// Pure: no Kodi or FFmpeg state, so that a host test can run it.
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace MKV_EDITIONS
+{
+
+// Gaps between two parts shorter than this are not cut, and overlaps shorter than this are taken as
+// parts that follow each other: chapter times written by muxers are rounded (to the millisecond, or to a
+// frame), and a cut is a seek, which costs more than the few milliseconds it would remove.
+constexpr int64_t MIN_CUT_MS = 100;
+constexpr int MAX_EDITIONS = 256;
+constexpr int MAX_CHAPTERS = 4096;
+
+struct Chapter
+{
+  int64_t startNs = -1; // -1: the file gives none
+  int64_t endNs = -1;
+  uint64_t uid = 0;
+  bool hidden = false;
+  bool enabled = true;
+  std::string segmentUid; // lowercase hex; empty: the chapter names no segment
+  std::string title;
+};
+
+struct Edition
+{
+  uint64_t uid = 0;
+  bool isDefault = false;
+  bool hidden = false;
+  bool ordered = false;
+  std::string name;
+  std::vector<Chapter> chapters;
+};
+
+struct File
+{
+  std::string segmentUid;
+  std::vector<Edition> editions;
+};
+
+enum class Reason
+{
+  NONE,
+  HIDDEN, // EditionFlagHidden
+  LINKED, // a part is in another file
+  OUT_OF_ORDER, // parts out of order, overlapping or played twice
+  INCOMPLETE, // no enabled part, a part without a start or an end, beyond the end, or no file length
+};
+
+inline const char* ReasonName(Reason r)
+{
+  switch (r)
+  {
+    case Reason::NONE:
+      return "playable";
+    case Reason::HIDDEN:
+      return "hidden by the file";
+    case Reason::LINKED:
+      return "uses parts of other files (segment linking)";
+    case Reason::OUT_OF_ORDER:
+      return "its parts are out of order, overlap or repeat";
+    case Reason::INCOMPLETE:
+      return "a part has no start or end, or lies beyond the end of the file";
+  }
+  return "?";
+}
+
+struct Cut
+{
+  int64_t startMs;
+  int64_t endMs;
+  bool operator==(const Cut& o) const { return startMs == o.startMs && endMs == o.endMs; }
+};
+
+struct Plan
+{
+  bool offered = false;
+  Reason reason = Reason::NONE;
+  std::vector<Cut> cuts; // ascending, not overlapping, in file time
+  int64_t durationMs = 0; // what plays
+};
+
+namespace DETAIL
+{
+inline bool ToU64(const char* s, uint64_t& out)
+{
+  if (!s || !*s || !std::isdigit(static_cast<unsigned char>(*s)))
+    return false;
+  char* end = nullptr;
+  out = std::strtoull(s, &end, 10);
+  return end && !*end;
+}
+
+inline std::string Lower(std::string s)
+{
+  std::transform(s.begin(), s.end(), s.begin(),
+                 [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return s;
+}
+
+inline int64_t NsToMs(int64_t ns)
+{
+  return (ns + 500000) / 1000000;
+}
+} // namespace DETAIL
+
+// lookup(key) returns the value of that key of the exported dictionary, or nullptr.
+template<typename Lookup>
+File Parse(Lookup lookup)
+{
+  using namespace DETAIL;
+  File file;
+  uint64_t count = 0;
+  if (!ToU64(lookup("count"), count))
+    return file;
+  count = std::min<uint64_t>(count, MAX_EDITIONS);
+  if (const char* s = lookup("segment_uid"))
+    file.segmentUid = Lower(s);
+  auto flag = [&](const std::string& key, bool def)
+  {
+    uint64_t v = 0;
+    return ToU64(lookup(key.c_str()), v) ? v != 0 : def;
+  };
+  for (uint64_t e = 0; e < count; e++)
+  {
+    const std::string ek = std::to_string(e) + ".";
+    Edition ed;
+    ToU64(lookup((ek + "uid").c_str()), ed.uid);
+    ed.isDefault = flag(ek + "default", false);
+    ed.hidden = flag(ek + "hidden", false);
+    ed.ordered = flag(ek + "ordered", false);
+    if (const char* s = lookup((ek + "name").c_str()))
+      ed.name = s;
+    uint64_t nch = 0;
+    ToU64(lookup((ek + "chapters").c_str()), nch);
+    nch = std::min<uint64_t>(nch, MAX_CHAPTERS);
+    for (uint64_t c = 0; c < nch; c++)
+    {
+      const std::string ck = ek + std::to_string(c) + ".";
+      Chapter ch;
+      uint64_t v = 0;
+      if (ToU64(lookup((ck + "start").c_str()), v) && v <= static_cast<uint64_t>(INT64_MAX))
+        ch.startNs = static_cast<int64_t>(v);
+      if (ToU64(lookup((ck + "end").c_str()), v) && v <= static_cast<uint64_t>(INT64_MAX))
+        ch.endNs = static_cast<int64_t>(v);
+      ToU64(lookup((ck + "uid").c_str()), ch.uid);
+      ch.hidden = flag(ck + "hidden", false);
+      ch.enabled = flag(ck + "enabled", true);
+      if (const char* s = lookup((ck + "segment_uid").c_str()))
+        ch.segmentUid = Lower(s);
+      if (const char* s = lookup((ck + "title").c_str()))
+        ch.title = s;
+      ed.chapters.push_back(std::move(ch));
+    }
+    file.editions.push_back(std::move(ed));
+  }
+  return file;
+}
+
+inline Plan PlanEdition(const File& file, size_t index, int64_t fileDurationMs)
+{
+  using namespace DETAIL;
+  Plan plan;
+  if (index >= file.editions.size())
+  {
+    plan.reason = Reason::INCOMPLETE;
+    return plan;
+  }
+  const Edition& ed = file.editions[index];
+  if (ed.hidden)
+  {
+    plan.reason = Reason::HIDDEN;
+    return plan;
+  }
+  if (!ed.ordered)
+  {
+    plan.offered = true;
+    plan.durationMs = std::max<int64_t>(fileDurationMs, 0);
+    return plan;
+  }
+
+  std::vector<const Chapter*> parts;
+  for (const Chapter& ch : ed.chapters)
+    if (ch.enabled)
+      parts.push_back(&ch);
+  for (const Chapter* ch : parts)
+    if (!ch->segmentUid.empty() && ch->segmentUid != file.segmentUid)
+    {
+      plan.reason = Reason::LINKED;
+      return plan;
+    }
+  if (parts.empty() || fileDurationMs <= 0)
+  {
+    plan.reason = Reason::INCOMPLETE;
+    return plan;
+  }
+
+  int64_t played = 0; // end of what plays so far
+  for (const Chapter* ch : parts)
+  {
+    if (ch->startNs < 0 || ch->endNs <= ch->startNs) // also no end (-1)
+    {
+      plan.reason = Reason::INCOMPLETE;
+      plan.cuts.clear();
+      return plan;
+    }
+    const int64_t start = NsToMs(ch->startNs);
+    const int64_t end = NsToMs(ch->endNs);
+    if (start >= fileDurationMs)
+    {
+      plan.reason = Reason::INCOMPLETE;
+      plan.cuts.clear();
+      return plan;
+    }
+    if (start <= played - MIN_CUT_MS)
+    {
+      plan.reason = Reason::OUT_OF_ORDER;
+      plan.cuts.clear();
+      return plan;
+    }
+    if (start - played >= MIN_CUT_MS)
+      plan.cuts.push_back({played, start});
+    played = std::max(played, end); // a part past the end: the tail is not cut
+  }
+  if (fileDurationMs - played >= MIN_CUT_MS)
+    plan.cuts.push_back({played, fileDurationMs});
+
+  int64_t cut = 0;
+  for (const Cut& c : plan.cuts)
+    cut += c.endMs - c.startMs;
+  plan.offered = true;
+  plan.durationMs = fileDurationMs - cut;
+  return plan;
+}
+
+// The editions Kodi can offer, in the order of the file.
+inline std::vector<size_t> Offered(const File& file, int64_t fileDurationMs)
+{
+  std::vector<size_t> out;
+  for (size_t i = 0; i < file.editions.size(); i++)
+    if (PlanEdition(file, i, fileDurationMs).offered)
+      out.push_back(i);
+  return out;
+}
+
+// The edition the file asks for when nobody chooses (EditionFlagDefault), else the first one.
+inline size_t DefaultEdition(const File& file)
+{
+  for (size_t i = 0; i < file.editions.size(); i++)
+    if (file.editions[i].isDefault)
+      return i;
+  return 0;
+}
+
+} // namespace MKV_EDITIONS
-- 
