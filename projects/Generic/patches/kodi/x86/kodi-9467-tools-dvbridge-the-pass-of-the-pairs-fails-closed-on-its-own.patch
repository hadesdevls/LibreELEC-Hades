 tools/dvbridge/dvbridge_render.c              |  15 +-
 tools/dvbridge/dvbridge_render.h              |   4 +
 tools/dvbridge/dvbridge_source.c              | 172 +++++++++++++-----
 tools/dvbridge/dvbridge_source.h              |   4 +
 .../VideoRenderers/DVBridgeGLES.cpp           |   5 +
 5 files changed, 153 insertions(+), 47 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index e0dd41a..3a143b8 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -18,6 +18,7 @@ enum {
     NOTE_LEVEL_SKIPPED = 2,
     NOTE_BL_DEPTH = 4,
     NOTE_EL_DEPTH = 8,
+    NOTE_PAIRS_MISSED = 16,
 };
 
 struct dvbridge_renderer {
@@ -416,6 +417,7 @@ bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_ren
     notes->level_skipped = r->fresh & NOTE_LEVEL_SKIPPED;
     notes->bl_depth = r->fresh & NOTE_BL_DEPTH;
     notes->el_depth = r->fresh & NOTE_EL_DEPTH;
+    notes->pairs_missed = r->fresh & NOTE_PAIRS_MISSED;
     r->fresh = 0;
     return true;
 }
@@ -673,10 +675,15 @@ static bool source_pack(struct dvbridge_renderer *r, unsigned layer, unsigned fr
     if (!packets || !dvbridge_active_area(r->pending, margins))
         return false;
     const unsigned luma = pl_opengl_unwrap(r->gpu, r->planes[0], NULL, NULL, NULL);
-    return luma && dvbridge_source_pack(r->source_packer, &r->source_params, luma,
-                                        r->geometry.source_width, r->geometry.source_height,
-                                        r->geometry.x, r->geometry.y, layer, margins, framebuffer,
-                                        packets, count, flip);
+    const bool packed = luma && dvbridge_source_pack(r->source_packer, &r->source_params, luma,
+                                                     r->geometry.source_width,
+                                                     r->geometry.source_height, r->geometry.x,
+                                                     r->geometry.y, layer, margins, framebuffer,
+                                                     packets, count, flip);
+    /* Hades: the pixels drawn over a profile 5 picture converted by the transport itself */
+    if (packed && dvbridge_source_pairs_missed(r->source_packer))
+        note(r, NOTE_PAIRS_MISSED);
+    return packed;
 }
 
 /* Hades: the source transport (dvbridge_source.h). libplacebo composes the planes into ours and
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index c6690b6..78acd1a 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -34,11 +34,15 @@ void dvbridge_render_set_display_management(struct dvbridge_renderer *renderer,
 void dvbridge_render_texture_drawn(struct dvbridge_renderer *renderer);
 /* Hades: what the renderer noticed of a stream, once each between two resets. */
 #define DVBRIDGE_RENDER_DEPTH_NOTES 1
+#define DVBRIDGE_RENDER_PAIRS_NOTE 1
 struct dvbridge_render_notes {
     bool l5_master;     /* level 5 offsets read as those of a 3840x2160 master (reading) */
     bool level_skipped; /* extension blocks of reserved levels left out (reading) */
     bool bl_depth;      /* a frame refused: its base layer is not of the depth of its RPU */
     bool el_depth;      /* an enhancement layer not used: not of the depth of its RPU */
+    /* Hades: the pixels drawn over a picture of profile 5 converted by the transport itself, as
+     * before the pass that converts each pair of them once (dvbridge_source_pairs_missed()) */
+    bool pairs_missed;
     unsigned bl_bits, rpu_bl_bits;   /* for bl_depth: of the layer, and of the RPU */
     unsigned el_bits, rpu_el_bits;   /* for el_depth */
     struct dvbridge_reading reading; /* of the frame that brought the first two */
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index aab3c37..a6a24c8 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -406,10 +406,12 @@ static const char PICTURE[] =
     "}\n";
 
 /* A pixel drawn over converted back to codes. (Hades: the same code in passes 4 and 8; pass 8 makes
- * three of the four calls that pass 4 made for a pair, see above.) */
-#define DRAWN_OVER                                                                                \
+ * three of the four calls that pass 4 made for a pair, see above. DRAWN_OVER_CODE is the GLSL that
+ * PACK has as it had it; DRAWN_OVER, that with its uniforms, for PACK_PAIRS and PAIRS.) */
+#define DRAWN_OVER_UNIFORMS                                                                       \
     "uniform int code_max;\n"                                                                     \
-    "uniform mat3 ycc_inverse, lms_inverse;\n"                                                    \
+    "uniform mat3 ycc_inverse, lms_inverse;\n"
+#define DRAWN_OVER_CODE                                                                           \
     /* the inverse of decode(): PQ BT.2020 RGB -> codes, not rounded */                           \
     "vec3 to_source(vec3 rgb)\n"                                                                  \
     "{\n"                                                                                         \
@@ -447,12 +449,71 @@ static const char PICTURE[] =
     "{\n"                                                                                         \
     "    return uint(clamp(int(floor(v + 0.5)), 0, code_max));\n"                                 \
     "}\n"
+#define DRAWN_OVER DRAWN_OVER_UNIFORMS DRAWN_OVER_CODE
 
 /* Hades: what pass 8 writes for a pixel that nothing was drawn over (the codes are below 4096) */
 #define NOT_OVER "65535u"
 
+/* What the two forms of pass 4 share: the parity of a code, */
+#define PACK_PARITY                                                                               \
+    "uint parity(uint v)\n"                                                                       \
+    "{\n"                                                                                         \
+    "    v ^= v >> 16u; v ^= v >> 8u; v ^= v >> 4u; v ^= v >> 2u; v ^= v >> 1u;\n"               \
+    "    return v & 1u;\n"                                                                        \
+    "}\n"
+/* and the end of main(): the bit of the metadata, and the bytes of the pixel. */
+#define PACK_END                                                                                  \
+    "    uint index = uint(p.y * 3840 + p.x), packet = index / 3072u;\n"                          \
+    "    if (packet < packet_count) {\n"                                                          \
+    "        uint bit = index % 1024u, word = packet * 32u + bit / 32u;\n"                        \
+    "        uint value = (metadata_words[word / 4u][int(word % 4u)] >> (31u - bit % 32u)) & 1u;\n" \
+    "        c = (c & 4094u) | (value ^ parity(c >> 1u) ^ parity(y));\n"                         \
+    "    }\n"                                                                                     \
+    "    color = vec4(float(c >> 4u), float(y >> 4u), float((y & 15u) | ((c & 15u) << 4u)), 255.0) / 255.0;\n" \
+    "}\n"
+
 /* 4. The transport. */
 static const char PACK[] =
+    "#version 300 es\n"
+    COMMON
+    "uniform highp sampler2D drawn;\n" /* the picture of pass 3, with what was drawn over it */
+    "uniform int has_layer, code_max;\n"
+    "uniform mat3 ycc_inverse, lms_inverse;\n"
+    "uniform uvec4 metadata_words[128];\n"
+    "uniform uint packet_count;\n"
+    "uniform uint flip_y;\n"
+    "flat in int tile_drawn;\n" /* Hades: (TILED_VERTEX) something may be drawn over this tile */
+    "out vec4 color;\n"
+    PACK_PARITY
+    DRAWN_OVER_CODE
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    "    int ex = p.x & ~1;\n"
+    "    bool odd = (p.x & 1) != 0;\n"
+    "    vec4 own = vec4(0.0, 0.0, 0.0, 2.0), even = own;\n"
+    /* (Hades: outside the tiles that what is drawn over may reach, nothing is drawn over the
+     * picture; a pair is in the tile of its even pixel) */
+    "    if (has_layer != 0 && tile_drawn != 0) {\n"
+    "        own = texelFetch(drawn, p, 0);\n"
+    "        even = odd ? texelFetch(drawn, ivec2(ex, p.y), 0) : own;\n"
+    "    }\n"
+    "    uint y = own.a != 2.0 ? code(drawn_over(p, own).x) : luma_code(p);\n"
+    "    uint c;\n"
+    "    if (even.a != 2.0) {\n"
+    "        vec3 e = drawn_over(ivec2(ex, p.y), even);\n"
+    "        c = code(odd ? e.z : e.y);\n"
+    "    } else {\n"
+    "        uvec2 cc = pair_chroma(ex, p.y);\n"
+    "        c = odd ? cc.y : cc.x;\n"
+    "    }\n"
+    PACK_END;
+
+/* Hades: 4 for the frames whose pixels drawn over pass 8 converted (pairs_made; the other branch is
+ * that of PACK). A program of its own, so that PACK stays what it was for every other frame, and
+ * where this one or PAIRS cannot be made on a GPU, the packer is made without them, as before. */
+static const char PACK_PAIRS[] =
     "#version 300 es\n"
     COMMON
     DRAWN_OVER
@@ -466,11 +527,7 @@ static const char PACK[] =
     "uniform uint flip_y;\n"
     "flat in int tile_drawn;\n" /* Hades: (TILED_VERTEX) something may be drawn over this tile */
     "out vec4 color;\n"
-    "uint parity(uint v)\n"
-    "{\n"
-    "    v ^= v >> 16u; v ^= v >> 8u; v ^= v >> 4u; v ^= v >> 2u; v ^= v >> 1u;\n"
-    "    return v & 1u;\n"
-    "}\n"
+    PACK_PARITY
     "void main()\n"
     "{\n"
     "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
@@ -507,14 +564,7 @@ static const char PACK[] =
     "        uvec2 cc = pair_chroma(ex, p.y);\n"
     "        c = odd ? cc.y : cc.x;\n"
     "    }\n"
-    "    uint index = uint(p.y * 3840 + p.x), packet = index / 3072u;\n"
-    "    if (packet < packet_count) {\n"
-    "        uint bit = index % 1024u, word = packet * 32u + bit / 32u;\n"
-    "        uint value = (metadata_words[word / 4u][int(word % 4u)] >> (31u - bit % 32u)) & 1u;\n"
-    "        c = (c & 4094u) | (value ^ parity(c >> 1u) ^ parity(y));\n"
-    "    }\n"
-    "    color = vec4(float(c >> 4u), float(y >> 4u), float((y & 15u) | ((c & 15u) << 4u)), 255.0) / 255.0;\n"
-    "}\n";
+    PACK_END;
 
 /* Hades: 8. The pixels drawn over converted back to codes (where decoding is not affine), before
  * pass 4: a fragment for each pair of the raster (fragment x is the pair whose even pixel is 2 x,
@@ -700,6 +750,11 @@ static const char *const COMMON_NAMES[] = {"luma_plane", "chroma_rows", "picture
     "active_rect", "black", "code_scale", "rows_half", "ycc_forward", "lms_forward", "ycc_offset",
     "affine"};
 
+/* the uniforms of pass 4 besides COMMON's (Hades: in either of its forms) */
+struct pack_uniforms {
+    GLint drawn, has_layer, code_max, ycc_inverse, lms_inverse, words, count, flip;
+};
+
 struct dvbridge_source_packer {
     GLuint pack, picture, resite, rows, cover, vao, sampler;
     struct texture resited, chroma, edges;
@@ -726,18 +781,23 @@ struct dvbridge_source_packer {
     bool rows_made;
     int rows_of[8], rows_half;
     struct common_uniforms pc, cc; /* of pass 4 and of pass 3 */
-    struct {
-        GLint drawn, has_layer, code_max, ycc_inverse, lms_inverse, words, count, flip, pairs,
-            pairs_made;
-    } u;
-    /* Hades: pass 8, its uniforms, and the codes that it writes. Where it could not be made, pass 4
-     * converts the pixels drawn over itself, as before. */
-    GLuint pairs_program;
-    struct common_uniforms qc;
+    struct pack_uniforms u;
+    /* Hades: pass 8, its uniforms, the codes that it writes, and the form of pass 4 that takes them
+     * (pack_pairs: its uniforms w, wc and those of w_more). Both programs or neither: where one of
+     * them cannot be made, pass 4 is PACK alone and converts the pixels drawn over itself, as it did
+     * before pass 8. pairs_missed: the last dvbridge_source_pack() would have taken pass 8 and did
+     * not (dvbridge_source_pairs_missed()). */
+    GLuint pairs_program, pack_pairs;
+    struct common_uniforms qc, wc;
     struct {
         GLint drawn, code_max, ycc_inverse, lms_inverse, tiles, mode, flip, apart;
     } q;
+    struct pack_uniforms w;
+    struct {
+        GLint pairs, pairs_made, tiles, mode, flip;
+    } w_more;
     struct texture pairs;
+    bool pairs_missed;
     struct {
         GLint chroma, code_scale, taps, first, last_col, weights;
     } h;
@@ -809,9 +869,11 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     GLint previous = 0;
     glGetIntegerv(GL_CURRENT_PROGRAM, &previous);
     static const char *const pack[] = {"drawn", "has_layer", "code_max", "ycc_inverse",
-        "lms_inverse", "metadata_words", "packet_count", "flip_y", "pairs", "pairs_made"};
+        "lms_inverse", "metadata_words", "packet_count", "flip_y"};
     static const char *const pairs[] = {"drawn", "code_max", "ycc_inverse", "lms_inverse",
         "drawn_tiles", "tiles_mode", "tiles_flip", "apart"};
+    static const char *const pack_pairs[] = {"pairs", "pairs_made", "drawn_tiles", "tiles_mode",
+                                             "tiles_flip"};
     static const char *const resite[] = {"chroma_plane", "code_scale", "taps", "first", "last_col",
                                          "weights"};
     static const char *const rows[] = {"chroma_plane", "chroma_read", "chroma_shift", "taps",
@@ -822,6 +884,7 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     _Static_assert(sizeof(p->h) == COUNT(resite) * sizeof(GLint), "resite uniforms");
     _Static_assert(sizeof(p->v) == COUNT(rows) * sizeof(GLint), "rows uniforms");
     _Static_assert(sizeof(p->q) == COUNT(pairs) * sizeof(GLint), "pairs uniforms");
+    _Static_assert(sizeof(p->w_more) == COUNT(pack_pairs) * sizeof(GLint), "pack_pairs uniforms");
     /* (Hades: passes 3 and 4 over the raster or over its tiles) */
     p->pack = link_with(TILED_VERTEX, PACK);
     p->picture = link_with(TILED_VERTEX, PICTURE);
@@ -866,13 +929,23 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
         dvbridge_source_packer_destroy(p);
         return NULL;
     }
-    /* Hades: pass 8; without it pass 4 converts the pixels drawn over itself (the same codes) */
+    /* Hades: pass 8 and the form of pass 4 that takes its codes, after the rest, which they do not
+     * change: both or neither, so that a GPU that cannot make one of them has the packer it had
+     * before them (said once here; Kodi's log says it of a stream that would take them, through
+     * dvbridge_source_pairs_missed()) */
     p->pairs_program = link_with(TILED_VERTEX, PAIRS);
-    if (p->pairs_program &&
-        (!locate(p->pairs_program, &p->qc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
-         !locate(p->pairs_program, &p->q.drawn, pairs, COUNT(pairs)))) {
+    p->pack_pairs = link_with(TILED_VERTEX, PACK_PAIRS);
+    if (!p->pairs_program || !p->pack_pairs ||
+        !locate(p->pairs_program, &p->qc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+        !locate(p->pairs_program, &p->q.drawn, pairs, COUNT(pairs)) ||
+        !locate(p->pack_pairs, &p->wc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+        !locate(p->pack_pairs, &p->w.drawn, pack, COUNT(pack)) ||
+        !locate(p->pack_pairs, &p->w_more.pairs, pack_pairs, COUNT(pack_pairs))) {
         glDeleteProgram(p->pairs_program);
-        p->pairs_program = 0;
+        glDeleteProgram(p->pack_pairs);
+        p->pairs_program = p->pack_pairs = 0;
+        fprintf(stderr, "DV source transport: the pass that converts the pixels drawn over a "
+                        "profile 5 picture once could not be made; they are converted as before\n");
     }
     glGenVertexArrays(1, &p->vao);
     glGenSamplers(1, &p->sampler);
@@ -914,6 +987,7 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     glDeleteProgram(p->gui_tiles_program);
     glDeleteProgram(p->drawn_program);
     glDeleteProgram(p->pairs_program);
+    glDeleteProgram(p->pack_pairs);
     free(p);
 }
 
@@ -1248,6 +1322,8 @@ bool dvbridge_source_pack(struct dvbridge_source_packer *p,
                           unsigned framebuffer, const uint32_t packets[512], unsigned count,
                           bool flip_y)
 {
+    if (p)
+        p->pairs_missed = false;
     if (!picture_fits(p, params, width, height, x, y, margins) || !luma || !packets || !count ||
         count > 16 || !rows_of(p, width, height, x, y, margins))
         return false;
@@ -1289,28 +1365,38 @@ bool dvbridge_source_pack(struct dvbridge_source_packer *p,
             ;
         glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
     }
+    p->pairs_missed = layer && !params->affine && !pairs;
+    /* Hades: PACK_PAIRS with the codes of pass 8; PACK, as it was, for every other frame */
+    const struct pack_uniforms *u = pairs ? &p->w : &p->u;
     glViewport(0, 0, 3840, 2160);
-    glUseProgram(p->pack);
-    set_common(p, &p->pc, params, luma, width, height, x, y, margins);
+    glUseProgram(pairs ? p->pack_pairs : p->pack);
+    set_common(p, pairs ? &p->wc : &p->pc, params, luma, width, height, x, y, margins);
     bind(p, 2, layer);
-    glUniform1i(p->u.drawn, 2);
-    glUniform1i(p->u.has_layer, layer != 0);
-    bind(p, 4, pairs ? p->pairs.texture : 0);
-    glUniform1i(p->u.pairs, 4);
-    glUniform1i(p->u.pairs_made, pairs);
+    glUniform1i(u->drawn, 2);
+    glUniform1i(u->has_layer, layer != 0);
+    if (pairs) {
+        bind(p, 4, p->pairs.texture);
+        glUniform1i(p->w_more.pairs, 4);
+        glUniform1i(p->w_more.pairs_made, 1);
+    }
     /* Hades: the picture drawn over is read in the tiles that what is drawn over may reach: all the
      * tiles drawn, each knowing whether something may be drawn over it */
     const int how = layer && p->tiles_mode ? 3 : 0;
-    set_tiles(p, p->pc_tiles, p->pc_mode, how);
-    glUniform1i(p->pc_flip, flip_y);
-    set_inverse(p->u.ycc_inverse, p->u.lms_inverse, p->u.code_max, params);
-    glUniform4uiv(p->u.words, 128, packets);
-    glUniform1ui(p->u.count, count);
-    glUniform1ui(p->u.flip, flip_y);
+    set_tiles(p, pairs ? p->w_more.tiles : p->pc_tiles, pairs ? p->w_more.mode : p->pc_mode, how);
+    glUniform1i(pairs ? p->w_more.flip : p->pc_flip, flip_y);
+    set_inverse(u->ycc_inverse, u->lms_inverse, u->code_max, params);
+    glUniform4uiv(u->words, 128, packets);
+    glUniform1ui(u->count, count);
+    glUniform1ui(u->flip, flip_y);
     glDrawArrays(GL_TRIANGLES, 0, tiled_vertices(how));
     return end(&state, true);
 }
 
+bool dvbridge_source_pairs_missed(const struct dvbridge_source_packer *p)
+{
+    return p && p->pairs_missed;
+}
+
 bool dvbridge_source_cover(struct dvbridge_source_packer *p, unsigned layer,
                            const unsigned margins[4], unsigned *edges)
 {
diff --git a/tools/dvbridge/dvbridge_source.h b/tools/dvbridge/dvbridge_source.h
index e9a77f3..5cb8375 100644
--- a/tools/dvbridge/dvbridge_source.h
+++ b/tools/dvbridge/dvbridge_source.h
@@ -147,6 +147,10 @@ bool dvbridge_source_pack(struct dvbridge_source_packer *packer,
                           int height, int x, int y, unsigned layer, const unsigned margins[4],
                           unsigned framebuffer, const uint32_t packets[512], unsigned count,
                           bool flip_y);
+/* Hades: the last dvbridge_source_pack() was of a picture whose decoding is not affine, with
+ * something drawn over it, and its pixels drawn over were not converted by the pass of their own
+ * (it could not be made on this GPU, or not drawn): the transport converted them as before. */
+bool dvbridge_source_pairs_missed(const struct dvbridge_source_packer *packer);
 
 /* The edges of the active picture beyond which something was drawn over a picture of the composed
  * way (layer: its alpha is 2 where nothing was), as a mask: 1 left, 2 right, 4 top, 8 bottom (the
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index b03ea4e..fca3b25 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -779,6 +779,11 @@ void CDVBridgeGLES::LogNotes()
               "DVBridge: the enhancement layer is decoded to {} bits and its RPU is for {}: its "
               "residual is omitted (as when the layer is missing), not added at another scale",
               notes.el_bits, notes.rpu_el_bits);
+  if (notes.pairs_missed)
+    CLog::Log(LOGINFO,
+              "DVBridge: the pixels that the GUI covers in this stream are converted back by the "
