From 75c16126d9a2e1b0652f211885d6b1e5c91b3e3e Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Fri, 2 Oct 2026 15:22:42 +0100
Subject: [PATCH] Break the CAgentController reference cycle on shutdown

CPeripheral::Initialise() gives its CAgentController a shared_ptr to the
peripheral, so the peripheral keeps itself alive. #28438 breaks the cycle
when a device is removed, but CPeripheralBus::Clear() only drops the bus
reference, so at shutdown no peripheral is ever destroyed.

For a CEC adapter this means the destructor never stops libCEC, whose
threads keep calling CecLogMessage() after main() returns and crash in
CLog::IsLogLevelLogged() once the logger has gone.

Release the controller input of each peripheral when the bus is cleared.
This does not go through OnDeviceRemoved(), as the CEC adapter treats that
as the device being unplugged and would skip its standby commands on exit.
---
 xbmc/peripherals/bus/PeripheralBus.cpp  |  9 +++++++--
 xbmc/peripherals/devices/Peripheral.cpp | 11 ++++++-----
 xbmc/peripherals/devices/Peripheral.h   |  5 +++++
 3 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/xbmc/peripherals/bus/PeripheralBus.cpp b/xbmc/peripherals/bus/PeripheralBus.cpp
index 9712076..9e9e7f1 100644
--- a/xbmc/peripherals/bus/PeripheralBus.cpp
+++ b/xbmc/peripherals/bus/PeripheralBus.cpp
@@ -69,9 +69,14 @@ void CPeripheralBus::Clear(void)
     StopThread(true);
   }
 
-  std::unique_lock lock(m_critSection);
+  PeripheralVector peripherals;
+  {
+    std::unique_lock lock(m_critSection);
+    peripherals.swap(m_peripherals);
+  }
 
-  m_peripherals.clear();
+  for (const auto& peripheral : peripherals)
+    peripheral->ReleaseControllerInput();
 }
 
 void CPeripheralBus::UnregisterRemovedDevices(const PeripheralScanResults& results)
diff --git a/xbmc/peripherals/devices/Peripheral.cpp b/xbmc/peripherals/devices/Peripheral.cpp
index 98619dc..f053db7 100644
--- a/xbmc/peripherals/devices/Peripheral.cpp
+++ b/xbmc/peripherals/devices/Peripheral.cpp
@@ -90,11 +90,7 @@ CPeripheral::CPeripheral(CPeripherals& manager,
 
 CPeripheral::~CPeripheral(void)
 {
-  if (m_controllerInput)
-  {
-    m_controllerInput->Deinitialize();
-    m_controllerInput.reset();
-  }
+  ReleaseControllerInput();
 
   PersistSettings(true);
 
@@ -104,6 +100,11 @@ CPeripheral::~CPeripheral(void)
 }
 
 void CPeripheral::OnDeviceRemoved(void)
+{
+  ReleaseControllerInput();
+}
+
+void CPeripheral::ReleaseControllerInput()
 {
   if (m_controllerInput)
   {
diff --git a/xbmc/peripherals/devices/Peripheral.h b/xbmc/peripherals/devices/Peripheral.h
index 3a323cb..52f1b58 100644
--- a/xbmc/peripherals/devices/Peripheral.h
+++ b/xbmc/peripherals/devices/Peripheral.h
@@ -166,6 +166,11 @@ public:
    */
   virtual void OnDeviceRemoved(void);
 
+  /*!
+   * @brief Release the agent controller, which holds a reference to this peripheral.
+   */
+  void ReleaseControllerInput();
+
   /*!
    * @brief Get all subdevices if this device is multifunctional.
    * @param subDevices The subdevices.
