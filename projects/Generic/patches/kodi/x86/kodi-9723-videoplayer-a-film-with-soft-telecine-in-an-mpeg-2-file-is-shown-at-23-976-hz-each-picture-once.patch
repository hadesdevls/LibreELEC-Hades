+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+/*!
+ * \file Mpeg2SoftTelecine.h
+ * \brief (Hades) Tells soft telecine in an MPEG-2 video stream from its picture headers, without
+ *        decoding
+ *
+ * A film on a DVD is usually coded as 23.976 progressive pictures per second, with the flags of
+ * the picture coding extension that make a player show it at 29.97: repeat_first_field on every
+ * second picture, and top_field_first changing so that the fields of the pictures follow each
+ * other in the order top, bottom, top, bottom (the 2:3 pulldown that a DVD player does). Kodi
+ * showed it at 59.94 Hz with that 3:2 cadence. Where the stream is known to be such, each picture
+ * can be shown once, at 23.976 Hz, with the pixels that were decoded and no other change.
+ *
+ * This file reads the flags of the pictures (it needs no decoder) and decides, with no
+ * dependency on Kodi, so that the same file is tested outside of it:
+ * - Mpeg2::ParsePictures() reads the sequence extension and the picture headers of a packet;
+ * - CSoftTelecineDetector puts the pictures of each group of pictures in the order they are shown
+ *   (the temporal reference), and says "film" only when a run of pictures shows the cadence
+ *   exactly. Real video, a hard telecine, a stream of 29.97 progressive pictures without repeated
+ *   fields, and a stream whose flags do not follow the cadence are never "film".
+ */
+
+namespace KODI::MPEG2
+{
+//! \brief What the headers of one coded picture say
+struct PictureFlags
+{
+  int temporalReference = 0; //!< its place in the group of pictures, in display order
+  int codingType = 0; //!< 1 I, 2 P, 3 B
+  int pictureStructure = 3; //!< 3: a frame; 1 and 2: a field
+  bool progressiveFrame = false;
+  bool repeatFirstField = false;
+  bool topFieldFirst = false;
+  bool progressiveSequence = false; //!< of the sequence the picture is in
+  bool hasExtension = false; //!< the picture coding extension was found
+  bool groupStart = false; //!< a group of pictures or a sequence header came before it
+};
+
+/*!
+ * \brief Reads the pictures that a packet of an MPEG-2 video stream holds
+ *
+ * Start codes are looked for in the whole packet: a packet is normally one access unit, and the
+ * stream may be in the container's framing or in one elementary stream; only the start codes
+ * 000001B3 (sequence header), 000001B5 (extension), 000001B8 (group of pictures) and 00000100
+ * (picture) matter here. The sequence extension sets progressive_sequence for the pictures after
+ * it (state kept in \p progressiveSequence); a picture with no picture coding extension
+ * (MPEG-1 video) is returned with hasExtension false.
+ *
+ * \param data the packet
+ * \param size its size
+ * \param progressiveSequence in: the value of the last sequence extension; out: that of the last
+ *        one found in this packet
+ * \param pictures the pictures found are added to this
+ * \return how many pictures were found
+ */
+inline size_t ParsePictures(const uint8_t* data,
+                            size_t size,
+                            bool& progressiveSequence,
+                            std::vector<PictureFlags>& pictures)
+{
+  size_t found = 0;
+  bool groupStart = false;
+  for (size_t i = 0; i + 4 <= size;)
+  {
+    if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1)
+    {
+      ++i;
+      continue;
+    }
+    const uint8_t code = data[i + 3];
+    const uint8_t* p = data + i + 4;
+    const size_t left = size - (i + 4);
+    i += 4;
+    if (code == 0xB3 || code == 0xB8)
+    {
+      groupStart = true;
+    }
+    else if (code == 0x00 && left >= 2)
+    {
+      PictureFlags picture;
+      picture.temporalReference = (p[0] << 2) | (p[1] >> 6);
+      picture.codingType = (p[1] >> 3) & 7;
+      picture.progressiveSequence = progressiveSequence;
+      picture.groupStart = groupStart;
+      groupStart = false;
+      pictures.push_back(picture);
+      ++found;
+    }
+    else if (code == 0xB5 && left >= 1)
+    {
+      const unsigned id = p[0] >> 4;
+      if (id == 1 && left >= 2) // sequence extension: profile and level (8), progressive_sequence
+        progressiveSequence = (p[1] & 0x08) != 0;
+      else if (id == 8 && left >= 5 && !pictures.empty()) // picture coding extension
+      {
+        PictureFlags& picture = pictures.back();
+        picture.hasExtension = true;
+        picture.pictureStructure = p[2] & 0x03;
+        picture.topFieldFirst = (p[3] & 0x80) != 0;
+        picture.repeatFirstField = (p[3] & 0x02) != 0;
+        picture.progressiveFrame = (p[4] & 0x80) != 0;
+      }
+    }
+  }
+  return found;
+}
+
+/*!
+ * \brief Says whether a stream shows the cadence of a film with soft telecine
+ *
+ * Pictures are added in the order they are coded. The detector keeps the ones of the group of
+ * pictures that is being read, and when the group ends puts them in display order (temporal
+ * reference) at the end of a window of the last pictures. A window of 24 pictures (six cycles of
+ * the cadence) is "film" when
+ * - every picture is a progressive frame (progressive_frame, which a field picture and an MPEG-1 picture
+ *   never have) of a sequence that is not progressive (a sequence with progressive_sequence has no
+ *   soft telecine: it repeats whole frames, or is 24p already);
+ * - repeat_first_field is set on every second picture and on no other: it alternates without
+ *   exception;
+ * - the fields follow each other in the order top, bottom, top, bottom across all the pictures
+ *   (the first field of each is the other parity than the last field of the one before it);
+ * - top_field_first changes between the pairs of pictures as the pulldown wants: four pictures
+ *   have fields 3, 2, 3, 2 and the parity of the first field follows from the order above.
+ * (repeat_first_field alternating gives the repeated field to half of the pictures.)
+ *
+ * "Film" starts after the first window that is and ends when a stretch of pictures that is long
+ * enough (about four seconds) has none: a stream that goes from film to something else (credits
+ * in video, a menu) is told so, and one that comes back is film again.
+ */
+class CSoftTelecineDetector
+{
+public:
+  //! \brief What is known of the stream now
+  enum class Verdict
+  {
+    UNKNOWN, //!< not enough pictures yet
+    FILM, //!< soft telecine
+    NOT_FILM, //!< something else
+  };
+
+  static constexpr size_t WINDOW = 24; //!< pictures of a window
+  static constexpr size_t KEEP = 48; //!< pictures kept
+  static constexpr size_t LEAVE_AFTER = 120; //!< pictures without a window that is film, to leave film
+
+  /*!
+   * \brief Add a picture
+   * \return the verdict after it (it can only change when a group of pictures ends)
+   */
+  Verdict Add(const PictureFlags& picture)
+  {
+    if (picture.groupStart && !m_group.empty())
+      CloseGroup();
+    m_group.push_back(picture);
+    return m_verdict;
+  }
+
+  //! \brief The pictures of the group that is open count too (at the end of the stream, or to
+  //!        decide with what has been read)
+  Verdict Finish()
+  {
+    CloseGroup();
+    return m_verdict;
+  }
+
+  Verdict GetVerdict() const { return m_verdict; }
+
+  //! \brief Pictures added so far
+  size_t Count() const { return m_count; }
+
+  //! \brief Forget everything (a seek, a new stream)
+  void Reset() { *this = CSoftTelecineDetector(); }
+
+  /*!
+   * \brief Is a run of pictures, in display order, the cadence of soft telecine
+   *        (the test that the windows get)
+   */
+  static bool IsCadence(const std::vector<PictureFlags>& run)
+  {
+    if (run.size() < WINDOW)
+      return false;
+    for (size_t i = 0; i < run.size(); ++i)
+    {
+      const PictureFlags& p = run[i];
+      // (a field picture and a picture with no extension, MPEG-1 video, are not progressive frames)
+      if (p.progressiveSequence || !p.progressiveFrame)
+        return false;
+      if (i > 0)
+      {
+        const PictureFlags& before = run[i - 1];
+        // repeat_first_field alternates
+        if (p.repeatFirstField == before.repeatFirstField)
+          return false;
+        // the parity of the first field is the other one than the parity of the last field
+        // of the picture before (3 fields: the last is the parity of its first; 2: the other)
+        const bool lastTop = before.repeatFirstField ? before.topFieldFirst : !before.topFieldFirst;
+        if (p.topFieldFirst == lastTop)
+          return false;
+      }
+    }
+    return true;
+  }
+
+private:
+  void CloseGroup()
+  {
+    if (m_group.empty())
+      return;
+    std::stable_sort(m_group.begin(), m_group.end(), [](const PictureFlags& a, const PictureFlags& b)
+                     { return a.temporalReference < b.temporalReference; });
+    for (const PictureFlags& p : m_group)
+    {
+      m_ordered.push_back(p);
+      ++m_count;
+      ++m_sinceFilm;
+    }
+    while (m_ordered.size() > KEEP)
+      m_ordered.pop_front();
+    m_group.clear();
+
+    if (m_ordered.size() >= WINDOW)
+    {
+      // the window is the last WINDOW pictures that were added
+      const std::vector<PictureFlags> window(m_ordered.end() - WINDOW, m_ordered.end());
+      if (IsCadence(window))
+      {
+        m_verdict = Verdict::FILM;
+        m_sinceFilm = 0;
+      }
+      else if (m_verdict == Verdict::FILM)
+      {
+        if (m_sinceFilm >= LEAVE_AFTER)
+          m_verdict = Verdict::NOT_FILM;
+      }
+      else
+        m_verdict = Verdict::NOT_FILM;
+    }
+  }
+
+  std::vector<PictureFlags> m_group; //!< the open group, in coding order
+  std::deque<PictureFlags> m_ordered; //!< the pictures of closed groups, in display order
+  Verdict m_verdict = Verdict::UNKNOWN;
+  size_t m_count = 0;
+  size_t m_sinceFilm = 0;
+};
+} // namespace KODI::MPEG2
