diff --git a/xbmc/cores/VideoPlayer/FilmTimer.h b/xbmc/cores/VideoPlayer/FilmTimer.h
new file mode 100644
index 0000000..bbbe2d1
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/FilmTimer.h
@@ -0,0 +1,62 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace KODI::VIDEOPLAYER
+{
+/*!
+ * \brief (Hades) The times at which the pictures of a soft telecined film are shown
+ *
+ * A film with soft telecine (CSoftTelecineDetector) has its pictures 33.4 and 50.1 ms apart in
+ * the times of the stream, because its fields are counted 3, 2, 3, 2 at 59.94 per second: the
+ * pictures are 41.7 ms apart (1001/24000 s) on average, and 8.3 ms early or on time. Shown at
+ * 23.976 Hz that unevenness makes a picture come a refresh too early, and the one before it
+ * not at all. Each picture is therefore shown at the n-th of the times that are 1001/24000 s
+ * apart from the first, as long as the time of the stream stays near it; if it does not (the
+ * stream jumps, or it does not run at the pace of the film) the times start again from the
+ * time of the stream. The pictures are the ones that were decoded; only when each is shown is
+ * made even.
+ */
+class CFilmTimer
+{
+public:
+  static constexpr double DURATION = 1000000.0 * 1001.0 / 24000.0; //!< of a film picture, in DVD_TIME_BASE units
+  static constexpr double TOLERANCE = 25000.0; //!< how far the time of the stream may be from the pace
+
+  void Reset() { m_anchored = false; }
+
+  /*!
+   * \brief The time of the next film picture
+   * \param pts the time of the picture in the stream, or the running guess (the end of the picture
+   *        before it) where the picture has none
+   * \param hasTimestamp whether the picture has a time of its own
+   */
+  double Next(double pts, bool hasTimestamp)
+  {
+    if (m_anchored && hasTimestamp &&
+        std::fabs(pts - (m_anchor + static_cast<double>(m_count) * DURATION)) > TOLERANCE)
+      m_anchored = false;
+    if (!m_anchored)
+    {
+      m_anchor = pts;
+      m_count = 0;
+      m_anchored = true;
+    }
+    return m_anchor + static_cast<double>(m_count++) * DURATION;
+  }
+
+private:
+  bool m_anchored = false;
+  double m_anchor = 0.0;
+  int64_t m_count = 0;
+};
+} // namespace KODI::VIDEOPLAYER
