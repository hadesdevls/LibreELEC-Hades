+}
+
+// Hades: a film on a DVD or from one is MPEG-2 with soft telecine: pictures coded at 23.976 per second
+// that carry the flags to be shown at 29.97 (repeat_first_field on every second one). Kodi showed
+// each at 59.94 Hz with the 3:2 cadence. Whether a stream is such is in the flags of its first
+// pictures, which are read here without decoding, before the streams are given to the player: it
+// then picks 23.976 Hz once, for the whole file, and shows each picture once. Only a file that is
+// read from its start by a plain input: a disc has its navigation run inside the reading, a stream
+// that is live must not be read ahead, and what is not MPEG-2 video has no such flags.
+void CDVDDemuxFFmpeg::PrefetchForSoftTelecine()
+{
+  using namespace KODI::MPEG2;
+  static constexpr size_t MAX_PACKETS = 600;
+  static constexpr size_t MAX_BYTES = 4 * 1024 * 1024;
+  static constexpr auto MAX_TIME = std::chrono::milliseconds(1500);
+
+  if (!m_pFormatContext || !m_pInput || !m_pInput->IsStreamType(DVDSTREAM_TYPE_FILE) ||
+      m_pInput->IsRealtime() || m_checkTransportStream || !m_prefetched.empty())
+    return;
+
+  int index = -1;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVStream* st = m_pFormatContext->streams[i];
+    if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
+        st->codecpar->codec_id == AV_CODEC_ID_MPEG2VIDEO &&
+        !(st->disposition & AV_DISPOSITION_ATTACHED_PIC))
+    {
+      index = static_cast<int>(i);
+      break;
+    }
+  }
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(GetStream(index));
+  if (index < 0 || !video)
+    return;
+
+  CSoftTelecineDetector detector;
+  bool progressiveSequence = false;
+  std::vector<PictureFlags> pictures;
+  size_t bytes = 0;
+  const auto begin = std::chrono::steady_clock::now();
+  m_timeout.Set(2s);
+  while (m_prefetched.size() < MAX_PACKETS && bytes < MAX_BYTES &&
+         std::chrono::steady_clock::now() - begin < MAX_TIME)
+  {
+    AVPacket* packet = av_packet_alloc();
+    if (!packet)
+      break;
+    if (av_read_frame(m_pFormatContext, packet) < 0)
+    {
+      av_packet_free(&packet);
+      break;
+    }
+    bytes += static_cast<size_t>(std::max(packet->size, 0));
+    m_prefetched.push_back(packet);
+    if (packet->stream_index != index)
+      continue;
+    pictures.clear();
+    ParsePictures(packet->data, static_cast<size_t>(packet->size), progressiveSequence, pictures);
+    CSoftTelecineDetector::Verdict verdict = detector.GetVerdict();
+    for (const PictureFlags& picture : pictures)
+      verdict = detector.Add(picture);
+    if (verdict != CSoftTelecineDetector::Verdict::UNKNOWN)
+      break;
+  }
+  m_timeout.SetInfinite();
+  const CSoftTelecineDetector::Verdict verdict = detector.Finish();
+
+  if (verdict == CSoftTelecineDetector::Verdict::FILM)
+  {
+    video->iFpsRate = 24000;
+    video->iFpsScale = 1001;
+    video->interlaced = false;
+    video->softTelecine = true;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} is MPEG-2 video with soft telecine (the pictures of a "
+              "film at 23.976 that carry the flags to be shown at 29.97, as seen in its first {} "
+              "pictures): each is shown once, at the pace of the film",
+              index, detector.Count());
+  }
+  else
+  {
+    CLog::Log(LOGDEBUG,
+              "CDVDDemuxFFmpeg: stream {} is MPEG-2 video that does not show soft telecine in its "
+              "first {} pictures: shown as the stream says",
+              index, detector.Count());
+  }
+}
+
 int CDVDDemuxFFmpeg::ReadFrame(AVPacket* packet)
 {
+  // Hades: the packets that were read ahead (PrefetchForSoftTelecine()) come first, as read
+  if (!m_prefetched.empty())
+  {
+    AVPacket* ahead = m_prefetched.front();
+    m_prefetched.pop_front();
+    av_packet_move_ref(packet, ahead);
+    av_packet_free(&ahead);
+    return 0;
+  }
+
 #ifdef HAVE_DVBRIDGE
   if (m_dvBaseIndex >= 0)
   {
@@ -2352,6 +2463,7 @@ bool CDVDDemuxFFmpeg::SeekTime(double time, bool backwards, double* startpts)
 
   m_pkt.result = -1;
   av_packet_unref(&m_pkt.pkt);
+  ClearPrefetched();
 #ifdef HAVE_DVBRIDGE
   m_dvMerge.Clear();
 #endif
