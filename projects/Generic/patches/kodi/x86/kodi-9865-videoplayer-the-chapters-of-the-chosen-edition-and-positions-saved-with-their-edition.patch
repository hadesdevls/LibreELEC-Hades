+std::optional<std::chrono::milliseconds> CVideoPlayer::EditionSavedPosition(
+    const std::string& state, std::chrono::milliseconds saved)
+{
+  // Hades: Kodi restores a saved position with the cuts of this session; a position saved with
+  // another edition of the file (or with none) is placed in the file with the cuts it was saved
+  // with. Nothing for a state that is not an edition, for a file without editions to choose from,
+  // and for the same edition (the cuts that saved it are the ones in the list).
+  const auto tag = MKV_EDITIONS::ParseStateTag(state);
+  if (!tag || m_editionStateTag.empty() || state == m_editionStateTag)
+    return std::nullopt;
+  const auto* ffmpeg = dynamic_cast<CDVDDemuxFFmpeg*>(m_pDemuxer.get());
+  if (!ffmpeg)
+    return std::nullopt;
+  std::vector<MKV_EDITIONS::Cut> other;
+  for (const EDL::Edit& edit : m_Edl.GetRawEditList())
+    if (edit.action == EDL::Action::CUT &&
+        std::ranges::none_of(m_editionCuts, [&edit](const EDL::Edit& e)
+                             { return e.start == edit.start && e.end == edit.end; }))
+      other.push_back({edit.start.count(), edit.end.count()});
+  const auto fileTime = MKV_EDITIONS::FileTimeOfSaved(ffmpeg->GetMatroskaEditions(), *tag, other,
+                                                      saved.count(), m_pDemuxer->GetStreamLength());
+  if (!fileTime)
+  {
+    CLog::Log(LOGINFO,
+              "MKV editions: a position saved with {} cannot be placed in this file: from the start",
+              state);
+    return 0ms;
+  }
+  CLog::Log(LOGINFO, "MKV editions: a position saved with {} at {} is at {} of the file", state,
+            MKV_EDITIONS::FormatMs(saved.count()), MKV_EDITIONS::FormatMs(*fileTime));
+  return std::chrono::milliseconds(*fileTime);
+}
