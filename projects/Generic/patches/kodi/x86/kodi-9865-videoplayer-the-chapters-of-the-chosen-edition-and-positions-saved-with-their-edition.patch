+// --- the chapters of an edition
+
+struct ChapterMark
+{
+  std::string name;
+  int64_t startMs;
+  int64_t endMs;
+};
+
+// The chapters Kodi lists for an edition, in file time (Kodi maps them to the time of the edition
+// with its cuts): its enabled chapters that are not hidden and have a start, by start; the end is
+// the chapter's own, else where the next one starts, else the end of the file.
+inline std::vector<ChapterMark> EditionChapters(const File& file, size_t index, int64_t fileDurationMs)
+{
+  using namespace DETAIL;
+  std::vector<ChapterMark> out;
+  if (index >= file.editions.size())
+    return out;
+  std::vector<const Chapter*> list;
+  for (const Chapter& ch : file.editions[index].chapters)
+    if (ch.enabled && !ch.hidden && ch.startNs >= 0)
+      list.push_back(&ch);
+  std::stable_sort(list.begin(), list.end(),
+                   [](const Chapter* a, const Chapter* b) { return a->startNs < b->startNs; });
+  for (size_t i = 0; i < list.size(); i++)
+  {
+    int64_t end = list[i]->endNs > list[i]->startNs ? NsToMs(list[i]->endNs)
+                  : i + 1 < list.size()              ? NsToMs(list[i + 1]->startNs)
+                                                     : std::max<int64_t>(fileDurationMs, 0);
+    out.push_back({list[i]->title, NsToMs(list[i]->startNs), end});
+  }
+  return out;
+}
+
+// --- positions saved while an edition played (resume point, bookmarks)
+//
+// Kodi saves a position in the time of what plays (the file without its cuts) and restores it with
+// the cuts of the session that restores it. With editions those can differ, so the edition a
+// position was saved with goes with it, in the player state that Kodi already saves with resume
+// points and bookmarks (no new database field): "<hadesmkvedition>UID</hadesmkvedition>", or "none"
+// for a file with editions played as it is stored.
+
+struct Saved
+{
+  bool chosen = false;
+  uint64_t uid = 0;
+};
+
+constexpr const char* STATE_OPEN = "<hadesmkvedition>";
+constexpr const char* STATE_CLOSE = "</hadesmkvedition>";
+
+inline std::string StateTag(const Saved& s)
+{
+  return std::string(STATE_OPEN) + (s.chosen ? std::to_string(s.uid) : std::string("none")) + STATE_CLOSE;
+}
+
+// The whole state must be the tag (a state of another player, a disc or a stack is not ours).
+inline std::optional<Saved> ParseStateTag(const std::string& state)
+{
+  const std::string open(STATE_OPEN), close(STATE_CLOSE);
+  if (state.size() <= open.size() + close.size() || state.compare(0, open.size(), open) != 0 ||
+      state.compare(state.size() - close.size(), close.size(), close) != 0)
+    return std::nullopt;
+  const std::string v = state.substr(open.size(), state.size() - open.size() - close.size());
+  Saved s;
+  if (v == "none")
+    return s;
+  if (!DETAIL::ToU64(v.c_str(), s.uid))
+    return std::nullopt;
+  s.chosen = true;
+  return s;
+}
+
+// The same arithmetic as CEdl::GetTimeWithoutCuts() and CEdl::GetTimeAfterRestoringCuts(), for cuts
+// in ascending order that do not overlap.
+inline int64_t RemoveCuts(const std::vector<Cut>& cuts, int64_t t)
+{
+  int64_t cut = 0;
+  for (const Cut& c : cuts)
+  {
+    if (t >= c.startMs && t < c.endMs)
+      cut += t - c.startMs - 1;
+    else if (t >= c.startMs)
+      cut += c.endMs - c.startMs;
+  }
+  return t - cut;
+}
+
+inline int64_t RestoreCuts(const std::vector<Cut>& cuts, int64_t t)
+{
+  for (const Cut& c : cuts)
+    if (t > c.startMs + 1)
+      t += c.endMs - c.startMs;
+  return t;
+}
+
+// Where in the file a position saved with `saved` is. otherCuts: the cuts that do not come from an
+// edition (edit decision list files), which were there when it was saved too. Nothing when that
+// edition is not in this file or cannot be played: the position cannot be placed.
+inline std::optional<int64_t> FileTimeOfSaved(const File& file,
+                                              const Saved& saved,
+                                              std::vector<Cut> otherCuts,
+                                              int64_t savedMs,
+                                              int64_t fileDurationMs)
+{
+  if (saved.chosen)
+  {
+    size_t i = 0;
+    while (i < file.editions.size() && file.editions[i].uid != saved.uid)
+      i++;
+    const Plan plan = PlanEdition(file, i, fileDurationMs); // not in the file: not offered
+    if (!plan.offered)
+      return std::nullopt;
+    otherCuts.insert(otherCuts.end(), plan.cuts.begin(), plan.cuts.end());
+  }
+  std::sort(otherCuts.begin(), otherCuts.end(),
+            [](const Cut& a, const Cut& b) { return a.startMs < b.startMs; });
+  return RestoreCuts(otherCuts, savedMs);
+}
+
 } // namespace MKV_EDITIONS
