From 460b7d69621b43c56ad8db18473aefdb648790d0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:16:14 +0000
Subject: [PATCH] dvbridge: native Dolby Vision on a dual-mode DisplayPort
 connector of NVIDIA

The HDMI port of an HP ZBook 17 G6 (Quadro RTX 4000) is a dual-mode
DisplayPort port of the card: nvidia-drm calls it DP-2, and the NVIDIA
backend was refused there ("the display is on a connector that the driver
calls DisplayPort"), although the card drives the TV as HDMI itself (two
encoders on the connector; the audio ELD says HDMI with Supports_AI, which
NVKMS writes only for a TMDS output).

With nvidia-open-kernel-modules-9010 and 9011, such a connector has the HDMI
properties of the driver ("max bpc", NV_HDMI_VSIF_METADATA), NVKMS sends the
vendor InfoFrame through its TMDS output, and NV_DUAL_MODE_TMDS, read-only,
says 1 while the display is driven through that output. Take the NVIDIA
backend on such a connector only while NV_DUAL_MODE_TMDS reads 1 from the
kernel (NvidiaDualMode.h, pure): a DisplayPort connector without the
property (an older driver), with 0 (a DisplayPort display, or an active
converter, which is not known to pass the tunnel bit for bit), or whose value
cannot be read, is refused as before. HDMI connectors are not changed.

The log says it when native output is available that way: "available with
the NVIDIA backend, on a dual-mode DisplayPort connector that the graphics
card drives as HDMI (NV_DUAL_MODE_TMDS is 1)".
---
 xbmc/windowing/gbm/WinSystemGbm.cpp      |  7 ++++-
 xbmc/windowing/gbm/drm/DVBridgeState.cpp | 11 ++++++-
 xbmc/windowing/gbm/drm/NvidiaDualMode.h  | 39 ++++++++++++++++++++++++
 3 files changed, 55 insertions(+), 2 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/NvidiaDualMode.h

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 2e52c21..3f86a16 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1203,7 +1203,12 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
       reason ? std::string("unavailable: ") + reason
              : std::string("available with the ") +
                    (backend == CDVBridgeState::Backend::NVIDIA ? "NVIDIA" : "kernel property") +
-                   " backend";
+                   " backend" +
+                   // Hades: the TMDS output of a dual-mode DP connector (NvidiaDualMode.h)
+                   (backend == CDVBridgeState::Backend::NVIDIA && connector->GetType() == "DP"
+                        ? ", on a dual-mode DisplayPort connector that the graphics card drives "
+                          "as HDMI (NV_DUAL_MODE_TMDS is 1)"
+                        : "");
   {
     std::unique_lock lock(m_dvOutputStatusLock);
     m_dvOutputReason = code;
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index b29fc6a..3c3b39c 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: GPL-3.0-or-later */
 #include "DVBridgeState.h"
+
+#include "NvidiaDualMode.h"
 #include "DRMAtomic.h"
 #include "DRMConnector.h"
 
@@ -24,7 +26,14 @@ CDVBridgeState::Backend CDVBridgeState::GetBackend(CDRMConnector& connector)
 {
   if (connector.SupportsProperty("DVBRIDGE_DV_STANDARD_LAB"))
     return Backend::KERNEL;
-  if (connector.GetType() == "HDMI-A" && connector.SupportsProperty("NV_HDMI_VSIF_METADATA") &&
+  // Hades: an HDMI connector, or a dual-mode DisplayPort one that the card drives as HDMI now
+  // (NvidiaDualMode.h): its value is read from the kernel, which sets it on detection
+  const std::string type = connector.GetType();
+  const auto dualMode = type == "DP" && connector.SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY)
+                            ? connector.ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY)
+                            : std::nullopt;
+  if (NVIDIA_DUAL_MODE::DrivenAsHdmi(type, dualMode) &&
+      connector.SupportsProperty("NV_HDMI_VSIF_METADATA") &&
       connector.SupportsProperty("max bpc") && connector.SupportsProperty("dithering mode"))
     return Backend::NVIDIA;
   return Backend::NONE;
diff --git a/xbmc/windowing/gbm/drm/NvidiaDualMode.h b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
new file mode 100644
index 0000000..ae9e7af
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
@@ -0,0 +1,39 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+/*
+ * Hades: nvidia-drm names a connector after the port of the card. A DisplayPort port of the board
+ * can be a dual-mode one that the card drives as HDMI itself, through a level shifter: the HDMI
+ * port of an HP ZBook 17 G6 (Quadro RTX 4000) is DP-2. With nvidia-open-kernel-modules-9011 such a
+ * connector has the HDMI properties of the driver ("max bpc", NV_HDMI_VSIF_METADATA) and
+ * NV_DUAL_MODE_TMDS, read-only, which the kernel sets on detection: 1 while the display there is
+ * driven through the TMDS output of the card (the card sends HDMI, bit for bit as on an HDMI
+ * connector), 0 while it is driven through the DisplayPort output (a DisplayPort display, or an
+ * active converter, which is not known to pass the tunnel bit for bit) or there is none.
+ * Pure: a test builds it on the host.
+ */
+namespace NVIDIA_DUAL_MODE
+{
+constexpr const char* PROPERTY = "NV_DUAL_MODE_TMDS";
+
+//! Whether the card drives the display of the connector as HDMI itself: an HDMI connector, or a
+//! DisplayPort one whose NV_DUAL_MODE_TMDS is 1 now. A DisplayPort connector without the property
+//! (a driver without the patch), with another value, or whose value could not be read, is not.
+inline bool DrivenAsHdmi(std::string_view type, std::optional<uint64_t> dualModeTmds)
+{
+  if (type == "HDMI-A")
+    return true;
+  return type == "DP" && dualModeTmds.has_value() && *dualModeTmds == 1;
+}
+} // namespace NVIDIA_DUAL_MODE
