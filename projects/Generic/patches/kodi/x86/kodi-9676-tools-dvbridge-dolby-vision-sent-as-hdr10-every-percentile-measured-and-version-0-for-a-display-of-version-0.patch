From 3fa3994d5a946c9d54b7a321ee3c28d0fbdce7e4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:24:06 +0000
Subject: [PATCH] tools/dvbridge: Dolby Vision sent as HDR10+, every percentile
 measured, and version 0 for a display of version 0

Until now the places of 5 and 10 % of version 1 carried 0 and 0.00255,
Hades' reading of ST 2094-40 8.5.4. No source at hand confirms it, and
no HDR10+ metadata seen carry it: FFmpeg's FATE has 2940 and 255 there,
hdr10plus_tool's samples 14024 and 43, 6080 and 92, and the InfoFrames
of a licensed player measured on three films of version 1 (cinema-ONE,
issue 64 of CroqueMr's fork) carry a distribution that never decreases,
with 78 to 100 in the place of 10 %. Every place now carries its
percentile, measured from the same histogram as the others: the
distribution never decreases, and the place of 10 % goes in the
InfoFrame as it is coded in version 1 (MakeVsif()), that is the
percentile in units of 0.1 cd/m2, 255 at most. The targeted system
display maximum luminance stays 0 without a curve, as licensed films
have it (hdr10plus_tool rejects a profile A with another one).

dvbridge_dvplus_metadata_version(): the same statistics as metadata of
application version 0, for a display that declares version 0
(HDR10PlusOutputVersion()), which is now offered Dolby Vision sent as
HDR10+; 1 for every other.

dvbridge_dvplus_provisional(): statistics from the level 1 block of a
picture's RPU alone, for a commit that must carry HDR10+ before any
measurement can exist (the next commit uses it on i915).
---
 tools/dvbridge/dvbridge_dvplus.c              | 36 ++++++++++++++++---
 tools/dvbridge/dvbridge_dvplus.h              | 28 +++++++++++----
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 10 ++++--
 3 files changed, 59 insertions(+), 15 deletions(-)

diff --git a/tools/dvbridge/dvbridge_dvplus.c b/tools/dvbridge/dvbridge_dvplus.c
index 00b7935..d656ee9 100644
--- a/tools/dvbridge/dvbridge_dvplus.c
+++ b/tools/dvbridge/dvbridge_dvplus.c
@@ -15,8 +15,8 @@
 #include <string.h>
 
 const uint8_t dvbridge_dvplus_percentages[DVBRIDGE_DVPLUS_PLACES] = {1, 5, 10, 25, 50, 75, 90, 95, 99};
-/* the quantile of each place (the one at 99 made at 99.98 percent); 5 and 10 are not measured */
-static const double QUANTILES[DVBRIDGE_DVPLUS_PLACES] = {0.01, 0, 0, 0.25, 0.50, 0.75, 0.90, 0.95, 0.9998};
+/* the quantile of each place (the one at 99 made at 99.98 percent) */
+static const double QUANTILES[DVBRIDGE_DVPLUS_PLACES] = {0.01, 0.05, 0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.9998};
 
 /* (measured, dvbridge_dvplus.h: of the steps tried, 32 in PQ with no step in codes moved what is sent least for what
  * it costs against the ideal; and 24 measured pictures between two changes within a scene, unless a value moves by more
@@ -110,8 +110,6 @@ void dvbridge_dvplus_stats_of(const uint64_t *hist, unsigned bins, uint64_t coun
         frac = frac < 0 ? 0 : frac > 1 ? 1 : frac;
         stats->percentiles[i] = units(dvbridge_dvplus_nits((b + frac) / bins));
     }
-    stats->percentiles[1] = DVBRIDGE_DVPLUS_AT_5;
-    stats->percentiles[2] = DVBRIDGE_DVPLUS_AT_10;
     unsigned top = bins;
     while (top-- > 0 && !hist[top])
         ;
@@ -382,10 +380,15 @@ bool dvbridge_dvplus_measured(struct dvbridge_dvplus *m, const struct dvbridge_d
 }
 
 void dvbridge_dvplus_metadata(const struct dvbridge_dvplus_stats *s, AVDynamicHDRPlus *out)
+{
+    dvbridge_dvplus_metadata_version(s, 1, out);
+}
+
+void dvbridge_dvplus_metadata_version(const struct dvbridge_dvplus_stats *s, int version, AVDynamicHDRPlus *out)
 {
     memset(out, 0, sizeof(*out));
     out->itu_t_t35_country_code = 0xB5;
-    out->application_version = 1;
+    out->application_version = version == 0 ? 0 : 1;
     out->num_windows = 1;
     out->targeted_system_display_maximum_luminance = (AVRational){0, 1};
     AVHDRPlusColorTransformParams *w = &out->params[0];
@@ -402,6 +405,29 @@ void dvbridge_dvplus_metadata(const struct dvbridge_dvplus_stats *s, AVDynamicHD
     w->color_saturation_mapping_flag = 0;
 }
 
+bool dvbridge_dvplus_provisional(const struct dvbridge_dvplus_rpu *rpu, struct dvbridge_dvplus_stats *stats)
+{
+    if (stats)
+        memset(stats, 0, sizeof(*stats));
+    if (!rpu || !rpu->level1 || !stats)
+        return false;
+    double mn = rpu->min_pq / 4095.0, av = rpu->avg_pq / 4095.0, mx = rpu->max_pq / 4095.0;
+    /* (a block out of order is put in order: the function never decreases) */
+    av = av < mn ? mn : av;
+    mx = mx < av ? av : mx;
+#define DVPLUS_L1_Q(p) ((p) <= 0.5 ? mn + (av - mn) * (p) / 0.5 : av + (mx - av) * ((p)-0.5) / 0.5)
+    double sum = 0;
+    const int n = 4000;
+    for (int i = 0; i < n; ++i)
+        sum += dvbridge_dvplus_nits(DVPLUS_L1_Q((i + 0.5) / n));
+    stats->average = units(sum / n);
+    for (unsigned i = 0; i < DVBRIDGE_DVPLUS_PLACES; ++i)
+        stats->percentiles[i] = units(dvbridge_dvplus_nits(DVPLUS_L1_Q(QUANTILES[i])));
+    stats->maxrgb = units(dvbridge_dvplus_nits(mx));
+#undef DVPLUS_L1_Q
+    return true;
+}
+
 bool dvbridge_dvplus_present_again(struct dvbridge_dvplus *m, double pts, struct dvbridge_dvplus_stats *stats)
 {
     if (!m || !m->presented || pts != m->last_pts || !m->have || m->unmeasured > m->params.lost)
diff --git a/tools/dvbridge/dvbridge_dvplus.h b/tools/dvbridge/dvbridge_dvplus.h
index c0e99ab..b2eb12f 100644
--- a/tools/dvbridge/dvbridge_dvplus.h
+++ b/tools/dvbridge/dvbridge_dvplus.h
@@ -54,14 +54,16 @@ extern "C" {
 #define DVBRIDGE_DVPLUS_BINS 4096
 /* The nine places of the distribution of maxRGB, as the InfoFrame carries them (KODI::UTILS::HDR10PLUS::
  * VSIF_PERCENTAGES): 1, 5, 10, 25, 50, 75, 90, 95 and 99 percent, the last one made at 99.98 percent (ST 2094-40
- * 8.5.3, as dvbridge_hdr10plus.h reads it). In application version 1 the entries at 5 and 10 percent are no
- * percentiles: they carry 0 and 0.00255 (ST 2094-40 8.5.4, as dvbridge_hdr10plus.h reads it; the fork of CroqueMr
- * reads it the same way). Not verified: the specification is not read, and the HDR10+ metadata that FFmpeg's FATE
- * and hdr10plus_tool test with carry 255 (FATE) or other values at 10 percent and a value close to the peak at 5. */
+ * 8.5.3, as dvbridge_hdr10plus.h reads it). Every place carries its percentile, measured, in application version 1
+ * as in 0: what a licensed player sends with films of version 1 (cinema-ONE, three films measured on its HDMI
+ * output: a distribution that never decreases, 78 to 100 in the place of 10 percent, which in version 1 goes as it
+ * is coded: KODI::UTILS::HDR10PLUS::MakeVsif()). Until 1.0 RC4 Hades put 0 and 0.00255 in the places of 5 and 10
+ * percent of version 1, its reading of ST 2094-40 8.5.4 (as the fork of CroqueMr reads it); no source at hand
+ * confirms it (the specification is not here), and no HDR10+ metadata seen carry it: FFmpeg's FATE has 2940 and
+ * 255, hdr10plus_tool's samples 14024 and 43, 6080 and 92 (a value near the peak at 5 percent, a small one at
+ * 10), the licensed player's films percentiles. */
 #define DVBRIDGE_DVPLUS_PLACES 9
 extern const uint8_t dvbridge_dvplus_percentages[DVBRIDGE_DVPLUS_PLACES];
-#define DVBRIDGE_DVPLUS_AT_5 0     /* 1/100000 */
-#define DVBRIDGE_DVPLUS_AT_10 255  /* 1/100000 */
 
 /* What is measured of one picture: the maxRGB of each of its samples */
 struct dvbridge_dvplus_picture {
@@ -74,7 +76,7 @@ struct dvbridge_dvplus_picture {
 /* The luminance parameters sent with a picture, in the units of ST 2094-40 (1/100000 of 10000 cd/m2: 0.1 cd/m2) */
 struct dvbridge_dvplus_stats {
     unsigned average;                             /* average_maxrgb */
-    unsigned percentiles[DVBRIDGE_DVPLUS_PLACES]; /* at dvbridge_dvplus_percentages (5 and 10: see above) */
+    unsigned percentiles[DVBRIDGE_DVPLUS_PLACES]; /* at dvbridge_dvplus_percentages, each measured */
     unsigned maxrgb; /* the highest maxRGB sampled; the InfoFrame does not carry MaxSCL, this is for the log */
 };
 
@@ -149,6 +151,18 @@ bool dvbridge_dvplus_sent(const struct dvbridge_dvplus *m, struct dvbridge_dvplu
  * 0 (not measured; nor carried) */
 struct AVDynamicHDRPlus;
 void dvbridge_dvplus_metadata(const struct dvbridge_dvplus_stats *stats, struct AVDynamicHDRPlus *out);
+/* ... of application version 0 or 1 (another is taken as 1): the one a display of version 0 takes, 1 for one of
+ * version 1 or later (CWinSystemGbm::HDR10PlusOutputVersion()). The statistics are the same in both: every place a
+ * percentile; what differs is how the InfoFrame codes the place of 10 percent (MakeVsif()). */
+void dvbridge_dvplus_metadata_version(const struct dvbridge_dvplus_stats *stats, int version,
+                                      struct AVDynamicHDRPlus *out);
+
+/* Provisional statistics of a picture not measured yet, from the level 1 block of its RPU alone (false without one):
+ * the quantile function linear in PQ from min_pq through avg_pq at the median to max_pq, the average of maxRGB of
+ * that function, its peak max_pq. Far from what the picture holds (29 codes of the InfoFrame on average against 2.9
+ * measured, in the bench of RC4), so used only where HDR10+ must be in a commit before any measurement can be
+ * (CWinSystemGbmGLESContext::DVPlusModeStart(): i915 at 2160p24, 25 and 30), and replaced by the first measurement. */
+bool dvbridge_dvplus_provisional(const struct dvbridge_dvplus_rpu *rpu, struct dvbridge_dvplus_stats *stats);
 
 /* The statistics of a histogram, as the module makes them (for the tests): hist of bins entries over [0, 1] in PQ,
  * count samples, sum of their maxRGB in cd/m2 */
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 66ff929..ba1f250 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2205,7 +2205,10 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
         CLog::Log(LOGINFO,
                   "DVBridge: Dolby Vision rebuilt as HDR10 goes out as HDR10+: dynamic metadata "
                   "measured from the rebuilt picture, per scene of its Dolby Vision metadata "
-                  "(application version 1, the luminance parameters, no tone mapping curve)");
+                  "(application version {}, the one the display declares; the luminance "
+                  "parameters, every percentile measured; no tone mapping curve, no targeted "
+                  "display luminance)",
+                  std::max(HDR10PlusOutputVersion(), 0));
     }
   }
   if (m_dvPlusOn != 1 || pts == DVD_NOPTS_VALUE)
@@ -2245,7 +2248,8 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
     return std::nullopt;
   }
   AVDynamicHDRPlus made{};
-  dvbridge_dvplus_metadata(&stats, &made);
+  // (Hades: of the application version that the display takes, 0 or 1)
+  dvbridge_dvplus_metadata_version(&stats, HDR10PlusOutputVersion(), &made);
   const char* refused = nullptr;
   std::optional<std::array<uint8_t, 27>> payload = KODI::UTILS::HDR10PLUS::MakeVsif(made, &refused);
   if (!payload)
@@ -2330,7 +2334,7 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
   if (!dvbridge_dvplus_present_again(m_dvPlus.get(), layer.pts, &stats))
     return;
   AVDynamicHDRPlus made{};
-  dvbridge_dvplus_metadata(&stats, &made);
+  dvbridge_dvplus_metadata_version(&stats, HDR10PlusOutputVersion(), &made);
   if (const auto payload = KODI::UTILS::HDR10PLUS::MakeVsif(made))
   {
     ++m_dvPlusStartsWaited;
-- 
