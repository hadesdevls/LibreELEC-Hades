+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+
+namespace KODI::SUBTITLES
+{
+//! (Hades) Whether a Dolby Vision video is a PQ video in BT.2020 whose base layer says nothing of
+//! its colours: profile 5, and 10 with a base layer of no other kind (IPT-PQ-c2). The other
+//! profiles say what they are themselves (HDR10, SDR, HLG).
+constexpr bool IptPQVideo(int dvProfile, int blCompatibility)
+{
+  return dvProfile == 5 || (dvProfile == 10 && blCompatibility == 0);
+}
+
+/*!
+ * \brief (Hades) Whether the pictures of a PGS stream are made for HDR (PQ: BT.2020 colours in the
+ * ST 2084 signal, as on an Ultra HD Blu-ray) or for SDR (BT.709, as on a Blu-ray)
+ *
+ * Kodi took a PGS stream as made for HDR exactly when its video is PQ. A film file often carries
+ * subtitles of another release: those of the Blu-ray (SDR) with the video of the Ultra HD Blu-ray,
+ * or the other way round. Taken as PQ, the white of SDR subtitles (Y' 235) is the brightest light
+ * of PQ, as bright as the display goes; taken as SDR, the white of PQ subtitles (about 200 cd/m2,
+ * Y' 143) is a grey.
+ *
+ * In Automatic (the setting subtitles.hadesbitmaprange), the stream starts as its video says, and
+ * the palettes of its packets, read before they are decoded, tell it apart, once, for the rest of
+ * the stream (so that every palette is decoded with the matrix of its range):
+ * - made for SDR, in a PQ video: a palette entry, mostly opaque, with a Y' of SDR_Y or more (0.85
+ *   of the range). As PQ that would be over 2000 cd/m2: no subtitle is made that bright. SDR text is
+ *   white or yellow (Y' 219 and more).
+ * - made for HDR, in an SDR video: the brightest entry that is mostly opaque is neutral (white or
+ *   grey text, as every PGS of an Ultra HD Blu-ray is), with a Y' from HDR_Y_MIN to HDR_Y_MAX: about
+ *   55 to 515 cd/m2 in PQ, where SDR text would be a dark to middle grey.
+ * Coloured text, or text darker than that, says nothing, and the stream stays as its video.
+ * The other choices fix it: as the video (Kodi's own way), SDR or HDR.
+ */
+class CPgsRange
+{
+public:
+  //! subtitles.hadesbitmaprange
+  enum class Choice
+  {
+    AUTOMATIC = 0,
+    VIDEO = 1,
+    SDR = 2,
+    PQ = 3,
+  };
+
+  //! why the range is what it is
+  enum class Reason
+  {
+    VIDEO, //!< as the video (Automatic before its palettes told anything, or the choice)
+    CHOICE, //!< the choice SDR or HDR
+    BRIGHT, //!< an entry brighter than any made for HDR: made for SDR
+    DIM, //!< neutral text at the light of HDR text, nothing brighter: made for HDR
+  };
+
+  //! Y' (limited range, 8 bits) of 0.85, 0.45 and 0.68 of the range (16 + 219 x)
+  static constexpr int SDR_Y = 202;
+  static constexpr int HDR_Y_MIN = 115;
+  static constexpr int HDR_Y_MAX = 165;
+  //! the most the Cb and Cr of a neutral entry may be away from 128
+  static constexpr int NEUTRAL = 6;
+  //! an entry this opaque or more is text, not the soft edge of it (of 255)
+  static constexpr int OPAQUE = 128;
+
+  CPgsRange(bool videoPQ, int choice)
+  {
+    switch (static_cast<Choice>(choice))
+    {
+      case Choice::SDR:
+        m_pq = false;
+        m_reason = Reason::CHOICE;
+        m_auto = false;
+        break;
+      case Choice::PQ:
+        m_pq = true;
+        m_reason = Reason::CHOICE;
+        m_auto = false;
+        break;
+      case Choice::VIDEO:
+        m_pq = videoPQ;
+        m_auto = false;
+        break;
+      case Choice::AUTOMATIC:
+      default:
+        m_pq = videoPQ;
+        m_auto = true;
+        break;
+    }
+  }
+
+  /*!
+   * \brief The entries of a palette definition segment (5 bytes each: id, Y', Cr, Cb, alpha).
+   * Returns true when they changed the range (in Automatic, once).
+   */
+  bool Palette(const uint8_t* entries, size_t size)
+  {
+    if (!m_auto || m_told)
+      return false;
+    int brightest = -1;
+    size_t at = 0;
+    for (size_t i = 0; i + 5 <= size; i += 5)
+    {
+      if (entries[i + 4] < OPAQUE)
+        continue;
+      if (entries[i + 1] > brightest)
+      {
+        brightest = entries[i + 1];
+        at = i;
+      }
+    }
+    if (brightest < 0)
+      return false;
+    m_y = entries[at + 1];
+    m_cr = entries[at + 2];
+    m_cb = entries[at + 3];
+    if (m_pq && brightest >= SDR_Y)
+      return Told(false, Reason::BRIGHT);
+    if (!m_pq && brightest >= HDR_Y_MIN && brightest <= HDR_Y_MAX &&
+        std::abs(m_cb - 128) <= NEUTRAL && std::abs(m_cr - 128) <= NEUTRAL)
+      return Told(true, Reason::DIM);
+    return false;
+  }
+
+  /*!
+   * \brief A packet of the stream, as the demuxer gives it (its segments: a type, a length of two
+   * bytes, the payload), before it is decoded: its palette definition segments (type 0x14, the
+   * entries after the id and the version of the palette). Returns true when one changed the range.
+   */
+  bool Packet(const uint8_t* data, size_t size)
+  {
+    if (!m_auto || m_told || !data)
+      return false;
+    for (size_t i = 0; i + 3 <= size;)
+    {
+      const uint8_t type = data[i];
+      const size_t length = static_cast<size_t>(data[i + 1]) << 8 | data[i + 2];
+      if (i + 3 + length > size)
+        break;
+      if (type == 0x14 && length >= 2 && Palette(data + i + 5, length - 2))
+        return true;
+      i += 3 + length;
+    }
+    return false;
+  }
+
+  bool PQ() const { return m_pq; }
+  Reason Why() const { return m_reason; }
+  //! the entry that told it (BRIGHT, DIM)
+  int Y() const { return m_y; }
+  int Cb() const { return m_cb; }
+  int Cr() const { return m_cr; }
+
+private:
+  bool Told(bool pq, Reason reason)
+  {
+    m_told = true;
+    m_pq = pq;
+    m_reason = reason;
+    return true;
+  }
+
+  bool m_pq{false};
+  bool m_auto{true};
+  bool m_told{false};
+  Reason m_reason{Reason::VIDEO};
+  int m_y{0};
+  int m_cb{0};
+  int m_cr{0};
+};
+} // namespace KODI::SUBTITLES
