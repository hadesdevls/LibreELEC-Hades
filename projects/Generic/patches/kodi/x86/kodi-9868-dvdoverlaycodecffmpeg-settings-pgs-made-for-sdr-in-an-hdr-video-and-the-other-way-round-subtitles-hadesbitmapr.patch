diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodecFFmpeg.cpp
index 3d2db68..077d987 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlayCodecFFmpeg.cpp
@@ -17,6 +17,8 @@
 #include "cores/FFmpeg.h"
 #include "cores/VideoPlayer/Interface/DemuxPacket.h"
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
 #include "utils/EndianSwap.h"
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
@@ -97,6 +99,28 @@ bool CDVDOverlayCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &optio
   m_pCodecContext->colorspace = hints.colorSpace;
   m_pCodecContext->color_primaries = hints.colorPrimaries;
   m_pCodecContext->color_trc = hints.colorTransferCharacteristic;
+  // Hades: what a PGS stream is made for (PgsRange.h): as its video says, or as the setting has it.
+  // Its palettes are decoded with the matrix of that range: BT.2020 for PQ; for SDR the video's own,
+  // or, where the video's is BT.2020, FFmpeg's (BT.709 above 576 lines)
+  m_pgsRange.reset();
+  if (hints.codec == AV_CODEC_ID_HDMV_PGS_SUBTITLE)
+  {
+    const int choice{CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+        CSettings::SETTING_SUBTITLES_HADESBITMAPRANGE)};
+    m_pgsRange.emplace(hints.colorTransferCharacteristic == AVCOL_TRC_SMPTE2084, choice);
+    m_pgsSdrColorspace =
+        hints.colorSpace == AVCOL_SPC_BT2020_NCL ? AVCOL_SPC_UNSPECIFIED : hints.colorSpace;
+    if (m_pgsRange->Why() == KODI::SUBTITLES::CPgsRange::Reason::CHOICE)
+      m_pCodecContext->colorspace =
+          m_pgsRange->PQ() ? AVCOL_SPC_BT2020_NCL : m_pgsSdrColorspace;
+    CLog::Log(LOGINFO, "CDVDOverlayCodecFFmpeg - PGS stream taken as made for {}, {}",
+              m_pgsRange->PQ() ? "HDR (PQ)" : "SDR",
+              m_pgsRange->Why() == KODI::SUBTITLES::CPgsRange::Reason::CHOICE
+                  ? "as the setting has it"
+                  : (choice == static_cast<int>(KODI::SUBTITLES::CPgsRange::Choice::VIDEO)
+                         ? "as its video (the setting)"
+                         : "as its video, until its palettes say otherwise"));
+  }
   m_pCodecContext->time_base.num = 1;
   m_pCodecContext->time_base.den = DVD_TIME_BASE;
   m_pCodecContext->pkt_timebase.num = 1;
@@ -182,6 +206,19 @@ OverlayMessage CDVDOverlayCodecFFmpeg::Decode(DemuxPacket* pPacket)
   avpkt->pts = pPacket->pts == DVD_NOPTS_VALUE ? AV_NOPTS_VALUE : (int64_t)pPacket->pts;
   avpkt->dts = pPacket->dts == DVD_NOPTS_VALUE ? AV_NOPTS_VALUE : (int64_t)pPacket->dts;
 
+  // Hades: the palettes of the packet tell what the stream is made for before FFmpeg decodes them
+  // (PgsRange.h), so that they, and every one after them, are decoded with the matrix of that range
+  if (m_pgsRange && m_pgsRange->Packet(pPacket->pData, static_cast<size_t>(pPacket->iSize)))
+  {
+    m_pCodecContext->colorspace = m_pgsRange->PQ() ? AVCOL_SPC_BT2020_NCL : m_pgsSdrColorspace;
+    CLog::Log(LOGINFO,
