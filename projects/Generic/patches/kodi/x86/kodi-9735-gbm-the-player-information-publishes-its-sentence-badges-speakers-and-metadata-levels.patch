 }
+
+// Hades: the values of the metadata levels that the player information shows beyond L1, L2, L5 and
+// L6 (which it has had since the overview page), and the table of the levels: which the file has,
+// which Hades acts on, which the display is sent (KODI::UTILS::PLAYERINFO::LevelTable)
+void PublishLevelValues(std::map<std::string, std::string>& info,
+                        const CDVBridgeGLES::LevelDetail& lv,
+                        const std::vector<int>& sent,
+                        bool sentKnown,
+                        bool native,
+                        bool converted,
+                        bool trims)
+{
+  using namespace KODI::UTILS::PLAYERINFO;
+  const std::string dot = " \xc2\xb7 "; // ·
+  if (lv.l3)
+    info["hades.dv.l3"] = StringUtils::Format("{:+d} / {:+d} / {:+d}", lv.l3Offsets[0],
+                                              lv.l3Offsets[1], lv.l3Offsets[2]);
+  if (lv.l4)
+    info["hades.dv.l4"] = StringUtils::Format("{:.0f} / {}", PQToNits(lv.l4Anchor), lv.l4Power);
+  std::string text;
+  for (unsigned int i = 0; i < lv.l8Count; ++i)
+    text += (i ? dot : std::string()) + std::to_string(lv.l8Ids[i]);
+  info["hades.dv.l8"] = text;
+  if (lv.l9)
+    info["hades.dv.l9"] = lv.l9Primaries;
+  text.clear();
+  for (unsigned int i = 0; i < lv.l10Count; ++i)
+    text += (i ? dot : std::string()) +
+            StringUtils::Format("{}: {:.0f}", lv.l10Ids[i], PQToNits(lv.l10MaxPq[i]));
+  info["hades.dv.l10"] = text;
+  if (lv.l11)
+    info["hades.dv.l11"] =
+        StringUtils::Format("{} / {} / {}", lv.l11Type, lv.l11White, lv.l11Reference);
+  if (lv.l254)
+    info["hades.dv.l254"] = StringUtils::Format("{} / {}", lv.l254Mode, lv.l254Version);
+  if (lv.l255)
+    info["hades.dv.l255"] = StringUtils::Format("{} / {}", lv.l255Mode, lv.l255Version);
+  if (lv.count)
+  {
+    const std::vector<int> file(lv.levels, lv.levels + lv.count);
+    const auto table = LevelTable(file, sent, sentKnown, native, converted, trims);
+    info["hades.dv.lvhead"] = table[0];
+    info["hades.dv.lvfile"] = table[1];
+    info["hades.dv.lvused"] = table[2];
+    info["hades.dv.lvsent"] = table[3];
+  }
+}
+
+// Hades: the values of the player information that are lit when they change (the Dolby Vision
+// metadata, the output, the colour of the picture, the audio format): not the counters that move
+// with every beat (the last 10 s, the GPU, the memory, the bit rates), which would be lit for ever
+bool InfoFlashKey(const std::string& key)
+{
+  static const char* const prefixes[] = {
+      "hades.dv.l",      "hades.dv.source", "hades.dv.blocks", "hades.dv.sent",
+      "hades.dv.notsent", "hades.dv.cm",     "hades.dv.layers", "hades.dv.state",
+      "hades.dv.reason", "hades.dv.transport", "hades.dv.signal", "hades.dv.display",
+      "hades.out.",      "hades.audio.",    "hades.video.",    "hades.src."};
+  if (key == "hades.dv.l1changes" || key == "hades.audio.bitrate" || key == "hades.video.bitrate" ||
+      key == "hades.audio.srcrate" || key == "hades.audio.srcbits")
+    return false;
+  for (const char* prefix : prefixes)
+    if (key.compare(0, std::strlen(prefix), prefix) == 0)
+      return true;
+  return false;
+}
 } // namespace
 
 void CWinSystemGbmGLESContext::TellHdmi14bStart() const
@@ -7620,6 +7689,19 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.cmsent", ""},
       {"hades.dv.vsif", ""},
       {"hades.dv.composer", ""},
+      // Hades: the levels of the metadata that the page of the Dolby Vision metadata shows
+      {"hades.dv.l3", ""},
+      {"hades.dv.l4", ""},
+      {"hades.dv.l8", ""},
+      {"hades.dv.l9", ""},
+      {"hades.dv.l10", ""},
+      {"hades.dv.l11", ""},
+      {"hades.dv.l254", ""},
+      {"hades.dv.l255", ""},
+      {"hades.dv.lvhead", ""},
+      {"hades.dv.lvfile", ""},
+      {"hades.dv.lvused", ""},
+      {"hades.dv.lvsent", ""},
       {"hades.dv.trims", ""},
       {"hades.dv.origin", ""},
       {"hades.dv.hdr10plus", ""},
@@ -7758,6 +7840,11 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       // the picture when the RPU has none
       info["hades.dv.l5origin"] = d.sentL5Drawn ? "drawn" : d.l5[0] >= 0 ? "rpu" : "picture";
     }
+    // Hades: and what every level of the RPU says, with the table of the levels (the page of the
+    // Dolby Vision metadata of the player information)
+    PublishLevelValues(info, d.levelDetail,
+                       std::vector<int>(d.sent, d.sent + (d.sentCount > 0 ? d.sentCount : 0)),
+                       d.sentCount >= 0, true, false, m_dvEngine.trims);
     // Hades: how the picture was composed, where it was not as CCM 001 composes it
     if (d.composed == DVBRIDGE_COMPOSED_RESHAPING)
       info["hades.dv.composer"] = "reshaping";
@@ -7776,7 +7863,12 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       info["hades.dv.vsif"] = "hdmi14b";
   }
   if (converted)
+  {
     info["hades.dv.layers"] = m_dvConvertBridge->ConversionLayers();
+    // (Hades: the levels of the RPU of the picture rebuilt; what the display is sent is not read)
+    PublishLevelValues(info, m_dvConvertBridge->ConversionLevels(), {}, false, false, true,
+                       m_dvEngine.trims);
+  }
   if (native || converted)
   {
     if (const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
@@ -7832,6 +7924,9 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
     auto& published = m_dvPublished[key];
     if (published != value)
     {
+      // (Hades: a value of the page that changes while it is open is lit for a moment)
+      if (m_playerInfoShown && InfoFlashKey(key))
+        m_infoFlash.Observe(key, published, value, now);
       home->SetProperty(key, value);
       published = value;
     }
@@ -9610,7 +9705,26 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.out.hdr10plus.average", ""},
       {"hades.out.hdr10plus.p99", ""},
       {"hades.out.hdr10plus.target", ""},
-      {"hades.out.hdr10plus.anchors", ""}};
+      {"hades.out.hdr10plus.anchors", ""},
+      // Hades: the sentence at the top of the overview page and what the pages need beyond it
+      {"hades.sum.state", ""},
+      {"hades.sum.code", ""},
+      {"hades.sum.arg", ""},
+      {"hades.sum.todo", ""},
+      {"hades.sum.more", ""},
+      {"hades.sum.head", ""},
+      {"hades.sum.vbadge", ""},
+      {"hades.sum.abadge", ""},
+      {"hades.audio.spk", ""},
+      {"hades.video.color", ""},
+      {"hades.video.matrix", ""},
+      {"hades.src.mastering", ""},
+      {"hades.src.cll", ""},
+      {"hades.play.dropped", ""},
+      {"hades.play.skipped", ""},
+      {"hades.out.ratefit", ""},
+      {"hades.video.area", ""}};
+  double modeHz = 0.0; // the refresh rate of the mode that is set
   // Hades: what is open for the readings of the GPU is let go as soon as the dialog closes
   if (!shown && m_gpuSensors)
     m_gpuSensors->Release();
@@ -9648,6 +9762,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
                              (interlaced ? 2 : 1);
       info["hades.out.mode"] = StringUtils::Format("{}x{}{} @ {:.3f} Hz", mode->hdisplay,
                                                    mode->vdisplay, interlaced ? "i" : "", refresh);
+      modeHz = refresh;
     }
     if (connector && fd >= 0)
     {
@@ -9920,13 +10035,88 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       info["hades.out.adaptpeaks"] = StringUtils::Format(
           "{:.0f} > {:.0f}", adapt.decision.sourcePeak, adapt.decision.displayPeak);
   }
+  // Hades: what the overview page says, decided here (the skins draw it): the sentence, the badges
+  // of the formats, the speakers, the colour of the picture, the pictures dropped and skipped, and
+  // whether the rate of the display fits the video's. Nothing of it while the page is not open.
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (shown && player && player->IsPlayingVideo())
+  {
+    using namespace KODI::UTILS::PLAYERINFO;
+    auto& cache = CServiceBroker::GetDataCacheCore();
+    const auto dv = [this](const char* key) {
+      const auto it = m_dvPublished.find(key);
+      return it == m_dvPublished.end() ? std::string() : it->second;
+    };
+    info["hades.play.dropped"] = std::to_string(cache.GetVideoDropped());
+    info["hades.play.skipped"] = std::to_string(cache.GetVideoSkipped());
+    const SourceColour source = GetSourceColour();
+    info["hades.video.color"] = source.colour;
+    info["hades.video.matrix"] = source.matrix;
+    info["hades.src.mastering"] = source.mastering;
+    info["hades.src.cll"] = source.cll;
+    info["hades.out.ratefit"] = FitRate(modeHz, cache.GetVideoFps());
+    // the part of the picture that is not bars, where the RPU says (its level 5, in pixels of the
+    // picture: hades.dv.l5 is "left / right / top / bottom")
+    {
+      int width = 0, height = 0, left = 0, right = 0, top = 0, bottom = 0;
+      if (std::sscanf(info["hades.video.size"].c_str(), "%dx%d", &width, &height) == 2 &&
+          std::sscanf(dv("hades.dv.l5").c_str(), "%d / %d / %d / %d", &left, &right, &top,
+                      &bottom) == 4)
+        info["hades.video.area"] = PictureArea(width, height, left, right, top, bottom);
+    }
+    // the sound: the speakers that its layout lights (the bed of an object-based stream says what
+    // is lit, not the channels of its core) and its badge
+    const auto presentation = cache.GetAudioPresentation();
+    const std::string bed = presentation.objects ? presentation.bedName : "";
+    info["hades.audio.spk"] = Speakers(cache.GetAudioChannels(), bed);
+    AudioStreamInfo audio;
+    player->GetAudioStreamInfo(player->GetAudioStream(), audio);
+    info["hades.sum.abadge"] = AudioBadge(audio.codecName, bed, audio.channels);
+    // the picture: its badge, from what the stream is, its Dolby Vision record and its layers
+    const std::string hdrType = dv("hades.src.hdrtype");
+    int profile = 0, level = 0, compat = 0;
+    std::sscanf(dv("hades.src.dv").c_str(), "%d %d %d", &profile, &level, &compat);
+    if (!hdrType.empty())
+      info["hades.sum.vbadge"] = VideoBadge(hdrType, info["hades.video.hdr10plus"] == "yes",
+                                            profile, compat, dv("hades.dv.layers"));
+    SummaryInput input;
+    input.video = true;
+    input.source = hdrType;
+    input.dvState = dv("hades.dv.state");
+    input.dvReason = dv("hades.dv.reason");
+    input.signal = info["hades.out.signal"];
+    input.hdrNotSent = HdrNotSentCode();
+    input.failed = std::atoi(dv("hades.dv.notshown").c_str());
+    input.stepLevel = std::atoi(dv("hades.dv.step").c_str());
+    input.felGap = dv("hades.dv.layers") == "FELGAP";
+    input.rateFit = info["hades.out.ratefit"];
+    input.audioWhy = info["hades.audio.why"];
+    const Summary summary = Decide(input);
+    info["hades.sum.state"] = SeverityName(summary.state);
+    info["hades.sum.code"] = summary.code;
+    info["hades.sum.arg"] = summary.arg;
+    info["hades.sum.todo"] = summary.todo;
+    info["hades.sum.more"] = std::to_string(summary.more);
+    info["hades.sum.head"] = summary.head;
+  }
   for (const auto& [key, value] : info)
   {
     auto& published = m_playerInfoPublished[key];
     if (published != value)
     {
+      if (shown && InfoFlashKey(key))
+        m_infoFlash.Observe(key, published, value, now);
       home->SetProperty(key, value);
       published = value;
     }
   }
+  // Hades: what changed is lit (hades.f.<key without "hades.">: 1) and put out again
+  const auto flash = [home](const std::string& key, bool lit) {
+    if (key.compare(0, 6, "hades.") == 0)
+      home->SetProperty("hades.f." + key.substr(6), lit ? "1" : "");
+  };
+  if (shown)
+    m_infoFlash.Update(now, flash);
+  else
+    m_infoFlash.Clear(flash);
 }
