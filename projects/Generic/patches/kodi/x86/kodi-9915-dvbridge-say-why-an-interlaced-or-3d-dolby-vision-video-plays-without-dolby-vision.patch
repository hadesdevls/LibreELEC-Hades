 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 81 +++++++++++++++++--
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        |  2 +-
 .../VideoRenderers/LinuxRendererGLES.cpp      |  6 +-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 24 +++---
 4 files changed, 94 insertions(+), 19 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index bd20257..19e6748 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -340,7 +340,6 @@ inline bool TransportRateNeeds2160p60(double refresh)
 bool DisplayTakesRate(double refresh);
 
 //! Native output now, in the current output mode (the renderer's question).
-bool WantsNativeOutput(const CDVDStreamInfo& stream);
 bool WantsNativeOutput(const VideoPicture* picture);
 //! Native output in a transport mode, whatever the current mode: the stream and the decoder set
 //! up for it (dual-layer decoding, mode selection) before the output switches to that mode.
@@ -377,10 +376,71 @@ unsigned int VideoNumber();
 //! The video opened (its input and demuxer): after a failure, it counts towards trying native
 //! output again.
 void VideoOpened();
-//! A Dolby Vision video opened without native output (VideoPlayer, once per file): when the display
-//! offers Dolby Vision Low-Latency only (a TV input in its game mode, or a display that has no
-//! other form), the user is told why, once for that state of the display.
-void DolbyVisionWithoutNativeOutput();
+//! Hades: what in a Dolby Vision video stream itself keeps the bridge from it, whatever the
+//! display and the settings say (StreamKeptOutOf())
+enum class StreamKeptOut
+{
+  NONE,
+  INTERLACED, //!< interlaced: neither native output nor the reconstruction takes it
+  STEREO, //!< 3D, two views: neither native output nor the reconstruction takes it
+  RASTER, //!< larger than native output takes in (SourceFitsRaster())
+};
+
+/*!
+ * \brief Hades: what in a Dolby Vision video stream, as it opens, keeps it from the bridge
+ *        whatever the display and the settings say: the conditions of Eligible() and
+ *        ConversionEligible() that are the stream's own
+ * \param dolbyVision the stream is Dolby Vision (its configuration record has a profile)
+ * \param softwareProbe a probe decoded in software (thumbnails, details): nothing is said of it
+ *
+ * Said once a video (DolbyVisionWithoutNativeOutput()): an interlaced or 3D Dolby Vision video
+ * played from its base layer without a word in the log, and the line for a picture larger than
+ * native output takes in was in a function that nothing called.
+ */
+constexpr StreamKeptOut StreamKeptOutOf(
+    bool dolbyVision, bool softwareProbe, bool interlaced, bool stereo, bool fitsRaster)
+{
+  if (!dolbyVision || softwareProbe)
+    return StreamKeptOut::NONE;
+  return interlaced    ? StreamKeptOut::INTERLACED
+         : stereo      ? StreamKeptOut::STEREO
+         : !fitsRaster ? StreamKeptOut::RASTER
+                       : StreamKeptOut::NONE;
+}
+
+//! Hades: the line of the log for what StreamKeptOutOf() found ("" for NONE)
+inline std::string StreamKeptOutReason(StreamKeptOut why,
+                                       int width,
+                                       int height,
+                                       const std::string& stereoMode)
+{
+  switch (why)
+  {
+    case StreamKeptOut::INTERLACED:
+      return "Dolby Vision is not used for this video, natively or reconstructed: it is "
+             "interlaced, and the bridge takes progressive pictures only. It plays as Kodi plays "
+             "it, from its base layer";
+    case StreamKeptOut::STEREO:
+      return "Dolby Vision is not used for this video, natively or reconstructed: it is 3D (" +
+             stereoMode +
+             "), and the bridge takes the pictures of one view only. It plays as Kodi plays it, "
+             "from its base layer";
+    case StreamKeptOut::RASTER:
+      return "native Dolby Vision output is not used for this video: its picture is " +
+             std::to_string(width) + "x" + std::to_string(height) +
+             ", and native output takes pictures up to " + std::to_string(SOURCE_MAX_WIDTH) + "x" +
+             std::to_string(SOURCE_MAX_HEIGHT) +
+             " (scaled to the 3840x2160 of the transport). It plays as Kodi plays it";
+    default:
+      return "";
+  }
+}
+
+//! A Dolby Vision video opened without native output (VideoPlayer, once per file): what in the
+//! stream itself keeps the bridge from it is said in the log (StreamKeptOutOf()); else, when the
+//! display offers Dolby Vision Low-Latency only (a TV input in its game mode, or a display that has
+//! no other form), the user is told why, once for that state of the display.
+void DolbyVisionWithoutNativeOutput(const CDVDStreamInfo& stream);
 
 //! Hades: what the settings say of a Dolby Vision stream that is not sent natively
 enum class ConversionSetting
@@ -1448,6 +1508,17 @@ bool ConversionEligible(const CDVDStreamInfo& stream, int toneMapMethod);
 bool WantsConversion(const VideoPicture* picture, int toneMapMethod);
 //! Such pictures could not be shown (the renderer says so): not tried again in this video.
 void ConversionFailed(const char* reason);
+//! Hades: what the renderer says when it gives the bridge's pictures of a video up
+//! (ConversionFailed(), PlainMappingFailed()) where the last one it could not draw was a field:
+//! Kodi then deinterlaces in the renderer and draws each field alone (RENDER_FLAG_TOP, _BOT), and
+//! the bridge draws whole frames only; else what it says of itself (the line said "could not be
+//! reconstructed" for those too)
+constexpr const char* RendererFailureReason(bool field, const char* otherwise)
+{
+  return field ? "its pictures are drawn as fields (deinterlaced by the renderer), and the bridge "
+                 "draws whole frames only"
+               : otherwise;
+}
 //! Hades: the renderer's question for a picture that is not reconstructed (PlainMappingEligible()),
 //! by the tone mapping method of its video (ETONEMAPMETHOD) and the output as it is now
 bool WantsPlainMapping(const VideoPicture* picture, int toneMapMethod);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 5877aff..50722aa 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -5417,7 +5417,7 @@ bool CVideoPlayer::OpenVideoStream(CDVDStreamInfo& hint, bool reset)
     nativeDV = DVBRIDGE::WantsNativeOutputMode(hint);
     m_renderManager.SetNativeDVStream(nativeDV);
     if (!nativeDV && hint.dovi.dv_profile != 0)
-      DVBRIDGE::DolbyVisionWithoutNativeOutput();
+      DVBRIDGE::DolbyVisionWithoutNativeOutput(hint);
     // Hades: a video played in a window (a video screensaver, a skin's video control) gets no
     // mode of its own: it goes out natively where the mode of the menus carries the transport,
     // and the window system says when it starts and ends. Said, for the logs of a test.
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 53f63b0..5845fe8 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -2010,7 +2010,8 @@ bool CLinuxRendererGLES::Render(unsigned int flags, int index)
     {
       m_dvConvertFailedSerial = serial;
       if (++m_dvConvertFailures == FAILURES)
-        DVBRIDGE::ConversionFailed("its pictures could not be reconstructed");
+        DVBRIDGE::ConversionFailed(DVBRIDGE::RendererFailureReason(
+            m_currentField != FIELD_FULL, "its pictures could not be reconstructed"));
     }
     if (drawn >= 0 || !DVConversionShowsBase(index))
     {
@@ -2041,7 +2042,8 @@ bool CLinuxRendererGLES::Render(unsigned int flags, int index)
     {
       m_plainFailedSerial = serial;
       if (++m_plainFailures == FAILURES)
-        DVBRIDGE::PlainMappingFailed("its pictures could not be mapped");
+        DVBRIDGE::PlainMappingFailed(DVBRIDGE::RendererFailureReason(
+            m_currentField != FIELD_FULL, "its pictures could not be mapped"));
     }
     if (drawn >= 0)
     {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 36b5e9b..191aa7c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2631,11 +2631,6 @@ bool StreamEligible(const CDVDStreamInfo& stream, bool anyMode)
   // (Hades: not a picture bigger than the raster that the output carries, decided here, before the
   // display enters Dolby Vision: DVBRIDGE::SourceFitsRaster())
   const bool fits = DVBRIDGE::SourceFitsRaster(stream.width, stream.height);
-  if (!fits && stream.dovi.dv_profile != 0 && !anyMode)
-    CLog::Log(LOGINFO,
-              "DVBridge: native Dolby Vision output is not used for this video: its picture is "
-              "{}x{}, and the output carries at most 3840x2160. It plays as Kodi plays it",
-              stream.width, stream.height);
   const bool eligible =
       chosen && NativeDVEligible(stream.dovi.dv_profile != 0, software, stream.interlaced,
                                  !stream.stereo_mode.empty(), anyMode, fits);
@@ -2661,11 +2656,6 @@ bool PictureEligible(const VideoPicture* picture, bool anyMode)
 }
 } // namespace
 
-bool DVBRIDGE::WantsNativeOutput(const CDVDStreamInfo& stream)
-{
-  return StreamEligible(stream, false);
-}
-
 bool DVBRIDGE::WantsNativeOutput(const VideoPicture* picture)
 {
   if (PictureEligible(picture, false))
@@ -5120,8 +5110,20 @@ void DVBRIDGE::VideoOpened()
     window->DVVideoOpened();
 }
 
-void DVBRIDGE::DolbyVisionWithoutNativeOutput()
+void DVBRIDGE::DolbyVisionWithoutNativeOutput(const CDVDStreamInfo& stream)
 {
+  // Hades: what in the stream itself keeps the bridge from it, once a video; and then the user is
+  // not told to change the display, which would not bring Dolby Vision to this video
+  const StreamKeptOut kept = StreamKeptOutOf(
+      stream.dovi.dv_profile != 0, (stream.codecOptions & CODEC_FORCE_SOFTWARE) != 0,
+      stream.interlaced, !stream.stereo_mode.empty(),
+      SourceFitsRaster(stream.width, stream.height));
+  if (kept != StreamKeptOut::NONE)
+  {
+    CLog::Log(LOGINFO, "DVBridge: {}",
+              StreamKeptOutReason(kept, stream.width, stream.height, stream.stereo_mode));
+    return;
+  }
   if (auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem()))
     window->DVStreamWithoutNativeOutput();
 }
