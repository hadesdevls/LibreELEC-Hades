+STEREO::Layout CDRMUtils::GetModeLayout(const RESOLUTION_INFO& res) const
+{
+  if (!m_connector || res.strId.empty())
+    return STEREO::Layout::NONE;
+
+  const int index = std::atoi(res.strId.c_str());
+  if (index < 0 || index >= m_connector->GetModesCount())
+    return STEREO::Layout::NONE;
+
+  return STEREO::LayoutOf(m_connector->GetModeForIndex(index)->flags);
+}
+
+bool CDRMUtils::GetOutputModeFlags(uint32_t& flags) const
+{
+  if (m_fd < 0 || !m_crtc)
+    return false;
+
+  drmModeCrtcPtr crtc = drmModeGetCrtc(m_fd, m_crtc->GetCrtcId());
+  if (!crtc)
+    return false;
+
+  const bool valid = crtc->mode_valid != 0;
+  flags = crtc->mode.flags;
+  drmModeFreeCrtc(crtc);
+  return valid;
+}
