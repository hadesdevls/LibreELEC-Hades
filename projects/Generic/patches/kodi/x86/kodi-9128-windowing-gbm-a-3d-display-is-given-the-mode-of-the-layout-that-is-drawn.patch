+/*!
+ * \brief Frame packing where the driver makes a surface for each eye out of the one buffer
+ *
+ * nvidia-drm takes a frame-packed frame as the other drivers do, in one buffer of
+ * ScanoutHeight() lines, and gives NVKMS, whose hardware does the packing, the lines of each
+ * eye as a surface of its own. The second eye begins at line vtotal of the buffer, pitch x
+ * vtotal bytes into it, and NVKMS takes a surface only at an offset that is a multiple of
+ * 1024 bytes. With 4 bytes for a pixel, a buffer 1280 pixels wide has such an offset at line
+ * 750 (720p); one 1920 pixels wide has none at line 1125 (1080p), and one 2048 wide does.
+ * The buffer of such a mode is made that wide, and the 1920 columns of the mode are shown.
+ * The lines also have to lie one after another in memory, not in blocks: the buffer is made
+ * with DRM_FORMAT_MOD_LINEAR, and its framebuffer says so.
+ */
+inline constexpr uint32_t NVKMS_SURFACE_OFFSET_ALIGNMENT = 1024;
+
+//! \brief Whether the second eye of a frame-packed frame, in a buffer of this pitch, begins at
+//! an offset that is a multiple of alignment
+constexpr bool SecondEyeAligned(uint32_t pitch, const Mode& mode, uint32_t alignment)
+{
+  return pitch != 0 && alignment != 0 &&
+         (static_cast<uint64_t>(pitch) * mode.vtotal) % alignment == 0;
+}
+
+/*!
+ * \brief The width to make the buffer of a frame-packed mode with, for SecondEyeAligned()
+ * \param bytesPerPixel of its format: the pitch is taken to be the width times this, which is
+ *        then asked of the buffer that was made
+ * \return the smallest such width that is not less than that of the mode; 0 without one
+ */
+constexpr int FramePackedBufferWidth(const Mode& mode, uint32_t bytesPerPixel, uint32_t alignment)
+{
+  if (mode.hdisplay == 0 || bytesPerPixel == 0 || alignment == 0)
+    return 0;
+
+  // (one of any 'alignment' widths in a row is a multiple of it)
+  for (uint32_t width = mode.hdisplay; width < mode.hdisplay + alignment; ++width)
+  {
+    if (SecondEyeAligned(width * bytesPerPixel, mode, alignment))
+      return static_cast<int>(width);
+  }
+  return 0;
+}
