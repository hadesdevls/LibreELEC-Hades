+// Hades: stereoscopic 3D over HDMI. While Kodi draws the two eyes of a picture one above the
+// other or side by side, the display is given the mode that tells it of that layout, and shows
+// 3D by itself. What is chosen, and the rules of it, are in drm/DRMStereo.h.
+namespace
+{
+bool IsSplitStereoMode(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::SPLIT_HORIZONTAL || mode == RenderStereoMode::SPLIT_VERTICAL;
+}
+
+STEREO::Arrangement ArrangementOf(RenderStereoMode mode)
+{
+  return mode == RenderStereoMode::SPLIT_HORIZONTAL ? STEREO::Arrangement::TOP_AND_BOTTOM
+                                                   : STEREO::Arrangement::SIDE_BY_SIDE;
+}
+} // namespace
+
+bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
+                                    STEREO::Allowed& allowed,
+                                    const char*& reason,
+                                    bool drawing) const
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADES3DOUTPUT) ||
+      settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADES3DOUTPUT) == 0)
+  {
+    reason = "the setting for it is off";
+    return false;
+  }
+  if (!m_DRM || !std::dynamic_pointer_cast<CDRMAtomic>(m_DRM) || !m_DRM->GetConnector())
+  {
+    reason = "the output is not set by atomic modesetting";
+    return false;
+  }
+  // (the state of the thread that draws: asked of it only)
+  if (drawing && NativeDVOutputInUse())
+  {
+    reason = "native Dolby Vision output is in use";
+    return false;
+  }
+
+  offers = STEREO::Offers(m_DRM->GetStereoModes());
+  allowed.framePacking = !m_stereoRefusedFramePacking;
+  allowed.halfModes = !m_stereoRefusedHalfModes;
+  allowed.infoFrame = false;
+  allowed.otherSize = !CResolutionUtils::HasWhitelist();
+  return true;
+}
+
+bool CWinSystemGbm::GetStereoOutputMode(RESOLUTION res,
+                                        RenderStereoMode mode,
+                                        RESOLUTION_INFO& info)
+{
+  if (!IsSplitStereoMode(mode) || !m_DRM)
+    return false;
+
+  // The mode of the connector behind the resolution (CDRMUtils::GetModes() puts its index in
+  // strId). A resolution without one is no mode of this output.
+  const RESOLUTION_INFO entry = CDisplaySettings::GetInstance().GetResolutionInfo(res);
+  if (entry.strId.empty())
+    return false;
+  const int base = std::atoi(entry.strId.c_str());
+
+  std::vector<STEREO::Offer> offers;
+  STEREO::Allowed allowed;
+  const char* reason = "its modes cannot be read";
+  STEREO::Choice choice;
+  if (GetStereoOffers(offers, allowed, reason, true))
+  {
+    choice = STEREO::Choose(offers, base, ArrangementOf(mode), allowed);
+    if (choice.layout == STEREO::Layout::NONE)
+      reason = allowed.framePacking && allowed.halfModes
+                   ? "the display has no 3D mode for it at this refresh rate"
+                   : "the driver did not take the 3D modes that the display has for it";
+    else
+      reason = "its modes cannot be read";
+  }
+
+  // what Kodi is told of the mode to set, and of the 2D mode whose timing that one has
+  RESOLUTION_INFO chosen;
+  RESOLUTION_INFO timing;
+  if (choice.layout == STEREO::Layout::NONE || choice.infoFrame ||
+      !m_DRM->GetModeInfo(choice.mode, chosen) || !m_DRM->GetModeInfo(choice.base, timing))
+  {
+    TellStereoOutput(StringUtils::Format(
+        "none for {}: {}. The two halves go out as they are, and the display is switched to 3D "
+        "by hand",
+        entry.strMode, reason));
+    return false;
+  }
+
+  auto& gfx = GetGfxContext();
+  if (choice.layout == STEREO::Layout::FRAME_PACKING)
+  {
+    // The frame of both eyes: its lines are those of the first eye, of the gap and of the
+    // second eye (iHeight, with iBlanking for the gap), of which CGraphicContext makes an eye.
+    info = chosen;
+    // An eye is shown on as many lines as it is drawn on: what compares the lines of the
+    // display with those that are drawn (the view modes of the video) is told of the lines
+    // of the 2D timing.
+    info.iScreenWidth = timing.iScreenWidth;
+    info.iScreenHeight = timing.iScreenHeight;
+    info.strMode = timing.strMode + ", 3D frame packing";
+    info.strOutput = entry.strOutput;
+    gfx.ResetOverscan(info);
+    // Each eye is the picture of that 2D mode. Where it is the mode of the resolution, what
+    // was calibrated for the resolution holds for each eye.
+    if (choice.base == base && entry.iWidth == info.iWidth &&
+        entry.iHeight * 2 + info.iBlanking == info.iHeight)
+    {
+      info.Overscan.left = entry.Overscan.left;
+      info.Overscan.right = entry.Overscan.right;
+      info.Overscan.top = entry.Overscan.top * 2;
+      info.Overscan.bottom = entry.Overscan.bottom * 2 + info.iBlanking;
+      info.iSubtitles = entry.iSubtitles * 2 + info.iBlanking;
+      info.fPixelRatio = entry.fPixelRatio;
+      info.guiInsets = entry.guiInsets;
+    }
+  }
+  else if (choice.base == base)
+  {
+    // The frame of the resolution itself, sent in the mode that tells of its layout: drawn
+    // and calibrated as the resolution is.
+    info = entry;
+    info.strId = chosen.strId;
+  }
+  else
+  {
+    info = chosen;
+    info.strOutput = entry.strOutput;
+    gfx.ResetOverscan(info);
+  }
+  return true;
+}
+
+RenderStereoMode CWinSystemGbm::GetStereoOutputArrangement(RenderStereoMode wanted)
+{
+  if (wanted != RenderStereoMode::SPLIT_VERTICAL || !m_DRM)
+    return wanted;
+
+  const RESOLUTION_INFO entry =
+      CDisplaySettings::GetInstance().GetResolutionInfo(GetGfxContext().GetVideoResolution());
+  std::vector<STEREO::Offer> offers;
+  STEREO::Allowed allowed;
+  const char* reason = nullptr;
+  const bool packed =
+      !entry.strId.empty() && GetStereoOffers(offers, allowed, reason, false) &&
+      STEREO::PrefersTopAndBottom(offers, std::atoi(entry.strId.c_str()), allowed);
+  if (m_stereoArrangementTold.exchange(packed) != packed && packed)
+    CLog::Log(LOGINFO,
+              "3D output: the display takes frame packing for {}: the eyes are drawn one above "
+              "the other, not side by side",
+              entry.strMode);
+  return packed ? RenderStereoMode::SPLIT_HORIZONTAL : wanted;
+}
+
+void CWinSystemGbm::TellStereoOutput(const std::string& status)
+{
+  if (status == m_stereoStatus)
+    return;
+
+  m_stereoStatus = status;
+  CLog::Log(LOGINFO, "3D output: {}", status);
+}
+
+void CWinSystemGbm::RefuseStereoOutput(STEREO::Layout layout, const std::string& why)
+{
+  auto& refused = layout == STEREO::Layout::FRAME_PACKING ? m_stereoRefusedFramePacking
+                                                          : m_stereoRefusedHalfModes;
+  if (refused.exchange(true))
+    return;
+
+  CLog::Log(LOGINFO,
+            "3D output: {} is not used: {}. What comes next in the choice is taken; it is tried "
+            "again when the eyes are next drawn split",
+            STEREO::LayoutName(layout), why);
+  // The resolution is set once more, for what is chosen without it
+  CServiceBroker::GetAppMessenger()->PostMsg(
+      TMSG_SETVIDEORESOLUTION, static_cast<int>(GetGfxContext().GetVideoResolution()), 1);
+}
+
+bool CWinSystemGbm::StereoWindowFailed(const RESOLUTION_INFO& res,
+                                       const char* why,
+                                       RESOLUTION_INFO& plain)
+{
+  const STEREO::Layout layout = m_DRM ? m_DRM->GetModeLayout(res) : STEREO::Layout::NONE;
+  if (layout == STEREO::Layout::NONE)
+    return false;
+
+  RefuseStereoOutput(layout, why);
+  plain = CDisplaySettings::GetInstance().GetResolutionInfo(GetGfxContext().GetVideoResolution());
+  return true;
+}
+
+void CWinSystemGbm::CheckStereoOutput()
+{
+  const drmModeModeInfo* mode = m_DRM->GetSelectedMode();
+  const STEREO::Layout asked = mode ? STEREO::LayoutOf(mode->flags) : STEREO::Layout::NONE;
+  const bool split = IsSplitStereoMode(GetGfxContext().GetStereoMode());
+
+  // Nothing here is for a 2D mode that is set while the output is in no 3D mode, the eyes are
+  // not drawn split and nothing was refused: every mode that is set without a 3D display.
+  if (asked == STEREO::Layout::NONE && m_stereoLayout == STEREO::Layout::NONE && !split &&
+      !m_stereoRefusedFramePacking && !m_stereoRefusedHalfModes)
+    return;
+
+  // The eyes are drawn another way: what was refused may be tried when they are next split
+  if (!split)
+  {
+    m_stereoRefusedFramePacking = false;
+    m_stereoRefusedHalfModes = false;
+  }
+
+  if (asked == STEREO::Layout::NONE && m_stereoLayout == STEREO::Layout::NONE)
+    return;
+
+  // What the output is in, whatever became of the commit: where the driver does not take a
+  // commit, CDRMAtomic commits what it committed last, and the mode stays the one before.
+  uint32_t flags = 0;
+  const STEREO::Layout shown =
+      m_DRM->GetOutputModeFlags(flags) ? STEREO::LayoutOf(flags) : STEREO::Layout::NONE;
+  m_stereoLayout = shown;
+
+  if (asked != STEREO::Layout::NONE && shown != asked)
+  {
+    RefuseStereoOutput(asked, "the driver did not take its mode (the kernel log may say why)");
+    return;
+  }
+
+  if (asked == STEREO::Layout::NONE && shown != STEREO::Layout::NONE)
+  {
+    // A 2D mode was set and the output stays in a 3D one: the display would show a 2D
+    // picture as two eyes. The mode is set again, a few times.
+    constexpr int TRIES = 3;
+    if (m_stereoLeaveTries < TRIES)
+    {
+      ++m_stereoLeaveTries;
+      CLog::Log(LOGWARNING,
+                "3D output: the output is still in a {} mode after a 2D mode was set (the "
+                "driver did not take the commit): the mode is set again ({} of {})",
+                STEREO::LayoutName(shown), m_stereoLeaveTries, TRIES);
+      m_DRM->AllowModeset();
+      CServiceBroker::GetAppMessenger()->PostMsg(
+          TMSG_SETVIDEORESOLUTION, static_cast<int>(GetGfxContext().GetVideoResolution()), 1);
+    }
+    return;
+  }
+  m_stereoLeaveTries = 0;
+
+  if (shown == STEREO::Layout::NONE)
+  {
+    TellStereoOutput("off: the display is in a 2D mode again");
+    return;
+  }
+
+  const bool interlaced = (mode->flags & DRM_MODE_FLAG_INTERLACE) != 0;
+  const double rate = mode->htotal && mode->vtotal
+                          ? mode->clock * 1000.0 / mode->htotal / mode->vtotal * (interlaced ? 2 : 1)
+                          : 0.0;
+  std::string status =
+      StringUtils::Format("{} with {}x{}{} @ {:.3f} Hz", STEREO::LayoutName(shown), mode->hdisplay,
+                          mode->vdisplay, interlaced ? "i" : "", rate);
+  if (shown == STEREO::Layout::FRAME_PACKING)
+    status += StringUtils::Format(" (a frame of {}x{}, {} lines between the eyes)", mode->hdisplay,
+                                  mode->vdisplay + mode->vtotal, mode->vtotal - mode->vdisplay);
+  TellStereoOutput(status);
+}
+
 #ifdef HAVE_DVBRIDGE
 namespace
 {
@@ -407,9 +680,11 @@ double ModeRate(const drmModeModeInfo& mode)
 
 bool IsDVTransportMode(const drmModeModeInfo& mode)
 {
+  // (nor a mode with a 3D layout: the display takes what it is given in one as two eyes)
   return DVBRIDGE::IsTransportMode(
       mode.hdisplay, mode.vdisplay, ModeRate(mode),
-      (mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)) != 0);
+      (mode.flags &
+       (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0);
 }
 
 // The refresh rate is not adjusted to the video: the output keeps the current one.
