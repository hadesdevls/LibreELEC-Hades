From 24587696bea46ce0c633c94f272b06b719651846 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 10 Nov 2026 20:59:05 +0100
Subject: [PATCH] [Video] Compare a refreshed movie with the list item before
 the dialog

After a refresh the reopened information dialog sends the refreshed
item to the windows when its user rating changes, which copies its
details to the list item. The watched state and movie set checks then
compared the refreshed details with themselves, so a movie that became
watched stayed in a list hiding watched movies. Compare them with the
details the list item had before the dialog was opened.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 443305632e7e06cbae88b26c9bb29375ce17aa81)
---
 xbmc/video/windows/GUIWindowVideoBase.cpp | 16 ++++++++++------
 xbmc/video/windows/GUIWindowVideoBase.h   |  4 +++-
 xbmc/video/windows/GUIWindowVideoNav.cpp  |  2 +-
 3 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 0b66c96..b18b83f 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -74,6 +74,7 @@
 #include <algorithm>
 #include <map>
 #include <memory>
+#include <optional>
 #include <ranges>
 #include <string>
 #include <unordered_map>
@@ -583,6 +584,9 @@ bool CGUIWindowVideoBase::ShowInfoAndRefresh(const CFileItemPtr& item,
                                          !item->GetVideoInfoTag()->m_strFileNameAndPath.empty()
                                      ? item->GetVideoInfoTag()->m_strFileNameAndPath
                                      : item->GetPath()};
+  // the dialog can send the refreshed details to the list item before they are compared
+  const std::optional<CVideoInfoTag> listedDetails{
+      item->HasVideoInfoTag() ? std::make_optional(*item->GetVideoInfoTag()) : std::nullopt};
   std::shared_ptr<CFileItem> updatedItem;
   const ShowInfoResult result{ShowInfo(item, info, updatedItem)};
   switch (result)
@@ -600,7 +604,8 @@ bool CGUIWindowVideoBase::ShowInfoAndRefresh(const CFileItemPtr& item,
       // Test IsActive() since we can be called from other windows (music, home) we need this check
       if (IsActive() && (result == RESULT_OK_UPDATED ||
                          !UpdateMovieListItem(listItemPath, originalFile, *updatedItem,
-                                              result == RESULT_OK_INFO_REFRESHED)))
+                                              result == RESULT_OK_INFO_REFRESHED,
+                                              listedDetails ? &*listedDetails : nullptr)))
       {
         const int selectedItem{m_viewControl.GetSelectedItem()};
         Refresh(true);
@@ -619,7 +624,8 @@ bool CGUIWindowVideoBase::ShowInfoAndRefresh(const CFileItemPtr& item,
 bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
                                               const std::string& originalFile,
                                               const CFileItem& item,
-                                              bool infoRefreshed)
+                                              bool infoRefreshed,
+                                              const CVideoInfoTag* listedDetails)
 {
   // the information dialog can move on to another item
   if (!item.HasVideoInfoTag() || item.GetVideoInfoTag()->m_type != MediaTypeMovie ||
@@ -647,13 +653,11 @@ bool CGUIWindowVideoBase::UpdateMovieListItem(const std::string& listItemPath,
   {
     // the refreshed details may change which items a filter, the watched mode or the movie set
     // grouping shows
-    const bool wasWatched{listItem->HasVideoInfoTag() &&
-                          listItem->GetVideoInfoTag()->GetPlayCount() > 0};
+    const bool wasWatched{listedDetails && listedDetails->GetPlayCount() > 0};
     if (IsFiltered() || !GetProperty("filter").empty() ||
         CURL(m_strFilterPath).HasOption("filter") ||
         wasWatched != (item.GetVideoInfoTag()->GetPlayCount() > 0) ||
-        (listItem->HasVideoInfoTag() &&
-         listItem->GetVideoInfoTag()->m_set.GetID() != item.GetVideoInfoTag()->m_set.GetID()))
+        (listedDetails && listedDetails->m_set.GetID() != item.GetVideoInfoTag()->m_set.GetID()))
       return false;
 
     if (!m_database.Open())
diff --git a/xbmc/video/windows/GUIWindowVideoBase.h b/xbmc/video/windows/GUIWindowVideoBase.h
index 1c12499..0cb8658 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.h
+++ b/xbmc/video/windows/GUIWindowVideoBase.h
@@ -114,12 +114,14 @@ protected:
    \param originalFile file of the movie the change was requested for
    \param item the changed movie
    \param infoRefreshed true if the movie was refreshed, false if only its art changed
+   \param listedDetails details of the list item before the information dialog, if infoRefreshed
    \return true if the list item was updated, false if the list has to be refreshed instead
    */
   bool UpdateMovieListItem(const std::string& listItemPath,
                            const std::string& originalFile,
                            const CFileItem& item,
-                           bool infoRefreshed);
+                           bool infoRefreshed,
+                           const CVideoInfoTag* listedDetails);
 
   void OnSearch();
   void OnSearchItemFound(const CFileItem* pSelItem);
diff --git a/xbmc/video/windows/GUIWindowVideoNav.cpp b/xbmc/video/windows/GUIWindowVideoNav.cpp
index efc99ae..403bb2e 100644
--- a/xbmc/video/windows/GUIWindowVideoNav.cpp
+++ b/xbmc/video/windows/GUIWindowVideoNav.cpp
@@ -939,7 +939,7 @@ bool CGUIWindowVideoNav::OnContextButton(int itemNumber, CONTEXT_BUTTON button)
       // changed art of a movie only needs its own list item updated
       if (ret == CONTEXT_BUTTON_SET_ART && item->HasVideoInfoTag() &&
           UpdateMovieListItem(item->GetPath(), item->GetVideoInfoTag()->m_strFileNameAndPath, *item,
-                              false))
+                              false, nullptr))
         return true;
 
       if (ret >= 0)
-- 
