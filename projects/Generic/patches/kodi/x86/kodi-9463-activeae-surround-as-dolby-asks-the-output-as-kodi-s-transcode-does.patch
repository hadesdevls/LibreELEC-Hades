diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
index db5736b..9cc6c21 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
@@ -264,6 +264,28 @@ TEST(TestAEPcmChannels, SurroundAsDolbyFailsClosed)
   EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_DOLBY));
 }
 
+TEST(TestAEPcmChannels, SurroundAsDolbyOnlyWhereTheOutputTakesIt)
+{
+  // An HDMI output whose rates the driver limits to those of a display that declares PCM up to
+  // 48 kHz and Dolby Digital Plus: E-AC-3, packed at 192 kHz, would not open, and the engine would
+  // retry with no sound. Kodi's own transcode asks the output first and takes AC-3: so does this.
+  StereoDisplayCase c = TheCase();
+  c.eac3OutputTakes = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::AC3, DolbyWhy::ENCODED));
+  // an output that takes neither: stereo
+  c.ac3OutputTakes = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_OUTPUT));
+  // one that takes Dolby Digital Plus only, for a display of Dolby Digital Plus only
+  c = TheCase({2, 0, 8});
+  c.ac3OutputTakes = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::EAC3, DolbyWhy::ENCODED));
+  // a display that declares no Dolby: that is said first, whatever the output takes
+  c = TheCase({2, 0, 0});
+  c.eac3OutputTakes = false;
+  c.ac3OutputTakes = false;
+  EXPECT_TRUE(Is(DolbyForStereoDisplay(c, true, true), DolbyEncode::NONE, DolbyWhy::NO_DOLBY));
+}
