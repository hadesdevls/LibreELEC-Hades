From e7f1cf83504482ff0eb9e12e89e9f289e9aeee0c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:45:23 +0000
Subject: [PATCH] DVHdr10PlusFill: twelve pictures without HDR10+ in a scene of
 HDR10+ are measured

Pictures without HDR10+ metadata in a scene of HDR10+ kept its metadata
until the measurement found a scene cut. Credits that lose their HDR10+
in the middle of a shot, with no cut the measurement can see (the
pictures of their own statistics are not measured, so the cut into the
credits is not seen), kept the level 1 of the scene before to the end.

Now, as the user chose: after twelve such pictures in a row (GAP_MAX,
the gap that the HDR10+ output and the decoder tolerate, CGap), the
measurement takes over once, with a scene refresh, its level 1 measured
from the first of them (Before() starts the measurement's scene at the
first picture of the stretch). A gap of fewer pictures keeps the
scene's metadata as before, and the source never changes again within
the stretch. kodi.log says when it happens, and the line of the counts
gives how many stretches were measured that way.
---
 xbmc/windowing/gbm/DVHdr10PlusFill.h          | 25 ++++++++++++++++---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 15 ++++++++---
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/DVHdr10PlusFill.h b/xbmc/windowing/gbm/DVHdr10PlusFill.h
index 728439b..a2dfcd3 100644
--- a/xbmc/windowing/gbm/DVHdr10PlusFill.h
+++ b/xbmc/windowing/gbm/DVHdr10PlusFill.h
@@ -40,8 +40,11 @@ namespace GBM
  *    measurement starts a scene there whatever it sees;
  *  - pictures without HDR10+ metadata (NONE) have no cuts of their own: in a
  *    scene of HDR10+ metadata, they keep its metadata (a gap of a few pictures in a shot) until
- *    the measurement finds a scene cut, where the measurement takes over; after measured pictures,
- *    or before any scene, they are measured.
+ *    the measurement finds a scene cut, where the measurement takes over, or until GAP_MAX of them
+ *    in a row (credits that lose their HDR10+ in the middle of a shot, where the measurement sees
+ *    no cut), where the measurement takes over once, its level 1 measured from the first of them
+ *    (Before() started its scene there); after measured pictures, or before any scene, they are
+ *    measured.
  * Within a measured scene the level 1 block is what the measurement sends: its scene cuts are
  * found as for HDR10 (dvbridge_measured_take()), and changes within a scene are as small as there.
  * A picture of a measured scene that nothing of the scene was measured for yet (the measurement
@@ -64,6 +67,9 @@ public:
   static constexpr unsigned int NONE = 3;
   static constexpr unsigned int KIND = 0x0f;
   static constexpr unsigned int CUT = 0x10;
+  //! Pictures without HDR10+ metadata in a row in a scene of HDR10+ after which they are measured
+  //! (the gap that the HDR10+ output and the decoder tolerate: KODI::UTILS::HDR10PLUS::CGap)
+  static constexpr unsigned int GAP_MAX = 12;
   //! What the measurement is asked for a picture (Before())
   enum class Take
   {
@@ -97,6 +103,8 @@ public:
     Source source = Source::NONE;
     //! the picture starts a measured scene (for the log; the picture is INCOMPLETE or NONE)
     bool measuredSceneStarts = false;
+    //! ... after GAP_MAX pictures in a row without HDR10+ metadata in a scene of HDR10+ (for the log)
+    bool afterGap = false;
   };
   struct Counts
   {
@@ -107,6 +115,7 @@ public:
     unsigned int measuredPictures = 0; //!< pictures that went out with a measured level 1 block
     unsigned int keptPictures = 0; //!< ... of a measured scene not measured yet: the last one kept
     unsigned int gapPictures = 0; //!< pictures without their own that kept their scene's metadata
+    unsigned int longGaps = 0; //!< stretches of GAP_MAX or more of them, measured from their first
     unsigned int ownPictures = 0;
   };
 
@@ -144,6 +153,7 @@ public:
       // of its own statistics: as the decoder made them; a scene refresh where the display was
       // sent another source before
       const bool back = m_source != Source::HDR10PLUS;
+      m_noneRun = 0;
       if (cut || back)
         ++m_counts.hdr10PlusScenes;
       ++m_counts.ownPictures;
@@ -170,10 +180,16 @@ public:
     const bool foundCut =
         m_take == Take::DETECT && !given && measured.measured && measured.refresh;
     const bool incompleteCut = k == INCOMPLETE && cut;
+    // (b) GAP_MAX pictures without HDR10+ metadata in a row in a scene of HDR10+: measured once
+    m_noneRun = k == NONE && m_source == Source::HDR10PLUS ? m_noneRun + 1 : 0;
+    const bool longGap = k == NONE && m_source == Source::HDR10PLUS && m_noneRun >= GAP_MAX;
     bool starts = false;
     if (m_source == Source::NONE || incompleteCut ||
-        (k == NONE && m_source == Source::HDR10PLUS && foundCut))
+        (k == NONE && m_source == Source::HDR10PLUS && (foundCut || longGap)))
     {
+      out.afterGap = longGap && !foundCut;
+      m_counts.longGaps += out.afterGap;
+      m_noneRun = 0;
       starts = true;
       m_source = Source::MEASURED;
       m_sceneMeasured = false;
@@ -246,6 +262,7 @@ public:
     m_givenPending = false;
     m_sceneMeasured = false;
     m_hadOutput = false;
+    m_noneRun = 0;
   }
   void ResetCounts() { m_counts = {}; }
   const Counts& GetCounts() const { return m_counts; }
@@ -270,6 +287,8 @@ private:
   bool m_givenPending = false;
   bool m_sceneMeasured = false; //!< the measured scene of now has a measurement of its own
   bool m_hadOutput = false; //!< a level 1 block went out since the last reset ...
+  //! pictures without HDR10+ metadata in a row in the scene of HDR10+ of now
+  unsigned int m_noneRun = 0;
   unsigned int m_last[3] = {}; //!< ... this one
   Counts m_counts;
 };
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 7b304c9..33362ed 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3736,11 +3736,13 @@ void CWinSystemGbmGLESContext::DVHdr10PlusFillTell(const char* when)
             "DVBridge: HDR10+ sent as Dolby Vision, {}: {} scenes went out with the metadata of "
             "their own HDR10+ statistics and {} with a level 1 block measured from the picture ({} "
             "of HDR10+ metadata without statistics, {} stretches without HDR10+ metadata; {} more "
-            "scene cuts found by the measurement); {} pictures with a measured level 1, {} with "
+            "scene cuts found by the measurement; {} of the stretches measured after {} pictures "
+            "without HDR10+ in a scene of HDR10+); {} pictures with a measured level 1, {} with "
             "the last one sent (their scene not measured yet), {} without statistics of their own "
             "that kept their HDR10+ scene's; now {}",
             when, c.hdr10PlusScenes, c.incompleteScenes + c.withoutScenes, c.incompleteScenes,
-            c.withoutScenes, c.measuredCuts, c.measuredPictures, c.keptPictures, c.gapPictures,
+            c.withoutScenes, c.measuredCuts, c.longGaps, CDVHdr10PlusFill::GAP_MAX,
+            c.measuredPictures, c.keptPictures, c.gapPictures,
             m_dvFill.GetSource() == CDVHdr10PlusFill::Source::MEASURED    ? "measured"
             : m_dvFill.GetSource() == CDVHdr10PlusFill::Source::HDR10PLUS ? "from HDR10+"
                                                                           : "no scene");
@@ -3815,7 +3817,14 @@ void CWinSystemGbmGLESContext::DVHdr10PlusMetadata(const CDVBridgeGLES::Layer& l
     out = m_dvFill.After(kind, own, ownValid, measured);
     m_dvFillLast = out;
     m_dvFillHaveLast = true;
-    if (out.measuredSceneStarts && !m_dvFillTold)
+    if (out.afterGap)
+      CLog::Log(LOGINFO,
+                "DVBridge: HDR10+ sent as Dolby Vision: {} pictures in a row without HDR10+ metadata "
+                "in a scene of HDR10+, at {:.3f} s (credits that lose them, or a stream that leaves "
+                "them out): its level 1 block is measured from the picture from the first of them on, "
+                "once, and the display stays in Dolby Vision",
+                CDVHdr10PlusFill::GAP_MAX, layer.pts / DVD_TIME_BASE);
+    else if (out.measuredSceneStarts && !m_dvFillTold)
     {
       m_dvFillTold = true;
       CLog::Log(LOGINFO,
