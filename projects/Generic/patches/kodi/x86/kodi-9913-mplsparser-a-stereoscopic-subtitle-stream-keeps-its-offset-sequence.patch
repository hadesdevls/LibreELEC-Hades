From e5f16dd84c8fe6965b77d9a1b43e276a29d3f676 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:47:15 +0000
Subject: [PATCH] MPLSParser: a stereoscopic subtitle stream keeps its offset
 sequence

The stereoscopic stream number table (STN_table_SS) gives each subtitle
stream of a play item two bytes: the offset sequence the stream follows
when its one plane is shifted in depth, then a byte of flags. Where the
flags say that more follows (a stereoscopic stream with a plane per eye),
the parser stopped at that stream before taking its sequence, and every
play item after it was left unread too.

The first byte is the stream's sequence whatever the flags say: tsMuxer's
reader and writer of this table read and write the same two bytes the same
way, and the parser already relied on that for the streams before it. Kodi
draws every subtitle stream as one plane, so that is the sequence it
follows. What follows the flags is still not read (its layout is not known
for certain), so the streams after it in that play item keep nothing, as
before. Each play item's table carries its own length, so the next play
item's table is read as usual.

StreamInformation::offsetSequenceRead says whether the table was read as
far as a stream's entry, so that "the playlist names no sequence" and "the
table was not read that far" can be told apart.
---
 xbmc/filesystem/bluray/MPLSParser.cpp | 19 +++++++++++++------
 xbmc/filesystem/bluray/MPLSParser.h   |  4 ++++
 2 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/xbmc/filesystem/bluray/MPLSParser.cpp b/xbmc/filesystem/bluray/MPLSParser.cpp
index 3662b86..6017cd5 100644
--- a/xbmc/filesystem/bluray/MPLSParser.cpp
+++ b/xbmc/filesystem/bluray/MPLSParser.cpp
@@ -932,21 +932,28 @@ bool ParseStreamNumberTableSS(std::vector<std::byte>& buffer,
       const unsigned int flags{GetByte(buffer, p + 1)};
       p += 2;
 
+      // Hades: the first byte of every entry is the sequence the stream follows when its one
+      // plane is shifted in depth, which is how Kodi draws every subtitle stream, so it is the
+      // stream's own also where the flags announce more after it. (The same two bytes, read
+      // the same way, in tsMuxer's reader and writer of this table.)
+      stream.offsetSequenceId = offsetSequenceId;
+      stream.offsetSequenceRead = true;
+
       // A stereoscopic subtitle stream has a right eye plane of its own, and a stream
       // entry for it follows inline. Skipping an entry whose length is only guessed at
       // would put every stream after it out of step, so stop here rather than mislabel
       // them - the streams read so far keep what they were given.
+      // (Hades: only this play item's table stops. The next one starts where this one's
+      // length says, which is known, so it is read as usual.)
       if (flags != 0)
       {
         CLog::LogFC(LOGDEBUG, LOGBLURAY,
-                    "Stereoscopic stream number table - subtitle stream carries flags {:#04x}, "
-                    "stopping",
-                    flags);
-        return true;
+                    "Stereoscopic stream number table - subtitle stream PID {:#06x} follows "
+                    "offset sequence {} and carries flags {:#04x}, stopping for this play item",
+                    stream.packetIdentifier, offsetSequenceId, flags);
+        break;
       }
 
-      stream.offsetSequenceId = offsetSequenceId;
-
       if (offsetSequenceId != NO_OFFSET_SEQUENCE)
         CLog::LogFC(LOGDEBUG, LOGBLURAY,
                     "Stereoscopic stream number table - subtitle stream PID {:#06x} follows "
diff --git a/xbmc/filesystem/bluray/MPLSParser.h b/xbmc/filesystem/bluray/MPLSParser.h
index 58534d2..229a3f0 100644
--- a/xbmc/filesystem/bluray/MPLSParser.h
+++ b/xbmc/filesystem/bluray/MPLSParser.h
@@ -114,6 +114,10 @@ struct StreamInformation
   std::vector<unsigned int> secondaryVideo_presentationGraphicReferences;
   //! Blu-ray 3D: the offset sequence that places this stream's plane in depth
   unsigned int offsetSequenceId{NO_OFFSET_SEQUENCE};
+  //! Hades: whether the stereoscopic table was read as far as this stream's entry. It is not
+  //! where the table stops early (see ParseStreamNumberTableSS()), and then offsetSequenceId
+  //! says nothing about the stream.
+  bool offsetSequenceRead{false};
 };
 
 struct ProgramInformation
