From a3be7ff66bc382cd8105d73a72b8fdface001e4e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:13:55 +0000
Subject: [PATCH] dvbridge: tell whether a render drew the residual of the
 enhancement layer

CDVBridgeGLES::Prepare() and PrepareConversion() mapped the Dolby Vision
metadata of every frame once more, as paired with its enhancement layer, to
tell whether the frame was drawn with the residual of that layer (player
information, statistics, the load of CDVFrameLoad). The render already
knows: it pairs the layer by its time and maps the metadata itself.
dvbridge_render_residual_drawn() gives what it found, for the native and
the HDR10 render.

It is what the second mapping gave in every case: the layer paired, the
NLQ of the mapping; the layer not paired, the residual omitted, which that
formula left out by dvbridge_render_residual_omitted(); no NLQ, nothing.

Tested on the host with the FEL test stream through the software OpenGL ES
(zink on lavapipe): in 144 renders (composed, direct, for output as HDR10,
and with the layer not paired with its picture: 120 with the residual
drawn, 12 with it omitted) the getter and the old formula agree; the
hashes of all 36 drawings of the render test are those of rc14-wip.
The mapping takes 0.2 microseconds on a desktop processor: this leaves one
answer instead of two, the time saved is negligible.
---
 tools/dvbridge/dvbridge_render.c                   | 14 +++++++++++++-
 tools/dvbridge/dvbridge_render.h                   |  5 +++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.cpp    | 13 +++++--------
 3 files changed, 23 insertions(+), 9 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 00ebf0c..31e3297 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -31,6 +31,9 @@ struct dvbridge_renderer {
     bool ready;
     bool packed, fragment_quad;
     bool residual_omitted; /* Hades: last prepared FEL picture drawn without its residual */
+    /* Hades: the last render drew the residual of the enhancement layer: the layer was paired
+     * with the picture and the mapping of its metadata reconstructs residuals (NLQ active) */
+    bool residual_drawn;
     /* Hades: the area outside the active picture was written before the reconstruction in the
      * last render (see skip_inactive_area()). That is left out while it is turned off
      * (dvbridge_render_allow_early_mask()), and by the packed render [1] or the other one [0]
@@ -412,6 +415,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     r->ready = false;
     r->early_mask = false;
     r->residual_omitted = false;
+    r->residual_drawn = false;
     r->packed = packed != NULL;
     dvbridge_candidate_destroy(r->pending);
     r->pending = NULL;
@@ -434,10 +438,11 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     struct dvbridge_color mapped;
     if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
+    r->residual_drawn = paired && mapped.dovi.nlq_active;
     /* The composition is settled: the residual is reconstructed, or deliberately omitted
      * while the decoder resynchronizes the enhancement layer (counted by the caller). */
     r->pending = dvbridge_prepare(r->context, metadata, bytes, pts, geometry,
-                                 (paired && mapped.dovi.nlq_active) || r->residual_omitted);
+                                 r->residual_drawn || r->residual_omitted);
     if (!r->pending)
         return false;
     struct dvbridge_reading reading;
@@ -665,6 +670,7 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     struct dvbridge_color mapped;
     if (!map_layers(r, &mapped, source, metadata, bytes, &paired))
         return false;
+    r->residual_drawn = paired && mapped.dovi.nlq_active;
     /* The format of the picture that the transport is packed from. A half-float one would be half
      * the memory, and it is not as good: stored in one by a software renderer, the picture came
      * out up to half a code of 1023 below this one (the values were cut off, not rounded). */
@@ -724,6 +730,7 @@ bool dvbridge_render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *s
         return false;
     r->hdr10_ready = false;
     r->residual_omitted = false;
+    r->residual_drawn = false;
     /* errors left by earlier, unrelated GL work are not ours, as in dvbridge_render_rgb() */
     for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
         ;
@@ -764,6 +771,11 @@ bool dvbridge_render_residual_omitted(const struct dvbridge_renderer *r)
     return r && r->residual_omitted;
 }
 
+bool dvbridge_render_residual_drawn(const struct dvbridge_renderer *r)
+{
+    return r && r->residual_drawn;
+}
+
 int dvbridge_render_early_mask(const struct dvbridge_renderer *r, bool packed)
 {
     if (!r || r->early_off)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 351df5e..5d83219 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -82,6 +82,11 @@ const struct dvbridge_candidate *dvbridge_render_candidate(const struct dvbridge
 bool dvbridge_render_commit(struct dvbridge_renderer *renderer);
 /* Hades: the last prepared picture is FEL drawn without its residual (no enhancement picture). */
 bool dvbridge_render_residual_omitted(const struct dvbridge_renderer *renderer);
+/* Hades: the last prepared picture was drawn with the residual of its enhancement layer: the
+ * layer was paired with it and the mapping of its metadata reconstructs residuals. What the
+ * caller would otherwise map the metadata once more to know, as the render mapped it. */
+#define DVBRIDGE_RENDER_RESIDUAL_DRAWN 1
+bool dvbridge_render_residual_drawn(const struct dvbridge_renderer *renderer);
 /* Hades: what the packed render, or the other one, does with the area outside the active
  * picture. 0: written with the rest (the last render had none, was scaled or was of the other
  * kind, or it is turned off). 1: written before the reconstruction in the last render. 2: no
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index ee8ef50..54ce800 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -336,11 +336,11 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
     const auto* parsed = reinterpret_cast<const AVDOVIMetadata*>(metadata.Data());
     // An enhancement surface can also belong to MEL. Report FEL only when
     // the same mapping used by the renderer actually reconstructs residuals.
+    // (Hades: as the render mapped it, which is what mapping the metadata once more as paired
+    // with its layer told: a FEL picture whose layer was not paired with it was drawn without
+    // its residual, which that counted as omitted.)
     const bool omitted = dvbridge_render_residual_omitted(m_renderer);
-    dvbridge_color color{};
-    const bool fel = enhancement && !omitted &&
-                     dvbridge_map_color(&color, metadata.Data(), metadata.Size(), true, nullptr) &&
-                     color.dovi.nlq_active;
+    const bool fel = enhancement && dvbridge_render_residual_drawn(m_renderer);
     m_pendingInfo = CDVPlaybackInfo::HDMI | (fel ? CDVPlaybackInfo::FEL : 0u);
     m_pendingDetail = {};
     m_pendingDetail.valid = true;
@@ -681,10 +681,7 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
     // FEL only when the mapping that the renderer used reconstructs residuals, as for native
     // output
     const bool omitted = dvbridge_render_residual_omitted(m_renderer);
-    dvbridge_color color{};
-    const bool fel = layered && !omitted &&
-                     dvbridge_map_color(&color, metadata.Data(), metadata.Size(), true, nullptr) &&
-                     color.dovi.nlq_active;
+    const bool fel = layered && dvbridge_render_residual_drawn(m_renderer);
     m_convertView = view;
     m_convertWidth = width;
     m_convertHeight = height;
-- 
