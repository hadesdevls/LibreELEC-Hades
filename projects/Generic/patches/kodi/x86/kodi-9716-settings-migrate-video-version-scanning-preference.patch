From ce8b6a0fac200bc026afc2fbb7791ca66922b861 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Tue, 27 Oct 2026 08:40:28 -0700
Subject: [PATCH] [settings] Migrate video version scanning preference

Migrate only explicitly configured Kodi 21 video version preferences,
preserving any existing replacement value. Untouched preferences adopt
Kodi 22's new default of Auto (2).
---
 xbmc/settings/lib/SettingsMigrationSteps.cpp  | 16 ++++-
 .../lib/test/TestSettingsMigration.cpp        | 70 +++++++++++++++++++
 2 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/xbmc/settings/lib/SettingsMigrationSteps.cpp b/xbmc/settings/lib/SettingsMigrationSteps.cpp
index 518cd04..046c90e 100644
--- a/xbmc/settings/lib/SettingsMigrationSteps.cpp
+++ b/xbmc/settings/lib/SettingsMigrationSteps.cpp
@@ -8,7 +8,10 @@
 
 #include "SettingsMigrationSteps.h"
 
+#include "SettingDefinitions.h"
+#include "SettingsManager.h"
 #include "SettingsMigrationPrimitive.h"
+#include "utils/StringUtils.h"
 
 #include <array>
 #include <string_view>
@@ -27,8 +30,17 @@ public:
     constexpr std::string_view oldSettingId = "dvds.autorun";
     constexpr std::string_view newSettingId = "dvds.autoaction";
 
-    return FAILURE != ConvertSettingBoolToInt(root, oldSettingId, newSettingId,
-                                              {.m_default = 0, .m_false = 0, .m_true = 1});
+    bool ret = FAILURE != ConvertSettingBoolToInt(root, oldSettingId, newSettingId,
+                                                  {.m_default = 0, .m_false = 0, .m_true = 1});
+    const TiXmlElement* versions =
+        CSettingsManager::LocateSetting(root, "videolibrary.ignorevideoversions");
+    const char* isDefault = versions ? versions->Attribute(SETTING_XML_ELM_DEFAULT) : nullptr;
+    if (versions && !(isDefault && StringUtils::EqualsNoCase(isDefault, "true")) &&
+        CSettingsManager::LocateSetting(root, "videolibrary.similarvideoaction") == nullptr)
+      ret &= FAILURE != ConvertSettingBoolToInt(root, "videolibrary.ignorevideoversions",
+                                                "videolibrary.similarvideoaction",
+                                                {.m_default = 2, .m_false = 1, .m_true = 0});
+    return ret;
   }
 };
 
diff --git a/xbmc/settings/lib/test/TestSettingsMigration.cpp b/xbmc/settings/lib/test/TestSettingsMigration.cpp
index e9e757f..eb2ba7e 100644
--- a/xbmc/settings/lib/test/TestSettingsMigration.cpp
+++ b/xbmc/settings/lib/test/TestSettingsMigration.cpp
@@ -10,6 +10,7 @@
 #include "settings/lib/SettingsManager.h"
 #include "settings/lib/SettingsMigration.h"
 #include "utils/XBMCTinyXML.h"
+#include "utils/XMLUtils.h"
 
 #include <stdexcept>
 #include <string>
@@ -128,6 +129,75 @@ TEST(TestSettingsMigration, MultipleMigrationStepsSameTarget)
   EXPECT_THROW({ CSettingsMigration(std::move(steps)); }, std::invalid_argument);
 }
 
+namespace
+{
+struct VideoVersionsMigrationTest
+{
+  std::string_view settings;
+  std::string_view expectedSettings;
+};
+
+constexpr VideoVersionsMigrationTest VideoVersionsMigrationTests[]{
+    {R"(<setting id="videolibrary.ignorevideoversions">true</setting>)",
+     R"(<setting id="videolibrary.similarvideoaction">0</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions">false</setting>)",
+     R"(<setting id="videolibrary.similarvideoaction">1</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions" default="true">true</setting>)",
+     R"(<setting id="videolibrary.ignorevideoversions" default="true">true</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions" default="TrUe">true</setting>)"
+     R"(<setting id="dvds.autorun">true</setting>)",
+     R"(<setting id="videolibrary.ignorevideoversions" default="TrUe">true</setting>)"
+     R"(<setting id="dvds.autoaction">1</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions" default="false">true</setting>)",
+     R"(<setting id="videolibrary.similarvideoaction">0</setting>)"},
+    {"", ""},
+    {R"(<setting id="dvds.autorun">true</setting>)",
+     R"(<setting id="dvds.autoaction">1</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions">true</setting>)"
+     R"(<setting id="videolibrary.similarvideoaction">1</setting>)",
+     R"(<setting id="videolibrary.ignorevideoversions">true</setting>)"
+     R"(<setting id="videolibrary.similarvideoaction">1</setting>)"},
+    {R"(<setting id="videolibrary.ignorevideoversions">false</setting>)"
+     R"(<setting id="videolibrary.similarvideoaction" default="true">2</setting>)"
+     R"(<setting id="dvds.autorun">true</setting>)",
+     R"(<setting id="videolibrary.ignorevideoversions">false</setting>)"
+     R"(<setting id="videolibrary.similarvideoaction" default="true">2</setting>)"
+     R"(<setting id="dvds.autoaction">1</setting>)"},
+};
+} // namespace
+
+class TestSettingsMigrationToV3VideoVersions
+  : public testing::WithParamInterface<VideoVersionsMigrationTest>,
+    public testing::Test
+{
+};
+
+TEST_P(TestSettingsMigrationToV3VideoVersions, MigratesVideoVersionPreference)
+{
+  const auto& params = GetParam();
+  const std::string prefix = R"(<settings version="2">)"
+                             R"(<setting id="lookandfeel.skin">skin.estuary</setting>)";
+  const std::string xml = prefix + std::string{params.settings} + "</settings>";
+  const std::string expectedXml = prefix + std::string{params.expectedSettings} + "</settings>";
+
+  for (const int targetVersion : {3, static_cast<int>(CSettingsManager::Version)})
+  {
+    SCOPED_TRACE(targetVersion);
+    CXBMCTinyXML doc;
+    ASSERT_TRUE(doc.Parse(xml));
+
+    CSettingsMigration migration;
+    ASSERT_TRUE(migration.UpdateXMLSettings(doc.RootElement(), 2, targetVersion));
+
+    EXPECT_EQ(expectedXml, XMLUtils::NodeStringSerialization(
+                               doc.RootElement(), XMLUtils::SerializationFormat::COMPACT));
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(TestSettingsMigration,
+                         TestSettingsMigrationToV3VideoVersions,
+                         testing::ValuesIn(VideoVersionsMigrationTests));
+
 namespace
 {
 struct ReplayGainMigrationTest
-- 
