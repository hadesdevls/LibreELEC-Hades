+#include "BlurayJava.h"
+
+#include "ServiceBroker.h"
+#include "addons/AddonManager.h"
+#include "addons/IAddon.h"
+#include "dialogs/GUIDialogKaiToast.h"
+#include "filesystem/SpecialProtocol.h"
+#include "guilib/GUIUtils.h"
+#include "resources/LocalizeStrings.h"
+#include "resources/ResourcesComponent.h"
+#include "utils/StringUtils.h"
+#include "utils/log.h"
+
+#include <cstdlib>
+
+#include <libbluray/bluray.h>
+
+namespace KODI
+{
+namespace BLURAYJAVA
+{
+namespace
+{
+std::string LibblurayVersion()
+{
+  int major = 0;
+  int minor = 0;
+  int micro = 0;
+  bd_get_version(&major, &minor, &micro);
+  return std::to_string(major) + "." + std::to_string(minor) + "." + std::to_string(micro);
+}
+
+BdjFacts GatherBdjFacts(bool libjvmDetected, bool bdjHandled)
+{
+  BdjFacts facts;
+  facts.libjvmDetected = libjvmDetected;
+  facts.bdjHandled = bdjHandled;
+  // Read only: libbluray reads the same variables with getenv() on its own.
+  if (const char* home = std::getenv("JAVA_HOME"))
+    facts.javaHome = home;
+  if (const char* path = std::getenv("LD_LIBRARY_PATH"))
+    facts.libraryPath = path;
+
+  ADDON::AddonPtr addon;
+  if (CServiceBroker::GetAddonMgr().GetAddon(std::string(JRE_ADDON_ID), addon,
+                                             ADDON::OnlyEnabled::CHOICE_NO) &&
+      addon)
+  {
+    // Enabled or not: its profile is read at the start either way (00-addons.conf).
+    facts.addonInstalled = true;
+    facts.addonPath = CSpecialProtocol::TranslatePath(addon->Path());
+  }
+  return facts;
+}
+} // namespace
+
+BdjReport ReportBdj(bool libjvmDetected, bool bdjHandled, std::string_view where)
+{
+  BdjReport report;
+  report.facts = GatherBdjFacts(libjvmDetected, bdjHandled);
+  report.state = DecideBdj(report.facts);
+  report.version = LibblurayVersion();
+  CLog::Log(report.state == BdjState::READY ? LOGINFO : LOGWARNING, "{} - {}", where,
+            DescribeBdj(report.state, report.facts, report.version));
+  return report;
+}
+
+std::string BdjUserText(const BdjReport& report)
+{
+  const BdjMessageIds ids = BdjMessage(report.state);
+  if (ids.core == 0)
+    return {};
+  std::string text = CGUIUtils::GetHadesString(ids.core, ids.estuary);
+  if (report.state == BdjState::RUNTIME_NOT_LOADABLE)
+    StringUtils::Replace(text, "{0}",
+                         report.facts.javaHome.empty() ? std::string("JAVA_HOME")
+                                                       : report.facts.javaHome);
+  else if (report.state == BdjState::NO_JAR)
+    StringUtils::Replace(text, "{0}", report.version);
+  return text;
+}
+
+void NotifyBdj(const BdjReport& report)
+{
+  const std::string text = BdjUserText(report);
+  if (text.empty())
+    return;
+  // #29803: "BD-J menu error", Kodi's own heading for this, translated by Kodi
+  CGUIDialogKaiToast::QueueNotification(
+      CGUIDialogKaiToast::Warning,
+      CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(29803), text, 12000);
+}
+
+} // namespace BLURAYJAVA
+} // namespace KODI
