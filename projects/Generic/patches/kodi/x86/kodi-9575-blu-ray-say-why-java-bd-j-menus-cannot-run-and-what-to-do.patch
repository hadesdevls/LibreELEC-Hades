+/*!
+ * \brief What stands between a Blu-ray disc and its Java (BD-J) menus.
+ *
+ * libbluray answers with two bits (BLURAY_DISC_INFO::libjvm_detected and bdj_handled): a JVM can
+ * be loaded, and the jar of this very libbluray version was found as well. Why not is in the
+ * environment that Kodi was started with. On LibreELEC the Java runtime is an add-on, "JRE for
+ * BD-J menus" (tools.jre.zulu), and what it needs comes from its profile, which kodi.sh reads once,
+ * when Kodi starts: JAVA_HOME, its folder, where libbluray loads the JVM from, and its lib folder
+ * in LD_LIBRARY_PATH, with the X11 libraries that the JVM's AWT loads when a menu starts. So an
+ * add-on installed while Kodi runs is not in effect until Kodi starts again, and nothing that Kodi
+ * could set from inside changes the library path of the dynamic loader: that is a restart, not a
+ * missing Java, and it is said so.
+ */
+enum class BdjState
+{
+  READY, //!< a JVM loads and the jar of this libbluray was found
+  NO_RUNTIME, //!< no JVM, JAVA_HOME is not set and the Java runtime add-on is not installed
+  RESTART_NEEDED, //!< the add-on is installed, but this Kodi was started before it
+  RUNTIME_NOT_LOADABLE, //!< JAVA_HOME is in effect (the add-on's or another), no JVM loads from it
+  NO_JAR, //!< a JVM loads, the jar of this libbluray version was not found
+};
+
+//! The Java runtime add-on of LibreELEC's repository
+inline constexpr std::string_view JRE_ADDON_ID = "tools.jre.zulu";
+
+struct BdjFacts
+{
+  bool libjvmDetected = false; //!< BLURAY_DISC_INFO::libjvm_detected
+  bool bdjHandled = false; //!< BLURAY_DISC_INFO::bdj_handled
+  std::string javaHome; //!< JAVA_HOME of this process, empty when it is not set
+  std::string libraryPath; //!< LD_LIBRARY_PATH of this process
+  bool addonInstalled = false; //!< the Java runtime add-on is installed, enabled or not
+  std::string addonPath; //!< its folder
+};
+
+//! A folder without the slashes at its end ("/" stays "/")
+inline std::string_view WithoutEndSlashes(std::string_view dir)
+{
+  while (dir.size() > 1 && dir.back() == '/')
+    dir.remove_suffix(1);
+  return dir;
+}
+
+inline bool SameFolder(std::string_view a, std::string_view b)
+{
+  return !a.empty() && !b.empty() && WithoutEndSlashes(a) == WithoutEndSlashes(b);
+}
+
+//! Whether a list of folders separated by ':' (LD_LIBRARY_PATH) names this one
+inline bool FolderListHas(std::string_view list, std::string_view dir)
+{
+  while (true)
+  {
+    const size_t colon = list.find(':');
+    if (SameFolder(list.substr(0, colon), dir))
+      return true;
+    if (colon == std::string_view::npos)
+      return false;
+    list.remove_prefix(colon + 1);
+  }
+}
+
+//! The add-on's folder of libraries (X11 for the JVM's AWT)
+inline std::string AddonLibFolder(const BdjFacts& facts)
+{
+  return std::string(WithoutEndSlashes(facts.addonPath)) + "/lib";
+}
+
+//! Whether the add-on's profile was read when this Kodi started
+inline bool AddonInEffect(const BdjFacts& facts)
+{
+  if (!facts.addonInstalled || facts.addonPath.empty())
+    return false;
+  return SameFolder(facts.javaHome, facts.addonPath) &&
+         FolderListHas(facts.libraryPath, AddonLibFolder(facts));
+}
+
+inline BdjState DecideBdj(const BdjFacts& facts)
+{
+  if (facts.bdjHandled)
+    return BdjState::READY;
+  if (facts.libjvmDetected)
+    return BdjState::NO_JAR;
+  if (facts.addonInstalled)
+    return AddonInEffect(facts) ? BdjState::RUNTIME_NOT_LOADABLE : BdjState::RESTART_NEEDED;
+  return facts.javaHome.empty() ? BdjState::NO_RUNTIME : BdjState::RUNTIME_NOT_LOADABLE;
+}
+
+//! The text for the user: {core string, its translation in Estuary}; {0, 0} when there is none
+struct BdjMessageIds
+{
+  unsigned int core;
+  unsigned int estuary;
+};
+
+inline BdjMessageIds BdjMessage(BdjState state)
+{
+  switch (state)
+  {
+    case BdjState::NO_RUNTIME:
+      return {39866, 32119};
+    case BdjState::RESTART_NEEDED:
+      return {39867, 32120};
+    case BdjState::RUNTIME_NOT_LOADABLE:
+      return {39868, 32121}; // {0}: JAVA_HOME
+    case BdjState::NO_JAR:
+      return {39869, 32122}; // {0}: the version of libbluray
+    case BdjState::READY:
+      break;
+  }
+  return {0, 0};
+}
+
+//! One line for kodi.log: what was found, or what is missing and why
+inline std::string DescribeBdj(BdjState state, const BdjFacts& facts, std::string_view version)
+{
+  const std::string home = facts.javaHome.empty() ? std::string("not set") : facts.javaHome;
+  const std::string jar = "libbluray-j2se-" + std::string(version) + ".jar";
+  const std::string addon = std::string(JRE_ADDON_ID);
+  switch (state)
+  {
+    case BdjState::READY:
+    {
+      std::string line = "Blu-ray Java menus can run: libbluray " + std::string(version) +
+                         " loads a JVM (JAVA_HOME " + home + ") and has " + jar +
+                         " (its line \"BD-J check: OK\" says which)";
+      if (facts.addonInstalled && SameFolder(facts.javaHome, facts.addonPath) &&
+          !FolderListHas(facts.libraryPath, AddonLibFolder(facts)))
+        line += "; but " + AddonLibFolder(facts) +
+                " is not in LD_LIBRARY_PATH, and the JVM needs the X11 libraries there to show a "
+                "menu";
+      return line;
+    }
+    case BdjState::NO_RUNTIME:
+      return "Blu-ray Java menus cannot run: there is no Java runtime (JAVA_HOME is not set and the "
+             "add-on " +
+             addon + ", \"JRE for BD-J menus\", is not installed)";
+    case BdjState::RESTART_NEEDED:
+      return "Blu-ray Java menus cannot run yet: the add-on " + addon + " is installed in " +
+             facts.addonPath + ", but this Kodi was started before it (JAVA_HOME " + home + ", " +
+             AddonLibFolder(facts) +
+             (FolderListHas(facts.libraryPath, AddonLibFolder(facts)) ? " in" : " not in") +
+             " LD_LIBRARY_PATH): Kodi has to be started again";
+    case BdjState::RUNTIME_NOT_LOADABLE:
+      return "Blu-ray Java menus cannot run: no JVM loads from JAVA_HOME " + home +
+             (facts.addonInstalled ? " (the add-on " + addon + ")" : std::string());
+    case BdjState::NO_JAR:
+      return "Blu-ray Java menus cannot run: a JVM loads (JAVA_HOME " + home + "), but " + jar +
+             " and libbluray-awt-j2se-" + std::string(version) +
+             ".jar were not found; the jar of another libbluray version cannot be used";
+  }
+  return {};
+}
+
+//! What libbluray answered, with the rest of the facts gathered from this Kodi
+struct BdjReport
+{
+  BdjState state = BdjState::NO_RUNTIME;
+  BdjFacts facts;
+  std::string version; //!< of the libbluray that runs
+};
+
+/*!
+ * \brief Gather the facts, decide, and say it in kodi.log (info when menus can run, warning when
+ *        not)
+ * \param where Who asks, for the log line
+ */
+BdjReport ReportBdj(bool libjvmDetected, bool bdjHandled, std::string_view where);
+
+//! The message for the user (empty for READY), in the language of the GUI where Estuary has it
+std::string BdjUserText(const BdjReport& report);
+
+//! A notification with that message (nothing for READY)
+void NotifyBdj(const BdjReport& report);
+
+} // namespace BLURAYJAVA
+} // namespace KODI
