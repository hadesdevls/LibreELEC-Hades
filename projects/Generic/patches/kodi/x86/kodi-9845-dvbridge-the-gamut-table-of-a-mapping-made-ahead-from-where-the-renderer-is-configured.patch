From 8cefd0fe82a298be36dd74f98259f67e66b4c77a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:29:14 +0000
Subject: [PATCH] DVBridge: the gamut table of a mapping made ahead from where
 the renderer is configured

The bridge that draws the pictures converted for output (Dolby Vision as
HDR10 or to SDR, HDR10 adapted to the display, HDR10 and HLG to SDR) was
made by the first such picture, which set its mapping then: the gamut table
made ahead from when a mapping is set (dvbridge_render.c) would have had no
time before that picture needed it. The bridge is now made and its mapping
set where the renderer is configured for the video
(CWinSystemGbmGLESContext::DVConversionAhead(), from
CLinuxRendererGLES::Configure()), the way the first picture made it
(ConversionBridge(), which both now use): the table is made while the
output changes mode and the first picture is decoded. A mapping that is off
or not valid is left for the first picture, as before. Native output sets
its mapping where it begins (Low-Latency, BeginDVBridge()), as it did.

kodi.log says, once for each table that libplacebo takes, how it was made:
"the gamut mapping table was made ahead, on a thread of its own, in N ms;
the first picture that maps needed it M ms after it was asked for, and did
not wait for it", or that it was made while a picture waited for it, and
why. advancedsettings.xml <video><dvgamutahead>false</dvgamutahead></video>
turns it off, to compare: a diagnostic key, not a choice, the table being
the same byte for byte.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 44 ++++++++++++++++++-
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  8 ++++
 .../VideoRenderers/LinuxRendererGLES.cpp      |  5 +++
 xbmc/settings/AdvancedSettings.cpp            |  2 +
 xbmc/settings/AdvancedSettings.h              |  6 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 40 ++++++++++++-----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 15 +++++++
 7 files changed, 107 insertions(+), 13 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index e57d9f0..9436c53 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -577,6 +577,8 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
       !pl_opengl_has_ext(m_gl, "GL_OES_texture_float_linear"))
     return Fail("float-blend-or-float-linear-capability");
   m_renderer = dvbridge_renderer_create(m_gl->gpu, m_log);
+  // Hades: before the mapping of Low-Latency is set, below (it makes its gamut table ahead)
+  UseGamutAheadSetting();
   if (passTimes && m_renderer)
   {
     dvbridge_render_time_passes(m_renderer, true);
@@ -1071,8 +1073,9 @@ void CDVBridgeGLES::LogEarlyMask(bool packed)
 
 void CDVBridgeGLES::LogNotes()
 {
-  // Hades: and the gamut mapping table of a picture that was mapped
+  // Hades: and the gamut mapping table of a picture that was mapped, and how it was made
   LogGamutTable();
+  LogGamutMade();
   // Hades: the compute pass of the rows of 4:2:2 chroma that Initialize() said is in use failed (a GL
   // error): the frame was made again by the fragment pass, and so are the rest (dvcomputerows)
   if (m_computeRowsSaid && m_renderer && !dvbridge_render_compute_rows_usable(m_renderer))
@@ -2189,6 +2192,44 @@ void CDVBridgeGLES::LogGamutTable()
                               : "");
 }
 
+void CDVBridgeGLES::UseGamutAheadSetting()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  m_gamutAhead = !advanced || advanced->m_videoDVGamutAhead;
+  dvbridge_render_use_gamut_ahead(m_renderer, m_gamutAhead);
+}
+
+void CDVBridgeGLES::LogGamutMade()
+{
+  // Hades: the gamut mapping table that the first picture of a mapping needs, made ahead on a
+  // thread of its own from when the mapping was set (dvbridge_render_gamut_made()). It was made by
+  // that picture, on the thread that draws, while the picture and the interface waited for it: a
+  // long pass of the interface at the start of a video (issue #3). Once for each table taken
+  // (a renderer keeps its table for the videos of the same mapping).
+  dvbridge_gamut_made made{};
+  if (!m_renderer || !dvbridge_render_gamut_made(m_renderer, &made) ||
+      made.serial == m_gamutMadeLogged)
+    return;
+  m_gamutMadeLogged = made.serial;
+  if (made.ahead)
+    CLog::Log(LOGINFO,
+              "DVBridge: the gamut mapping table was made ahead, on a thread of its own, in {:.0f} "
+              "ms; the first picture that maps needed it {:.0f} ms after it was asked for, {}",
+              made.make_ms, made.lead_ms,
+              made.wait_ms >= 0.5
+                  ? StringUtils::Format("and waited {:.0f} ms for the rest of it", made.wait_ms)
+                  : std::string("and did not wait for it"));
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: the gamut mapping table was made while a picture waited for it, in {:.0f} "
+              "ms, on the thread that draws{}",
+              made.make_ms,
+              made.ahead_other ? " (the one made ahead was for another mapping)"
+              : !m_gamutAhead  ? " (advancedsettings.xml: dvgamutahead is off)"
+                               : "");
+}
+
 bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
 {
   if (m_gl)
@@ -2218,6 +2259,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   UseShaderCache();
   m_conversion = true;
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
+  UseGamutAheadSetting();
   UseComposerSetting();
   UseGamutSetting();
   UseMmrTableSetting();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index f54f760..bcdfb2d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -598,6 +598,12 @@ private:
   //! Hades: which gamut mapping table the last mapping took, when that is new (once for a table
   //! and its format)
   void LogGamutTable();
+  //! Hades: whether the gamut mapping table of a mapping to the display is made ahead, as
+  //! advancedsettings.xml says (dvgamutahead; with a renderer that has just been made)
+  void UseGamutAheadSetting();
+  //! Hades: how the gamut mapping table that libplacebo took was made (ahead, on a thread of its
+  //! own, or while a picture waited for it), once for each table it takes
+  void LogGamutMade();
   //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
   //! \param before what runs next, for the log
   void TakeStaleGLErrors(const char* before);
@@ -626,6 +632,8 @@ private:
   bool m_ccmComposer = true; //!< Hades: see UseComposer()
   bool m_fineGamut = false; //!< Hades: see UseGamutTable()
   bool m_gamutLogged = false; //!< Hades: see LogGamutTable()
+  bool m_gamutAhead = true; //!< Hades: see UseGamutAheadSetting()
+  unsigned int m_gamutMadeLogged = 0; //!< Hades: see LogGamutMade()
   dvbridge_gamut_table m_gamutLast{};
   DVBRIDGE::DiagnosticFailures m_failures;
   unsigned int m_staleGLErrors = 0; //!< times that TakeStaleGLErrors() found some
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index 735bc57..0b2bf3e 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -280,6 +280,8 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
     // again
     const dvbridge_hdr10_mapping mapping = dvWindow->TakeDVConversionMapping(picture, sdr);
     m_dvConvertDescribed = CDVBridgeGLES::ConversionOutput(picture, hdr10, &mapping);
+    // Hades: its gamut mapping table made ahead, while the first picture is decoded
+    dvWindow->DVConversionAhead(true);
     m_dvConvertMapped = mapping.enabled;
     // Hades: ... and to SDR, whether the bridge can map its base layer there, for a picture that
     // cannot be reconstructed
@@ -295,6 +297,7 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   {
     dvWindow->TakeDVConversionMapping(picture, true, true);
     CDVBridgeGLES::ConversionOutputSdr(picture, hdr10);
+    dvWindow->DVConversionAhead(false);
   }
   // Hades: or an HDR10 or HDR10+ picture adapted to the display (videoscreen.hadeshdr10adapt),
   // drawn the same way to its peak, on an output that takes HDR10: set up for HDR10 told that peak
@@ -303,6 +306,8 @@ bool CLinuxRendererGLES::Configure(const VideoPicture &picture, float fps, unsig
   {
     const dvbridge_hdr10_mapping mapping = dvWindow->TakeHdr10AdaptMapping(picture);
     adapt = CDVBridgeGLES::ConversionOutputAdapted(picture, hdr10, mapping);
+    if (adapt)
+      dvWindow->DVConversionAhead(false);
     if (!adapt)
       DVBRIDGE::PlainMappingFailed("no mapping to the display could be made of it");
   }
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index bf17a8a..b92160f 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -230,6 +230,7 @@ void CAdvancedSettings::Initialize()
   m_videoDVFromHdr10WhenNeeded = true;
   m_videoDVMeasuredNoAvgFloor = false;
   m_videoDVWarmup = true;
+  m_videoDVGamutAhead = true;
   m_videoDVHdr10PlusFill = true;
   m_videoSmoothPercentToTimeSeeking = true;
   m_videoTimeSeekForward = 30;
@@ -755,6 +756,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
     XMLUtils::GetBoolean(pElement, "dvfromhdr10whenneeded", m_videoDVFromHdr10WhenNeeded);
     XMLUtils::GetBoolean(pElement, "dvmeasurednoavgfloor", m_videoDVMeasuredNoAvgFloor);
     XMLUtils::GetBoolean(pElement, "dvwarmup", m_videoDVWarmup);
+    XMLUtils::GetBoolean(pElement, "dvgamutahead", m_videoDVGamutAhead);
     XMLUtils::GetBoolean(pElement, "dvhdr10plusfill", m_videoDVHdr10PlusFill);
     XMLUtils::GetBoolean(pElement, "smoothpercenttotimeseeking", m_videoSmoothPercentToTimeSeeking);
     XMLUtils::GetInt(pElement, "timeseekforward", m_videoTimeSeekForward, 0, 6000);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index d79e8b4..2e974ae 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -270,6 +270,12 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! made ready before its first frame (video/dvwarmup; dvbridge_render_warm()). Off to have each
     //! made when a frame first needs it, as before
     bool m_videoDVWarmup;
+    //! Hades: the gamut mapping table of a mapping to the display is made ahead, on a thread of its
+    //! own, from when the mapping is set, so that the first picture that maps does not wait while
+    //! it is made (video/dvgamutahead; dvbridge_render_use_gamut_ahead()). A diagnostic key, not a
+    //! choice (the table is the same, byte for byte): off to compare the start of a video with that
+    //! picture making it, as before
+    bool m_videoDVGamutAhead;
     //! Hades: HDR10+ sent as Dolby Vision: the scenes without HDR10+ statistics of their own get a
     //! level 1 block measured from the picture (video/dvhdr10plusfill; CDVHdr10PlusFill). On, the
     //! default; off to have them go out as before (the last scene's metadata, then HDR10), to
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2df4c05..c7f20d5 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4590,15 +4590,7 @@ int CWinSystemGbmGLESContext::RenderDVConversion(const CDVBridgeGLES::Layer& lay
   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &target);
   if (target != 0)
     return -1;
-  if (!m_dvConvertBridge)
-  {
-    m_dvConvertBridge = std::make_unique<CDVBridgeGLES>();
-    // Hades: composed as the settings say when the bridge is made (videoscreen.hadesdvcomposer)
-    m_dvConvertBridge->UseComposer(ConversionComposerCCM());
-    // (and its gamut mapping table: videoscreen.hadesdvgamutfine)
-    m_dvConvertBridge->UseGamutTable(ConversionFineGamut());
-  }
-  if (!m_dvConvertBridge->InitializeConversion())
+  if (!ConversionBridge(true))
     return -1;
   // mapped to the display as the output was told when the renderer was configured
   m_dvConvertBridge->SetConversionMapping(m_dvConvertMapping);
@@ -4644,6 +4636,32 @@ int CWinSystemGbmGLESContext::RenderDVConversion(const CDVBridgeGLES::Layer& lay
   return reconstructed ? 1 : 0;
 }
 
+CDVBridgeGLES* CWinSystemGbmGLESContext::ConversionBridge(bool dolbyVision)
+{
+  if (!m_dvConvertBridge)
+  {
+    m_dvConvertBridge = std::make_unique<CDVBridgeGLES>();
+    if (dolbyVision)
+    {
+      // Hades: composed as the settings say when the bridge is made (videoscreen.hadesdvcomposer)
+      m_dvConvertBridge->UseComposer(ConversionComposerCCM());
+      // (and its gamut mapping table: videoscreen.hadesdvgamutfine)
+      m_dvConvertBridge->UseGamutTable(ConversionFineGamut());
+    }
+  }
+  return m_dvConvertBridge->InitializeConversion() ? m_dvConvertBridge.get() : nullptr;
+}
+
+void CWinSystemGbmGLESContext::DVConversionAhead(bool dolbyVision)
+{
+  // (a mapping that is off draws with no gamut mapping table, and one that is not valid is set by
+  // the first picture as it is now: SetConversionMapping() fails the same way then)
+  if (!m_dvConvertMapping.enabled || !dvbridge_hdr10_mapping_valid(&m_dvConvertMapping))
+    return;
+  if (CDVBridgeGLES* bridge = ConversionBridge(dolbyVision))
+    bridge->SetConversionMapping(m_dvConvertMapping);
+}
+
 int CWinSystemGbmGLESContext::RenderPlainMapping(const CDVBridgeGLES::Layer& layer,
                                                  const dvbridge_plain& plain,
                                                  const CRect& source,
@@ -4670,9 +4688,7 @@ int CWinSystemGbmGLESContext::RenderPlainMapping(const CDVBridgeGLES::Layer& lay
   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &target);
   if (target != 0)
     return -1;
-  if (!m_dvConvertBridge)
-    m_dvConvertBridge = std::make_unique<CDVBridgeGLES>();
-  if (!m_dvConvertBridge->InitializeConversion())
+  if (!ConversionBridge(false))
     return -1;
   m_dvConvertBridge->SetConversionMapping(m_dvConvertMapping);
   m_dvConvertBridge->SetConversionTarget(0, UseLimitedColor());
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 253d087..d9b059a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -280,6 +280,17 @@ public:
                          const CRect& source,
                          const CRect& dest,
                          unsigned int serial);
+  /*!
+   * \brief Hades: the bridge that draws the pictures of the mapping taken last is set up now, where
+   *        the renderer is configured for them (render thread), rather than by the first of them:
+   *        the gamut mapping table of the mapping is then made ahead, on a thread of its own, while
+   *        the output changes mode and the first picture is decoded, and the first picture that is
+   *        mapped does not wait while it is made (dvbridge_render_gamut_ahead(), issue #3)
+   * \param dolbyVision for pictures of Dolby Vision that are reconstructed (RenderDVConversion()),
+   *        else for pictures that are not (RenderPlainMapping()): the bridge is set up as the first
+   *        of them sets it up
+   */
+  void DVConversionAhead(bool dolbyVision);
   //! No renderer draws that way any more: what it took is given back (render thread)
   void EndDVConversion();
   //! It failed: not used again in this video (any thread)
@@ -662,6 +673,10 @@ private:
   //! Hades: the bridge that reconstructs for output as HDR10. Apart from the one of native
   //! output, whose state it does not touch.
   std::unique_ptr<CDVBridgeGLES> m_dvConvertBridge;
+  //! Hades: m_dvConvertBridge, made where there is none (for pictures of Dolby Vision that are
+  //! reconstructed: with the composer and the gamut table of the settings) and initialized; nullptr
+  //! where it cannot be (render thread)
+  CDVBridgeGLES* ConversionBridge(bool dolbyVision);
   std::atomic<bool> m_dvConvertDisabled{false};
   std::atomic<bool> m_dvConvertDisplay{false}; //!< see SupportsDVConversion()
   std::atomic<bool> m_dvConvertSdr{false}; //!< see SupportsDVConversionToSdr()
