From 4ffd02309a97ee46c8c9cae61f6425cb74ced67f Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 19 Oct 2026 01:01:05 +0100
Subject: [PATCH] [posix][smb] treat libsmbclient's offset EINVAL codes as
 EINVAL

smbc_opendir() reports failures to parse its arguments as
EINVAL + 8192 + n instead of plain EINVAL. OpenDir() didn't recognise
these and showed them via strerror(), which only produces e.g.
"Unknown error: 8216". Handle them like EINVAL; the log keeps the raw
value.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/platform/posix/filesystem/SMBDirectory.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/xbmc/platform/posix/filesystem/SMBDirectory.cpp b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
index 709b938..0151d91 100644
--- a/xbmc/platform/posix/filesystem/SMBDirectory.cpp
+++ b/xbmc/platform/posix/filesystem/SMBDirectory.cpp
@@ -276,7 +276,9 @@ int CSMBDirectory::OpenDir(const CURL& url, std::string& strAuth)
   {
     std::string cError;
 
-    if (openErrno == EACCES || openErrno == EPERM || openErrno == EAGAIN || openErrno == EINVAL)
+    // smbc_opendir() reports failing to parse its arguments as EINVAL + 8192 + n
+    const bool invalid = openErrno == EINVAL || openErrno >= EINVAL + 8192;
+    if (openErrno == EACCES || openErrno == EPERM || openErrno == EAGAIN || invalid)
     {
       if (m_flags & DIR_FLAG_ALLOW_PROMPT)
       {
-- 
