From 084aae578edcef9a75628a7297d20d0e536b8440 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Fri, 23 Oct 2026 08:34:37 +0200
Subject: [PATCH] [PVR] Bound the EPG tag range delete from below

The delete that clears conflicting tags before a tag is persisted only
had an upper bound on the start time, so every call scanned all older
tags of the EPG. Writing many tags, e.g. on shutdown, grew
quadratically per channel. As tags of an EPG do not overlap, the last
tag starting before the range is a safe lower bound.

(cherry picked from commit 8152f61aa768dda2e43cf406d894bb33557df682)
---
 xbmc/pvr/epg/EpgDatabase.cpp          | 12 +++++-
 xbmc/pvr/epg/test/TestEpgDatabase.cpp | 59 +++++++++++++++++++++++++++
 2 files changed, 69 insertions(+), 2 deletions(-)

diff --git a/xbmc/pvr/epg/EpgDatabase.cpp b/xbmc/pvr/epg/EpgDatabase.cpp
index 266816a..d311a1f 100644
--- a/xbmc/pvr/epg/EpgDatabase.cpp
+++ b/xbmc/pvr/epg/EpgDatabase.cpp
@@ -1078,9 +1078,17 @@ bool CPVREpgDatabase::QueueDeleteEpgTagsByMinEndMaxStartTimeQuery(int iEpgID,
 {
   Filter filter;
 
+  const int64_t iMinEndTime{ToStoredTime(minEndTime)};
+
   std::unique_lock lock(m_critSection);
-  filter.AppendWhere(PrepareSQL("idEpg = %u AND iEndTime >= %lld AND iStartTime <= %lld", iEpgID,
-                                ToStoredTime(minEndTime), ToStoredTime(maxStartTime)));
+  // Tags of an EPG do not overlap, so a tag starting before the last one that starts before
+  // minEndTime cannot reach minEndTime. Bounding the start time this way keeps the index scan
+  // short. MySQL needs the derived table to allow a subquery on the table being deleted from.
+  filter.AppendWhere(PrepareSQL(
+      "idEpg = %u AND iEndTime >= %lld AND iStartTime <= %lld AND iStartTime >= "
+      "coalesce((SELECT s FROM (SELECT max(iStartTime) AS s FROM epgtags WHERE idEpg = %u AND "
+      "iStartTime < %lld) AS t), %lld)",
+      iEpgID, iMinEndTime, ToStoredTime(maxStartTime), iEpgID, iMinEndTime, iMinEndTime));
 
   std::string strQuery;
   if (BuildSQL("DELETE FROM epgtags", filter, strQuery))
diff --git a/xbmc/pvr/epg/test/TestEpgDatabase.cpp b/xbmc/pvr/epg/test/TestEpgDatabase.cpp
index 1f2fca1..8d7ccd1 100644
--- a/xbmc/pvr/epg/test/TestEpgDatabase.cpp
+++ b/xbmc/pvr/epg/test/TestEpgDatabase.cpp
@@ -78,6 +78,27 @@ protected:
         m_savedTimeCorrection;
   }
 
+  bool InsertTag(int64_t start, int64_t end) const
+  {
+    return m_database->ExecuteQuery(StringUtils::Format(
+        "REPLACE INTO epgtags (idEpg, iStartTime, iEndTime) VALUES ({}, {}, {});", EPG_ID, start,
+        end));
+  }
+
+  bool DeleteTagsByMinEndMaxStartTime(int64_t minEnd, int64_t maxStart) const
+  {
+    return m_database->QueueDeleteEpgTagsByMinEndMaxStartTimeQuery(
+               EPG_ID, CDateTime::FromSecondsSinceEpoch(minEnd),
+               CDateTime::FromSecondsSinceEpoch(maxStart)) &&
+           m_database->CommitDeleteQueries();
+  }
+
+  bool HasTagAt(int64_t start) const
+  {
+    return m_database->GetEpgTagByStartTime(EPG_ID, CDateTime::FromSecondsSinceEpoch(start)) !=
+           nullptr;
+  }
+
   std::shared_ptr<CPVREpgDatabase> m_database;
 
 private:
@@ -174,3 +195,41 @@ TEST_F(TestEpgDatabase, TheMinStartTimeIsNotWrapped)
 
   EXPECT_EQ(START, minStart.GetAsSecondsSinceEpoch()) << AsText(minStart);
 }
+
+/*!
+ A tag starting before the range and reaching into it is deleted, its neighbours are not.
+ */
+TEST_F(TestEpgDatabase, ADeleteByRangeRemovesATagReachingIntoIt)
+{
+  ASSERT_TRUE(InsertTag(START - 3600, START));
+  ASSERT_TRUE(InsertTag(END, END + 3600));
+
+  ASSERT_TRUE(DeleteTagsByMinEndMaxStartTime(START + 1800, START + 2700));
+
+  EXPECT_FALSE(HasTagAt(START));
+  EXPECT_TRUE(HasTagAt(START - 3600));
+  EXPECT_TRUE(HasTagAt(END));
+}
+
+/*!
+ The bounds are inclusive, so a tag ending exactly at the minimum end time is deleted.
+ */
+TEST_F(TestEpgDatabase, ADeleteByRangeRemovesATagEndingAtTheMinimumEndTime)
+{
+  ASSERT_TRUE(InsertTag(START - 3600, START));
+
+  ASSERT_TRUE(DeleteTagsByMinEndMaxStartTime(START, START));
+
+  EXPECT_FALSE(HasTagAt(START - 3600));
+  EXPECT_FALSE(HasTagAt(START));
+}
+
+/*!
+ With no tag starting before the range, the tags starting inside it are still deleted.
+ */
+TEST_F(TestEpgDatabase, ADeleteByRangeBeforeTheFirstTagRemovesTagsStartingInIt)
+{
+  ASSERT_TRUE(DeleteTagsByMinEndMaxStartTime(START - 3600, START));
+
+  EXPECT_FALSE(HasTagAt(START));
+}
