From f36b4cf2b8879ec9a9b2d38af72cd9161497ef09 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:51:29 +0000
Subject: [PATCH] AEStreamParser: do not wait for a DTS-HD frame larger than
 the parser

The size of a DTS-HD frame is the core's plus the one its extension header gives, up to 20 bits
(1 MiB) in a blown-up header. The parser takes the frame together in a buffer of
MAX_IEC61937_PACKET bytes; a header that says more than that (a corrupt or crafted file) made it
wait for the rest for ever: it took nothing more from any packet, no frame came out again, and the
passthrough codec kept every packet after it in its backlog, which grew for the rest of the stream.
With a header that said 100000 bytes, 3 of 204 frames came out and the backlog held 1.1 MB after
200 packets.

Such a header is not taken for a frame, and the search goes on past it: 203 of the 204 frames come
out, and nothing is kept back. A frame that large cannot be passed through anyway: the largest
IEC 61937 burst holds 65528 bytes. Frames that fit are found as before.
---
 xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp |  6 +++
 .../Utils/test/TestAEStreamParser.cpp         | 46 +++++++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
index cb91266..2eddda6 100644
--- a/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEStreamInfo.cpp
@@ -711,6 +711,12 @@ unsigned int CAEStreamParser::SyncDTS(uint8_t* data, unsigned int size)
 
       m_coreSize = m_fsize;
       m_fsize += hd_size;
+
+      // Hades: a frame that says it is larger than the parser can hold is never put together: the
+      // parser would wait for the rest of it for ever, and the passthrough codec keep every packet
+      // after it. Such a header is not taken for a frame, and the search goes on past it.
+      if (m_fsize > sizeof(m_buffer))
+        continue;
     }
     // While acquiring, a core frame counts only if the next frame starts where it ends. A flush
     // can leave a core cut from its extension, and taking that for a plain DTS stream switches
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
index 523989f..1c4025c 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
@@ -104,6 +104,20 @@ std::vector<CAEStreamInfo::DataType> Parse(std::vector<uint8_t> stream,
   return types;
 }
 
+//! A DTS-HD MA frame whose extension header says it is \p bytes long (a blown-up header, 20 bits)
+std::vector<uint8_t> MaFrameSaying(unsigned int bytes)
+{
+  std::vector<uint8_t> frame = MaFrame();
+  uint8_t* ext = frame.data() + CORE_SIZE;
+  const unsigned int hd = bytes - CORE_SIZE - 1;
+  ext[5] = 0x20; // blown up; the header is 1 byte
+  ext[6] = static_cast<uint8_t>((hd >> 19) & 0x01);
+  ext[7] = static_cast<uint8_t>((hd >> 11) & 0xFF);
+  ext[8] = static_cast<uint8_t>((hd >> 3) & 0xFF);
+  ext[9] = static_cast<uint8_t>((hd & 0x07) << 5);
+  return frame;
+}
+
 //! An E-AC-3 frame of 512 bytes, 48 kHz, 6 blocks, 3/2 without LFE: what a few bytes of another
 //! stream can read as, as its header is not checked with a CRC.
 std::vector<uint8_t> Eac3Frame()
@@ -307,3 +321,35 @@ TEST(TestAEStreamParser, TheDtsFamilyIsOnlyDts)
   EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_TRUEHD).empty());
   EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_EAC3).empty());
 }
+
+//! A frame whose header says it is larger than the parser can hold is not waited for: the frames
+//! after it are found, and every byte handed to the parser is taken.
+TEST(TestAEStreamParser, AFrameLargerThanTheParserIsNotWaitedFor)
+{
+  std::vector<std::vector<uint8_t>> packets;
+  for (int i = 0; i < 2; ++i)
+    packets.push_back(MaFrame());
+  packets.push_back(MaFrameSaying(100000));
+  for (int i = 0; i < 8; ++i)
+    packets.push_back(MaFrame());
+
+  CAEStreamParser parser;
+  parser.SetExpectedType(CAEStreamInfo::STREAM_TYPE_DTSHD_MA);
+  std::vector<uint8_t> backlog; // what the passthrough codec keeps for the next call
+  unsigned int frames = 0;
+  for (const auto& packet : packets)
+  {
+    backlog.insert(backlog.end(), packet.begin(), packet.end());
+    uint8_t* out = nullptr;
+    unsigned int outSize = 0;
+    const int used = parser.AddData(backlog.data(), static_cast<unsigned int>(backlog.size()),
+                                    &out, &outSize);
+    delete[] out;
+    if (outSize > 0)
+      ++frames;
+    ASSERT_GT(used, 0);
+    backlog.erase(backlog.begin(), backlog.begin() + used);
+  }
+  EXPECT_GE(frames, 8u);
+  EXPECT_LT(backlog.size(), 2 * (CORE_SIZE + HD_SIZE));
+}
