From 790811026b53f2226088150477c60e132adaf8ad Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:02:54 +0000
Subject: [PATCH] dvbridge: the statistics of native output leave out what a
 seek leaves

The lines of every 10 s of native Dolby Vision output took the time from the
last frame before a seek to the first after it as the longest gap between
shown frames, as a presentation over 1.5 refresh periods, as a time between
two flips of frames presented a frame ahead, and took the time of that frame's
flip against the player's clock, which has just started again. A seek read
as a stall: the gaps of 500.8 and 542.2 ms of the hardware test of 1.0 RC4 on
the AMD integrated graphics were the user's seeks.

The render manager now tells the window system when the frame it chose is the
first after a seek (CSeekTrace, VideoSeekShown()). That frame's gap, its
late presentation, the time between its flip and the one before it, and its
time against the clock are left out, and the line tells the seeks apart:

  ...; 2 seeks, left out of the gaps, the presentations over 1.5 refresh
  periods, the times between flips and those against the player's clock (from
  asking for each to its first frame: the longest 1210 ms)

What the fidelity step-down and the choice of presenting a frame ahead see
does not change: they have their own handling of seeks. The ordinary output's
line of the flips against the clock leaves that frame out too.
---
 .../VideoRenderers/RenderManager.cpp          |  5 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 41 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 16 ++++++++
 3 files changed, 57 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 87a95f2..68139fd 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -988,6 +988,11 @@ void CRenderManager::SeekFrameChosen(int idx)
   if (line.empty())
     return;
   CLog::Log(LOGINFO, "{}", line);
+#ifdef HAVE_DVBRIDGE
+  if (auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem()))
+    dvWindow->VideoSeekShown(askedNs);
+#endif
 }
 
 void CRenderManager::SeekTraceEnded()
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0ae6261..41b90bf 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -378,6 +378,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 #ifdef HAVE_DVBRIDGE
   // Hades: the frame that the render manager chose for this pass, if it chose one (CPresentLag)
   m_lagFrameNs = TakeChosenFrame();
+  // Hades: ... and whether it is the first after a seek (VideoSeekShown()): the time of its flip is
+  // not taken against the player's clock, which has just started again
+  m_passSeekNs = std::exchange(m_seekShownNs, 0);
+  if (m_passSeekNs > 0)
+    m_lagFrameNs = 0;
   PublishDVInfo(false);
   if (m_dvState.Captured() && m_dvRepeat)
   {
@@ -531,6 +536,10 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         AnnounceHeldModeChange(true);
         presented = FlipDVBridgePage(m_dvState, false, &flip);
         presentedAhead = presented && flip.ahead;
+        // Hades: a frame ahead that is the first after a seek: the time between its flip and the
+        // one before it is the seek's (DVAheadFlipped())
+        if (presentedAhead)
+          m_dvAheadFlipSeek = m_passSeekNs > 0;
         // Hades: when its flip came against the player's clock (CPresentLag): a commit that waits
         // returned with it; a frame ahead is told with its flip (DVAheadFlipped())
         // (a frame presented the way that waits comes after the flip of any frame ahead before it
@@ -618,7 +627,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         }
       }
       const bool late = periodMs > 0 && lateMs > 1.5 * periodMs;
-      if (late)
+      // (Hades: not the first frame after a seek: what came before it is the seek's, CSeekTrace)
+      if (late && m_passSeekNs == 0)
         m_dvStats.late++;
       // Hades: a frame that was taken and whose flip did not come; the output ends when they do
       // not reach the display (the ordinary output, restored, is told from here on)
@@ -646,7 +656,16 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         DVAheadWaited(late, periodMs);
       if (presented)
       {
-        if (m_dvStats.hasLastShown)
+        // Hades: the first frame after a seek: the time since the seek was asked for, not a gap
+        // (CSeekTrace)
+        if (m_passSeekNs > 0)
+        {
+          m_dvStats.seeks++;
+          m_dvStats.seekMaxMs =
+              std::max(m_dvStats.seekMaxMs,
+                       static_cast<double>(std::max<int64_t>(SteadyNowNs() - m_passSeekNs, 0)) / 1e6);
+        }
+        else if (m_dvStats.hasLastShown)
           m_dvStats.gapMaxMs = std::max(
               m_dvStats.gapMaxMs,
               std::chrono::duration<double, std::milli>(now - shownBefore).count());
@@ -4685,6 +4704,8 @@ bool CWinSystemGbmGLESContext::DVAheadFence()
 
 void CWinSystemGbmGLESContext::DVAheadFlipped(int64_t ns)
 {
+  // Hades: that frame was the first after a seek: the time since the flip before it is the seek's
+  const bool afterSeek = std::exchange(m_dvAheadFlipSeek, false);
   // Hades: that frame reached the display in time (CDVPresentStall)
   m_dvPresentStall.Flipped();
   // Hades: ... and when, against the player's clock (CPresentLag)
@@ -4701,10 +4722,13 @@ void CWinSystemGbmGLESContext::DVAheadFlipped(int64_t ns)
     const double periodMs = DVRefreshPeriodMs();
     const double gapMs = static_cast<double>(ns - m_dvAheadLastFlipNs) / 1e6 -
                          (periodMs > 0 ? m_dvAheadRepeats * periodMs : 0.0);
-    m_dvStats.flips++;
-    m_dvStats.flipGapMaxMs = std::max(m_dvStats.flipGapMaxMs, gapMs);
+    if (!afterSeek)
+    {
+      m_dvStats.flips++;
+      m_dvStats.flipGapMaxMs = std::max(m_dvStats.flipGapMaxMs, gapMs);
+    }
     const bool late = periodMs > 0 && gapMs > 1.5 * periodMs;
-    if (late)
+    if (late && !afterSeek)
       m_dvStats.flipsLate++;
     // Hades: the frame of that flip came with its refresh, or not (the fidelity step-down)
     if (periodMs > 0)
@@ -5197,6 +5221,13 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
                                  "not as ETSI GS CCM 001 composes them",
                                  m_dvStats.reshaped) +
              ioctls;
+  // Hades: the seeks, whose first frames are left out of the figures above (CSeekTrace)
+  if (m_dvStats.seeks)
+    ioctls += StringUtils::Format(
+        "; {} seeks, left out of the gaps, the presentations over 1.5 refresh periods, the times "
+        "between flips and those against the player's clock (from asking for each to its first "
+        "frame: the longest {:.0f} ms)",
+        m_dvStats.seeks, m_dvStats.seekMaxMs);
   m_dvLag.Reset();
   // Hades: the GPU time of each pass, where advancedsettings.xml asks for it (dvpasstimes)
   std::vector<dvbridge_pass_time> passes;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 1cd0046..4db2f16 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -279,6 +279,12 @@ public:
     m_lagChosenNs = dueNs;
     m_lagChosenSerial++;
   }
+  //! Hades: the frame that the render manager chose last is the first after a seek asked for at
+  //! askedNs (steady clock, CSeekTrace): the statistics of native output leave out what the seek
+  //! left before it (the gap, a late presentation, the time between flips) and the time of its flip
+  //! against the player's clock, which has just started again. Main thread, before the pass that
+  //! presents it.
+  void VideoSeekShown(int64_t askedNs) { m_seekShownNs = askedNs > 0 ? askedNs : 1; }
   bool SetVideoOutput(const VideoPicture* picture) override;
   bool DestroyWindowSystem() override;
   //! A frame that is presented a frame ahead (see CDVAhead) is on the screen one refresh period
@@ -573,6 +579,10 @@ private:
     double presentSumMs = 0;
     double presentMaxMs = 0;
     double gapMaxMs = 0;
+    //! Hades: the first frames after a seek (VideoSeekShown()), and the longest time from asking for
+    //! the seek to its frame: left out of gapMaxMs, late, and the times between flips
+    unsigned int seeks = 0;
+    double seekMaxMs = 0;
     bool hasLastShown = false;
     std::chrono::steady_clock::time_point start;
     std::chrono::steady_clock::time_point lastShown;
@@ -743,6 +753,12 @@ private:
     return m_lagChosenNs.load();
   }
   int64_t m_lagFrameNs = 0; //!< ... of the frame of this pass
+  //! Hades: when the seek was asked for that the frame chosen last ends (VideoSeekShown()), and
+  //! that the frame of this pass ends (0: none), and whether the frame presented a frame ahead whose
+  //! flip is to come ended one (DVAheadFlipped())
+  int64_t m_seekShownNs = 0;
+  int64_t m_passSeekNs = 0;
+  bool m_dvAheadFlipSeek = false;
   CPresentLag m_dvLag; //!< ... of native output, for the line of every 10 s
   int64_t m_dvLagAheadNs = 0; //!< ... of the frame presented a frame ahead whose flip is to come
   CPresentLag m_videoLag; //!< ... of the ordinary output while a video plays, a line a minute
-- 
2.53.0

