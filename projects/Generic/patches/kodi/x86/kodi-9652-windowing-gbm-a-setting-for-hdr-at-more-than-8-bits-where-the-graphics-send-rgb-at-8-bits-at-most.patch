diff --git a/xbmc/windowing/gbm/HdrMoreBits.h b/xbmc/windowing/gbm/HdrMoreBits.h
new file mode 100644
index 0000000..5e47bf5
--- /dev/null
+++ b/xbmc/windowing/gbm/HdrMoreBits.h
@@ -0,0 +1,69 @@
+/*
+ *  Copyright (C) 2026-present Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: HDR at more than 8 bits on NVIDIA graphics that send RGB at 8 bits at most over HDMI
+// (videoscreen.hadeshdrmorebits). nvidia-modeset decides it in the mode set of an HDR video, by a
+// parameter of its own that this writes before that mode set (CWinSystemGbm::QueueLinkDepth()):
+// hades_hdr_ycbcr422 of driver 580 (YCbCr 4:2:2 at 10 bits on GeForce GTX 10 and TITAN V) and
+// hades_turing_12bpc of driver 615 (12 bits on GeForce GTX 16 and RTX 20 where the mode fits). A GPU
+// that sends RGB at more than 8 bits over HDMI is touched by neither: the driver checks it. Off,
+// both are written off, which is how the driver starts.
+
+#include "utils/log.h"
+
+#include <array>
+#include <fstream>
+#include <string>
+
+#include <unistd.h>
+
+namespace KODI::WINDOWING::GBM::HDR_MORE_BITS
+{
+inline constexpr std::array<const char*, 2> PARAMETERS{
+    "/sys/module/nvidia_modeset/parameters/hades_hdr_ycbcr422",
+    "/sys/module/nvidia_modeset/parameters/hades_turing_12bpc"};
+
+//! Whether the driver in use has one of them, writable (the setting is shown)
+inline bool Supported()
+{
+  for (const char* path : PARAMETERS)
+    if (access(path, W_OK) == 0)
+      return true;
+  return false;
+}
+
+//! Each of them that the driver has is written on or off, where it is not so already
+inline void Apply(bool on)
+{
+  const std::string want{on ? "Y" : "N"};
+  for (const char* path : PARAMETERS)
+  {
+    if (access(path, W_OK) != 0)
+      continue;
+    std::string now;
+    {
+      std::ifstream in(path);
+      in >> now;
+    }
+    if (now == want)
+      continue;
+    std::ofstream out(path);
+    out << want;
+    out.close();
+    if (!out)
+      CLog::Log(LOGWARNING, "HDR output: {} could not be set to {}", path, want);
+    else
+      CLog::Log(LOGINFO,
+                "HDR output: {} set to {}: more than 8 bits where the graphics send RGB at 8 bits "
+                "at most is {} (videoscreen.hadeshdrmorebits)",
+                path, want, on ? "on" : "off");
+  }
+}
+} // namespace KODI::WINDOWING::GBM::HDR_MORE_BITS
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 1c2ba86..b1e6922 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -8,6 +8,8 @@
 
 #include "WinSystemGbm.h"
 
+#include "HdrMoreBits.h" // (Hades)
+
 #include "GBMDPMSSupport.h"
 #include "ModeListRefresh.h"
 #include "OptionalsReg.h"
@@ -4407,11 +4409,25 @@ LinkContent CWinSystemGbm::CurrentLinkContent() const
   return OutputBufferDeep() ? LinkContent::SDR_DEEP : LinkContent::SDR;
 }
 
+bool CWinSystemGbm::SupportsHDRMoreBits() const
+{
+  return HDR_MORE_BITS::Supported();
+}
+
 void CWinSystemGbm::QueueLinkDepth(LinkContent content,
                                    bool setsHead,
                                    const char* with,
                                    bool transportEnds)
 {
+  // Hades: nvidia-modeset is told the setting before the mode set of an HDR video (HdrMoreBits.h)
+  if (content == LinkContent::HDR)
+  {
+    const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+    const auto hdrSettings = settingsComponent ? settingsComponent->GetSettings() : nullptr;
+    if (hdrSettings && HDR_MORE_BITS::Supported())
+      HDR_MORE_BITS::Apply(
+          hdrSettings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDRMOREBITS));
+  }
   const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
   if (!connector || !m_linkDepth.managed)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index fc1215b..c2d2639 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -242,6 +242,7 @@ public:
   CHDRCapabilities GetDisplayHDRCapabilities() const override;
   bool SupportsHDRYCbCr420Choice() const override { return m_hdrYCbCr420Choice; }
   bool SupportsHDRDepthChoice() const override { return m_hdrDepthChoice; }
+  bool SupportsHDRMoreBits() const override; // (Hades: HdrMoreBits.h)
   //! Hades: what is known with certainty of the depth of the link with HDR10 on in the mode of
   //! this resolution, on this display, with the settings as they are now (WholeMultiple.h): for
   //! the whole-number multiples of the frame rate in the whitelist. Any thread.
