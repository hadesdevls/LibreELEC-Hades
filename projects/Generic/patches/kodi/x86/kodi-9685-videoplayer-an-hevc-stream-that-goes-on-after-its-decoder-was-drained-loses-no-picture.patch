+ */
+
+#pragma once
+
+extern "C"
+{
+#include <libavcodec/packet.h>
+#include <libavutil/avutil.h>
+}
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <utility>
+#include <vector>
+
+/*!
+ * \brief Hades: a stream that goes on after its decoder was drained in the middle of it
+ *
+ * When no packet has come for ten frame periods, the video thread takes the stream for a still
+ * frame and drains the decoder (CVideoPlayerVideo::Process(): DVD_CODEC_CTRL_DRAIN): the decoder is
+ * sent its end, so that the pictures it holds come out. A decoder that has been sent its end takes
+ * no packet until it is flushed (FFmpeg's avcodec_send_packet() answers AVERROR_EOF), and once it is
+ * flushed it has none of the pictures that the next packets refer to. A stream that was not still,
+ * but had only run dry for a moment (a slow network, a seek over a network), lost the packets that
+ * came while the decoder still gave its pictures, and every picture after them until its next
+ * random-access point, which FFmpeg's HEVC decoder does not make without their references: the video
+ * stood still for that long. With Dolby Vision FEL, the enhancement layer, which is drained with the
+ * base layer, also threw away the pictures it had decoded for the base pictures still to come out:
+ * a base packet that came while it was drained started it again.
+ *
+ * This keeps the packets of an HEVC stream from its last random-access point on (an IRAP picture,
+ * which its packets say). A packet that comes once the decoder has been sent its end waits until the
+ * decoder has given every picture it held (Arrived(): WAIT; the caller says that it did not take the
+ * packet, and the player gives it again). Then the decoder starts again at that random-access point
+ * (RESTART): the caller flushes it (Reset()), takes the kept packets (TakeKept()) and gives them back
+ * here (GiveAgain()), and gives them to the decoder again, one at a time as it takes them (HasAgain(),
+ * Again(), GivenAgain()), before the packet that came. The pictures they make went out before, and
+ * are left out (Drop(), by the time each one has: the decoder gives a picture the time of its
+ * packet). The stream then goes on as if it had not run dry, with both layers of a Dolby Vision
+ * stream: the enhancement layer starts again with the base layer, at the same packet, as after a
+ * seek to it.
+ *
+ * Without a random-access point kept, the decoder starts again at the packet that came (TAKE), as
+ * before: a stream of another codec (nothing is kept: Configure()), more packets or bytes since the
+ * random-access point than are kept (PACKETS_MAX, BYTES_MAX), a packet without a time since then, or
+ * a decoder that does not give its end in WAIT_MAX_MS. Why() says which. A stream that is drained at
+ * its end and does not go on keeps its packets until it is flushed or closed.
+ *
+ * One decoder thread.
+ */
+class CDrainRestart
+{
+public:
+  //! What a packet that comes to the decoder does
+  enum class Arrival
+  {
+    TAKE, //!< it is given to the decoder (after a flush, if the decoder gave its end), as before
+    WAIT, //!< it is not taken: the decoder still gives the pictures it held when it was drained
+    RESTART //!< the decoder starts again at the random-access point kept, then it is given
+  };
+
+  //! What the decoder was given with a packet besides the packet itself: kept with it
+  struct Info
+  {
+    double dts = 0.0; //!< DemuxPacket::dts
+    double ptsOffset = 0.0; //!< DemuxPacket::m_ptsOffset
+    bool recoveryPoint = false; //!< DemuxPacket::recoveryPoint
+  };
+
+  //! A packet kept: a copy of the packet as the decoder was given it (data and side data), what came
+  //! with it, and the time that its picture comes out with (as the caller compares it in Drop())
+  struct Kept
+  {
+    AVPacket* packet = nullptr;
+    Info info;
+    double time = 0.0;
+  };
+
+  //! The packets kept since a random-access point, and their bytes, at most
+  static constexpr size_t PACKETS_MAX = 600;
+  static constexpr size_t BYTES_MAX = size_t{128} << 20;
+  //! How long a packet waits for the decoder to give the pictures it held, at most
+  static constexpr int64_t WAIT_MAX_MS = 3000;
+  //! Pictures after the last packet given again within which a picture of those packets may still
+  //! come (the decoder gives its pictures in the order they are presented; an HEVC decoder holds 16
+  //! at most)
+  static constexpr unsigned DROP_AFTER = 64;
+
+  CDrainRestart() = default;
+  CDrainRestart(const CDrainRestart&) = delete;
+  CDrainRestart& operator=(const CDrainRestart&) = delete;
+  ~CDrainRestart()
+  {
+    Free(m_kept);
+    Free(m_again);
+  }
+
+  //! keep: the decoder decodes HEVC; extradata: its configuration, which says how its packets are
+  //! framed (an hvcC record: a length before each unit; otherwise start codes)
+  void Configure(bool keep, const uint8_t* extradata, int size)
+  {
+    m_keep = keep;
+    m_lengthSize = extradata && size >= 23 && extradata[0] == 1 ? (extradata[21] & 3) + 1 : 0;
+    Reset();
+  }
+  bool Keeps() const { return m_keep; }
+
+  //! The decoder took a packet (also one given again); time: the time that its picture comes out with
+  void Taken(const AVPacket& packet, const Info& info, double time)
+  {
+    if (!m_keep)
+      return;
+    if (RandomAccess(packet.data, packet.size))
+    {
+      Free(m_kept);
+      m_bytes = 0;
+      m_valid = true;
+      m_why.clear();
+      m_accessTime = time;
+    }
+    if (!m_valid)
+      return;
+    if (packet.pts == AV_NOPTS_VALUE)
+      return Invalidate("a packet without a time came after the last random-access point");
+    if (m_kept.size() >= PACKETS_MAX || packet.size < 0 ||
+        static_cast<size_t>(packet.size) > BYTES_MAX - m_bytes)
+      return Invalidate("more packets came after the last random-access point than are kept");
+    AVPacket* copy = av_packet_clone(&packet);
+    if (!copy)
+      return Invalidate("a packet could not be kept");
+    m_kept.push_back({copy, info, time});
+    m_bytes += static_cast<size_t>(packet.size);
+  }
+
+  //! The decoder was sent its end
+  void Drained()
+  {
+    if (!m_drained)
+    {
+      m_drained = true;
+      m_ended = false;
+      m_waitSince = -1;
+    }
+  }
+  //! The decoder has been sent its end, and has not given it yet
+  bool Draining() const { return m_drained && !m_ended; }
+  //! The decoder gave its end: every picture it held has come out
+  void Ended()
+  {
+    if (m_drained)
+      m_ended = true;
+  }
+
+  //! A packet comes to the decoder, at nowMs (of a steady clock)
+  Arrival Arrived(int64_t nowMs)
+  {
+    if (!m_keep || !m_drained)
+      return Arrival::TAKE;
+    if (!m_ended)
+    {
+      if (m_gaveUp)
+        return Arrival::TAKE;
+      if (m_waitSince < 0)
+        m_waitSince = nowMs;
+      if (nowMs - m_waitSince <= WAIT_MAX_MS)
+        return Arrival::WAIT;
+      // the decoder does not give its end: the packets go to it as before, which loses them
+      Invalidate("the decoder did not give the pictures it held within 3 s of being drained");
+      m_gaveUp = true;
+      m_note = "the decoder did not give the pictures it held within 3 s of being drained: the "
+               "packets that come go to it as before, and its pictures until the next "
+               "random-access point are lost";
+      return Arrival::TAKE;
+    }
+    if (m_valid && !m_kept.empty())
+      return Arrival::RESTART;
+    if (!m_gaveUp && !m_noted)
+      m_note = "the stream goes on after its decoder was drained, and the decoder starts again at "
+               "the packet that came, without the pictures it refers to (" +
+               (m_why.empty() ? std::string("no packet was kept") : m_why) +
+               "): its pictures until the next random-access point are lost";
+    m_noted = true;
+    return Arrival::TAKE;
+  }
+
+  //! What the last Arrived() did that the log should say, once (empty: nothing)
+  std::string Note() { return std::exchange(m_note, {}); }
+
+  //! The packets kept, taken out to be given again; the caller resets the decoder (Reset() resets
+  //! this) and gives them back with GiveAgain()
+  std::deque<Kept> TakeKept() { return std::exchange(m_kept, {}); }
+  //! The time of the picture of the random-access point kept (for the log)
+  double AccessTime() const { return m_accessTime; }
+
+  //! A picture went out with this time (one that Drop() did not leave out)
+  void Given(double time)
+  {
+    if (!m_haveGiven || time > m_lastGiven)
+      m_lastGiven = time;
+    m_haveGiven = true;
+  }
+  //! The time of the last picture that went out since the decoder was last flushed (and whether one
+  //! did)
+  bool LastGiven(double& time) const
+  {
+    time = m_lastGiven;
+    return m_haveGiven;
+  }
+
+  //! The packets to give the decoder again, before anything else; lastGiven: the time of the last
+  //! picture that went out before the restart (LastGiven(), taken before the decoder was reset), when
+  //! one did (haveGiven)
+  void GiveAgain(std::deque<Kept> kept, bool haveGiven = false, double lastGiven = 0.0)
+  {
+    Free(m_again);
+    m_again = std::move(kept);
+    m_drop.clear();
+    for (const Kept& k : m_again)
+      m_drop.push_back(k.time);
+    m_dropBefore = haveGiven;
+    m_before = lastGiven;
+    m_after = 0;
+    ++m_restarts;
+    m_givenAgain += m_again.size();
+  }
+  bool HasAgain() const { return !m_again.empty(); }
+  //! The next one (HasAgain()); the caller may change its packet's opaque, as for any packet
+  Kept& Again() { return m_again.front(); }
+  //! ... which the decoder took
+  void GivenAgain()
+  {
+    if (m_again.empty())
+      return;
+    av_packet_free(&m_again.front().packet);
+    m_again.pop_front();
+  }
+
+  //! A picture comes out of the decoder with this time: whether it is left out. A picture of a packet
+  //! given again went out before. And so is one that is presented before the last picture that went
+  //! out before the restart, in a stream whose pictures are presented in another order than they are
+  //! coded: the drain gave that later picture out before the packet of this one came, and the picture
+  //! cannot go out in its order any more (within LATE_SPAN of it: a time much earlier is of a stream
+  //! whose times went back, whose pictures go out).
+  static constexpr double LATE_SPAN = 2000000.0; //!< in the units of the times given (Kodi's: microseconds)
+  bool Drop(double time)
+  {
+    if (m_drop.empty() && !m_dropBefore)
+      return false;
+    for (auto it = m_drop.begin(); it != m_drop.end(); ++it)
+    {
+      if (*it == time)
+      {
+        m_drop.erase(it);
+        ++m_dropped;
+        return true;
+      }
+    }
+    if (m_dropBefore && time <= m_before && time > m_before - LATE_SPAN)
+    {
+      ++m_late;
+      return true;
+    }
+    if (m_again.empty() && ++m_after >= DROP_AFTER)
+    {
+      m_drop.clear();
+      m_dropBefore = false;
+    }
+    return false;
+  }
+
+  //! The decoder was flushed (a seek, a restart): nothing kept is of use
+  void Reset()
+  {
+    Free(m_kept);
+    Free(m_again);
+    m_drop.clear();
+    m_bytes = 0;
+    m_valid = false;
+    m_why = "no random-access point came since the decoder started";
+    m_drained = m_ended = m_gaveUp = m_noted = false;
+    m_waitSince = -1;
+    m_after = 0;
+    m_note.clear();
+    m_haveGiven = m_dropBefore = false;
+  }
+
+  //! For the log: restarts, packets given again, and pictures left out, since the stream opened
+  unsigned Restarts() const { return m_restarts; }
+  size_t GivenAgainCount() const { return m_givenAgain; }
+  size_t DroppedCount() const { return m_dropped; }
+  //! ... and pictures left out because they could not go out in their order any more
+  size_t LateCount() const { return m_late; }
+  size_t KeptCount() const { return m_kept.size(); }
+
+  //! Whether a packet is a random-access point of HEVC: the first unit of its video coding layer is of
+  //! an IRAP picture (BLA, IDR or CRA, types 16 to 23), with the framing given (0: start codes)
+  static bool RandomAccess(const uint8_t* data, int size, int lengthSize)
+  {
+    if (!data || size <= 0)
+      return false;
+    const uint8_t* p = data;
+    const uint8_t* const end = data + size;
+    if (lengthSize)
+    {
+      while (end - p > lengthSize)
+      {
+        size_t length = 0;
+        for (int i = 0; i < lengthSize; ++i)
+          length = length << 8 | *p++;
+        if (length < 2 || length > static_cast<size_t>(end - p))
+          return false;
+        const int type = p[0] >> 1 & 0x3f;
+        if (type < 32)
+          return type >= 16 && type <= 23;
+        p += length;
+      }
+      return false;
+    }
+    // (a unit holds no 00 00 01: a start code is the first one found)
+    while (end - p >= 4)
+    {
+      if (p[0] || p[1] || p[2] != 1)
+      {
+        ++p;
+        continue;
+      }
+      const int type = p[3] >> 1 & 0x3f;
+      if (type < 32)
+        return type >= 16 && type <= 23;
+      p += 3;
+    }
+    return false;
+  }
+  bool RandomAccess(const uint8_t* data, int size) const
+  {
+    return RandomAccess(data, size, m_lengthSize);
+  }
+
+private:
+  static void Free(std::deque<Kept>& list)
+  {
+    for (Kept& k : list)
+      av_packet_free(&k.packet);
+    list.clear();
+  }
+  void Invalidate(const char* why)
+  {
+    Free(m_kept);
+    m_bytes = 0;
+    m_valid = false;
+    m_why = why;
+  }
+
+  bool m_keep = false;
+  int m_lengthSize = 0;
+  std::deque<Kept> m_kept; //!< from the last random-access point on
+  size_t m_bytes = 0;
+  bool m_valid = false; //!< m_kept holds every packet since a random-access point
+  std::string m_why = "no random-access point came since the decoder started";
+  double m_accessTime = 0.0;
+  bool m_drained = false;
+  bool m_ended = false;
+  bool m_gaveUp = false; //!< it did not end within WAIT_MAX_MS: packets are not kept waiting
+  bool m_noted = false;
+  std::string m_note;
+  int64_t m_waitSince = -1;
+  std::deque<Kept> m_again; //!< to give the decoder again
+  std::vector<double> m_drop; //!< the times of the pictures of the packets given again, to leave out
+  bool m_haveGiven = false;
+  double m_lastGiven = 0.0;
+  bool m_dropBefore = false; //!< pictures presented before m_before are left out (Drop())
+  double m_before = 0.0;
+  size_t m_late = 0;
+  unsigned m_after = 0;
+  unsigned m_restarts = 0;
+  size_t m_givenAgain = 0;
+  size_t m_dropped = 0;
+};
