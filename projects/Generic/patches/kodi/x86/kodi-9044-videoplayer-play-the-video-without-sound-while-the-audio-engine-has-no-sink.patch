+      // The audio engine has no sink for the audio stream, and has not had one for a while:
+      // nothing of the stream can be played (the audio player drops its frames meanwhile).
+      if (m_CurrentAudio.id >= 0 && m_CurrentVideo.id < 0)
+      {
+        // nothing else to play: end as when a file cannot be played
+        CLog::Log(LOGERROR, "CVideoPlayer - no audio output and no video: playback ends");
+        m_error = true;
+        m_bAbortRequest = true;
+      }
+      else if (m_CurrentAudio.id >= 0)
+      {
+        CLog::Log(LOGWARNING, "CVideoPlayer - no audio output: the audio stream is closed and "
+                              "the video plays without sound");
+        m_audioOutputFailed = true;
+        m_audioFailedSource = m_CurrentAudio.source;
+        m_audioFailedDemuxerId = m_CurrentAudio.demuxerId;
+        m_audioFailedId = m_CurrentAudio.id;
