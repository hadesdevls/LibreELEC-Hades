+void CVideoPlayer::RetryAudioOutput()
+{
+  if (!m_audioOutputFailed || !m_audioRetryArmed || !m_audioRetryTimer.IsTimePast())
+    return;
+
+  if (CServiceBroker::GetActiveAE()->HasNoSink())
+  {
+    m_audioRetryTimer.Set(500ms);
+    return;
+  }
+
+  m_audioRetryArmed = false;
+  const int index = m_SelectionStreams.TypeIndexOf(StreamType::AUDIO, m_audioFailedSource,
+                                                   m_audioFailedDemuxerId, m_audioFailedId);
+  if (index < 0)
+    return;
+
+  // the stream is chosen as the user would do it, which puts sound and picture in step
+  CLog::Log(LOGINFO, "CVideoPlayer - the audio engine has a sink again: choosing audio stream {} "
+                     "again (attempt {} of {})",
+            index, m_audioRetries + 1, MAX_AUDIO_RETRIES);
+  m_audioRetries++;
+  m_messenger.Put(std::make_shared<CDVDMsgPlayerSetAudioStream>(index, true));
+}
