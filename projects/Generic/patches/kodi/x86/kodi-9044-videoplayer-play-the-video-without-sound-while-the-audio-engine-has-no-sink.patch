+void CVideoPlayerAudio::SetupOutput(const DVDAudioFrame& audioframe)
+{
+  if (m_speed)
+    m_audioSink.Drain();
+
+  m_audioSink.Destroy(false);
+  m_outputWorks = false;
+
+  if (!m_audioSink.Create(audioframe, m_streaminfo.codec, m_synctype == SYNC_RESAMPLE))
+  {
+    if (!m_outputFailingSince)
+      CLog::Log(LOGERROR, "ProcessDecoderOutput - failed to create audio renderer");
+    OutputNotWorking();
+  }
+
+  m_prevsynctype = -1;
+
+  if (m_syncState == IDVDStreamPlayer::SYNC_INSYNC)
+    m_audioSink.Resume();
+}
+
+bool CVideoPlayerAudio::OutputRetryDue() const
+{
+  if (m_outputFailed)
+    return false;
+
+  return !m_outputFailingSince || std::chrono::steady_clock::now() >= m_outputRetry;
+}
+
+void CVideoPlayerAudio::OutputNotWorking()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (!m_outputFailingSince)
+    m_outputFailingSince = now;
+  m_outputRetry = now + OUTPUT_RETRY;
+
+  // An engine that is suspended, or busy, gets its output in the end. Only one without a sink
+  // leaves nothing to wait for.
+  if (!CServiceBroker::GetActiveAE()->HasNoSink())
+  {
+    m_noSinkSince.reset();
+    return;
+  }
+
+  if (!m_noSinkSince)
+    m_noSinkSince = now;
+
+  if (now - *m_noSinkSince < OUTPUT_GRACE)
+    return;
+
+  {
+    std::unique_lock lock(m_reportLock);
+    if (m_streamChange)
+      return;
+
+    m_outputFailed = true;
+    m_messageParent.Put(
+        std::make_shared<CDVDMsgBool>(CDVDMsg::PLAYER_AUDIO_OUTPUT_FAILED, m_outputAccepted));
+  }
+  CLog::Log(LOGERROR, "CVideoPlayerAudio - the audio engine has had no sink for {} s: the player "
+                      "is told",
+            std::chrono::duration_cast<std::chrono::seconds>(now - *m_noSinkSince).count());
+}
