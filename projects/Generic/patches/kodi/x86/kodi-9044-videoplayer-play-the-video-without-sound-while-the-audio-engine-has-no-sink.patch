 using namespace std::chrono_literals;
 
+namespace
+{
+// An audio engine that lost its sink at a change of the display mode, or that is starting, has it
+// back within this time: longer than its own first retries (after 0.5, 1 and 2 seconds).
+constexpr auto OUTPUT_GRACE = 5s;
+constexpr auto OUTPUT_RETRY = 500ms;
+// An engine that is without its sink for less than this (it opens it again after a change of
+// the display mode) serves the stream when it has it back: nothing is dropped for it.
+constexpr auto NO_SINK_SETTLE = 1500ms;
+// A frame without an output is dropped when the clock is this near to it, about the time that
+// the output would have needed it; and when the clock is this far behind it, which no queue
+// explains (the clock jumped back): it would wait while the queue fills up.
+constexpr double DROP_AHEAD = DVD_MSEC_TO_TIME(100);
+constexpr double DROP_FAR = DVD_MSEC_TO_TIME(10000);
+} // unnamed namespace
