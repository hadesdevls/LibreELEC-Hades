   m_DRM->FlipPage(bo, rendered, videoLayer, async);
   // Hades: whether the driver took the HDR10+ metadata that the request carried
   HDR10PlusCommitted();
   HdmiVrrOffCommitted();
+  RgbRangeCommitted();
   // ... and the commit that a hold of the change of mode released, if any, went out
   m_hdr10Plus.HeldModeCommitted();
 
@@ -2822,10 +2828,34 @@ void CWinSystemGbm::FlipPage(bool rendered, bool videoLayer, bool async)
   }
 }
 
+namespace
+{
+// Hades: what the connector offers of "Broadcast RGB", and the value the kernel has (CRgbRange)
+CRgbRange::Connector RgbRangeOf(const CDRMConnector* connector)
+{
+  CRgbRange::Connector range;
+  if (!connector)
+    return range;
+  range.automatic = connector->GetPropertyEnumValue(CRgbRange::PROPERTY, CRgbRange::AUTOMATIC);
+  range.limited = connector->GetPropertyEnumValue(CRgbRange::PROPERTY, CRgbRange::LIMITED);
+  range.kernel = connector->GetPropertyValue(CRgbRange::PROPERTY);
+  return range;
+}
+} // namespace
+
 bool CWinSystemGbm::UseLimitedColor()
 {
-  return CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
-      CSettings::SETTING_VIDEOSCREEN_LIMITEDRANGE);
+  // Hades: where the driver makes the limited range (Broadcast RGB "Limited 16:235", CRgbRange),
+  // Kodi draws full range, so that the range is compressed once
+  return CRgbRange::KodiCompresses(LimitedRangeSetting(),
+                                   RgbRangeOf(m_DRM ? m_DRM->GetConnector() : nullptr));
+}
+
+bool CWinSystemGbm::LimitedRangeSetting() const
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool(CSettings::SETTING_VIDEOSCREEN_LIMITEDRANGE);
 }
 
 bool CWinSystemGbm::Hide()
@@ -3277,6 +3307,7 @@ void CWinSystemGbm::AdoptOutput()
   m_hdrDepthChoice = connector->SupportsProperty("NV_OUTPUT_BPC") &&
                      connector->GetRangePropertyLimits("max bpc");
   ReadLinkDepthOutput(*connector);
+  ReadRgbRangeOutput();
   const std::vector<uint8_t> edid = connector->GetEDID();
   std::shared_ptr<const UTILS::CDisplayInfo> info;
   if (!edid.empty())
@@ -3508,6 +3539,161 @@ void CWinSystemGbm::HdmiVrrOffCommitted()
               CHdmiVrrOff::PROPERTY);
 }
 
+void CWinSystemGbm::ReadRgbRangeOutput()
+{
+  m_rgbRangeStaged.reset();
+  m_rgbRangeRefusals = 0;
+  m_rgbRangeSetting.reset();
+  m_rgbRangeTold.clear();
+  m_rgbRangeDriver.clear();
+  if (!m_DRM)
+    return;
+  if (drmVersionPtr version = drmGetVersion(m_DRM->GetFileDescriptor()))
+  {
+    if (version->name)
+      m_rgbRangeDriver = version->name;
+    drmFreeVersion(version);
+  }
+}
+
+void CWinSystemGbm::StageRgbRange()
+{
+  m_rgbRangeStaged.reset();
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return;
+  const bool setting = LimitedRangeSetting();
+  // (a change of the setting is asked again on an output where the driver refused the other)
+  if (m_rgbRangeSetting != setting)
+  {
+    m_rgbRangeSetting = setting;
+    m_rgbRangeRefusals = 0;
+  }
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const CRgbRange::Step step = CRgbRange::Stage(
+      setting, RgbRangeOf(connector), m_rgbRangeRefusals >= CRgbRange::REFUSALS,
+      NativeDVOutputInUse(), drm->RequestValue(connector, CRgbRange::PROPERTY).has_value(),
+      drm->ModesetPending(), player && player->IsPlayingVideo());
+  if (!step.value || !drm->AddProperty(connector, CRgbRange::PROPERTY, *step.value))
+    return;
+  m_rgbRangeStaged = step.value;
+  if (!step.allowModeset)
+    return;
+  drm->AllowModeset();
+  const auto name = connector->GetPropertyEnumName(CRgbRange::PROPERTY, *step.value);
+  CLog::Log(LOGINFO,
+            "RGB range: Broadcast RGB \"{}\" goes to {} with a mode set of its own, as \"Use "
+            "limited colour range\" is {}",
+            name.value_or("?"), connector->GetName(), setting ? "on" : "off");
+}
+
+void CWinSystemGbm::RgbRangeCommitted()
+{
+  const auto staged = std::exchange(m_rgbRangeStaged, std::nullopt);
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return;
+  const CRgbRange::Connector range = RgbRangeOf(connector);
+  const auto name = [connector](std::optional<uint64_t> value)
+  {
+    const auto text =
+        value ? connector->GetPropertyEnumName(CRgbRange::PROPERTY, *value) : std::nullopt;
+    return text ? "\"" + *text + "\"" : std::string("nothing readable");
+  };
+  switch (CRgbRange::AfterCommit(staged, range.kernel, drm->LastCommitRefused()))
+  {
+    case CRgbRange::Outcome::TAKEN:
+      m_rgbRangeRefusals = 0;
+      break;
+    case CRgbRange::Outcome::REFUSED:
+      if (++m_rgbRangeRefusals >= CRgbRange::REFUSALS)
+        CLog::Log(LOGWARNING,
+                  "RGB range: the driver refused Broadcast RGB {} on {} ({} commits): Kodi makes "
+                  "the range itself on this output, as before (the kernel has {})",
+                  name(staged), connector->GetName(), m_rgbRangeRefusals, name(range.kernel));
+      else
+        CLog::Log(LOGWARNING,
+                  "RGB range: the driver refused the commit with Broadcast RGB {} on {}: it is "
+                  "asked again with the next mode set",
+                  name(staged), connector->GetName());
+      break;
+    case CRgbRange::Outcome::NONE:
+    case CRgbRange::Outcome::PENDING:
+      break;
+  }
+
+  // Once for each mode and range: what Kodi asks for, the property and its value, and who
+  // compresses the range. (Native Dolby Vision says what its transport sends.)
+  if (NativeDVOutputInUse())
+    return;
+  const bool setting = LimitedRangeSetting();
+  const auto* mode = m_DRM->GetSelectedMode();
+  const std::string told = StringUtils::Format(
+      "{}|{}|{}x{}|{}|{}x{}|{}|{}|{}", connector->GetName(), m_rgbRangeDriver,
+      mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0, mode ? mode->clock : 0,
+      mode ? mode->htotal : 0, mode ? mode->vtotal : 0, range.kernel.value_or(UINT64_MAX), setting,
+      m_rgbRangeRefusals >= CRgbRange::REFUSALS);
+  if (told == m_rgbRangeTold)
+    return;
+  m_rgbRangeTold = told;
+  const double refresh = mode && mode->htotal && mode->vtotal
+                             ? mode->clock * 1000.0 / (mode->htotal * mode->vtotal)
+                             : 0;
+  const std::string where =
+      StringUtils::Format("RGB range: {} ({}), {}x{} at {:.3f} Hz: \"Use limited colour range\" is {}",
+                          connector->GetName(),
+                          m_rgbRangeDriver.empty() ? "unknown driver" : m_rgbRangeDriver,
+                          mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0, refresh,
+                          setting ? "on" : "off");
+  const bool automatic = range.automatic && range.kernel && *range.kernel == *range.automatic;
+  const char* const automaticRule =
+      automatic ? " (at \"Automatic\": Intel's limited range on every TV mode, AMD's on the TV modes "
+                  "of a display that cannot select the range, full range elsewhere)"
+                : "";
+  const bool nvidia = m_rgbRangeDriver == "nvidia-drm";
+  const auto info = DisplayInfo();
+  const bool qs = info && info->SupportsRGBQuantizationSelection();
+  if (!range.kernel || !range.limited || !range.automatic)
+  {
+    if (setting)
+      CLog::Log(LOGINFO,
+                "{}; the driver has no Broadcast RGB on this connector: Kodi compresses its "
+                "picture to 16-235 itself{}",
+                where,
+                nvidia && qs ? "; the display can select the RGB range, and nvidia-drm tells it "
+                               "full range in the AVI InfoFrame: unless its black level is set "
+                               "to limited, it shows this picture with raised blacks"
+                             : "");
+    else
+      CLog::Log(LOGINFO,
+                "{}; the driver has no Broadcast RGB on this connector: Kodi draws full range, "
+                "and the driver sends the range it chooses{}",
+                where,
+                nvidia && !qs ? " (nvidia-drm: full range, which a display that cannot select "
+                                "the range takes as limited at its TV modes: with crushed "
+                                "shadows, turn the setting on)"
+                              : "");
+  }
+  else if (setting && CRgbRange::KernelLimits(range))
+    CLog::Log(LOGINFO,
+              "{}, and the driver makes it: Broadcast RGB is \"{}\", so the driver compresses "
+              "everything on the output to 16-235 once, and Kodi draws full range",
+              where, CRgbRange::LIMITED);
+  else if (setting)
+    CLog::Log(LOGINFO, "{}; Broadcast RGB is {}{}: Kodi compresses its picture to 16-235 itself{}",
+              where, name(range.kernel),
+              m_rgbRangeRefusals >= CRgbRange::REFUSALS
+                  ? ", as the driver refused \"Limited 16:235\""
+                  : ", until a commit with a mode set carries \"Limited 16:235\"",
+              automaticRule);
+  else
+    CLog::Log(LOGINFO,
+              "{}; Broadcast RGB is {}: the driver chooses the range{}, and Kodi draws full range",
+              where, name(range.kernel), automaticRule);
+}
+
 bool CWinSystemGbm::HDR10PlusChangesAviAfterMode() const
 {
   CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
