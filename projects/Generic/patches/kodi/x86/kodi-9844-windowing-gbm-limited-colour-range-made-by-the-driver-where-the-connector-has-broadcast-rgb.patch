+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: Kodi's "Use limited colour range (16-235)" made by the driver where the connector
+ *        has the "Broadcast RGB" property, so that the range is compressed once
+ *
+ * Kodi makes limited range by drawing everything in 16-235 (its GUI shaders, the video's shaders,
+ * the GUI composed over HDR, the DRM PRIME renderer: all of them ask UseLimitedColor()). The
+ * drivers with "Broadcast RGB" compress the range themselves at "Automatic" in some modes:
+ * - i915 and xe (intel_hdmi_limited_color_range(), intel_dp_limited_color_range()): limited range
+ *   on every CTA mode of an HDMI sink but 640x480, whether the sink can select the range or not;
+ * - amdgpu (Linux 7.3 with linux-9971 and linux-9983, rgb_output_is_limited_range()): limited
+ *   range on the CTA modes of an HDMI sink that cannot select the range (no QS), full range on one
+ *   that can, such as the LG C5.
+ * With Kodi's setting on, the picture was then compressed twice on Intel at every TV mode (raised
+ * blacks, dull whites), and twice on AMD for a TV without QS; on AMD with a TV with QS it went out
+ * in 16-235 while the AVI InfoFrame said full range. Only RGB is concerned: the drivers make their
+ * YCbCr output limited range from the full range of the framebuffer, so Kodi's 16-235 was
+ * compressed twice there too (HDR in YCbCr 4:2:0 or 4:2:2, linux-9966 to linux-9972).
+ *
+ * Where the connector has the property with its "Limited 16:235" value, Kodi's setting asks the
+ * driver for it, and Kodi draws full range once the kernel has it (KodiCompresses()): the driver
+ * compresses everything on the output once (planes, cursor, the console after Kodi), and its AVI
+ * InfoFrame says limited range where the sink can be told. With the setting off the property is
+ * not touched (today's output), but where Kodi itself left it at "Limited 16:235" (the setting
+ * was on): it goes back to "Automatic". A change of it needs a mode set (i915 makes one of it,
+ * intel_digital_connector_atomic_check()): it goes in a commit that allows one, never while a video
+ * plays unless the video makes one anyway, and never in a commit whose request has the property
+ * already (native Dolby Vision, whose transport sets "Full" and puts back what it found; the
+ * clean-up of a session that ended with it). A commit with it that the driver refuses is asked
+ * again with the next mode set, REFUSALS times: then Kodi makes the range itself on that output,
+ * as before (fail closed). nvidia-drm has no such property: Kodi makes the range there, as before.
+ */
+class CRgbRange
+{
+public:
+  static constexpr const char* PROPERTY = "Broadcast RGB";
+  static constexpr const char* AUTOMATIC = "Automatic";
+  static constexpr const char* FULL = "Full";
+  static constexpr const char* LIMITED = "Limited 16:235";
+  //! commits refused with the property in them before Kodi makes the range itself on an output
+  static constexpr unsigned int REFUSALS = 2;
+
+  //! What the connector offers, and the value the kernel has (the last commit)
+  struct Connector
+  {
+    std::optional<uint64_t> automatic; //!< the value of "Automatic", where the property has it
+    std::optional<uint64_t> limited; //!< ... of "Limited 16:235"
+    std::optional<uint64_t> kernel; //!< the value of the property, where the connector has it
+  };
+
+  //! The driver compresses the range of the RGB output: the kernel has "Limited 16:235"
+  static bool KernelLimits(const Connector& connector)
+  {
+    return connector.limited && connector.kernel && *connector.kernel == *connector.limited;
+  }
+
+  //! Kodi draws in 16-235 (UseLimitedColor()): its setting asks for limited range, and the driver
+  //! does not make it on this output
+  static bool KodiCompresses(bool setting, const Connector& connector)
+  {
+    return setting && !KernelLimits(connector);
+  }
+
+  //! The value that the property should have (nothing: it is left as the kernel has it)
+  static std::optional<uint64_t> Wanted(bool setting, const Connector& connector)
+  {
+    if (!connector.kernel || !connector.limited || !connector.automatic)
+      return std::nullopt;
+    if (setting)
+      return *connector.limited;
+    // (with the setting off, only Kodi's own value is taken back: "Automatic" and "Full" stay)
+    if (*connector.kernel == *connector.limited)
+      return *connector.automatic;
+    return std::nullopt;
+  }
+
+  struct Step
+  {
+    std::optional<uint64_t> value; //!< to add to the request of this commit
+    bool allowModeset = false; //!< this commit is made one that allows a mode set, for it
+  };
+
+  /*!
+   * \brief What the request of this commit carries: givenUp, the driver refused it REFUSALS times
+   *        on this output; transport, native Dolby Vision has the output; inRequest, the request
+   *        has the property already; modesetPending, the commit allows a mode set already;
+   *        videoPlays, a video plays (no mode set is made for it then)
+   */
+  static Step Stage(bool setting,
+                    const Connector& connector,
+                    bool givenUp,
+                    bool transport,
+                    bool inRequest,
+                    bool modesetPending,
+                    bool videoPlays)
+  {
+    const auto want = Wanted(setting, connector);
+    if (!want || *want == *connector.kernel || givenUp || transport || inRequest)
+      return {};
+    if (!modesetPending && videoPlays)
+      return {};
+    return {want, !modesetPending};
+  }
+
+  enum class Outcome
+  {
+    NONE, //!< the commit did not carry it
+    TAKEN, //!< the kernel has it
+    REFUSED, //!< the commit was refused (or went out with the request before it)
+    PENDING, //!< the commit did not go out yet
+  };
+
+  //! What came of a commit that carried staged (the kernel has kernel after it)
+  static Outcome AfterCommit(std::optional<uint64_t> staged,
+                             std::optional<uint64_t> kernel,
+                             bool refused)
+  {
+    if (!staged)
+      return Outcome::NONE;
+    if (kernel && *kernel == *staged)
+      return Outcome::TAKEN;
+    return refused ? Outcome::REFUSED : Outcome::PENDING;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
