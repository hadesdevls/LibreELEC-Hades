@@ -320,6 +320,20 @@ protected:
   std::optional<uint64_t> m_hdmiVrrOffStaged;
   void StageHdmiVrrOff();
   void HdmiVrrOffCommitted();
+  //! Hades: Kodi's limited range made by the driver where the connector has "Broadcast RGB"
+  //! (CRgbRange): staged in a commit that allows a mode set (StageRgbRange()), what came of it said
+  //! after the commit, with a line of the log for each mode and range (RgbRangeCommitted()), and
+  //! read again with each output (ReadRgbRangeOutput())
+  std::optional<uint64_t> m_rgbRangeStaged;
+  unsigned int m_rgbRangeRefusals = 0;
+  std::optional<bool> m_rgbRangeSetting;
+  std::string m_rgbRangeTold;
+  std::string m_rgbRangeDriver;
+  void StageRgbRange();
+  void RgbRangeCommitted();
+  void ReadRgbRangeOutput();
+  //! Kodi's setting "Use limited colour range (16-235)"
+  bool LimitedRangeSetting() const;
   //! \brief Hades: native Dolby Vision output has the output. Its transport is no picture
   //! that the display could take as two eyes: no 3D output is chosen meanwhile.
   virtual bool NativeDVOutputInUse() const { return false; }
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
index 5bab189..b531a50 100644
--- a/xbmc/windowing/gbm/drm/DVBridgeState.cpp
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -124,7 +124,9 @@ void CDVBridgeState::ClearLeftover(CDRMAtomic& drm)
   if (auto dither = connector->GetPropertyEnumValue("dithering mode", "auto"))
     drm.AddProperty(connector, "dithering mode", *dither);
   // It also forced full-range RGB and opaque, unblended planes; the ordinary output never sets
-  // these either, so they go back to the drivers' defaults.
+  // these either, so they go back to the drivers' defaults. (Hades: but for Kodi's limited range
+  // where the driver makes it, CRgbRange: the next mode set asks for "Limited 16:235" again,
+  // CWinSystemGbm::StageRgbRange().)
   if (auto range = connector->GetPropertyEnumValue("Broadcast RGB", "Automatic"))
     drm.AddProperty(connector, "Broadcast RGB", *range);
   for (auto* plane : {drm.GetGuiPlane(), drm.GetVideoPlane()})
-- 
