From 3df2e4617434cfb71846bf7a2ef04534cdffa2a4 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:23 +0000
Subject: [PATCH] MultiviewPacker: two more ways out of a stream whose second
 view cannot be shown

A stream whose second view never comes is given up, for the decoder of
every other stream, after 240 base views went out alone: ten seconds of
a flat picture in a 3D mode. Where the decoder gives one view only (a
stream of three views or more, or one whose second view it never learnt
of), its pictures say so from the first one: they do not name their
view. 48 such pictures in a row, with no pair ever made, now give the
stream up.

And nothing ended a run of pictures of which none could go out: second
views alone, after a pair had been made once, would have left the video
standing still. No stream at hand does that with this decoder; 48
pictures in a row without one going out now give the stream up as well.

Host test: multiview_test (the counts, and what they are for streams as
they come).
---
 .../DVDCodecs/Video/MultiviewPacker.cpp       | 11 ++++++-
 .../DVDCodecs/Video/MultiviewPacker.h         |  2 ++
 xbmc/cores/VideoPlayer/MultiviewChoice.h      | 30 ++++++++++++++++---
 3 files changed, 38 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
index faa3735..3fd3729 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.cpp
@@ -162,6 +162,7 @@ CMultiviewPacker::Result CMultiviewPacker::Out(AVFrame* frame, bool packed, bool
     ++m_paired;
   else
     ++m_alone;
+  m_withoutPicture = 0;
   return Result::PICTURE;
 }
 
@@ -177,6 +178,9 @@ CMultiviewPacker::Result CMultiviewPacker::Add(AVFrame* frame)
               "view, which is the {} eye",
               *m_baseId, BaseOnLeft(m_baseEye) ? "left" : "right");
   }
+  // what the stream is given up by (KODI::MULTIVIEW::GiveUp())
+  m_unnamed = view.hasId ? 0 : m_unnamed + 1;
+  ++m_withoutPicture;
   const int baseId = m_baseId.value_or(0);
 
   switch (Take(m_waitingView, view, baseId))
@@ -226,6 +230,7 @@ void CMultiviewPacker::Reset()
   Forget();
   av_frame_unref(m_packed);
   m_refused = 0;
+  m_withoutPicture = 0;
 }
 
 void CMultiviewPacker::Sent(bool refused)
@@ -241,7 +246,7 @@ void CMultiviewPacker::Fail(const char* reason)
 
 bool CMultiviewPacker::GivenUp() const
 {
-  return m_failure || GiveUp(m_paired, m_alone, m_refused);
+  return m_failure || GiveUp(m_paired, m_alone, m_refused, m_unnamed, m_withoutPicture);
 }
 
 const char* CMultiviewPacker::Reason() const
@@ -250,5 +255,9 @@ const char* CMultiviewPacker::Reason() const
     return m_failure;
   if (m_refused >= REFUSED_UNTIL_GIVEN_UP)
     return "the decoder refuses its packets";
+  if (m_withoutPicture >= UNSHOWN_UNTIL_GIVEN_UP)
+    return "pictures come from the decoder and none of them can be shown";
+  if (m_paired == 0 && m_unnamed >= UNNAMED_UNTIL_GIVEN_UP)
+    return "the decoder gives one view of it only";
   return "its second view does not come";
 }
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
index d91867b..ae1adb6 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/MultiviewPacker.h
@@ -92,5 +92,7 @@ private:
   uint64_t m_alone{0}; //!< base views gone out alone
   uint64_t m_unshown{0}; //!< second views that came without their base view
   unsigned int m_refused{0}; //!< packets in a row that the decoder refused
+  unsigned int m_unnamed{0}; //!< pictures in a row that came without the name of their view
+  unsigned int m_withoutPicture{0}; //!< pictures in a row from the decoder of which none went out
   const char* m_failure{nullptr};
 };
diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index c59089c..1086365 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -401,18 +401,40 @@ inline constexpr unsigned int ALONE_UNTIL_GIVEN_UP = 240;
 //! Packets in a row that the decoder refused, after which it is taken not to work on the stream
 inline constexpr unsigned int REFUSED_UNTIL_GIVEN_UP = 48;
 
+//! Pictures in a row that came without the name of their view, with none ever paired, after
+//! which the decoder is taken to give one view of the stream only (two seconds of film: a
+//! stream of three views or more, or one whose second view the decoder never learnt of)
+inline constexpr unsigned int UNNAMED_UNTIL_GIVEN_UP = 48;
+
+//! Pictures in a row from the decoder of which none went out, after which what it gives is
+//! taken to be nothing that can be shown (second views alone: the video would stand still
+//! for as long as they come)
+inline constexpr unsigned int UNSHOWN_UNTIL_GIVEN_UP = 48;
+
 /*!
  * \brief Whether the stream goes back to the decoder of every other stream, for its base view
  *
  * Not for a second view that is missing for a while once it has been there (a damaged part, the
  * pictures after a seek that wait for the next one that starts from nothing): then the base
  * view goes out alone and the second one is taken again when it comes. Only when it never came,
- * or when the decoder takes nothing: such a stream plays as it did before, with what that
- * decoder has (hardware decoding).
+ * or when the decoder takes nothing, or gives nothing that can be shown: such a stream plays
+ * as it did before, with what that decoder has (hardware decoding).
+ *
+ * \param paired pictures of two views that went out
+ * \param alone base views that went out alone
+ * \param refusedInARow packets in a row that the decoder refused
+ * \param unnamedInARow pictures in a row that came without the name of their view
+ * \param unshownInARow pictures in a row from the decoder of which none went out
  */
-inline bool GiveUp(uint64_t paired, uint64_t alone, unsigned int refusedInARow)
+inline bool GiveUp(uint64_t paired,
+                   uint64_t alone,
+                   unsigned int refusedInARow,
+                   unsigned int unnamedInARow = 0,
+                   unsigned int unshownInARow = 0)
 {
-  return (paired == 0 && alone >= ALONE_UNTIL_GIVEN_UP) || refusedInARow >= REFUSED_UNTIL_GIVEN_UP;
+  return (paired == 0 &&
+          (alone >= ALONE_UNTIL_GIVEN_UP || unnamedInARow >= UNNAMED_UNTIL_GIVEN_UP)) ||
+         refusedInARow >= REFUSED_UNTIL_GIVEN_UP || unshownInARow >= UNSHOWN_UNTIL_GIVEN_UP;
 }
 
 //! @}
