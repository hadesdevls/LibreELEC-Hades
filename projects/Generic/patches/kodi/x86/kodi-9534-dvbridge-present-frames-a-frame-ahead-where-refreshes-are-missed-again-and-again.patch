From d1999705c2fe7757187d90e62a28fcba3628afde Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:12:33 +0000
Subject: [PATCH] [DVBridge] Present frames a frame ahead where refreshes are
 missed again and again

Native Dolby Vision frames are presented a frame ahead (CDVAhead) only where the average GPU time
of a second of frames takes half of the refresh period or more. That average does not see a frame
that is light on average and late again and again: the logs of issue #4 (Quadro RTX 4000, a
profile 7 film with its enhancement layer at 23.976 Hz) have GPU times of 6 to 10 ms on average,
up to 45 ms, and 229 of 16 571 frames presented the way that waits without GUI elements missed
their refresh (14 in 1000, a repeated frame every few seconds), none of them a frame ahead.

The window system now also tells CDVAhead every frame presented the way that waits that says
whether such frames keep up: one of the video playing, without GUI elements, whose commit changed
nothing but the picture, after another one presented that way. Runs of 240 of them (ten seconds of
film) in which 3 or more missed their refresh, in two of the last three runs, call for frames
ahead, told once in kodi.log with the figures:

  DVBridge: frames presented the way that waits missed their refresh again and again (N and then M
  of 240 frames without GUI elements, in two of the last three runs of them; GPU x ms on average,
  of the y ms of a refresh): presenting them a frame ahead is now called for

The mark comes from the logs: replayed frame by frame (the late frames at random places in each
10 s window, 50 seeds, with and without the windows that had GUI elements), the Quadro log calls
for it in every replay within 3 or 4 windows, and no log of an RTX 4080 SUPER (one of them 61 200
frames without GUI elements, 11 late, one window with 3) calls for it in any. A single run of 3
would have called for it on the RTX 4080 SUPER.

What the misses call for is kept like what the GPU time calls for, per refresh rate and from one
video to the next, and an average of light frames does not end it: the frames were light on
average when they missed their refreshes, and while frames are presented a frame ahead nothing
says whether they would miss them, so it would begin and end again every few seconds. The time set
aside after a seek (2 s) and after GUI elements come or go (the first second of frames without
them) counts for nothing; a run goes on across a change of the GUI, or a film with subtitles would
never end one. Three failures still give frames ahead up for the output, as before.

Host test: dvahead_test, 72 checks and the replay of the logs; against the header before, 13 of
them fail.
---
 xbmc/windowing/gbm/DVAhead.h                  | 128 +++++++++++++++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  27 ++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |   3 +
 3 files changed, 153 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/DVAhead.h b/xbmc/windowing/gbm/DVAhead.h
index 4741bda..2de1c10 100644
--- a/xbmc/windowing/gbm/DVAhead.h
+++ b/xbmc/windowing/gbm/DVAhead.h
@@ -48,6 +48,21 @@ namespace GBM
  * ahead and the next one no longer (the log of an RTX 4080 Laptop GPU: averages of 21 to 25 ms of
  * 41.7 in that second, with frames of up to 57 to 112 ms in it, against 13 to 16 ms in the seconds
  * after it with the GUI still there; six times in one session, each over in one or two seconds).
+ *
+ * Hades: what an average of the GPU time does not see is a frame that is light on average and late
+ * again and again: the times of a Quadro RTX 4000 (issue #4, a profile 7 film with its enhancement
+ * layer at 23.976 Hz) were 6 to 10 ms on average and up to 45 ms, and 229 of 16 571 frames
+ * presented the way that waits without GUI elements missed their refresh (14 in 1000), none of them
+ * a frame ahead. The frames presented the way that waits are therefore told here too, whether each
+ * came in time (PresentedWaiting()): where they miss their refresh again and again, frames ahead
+ * are called for as well. "Again and again" is MISS_LATE or more of MISS_WINDOW frames, in two of
+ * the last three runs of MISS_WINDOW: in the logs of an RTX 4080 SUPER the most were 11 of 61 200
+ * frames, and one run of 240 with 3, which a single run would have taken for it. What the misses
+ * call for is kept like the rest: from one video to the next at that refresh rate, and an average
+ * of light frames does not end it (they were light on average when they missed their refreshes). A
+ * frame cannot tell whether it would have missed its refresh while frames are presented a frame
+ * ahead, so nothing would bring it back if it ended, and every few seconds it would begin and end
+ * again.
  */
 class CDVAhead
 {
@@ -96,17 +111,20 @@ public:
     m_sum = 0.0;
     const bool aside = m_windowAside;
     m_windowAside = false;
-    const bool needed = Needed(periodMs);
-    if (!needed && m_average >= (aside ? 1.0 : HEAVY) * periodMs)
+    // Hades: (what the GPU time called for, and what refreshes missed called for: the one does not
+    // end the other)
+    const bool byTime = m_needed && SamePeriod(periodMs, m_neededPeriod);
+    const bool byMisses = MissesCallForIt(periodMs);
+    if (!byTime && !byMisses && m_average >= (aside ? 1.0 : HEAVY) * periodMs)
     {
       m_needed = true;
       m_neededPeriod = periodMs;
       return Change::NEEDED;
     }
-    if (needed && !aside && m_average <= LIGHT * periodMs)
+    if (byTime && !aside && m_average <= LIGHT * periodMs)
     {
       m_needed = false;
-      return Change::NOT_NEEDED;
+      return byMisses ? Change::NONE : Change::NOT_NEEDED;
     }
     return Change::NONE;
   }
@@ -114,6 +132,61 @@ public:
   //! The average that Measured() last decided with
   double Average() const { return m_average; }
 
+  /*!
+   * \brief Hades: a frame presented the way that waits, of the video playing, without GUI elements
+   *        and with nothing but the picture in its commit, and whether it came later than one and a
+   *        half refresh periods: it missed its refresh
+   * \return NEEDED when such frames now call for frames ahead (told once), else NONE
+   */
+  Change PresentedWaiting(bool late, double periodMs)
+  {
+    if (!(periodMs > 0.0))
+      return Change::NONE;
+    // Frames at another refresh rate are another matter, as in Measured()
+    if (!SamePeriod(periodMs, m_missPeriod))
+    {
+      m_missPeriod = periodMs;
+      m_missFrames = 0;
+      m_missLate = 0;
+      m_missRuns = 0;
+    }
+    // (the frames of the time set aside after a seek, or after GUI elements went, count for
+    // nothing)
+    if (m_missAsideMs > 0.0)
+    {
+      m_missAsideMs -= periodMs;
+      return Change::NONE;
+    }
+    m_missLate += late ? 1 : 0;
+    if (++m_missFrames < MISS_WINDOW)
+      return Change::NONE;
+    const unsigned int lateInRun = m_missLate;
+    m_missFrames = 0;
+    m_missLate = 0;
+    // the last three runs, the newest in the lowest bit
+    m_missRuns = ((m_missRuns << 1) | (lateInRun >= MISS_LATE ? 1u : 0u)) & 0x7u;
+    if (lateInRun >= MISS_LATE)
+    {
+      m_missLateBefore = m_missLateLast;
+      m_missLateLast = lateInRun;
+    }
+    if (lateInRun < MISS_LATE || Needed(periodMs))
+      return Change::NONE;
+    const unsigned int runs =
+        (m_missRuns & 1u) + ((m_missRuns >> 1) & 1u) + ((m_missRuns >> 2) & 1u);
+    if (runs < MISS_RUNS)
+      return Change::NONE;
+    m_missRuns = 0;
+    m_missNeeded = true;
+    m_missNeededPeriod = periodMs;
+    return Change::NEEDED;
+  }
+
+  //! Hades: the frames that missed their refresh in the two runs that called for it last (newest
+  //! second), for the log
+  unsigned int MissedBefore() const { return m_missLateBefore; }
+  unsigned int MissedLast() const { return m_missLateLast; }
+
   //! Hades: the video jumped (a seek, a change of stream): its frames are slow and late for that
   //! (the decoder starts again; the GPU's clocks go down while it waits, and the GUI comes with the
   //! seek). SEEK_ASIDE_MS of them are set aside, as the fidelity step-down sets them aside
@@ -124,6 +197,10 @@ public:
     m_sum = 0.0;
     m_windowAside = false;
     m_asideMs = std::max(m_asideMs, SEEK_ASIDE_MS);
+    // Hades: and the run of frames presented the way that waits begins again after that time
+    m_missFrames = 0;
+    m_missLate = 0;
+    m_missAsideMs = std::max(m_missAsideMs, SEEK_ASIDE_MS);
   }
 
   //! Hades: GUI elements came over the video, or went: the first frames drawn the other way are
@@ -135,11 +212,24 @@ public:
     m_count = 0;
     m_sum = 0.0;
     m_windowAside = true;
+    // Hades: of the frames presented the way that waits, the first CHANGE_ASIDE_MS of them without
+    // GUI elements after the change (the frames with them are not told at all). The run goes on: a
+    // film with subtitles changes every few seconds, and its runs would never end.
+    m_missAsideMs = std::max(m_missAsideMs, CHANGE_ASIDE_MS);
   }
 
   //! The frames at this refresh rate call for it, as far as they have been measured. Kept from
   //! one video to the next: the first frames of the next one then have it too.
-  bool Needed(double periodMs) const { return m_needed && SamePeriod(periodMs, m_neededPeriod); }
+  bool Needed(double periodMs) const
+  {
+    return (m_needed && SamePeriod(periodMs, m_neededPeriod)) || MissesCallForIt(periodMs);
+  }
+
+  //! Hades: ... because frames presented the way that waits missed their refreshes
+  bool MissesCallForIt(double periodMs) const
+  {
+    return m_missNeeded && SamePeriod(periodMs, m_missNeededPeriod);
+  }
 
   //! Whether the next frame is to be presented a frame ahead
   bool Wanted(Mode mode, double periodMs) const
@@ -203,6 +293,12 @@ public:
     m_sum = 0.0;
     m_asideMs = 0.0;
     m_windowAside = false;
+    // Hades: the runs of frames presented the way that waits, as the average (what they called
+    // for is kept)
+    m_missFrames = 0;
+    m_missLate = 0;
+    m_missRuns = 0;
+    m_missAsideMs = 0.0;
     return gone;
   }
 
@@ -223,6 +319,18 @@ private:
   //! Hades: the time of the video set aside after a seek (as CDVStepDown::SETTLE_MS)
   static constexpr double SEEK_ASIDE_MS = 2000.0;
 
+public:
+  //! Hades: frames presented the way that waits in a run (ten seconds of film), ...
+  static constexpr unsigned int MISS_WINDOW = 240;
+  //! ... the ones of a run that missed their refresh from which the run counts (1.25 %) ...
+  static constexpr unsigned int MISS_LATE = 3;
+  //! ... and the runs of the last three that call for frames ahead
+  static constexpr unsigned int MISS_RUNS = 2;
+  //! ... where the first second after GUI elements came or went is set aside (the GPU's clocks)
+  static constexpr double CHANGE_ASIDE_MS = 1000.0;
+
+private:
+
   unsigned int m_count = 0;
   double m_sum = 0.0;
   double m_windowPeriod = 0.0;
@@ -237,6 +345,16 @@ private:
   bool m_gone = false;
   double m_asideMs = 0.0; //!< Hades: of the video still set aside after a seek
   bool m_windowAside = false; //!< Hades: the average being taken has frames set aside
+  // Hades: frames presented the way that waits (PresentedWaiting())
+  double m_missPeriod = 0.0;
+  unsigned int m_missFrames = 0; //!< of the run being counted
+  unsigned int m_missLate = 0; //!< ... that missed their refresh
+  unsigned int m_missRuns = 0; //!< the last three runs: 1 for one that counts
+  double m_missAsideMs = 0.0;
+  bool m_missNeeded = false;
+  double m_missNeededPeriod = 0.0;
+  unsigned int m_missLateBefore = 0;
+  unsigned int m_missLateLast = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 299e147..f1bc179 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -581,6 +581,13 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         m_dvStepFlipFrame = m_dvStepFrame;
       else if (presented && periodMs > 0)
         DVStepPresented(m_dvStepFrame, late, DVStepPace());
+      // Hades: ... and whether frames presented the way that waits miss their refresh again and
+      // again, which calls for frames ahead (CDVAhead::PresentedWaiting()): a frame of the video
+      // playing, without GUI elements, whose commit changed nothing but the picture, after another
+      // one presented that way (the first one after frames ahead waited for their flips too)
+      if (presented && !presentedAhead && plainFrame && drainFlipNs == 0 && periodMs > 0 &&
+          m_dvStepFrame.valid && m_dvStepFrame.measured)
+        DVAheadWaited(late, periodMs);
       if (presented)
       {
         if (m_dvStats.hasLastShown)
@@ -4079,6 +4086,26 @@ void CWinSystemGbmGLESContext::DVAheadFailed(const char* what, bool forGood)
                       : ", and so are the frames after it in this video");
 }
 
+void CWinSystemGbmGLESContext::DVAheadWaited(bool late, double periodMs)
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  // (only where frames ahead go by need, and can still be had: DVAheadWanted() read the mode with
+  // the first frame of the transport)
+  if (!m_eglFence || !m_dvAheadModeRead || m_dvAheadMode != CDVAhead::Mode::NEEDED ||
+      m_dvAhead.Off())
+    return;
+  if (m_dvAhead.PresentedWaiting(late, periodMs) != CDVAhead::Change::NEEDED)
+    return;
+  CLog::Log(LOGINFO,
+            "DVBridge: frames presented the way that waits missed their refresh again and again "
+            "({} and then {} of {} frames without GUI elements, in two of the last three runs of "
+            "them; GPU {:.1f} ms on average, of the {:.1f} ms of a refresh): presenting them a "
+            "frame ahead is now called for",
+            m_dvAhead.MissedBefore(), m_dvAhead.MissedLast(), CDVAhead::MISS_WINDOW,
+            m_dvAhead.Average(), periodMs);
+#endif
+}
+
 void CWinSystemGbmGLESContext::FinishDVBridgeRendering()
 {
   glFinish();
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 6adaf8f..f9f221f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -629,6 +629,9 @@ private:
   void DVAheadEnd(bool presented, const DVFlip& flip);
   //! A frame could not be presented a frame ahead, and was or will be presented the other way
   void DVAheadFailed(const char* what, bool forGood = false);
+  //! Hades: a frame presented the way that waits that tells whether such frames miss their refresh
+  //! (CDVAhead::PresentedWaiting()), and whether it missed its own
+  void DVAheadWaited(bool late, double periodMs);
   //! Hades: the fidelity step-down level of the next native Dolby Vision frame (see
   //! dvbridge_render_set_step()), of that kind of stream and that format (see CDVFrameLoad; 0: not
   //! known), with those levels that change anything for it: the one that the setting or
