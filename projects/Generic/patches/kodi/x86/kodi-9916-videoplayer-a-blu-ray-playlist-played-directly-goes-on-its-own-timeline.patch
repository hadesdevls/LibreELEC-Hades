+      // join is told with the step between the two clocks that this puts away.
+      if (!m_navmode && m_event.param > 0)
+      {
+        const BLURAY_CLIP_INFO& before = m_titleInfo->clips[m_event.param - 1];
+        CLog::Log(LOGINFO,
+                  "CDVDInputStreamBluray - play item {} (clip {}) goes on the timeline of the "
+                  "playlist at {:.3f} s: its IN time is {:.3f} s, the play item before ended at "
