+#ifdef HAVE_LIBBLURAY
+void CDVDDemuxFFmpeg::ConvertBlurayTimestamps(DemuxPacket* packet, const AVStream* stream)
+{
+  // a packet without a position is of the play item of its stream's last packet
+  const auto readPos =
+      m_blurayReadPos.try_emplace(m_pkt.pkt.stream_index, m_blurayTitleInput->GetReadPos()).first;
+  if (m_pkt.pkt.pos >= 0)
+    readPos->second = m_blurayReadBase + static_cast<uint64_t>(m_pkt.pkt.pos);
+
+  const auto clip = m_blurayTitleInput->GetClipTime(readPos->second);
+  if (!clip)
+  {
+    if (!m_blurayTitleTimeMissed)
+    {
+      m_blurayTitleTimeMissed = true;
+      CLog::Log(LOGWARNING,
+                "CDVDDemuxFFmpeg - a packet of the playlist (byte {}) was read with no play item "
+                "known: its timestamps are its clip's, not the playlist's",
+                readPos->second);
+    }
+    return;
+  }
+
+  // 90 kHz, as libbluray gives them, to the stream's time base
+  constexpr AVRational CLIP_TIME_BASE = {1, 90000};
+  const int64_t inTime =
+      av_rescale_q(static_cast<int64_t>(clip->inTime), CLIP_TIME_BASE, stream->time_base);
+  const int64_t startTime =
+      av_rescale_q(static_cast<int64_t>(clip->startTime), CLIP_TIME_BASE, stream->time_base);
+  const auto toTitle = [&](int64_t timestamp) -> double
+  {
+    if (timestamp == AV_NOPTS_VALUE)
+      return DVD_NOPTS_VALUE;
+    double seconds = static_cast<double>(KODI::BLURAYTIMELINE::TitleTimestamp(
+                         timestamp, inTime, startTime, stream->pts_wrap_bits)) *
+                     stream->time_base.num / stream->time_base.den;
+    // as ConvertTimestamp(): a packet just before the start (its decoding time, a picture
+    // presented before the IN time) is put at it
+    if (seconds < 0 && seconds + 0.5 > 0)
+      seconds = 0;
+    return seconds * DVD_TIME_BASE;
+  };
+  packet->pts = toTitle(m_pkt.pkt.pts);
+  packet->dts = toTitle(m_pkt.pkt.dts);
+}
+#endif
+
 DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
 {
   DemuxPacket* pPacket = NULL;
@@ -1953,6 +2024,10 @@ DemuxPacket* CDVDDemuxFFmpeg::ReadInternal(bool keep)
               ConvertTimestamp(m_pkt.pkt.pts, stream->time_base.den, stream->time_base.num);
           pPacket->dts =
               ConvertTimestamp(m_pkt.pkt.dts, stream->time_base.den, stream->time_base.num);
+#ifdef HAVE_LIBBLURAY
+          if (m_blurayTitleInput)
+            ConvertBlurayTimestamps(pPacket, stream);
+#endif
           pPacket->duration = DVD_SEC_TO_TIME((double)m_pkt.pkt.duration * stream->time_base.num /
                                               stream->time_base.den);
 
