+                  m_clip->in_time / 90000.0, before.out_time / 90000.0,
+                  (static_cast<double>(m_clip->in_time) - static_cast<double>(before.out_time)) /
+                      90000.0);
+      }
+      BeginClipSpan(false);
     }
+    else if (!m_navmode)
+      m_clipSpans.Begin(m_readPos, std::nullopt);
     break;
 
   case BD_EVENT_CHAPTER:
@@ -859,12 +880,38 @@ int CDVDInputStreamBluray::Read(uint8_t* buf, int buf_size)
   else
   {
     result = bd_read(m_bd, buf, buf_size);
+    // (the play item that libbluray opened in this read is told here: the bytes of the read are
+    // the first of it, libbluray ends a read at the end of a clip)
     while (bd_get_event(m_bd, &m_event))
       ProcessEvent();
+    if (result > 0)
+      m_readPos += static_cast<uint64_t>(result);
   }
   return result;
 }
 
+void CDVDInputStreamBluray::BeginClipSpan(bool restart)
+{
+  if (m_navmode)
+    return;
+
+  std::optional<KODI::BLURAYTIMELINE::ClipTime> time;
+  if (m_clip)
+    time = KODI::BLURAYTIMELINE::ClipTime{m_clip->in_time, m_clip->start_time};
+  if (restart)
+    m_clipSpans.Restart(m_readPos, time);
+  else
+    m_clipSpans.Begin(m_readPos, time);
+}
+
+std::optional<KODI::BLURAYTIMELINE::ClipTime> CDVDInputStreamBluray::GetClipTime(
+    uint64_t readPos) const
+{
+  if (m_navmode)
+    return {};
+  return m_clipSpans.At(readPos);
+}
+
 int CDVDInputStreamBluray::ReadBlocks(uint8_t* buf, int lba, int num_blocks)
 {
   CDVDInputStreamFile* lpstream = m_pstream.get();
@@ -1181,6 +1228,7 @@ bool CDVDInputStreamBluray::PosTime(int ms)
 
   while (bd_get_event(m_bd, &m_event))
     ProcessEvent();
