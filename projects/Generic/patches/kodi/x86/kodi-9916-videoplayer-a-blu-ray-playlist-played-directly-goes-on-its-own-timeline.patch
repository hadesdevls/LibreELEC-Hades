new file mode 100644
index 0000000..a5ad4f1
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/BlurayTitleTime.h
@@ -0,0 +1,111 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: the timeline of a Blu-ray playlist played directly (not from the disc's menus).
+//
+// libbluray hands the player the clips of a playlist one after the other as one transport
+// stream. Each clip keeps its own timestamps: a play item runs from its IN time to its OUT time
+// on the clock of its clip, and the next one starts again at its own IN time. A seamless join
+// (connection_condition 5 or 6) is a cut that plays on without a pause, but the two clips are
+// timed independently, so the timestamps step there: a fraction of a second forwards (dead time
+// played as content: the picture freezes, passthrough audio is paused) or backwards (an overlap:
+// pictures dropped, audio skipped), and the player's continuity check leaves a step under a second
+// alone. A reference player presents the playlist on its own timeline instead, where each play
+// item starts at the end of the one before (BLURAY_CLIP_INFO::start_time). Here every packet is
+// put on that timeline from the play item its bytes were read in: its distance from the IN time
+// of that play item, plus where the play item starts in the title.
+//
+// Design after matthane's for CoreELEC (the clip of each read byte, packets on title time).
+// Pure, for the tests.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <optional>
+#include <vector>
+
+namespace KODI::BLURAYTIMELINE
+{
+
+//! A play item as libbluray describes it, 90 kHz: the IN time on the clock of its clip, and where
+//! it starts in the title
+struct ClipTime
+{
+  uint64_t inTime{0};
+  uint64_t startTime{0};
+
+  bool operator==(const ClipTime&) const = default;
+};
+
+//! Where the bytes of each play item begin in what the input stream has returned since it opened
+class CClipSpans
+{
+public:
+  //! The bytes from readPos on are of the play item that libbluray just opened; without its
+  //! times (no title information), they have none
+  void Begin(uint64_t readPos, std::optional<ClipTime> time)
+  {
+    // a play item opened again where nothing was read of the one before replaces it
+    while (!m_spans.empty() && m_spans.back().readPos >= readPos)
+      m_spans.pop_back();
+    if (!m_spans.empty() && m_spans.back().time == time)
+      return;
+    if (m_spans.size() == MAX_SPANS)
+      m_spans.erase(m_spans.begin());
+    m_spans.push_back({readPos, time});
+  }
+
+  //! After a seek: what was read before it is not asked for again (the demuxer is flushed)
+  void Restart(uint64_t readPos, std::optional<ClipTime> time)
+  {
+    m_spans.clear();
+    m_spans.push_back({readPos, time});
+  }
+
+  void Clear() { m_spans.clear(); }
+
+  //! The play item of the byte at readPos, or nothing (before the first, or without its times)
+  std::optional<ClipTime> At(uint64_t readPos) const
+  {
+    const auto it =
+        std::upper_bound(m_spans.begin(), m_spans.end(), readPos,
+                         [](uint64_t pos, const Span& span) { return pos < span.readPos; });
+    if (it == m_spans.begin())
+      return {};
+    return std::prev(it)->time;
+  }
+
+  size_t Count() const { return m_spans.size(); }
+
+private:
+  struct Span
+  {
+    uint64_t readPos{0};
+    std::optional<ClipTime> time;
+  };
+  //! more than the play items of any playlist (999)
+  static constexpr size_t MAX_SPANS = 1024;
+  std::vector<Span> m_spans;
+};
+
+//! A timestamp of a packet of a play item, on the title's timeline: its distance from the IN time
+//! on the clock of the clip, which wraps at 2^wrapBits (33 for MPEG), plus where the play item
+//! starts in the title. All three in the same time base.
+inline int64_t TitleTimestamp(int64_t timestamp, int64_t inTime, int64_t startTime, int wrapBits)
+{
+  const int64_t wrap = INT64_C(1) << wrapBits;
+  int64_t clipTime = (timestamp - inTime) & (wrap - 1);
+  if (clipTime >= wrap / 2)
+    clipTime -= wrap;
+  return clipTime + startTime;
+}
+
+} // namespace KODI::BLURAYTIMELINE
