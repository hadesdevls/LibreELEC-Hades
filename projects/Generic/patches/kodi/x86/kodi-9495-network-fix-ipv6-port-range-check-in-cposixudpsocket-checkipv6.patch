From 93df9be2e1d475a81ab3cd2ff1c0a78bd0361db7 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:04 +0000
Subject: [PATCH] [network] Fix IPv6 port range check in
 CPosixUDPSocket::CheckIPv6

CodeQL cpp/signed-overflow-check: the loop compared port against
port + range after incrementing port, so the condition was always true
and the loop only stopped once a bind succeeded, probing ports far
outside the requested range. Compute the last port once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/network/Socket.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/network/Socket.cpp b/xbmc/network/Socket.cpp
index 4b7ea5b..6734418 100644
--- a/xbmc/network/Socket.cpp
+++ b/xbmc/network/Socket.cpp
@@ -161,7 +161,7 @@ bool CPosixUDPSocket::CheckIPv6(int port, int range)
   }
 
   // Try to bind a socket to validate ipv6 status
-  for (; port <= port + range; port++)
+  for (const int lastPort = port + range; port <= lastPort; port++)
   {
     testaddr.saddr.saddr6.sin6_port = htons(port);
     if (bind(static_cast<SOCKET>(testSocket), reinterpret_cast<struct sockaddr*>(&testaddr.saddr),
-- 
2.53.0

