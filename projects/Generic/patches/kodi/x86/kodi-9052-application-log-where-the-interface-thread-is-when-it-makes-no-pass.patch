+#pragma once
+
+#include "threads/Thread.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+/*!
+ * \brief Hades diagnostics: where the thread of the interface is while it makes no pass
+ *
+ * CApplication logs how long the interface went without a frame, once it has one again. That says
+ * how long, not what the thread was doing: a first opening of an add-on that froze the interface
+ * for 30.9 s (2026-10-03) left one line and no cause.
+ *
+ * This thread watches the time of the last pass. After five seconds without one, and once more
+ * after fifteen, it writes to the log what the thread of the interface waits in (the system call
+ * and, where it has one, the file or socket) and the return addresses on its stack, as
+ * file+address, with the names of the functions that the files export.
+ *
+ * The watched thread is only looked at, and nothing is asked of the dynamic loader while it is:
+ * - the kernel says where the thread waits (/proc/self/task/<tid>/syscall);
+ * - its stack is read as memory, through the kernel (process_vm_readv(), which cannot fault);
+ * - what is mapped where comes from /proc/self/maps, and the names from the files on disk.
+ * It gets no signal, so no call of it is interrupted (a signal would end a poll() or a sleep with
+ * EINTR even when the call is to be restarted, and libraries that take that for an error would
+ * fail where they only were slow).
+ *
+ * The price: the addresses are found by their look (a word that points behind a call
+ * instruction), so calls that already returned can be among them; a thread that is running
+ * instead of waiting shows no stack; and a function that its file does not export has no name
+ * (of the program, which is linked stripped, only the exported functions have one).
+ * Nothing happens while the loop runs.
+ */
+class CGUIStallWatch : private CThread
+{
+public:
+  CGUIStallWatch();
+  ~CGUIStallWatch() override;
+
+  //! \brief Start watching the calling thread, which is the one that makes the passes
+  void Start();
+  void Stop();
+  //! \brief A pass of the interface loop starts or ends
+  void Mark() { m_mark.store(Now(), std::memory_order_relaxed); }
+
+private:
+  void Process() override;
+  void Report(int64_t stalledMs);
+  static int64_t Now()
+  {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+
+  std::atomic<int64_t> m_mark{0};
+  bool m_started = false;
+};
