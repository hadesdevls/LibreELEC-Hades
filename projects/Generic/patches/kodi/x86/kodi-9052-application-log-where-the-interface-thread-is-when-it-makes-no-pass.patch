+using namespace std::chrono_literals;
+
+namespace
+{
+constexpr int64_t FIRST_MS = 5000; //!< a stall is reported after this long without a pass ...
+constexpr int64_t SECOND_MS = 15000; //!< ... and once more when it is still the same one
+constexpr unsigned int MAX_REPORTS = 12; //!< within HOUR_MS
+constexpr int64_t HOUR_MS = 3600 * 1000;
+
+#ifdef HAS_STALL_TRACE
+constexpr size_t SHOWN_FRAMES = 64; //!< return addresses of a report
+constexpr uintptr_t SCAN_BYTES = 256 * 1024; //!< of the stack, from where the thread is
+constexpr int LOOKS = 40; //!< at a thread that is running, to find it waiting ...
+constexpr auto BETWEEN_LOOKS = 5ms; //!< ... this far apart
+constexpr uint64_t TABLE_BYTES = 64 * 1024 * 1024; //!< the largest table of names read from a file
+
+// the watched thread
+int s_tid = 0;
+pthread_t s_thread;
+uintptr_t s_stackStart = 0;
+uintptr_t s_stackEnd = 0;
+// the file this code is in (the program), and what to take from an address in it to get the
+// address in the file: 0 for a program that is not position independent
+std::string s_ownPath;
+uintptr_t s_ownBias = 0;
+
+struct ThreadState
+{
+  enum class Kind
+  {
+    UNKNOWN, //!< the kernel did not say
+    RUNNING, //!< it runs, or is ready to
+    WAITING, //!< it waits, in a system call or outside of one
+  };
+  Kind kind = Kind::UNKNOWN;
+  long call = -1; //!< number of the system call, -1 when it waits outside of one
+  unsigned long long argument = 0; //!< its first argument
+  uintptr_t sp = 0;
+  uintptr_t pc = 0;
+};
+
+// "running", or "-1 sp pc", or "number six-arguments sp pc" (all but the number in hex)
+ThreadState ReadState()
+{
+  ThreadState state;
+  char path[64];
+  std::snprintf(path, sizeof(path), "/proc/self/task/%d/syscall", s_tid);
+  const int fd = open(path, O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return state;
+
+  char text[256] = {};
+  const ssize_t size = read(fd, text, sizeof(text) - 1);
+  close(fd);
+  if (size <= 0)
+    return state;
+
+  if (std::strncmp(text, "running", 7) == 0)
+  {
+    state.kind = ThreadState::Kind::RUNNING;
+    return state;
+  }
+
+  long call = 0;
+  unsigned long long v[8] = {};
+  const int fields = std::sscanf(text, "%ld %llx %llx %llx %llx %llx %llx %llx %llx", &call, &v[0],
+                                 &v[1], &v[2], &v[3], &v[4], &v[5], &v[6], &v[7]);
+  if (call < 0 && fields >= 3)
+  {
+    state.sp = static_cast<uintptr_t>(v[0]);
+    state.pc = static_cast<uintptr_t>(v[1]);
+  }
+  else if (call >= 0 && fields == 9)
+  {
+    state.call = call;
+    state.argument = v[0];
+    state.sp = static_cast<uintptr_t>(v[6]);
+    state.pc = static_cast<uintptr_t>(v[7]);
+  }
+  else
+    return state;
+
+  state.kind = ThreadState::Kind::WAITING;
+  return state;
+}
+
+struct Call
+{
+  long number;
+  const char* name;
+  bool file; //!< the first argument is a file descriptor (or a directory one)
+};
+
+// the system calls of x86-64 that a thread is found waiting in
+constexpr Call CALLS[] = {
+    {0, "read", true},           {1, "write", true},         {2, "open", false},
+    {3, "close", true},          {4, "stat", false},         {5, "fstat", true},
+    {6, "lstat", false},         {7, "poll", false},         {8, "lseek", true},
+    {9, "mmap", false},          {11, "munmap", false},      {16, "ioctl", true},
+    {17, "pread64", true},       {18, "pwrite64", true},     {19, "readv", true},
+    {20, "writev", true},        {21, "access", false},      {23, "select", false},
+    {26, "msync", false},        {28, "madvise", false},     {35, "nanosleep", false},
+    {40, "sendfile", true},      {42, "connect", true},      {43, "accept", true},
+    {44, "sendto", true},        {45, "recvfrom", true},     {46, "sendmsg", true},
+    {47, "recvmsg", true},       {61, "wait4", false},       {72, "fcntl", true},
+    {73, "flock", true},         {74, "fsync", true},        {75, "fdatasync", true},
+    {76, "truncate", false},     {77, "ftruncate", true},    {78, "getdents", true},
+    {82, "rename", false},       {83, "mkdir", false},       {84, "rmdir", false},
+    {87, "unlink", false},       {89, "readlink", false},    {137, "statfs", false},
+    {138, "fstatfs", true},      {162, "sync", false},       {202, "futex", false},
+    {217, "getdents64", true},
+    {219, "restart_syscall (a call that was interrupted and goes on)", false},
+    {230, "clock_nanosleep", false},
+    {232, "epoll_wait", true},   {247, "waitid", false},     {257, "openat", true},
+    {258, "mkdirat", true},      {262, "newfstatat", true},  {263, "unlinkat", true},
+    {264, "renameat", true},     {267, "readlinkat", true},  {269, "faccessat", true},
+    {270, "pselect6", false},    {271, "ppoll", false},      {277, "sync_file_range", true},
+    {281, "epoll_pwait", true},  {285, "fallocate", true},   {288, "accept4", true},
+    {299, "recvmmsg", true},     {306, "syncfs", true},      {307, "sendmmsg", true},
+    {316, "renameat2", true},    {326, "copy_file_range", true},
+    {332, "statx", true},        {426, "io_uring_enter", true},
+    {441, "epoll_pwait2", true}, {449, "futex_waitv", false},
+};
+
+// "read on /storage/x", "futex", "system call 999"
+std::string DescribeCall(const ThreadState& state)
+{
+  for (const Call& call : CALLS)
+  {
+    if (call.number != state.call)
+      continue;
+
+    std::string text = call.name;
+    // not for the "current directory" of the calls that take a directory
+    if (call.file && state.argument < 0x7fffffffULL)
+    {
+      char path[64];
+      char target[256];
+      std::snprintf(path, sizeof(path), "/proc/self/fd/%llu", state.argument);
+      const ssize_t size = readlink(path, target, sizeof(target) - 1);
+      if (size > 0)
+        text += " on " + std::string(target, static_cast<size_t>(size));
+    }
+    return text;
+  }
+  return "system call " + std::to_string(state.call);
+}
+
+std::string Hex(uintptr_t value)
+{
+  char text[2 + 2 * sizeof(value) + 1];
+  std::snprintf(text, sizeof(text), "%#lx", static_cast<unsigned long>(value));
+  return text;
+}
+
+struct Mapping
+{
+  uintptr_t start;
+  uintptr_t end;
+  bool code; //!< can be read and executed
+  std::string path; //!< of a file, else empty
+};
+
+// What is mapped where, read once for a report. Nothing here asks the dynamic loader, whose
+// records another thread may free at any moment by unloading a library.
+class CMaps
+{
+public:
+  CMaps()
+  {
+    FILE* maps = std::fopen("/proc/self/maps", "re");
+    if (!maps)
+      return;
+
+    char* line = nullptr;
+    size_t capacity = 0;
+    while (getline(&line, &capacity, maps) > 0)
+    {
+      unsigned long start = 0;
+      unsigned long end = 0;
+      char perms[5] = {};
+      int name = 0;
+      if (std::sscanf(line, "%lx-%lx %4s %*s %*s %*s %n", &start, &end, perms, &name) < 3 ||
+          start >= end)
+        continue;
+
+      Mapping mapping{start, end, perms[0] == 'r' && perms[2] == 'x', {}};
+      if (name > 0 && line[name] == '/')
+      {
+        mapping.path = line + name;
+        while (!mapping.path.empty() && mapping.path.back() == '\n')
+          mapping.path.pop_back();
+      }
+      m_mappings.push_back(std::move(mapping));
+    }
+    std::free(line);
+    std::fclose(maps);
+  }
+
+  const Mapping* Find(uintptr_t address) const
+  {
+    const auto mapping = std::upper_bound(m_mappings.begin(), m_mappings.end(), address,
+                                          [](uintptr_t a, const Mapping& m) { return a < m.end; });
+    return mapping != m_mappings.end() && address >= mapping->start ? &*mapping : nullptr;
+  }
+
+  // Whether the address is in code that can be read, with at least before bytes of it in front
+  bool InCode(uintptr_t address, uintptr_t before) const
+  {
+    const Mapping* mapping = Find(address);
+    return mapping && mapping->code && address - mapping->start >= before;
+  }
+
+  // The address in its file, as addr2line takes it, and the file. For a shared object that is the
+  // distance from the lowest mapping of the file; for the program, see s_ownBias.
+  bool InFile(uintptr_t address, std::string& path, uintptr_t& offset) const
+  {
+    const Mapping* mapping = Find(address);
+    if (!mapping || mapping->path.empty())
+      return false;
+
+    path = mapping->path;
+    if (path == s_ownPath)
+    {
+      offset = address - s_ownBias;
+      return true;
+    }
+    uintptr_t base = mapping->start;
+    for (const Mapping& other : m_mappings)
+    {
+      if (other.path == path)
+      {
+        base = other.start; // the mappings are in the order of their addresses
+        break;
+      }
+    }
+    offset = address - base;
+    return true;
+  }
+
+private:
+  std::vector<Mapping> m_mappings;
+};
+
+// "libc.so.6+0x10e9af"
+std::string Module(const CMaps& maps, uintptr_t address)
+{
+  std::string path;
+  uintptr_t offset = 0;
+  if (!maps.InFile(address, path, offset))
+    return Hex(address);
+
+  if (const size_t slash = path.rfind('/'); slash != std::string::npos)
+    path.erase(0, slash + 1);
+  return path + "+" + Hex(offset);
+}
+
+// The functions that a file exports, read from the file on disk (its dynamic symbol table).
+class CNames
+{
+public:
+  explicit CNames(const std::string& path)
+  {
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+      return;
+    Load(fd);
+    close(fd);
+    std::sort(m_functions.begin(), m_functions.end(),
+              [](const Function& a, const Function& b) { return a.address < b.address; });
+  }
+
+  // "CGUIWindowManager::Process()+0x52", or nothing
+  std::string Find(uintptr_t offset) const
+  {
+    auto next = std::upper_bound(m_functions.begin(), m_functions.end(), offset,
+                                 [](uintptr_t o, const Function& f) { return o < f.address; });
+    if (next == m_functions.begin())
+      return {};
+
+    const Function& function = *--next;
+    if (offset - function.address >= std::max<uint64_t>(function.size, 1) ||
+        function.name >= m_text.size())
+      return {};
+
+    const char* mangled = m_text.c_str() + function.name;
+    int status = -1;
+    char* name = abi::__cxa_demangle(mangled, nullptr, nullptr, &status);
+    std::string text = status == 0 && name ? name : mangled;
+    std::free(name);
+    return text + "+" + Hex(offset - function.address);
+  }
+
+private:
+  struct Function
+  {
+    uint64_t address;
+    uint64_t size;
+    uint32_t name;
+  };
+
+  static bool ReadAt(int fd, uint64_t at, void* buffer, uint64_t size)
+  {
+    return size <= TABLE_BYTES &&
+           pread(fd, buffer, size, static_cast<off_t>(at)) == static_cast<ssize_t>(size);
+  }
+
+  void Load(int fd)
+  {
+    Elf64_Ehdr header;
+    if (!ReadAt(fd, 0, &header, sizeof(header)) ||
+        std::memcmp(header.e_ident, ELFMAG, SELFMAG) != 0 ||
+        header.e_ident[EI_CLASS] != ELFCLASS64 || header.e_ident[EI_DATA] != ELFDATA2LSB ||
+        header.e_shentsize != sizeof(Elf64_Shdr) || header.e_shnum == 0)
+      return;
+
+    std::vector<Elf64_Shdr> sections(header.e_shnum);
+    if (!ReadAt(fd, header.e_shoff, sections.data(), sections.size() * sizeof(Elf64_Shdr)))
+      return;
+
+    for (const Elf64_Shdr& section : sections)
+    {
+      if (section.sh_type != SHT_DYNSYM || section.sh_entsize != sizeof(Elf64_Sym) ||
+          section.sh_link >= sections.size() || section.sh_size > TABLE_BYTES ||
+          sections[section.sh_link].sh_size > TABLE_BYTES)
+        continue;
+
+      std::vector<Elf64_Sym> symbols(section.sh_size / sizeof(Elf64_Sym));
+      std::string text(sections[section.sh_link].sh_size, '\0');
+      if (symbols.empty() || text.empty() ||
+          !ReadAt(fd, section.sh_offset, symbols.data(), symbols.size() * sizeof(Elf64_Sym)) ||
+          !ReadAt(fd, sections[section.sh_link].sh_offset, text.data(), text.size()))
+        return;
+
+      for (const Elf64_Sym& symbol : symbols)
+      {
+        const unsigned int type = ELF64_ST_TYPE(symbol.st_info);
+        if ((type == STT_FUNC || type == STT_GNU_IFUNC) && symbol.st_shndx != SHN_UNDEF &&
+            symbol.st_value != 0)
+          m_functions.push_back({symbol.st_value, symbol.st_size, symbol.st_name});
+      }
+      m_text = std::move(text);
+      return;
+    }
+  }
+
+  std::vector<Function> m_functions;
+  std::string m_text; //!< the names, each ended by a zero; c_str() ends the last one
+};
+
+// "poll+0x4f" for an address in a function that its file exports. Reads the file the first time.
+std::string Symbol(const CMaps& maps, uintptr_t address)
+{
+  static std::map<std::string, CNames> files; // only the watching thread comes here
+
+  std::string path;
+  uintptr_t offset = 0;
+  if (!maps.InFile(address, path, offset))
+    return {};
+
+  auto names = files.find(path);
+  if (names == files.end())
+    names = files.emplace(path, CNames(path)).first;
+  return names->second.Find(offset);
+}
+
+// Memory of this process, read through the kernel: what is not mapped (a library that another
+// thread unloads just now, a stack pointer that is none) ends the reading instead of faulting.
+// The bytes read, from the start.
+size_t ReadMemory(uintptr_t address, void* buffer, size_t size)
+{
+  constexpr size_t STEP = 64 * 1024;
+  size_t done = 0;
+  while (done < size)
+  {
+    const size_t step = std::min(STEP, size - done);
+    iovec local{static_cast<uint8_t*>(buffer) + done, step};
+    iovec remote{reinterpret_cast<void*>(address + done), step};
+    if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) != static_cast<ssize_t>(step))
+      break;
+    done += step;
+  }
+  return done;
+}
+
+// Whether a word of the stack is a return address: it points into code, behind a call instruction
+// (e8 with a 32 bit offset, or ff /2 in its lengths of two to seven bytes).
+bool BehindCall(uintptr_t value, const CMaps& maps)
+{
+  uint8_t code[7]; // the bytes before the address: code[7 - n] is n bytes before it
+  if (value < sizeof(code) || !maps.InCode(value - 1, sizeof(code) - 1) ||
+      ReadMemory(value - sizeof(code), code, sizeof(code)) != sizeof(code))
+    return false;
+
+  const auto indirect = [&code](int n)
+  { return code[7 - n] == 0xff && (code[8 - n] & 0x38) == 0x10; };
+  return code[7 - 5] == 0xe8 || indirect(2) || indirect(3) || indirect(4) || indirect(6) ||
+         indirect(7);
+}
+
+// The stack of the watched thread, from where the thread is towards its start. While the thread
+// waits, nothing changes it; when it goes on in the middle of the reading, what is read is no
+// longer one stack, and addresses of calls that never were together can be among the result.
+std::vector<uintptr_t> ReturnAddresses(uintptr_t sp, const CMaps& maps)
+{
+  std::vector<uintptr_t> found;
+  const uintptr_t first = (sp + 7) & ~uintptr_t{7};
+  if (sp < s_stackStart || first >= s_stackEnd)
+    return found;
+
+  std::vector<uintptr_t> words(std::min(s_stackEnd - first, SCAN_BYTES) / sizeof(uintptr_t));
+  const size_t read =
+      ReadMemory(first, words.data(), words.size() * sizeof(uintptr_t)) / sizeof(uintptr_t);
+  for (size_t i = 0; i < read && found.size() < SHOWN_FRAMES; ++i)
+  {
+    if (BehindCall(words[i], maps))
+      found.push_back(words[i]);
+  }
+  return found;
+}
+
+int64_t ProcessorTimeMs()
+{
+  clockid_t clock;
+  timespec time;
+  if (pthread_getcpuclockid(s_thread, &clock) != 0 || clock_gettime(clock, &time) != 0)
+    return -1;
+  return static_cast<int64_t>(time.tv_sec) * 1000 + time.tv_nsec / 1000000;
+}
+#endif
+} // unnamed namespace
+
+CGUIStallWatch::CGUIStallWatch() : CThread("GUIStallWatch")
+{
+}
+
+CGUIStallWatch::~CGUIStallWatch()
+{
+  Stop();
+}
+
+void CGUIStallWatch::Start()
+{
+  if (m_started)
+    return;
+
+#ifdef HAS_STALL_TRACE
+  pthread_attr_t attributes;
+  void* stack = nullptr;
+  size_t size = 0;
+  if (pthread_getattr_np(pthread_self(), &attributes) != 0)
+    return;
+  const bool known = pthread_attr_getstack(&attributes, &stack, &size) == 0 && stack && size;
+  pthread_attr_destroy(&attributes);
+  if (!known)
+    return;
+
+  s_stackStart = reinterpret_cast<uintptr_t>(stack);
+  s_stackEnd = s_stackStart + size;
+  s_thread = pthread_self();
+  s_tid = gettid();
+
+  // The file this code is in is never unloaded while it runs, so the loader can be asked about
+  // it, once and here.
+  const uintptr_t here = reinterpret_cast<uintptr_t>(&ProcessorTimeMs);
+  struct dl_find_object object;
+  if (_dl_find_object(reinterpret_cast<void*>(here), &object) == 0 && object.dlfo_link_map)
+  {
+    const CMaps maps;
+    if (const Mapping* mapping = maps.Find(here))
+    {
+      s_ownPath = mapping->path;
+      s_ownBias = object.dlfo_link_map->l_addr;
+    }
+  }
+
+  Mark();
+  m_started = true;
+  Create();
+#endif
+}
+
+void CGUIStallWatch::Stop()
+{
+  if (!m_started)
+    return;
+
+  m_started = false;
+  StopThread();
+}
+
+void CGUIStallWatch::Process()
+{
+  int64_t watched = 0;
+  unsigned int stage = 0;
+  // The log is not to be filled by a Kodi that stalls again and again: so many reports an hour.
+  unsigned int reports = 0;
+  int64_t hourStart = Now();
+  while (!m_bStop)
+  {
+    CThread::Sleep(250ms);
+
+    const int64_t mark = m_mark.load(std::memory_order_relaxed);
+    if (mark != watched)
+    {
+      watched = mark;
+      stage = 0;
+    }
+
+    const int64_t now = Now();
+    const int64_t stalled = now - mark;
+    if (!((stage == 0 && stalled >= FIRST_MS) || (stage == 1 && stalled >= SECOND_MS)))
+      continue;
+
+    stage++;
+    if (now - hourStart >= HOUR_MS)
+    {
+      hourStart = now;
+      reports = 0;
+    }
+    if (reports == MAX_REPORTS)
+      continue;
+
+    reports++;
+    Report(stalled);
+    if (reports == MAX_REPORTS)
+      CLog::Log(LOGINFO,
+                "GUI: that was report {} of a stalled interface loop within an hour; the next "
+                "one comes when the hour has passed",
+                reports);
+  }
+}
+
+void CGUIStallWatch::Report(int64_t stalledMs)
+{
+#ifdef HAS_STALL_TRACE
+  // A thread that runs has no place where it waits: look again for a moment.
+  const int64_t usedBefore = ProcessorTimeMs();
+  const int64_t lookedAt = Now();
+  ThreadState state = ReadState();
+  int looks = 1;
+  while (state.kind == ThreadState::Kind::RUNNING && looks < LOOKS && !m_bStop)
+  {
+    CThread::Sleep(BETWEEN_LOOKS);
+    state = ReadState();
+    ++looks;
+  }
+
+  // Kodi is stopping: its interface thread now waits for this one to end, which is no stall.
+  if (m_bStop)
+    return;
+
+  if (state.kind == ThreadState::Kind::UNKNOWN)
+  {
+    CLog::Log(LOGINFO,
+              "GUI: no pass of the interface loop for {} ms; the kernel does not say where its "
+              "thread is",
+              stalledMs);
+    return;
+  }
+
+  if (state.kind == ThreadState::Kind::RUNNING)
+  {
+    const int64_t usedAfter = ProcessorTimeMs();
+    CLog::Log(LOGINFO,
+              "GUI: no pass of the interface loop for {} ms; its thread is not waiting, it runs "
+              "(at each of {} looks; {} ms of processor time in the last {} ms). A stack is only "
+              "read from a thread that waits",
+              stalledMs, looks, usedBefore >= 0 && usedAfter >= 0 ? usedAfter - usedBefore : -1,
+              Now() - lookedAt);
+    return;
+  }
+
+  if (state.call >= 0)
+    CLog::Log(LOGINFO, "GUI: no pass of the interface loop for {} ms; its thread waits in {}",
+              stalledMs, DescribeCall(state));
+  else
+    CLog::Log(LOGINFO,
+              "GUI: no pass of the interface loop for {} ms; its thread is held outside of a "
+              "system call (memory that is being read in, for example)",
+              stalledMs);
+
+  const CMaps maps;
+  const std::vector<uintptr_t> addresses = ReturnAddresses(state.sp, maps);
+  if (addresses.empty())
+  {
+    CLog::Log(LOGINFO, "GUI:   no return address was found on its stack (it is at {})",
+              Module(maps, state.pc));
+    return;
+  }
+
+  // First the whole list as file+address, which reads no file: the names come from the files on
+  // disk, and the disk may be what the interface waits for.
+  std::string list;
+  for (const uintptr_t address : addresses)
+    list += " " + Module(maps, address - 1);
+  CLog::Log(LOGINFO,
+            "GUI:   it is at {}; return addresses on its stack, innermost first (calls that "
+            "already returned can be among them):{}",
+            Module(maps, state.pc), list);
+
+  for (size_t i = 0; i < addresses.size() && !m_bStop; ++i)
+  {
+    // the address of the call, not of what follows it: that may be the next function
+    const std::string symbol = Symbol(maps, addresses[i] - 1);
+    if (!symbol.empty())
+      CLog::Log(LOGINFO, "GUI:   #{} {} ({})", i, symbol, Module(maps, addresses[i] - 1));
+  }
+#else
+  (void)stalledMs;
+#endif
+}
