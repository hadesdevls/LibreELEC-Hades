From a76c47f732bb66adb5c731fb22ab18c241f2289a Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 19:16:42 +0000
Subject: [PATCH] [Video] Keep the assets a movie gained after it was listed in
 its refresh.

A refresh moves a movie's other versions and extras to it once it is
added again, but only if the item refreshed says it has them. An item
read before a scan added extras to the movie, as by an information
dialog left open, doesn't, so its refresh left them attached to a
movie that no longer existed.

Whether the movie has other assets is now read from the database when
it is refreshed. A refresh of a source reads each movie again before
refreshing it, so it already knew.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index 2e8888b..95db313 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -588,8 +588,16 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     SetText(itemTitle);
     SetProgress(0);
 
-    const bool hasAdditionalAssets{m_item->HasVideoVersions() || m_item->HasVideoExtras()};
     const int origDbId{m_item->GetVideoInfoTag()->m_iDbId};
+    // Read from the database, as a scan may have added versions or extras to the movie since the
+    // item was read, such as while its information dialog was open. The movie's own file is one
+    // of its assets.
+    const bool hasAdditionalAssets{
+        m_item->HasVideoVersions() || m_item->HasVideoExtras() ||
+        (origDbId > 0 && scraper->Content() == ADDON::ContentType::MOVIES &&
+         db.GetSingleValueInt(db.PrepareSQL(
+             "SELECT COUNT(1) FROM videoversion WHERE idMedia = %i AND media_type = '%s'", origDbId,
+             MediaTypeMovie)) > 1)};
 
     // the disc's watched state, carried over if a single playlist is found on it again
     CVideoDatabase::FileRecord discFileState;
