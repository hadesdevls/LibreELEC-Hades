From e5b08b3f750abc24b502752e0500a9159625318b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 16:38:48 +0000
Subject: [PATCH] windowing/gbm: a refused HDR10+ InfoFrame says whose refusal
 it was

When the driver does not take HDR10PLUS_VSIF, the log said only that it
did not take the dynamic metadata in 8 commits. On an RTX 4080 SUPER by
HDMI to a display that declares HDR10+ and HDMI VRR, NVKMS refused the
test of each request with it, CDRMAtomic tested the request again without
it, and that was said only at debug level.

Now CDRMAtomic keeps the error of a test refused while the request carried
an HDR10+ InfoFrame (TakeHDR10PlusTestError()), CHDR10PlusOutput keeps it
for the video (TestFailed(), TestError(); a new video forgets it), and the
warning says that the driver refused the metadata in the test of the
commits, with its error, and that its reason, where it gives one, is in
the kernel log (nvidia-open-kernel-modules-9020 and linux-9982 give it);
or, where no test was refused, that the driver took the commits without
keeping the metadata of any. What goes out does not change.

A host test runs CHDR10PlusOutput with a driver that refuses the tests and
one that takes the commits and keeps nothing: 8 checks, two of which fail
without the change, and three mutations of HDR10PlusOutput.h are caught.
---
 xbmc/windowing/gbm/HDR10PlusOutput.h | 19 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp  | 21 ++++++++++++++++++---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp |  4 +++-
 xbmc/windowing/gbm/drm/DRMAtomic.h   |  5 +++++
 4 files changed, 44 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index 22eb541..e0cbc77 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -45,7 +45,9 @@ namespace GBM
  * (CDRMAtomic), so what the kernel keeps for HDR10PLUS_VSIF (the values that accepted commits
  * set: CDRMObject::GetPropertyValue()) is never one that was queued. After REFUSED_AFTER commits
  * like that HDR10+ stops for the video, and the output is HDR10. A new video tries again
- * (NewVideo()).
+ * (NewVideo()). Where the driver refused the test of a request with a payload, its error is kept
+ * (TestFailed()) for the log to say so: the driver says why in the kernel log (the Hades patches
+ * of NVIDIA: "Hades: HDR10+ refused on head N: ...").
  *
  * A payload is never queued in a request that changes the HDR signalling or the mode (Output::alone),
  * and a test that fails with one is made again without it (Without()), so that a refusal takes
@@ -133,6 +135,19 @@ public:
     return true;
   }
 
+  //! The test of a request that carried a payload of this video failed with error (an errno), and
+  //! the request was tested again without it (CDRMAtomic::TakeHDR10PlusTestError())
+  void TestFailed(int error)
+  {
+    if (error != 0)
+      m_testError = error;
+  }
+
+  //! The error of the last test of this video that the driver refused with a payload (0: none
+  //! was refused): a refusal with one is the driver's, in the test of the commit, and not a value
+  //! taken and then dropped
+  int TestError() const { return m_testError; }
+
   //! A new video, or the end of one: nothing is queued from here, and a driver that refused gets
   //! another try
   void NewVideo()
@@ -142,6 +157,7 @@ public:
     m_pending = false;
     m_unseen = 0;
     m_refused = false;
+    m_testError = 0;
   }
 
   bool Refused() const { return m_refused; }
@@ -169,6 +185,7 @@ private:
   bool m_pending = false;
   unsigned int m_unseen = 0;
   bool m_refused = false;
+  int m_testError = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 41086af..05d9783 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -2791,9 +2791,24 @@ void CWinSystemGbm::HDR10PlusCommitted()
   CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
   if (!connector || !connector->SupportsProperty(CHDR10PlusOutput::PROPERTY))
     return;
-  if (m_hdr10Plus.Committed(connector->GetPropertyValue(CHDR10PlusOutput::PROPERTY)))
-    CLog::Log(LOGWARNING, "HDR10+: the driver did not take the dynamic metadata in {} commits: the "
-                          "video goes on as HDR10",
+  // Hades: a test that the driver refused with the metadata in it (CDRMAtomic tested it again
+  // without), so that the log says it was the driver's refusal, and its error
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+  {
+    if (const auto error = drm->TakeHDR10PlusTestError())
+      m_hdr10Plus.TestFailed(*error);
+  }
+  if (!m_hdr10Plus.Committed(connector->GetPropertyValue(CHDR10PlusOutput::PROPERTY)))
+    return;
+  if (m_hdr10Plus.TestError() != 0)
+    CLog::Log(LOGWARNING,
+              "HDR10+: the driver refused the dynamic metadata in the test of {} commits ({}; "
+              "its reason, where it gives one, is in the kernel log): the video goes on as HDR10",
+              CHDR10PlusOutput::REFUSED_AFTER, strerror(m_hdr10Plus.TestError()));
+  else
+    CLog::Log(LOGWARNING,
+              "HDR10+: the driver took {} commits without keeping the dynamic metadata of any: the "
+              "video goes on as HDR10",
               CHDR10PlusOutput::REFUSED_AFTER);
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 31fa8a0..280b4ff 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -289,12 +289,14 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   // the request is tested again without it (CHDR10PlusOutput::Without())
   if (ret < 0 && !strict && m_connector)
   {
+    const int error = errno;
     const auto without =
         CHDR10PlusOutput::Without(m_req->Value(m_connector, CHDR10PlusOutput::PROPERTY));
     if (without && m_req->AddProperty(m_connector, CHDR10PlusOutput::PROPERTY, *without))
     {
+      m_hdr10PlusTestError = error;
       CLog::LogF(LOGDEBUG, "test commit failed: ({}) - testing it again without {}",
-                 strerror(errno), CHDR10PlusOutput::PROPERTY);
+                 strerror(error), CHDR10PlusOutput::PROPERTY);
       ret = drmModeAtomicCommit(m_fd, m_req->Get(), flags | DRM_MODE_ATOMIC_TEST_ONLY, nullptr);
     }
   }
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 14aaed2..e75e8a6 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -75,6 +75,10 @@ public:
   //! Hades: the last commit did not go out as it was asked: the driver refused it, or its test
   //! (the frame then went out with the request before it), or there was no framebuffer
   bool LastCommitRefused() const { return m_lastCommitRefused; }
+  //! Hades: the error (an errno) of the last test that the driver refused while the request
+  //! carried an HDR10+ InfoFrame, which was then tested again without it; nothing since it was
+  //! asked last
+  std::optional<int> TakeHDR10PlusTestError() { return std::exchange(m_hdr10PlusTestError, {}); }
   //! Hades: which request what is added now goes in: one more each time a request is finished
   //! (it went out, or the driver refused it or its test and it was dropped). A change that was
   //! added to the request of an earlier generation has gone out, or not, by now.
@@ -148,6 +152,7 @@ private:
   bool m_flipRefused = false;
   bool m_flipDropped = false; //!< see TakeFlipDropped(); kept until it is asked
   bool m_lastCommitRefused = false; //!< Hades: see LastCommitRefused()
+  std::optional<int> m_hdr10PlusTestError; //!< Hades: see TakeHDR10PlusTestError()
   uint64_t m_requestGeneration = 0; //!< Hades: see RequestGeneration()
   //! Hades: a copy of the last request whose test was refused and told (TakeFlipRefused()), and
   //! the flags of its commit, for RefusedForBuffer()
-- 
2.53.0

