From a9c09a117711ebdf06826fb36d2bd1a9d54998d3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:56:49 +0000
Subject: [PATCH] DVDDemuxFFmpeg: two whole video tracks grouped as Dolby
 Vision are not told as a lone base layer

When the container groups two HEVC tracks as the two layers of Dolby Vision profile 7 and the
second one has not the size of an enhancement layer for the first (CDVLayerMerge::Find(),
Layers::Result::WRONG_SIZE), kodi.log said "not joined, the base layer plays alone". A file with
the same picture twice, a Dolby Vision video stream of profile 7 in one track and an HDR10+ one
at 3840x2160, is grouped so by its Dolby Vision record in Matroska: the line spoke of a base layer
and an enhancement layer that were two whole pictures, each a video stream of its own.

The line now comes from CDVLayerMerge::WrongSizeReason(): two tracks of the same size (above
1920x1080, as a pair of that size is joined) are told as two whole pictures, and other sizes with
both sizes; in both cases each plays as a video stream of its own. What is joined, and what plays,
is as it was.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 13 +++++---
 .../VideoPlayer/DVDDemuxers/DVLayerMerge.h    | 31 +++++++++++++++++++
 2 files changed, 39 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 510cf26..7bd5607 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1300,11 +1300,14 @@ void CDVDDemuxFFmpeg::FindDVLayers()
               layers.base, layers.enhancement, layers.baseLengthSize,
               layers.enhancementLengthSize);
   else if (layers.result == Result::WRONG_SIZE)
-    CLog::Log(LOGINFO,
-              "CDVDDemuxFFmpeg: the second HEVC track of this stream (stream {}) does not have "
-              "the size of a Dolby Vision enhancement layer for the base layer of stream {}: "
-              "not joined, the base layer plays alone",
-              layers.enhancement, layers.base);
+  {
+    // (Hades: two tracks of the same size are two whole pictures: CDVLayerMerge::WrongSizeReason())
+    const AVCodecParameters* b = m_pFormatContext->streams[layers.base]->codecpar;
+    const AVCodecParameters* e = m_pFormatContext->streams[layers.enhancement]->codecpar;
+    CLog::Log(LOGINFO, "{}",
+              CDVLayerMerge::WrongSizeReason(layers.base, layers.enhancement, b->width, b->height,
+                                             e->width, e->height));
+  }
   else if (layers.result == Result::NONE)
     LogDVNotJoined(layers.reason);
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index ed77409..6dc3394 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -12,6 +12,7 @@
 #include <cstdint>
 #include <deque>
 #include <functional>
+#include <string>
 #include <vector>
 
 extern "C"
@@ -152,6 +153,36 @@ public:
    */
   static Layers Find(AVFormatContext* context, unsigned int program);
 
+  /*!
+   * \brief Hades: the line of the log for a pair of tracks whose second one has not the size of an
+   *        enhancement layer for the first (Layers::Result::WRONG_SIZE)
+   * \param base, enhancement the stream indexes of the pair as the container groups it
+   *
+   * The line said "the base layer plays alone" in every case. Two tracks of the same size (above
+   * 1920x1080: a pair of that size is joined) are two whole pictures, such as a file with a Dolby
+   * Vision video stream and an HDR10 or HDR10+ one of the same picture: neither is a base layer
+   * nor an enhancement layer, and each plays as a video stream of its own, as do two tracks of
+   * other sizes.
+   */
+  static std::string WrongSizeReason(
+      int base, int enhancement, int baseWidth, int baseHeight, int width, int height)
+  {
+    const std::string first = std::to_string(base);
+    const std::string second = std::to_string(enhancement);
+    if (baseWidth == width && baseHeight == height)
+      return "CDVDDemuxFFmpeg: streams " + first + " and " + second +
+             " are two video tracks of the same size (" + std::to_string(width) + "x" +
+             std::to_string(height) +
+             ") that the container groups as Dolby Vision: two whole pictures, not a base layer "
+             "and its enhancement layer. Not joined: each plays as a video stream of its own";
+    return "CDVDDemuxFFmpeg: the second HEVC track of this stream (stream " + second + ", " +
+           std::to_string(width) + "x" + std::to_string(height) +
+           ") does not have the size of a Dolby Vision enhancement layer for the base layer of "
+           "stream " +
+           first + " (" + std::to_string(baseWidth) + "x" + std::to_string(baseHeight) +
+           "): not joined, each plays as a video stream of its own";
+  }
+
   /*!
    * \brief The record of a stream that no Dolby Vision record declares, from what an access unit
    *        of it says (dvbridge_rpu_probe_packet())
-- 
2.53.0

