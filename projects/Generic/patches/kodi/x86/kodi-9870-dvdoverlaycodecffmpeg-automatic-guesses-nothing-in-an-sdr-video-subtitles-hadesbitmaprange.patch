   Reason Why() const { return m_reason; }
-  //! the entry that told it (BRIGHT, DIM)
+  //! the entry that told it (BRIGHT)
   int Y() const { return m_y; }
   int Cb() const { return m_cb; }
   int Cr() const { return m_cr; }
@@ -165,7 +154,6 @@ public:
 private:
   bool Told(bool pq, Reason reason)
   {
-    m_told = true;
     m_pq = pq;
     m_reason = reason;
     return true;
@@ -173,7 +161,6 @@ private:
 
   bool m_pq{false};
   bool m_auto{true};
-  bool m_told{false};
   Reason m_reason{Reason::VIDEO};
   int m_y{0};
