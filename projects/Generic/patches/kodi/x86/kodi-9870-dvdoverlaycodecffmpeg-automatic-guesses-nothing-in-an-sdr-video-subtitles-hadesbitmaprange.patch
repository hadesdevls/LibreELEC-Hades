- * In Automatic (the setting subtitles.hadesbitmaprange), the stream starts as its video says, and
- * the palettes of its packets, read before they are decoded, tell it apart, once, for the rest of
- * the stream (so that every palette is decoded with the matrix of its range):
- * - made for SDR, in a PQ video: a palette entry, mostly opaque, with a Y' of SDR_Y or more (0.85
- *   of the range). As PQ that would be over 2000 cd/m2: no subtitle is made that bright. SDR text is
- *   white or yellow (Y' 219 and more).
- * - made for HDR, in an SDR video: the brightest entry that is mostly opaque is neutral (white or
- *   grey text, as every PGS of an Ultra HD Blu-ray is), with a Y' from HDR_Y_MIN to HDR_Y_MAX: about
- *   55 to 515 cd/m2 in PQ, where SDR text would be a dark to middle grey.
- * Coloured text, or text darker than that, says nothing, and the stream stays as its video.
- * The other choices fix it: as the video (Kodi's own way), SDR or HDR.
+ * In Automatic (the setting subtitles.hadesbitmaprange), the stream starts as its video says. In a
+ * PQ video the palettes of its packets, read before they are decoded, may tell it is made for SDR,
+ * once, for the rest of the stream (so that every palette is decoded with the matrix of its range):
+ * a palette entry, mostly opaque, with a Y' of SDR_Y or more (0.85 of the range). As PQ that would
+ * be over 2000 cd/m2, and no subtitle is made that bright; SDR text is white or yellow (Y' 219 and
+ * more). Nothing else is guessed: in an SDR video the stream stays as its video, as in Kodi (a PGS
+ * made for HDR there cannot be told for certain from an SDR one of grey text; it is set with the
+ * choice HDR). The other choices fix it: as the video (Kodi's own way), SDR or HDR.
  */
 class CPgsRange
 {
@@ -61,16 +57,11 @@ public:
   {
     VIDEO, //!< as the video (Automatic before its palettes told anything, or the choice)
     CHOICE, //!< the choice SDR or HDR
-    BRIGHT, //!< an entry brighter than any made for HDR: made for SDR
-    DIM, //!< neutral text at the light of HDR text, nothing brighter: made for HDR
+    BRIGHT, //!< in a PQ video, an entry brighter than any made for HDR: made for SDR
   };
 
-  //! Y' (limited range, 8 bits) of 0.85, 0.45 and 0.68 of the range (16 + 219 x)
+  //! Y' (limited range, 8 bits) of 0.85 of the range (16 + 219 x)
   static constexpr int SDR_Y = 202;
-  static constexpr int HDR_Y_MIN = 115;
-  static constexpr int HDR_Y_MAX = 165;
-  //! the most the Cb and Cr of a neutral entry may be away from 128
-  static constexpr int NEUTRAL = 6;
   //! an entry this opaque or more is text, not the soft edge of it (of 255)
   static constexpr int OPAQUE = 128;
 
@@ -102,11 +93,12 @@ public:
 
   /*!
    * \brief The entries of a palette definition segment (5 bytes each: id, Y', Cr, Cb, alpha).
-   * Returns true when they changed the range (in Automatic, once).
+   * Returns true when they changed the range (in Automatic and a PQ video; once, since a stream
+   * told SDR is PQ no more).
    */
   bool Palette(const uint8_t* entries, size_t size)
   {
-    if (!m_auto || m_told)
+    if (!m_auto || !m_pq)
       return false;
     int brightest = -1;
     size_t at = 0;
@@ -125,11 +117,8 @@ public:
     m_y = entries[at + 1];
     m_cr = entries[at + 2];
     m_cb = entries[at + 3];
-    if (m_pq && brightest >= SDR_Y)
+    if (brightest >= SDR_Y)
       return Told(false, Reason::BRIGHT);
-    if (!m_pq && brightest >= HDR_Y_MIN && brightest <= HDR_Y_MAX &&
-        std::abs(m_cb - 128) <= NEUTRAL && std::abs(m_cr - 128) <= NEUTRAL)
-      return Told(true, Reason::DIM);
     return false;
   }
 
@@ -140,7 +129,7 @@ public:
    */
   bool Packet(const uint8_t* data, size_t size)
   {
-    if (!m_auto || m_told || !data)
+    if (!data)
       return false;
