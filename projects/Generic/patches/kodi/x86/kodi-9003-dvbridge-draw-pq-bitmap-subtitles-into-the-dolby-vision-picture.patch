+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -58,6 +58,11 @@ public:
   static bool DVBridgeRequested(const VideoPicture* picture);
   bool BeginDVBridge();
   void SetDVBridgeOverlays(bool visible) { m_dvOverlays = visible; }
+  bool DVBridgeCaptured() const { return m_dvState.Captured(); }
+  //! Route the HDR overlays that Kodi draws right after the video into the Dolby Vision PQ
+  //! picture. Returns false (nothing changed) when there is no such picture this frame.
+  bool BeginDVBridgeHDROverlays();
+  void EndDVBridgeHDROverlays();
   bool RenderDVBridge(const CDVBridgeGLES::Layer& layer, const AVFrame* enhancement,
                        const CDVMetadataBuffer& metadata,
                        dvbridge_geometry geometry);
@@ -92,6 +97,9 @@ private:
   CDVBridgeState m_dvState;
   bool m_dvFrame = false;
   bool m_dvOverlays = true;
+  GLint m_dvOverlayFramebuffer = 0;
+  GLint m_dvOverlayViewport[4]{};
+  bool m_dvOverlayScissor = false;
   //! A Dolby Vision frame has reached the display since the output was last restored
   bool m_dvSignalling = false;
   bool DVBridgeBeginRejected(const char* stage);
