+#pragma once
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: the mode that Kodi's commits put on its CRTC, and whether the selected mode is that
+ *        one
+ *
+ * The selected mode (CDRMUtils::GetSelectedMode()) is the one that Kodi chose: a commit that allows
+ * a modeset carries it in MODE_ID. It is not always the one on the output. A commit of the ordinary
+ * output whose test the driver refuses falls back to the request before it (CDRMAtomic::
+ * DrmAtomicCommit()), which goes out without the new mode, and the modeset is not asked for again;
+ * and a modeset is pending between the choice of a mode and the commit that carries it. Native
+ * Dolby Vision where the link is brought up from scratch (NVIDIA_DUAL_MODE::LinkFromScratch())
+ * enters only in the mode on the output, never together with a change of it: it asks this.
+ *
+ * The mode is known from the commits that Kodi made: an accepted commit of the request that it
+ * assembled with a modeset carried the selected mode; one without a modeset, or the request before
+ * it that a refused test fell back to, left the mode as it was (that request carried the mode that
+ * was committed with it, or none). Kodi's first commit is a modeset. A suspend that resets the
+ * state of the kernel is followed by a modeset (CDRMAtomic::AllowModeset()), which is pending
+ * meanwhile.
+ *
+ * This class only decides. A template of the mode (drmModeModeInfo), so that a test builds it on
+ * the host without libdrm.
+ */
+template<typename Mode>
+class CCommittedMode
+{
+public:
+  //! A commit was accepted. carriedSelected: it was the request assembled with a modeset (MODE_ID
+  //! of the selected mode), not a fallback to the one before it; selected: the selected mode then.
+  void Accepted(bool carriedSelected, const Mode* selected)
+  {
+    if (!carriedSelected || !selected)
+      return;
+    m_mode = *selected;
+    m_known = true;
+  }
+
+  //! The selected mode is the one on the output: committed, and no modeset of it pending
+  bool Is(const Mode* selected, bool modesetPending) const
+  {
+    return m_known && selected && !modesetPending && SameTiming(m_mode, *selected);
+  }
+
+  static bool SameTiming(const Mode& a, const Mode& b)
+  {
+    return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsync_start == b.hsync_start &&
+           a.hsync_end == b.hsync_end && a.htotal == b.htotal && a.hskew == b.hskew &&
+           a.vdisplay == b.vdisplay && a.vsync_start == b.vsync_start &&
+           a.vsync_end == b.vsync_end && a.vtotal == b.vtotal && a.vscan == b.vscan &&
+           a.flags == b.flags;
+  }
+
+private:
+  Mode m_mode{};
+  bool m_known = false;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
