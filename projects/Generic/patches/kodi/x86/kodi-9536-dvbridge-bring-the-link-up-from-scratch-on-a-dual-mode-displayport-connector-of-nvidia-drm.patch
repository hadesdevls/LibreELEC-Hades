+  // Hades: the entry into native output where it brings the link up from scratch (nvidia-drm on a
+  // dual-mode DisplayPort connector that it drives as HDMI: NVIDIA_DUAL_MODE::LinkFromScratch(),
+  // issue #4). There the transport never goes out with a change of mode (the mode goes out alone
+  // first: CModeChangeHold::StartHolds(), CDVModeMove::Moves()): while the mode that it would go
+  // out in is not the one on the output (a modeset pending, or a change of mode that the driver
+  // refused and that fell back to the mode before it), nothing is committed and the frame is not
+  // shown, which ends native output for the video after two seconds of them (fail closed: the TV
+  // keeps the picture it has, and the video goes on in the ordinary output). In the mode on the
+  // output the transport enters with the head turned off and on, as it leaves: NVKMS brings the
+  // head and the link up from scratch with the Dolby InfoFrame from their first frame, instead of
+  // changing the InfoFrames and the depth of a running link. Once per capture: if turning it off
+  // or on is refused, the frames after it enter in place, as on an HDMI connector. The display
+  // being meant to be off (DPMS) keeps the entry in place, which keeps it off.
+  if (valid && !restore && !state.TransportLive() && state.CapturedLinkFromScratch() &&
+      drm->IsActive())
+  {
+    if (!drm->IsSelectedModeCommitted())
+    {
+      inPlace = false;
+      if (state.TakeEntryNotice())
+      {
+        const auto* mode = drm->GetSelectedMode();
+        CLog::Log(LOGWARNING,
+                  "DVBridge: native Dolby Vision waits: the mode {}x{} ({} kHz) that it would go "
+                  "out in is not the one on the output yet (a modeset pending, or one that the "
+                  "driver refused), and on connector {} the transport does not go out with a "
+                  "change of mode",
+                  mode ? mode->hdisplay : 0, mode ? mode->vdisplay : 0, mode ? mode->clock : 0,
+                  drm->GetConnector() ? drm->GetConnector()->GetName() : "none");
+      }
+    }
+    else if (state.TakeEntryRestart())
+    {
+      drm->SetActive(false);
+      const bool off = drm->FlipPageTransactional(stage(false) ? bo : nullptr, true);
+      drm->SetActive(true);
+      if (off)
+      {
+        // If turning it on is refused, the head stays off with the transport until a frame after it
+        // turns it on in place (the same commit) or native output ends (restored off and on)
+        inPlace = false;
+        accepted = drm->FlipPageTransactional(stage(false) ? bo : nullptr, true);
+        CLog::Log(accepted ? LOGINFO : LOGWARNING,
+                  "DVBridge: native Dolby Vision {} on connector {}, which brings its link up "
+                  "from scratch",
+                  accepted ? "entered with the output turned off and on again"
+                           : "could not turn the output on again with the transport",
+                  drm->GetConnector() ? drm->GetConnector()->GetName() : "none");
+      }
+      else
+        CLog::Log(LOGWARNING, "DVBridge: turning the output off to enter native Dolby Vision was "
+                              "refused; entering in place");
+    }
+  }
   if (!accepted && inPlace)
   {
     if (valid)
@@ -1894,9 +1949,20 @@ CModeChangeHold::Change CWinSystemGbm::ModeChangeOf(const RESOLUTION_INFO& res)
                       m_stereoRefusedInfoFrame;
   change.captured = NativeDVOutputInUse();
   change.timingChanges = OtherTiming(res);
+  change.linkFromScratch = DVLinkFromScratch();
   return change;
 }
 
+bool CWinSystemGbm::DVLinkFromScratch() const
+{
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || connector->GetType() != "DP" ||
+      !connector->SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+    return false;
+  return NVIDIA_DUAL_MODE::LinkFromScratch(
+      "DP", connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY));
+}
