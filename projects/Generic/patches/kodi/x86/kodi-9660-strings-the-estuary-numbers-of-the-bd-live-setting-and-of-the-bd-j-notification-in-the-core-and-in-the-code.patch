From 5f1fdfc80ce05b2c0111dd0fb44ce7a00a9562ad Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:20:09 +0000
Subject: [PATCH] strings: the Estuary numbers of the BD-Live setting and of
 the BD-J notification, in the core and in the code

The label and help of the BD-Live setting (#39886, #39887) are #32299 and #32300 of the skin's strings, and the
BD-J notification #32298; the code and the comments of the core's strings said #32289 to #32290 and #32288, the
numbers that the strings had before they were moved.
---
 addons/resource.language.en_gb/resources/strings.po | 6 +++---
 xbmc/settings/dialogs/GUIDialogSettingsBase.cpp     | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index e7539bb..e9180fa 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25816,19 +25816,19 @@ msgstr ""
 
 #empty string with id 39884
 
-#. Hades: Notification: the BD-J service was given the disc, and its menus did not start; translated in Estuary (#32288)
+#. Hades: Notification: the BD-J service was given the disc, and its menus did not start; translated in Estuary (#32298)
 #: xbmc/filesystem/BlurayJava.cpp
 msgctxt "#39885"
 msgid "The Java menus of this Blu-ray could not start in the BD-J service. kodi.log says what libbluray reported."
 msgstr ""
 
-#. Hades: label of setting "bluray.hadesbdlive"; translated in Estuary (#32289)
+#. Hades: label of setting "bluray.hadesbdlive"; translated in Estuary (#32299)
 #: system/settings/settings.xml
 msgctxt "#39886"
 msgid "BD-Live: Internet for disc menus"
 msgstr ""
 
-#. Hades: help of setting "bluray.hadesbdlive"; translated in Estuary (#32290)
+#. Hades: help of setting "bluray.hadesbdlive"; translated in Estuary (#32300)
 #: system/settings/settings.xml
 msgctxt "#39887"
 msgid "Lets the Java menus of a Blu-ray reach the Internet, as BD-Live discs do for trailers, extras or updates. Only addresses of the Internet over IPv4: never this system, your home network, other local addresses or IPv6, and names are resolved by Kodi. The menus run apart from Kodi in either case. Off: the disc has no network at all. kodi.log lists each connection allowed or refused."
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index bfcf8d8..5e3fde3 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -600,7 +600,7 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
     return CGUIUtils::GetHadesString(labelId, 31755 + (labelId - 39230));
   // BD-Live (Player > Discs, Blu-ray): label, help
   if (labelId == 39886 || labelId == 39887)
-    return CGUIUtils::GetHadesString(labelId, 32289 + (labelId - 39886));
+    return CGUIUtils::GetHadesString(labelId, 32299 + (labelId - 39886));
   // "Simulate a 3D display" (Player > Discs, Blu-ray): label, help
   if (labelId == 39892 || labelId == 39893)
     return CGUIUtils::GetHadesString(labelId, 32340 + (labelId - 39892));
-- 
2.53.0

