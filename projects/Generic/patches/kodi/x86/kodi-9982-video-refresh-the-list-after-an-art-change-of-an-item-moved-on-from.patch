From baafca0ba2a13ee5e4d1f04b3699c954a7d773f8 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Tue, 10 Nov 2026 20:58:51 +0100
Subject: [PATCH] [Video] Refresh the list after an art change of an item moved
 on from

The information dialog can move on to another item through the set list
or an actor search. An art change made before that was only kept as a
thumb change, and when the dialog ended up on the original movie again
only that movie got updated in the list, so the other item kept its old
art. Report it as a change of other items, which refreshes the list.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d473f643e46882d7501da920d0b8048329ab8f27)
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 4 ++--
 xbmc/video/dialogs/GUIDialogVideoInfo.h   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index db5ffcc..2fd1f04 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -238,7 +238,7 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
             Open();
             m_hasUpdatedThumb = m_hasUpdatedThumb || hasUpdatedThumb;
             m_hasUpdatedUserrating = m_hasUpdatedUserrating || hasUpdatedUserrating;
-            m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
+            m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems || hasUpdatedThumb;
           }
           else
             OnSearch(strItem);
@@ -760,7 +760,7 @@ void CGUIDialogVideoInfo::OnSearchItemFound(const CFileItem* pItem)
   Open();
   m_hasUpdatedThumb = m_hasUpdatedThumb || hasUpdatedThumb;
   m_hasUpdatedUserrating = m_hasUpdatedUserrating || hasUpdatedUserrating;
-  m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
+  m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems || hasUpdatedThumb;
 }
 
 void CGUIDialogVideoInfo::ClearCastList()
diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.h b/xbmc/video/dialogs/GUIDialogVideoInfo.h
index f9fb615..18c279a 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.h
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.h
@@ -120,7 +120,7 @@ protected:
   bool m_hasUpdatedThumb = false;
   bool m_hasUpdatedUserrating = false;
   int m_startUserrating = -1;
-  bool m_hasUpdatedItems{false};
+  bool m_hasUpdatedItems{false}; //!< Other items changed, or the art of an item moved on from
   bool m_refreshEnabled{false}; //!< May the item be refreshed
 
 private:
-- 
2.53.0

