 {
   const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 40565c4..c4dab09 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -328,6 +328,9 @@ private:
   //! commit of a frame, after 1 s and then less often (up to once a minute), until the driver
   //! takes it
   void FlipOutputOn();
+  //! Hades: ... and one that a change of mode from scratch could not turn on again
+  //! (CWinSystemGbm::FlipModeFromScratch())
+  void OutputLeftOff() override;
   bool m_flipOutputOff{false};
   std::chrono::steady_clock::time_point m_flipOutputTry{};
   std::chrono::steady_clock::duration m_flipOutputWait{};
diff --git a/xbmc/windowing/gbm/drm/NvidiaDualMode.h b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
index f8dcabe..bcce2b5 100644
--- a/xbmc/windowing/gbm/drm/NvidiaDualMode.h
+++ b/xbmc/windowing/gbm/drm/NvidiaDualMode.h
@@ -79,4 +79,21 @@ inline bool EntersInMode(std::optional<bool> modeOnCrtc, bool modeCommitted)
 {
   return modeOnCrtc.value_or(modeCommitted);
 }
+
+/*!
+ * Hades: whether a change of mode on this connector goes out with the head turned off and on, so
+ * that NVKMS brings the head and the link up from scratch in the new mode, as native Dolby Vision
+ * enters and leaves there: a DisplayPort connector that the card drives as HDMI
+ * (LinkFromScratch()), the output meant to be on, another mode, and video/dualmoderestart on (the
+ * default). Through the HDMI port of the HP ZBook 17 G6 (issue #4) a change of the refresh rate
+ * made on a running head did not reach the TV, which went on showing the rate before (a 23.976 Hz
+ * video at 60 Hz) while the DRM state had the new mode; through a USB-C to HDMI adapter of the same
+ * laptop it did; and with 1.0 RC4, whose exit from native output turned the head off and on in the
+ * mode of the video, the rate was taken at least sometimes. An HDMI connector is not one.
+ */
+inline bool ModeChangeRestarts(std::string_view type, std::optional<uint64_t> dualModeTmds,
+                               bool setting, bool active, bool otherTiming)
+{
+  return setting && active && otherTiming && LinkFromScratch(type, dualModeTmds);
+}
 } // namespace NVIDIA_DUAL_MODE
