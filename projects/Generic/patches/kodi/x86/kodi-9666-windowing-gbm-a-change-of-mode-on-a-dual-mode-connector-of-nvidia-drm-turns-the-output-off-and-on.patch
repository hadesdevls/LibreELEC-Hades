+bool CWinSystemGbm::ModeFromScratch() const
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  return (!advanced || advanced->m_videoDualModeRestart) && DVLinkFromScratch();
+}
+
+bool CWinSystemGbm::ModeChangeRestarts(const RESOLUTION_INFO& res) const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->SupportsProperty(NVIDIA_DUAL_MODE::PROPERTY))
+    return false;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  return NVIDIA_DUAL_MODE::ModeChangeRestarts(
+      connector->GetType(), connector->ReadPropertyValue(NVIDIA_DUAL_MODE::PROPERTY),
+      !advanced || advanced->m_videoDualModeRestart, drm->IsActive(), OtherTiming(res));
+}
+
+void CWinSystemGbm::FlipModeFromScratch(const RESOLUTION_INFO& res)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto on = [&drm]
+  { return drm->GetCrtc() && drm->GetCrtc()->ReadPropertyValue("ACTIVE").value_or(0) != 0; };
+  const std::string name = drm->GetConnector() ? drm->GetConnector()->GetName() : "none";
+  // The new mode with the head off, with the frame that the change of mode shows; then on again:
+  // NVKMS brings the head and the link up from scratch in the new mode, as when native Dolby Vision
+  // leaves (FlipDVBridgePage()). A refusal of the first commit falls back to the request before it
+  // (the head on, the mode before): the second one then makes the change in place, as before.
+  drm->SetActive(false);
+  FlipPage(true, false, false);
+  const bool off = !drm->LastCommitRefused() && !on();
+  drm->SetActive(true);
+  FlipPage(false, false, false);
+  if (on())
+  {
+    if (off)
+      CLog::Log(LOGINFO,
+                "The change of mode to {}x{} @ {:.3f} Hz went out with the output turned off and on "
+                "again on connector {}, so that its link starts from scratch in the new mode (a "
+                "dual-mode DisplayPort connector that the graphics card drives as HDMI; "
+                "advancedsettings.xml: dualmoderestart)",
+                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name);
+    else
+      CLog::Log(LOGWARNING,
+                "Turning the output off for the change of mode to {}x{} @ {:.3f} Hz was refused on "
+                "connector {}: the mode went out in place, as before",
+                res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name);
+    return;
+  }
+  // The driver can refuse to turn it on: it is asked again with the frames after it, after 1 s and
+  // then less often (OutputLeftOff()), as after a flip that did not come
+  CLog::Log(LOGERROR,
+            "The output could not be turned on again after the change of mode to {}x{} @ {:.3f} Hz "
+            "on connector {}: it is asked to again, after 1 s and then less often",
+            res.iScreenWidth, res.iScreenHeight, res.fRefreshRate, name);
+  drm->AllowModeset();
+  OutputLeftOff();
+}
