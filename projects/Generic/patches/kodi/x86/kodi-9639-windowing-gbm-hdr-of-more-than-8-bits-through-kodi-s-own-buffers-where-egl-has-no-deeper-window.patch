+// Hades: output of more than 8 bits through buffers that Kodi allocates itself (COwnScanout).
+// nvidia-drm with the 580 driver (Pascal and older GPUs) takes buffers of 10 bits (AB30, XB30)
+// and of half floats (AB4H) on its planes, and its EGL offers windows of 8 bits only: video of
+// more than 8 bits went out at 8 (NVKMS sends no more than the buffer holds). Kodi draws then into
+// buffers of its own, imported into EGL and drawn into through framebuffer objects; they stand
+// for the window's for Kodi's queue and commits (CGBMSurface::SetOwnBuffers()), and the window
+// of EGL stays, unswapped, for when the output has 8 bits again.
+// 10 bits are chosen before half floats: in the depth of HDR10 itself, which the driver then sends
+// as it is with "None" as the input colour space (see FloatOutputUsable()), and like the window of
+// 10 bits of the Mesa drivers; half the memory of half floats, and nothing out of [0, 1] to clamp.
+// Half floats only where FloatOutputUsable() allows the half-float output.
+// Where EGL offers a window of that depth (the 615 driver: half floats; AMD and Intel: 10 bits)
+// the window is used, as before; <video><hdrownbuffersalways>true</hdrownbuffersalways></video> in
+// advancedsettings.xml uses Kodi's own buffers there too, with any driver (to try this way on a
+// GPU whose EGL has a deeper window), and <hdrownbuffers>false</hdrownbuffers> never.
+bool CWinSystemGbmEGLContext::OwnScanoutWanted(int bitDepth)
+{
+  if (m_renderableType == EGL_OPENGL_BIT)
+    return false;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  if (advanced && !advanced->m_videoHdrOwnBuffers)
+    return false;
+  if (advanced && advanced->m_videoHdrOwnBuffersAlways)
+    return true;
+  // (nvidia-drm, known by a property of its planes: what another driver does with them is not
+  // known here, and the Mesa drivers offer windows of 10 bits)
+  if (!m_floatOutputSupported)
+    return false;
+  const EGLConfig config = m_eglContext.GetEGLConfig();
+  const bool window = ChooseEGLConfig(m_renderableType, bitDepth);
+  m_eglContext.SetEGLConfig(config);
+  return !window;
+}
+
+bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
+{
+#if defined(HAS_GLES)
+  if (OwnScanoutOn())
+    return true;
+  if (m_ownBlocked || !m_GBM || !m_DRM)
+    return false;
+  CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane();
+  if (!plane || !m_DRM->GetCrtc())
+    return false;
+
+  std::vector<const outputformat*> candidates;
+  for (const auto& format : m_DRM->GetOutputFormats())
+    if (format.active && format.bpp >= 10 && format.bpp <= bitDepth &&
+        COwnScanout::Bits(format.drm) == 10)
+      candidates.push_back(&format);
+  if (FloatOutputUsable())
+    for (const auto& format : m_DRM->GetOutputFormats())
+      if (format.active && COwnScanout::IsFloat(format.drm))
+        candidates.push_back(&format);
+  if (candidates.empty())
+  {
+    if (m_ownFailedKeys.insert("no-formats").second)
+      CLog::LogF(LOGINFO, "HDR output: no plane takes a buffer of 10 bits or of half floats: video "
+                          "of more than 8 bits goes out at 8 bits");
+    return false;
+  }
+
+  for (const outputformat* format : candidates)
+  {
+    // A frame-packed (3D) mode of nvidia-drm wants a buffer of its own kind
+    // (FramePackedBufferDemands()): not one of these
+    if (int width = m_nWidth; m_DRM->FramePackedBufferDemands(format->drm, width))
+      return false;
+    const std::string key =
+        StringUtils::Format("{}x{}@{:.3f} display {} {}", m_nWidth, m_nHeight, m_fRefreshRate,
+                            m_displayChanges.load(), DRMHELPERS::FourCCToString(format->drm));
+    if (m_ownFailedKeys.contains(key))
+      continue;
+    std::string failed;
+    auto own = COwnScanout::Create(m_GBM->GetDevice().Get(), m_eglContext.GetEGLDisplay(), m_nWidth,
+                                   m_nHeight, format->drm, format->modifiers, failed);
+    if (own && !m_DRM->TestFramebuffer(own->FirstBuffer()))
+    {
+      failed = "the driver refused, in a test, a commit of the plane with one of them";
+      own.reset();
+    }
+    if (!own)
+    {
+      m_ownFailedKeys.insert(key);
+      CLog::LogF(LOGWARNING,
+                 "HDR output: buffers of {} that Kodi allocates itself cannot be used in {}x{} @ "
+                 "{:.3f} Hz on this display ({}): not tried again for it",
+                 DRMHELPERS::FourCCToString(format->drm), m_nWidth, m_nHeight, m_fRefreshRate,
+                 failed);
+      continue;
+    }
+
+    // In place of the window's buffers: what the driver refused or dropped before counts no more
+    // (as for a half-float window, SetVideoOutput())
+    m_DRM->TakeFlipRefused();
+    if (m_DRM->TakeFlipDropped())
+      RequeueOutputProperties();
+    m_ownWindowFormat = plane->GetFormat();
+    m_ownWindowModifier = plane->GetModifier();
+    m_GBM->GetDevice().GetSurface().SetOwnBuffers(own);
+    m_ownScanout = own;
+    m_ownFloat = own->Floating();
+    m_ownBits = own->OutputBits();
+    plane->SetFormat(own->Format());
+    plane->SetModifier(own->Modifier());
+    BindOwnBack();
+    if (!OwnScanoutOn())
+      return false;
+    // (as for a half-float window: the next commit allows a modeset, which is an ordinary flip
+    // when no mode changes; with the amdgpu quirk, the output is set active)
+    if (m_DRM->HasQuirk(KODI::WINDOWING::GBM::QUIRK_NEEDSPRIMARY))
+      m_DRM->SetActive(true);
+    else
+      m_DRM->AllowModeset();
+    CLog::LogF(LOGINFO,
+               "HDR output: video of more than 8 bits goes out at {} bits through {} buffers of {} "
+               "(modifier {}) that Kodi allocates itself and draws into, {}x{}: {}; checked before "
+               "use (values of more than 8 bits written and read back, and a test commit)",
+               own->OutputBits() == 16 ? "more than 10" : "10", COwnScanout::BUFFERS,
+               DRMHELPERS::FourCCToString(own->Format()),
+               DRMHELPERS::ModifierToString(own->Modifier()), m_nWidth, m_nHeight,
+               m_floatOutputSupported ? "the EGL of nvidia-drm offers no window of that depth"
+                                      : "asked for in advancedsettings.xml (hdrownbuffersalways)");
+    return true;
+  }
+  return false;
+#else
+  return false;
+#endif
+}
+
+void CWinSystemGbmEGLContext::OwnScanoutStop(const std::string& why, bool failed)
+{
+  if (!OwnScanoutOn())
+    return;
+#if defined(HAS_GLES)
+  m_GBM->GetDevice().GetSurface().SetOwnBuffers(nullptr);
+  m_ownRetired.push_back(std::move(m_ownScanout));
+  m_ownScanout.reset();
+  m_ownRetiredFlips = 0;
+  m_ownBits = 0;
+  m_ownFloat = false;
+  m_ownFullFrames = COwnScanout::BUFFERS + 1;
+  COwnScanout::UnbindAll();
+  if (CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane())
+  {
+    plane->SetFormat(m_ownWindowFormat);
+    plane->SetModifier(m_ownWindowModifier);
+  }
+  if (m_DRM->HasQuirk(KODI::WINDOWING::GBM::QUIRK_NEEDSPRIMARY))
+    m_DRM->SetActive(true);
+  else
+    m_DRM->AllowModeset();
+  if (!failed)
+  {
+    CLog::LogF(LOGINFO, "HDR output: back to the window of EGL, at its depth: {}", why);
+    return;
+  }
+  m_ownBlocked = true;
+  ++m_ownFailures;
+  m_ownWait = m_ownFailures >= FLOAT_OUTPUT_ATTEMPTS ? FLOAT_OUTPUT_WAIT : 0;
+  CLog::LogF(LOGWARNING,
+             "HDR output: Kodi's own buffers of more than 8 bits could not be used ({}): back to "
+             "the window of EGL, at 8 bits, for this video{}",
+             why,
+             m_ownWait ? StringUtils::Format(" and the {} after it (they failed in each of the "
+                                             "last {} videos they were tried with)",
+                                             m_ownWait, m_ownFailures)
+                       : std::string());
+#endif
+}
+
+bool CWinSystemGbmEGLContext::SwapOutputBuffers()
+{
+#if defined(HAS_GLES)
+  if (OwnScanoutOn())
+    // The frame is in Kodi's own buffer: its GPU work goes to the GPU now, as eglSwapBuffers()
+    // would send it; with no fence of it for the commit to wait for, it is finished first
+    return m_ownScanout->Swap(!m_eglFence);
+  if (m_ownFullFrames > 0)
+    --m_ownFullFrames;
+#endif
+  return m_eglContext.TrySwapBuffers();
+}
+
+void CWinSystemGbmEGLContext::BindOwnBack()
+{
+#if defined(HAS_GLES)
+  if (!OwnScanoutOn() || m_ownScanout->BindBack())
+    return;
+  // Never with Kodi's queue (two buffers held at most, CGBMSurface::LockFrontBuffer()): the
+  // window's buffers, which are there, take the next frame
+  OwnScanoutStop("none of them was free to draw the next frame into", true);
+#endif
+}
+
+void CWinSystemGbmEGLContext::OwnScanoutRetire(bool rendered, bool refused)
+{
+#if defined(HAS_GLES)
+  if (m_ownRetired.empty() || !rendered || refused)
+    return;
+  // Off the screen after two flips of other buffers, and out of Kodi's queue when it has given
+  // them back; a queue that went with its window never gives them back, and their framebuffers
+  // are not used by it again: destroyed after a while all the same
+  ++m_ownRetiredFlips;
+  std::erase_if(m_ownRetired,
+                [this](const std::shared_ptr<COwnScanout>& own)
+                { return m_ownRetiredFlips >= 30 || (m_ownRetiredFlips >= 3 && own->Unlocked()); });
+#endif
+}
+
 void CWinSystemGbmEGLContext::delete_CVaapiProxy::operator()(CVaapiProxy* p) const
 {
   VaapiProxyDelete(p);
