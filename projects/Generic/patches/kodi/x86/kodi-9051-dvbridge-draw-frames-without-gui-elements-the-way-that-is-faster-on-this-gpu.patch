   //! The prepared frame is in the PQ texture (full-precision path), so it can take overlays;
   //! a directly packed frame has no PQ picture to draw into.
   bool Composable() const { return m_prepared && !m_direct; }
+  //! The prepared frame was drawn directly into the output
+  bool Direct() const { return m_prepared && m_direct; }
+  //! The prepared frame was drawn with the residual of its enhancement layer
+  bool PreparedResidual() const { return m_pendingDetail.fel; }
+  /*!
