+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Which of the two ways of drawing a Dolby Vision frame without GUI elements is used
+ *
+ * Such a frame can be drawn directly, the shader writing the transport into the output, or
+ * composed: reconstructed into the full-precision picture that a frame with GUI elements needs
+ * anyway, and then packed. Both pack the same reconstruction, each with a shader of its own:
+ * drawn by a software renderer, under 0.1 % of the pixels of a picture came out one code of
+ * 4096 apart (values on the edge between two codes), and no metadata bit. Direct drawing is the
+ * default, and on a discrete GPU the faster one (7 to 9 ms against 11 to 18 on an RTX 4080
+ * SUPER). On the integrated GPU of a Ryzen 9 7950X3D, with a FEL stream, it is the slower one:
+ * 35 to 37 ms against 30, of the 41.7 ms of a refresh at 23.976 Hz, so that one frame in three
+ * missed its refresh until the player bar came up.
+ *
+ * What a frame costs depends on the size of its picture and of its active area (both ways leave
+ * out what is outside it), which the caller gives as the load of the frame (see CDVFrameLoad).
+ * Each load is measured by itself, LOADS of them at a time: its windows are made of its own
+ * frames whenever they come, and once it has had a comparison, nothing that it measures or
+ * decides depends on which other loads are on the screen, on when they are, or on what they
+ * take.
+ *
+ * The way a load is drawn is measured in windows of WINDOW frames. When it takes most of a
+ * refresh period, the other way is tried for one window. If that one looks better, the way that
+ * was in use is measured for one more window, so that a single slow window of it (something
+ * else held the GPU or the processor) decides nothing; the other way is taken only when it
+ * beats both. From then on the load has a way of its own.
+ *
+ * One comparison is not believed for good: a window of either way may have been slow for a
+ * reason that has nothing to do with the way, most of all in the first seconds of a video,
+ * which is when the first comparison is made. The way that won is compared once more a wait
+ * later, whatever its time is, and again until it has won twice in a row. Only then does what
+ * is known of the other way keep that one from being tried: it is tried again when the way in
+ * use has become slower than the other one was, or, once in a video, when it takes more than
+ * the whole period. Between two comparisons of a load BETWEEN_TRIALS frames pass, twice as many
+ * after each one that did not start a new question.
+ *
+ * A load that has not had a comparison of its own is drawn the shared way: the one that the
+ * last comparison to be confirmed found, for whichever load (direct drawing before the first
+ * one). So a load that is drawn in a small part of the period is never compared, and on a GPU
+ * that draws every load so, nothing is ever tried. A load that takes most of the period is
+ * compared, unless it takes no more than the heaviest load that has confirmed the shared way
+ * did: what a picture that is as much work or more has found is not tried again for every
+ * picture shape. That holds while the load takes less than TIGHT of the period: above that its
+ * frames may be missing their refresh, and it is compared for itself whatever others found.
+ *
+ * The shared way and the ways that loads have found stay from one video to the next, for one
+ * GPU and one kind of stream (the window system keeps one of these for streams with an
+ * enhancement layer and one for those without). What is being measured does not: see Restart().
+ * In the first minute of a video nothing that is known is put in question: the first windows
+ * of a video can be slow for what starting it costs, and a trial then would be made at every
+ * start. A load of which nothing is known is compared with its first window all the same.
+ *
+ * Frames with GUI elements (a subtitle, the player bar) are not measured, and neither are those
+ * that draw a picture which stands still (see CDVStillPicture). What is being measured waits
+ * for them: with subtitles coming and going, a comparison is made of the frames between them.
+ * What a load has gathered is dropped when it has had no frame measured for
+ * ABSENCE_MAX frames. A comparison that has not ended after COMPARISON_MAX frames of its load
+ * is given up (the picture or the GUI keeps changing faster than a window fills, the GPU gives
+ * no times, or the frames asked for with that load turn out to be of another one). The next
+ * one of that load waits twice as long: the time drawn the way that is tried stays small.
+ */
+class CDVPathChoice
+{
+public:
+  //! What a measurement decided for the load of its frame, when it ends a comparison
+  struct Verdict
+  {
+    bool decided = false; //!< a comparison of the two ways ended with this measurement
+    //! ... without a result: the frames are not drawn directly when that is asked for (the
+    //! direct way needs a picture that fills the output)
+    bool undelivered = false;
+    //! a comparison was given up with this measurement (not decided)
+    bool givenUp = false;
+    bool direct = false; //!< the way of that load from now on
+    bool confirmed = false; //!< ... and it has won twice in a row
+    bool shared = false; //!< ... and is the shared way
+    double directMs = 0; //!< average GPU time of a frame drawn directly
+    double composedMs = 0; //!< ... and of a frame composed
+  };
+
+  /*!
+   * \brief The way to draw a frame without GUI elements
+   * \param load the load of the frame. 0, or a load that is not being measured: the shared way
+   *
+   * The way of that load; while it is compared and its window of the other way is being
+   * gathered, the other one (not when it comes back after so long that its comparison is
+   * dropped with its first frame).
+   */
+  bool Direct(uint64_t load = 0) const
+  {
+    if (load != 0)
+    {
+      for (const Load& known : m_loads)
+      {
+        if (known.id == load)
+          return known.OnTrial() && m_clock - known.seen <= ABSENCE_MAX ? !WayOf(known)
+                                                                        : WayOf(known);
+      }
+    }
+    return m_shared.direct;
+  }
+
+  /*!
+   * \brief Native output ended (the video, or a change of the display mode)
+   *
+   * What the loads had gathered is dropped, and the comparisons that had not ended: their
+   * parts would belong to different videos. So are the waits that comparisons which could not
+   * end left: they were about the picture of that video. The loads that have a way of their
+   * own keep it. The first minute of the next video begins.
+   */
+  void Restart()
+  {
+    for (Load& load : m_loads)
+    {
+      if (!load.own)
+      {
+        load = Load();
+        continue;
+      }
+      load.Forget();
+      load.skip = SKIP;
+      load.lastWay = load.way.direct;
+      load.overPeriodTried = false;
+      if (load.gaveUp)
+      {
+        load.gaveUp = false;
+        load.wait = BETWEEN_TRIALS;
+        load.trial = NEVER;
+      }
+    }
+    m_unusable = false;
+    m_settling = 0;
+    m_started = m_clock;
+  }
+
+  /*!
+   * \brief A frame was drawn that is not measured: one with GUI elements, one of a picture that
+   *        stands still, or one of the other kind of stream
+   *
+   * What is being measured waits, and the first frames after these are left out, as after a
+   * change of way.
+   */
+  void Interrupted()
+  {
+    ++m_clock;
+    m_settling = SKIP;
+  }
+
+  /*!
+   * \brief A frame without GUI elements was drawn, and its GPU time is not known (the query
+   *        gave no result, or none that can be used)
+   * \param load its load
+   *
+   * What is being measured waits, as for a frame that is not measured; the frames around it
+   * were drawn like it, so none is left out. It counts as a frame of the comparison of its
+   * load: one does not stay open because the times stopped coming.
+   */
+  Verdict Untimed(uint64_t load)
+  {
+    ++m_clock;
+    return Spend(load);
+  }
+
+  /*!
+   * \brief A frame without GUI elements was asked for with this load and is not a frame of it:
+   *        it turned out to be of another load, or could not be drawn
+   *
+   * It counts for the comparison of the load it was asked for with, which is the one that had
+   * it drawn the way that is tried: a comparison does not stay open, and its way in use, while
+   * the frames asked for with its load are frames of another one. (A frame that was drawn is
+   * told as well, with the load it turned out to be of.)
+   */
+  Verdict Missed(uint64_t load) { return Spend(load); }
+
+  /*!
+   * \brief Take the GPU time of a frame without GUI elements
+   * \param asked the way that was asked for
+   * \param direct how the frame was drawn: a frame asked for directly is composed when its
+   *        picture cannot be drawn directly
+   * \param ms its GPU time
+   * \param periodMs the refresh period
+   * \param load identifies the work of the frame (the size of its picture and of its active
+   *        area), never 0: only frames of the same load are compared
+   *
+   * The way of a frame need not be the one that Direct() gives for its load: the caller asks
+   * before it draws the frame, with the load that it foresees, and a frame can turn out to be
+   * of another one (its enhancement picture could not be used after all: see Missed()). It
+   * goes into a window of the load it is of only when it was drawn the way of that window.
+   */
+  Verdict Measured(bool asked, bool direct, double ms, double periodMs, uint64_t load)
+  {
+    if (load == 0 || !(ms > 0) || !std::isfinite(ms) || !(periodMs > 0) || !std::isfinite(periodMs))
+      return Untimed(load); // no usable measurement
+    Verdict verdict;
+    ++m_clock;
+
+    // The first frames after frames that are not measured also carry what the change costs
+    // (with GUI elements they are composed).
+    const bool settling = m_settling > 0;
+    if (settling)
+      --m_settling;
+
+    Load* const found = Find(load);
+    if (!found)
+      return verdict; // more loads than are measured at a time
+    Load& current = *found;
+
+    // Back after more than a window's worth of other frames: as after a change. After much
+    // longer, what it had gathered is too old to go on with.
+    const uint64_t away = m_clock - current.seen;
+    current.seen = m_clock;
+    if (away > WINDOW)
+      current.skip = SKIP;
+    if (away > ABSENCE_MAX)
+      current.Forget();
+
+    // Not kept open: every frame of a load counts for its comparison, whether it goes into a
+    // window or not, and however it was drawn.
+    if (current.Comparing() && ++current.spent >= COMPARISON_MAX)
+      return GiveUp(current);
+
+    // The shared way changed: what was gathered of the other one is not of the way this load
+    // is drawn any more.
+    if (!current.own && !current.Comparing() && current.way.direct != m_shared.direct)
+    {
+      current.way.direct = m_shared.direct;
+      current.windows = {};
+    }
+
+    // The first frames of a load after the way they are drawn changed also carry the change.
+    if (direct != current.lastWay)
+    {
+      current.lastWay = direct;
+      current.skip = SKIP;
+    }
+
+    if (asked != direct)
+    {
+      // The picture cannot be drawn directly. When that is the way this load tries, the
+      // comparisons that try it end, and there is none before the next video.
+      if (current.OnTrial() && !current.way.direct && ++current.undelivered >= WINDOW)
+        return Unusable();
+      return verdict;
+    }
+    if (direct)
+      current.undelivered = 0;
+
+    if (settling || current.skip > 0)
+    {
+      // the first frames of a video also carry what starting costs
+      if (current.skip > 0)
+        --current.skip;
+      return verdict;
+    }
+
+    // Not a frame of the window this load is at: drawn the other way while its own is being
+    // measured (before its comparison ended, or foreseen as of another load), or its own way
+    // while the other one is.
+    const bool tried = direct != current.way.direct;
+    if (tried != current.OnTrial())
+      return verdict;
+
+    Window& window = current.windows[tried];
+    window.sum += ms;
+    window.max = std::max(window.max, ms);
+    if (++window.count < WINDOW)
+      return verdict;
+
+    // without the slowest frame: one that waited for something else says nothing about the way
+    const double average = (window.sum - window.max) / (window.count - 1);
+    window = Window();
+
+    if (tried)
+    {
+      current.tried = average;
+      return Decide(current);
+    }
+    if (current.Comparing())
+    {
+      current.steady = std::min(current.steady, average);
+      ++current.steadies;
+      return Decide(current);
+    }
+
+    // Whether this window begins a comparison. A load with a way of its own: when that way won
+    // the last comparison and not yet the one before it, whatever its time is; else only when
+    // it takes most of the period and has become slower than the other one was, or, once in a
+    // video, when it takes more than the whole period (what is known of the other way is of
+    // another time: it may differ now). A load that goes the shared way: when it takes most of
+    // the period, and notably more than the heaviest load that confirmed that way did (or none
+    // has), or so much of the period that its frames may miss their refresh.
+    const Way& way = current.way;
+    const bool busy = average > BUSY * periodMs;
+    const bool overPeriod = current.own && average > periodMs && !current.overPeriodTried;
+    const bool wanted =
+        current.own ? way.wins == 1 || (busy && (GAIN * average > way.other || overPeriod))
+                    : busy && (!(m_shared.took > 0) || GAIN * average > m_shared.took ||
+                               average > TIGHT * periodMs);
+    if (!wanted || (m_unusable && !way.direct))
+      return verdict;
+    // Not in the first minute of a video when something is known of this load, its own way or
+    // a shared way that was confirmed. Not before the wait since the last comparison of this
+    // load is over (a way that does not fit waits a minute, unless that comparison was given
+    // up).
+    if (((current.own || m_shared.took > 0) && m_clock - m_started < BETWEEN_TRIALS) ||
+        Since(current) < (overPeriod && !current.gaveUp ? BETWEEN_TRIALS : current.wait))
+      return verdict;
+
+    // The comparison of this load begins with this window: its frames are asked for the other
+    // way from here on.
+    current.steady = average;
+    current.steadies = 1;
+    current.tried = 0;
+    current.spent = 0;
+    current.undelivered = 0;
+    current.overPeriodTrial = average > periodMs;
+    return verdict;
+  }
+
+private:
+  static constexpr uint64_t NEVER = UINT64_MAX;
+
+  struct Window
+  {
+    unsigned int count = 0;
+    double sum = 0;
+    double max = 0;
+  };
+
+  //! The way of a load, and what its comparisons found
+  struct Way
+  {
+    bool direct = true;
+    //! comparisons in a row that this way has won: 0 before the first one, 1 after one, which
+    //! is then made again, 2 when it won that one too
+    unsigned int wins = 0;
+    double other = 0; //!< last average of the way that is not in use; 0: never measured
+  };
+
+  //! One load, and its measurements
+  struct Load
+  {
+    uint64_t id = 0; //!< 0: none
+    uint64_t seen = 0; //!< m_clock of its last frame that was measured
+    unsigned int skip = SKIP; //!< its next frames that are left out
+    bool lastWay = true; //!< how its last frame was drawn
+    //! It has had a comparison: its way is its own. Else it goes the shared way, and \ref way
+    //! says which one its windows are of.
+    bool own = false;
+    Way way;
+    unsigned int wait = BETWEEN_TRIALS; //!< frames before its next comparison
+    uint64_t trial = NEVER; //!< m_clock at the end of its last comparison; NEVER: none
+    bool gaveUp = false; //!< that one was given up
+    //! the frames gathered for its next window of its way [0] and, in a comparison, of the
+    //! other one [1]
+    std::array<Window, 2> windows{};
+    // its comparison, when one is under way:
+    double steady = 0; //!< the best window of its way
+    unsigned int steadies = 0; //!< how many windows of it; 0: no comparison
+    double tried = 0; //!< the window of the other way; 0: none
+    unsigned int spent = 0; //!< its frames since the comparison began
+    //! its frames in a row that were asked for directly and composed
+    unsigned int undelivered = 0;
+    bool overPeriodTrial = false; //!< the comparison began with its way not fitting
+    //! its way did not fit in the period, and a comparison that began like that ended in this
+    //! video
+    bool overPeriodTried = false;
+
+    bool Comparing() const { return steadies > 0; }
+
+    //! Its frames are asked for the other way: it has a window of its way, and none of the
+    //! other one yet. After that one, its way is measured once more.
+    bool OnTrial() const { return steadies > 0 && !(tried > 0); }
+
+    //! How much would be lost with it: a whole window or more only in a comparison
+    unsigned int Gathered() const
+    {
+      return (steadies + (tried > 0 ? 1 : 0)) * WINDOW + windows[0].count + windows[1].count;
+    }
+
+    //! Its comparison, and its windows that are not complete
+    void Forget()
+    {
+      windows = {};
+      steady = tried = 0;
+      steadies = 0;
+      spent = 0;
+      undelivered = 0;
+      overPeriodTrial = false;
+    }
+  };
+
+  //! The way a load is drawn outside a trial: its own, or the one its comparison began with;
+  //! else the shared one
+  bool WayOf(const Load& load) const
+  {
+    return load.own || load.Comparing() ? load.way.direct : m_shared.direct;
+  }
+
+  //! Frames since the last comparison of a load; the first one does not wait
+  unsigned int Since(const Load& load) const
+  {
+    return load.trial == NEVER
+               ? MAX_WAIT
+               : static_cast<unsigned int>(std::min<uint64_t>(m_clock - load.trial, MAX_WAIT));
+  }
+
+  //! A frame counts for the comparison of a load, if it has one under way: not kept open
+  Verdict Spend(uint64_t load)
+  {
+    if (load != 0)
+    {
+      for (Load& known : m_loads)
+      {
+        if (known.id == load && known.Comparing() && ++known.spent >= COMPARISON_MAX)
+          return GiveUp(known);
+      }
+    }
+    return Verdict();
+  }
+
+  /*!
+   * \brief The measurements of a load
+   * \return nullptr when there is no place for it: it is drawn the shared way
+   *
+   * When there are more than LOADS, a new one takes the place of one that is not in a
+   * comparison (with more loads taking turns than there are places, each would take the place
+   * of the one that comes back next, and no comparison would end) and has no way of its own
+   * (it would lose it, and find it again with every return). Of those, the one that has
+   * gathered least: a picture that changes shape gradually is a new load every few frames, and
+   * those take each other's place. Then the one that was away longest. A load that has had no
+   * frame measured for ABSENCE_MAX frames does not keep its place: what it gathered would be
+   * dropped anyway, and one with a way of its own gives its place, and with it its way, when
+   * no other is left.
+   */
+  Load* Find(uint64_t id)
+  {
+    Load* place = nullptr;
+    unsigned int placeGathered = 0;
+    for (Load& load : m_loads)
+    {
+      if (load.id == id)
+        return &load;
+      const bool recent = load.id != 0 && m_clock - load.seen <= ABSENCE_MAX;
+      const unsigned int gathered = recent ? load.Gathered() : 0;
+      if (gathered >= WINDOW || (recent && load.own))
+        continue;
+      if (!place || load.own < place->own ||
+          (load.own == place->own &&
+           (gathered < placeGathered || (gathered == placeGathered && load.seen < place->seen))))
+      {
+        place = &load;
+        placeGathered = gathered;
+      }
+    }
+    if (!place)
+      return nullptr;
+    *place = Load();
+    place->id = id;
+    place->seen = m_clock;
+    place->way.direct = m_shared.direct;
+    place->lastWay = m_shared.direct;
+    return place;
+  }
+
+  //! Whether a load ends its comparison: with its window of the way tried, at once when that
+  //! one does not beat its window of the way in use; else when it beats two of them, the second
+  //! one measured after it.
+  Verdict Decide(Load& load)
+  {
+    Verdict verdict;
+    if (!load.Comparing() || !(load.tried > 0))
+      return verdict;
+    const bool better = load.tried < GAIN * load.steady;
+    if (better && load.steadies < 2)
+      return verdict;
+
+    Way& way = load.way;
+    verdict.decided = true;
+    verdict.directMs = way.direct ? load.steady : load.tried;
+    verdict.composedMs = way.direct ? load.tried : load.steady;
+    way.other = better ? load.steady : load.tried;
+    // The wait before the next comparison: a minute after the first one, and after one in which
+    // a way that had won twice lost (something has changed); twice the last wait after any
+    // other, so that two ways that take nearly the same time do not take turns every minute.
+    load.wait = way.wins == 0 || (better && way.wins == 2) ? BETWEEN_TRIALS
+                                                           : std::min(2 * load.wait, MAX_WAIT);
+    const bool confirms = !better && way.wins == 1;
+    if (better)
+    {
+      way.direct = !way.direct;
+      way.wins = 1;
+    }
+    else if (way.wins < 2)
+      ++way.wins;
+    // A way that has now won twice in a row is the shared one from here on, with what the
+    // heaviest load to confirm it takes drawn so. A later look that keeps a way changes
+    // nothing of that: it is made when the way has become slower, and what it measures then
+    // (a burst, as likely as not) is not what was confirmed.
+    if (confirms)
+    {
+      m_shared.took = m_shared.took > 0 && m_shared.direct == way.direct
+                          ? std::max(m_shared.took, load.steady)
+                          : load.steady;
+      m_shared.direct = way.direct;
+    }
+    verdict.confirmed = way.wins == 2;
+    verdict.shared = verdict.confirmed && m_shared.took > 0 && m_shared.direct == way.direct;
+    if (load.overPeriodTrial)
+      load.overPeriodTried = true;
+    load.trial = m_clock;
+    load.gaveUp = false;
+    load.own = true;
+    load.Forget();
+    verdict.direct = way.direct;
+    return verdict;
+  }
+
+  //! Give the comparison of a load up. Its next one waits twice its last wait.
+  Verdict GiveUp(Load& load)
+  {
+    Verdict verdict;
+    load.Forget();
+    load.gaveUp = true;
+    load.trial = m_clock;
+    load.wait = std::min(2 * load.wait, MAX_WAIT);
+    verdict.givenUp = true;
+    verdict.direct = WayOf(load);
+    return verdict;
+  }
+
+  //! The direct way cannot be drawn in this video: the comparisons that try it end, and none
+  //! begins. (A load whose way it is has its frames composed, and they are not measured.)
+  Verdict Unusable()
+  {
+    Verdict verdict;
+    m_unusable = true;
+    for (Load& load : m_loads)
+    {
+      if (load.Comparing() && !load.way.direct)
+        load.Forget();
+    }
+    verdict.decided = true;
+    verdict.undelivered = true;
+    verdict.direct = false;
+    return verdict;
+  }
+
+  static constexpr unsigned int WINDOW = 48; //!< frames of an average (two seconds of film)
+  static constexpr unsigned int SKIP = 6; //!< frames left out at the start and after a change
+  static constexpr unsigned int LOADS = 8; //!< loads measured at a time
+  //! frames between two comparisons of a load (a minute of film), doubled by each one that
+  //! only looked again
+  static constexpr unsigned int BETWEEN_TRIALS = 1440;
+  static constexpr unsigned int MAX_WAIT = 16 * BETWEEN_TRIALS;
+  //! frames for which a load may have no frame measured before what it has gathered is dropped
+  //! (ten minutes of film)
+  static constexpr unsigned int ABSENCE_MAX = 10 * BETWEEN_TRIALS;
+  //! frames of a load after which its comparison is given up (thirty seconds of film; one that
+  //! nothing disturbs takes about 110)
+  static constexpr unsigned int COMPARISON_MAX = 720;
+  static constexpr double BUSY = 0.6; //!< part of the refresh period from which a way is compared
+  //! the way tried is kept when it takes less than this part; and a load takes notably more
+  //! than another one when that one takes less than this part of it
+  static constexpr double GAIN = 0.95;
+  //! Part of the refresh period from which frames may miss their refresh. Measured on the
+  //! integrated GPU of a Ryzen 9 7950X3D at 23.976 Hz, in windows of 10 s (240 refreshes): at
+  //! 72 to 75 % (30.1 to 31.2 ms) 236 to 238 frames were shown and none to two presentations
+  //! were late; at 84 to 88 % (35.1 to 36.7 ms) 167 to 179 were shown and 61 to 73 were late.
+  //! Nothing was measured between the two.
+  static constexpr double TIGHT = 0.8;
+
+  //! The way of the loads that have not had a comparison of their own
+  struct Shared
+  {
+    bool direct = true;
+    //! what the heaviest load that confirmed it took drawn so; 0: none has
+    double took = 0;
+  };
+
+  Shared m_shared;
+  bool m_unusable = false; //!< the direct way cannot be drawn in this video
+  //! frames still left out after a frame that was not measured
+  unsigned int m_settling = 0;
+  uint64_t m_clock = 0; //!< counts the frames, measured or not
+  uint64_t m_started = 0; //!< m_clock when this video began
+  std::array<Load, LOADS> m_loads{};
+};
+
+/*!
+ * \brief The load of a Dolby Vision frame, as CDVPathChoice takes it
+ *
+ * What the GPU time of a frame depends on besides the kind of stream: the size of its picture
+ * and of its active area (a letterboxed picture can be less work than one that fills the frame:
+ * what is outside the active picture need not be reconstructed), and whether the residual of
+ * its enhancement layer is drawn (not when that picture could not be had, or carries none).
+ *
+ * The active picture counts in 64ths of the whole one. A frame whose active picture is within
+ * one 64th of that of the frame with which the last load began is of that load: a few lines
+ * more or less from a shot to the next are the same work, wherever the 64ths divide (3840x1600
+ * and 3840x2076, the two commonest shapes, are within four lines of such a place).
+ */
+class CDVFrameLoad
+{
+public:
+  /*!
+   * \brief The load of a frame
+   * \param width,height the size of its picture
+   * \param left,right,top,bottom what is not active picture at each side (the level 5 offsets
+   *        of its metadata); negative: none given
+   * \param residual the residual of its enhancement layer is drawn
+   * \return never 0
+   */
+  uint64_t Take(int width, int height, int left, int right, int top, int bottom, bool residual)
+  {
+    const auto active = [](int size, int first, int second)
+    { return static_cast<uint64_t>(std::max(size - std::max(first, 0) - std::max(second, 0), 0)); };
+    const uint64_t whole = active(width, 0, 0) * active(height, 0, 0);
+    const uint64_t pixels = active(width, left, right) * active(height, top, bottom);
+    const uint64_t kind = UINT64_C(1) << 63 | (residual ? RESIDUAL : 0) |
+                          (static_cast<uint64_t>(std::max(width, 0)) & 0x3fff) << 48 |
+                          (static_cast<uint64_t>(std::max(height, 0)) & 0xffff) << 32;
+    const uint64_t apart = pixels > m_pixels ? pixels - m_pixels : m_pixels - pixels;
+    if (m_load != 0 && kind == m_kind && 64 * apart <= whole)
+      return m_load;
+    m_kind = kind;
+    m_pixels = pixels;
+    m_load = kind | (whole ? (64 * pixels + whole / 2) / whole : 0);
+    return m_load;
+  }
+
+  //! The load of the same frame with, or without, the residual of its enhancement layer drawn
+  //! (a frame whose enhancement picture could not be used after all); not of 0
+  static uint64_t Residual(uint64_t load, bool residual)
+  {
+    return residual ? load | RESIDUAL : load & ~RESIDUAL;
+  }
+
+  //! For the log: how many 64ths of the picture of a load are active
+  static unsigned int Active64ths(uint64_t load) { return static_cast<unsigned int>(load & 0x7f); }
+
+  void Reset() { *this = CDVFrameLoad(); }
+
+private:
+  static constexpr uint64_t RESIDUAL = UINT64_C(1) << 62;
+  uint64_t m_kind = 0;
+  uint64_t m_pixels = 0; //!< the active picture of the frame with which m_load began
+  uint64_t m_load = 0;
+};
+
+/*!
+ * \brief Tells the frames that draw a picture which stands still
+ *
+ * While a video stands still (it is paused, or waits for data) the picture that is on the screen
+ * is drawn again at every refresh and nothing is decoded. Such a frame does not cost what a
+ * frame costs while the video plays, and the faster of the two ways need not be the same one.
+ * Measured on the integrated GPU of a Ryzen 9 7950X3D with a FEL stream: 24.7 ms directly and
+ * 29.5 composed with the video standing still, 35 to 37 and 30 while it played. No refresh that
+ * such a frame misses can be seen either. CDVPathChoice is told of these frames as of frames
+ * that are not measured.
+ *
+ * A playing video has its pictures drawn more than once, too: two and three times each for film
+ * at 59.94 Hz, five times at 120 Hz, and more when a picture comes late. A picture stands still
+ * when it is drawn again more than STILL_MS after it was first drawn: nearly five pictures of
+ * film later. (A video of fewer than five pictures a second is never measured.)
+ */
+class CDVStillPicture
+{
+public:
+  /*!
+   * \brief A frame draws a picture
+   * \param pts the time of the picture, which tells it from the one drawn before it
+   * \param nowMs when the frame is drawn, by a clock that does not go back
+   * \return true when the picture stands still
+   */
+  bool Take(double pts, double nowMs)
+  {
+    if (!m_drawn || pts != m_pts)
+    {
+      m_drawn = true;
+      m_pts = pts;
+      m_since = nowMs;
+      return false;
+    }
+    return nowMs - m_since > STILL_MS;
+  }
+
+  void Reset() { *this = CDVStillPicture(); }
+
+private:
+  static constexpr double STILL_MS = 200.0;
+  bool m_drawn = false; //!< a picture has been drawn
+  double m_pts = 0; //!< the last one
+  double m_since = 0; //!< when it was first drawn
+};
+
