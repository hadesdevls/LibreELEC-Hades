+double CWinSystemGbmGLESContext::DVRefreshPeriodMs() const
+{
+  // one refresh period in ms: pixels per frame / pixel clock in kHz
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  return mode && mode->clock ? static_cast<double>(mode->htotal) * mode->vtotal /
+                                   static_cast<double>(mode->clock)
+                             : 0.0;
+}
+
+void CWinSystemGbmGLESContext::DVGpuTimerTag(bool measured,
+                                             bool asked,
+                                             bool direct,
+                                             bool layered,
+                                             uint64_t load)
+{
+  auto& timer = m_dvGpuTimers[m_dvGpuTimerIndex];
+  if (timer.begun)
+  {
+    timer.measured = measured;
+    timer.asked = measured && asked;
+    timer.direct = measured && direct;
+    timer.layered = layered;
+    timer.load = load;
+  }
+  else if (timer.begin)
+  {
+    // This frame is not timed: the result of the frame that had this timer before is not back.
+    DVPathUntimed(measured, layered, load);
+  }
+}
+
+void CWinSystemGbmGLESContext::DVPathUntimed(bool measured, bool layered, uint64_t load)
+{
+  // As with a frame that is timed: what is being measured of the other kind of stream waits,
+  // and so does that of this kind when the frame is not one that is measured.
+  m_dvPath[!layered].Interrupted();
+  if (!measured)
+    m_dvPath[layered].Interrupted();
+  else
+    DVPathReport(m_dvPath[layered].Untimed(load), layered, load, DVRefreshPeriodMs());
+}
+
+void CWinSystemGbmGLESContext::DVPathReport(const CDVPathChoice::Verdict& verdict,
+                                            bool layered,
+                                            uint64_t load,
+                                            double periodMs)
+{
+  // which frames it is about: the kind of stream, and how much of the picture is active
+  const char* kind = layered ? "with" : "without";
+  const unsigned int active = CDVFrameLoad::Active64ths(load);
+  if (verdict.givenUp)
+    CLog::Log(LOGINFO,
+              "DVBridge: the two ways of drawing a frame without GUI elements ({} an enhancement "
+              "layer, {}/64 of the picture active) could not be compared (the picture or the GUI "
+              "changed too often, the GPU gave no times, or the enhancement pictures could not be "
+              "used): {} for now, compared again later",
+              kind, active, verdict.direct ? "drawn directly" : "composed");
+  if (!verdict.decided)
+    return;
+  if (verdict.undelivered)
+    CLog::Log(LOGINFO,
+              "DVBridge: a frame without GUI elements ({} an enhancement layer) cannot be drawn "
+              "directly in this video: not tried again before the next one",
+              kind);
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: a frame without GUI elements ({} an enhancement layer, {}/64 of the "
+              "picture active) takes {:.1f} ms of GPU time drawn directly and {:.1f} ms composed, "
+              "of the {:.1f} ms of a refresh: {} from now on{}",
+              kind, active, verdict.directMs, verdict.composedMs, periodMs,
+              verdict.direct ? "drawn directly" : "composed",
+              verdict.shared      ? ", and so are the picture shapes that have not been compared"
+              : verdict.confirmed ? ""
+                                  : " (to be looked at again)");
+}
