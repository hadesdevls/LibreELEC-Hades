   return texture ? pl_opengl_unwrap(m_gl->gpu, texture, nullptr, nullptr, nullptr) : 0;
 }
 
+bool CDVBridgeGLES::Foresee(const CDVMetadataBuffer& metadata,
+                            bool enhancement,
+                            int l5[4],
+                            bool& residual)
+{
+  std::fill_n(l5, 4, -1);
+  residual = false;
+  // The mapping that the renderer uses: it checks the metadata, the extension blocks among it,
+  // before anything is read, and says whether residuals are reconstructed.
+  dvbridge_color color{};
+  bool omitted = false;
+  if (!metadata.Data() ||
+      !dvbridge_map_color(&color, metadata.Data(), metadata.Size(), enhancement, &omitted))
+    return false;
+  residual = enhancement && color.dovi.nlq_active;
+  const auto* parsed = reinterpret_cast<const AVDOVIMetadata*>(metadata.Data());
+  for (int i = 0; i < parsed->num_ext_blocks; ++i)
+  {
+    const auto* ext = av_dovi_get_ext(parsed, i);
+    if (ext->level != 5)
+      continue;
+    l5[0] = ext->l5.left_offset;
+    l5[1] = ext->l5.right_offset;
+    l5[2] = ext->l5.top_offset;
+    l5[3] = ext->l5.bottom_offset;
+  }
+  return true;
+}
+
 bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancement,
                                   const CDVMetadataBuffer& metadata, dvbridge_geometry geometry, bool allowPacked)
 {
