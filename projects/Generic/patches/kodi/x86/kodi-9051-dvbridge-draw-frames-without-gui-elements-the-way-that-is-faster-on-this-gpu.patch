+   * \param enhancement the frame comes with a picture of its enhancement layer
+   * \param[out] l5 the level 5 offsets (left, right, top, bottom; -1 when the metadata has none)
+   * \param[out] residual the residual of the enhancement layer is drawn, if that picture can be
+   *             used (PreparedResidual() says whether it was)
+   * \return false when the metadata cannot be used: the frame is not prepared with it either
+   */
+  static bool Foresee(const CDVMetadataBuffer& metadata,
+                      bool enhancement,
+                      int l5[4],
+                      bool& residual);
 
   //! What the last presented Dolby Vision frame carried, for the player information.
   struct PresentedDetail
