From c6c4603a8402ad578e90c7ef741924059bc09c44 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 7 Oct 2026 15:19:37 +0000
Subject: [PATCH] dvbridge: keep the reconstructed picture within [0, 1] in its
 float texture

With GUI elements on screen the picture is reconstructed into a
floating-point texture, the GUI is blended over it and the result is
packed. libplacebo clamped what it wrote there to the range of the
target's representation, [0, 1]: the overshoot of the scaling filter and
colours beyond the PQ range did not get into the texture. From its
commit 99e80abd00 ("renderer: don't clamp float outputs to the integer
signal range") on it only clamps fixed-point targets.

The hook that blanks the area outside the active picture is the last
thing that changes the picture before that clamp (this target has one
plane and is not dithered), so it now clamps too: the texture holds the
same values with the libplacebo in use and with the newer one. The
packing shader clamps what it reads, so only what is blended over the
picture, translucent GUI elements, could have seen a difference.

Frames without GUI elements are packed by the other hook, which already
clamps, into a fixed-point target.

Read in the sources of both versions; not run.
---
 tools/dvbridge/dvbridge_render.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 7c15544..06bc75b 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -72,11 +72,16 @@ static struct pl_hook_res mask_active_area(void *priv, const struct pl_hook_para
     mask->called = true;
     struct pl_shader_var variable = {
         .var = pl_var_vec4("dvbridge_active"), .data = mask->rect, .dynamic = true};
+    /* Hades: the picture is stored within [0, 1], the range the transport packs. libplacebo
+     * clamped what it wrote into this floating-point texture; from its commit 99e80abd00 on it
+     * only clamps fixed-point targets. Nothing changes the picture between this hook and that
+     * clamp (one plane, no dithering), so the texture holds the same values with either. */
     struct pl_custom_shader shader = {
         .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
         .body = "if(gl_FragCoord.x < dvbridge_active.x || gl_FragCoord.x >= dvbridge_active.z || "
                 "gl_FragCoord.y < dvbridge_active.y || gl_FragCoord.y >= dvbridge_active.w) "
-                "color = vec4(0.0, 0.0, 0.0, 1.0);",
+                "color = vec4(0.0, 0.0, 0.0, 1.0);\n"
+                "color = clamp(color, 0.0, 1.0);",
         .variables = &variable, .num_variables = 1,
         .description = "DV active picture blanking before target overlays"};
     mask->failed = p->stage != PL_HOOK_OUTPUT || !pl_shader_custom(p->sh, &shader);
-- 
