 };
 
+//! A number for a text (FNV-1a), to tell what is known of one GPU, driver and build from what
+//! is known of another
+inline uint64_t DVPathKey(const std::string& text)
+{
+  uint64_t key = UINT64_C(14695981039346656037);
+  for (const char c : text)
+  {
+    key ^= static_cast<unsigned char>(c);
+    key *= UINT64_C(1099511628211);
+  }
+  return key;
+}
+
+/*!
+ * \brief What CDVPathChoice::Known() gives, kept for several GPUs in one text
+ *
+ * "<key>=<what is known of streams without an enhancement layer>/<... with one>" for each key,
+ * the one put last first, ENTRIES at most, a space between them. The key is DVPathKey() of what
+ * names the GPU, its driver and the build: what was found with one says nothing of another (a
+ * disk that is started with one graphics card or with another keeps what it knows of each).
+ */
+class CDVPathMemory
+{
+public:
+  //! The text with what is known for that key put first, in place of what it had for it (with
+  //! nothing known: without that key). Parts of the text that are not well formed are dropped.
+  static std::string Put(const std::string& all,
+                         uint64_t key,
+                         const std::string& plain,
+                         const std::string& layered)
+  {
+    const std::string name = Name(key);
+    std::string text;
+    unsigned int entries = 0;
+    if (!plain.empty() || !layered.empty())
+    {
+      text = name + '=' + plain + '/' + layered;
+      if (!Well(text))
+        text.clear();
+      else
+        ++entries;
+    }
+    for (size_t at = 0; at < all.size() && entries < ENTRIES;)
+    {
+      const size_t end = std::min(all.find(' ', at), all.size());
+      const std::string entry = all.substr(at, end - at);
+      at = end + 1;
+      if (!Well(entry) || entry.compare(0, name.size(), name) == 0)
+        continue;
+      if (!text.empty())
+        text += ' ';
+      text += entry;
+      ++entries;
+    }
+    return text;
+  }
+
+  //! What the text has for that key; false when it has nothing
+  static bool Get(const std::string& all, uint64_t key, std::string& plain, std::string& layered)
+  {
+    const std::string name = Name(key);
+    for (size_t at = 0; at < all.size();)
+    {
+      const size_t end = std::min(all.find(' ', at), all.size());
+      const std::string entry = all.substr(at, end - at);
+      at = end + 1;
+      if (!Well(entry) || entry.compare(0, name.size(), name) != 0)
+        continue;
+      const size_t slash = entry.find('/');
+      plain = entry.substr(name.size() + 1, slash - name.size() - 1);
+      layered = entry.substr(slash + 1);
+      return true;
+    }
+    return false;
+  }
+
+private:
+  static constexpr unsigned int ENTRIES = 4;
+  static constexpr size_t KEY = 16; //!< digits of a key
+  static constexpr size_t LONGEST = 600; //!< more than two texts of Known() and a key take
+
+  static std::string Name(uint64_t key)
+  {
+    char name[KEY + 1];
+    std::snprintf(name, sizeof(name), "%016llx", static_cast<unsigned long long>(key));
+    return name;
+  }
+
+  //! "<key>=<text>/<text>", the texts of the characters that Known() writes
+  static bool Well(const std::string& entry)
+  {
+    if (entry.size() < KEY + 2 || entry.size() > LONGEST || entry[KEY] != '=')
+      return false;
+    size_t slashes = 0;
+    for (size_t n = 0; n < entry.size(); ++n)
+    {
+      const char c = entry[n];
+      const bool hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+      if (n < KEY && !hex)
+        return false;
+      if (n > KEY)
+      {
+        if (c == '/')
+          ++slashes;
+        else if (!hex && c != 's' && c != ',' && c != '|')
+          return false;
+      }
+    }
+    return slashes == 1;
+  }
+};
+
 } // namespace GBM
 } // namespace WINDOWING
 } // namespace KODI
