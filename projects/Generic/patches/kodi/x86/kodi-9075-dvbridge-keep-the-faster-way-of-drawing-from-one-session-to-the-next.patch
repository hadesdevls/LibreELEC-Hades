+
+void CWinSystemGbmGLESContext::DVPathRecall()
+{
+  if (m_dvPathRecalled)
+    return;
+  m_dvPathRecalled = true;
+  // What tells the GPU and its driver (the GL strings: with Mesa they carry its version and
+  // the kernel's) and the build: the time of either way can change with any of them.
+  const auto text = [](GLenum name) {
+    const GLubyte* value = glGetString(name);
+    return std::string(value ? reinterpret_cast<const char*>(value) : "");
+  };
+  // ... and what advancedsettings.xml can turn off to measure it (video/dvearlymask).
+  const std::string renderer = text(GL_RENDERER);
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (renderer.empty() || !settings ||
+      !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH))
+    return; // nothing to tell this GPU from another by, or no place to keep it: as before
+  const auto advanced = component->GetAdvancedSettings();
+  m_dvPathKey = DVPathKey(renderer + '\n' + text(GL_VERSION) + '\n' +
+                          CSysInfo::GetOsPrettyNameWithVersion() +
+                          (advanced && !advanced->m_videoDVEarlyMask ? "\nno early mask" : ""));
+  m_dvPathNamed = true;
+  std::array<std::string, 2> known;
+  if (!CDVPathMemory::Get(settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH),
+                          m_dvPathKey, known[0], known[1]))
+    return;
+  for (size_t layered = 0; layered < known.size(); ++layered)
+  {
+    if (m_dvPath[layered].Recall(known[layered]))
+      CLog::Log(LOGINFO,
+                "DVBridge: frames without GUI elements ({} an enhancement layer) are {} unless "
+                "their picture shape found otherwise, as an earlier session found with this GPU, "
+                "driver and build ({})",
+                layered ? "with" : "without",
+                m_dvPath[layered].Direct() ? "drawn directly" : "composed", known[layered]);
+  }
+}
+
+void CWinSystemGbmGLESContext::DVPathRemember()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!m_dvPathNamed || !settings ||
+      !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH))
+    return;
+  const std::string before = settings->GetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH);
+  const std::string after =
+      CDVPathMemory::Put(before, m_dvPathKey, m_dvPath[0].Known(), m_dvPath[1].Known());
+  // written with the other settings when Kodi stops
+  if (after != before)
+    settings->SetString(CSettings::SETTING_VIDEOSCREEN_HADESDVPATH, after);
 }
 
