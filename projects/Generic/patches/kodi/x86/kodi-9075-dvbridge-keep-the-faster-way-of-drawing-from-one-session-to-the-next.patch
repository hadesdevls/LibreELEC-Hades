+  /*!
+   * \brief What is known for good, as text: the shared way, once a comparison has confirmed
+   *        it, and the loads whose way has won twice in a row
+   *
+   * Empty when nothing is. For Recall() in a later session.
+   */
+  std::string Known() const
+  {
+    std::string text;
+    char part[48];
+    if (m_shared.took > 0)
+    {
+      std::snprintf(part, sizeof(part), "s%d,%u", m_shared.direct ? 1 : 0,
+                    Hundredths(m_shared.took));
+      text = part;
+    }
+    for (const Load& load : m_loads)
+    {
+      if (load.id == 0 || !load.own || load.way.wins < 2 || !(load.way.other > 0))
+        continue;
+      std::snprintf(part, sizeof(part), "|%llx,%d,%u", static_cast<unsigned long long>(load.id),
+                    load.way.direct ? 1 : 0, Hundredths(load.way.other));
+      text += part;
+    }
+    return text;
+  }
+
+  /*!
+   * \brief Take what an earlier session knew, as Known() gave it
+   * \return false, and nothing changes, when the text is not of the form that Known() writes
+   *         (a shared way, loads, or both)
+   *
+   * For a new session, before its first frame: it takes the place of what this one knew. What
+   * is taken counts as found by this session: a way that had won twice in a row is the way of
+   * its load, and is compared again only as any such way is (when it has become slower than
+   * the other one was, or does not fit in the period), never in the first minute of a video.
+   * The loads that are taken count as loads that have been away: each keeps its way, and gives
+   * its place to a new load only when no other place is left (with all the places taken by
+   * loads of an earlier session, a new picture shape could never be compared).
+   */
+  bool Recall(const std::string& text)
+  {
+    Shared shared;
+    std::array<Load, LOADS> loads{};
+    size_t count = 0;
+    size_t at = 0;
+    if (at < text.size() && text[at] == 's')
+    {
+      uint64_t way = 0;
+      uint64_t took = 0;
+      ++at;
+      if (!Number(text, at, 10, 1, way) || !Skip(text, at, ',') ||
+          !Number(text, at, 10, MAX_HUNDREDTHS, took) || took == 0)
+        return false;
+      shared.direct = way != 0;
+      shared.took = static_cast<double>(took) / 100.0;
+    }
+    while (at < text.size())
+    {
+      uint64_t id = 0;
+      uint64_t way = 0;
+      uint64_t other = 0;
+      if (count >= LOADS || !Skip(text, at, '|') || !Number(text, at, 16, UINT64_MAX, id) ||
+          id == 0 || !Skip(text, at, ',') || !Number(text, at, 10, 1, way) ||
+          !Skip(text, at, ',') || !Number(text, at, 10, MAX_HUNDREDTHS, other) || other == 0)
+        return false;
+      for (size_t n = 0; n < count; ++n)
+      {
+        if (loads[n].id == id)
+          return false;
+      }
+      Load& load = loads[count++];
+      load.id = id;
+      load.own = true;
+      load.way.direct = way != 0;
+      load.way.wins = 2;
+      load.way.other = static_cast<double>(other) / 100.0;
+      load.lastWay = load.way.direct;
+    }
+    if (!(shared.took > 0) && count == 0)
+      return false;
+    m_shared = shared;
+    m_loads = loads;
+    m_unusable = false;
+    m_settling = 0;
+    // more than ABSENCE_MAX after the frame that the loads say they were last seen at (0)
+    m_clock = ABSENCE_MAX + 1;
+    m_started = m_clock;
+    return true;
+  }
+
 private:
   static constexpr uint64_t NEVER = UINT64_MAX;
+  //! the most that Known() writes for a time, in hundredths of a millisecond (a second)
+  static constexpr uint64_t MAX_HUNDREDTHS = 100000;
+
+  //! A time as Known() writes it: in hundredths of a millisecond, 1 to MAX_HUNDREDTHS
+  static unsigned int Hundredths(double ms)
+  {
+    const double hundredths = std::round(ms * 100.0);
+    if (!(hundredths >= 1.0))
+      return 1;
+    return hundredths > static_cast<double>(MAX_HUNDREDTHS)
+               ? static_cast<unsigned int>(MAX_HUNDREDTHS)
+               : static_cast<unsigned int>(hundredths);
+  }
+
+  //! Reads a number as Known() writes one (digits only, lower case, no zero before another
+  //! digit); false when there is none at that place, or it is more than max
+  static bool Number(const std::string& text, size_t& at, unsigned int base, uint64_t max,
+                     uint64_t& value)
+  {
+    const size_t start = at;
+    value = 0;
+    while (at < text.size())
+    {
+      const char c = text[at];
+      unsigned int digit = 0;
+      if (c >= '0' && c <= '9')
+        digit = static_cast<unsigned int>(c - '0');
+      else if (base == 16 && c >= 'a' && c <= 'f')
+        digit = static_cast<unsigned int>(c - 'a') + 10;
+      else
+        break;
+      if (digit > max || value > (max - digit) / base)
+        return false;
+      value = value * base + digit;
+      ++at;
+    }
+    return at > start && (at - start == 1 || text[start] != '0');
+  }
+
+  static bool Skip(const std::string& text, size_t& at, char c)
+  {
+    if (at >= text.size() || text[at] != c)
+      return false;
+    ++at;
+    return true;
+  }
 
