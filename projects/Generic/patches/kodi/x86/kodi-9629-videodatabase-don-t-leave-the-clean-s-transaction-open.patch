From afbe6f319531f352587f7d50a6c71fb315bc934d Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:04:16 +0100
Subject: [PATCH] [VideoDatabase] Don't leave the clean's transaction open

CleanDatabase() began a transaction that was only committed when there
were files to check, and was left open when the user cancelled while
the files were checked. The connection then stayed in a transaction, so
later writes on it, which nest in an open transaction, were never
committed. End the transaction on both paths; nothing has been written
on either of them yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e0ba08036562c30ffa8e5919972582920e425f51)
---
 xbmc/video/VideoDatabase.cpp          |  3 +++
 xbmc/video/test/TestVideoDatabase.cpp | 11 +++++++++++
 2 files changed, 14 insertions(+)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 5abf7e8..b776d35 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -10485,6 +10485,7 @@ void CVideoDatabase::CleanDatabase(CGUIDialogProgressBarHandle* handle,
           {
             progress->Close();
             m_pDS2->close();
+            RollbackTransaction();
             CServiceBroker::GetAnnouncementManager()->Announce(ANNOUNCEMENT::VideoLibrary,
                                                                "OnCleanFinished");
             return;
@@ -11018,6 +11019,8 @@ void CVideoDatabase::CleanDatabase(CGUIDialogProgressBarHandle* handle,
       for (const auto& i : changedMovies)
         AnnounceUpdate(MediaTypeMovie, i);
     }
+    else
+      RollbackTransaction(); // No files to check, so nothing has been changed
   }
   catch (...)
   {
diff --git a/xbmc/video/test/TestVideoDatabase.cpp b/xbmc/video/test/TestVideoDatabase.cpp
index e3d13d2..89e6eb4 100644
--- a/xbmc/video/test/TestVideoDatabase.cpp
+++ b/xbmc/video/test/TestVideoDatabase.cpp
@@ -1419,3 +1419,14 @@ TEST_F(TestVideoDatabaseClean, KeepsPlayedFilesThatMayNotHaveGone)
                      m_db.PrepareSQL("SELECT COUNT(*) FROM files WHERE idFile=%i", idFile)))
         << idFile;
 }
+
+// Writes made later on the connection would otherwise never be committed
+TEST_F(TestVideoDatabaseClean, EndsItsTransactionWhenThePathsHoldNoMedia)
+{
+  const std::string movies{Folder(m_root, "movies")};
+  AddSource(movies, "movies");
+
+  m_db.CleanDatabase(nullptr, {m_db.GetPathId(movies)}, false);
+
+  EXPECT_FALSE(m_db.InTransaction());
+}
