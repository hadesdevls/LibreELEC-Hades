From 5f3075f551d3903c2be776447af05d672ed7a82d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:03:49 +0000
Subject: [PATCH] dvbridge: a Dolby Vision picture up to 4096x2304 is taken in
 and scaled down to the 3840x2160 raster

The previous change kept every picture larger than the raster out of native output, which
left a profile 5 video of 4096 columns playing as Kodi plays it (its base layer, in the
wrong colours). The bridge now takes a source up to 4096x2304 (the surface of the
decoder's pool at most): the limit is one constant (dvbridge_limits.h, DVBRIDGE::
SOURCE_MAX_*) in the geometry check of the bridge, the import of a picture and of a layer, the
metadata geometry, the renderers' tests (CLinuxRendererGLES, CRendererVAAPIGLES) and the policy
(SourceFitsRaster()). Its place stays on the 3840x2160 raster; libplacebo scales the picture
down to it, and the source transport (which scales up only: dvbridge_source_scale_covers())
is not taken for it, so it goes out converted to BT.2020 in the Dolby Vision tunnel, drawn
with the colours that its own metadata give.

Measured on the software bridge (Mesa zink on lavapipe) with a synthetic source: the 3840x2160
pictures of a profile 7 FEL stream (Tron Legacy), scaled to 4096x2304 (its layer to 2048x1152)
with bicubic, drawn into the raster, against the same pictures at 3840x2160 in the same
transport: all six combinations of transport and way show every picture, with the residual;
the bytes of the packed transport differ by 0.09 on average (0.36 % of them by more than 4,
0.08 % by more than 16, in the active rows), which is the resampling twice. A 4096x2160 source
into a 3840x2025 place shows its pictures; one of 4098 columns is refused. A profile 5 stream
could not be made here (no sample, no encoder): the scaling does not depend on the profile.
---
 tools/dvbridge/dvbridge_core.c                   |  7 ++++---
 tools/dvbridge/dvbridge_dmabuf.c                 |  5 +++--
 tools/dvbridge/dvbridge_gl_frame.c               |  4 +++-
 tools/dvbridge/dvbridge_limits.h                 | 16 ++++++++++++++++
 tools/dvbridge/dvbridge_metadata.h               |  4 +++-
 .../DVDCodecs/Video/DVPlaybackPolicy.h           |  8 +++++++-
 .../HwDecRender/RendererVAAPIGLES.cpp            |  8 +++++---
 .../VideoRenderers/LinuxRendererGLES.cpp         |  7 ++++---
 8 files changed, 45 insertions(+), 14 deletions(-)
 create mode 100644 tools/dvbridge/dvbridge_limits.h

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index d9f00b4..56a8cff 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -9,6 +9,7 @@
  *  See LICENSES/README.md for more information.
  */
 /* Own frame metadata and commit serializer state only after a successful presentation. */
+#include "dvbridge_limits.h"
 #include "dvbridge_core.h"
 #include "dvbridge_metadata.h"
 
@@ -159,12 +160,12 @@ struct dvbridge_candidate *dvbridge_prepare_why(
         *why = "no metadata, or metadata out of their alignment";
         return NULL;
     }
-    if (geometry.source_width <= 0 || geometry.source_width > 3840 ||
-        geometry.source_height <= 0 || geometry.source_height > 2160 ||
+    if (geometry.source_width <= 0 || geometry.source_width > DVBRIDGE_SOURCE_MAX_WIDTH ||
+        geometry.source_height <= 0 || geometry.source_height > DVBRIDGE_SOURCE_MAX_HEIGHT ||
         geometry.x < 0 || geometry.x > 3840 || geometry.y < 0 || geometry.y > 2160 ||
         geometry.width <= 0 || geometry.width > 3840 ||
         geometry.height <= 0 || geometry.height > 2160) {
-        *why = "the picture, or its place, is not on the 3840x2160 raster";
+        *why = "the picture is larger than 4096x2304, or its place is not on the 3840x2160 raster";
         return NULL;
     }
     const AVDOVIMetadata *m = metadata;
diff --git a/tools/dvbridge/dvbridge_dmabuf.c b/tools/dvbridge/dvbridge_dmabuf.c
index 110fbde..0f6ac10 100644
--- a/tools/dvbridge/dvbridge_dmabuf.c
+++ b/tools/dvbridge/dvbridge_dmabuf.c
@@ -9,6 +9,7 @@
  *  See LICENSES/README.md for more information.
  */
 /* Import validated VAAPI DMA-BUF planes without copying decoded video to the CPU. */
+#include "dvbridge_limits.h"
 #include "dvbridge_dmabuf.h"
 #include "dvbridge_fel.h"
 #include "dvbridge_gl_pack.h"
@@ -62,8 +63,8 @@ static void describe_layout(const AVDRMFrameDescriptor *desc)
  * the fork's first version. Written as two numbers each, they looked like two limits for the same
  * picture. The images are made at the picture's size (make_planes()), not the surface's: what of the
  * surface is outside the picture is not part of any texture. */
-#define DVBRIDGE_DMABUF_PICTURE_MAX_WIDTH 3840
-#define DVBRIDGE_DMABUF_PICTURE_MAX_HEIGHT 2160
+#define DVBRIDGE_DMABUF_PICTURE_MAX_WIDTH DVBRIDGE_SOURCE_MAX_WIDTH
+#define DVBRIDGE_DMABUF_PICTURE_MAX_HEIGHT DVBRIDGE_SOURCE_MAX_HEIGHT
 #define DVBRIDGE_DMABUF_SURFACE_MAX_WIDTH 4096
 #define DVBRIDGE_DMABUF_SURFACE_MAX_HEIGHT 2304
 
diff --git a/tools/dvbridge/dvbridge_gl_frame.c b/tools/dvbridge/dvbridge_gl_frame.c
index 54945a5..8a96b66 100644
--- a/tools/dvbridge/dvbridge_gl_frame.c
+++ b/tools/dvbridge/dvbridge_gl_frame.c
@@ -9,6 +9,7 @@
  *  See LICENSES/README.md for more information.
  */
 /* Map native decoded planes to renderer textures while preserving layout and bit depth. */
+#include "dvbridge_limits.h"
 #include "dvbridge_gl_frame.h"
 #include <GLES3/gl3.h>
 #include <libplacebo/utils/libav.h>
@@ -28,7 +29,8 @@ bool dvbridge_gl_frame_import(struct dvbridge_gl_frame *out, pl_gpu gpu,
                              const struct dvbridge_gl_plane planes[3],
                              enum AVChromaLocation chroma_location)
 {
-    if (!out || !gpu || !planes || width <= 0 || width > 3840 || height <= 0 || height > 2160)
+    if (!out || !gpu || !planes || width <= 0 || width > DVBRIDGE_SOURCE_MAX_WIDTH ||
+        height <= 0 || height > DVBRIDGE_SOURCE_MAX_HEIGHT)
         return false;
     /* Refuse to overwrite live wrappers. Initialize to zero before first import. */
     if (out->gpu)
diff --git a/tools/dvbridge/dvbridge_limits.h b/tools/dvbridge/dvbridge_limits.h
new file mode 100644
index 0000000..5c79c61
--- /dev/null
+++ b/tools/dvbridge/dvbridge_limits.h
@@ -0,0 +1,16 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_LIMITS_H
+#define DVBRIDGE_LIMITS_H
+/* Hades: the largest picture the bridge takes in as a source. The transport it goes out in is the 3840x2160
+ * raster; a source larger than that (a 4096-wide DCI picture, a surface of the decoder's pool is at most
+ * 4096x2304) is scaled down to its place on the raster by libplacebo, as a source smaller than its place is
+ * scaled up. Its place stays on the raster (dvbridge_prepare_why()). */
+#define DVBRIDGE_SOURCE_MAX_WIDTH 4096
+#define DVBRIDGE_SOURCE_MAX_HEIGHT 2304
+#endif
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index 2c6e96e..e0b648c 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -11,6 +11,7 @@
 #ifndef MPV_DVBRIDGE_DV_H
 #define MPV_DVBRIDGE_DV_H
 #include "dvbridge_ipt.h"
+#include "dvbridge_limits.h"
 #include <stdint.h>
 #include <stdbool.h>
 #include <string.h>
@@ -203,7 +204,8 @@ static inline bool dvbridge_dv_readable(const AVDOVIMetadata *m, size_t bytes)
 static inline bool dvbridge_dv_geometry_view(struct dvbridge_dv *d, int w, int h,
                               int x, int y, int dw, int dh, const float view[4])
 {
-    DV_REFUSE(w > 0 && h > 0 && w <= 3840 && h <= 2160, "the picture is larger than 3840x2160");
+    DV_REFUSE(w > 0 && h > 0 && w <= DVBRIDGE_SOURCE_MAX_WIDTH && h <= DVBRIDGE_SOURCE_MAX_HEIGHT,
+              "the picture is larger than 4096x2304");
     DV_REFUSE(dw > 0 && dh > 0 && x >= 0 && y >= 0 && x+dw <= 3840 && y+dh <= 2160,
               "the picture is drawn outside the 3840x2160 raster");
     DV_REFUSE(!(x & 1) && !(dw & 1), "the picture is drawn at an odd column or an odd width");
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 186bc45..6e67c0e 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -21,6 +21,12 @@ constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
          !softwareProbe && !interlaced && !stereo && fitsRaster;
 }
 
+//! Hades: the largest picture the bridge takes in (tools/dvbridge/dvbridge_limits.h): a source larger
+//! than the 3840x2160 raster of the transport is scaled down to its place on it (a 4096-wide cinema
+//! picture, a surface of the decoder's pool at most 4096x2304)
+constexpr int SOURCE_MAX_WIDTH = 4096;
+constexpr int SOURCE_MAX_HEIGHT = 2304;
+
 /*!
  * \brief Hades: whether a picture of this size can go out natively: the transport is the
  *        3840x2160 raster, and the bridge imports a picture only up to that size
@@ -35,7 +41,7 @@ constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
  */
 constexpr bool SourceFitsRaster(int width, int height)
 {
-  return width <= 3840 && height <= 2160;
+  return width <= SOURCE_MAX_WIDTH && height <= SOURCE_MAX_HEIGHT;
 }
 
 /*!
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 1ae97e7..2bbc64b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -13,6 +13,7 @@
 
 #include "../RenderFactory.h"
 #include "cores/VideoPlayer/DVDCodecs/DVDCodecUtils.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/VAAPI.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/DisplaySettings.h"
@@ -229,11 +230,12 @@ bool CRendererVAAPIGLES::CanConvertDV(const VideoPicture& picture) const
 {
   // Native decoder textures only, as for native output. The place and the size on the screen are
   // free: the reconstruction is scaled to where Kodi puts the picture. The picture itself is of
-  // 3840x2160 at most, which is what the bridge takes (dvbridge_gl_frame_import()).
+  // 4096x2304 at most, which is what the bridge takes (dvbridge_gl_frame_import()); one larger than
+  // the 3840x2160 raster is scaled down to its place on it.
   const auto* pic = dynamic_cast<const CVaapiRenderPicture*>(picture.videoBuffer);
   if (!pic || pic->procPic.videoSurface == VA_INVALID_ID || m_textureTarget != GL_TEXTURE_2D ||
-      m_renderOrientation != 0 || picture.iWidth < 1 || picture.iWidth > 3840 ||
-      picture.iHeight < 1 || picture.iHeight > 2160)
+      m_renderOrientation != 0 || picture.iWidth < 1 || picture.iHeight < 1 ||
+      !DVBRIDGE::SourceFitsRaster(static_cast<int>(picture.iWidth), static_cast<int>(picture.iHeight)))
     return false;
   switch (pic->procPic.fourcc)
   {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index f0bd133..93fc2e9 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -524,7 +524,8 @@ bool CLinuxRendererGLES::DVGeometry(dvbridge_geometry& geometry) const
   // raster. Hades: zoom (a cropped source), stretching, pixels that are not square or a shift out
   // of the raster draw the part of the picture that Kodi shows where Kodi draws it, natively too
   // (a view in the geometry: DVBRIDGE::ViewGeometry()); they kept the ordinary output.
-  if (m_sourceWidth == 0 || m_sourceHeight == 0 || m_sourceWidth > 3840 || m_sourceHeight > 2160)
+  if (m_sourceWidth == 0 || m_sourceHeight == 0 ||
+      !DVBRIDGE::SourceFitsRaster(static_cast<int>(m_sourceWidth), static_cast<int>(m_sourceHeight)))
     return false;
   const double aspect = static_cast<double>(m_sourceHeight) / m_sourceWidth;
   if (m_sourceRect.x1 != 0 || m_sourceRect.y1 != 0 || m_sourceRect.Width() != m_sourceWidth ||
@@ -591,8 +592,8 @@ const char* CLinuxRendererGLES::DVCpuWhyNot(const VideoPicture& picture) const
   // for a VAAPI surface.
   if (picture.videoBuffer->GetFormat() != AV_PIX_FMT_YUV420P10)
     return "its pixel format is not 10-bit 4:2:0";
-  if (picture.iWidth < 2 || picture.iHeight < 2 || picture.iWidth > 3840 || picture.iHeight > 2160)
-    return "it is larger than 3840x2160";
+  if (picture.iWidth < 2 || picture.iHeight < 2 || !DVBRIDGE::SourceFitsRaster(static_cast<int>(picture.iWidth), static_cast<int>(picture.iHeight)))
+    return "it is larger than 4096x2304";
   if (picture.iWidth % 2 || picture.iHeight % 2)
     return "it is of an odd width or height";
   if (m_textureTarget != GL_TEXTURE_2D || m_renderOrientation != 0)
