+std::optional<uint64_t> AtomicCrtcOf(int fd, uint32_t connectorId)
+{
+  drmModeObjectPropertiesPtr properties =
+      drmModeObjectGetProperties(fd, connectorId, DRM_MODE_OBJECT_CONNECTOR);
+  if (!properties)
+    return std::nullopt;
+  std::optional<uint64_t> crtc;
+  for (uint32_t i = 0; i < properties->count_props && !crtc; i++)
+  {
+    drmModePropertyPtr property = drmModeGetProperty(fd, properties->props[i]);
+    if (property && strcmp(property->name, "CRTC_ID") == 0)
+      crtc = properties->prop_values[i];
+    drmModeFreeProperty(property);
+  }
+  drmModeFreeObjectProperties(properties);
+  return crtc;
+}
