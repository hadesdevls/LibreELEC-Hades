+bool CDRMAtomic::DisableOtherOutputs(int& flags, std::optional<KEEP_OUTPUTS::KeepMode> mode)
+{
+  using KEEP_OUTPUTS::KeepMode;
+  const AddFunction nothing = [](CDRMObject*, const char*, uint64_t) {};
+  // (Hades: in the commit of a move, the output that Kodi leaves goes off as it always did; and
+  // what the driver said of the last way it did not take, there as TestOutputMove() heard it)
+  const bool inMove = mode.has_value();
+  const CDRMConnector* leaving = inMove ? m_moveFrom : nullptr;
+  int refusedError = inMove ? m_moveKeepError : 0;
+
+  // Hades: where an output is kept on, how it can be left is asked of the driver first, in a
+  // request of its own, so that a way that the driver does not take neither goes out with the
+  // frame nor keeps the other outputs on (KEEP_OUTPUTS::KeepMode). Without one, the request is
+  // what it always was, and is asked with the frame.
+  if (!mode)
+  {
+    if (AddOtherOutputsOff(nothing, m_crtc, m_connector, nullptr, KeepMode::UNTOUCHED).kept.empty())
+      mode = KeepMode::OFF;
+    else
+    {
+      mode = KEEP_OUTPUTS::FirstTaken(
+          HasQuirk(QUIRK_NEEDSPRIMARY),
+          [this, &refusedError](KeepMode way)
+          {
+            CDRMAtomicRequest request;
+            bool made = true;
+            const OtherOutputsOff asked = AddOtherOutputsOff(
+                [&request, &made](CDRMObject* object, const char* name, uint64_t value)
+                { made = request.AddProperty(object, name, value) && made; }, m_crtc, m_connector,
+                nullptr, way);
+            if (!made)
+            {
+              refusedError = EINVAL;
+              return false;
+            }
+            if (!asked.changes)
+              return true;
+            if (drmModeAtomicCommit(m_fd, request.Get(),
+                                    DRM_MODE_ATOMIC_TEST_ONLY |
+                                        (asked.off > 0 ? DRM_MODE_ATOMIC_ALLOW_MODESET : 0),
+                                    nullptr) == 0)
+              return true;
+            refusedError = errno;
+            return false;
+          });
+      if (!mode)
+      {
+        // (the other outputs are asked again later: nothing of it goes out with this frame)
+        const OtherOutputsOff all =
+            AddOtherOutputsOff(nothing, m_crtc, m_connector, nullptr, KeepMode::OFF);
+        CLog::LogF(LOGWARNING,
+                   "the driver refused turning off {} output(s) not used by Kodi, also with {} "
+                   "that hades-keep-outputs keeps on ({})",
+                   all.off, StringUtils::Join(all.keptOff, ", "), strerror(refusedError));
+        OtherOutputsOffRefused(refusedError);
+        return false;
+      }
     }
-    AddProperty(crtc.get(), "ACTIVE", 0);
-    AddProperty(crtc.get(), "MODE_ID", 0);
-    disabled++;
   }
-  if (disabled > 0)
+
+  const OtherOutputsOff done = AddOtherOutputsOff(
+      [this](CDRMObject* object, const char* name, uint64_t value)
+      { AddProperty(object, name, value); }, m_crtc, m_connector, leaving, *mode);
+  if (done.off > 0)
   {
     flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
+    CLog::LogF(LOGINFO, "turning off {} output(s) not used by Kodi", done.off);
+  }
+  if (done.changes)
     flags &= ~DRM_MODE_ATOMIC_NONBLOCK;
-    CLog::LogF(LOGINFO, "turning off {} output(s) not used by Kodi", disabled);
+  LogKeptOutputs(done, *mode, refusedError);
+  return done.changes;
+}
+
+void CDRMAtomic::LogKeptOutputs(const OtherOutputsOff& done,
+                                KEEP_OUTPUTS::KeepMode mode,
+                                int refusedError)
+{
+  using KEEP_OUTPUTS::KeepMode;
+  std::string text;
+  if (!done.kept.empty())
+  {
+    const std::string names = StringUtils::Join(done.kept, ", ");
+    if (mode == KeepMode::DETACHED)
+      text = fmt::format("{} stay(s) on, black, for its sound (hades-keep-outputs)", names);
+    else if (HasQuirk(QUIRK_NEEDSPRIMARY))
+      text = fmt::format("{} stay(s) on as it was, with what it showed, for its sound "
+                         "(hades-keep-outputs; the driver needs a plane on a CRTC that is on)",
+                         names);
+    else if (refusedError != 0)
+      text = fmt::format("{} stay(s) on as it was, with what it showed, for its sound "
+                         "(hades-keep-outputs; the driver did not take it on with nothing on it: "
+                         "{})",
+                         names, strerror(refusedError));
+    else
+      text = fmt::format("{} stay(s) on as it was, with what it showed, for its sound "
+                         "(hades-keep-outputs)",
+                         names);
+  }
+  if (!done.keptOff.empty())
+    text += fmt::format("{}{} go(es) off although hades-keep-outputs keeps it on: the driver "
+                        "would take turning off the outputs Kodi does not use only with it ({})",
+                        text.empty() ? "" : "; ", StringUtils::Join(done.keptOff, ", "),
+                        refusedError != 0 ? strerror(refusedError) : "no other way was asked");
+  if (text.empty() || text == m_keptLogged)
+    return;
+  m_keptLogged = text;
+  CLog::LogF(done.keptOff.empty() ? LOGINFO : LOGWARNING, "{}", text);
+}
+
+void CDRMAtomic::OtherOutputsOffRefused(int error)
+{
+  // (a mode that comes asks again on its own: the count is of the one the outputs went off with)
+  constexpr int tries = 3;
+  constexpr auto later = std::chrono::seconds(10);
+  if (++m_otherOutputsTries < tries)
+  {
+    m_otherOutputsOff = std::chrono::steady_clock::now() + later;
+    CLog::LogF(LOGWARNING,
+               "the commit that turns off the outputs not used by Kodi was refused ({}): it is "
+               "asked for again in {} s",
+               strerror(error), later.count());
   }
-  if (keptOn > 0)
-    CLog::LogF(LOGINFO, "{} output(s) stay on, black, for their sound (hades-keep-outputs)",
-               keptOn);
-  return disabled > 0;
+  else
+    CLog::LogF(LOGWARNING,
+               "the commit that turns off the outputs not used by Kodi was refused {} times ({}): "
+               "they stay on",
+               tries, strerror(error));
 }
 
