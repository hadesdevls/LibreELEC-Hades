From 5ed6dd8817c5eac0f927fad58bbb89d7c9f91d86 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:53:15 +0000
Subject: [PATCH] windowing/gbm: a framebuffer of a buffer made without
 modifiers is given none

The kernel refuses a framebuffer that gives a plane a modifier other than 0
without DRM_MODE_FB_MODIFIERS ("bad fb modifier", framebuffer_check() in
drm_framebuffer.c), and libdrm's drmModeAddFB2WithModifiers() sends the
modifiers it is given whatever the flags say. A buffer made without
modifiers says DRM_FORMAT_MOD_INVALID, and Kodi passed that value without the
flag in three places:

- CDRMUtils::DrmOpaqueFbGetFromBo(), the opaque view of the GUI buffer that
  native Dolby Vision scans out: refused, with no second try ("Cannot create
  opaque transport framebuffer"), so native output did not start there and
  the video went on on the ordinary output;
- CVideoLayerBridgeDRMPRIME, the framebuffer of a DRM PRIME picture: refused,
  with no second try either;
- CDRMUtils::DrmFbGetFromBo(), the GUI framebuffer: its first try was refused
  and the second one, without modifiers, made it.

DRM_FB_MODIFIERS::Fit() (drm/FbModifiers.h) makes the modifiers and the flags
of all three: INVALID goes as no modifier at all (0 in every plane, no flag),
which is what a framebuffer without modifiers means, the layout that the
driver gave the buffer; LINEAR without the flag as before (with it for a
frame-packed buffer of nvidia-drm, as before); any other modifier with the
flag, as before. Nothing changes for a buffer that has a modifier.

Only where a plane has no IN_FORMATS (a buffer made without modifiers) was
the defect reachable; in the hardware that Hades has been tried on it was not
seen. The log line of the opaque view now says the format, the modifier and
the flags that were refused.

Found by YBLOD (dangerouslaser), who saw the opaque view refused on amdgpu.
---
 .../HwDecRender/VideoLayerBridgeDRMPRIME.cpp  |  6 ++-
 xbmc/windowing/gbm/drm/DRMUtils.cpp           | 33 +++++++-----
 xbmc/windowing/gbm/drm/FbModifiers.h          | 51 +++++++++++++++++++
 3 files changed, 74 insertions(+), 16 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/FbModifiers.h

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
index 54509e2..126e071 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
@@ -13,6 +13,7 @@
 #include "utils/log.h"
 #include "windowing/WinSystem.h"
 #include "windowing/gbm/drm/DRMAtomic.h"
+#include "windowing/gbm/drm/FbModifiers.h"
 
 #include <utility>
 
@@ -153,8 +154,9 @@ uint32_t CVideoLayerBridgeDRMPRIME::CreateFramebuffer(CVideoBufferDRMPRIME* buff
       }
     }
 
-    if (modifier[0] && modifier[0] != DRM_FORMAT_MOD_INVALID)
-      flags = DRM_MODE_FB_MODIFIERS;
+    // Hades: a picture whose buffer has no modifier (DRM_FORMAT_MOD_INVALID) is given none: with
+    // INVALID and no flag the kernel refused its framebuffer (DRM_FB_MODIFIERS::Fit())
+    flags = DRM_FB_MODIFIERS::Fit(modifier);
 
     // add the video frame FB
     ret = drmModeAddFB2WithModifiers(m_DRM->GetFileDescriptor(), buffer->GetWidth(),
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index e939047..a153911 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -8,6 +8,8 @@
 
 #include "DRMUtils.h"
 
+#include "FbModifiers.h"
+
 #include "ServiceBroker.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
@@ -416,20 +418,19 @@ drm_fb* CDRMUtils::DrmFbGetFromBo(struct gbm_bo* bo)
   memset(offsets, 0, 16);
 #endif
 
-  uint32_t flags = 0;
-
-  if (modifiers[0] && modifiers[0] != DRM_FORMAT_MOD_INVALID)
-  {
-    flags |= DRM_MODE_FB_MODIFIERS;
-    CLog::LogF(LOGDEBUG, "Using modifier: {}", DRMHELPERS::ModifierToString(modifiers[0]));
-  }
-#if defined(HAS_GBM_MODIFIERS)
   // Hades: DRM_FORMAT_MOD_LINEAR is 0, so the framebuffer of such a buffer is made without
   // saying how its lines lie. nvidia-drm takes a frame-packed frame only from a framebuffer
   // that says that they lie one after another (FramePackedBufferUsable() has asked the buffer).
-  else if (modifiers[0] == DRM_FORMAT_MOD_LINEAR && FramePackedByOffsets())
-    flags |= DRM_MODE_FB_MODIFIERS;
+  bool explicitLinear = false;
+#if defined(HAS_GBM_MODIFIERS)
+  explicitLinear = modifiers[0] == DRM_FORMAT_MOD_LINEAR && FramePackedByOffsets();
 #endif
+  // Hades: ... and a buffer made without modifiers (DRM_FORMAT_MOD_INVALID) is given none, which
+  // the kernel takes: the first try below was refused for it, and the second one made it
+  // (DRM_FB_MODIFIERS::Fit())
+  const uint32_t flags = DRM_FB_MODIFIERS::Fit(modifiers, explicitLinear);
+  if (flags && modifiers[0] != DRM_FORMAT_MOD_LINEAR)
+    CLog::LogF(LOGDEBUG, "Using modifier: {}", DRMHELPERS::ModifierToString(modifiers[0]));
 
   int ret = drmModeAddFB2WithModifiers(m_fd, width, height, fb->format, handles, strides, offsets,
                                        modifiers, &fb->fb_id, flags);
@@ -483,16 +484,20 @@ uint32_t CDRMUtils::DrmOpaqueFbGetFromBo(struct gbm_bo* bo)
   handles[0] = gbm_bo_get_handle(bo).u32;
   strides[0] = gbm_bo_get_stride(bo);
 #endif
-  const uint32_t flags = modifiers[0] != DRM_FORMAT_MOD_LINEAR &&
-                                 modifiers[0] != DRM_FORMAT_MOD_INVALID
-                             ? DRM_MODE_FB_MODIFIERS : 0;
+  // Hades: a buffer made without modifiers (DRM_FORMAT_MOD_INVALID) is given none. With INVALID
+  // in its modifiers and no flag the kernel refused this view ("bad fb modifier"), and native
+  // Dolby Vision did not start, where the GUI framebuffer of the same buffer was made by its
+  // second try (DRM_FB_MODIFIERS::Fit(); found by YBLOD on amdgpu)
+  const uint32_t flags = DRM_FB_MODIFIERS::Fit(modifiers);
   const int result = drmModeAddFB2WithModifiers(
       m_fd, gbm_bo_get_width(bo), gbm_bo_get_height(bo), DRM_FORMAT_XRGB8888,
       handles, strides, offsets, modifiers, &fb->opaque_fb_id, flags);
   if (result != 0)
   {
     fb->opaque_fb_id = 0;
-    CLog::LogF(LOGERROR, "Cannot create opaque transport framebuffer: {}", strerror(errno));
+    CLog::LogF(LOGERROR, "Cannot create opaque transport framebuffer: {} (format {:#x}, modifier "
+               "{:#x}, flags {:#x})",
+               strerror(errno), gbm_bo_get_format(bo), modifiers[0], flags);
   }
   return fb->opaque_fb_id;
 }
diff --git a/xbmc/windowing/gbm/drm/FbModifiers.h b/xbmc/windowing/gbm/drm/FbModifiers.h
new file mode 100644
index 0000000..2f60373
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/FbModifiers.h
@@ -0,0 +1,51 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include <drm_fourcc.h>
+#include <drm_mode.h>
+
+/*
+ * Hades: the modifiers of a framebuffer (drmModeAddFB2WithModifiers()) made fit for the kernel.
+ *
+ * The kernel refuses a framebuffer that gives a plane a modifier other than 0 without
+ * DRM_MODE_FB_MODIFIERS ("bad fb modifier", framebuffer_check() in drm_framebuffer.c), and libdrm
+ * sends the modifiers it is given whatever the flags say. A buffer made without modifiers says
+ * DRM_FORMAT_MOD_INVALID: its layout is the one its driver gave it, which is what a framebuffer
+ * without modifiers means (the implicit layout). Kodi gave INVALID without the flag in three
+ * places: the GUI framebuffer (CDRMUtils::DrmFbGetFromBo(), whose second try, without modifiers,
+ * made it), the opaque view of it that native Dolby Vision scans out
+ * (CDRMUtils::DrmOpaqueFbGetFromBo(), with no second try: "Cannot create opaque transport
+ * framebuffer", and the video went on on the ordinary output) and the framebuffer of a DRM PRIME
+ * picture (CVideoLayerBridgeDRMPRIME, no second try either). YBLOD (dangerouslaser) found the one of
+ * the opaque view on amdgpu. Pure: a test builds it on the host.
+ */
+namespace DRM_FB_MODIFIERS
+{
+/*!
+ * \brief The flags for the modifiers of a buffer, which are made fit with them: INVALID becomes no
+ *        modifier at all (0 in every plane, no flag); DRM_FORMAT_MOD_LINEAR, which is 0, goes
+ *        without the flag too (the implicit layout, as Kodi has always made it) unless
+ *        explicitLinear; any other modifier goes with the flag, as it is.
+ */
+inline uint32_t Fit(uint64_t (&modifiers)[4], bool explicitLinear = false)
+{
+  if (modifiers[0] == DRM_FORMAT_MOD_INVALID)
+  {
+    for (uint64_t& modifier : modifiers)
+      modifier = 0;
+    return 0;
+  }
+  if (modifiers[0] != DRM_FORMAT_MOD_LINEAR)
+    return DRM_MODE_FB_MODIFIERS;
+  return explicitLinear ? DRM_MODE_FB_MODIFIERS : 0;
+}
+} // namespace DRM_FB_MODIFIERS
