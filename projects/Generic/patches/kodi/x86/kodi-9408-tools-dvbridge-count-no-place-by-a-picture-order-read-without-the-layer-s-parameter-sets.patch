From 7bfb8d2e6360d0ae154ea2320ed1f2d15b28f47a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 20:14:49 +0000
Subject: [PATCH] tools/dvbridge: count no place by a picture order read
 without the layer's parameter sets

dovi_split gives the layer the configuration of the base layer when the stream
has none of its own (no hvcE: the FEL test stream in one track is such a file),
and the parser of the layer reads with it until the access units of the layer
bring their own parameter sets, which they do with their random-access
pictures. After a reset, a picture order count read before then is read with
the parameter sets of the other layer: its width in bits, and more, can be
wrong. The count of rank_try() took the picture order of the random-access
picture it starts at, and the access units passed over before it gave their
RPUs by theirs.

Now neither is done before the layer's own parameter sets are known: those of
its configuration, or a sequence and a picture parameter set that its access
units brought since the parser started. A random-access picture that brings
them is counted as before; the access units before the first one after a reset
give no RPU, and their base pictures keep the one carried with them. The
shortcuts by picture order (a random-access picture shared with the base layer,
an IDR picture of the layer) are as before.

In the FEL test stream every random-access picture of the layer brings both (154
of 154 in one track); its other access units, none.
---
 tools/dvbridge/dvbridge_fel.c | 32 +++++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index cfefe18..cce8c0e 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -262,6 +262,13 @@ struct dvbridge_fel {
     struct dvbridge_fel_wait wait; /* what the layer met while it waited for a picture to start at */
     struct { int64_t identity, carrier; struct dvbridge_fel_rpu rpu; } early[EARLY_MAX];
     unsigned num_early;
+    /* Hades: the picture order of an access unit of the layer is read with the parameter sets of the layer: those
+     * of its own configuration (layer_config: the stream gives one), or those its access units brought since the
+     * parser started (layer_sets). Without them the parser has those of the base layer (dovi_split gives the
+     * configuration of the base layer to the layer that has none), with which a picture order count can be read
+     * wrong; no count is made of it (rank_try()), nor is an access unit placed by it. */
+    bool layer_config;
+    unsigned layer_sets; /* 1: a sequence parameter set came, 2: a picture one */
 };
 
 /* Hades: whether two times are the same but for what a time may lose on its way here. */
@@ -567,6 +574,15 @@ static int picture_type(const uint8_t *data, int size, int length_size)
     return type;
 }
 
+/* Hades: the parameter sets in an access unit: 1 for a sequence parameter set, 2 for a picture one */
+static bool parameter_set_unit(const uint8_t *unit, size_t size, void *context)
+{
+    unsigned *sets = context;
+    const int type = size >= 2 ? unit[0] >> 1 & 0x3f : -1;
+    *sets |= (type == 33 ? 1u : 0u) | (type == 34 ? 2u : 0u);
+    return true;
+}
+
 static bool random_access_type(int type)
 {
     return type >= 16 && type <= 23;
@@ -784,6 +800,7 @@ void dvbridge_fel_reset(struct dvbridge_fel *f)
      * whose time is known stay for the base pictures that are still to come) */
     memset(&f->rank, 0, sizeof(f->rank));
     early_forget(f);
+    f->layer_sets = 0; /* (the parsers start again, below) */
     f->synchronizing = true;
     f->anchor_pts = AV_NOPTS_VALUE;
     f->preroll_packets = 0;
@@ -847,6 +864,9 @@ struct dvbridge_fel *dvbridge_fel_create(const AVCodecParameters *p, AVRational
     f->last_base = AV_NOPTS_VALUE;
     for (unsigned i = 0; i < BASE_TIMES_MAX; ++i)
         f->recent[i].pts = AV_NOPTS_VALUE;
+    const AVPacketSideData *config =
+        av_packet_side_data_get(p->coded_side_data, p->nb_coded_side_data, AV_PKT_DATA_HEVC_CONF);
+    f->layer_config = config && config->size >= 23; /* (what dovi_split takes as the layer's) */
     /* Hades: the RPU stays with the enhancement access unit (el_rpu), and the decoder attaches
      * it to the enhancement picture: it is the metadata of that picture, which is not the base
      * picture of the same packet when the layers are coded in different picture order. */
@@ -1263,6 +1283,12 @@ bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
         }
         const int layer_type = picture_type(copy->data, copy->size, f->layer_length_size);
         layer_pictures += layer_type >= 0;
+        /* Hades: the parameter sets of the layer, when its access units bring them (the parser reads them before
+         * the picture of the same access unit) */
+        if (f->layer_sets != 3)
+            dvbridge_rpu_units(copy->data, (size_t)copy->size, f->layer_length_size, parameter_set_unit,
+                               &f->layer_sets);
+        const bool own_sets = f->layer_config || f->layer_sets == 3;
         if (f->num_packets == QUEUE_MAX || copy->size <= 0 ||
             (size_t)copy->size > PACKET_BYTES_MAX - f->packet_bytes) {
             av_packet_free(&copy);
@@ -1365,8 +1391,8 @@ bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
                 early_forget(f);
                 prune_times(f, base_identity);
                 memset(&f->rank, 0, sizeof(f->rank));
-            } else if (f->rank.pending ||
-                       (f->rank.valid && ep->key_frame == 1 && random_access_type(layer_type))) {
+            } else if (f->rank.pending || (f->rank.valid && own_sets && ep->key_frame == 1 &&
+                                           random_access_type(layer_type))) {
                 /* Hades: a random-access picture of the layer that it does not share with the base layer,
                  * where the base layer may reorder its pictures: queued, and not decoded, until its place
                  * is known (rank_try()); and what comes after it, its leading pictures counted */
@@ -1385,7 +1411,7 @@ bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
             } else {
                 /* Hades: its RPU stays, for its base picture once the layer has started */
                 struct dvbridge_fel_rpu own;
-                if (f->rank.valid && layer_rpu(f, copy, &own))
+                if (f->rank.valid && own_sets && layer_rpu(f, copy, &own))
                     early_add(f, f->packet_order[f->num_packets], packet->pts, &own);
                 av_packet_free(&copy);
                 if (!f->rank.valid)
-- 
