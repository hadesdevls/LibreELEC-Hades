From 81c1d2e1a2eb7daeb28c80a8ce2a91d8262f1206 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:22:20 +0000
Subject: [PATCH] video library: a .strm that names one file the library can
 read is read when it is scanned

CDVDFileInfo::StrmTarget(): a .strm that names one file, without the
properties of an add-on that plays it (#KODIPROP), which CanExtract()
allows (here or on the home network: not a stream of the Internet, an
add-on's item, a disc or another playlist), is read as that file when the
library scans it, so its details are there before it is played. Only the
.strm itself is read to know that, and only where it is not on the
Internet; the thumbnail loader still does not read a .strm. External
subtitles are looked for next to the .strm, as its playback does
(CFileItem::GetSubtitleAnchorPath()).
---
 xbmc/cores/VideoPlayer/DVDFileInfo.cpp | 44 +++++++++++++++++++++++---
 xbmc/cores/VideoPlayer/DVDFileInfo.h   | 14 ++++++++
 2 files changed, 54 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
index 5007b38..ba54402 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
@@ -17,6 +17,7 @@
 #include "guilib/Texture.h"
 #include "network/NetworkFileItemClassify.h"
 #include "playlists/PlayListFileItemClassify.h"
+#include "playlists/PlayListM3U.h"
 #include "pvr/utils/PVRStreamUtils.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/SettingsComponent.h"
@@ -612,6 +613,35 @@ bool CDVDFileInfo::CanExtract(const CFileItem& fileItem)
   return true;
 }
 
+std::string CDVDFileInfo::StrmTarget(const std::string& path)
+{
+  if (!CFileItem(path, false).IsStrm() || URIUtils::IsPlugin(path) ||
+      URIUtils::IsUPnP(path) || URIUtils::IsInternetStream(path) ||
+      ((URIUtils::IsFTP(path) || URIUtils::IsHTTP(path)) && URIUtils::IsRemote(path) &&
+       !URIUtils::IsOnLAN(path)))
+    return {};
+
+  PLAYLIST::CPlayListM3U strm;
+  if (!strm.Load(path) || strm.size() != 1)
+    return {};
+  const std::shared_ptr<CFileItem> entry = strm[0];
+  if (!entry)
+    return {};
+  // (a playlist marks every entry as playable and with its folder; any other property comes from
+  // the .strm: #KODIPROP for an add-on that plays it, a start or end offset, subtitles)
+  for (const auto& [key, value] : entry->GetProperties())
+  {
+    if (key != "IsPlayable" && key != "BasePath")
+      return {};
+  }
+  const CFileItem target(entry->GetPath(), false);
+  if (!CanExtract(target))
+    return {};
+  CLog::LogF(LOGDEBUG, "{} names {}, whose video is read", CURL::GetRedacted(path),
+             CURL::GetRedacted(target.GetPath()));
+  return target.GetPath();
+}
+
 /**
  * \brief Open the item pointed to by pItem and extract streamdetails
  * \return true if the stream details have changed
@@ -621,9 +651,6 @@ bool CDVDFileInfo::GetFileStreamDetails(CFileItem* pItem, const std::atomic<bool
   if (!pItem)
     return false;
 
-  if (!CanExtract(*pItem))
-    return false;
-
   std::string strFileNameAndPath;
   if (pItem->HasVideoInfoTag())
     strFileNameAndPath = pItem->GetVideoInfoTag()->m_strFileNameAndPath;
@@ -631,7 +658,16 @@ bool CDVDFileInfo::GetFileStreamDetails(CFileItem* pItem, const std::atomic<bool
   if (strFileNameAndPath.empty())
     strFileNameAndPath = pItem->GetDynPath();
 
-  std::string playablePath = strFileNameAndPath;
+  // Hades: a .strm that names one file that can be read is read as that file (StrmTarget())
+  std::string strmTarget;
+  if (!CanExtract(*pItem))
+  {
+    strmTarget = StrmTarget(strFileNameAndPath);
+    if (strmTarget.empty())
+      return false;
+  }
+
+  std::string playablePath = strmTarget.empty() ? strFileNameAndPath : strmTarget;
   if (URIUtils::IsStack(playablePath))
     playablePath = XFILE::CStackDirectory::GetFirstStackedFile(playablePath);
 
diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.h b/xbmc/cores/VideoPlayer/DVDFileInfo.h
index 485c97d..2d8b8b2 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.h
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.h
@@ -49,6 +49,20 @@ public:
   */
   static bool CanExtract(const CFileItem& fileItem);
 
+  /*!
+   * \brief Hades: the file that a .strm names, where its video is read as that file's would be
+   *
+   * A .strm (a playlist) is not read as a video (CanExtract()). One that names one file, without
+   * properties for an add-on that plays it (#KODIPROP), which CanExtract() allows (a file here
+   * or on the network of the home: not a stream of the Internet, an add-on's item or a disc),
+   * is read as that file, when the library scans it. Only the .strm itself is read to know
+   * that, and only where it is not on the Internet.
+   * \param path the .strm (the file that is read for the details: the item of a scan can be the
+   *        folder of a movie, whose file is the .strm)
+   * \return the path of that file, or empty
+   */
+  static std::string StrmTarget(const std::string& path);
+
   /*!
    * @brief Probe the files streams and store the info in the VideoInfoTag
    * @param stop Hades: when it becomes true, from any thread, the open, the seek and the reads of
-- 
