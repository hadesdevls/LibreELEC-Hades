From 220a783681e1244c8a8379bacf999c6af00c0178 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:00:42 +0000
Subject: [PATCH] tools/dvbridge: map a rebuilt picture to an SDR output

The mapping of a reconstructed Dolby Vision picture to a display (the
projector mode) wrote it in the PQ signal of HDR10 only. A stream whose base
layer is no picture by itself (profile 5, in IPTPQc2) has nothing else to show
on an output that takes no HDR10: there Kodi shows that base layer as a YCbCr
picture, in green and purple.

struct dvbridge_hdr10_mapping gets a target: HDR10 (0, what every caller that
does not set it gets) or SDR. dvbridge_sdr_mapping() makes the SDR one: the
picture goes to what every SDR picture of Kodi's is, BT.709 primaries and the
BT.1886 EOTF of a reference display (black at zero, so a pure 2.4 power), with
its white at 203 cd/m2 of the source (the reference white of ITU-R BT.2408,
libplacebo's PL_COLOR_SDR_WHITE), by the curve and the gamut mapping of the
mapping to a display: BT.2390, guided by each scene's level 1 metadata, and the
perceptual gamut mapping into BT.709. Such a mapping is valid in BT.709 only.
The picture is held within [0, 1]: the peak hook of an HDR10 display does not
apply, the peak of an SDR signal being 1.0. An SDR output is told no HDR10
metadata (dvbridge_hdr10_static_mapped() refuses it). The picture is drawn into
the two textures of the conversion to HDR10, as an HDR10 one is.

Measured on the software OpenGL ES (zink on lavapipe) with a real profile 5 RPU
(the test asset source_p5_to_p8_001_end_crc32.bin of dovi_tool, parsed by
FFmpeg's own RPU parser: eight polynomial luma pieces, linear chroma, the IPT
matrices of profile 5) and profile 5 base layers made from a test chart (a
neutral ramp, the ColorChecker at 203 and at 1015 cd/m2, the hues of BT.2020's
edge up to 1000 cd/m2) and from two pictures of the FEL test stream, against a
reference in double precision: a reconstruction by the composition of ETSI GS
CCM 001, then libplacebo's colour mapping written out on the processor pixel by
pixel with its exact curve and gamut mapping. Delta E ITP (ITU-R BT.2124) on an
SDR display of 100 cd/m2: median 0.03 to 0.11, 99.9 % 0.41 to 1.27, at most
2.2, in the most saturated colours at the edge of BT.2020 at hundreds of cd/m2
(libplacebo's 48x32x256 gamut table, read with linear interpolation: a table of
96x64x512 brings the most to 1.1). In 8-bit codes, 1.1 % (stream) to 10.7 %
(chart) of the values one code off the reference. With the mapping off, and
with an HDR10 mapping, the bridge gives the same bytes as before.
---
 tools/dvbridge/dvbridge_placebo.c | 30 +++++++++++++++++++++++++++++-
 tools/dvbridge/dvbridge_placebo.h | 30 ++++++++++++++++++++++++++----
 tools/dvbridge/dvbridge_render.c  | 20 +++++++++++++++-----
 tools/dvbridge/dvbridge_render.h  |  4 +++-
 4 files changed, 73 insertions(+), 11 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index 4598424..9463c11 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -75,6 +75,10 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
         return false;
     if (m->curve != DVBRIDGE_HDR10_CURVE_SPLINE && m->curve != DVBRIDGE_HDR10_CURVE_BT2390)
         return false;
+    /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
+    if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 &&
+        (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamut != DVBRIDGE_HDR10_GAMUT_BT709))
+        return false;
     if (m->source_known) {
         for (int i = 0; i < 8; ++i)
             if (!(m->source_xy[i] > 0.0f && m->source_xy[i] < 1.0f))
@@ -88,10 +92,34 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     return true;
 }
 
+struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy)
+{
+    struct dvbridge_hdr10_mapping m = {
+        .enabled = true,
+        .peak = DVBRIDGE_SDR_WHITE,
+        .gamut = DVBRIDGE_HDR10_GAMUT_BT709,
+        .curve = DVBRIDGE_HDR10_CURVE_BT2390,
+        .target = DVBRIDGE_HDR10_TARGET_SDR,
+    };
+    if (source_xy) {
+        m.source_known = true;
+        for (int i = 0; i < 8; ++i)
+            m.source_xy[i] = source_xy[i];
+        /* primaries that are no gamut are not used: then the BT.2020 of the signal */
+        if (!dvbridge_hdr10_mapping_valid(&m)) {
+            m.source_known = false;
+            for (int i = 0; i < 8; ++i)
+                m.source_xy[i] = 0.0f;
+        }
+    }
+    return m;
+}
+
 bool dvbridge_hdr10_static_mapped(struct dvbridge_hdr10_static *out, const void *metadata,
                                   size_t bytes, const struct dvbridge_hdr10_mapping *m)
 {
-    if (!out || !m || !m->enabled || !dvbridge_hdr10_mapping_valid(m))
+    if (!out || !m || !m->enabled || m->target != DVBRIDGE_HDR10_TARGET_HDR10 ||
+        !dvbridge_hdr10_mapping_valid(m))
         return false;
     struct dvbridge_hdr10_static source;
     if (!dvbridge_hdr10_static(&source, metadata, bytes))
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index 5f41518..2d8d29b 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -45,19 +45,41 @@ enum dvbridge_hdr10_curve {
 };
 #define DVBRIDGE_HDR10_PEAK_MIN 10.0f
 #define DVBRIDGE_HDR10_PEAK_MAX 10000.0f
+/* Hades: the signal the mapped picture is written in. HDR10 (the default, 0): PQ in BT.2020, for a
+ * display of the peak and gamut below. SDR: for an output that takes no HDR10 (an SDR display or
+ * the panel of a laptop, or HDR turned off), what every SDR picture of Kodi's is there: BT.709
+ * primaries and the BT.1886 EOTF of a reference display (black at zero, a pure 2.4 power), its
+ * white at the peak, in the gamut BT.709. That is what the picture of a stream whose base layer is
+ * no picture by itself (profile 5) needs there: without it, nothing but that base layer, in the
+ * wrong colours. */
+#define DVBRIDGE_SDR_MAPPING 1
+enum dvbridge_hdr10_target {
+    DVBRIDGE_HDR10_TARGET_HDR10 = 0,
+    DVBRIDGE_HDR10_TARGET_SDR = 1,
+};
+/* The white of an SDR output in cd/m2 of the source, for DVBRIDGE_HDR10_TARGET_SDR: the reference
+ * white of ITU-R BT.2408, which an SDR picture's white stands for in its conversions (libplacebo's
+ * PL_COLOR_SDR_WHITE). A scene that is no brighter goes out as mastered. */
+#define DVBRIDGE_SDR_WHITE 203.0f
 struct dvbridge_hdr10_mapping {
     bool enabled;
-    float peak;                      /* of the display, cd/m2 */
-    enum dvbridge_hdr10_gamut gamut; /* of the display, inside the BT.2020 signal */
+    float peak;                      /* of the display, cd/m2 (for SDR, its white) */
+    enum dvbridge_hdr10_gamut gamut; /* of the display, inside the BT.2020 signal (SDR: BT.709) */
     enum dvbridge_hdr10_curve curve;
     /* The gamut of the mastering display, when its metadata gives it (the HDR10 metadata of the
      * stream): where the colours of the picture can be at all. CIE 1931 xy of red, green, blue
      * and white. Not known: the BT.2020 of the signal. */
     bool source_known;
     float source_xy[8];
+    /* Hades: the signal of the mapped picture (0, HDR10, where nothing sets it) */
+    enum dvbridge_hdr10_target target;
 };
-/* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use. */
+/* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
+ * one in the gamut BT.709 only). */
 bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m);
+/* Hades: the mapping of a picture to an SDR output: on, to DVBRIDGE_SDR_WHITE, in BT.709, with the
+ * BT.2390 curve. source_xy as for any mapping (NULL: not known). */
+struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy);
 /* The primaries and white (CIE 1931 xy: red, green, blue, white) of a display gamut. */
 bool dvbridge_hdr10_gamut_xy(enum dvbridge_hdr10_gamut gamut, float xy[8]);
 /* What an HDR10 output is told of a picture mapped to the display (m on): the display's peak as
@@ -65,7 +87,7 @@ bool dvbridge_hdr10_gamut_xy(enum dvbridge_hdr10_gamut gamut, float xy[8]);
  * source as dvbridge_hdr10_static() gives it (black is not mapped), MaxFALL not known (the
  * mapping changes the average of each frame, which is not measured). The primaries to send are
  * those of m->gamut (dvbridge_hdr10_gamut_xy()). False where dvbridge_hdr10_static() is, or for a
- * mapping that is off or not valid. */
+ * mapping that is off, not valid, or to an SDR output (which is told no HDR metadata). */
 bool dvbridge_hdr10_static_mapped(struct dvbridge_hdr10_static *out, const void *metadata,
                                   size_t bytes, const struct dvbridge_hdr10_mapping *m);
 
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b23e3a7..67a6161 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1036,7 +1036,11 @@ bool dvbridge_render_hdr10_mapping(struct dvbridge_renderer *r,
  * cd/m2). The display's black is not known, and the picture's black is to go out as mastered:
  * both sides are given PQ black (PL_COLOR_HDR_BLACK, "infinite contrast"). The rest is
  * libplacebo's defaults: no measurement of the picture (the renderer is given none), no inverse
- * tone mapping, no expansion of the gamut. */
+ * tone mapping, no expansion of the gamut.
+ * Hades: to an SDR output (DVBRIDGE_HDR10_TARGET_SDR) the target is the signal of every SDR
+ * picture there instead: BT.709, the BT.1886 EOTF with its white at the peak, black at zero
+ * (the same "infinite contrast": BT.1886 is then a pure 2.4 power). The same curve and gamut
+ * mapping take the picture into it. */
 static void map_to_display(const struct dvbridge_hdr10_mapping *m, struct pl_color_space *source,
                            struct pl_color_space *target, struct pl_color_map_params *params)
 {
@@ -1047,9 +1051,10 @@ static void map_to_display(const struct dvbridge_hdr10_mapping *m, struct pl_col
     source->hdr.min_luma = PL_COLOR_HDR_BLACK;
     float xy[8];
     dvbridge_hdr10_gamut_xy(m->gamut, xy);
+    const bool sdr = m->target == DVBRIDGE_HDR10_TARGET_SDR;
     *target = (struct pl_color_space){
-        .primaries = PL_COLOR_PRIM_BT_2020,
-        .transfer = PL_COLOR_TRC_PQ,
+        .primaries = sdr ? PL_COLOR_PRIM_BT_709 : PL_COLOR_PRIM_BT_2020,
+        .transfer = sdr ? PL_COLOR_TRC_BT_1886 : PL_COLOR_TRC_PQ,
         .hdr = {.min_luma = PL_COLOR_HDR_BLACK, .max_luma = m->peak,
                 .prim = {.red = {xy[0], xy[1]}, .green = {xy[2], xy[3]}, .blue = {xy[4], xy[5]},
                          .white = {xy[6], xy[7]}}},
@@ -1154,16 +1159,21 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     params.hooks = hooks;
     params.num_hooks = 1;
     /* Hades: or mapped to the display, where that is asked for (dvbridge_render_hdr10_mapping()),
-     * and then held within its peak */
+     * and then held within its peak (in an SDR signal the peak is 1.0, which the clamp to [0, 1]
+     * holds it within) */
     struct pl_color_map_params mapping;
     struct display_clamp to_display = {0};
     const struct pl_hook display_hook = {
         .stages = PL_HOOK_OUTPUT, .input = PL_HOOK_SIG_COLOR, .priv = &to_display,
         .hook = clamp_to_display, .signature = 0x4456424844523131ULL};
     const struct pl_hook *display_hooks[] = {&display_hook};
+    const bool peak_hook =
+        r->hdr10_mapping.enabled && r->hdr10_mapping.target != DVBRIDGE_HDR10_TARGET_SDR;
     if (r->hdr10_mapping.enabled) {
         map_to_display(&r->hdr10_mapping, &image.color, &target.color, &mapping);
         params.color_map_params = &mapping;
+    }
+    if (peak_hook) {
         to_display.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->hdr10_mapping.peak);
         params.hooks = display_hooks;
     }
@@ -1172,7 +1182,7 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     if (into == r->hdr10_shown)
         r->hdr10_whole = false;
     bool ok = pl_render_image(r->renderer, &image, &target, &params) &&
-              (r->hdr10_mapping.enabled ? to_display.called : clamped);
+              (peak_hook ? to_display.called : clamped);
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
     ok = ok && !(errors.errors & ~PL_RENDER_ERR_DOVI_COMPOSER) && !errors.num_disabled_hooks;
     if (ok) {
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 16695fa..cc167af 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -81,7 +81,9 @@ struct dvbridge_renderer *dvbridge_renderer_create_hdr10(pl_gpu gpu, pl_log log)
 /* Hades: the mapping of the following dvbridge_render_hdr10() pictures to the display
  * (struct dvbridge_hdr10_mapping, dvbridge_placebo.h). A renderer starts with it off, which draws
  * the picture as it always has. NULL turns it off. A mapping that is not valid is not taken: it
- * turns it off, and the call returns false. */
+ * turns it off, and the call returns false. Hades: a mapping to an SDR output
+ * (DVBRIDGE_HDR10_TARGET_SDR) makes the texture of dvbridge_render_hdr10() hold that signal,
+ * BT.709 with the BT.1886 EOTF, instead of PQ in BT.2020. */
 #define DVBRIDGE_HDR10_MAPPING 1
 struct dvbridge_hdr10_mapping;
 bool dvbridge_render_hdr10_mapping(struct dvbridge_renderer *renderer,
-- 
2.53.0

