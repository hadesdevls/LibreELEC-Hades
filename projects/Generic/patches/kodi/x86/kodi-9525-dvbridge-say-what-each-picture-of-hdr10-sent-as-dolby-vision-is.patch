From 95e2ce1d0c2cee3018e90e2c01fb308644794221 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:07 +0000
Subject: [PATCH] dvbridge: say what each picture of HDR10+ sent as Dolby
 Vision is

dvbridge_hdr10plus_next() gives a picture without HDR10+ statistics of its
own the metadata made last, as a repeated RPU, and nothing tells whether the
picture had HDR10+ metadata from which no level 1 block can be made (no
distribution, percentiles that go down, no mastering display) or no HDR10+
metadata at all, nor where the scenes of such pictures start.

dvbridge_hdr10plus_next_of() makes the same metadata, byte for byte, and also
says what the picture is: OWN (its metadata are made of its own statistics),
INCOMPLETE (it has HDR10+ metadata, none can be made of them) or NONE (it has
none), with CUT on the first picture of a scene of its HDR10+ metadata: for one
of its own, the picture whose metadata carry the scene refresh; for an
incomplete one, metadata that are another scene than those of the last picture
that had any, as dvbridge_hdr10plus_same_scene() tells. A picture without
HDR10+ metadata never has CUT: nothing in it tells a scene.

The window system measures the pictures that are not of their own statistics
(CDVHdr10PlusFill, in a commit after this one). The HDR10+ metadata of the last
picture that had any are kept in the scene state for that; the reset clears
them with the rest.
---
 tools/dvbridge/dvbridge_hdr10plus.c | 30 +++++++++++++++++++++++++++++
 tools/dvbridge/dvbridge_hdr10plus.h | 19 ++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/tools/dvbridge/dvbridge_hdr10plus.c b/tools/dvbridge/dvbridge_hdr10plus.c
index 55f8b8c..9dc41b6 100644
--- a/tools/dvbridge/dvbridge_hdr10plus.c
+++ b/tools/dvbridge/dvbridge_hdr10plus.c
@@ -341,6 +341,10 @@ struct dvbridge_hdr10plus_scene {
     AVDOVIMetadata *first; /* those metadata, with a scene refresh: what the first picture of the scene gets */
     AVDOVIMetadata *made;  /* ... and without one: what the next pictures get */
     size_t size;
+    /* the HDR10+ metadata of the last picture that had any, whether metadata could be made of them or not
+     * (dvbridge_hdr10plus_next_of()) */
+    AVDynamicHDRPlus seen;
+    bool have_seen;
 };
 
 struct dvbridge_hdr10plus_scene *dvbridge_hdr10plus_scene_create(void)
@@ -404,6 +408,32 @@ const AVDOVIMetadata *dvbridge_hdr10plus_next(struct dvbridge_hdr10plus_scene *s
     return s->made;
 }
 
+const AVDOVIMetadata *dvbridge_hdr10plus_next_of(struct dvbridge_hdr10plus_scene *s,
+                                                 const AVDynamicHDRPlus *hdr10plus,
+                                                 const AVMasteringDisplayMetadata *mastering,
+                                                 const AVContentLightMetadata *light, size_t *size,
+                                                 bool *repeated, unsigned *of)
+{
+    const AVDOVIMetadata *made = dvbridge_hdr10plus_next(s, hdr10plus, mastering, light, size, repeated);
+    if (!s)
+        return made;
+    if (of) {
+        if (!hdr10plus)
+            *of = DVBRIDGE_HDR10PLUS_NONE;
+        else if (made && repeated && !*repeated)
+            /* (made of them: the first picture of a scene has the metadata with the scene refresh) */
+            *of = DVBRIDGE_HDR10PLUS_OWN | (made == s->first ? DVBRIDGE_HDR10PLUS_CUT : 0);
+        else
+            *of = DVBRIDGE_HDR10PLUS_INCOMPLETE |
+                  (!s->have_seen || !dvbridge_hdr10plus_same_scene(&s->seen, hdr10plus) ? DVBRIDGE_HDR10PLUS_CUT : 0);
+    }
+    if (hdr10plus) {
+        s->seen = *hdr10plus;
+        s->have_seen = true;
+    }
+    return made;
+}
+
 void dvbridge_hdr10plus_units(const uint8_t *data, size_t size, int length_size,
                               bool (*found)(const uint8_t *unit, size_t size, void *context), void *context)
 {
diff --git a/tools/dvbridge/dvbridge_hdr10plus.h b/tools/dvbridge/dvbridge_hdr10plus.h
index 369502e..729a16e 100644
--- a/tools/dvbridge/dvbridge_hdr10plus.h
+++ b/tools/dvbridge/dvbridge_hdr10plus.h
@@ -96,6 +96,25 @@ const AVDOVIMetadata *dvbridge_hdr10plus_next(struct dvbridge_hdr10plus_scene *s
                                               const AVContentLightMetadata *light, size_t *size,
                                               bool *repeated);
 
+/* What a picture is, for HDR10+ sent as Dolby Vision where the stream's statistics are missing (the window system
+ * measures those pictures: CDVHdr10PlusFill): its metadata are made from its own HDR10+ metadata (OWN); it has HDR10+
+ * metadata from which none can be made (INCOMPLETE: no level 1 block, dvbridge_hdr10plus_level1(), or no luminance of
+ * the mastering display); it has no HDR10+ metadata (NONE). With CUT, the picture is the first of a scene of its HDR10+
+ * metadata: for one of its own, its metadata carry the scene refresh; for an incomplete one, its HDR10+ metadata are
+ * another scene (dvbridge_hdr10plus_same_scene()) than those of the last picture that had any, or none had any since
+ * the last reset. Never for one without: nothing there tells a scene. */
+#define DVBRIDGE_HDR10PLUS_OWN 1u
+#define DVBRIDGE_HDR10PLUS_INCOMPLETE 2u
+#define DVBRIDGE_HDR10PLUS_NONE 3u
+#define DVBRIDGE_HDR10PLUS_KIND 0x0fu
+#define DVBRIDGE_HDR10PLUS_CUT 0x10u
+/* dvbridge_hdr10plus_next(), the same metadata, and *of (may be NULL) what the picture is (above) */
+const AVDOVIMetadata *dvbridge_hdr10plus_next_of(struct dvbridge_hdr10plus_scene *scene,
+                                                 const AVDynamicHDRPlus *hdr10plus,
+                                                 const AVMasteringDisplayMetadata *mastering,
+                                                 const AVContentLightMetadata *light, size_t *size,
+                                                 bool *repeated, unsigned *of);
+
 /* The units of an access unit (a length of length_size bytes before each, or start codes with 0), each to
  * found(unit, size, context) from its header, until it returns false (dvbridge_rpu_units()): for the probe of a
  * stream's HDR10+ metadata, which reads its SEI with Kodi's own parser. */
-- 
2.53.0

