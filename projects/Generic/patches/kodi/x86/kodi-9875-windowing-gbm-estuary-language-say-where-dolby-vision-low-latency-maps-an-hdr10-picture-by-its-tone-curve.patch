--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -26965,7 +26965,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadesdvfromhdr10plus"
 #: system/settings/settings.xml
 msgctxt "#40923"
-msgid "For a TV that supports Dolby Vision but not HDR10+. An HDR10+ video is sent as Dolby Vision, with metadata made from its own HDR10+ data, scene by scene (the peak and the average brightness of each scene). The picture is the same HDR10 picture. What does not carry over from HDR10+: the tone curve and the target display that the studio chose, its saturation weight and its windows. Dolby Vision videos, HDR10 videos without HDR10+ and displays that take HDR10+ are not affected. Off by default. Takes effect from the next video."
+msgid "For a TV that supports Dolby Vision but not HDR10+. An HDR10+ video is sent as Dolby Vision, with metadata made from its own HDR10+ data, scene by scene (the peak and the average brightness of each scene). The picture is the same HDR10 picture. What does not carry over from HDR10+: the tone curve and the target display that the studio chose, its saturation weight and its windows; in Dolby Vision Low-Latency (game mode), where Hades adapts each picture to the TV itself, the studio's tone curve is applied. Dolby Vision videos, HDR10 videos without HDR10+ and displays that take HDR10+ are not affected. Off by default. Takes effect from the next video."
 msgstr ""
 
