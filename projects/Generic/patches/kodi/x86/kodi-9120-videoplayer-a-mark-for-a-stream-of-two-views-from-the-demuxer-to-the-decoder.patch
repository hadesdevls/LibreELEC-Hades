From e7419d926fe83bd418d56402efd19372af518401 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:15:43 +0000
Subject: [PATCH] VideoPlayer: a mark for a stream of two views, from the
 demuxer to the decoder

A video that codes its two eyes as two views (H.264 MVC) needs a
decoder of its own and gives two pictures for each access unit, which
have to become one. What opens a decoder knows a stream by the stream
information that the demuxer fills in, and that had no word for it.

The stream of the demuxer and the stream information get the mark
"multiview", with the eye of the base view ("multiviewBaseRight"). It
is copied with the rest of the information and is part of what makes
two streams differ, so that a stream which gains or loses it gets its
decoder opened again.

Nothing sets the mark yet and nothing reads it: no stream is treated
differently.

A mark of this kind, carried through the stream and the hints, is what
Dom Cobley (popcornmix) uses in his Kodi branch
fix-stereoscopic-3d-gbm-upstream; the code here is written anew.

Read and compiled.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h |  5 +++++
 xbmc/cores/VideoPlayer/DVDStreamInfo.cpp      | 10 +++++++++-
 xbmc/cores/VideoPlayer/DVDStreamInfo.h        |  4 ++++
 3 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
index c256e06..3a6dcb3 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
@@ -177,6 +177,11 @@ public:
   std::shared_ptr<AVContentLightMetadata> contentLightMetaData;
 
   std::string stereo_mode; // expected stereo mode
+  //! Hades: the two eyes are coded as two views (H.264 MVC), which a decoder of its own gives
+  //! and which go on as one picture, side by side (see KODI::MULTIVIEW); stereo_mode says that
+  //! picture
+  bool multiview = false;
+  bool multiviewBaseRight = false; //!< ... and the base view is the right eye
   StreamHdrType hdr_type = StreamHdrType::HDR_TYPE_NONE; // type of HDR for this stream (hdr10, etc)
   AVDOVIDecoderConfigurationRecord dovi{};
 #ifdef HAVE_DVBRIDGE
diff --git a/xbmc/cores/VideoPlayer/DVDStreamInfo.cpp b/xbmc/cores/VideoPlayer/DVDStreamInfo.cpp
index 1216cf6..ac334cc 100644
--- a/xbmc/cores/VideoPlayer/DVDStreamInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDStreamInfo.cpp
@@ -71,6 +71,8 @@ void CDVDStreamInfo::Clear()
   masteringMetadata = nullptr;
   contentLightMetadata = nullptr;
   stereo_mode.clear();
+  multiview = false;
+  multiviewBaseRight = false;
   dovi = {};
 #ifdef HAVE_DVBRIDGE
   doviELConfig = {};
@@ -124,7 +126,9 @@ bool CDVDStreamInfo::Equal(const CDVDStreamInfo& right, int compare)
   || colorRange != right.colorRange
   || colorPrimaries != right.colorPrimaries
   || colorTransferCharacteristic != right.colorTransferCharacteristic
-  || stereo_mode != right.stereo_mode)
+  || stereo_mode != right.stereo_mode
+  || multiview != right.multiview
+  || multiviewBaseRight != right.multiviewBaseRight)
     return false;
   // clang-format on
 
@@ -248,6 +252,8 @@ void CDVDStreamInfo::Assign(const CDVDStreamInfo& right, bool withextradata)
   masteringMetadata = right.masteringMetadata;
   contentLightMetadata = right.contentLightMetadata;
   stereo_mode = right.stereo_mode;
+  multiview = right.multiview;
+  multiviewBaseRight = right.multiviewBaseRight;
   dovi = right.dovi;
 #ifdef HAVE_DVBRIDGE
   doviELConfig = withextradata ? right.doviELConfig : FFmpegExtraData{};
@@ -332,6 +338,8 @@ void CDVDStreamInfo::Assign(const CDemuxStream& right, bool withextradata)
     masteringMetadata = stream->masteringMetaData;
     contentLightMetadata = stream->contentLightMetaData;
     stereo_mode = stream->stereo_mode;
+    multiview = stream->multiview;
+    multiviewBaseRight = stream->multiviewBaseRight;
     dovi = stream->dovi;
 #ifdef HAVE_DVBRIDGE
     doviELConfig = withextradata ? stream->doviELConfig : FFmpegExtraData{};
diff --git a/xbmc/cores/VideoPlayer/DVDStreamInfo.h b/xbmc/cores/VideoPlayer/DVDStreamInfo.h
index 26d1b64..5168a57 100644
--- a/xbmc/cores/VideoPlayer/DVDStreamInfo.h
+++ b/xbmc/cores/VideoPlayer/DVDStreamInfo.h
@@ -86,6 +86,10 @@ public:
   std::shared_ptr<AVMasteringDisplayMetadata> masteringMetadata;
   std::shared_ptr<AVContentLightMetadata> contentLightMetadata;
   std::string stereo_mode; // stereoscopic 3d mode
+  //! Hades: the two eyes are coded as two views (H.264 MVC), decoded by a decoder of its own
+  //! and put side by side (see KODI::MULTIVIEW); and whether the base view is the right eye
+  bool multiview{false};
+  bool multiviewBaseRight{false};
   AVDOVIDecoderConfigurationRecord dovi{};
 #ifdef HAVE_DVBRIDGE
   FFmpegExtraData doviELConfig;
-- 
