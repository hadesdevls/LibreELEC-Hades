From 85b00a4b480357e48110ab49eb6e640cfb8496d8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 02:44:06 +0000
Subject: [PATCH] DVDFactoryDemuxer: a disc whose base view does not open is
 not opened a second time

When CDVDDemuxBluray3D did not open, the disc went on to the demuxer of every disc, "to play
the base view on its own rather than failing outright". That demuxer does not open in two
cases only. The base view did not open: this is the demuxer of every disc on the same input,
which had been read by then, so the second try started wherever the first one left the disc.
There is none now, and the answer is the one that the demuxer of every disc gives when it
does not open. Or the decoder of both views is not there: nothing was read of the disc then,
and it goes on as before.

The four includes that nothing uses since the playback mode is asked elsewhere are gone.
---
 .../DVDDemuxers/DVDFactoryDemuxer.cpp         | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
index 54360cc..d98f559 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
@@ -21,10 +21,6 @@
 #include "DVDDemuxBluray3D.h"
 #include "DVDInputStreams/DVDInputStreamBluray.h"
 #include "cores/VideoPlayer/MultiviewChoice.h"
-#include "ServiceBroker.h"
-#include "guilib/StereoscopicsManager.h"
-#include "settings/Settings.h"
-#include "settings/SettingsComponent.h"
 #endif
 
 CDVDDemux* CDVDFactoryDemuxer::CreateDemuxer(const std::shared_ptr<CDVDInputStream>& pInputStream,
@@ -104,9 +100,19 @@ CDVDDemux* CDVDFactoryDemuxer::CreateDemuxer(const std::shared_ptr<CDVDInputStre
       if (demuxer->Open(pInputStream))
         return demuxer.release();
 
-      // Fall through and play the base view on its own rather than failing outright.
-      CLog::Log(LOGWARNING,
-                "DVDFactoryDemuxer: could not open the dependent view, playing in 2D.");
+      // Hades: that demuxer does not open in two cases only. The base view did not open: that
+      // is the demuxer below on the same input, which has been read by now. A second try
+      // would start wherever the first one left the disc, so there is none, and the answer is
+      // the one that the demuxer below gives when it does not open. Or this build has no
+      // decoder of both views (it had one when the disc was opened): nothing was read of the
+      // disc then, and it goes to the demuxer below as every disc does.
+      if (demuxer->HasReadInput())
+      {
+        CLog::Log(LOGERROR, "DVDFactoryDemuxer: the base view of the disc could not be opened");
+        return nullptr;
+      }
+      CLog::Log(LOGWARNING, "DVDFactoryDemuxer: no decoder of both views; the disc is read as "
+                            "one without a second view");
     }
   }
 #endif
