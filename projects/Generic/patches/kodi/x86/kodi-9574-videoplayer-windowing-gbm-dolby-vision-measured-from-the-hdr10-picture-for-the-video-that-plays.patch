+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -239,27 +239,34 @@ enum class ConversionSetting
  *
  * AUTOMATIC: as the settings say (native output where the display takes it). HDR10: never native;
  * reconstructed and sent as HDR10, whatever the stream's profile, mapped to the display where
- * that is set. KODI: never native, never reconstructed: as Kodi plays it.
+ * that is set. KODI: never native, never reconstructed: as Kodi plays it. MEASURED (Hades): native,
+ * with metadata that Hades measures from the HDR10 base layer as it plays, in place of the stream's
+ * own (its RPU and its enhancement layer are left aside), as HDR10 is sent with "HDR10 as Dolby
+ * Vision, measured"; only where the base layer is the HDR10 version of the film
+ * (MeasuredInPlaceOfOwn()). Some Blu-ray discs carry a Dolby Vision grade with flat metadata,
+ * which a user may like less than the measured one (issue #6, 2026-10-26).
  */
 enum class OutputChoice
 {
   AUTOMATIC = 0,
   HDR10 = 1,
   KODI = 2,
+  MEASURED = 3,
 };
 
 //! Native output may be had with this choice
 constexpr bool NativeAllowed(OutputChoice choice)
 {
-  return choice == OutputChoice::AUTOMATIC;
+  return choice == OutputChoice::AUTOMATIC || choice == OutputChoice::MEASURED;
 }
 
-//! What decides whether a stream is reconstructed and sent as HDR10, with this choice
+//! What decides whether a stream is reconstructed and sent as HDR10, with this choice (MEASURED:
+//! never; where native output is not to be had, its HDR10 base layer plays as Kodi plays it)
 constexpr ConversionSetting ConversionSettingFor(ConversionSetting settings, OutputChoice choice)
 {
-  return choice == OutputChoice::HDR10  ? ConversionSetting::EVERY
-         : choice == OutputChoice::KODI ? ConversionSetting::NEVER
-                                        : settings;
+  return choice == OutputChoice::HDR10                                       ? ConversionSetting::EVERY
+         : choice == OutputChoice::KODI || choice == OutputChoice::MEASURED ? ConversionSetting::NEVER
+                                                                             : settings;
 }
 
 /*!
@@ -311,13 +318,32 @@ constexpr bool BaseLayerIsHdr10(int profile, int compatibility)
  *
  * Not KODI where the base layer is no picture by itself (BaseLayerIsNoPicture()): played as Kodi
  * plays it, its colours are wrong, which is why such a stream is reconstructed where it is not
- * sent natively. Every other choice for every stream.
+ * sent natively. MEASURED only where the base layer is HDR10 (BaseLayerIsHdr10()): the measurement
+ * is of an HDR10 picture. Every other choice for every stream.
  */
 constexpr bool OutputChoiceOffered(OutputChoice choice, int profile, int compatibility)
 {
+  if (choice == OutputChoice::MEASURED)
+    return BaseLayerIsHdr10(profile, compatibility);
   return choice != OutputChoice::KODI || !BaseLayerIsNoPicture(profile, compatibility);
 }
 
+/*!
+ * \brief Hades: whether a stream that opens is measured as Dolby Vision in place of its own
+ *        metadata (OutputChoice::MEASURED): its decoder leaves its RPU and its enhancement layer
+ *        aside, and makes the metadata of each picture as for HDR10 measured as Dolby Vision
+ * \param ownDolbyVision the stream's Dolby Vision is its own: not made from its HDR10+ metadata
+ *        nor measured already (CDVDStreamInfo::doviFromHdr10Plus, doviMeasured)
+ */
+constexpr bool MeasuredInPlaceOfOwn(OutputChoice choice,
+                                    int profile,
+                                    int compatibility,
+                                    bool ownDolbyVision)
+{
+  return choice == OutputChoice::MEASURED && ownDolbyVision &&
+         BaseLayerIsHdr10(profile, compatibility);
+}
+
 /*!
  * \brief Whether a Dolby Vision stream is one that is reconstructed and sent as HDR10 where it
  *        is not sent natively
