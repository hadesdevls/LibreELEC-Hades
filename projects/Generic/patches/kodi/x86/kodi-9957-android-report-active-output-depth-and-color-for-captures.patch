From be3e5c561a4623cb768bad6947f5172711011806 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 2 Nov 2026 21:58:04 -0800
Subject: [PATCH] [Android] Report active output depth and color for captures

Query the selected EGL configuration and report the active output transfer
and primaries so HDR screenshots retain their bit depth and PQ metadata.

(cherry picked from commit 190fb2ba3b206fa9c36f6789c2b7667b8241a462)
---
 xbmc/utils/EGLUtils.cpp                         |  5 +++--
 xbmc/utils/EGLUtils.h                           |  2 +-
 .../android/WinSystemAndroidGLESContext.cpp     | 17 +++++++++++++++++
 .../android/WinSystemAndroidGLESContext.h       |  3 +++
 4 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/xbmc/utils/EGLUtils.cpp b/xbmc/utils/EGLUtils.cpp
index ebbee18..8150709 100644
--- a/xbmc/utils/EGLUtils.cpp
+++ b/xbmc/utils/EGLUtils.cpp
@@ -371,10 +371,11 @@ bool CEGLContextUtils::ChooseConfig(
   return true;
 }
 
-EGLint CEGLContextUtils::GetConfigAttrib(EGLint attribute) const
+EGLint CEGLContextUtils::GetConfigAttrib(EGLint attribute, bool hdr) const
 {
   EGLint value{0};
-  if (eglGetConfigAttrib(m_eglDisplay, m_eglConfig, attribute, &value) != EGL_TRUE)
+  if (eglGetConfigAttrib(m_eglDisplay, hdr ? m_eglHDRConfig : m_eglConfig, attribute, &value) !=
+      EGL_TRUE)
     CEGLUtils::Log(LOGERROR, "failed to query EGL attribute");
   return value;
 }
diff --git a/xbmc/utils/EGLUtils.h b/xbmc/utils/EGLUtils.h
index 206b97f..bccf330 100644
--- a/xbmc/utils/EGLUtils.h
+++ b/xbmc/utils/EGLUtils.h
@@ -215,7 +215,7 @@ public:
   void SetDamagedRegions(const CDirtyRegionList& dirtyRegions);
   int GetBufferAge();
   bool IsPlatformSupported() const;
-  EGLint GetConfigAttrib(EGLint attribute) const;
+  EGLint GetConfigAttrib(EGLint attribute, bool hdr = false) const;
 
   EGLDisplay GetEGLDisplay() const
   {
diff --git a/xbmc/windowing/android/WinSystemAndroidGLESContext.cpp b/xbmc/windowing/android/WinSystemAndroidGLESContext.cpp
index 2e1ffd3..c6f3718 100644
--- a/xbmc/windowing/android/WinSystemAndroidGLESContext.cpp
+++ b/xbmc/windowing/android/WinSystemAndroidGLESContext.cpp
@@ -275,3 +275,20 @@ bool CWinSystemAndroidGLESContext::SetHDR(const VideoPicture* videoPicture)
 
   return m_HDRColorSpace == HDRColorSpace;
 }
+
+int CWinSystemAndroidGLESContext::GetOutputBitDepth() const
+{
+  return m_pGLContext.GetConfigAttrib(EGL_RED_SIZE, m_HDRColorSpace != EGL_NONE);
+}
+
+KODI::UTILS::Eotf CWinSystemAndroidGLESContext::GetEotf() const
+{
+  return m_HDRColorSpace == EGL_GL_COLORSPACE_BT2020_PQ_EXT ? KODI::UTILS::Eotf::PQ
+                                                            : KODI::UTILS::Eotf::TRADITIONAL_SDR;
+}
+
+KODI::UTILS::Colorimetry CWinSystemAndroidGLESContext::GetColorimetry() const
+{
+  return m_HDRColorSpace == EGL_GL_COLORSPACE_BT2020_PQ_EXT ? KODI::UTILS::Colorimetry::BT2020_RGB
+                                                            : KODI::UTILS::Colorimetry::DEFAULT;
+}
diff --git a/xbmc/windowing/android/WinSystemAndroidGLESContext.h b/xbmc/windowing/android/WinSystemAndroidGLESContext.h
index dd4bb98..a2765f1 100644
--- a/xbmc/windowing/android/WinSystemAndroidGLESContext.h
+++ b/xbmc/windowing/android/WinSystemAndroidGLESContext.h
@@ -40,6 +40,9 @@ public:
   float GetFrameLatencyAdjustment() override;
   bool IsHDRDisplay() override;
   bool SetHDR(const VideoPicture* videoPicture) override;
+  int GetOutputBitDepth() const override;
+  KODI::UTILS::Eotf GetEotf() const override;
+  KODI::UTILS::Colorimetry GetColorimetry() const override;
 
   EGLDisplay GetEGLDisplay() const;
   EGLSurface GetEGLSurface() const;
-- 
