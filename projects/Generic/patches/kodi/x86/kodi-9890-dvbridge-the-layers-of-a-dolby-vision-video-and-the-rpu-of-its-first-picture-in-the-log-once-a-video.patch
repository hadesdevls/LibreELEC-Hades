+// (DVBridgeLayers.h names the layouts of dvbridge_gl_layout in this order)
+static_assert(DVBRIDGE_NV12 == 0 && DVBRIDGE_P010 == 1 && DVBRIDGE_P012 == 2 && DVBRIDGE_P016 == 3 &&
+              DVBRIDGE_YUV420P10 == 4 && DVBRIDGE_YUV444P10 == 5);
+
+namespace
+{
+// Hades: the video whose layers the log was last told of (ReportLayers()), for both bridges
+std::atomic<unsigned int> g_layersVideo{std::numeric_limits<unsigned int>::max()};
+
+DVBRIDGE_LAYERS::Shape ShapeOf(const CDVBridgeGLES::Layer& layer)
+{
+  DVBRIDGE_LAYERS::Shape shape;
+  shape.width = layer.width;
+  shape.height = layer.height;
+  shape.layout = static_cast<int>(layer.layout);
+  for (int p = 0; p < 2; ++p)
+  {
+    shape.textureWidth[p] = layer.planes[p].width;
+    shape.textureHeight[p] = layer.planes[p].height;
+  }
+  shape.chroma = layer.chroma;
+  return shape;
+}
+
+// (a layer that was not imported: its size and chroma, and the layout of its surfaces' format)
+DVBRIDGE_LAYERS::Shape ShapeOf(const AVFrame& frame)
+{
+  DVBRIDGE_LAYERS::Shape shape;
+  shape.width = frame.width;
+  shape.height = frame.height;
+  shape.chroma = frame.chroma_location;
+  if (frame.hw_frames_ctx && frame.hw_frames_ctx->data)
+  {
+    switch (reinterpret_cast<const AVHWFramesContext*>(frame.hw_frames_ctx->data)->sw_format)
+    {
+      case AV_PIX_FMT_NV12: shape.layout = DVBRIDGE_NV12; break;
+      case AV_PIX_FMT_P010: shape.layout = DVBRIDGE_P010; break;
+      case AV_PIX_FMT_P012: shape.layout = DVBRIDGE_P012; break;
+      case AV_PIX_FMT_P016: shape.layout = DVBRIDGE_P016; break;
+      default: break;
+    }
+  }
+  return shape;
+}
+
+DVBRIDGE_LAYERS::Surface SurfaceOf(const AVFrame& frame, const AVFrame* mapping)
+{
+  DVBRIDGE_LAYERS::Surface surface;
+  if (frame.hw_frames_ctx && frame.hw_frames_ctx->data)
+  {
+    const auto* pool = reinterpret_cast<const AVHWFramesContext*>(frame.hw_frames_ctx->data);
+    surface.poolWidth = pool->width;
+    surface.poolHeight = pool->height;
+    surface.poolFormat = av_get_pix_fmt_name(pool->sw_format);
+  }
+  const auto* descriptor = mapping && mapping->format == AV_PIX_FMT_DRM_PRIME
+                               ? reinterpret_cast<const AVDRMFrameDescriptor*>(mapping->data[0])
+                               : nullptr;
+  if (!descriptor || descriptor->nb_layers < 2 || descriptor->nb_objects < 1 ||
+      descriptor->nb_objects > AV_DRM_MAX_PLANES)
+    return surface;
+  for (int i = 0; i < 2; ++i)
+  {
+    const AVDRMLayerDescriptor& layer = descriptor->layers[i];
+    if (layer.nb_planes < 1)
+      return surface;
+    const AVDRMPlaneDescriptor& plane = layer.planes[0];
+    surface.fourcc[i] = layer.format;
+    surface.pitch[i] = static_cast<long long>(plane.pitch);
+    surface.modifier[i] = plane.object_index >= 0 && plane.object_index < descriptor->nb_objects
+                              ? descriptor->objects[plane.object_index].format_modifier
+                              : DVBRIDGE_LAYERS::MOD_INVALID;
+  }
+  surface.objects = descriptor->nb_objects;
+  surface.planes = descriptor->nb_layers;
+  return surface;
+}
+} // namespace
+
+void CDVBridgeGLES::ReportLayers(const Layer& base,
+                                 const Layer* layer,
+                                 const AVFrame* layerFrame,
+                                 const AVFrame* layerMapping,
+                                 bool layerNotDecoded,
+                                 bool layerSetAside,
+                                 const CDVMetadataBuffer& metadata)
+{
+  // Hades: once a video, in the log without debugging (an idea from CroqueMr's build): what each layer
+  // of it is as the bridge has it and what the decoder made of the enhancement layer, with what the RPU
+  // of its first picture drawn says of how the picture is composed
+  if (!DVBRIDGE_LAYERS::FirstOfVideo(g_layersVideo, g_cm40Video.load()))
+    return;
+  DVBRIDGE_LAYERS::Shape enhancement;
+  if (layer)
+    enhancement = ShapeOf(*layer);
+  else if (layerFrame)
+    enhancement = ShapeOf(*layerFrame);
+  DVBRIDGE_LAYERS::Surface surface;
+  if (layerFrame)
+    surface = SurfaceOf(*layerFrame, layerMapping);
+  const DVBRIDGE_LAYERS::Without without = layerNotDecoded ? DVBRIDGE_LAYERS::Without::NOT_DECODED
+                                           : layerSetAside ? DVBRIDGE_LAYERS::Without::SET_ASIDE
+                                                            : DVBRIDGE_LAYERS::Without::NONE;
+  CLog::Log(LOGINFO, "DVBridge: the layers of this video, as its first picture drawn brings them: {}",
+            DVBRIDGE_LAYERS::Describe(ShapeOf(base), layer || layerFrame ? &enhancement : nullptr,
+                                      layerFrame ? &surface : nullptr, without, metadata.Data(),
+                                      metadata.Size()));
+}
