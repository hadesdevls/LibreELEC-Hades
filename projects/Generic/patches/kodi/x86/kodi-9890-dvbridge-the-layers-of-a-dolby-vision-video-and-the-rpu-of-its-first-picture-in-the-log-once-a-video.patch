+#pragma once
+
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+#include <libavutil/pixdesc.h>
+}
+
+#include <atomic>
+#include <cctype>
+#include <cstdarg>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+/*!
+ * \brief Hades: the layers of a Dolby Vision video, as the first picture of it that the bridge draws
+ *        brings them, for one line of kodi.log a video. The idea is CroqueMr's: the first-frame line
+ *        of his build gives the size of each layer and of its textures, and where its chroma sits.
+ *
+ * What it says: of each layer, its size, its layout and bits as decoded, the size of its textures as the
+ * bridge was given them (Kodi's import of the base, the bridge's of the enhancement layer; both at the
+ * picture's size, and said when not), and where its chroma sits; how the enhancement layer stands to the
+ * base, and of it what the decoder made (the size and format of its pool of surfaces, and the dma-buf
+ * that the bridge imports: the format of each plane, the modifier, the pitches, the objects), or why
+ * there is none; and of the RPU of that picture, the profile that its header is of (FFmpeg's
+ * ff_dovi_guess_profile_hevc()), whether its NLQ adds a residual (FEL) or nothing (MEL: the rule of
+ * dvbridge_mel.h), its coefficients, the reshaping of each component, its mapping and the resampling
+ * filters. Bits are said against the RPU only where the layer holds fewer than the RPU declares.
+ *
+ * What the line of the first picture of each native output and that of the first picture reconstructed
+ * already say (the RPU's profile and level fields, the bits it declares, its range, the signal and the
+ * source, the extension levels, the content mapping, where it is drawn and how it is sent), and what the
+ * decoder says of the stream (its configuration record), is not said again. It decides nothing; a host
+ * test runs it. GL texture names, which CroqueMr's line gives, are not: they tell nothing past one run.
+ */
+namespace DVBRIDGE_LAYERS
+{
+
+//! One layer as the bridge has it: its size, the layout of its planes (dvbridge_gl_layout: NV12, P010,
+//! P012, P016, YUV420P10, YUV444P10, in that order; -1 where it was not imported), the size of its luma and
+//! first chroma textures (0: none), and where its chroma sits
+struct Shape
+{
+  int width = 0;
+  int height = 0;
+  int layout = -1;
+  int textureWidth[2] = {0, 0};
+  int textureHeight[2] = {0, 0};
+  AVChromaLocation chroma = AVCHROMA_LOC_UNSPECIFIED;
+};
+
+//! What the decoder made of the enhancement layer: its pool of surfaces (0 and nullptr where not known)
+//! and the dma-buf of the picture as the bridge maps it (planes 0: not mapped)
+struct Surface
+{
+  int poolWidth = 0;
+  int poolHeight = 0;
+  const char* poolFormat = nullptr; //!< av_get_pix_fmt_name() of the pool's software format
+  int objects = 0;
+  int planes = 0; //!< the layers of the DRM descriptor, each of one plane (two for a hardware frame)
+  uint32_t fourcc[2] = {0, 0};
+  uint64_t modifier[2] = {0, 0}; //!< of the object of each plane
+  long long pitch[2] = {0, 0};
+};
+
+//! Where the picture has no enhancement layer given with it: why (as the renderer tells the bridge)
+enum class Without
+{
+  NONE, //!< none came with it
+  NOT_DECODED, //!< the decoder left the layer out: its RPUs say that it carries no residual (MEL)
+  SET_ASIDE, //!< decoded, and set aside: its RPU says that it carries no residual
+};
+
+constexpr uint64_t MOD_LINEAR = 0; //!< DRM_FORMAT_MOD_LINEAR
+constexpr uint64_t MOD_INVALID = (UINT64_C(1) << 56) - 1; //!< DRM_FORMAT_MOD_INVALID
+
+inline std::string Format(const char* format, ...)
+{
+  char text[512];
+  va_list args;
+  va_start(args, format);
+  std::vsnprintf(text, sizeof(text), format, args);
+  va_end(args);
+  return text;
+}
+
+inline const char* LayoutName(int layout)
+{
+  static const char* const names[] = {"NV12", "P010", "P012", "P016", "YUV420P10", "YUV444P10"};
+  return layout >= 0 && layout < 6 ? names[layout] : nullptr;
+}
+
+//! The bits a sample of a layout holds
+inline int LayoutBits(int layout)
+{
+  static const int bits[] = {8, 10, 12, 16, 10, 10};
+  return layout >= 0 && layout < 6 ? bits[layout] : 0;
+}
+
+//! Whether the textures of a layer are of its size: the luma texture of the picture's, and the chroma
+//! one of half of it in each dimension (rounded either way: Kodi's import halves with a shift, the
+//! bridge's rounds up), or of the picture's for 4:4:4. A layer without textures is not asked.
+inline const char* TexturesAgainstPicture(const Shape& s)
+{
+  const bool full = s.layout == 5;
+  const int cwLow = full ? s.width : s.width / 2, cwHigh = full ? s.width : (s.width + 1) / 2;
+  const int chLow = full ? s.height : s.height / 2, chHigh = full ? s.height : (s.height + 1) / 2;
+  const int tw = s.textureWidth[1], th = s.textureHeight[1];
+  const bool chroma = tw > 0 && th > 0;
+  if (s.textureWidth[0] < s.width || s.textureHeight[0] < s.height ||
+      (chroma && (tw < cwLow || th < chLow)))
+    return ", smaller than the picture";
+  if (s.textureWidth[0] > s.width || s.textureHeight[0] > s.height ||
+      (chroma && (tw > cwHigh || th > chHigh)))
+    return ", larger than the picture";
+  return "";
+}
+
+//! relation: how the layer stands to the base (Relation()), or nullptr
+inline std::string DescribeShape(const Shape& s, unsigned declaredBits, const char* relation)
+{
+  std::string text = Format("%dx%d", s.width, s.height);
+  if (relation)
+    text += Format(" (%s)", relation);
+  const char* name = LayoutName(s.layout);
+  if (name)
+  {
+    const int bits = LayoutBits(s.layout);
+    text += Format(" %s, %d bits", name, bits);
+    if (declaredBits && static_cast<unsigned>(bits) < declaredBits)
+      text += Format(", fewer than the %u its RPU declares", declaredBits);
+  }
+  if (s.textureWidth[0] > 0 && s.textureHeight[0] > 0)
+  {
+    text += Format(", textures %dx%d", s.textureWidth[0], s.textureHeight[0]);
+    if (s.textureWidth[1] > 0 && s.textureHeight[1] > 0)
+      text += Format(" and %dx%d", s.textureWidth[1], s.textureHeight[1]);
+    text += TexturesAgainstPicture(s);
+  }
+  else
+    text += ", not imported";
+  const char* chroma = s.chroma == AVCHROMA_LOC_UNSPECIFIED ? nullptr : av_chroma_location_name(s.chroma);
+  text += Format(", chroma siting %s", chroma ? chroma : "not given");
+  return text;
+}
+
+//! How the enhancement layer stands to the base: of its size, half of it in each dimension, or neither
+inline const char* Relation(const Shape& base, const Shape& el)
+{
+  return el.width == base.width && el.height == base.height ? "1:1, the size of the base"
+         : 2 * el.width == base.width && 2 * el.height == base.height
+             ? "2:1, half the base in each dimension"
+             : "sizes that do not match: neither that of the base nor half of it";
+}
+
+//! A DRM format code as its four characters, or in hexadecimal where they are not all printable
+inline std::string FourCC(uint32_t code)
+{
+  char c[4];
+  for (int i = 0; i < 4; ++i)
+  {
+    c[i] = static_cast<char>((code >> (8 * i)) & 0xff);
+    if (!std::isprint(static_cast<unsigned char>(c[i])))
+      return Format("0x%08x", static_cast<unsigned>(code));
+  }
+  std::string text(c, 4);
+  while (!text.empty() && text.back() == ' ')
+    text.pop_back();
+  return text;
+}
+
+inline std::string Modifier(uint64_t modifier)
+{
+  return modifier == MOD_LINEAR    ? std::string("linear")
+         : modifier == MOD_INVALID ? std::string("not given")
+                                   : Format("0x%llx", static_cast<unsigned long long>(modifier));
+}
+
+inline std::string DescribeSurface(const Surface& s)
+{
+  std::string text;
+  if (s.poolWidth > 0 && s.poolHeight > 0)
+    text += Format("; decoded into surfaces of %dx%d%s%s", s.poolWidth, s.poolHeight,
+                   s.poolFormat ? " " : "", s.poolFormat ? s.poolFormat : "");
+  if (s.planes >= 2)
+  {
+    text += "; imported as " + FourCC(s.fourcc[0]) + " and " + FourCC(s.fourcc[1]) + " (modifier " +
+            Modifier(s.modifier[0]);
+    if (s.modifier[1] != s.modifier[0])
+      text += " and " + Modifier(s.modifier[1]);
+    text += Format(", pitches %lld and %lld bytes, %d object%s)", s.pitch[0], s.pitch[1], s.objects,
+                   s.objects == 1 ? "" : "s");
+  }
+  return text;
+}
+
+//! The header and mapping of a metadata buffer are where it says (as dvbridge_dv_readable() checks them)
+inline bool Readable(const void* data, size_t bytes)
+{
+  const auto* m = static_cast<const AVDOVIMetadata*>(data);
+  if (!m || bytes < sizeof(*m))
+    return false;
+  const auto region = [&](size_t offset, size_t size, size_t align) {
+    return offset >= sizeof(*m) && offset <= bytes && bytes - offset >= size && offset % align == 0;
+  };
+  return region(m->header_offset, sizeof(AVDOVIRpuDataHeader), alignof(AVDOVIRpuDataHeader)) &&
+         region(m->mapping_offset, sizeof(AVDOVIDataMapping), alignof(AVDOVIDataMapping));
+}
+
+//! The profile that an RPU header is of, as FFmpeg tells it for HEVC (ff_dovi_guess_profile_hevc(),
+//! libavcodec/dovi_rpu.c of FFmpeg 9.0.2): 0 where it tells none
+inline int HeaderProfile(const AVDOVIRpuDataHeader& h)
+{
+  switch (h.vdr_rpu_profile)
+  {
+    case 0:
+      return h.bl_video_full_range_flag ? 5 : 0;
+    case 1:
+      if (h.el_spatial_resampling_filter_flag && !h.disable_residual_flag)
+        return h.vdr_bit_depth == 12 ? 7 : 4;
+      return 8;
+    default:
+      return 0;
+  }
+}
+
+//! What the NLQ of an RPU adds to its picture (dvbridge_mel.h): nothing where the residual is disabled or
+//! where, in each component, nlq_offset is 0, vdr_in_max 1 << coef_log2_denom, the slope 0 and the
+//! threshold 0 (MEL); a residual otherwise (FEL)
+enum class Residual
+{
+  DISABLED,
+  MEL,
+  FEL,
+};
+
+inline Residual ResidualOf(const AVDOVIRpuDataHeader& h, const AVDOVIDataMapping& map)
+{
+  if (h.disable_residual_flag)
+    return Residual::DISABLED;
+  if (map.nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+    return Residual::FEL; // (FFmpeg takes no other; the bridge draws no such picture)
+  const uint64_t one = h.coef_log2_denom < 64 ? UINT64_C(1) << h.coef_log2_denom : 0;
+  for (int c = 0; c < 3; ++c)
+  {
+    const AVDOVINLQParams& q = map.nlq[c];
+    if (q.nlq_offset != 0 || q.vdr_in_max != one || q.linear_deadzone_slope != 0 ||
+        q.linear_deadzone_threshold != 0)
+      return Residual::FEL;
+  }
+  return Residual::MEL;
+}
+
+//! The reshaping of one component: its pieces and their methods with their orders, and whether every
+//! piece is the identity (a polynomial 0 + 1 x)
+inline std::string DescribeCurve(const AVDOVIReshapingCurve& c, unsigned denom)
+{
+  int pieces = c.num_pivots > 1 ? c.num_pivots - 1 : 0;
+  pieces = pieces > AV_DOVI_MAX_PIECES ? AV_DOVI_MAX_PIECES : pieces;
+  const int64_t one = denom < 63 ? INT64_C(1) << denom : 0;
+  int polyMin = 99, polyMax = -1, mmrMin = 99, mmrMax = -1;
+  bool identity = pieces > 0 && one;
+  for (int i = 0; i < pieces; ++i)
+  {
+    if (c.mapping_idc[i] == AV_DOVI_MAPPING_MMR)
+    {
+      mmrMin = c.mmr_order[i] < mmrMin ? c.mmr_order[i] : mmrMin;
+      mmrMax = c.mmr_order[i] > mmrMax ? c.mmr_order[i] : mmrMax;
+      identity = false;
+    }
+    else
+    {
+      polyMin = c.poly_order[i] < polyMin ? c.poly_order[i] : polyMin;
+      polyMax = c.poly_order[i] > polyMax ? c.poly_order[i] : polyMax;
+      identity = identity && c.poly_coef[i][0] == 0 && c.poly_coef[i][1] == one &&
+                 (c.poly_order[i] < 2 || c.poly_coef[i][2] == 0);
+    }
+  }
+  std::string methods;
+  const auto orders = [](int lo, int hi) {
+    return lo == hi ? Format("order %d", lo) : Format("orders %d to %d", lo, hi);
+  };
+  if (polyMax >= 0)
+    methods += "polynomial " + orders(polyMin, polyMax);
+  if (mmrMax >= 0)
+    methods += (methods.empty() ? "MMR " : ", MMR ") + orders(mmrMin, mmrMax);
+  if (identity)
+    methods += ", the identity";
+  return Format("%d piece%s", pieces, pieces == 1 ? "" : "s") +
+         (methods.empty() ? std::string() : " (" + methods + ")");
+}
+
+/*!
+ * \brief The line.
+ * \param base the base layer
+ * \param el the enhancement layer given with the picture, or nullptr
+ * \param surface what the decoder made of that layer, or nullptr
+ * \param without where el is nullptr, why
+ * \param rpu, bytes the metadata of the picture (AVDOVIMetadata), or nullptr
+ */
+inline std::string Describe(const Shape& base,
+                            const Shape* el,
+                            const Surface* surface,
+                            Without without,
+                            const void* rpu,
+                            size_t bytes)
+{
+  const bool readable = Readable(rpu, bytes);
+  const auto* m = static_cast<const AVDOVIMetadata*>(rpu);
+  const AVDOVIRpuDataHeader* h = readable ? av_dovi_get_header(m) : nullptr;
+  const AVDOVIDataMapping* map = readable ? av_dovi_get_mapping(m) : nullptr;
+  const int profile = h ? HeaderProfile(*h) : 0;
+  const Residual residual = h ? ResidualOf(*h, *map) : Residual::DISABLED;
+  std::string text = "base " + DescribeShape(base, h ? h->bl_bit_depth : 0, nullptr);
+  if (el && el->width > 0 && el->height > 0)
+  {
+    text += "; enhancement layer " + DescribeShape(*el, h ? h->el_bit_depth : 0, Relation(base, *el));
+    if (without == Without::SET_ASIDE)
+      text += ", set aside: its RPU says that it carries no residual";
+    if (surface)
+      text += DescribeSurface(*surface);
+  }
+  else if (without == Without::NOT_DECODED)
+    text += "; enhancement layer not decoded: its RPUs say that it carries no residual";
+  else if (without == Without::SET_ASIDE)
+    text += "; enhancement layer set aside: its RPU says that it carries no residual";
+  // (profiles 5 and 8 have one layer)
+  else if (profile == 5 || profile == 8)
+    text += "; a single layer";
+  else if (residual == Residual::FEL)
+    text += "; no enhancement picture with it, though its RPU has a residual";
+  else
+    text += "; no enhancement picture with it";
+  if (!h)
+    return text + (rpu ? "; its RPU could not be read" : "; no RPU");
+  text += profile ? Format("; its RPU: a header of profile %d (as FFmpeg reads one of HEVC)", profile)
+                  : std::string("; its RPU: a header of no profile that FFmpeg tells");
+  switch (residual)
+  {
+    case Residual::DISABLED:
+      text += ", residual disabled";
+      break;
+    case Residual::MEL:
+      text += ", an NLQ that adds nothing to any sample (MEL)";
+      break;
+    case Residual::FEL:
+      text += Format(", an NLQ that adds a residual (FEL; offsets %u %u %u)",
+                     static_cast<unsigned>(map->nlq[0].nlq_offset),
+                     static_cast<unsigned>(map->nlq[1].nlq_offset),
+                     static_cast<unsigned>(map->nlq[2].nlq_offset));
+      break;
+  }
+  text += Format("; coefficients %s, %u fractional bits", h->coef_data_type ? "in floating point" : "fixed",
+                 static_cast<unsigned>(h->coef_log2_denom));
+  static const char* const components[] = {"Y", "Cb", "Cr"};
+  for (int c = 0; c < 3; ++c)
+    text += Format("%s %s ", c ? "," : "; reshaping:", components[c]) +
+            DescribeCurve(map->curves[c], h->coef_log2_denom);
+  text += Format("; mapping colour space %u, chroma format %u; resampling filters: base %s, "
+                 "enhancement layer %s",
+                 static_cast<unsigned>(map->mapping_color_space),
+                 static_cast<unsigned>(map->mapping_chroma_format_idc),
+                 h->spatial_resampling_filter_flag ? "on" : "off",
+                 h->el_spatial_resampling_filter_flag ? "on" : "off");
+  return text;
+}
+
+//! Whether this is the first time that a picture of this video asks (video: the count of
+//! CDVBridgeGLES::ContentMappingNewVideo(); last: the video the line was last written for, shared by the
+//! bridges of native output and of the conversion, so that one line is written a video whatever draws it)
+inline bool FirstOfVideo(std::atomic<unsigned int>& last, unsigned int video)
+{
+  unsigned int seen = last.load();
+  return seen != video && last.compare_exchange_strong(seen, video);
+}
+
+} // namespace DVBRIDGE_LAYERS
