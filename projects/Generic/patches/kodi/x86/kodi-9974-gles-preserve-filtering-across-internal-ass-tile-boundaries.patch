From ba158bcb817e9f9e7e88c39806578d4e447087a8 Mon Sep 17 00:00:00 2001
From: vincent71711 <vincent71711@users.noreply.github.com>
Date: Sun, 11 Oct 2026 22:58:12 +0000
Subject: [PATCH] [GLES] Preserve filtering across internal ASS tile boundaries

Include neighbouring texels around split images and trim only the drawn
quad area. This preserves linear filtering without overlapping geometry.
Add a scaled-sampling regression test for opaque and patterned images.

(cherry picked from commit 66ccaf22923b54d7aaf5f14b48fa820dad9f51b8)
(cherry picked from commit 1a33e83e8b5de145c81b0edd8935ad5024d28ae0)
---
 .../VideoRenderers/OverlayRendererUtil.cpp    | 55 +++++++++++++------
 .../test/TestOverlayRendererUtil.cpp          | 55 +++++++++++++++++++
 2 files changed, 94 insertions(+), 16 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
index 491f170..39b798c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
@@ -301,27 +301,39 @@ bool convert_quad(ASS_Image* images, SQuads& quads, int max_x)
 bool convert_quad_pages(ASS_Image* images, std::vector<SQuads>& pages, int maxTextureSize)
 {
   pages.clear();
-  if (maxTextureSize < 2)
+  if (maxTextureSize < 4)
     return false;
 
-  // Keep libass painter order. Split oversized bitmaps too, without copying
-  // their pixels; convert_quad copies each tile into its final atlas.
-  std::vector<ASS_Image> tiles;
+  struct Tile
+  {
+    ASS_Image image;
+    int left;
+    int top;
+    int right;
+    int bottom;
+  };
+  std::vector<Tile> tiles;
   for (ASS_Image* image = images; image; image = image->next)
   {
     if ((image->color & 0xff) == 0xff || image->w <= 0 || image->h <= 0)
       continue;
-    for (int y = 0; y < image->h; y += maxTextureSize - 1)
+    const int tileWidth = image->w < maxTextureSize ? image->w : maxTextureSize - 3;
+    const int tileHeight = image->h < maxTextureSize ? image->h : maxTextureSize - 3;
+    for (int y = 0; y < image->h; y += tileHeight)
     {
-      for (int x = 0; x < image->w; x += maxTextureSize - 1)
+      for (int x = 0; x < image->w; x += tileWidth)
       {
-        ASS_Image tile = *image;
-        tile.w = std::min(image->w - x, maxTextureSize - 1);
-        tile.h = std::min(image->h - y, maxTextureSize - 1);
-        tile.bitmap += static_cast<size_t>(y) * image->stride + x;
-        tile.dst_x += x;
-        tile.dst_y += y;
-        tile.next = nullptr;
+        const int width = std::min(image->w - x, tileWidth);
+        const int height = std::min(image->h - y, tileHeight);
+        Tile tile{*image, x > 0, y > 0, x + width < image->w, y + height < image->h};
+        // Include neighbouring texels for GL_LINEAR at internal tile edges.
+        // Only the original tile area will be drawn, so these borders never overlap.
+        tile.image.w = width + tile.left + tile.right;
+        tile.image.h = height + tile.top + tile.bottom;
+        tile.image.bitmap += static_cast<size_t>(y - tile.top) * image->stride + x - tile.left;
+        tile.image.dst_x += x - tile.left;
+        tile.image.dst_y += y - tile.top;
+        tile.image.next = nullptr;
         tiles.push_back(tile);
       }
     }
@@ -337,7 +349,7 @@ bool convert_quad_pages(ASS_Image* images, std::vector<SQuads>& pages, int maxTe
     size_t end = begin;
     for (; end < tiles.size(); ++end)
     {
-      const ASS_Image& tile = tiles[end];
+      const ASS_Image& tile = tiles[end].image;
       if (x + tile.w >= maxTextureSize)
       {
         y += rowHeight + 1;
@@ -351,9 +363,20 @@ bool convert_quad_pages(ASS_Image* images, std::vector<SQuads>& pages, int maxTe
     }
 
     for (size_t i = begin; i < end; ++i)
-      tiles[i].next = i + 1 < end ? &tiles[i + 1] : nullptr;
+      tiles[i].image.next = i + 1 < end ? &tiles[i + 1].image : nullptr;
     pages.emplace_back();
-    convert_quad(&tiles[begin], pages.back(), maxTextureSize);
+    convert_quad(&tiles[begin].image, pages.back(), maxTextureSize);
+    for (size_t i = begin; i < end; ++i)
+    {
+      const Tile& tile = tiles[i];
+      SQuad& quad = pages.back().quad[i - begin];
+      quad.u += tile.left;
+      quad.v += tile.top;
+      quad.x += tile.left;
+      quad.y += tile.top;
+      quad.w -= tile.left + tile.right;
+      quad.h -= tile.top + tile.bottom;
+    }
     begin = end;
   }
   return !pages.empty();
diff --git a/xbmc/cores/VideoPlayer/test/TestOverlayRendererUtil.cpp b/xbmc/cores/VideoPlayer/test/TestOverlayRendererUtil.cpp
index 3b9b911..e2a63f3 100644
--- a/xbmc/cores/VideoPlayer/test/TestOverlayRendererUtil.cpp
+++ b/xbmc/cores/VideoPlayer/test/TestOverlayRendererUtil.cpp
@@ -8,7 +8,9 @@
 
 #include "cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.h"
 
+#include <algorithm>
 #include <array>
+#include <cmath>
 #include <vector>
 
 #include <ass/ass.h>
@@ -97,3 +99,56 @@ TEST(TestOverlayRendererUtil, BoundedPagesPreserveImages)
   EXPECT_FALSE(OVERLAY::convert_quad_pages(&images.back(), pages, limit));
   EXPECT_FALSE(OVERLAY::convert_quad_pages(images.data(), pages, 1));
 }
+
+TEST(TestOverlayRendererUtil, TiledImagesPreserveLinearFiltering)
+{
+  constexpr int width = 19;
+  constexpr int height = 17;
+  constexpr int stride = 23;
+  constexpr int limit = 8;
+  std::vector<unsigned char> bitmap(stride * (height - 1) + width);
+
+  const auto sample =
+      [](const std::vector<unsigned char>& pixels, int rowStride, int w, int h, double x, double y)
+  {
+    const int x0 = static_cast<int>(std::floor(x));
+    const int y0 = static_cast<int>(std::floor(y));
+    const double fx = x - x0;
+    const double fy = y - y0;
+    const auto pixel = [&](int px, int py)
+    { return pixels[std::clamp(py, 0, h - 1) * rowStride + std::clamp(px, 0, w - 1)]; };
+    return (1.0 - fy) * ((1.0 - fx) * pixel(x0, y0) + fx * pixel(x0 + 1, y0)) +
+           fy * ((1.0 - fx) * pixel(x0, y0 + 1) + fx * pixel(x0 + 1, y0 + 1));
+  };
+
+  for (const bool opaque : {true, false})
+  {
+    for (size_t i = 0; i < bitmap.size(); ++i)
+      bitmap[i] = opaque ? 255 : (i * 17) % 251;
+    ASS_Image image{};
+    image.w = width;
+    image.h = height;
+    image.stride = stride;
+    image.bitmap = bitmap.data();
+    std::vector<OVERLAY::SQuads> pages;
+    ASSERT_TRUE(OVERLAY::convert_quad_pages(&image, pages, limit));
+
+    for (const auto& page : pages)
+      for (const auto& quad : page.quad)
+        for (int y = 0; y < quad.h * 2; ++y)
+          for (int x = 0; x < quad.w * 2; ++x)
+          {
+            // Fragment centres at 2x scale, in source texel-centre coordinates.
+            const double dx = (x + 0.5) / 2.0 - 0.5;
+            const double dy = (y + 0.5) / 2.0 - 0.5;
+            const double sourceX = quad.x + dx;
+            const double sourceY = quad.y + dy;
+            if (sourceX < 0 || sourceX > width - 1 || sourceY < 0 || sourceY > height - 1)
+              continue;
+            ASSERT_DOUBLE_EQ(sample(bitmap, stride, width, height, sourceX, sourceY),
+                             sample(page.texture, page.size_x, page.size_x, page.size_y,
+                                    quad.u + dx, quad.v + dy))
+                << "source=" << sourceX << "," << sourceY << " opaque=" << opaque;
+          }
+  }
+}
