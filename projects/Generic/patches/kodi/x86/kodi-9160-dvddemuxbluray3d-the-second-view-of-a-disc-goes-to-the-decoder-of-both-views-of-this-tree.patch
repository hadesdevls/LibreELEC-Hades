From bc83fdd127be21bf7b2d936f0f97b308173e3be0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 01:37:49 +0000
Subject: [PATCH] DVDDemuxBluray3D: the second view of a disc goes to the
 decoder of both views of this tree

The demuxer appends each access unit of the second view to the one of the base view, which
is what the decoder of both views (h264_mvc) takes. It marked the stream for the multiview
decoding of the branch that it comes from. Here the mark is the one of this tree
(KODI::MULTIVIEW, as CDVDDemuxFFmpeg sets it for a Matroska file): the stream is announced
as one picture with the left eye on the left, and the mark says which eye the base view is,
by the MVC_Base_view_R_flag of the playlist. From there on it is CMultiviewPacker and its
rules: a base view without its second view goes to both eyes, and a stream whose second view
never comes goes back to the decoder of every stream.

- A mark that is new on a stream that already plays counts as a change of the stream
  (CDemuxStream::changes), which is what makes the player compare what it knows of it.
- Only an H.264 stream is marked, and nothing is appended to a stream that is not marked.
- A disc may start on something without a video stream. The demuxer then hands on what the
  base demuxer reads until a stream change brings one, instead of failing: the plain demuxer
  would have opened the disc a second time, from wherever this one left it.
- What is read of the second view for one picture of the base view is bounded (1024 access
  units; the clip is placed at most 13 seconds behind). The picture then goes on alone.
- One line at LOGINFO for each event: the clip that the second view of a play item is read
  from, or why it is not read; the eye of the base view; when the pairing starts; when the
  second view is placed again after a run of pictures without it; and, when a clip is left,
  how many pictures went on with their second view and how many without.

Nothing of this is reached by a disc whose second view is not wanted, or that declares no
3D content: such a disc does not get this demuxer.
---
 .../DVDDemuxers/DVDDemuxBluray3D.cpp          | 126 +++++++++++++++---
 .../DVDDemuxers/DVDDemuxBluray3D.h            |  22 ++-
 2 files changed, 130 insertions(+), 18 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
index 128ede3..7ac0e7b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.cpp
@@ -115,8 +115,11 @@ bool CDVDDemuxBluray3D::Open(const std::shared_ptr<CDVDInputStream>& input)
     return false;
   }
 
-  if (!FindBaseVideoStream())
-    return false;
+  // Hades: a disc may start on something without a picture. This demuxer then hands on what
+  // the base demuxer reads, untouched, until a stream change brings a video stream. Giving the
+  // disc back to the plain demuxer here would have it opened a second time, from wherever this
+  // one left it.
+  FindBaseVideoStream();
 
   // A 3D disc plays plenty that is not 3D - idents, warnings, a menu - and in navigation
   // mode which of those is next is not known until libbluray has been read far enough to
@@ -142,8 +145,9 @@ bool CDVDDemuxBluray3D::FindBaseVideoStream()
     }
   }
 
+  // (Hades: an ordinary state, see Open())
   if (m_baseVideoStreamId < 0)
-    CLog::LogF(LOGERROR, "no video stream in the base view");
+    CLog::LogF(LOGDEBUG, "no video stream in the base view");
 
   return m_baseVideoStreamId >= 0;
 }
@@ -152,7 +156,8 @@ bool CDVDDemuxBluray3D::OpenDependentView()
 {
   CloseDependentView();
 
-  if (m_aborted)
+  // (Hades: nor without a video stream to append it to)
+  if (m_aborted || m_baseVideoStreamId < 0)
     return false;
 
   unsigned int clip{0};
@@ -169,7 +174,10 @@ bool CDVDDemuxBluray3D::OpenDependentView()
 
   m_dependentInput = m_bluray->OpenClipStream(clip, codec);
   if (!m_dependentInput)
+  {
+    LogNoSecondView(clip, "the clip could not be opened");
     return false;
+  }
 
   m_dependentClip = static_cast<int>(clip);
 
@@ -181,6 +189,7 @@ bool CDVDDemuxBluray3D::OpenDependentView()
   if (!m_dependent->Open(m_dependentInput, false))
   {
     CLog::LogF(LOGERROR, "could not demux the dependent view clip");
+    LogNoSecondView(clip, "the clip could not be demuxed");
     CloseDependentView();
     return false;
   }
@@ -198,16 +207,28 @@ bool CDVDDemuxBluray3D::OpenDependentView()
   if (m_dependentVideoStreamId < 0)
   {
     CLog::LogF(LOGERROR, "no video stream in the dependent view clip");
+    LogNoSecondView(clip, "the clip has no video stream");
+    CloseDependentView();
+    return false;
+  }
+
+  // Hades: without the mark the stream is not decoded as two views, and nothing is appended
+  // to it; the clip is not tried again for this play item.
+  if (!MarkBaseViewStereoscopic())
+  {
+    LogNoSecondView(clip, "the base view is not a stream that can be marked as two views");
     CloseDependentView();
     return false;
   }
 
   m_unopenableClip = -1;
 
-  MarkBaseViewStereoscopic();
   CalculatePtsOffset();
 
-  CLog::Log(LOGDEBUG, "CDVDDemuxBluray3D - playing clip {:05} as the dependent view", clip);
+  CLog::Log(LOGINFO,
+            "CDVDDemuxBluray3D - the second view of this play item is read from clip {:05}, "
+            "{} ms from the base view",
+            clip, static_cast<int64_t>(DVD_TIME_TO_MSEC(m_ptsOffset)));
 
   // The clip starts at its beginning and the play item need not, so place the dependent view
   // where the play item does. The base view cannot be asked where that is: libbluray reaches
@@ -222,8 +243,26 @@ bool CDVDDemuxBluray3D::OpenDependentView()
   return true;
 }
 
+void CDVDDemuxBluray3D::LogNoSecondView(unsigned int clip, const char* why)
+{
+  CLog::Log(LOGINFO,
+            "CDVDDemuxBluray3D - the second view of this play item (clip {:05}) is not read "
+            "({}): its base view plays alone",
+            clip, why);
+}
+
 void CDVDDemuxBluray3D::CloseDependentView()
 {
+  // Hades: one line for what became of the clip
+  if (m_dependentClip >= 0 && (m_pairedInClip || m_aloneInClip))
+    CLog::Log(LOGINFO,
+              "CDVDDemuxBluray3D - clip {:05} is left: {} pictures went on with their second "
+              "view, {} with the base view alone",
+              m_dependentClip, m_pairedInClip, m_aloneInClip);
+  m_pairedInClip = 0;
+  m_aloneInClip = 0;
+  m_loggedReads = false;
+
   if (m_pendingDependent)
   {
     CDVDDemuxUtils::FreeDemuxPacket(m_pendingDependent);
@@ -244,19 +283,39 @@ void CDVDDemuxBluray3D::CloseDependentView()
   m_lastRealignPts = DVD_NOPTS_VALUE;
 }
 
-void CDVDDemuxBluray3D::MarkBaseViewStereoscopic()
+bool CDVDDemuxBluray3D::MarkBaseViewStereoscopic()
 {
   auto* stream{dynamic_cast<CDemuxStreamVideo*>(m_base->GetStream(m_baseVideoStreamId))};
   if (!stream)
-    return;
+    return false;
 
-  // The base view is the left eye unless the playlist says the eyes are swapped.
-  const bool baseViewIsRightEye{m_bluray->IsBaseViewRightEye()};
-  stream->stereo_mode = baseViewIsRightEye ? "right_left" : "left_right";
-  stream->multiview = true;
+  // Hades: the stream is marked as this tree marks a stream of two views (KODI::MULTIVIEW, as
+  // CDVDDemuxFFmpeg does for a Matroska file). It is announced as what the decoder of both
+  // views gives, one picture with the left eye on the left, and the mark says which eye the
+  // base view is: the left one unless the playlist says that the eyes are swapped. Only an
+  // H.264 stream has such a decoder.
+  if (stream->codec != AV_CODEC_ID_H264)
+    return false;
 
-  CLog::Log(LOGDEBUG, "CDVDDemuxBluray3D - the playlist says the base view is the {} eye ({})",
-            baseViewIsRightEye ? "right" : "left", stream->stereo_mode);
+  const bool baseViewIsRightEye{
+      KODI::MULTIVIEW::BaseEyeOfPlaylist(m_bluray->IsBaseViewRightEye()) ==
+      KODI::MULTIVIEW::BaseEye::RIGHT};
+  if (stream->multiview && stream->multiviewBaseRight == baseViewIsRightEye &&
+      stream->stereo_mode == KODI::MULTIVIEW::PACKED_STEREO_MODE)
+    return true;
+
+  stream->stereo_mode = KODI::MULTIVIEW::PACKED_STEREO_MODE;
+  stream->multiview = true;
+  stream->multiviewBaseRight = baseViewIsRightEye;
+  // The player looks again at what it knows of a stream when the stream counts a change: a
+  // mark that is new on a stream that plays already is one.
+  ++stream->changes;
+
+  CLog::Log(LOGINFO,
+            "CDVDDemuxBluray3D - stream {}: the playlist says that the base view is the {} eye; "
+            "both views are to be decoded",
+            stream->uniqueId, baseViewIsRightEye ? "right" : "left");
+  return true;
 }
 
 void CDVDDemuxBluray3D::CalculatePtsOffset()
@@ -298,6 +357,23 @@ DemuxPacket* CDVDDemuxBluray3D::ReadDependent()
   // else, but it costs little to be sure.
   while (true)
   {
+    // Hades: what is read of the second view for one picture of the base view has an end
+    // (KODI::MULTIVIEW::DISC_READS_PER_PICTURE). The picture then goes on alone.
+    if (m_readsLeft == 0)
+    {
+      if (!m_loggedReads)
+      {
+        m_loggedReads = true;
+        CLog::Log(LOGINFO,
+                  "CDVDDemuxBluray3D - clip {:05}: {} access units of the second view were read "
+                  "for one picture of the base view without reaching it; that picture goes on "
+                  "alone",
+                  m_dependentClip, KODI::MULTIVIEW::DISC_READS_PER_PICTURE);
+      }
+      return nullptr;
+    }
+    --m_readsLeft;
+
     DemuxPacket* packet{m_dependent->Read()};
     if (!packet)
     {
@@ -357,8 +433,9 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
     // well, and CheckDependentView() reopens the clip only if it has.
     FindBaseVideoStream();
     CheckDependentView();
-    if (m_dependent)
-      MarkBaseViewStereoscopic();
+    // (Hades: a stream that cannot be marked gets nothing appended)
+    if (m_dependent && !MarkBaseViewStereoscopic())
+      CloseDependentView();
     return packet;
   }
 
@@ -370,6 +447,9 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
   if (!m_dependent || packet->pts == DVD_NOPTS_VALUE)
     return packet;
 
+  // Hades: (see ReadDependent())
+  m_readsLeft = KODI::MULTIVIEW::DISC_READS_PER_PICTURE;
+
   if (m_resyncPending)
     AlignDependent(packet->pts);
 
@@ -397,6 +477,13 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
     m_pendingDependent = nullptr;
     m_unmergedBase = 0;
 
+    // Hades: one line when the pairing starts
+    if (m_pairedInClip++ == 0)
+      CLog::Log(LOGINFO,
+                "CDVDDemuxBluray3D - clip {:05}: the second view is paired with the base view, "
+                "from {} ms on",
+                m_dependentClip, static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
+
     return MergeViews(packet, dependent);
   }
 
@@ -411,7 +498,14 @@ DemuxPacket* CDVDDemuxBluray3D::Read()
   {
     m_lastRealignPts = packet->pts;
     m_resyncPending = true;
+    // Hades: one line each time
+    CLog::Log(LOGINFO,
+              "CDVDDemuxBluray3D - clip {:05}: {} pictures in a row went on without their second "
+              "view; it is placed again at the base view ({} ms)",
+              m_dependentClip, m_unmergedBase,
+              static_cast<int64_t>(DVD_TIME_TO_MSEC(packet->pts)));
   }
+  ++m_aloneInClip;
 
   return packet;
 }
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
index 16320d0..1632f40 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxBluray3D.h
@@ -89,8 +89,16 @@ private:
   //! \brief Find the base view's video stream in the base demuxer's stream list.
   bool FindBaseVideoStream();
 
-  //! \brief Tell the decoder the base view stream carries a second view to unpack.
-  void MarkBaseViewStereoscopic();
+  /*!
+   * \brief Tell the decoder the base view stream carries a second view to unpack.
+   *
+   * Hades: with the mark of this tree for a stream of two views (KODI::MULTIVIEW).
+   * \return false where the stream cannot be marked: nothing may be appended to it then
+   */
+  bool MarkBaseViewStereoscopic();
+
+  //! \brief Hades: one line in the log for a play item whose second view is not read.
+  void LogNoSecondView(unsigned int clip, const char* why);
 
   //! \brief Work out the fixed difference between the two views' timestamps.
   void CalculatePtsOffset();
@@ -172,4 +180,14 @@ private:
 
   //! Whether the dependent view still has to be placed against the base view.
   bool m_resyncPending{false};
+
+  //! Hades: base view pictures of the clip that went on with their second view, and without
+  uint64_t m_pairedInClip{0};
+  uint64_t m_aloneInClip{0};
+
+  //! Hades: access units of the second view that may still be read for the picture of the base
+  //! view at hand (KODI::MULTIVIEW::DISC_READS_PER_PICTURE), and whether running out of them
+  //! was reported for this clip
+  unsigned int m_readsLeft{0};
+  bool m_loggedReads{false};
 };
