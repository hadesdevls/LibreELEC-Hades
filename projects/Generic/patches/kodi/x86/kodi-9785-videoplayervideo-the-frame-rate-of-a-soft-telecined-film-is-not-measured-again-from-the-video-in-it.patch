From 164d40eab7b1dabbade5d76c2dcf4fffeccccc9a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:55:01 +0000
Subject: [PATCH] VideoPlayerVideo: the frame rate of a soft telecined film is
 not measured again from the video in it

The rate of a stream told to be a film with soft telecine is chosen once, when
it opens: 23.976 Hz for the whole file (PrefetchForSoftTelecine() of
CDVDDemuxFFmpeg), or for the whole title of a DVD. CalcFrameRate()
still measured the rate from the times of the pictures: video in such a film
(credits, a part shot on video, interlaced at 29.97) whose pictures each carry
a time (Matroska) gave 29.97 once it lasted some seconds,
and the render manager was given 59.94 Hz, then 23.976 Hz again with the next
stretch of film: two changes of the display mode in the middle of the video,
where Kodi before stayed at 59.94 Hz for all of it.

In such a film the rate measured no longer replaces the stream's (FilmTimer.h,
MeasuredRateReplaces()); everything else of CalcFrameRate() is as it was, the
frames it allows to drop included.

Tested with a model of the timing of CVideoPlayerVideo that compiles Kodi's
PTSTracker.cpp unchanged: a film with 30 s of video in it, a time on each
picture, gives two changes of the rate before and none after; the 14 streams
of its corpus that are no film give the same output before and after.
---
 xbmc/cores/VideoPlayer/FilmTimer.h          | 18 ++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp |  6 +++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/FilmTimer.h b/xbmc/cores/VideoPlayer/FilmTimer.h
index 641bc5e..fea07b3 100644
--- a/xbmc/cores/VideoPlayer/FilmTimer.h
+++ b/xbmc/cores/VideoPlayer/FilmTimer.h
@@ -100,4 +100,22 @@ inline PictureTime PictureTimeOf(CFilmTimer& timer,
   timer.Reset();
   return RepeatedFieldTiming(pts, film ? CFilmTimer::CODED_DURATION : frameDuration, repeatPicture);
 }
+
+/*!
+ * \brief (Hades) Whether the frame rate that the times of the pictures give replaces the one the
+ *        player has (CVideoPlayerVideo::CalcFrameRate())
+ *
+ * Never in a stream that is a film with soft telecine (\p film): its rate is that of the film for
+ * the whole stream, and the display mode is chosen once for it. The video in such a film
+ * (interlaced pictures at 29.97: titles, a part shot on video) gives 29.97 once it lasts some
+ * seconds with a time on each picture, and the mode went to 59.94 Hz there and back to 23.976 Hz
+ * with the next stretch of film: two changes of the display mode in the middle of the video.
+ * Otherwise as Kodi does: where the rate measured is more than \p tolerance from the player's, or
+ * the player has none.
+ */
+inline bool MeasuredRateReplaces(
+    bool film, double current, double measured, bool invalid, double tolerance)
+{
+  return !film && (std::fabs(current - measured) > tolerance || invalid);
+}
 } // namespace KODI::VIDEOPLAYER
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index 7b6949d..e5149cf 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -1229,7 +1229,11 @@ void CVideoPlayerVideo::CalcFrameRate()
     if (m_iFrameRateCount >= MathUtils::round_int(framerate) * m_iFrameRateLength)
     {
       //store the calculated framerate if it differs too much from m_fFrameRate
-      if (fabs(m_fFrameRate - (m_fStableFrameRate / m_iFrameRateCount)) > MAXFRAMERATEDIFF || m_bFpsInvalid)
+      // (Hades: never in a film with soft telecine, whose rate is the film's for the whole stream:
+      // FilmTimer.h, MeasuredRateReplaces())
+      if (KODI::VIDEOPLAYER::MeasuredRateReplaces(m_softTelecine, m_fFrameRate,
+                                                  m_fStableFrameRate / m_iFrameRateCount,
+                                                  m_bFpsInvalid, MAXFRAMERATEDIFF))
       {
         CLog::Log(LOGDEBUG, "{} framerate was:{:f} calculated:{:f}", __FUNCTION__, m_fFrameRate,
                   m_fStableFrameRate / m_iFrameRateCount);
-- 
2.53.0

