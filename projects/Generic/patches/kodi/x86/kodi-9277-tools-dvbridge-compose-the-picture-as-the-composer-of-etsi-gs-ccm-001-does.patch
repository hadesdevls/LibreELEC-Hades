From 0e8b57f9e3964d440227aad72439378684858132 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:16:41 +0000
Subject: [PATCH] tools/dvbridge: compose the picture as the composer of ETSI
 GS CCM 001 does

The bridge asks libplacebo for the composer of ETSI GS CCM 001 V1.1.1,
clause 5.4 (pl_render_params.dovi_ccm, libplacebo-9930 of the LibreELEC
tree): the chroma mapped per chroma sample with the luma down-sampled as
5.4.2.3.3 says, a code read as s / 2^n, the residual of the enhancement
layer inverse-quantized on its integer codes after the resampling of
annex B.3, the samples h of 5.4.3.3 at hdr_bit_depth. libplacebo's own
reshaping composes at 4:4:4 and reads codes as s / (2^n - 1); on a
profile 7 FEL stream its picture differs from the clause's by 4 to 15
codes of 4095 in almost every pixel and by up to 742 at edges of high
luma contrast. Measured on a software OpenGL ES: the composed planes are
the clause's, sample for sample, and the reconstructed picture is within
one code of a 64-bit reference of the clause and of the stage after it.

Both renderers (the transport and the picture for output as HDR10) use
it. A picture the clause does not cover is composed by libplacebo's
reshaping, as before, and libplacebo logs why. If the composer fails on a
GPU, libplacebo composes the same picture by its reshaping, sets
PL_RENDER_ERR_DOVI_COMPOSER and logs it: that error alone does not make
the render fail here, since the picture was drawn.

advancedsettings.xml can turn it off, to compare on hardware:
<video><dvccmcomposer>false</dvccmcomposer></video>. The work of the
composer is not that of the reshaping, so the drawing way remembered for
a GPU (videoscreen.hadesdvpath) is kept apart for that setting, as it is
for dvearlymask.
---
 tools/dvbridge/dvbridge_render.c              | 21 ++++++++++++++++---
 tools/dvbridge/dvbridge_render.h              |  7 +++++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 14 +++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  2 ++
 xbmc/settings/AdvancedSettings.cpp            |  2 ++
 xbmc/settings/AdvancedSettings.h              |  3 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  5 +++--
 7 files changed, 49 insertions(+), 5 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index ba637f5..bd9d25c 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -51,6 +51,9 @@ struct dvbridge_renderer {
     /* Hades: what was noted of this stream (NOTE_*): reported (noted) and not yet taken (fresh) */
     unsigned noted, fresh;
     struct dvbridge_render_notes notes;
+    /* Hades: the picture is composed by libplacebo's own reshaping, not as ETSI GS CCM 001 composes it
+     * (dvbridge_render_use_ccm_composer()) */
+    bool legacy_composer;
 };
 
 struct active_mask {
@@ -485,6 +488,7 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     // Own exact PQ-zero borders below. Do not translate an sRGB clear color
     // through the output transfer function or clear a full-raster frame twice.
     params.border = PL_CLEAR_SKIP;
+    params.dovi_ccm = !r->legacy_composer;
     step_down(&params, r->step);
     unsigned margins[4];
     if (!dvbridge_active_area(r->pending, margins))
@@ -538,9 +542,12 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         r->clean_place[3] = geometry.height;
     }
     r->ready = pl_render_image(r->renderer, &image, &target, &params) && mask.called && !mask.failed;
-    /* An EL sampling failure can otherwise return a successfully rendered BL-only frame. */
+    /* An EL sampling failure can otherwise return a successfully rendered BL-only frame. A composer of
+     * ETSI GS CCM 001 that failed on this GPU is not one: libplacebo composed the picture by its own
+     * reshaping, as with it turned off, and said so in the log. */
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
-    r->ready = r->ready && !errors.errors && !errors.num_disabled_hooks;
+    r->ready = r->ready && !(errors.errors & ~PL_RENDER_ERR_DOVI_COMPOSER) &&
+               !errors.num_disabled_hooks;
     r->early_mask = mask.early_mask;
     if (!packed && (whole || !r->ready))
         r->rgb_clean = false;
@@ -788,6 +795,7 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     params.frame_mixer = NULL;
     params.skip_caching_single_frame = true;
     params.border = PL_CLEAR_SKIP;
+    params.dovi_ccm = !r->legacy_composer;
     step_down(&params, r->step);
     bool clamped = false;
     const struct pl_hook hook = {
@@ -815,7 +823,8 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     bool ok = pl_render_image(r->renderer, &image, &target, &params) &&
               (r->hdr10_mapping.enabled ? to_display.called : clamped);
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
-    r->hdr10_whole = ok && !errors.errors && !errors.num_disabled_hooks;
+    r->hdr10_whole = ok && !(errors.errors & ~PL_RENDER_ERR_DOVI_COMPOSER) &&
+                     !errors.num_disabled_hooks;
     return r->hdr10_whole;
 }
 
@@ -906,3 +915,9 @@ unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *r, bool
     (void) r;
     return residual ? 0xfu : 0x3u;
 }
+
+void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *r, bool use)
+{
+    if (r)
+        r->legacy_composer = !use;
+}
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index db74b69..e5c3242 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -129,4 +129,11 @@ int dvbridge_render_step(const struct dvbridge_renderer *renderer);
  * does. A caller that lowers the fidelity by itself steps only between the levels of the mask: a
  * level outside it would change nothing. */
 unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *renderer, bool residual);
+/* Hades: whether the picture is composed as the composer of ETSI GS CCM 001 V1.1.1 (clause 5.4)
+ * composes it (the default): the chroma mapped at 4:2:0 with the luma down-sampled as the clause
+ * says, codes read as s / 2^n, the residual inverse-quantized on the integer codes of the
+ * resampled enhancement layer (libplacebo's pl_render_params.dovi_ccm). Off: libplacebo's own
+ * reshaping, as before, to compare on hardware. A picture outside the clause's scope is composed
+ * by libplacebo's reshaping either way (libplacebo logs why). */
+void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *renderer, bool use);
 #endif
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 4f55ab6..4b78ebb 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -451,6 +451,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
     CLog::Log(LOGINFO, "DVBridge: the area outside the active picture is written after the "
                        "reconstruction, as advancedsettings.xml asks (dvearlymask)");
   }
+  UseComposerSetting();
   pl_opengl_wrap_params output{};
   output.width = 3840;
   output.height = 2160;
@@ -836,6 +837,18 @@ unsigned int CDVBridgeGLES::GetPQFramebuffer()
   return valid ? m_framebuffer : 0;
 }
 
+// Hades: the composer of the Dolby Vision picture, ETSI GS CCM 001 unless advancedsettings.xml asks
+// for libplacebo's own reshaping: <video><dvccmcomposer>false</dvccmcomposer></video>
+void CDVBridgeGLES::UseComposerSetting()
+{
+  const auto settings = CServiceBroker::GetSettingsComponent();
+  if (!m_renderer || !settings || settings->GetAdvancedSettings()->m_videoDVCCMComposer)
+    return;
+  dvbridge_render_use_ccm_composer(m_renderer, false);
+  CLog::Log(LOGINFO, "DVBridge: the picture is composed by libplacebo's reshaping, not as ETSI GS "
+                     "CCM 001 composes it, as advancedsettings.xml asks (dvccmcomposer)");
+}
+
 bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
 {
   if (m_gl)
@@ -865,6 +878,7 @@ bool CDVBridgeGLES::InitializeConversion(bool allowSoftware)
   UseShaderCache();
   m_conversion = true;
   m_renderer = dvbridge_renderer_create_hdr10(m_gl->gpu, m_log);
+  UseComposerSetting();
   m_copier = dvbridge_gl_copier_create();
   CLog::Log(LOGDEBUG, "DVBridge: GL initialized for output as HDR10 renderer={} copier={}",
             m_renderer != nullptr, m_copier != nullptr);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index a89583f..8cf5a9e 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -179,6 +179,8 @@ private:
   //! Hades: what the renderer noticed of the stream (its level 5 offsets read as those of a
   //! master, reserved levels left out, layers of another bit depth than their RPU), once each
   void LogNotes();
+  //! The composer of the renderer, as advancedsettings.xml asks (video/dvccmcomposer)
+  void UseComposerSetting();
   //! Take the OpenGL errors that earlier drawing left in the context, before libplacebo runs
   //! \param before what runs next, for the log
   void TakeStaleGLErrors(const char* before);
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index a66bb85..a0fa812 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -202,6 +202,7 @@ void CAdvancedSettings::Initialize()
   m_videoAudioDelayStep = 0.025f;
   m_videoUseTimeSeeking = true;
   m_videoDVEarlyMask = true;
+  m_videoDVCCMComposer = true;
   m_videoDVAheadAlways = false;
   m_videoDVStepDown = -1;
   m_videoDVKeepRepeats = true;
@@ -699,6 +700,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
 
     XMLUtils::GetBoolean(pElement, "usetimeseeking", m_videoUseTimeSeeking);
     XMLUtils::GetBoolean(pElement, "dvearlymask", m_videoDVEarlyMask);
+    XMLUtils::GetBoolean(pElement, "dvccmcomposer", m_videoDVCCMComposer);
     XMLUtils::GetBoolean(pElement, "dvaheadalways", m_videoDVAheadAlways);
     XMLUtils::GetInt(pElement, "dvstepdown", m_videoDVStepDown, 0, 3);
     XMLUtils::GetBoolean(pElement, "dvkeeprepeats", m_videoDVKeepRepeats);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index 27bb879..d32446d 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -167,6 +167,9 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! Hades: the Dolby Vision renderer writes the bars of a letterboxed picture before it
     //! reconstructs the picture (video/dvearlymask). Off for a measurement of what that saves
     bool m_videoDVEarlyMask;
+    //! Hades: the Dolby Vision renderer composes the picture as ETSI GS CCM 001 does
+    //! (video/dvccmcomposer). Off: libplacebo's own reshaping, to compare on hardware
+    bool m_videoDVCCMComposer;
     //! Hades: native Dolby Vision frames are presented a frame ahead wherever that can be done,
     //! not only where the GPU needs it (video/dvaheadalways). To try it on a fast GPU
     bool m_videoDVAheadAlways;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 7bbb67b..95a7551 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2325,7 +2325,7 @@ void CWinSystemGbmGLESContext::DVPathRecall()
     return std::string(value ? reinterpret_cast<const char*>(value) : "");
   };
   // ... and what advancedsettings.xml can turn off or force to measure it (video/dvearlymask,
-  // video/dvstepdown).
+  // video/dvstepdown), or change (video/dvccmcomposer: the composer, whose work is not the same).
   const std::string renderer = text(GL_RENDERER);
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto settings = component ? component->GetSettings() : nullptr;
@@ -2338,7 +2338,8 @@ void CWinSystemGbmGLESContext::DVPathRecall()
                           (advanced && !advanced->m_videoDVEarlyMask ? "\nno early mask" : "") +
                           (advanced && advanced->m_videoDVStepDown > 0
                                ? "\nstep-down " + std::to_string(advanced->m_videoDVStepDown)
-                               : std::string()));
+                               : std::string()) +
+                          (advanced && !advanced->m_videoDVCCMComposer ? "\nlibplacebo composer" : ""));
   m_dvPathNamed = true;
   // ... and the fidelity step-down levels found for the picture formats (CDVStepDown), kept the
   // same way in a setting of their own
-- 
