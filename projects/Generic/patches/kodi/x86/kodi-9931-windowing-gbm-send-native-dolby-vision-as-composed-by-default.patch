From de44a21ec388238833378d8e1899d3a4c054ae5e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 04:09:56 +0000
Subject: [PATCH] windowing/gbm: send native Dolby Vision as composed by
 default

The default transport of profiles 7 and 8 was IPT-PQ-c2, as licensed players
are reported to send it. Measured over I, P and T of every pixel (delta E ITP)
on pictures of profile 7 films and on patterns whose full-resolution colour is
known, the composer's own YCbCr is as close to the picture or closer however a
display fills in the right pixel of each 4:2:2 pair, and it goes out bit for
bit. IPT adds a rounding to 12 bits and gives the right pixel of a pair P and T
worked out with the left pixel's luma: up to 13 to 19 on neon edges of films,
and 4 to 25 on one-pixel stripes of a saturated colour, with any display.

"As composed" becomes the default and the first choice of the list; "As
licensed players send (IPT)" stays as an expert choice. A value that is none of
the options, or a setting that cannot be read, is the default; IPT goes out only
when it is chosen. Kodi resets a value saved as the old default to the new one
when it loads the settings. Profile 5 (IPT in the file) and the conversion to
BT.2020 send the same bytes as before.
---
 system/settings/settings.xml                   |  6 +++---
 xbmc/settings/Settings.h                       |  5 +++--
 xbmc/windowing/gbm/DVEngineSettings.h          | 17 ++++++++++++-----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp |  7 ++++---
 4 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 50bd3d4..a2c5f05 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -4499,11 +4499,11 @@
             </and>
           </requirement>
           <level>3</level>
-          <default>0</default>
+          <default>2</default>
           <constraints>
             <options>
-              <option label="39898">0</option> <!-- in IPT-PQ-c2, as licensed players send it -->
-              <option label="39896">2</option> <!-- as composed -->
+              <option label="39896">2</option> <!-- as composed (the default) -->
+              <option label="39898">0</option> <!-- in IPT-PQ-c2, as licensed players are reported to send it -->
               <option label="39897">1</option> <!-- converted to BT.2020 -->
             </options>
           </constraints>
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 2c62dad..6276c0e 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -544,8 +544,9 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVSTEPMODE = "videoscreen.hadesdvstepmode";
   //! ... the composition (0: as ETSI GS CCM 001 composes; 1: libplacebo's own reshaping) ...
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVCOMPOSER = "videoscreen.hadesdvcomposer";
-  //! ... how the signal is sent (0: in IPT-PQ-c2, as licensed players are reported to send it; 2: the
-  //! composer's picture as it is, ETSI GS CCM 001 clause 6; 1: reconstructed and converted to BT.2020) ...
+  //! ... how the signal is sent (2, the default: the composer's picture as it is, ETSI GS CCM 001
+  //! clause 6; 0: in IPT-PQ-c2, as licensed players are reported to send it; 1: reconstructed and
+  //! converted to BT.2020) ...
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVTRANSPORT = "videoscreen.hadesdvtransport";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVGAMUTFINE = "videoscreen.hadesdvgamutfine";
   //! ... and whether a picture on the screen is kept there instead of being drawn again
diff --git a/xbmc/windowing/gbm/DVEngineSettings.h b/xbmc/windowing/gbm/DVEngineSettings.h
index 6aea39c..66bed2c 100644
--- a/xbmc/windowing/gbm/DVEngineSettings.h
+++ b/xbmc/windowing/gbm/DVEngineSettings.h
@@ -71,10 +71,16 @@ struct CDVEngineSettings
   //! videoscreen.hadesdvtransport: how the signal is sent (ETSI GS CCM 001 V1.1.1, clause 6)
   enum class Transport
   {
-    LICENSED = 0, //!< the composer's picture, in IPT-PQ-c2 for profiles 7 and 8, as licensed players
-                  //!< are reported to send it (dvbridge_render_use_ipt())
+    LICENSED = 0, //!< an expert choice: the composer's picture in IPT-PQ-c2 for profiles 7 and 8,
+                  //!< as licensed players are reported to send it (dvbridge_render_use_ipt()).
+                  //!< Measured in delta E ITP over I, P and T of every pixel, on pictures of films
+                  //!< it is no closer to the picture than COMPOSED however a display fills in the
+                  //!< right pixel of a 4:2:2 pair, and further where the light changes sharply
+                  //!< inside a saturated colour: that pixel gets P and T worked out with the left
+                  //!< pixel's luma
     BT2020 = 1, //!< reconstructed in RGB and converted to BT.2020 YCbCr
-    COMPOSED = 2, //!< the composer's picture as it is, in the representation of its RPU
+    COMPOSED = 2, //!< the default: the composer's picture as it is, in the representation of its
+                  //!< RPU (its own codes, bit for bit)
   };
 
   static constexpr int STEP_LEVELS = 4; //!< CDVStepDown::LEVELS, DVBRIDGE_STEP_LEVELS
@@ -86,7 +92,7 @@ struct CDVEngineSettings
     int ahead = 0;
     int step = 0;
     int composer = 0;
-    int transport = 0;
+    int transport = static_cast<int>(Transport::COMPOSED);
     bool keepRepeats = true;
     //! videoscreen.hadesdvnotrims, the other way round
     bool trims = true;
@@ -155,7 +161,8 @@ struct CDVEngineSettings
     s.ccmComposer = read.composer != static_cast<int>(Composer::LIBPLACEBO) && advanced.ccmComposer;
     s.composerByAdvanced = !advanced.ccmComposer;
     s.sourceTransport = read.transport != static_cast<int>(Transport::BT2020);
-    s.ipt = s.sourceTransport && read.transport != static_cast<int>(Transport::COMPOSED);
+    // (IPT-PQ-c2 only when it is chosen: a value that is none of the options is the default)
+    s.ipt = read.transport == static_cast<int>(Transport::LICENSED);
     s.keepRepeats = read.keepRepeats && advanced.keepRepeats;
     s.keepRepeatsByAdvanced = !advanced.keepRepeats;
     s.trims = read.trims;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 6852e06..5446817 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5653,14 +5653,15 @@ void CWinSystemGbmGLESContext::DVEngineRead()
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto settings = component ? component->GetSettings() : nullptr;
   const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
-  const auto integer = [&settings](const char* id)
-  { return settings && settings->GetSetting(id) ? settings->GetInt(id) : 0; };
+  const auto integer = [&settings](const char* id, int fallback = 0)
+  { return settings && settings->GetSetting(id) ? settings->GetInt(id) : fallback; };
   CDVEngineSettings::Read read;
   read.path = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVPATHMODE);
   read.ahead = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVAHEADMODE);
   read.step = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE);
   read.composer = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVCOMPOSER);
-  read.transport = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVTRANSPORT);
+  read.transport = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVTRANSPORT,
+                           CDVEngineSettings::Read{}.transport);
   read.keepRepeats = !settings ||
                      !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVKEEPREPEATS) ||
                      settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVKEEPREPEATS);
-- 
2.53.0

