From ad88fcb64d83823b0a54b498c17690c9f601bdf3 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Wed, 7 Oct 2026 14:06:37 +0100
Subject: [PATCH] [windowing][RESOLUTION_INFO] Give a declared aspect the pixel
 ratio that produces it

The constructor taking a declared aspect computed the pixel ratio as (width / height) / aspect,
the inverse of the correction. DisplayRatio() multiplies the pixel shape by the pixel ratio, so a
skin layout whose declaration disagreed with its pixels was compounded rather than corrected:
Estuary's 2560x1080 layout declares 21:9 (2.333) on a 2.370 raster and reported 2.408, and that
is the shape the closest layout is chosen against. The ratio is now aspect / (width / height).
A layout whose pixels match its declaration gets 1 either way.

TestResolution, in a new windowing test library, pins the reported shape against the declared
one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4dd20cd0152c564ff7717cc396392329da517411)
---
 cmake/treedata/common/tests.txt        |  1 +
 xbmc/windowing/Resolution.cpp          |  2 +-
 xbmc/windowing/test/CMakeLists.txt     |  3 ++
 xbmc/windowing/test/TestResolution.cpp | 61 ++++++++++++++++++++++++++
 4 files changed, 66 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/windowing/test/CMakeLists.txt
 create mode 100644 xbmc/windowing/test/TestResolution.cpp

diff --git a/cmake/treedata/common/tests.txt b/cmake/treedata/common/tests.txt
index aebc182..c1d6657 100644
--- a/cmake/treedata/common/tests.txt
+++ b/cmake/treedata/common/tests.txt
@@ -50,3 +50,4 @@ xbmc/utils/i18n/test              test/utils/i18n
 xbmc/utils/i18n/Bcp47Registry/test test/utils/i18n/Bcp47Registry
 xbmc/utils/test                   test/utils
 xbmc/video/test                   test/video
+xbmc/windowing/test               test/windowing
diff --git a/xbmc/windowing/Resolution.cpp b/xbmc/windowing/Resolution.cpp
index 4731ef4..ae2bddf 100644
--- a/xbmc/windowing/Resolution.cpp
+++ b/xbmc/windowing/Resolution.cpp
@@ -58,7 +58,7 @@ RESOLUTION_INFO::RESOLUTION_INFO(int width, int height, float aspect, const std:
   iBlanking = 0;
   iScreenWidth = width;
   iScreenHeight = height;
-  fPixelRatio = aspect ? ((float)width)/height / aspect : 1.0f;
+  fPixelRatio = aspect ? aspect / (((float)width) / height) : 1.0f;
   bFullScreen = true;
   fRefreshRate = 0;
   dwFlags = iSubtitles = 0;
diff --git a/xbmc/windowing/test/CMakeLists.txt b/xbmc/windowing/test/CMakeLists.txt
new file mode 100644
index 0000000..965d7b7
--- /dev/null
+++ b/xbmc/windowing/test/CMakeLists.txt
@@ -0,0 +1,3 @@
+set(SOURCES TestResolution.cpp)
+
+core_add_test_library(windowing_test)
diff --git a/xbmc/windowing/test/TestResolution.cpp b/xbmc/windowing/test/TestResolution.cpp
new file mode 100644
index 0000000..f79a9ef
--- /dev/null
+++ b/xbmc/windowing/test/TestResolution.cpp
@@ -0,0 +1,61 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
