 CDVMenus::State CWinSystemGbmGLESContext::DVMenusState(bool forStart)
 {
   CDVMenus::State s;
@@ -8501,6 +8573,10 @@ void CWinSystemGbmGLESContext::LogDVStats(const char* period)
     ioctls += StringUtils::Format("; {} frames with GUI elements composited by the packer, from "
                                   "the GUI texture (video/dvguiinplace)",
                                   m_dvStats.guiInPlace);
+  // Hades: which frames had something over the picture, and why (CDVGuiReuse)
+  ioctls += m_dvGuiReuse.Line(CServiceBroker::GetGUI()
+                                  ? CServiceBroker::GetGUI()->GetWindowManager().GetActiveWindowOrDialog()
