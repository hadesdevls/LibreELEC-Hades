+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief When the GUI pass of a frame of native Dolby Vision output can be left out, and why the
+ *        frames that have something over the picture have it
+ *
+ * Kodi leaves the GUI pass out of a frame when no control marked itself dirty (the dirty-driven
+ * skip of CApplication::FrameMove()), but only where the video has a plane of its own
+ * (IsRenderingVideoLayer()): with the video drawn by the render pass, the window of the video and
+ * its control mark themselves dirty in every frame, so that the pass that draws the picture keeps
+ * running. With native Dolby Vision output the picture is drawn by RenderEx(), after the GUI pass
+ * and whatever it did, and the GUI goes over it from its FBO (CompositeGui()): the FBO of the
+ * frame before holds, to the bit, what drawing the GUI again would put in it, wherever nothing
+ * dirtied itself. Leaving the pass out (the walk of every control and its draw calls, on a GPU
+ * that is also doing the packing) changes nothing that is sent to the display.
+ *
+ * This class only decides, from facts the window system gathers, and counts. The facts that make
+ * the content of the FBO something other than the last frame drawn are each a reason to draw:
+ * the setting, an output that is not native Dolby Vision, a GUI that is not composited, an FBO
+ * that was made after the last frame was drawn (or has not been drawn into yet), the menus in
+ * Dolby Vision (their frames are made of the FBO), partial redraws (the FBO would hold only what
+ * changed), stereoscopic 3D (two passes), overlays on the picture that are drawn in the GUI pass
+ * (subtitles, the debug information of the player: they are not left to the dirty regions alone),
+ * a frame with the GUI that was not seen yet by the picture's pass (what it was over was not
+ * known). A capture marks the window manager dirty itself (CApplication::FrameMove()).
+ */
+class CDVGuiReuse
+{
+public:
+  struct Facts
+  {
+    bool setting = true; //!< advancedsettings.xml <video><dvguireuse>, on by default
+    bool native = false; //!< native Dolby Vision output is captured
+    bool compositing = false; //!< the GUI is composited (the FBO and the composite exist)
+    bool fboReady = false; //!< the FBO is valid, of the size of the output
+    bool menus = false; //!< the menus in Dolby Vision are on, or the setting is
+    bool partial = false; //!< advancedsettings.xml asks for partial redraws
+    bool stereo = false; //!< a stereoscopic mode
+    bool overlays = false; //!< subtitles or the debug information are over the picture
+    bool seen = false; //!< a frame whose GUI was drawn went through the picture's pass since
+                       //!< the FBO was made, and its elements are known
+  };
+
+  enum class Why
+  {
+    NONE, //!< the pass may be left out
+    SETTING,
+    NOT_NATIVE,
+    NO_COMPOSITE,
+    FBO,
+    MENUS,
+    PARTIAL,
+    STEREO,
+    OVERLAYS,
+    NOT_SEEN,
+  };
+
+  static Why Check(const Facts& f)
+  {
+    if (!f.setting)
+      return Why::SETTING;
+    if (!f.native)
+      return Why::NOT_NATIVE;
+    if (!f.compositing)
+      return Why::NO_COMPOSITE;
+    if (!f.fboReady)
+      return Why::FBO;
+    if (f.menus)
+      return Why::MENUS;
+    if (f.partial)
+      return Why::PARTIAL;
+    if (f.stereo)
+      return Why::STEREO;
+    if (f.overlays)
+      return Why::OVERLAYS;
+    if (!f.seen)
+      return Why::NOT_SEEN;
+    return Why::NONE;
+  }
+
+  static const char* Text(Why why)
+  {
+    switch (why)
+    {
+      case Why::NONE:
+        return "nothing";
+      case Why::SETTING:
+        return "turned off in advancedsettings.xml (video/dvguireuse)";
+      case Why::NOT_NATIVE:
+        return "the output is not native Dolby Vision";
+      case Why::NO_COMPOSITE:
+        return "the GUI is not composited";
+      case Why::FBO:
+        return "the FBO of the GUI is not ready";
+      case Why::MENUS:
+        return "the menus in Dolby Vision are on";
+      case Why::PARTIAL:
+        return "advancedsettings.xml asks for partial redraws of the GUI";
+      case Why::STEREO:
+        return "a stereoscopic mode";
+      case Why::OVERLAYS:
+        return "subtitles or the debug information are over the picture";
+      case Why::NOT_SEEN:
+        return "no frame of the GUI has been seen by the picture's pass yet";
+    }
+    return "?";
+  }
+
+  //! What a frame that is not drawn directly has over its picture
+  enum class Over
+  {
+    GUI, //!< GUI elements
+    OVERLAYS, //!< subtitles or the debug information, no GUI element
+    CAPTURE, //!< a capture reads the picture
+  };
+
+  //! The over-picture classification of a frame (a capture first: it makes every frame whole)
+  static Over Classify(bool captured, bool guiElements)
+  {
+    return captured ? Over::CAPTURE : guiElements ? Over::GUI : Over::OVERLAYS;
+  }
+
+  struct Counts
+  {
+    unsigned int gui = 0; //!< frames composed because GUI elements were over the picture
+    unsigned int guiReused = 0; //!< ... of those, whose GUI pass was left out (the FBO of the frame before)
+    unsigned int overlays = 0; //!< ... because of subtitles or debug information alone
+    unsigned int capture = 0; //!< ... because a capture waited for the frame
+    unsigned int passesSkipped = 0; //!< GUI passes left out (drawn directly or not)
+    int window = -1; //!< the window or dialog that was on top when the line was taken
+  };
+
+  void Frame(Over over, bool reused)
+  {
+    switch (over)
+    {
+      case Over::GUI:
+        ++m_counts.gui;
+        m_counts.guiReused += reused ? 1 : 0;
+        break;
+      case Over::OVERLAYS:
+        ++m_counts.overlays;
+        break;
+      case Over::CAPTURE:
+        ++m_counts.capture;
+        break;
+    }
+  }
+
+  //! The pass of a frame was left out
+  void Skipped() { ++m_counts.passesSkipped; }
+
+  //! The reason that the last ask said no, told once when it changes (empty: nothing to tell)
+  //! (an ask is made once a frame: a reason that lasts is not told again)
+  std::string Declined(Why why)
+  {
+    if (m_told && why == m_lastAsked)
+      return std::string();
+    m_told = true;
+    m_lastAsked = why;
+    if (why == Why::NONE)
+      return "DVBridge: the GUI pass of a frame is left out where no control is dirty: the GUI "
+             "over the picture is the FBO of the frame before, the same bytes (video/dvguireuse)";
+    return std::string("DVBridge: the GUI pass is drawn in every frame: ") + Text(why) +
+           " (video/dvguireuse)";
+  }
+
+  //! The counts of the span since the last line, and their text
+  std::string Line(int window)
+  {
+    m_counts.window = window;
+    const Counts c = m_counts;
+    m_counts = Counts();
+    std::string s;
+    if (c.gui || c.overlays || c.capture)
+    {
+      s = "; frames composed: " + std::to_string(c.gui) + " with GUI elements (" +
+          std::to_string(c.guiReused) + " of them from the FBO of the frame before, the GUI pass " +
+          "left out), " + std::to_string(c.overlays) + " with subtitles or debug information only, " +
+          std::to_string(c.capture) + " for a capture (the window on top: " +
+          std::to_string(c.window) + ")";
+    }
+    else if (c.passesSkipped)
+      s = "; " + std::to_string(c.passesSkipped) + " GUI passes left out";
+    return s;
+  }
+
+  //! Forget what was asked: the output begins again
+  void Restart() { m_told = false; }
+
+private:
+  Counts m_counts;
+  Why m_lastAsked = Why::NONE;
+  bool m_told = false; //!< the first ask of an output is told whatever it says
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
