From 9ac4daa11baba71ef72ca732037d3bb0dd6ae246 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:33 +0000
Subject: [PATCH] windowing/gbm: the vendor InfoFrame of the 3D output goes
 when Kodi ends, and before HDR is signalled

The InfoFrame that says "no 3D" stays with nvidia-drm after a half 3D
layout. Two places where it should not:

When Kodi ended, it was left on the connector, for whatever showed a
picture next. The next Kodi cleared it with its first modeset, with a
warning in the log at every start after a 3D film; and had that first
request not been taken, native Dolby Vision output would have found the
property taken for the whole session, with nothing in Kodi that knew of
it. What the driver has from the 3D output is now taken away when the
window system is closed, by a property call of its own. A Kodi that is
killed still leaves it, and the next one still clears it.

NVKMS refuses a commit that has both a vendor InfoFrame from its user
and HDR signalling on the graphics cards before RTX 50
(ValidateHdmiVsif() in nvkms-hw-flip.c). It refuses HDR altogether on a
display in whose EDID it finds HDMI 3D, so the two do not meet where its
reading of the EDID and Kodi's agree. For where they do not, the
InfoFrame that says "no 3D" is taken away with the commit that signals
HDR, and again when that commit is made a second time.

Neither does anything where the driver has no InfoFrame from the 3D
output, which is every display without 3D.

Read and compiled. Whether nvidia-drm takes the property call at exit
has not been seen on a GPU: it goes through the same atomic check and
commit as any other.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 49 +++++++++++++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbm.h   |  5 +++
 2 files changed, 54 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 5b5c6f6..99933ba 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -304,6 +304,11 @@ bool CWinSystemGbm::DestroyWindowSystem()
   m_displayWatch.reset();
   m_libinput.reset();
 
+  // Hades: an HDMI vendor InfoFrame that the driver has from the 3D output (nvidia-drm) does
+  // not outlive Kodi. Left there, it is sent with whatever shows a picture next, and the next
+  // Kodi finds the property taken until its first modeset has cleared it.
+  ReleaseStereoInfoFrame();
+
   return true;
 }
 
@@ -802,6 +807,41 @@ void CWinSystemGbm::PrepareStereoInfoFrame(const RESOLUTION_INFO& res)
   }
 }
 
+void CWinSystemGbm::ReleaseStereoInfoFrame()
+{
+  if (!m_stereoInfoFrame.IsValid())
+    return;
+
+  // (only while the driver still has it: native Dolby Vision output may have taken its place)
+  CDRMConnector* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (connector &&
+      connector->GetPropertyValue("NV_HDMI_VSIF_METADATA").value_or(0) == m_stereoInfoFrame.Get())
+  {
+    if (connector->SetProperty("NV_HDMI_VSIF_METADATA", 0))
+      CLog::Log(LOGINFO, "3D output: the HDMI vendor InfoFrame that the driver had from Kodi is "
+                         "taken away");
+    else
+      CLog::Log(LOGWARNING, "3D output: the HDMI vendor InfoFrame that the driver has from Kodi "
+                            "could not be taken away; the next start clears it");
+  }
+  m_stereoInfoFrame = CDRMPropertyBlob();
+  m_stereoInfoFrameLayout = STEREO::Layout::NONE;
+  m_stereoInfoFrameEnds = false;
+}
+
+void CWinSystemGbm::DropEndedStereoInfoFrame()
+{
+  if (!m_stereoInfoFrameEnds || !m_stereoInfoFrame.IsValid())
+    return;
+
+  // (while the driver still has it; that it is gone is found out when the next mode is set)
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (connector &&
+      connector->GetPropertyValue("NV_HDMI_VSIF_METADATA").value_or(0) == m_stereoInfoFrame.Get())
+    drm->AddProperty(connector, "NV_HDMI_VSIF_METADATA", 0);
+}
+
 void CWinSystemGbm::CheckStereoInfoFrame()
 {
   if (!m_stereoInfoFrameQueued)
@@ -1773,6 +1813,12 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
       m_hdrBlob = CDRMPropertyBlob(drm->GetFileDescriptor(), &hdr_metadata, sizeof(hdr_metadata));
     }
 
+    // Hades: the HDMI vendor InfoFrame that says "no 3D", where the driver still has it from
+    // here (nvidia-drm, after a half 3D layout), goes with the commit that signals HDR: NVKMS
+    // takes no HDR signalling next to a vendor InfoFrame of its user on most graphics cards.
+    if (m_hdrBlob.IsValid())
+      DropEndedStereoInfoFrame();
+
     drm->AddProperty(connector, "HDR_OUTPUT_METADATA", m_hdrBlob.Get());
     drm->SetActive(true);
     m_queuedHdrMetadata = m_hdrBlob.Get();
@@ -1792,6 +1838,9 @@ void CWinSystemGbm::RequeueOutputProperties()
     drm->AddProperty(connector, "Colorspace", *m_queuedColorspace);
   if (m_queuedHdrMetadata)
     drm->AddProperty(connector, "HDR_OUTPUT_METADATA", *m_queuedHdrMetadata);
+  // (Hades: ... and with HDR metadata, what SetHDR() takes away with them)
+  if (m_queuedHdrMetadata && *m_queuedHdrMetadata)
+    DropEndedStereoInfoFrame();
   drm->AllowModeset();
 }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index 674bec9..8c04654 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -278,6 +278,11 @@ private:
   void PrepareStereoInfoFrame(const RESOLUTION_INFO& res);
   //! After that commit: whether the driver took it
   void CheckStereoInfoFrame();
+  //! When Kodi ends: what the driver has from here is taken away, by a commit of its own
+  void ReleaseStereoInfoFrame();
+  //! Before HDR is signalled: the InfoFrame that says "no 3D", where the driver has it from
+  //! here, is taken away with the commit that is being made
+  void DropEndedStereoInfoFrame();
   //! Tells the log what the 3D output is, when that is something else than it was told last
   void TellStereoOutput(const std::string& status);
   //! (read by other threads: GetStereoOutputArrangement())
-- 
2.53.0

