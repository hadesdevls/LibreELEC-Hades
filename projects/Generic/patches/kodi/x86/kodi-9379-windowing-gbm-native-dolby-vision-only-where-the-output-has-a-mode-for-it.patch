+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1029,17 +1029,27 @@ bool IsDVTransportMode(const drmModeModeInfo& mode)
        (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0);
 }
 
-// Hades: whether the output offers a mode that carries native output at all (none on an HDMI 1.4
-// port, cable, adapter or TV input at a lower clock than 3840x2160 needs, or behind a DisplayPort
-// dual-mode adapter of the first type)
-bool OffersDVTransportMode(const CDRMConnector& connector)
+bool DVModeInterlacedOr3D(const drmModeModeInfo& mode)
 {
+  return (mode.flags &
+          (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0;
+}
+
+// Hades: what the modes of the output offer native output at a refresh rate (DVBRIDGE::
+// TransportModesOf(): none on an HDMI 1.4 port, cable, adapter or TV input at a lower clock than
+// 3840x2160 needs, or behind a DisplayPort dual-mode adapter of the first type; 24 to 30 Hz only on
+// an HDMI port of 300 MHz, as on Intel graphics of display version 9). The modes are the driver's,
+// which lists none that its link cannot carry.
+DVBRIDGE::TransportModes OfferedDVTransportModes(const CDRMConnector& connector, double refresh)
+{
+  std::vector<DVBRIDGE::ModeTraits> modes;
+  modes.reserve(connector.GetModesCount());
   for (int i = 0; i < connector.GetModesCount(); ++i)
   {
-    if (IsDVTransportMode(*connector.GetModeForIndex(i)))
-      return true;
+    const auto& mode = *connector.GetModeForIndex(i);
+    modes.push_back({mode.hdisplay, mode.vdisplay, ModeRate(mode), DVModeInterlacedOr3D(mode)});
   }
-  return false;
+  return DVBRIDGE::TransportModesOf(modes, refresh);
 }
 
 // The refresh rate is not adjusted to the video: the output keeps the current one.
@@ -1153,34 +1163,32 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
     reason = "the display takes Dolby Vision at 2160p up to 30 Hz only (its version 1 block does "
              "not advertise 2160p60)";
   }
-  else if (!anyMode && mode &&
-           DVBRIDGE::RefreshRateKeepsOrdinary(
-               RefreshRateFixed(), ModeRate(*mode),
-               (mode->flags &
-                (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_3D_MASK)) != 0) &&
-           OffersDVTransportMode(*connector))
-  {
-    // Hades: the refresh rate is kept where the user set it (it is not adjusted to the video), at
-    // one that native output does not go to; DV never takes another refresh rate than the one the
-    // video gets (the size alone changes, where that is what stands in the way). Only where the
-    // output offers a mode that carries native output: one that offers none says so ("nomode",
-    // below), which adjusting the refresh rate would not change.
-    code = "refresh";
-    reason = "the refresh rate is not adjusted to the video, and the one set is not 23.976 to 60 "
-             "Hz; turn on \"Adjust display refresh rate\" (Settings > Player > Videos)";
-  }
-  else if (!anyMode && (!mode || !IsDVTransportMode(*mode)))
-  {
-    code = "mode";
-    reason = "the output mode is not 3840x2160 progressive at 23.976 to 60 Hz";
-    // Hades: ... and none that is, on this output (an HDMI 1.4 port, cable, adapter or TV input
-    // at a lower clock than 3840x2160 needs, as a DisplayPort dual-mode adapter of the first type)
-    if (!OffersDVTransportMode(*connector))
-    {
-      code = "nomode";
+  // Hades: what the mode stands in the way of (DVBRIDGE::ModeReason()). An output that offers no
+  // mode that carries native output says so also before a video (anyMode): native output cannot be
+  // had in any mode there, and the stream is not set up for it nor Dolby Vision told to add-ons.
+  // The refresh rate is kept where the user set it when it is not adjusted to the video ("refresh"),
+  // and Dolby Vision never takes another refresh rate than the one the video gets: the size alone
+  // changes, where the output has a transport mode at that rate ("noratemode" where it has none).
+  else if (const char* modeCode = DVBRIDGE::ModeReason(
+               anyMode, RefreshRateFixed(), mode != nullptr, mode ? ModeRate(*mode) : 0.0,
+               mode && IsDVTransportMode(*mode), mode && DVModeInterlacedOr3D(*mode),
+               OfferedDVTransportModes(*connector, mode ? ModeRate(*mode) : 0.0));
+           *modeCode)
+  {
+    code = modeCode;
+    const std::string_view which = modeCode;
+    if (which == "nomode")
       reason = "the output offers no 3840x2160 progressive mode at 23.976 to 60 Hz (an HDMI 1.4 "
                "port, cable, adapter or TV input, or a DisplayPort dual-mode adapter, limits it)";
-    }
+    else if (which == "refresh")
+      reason = "the refresh rate is not adjusted to the video, and the one set is not 23.976 to 60 "
+               "Hz; turn on \"Adjust display refresh rate\" (Settings > Player > Videos)";
+    else if (which == "noratemode")
+      reason = "the output offers no 3840x2160 mode at the refresh rate in use (an HDMI port of 300 "
+               "MHz, as on Intel graphics of display version 9, reaches 30 Hz at 3840x2160); Dolby "
+               "Vision does not take another refresh rate than the video gets";
+    else
+      reason = "the output mode is not 3840x2160 progressive at 23.976 to 60 Hz";
   }
   if (anyMode)
     return reason == nullptr;
