index 97c7ee3..172963b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -4,6 +4,7 @@
 #include <algorithm>
 #include <cmath>
 #include <initializer_list>
+#include <vector>
 
 class CDVDStreamInfo;
 class VideoPicture;
@@ -62,6 +63,85 @@ inline bool RefreshRateKeepsOrdinary(bool refreshFixed, double modeRate, bool in
   return refreshFixed && !interlacedOr3D && !IsTransportMode(3840, 2160, modeRate, false);
 }
 
+//! Hades: a mode of an output, as the rule of native output looks at it
+struct ModeTraits
+{
+  int width = 0;
+  int height = 0;
+  double refresh = 0;
+  bool interlacedOr3D = false; //!< interlaced, double scan, or a mode with a 3D layout
+};
+
+//! Hades: what the modes of an output offer native output, at a refresh rate
+enum class TransportModes
+{
+  //! no mode carries it: an HDMI 1.4 port, cable, adapter or TV input at a lower clock than
+  //! 3840x2160 needs, or a DisplayPort dual-mode adapter of the first type
+  NONE,
+  //! some do, none at this refresh rate: an HDMI port of 300 MHz, as on Intel graphics of display
+  //! version 9, has 3840x2160 at 24 to 30 Hz only
+  OTHER_RATES,
+  //! one at this refresh rate does
+  AT_RATE,
+};
+
+/*!
+ * \brief Hades: what a list of modes offers native output at a refresh rate
+ *
+ * The list is the driver's: a mode that the source or the link cannot carry in 8-bit RGB is not in
+ * it (on i915 and amdgpu the driver checks the TMDS clock of each mode before listing it), so a
+ * transport mode is chosen only among those that fit. The rate is matched as Kodi matches the
+ * refresh rate of a resolution (CResolutionUtils::FindDVTransportResolution(): 0.01 Hz).
+ */
+inline TransportModes TransportModesOf(const std::vector<ModeTraits>& modes, double refresh)
+{
+  bool any = false;
+  for (const auto& mode : modes)
+  {
+    if (!IsTransportMode(mode.width, mode.height, mode.refresh, mode.interlacedOr3D))
+      continue;
+    if (std::abs(mode.refresh - refresh) < 0.01)
+      return TransportModes::AT_RATE;
+    any = true;
+  }
+  return any ? TransportModes::OTHER_RATES : TransportModes::NONE;
+}
+
+/*!
+ * \brief Hades: why the output mode keeps a video from native output, as a reason code of the
+ *        player information ("" where it does not)
+ * \param anyMode the question is whether native output can be had in a transport mode at all,
+ *        before Kodi chooses the mode for the video (WantsNativeOutputMode(), the HDR capabilities
+ *        told to add-ons): only an output that offers no transport mode stands in the way then
+ * \param refreshFixed the refresh rate is not adjusted to the video
+ * \param haveMode, modeRate, modeIsTransport, modeInterlacedOr3D the mode that is set
+ * \param offered what the modes of the output offer at the rate of that mode (TransportModesOf())
+ *
+ * Codes: nomode (no mode of the output carries native output), refresh (the refresh rate is fixed
+ * at one that native output does not go to), noratemode (the mode is not a transport mode, and the
+ * output has none at its refresh rate: Dolby Vision never takes another refresh rate than the one
+ * the video gets), mode (the mode is not a transport mode).
+ */
+inline const char* ModeReason(bool anyMode,
+                              bool refreshFixed,
+                              bool haveMode,
+                              double modeRate,
+                              bool modeIsTransport,
+                              bool modeInterlacedOr3D,
+                              TransportModes offered)
+{
+  const bool transportNow = haveMode && modeIsTransport;
+  if (!transportNow && offered == TransportModes::NONE)
+    return "nomode";
+  if (anyMode)
+    return "";
+  if (haveMode && RefreshRateKeepsOrdinary(refreshFixed, modeRate, modeInterlacedOr3D))
+    return "refresh";
+  if (!transportNow)
+    return haveMode && offered == TransportModes::OTHER_RATES ? "noratemode" : "mode";
+  return "";
+}
+
 // Above 30 Hz, the transport needs a display that takes Dolby Vision at 2160p60 (VICs 96 and 97):
 // every version 2 Dolby VSVDB, and the version 1 blocks that advertise it.
 inline bool TransportRateNeeds2160p60(double refresh)
