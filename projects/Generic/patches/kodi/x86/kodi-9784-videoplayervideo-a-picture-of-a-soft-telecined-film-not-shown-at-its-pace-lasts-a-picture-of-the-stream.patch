From 04ad4efc956b3431fe713c992fd071f08c4ae0d5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:55:00 +0000
Subject: [PATCH] VideoPlayerVideo: a picture of a soft telecined film not
 shown at its pace lasts a picture of the stream

A stream told to be a film with soft telecine says 23.976 per second, so the
frame duration that Kodi has for it is the film's, 1001/24000 s. The pictures
of it that are not shown at the film's pace took that duration: the
interlaced pictures of video in the film (29.97 per second), and every picture
at a speed other than normal (tempo, fast forward), which with its repeated
field lasted 62.6 ms instead of 50.05. Where a picture carries no time of its
own (a DVD gives one to some pictures only), its time is the running guess,
which then fell a quarter of a picture behind with each one: 117 ms after 15
pictures of video, 146 ms over 96 pictures of film at another speed, until the
next picture with a time went back. Such a picture now lasts a coded picture
of the stream, 1001/30000 s (CFilmTimer::CODED_DURATION), with its repeated
field as Kodi takes it: as it was before the film was told.

The film timer also kept its anchor through such pictures: the first picture
of film after them, without a time of its own, took the next time after the
last stretch of film, 2 s before its own time after 60 pictures of video, and
the pictures after it too, until one with a time. The times of the film now
start again after a picture that is not shown at the film's pace.

The choice is made in FilmTimer.h (PictureTimeOf()), so that it is tested on
the host: t_softfilm (film, video, film; a time on every picture, and on one
in 15) passes; the rule before fails 7 of its checks.
---
 xbmc/cores/VideoPlayer/FilmTimer.h          | 39 +++++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp | 30 +++++++---------
 2 files changed, 52 insertions(+), 17 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/FilmTimer.h b/xbmc/cores/VideoPlayer/FilmTimer.h
index a5a6872..641bc5e 100644
--- a/xbmc/cores/VideoPlayer/FilmTimer.h
+++ b/xbmc/cores/VideoPlayer/FilmTimer.h
@@ -8,6 +8,8 @@
 
 #pragma once
 
+#include "RepeatedField.h"
+
 #include <cmath>
 #include <cstdint>
 
@@ -31,6 +33,9 @@ class CFilmTimer
 public:
   static constexpr double DURATION =
       1000000.0 * 1001.0 / 24000.0; //!< of a film picture, in DVD_TIME_BASE units
+  //! of a picture of the stream as it is coded, 1001/30000 s: the pulldown codes four pictures of
+  //! the film as five of the stream, in fields
+  static constexpr double CODED_DURATION = DURATION * 4.0 / 5.0;
   static constexpr double TOLERANCE =
       25000.0; //!< how far the time of the stream may be from the pace
 
@@ -61,4 +66,38 @@ private:
   double m_anchor = 0.0;
   int64_t m_count = 0;
 };
+
+/*!
+ * \brief (Hades) The time and the duration that a decoded picture goes out with, in a stream that
+ *        is a film with soft telecine (\p film) or in any other
+ *
+ * In such a film, a picture that is shown at its pace (\p atFilmPace: the normal speed, and a
+ * picture that is not interlaced) takes the next of the times of the film (CFilmTimer) and lasts a
+ * picture of the film. Every other picture is timed as Kodi times a picture with repeated fields
+ * (RepeatedFieldTiming()), from the duration of a picture of the stream: \p frameDuration, which
+ * in such a film is a coded picture (CFilmTimer::CODED_DURATION), not the 1001/24000 s of the film
+ * that the stream says. With the film's, the video in a film (its interlaced pictures, at 29.97)
+ * and every picture at a speed other than normal lasted a quarter more each, and those of them
+ * without a time of their own (a disc gives one to some pictures only) came later and later until
+ * the next picture with a time went back. After such a picture the times of the film start again
+ * from the picture that resumes it: without a time of its own, it took the n-th time after the
+ * last stretch of film, seconds before the video that came between.
+ * \param asFilm set to whether the picture took a time of the film (the running guess of the time
+ *        of the next picture goes on from it)
+ */
+inline PictureTime PictureTimeOf(CFilmTimer& timer,
+                                 bool film,
+                                 bool atFilmPace,
+                                 double pts,
+                                 bool hasTimestamp,
+                                 double frameDuration,
+                                 double repeatPicture,
+                                 bool& asFilm)
+{
+  asFilm = film && atFilmPace;
+  if (asFilm)
+    return {timer.Next(pts, hasTimestamp), CFilmTimer::DURATION};
+  timer.Reset();
+  return RepeatedFieldTiming(pts, film ? CFilmTimer::CODED_DURATION : frameDuration, repeatPicture);
+}
 } // namespace KODI::VIDEOPLAYER
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
index dc3bb8d..7b6949d 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -853,24 +853,20 @@ bool CVideoPlayerVideo::ProcessDecoderOutput(double &frametime, double &pts)
     if (!m_picture.strDVELType.empty())
       m_processInfo.NoteVideoDVELType(m_picture.strDVELType);
 
-    if (m_softTelecine && m_speed == DVD_PLAYSPEED_NORMAL &&
-        !(m_picture.iFlags & DVP_FLAG_INTERLACED))
-    {
-      // Hades: a picture of a film with soft telecine is shown once, at the pace of the film,
-      // whatever its repeated field says (the stream is at 23.976 Hz, see CFilmTimer). A picture
-      // that is interlaced (credits in video) goes as it was.
-      m_picture.pts = m_filmTimer.Next(pts, hasTimestamp);
-      m_picture.iDuration = KODI::VIDEOPLAYER::CFilmTimer::DURATION;
+    // Hades: a picture of a film with soft telecine is shown once, at the pace of the film,
+    // whatever its repeated field says (the stream is at 23.976 Hz, see CFilmTimer). A picture of
+    // it that is interlaced (credits in video), or at another speed, goes as it was: a picture of
+    // the stream as coded. In any stream, the repeated field of a picture lengthens it; it does
+    // not move its start (FilmTimer.h, PictureTimeOf())
+    bool asFilm = false;
+    const auto timing = KODI::VIDEOPLAYER::PictureTimeOf(
+        m_filmTimer, m_softTelecine,
+        m_speed == DVD_PLAYSPEED_NORMAL && !(m_picture.iFlags & DVP_FLAG_INTERLACED), pts,
+        hasTimestamp, m_picture.iDuration, m_picture.iRepeatPicture, asFilm);
+    m_picture.pts = timing.pts;
+    m_picture.iDuration = timing.duration;
+    if (asFilm)
       pts = m_picture.pts;
-    }
-    else
-    {
-      // Hades: the repeated field of a picture lengthens it; it does not move its start
-      const auto timing = KODI::VIDEOPLAYER::RepeatedFieldTiming(pts, m_picture.iDuration,
-                                                                 m_picture.iRepeatPicture);
-      m_picture.iDuration = timing.duration;
-      m_picture.pts = timing.pts;
-    }
     // guess next frame pts. iDuration is always valid
     if (m_speed != 0)
       pts += m_picture.iDuration * m_speed / abs(m_speed);
