From 51d33fbf5e863af0c950c146205ea908e7790a11 Mon Sep 17 00:00:00 2001
From: Craig Carnell <1188869+cscd98@users.noreply.github.com>
Date: Mon, 12 Oct 2026 19:17:22 +0100
Subject: [PATCH] uwp: add libdovi dependency

---
 cmake/modules/FindLibDovi.cmake                             | 1 +
 cmake/platform/windowsstore/windowsstore.cmake              | 2 +-
 cmake/scripts/common/ModuleHelpers.cmake                    | 6 ++++++
 .../scripts/0_package.target-win10-x64.list                 | 1 +
 xbmc/platform/win10/main.cpp                                | 5 +++++
 5 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/cmake/modules/FindLibDovi.cmake b/cmake/modules/FindLibDovi.cmake
index a6bfc41..822dbd4 100644
--- a/cmake/modules/FindLibDovi.cmake
+++ b/cmake/modules/FindLibDovi.cmake
@@ -12,6 +12,7 @@ if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
 
   set(${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC libdovi)
   set(${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME dovi)
+  set(${CMAKE_FIND_PACKAGE_NAME}_SEARCH_PATH_SUFFIXES libdovi)
   set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}_DISABLE_VERSION ON)
 
   SETUP_BUILD_VARS()
diff --git a/cmake/platform/windowsstore/windowsstore.cmake b/cmake/platform/windowsstore/windowsstore.cmake
index 67225e3..5bcba23 100644
--- a/cmake/platform/windowsstore/windowsstore.cmake
+++ b/cmake/platform/windowsstore/windowsstore.cmake
@@ -1,4 +1,4 @@
-set(PLATFORM_REQUIRED_DEPS Effects11)
+set(PLATFORM_REQUIRED_DEPS Effects11 LibDovi)
 set(PLATFORM_REQUIRED_TOOLS EffectsCompiler Msys)
 
 list(APPEND PLATFORM_OPTIONAL_PACKAGES LibAACS LibBDPlus)
diff --git a/cmake/scripts/common/ModuleHelpers.cmake b/cmake/scripts/common/ModuleHelpers.cmake
index 96130f5..7a4cf60 100644
--- a/cmake/scripts/common/ModuleHelpers.cmake
+++ b/cmake/scripts/common/ModuleHelpers.cmake
@@ -790,9 +790,15 @@ macro(SEARCH_EXISTING_PACKAGES)
     set(_search_prefix ${DEPENDS_PATH})
   endif()
 
+  set(_search_path_suffixes)
+  if(${CMAKE_FIND_PACKAGE_NAME}_SEARCH_PATH_SUFFIXES)
+    list(APPEND _search_path_suffixes PATH_SUFFIXES ${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_PATH_SUFFIXES})
+  endif()
+
   find_package(${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME} ${CONFIG_${CMAKE_FIND_PACKAGE_NAME}_FIND_SPEC} CONFIG ${SEARCH_QUIET}
                                                          HINTS ${_search_prefix}/share/cmake
                                                                ${_search_prefix}/lib/cmake
+                                                         ${_search_path_suffixes}
                                                          ${${CORE_SYSTEM_NAME}_SEARCH_CONFIG})
 
   # fallback to pkgconfig to cover all bases
diff --git a/project/BuildDependencies/scripts/0_package.target-win10-x64.list b/project/BuildDependencies/scripts/0_package.target-win10-x64.list
index 55b7eb7..250b58e 100644
--- a/project/BuildDependencies/scripts/0_package.target-win10-x64.list
+++ b/project/BuildDependencies/scripts/0_package.target-win10-x64.list
@@ -14,6 +14,7 @@ libaacs-0.11.1-win10-x64-v143-20260223.7z
 libbdplus-0.2.0-win10-x64-v143-20260223.7z
 libcdio-2.3.0-win10-x64-v143-20260223.7z
 libfribidi-1.0.8-win10-x64-v141-20200105.7z
+libdovi-3.3.2-win10-x64-v143-20261013.7z
 libiconv-1.19-win10-x64-v143-20260403.7z
 libxml2-2.15.1-win10-x64-v143-20260211.7z
 miniwdk-10.0.17763-20200106.7z
diff --git a/xbmc/platform/win10/main.cpp b/xbmc/platform/win10/main.cpp
index 0b5f388..31d60e7 100644
--- a/xbmc/platform/win10/main.cpp
+++ b/xbmc/platform/win10/main.cpp
@@ -10,6 +10,11 @@
 
 #include "platform/win10/Win10App.h"
 
+#ifdef HAVE_LIBDOVI
+#pragma comment(lib, "Kernel32.lib")
+#pragma comment(lib, "Ntdll.lib")
+#endif
+
 using namespace KODI::PLATFORM::WINDOWS10;
 
 int __stdcall WinMain(HINSTANCE, HINSTANCE, PCSTR, int)
-- 
2.53.0

