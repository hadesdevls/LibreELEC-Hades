From eea1e496eae327d478f9e2224ff1ab1ef4c6da02 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 07:39:13 +0000
Subject: [PATCH] input/libinput: carry the fraction of a pixel of each motion
 of the mouse

libinput gives the motion of each report of a mouse in pixels with their
fraction (accelerated, and normalised to a mouse of 1000 dpi).
CLibInputPointer::ProcessMotion() cast it to int, which dropped the fraction
of every report. A mouse reports up to 1000 times a second and more, and at
a slow speed each report is less than a pixel: a slow or precise movement
moved the pointer less than it should, or not at all, and a faster one lost
up to a pixel a report. This is how Kodi has always handled it on GBM and
it is the same in Kodi master; it is the likely cause of a pointer that
"slows down at moments" (test of 1.0 RC3 on hardware, with a NearLink mouse
on a high-speed USB receiver).

The fraction that does not make a pixel yet is now carried to the next
report (CPointerAxis, LibInputPointerAxis.h): the pointer is at the whole
pixel of where the reports add up to, as on a desktop. Against an edge of
the screen it stops there as before and nothing is carried past it; an
absolute position (a touch screen or a tablet through the pointer
interface) starts with nothing carried.

Host test (pointer_axis_test): 1000 reports of 0.4 px move the pointer 400
px (the cast: 0), 500 reports of 1.6 px move it 800 px (the cast: 500), a
random walk of 200000 reports is never more than a pixel from the sum of
its motion; 8 of its 12 checks fail with the code before.
---
 xbmc/platform/linux/input/CMakeLists.txt      |  1 +
 xbmc/platform/linux/input/LibInputPointer.cpp | 16 ++---
 xbmc/platform/linux/input/LibInputPointer.h   |  5 ++
 .../linux/input/LibInputPointerAxis.h         | 66 +++++++++++++++++++
 4 files changed, 78 insertions(+), 10 deletions(-)
 create mode 100644 xbmc/platform/linux/input/LibInputPointerAxis.h

diff --git a/xbmc/platform/linux/input/CMakeLists.txt b/xbmc/platform/linux/input/CMakeLists.txt
index 32b7ce4..7dfed23 100644
--- a/xbmc/platform/linux/input/CMakeLists.txt
+++ b/xbmc/platform/linux/input/CMakeLists.txt
@@ -17,6 +17,7 @@ if("gbm" IN_LIST CORE_PLATFORM_NAME_LC)
     list(APPEND HEADERS LibInputHandler.h
                         LibInputKeyboard.h
                         LibInputPointer.h
+                        LibInputPointerAxis.h
                         LibInputSettings.h
                         LibInputTouch.h)
   endif()
diff --git a/xbmc/platform/linux/input/LibInputPointer.cpp b/xbmc/platform/linux/input/LibInputPointer.cpp
index ccf3abe..cedead9 100644
--- a/xbmc/platform/linux/input/LibInputPointer.cpp
+++ b/xbmc/platform/linux/input/LibInputPointer.cpp
@@ -74,16 +74,10 @@ void CLibInputPointer::ProcessMotion(libinput_event_pointer *e)
   const double dx = libinput_event_pointer_get_dx(e);
   const double dy = libinput_event_pointer_get_dy(e);
 
-  m_pos.X += static_cast<int>(dx);
-  m_pos.Y += static_cast<int>(dy);
-
-  // limit the mouse to the screen width
-  m_pos.X = std::min(CServiceBroker::GetWinSystem()->GetGfxContext().GetWidth(), m_pos.X);
-  m_pos.X = std::max(0, m_pos.X);
-
-  // limit the mouse to the screen height
-  m_pos.Y = std::min(CServiceBroker::GetWinSystem()->GetGfxContext().GetHeight(), m_pos.Y);
-  m_pos.Y = std::max(0, m_pos.Y);
+  // Hades: the fraction of a pixel of each report is carried to the next one, rather than dropped
+  // (see LibInputPointerAxis.h); the pointer is kept to the screen as before
+  m_pos.X = m_axisX.Move(m_pos.X, dx, CServiceBroker::GetWinSystem()->GetGfxContext().GetWidth());
+  m_pos.Y = m_axisY.Move(m_pos.Y, dy, CServiceBroker::GetWinSystem()->GetGfxContext().GetHeight());
 
   XBMC_Event event = {};
 
@@ -104,6 +98,8 @@ void CLibInputPointer::ProcessMotionAbsolute(libinput_event_pointer *e)
 {
   m_pos.X = static_cast<int>(libinput_event_pointer_get_absolute_x_transformed(e, CServiceBroker::GetWinSystem()->GetGfxContext().GetWidth()));
   m_pos.Y = static_cast<int>(libinput_event_pointer_get_absolute_y_transformed(e, CServiceBroker::GetWinSystem()->GetGfxContext().GetHeight()));
+  m_axisX.Reset();
+  m_axisY.Reset();
 
   XBMC_Event event = {};
   event.type = XBMC_MOUSEMOTION;
diff --git a/xbmc/platform/linux/input/LibInputPointer.h b/xbmc/platform/linux/input/LibInputPointer.h
index 608b438..6a26902 100644
--- a/xbmc/platform/linux/input/LibInputPointer.h
+++ b/xbmc/platform/linux/input/LibInputPointer.h
@@ -8,6 +8,8 @@
 
 #pragma once
 
+#include "LibInputPointerAxis.h"
+
 #include <libinput.h>
 
 struct pos
@@ -29,4 +31,7 @@ public:
 
 private:
   struct pos m_pos = { 0, 0 };
+  // (Hades: the fraction of a pixel of each report, carried to the next one)
+  CPointerAxis m_axisX;
+  CPointerAxis m_axisY;
 };
diff --git a/xbmc/platform/linux/input/LibInputPointerAxis.h b/xbmc/platform/linux/input/LibInputPointerAxis.h
new file mode 100644
index 0000000..625cd36
--- /dev/null
+++ b/xbmc/platform/linux/input/LibInputPointerAxis.h
@@ -0,0 +1,66 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cmath>
+
+/*!
+ * \brief One axis of the pointer that a relative device (a mouse) moves
+ *
+ * libinput gives the motion of each report of a mouse in pixels with their fraction (accelerated,
+ * and normalised to a mouse of 1000 dpi), and the pointer is at a whole pixel. The fraction of
+ * each report was dropped (the motion was cast to int): a mouse reports up to 1000 times a second
+ * and more, and at a slow speed each report is less than a pixel, so a slow or precise movement
+ * moved the pointer less than it should, or not at all, and a faster one lost up to a pixel a
+ * report. Here the fraction that does not make a pixel yet is carried to the next report: the
+ * pointer is at the whole pixel of where the reports add up to, as on a desktop.
+ */
+class CPointerAxis
+{
+public:
+  /*!
+   * \brief Moves a position on this axis by the motion of one report
+   * \param position Where the pointer is, in [0, limit]
+   * \param delta The motion that libinput gives for the report, in pixels
+   * \param limit The last position the pointer can take (the width or height of the screen, as
+   * the pointer of Kodi has always been kept to)
+   * \return The new position, in [0, limit]
+   */
+  int Move(int position, double delta, int limit)
+  {
+    if (!std::isfinite(delta))
+      delta = 0.0;
+
+    const double target = static_cast<double>(position) + m_fraction + delta;
+    // (against an edge the pointer stops there, and nothing is kept of what went past it)
+    if (target <= 0.0 || limit <= 0)
+    {
+      m_fraction = 0.0;
+      return 0;
+    }
+    if (target >= static_cast<double>(limit))
+    {
+      m_fraction = 0.0;
+      return limit;
+    }
+
+    const double whole = std::floor(target);
+    m_fraction = target - whole;
+    return static_cast<int>(whole);
+  }
+
+  //! The pointer was put somewhere else (an absolute position): nothing is carried from before
+  void Reset() { m_fraction = 0.0; }
+
+  //! What is carried to the next report, in [0, 1)
+  double Fraction() const { return m_fraction; }
+
+private:
+  double m_fraction{0.0};
+};
-- 
