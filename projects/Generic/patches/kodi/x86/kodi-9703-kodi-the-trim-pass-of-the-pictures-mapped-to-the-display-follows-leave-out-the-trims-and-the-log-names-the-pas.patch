diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index ab946ac..55bb983 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1068,6 +1068,47 @@ void CDVBridgeGLES::LogNotes()
               "level 1 alone (the first picture that has them)",
               l.l1[0], l.l1[1], l.l1[2], l.offset[0], l.offset[1], l.offset[2]);
   }
+  // Hades: the trim pass (level 2) of the metadata in the mapping to the display (dvbridge_trims.h)
+  if (notes.trim_used || notes.trim_identity || notes.trim_none)
+  {
+    const dvbridge_trim& t = notes.trim;
+    std::string targets;
+    for (unsigned i = 0; i < t.blocks && i < 8; ++i)
+      targets += StringUtils::Format("{}{:.0f}", i ? " " : "",
+                                     dvbridge_trim_pq_to_nits(t.targets[i] / 4095.0));
+    if (notes.trim_used)
+      CLog::Log(LOGINFO,
+                "DVBridge: the trim pass (level 2) of the block for {:.0f} cd/m2 (target_max_PQ "
+                "{}) is applied to this stream's pictures mapped to the display (its peak {:.0f} "
+                "cd/m2): slope {:.4f}, offset {:+.4f}, power {:.4f}, chroma weight {:+.4f}, "
+                "saturation gain {:+.4f} (codes {} {} {} {} {}; ETSI TS 103 572 4.3, SMPTE ST "
+                "2094-10 Annex B.3); the blocks of the stream are for {} cd/m2 (the first picture "
+                "that has them)",
+                static_cast<double>(t.target_nits), t.target_pq,
+                static_cast<double>(notes.trim_peak), static_cast<double>(t.gain),
+                static_cast<double>(t.offset), static_cast<double>(t.power),
+                static_cast<double>(t.chroma), static_cast<double>(t.saturation), t.code[0],
+                t.code[1], t.code[2], t.code[3], t.code[4], targets);
+    if (notes.trim_identity)
+      CLog::Log(LOGINFO,
+                "DVBridge: the block of level 2 for the display's peak ({:.0f} cd/m2, "
+                "target_max_PQ {}) has every code at 2048, the trim of no change: nothing to apply "
+                "to this stream's pictures mapped to the display (its blocks are for {} cd/m2; the "
+                "first picture that has them)",
+                static_cast<double>(notes.trim_peak), t.target_pq, targets);
+    if (notes.trim_none)
+      CLog::Log(LOGINFO,
+                "DVBridge: the metadata of this stream have level 2 blocks for {} cd/m2 and none "
+                "for the display's peak ({:.0f} cd/m2): its pictures mapped to the display go out "
+                "without trims (SMPTE ST 2094-10 and ETSI TS 103 572 define no way to take a trim "
+                "pass to another display's peak; the first picture that has them)",
+                targets, static_cast<double>(notes.trim_peak));
+  }
+  if (notes.trim_failed)
+    CLog::Log(LOGWARNING,
+              "DVBridge: the trim pass (level 2) could not be drawn on this GPU: the pictures of "
+              "the rest of this stream mapped to the display go out without it (no picture was "
+              "lost)");
 }
 
 void CDVBridgeGLES::PQTextureDrawn()
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
