+  // Hades: the trim pass (level 2) of the metadata where it is for the display's peak
+  // (dvbridge_trims.h): unless "Dolby Vision: leave out the trims"
+  // (videoscreen.hadesdvnotrims) is on
+  if (mapping.enabled)
+    mapping.trims = !BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVNOTRIMS, false);
   const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
     if (a.enabled != b.enabled)
       return false;
@@ -4481,7 +4486,7 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
       if (a.source_known && a.source_xy[i] != b.source_xy[i])
         return false;
     return a.peak == b.peak && a.gamut == b.gamut && a.curve == b.curve &&
-           a.source_known == b.source_known && a.target == b.target;
+           a.source_known == b.source_known && a.target == b.target && a.trims == b.trims;
   };
   if (!m_dvConvertMappingSet || !same(mapping, m_dvConvertMapping) ||
       plain != m_dvConvertMappingPlain)
@@ -4514,6 +4519,12 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
                 mapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
                 mapping.source_known ? "the gamut of its mastering display"
                                      : "BT.2020 (its mastering display is not known)");
+    if (mapping.enabled && mapping.trims)
+      CLog::Log(LOGINFO,
+                "DVBridge: the trim pass (level 2) of the metadata is applied to pictures mapped "
+                "to a display of {} cd/m2 where a block of its metadata is for that peak (SMPTE ST "
+                "2094-10, ETSI TS 103 572); videoscreen.hadesdvnotrims turns it off",
+                mapping.peak);
     else if (m_dvConvertMappingSet)
       CLog::Log(LOGINFO, "DVBridge: Dolby Vision as HDR10 is sent as mastered, not mapped");
   }
@@ -4537,6 +4548,9 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
     mapping.peak = static_cast<float>(dv.version == 2 ? UTILS::PqLevelToNits(dv.targetMaxPq)
                                                       : dv.targetMaxNits);
     mapping.gamut = DVBRIDGE_HDR10_GAMUT_CUSTOM;
+    // Hades: the trim pass (level 2) where a block is for this peak, unless the trims are left out
+    mapping.trims =
+        !BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVNOTRIMS, false);
     const double xy[8] = {dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY, 0.3127, 0.3290};
     for (int i = 0; i < 8; ++i)
       mapping.target_xy[i] = static_cast<float>(xy[i]);
@@ -4595,7 +4609,7 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
   }
   const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
     if (a.enabled != b.enabled || a.source_known != b.source_known || a.peak != b.peak ||
-        a.black != b.black)
+        a.black != b.black || a.trims != b.trims)
       return false;
     for (int i = 0; i < 8; ++i)
       if (a.target_xy[i] != b.target_xy[i] || a.source_xy[i] != b.source_xy[i])
