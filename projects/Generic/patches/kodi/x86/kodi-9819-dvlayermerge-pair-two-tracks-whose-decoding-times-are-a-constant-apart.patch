+
+void CDVDDemuxFFmpeg::TellDVOffset()
+{
+  const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+  m_dvOffsetsTold = counts.offsets;
+  if (m_dvOffsetLines >= 4 || (counts.offset == 0 && m_dvOffsetLines == 0) ||
+      m_dvBaseIndex < 0 || static_cast<unsigned int>(m_dvBaseIndex) >= m_pFormatContext->nb_streams)
+    return;
+  ++m_dvOffsetLines;
+  const double ms =
+      counts.offset * av_q2d(m_pFormatContext->streams[m_dvBaseIndex]->time_base) * 1000;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision in two tracks: the decoding times of the enhancement "
+            "track (stream {}) are {:.3f} ms {} those of the base track (stream {}), with the "
+            "same pictures in the same order (a random-access picture of both layers presented "
+            "at the same time, and the {} access units after it): its packets pair by their "
+            "decoding time less that{}",
+            m_dvEnhancementIndex, ms < 0 ? -ms : ms, ms < 0 ? "before" : "after", m_dvBaseIndex,
+            CDVLayerMerge::CONFIRM, m_dvOffsetLines == 4 ? " (not told again for this pair)" : "");
 }
 #endif
 
@@ -1599,6 +1631,8 @@ int CDVDDemuxFFmpeg::ReadFrame(AVPacket* packet)
     const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
     if (!m_dvReported && counts.joined + counts.alone >= FIRST_REPORT)
       ReportDVLayers();
+    if (counts.offsets != m_dvOffsetsTold)
+      TellDVOffset();
     CheckDVLayers();
     return result;
   }
