+// Hades: a packet of the enhancement track with its decoding time less the offset (CONFIRM), the
+// time by which it pairs; a time that does not fit is not known.
+CDVLayerMerge::Waiting CDVLayerMerge::ShiftedBy(const Waiting& enhancement, int64_t offset)
+{
+  Waiting shifted = enhancement;
+  if (offset && shifted.time != AV_NOPTS_VALUE)
+  {
+    const bool fits = offset > 0 ? shifted.time >= std::numeric_limits<int64_t>::min() + 1 + offset
+                                 : shifted.time <= std::numeric_limits<int64_t>::max() + offset;
+    shifted.time = fits ? shifted.time - offset : AV_NOPTS_VALUE;
+  }
+  return shifted;
+}
+
+// Hades: two presentation times of the two tracks are the same picture time: exactly, or within the
+// rounding of the time base of the enhancement track taken to the one of the base track.
+bool CDVLayerMerge::SamePresentation(int64_t base, int64_t enhancement) const
+{
+  if (base == AV_NOPTS_VALUE || enhancement == AV_NOPTS_VALUE)
+    return false;
+  const bool converted = KnownTimeBase(m_timeBase) && KnownTimeBase(m_enhancementTimeBase) &&
+                         !SameTimeBase(m_timeBase, m_enhancementTimeBase);
+  const uint64_t apart = base > enhancement
+                             ? static_cast<uint64_t>(base) - static_cast<uint64_t>(enhancement)
+                             : static_cast<uint64_t>(enhancement) - static_cast<uint64_t>(base);
+  return apart <= (converted ? 1u : 0u);
+}
+
+// Hades: whether a packet holds a random-access picture. Only one that its container marks as a
+// key packet is looked into (once), so that the units of every packet are not walked through.
+bool CDVLayerMerge::IsRandomAccess(Waiting& waiting, int lengthSize)
+{
+  if (waiting.random < 0)
+    waiting.random = (waiting.packet->flags & AV_PKT_FLAG_KEY) &&
+                             RandomAccess(waiting.packet->data,
+                                          static_cast<size_t>(std::max(waiting.packet->size, 0)),
+                                          lengthSize)
+                         ? 1
+                         : 0;
+  return waiting.random == 1;
+}
+
+// Hades: see CONFIRM. True while the base packet at the front waits for the access units that tell
+// whether the offset of its random-access picture holds.
+bool CDVLayerMerge::LearnOffset(bool end)
+{
+  Waiting& base = m_base.waiting.front();
+  if (m_fromPresentation || base.checked || base.pts == AV_NOPTS_VALUE ||
+      base.time == AV_NOPTS_VALUE)
+    return false;
+  if (!IsRandomAccess(base, m_base.lengthSize))
+  {
+    base.checked = true;
+    return false;
+  }
+  const int64_t most =
+      KnownTimeBase(m_timeBase) ? av_rescale(MAX_OFFSET, m_timeBase.den, m_timeBase.num) : 0;
+  // the enhancement packet of a random-access picture presented with it (it may still come: then
+  // this is looked at again while the base packet waits)
+  std::deque<Waiting>& layer = m_enhancement.waiting;
+  auto at = layer.begin();
+  for (; at != layer.end(); ++at)
+  {
+    if (at->time != AV_NOPTS_VALUE && SamePresentation(base.pts, at->pts) &&
+        IsRandomAccess(*at, m_enhancement.lengthSize))
+      break;
+  }
+  if (at == layer.end())
+  {
+    // None yet. The enhancement packet that it pairs with now: where that is of a random-access
+    // picture too, both layers start a group of pictures at this offset, and there is nothing to
+    // look for. Where it is not, an enhancement layer that is behind in decoding time brings the
+    // packet of the same picture later, after the one it pairs with now: the base packet waits
+    // for the enhancement packets of up to MAX_OFFSET seconds after its decoding time. (Where it
+    // pairs with none yet, it waits as it always does, and this is looked at again.)
+    const auto now = std::find_if(layer.begin(), layer.end(), [this, &base](const Waiting& e)
+                                  { return SameUnit(base, Shifted(e)); });
+    if (now == layer.end())
+      return false;
+    const Waiting last = Shifted(layer.back());
+    const bool reached = most <= 0 || last.time == AV_NOPTS_VALUE ||
+                         base.time > std::numeric_limits<int64_t>::max() - most ||
+                         last.time >= base.time + most;
+    if (!IsRandomAccess(*now, m_enhancement.lengthSize) && !reached && !end &&
+        m_silent < m_silentAfter && m_base.waiting.size() < MAX_WAITING &&
+        layer.size() < MAX_QUEUED)
+      return true;
+    base.checked = true;
+    return false;
+  }
+
+  const bool fits = base.time >= 0 ? at->time >= std::numeric_limits<int64_t>::min() + base.time
+                                   : at->time <= std::numeric_limits<int64_t>::max() + base.time;
+  const int64_t offset = fits ? at->time - base.time : 0;
+  if (!fits || offset == m_offset || most <= 0 || offset > most || offset < -most)
+  {
+    base.checked = true;
+    return false;
+  }
+
+  // the CONFIRM access units after the two, pairwise presented at the same time and of the same
+  // access unit by that offset
+  const size_t first = static_cast<size_t>(at - layer.begin());
+  const size_t have = std::min(m_base.waiting.size() - 1, layer.size() - 1 - first);
+  if (have < CONFIRM && !end && m_silent < m_silentAfter && m_base.waiting.size() < MAX_WAITING &&
+      layer.size() < MAX_QUEUED)
+    return true;
+  bool same = have >= CONFIRM;
+  for (size_t k = 1; same && k <= CONFIRM; ++k)
+    same = SamePresentation(m_base.waiting[k].pts, layer[first + k].pts) &&
+           SameUnit(m_base.waiting[k], ShiftedBy(layer[first + k], offset));
+  base.checked = true;
+  if (!same)
+  {
+    m_counts.unconfirmed++;
+    return false;
+  }
+  m_offset = offset;
+  m_counts.offset = offset;
+  m_counts.offsets++;
+  return false;
+}
