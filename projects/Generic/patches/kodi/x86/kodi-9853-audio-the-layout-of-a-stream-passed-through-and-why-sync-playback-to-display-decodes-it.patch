From e59789dae739f611de11d9f9579ea7f0d31aafdc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:46:05 +0000
Subject: [PATCH] audio: the layout of a stream passed through, and why "Sync
 playback to display" decodes it

- The "Layout" row of the player information gave "RAW" for audio that
  is passed through: Player.Process(audiochannels) took the layout of the
  sink, which then is that of the IEC 61937 carrier. It now gives the
  layout of the stream as its demuxer says it (a 7.1 track: its eight
  channels by name); the row of the output signal still says IEC 61937
  and its channels. Decoded audio is as before. Not seen on a screen.
- With "Sync playback to display" on, Kodi never passes audio through:
  it adjusts the speed of the sound to the display's clock, which it
  cannot do with sound that is passed through (as in Kodi; issue #71 of
  CroqueMr's build, where everything came out as PCM and nothing said
  why). kodi.log now says so for each audio stream that would pass
  through otherwise ("this audio is decoded to PCM, not passed through:
  \"Sync playback to display\" is on"), and the audio output row of the
  overview says "PCM, decoded (Sync playback to display: Enabled)", in
  Kodi's own strings (#13510, #305), so in every language
  (hades.audio.why, LIVEAUDIO::SyncToDisplayKeepsPassthrough()).
---
 addons/skin.estuary/xml/Variables.xml         |  3 ++
 system/hades/HadesIncludes.xml                |  1 +
 xbmc/cores/VideoPlayer/LivePassthrough.h      | 18 ++++++++++
 xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp   | 35 ++++++++++++++++++-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  5 +++
 5 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index f433dc1..9b4b486 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -973,6 +973,9 @@
 	</variable>
 	<variable name="HadesAudioOutVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),none)">$LOCALIZE[31822]</value>
+		<!-- (Hades: decoded because "Sync playback to display" is on, hades.audio.why: as in Kodi, sound
+		     that is passed through cannot follow the display's clock) -->
+		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),pcm) + String.IsEqual(Window(Home).Property(hades.audio.why),syncdisplay)">$LOCALIZE[31821] ($LOCALIZE[13510]: $LOCALIZE[305])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),pcm)">$LOCALIZE[31821]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),bitstream)">$VAR[HadesAudioBitstreamVar]$VAR[HadesAudioBitstreamHowVar, (,)]</value>
 		<value>$LOCALIZE[31853]</value>
diff --git a/system/hades/HadesIncludes.xml b/system/hades/HadesIncludes.xml
index 8cf6e7c..c66c123 100644
--- a/system/hades/HadesIncludes.xml
+++ b/system/hades/HadesIncludes.xml
@@ -36,6 +36,7 @@
 	</variable>
 	<variable name="HadesAudioOutVar">
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),none)">$ADDON[skin.estuary 31822]</value>
+		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),pcm) + String.IsEqual(Window(Home).Property(hades.audio.why),syncdisplay)">$ADDON[skin.estuary 31821] ($LOCALIZE[13510]: $LOCALIZE[305])</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),pcm)">$ADDON[skin.estuary 31821]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.audio.path),bitstream)">$VAR[HadesAudioBitstreamVar]$VAR[HadesAudioBitstreamHowVar, (,)]</value>
 		<value>$ADDON[skin.estuary 31853]</value>
diff --git a/xbmc/cores/VideoPlayer/LivePassthrough.h b/xbmc/cores/VideoPlayer/LivePassthrough.h
index 8dc89fc..5cca895 100644
--- a/xbmc/cores/VideoPlayer/LivePassthrough.h
+++ b/xbmc/cores/VideoPlayer/LivePassthrough.h
@@ -63,4 +63,22 @@ constexpr bool RemakeCodecWhenRealtime(bool livePassthrough)
 {
   return !livePassthrough;
 }
+
+/*!
+ * \brief Hades: whether "Sync playback to display" is what keeps the audio of a stream from
+ *        passing through: it is on, and the audio engine would pass that stream through
+ *        (CAudioSinkAE::GetPassthroughStreamType() names a type: passthrough is on for its codec and
+ *        the output takes it). As in Kodi: with that setting the speed of decoded sound is adjusted
+ *        to the display's clock, which cannot be done with sound that is passed through (issue #71
+ *        of CroqueMr's build: everything came out as PCM, and nothing said why).
+ */
+constexpr bool SyncToDisplayKeepsPassthrough(bool syncToDisplay, bool wouldPassThrough)
+{
+  return syncToDisplay && wouldPassThrough;
+}
+
+//! ... for the audio stream that plays (CVideoPlayerAudio, when its codec is made), for the player
+//! information (hades.audio.why)
+void SetSyncToDisplayKeepsPassthrough(bool keeps);
+bool SyncToDisplayKeepsPassthroughNow();
 } // namespace LIVEAUDIO
diff --git a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
index b4f149b..ee0f926 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerAudio.cpp
@@ -20,6 +20,7 @@
 #include "utils/MathUtils.h"
 #include "utils/log.h"
 
+#include <atomic>
 #include <mutex>
 
 #ifdef TARGET_RASPBERRY_PI
@@ -94,6 +95,22 @@ CVideoPlayerAudio::CVideoPlayerAudio(CDVDClock* pClock,
   m_disconAdjustTimeMs = processInfo.GetMaxPassthroughOffSyncDuration();
 }
 
+namespace
+{
+// Hades: LIVEAUDIO::SyncToDisplayKeepsPassthrough() for the audio stream that plays
+std::atomic<bool> g_syncToDisplayKeepsPassthrough{false};
+} // namespace
+
+void LIVEAUDIO::SetSyncToDisplayKeepsPassthrough(bool keeps)
+{
+  g_syncToDisplayKeepsPassthrough = keeps;
+}
+
+bool LIVEAUDIO::SyncToDisplayKeepsPassthroughNow()
+{
+  return g_syncToDisplayKeepsPassthrough;
+}
+
 CVideoPlayerAudio::~CVideoPlayerAudio()
 {
   StopThread();
@@ -118,6 +135,17 @@ bool CVideoPlayerAudio::OpenStream(CDVDStreamInfo hints)
 
   CAEStreamInfo::DataType streamType =
       m_audioSink.GetPassthroughStreamType(hints.codec, hints.samplerate, hints.profile);
+  // Hades: say so when "Sync playback to display" is what keeps this audio from passing through
+  // (as Kodi does it; the player information says it too)
+  const bool syncKeeps = LIVEAUDIO::SyncToDisplayKeepsPassthrough(
+      syncToDisplay, streamType != CAEStreamInfo::STREAM_TYPE_NULL);
+  LIVEAUDIO::SetSyncToDisplayKeepsPassthrough(syncKeeps);
+  if (syncKeeps)
+    CLog::Log(LOGINFO,
+              "CVideoPlayerAudio: this audio is decoded to PCM, not passed through: \"Sync playback "
+              "to display\" is on (Settings > Player > Videos), and with it Kodi adjusts the speed "
+              "of the sound to the display's clock, which it cannot do with sound that is passed "
+              "through. Turn it off to pass this audio through");
   std::unique_ptr<CDVDAudioCodec> codec = CDVDFactoryCodec::CreateAudioCodec(
       hints, m_processInfo, allowpassthrough, m_processInfo.AllowDTSHDDecode(), streamType);
   if(!codec)
@@ -724,7 +752,12 @@ bool CVideoPlayerAudio::ProcessDecoderOutput(DVDAudioFrame &audioframe)
       m_messageParent.Put(std::make_shared<CDVDMsgType<SStartMsg>>(CDVDMsg::PLAYER_STARTED, msg));
 
       m_streaminfo.channels = audioframe.format.m_channelLayout.Count();
-      m_processInfo.SetAudioChannels(audioframe.format.m_channelLayout);
+      // Hades: passed through, the sink's layout is that of the IEC 61937 carrier ("RAW"): the
+      // player information's "Layout" gives the stream's own, as its demuxer says it
+      if (audioframe.format.m_dataFormat == AE_FMT_RAW && m_streaminfo.channellayout)
+        m_processInfo.SetAudioChannels(CAEUtil::GetAEChannelLayout(m_streaminfo.channellayout));
+      else
+        m_processInfo.SetAudioChannels(audioframe.format.m_channelLayout);
       m_processInfo.SetAudioSampleRate(audioframe.format.m_sampleRate);
       m_processInfo.SetAudioBitsPerSample(audioframe.bits_per_sample);
       m_processInfo.SetAudioDecoderName(m_pAudioCodec->GetName());
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 4a6287f..2d1d804 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -109,6 +109,7 @@ extern "C"
 #include "DVEndOfStream.h"
 #include "DVLatency.h"
 #include "DVPassTimes.h"
+#include "cores/VideoPlayer/LivePassthrough.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVOutputMemory.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h"
 #include "cores/VideoPlayer/DVDStreamInfo.h"
@@ -7898,6 +7899,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.out.primaries", ""}, {"hades.out.cll", ""},       {"hades.audio.path", ""},
       {"hades.audio.format", ""},  {"hades.audio.channels", ""}, {"hades.audio.rate", ""},
       {"hades.audio.bits", ""},    {"hades.audio.srcrate", ""}, {"hades.audio.srcbits", ""},
+      {"hades.audio.why", ""},
       {"hades.audio.bitrate", ""}, {"hades.video.size", ""},    {"hades.video.bitrate", ""},
       {"hades.sys.cpu", ""},       {"hades.sys.memory", ""},    {"hades.sys.gpu", ""},
       {"hades.sys.gputemp", ""},   {"hades.sys.gpuread", ""},
@@ -8108,6 +8110,9 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
         else
         {
           info["hades.audio.path"] = "pcm";
+          // (Hades: "Sync playback to display" keeps it from passing through: as Kodi does it)
+          if (LIVEAUDIO::SyncToDisplayKeepsPassthroughNow())
+            info["hades.audio.why"] = "syncdisplay";
           info["hades.audio.bits"] =
               sink.m_dataFormat == AE_FMT_FLOAT || sink.m_dataFormat == AE_FMT_DOUBLE ||
                       sink.m_dataFormat == AE_FMT_FLOATP || sink.m_dataFormat == AE_FMT_DOUBLEP
