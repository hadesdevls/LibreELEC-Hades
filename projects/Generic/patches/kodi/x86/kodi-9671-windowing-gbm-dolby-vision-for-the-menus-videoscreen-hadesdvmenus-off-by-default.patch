+/*!
+ * \brief Hades: Dolby Vision for the menus (videoscreen.hadesdvmenus, off by default)
+ *
+ * While no video plays, Kodi's GUI goes out in the transport of native Dolby Vision output: each frame
+ * that Kodi draws is the GUI made PQ at the white of "GUI and subtitle brightness in HDR" (the LUTs that
+ * compose it over HDR video), over black, with static metadata (dvbridge_graphics.h), and frames are sent
+ * only when Kodi draws one. A native Dolby Vision video then takes the output over (CDVModeMove::HandsOver()):
+ * the TV does not change its picture mode, and a change of refresh rate goes out with the next frame of the
+ * transport; at its end the output goes back to the menus the same way. Any other video (SDR, HDR10, HDR10+,
+ * HLG, Dolby Vision that does not go out natively) ends the menus' transport with its change of mode, or
+ * before its picture, and the menus go out in Dolby Vision again once nothing is left of it. That is two
+ * changes of the TV's picture mode more for each such video: why it is a setting.
+ *
+ * This class decides only: Start() whether they may start now, Stays() whether they go on, AfterVideo()
+ * whether a native video that ends hands the output back to them; and the wait after a failure. Fail closed:
+ * anything that is not known to be right keeps the ordinary output (SDR menus, as without the setting).
+ */
+class CDVMenus
+{
+public:
+  //! Why the menus do not go out in Dolby Vision (NONE: they can), in the order Start() asks
+  enum class Why
+  {
+    NONE,
+    SETTING, //!< the setting is off
+    NATIVE_OFF, //!< native Dolby Vision output is turned off (videoscreen.hadesdvnative)
+    DISABLED, //!< native output is disabled after a failure of a video, until a later video
+    SIGNAL, //!< the display is sent Low-Latency or the HDMI 1.4b signalling, not the Standard mode
+    WINDOW, //!< the menus are not 3840x2160 in an 8-bit surface with OpenGL ES 3
+    DISPLAY, //!< native output is not possible here now (display, output, mode, rate, range)
+    VIDEO, //!< a video or a game plays, or one opens
+    BUSY, //!< the output carries more than the menus (HDR signalling, a hold of a change of mode...)
+    ASLEEP, //!< the display is put to sleep, or the system has just woken
+    REGIONS, //!< advancedsettings.xml asks for partial redraws (algorithmdirtyregions 1 or 2)
+    STEREO, //!< the GUI is drawn in stereoscopic 3D
+    LOOK, //!< a hot-plug event of the display came, and it has not been looked at since
+    FAILED, //!< they failed, and the wait before they are tried again is not over
+  };
+
+  struct State
+  {
+    bool setting = false;
+    bool nativeOff = false;
+    bool disabled = false;
+    bool standard = false; //!< the display is sent the Standard mode (not Low-Latency, not HDMI 1.4b)
+    bool window = false; //!< 3840x2160, an 8-bit surface, OpenGL ES 3
+    bool possible = false; //!< native output is possible in the mode on the output now
+    bool video = false;
+    bool busy = false;
+    bool asleep = false;
+    bool regions = false;
+    bool stereo = false;
+    bool looked = true; //!< the display was looked at since the last hot-plug event of its device
+  };
+
+  //! Whether they may start now (asked while they are off), and else the first reason
+  static Why Start(const State& s, bool waiting)
+  {
+    if (!s.setting)
+      return Why::SETTING;
+    if (s.nativeOff)
+      return Why::NATIVE_OFF;
+    if (s.disabled)
+      return Why::DISABLED;
+    if (s.video)
+      return Why::VIDEO;
+    if (s.asleep)
+      return Why::ASLEEP;
+    if (!s.looked)
+      return Why::LOOK;
+    if (s.busy)
+      return Why::BUSY;
+    if (s.regions)
+      return Why::REGIONS;
+    if (s.stereo)
+      return Why::STEREO;
+    if (!s.window)
+      return Why::WINDOW;
+    if (!s.standard)
+      return Why::SIGNAL;
+    if (!s.possible)
+      return Why::DISPLAY;
+    if (waiting)
+      return Why::FAILED;
+    return Why::NONE;
+  }
+
+  /*!
+   * \brief What ends them while they go out (asked with every frame, cheaply): the setting, native output
+   *        turned off, the display put to sleep, a hot-plug event (the display may have dropped Dolby Vision:
+   *        it is looked at again before they start again), a game, the GUI in 3D. A video's own changes of the
+   *        output and of the mode are handled where they happen (SetVideoOutput(), SetFullScreen()).
+   * \param hotplug a hot-plug event came since they started
+   * \param game a game plays (RetroPlayer draws it as GUI)
+   */
+  static Why Stays(const State& s, bool hotplug, bool game)
+  {
+    if (!s.setting)
+      return Why::SETTING;
+    if (s.nativeOff)
+      return Why::NATIVE_OFF;
+    if (s.asleep)
+      return Why::ASLEEP;
+    if (hotplug)
+      return Why::LOOK;
+    if (game)
+      return Why::VIDEO;
+    if (s.stereo)
+      return Why::STEREO;
+    return Why::NONE;
+  }
+
+  struct After
+  {
+    bool setting = false;
+    bool nativeOff = false;
+    bool standard = false; //!< the video's output was the Standard mode
+    bool live = false; //!< its transport is on the output
+    bool window = false; //!< 3840x2160 in an 8-bit surface: the video's, which the menus keep
+    //! the mode that Kodi goes back to after the video (or the mode on the output, where none is set)
+    //! is a mode of the transport at a rate that the display takes for native output
+    bool modeAfter = false;
+    bool asleep = false;
+    bool regions = false;
+    bool hotplug = false; //!< a hot-plug event came during the video
+  };
+
+  //! Whether a native video that ends hands the output back to the menus, instead of restoring it
+  static bool AfterVideo(const After& a, bool waiting)
+  {
+    return a.setting && !a.nativeOff && a.standard && a.live && a.window && a.modeAfter && !a.asleep &&
+           !a.regions && !a.hotplug && !waiting;
+  }
+
+  //! The wait after a failure: 30 s after the first, 5 minutes after the second; after the third, until the
+  //! display changes, the setting is turned off and on again, or Kodi starts again (Forgive()).
+  static constexpr int64_t FIRST_WAIT_MS = 30000;
+  static constexpr int64_t SECOND_WAIT_MS = 300000;
+  void Failed(int64_t nowMs)
+  {
+    m_failures++;
+    m_failedAt = nowMs;
+  }
+  bool Waiting(int64_t nowMs) const
+  {
+    if (m_failures == 0)
+      return false;
+    if (m_failures >= 3)
+      return true;
+    const int64_t wait = m_failures == 1 ? FIRST_WAIT_MS : SECOND_WAIT_MS;
+    return nowMs - m_failedAt < wait;
+  }
+  void Forgive() { m_failures = 0; }
+  unsigned int Failures() const { return m_failures; }
+
+  //! A reason is told in the log when it is another one than the last told (NONE included: it is told
+  //! that they start)
+  bool Tell(Why why)
+  {
+    if (m_told == why && m_toldOnce)
+      return false;
+    m_told = why;
+    m_toldOnce = true;
+    return true;
+  }
+  void TellAgain() { m_toldOnce = false; }
+
+  static const char* Text(Why why)
+  {
+    switch (why)
+    {
+      case Why::NONE:
+        return "they can";
+      case Why::SETTING:
+        return "the setting is off";
+      case Why::NATIVE_OFF:
+        return "native Dolby Vision output is turned off (System > Display)";
+      case Why::DISABLED:
+        return "native Dolby Vision output is disabled after a failure of a video";
+      case Why::SIGNAL:
+        return "the display is sent Dolby Vision Low-Latency or the HDMI 1.4b signalling, for which the "
+               "player maps the picture: only the Standard mode carries the menus";
+      case Why::WINDOW:
+        return "the menus are not at 3840x2160 (System > Display > Resolution), in an 8-bit window with "
+               "OpenGL ES 3";
+      case Why::DISPLAY:
+        return "native Dolby Vision output is not possible in the mode of the menus (the line of native "
+               "output above says why)";
+      case Why::VIDEO:
+        return "a video or a game plays, or one opens";
+      case Why::BUSY:
+        return "the output still carries what a video left (HDR signalling, a change of mode that waits)";
+      case Why::ASLEEP:
+        return "the display is put to sleep, or the system has just woken";
+      case Why::REGIONS:
+        return "advancedsettings.xml asks for partial redraws of the GUI (algorithmdirtyregions 1 or 2), "
+               "which the menus in Dolby Vision cannot take";
+      case Why::STEREO:
+        return "the GUI is drawn in stereoscopic 3D";
+      case Why::LOOK:
+        return "the display sent a hot-plug event: it is looked at again first";
+      case Why::FAILED:
+        return "they failed, and are tried again later (after 30 s, then after 5 minutes, then when the "
+               "display changes or the setting is turned off and on)";
+    }
+    return "";
+  }
+
+private:
+  unsigned int m_failures = 0;
+  int64_t m_failedAt = 0;
+  Why m_told = Why::NONE;
+  bool m_toldOnce = false;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
