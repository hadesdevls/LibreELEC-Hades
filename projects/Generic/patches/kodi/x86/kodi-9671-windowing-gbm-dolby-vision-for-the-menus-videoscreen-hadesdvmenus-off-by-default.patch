+// Hades: Dolby Vision for the menus (videoscreen.hadesdvmenus; CDVMenus, dvbridge_graphics.h)
+namespace
+{
+bool DVMenusSetting()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVMENUS, false);
+}
+
+// native output turned off in the settings, as they say now (CWinSystemGbm::DVTurnedOff() is read for each
+// video, and is that of the last one)
+bool DVNativeSettingOff()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return !BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVNATIVE, true);
+}
+
+// advancedsettings.xml asks for partial redraws of the GUI: the GUI's FBO, cleared for each frame, would hold
+// only what changed, and a frame of the menus is made of all of it
+bool DVMenusPartialRedraws()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  return advanced && (advanced->m_guiAlgorithmDirtyRegions == DIRTYREGION_SOLVER_UNION ||
+                      advanced->m_guiAlgorithmDirtyRegions == DIRTYREGION_SOLVER_COST_REDUCTION);
+}
+
+// a reason that lasts is told as information; one that passes on its own (a video, what a video left, the
+// display asleep or looked at again), only for debugging
+bool DVMenusReasonLasts(CDVMenus::Why why)
+{
+  using Why = CDVMenus::Why;
+  return why != Why::NONE && why != Why::SETTING && why != Why::VIDEO && why != Why::BUSY &&
+         why != Why::ASLEEP && why != Why::LOOK;
+}
+
+// how long a display that sent a hot-plug event is left to settle before it is looked at for the menus
+constexpr int64_t DV_MENUS_SETTLE_MS = 3000;
+// how long after a wake from a suspend the menus wait
+constexpr auto DV_MENUS_AFTER_WAKE = std::chrono::seconds(5);
+} // namespace
+
+CDVMenus::State CWinSystemGbmGLESContext::DVMenusState(bool forStart)
+{
+  CDVMenus::State s;
+  s.setting = DVMenusSetting();
+  s.nativeOff = DVNativeSettingOff();
+  s.disabled = NativeDVOutputDisabled();
+  const auto now = std::chrono::steady_clock::now();
+  s.asleep = m_displayAsleep ||
+             (m_wokeAt != std::chrono::steady_clock::time_point{} && now - m_wokeAt < DV_MENUS_AFTER_WAKE);
+  s.stereo = GetGfxContext().GetStereoMode() != RenderStereoMode::OFF;
+  s.regions = DVMenusPartialRedraws();
+  if (!forStart)
+    return s;
+  const auto& components = CServiceBroker::GetAppComponents();
+  const auto player = components.GetComponent<CApplicationPlayer>();
+  s.video = (player && (player->IsPlayingVideo() || player->IsPlayingGame())) || m_dvRendererNative ||
+            g_modeChangeOutput != 0;
+  // (what is left of a video on the output, a change of mode held, an output that a flip that did not come
+  // turned off; and the composition of the GUI over HDR, which the renderer of an HDR video has on)
+  s.busy = CWinSystemGbm::OutputMoveBlocked() || m_dvEndDeferred || m_dvMovePending || m_dvHandOver ||
+           m_flipOutputOff || m_guiCompositing;
+  s.looked = DVMenusDisplayLooked();
+  s.window = m_nWidth == DVBRIDGE::TRANSPORT_WIDTH && m_nHeight == DVBRIDGE::TRANSPORT_HEIGHT &&
+             GetOutputBitDepth() == 8 && m_renderableType == EGL_OPENGL_ES3_BIT;
+  s.standard = NativeDVSignal() == DV_DISPLAY::Signal::STANDARD;
+  // (asked last, by DVMenusUpdate(): SupportsNativeDVOutput() logs what changes in it)
+  s.possible = true;
+  return s;
+}
+
+void CWinSystemGbmGLESContext::DVMenusUpdate()
+{
+  m_dvMenusTarget = false;
+  if (m_dvMenus)
+  {
+    const auto& components = CServiceBroker::GetAppComponents();
+    const auto player = components.GetComponent<CApplicationPlayer>();
+    const auto why = CDVMenus::Stays(DVMenusState(false), DVMenusHotplugs() != m_dvMenusHotplugs,
+                                     player && player->IsPlayingGame());
+    if (why != CDVMenus::Why::NONE)
+      DVMenusEnd(CDVMenus::Text(why), false);
+    return;
+  }
+  // (while they are off, asked twice a second at most; nothing at all while the setting is off, which is the
+  // default, but that turning it off and on again forgives what failed)
+  const auto now = std::chrono::steady_clock::now();
+  if (now - m_dvMenusAsked < std::chrono::milliseconds(500))
+    return;
+  m_dvMenusAsked = now;
+  if (!DVMenusSetting())
+  {
+    if (m_dvMenusPolicy.Failures())
+      m_dvMenusPolicy.Forgive();
+    m_dvMenusPolicy.TellAgain();
+    return;
+  }
+  CDVMenus::State s = DVMenusState(true);
+  // a display that sent a hot-plug event is looked at once it has settled, while nothing plays (as a video
+  // that starts looks at it): it may have dropped Dolby Vision, or be another one
+  if (!s.looked && !s.video)
+  {
+    bool another = false;
+    if (DVMenusLookAtDisplay(DV_MENUS_SETTLE_MS, another))
+    {
+      s.looked = DVMenusDisplayLooked();
+      if (another && m_dvMenusPolicy.Failures())
+      {
+        m_dvMenusPolicy.Forgive();
+        CLog::Log(LOGINFO, "DVBridge: the display changed: the menus in Dolby Vision are tried again");
+      }
+    }
+  }
+  const auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count();
+  const bool waiting = m_dvMenusPolicy.Waiting(nowMs);
+  auto why = CDVMenus::Start(s, waiting);
+  if (why == CDVMenus::Why::NONE)
+  {
+    s.possible = SupportsNativeDVOutput();
+    why = CDVMenus::Start(s, waiting);
+  }
+  if (why == CDVMenus::Why::NONE)
+  {
+    if (!DVMenusBegin())
+    {
+      m_dvMenusPolicy.Failed(nowMs);
+      m_dvMenusPolicy.TellAgain();
+      CLog::Log(LOGWARNING,
+                "DVBridge: the menus could not go out in Dolby Vision (native output did not start: the "
+                "line above says why); they stay as they are, and are tried again later");
+    }
+    return;
+  }
+  if (m_dvMenusPolicy.Tell(why))
+    CLog::Log(DVMenusReasonLasts(why) ? LOGINFO : LOGDEBUG,
+              "DVBridge: the menus do not go out in Dolby Vision: {}", CDVMenus::Text(why));
+}
+
+bool CWinSystemGbmGLESContext::DVMenusBegin()
+{
+  if (!BeginDVBridge())
+  {
+    // (a capture made before what failed after it is given back)
+    if (m_dvState.Captured())
+      EndDVBridge();
+    return false;
+  }
+  m_dvMenus = true;
+  m_dvMenusShown = false;
+  m_dvMenusFrames = 0;
+  m_dvMenusWhite = 0;
+  m_dvMenusPrepareFailed = false;
+  m_dvMenusHotplugs = DVMenusHotplugs();
+  m_dvMenusVideo = 0;
+  m_dvFromMenus = false;
+  m_dvMenusPolicy.Tell(CDVMenus::Why::NONE);
+  // a frame now, which starts the transport
+  if (auto* gui = CServiceBroker::GetGUI())
+    gui->GetWindowManager().MarkDirty();
+  CLog::Log(LOGINFO, "DVBridge: the menus go out in Dolby Vision from the next frame (Dolby Vision for the "
+                     "menus is on)");
+  return true;
+}
+
+void CWinSystemGbmGLESContext::DVMenusEnd(const char* why, bool failed)
+{
+  if (!m_dvMenus)
+    return;
+  const auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
+  if (failed)
+    m_dvMenusPolicy.Failed(nowMs);
+  m_dvMenusPolicy.TellAgain();
+  CLog::Log(failed ? LOGWARNING : LOGINFO,
+            "DVBridge: the menus leave Dolby Vision ({} frames sent): {}{}", m_dvMenusFrames, why,
+            failed ? (m_dvMenusPolicy.Failures() >= 3
+                          ? "; not tried again until the display changes, the setting is turned off and "
+                            "on, or Kodi starts again"
+                          : "; tried again later")
+                   : "");
+  // (the ordinary output comes back; where the driver refuses the restoration, it is made again once a
+  // second, as after a video: PresentRender())
+  if (!EndDVBridge())
+    CLog::Log(LOGWARNING, "DVBridge: the ordinary output could not be restored at once for the menus: "
+                          "tried again");
+  m_dvMenusVideo = 0;
+}
+
+void CWinSystemGbmGLESContext::DVMenusStop(const char* why)
+{
+  if (m_dvMenus)
+    DVMenusEnd(why, false);
+}
+
+bool CWinSystemGbmGLESContext::DVMenusPrepare()
+{
+  if (!m_dvBridge || !m_compositeShader)
+  {
+    m_dvMenusPrepareFailed = true;
+    return false;
+  }
+  // the white of the LUTs that compose the GUI now (videoscreen.hadesguiwhite, which applies at once)
+  const int white = m_compositeShader->GetReferenceWhite();
+  if (!m_dvBridge->PrepareGraphics(white, white != m_dvMenusWhite))
+  {
+    m_dvMenusPrepareFailed = true;
+    return false;
+  }
+  if (white != m_dvMenusWhite)
+  {
+    dvbridge_graphics_range range{};
+    if (CDVBridgeGLES::GraphicsRange(white, range))
+      CLog::Log(LOGINFO,
+                "DVBridge: the menus go out in Dolby Vision with the GUI's white at {:.1f} cd/m2 ({} % of "
+                "203); metadata: the source display {} to {} and level 1 {}, {}, {} (minimum, maximum, "
+                "average; 12-bit PQ codes), level 5 the whole raster, no trims",
+                2.03 * white, white, range.source_min, range.source_max, range.min, range.max,
+                range.avg);
+  }
+  m_dvMenusWhite = white;
+  m_dvFrame = true;
+  return true;
+}
+
+void CWinSystemGbmGLESContext::PresentDVMenus(bool rendered)
+{
+  m_dvDrawnOver = false;
+  if (!rendered)
+  {
+    // Nothing new was drawn: the display keeps the last frame, metadata and all. (A frame that was prepared
+    // for a GUI that did not draw is dropped.)
+    if (m_dvFrame && m_dvBridge)
+      m_dvBridge->Presented(false);
+    m_dvFrame = false;
+    m_dvMenusPrepareFailed = false;
+    KODI::TIME::Sleep(10ms);
+    return;
+  }
+  // a GUI that drew nothing over the black (CompositeGui() prepared no frame): a black frame of the menus
+  if (m_dvMenusTarget && !m_dvFrame && !m_dvMenusPrepareFailed)
+    DVMenusPrepare();
+  if (!m_dvMenusTarget || !m_dvFrame || !m_dvBridge)
+  {
+    m_dvFrame = false;
+    DVMenusEnd(!m_dvMenusTarget ? "the GUI could not be drawn for them (no GUI target)"
+                                : "a frame of them could not be prepared (the line above says why)",
+               true);
+    m_dvMenusPrepareFailed = false;
+    return;
+  }
+  const auto presentStart = std::chrono::steady_clock::now();
+  bool presented = false;
+  bool plainFrame = false;
+  // EGL's window framebuffer has a bottom-left origin; the transport is indexed from the top left (as for
+  // the frames of a video)
+  if (m_dvBridge->Pack(0, m_nWidth, m_nHeight, true, CDVBridgeGLES::Cover::NONE))
+  {
+    // the way that waits: the GPU work of the frame finished, then a commit that waits for its flip
+    const bool swapped = m_eglContext.TrySwapBuffers();
+    if (swapped)
+    {
+      glFinish();
+      DVFlip flip;
+      const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+      plainFrame = m_dvState.TransportLive() && atomic && !atomic->HasPendingRequest();
+      // the frame that sets up the transport is a full modeset, told as a change of mode; a change of mode
+      // that was held (a move into another mode, CDVModeMove) is told with the commit that makes it
+      if (!m_dvState.TransportLive())
+        m_modeAnnounce.Modeset();
+      AnnounceHeldModeChange(true);
+      presented = FlipDVBridgePage(m_dvState, false, &flip);
+      if (presented)
+        m_dvMovePending = false;
+      HeldModeChangeCommitted(presented, true);
+    }
+  }
+  m_dvBridge->Presented(presented);
+  m_dvFrame = false;
+  m_dvMenusPrepareFailed = false;
+  const double presentMs =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - presentStart).count();
+  if (!presented)
+  {
+    DVMenusEnd("a frame of them could not be packed or was refused by the driver", true);
+    return;
+  }
+  // their frames reach the display (CDVPresentStall), as those of a video must
+  if (m_dvPresentStall.Presented(plainFrame, presentMs, false) == CDVPresentStall::Verdict::GIVE_UP)
+  {
+    DVMenusEnd("their frames do not reach the display (their flips do not come)", true);
+    return;
+  }
+  m_dvMenusFrames++;
