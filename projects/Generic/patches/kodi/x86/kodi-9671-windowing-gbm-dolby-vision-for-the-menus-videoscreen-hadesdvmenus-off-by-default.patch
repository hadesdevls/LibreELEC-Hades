+  m_dvEndDeferred = false;
+  m_dvHandOver = false;
+  m_dvFrame = false;
+  m_dvMeasureRestart = true;
+  m_dvShown = {};
+  m_dvPrepared = {};
+  m_dvRepeat = false;
+  m_dvVerifyPending = false;
+  m_dvVerifyShownCopied = false;
+  m_dvFailedFrames = 0;
+  m_dvShownTime = {};
+  m_dvLastShownPts = DVD_NOPTS_VALUE;
+  m_dvWorked = false;
