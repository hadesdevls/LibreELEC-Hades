+  m_dvMenus = true;
+  m_dvMenusShown = false;
+  m_dvMenusFrames = 0;
+  m_dvMenusWhite = 0;
+  m_dvMenusPrepareFailed = false;
+  m_dvMenusHotplugs = DVMenusHotplugs();
+  if (auto* gui = CServiceBroker::GetGUI())
+    gui->GetWindowManager().MarkDirty();
+  CLog::Log(LOGINFO, "DVBridge: the video ended; the menus go on in Dolby Vision, and the TV keeps its "
+                     "picture mode");
+  return true;
+}
+
+void CWinSystemGbmGLESContext::DVMenusHandToVideo()
+{
+  m_dvMenus = false;
+  m_dvFrame = false;
+  m_dvMenusPrepareFailed = false;
+  m_dvFromMenus = true;
+  m_dvMenusVideo = 1;
+  // what native output sets up for itself when it starts, for the video's (BeginDVBridge(), which the renderer
+  // calls next, finds the output captured)
+  DVNativeOutputBegins();
+  if (!m_guiCompositing || !m_compositeShader)
+  {
+    m_compositeShader.reset();
+    SetGuiCompositing(AVCOL_TRC_SMPTE2084);
+  }
+  CLog::Log(LOGINFO,
+            "DVBridge: the video takes native Dolby Vision output over from the menus ({} frames of them "
+            "sent): the TV keeps its picture mode{}",
+            m_dvMenusFrames,
+            m_dvMovePending ? ", and the next frame carries the change of mode" : "");
+}
