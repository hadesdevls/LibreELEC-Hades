+  // transport); a change to it then moves the transport with the menus (DVModeMoves())
+  RESOLUTION_INFO target;
+  a.modeAfter = !ModeAfterVideo(target) ||
+                (target.iScreenWidth == DVBRIDGE::TRANSPORT_WIDTH &&
+                 target.iScreenHeight == DVBRIDGE::TRANSPORT_HEIGHT && DVTransportModeOf(target));
+  a.hotplug = !DVMenusDisplayLooked();
+  const auto nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
