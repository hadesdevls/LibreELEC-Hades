From 185ee9cf1e11899fc343f17881903758379774ce Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Wed, 7 Oct 2026 15:04:39 +0100
Subject: [PATCH] [games] Sort a game list by title, year and genre

CGameInfoTag::ToSortable() was empty, so sorting a plugin's game list by
title, year or genre left it in the order it was listed.
---
 cmake/treedata/common/tests.txt          |  1 +
 xbmc/games/tags/GameInfoTag.cpp          | 16 ++++-
 xbmc/games/tags/test/CMakeLists.txt      |  3 +
 xbmc/games/tags/test/TestGameInfoTag.cpp | 85 ++++++++++++++++++++++++
 4 files changed, 104 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/games/tags/test/CMakeLists.txt
 create mode 100644 xbmc/games/tags/test/TestGameInfoTag.cpp

diff --git a/cmake/treedata/common/tests.txt b/cmake/treedata/common/tests.txt
index d551942..aebc182 100644
--- a/cmake/treedata/common/tests.txt
+++ b/cmake/treedata/common/tests.txt
@@ -24,6 +24,7 @@ xbmc/games/addons/streams/test    test/games/addons/streams
 xbmc/games/controllers/input/test test/games/controllers/input
 xbmc/games/controllers/test       test/games/controllers
 xbmc/games/dialogs/disc/test      test/games/dialogs/disc
+xbmc/games/tags/test              test/games/tags
 xbmc/games/test                   test/games
 xbmc/guilib/test                  test/guilib
 xbmc/imagefiles/test              test/imagefiles
diff --git a/xbmc/games/tags/GameInfoTag.cpp b/xbmc/games/tags/GameInfoTag.cpp
index 8a02c2c..ce227c6 100644
--- a/xbmc/games/tags/GameInfoTag.cpp
+++ b/xbmc/games/tags/GameInfoTag.cpp
@@ -154,5 +154,19 @@ void CGameInfoTag::Serialize(CVariant& value) const
 
 void CGameInfoTag::ToSortable(SortItem& sortable, Field field) const
 {
-  // No database entries for games (...yet)
+  switch (field)
+  {
+    case Field::TITLE:
+      if (!m_strTitle.empty())
+        sortable[Field::TITLE] = m_strTitle;
+      break;
+    case Field::YEAR:
+      sortable[Field::YEAR] = m_year;
+      break;
+    case Field::GENRE:
+      sortable[Field::GENRE] = m_genres;
+      break;
+    default:
+      break;
+  }
 }
diff --git a/xbmc/games/tags/test/CMakeLists.txt b/xbmc/games/tags/test/CMakeLists.txt
new file mode 100644
index 0000000..e2db537
--- /dev/null
+++ b/xbmc/games/tags/test/CMakeLists.txt
@@ -0,0 +1,3 @@
+set(SOURCES TestGameInfoTag.cpp)
+
+core_add_test_library(test_games_tags)
diff --git a/xbmc/games/tags/test/TestGameInfoTag.cpp b/xbmc/games/tags/test/TestGameInfoTag.cpp
new file mode 100644
index 0000000..b250e96
--- /dev/null
+++ b/xbmc/games/tags/test/TestGameInfoTag.cpp
@@ -0,0 +1,85 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "FileItem.h"
+#include "FileItemList.h"
+#include "games/tags/GameInfoTag.h"
+#include "utils/SortUtils.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::GAME;
+
+namespace
+{
+void AddGames(CFileItemList& items)
+{
+  struct Game
+  {
+    std::string path;
+    std::string title;
+    unsigned int year;
+    std::string genre;
+  };
+
+  // Listed by file name, which sorts differently to every detail
+  const std::vector<Game> games{{"/roms/1.rom", "Secret of Mana", 1993, "Role-playing"},
+                                {"/roms/2.rom", "Actraiser", 1990, "Simulation"},
+                                {"/roms/3.rom", "Chrono Trigger", 1995, "Adventure"}};
+
+  for (const Game& game : games)
+  {
+    auto item = std::make_shared<CFileItem>(game.path, false);
+    item->SetLabel(game.path);
+    CGameInfoTag* tag = item->GetGameInfoTag();
+    tag->SetTitle(game.title);
+    tag->SetYear(game.year);
+    tag->SetGenres({game.genre});
+    items.Add(std::move(item));
+  }
+}
+
+std::vector<std::string> Titles(const CFileItemList& items)
+{
+  std::vector<std::string> titles;
+  for (const auto& item : items)
+    titles.emplace_back(item->GetGameInfoTag()->GetTitle());
+  return titles;
+}
+} // namespace
+
+TEST(TestGameInfoTag, SortsByTitle)
+{
+  CFileItemList items;
+  AddGames(items);
+  items.Sort(SortBy::TITLE, SortOrder::ASCENDING);
+  EXPECT_EQ(Titles(items),
+            (std::vector<std::string>{"Actraiser", "Chrono Trigger", "Secret of Mana"}));
+}
+
+TEST(TestGameInfoTag, SortsByYear)
+{
+  CFileItemList items;
+  AddGames(items);
+  items.Sort(SortBy::YEAR, SortOrder::ASCENDING);
+  EXPECT_EQ(Titles(items),
+            (std::vector<std::string>{"Actraiser", "Secret of Mana", "Chrono Trigger"}));
+}
+
+TEST(TestGameInfoTag, SortsByGenre)
+{
+  CFileItemList items;
+  AddGames(items);
+  items.Sort(SortBy::GENRE, SortOrder::ASCENDING);
+  EXPECT_EQ(Titles(items),
+            (std::vector<std::string>{"Chrono Trigger", "Secret of Mana", "Actraiser"}));
+}
-- 
