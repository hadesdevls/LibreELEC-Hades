index 142701b..a7db82c 100644
--- a/xbmc/cores/VideoPlayer/MultiviewDisc.cpp
+++ b/xbmc/cores/VideoPlayer/MultiviewDisc.cpp
@@ -52,3 +52,10 @@ bool KODI::MULTIVIEW::DiscSecondViewWanted(const char** why)
                              : "stereoscopic videos are set to be played as 2D";
   return DiscWanted(player);
 }
+
+bool KODI::MULTIVIEW::DiscSimulate3DDisplay()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool(SIMULATE_3D_SETTING);
+}
