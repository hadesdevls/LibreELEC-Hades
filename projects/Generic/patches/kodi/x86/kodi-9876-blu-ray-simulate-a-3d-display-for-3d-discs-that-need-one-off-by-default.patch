@@ -486,18 +486,39 @@ constexpr bool DiscWanted(const Player& player)
   return player.allowed && player.decoder && !player.mono;
 }
 
+/*!
+ * \brief Whether a 3D disc is left to find the player and display of 3D
+ *
+ * The library that plays a disc gives a 3D disc the registers of a 3D player and of a display
+ * that shows 3D (libbluray's psr_init_3D(): profile 5, 3D preferred, the four 3D capabilities of
+ * the display), unless a profile was announced before (ProfileBeforeOpen()). That is done where
+ * the second view is wanted, and where "Simulate a 3D display" is on (bluray.hadessimulate3d,
+ * off by default): some 3D discs do not start, or stay on a black screen, on a player that says
+ * that its display has no 3D. With the setting and without the second view, such a disc takes
+ * its way for 3D and plays its base view, in 2D, as the rest of the video does here.
+ *
+ * \param wanted the second view is wanted (DiscWanted())
+ * \param simulate "Simulate a 3D display" is on
+ */
+constexpr bool Persona3D(bool wanted, bool simulate)
+{
+  return wanted || simulate;
+}
+
 /*!
  * \brief Whether the player profile is announced before the disc is opened, as it always was
  *
  * Kodi announces the profile of a UHD player (profile 6) before it opens a disc. The library
  * that plays the disc gives a 3D disc the registers of a 3D player (profile 5) when it reads
  * the index of the disc, but not over a profile that was announced: the disc then takes the
- * player for one without 3D, which is what happens today. Only where the second view is wanted
- * is the profile held back until the disc has said what it is.
+ * player for one without 3D, which is what happens today. Only where a disc is left to find the
+ * player of 3D (Persona3D()) is the profile held back until the disc has said what it is.
+ *
+ * \param persona3D Persona3D()
  */
-constexpr bool ProfileBeforeOpen(bool wanted)
+constexpr bool ProfileBeforeOpen(bool persona3D)
 {
-  return !wanted;
+  return !persona3D;
 }
 
 /*!
@@ -505,10 +526,12 @@ constexpr bool ProfileBeforeOpen(bool wanted)
  *
  * For every disc that does not declare 3D content: before anything of it plays it has the
  * registers that it always had. A disc that declares 3D content keeps what the library gave it.
+ *
+ * \param persona3D Persona3D()
  */
-constexpr bool ProfileAfterOpen(bool wanted, bool declares3D)
+constexpr bool ProfileAfterOpen(bool persona3D, bool declares3D)
 {
-  return wanted && !declares3D;
+  return persona3D && !declares3D;
 }
 
 /*!
