+std::shared_ptr<const KODI::UTILS::SIDEDATA::Snapshot> CDVDVideoCodecFFmpeg::BuildSideData(
+    const VideoPicture& picture)
+{
+  using namespace KODI::UTILS::SIDEDATA;
+  auto snapshot = std::make_shared<Snapshot>();
+  if (m_hints.dovi.dv_profile)
+    snapshot->doviConfig = SerializeDoviConfig(m_hints.dovi);
+  // a Dolby Vision stream whose enhancement layer rides in the same track, or in a second one
+  if (m_hints.dovi.el_present_flag)
+    snapshot->structure = m_hints.doviELConfig ? "dt-dl" : "st-dl";
+  if (m_hints.codec == AV_CODEC_ID_AV1)
+  {
+    const auto it = m_av1SideRpus.find(m_pFrame->pts);
+    if (it != m_av1SideRpus.end())
+    {
+      snapshot->doviRpu = it->second;
+      m_av1SideRpus.erase(m_av1SideRpus.begin(), std::next(it));
+    }
+  }
+  else if (const AVFrameSideData* rpu = av_frame_get_side_data(m_pFrame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+           rpu && rpu->size > 0)
+    snapshot->doviRpu = HevcRpuNal(rpu->data, rpu->size);
+  if (const AVFrameSideData* plus = av_frame_get_side_data(m_pFrame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS);
+      plus && plus->size >= sizeof(AVDynamicHDRPlus))
+  {
+    // (FFmpeg writes the payload from the application mode on: the T.35 header goes in front)
+    uint8_t* payload = nullptr;
+    size_t size = 0;
+    if (av_dynamic_hdr_plus_to_t35(reinterpret_cast<const AVDynamicHDRPlus*>(plus->data), &payload,
+                                   &size) >= 0 &&
+        payload)
+    {
+      snapshot->hdr10Plus = {0xb5, 0x00, 0x3c, 0x00, 0x01, 0x04};
+      snapshot->hdr10Plus.insert(snapshot->hdr10Plus.end(), payload, payload + size);
+    }
+    av_freep(&payload);
+  }
+  if (picture.hasDisplayMetadata)
+    snapshot->mdcv = SerializeMastering(picture.displayMetadata);
+  if (picture.hasLightMetadata)
+    snapshot->cll = SerializeContentLight(picture.lightMetadata);
+#ifdef HAVE_DVBRIDGE
+  // what Hades makes of the stream before the display sees it: a Dolby Vision video rebuilt as
+  // HDR10 or SDR, or Dolby Vision made of HDR10+ or of the picture
+  if (m_dvConvert || m_dvFromHdr10Plus || m_dvMeasured)
+    snapshot->flags = {"converted"};
+#endif
+  if (m_sideDataLast)
+    snapshot->Inherit(*m_sideDataLast);
+  m_sideDataLast = snapshot;
+  return snapshot;
+}
