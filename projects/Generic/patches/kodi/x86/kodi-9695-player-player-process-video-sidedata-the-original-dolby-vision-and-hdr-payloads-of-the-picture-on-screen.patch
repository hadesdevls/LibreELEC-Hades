+/*!
+ * \brief The original Dolby Vision and HDR payloads of the picture that is shown, as one JSON object
+ *
+ * Nothing here runs per picture unless something asked for the label (Request()): the decoder
+ * builds a Snapshot of a picture, and the renderer hands it on when it chooses that picture to be
+ * shown, only while Wanted(). The JSON is built when the label is read (Label()), from the last
+ * snapshot, on the thread that reads it and holding nothing of the player or the renderer. A
+ * Snapshot never changes once it is made, so the decoder, the renderer and the reader share one.
+ *
+ * Each payload is kept as the bytes the stream carried and is base64 encoded only for the JSON.
+ */
+struct Snapshot
+{
+  std::vector<uint8_t> doviConfig; //!< the 24 byte dvcC/dvvC record, empty without one
+  std::vector<std::string> flags; //!< what Hades changed before the display sees the stream
+  std::string structure; //!< "st-dl" or "dt-dl" for a dual layer stream, else empty
+  //! HEVC: the escaped NAL unit 62 with its two header bytes; AV1: T.35 from the country code
+  std::vector<uint8_t> doviRpu;
+  std::vector<uint8_t> hdr10Plus; //!< the ST 2094-40 ITU-T T.35 payload from the country code
+  std::vector<uint8_t> mdcv; //!< the mastering display colour volume SEI payload (24 bytes)
+  std::vector<uint8_t> cll; //!< the content light level SEI payload (4 bytes)
+
+  bool operator==(const Snapshot&) const = default;
+
+  //! A picture without a payload holds the last one that was carried (not the config, the flags
+  //! and the structure, which are the stream's)
+  void Inherit(const Snapshot& previous)
+  {
+    if (doviRpu.empty())
+      doviRpu = previous.doviRpu;
+    if (hdr10Plus.empty())
+      hdr10Plus = previous.hdr10Plus;
+    if (mdcv.empty())
+      mdcv = previous.mdcv;
+    if (cll.empty())
+      cll = previous.cll;
+  }
+};
+
+//! Base64, RFC 4648 with padding
+inline std::string Base64(const std::vector<uint8_t>& data)
+{
+  static constexpr char TABLE[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::string out;
+  out.reserve((data.size() + 2) / 3 * 4);
+  for (size_t i = 0; i < data.size(); i += 3)
+  {
+    const uint32_t n = (static_cast<uint32_t>(data[i]) << 16) |
+                       (i + 1 < data.size() ? static_cast<uint32_t>(data[i + 1]) << 8 : 0) |
+                       (i + 2 < data.size() ? data[i + 2] : 0);
+    out += TABLE[(n >> 18) & 63];
+    out += TABLE[(n >> 12) & 63];
+    out += i + 1 < data.size() ? TABLE[(n >> 6) & 63] : '=';
+    out += i + 2 < data.size() ? TABLE[n & 63] : '=';
+  }
+  return out;
+}
+
+/*!
+ * \brief The value of the label: one JSON object, empty where the stream carries nothing
+ *
+ * The keys in this order, each only where it is present: `flags` (an array of strings, first), then
+ * `dovi.config`, `structure`, `dovi.rpu`, `hdr10plus`, `mdcv`, `cll`. Values are base64 or plain
+ * tokens, so no JSON escaping is needed.
+ */
+inline std::string Compose(const Snapshot& s)
+{
+  std::string flags;
+  for (const auto& flag : s.flags)
+  {
+    flags += flags.empty() ? '[' : ',';
+    flags += '"' + flag + '"';
+  }
+  if (!flags.empty())
+    flags += ']';
+  std::string json;
+  if (!flags.empty())
+    json += "{\"flags\":" + flags;
+  const auto put = [&json](const char* key, const std::string& value)
+  {
+    if (value.empty())
+      return;
+    json += json.empty() ? "{\"" : ",\"";
+    json += key;
+    json += "\":\"" + value + "\"";
+  };
+  put("dovi.config", Base64(s.doviConfig));
+  put("structure", s.structure);
+  put("dovi.rpu", Base64(s.doviRpu));
+  put("hdr10plus", Base64(s.hdr10Plus));
+  put("mdcv", Base64(s.mdcv));
+  put("cll", Base64(s.cll));
+  if (!json.empty())
+    json += '}';
+  return json;
+}
+
+//! dvcC/dvvC layout, as FFmpeg's ff_isom_put_dvcc_dvvc writes it (24 bytes)
+inline std::vector<uint8_t> SerializeDoviConfig(const AVDOVIDecoderConfigurationRecord& dovi)
+{
+  std::vector<uint8_t> out(24, 0);
+  out[0] = dovi.dv_version_major;
+  out[1] = dovi.dv_version_minor;
+  out[2] = ((dovi.dv_profile & 0x7f) << 1) | ((dovi.dv_level >> 5) & 0x01);
+  out[3] = ((dovi.dv_level & 0x1f) << 3) | (!!dovi.rpu_present_flag << 2) |
+           (!!dovi.el_present_flag << 1) | !!dovi.bl_present_flag;
+  out[4] = ((dovi.dv_bl_signal_compatibility_id & 0x0f) << 4) |
+           ((dovi.dv_md_compression & 0x03) << 2);
+  return out;
+}
+
+//! MDCV SEI layout: primaries in green, blue, red order in 1/50000, then the white point, then the
+//! luminance in 1/10000 cd/m2 (maximum, minimum); what is not given is zero
+inline std::vector<uint8_t> SerializeMastering(const AVMasteringDisplayMetadata& m)
+{
+  std::vector<uint8_t> out(24, 0);
+  size_t p = 0;
+  const auto put16 = [&](long v)
+  {
+    out[p++] = (v >> 8) & 0xff;
+    out[p++] = v & 0xff;
+  };
+  if (m.has_primaries)
+  {
+    static constexpr int ORDER[3] = {1, 2, 0}; // FFmpeg keeps red first
+    for (const int c : ORDER)
+    {
+      put16(std::lround(av_q2d(m.display_primaries[c][0]) * 50000.0));
+      put16(std::lround(av_q2d(m.display_primaries[c][1]) * 50000.0));
+    }
+    put16(std::lround(av_q2d(m.white_point[0]) * 50000.0));
+    put16(std::lround(av_q2d(m.white_point[1]) * 50000.0));
+  }
+  else
+    p = 16;
+  if (m.has_luminance)
+  {
+    const auto put32 = [&](long v)
+    {
+      for (int shift = 24; shift >= 0; shift -= 8)
+        out[p++] = (v >> shift) & 0xff;
+    };
+    put32(std::lround(av_q2d(m.max_luminance) * 10000.0));
+    put32(std::lround(av_q2d(m.min_luminance) * 10000.0));
+  }
+  return out;
+}
+
+//! CLL SEI layout: the maximum, then the frame average light level, 16 bits each
+inline std::vector<uint8_t> SerializeContentLight(const AVContentLightMetadata& l)
+{
+  return {static_cast<uint8_t>(l.MaxCLL >> 8), static_cast<uint8_t>(l.MaxCLL & 0xff),
+          static_cast<uint8_t>(l.MaxFALL >> 8), static_cast<uint8_t>(l.MaxFALL & 0xff)};
+}
+
+//! The escaped RPU NAL unit of an HEVC picture: FFmpeg's AV_FRAME_DATA_DOVI_RPU_BUFFER is the
+//! NAL unit as coded (emulation prevention kept) without its two header bytes; the header of
+//! NAL type 62 on layer 0, temporal id 0, is 7C 01
+inline std::vector<uint8_t> HevcRpuNal(const uint8_t* rpuBuffer, size_t size)
+{
+  std::vector<uint8_t> nal;
+  if (!rpuBuffer || size == 0)
+    return nal;
+  nal.reserve(size + 2);
+  nal.push_back(0x7c);
+  nal.push_back(0x01);
+  nal.insert(nal.end(), rpuBuffer, rpuBuffer + size);
+  return nal;
+}
+
+//! The Dolby Vision RPU of an AV1 temporal unit: the ITU-T T.35 payload from the country code
+//! (provider 0x003B, oriented code 0x0000, 0x08 0x00), to the end of its metadata OBU; empty where
+//! the temporal unit has none
+inline std::vector<uint8_t> Av1DoviT35(const uint8_t* data, size_t size)
+{
+  const auto leb128 = [&](size_t end, size_t& pos, uint64_t& value)
+  {
+    value = 0;
+    for (int i = 0; i < 8; ++i)
+    {
+      if (pos >= end)
+        return false;
+      const uint8_t b = data[pos++];
+      value |= static_cast<uint64_t>(b & 0x7f) << (7 * i);
+      if (!(b & 0x80))
+        return true;
+    }
+    return false;
+  };
+  size_t pos = 0;
+  while (data && pos < size)
+  {
+    const uint8_t header = data[pos++];
+    if (header & 0x80)
+      return {};
+    const int type = (header >> 3) & 0x0f;
+    if (header & 0x04)
+      ++pos; // extension
+    if (pos >= size)
+      return {};
+    uint64_t length = size - pos;
+    if ((header & 0x02) && !leb128(size, pos, length))
+      return {};
+    if (length > size - pos)
+      return {};
+    if (type == 5) // OBU_METADATA
+    {
+      const size_t end = pos + length;
+      size_t p = pos;
+      uint64_t metadataType = 0;
+      if (leb128(end, p, metadataType) && metadataType == 4 /* ITUT_T35 */ && end - p >= 34 &&
+          data[p] == 0xb5 && data[p + 1] == 0x00 && data[p + 2] == 0x3b && data[p + 3] == 0x00 &&
+          data[p + 4] == 0x00 && data[p + 5] == 0x08 && data[p + 6] == 0x00)
+        return std::vector<uint8_t>(data + p, data + end);
+    }
+    pos += length;
+  }
+  return {};
+}
+
+/*!
+ * \brief Whether something asked for the label lately: the decoder builds snapshots, and the
+ *        renderer hands them on, only then
+ *
+ * A read of the label asks (Request()); a request holds for HOLD, so that a skin or an add-on that
+ * stops reading it stops costing anything, with no one to switch it off.
+ */
+class CSideData
+{
+public:
+  static CSideData& Get()
+  {
+    static CSideData instance;
+    return instance;
+  }
+
+  static constexpr std::chrono::seconds HOLD{10};
+
+  //! The label was read now
+  void Request(std::chrono::steady_clock::time_point now = std::chrono::steady_clock::now())
+  {
+    m_requested.store(now.time_since_epoch().count(), std::memory_order_relaxed);
+  }
+
+  //! Whether to build and hand on snapshots. Per picture, in the decoder and in the renderer: while
+  //! nobody has asked (or the last ask is past its hold) it is one relaxed load and nothing else;
+  //! the clock is read only within the hold of a request, and a request that has passed is dropped
+  //! here, so that it costs nothing again
+  bool Wanted()
+  {
+    const auto at = m_requested.load(std::memory_order_relaxed);
+    if (at == 0)
+      return false;
+    return Wanted(std::chrono::steady_clock::now());
+  }
+
+  //! ... at a given time (for the test)
+  bool Wanted(std::chrono::steady_clock::time_point now)
+  {
+    auto at = m_requested.load(std::memory_order_relaxed);
+    if (at == 0)
+      return false;
+    const auto hold = std::chrono::duration_cast<std::chrono::steady_clock::duration>(HOLD).count();
+    if (now.time_since_epoch().count() - at <= hold)
+      return true;
+    m_requested.compare_exchange_strong(at, 0, std::memory_order_relaxed);
+    return false;
+  }
+
+  //! The renderer chose a picture to be shown (a pointer swap under a lock of its own: nothing of
+  //! the player or the renderer is held)
+  void Shown(std::shared_ptr<const Snapshot> snapshot)
+  {
+    std::lock_guard lock(m_lock);
+    m_shown = std::move(snapshot);
+  }
+
+  //! The video ended or another one starts: nothing is shown
+  void Clear()
+  {
+    std::lock_guard lock(m_lock);
+    m_shown.reset();
+    m_composed.reset();
+    m_json.clear();
+  }
+
+  /*!
+   * \brief The value of Player.Process(video.sidedata): asks for it, and builds the JSON from the
+   *        snapshot of the last picture shown, again only when that is another snapshot
+   */
+  std::string Label()
+  {
+    Request();
+    std::shared_ptr<const Snapshot> shown;
+    {
+      std::lock_guard lock(m_lock);
+      shown = m_shown;
+      if (shown == m_composed)
+        return m_json;
+    }
+    std::string json = shown ? Compose(*shown) : std::string();
+    std::lock_guard lock(m_lock);
+    m_composed = shown;
+    m_json = json;
+    return json;
+  }
+
+private:
+  std::atomic<std::chrono::steady_clock::rep> m_requested{0};
+  std::mutex m_lock;
+  std::shared_ptr<const Snapshot> m_shown;
+  std::shared_ptr<const Snapshot> m_composed;
+  std::string m_json;
+};
