  *
  * Kodi made its resolutions of the modes of the display once, when it started
  * (CWinSystemGbm::UpdateResolutions()), and a resolution names its mode by its place in the list
@@ -35,12 +34,9 @@ namespace GBM
  *
  * Kodi's other window systems make their resolutions again while it runs, when the system says
  * that the displays changed: X11 (CWinSystemX11::NotifyXRREvent(): UpdateResolutions(), then
- * RecreateWindow() finds the mode on the screen in the new list by its id, or takes the desktop
- * resolution), Wayland (an output hot-plug: UpdateResolutions()), Android
- * (CWinSystemAndroid::UpdateDisplayModes(): UpdateResolutions(false) keeps the desktop
- * resolution, found in the new list by its size, refresh rate and flags) and Windows
- * (WM_DISPLAYCHANGE: UpdateResolutions(), then the desktop resolution where the size changed).
- * GBM does the same:
+ * RecreateWindow() sets the resolution again), Wayland (an output hot-plug: UpdateResolutions()),
+ * Android (CWinSystemAndroid::UpdateDisplayModes()) and Windows (WM_DISPLAYCHANGE:
+ * UpdateResolutions(), then the desktop resolution). GBM does the same:
  * - only after a hot-plug event of the device in use (the display watch hears them), once there
  *   has been none for a while and no video for a while, and only while nothing is in the way
  *   (InTheWay()): nothing plays, the output carries the interface alone (no video plane, no HDR
@@ -49,19 +45,18 @@ namespace GBM
  *   at all (WhenToLook());
  * - the display is probed then, as when a video starts after such an event (CDisplayLook). Not
  *   connected, no EDID that can be read, or the same EDID: nothing is done (Of());
- * - another EDID with the same modes in the same places: nothing is done either (SameList());
- * - other modes: each mode that Kodi holds (the one on the screen, the desktop resolution's and
- *   the current resolution's) is found in the new list by its timing, never by its place
- *   (MakePlan()), and the resolutions are made again of the new list. A resolution whose mode is
- *   no longer offered becomes what a start takes for it: the desktop resolution the mode that
- *   the display prefers, as at a start where the console left no mode (PreferredPlace():
- *   CDRMUtils::FindPreferredMode()); the current resolution the one of the settings, or the
- *   nearest (CDisplaySettings::GetDisplayResolution()). Where the mode on the screen is still
- *   offered, nothing changes on the screen (RENUMBER); where it is not, the interface is set in
- *   the current resolution (FALLBACK), as Kodi sets it for its interface;
- * - a list that cannot be matched (no mode, two modes with one timing, no mode without a 3D
- *   layout, the mode on the screen with one) changes nothing (REFUSE): the resolutions stay as
- *   they were, and the user is told that a restart takes the display's new modes.
+ * - another EDID with the same modes in the same places, the same one preferred: nothing is
+ *   done either (SameList()): a start would make the same choices;
+ * - other modes: the resolutions are made again of them, and every choice is the one a start
+ *   makes with the new list (MakePlan()). The desktop resolution is the mode that the display
+ *   prefers (PreferredPlace(): CDRMUtils::FindPreferredMode(), what a start takes where the
+ *   console left no mode; the console takes that one); the current resolution is the one of the
+ *   settings, or the nearest (CDisplaySettings::GetDisplayResolution(): "desktop" names the
+ *   desktop resolution); the interface is set in it. Where the mode on the screen is already
+ *   that one, nothing changes on the screen (ScreenStays());
+ * - a list that cannot be taken (no mode, two modes with one timing, no mode without a 3D
+ *   layout) changes nothing (REFUSE): the resolutions stay as they were, and the user is told
+ *   that a restart takes the display's new modes.
  *
  * Only what is decided is here, with nothing of DRM or of Kodi in it, so that it can be tested
  * by itself. Mode is drmModeModeInfo, or a type with its fields.
@@ -150,7 +145,7 @@ enum class Found
   NOT_CONNECTED, //!< nothing is connected to the output now: the resolutions stay
   NO_EDID, //!< no EDID that can be read (a display that wakes up): the resolutions stay
   SAME_EDID, //!< the EDID that the resolutions were made with: nothing is done
-  SAME_MODES, //!< another EDID, with the same modes in the same places: nothing is done
+  SAME_MODES, //!< another EDID, with the same modes (SameList()): nothing is done
   OTHER_MODES, //!< other modes: MakePlan()
 };
 
@@ -178,8 +173,9 @@ bool SameTiming(const Mode& a, const Mode& b)
   return CCommittedMode<Mode>::SameTiming(a, b);
 }
 
-//! The same modes in the same places: every resolution made of the one names the same mode in the
-//! other. (Their types are not compared: no resolution is made of them.)
+//! The same modes in the same places, the same of them preferred by the display: every resolution
+//! made of the one names the same mode in the other, and a start chooses the same of them. (Of
+//! the type of a mode only that counts: a start takes the preferred one.)
 template<typename Mode>
 bool SameList(const std::vector<Mode>& a, const std::vector<Mode>& b)
 {
@@ -187,7 +183,7 @@ bool SameList(const std::vector<Mode>& a, const std::vector<Mode>& b)
     return false;
   for (std::size_t i = 0; i < a.size(); ++i)
   {
-    if (!SameTiming(a[i], b[i]))
+    if (!SameTiming(a[i], b[i]) || (a[i].type & TYPE_PREFERRED) != (b[i].type & TYPE_PREFERRED))
       return false;
   }
   return true;
@@ -240,37 +236,22 @@ struct Plan
 {
   enum class Kind
   {
-    SAME, //!< the same modes in the same places: nothing is done
-    RENUMBER, //!< made again; the mode on the screen stays, with the place it has now
-    FALLBACK, //!< made again; the mode on the screen is gone: the current resolution is set
+    SAME, //!< the same modes, the same one preferred: nothing is done
+    REMADE, //!< made again of the new modes; every choice is the one a start makes with them
     REFUSE, //!< nothing is done, and the user is told that a restart takes the new modes
   };
   Kind kind = Kind::REFUSE;
-  int screen = -1; //!< the place of the mode on the screen in the new list (RENUMBER)
-  //! ... of the desktop resolution's mode: its own where it is still offered, else the one that
-  //! the display prefers (PreferredPlace())
+  //! REMADE: the place of the desktop resolution's mode in the new list (PreferredPlace())
   int desktop = -1;
-  //! ... whether that is the desktop resolution's own mode
-  bool desktopKept = false;
-  //! ... of the current resolution's mode (CDisplaySettings::GetCurrentResolution()); -1: it is
-  //! no longer offered, and the current resolution becomes the one a start takes (the settings)
-  int current = -1;
   const char* why = ""; //!< REFUSE: why, for the log
 };
 
 /*!
  * \param before the modes that the resolutions were made of
  * \param now the modes of the display now
- * \param screen the mode on the screen; nullptr: none is known
- * \param desktop the desktop resolution's mode; nullptr: none is known
- * \param current the current resolution's mode; nullptr: none is known
  */
 template<typename Mode>
-Plan MakePlan(const std::vector<Mode>& before,
-              const std::vector<Mode>& now,
-              const Mode* screen,
-              const Mode* desktop,
-              const Mode* current)
+Plan MakePlan(const std::vector<Mode>& before, const std::vector<Mode>& now)
 {
   Plan plan;
   if (now.empty())
@@ -283,8 +264,8 @@ Plan MakePlan(const std::vector<Mode>& before,
     plan.kind = Plan::Kind::SAME;
     return plan;
   }
-  // A mode is found by its timing: where two have one, which of them a resolution names is not
-  // known
+  // A mode is found by its timing (the mode on the screen, ScreenStays()): where two have one,
+  // which of them is meant is not known
   for (std::size_t i = 0; i < now.size(); ++i)
   {
     for (std::size_t j = i + 1; j < now.size(); ++j)
@@ -296,57 +277,22 @@ Plan MakePlan(const std::vector<Mode>& before,
       }
     }
   }
-
-  const int preferred = PreferredPlace(now);
-  if (preferred < 0)
+  plan.desktop = PreferredPlace(now);
+  if (plan.desktop < 0)
   {
     plan.why = "the display has no mode without a 3D layout";
     return plan;
   }
-
-  plan.desktop = desktop ? PlaceOf(now, *desktop) : -1;
-  plan.desktopKept = plan.desktop >= 0;
-  if (!plan.desktopKept)
-    plan.desktop = preferred;
-
-  plan.current = current ? PlaceOf(now, *current) : -1;
-  if (plan.current < 0)
-    plan.current = -1;
-
-  plan.screen = screen ? PlaceOf(now, *screen) : -1;
-  if (plan.screen >= 0 && (now[plan.screen].flags & FLAG_3D_MASK))
-  {
-    // (no resolution is made of such a mode: it is set only for what is drawn in 3D)
-    plan.screen = -1;
-    plan.why = "the mode on the screen has a 3D layout";
-    return plan;
-  }
-  if (plan.screen < 0)
-    plan.screen = -1;
-  plan.kind = plan.screen >= 0 ? Plan::Kind::RENUMBER : Plan::Kind::FALLBACK;
+  plan.kind = Plan::Kind::REMADE;
   return plan;
 }
 
-/*!
- * \brief The resolution that names a mode of the new list, for one that named a mode before
- * \param place the place of that mode in the new list (Plan); -1: it is no longer offered
- * \param wasDesktop the resolution before was the desktop resolution
- * \param plan what was planned (its desktop: the place of the desktop resolution's mode now)
- * \param desktopRes the desktop resolution (RES_DESKTOP)
- * \param resOf the resolution made of a place of the new list (as CDRMUtils::GetModes() makes them:
- *        its strId is the place); -1 where none is
- * \return -1 where the mode is no longer offered
- */
-template<typename ResOf>
-int ResolutionFor(int place, bool wasDesktop, const Plan& plan, int desktopRes, ResOf resOf)
+//! The mode on the screen is the mode of the resolution that is chosen (a start would set it):
+//! nothing is set on the screen then, the resolution only takes the place it has now
+template<typename Mode>
+bool ScreenStays(const Mode* screen, const Mode* chosen)
 {
-  if (place < 0)
-    return -1;
-  // The desktop resolution stays the desktop resolution where it is still the same mode (the
-  // settings may name it so: "DESKTOP"); a resolution of the list stays one of the list
-  if (wasDesktop && plan.desktopKept && place == plan.desktop)
-    return desktopRes;
-  return resOf(place);
+  return screen && chosen && SameTiming(*screen, *chosen);
 }
 
 } // namespace MODELIST
