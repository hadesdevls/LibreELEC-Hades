+bool CWinSystemGbm::FlipDVBridgeAgain(CDVBridgeState& state)
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !m_GBM || !state.Captured() || !state.TransportLive() || drm->HasPendingRequest())
+    return false;
+  // The buffer that is the scanout stays one: nothing of the surface changes. The properties are
+  // those of every transport frame, unchanged (Stage()), and nothing else: the kernel takes it as a
+  // flip to the same buffer, and its commit returns with that flip, with every driver.
+  gbm_bo* bo = m_GBM->GetDevice().GetSurface().ScanoutBuffer();
+  return bo && drm->FlipPageTransactional(state.Stage(*drm, false) ? bo : nullptr, false);
+}
