+void CWinSystemGbmGLESContext::DVRepeatDrawn(const DVPicture& frame)
+{
+  // Hades: the picture on the screen, at the same place, is drawn again: why it was not kept
+  // (DVKeepsPicture(), in that order), for the line of every 10 s
+  const auto& a = m_dvShown.geometry;
+  const auto& b = frame.geometry;
+  if (!frame.valid || frame.serial == 0 || !m_dvShown.valid || m_dvShown.serial != frame.serial ||
+      a.source_width != b.source_width || a.source_height != b.source_height || a.x != b.x ||
+      a.y != b.y || a.width != b.width || a.height != b.height)
+    return;
+  using Reason = CDVRepeatKeep::Reason;
+  Reason why = Reason::OUTPUT;
+  if (!m_dvKeepRepeats)
+    why = Reason::SETTING;
+  else if (m_dvKeep.Way(m_dvAheadShown) == CDVRepeatKeep::Pace::NONE)
+    why = Reason::NO_VBLANK;
+  else if (!frame.clean || !m_dvShown.clean)
+    why = Reason::DRAWN_OVER;
+  else if (m_dvShown.layered != frame.layered || m_dvShown.allowPacked != frame.allowPacked ||
+           m_dvShown.step != frame.step)
+    why = Reason::OTHER_WAY;
+  m_dvStats.notKept[static_cast<size_t>(why)]++;
+}
