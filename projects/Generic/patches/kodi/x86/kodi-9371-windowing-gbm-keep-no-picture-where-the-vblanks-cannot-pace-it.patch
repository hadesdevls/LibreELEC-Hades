+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: how a picture of native Dolby Vision output that is on the screen is kept there
+ *        instead of being drawn again (CWinSystemGbmGLESContext::KeepDVBridgeFrame()), and why
+ *        the pictures that repeated were drawn again
+ *
+ * A kept picture paces the render loop as the commit of its frame would have. By the vblanks of
+ * the CRTC (the legacy vblank ioctl), or, where advancedsettings.xml asks for it
+ * (video/dvkeepbycommit, off: to be measured on a GPU first), by a commit of the same picture that
+ * waits for its flip, which needs no vblank. That one only stands in for a frame presented the way
+ * that waits: after a frame presented a frame ahead, only the vblanks can.
+ *
+ * nvidia-drm with its defaults has no vblank at all (its module parameter vblank is off, and
+ * without drm_vblank_init() the ioctl returns EOPNOTSUPP). Every picture that it tried to keep
+ * presented nothing, slept 10 ms, and was drawn again late by the pass after it. That is known for
+ * the device until Kodi is started again; any other failure (the CRTC off, say) for the native
+ * output in which it happened. From then on the pictures are drawn again every refresh, as in
+ * 1.0 RC1, unless a commit keeps them.
+ *
+ * This class only decides.
+ */
+class CDVRepeatKeep
+{
+public:
+  //! Why a picture that was on the screen, and that a frame would draw again, was drawn again
+  enum class Reason
+  {
+    SETTING, //!< keeping is turned off in the settings
+    NO_VBLANK, //!< nothing can pace a kept picture: no vblank to wait for
+    DRAWN_OVER, //!< something was drawn over the picture (the GUI, subtitles, a capture)
+    OTHER_WAY, //!< it would be drawn another way than the one on the screen
+    OUTPUT, //!< the output: not shown yet, ending, off, or more than a frame to commit
+    FLIP, //!< the flip of the frame before it was not reported
+    COMMIT, //!< the commit of the same picture was refused
+    COUNT
+  };
+  static constexpr std::size_t REASONS = static_cast<std::size_t>(Reason::COUNT);
+  using Counts = std::array<unsigned int, REASONS>;
+
+  //! How a kept picture is paced now
+  enum class Pace
+  {
+    NONE, //!< it is not kept
+    VBLANK,
+    COMMIT,
+  };
+
+  //! A native output begins; byCommit: video/dvkeepbycommit
+  void Begin(bool byCommit)
+  {
+    m_vblankFailedHere = false;
+    m_byCommit = byCommit;
+  }
+
+  //! \param ahead the frame on the screen was presented a frame ahead
+  Pace Way(bool ahead) const
+  {
+    if (m_byCommit && !ahead)
+      return Pace::COMMIT;
+    if (!m_noVBlank && !m_vblankFailedHere)
+      return Pace::VBLANK;
+    return Pace::NONE;
+  }
+
+  //! The vblank of the CRTC could not be waited for, with this error (errno). True when the log
+  //! is to be told (once for the device, the first three times for another error)
+  bool VBlankFailed(int error)
+  {
+    if (error == EOPNOTSUPP)
+    {
+      const bool tell = !m_noVBlank;
+      m_noVBlank = true;
+      return tell;
+    }
+    const bool tell = !m_vblankFailedHere && m_othersTold < 3;
+    if (tell)
+      ++m_othersTold;
+    m_vblankFailedHere = true;
+    return tell;
+  }
+  //! ... the device has none, until Kodi is started again
+  bool DeviceHasNoVBlank() const { return m_noVBlank; }
+
+  //! The commit that kept a picture was refused: the vblanks pace the rest of this native output
+  void CommitFailed() { m_byCommit = false; }
+  bool ByCommit() const { return m_byCommit; }
+
+  static constexpr const char* Name(Reason reason)
+  {
+    switch (reason)
+    {
+      case Reason::SETTING:
+        return "turned off in the settings";
+      case Reason::NO_VBLANK:
+        return "no vblank to wait for";
+      case Reason::DRAWN_OVER:
+        return "drawn over";
+      case Reason::OTHER_WAY:
+        return "drawn another way";
+      case Reason::OUTPUT:
+        return "the output was changing";
+      case Reason::FLIP:
+        return "the flip before it was not reported";
+      case Reason::COMMIT:
+        return "its commit was refused";
+      default:
+        return "";
+    }
+  }
+  //! "N" and, where any, " (reason: n, ...)", for the log
+  static std::string Describe(const Counts& counts)
+  {
+    unsigned int total = 0;
+    std::string reasons;
+    for (std::size_t i = 0; i < REASONS; ++i)
+    {
+      if (!counts[i])
+        continue;
+      total += counts[i];
+      reasons += (reasons.empty() ? " (" : ", ") + std::string(Name(static_cast<Reason>(i))) +
+                 ": " + std::to_string(counts[i]);
+    }
+    return std::to_string(total) + (reasons.empty() ? "" : reasons + ")");
+  }
+
+private:
+  bool m_noVBlank = false;
+  bool m_vblankFailedHere = false;
+  bool m_byCommit = false;
+  unsigned int m_othersTold = 0;
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
