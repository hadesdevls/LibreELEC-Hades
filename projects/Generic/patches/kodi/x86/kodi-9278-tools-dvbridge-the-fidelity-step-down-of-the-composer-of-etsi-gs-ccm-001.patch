diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index bd9d25c..1042c19 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -398,10 +398,18 @@ static bool map_layers(struct dvbridge_renderer *r, struct dvbridge_color *mappe
     return true;
 }
 
-/* Hades: the upscalers of a step-down level (dvbridge_render_set_step()). Bilinear, not libplacebo's
- * bicubic: measured, bicubic is further from the faithful picture. The chroma of the base layer is
- * scaled up with plane_upscaler, and the planes of the enhancement layer would take that one too:
- * until their own level comes they get the faithful one of their own (libplacebo-9920). */
+/* Hades: the filters of a step-down level (dvbridge_render_set_step()), of both composers: libplacebo
+ * takes those of the one that composes the picture (the composer of ETSI GS CCM 001 composes by the
+ * reshaping a picture that the clause does not cover).
+ * The reshaping: the upscalers of the planes, bilinear, not libplacebo's bicubic (measured, bicubic
+ * is further from the faithful picture). The chroma of the base layer is scaled up with
+ * plane_upscaler, and the planes of the enhancement layer would take that one too: until their own
+ * level comes they get the faithful one of their own (libplacebo-9920).
+ * The composer of the clause, which resamples the enhancement layer with the integer filters of
+ * annex B.3 and not with those upscalers (libplacebo-9940): level 1, the luma of that layer between
+ * columns from two samples; 2, also between rows, and its chroma between columns; 3, also the
+ * composed planes scaled up bilinearly, in place of plane_upscaler, which the reshaping's level 1
+ * sets and which they would take otherwise. */
 static void step_down(struct pl_render_params *params, int level)
 {
     if (level < 1)
@@ -411,6 +419,10 @@ static void step_down(struct pl_render_params *params, int level)
     params->plane_upscaler = &pl_filter_bilinear;
     params->el_chroma_upscaler = level >= 2 ? &pl_filter_bilinear : faithful;
     params->el_luma_upscaler = level >= 3 ? &pl_filter_bilinear : faithful;
+    params->dovi_ccm_el_linear = PL_DOVI_CCM_EL_LUMA_COLUMNS;
+    if (level >= 2)
+        params->dovi_ccm_el_linear |= PL_DOVI_CCM_EL_LUMA_ROWS | PL_DOVI_CCM_EL_CHROMA_COLUMNS;
+    params->dovi_ccm_plane_upscaler = level >= 3 ? &pl_filter_bilinear : faithful;
 }
 
 static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
@@ -910,10 +922,18 @@ int dvbridge_render_step(const struct dvbridge_renderer *r)
 
 unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *r, bool residual)
 {
-    /* every renderer of this bridge resamples the planes of an enhancement layer with the
-     * upscalers of step_down() */
-    (void) r;
-    return residual ? 0xfu : 0x3u;
+    /* with the residual, each level changes another filter of step_down(); without it, the
+     * reshaping's level 1 still changes the upscaler of the chroma of the base layer, and of the
+     * ladder of the composer of the clause only level 3 changes anything, the upscaler of the
+     * composed planes */
+    if (residual)
+        return 0xfu;
+    return r && !r->legacy_composer ? 0x9u : 0x3u;
+}
+
+bool dvbridge_render_ccm_composer(const struct dvbridge_renderer *r)
+{
+    return r && !r->legacy_composer;
 }
 
 void dvbridge_render_use_ccm_composer(struct dvbridge_renderer *r, bool use)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index e5c3242..8402b4a 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -105,8 +105,9 @@ int dvbridge_render_early_mask(const struct dvbridge_renderer *renderer, bool pa
  * (the default). Turned off to measure on hardware what it saves, and by the host test. */
 void dvbridge_render_allow_early_mask(struct dvbridge_renderer *renderer, bool allow);
 /* Hades: a step down from the faithful picture, for graphics that cannot draw a frame in the time
- * of a refresh. The planes that are scaled up to the size of the picture are scaled up bilinearly
- * (the sampling of the GPU itself) instead of with Lanczos, more of them at each level:
+ * of a refresh. With libplacebo's reshaping (dvbridge_render_use_ccm_composer(), false), the
+ * planes that are scaled up to the size of the picture are scaled up bilinearly (the sampling of
+ * the GPU itself) instead of with Lanczos, more of them at each level:
  *   0: none, the faithful picture (the default);
  *   1: the chroma of the base layer;
  *   2: also the chroma of the enhancement layer;
@@ -116,7 +117,20 @@ void dvbridge_render_allow_early_mask(struct dvbridge_renderer *renderer, bool a
  * of the pixels, most of them by one code, none by more than 7, 10 and 16 codes. Nothing else
  * changes: the metadata, the transport, the area outside the active picture. For every render of
  * this renderer after the call, of either kind; a level out of range counts as the nearest one,
- * and dvbridge_renderer_reset() keeps it. */
+ * and dvbridge_renderer_reset() keeps it.
+ * With the composer of ETSI GS CCM 001 (the default), which resamples the enhancement layer with
+ * the integer filters of annex B.3 (libplacebo-9940), ordered by what each costs in fidelity for
+ * the texture fetches it saves (about 197 million a 3840x2160 frame at level 0, counted in the
+ * shaders):
+ *   1: the luma of the enhancement layer between columns from the two nearest samples (8 taps:
+ *      25 million fetches fewer);
+ *   2: also between rows, and its chroma between columns (39 million);
+ *   3: also the composed chroma scaled up bilinearly (106 million, a pass fewer).
+ * Measured the same way, on the composer's planes: levels 1 and 2 change nothing where the
+ * enhancement layer is flat (pictures 3 and 27), and on picture 51 11.7 % and 34.3 % of the
+ * pixels of the active picture, by 12 codes at most; level 3 changes 2.1 % to 47.8 %, up to 331
+ * codes at edges of strong colour, which is why it comes last although it saves the most. A
+ * picture that the clause does not cover is composed by the reshaping, at its own level. */
 #define DVBRIDGE_STEP_LEVELS 4
 void dvbridge_render_set_step(struct dvbridge_renderer *renderer, int level);
 int dvbridge_render_step(const struct dvbridge_renderer *renderer);
@@ -127,8 +141,13 @@ int dvbridge_render_step(const struct dvbridge_renderer *renderer);
  * that levels 2 and 3 change (libplacebo-9920). Without it no plane of that layer is drawn (there is
  * none, or libplacebo leaves out a layer whose metadata reconstructs no residual), and only level 1
  * does. A caller that lowers the fidelity by itself steps only between the levels of the mask: a
- * level outside it would change nothing. */
+ * level outside it would change nothing. With the composer of ETSI GS CCM 001 the enhancement layer
+ * is resampled with the filters that levels 1 and 2 change (libplacebo-9940), and without the
+ * residual only level 3 changes anything, the upscaler of the composed planes: 0x9. */
 unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *renderer, bool residual);
+/* Hades: whether the renderer composes the picture as ETSI GS CCM 001 does (see
+ * dvbridge_render_use_ccm_composer()) */
+bool dvbridge_render_ccm_composer(const struct dvbridge_renderer *renderer);
 /* Hades: whether the picture is composed as the composer of ETSI GS CCM 001 V1.1.1 (clause 5.4)
  * composes it (the default): the chroma mapped at 4:2:0 with the luma down-sampled as the clause
  * says, codes read as s / 2^n, the residual inverse-quantized on the integer codes of the
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 8cf5a9e..795765e 100644
