From 4f32e9db08f123ac1b11161ab0e048df4c477c0f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 08:51:29 +0000
Subject: [PATCH] windowing/gbm: a move takes a free CRTC first, and no display
 with it

Where the CRTC in use cannot drive the output that Kodi moves to, the move
took the first CRTC that can (MoveCrtc()), whether it was off or still fed
another display (the console's, in the seconds after Kodi starts, before the
outputs it does not use are turned off). Neither the test of the move
(TestOutputMove()) nor its commit took that display off the CRTC: the driver
would refuse the move (and a start of Kodi was offered for nothing), or show
Kodi on both displays.

MoveCrtc() now takes the CRTC in use where it can, as before; else the first
one that can and is off; and only where every one that can is on, the first of
them. The test and the commit of the move take every output but the one Kodi
moves to off the CRTC of the move, as they did with its planes.

Host test: the choice with CRTCs that are on and off; two more mutations of
it caught.
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp     | 20 +++++++++++++++++---
 xbmc/windowing/gbm/drm/DRMOutputChoice.h | 23 ++++++++++++++++-------
 xbmc/windowing/gbm/drm/DRMUtils.cpp      | 13 ++++++++++---
 3 files changed, 43 insertions(+), 13 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 80f6779..31fa8a0 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -182,8 +182,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   {
     // (the output that Kodi left, on whichever CRTC; the others, with their CRTCs: the one Kodi
     // left when it is another one, and one that a display it moves to was still driven by; and
-    // on the CRTC of the move, every plane but the one that shows Kodi: TestOutputMove() asked
-    // the driver for the same)
+    // on the CRTC of the move, every plane but the one that shows Kodi, and every output but the
+    // one it moves to, that CRTC being one that fed another display (MoveCrtc()), which would
+    // show Kodi too: TestOutputMove() asked the driver for the same)
     if (m_moveFrom != m_connector)
       AddProperty(m_moveFrom, "CRTC_ID", 0);
     DisableOtherOutputs(flags);
@@ -196,6 +197,12 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
         AddProperty(plane.get(), "FB_ID", 0);
       }
     }
+    for (const auto& connector : GetConnectors())
+    {
+      if (connector.get() != m_connector &&
+          connector->GetPropertyValue("CRTC_ID").value_or(0) == m_crtc->GetId())
+        AddProperty(connector.get(), "CRTC_ID", 0);
+    }
     tells = false;
   }
 
@@ -598,7 +605,8 @@ bool CDRMAtomic::TestOutputMove(const OutputMove& move, struct gbm_bo* bo, std::
     add(crtc.get(), "ACTIVE", 0);
     add(crtc.get(), "MODE_ID", 0);
   }
-  // the output in use leaves its CRTC, and the planes of the CRTC of the move but its own go off
+  // the output in use leaves its CRTC, and the planes of the CRTC of the move but its own go off,
+  // and the outputs that it feeds but the one Kodi moves to (one that fed another display)
   add(m_connector, "CRTC_ID", 0);
   for (const auto& plane : m_planes)
   {
@@ -609,6 +617,12 @@ bool CDRMAtomic::TestOutputMove(const OutputMove& move, struct gbm_bo* bo, std::
       add(plane.get(), "FB_ID", 0);
     }
   }
+  for (const auto& connector : GetConnectors())
+  {
+    if (connector.get() != move.connector &&
+        connector->GetPropertyValue("CRTC_ID").value_or(0) == move.crtc->GetId())
+      add(connector.get(), "CRTC_ID", 0);
+  }
   // the output it moves to, in the mode of its display, and the buffer on its plane
   add(move.connector, "CRTC_ID", move.crtc->GetCrtcId());
   add(move.crtc, "MODE_ID", mode.Get());
diff --git a/xbmc/windowing/gbm/drm/DRMOutputChoice.h b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
index 0b2c58a..ba1d4ca 100644
--- a/xbmc/windowing/gbm/drm/DRMOutputChoice.h
+++ b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
@@ -234,19 +234,28 @@ inline bool WouldChooseAnother(const std::vector<std::vector<DRMOutput>>& device
  *        CRTC (the bits of possible_crtcs)
  * \param current the index of the CRTC in use
  * \param count how many CRTCs the device has
+ * \param active the CRTCs that are on now, by their index: those that feed a display (the
+ *        console's, in the first seconds after Kodi starts)
  * \return current, where that output can be driven by it: what shows Kodi stays as it is then
- *         (its plane, which is often of one CRTC only); else the first of the others that can,
- *         which the commit of the move turns on as it turns current off; -1 when none can
+ *         (its plane, which is often of one CRTC only); else the first of the others that can and
+ *         is off; else the first of the others that can, whose display the commit of the move
+ *         takes off it (CDRMAtomic: every output on the CRTC of the move but its own leaves it);
+ *         -1 when none can. The commit turns current off.
  */
-inline int MoveCrtc(uint32_t possible, int current, int count)
+inline int MoveCrtc(uint32_t possible, int current, int count, uint32_t active = 0)
 {
-  const auto can = [possible](int index)
-  { return index >= 0 && index < 32 && (possible & (uint32_t{1} << index)) != 0; };
-  if (current < count && can(current))
+  const auto in = [](uint32_t mask, int index)
+  { return index >= 0 && index < 32 && (mask & (uint32_t{1} << index)) != 0; };
+  if (current < count && in(possible, current))
     return current;
   for (int index = 0; index < count; ++index)
   {
-    if (can(index))
+    if (in(possible, index) && !in(active, index))
+      return index;
+  }
+  for (int index = 0; index < count; ++index)
+  {
+    if (in(possible, index))
       return index;
   }
   return -1;
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 0403dd6..2fd9f4a 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1684,7 +1684,8 @@ bool CDRMUtils::PlanOutputMove(CDRMConnector* connector, OutputMove& move, std::
     return false;
   }
 
-  // A CRTC that can drive it: the one in use, where it can (what shows Kodi stays then)
+  // A CRTC that can drive it: the one in use, where it can (what shows Kodi stays then), else one
+  // that is off, else one whose display the commit of the move takes off it (MoveCrtc())
   uint32_t possible = 0;
   const std::vector<uint32_t> encoders = connector->GetEncoderIds();
   for (const auto& encoder : m_encoders)
@@ -1692,8 +1693,14 @@ bool CDRMUtils::PlanOutputMove(CDRMConnector* connector, OutputMove& move, std::
     if (std::ranges::find(encoders, encoder->GetEncoderId()) != encoders.end())
       possible |= encoder->GetPossibleCrtcsMask();
   }
-  const int crtcIndex =
-      MoveCrtc(possible, static_cast<int>(m_crtc->GetOffset()), static_cast<int>(m_crtcs.size()));
+  uint32_t active = 0;
+  for (std::size_t i = 0; i < m_crtcs.size() && i < 32; ++i)
+  {
+    if (m_crtcs[i]->GetPropertyValue("ACTIVE").value_or(0) != 0)
+      active |= uint32_t{1} << i;
+  }
+  const int crtcIndex = MoveCrtc(possible, static_cast<int>(m_crtc->GetOffset()),
+                                 static_cast<int>(m_crtcs.size()), active);
   if (crtcIndex < 0)
   {
     why = "no CRTC of the device can drive it";
-- 
2.53.0

