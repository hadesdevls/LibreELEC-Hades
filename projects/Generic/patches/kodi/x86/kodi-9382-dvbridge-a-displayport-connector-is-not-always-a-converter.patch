From 8cac8e0d3786d4e2c199c1b2aad8f5ea857cf5f8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 15:10:57 +0000
Subject: [PATCH] dvbridge: a DisplayPort connector is not always a converter

When a TV with Dolby Vision Standard is on a connector that the driver calls
DisplayPort, the log said that the display was "through a converter (an
LSPCON on the board, or a DisplayPort or USB-C to HDMI adapter)". The
diagnostic of an HP ZBook 17 G6 (Quadro RTX 4000) shows another case: its
HDMI port is a dual-mode port of the card. nvidia-drm has two encoders on
that connector, one per output of the card's display table, and the audio
ELD that NVKMS builds says HDMI with Supports_AI, which it does only for a
display that it drives as TMDS and not through the DisplayPort library. The
card itself sends HDMI there; nvidia-drm still calls the connector DP-2,
after the port, and attaches NV_HDMI_VSIF_METADATA and "max bpc" to HDMI
connectors only, so native output is not offered there either.

Say what is known: the connector is called DisplayPort by the driver, the
cause can be a converter or a dual-mode port, and native output needs a
connector that the driver calls HDMI. Only the log line and its comment
change; the code of the reason and the text of the player information
("the TV is on a DisplayPort output or converter") stay.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 013336f..2e52c21 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1133,12 +1133,17 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode) const
                CDVBridgeState::Backend::NONE &&
            connector->GetType() == "DP")
   {
-    // Hades: a TV with Dolby Vision Standard on a DisplayPort output is behind a converter
-    // (an LSPCON on the board, as on many Intel desktops, or a DisplayPort or USB-C adapter):
-    // the tunnel is an HDMI one, and only a native HDMI output of the graphics card has it.
+    // Hades: a TV with Dolby Vision Standard on a connector that the driver calls DisplayPort is
+    // behind a converter (an LSPCON on the board, as on many Intel desktops, or a DisplayPort or
+    // USB-C adapter), or on a dual-mode port that the graphics card drives as HDMI itself: the
+    // HDMI port of an HP ZBook 17 G6 is one (nvidia-drm names the connector after the port of the
+    // card, and gives its HDMI properties, the vendor InfoFrame and "max bpc", to HDMI connectors
+    // only). The tunnel is an HDMI one, and it is offered only where the driver has an HDMI
+    // connector.
     code = "converter";
-    reason = "the display is on a DisplayPort output, through a converter (an LSPCON on the board, "
-             "or a DisplayPort or USB-C to HDMI adapter); native output needs a native HDMI output";
+    reason = "the display is on a connector that the driver calls DisplayPort (a converter or a "
+             "dual-mode port on the board, or a DisplayPort or USB-C to HDMI adapter); native "
+             "output needs one that it calls HDMI";
   }
   else if (backend == CDVBridgeState::Backend::NONE)
   {
