From 339cd66dadf93a078ee63b2396a0bec469e7036a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:45:23 +0000
Subject: [PATCH] CDVDDemuxFFmpeg: HDR10+ that never brings statistics is sent
 as Dolby Vision, measured

A stream whose HDR10+ metadata give no level 1 block in any of the
access units looked at (no distribution of maxRGB, or percentiles that
go down) was not sent as Dolby Vision at all with "HDR10+ as Dolby
Vision" on: CDVHdr10Plus::Judge() never said HDR10PLUS, and it played
as HDR10+ or HDR10.

Now, as the user chose, such a stream is sent as Dolby Vision all the
same where it is otherwise one that would be (a picture, nothing of
Dolby Vision, BT.2020 PQ, the luminance of its mastering display known:
CDVHdr10Plus::WithoutStatistics()): every one of its pictures is then
INCOMPLETE, and CDVHdr10PlusFill measures its level 1 from the picture,
as HDR10 measured as Dolby Vision does; HDR10+ metadata of its own that
come later are taken from their first picture. Only where that filling
is on (<video><dvhdr10plusfill>, on by default), and only after the 48
packets of the probe: one of them that brings statistics makes the
stream an ordinary HDR10+ one as before. kodi.log says which it is.
---
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 31 +++++++++++++++----
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  3 ++
 .../VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp   |  8 +++++
 .../VideoPlayer/DVDDemuxers/DVHdr10Plus.h     | 10 ++++++
 4 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 5a2ccbb..02bd866 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1515,16 +1515,27 @@ void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
     return;
   const CDVHdr10Plus::Verdict verdict =
       CDVHdr10Plus::Judge(unit, avStream->codecpar, containerMastering);
+  bool withoutStatistics = false;
   if (verdict != CDVHdr10Plus::Verdict::HDR10PLUS)
   {
+    if (CDVHdr10Plus::WithoutStatistics(unit, avStream->codecpar, containerMastering))
+      ++m_dvWithoutStatistics[streamIdx];
+    // Hades: HDR10+ metadata that bring no statistics in any access unit looked at (they never did
+    // in this stream so far): sent as Dolby Vision all the same, measured from the picture where
+    // they give no level 1 block (CDVHdr10PlusFill), where that is on (<video><dvhdr10plusfill>)
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const bool fill = !component || component->GetAdvancedSettings()->m_videoDVHdr10PlusFill;
+    withoutStatistics = verdict == CDVHdr10Plus::Verdict::NOT_YET && probed >= done && fill &&
+                        m_dvWithoutStatistics[streamIdx] > 0;
     // (the last access unit looked at, or one that says that it never will be: said once)
-    if (verdict != CDVHdr10Plus::Verdict::NOT_YET || probed >= done)
+    if (!withoutStatistics && (verdict != CDVHdr10Plus::Verdict::NOT_YET || probed >= done))
     {
       probed = done;
       CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: stream {} has HDR10+ metadata; not as Dolby Vision: {}",
                 streamIdx, CDVHdr10Plus::Why(unit, avStream->codecpar, containerMastering));
     }
-    return;
+    if (!withoutStatistics)
+      return;
   }
   probed = done;
   if (!DVBRIDGE::Hdr10PlusAsDolbyVision())
@@ -1540,10 +1551,18 @@ void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
       av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
   if (!CDVHdr10Plus::Record(avStream->codecpar, rate, record))
     return;
-  CLog::Log(LOGINFO,
-            "CDVDDemuxFFmpeg: stream {} is HDR10+ without Dolby Vision: it is Dolby Vision profile 8.1 "
-            "from here on, with metadata made from its HDR10+ metadata (HDR10+ as Dolby Vision)",
-            streamIdx);
+  if (withoutStatistics)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} is HDR10+ without Dolby Vision, and its HDR10+ metadata give "
+              "no statistics in the {} access units of them looked at: it is Dolby Vision profile 8.1 "
+              "from here on, with metadata measured from the picture where its HDR10+ give none "
+              "(HDR10+ as Dolby Vision)",
+              streamIdx, m_dvWithoutStatistics[streamIdx]);
+  else
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} is HDR10+ without Dolby Vision: it is Dolby Vision profile "
+              "8.1 from here on, with metadata made from its HDR10+ metadata (HDR10+ as Dolby Vision)",
+              streamIdx);
   m_dvPromoted[streamIdx] = record;
   m_dvFromHdr10Plus[streamIdx] = true;
   video->doviFromHdr10Plus = true;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index f30028f..69d66a4 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -244,6 +244,9 @@ protected:
   //! Hades: ... or measured from the picture (HDR10 measured as Dolby Vision): the streams made so,
   //! which the probe goes on looking at (their HDR10+ metadata or Dolby Vision give them back)
   std::map<int, bool> m_dvMeasured;
+  //! Hades: the access units of a stream looked at whose HDR10+ metadata give no level 1 block, of
+  //! one that is otherwise HDR10+ to be sent as Dolby Vision (CDVHdr10Plus::WithoutStatistics())
+  std::map<int, unsigned int> m_dvWithoutStatistics;
   void UnmakeMeasured(CDemuxStream* stream, int streamIdx, const char* why);
   void ProbeHdr10Plus(CDemuxStream* stream,
                       int streamIdx,
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
index 6178da0..ba7e8c1 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
@@ -118,6 +118,14 @@ const char* CDVHdr10Plus::Why(const AccessUnit& unit,
   return "";
 }
 
+bool CDVHdr10Plus::WithoutStatistics(const AccessUnit& unit,
+                                     const AVCodecParameters* parameters,
+                                     bool containerMastering)
+{
+  return unit.picture && !unit.dolbyVision && !unit.t35.empty() && Pq(parameters) &&
+         (containerMastering || unit.mastering) && !MakesLevel1(unit.t35);
+}
+
 bool CDVHdr10Plus::Measurable(const AccessUnit& unit,
                               const AVCodecParameters* parameters,
                               bool containerMastering)
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
index 9227a76..7881368 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
@@ -68,6 +68,16 @@ public:
   //! A level 1 block can be made of the HDR10+ metadata of a payload of AccessUnit::t35
   static bool MakesLevel1(const std::vector<uint8_t>& t35);
 
+  //! Hades: an access unit that Judge() would take but for its statistics: a picture, nothing of
+  //! Dolby Vision, HDR10+ metadata from which no level 1 block can be made, BT.2020 PQ, the
+  //! luminance of its mastering display known. A stream whose HDR10+ metadata are of this kind in
+  //! all of the access units looked at is sent as Dolby Vision all the same, measured from the
+  //! picture where its HDR10+ metadata give no level 1 block (CDVHdr10PlusFill), as HDR10 measured
+  //! as Dolby Vision is: until now it was not sent as Dolby Vision at all.
+  static bool WithoutStatistics(const AccessUnit& unit,
+                                const AVCodecParameters* parameters,
+                                bool containerMastering);
+
   //! Hades: HDR10 measured as Dolby Vision (videoscreen.hadesdvfromhdr10): an access unit with a
   //! picture and nothing of Dolby Vision or HDR10+, of BT.2020 PQ, with the luminance of the mastering
   //! display known (the source range of the metadata). The probe goes on over the next packets: one
-- 
2.53.0

