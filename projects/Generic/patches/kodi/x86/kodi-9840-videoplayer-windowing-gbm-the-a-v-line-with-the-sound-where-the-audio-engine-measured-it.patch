From 7417facd847f847e5a6b8eb1396e79dde61555cc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:39:42 +0000
Subject: [PATCH] VideoPlayer, windowing/gbm: the A/V line with the sound where
 the audio engine measured it

The A/V line of the window system ("the picture went out against its sound
by ...") took the sound of each frame to play when the player's clock with
its vsync adjustment reaches it, which is what the audio engine is asked to
do. Without resampling (passthrough always, and decoded sound without "Sync
playback to display") the engine leaves the sound where it started for as
long as it stays within the player's limit of 50 ms: the line left that out.
In the logs of users it said -41.9 ms in every window, while the flips
against the player's clock, where the engine had started the sound, came
from 76 to 20 ms early from one playback to the next, by where each started
against the refreshes.

The audio sink now tells the clock how far ahead of it the engine last
measured the sound (CDVDClock::SetAudioSyncError(); for TrueHD passed
through the error itself, not the 0.45 of it that the engine averages), and
the line takes it in. Without sound, or before the engine has placed it,
there is no time for the sound and no line.
---
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp        | 27 +++++++++++++++++++
 xbmc/cores/VideoPlayer/AudioSinkAE.h          |  4 +++
 xbmc/cores/VideoPlayer/DVDClock.h             | 25 +++++++++++++++++
 .../VideoRenderers/RenderManager.cpp          | 16 ++++++++---
 xbmc/windowing/gbm/PresentLag.h               |  8 +++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  3 ++-
 6 files changed, 75 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
index e52d309..306a62e 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -26,6 +26,14 @@ extern "C"
 
 using namespace std::chrono_literals;
 
+namespace
+{
+// Hades: the audio engine scales the error of TrueHD passed through by this before it averages and
+// tells it (CActiveAE::RunStages(): "underestimate error for TrueHD passthrough"); the clock is told
+// the error itself
+constexpr double TRUEHD_ERROR_SCALE = 0.45;
+} // namespace
+
 CAudioSinkAE::CAudioSinkAE(CDVDClock *clock) : m_pClock(clock)
 {
   m_bPassthrough = false;
@@ -91,6 +99,7 @@ void CAudioSinkAE::Destroy(bool finish)
   m_bPassthrough = false;
   m_bPaused = true;
   m_playingPts = DVD_NOPTS_VALUE;
+  TellSyncError(false); // (Hades)
 }
 
 unsigned int CAudioSinkAE::AddPackets(const DVDAudioFrame &audioframe)
@@ -111,12 +120,18 @@ unsigned int CAudioSinkAE::AddPackets(const DVDAudioFrame &audioframe)
       m_syncErrorTime = info.errortime;
       m_syncError = info.error / 1000 * DVD_TIME_BASE;
       m_resampleRatio = info.rr;
+      // Hades: where the sound is against the clock, in its own unit, for the A/V line
+      m_heardError = m_bPassthrough && m_dataType == CAEStreamInfo::STREAM_TYPE_TRUEHD
+                         ? m_syncError / TRUEHD_ERROR_SCALE
+                         : m_syncError;
+      TellSyncError(true);
     }
   }
   else
   {
     m_syncErrorTime = 0;
     m_syncError = 0.0;
+    TellSyncError(false); // (Hades)
   }
 
   // Use wall-clock deadline independent of playback speed (fixes dimensional error
@@ -204,6 +219,7 @@ void CAudioSinkAE::Pause()
   if (m_pAudioStream)
     m_pAudioStream->Pause();
   m_bPaused = true; // (Hades)
+  TellSyncError(false); // (Hades)
   CLog::Log(LOGDEBUG,"CDVDAudio::Pause - pausing audio stream");
   m_playingPts = DVD_NOPTS_VALUE;
 }
@@ -241,6 +257,7 @@ void CAudioSinkAE::Flush()
   m_playingPts = DVD_NOPTS_VALUE;
   m_syncError = 0.0;
   m_syncErrorTime = 0;
+  TellSyncError(false); // (Hades)
 }
 
 void CAudioSinkAE::AbortAddPackets()
@@ -322,6 +339,16 @@ double CAudioSinkAE::GetSyncError()
 void CAudioSinkAE::SetSyncErrorCorrection(double correction)
 {
   m_syncError += correction;
+  // Hades: the clock moved by that much (CDVDClock::ErrorAdjust()), in the unit of the sound
+  m_heardError += correction;
+  if (m_syncErrorTime)
+    TellSyncError(true);
+}
+
+void CAudioSinkAE::TellSyncError(bool known)
+{
+  if (m_pClock)
+    m_pClock->SetAudioSyncError(known ? m_heardError : 0.0, known);
 }
 
 double CAudioSinkAE::GetResampleRatio()
diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.h b/xbmc/cores/VideoPlayer/AudioSinkAE.h
index e2aff52..1321d92 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.h
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.h
@@ -69,6 +69,10 @@ protected:
   double m_timeOfPts;
   double m_syncError;
   unsigned int m_syncErrorTime;
+  //! Hades: m_syncError in its own unit for TrueHD passed through too, as the clock is told it
+  //! (TellSyncError())
+  double m_heardError = 0.0;
+  void TellSyncError(bool known);
   double m_resampleRatio = 0.0; // invalid
   CCriticalSection m_critSection;
 
diff --git a/xbmc/cores/VideoPlayer/DVDClock.h b/xbmc/cores/VideoPlayer/DVDClock.h
index 773e2c3..de30ab4 100644
--- a/xbmc/cores/VideoPlayer/DVDClock.h
+++ b/xbmc/cores/VideoPlayer/DVDClock.h
@@ -10,6 +10,7 @@
 
 #include "threads/CriticalSection.h"
 
+#include <atomic>
 #include <memory>
 #include <stdint.h>
 
@@ -52,6 +53,27 @@ public:
   bool GetClockInfo(int& MissedVblanks, double& ClockSpeed, double& RefreshRate) const;
   void SetVsyncAdjust(double adjustment);
   double GetVsyncAdjust();
+  /*!
+   * rief Hades: how far ahead of this clock with its vsync adjustment the sound plays, as the
+   *        audio engine last measured it (CAudioSinkAE), in DVD time; known: false while there is
+   *        no such measurement (no sound, a stream that starts, flushed or paused)
+   *
+   * Without resampling the engine leaves the sound where it started for as long as it is within
+   * the limit of the player (CVideoPlayerAudio::OutputPacket(), 50 ms): what is seen against what
+   * is heard is then the picture against this clock with this error in it.
+   */
+  void SetAudioSyncError(double error, bool known)
+  {
+    m_audioSyncError.store(error, std::memory_order_relaxed);
+    m_audioSyncKnown.store(known, std::memory_order_release);
+  }
+  bool GetAudioSyncError(double& error) const
+  {
+    if (!m_audioSyncKnown.load(std::memory_order_acquire))
+      return false;
+    error = m_audioSyncError.load(std::memory_order_relaxed);
+    return true;
+  }
 
   void Pause(bool pause);
   bool IsPaused() const;
@@ -84,4 +106,7 @@ protected:
 
   double m_maxspeedadjust;
   CCriticalSection m_speedsection;
+
+  std::atomic<double> m_audioSyncError{0.0}; //!< Hades: see SetAudioSyncError()
+  std::atomic<bool> m_audioSyncKnown{false};
 };
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 829ee1b..1a04c99 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -1479,10 +1479,18 @@ void CRenderManager::PrepareNextRender()
                                 std::chrono::steady_clock::now().time_since_epoch())
                                 .count() +
                             static_cast<int64_t>((pts - frameOnScreen) / DVD_TIME_BASE * 1e9);
-      // (Hades: the audio engine plays the sound of pts when the clock with its adjustment to
-      // the refreshes reaches it, CAudioSinkAE::GetClock(): that much sooner than dueNs)
-      dvWindow->VideoFrameChosen(
-          dueNs, dueNs - static_cast<int64_t>(m_dvdClock.GetVsyncAdjust() / DVD_TIME_BASE * 1e9));
+      // (Hades: the audio engine is to play the sound of pts when the clock with its adjustment to
+      // the refreshes reaches it, CAudioSinkAE::GetClock(): that much sooner than dueNs; it plays
+      // it sooner still by as much as it measured the sound ahead of that clock, which it leaves
+      // there without resampling while it is within the player's limit. Not known: no sound, or
+      // none placed yet, and no time for it)
+      const int64_t clockSoundNs =
+          dueNs - static_cast<int64_t>(m_dvdClock.GetVsyncAdjust() / DVD_TIME_BASE * 1e9);
+      double heard = 0.0;
+      const int64_t soundNs = m_dvdClock.GetAudioSyncError(heard)
+                                  ? clockSoundNs - static_cast<int64_t>(heard / DVD_TIME_BASE * 1e9)
+                                  : 0;
+      dvWindow->VideoFrameChosen(dueNs, soundNs);
     }
   };
 #endif
diff --git a/xbmc/windowing/gbm/PresentLag.h b/xbmc/windowing/gbm/PresentLag.h
index a77cc8e..f160e9b 100644
--- a/xbmc/windowing/gbm/PresentLag.h
+++ b/xbmc/windowing/gbm/PresentLag.h
@@ -109,8 +109,9 @@ public:
 
   //! Hades: the counts of a CPresentLag that was given, instead of when the clock calls for each
   //! frame, when its sound is played (the player's clock with its adjustment to the refreshes, as
-  //! the audio engine takes it: CRenderManager::PrepareNextRender()): the A/V offset of the
-  //! picture at the output, after its sound when positive
+  //! the audio engine takes it, less how far ahead of it the engine measured the sound:
+  //! CRenderManager::PrepareNextRender()): the A/V offset of the picture at the output, after its
+  //! sound when positive
   std::string AvText() const
   {
     std::string text;
@@ -130,7 +131,8 @@ public:
     if (text.empty())
       return text;
     return "the picture went out against its sound by " + text +
-           " (positive: after it; at the output of this computer, before the display)";
+           " (positive: after it; at the output of this computer, before the display; the sound "
+           "where the audio engine measured it)";
   }
 
   void Reset() { m_ways = {}; }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index afbc89b..9c190f2 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -375,7 +375,8 @@ public:
   //! Hades: the render manager chose a frame for the screen, whose time by the player's clock is
   //! dueNs (steady clock, CPresentLag). Main thread, before the pass that presents it.
   //! Hades: ... and soundNs, when its sound is played (the clock with its adjustment to the
-  //! refreshes, as the audio engine takes it): the A/V offset of the frame (m_dvAv, m_videoAv)
+  //! refreshes, as the audio engine takes it, less how far ahead of it the engine measured the
+  //! sound; 0: not known): the A/V offset of the frame (m_dvAv, m_videoAv)
   void VideoFrameChosen(int64_t dueNs, int64_t soundNs = 0)
   {
     m_lagChosenSoundNs = soundNs;
-- 
2.53.0

