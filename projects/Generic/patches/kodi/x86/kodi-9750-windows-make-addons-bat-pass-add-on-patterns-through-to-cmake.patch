From 0dd478e254d85c53ff610dadab871f7a080ca451 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Sun, 1 Nov 2026 15:32:20 +0100
Subject: [PATCH] [windows] make-addons.bat: pass add-on patterns through to
 CMake

FOR expanded arguments such as pvr.* as file names, which matched nothing
and dropped them; a list of patterns alone then built every add-on. The
delayed expansion it used also stripped the ^ from anchored patterns such
as Jenkins' ^peripheral\.joystick$.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/buildsteps/windows/make-addons.bat | 31 +++++++++++++-----------
 1 file changed, 17 insertions(+), 14 deletions(-)

diff --git a/tools/buildsteps/windows/make-addons.bat b/tools/buildsteps/windows/make-addons.bat
index b8e0ac5..8285294 100644
--- a/tools/buildsteps/windows/make-addons.bat
+++ b/tools/buildsteps/windows/make-addons.bat
@@ -8,21 +8,24 @@ SET package=false
 SET addon=
 SET store=
 
-SETLOCAL EnableDelayedExpansion
-FOR %%b IN (%*) DO (
-  IF %%~b == install (
-    SET install=true
-  ) ELSE ( IF %%~b == clean (
-    SET clean=true
-  ) ELSE ( IF %%~b == package (
-    SET package=true
-  ) ELSE ( IF %%~b == win10 (
-    SET store=store
-  ) ELSE (
-    SET addon=!addon! %%~b
-  ))))
-)
 SETLOCAL DisableDelayedExpansion
+rem SHIFT passes add-on patterns such as pvr.* through as typed, for ADDONS_TO_BUILD
+:parseArgs
+IF "%~1" == "" GOTO argsParsed
+IF "%~1" == "install" (
+  SET install=true
+) ELSE IF "%~1" == "clean" (
+  SET clean=true
+) ELSE IF "%~1" == "package" (
+  SET package=true
+) ELSE IF "%~1" == "win10" (
+  SET store=store
+) ELSE (
+  SET "addon=%addon% %~1"
+)
+SHIFT /1
+GOTO parseArgs
+:argsParsed
 
 PUSHD %~dp0\..\..\..
 SET WORKDIR=%CD%
-- 
