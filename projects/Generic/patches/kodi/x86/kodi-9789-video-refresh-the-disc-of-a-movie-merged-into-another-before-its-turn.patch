From 831a4a7bf537a980fe30bbfe37c05b114c457ab9 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Thu, 29 Oct 2026 02:40:58 +0000
Subject: [PATCH] [Video] Refresh the disc of a movie merged into another
 before its turn.

A refresh of a source refreshes each movie it listed. Refreshing a disc
of a film makes the film's other discs, separate movies in its folder,
one movie, so with three or more of them the movie of a disc not yet
refreshed could become a version of another. Looked up by its listed
id, it was then skipped, and its disc never read.

A movie is now found by the file it was listed with, which finds the
movie it became a version of, and is refreshed from that disc as
before. The disc refreshed last is the movie's default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../jobs/VideoLibraryRefreshingSourceJob.cpp  | 13 ++++---
 xbmc/video/test/TestVideoInfoScanner.cpp      | 35 +++++++++++++++++++
 2 files changed, 44 insertions(+), 4 deletions(-)

diff --git a/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
index 232827b..b2ba395 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
@@ -144,12 +144,17 @@ bool CVideoLibraryRefreshingSourceJob::Work(CVideoDatabase& db)
     const auto& [item, refreshAll] = itemsToRefresh[i];
     const CVideoInfoTag& listed{*item->GetVideoInfoTag()};
 
-    // refreshing an earlier item may have merged it with this one as a version, changing its
-    // default version, or removed this one
+    // Refreshing an earlier item may have merged it with this one as a version, changing its
+    // default version, or removed this one. A movie is found by the file it was listed with, as
+    // merging the discs of a film may have made it a version of another movie the earlier item
+    // joined, though its disc wasn't refreshed.
     CVideoInfoTag tag;
     bool found{false};
     if (listed.m_type == MediaTypeMovie)
-      found = db.GetMovieInfo({}, tag, listed.m_iDbId);
+    {
+      const int idMovie{db.GetMovieId(listed.m_strFileNameAndPath)};
+      found = idMovie > 0 && db.GetMovieInfo({}, tag, idMovie);
+    }
     else if (listed.m_type == MediaTypeTvShow)
       found = db.GetTvShowInfo({}, tag, listed.m_iDbId);
     else
@@ -167,7 +172,7 @@ bool CVideoLibraryRefreshingSourceJob::Work(CVideoDatabase& db)
             listed.m_iFileId, tag.m_iDbId, MediaTypeMovie,
             static_cast<int>(VideoAssetType::VERSION))) > 0 &&
         db.SetDefaultVideoVersion(VideoDbContentType::MOVIES, tag.m_iDbId, listed.m_iFileId) &&
-        !db.GetMovieInfo({}, tag, listed.m_iDbId))
+        !db.GetMovieInfo({}, tag, tag.m_iDbId))
       continue;
     SetText(tag.GetTitle());
 
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index fc95cf4..03da142 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -1215,6 +1215,41 @@ TEST_F(TestVideoInfoScanner, ARefreshOfASourceRefreshesEachDiscOfAMovie)
   EXPECT_EQ(first, tag.m_strFileNameAndPath);
 }
 
+// Merging the discs of a film as an earlier disc is refreshed makes the movie of a later one a
+// version, which is still refreshed from its own disc. The disc refreshed last is the default.
+TEST_F(TestVideoInfoScanner, ARefreshOfASourceRefreshesADiscMergedBeforeItsTurn)
+{
+  const Strings strings;
+  ASSERT_TRUE(strings.loaded);
+  UseTestScraper(ADDON::AddonType::SCRAPER_MOVIES);
+  InstallTestScraper();
+  GroupSimilarVideosAutomatically();
+  FilmFound();
+  const std::string folder{Folder(m_root, "Film (2010)")};
+  const std::string first{File(Folder(folder, "Disc 1"), "Film.mkv")};
+  const std::string second{File(Folder(folder, "Disc 2"), "Film.mkv")};
+  const std::string third{File(Folder(folder, "Disc 3"), "Film.mkv")};
+  // listed in the order they are added: refreshing Disc 2 merges Disc 3 into Disc 1 first
+  ASSERT_GT(AddFilm(second), 0);
+  ASSERT_GT(AddFilm(first), 0);
+  ASSERT_GT(AddFilm(third), 0);
+  // only a refresh of Disc 3 reads this
+  File(URIUtils::GetDirectory(third), "Film.nfo",
+       R"(<movie override="true"><title>Third refreshed</title></movie>)");
+
+  TestRefreshingSourceJob refresh{m_root};
+  ASSERT_TRUE(refresh.Work(m_db));
+
+  EXPECT_EQ(1, CountMovies());
+  const int idMovie{m_db.GetMovieId(first)};
+  EXPECT_EQ(idMovie, m_db.GetMovieId(second));
+  EXPECT_EQ(idMovie, m_db.GetMovieId(third));
+  EXPECT_EQ("Third refreshed", m_db.GetMovieTitle(idMovie));
+  CVideoInfoTag tag;
+  ASSERT_TRUE(m_db.GetMovieInfo({}, tag, idMovie));
+  EXPECT_EQ(third, tag.m_strFileNameAndPath);
+}
+
 // An nfo naming the movie's url gives none of its details, which the refresh reads before it
 // removes the movie
 TEST_F(TestVideoInfoScanner, ARefreshWithAUrlNfoThatCantReadTheDetailsKeepsTheMovie)
