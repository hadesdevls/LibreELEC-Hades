From e3ae36d93ad7fa0c64c107bac7da503e7956643a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:11:47 +0000
Subject: [PATCH] dvbridge: every level of the extension blocks of an RPU is
 read for the player information

The page of the Dolby Vision metadata is to show every level that a stream
carries (L1 to L6, L8 to L11, L254, L255) and not only the ones that the
overview page showed (L1, L2, L5, L6 and the list of blocks). The values of
L3, L4, L8, L9, L10, L11, L254 and L255 were not kept anywhere.

LevelDetail is read from the validated RPU once for each frame (a loop over
at most 32 blocks, nothing formatted here): the offsets of L3, the anchor of
L4, the target display of each L8 and L10 block, the primaries of L9 named
from their CIE coordinates (BT.709, P3-D65, BT.2020 or custom), and the
values of L11, L254 and L255. It sits in PresentedDetail for native output
and in ConversionLevels() for a picture rebuilt as HDR10 or SDR, so that
the page can show the levels of a Dolby Vision video whichever way it goes
out.
---
 .../VideoRenderers/DVBridgeGLES.cpp           | 74 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h | 39 ++++++++++
 2 files changed, 113 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 8477d83..7af5408 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -21,6 +21,7 @@
 #include "settings/AdvancedSettings.h"
 #include "settings/SettingsComponent.h"
 #include "utils/StringUtils.h"
+#include "utils/HadesPlayerInfo.h"
 #include "utils/SystemInfo.h"
 #include "utils/log.h"
 
@@ -55,6 +56,75 @@ extern "C"
 
 // (every extension block of an RPU has its place in a PresentedDetail)
 static_assert(AV_DOVI_MAX_EXT_BLOCKS <= CDVBridgeGLES::PresentedDetail::MAX_BLOCKS);
+static_assert(AV_DOVI_MAX_EXT_BLOCKS <= CDVBridgeGLES::LevelDetail::MAX);
+
+void CDVBridgeGLES::LevelDetail::Read(const AVDOVIMetadata* parsed)
+{
+  *this = {};
+  if (!parsed)
+    return;
+  for (int i = 0; i < parsed->num_ext_blocks; ++i)
+  {
+    const AVDOVIDmData* ext = av_dovi_get_ext(parsed, i);
+    if (count < MAX)
+      levels[count++] = ext->level;
+    switch (ext->level)
+    {
+      case 3:
+        l3 = true;
+        l3Offsets[0] = static_cast<int>(ext->l3.min_pq_offset) - 2048;
+        l3Offsets[1] = static_cast<int>(ext->l3.avg_pq_offset) - 2048;
+        l3Offsets[2] = static_cast<int>(ext->l3.max_pq_offset) - 2048;
+        break;
+      case 4:
+        l4 = true;
+        l4Anchor = ext->l4.anchor_pq;
+        l4Power = ext->l4.anchor_power;
+        break;
+      case 8:
+        if (l8Count < std::size(l8Ids))
+          l8Ids[l8Count++] = ext->l8.target_display_index;
+        break;
+      case 9:
+      {
+        l9 = true;
+        l9Index = ext->l9.source_primary_index;
+        const auto& p = ext->l9.source_display_primaries.prim;
+        const std::string name = KODI::UTILS::PLAYERINFO::PrimariesName(
+            av_q2d(p.r.x), av_q2d(p.r.y), av_q2d(p.g.x), av_q2d(p.g.y), av_q2d(p.b.x),
+            av_q2d(p.b.y));
+        std::snprintf(l9Primaries, sizeof(l9Primaries), "%s", name.c_str());
+        break;
+      }
+      case 10:
+        if (l10Count < std::size(l10Ids))
+        {
+          l10Ids[l10Count] = ext->l10.target_display_index;
+          l10MaxPq[l10Count] = ext->l10.target_max_pq;
+          ++l10Count;
+        }
+        break;
+      case 11:
+        l11 = true;
+        l11Type = ext->l11.content_type;
+        l11White = ext->l11.whitepoint;
+        l11Reference = ext->l11.reference_mode_flag;
+        break;
+      case 254:
+        l254 = true;
+        l254Mode = ext->l254.dm_mode;
+        l254Version = ext->l254.dm_version_index;
+        break;
+      case 255:
+        l255 = true;
+        l255Mode = ext->l255.dm_run_mode;
+        l255Version = ext->l255.dm_run_version;
+        break;
+      default:
+        break;
+    }
+  }
+}
 
 namespace
 {
@@ -815,6 +885,8 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
       }
     }
     m_pendingDetail.cm4 = (m_pendingInfo & CDVPlaybackInfo::CM4) != 0;
+    // Hades: what every one of its blocks says, for the page of the metadata
+    m_pendingDetail.levelDetail.Read(parsed);
     // Hades: the source display of the RPU, and what of its metadata the display is sent, read
     // back from the payload of this frame (the transport carries it; nothing else changes it)
     const AVDOVIColorMetadata* source = av_dovi_get_color(parsed);
@@ -2251,6 +2323,8 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
                       : !layered && layerNotDecoded ? "MELSKIP"
                       : layered || unused          ? "MEL"
                                                    : "BL";
+    // Hades: and what the blocks of its RPU say, for the page of the metadata
+    m_convertLevels.Read(reinterpret_cast<const AVDOVIMetadata*>(metadata.Data()));
     // Hades: or mapped to SDR, for an output that takes no HDR10
     const bool sdr =
         m_convertMapping.enabled && m_convertMapping.target == DVBRIDGE_HDR10_TARGET_SDR;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 0362012..7b0290f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -176,6 +176,41 @@ public:
                       int l5[4],
                       bool& residual);
 
+  //! Hades: what the extension blocks of an RPU say, every level that a stream carries (L1 to L6,
+  //! L8 to L11, L254, L255), for the page of the Dolby Vision metadata of the player information.
+  //! Read from the RPU once for each frame (a loop over its blocks: nothing is formatted here).
+  struct LevelDetail
+  {
+    static constexpr unsigned int MAX = 32; //!< AV_DOVI_MAX_EXT_BLOCKS
+    unsigned int count = 0;
+    uint8_t levels[MAX] = {}; //!< the level of each block, in the order of the RPU
+    bool l3 = false;
+    int l3Offsets[3] = {}; //!< min, avg, max: the codes of the block less 2048
+    bool l4 = false;
+    int l4Anchor = 0; //!< as a 12-bit PQ code
+    int l4Power = 0;
+    unsigned int l8Count = 0;
+    uint8_t l8Ids[8] = {}; //!< target display indices of the trim blocks (L8 is L2 with more)
+    bool l9 = false;
+    int l9Index = 0;
+    char l9Primaries[8] = {}; //!< BT.709, P3-D65, BT.2020 or custom
+    unsigned int l10Count = 0;
+    uint8_t l10Ids[8] = {};
+    uint16_t l10MaxPq[8] = {}; //!< 12-bit PQ codes
+    bool l11 = false;
+    int l11Type = 0;
+    int l11White = 0;
+    int l11Reference = 0;
+    bool l254 = false;
+    int l254Mode = 0;
+    int l254Version = 0;
+    bool l255 = false;
+    int l255Mode = 0;
+    int l255Version = 0;
+    //! Reads the blocks of a validated RPU; nothing where it is null
+    void Read(const AVDOVIMetadata* parsed);
+  };
+
   //! What the last presented Dolby Vision frame carried, for the player information.
   struct PresentedDetail
   {
@@ -231,6 +266,7 @@ public:
     int transport = -1;
     int signalColorSpace = -1; //!< of the RPU: 0 YCbCr, 2 ICtCp (CCM 001 table 6)
     bool ipt = false; //!< Hades: transport 0 in IPT-PQ-c2 (dvbridge_render_ipt())
+    LevelDetail levelDetail; //!< Hades: what all its extension blocks say
   };
   const PresentedDetail& GetPresentedDetail() const { return m_presentedDetail; }
   //! Presented frames whose L1 differed from the previous presented frame, since the last call.
@@ -480,6 +516,8 @@ public:
   //! them (PresentedDetail): "FEL", "FELGAP", "MELSKIP" (a MEL layer that was not decoded),
   //! "MEL", "BL"; "" before the first one
   const char* ConversionLayers() const { return m_convertLayers; }
+  //! Hades: what the extension blocks of the RPU of that picture say (the level table of the page)
+  const LevelDetail& ConversionLevels() const { return m_convertLevels; }
   //! Hades: the GL texture of the last picture that was reconstructed whole (the one CopyConversion()
   //! copies), its size, and the place of the picture in it (from its top left): for what measures it
   //! (Dolby Vision sent as HDR10+). false when there is none.
@@ -674,6 +712,7 @@ private:
   unsigned int m_convertedFel = 0; //!< ... with the residual of their enhancement layer
   unsigned int m_convertFailed = 0; //!< ... that could not be
   const char* m_convertLayers = ""; //!< see ConversionLayers()
+  LevelDetail m_convertLevels; //!< see ConversionLevels()
   int m_convertComposed = 0; //!< see ConversionComposed()
   unsigned int m_convertedReshaped = 0; //!< ... of them composed by libplacebo's reshaping
   dvbridge_hdr10_mapping m_convertMapping{}; //!< see SetConversionMapping()
-- 
