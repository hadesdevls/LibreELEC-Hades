diff --git a/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
new file mode 100644
index 0000000..4d529ae
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
@@ -0,0 +1,308 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
