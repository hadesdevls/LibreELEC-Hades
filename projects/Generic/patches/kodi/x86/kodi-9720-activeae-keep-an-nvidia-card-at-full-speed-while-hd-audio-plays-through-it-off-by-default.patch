+ */
+
+#include "cores/AudioEngine/Utils/GpuClockHold.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <gtest/gtest.h>
+
+using namespace AE::GPUHOLD;
+
+namespace
+{
+//! Clocks that count what they are asked, and answer what they are told
+class CFakeClocks : public IClocks
+{
+public:
+  Outcome Lock() override
+  {
+    ++locks;
+    std::this_thread::sleep_for(std::chrono::milliseconds(lockDelayMs));
+    return {lockResult, lockResult ? "locked" : "refused (not supported by this card)"};
+  }
+  Outcome Unlock() override
+  {
+    ++unlocks;
+    return {true, "let go"};
+  }
+  std::atomic<int> locks{0};
+  std::atomic<int> unlocks{0};
+  bool lockResult{true};
+  int lockDelayMs{0};
+};
+
+//! The same clocks, for a thread that owns what it makes
+class CRefClocks : public IClocks
+{
+public:
+  explicit CRefClocks(CFakeClocks& clocks) : m_clocks(clocks) {}
+  Outcome Lock() override { return m_clocks.Lock(); }
+  Outcome Unlock() override { return m_clocks.Unlock(); }
+
+private:
+  CFakeClocks& m_clocks;
+};
+
+//! Waits for a condition up to two seconds
+template<typename F>
+bool Eventually(F condition)
+{
+  for (int i = 0; i < 200; ++i)
+  {
+    if (condition())
+      return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  return condition();
+}
+
+void Touch(const std::string& path, const std::string& text)
+{
+  std::ofstream(path) << text << '\n';
+}
+
+//! A folder that stands for the root of a system, with its tree of sysfs
+class CTree
+{
+public:
+  CTree()
+  {
+    char name[] = "/tmp/gpuholdXXXXXX";
+    root = mkdtemp(name);
+  }
+  ~CTree()
+  {
+    const std::string command = "rm -rf '" + root + "'";
+    if (system(command.c_str()) != 0)
+      std::fprintf(stderr, "could not remove %s\n", root.c_str());
+  }
+  void Dir(const std::string& path)
+  {
+    std::error_code error;
+    std::filesystem::create_directories(root + path, error);
+  }
+  void Link(const std::string& target, const std::string& path)
+  {
+    ASSERT_EQ(0, symlink(target.c_str(), (root + path).c_str()));
+  }
+  //! A card of a laptop: 0000:01:00.0 (display, nvidia) and 0000:01:00.1 (audio), the audio one as card1 / "NVidia"
+  void Laptop(const std::string& vendor = "0x10de", const std::string& driver = "nvidia",
+              const std::string& audioClass = "0x040300", const std::string& audioAddr = "0000:01:00.1")
+  {
+    const std::string slot = "/sys/devices/pci0000:00/0000:00:01.0/";
+    Dir(slot + "0000:01:00.0");
+    Dir(slot + audioAddr);
+    Touch(root + slot + "0000:01:00.0/vendor", vendor);
+    Touch(root + slot + "0000:01:00.0/class", "0x030000");
+    Touch(root + slot + audioAddr + "/vendor", vendor);
+    Touch(root + slot + audioAddr + "/class", audioClass);
+    Dir("/sys/bus/pci/drivers/" + driver);
+    Link("../../../../bus/pci/drivers/" + driver, "/sys/devices/pci0000:00/0000:00:01.0/0000:01:00.0/driver");
+    Dir("/sys/class/sound/card1");
+    Link("../../../devices/pci0000:00/0000:00:01.0/" + audioAddr, "/sys/class/sound/card1/device");
+    Dir("/sys/bus/pci/devices");
+    Link("../../../devices/pci0000:00/0000:00:01.0/0000:01:00.0", "/sys/bus/pci/devices/0000:01:00.0");
+    Dir("/proc/asound");
+    Link("card1", "/proc/asound/NVidia");
+  }
+  std::string root;
+};
+} // namespace
+
+TEST(TestGpuClockHold, OnlyAllFourAsk)
+{
+  Request all{true, true, true, true};
+  EXPECT_TRUE(Wants(all));
+  for (int missing = 0; missing < 4; ++missing)
+  {
+    Request r = all;
+    (missing == 0 ? r.setting : missing == 1 ? r.passthrough : missing == 2 ? r.hdFormat : r.nvidiaGpu) = false;
+    EXPECT_FALSE(Wants(r)) << "without " << missing;
+  }
+  EXPECT_FALSE(Wants(Request{}));
+}
+
+TEST(TestGpuClockHold, EngagesOnceAndLetsGoOnce)
+{
+  CFakeClocks clocks;
+  std::vector<std::string> said;
+  CHold hold(clocks, [&said](const std::string& s) { said.push_back(s); });
+
+  hold.Set(true);
+  EXPECT_TRUE(hold.Held());
+  hold.Set(true); // a second stream of HD audio: nothing more
+  hold.Set(true);
+  EXPECT_EQ(1, clocks.locks);
+  EXPECT_EQ(0, clocks.unlocks);
+
+  hold.Set(false);
+  EXPECT_FALSE(hold.Held());
+  hold.Set(false);
+  EXPECT_EQ(1, clocks.locks);
+  EXPECT_EQ(1, clocks.unlocks);
+
+  hold.Set(true); // the next one holds again
+  EXPECT_EQ(2, clocks.locks);
+  ASSERT_EQ(3u, said.size());
+  EXPECT_EQ("locked", said[0]);
+  EXPECT_EQ("let go", said[1]);
+}
+
+TEST(TestGpuClockHold, WithTheSettingOffNothingIsTouched)
+{
+  CFakeClocks clocks;
+  CHold hold(clocks, [](const std::string&) {});
+  // every stream of every kind, with the setting off: the policy never asks to hold
+  for (bool hd : {false, true})
+    for (bool passthrough : {false, true})
+      for (bool nvidia : {false, true})
+        hold.Set(Wants(Request{false, passthrough, hd, nvidia}));
+  EXPECT_EQ(0, clocks.locks);
+  EXPECT_EQ(0, clocks.unlocks);
+}
+
+TEST(TestGpuClockHold, ACardThatRefusesIsLeftAndNotAskedAgain)
+{
+  CFakeClocks clocks;
+  clocks.lockResult = false;
+  std::vector<std::string> said;
+  CHold hold(clocks, [&said](const std::string& s) { said.push_back(s); });
+  hold.Set(true);
+  EXPECT_FALSE(hold.Held());
+  EXPECT_TRUE(hold.Refused());
+  hold.Set(true); // the same card would say the same again
+  hold.Set(false); // nothing was held: nothing to let go
+  hold.Set(true);
+  EXPECT_EQ(1, clocks.locks);
+  EXPECT_EQ(0, clocks.unlocks);
+  ASSERT_EQ(1u, said.size());
+  EXPECT_NE(std::string::npos, said[0].find("not supported"));
+}
+
+TEST(TestGpuClockHold, TheSoundOfTheCardOfAnNvidiaGpu)
+{
+  CTree tree;
+  tree.Laptop();
+  const auto gpu = NvidiaGpuOfAudio(tree.root, "ALSA:hdmi:CARD=NVidia,DEV=0,AES0=0x06,AES1=0x82,AES2=0x00,AES3=0x09");
+  ASSERT_TRUE(gpu.has_value());
+  EXPECT_EQ("0000:01:00.0", *gpu);
+  EXPECT_TRUE(NvidiaGpuOfAudio(tree.root, "hdmi:CARD=NVidia,DEV=3").has_value());
+  // not that card, not a card at all
+  EXPECT_FALSE(NvidiaGpuOfAudio(tree.root, "hdmi:CARD=PCH,DEV=0").has_value());
+  EXPECT_FALSE(NvidiaGpuOfAudio(tree.root, "default").has_value());
+  EXPECT_FALSE(NvidiaGpuOfAudio(tree.root, "hdmi:CARD=../x,DEV=0").has_value());
+  EXPECT_FALSE(NvidiaGpuOfAudio(tree.root, "").has_value());
+}
+
+TEST(TestGpuClockHold, NotAnNvidiaCard)
+{
+  {
+    CTree amd; // the same layout from another maker
+    amd.Laptop("0x1002", "amdgpu");
+    EXPECT_FALSE(NvidiaGpuOfAudio(amd.root, "hdmi:CARD=NVidia,DEV=0").has_value());
+    EXPECT_FALSE(NvidiaGpuPresent(amd.root));
+  }
+  {
+    CTree nouveau; // NVIDIA, but not the driver that NVML belongs to
+    nouveau.Laptop("0x10de", "nouveau");
+    EXPECT_FALSE(NvidiaGpuOfAudio(nouveau.root, "hdmi:CARD=NVidia,DEV=0").has_value());
+    EXPECT_FALSE(NvidiaGpuPresent(nouveau.root));
+  }
+  {
+    CTree notAudio; // the "audio" function is not an audio device
+    notAudio.Laptop("0x10de", "nvidia", "0x030200");
+    EXPECT_FALSE(NvidiaGpuOfAudio(notAudio.root, "hdmi:CARD=NVidia,DEV=0").has_value());
+  }
+  {
+    CTree otherFunction; // not function 1
+    otherFunction.Laptop("0x10de", "nvidia", "0x040300", "0000:01:00.2");
+    EXPECT_FALSE(NvidiaGpuOfAudio(otherFunction.root, "hdmi:CARD=NVidia,DEV=0").has_value());
+  }
+  CTree empty;
+  EXPECT_FALSE(NvidiaGpuPresent(empty.root));
+}
+
+TEST(TestGpuClockHold, AnNvidiaGpuIsThere)
+{
+  CTree tree;
+  tree.Laptop();
+  EXPECT_TRUE(NvidiaGpuPresent(tree.root));
+}
+
+TEST(TestGpuClockHold, AsyncHoldsAndLetsGoWithoutWaiting)
+{
+  CFakeClocks clocks;
+  clocks.lockDelayMs = 300; // a driver that takes its time
+  std::atomic<int> says{0};
+  {
+    CAsyncHold hold([&clocks](const std::string&) { return std::unique_ptr<IClocks>(new CRefClocks(clocks)); },
+                    [&says](const std::string&) { ++says; });
+    const auto start = std::chrono::steady_clock::now();
+    hold.Set("0000:01:00.0", true);
+    EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::milliseconds(100));
+    EXPECT_TRUE(Eventually([&] { return clocks.locks == 1; }));
+    hold.Set("0000:01:00.0", true); // asked again: nothing more
+    hold.Set("", false);
+    EXPECT_TRUE(Eventually([&] { return clocks.unlocks == 1; }));
+    hold.Set("0000:01:00.0", true);
+    EXPECT_TRUE(Eventually([&] { return clocks.locks == 2; }));
+    // destroyed while held: the clocks are let go
+  }
+  EXPECT_EQ(2, clocks.locks);
+  EXPECT_EQ(2, clocks.unlocks);
+  EXPECT_EQ(4, says);
+}
+
+TEST(TestGpuClockHold, AsyncThatWasNeverAskedDoesNothing)
+{
+  std::atomic<int> made{0};
+  {
+    CAsyncHold hold(
+        [&made](const std::string&) -> std::unique_ptr<IClocks>
+        {
+          ++made;
+          return nullptr;
+        },
+        [](const std::string&) {});
+    hold.Set("", false); // the setting is off: the usual case
+    hold.Set("", false);
+  }
+  EXPECT_EQ(0, made);
+}
+
+TEST(TestGpuClockHold, AStaleLockIsLetGo)
+{
+  char name[] = "/tmp/gpuholdmXXXXXX";
+  const int fd = mkstemp(name);
+  ASSERT_GE(fd, 0);
+  close(fd);
+  const std::string marker = name;
+  std::remove(marker.c_str());
+
+  CFakeClocks clocks;
+  EXPECT_FALSE(RecoverStale(marker, &clocks).has_value()); // no marker: no effect at all
+  EXPECT_EQ(0, clocks.unlocks);
+
+  Touch(marker, "0000:01:00.0");
+  const auto said = RecoverStale(marker, &clocks);
+  ASSERT_TRUE(said.has_value());
+  EXPECT_EQ(1, clocks.unlocks);
+  EXPECT_NE(std::string::npos, said->find("earlier run"));
+  std::remove(marker.c_str());
+}
