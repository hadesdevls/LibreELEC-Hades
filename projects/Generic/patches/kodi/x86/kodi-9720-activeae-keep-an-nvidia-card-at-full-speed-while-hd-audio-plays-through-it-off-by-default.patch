@@ -42,10 +45,20 @@ CActiveAESink::CActiveAESink(CEvent* inMsgEvent)
 
 CActiveAESink::~CActiveAESink() = default;
 
+namespace
+{
+//! the file that says that a hold of the clocks was made (GpuClockHold.h, RecoverStale())
+constexpr const char* GPU_HOLD_MARKER = "/run/hades-gpu-clock-hold";
+} // namespace
+
 void CActiveAESink::Start()
 {
   if (!IsRunning())
   {
+    // a lock of the clocks that a crash of Kodi left lets go here, whatever the setting says; with no
+    // marker (the usual case) this reads one file that is not there
+    if (const auto said = AE::GPUHOLD::RecoverStale(GPU_HOLD_MARKER))
+      CLog::Log(LOGINFO, "GPU clock hold: {}", *said);
     Create();
     SetPriority(ThreadPriority::ABOVE_NORMAL);
   }
@@ -487,6 +500,7 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
           {
             m_sink->Deinitialize();
             m_sink.reset();
+            ReleaseGpuHold();
             m_state = S_TOP_CONFIGURED_SUSPEND;
             m_extTimeout = 0ms;
           }
@@ -581,6 +595,7 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
         case CSinkControlProtocol::TIMEOUT:
           m_sink->Deinitialize();
           m_sink.reset();
+          ReleaseGpuHold();
           m_state = S_TOP_CONFIGURED_SUSPEND;
           m_extTimeout = 10s;
           return;
@@ -628,6 +643,7 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
           {
             m_sink->Deinitialize();
             m_sink.reset();
+            ReleaseGpuHold();
             m_state = S_TOP_CONFIGURED_SUSPEND;
           }
           else
@@ -1200,7 +1216,9 @@ void CActiveAESink::OpenSink()
 
   CLog::LogF(LOGINFO, "initialize sink");
 
+  m_reopening = true;
   CloseSink();
+  m_reopening = false;
 
   // get the display name of the device
   GetDeviceFriendlyName(dev.name);
@@ -1244,6 +1262,7 @@ void CActiveAESink::OpenSink()
   {
     CLog::LogF(LOGERROR, "no sink was returned");
     m_extError = true;
+    ReleaseGpuHold();
     return;
   }
 
@@ -1297,6 +1316,9 @@ void CActiveAESink::OpenSink()
                m_sinkFormat.m_sampleRate, CAEUtil::DataFormatToStr(m_sinkFormat.m_dataFormat),
                m_deviceFriendlyName);
 
+  // Hades: the clocks of an NVIDIA card, for the HD audio that goes out through it
+  UpdateGpuHold(passthrough);
+
   // init sample of silence
   SampleConfig config;
   config.fmt = CAEUtil::GetAVSampleFormat(m_sinkFormat.m_dataFormat);
@@ -1330,6 +1352,51 @@ void CActiveAESink::CloseSink(const bool drain)
 
   m_sink->Deinitialize();
   m_sink.reset();
+  if (!m_reopening)
+    ReleaseGpuHold();
+}
+
+void CActiveAESink::ReleaseGpuHold()
+{
+  if (m_gpuHold)
+    m_gpuHold->Set(std::string(), false);
+}
+
+void CActiveAESink::UpdateGpuHold(bool passthrough)
+{
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const bool setting = settings && settings->GetBool(CSettings::SETTING_AUDIOOUTPUT_HADESGPUHOLD);
+  if (!setting && !m_gpuHold)
+    return; // off, and never on: nothing of this runs
+
+  AE::GPUHOLD::Request request;
+  request.setting = setting;
+  request.passthrough = passthrough && !m_extReserved;
+  const auto type = m_requestedFormat.m_streamInfo.m_type;
+  request.hdFormat = type == CAEStreamInfo::STREAM_TYPE_TRUEHD ||
+                     type == CAEStreamInfo::STREAM_TYPE_DTSHD ||
+                     type == CAEStreamInfo::STREAM_TYPE_DTSHD_MA ||
+                     type == CAEStreamInfo::STREAM_TYPE_EAC3;
+  std::optional<std::string> gpu;
+  if (request.setting && request.passthrough && request.hdFormat)
+  {
+    gpu = AE::GPUHOLD::NvidiaGpuOfAudio(std::string(), m_device);
+    if (!gpu)
+      CLog::Log(LOGINFO,
+                "GPU clock hold: the sound of {} is not on an NVIDIA graphics card that runs with the "
+                "NVIDIA driver: no clocks are kept",
+                m_device);
+  }
+  request.nvidiaGpu = gpu.has_value();
+
+  const bool wanted = AE::GPUHOLD::Wants(request);
+  if (wanted && !m_gpuHold)
+    m_gpuHold = std::make_unique<AE::GPUHOLD::CAsyncHold>(
+        [](const std::string& pci) -> std::unique_ptr<AE::GPUHOLD::IClocks>
+        { return std::make_unique<AE::GPUHOLD::CNvmlClocks>(pci, GPU_HOLD_MARKER); },
+        [](const std::string& said) { CLog::Log(LOGINFO, "GPU clock hold: {}", said); });
+  if (m_gpuHold)
+    m_gpuHold->Set(gpu.value_or(std::string()), wanted);
 }
 
