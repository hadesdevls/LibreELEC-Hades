new file mode 100644
index 0000000..5bf643f
--- /dev/null
+++ b/xbmc/cores/AudioEngine/Utils/GpuClockHold.h
@@ -0,0 +1,602 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: "Keep the graphics card at full speed while HD audio plays through"
+// (audiooutput.hadesgpuhold), for an NVIDIA graphics card whose HDMI audio carries the stream.
+//
+// The HD-audio function of an NVIDIA GPU reads the samples of a bitstream from memory through the
+// PCIe link of the card. On a laptop on its charger the card changes performance state while the
+// stream plays (the memory clock and the generation of the link move together with it), and the
+// DMA of the audio function misses samples then: the kernel says "stream N dma error: 0x28"
+// (FIFO error) and the receiver cuts the sound. On battery the card stays in one state and there
+// is no error (LibreELEC Hades issue 8). This holds the clocks of the card while a stream of
+// TrueHD, DTS-HD or E-AC-3 goes out through such a card, and lets them go when it stops.
+//
+// How: NVML, the library of the driver (nvidia-smi is made of it), as nvml.h documents it:
+// nvmlDeviceSetGpuLockedClocks() (Volta and newer) and nvmlDeviceSetMemoryLockedClocks() (Ampere
+// and newer), reversed by nvmlDeviceResetGpuLockedClocks() and nvmlDeviceResetMemoryLockedClocks().
+// The highest clock that the card lists as supported is asked for, as "nvidia-smi -lgc" and
+// "-lmc" do. A card that refuses ("not supported" on a GeForce of an older generation, or when the
+// driver does not take it) is left as it was, with a line in kodi.log that says so; nothing here
+// ever fails a playback: the work is done on a thread of its own that nobody waits for.
+//
+// A lock outlives the process that made it ("After system reboot or driver reload GPU clocks go
+// back to their default value", nvml.h), so a marker file in /run says that this made one, and the
+// next start of Kodi lets it go if a crash left it. With the setting off, nothing of this runs
+// but that check of the marker.
+//
+// Nothing of Kodi is included: the policy and the sysfs lookups are tested on the host
+// (TestGpuClockHold.cpp).
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <limits.h>
+#include <unistd.h>
+
+namespace AE
+{
+namespace GPUHOLD
+{
+
+//! What is asked of the policy
+struct Request
+{
+  bool setting{false}; //!< audiooutput.hadesgpuhold
+  bool passthrough{false}; //!< the sink was opened for a bitstream
+  bool hdFormat{false}; //!< TrueHD, DTS-HD (high resolution or master audio) or E-AC-3
+  bool nvidiaGpu{false}; //!< the card that carries the audio is an NVIDIA GPU that the driver runs
+};
+
+//! Whether the clocks are to be held: all four, and nothing else, ask for it
+constexpr bool Wants(const Request& request)
+{
+  return request.setting && request.passthrough && request.hdFormat && request.nvidiaGpu;
+}
+
+//! What a lock or an unlock did
+struct Outcome
+{
+  bool done{false}; //!< the clocks are held (Lock) or were let go (Unlock)
+  std::string said; //!< for kodi.log: what was done, or what refused
+};
+
+//! The clocks of a card: NVML (CNvmlClocks) or, in the test, a double
+class IClocks
+{
+public:
+  virtual ~IClocks() = default;
+  virtual Outcome Lock() = 0;
+  virtual Outcome Unlock() = 0;
+};
+
+using Say = std::function<void(const std::string&)>;
+
+/*!
+ * \brief The state of the hold: engages once, lets go once, and says each. Not thread safe: one
+ * thread drives it (CAsyncHold).
+ */
+class CHold
+{
+public:
+  CHold(IClocks& clocks, Say say) : m_clocks(clocks), m_say(std::move(say)) {}
+
+  //! \brief Where the hold should be: held (true) or not (false)
+  void Set(bool wanted)
+  {
+    if (wanted == m_held)
+      return;
+    if (wanted)
+    {
+      if (m_refused)
+        return;
+      const Outcome outcome = m_clocks.Lock();
+      m_say(outcome.said);
+      if (outcome.done)
+        m_held = true;
+      else
+        m_refused = true; // asked again with every stream, the card would say the same each time
+    }
+    else
+    {
+      const Outcome outcome = m_clocks.Unlock();
+      m_say(outcome.said);
+      m_held = false;
+    }
+  }
+
+  bool Held() const { return m_held; }
+  bool Refused() const { return m_refused; }
+
+private:
+  IClocks& m_clocks;
+  Say m_say;
+  bool m_held{false};
+  bool m_refused{false};
+};
+
+// ---------------------------------------------------------------------------------------------
+// What the sysfs says
+// ---------------------------------------------------------------------------------------------
+
+namespace DETAIL
+{
+inline std::optional<std::string> ReadLine(const std::string& path)
+{
+  std::ifstream in(path);
+  std::string line;
+  if (!in || !std::getline(in, line))
+    return std::nullopt;
+  return line;
+}
+
+inline std::string Base(const std::string& path)
+{
+  const auto slash = path.find_last_of('/');
+  return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+inline std::string RealPath(const std::string& path)
+{
+  char real[PATH_MAX];
+  return realpath(path.c_str(), real) ? std::string(real) : std::string();
+}
+
+inline std::string LinkBase(const std::string& path)
+{
+  char target[PATH_MAX];
+  const ssize_t length = readlink(path.c_str(), target, sizeof(target) - 1);
+  if (length <= 0)
+    return {};
+  return Base(std::string(target, static_cast<size_t>(length)));
+}
+
+//! Whether the PCI function at \a dir is made by NVIDIA (0x10de) and is of the class that starts with \a classPrefix
+inline bool IsNvidiaFunction(const std::string& dir, const char* classPrefix)
+{
+  const auto vendor = ReadLine(dir + "/vendor");
+  const auto cls = ReadLine(dir + "/class");
+  return vendor && cls && *vendor == "0x10de" && cls->rfind(classPrefix, 0) == 0;
+}
+} // namespace DETAIL
+
+/*!
+ * \brief The graphics function that shares its card with an HD-audio function
+ *
+ * \param root "" for the system; a folder in the test
+ * \param device the name of the ALSA device as Kodi has it ("ALSA:hdmi:CARD=NVidia,DEV=0,AES0=...")
+ * \return its PCI address ("0000:01:00.0") when the audio function is NVIDIA's (class 0x0403,
+ * function 1 of a card whose function 0 is a display controller that the driver "nvidia" runs)
+ */
+inline std::optional<std::string> NvidiaGpuOfAudio(const std::string& root, const std::string& device)
+{
+  const auto at = device.find("CARD=");
+  if (at == std::string::npos)
+    return std::nullopt;
+  std::string card = device.substr(at + 5);
+  card = card.substr(0, card.find_first_of(",:"));
+  if (card.empty() || card.find('/') != std::string::npos)
+    return std::nullopt;
+
+  // /proc/asound/<id> is a link to cardN; /sys/class/sound/cardN/device is the PCI function
+  const std::string number = DETAIL::LinkBase(root + "/proc/asound/" + card);
+  if (number.rfind("card", 0) != 0)
+    return std::nullopt;
+  const std::string audio = DETAIL::RealPath(root + "/sys/class/sound/" + number + "/device");
+  if (audio.empty() || !DETAIL::IsNvidiaFunction(audio, "0x0403"))
+    return std::nullopt;
+
+  // the display function of the same card: the same slot, function 0
+  const std::string address = DETAIL::Base(audio);
+  const auto dot = address.find_last_of('.');
+  if (dot == std::string::npos || address.substr(dot) != ".1")
+    return std::nullopt;
+  const std::string gpu = address.substr(0, dot) + ".0";
+  const std::string gpuDir = audio.substr(0, audio.size() - address.size()) + gpu;
+  if (!DETAIL::IsNvidiaFunction(gpuDir, "0x03") || DETAIL::LinkBase(gpuDir + "/driver") != "nvidia")
+    return std::nullopt;
+  return gpu;
+}
+
+//! Whether the system has an NVIDIA display controller that the driver "nvidia" runs (for the setting to be shown)
+inline bool NvidiaGpuPresent(const std::string& root)
+{
+  const std::string base = root + "/sys/bus/pci/devices";
+  DIR* dir = opendir(base.c_str());
+  if (!dir)
+    return false;
+  bool found = false;
+  while (const dirent* entry = readdir(dir))
+  {
+    if (entry->d_name[0] == '.')
+      continue;
+    const std::string path = base + "/" + entry->d_name;
+    if (DETAIL::IsNvidiaFunction(path, "0x03") && DETAIL::LinkBase(path + "/driver") == "nvidia")
+    {
+      found = true;
+      break;
+    }
+  }
+  closedir(dir);
+  return found;
+}
+
+// ---------------------------------------------------------------------------------------------
+// NVML
+// ---------------------------------------------------------------------------------------------
+
+//! NVML as nvml.h of the driver declares the parts used here (nvmlReturn_t is an int)
+namespace NVML
+{
+constexpr int SUCCESS = 0; //!< NVML_SUCCESS
+constexpr int ERROR_NOT_SUPPORTED = 3; //!< NVML_ERROR_NOT_SUPPORTED
+constexpr int ERROR_NO_PERMISSION = 4; //!< NVML_ERROR_NO_PERMISSION
+constexpr int ERROR_INSUFFICIENT_SIZE = 7; //!< NVML_ERROR_INSUFFICIENT_SIZE
+using Device = void*;
+using Init = int (*)();
+using Shutdown = int (*)();
+using HandleByPciBusId = int (*)(const char*, Device*);
+using SupportedMemoryClocks = int (*)(Device, unsigned int*, unsigned int*);
+using SupportedGraphicsClocks = int (*)(Device, unsigned int, unsigned int*, unsigned int*);
+using SetLocked = int (*)(Device, unsigned int, unsigned int);
+using ResetLocked = int (*)(Device);
+
+inline std::string Reason(int status)
+{
+  switch (status)
+  {
+    case ERROR_NOT_SUPPORTED:
+      return "not supported by this card";
+    case ERROR_NO_PERMISSION:
+      return "no permission";
+    default:
+      return "NVML status " + std::to_string(status);
+  }
+}
+} // namespace NVML
+
+/*!
+ * \brief The clocks of one NVIDIA card through NVML. Every call that talks to the driver is here,
+ * and only from Lock() and Unlock().
+ */
+class CNvmlClocks : public IClocks
+{
+public:
+  //! \param pci the PCI address of the display function ("0000:01:00.0")
+  //! \param marker the file in /run that says a lock was made ("" for none)
+  CNvmlClocks(std::string pci, std::string marker, std::string library = "libnvidia-ml.so.1")
+    : m_pci(std::move(pci)), m_marker(std::move(marker)), m_library(std::move(library))
+  {
+  }
+
+  Outcome Lock() override
+  {
+    std::string why;
+    if (!Open(why))
+      return {false, "the graphics card " + m_pci + " was not kept at full speed: " + why};
+
+    std::string graphics = "not asked";
+    std::string memory = "not asked";
+    unsigned int memoryClock = 0;
+    bool any = false;
+
+    // the memory clock first: the graphics clocks that a card lists depend on it
+    const std::vector<unsigned int> memories = List(
+        [this](unsigned int* count, unsigned int* clocks)
+        { return m_supportedMemory ? m_supportedMemory(m_device, count, clocks) : ERROR_MISSING; });
+    if (m_setMemory && !memories.empty())
+    {
+      memoryClock = *std::max_element(memories.begin(), memories.end());
+      const int status = m_setMemory(m_device, memoryClock, memoryClock);
+      if (status == NVML::SUCCESS)
+      {
+        memory = "locked at " + std::to_string(memoryClock) + " MHz";
+        m_memoryLocked = true;
+        any = true;
+      }
+      else
+        memory = "refused (" + NVML::Reason(status) + ")";
+    }
+    else
+      memory = "no list of memory clocks";
+
+    const std::vector<unsigned int> graphicsClocks = memoryClock == 0
+        ? std::vector<unsigned int>()
+        : List(
+              [this, memoryClock](unsigned int* count, unsigned int* clocks)
+              {
+                return m_supportedGraphics ? m_supportedGraphics(m_device, memoryClock, count, clocks)
+                                           : ERROR_MISSING;
+              });
+    if (m_setGraphics && !graphicsClocks.empty())
+    {
+      const unsigned int clock = *std::max_element(graphicsClocks.begin(), graphicsClocks.end());
+      const int status = m_setGraphics(m_device, clock, clock);
+      if (status == NVML::SUCCESS)
+      {
+        graphics = "locked at " + std::to_string(clock) + " MHz";
+        m_graphicsLocked = true;
+        any = true;
+      }
+      else
+        graphics = "refused (" + NVML::Reason(status) + ")";
+    }
+    else
+      graphics = "no list of graphics clocks";
+
+    if (!any)
+    {
+      Close();
+      return {false, "the graphics card " + m_pci + " was not kept at full speed, and stays as it was: graphics clocks " +
+                         graphics + ", memory clock " + memory};
+    }
+    if (!m_marker.empty())
+      std::ofstream(m_marker) << m_pci << '\n';
+    return {true, "the graphics card " + m_pci + " is kept at full speed while HD audio plays through: graphics clocks " +
+                      graphics + ", memory clock " + memory};
+  }
+
+  Outcome Unlock() override
+  {
+    std::string graphics = "not locked";
+    std::string memory = "not locked";
+    if (!m_device)
+    {
+      std::string why;
+      if (!Open(why)) // a lock that a crash left (RecoverStale)
+        return {false, "the clocks of the graphics card " + m_pci + " could not be let go: " + why};
+      m_graphicsLocked = m_memoryLocked = true;
+    }
+    if (m_graphicsLocked && m_resetGraphics)
+      graphics = Reset(m_resetGraphics(m_device));
+    if (m_memoryLocked && m_resetMemory)
+      memory = Reset(m_resetMemory(m_device));
+    m_graphicsLocked = m_memoryLocked = false;
+    if (!m_marker.empty())
+      std::remove(m_marker.c_str());
+    Close();
+    return {true, "the graphics card " + m_pci + " is let go: graphics clocks " + graphics +
+                      ", memory clock " + memory};
+  }
+
+private:
+  static constexpr int ERROR_MISSING = -1;
+
+  static std::string Reset(int status)
+  {
+    return status == NVML::SUCCESS ? "back to the driver's" : "not reset (" + NVML::Reason(status) + ")";
+  }
+
+  //! The clocks that a call lists: asked for their number first, then for them
+  std::vector<unsigned int> List(const std::function<int(unsigned int*, unsigned int*)>& call) const
+  {
+    unsigned int count = 0;
+    const int first = call(&count, nullptr);
+    if ((first != NVML::SUCCESS && first != NVML::ERROR_INSUFFICIENT_SIZE) || count == 0 ||
+        count > 4096)
+      return {};
+    std::vector<unsigned int> clocks(count);
+    if (call(&count, clocks.data()) != NVML::SUCCESS)
+      return {};
+    clocks.resize(std::min<size_t>(count, clocks.size()));
+    return clocks;
+  }
+
+  bool Open(std::string& why)
+  {
+    if (m_device)
+      return true;
+    m_handle = dlopen(m_library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!m_handle)
+    {
+      why = "NVML could not be loaded";
+      return false;
+    }
+    const auto symbol = [this](const char* name) { return dlsym(m_handle, name); };
+    auto init = reinterpret_cast<NVML::Init>(symbol("nvmlInit_v2"));
+    m_shutdown = reinterpret_cast<NVML::Shutdown>(symbol("nvmlShutdown"));
+    auto byBus = reinterpret_cast<NVML::HandleByPciBusId>(symbol("nvmlDeviceGetHandleByPciBusId_v2"));
+    m_supportedMemory =
+        reinterpret_cast<NVML::SupportedMemoryClocks>(symbol("nvmlDeviceGetSupportedMemoryClocks"));
+    m_supportedGraphics = reinterpret_cast<NVML::SupportedGraphicsClocks>(
+        symbol("nvmlDeviceGetSupportedGraphicsClocks"));
+    m_setGraphics = reinterpret_cast<NVML::SetLocked>(symbol("nvmlDeviceSetGpuLockedClocks"));
+    m_setMemory = reinterpret_cast<NVML::SetLocked>(symbol("nvmlDeviceSetMemoryLockedClocks"));
+    m_resetGraphics = reinterpret_cast<NVML::ResetLocked>(symbol("nvmlDeviceResetGpuLockedClocks"));
+    m_resetMemory = reinterpret_cast<NVML::ResetLocked>(symbol("nvmlDeviceResetMemoryLockedClocks"));
+    if (!init || !m_shutdown || !byBus || !m_setGraphics || !m_setMemory || !m_resetGraphics ||
+        !m_resetMemory)
+    {
+      why = "NVML has not the calls that are needed";
+      m_shutdown = nullptr;
+      return false;
+    }
+    if (const int status = init(); status != NVML::SUCCESS)
+    {
+      why = "NVML could not be initialised (" + std::to_string(status) + ")";
+      m_shutdown = nullptr;
+      return false;
+    }
+    if (const int status = byBus(m_pci.c_str(), &m_device); status != NVML::SUCCESS)
+    {
+      why = "NVML does not know the card (" + std::to_string(status) + ")";
+      m_device = nullptr;
+      Close();
+      return false;
+    }
+    return true;
+  }
+
+  void Close()
+  {
+    if (m_shutdown)
+      m_shutdown();
+    m_shutdown = nullptr;
+    m_device = nullptr; // the library stays loaded: unloading the driver's library is not something NVML documents
+  }
+
+  std::string m_pci;
+  std::string m_marker;
+  std::string m_library;
+  void* m_handle{nullptr};
+  NVML::Shutdown m_shutdown{nullptr};
+  NVML::Device m_device{nullptr};
+  NVML::SupportedMemoryClocks m_supportedMemory{nullptr};
+  NVML::SupportedGraphicsClocks m_supportedGraphics{nullptr};
+  NVML::SetLocked m_setGraphics{nullptr};
+  NVML::SetLocked m_setMemory{nullptr};
+  NVML::ResetLocked m_resetGraphics{nullptr};
+  NVML::ResetLocked m_resetMemory{nullptr};
+  bool m_graphicsLocked{false};
+  bool m_memoryLocked{false};
+};
+
+/*!
+ * \brief A lock that a crash of Kodi left (the marker file is there): let it go. Called once at the
+ * start, whatever the setting says. Nothing is done when there is no marker.
+ * \return what was said, or nothing
+ */
+inline std::optional<std::string> RecoverStale(const std::string& marker, IClocks* clocks = nullptr)
+{
+  const auto pci = DETAIL::ReadLine(marker);
+  if (!pci)
+    return std::nullopt;
+  std::unique_ptr<IClocks> own;
+  if (!clocks)
+  {
+    own = std::make_unique<CNvmlClocks>(*pci, marker);
+    clocks = own.get();
+  }
+  const Outcome outcome = clocks->Unlock();
+  if (!outcome.done)
+    std::remove(marker.c_str()); // nothing more can be done about it; it is not asked again
+  return "a lock of the clocks that an earlier run of Kodi left: " + outcome.said;
+}
+
+/*!
+ * \brief The hold, driven from a thread of its own: Set() returns at once, and what NVML does (it
+ * can take a while, or not come back) never makes the audio engine wait
+ */
+class CAsyncHold
+{
+public:
+  //! \param make makes the clocks of the card of that PCI address, on the thread of the hold
+  CAsyncHold(std::function<std::unique_ptr<IClocks>(const std::string&)> make, Say say)
+    : m_state(std::make_shared<State>())
+  {
+    m_state->make = std::move(make);
+    m_state->say = std::move(say);
+  }
+
+  ~CAsyncHold()
+  {
+    {
+      std::lock_guard<std::mutex> lock(m_state->mutex);
+      if (!m_state->running)
+        return; // nothing was ever asked
+    }
+    Request(std::string(), false, true);
+    // a moment for the unlock; a driver that does not answer is left alone, as the thread owns what it needs
+    std::unique_lock<std::mutex> lock(m_state->mutex);
+    m_state->cv.wait_for(lock, std::chrono::seconds(2), [this] { return m_state->finished; });
+  }
+
+  CAsyncHold(const CAsyncHold&) = delete;
+  CAsyncHold& operator=(const CAsyncHold&) = delete;
+
+  //! \brief Hold the clocks of the card \a pci (wanted) or let them go. \a pci is ignored when not wanted.
+  void Set(const std::string& pci, bool wanted) { Request(pci, wanted, false); }
+
+private:
+  struct State
+  {
+    std::function<std::unique_ptr<IClocks>(const std::string&)> make;
+    Say say;
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::string pci; //!< the card that is wanted held
+    bool wanted{false};
+    bool stop{false};
+    bool finished{false};
+    bool running{false};
+  };
+
+  void Request(const std::string& pci, bool wanted, bool stop)
+  {
+    {
+      std::lock_guard<std::mutex> lock(m_state->mutex);
+      if (wanted)
+        m_state->pci = pci;
+      m_state->wanted = wanted && !stop;
+      m_state->stop = stop;
+      if (!m_state->running)
+      {
+        m_state->running = true;
+        std::thread([state = m_state] { Work(state); }).detach();
+      }
+    }
+    m_state->cv.notify_all();
+  }
+
+  static void Work(const std::shared_ptr<State>& state)
+  {
+    std::unique_ptr<IClocks> clocks;
+    std::unique_ptr<CHold> hold;
+    std::string pci; // the card that the hold above is of
+    bool applied = false; // what the hold was last told
+    std::unique_lock<std::mutex> lock(state->mutex);
+    for (;;)
+    {
+      state->cv.wait(lock, [&] { return state->stop || state->wanted != applied; });
+      const bool stop = state->stop;
+      const bool wanted = state->wanted && !stop;
+      const std::string want = state->pci;
+      lock.unlock();
+      if (wanted && (!hold || pci != want))
+      {
+        if (hold)
+          hold->Set(false); // another card than before
+        clocks = state->make(want);
+        pci = want;
+        hold = clocks ? std::make_unique<CHold>(*clocks, state->say) : nullptr;
+      }
+      if (hold)
+        hold->Set(wanted);
+      applied = wanted;
+      lock.lock();
+      if (stop)
+      {
+        state->finished = true;
+        state->running = false;
+        state->cv.notify_all();
+        return;
+      }
+    }
+  }
+
+  std::shared_ptr<State> m_state;
+};
+
+} // namespace GPUHOLD
+} // namespace AE
