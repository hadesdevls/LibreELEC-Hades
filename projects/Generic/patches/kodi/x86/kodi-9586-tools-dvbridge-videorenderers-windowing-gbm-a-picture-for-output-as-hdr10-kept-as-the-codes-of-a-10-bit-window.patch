+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -1616,6 +1616,27 @@ void CDVBridgeGLES::LogConversion() const
               m_convertedFel, m_convertFailed);
 }
 
+void CDVBridgeGLES::SetConversionTarget(unsigned int framebuffer, bool limited)
+{
+  if (!m_renderer)
+    return;
+  const int levels = dvbridge_gl_copy_levels(framebuffer);
+  const int codes = dvbridge_render_hdr10_store(m_renderer, levels, limited) ? 1 : 0;
+  if (codes == m_convertCodes)
+    return;
+  CLog::Log(LOGINFO,
+            "DVBridge: pictures for output as HDR10 are kept {} (the window: {}, {} range)",
+            codes ? "as the codes of 10 bits it is written with, in a texture of 10 bits"
+                  : "as floating-point values",
+            levels > 0 ? std::to_string(levels + 1) + " levels"
+            : levels == 0 ? std::string("floating point")
+                          : std::string("not one a picture is copied to"),
+            limited ? "limited" : "full");
+  m_convertCodes = codes;
+  // a picture that is asked for again is drawn again, in this form
+  m_convertSerial = 0;
+}
