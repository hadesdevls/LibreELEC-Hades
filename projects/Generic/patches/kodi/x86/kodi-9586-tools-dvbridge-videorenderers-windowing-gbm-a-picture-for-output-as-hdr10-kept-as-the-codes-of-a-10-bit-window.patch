+/* Hades: the levels of the framebuffer bound for drawing, as a copy quantizes to them
+ * (dvbridge_gl_copy_levels()), or -1 */
+static int bound_levels(unsigned framebuffer)
+{
+    const GLenum attachment = framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK;
+    GLint red = 0, green = 0, blue = 0, samples = 0, type = 0, encoding = 0;
+    glGetIntegerv(GL_RED_BITS, &red);
+    glGetIntegerv(GL_GREEN_BITS, &green);
+    glGetIntegerv(GL_BLUE_BITS, &blue);
+    glGetIntegerv(GL_SAMPLES, &samples);
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, attachment,
+        GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &type);
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, attachment,
+        GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+    const bool floating = type == GL_FLOAT;
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE || glGetError() ||
+        (!floating && type != GL_UNSIGNED_NORMALIZED) || red != green || red != blue ||
+        red < 8 || red > 16 || samples > 1 || encoding != GL_LINEAR)
+        return -1;
+    return floating || red > 12 ? 0 : (int)((1u << red) - 1);
+}
+
+int dvbridge_gl_copy_levels(unsigned framebuffer)
+{
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    GLint bound = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &bound);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    const int levels = bound_levels(framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)bound);
+    return levels;
+}
