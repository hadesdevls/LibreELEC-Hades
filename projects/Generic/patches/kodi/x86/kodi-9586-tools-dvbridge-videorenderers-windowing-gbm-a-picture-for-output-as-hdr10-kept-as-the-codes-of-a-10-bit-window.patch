-/* Hades: a texture of the picture for output as HDR10, of that size (made again when it is of another) */
+/* Hades: the format of a picture kept as 10-bit codes (dvbridge_render_hdr10_store()), or NULL */
+static pl_fmt hdr10_codes_format(pl_gpu gpu)
+{
+    pl_fmt fmt = pl_find_named_fmt(gpu, "rgb10a2");
+    const enum pl_fmt_caps caps = PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE;
+    return fmt && fmt->type == PL_FMT_UNORM && fmt->num_components == 4 &&
+                   fmt->component_depth[0] == 10 && fmt->component_depth[1] == 10 &&
+                   fmt->component_depth[2] == 10 && (fmt->caps & caps) == caps
+               ? fmt
+               : NULL;
+}
+
+bool dvbridge_render_hdr10_store(struct dvbridge_renderer *r, int levels, bool limited)
+{
+    if (!r)
+        return false;
+    const bool codes = levels == 1023 && !limited && hdr10_codes_format(r->gpu);
+    /* a picture kept in the other form is not copied to this target */
+    if (codes != r->hdr10_codes)
+        r->hdr10_whole = false;
+    r->hdr10_codes = codes;
+    return codes;
+}
