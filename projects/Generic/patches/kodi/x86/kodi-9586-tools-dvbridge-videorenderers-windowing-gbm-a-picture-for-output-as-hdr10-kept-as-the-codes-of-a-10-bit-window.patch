-    const bool floating = type == GL_FLOAT;
-    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE || glGetError() ||
-        (!floating && type != GL_UNSIGNED_NORMALIZED) || red != green || red != blue ||
-        red < 8 || red > 16 || samples > 1 || encoding != GL_LINEAR)
+    const int held = bound_levels(framebuffer);
+    if (held < 0)
