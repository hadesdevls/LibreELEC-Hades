From a88a1e2c37bd7a1c627caa9e26950c01d237669e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:44:16 +0000
Subject: [PATCH] GBM: HDR10 adapted to the display, automatic only where the
 curve has something to compress (O-A1)

Automatic decides by the video's peak, its MaxCLL first. The curve maps
from the peak of the mastering display first (libplacebo,
pl_color_space_nominal_luma_ex(); CDVBridgeGLES::ConversionOutputAdapted()
tells the display the same). With a mastering display of 1000 cd/m2, a
MaxCLL of 4000 (such metadata exist) and a display of 1500, the video was
adapted ("4000 > 1500" in the player information) while the curve had
nothing to compress: the bridge drew every picture, at its GPU time, to
send the same picture with the same metadata. Found by the second
independent review of 1.0 RC6 (O-A1).

Automatic now also asks that the peak the curve maps from (the mastering
display's, else MaxCLL) be above the display's (libplacebo clamps it at
10000 cd/m2, which changes no verdict: the video's peak is at most 10000
and above the display's); where it is not, the verdict is NOTHING_TO_MAP: the
video goes out as it is, kodi.log says why, and the player information
says no. Always is not changed.
---
 xbmc/windowing/gbm/HDR10Adapt.h | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/xbmc/windowing/gbm/HDR10Adapt.h b/xbmc/windowing/gbm/HDR10Adapt.h
index 5b760e5..27cb097 100644
--- a/xbmc/windowing/gbm/HDR10Adapt.h
+++ b/xbmc/windowing/gbm/HDR10Adapt.h
@@ -61,6 +61,9 @@ enum class Verdict
   NO_SOURCE_PEAK, //!< the stream gives neither MaxCLL nor the peak of its mastering display
   NO_DISPLAY_PEAK, //!< the display gives no peak (its EDID), and none is set for the mapping
   NOT_BRIGHTER, //!< automatic: the peak of the source is not above that of the display
+  //! automatic: the video's peak is above that of the display, but the one the curve maps from (its
+  //! mastering display, MaxCLL where that is missing) is not: nothing would be compressed
+  NOTHING_TO_MAP,
 };
 
 //! What a picture says of itself
@@ -125,6 +128,13 @@ constexpr Decision Decide(Mode mode, const Picture& picture, const Display& disp
     d.verdict = Verdict::NO_DISPLAY_PEAK;
   else if (mode == Mode::AUTOMATIC && !(d.sourcePeak > display.peak))
     d.verdict = Verdict::NOT_BRIGHTER;
+  // (the peak the curve maps from, as libplacebo takes it and as CDVBridgeGLES::
+  // ConversionOutputAdapted() tells it: the mastering display's, else MaxCLL; at or under the
+  // display's, the picture and what the display is told would be those of the video, for the GPU
+  // time of drawing it: the second independent review of 1.0 RC6, O-A1. libplacebo clamps it at
+  // 10000, which changes no verdict here: the video's peak is at most 10000 and above the display's.)
+  else if (mode == Mode::AUTOMATIC && !((picture.mdl > 0 ? picture.mdl : picture.maxCll) > display.peak))
+    d.verdict = Verdict::NOTHING_TO_MAP;
   else
     d.verdict = Verdict::ADAPTED;
   return d;
@@ -287,6 +297,9 @@ constexpr const char* Why(Verdict verdict)
       return "the display gives no peak in its EDID, and none is set for the mapping to the display";
     case Verdict::NOT_BRIGHTER:
       return "its peak is not above that of the display";
+    case Verdict::NOTHING_TO_MAP:
+      return "its peak is above that of the display, but the curve maps from the peak of its "
+             "mastering display, which is not: nothing would be compressed";
   }
   return "";
 }
@@ -303,6 +316,7 @@ constexpr const char* Code(Verdict verdict, Mode mode)
       return "notbrighter";
     case Verdict::NO_SOURCE_PEAK:
     case Verdict::NO_DISPLAY_PEAK:
+    case Verdict::NOTHING_TO_MAP:
       return "no";
     default:
       return "";
