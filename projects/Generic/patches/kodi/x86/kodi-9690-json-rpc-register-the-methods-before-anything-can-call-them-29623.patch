From 0ed7f428ceecf1a894d72f1f7b64f2c42d6cd511 Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Thu, 8 Oct 2026 20:41:54 +0100
Subject: [PATCH] [JSON-RPC] Register the methods before anything can call them
 (#29623)

CJSONRPC::Initialize() is what populates the method table, and until it
runs CJSONServiceDescription's map is empty, so CheckCall answers every
request with -32601 "Method not found". Nothing on the MethodCall path
consults m_initialized, so a caller cannot tell an interface that is not
ready yet from a method that does not exist, and an add-on that treats
-32601 as fatal terminates rather than retrying.

It was called late in CApplication::Initialize(), after the skin had been
loaded and the first window activated. Activating that window runs its
<onload>, and RunScript dispatches the script on its own thread, so a
skin that starts an add-on at boot raced the application thread for the
table. CProfileManager::FinalizeLoadProfile carried the same inversion,
bringing the web and TCP servers up ahead of its own Initialize() call.

Initialize() reads nothing but static tables: the add-on type, action and
window translators, the smart playlist and texture field lists, and the
generated schema arrays. It needs no GUI, skin, profile, database or
add-on manager, so it now runs as the first statement of
CApplication::Initialize(). The call in FinalizeLoadProfile() could only
ever return early on the guard, and every enum it registers is
profile-independent, so it goes, with the include it was the last user
of. Cleanup() stays in ~CNetworkServices, after the servers stop.

Fixes #18156

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/application/Application.cpp | 7 +++----
 xbmc/profiles/ProfileManager.cpp | 3 ---
 2 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 99874bd..74102fd 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -562,6 +562,9 @@ bool CApplication::InitWindow(RESOLUTION res)
 
 bool CApplication::Initialize()
 {
+  // Must precede anything that can dispatch a JSON-RPC call
+  CJSONRPC::Initialize();
+
   m_pActiveAE->Start();
   // restore AE's previous volume state
 
@@ -762,10 +765,6 @@ bool CApplication::Initialize()
     CServiceBroker::GetGUI()->GetWindowManager().ActivateWindow(WINDOW_SPLASH);
   }
 
-  // Must stay above the window activation below: that can raise a modal dialog, whose nested
-  // render loop reaches anything after it only once the dialog has been dismissed.
-  CJSONRPC::Initialize();
-
   CServiceBroker::RegisterSpeechRecognition(speech::ISpeechRecognition::CreateInstance());
 
   if (!m_ServiceManager->InitStageThree(profileManager))
diff --git a/xbmc/profiles/ProfileManager.cpp b/xbmc/profiles/ProfileManager.cpp
index e0c8ced..cd2424e 100644
--- a/xbmc/profiles/ProfileManager.cpp
+++ b/xbmc/profiles/ProfileManager.cpp
@@ -35,7 +35,6 @@
 #include "guilib/GUIWindowManager.h"
 #include "guilib/StereoscopicsManager.h" //! @todo Remove me
 #include "input/InputManager.h"
-#include "interfaces/json-rpc/JSONRPC.h" //! @todo Remove me
 #include "music/MusicLibraryQueue.h"
 #include "network/Network.h" //! @todo Remove me
 #include "network/NetworkServices.h" //! @todo Remove me
@@ -421,8 +420,6 @@ void CProfileManager::FinalizeLoadProfile()
 
   weatherManager.Refresh();
 
-  JSONRPC::CJSONRPC::Initialize();
-
   // Restart context menu manager
   contextMenuManager.Init();
 
