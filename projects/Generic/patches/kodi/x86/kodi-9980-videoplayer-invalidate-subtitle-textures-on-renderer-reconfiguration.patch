From 7661355c189712c62e180252fe472e0f0354a621 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Thu, 5 Nov 2026 12:53:42 -0800
Subject: [PATCH] [VideoPlayer] Invalidate subtitle textures on renderer
 reconfiguration

Clear rendered subtitle textures when the video renderer is reconfigured
so persistent PGS overlays use the current output transfer.

[Hades: Reset() also clears the two judgements of bitmap subtitles that
Hades keeps per stream (m_bitmapTallestContent, m_bitmapSubtitleStream);
the cache is released before them, as here. Hades had no release of its
own on a reconfiguration: a subtitle that stays on screen is made again
in the new output's transfer, and the dirty mark added here makes the
GUI pass that Hades leaves out when nothing changed draw it.]
(cherry picked from commit 2f5ac8d1c9b3026414040ac6789a5110f5dbc6a7)
---
 xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp | 2 +-
 xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp   | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
index 6b369ad..c59d211 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -193,12 +193,12 @@ void CRenderer::Flush()
     Release(buffer);
   m_noPictureGroup.reset();
 
-  ReleaseCache();
   Reset();
 }
 
 void CRenderer::Reset()
 {
+  ReleaseCache();
   m_bitmapTallestContent = 0.0f;
   m_bitmapSubtitleStream = 0;
   m_subtitlePosition = 0;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
index 2fc5eea..4c06f4f 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.cpp
@@ -285,6 +285,7 @@ bool CRenderManager::Configure()
       dvWindow->VideoLatencyCommit(true);
 #endif
     m_overlays.Reset();
+    OVERLAY::MarkDirty();
     m_overlays.SetStereoMode(m_picture.stereoMode);
 
     m_renderState = STATE_CONFIGURED;
-- 
