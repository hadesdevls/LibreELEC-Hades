From 0b5dbdb2c103dd44c5a6300f5a24d80c3c026cfc Mon Sep 17 00:00:00 2001
From: Andrey Filipenkov <decapitator@ukr.net>
Date: Sun, 4 Oct 2026 08:36:17 +0300
Subject: [PATCH] [macOS/tvOS] build in Release config

(cherry picked from commit 46d4cf2171a7ef85ba22d8b501ba2025d7154550)
---
 tools/buildsteps/defaultenv | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tools/buildsteps/defaultenv b/tools/buildsteps/defaultenv
index 39b9fe6..b112fad 100644
--- a/tools/buildsteps/defaultenv
+++ b/tools/buildsteps/defaultenv
@@ -41,21 +41,21 @@ case $XBMC_PLATFORM_DIR in
   tvos)
     DEFAULT_SDK_VERSION=26.2
     DEFAULT_XBMC_DEPENDS_ROOT=$WORKSPACE/tools/depends/xbmc-depends
-    DEFAULT_CONFIGURATION="Debug"
+    DEFAULT_CONFIGURATION="Release"
     DEFAULT_XCODE_APP="Xcode-26.3.0.app"
     ;;
 
   osx64)
     DEFAULT_SDK_VERSION=14.2
     DEFAULT_XBMC_DEPENDS_ROOT=$WORKSPACE/tools/depends/xbmc-depends
-    DEFAULT_CONFIGURATION="Debug"
+    DEFAULT_CONFIGURATION="Release"
     DEFAULT_XCODE_APP="Xcode_15.2.app"
     ;;
 
   osx-arm64)
     DEFAULT_SDK_VERSION=14.2
     DEFAULT_XBMC_DEPENDS_ROOT=$WORKSPACE/tools/depends/xbmc-depends
-    DEFAULT_CONFIGURATION="Debug"
+    DEFAULT_CONFIGURATION="Release"
     DEFAULT_XCODE_APP="Xcode_15.2.app"
     ;;
 
