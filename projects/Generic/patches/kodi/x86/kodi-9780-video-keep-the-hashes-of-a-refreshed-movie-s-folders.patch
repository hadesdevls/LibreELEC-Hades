From ccccb7f14b368fa0635ad68b4e48bf96ad1cff77 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 20:14:48 +0000
Subject: [PATCH] [Video] Keep the hashes of a refreshed movie's folders.

A refresh removes a movie before adding it again for the same files,
and removing it cleared the hashes of its folder and of the folder
above it. The next scan then looked again at every folder of a source
that had been refreshed, finding nothing new in them.

The hashes are now kept, and are cleared only when the movie can't be
added again, so that the next scan finds it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoDatabase.cpp                  | 16 ++++++++------
 xbmc/video/VideoDatabase.h                    |  8 +++++--
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 18 ++++++++++++++--
 xbmc/video/test/TestVideoDatabase.cpp         | 21 +++++++++++++++++++
 4 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 146c4fc..81517e4 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -13670,7 +13670,8 @@ bool CVideoDatabase::IsDefaultVideoVersion(int idFile)
   return false;
 }
 
-bool CVideoDatabase::DeleteVideoAsset(int idFile)
+bool CVideoDatabase::DeleteVideoAsset(int idFile,
+                                      DeleteMovieHashAction hashAction /* = HASH_DELETE */)
 {
   if (!m_pDB || !m_pDS)
     return false;
@@ -13685,11 +13686,14 @@ bool CVideoDatabase::DeleteVideoAsset(int idFile)
     if (!inTransaction)
       BeginTransaction();
 
-    const std::string path = GetSingleValue(PrepareSQL(
-        "SELECT strPath FROM path JOIN files ON files.idPath=path.idPath WHERE files.idFile=%i",
-        idFile));
-    if (!path.empty())
-      InvalidatePathHash(path);
+    if (hashAction == DeleteMovieHashAction::HASH_DELETE)
+    {
+      const std::string path = GetSingleValue(PrepareSQL(
+          "SELECT strPath FROM path JOIN files ON files.idPath=path.idPath WHERE files.idFile=%i",
+          idFile));
+      if (!path.empty())
+        InvalidatePathHash(path);
+    }
 
     m_pDS->exec(PrepareSQL("DELETE FROM videoversion WHERE idFile=%i", idFile));
 
diff --git a/xbmc/video/VideoDatabase.h b/xbmc/video/VideoDatabase.h
index ed3777e..302f797 100644
--- a/xbmc/video/VideoDatabase.h
+++ b/xbmc/video/VideoDatabase.h
@@ -621,6 +621,10 @@ public:
   // scanning hashes and paths scanned
   bool SetPathHash(const std::string &path, const std::string &hash);
   bool GetPathHash(const std::string &path, std::string &hash);
+  /*! \brief Clear the hash of the folder of a video's path, and of the folder above it
+   where that is what names the video, so that the next scan looks at them again.
+   */
+  void InvalidatePathHash(const std::string& strPath);
   bool GetPaths(std::set<std::string, std::less<>>& paths);
   bool GetPathsForTvShow(int idShow, std::set<int>& paths);
 
@@ -1061,7 +1065,8 @@ public:
                      int idVideoAsset,
                      VideoAssetType videoAssetType,
                      CFileItem& item);
-  bool DeleteVideoAsset(int idFile);
+  bool DeleteVideoAsset(int idFile,
+                        DeleteMovieHashAction hashAction = DeleteMovieHashAction::HASH_DELETE);
   bool IsDefaultVideoVersion(int idFile);
   bool GetVideoVersionTypes(VideoDbContentType idContent,
                             VideoAssetType assetType,
@@ -1331,7 +1336,6 @@ private:
   void SplitPath(const std::string& strFileNameAndPath,
                  std::string& strPath,
                  std::string& strFileName) const;
-  void InvalidatePathHash(const std::string& strPath);
 
   /*! \brief Clear the hash of a path, without adding it to the path table if unknown
    \param strPath the path to clear the hash of
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index 95db313..05969da 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -614,11 +614,20 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       db.GetBookMarksForFile(tag.m_strFileNameAndPath, discBookmarks);
     }
 
+    // A movie is added again for the same files, so the hashes of its folders are kept and the
+    // next scan doesn't look at them again. They are cleared should adding it again fail.
+    std::string moviePath;
+
     // remove any existing data for the item we're going to refresh
     if (origDbId > 0)
     {
       if (scraper->Content() == ADDON::ContentType::MOVIES)
       {
+        moviePath = db.GetSingleValue(
+            db.PrepareSQL("SELECT strPath FROM path JOIN files ON files.idPath = path.idPath "
+                          "JOIN movie ON movie.idFile = files.idFile WHERE movie.idMovie = %i",
+                          origDbId));
+
         // the disc's other playlists are chosen again along with it
         if (!discFile.empty())
         {
@@ -628,10 +637,12 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
           for (const auto& version : versions)
           {
             if (URIUtils::GetDiscFile(version->GetDynPath()) == discFile)
-              db.DeleteVideoAsset(version->GetVideoInfoTag()->m_iDbId);
+              db.DeleteVideoAsset(version->GetVideoInfoTag()->m_iDbId,
+                                  DeleteMovieHashAction::HASH_PRESERVE);
           }
         }
-        db.DeleteMovie(origDbId, DeleteMovieCascadeAction::DEFAULT_VERSION);
+        db.DeleteMovie(origDbId, DeleteMovieCascadeAction::DEFAULT_VERSION,
+                       DeleteMovieHashAction::HASH_PRESERVE);
       }
       else if (scraper->Content() == ADDON::ContentType::MUSICVIDEOS)
         db.DeleteMusicVideo(origDbId);
@@ -670,6 +681,9 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       // something went wrong
       MarkFinished();
 
+      if (!moviePath.empty())
+        db.InvalidatePathHash(moviePath);
+
       // The movie has been removed. Remove its other versions and extras too, as removing it from
       // the library would, rather than leave them attached to a movie that no longer exists.
       if (hasAdditionalAssets && scraper->Content() == ADDON::ContentType::MOVIES)
diff --git a/xbmc/video/test/TestVideoDatabase.cpp b/xbmc/video/test/TestVideoDatabase.cpp
index 4c408ad..b9b08a9 100644
--- a/xbmc/video/test/TestVideoDatabase.cpp
+++ b/xbmc/video/test/TestVideoDatabase.cpp
@@ -1431,6 +1431,27 @@ TEST_F(TestVideoDatabaseClean, EndsItsTransactionWhenThePathsHoldNoMedia)
   EXPECT_FALSE(m_db.InTransaction());
 }
 
+// A refresh removes a disc's versions to add them again, which leaves its folder as it was
+TEST_F(TestVideoDatabase, DeleteVideoAssetCanKeepTheHashOfItsFolder)
+{
+  const std::string folder{"/movies/Film (2010)/"};
+  const int idMovie{AddMovie(folder + "Film.mkv")};
+  ASSERT_GT(idMovie, 0);
+  CFileItem version{folder + "Film Extended.mkv", false};
+  ASSERT_TRUE(m_db.AddVideoAsset(VideoDbContentType::MOVIES, idMovie, VIDEO_VERSION_ID_DEFAULT,
+                                 VideoAssetType::VERSION, version));
+  const int idFile{
+      m_db.GetSingleValueInt("SELECT idFile FROM files WHERE strFilename = 'Film Extended.mkv'")};
+  ASSERT_GT(idFile, 0);
+  ASSERT_TRUE(m_db.SetPathHash(folder, "hash"));
+
+  ASSERT_TRUE(m_db.DeleteVideoAsset(idFile, DeleteMovieHashAction::HASH_PRESERVE));
+
+  std::string hash;
+  ASSERT_TRUE(m_db.GetPathHash(folder, hash));
+  EXPECT_EQ("hash", hash);
+}
+
 TEST_F(TestVideoDatabase, GetMovieIdFindsTheMovieOnTheDiscPlaylistsOfADiscImageWithoutOne)
 {
   const std::string disc{"/movies/M3GAN 2.0 (2025)/M3GAN20_UPK1.iso"};
