diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index be1a85a..5333bc1 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1407,9 +1407,11 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
             }
     }
     bool paired = source->enhancement_layer && isfinite(el_pts) && fabs(pts - el_pts) < 0.00001;
-    /* Hades: HLG sent as Dolby Vision is a single layer: one with an enhancement layer is not drawn */
-    if (r->base_transfer == DVBRIDGE_BASE_HLG_TO_PQ && el) {
-        r->not_drawn = "a picture of HLG sent as Dolby Vision came with an enhancement layer";
+    /* Hades: HLG sent as Dolby Vision is a single layer, and not for Low-Latency (whose mapping to the
+     * display is made from a picture in ST 2084 and its level 1): such a picture is not drawn */
+    if (r->base_transfer == DVBRIDGE_BASE_HLG_TO_PQ && (el || r->low_latency)) {
+        r->not_drawn = el ? "a picture of HLG sent as Dolby Vision came with an enhancement layer"
+                          : "a picture of HLG sent as Dolby Vision is not drawn for Low-Latency";
         return false;
     }
     /* Hades: Low-Latency is drawn the composed way only (dvbridge_render_set_low_latency()) */
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index e1be0eb..3d2d286 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -428,6 +428,9 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
       DVBRIDGE::GetOutputChoice(), hints.dovi.dv_profile, hints.dovi.dv_bl_signal_compatibility_id,
       !hints.doviMeasured && !hints.doviFromHdr10Plus);
   m_dvMeasured = hints.doviMeasured || m_dvMeasuredInPlace;
+  // Hades: ... an HLG one converted to PQ, only where the demuxer measured it so (a stream of HDR10 that
+  // says it too, or one whose own metadata are measured in place, never)
+  m_dvHlg = hints.doviFromHlg && hints.doviMeasured && !m_dvMeasuredInPlace;
   m_dvMeasuredPlaceholderTold = false;
   m_dvMeasuredPlaceholder.clear();
   if (m_dvMeasured)
@@ -503,7 +506,15 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
                                   "none, measured from the picture"
                                 : "",
               m_dvNativeOutput ? "" : " (not now: it is not sent natively, and plays as HDR10+)");
-  if (m_dvMeasured)
+  if (m_dvHlg)
+    CLog::Log(LOGINFO,
+              "DV: this is an HLG video sent as Dolby Vision profile 8.1 (HLG as Dolby Vision, "
+              "videoscreen.hadeshlgasdv): its picture is converted to PQ as the BT.2100 reference "
+              "display shows HLG (1000 cd/m2, system gamma 1.2) and its Dolby Vision metadata are "
+              "measured from that picture as it plays{}",
+              m_dvNativeOutput ? ""
+                               : " (not now: it is not sent natively, and plays as the HLG it is)");
+  else if (m_dvMeasured)
     CLog::Log(LOGINFO, "DV: its Dolby Vision metadata are measured from the picture as it plays{}{}",
               m_dvMeasuredInPlace ? ", in place of its own, as the user chose for this video (its "
                                     "RPU and its enhancement layer are left aside)"
@@ -956,6 +967,7 @@ void CDVDVideoCodecFFmpeg::Dispose()
   dvbridge_hdr10plus_scene_destroy(m_dvHdr10PlusScene);
   m_dvHdr10PlusScene = nullptr;
   m_dvMeasured = false;
+  m_dvHlg = false;
   m_dvMeasuredInPlace = false;
