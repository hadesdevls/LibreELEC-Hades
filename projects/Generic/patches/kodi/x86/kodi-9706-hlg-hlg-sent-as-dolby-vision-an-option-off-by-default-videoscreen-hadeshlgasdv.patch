+      parameters->color_trc == AVCOL_TRC_ARIB_STD_B67,
+      parameters->color_primaries == AVCOL_PRI_BT2020, parameters->color_space == AVCOL_SPC_BT2020_NCL,
+      tenBits420 ? 10 : 0, tenBits420, parameters->color_range == AVCOL_RANGE_JPEG,
+      parameters->field_order == AV_FIELD_PROGRESSIVE || parameters->field_order == AV_FIELD_UNKNOWN);
