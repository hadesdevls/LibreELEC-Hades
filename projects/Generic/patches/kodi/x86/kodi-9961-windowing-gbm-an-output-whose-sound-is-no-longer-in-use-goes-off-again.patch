+//! Hades: an output, as (node of its device, its name)
+using OutputKey = std::pair<std::string, std::string>;
+
+//! Hades: the outputs kept on for the sound in use after a decision, and what changed
+struct SoundKeptChange
+{
+  std::set<OutputKey> kept; //!< what the decision keeps, and nothing else
+  std::vector<OutputKey> added; //!< kept now, not before
+  std::vector<OutputKey> dropped; //!< kept before, not now: they go off as unused outputs do
+};
+
+/*!
+ * \brief Hades: the outputs kept on for the sound in use are what the decision says now, not what
+ *        any decision said before: an output whose sound is no longer in use (the sound followed
+ *        the display that Kodi moved to, the user chose another audio output) goes off as an
+ *        output that Kodi does not use, as before this build kept outputs on for their sound.
+ *        What is not certain is kept by the decision itself, as long as it is not certain.
+ */
+inline SoundKeptChange NextSoundKept(const std::set<OutputKey>& before,
+                                     const SoundDecision& decision)
+{
+  SoundKeptChange change;
+  for (const SoundKeep& keep : decision.keep)
+    change.kept.insert({keep.node, keep.output});
+  for (const OutputKey& key : change.kept)
+  {
+    if (!before.contains(key))
+      change.added.push_back(key);
+  }
+  for (const OutputKey& key : before)
+  {
+    if (!change.kept.contains(key))
+      change.dropped.push_back(key);
+  }
+  return change;
+}
+
 /*!
  * \brief Hades: in a move of Kodi to another output of its device, the CRTC to move to where the
  *        output that Kodi leaves is kept on for its sound: one that is off and is not the one in
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 8ff00c6..4093c62 100644
