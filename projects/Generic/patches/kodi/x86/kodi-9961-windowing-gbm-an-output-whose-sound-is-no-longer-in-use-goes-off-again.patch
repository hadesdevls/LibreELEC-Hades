 {
   int off = 0;
   int kept = 0;
@@ -1797,6 +1834,15 @@ void CDRMUtils::TurnOffOtherDevice(const std::string& node, int fd)
     CLog::LogF(LOGINFO, "{}: {} stay(s) on as it was, for its sound ({})", node, keptOn,
                KeptBy(node, keptNamesAll));
 
+  // (Hades: a device that Kodi holds already: ReconsiderSoundOutputs())
+  if (held)
+  {
