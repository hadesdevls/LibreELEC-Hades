 4 files changed, 99 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 12137ec..a281743 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -191,6 +191,14 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
   // carry its sound are kept on, and one of another device comes back (ReconsiderSoundOutputs())
   else if (!strict && !moving && SoundOutputsChanged())
     ReconsiderSoundOutputs();
+  // Hades: an output of this device that no longer carries the sound in use goes off as an output
+  // that Kodi does not use, by the same way (DisableOtherOutputs(), its tests first), with the next
+  // commit that may carry it
+  if (TakeOwnSoundDropped() && !m_otherOutputsOff)
+  {
+    m_otherOutputsOff = std::chrono::steady_clock::now();
+    m_otherOutputsTries = 0;
+  }
 
