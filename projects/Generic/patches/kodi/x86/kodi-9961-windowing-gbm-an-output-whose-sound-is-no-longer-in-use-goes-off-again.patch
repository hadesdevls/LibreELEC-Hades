@@ -1690,6 +1726,7 @@ void CDRMUtils::DisableOtherDevices()
   }
   DecideSoundOutputs(m_otherSurveys);
   m_otherOutputsDone = true;
+  m_soundDropped.clear(); // (everything not kept goes off now)
 
   for (const auto& [node, fd] : opened)
     TurnOffOtherDevice(node, fd);
@@ -1698,7 +1735,7 @@ void CDRMUtils::DisableOtherDevices()
   m_otherDevicesPending = false;
 }
 
-void CDRMUtils::TurnOffOtherDevice(const std::string& node, int fd)
