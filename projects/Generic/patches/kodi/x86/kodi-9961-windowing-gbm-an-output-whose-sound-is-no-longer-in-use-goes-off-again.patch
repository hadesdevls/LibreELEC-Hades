+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1452,6 +1452,23 @@ void CDRMUtils::DecideSoundOutputs(const std::vector<KEEP_OUTPUTS::GraphicsDevic
   const KEEP_OUTPUTS::SoundDecision decision =
       KEEP_OUTPUTS::OutputsForSound(sound, generation != 0, devices);
 
+  // (what is kept is what the decision says now: KEEP_OUTPUTS::NextSoundKept())
+  const KEEP_OUTPUTS::SoundKeptChange change = KEEP_OUTPUTS::NextSoundKept(m_soundKept, decision);
+  m_soundKept = change.kept;
+  for (const auto& [node, output] : change.dropped)
+  {
+    if (node == m_node)
+      std::erase(m_soundBringBack, output);
+    // (the output that Kodi draws on is on anyway)
+    if (node == m_node && m_connector && output == m_connector->GetName())
+      continue;
+    m_soundDropped.insert(node);
+    CLog::LogF(LOGINFO,
+               "{}: {} no longer carries the sound in use: it goes off as an output that Kodi does "
+               "not use, unless hades-keep-outputs keeps it on",
+               node, output);
+  }
+
   bool otherKept = false;
   for (const KEEP_OUTPUTS::SoundKeep& keep : decision.keep)
   {
@@ -1459,7 +1476,8 @@ void CDRMUtils::DecideSoundOutputs(const std::vector<KEEP_OUTPUTS::GraphicsDevic
     // all the same, for a move to another output, which leaves it: PlanOutputMove())
     const bool kodis = keep.node == m_node && m_connector && keep.output == m_connector->GetName();
     otherKept = otherKept || !kodis;
-    if (!m_soundKept.insert({keep.node, keep.output}).second || kodis)
+    if (kodis || std::ranges::find(change.added, KEEP_OUTPUTS::OutputKey{keep.node, keep.output}) ==
+                     change.added.end())
       continue;
     CLog::LogF(LOGINFO, "{}: {} ({}) stays on for {}", keep.node, keep.output,
                keep.display.Known() ? keep.display.Describe() : "no display known",
@@ -1625,6 +1643,24 @@ void CDRMUtils::ReconsiderSoundOutputs()
                node);
     TurnOffOtherDevice(node, fd);
   }
+
+  // (an output of another device that Kodi holds, which no longer carries the sound in use: turned
+  // off there as the outputs that Kodi does not use are; those of this device go off with the next
+  // commit, CDRMAtomic::DisableOtherOutputs(): TakeOwnSoundDropped())
+  for (const std::string& node : m_soundDropped)
+  {
+    if (node == m_node || giveBack.contains(node))
+      continue;
+    const auto held = std::ranges::find(m_otherDeviceFdNodes, node);
+    if (held != m_otherDeviceFdNodes.end())
+      TurnOffOtherDevice(node, m_otherDeviceFds[held - m_otherDeviceFdNodes.begin()], true);
+  }
+  std::erase_if(m_soundDropped, [this](const std::string& node) { return node != m_node; });
+}
+
+bool CDRMUtils::TakeOwnSoundDropped()
+{
+  return m_soundDropped.erase(m_node) != 0;
 }
 
