+extern "C"
+{
+#include <libavutil/hdr_dynamic_metadata.h>
+}
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace KODI
+{
+namespace UTILS
+{
+namespace HDR10PLUS
+{
+
+//! The payload of the HDR10+ vendor-specific InfoFrame: PB1..PB27, the IEEE OUI of HDR10+
+//! Technologies (90-84-8B, least significant byte first) and 24 bytes of metadata
+constexpr std::size_t VSIF_PAYLOAD_SIZE = 27;
+using Payload = std::array<uint8_t, VSIF_PAYLOAD_SIZE>;
+
+/*!
+ * \brief The value of a rational of FFmpeg in the units that SMPTE ST 2094-40 codes it in (den),
+ *        rounded, never negative
+ */
+inline int64_t Coded(AVRational q, int64_t den)
+{
+  if (q.den <= 0 || q.num <= 0)
+    return 0;
+  if (q.den == den)
+    return q.num;
+  return (static_cast<int64_t>(q.num) * den + q.den / 2) / q.den;
+}
+
+/*!
+ * \brief A value of 1/100000 (average_maxrgb and the percentiles of the distribution of maxRGB)
+ *        as the InfoFrame codes it: in units of 16 / 10000, rounded, 255 at most
+ */
+inline uint8_t CodedMaxRgb(int64_t coded)
+{
+  const int64_t v = coded / 10;
+  return static_cast<uint8_t>(std::min<int64_t>(255, (v + (1 << 3)) >> 4));
+}
+
+/*!
+ * \brief The payload of the HDR10+ vendor-specific InfoFrame of a picture, from its SMPTE ST
+ *        2094-40 (application 4) metadata as FFmpeg gives it (AV_FRAME_DATA_DYNAMIC_HDR_PLUS,
+ *        parsed from the ITU-T T.35 message of the picture in HEVC and AV1)
+ *
+ * The InfoFrame is defined by the HDR10+ specification, which HDR10+ Technologies gives to its
+ * adopters only. Its layout and the coding of each field here are those of the GPL code that
+ * CoreELEC (Amlogic) sends it with, read as data: hdmitx_set_hdr10plus_pkt() of
+ * hdmitx20/hdmi_tx_main.c and hdr10_plus_hdmitx_vsif_parser() of amvecm/hdr/am_hdr10_plus.c,
+ * common_drivers 207374d38afd:
+ *  - PB4: the application version (2 bits) and the targeted system display maximum luminance
+ *    in units of 32 cd/m2, rounded (5 bits, 31 from 976 cd/m2 up);
+ *  - PB5: average_maxrgb; PB6..PB14: the nine percentiles of the distribution of maxRGB of the
+ *    first window, each in units of 16/10000 and at most 255, except the third one of
+ *    application version 1, which is given as it is coded (it is no percentile there);
+ *    in version 0, a tenth percentile replaces the ninth;
+ *  - PB15..PB17: the number of Bezier curve anchors (4 bits, 9 at most), the knee point x and
+ *    y (10 bits each, of the 12 of the metadata); PB18..PB26: the anchors (8 of their 10
+ *    bits); all of them 0 without tone mapping;
+ *  - PB27: graphics overlay 0 (the metadata is of the video only) and no delay 1 (it is sent
+ *    with the frame it is of).
+ * Every field comes from the picture's own metadata of its first processing window; nothing is
+ * made up. Nothing when there is no window, or for an application version above 1.
+ */
+inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m)
+{
+  if (m.num_windows < 1 || m.application_version > 1)
+    return std::nullopt;
+
+  const AVHDRPlusColorTransformParams& w = m.params[0];
+  Payload p{};
+  p[0] = 0x8B;
+  p[1] = 0x84;
+  p[2] = 0x90;
+
+  const int64_t targeted = Coded(m.targeted_system_display_maximum_luminance, 1);
+  const int64_t targetedCode = targeted < 1024 ? std::min<int64_t>(31, (targeted + 16) >> 5) : 31;
+  p[3] = static_cast<uint8_t>(((m.application_version & 0x3) << 6) | ((targetedCode & 0x1F) << 1));
+
+  p[4] = CodedMaxRgb(Coded(w.average_maxrgb, 100000));
+
+  const unsigned int count = std::min<unsigned int>(w.num_distribution_maxrgb_percentiles, 15);
+  for (unsigned int i = 0; i < 9; ++i)
+  {
+    unsigned int from = i;
+    if (i == 8 && m.application_version == 0 && count == 10)
+      from = 9;
+    const int64_t coded = from < count ? Coded(w.distribution_maxrgb[from].percentile, 100000) : 0;
+    if (i == 2 && m.application_version != 0)
+      p[5 + i] = static_cast<uint8_t>(std::min<int64_t>(255, coded));
+    else
+      p[5 + i] = CodedMaxRgb(coded);
+  }
+
+  if (w.tone_mapping_flag)
+  {
+    const unsigned int anchors = std::min<unsigned int>(w.num_bezier_curve_anchors, 9);
+    const int64_t kneeX = std::min<int64_t>(1023, (Coded(w.knee_point_x, 4095) + 2) >> 2);
+    const int64_t kneeY = std::min<int64_t>(1023, (Coded(w.knee_point_y, 4095) + 2) >> 2);
+    p[14] = static_cast<uint8_t>(((anchors & 0xF) << 4) | ((kneeX >> 6) & 0xF));
+    p[15] = static_cast<uint8_t>(((kneeX & 0x3F) << 2) | ((kneeY >> 8) & 0x3));
+    p[16] = static_cast<uint8_t>(kneeY & 0xFF);
+    for (unsigned int i = 0; i < anchors; ++i)
+      p[17 + i] = static_cast<uint8_t>(
+          std::min<int64_t>(255, (Coded(w.bezier_curve_anchors[i], 1023) + 2) >> 2));
+  }
+
+  p[26] = 0x40;
+  return p;
+}
+
+} // namespace HDR10PLUS
+} // namespace UTILS
+} // namespace KODI
