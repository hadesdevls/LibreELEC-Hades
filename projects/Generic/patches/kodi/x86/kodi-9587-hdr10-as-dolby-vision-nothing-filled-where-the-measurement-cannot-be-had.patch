From aa83203c7d1bc4f03312d8e7f1109f47dcd0cce0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:47:45 +0000
Subject: [PATCH] HDR10+ as Dolby Vision: nothing filled where the measurement
 cannot be had

Where the measurement of pictures cannot be set up on the GPU
(dvbridge_measure_create() fails in DVMeasureReady(): m_dvMeasureFailed),
HDR10+ sent as Dolby Vision still filled the pictures without statistics
of their own: the decoder no longer gave them as repeated RPUs, so the
stream never went to the ordinary output, and CDVHdr10PlusFill, with
nothing measured, sent the level 1 block that went out last, with a scene
refresh, until statistics came back. Credits that lose their HDR10+ kept
the level 1 of another scene to their end: stale metadata. Found by the
second independent review of 1.0 RC6 (R-A3).

Now where the measurement cannot be had nothing is filled, as before the
filling (as <video><dvhdr10plusfill>false</dvhdr10plusfill> does):

- DVBRIDGE::MeasurementFailed() / MeasurementUnavailable(): set by the
  window system when the measurement fails to set up (it stays so until
  Kodi starts again), read from any thread;
- DVBRIDGE::Hdr10PlusFillFor(setting, unavailable), the one rule that the
  three places ask: the decoder for each picture (a picture without
  statistics of its own is again the metadata made last, as a repeated
  RPU: twelve in a row and the stream goes to the ordinary output), the
  window system for each picture it presents (it sends what the decoder
  made, and asks nothing of CDVHdr10PlusFill), and the demuxer as it
  probes (a stream whose HDR10+ never bring statistics is not made Dolby
  Vision).

The failure is known only once the window system has tried to set the
measurement up, at the first picture to be measured, on the render
thread; the flag only goes from false to true. The pictures decoded before
that (those queued for presentation) go out as the decoder made them, with
nothing written into them, and the ordinary output comes within those and
twelve more. In the videos after it, everything is as before the filling
from the first picture.

The host test of the filling (fill_test, F9) now asks that, with the
measurement known not to be had, every picture goes out as with the filling
off, picture by picture, and that, with it failing at the first picture to
be measured, nothing is written after it: it fails on the tree before this
change and on two mutations of the rule, and passes here.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 11 ++++--
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 20 +++++++++++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            |  5 ++-
 xbmc/windowing/gbm/DVHdr10PlusFill.h          |  3 ++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 36 +++++++++++++++----
 5 files changed, 65 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index b407d2f..60bacde 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -1344,7 +1344,8 @@ void CDVDVideoCodecFFmpeg::UseLayerDVMetadata(VideoPicture& base,
 // of its mastering display, gets the metadata made last as a repeated RPU, as FFmpeg's HEVC decoder
 // gives the last RPU to a picture without one: it counts as a picture without metadata
 // (CheckNativeDVPicture()), and a stretch of them goes to the ordinary output. Hades: that, where
-// advancedsettings.xml turns it off (m_dvHdr10PlusFill); by default such a picture is measured by
+// advancedsettings.xml turns it off (m_dvHdr10PlusFill) or the measurement cannot be had
+// (DVBRIDGE::Hdr10PlusFillFor()); by default such a picture is measured by
 // the window system (doviMeasured, doviHdr10Plus: CDVHdr10PlusFill), which writes into those
 // metadata (or, where none were made yet, those of its static metadata,
 // dvbridge_measured_placeholder()) the level 1 block of its scene, and it counts as a picture
@@ -1362,7 +1363,11 @@ void CDVDVideoCodecFFmpeg::MakeHdr10PlusMetadata(VideoPicture* picture)
       m_dvHdr10PlusScene, hdr10plus, picture->hasDisplayMetadata ? &picture->displayMetadata : nullptr,
       picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size, &repeated, &of);
   const bool own = (of & DVBRIDGE_HDR10PLUS_KIND) == DVBRIDGE_HDR10PLUS_OWN;
-  const bool fill = m_dvHdr10PlusFill && !own;
+  // Hades: not where the measurement cannot be had (asked for each picture: it is known only once
+  // the window system tried to set it up): then as before the filling
+  const bool fillOn =
+      DVBRIDGE::Hdr10PlusFillFor(m_dvHdr10PlusFill, DVBRIDGE::MeasurementUnavailable());
+  const bool fill = fillOn && !own;
   picture->doviMeasured = false;
   picture->doviHdr10Plus = 0;
   if (made && picture->doviMetadata.Assign(reinterpret_cast<const uint8_t*>(made), size))
@@ -1384,7 +1389,7 @@ void CDVDVideoCodecFFmpeg::MakeHdr10PlusMetadata(VideoPicture* picture)
     if (!m_dvMeasuredPlaceholder.empty())
       picture->doviMetadata.Assign(m_dvMeasuredPlaceholder.data(), m_dvMeasuredPlaceholder.size());
   }
-  if (m_dvHdr10PlusFill && picture->doviMetadata.Data())
+  if (fillOn && picture->doviMetadata.Data())
   {
     picture->doviHdr10Plus = of;
     picture->doviMeasured = fill;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index cda9207..7135462 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -912,6 +912,26 @@ inline bool Hdr10PlusAsDolbyVisionFor(bool settingOn,
 //! (videoscreen.hadesdvfromhdr10, dvbridge_measured.h): the setting is on, the user chose no other
 //! output for the video, and the display takes native Dolby Vision in a mode that carries it.
 bool Hdr10AsDolbyVision();
+//! Hades: the measurement of pictures on the GPU (dvbridge_measure.h) could not be set up
+//! (CWinSystemGbmGLESContext::DVMeasureReady(), render thread); it stays so until Kodi starts again
+void MeasurementFailed();
+//! ... whether it could not (any thread; false until it was tried and failed)
+bool MeasurementUnavailable();
+//! Hades: whether a picture of HDR10+ sent as Dolby Vision that has no statistics of its own is
+//! filled with a level 1 block measured from the picture (CDVHdr10PlusFill): the expert switch is
+//! on (<video><dvhdr10plusfill>, m_videoDVHdr10PlusFill) and the measurement is not known to be
+//! unavailable (MeasurementUnavailable()). Where it is, nothing is filled, as before the filling:
+//! the decoder gives such a picture the metadata made last, as a repeated RPU (twelve in a row and
+//! the stream goes to the ordinary output, HDR10, rather than the display being sent a level 1
+//! block that is not of those pictures), the window system sends what the decoder made, and the
+//! demuxer does not make Dolby Vision of a stream whose HDR10+ never bring statistics. Asked by the
+//! demuxer as it probes, by the decoder for each picture and by the window system for each picture
+//! it presents: the measurement fails on the render thread at the first picture to be measured, so
+//! the pictures decoded before that go out as the decoder made them.
+constexpr bool Hdr10PlusFillFor(bool setting, bool measurementUnavailable)
+{
+  return setting && !measurementUnavailable;
+}
 
 /*!
  * \brief Hades: why the pictures of a Dolby Vision stream that is decoded for native output or for
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index ef7b297..a5e21b8 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1544,8 +1544,11 @@ void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
     // Hades: HDR10+ metadata that bring no statistics in any access unit looked at (they never did
     // in this stream so far): sent as Dolby Vision all the same, measured from the picture where
     // they give no level 1 block (CDVHdr10PlusFill), where that is on (<video><dvhdr10plusfill>)
+    // and the measurement is not known to be unavailable (DVBRIDGE::Hdr10PlusFillFor())
     const auto component = CServiceBroker::GetSettingsComponent();
-    const bool fill = !component || component->GetAdvancedSettings()->m_videoDVHdr10PlusFill;
+    const bool fill = DVBRIDGE::Hdr10PlusFillFor(
+        !component || component->GetAdvancedSettings()->m_videoDVHdr10PlusFill,
+        DVBRIDGE::MeasurementUnavailable());
     withoutStatistics = verdict == CDVHdr10Plus::Verdict::NOT_YET && probed >= done && fill &&
                         m_dvWithoutStatistics[streamIdx] > 0;
     // (the last access unit looked at, or one that says that it never will be: said once)
diff --git a/xbmc/windowing/gbm/DVHdr10PlusFill.h b/xbmc/windowing/gbm/DVHdr10PlusFill.h
index a2dfcd3..525c98b 100644
--- a/xbmc/windowing/gbm/DVHdr10PlusFill.h
+++ b/xbmc/windowing/gbm/DVHdr10PlusFill.h
@@ -55,6 +55,9 @@ namespace GBM
  * pictures that are not of their own statistics (CWinSystemGbmGLESContext::DVHdr10PlusMetadata()),
  * asks the measurement what Before() says, and writes into the picture's metadata what After()
  * says. Nothing is measured, and no metadata change, for a stream whose statistics are all there.
+ * Where the measurement cannot be had (DVBRIDGE::Hdr10PlusFillFor()), nothing is filled and this
+ * class is not asked: the pictures go as before the filling, rather than with a level 1 block kept
+ * from another scene.
  */
 class CDVHdr10PlusFill
 {
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0d239d0..76eb603 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2379,6 +2379,23 @@ void DVBRIDGE::Hdr10PlusFound()
   g_dvStreamHdr10Plus = true;
 }
 
+// Hades: the measurement of pictures could not be set up (DVMeasureReady()): for the decoder and
+// the demuxer, which ask it as they make HDR10+ into Dolby Vision (DVBRIDGE::Hdr10PlusFillFor())
+namespace
+{
+std::atomic<bool> g_dvMeasureUnavailable{false};
+} // namespace
+
+void DVBRIDGE::MeasurementFailed()
+{
+  g_dvMeasureUnavailable = true;
+}
+
+bool DVBRIDGE::MeasurementUnavailable()
+{
+  return g_dvMeasureUnavailable;
+}
+
 void DVBRIDGE::VideoStreamOpened(const CDVDStreamInfo& stream)
 {
   g_dvStreamProfile = static_cast<int>(stream.dovi.dv_profile);
@@ -4612,8 +4629,10 @@ bool CWinSystemGbmGLESContext::DVMeasureReady()
     if (!m_dvMeasure)
     {
       m_dvMeasureFailed = true;
+      DVBRIDGE::MeasurementFailed();
       CLog::Log(LOGERROR, "DVBridge: the measurement of HDR10 pictures could not be set up: they "
-                          "go out with the metadata of their static metadata");
+                          "go out with the metadata of their static metadata; HDR10+ sent as Dolby "
+                          "Vision is not filled where its statistics are missing (as before)");
     }
   }
   return m_dvMeasure && m_dvMeasured;
@@ -4766,6 +4785,11 @@ void CWinSystemGbmGLESContext::DVHdr10PlusMetadata(const CDVBridgeGLES::Layer& l
     m_dvFillTold = false;
     m_dvFillHaveLast = false;
   }
+  // Hades: where the measurement cannot be had, nothing is filled (DVBRIDGE::Hdr10PlusFillFor()):
+  // the picture goes out as the decoder made it, as before the filling (a picture without
+  // statistics of its own, the metadata made last; the decoder no longer marks the next ones)
+  if (!DVBRIDGE::Hdr10PlusFillFor(true, DVBRIDGE::MeasurementUnavailable()))
+    return;
   CDVHdr10PlusFill::Out out;
   // (the picture drawn again, paused or kept: what went out with it the first time)
   const bool again = m_dvFillHaveLast && layer.pts == m_dvFillPts;
@@ -4816,6 +4840,9 @@ void CWinSystemGbmGLESContext::DVHdr10PlusMetadata(const CDVBridgeGLES::Layer& l
       measured.max = l1.max_pq;
       measured.avg = l1.avg_pq;
     }
+    // (the measurement failed to set up for this picture, the first one it was asked for: as above)
+    if (!DVBRIDGE::Hdr10PlusFillFor(true, DVBRIDGE::MeasurementUnavailable()))
+      return;
     unsigned int own[3] = {};
     const bool ownValid = Level1Of(metadata, own);
     out = m_dvFill.After(kind, own, ownValid, measured);
@@ -4834,15 +4861,12 @@ void CWinSystemGbmGLESContext::DVHdr10PlusMetadata(const CDVBridgeGLES::Layer& l
       CLog::Log(LOGINFO,
                 "DVBridge: HDR10+ sent as Dolby Vision: the scene at {:.3f} s has {}: its level 1 "
                 "block is measured from the picture, as for HDR10 measured as Dolby Vision, until "
-                "a scene with HDR10+ statistics of its own; the display stays in Dolby Vision{}",
+                "a scene with HDR10+ statistics of its own; the display stays in Dolby Vision",
                 layer.pts / DVD_TIME_BASE,
                 (kind & CDVHdr10PlusFill::KIND) == CDVHdr10PlusFill::INCOMPLETE
                     ? "HDR10+ metadata without statistics of their own (no level 1 block can be "
                       "made of them)"
-                    : "no HDR10+ metadata",
-                m_dvMeasureFailed ? " (the measurement could not be set up: the last level 1 block "
-                                    "sent stays)"
-                                  : "");
+                    : "no HDR10+ metadata");
     }
     if (++m_dvFillFrames % 240 == 0)
       DVHdr10PlusFillTell("so far");
