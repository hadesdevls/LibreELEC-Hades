+/* Hades: a transport frame of black with metadata (dvbridge_eos.h: the end of the signal, video/
+ * dveos): every pixel the codes black gives (luma, and the chroma of the even and of the odd pixel
+ * of a pair: Cb and Cr), the bits of the packets in the chroma LSBs where every packer puts them.
+ * The framebuffer as for dvbridge_gl_pack(); the GL state is put back. */
+#define DVBRIDGE_GL_EOS 1
+struct dvbridge_gl_eos;
+struct dvbridge_gl_eos *dvbridge_gl_eos_create(void);
+void dvbridge_gl_eos_destroy(struct dvbridge_gl_eos *eos);
+bool dvbridge_gl_eos_draw(struct dvbridge_gl_eos *eos, unsigned framebuffer, int width, int height,
+                          const uint32_t packets[512], unsigned count, const unsigned black[3],
+                          bool flip_y);
 #endif
