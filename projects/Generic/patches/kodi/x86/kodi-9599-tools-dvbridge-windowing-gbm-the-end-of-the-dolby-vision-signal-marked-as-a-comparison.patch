   glDeleteFramebuffers(1, &m_framebuffer);
   dvbridge_gl_packer_destroy(m_packer);
   dvbridge_gl_copier_destroy(m_copier);
+  dvbridge_gl_eos_destroy(m_eos);
   dvbridge_renderer_destroy(m_renderer);
   if (m_gl)
     pl_tex_destroy(m_gl->gpu, &m_scanout);
@@ -1123,6 +1125,35 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancemen
   return result;
 }
 
+bool CDVBridgeGLES::DrawEndOfStream(unsigned int framebuffer,
+                                    int width,
+                                    int height,
+                                    bool flipY,
+                                    unsigned int& packets,
+                                    const char*& why)
+{
+  packets = 0;
+  why = nullptr;
+  const dvbridge_candidate* candidate =
+      m_renderer ? dvbridge_render_candidate(m_renderer) : nullptr;
+  unsigned int count = 0;
+  const uint32_t* words = candidate ? dvbridge_packets(candidate, &count) : nullptr;
+  uint32_t eos[512] = {};
+  unsigned int black[3] = {};
+  if (!words || !count)
+    why = "the metadata of the last frame are no longer there";
+  else if (!dvbridge_eos_packets(words, count, eos, black))
+    why = "the packets of the last frame are not those of a frame";
+  else if (!m_eos && !(m_eos = dvbridge_gl_eos_create()))
+    why = "its GPU program could not be made";
+  else if (!dvbridge_gl_eos_draw(m_eos, framebuffer, width, height, eos, count, black, flipY))
+    why = "it could not be drawn";
+  if (why)
+    return false;
+  packets = count;
+  return true;
+}
+
 bool CDVBridgeGLES::Pack(unsigned int framebuffer, int width, int height, bool flipY, Cover cover)
 {
   m_packed = false;
