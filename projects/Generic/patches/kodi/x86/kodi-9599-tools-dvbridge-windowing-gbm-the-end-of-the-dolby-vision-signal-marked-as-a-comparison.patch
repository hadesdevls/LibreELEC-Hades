diff --git a/tools/dvbridge/dvbridge_eos.h b/tools/dvbridge/dvbridge_eos.h
new file mode 100644
index 0000000..a73c15d
--- /dev/null
+++ b/tools/dvbridge/dvbridge_eos.h
@@ -0,0 +1,86 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-3.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+/* Hades: the end of a Dolby Vision signal as ETSI GS CCM 001 V1.1.1 lets a source mark it (clause
+ * 6.3.2, table 9): EOS, bit 0 of byte 2 of the header of each HDR DM metadata transmission packet,
+ * "set to indicate that the immediate next picture contains non-HDR signal. When EOS is equal to 1,
+ * HDR sink shall switch to SDR operation mode for the immediate next picture." Hades sends EOS 0 in
+ * every packet (dvbridge_metadata.h). With the expert comparison video/dveos
+ * (advancedsettings.xml), native output is left with one more transport frame: the packets of the
+ * last frame with EOS set, over black.
+ *
+ * Here, without GL: the packets of a frame (as dvbridge_packets() gives them: count of them, 32
+ * words each, four bytes to a word, the first in the high bits) with EOS set and their CRC made
+ * again (CRC-32 of ISO/IEC 13818-1 annex A, as the serializer makes it), and the codes of black of
+ * the picture that their DM header describes: the YCCtoRGB offsets of its first packet (bytes 20
+ * to 31 of the metadata structure, in units of 2^28 of the signal's range), T' = 0, as the source
+ * transport takes them (dvbridge_source_setup()): 256, 2048, 2048 for the converted transport. */
+#ifndef DVBRIDGE_EOS_H
+#define DVBRIDGE_EOS_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+static inline uint32_t dvbridge_eos_crc(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffff;
+    for (size_t j = 0; j < n; j++) {
+        c ^= (uint32_t)p[j] << 24;
+        for (int i = 0; i < 8; i++)
+            c = (c << 1) ^ ((c >> 31) ? 0x04c11db7u : 0);
+    }
+    return c;
+}
+
+/* False, with nothing written, where the packets are not those of a frame: none or more than 16,
+ * a CRC that does not check, a first packet that is not the first of a structure (packet_type 0b00
+ * or 0b01), a header of another metadata type or version, or an offset beyond the codes of the
+ * signal. */
+static inline bool dvbridge_eos_packets(const uint32_t *in, unsigned count, uint32_t *out,
+                                        unsigned black[3])
+{
+    if (!in || !out || !black || count == 0 || count > 16)
+        return false;
+    uint8_t packets[16][128];
+    for (unsigned i = 0; i < count; i++) {
+        uint8_t *p = packets[i];
+        for (unsigned j = 0; j < 32; j++) {
+            const uint32_t w = in[i * 32 + j];
+            p[4 * j] = (uint8_t)(w >> 24);
+            p[4 * j + 1] = (uint8_t)(w >> 16);
+            p[4 * j + 2] = (uint8_t)(w >> 8);
+            p[4 * j + 3] = (uint8_t)w;
+        }
+        if (dvbridge_eos_crc(p, 128) != 0 || (p[0] & 0x3f) != 0)
+            return false;
+    }
+    if ((packets[0][0] >> 6) > 1)
+        return false;
+    unsigned codes[3];
+    for (unsigned k = 0; k < 3; k++) {
+        const uint8_t *o = packets[0] + 5 + 20 + 4 * k;
+        const uint64_t offset =
+            (uint64_t)o[0] << 24 | (uint64_t)o[1] << 16 | (uint64_t)o[2] << 8 | o[3];
+        codes[k] = (unsigned)(((offset << 12) + (1u << 27)) >> 28);
+        if (codes[k] > 4095)
+            return false;
+    }
+    for (unsigned i = 0; i < count; i++) {
+        uint8_t *p = packets[i];
+        p[2] |= 1;
+        const uint32_t crc = dvbridge_eos_crc(p, 124);
+        for (int j = 0; j < 4; j++)
+            p[124 + j] = (uint8_t)(crc >> (24 - j * 8));
+        for (unsigned j = 0; j < 32; j++)
+            out[i * 32 + j] = (uint32_t)p[4 * j] << 24 | (uint32_t)p[4 * j + 1] << 16 |
+                              (uint32_t)p[4 * j + 2] << 8 | p[4 * j + 3];
+    }
+    for (unsigned k = 0; k < 3; k++)
+        black[k] = codes[k];
+    return true;
+}
+#endif
diff --git a/tools/dvbridge/dvbridge_gl_pack.c b/tools/dvbridge/dvbridge_gl_pack.c
index f86c18c..306e66c 100644
--- a/tools/dvbridge/dvbridge_gl_pack.c
+++ b/tools/dvbridge/dvbridge_gl_pack.c
@@ -532,3 +532,126 @@ restore:
     dvbridge_gl_state_restore(&state);
     return ok && glGetError() == GL_NO_ERROR;
 }
+
+/* Hades: the fragment shader of dvbridge_gl_eos_draw(): pack_gles300.frag with the codes of black
+ * in place of a picture */
+static const char EOS_FRAGMENT[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform uvec4 metadata_words[128];\n"
+    "uniform uint packet_count;\n"
+    "uniform uint flip_y;\n"
+    "uniform uvec3 black;\n"
+    "out vec4 color;\n"
+    "uint parity(uint value)\n"
+    "{\n"
+    "    value ^= value >> 16u;\n"
+    "    value ^= value >> 8u;\n"
+    "    value ^= value >> 4u;\n"
+    "    value ^= value >> 2u;\n"
+    "    value ^= value >> 1u;\n"
+    "    return value & 1u;\n"
+    "}\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    if (flip_y != 0u) p.y = 2159 - p.y;\n"
+    "    uint y = black.x;\n"
+    "    uint c = (p.x & 1) == 0 ? black.y : black.z;\n"
+    "    uint index = uint(p.y * 3840 + p.x);\n"
+    "    uint packet = index / 3072u;\n"
+    "    if (packet < packet_count)\n"
+    "    {\n"
+    "        uint bit = index % 1024u;\n"
+    "        uint word = packet * 32u + bit / 32u;\n"
+    "        uint value = (metadata_words[word / 4u][int(word % 4u)] >> (31u - bit % 32u)) & 1u;\n"
+    "        c = (c & 4094u) | (value ^ parity(c >> 1u) ^ parity(y));\n"
+    "    }\n"
+    "    float b = float((y & 15u) | ((c & 15u) << 4u));\n"
+    "    color = vec4(float(c >> 4u), float(y >> 4u), b, 255.0) / 255.0;\n"
+    "}\n";
+
+struct dvbridge_gl_eos {
+    GLuint program, vao;
+    GLint words, count, flip, black;
+};
+
+struct dvbridge_gl_eos *dvbridge_gl_eos_create(void)
+{
+    GLuint vs = compile(GL_VERTEX_SHADER, COPY_VERTEX, NULL, false);
+    GLuint fs = compile(GL_FRAGMENT_SHADER, EOS_FRAGMENT, NULL, false);
+    struct dvbridge_gl_eos *e = vs && fs ? calloc(1, sizeof(*e)) : NULL;
+    if (!e) {
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        return NULL;
+    }
+    e->program = glCreateProgram();
+    glAttachShader(e->program, vs);
+    glAttachShader(e->program, fs);
+    glLinkProgram(e->program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint linked;
+    glGetProgramiv(e->program, GL_LINK_STATUS, &linked);
+    e->words = glGetUniformLocation(e->program, "metadata_words");
+    e->count = glGetUniformLocation(e->program, "packet_count");
+    e->flip = glGetUniformLocation(e->program, "flip_y");
+    e->black = glGetUniformLocation(e->program, "black");
+    glGenVertexArrays(1, &e->vao);
+    if (!linked || e->words < 0 || e->count < 0 || e->flip < 0 || e->black < 0 || !e->vao) {
+        dvbridge_gl_eos_destroy(e);
+        return NULL;
+    }
+    return e;
+}
+
+void dvbridge_gl_eos_destroy(struct dvbridge_gl_eos *e)
+{
+    if (!e)
+        return;
+    glDeleteVertexArrays(1, &e->vao);
+    glDeleteProgram(e->program);
+    free(e);
+}
+
+bool dvbridge_gl_eos_draw(struct dvbridge_gl_eos *e, unsigned framebuffer, int width, int height,
+                          const uint32_t packets[512], unsigned count, const unsigned black[3],
+                          bool flip)
+{
+    if (!e || !packets || !black || !count || count > 16 || width != 3840 || height != 2160)
+        return false;
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+    struct dvbridge_gl_state state;
+    dvbridge_gl_state_save(&state);
+    for (unsigned i = 0; i < sizeof(STATE_CAPS) / sizeof(*STATE_CAPS); ++i)
+        glDisable(STATE_CAPS[i]);
+    bool ok = false;
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    GLint red, green, blue, samples, encoding;
+    glGetIntegerv(GL_RED_BITS, &red);
+    glGetIntegerv(GL_GREEN_BITS, &green);
+    glGetIntegerv(GL_BLUE_BITS, &blue);
+    glGetIntegerv(GL_SAMPLES, &samples);
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER,
+        framebuffer ? GL_COLOR_ATTACHMENT0 : GL_BACK,
+        GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE ||
+        red != 8 || green != 8 || blue != 8 || samples > 1 || encoding != GL_LINEAR)
+        goto restore;
+    glViewport(0, 0, width, height);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glUseProgram(e->program);
+    glBindVertexArray(e->vao);
+    glUniform4uiv(e->words, 128, packets);
+    glUniform1ui(e->count, count);
+    glUniform1ui(e->flip, flip);
+    glUniform3ui(e->black, black[0], black[1], black[2]);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    ok = glGetError() == GL_NO_ERROR;
+restore:
+    dvbridge_gl_state_restore(&state);
+    return ok && glGetError() == GL_NO_ERROR;
+}
