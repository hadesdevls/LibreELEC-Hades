diff --git a/xbmc/windowing/gbm/DVEndOfStream.h b/xbmc/windowing/gbm/DVEndOfStream.h
new file mode 100644
index 0000000..3a8dabe
--- /dev/null
+++ b/xbmc/windowing/gbm/DVEndOfStream.h
@@ -0,0 +1,30 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace DVBRIDGE
+{
+/*!
+ * \brief Hades: whether native output is left with one more transport frame that marks the end of
+ *        the signal (EOS, ETSI GS CCM 001 table 9: "the immediate next picture contains non-HDR
+ *        signal"): the packets of the last frame with EOS set, over black (dvbridge_eos.h), before
+ *        the commit that restores the output (CWinSystemGbmGLESContext::EndDVBridge())
+ *
+ * A comparison for a display, off by default (video/dveos, advancedsettings.xml): Hades sends EOS 0
+ * and leaves native output with the restoration alone, in one commit with the mode that Kodi sets
+ * next where it can. Only where the transport is on the output (a frame of it went out), not
+ * in Dolby Vision Low-Latency (no metadata in the picture), and once for each restoration (not
+ * again when one that was refused is tried again).
+ * \param setting video/dveos
+ */
+constexpr bool EndOfStreamFrame(bool setting, bool transportLive, bool lowLatency, bool sentAlready)
+{
+  return setting && transportLive && !lowLatency && !sentAlready;
+}
