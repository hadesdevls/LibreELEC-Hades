From e0e2cf7492867a5cd86b2fba28a7777c52242af9 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:22:37 +0000
Subject: [PATCH] StereoscopicsManager: the step to the next 3D mode gets past
 side by side where that is drawn over/under

Where the display takes frame packing, side by side is drawn over/under
(SetStereoMode()). "Next stereoscopic mode" from over/under asks for
side by side, which came out as over/under again: the mode in use, so
nothing was applied, at every press. Anaglyph, interlaced and monoscopic
could not be reached that way.

A step from over/under that would come out as over/under goes one mode
further. Where side by side is drawn as it is, the steps are Kodi's.
---
 xbmc/guilib/StereoscopicsManager.cpp | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/xbmc/guilib/StereoscopicsManager.cpp b/xbmc/guilib/StereoscopicsManager.cpp
index 3de09e8..7a739fc 100644
--- a/xbmc/guilib/StereoscopicsManager.cpp
+++ b/xbmc/guilib/StereoscopicsManager.cpp
@@ -425,15 +425,26 @@ bool CStereoscopicsManager::OnAction(const CAction &action)
 {
   RenderStereoMode mode = GetStereoMode();
 
+  // Hades: side by side is drawn over/under where that gives frame packing (SetStereoMode()).
+  // A step from over/under to side by side would then come out as the mode in use, and the
+  // steps would never get past it: such a step goes one mode further.
+  const auto stepFrom = [this, mode](int step)
+  {
+    RenderStereoMode next = GetNextSupportedStereoMode(mode, step);
+    if (next == RenderStereoMode::SPLIT_VERTICAL && mode == RenderStereoMode::SPLIT_HORIZONTAL &&
+        CServiceBroker::GetWinSystem()->GetStereoOutputArrangement(next) == mode)
+      next = GetNextSupportedStereoMode(next, step);
+    return next;
+  };
+
   if (action.GetID() == ACTION_STEREOMODE_NEXT)
   {
-    SetStereoModeByUser(GetNextSupportedStereoMode(mode));
+    SetStereoModeByUser(stepFrom(1));
     return true;
   }
   else if (action.GetID() == ACTION_STEREOMODE_PREVIOUS)
   {
-    SetStereoModeByUser(
-        GetNextSupportedStereoMode(mode, static_cast<int>(RenderStereoMode::COUNT) - 1));
+    SetStereoModeByUser(stepFrom(static_cast<int>(RenderStereoMode::COUNT) - 1));
     return true;
   }
   else if (action.GetID() == ACTION_STEREOMODE_TOGGLE)
