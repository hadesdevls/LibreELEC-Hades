From 0dffa8b64133b499f907d8673cd310336af5ea36 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:36:03 +0000
Subject: [PATCH] windowing: a resolution can have a 3D output while the eyes
 are drawn split

A display that takes 3D over HDMI is told of the layout of the two eyes
by the mode it is given in. Such a mode is not a resolution that Kodi
chooses: it is the timing of one, or the 3D timing that goes with it,
sent another way. Kodi had one place for it, the list of resolutions,
where a 3D mode is one more entry that the GUI, the adjustment of the
refresh rate and the whitelist can land on.

The window system can now say, when a resolution is set while the eyes
are drawn one above the other or side by side, which mode to set instead
(CWinSystemBase::GetStereoOutputMode(); no window system does yet). The
resolution stays the one that Kodi chose. CGraphicContext keeps the
answer and
- sets that mode (SetVideoResolutionInternal());
- draws by it: GetResInfo() without a resolution, which is what the GUI
  and the renderers ask, tells of that frame, of one eye of it in a
  split mode, through the statements that already do this for a mode
  that has the layout in its flags and lines between the eyes;
- tells of the list as before where a resolution is named
  (GetResInfo(res)): the search for a resolution, the whitelist and the
  comparison of two resolutions see no 3D output;
- does not store what is calibrated in a frame that is not the one of
  the resolution (SetResInfo()).

The window system is not asked while another stereoscopic mode waits for
the next frame: the resolution is set again for that one, and a display
that is leaving 3D is not given one more 3D mode on the way.

Without a 3D output, which is every case until a window system has one,
the statements that ran before run as before: UpdateStereoOutput()
returns at once when the eyes are not drawn split and nothing is kept,
and the other three places test one flag that is not set.

Also here, for the commit that uses it: GetStereoOutputArrangement().

Not covered: a calibration made while a frame-packed output is on is
not kept (a subtitle position moved by hand goes back).

Read and compiled (syntax check of GraphicContext.cpp and WinSystem.cpp
with the commands of the last build). Not run.
---
 xbmc/windowing/GraphicContext.cpp | 94 ++++++++++++++++++++++++++++++-
 xbmc/windowing/GraphicContext.h   | 31 ++++++++++
 xbmc/windowing/WinSystem.h        | 32 +++++++++++
 3 files changed, 155 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/GraphicContext.cpp b/xbmc/windowing/GraphicContext.cpp
index 482b8a9..42c1d54 100644
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -28,6 +28,7 @@
 
 #include <cassert>
 #include <mutex>
+#include <utility>
 
 using KODI::UTILS::COLOR::Color;
 
@@ -436,8 +437,14 @@ void CGraphicContext::SetVideoResolutionInternal(RESOLUTION res, bool forceUpdat
   int origScreenHeight = m_iScreenHeight;
   float origFPSOverride = m_fFPSOverride;
 
+  // Hades: the 3D output of this resolution, where the eyes are drawn split and the window
+  // system has one for it. Asked before the sizes are worked out, which are those of an eye
+  // in that output; it is then the mode that is set.
+  const std::optional<StereoOutput> origStereoOutput = UpdateStereoOutput(res);
+
   UpdateInternalStateWithResolution(res);
   RESOLUTION_INFO info_org  = CDisplaySettings::GetInstance().GetResolutionInfo(res);
+  GetStereoOutputInfo(res, info_org);
 
   bool switched = false;
   if (CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_fullScreen)
@@ -474,6 +481,8 @@ void CGraphicContext::SetVideoResolutionInternal(RESOLUTION res, bool forceUpdat
     m_iScreenWidth = origScreenWidth;
     m_iScreenHeight = origScreenHeight;
     m_fFPSOverride = origFPSOverride;
+    if (origStereoOutput)
+      RestoreStereoOutput(*origStereoOutput);
     if (IsValidResolution(lastRes))
     {
       m_Resolution = lastRes;
@@ -527,7 +536,7 @@ void CGraphicContext::ApplyVideoResolution(RESOLUTION res)
 
 void CGraphicContext::UpdateInternalStateWithResolution(RESOLUTION res)
 {
-  RESOLUTION_INFO info_mod = GetResInfo(res);
+  RESOLUTION_INFO info_mod = ResInfo(res, true);
 
   m_iScreenWidth = info_mod.iWidth;
   m_iScreenHeight = info_mod.iHeight;
@@ -603,9 +612,20 @@ void CGraphicContext::ApplyStateBlock()
 }
 
 const RESOLUTION_INFO CGraphicContext::GetResInfo(RESOLUTION res) const
+{
+  return ResInfo(res, false);
+}
+
+const RESOLUTION_INFO CGraphicContext::ResInfo(RESOLUTION res, bool output) const
 {
   RESOLUTION_INFO info = CDisplaySettings::GetInstance().GetResolutionInfo(res);
 
+  // Hades: what is on the screen while the resolution has a 3D output is the frame of that
+  // output, of which the statements below make the part of one eye, as they do of any mode
+  // that has its layout in its flags
+  if (output)
+    GetStereoOutputInfo(res, info);
+
   if (m_stereoMode == RenderStereoMode::SPLIT_HORIZONTAL)
   {
     if((info.dwFlags & D3DPRESENTFLAG_MODE3DTB) == 0)
@@ -643,6 +663,11 @@ const RESOLUTION_INFO CGraphicContext::GetResInfo(RESOLUTION res) const
 
 void CGraphicContext::SetResInfo(RESOLUTION res, const RESOLUTION_INFO& info)
 {
+  // Hades: what is calibrated while the resolution is shown through a 3D output of another
+  // frame (GetResInfo() tells of that frame) is not a calibration of the resolution
+  if (HasForeignStereoOutput(res))
+    return;
+
   RESOLUTION_INFO& curr = CDisplaySettings::GetInstance().GetResolutionInfo(res);
   curr.Overscan   = info.Overscan;
   curr.iSubtitles = info.iSubtitles;
@@ -667,7 +692,72 @@ void CGraphicContext::SetResInfo(RESOLUTION res, const RESOLUTION_INFO& info)
 
 const RESOLUTION_INFO CGraphicContext::GetResInfo() const
 {
-  return GetResInfo(m_Resolution);
+  return ResInfo(m_Resolution, true);
+}
+
+std::optional<CGraphicContext::StereoOutput> CGraphicContext::UpdateStereoOutput(RESOLUTION res)
+{
+  // Only while the eyes are drawn split. Not while another way of drawing waits for the next
+  // frame (Flip()), for which the resolution is set once more: a display that is about to
+  // leave 3D is not given one more 3D mode first.
+  const bool wanted = (m_stereoMode == RenderStereoMode::SPLIT_HORIZONTAL ||
+                       m_stereoMode == RenderStereoMode::SPLIT_VERTICAL) &&
+                      m_nextStereoMode == m_stereoMode && res >= RES_DESKTOP;
+  if (!wanted && !m_stereoOutputSet)
+    return std::nullopt;
+
+  StereoOutput output;
+  if (wanted &&
+      CServiceBroker::GetWinSystem()->GetStereoOutputMode(res, m_stereoMode, output.info))
+  {
+    const RESOLUTION_INFO& entry = CDisplaySettings::GetInstance().GetResolutionInfo(res);
+    output.res = res;
+    output.mode = m_stereoMode;
+    output.foreign =
+        output.info.iWidth != entry.iWidth || output.info.iHeight != entry.iHeight ||
+        output.info.iBlanking != entry.iBlanking ||
+        ((output.info.dwFlags ^ entry.dwFlags) & D3DPRESENTFLAG_MODEMASK) != 0;
+  }
+
+  StereoOutput before;
+  {
+    std::unique_lock lock(m_stereoOutputLock);
+    before = std::exchange(m_stereoOutput, output);
+  }
+  m_stereoOutputSet = output.res != RES_INVALID;
+  return before;
+}
+
+void CGraphicContext::RestoreStereoOutput(const StereoOutput& output)
+{
+  {
+    std::unique_lock lock(m_stereoOutputLock);
+    m_stereoOutput = output;
+  }
+  m_stereoOutputSet = output.res != RES_INVALID;
+}
+
+bool CGraphicContext::GetStereoOutputInfo(RESOLUTION res, RESOLUTION_INFO& info) const
+{
+  if (!m_stereoOutputSet)
+    return false;
+
+  std::unique_lock lock(m_stereoOutputLock);
+  if (m_stereoOutput.res == RES_INVALID || m_stereoOutput.res != res ||
+      m_stereoOutput.mode != m_stereoMode)
+    return false;
+
+  info = m_stereoOutput.info;
+  return true;
+}
+
+bool CGraphicContext::HasForeignStereoOutput(RESOLUTION res) const
+{
+  if (!m_stereoOutputSet)
+    return false;
+
+  std::unique_lock lock(m_stereoOutputLock);
+  return m_stereoOutput.res != RES_INVALID && m_stereoOutput.res == res && m_stereoOutput.foreign;
 }
 
 void CGraphicContext::GetGUIScaling(const RESOLUTION_INFO &res, float &scaleX, float &scaleY, TransformMatrix *matrix /* = NULL */)
diff --git a/xbmc/windowing/GraphicContext.h b/xbmc/windowing/GraphicContext.h
index e31f777..15ac16d 100644
--- a/xbmc/windowing/GraphicContext.h
+++ b/xbmc/windowing/GraphicContext.h
@@ -15,6 +15,9 @@
 #include "utils/Geometry.h" // for CRect/CPoint
 #include "utils/TransformMatrix.h" // for the members m_guiTransform etc.
 
+#include <atomic>
+#include <mutex>
+#include <optional>
 #include <stack>
 #include <string>
 #include <vector>
@@ -78,7 +81,11 @@ public:
   void ApplyModeChange(RESOLUTION res);
   void ApplyWindowResize(int newWidth, int newHeight);
   RESOLUTION GetVideoResolution() const;
+  //! \brief What is on the screen: the resolution in use or, while it has a 3D output
+  //! (CWinSystemBase::GetStereoOutputMode()), that output. In a split stereoscopic mode, the
+  //! part of one eye.
   const RESOLUTION_INFO GetResInfo() const;
+  //! \brief What the list of resolutions says of one of them, whatever its output is now
   const RESOLUTION_INFO GetResInfo(RESOLUTION res) const;
   void SetResInfo(RESOLUTION res, const RESOLUTION_INFO& info);
 
@@ -225,6 +232,26 @@ protected:
   void SetVideoResolutionInternal(RESOLUTION res, bool forceUpdate);
   void ApplyVideoResolution(RESOLUTION res);
   void UpdateInternalStateWithResolution(RESOLUTION res);
+  //! \param output what is on the screen (GetResInfo()) rather than what the list says
+  const RESOLUTION_INFO ResInfo(RESOLUTION res, bool output) const;
+
+  //! Hades: the 3D output of a resolution (CWinSystemBase::GetStereoOutputMode())
+  struct StereoOutput
+  {
+    RESOLUTION res{RES_INVALID}; //!< RES_INVALID: there is none
+    RenderStereoMode mode{RenderStereoMode::OFF}; //!< the way of drawing it is the output of
+    RESOLUTION_INFO info;
+    //! It is another frame than the one of the resolution (frame packed, or of another size):
+    //! what is calibrated in it is not stored for the resolution
+    bool foreign{false};
+  };
+  //! Asks the window system for the 3D output of a resolution that is being set, and keeps it
+  //! \return what was kept before, when there was or is one: for a change that fails
+  std::optional<StereoOutput> UpdateStereoOutput(RESOLUTION res);
+  void RestoreStereoOutput(const StereoOutput& output);
+  //! \param[in,out] info replaced by the 3D output of the resolution, when it has one
+  bool GetStereoOutputInfo(RESOLUTION res, RESOLUTION_INFO& info) const;
+  bool HasForeignStereoOutput(RESOLUTION res) const;
 
   int m_iScreenHeight = 576;
   int m_iScreenWidth = 720;
@@ -269,6 +296,10 @@ protected:
   RenderStereoView m_stereoView = RenderStereoView::OFF;
   RenderStereoMode m_stereoMode = RenderStereoMode::OFF;
   RenderStereoMode m_nextStereoMode = RenderStereoMode::OFF;
+  //! Written by the thread that sets resolutions; read by any, m_stereoOutput under its lock
+  std::atomic<bool> m_stereoOutputSet{false};
+  mutable std::mutex m_stereoOutputLock;
+  StereoOutput m_stereoOutput;
 
   bool m_isTransferPQ{false};
   RENDER_ORDER m_renderOrder{RENDER_ORDER_ALL_BACK_TO_FRONT};
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index b1f88f1..9881dc7 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -16,6 +16,7 @@
 #include "cores/VideoPlayer/VideoRenderers/DebugInfo.h"
 #include "guilib/DirtyRegion.h"
 #include "guilib/DispResource.h"
+#include "rendering/RenderSystemTypes.h"
 #include "utils/DisplayInfo.h"
 #include "utils/HDRCapabilities.h"
 
@@ -212,6 +213,37 @@ public:
   REFRESHRATE DefaultRefreshRate(const std::vector<REFRESHRATE>& rates);
   virtual bool HasCalibration(const RESOLUTION_INFO& resInfo) { return true; }
 
+  /*!
+   * \brief Hades: the 3D output of a resolution, for as long as Kodi draws the two eyes of a
+   *        stereoscopic picture one above the other or side by side
+   *
+   * A display that takes 3D over HDMI knows the layout of what it is given from the mode it is
+   * given in. Such a mode is not a resolution of the list: it is how one of them is sent while
+   * the eyes are drawn that way. CGraphicContext asks when it sets a resolution, sets what it
+   * is told here instead, and draws by it (CGraphicContext::GetResInfo() without a
+   * resolution); the resolution that Kodi chose, and everything that chooses resolutions,
+   * stay as they are.
+   *
+   * \param res the resolution that is being set
+   * \param mode how the eyes are drawn: SPLIT_HORIZONTAL or SPLIT_VERTICAL
+   * \param[out] info the mode to set and to draw in: the whole frame, both eyes, with
+   *             iBlanking lines or columns between them and the layout in dwFlags
+   * \return whether there is one; without one the resolution is set as it always was
+   */
+  virtual bool GetStereoOutputMode(RESOLUTION res, RenderStereoMode mode, RESOLUTION_INFO& info)
+  {
+    return false;
+  }
+
+  /*!
+   * \brief Hades: how to draw the two eyes when they are asked for side by side
+   * \param wanted SPLIT_VERTICAL
+   * \return SPLIT_HORIZONTAL where the output takes the eyes one above the other in a layout
+   *         that keeps all of each eye (frame packing), which nothing drawn side by side can
+   *         be sent as; else what was asked for
+   */
+  virtual RenderStereoMode GetStereoOutputArrangement(RenderStereoMode wanted) { return wanted; }
+
   // text input interface
   virtual std::string GetClipboardText(void);
 
