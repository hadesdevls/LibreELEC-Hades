From 985b5493af56b9057df5686b1d9758a07d1a6368 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 21:29:07 +0000
Subject: [PATCH] tools/dvbridge: Dolby Vision Low-Latency may take the black
 of the source to the display's

The mapping of Low-Latency kept the black of the source. A display with
a raised black (a projector, an LCD without local dimming) then shows
what is just above black sunk into its own black: the player that maps
for it is asked for the display's black as well as its peak and gamut
(CoreELEC, its VSVDB overrides; read as data).

dvbridge_hdr10_mapping::black, in cd/m2 (0 by default, at most
DVBRIDGE_HDR10_BLACK_MAX, 1 cd/m2; of an HDR10 target only). The Low-
Latency output hook applies the black level lift of the EETF of ITU-R
BT.2390 (5.4.1: E3 = E2 + b (1 - E2)^4, with b the display's minimum on
the scale of the range) to each of R', G' and B' of the mapped picture,
in PQ over [0, the peak]: the black of the source goes to the display's
black, the rest rises less the brighter it is, the peak stays.

It is done there, after libplacebo's mapping, and not as the black of
libplacebo's target: a target black other than the source's turns
libplacebo's whole tone mapping on (pl_tone_map_params_noop() is false
with a black point to adapt) for a scene that fits the display, which
otherwise is not tone mapped at all; measured on the software bridge,
with a black of 0.0005 cd/m2 a saturated magenta (R' and B' 2979, G' 36
of 4095) came out with G' 2255, in a scene of the profile 7 test stream.

With no black, nothing changes: the picture and the packed Low-Latency
transport of four P7 FEL pictures are the same bytes as before (the
software bridge).
---
 tools/dvbridge/dvbridge_placebo.c |  5 ++++
 tools/dvbridge/dvbridge_placebo.h |  7 ++++++
 tools/dvbridge/dvbridge_render.c  | 39 +++++++++++++++++++++++++------
 tools/dvbridge/dvbridge_render.h  |  3 ++-
 4 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index ec8d82e..b43b720 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -145,6 +145,11 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     }
     if (m->curve != DVBRIDGE_HDR10_CURVE_SPLINE && m->curve != DVBRIDGE_HDR10_CURVE_BT2390)
         return false;
+    /* Hades: a black of the display, of an HDR10 target only, at most DVBRIDGE_HDR10_BLACK_MAX (and so
+     * far below the lowest peak); an SDR target keeps the black of BT.1886 */
+    if (!(m->black >= 0.0f && m->black <= DVBRIDGE_HDR10_BLACK_MAX) ||
+        (m->black > 0.0f && m->target != DVBRIDGE_HDR10_TARGET_HDR10))
+        return false;
     /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
     if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 &&
         (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamut != DVBRIDGE_HDR10_GAMUT_BT709))
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index 9f9474a..a91edff 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -80,7 +80,14 @@ struct dvbridge_hdr10_mapping {
     /* Hades: with DVBRIDGE_HDR10_GAMUT_CUSTOM, the gamut of the display: CIE 1931 xy of red,
      * green, blue and white, inside BT.2020 (of an HDR10 target only; see dvbridge_hdr10_custom_xy()) */
     float target_xy[8];
+    /* Hades: the black of the display, cd/m2, of an HDR10 target, for Dolby Vision Low-Latency: the black of the
+     * source is taken to it with the black level lift of ITU-R BT.2390, so that what is just above black does
+     * not sink into the display's own black (mask_low_latency() in dvbridge_render.c). 0: the black of the
+     * source kept, as before, bit for bit. At most DVBRIDGE_HDR10_BLACK_MAX. A mapping of a picture for output
+     * as HDR10 (dvbridge_render_hdr10_mapping()) does not apply it. */
+    float black;
 };
+#define DVBRIDGE_HDR10_BLACK_MAX 1.0f
 /* A mapping that dvbridge_render_hdr10_mapping() takes: off, or on with values it can use (an SDR
  * one in the gamut BT.709 only; Hades: one of DVBRIDGE_HDR10_GAMUT_CUSTOM to HDR10 only, with a
  * target_xy that is a gamut inside BT.2020). */
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index e7fe1cb..b134e69 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -164,10 +164,12 @@ struct active_mask {
     const uint32_t *packets;
     uint32_t count, flip;
     bool early_mask, early_called;
-    /* Hades: Low-Latency (mask_low_latency()): the display's peak in PQ, and the test pattern */
+    /* Hades: Low-Latency (mask_low_latency()): the display's peak in PQ, and the test pattern; and the display's
+     * black as a share of that peak in PQ (0: none, the black of the source kept) */
     bool low_latency;
     float peak;
     uint32_t pattern;
+    float black;
 };
 
 /* Hades: the area outside the active picture is written at the start of the shader, which a
@@ -328,22 +330,41 @@ static const char ll_pattern_header[] =
  * the active picture black, as mask_active_area() writes it; the test pattern in place of the picture
  * where it is asked for; and nothing above the peak of the display (in PQ), as the picture that goes out
  * as HDR10 mapped to a display is held (clamp_to_display()). A hook of its own, with its own
- * signatures: the shader of the other renders does not change. */
+ * signatures: the shader of the other renders does not change.
+ * Where the mapping has the display's black (dvbridge_hdr10_mapping::black), the black level lift of the
+ * EETF of ITU-R BT.2390 (5.4.1: E3 = E2 + b (1 - E2)^4, b the display's minimum on the scale of the
+ * range) on each of R', G' and B' of the mapped picture, in PQ over [0, the peak]: the black of the
+ * source goes to the display's black, what is above it rises less the brighter it is, and the peak
+ * stays (at a quarter of the peak in PQ the lift is a third of b; at the peak, 0); inside the active
+ * picture (and over the test pattern), the bars staying at code 0 as they do where they are written at
+ * the start of the shader and leave it before this hook (the bars written first: on the software bridge
+ * every pixel of the bars of four pictures stays at 0, and the black pixels inside the picture rise). It
+ * is applied here,
+ * after libplacebo's mapping, not as its target's black: that turns its whole tone mapping on for a
+ * scene that fits the display, which with a black of 0.0005 cd/m2 changed saturated highlights (a
+ * magenta of R' and B' 2979, G' 36 of 4095 came out with G' 2255: measured on the software bridge).
+ * Without a black the stage is as before. */
 static struct pl_hook_res mask_low_latency(struct active_mask *mask, const struct pl_hook_params *p)
 {
     struct pl_shader_var vars[] = {
         {.var = pl_var_vec4("dvbridge_active"), .data = mask->rect, .dynamic = true},
         {.var = pl_var_float("dvbridge_peak"), .data = &mask->peak, .dynamic = true},
-        {.var = pl_var_uint("dvbridge_pattern"), .data = &mask->pattern, .dynamic = true}};
+        {.var = pl_var_uint("dvbridge_pattern"), .data = &mask->pattern, .dynamic = true},
+        {.var = pl_var_float("dvbridge_black"), .data = &mask->black, .dynamic = true}};
     struct pl_custom_shader shader = {
         .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
         .header = ll_pattern_header,
-        .body = "if(gl_FragCoord.x < dvbridge_active.x || gl_FragCoord.x >= dvbridge_active.z || "
-                "gl_FragCoord.y < dvbridge_active.y || gl_FragCoord.y >= dvbridge_active.w) "
-                "color = vec4(0.0, 0.0, 0.0, 1.0);\n"
+        .body = "bool dvbridge_bar = gl_FragCoord.x < dvbridge_active.x || gl_FragCoord.x >= dvbridge_active.z || "
+                "gl_FragCoord.y < dvbridge_active.y || gl_FragCoord.y >= dvbridge_active.w;\n"
+                "if(dvbridge_bar) color = vec4(0.0, 0.0, 0.0, 1.0);\n"
                 "if(dvbridge_pattern != 0u) color.rgb = dvbridge_ll_pattern(gl_FragCoord.xy, dvbridge_peak);\n"
+                "if(dvbridge_black > 0.0 && (!dvbridge_bar || dvbridge_pattern != 0u)) {\n"
+                "    vec3 e = clamp(color.rgb / dvbridge_peak, 0.0, 1.0);\n"
+                "    vec3 f = 1.0 - e;\n"
+                "    color.rgb = (e + dvbridge_black * f * f * f * f) * dvbridge_peak;\n"
+                "}\n"
                 "color = vec4(min(clamp(color.rgb, 0.0, 1.0), vec3(dvbridge_peak)), " PICTURE_ALPHA ");",
-        .variables = vars, .num_variables = 3,
+        .variables = vars, .num_variables = 4,
         .description = "DV Low-Latency picture within the display's peak"};
     mask->failed = mask->failed || p->stage != PL_HOOK_OUTPUT ||
                    !bars_written_in_this_shader(mask, p) || !pl_shader_custom(p->sh, &shader);
@@ -1210,6 +1231,10 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
         params.color_map_params = &ll_color;
         mask.low_latency = true;
         mask.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->ll_mapping.peak);
+        /* (the display's black on the scale of [0, its peak] in PQ, mask_low_latency()) */
+        mask.black = r->ll_mapping.black > 0.0f
+                         ? pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->ll_mapping.black) / mask.peak
+                         : 0.0f;
         mask.pattern = r->ll_pattern;
     }
     /* Only a picture that is not scaled is one shader from its planes to the target. */
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index dd0b476..3e694c1 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -150,7 +150,8 @@ bool dvbridge_render_hdr10_mapping(struct dvbridge_renderer *renderer,
  * (DVBRIDGE_DV_LOW_LATENCY_LAB, NV_HDMI_DV_LOW_LATENCY). The player maps the picture to the display:
  * dvbridge_render_rgb() draws it mapped as dvbridge_render_hdr10() draws it with the same mapping (the
  * curve guided by each scene's level 1 metadata, the perceptual gamut mapping, the black of the source
- * kept, nothing above the display's peak), to the target that mapping gives: the peak and the gamut
+ * kept, or taken to the display's where the mapping has it (dvbridge_hdr10_mapping::black, BT.2390's black level
+ * lift), nothing above the display's peak), to the target that mapping gives: the peak and the gamut
  * of the display's Dolby VSVDB (DVBRIDGE_HDR10_GAMUT_CUSTOM). dvbridge_render_pack() packs it as
  * YCbCr 4:2:2 at 12 bits in the converted transport's layout, with no metadata in the chroma LSBs
  * (the display management is done). Only the composed way: dvbridge_render_packed() refuses, and
-- 
2.53.0

