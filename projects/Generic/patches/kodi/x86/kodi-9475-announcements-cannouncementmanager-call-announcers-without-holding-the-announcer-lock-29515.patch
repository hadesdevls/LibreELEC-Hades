From 27877ca8e82e4f1b28f33ba93cf477f00a9f1867 Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Fri, 9 Oct 2026 20:06:00 +0100
Subject: [PATCH] [Announcements][CAnnouncementManager] Call announcers without
 holding the announcer lock (#29515)

DoAnnounce() held m_announcersCritSection while it called every
announcer. An announcer that waits on another thread then deadlocks
against that thread registering an announcer of its own:
CGUIWindowSlideShow::Announce() closes its window on OnPlay, which waits
on the GUI thread, while the GUI thread, refreshing a container's
CDirectoryProvider, waits in AddAnnouncer() for the same lock. Both
stop for good, and so do JSON-RPC and every player thread that touches
the window manager.

Release the lock around each call and re-check that the announcer is
still registered before calling it. RemoveAnnouncer() now waits only
for a call in progress to the announcer being removed, so its owner can
still destroy it as soon as the call returns. An announcer removing
itself from inside its own call is not made to wait.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 02f40fc0c314b09e40c19349ef0b0961f385fe10)
---
 cmake/treedata/common/tests.txt               |   1 +
 xbmc/interfaces/AnnouncementManager.cpp       |  35 +++-
 xbmc/interfaces/AnnouncementManager.h         |   5 +
 xbmc/interfaces/test/CMakeLists.txt           |   3 +
 .../test/TestAnnouncementManager.cpp          | 195 ++++++++++++++++++
 5 files changed, 235 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/interfaces/test/CMakeLists.txt
 create mode 100644 xbmc/interfaces/test/TestAnnouncementManager.cpp

diff --git a/cmake/treedata/common/tests.txt b/cmake/treedata/common/tests.txt
index c1d6657..3a03cc3 100644
--- a/cmake/treedata/common/tests.txt
+++ b/cmake/treedata/common/tests.txt
@@ -31,6 +31,7 @@ xbmc/imagefiles/test              test/imagefiles
 xbmc/input/test                   test/input
 xbmc/input/keyboard/test          test/input/keyboard
 xbmc/input/keymaps/test           test/input/keymaps
+xbmc/interfaces/test              test/interfaces
 xbmc/interfaces/json-rpc/test     test/jsonrpc
 xbmc/interfaces/python/test       test/python
 xbmc/music/tags/test              test/music_tags
diff --git a/xbmc/interfaces/AnnouncementManager.cpp b/xbmc/interfaces/AnnouncementManager.cpp
index fe842b4..2a5c83f 100644
--- a/xbmc/interfaces/AnnouncementManager.cpp
+++ b/xbmc/interfaces/AnnouncementManager.cpp
@@ -22,6 +22,7 @@
 
 #include <memory>
 #include <mutex>
+#include <vector>
 
 #define LOOKUP_PROPERTY "database-lookup"
 
@@ -263,6 +264,11 @@ void CAnnouncementManager::RemoveAnnouncer(IAnnouncer *listener)
 
   std::unique_lock lock(m_announcersCritSection);
   m_announcers.erase(listener);
+
+  // Its owner may destroy it once this returns, so a call in progress elsewhere must finish
+  // first. An announcer removing itself from inside that call is on this thread.
+  if (!IsCurrentThread())
+    m_announced.wait(lock, [this, listener] { return m_announcing != listener; });
 }
 
 void CAnnouncementManager::Announce(AnnouncementFlag flag, const std::string& message)
@@ -343,14 +349,35 @@ void CAnnouncementManager::DoAnnounce(AnnouncementFlag flag,
 
   std::unique_lock lock(m_announcersCritSection);
 
-  // Make a copy of announcers. They may be removed or even remove themselves during execution of IAnnouncer::Announce()!
-  std::unordered_map<IAnnouncer*, int> announcers{m_announcers};
-  for (const auto& [announcer, flagMask] : announcers)
+  std::vector<IAnnouncer*> announcers;
+  announcers.reserve(m_announcers.size());
+  for (const auto& [announcer, flagMask] : m_announcers)
+    announcers.push_back(announcer);
+
+  for (IAnnouncer* announcer : announcers)
   {
-    if (flag & flagMask)
+    // Re-read: the list may have changed while the lock was released for the previous call.
+    const auto it = m_announcers.find(announcer);
+    if (it == m_announcers.end() || !(flag & it->second))
+      continue;
+
+    // The lock is released for the call. Announcers wait on other threads - closing a window
+    // waits on the GUI thread - and the GUI thread adds announcers of its own.
+    m_announcing = announcer;
+    try
     {
+      CSingleExit unlock(m_announcersCritSection);
       announcer->Announce(flag, sender, message, data);
     }
+    catch (...)
+    {
+      // An exception ends this thread; a removal waiting on the call must not wait for ever
+      m_announcing = nullptr;
+      m_announced.notifyAll();
+      throw;
+    }
+    m_announcing = nullptr;
+    m_announced.notifyAll();
   }
 }
 
diff --git a/xbmc/interfaces/AnnouncementManager.h b/xbmc/interfaces/AnnouncementManager.h
index 162a80d..37e96a6 100644
--- a/xbmc/interfaces/AnnouncementManager.h
+++ b/xbmc/interfaces/AnnouncementManager.h
@@ -9,6 +9,7 @@
 #pragma once
 
 #include "IAnnouncer.h"
+#include "threads/Condition.h"
 #include "threads/CriticalSection.h"
 #include "threads/Event.h"
 #include "threads/Thread.h"
@@ -92,5 +93,9 @@ namespace ANNOUNCEMENT
     CCriticalSection m_announcersCritSection;
     CCriticalSection m_queueCritSection;
     std::unordered_map<IAnnouncer*, int> m_announcers;
+
+    //! The announcer being called by DoAnnounce(), which runs without m_announcersCritSection.
+    IAnnouncer* m_announcing{nullptr};
+    XbmcThreads::ConditionVariable m_announced;
   };
 }
