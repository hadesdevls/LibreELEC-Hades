diff --git a/xbmc/interfaces/test/TestAnnouncementManager.cpp b/xbmc/interfaces/test/TestAnnouncementManager.cpp
new file mode 100644
index 0000000..6ea9f4b
--- /dev/null
+++ b/xbmc/interfaces/test/TestAnnouncementManager.cpp
@@ -0,0 +1,195 @@
+/*
