From 60b44f7c331dc2b57f0670919d5e0494210d2f74 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:30:35 +0000
Subject: [PATCH] DVDInputStreamBluray: the times of the disc's menus are not
 moved at a kept join

The join kept in navigation mode moved the time of each flush of the disc's own graphics by the offset of
its timeline, so that it would stay on the clock of its clip. No such time reaches the player. libbluray
flushes its menus (IG) with no time (-1: _render_page() and _render_effect() of its graphics
controller, the effects included), and its BD-J graphics too (bd_bdj_osd_cb()); the only flushes with a
time are those of the subtitles it draws itself (PG, pcs->pts, and text subtitles), which it draws only
with BLURAY_PLAYER_SETTING_DECODE_PG, which Kodi never sets (it decodes the subtitles itself). Read in
libbluray 1.5.0 with Hades' series. So the offset moved nothing, and the limit said for it (the graphics of
the first block of a kept play item timed on the clock before it) does not exist: what moved them goes.
---
 .../DVDInputStreams/DVDInputStreamBluray.cpp      | 15 ++++++---------
 .../DVDInputStreams/DVDInputStreamBluray.h        |  3 ---
 2 files changed, 6 insertions(+), 12 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
index 399a4b3..052adcc 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.cpp
@@ -324,7 +324,6 @@ bool CDVDInputStreamBluray::Open()
   m_clipSpans.Clear();
   m_navAnchor.reset();
   m_navKept.reset();
-  m_navOverlayOffset = 0;
   m_connections.clear();
   m_connectionsPlaylist = UINT32_MAX;
 
@@ -538,7 +537,6 @@ void CDVDInputStreamBluray::Close()
     m_connections.clear();
     m_connectionsPlaylist = UINT32_MAX;
   }
-  m_navOverlayOffset = 0;
 
 #if defined(HAS_UDFREAD)
   // Released last, as the files opened from the volume are closed above
@@ -1080,8 +1078,6 @@ void CDVDInputStreamBluray::NavPlayItem(uint32_t item)
   {
     // the bytes of this read are the first of the play item kept (counted after the event)
     m_clipSpans.Begin(m_readPos, m_navKept);
-    m_navOverlayOffset =
-        static_cast<int64_t>(m_navKept->startTime) - static_cast<int64_t>(m_navKept->inTime);
     m_navKept.reset();
     return;
   }
@@ -1089,7 +1085,6 @@ void CDVDInputStreamBluray::NavPlayItem(uint32_t item)
   // one a seek landed in): its packets keep the clock of its clip, as before, and the timeline of
   // the joins after it is on that clock
   m_clipSpans.Begin(m_readPos, std::nullopt);
-  m_navOverlayOffset = 0;
   if (m_titleInfo && item < m_titleInfo->clip_count)
     m_navAnchor = KODI::BLURAYTIMELINE::ClipTime{m_titleInfo->clips[item].in_time,
                                                  m_titleInfo->clips[item].start_time};
@@ -1102,7 +1097,6 @@ void CDVDInputStreamBluray::NavRestart()
   std::unique_lock lock(m_navTimelineLock);
   m_clipSpans.Clear();
   m_navKept.reset();
-  m_navOverlayOffset = 0;
   const uint32_t item = m_playItem;
   if (m_titleInfo && item < m_titleInfo->clip_count)
     m_navAnchor = KODI::BLURAYTIMELINE::ClipTime{m_titleInfo->clips[item].in_time,
@@ -1385,10 +1379,13 @@ void CDVDInputStreamBluray::OverlayCallback(const BD_OVERLAY * const ov)
     plane.o.push_back(overlay);
   }
 
-  // Hades: a time of the disc's graphics is on the clock of the clip being read: on the timeline,
-  // where a seamless join kept the streams, as the packets of that clip are (KeepStreamsAtJoin())
+  // (Hades: no time of these is on the clock of a clip, so a seamless join that keeps the streams
+  // moves none (KeepStreamsAtJoin()). libbluray flushes its menus (IG) with no time (-1: its
+  // graphics controller, _render_page() and _render_effect()); its only flushes with a time are
+  // those of the subtitles it draws itself (PG and text subtitles), which it draws only with
+  // BLURAY_PLAYER_SETTING_DECODE_PG, which Kodi never sets: Kodi decodes the subtitles itself.)
   if (ov->cmd == BD_OVERLAY_FLUSH)
-    OverlayFlush(ov->pts >= 0 ? ov->pts + m_navOverlayOffset.load() : ov->pts);
+    OverlayFlush(ov->pts);
 #endif
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
index ae10985..891a7eb 100644
--- a/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
+++ b/xbmc/cores/VideoPlayer/DVDInputStreams/DVDInputStreamBluray.h
@@ -537,9 +537,6 @@ protected:
     //! m_connectionsPlaylist: the events of the disc are also processed by the thread of the
     //! application (UserInput())
     mutable CCriticalSection m_navTimelineLock;
-    //! Hades: navigation mode, what the timeline adds to the clock of the clip being read, 90 kHz:
-    //! for the times of the disc's own graphics (OverlayCallback())
-    std::atomic<int64_t> m_navOverlayOffset{0};
     //! Hades: whether the demuxer reading puts its packets on the timeline (SetTimelineReader())
     std::atomic<bool> m_timelineReader{false};
     //! Hades: navigation mode, the connection condition of each play item of m_connectionsPlaylist
-- 
