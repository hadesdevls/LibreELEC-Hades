@@ -689,12 +724,24 @@ static const char PICTURE[] =
     "vec3 drawn_over(ivec2 p, vec4 d)\n"                                                          \
     "{\n"                                                                                         \
     "    float a = 2.0 - d.a;\n"                                                                  \
