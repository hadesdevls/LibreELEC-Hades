 bool dvbridge_render_compute_rows_usable(const struct dvbridge_renderer *renderer);
 /* Hades: which forms of pass 4 of the source transport take the even pixel's codes of a pair drawn
- * over from the invocation next to it (dvbridge_source_quad(): bit 0 the composited picture, bit 1
- * the GUI read in place); 0 without quad operations, and in the reference of a check of the bytes */
+ * over from the invocation next to it (dvbridge_source_quad(): bit 1, the GUI read in place; bit 0,
+ * the composited picture, is never set); 0 without quad operations, and in the reference of a check
+ * of the bytes */
 #define DVBRIDGE_RENDER_SOURCE_QUAD 1
