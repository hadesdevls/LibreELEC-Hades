+/* Hades: what the four invocations of a quad say together (any of them, all of them), from the
+ * quad operations of GL_KHR_shader_subgroup: each swaps with its horizontal and its vertical
+ * neighbour, outside any branch of its own. A decision taken on it is the same in the whole quad, so
+ * no invocation of a quad leaves the others before a swap (PAIR_CODES). Only in the programs with
+ * quad operations (DVBRIDGE_SOURCE_QUAD). */
+#define QUAD_HELPERS                                                                              \
+    "#ifdef DVBRIDGE_SOURCE_QUAD\n"                                                                \
+    "bool quad_any(bool b)\n"                                                                     \
+    "{\n"                                                                                         \
+    "    uint v = b ? 1u : 0u;\n"                                                                  \
+    "    v |= subgroupQuadSwapHorizontal(v);\n"                                                   \
+    "    v |= subgroupQuadSwapVertical(v);\n"                                                     \
+    "    return v != 0u;\n"                                                                       \
+    "}\n"                                                                                         \
+    "bool quad_all(bool b)\n"                                                                     \
+    "{\n"                                                                                         \
+    "    uint v = b ? 1u : 0u;\n"                                                                  \
+    "    v &= subgroupQuadSwapHorizontal(v);\n"                                                   \
+    "    v &= subgroupQuadSwapVertical(v);\n"                                                     \
+    "    return v != 0u;\n"                                                                       \
+    "}\n"                                                                                         \
+    "#endif\n"
+
 /* Hades: the codes of a pixel of pass 4 (its luma, and the chroma of its pair) from own, what is drawn
  * over it, and even, what is drawn over the even pixel of its pair (alpha 2: nothing), in PACK and
  * PACK_GUI. Where fragment shaders have the quad operations of GL_KHR_shader_subgroup
@@ -810,17 +880,27 @@ static const char PICTURE[] =
  * pixel takes what its even pixel made of it (the two chroma codes, and whether anything is drawn
  * over it) from the invocation next to it, instead of making the even pixel's picture again (EVEN:
  * the composite of the GUI, or a fetch of pass 3) and converting it again: a pair drawn over is made
- * and converted twice, not three or four times (a frame with nothing drawn over it is packed by PACK
- * as it is written). The swap is outside any branch, so that every invocation of the quad takes part
- * in it; what comes with it is tagged with the raster position it is of (below 2^24: exact in a
- * float), and where the invocation next to an odd pixel is not its even pixel, the odd pixel makes
- * it as before. The same expressions on the same values: the same codes, which a check of the bytes
- * compares with the form without quads (dvbridge_source_packer_create_plain()). The idea of handing
+ * and converted twice, not three or four times. Only PACK_GUI (the GUI read in place, where the GPU
+ * presents a frame ahead) is made so: PACK in that form (the picture composited first) measured no
+ * faster on zink (56.0 against 59.7 ms with a GUI over half the raster) and is made as written; its
+ * text keeps the form, which only DVBRIDGE_SOURCE_QUAD compiles. The swap is outside any branch, and
+ * no invocation of a quad takes another way than the others before it: what may be skipped (nothing
+ * drawn over, an opaque or a black GUI texel) is skipped only where the whole quad can skip it
+ * (quad_any(), quad_all()), the reads of the planes choose the value outside the picture after the
+ * fetch, and each pixel's own case is chosen after; a quad that went apart there showed wrong chroma
+ * on a few odd pixels in a software GPU. What comes with the swap is tagged with the raster position
+ * it is of (below 2^24: exact in a float), and where the invocation next to an odd pixel is not its
+ * even pixel, the odd pixel makes it as before. The same expressions on the same values: the
+ * same codes, which a check of the bytes compares with the form without quads (dvbridge_source_packer_create_plain()). The idea of handing
  * the pair's value through the quad is that of CroqueMr's composite of the GUI (CB1_GUI_QUAD,
  * cb1_composite_glsl.h); the form without it is the one PACK and PACK_GUI had. */
 #define PAIR_CODES(EVEN)                                                                          \
     "#ifdef DVBRIDGE_SOURCE_QUAD\n"                                                               \
-    "    vec3 mine = own.a != 2.0 ? drawn_over(p, own) : vec3(0.0);\n"                            \
+    "    bool some = quad_any(own.a != 2.0);\n"                                                    \
+    "    bool opaque = quad_all(own.a == 1.0);\n"                                                  \
+    "    vec3 mine = vec3(0.0);\n"                                                                 \
+    "    if (some)\n"                                                                              \
+    "        mine = opaque ? to_source(own.rgb) : drawn_over(p, own);\n"                           \
     "    vec4 got = subgroupQuadSwapHorizontal(vec4(mine.yz, own.a, float(p.y * 4096 + p.x)));\n"  \
     "    uint y = own.a != 2.0 ? code(mine.x) : luma_code(p);\n"                                  \
     "    vec3 e = mine;\n"                                                                        \
@@ -866,6 +946,7 @@ static const char PACK[] =
