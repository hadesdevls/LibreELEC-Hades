     "    if (g.a == 0.0)\n"                                                                       \
     "        return vec4(0.0, 0.0, 0.0, 2.0);\n"                                                  \
-    "    vec3 colour = gui_pq((bt709_to_bt2020 * srgb_to_linear(clamp(g.rgb, 0.0, 1.0))) * gui_peak);\n" \
+    /* (Hades: a black texel (the shade behind a panel, the border of a subtitle) is light 0, which \
+     * the sRGB EOTF, the matrix and the GUI white leave exactly +0: its PQ signal is gui_pq() of   \
+     * that 0, taken from the texel itself (its red, +0: a value no compiler can fold) and made once \
+     * for the three components: the same function of the same values, without the sRGB EOTF and   \
+     * with two powers of the nine. CroqueMr's composite skips that work for black GUI pixels too.) */ \
+    "    vec3 colour = all(equal(g.rgb, vec3(0.0)))\n"                                             \
+    "        ? vec3(gui_pq(vec3(g.r)).x)\n"                                                        \
+    "        : gui_pq((bt709_to_bt2020 * srgb_to_linear(clamp(g.rgb, 0.0, 1.0))) * gui_peak);\n"   \
     "    float a = g.a * g.a;\n"                                                                  \
+    /* (Hades: opaque, a = 1: the picture under it times 1 - a = 0 is nothing; not read) */       \
+    "    if (a == 1.0)\n"                                                                          \
+    "        return vec4(colour, 1.0);\n"                                                          \
     "    return vec4(colour * a + picture_at(p) * (1.0 - a), a + 2.0 * (1.0 - a));\n"             \
-    "}\n"
+    "}\n"                                                                                         \
+    /* (Hades: composited(), for the programs with quad operations: the same values, each saving   \
+     * taken only where the whole quad takes it (nothing drawn, black, opaque), and the pixel's own  \
+     * case chosen after, so that the quad keeps together until PAIR_CODES swaps its values) */     \
+    "#ifdef DVBRIDGE_SOURCE_QUAD\n"                                                                \
+    "vec4 composited_quad(ivec2 p)\n"                                                             \
+    "{\n"                                                                                         \
+    "    vec4 g = textureLod(gui, vec2((float(p.x) + 0.5) / 3840.0, 1.0 - (float(p.y) + 0.5) / 2160.0), 0.0);\n" \
+    "    vec4 r = vec4(0.0, 0.0, 0.0, 2.0);\n"                                                    \
+    "    if (quad_any(g.a != 0.0)) {\n"                                                           \
+    "        bool black = quad_all(all(equal(g.rgb, vec3(0.0))));\n"                              \
+    "        vec3 colour;\n"                                                                      \
+    "        if (black)\n"                                                                        \
+    "            colour = vec3(gui_pq(vec3(g.r)).x);\n"                                           \
+    "        else\n"                                                                              \
+    "            colour = gui_pq((bt709_to_bt2020 * srgb_to_linear(clamp(g.rgb, 0.0, 1.0))) * gui_peak);\n" \
+    "        float a = g.a * g.a;\n"                                                              \
+    "        bool opaque = quad_all(a == 1.0);\n"                                                 \
+    "        vec4 mixed;\n"                                                                       \
+    "        if (opaque)\n"                                                                       \
+    "            mixed = vec4(colour, 1.0);\n"                                                    \
+    "        else\n"                                                                              \
+    "            mixed = vec4(colour * a + picture_at(p) * (1.0 - a), a + 2.0 * (1.0 - a));\n"    \
+    "        r = g.a == 0.0 ? vec4(0.0, 0.0, 0.0, 2.0) : mixed;\n"                                \
+    "    }\n"                                                                                     \
+    "    return r;\n"                                                                             \
+    "}\n"                                                                                         \
+    "#endif\n"
 
 static const char PACK_GUI[] =
     "#version 300 es\n"
     COMMON
+    QUAD_HELPERS
     GUI_COMPOSITE
     "uniform int has_layer, code_max;\n"
     "uniform mat3 ycc_inverse, lms_inverse;\n"
