From 42ee5488e565c7220bc6c5ba07c9fcdad8bd8eda Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:23:55 +0000
Subject: [PATCH] windowing/gbm: say once that a Dolby Vision frame could not
 take the GUI over its picture

A frame of native output whose picture has no framebuffer for the GUI to
be drawn into (CDVBridgeGLES::GetPQFramebuffer() gives none) is not
presented and counts as not shown, so that a lasting failure ends in the
ordinary output. It was counted without a word: two seconds of such
frames end native output with nothing in kodi.log but "Dolby Vision
frames could not be shown for two seconds". It is now said once a native
output, so that the next log of a video that falls back to HDR10 tells
this case apart from the others (the bridge's own reasons, the renderer's
stages, the driver's refusals, flips that do not come).
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 8 ++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   | 2 ++
 2 files changed, 10 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index fe01ae3..c167b23 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2083,6 +2083,12 @@ void CWinSystemGbmGLESContext::CompositeGui()
     {
       // The frame cannot carry the GUI: it is not presented, and it counts as not shown so that
       // a persistent failure ends in the ordinary output instead of a frozen picture.
+      // (Hades: said once a native output: such frames were counted without a word, and two seconds
+      // of them end native output with nothing else in the log)
+      if (!std::exchange(m_dvGuiTargetSaid, true))
+        CLog::Log(LOGWARNING, "DVBridge: a frame could not take the GUI over its picture (the "
+                              "picture of the frame has no framebuffer to draw into): it is not "
+                              "shown");
       m_dvFrame = false;
       DVBridgeFrameShown(false, m_dvFramePts);
       return;
@@ -4627,6 +4633,8 @@ void CWinSystemGbmGLESContext::DVNativeOutputBegins()
   }
   // Hades: whether its frames reach the display is found for this native output
   m_dvPresentStall.Reset();
+  // (and a frame that cannot take the GUI is told again in it)
+  m_dvGuiTargetSaid = false;
   // Hades: the warm-up and the check of the bytes, for this native output (its first frame)
   m_dvWarmed = false;
   m_dvExtraWork = false;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 059e69b..c4b91b1 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -452,6 +452,8 @@ private:
   bool m_dvGuiInPlaceSaid{false};
   //! Hades: ... or why it does not (the composite is not the exact one; said once)
   bool m_dvGuiInPlaceNotExactSaid{false};
+  //! Hades: a frame of this native output could not take the GUI over its picture (said once in it)
+  bool m_dvGuiTargetSaid{false};
   //! The transfer function the composite LUTs were created for (SetGuiCompositing())
   int m_compositeTransfer{0};
   //! A GUI white setting whose LUTs could not be created: not tried again until the setting returns
-- 
