From f0f2493b065781d98193ce97f5fd7599e397b9dd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] DVLayerMerge: count the enhancement packets dropped right
 after a seek

Enhancement packets that belong to no base packet are dropped and
counted, but the count did not say where: the few that a seek leaves
before the first joined access unit (expected, the layers do not start
at the same byte) look the same in the log as ones dropped in the
middle of a stream, which lose the enhancement layer until its next
random-access picture. Those before the first access unit joined after
the start or a seek are now counted apart (Counts::droppedFirst), and
the line of the counts in kodi.log gives them: "N enhancement packets
had no base packet (M of them before the first access unit joined after
the start or a seek)". After the case of CroqueMr's of an enhancement
layer whose first packets after a seek were lost.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp | 9 +++++----
 xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp   | 4 ++++
 xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h     | 3 +++
 3 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index 4e504c3..5a2ccbb 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -1589,11 +1589,12 @@ void CDVDDemuxFFmpeg::ReportDVLayers()
         counts.offsets, counts.unconfirmed);
   CLog::Log(LOGINFO,
             "CDVDDemuxFFmpeg: Dolby Vision in two tracks so far: {} access units joined and {} "
-            "without their enhancement layer; {} enhancement packets had no base packet and {} were "
-            "not unit streams; at most {} base and {} enhancement packets waited for the other "
-            "layer; the time of {} enhancement access units could not be used (they are presented "
+            "without their enhancement layer; {} enhancement packets had no base packet ({} of "
+            "them before the first access unit joined after the start or a seek) and {} were not "
+            "unit streams; at most {} base and {} enhancement packets waited for the other layer; "
+            "the time of {} enhancement access units could not be used (they are presented "
             "before the start time of the file){}",
-            counts.joined, counts.alone, counts.dropped, counts.malformed,
+            counts.joined, counts.alone, counts.dropped, counts.droppedFirst, counts.malformed,
             counts.waited, counts.queued, counts.unusable, offset);
 }
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
index 34da66d..699cad0 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
@@ -684,6 +684,7 @@ void CDVLayerMerge::Clear()
   m_silent = m_absent ? m_silentAfter : 0;
   m_end = false;
   // (Hades: the offset of the decoding times stays, and is checked again: CONFIRM)
+  m_joinedSinceClear = false;
 }
 
 void CDVLayerMerge::SetSilent(unsigned int packets)
@@ -1264,7 +1265,10 @@ bool CDVLayerMerge::Pop(AVPacket* packet, bool end)
     {
       av_packet_free(&it->packet);
       m_counts.dropped++;
+      if (!m_joinedSinceClear)
+        m_counts.droppedFirst++;
     }
+    m_joinedSinceClear = true;
     AVPacket* enhancement = match->packet;
     m_enhancement.waiting.erase(m_enhancement.waiting.begin(), match + 1);
 
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index 5c3844c..3e36b72 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -219,6 +219,8 @@ public:
     uint64_t unusable = 0; //!< joined packets whose LAYER_TIME the reader could not use
     size_t waited = 0; //!< the most base packets that waited when one was joined
     size_t queued = 0; //!< the most enhancement packets that waited when one was joined
+    //! Hades: of dropped, those before the first access unit joined after the start or a seek
+    uint64_t droppedFirst = 0;
     //! Hades: the decoding times of the enhancement track less those of the base track, in the
     //! time base of the base track, as last learned (0: none, or not learned; see CONFIRM)
     int64_t offset = 0;
@@ -452,5 +454,6 @@ private:
   bool m_layerRpu = false; //!< a packet of the second track had the RPU of a dual-layer stream
   bool m_verifyDone = false; //!< the packets said it (VERIFIED or REFUSED)
   int64_t m_offset = 0; //!< Hades: see CONFIRM
+  bool m_joinedSinceClear = false; //!< Hades: an access unit was joined since the last Clear()
   Counts m_counts;
 };
-- 
