+bool CRenderManager::UpdateProgressive(bool progressive)
+{
+  const bool next = m_progressiveSet ? (m_progressive && progressive) : progressive;
+  m_progressiveSet = true;
+  if (next == m_progressive)
+    return false;
+  CLog::Log(LOGDEBUG, "CRenderManager - the stream is {} progressive", next ? "now" : "no longer");
+  m_progressive = next;
+  return true;
+}
