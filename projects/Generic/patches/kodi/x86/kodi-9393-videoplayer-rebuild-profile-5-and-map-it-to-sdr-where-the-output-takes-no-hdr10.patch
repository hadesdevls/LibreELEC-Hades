diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 6553b5b..d6145ea 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -350,6 +350,70 @@ constexpr bool ConversionRepeats(bool sameRun, bool showsBase)
   return sameRun || !showsBase;
 }
 
+//! Hades: what the picture of a Dolby Vision stream that is not sent natively is reconstructed for
+enum class ConversionTarget
+{
+  NONE, //!< it is not: played as Kodi plays it
+  HDR10, //!< sent as HDR10 (ConversionEligible())
+  SDR, //!< mapped to an output that takes no HDR10 (SdrConversionEligible())
+};
+
+/*!
+ * \brief Hades: whether a Dolby Vision stream is reconstructed and mapped to SDR where the output
+ *        takes no HDR10 (an SDR display, the panel of a laptop, a TV without HDR, or HDR turned
+ *        off in the settings)
+ *
+ * Only one whose base layer is no picture by itself (BaseLayerIsNoPicture(): profile 5): played as
+ * Kodi plays it, its colours are wrong (green and purple), and the reconstruction is the only
+ * picture there is. It is then mapped to that output (BT.709, the BT.1886 EOTF, with the curve and
+ * the gamut mapping of the mapping to a display; DVBRIDGE_HDR10_TARGET_SDR). Every other stream
