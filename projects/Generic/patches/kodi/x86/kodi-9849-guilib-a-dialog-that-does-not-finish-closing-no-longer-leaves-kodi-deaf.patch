From 1fc33639d741bf1a9021d105a8ee96ceb8a8ef70 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:06:57 +0000
Subject: [PATCH] guilib: a dialog that does not finish closing no longer
 leaves Kodi deaf

While the topmost modal dialog plays its closing animation,
CGUIWindowManager::HandleAction() discards every action: keys of a
keyboard or a remote, the mouse, and the built-in functions that keymaps
ask for. Only CGUIWindow::AfterRender() finishes the closing, once the
animation has ended, and it runs only on a pass of the loop that draws
the interface; the animation only moves on in a pass that processes it.
While the interface is not processed (the display put to sleep) or not
drawn (the dirty-driven skip of CApplication::FrameMove() while a video
plays on a plane of its own), the dialog stays closing, and Kodi discards
everything for as long as that lasts. Issue #11 had "ignoring action 122,
because topmost modal dialog closing animation is running" about seven
times a second for at least ten minutes, starting just after the shutdown
menu had been opened.

When the dialog that made Kodi discard an action is still closing 3 s
after the first such action (the longest closing animation of Estuary
takes 400 ms, delay included), close it as AfterRender() would have, and
let the action go on as it would have gone after that. The warning that
says so gives the number of passes that processed and drew the interface
meanwhile, which tells why the closing did not end. Only on the
application thread; a closing that ends as usual is not touched, and the
warning of each discarded action is Kodi's, as before.

CClosingWatch only counts and decides; a test builds it on the host.
Why the closing of issue #11 did not end is not known: the logs attached
to it do not have those lines.
---
 xbmc/guilib/ClosingWatch.h       | 122 +++++++++++++++++++++++++++++++
 xbmc/guilib/GUIWindowManager.cpp |  36 +++++++++
 2 files changed, 158 insertions(+)
 create mode 100644 xbmc/guilib/ClosingWatch.h

diff --git a/xbmc/guilib/ClosingWatch.h b/xbmc/guilib/ClosingWatch.h
new file mode 100644
index 0000000..ad1d3d6
--- /dev/null
+++ b/xbmc/guilib/ClosingWatch.h
@@ -0,0 +1,122 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+/*!
+ * \brief Hades: a modal dialog that does not finish closing (CGUIWindowManager::HandleAction())
+ *
+ * While the topmost modal dialog plays its closing animation, Kodi discards every action (keys of
+ * a keyboard or a remote, the mouse, and the built-in functions that keymaps ask for), so that
+ * nothing reaches a dialog that is going away. Only CGUIWindow::AfterRender() finishes the closing,
+ * once the animation has ended, and it runs only on a pass of the loop that draws the interface
+ * (CApplication::Render()); the animation only moves on in a pass that processes it
+ * (CGUIWindowManager::Process()). While the interface is not processed (the display put to sleep:
+ * DPMS) or not drawn (while a video plays on a plane of its own and nothing in the interface
+ * changed: CApplication::FrameMove()), nothing finishes it. Issue #11 (RTX 3050, LG TV) had Kodi
+ * discard action 122, a built-in function, about seven times a second for at least ten minutes,
+ * starting just after the shutdown menu had been opened: for as long as that lasts, nothing that
+ * the user presses reaches Kodi.
+ *
+ * The longest closing animation of Estuary takes 400 ms, delay included. When the dialog that made Kodi discard an
+ * action is still closing STUCK after the first action that it made Kodi discard, it is closed at
+ * once, as AfterRender() would have closed it, and the action goes on as it would have gone after
+ * that. The log says how many times the interface was processed and drawn meanwhile, which tells
+ * why the closing did not end. Only the application thread uses it.
+ *
+ * This class only counts and decides; a test builds it on the host.
+ */
+class CClosingWatch
+{
+public:
+  using Clock = std::chrono::steady_clock;
+
+  //! how long a dialog may go on closing while it makes Kodi discard actions
+  static constexpr std::chrono::milliseconds STUCK{3000};
+  //! no dialog is watched
+  static constexpr int NONE = -1;
+
+  struct Verdict
+  {
+    bool close = false; //!< close the dialog now
+    long long ms = 0; //!< since the first action that it made Kodi discard
+    unsigned int ignored = 0; //!< actions that it made Kodi discard, this one included
+    uint64_t processed = 0; //!< passes of the loop that processed the interface meanwhile
+    uint64_t drawn = 0; //!< passes of the loop that drew the interface meanwhile
+
+    //! why the closing did not end, for the log
+    const char* Why() const
+    {
+      if (drawn > 0)
+        return "the interface was drawn, so its closing animation did not end";
+      if (processed > 0)
+        return "the interface was processed but not drawn, which is what finishes a closing";
+      return "the interface was not processed (the display asleep, or no pass of the loop)";
+    }
+  };
+
+  //! a pass of the loop processed the interface (CGUIWindowManager::Process())
+  void Processed() { ++m_processed; }
+  //! a pass of the loop drew the interface, and finished the closings that had ended
+  //! (CGUIWindowManager::AfterRender())
+  void Drawn() { ++m_drawn; }
+
+  //! the dialog that is watched, or NONE
+  int Watched() const { return m_id; }
+
+  //! the dialog id is not closing (it closed, or it opened again): it is no longer watched
+  void NotClosing(int id)
+  {
+    if (id == m_id)
+      Reset();
+  }
+
+  //! Kodi discards an action because the dialog id is closing
+  Verdict Ignored(int id, Clock::time_point now)
+  {
+    if (id != m_id)
+    {
+      m_id = id;
+      m_since = now;
+      m_ignored = 1;
+      m_processedAt = m_processed;
+      m_drawnAt = m_drawn;
+      return {};
+    }
+    ++m_ignored;
+    const auto closing = now - m_since;
+    if (closing < STUCK)
+      return {};
+    Verdict verdict;
+    verdict.close = true;
+    verdict.ms = std::chrono::duration_cast<std::chrono::milliseconds>(closing).count();
+    verdict.ignored = m_ignored;
+    verdict.processed = m_processed - m_processedAt;
+    verdict.drawn = m_drawn - m_drawnAt;
+    Reset();
+    return verdict;
+  }
+
+  void Reset()
+  {
+    m_id = NONE;
+    m_ignored = 0;
+  }
+
+private:
+  int m_id = NONE;
+  Clock::time_point m_since;
+  unsigned int m_ignored = 0;
+  uint64_t m_processed = 0;
+  uint64_t m_drawn = 0;
+  uint64_t m_processedAt = 0;
+  uint64_t m_drawnAt = 0;
+};
diff --git a/xbmc/guilib/GUIWindowManager.cpp b/xbmc/guilib/GUIWindowManager.cpp
index c7ef43a..539ae2c 100644
--- a/xbmc/guilib/GUIWindowManager.cpp
+++ b/xbmc/guilib/GUIWindowManager.cpp
@@ -8,6 +8,7 @@
 
 #include "GUIWindowManager.h"
 
+#include "ClosingWatch.h"
 #include "GUIAudioManager.h"
 #include "GUIDialog.h"
 #include "GUIInfoManager.h"
@@ -75,6 +76,10 @@ namespace
 {
 // buffers older than this are fully redrawn
 constexpr int MAX_BUFFER_AGE = 10;
+
+// Hades: the modal dialog that makes Kodi discard actions while it closes (there is one window
+// manager; only the application thread uses it)
+CClosingWatch s_closingWatch;
 } // namespace
 
 // Dialog includes
@@ -1274,6 +1279,27 @@ bool CGUIWindowManager::HandleAction(CAction const& action) const
         }
         return false;
       }
+      // Hades: a closing that does not end would leave Kodi deaf to every action (CClosingWatch)
+      if (CServiceBroker::GetAppMessenger()->IsProcessThread())
+      {
+        const auto verdict =
+            s_closingWatch.Ignored(dialog->GetID(), CClosingWatch::Clock::now());
+        if (verdict.close)
+        {
+          CLog::Log(LOGWARNING,
+                    "CGUIWindowManager - {} - window {} ({}) was still closing {} ms after the "
+                    "first action that it made Kodi ignore, {} actions ignored; meanwhile the "
+                    "interface was processed {} and drawn {} times: {}. It is closed now, so that "
+                    "action {} and those after it reach Kodi",
+                    __FUNCTION__, dialog->GetID(), dialog->GetProperty("xmlfile").asString(),
+                    verdict.ms, verdict.ignored, verdict.processed, verdict.drawn, verdict.Why(),
+                    action.GetID());
+          dialog->Close(true);
+          lock.lock();
+          topmost = m_activeDialogs.size(); // look again from the top
+          continue;
+        }
+      }
       CLog::Log(LOGWARNING,
                 "CGUIWindowManager - {} - ignoring action {}, because topmost modal dialog closing "
                 "animation is running",
@@ -1336,6 +1362,15 @@ void CGUIWindowManager::Process(unsigned int currentTime)
 
   for (auto& itr : m_dirtyregions)
     m_tracker.MarkDirtyRegion(itr);
+
+  // Hades: CClosingWatch (the dialog that it watches may have closed or opened again)
+  s_closingWatch.Processed();
+  if (const int watched = s_closingWatch.Watched(); watched != CClosingWatch::NONE)
+  {
+    CGUIWindow* dialog = GetWindow(watched);
+    if (!dialog || !dialog->IsDialogRunning() || !dialog->IsAnimating(ANIM_TYPE_WINDOW_CLOSE))
+      s_closingWatch.NotClosing(watched);
+  }
 }
 
 void CGUIWindowManager::MarkDirty()
@@ -1511,6 +1546,7 @@ bool CGUIWindowManager::Render()
 
 void CGUIWindowManager::AfterRender()
 {
+  s_closingWatch.Drawn(); // Hades: CClosingWatch
   CServiceBroker::GetWinSystem()->GetGfxContext().ResetDepth();
   CGUIWindow* pWindow = GetWindow(GetActiveWindow());
   if (pWindow)
