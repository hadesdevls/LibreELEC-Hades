From 78ddfc1e4e4fff96c301ec51b04c4a8679206da2 Mon Sep 17 00:00:00 2001
From: Martin Ellis <malard@gmail.com>
Date: Sun, 11 Oct 2026 18:29:35 +0100
Subject: [PATCH] [Video][CGUIWindowVideoBase] Let a video library path carry a
 filter, as a music library path does (#29654)

CGUIWindowVideoBase::CanContainFilter passed "videodb://" to URIUtils::IsProtocol, which appends
"://" itself, so it tested for "videodb://://" and has returned false since 5b4593e7d8 (2014). The
media window therefore never removed a filter from a videodb:// path before listing it, kept it
in the history key, or re-applied it from the path, all of which it does for musicdb:// paths.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e33ba5aeed5384cd63ef0b117bf2a6c80e54dd6d)
---
 xbmc/video/test/CMakeLists.txt             |  1 +
 xbmc/video/test/TestGUIWindowVideoBase.cpp | 33 ++++++++++++++++++++++
 xbmc/video/windows/GUIWindowVideoBase.cpp  |  2 +-
 3 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/video/test/TestGUIWindowVideoBase.cpp

diff --git a/xbmc/video/test/CMakeLists.txt b/xbmc/video/test/CMakeLists.txt
index c01c202..4c6b975 100644
--- a/xbmc/video/test/CMakeLists.txt
+++ b/xbmc/video/test/CMakeLists.txt
@@ -1,5 +1,6 @@
 set(SOURCES TestBookmark.cpp
             TestFilenameAttributes.cpp
+            TestGUIWindowVideoBase.cpp
             TestPlayerControllerActions.cpp
             TestSetInfoTag.cpp
             TestStacks.cpp
diff --git a/xbmc/video/test/TestGUIWindowVideoBase.cpp b/xbmc/video/test/TestGUIWindowVideoBase.cpp
new file mode 100644
index 0000000..e538eac
--- /dev/null
+++ b/xbmc/video/test/TestGUIWindowVideoBase.cpp
@@ -0,0 +1,33 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "guilib/WindowIDs.h"
+#include "video/windows/GUIWindowVideoBase.h"
+
+#include <gtest/gtest.h>
+
+namespace
+{
+// The video library windows' own view states need a GUI, so this takes the general one
+class CTestGUIWindowVideoBase : public CGUIWindowVideoBase
+{
+public:
+  CTestGUIWindowVideoBase() : CGUIWindowVideoBase(WINDOW_INVALID, "") {}
+
+  using CGUIWindowVideoBase::CanContainFilter;
+};
+} // namespace
+
+TEST(TestGUIWindowVideoBase, AVideoLibraryPathCanCarryAFilter)
+{
+  CTestGUIWindowVideoBase window;
+  EXPECT_TRUE(window.CanContainFilter("videodb://movies/titles/"));
+  EXPECT_TRUE(window.CanContainFilter("videodb://tvshows/genres/1/"));
+  EXPECT_FALSE(window.CanContainFilter("musicdb://albums/"));
+  EXPECT_FALSE(window.CanContainFilter("smb://server/films/"));
+}
diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index 96f1c1b..9b1ee95 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -1306,7 +1306,7 @@ bool CGUIWindowVideoBase::CheckFilterAdvanced(CFileItemList &items) const
 
 bool CGUIWindowVideoBase::CanContainFilter(const std::string &strDirectory) const
 {
-  return URIUtils::IsProtocol(strDirectory, "videodb://");
+  return URIUtils::IsVideoDb(strDirectory);
 }
 
 /// \brief Search the current directory for a string got from the virtual keyboard
