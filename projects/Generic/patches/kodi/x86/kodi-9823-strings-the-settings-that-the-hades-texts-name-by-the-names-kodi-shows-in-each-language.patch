 .../resource.language.en_gb/strings.po        |  6 ++--
 .../resource.language.es_ar/strings.po        | 22 +++++++-------
 .../resource.language.es_es/strings.po        | 30 +++++++++----------
 .../resource.language.es_mx/strings.po        | 20 ++++++-------
 5 files changed, 42 insertions(+), 42 deletions(-)

