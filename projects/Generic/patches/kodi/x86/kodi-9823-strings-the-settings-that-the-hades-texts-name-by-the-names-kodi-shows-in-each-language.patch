 #. Hades, value of setting "videoscreen.hadesdvpathmode"; the core string #39967
@@ -2157,8 +2157,8 @@ msgstr "Algunas entradas de tele ofrecen Dolby Vision solo como Low-Latency (su
 #: xbmc/windowing/gbm/WinSystemGbm.cpp
