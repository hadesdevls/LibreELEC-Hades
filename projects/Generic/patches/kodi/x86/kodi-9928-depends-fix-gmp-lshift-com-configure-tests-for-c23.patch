From 80157d5e484a97d9e24239fa23dcf0339495a36a Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 2 Nov 2026 11:02:38 -0800
Subject: [PATCH] [depends] Fix GMP lshift_com configure tests for C23

GMP 6.3.0 uses K&R-style function definitions in two lshift_com
compiler probes, which Clang rejects with -std=gnu23.

Convert both definitions to prototype-style syntax so GMP's compiler
detection succeeds with newer C standards.
---
 .../target/gmp/0002-lshift-com-C23.patch      | 31 +++++++++++++++++++
 tools/depends/target/gmp/Makefile             |  4 ++-
 2 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 tools/depends/target/gmp/0002-lshift-com-C23.patch

diff --git a/tools/depends/target/gmp/0002-lshift-com-C23.patch b/tools/depends/target/gmp/0002-lshift-com-C23.patch
new file mode 100644
index 0000000..5b432c2
--- /dev/null
+++ b/tools/depends/target/gmp/0002-lshift-com-C23.patch
@@ -0,0 +1,31 @@
+From: Kodi depends
+Subject: [PATCH] gmp: Fix lshift_com configure tests for C23
+
+GMP 6.3.0 uses K&R-style definitions in two compiler probes, which Clang
+rejects in -std=gnu23 mode. Use equivalent prototype-style definitions.
+
+---
+--- a/acinclude.m4
++++ b/acinclude.m4
+@@ -661,9 +661,5 @@
+ #if ! defined (__cplusplus)
+ unsigned long
+-lshift_com (rp, up, n, cnt)
+-  unsigned long *rp;
+-  unsigned long *up;
+-  long n;
+-  unsigned cnt;
++lshift_com (unsigned long *rp, unsigned long *up, long n, unsigned cnt)
+ {
+   unsigned long retval, high_limb, low_limb;
+@@ -712,9 +708,5 @@
+ #include <stdlib.h>
+ void
+-lshift_com (rp, up, n, cnt)
+-  unsigned long *rp;
+-  unsigned long *up;
+-  long n;
+-  unsigned cnt;
++lshift_com (unsigned long *rp, unsigned long *up, long n, unsigned cnt)
+ {
+   unsigned long high_limb, low_limb;
diff --git a/tools/depends/target/gmp/Makefile b/tools/depends/target/gmp/Makefile
index 8d7bb2a..e12178e 100644
--- a/tools/depends/target/gmp/Makefile
+++ b/tools/depends/target/gmp/Makefile
@@ -1,6 +1,7 @@
 include ../../Makefile.include GMP-VERSION ../../download-files.include
 DEPS = ../../Makefile.include Makefile GMP-VERSION ../../download-files.include \
-                                       0001-acinclude.m4-for-C23.patch
+                                       0001-acinclude.m4-for-C23.patch \
+                                       0002-lshift-com-C23.patch
 
 # ABI selection
 ifeq ($(OS),linux)
@@ -40,6 +41,7 @@ $(PLATFORM)/config.status: $(DEPS) | $(TARBALLS_LOCATION)/$(ARCHIVE).$(HASH_TYPE
 	rm -rf $(PLATFORM)/*; mkdir -p $(PLATFORM)
 	cd $(PLATFORM); $(ARCHIVE_TOOL) $(ARCHIVE_TOOL_FLAGS) $(TARBALLS_LOCATION)/$(ARCHIVE)
 	cd $(PLATFORM); patch -p1 -i ../0001-acinclude.m4-for-C23.patch
+	cd $(PLATFORM); patch -p1 -i ../0002-lshift-com-C23.patch
 	cd $(PLATFORM); $(AUTORECONF) -vif
 	cd $(PLATFORM); $(CONFIGURE)
 
-- 
2.53.0

