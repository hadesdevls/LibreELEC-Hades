From 86bedc65b58aa37cbd4836fa2831d2f5a058bf31 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:00:33 +0000
Subject: [PATCH] [depends] libdvdcss: read CPXM discs that have no decryption
 set up

libdvdcss 1.6.0 is its latest release. On its master branch on
code.videolan.org (head 811ce97a1d4d, checked with ls-remote) the only
commit after 1.6.0 that changes the library is this one; the others
are CI and meson warning options. It goes on top as a tools/depends
patch, the upstream git format-patch of its commit with its author,
date and message, listed in FindLibDvdCSS.cmake and the Makefile after
the existing patches, for every platform.

- 05 811ce97a  CPXM: read discs that have no decryption set up

dvdcpxm_read() and dvdcpxm_readv() returned -1 on every read with
DVDCSS_READ_DECRYPT when the disc had no CPXM decryption set up
(dvdcss->cpxm NULL), so such a disc read nothing. Now they return the
blocks as read, as they already did for a read without the decrypt
flag. Discs whose CPXM decryption is set up, and CSS discs, take the
same path as before.

Checked: the patch applies to the archive the recipe hands Kodi
(libdvdcss-1.6.0, SHA256 as the recipe) after 01, and after 01 and 04,
with patch -p1 --fuzz=0; src/libdvdcpxm.c, patched, builds with the
compile command of the last image build, with the same warnings as
without it. 03-win-uwpfixes.patch (Windows Store only) does not apply
to 1.6.0 with or without this patch (a hunk of src/device.c); that is
older than this change and no Linux build uses it. Not run: a CPXM
disc.
---
 cmake/modules/FindLibDvdCSS.cmake             |  2 +
 ...discs-that-have-no-decryption-set-up.patch | 48 +++++++++++++++++++
 tools/depends/target/libdvdcss/Makefile       |  4 +-
 3 files changed, 53 insertions(+), 1 deletion(-)
 create mode 100644 tools/depends/target/libdvdcss/05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch

diff --git a/cmake/modules/FindLibDvdCSS.cmake b/cmake/modules/FindLibDvdCSS.cmake
index e1cc21b..0183e21 100644
--- a/cmake/modules/FindLibDvdCSS.cmake
+++ b/cmake/modules/FindLibDvdCSS.cmake
@@ -40,6 +40,8 @@ if(NOT TARGET LIBRARY::${CMAKE_FIND_PACKAGE_NAME})
       create_module_dev_env()
     endif()
 
+    list(APPEND patches "${CORE_SOURCE_DIR}/tools/depends/target/${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}/05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch")
+
     set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_libType static)
 
     generate_patchcommand("${patches}")
diff --git a/tools/depends/target/libdvdcss/05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch b/tools/depends/target/libdvdcss/05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch
new file mode 100644
index 0000000..3291d2b
--- /dev/null
+++ b/tools/depends/target/libdvdcss/05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch
@@ -0,0 +1,48 @@
+From 811ce97a1d4d1c9d936f4b2707f533a9ef768251 Mon Sep 17 00:00:00 2001
+From: Saifelden Mohamed Ismail <saifeldenmi@gmail.com>
+Date: Mon, 27 Jul 2026 23:22:47 +0300
+Subject: [PATCH] CPXM: read discs that have no decryption set up
+
+---
+ src/libdvdcpxm.c | 8 ++------
+ 1 file changed, 2 insertions(+), 6 deletions(-)
+
+diff --git a/src/libdvdcpxm.c b/src/libdvdcpxm.c
+index c318dfb..d28ff74 100644
+--- a/src/libdvdcpxm.c
++++ b/src/libdvdcpxm.c
+@@ -910,14 +910,12 @@ int dvdcpxm_read ( dvdcss_t dvdcss, void *p_buffer,
+     i_ret = dvdcss->pf_read( dvdcss, _p_buffer, i_blocks );
+ 
+     if( i_ret <= 0
++         || !dvdcss->cpxm
+          || !(i_flags & DVDCSS_READ_DECRYPT) )
+     {
+         return i_ret;
+     }
+ 
+-    if ( !dvdcss->cpxm )
+-        return -1;
+-
+     /* Decrypt the blocks we managed to read */
+     for( i_index = i_ret; i_index; i_index-- )
+     {
+@@ -946,14 +944,12 @@ int dvdcpxm_readv ( dvdcss_t dvdcss, void *p_iovec,
+     i_ret = dvdcss->pf_readv( dvdcss, _p_iovec, i_blocks );
+ 
+     if( i_ret <= 0
++         || !dvdcss->cpxm
+          || !(i_flags & DVDCSS_READ_DECRYPT) )
+     {
+         return i_ret;
+     }
+ 
+-    if ( !dvdcss->cpxm )
+-        return -1;
+-
+     /* Initialize loop for decryption */
+     iov_base = _p_iovec->iov_base;
+     iov_len = _p_iovec->iov_len;
+-- 
+2.53.0
+
diff --git a/tools/depends/target/libdvdcss/Makefile b/tools/depends/target/libdvdcss/Makefile
index 996e6d0..6198196 100644
--- a/tools/depends/target/libdvdcss/Makefile
+++ b/tools/depends/target/libdvdcss/Makefile
@@ -3,7 +3,8 @@ DEPS = ../../Makefile.include LIBDVDCSS-VERSION Makefile ../../download-files.in
                                   01-all-libc_read_improvement.patch \
                                   02-darwinembedded-enablebuild.patch \
                                   03-win-uwpfixes.patch \
-                                  04-win-open_wrapforce.patch
+                                  04-win-open_wrapforce.patch \
+                                  05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch
 
 MESON_BUILD_TYPE=release
 
@@ -49,6 +50,7 @@ ifeq ($(TARGET_PLATFORM),windows)
 	cd $(PLATFORM); patch -p1 -i ../03-win-uwpfixes.patch
 	cd $(PLATFORM); patch -p1 -i ../04-win-open_wrapforce.patch
 endif
+	cd $(PLATFORM); patch -p1 -i ../05-all-cpxm-read-discs-that-have-no-decryption-set-up.patch
 	cd $(PLATFORM); $(CONFIGURE)
 	touch $@
 
-- 
2.53.0

