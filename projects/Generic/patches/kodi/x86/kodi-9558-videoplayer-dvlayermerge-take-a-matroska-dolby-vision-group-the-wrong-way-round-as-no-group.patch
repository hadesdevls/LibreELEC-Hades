From b41c52e365aa8b5099110ae8a850fa7706b760ef Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:30:35 +0000
Subject: [PATCH] VideoPlayer: DVLayerMerge: take a Matroska Dolby Vision group
 the wrong way round as no group

libavformat groups two HEVC tracks of a Matroska file by their Dolby Vision
records alone: the track with the record of an enhancement layer (profile
7, enhancement layer present) is the enhancement layer, and the one other
HEVC track the base layer (matroskadec.c, matroska_parse_dovi_streams()).
A file whose record is on the base track alone is grouped the wrong way
round: its "enhancement" track is the larger one. Find() refused that
group for its size, and since libavformat had made a group, the rule for
the Matroska tracks that it does not group (two HEVC tracks of the sizes
of a pair, a pair only once their packets show it) was never tried: the
file played without Dolby Vision. A one-track Dolby Vision file (its
record says both layers) with a second HEVC track is grouped alike.

A Matroska group whose "enhancement" track has the size of a base layer of
which the other track is the enhancement layer is now not taken as a
group, and the two tracks go to that rule: unverified, the larger track as
the base, and a pair only if the first packets of the smaller one have an
RPU and the ones of the larger one none. So the first file is joined, and
the second is refused by its packets (its own track carries the RPUs) and
plays as it did. MP4, where a 'vdep' reference says which track is which,
and transport streams are as before. The idea of telling the layers apart
by their packets is the one of the change to libavformat in CroqueMr's
fork (PR #50); this is written for Kodi's join, in the rule it already
has.

Tested on the host (dvmerge_test, with a copy of the two-track FEL test
file whose record was moved to the base track, made by libavformat's own
Matroska muxer): before, both files were refused for their size; now the
first is found unverified and its packets make it a pair, joined to the
same 2875 access units as the file with the record, also after seeks, and
the second is refused by its packets before its first one comes out, every
packet as it is read. A group made here the wrong way round is found as
without a group in Matroska and still refused for its size in MP4. Every
other case of the test is as before.
---
 .../VideoPlayer/DVDDemuxers/DVLayerMerge.cpp  | 30 ++++++++++++++-----
 .../VideoPlayer/DVDDemuxers/DVLayerMerge.h    |  5 +++-
 2 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
index 0165cda..930eb45 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.cpp
@@ -237,11 +237,16 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
     return std::find(begin, end, static_cast<unsigned int>(stream->index)) != end;
   };
 
+  // Hades: the Dolby Vision groups of libavformat, and those of them that are two Matroska tracks the wrong way round
+  // (below)
+  unsigned int groups = 0;
+  unsigned int reversed = 0;
   for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
   {
     const AVStreamGroup* group = context->stream_groups[i];
     if (!group || group->type != AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
       continue;
+    ++groups;
     if (group->nb_streams != 2 || !group->params.layered_video ||
         group->params.layered_video->el_index > 1)
     {
@@ -307,6 +312,20 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
       if (container != Container::TRANSPORT_STREAM &&
           !EnhancementSize(b->width, b->height, e->width, e->height))
       {
+        // Hades: libavformat takes as the enhancement layer of two Matroska tracks the one with a record of an
+        // enhancement layer (matroskadec.c), and some files have that record on the base track alone: the group is
+        // then the wrong way round, the "enhancement" track of the size of a base layer whose enhancement layer the
+        // other one would be. A one-track Dolby Vision file (its record says both layers) with a second HEVC track
+        // is grouped alike. Neither is taken as the group: the two tracks are left to the rule for the Matroska
+        // files that libavformat does not group (below), which finds them unverified, with the larger track as the
+        // base, and makes them a pair only once their packets show it (the RPUs in the smaller track, none in the
+        // larger one): so the first file is joined, and the second plays as it did.
+        if (container == Container::MATROSKA &&
+            EnhancementSize(e->width, e->height, b->width, b->height))
+        {
+          ++reversed;
+          continue;
+        }
         layers.result = Layers::Result::WRONG_SIZE;
         refused = layers;
         continue;
@@ -363,15 +382,12 @@ CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int
   }
 
   // Matroska files that libavformat does not group (see the comment of Find() in the header):
-  // only where it made no Dolby Vision group at all.
+  // only where it made no Dolby Vision group at all (Hades: or only ones of two Matroska tracks
+  // the wrong way round).
   if (refused.result != Layers::Result::NONE)
     return refused;
-  for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
-  {
-    if (context->stream_groups[i] &&
-        context->stream_groups[i]->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
-      return refused;
-  }
+  if (groups > reversed)
+    return refused;
   if (container != Container::MATROSKA)
   {
     refused.reason = container == Container::MP4
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
index 1dab554..6e2de8b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVLayerMerge.h
@@ -133,7 +133,10 @@ public:
    * a Matroska file with exactly two HEVC tracks, one of the size of an enhancement layer of the
    * other, and no record that speaks against it, the pair is found unverified (Layers::verified):
    * it is one only if the first packets of the second track have an RPU, and the ones of the
-   * first track have none.
+   * first track have none. (Hades) So is a Matroska group the wrong way round, whose
+   * "enhancement" track is the larger one: libavformat takes the track with the record as the
+   * enhancement layer, and some files have the record on the base track alone (a one-track
+   * Dolby Vision file with a second HEVC track is grouped alike, and its packets refuse it).
    * \param program index of the program that plays; any other value: all streams play
    */
   static Layers Find(AVFormatContext* context, unsigned int program);
-- 
