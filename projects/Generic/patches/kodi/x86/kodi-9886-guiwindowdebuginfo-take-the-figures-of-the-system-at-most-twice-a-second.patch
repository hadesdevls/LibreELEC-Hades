From 912204260aceda4da6db8354ecb3338c6bee9970 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:07:18 +0000
Subject: [PATCH] GUIWindowDebugInfo: take the figures of the system at most
 twice a second

With debug logging (log level 2) the debug information is on screen, and it
built its text in every frame: the free memory, to the kB, changed it in
nearly every frame, and the window marked the GUI dirty with it. Over a
Dolby Vision or HDR picture, where a GUI with nothing dirty is not drawn
again (CDVGuiReuse), the GUI pass was then drawn in every frame, and
/proc/meminfo was read in every frame, just while a log was being taken to
see how the playback goes.

The figures of the system are now taken at most every 500 ms
(CDebugInfoSample, DebugInfoSample.h), at once when the window shows and
when the log level changes what it shows; in between the window shows the
text of the last ones. They change no faster: the load of the processors
is read again at most every 500 ms (CCPUInfo), Kodi's own every 3 s, the
frame rate once a second. The text is the same. What skin debugging adds
(the window, the position of the mouse, the focused control) is made in
every frame as before: it changes only when the user moves.

Tests (outside the tree): TestDebugInfoSample, the real header in a model
of the window (6 cases; one minute at 23.976, 50 and 60 Hz: 1438, 3000 and
3600 frames marked dirty before, 120 after; 7 mutants that it catches), and
a check of the wiring that fails on the tree before. In QEMU, on the idle
home screen with debug logging on, the GUI drew 18 to 39 frames a second
before (each one that the emulated GPU managed) and 5 to 13 after (the two
changes a second, each drawn again for the age of the buffers); with it
off, none in either. Pointed out by the CoreELEC build of SamuriHL
(820970fec9).
---
 xbmc/windows/DebugInfoSample.h      | 52 +++++++++++++++++++++++++++++
 xbmc/windows/GUIWindowDebugInfo.cpp | 18 +++++++---
 xbmc/windows/GUIWindowDebugInfo.h   |  6 ++++
 3 files changed, 72 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/windows/DebugInfoSample.h

diff --git a/xbmc/windows/DebugInfoSample.h b/xbmc/windows/DebugInfoSample.h
new file mode 100644
index 0000000..6fbe163
--- /dev/null
+++ b/xbmc/windows/DebugInfoSample.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \brief Hades: when the debug information on screen (CGUIWindowDebugInfo, shown with debug logging)
+ *        takes its figures of the system again
+ *
+ * Built in every frame, the free memory (to the kB) changed the text in nearly every frame, and the
+ * window marked the GUI dirty with it: the GUI was drawn again in every frame, over a Dolby Vision or
+ * HDR picture too, where a GUI with nothing dirty is otherwise not drawn again (CDVGuiReuse), and
+ * /proc/meminfo was read in every frame. That is when someone takes a log to measure the playback.
+ * The figures are taken at most every PERIOD_MS now: they change no faster anyway (the load of the
+ * processors is read again at most every 500 ms, CCPUInfo; Kodi's own every 3 s,
+ * CPosixResourceCounter; the frame rate once a second, CSystemGUIInfo::UpdateFPS()). They are taken at
+ * once the first time the window shows, and when what it shows changes (the log level up or down).
+ * The rest of the window (the position of the mouse and the focused control of skin debugging) is
+ * left as it was: it changes only when the user moves.
+ *
+ * This class only decides; a test builds it on the host.
+ */
+class CDebugInfoSample
+{
+public:
+  static constexpr unsigned int PERIOD_MS = 500;
+
+  //! Whether the figures are taken now, at \p now (the frame time, in ms), for a window that shows
+  //! those of the system or not (\p system); a sample that is taken is the last one from then on
+  bool Due(unsigned int now, bool system)
+  {
+    if (m_taken && system == m_system && now - m_at < PERIOD_MS)
+      return false;
+    m_taken = true;
+    m_system = system;
+    m_at = now;
+    return true;
+  }
+
+  //! The window closed: the figures are taken at once when it shows again
+  void Reset() { m_taken = false; }
+
+private:
+  bool m_taken{false};
+  bool m_system{false};
+  unsigned int m_at{0};
+};
diff --git a/xbmc/windows/GUIWindowDebugInfo.cpp b/xbmc/windows/GUIWindowDebugInfo.cpp
index f14b7e8..3a13255 100644
--- a/xbmc/windows/GUIWindowDebugInfo.cpp
+++ b/xbmc/windows/GUIWindowDebugInfo.cpp
@@ -58,6 +58,7 @@ bool CGUIWindowDebugInfo::OnMessage(CGUIMessage &message)
   {
     delete m_layout;
     m_layout = nullptr;
+    m_sample.Reset();
   }
   else if (message.GetMessage() == GUI_MSG_REFRESH_TIMER)
     MarkDirtyRegion();
@@ -69,8 +70,6 @@ void CGUIWindowDebugInfo::Process(unsigned int currentTime, CDirtyRegionList &di
 {
   CServiceBroker::GetWinSystem()->GetGfxContext().SetRenderingResolution(CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(), false);
 
-  CServiceBroker::GetCPUInfo()->GetUsedPercentage(); // must call it to recalculate pct values
-
   static int yShift = 20;
   static int xShift = 40;
   static unsigned int lastShift = time(nullptr);
@@ -94,8 +93,17 @@ void CGUIWindowDebugInfo::Process(unsigned int currentTime, CDirtyRegionList &di
   if (!m_layout)
     return;
 
-  std::string info;
-  if (LOG_LEVEL_DEBUG_FREEMEM <= CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_logLevel)
+  // Hades: the figures of the system are taken at most twice a second, at once when the window
+  // shows and when the log level changes what it shows; in between, the text of the last ones
+  // (CDebugInfoSample)
+  const bool system = LOG_LEVEL_DEBUG_FREEMEM <=
+                      CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_logLevel;
+  const bool sample = m_sample.Due(currentTime, system);
+  if (sample)
+    CServiceBroker::GetCPUInfo()->GetUsedPercentage(); // must call it to recalculate pct values
+
+  std::string info = sample ? std::string() : m_systemInfo;
+  if (sample && system)
   {
     KODI::MEMORY::MemoryStatus stat;
     KODI::MEMORY::GetMemoryStatus(&stat);
@@ -134,6 +142,8 @@ void CGUIWindowDebugInfo::Process(unsigned int currentTime, CDirtyRegionList &di
                                strCores, ucAppName, dCPU, profiling);
 #endif
   }
+  if (sample)
+    m_systemInfo = info;
 
   // render the skin debug info
   auto skin = CServiceBroker::GetGUI()->GetSkinInfo();
diff --git a/xbmc/windows/GUIWindowDebugInfo.h b/xbmc/windows/GUIWindowDebugInfo.h
index b29405c..6acce87 100644
--- a/xbmc/windows/GUIWindowDebugInfo.h
+++ b/xbmc/windows/GUIWindowDebugInfo.h
@@ -9,10 +9,13 @@
 #pragma once
 
 #include "guilib/GUIDialog.h"
+#include "windows/DebugInfoSample.h"
 #ifdef TARGET_POSIX
 #include "platform/posix/PosixResourceCounter.h"
 #endif
 
+#include <string>
+
 class CGUITextLayout;
 
 class CGUIWindowDebugInfo :
@@ -28,6 +31,9 @@ protected:
   void UpdateVisibility() override;
 private:
   CGUITextLayout *m_layout;
+  //! Hades: when the figures of the system are taken again, and the text of the last ones
+  CDebugInfoSample m_sample;
+  std::string m_systemInfo;
 #ifdef TARGET_POSIX
   CPosixResourceCounter m_resourceCounter;
 #endif
