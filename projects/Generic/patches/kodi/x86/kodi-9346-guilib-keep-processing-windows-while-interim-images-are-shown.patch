From 4928d67dabe03f75e54a2e5c7cd931a42740a558 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Fri, 16 Oct 2026 01:52:13 +0200
Subject: [PATCH] [guilib] Keep processing windows while interim images are
 shown

While the requested size of an image loads, another loaded size of the
same image can be shown in its place. The texture is still loading then,
but IsLoading() returned false, so with smart redraw the window could
stop being processed and keep showing the interim image until another
event.

(cherry picked from commit ca502c9ef4bf6bf0cbe02aec6a02b84ff34c9c8c)
---
 xbmc/guilib/GUITexture.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUITexture.h b/xbmc/guilib/GUITexture.h
index 1c50eab..239c6d4 100644
--- a/xbmc/guilib/GUITexture.h
+++ b/xbmc/guilib/GUITexture.h
@@ -127,7 +127,7 @@ public:
   {
     return m_isAllocated == NORMAL_FAILED || m_isAllocated == LARGE_FAILED;
   }
-  bool IsLoading() const { return m_isAllocated == LARGE && !m_texture.size(); }
+  bool IsLoading() const { return m_isAllocated == LARGE && (!m_texture.size() || m_largeInterim); }
   bool ReadyToRender() const;
 
 protected:
-- 
