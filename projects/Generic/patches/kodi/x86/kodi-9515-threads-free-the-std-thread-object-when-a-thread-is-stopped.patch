From c4689d050a83d35c4f6e477e84459da9aeb566b1 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Sun, 11 Oct 2026 11:52:55 +0100
Subject: [PATCH] threads: free the std::thread object when a thread is stopped

StopThread() cleared m_thread after joining but never deleted it, so
the std::thread allocated by Create() was leaked on every stop. The
destructor's delete cannot cover it: ~CThread calls StopThread() first,
which has already nulled the pointer.

Once the object is freed, a concurrent StopThread() or Join() that
cached the pointer before the lock was released could use or delete it
again, or, if the thread was restarted meanwhile and the new std::thread
reused the address, join or delete the replacement. Both now re-check
under m_CriticalSection that m_thread and a generation count bumped by
Create() still match what they cached, so only one caller deletes each
thread. Both also wait on a copy of the future taken under the lock,
which Create() now replaces under the lock, so a stopper never waits on
a replacement thread; StopThread() waits on its copy directly instead
of going through Join().

Found with valgrind on a Pi4; it was the only leak in Kodi's own code,
at 119 blocks after a short session, and it grows with thread churn.

(cherry picked from commit 8d805c2de597e6cc190bdce3ceae2f419b3d677b)
---
 xbmc/threads/Thread.cpp | 35 ++++++++++++++++++++++++++---------
 xbmc/threads/Thread.h   |  4 +++-
 2 files changed, 29 insertions(+), 10 deletions(-)

diff --git a/xbmc/threads/Thread.cpp b/xbmc/threads/Thread.cpp
index 7564d51..b1872e9 100644
--- a/xbmc/threads/Thread.cpp
+++ b/xbmc/threads/Thread.cpp
@@ -106,7 +106,6 @@ void CThread::Create(bool bAutoDelete)
   //std::unique_lock l(m_CriticalSection);
 
   std::promise<bool> prom;
-  m_future = prom.get_future();
 
   {
     // The std::thread internals must be set prior to the lambda doing
@@ -115,6 +114,8 @@ void CThread::Create(bool bAutoDelete)
     //   have the appropriate memory barrier behavior to accomplish the
     //   same thing so a full system mutex needs to be used.
     std::unique_lock blockLambdaTillDone(m_CriticalSection);
+    m_future = prom.get_future().share();
+    ++m_threadGeneration;
     m_thread = new std::thread([](CThread* pThread, std::promise<bool> promise)
     {
       try
@@ -220,12 +221,21 @@ void CThread::StopThread(bool bWait /*= true*/)
   m_StopEvent.Set();
   std::unique_lock lock(m_CriticalSection);
   std::thread* lthread = m_thread;
+  const uint64_t generation = m_threadGeneration;
+  const std::shared_future<bool> future = m_future;
   if (lthread != nullptr && bWait && !IsCurrentThread())
   {
     lock.unlock();
-    if (!Join(std::chrono::milliseconds::max())) // eh?
-      lthread->join();
-    m_thread = nullptr;
+    future.wait();
+    lock.lock();
+    // a concurrent StopThread() may already have joined and deleted it, or restarted the thread
+    if (m_thread == lthread && m_threadGeneration == generation)
+    {
+      if (lthread->joinable())
+        lthread->join();
+      m_thread = nullptr;
+      delete lthread;
+    }
   }
 }
 
@@ -253,6 +263,8 @@ bool CThread::Join(std::chrono::milliseconds duration)
 {
   std::unique_lock l(m_CriticalSection);
   std::thread* lthread = m_thread;
+  const uint64_t generation = m_threadGeneration;
+  const std::shared_future<bool> future = m_future;
   if (lthread != nullptr)
   {
     if (IsCurrentThread())
@@ -262,14 +274,19 @@ bool CThread::Join(std::chrono::milliseconds duration)
       CSingleExit exit(m_CriticalSection); // don't hold the thread lock while we're waiting
       // wait_for() overflows on a max() timeout and returns immediately
       if (duration == std::chrono::milliseconds::max())
-        m_future.wait();
-      else if (m_future.wait_for(duration) != std::future_status::ready)
+        future.wait();
+      else if (future.wait_for(duration) != std::future_status::ready)
         return false;
     }
 
-    // it's possible it's already joined since we released the lock above.
-    if (lthread->joinable())
-      m_thread->join();
+    // restarted by Create() while we waited, so the replacement thread is still running
+    if (m_threadGeneration != generation)
+      return false;
+
+    // it's possible it's already joined and deleted by StopThread() since we released the lock
+    // above.
+    if (m_thread == lthread && lthread->joinable())
+      lthread->join();
     return true;
   }
   else
diff --git a/xbmc/threads/Thread.h b/xbmc/threads/Thread.h
index c7a0ed4..c5bddfe 100644
--- a/xbmc/threads/Thread.h
+++ b/xbmc/threads/Thread.h
@@ -137,7 +137,9 @@ private:
 
   std::string m_ThreadName;
   std::thread* m_thread = nullptr;
-  std::future<bool> m_future;
+  // identifies m_thread across a restart, which may reuse the address of a deleted thread
+  uint64_t m_threadGeneration = 0;
+  std::shared_future<bool> m_future;
 
   std::unique_ptr<IThreadImpl> m_impl;
 };
-- 
