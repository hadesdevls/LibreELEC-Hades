From 671f8c64518403d979e6e89eac15f2523a8b8b9c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:55:00 +0000
Subject: [PATCH] GpuClockHold: another NVIDIA card asked for while one is held
 is held, and the first let go

The thread of the hold woke only when "wanted" changed. With the sound moved
from the HDMI of one NVIDIA card to that of another while HD audio plays (the
sink opens again for the new device, wanted all the while), Set() changed the
card and nothing happened: the clocks of the first card stayed locked and
those of the second were never locked, until the stream stopped. A stop and a
new start that the thread did not see in between did the same.

The thread now also wakes when the card that is wanted is not the one it
holds; the code for "another card than before" was there, and is now reached.

TestGpuClockHold.AnotherCardIsHeldAndTheFirstLetGo fails before (the first
card held, the second never) and passes after; the other ten tests pass.
---
 xbmc/cores/AudioEngine/Utils/GpuClockHold.h   |  9 ++-
 .../Utils/test/TestGpuClockHold.cpp           | 73 +++++++++++++++++++
 2 files changed, 81 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Utils/GpuClockHold.h b/xbmc/cores/AudioEngine/Utils/GpuClockHold.h
index ec79f63..54e29d6 100644
--- a/xbmc/cores/AudioEngine/Utils/GpuClockHold.h
+++ b/xbmc/cores/AudioEngine/Utils/GpuClockHold.h
@@ -583,7 +583,14 @@ private:
     std::unique_lock<std::mutex> lock(state->mutex);
     for (;;)
     {
-      state->cv.wait(lock, [&] { return state->stop || state->wanted != applied; });
+      // (another card, asked for while the hold is of one, wakes it too: the clocks of the first
+      // are let go and those of the other held; the same "wanted" alone would leave the first held)
+      state->cv.wait(lock,
+                     [&]
+                     {
+                       return state->stop || state->wanted != applied ||
+                              (state->wanted && state->pci != pci);
+                     });
       const bool stop = state->stop;
       const bool wanted = state->wanted && !stop;
       const std::string want = state->pci;
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
index 0f0d28c..385fd1d 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
@@ -13,6 +13,7 @@
 #include <cstdio>
 #include <filesystem>
 #include <fstream>
+#include <mutex>
 #include <string>
 #include <thread>
 #include <vector>
@@ -58,6 +59,54 @@ private:
   CFakeClocks& m_clocks;
 };
 
+//! What the clocks of the cards were asked, in order ("lock <card>", "unlock <card>")
+class CEvents
+{
+public:
+  void Add(const std::string& event)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_events.push_back(event);
+  }
+  std::vector<std::string> Get()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_events;
+  }
+
+private:
+  std::mutex m_mutex;
+  std::vector<std::string> m_events;
+};
+
+//! The clocks of one card, which write what they are asked into the events of all the cards
+class CCardClocks : public IClocks
+{
+public:
+  CCardClocks(std::string pci, CEvents& events, int unlockDelayMs = 0)
+    : m_pci(std::move(pci)),
+      m_events(events),
+      m_unlockDelayMs(unlockDelayMs)
+  {
+  }
+  Outcome Lock() override
+  {
+    m_events.Add("lock " + m_pci);
+    return {true, "locked"};
+  }
+  Outcome Unlock() override
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(m_unlockDelayMs));
+    m_events.Add("unlock " + m_pci);
+    return {true, "let go"};
+  }
+
+private:
+  std::string m_pci;
+  CEvents& m_events;
+  int m_unlockDelayMs;
+};
+
 //! Waits for a condition up to two seconds
 template<typename F>
 bool Eventually(F condition)
@@ -295,6 +344,30 @@ TEST(TestGpuClockHold, AsyncThatWasNeverAskedDoesNothing)
   EXPECT_EQ(0, made);
 }
 
+TEST(TestGpuClockHold, AnotherCardIsHeldAndTheFirstLetGo)
+{
+  // two NVIDIA cards, and the sound goes from one to the other while HD audio plays: the same
+  // "wanted" for another card
+  CEvents events;
+  {
+    CAsyncHold hold([&events](const std::string& pci)
+                    { return std::unique_ptr<IClocks>(new CCardClocks(pci, events)); },
+                    [](const std::string&) {});
+    hold.Set("0000:01:00.0", true);
+    EXPECT_TRUE(Eventually([&] { return events.Get().size() == 1; }));
+    hold.Set("0000:02:00.0", true);
+    EXPECT_TRUE(Eventually([&] { return events.Get().size() == 3; }));
+    // ... and back, through a stop that the thread of the hold may not have seen
+    hold.Set("", false);
+    hold.Set("0000:01:00.0", true);
+    EXPECT_TRUE(Eventually([&] { return events.Get().size() == 5; }));
+  }
+  const std::vector<std::string> expected{"lock 0000:01:00.0", "unlock 0000:01:00.0",
+                                          "lock 0000:02:00.0", "unlock 0000:02:00.0",
+                                          "lock 0000:01:00.0", "unlock 0000:01:00.0"};
+  EXPECT_EQ(expected, events.Get());
+}
+
 TEST(TestGpuClockHold, AStaleLockIsLetGo)
 {
   char name[] = "/tmp/gpuholdmXXXXXX";
