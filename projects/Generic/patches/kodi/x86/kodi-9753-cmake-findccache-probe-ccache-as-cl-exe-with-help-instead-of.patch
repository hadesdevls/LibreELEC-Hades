From 0c3746718b064a6cd9dc4fe20dc50562abee0583 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Sat, 31 Oct 2026 19:34:47 +0100
Subject: [PATCH] [cmake] FindCCache: probe ccache as cl.exe with /help instead
 of /?

ccache expands wildcards in its arguments on Windows, so /? reaches
cl.exe as any one-letter directory at the drive root and the probe
fails. GitHub's Windows runners build under D:\a, which disabled ccache
there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmake/modules/buildtools/FindCCache.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmake/modules/buildtools/FindCCache.cmake b/cmake/modules/buildtools/FindCCache.cmake
index 75c6f71..62039c5 100644
--- a/cmake/modules/buildtools/FindCCache.cmake
+++ b/cmake/modules/buildtools/FindCCache.cmake
@@ -33,7 +33,7 @@ if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND CMAKE_GENERATOR MATCHES "Visual Stu
     if(_ccache_copy_result STREQUAL "0")
       execute_process(COMMAND "${CMAKE_COMMAND}" -E env CCACHE_DISABLE=1 CCACHE_NOSTATS=1
                               "CCACHE_COMPILER=${CMAKE_CXX_COMPILER}"
-                              "${_ccache_probe}" /?
+                              "${_ccache_probe}" /help
                       RESULT_VARIABLE _ccache_probe_result
                       OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
       if(_ccache_probe_result STREQUAL "0")
-- 
2.53.0

