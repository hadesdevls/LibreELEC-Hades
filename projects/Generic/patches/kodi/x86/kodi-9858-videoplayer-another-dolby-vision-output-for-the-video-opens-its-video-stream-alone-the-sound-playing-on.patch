diff --git a/xbmc/cores/VideoPlayer/VideoOnlyReopen.h b/xbmc/cores/VideoPlayer/VideoOnlyReopen.h
new file mode 100644
index 0000000..a285b7d
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoOnlyReopen.h
@@ -0,0 +1,147 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "cores/VideoPlayer/Interface/TimingConstants.h"
+
+#include <cstdint>
+
+/*!
+ * \brief Hades: the video stream that plays opened again without touching the audio, for another
+ *        output chosen for the video ("Dolby Vision output (this video)", CVideoPlayer)
+ *
+ * What the output of a video is, is decided where its video stream opens: VideoPlayer (the mode),
+ * the decoder factory and the decoder. A choice made while it plays opened that stream again with
+ * an accurate seek of the whole player, which stops the sound for as long as a seek takes. Here only
+ * the video starts again:
+ *   - the demuxer goes back to the key frame before the clock (a seek of the demuxer alone);
+ *   - the video stream is closed and opened, and its decoder decodes from that key frame, its
+ *     pictures before the clock (plus START_MARGIN) left out, as an accurate seek leaves them out
+ *     (CVideoPlayer::CheckPlayerInit(): they are decoded, not shown);
+ *   - the packets of the other streams that the demuxer reads again, up to the last one each player
+ *     was sent before (its dts, CCurrentStream::dts), are thrown away (CRequeueFilter): the audio
+ *     plays on from its queue, and its clock is neither flushed nor paused;
+ *   - the video, once started, is put in sync with that clock as a video stream that starts while
+ *     the audio plays (HandlePlaySpeed(), the branch of a video in WAITSYNC with the audio in sync).
+ * Where the decoder cannot start at that key frame, it starts at the next one, as after any seek.
+ * Everything that this does not cover goes the way of before, the accurate seek
+ * (VideoOnlyRefusal()); and so does a video that is not back within LATE_MS.
+ */
+namespace KODI::VIDEOPLAYER
+{
+
+//! What the player is doing when another output is chosen
+struct VideoOnlyInputs
+{
+  bool dvd = false; //!< a DVD (navigator): its streams are switched by the navigator
+  bool bluray = false; //!< a Blu-ray input: its clips and their offsets are the input's own
+  bool inMenu = false; //!< a disc menu
+  bool canSeek = false; //!< the stream can seek (CVideoPlayer's play state)
+  bool realtime = false; //!< live TV, a live stream: its clock follows the source
+  bool normalSpeed = false; //!< playing at normal speed (not paused, not fast forward or back)
+  bool cachingDone = false; //!< not buffering (CACHESTATE_DONE)
+  bool audioInSync = false; //!< an audio stream plays, in sync, and a packet of it was sent
+  bool videoInSync = false; //!< the video stream that plays is in sync
+  bool plainDemuxer = false; //!< the demuxer is FFmpeg's own, not one that wraps others
+  bool captionsFromVideo = false; //!< the subtitles shown are closed captions of the video stream
+};
+
+/*!
+ * \brief Why the video stream cannot be opened again alone, as the log says it; nullptr where it
+ *        can
+ */
+constexpr const char* VideoOnlyRefusal(const VideoOnlyInputs& in)
+{
+  if (in.dvd)
+    return "a DVD";
+  if (in.bluray)
+    return "a Blu-ray";
+  if (in.inMenu)
+    return "a disc menu";
+  if (!in.canSeek)
+    return "the stream cannot seek";
+  if (in.realtime)
+    return "a live stream";
+  if (!in.normalSpeed)
+    return "not playing at normal speed";
+  if (!in.cachingDone)
+    return "buffering";
+  if (!in.audioInSync)
+    return "no audio in sync";
+  if (!in.videoInSync)
+    return "the video is not in sync yet";
+  if (!in.plainDemuxer)
+    return "the demuxer is not FFmpeg's own";
+  if (in.captionsFromVideo)
+    return "the subtitles are closed captions of the video stream";
+  return nullptr;
+}
+
+//! The pictures of the video stream opened again are shown from the clock and this much more (the
+//! time its decoder takes from the key frame; one later than the clock is shown when its time
+//! comes, one earlier would be late)
+constexpr double START_MARGIN = DVD_MSEC_TO_TIME(500);
+
+constexpr double StartPts(double clock)
+{
+  return clock + START_MARGIN;
+}
+
+//! A video not back in sync this long after it was opened again: the accurate seek of before
+constexpr int64_t LATE_MS = 6000;
+
+constexpr bool VideoLate(int64_t elapsedMs, bool videoBack)
+{
+  return !videoBack && elapsedMs >= LATE_MS;
+}
+
+/*!
+ * \brief Throws away the packets of a stream that the demuxer reads again after it went back for
+ *        the video: those up to the last one that its player was sent before
+ *
+ * Armed with that packet's dts; a packet whose time (its dts, or its pts where it has none) is not
+ * later is thrown away, and one without any time too while none has passed (it cannot be told from
+ * the others). From the first one that is later, everything passes. Not armed (no packet was sent),
+ * everything passes.
+ */
+class CRequeueFilter
+{
+public:
+  void Arm(double until)
+  {
+    m_until = until;
+    m_armed = until != DVD_NOPTS_VALUE;
+    m_dropped = 0;
+  }
+  void Disarm() { m_armed = false; }
+  bool Armed() const { return m_armed; }
+  unsigned int Dropped() const { return m_dropped; }
+
+  //! Whether the packet with these times is thrown away
+  bool Drop(double dts, double pts)
+  {
+    if (!m_armed)
+      return false;
+    const double time = dts != DVD_NOPTS_VALUE ? dts : pts;
+    if (time != DVD_NOPTS_VALUE && time > m_until)
+    {
+      m_armed = false;
+      return false;
+    }
+    ++m_dropped;
+    return true;
+  }
+
+private:
+  double m_until = DVD_NOPTS_VALUE;
+  bool m_armed = false;
+  unsigned int m_dropped = 0;
+};
+
+} // namespace KODI::VIDEOPLAYER
