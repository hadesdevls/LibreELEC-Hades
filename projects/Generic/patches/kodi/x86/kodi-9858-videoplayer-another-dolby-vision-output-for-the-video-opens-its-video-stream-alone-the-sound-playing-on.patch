 #ifdef HAVE_DVBRIDGE
+bool CVideoPlayer::ReopenVideoOnly(const SelectionStream& st)
+{
+  KODI::VIDEOPLAYER::VideoOnlyInputs in;
+  in.dvd = m_pInputStream && m_pInputStream->IsStreamType(DVDSTREAM_TYPE_DVD);
+  in.bluray = IsBlurayInput();
+  in.inMenu = IsInMenuInternal();
+  in.canSeek = m_State.canseek;
+  in.realtime = m_pInputStream && m_pInputStream->IsRealtime();
+  in.normalSpeed = m_playSpeed == DVD_PLAYSPEED_NORMAL;
+  in.cachingDone = m_caching == CACHESTATE_DONE;
+  in.audioInSync = m_CurrentAudio.id >= 0 &&
+                   m_CurrentAudio.syncState == IDVDStreamPlayer::SYNC_INSYNC &&
+                   m_CurrentAudio.dts != DVD_NOPTS_VALUE;
+  in.videoInSync = m_CurrentVideo.syncState == IDVDStreamPlayer::SYNC_INSYNC;
+  // (exactly FFmpeg's demuxer: not one that wraps others or comes from an add-on)
+  in.plainDemuxer = m_pDemuxer && typeid(*m_pDemuxer) == typeid(CDVDDemuxFFmpeg);
+  in.captionsFromVideo =
+      m_CurrentSubtitle.id >= 0 && m_CurrentSubtitle.source == STREAM_SOURCE_VIDEOMUX;
+  if (const char* why = KODI::VIDEOPLAYER::VideoOnlyRefusal(in))
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: the video stream is opened again with an accurate seek of the whole "
+              "player (the sound stops for as long as a seek): {}",
+              why);
+    return false;
+  }
+
+  // The demuxer goes back to the key frame before the clock, as a seek of the player computes its
+  // target (the PLAYER_SEEK handler)
+  const double clock = m_clock.GetClock();
+  double time = (clock + m_State.time_offset) / 1000l;
+  if (m_pInputStream->GetIPosTime() == nullptr)
+    time -= m_State.time_offset / 1000l;
+  double start = DVD_NOPTS_VALUE;
+  if (!m_pDemuxer->SeekTime(time, true, &start))
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: the video stream is opened again with an accurate seek of the whole "
+              "player: the demuxer could not go back to {:.0f} ms alone",
+              time);
+    return false;
+  }
+  // (it went back no further than what the audio player has; else what lies in between would be
+  // missing from the audio)
+  if (start != DVD_NOPTS_VALUE && start > m_CurrentAudio.dts)
+  {
+    CLog::Log(LOGINFO,
+              "DVBridge: the video stream is opened again with an accurate seek of the whole "
+              "player: the demuxer went to {} ms, past the audio already read",
+              DVD_TIME_TO_MSEC(start));
+    return false;
+  }
+
+  m_videoOnly = VideoOnlyState{};
+  m_videoOnly.audio.Arm(m_CurrentAudio.dts);
+  m_videoOnly.subtitle.Arm(m_CurrentSubtitle.id >= 0 ? m_CurrentSubtitle.dts : DVD_NOPTS_VALUE);
+  m_videoOnly.teletext.Arm(m_CurrentTeletext.id >= 0 ? m_CurrentTeletext.dts : DVD_NOPTS_VALUE);
+  m_videoOnly.rds.Arm(m_CurrentRadioRDS.id >= 0 ? m_CurrentRadioRDS.dts : DVD_NOPTS_VALUE);
+  m_videoOnly.id3.Arm(m_CurrentAudioID3.id >= 0 ? m_CurrentAudioID3.dts : DVD_NOPTS_VALUE);
+  m_videoOnly.at = std::chrono::steady_clock::now();
+  m_videoOnly.active = true;
+
+  CloseStream(m_CurrentVideo, false);
+  OpenStream(m_CurrentVideo, st.demuxerId, st.id, st.source);
+  if (m_CurrentVideo.id < 0)
+  {
+    // (the stream did not open again: the whole player, which tries it once more)
+    EndVideoOnly("the video stream did not open");
+    CLog::Log(LOGWARNING,
+              "DVBridge: the video stream did not open again alone: the whole player seeks");
+    return false;
+  }
+  // Its packets before the clock (and a margin) are decoded, not shown, as after an accurate seek
+  // (CheckPlayerInit()); its decoder starts at the key frame, or at the next one
+  m_CurrentVideo.startpts = KODI::VIDEOPLAYER::StartPts(clock);
+  // (no buffering for a video that is starting: the stall check waits as after a sync)
+  m_syncTimer.Set(3000ms);
+  CLog::Log(LOGINFO,
+            "DVBridge: the video stream is opened again alone, the audio left playing: the demuxer "
+            "went back to {} ms for it, its pictures from {} ms are shown, and what the other "
+            "streams read again up to {} ms (audio) is thrown away",
+            start != DVD_NOPTS_VALUE ? std::to_string(DVD_TIME_TO_MSEC(start))
+                                     : std::string("its key frame"),
+            static_cast<int64_t>(DVD_TIME_TO_MSEC(m_CurrentVideo.startpts)),
+            static_cast<int64_t>(DVD_TIME_TO_MSEC(m_CurrentAudio.dts)));
+  return true;
+}
+
+void CVideoPlayer::EndVideoOnly(const char* why)
+{
+  if (!m_videoOnly.active)
+    return;
+  if (why)
+    CLog::Log(LOGINFO,
+              "DVBridge: the video stream opened again alone: no more packets are thrown away "
+              "({}; audio packets thrown away: {})",
+              why, m_videoOnly.audio.Dropped());
+  else
+    CLog::Log(LOGINFO,
+              "DVBridge: the video stream opened again alone: done ({} audio, {} subtitle packets "
+              "read again thrown away)",
+              m_videoOnly.audio.Dropped(), m_videoOnly.subtitle.Dropped());
+  m_videoOnly = VideoOnlyState{};
+}
+
+bool CVideoPlayer::DropRequeued(KODI::VIDEOPLAYER::CRequeueFilter& filter, DemuxPacket* packet)
+{
+  if (!filter.Drop(packet->dts, packet->pts))
+    return false;
+  CDVDDemuxUtils::FreeDemuxPacket(packet);
+  return true;
+}
+
 bool CVideoPlayer::DVChoiceChanged() const
 {
   return m_CurrentVideo.id >= 0 && m_dvChoiceOpened != static_cast<int>(DVBRIDGE::GetOutputChoice());
@@ -5131,6 +5321,11 @@ bool CVideoPlayer::CloseStream(CCurrentStream& current, bool bWaitForBuffers)
 void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
 {
   m_syncStartPtsWait.reset();
+#ifdef HAVE_DVBRIDGE
+  // Hades: nothing read before the flush is read again after it
+  if (m_videoOnly.active)
+    EndVideoOnly("the buffers are flushed (a seek)");
+#endif
   CLog::Log(LOGDEBUG, "CVideoPlayer::FlushBuffers - flushing buffers");
 
   double startpts;
