From 3ad7604765a03e8c9a12c39fa98658953bc0ec8e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:54:42 +0000
Subject: [PATCH] ActiveAE: with no sink, try it again when the display is back

In AE_TOP_ERROR (the sink could not be opened) the engine tries the
sink again on a timer (0.5 s, doubling to 30 s) and at once on every
device change. A change of display mode takes the HDMI audio device
away and brings it back, with device changes on the way: each brought a
try forward, which opens nothing or a device that is going, and reset
the timer. When the mode was set, DISPLAYRESET was not handled in that
state, so the next try waited for a device change (the ELD of the same
display need not change) or for the timer, up to 30 s.

The error state answers DISPLAYLOST as before and now also holds the
tries: device changes do not bring them forward until the display is
back. DISPLAYRESET enumerates the devices and tries the sink at once,
whatever came before it (a change of mode that outlasted the wait
included). If the display never says it is back, the sink is tried
after 10 s all the same, with the devices enumerated first, since their
changes were not acted on; the longest change of mode measured on Hades'
hardware took 6.2 s (NVIDIA, leaving native Dolby Vision for a mode on
FRL). The engine leaves the error state only through a try of the sink
(the timeout), which clears the flag.

Only the error state changes. Configured, the engine suspends the sink
at DISPLAYLOST and opens it at DISPLAYRESET as before; the other states
answer DISPLAYLOST ("ActiveAE: answer a lost display in every state").

Idea from the YBLOD fork, cfb34065c7; rewritten (there, the try came at
DISPLAYRESET only within 3 s of DISPLAYLOST, and the try of the timer
did not enumerate the devices).
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 29 ++++++++++++++++++-
 .../AudioEngine/Engines/ActiveAE/ActiveAE.h   |  3 ++
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index b307816..338a151 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -45,6 +45,11 @@ constexpr float MIN_WATER_LEVEL_RESAMPLE = 0.1f; // min buffer time in resample
 constexpr float BUFFER_LEVEL_INCREMENT = 0.0001f; // increment step for ramp-up
 constexpr double MAX_BUFFER_TIME = 0.1; // max time of a buffer in seconds;
 
+// Hades: in the error state, the longest wait for a lost display to be back (DISPLAYRESET) before
+// the sink is tried again all the same. The longest change of mode measured on Hades' hardware took
+// 6.2 s (NVIDIA, leaving native Dolby Vision for a mode on FRL).
+constexpr std::chrono::milliseconds DISPLAY_LOST_RETRY{10000};
+
 //! \brief Retry interval for a sink that will not open, doubling to a ceiling.
 //! A device that returns announces itself, so only a fault that clears by itself needs the
 //! interval to stay short.
@@ -572,7 +577,8 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           case CActiveAEControlProtocol::DEVICECHANGE:
           case CActiveAEControlProtocol::DEFAULTDEVICECHANGE:
           case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
-            if (m_extTimeout != 0ms)
+            // (Hades: not while the display is lost, see DISPLAYLOST)
+            if (m_extTimeout != 0ms && !m_extDisplayLost)
             {
               m_sink.EnumerateSinkList(true, "");
               m_extErrorRetries = 0;
@@ -587,6 +593,20 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           // user interface, waits five seconds at every change of the display mode.
           case CActiveAEControlProtocol::DISPLAYLOST:
             msg->Reply(CActiveAEControlProtocol::ACC);
+            // Hades: and an HDMI device goes away with the display and comes back with it: a retry
+            // in between opens nothing, or a device that is going, and each of the device changes
+            // that the change of mode brings asked for one. The next try is when the display is
+            // back, or after DISPLAY_LOST_RETRY if it never says so.
+            m_extDisplayLost = true;
+            m_extTimeout = DISPLAY_LOST_RETRY;
+            return;
+          // Hades: the display is back (also when it took longer than DISPLAY_LOST_RETRY): the
+          // devices as they are now, and the sink at once rather than at the end of the wait
+          case CActiveAEControlProtocol::DISPLAYRESET:
+            m_extDisplayLost = false;
+            m_sink.EnumerateSinkList(true, "");
+            m_extErrorRetries = 0;
+            m_extTimeout = 0ms;
             return;
           default:
             break;
@@ -611,6 +631,13 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
         switch (signal)
         {
         case CActiveAEControlProtocol::TIMEOUT:
+          // Hades: a lost display that never said it was back: its device changes were not acted
+          // on, so the devices are enumerated as for one
+          if (m_extDisplayLost)
+          {
+            m_extDisplayLost = false;
+            m_sink.EnumerateSinkList(true, "");
+          }
           m_extError = false;
           LoadSettings();
           Configure();
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index 98b17e7..c70dc72 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -376,6 +376,9 @@ protected:
   //! m_sinkFormat.
   bool m_sinkInitFailed{false};
   unsigned int m_extErrorRetries{0};
+  // Hades: in the error state, the display was lost and has not said it is back (DISPLAYRESET):
+  // device changes do not bring the next try of the sink forward
+  bool m_extDisplayLost{false};
   bool m_extDrain;
   XbmcThreads::EndTime<> m_extDrainTimer;
   std::chrono::milliseconds m_extKeepConfig;
-- 
