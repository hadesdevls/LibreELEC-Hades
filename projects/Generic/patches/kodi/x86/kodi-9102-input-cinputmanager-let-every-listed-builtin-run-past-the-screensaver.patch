From f7b1bc3100a5f932b14543dba3340937b1cc5ed5 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Thu, 8 Oct 2026 12:39:46 +0100
Subject: [PATCH] [input][CInputManager] Let every listed builtin run past the
 screensaver

While the screensaver is active, a key press only wakes it unless
AlwaysProcess lists the builtin it is mapped to. The function name comes
from CExecString, which lower-cases it, but six entries in the list were
spelled with capitals: RunAppleScript, RunAddon, RunPlugin, RunScript,
System.Exec and System.ExecWait. They could never match, so a key mapped
to any of them woke the screensaver and dropped the action.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit a79e47c2aca6639bda6d252cce4391bbfd5fefbc)
---
 cmake/treedata/common/tests.txt      |  1 +
 xbmc/input/InputManager.cpp          |  8 +++---
 xbmc/input/InputManager.h            |  2 ++
 xbmc/input/test/CMakeLists.txt       |  3 ++
 xbmc/input/test/TestInputManager.cpp | 41 ++++++++++++++++++++++++++++
 5 files changed, 51 insertions(+), 4 deletions(-)
 create mode 100644 xbmc/input/test/CMakeLists.txt
 create mode 100644 xbmc/input/test/TestInputManager.cpp

diff --git a/cmake/treedata/common/tests.txt b/cmake/treedata/common/tests.txt
index e76f4de..78a1747 100644
--- a/cmake/treedata/common/tests.txt
+++ b/cmake/treedata/common/tests.txt
@@ -26,6 +26,7 @@ xbmc/games/controllers/test       test/games/controllers
 xbmc/games/dialogs/disc/test      test/games/dialogs/disc
 xbmc/guilib/test                  test/guilib
 xbmc/imagefiles/test              test/imagefiles
+xbmc/input/test                   test/input
 xbmc/input/keyboard/test          test/input/keyboard
 xbmc/input/keymaps/test           test/input/keymaps
 xbmc/interfaces/json-rpc/test     test/jsonrpc
diff --git a/xbmc/input/InputManager.cpp b/xbmc/input/InputManager.cpp
index 8bc3063..f6724f2 100644
--- a/xbmc/input/InputManager.cpp
+++ b/xbmc/input/InputManager.cpp
@@ -731,10 +731,10 @@ bool CInputManager::AlwaysProcess(const CAction& action)
           builtInFunction == "suspend" || builtInFunction == "hibernate" ||
           builtInFunction == "quit" || builtInFunction == "shutdown" ||
           builtInFunction == "volumeup" || builtInFunction == "volumedown" ||
-          builtInFunction == "mute" || builtInFunction == "RunAppleScript" ||
-          builtInFunction == "RunAddon" || builtInFunction == "RunPlugin" ||
-          builtInFunction == "RunScript" || builtInFunction == "System.Exec" ||
-          builtInFunction == "System.ExecWait")
+          builtInFunction == "mute" || builtInFunction == "runapplescript" ||
+          builtInFunction == "runaddon" || builtInFunction == "runplugin" ||
+          builtInFunction == "runscript" || builtInFunction == "system.exec" ||
+          builtInFunction == "system.execwait")
       {
         return true;
       }
diff --git a/xbmc/input/InputManager.h b/xbmc/input/InputManager.h
index 70e0952..3e41d0f 100644
--- a/xbmc/input/InputManager.h
+++ b/xbmc/input/InputManager.h
@@ -246,6 +246,8 @@ public:
   void UnregisterCecInputProvider(KODI::CEC::ICecInputProvider* handler);
 
 private:
+  friend class TestInputManager;
+
   /*! \brief Process keyboard event and translate into an action
    *
    * \param key keypress details
diff --git a/xbmc/input/test/CMakeLists.txt b/xbmc/input/test/CMakeLists.txt
new file mode 100644
index 0000000..3a52d09
--- /dev/null
+++ b/xbmc/input/test/CMakeLists.txt
@@ -0,0 +1,3 @@
+set(SOURCES TestInputManager.cpp)
+
+core_add_test_library(test_input)
diff --git a/xbmc/input/test/TestInputManager.cpp b/xbmc/input/test/TestInputManager.cpp
new file mode 100644
index 0000000..d9f7271
--- /dev/null
+++ b/xbmc/input/test/TestInputManager.cpp
@@ -0,0 +1,41 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "input/InputManager.h"
+#include "input/actions/Action.h"
+#include "input/actions/ActionIDs.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+class TestInputManager : public testing::Test
+{
+protected:
+  static bool AlwaysProcess(const std::string& builtin)
+  {
+    CInputManager inputManager;
+    return inputManager.AlwaysProcess(CAction(ACTION_NONE, builtin));
+  }
+};
+
+TEST_F(TestInputManager, AlwaysProcessesTheBuiltinsItLists)
+{
+  for (const char* builtin :
+       {"PowerDown", "Reboot", "Restart", "RestartApp", "Suspend", "Hibernate", "Quit",
+        "ShutDown", "VolumeUp", "VolumeDown", "Mute", "RunAppleScript(script.scpt)",
+        "RunAddon(script.example)", "RunPlugin(plugin://plugin.video.example/)",
+        "RunScript(script.example)", "System.Exec(/bin/true)", "System.ExecWait(/bin/true)"})
+    EXPECT_TRUE(AlwaysProcess(builtin)) << builtin;
+}
+
+TEST_F(TestInputManager, LeavesOtherBuiltinsToTheScreensaver)
+{
+  EXPECT_FALSE(AlwaysProcess("ActivateWindow(Home)"));
+  EXPECT_FALSE(AlwaysProcess(""));
+}
