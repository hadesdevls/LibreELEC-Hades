From a807094395ea376a22974481973c9729146aa998 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:10:28 +0000
Subject: [PATCH] windowing/gbm: Dolby Vision sent as HDR10+, the vblank read
 by the id of the CRTC, and what failed in the log

The first picture of a scene waits for its own measurement until a
margin before the next vblank, which it learns from the vblank ioctl,
or where there is none (nvidia-drm with its defaults) from the last
flip. On amdgpu (an RX 7600, issue 10) the first picture of a video
found neither, where on i915 the same code found the vblank (issue 2:
"0 with nothing to time it by"). The flips of a video are timed only
from its first flip on, so the vblank ioctl is what failed there; why,
the log did not say.

The time of the last vblank is now asked with DRM_IOCTL_CRTC_GET_SEQUENCE
by the id of the CRTC, which gives it in ns and is what Kodi's own vsync
for GBM asks of every driver, and with the legacy WAIT_VBLANK (by the
index of the CRTC in the high-CRTC bits, as before) only where that
fails (CDVPlusVBlank). Where neither answers, kodi.log says once a
video which CRTC and the error of each ioctl. On i915 both give the same
vblank; on nvidia-drm both fail as before and the flips time it.

The counters of the line written every 240 frames counted a first
picture that was timed but too close to the next refresh to wait among
those "with nothing to time it by"; they are counted apart now ("too
close to it to wait"). In the author's own log of 1.0 RC4 on NVIDIA at
120 Hz all four first pictures were counted as with nothing to time
them by.
---
 xbmc/windowing/gbm/DVPlusVBlank.h             | 93 +++++++++++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 71 ++++++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  5 +
 3 files changed, 150 insertions(+), 19 deletions(-)
 create mode 100644 xbmc/windowing/gbm/DVPlusVBlank.h

diff --git a/xbmc/windowing/gbm/DVPlusVBlank.h b/xbmc/windowing/gbm/DVPlusVBlank.h
new file mode 100644
index 0000000..ba943e4
--- /dev/null
+++ b/xbmc/windowing/gbm/DVPlusVBlank.h
@@ -0,0 +1,93 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cerrno>
+#include <cstdint>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: the time of the last vblank of the CRTC of the output, for Dolby Vision sent as HDR10+
+ *        (CDVPlusClock), with the ioctl that names the CRTC by its id first and the legacy one second
+ *
+ * 1.0 RC4 asked only the legacy vblank ioctl (DRM_IOCTL_WAIT_VBLANK, relative 0), which names the CRTC by
+ * its index among the CRTCs of the device, in the high-CRTC bits of the request. On amdgpu (an RX 7600,
+ * issue #10 of Hades) the first picture of a video found no vblank to time it by, where on i915 the same
+ * code found one (BigRedJim's log of issue #2: "2 not measured by the next refresh, 0 with nothing to time
+ * it by"); why that ioctl failed there is not known (no log of its error). DRM_IOCTL_CRTC_GET_SEQUENCE
+ * (drmCrtcGetSequence(), Linux 4.15) names the CRTC by its id, gives the time in ns, and is what Kodi's own
+ * vsync for GBM asks of every driver (CVideoSyncGbm): it is asked first, and the legacy ioctl only where it
+ * fails. What failed, and with which error, is kept for the log (Errors), so that a report says it.
+ *
+ * Only what is decided is here: the two ioctls are given as callables (seq(crtcId, &sequence, &ns),
+ * legacy(type, &sec, &usec), each 0 or an errno), so that a test can run it.
+ */
+class CDVPlusVBlank
+{
+public:
+  //! the bits of the legacy request (xf86drm.h: DRM_VBLANK_RELATIVE, DRM_VBLANK_HIGH_CRTC_SHIFT and _MASK;
+  //! the .cpp that asks the kernel checks them against libdrm's)
+  static constexpr uint32_t RELATIVE = 0x1;
+  static constexpr uint32_t HIGH_CRTC_SHIFT = 1;
+  static constexpr uint32_t HIGH_CRTC_MASK = 0x3e;
+
+  //! the type of the legacy query (relative 0) for the CRTC of index `index` among those of the device;
+  //! the kernel reads it as that index for any index, 0 and 1 included (drm_wait_vblank_ioctl())
+  static uint32_t LegacyType(uint32_t index)
+  {
+    return RELATIVE | ((index << HIGH_CRTC_SHIFT) & HIGH_CRTC_MASK);
+  }
+
+  struct Errors
+  {
+    int sequence = 0; //!< errno of CRTC_GET_SEQUENCE, 0 where it gave a time
+    int legacy = 0; //!< errno of WAIT_VBLANK, 0 where it gave a time or was not asked
+  };
+
+  /*!
+   * \brief The time of the last vblank (CLOCK_MONOTONIC, ns), 0 where neither ioctl gives one. A time of 0
+   *        counts as none (a CRTC whose vblanks never ran).
+   */
+  template<typename Seq, typename Legacy>
+  static int64_t Last(Seq seq, Legacy legacy, uint32_t crtcId, uint32_t index, Errors* errors)
+  {
+    Errors e;
+    uint64_t sequence = 0, ns = 0;
+    const int s = crtcId ? seq(crtcId, &sequence, &ns) : ENODEV;
+    if (s == 0 && ns > 0 && ns <= static_cast<uint64_t>(INT64_MAX))
+    {
+      if (errors)
+        *errors = e;
+      return static_cast<int64_t>(ns);
+    }
+    e.sequence = s ? s : EINVAL;
+    long sec = 0, usec = 0;
+    const int l = legacy(LegacyType(index), &sec, &usec);
+    if (l == 0 && (sec > 0 || usec > 0))
+    {
+      if (errors)
+        *errors = e;
+      return static_cast<int64_t>(sec) * 1000000000 + static_cast<int64_t>(usec) * 1000;
+    }
+    e.legacy = l ? l : EINVAL;
+    if (errors)
+      *errors = e;
+    return 0;
+  }
+};
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b57b8ef..f1fd779 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -64,6 +64,7 @@ extern "C"
 #include "utils/GBMBufferObject.h"
 #include "utils/HDR10PlusVsif.h"
 #include "windowing/gbm/DVPlusModeStart.h"
+#include "windowing/gbm/DVPlusVBlank.h"
 #include "utils/MemUtils.h"
 #include "utils/UDMABufferObject.h"
 #include "utils/StringUtils.h"
@@ -2120,6 +2121,7 @@ void CWinSystemGbmGLESContext::DVPlusEnd()
   m_dvPlusStartPts = DVD_NOPTS_VALUE;
   m_dvPlusStartsWaited = m_dvPlusStartsLate = m_dvPlusStartsNoTime = 0;
   m_dvPlusStartsByVBlank = m_dvPlusStartsByFlip = 0;
+  m_dvPlusStartsTooClose = 0;
   m_dvPlusNoVBlankTold = false;
   m_dvPlusClock.Lost();
   m_dvPlusSending = false;
@@ -2155,20 +2157,39 @@ void CWinSystemGbmGLESContext::DVPlusCollect()
 
 int64_t CWinSystemGbmGLESContext::DVPlusLastVBlankNs() const
 {
-  // the legacy vblank ioctl, relative 0: the kernel answers at once with the count and the time of the
-  // last vblank (as WaitDVBridgeVBlank() asks it); nvidia-drm has none with its defaults
+  // Hades: the time of the last vblank of the CRTC of the output: CRTC_GET_SEQUENCE by its id first, the
+  // legacy vblank ioctl (relative 0, by its index, as WaitDVBridgeVBlank() asks it) where that fails
+  // (CDVPlusVBlank); what failed is kept for the log. nvidia-drm has neither with its defaults.
+  static_assert(CDVPlusVBlank::RELATIVE == DRM_VBLANK_RELATIVE &&
+                    CDVPlusVBlank::HIGH_CRTC_SHIFT == DRM_VBLANK_HIGH_CRTC_SHIFT &&
+                    CDVPlusVBlank::HIGH_CRTC_MASK == DRM_VBLANK_HIGH_CRTC_MASK,
+                "the bits of the legacy vblank request are libdrm's");
   const CDRMCrtc* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
   if (!crtc)
+  {
+    m_dvPlusVBlankSeqError = m_dvPlusVBlankLegacyError = ENODEV;
     return 0;
-  drmVBlank vblank{};
-  vblank.request.type = static_cast<drmVBlankSeqType>(
-      DRM_VBLANK_RELATIVE |
-      ((crtc->GetOffset() << DRM_VBLANK_HIGH_CRTC_SHIFT) & DRM_VBLANK_HIGH_CRTC_MASK));
-  vblank.request.sequence = 0;
-  if (drmWaitVBlank(m_DRM->GetFileDescriptor(), &vblank) != 0)
-    return 0;
-  return static_cast<int64_t>(vblank.reply.tval_sec) * 1000000000 +
-         static_cast<int64_t>(vblank.reply.tval_usec) * 1000;
+  }
+  const int fd = m_DRM->GetFileDescriptor();
+  CDVPlusVBlank::Errors errors;
+  const int64_t ns = CDVPlusVBlank::Last(
+      [fd](uint32_t id, uint64_t* sequence, uint64_t* time)
+      { return drmCrtcGetSequence(fd, id, sequence, time) == 0 ? 0 : (errno ? errno : EINVAL); },
+      [fd](uint32_t type, long* sec, long* usec)
+      {
+        drmVBlank vblank{};
+        vblank.request.type = static_cast<drmVBlankSeqType>(type);
+        vblank.request.sequence = 0;
+        if (drmWaitVBlank(fd, &vblank) != 0)
+          return errno ? errno : EINVAL;
+        *sec = vblank.reply.tval_sec;
+        *usec = vblank.reply.tval_usec;
+        return 0;
+      },
+      crtc->GetCrtcId(), crtc->GetOffset(), &errors);
+  m_dvPlusVBlankSeqError = errors.sequence;
+  m_dvPlusVBlankLegacyError = errors.legacy;
+  return ns;
 }
 
 std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR10Plus(
@@ -2236,10 +2257,12 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
     CLog::Log(LOGINFO,
               "DVBridge: Dolby Vision sent as HDR10+: so far {} pictures with HDR10+ and {} without, "
               "{} scenes ({} first pictures with their own measurement, {} timed by the vblank "
-              "and {} by the last flip; {} not measured by the next refresh, {} with nothing to "
-              "time it by), {} changes within a scene, {} pictures measured, {} dropped; now {}",
+              "and {} by the last flip; {} not measured by the next refresh, {} too close to it "
+              "to wait, {} with nothing to time it by), {} changes within a scene, {} pictures "
+              "measured, {} dropped; now {}",
               c.sent, c.unsent, c.scenes, m_dvPlusStartsWaited, m_dvPlusStartsByVBlank,
-              m_dvPlusStartsByFlip, m_dvPlusStartsLate, m_dvPlusStartsNoTime, c.changes,
+              m_dvPlusStartsByFlip, m_dvPlusStartsLate, m_dvPlusStartsTooClose,
+              m_dvPlusStartsNoTime, c.changes,
               c.measured, c.dropped,
               send ? StringUtils::Format("maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2",
                                          stats.average / 10.0, stats.percentiles[8] / 10.0)
@@ -2337,14 +2360,24 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
       dvbridge_dvplus_wait_budget(SteadyNowNs(), anchor, period, DVBRIDGE_DVPLUS_WAIT_MARGIN);
   if (budget <= 0)
   {
-    ++m_dvPlusStartsNoTime;
+    // (Hades: timed, but too close to the next refresh to wait for anything; or nothing to time it by)
+    ++(timedBy == CDVPlusClock::Source::NONE ? m_dvPlusStartsNoTime : m_dvPlusStartsTooClose);
     if (timedBy == CDVPlusClock::Source::NONE && !m_dvPlusNoVBlankTold)
     {
       m_dvPlusNoVBlankTold = true;
-      CLog::Log(LOGINFO, "DVBridge: Dolby Vision sent as HDR10+: neither the vblanks nor the flips "
-                         "of the output can be timed now, so the first picture of a scene does not "
-                         "wait for its own measurement: it goes out with the metadata of the scene "
-                         "before, until a flip is timed");
+      const CDRMCrtc* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+      CLog::Log(LOGINFO,
+                "DVBridge: Dolby Vision sent as HDR10+: neither the vblanks nor the flips of the "
+                "output can be timed now, so the first picture of a scene does not wait for its "
+                "own measurement: it goes out with the metadata of the scene before, until a flip "
+                "is timed. The vblank of CRTC {} (index {}) could not be read ({} by "
+                "CRTC_GET_SEQUENCE, {} by WAIT_VBLANK), and no flip of this video was timed yet{}",
+                crtc ? crtc->GetCrtcId() : 0, crtc ? crtc->GetOffset() : 0,
+                strerror(m_dvPlusVBlankSeqError),
+                m_dvPlusVBlankLegacyError ? strerror(m_dvPlusVBlankLegacyError) : "not asked",
+                m_dvPlusVBlankSeqError == EOPNOTSUPP && m_dvPlusVBlankLegacyError == EOPNOTSUPP
+                    ? " (the driver has no vblanks: nvidia-drm with its defaults)"
+                    : "");
     }
     return;
   }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 7e371a2..77ef7ad 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -437,6 +437,11 @@ private:
   bool m_dvPlusNoVBlankTold = false;
   //! ... of those that did, how many by the vblank and how many by the last flip (m_dvPlusClock)
   unsigned int m_dvPlusStartsByVBlank = 0, m_dvPlusStartsByFlip = 0;
+  //! Hades: ... those timed but too close to the next refresh to wait (they went out as the ones with
+  //! nothing to time them by do: with the metadata of the scene before); 1.0 RC4 counted them with those
+  unsigned int m_dvPlusStartsTooClose = 0;
+  //! Hades: what the vblank ioctls answered last (CDVPlusVBlank), for the log
+  mutable int m_dvPlusVBlankSeqError = 0, m_dvPlusVBlankLegacyError = 0;
   //! where the vblanks are: the vblank ioctl, else the last flip (PresentRender() gives it the
   //! flips, while Dolby Vision goes out as HDR10+)
   CDVPlusClock m_dvPlusClock;
