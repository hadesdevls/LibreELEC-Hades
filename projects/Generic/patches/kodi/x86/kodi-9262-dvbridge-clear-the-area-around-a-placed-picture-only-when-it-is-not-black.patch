From 8dbf28514b12e5bb22e96b7202a68ee1d1ab4ef0 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:21:41 +0000
Subject: [PATCH] dvbridge: clear the area around a placed picture only when it
 is not black

A picture that does not fill the 3840x2160 raster (a cropped encode, placed
at row 280 for example) is drawn by libplacebo into its place alone, all of
it, every frame (PL_CLEAR_SKIP). The renderer still cleared the whole RGBA32F
texture before every such frame: 132 MB written per frame, on graphics where
the frame time is short already.

It is now cleared only when what is outside the place is not known to be
black: a new texture, a picture at another place or one that filled the
raster, a render that failed, or drawing into the texture by Kodi. Kodi says
so with dvbridge_render_texture_drawn(), which CDVBridgeGLES::PQTextureDrawn()
calls where the GUI is composited into the picture (CompositeGui()) and
where PQ subtitles are drawn into it (BeginDVBridgeHDROverlays()).

Tested on the host, software OpenGL ES, against a renderer that clears for
every frame: the same RGBA32F texture, value for value, for the same place
again, after drawing into the bars and the picture and saying so, at another
place, and after a picture that fills the raster. Drawing into the bars
without saying so leaves 320000 values different (the rectangle drawn): the
clear is really left out, and the test sees what it would miss.
---
 tools/dvbridge/dvbridge_render.c              | 34 ++++++++++++++++++-
 tools/dvbridge/dvbridge_render.h              |  6 ++++
 .../VideoRenderers/DVBridgeGLES.cpp           |  6 ++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  4 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  4 +++
 5 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index b33fb06..00ebf0c 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -38,6 +38,11 @@ struct dvbridge_renderer {
     bool early_mask, early_off, early_unusable[2];
     unsigned char early_failures[2];
     int step; /* Hades: dvbridge_render_set_step() */
+    /* Hades: the picture of the transport (rgb) holds black outside the place of clean_place: a
+     * picture placed there was drawn into it since it was cleared, and nothing else was (see
+     * dvbridge_render_texture_drawn()). A picture at that place again does not clear it. */
+    bool rgb_clean;
+    int clean_place[4];
     /* Hades: what was noted of this stream (NOTE_*): reported (noted) and not yet taken (fresh) */
     unsigned noted, fresh;
     struct dvbridge_render_notes notes;
@@ -267,6 +272,12 @@ void dvbridge_render_set_frame_period(struct dvbridge_renderer *r, double period
         dvbridge_set_frame_period(r->context, period);
 }
 
+void dvbridge_render_texture_drawn(struct dvbridge_renderer *r)
+{
+    if (r)
+        r->rgb_clean = false;
+}
+
 bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_render_notes *notes)
 {
     if (!r || !notes || !r->fresh)
@@ -335,6 +346,12 @@ static void restore_gl_state(const struct dvbridge_gl_state *s)
     dvbridge_gl_state_restore(s);
 }
 
+/* Hades: the place of a picture in the raster, as rgb_clean keeps it */
+static bool same_place(const int place[4], struct dvbridge_geometry g)
+{
+    return place[0] == g.x && place[1] == g.y && place[2] == g.width && place[3] == g.height;
+}
+
 /* Hades: the colour mapping of a picture by its metadata (dvbridge_map_color()), with the bit
  * depth of its imported layers checked against the one the metadata gives for them. The reshaping
  * takes its pivots and coefficients in codes of that depth, and libplacebo reads the samples at the
@@ -495,13 +512,28 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     const struct pl_hook *hooks[] = {&hook};
     params.hooks = hooks;
     params.num_hooks = 1;
-    if (!packed && (geometry.x || geometry.y || geometry.width != 3840 || geometry.height != 2160))
+    /* The area outside the place of a picture that does not fill the raster is black: libplacebo
+     * writes the place alone (PL_CLEAR_SKIP), all of it, every frame. Hades: so the texture is
+     * cleared only when what is outside is not known to be black: a new texture, a picture at
+     * another place or one that filled the raster, a render that failed, or drawing into the
+     * texture by the caller (the GUI and the subtitles: dvbridge_render_texture_drawn()). It was
+     * cleared for every frame, 132 MB written for each. */
+    const bool whole = !geometry.x && !geometry.y && geometry.width == 3840 && geometry.height == 2160;
+    if (!packed && !whole && (!r->rgb_clean || !same_place(r->clean_place, geometry))) {
         pl_tex_clear(r->gpu, r->rgb, (float[4]){0, 0, 0, 1});
+        r->rgb_clean = true;
+        r->clean_place[0] = geometry.x;
+        r->clean_place[1] = geometry.y;
+        r->clean_place[2] = geometry.width;
+        r->clean_place[3] = geometry.height;
+    }
     r->ready = pl_render_image(r->renderer, &image, &target, &params) && mask.called && !mask.failed;
     /* An EL sampling failure can otherwise return a successfully rendered BL-only frame. */
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
     r->ready = r->ready && !errors.errors && !errors.num_disabled_hooks;
     r->early_mask = mask.early_mask;
+    if (!packed && (whole || !r->ready))
+        r->rgb_clean = false;
     if (!r->ready) {
         dvbridge_candidate_destroy(r->pending);
         r->pending = NULL;
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index aa8c6a5..351df5e 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -22,6 +22,12 @@ void dvbridge_renderer_recover(struct dvbridge_renderer *renderer);
 /* Hades: the duration of a frame of the stream, in the units of the presentation times
  * (dvbridge_set_frame_period()); 0 when not known */
 void dvbridge_render_set_frame_period(struct dvbridge_renderer *renderer, double period);
+/* Hades: the caller drew into the picture of dvbridge_render_texture() (the GUI, subtitles): the
+ * next render of a picture that does not fill the raster clears it first. It is not cleared
+ * otherwise, when the picture comes to the same place (libplacebo writes all of the place and
+ * nothing else). */
+#define DVBRIDGE_RENDER_TEXTURE_DRAWN 1
+void dvbridge_render_texture_drawn(struct dvbridge_renderer *renderer);
 /* Hades: what the renderer noticed of a stream, once each between two resets. */
 #define DVBRIDGE_RENDER_DEPTH_NOTES 1
 struct dvbridge_render_notes {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 486fbeb..ee8ef50 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -473,6 +473,12 @@ void CDVBridgeGLES::LogNotes()
               notes.el_bits, notes.rpu_el_bits);
 }
 
+void CDVBridgeGLES::PQTextureDrawn()
+{
+  if (m_renderer)
+    dvbridge_render_texture_drawn(m_renderer);
+}
+
 unsigned int CDVBridgeGLES::GetPQTexture() const
 {
   const auto texture = m_prepared ? dvbridge_render_texture(m_renderer) : nullptr;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index bfcfa57..7747bde 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -109,6 +109,10 @@ public:
   unsigned int TakeL1Changes();
   bool Pack(unsigned int framebuffer, int width, int height, bool flipY);
   bool Presented(bool success);
+  //! Hades: something was drawn into the PQ picture (GetPQFramebuffer()): the GUI, subtitles. Its
+  //! area outside the place of the video is cleared again before the next picture; it is not
+  //! otherwise (dvbridge_render_texture_drawn()).
+  void PQTextureDrawn();
 
   // Hades: a Dolby Vision picture reconstructed for output as HDR10. A bridge is set up for
   // this or for native output, not for both.
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index fe1bd7a..4ac0553 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -881,6 +881,8 @@ void CWinSystemGbmGLESContext::CompositeGui()
     glDisable(GL_SCISSOR_TEST);
     glBindFramebuffer(GL_FRAMEBUFFER, target);
     glViewport(0, 0, 3840, 2160);
+    // Hades: the GUI goes over the bars too: they are cleared again before the next picture
+    m_dvBridge->PQTextureDrawn();
   }
 #endif
 
@@ -1346,6 +1348,8 @@ bool CWinSystemGbmGLESContext::BeginDVBridgeHDROverlays()
   glGetIntegerv(GL_VIEWPORT, m_dvOverlayViewport);
   m_dvOverlayScissor = glIsEnabled(GL_SCISSOR_TEST);
   glBindFramebuffer(GL_FRAMEBUFFER, target);
+  // Hades: subtitles may go over the bars: they are cleared again before the next picture
+  m_dvBridge->PQTextureDrawn();
   glViewport(0, 0, 3840, 2160);
   glDisable(GL_SCISSOR_TEST);
   // The PQ texture stores the logical top at row zero (see CompositeGui()): flip the clip-space
-- 
2.53.0

