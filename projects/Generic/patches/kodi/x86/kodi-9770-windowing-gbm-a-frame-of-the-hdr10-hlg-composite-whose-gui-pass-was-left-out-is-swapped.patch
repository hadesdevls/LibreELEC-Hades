From 488f08849cf268064a8dd271c345824cc0cb446a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:21:20 +0000
Subject: [PATCH] windowing/gbm: a frame of the HDR10/HLG composite whose GUI
 pass was left out is swapped

Since the GUI pass is left out also where the GUI is composited over HDR10 and
HLG (CDVGuiReuse, 2ad3013), the window and the video control no longer mark
themselves dirty in every frame there, and the dirty-driven skip of
CApplication::FrameMove() leaves the GUI pass out whenever no control is dirty.
The frame is still whole: EndGuiComposite() clears the window's buffer,
RenderEx() draws the picture into it and CompositeGui() the GUI from its FBO.
But CApplication::Render() says rendered of its GUI pass alone, and
PresentRender() swaps only what is rendered (or a video layer of its own): such
a frame was never swapped, and HDR10 and HLG video stood still on the screen
while the sound went on, as soon as the OSD was gone. The comment of
EndGuiComposite() said why it was safe before: single-plane never reached
!m_guiWillRender. Native Dolby Vision output presents its frames its own way and
was not touched by this.

EndGuiComposite() now marks the frame whose buffer it clears with the GUI pass
left out (not D2P, where the GUI plane keeps its buffer as before), and
PresentRender() takes such a frame as rendered (CDVGuiReuse::Presents()), so
that it is swapped and committed as before 2ad3013. BeginGuiComposite() starts
every frame unmarked.

Host tests (outside the tree): present_test (the decision and a model of the
frame: HDR10/HLG composite with the pass left out is swapped; D2P and frames
without a composite as before) and present_wiring.py (the calls in the window
system). Before this change the first does not build and the second fails all 7 of
its checks.
---
 xbmc/windowing/gbm/DVGuiReuse.h                |  8 ++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 10 ++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  4 ++++
 3 files changed, 22 insertions(+)

diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index 52a1826..efa1c2d 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -145,6 +145,14 @@ public:
   //! and one whose GUI pass was left out, which goes to the screen all the same
   static bool CountsAsFrame(bool rendered, bool reused) { return rendered || reused; }
 
+  //! Whether a frame is swapped and goes to the screen as a drawn one (PresentRender()): one whose
+  //! GUI pass drew (Kodi's Render() says rendered of its GUI pass alone), and one whose GUI pass
+  //! was left out where the picture and the GUI over it were drawn into the window's buffer all
+  //! the same (the HDR10/HLG composite: the buffer cleared by EndGuiComposite(), the picture drawn
+  //! by RenderEx(), the GUI composited from its FBO). Native Dolby Vision output presents its
+  //! frames its own way, whatever this says.
+  static bool Presents(bool rendered, bool backDrawn) { return rendered || backDrawn; }
+
   static Over Classify(bool captured, bool guiElements)
   {
     return captured ? Over::CAPTURE : guiElements ? Over::GUI : Over::OVERLAYS;
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 910d308..743cc15 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -515,6 +515,11 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 {
   if (!m_bRenderCreated)
     return;
+  // Hades: a frame whose GUI pass was left out (CDVGuiReuse) where the picture and the GUI over it
+  // were drawn into the window's buffer (the HDR10/HLG composite: EndGuiComposite()) is a whole
+  // frame, swapped as one whose GUI pass drew. Kodi's Render() says rendered of its GUI pass
+  // alone: such a frame was never swapped, and the picture stood still while no control was dirty.
+  rendered = CDVGuiReuse::Presents(rendered, std::exchange(m_guiBackDrawn, false));
 
   NotifyLimitedInput();
   PublishPlayerInfo();
@@ -1982,6 +1987,7 @@ bool CWinSystemGbmGLESContext::BeginGuiComposite(bool guiWillRender)
   // Hades: the menus in Dolby Vision start, go on or end, before the GUI of this frame is drawn
   DVMenusUpdate();
 #endif
+  m_guiBackDrawn = false; // (Hades: EndGuiComposite())
   if (!m_guiCompositing)
     return false;
 
@@ -2139,6 +2145,10 @@ void CWinSystemGbmGLESContext::EndGuiComposite()
   const bool isD2P = m_DRM && m_DRM->GetVideoPlane() != nullptr && m_DRM->GetGuiPlane() != nullptr;
   if (isD2P && !m_guiWillRender)
     return;
+  // Hades: single-plane does reach !m_guiWillRender now, where the GUI is composited and no
+  // control is dirty (CDVGuiReuse): the picture and the GUI from its FBO go into this buffer all
+  // the same, a whole frame that PresentRender() swaps (CDVGuiReuse::Presents())
+  m_guiBackDrawn = !m_guiWillRender;
 
   // Clear the backbuffer before video renders. In the FBO compositing path,
   // video renders in the RenderEx pass with clear=false, so DrawBlackBars is
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 416b57e..07853e1 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -485,6 +485,10 @@ private:
   //! Hades: the GUI pass of this frame is left out and its GUI is the FBO of the frame before
   //! (CDVGuiReuse; the content of m_guiFboClean is that of the last frame drawn)
   bool m_guiReusing{false};
+  //! Hades: EndGuiComposite() cleared the window's buffer for a frame whose GUI pass was left out:
+  //! the picture and the GUI over it go into it, a whole frame that PresentRender() swaps
+  //! (CDVGuiReuse::Presents())
+  bool m_guiBackDrawn{false};
   //! Hades: a frame whose GUI was drawn was composited since the FBO was made (CDVGuiReuse::Facts)
   bool m_guiSeen{false};
   //! Hades: RenderDVBridge() ran in this frame, and in the frame before it
-- 
