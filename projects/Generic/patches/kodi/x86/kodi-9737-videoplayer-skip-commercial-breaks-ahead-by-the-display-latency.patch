From ec2e697438dae903e588ac7a3a97338435992829 Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Sun, 25 Oct 2026 15:31:41 +0100
Subject: [PATCH] [VideoPlayer] Skip commercial breaks ahead by the display
 latency

The renderer shows pictures ahead of the clock by its display latency,
and the picture on screen when a skip starts stays there until the seek
is done. Skipping once the clock reached a break therefore showed its
first picture for the duration of the seek.
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 23 ++++++++++++++++++-
 .../VideoRenderers/RenderManager.h            |  7 +++++-
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 4a088f8..0fb8f64 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -2898,7 +2898,28 @@ void CVideoPlayer::CheckAutoSceneSkip()
     clock += std::chrono::milliseconds{llrint(DVD_TIME_TO_MSEC(elapsed))};
 
   const std::chrono::milliseconds correctClock = m_Edl.GetTimeAfterRestoringCuts(clock);
-  const auto hasEdit = m_Edl.InEdit(correctClock);
+  auto hasEdit = m_Edl.InEdit(correctClock);
+
+  // The renderer shows pictures ahead of the clock by its display latency, and the picture on
+  // screen when a skip starts stays there until the seek is done. Skip a commercial break that
+  // early, plus a margin for the time the skip takes to reach the renderer.
+  if (!hasEdit && m_playSpeed == DVD_PLAYSPEED_NORMAL && m_SkipCommercials)
+  {
+    constexpr std::chrono::milliseconds SKIP_MARGIN{100};
+    const std::chrono::milliseconds lead{
+        std::max(0ll, llrint(DVD_TIME_TO_MSEC(m_renderManager.GetDisplayLatency()))) +
+        SKIP_MARGIN.count()};
+    auto ahead = m_Edl.InEdit(correctClock + lead);
+    if (ahead && ahead.value()->action == EDL::Action::COMM_BREAK)
+    {
+      if (m_Edl.GetLastEditTime() != m_Edl.GetNextPlayableTime(ahead.value()->end))
+        CLog::Log(LOGDEBUG, "{} - Commercial break [{}] is less than {} ms ahead of the clock.",
+                  __FUNCTION__, StringUtils::MillisecondsToTimeString(ahead.value()->start),
+                  lead.count());
+      hasEdit = std::move(ahead);
+    }
+  }
+
   if (!hasEdit)
   {
     // @note: Users are allowed to jump back into EDL commercial breaks
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
index 3423abc..9d3ba1b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
@@ -177,6 +177,11 @@ public:
   void SetDelay(int delay) { m_videoDelay = delay; }
   int GetDelay() { return m_videoDelay; }
 
+  /*!
+   * \brief How far ahead of the clock the picture on screen is, in DVD clock units.
+   */
+  double GetDisplayLatency() const { return m_displayLatency; }
+
   void SetVideoSettings(const CVideoSettings& settings);
 
 protected:
@@ -259,7 +264,7 @@ protected:
   /// in milliseconds
   double m_latencyTweak = 0.0;
   /// Display latency updated in PrepareNextRender in DVD clock units, includes m_latencyTweak
-  double m_displayLatency = 0.0;
+  std::atomic<double> m_displayLatency = 0.0;
   std::atomic_int m_videoDelay = {};
 
   int m_QueueSize = 2;
-- 
