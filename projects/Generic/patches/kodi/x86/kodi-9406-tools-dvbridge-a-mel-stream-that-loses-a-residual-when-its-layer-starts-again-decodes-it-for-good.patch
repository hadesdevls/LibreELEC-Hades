From 77d742cb282ac0f6f87c0dbf3c2692371bc04139 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:35:15 +0000
Subject: [PATCH] tools/dvbridge: a MEL stream that loses a residual when its
 layer starts again decodes it for good

While the layer of a MEL stream is not decoded, an RPU that can carry a
residual starts it again. When that RPU comes at a random-access picture of
the layer, the layer starts there and is not kept: it stops again at the next
random-access picture whose RPU says no residual. But the leading pictures of
the picture it starts at refer to pictures that were not decoded: they go
without the layer, and when their RPU can carry a residual, that residual is
lost; and so again at every such start, whereas dvbridge_mel.h promises that
loss once a stream at most. Shown by an independent review on the MEL test
stream with FEL at two stretches: 2 pictures without their residual
with one start, 4 with two, 0 without the rule.

Now such a loss keeps the layer decoded for good in that stream, as a FEL RPU
within a group of pictures already does: the loss is once a stream at most.
A start whose leading pictures carry no residual, or that has none, keeps the
layer as before, so a stream that is MEL but for its starts loses no saving.

Tested on the host (the MEL test with the two stretches of the review):
2 pictures without their residual instead of 4, the layer decoded from the
first start to the end; and every other schedule as before. Not lost at all
would need the group of pictures before the start decoded after the fact: not
done here.
---
 tools/dvbridge/dvbridge_fel.c | 33 ++++++++++++++++++++++++++-------
 tools/dvbridge/dvbridge_mel.h |  6 ++++++
 2 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_fel.c b/tools/dvbridge/dvbridge_fel.c
index f188c6b..b9e30dc 100644
--- a/tools/dvbridge/dvbridge_fel.c
+++ b/tools/dvbridge/dvbridge_fel.c
@@ -228,6 +228,9 @@ struct dvbridge_fel {
      * of the last base picture the base decoder gave (dvbridge_fel_base_picture()), to know whether a carrier is
      * still to come. */
     int64_t packet_carrier[QUEUE_MAX];
+    /* Hades: the RPU of each queued access unit can carry a residual (dvbridge_mel.h: its own, or the one
+     * before it) */
+    bool packet_residual[QUEUE_MAX];
     struct { int64_t pts, carrier; struct dvbridge_fel_rpu rpu; } own[OWN_MAX];
     unsigned num_own;
     struct { int64_t pts; uint64_t seq; } recent[BASE_TIMES_MAX];
@@ -757,6 +760,8 @@ static void rank_try(struct dvbridge_fel *f)
             (f->num_packets - 1) * sizeof(*f->packet_rpu));
     memmove(f->packet_carrier + 1, f->packet_carrier + 1 + leading,
             (f->num_packets - 1) * sizeof(*f->packet_carrier));
+    memmove(f->packet_residual + 1, f->packet_residual + 1 + leading,
+            (f->num_packets - 1) * sizeof(*f->packet_residual));
     for (unsigned i = 0; i < f->num_early; ++i)
         own_identity(f, f->early[i].identity + delta, f->early[i].carrier, &f->early[i].rpu);
     early_forget(f);
@@ -996,17 +1001,28 @@ static bool pump(struct dvbridge_fel *f)
                     avcodec_flush_buffers(f->decoder);
                 f->fed = f->stopping = f->stopped = f->resume = false;
                 f->anchor_pts = timed && pts >= INT64_MIN + f->tolerance ? pts - f->tolerance : pts;
-            } else if (f->marked && f->anchor_pts != AV_NOPTS_VALUE && pts < f->anchor_pts &&
-                       f->packet_rpu[0].size) {
+            } else if (f->marked && f->anchor_pts != AV_NOPTS_VALUE && pts < f->anchor_pts) {
                 /* Hades: a leading picture of the random-access picture that the layer started
                  * again at: it refers to pictures that were not decoded, so its picture does not
                  * come (as after a seek) and it goes out without the layer; with the metadata of
                  * its own access unit (a mark, which answers before that). */
-                struct dvbridge_fel_rpu copy = {av_memdup(f->packet_rpu[0].data,
-                                                          f->packet_rpu[0].size),
-                                                f->packet_rpu[0].size};
-                if (copy.data)
-                    add_mark(f, pts, DVBRIDGE_LAYER_WANTED, &copy);
+                if (f->packet_rpu[0].size) {
+                    struct dvbridge_fel_rpu copy = {av_memdup(f->packet_rpu[0].data,
+                                                              f->packet_rpu[0].size),
+                                                    f->packet_rpu[0].size};
+                    if (copy.data)
+                        add_mark(f, pts, DVBRIDGE_LAYER_WANTED, &copy);
+                }
+                /* Hades: when its RPU can carry a residual, that residual is lost, and it would be
+                 * again at every random-access picture the layer starts again at: the layer is
+                 * decoded for good in this stream from here on (dvbridge_mel.h), so that this
+                 * happens once a stream at most. */
+                if (f->packet_residual[0] && !f->need.kept) {
+                    f->need.kept = true;
+                    f->need.kept_why = "a leading picture of a random-access picture that the layer "
+                                       "started again at can carry a residual, and refers to pictures "
+                                       "that were not decoded";
+                }
             }
             packet->pts = pts;
             packet->dts = AV_NOPTS_VALUE;
@@ -1035,6 +1051,7 @@ static bool pump(struct dvbridge_fel *f)
         memmove(f->packet_need, f->packet_need + 1, f->num_packets * sizeof(*f->packet_need));
         memmove(f->packet_rpu, f->packet_rpu + 1, f->num_packets * sizeof(*f->packet_rpu));
         memmove(f->packet_carrier, f->packet_carrier + 1, f->num_packets * sizeof(*f->packet_carrier));
+        memmove(f->packet_residual, f->packet_residual + 1, f->num_packets * sizeof(*f->packet_residual));
         if (!receive_frames(f))
             goto fail;
     }
@@ -1369,6 +1386,8 @@ bool dvbridge_fel_submit(struct dvbridge_fel *f, const AVPacket *packet)
          * picture should it not be decoded */
         f->packet_need[f->num_packets] = (uint8_t)dvbridge_layer_need_take(
             &f->need, rpu, f->enhancement_order.parser->key_frame == 1);
+        f->packet_residual[f->num_packets] =
+            f->need.last == DVBRIDGE_RPU_RESIDUAL || f->need.last == DVBRIDGE_RPU_UNREAD;
         struct dvbridge_rpu_find find = {0};
         dvbridge_rpu_units(copy->data, (size_t)copy->size, f->layer_length_size,
                            dvbridge_rpu_find_unit, &find);
diff --git a/tools/dvbridge/dvbridge_mel.h b/tools/dvbridge/dvbridge_mel.h
index b683087..34e32b5 100644
--- a/tools/dvbridge/dvbridge_mel.h
+++ b/tools/dvbridge/dvbridge_mel.h
@@ -41,6 +41,12 @@
  *     good in that stream: its RPUs change between MEL and FEL within groups of pictures, where
  *     leaving the layer out loses residuals. So that loss is once a stream at most, and never
  *     longer than until the next random-access picture of the layer.
+ *   - Where the RPU of the random-access picture itself can carry a residual, the layer starts
+ *     again there, and its leading pictures (presented before it, decoded after it) refer to
+ *     pictures that were not decoded: they go without the layer, as after a seek. When one of
+ *     them can carry a residual, that residual is lost, and the layer is decoded for good in that
+ *     stream from then on too (dvbridge_fel.c, pump()): it would be lost again at every such start.
+ *     So that loss, too, is once a stream at most.
  *   - An access unit without an RPU of its own changes nothing (its picture keeps the RPU before).
  * A seek, or the layer starting again for any other reason, starts it at a random-access picture
  * again (dvbridge_layer_need_restart()); what a stream showed stays. */
-- 
2.53.0

