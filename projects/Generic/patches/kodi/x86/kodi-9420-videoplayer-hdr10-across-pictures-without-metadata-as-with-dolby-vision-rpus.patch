+/*!
+ * \brief The HDR10+ InfoFrame of each picture of a stream across pictures without metadata of
+ *        their own, as Hades does with the RPUs of Dolby Vision (CDVDVideoCodecFFmpeg)
+ *
+ * Fewer than MISSING_MAX pictures in a row without metadata keep the InfoFrame of the last one
+ * that had it: the same scene, and no InfoFrame that comes and goes from one picture to the
+ * next. MISSING_MAX in a row leave HDR10+ (the output is plain HDR10); it comes back after BACK
+ * pictures in a row with metadata, twice as many each time it leaves again, up to BACK_MAX, so
+ * that metadata that keeps coming and going does not switch the output back and forth. A stream
+ * whose first pictures have none (fewer than MISSING_MAX) starts HDR10+ with the first that has.
+ *
+ * A stream may lack it: an AV1 one may not (HDR10+ AV1 Metadata Handling Specification v1.0.1,
+ * 2.2.2: one HDR10+ metadata OBU for each shown frame), and FFmpeg's HEVC decoder gives the
+ * metadata of the last SEI to the pictures after it until a flush. So this acts at the start of
+ * a stream, after a seek, and where a stream does without.
+ */
+class CGap
+{
+public:
+  static constexpr unsigned int MISSING_MAX = 12;
+  static constexpr unsigned int BACK = 48;
+  static constexpr unsigned int BACK_MAX = 1440;
+
+  //! The InfoFrame of the next picture, whose own is own (nothing without metadata)
+  std::optional<Payload> Picture(const std::optional<Payload>& own)
+  {
+    m_message.clear();
+    if (!own)
+    {
+      m_present = 0;
+      if (m_absent)
+        return std::nullopt;
+      if (++m_missing < MISSING_MAX)
+        return m_last;
+      if (m_returns)
+        m_back = std::min(m_back * 2, BACK_MAX);
+      m_absent = true;
+      if (m_last)
+        m_message = std::to_string(MISSING_MAX) +
+                    " pictures in a row without HDR10+ metadata: plain HDR10 until " +
+                    std::to_string(m_back) + " in a row have it";
+      m_last.reset();
+      return std::nullopt;
+    }
+    m_missing = 0;
+    if (m_absent)
+    {
+      if (++m_present < m_back)
+        return std::nullopt;
+      m_absent = false;
+      ++m_returns;
+      m_message = std::to_string(m_back) + " pictures in a row with HDR10+ metadata: HDR10+";
+    }
+    m_last = own;
+    return own;
+  }
+
+  //! A flush (a seek): nothing of the pictures before is held
+  void Flush()
+  {
+    m_missing = 0;
+    m_present = 0;
+    m_last.reset();
+  }
+
+  //! A new stream
+  void Reset() { *this = CGap(); }
+
+  //! What the last picture changed, for the log (empty for nothing)
+  const std::string& Message() const { return m_message; }
+
+private:
+  std::optional<Payload> m_last;
+  unsigned int m_missing = 0;
+  unsigned int m_present = 0;
+  unsigned int m_back = BACK;
+  unsigned int m_returns = 0;
+  bool m_absent = false;
+  std::string m_message;
+};
+
