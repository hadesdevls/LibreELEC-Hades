From e4040274dd5d6c17bfc1b6b211496a1f220608cc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:04:20 +0000
Subject: [PATCH] AudioSinkAE: the scale of the TrueHD sync error is the one of
 the audio engine's header

The sink told the clock the error of a TrueHD stream passed through divided by its own copy of the
factor 0.45 by which the audio engine scales that error before it averages it. The engine has the
factor in xbmc/cores/AudioEngine/Utils/TrueHDSyncScale.h (AE::TRUEHD_SYNC_ERROR_SCALE) now, for the
unit of the sync correction it counts; the sink uses that constant, so the two cannot differ. The
value is the same, 0.45: nothing changes in what is told to the clock.
---
 xbmc/cores/VideoPlayer/AudioSinkAE.cpp | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
index 8c3c91a..72769b7 100644
--- a/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
+++ b/xbmc/cores/VideoPlayer/AudioSinkAE.cpp
@@ -14,6 +14,7 @@
 #include "cores/AudioEngine/Interfaces/AE.h"
 #include "cores/AudioEngine/Utils/AEAudioFormat.h"
 #include "cores/AudioEngine/Utils/AEStreamData.h"
+#include "cores/AudioEngine/Utils/TrueHDSyncScale.h"
 #include "utils/XTimeUtils.h"
 #include "utils/log.h"
 
@@ -26,14 +27,6 @@ extern "C"
 
 using namespace std::chrono_literals;
 
-namespace
-{
-// Hades: the audio engine scales the error of TrueHD passed through by this before it averages and
-// tells it (CActiveAE::RunStages(): "underestimate error for TrueHD passthrough"); the clock is told
-// the error itself
-constexpr double TRUEHD_ERROR_SCALE = 0.45;
-} // namespace
-
 CAudioSinkAE::CAudioSinkAE(CDVDClock *clock) : m_pClock(clock)
 {
   m_bPassthrough = false;
@@ -123,7 +116,7 @@ unsigned int CAudioSinkAE::AddPackets(const DVDAudioFrame &audioframe)
       m_resampleRatio = info.rr;
       // Hades: where the sound is against the clock, in its own unit, for the A/V line
       m_heardError = m_bPassthrough && m_dataType == CAEStreamInfo::STREAM_TYPE_TRUEHD
-                         ? m_syncError / TRUEHD_ERROR_SCALE
+                         ? m_syncError / AE::TRUEHD_SYNC_ERROR_SCALE
                          : m_syncError;
       TellSyncError(true);
     }
