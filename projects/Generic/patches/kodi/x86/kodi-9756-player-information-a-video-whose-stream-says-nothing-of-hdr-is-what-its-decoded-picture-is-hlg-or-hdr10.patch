     std::unique_lock lock(g_dvStreamLabelsLock);
     // (Hades: an HLG stream sent as Dolby Vision is named as the HLG it is: StreamHdrName())
-    info["hades.src.hdrtype"] = KODI::GUILIB::GUIINFO::COREELEC::StreamHdrName(
-        g_dvStreamHdr, g_dvStreamOrigin, HDR10PlusInVideo());
+    info["hades.src.hdrtype"] = KODI::UTILS::PLAYERINFO::SourceHdrType(
+        KODI::GUILIB::GUIINFO::COREELEC::StreamHdrName(g_dvStreamHdr, g_dvStreamOrigin,
+                                                       HDR10PlusInVideo()),
+        g_dvStreamRecord.profile, decodedTransfer, HDR10PlusInVideo());
     if (info["hades.src.hdrtype"] == "dolbyvision" && g_dvStreamRecord.profile != 0)
       info["hades.src.dv"] = KODI::GUILIB::GUIINFO::COREELEC::FormatStreamDV(g_dvStreamRecord);
