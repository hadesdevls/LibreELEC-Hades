--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -260,6 +260,11 @@ public:
   KODI::UTILS::Colorimetry GetColorimetry() const override { return m_colorimetry; }
   KODI::UTILS::Eotf GetEotf() const override { return m_eotf; }
   bool SetHDR(const VideoPicture* videoPicture) override;
+  //! Hades: what the video says of itself (GetSourceColour()) is that of this picture. SetHDR()
+  //! takes it from the picture it is given; a renderer that gives SetHDR() a picture made for the
+  //! output (an HDR10 or HLG picture mapped to SDR, or adapted to the display) tells the picture of
+  //! the video after it.
+  void NoteSourceColour(const VideoPicture* picture);
   void SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& payload) override;
   bool IsHDRDisplay() override;
   CHDRCapabilities GetDisplayHDRCapabilities() const override;
@@ -363,12 +368,15 @@ protected:
   //! when SetHDR() was given its picture: its colour (primaries, transfer function, range), its
   //! matrix, its mastering display (max / min, cd/m2) and its light levels (MaxCLL / MaxFALL, or
   //! "none"); an empty part is not given. Empty while no video plays. From any thread.
+  //! (Hades: and its transfer function as a number, AVCOL_TRC_*, -1 while no video plays, for
+  //! what the video is where its stream does not say: PLAYERINFO::SourceHdrType())
   struct SourceColour
   {
     std::string colour;
     std::string matrix;
     std::string mastering;
     std::string cll;
+    int transfer = -1;
   };
   SourceColour GetSourceColour() const;
   //! Hades: the application version of the HDR10+ metadata that may go out to this display: the
@@ -887,7 +895,6 @@ private:
   //! Hades: GetSourceColour()
   mutable std::mutex m_sourceColourLock;
   SourceColour m_sourceColour;
-  void NoteSourceColour(const VideoPicture* picture);
   //! Hades: the state before a change of it that is not known to have gone out (SettleHDR())
   std::optional<CHDRSignal::Before<CDRMPropertyBlob>> m_hdrBefore;
   //! Hades: ... and the end of the HDR signalling, followed until the kernel has it, and asked for
