       {"hades.out.eotf", CHDROutputRead::Label(ReadOutputEotf())}};
   // Hades: what the video stream is (COREELEC::StreamHdrName()), and its Dolby Vision configuration
   // record where that is its own, not made by Hades of its HDR10+ metadata or measured from its
-  // picture (COREELEC::FormatStreamDV()); nothing before its video stream is opened
+  // picture (COREELEC::FormatStreamDV()); nothing before its video stream is opened. (Hades: and,
+  // where the stream says nothing of HDR, what its decoded picture is: SourceHdrType())
   {
