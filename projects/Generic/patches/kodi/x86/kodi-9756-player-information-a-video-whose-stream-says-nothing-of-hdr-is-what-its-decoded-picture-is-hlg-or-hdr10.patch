diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index aa3ea44..9521a84 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -304,6 +304,38 @@ inline std::string DecoderApi(const std::string& name)
   return "";
 }
 
+/*!
+ * \brief What the video is (hades.src.hdrtype): what its stream says, or, where the stream says
+ *        nothing of HDR, what its decoded picture is
+ *
+ * The stream's HDR type is the demuxer's, from the transfer function that the container or the
+ * stream says when it opens (VideoPlayer.HdrType). A stream that says none there, as an add-on's
+ * stream of YouTube in HLG may, was named SDR while its pictures are HLG (ARIB STD-B67), and the
+ * display was sent HLG for them (CWinSystemGbm::SetHDR() goes by the picture). The transfer
+ * function of the decoded picture names it then: HLG, or PQ (HDR10, or HDR10+ while its frames
+ * carry that metadata). Not a stream with a Dolby Vision configuration record, nor one that says
+ * what it is.
+ * \param stream what the stream says: sdr, hdr10, hdr10plus, hlg or dolbyvision
+ *        (COREELEC::StreamHdrName()), or empty where no video stream is open
+ * \param dvProfile the profile of its Dolby Vision configuration record, 0 without one
+ * \param transfer the transfer function of its decoded picture (AVCOL_TRC_*: 16 PQ, 18 HLG), -1
+ *        before one is known (CWinSystemGbm::SourceColour)
+ * \param hdr10PlusNow its frames carry HDR10+ metadata
+ */
+inline std::string SourceHdrType(const std::string& stream,
+                                 int dvProfile,
+                                 int transfer,
+                                 bool hdr10PlusNow)
+{
+  if (stream != "sdr" || dvProfile != 0)
+    return stream;
+  if (transfer == 18)
+    return "hlg";
+  if (transfer == 16)
+    return hdr10PlusNow ? "hdr10plus" : "hdr10";
+  return stream;
+}
+
 // ---- the badges
 
 //! "Dolby Vision · FEL", "Dolby Vision · P8.1", "HDR10+", "HDR10", "HLG", "SDR"
