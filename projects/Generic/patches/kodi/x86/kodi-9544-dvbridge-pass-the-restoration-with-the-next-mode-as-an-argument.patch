From f484676a7a1773931b51f5150a20348e849b6e20 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:47:21 +0000
Subject: [PATCH] [DVBridge] Pass the restoration with the next mode as an
 argument

Whether the restoration of the ordinary output goes out with the mode that Kodi sets next, in one
commit, was the member m_dvRestoreWithMode: set by SetFullScreen() around its call of
EndDVBridge(), saved, overwritten with the pending move of CDVModeMove and put back by EndDVBridge()
around its call of FlipDVBridgePage(), and read there. A parameter passed through a member, in two
classes, is a state that outlives the call it is meant for when anything in between returns early.

It is now an argument: EndDVBridge(tellModeset, withMode), which SetFullScreen() calls with true,
and FlipDVBridgePage(state, restore, flip, withMode), which EndDVBridge() calls with
withMode || m_dvMovePending, as the member had it. Every other caller passes false, the member's
value outside that call. Nothing that runs changes.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp            |  9 ++++++---
 xbmc/windowing/gbm/WinSystemGbm.h              | 10 ++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 14 +++++---------
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h   |  4 +++-
 4 files changed, 20 insertions(+), 17 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index da17f65..a371e9e 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1752,7 +1752,10 @@ bool CWinSystemGbm::CheckDisplayChange(bool& another)
   return back || dvChanged;
 }
 
-bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore, DVFlip* flip)
+bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state,
+                                     bool restore,
+                                     DVFlip* flip,
+                                     bool withMode)
 {
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   if (!drm || !m_GBM || !state.Captured())
@@ -1796,7 +1799,7 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore, DVFlip
   // modeset anyway. The kernel backends already get a full modeset when their tunnel property
   // changes.
   // Not either where the restoration is committed with the mode that Kodi sets next
-  // (m_dvRestoreWithMode, see SetFullScreen() of the GLES context): turning the head on in the
+  // (withMode, see SetFullScreen() of the GLES context): turning the head on in the
   // mode of the video and setting the next mode right after it are two changes of the HDMI link
   // in a row. In the tests of 2026-10-14 (RTX 4080 SUPER, LG C5) going back that way to a GUI
   // mode that needs HDMI FRL (2160p at 119.88 Hz, or at 60 Hz with 12 bits) took 2.5 to 3.8 s,
@@ -1804,7 +1807,7 @@ bool CWinSystemGbm::FlipDVBridgePage(CDVBridgeState& state, bool restore, DVFlip
   // display engine ("Lost display notification"), and from then on no flip came and the head
   // could not be set again. With the next mode in the same commit the output changes once, as
   // when an HDR10 video ends; that mode is another one, so the head is set from scratch anyway.
-  if (valid && restore && !m_dvRestoreWithMode && drm->IsActive() &&
+  if (valid && restore && !withMode && drm->IsActive() &&
       state.CapturedBackend() == CDVBridgeState::Backend::NVIDIA)
   {
     drm->SetActive(false);
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index ce1f51b..0ebd271 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -89,7 +89,12 @@ public:
     //! waits (what FlipDVBridgePage() returns is whether that one was accepted)
     bool refused = false;
   };
-  bool FlipDVBridgePage(CDVBridgeState& state, bool restore, DVFlip* flip = nullptr);
+  //! \param withMode (Hades) a restoration goes out with the mode that is set for it, in the same
+  //!        commit, instead of turning the output off and on in the mode of the video
+  bool FlipDVBridgePage(CDVBridgeState& state,
+                        bool restore,
+                        DVFlip* flip = nullptr,
+                        bool withMode = false);
   //! Hades: the transport frame on the screen committed again as it is (its buffer, the
   //! properties of the transport), in a commit that waits for its flip: what paces a picture that
   //! is kept on the screen where no vblank can (video/dvkeepbycommit). False when it was refused,
@@ -292,9 +297,6 @@ protected:
   bool m_dispReset = false;
   //! Hades: SetFullScreen() has told the other subsystems of this change of mode already
   bool m_displayLostSent = false;
-  //! Hades: FlipDVBridgePage() restores the ordinary output with the mode that is set for it, in
-  //! the same commit, instead of turning the output off and on in the mode of the video
-  bool m_dvRestoreWithMode = false;
   //! Hades: the restoration ends a wait after a video (see the GLES context): FlipDVBridgePage()
   //! queues again, after the output state of before the video, the colorimetry and the HDR
   //! metadata that Kodi asked for last, which the renderer that went cleared meanwhile
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index bb55bc3..1cd1ed9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -271,9 +271,7 @@ bool CWinSystemGbmGLESContext::SetFullScreen(bool fullScreen,
     before = m_DRM->GetSelectedMode();
     if (m_DRM->SetMode(res))
     {
-      m_dvRestoreWithMode = true;
-      const bool restored = EndDVBridge();
-      m_dvRestoreWithMode = false;
+      const bool restored = EndDVBridge(true, true);
       if (restored)
         CLog::Log(LOGINFO,
                   "DVBridge: native Dolby Vision output left with the change of mode to "
@@ -3003,7 +3001,7 @@ bool CWinSystemGbmGLESContext::DestroyWindow()
   return CWinSystemGbmEGLContext::DestroyWindow();
 }
 
-bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset)
+bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset, bool withMode)
 {
   // (Any restoration ends the wait of EndDVBridgeAfterVideo(). One that ends it puts back, after the
   // output state of before the video, what Kodi has asked for since: the renderer that went cleared
@@ -3050,14 +3048,12 @@ bool CWinSystemGbmGLESContext::EndDVBridge(bool tellModeset)
     // Hades: leaving the transport is a full modeset with every backend: told as a change of mode
     // (CHeldModeAnnouncement::Modeset()), unless the change of mode that it goes with tells of
     // itself, it is made again after a refusal, or the window goes
-    const bool joinedByCaller = m_dvRestoreWithMode;
-    if (tellModeset && m_dvState.TransportLive() && !joinedByCaller && !m_dvRestoreFailures)
+    if (tellModeset && m_dvState.TransportLive() && !withMode && !m_dvRestoreFailures)
       m_modeAnnounce.Modeset();
     // Hades: a mode that native output moved into, and that no frame of it carried (CDVModeMove),
     // goes with this restoration, in one commit
-    m_dvRestoreWithMode = joinedByCaller || m_dvMovePending;
-    const bool restored = m_eglContext.TrySwapBuffers() && FlipDVBridgePage(m_dvState, true);
-    m_dvRestoreWithMode = joinedByCaller;
+    const bool restored = m_eglContext.TrySwapBuffers() &&
+                          FlipDVBridgePage(m_dvState, true, nullptr, withMode || m_dvMovePending);
     if (!restored)
     {
       // Retried once a second while the display refuses it (switched off): logged sparingly.
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 9de5069..83f26db 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -129,7 +129,9 @@ public:
   bool DVMeasurePicture(const CDVBridgeGLES::Layer& layer);
   //! \param tellModeset (Hades) the other subsystems are told of the modeset that leaving the
   //!        transport is (not while the window or the window system goes)
-  bool EndDVBridge(bool tellModeset = true);
+  //! \param withMode (Hades) the restoration goes out with the mode that the caller selected, in
+  //!        one commit (SetFullScreen(); FlipDVBridgePage()), and that change tells of itself
+  bool EndDVBridge(bool tellModeset = true, bool withMode = false);
   //! Hades: the end of native Dolby Vision output when its video stops (renderer teardown). Where
   //! Kodi then sets another mode of the size of the window (DVEndWaitsForMode(): with every
   //! backend), the ordinary output waits for that change of mode, DV_END_WAIT at most, with the
