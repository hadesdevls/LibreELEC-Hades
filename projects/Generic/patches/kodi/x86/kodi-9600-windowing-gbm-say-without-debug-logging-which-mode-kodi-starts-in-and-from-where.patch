From 9d4f372a48e283f90654658ced95ec3bd60fce3c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:14:47 +0000
Subject: [PATCH] [windowing/gbm] Say without debug logging which mode Kodi
 starts in, and from where

Kodi takes over an output in the mode that the console, or a Kodi before
it, left it in (FindCrtc()), and an output that is off in the mode its
display prefers (FindPreferredMode()). Both said it at the debug level
only. With a TV connected at boot, a display that shows nothing in that
mode shows nothing when Kodi starts either (issue #8 of the Hades
tracker: "No Signal" with the cable in at boot, a picture at 1920x1080
when it was plugged in later, and the signal lost at every 3840x2160
mode), and kodi.log did not say which mode that was.

Now at the info level:

  HDMI-A-1 is on (CRTC 85) in 3840x2160 @ 60 Hz (594000 kHz), as the
  console or a Kodi before left it: Kodi starts in that mode

  HDMI-A-1 is off: Kodi starts in the mode its display prefers,
  3840x2160 @ 60 Hz (594000 kHz)

The kernel log says how that mode went out on NVIDIA
(nvidia-open-kernel-modules-9044, "Hades: head N ..."). Nothing else
changes.
---
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index c2c3d5b..4dd4887 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -502,9 +502,13 @@ bool CDRMUtils::FindPreferredMode()
     if (current_mode->type & DRM_MODE_TYPE_PREFERRED)
     {
       m_mode = current_mode;
-      CLog::LogF(LOGDEBUG, "Found preferred mode: {}x{}{} @ {} Hz", m_mode->hdisplay,
-                 m_mode->vdisplay, m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "",
-                 m_mode->vrefresh);
+      // Hades: told without debug logging too, as the mode of the output where it was on is
+      // (FindCrtc()): the mode Kodi starts in
+      CLog::LogF(LOGINFO, "{} is off: Kodi starts in the mode its display prefers, {}x{}{} @ {} Hz "
+                          "({} kHz)",
+                 m_connector->GetName(), m_mode->hdisplay, m_mode->vdisplay,
+                 m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "", m_mode->vrefresh,
+                 m_mode->clock);
       break;
     }
 
@@ -1186,9 +1190,15 @@ bool CDRMUtils::FindCrtc()
     else if (m_orig_crtc->GetModeValid())
     {
       m_mode = m_orig_crtc->GetMode();
-      CLog::LogF(LOGDEBUG, "Original crtc id: {}, mode: {}x{}{} @ {} Hz", m_crtc->GetCrtcId(),
-                 m_mode->hdisplay, m_mode->vdisplay,
-                 m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "", m_mode->vrefresh);
+      // Hades: told without debug logging too. Kodi starts in the mode the console (or a Kodi
+      // before) left the output in: a display that shows nothing in that mode shows nothing when
+      // Kodi starts either, which with a TV connected at boot is the first thing to know (issue
+      // #8). The kernel log says how the mode went out (nvidia-modeset: "Hades: head N ...").
+      CLog::LogF(LOGINFO, "{} is on (CRTC {}) in {}x{}{} @ {} Hz ({} kHz), as the console or a Kodi "
+                          "before left it: Kodi starts in that mode",
+                 m_connector->GetName(), m_crtc->GetCrtcId(), m_mode->hdisplay, m_mode->vdisplay,
+                 m_mode->flags & DRM_MODE_FLAG_INTERLACE ? "i" : "", m_mode->vrefresh,
+                 m_mode->clock);
     }
     return true;
   }
