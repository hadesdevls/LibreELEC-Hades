From a42be686dfdd1cbadc7baf0217669c9e1fed320c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] DVBridge: HDR10 as Dolby Vision, measured, where the output
 cannot send HDR10

i915 gives HDR_OUTPUT_METADATA to an HDMI connector of display version
10 or later only (Linux 7.3, intel_hdmi.c): on the native HDMI of
Skylake to Comet Lake (display version 9) Kodi sees no HDR display and
maps an HDR10 video to SDR. The Dolby Vision tunnel goes out there (RGB
at 8 bits and 297 MHz: the FEL of a profile 7 video plays on an HD
610), so where the display takes Dolby Vision, an HDR10 video can go
out as Dolby Vision with metadata measured from its picture, as
"HDR10 as Dolby Vision, measured" does, with its 12 bits through the
tunnel in place of an SDR mapping. The fork of CroqueMr sends the HDR
InfoFrame of display version 9 by its GMP; that kernel side is another
change, which needs a user with such a GPU to try it.

DVBRIDGE::Hdr10AsDolbyVision() now says yes, without the setting, where
this output cannot send HDR10 (CWinSystemGbm::IsHDRDisplay(): no
HDR_OUTPUT_METADATA on its connector, or a display that declares no
HDR10) and the display takes native Dolby Vision; as "Dolby Vision as
HDR10 when needed" does the other way. Not where the output sends
HDR10, nor where the video's own choice keeps native output away.
<video><dvfromhdr10whenneeded>false</dvfromhdr10whenneeded></video> in
advancedsettings.xml turns it off for a comparison. kodi.log says it
once, and the player information gives "measured by Hades from the
picture (this output cannot send HDR10)". English and Spanish.
---
 .../resource.language.en_gb/strings.po        |  6 ++++
 .../resource.language.es_es/strings.po        |  6 ++++
 .../xml/DialogPlayerProcessInfo.xml           |  5 +++
 xbmc/settings/AdvancedSettings.cpp            |  2 ++
 xbmc/settings/AdvancedSettings.h              |  4 +++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 36 ++++++++++++++++---
 6 files changed, 55 insertions(+), 4 deletions(-)

diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index 087ffb2..23fbbc7 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -2938,3 +2938,9 @@ msgstr ""
 msgctxt "#32263"
 msgid "The gamut that Dolby Vision Low-Latency is mapped into, inside BT.2020. Applies from the next video."
 msgstr ""
+
+#. Hades: the value of the row "RPU" on the Dolby Vision page of the player information: measured from the picture of an HDR10 video because this output cannot send HDR10 (its driver has no HDR metadata for it) and the display takes Dolby Vision
+#: /xml/DialogPlayerProcessInfo.xml
+msgctxt "#32273"
+msgid "measured by Hades from the picture (this output cannot send HDR10)"
+msgstr ""
diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index 57acf82..fdce46e 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -2793,3 +2793,9 @@ msgstr "Low-Latency: colores de la pantalla"
 msgctxt "#32263"
 msgid "The gamut that Dolby Vision Low-Latency is mapped into, inside BT.2020. Applies from the next video."
 msgstr "La gama a la que se mapea Dolby Vision Low-Latency, dentro de BT.2020. Se aplica desde el siguiente vídeo."
+
+#. Hades: the value of the row "RPU" on the Dolby Vision page of the player information: measured from the picture of an HDR10 video because this output cannot send HDR10 (its driver has no HDR metadata for it) and the display takes Dolby Vision
+#: /xml/DialogPlayerProcessInfo.xml
+msgctxt "#32273"
+msgid "measured by Hades from the picture (this output cannot send HDR10)"
+msgstr "medido por Hades en la imagen (esta salida no puede enviar HDR10)"
diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 4bed6d1..dd0f364 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -303,6 +303,11 @@
 					<param name="value" value="$LOCALIZE[32093]"/>
 					<param name="visible" value="String.IsEqual(Window(Home).Property(hades.dv.origin),measured)"/>
 				</include>
+				<include content="HadesInfoRow">
+					<param name="name" value="RPU"/>
+					<param name="value" value="$LOCALIZE[32273]"/>
+					<param name="visible" value="String.IsEqual(Window(Home).Property(hades.dv.origin),measuredauto)"/>
+				</include>
 				<include content="HadesInfoHeading">
 					<param name="label" value="$LOCALIZE[31803]"/>
 					<param name="top" value="14"/>
diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index c02e1e2..d26a96a 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -218,6 +218,7 @@ void CAdvancedSettings::Initialize()
   m_videoDVStartSignal = true;
   m_videoDVMmrTable = false;
   m_videoDVCm40Default = false;
+  m_videoDVFromHdr10WhenNeeded = true;
   m_videoDVMeasuredNoAvgFloor = false;
   m_videoDVWarmup = true;
   m_videoSmoothPercentToTimeSeeking = true;
@@ -732,6 +733,7 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
     XMLUtils::GetBoolean(pElement, "dvstartsignal", m_videoDVStartSignal);
     XMLUtils::GetBoolean(pElement, "dvmmrtable", m_videoDVMmrTable);
     XMLUtils::GetBoolean(pElement, "dvcm40default", m_videoDVCm40Default);
+    XMLUtils::GetBoolean(pElement, "dvfromhdr10whenneeded", m_videoDVFromHdr10WhenNeeded);
     XMLUtils::GetBoolean(pElement, "dvmeasurednoavgfloor", m_videoDVMeasuredNoAvgFloor);
     XMLUtils::GetBoolean(pElement, "dvwarmup", m_videoDVWarmup);
     XMLUtils::GetBoolean(pElement, "smoothpercenttotimeseeking", m_videoSmoothPercentToTimeSeeking);
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index 17bccc6..62464a1 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -226,6 +226,10 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! video/dvcm40default; dvbridge_render_add_cm40_default()): a test of what a display of display
     //! management 4 does with it. Off, the default
     bool m_videoDVCm40Default;
+    //! Hades: an HDR10 video goes out as Dolby Vision measured from its picture where the output
+    //! cannot send HDR10 and the display takes Dolby Vision (video/dvfromhdr10whenneeded; true:
+    //! DVBRIDGE::Hdr10AsDolbyVision()); false for a comparison
+    bool m_videoDVFromHdr10WhenNeeded;
     //! Hades: HDR10 sent as Dolby Vision with metadata measured from the picture: the level 1 average is
     //! sent as measured, without dovi_tool's floor of content mapping v2.9 (819 codes;
     //! video/dvmeasurednoavgfloor; dvbridge_measured_params::avg_floor). Off, the default (with the floor)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 83ad784..51cd751 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1527,6 +1527,8 @@ std::atomic<int> g_dvStreamCompatibility{0};
 // ... and what its Dolby Vision is made from where it is not its own: 1 its HDR10+ metadata
 // (CDVDStreamInfo::doviFromHdr10Plus), 2 the picture, measured (CDVDStreamInfo::doviMeasured)
 std::atomic<int> g_dvStreamOrigin{0};
+// Hades: ... and 2 because this output cannot send HDR10 (DVBRIDGE::Hdr10AsDolbyVision())
+std::atomic<bool> g_dvHdr10Needed{false};
 // Hades: a picture of it was refused for its base layer (DVBRIDGE::BaseLayerRefused())
 std::atomic<bool> g_dvBaseRefused{false};
 
@@ -1804,11 +1806,35 @@ bool DVBRIDGE::ConversionEligible(const CDVDStreamInfo& stream, int toneMapMetho
 
 bool DVBRIDGE::Hdr10AsDolbyVision()
 {
-  if (!BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVFROMHDR10, false) ||
-      !NativeAllowed(GetOutputChoice()))
+  if (!NativeAllowed(GetOutputChoice()))
     return false;
   auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
-  return window && window->SupportsNativeDVOutput(true);
+  if (!window)
+    return false;
+  if (BoolSetting(SettingsNow(), CSettings::SETTING_VIDEOSCREEN_HADESDVFROMHDR10, false))
+  {
+    g_dvHdr10Needed = false;
+    return window->SupportsNativeDVOutput(true);
+  }
+  // Hades: where this output cannot send HDR10 at all (its connector has no HDR_OUTPUT_METADATA, as
+  // i915 has none for HDMI of display version 9 in Linux 7.3, intel_hdmi.c) and the display takes
+  // Dolby Vision, an HDR10 video goes out as Dolby Vision measured from its picture, as "Dolby Vision
+  // as HDR10 when needed" does the other way: without it Kodi maps it to SDR. Not where the display
+  // takes HDR10, nor with <video><dvfromhdr10whenneeded>false</dvfromhdr10whenneeded></video> in
+  // advancedsettings.xml (for a comparison).
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const bool allowed =
+      !component || component->GetAdvancedSettings()->m_videoDVFromHdr10WhenNeeded;
+  const bool needed = allowed && !window->IsHDRDisplay() && window->SupportsNativeDVOutput(true);
+  if (needed && !g_dvHdr10Needed.exchange(true))
+    CLog::Log(LOGINFO,
+              "DVBridge: this output cannot send HDR10 (its connector has no HDR_OUTPUT_METADATA, or "
+              "the display declares no HDR10) and the display takes Dolby Vision: an HDR10 video goes "
+              "out as Dolby Vision measured from its picture (HDR10 as Dolby Vision, when needed), "
+              "where Kodi would map it to SDR");
+  else if (!needed)
+    g_dvHdr10Needed = false;
+  return needed;
 }
 
 bool DVBRIDGE::Hdr10PlusAsDolbyVision()
@@ -4893,8 +4919,10 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
                                                         g_dvStreamCompatibility, true)
                            ? 2
                            : 0;
+    // (Hades: measured because this output cannot send HDR10: DVBRIDGE::Hdr10AsDolbyVision())
     if (origin)
-      info["hades.dv.origin"] = origin == 2 ? "measured" : "hdr10plus";
+      info["hades.dv.origin"] = origin == 2 ? (g_dvHdr10Needed ? "measuredauto" : "measured")
+                                            : "hdr10plus";
     if (d.l1[0] >= 0)
       info["hades.dv.l1"] = StringUtils::Format("{:.4f} / {:.0f} / {:.0f}", PQToNits(d.l1[0]),
                                                 PQToNits(d.l1[1]), PQToNits(d.l1[2]));
