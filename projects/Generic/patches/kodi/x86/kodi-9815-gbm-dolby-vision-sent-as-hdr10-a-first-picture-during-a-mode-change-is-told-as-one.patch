From b2a175e0e93a674ce6254428c6bed033c50ec461 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:40:06 +0000
Subject: [PATCH] GBM: Dolby Vision sent as HDR10+, a first picture during a
 mode change is told as one

The line "neither the vblanks nor the flips of the output can be timed
now" came from the first picture of a video, while the output was
going to the mode of the video (cinema-ONE's log of 1.0 RC5, RX 7600: at
08:52:07.906, with the new mode at 08:52:08.295). While a CRTC changes
mode the kernel keeps its vblank off with a reference held
(drm_crtc_vblank_off(); drm_vblank_get() then gives -EINVAL to both
CRTC_GET_SEQUENCE and WAIT_VBLANK), and no flip of the new mode is
timed yet. Every scene change after it was timed by the vblank (5 of 5
and 7 of 7 in that log), so the line was wrong to say that the output
cannot be timed.

A first picture of a scene with nothing to time it by is now taken as
one of a mode change where a mode set is pending (CDRMAtomic::
ModesetPending()), the display is being reset after one (m_dispReset),
or it is the first picture of the video and the vblank gave EINVAL. It
is counted apart ("... while the output changed mode" in the line of
every 240 pictures), and told once with what the ioctls gave; the line
of an output that cannot be timed is kept for the others.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 39 +++++++++++++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  2 +
 2 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 1f81c5d..c40ca76 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2147,6 +2147,7 @@ void CWinSystemGbmGLESContext::DVPlusEnd()
   m_dvPlusFrames = 0;
   m_dvPlusStartPts = DVD_NOPTS_VALUE;
   m_dvPlusStartsWaited = m_dvPlusStartsLate = m_dvPlusStartsNoTime = 0;
+  m_dvPlusStartsModeChange = 0;
   m_dvPlusStartsByVBlank = m_dvPlusStartsByFlip = 0;
   m_dvPlusStartsTooClose = 0;
   m_dvPlusNoVBlankTold = false;
@@ -2304,15 +2305,12 @@ std::optional<std::array<uint8_t, 27>> CWinSystemGbmGLESContext::DVConversionHDR
               "DVBridge: Dolby Vision sent as HDR10+: so far {} pictures with HDR10+ and {} without, "
               "{} scenes ({} first pictures with their own measurement, {} timed by the vblank "
               "and {} by the last flip; {} not measured by the next refresh, {} too close to it "
-              "to wait, {} with nothing to time it by), {} changes within a scene, {} pictures "
-              "measured, {} dropped; now {}",
+              "to wait, {} with nothing to time it by, {} while the output changed mode), {} "
+              "changes within a scene, {} pictures measured, {} dropped; now {}",
               c.sent, c.unsent, c.scenes, m_dvPlusStartsWaited, m_dvPlusStartsByVBlank,
               m_dvPlusStartsByFlip, m_dvPlusStartsLate, m_dvPlusStartsTooClose,
-              m_dvPlusStartsNoTime, c.changes,
-              c.measured, c.dropped,
-              send ? StringUtils::Format("maxRGB average {:.1f}, 99.98 % {:.1f} cd/m2",
-                                         stats.average / 10.0, stats.percentiles[8] / 10.0)
-                   : std::string("nothing (the frames go out as HDR10)"));
+              m_dvPlusStartsNoTime, m_dvPlusStartsModeChange, c.changes, c.measured, c.dropped,
+              send ? DVPlusValues(stats) : std::string("nothing (the frames go out as HDR10)"));
   }
   if (!send)
   {
@@ -2405,6 +2403,33 @@ void CWinSystemGbmGLESContext::DVPlusMeasure(const CDVBridgeGLES::Layer& layer,
       dvbridge_dvplus_wait_budget(SteadyNowNs(), anchor, period, DVBRIDGE_DVPLUS_WAIT_MARGIN);
   if (budget <= 0)
   {
+    // Hades: while the output changes mode, the kernel keeps the vblank of its CRTC off with a
+    // reference held (drm_crtc_vblank_off(); drm_vblank_get() then gives -EINVAL to both ioctls),
+    // and no flip of the new mode is timed yet: the first picture of a video comes then, when its
+    // mode goes out with the commit of its first frame (CModeChangeHold). That is not an output
+    // whose refreshes cannot be timed, and it is counted and told as what it is.
+    const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+    const bool modeChange =
+        timedBy == CDVPlusClock::Source::NONE &&
+        ((atomic && atomic->ModesetPending()) || m_dispReset ||
+         (m_dvPlusFrames <= 1 && m_dvPlusVBlankSeqError == EINVAL &&
+          (m_dvPlusVBlankLegacyError == EINVAL || m_dvPlusVBlankLegacyError == 0)));
+    if (modeChange)
+    {
+      if (++m_dvPlusStartsModeChange == 1)
+      {
+        const CDRMCrtc* crtc = m_DRM ? m_DRM->GetCrtc() : nullptr;
+        CLog::Log(LOGINFO,
+                  "DVBridge: Dolby Vision sent as HDR10+: the first picture of a scene came while "
+                  "the output changed mode (the vblank of CRTC {} is off during a mode set: {} by "
+                  "CRTC_GET_SEQUENCE, {} by WAIT_VBLANK), so it did not wait for its own "
+                  "measurement and goes out with the metadata measured before; the scenes after "
+                  "it are timed as usual",
+                  crtc ? crtc->GetCrtcId() : 0, strerror(m_dvPlusVBlankSeqError),
+                  m_dvPlusVBlankLegacyError ? strerror(m_dvPlusVBlankLegacyError) : "not asked");
+      }
+      return;
+    }
     // (Hades: timed, but too close to the next refresh to wait for anything; or nothing to time it by)
     ++(timedBy == CDVPlusClock::Source::NONE ? m_dvPlusStartsNoTime : m_dvPlusStartsTooClose);
     if (timedBy == CDVPlusClock::Source::NONE && !m_dvPlusNoVBlankTold)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 2f1d5b9..9da7e52 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -441,6 +441,8 @@ private:
   //! by then, or had no time to wait (no vblank to tell it)
   double m_dvPlusStartPts = DVD_NOPTS_VALUE;
   unsigned int m_dvPlusStartsWaited = 0, m_dvPlusStartsLate = 0, m_dvPlusStartsNoTime = 0;
+  //! Hades: first pictures of a scene that came while the output changed mode (DVPlusMeasure())
+  unsigned int m_dvPlusStartsModeChange = 0;
   bool m_dvPlusNoVBlankTold = false;
   //! ... of those that did, how many by the vblank and how many by the last flip (m_dvPlusClock)
   unsigned int m_dvPlusStartsByVBlank = 0, m_dvPlusStartsByFlip = 0;
-- 
2.53.0

