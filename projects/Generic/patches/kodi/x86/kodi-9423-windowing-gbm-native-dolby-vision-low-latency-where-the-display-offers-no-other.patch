+dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const VideoPicture& picture)
+{
+  dvbridge_hdr10_mapping mapping{};
+  const UTILS::DolbyVideoBlock dv = DVDolbyVideoBlock();
+  if (dv.valid && dv.lowLatency)
+  {
+    mapping.enabled = true;
+    mapping.curve = DVBRIDGE_HDR10_CURVE_BT2390;
+    mapping.target = DVBRIDGE_HDR10_TARGET_HDR10;
+    // the display of its Low-Latency input: its peak (a 12-bit PQ level in a version 2 block, cd/m2
+    // in a version 1 one) and its primaries; the white is D65, which the block does not give
+    mapping.peak = static_cast<float>(dv.version == 2 ? UTILS::PqLevelToNits(dv.targetMaxPq)
+                                                      : dv.targetMaxNits);
+    mapping.gamut = DVBRIDGE_HDR10_GAMUT_CUSTOM;
+    const double xy[8] = {dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY, 0.3127, 0.3290};
+    for (int i = 0; i < 8; ++i)
+      mapping.target_xy[i] = static_cast<float>(xy[i]);
+    if (picture.hasDisplayMetadata && picture.displayMetadata.has_primaries)
+    {
+      const auto& d = picture.displayMetadata;
+      const AVRational q[8] = {d.display_primaries[0][0], d.display_primaries[0][1],
+                               d.display_primaries[1][0], d.display_primaries[1][1],
+                               d.display_primaries[2][0], d.display_primaries[2][1],
+                               d.white_point[0],          d.white_point[1]};
+      mapping.source_known = true;
+      for (int i = 0; i < 8; ++i)
+        mapping.source_xy[i] = q[i].den ? static_cast<float>(av_q2d(q[i])) : 0.0f;
+      // primaries that are not a gamut are not used: then the BT.2020 of the signal
+      if (!dvbridge_hdr10_mapping_valid(&mapping))
+      {
+        mapping.source_known = false;
+        std::fill(std::begin(mapping.source_xy), std::end(mapping.source_xy), 0.0f);
+      }
+    }
+    if (!dvbridge_hdr10_mapping_valid(&mapping))
+    {
+      CLog::Log(LOGWARNING,
+                "DVBridge: the display's Dolby Vision block gives a Low-Latency target that cannot "
+                "be used (peak {:.0f} cd/m2, primaries {:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f}): "
+                "no Low-Latency",
+                mapping.peak, dv.redX, dv.redY, dv.greenX, dv.greenY, dv.blueX, dv.blueY);
+      mapping = dvbridge_hdr10_mapping{};
+    }
+  }
+  const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
+    if (a.enabled != b.enabled || a.source_known != b.source_known || a.peak != b.peak)
+      return false;
+    for (int i = 0; i < 8; ++i)
+      if (a.target_xy[i] != b.target_xy[i] || a.source_xy[i] != b.source_xy[i])
+        return false;
+    return true;
+  };
+  if (mapping.enabled && (!m_dvLowLatencyMappingSet || !same(mapping, m_dvLowLatencyMapping)))
+    CLog::Log(LOGINFO,
+              "DVBridge: Dolby Vision Low-Latency is mapped to the display by LibreELEC Hades (not by "
+              "Dolby's display management): to {:.0f} cd/m2 and the primaries {:.4f},{:.4f} "
+              "{:.4f},{:.4f} {:.4f},{:.4f} of its Dolby Vision block, with the BT.2390 curve, guided by "
+              "each scene's level 1 metadata; the colours of the source within {}; its black kept",
+              mapping.peak, mapping.target_xy[0], mapping.target_xy[1], mapping.target_xy[2],
+              mapping.target_xy[3], mapping.target_xy[4], mapping.target_xy[5],
+              mapping.source_known ? "the gamut of its mastering display"
+                                   : "BT.2020 (its mastering display is not known)");
+  m_dvLowLatencyMapping = mapping;
+  m_dvLowLatencyMappingSet = true;
+  return mapping;
+}
