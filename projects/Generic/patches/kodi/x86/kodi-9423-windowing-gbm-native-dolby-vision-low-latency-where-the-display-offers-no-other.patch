+bool CDVBridgeGLES::SetLowLatency(const dvbridge_hdr10_mapping* mapping)
+{
+  const bool was = m_lowLatencyOn;
+  m_lowLatencyOn = mapping != nullptr;
+  m_lowLatency = mapping ? *mapping : dvbridge_hdr10_mapping{};
+  const auto component = CServiceBroker::GetSettingsComponent();
+  m_llPattern = component && component->GetAdvancedSettings() &&
+                component->GetAdvancedSettings()->m_videoDVLLPattern;
+  bool taken = true;
+  if (m_renderer)
+  {
+    taken = dvbridge_render_set_low_latency(m_renderer, mapping);
+    dvbridge_render_set_ll_pattern(m_renderer, taken && mapping && m_llPattern);
+  }
+  else if (mapping)
+  {
+    // (taken by the renderer once there is one: Initialize())
+    taken = dvbridge_hdr10_mapping_valid(mapping) && mapping->enabled &&
+            mapping->target == DVBRIDGE_HDR10_TARGET_HDR10;
+  }
+  if (!taken)
+    m_lowLatencyOn = false;
+  if (m_lowLatencyOn != was || (m_lowLatencyOn && m_llPattern))
+    CLog::Log(LOGINFO, "DVBridge: native output {}{}",
+              m_lowLatencyOn ? "is Dolby Vision Low-Latency" : "is no longer Low-Latency",
+              m_lowLatencyOn && m_llPattern
+                  ? ", with the test pattern in place of the picture (advancedsettings.xml, "
+                    "dvllpattern)"
+                  : "");
+  return taken;
+}
