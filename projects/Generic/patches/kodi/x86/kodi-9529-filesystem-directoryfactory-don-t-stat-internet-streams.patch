From 61cfe285a60fba300880c6632bcd6f4dabc98d58 Mon Sep 17 00:00:00 2001
From: Daniil Gentili <daniil@daniil.it>
Date: Fri, 23 Oct 2026 11:57:58 +0200
Subject: [PATCH] [filesystem] DirectoryFactory: don't stat internet streams

Since the directory flag is loaded with CFile::Stat() before creating a
file directory, resolving an item for playback sends a HEAD request for
every internet stream. This adds a round trip to each start, e.g. on
every PVR channel switch, and a server that doesn't answer HEAD stalls
playback until the request times out (3 x 30 s with retries).

Skip the stat for internet streams, as before that change.
---
 xbmc/filesystem/DirectoryFactory.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/xbmc/filesystem/DirectoryFactory.cpp b/xbmc/filesystem/DirectoryFactory.cpp
index 44c5af2..eeb5f1c 100644
--- a/xbmc/filesystem/DirectoryFactory.cpp
+++ b/xbmc/filesystem/DirectoryFactory.cpp
@@ -134,7 +134,9 @@ IDirectory* CDirectoryFactory::Create(const CURL& url)
   struct __stat64 st = {};
   static constexpr auto excludedProtocols =
       make_set<std::string_view>({"upnp", "addons", "favourites", "sources"});
-  const bool exclude{excludedProtocols.contains(url.GetProtocol())};
+  // Stat-ing an internet stream costs a network round trip on every playback
+  const bool exclude{excludedProtocols.contains(url.GetProtocol()) ||
+                     URIUtils::IsInternetStream(url)};
   if (!exclude && CFile::Stat(URIUtils::SubstitutePath(url), &st) == 0)
   {
     item.SetFolder(S_ISDIR(st.st_mode));
-- 
2.53.0

