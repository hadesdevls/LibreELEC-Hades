From 0bd88414891150dcaffd0c83d02cc6ad575050ba Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:43:05 +0000
Subject: [PATCH] windowing/gbm: the HDR10+ graphics overlay flag while the GUI
 is over the video

PB27 of the HDR10+ InfoFrame has a graphics overlay flag (bit 7): the
picture sent holds graphics composed over the video, which the metadata
does not describe. Kodi always sent it 0.

CWinSystemGbm::SetHDR10Plus() sets it for each frame while Kodi composes
its GUI over the video: the OSD, a dialog or a menu, what
CGUIWindowManager::HasVisibleControls() counts (the same question that
decides whether the GUI plane is attached). Subtitles alone are no GUI
controls and leave it 0. The rest of the payload is the picture's.

What a display does with it is its own; the GPL code of Amlogic, read
as data, sends it 0 with the comment "only video, don't include
graphic" and passes on what an HDMI source sends.

Host test (hdr10plus_gap_test.cpp): the bit and nothing else; fails
against Kodi as it was, mutations caught.
---
 xbmc/utils/HDR10PlusVsif.h          | 19 +++++++++++++++++--
 xbmc/windowing/gbm/WinSystemGbm.cpp | 13 ++++++++++++-
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/xbmc/utils/HDR10PlusVsif.h b/xbmc/utils/HDR10PlusVsif.h
index a6cf33d..a76fa4d 100644
--- a/xbmc/utils/HDR10PlusVsif.h
+++ b/xbmc/utils/HDR10PlusVsif.h
@@ -74,8 +74,9 @@ inline uint8_t CodedMaxRgb(int64_t coded)
  *  - PB15..PB17: the number of Bezier curve anchors (4 bits, 9 at most), the knee point x and
  *    y (10 bits each, of the 12 of the metadata); PB18..PB26: the anchors (8 of their 10
  *    bits); all of them 0 without tone mapping;
- *  - PB27: graphics overlay 0 (the metadata is of the video only) and no delay 1 (it is sent
- *    with the frame it is of).
+ *  - PB27: graphics overlay 0 (the picture is the video only; WithGraphicsOverlay() sets it
+ *    where Kodi composes its GUI over the video) and no delay 1 (it is sent with the frame it
+ *    is of).
  * Every field comes from the picture's own metadata of its first processing window; nothing is
  * made up. Nothing when there is no window, or for an application version above 1.
  */
@@ -126,6 +127,20 @@ inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m)
   return p;
 }
 
+/*!
+ * \brief The payload with the graphics overlay flag (PB27, bit 7) set where overlay is true:
+ *        the picture sent holds graphics composed over the video, which the metadata does not
+ *        describe. Kodi sets it while it composes its GUI over the video (OSD, dialogs, menus),
+ *        not for subtitles alone (CWinSystemGbm::SetHDR10Plus()). The GPL code of Amlogic,
+ *        read as data, sends it 0 with the comment "only video, don't include graphic", and
+ *        passes on what an HDMI source sends; what a display does with it is its own.
+ */
+inline Payload WithGraphicsOverlay(Payload p, bool overlay)
+{
+  p[26] = static_cast<uint8_t>(overlay ? (p[26] | 0x80) : (p[26] & ~0x80));
+  return p;
+}
+
 /*!
  * \brief The HDR10+ InfoFrame of each picture of a stream across pictures without metadata of
  *        their own, as Hades does with the RPUs of Dolby Vision (CDVDVideoCodecFFmpeg)
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index f2d9242..ec1c80a 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -28,6 +28,7 @@
 #include "guilib/GUIComponent.h"
 #include "guilib/GUIUtils.h"
 #include "guilib/GUIWindowManager.h"
+#include "utils/HDR10PlusVsif.h"
 #include "messaging/ApplicationMessenger.h"
 #include "resources/LocalizeStrings.h"
 #include "resources/ResourcesComponent.h"
@@ -2234,8 +2235,18 @@ void CWinSystemGbm::ResetHDR10Plus()
   m_hdr10PlusTold = 0;
 }
 
-void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& payload)
+void CWinSystemGbm::SetHDR10Plus(const std::optional<std::array<uint8_t, 27>>& ownPayload)
 {
+  // Hades: the graphics overlay flag of HDR10+, while Kodi composes its GUI (OSD, dialogs, menus)
+  // over the video; subtitles are no GUI controls (CGUIWindowManager::HasVisibleControls())
+  std::optional<std::array<uint8_t, 27>> payload = ownPayload;
+  if (payload)
+  {
+    CGUIComponent* gui = CServiceBroker::GetGUI();
+    *payload = KODI::UTILS::HDR10PLUS::WithGraphicsOverlay(
+        *payload, gui && gui->GetWindowManager().HasVisibleControls());
+  }
+
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
   if (!connector)
-- 
