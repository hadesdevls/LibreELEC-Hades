 namespace
 {
+// The outputs of the ALSA driver as they are listed on the PC of the user (session of
+// 2026-10-17): the TV on the first HDMI output of the NVIDIA card, monitors on the second and
+// third, the fourth without a display; the analog output of a USB headset
+std::vector<FollowCandidate> Nvidia(bool tvListed)
+{
+  std::vector<FollowCandidate> outputs;
+  if (tvListed)
+    outputs.push_back(Output("hdmi:CARD=NVidia,DEV=0", PRESENT));
+  outputs.push_back(Output("hdmi:CARD=NVidia,DEV=1", PRESENT));
+  outputs.push_back(Output("hdmi:CARD=NVidia,DEV=2", PRESENT));
+  outputs.push_back(Output("hdmi:CARD=NVidia,DEV=3", ABSENT));
+  outputs.push_back(Output("@:CARD=G,DEV=0", UNKNOWN));
+  for (auto& output : outputs)
+    output.family = OutputFamily(output.name, "");
+  return outputs;
+}
