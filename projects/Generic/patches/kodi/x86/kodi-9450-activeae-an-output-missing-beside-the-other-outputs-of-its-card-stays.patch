+  EXPECT_EQ("hdmi:NVidia", OutputFamily("hdmi:CARD=NVidia,DEV=3", "HDA NVidia"));
+  EXPECT_EQ("@:PCH", OutputFamily("@:CARD=PCH,DEV=0", "HDA Intel PCH"));
+  EXPECT_EQ("iec958:Audio", OutputFamily("iec958:CARD=Audio,DEV=1", "USB Audio"));
+  // (no card in the name: the friendly name, which is the card's)
+  EXPECT_EQ("Default", OutputFamily("Default", "Default"));
+  EXPECT_EQ("Bluetooth", OutputFamily("bluez_sink.00_11.a2dp_sink", "Bluetooth"));
+  EXPECT_EQ("", OutputFamily("@", ""));
+  // ("CARD=" only as a parameter of its own)
+  EXPECT_EQ("HDA", OutputFamily("hdmi:XCARD=NVidia,DEV=0", "HDA"));
