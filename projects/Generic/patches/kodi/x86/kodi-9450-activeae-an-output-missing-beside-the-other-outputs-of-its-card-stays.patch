+/*!
+ * \brief Hades: the outputs of the same kind on the same card as an output, to tell an output that
+ * could not be opened when the outputs were listed from one whose card is not there
+ * \param name the driver's name of the output
+ * \param friendlyName its friendly name (CAEDeviceInfo::GetFriendlyName(): the name of its card)
+ * \return for an ALSA name with a card ("hdmi:CARD=NVidia,DEV=0"), its kind and its card
+ *         ("hdmi:NVidia"); else the friendly name; empty when there is neither
+ *
+ * The four HDMI outputs of an NVIDIA card are "hdmi:NVidia" all four; the analog output of the
+ * sound chip of a laptop ("@:CARD=PCH,DEV=0") is not of the family of the HDMI output of its
+ * integrated graphics ("hdmi:CARD=PCH,DEV=0"), which is gone when the laptop starts with its
+ * dedicated graphics only.
+ */
+inline std::string OutputFamily(const std::string& name, const std::string& friendlyName)
+{
+  const size_t colon = name.find(':');
+  if (colon != std::string::npos)
+  {
+    size_t at = name.find("CARD=", colon + 1);
+    while (at != std::string::npos && name[at - 1] != ':' && name[at - 1] != ',')
+      at = name.find("CARD=", at + 1);
+    if (at != std::string::npos)
+    {
+      const size_t start = at + 5;
+      const size_t end = name.find(',', start);
+      const std::string card =
+          name.substr(start, end == std::string::npos ? std::string::npos : end - start);
+      if (!card.empty())
+        return name.substr(0, colon) + ':' + card;
+    }
+  }
+  return friendlyName;
+}
+
+//! Whether an output of a family (OutputFamily()) is among the outputs; never for an empty one
+inline bool FamilyListed(const std::vector<FollowCandidate>& outputs, const std::string& family)
+{
+  if (family.empty())
+    return false;
+  for (const auto& output : outputs)
+  {
+    if (output.family == family)
+      return true;
+  }
+  return false;
+}
