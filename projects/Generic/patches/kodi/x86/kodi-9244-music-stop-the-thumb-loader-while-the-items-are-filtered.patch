From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 10 Oct 2026 17:16:06 +0200
Subject: [PATCH] [music] Stop the thumb loader while the items are filtered

CGUIWindowMusicNav runs the thumb loader over m_unfilteredItems, which
shares its items with m_vecItems. When the filter changes while the
loader is running, CGUIMediaWindow::OnFilterItems() rewrites the paths
of folder items the loader thread reads.

Stop the loader before filtering and restart it afterwards if it was
interrupted.

(cherry picked from commit 5cfdea9ac7d5e4678cd7a9fd71570bad69022724)
---
 xbmc/music/windows/GUIWindowMusicNav.cpp | 13 +++++++++++++
 xbmc/music/windows/GUIWindowMusicNav.h   |  1 +
 2 files changed, 14 insertions(+)

diff --git a/xbmc/music/windows/GUIWindowMusicNav.cpp b/xbmc/music/windows/GUIWindowMusicNav.cpp
index b767166..5290ab2 100644
--- a/xbmc/music/windows/GUIWindowMusicNav.cpp
+++ b/xbmc/music/windows/GUIWindowMusicNav.cpp
@@ -383,6 +383,19 @@ bool CGUIWindowMusicNav::Update(const std::string &strDirectory, bool updateFilt
   return false;
 }
 
+void CGUIWindowMusicNav::OnFilterItems(const std::string& filter)
+{
+  // stop before the item paths are changed, the loader thread reads them
+  const bool loading = m_thumbLoader.IsLoading();
+  if (loading)
+    m_thumbLoader.StopThread();
+
+  CGUIWindowMusicBase::OnFilterItems(filter);
+
+  if (loading)
+    m_thumbLoader.Load(*m_unfilteredItems);
+}
+
 bool CGUIWindowMusicNav::GetDirectory(const std::string &strDirectory, CFileItemList &items)
 {
   if (strDirectory.empty())
diff --git a/xbmc/music/windows/GUIWindowMusicNav.h b/xbmc/music/windows/GUIWindowMusicNav.h
index 8b6e2dc..7ec8bec 100644
--- a/xbmc/music/windows/GUIWindowMusicNav.h
+++ b/xbmc/music/windows/GUIWindowMusicNav.h
@@ -29,6 +29,7 @@ protected:
   // override base class methods
   bool Update(const std::string &strDirectory, bool updateFilterPath = true) override;
   bool GetDirectory(const std::string &strDirectory, CFileItemList &items) override;
+  void OnFilterItems(const std::string& filter) override;
   void UpdateButtons() override;
   void PlayItem(int iItem) override;
   void OnWindowLoaded() override;
