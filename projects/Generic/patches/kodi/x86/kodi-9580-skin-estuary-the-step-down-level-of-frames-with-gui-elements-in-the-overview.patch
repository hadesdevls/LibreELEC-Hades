diff --git a/addons/skin.estuary/xml/Variables.xml b/addons/skin.estuary/xml/Variables.xml
index 02d8985..62913cd 100644
--- a/addons/skin.estuary/xml/Variables.xml
+++ b/addons/skin.estuary/xml/Variables.xml
@@ -995,8 +995,11 @@
 	</variable>
 	<!-- (the fidelity step-down level of native Dolby Vision frames, hades.dv.step: 0 is the
 	     faithful picture; and, while the frames with GUI elements of a profile 5 picture convert
-	     the pixels drawn over with the simplified rounding, hades.dv.guiround, that it does) -->
+	     the pixels drawn over with the simplified rounding, hades.dv.guiround, that it does.
+	     Hades: hades.dv.step is the level of the frames without GUI elements; where the frames with
+	     them are drawn at another one, hades.dv.guistep, that one too: "level 0 · 2 with GUI") -->
 	<variable name="HadesInfoDVStepVar">
+		<value condition="!String.IsEmpty(Window(Home).Property(hades.dv.step)) + !String.IsEmpty(Window(Home).Property(hades.dv.guistep))">$LOCALIZE[31866] $INFO[Window(Home).Property(hades.dv.step)] · $INFO[Window(Home).Property(hades.dv.guistep)] $LOCALIZE[31788]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.step),0) + !String.IsEmpty(Window(Home).Property(hades.dv.guiround))">$LOCALIZE[31865] · $LOCALIZE[31873]</value>
 		<value condition="!String.IsEmpty(Window(Home).Property(hades.dv.step)) + !String.IsEmpty(Window(Home).Property(hades.dv.guiround))">$LOCALIZE[31866] $INFO[Window(Home).Property(hades.dv.step)] · $LOCALIZE[31873]</value>
 		<value condition="String.IsEqual(Window(Home).Property(hades.dv.step),0)">$LOCALIZE[31865]</value>
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 369c796..d725d32 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -3595,7 +3595,7 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
       {"hades.dv.notshown", ""}, {"hades.dv.gap", ""}, {"hades.dv.l1changes", ""},
       {"hades.dv.fel", ""}, {"hades.dv.gpu", ""}, {"hades.dv.headroom", ""},
       {"hades.dv.path", ""}, {"hades.dv.ahead", ""}, {"hades.dv.step", ""},
-      {"hades.dv.guiround", ""}, {"hades.dv.passes", ""},
+      {"hades.dv.guiround", ""}, {"hades.dv.guistep", ""}, {"hades.dv.passes", ""},
       // Hades: for the overview page of the player information
       {"hades.dv.l1pq", ""}, {"hades.dv.source", ""}, {"hades.dv.l2targets", ""},
       {"hades.dv.blocks", ""}, {"hades.dv.sent", ""}, {"hades.dv.notsent", ""},
@@ -3754,12 +3754,14 @@ void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
     {
       // How the frames are drawn: the way of the last one without GUI elements, whether they
       // are presented a frame ahead, and their fidelity step-down level. Hades: that of the frames
-      // without GUI elements of the format of the last frame (as the way: this page is a GUI
-      // element, and CDVGuiStep may draw its frames at another one)
+      // without GUI elements of the format of the last frame; and, where the last frame (with GUI
+      // elements: this page is one) was drawn at another one (CDVGuiStep), that one too
       if (m_dvPlainDirect >= 0)
         info["hades.dv.path"] = m_dvPlainDirect ? "direct" : "composed";
       info["hades.dv.ahead"] = m_dvAheadShown ? "yes" : "no";
       info["hades.dv.step"] = std::to_string(m_dvStepBase);
+      if (m_dvStepLevel != m_dvStepBase)
+        info["hades.dv.guistep"] = std::to_string(m_dvStepLevel);
       // Hades: the last frame (with GUI elements: this page is one) was drawn with the simplified
       // rounding under the GUI (CDVGuiLevel, level 2)
       if (m_dvGuiDrawn == 2)
