+bool CWinSystemGbmGLESContext::LatencyOn()
+{
+  if (!m_latencyOnRead)
+  {
+    m_latencyOnRead = true;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    m_latencyOn = !settings ||
+                  !settings->GetSetting(CSettings::SETTING_VIDEOPLAYER_HADESMEASUREDLATENCY) ||
+                  settings->GetBool(CSettings::SETTING_VIDEOPLAYER_HADESMEASUREDLATENCY);
+  }
+  return m_latencyOn;
+}
+
