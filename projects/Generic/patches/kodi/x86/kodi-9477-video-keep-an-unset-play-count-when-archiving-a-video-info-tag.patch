From ab3ab05d5eeee4f0f1066afc4d7cb0284a0845cb Mon Sep 17 00:00:00 2001
From: ksooo <kai.sommerfeld@gmx.com>
Date: Mon, 19 Oct 2026 20:19:55 +0200
Subject: [PATCH] [video] Keep an unset play count when archiving a video info
 tag

Since GetPlayCount() reports an unset play count as 0, archiving stored
0 for it. A listing reloaded from the directory cache then had a play
count of 0 set for every item that came without one. For plugin items
that hides the play count from the video database, so a video watched
in Kodi showed as unwatched after returning to a cached plugin listing.

(cherry picked from commit d157b14f13e824dedae4bb8e0fe1b85d00f1d787)
---
 xbmc/video/VideoInfoTag.cpp          |  2 +-
 xbmc/video/test/TestVideoInfoTag.cpp | 44 ++++++++++++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/VideoInfoTag.cpp b/xbmc/video/VideoInfoTag.cpp
index f87fa45..6de71a9 100644
--- a/xbmc/video/VideoInfoTag.cpp
+++ b/xbmc/video/VideoInfoTag.cpp
@@ -624,7 +624,7 @@ void CVideoInfoTag::Archive(CArchive& ar)
     ar << m_strShowTitle;
     ar << m_strAlbum;
     ar << m_artist;
-    ar << GetPlayCount();
+    ar << (IsPlayCountSet() ? GetPlayCount() : PLAYCOUNT_NOT_SET);
     ar << m_lastPlayed;
     ar << m_iTop250;
     ar << m_iSeason;
diff --git a/xbmc/video/test/TestVideoInfoTag.cpp b/xbmc/video/test/TestVideoInfoTag.cpp
index 7b72fb0..fdf6028 100644
--- a/xbmc/video/test/TestVideoInfoTag.cpp
+++ b/xbmc/video/test/TestVideoInfoTag.cpp
@@ -8,9 +8,11 @@
 
 #include "LangInfo.h"
 #include "ServiceBroker.h"
+#include "filesystem/File.h"
 #include "settings/Settings.h"
 #include "settings/SettingsComponent.h"
 #include "test/TestUtils.h"
+#include "utils/Archive.h"
 #include "utils/LanguageTag.h"
 #include "utils/SortUtils.h"
 #include "utils/StreamDetails.h"
@@ -268,6 +270,48 @@ TEST(TestVideoInfoTag, EpisodeBookmarkRoundTrip)
   EXPECT_DOUBLE_EQ(16066.5, reloaded.m_EpBookmark.totalTimeInSeconds);
 }
 
+namespace
+{
+class TestVideoInfoTagArchive : public testing::Test
+{
+protected:
+  TestVideoInfoTagArchive() : m_file(XBMC_CREATETEMPFILE(".ar")) {}
+  ~TestVideoInfoTagArchive() override { EXPECT_TRUE(XBMC_DELETETEMPFILE(m_file)); }
+
+  CVideoInfoTag StoredAndLoaded(CVideoInfoTag details)
+  {
+    CArchive store(m_file, CArchive::store);
+    details.Archive(store);
+    store.Close();
+
+    EXPECT_EQ(0, m_file->Seek(0, SEEK_SET));
+    CVideoInfoTag loaded;
+    CArchive load(m_file, CArchive::load);
+    loaded.Archive(load);
+    load.Close();
+    return loaded;
+  }
+
+  XFILE::CFile* m_file;
+};
+} // unnamed namespace
+
+TEST_F(TestVideoInfoTagArchive, AnUnsetPlayCountStaysUnset)
+{
+  ASSERT_NE(nullptr, m_file);
+  EXPECT_FALSE(StoredAndLoaded(CVideoInfoTag{}).IsPlayCountSet());
+}
+
+TEST_F(TestVideoInfoTagArchive, APlayCountOfZeroStaysSet)
+{
+  ASSERT_NE(nullptr, m_file);
+  CVideoInfoTag details;
+  details.SetPlayCount(0);
+  const CVideoInfoTag loaded{StoredAndLoaded(details)};
+  EXPECT_TRUE(loaded.IsPlayCountSet());
+  EXPECT_EQ(0, loaded.GetPlayCount());
+}
+
 TEST(TestVideoInfoTag, ReadTextEpisodeGuide)
 {
   CXBMCTinyXML doc;
