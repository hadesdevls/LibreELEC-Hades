     DVBRIDGE_HDR10_CURVE_SPLINE = 0, /* libplacebo's default tone mapping */
     DVBRIDGE_HDR10_CURVE_BT2390 = 1, /* the EETF of ITU-R BT.2390 */
+    /* Hades: the same curve with libplacebo's default knee (KS = 2 maxLum - 1 instead of the
+     * report's 1.5 maxLum - 0.5): what the display could show as mastered comes out darker, and
+     * what is above its peak keeps more of its gradation. A choice of the user, never a default. */
+    DVBRIDGE_HDR10_CURVE_BT2390_LIBPLACEBO = 2,
 };
 /* Hades: the knee of the BT.2390 curve, where the EETF of ITU-R BT.2390 puts it: KS = 1.5 maxLum - 0.5 (Report
  * ITU-R BT.2408-9 (03/2026) Annex 5, step 2, the text that BT.2390-12 now refers to for display mapping). It is the
  * knee offset of libplacebo's pl_tone_map_bt2390, whose KS is (1 + offset) maxLum - offset; libplacebo's own
  * default offset is 1.0 (KS = 2 maxLum - 1), which its header says differs from the spec. */
 #define DVBRIDGE_BT2390_KNEE_OFFSET 0.5f
+/* Hades: this bridge has DVBRIDGE_HDR10_CURVE_BT2390_LIBPLACEBO (for whoever builds against it) */
+#define DVBRIDGE_HDR10_CURVE_LIBPLACEBO_KNEE 1
+/* Hades: the curves as the log names them */
+static inline const char *dvbridge_hdr10_curve_name(enum dvbridge_hdr10_curve curve)
+{
+    return curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390"
+           : curve == DVBRIDGE_HDR10_CURVE_BT2390_LIBPLACEBO
+               ? "BT.2390 (with libplacebo's knee, KS = 2 maxLum - 1, as chosen)"
+               : "spline";
+}
+/* Hades: the curve of the setting videoscreen.hadesdvhdr10curve: 1 BT.2390 (the report's knee),
+ * 2 BT.2390 with libplacebo's knee, any other value the spline (as before: anything but 1 was the
+ * spline) */
+static inline enum dvbridge_hdr10_curve dvbridge_hdr10_curve_of_setting(int value)
+{
+    return value == 1   ? DVBRIDGE_HDR10_CURVE_BT2390
+           : value == 2 ? DVBRIDGE_HDR10_CURVE_BT2390_LIBPLACEBO
+                        : DVBRIDGE_HDR10_CURVE_SPLINE;
+}
 #define DVBRIDGE_HDR10_PEAK_MIN 10.0f
 #define DVBRIDGE_HDR10_PEAK_MAX 10000.0f
 /* Hades: the signal the mapped picture is written in. HDR10 (the default, 0): PQ in BT.2020, for a
