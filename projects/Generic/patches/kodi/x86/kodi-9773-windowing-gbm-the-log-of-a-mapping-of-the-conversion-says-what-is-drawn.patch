From 7990de927b44db6d1183d51dec06870cdc42ec4a Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:29:35 +0000
Subject: [PATCH] windowing/gbm: the log of a mapping of the conversion says
 what is drawn

When the mapping of the conversion changes, TakeDVConversionMapping() tells it
in the log. The line of the trim pass (7295f62) was put between the lines of the
mapping and the "else" that says a picture is sent as mastered, which became its
"else": with "Dolby Vision: leave out the trims" on, a picture mapped to the
display (or to SDR) was told as mapped and then as "sent as mastered, not
mapped" in the next line. The trim line was told for an HDR10 or HLG picture
mapped to SDR as well, which has no metadata to trim. And the two lines of a
mapping to SDR named the EOTF of BT.1886 also for the "Bright room" target of
a00a1a4, whose EOTF is the pure 2.2 power.

"Sent as mastered" is told only where the picture is not mapped, the trim line
only for a picture of Dolby Vision that is mapped with the trims on, and the SDR
lines name the EOTF of the target. Nothing but the log changes.

Host test (outside the tree): maplog_test.py takes the block of the log lines
from the tree, compiles it with a CLog that keeps them and runs it for the 40
combinations of the mapping; before this change, 13 of them fail.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 33 +++++++++++--------
 1 file changed, 19 insertions(+), 14 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index a2d819f..4912a8a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -4597,19 +4597,19 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
     if (mapping.enabled && mapping.target == DVBRIDGE_HDR10_TARGET_SDR && plain)
       CLog::Log(LOGINFO,
                 "DVBridge: an HDR picture (HDR10 or HLG) is mapped to an output that takes no HDR: "
-                "to its SDR signal (BT.709, the BT.1886 EOTF, its white at {} cd/m2 of the "
-                "source), with the BT.2390 curve, guided by the stream's HDR10 metadata; the "
-                "colours of the source within {} (the tone mapping method of a reference display)",
-                mapping.peak,
+                "to its SDR signal (BT.709, {}, its white at {} cd/m2 of the source), with the "
+                "BT.2390 curve, guided by the stream's HDR10 metadata; the colours of the source "
+                "within {} (the tone mapping method of a reference display)",
+                mapping.gamma22 ? "a pure 2.2 power as its EOTF" : "the BT.1886 EOTF", mapping.peak,
                 mapping.source_known ? "the gamut of its mastering display"
                                      : "BT.2020 (its mastering display is not known)");
     else if (mapping.enabled && mapping.target == DVBRIDGE_HDR10_TARGET_SDR)
       CLog::Log(LOGINFO,
                 "DVBridge: Dolby Vision is rebuilt and mapped to an output that takes no HDR10: to "
-                "its SDR signal (BT.709, the BT.1886 EOTF, its white at {} cd/m2 of the source), "
-                "with the BT.2390 curve, guided by each scene's level 1 metadata; the colours of "
-                "the source within {}",
-                mapping.peak,
+                "its SDR signal (BT.709, {}, its white at {} cd/m2 of the source), with the "
+                "BT.2390 curve, guided by each scene's level 1 metadata; the colours of the source "
+                "within {}",
+                mapping.gamma22 ? "a pure 2.2 power as its EOTF" : "the BT.1886 EOTF", mapping.peak,
                 mapping.source_known ? "the gamut of its mastering display"
                                      : "BT.2020 (its mastering display is not known)");
     else if (mapping.enabled)
@@ -4621,12 +4621,17 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVConversionMapping(
                 mapping.curve == DVBRIDGE_HDR10_CURVE_BT2390 ? "BT.2390" : "spline",
                 mapping.source_known ? "the gamut of its mastering display"
                                      : "BT.2020 (its mastering display is not known)");
-    if (mapping.enabled && mapping.trims)
-      CLog::Log(LOGINFO,
-                "DVBridge: the trim pass (level 2) of the metadata is applied to pictures mapped "
-                "to a display of {} cd/m2 where a block of its metadata is for that peak (SMPTE ST "
-                "2094-10, ETSI TS 103 572); videoscreen.hadesdvnotrims turns it off",
-                mapping.peak);
+    // (Hades: and the trim pass of the metadata of a picture of Dolby Vision that is mapped; the
+    // picture sent as mastered is told only where it is not mapped)
+    if (mapping.enabled)
+    {
+      if (mapping.trims && !plain)
+        CLog::Log(LOGINFO,
+                  "DVBridge: the trim pass (level 2) of the metadata is applied to pictures "
+                  "mapped to a display of {} cd/m2 where a block of its metadata is for that peak "
+                  "(SMPTE ST 2094-10, ETSI TS 103 572); videoscreen.hadesdvnotrims turns it off",
+                  mapping.peak);
+    }
     else if (m_dvConvertMappingSet)
       CLog::Log(LOGINFO, "DVBridge: Dolby Vision as HDR10 is sent as mastered, not mapped");
   }
