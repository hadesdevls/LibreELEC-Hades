+namespace WINDOWING
+{
+namespace GBM
+{
+/*!
+ * \brief The use and the temperature of the GPU that Kodi draws with, for the overview page of the
+ * player information
+ *
+ * Only what the driver of that GPU gives is read; what it does not give is not known, and nothing
+ * stands in for it:
+ * - amdgpu: the use from gpu_busy_percent (what the SMU firmware computes of the activity of its
+ *   cores) and the temperature of the channel labelled "edge" of its hwmon device (temp1; APUs have
+ *   no other).
+ * - nvidia: NVML (libnvidia-ml.so.1 of the driver's user space, loaded when it is first needed):
+ *   nvmlDeviceGetUtilizationRates() (gpu: the part of the last sample period in which a kernel ran
+ *   on the GPU) and nvmlDeviceGetTemperatureV() of the sensor of the GPU die. The device is found
+ *   by its PCI address, the one the kernel gives the DRM device.
+ * - i915 and xe: the use of the render engine from the driver's PMU, through perf (i915: the busy
+ *   time of rcs0 over the time the counter was enabled; xe: its active ticks over its total ticks),
+ *   which is the share of the time that engine was busy between two readings. The temperature only
+ *   where the driver has a hwmon device for the GPU, which they register for discrete GPUs alone
+ *   (i915: temp1, the package; xe: the channel labelled "pkg"). An integrated Intel GPU has no
+ *   temperature of its own: it is not known (the processor's temperature is on the row above).
+ * The use is that of the graphics engine on each driver, not of the video decoder.
+ *
+ * Reading can take time (amdgpu asks its SMU firmware; NVML talks to the driver and its
+ * initialisation takes long), so it is done by a thread of its own (CSampler), only when the page
+ * asks for it, and the thread that draws never waits for it: it asks, and takes the last reading
+ * that is whole. What is opened for the readings (NVML, the perf counters) is let go as soon as
+ * the page closes. Opening the counter of the render engine of xe holds the GT awake (forcewake)
+ * while it is open: on xe that is the cost of the reading while the page is visible.
+ */
+namespace GPUSENSORS
+{
+//! What was read of the GPU
+struct Reading
+{
+  bool read{false}; //!< a whole reading was taken (what is not in it is not known)
+  std::optional<unsigned int> busy; //!< per cent of the time the graphics engine was busy
+  std::optional<double> celsius; //!< the temperature of the GPU
+  std::string how; //!< where each value came from, or why it is not known (for the log)
+};
+
+//! The calls to perf, apart for a test
+struct PerfOps
+{
+  //! Opens a counter of a PMU on that CPU, reading its value and the time it has been enabled:
+  //! the file descriptor, or -1
+  std::function<int(uint32_t type, uint64_t config, int cpu)> open;
+  //! The value of a counter and how long it has been enabled, in ns
+  std::function<bool(int fd, uint64_t& value, uint64_t& enabled)> read;
+  std::function<void(int fd)> close;
+
+  static PerfOps System()
+  {
+    PerfOps ops;
+    ops.open = [](uint32_t type, uint64_t config, int cpu) {
+      perf_event_attr attr{};
+      attr.type = type;
+      attr.size = sizeof(attr);
+      attr.config = config;
+      attr.read_format = PERF_FORMAT_TOTAL_TIME_ENABLED;
+      // (an uncore PMU: counted for the whole system, on one CPU of its cpumask)
+      return static_cast<int>(
+          syscall(SYS_perf_event_open, &attr, -1, cpu, -1, PERF_FLAG_FD_CLOEXEC));
+    };
+    ops.read = [](int fd, uint64_t& value, uint64_t& enabled) {
+      uint64_t data[2]{};
+      ssize_t length;
+      do
+        length = ::read(fd, data, sizeof(data));
+      while (length < 0 && errno == EINTR);
+      if (length != static_cast<ssize_t>(sizeof(data)))
+        return false;
+      value = data[0];
+      enabled = data[1];
+      return true;
+    };
+    ops.close = [](int fd) { ::close(fd); };
+    return ops;
+  }
+};
+
+namespace DETAIL
+{
+//! The text of a small file (a sysfs attribute) without the end of its line; none when it cannot
+//! be read
+inline std::optional<std::string> ReadText(const std::string& path)
+{
+  const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return std::nullopt;
+  char buffer[256];
+  ssize_t length;
+  do
+    length = ::read(fd, buffer, sizeof(buffer) - 1);
+  while (length < 0 && errno == EINTR);
+  ::close(fd);
+  if (length < 0)
+    return std::nullopt;
+  std::string text(buffer, static_cast<size_t>(length));
+  while (!text.empty() && (text.back() == '\n' || text.back() == ' '))
+    text.pop_back();
+  return text;
+}
+
+//! A decimal integer that is the whole text
+inline std::optional<long long> ParseInteger(const std::string& text)
+{
+  if (text.empty())
+    return std::nullopt;
+  errno = 0;
+  char* end = nullptr;
+  const long long value = std::strtoll(text.c_str(), &end, 10);
+  if (errno != 0 || end == text.c_str() || *end != '\0')
+    return std::nullopt;
+  return value;
+}
+
+//! The value of key=... in a PMU's event description ("config=0x0", "event=0x02"), a hexadecimal
+//! number with its 0x, or decimal
+inline std::optional<uint64_t> EventTerm(const std::string& text, const std::string& key)
+{
+  size_t at = 0;
+  while (at <= text.size())
+  {
+    const size_t end = std::min(text.find(',', at), text.size());
+    const std::string term = text.substr(at, end - at);
+    if (term.size() > key.size() + 1 && term.compare(0, key.size(), key) == 0 &&
+        term[key.size()] == '=')
+    {
+      const std::string number = term.substr(key.size() + 1);
+      errno = 0;
+      char* stop = nullptr;
+      const unsigned long long value = std::strtoull(number.c_str(), &stop, 0);
+      if (errno != 0 || stop == number.c_str() || *stop != '\0')
+        return std::nullopt;
+      return value;
+    }
+    at = end + 1;
+  }
+  return std::nullopt;
+}
+
+//! The first bit of a field of a PMU's format ("config:0-11", "config:60-63", "config:5")
+inline std::optional<unsigned int> FormatShift(const std::string& text)
+{
+  constexpr const char* prefix = "config:";
+  if (text.compare(0, std::strlen(prefix), prefix) != 0)
+    return std::nullopt;
+  const std::string bits = text.substr(std::strlen(prefix));
+  const auto first = ParseInteger(bits.substr(0, bits.find('-')));
+  if (!first || *first < 0 || *first > 63)
+    return std::nullopt;
+  return static_cast<unsigned int>(*first);
+}
+
+//! dddd:bb:dd.f in hexadecimal (a domain may have more digits), as the kernel names a PCI function
+inline bool IsPciAddress(const std::string& name)
+{
+  const size_t colon = name.find(':');
+  if (colon == std::string::npos || colon < 4 || name.size() != colon + 8 ||
+      name[colon + 3] != ':' || name[colon + 6] != '.')
+    return false;
+  for (size_t i = 0; i < name.size(); ++i)
+  {
+    if (i == colon || i == colon + 3 || i == colon + 6)
+      continue;
+    if (!std::isxdigit(static_cast<unsigned char>(name[i])))
+      return false;
+  }
+  return name.back() >= '0' && name.back() <= '7';
+}
+
+//! The name of the last part of a path
+inline std::string LastPart(const std::string& path)
+{
+  const size_t slash = path.rfind('/');
+  return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+//! A temperature in degrees Celsius from a hwmon attribute in millidegrees; not one that a GPU at
+//! work cannot be at (a driver that has no reading may give 0 or a sentinel)
+inline std::optional<double> Plausible(long long millidegrees)
+{
+  const double celsius = static_cast<double>(millidegrees) / 1000.0;
+  if (celsius <= 0.0 || celsius > 150.0)
+    return std::nullopt;
+  return celsius;
+}
+
+//! The temperature of the hwmon device of a GPU: the first channel with one of the labels, in their
+//! order; with no labels on any channel, temp1. Channels that have labels, none of them wanted, are
+//! another sensor (memory, a board): not known then.
+inline std::optional<double> HwmonTemperature(const std::string& device,
+                                              const std::vector<std::string>& labels,
+                                              std::string& how)
+{
+  DIR* dir = opendir((device + "/hwmon").c_str());
+  if (!dir)
+  {
+    how = "the driver has no temperature sensor for this GPU";
+    return std::nullopt;
+  }
+  std::vector<std::string> names;
+  while (const dirent* entry = readdir(dir))
+    if (std::strncmp(entry->d_name, "hwmon", 5) == 0)
+      names.emplace_back(entry->d_name);
+  closedir(dir);
+  std::sort(names.begin(), names.end());
+  for (const auto& name : names)
+  {
+    const std::string base = device + "/hwmon/" + name + "/";
+    struct Channel
+    {
+      int number;
+      std::optional<std::string> label;
+    };
+    std::vector<Channel> channels;
+    bool labelled = false;
+    for (int number = 1; number <= 16; ++number)
+    {
+      const std::string prefix = base + "temp" + std::to_string(number);
+      if (access((prefix + "_input").c_str(), F_OK) != 0)
+        continue;
+      Channel channel{number, ReadText(prefix + "_label")};
+      labelled = labelled || channel.label.has_value();
+      channels.push_back(std::move(channel));
+    }
+    const Channel* chosen = nullptr;
+    for (const auto& wanted : labels)
+    {
+      for (const auto& channel : channels)
+        if (channel.label && *channel.label == wanted)
+        {
+          chosen = &channel;
+          break;
+        }
+      if (chosen)
+        break;
+    }
+    if (!chosen && !labelled && !channels.empty() && channels.front().number == 1)
+      chosen = &channels.front();
+    if (!chosen)
+      continue;
+    const std::string input = base + "temp" + std::to_string(chosen->number) + "_input";
+    const auto text = ReadText(input);
+    const auto value = text ? ParseInteger(*text) : std::nullopt;
+    const auto celsius = value ? Plausible(*value) : std::nullopt;
+    const std::string where =
+        name + " temp" + std::to_string(chosen->number) + (chosen->label ? " (" + *chosen->label + ")" : "");
+    how = celsius ? "from " + where
+                  : (value ? where + " gave " + std::to_string(*value) + ", not a temperature"
+                           : where + " could not be read");
+    return celsius;
+  }
+  how = "the driver gives no temperature of the GPU itself";
+  return std::nullopt;
+}
+
+//! A PMU of perf, by its name in sysfs
+struct Pmu
+{
+  std::string name;
+  std::string path; //!< its directory
+  uint32_t type{0};
+  int cpu{0};
+};
+
+inline std::optional<Pmu> FindPmu(const std::string& root, const std::string& name)
+{
+  Pmu pmu;
+  pmu.name = name;
+  pmu.path = root + "/sys/bus/event_source/devices/" + name;
+  const auto type = ReadText(pmu.path + "/type");
+  const auto number = type ? ParseInteger(*type) : std::nullopt;
+  if (!number || *number < 0 || *number > UINT32_MAX)
+    return std::nullopt;
+  pmu.type = static_cast<uint32_t>(*number);
+  // the first CPU of its cpumask ("0", "0-15", "0,8"), as perf takes it; 0 without one
+  if (const auto mask = ReadText(pmu.path + "/cpumask"))
+  {
+    const std::string first = mask->substr(0, mask->find_first_of(",-"));
+    if (const auto cpu = ParseInteger(first); cpu && *cpu >= 0 && *cpu < INT_MAX)
+      pmu.cpu = static_cast<int>(*cpu);
+  }
+  return pmu;
+}
+
+//! The name the kernel gives the PMU of a GPU: the driver's name and the PCI address with "_" for ":"
+inline std::string PmuName(const std::string& driver, const std::string& pci)
+{
+  std::string name = driver + "_" + pci;
+  std::replace(name.begin(), name.end(), ':', '_');
+  return name;
+}
+
+/*!
+ * \brief A counter whose share of a span of time is the use: i915's busy time of an engine over
+ * the time the counter was enabled, or xe's active ticks over its total ticks (two counters)
+ */
+class CBusyCounter
+{
+public:
+  CBusyCounter(const PerfOps& perf, const Pmu& pmu, uint64_t busy, std::optional<uint64_t> total)
+    : m_perf(perf)
+  {
+    m_busy = m_perf.open(pmu.type, busy, pmu.cpu);
+    if (m_busy >= 0 && total)
+    {
+      m_total = m_perf.open(pmu.type, *total, pmu.cpu);
+      if (m_total < 0)
+        Close();
+    }
+  }
+  ~CBusyCounter() { Close(); }
+  CBusyCounter(const CBusyCounter&) = delete;
+  CBusyCounter& operator=(const CBusyCounter&) = delete;
+
+  bool Opened() const { return m_busy >= 0; }
+
+  //! The share since the reading before; none at the first one, or when a counter could not be read
+  std::optional<unsigned int> Read()
+  {
+    if (m_busy < 0)
+      return std::nullopt;
+    uint64_t busy = 0;
+    uint64_t span = 0;
+    uint64_t enabled = 0;
+    if (!m_perf.read(m_busy, busy, enabled))
+      return Forget();
+    span = enabled;
+    if (m_total >= 0)
+    {
+      uint64_t unused = 0;
+      if (!m_perf.read(m_total, span, unused))
+        return Forget();
+    }
+    std::optional<unsigned int> share;
+    if (m_had && busy >= m_lastBusy && span > m_lastSpan)
+    {
+      const double part = static_cast<double>(busy - m_lastBusy) /
+                          static_cast<double>(span - m_lastSpan);
+      // (the two are read one after the other: a share a little over the whole is the whole)
+      share = static_cast<unsigned int>(std::clamp(part * 100.0 + 0.5, 0.0, 100.0));
+    }
+    m_had = true;
+    m_lastBusy = busy;
+    m_lastSpan = span;
+    return share;
+  }
+
+private:
+  std::optional<unsigned int> Forget()
+  {
+    m_had = false;
+    return std::nullopt;
+  }
+  void Close()
+  {
+    if (m_total >= 0)
+      m_perf.close(m_total);
+    if (m_busy >= 0)
+      m_perf.close(m_busy);
+    m_busy = -1;
+    m_total = -1;
+  }
+
+  const PerfOps& m_perf;
+  int m_busy{-1};
+  int m_total{-1};
+  bool m_had{false};
+  uint64_t m_lastBusy{0};
+  uint64_t m_lastSpan{0};
+};
+
+//! NVML, as nvml.h of the driver declares the few parts of it used here (checked against it)
+namespace NVML
+{
+struct Device;
+using DeviceHandle = Device*;
+struct Utilization
+{
+  unsigned int gpu;
+  unsigned int memory;
+};
+struct Temperature
+{
+  unsigned int version;
+  int sensorType;
+  int temperature;
+};
+//! NVML_STRUCT_VERSION(Temperature, 1)
+constexpr unsigned int TEMPERATURE_V1 = static_cast<unsigned int>(sizeof(Temperature)) | (1U << 24);
+constexpr int SUCCESS = 0; //!< NVML_SUCCESS
+constexpr int TEMPERATURE_GPU = 0; //!< NVML_TEMPERATURE_GPU, the sensor of the GPU die
+using Init = int (*)();
+using Shutdown = int (*)();
+using HandleByPciBusId = int (*)(const char*, DeviceHandle*);
+using UtilizationRates = int (*)(DeviceHandle, Utilization*);
+using TemperatureV = int (*)(DeviceHandle, Temperature*);
+} // namespace NVML
+
+/*!
+ * \brief NVML for one GPU: initialised when made, shut down when destroyed. The library stays
+ * loaded once it was loaded (unloading the driver's library from a process that goes on is not
+ * something NVML documents).
+ */
+class CNvml
+{
+public:
+  CNvml(const std::string& library, const std::string& pci)
+  {
+    void* handle = dlopen(library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+    {
+      m_why = "NVML could not be loaded";
+      return;
+    }
+    const auto symbol = [handle](const char* name) { return dlsym(handle, name); };
+    auto init = reinterpret_cast<NVML::Init>(symbol("nvmlInit_v2"));
+    m_shutdown = reinterpret_cast<NVML::Shutdown>(symbol("nvmlShutdown"));
+    auto byBus = reinterpret_cast<NVML::HandleByPciBusId>(symbol("nvmlDeviceGetHandleByPciBusId_v2"));
+    m_utilization = reinterpret_cast<NVML::UtilizationRates>(symbol("nvmlDeviceGetUtilizationRates"));
+    m_temperature = reinterpret_cast<NVML::TemperatureV>(symbol("nvmlDeviceGetTemperatureV"));
+    if (!init || !m_shutdown || !byBus)
+    {
+      m_why = "NVML has not the calls that are needed";
+      m_shutdown = nullptr;
+      return;
+    }
+    if (const int status = init(); status != NVML::SUCCESS)
+    {
+      m_why = "NVML could not be initialised (" + std::to_string(status) + ")";
+      m_shutdown = nullptr;
+      return;
+    }
+    if (const int status = byBus(pci.c_str(), &m_device); status != NVML::SUCCESS)
+    {
+      m_why = "NVML does not know the GPU " + pci + " (" + std::to_string(status) + ")";
+      m_device = nullptr;
+    }
+  }
+  ~CNvml()
+  {
+    if (m_shutdown)
+      m_shutdown();
+  }
+  CNvml(const CNvml&) = delete;
+  CNvml& operator=(const CNvml&) = delete;
+
+  void Read(Reading& reading, std::string& busyHow, std::string& temperatureHow) const
+  {
+    if (!m_device)
+    {
+      busyHow = temperatureHow = m_why;
+      return;
+    }
+    NVML::Utilization utilization{};
+    if (!m_utilization)
+      busyHow = "NVML has no utilisation call";
+    else if (const int status = m_utilization(m_device, &utilization); status != NVML::SUCCESS)
+      busyHow = "NVML gave no utilisation (" + std::to_string(status) + ")";
+    else if (utilization.gpu > 100)
+      busyHow = "NVML gave a utilisation of " + std::to_string(utilization.gpu);
+    else
+    {
+      reading.busy = utilization.gpu;
+      busyHow = "from NVML";
+    }
+    NVML::Temperature temperature{};
+    temperature.version = NVML::TEMPERATURE_V1;
+    temperature.sensorType = NVML::TEMPERATURE_GPU;
+    if (!m_temperature)
+      temperatureHow = "NVML has no temperature call";
+    else if (const int status = m_temperature(m_device, &temperature); status != NVML::SUCCESS)
+      temperatureHow = "NVML gave no temperature (" + std::to_string(status) + ")";
+    else if (const auto celsius = Plausible(static_cast<long long>(temperature.temperature) * 1000))
+    {
+      reading.celsius = celsius;
+      temperatureHow = "from NVML";
+    }
+    else
+      temperatureHow = "NVML gave " + std::to_string(temperature.temperature) + ", not a temperature";
+  }
+
+private:
+  NVML::Shutdown m_shutdown{nullptr};
+  NVML::UtilizationRates m_utilization{nullptr};
+  NVML::TemperatureV m_temperature{nullptr};
+  NVML::DeviceHandle m_device{nullptr};
+  std::string m_why;
+};
+} // namespace DETAIL
+
+/*!
+ * \brief The sensors of one GPU, by its DRM device number. Reading may wait for the driver: never
+ * on the thread that draws.
+ */
+class CGpu
+{
+public:
+  CGpu(const std::string& root, dev_t device, const std::string& nvml, const PerfOps& perf)
+    : m_root(root), m_number(device), m_perf(perf)
+  {
+    // the device of the DRM node: /sys/dev/char/<major>:<minor>/device, the PCI function
+    const std::string link = root + "/sys/dev/char/" + std::to_string(major(device)) + ":" +
+                             std::to_string(minor(device)) + "/device";
+    char real[PATH_MAX];
+    if (!realpath(link.c_str(), real))
+    {
+      m_why = "its device is not in sysfs";
+      return;
+    }
+    m_device = real;
+    char driver[PATH_MAX];
+    const ssize_t length = readlink((m_device + "/driver").c_str(), driver, sizeof(driver) - 1);
+    if (length > 0)
+    {
+      driver[length] = '\0';
+      m_driver = DETAIL::LastPart(driver);
+    }
+    if (DETAIL::IsPciAddress(DETAIL::LastPart(m_device)))
+      m_pci = DETAIL::LastPart(m_device);
+    if (m_driver == "nvidia" && !m_pci.empty())
+      m_nvml = std::make_unique<DETAIL::CNvml>(nvml, m_pci);
+    else if ((m_driver == "i915" || m_driver == "xe") && !m_pci.empty())
+      OpenEngineCounter();
+  }
+
+  dev_t Device() const { return m_number; }
+
+  //! Whether the use is a difference between two readings, and none has been taken yet
+  bool NeedsEarlierReading() const { return m_counter && m_counter->Opened() && !m_counted; }
+
+  Reading Read()
+  {
+    Reading reading;
+    reading.read = true;
+    std::string busyHow = "not read on this driver";
+    std::string temperatureHow = "not read on this driver";
+    if (m_device.empty())
+      busyHow = temperatureHow = m_why;
+    else if (m_driver == "amdgpu")
+    {
+      const auto text = DETAIL::ReadText(m_device + "/gpu_busy_percent");
+      const auto value = text ? DETAIL::ParseInteger(*text) : std::nullopt;
+      if (value && *value >= 0 && *value <= 100)
+      {
+        reading.busy = static_cast<unsigned int>(*value);
+        busyHow = "from gpu_busy_percent";
+      }
+      else
+        busyHow = text ? "gpu_busy_percent gave \"" + *text + "\"" : "gpu_busy_percent could not be read";
+      reading.celsius = DETAIL::HwmonTemperature(m_device, {"edge"}, temperatureHow);
+    }
+    else if (m_driver == "nvidia")
+    {
+      if (m_nvml)
+        m_nvml->Read(reading, busyHow, temperatureHow);
+      else
+        busyHow = temperatureHow = "the GPU has no PCI address";
+    }
+    else if (m_driver == "i915" || m_driver == "xe")
+    {
+      if (m_counter && m_counter->Opened())
+      {
+        reading.busy = m_counter->Read();
+        m_counted = true;
+        busyHow = reading.busy ? "from " + m_counterHow : m_counterHow + " could not be read";
+      }
+      else
+        busyHow = m_counterHow;
+      reading.celsius =
+          DETAIL::HwmonTemperature(m_device, m_driver == "xe" ? std::vector<std::string>{"pkg"}
+                                                              : std::vector<std::string>{},
+                                   temperatureHow);
+    }
+    reading.how = (m_driver.empty() ? std::string("GPU") : m_driver) +
+                  (m_pci.empty() ? std::string() : " " + m_pci) + ": use " + busyHow +
+                  "; temperature " + temperatureHow;
+    return reading;
+  }
+
+private:
+  void OpenEngineCounter()
+  {
+    std::optional<DETAIL::Pmu> pmu = DETAIL::FindPmu(m_root, DETAIL::PmuName(m_driver, m_pci));
+    // (i915 names the PMU of an integrated GPU, of which there is one, "i915": a discrete one has
+    // its address in the name, and one with that name would have been found)
+    if (!pmu && m_driver == "i915")
+      pmu = DETAIL::FindPmu(m_root, "i915");
+    if (!pmu)
+    {
+      m_counterHow = "the driver has no PMU for this GPU";
+      return;
+    }
+    std::optional<uint64_t> busy;
+    std::optional<uint64_t> total;
+    if (m_driver == "i915")
+    {
+      // the busy time of the first render engine, in ns
+      const auto text = DETAIL::ReadText(pmu->path + "/events/rcs0-busy");
+      busy = text ? DETAIL::EventTerm(*text, "config") : std::nullopt;
+      m_counterHow = pmu->name + " rcs0-busy";
+    }
+    else
+    {
+      // the active and total ticks of the first render engine of the first GT (engine class 0,
+      // instance 0, GT 0, function 0: only the event's own field is not 0)
+      const auto active = DETAIL::ReadText(pmu->path + "/events/engine-active-ticks");
+      const auto all = DETAIL::ReadText(pmu->path + "/events/engine-total-ticks");
+      const auto field = DETAIL::ReadText(pmu->path + "/format/event");
+      const auto shift = field ? DETAIL::FormatShift(*field) : std::nullopt;
+      const auto a = active ? DETAIL::EventTerm(*active, "event") : std::nullopt;
+      const auto t = all ? DETAIL::EventTerm(*all, "event") : std::nullopt;
+      if (shift && a && t)
+      {
+        busy = *a << *shift;
+        total = *t << *shift;
+      }
+      m_counterHow = pmu->name + " engine-active-ticks";
+    }
+    if (!busy)
+    {
+      m_counterHow = pmu->name + " has no busy counter of the render engine";
+      return;
+    }
+    m_counter = std::make_unique<DETAIL::CBusyCounter>(m_perf, *pmu, *busy, total);
+    if (!m_counter->Opened())
+      m_counterHow = m_counterHow + " could not be opened";
+  }
+
+  std::string m_root;
+  dev_t m_number;
+  const PerfOps& m_perf;
+  std::string m_device;
+  std::string m_driver;
+  std::string m_pci;
+  std::string m_why;
+  std::unique_ptr<DETAIL::CNvml> m_nvml;
+  std::unique_ptr<DETAIL::CBusyCounter> m_counter;
+  std::string m_counterHow;
+  bool m_counted{false};
+};
+
+/*!
+ * \brief Readings of the GPU by a thread of their own, for a caller that never waits for them
+ *
+ * Request() asks for a reading, Last() gives the last whole one, Release() lets go of what is
+ * open: none of them waits, for the reading or for a lock (Last() gives the reading it gave before
+ * when the thread holds the result for a moment). The caller asks again at its own pace (the
+ * player information: every 500 ms while it is visible). The thread is made with the first
+ * request, waits without a time limit while it has nothing open, and ends with this object, after
+ * the reading it may be taking: that is the only wait, when the window system goes.
+ */
+class CSampler
+{
+public:
+  struct Options
+  {
+    std::string root; //!< where /sys is ("" on the system; a tree of its own in a test)
+    std::string nvml{"libnvidia-ml.so.1"};
+    PerfOps perf{PerfOps::System()};
+    //! Between the first two readings of a use that is a difference
+    std::chrono::milliseconds firstSpan{500};
+  };
+
+  explicit CSampler(Options options) : m_options(std::move(options)) {}
+  ~CSampler()
+  {
+    m_stop = true;
+    {
+      // (taken and let go between the flag and the wake: the thread is then either before its
+      // test of the flags, and sees this one, or waiting, and is woken)
+      std::unique_lock lock(m_waitLock);
+    }
+    m_wake.notify_all();
+    if (m_thread.joinable())
+      m_thread.join();
+  }
+  CSampler(const CSampler&) = delete;
+  CSampler& operator=(const CSampler&) = delete;
+
+  //! Asks for a reading of the GPU of that DRM device number
+  void Request(dev_t device)
+  {
+    m_device = static_cast<uint64_t>(device);
+    m_asked = true;
+    if (!m_thread.joinable())
+    {
+      try
+      {
+        m_thread = std::thread(&CSampler::Run, this);
+      }
+      catch (const std::system_error&)
+      {
+        // no thread: nothing is read, and nothing is shown as read
+        return;
+      }
+    }
+    // (without the lock of the wait: a wake that comes between the thread's test of the flags and
+    // its wait is lost, and the next request wakes it; a thread with something open does not wait
+    // longer than WAIT)
+    m_wake.notify_all();
+  }
+
+  //! The last whole reading of the GPU of that DRM device number; not read when there is none
+  Reading Last(dev_t device)
+  {
+    std::unique_lock lock(m_resultLock, std::try_to_lock);
+    if (lock.owns_lock())
+    {
+      m_given = m_resultDevice == static_cast<uint64_t>(device) ? m_result : Reading{};
+      m_givenDevice = static_cast<uint64_t>(device);
+    }
+    return m_givenDevice == static_cast<uint64_t>(device) ? m_given : Reading{};
+  }
+
+  //! Lets go of what is open for the readings, and of the last reading
+  void Release()
+  {
+    m_asked = false;
+    m_release = true;
+    m_given = {};
+    m_givenDevice = 0;
+    m_wake.notify_all();
+  }
+
+  //! The longest a thread with something open waits for a wake that could have been lost
+  static constexpr std::chrono::milliseconds WAIT{250};
+
+private:
+  void Run()
+  {
+    pthread_setname_np(pthread_self(), "GPUSensors");
+    std::unique_ptr<CGpu> gpu;
+    const auto wanted = [this] { return m_stop || m_asked || m_release; };
+    while (!m_stop)
+    {
+      {
+        std::unique_lock lock(m_waitLock);
+        if (gpu)
+          m_wake.wait_for(lock, WAIT, wanted);
+        else
+          m_wake.wait(lock, wanted);
+      }
+      if (m_stop)
+        break;
+      if (m_release.exchange(false))
+      {
+        gpu.reset();
+        std::unique_lock lock(m_resultLock);
+        m_result = {};
+        m_resultDevice = 0;
+      }
+      if (!m_asked.exchange(false))
+        continue;
+      const dev_t device = static_cast<dev_t>(m_device.load());
+      if (!gpu || gpu->Device() != device)
+        gpu = std::make_unique<CGpu>(m_options.root, device, m_options.nvml, m_options.perf);
+      // a use that is a difference has its first two readings firstSpan apart: the first whole
+      // reading is the second
+      const bool first = gpu->NeedsEarlierReading();
+      Reading reading = gpu->Read();
+      if (first)
+      {
+        {
+          std::unique_lock lock(m_waitLock);
+          m_wake.wait_for(lock, m_options.firstSpan,
+                          [this] { return m_stop || m_release.load(); });
+        }
+        if (m_stop)
+          break;
+        if (m_release)
+          continue;
+        reading = gpu->Read();
+      }
+      if (m_release)
+        continue;
+      std::unique_lock lock(m_resultLock);
+      m_result = std::move(reading);
+      m_resultDevice = static_cast<uint64_t>(device);
+    }
+    gpu.reset();
+  }
+
+  Options m_options;
+  std::thread m_thread;
+  std::mutex m_waitLock;
+  std::condition_variable m_wake;
+  std::atomic<bool> m_stop{false};
+  std::atomic<bool> m_asked{false};
+  std::atomic<bool> m_release{false};
+  std::atomic<uint64_t> m_device{0};
+  std::mutex m_resultLock;
+  Reading m_result;
+  uint64_t m_resultDevice{0};
+  // (the caller's own, under no lock: only the caller touches them)
+  Reading m_given;
+  uint64_t m_givenDevice{0};
+};
