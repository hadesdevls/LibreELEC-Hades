From 0789bfe3348feeb2bc7b07022b61b325830a5d65 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:29:26 +0000
Subject: [PATCH] tools/dvbridge: level 3 offsets added to level 1 in the
 mapping to a display

SMPTE ST 2094-10:2021 6.1.6 to 6.1.9 (normative) define the level 3
offsets as values "in the same unit" as level 1 that are "to be added" to
it, with 0 <= min < avg < max <= 1 for the sums. libplacebo reads level 1
only (pl_map_avdovi_metadata(): max_pq_y and avg_pq_y), so the three uses
of map_to_display() (Dolby Vision as HDR10 mapped to the display, Dolby
Vision to SDR, Low-Latency) mapped content mapping v4.0 streams by a
content range that their level 3 corrects.

dvbridge_level1_effective() adds the offsets where 6.1.9 holds and keeps
level 1 alone where it does not: Dolby's tools write a black shot as level
1 at the floors of content mapping v2.9 with offsets down to 0, 0, 0, and
libplacebo takes a maximum of 0 as no metadata at all and maps from the
mastering display's peak (measured on the software bridge: Delta E ITP 6
to 57 on average). Without a level 3 block nothing changes, bit for bit;
the metadata sent to a display are untouched. Measured with the level 3 of
the streams at hand (averages under the v2.9 floors and black shots):
BT.2390, spline and SDR give the same bytes; an offset that a colourist
sets moves the mapping as the same change of level 1 does.

kodi.log says, once in a stream, the offsets of the first picture mapped
with them, and of the first picture whose offsets 6.1.9 refuses.
---
 tools/dvbridge/dvbridge_core.h                | 15 ++++++
 tools/dvbridge/dvbridge_placebo.c             | 37 ++++++++++++++
 tools/dvbridge/dvbridge_placebo.h             |  7 +++
 tools/dvbridge/dvbridge_render.c              | 49 +++++++++++++++++--
 tools/dvbridge/dvbridge_render.h              |  6 +++
 .../VideoRenderers/DVBridgeGLES.cpp           | 23 +++++++++
 6 files changed, 132 insertions(+), 5 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 1a9bb3b..a5ddedf 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -138,6 +138,21 @@ struct dvbridge_reading {
     bool scene_refresh;   /* the frame refreshes the scene */
     unsigned metadata_id;
 };
+/* Hades: level 1 with the offsets of level 3 added, as SMPTE ST 2094-10:2021 6.1.6 to 6.1.9 define them:
+ * offsets "in the same unit" as the level 1 values (PQ in [0, 1]) "to be added" to them, coded in an RPU
+ * as 2048 + 2048 x the offset (dovi_tool's XML import), and the sums have to keep 0 <= min < avg < max <= 1
+ * (6.1.9). Where they do not, the level 1 block alone is taken: Dolby's tools write a black shot of content
+ * mapping v4.0 as level 1 at the floors of v2.9 with offsets that bring it to 0, 0, 0, which 6.1.9 does not
+ * take, and libplacebo would take a maximum of 0 as no metadata at all (and map from the mastering
+ * display's peak). Only the mapping of a picture to a display reads this (dvbridge_level1_effective());
+ * the metadata sent to a display are the RPU's, untouched. */
+struct dvbridge_level1 {
+    bool level3;         /* the metadata have a level 3 block */
+    bool applied;        /* ... and its offsets are added (the sums keep 6.1.9) */
+    unsigned l1[3];      /* the level 1 block: min, max, avg (codes of 4095) */
+    int offset[3];       /* the level 3 block: the min, max and avg offsets in its codes, less 2048 */
+    float min, max, avg; /* PQ in [0, 1]: level 1 + level 3 where applied, else level 1 */
+};
 bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
                                 struct dvbridge_reading *reading);
 
diff --git a/tools/dvbridge/dvbridge_placebo.c b/tools/dvbridge/dvbridge_placebo.c
index d78d44a..ec8d82e 100644
--- a/tools/dvbridge/dvbridge_placebo.c
+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -263,3 +263,40 @@ bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
     out->repr.dovi = &out->dovi;
     return true;
 }
+
+bool dvbridge_level1_effective(const void *metadata, size_t bytes, struct dvbridge_level1 *out)
+{
+    if (!out || !metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata) ||
+        !dvbridge_dv_readable(metadata, bytes))
+        return false;
+    *out = (struct dvbridge_level1){0};
+    const AVDOVIMetadata *m = metadata;
+    const AVDOVIDmData *l1 = av_dovi_find_level(m, 1);
+    if (!l1)
+        return false;
+    out->l1[0] = l1->l1.min_pq;
+    out->l1[1] = l1->l1.max_pq;
+    out->l1[2] = l1->l1.avg_pq;
+    /* (as libplacebo maps level 1, so that a picture without level 3 is mapped as before) */
+    out->min = l1->l1.min_pq / 4095.0f;
+    out->max = l1->l1.max_pq / 4095.0f;
+    out->avg = l1->l1.avg_pq / 4095.0f;
+    const AVDOVIDmData *l3 = av_dovi_find_level(m, 3);
+    if (!l3)
+        return true;
+    out->level3 = true;
+    out->offset[0] = (int)l3->l3.min_pq_offset - 2048;
+    out->offset[1] = (int)l3->l3.max_pq_offset - 2048;
+    out->offset[2] = (int)l3->l3.avg_pq_offset - 2048;
+    const double mn = l1->l1.min_pq / 4095.0 + out->offset[0] / 2048.0;
+    const double mx = l1->l1.max_pq / 4095.0 + out->offset[1] / 2048.0;
+    const double av = l1->l1.avg_pq / 4095.0 + out->offset[2] / 2048.0;
+    if (!(0 <= mn && mn < av && av < mx && mx <= 1))
+        return true; /* ST 2094-10 6.1.9: the level 1 block alone */
+    out->applied = true;
+    /* (an offset of 0 leaves the value of level 1 as it is, bit for bit) */
+    out->min += out->offset[0] / 2048.0f;
+    out->max += out->offset[1] / 2048.0f;
+    out->avg += out->offset[2] / 2048.0f;
+    return true;
+}
diff --git a/tools/dvbridge/dvbridge_placebo.h b/tools/dvbridge/dvbridge_placebo.h
index c937f6c..9f9474a 100644
--- a/tools/dvbridge/dvbridge_placebo.h
+++ b/tools/dvbridge/dvbridge_placebo.h
@@ -4,6 +4,7 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <libplacebo/colorspace.h>
+#include "dvbridge_core.h"
 
 struct dvbridge_color {
     struct pl_color_space color;
@@ -115,4 +116,10 @@ bool dvbridge_hdr10_static_mapped(struct dvbridge_hdr10_static *out, const void
  * resynchronizes the layer. */
 bool dvbridge_map_color(struct dvbridge_color *out, const void *metadata,
                        size_t bytes, bool enhancement_layer_paired, bool *residual_omitted);
+/* Hades: the level 1 of the metadata with the offsets of their level 3 block added where SMPTE ST
+ * 2094-10:2021 6.1.9 allows it (struct dvbridge_level1 in dvbridge_core.h). Without a level 3 block, or
+ * with one whose sums break 6.1.9, min, max and avg are those of level 1 exactly as libplacebo maps them
+ * (pl_map_avdovi_metadata(): code / 4095.0f). false where the metadata do not read or have no level 1. */
+#define DVBRIDGE_LEVEL1_EFFECTIVE 1
+bool dvbridge_level1_effective(const void *metadata, size_t bytes, struct dvbridge_level1 *out);
 #endif
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index d73bff1..d93634e 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -20,6 +20,8 @@ enum {
     NOTE_EL_DEPTH = 8,
     NOTE_PAIRS_MISSED = 16,
     NOTE_CM40_DROPPED = 32,
+    NOTE_LEVEL3 = 64,
+    NOTE_LEVEL3_REFUSED = 128,
 };
 
 /* Hades: the bridge's own passes that are timed (dvbridge_render_time_passes()), each with a few
@@ -373,7 +375,10 @@ static struct pl_hook_res mask_active_area(void *priv, const struct pl_hook_para
 static struct dvbridge_renderer *create_renderer(pl_gpu gpu, pl_log log, bool transport);
 static void map_to_display(struct dvbridge_renderer *r, const struct dvbridge_hdr10_mapping *m,
                            struct pl_color_space *source, struct pl_color_space *target,
-                           struct pl_color_map_params *params);
+                           struct pl_color_map_params *params,
+                           const struct dvbridge_level1 *level1);
+static const struct dvbridge_level1 *level1_noted(struct dvbridge_renderer *r, const void *metadata,
+                                                  size_t bytes, struct dvbridge_level1 *level1);
 static bool fine_gamut_table(const struct dvbridge_renderer *r, bool ll);
 static bool gamut_table_retry(struct dvbridge_renderer *r, bool fine, bool ok);
 static void gamut_table_kept(struct dvbridge_renderer *r, bool ok);
@@ -482,6 +487,8 @@ bool dvbridge_render_take_notes(struct dvbridge_renderer *r, struct dvbridge_ren
     notes->el_depth = r->fresh & NOTE_EL_DEPTH;
     notes->pairs_missed = r->fresh & NOTE_PAIRS_MISSED;
     notes->cm40_dropped = r->fresh & NOTE_CM40_DROPPED;
+    notes->level3_added = r->fresh & NOTE_LEVEL3;
+    notes->level3_refused = r->fresh & NOTE_LEVEL3_REFUSED;
     r->fresh = 0;
     return true;
 }
@@ -1167,7 +1174,9 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
      * same mapping) and within its peak; the test pattern covers the raster, bars too */
     struct pl_color_map_params ll_color;
     if (r->low_latency) {
-        map_to_display(r, &r->ll_mapping, &image.color, &target.color, &ll_color);
+        struct dvbridge_level1 level1;
+        map_to_display(r, &r->ll_mapping, &image.color, &target.color, &ll_color,
+                       level1_noted(r, metadata, bytes, &level1));
         params.color_map_params = &ll_color;
         mask.low_latency = true;
         mask.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->ll_mapping.peak);
@@ -1501,10 +1510,38 @@ static const int *gamut_table_size(struct dvbridge_renderer *r)
     return size;
 }
 
+/* Hades: level 1 with level 3 for the mapping of a picture to a display (dvbridge_level1_effective()),
+ * and the offsets noted for the log, once each in a stream: of the first picture whose offsets are
+ * added, and of the first whose offsets 6.1.9 refuses. NULL where the metadata have no level 1. */
+static const struct dvbridge_level1 *level1_noted(struct dvbridge_renderer *r, const void *metadata,
+                                                  size_t bytes, struct dvbridge_level1 *level1)
+{
+    if (!dvbridge_level1_effective(metadata, bytes, level1))
+        return NULL;
+    if (level1->level3 && level1->applied && note(r, NOTE_LEVEL3))
+        r->notes.level3 = *level1;
+    else if (level1->level3 && !level1->applied && note(r, NOTE_LEVEL3_REFUSED))
+        r->notes.level3_not_used = *level1;
+    return level1;
+}
+
 static void map_to_display(struct dvbridge_renderer *r, const struct dvbridge_hdr10_mapping *m,
                            struct pl_color_space *source, struct pl_color_space *target,
-                           struct pl_color_map_params *params)
-{
+                           struct pl_color_map_params *params,
+                           const struct dvbridge_level1 *level1)
+{
+    /* Hades: the brightest and the average of the scene that libplacebo maps by
+     * (PL_HDR_METADATA_CIE_Y: max_pq_y, avg_pq_y; it does not read the minimum) are those of level 1
+     * with the offsets of level 3 where the metadata have them and ST 2094-10 6.1.9 allows them
+     * (dvbridge_level1_effective()); without level 3 they stay as dvbridge_map_color() set them, so
+     * that such a picture is mapped as before, bit for bit. Measured on the software bridge (RC5): with
+     * the level 3 offsets of the streams at hand (the averages under the floors of content mapping v2.9,
+     * and black shots) BT.2390, spline and SDR give the same bytes; an offset that a colourist sets
+     * moves the mapping as it moves level 1. */
+    if (level1 && level1->applied) {
+        source->hdr.max_pq_y = level1->max;
+        source->hdr.avg_pq_y = level1->avg;
+    }
     if (m->source_known)
         source->hdr.prim = (struct pl_raw_primaries){
             .red = {m->source_xy[0], m->source_xy[1]}, .green = {m->source_xy[2], m->source_xy[3]},
@@ -1760,7 +1797,9 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     const bool peak_hook =
         r->hdr10_mapping.enabled && r->hdr10_mapping.target != DVBRIDGE_HDR10_TARGET_SDR;
     if (r->hdr10_mapping.enabled) {
-        map_to_display(r, &r->hdr10_mapping, &image.color, &target.color, &mapping);
+        struct dvbridge_level1 level1;
+        map_to_display(r, &r->hdr10_mapping, &image.color, &target.color, &mapping,
+                       level1_noted(r, metadata, bytes, &level1));
         params.color_map_params = &mapping;
     }
     if (peak_hook) {
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 0cecabe..f8569d3 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -51,6 +51,12 @@ struct dvbridge_render_notes {
     unsigned bl_bits, rpu_bl_bits;   /* for bl_depth: of the layer, and of the RPU */
     unsigned el_bits, rpu_el_bits;   /* for el_depth */
     struct dvbridge_reading reading; /* of the frame that brought those of the reading */
+    /* Hades: a picture of this stream was mapped to the display with the level 3 offsets of its metadata
+     * added to their level 1 (level3_added; level3 is that first picture's), or with level 1 alone
+     * because its level 3 offsets broke ST 2094-10 6.1.9 (level3_refused; level3_not_used):
+     * dvbridge_level1_effective() */
+    bool level3_added, level3_refused;
+    struct dvbridge_level1 level3, level3_not_used;
 };
 /* false when there is nothing new since the last call */
 bool dvbridge_render_take_notes(struct dvbridge_renderer *renderer, struct dvbridge_render_notes *notes);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index eae9c05..9ed58a3 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -893,6 +893,29 @@ void CDVBridgeGLES::LogNotes()
               "DVBridge: the pixels that the GUI covers in this stream are converted back by the "
               "transport itself, as before: the pass that converts each pair of them once could not "
               "be made or drawn on this GPU (the same bytes, more GPU time)");
+  // Hades: level 3 in the mapping to the display (dvbridge_level1_effective())
+  if (notes.level3_added)
+  {
+    const dvbridge_level1& l = notes.level3;
+    CLog::Log(LOGINFO,
+              "DVBridge: the level 3 offsets of this stream are added to its level 1 where its "
+              "pictures are mapped to the display (SMPTE ST 2094-10 6.1.6 to 6.1.9): min {:+} max {:+} "
+              "avg {:+} (codes of 2048; PQ {:+.4f} {:+.4f} {:+.4f}), level 1 {} {} {} taken as {:.1f} "
+              "{:.1f} {:.1f} (codes of 4095; the first picture that has them)",
+              l.offset[0], l.offset[1], l.offset[2], l.offset[0] / 2048.0, l.offset[1] / 2048.0,
+              l.offset[2] / 2048.0, l.l1[0], l.l1[1], l.l1[2], static_cast<double>(l.min) * 4095.0,
+              static_cast<double>(l.max) * 4095.0, static_cast<double>(l.avg) * 4095.0);
+  }
+  if (notes.level3_refused)
+  {
+    const dvbridge_level1& l = notes.level3_not_used;
+    CLog::Log(LOGINFO,
+              "DVBridge: level 3 offsets of this stream that would take its level 1 out of 0 <= min < "
+              "avg < max <= 1 (SMPTE ST 2094-10 6.1.9) are not added: level 1 {} {} {} with min {:+} "
+              "max {:+} avg {:+} (codes of 2048); such pictures are mapped to the display by their "
+              "level 1 alone (the first picture that has them)",
+              l.l1[0], l.l1[1], l.l1[2], l.offset[0], l.offset[1], l.offset[2]);
+  }
 }
 
 void CDVBridgeGLES::PQTextureDrawn()
