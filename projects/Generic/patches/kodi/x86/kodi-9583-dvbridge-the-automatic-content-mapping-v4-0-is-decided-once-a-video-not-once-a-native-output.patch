From b51e8a626b6209aceb20a07083c9d6a237d5e64c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:42:03 +0000
Subject: [PATCH] DVBridge: the automatic content mapping v4.0 is decided once
 a video, not once a native output

The second independent review of 1.0 RC6 (R-A2) found it.
dvbridge_dv_restart() kept the setting of the content mapping v4.0 and
cleared its decision, and dvbridge_renderer_reset() calls it at each end
of native output and after the frame of the start signal. So the
decision "once a stream" was made again within a video:
 - at the second frame of every native output;
 - after a recovery;
 - after the HDMI link came back;
 - after another output chosen for the video.
With Automatic 2 on a title whose first RPU has no level 2 and which
brings level 2 later, the default v4.0 part could be added again after
it had been taken back, and the display changed its mapping back and
forth. That is what 95beff9 says does not happen.

The decision is now of the video:
 - The serializer keeps it, and the video it is of, through
   dvbridge_dv_restart().
 - dvbridge_set_cm40_video() tells the context the video of the frames
   prepared from now on. A frame of another video makes the decision
   anew; a frame of the menus (Dolby Vision for the menus) makes none
   and takes none back.
 - CDVBridgeGLES gives the video before each frame it prepares (a
   counter that DVBRIDGE::NewVideo() moves on: any thread, an atomic),
   and keeps the decision of each committed frame
   (dvbridge_get_cm40_decision()). A renderer made again within the
   video takes the kept decision, and decides nothing again.

Host test (cm40_test, H1-H5):
 - after a reset within the video, a frame without trims is not added
   again;
 - a new renderer takes the kept decision;
 - the menus of the next video make no decision;
 - the first frame of the next video decides anew.
D and G3, which reset the context to stand for a new stream, now also
say that it is another video, as only that makes the decision anew.
---
 tools/dvbridge/dvbridge_core.c                | 27 ++++++++++++++
 tools/dvbridge/dvbridge_core.h                | 16 ++++++++
 tools/dvbridge/dvbridge_metadata.h            | 21 ++++++++++-
 tools/dvbridge/dvbridge_render.c              | 12 ++++++
 tools/dvbridge/dvbridge_render.h              |  6 +++
 .../VideoRenderers/DVBridgeGLES.cpp           | 37 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h | 11 ++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp |  2 +
 8 files changed, 130 insertions(+), 2 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 08588fd..d4acf5a 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -78,6 +78,33 @@ void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned disp
     context->cm29_forced = mode == DVBRIDGE_CM40_V29_ONLY;
 }
 
+void dvbridge_set_cm40_video(struct dvbridge_context *context, unsigned video, bool menus,
+                             const struct dvbridge_cm40_decision *known)
+{
+    if (!context)
+        return;
+    struct dvbridge_dv *d = &context->state;
+    d->cm40_menus = menus;
+    if (d->cm40_video == video)
+        return;
+    const bool take = known && known->decided && known->video == video;
+    d->cm40_video = video;
+    d->cm40_auto_decided = take;
+    d->cm40_auto_on = take && known->on;
+    d->cm40_auto_revoked = take && known->revoked;
+    d->cm40_auto_source = take ? known->source : 0;
+}
+
+bool dvbridge_get_cm40_decision(const struct dvbridge_context *context, struct dvbridge_cm40_decision *decision)
+{
+    if (!context || !decision)
+        return false;
+    const struct dvbridge_dv *d = &context->state;
+    *decision = (struct dvbridge_cm40_decision){d->cm40_auto_decided, d->cm40_auto_on, d->cm40_auto_revoked,
+                                                d->cm40_auto_source, d->cm40_video};
+    return d->cm40_auto_decided;
+}
+
 struct dvbridge_candidate *dvbridge_prepare(
     const struct dvbridge_context *context, const void *metadata, size_t bytes,
     double pts, struct dvbridge_geometry geometry, bool fel_reconstructed)
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 5c4cc244d..c5bf610 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -85,6 +85,22 @@ void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add);
  * trims of the colourist), whatever the peaks; with either automatic choice, a later RPU with what the choice was made
  * without (a v4.0 part of its own; with this one, also level 2) ends the addition for the rest of the stream */
 #define DVBRIDGE_CM40_AUTO_NO_TRIMS 4
+/* Hades: the decision of an automatic choice, which is of a video: made (decided), the default part added (on),
+ * taken back (revoked), the mastering peak it was made on (source, 12-bit PQ), and the video (as given to
+ * dvbridge_set_cm40_video()) */
+struct dvbridge_cm40_decision {
+    bool decided, on, revoked;
+    unsigned source, video;
+};
+/* Hades: the frames prepared from now on are of video (a number that changes with each video) and, with menus, of
+ * the menus (which make no decision of an automatic choice and take none back). Where video is not the one of the
+ * context's decision, the context takes known (the decision of that video kept by the caller, as when a renderer
+ * is made again within a video; NULL: none, the next frame of the video decides). The decision then lasts the
+ * video, through dvbridge_reset(). */
+void dvbridge_set_cm40_video(struct dvbridge_context *context, unsigned video, bool menus,
+                             const struct dvbridge_cm40_decision *known);
+/* Hades: the decision of the context (of its last committed frame); false where none is made */
+bool dvbridge_get_cm40_decision(const struct dvbridge_context *context, struct dvbridge_cm40_decision *decision);
 void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq);
 
 /* No state advances until presentation succeeds and commit is called. */
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index a570797..45d7dae 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -133,6 +133,12 @@ struct dvbridge_dv {
      * rest of the stream (cm40_auto_revoked): the video goes on as it is, and the display changes its mapping once,
      * not back and forth. */
     bool cm40_auto_no_trims, cm40_auto_revoked;
+    /* Hades: the video that the decision above is of (dvbridge_set_cm40_video()): the decision lasts that video,
+     * through dvbridge_dv_restart() (each start and end of native output, the start signal), as it is made once a
+     * video; a frame of another video makes it anew. cm40_menus: the frames prepared now are of the menus (Dolby
+     * Vision for the menus), which make no decision and take back none. */
+    unsigned cm40_video;
+    bool cm40_menus;
 };
 /* Hades: how long an edge of the active area sent stays taken out after the last frame that had
  * something drawn over the bars beyond it: 2 s of the video. The lines of subtitles in a bar, and an
@@ -344,7 +350,17 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     const bool no_trims = d->no_trims, cm40_default = d->cm40_default, cm40_auto = d->cm40_auto,
                cm40_auto_no_trims = d->cm40_auto_no_trims;
     const unsigned cm40_auto_peak_pq = d->cm40_auto_peak_pq;
+    /* (Hades: the decision of the automatic choice is of the video, not of the stream of native output) */
+    const bool cm40_auto_decided = d->cm40_auto_decided, cm40_auto_on = d->cm40_auto_on,
+               cm40_auto_revoked = d->cm40_auto_revoked, cm40_menus = d->cm40_menus;
+    const unsigned cm40_auto_source = d->cm40_auto_source, cm40_video = d->cm40_video;
     memset(d, 0, sizeof(*d));
+    d->cm40_auto_decided = cm40_auto_decided;
+    d->cm40_auto_on = cm40_auto_on;
+    d->cm40_auto_revoked = cm40_auto_revoked;
+    d->cm40_auto_source = cm40_auto_source;
+    d->cm40_video = cm40_video;
+    d->cm40_menus = cm40_menus;
     d->id = id;
     d->no_trims = no_trims;
     d->cm40_default = cm40_default;
@@ -693,14 +709,15 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         return false; /* (d->refused says why) */
     /* Hades: the default v4.0 part (cm40_default), after the v2.9 part as an RPU has it, converted for
      * the tunnel as the blocks of an RPU are (dvbridge_cm4_wire() of their bytes in the RPU) */
-    if (d->cm40_auto && !d->cm40_auto_decided) {
+    if (d->cm40_auto && !d->cm40_auto_decided && !d->cm40_menus) {
         /* (Hades: once a stream, with its first frame made) */
         d->cm40_auto_decided = true;
         d->cm40_auto_source = c->source_max_pq;
         d->cm40_auto_on = !rpu_v40 && (d->cm40_auto_no_trims ? !rpu_l2
                                                              : d->cm40_auto_peak_pq &&
                                                                    c->source_max_pq > d->cm40_auto_peak_pq);
-    } else if (d->cm40_auto && d->cm40_auto_on && (rpu_v40 || (d->cm40_auto_no_trims && rpu_l2))) {
+    } else if (d->cm40_auto && d->cm40_auto_on && !d->cm40_menus &&
+               (rpu_v40 || (d->cm40_auto_no_trims && rpu_l2))) {
         /* (Hades: what the choice was made without has come: off for the rest of the stream) */
         d->cm40_auto_on = false;
         d->cm40_auto_revoked = true;
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index a9877d5..c0cbd92 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -2451,6 +2451,18 @@ void dvbridge_render_set_cm40(struct dvbridge_renderer *r, int mode, unsigned di
         dvbridge_set_cm40(r->context, mode, display_peak_pq);
 }
 
+void dvbridge_render_set_cm40_video(struct dvbridge_renderer *r, unsigned video, bool menus,
+                                    const struct dvbridge_cm40_decision *known)
+{
+    if (r)
+        dvbridge_set_cm40_video(r->context, video, menus, known);
+}
+
+bool dvbridge_render_cm40_decision(const struct dvbridge_renderer *r, struct dvbridge_cm40_decision *decision)
+{
+    return r && dvbridge_get_cm40_decision(r->context, decision);
+}
+
 void dvbridge_render_set_window(struct dvbridge_renderer *r, pl_tex window)
 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index fe92b4f..acaf1f5 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -436,6 +436,12 @@ void dvbridge_render_add_cm40_default(struct dvbridge_renderer *renderer, bool a
 /* Hades: the content mapping v4.0 setting (dvbridge_set_cm40(): DVBRIDGE_CM40_*), the peak of the display a 12-bit
  * PQ level (0 not known) */
 void dvbridge_render_set_cm40(struct dvbridge_renderer *renderer, int mode, unsigned display_peak_pq);
+/* Hades: the video of the frames prepared from now on, and the decision kept for it (dvbridge_set_cm40_video()); and
+ * the decision of the renderer (dvbridge_get_cm40_decision()) */
+struct dvbridge_cm40_decision;
+void dvbridge_render_set_cm40_video(struct dvbridge_renderer *renderer, unsigned video, bool menus,
+                                    const struct dvbridge_cm40_decision *known);
+bool dvbridge_render_cm40_decision(const struct dvbridge_renderer *renderer, struct dvbridge_cm40_decision *decision);
 /* Whether the last picture prepared goes out in the source transport; *why, where it is asked
  * for and it does not: why (else NULL) */
 bool dvbridge_render_source(const struct dvbridge_renderer *renderer, const char **why);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index 48194ef..2192769 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -629,6 +629,7 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
   if (!m_renderer || !metadata.Data())
     return Fail("renderer-or-metadata-missing");
   TakeStaleGLErrors("a picture is prepared");
+  Cm40Video(false);
   // Hades: a base layer in BT.1886 (profile 8.2): composed as ETSI GS CCM 001 clause 5.5 says, or
   // not drawn (libplacebo says why); one in HLG (profile 8.4): as one in SMPTE ST 2084 where its RPU
   // declares that, or not drawn
@@ -1244,6 +1245,7 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& base, const AVFrame* enhancemen
                                   bool layerWithoutResidual, bool layerNotDecoded)
 {
   m_prepared = m_packed = false;
+  Cm40Video(false);
   m_layerWithoutResidual = !enhancement && layerWithoutResidual;
   m_layerNotDecoded = m_layerWithoutResidual && layerNotDecoded;
   if (!enhancement)
@@ -1373,6 +1375,7 @@ void CDVBridgeGLES::StartSignalPresented(bool presented)
   if (presented && !dvbridge_render_commit(m_renderer))
     CLog::Log(LOGWARNING, "DVBridge: the metadata of the frame that set the Dolby Vision signal up "
                           "could not be committed");
+  KeepCm40Decision();
   dvbridge_renderer_reset(m_renderer);
   m_prepared = m_packed = false;
   m_direct = false;
@@ -1386,6 +1389,7 @@ bool CDVBridgeGLES::PrepareGraphics(int whitePercent, bool newScene)
   m_pendingDetail = {};
   if (!m_renderer || m_lowLatencyOn)
     return Fail("graphics-unavailable");
+  Cm40Video(true);
   // the metadata of this white (dvbridge_graphics_metadata()), made again only when it changes; the first frame
   // of a white starts a scene
   if (!m_graphics || m_graphicsWhite != whitePercent || m_graphicsScene != newScene)
@@ -1644,6 +1648,37 @@ void CDVBridgeGLES::UseContentMapping(int mode, unsigned int displayPeakPq)
   UseCm40DefaultSetting();
 }
 
+namespace
+{
+// Hades: the video of now, for the automatic choice of the content mapping v4.0 (ContentMappingNewVideo())
+std::atomic<unsigned int> g_cm40Video{0};
+} // namespace
+
+void CDVBridgeGLES::ContentMappingNewVideo()
+{
+  ++g_cm40Video;
+}
+
+void CDVBridgeGLES::Cm40Video(bool menus)
+{
+  if (!m_renderer)
+    return;
+  const unsigned int video = g_cm40Video.load();
+  // (the decision kept here, for a renderer made again within this video; dvbridge_set_cm40_video()
+  // takes it only where the renderer's own is not of this video)
+  dvbridge_render_set_cm40_video(m_renderer, video, menus,
+                                 m_cm40Decision.decided && m_cm40Decision.video == video
+                                     ? &m_cm40Decision
+                                     : nullptr);
+}
+
+void CDVBridgeGLES::KeepCm40Decision()
+{
+  dvbridge_cm40_decision decision{};
+  if (m_renderer && dvbridge_render_cm40_decision(m_renderer, &decision))
+    m_cm40Decision = decision;
+}
+
 void CDVBridgeGLES::UseCm40DefaultSetting()
 {
   if (!m_renderer)
@@ -2233,6 +2268,8 @@ bool CDVBridgeGLES::ConversionOutput(const VideoPicture& picture,
 bool CDVBridgeGLES::Presented(bool success)
 {
   const bool committed = success && m_prepared && m_packed && dvbridge_render_commit(m_renderer);
+  if (committed)
+    KeepCm40Decision();
   CDVPlaybackInfo::presented.store(committed ? m_pendingInfo : 0);
   if (committed && m_pendingDetail.valid)
   {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index b2a1378..832d3a2 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -305,6 +305,10 @@ public:
   //! on; with <video><dvcm40default>true</dvcm40default></video> in advancedsettings.xml, as before,
   //! the default v4.0 part is added whatever the setting says
   void UseContentMapping(int mode, unsigned int displayPeakPq);
+  //! Hades: a new video (DVBRIDGE::NewVideo(), any thread): the automatic choice of the content
+  //! mapping v4.0 is made again for it, once (its decision lasts the video otherwise, also through
+  //! the ends and starts of native output and a renderer made again)
+  static void ContentMappingNewVideo();
   //! Hades: whether the display is sent the trims of the metadata (levels 2 and 8, and 10) from
   //! the next frame on (dvbridge_render_send_trims()); true until said otherwise
   void SendTrims(bool send);
@@ -563,6 +567,13 @@ private:
   unsigned int m_cm40PeakPq = 0;
   int m_cm40Applied = -1; //!< ... and as given to the renderer (with the expert switch), for the log
   bool m_cm40Revoked = false; //!< the automatic choice was taken back in the stream of now (told once)
+  //! Hades: the decision of the automatic choice of the video of now, kept here for a renderer that is
+  //! made again within the video (KeepCm40Decision(), Cm40Video())
+  dvbridge_cm40_decision m_cm40Decision{};
+  //! Hades: the frames prepared now are of the video of now (menus: of the menus), and the decision
+  //! kept for it; and the decision of the frame committed, kept
+  void Cm40Video(bool menus);
+  void KeepCm40Decision();
   bool m_conversion = false; //!< set up by InitializeConversion()
   dvbridge_gl_copier* m_copier = nullptr;
   dvbridge_gl_eos* m_eos = nullptr; //!< Hades: see DrawEndOfStream()
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 476cdfd..5513176 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2285,6 +2285,8 @@ void DVBRIDGE::NewVideo()
     CLog::Log(LOGINFO, "DVBridge: a new video: its output is chosen as the settings say again");
   g_dvOutputChoice = static_cast<int>(OutputChoice::AUTOMATIC);
   g_dvChoiceKept = false;
+  // Hades: the automatic choice of the content mapping v4.0 is made again, once, for this video
+  CDVBridgeGLES::ContentMappingNewVideo();
   g_dvStreamHdr10Plus = false;
   g_dvStreamPq = false;
