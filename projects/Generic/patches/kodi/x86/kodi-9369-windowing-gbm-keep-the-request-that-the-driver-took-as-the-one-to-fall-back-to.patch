From f4fc4949046b0348095b86b1e978e01c36f3b739 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 16:41:50 +0000
Subject: [PATCH] windowing/gbm: keep the request that the driver took as the
 one to fall back to

When the driver refuses the test of an atomic commit, CDRMAtomic commits the
front of its queue (the last request it took) with the framebuffer of the
frame. FinishRequest() then took the front out, as for any commit that was
taken: the request whose test had just been refused became the front, and
every later refusal fell back to it. Its frame was lost, and so was every
frame after it whose test was refused, until a commit went through as asked.

The request that went out is now the one that stays: when it was a fallback,
the refused one at the back goes instead (FinishAtomicRequest(), in a header
of its own so that a host test drives it).

The mode blob of a request was also destroyed when its commit returned,
while the request stayed in the queue naming its id; the kernel gives a
freed id to the next blob it makes. The blob now lives as long as its
request.
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp     | 12 +++---
 xbmc/windowing/gbm/drm/DRMAtomic.h       |  4 ++
 xbmc/windowing/gbm/drm/DRMRequestQueue.h | 52 ++++++++++++++++++++++++
 3 files changed, 63 insertions(+), 5 deletions(-)
 create mode 100644 xbmc/windowing/gbm/drm/DRMRequestQueue.h

diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index da44e6a..ebfdedf 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -8,6 +8,7 @@
 
 #include "DRMAtomic.h"
 
+#include "DRMRequestQueue.h"
 #include "DVBridgeRefused.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
@@ -169,6 +170,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 
     if (!AddProperty(m_crtc, "MODE_ID", modeBlob.Get()))
       return reject();
+    // Hades: and as long as the request that names it: a request that the driver took is
+    // committed again when the test of a later one is refused (FinishRequest())
+    m_req->KeepModeBlob(std::move(modeBlob));
 
     if (!AddProperty(m_crtc, "ACTIVE", m_active ? 1 : 0))
       return reject();
@@ -332,12 +336,10 @@ void CDRMAtomic::FinishRequest(bool accepted)
     // after Disable()). Without this, stale cached values cause
     // incorrect plane cleanup on subsequent video playback.
     m_req->CacheProperties();
-
-    if (m_atomicRequestQueue.size() > 1)
-      m_atomicRequestQueue.pop_front();
   }
-  else if (!m_atomicRequestQueue.empty())
-    m_atomicRequestQueue.pop_back();
+  // Hades: the request that went out stays the one to fall back to, also when it was a fallback
+  // itself (FinishAtomicRequest())
+  FinishAtomicRequest(m_atomicRequestQueue, m_req, accepted);
 
   if (m_inFenceFd != -1)
   {
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 9197ac1..97cae06 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -133,6 +133,9 @@ private:
     bool Empty() const { return m_atomicRequestItems.empty(); }
 
     bool AddProperty(CDRMObject* object, const char* name, uint64_t value);
+    //! Hades: the blob of the mode that this request carries lives as long as it does (a blob
+    //! that is destroyed gives its id back to the kernel, which gives it to the next one)
+    void KeepModeBlob(CDRMPropertyBlob blob) { m_modeBlob = std::move(blob); }
     void CacheProperties();
     void LogAtomicRequest();
     void LogAtomicRequest(uint8_t logLevel) { LogAtomicRequest(logLevel, m_atomicRequestItems); }
@@ -144,6 +147,7 @@ private:
         uint8_t logLevel, std::map<CDRMObject*, std::map<uint32_t, uint64_t>>& atomicRequestItems);
 
     std::map<CDRMObject*, std::map<uint32_t, uint64_t>> m_atomicRequestItems;
+    CDRMPropertyBlob m_modeBlob; //!< Hades: see KeepModeBlob()
 
     struct DrmModeAtomicReqDeleter
     {
diff --git a/xbmc/windowing/gbm/drm/DRMRequestQueue.h b/xbmc/windowing/gbm/drm/DRMRequestQueue.h
new file mode 100644
index 0000000..ab1bbae
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DRMRequestQueue.h
@@ -0,0 +1,52 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: what the queue of atomic requests of CDRMAtomic keeps once a commit is made
+ *
+ * The front of the queue is the last request that the driver took: a commit whose test the driver
+ * refuses falls back to it, with the framebuffer of the frame. The back is the request that is
+ * being filled. A commit is made of the back or, when its test was refused, of the front.
+ *  - Taken: the request that went out is the one to fall back to from then on. When it was the
+ *    back, the front before it goes. When it was the front (a fallback), the refused back goes:
+ *    Kodi took the front out there too, and the request that the driver had refused became the
+ *    one that every later refusal fell back to, and with it the frame was lost.
+ *  - Not taken: the back goes, the refused request or the one whose commit failed.
+ * The caller then puts a new empty request at the back.
+ *
+ * This function only decides; Queue is a deque of owning pointers to requests.
+ */
+template<typename Queue, typename Request>
+void FinishAtomicRequest(Queue& queue, const Request* committed, bool taken)
+{
+  if (taken)
+  {
+    if (queue.size() > 1)
+    {
+      if (committed == queue.front().get())
+        queue.pop_back();
+      else
+        queue.pop_front();
+    }
+  }
+  else if (!queue.empty())
+    queue.pop_back();
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
