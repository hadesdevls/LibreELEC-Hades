+++ b/tools/dvbridge/dvbridge_placebo.c
@@ -162,6 +162,10 @@ bool dvbridge_hdr10_mapping_valid(const struct dvbridge_hdr10_mapping *m)
     /* Hades: the 2.2 EOTF is of an SDR target only */
     if (m->gamma22 && m->target != DVBRIDGE_HDR10_TARGET_SDR)
         return false;
+    /* Hades: so is a gamma of a custom one, one that libplacebo has, and never with gamma22 */
+    if (m->gamma != 0.0f && (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamma22 ||
+                             dvbridge_sdr_transfer(m) == PL_COLOR_TRC_UNKNOWN))
+        return false;
     /* Hades: an SDR output is BT.709 (Kodi signals no other gamut there) */
     if (m->target != DVBRIDGE_HDR10_TARGET_HDR10 &&
         (m->target != DVBRIDGE_HDR10_TARGET_SDR || m->gamut != DVBRIDGE_HDR10_GAMUT_BT709))
@@ -184,6 +188,43 @@ struct dvbridge_hdr10_mapping dvbridge_sdr_mapping(const float *source_xy)
     return dvbridge_sdr_mapping_for(DVBRIDGE_SDR_TARGET_REFERENCE, source_xy);
 }
 
+enum pl_color_transfer dvbridge_sdr_transfer(const struct dvbridge_hdr10_mapping *m)
+{
+    if (!m || m->gamma == 0.0f)
+        return m && m->gamma22 ? PL_COLOR_TRC_GAMMA22 : PL_COLOR_TRC_BT_1886;
+    static const struct {
+        float gamma;
+        enum pl_color_transfer transfer;
+    } powers[] = {{1.8f, PL_COLOR_TRC_GAMMA18}, {2.0f, PL_COLOR_TRC_GAMMA20}, {2.2f, PL_COLOR_TRC_GAMMA22},
+                  {2.4f, PL_COLOR_TRC_BT_1886}, {2.6f, PL_COLOR_TRC_GAMMA26}, {2.8f, PL_COLOR_TRC_GAMMA28}};
+    for (unsigned i = 0; i < sizeof(powers) / sizeof(*powers); ++i)
+        if (m->gamma == powers[i].gamma)
+            return powers[i].transfer;
+    return PL_COLOR_TRC_UNKNOWN;
+}
+
+struct dvbridge_hdr10_mapping dvbridge_sdr_mapping_custom(float white, float gamma, const float *source_xy)
+{
+    struct dvbridge_hdr10_mapping m = dvbridge_sdr_mapping_for(DVBRIDGE_SDR_TARGET_REFERENCE, source_xy);
+    if (!isfinite(white))
+        white = DVBRIDGE_SDR_WHITE;
+    if (!isfinite(gamma))
+        gamma = 2.4f;
+    m.peak = white < DVBRIDGE_SDR_WHITE_MIN ? DVBRIDGE_SDR_WHITE_MIN
+             : white > DVBRIDGE_SDR_WHITE_MAX ? DVBRIDGE_SDR_WHITE_MAX
+                                              : white;
+    gamma = gamma < DVBRIDGE_SDR_GAMMA_MIN ? DVBRIDGE_SDR_GAMMA_MIN
+            : gamma > DVBRIDGE_SDR_GAMMA_MAX ? DVBRIDGE_SDR_GAMMA_MAX
+                                             : gamma;
+    /* (the step of 0.2 as the exact floats of the table of dvbridge_sdr_transfer(); 2.4 is the reference's
+     * BT.1886, 0 as for the reference itself: the same mapping) */
+    static const float steps[] = {1.8f, 2.0f, 2.2f, 2.4f, 2.6f, 2.8f};
+    const int k = (int)floorf((gamma - DVBRIDGE_SDR_GAMMA_MIN) / 0.2f + 0.5f);
+    const float g = steps[k < 0 ? 0 : k > 5 ? 5 : k];
+    m.gamma = g == 2.4f ? 0.0f : g;
+    return m;
+}
