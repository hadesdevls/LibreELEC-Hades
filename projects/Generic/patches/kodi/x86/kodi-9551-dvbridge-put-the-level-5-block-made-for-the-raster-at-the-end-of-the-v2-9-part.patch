From 256177cd4015b82a218ca465762726ab7c429997 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:59:41 +0000
Subject: [PATCH] dvbridge: put the level 5 block made for the raster at the
 end of the v2.9 part

Where the metadata of a frame have no level 5 block, the serializer makes
one from the place of the picture. It wrote it after every other block, so
an RPU with a content mapping v4.0 part went out as levels 1, 2, 4, then 3,
8 to 11 and 254, and the level 5 block last: an order that no RPU has (an
RPU carries level 5 in its v2.9 payload, before the v4.0 one, and the
serializer sends an RPU's own level 5 block there).

The made block now goes where an RPU's own goes: before the first block of
the v4.0 part (dvbridge_dv_made_area()), or last where there is no v4.0
part. CCM 001's rule of order (a level 5 block after a level 1 or 2 block,
and none of those after the last level 5) holds either way. What a display
of display management 4 makes of the other order: not known; this one is
the order of every RPU.

The bytes change on purpose, for a frame without a level 5 block with a
v4.0 part sent, and for no other: in the serializer host test, 7 of 250
payloads (the frames of level 1 and level 11 only) change, with their
sizes, and are now the payload of the same RPU with a level 5 block of the
picture's place; every other payload is the same.
---
 tools/dvbridge/dvbridge_metadata.h | 43 ++++++++++++++++++++----------
 1 file changed, 29 insertions(+), 14 deletions(-)

diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index cb81049..ddd5703 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -307,6 +307,23 @@ static inline bool dvbridge_dv_gap_refresh(struct dvbridge_dv *d, double gap)
     const bool trusted = 2 * over <= d->gaps_seen;
     return earlier || (trusted && long_gap);
 }
+/* Hades: the level 5 block made for the raster, where the metadata have none: the place of the
+ * picture (dvbridge_dv_margins() of no offsets), each edge drawn over beyond (taken) sent as 0 */
+static inline bool dvbridge_dv_made_area(struct dvbridge_dv *d, unsigned taken, unsigned count_pos)
+{
+    unsigned v[4];
+    if (!dvbridge_dv_margins(d, 0, 0, 0, 0, v))
+        return false; /* (d->refused says why) */
+    memcpy(d->margins, v, sizeof(d->margins));
+    for (int j = 0; j < 4; j++)
+        if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
+    DV_REFUSE(d->size + 13 <= DVBRIDGE_DV_MAX_PAYLOAD,
+              "the content mapping v2.9 part alone is over 512 bytes");
+    dvbridge_dv_u32(d, 8); d->payload[d->size++] = 5;
+    for (int j = 0; j < 4; j++) dvbridge_dv_u16(d, v[j]);
+    d->payload[count_pos]++;
+    return true;
+}
 /* Called with metadata from the exact pl_frame being rendered, not the
  * decoder's newest frame. Repeated PTS keeps a stable payload while paused.
  * A discontinuity forces scene refresh; no stale RPU across a seek.
@@ -444,6 +461,15 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     for (int i = 0; i < m->num_ext_blocks; i++) {
         const AVDOVIDmData *e = ordered[i];
         unsigned v[7] = {0}, n = 0;
+        /* Hades: the level 5 block made for the raster, where the metadata have none, goes where an
+         * RPU's own goes: at the end of the v2.9 part, before the first block of the v4.0 part. (It
+         * went after the v4.0 part, an order that no RPU has.) */
+        if (!area && order[i] >= 256) {
+            DV_REFUSE(l1 == 1, l1 ? "two level 1 blocks" : "no level 1 block");
+            if (!dvbridge_dv_made_area(d, taken, count_pos))
+                return false; /* (d->refused says why) */
+            area++;
+        }
         if (!dvbridge_dv_level_known(e->level)) {
             if (!d->reading.skipped++)
                 d->reading.skipped_level = e->level;
@@ -503,7 +529,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             const int size = kept ? dvbridge_cm4_wire(e->level, e->dvbridge_original_bytes,
                                                       e->dvbridge_original_length, wire) : -1;
             /* (the level 5 block made for the raster, where the metadata have none, comes after
-             * this part: its room is kept, so that the v4.0 part never takes it) */
+             * level 4: its room is kept. Before the v4.0 part it is made already.) */
             const unsigned room = DVBRIDGE_DV_MAX_PAYLOAD - (area ? 0 : 13);
             const unsigned blocks = AV_DOVI_MAX_EXT_BLOCKS - (area ? 0 : 1);
             const char *why =
@@ -553,19 +579,8 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
         d->payload[count_pos]++;
     }
     DV_REFUSE(l1 == 1, l1 ? "two level 1 blocks" : "no level 1 block");
-    if (!area) {
-        unsigned v[4];
-        if (!dvbridge_dv_margins(d,0,0,0,0,v))
-            return false; /* (d->refused says why) */
-        memcpy(d->margins, v, sizeof(d->margins));
-        for (int j = 0; j < 4; j++)
-            if (taken >> j & 1) v[j] = 0; /* Hades: taken out to what is drawn over the bars */
-        DV_REFUSE(d->size+13 <= DVBRIDGE_DV_MAX_PAYLOAD,
-                  "the content mapping v2.9 part alone is over 512 bytes");
-        dvbridge_dv_u32(d,8);d->payload[d->size++]=5;
-        for (int j=0;j<4;j++) dvbridge_dv_u16(d,v[j]);
-        d->payload[count_pos]++;
-    }
+    if (!area && !dvbridge_dv_made_area(d, taken, count_pos))
+        return false; /* (d->refused says why) */
     DV_REFUSE(d->size<=DVBRIDGE_DV_MAX_PAYLOAD && d->payload[count_pos]<=AV_DOVI_MAX_EXT_BLOCKS,
               "a payload over 512 bytes, or of more than 32 blocks");
     if (d->frames && (d->previous_size != d->size || memcmp(d->previous, d->payload, d->size))) {
