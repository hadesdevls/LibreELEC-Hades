+#ifdef HAVE_DVBRIDGE
+// The transport stream of a UHD Blu-ray carries Dolby Vision profile 7 in two video tracks, which
+// libavformat puts in a stream group. Without this the player opens the first one, the base
+// layer, and plays HDR10. Called while the streams are made, when the program that plays is known
+// and before its streams are added.
+void CDVDDemuxFFmpeg::FindDVLayers()
+{
+  using Result = CDVLayerMerge::Layers::Result;
+  const CDVLayerMerge::Layers layers = CDVLayerMerge::Find(m_pFormatContext, m_program);
+
+  if (layers.result == Result::NOT_START_CODES)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: Dolby Vision profile 7 in two video tracks (streams {} and {}) "
+              "that are not start-code streams: not joined, the base layer plays alone",
+              layers.base, layers.enhancement);
+  else if (layers.result == Result::WRONG_SIZE)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: the second HEVC track of this Blu-ray stream (stream {}) does "
+              "not have the size of a Dolby Vision enhancement layer for the base layer of "
+              "stream {}: not joined, the base layer plays alone",
+              layers.enhancement, layers.base);
+
+  const bool joined = layers.result == Result::JOINED;
+  const int base = joined ? layers.base : -1;
+  const int enhancement = joined ? layers.enhancement : -1;
+
+  // the same pair as before (the streams are made again, a program change): what waits stays
+  if (base == m_dvBaseIndex && enhancement == m_dvEnhancementIndex)
+  {
+    if (joined)
+    {
+      // more may be known of it by now (the size, the frame rate)
+      m_dvRecord = layers.record;
+      m_dvMerge.SetRate(layers.rate);
+    }
+    return;
+  }
+
+  ReportDVLayers();
+  m_dvMerge.Clear();
+  m_dvBaseIndex = base;
+  m_dvEnhancementIndex = enhancement;
+  m_dvRecord = layers.record;
+  if (!joined)
+    return;
+
+  m_dvMerge.SetRate(layers.rate);
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision profile 7 in two video tracks ({}): the enhancement "
+            "layer and the RPU of stream {} are joined to the base layer of stream {}",
+            layers.described ? "Dolby Vision descriptor"
+                             : "a Blu-ray stream, by its stream numbers",
+            enhancement, base);
+}
+
+// After the streams are made: the enhancement layer is no stream of the player, but its packets
+// are needed.
+void CDVDDemuxFFmpeg::KeepDVLayers()
+{
+  if (m_dvBaseIndex < 0)
+    return;
+
+  if (!GetStream(m_dvBaseIndex))
+  {
+    // the base layer did not become a stream of the player
+    m_dvMerge.Clear();
+    m_dvBaseIndex = -1;
+    m_dvEnhancementIndex = -1;
+    return;
+  }
+  m_pFormatContext->streams[m_dvEnhancementIndex]->discard = AVDISCARD_NONE;
+}
+
+void CDVDDemuxFFmpeg::ReportDVLayers()
+{
+  const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+  if (counts.joined + counts.alone == m_dvReported)
+    return;
+
+  m_dvReported = counts.joined + counts.alone;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision in two tracks so far: {} access units joined and {} "
+            "without their enhancement layer; {} enhancement packets had no base packet and {} "
+            "were not unit streams; at most {} base and {} enhancement packets waited for the "
+            "other layer",
+            counts.joined, counts.alone, counts.dropped, counts.malformed, counts.waited,
+            counts.queued);
+}
+#endif
+
+int CDVDDemuxFFmpeg::ReadFrame(AVPacket* packet)
+{
+#ifdef HAVE_DVBRIDGE
+  if (m_dvBaseIndex >= 0)
+  {
+    // access units after which the log gets its first line about the join
+    static constexpr uint64_t FIRST_REPORT = 600;
+
+    const int result =
+        m_dvMerge.Read(m_pFormatContext, m_dvBaseIndex, m_dvEnhancementIndex, packet);
+    const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+    if (!m_dvReported && counts.joined + counts.alone >= FIRST_REPORT)
+      ReportDVLayers();
+    return result;
+  }
+#endif
+  return av_read_frame(m_pFormatContext, packet);
+}
