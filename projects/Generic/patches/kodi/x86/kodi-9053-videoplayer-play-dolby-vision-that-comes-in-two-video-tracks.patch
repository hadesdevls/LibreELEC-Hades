+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+extern "C"
+{
+#include <libavcodec/packet.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/rational.h>
+}
+
+struct AVFormatContext;
+
+/*!
+ * \brief Joins the two video tracks of a Dolby Vision stream into the one-track form
+ *
+ * UHD Blu-ray carries Dolby Vision profile 7 in two video tracks of the transport stream: the
+ * base layer, and the enhancement layer with the RPU. A player that opens the first video track
+ * plays HDR10. Everything after the demuxer (the decoder, the split and the pairing of the
+ * layers) takes the one-track form that dovi_tool makes of the two and that Matroska files
+ * carry: after the units of the base layer of an access unit come the units of the enhancement
+ * layer, each inside a unit of type 63, and the RPU, a unit of type 62, as it is.
+ *
+ * This class finds the two tracks and makes that form while the stream is read. The two tracks
+ * have their access units in the same order and with the same decoding times (not the same
+ * presentation times: the layers may be coded with different picture orders, which the pairing
+ * of the decoded pictures resolves). An access unit that has no time of its own (a PES packet may
+ * hold more than one) has the time that follows from the unit before it in its track: that time
+ * plus that duration.
+ *
+ * A base packet waits for the enhancement packet of its decoding time and goes out alone when the
+ * enhancement layer has none for it:
+ * - the enhancement layer is already past it;
+ * - the enhancement layer is silent: no packet of it came while as many base packets came as
+ *   SetSilent() says (base packets then do not wait at all until it is back);
+ * - MAX_WAITING base packets wait;
+ * - the stream ended;
+ * - its time is not known.
+ * How far apart a multiplexer puts the two packets of an access unit is not known for real discs,
+ * hence no fixed short wait: while the enhancement layer keeps coming, a base packet waits for
+ * its own.
+ *
+ * Both tracks must be start-code streams (Annex B), as a transport stream gives them.
+ * No part of this depends on Kodi, so that the same file is tested outside of it.
+ */
+class CDVLayerMerge
+{
+public:
+  CDVLayerMerge() = default;
+  ~CDVLayerMerge();
+  CDVLayerMerge(const CDVLayerMerge&) = delete;
+  CDVLayerMerge& operator=(const CDVLayerMerge&) = delete;
+
+  //! \brief What Find() found
+  struct Layers
+  {
+    enum class Result
+    {
+      NONE, //!< no pair of tracks
+      JOINED, //!< a pair that is joined
+      NOT_START_CODES, //!< a pair whose tracks are not start-code streams: not joined
+      WRONG_SIZE, //!< a Blu-ray pair whose second track is no enhancement layer: not joined
+    };
+    Result result = Result::NONE;
+    int base = -1; //!< stream index of the base layer of the pair (joined or not)
+    int enhancement = -1; //!< stream index of its enhancement layer
+    //! known by the Dolby Vision descriptor of the enhancement track; else by the stream numbers
+    //! that the Blu-ray format gives to the two layers
+    bool described = false;
+    AVRational rate{0, 1}; //!< frame rate of the base layer, 0 when not known
+    AVDOVIDecoderConfigurationRecord record{}; //!< of the one-track form, when joined
+  };
+
+  /*!
+   * \brief Look for the two tracks in the stream groups of a transport stream
+   * \param program index of the program that plays; any other value: all streams play
+   */
+  static Layers Find(AVFormatContext* context, unsigned int program);
+
+  /*!
+   * \brief av_read_frame() with the two tracks joined
+   *
+   * The packets of the base track come with the enhancement layer of their access unit, the ones
+   * of the enhancement track do not come, all others come as they are. At the end of the input
+   * what waits comes first.
+   */
+  int Read(AVFormatContext* context, int base, int enhancement, AVPacket* packet);
+
+  struct Counts
+  {
+    uint64_t joined = 0; //!< base packets that went out with their enhancement layer
+    uint64_t alone = 0; //!< base packets that went out without one
+    uint64_t dropped = 0; //!< enhancement packets that belonged to no base packet
+    uint64_t malformed = 0; //!< enhancement packets that could not be read as units
+    size_t waited = 0; //!< the most base packets that waited when one was joined
+    size_t queued = 0; //!< the most enhancement packets that waited when one was joined
+  };
+
+  /*!
+   * \brief Take a packet of the base layer, or of the enhancement layer
+   * \param packet moved from; blank afterwards
+   * \return false when there was no memory (the packet is then dropped)
+   */
+  bool PushBase(AVPacket* packet);
+  bool PushEnhancement(AVPacket* packet);
+
+  /*!
+   * \brief The next packet of the base layer, with the enhancement layer of its access unit
+   * \param packet a blank packet, filled
+   * \param end no more packets come: what waits goes out as it is
+   * \return false when more packets have to be read first
+   */
+  bool Pop(AVPacket* packet, bool end);
+
+  //! \brief Forget what waits (a seek, a flush)
+  void Clear();
+
+  const Counts& GetCounts() const { return m_counts; }
+
+  static constexpr size_t MAX_WAITING = 240; //!< base packets that wait for their enhancement
+  static constexpr size_t MAX_QUEUED = 240; //!< enhancement packets kept
+  static constexpr unsigned int SILENT = 60; //!< base packets without any enhancement packet
+
+  /*!
+   * \brief After how many base packets without any enhancement packet the enhancement layer is
+   *        silent
+   *
+   * It is how long the first base packets wait at the start when the stream has no enhancement
+   * packets at all (after that the layer counts as absent, and nothing waits until a packet of
+   * it comes), so it should stay well below what the player keeps queued.
+   * \param packets taken between SILENT and MAX_WAITING - 1
+   */
+  void SetSilent(unsigned int packets);
+
+  //! \brief SetSilent() for two and a half seconds of a base layer of this frame rate
+  void SetRate(AVRational rate);
+
+  /*!
+   * \brief Append the units of an enhancement-layer access unit to a base-layer packet
+   * \return false when the enhancement layer is not a sequence of units or there is no memory;
+   *         the base packet is then unchanged
+   */
+  static bool Append(AVPacket* base, const uint8_t* enhancement, size_t size);
+
+  /*!
+   * \brief The level of a Dolby Vision stream (Dolby Vision Profiles and Levels): the first one
+   *        whose pixel rate and width hold the stream
+   * \return 0 when the size or the rate is not known, or no level holds it
+   */
+  static uint8_t Level(int width, int height, AVRational rate);
+
+  /*!
+   * \brief Whether a track can be the profile 7 enhancement layer of a base layer, by its size
+   *
+   * It has a quarter of the picture of the base layer, or the same picture when the base layer
+   * is no larger than 1920x1080. A size that is not known does not speak against it.
+   */
+  static bool EnhancementSize(int baseWidth, int baseHeight, int width, int height);
+
+private:
+  //! A packet that waits, with the decoding time of its access unit
+  struct Waiting
+  {
+    AVPacket* packet = nullptr;
+    int64_t time = 0; //!< AV_NOPTS_VALUE when it is not known
+    int64_t slack = 0; //!< 0 for a time of its own; half a duration for one that follows
+  };
+
+  //! The packets of a track that wait, and what gives the next one its time when it has none
+  struct Track
+  {
+    std::deque<Waiting> waiting;
+    int64_t time = 0; //!< of the last packet read
+    int64_t duration = 0; //!< of the last packet read
+    bool known = false; //!< time and duration are of a packet read since the last Clear()
+  };
+
+  static bool Queue(Track& track, AVPacket* packet);
+  static void Forget(Track& track);
+  static bool SameUnit(const Waiting& a, const Waiting& b);
+  static bool After(const Waiting& enhancement, const Waiting& base);
+  bool Passed() const;
+
+  Track m_base;
+  Track m_enhancement;
+  unsigned int m_silentAfter = SILENT;
+  unsigned int m_silent = 0; //!< base packets since the last enhancement packet
+  bool m_absent = false; //!< the layer went silent without ever having had a packet
+  bool m_any = false; //!< an enhancement packet has come
+  bool m_end = false; //!< the input ended and what waits is going out
+  Counts m_counts;
+};
