+#include <cstring>
+#include <iterator>
+#include <limits>
+
+extern "C"
+{
+#include <libavcodec/defs.h>
+#include <libavformat/avformat.h>
+#include <libavutil/avutil.h>
+#include <libavutil/mathematics.h>
+}
+
+namespace
+{
+constexpr uint8_t START_CODE[4] = {0, 0, 0, 1};
+// The header of a unit of type 63 (unspecified), layer 0, temporal id 0: what carries a unit of
+// the enhancement layer in the one-track form.
+constexpr uint8_t WRAP[2] = {0x7e, 0x01};
+constexpr unsigned int NAL_RPU = 62;
+
+// The position of the next 00 00 01 at or after from, or size when there is none.
+size_t FindStartCode(const uint8_t* data, size_t size, size_t from)
+{
+  for (size_t i = from; i + 3 <= size; ++i)
+  {
+    if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1)
+      return i;
+  }
+  return size;
+}
+
+// Calls unit(pointer, size) for each unit of a start-code stream. False when the buffer is not
+// one: something other than zeros before the first start code, a unit shorter than its header, or
+// a unit with the forbidden bit set.
+template<typename F>
+bool ForEachUnit(const uint8_t* data, size_t size, F&& unit)
+{
+  size_t code = FindStartCode(data, size, 0);
+  if (code == size)
+    return false;
+
+  for (size_t i = 0; i < code; ++i)
+  {
+    if (data[i] != 0)
+      return false;
+  }
+
+  while (code < size)
+  {
+    const size_t begin = code + 3;
+    const size_t next = FindStartCode(data, size, begin);
+    // zeros before the next start code are its fourth byte or trailing zeros: a unit never ends
+    // with a zero byte
+    size_t end = next;
+    while (end > begin && data[end - 1] == 0)
+      --end;
+
+    if (end - begin < 2 || (data[begin] & 0x80))
+      return false;
+
+    unit(data + begin, end - begin);
+    code = next;
+  }
+  return true;
+}
+
+// Whether the packets of a stream are start-code streams (Annex B) and not length-prefixed units
+// with their parameter sets in an hvcC record. As libavcodec tells them apart: such a record
+// starts with its version, 1.
+bool IsAnnexB(const AVCodecParameters* par)
+{
+  return !(par->extradata && par->extradata_size >= 23 && par->extradata[0] == 1);
+}
+} // unnamed namespace
+
+uint8_t CDVLayerMerge::Level(int width, int height, AVRational rate)
+{
+  struct Limit
+  {
+    uint64_t pixelsPerSecond;
+    int width;
+  };
+  static constexpr Limit LIMITS[] = {
+      {0, 0},
+      {UINT64_C(1280) * 720 * 24, 1280},
+      {UINT64_C(1280) * 720 * 30, 1280},
+      {UINT64_C(1920) * 1080 * 24, 1920},
+      {UINT64_C(1920) * 1080 * 30, 2560},
+      {UINT64_C(1920) * 1080 * 60, 3840},
+      {UINT64_C(3840) * 2160 * 24, 3840},
+      {UINT64_C(3840) * 2160 * 30, 3840},
+      {UINT64_C(3840) * 2160 * 48, 3840},
+      {UINT64_C(3840) * 2160 * 60, 3840},
+      {UINT64_C(3840) * 2160 * 120, 3840},
+      {UINT64_C(3840) * 2160 * 120, 7680},
+      {UINT64_C(7680) * 4320 * 60, 7680},
+      {UINT64_C(7680) * 4320 * 120, 7680},
+  };
+
+  if (width <= 0 || height <= 0 || rate.num <= 0 || rate.den <= 0)
+    return 0;
+
+  const uint64_t pixelsPerSecond = static_cast<uint64_t>(width) * static_cast<uint64_t>(height) *
+                                   static_cast<uint64_t>(rate.num) /
+                                   static_cast<uint64_t>(rate.den);
+  for (uint8_t level = 1; level < std::size(LIMITS); ++level)
+  {
+    if (pixelsPerSecond <= LIMITS[level].pixelsPerSecond && width <= LIMITS[level].width)
+      return level;
+  }
+  return 0;
+}
+
+bool CDVLayerMerge::EnhancementSize(int baseWidth, int baseHeight, int width, int height)
+{
+  if (baseWidth <= 0 || baseHeight <= 0 || width <= 0 || height <= 0)
+    return true;
+
+  const bool quarter = baseWidth == 2 * static_cast<int64_t>(width) &&
+                       baseHeight == 2 * static_cast<int64_t>(height);
+  const bool same = baseWidth == width && baseHeight == height && baseWidth <= 1920;
+  return quarter || same;
+}
+
+CDVLayerMerge::Layers CDVLayerMerge::Find(AVFormatContext* context, unsigned int program)
+{
+  Layers refused;
+
+  // The join is made for, and tested with, the start-code streams of a transport stream.
+  if (!context || !context->iformat || std::strcmp(context->iformat->name, "mpegts") != 0)
+    return refused;
+
+  const auto played = [context, program](const AVStream* stream)
+  {
+    if (program >= context->nb_programs)
+      return true;
+    const unsigned int* begin = context->programs[program]->stream_index;
+    const unsigned int* end = begin + context->programs[program]->nb_stream_indexes;
+    return std::find(begin, end, static_cast<unsigned int>(stream->index)) != end;
+  };
+
+  for (unsigned int i = 0; i < context->nb_stream_groups; ++i)
+  {
+    const AVStreamGroup* group = context->stream_groups[i];
+    if (!group || group->type != AV_STREAM_GROUP_PARAMS_DOLBY_VISION || group->nb_streams != 2 ||
+        !group->params.layered_video || group->params.layered_video->el_index > 1)
+      continue;
+
+    AVStream* enhancement = group->streams[group->params.layered_video->el_index];
+    AVStream* base = group->streams[1 - group->params.layered_video->el_index];
+    if (!base || !enhancement || base == enhancement || !base->codecpar ||
+        !enhancement->codecpar || base->codecpar->codec_id != AV_CODEC_ID_HEVC ||
+        enhancement->codecpar->codec_id != AV_CODEC_ID_HEVC || !played(base) ||
+        !played(enhancement))
+      continue;
+
+    const AVCodecParameters* b = base->codecpar;
+    const AVCodecParameters* e = enhancement->codecpar;
+
+    Layers layers;
+    layers.base = base->index;
+    layers.enhancement = enhancement->index;
+    layers.rate = av_guess_frame_rate(context, base, nullptr);
+    if (layers.rate.num <= 0 || layers.rate.den <= 0)
+      layers.rate = AVRational{0, 1};
+
+    const AVPacketSideData* sideData =
+        av_packet_side_data_get(e->coded_side_data, e->nb_coded_side_data, AV_PKT_DATA_DOVI_CONF);
+    layers.described = sideData && sideData->size >= sizeof(AVDOVIDecoderConfigurationRecord);
+    if (layers.described)
+    {
+      // the Dolby Vision descriptor of the enhancement track
+      std::memcpy(&layers.record, sideData->data, sizeof(layers.record));
+      if (layers.record.dv_profile != 7 || layers.record.bl_present_flag ||
+          !layers.record.el_present_flag || !layers.record.rpu_present_flag)
+        continue;
+    }
+    else
+    {
+      // The discs themselves have no Dolby Vision descriptor: libavformat knows the pair by the
+      // stream numbers that the Blu-ray format gives to the two layers. A second HEVC track of
+      // another size than an enhancement layer has is none.
+      if (!EnhancementSize(b->width, b->height, e->width, e->height))
+      {
+        layers.result = Layers::Result::WRONG_SIZE;
+        refused = layers;
+        continue;
+      }
+      layers.record.dv_version_major = 1;
+      layers.record.dv_version_minor = 0;
+      layers.record.dv_profile = 7;
+      layers.record.dv_level = Level(b->width, b->height, layers.rate);
+      layers.record.rpu_present_flag = 1;
+      layers.record.el_present_flag = 1;
+      layers.record.dv_bl_signal_compatibility_id = 6; // the base layer of a Blu-ray is HDR10
+    }
+
+    if (!IsAnnexB(b) || !IsAnnexB(e))
+    {
+      layers.result = Layers::Result::NOT_START_CODES;
+      refused = layers;
+      continue;
+    }
+
+    // The record of the one-track form: both layers in one stream. The descriptor of the
+    // enhancement track has ones in the bits that newer streams use for the compression of the
+    // metadata, which profile 7 does not have.
+    layers.record.bl_present_flag = 1;
+    layers.record.dv_md_compression = AV_DOVI_COMPRESSION_NONE;
+    layers.result = Layers::Result::JOINED;
+    return layers;
+  }
+  return refused;
+}
+
+CDVLayerMerge::~CDVLayerMerge()
+{
+  Forget(m_base);
+  Forget(m_enhancement);
+}
+
+void CDVLayerMerge::Forget(Track& track)
+{
+  for (Waiting& waiting : track.waiting)
+    av_packet_free(&waiting.packet);
+  track.waiting.clear();
+  track.known = false;
+}
+
+void CDVLayerMerge::Clear()
+{
+  Forget(m_base);
+  Forget(m_enhancement);
+  // a stream that never had a packet of the layer is not waited for again after every seek
+  m_silent = m_absent ? m_silentAfter : 0;
+  m_end = false;
+}
+
+void CDVLayerMerge::SetSilent(unsigned int packets)
+{
+  m_silentAfter = std::clamp(packets, SILENT, static_cast<unsigned int>(MAX_WAITING - 1));
+}
+
+void CDVLayerMerge::SetRate(AVRational rate)
+{
+  if (rate.num <= 0 || rate.den <= 0)
+  {
+    SetSilent(SILENT);
+    return;
+  }
+  const int64_t packets = av_rescale(5, rate.num, 2 * static_cast<int64_t>(rate.den));
+  SetSilent(static_cast<unsigned int>(
+      std::clamp<int64_t>(packets, 0, static_cast<int64_t>(MAX_WAITING))));
+}
+
+// The decoding time of an access unit is its own, or, when its PES packet gave it none (it was
+// not the first one in it), the one that follows from the unit before it in the track: that time
+// plus that duration. The duration is a rounded number, so a time that follows is only known to
+// half a duration.
+bool CDVLayerMerge::Queue(Track& track, AVPacket* packet)
+{
+  Waiting waiting;
+  waiting.time = packet->dts;
+  if (packet->dts == AV_NOPTS_VALUE && track.known && track.time != AV_NOPTS_VALUE &&
+      track.duration > 0 && track.time <= std::numeric_limits<int64_t>::max() - track.duration)
+  {
+    waiting.time = track.time + track.duration;
+    waiting.slack = track.duration / 2;
+  }
+  track.time = waiting.time;
+  track.duration = packet->duration;
+  track.known = true;
+
+  waiting.packet = av_packet_alloc();
+  if (!waiting.packet)
+  {
+    av_packet_unref(packet);
+    return false;
+  }
+  av_packet_move_ref(waiting.packet, packet);
+  track.waiting.push_back(waiting);
+  return true;
+}
+
+bool CDVLayerMerge::PushBase(AVPacket* packet)
+{
+  if (m_silent < m_silentAfter && ++m_silent == m_silentAfter && !m_any)
+    m_absent = true;
+  return Queue(m_base, packet);
+}
+
+bool CDVLayerMerge::PushEnhancement(AVPacket* packet)
+{
+  m_silent = 0;
+  m_any = true;
+  m_absent = false;
+  if (m_enhancement.waiting.size() >= MAX_QUEUED)
+  {
+    av_packet_free(&m_enhancement.waiting.front().packet);
+    m_enhancement.waiting.pop_front();
+    m_counts.dropped++;
+  }
+  return Queue(m_enhancement, packet);
+}
+
+bool CDVLayerMerge::Append(AVPacket* base, const uint8_t* enhancement, size_t size)
+{
+  if (!base || base->size < 0 || !enhancement || size == 0)
+    return false;
+
+  size_t extra = 0;
+  if (!ForEachUnit(enhancement, size, [&extra](const uint8_t* unit, size_t length) {
+        const unsigned int type = (unit[0] >> 1) & 0x3f;
+        extra += sizeof(START_CODE) + (type == NAL_RPU ? 0 : sizeof(WRAP)) + length;
+      }))
+    return false;
+
+  if (extra == 0 ||
+      extra > static_cast<size_t>(std::numeric_limits<int>::max() - AV_INPUT_BUFFER_PADDING_SIZE) -
+                  static_cast<size_t>(base->size))
+    return false;
+
+  const int before = base->size;
+  if (av_grow_packet(base, static_cast<int>(extra)) < 0)
+    return false;
+
+  uint8_t* out = base->data + before;
+  ForEachUnit(enhancement, size, [&out](const uint8_t* unit, size_t length) {
+    const unsigned int type = (unit[0] >> 1) & 0x3f;
+    std::memcpy(out, START_CODE, sizeof(START_CODE));
+    out += sizeof(START_CODE);
+    if (type != NAL_RPU)
+    {
+      std::memcpy(out, WRAP, sizeof(WRAP));
+      out += sizeof(WRAP);
+    }
+    std::memcpy(out, unit, length);
+    out += length;
+  });
+  return true;
+}
+
+// Two packets are of the same access unit when their decoding times are the same: exactly for
+// two times of their own, within the slack when one of them follows from the unit before it.
+bool CDVLayerMerge::SameUnit(const Waiting& a, const Waiting& b)
+{
+  if (a.time == AV_NOPTS_VALUE || b.time == AV_NOPTS_VALUE)
+    return false;
+
+  const uint64_t apart = a.time > b.time
+                             ? static_cast<uint64_t>(a.time) - static_cast<uint64_t>(b.time)
+                             : static_cast<uint64_t>(b.time) - static_cast<uint64_t>(a.time);
+  return apart <= static_cast<uint64_t>(std::max(a.slack, b.slack));
+}
+
+bool CDVLayerMerge::After(const Waiting& enhancement, const Waiting& base)
+{
+  return enhancement.time != AV_NOPTS_VALUE && base.time != AV_NOPTS_VALUE &&
+         enhancement.time > base.time && !SameUnit(enhancement, base);
+}
+
+// Whether the enhancement layer is past the first base packet: it has a packet of a later time,
+// or the packet of a base packet that came later. The tracks have their access units in the same
+// order, so the packet of the first one would have come before those.
+bool CDVLayerMerge::Passed() const
+{
+  const Waiting& base = m_base.waiting.front();
+  return std::any_of(m_enhancement.waiting.begin(), m_enhancement.waiting.end(),
+                     [this, &base](const Waiting& enhancement)
+                     {
+                       return After(enhancement, base) ||
+                              std::any_of(m_base.waiting.begin() + 1, m_base.waiting.end(),
+                                          [&enhancement](const Waiting& later)
+                                          { return SameUnit(later, enhancement); });
+                     });
+}
+
+bool CDVLayerMerge::Pop(AVPacket* packet, bool end)
+{
+  if (m_base.waiting.empty())
+    return false;
+
+  Waiting base = m_base.waiting.front();
+  const auto match =
+      std::find_if(m_enhancement.waiting.begin(), m_enhancement.waiting.end(),
+                   [&base](const Waiting& enhancement) { return SameUnit(base, enhancement); });
+
+  if (match == m_enhancement.waiting.end())
+  {
+    // Its enhancement packet may still come; but a packet whose time is not known has none.
+    if (base.time != AV_NOPTS_VALUE && !end && m_silent < m_silentAfter &&
+        m_base.waiting.size() < MAX_WAITING && !Passed())
+      return false;
+
+    m_counts.alone++;
+  }
+  else
+  {
+    m_counts.waited = std::max(m_counts.waited, m_base.waiting.size());
+    m_counts.queued = std::max(m_counts.queued, m_enhancement.waiting.size());
+
+    // what the enhancement layer has before it belongs to base packets that are gone
+    for (auto it = m_enhancement.waiting.begin(); it != match; ++it)
+    {
+      av_packet_free(&it->packet);
+      m_counts.dropped++;
+    }
+    AVPacket* enhancement = match->packet;
+    m_enhancement.waiting.erase(m_enhancement.waiting.begin(), match + 1);
+
+    if (Append(base.packet, enhancement->data,
+               static_cast<size_t>(std::max(enhancement->size, 0))))
+      m_counts.joined++;
+    else
+    {
+      m_counts.malformed++;
+      m_counts.alone++;
+    }
+    av_packet_free(&enhancement);
+  }
+
+  m_base.waiting.pop_front();
+  av_packet_move_ref(packet, base.packet);
+  av_packet_free(&base.packet);
+  return true;
+}
+
+int CDVLayerMerge::Read(AVFormatContext* context, int base, int enhancement, AVPacket* packet)
+{
+  while (true)
+  {
+    if (Pop(packet, m_end))
+      return 0;
+
+    const int result = av_read_frame(context, packet);
+    if (result == AVERROR_EOF && !m_end)
+    {
+      // what waits goes out first; the next read reports the end again
+      m_end = true;
+      continue;
+    }
+    m_end = false;
+    if (result < 0)
+      return result;
+
+    if (packet->stream_index == base)
+      PushBase(packet);
+    else if (packet->stream_index == enhancement)
+      PushEnhancement(packet);
+    else
+      return 0;
+  }
+}
