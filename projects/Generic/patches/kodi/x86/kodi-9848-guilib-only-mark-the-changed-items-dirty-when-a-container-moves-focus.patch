From 85bb73b8e8294d27976a18ea68b461bfcd208578 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Thu, 22 Oct 2026 02:08:44 +0200
Subject: [PATCH] [guilib] Only mark the changed items dirty when a container
 moves focus

Moving the cursor marked the whole container dirty, so moving between
two tiles of a panel redrew all of it. Only the previously and the
newly focused item change, but the switch between their layouts isn't
marked by the layouts themselves. Mark the regions of both layouts of
these items instead.
---
 xbmc/guilib/GUIBaseContainer.cpp | 17 ++++++++++++++++-
 xbmc/guilib/GUIListItemLayout.h  |  1 +
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/xbmc/guilib/GUIBaseContainer.cpp b/xbmc/guilib/GUIBaseContainer.cpp
index 168b869..654ed39 100644
--- a/xbmc/guilib/GUIBaseContainer.cpp
+++ b/xbmc/guilib/GUIBaseContainer.cpp
@@ -263,6 +263,20 @@ void CGUIBaseContainer::ProcessItem(float posX,
     {
       item->SetFocusedLayout(std::make_unique<CGUIListItemLayout>(*m_focusedLayout, this));
     }
+    if (item != m_lastItem)
+    {
+      // the layouts don't mark the switch between them as dirty
+      const auto addLayoutRegions = [&dirtyregions](CGUIListItem& listItem)
+      {
+        if (listItem.GetLayout())
+          dirtyregions.emplace_back(listItem.GetLayout()->GetRenderRegion());
+        if (listItem.GetFocusedLayout())
+          dirtyregions.emplace_back(listItem.GetFocusedLayout()->GetRenderRegion());
+      };
+      addLayoutRegions(*item);
+      if (m_lastItem)
+        addLayoutRegions(*m_lastItem);
+    }
     if (item->GetFocusedLayout())
     {
       if (item != m_lastItem || !HasFocus())
@@ -1722,8 +1736,9 @@ void CGUIBaseContainer::GetCacheOffsets(int &cacheBefore, int &cacheAfter) const
 
 void CGUIBaseContainer::SetCursor(int cursor)
 {
+  // ProcessItem() marks the items whose focus changed
   if (m_cursor != cursor)
-    MarkDirtyRegion();
+    MarkDirtyRegion(DIRTY_STATE_CHILD);
   m_cursor = cursor;
 }
 
diff --git a/xbmc/guilib/GUIListItemLayout.h b/xbmc/guilib/GUIListItemLayout.h
index 0358e56..ddee542 100644
--- a/xbmc/guilib/GUIListItemLayout.h
+++ b/xbmc/guilib/GUIListItemLayout.h
@@ -30,6 +30,7 @@ public:
   void Process(CGUIListItem *item, int parentID, unsigned int currentTime, CDirtyRegionList &dirtyregions);
   void Render(CGUIListItem *item, int parentID);
   float Size(ORIENTATION orientation) const;
+  const CRect& GetRenderRegion() const { return m_group.GetRenderRegion(); }
   unsigned int GetFocusedItem() const;
   void SetFocusedItem(unsigned int focus);
   bool IsAnimating(ANIMATION_TYPE animType);
-- 
