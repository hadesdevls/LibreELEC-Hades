From 5799d0a39c7d629b4cbdfd45d635961c4e567bd8 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:05:41 +0000
Subject: [PATCH] tools/dvbridge: the composed planes of the source transport
 in 16 bits

The source transport has libplacebo's composer write the composed planes into textures of the bridge's
(dovi_ccm_planes), and only compose (dovi_ccm_only): nothing reads them but the packer, which takes
each sample as a code, floor(value * 4096 + 0.5). They were 32-bit floats, the formats the composer
picks: R32F for the luma, RG32F for the chroma, 49.8 MB written and read again for a 4K picture.

Where the GPU renders to 16-bit normalized textures (R16, RG16: EXT_texture_norm16 on OpenGL ES) and
libplacebo takes them (libplacebo-9960, PL_DOVI_CCM_PLANES_UNORM16), the planes are made in those: a
12-bit code is stored there within 1/16 of its step, so the packer reads the same code from half the
bytes (24.9 MB for a 4K picture). Elsewhere 32-bit floats, as before.

Measured on Mesa's software OpenGL ES (zink on lavapipe), the planes in R16 and RG16 (3.1 million
samples of a 1080p chart not on a whole 1/4096, as 16-bit planes have them) against R32F and RG32F:
every output of the fidelity bench the same bytes, the composed planes read back as codes among them
(the source transport at levels 0 to 3, a GUI over the composed way, the 1080p pictures scaled to the
raster: 98, 85 and 98 files, 42 of them planes), a scaled profile 5 chart and a zoomed profile 7 FEL
picture the same bytes both ways and the CPU's reference, and the measured-bridge test's drawings the
same.
---
 tools/dvbridge/dvbridge_render.c | 32 +++++++++++++++++++++++++-------
 1 file changed, 25 insertions(+), 7 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 7fac715..8e251b8 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -718,7 +718,13 @@ static bool source_possible(struct dvbridge_renderer *r, const struct pl_frame *
 }
 
 /* Hades: our textures for the composed planes, of the sizes of the picture's planes and in the
- * formats that libplacebo's composer picks (pl_render_params.dovi_ccm_planes) */
+ * formats that libplacebo's composer picks (pl_render_params.dovi_ccm_planes). Hades: or, where
+ * the GPU renders to them, in 16-bit normalized ones (R16, RG16: EXT_texture_norm16 on OpenGL ES),
+ * which the source transport may take (it only composes, dovi_ccm_only): the composer's 12-bit
+ * codes are stored in them within 1/16 of a code, and every reader of the packer takes a code as
+ * floor(value * 4096 + 0.5): the same codes from half the bytes (for a 4K picture 24.9 MB
+ * written, and read by the packer, where it was 49.8: 33.2 of luma and 16.6 of chroma in 32-bit
+ * floats). */
 static bool source_planes(struct dvbridge_renderer *r, const struct pl_frame *source)
 {
     pl_tex luma = NULL;
@@ -726,13 +732,25 @@ static bool source_planes(struct dvbridge_renderer *r, const struct pl_frame *so
         for (int c = 0; c < source->planes[p].components; ++c)
             if (source->planes[p].component_mapping[c] == PL_CHANNEL_Y)
                 luma = source->planes[p].texture;
-    pl_fmt f1 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 1, 32, 32,
-                            PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
-    pl_fmt f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32, PL_FMT_CAP_SAMPLEABLE |
-                            PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_LINEAR);
-    if (!f2)
-        f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32,
+    pl_fmt f1 = NULL, f2 = NULL;
+#ifdef PL_DOVI_CCM_PLANES_UNORM16
+    f1 = pl_find_fmt(r->gpu, PL_FMT_UNORM, 1, 16, 16,
+                     PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    f2 = pl_find_fmt(r->gpu, PL_FMT_UNORM, 2, 16, 16,
+                     PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    if (!f1 || !f2 || f1->component_depth[0] != 16 || f2->component_depth[0] != 16 ||
+        f2->component_depth[1] != 16)
+        f1 = f2 = NULL;
+#endif
+    if (!f1) {
+        f1 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 1, 32, 32,
                          PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+        f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32, PL_FMT_CAP_SAMPLEABLE |
+                         PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_LINEAR);
+        if (!f2)
+            f2 = pl_find_fmt(r->gpu, PL_FMT_FLOAT, 2, 32, 32,
+                             PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    }
     if (!luma || !f1 || !f2 ||
         !pl_tex_recreate(r->gpu, &r->planes[0], pl_tex_params(.w = luma->params.w,
             .h = luma->params.h, .format = f1, .sampleable = true, .renderable = true)) ||
