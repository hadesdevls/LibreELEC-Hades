@@ -2968,3 +2968,15 @@ msgstr ""
 msgctxt "#32267"
 msgid "The highest luminance, in cd/m², that the HDR10 InfoFrame tells the display (the peak of the display, measured, for a projector). Applies from the next video."
 msgstr ""
