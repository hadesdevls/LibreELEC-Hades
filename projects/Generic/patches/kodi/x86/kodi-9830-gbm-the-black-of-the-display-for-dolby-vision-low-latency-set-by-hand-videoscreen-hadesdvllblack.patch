diff --git a/addons/skin.estuary/language/resource.language.es_es/strings.po b/addons/skin.estuary/language/resource.language.es_es/strings.po
index 5ecf187..0e89f68 100644
--- a/addons/skin.estuary/language/resource.language.es_es/strings.po
+++ b/addons/skin.estuary/language/resource.language.es_es/strings.po
@@ -2823,3 +2823,15 @@ msgstr "HDR10: la luminancia que se dice como mucho"
 msgctxt "#32267"
 msgid "The highest luminance, in cd/m², that the HDR10 InfoFrame tells the display (the peak of the display, measured, for a projector). Applies from the next video."
 msgstr "La luminancia más alta, en cd/m², que el InfoFrame de HDR10 dice a la pantalla (el pico de la pantalla, medido, para un proyector). Se aplica desde el siguiente vídeo."
+
+#. Hades: label of setting "videoscreen.hadesdvllblack" (core #40980)
+#: system/settings/settings.xml
+msgctxt "#32276"
+msgid "Low-Latency: black of the display"
+msgstr "Low-Latency: negro de la pantalla"
+
+#. Hades: help of setting "videoscreen.hadesdvllblack" (core #40981)
+#: system/settings/settings.xml
+msgctxt "#32277"
+msgid "The black that the display really has, in cd/m², measured on it: Dolby Vision Low-Latency then takes the black of the film to it, with the black level lift of ITU-R BT.2390, so that what is just above black does not sink into the black of the display. The darkest parts rise the most, the brighter ones less, and the peak not at all. Measured on a test film with 0.05 cd/m²: its darkest parts come out at 0.06 cd/m², a shadow of 0.27 cd/m² at 0.54, one of 2 cd/m² at 2.5, mid tones of 22 cd/m² at 23, and the highlights do not change; with 0.0005 cd/m² (an OLED) the darkest parts come out at 0.0017 cd/m² and the rest nearly as before. Too high a value greys the blacks. 0 keeps the black of the film, as before. Applies from the next video."
+msgstr "El negro que la pantalla tiene de verdad, en cd/m², medido en ella: Dolby Vision Low-Latency lleva entonces el negro de la película a él, con la elevación del nivel de negro de ITU-R BT.2390, para que lo que está justo por encima del negro no se hunda en el negro de la pantalla. Las partes más oscuras suben más, las más claras menos, y el pico nada. Medido en una película de prueba con 0,05 cd/m²: sus partes más oscuras salen a 0,06 cd/m², una sombra de 0,27 cd/m² a 0,54, una de 2 cd/m² a 2,5, los tonos medios de 22 cd/m² a 23, y las luces altas no cambian; con 0,0005 cd/m² (un OLED) las partes más oscuras salen a 0,0017 cd/m² y el resto casi como antes. Un valor demasiado alto agrisa los negros. 0 conserva el negro de la película, como antes. Se aplica desde el siguiente vídeo."
diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 10b1ecc..2b85de3 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3590,6 +3590,34 @@
         </dependencies>
         <control type="spinner" format="string" />
       </setting>
+      <!-- Hades: the black of the display for Low-Latency, set by hand with its peak and colours: 0 keeps the
+           black of the source, as before -->
+      <setting id="videoscreen.hadesdvllblack" type="number" parent="videoscreen.hadesdvllmanual" label="40980" help="40981">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <level>3</level>
+        <default>0</default>
+        <constraints>
+          <minimum>0</minimum>
+          <step>0.0005</step>
+          <maximum>0.5</maximum>
+        </constraints>
+        <dependencies>
+          <dependency type="enable">
+            <and>
+              <condition setting="videoscreen.hadesdvlowlatency" operator="is">true</condition>
+              <condition setting="videoscreen.hadesdvllmanual" operator="is">true</condition>
+            </and>
+          </dependency>
+        </dependencies>
+        <control type="slider" format="number">
+          <format>{:.4f} cd/m²</format>
+        </control>
+      </setting>
       <!-- Hades: shown only where the display asks for the HDMI 1.4b signalling -->
       <setting id="videoscreen.hadesdvhdmi14b" type="boolean" label="39878" help="39879">
         <requirement>
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index 88b0118..52b3e81 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -436,6 +436,8 @@ public:
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLMANUAL = "videoscreen.hadesdvllmanual";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLPEAK = "videoscreen.hadesdvllpeak";
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLGAMUT = "videoscreen.hadesdvllgamut";
+  //! Hades: ... and its black, cd/m2 (0: the black of the source kept)
+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVLLBLACK = "videoscreen.hadesdvllblack";
   //! Hades: native output with the older signalling, the HDMI 1.4b vendor InfoFrame, where the
   //! display asks for it (TVs of 2016); off by default, from the next video
   static constexpr auto SETTING_VIDEOSCREEN_HADESDVHDMI14B = "videoscreen.hadesdvhdmi14b";
diff --git a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
index 7f87938..c8333ce 100644
--- a/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
+++ b/xbmc/settings/dialogs/GUIDialogSettingsBase.cpp
@@ -599,6 +599,9 @@ std::string CGUIDialogSettingsBase::GetLocalizedString(uint32_t labelId) const
   // the luminance told to the display by the HDR10 InfoFrame, limited (System > Display): labels, help
   if (labelId >= 40974 && labelId <= 40977)
     return CGUIUtils::GetHadesString(labelId, 32264 + (labelId - 40974));
+  // the black of the display for Dolby Vision Low-Latency (System > Display): label, help
+  if (labelId >= 40980 && labelId <= 40983)
+    return CGUIUtils::GetHadesString(labelId, 32276 + (labelId - 40980));
   // the help of the Monitor setting (System > Display), in place of Kodi's #40803
   if (labelId == 39853)
     return CGUIUtils::GetHadesString(39853, 31724);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index c9ec563..408bcd0 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2863,6 +2863,12 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
                       : gamut == 2 ? DVBRIDGE_HDR10_GAMUT_BT709
                                    : DVBRIDGE_HDR10_GAMUT_P3_D65;
       dvbridge_hdr10_gamut_xy(mapping.gamut, mapping.target_xy);
+      // ... and its black (videoscreen.hadesdvllblack; 0: the black of the source kept), within what the
+      // mapping takes (dvbridge_hdr10_mapping::black)
+      const double black = settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVLLBLACK)
+                               ? settings->GetNumber(CSettings::SETTING_VIDEOSCREEN_HADESDVLLBLACK)
+                               : 0.0;
+      mapping.black = std::isfinite(black) ? static_cast<float>(std::clamp(black, 0.0, 0.5)) : 0.0f;
       m_dvLowLatencyManual = true;
     }
     else
@@ -2895,7 +2901,8 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
     }
   }
   const auto same = [](const dvbridge_hdr10_mapping& a, const dvbridge_hdr10_mapping& b) {
-    if (a.enabled != b.enabled || a.source_known != b.source_known || a.peak != b.peak)
+    if (a.enabled != b.enabled || a.source_known != b.source_known || a.peak != b.peak ||
+        a.black != b.black)
       return false;
     for (int i = 0; i < 8; ++i)
       if (a.target_xy[i] != b.target_xy[i] || a.source_xy[i] != b.source_xy[i])
@@ -2907,13 +2914,19 @@ dvbridge_hdr10_mapping CWinSystemGbmGLESContext::TakeDVLowLatencyMapping(const V
               "DVBridge: Dolby Vision Low-Latency is mapped to the display by LibreELEC Hades (not by "
               "Dolby's display management): to {:.0f} cd/m2 and the primaries {:.4f},{:.4f} "
               "{:.4f},{:.4f} {:.4f},{:.4f} {}, with the BT.2390 curve, guided by each scene's level 1 "
-              "metadata; the colours of the source within {}; its black kept{}",
+              "metadata; the colours of the source within {}; {}{}",
               mapping.peak, mapping.target_xy[0], mapping.target_xy[1], mapping.target_xy[2],
               mapping.target_xy[3], mapping.target_xy[4], mapping.target_xy[5],
               m_dvLowLatencyManual ? "set in the settings (videoscreen.hadesdvllmanual)"
                                    : "of its Dolby Vision block",
               mapping.source_known ? "the gamut of its mastering display"
                                    : "BT.2020 (its mastering display is not known)",
+              mapping.black > 0.0f
+                  ? StringUtils::Format("its black taken to {:.4f} cd/m2, the black of the display set "
+                                        "in the settings, with the black level lift of ITU-R BT.2390 "
+                                        "(videoscreen.hadesdvllblack)",
+                                        mapping.black)
+                  : std::string("its black kept"),
               NativeDVLowLatencyOverStandard()
                   ? "; the display takes Dolby Vision Standard too, and Low-Latency is sent as the "
                     "setting asks (videoscreen.hadesdvllalways)"
