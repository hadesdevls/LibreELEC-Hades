+/* Hades: the simplified rounding under the GUI (dvbridge_source_simplify()), asked for from the
+ * next frame on: only the pixels drawn over a picture of profile 5 that goes out in the source
+ * transport are drawn another way (a code apart in values close to a half). simplifiable: the last
+ * picture prepared is one that it would be drawn for (in the source transport, its decoding not
+ * affine, its programs made); simplified: the last frame packed was drawn with it. */
+#define DVBRIDGE_RENDER_SIMPLIFY 1
+void dvbridge_render_simplify_gui(struct dvbridge_renderer *renderer, bool simplify);
+bool dvbridge_render_gui_simplifiable(const struct dvbridge_renderer *renderer);
+bool dvbridge_render_gui_simplified(const struct dvbridge_renderer *renderer);
 /* Hades: the target of dvbridge_render_packed() that wraps the window: the default framebuffer
  * (pl_opengl_wrap() without a texture or a framebuffer), which the packer of the source transport
  * draws into as framebuffer 0. Any other target is a texture, which is packed into through the
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index 2d16529..baefcc4 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -651,6 +651,72 @@ static const char PICTURE_CORR[] =
     "    correction = exact ? vec4(codes - to_source(under), 1.0) : vec4(0.0);\n"
     "}\n";
 
+/* Hades: the simplified rounding under the GUI, which the caller asks for where the frames with
+ * GUI elements of a profile 5 picture do not keep up (dvbridge_source_simplify()): passes 3 and 8
+ * without the correction of the first form of drawn_over(), the float error of the round trip of
+ * the picture under the pixel, which the rounding of a code takes in all but a value close to a
+ * half; and the even pixel's luma and the chroma of the pair from one call. A pixel drawn over can
+ * come out a code apart from the exact conversion in those values (measured with lavapipe, and an
+ * integrated Radeon and an RTX 4080 through D3D12, on 81 frames of three profile 5 pictures under
+ * nine kinds of GUI: at most one code, for one pixel drawn over in 190 to 320); the pixels that
+ * nothing is drawn over, and the affine profiles, are not drawn by these. Pass 3: the picture as
+ * PICTURE_CORR draws it, and whether the first form holds without its correction, in a target of
+ * its own of a byte a pixel (a sixteenth of what the corrections take to write and to read). */
+static const char PICTURE_FLAG[] =
+    "#version 300 es\n"
+    COMMON
+    "layout(location = 0) out vec4 color;\n"
+    "layout(location = 1) out vec4 flag;\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+    "    vec3 codes = codes_at(p);\n"
+    "    vec3 raw = inside(p.x, p.y) ? decode(codes) : vec3(0.0);\n"
+    "    vec3 under = clamp(raw, 0.0, 1.0);\n"
+    "    color = vec4(under, 2.0);\n"
+    "    bool exact = affine != 0;\n"
+    "    if (!exact) {\n"
+    "        vec3 tp = ycc_forward * (codes / code_scale - ycc_offset);\n"
+    "        exact = all(greaterThanEqual(tp, vec3(0.0))) && all(lessThanEqual(tp, vec3(1.0))) &&\n"
+    "                raw == under;\n"
+    "    }\n"
+    "    flag = vec4(exact ? 1.0 : 0.0);\n"
+    "}\n";
+/* ... and pass 8 */
+static const char PAIRS_SIMPLE[] =
+    "#version 300 es\n"
+    COMMON
+    DRAWN_OVER
+    "uniform highp sampler2D drawn;\n"
+    "uniform highp sampler2D flags;\n"
+    "out uvec4 color;\n"
+    "vec3 drawn_over_simple(ivec2 p, vec4 d)\n"
+    "{\n"
+    "    if (texelFetch(flags, p, 0).r > 0.5)\n"
+    "        return to_source(d.rgb);\n"
+    "    float a = 2.0 - d.a;\n"
+    "    vec3 codes = codes_at(p);\n"
+    "    vec3 raw = inside(p.x, p.y) ? decode(codes) : vec3(0.0);\n"
+    "    vec3 under = clamp(raw, 0.0, 1.0);\n"
+    "    vec3 colour = (d.rgb - (1.0 - a) * under) / a;\n"
+    "    return (1.0 - a) * codes + a * to_source(colour);\n"
+    "}\n"
+    "void main()\n"
+    "{\n"
+    "    ivec2 e = ivec2(gl_FragCoord.xy) * ivec2(2, 1), o = e + ivec2(1, 0);\n"
+    "    vec4 de = texelFetch(drawn, e, 0), dq = texelFetch(drawn, o, 0);\n"
+    "    uvec4 r = uvec4(" NOT_OVER ");\n"
+    "    if (de.a != 2.0) {\n"
+    "        vec3 v = drawn_over_simple(e, de);\n"
+    "        r.x = code(v.x);\n"
+    "        r.z = code(v.y);\n"
+    "        r.w = code(v.z);\n"
+    "    }\n"
+    "    if (dq.a != 2.0)\n"
+    "        r.y = code(drawn_over_simple(o, dq).x);\n"
+    "    color = r;\n"
+    "}\n";
+
 /* 5. The edges drawn over (dvbridge_source_cover()): the raster in blocks of COVER_BLOCK x COVER_BLOCK
  * pixels, a texel for each, which holds as its colour the edges that the pixels of the bars in its block
  * (those outside the active picture) that are drawn over (alpha not 2) lie beyond; read back, the texels
@@ -851,6 +917,20 @@ struct dvbridge_source_packer {
     } r_more;
     struct texture corrections;
     bool corrections_made;
+    /* Hades: the simplified rounding under the GUI (PICTURE_FLAG and PAIRS_SIMPLE, both or none,
+     * and the framebuffer of PICTURE_FLAG with the picture and the flags): asked for (simplify),
+     * drawn by pass 3 of the last picture (corrections_simple: the flags were written, not the
