@@ -1350,14 +1456,28 @@ static bool corrections_target(struct dvbridge_source_packer *p, unsigned frameb
     return ok;
 }
 
+/* ... of PICTURE_CORR, with the corrections */
+static bool corrections_target(struct dvbridge_source_packer *p, unsigned framebuffer)
+{
+    return second_target(framebuffer, &p->corrections, GL_RGBA32F, &p->corrections_fbo);
+}
+
+/* ... of PICTURE_FLAG, with the flags of the simplified rounding */
+static bool flags_target(struct dvbridge_source_packer *p, unsigned framebuffer)
+{
+    return second_target(framebuffer, &p->flags, GL_R8, &p->flags_fbo);
+}
