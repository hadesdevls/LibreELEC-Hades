- * where it cannot be made. */
-static bool corrections_target(struct dvbridge_source_packer *p, unsigned framebuffer)
+/* Hades: a framebuffer of pass 3 with a second target, bound: the texture of the picture of
+ * framebuffer (bound, and checked by the caller) and second (made of format if it is not). False,
