+    static const char *const pairs_simple[] = {"drawn", "code_max", "ycc_inverse", "lms_inverse",
+        "drawn_tiles", "tiles_mode", "tiles_flip", "flags"};
     static const char *const resite[] = {"chroma_plane", "code_scale", "taps", "first", "last_col",
                                          "weights"};
     static const char *const rows[] = {"chroma_plane", "chroma_read", "chroma_shift", "taps",
@@ -947,6 +1030,8 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
     _Static_assert(sizeof(p->q) == COUNT(pairs) * sizeof(GLint), "pairs uniforms");
     _Static_assert(sizeof(p->w_more) == COUNT(pack_pairs) * sizeof(GLint), "pack_pairs uniforms");
     _Static_assert(sizeof(p->r_more) == COUNT(picture_corr) * sizeof(GLint), "picture_corr uniforms");
+    _Static_assert(sizeof(p->f_more) == COUNT(picture_flag) * sizeof(GLint), "picture_flag uniforms");
+    _Static_assert(sizeof(p->s_more) == COUNT(pairs_simple) * sizeof(GLint), "pairs_simple uniforms");
     /* (Hades: passes 3 and 4 over the raster or over its tiles) */
     p->pack = link_with(TILED_VERTEX, PACK);
     p->picture = link_with(TILED_VERTEX, PICTURE);
@@ -1013,6 +1098,23 @@ struct dvbridge_source_packer *dvbridge_source_packer_create(void)
         fprintf(stderr, "DV source transport: the pass that converts the pixels drawn over a "
                         "profile 5 picture once could not be made; they are converted as before\n");
     }
+    /* Hades: the simplified rounding under the GUI, with those three and only with them: both of
+     * its programs or none (then the rounding is the exact one whatever is asked) */
+    if (p->pairs_program) {
+        p->picture_flag = link_with(TILED_VERTEX, PICTURE_FLAG);
+        p->pairs_simple = link_with(TILED_VERTEX, PAIRS_SIMPLE);
+        if (!p->picture_flag || !p->pairs_simple ||
+            !locate(p->picture_flag, &p->fc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+            !locate(p->picture_flag, &p->f_more.tiles, picture_flag, COUNT(picture_flag)) ||
+            !locate(p->pairs_simple, &p->sc.luma, COMMON_NAMES, COUNT(COMMON_NAMES)) ||
+            !locate(p->pairs_simple, &p->s_more.drawn, pairs_simple, COUNT(pairs_simple))) {
+            glDeleteProgram(p->picture_flag);
+            glDeleteProgram(p->pairs_simple);
+            p->picture_flag = p->pairs_simple = 0;
+            fprintf(stderr, "DV source transport: the simplified rounding under the GUI could not "
+                            "be made; the rounding is the exact one\n");
+        }
+    }
     glGenVertexArrays(1, &p->vao);
     glGenSamplers(1, &p->sampler);
     glSamplerParameteri(p->sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
@@ -1044,6 +1146,8 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     texture_destroy(&p->pairs);
     texture_destroy(&p->corrections);
     glDeleteFramebuffers(1, &p->corrections_fbo);
+    texture_destroy(&p->flags);
+    glDeleteFramebuffers(1, &p->flags_fbo);
     glDeleteVertexArrays(1, &p->vao);
     glDeleteSamplers(1, &p->sampler);
     glDeleteProgram(p->pack);
@@ -1057,6 +1161,8 @@ void dvbridge_source_packer_destroy(struct dvbridge_source_packer *p)
     glDeleteProgram(p->pairs_program);
     glDeleteProgram(p->pack_pairs);
     glDeleteProgram(p->picture_corr);
+    glDeleteProgram(p->picture_flag);
+    glDeleteProgram(p->pairs_simple);
     free(p);
 }
 
