 tools/dvbridge/dvbridge_render.c |  17 +++
 tools/dvbridge/dvbridge_render.h |   9 ++
 tools/dvbridge/dvbridge_source.c | 237 ++++++++++++++++++++++++++-----
 tools/dvbridge/dvbridge_source.h |  11 ++
 4 files changed, 240 insertions(+), 34 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 3a143b8..fa2ef72 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1840,6 +1840,23 @@ bool dvbridge_render_source_planes(const struct dvbridge_renderer *r, unsigned t
     return textures[0] && textures[1];
 }
 
+void dvbridge_render_simplify_gui(struct dvbridge_renderer *r, bool simplify)
+{
+    if (r)
+        dvbridge_source_simplify(r->source_packer, simplify);
+}
+
+bool dvbridge_render_gui_simplifiable(const struct dvbridge_renderer *r)
+{
+    return r && r->ready && r->source && !r->source_params.affine &&
+           dvbridge_source_can_simplify(r->source_packer);
+}
+
+bool dvbridge_render_gui_simplified(const struct dvbridge_renderer *r)
+{
+    return r && r->source_packer && dvbridge_source_simplified(r->source_packer);
+}
+
 bool dvbridge_render_direct_fits(const struct dvbridge_renderer *r, struct dvbridge_geometry g)
 {
     /* (Hades: Low-Latency is drawn the composed way only) */
