+static bool second_target(unsigned framebuffer, struct texture *second, GLenum format, GLuint *fbo)
 {
     GLint kind = 0, picture = 0, level = -1;
     glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
@@ -1327,15 +1433,15 @@ static bool corrections_target(struct dvbridge_source_packer *p, unsigned frameb
