From dbd37df312e2b3649fababd59be226f80aa993b3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sat, 10 Oct 2026 21:49:33 +0000
Subject: [PATCH] EGLFence: forget a sync object once it is destroyed

WaitSyncCPU() destroys the sync object of the last commit's out-fence
after waiting for it, and FlushFence() the one of the GPU work, but both
kept the handle. A frame that brings no new out-fence (the commit before
it was refused, or gave none) then called eglClientWaitSyncKHR() and
eglDestroySyncKHR() on the destroyed handle.

Mesa tells a valid handle by whether its address is that of a live sync
object. The renderers keep sync objects of their own for the buffers of
the decoder (CRendererVAAPIGLES, CRendererDRMPRIMEGLES), of the same kind
and size: one of them made at that address meanwhile would be waited for
and destroyed here, and its buffer would then never be given back, or be
given back by the fence of another.

Until now only a refused commit led there. Native Dolby Vision frames can
now take the out-fence that the ordinary path left (the commit after this
one), which makes the first ordinary frame after them such a frame.
---
 xbmc/utils/EGLFence.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/xbmc/utils/EGLFence.cpp b/xbmc/utils/EGLFence.cpp
index 58a9ec1..d7bfb78 100644
--- a/xbmc/utils/EGLFence.cpp
+++ b/xbmc/utils/EGLFence.cpp
@@ -115,6 +115,7 @@ EGLint CEGLFence::FlushFence()
     CEGLUtils::Log(LOGERROR, "failed to duplicate EGL fence fd");
 
   m_eglDestroySyncKHR(m_display, m_gpuFence);
+  m_gpuFence = EGL_NO_SYNC_KHR;
 
   return fd;
 }
@@ -134,6 +135,11 @@ void CEGLFence::WaitSyncCPU()
     return;
 
   if (m_eglClientWaitSyncKHR(m_display, m_kmsFence, 0, EGL_FOREVER_KHR) != EGL_FALSE)
+  {
     m_eglDestroySyncKHR(m_display, m_kmsFence);
+    // The handle is gone: a frame that brings no new fence must not wait on it and destroy it
+    // again. By then it can be the handle of another sync object.
+    m_kmsFence = EGL_NO_SYNC_KHR;
+  }
 }
 #endif
