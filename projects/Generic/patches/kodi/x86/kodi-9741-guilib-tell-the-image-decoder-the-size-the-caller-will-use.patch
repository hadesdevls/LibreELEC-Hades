From 6fa5dbb6c0ffa8951c71982bcd610fcc9dd64a78 Mon Sep 17 00:00:00 2001
From: Dom Cobley <popcornmix@gmail.com>
Date: Tue, 20 Oct 2026 16:26:58 +0100
Subject: [PATCH] guilib: tell the image decoder the size the caller will use

LoadIImage() always gave the decoder GL_MAX_TEXTURE_SIZE as its size
limit, even when the caller asked for a much smaller ideal size, so a
decoder able to decode at a reduced size had no way to know the caller
only wanted a thumbnail.

Pass the caller's ideal size, bounded by the texture limit, when it asked
for KEEP. The other aspect ratio modes can need more than the ideal size
on at least one axis, so they keep the texture limit.
---
 xbmc/guilib/Texture.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/xbmc/guilib/Texture.cpp b/xbmc/guilib/Texture.cpp
index b92c8b6..425f7d0 100644
--- a/xbmc/guilib/Texture.cpp
+++ b/xbmc/guilib/Texture.cpp
@@ -249,7 +249,16 @@ bool CTexture::LoadIImage(IImage* pImage,
     return false;
 
   unsigned int maxTextureSize = CServiceBroker::GetRenderSystem()->GetMaxTextureSize();
-  if (!pImage->LoadImageFromMemory(buffer, bufSize, maxTextureSize, maxTextureSize))
+  // A decoder that can skip detail we are about to discard needs to know the size we will
+  // actually use. Only KEEP fits the image inside the ideal size; the other modes can need
+  // more than it on at least one axis.
+  const bool keep = aspectRatio == CAspectRatio::KEEP;
+  const unsigned int limitWidth =
+      keep && idealWidth > 0 ? std::min(idealWidth, maxTextureSize) : maxTextureSize;
+  const unsigned int limitHeight =
+      keep && idealHeight > 0 ? std::min(idealHeight, maxTextureSize) : maxTextureSize;
+
+  if (!pImage->LoadImageFromMemory(buffer, bufSize, limitWidth, limitHeight))
     return false;
 
   if (pImage->Width() == 0 || pImage->Height() == 0)
