From 2367e8ab88719de586966bc0d3ea2e1d98d34398 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 21 Oct 2026 07:39:13 +0000
Subject: [PATCH] application: a motion of the mouse that another one follows
 is left for it

Every report of a mouse is an event of the interface, and
CAppInboundProtocol::HandleEvents() handled each one on its own: a mouse
move action through the window manager, which looks up the controls under
the pointer, and, over a window of an add-on, a call into its Python
(WindowXML::OnAction() posts one onAction() for every action, mouse moves
included). With a mouse that reports 1000 times a second, a frame of the
interface at 120 or 60 Hz took 8 to 16 of them, and after a frame that took
long, hundreds: work for the thread that draws the pointer, and a flood of
calls for the add-on whose window is under it.

A motion says where the pointer is, not how far it went, so of motions that
follow one another in the queue only the last one is handled now
(IsMotionFollowedByMotion(), MouseMotionMerge.h). Nothing else is left out:
a button, the wheel or a key between two motions keeps both, in their
order, and the distance from the motion handled before (what a drag
moves) is the same. Only what is queued when an event is taken is looked
at: a motion that arrives while the one before it is handled is handled.

Host test (motion_merge_test, a copy of the loop of HandleEvents() with the
real function): 8 motions in a row give one, the last; a click among motions
keeps its place; a drag of 50 motions gives one with the whole distance;
500 motions after a long frame give one. 4 of its 7 checks fail without the
change.
---
 xbmc/application/AppInboundProtocol.cpp |  7 ++++++
 xbmc/application/AppInboundProtocol.h   |  3 +++
 xbmc/application/CMakeLists.txt         |  3 ++-
 xbmc/application/MouseMotionMerge.h     | 33 +++++++++++++++++++++++++
 4 files changed, 45 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/application/MouseMotionMerge.h

diff --git a/xbmc/application/AppInboundProtocol.cpp b/xbmc/application/AppInboundProtocol.cpp
index 7cac2d7..b56e173 100644
--- a/xbmc/application/AppInboundProtocol.cpp
+++ b/xbmc/application/AppInboundProtocol.cpp
@@ -8,6 +8,7 @@
 
 #include "AppInboundProtocol.h"
 
+#include "MouseMotionMerge.h"
 #include "ServiceBroker.h"
 #include "application/Application.h"
 #include "application/ApplicationComponents.h"
@@ -58,6 +59,12 @@ void CAppInboundProtocol::HandleEvents()
   {
     auto newEvent = m_portEvents.front();
     m_portEvents.pop_front();
+    // Hades: of motions of the mouse that follow one another, only the last is handled
+    if (IsMotionFollowedByMotion(newEvent, m_portEvents))
+    {
+      m_motionsMerged++;
+      continue;
+    }
     CSingleExit lock(m_portSection);
     switch (newEvent.type)
     {
diff --git a/xbmc/application/AppInboundProtocol.h b/xbmc/application/AppInboundProtocol.h
index 5944172..dab5ad1 100644
--- a/xbmc/application/AppInboundProtocol.h
+++ b/xbmc/application/AppInboundProtocol.h
@@ -32,4 +32,7 @@ protected:
   CApplication &m_pApp;
   std::deque<XBMC_Event> m_portEvents;
   CCriticalSection m_portSection;
+  //! Hades: motions of the mouse left for the one that followed them (MouseMotionMerge.h); read
+  //! and reset by CApplication, on the thread of the interface, as HandleEvents()
+  unsigned int m_motionsMerged = 0;
 };
diff --git a/xbmc/application/CMakeLists.txt b/xbmc/application/CMakeLists.txt
index 81c06dd..2c82365 100644
--- a/xbmc/application/CMakeLists.txt
+++ b/xbmc/application/CMakeLists.txt
@@ -31,6 +31,7 @@ set(HEADERS AppEnvironment.h
             ApplicationVolumeHandling.h
             AppParamParser.h
             AppParams.h
-            GUIStallWatch.h)
+            GUIStallWatch.h
+            MouseMotionMerge.h)
 
 core_add_library(application)
diff --git a/xbmc/application/MouseMotionMerge.h b/xbmc/application/MouseMotionMerge.h
new file mode 100644
index 0000000..afcde73
--- /dev/null
+++ b/xbmc/application/MouseMotionMerge.h
@@ -0,0 +1,33 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "windowing/XBMC_events.h"
+
+#include <deque>
+
+/*!
+ * \brief Whether a motion of the mouse in the queue of the events of the interface can be left
+ * for the one that follows it
+ *
+ * A mouse reports its motion up to 1000 times a second and more, and every report was an event
+ * that the thread of the interface handled on its own: a mouse move action through the window
+ * manager (the controls under the pointer looked up), and, over a window of an add-on, a call
+ * into the add-on's Python (WindowXML::OnAction() posts one for every action). A frame of the
+ * interface took 8 to 16 of them at 120 or 60 Hz, more after a frame that took long. A motion
+ * says where the pointer is, not how far it went, so of motions that follow one another in the
+ * queue only the last one is handled; nothing else is left out (a button, the wheel or a key
+ * between two motions keeps both, in their order), and how far the pointer went from the motion
+ * handled before (a drag) is the same.
+ */
+inline bool IsMotionFollowedByMotion(const XBMC_Event& event, const std::deque<XBMC_Event>& queue)
+{
+  return event.type == XBMC_MOUSEMOTION && !queue.empty() &&
+         queue.front().type == XBMC_MOUSEMOTION;
+}
