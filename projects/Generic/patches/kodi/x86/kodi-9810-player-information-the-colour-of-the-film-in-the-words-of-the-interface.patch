 }
 
+/*!
+ * \brief The words of ColourText() in the language of the interface: Estuary's strings, with which
+ *        the player information says its words in every skin ($ADDON[skin.estuary n]; the window
+ *        system takes them so). English where none is given.
+ */
+struct ColourWords
+{
+  std::string notGiven{"not given"}; //!< Estuary #31834
+  std::string assumed{"assumed"}; //!< Estuary #32007
+  std::string fullRange{"full range"}; //!< Estuary #32008
+  std::string limitedRange{"limited range"}; //!< Estuary #32009
+  std::string linear{"linear"}; //!< Estuary #32010: the transfer function AVCOL_TRC_LINEAR
+};
+
 /*!
  * \brief "BT.2020 · PQ · limited range": what the decoder gives the renderer
  * \param primariesAssumed the stream did not say its primaries and Kodi chose them by the size of
  *        the picture (DVDVideoCodecFFmpeg.cpp): then "(assumed)" follows them. A part that the
  *        stream does not give and Kodi does not choose is "not given".
+ * \param words those words, the range and "linear" in the language of the interface (the names
+ *        of the standards are the same in every language)
  */
-inline std::string ColourText(int primaries, int transfer, bool fullRange, bool primariesAssumed)
+inline std::string ColourText(int primaries,
+                              int transfer,
+                              bool fullRange,
+                              bool primariesAssumed,
+                              const ColourWords& words = {})
 {
   const std::string p = PrimariesText(primaries);
-  const std::string t = TransferText(transfer);
-  std::string out = p.empty() ? "not given" : p + (primariesAssumed ? " (assumed)" : "");
-  out += " \xc2\xb7 " + (t.empty() ? std::string("not given") : t);
-  out += fullRange ? " \xc2\xb7 full range" : " \xc2\xb7 limited range";
+  const std::string t = transfer == 8 ? words.linear : TransferText(transfer);
+  std::string out =
+      p.empty() ? words.notGiven : p + (primariesAssumed ? " (" + words.assumed + ")" : "");
+  out += " \xc2\xb7 " + (t.empty() ? words.notGiven : t);
+  out += " \xc2\xb7 " + (fullRange ? words.fullRange : words.limitedRange);
   return out;
 }
 
