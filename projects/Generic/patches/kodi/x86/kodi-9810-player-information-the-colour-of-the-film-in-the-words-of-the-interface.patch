--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -365,14 +365,19 @@ protected:
   //! the video is not HDR. From any thread.
   std::string HdrNotSentCode() const;
   //! \brief Hades, for the player information: what the video that plays says of itself, as it was
-  //! when SetHDR() was given its picture: its colour (primaries, transfer function, range), its
-  //! matrix, its mastering display (max / min, cd/m2) and its light levels (MaxCLL / MaxFALL, or
-  //! "none"); an empty part is not given. Empty while no video plays. From any thread.
+  //! when SetHDR() was given its picture: its colour (primaries, AVCOL_PRI_*, whether Kodi chose
+  //! them, the range; PLAYERINFO::ColourText() says them, in the words of the interface where
+  //! they are shown), its matrix, its mastering display (max / min, cd/m2) and its light levels
+  //! (MaxCLL / MaxFALL, or "none"); an empty part is not given. Nothing while no video plays
+  //! (known is false). From any thread.
   //! (Hades: and its transfer function as a number, AVCOL_TRC_*, -1 while no video plays, for
   //! what the video is where its stream does not say: PLAYERINFO::SourceHdrType())
   struct SourceColour
   {
-    std::string colour;
+    bool known = false;
+    int primaries = -1;
+    bool primariesAssumed = false;
+    bool fullRange = false;
     std::string matrix;
     std::string mastering;
     std::string cll;
