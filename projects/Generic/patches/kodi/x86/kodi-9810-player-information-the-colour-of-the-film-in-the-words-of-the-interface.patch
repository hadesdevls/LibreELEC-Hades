@@ -4368,11 +4368,11 @@ void CWinSystemGbm::NoteSourceColour(const VideoPicture* picture)
     using namespace KODI::UTILS::PLAYERINFO;
     // (the primaries that the stream did not say and Kodi chose by the size of the picture, as
     // CDVDVideoCodecFFmpeg does: VideoPicture::m_originalColorPrimaries is what the stream said)
-    now.colour = ColourText(
-        static_cast<int>(picture->color_primaries), static_cast<int>(picture->color_transfer),
-        picture->color_range != 0,
-        picture->m_originalColorPrimaries == AVCOL_PRI_UNSPECIFIED &&
-            picture->color_primaries != AVCOL_PRI_UNSPECIFIED);
+    now.known = true;
+    now.primaries = static_cast<int>(picture->color_primaries);
+    now.fullRange = picture->color_range != 0;
+    now.primariesAssumed = picture->m_originalColorPrimaries == AVCOL_PRI_UNSPECIFIED &&
+                           picture->color_primaries != AVCOL_PRI_UNSPECIFIED;
     now.matrix = MatrixText(static_cast<int>(picture->color_space));
     now.transfer = static_cast<int>(picture->color_transfer);
     if (const AVMasteringDisplayMetadata* mastering = KODI::UTILS::GetMasteringDisplayMetadata(*picture);
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
