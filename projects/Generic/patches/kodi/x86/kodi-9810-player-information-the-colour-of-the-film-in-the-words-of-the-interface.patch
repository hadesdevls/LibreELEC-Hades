@@ -9677,6 +9679,27 @@ std::string MasteringPrimaries(const hdr_metadata_infoframe& m)
   return "other";
 }
 
+// The words in which the player information says the colour of the film (PLAYERINFO::ColourText()):
+// Estuary's strings, as $ADDON[skin.estuary n] takes them for its rows in every skin; English
+// where there are none
+KODI::UTILS::PLAYERINFO::ColourWords ColourWordsOf()
+{
+  const auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  const auto take = [&strings](uint32_t id, std::string& word)
+  {
+    const std::string& text = strings.GetAddonString("skin.estuary", id);
+    if (!text.empty())
+      word = text;
+  };
+  KODI::UTILS::PLAYERINFO::ColourWords words;
+  take(31834, words.notGiven);
+  take(32007, words.assumed);
+  take(32008, words.fullRange);
+  take(32009, words.limitedRange);
+  take(32010, words.linear);
+  return words;
+}
+
 // The most bits per colour at which NVKMS drives an output, by nvidia-modeset's parameters as
 // nvkms_max_output_color_bpc() takes max_output_color_depth (6, 8 or 12; anything else is 10)
 // and nvkms-hdmi.c takes hdmi_deepcolor (without it, HDMI stays at 8); 0 when they cannot be
@@ -10159,10 +10182,15 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     info["hades.play.dropped"] = std::to_string(cache.GetVideoDropped());
     info["hades.play.skipped"] = std::to_string(cache.GetVideoSkipped());
     const SourceColour source = GetSourceColour();
-    // (Hades: of a Dolby Vision stream whose base layer is no picture by itself, the IPT-PQ-c2 its
-    // pictures are coded in: FilmColourOf(), from its configuration record)
+    // (Hades: its colour in the words of the page, ColourWordsOf(); of a Dolby Vision stream whose
+    // base layer is no picture by itself, the IPT-PQ-c2 its pictures are coded in: FilmColourOf(),
+    // from its configuration record)
+    const std::string colour = source.known
+                                   ? ColourText(source.primaries, source.transfer, source.fullRange,
+                                                source.primariesAssumed, ColourWordsOf())
+                                   : std::string();
     const FilmColour film =
-        FilmColourOf(source.colour, source.matrix,
+        FilmColourOf(colour, source.matrix,
                      DVBRIDGE::BaseLayerIsNoPicture(g_dvStreamProfile, g_dvStreamCompatibility));
     info["hades.video.color"] = film.colour;
     info["hades.video.colorkind"] = film.kind;
