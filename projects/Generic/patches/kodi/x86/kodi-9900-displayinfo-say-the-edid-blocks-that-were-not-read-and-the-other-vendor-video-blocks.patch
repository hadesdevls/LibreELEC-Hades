From 568de7cb46bb7e67d76b3922daed3cb5353d83b1 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:20:05 +0000
Subject: [PATCH] DisplayInfo: say the EDID blocks that were not read and the
 other vendor video blocks

Hades: the shape of the EDID that the log gives where Dolby Vision is not taken
from it (EdidShapeOf()) now says what tells the reasons of a TV input without
Dolby Vision apart, so that the first ordinary report settles which one it is:

- the blocks that the EDID counts and that are not in it (EdidMissingBlocks():
  its HDMI Forum EEODB where it has one, else the extension count of its base
  block): a driver that cut the EDID where it read it leaves a Dolby Vision
  block out without a trace in what Kodi gets. A warning line of the display
  information says it too;
- what the version and the interface of each Dolby VSVDB say (Standard and
  Low-Latency, Low-Latency only, the older signalling of HDMI 1.4b), by the
  rule of ScanDolbyVideo();
- the OUI and the size of each other vendor-specific video data block: HDR10+
  (90-84-8B), or a block of the Dolby shape whose OUI the TV left at 00-00-00,
  which a Sony Bravia of 2021 has on an input without Dolby Vision (linuxhw/EDID,
  SNYF205) and which is not Dolby Vision.

The EEODB is read where DRM reads it (drm_edid.c: the first data block of block
1, a CTA block of revision 3 or later with 3 bytes of data blocks or more, the
extended tag 0x78 with a payload of 2 bytes or more, a base block that counts an
extension); the shape used to ask for a payload of exactly 2 bytes.

Nothing that the display information decides changes: ScanDolbyVideo() is the
same, and 1174 EDIDs (the corpus of the battery, the EDIDs of reports, 525 of
linuxhw/EDID and a matrix of 16 with an EEODB) give the same Dolby Vision block,
QS and verdict as before.
---
 xbmc/utils/DisplayInfo.cpp | 104 +++++++++++++++++++++++++++++++++----
 xbmc/utils/DisplayInfo.h   |  18 +++++--
 2 files changed, 109 insertions(+), 13 deletions(-)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 17d4eec..ff091d4 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -259,6 +259,48 @@ bool ScanUhd420Only(const std::vector<uint8_t>& edid)
   return uhd420 && !hdmiForum;
 }
 
+// Hades: the count of the HDMI Forum EEODB of an EDID (HDMI 2.1, 10.3.6), -1 without one: where
+// DRM reads it (drm_edid.c, edid_hfeeodb_extension_block_count()), the first data block of block 1,
+// a CTA-861 block of revision 3 or later whose data blocks take 3 bytes or more, of the extended tag
+// 0x78 with a payload of 2 bytes or more, with a base block that counts an extension
+int HfEeodbCount(const std::vector<uint8_t>& edid)
+{
+  if (edid.size() < 256 || edid[126] == 0 || edid[128] != 0x02 || edid[129] < 3 ||
+      edid[130] < 4 + 3 || edid[130] > 127 || (edid[132] >> 5) != 7 || (edid[132] & 31) < 2 ||
+      edid[133] != 0x78)
+    return -1;
+  return edid[134];
+}
+
+// Hades: what the version and the interface of a Dolby VSVDB say (b: its header byte), for the
+// shape of the EDID, by the rule of ScanDolbyVideo()
+std::string DolbyBlockKind(const uint8_t* b)
+{
+  const unsigned int len = b[0] & 31;
+  const uint8_t* data = b + 1;
+  if (len < 5)
+    return "too short";
+  const unsigned int version = data[4] >> 5;
+  if (version == 2)
+  {
+    if (len < 11)
+      return "version 2, too short";
+    static constexpr const char* interfaces[4] = {
+        "Low-Latency only", "Low-Latency and LL-HDMI only", "Standard and Low-Latency",
+        "Standard, Low-Latency and LL-HDMI"};
+    return StringUtils::Format("version 2, {}", interfaces[data[6] & 3]);
+  }
+  if (version == 1 && len == 11)
+    return (data[7] & 3) == 1   ? "version 1 of 12 bytes, Standard"
+           : (data[7] & 3) == 0 ? "version 1 of 12 bytes, the older signalling (HDMI 1.4b)"
+                                : "version 1 of 12 bytes, a low-latency field not known";
+  if (version == 1 && len == 14)
+    return "version 1 of 15 bytes, the older signalling (HDMI 1.4b)";
+  if (version == 0 && len == 25)
+    return "version 0, the older signalling (HDMI 1.4b)";
+  return StringUtils::Format("version {} of {} bytes, not known", version, len + 1);
+}
+
 // Hades: "aa bb cc" of n bytes
 std::string Hex(const uint8_t* bytes, size_t n)
 {
@@ -277,6 +319,18 @@ unsigned int KODI::UTILS::EdidBaseBlockCopy(const std::vector<uint8_t>& edid)
   return 0;
 }
 
+unsigned int KODI::UTILS::EdidMissingBlocks(const std::vector<uint8_t>& edid)
+{
+  static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+  const size_t size = edid.size();
+  if (size < 128 || !std::equal(std::begin(magic), std::end(magic), edid.begin()))
+    return 0;
+  const int eeodb = HfEeodbCount(edid);
+  const size_t counted = (eeodb >= 0 ? static_cast<size_t>(eeodb) : edid[126]) + 1;
+  const size_t present = size / 128;
+  return counted > present ? static_cast<unsigned int>(counted - present) : 0;
+}
+
 std::string KODI::UTILS::EdidShapeOf(const std::vector<uint8_t>& edid)
 {
   static constexpr uint8_t magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
@@ -288,12 +342,19 @@ std::string KODI::UTILS::EdidShapeOf(const std::vector<uint8_t>& edid)
   out += StringUtils::Format(", {} block{}{}; the base block counts {} extension{}", blocks,
                              blocks == 1 ? "" : "s", size % 128 ? " and a part of one" : "",
                              edid[126], edid[126] == 1 ? "" : "s");
-  // The HDMI Forum EEODB: the first data block of block 1, extended tag 0x78
-  if (blocks > 1 && edid[128] == 0x02 && edid[129] >= 3 && edid[130] >= 7 && edid[132] == 0xe2 &&
-      edid[133] == 0x78)
-    out += StringUtils::Format(", an HDMI Forum EEODB of {} extension{}", edid[134],
-                               edid[134] == 1 ? "" : "s");
+  // The HDMI Forum EEODB: the first data block of block 1, extended tag 0x78 (as DRM reads it)
+  if (const int eeodb = HfEeodbCount(edid); eeodb >= 0)
+    out += StringUtils::Format(", an HDMI Forum EEODB of {} extension{}", eeodb,
+                               eeodb == 1 ? "" : "s");
+  // Hades: the blocks that it counts and that were not read (EdidMissingBlocks())
+  if (const unsigned int missing = EdidMissingBlocks(edid); missing)
+    out += StringUtils::Format(
+        ", {} block{} that it counts {} not there (the EDID was cut where it was read)", missing,
+        missing == 1 ? "" : "s", missing == 1 ? "is" : "are");
   std::vector<std::string> dolbyBlocks;
+  // Hades: the vendor-specific video data blocks of another OUI (HDR10+ is 90-84-8B; a Dolby block
+  // whose OUI the display left at 00-00-00 is not one)
+  std::vector<std::string> otherBlocks;
   out += "; blocks:";
   for (size_t block = 0; block < blocks; ++block)
   {
@@ -327,10 +388,21 @@ std::string KODI::UTILS::EdidShapeOf(const std::vector<uint8_t>& edid)
       {
         unsigned int pos = 4;
         for (; pos < end && pos + (b[pos] & 31u) + 1 <= end; pos += (b[pos] & 31u) + 1)
-          if ((b[pos] >> 5) == 7 && (b[pos] & 31u) >= 4 && b[pos + 1] == 1 && b[pos + 2] == 0x46 &&
-              b[pos + 3] == 0xd0 && b[pos + 4] == 0 && dolbyBlocks.size() < 4)
-            dolbyBlocks.emplace_back(StringUtils::Format(
-                "block {} at {}: {}", block, pos, Hex(b + pos, (b[pos] & 31u) + 1)));
+        {
+          if ((b[pos] >> 5) != 7 || (b[pos] & 31u) < 4 || b[pos + 1] != 1)
+            continue;
+          if (b[pos + 2] == 0x46 && b[pos + 3] == 0xd0 && b[pos + 4] == 0)
+          {
+            if (dolbyBlocks.size() < 4)
+              dolbyBlocks.emplace_back(StringUtils::Format("block {} at {}: {} ({})", block, pos,
+                                                           Hex(b + pos, (b[pos] & 31u) + 1),
+                                                           DolbyBlockKind(b + pos)));
+          }
+          else if (otherBlocks.size() < 4)
+            otherBlocks.emplace_back(
+                StringUtils::Format("block {} at {}: OUI {:02X}-{:02X}-{:02X}, {} bytes", block,
+                                    pos, b[pos + 4], b[pos + 3], b[pos + 2], (b[pos] & 31u) + 1));
+        }
         if (pos < end)
           what += StringUtils::Format(", a data block at {} runs past {}", pos, end);
       }
@@ -353,6 +425,8 @@ std::string KODI::UTILS::EdidShapeOf(const std::vector<uint8_t>& edid)
                : std::string("; the Dolby OUI 46 d0 00 nowhere");
   for (const auto& block : dolbyBlocks)
     out += "; Dolby VSVDB in " + block;
+  for (const auto& block : otherBlocks)
+    out += "; another vendor video block in " + block;
   return out;
 }
 
@@ -397,6 +471,7 @@ CDisplayInfo::CDisplayInfo(const std::vector<uint8_t>& edid)
   // Hades: QS where libdisplay-info does not read (Parse()): past the extension count too
   m_rgbQuantizationSelectable = m_dolbyVideo.qs;
   m_baseBlockCopy = EdidBaseBlockCopy(edid);
+  m_edidMissingBlocks = KODI::UTILS::EdidMissingBlocks(edid);
   m_edidShape = EdidShapeOf(edid);
   m_uhd420Only = ScanUhd420Only(edid);
   // Hades: YCbCr 4:2:2 as the kernel reads it, for HDR over the tunnel (EdidYcbcr422.h)
@@ -557,7 +632,16 @@ void CDisplayInfo::LogInfo() const
               "whole (a read of its segments that gave the first blocks again), and blocks of the "
               "display may be missing; the output is probed again when a video starts",
               m_baseBlockCopy);
-  if (m_dolbyVideo.skippedBlocks || m_dolbyVideo.dolbyCopies || m_baseBlockCopy)
+  // Hades: an EDID cut where it was read (EdidMissingBlocks())
+  if (m_edidMissingBlocks)
+    CLog::Log(LOGWARNING,
+              "[display-info] the EDID counts {} block{} more than were read: it was cut where it "
+              "was read (by the driver), and what {} hold{} is not known",
+              m_edidMissingBlocks, m_edidMissingBlocks == 1 ? "" : "s",
+              m_edidMissingBlocks == 1 ? "that block" : "those blocks",
+              m_edidMissingBlocks == 1 ? "s" : "");
+  if (m_dolbyVideo.skippedBlocks || m_dolbyVideo.dolbyCopies || m_baseBlockCopy ||
+      m_edidMissingBlocks)
     CLog::Log(LOGINFO, "[display-info] EDID: {}", m_edidShape);
 
   if (m_dolbyVideo.valid && m_dolbyVideo.lowLatency)
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index aadaccf..98f3c98 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -187,6 +187,10 @@ public:
   //! again for 2 and 3, and the blocks of the display that are there are not read. Kodi probes the
   //! output once more when a video starts (CWinSystemGbm::CheckDisplayChange()).
   unsigned int BaseBlockCopy() const { return m_baseBlockCopy; }
+  //! Hades: the blocks that the EDID counts and that are not in it (EdidMissingBlocks()): it was
+  //! cut where it was read, and what a block that is missing holds (a Dolby Vision block among
+  //! them) is not known; 0 for an EDID that is whole
+  unsigned int EdidMissingBlocks() const { return m_edidMissingBlocks; }
   //! Hades: the shape of the EDID, for the log where Dolby Vision is not taken from it: its size,
   //! its blocks and how each was read, the HDMI Forum EEODB, where the Dolby OUI is in its bytes
   //! and the Dolby VSVDBs (EdidShapeOf())
@@ -291,14 +295,22 @@ private:
   bool m_uhd420Only = false; //!< read from the raw EDID, see UhdLimitedToHdmi14()
   bool m_rgbQuantizationSelectable = false;
   unsigned int m_baseBlockCopy = 0; //!< Hades: see BaseBlockCopy()
+  unsigned int m_edidMissingBlocks = 0; //!< Hades: see EdidMissingBlocks()
   std::string m_edidShape; //!< Hades: see EdidShape()
 };
 
 //! Hades: the shape of an EDID (CDisplayInfo::EdidShape()), one line: its bytes and blocks, the
-//! extension count of the base block, the HDMI Forum EEODB, the tag and the validity of each block
-//! (up to 16 of them), every place of the Dolby OUI (46 d0 00) in its bytes (up to 8) and the bytes
-//! of each Dolby VSVDB (up to 4)
+//! extension count of the base block, the HDMI Forum EEODB, the blocks that it counts and that are
+//! not there, the tag and the validity of each block (up to 16 of them), every place of the Dolby
+//! OUI (46 d0 00) in its bytes (up to 8), the bytes of each Dolby VSVDB (up to 4) with what its
+//! version and interface say, and the OUI of each other vendor-specific video data block (up to 4)
 std::string EdidShapeOf(const std::vector<uint8_t>& edid);
+//! Hades: the blocks that an EDID counts and that are not in it: its HDMI Forum EEODB where it has
+//! one, as DRM reads it (drm_edid.c: the first data block of block 1, a CTA block of revision 3 or
+//! later), else the extension count of its base block, against the whole blocks that were read. A
+//! driver that cuts the EDID at the extension count of the base block leaves out the blocks that
+//! only the EEODB counts. 0 for an EDID that is whole, or that is not one.
+unsigned int EdidMissingBlocks(const std::vector<uint8_t>& edid);
 //! Hades: the first extension block of the EDID that is byte for byte its block 0; 0 for none
 unsigned int EdidBaseBlockCopy(const std::vector<uint8_t>& edid);
 
-- 
2.53.0

