diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 9521a84..a50408f 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -92,7 +92,9 @@ struct Note
   std::string code; //!< dv_not_native, hdr_to_sdr, hdr_not_sent, frames_failed, step_down,
                     //!< fel_resync, rate_mismatch, audio_decoded, unknown_output
   std::string arg; //!< the reason, or the number, that the sentence has in it
-  std::string todo; //!< what to do about it: tv, mode, choice, rate, hdr, sync, system; or empty
+  //! what to do about it: tv, mode, choice, rate, hdr, sync, system, converteron, convertertry;
+  //! or empty
+  std::string todo;
 };
 
 //! The sentence of the overview page
@@ -110,9 +112,19 @@ struct Summary
  * \brief What to do about a reason that a Dolby Vision video is not sent as Dolby Vision, in one
  *        of a few kinds: the TV input (tv), the output mode (mode), a choice that was made (choice)
  *        or nothing that a person does here (empty)
+ *
+ * (Hades: and the setting of the DisplayPort to HDMI converter of the board,
+ * videoscreen.hadesdvconverter (DV_CONVERTER::Decide()): turned off (converteroff), it goes back
+ * to Automatic (converteron); a board that is not on the list of those where Dolby Vision was seen
+ * working through it (converterunlisted) can try it with On, and go back to Automatic if the
+ * picture goes (convertertry).)
  */
 inline std::string TodoForReason(const std::string& reason)
 {
+  if (reason == "converteroff")
+    return "converteron";
+  if (reason == "converterunlisted")
+    return "convertertry";
   static const std::set<std::string> tv{"display", "lloff", "legacy", "invalid", "edid",
                                         "driveredid", "sink", "converter", "frl"};
   static const std::set<std::string> mode{"mode", "refresh", "rate", "nomode", "noratemode", "link"};
