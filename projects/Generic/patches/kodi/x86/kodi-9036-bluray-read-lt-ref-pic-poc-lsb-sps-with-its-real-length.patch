From fce2da10185e666be36db2b1508ac7424db678ce Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 29 Sep 2026 02:42:30 +0000
Subject: [PATCH] bluray: read lt_ref_pic_poc_lsb_sps with its real length

lt_ref_pic_poc_lsb_sps is u(v), log2_max_pic_order_cnt_lsb_minus4 + 4 bits long
(H.265 7.3.2.2.1), not an Exp-Golomb code. Read as ue(v), every bit after it was
misaligned for an SPS with long-term reference pictures, and the sample aspect
ratio then taken from the VUI could override the .clpi's with a wrong value.

Values out of the SPS's limits (log2_max_pic_order_cnt_lsb above 16, more than
32 long-term reference pictures) now end the parse as an unreadable short-term
set already does: the frame size and bit depth read before stand.
---
 xbmc/filesystem/bluray/M2TSParser.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/xbmc/filesystem/bluray/M2TSParser.cpp b/xbmc/filesystem/bluray/M2TSParser.cpp
index 2a9457f..b638e5f 100644
--- a/xbmc/filesystem/bluray/M2TSParser.cpp
+++ b/xbmc/filesystem/bluray/M2TSParser.cpp
@@ -1401,7 +1401,13 @@ bool ParseH265SPS(const std::span<std::byte>& buffer, TSVideoStreamInfo* streamI
   streamInfo->bitDepth = br.ReadUE() + 8;
 
   br.SkipUE(); // bit_depth_chroma_minus8
-  br.SkipUE(); // log2_max_pic_order_cnt_lsb_minus4
+  const unsigned int log2_max_pic_order_cnt_lsb{br.ReadUE() + 4};
+  if (log2_max_pic_order_cnt_lsb > 16)
+  {
+    // Not a valid SPS (H.265 7.4.3.2.1): the frame size and bit depth read above still stand
+    streamInfo->completed = true;
+    return true;
+  }
 
   // sps_sub_layer_ordering_info_present_flag
   bool sps_sub_layer_ordering_info_present_flag{br.ReadBits(1) == 1};
@@ -1453,9 +1459,15 @@ bool ParseH265SPS(const std::span<std::byte>& buffer, TSVideoStreamInfo* streamI
   if (br.ReadBits(1) == 1) // long_term_ref_pics_present_flag
   {
     unsigned int num_long_term_ref_pics_sps{br.ReadUE()};
+    if (num_long_term_ref_pics_sps > 32)
+    {
+      // Not a valid SPS (H.265 7.4.3.2.1): the VUI can no longer be located
+      streamInfo->completed = true;
+      return true;
+    }
     for (unsigned int i = 0; i < num_long_term_ref_pics_sps; i++)
     {
-      br.SkipUE(); // lt_ref_pic_poc_lsb_sps
+      br.SkipBits(log2_max_pic_order_cnt_lsb); // lt_ref_pic_poc_lsb_sps, u(v)
       br.SkipBits(1); // used_by_curr_pic_lt_sps_flag
     }
   }
-- 
