From 59c4a37aa9377d27cf673f2404314acfdf31c58f Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:59:23 +0000
Subject: [PATCH] player information: the centre speaker of a bed is lit only
 where the bed has one

Speakers() lights the speakers of the bed of an object-based stream from its count of
channels around the listener (the "main" of "main.lfe.top"). Those come in pairs (L/R,
Ls/Rs, Lb/Rb, Lw/Rw) and one single channel, the centre (ETSI TS 103 420 table 12, as
AudioPresentation.h counts them), so an odd count has the centre and an even one has not.
The centre was lit for every count from 3 up: a bed of 4 showed five speakers, and a bed
of 6 (L, R, Ls, Rs, Lb, Rb) showed the centre and not the backs.

The centre is lit for an odd count, and the backs from 6 up (and for 4, as before).

Host test (outside the tree): the test of the header with beds of 1, 3, 4, 6, 7 and 9
channels around; against the header before, the beds of 4 and 6 fail.
---
 xbmc/utils/HadesPlayerInfo.h | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/xbmc/utils/HadesPlayerInfo.h b/xbmc/utils/HadesPlayerInfo.h
index 075b75d..ea87801 100644
--- a/xbmc/utils/HadesPlayerInfo.h
+++ b/xbmc/utils/HadesPlayerInfo.h
@@ -488,16 +488,16 @@ inline std::string Speakers(const std::string& channels, const std::string& bed)
   if (!bed.empty() && std::sscanf(bed.c_str(), "%d.%d.%d", &main, &lfe, &top) >= 2 && main > 0)
   {
     // the bed of Dolby Atmos: the front pair, the centre, the sides, the backs; the height
-    // speakers in pairs from the front
-    if (main == 1)
+    // speakers in pairs from the front. Around the listener a bed has pairs (L/R, Ls/Rs, Lb/Rb,
+    // Lw/Rw) and one single channel, the centre (ETSI TS 103 420 table 12): an odd number of
+    // them has the centre, an even one has not (6 is L, R, Ls, Rs, Lb, Rb)
+    if (main % 2 == 1)
       lit.insert("FC");
     if (main >= 2)
     {
       lit.insert("FL");
       lit.insert("FR");
     }
-    if (main >= 3)
-      lit.insert("FC");
     if (main == 4)
     {
       lit.insert("BL");
@@ -508,7 +508,7 @@ inline std::string Speakers(const std::string& channels, const std::string& bed)
       lit.insert("SL");
       lit.insert("SR");
     }
-    if (main >= 7)
+    if (main >= 6)
     {
       lit.insert("BL");
       lit.insert("BR");
