From 0bdf1ec702136d00e24b029fe17b776c2ee68133 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:34:14 +0000
Subject: [PATCH] windowing/gbm: wrap the lines of the scissor composite
 changes to 100 columns

---
 xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h | 8 ++++----
 xbmc/settings/AdvancedSettings.h                     | 8 ++++----
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp       | 8 +++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h         | 7 ++++---
 4 files changed, 17 insertions(+), 14 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 52b9eb5..8ec3aa6 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -309,10 +309,10 @@ public:
   //! to be drawn into the PQ picture for it. False once the picture is made whole (CompletePicture()).
   bool GuiInPlace() const;
   //! Hades: the tile mask of what is drawn over the prepared frame, to the CPU without waiting
-  //! (dvbridge_render_tiles_request(), _poll()): one byte a tile of 16 x 16 pixels, 240 x 135, row 0 the
-  //! top of the raster. Request only after PrepareHardware() of a frame composed in the source
-  //! transport with its GUI told (SetDrawnOver()); Poll: 1 where it is back (and serial that of its
-  //! request), 0 where not yet, -1 where nothing waits.
+  //! (dvbridge_render_tiles_request(), _poll()): one byte a tile of 16 x 16 pixels, 240 x 135, row
+  //! 0 the top of the raster. Request only after PrepareHardware() of a frame composed in the
+  //! source transport with its GUI told (SetDrawnOver()); Poll: 1 where it is back (and serial that
+  //! of its request), 0 where not yet, -1 where nothing waits.
   bool RequestDrawnTiles(unsigned int serial);
   int PollDrawnTiles(uint8_t* mask, unsigned int& serial);
   //! Hades: the picture of the prepared frame whole, for what else is drawn into it (PQ subtitles,
diff --git a/xbmc/settings/AdvancedSettings.h b/xbmc/settings/AdvancedSettings.h
index 0b7b881..d79e8b4 100644
--- a/xbmc/settings/AdvancedSettings.h
+++ b/xbmc/settings/AdvancedSettings.h
@@ -191,10 +191,10 @@ class CAdvancedSettings : public ISettingCallback, public ISettingsHandler
     //! dirty and puts the GUI of the frame before over the picture (video/dvguireuse; the same
     //! bytes). Off for a measurement of what that saves
     bool m_videoDVGuiReuse;
-    //! Hades: with the GUI pass left out (video/dvguireuse), the composite of the GUI over the picture draws
-    //! its quad under glScissor rectangles of the tile mask of what the GUI can reach, instead of over the
-    //! whole raster (video/dvguiscissor; the same bytes: dvbridge_tiles.h). Off for a measurement of what
-    //! that saves
+    //! Hades: with the GUI pass left out (video/dvguireuse), the composite of the GUI over the
+    //! picture draws its quad under glScissor rectangles of the tile mask of what the GUI can
+    //! reach, instead of over the whole raster (video/dvguiscissor; the same bytes:
+    //! dvbridge_tiles.h). Off for a measurement of what that saves
     bool m_videoDVGuiScissor;
     //! Hades: native Dolby Vision Low-Latency shows a test pattern in place of the picture
     //! (video/dvllpattern), for a first look at a display (dvbridge_render_set_ll_pattern())
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 8dd96d9..0c9069a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5651,8 +5651,9 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   }
   if (m_dvFrame && overlayFree)
     m_dvPlainDirect = m_dvBridge->Direct() ? 1 : 0;
-  // Hades: the tile mask of what the GUI can reach, for the composite of the frames whose GUI pass is
-  // left out: asked for where this frame has the GUI composited over it, in the source transport
+  // Hades: the tile mask of what the GUI can reach, for the composite of the frames whose GUI
+  // pass is left out: asked for where this frame has the GUI composited over it, in the source
+  // transport
   DVTilesUpdate(m_dvFrame && m_guiReusing && !overlayFree && !captured && drawnTiles &&
                 guiInPlace <= 0.0f && drawnSettings &&
                 drawnSettings->GetAdvancedSettings()->m_videoDVGuiScissor);
@@ -6224,7 +6225,8 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
       m_tilesGen = serial;
     }
   }
-  if (wanted && !m_tilesPending && m_tilesGen != m_guiGen && m_dvBridge->RequestDrawnTiles(m_guiGen))
+  if (wanted && !m_tilesPending && m_tilesGen != m_guiGen &&
+      m_dvBridge->RequestDrawnTiles(m_guiGen))
     m_tilesPending = true;
 }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 7123826..51ea69f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -461,9 +461,10 @@ private:
   //! Hades: RenderDVBridge() ran in this frame, and in the frame before it
   bool m_guiVideoNow{false};
   bool m_guiVideoLast{false};
-  //! Hades: the content of the GUI FBO changes with every frame whose GUI pass draws (it counts those),
-  //! and the tile mask of what the GUI can reach (the bridge's pass 7, read back without waiting)
-  //! belongs to one of them (DVTilesUpdate(); the composite under scissor rectangles, CompositeGui())
+  //! Hades: the content of the GUI FBO changes with every frame whose GUI pass draws (it counts
+  //! those), and the tile mask of what the GUI can reach (the bridge's pass 7, read back without
+  //! waiting) belongs to one of them (DVTilesUpdate(); the composite under scissor rectangles,
+  //! CompositeGui())
   unsigned m_guiGen{1};
   unsigned m_tilesGen{0};
   bool m_tilesPending{false};
-- 
2.53.0

