+void CDVBridgeGLES::LogRefusal(const char* why)
+{
+  // Hades: why the metadata of a frame cannot be sent natively, once for each reason in a stream
+  // (the serializer's fixed texts: the same reason is the same text), for the first few reasons
+  if (!why)
+    return;
+  const auto end = m_refusalsLogged.begin() + m_refusalsCount;
+  if (std::find(m_refusalsLogged.begin(), end, why) != end ||
+      m_refusalsCount >= m_refusalsLogged.size())
+    return;
+  m_refusalsLogged[m_refusalsCount++] = why;
+  CLog::Log(LOGWARNING,
+            "DVBridge: the Dolby Vision metadata of a frame cannot be sent natively: {}", why);
+}
