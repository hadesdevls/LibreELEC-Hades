+    const char *unused;
+    if (!why)
+        why = &unused;
+    *why = NULL;
+    if (!context || !metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata)) {
+        *why = "no metadata, or metadata out of their alignment";
+        return NULL;
+    }
     if (geometry.source_width <= 0 || geometry.source_width > 3840 ||
         geometry.source_height <= 0 || geometry.source_height > 2160 ||
         geometry.x < 0 || geometry.x > 3840 || geometry.y < 0 || geometry.y > 2160 ||
         geometry.width <= 0 || geometry.width > 3840 ||
-        geometry.height <= 0 || geometry.height > 2160) return NULL;
+        geometry.height <= 0 || geometry.height > 2160) {
+        *why = "the picture, or its place, is not on the 3840x2160 raster";
+        return NULL;
+    }
     const AVDOVIMetadata *m = metadata;
-    if (!dvbridge_dv_readable(m, bytes)) return NULL;
+    if (!dvbridge_dv_readable(m, bytes)) {
+        *why = "the metadata do not read as FFmpeg lays them out (their regions or blocks)";
+        return NULL;
+    }
     struct dvbridge_candidate *candidate = calloc(1, sizeof(*candidate));
-    if (!candidate) return NULL;
+    if (!candidate) {
+        *why = "no memory";
+        return NULL;
+    }
     candidate->state = context->state;
     candidate->owner = context;
     candidate->revision = context->revision;
@@ -90,6 +115,7 @@ struct dvbridge_candidate *dvbridge_prepare_transport(
      * there is, or from none: dvbridge_dv_margins()) */
     if (!dvbridge_dv_geometry(&candidate->state, geometry.source_width, geometry.source_height,
             geometry.x, geometry.y, geometry.width, geometry.height)) {
+        *why = candidate->state.refused;
         free(candidate);
         return NULL;
     }
@@ -98,6 +124,7 @@ struct dvbridge_candidate *dvbridge_prepare_transport(
     candidate->pts = pts;
     candidate->source = source;
     if (!candidate->metadata || !dvbridge_dv_metadata(&candidate->state, m, pts, source, 0)) {
+        *why = candidate->metadata ? candidate->state.refused : "no memory";
         dvbridge_candidate_destroy(candidate);
         return NULL;
     }
