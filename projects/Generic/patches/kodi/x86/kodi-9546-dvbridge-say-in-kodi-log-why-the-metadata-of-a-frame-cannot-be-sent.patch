+struct dvbridge_candidate *dvbridge_prepare_why(
+    const struct dvbridge_context *context, const void *metadata, size_t bytes,
+    double pts, struct dvbridge_geometry geometry, bool fel_reconstructed, bool source,
+    const char **why)
