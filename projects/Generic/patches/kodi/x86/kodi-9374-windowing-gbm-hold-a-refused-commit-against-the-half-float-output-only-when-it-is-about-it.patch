+
+#pragma once
+
+#include <optional>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+//! Hades: what a refused commit of the ordinary output with a half-float buffer was about
+enum class FloatRefusal
+{
+  BUFFER, //!< the same request is taken with an 8-bit buffer in place of the frame's
+  NOT_BUFFER, //!< it is refused with that one too, which the request before it takes
+  UNKNOWN, //!< not asked, or the 8-bit buffer is not taken even by the request before it
+};
+
+/*!
+ * \brief Hades: the answers of the driver to the refused request and to the request that it fell
+ *        back to, each asked again (TEST_ONLY) with an 8-bit buffer of the output in place of the
+ *        frame's (CDRMAtomic::RefusedForBuffer())
+ *
+ * Only a refusal that is not about the buffer is NOT_BUFFER: then the 8-bit buffer is one that the
+ * driver takes (the request before it takes it), and the refused request refuses it all the same.
+ * Anything else is held against the half-float buffer, as every refusal was before
+ * (CWinSystemGbmEGLContext::CheckFloatOutput(): the 8-bit output is put back).
+ *
+ * This function only decides.
+ */
+inline FloatRefusal JudgeFloatRefusal(std::optional<bool> beforeTakes8, std::optional<bool> refusedTakes8)
+{
+  if (beforeTakes8 != true || !refusedTakes8)
+    return FloatRefusal::UNKNOWN;
+  return *refusedTakes8 ? FloatRefusal::BUFFER : FloatRefusal::NOT_BUFFER;
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
