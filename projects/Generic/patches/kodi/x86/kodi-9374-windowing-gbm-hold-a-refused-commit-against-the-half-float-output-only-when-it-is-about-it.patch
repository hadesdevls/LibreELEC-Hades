From b3eeae94dc7e1ff9338a8ae4de8f8ad08d7e9ba3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:51:01 +0000
Subject: [PATCH] windowing/gbm: hold a refused commit against the half-float
 output only when it is about it

With a half-float output (nvidia-drm, video of more than 8 bits),
every commit of the ordinary output that the driver refused was taken to be
the buffer's fault: the 8-bit output was put back, HDR went out at 8 bits
for the rest of the video, and the failure counted for the three videos
after which the half-float output is not tried for a while. Also when the
driver refused the commit for something else: a mode that the link cannot
carry, or the commits with which FlipStalled() turns the output off and on
again while the display engine does not answer.

When the refusal was of a test, CDRMAtomic keeps a copy of the refused
request. CheckFloatOutput() makes an 8-bit buffer of the output, as the
8-bit output would be made, and the driver is asked again (TEST_ONLY): the
request that the refusal fell back to, and the refused one, each with that
buffer in place of the frame's, without the fences of that commit (its
in-fence is closed by then) and with a modeset allowed. Only when the first
takes it and the second refuses it all the same is the refusal not held
against the half-float output, and it is left as with an 8-bit output.
Anything else, also a commit refused after its test passed, or a buffer
that cannot be made, is held against it as before (JudgeFloatRefusal()).
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 47 ++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmEGLContext.h   |  3 ++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp          | 49 +++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.h            |  9 ++++
 xbmc/windowing/gbm/drm/DRMUtils.h             |  6 +++
 xbmc/windowing/gbm/drm/FloatRefusal.h         | 49 +++++++++++++++++++
 6 files changed, 163 insertions(+)
 create mode 100644 xbmc/windowing/gbm/drm/FloatRefusal.h

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index c0a64f7..5a3445a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -389,6 +389,17 @@ void CWinSystemGbmEGLContext::CheckFloatOutput(bool rendered)
   // modeset is allowed again, and what the refused commit carried is queued again. (With an
   // 8-bit output a refused commit is left as Kodi leaves it.) Whether the output is on is not
   // touched: SetActive(true) would turn on a display that is meant to be off.
+  // Hades: ... where the refusal was about the buffer, or that is not known. A request that the
+  // driver refuses also with an 8-bit buffer in place of the frame's (one that the request before
+  // it takes), such as a mode the link cannot carry or an output that the driver cannot turn on,
+  // is left as with an 8-bit output: the video goes on through the half-float one.
+  if (RefusalAboutBuffer() == FloatRefusal::NOT_BUFFER)
+  {
+    CLog::LogF(LOGINFO, "the driver refused a commit with the half-float output, and refuses it "
+                        "with an 8-bit buffer too: it is not held against the half-float output");
+    return;
+  }
+
   // Counted once: when the 8-bit output cannot be put back, this comes again with every refusal.
   const bool first = !m_floatOutputBlocked;
   if (first)
@@ -407,6 +418,42 @@ void CWinSystemGbmEGLContext::CheckFloatOutput(bool rendered)
   RequeueOutputProperties();
 }
 
+FloatRefusal CWinSystemGbmEGLContext::RefusalAboutBuffer()
+{
+  // Hades: an 8-bit buffer of the output, as the 8-bit output would be made (CreateOutputSurface():
+  // the first 8-bit format of the planes, with its modifiers, the size of the window), only to be
+  // named in a test, and gone after it
+  const outputformat* eight = nullptr;
+  for (const auto& format : m_DRM->GetOutputFormats())
+  {
+    if (format.active && format.bpp == 8)
+    {
+      eight = &format;
+      break;
+    }
+  }
+  if (!eight)
+    return FloatRefusal::UNKNOWN;
+  std::vector<uint64_t> modifiers = eight->modifiers;
+  int width = m_nWidth;
+  if (m_DRM->FramePackedBufferDemands(eight->drm, width))
+    modifiers = {DRM_FORMAT_MOD_LINEAR};
+  struct gbm_bo* bo = nullptr;
+#if defined(HAS_GBM_MODIFIERS)
+  if (!modifiers.empty())
+    bo = gbm_bo_create_with_modifiers(m_GBM->GetDevice().Get(), width, m_nHeight, eight->drm,
+                                      modifiers.data(), modifiers.size());
+#endif
+  if (!bo)
+    bo = gbm_bo_create(m_GBM->GetDevice().Get(), width, m_nHeight, eight->drm,
+                       GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+  if (!bo)
+    return FloatRefusal::UNKNOWN;
+  const FloatRefusal about = m_DRM->RefusedForBuffer(bo);
+  gbm_bo_destroy(bo);
+  return about;
+}
+
 bool CWinSystemGbmEGLContext::CreateOutputSurface(uint32_t format, struct gbm_bo*& bo)
 {
   bo = nullptr;
diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
index cbc62ab..e46c087 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.h
@@ -90,6 +90,9 @@ protected:
   //! a half-float one, the 8-bit output is put back
   //! \param rendered a buffer was flipped in this pass
   void CheckFloatOutput(bool rendered);
+  //! \brief Hades: what the refusal that CheckFloatOutput() was told of was about: asked of the
+  //! driver with an 8-bit buffer of the output in place of the frame's (RefusedForBuffer())
+  FloatRefusal RefusalAboutBuffer();
 
   EGLint m_renderableType{0};
   bool m_highBitDepthReported{false};
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 0a8ac0a..4bbce1f 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -252,6 +252,12 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     m_flipRefused = m_flipRefused || tells;
     m_flipDropped = m_flipDropped || m_active;
     m_lastCommitRefused = true; // (Hades: what this request carried does not go out)
+    // Hades: what the driver refused, to be asked again with another buffer (RefusedForBuffer())
+    if (tells)
+    {
+      m_refusedTest.reset(drmModeAtomicDuplicate(m_req->Get()));
+      m_refusedFlags = flags;
+    }
     auto oldRequest = m_atomicRequestQueue.front().get();
     CDRMAtomicRequest::LogAtomicDiff(m_req, oldRequest);
     m_req = oldRequest;
@@ -276,7 +282,10 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
       CLog::LogF(LOGERROR, "atomic commit failed: {}", strerror(error));
       // not when the driver was only busy with the commit before this one
       if (error != EBUSY && tells)
+      {
         m_flipRefused = true;
+        m_refusedTest.reset(); // (Hades: its test passed: nothing to ask again)
+      }
       m_flipDropped = m_flipDropped || m_active;
     }
     return reject();
@@ -355,6 +364,45 @@ void CDRMAtomic::FinishRequest(bool accepted)
   m_propertyFailure = false;
 }
 
+FloatRefusal CDRMAtomic::RefusedForBuffer(struct gbm_bo* bo)
+{
+  // Hades: the refused request, and the one it fell back to (the front of the queue, which the
+  // driver took), each asked again with bo in place of the buffer of the frame, a modeset allowed
+  // (as the commit that would follow with bo allows one), and none of the fences of that commit:
+  // its in-fence is closed by now. A property that a request names twice goes with the value it
+  // was added with last (drmModeAtomicCommit()).
+  auto refused = std::move(m_refusedTest);
+  CDRMPlane* plane = m_gui_plane ? m_gui_plane : m_video_plane;
+  struct drm_fb* fb = bo ? DrmFbGetFromBo(bo) : nullptr;
+  if (!refused || !plane || !fb || !m_crtc || m_atomicRequestQueue.empty())
+    return FloatRefusal::UNKNOWN;
+  const uint32_t fbProperty = plane->GetPropertyId("FB_ID");
+  const uint32_t inFence = plane->GetPropertyId("IN_FENCE_FD");
+  const uint32_t outFence = m_crtc->GetPropertyId("OUT_FENCE_PTR");
+  const auto ask = [&](drmModeAtomicReqPtr request) -> std::optional<bool>
+  {
+    std::unique_ptr<drmModeAtomicReq, AtomicReqFree> copy(drmModeAtomicDuplicate(request));
+    if (!copy || !fbProperty ||
+        drmModeAtomicAddProperty(copy.get(), plane->GetId(), fbProperty, fb->fb_id) < 0 ||
+        (inFence &&
+         drmModeAtomicAddProperty(copy.get(), plane->GetId(), inFence, static_cast<uint64_t>(-1)) <
+             0) ||
+        (outFence && drmModeAtomicAddProperty(copy.get(), m_crtc->GetId(), outFence, 0) < 0))
+      return std::nullopt;
+    const int flags = (m_refusedFlags & ~DRM_MODE_ATOMIC_NONBLOCK) | DRM_MODE_ATOMIC_TEST_ONLY |
+                      DRM_MODE_ATOMIC_ALLOW_MODESET;
+    return drmModeAtomicCommit(m_fd, copy.get(), flags, nullptr) == 0;
+  };
+  const auto before = ask(m_atomicRequestQueue.front()->Get());
+  const FloatRefusal about =
+      JudgeFloatRefusal(before, before == true ? ask(refused.get()) : std::nullopt);
+  CLog::LogF(LOGDEBUG, "the refused request with an 8-bit buffer in place of the frame's: {}",
+             about == FloatRefusal::BUFFER       ? "taken"
+             : about == FloatRefusal::NOT_BUFFER ? "refused too"
+                                                 : "not known");
+  return about;
+}
+
 bool CDRMAtomic::FlipPageTransactional(struct gbm_bo* bo, bool modeset, bool* ahead)
 {
   const bool wanted = ahead && *ahead;
@@ -438,6 +486,7 @@ void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, boo
       m_flipRefused = m_flipRefused || m_active;
       m_flipDropped = m_flipDropped || m_active;
       m_lastCommitRefused = true; // (Hades)
+      m_refusedTest.reset();
       return;
     }
 
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
index 12f3adb..d690814 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -55,6 +55,7 @@ public:
   bool TestFramebuffer(struct gbm_bo* bo) override;
   bool TakeFlipRefused() override { return std::exchange(m_flipRefused, false); }
   bool TakeFlipDropped() override { return std::exchange(m_flipDropped, false); }
+  FloatRefusal RefusedForBuffer(struct gbm_bo* bo) override;
   void AllowModeset() override { m_need_modeset = true; }
   //! Hades: the next commit would carry more than a framebuffer: properties added since the last
   //! one, or a modeset that is pending
@@ -122,6 +123,14 @@ private:
   bool m_flipRefused = false;
   bool m_flipDropped = false; //!< see TakeFlipDropped(); kept until it is asked
   bool m_lastCommitRefused = false; //!< Hades: see LastCommitRefused()
+  //! Hades: a copy of the last request whose test was refused and told (TakeFlipRefused()), and
+  //! the flags of its commit, for RefusedForBuffer()
+  struct AtomicReqFree
+  {
+    void operator()(drmModeAtomicReqPtr p) const { drmModeAtomicFree(p); }
+  };
+  std::unique_ptr<drmModeAtomicReq, AtomicReqFree> m_refusedTest;
+  int m_refusedFlags = 0;
   //! When to turn off the outputs Kodi does not use (a second monitor)
   std::optional<std::chrono::steady_clock::time_point> m_otherOutputsOff;
 
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index dc1f625..b36b7b1 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -14,6 +14,7 @@
 #include "DRMOutputChoice.h"
 #include "DRMPlane.h"
 #include "DRMStereo.h"
+#include "FloatRefusal.h"
 #include "windowing/Resolution.h"
 #include "windowing/gbm/GBMUtils.h"
 
@@ -77,6 +78,11 @@ public:
   //! asked, for whatever reason: also the ones that TakeFlipRefused() does not tell of, but for
   //! a commit made while the output is meant to be off. What such a commit carried is lost.
   virtual bool TakeFlipDropped() { return false; }
+  //! \brief Hades: what the last refusal that TakeFlipRefused() told of was about, as the driver
+  //! answers when it is asked again with bo, an 8-bit buffer of the output, in place of the
+  //! frame's (JudgeFloatRefusal()). Asked once for each refusal; UNKNOWN when it cannot be asked
+  //! (the refusal was not of a test, or this output cannot ask).
+  virtual FloatRefusal RefusedForBuffer(struct gbm_bo* bo) { return FloatRefusal::UNKNOWN; }
   //! \brief The next commit may be a modeset. Whether the output is on stays as it is:
   //! SetActive() allows a modeset too, and turns the output on or off.
   virtual void AllowModeset() {}
diff --git a/xbmc/windowing/gbm/drm/FloatRefusal.h b/xbmc/windowing/gbm/drm/FloatRefusal.h
new file mode 100644
index 0000000..698b3e3
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/FloatRefusal.h
@@ -0,0 +1,49 @@
