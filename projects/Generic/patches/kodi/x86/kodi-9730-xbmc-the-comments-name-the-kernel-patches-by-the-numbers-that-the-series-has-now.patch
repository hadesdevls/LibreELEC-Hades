From 8d0700efa8b0f3cf25fed475879d3da1f678e645 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:21:05 +0000
Subject: [PATCH] xbmc: the comments name the kernel patches by the numbers
 that the series has now

The kernel patches of Hades were numbered again in the order in which they apply: the
backports from linux-9800 and the others from linux-9900, every patch with a number of its own
and the names that only sorted after the series (linux-9999-x1-tunnel, x2-pcon) gone. The
comments of Kodi that name a kernel patch by its number (13 files) say the new one. Comments
only: no code changes.
---
 xbmc/utils/DisplayInfo.cpp                     | 2 +-
 xbmc/utils/DisplayInfo.h                       | 2 +-
 xbmc/utils/EdidHdr10Plus.h                     | 2 +-
 xbmc/windowing/gbm/DVPlusModeStart.h           | 4 ++--
 xbmc/windowing/gbm/HDR10PlusOutput.h           | 6 +++---
 xbmc/windowing/gbm/HDR10Tunnel.h               | 6 +++---
 xbmc/windowing/gbm/HotplugRelink.h             | 2 +-
 xbmc/windowing/gbm/RgbRange.h                  | 4 ++--
 xbmc/windowing/gbm/WinSystemGbm.cpp            | 2 +-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 2 +-
 xbmc/windowing/gbm/drm/DVBridgeState.cpp       | 2 +-
 xbmc/windowing/gbm/drm/DVBridgeState.h         | 4 ++--
 xbmc/windowing/gbm/drm/DVConverter.h           | 2 +-
 13 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/xbmc/utils/DisplayInfo.cpp b/xbmc/utils/DisplayInfo.cpp
index 8ddd94c..25bf54a 100644
--- a/xbmc/utils/DisplayInfo.cpp
+++ b/xbmc/utils/DisplayInfo.cpp
@@ -30,7 +30,7 @@ using namespace UTILS;
 namespace
 {
 // The Dolby VSVDB, read from the raw EDID with the rule of the kernel backends (amdgpu's
-// amdgpu_dm_dvbridge_edid_standard() and, since linux-9965, i915's intel_dv_lab_edid(), which a
+// amdgpu_dm_dvbridge_edid_standard() and, since linux-9938, i915's intel_dv_lab_edid(), which a
 // host test compares with this function) so that Kodi and the kernel take the same displays: every
 // block (an HDMI Forum EEODB may make the EDID longer than its extension count) and exactly one
 // Dolby VSVDB. libdisplay-info gives neither the length of a version 1 block nor its whole
diff --git a/xbmc/utils/DisplayInfo.h b/xbmc/utils/DisplayInfo.h
index 97636de..50a2e26 100644
--- a/xbmc/utils/DisplayInfo.h
+++ b/xbmc/utils/DisplayInfo.h
@@ -165,7 +165,7 @@ public:
   //! AVI InfoFrame with HDR10+ (KODI::UTILS::NvkmsAviCtaVicWithHdr10Plus()), read from the raw EDID
   const HdmiVicSink& GetHdmiVicSink() const { return m_hdmiVicSink; }
   //! Dolby Vision Standard (TV-led) with the Dolby vendor InfoFrame, by the rule of the kernel
-  //! backends (amdgpu, and i915/xe since linux-9965: the same one): exactly one Dolby VSVDB in
+  //! backends (amdgpu, and i915/xe since linux-9938: the same one): exactly one Dolby VSVDB in
   //! valid EDID blocks, of version 2 with the Standard interface, or of version 1 in its 12-byte
   //! form with the low-latency field 1, of any display management version (Hades: what a display of
   //! 2 or 3 is sent, see StandardDolbyVisionDmVersion()).
diff --git a/xbmc/utils/EdidHdr10Plus.h b/xbmc/utils/EdidHdr10Plus.h
index 794f51a..48e8d10 100644
--- a/xbmc/utils/EdidHdr10Plus.h
+++ b/xbmc/utils/EdidHdr10Plus.h
@@ -26,7 +26,7 @@ namespace UTILS
  * The block: a CTA-861 data block of extended tag 1 (vendor-specific video), IEEE OUI 90-84-8B
  * (least significant byte first), then a byte whose bits 1 and 0 are the application version.
  * Read from the raw EDID with the walk of i915 (intel_hdr10plus_edid_version() of the Hades kernel,
- * linux-9999, which a host test runs on the same EDIDs), because libdisplay-info 0.4.0 keeps a block
+ * linux-9972, which a host test runs on the same EDIDs), because libdisplay-info 0.4.0 keeps a block
  * of version 1 only ("We were expecting application version 1", cta.c): a display of version 0
  * would not be seen as one at all. Amlogic reads the same bits (hdmi_tx_edid.c,
  * application_version = dat[pos] & 0x3). A CTA extension whose data block collection does not
diff --git a/xbmc/windowing/gbm/DVPlusModeStart.h b/xbmc/windowing/gbm/DVPlusModeStart.h
index d68a985..e94506e 100644
--- a/xbmc/windowing/gbm/DVPlusModeStart.h
+++ b/xbmc/windowing/gbm/DVPlusModeStart.h
@@ -27,7 +27,7 @@ namespace GBM
  *
  * i915 and xe signal 2160p24, 25 and 30 (and 4096x2160p24, and their 1000/1001 rates) with the HDMI
  * VIC in the HDMI vendor InfoFrame and VIC 0 in the AVI InfoFrame; HDR10+ takes that vendor DIP, so
- * with HDR10+ the mode goes out with its CTA VIC in the AVI InfoFrame instead (linux-9982). Only a
+ * with HDR10+ the mode goes out with its CTA VIC in the AVI InfoFrame instead (linux-9954). Only a
  * commit that may change the mode can change the AVI InfoFrame there, so HDR10+ has to be in the
  * commit of the mode of the video (CHDR10PlusOutput::WithMode()); after it, every commit with HDR10+
  * is refused, and after CHDR10PlusOutput::REFUSED_AFTER of them the video goes on as HDR10. A film's
@@ -170,7 +170,7 @@ public:
  * last
  *        mode set, because HDR10+ went out at it (CDVPlusModeStart::MidVideo::CTA_VIC_KEPT)
  *
- * i915 and xe (linux-9982) and NVKMS (nvidia-open-kernel-modules-9050) put the CTA VIC of a mode
+ * i915 and xe (linux-9954) and NVKMS (nvidia-open-kernel-modules-9050) put the CTA VIC of a mode
  * that DRM or NVKMS name by an HDMI VIC in the AVI InfoFrame where HDR10+ goes out, and keep it in
  * every commit of the same mode after it, with HDR10+ or without, until the next change of mode.
  * Taken as kept only after a commit that the kernel took with HDR10+ of Kodi's on the connector,
diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index 2d1063e..9f5b88b 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -29,8 +29,8 @@ namespace GBM
  * the HDR one, and change it with a flip and never with a change of mode, gives its connectors
  * HDR10PLUS_VSIF: a blob of the 27 bytes of its payload (KODI::UTILS::HDR10PLUS), 0 for none.
  * The Hades patches give it: nvidia-open-kernel-modules-9020 (Turing, Ampere and Ada over HDMI,
- * Ada over DisplayPort, T239 and Blackwell over both), and linux-9980 (the property, in DRM) with
- * linux-9981 (amdgpu, DCN: HDMI and DisplayPort) and linux-9982 (i915 and xe: HDMI, where no HDMI
+ * Ada over DisplayPort, T239 and Blackwell over both), and linux-9952 (the property, in DRM) with
+ * linux-9953 (amdgpu, DCN: HDMI and DisplayPort) and linux-9954 (i915 and xe: HDMI, where no HDMI
  * VIC or 3D is signalled, so not at 2160p24, 25 or 30). A driver refuses, in the commit, what it
  * cannot send.
  *
@@ -55,7 +55,7 @@ namespace GBM
  * but in the one that sets the mode and the HDR signalling of the video together, with its first
  * frame (Output::withMode: the commit that ends the hold of the change of mode, CModeChangeHold).
  * i915 sends HDR10+ at 2160p24, 25 and 30 only where the commit of the mode carries it: it signals
- * the mode with its CTA VIC then (linux-9982). A test that fails with a payload is made again
+ * the mode with its CTA VIC then (linux-9954). A test that fails with a payload is made again
  * without it (Without()), so that a refusal takes nothing else of the request with it.
  *
  * Only what is decided is here, with nothing of DRM in it, so that a test can run it.
diff --git a/xbmc/windowing/gbm/HDR10Tunnel.h b/xbmc/windowing/gbm/HDR10Tunnel.h
index d554753..c5eeac9 100644
--- a/xbmc/windowing/gbm/HDR10Tunnel.h
+++ b/xbmc/windowing/gbm/HDR10Tunnel.h
@@ -17,14 +17,14 @@ namespace KODI::WINDOWING::GBM
 /*!
  * \brief Hades: when HDR is sent over the tunnel as YCbCr 4:2:2 at 12 bits
  * (DVBRIDGE_HDR10_TUNNEL_LAB,
- *        linux-9932 to 9934), and why not
+ *        linux-9973 to 9975), and why not
  *
  * The tunnel carries the picture packed as YCbCr 4:2:2 at 12 bits in RGB 8 bpc pixels, which the
  * display reads as HDR in 4:2:2 (the AVI InfoFrame says so, and the HDR static metadata goes with
  * it). It is for what the ordinary output cannot carry as well: HDR over HDMI 2.0 at 3840x2160 50
  * and 60 Hz, where the link does not fit RGB at 10 bits and the driver sends RGB at 8 bits or YCbCr
- * 4:2:0 at 10 (linux-9966, 9968, 9969). Where the driver itself sends 4:2:2 at 10 bits or more
- * (amdgpu on DCN that can, linux-9972), or RGB at 10 or 12 (any other mode), the ordinary output is
+ * 4:2:0 at 10 (linux-9939, 9941, 9942). Where the driver itself sends 4:2:2 at 10 bits or more
+ * (amdgpu on DCN that can, linux-9945), or RGB at 10 or 12 (any other mode), the ordinary output is
  * as good or better and the tunnel is not used.
  *
  * Fail closed: the format of the ordinary output must be known (DVBRIDGE_LINK_FORMAT, asked with a
diff --git a/xbmc/windowing/gbm/HotplugRelink.h b/xbmc/windowing/gbm/HotplugRelink.h
