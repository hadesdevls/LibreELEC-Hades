From 9c41d7020322c486e6de5ebaab67c36898923b37 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 13 Oct 2026 03:43:09 +0000
Subject: [PATCH] DVDFactoryDemuxer: a base view that does not open is not
 logged as an error

While a disc is navigated an open that fails is routine, and the demuxer of the base view
says itself why it failed. The line is at LOGINFO.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
index d98f559..f37e458 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDFactoryDemuxer.cpp
@@ -108,7 +108,9 @@ CDVDDemux* CDVDFactoryDemuxer::CreateDemuxer(const std::shared_ptr<CDVDInputStre
       // disc then, and it goes to the demuxer below as every disc does.
       if (demuxer->HasReadInput())
       {
-        CLog::Log(LOGERROR, "DVDFactoryDemuxer: the base view of the disc could not be opened");
+        // (not an error by itself: while a disc is navigated an open that fails is routine,
+        // and the demuxer of the base view says why it failed)
+        CLog::Log(LOGINFO, "DVDFactoryDemuxer: the base view of the disc could not be opened");
         return nullptr;
       }
       CLog::Log(LOGWARNING, "DVDFactoryDemuxer: no decoder of both views; the disc is read as "
-- 
