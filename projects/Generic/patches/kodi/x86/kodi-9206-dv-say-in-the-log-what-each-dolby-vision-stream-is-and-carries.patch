From 4ca005d2a2fae27974a79f3d913875bbce34c010 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 14 Oct 2026 08:14:02 +0000
Subject: [PATCH] DV: say in the log what each Dolby Vision stream is and
 carries

A Dolby Vision stream whose picture came out wrong on the TV (wrong
colours, stripes) could not be told by the log from the streams that played
right: what a stream says it is, and what its metadata carries, were in the
debug log or nowhere.

Now, without debugging:
- when its decoder is opened, the configuration record of the stream
  (profile, level, compatibility of the base layer, which layers it has) and
  the output it is set up for;
- with its first picture, for native output and for output as HDR10, the
  header of its RPU (profile, bit depths, range of the base layer, residual),
  its signal (EOTF, bit depth, colour space, chroma, range, the range of the
  source) and the levels of its extension blocks.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 16 +++++
 .../VideoRenderers/DVBridgeGLES.cpp           | 63 ++++++++++++++++---
 2 files changed, 70 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 4b6754c..2b2a306 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -387,6 +387,22 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
   m_dvConvert = DVBRIDGE::ConversionEligible(hints);
   m_dvDisplayMetadata.reset();
   m_dvLightMetadata.reset();
+  // Hades: what the stream says it is, in the log without debugging, with the metadata of its
+  // first picture (DVBridge) what tells a stream whose picture comes out wrong from one that
+  // plays right
+  if (hints.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+    CLog::Log(LOGINFO,
+              "DV: the stream says that it is Dolby Vision profile {} level {}, base layer "
+              "compatibility {} (RPU: {}, enhancement layer: {}, base layer: {}); {}",
+              static_cast<unsigned int>(hints.dovi.dv_profile),
+              static_cast<unsigned int>(hints.dovi.dv_level),
+              static_cast<unsigned int>(hints.dovi.dv_bl_signal_compatibility_id),
+              hints.dovi.rpu_present_flag ? "yes" : "no",
+              hints.dovi.el_present_flag ? "yes" : "no",
+              hints.dovi.bl_present_flag ? "yes" : "no",
+              m_dvNativeOutput ? "decoded for native output, where an output mode can carry it"
+              : m_dvConvert    ? "decoded for output as HDR10"
+                               : "decoded for the ordinary output");
 #endif
 
   const AVCodec* pCodec = nullptr;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index ce8c141..7d35cd5 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -11,6 +11,7 @@
 #include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h"
 #include "settings/AdvancedSettings.h"
 #include "settings/SettingsComponent.h"
+#include "utils/StringUtils.h"
 #include "utils/log.h"
 #include <chrono>
 #include <string>
@@ -87,6 +88,43 @@ bool SameView(const dvbridge_view& a, const dvbridge_view& b)
          a.src_y1 == b.src_y1 && a.dst_x == b.dst_x && a.dst_y == b.dst_y &&
          a.dst_width == b.dst_width && a.dst_height == b.dst_height;
 }
+
+// Hades: what the Dolby Vision metadata of a picture says of its stream, for the log. What the
+// display is sent depends on it, and a stream whose picture comes out wrong can be told from one
+// that plays right by it. Only for metadata that the renderer has checked (offsets and the
+// bounds of its extension blocks).
+std::string DescribeMetadata(const void* metadata)
+{
+  const auto* parsed = static_cast<const AVDOVIMetadata*>(metadata);
+  const AVDOVIRpuDataHeader* header = av_dovi_get_header(parsed);
+  const AVDOVIColorMetadata* color = av_dovi_get_color(parsed);
+  std::string levels;
+  for (int i = 0; i < parsed->num_ext_blocks; ++i)
+  {
+    if (!levels.empty())
+      levels += ' ';
+    levels += std::to_string(static_cast<unsigned int>(av_dovi_get_ext(parsed, i)->level));
+  }
+  return StringUtils::Format(
+      "RPU profile {} level {}, base layer {} bits {} range, enhancement layer {} bits, "
+      "reconstruction {} bits, residual {}; metadata id {}, signal: EOTF {}, {} bits, colour "
+      "space {}, chroma {}, range {}, source {} to {} (PQ); extension levels: {}",
+      static_cast<unsigned int>(header->vdr_rpu_profile),
+      static_cast<unsigned int>(header->vdr_rpu_level),
+      static_cast<unsigned int>(header->bl_bit_depth),
+      header->bl_video_full_range_flag ? "full" : "limited",
+      static_cast<unsigned int>(header->el_bit_depth),
+      static_cast<unsigned int>(header->vdr_bit_depth),
+      header->disable_residual_flag ? "off" : "on",
+      static_cast<unsigned int>(color->dm_metadata_id),
+      static_cast<unsigned int>(color->signal_eotf),
+      static_cast<unsigned int>(color->signal_bit_depth),
+      static_cast<unsigned int>(color->signal_color_space),
+      static_cast<unsigned int>(color->signal_chroma_format),
+      static_cast<unsigned int>(color->signal_full_range_flag),
+      static_cast<unsigned int>(color->source_min_pq),
+      static_cast<unsigned int>(color->source_max_pq), levels.empty() ? "none" : levels);
+}
 } // namespace
 
 CDVBridgeGLES::~CDVBridgeGLES()
@@ -330,13 +368,19 @@ bool CDVBridgeGLES::Prepare(const Layer& base, const Layer* enhancement,
     m_pendingDetail.cm4 = (m_pendingInfo & CDVPlaybackInfo::CM4) != 0;
     if (!m_reportedFrame)
     {
-      CLog::Log(LOGDEBUG,
-                "DVBridge: first prepared frame base={}x{} layout={} enhancement={} "
-                "fel={} cm4={} metadata_bytes={} geometry={},{},{}x{} path={}",
-                base.width, base.height, static_cast<int>(base.layout), enhancement != nullptr,
-                fel, (m_pendingInfo & CDVPlaybackInfo::CM4) != 0, metadata.Size(),
-                geometry.x, geometry.y, geometry.width, geometry.height,
-                m_direct ? "packed" : "float-composition");
+      // Hades: in the log without debugging, to tell a stream whose picture comes out wrong
+      // from one that plays right
+      CLog::Log(LOGINFO,
+                "DVBridge: the first picture of this stream: base {}x{} (layout {}), {}, content "
+                "mapping {}; {}; {} bytes of metadata; drawn at {},{} {}x{} by the {} render",
+                base.width, base.height, static_cast<int>(base.layout),
+                fel       ? "with the residual of its enhancement layer"
+                : omitted ? "without the residual of its enhancement layer, which is missing"
+                : enhancement ? "with an enhancement layer that carries no residual"
+                              : "no enhancement layer",
+                (m_pendingInfo & CDVPlaybackInfo::CM4) ? "v4.0" : "v2.9",
+                DescribeMetadata(metadata.Data()), metadata.Size(), geometry.x, geometry.y,
+                geometry.width, geometry.height, m_direct ? "packed" : "float-composition");
       m_reportedFrame = true;
     }
   }
@@ -581,13 +625,14 @@ bool CDVBridgeGLES::PrepareConversion(const Layer& base,
     if (!m_converted++)
       CLog::Log(LOGINFO,
                 "DVBridge: Dolby Vision reconstructed for output as HDR10: base {}x{}, {}, into "
-                "{}x{} of a {}x{} output",
+                "{}x{} of a {}x{} output; {}",
                 base.width, base.height,
                 fel       ? "with the residual of its enhancement layer"
                 : omitted ? "without the residual of its enhancement layer, which is missing"
                 : layered ? "with an enhancement layer that carries no residual"
                           : "no enhancement layer",
-                view.dst_width, view.dst_height, width, height);
+                view.dst_width, view.dst_height, width, height,
+                DescribeMetadata(metadata.Data()));
   }
   if (layered)
     dvbridge_gl_frame_release(&el);
