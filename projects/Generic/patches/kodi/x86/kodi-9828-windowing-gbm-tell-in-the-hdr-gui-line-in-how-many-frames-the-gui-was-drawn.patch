From 86e6a375fc9f6d614b6bf56f75f1dbae10c8c241 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 17:06:54 +0000
Subject: [PATCH] windowing/gbm: tell in the HDR GUI line in how many frames
 the GUI was drawn

The 10 s line of the HDR10/HLG composite of the GUI counts its frames and
those whose GUI pass was left out, but not the frames in which the GUI was
really drawn over the picture: one whose FBO holds nothing draws nothing.
It now says in how many of them it was (the whole quad, or under the tile
mask), so that an ordinary kodi.log shows that a still subtitle over an HDR
video costs no composite (0 of the frames of the span), and that a GUI on
screen is drawn. The texts that were there are kept.

Test (outside the tree): pgs_hdrline_test, the line of the real header
(does not build on the tree before); the other host tests of the same header (the GUI reuse and the frame) pass.
---
 xbmc/windowing/gbm/DVGuiReuse.h                | 13 ++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp |  3 +++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/xbmc/windowing/gbm/DVGuiReuse.h b/xbmc/windowing/gbm/DVGuiReuse.h
index e31ccb8..b080060 100644
--- a/xbmc/windowing/gbm/DVGuiReuse.h
+++ b/xbmc/windowing/gbm/DVGuiReuse.h
@@ -230,6 +230,10 @@ public:
     m_hdrSkipped += skipped ? 1 : 0;
   }
 
+  //! ... the GUI was drawn over the picture in a frame (its FBO holds something: the whole quad, or
+  //! the rectangles of the tile mask); a frame whose FBO holds nothing draws nothing
+  void HdrDrawn() { ++m_hdrDrawn; }
+
   //! ... and the line of a span of it (empty where there were no frames)
   std::string HdrLine()
   {
@@ -237,13 +241,15 @@ public:
       return std::string();
     std::string s = "HDR GUI: last span: " + std::to_string(m_hdrFrames) +
                     " frames with the GUI composited over the picture, the GUI pass of " +
-                    std::to_string(m_hdrSkipped) + " of them left out (video/dvguireuse)";
+                    std::to_string(m_hdrSkipped) + " of them left out (video/dvguireuse), " +
+                    "the GUI drawn over the picture in " + std::to_string(m_hdrDrawn) +
+                    " of them (where it holds something)";
     if (m_hdrScissored)
       s += "; " + std::to_string(m_hdrScissored) + " composites drawn under " +
            std::to_string(m_hdrRects) +
            " scissor rectangles of the tile mask of the GUI (the same quad, only where the GUI "
            "reaches; video/dvguiscissor)";
-    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = 0;
+    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = m_hdrDrawn = 0;
     return s;
   }
 
@@ -276,7 +282,7 @@ public:
   void Restart()
   {
     m_told = false;
-    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = 0;
+    m_hdrFrames = m_hdrSkipped = m_hdrScissored = m_hdrRects = m_hdrDrawn = 0;
   }
 
 private:
@@ -288,6 +294,7 @@ private:
   unsigned int m_hdrSkipped = 0;
   unsigned int m_hdrScissored = 0;
   unsigned int m_hdrRects = 0;
+  unsigned int m_hdrDrawn = 0;
 };
 
 } // namespace GBM
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index eb0ca94..9f6e9d3 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2275,6 +2275,9 @@ void CWinSystemGbmGLESContext::CompositeGui()
     // Hades: the GUI goes over the bars too: they are cleared again before the next picture
     m_dvBridge->PQTextureDrawn();
   }
+  // Hades: the HDR10/HLG composite draws the GUI over the picture in this frame (the 10 s line)
+  if (!dvComposite)
+    m_dvGuiReuse.HdrDrawn();
 #endif
 
   glActiveTexture(GL_TEXTURE0);
-- 
2.53.0

