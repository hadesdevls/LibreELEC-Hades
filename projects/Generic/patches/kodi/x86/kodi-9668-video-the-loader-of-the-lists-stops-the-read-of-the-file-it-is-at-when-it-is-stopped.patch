From bea63032d13ff7fe2d15b63a187df3128a1d6de3 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:43:19 +0000
Subject: [PATCH] video: the loader of the lists stops the read of the file it
 is at when it is stopped

The loader of a video list reads, for an item without stream details, the
file at a fifth of its length (CDVDFileInfo::GetFileStreamDetails()), and the
interface waits for it to end whenever the list is left, changed or a file is
played. With a file that does not answer, that was the freeze of issue #21,
and Kodi closing waited for it as well, until systemd killed it after 30 s.

LoadItemLookup() gives the probe the stop of the loader (m_stopReads), so that
StopAsync() ends the read in progress and the loader returns within the time
of one read; the item is left as it was, without stream details, and is
probed again next time it is loaded. Kodi closing calls
CDVDFileInfo::StopReadings() before it stops the scans and cancels the jobs,
which ends the reads of the scans and of the thumbnail jobs that those wait
for. The busy dialog that the interface shows after 300 ms needs no string.
---
 xbmc/application/Application.cpp |  6 ++++++
 xbmc/video/VideoThumbLoader.cpp  | 10 +++++++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index 9e31169..6ccb6a0 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -51,6 +51,7 @@
 #include "cores/AudioEngine/Engines/ActiveAE/ActiveAE.h"
 #include "cores/FFmpeg.h"
 #include "cores/playercorefactory/PlayerCoreFactory.h"
+#include "cores/VideoPlayer/DVDFileInfo.h"
 #include "cores/VideoPlayer/MatroskaEditionChoice.h"
 #include "cores/VideoPlayer/SubtitleSeekSearch.h"
 #include "dialogs/GUIDialogBusy.h"
@@ -2177,6 +2178,11 @@ bool CApplication::Stop(int exitCode)
 
     CScriptInvocationManager::GetInstance().NotifyAllScriptsAborting();
 
+    // Hades: the reads of files for stream details and thumbnails, which the scans and the jobs
+    // below wait for, and the loaders of the lists, stop where they are (a file that does not
+    // answer would keep Kodi from exiting until it is killed)
+    CDVDFileInfo::StopReadings();
+
     // Stop scanning before the job manager is cancelled below
     // otherwise scans underway are not stopped
     CMusicLibraryQueue::GetInstance().CancelAllJobs();
diff --git a/xbmc/video/VideoThumbLoader.cpp b/xbmc/video/VideoThumbLoader.cpp
index d624eaa..5217e35 100644
--- a/xbmc/video/VideoThumbLoader.cpp
+++ b/xbmc/video/VideoThumbLoader.cpp
@@ -377,7 +377,10 @@ bool CVideoThumbLoader::LoadItemLookup(CFileItem* pItem)
       // No tag or no details set, so extract them
       CLog::LogF(LOGDEBUG, "trying to extract filestream details from video file {}",
                  CURL::GetRedacted(pItem->GetPath()));
-      if (CDVDFileInfo::GetFileStreamDetails(pItem))
+      // Hades: a read of the file that does not come back is stopped, with the item, when the
+      // loader is (m_stopReads), and nothing of it is stored; the item is probed again when it is
+      // next loaded
+      if (CDVDFileInfo::GetFileStreamDetails(pItem, &m_stopReads))
       {
         CVideoInfoTag* info = pItem->GetVideoInfoTag();
         m_videoDatabase->BeginTransaction();
@@ -400,6 +403,11 @@ bool CVideoThumbLoader::LoadItemLookup(CFileItem* pItem)
 
         m_videoDatabase->CommitTransaction();
       }
+      else if (m_stopReads)
+      {
+        m_videoDatabase->Close();
+        return false;
+      }
     }
   }
   DetectAndAddMissingItemData(*pItem);
-- 
