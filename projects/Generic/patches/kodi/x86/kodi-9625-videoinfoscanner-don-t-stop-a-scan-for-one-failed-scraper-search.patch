From 95beba1e239e6549af779c9306c65ed408770b24 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Wed, 14 Oct 2026 22:02:16 +0100
Subject: [PATCH] [VideoInfoScanner] Don't stop a scan for one failed scraper
 search

An error the scraper reports while searching for a title stopped the
whole scan, whatever the <videoscanner><ignoreerrors> setting. Treat it
like any other failed lookup during a scan: carry on when errors are
ignored, otherwise ask whether to continue. An interactive lookup still
ends on the error, as the scraper has already reported it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e3b5861bf6a220d012b509f803ddf78a44cbdeca)
---
 xbmc/video/VideoInfoScanner.cpp          |  4 +++-
 xbmc/video/test/TestVideoInfoScanner.cpp | 14 ++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 34fd840..0a7ad7e 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -2931,7 +2931,9 @@ CVideoInfoScanner::~CVideoInfoScanner()
     MOVIELIST movielist;
     CVideoInfoDownloader imdb(scraper);
     int returncode = imdb.FindMovie(title, year, movielist, progress);
-    if (returncode < 0 || (returncode == 0 && (m_bStop || !DownloadFailed(progress))))
+    // An error the scraper reported ends an interactive lookup, but a scan only stops for it when
+    // the user chooses to - as it does for any other failed lookup
+    if (returncode <= 0 && (m_bStop || (returncode < 0 && progress) || !DownloadFailed(progress)))
     { // scraper reported an error, or we had an error and user wants to cancel the scan
       m_bStop = true;
       return -1; // cancelled
diff --git a/xbmc/video/test/TestVideoInfoScanner.cpp b/xbmc/video/test/TestVideoInfoScanner.cpp
index bb7d7d4..1dd09ad 100644
--- a/xbmc/video/test/TestVideoInfoScanner.cpp
+++ b/xbmc/video/test/TestVideoInfoScanner.cpp
@@ -532,6 +532,20 @@ TEST_F(TestVideoInfoScanner, AMovieIsAddedFromTheScraper)
   EXPECT_EQ("Film from the scraper", m_db.GetSingleValue("SELECT c00 FROM movie"));
 }
 
+TEST_F(TestVideoInfoScanner, AFailedSearchDoesNotStopTheScan)
+{
+  UseTestScraper(ADDON::AddonType::SCRAPER_MOVIES);
+  SearchFails("Afilm");
+  File(m_root, "Afilm.mkv");
+  Nfo(m_root, "Bfilm.nfo", "Bfilm");
+  const std::string second{File(m_root, "Bfilm.mkv")};
+
+  Scan();
+
+  EXPECT_GT(m_db.GetMovieId(second), 0);
+  EXPECT_EQ(1, CountMovies());
+}
+
 // TV shows
 
 namespace
