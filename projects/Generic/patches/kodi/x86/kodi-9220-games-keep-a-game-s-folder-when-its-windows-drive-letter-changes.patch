From 85dff2a447aafc5a87a4eb41be9631b38f92d909 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 13 Oct 2026 07:45:36 +0100
Subject: [PATCH] [games] Keep a game's folder when its Windows drive letter
 changes

A game's folder is keyed on the file name and the two folders above it,
leaving out the server of an smb:// or nfs:// path. A local Windows path
kept its root, so D:\Roms\Sonic.md keyed on D: and a library moved to
E:, or to a \\server share, lost its saves. Leave a DOS path's drive
letter or server out as well.
---
 xbmc/games/GameUtils.cpp          | 9 ++++++++-
 xbmc/games/test/TestGameUtils.cpp | 6 ++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/xbmc/games/GameUtils.cpp b/xbmc/games/GameUtils.cpp
index 3399665..9df9482 100644
--- a/xbmc/games/GameUtils.cpp
+++ b/xbmc/games/GameUtils.cpp
@@ -66,10 +66,17 @@ void AddPathParts(const CURL& url, std::vector<std::string>& parts)
   if (url.HasParentInHostname())
     AddPathParts(CURL(url.GetHostName()), parts);
 
+  // A Windows drive letter or network server is where the library is, not part of it
+  bool skipRoot = URIUtils::IsDOSPath(url.GetFileName());
+
   constexpr std::array<std::string_view, 2> separators{"/", "\\"};
   for (std::string& part : StringUtils::Split(url.GetFileName(), separators))
   {
-    if (!part.empty())
+    if (part.empty())
+      continue;
+    if (skipRoot)
+      skipRoot = false;
+    else
       parts.emplace_back(std::move(part));
   }
 }
diff --git a/xbmc/games/test/TestGameUtils.cpp b/xbmc/games/test/TestGameUtils.cpp
index ef172a3..57eee2c 100644
--- a/xbmc/games/test/TestGameUtils.cpp
+++ b/xbmc/games/test/TestGameUtils.cpp
@@ -50,6 +50,12 @@ TEST(TestGameUtils, AGameKeepsItsFolderWhenTheLibraryMoves)
 
   EXPECT_EQ(CGameUtils::GetGameFolder("smb://nas1/Roms/Sonic.md"),
             CGameUtils::GetGameFolder("smb://nas2/Roms/Sonic.md"));
+  EXPECT_EQ(CGameUtils::GetGameFolder("D:\\Roms\\Sonic.md"),
+            CGameUtils::GetGameFolder("E:\\Roms\\Sonic.md"));
+  EXPECT_EQ(CGameUtils::GetGameFolder("D:\\Roms\\Sonic.md"),
+            CGameUtils::GetGameFolder("\\\\nas\\Roms\\Sonic.md"));
+  EXPECT_EQ(CGameUtils::GetGameFolder("D:\\Roms\\Sonic.md"),
+            CGameUtils::GetGameFolder("smb://nas/Roms/Sonic.md"));
 
   const std::string zipped =
       CGameUtils::GetGameFolder("zip://%2fmedia%2fdisk1%2fGames%2fSNES%2fMario.zip/Mario.sfc");
-- 
