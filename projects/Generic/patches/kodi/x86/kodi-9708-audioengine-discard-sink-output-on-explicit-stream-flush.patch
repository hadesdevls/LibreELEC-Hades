From 4716c8f5bf2a5b07abb73733ee90874dfa7c6410 Mon Sep 17 00:00:00 2001
From: marsli-jpg <298300096+marsli-jpg@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:59:54 +0800
Subject: [PATCH] AudioEngine: discard sink output on explicit stream flush

Pass discard intent from a single-stream flush to the sink thread while
preserving queued output on ordinary pause. Add a RAW sink flush hook.

Co-authored-by: 1358 <1583407+1358@users.noreply.github.com>
Co-authored-by: VuzzyM <66425682+VuzzyM@users.noreply.github.com>
---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp     | 7 ++++---
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h       | 2 +-
 xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp | 3 +++
 xbmc/cores/AudioEngine/Interfaces/AESink.h               | 7 +++++++
 4 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 0feedc5..0cbdd7e 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -1805,13 +1805,13 @@ void CActiveAE::SFlushStream(CActiveAEStream *stream)
   // flush the engine if we only have a single stream
   if (m_streams.size() == 1)
   {
-    FlushEngine();
+    FlushEngine(true);
   }
 
   m_stats.UpdateStream(stream);
 }
 
-void CActiveAE::FlushEngine()
+void CActiveAE::FlushEngine(bool discardOutput)
 {
   if (m_sinkBuffers)
     m_sinkBuffers->Flush();
@@ -1841,7 +1841,8 @@ void CActiveAE::FlushEngine()
 
   // send message to sink
   Message *reply;
-  if (m_sink.m_controlPort.SendOutMessageSync(CSinkControlProtocol::FLUSH, &reply, 2s))
+  if (m_sink.m_controlPort.SendOutMessageSync(CSinkControlProtocol::FLUSH, &reply, 2s,
+                                              &discardOutput, sizeof(discardOutput)))
   {
     bool success = reply->signal == CSinkControlProtocol::ACC;
     if (!success)
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
index 3650c70..9d8b518 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.h
@@ -376,7 +376,7 @@ protected:
   CActiveAEStream* CreateStream(MsgStreamNew *streamMsg);
   void DiscardStream(CActiveAEStream *stream);
   void SFlushStream(CActiveAEStream *stream);
-  void FlushEngine();
+  void FlushEngine(bool discardOutput = false);
   void ClearDiscardedBuffers();
   void SStopSound(CActiveAESound *sound);
   void DiscardSound(CActiveAESound *sound);
diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
index 106783a..ba04df8 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -337,6 +337,9 @@ void CActiveAESink::StateMachine(int signal, Protocol *port, Message *msg)
 
         case CSinkControlProtocol::FLUSH:
           ReturnBuffers();
+          // Pause also clears AE queues: only explicit stream flush discards device audio.
+          if (m_sink && *reinterpret_cast<const bool*>(msg->data))
+            m_sink->Flush();
           msg->Reply(CSinkControlProtocol::ACC);
           return;
 
diff --git a/xbmc/cores/AudioEngine/Interfaces/AESink.h b/xbmc/cores/AudioEngine/Interfaces/AESink.h
index 5637c69..d3a688f 100644
--- a/xbmc/cores/AudioEngine/Interfaces/AESink.h
+++ b/xbmc/cores/AudioEngine/Interfaces/AESink.h
@@ -72,6 +72,13 @@ public:
    */
   virtual void Drain() {}
 
+  /*
+    Discard queued RAW output at an explicit stream discontinuity.
+    Called by the sink thread. Only RAW sinks need to implement this;
+    PCM and IEC sinks keep the default no-op.
+   */
+  virtual void Flush() {}
+
   /*
     Indicates if sink can handle volume control.
   */
-- 
