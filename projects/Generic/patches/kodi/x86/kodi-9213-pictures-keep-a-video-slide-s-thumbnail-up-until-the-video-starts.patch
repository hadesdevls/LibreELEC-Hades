From 33b1e6a09901c858f4422f7e90d69d284661b845 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sun, 11 Oct 2026 20:14:42 +0100
Subject: [PATCH] [pictures] Keep a video slide's thumbnail up until the video
 starts

Browsing pictures by hand, a video's thumbnail slides in like a picture,
but once it became the current slide the slideshow cleared to black until
the player had a frame, so every video flashed black first. Keep drawing
the thumbnail until then. A running slideshow still doesn't show it, as it
never shows video thumbnails.
---
 xbmc/pictures/GUIWindowSlideShow.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/xbmc/pictures/GUIWindowSlideShow.cpp b/xbmc/pictures/GUIWindowSlideShow.cpp
index 496b614..c4ad569 100644
--- a/xbmc/pictures/GUIWindowSlideShow.cpp
+++ b/xbmc/pictures/GUIWindowSlideShow.cpp
@@ -737,14 +737,16 @@ void CGUIWindowSlideShow::Render()
       IsVideo(*m_slides.at(m_iCurrentSlide)) && CServiceBroker::GetWinSystem()->IsHdrComposite();
   gfxCtx.Clear(hdrVideo ? 0 : 0xff000000);
 
-  if (IsVideo(*m_slides.at(m_iCurrentSlide)))
+  auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+
+  // A running slideshow never shows a video's thumbnail. Otherwise keep it up until the first frame.
+  if (IsVideo(*m_slides.at(m_iCurrentSlide)) &&
+      ((m_bSlideShow && !m_bPause) || appPlayer->IsRenderingVideo()))
   {
     gfxCtx.SetViewWindow(0, 0, m_coordsRes.iWidth, m_coordsRes.iHeight);
     gfxCtx.SetRenderingResolution(gfxCtx.GetVideoResolution(), false);
 
-    auto& components = CServiceBroker::GetAppComponents();
-    const auto appPlayer = components.GetComponent<CApplicationPlayer>();
-
     if (appPlayer->IsRenderingVideoLayer())
     {
       const CRect old = gfxCtx.GetScissors();
