From 0b42b139e17ba6db8c9ad3264d4afe77c646f226 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:22:44 +0000
Subject: [PATCH] windowing/gbm: the mode that the output is in is compared
 whole with the 3D mode that was set

After a 3D mode is set, the mode that the output is in is read back from
the kernel, to know whether the driver took the commit. Only its 3D
layout was compared: a commit that was refused while the output was in
another mode of the same layout (frame packing at 24 Hz, asked for at
23.976 Hz; 720p50, asked for at 720p60) read as taken, and Kodi went on
at a refresh rate that the output did not have.

The clock, the size, the totals and what the flags say of interlacing,
double scan and the 3D layout are compared now.

Host test: drmstereo_test (IsOutputMode).
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 11 +++++++----
 xbmc/windowing/gbm/drm/DRMStereo.h  | 18 ++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.cpp |  9 +++++++--
 xbmc/windowing/gbm/drm/DRMUtils.h   |  9 ++++++---
 4 files changed, 38 insertions(+), 9 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 83c5f28..abf19c9 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -845,12 +845,15 @@ void CWinSystemGbm::CheckStereoOutput()
 
   // What the output is in, whatever became of the commit: where the driver does not take a
   // commit, CDRMAtomic commits what it committed last, and the mode stays the one before.
-  uint32_t flags = 0;
-  const STEREO::Layout shown =
-      m_DRM->GetOutputModeFlags(flags) ? STEREO::LayoutOf(flags) : STEREO::Layout::NONE;
+  // The mode is compared, not its layout alone: the one before may have the same layout
+  // (frame packing at 24 Hz, where it was asked for at 23.976 Hz).
+  STEREO::Mode output;
+  const bool has = m_DRM->GetOutputMode(output);
+  const STEREO::Layout shown = has ? STEREO::LayoutOf(output.flags) : STEREO::Layout::NONE;
   m_stereoLayout = shown;
 
-  if (asked != STEREO::Layout::NONE && shown != asked)
+  if (asked != STEREO::Layout::NONE &&
+      !(has && STEREO::IsOutputMode(m_DRM->GetSelectedStereoMode(), output)))
   {
     RefuseStereoOutput(asked == STEREO::Layout::FRAME_PACKING ? m_stereoRefusedFramePacking
                                                               : m_stereoRefusedHalfModes,
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index 905a52b..7697ea0 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -169,6 +169,24 @@ constexpr bool SameTiming(const Mode& a, const Mode& b)
          (a.flags & ~FLAG_3D_MASK) == (b.flags & ~FLAG_3D_MASK);
 }
 
+/*!
+ * \brief Whether the mode that an output is in is a mode that was set
+ * \param set the mode that was set
+ * \param output the mode that the kernel says the output is in
+ *
+ * By what the kernel gives back of a mode as it was given, and tells the modes of a display
+ * apart: the clock, the size and the totals, and what the flags say of interlacing, of double
+ * scan and of the 3D layout. (The flags of the picture's aspect ratio are told to a program
+ * only if it asked for them.)
+ */
+constexpr bool IsOutputMode(const Mode& set, const Mode& output)
+{
+  constexpr uint32_t FLAGS = FLAG_INTERLACE | FLAG_DBLSCAN | FLAG_3D_MASK;
+  return set.clock == output.clock && set.hdisplay == output.hdisplay &&
+         set.htotal == output.htotal && set.vdisplay == output.vdisplay &&
+         set.vtotal == output.vtotal && (set.flags & FLAGS) == (output.flags & FLAGS);
+}
+
 /*!
  * \brief What the display offers for one of its 2D modes
  */
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index b375f17..82fc285 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1427,7 +1427,7 @@ STEREO::Layout CDRMUtils::GetModeLayout(const RESOLUTION_INFO& res) const
   return STEREO::LayoutOf(m_connector->GetModeForIndex(index)->flags);
 }
 
-bool CDRMUtils::GetOutputModeFlags(uint32_t& flags) const
+bool CDRMUtils::GetOutputMode(STEREO::Mode& mode) const
 {
   if (m_fd < 0 || !m_crtc)
     return false;
@@ -1437,11 +1437,16 @@ bool CDRMUtils::GetOutputModeFlags(uint32_t& flags) const
     return false;
 
   const bool valid = crtc->mode_valid != 0;
-  flags = crtc->mode.flags;
+  mode = StereoModeOf(crtc->mode);
   drmModeFreeCrtc(crtc);
   return valid;
 }
 
+STEREO::Mode CDRMUtils::GetSelectedStereoMode() const
+{
+  return m_mode ? StereoModeOf(*m_mode) : STEREO::Mode{};
+}
+
 bool CDRMUtils::FramePackedByOffsets() const
 {
   // (the mode first: no other mode asks the driver for its name)
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 806a92a..8c3fd35 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -151,10 +151,13 @@ public:
   //! \brief The 3D layout of the mode of the connector that a resolution information names
   //! (its strId); none where it names no mode
   STEREO::Layout GetModeLayout(const RESOLUTION_INFO& res) const;
-  //! \brief The flags of the mode that the output is in now, as the kernel tells them: what
-  //! the last commit of a mode left there, whether the driver took that commit or not
+  //! \brief The mode that the output is in now, as the kernel tells it: what the last commit
+  //! of a mode left there, whether the driver took that commit or not
   //! \return whether the output has a mode
-  bool GetOutputModeFlags(uint32_t& flags) const;
+  bool GetOutputMode(STEREO::Mode& mode) const;
+  //! \brief The selected mode (the one that is set, or is being set) as DRMStereo.h takes a
+  //! mode; all of it zero without one
+  STEREO::Mode GetSelectedStereoMode() const;
   /*!
    * \brief What the driver asks of the buffer that is shown in the selected mode, where that
    *        mode is frame packed and the driver is nvidia-drm
-- 
