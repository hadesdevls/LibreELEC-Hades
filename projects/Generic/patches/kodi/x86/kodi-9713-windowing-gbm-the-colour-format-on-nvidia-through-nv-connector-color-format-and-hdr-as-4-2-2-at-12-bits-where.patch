+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4410,6 +4410,7 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
       // the driver's default) or RGB at 8 ("never"). It acts only with HDR metadata, and the
       // driver keeps it with the connector's state: it is set with each video, as the setting
       // is then.
+      gbm.AddHdr422(drm, connector);
       if (connector.SupportsProperty(DVBRIDGE::LINK::HDR_YCBCR420))
       {
         // (a colour format that the user chose is theirs: the rule of the driver steps aside)
@@ -4512,25 +4513,83 @@ void CWinSystemGbm::ReadOutputFormat(CDRMConnector& connector)
   m_formatToldKey.clear();
   m_bitsStagedKey.clear();
   m_bitsRefusedKey.clear();
-  m_outputFormatChoice = connector.SupportsProperty(OUTPUT_FORMAT::PROPERTY) &&
-                         connector.GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY, "AUTO");
+  m_formatProperty.clear();
+  m_formatNvidia = false;
+  m_formatNoValueTold.clear();
+  if (connector.SupportsProperty(OUTPUT_FORMAT::PROPERTY_NVIDIA) &&
+      connector.GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY_NVIDIA, "auto"))
+  {
+    m_formatProperty = OUTPUT_FORMAT::PROPERTY_NVIDIA;
+    m_formatNvidia = true;
+  }
+  else if (connector.SupportsProperty(OUTPUT_FORMAT::PROPERTY) &&
+           connector.GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY, "AUTO"))
+    m_formatProperty = OUTPUT_FORMAT::PROPERTY;
+  m_outputFormatChoice = !m_formatProperty.empty();
   const auto limits = connector.GetRangePropertyLimits("max bpc");
   m_maxBitsChoice = limits && limits->second >= 8 && !m_hdrDepthChoice;
   if (m_outputFormatChoice || m_maxBitsChoice)
   {
-    const auto format = connector.ReadPropertyValue(OUTPUT_FORMAT::PROPERTY);
-    const auto name = format ? connector.GetPropertyEnumName(OUTPUT_FORMAT::PROPERTY, *format)
+    const auto format = m_outputFormatChoice ? connector.ReadPropertyValue(m_formatProperty)
+                                             : std::nullopt;
+    const auto name = format ? connector.GetPropertyEnumName(m_formatProperty, *format)
                              : std::nullopt;
     CLog::Log(LOGINFO,
               "Output format: {}: the choice of the colour format is {}{}; the choice of the depth of "
               "the link is {} (\"max bpc\" {} to {}); \"Automatic\" adds nothing to any request",
-              connector.GetName(), m_outputFormatChoice ? "there" : "not there (no \"color format\")",
+              connector.GetName(),
+              m_outputFormatChoice ? (std::string("there (") + m_formatProperty + ")")
+                                   : std::string("not there (no \"color format\")"),
               name ? std::string(", the connector has \"") + *name + "\"" : std::string(),
               m_maxBitsChoice ? "there" : "not there", limits ? limits->first : 0,
               limits ? limits->second : 0);
   }
 }
 
+std::string CWinSystemGbm::FormatValueName(OUTPUT_FORMAT::Format format) const
+{
+  return std::string(m_formatNvidia ? OUTPUT_FORMAT::NvidiaName(format)
+                                    : OUTPUT_FORMAT::KernelName(format));
+}
+
+// Hades: HDR as YCbCr 4:2:2 at 12 bits where RGB could not leave 8 bits, with the request that
+// signals it (OUTPUT_FORMAT::Hdr422Wanted()); the driver refusing it, the request goes out as RGB
+void CWinSystemGbm::AddHdr422(CDRMAtomic& drm, CDRMConnector& connector)
+{
+  if (!m_outputFormatChoice || !m_formatNvidia)
+    return;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const auto info = DisplayInfo();
+  const auto* mode = drm.GetSelectedMode();
+  const auto value422 = connector.GetPropertyEnumValue(
+      m_formatProperty, FormatValueName(OUTPUT_FORMAT::Format::YCBCR422));
+  const auto autoValue = connector.GetPropertyEnumValue(m_formatProperty, "auto");
+  if (!settings || !info || !mode || !value422 || !autoValue)
+    return;
+  OUTPUT_FORMAT::Hdr422Input in;
+  in.setting = settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDRMOREBITS);
+  in.hdrHeldAt8 = m_hdrDepthChoice && settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESHDRDEPTH) == 8;
+  in.property = true;
+  in.hdmi = connector.GetType() == "HDMI-A";
+  in.hdrSent = true;
+  in.userChoseFormat = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESCOLORFORMAT) != 0;
+  in.sink422 = info->SupportsYCbCr422();
+  in.sinkFrl = info->SupportsHdmiFrl();
+  in.clockKHz = mode->clock;
+  if (!OUTPUT_FORMAT::Hdr422Wanted(in) || m_formatRefusedKey == OutputModeKey() + ":hdr422")
+    return;
+  if (drm.AddSoftProperty(&connector, m_formatProperty.c_str(), *value422, *autoValue))
+  {
+    m_formatStagedKey = OutputModeKey() + ":hdr422";
+    CLog::Log(LOGINFO,
+              "Output format: HDR goes out as YCbCr 4:2:2 at 12 bits on {} ({}, {} kHz): RGB would "
+              "leave it at 8 bits here (no FRL link, above 480 MHz); the video is 4:2:0 already "
+              "(videoscreen.hadeshdrmorebits)",
+              connector.GetName(), m_formatProperty, mode->clock);
+  }
+}
+
 std::string CWinSystemGbm::OutputModeKey() const
 {
   const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
@@ -4550,17 +4609,36 @@ void CWinSystemGbm::StageOutputFormat()
   const auto settings = component ? component->GetSettings() : nullptr;
   if (!connector || !settings)
     return;
+  // (a request that carries it already, as HDR as YCbCr 4:2:2 does (AddHdr422()), is not changed here)
+  if (drm->RequestValue(connector, m_formatProperty.c_str()))
+    return;
   const auto format = OUTPUT_FORMAT::FormatOfSetting(
       settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESCOLORFORMAT));
-  const auto chosen = connector->GetPropertyEnumValue(OUTPUT_FORMAT::PROPERTY,
-                                                      OUTPUT_FORMAT::KernelName(format));
+  const std::string valueName = FormatValueName(format);
+  const auto chosen = valueName.empty() ? std::nullopt
+                                        : connector->GetPropertyEnumValue(m_formatProperty, valueName);
+  if (!chosen && format != OUTPUT_FORMAT::Format::AUTO)
+  {
+    const std::string told = std::string(OUTPUT_FORMAT::LogName(format));
+    if (m_formatNoValueTold != told)
