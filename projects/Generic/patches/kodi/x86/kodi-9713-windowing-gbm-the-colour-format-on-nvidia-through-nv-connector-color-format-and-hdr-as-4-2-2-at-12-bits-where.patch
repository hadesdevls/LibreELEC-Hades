 }
 
+//! What decides whether HDR goes out as YCbCr 4:2:2 at 12 bits where RGB could not leave 8 bits
+struct Hdr422Input
+{
+  bool setting = false; //!< videoscreen.hadeshdrmorebits: the user asked for more than 8 bits
+  bool hdrHeldAt8 = false; //!< videoscreen.hadeshdrdepth is 8: HDR is held at 8 bits on purpose
+  bool property = false; //!< the connector has the colour format with a value YCbCr 4:2:2
+  bool hdmi = false; //!< an HDMI connector
+  bool hdrSent = false; //!< the request signals HDR (not native Dolby Vision, whose tunnel is RGB)
+  bool userChoseFormat = false; //!< the user chose a colour format: it is theirs
+  bool sink422 = false; //!< the EDID declares YCbCr 4:2:2
+  bool sinkFrl = false; //!< the EDID declares a Fixed Rate Link: RGB may go over it
+  uint32_t clockKHz = 0; //!< the pixel clock of the mode
+};
+
+/*!
+ * rief HDR as YCbCr 4:2:2 at 12 bits: only where it is the exact choice
+ *
+ * HDMI carries 4:2:2 at 12 bits in the clock of RGB at 8 bits (HDMI 2.0, 4.4.1: 12 bits in the
+ * 24-bit container), so a TMDS link that carries a mode in RGB at 8 bits carries it in 4:2:2 at
+ * 12. RGB at 10 bits needs 1.25 times that clock: above 480 MHz it does not fit the 600 MHz of TMDS,
+ * and a link without FRL (the EDID declares none) has no other way. There RGB would leave HDR at 8
+ * bits (2 bits lost in the picture); the video is 4:2:0 already, so 4:2:2 loses none of its
+ * chroma. Where the sink declares FRL, RGB can go over it at 10 bits and with full chroma: that is
+ * not touched. Any datum that is missing is "no".
+ */
+constexpr bool Hdr422Wanted(const Hdr422Input& in)
+{
+  return in.setting && !in.hdrHeldAt8 && in.property && in.hdmi && in.hdrSent &&
+         !in.userChoseFormat && in.sink422 && !in.sinkFrl && in.clockKHz > 480000;
+}
+
 //! The depths that the user can choose for "max bpc" (0: the drivers' choice)
 constexpr bool ValidBits(int bits)
 {
