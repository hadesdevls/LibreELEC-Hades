@@ -76,6 +79,25 @@ constexpr std::string_view KernelName(Format format)
   return "AUTO";
 }
 
+//! The names of the values of NV_CONNECTOR_COLOR_FORMAT (nvidia-drm-drv.c); none for 4:2:0
+constexpr std::string_view NvidiaName(Format format)
+{
+  switch (format)
+  {
+    case Format::RGB:
+      return "RGB";
+    case Format::YCBCR444:
+      return "YCbCr444";
+    case Format::YCBCR422:
+      return "YCbCr422";
+    case Format::YCBCR420:
+      return "";
+    case Format::AUTO:
+      break;
+  }
+  return "auto";
+}
+
 //! The name of the choice as the log says it
