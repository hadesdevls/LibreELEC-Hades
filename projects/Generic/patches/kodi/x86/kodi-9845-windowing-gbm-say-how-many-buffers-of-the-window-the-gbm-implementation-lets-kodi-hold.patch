From 662e5a83a03359cbd9281c7df6710d06e5e6e4a2 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:41:05 +0000
Subject: [PATCH] windowing/gbm: say how many buffers of the window the GBM
 implementation lets Kodi hold

Dolby Vision presented a frame ahead draws a frame while the buffer on
the screen and the one queued for its flip are kept: a third buffer.
Mesa gives four; NVIDIA's egl-gbm 1.1.4 gave two (a stream FIFO of two),
so on NVIDIA the way a frame ahead was given up after its first frame
with "the output has no third buffer", and nothing in kodi.log said how
many buffers the window had. nvidia_egl-gbm-9001 makes it three, and
two where the driver makes no stream of three.

CGBMSurface::MostHeld() is the most buffers Kodi held locked at once
when the implementation said it had none left to draw into (the
ordinary output, LockFrontBuffer()), and kodi.log says it once for each
window, as soon as it is known:

  GBM: the window lets Kodi hold N of its buffers at once (GBM backend
  nvidia): a frame can be drawn while the one on the screen and the one
  queued for its flip are kept

or, with fewer than three, that Dolby Vision is never presented a frame
ahead on that output. The warning of the way a frame ahead now says the
same. Nothing else changes: what Kodi locks and releases, and when, is
as before.
---
 xbmc/windowing/gbm/GBMUtils.cpp               |  2 ++
 xbmc/windowing/gbm/GBMUtils.h                 |  5 ++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 29 ++++++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  4 +++
 4 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/GBMUtils.cpp b/xbmc/windowing/gbm/GBMUtils.cpp
index 33bb09a..568fff6 100644
--- a/xbmc/windowing/gbm/GBMUtils.cpp
+++ b/xbmc/windowing/gbm/GBMUtils.cpp
@@ -10,6 +10,7 @@
 
 #include "utils/log.h"
 
+#include <algorithm>
 #include <mutex>
 
 using namespace KODI::WINDOWING::GBM;
@@ -81,6 +82,7 @@ CGBMUtils::CGBMDevice::CGBMSurface::CGBMSurfaceBuffer& CGBMUtils::CGBMDevice::CG
 
   if (!static_cast<bool>(gbm_surface_has_free_buffers(m_surface)))
   {
+    m_mostHeld = std::max(m_mostHeld, m_buffers.size()); // (Hades: MostHeld())
     /*
      * We want to use call_once here because we want it to be logged the first time that
      * we have to release buffers. This means that the maximum amount of buffers had been reached.
diff --git a/xbmc/windowing/gbm/GBMUtils.h b/xbmc/windowing/gbm/GBMUtils.h
index b11dc49..cc57b50 100644
--- a/xbmc/windowing/gbm/GBMUtils.h
+++ b/xbmc/windowing/gbm/GBMUtils.h
@@ -138,6 +138,10 @@ public:
       gbm_bo* ScanoutBuffer() const { return m_scanoutBuffer ? m_scanoutBuffer->Get() : nullptr; }
       // A buffer is left to draw the next frame into
       bool HasFreeBuffers() const;
+      // Hades: the most buffers of the window that Kodi held locked at once when the
+      // implementation said it had none left to draw into (LockFrontBuffer()): how many it lets
+      // Kodi hold. 0 while it has not said so.
+      size_t MostHeld() const { return m_mostHeld; }
       void EndTransactionalMode();
 
     private:
@@ -146,6 +150,7 @@ public:
       std::unique_ptr<CGBMSurfaceBuffer> m_scanoutBuffer;
       std::unique_ptr<CGBMSurfaceBuffer> m_pendingBuffer;
       std::unique_ptr<CGBMSurfaceBuffer> m_retiredBuffer;
+      size_t m_mostHeld{0};
     };
 
     /**
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 5212bc4..1a7dd5a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1009,6 +1009,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       m_dvPlusClock.Lost();
 #endif
     CWinSystemGbm::FlipPage(rendered, videoLayer, async);
+    TellWindowBuffers();
 #ifdef HAVE_DVBRIDGE
     // Hades: the frame of this commit, whose flip comes before the next commit (async), or came
     // with this one, which waited for it (CPresentLag); a line a minute while a video plays
@@ -1183,6 +1184,25 @@ void CWinSystemGbmGLESContext::OutputLeftOff()
   m_flipOutputWait = 1s;
 }
 
+void CWinSystemGbmGLESContext::TellWindowBuffers()
+{
+  // (the window of this output: a new one, made for another size, is said again)
+  auto& surface = m_GBM->GetDevice().GetSurface();
+  const size_t held = surface.MostHeld();
+  if (held == 0 || m_windowBuffersTold == &surface)
+    return;
+  m_windowBuffersTold = &surface;
+  const char* backend = gbm_device_get_backend_name(m_GBM->GetDevice().Get());
+  // A frame presented a frame ahead is drawn while the buffer on the screen and the one queued
+  // for its flip are kept: a third one (NVIDIA's egl-gbm gave two before nvidia_egl-gbm-9001)
+  CLog::Log(LOGINFO, "GBM: the window lets Kodi hold {} of its buffers at once (GBM backend {}): {}",
+            held, backend ? backend : "unknown",
+            held >= 3 ? "a frame can be drawn while the one on the screen and the one queued for "
+                        "its flip are kept"
+                      : "a frame is drawn only once the flip of the one before has come, and "
+                        "Dolby Vision is never presented a frame ahead on this output");
+}
+
 void CWinSystemGbmGLESContext::FlipOutputOn()
 {
   const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
@@ -6585,7 +6605,14 @@ void CWinSystemGbmGLESContext::DVAheadEnd(bool presented, const DVFlip& flip)
         m_dvPresentStall.Flipped(); // (Hades: it came in time)
       }
       ahead = false;
-      DVAheadFailed("the output has no third buffer", true);
+      // (Hades: and how many the window lets Kodi hold, as the ordinary output saw: TellWindowBuffers())
+      const size_t held = surface.MostHeld();
+      const std::string why = StringUtils::Format(
+          "the output has no third buffer: the GBM implementation has none left to draw the next "
+          "frame into while the one on the screen and the one queued for its flip are kept; the "
+          "window lets Kodi hold {} of its buffers at once",
+          held > 0 ? std::to_string(held) : std::string("2"));
+      DVAheadFailed(why.c_str(), true);
     }
   }
   if (ahead != m_dvAheadShown)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 0218ccc..d77ad74 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -364,6 +364,10 @@ private:
   //! Hades: ... and one that a change of mode from scratch could not turn on again
   //! (CWinSystemGbm::FlipModeFromScratch())
   void OutputLeftOff() override;
+  //! Hades: how many buffers of the window the GBM implementation lets Kodi hold at once
+  //! (CGBMSurface::MostHeld()), said once for each window once it is known
+  void TellWindowBuffers();
+  const void* m_windowBuffersTold{nullptr};
   bool m_flipOutputOff{false};
   std::chrono::steady_clock::time_point m_flipOutputTry{};
   std::chrono::steady_clock::duration m_flipOutputWait{};
-- 
2.53.0

