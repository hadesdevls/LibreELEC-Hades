+namespace
+{
+// SMPTE ST 2084 EOTF: a 12-bit PQ code value in cd/m2.
+double PQToNits(int code)
+{
+  constexpr double m1 = 2610.0 / 16384.0;
+  constexpr double m2 = 2523.0 / 4096.0 * 128.0;
+  constexpr double c1 = 3424.0 / 4096.0;
+  constexpr double c2 = 2413.0 / 4096.0 * 32.0;
+  constexpr double c3 = 2392.0 / 4096.0 * 32.0;
+  const double e = std::pow(std::clamp(code, 0, 4095) / 4095.0, 1.0 / m2);
+  return 10000.0 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1.0 / m1);
+}
+} // namespace
+
+void CWinSystemGbmGLESContext::PublishDVInfo(bool force)
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (!force && now - m_dvPublishTime < std::chrono::milliseconds(500))
+    return;
+  m_dvPublishTime = now;
+  auto* gui = CServiceBroker::GetGUI();
+  CGUIWindow* home = gui ? gui->GetWindowManager().GetWindow(WINDOW_HOME) : nullptr;
+  if (!home)
+    return;
+
+  // Every key is always set, empty when it does not apply, so that stale values are cleared.
+  const bool native = m_dvSignalling;
+  std::map<std::string, std::string> info{
+      {"hades.dv.state", native ? "native" : ""},
+      {"hades.dv.reason", native ? "" : NativeDVOutputReason()},
+      {"hades.dv.display", DisplayDolbyVisionSupport()},
+      {"hades.dv.layers", ""}, {"hades.dv.cm", ""}, {"hades.dv.l1", ""}, {"hades.dv.l2", ""},
+      {"hades.dv.l5", ""}, {"hades.dv.l6", ""}, {"hades.dv.mode", ""}, {"hades.dv.shown", ""},
+      {"hades.dv.notshown", ""}, {"hades.dv.gap", ""}, {"hades.dv.l1changes", ""}};
+  if (native && m_dvBridge && m_dvBridge->GetPresentedDetail().valid)
+  {
+    const auto& d = m_dvBridge->GetPresentedDetail();
+    info["hades.dv.layers"] = d.fel ? "FEL" : d.enhancement ? "MEL" : "BL";
+    info["hades.dv.cm"] = d.cm4 ? "4.0" : "2.9";
+    if (d.l1[0] >= 0)
+      info["hades.dv.l1"] = StringUtils::Format("{:.4f} / {:.0f} / {:.0f}", PQToNits(d.l1[0]),
+                                                PQToNits(d.l1[1]), PQToNits(d.l1[2]));
+    info["hades.dv.l2"] = std::to_string(d.l2Trims);
+    if (d.l5[0] >= 0)
+      info["hades.dv.l5"] =
+          StringUtils::Format("{} / {} / {} / {}", d.l5[0], d.l5[1], d.l5[2], d.l5[3]);
+    if (d.l6[0] >= 0)
+      info["hades.dv.l6"] = StringUtils::Format("{} / {}", d.l6[0], d.l6[1]);
+  }
+  if (native)
+  {
+    if (const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+        mode && mode->htotal && mode->vtotal)
+      info["hades.dv.mode"] = StringUtils::Format(
+          "{}x{} @ {:.3f} Hz", mode->hdisplay, mode->vdisplay,
+          mode->clock * 1000.0 / (static_cast<double>(mode->htotal) * mode->vtotal));
+    if (m_dvLastWindow.valid)
+    {
+      info["hades.dv.shown"] = std::to_string(m_dvLastWindow.shown);
+      info["hades.dv.notshown"] = std::to_string(m_dvLastWindow.notShown);
+      info["hades.dv.gap"] = StringUtils::Format("{:.0f}", m_dvLastWindow.gapMaxMs);
+      info["hades.dv.l1changes"] = std::to_string(m_dvLastWindow.l1Changes);
+    }
+  }
+  for (const auto& [key, value] : info)
+  {
+    auto& published = m_dvPublished[key];
+    if (published != value)
+    {
+      home->SetProperty(key, value);
+      published = value;
+    }
+  }
+}
