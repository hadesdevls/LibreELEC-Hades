+  m_dvLastWindow.notShown = m_dvStats.notShown;
+  m_dvLastWindow.gapMaxMs = m_dvStats.gapMaxMs;
+  m_dvLastWindow.l1Changes = m_dvBridge ? m_dvBridge->TakeL1Changes() : 0;
   // Keep measuring the gap across the period boundary.
   const auto lastShown = m_dvStats.lastShown;
   const bool hasLastShown = m_dvStats.hasLastShown;
