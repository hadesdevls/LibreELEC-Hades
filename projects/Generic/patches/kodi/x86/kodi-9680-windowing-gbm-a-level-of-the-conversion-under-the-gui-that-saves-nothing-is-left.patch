From 8d2b7a54811f1ac6a76798efc2c9b44e27e194dc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:08:33 +0000
Subject: [PATCH] windowing/gbm: a level of the conversion under the GUI that
 saves nothing is left

CDVGuiLevel raised the level of the conversion under the GUI where frames with GUI
elements did not keep up, and kept it. Where a level takes no less than the level
below took (a report from an Iris Xe had level 1 at 39.5 ms where level 0 took 35.0 ms) it
costs memory (level 1: 132.7 MB) or fidelity (level 2: a code in near-ties) for
nothing. The first window at a raised level is now compared with what the level
below took; at 95 % of it or more, the level below comes back (NO_GAIN, logged
with both figures) and the level that saved nothing is not raised to again for
five minutes of film, since the GUI and the picture change.

Level 2 is the one that changes bytes under the GUI: raising to it is now logged
as a warning.

Host test (outside the tree): dvguilevel_test with the new cases: a level that
takes 98, 96 or 97.5 % of the one below is left, one that takes 89 % is kept, and
a level that was left is raised to again only after its wait.
---
 xbmc/windowing/gbm/DVGuiLevel.h               | 40 +++++++++++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 15 +++++--
 2 files changed, 49 insertions(+), 6 deletions(-)

diff --git a/xbmc/windowing/gbm/DVGuiLevel.h b/xbmc/windowing/gbm/DVGuiLevel.h
index f70525d..947d1e4 100644
--- a/xbmc/windowing/gbm/DVGuiLevel.h
+++ b/xbmc/windowing/gbm/DVGuiLevel.h
@@ -54,7 +54,10 @@ namespace GBM
  * up.
  *
  * Raised: the first window at the new level says what it takes for what the level below took (the
- * window that raised it). Down again by one only when the level below would take, by that, no more
+ * window that raised it). If it takes no less than NO_GAIN of what the level below took, the level
+ * saves nothing (level 1 costs 132.7 MB, level 2 changes bytes): it is left at once, and not raised
+ * to again for NO_GAIN_WAIT measured frames; a level is never kept for nothing, as CDVGuiStep does
+ * not keep a level that is not measured to save time. Down again by one only when the level below would take, by that, no more
  * than RELEASE_AHEAD or RELEASE_WAITING of the period (room to spare below the marks), and only
  * RELEASE_WAIT measured frames after the level was reached; where a level has to be raised to
  * again after coming down from it, before the level below kept up for as long, its wait doubles.
@@ -76,6 +79,9 @@ public:
     NONE,
     UP, //!< the frames did not keep up at the level below: this one from now on
     DOWN, //!< the level below would fit with room to spare: back to it
+    //! the level above took no less than the level below had taken: it saves nothing, and the
+    //! level below comes back (the level above is not raised to again for NO_GAIN_WAIT frames)
+    NO_GAIN,
   };
 
   struct Step
@@ -91,7 +97,7 @@ public:
     unsigned int over = 0;
     unsigned int presented = 0;
     unsigned int lost = 0;
-    double estimateMs = 0; //!< DOWN: what the level below would take now
+    double estimateMs = 0; //!< DOWN: what the level below would take now; NO_GAIN: what it took
   };
 
   //! A frame with GUI elements of that format is to be drawn: at which level (0 where not known)
@@ -195,6 +201,13 @@ private:
   //! to be raised to again, up to about an hour of film
   static constexpr unsigned int RELEASE_WAIT = 1440;
   static constexpr unsigned int RELEASE_MAX_WAIT = 64 * RELEASE_WAIT;
+  //! a level that took this part of what the level below took or more (the window raised it for) saves
+  //! nothing worth its cost: the window after a raise is as long as any other, and the first
+  //! window's own noise is a few per cent
+  static constexpr double NO_GAIN = 0.95;
+  //! measured frames before a level that saved nothing is raised to again (conditions change: the
+  //! GUI over the picture, the picture)
+  static constexpr unsigned int NO_GAIN_WAIT = 5 * RELEASE_WAIT;
 
   struct Window
   {
@@ -226,6 +239,8 @@ private:
     unsigned int sinceLevel = 0; //!< measured frames at its level since it was reached
     std::array<unsigned int, LEVELS> wait{0, RELEASE_WAIT, RELEASE_WAIT};
     unsigned int behind = 0; //!< windows in a row that were behind
+    //! measured frames still to pass before each level may be raised to again (it saved nothing)
+    std::array<unsigned int, LEVELS> blocked{};
     unsigned int skip = SKIP;
     Window window;
 
@@ -310,6 +325,8 @@ private:
     step.presented = w.presented;
     step.lost = w.lost;
 
+    for (unsigned int& b : f.blocked)
+      b = b > w.count ? b - w.count : 0;
     const bool known = w.presented >= KNOWN_MIN;
     const bool missed = w.lost >= Mark(w.presented);
     bool behind = false;
@@ -327,18 +344,35 @@ private:
 
     const int level = f.level;
     // raised: the first window at it says what it takes for what the level below took
+    bool noGain = false;
     if (f.justUp)
     {
       f.justUp = false;
       if (level > 0 && f.knownMs[level - 1] > 0 && average > 0)
+      {
         f.ratio[level - 1] = f.knownMs[level - 1] / average;
+        noGain = average >= NO_GAIN * f.knownMs[level - 1];
+      }
+    }
+    // it took no less than the level below took: back to it, and not raised to again for a while
+    // (not on a window that was behind by a margin that the level above could not have: a level
+    // above that takes more than the one below is at best a mistake of the first window's)
+    if (noGain)
+    {
+      step.estimateMs = f.knownMs[level - 1];
+      f.blocked[level] = NO_GAIN_WAIT;
+      f.knownMs[level] = average;
+      f.downFrom = 0;
+      f.behind = 0;
+      return To(f, level - 1, Change::NO_GAIN, step);
     }
     f.knownMs[level] = average;
 
     if (behind)
     {
       // frame ahead comes first; one window could have been slow for another reason
-      if (level >= top || w.pace == Pace::PENDING || (!beyond && ++f.behind < 2))
+      if (level >= top || w.pace == Pace::PENDING || f.blocked[level + 1] > 0 ||
+          (!beyond && ++f.behind < 2))
         return step;
       f.behind = 0;
       // it came down from the level above and does not keep up after all: that level waits
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 2773cd5..34a42fe 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -7411,17 +7411,26 @@ void CWinSystemGbmGLESContext::DVGuiLevelReport(const CDVGuiLevel::Step& step,
                                 "of {} refreshes missed",
                                 step.over, step.frames, step.budgetMs, step.lost, step.presented);
   // the targets of the levels are freed when no format needs them
-  const bool freed = step.change == Change::DOWN && step.to == 0 && !m_dvGuiLevel.Above();
+  const bool freed = (step.change == Change::DOWN || step.change == Change::NO_GAIN) &&
+                     step.to == 0 && !m_dvGuiLevel.Above();
   if (freed && m_dvBridge)
     m_dvBridge->ReleaseGui();
-  if (step.change == Change::UP && step.to == 1)
+  if (step.change == Change::NO_GAIN)
+    CLog::Log(LOGINFO,
+              "DVBridge: P5 frames with GUI elements: level {} took {:.1f} ms of {:.1f} ms, not "
+              "less than level {} had taken ({:.1f} ms): it saves nothing, and the conversion under "
+              "the GUI is at level {} again{} ({}; {})",
+              step.from, step.averageMs, step.periodMs, step.to, step.estimateMs, step.to,
+              freed ? ", and the targets of the conversion are freed" : "", which, window);
+  else if (step.change == Change::UP && step.to == 1)
     CLog::Log(LOGINFO,
               "DVBridge: P5 frames with GUI elements: {:.1f} ms of {:.1f} ms, the conversion under "
               "the GUI takes the picture under each pixel from its own pass from now on (the same "
               "bytes, 132.7 MB more) ({}; {})",
               step.averageMs, step.periodMs, which, window);
   else if (step.change == Change::UP)
-    CLog::Log(LOGINFO,
+    // (a warning: from here the bytes under the GUI are not those of the exact conversion)
+    CLog::Log(LOGWARNING,
               "DVBridge: P5 frames with GUI elements: {:.1f} ms of {:.1f} ms, the rounding of the "
               "conversion under the GUI is simplified (at most 1 code in near-ties) from now on; "
               "the frames without GUI elements and the pixels not drawn over are as before ({}; "
-- 
2.53.0

