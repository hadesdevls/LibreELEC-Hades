 using namespace VAAPI;
 
+namespace
+{
+
+constexpr const char* MODIFIERS_EXTENSION = "EGL_EXT_image_dma_buf_import_modifiers";
+
+/*!
+ * \brief Hades: one layer of a VA surface exported as DRM PRIME (vaExportSurfaceHandle(), separate
+ *        layers of one plane each), as the EGL image of a picture of a given size takes it
+ *
+ * One description for the probe of the formats (CVaapi2Texture::TestEsh()) and for the import of
+ * each picture (CVaapi2Texture::Import()), so that a format is offered where its pictures import.
+ * The probe made attributes of its own: of the first layer alone, without the modifier of the
+ * surface, and without the layout that the import gives packed 4:2:2. With a driver that exports a
+ * layout other than linear, it could fail where the import works, and Kodi was left without its
+ * VAAPI renderer, or without 10-bit video in it (RendererVAAPIGLES::Register(),
+ * RendererVAAPIGL::Register()); or pass where the import does not.
+ */
+struct LayerImport
+{
+  EGLint fourcc = 0;
+  EGLint width = 0;
+  EGLint height = 0;
+  int fd = -1;
+  uint32_t offset = 0;
+  uint32_t pitch = 0;
+  uint64_t modifier = DRM_FORMAT_MOD_INVALID;
+};
+
+enum class LayerFault
+{
+  NONE,
+  PLANES, //!< the layer has more than one plane
+  OBJECT, //!< its plane names an object that the surface does not have
+  LAYERS, //!< the surface has a number of layers that is not imported (one or two are)
+};
+
+LayerFault DescribeLayer(const VADRMPRIMESurfaceDescriptor& surface,
+                         uint32_t layerNo,
+                         EGLint width,
+                         EGLint height,
+                         LayerImport& out)
+{
+  auto const& layer = surface.layers[layerNo];
+  if (layer.num_planes != 1)
+    return LayerFault::PLANES;
+  // Driver-supplied object_index is untrusted; reject OOB before indexing (Hades: of the objects
+  // that the descriptor can hold, too).
+  if (layer.object_index[0] >= surface.num_objects ||
+      layer.object_index[0] >= std::size(surface.objects))
+    return LayerFault::OBJECT;
+  if (surface.num_layers != 1 && surface.num_layers != 2)
+    return LayerFault::LAYERS;
+  auto const& object = surface.objects[layer.object_index[0]];
+
+  // Single-plane packed formats (YUY2, Y210/Y212/Y216) have one layer, bound to m_y: the DMA-BUF
+  // carries Y/Cb/Y/Cr (or wider) interleaved, and the shader (XBMC_Y210 in
+  // gles_yuv2rgb_basic.frag) decodes the packed layout. With two, the second is the chroma.
+  out.fourcc = static_cast<EGLint>(layer.drm_format);
+  out.width = width;
+  out.height = height;
+  if (surface.num_layers == 2 && layerNo == 1 &&
+      (surface.fourcc == VA_FOURCC_NV12 || surface.fourcc == VA_FOURCC_P010 ||
+       surface.fourcc == VA_FOURCC_P012 || surface.fourcc == VA_FOURCC_P016))
+  {
+    // Adjust w/h for 4:2:0 subsampling on UV plane
+    out.width = (width + 1) >> 1;
+    out.height = (height + 1) >> 1;
+  }
+
+  // Mesa Y210 / Y212 / Y216 import quirk: Mesa imports those DRM fourccs
+  // as a two-plane internal layout (RG_UNORM16 luma + RGBA16 chroma)
+  // whose chroma plane is only reachable via the samplerExternalOES NIR
+  // lowering pass. sampler2D sees only the luma plane (RG with B=0 and
+  // A=1), losing chroma. Re-import the same DMA-BUF as a flat
+  // ABGR16161616 texture at half width so sampler2D returns the four
+  // 16-bit slots Y0 / Cb / Y1 / Cr directly.
+  if (surface.fourcc == VA_FOURCC_Y210 || surface.fourcc == VA_FOURCC_Y212 ||
+      surface.fourcc == VA_FOURCC_Y216)
+  {
+    out.fourcc = DRM_FORMAT_ABGR16161616;
+    out.width = (out.width + 1) >> 1;
+  }
+
+  out.fd = object.fd;
+  out.offset = layer.offset[0];
+  out.pitch = layer.pitch[0];
+  out.modifier = object.drm_format_modifier;
+  return LayerFault::NONE;
+}
+
+/*!
+ * \brief The attributes of the EGL image of a layer
+ *
+ * The modifier of its object goes with them where EGL takes modifiers (MODIFIERS_EXTENSION), linear
+ * too. DRM_FORMAT_MOD_INVALID is no layout but the driver's word that it gives none: it is never
+ * passed as a modifier, and the buffer is imported with the layout it has of its own. A layout with
+ * a modifier other than linear where EGL takes no modifiers is not imported (nothing): EGL would
+ * take the buffer without its layout. The bridge decides the same
+ * (tools/dvbridge/dvbridge_dmabuf.c, make_planes()).
+ */
+std::optional<CEGLAttributes<8>> ImportAttributes(const LayerImport& layer, bool modifiers)
+{
+  if (!modifiers && layer.modifier != DRM_FORMAT_MOD_INVALID &&
+      layer.modifier != DRM_FORMAT_MOD_LINEAR)
+    return std::nullopt;
+
+  CEGLAttributes<8> attribs; // 6 static + 2 modifiers
+  attribs.Add({{EGL_LINUX_DRM_FOURCC_EXT, layer.fourcc},
+               {EGL_WIDTH, layer.width},
+               {EGL_HEIGHT, layer.height},
+               {EGL_DMA_BUF_PLANE0_FD_EXT, layer.fd},
+               {EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLint>(layer.offset)},
+               {EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(layer.pitch)}});
+  if (modifiers && layer.modifier != DRM_FORMAT_MOD_INVALID)
+    attribs.Add(
+        {{EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, static_cast<EGLint>(layer.modifier & 0xffffffffu)},
+         {EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, static_cast<EGLint>(layer.modifier >> 32)}});
+  return attribs;
+}
+
+} // namespace
+
 void CVaapi2Texture::Init(InteropInfo& interop)
 {
   m_interop = interop;
-  m_hasPlaneModifiers = CEGLUtils::HasExtension(m_interop.eglDisplay, "EGL_EXT_image_dma_buf_import_modifiers");
+  m_hasPlaneModifiers = CEGLUtils::HasExtension(m_interop.eglDisplay, MODIFIERS_EXTENSION);
 }
 
