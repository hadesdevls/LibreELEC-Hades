From fe6201ad1c1010ec927be8912c0f1ae06e2a0a47 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 16:35:05 +0000
Subject: [PATCH] [Video] Look a refreshed movie up by the ids it already has.

A refresh with nobody to choose from what a search finds, such as a
refresh of a whole source, searched for the movie by its title and took
the first result. A movie whose folder named it ambiguously came back
as another film, losing an identification the user had corrected.

Without an nfo, such a refresh now looks the movie up with a python
scraper by the ids it already has. A scraper that can't is searched as
before, but a result whose ids contradict the stored ones is refused,
as the lookup may have failed for a dropped connection. A refresh from
the information dialog still searches, so that the user can choose.

The ids also come before an identifier in the file name, such as
{tmdb=200}, which may name another film than the one whose details the
refresh read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoInfoScanner.cpp               | 12 ++++-
 xbmc/video/VideoInfoScanner.h                 | 10 ++++
 xbmc/video/jobs/VideoLibraryRefreshingJob.cpp | 46 +++++++++++++++++--
 3 files changed, 63 insertions(+), 5 deletions(-)

diff --git a/xbmc/video/VideoInfoScanner.cpp b/xbmc/video/VideoInfoScanner.cpp
index 114e45a..cab67e5 100644
--- a/xbmc/video/VideoInfoScanner.cpp
+++ b/xbmc/video/VideoInfoScanner.cpp
@@ -1637,7 +1637,10 @@ CVideoInfoScanner::~CVideoInfoScanner()
 
     std::string identifierType;
     std::string identifier;
-    if (info2->IsPython() && filenameAttributes.GetIdentifier(identifierType, identifier))
+    // The ids a refresh looks the movie up by come first: an identifier in the file name may name
+    // another film, and the ids are those its details were already read by
+    if (info2->IsPython() && m_movieUniqueIDs.empty() &&
+        filenameAttributes.GetIdentifier(identifierType, identifier))
     {
       const ADDON::CScraper::UniqueIDs uniqueIDs{{identifierType, identifier}};
       if (GetDetails(pItem, uniqueIDs, url, info2,
@@ -1647,6 +1650,13 @@ CVideoInfoScanner::~CVideoInfoScanner()
         return HandleMovieSetAndVersions();
     }
 
+    if (info2->IsPython() && !m_movieUniqueIDs.empty() && !(pURL && pURL->HasUrls()) &&
+        GetDetails(pItem, m_movieUniqueIDs, url, info2,
+                   (result == InfoType::COMBINED || result == InfoType::OVERRIDE) ? loader.get()
+                                                                                  : nullptr,
+                   pDlgProgress))
+      return HandleMovieSetAndVersions();
+
     if (pURL && pURL->HasUrls())
       url = *pURL;
     else if ((retVal = FindVideo(movieTitle, movieYear, info2, url, pDlgProgress)) <= 0)
diff --git a/xbmc/video/VideoInfoScanner.h b/xbmc/video/VideoInfoScanner.h
index e60bc11..3362e47 100644
--- a/xbmc/video/VideoInfoScanner.h
+++ b/xbmc/video/VideoInfoScanner.h
@@ -132,6 +132,13 @@ namespace KODI::VIDEO
       m_scraperCache.insert(scrapers.begin(), scrapers.end());
     }
 
+    /*! \brief Look the movies up by these ids with a python scraper, rather than search for them.
+     */
+    void LookUpMoviesBy(const ADDON::CScraper::UniqueIDs& uniqueIDs)
+    {
+      m_movieUniqueIDs = uniqueIDs;
+    }
+
     static bool DownloadFailed(CGUIDialogProgress* pDlgProgress);
 
     /*! \brief Update the set information from a SET.NFO in the Movie Set Information Folder
@@ -352,6 +359,9 @@ namespace KODI::VIDEO
     SimilarVideoScanAction m_similarVideoAction{SimilarVideoScanAction::NONE};
     bool m_ignoreVideoExtras{false};
 
+    //! The ids RetrieveVideoInfo() looks movies up by, where it would otherwise search
+    ADDON::CScraper::UniqueIDs m_movieUniqueIDs;
+
     //! Whether the folder a movie is in names it (the scraper's "movies are in separate folders")
     bool m_useFolderNames{false};
 
diff --git a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
index d24b602..94c0994 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingJob.cpp
@@ -221,6 +221,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
   // run this in a loop in case we need to refresh again
   bool failure = false;
+  bool lookUpByIds{true};
   // a title the user enters is searched for in place of one embedded in the file
   bool useEmbeddedTitle{m_searchTitle.empty()};
   do
@@ -319,8 +320,23 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     if (scraper->Content() == ADDON::ContentType::TVSHOWS && !m_item->IsFolder())
       hasDetails = true;
 
+    // Without anyone to choose from what a search finds, a movie is looked up by the ids it already
+    // has, as a search by its title may find another
+    CScraper::UniqueIDs uniqueIDs;
+    if (lookUpByIds && !hasDetails && !IsModal() && m_searchTitle.empty() && scraper->IsPython() &&
+        scraper->Content() == ADDON::ContentType::MOVIES && m_item->HasVideoInfoTag())
+    {
+      for (const auto& [type, value] : m_item->GetVideoInfoTag()->GetUniqueIDs())
+      {
+        if (!value.empty())
+          uniqueIDs.try_emplace(type, value);
+      }
+      if (!uniqueIDs.empty())
+        scraper->ClearCache();
+    }
+
     // if we don't have an url or need to refresh anyway do the web search
-    if (!hasDetails && (needsRefresh || !scraperUrl.HasUrls()))
+    if (!hasDetails && uniqueIDs.empty() && (needsRefresh || !scraperUrl.HasUrls()))
     {
       SetTitle(StringUtils::Format(
           CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(197), scraper->Name()));
@@ -416,7 +432,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
     // if the URL is still empty, check whether or not we're allowed
     // to prompt and ask the user to input a new search title
-    if (!hasDetails && !scraperUrl.HasUrls())
+    if (!hasDetails && uniqueIDs.empty() && !scraperUrl.HasUrls())
     {
       // a local scraper has nothing to search, so another title cannot help and asking for one
       // would only bring us back here
@@ -443,7 +459,8 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
 
     // A movie is removed before it is added again, so its details are read first. One the scraper
     // can't give them for, as when its site doesn't answer, is left as it is.
-    if (scraper->Content() == ADDON::ContentType::MOVIES && scraperUrl.HasUrls())
+    if (scraper->Content() == ADDON::ContentType::MOVIES &&
+        (scraperUrl.HasUrls() || !uniqueIDs.empty()))
     {
       // the search closed a modal progress dialog, and the download pumps the GUI through it
       SetTitle(CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(198));
@@ -451,14 +468,34 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
       SetProgress(0);
 
       CVideoInfoTag details;
-      if (!CVideoInfoDownloader(scraper).GetDetails({}, scraperUrl, details, GetProgressDialog()))
+      if (!CVideoInfoDownloader(scraper).GetDetails(uniqueIDs, scraperUrl, details,
+                                                    GetProgressDialog()))
       {
+        // A scraper that can't look the movie up by its ids is searched for it as before
+        if (!uniqueIDs.empty())
+        {
+          lookUpByIds = false;
+          needsRefresh = true;
+          continue;
+        }
         CLog::Log(LOGWARNING,
                   "CVideoLibraryRefreshingJob: no details found for '{}', so it is left as it is",
                   CURL::GetRedacted(m_item->GetPath()));
         failure = true;
         break;
       }
+
+      // The search made when the ids lookup failed may have found another film
+      if (!lookUpByIds && m_item->HasVideoInfoTag() &&
+          m_item->GetVideoInfoTag()->HasConflictingUniqueID(details))
+      {
+        CLog::Log(LOGWARNING,
+                  "CVideoLibraryRefreshingJob: the details found for '{}' are of another film by "
+                  "their ids, so it is left as it is",
+                  CURL::GetRedacted(m_item->GetPath()));
+        failure = true;
+        break;
+      }
     }
 
     // before we start downloading all the necessary information cleanup any existing artwork and hashes
@@ -615,6 +652,7 @@ bool CVideoLibraryRefreshingJob::Work(CVideoDatabase &db)
     // finally download the information for the item
     VIDEO::CVideoInfoScanner scanner;
     scanner.UseScrapers(scrapers);
+    scanner.LookUpMoviesBy(uniqueIDs);
     if (!scanner.RetrieveVideoInfo(items, scanSettings.parent_name,
                                    scraper->Content(), !ignoreNfo,
                                    scraperUrl.HasUrls() ? &scraperUrl : nullptr,
-- 
