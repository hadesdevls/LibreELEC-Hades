index 0000000..427f341
--- /dev/null
+++ b/xbmc/utils/PlayerInfoPublishing.h
@@ -0,0 +1,72 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <chrono>
+
+namespace KODI::UTILS::PLAYERINFO
+{
+
+//! The property of the Home window that "Check this setup" (the LibreELEC settings add-on) sets to
+//! "1" while it plays its clips, and takes away when it is done
+constexpr const char* CHECK_RUNNING_PROPERTY = "hades.check.running";
+
+//! What of the player information is published at a frame: its values (the hades.out.*,
+//! hades.audio.*, hades.video.*, hades.play.* and hades.sum.* properties of the Home window), the
+//! readings of the GPU that draws (hades.sys.gpu*, which a thread of their own reads from the card),
+//! and the light that a value which has just changed gets on the page
+struct Publishing
+{
+  bool values{false};
+  bool gpuReadings{false};
+  bool flash{false};
+};
+
+/*!
+ * \brief What is published: everything while the page of the player information is shown; the
+ *        values only while "Check this setup" plays one of its clips and reads what the page would
+ *        say of it (the GPU is not read for it, and nothing is lit); nothing otherwise
+ */
+inline Publishing PublishingFor(bool pageShown, bool checkRunning)
+{
+  return {pageShown || checkRunning, pageShown, pageShown};
+}
+
+/*!
+ * \brief A flag that is looked at no more often than every PERIOD, what was read being given back
+ *        until then: for a property that an add-on sets on a window, read from the thread that draws
+ *        at every frame
+ */
+class CPolledFlag
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  static constexpr std::chrono::milliseconds PERIOD{500};
+
+  //! \param read looks at the flag: at the first call, and then once PERIOD has passed since it
+  //!        last did
+  template<typename Read>
+  bool Get(Clock::time_point now, Read&& read)
+  {
+    if (!m_read || now - m_readTime >= PERIOD)
+    {
+      m_value = read();
+      m_read = true;
+      m_readTime = now;
+    }
+    return m_value;
+  }
+
+private:
+  bool m_read{false};
+  bool m_value{false};
+  Clock::time_point m_readTime{};
+};
+
+} // namespace KODI::UTILS::PLAYERINFO
