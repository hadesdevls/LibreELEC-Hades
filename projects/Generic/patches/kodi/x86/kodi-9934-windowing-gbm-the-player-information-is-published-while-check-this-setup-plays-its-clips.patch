diff --git a/xbmc/utils/test/TestPlayerInfoPublishing.cpp b/xbmc/utils/test/TestPlayerInfoPublishing.cpp
new file mode 100644
index 0000000..f9e0e6b
--- /dev/null
+++ b/xbmc/utils/test/TestPlayerInfoPublishing.cpp
@@ -0,0 +1,79 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "utils/PlayerInfoPublishing.h"
+
+#include <string>
+
+#include <gtest/gtest.h>
+
+using namespace KODI::UTILS::PLAYERINFO;
+using namespace std::chrono_literals;
+
+TEST(TestPlayerInfoPublishing, What)
+{
+  // nothing reads the values: nothing is published (the cost of the page is not paid)
+  const Publishing none = PublishingFor(false, false);
+  EXPECT_FALSE(none.values);
+  EXPECT_FALSE(none.gpuReadings);
+  EXPECT_FALSE(none.flash);
+  // the page: everything
+  const Publishing page = PublishingFor(true, false);
+  EXPECT_TRUE(page.values);
+  EXPECT_TRUE(page.gpuReadings);
+  EXPECT_TRUE(page.flash);
+  // Check this setup: the values, but the GPU is not read for it and nothing is lit
+  const Publishing check = PublishingFor(false, true);
+  EXPECT_TRUE(check.values);
+  EXPECT_FALSE(check.gpuReadings);
+  EXPECT_FALSE(check.flash);
+  // both: the page has all it has
+  const Publishing both = PublishingFor(true, true);
+  EXPECT_TRUE(both.values);
+  EXPECT_TRUE(both.gpuReadings);
+  EXPECT_TRUE(both.flash);
+  EXPECT_EQ(std::string("hades.check.running"), std::string(CHECK_RUNNING_PROPERTY));
+}
+
+TEST(TestPlayerInfoPublishing, PolledFlag)
+{
+  CPolledFlag flag;
+  int reads = 0;
+  bool value = true;
+  const auto read = [&] {
+    ++reads;
+    return value;
+  };
+  const CPolledFlag::Clock::time_point t0{std::chrono::seconds(100)};
+  // the first call looks
+  EXPECT_TRUE(flag.Get(t0, read));
+  EXPECT_EQ(1, reads);
+  // within the period: what was read, without looking
+  value = false;
+  EXPECT_TRUE(flag.Get(t0 + 1ms, read));
+  EXPECT_TRUE(flag.Get(t0 + 499ms, read));
+  EXPECT_EQ(1, reads);
+  // once the period has passed: it looks again
+  EXPECT_FALSE(flag.Get(t0 + 500ms, read));
+  EXPECT_EQ(2, reads);
+  // at every frame for ten seconds (60 Hz): looked at twice a second, no more
+  int frames = 0;
+  for (auto t = t0 + 500ms; t < t0 + 10500ms; t += std::chrono::microseconds(16667), ++frames)
+    flag.Get(t, read);
+  EXPECT_EQ(600, frames);
+  EXPECT_TRUE(reads >= 2 + 19 && reads <= 2 + 20);
+  // the first call looks whatever the clock says, even right at its start
+  CPolledFlag early;
+  int earlyReads = 0;
+  EXPECT_TRUE(early.Get(CPolledFlag::Clock::time_point{} + 1ms,
+                        [&] {
+                          ++earlyReads;
+                          return true;
+                        }));
+  EXPECT_EQ(1, earlyReads);
+}
