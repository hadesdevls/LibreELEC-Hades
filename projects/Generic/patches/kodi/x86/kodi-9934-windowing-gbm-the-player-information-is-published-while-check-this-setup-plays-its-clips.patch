   m_playerInfoShown = shown;
@@ -10528,7 +10541,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
       {"hades.video.api", ""}};
   double modeHz = 0.0; // the refresh rate of the mode that is set
