diff --git a/xbmc/utils/HDR10PlusVsif.h b/xbmc/utils/HDR10PlusVsif.h
index a91c746..367ef74 100644
--- a/xbmc/utils/HDR10PlusVsif.h
+++ b/xbmc/utils/HDR10PlusVsif.h
@@ -194,6 +194,33 @@ inline std::optional<Payload> MakeVsif(const AVDynamicHDRPlus& m, const char** w
   return p;
 }
 
+/*!
+ * \brief Hades: what a payload says, for the player information: the values as the InfoFrame
+ *        codes them (the layout of MakeVsif()), in cd/m2
+ */
+struct Shown
+{
+  unsigned int version = 0; //!< application version (PB4)
+  unsigned int target = 0; //!< targeted system display maximum luminance: 0 not given; 992 means
+                           //!< 976 or more (the code is in units of 32, 31 at most)
+  unsigned int average = 0; //!< average_maxrgb, in units of 16 (PB5)
+  unsigned int p99 = 0; //!< the 99th percentile of maxRGB (the ninth place, PB14), in units of 16
+  unsigned int anchors = 0; //!< the Bezier curve anchors of the tone mapping, 0 for none
+  bool overlay = false; //!< the graphics overlay flag (PB27, bit 7)
+};
+
+inline Shown Describe(const Payload& p)
+{
+  Shown s;
+  s.version = p[3] >> 6;
+  s.target = ((p[3] >> 1) & 0x1F) * 32u;
+  s.average = p[4] * 16u;
+  s.p99 = p[13] * 16u;
+  s.anchors = p[14] >> 4;
+  s.overlay = (p[26] & 0x80) != 0;
+  return s;
+}
+
 /*!
  * \brief The payload with the graphics overlay flag (PB27, bit 7) set where overlay is true:
  *        the picture sent holds graphics composed over the video, which the metadata does not
diff --git a/xbmc/windowing/gbm/HDR10PlusOutput.h b/xbmc/windowing/gbm/HDR10PlusOutput.h
index f11e1c7..3184f74 100644
--- a/xbmc/windowing/gbm/HDR10PlusOutput.h
+++ b/xbmc/windowing/gbm/HDR10PlusOutput.h
@@ -117,10 +117,30 @@ public:
   {
     m_queued = payload;
     m_recent[m_next] = value;
+    m_recentPayloads[m_next] = payload;
     m_next = (m_next + 1) % m_recent.size();
     m_pending = true;
   }
 
