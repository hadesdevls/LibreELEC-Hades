From b1dd22bdb6a2c0dbc756a3f6092133567a325a1b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:30:00 +0000
Subject: [PATCH] strings: give back the empty translation of six English
 entries that a merge left without one

The English files of the core and of Estuary have an empty msgstr for every entry. Where the
strings of several fronts were joined at the end of the files (the help of the setting of HDR over
the tunnel, 41401 and 33001; of the one that keeps an NVIDIA card at full speed, 41851 and
32951; and the DVD and folder read error, 41800 and 33800), three entries of each file lost their
msgstr line, which makes the file malformed: Kodi would not read what follows. Each now has its
empty msgstr, as the file it came from had.
---
 addons/resource.language.en_gb/resources/strings.po            | 3 +++
 .../skin.estuary/language/resource.language.en_gb/strings.po   | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 98ca0b3..ca164b3 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -27393,6 +27393,7 @@ msgstr ""
 #: system/settings/settings.xml
 msgctxt "#41401"
 msgid "At 3840x2160 and 50 or 60 Hz, HDMI 2.0 does not carry RGB at 10 bits, so the graphics driver sends HDR as YCbCr 4:2:0 at 10 bits (or RGB at 8 bits). With this on, an HDR10, HLG or HDR10+ video goes out as YCbCr 4:2:2 at 12 bits instead, inside the RGB 8-bit signal that Dolby Vision uses, with its HDR metadata as always: the colour of what Kodi draws over the video (subtitles, the on-screen display) keeps twice the detail, and the video is carried exactly. It is used only where the display says it takes 4:2:2, the driver can send it and nothing else has the output (Intel and AMD graphics); anything it cannot take goes out as before, and the log says why. It applies with the next video. Off: HDR always goes out as before."
+msgstr ""
 
 #: system/settings/settings.xml
 #. Hades: label of setting "audiooutput.hadesgpuhold"; translated in Estuary (#32950)
@@ -27404,10 +27405,12 @@ msgstr ""
 #. Hades: help of setting "audiooutput.hadesgpuhold"; translated in Estuary (#32951)
 msgctxt "#41851"
 msgid "For an NVIDIA graphics card that sends the sound to the TV or the receiver over HDMI. While Dolby TrueHD, DTS-HD or Dolby Digital Plus (E-AC-3) is sent as it is, without Kodi decoding it (passthrough), the clocks of the card are held at their highest, and let go when the sound stops or Kodi closes. Try it if the sound cuts out for a moment every few seconds, mostly on a laptop that is on its charger: the card changes speed and the audio loses a few samples (the kernel log then says 'dma error'). While it is on, the card draws more power and gets warmer, and a card that does not allow it is left as it was: kodi.log says what happened. It takes effect when the next sound starts. Off by default."
+msgstr ""
 
 #: xbmc/platform/posix/filesystem/PosixDirectory.cpp
 #. Hades: core string #41800
 msgctxt "#41800"
 msgid "The list of this folder could not be read to its end ({}). Some of its files may be missing, so nothing is shown. This usually means that the disk or its file system is damaged: check the disk."
+msgstr ""
 
 msgstr ""
diff --git a/addons/skin.estuary/language/resource.language.en_gb/strings.po b/addons/skin.estuary/language/resource.language.en_gb/strings.po
index fc045e5..9ced222 100644
--- a/addons/skin.estuary/language/resource.language.en_gb/strings.po
+++ b/addons/skin.estuary/language/resource.language.en_gb/strings.po
@@ -3541,6 +3541,7 @@ msgstr ""
 #. Setting help: videoscreen.hadeshdr10tunnel (core #41401)
 msgctxt "#33001"
 msgid "At 3840x2160 and 50 or 60 Hz, HDMI 2.0 does not carry RGB at 10 bits, so the graphics driver sends HDR as YCbCr 4:2:0 at 10 bits (or RGB at 8 bits). With this on, an HDR10, HLG or HDR10+ video goes out as YCbCr 4:2:2 at 12 bits instead, inside the RGB 8-bit signal that Dolby Vision uses, with its HDR metadata as always: the colour of what Kodi draws over the video (subtitles, the on-screen display) keeps twice the detail, and the video is carried exactly. It is used only where the display says it takes 4:2:2, the driver can send it and nothing else has the output (Intel and AMD graphics); anything it cannot take goes out as before, and the log says why. It applies with the next video. Off: HDR always goes out as before."
+msgstr ""
 
 #. Hades: label of setting "audiooutput.hadesgpuhold" (core #41850)
 msgctxt "#32950"
@@ -3551,10 +3552,12 @@ msgstr ""
 #. Hades: help of setting "audiooutput.hadesgpuhold" (core #41851)
 msgctxt "#32951"
 msgid "For an NVIDIA graphics card that sends the sound to the TV or the receiver over HDMI. While Dolby TrueHD, DTS-HD or Dolby Digital Plus (E-AC-3) is sent as it is, without Kodi decoding it (passthrough), the clocks of the card are held at their highest, and let go when the sound stops or Kodi closes. Try it if the sound cuts out for a moment every few seconds, mostly on a laptop that is on its charger: the card changes speed and the audio loses a few samples (the kernel log then says 'dma error'). While it is on, the card draws more power and gets warmer, and a card that does not allow it is left as it was: kodi.log says what happened. It takes effect when the next sound starts. Off by default."
+msgstr ""
 
 #: xbmc/platform/posix/filesystem/PosixDirectory.cpp
 #. Hades: translated copy of core string #41800
 msgctxt "#33800"
 msgid "The list of this folder could not be read to its end ({}). Some of its files may be missing, so nothing is shown. This usually means that the disk or its file system is damaged: check the disk."
+msgstr ""
 
 msgstr ""
