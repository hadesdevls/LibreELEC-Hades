-        map->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ) return false;
-    uint64_t maximum=UINT64_C(1) << h->coef_log2_denom;
-    for (int c=0;c<3;c++) {
-        const AVDOVINLQParams *n=&map->nlq[c];
