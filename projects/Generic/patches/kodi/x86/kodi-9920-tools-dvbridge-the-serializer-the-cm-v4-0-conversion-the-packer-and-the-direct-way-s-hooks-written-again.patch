-            n->linear_deadzone_slope || n->linear_deadzone_threshold) return false;
+        map->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+        return false;
+    const uint64_t one = (uint64_t)1 << h->coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *q = &map->nlq[c];
+        if (q->nlq_offset || q->vdr_in_max != one || q->linear_deadzone_slope ||
+            q->linear_deadzone_threshold)
+            return false;
