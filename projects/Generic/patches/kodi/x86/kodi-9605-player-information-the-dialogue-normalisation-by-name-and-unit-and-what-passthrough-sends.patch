diff --git a/xbmc/cores/AudioEngine/Utils/AudioPresentation.h b/xbmc/cores/AudioEngine/Utils/AudioPresentation.h
index a421d58..d3368ac 100644
--- a/xbmc/cores/AudioEngine/Utils/AudioPresentation.h
+++ b/xbmc/cores/AudioEngine/Utils/AudioPresentation.h
@@ -18,7 +18,8 @@
 //
 // - AC-3: dialnorm of the bit stream information (ATSC A/52, 5.4.2.8; the position of the field
 //   after acmod as in 5.4.2), and the value as FFmpeg's decoder applies it (ac3dec.c: code n is
-//   -n dB, and the reserved code 0 is -31 dB). The frame must pass its CRC (the whole frame after
+//   -n dB, and the reserved code 0 is -31 dB). It is the level of the dialogue, below full scale
+//   (dBFS): a receiver lowers the sound by its distance to -31 dBFS (Dialnorm::Kind::LEVEL). The frame must pass its CRC (the whole frame after
 //   the syncword gives 0, as FFmpeg checks it).
 // - E-AC-3: dialnorm of the independent substream 0 (A/52 Annex E, E.1.2.2), or of the AC-3
 //   frame that comes first in a stream that has one (Blu-ray); the same value rule and CRC.
@@ -37,9 +38,10 @@
 //   16-channel meaning behind this. TrueHD's dialogue norm is not given: what its codes mean
 //   could not be read anywhere.
 // - DTS: DIALNORM of the core frame header (ETSI TS 102 114 V1.6.1, 5.4.2 table 5-1 and table
-//   5-20: VERNUM 7, -DIALNORM dB; VERNUM 6, -(16 + DIALNORM) dB; any other VERNUM says nothing),
-//   unless the frame has a Rev2 auxiliary data chunk (5.8.3), which takes priority: its
-//   DIALNORM_rev2aux (-n dB) when it has one and no DRC values before it (their number is that of
+//   5-20: VERNUM 7, -DIALNORM dB; VERNUM 6, -(16 + DIALNORM) dB; any other VERNUM says nothing).
+//   It is a gain, the dialogue normalisation gain (DNG) that a decoder applies to its output: 0 dB
+//   lowers nothing (Dialnorm::Kind::GAIN). A Rev2 auxiliary data chunk can carry its own,
+//   which takes priority (5.8.3): its DIALNORM_rev2aux (-n dB) when it has one and no DRC values before it (their number is that of
 //   subsubframes, not read here: then nothing), and otherwise the core's. The chunk's CRC is not
 //   checked (its definition was not read): a chunk is one whose size and fields fit in the frame.
 //   DTS:X: no bed or objects. The object audio of DTS:X is not in ETSI TS 102 114, and what the
@@ -108,10 +110,34 @@ struct Objects
   }
 };
 
+//! What a stream says of its dialogue normalisation: not the same thing in each format
+struct Dialnorm
+{
+  enum class Kind
+  {
+    LEVEL, //!< AC-3, E-AC-3: the level of the dialogue below full scale, dBFS (-1 to -31)
+    GAIN, //!< DTS: the dialogue normalisation gain that a decoder applies, dB (0 to -31)
+  };
+  Kind kind = Kind::LEVEL;
+  int value = 0;
+
+  //! The value with its unit: "-27 dBFS", "-10 dB"
+  std::string Text() const { return Text(value); }
+  //! Another value in this one's unit (what is sent in its place)
+  std::string Text(int other) const
+  {
+    return std::to_string(other) + (kind == Kind::LEVEL ? " dBFS" : " dB");
+  }
+  bool operator==(const Dialnorm& other) const
+  {
+    return kind == other.kind && value == other.value;
+  }
+};
+
 struct Facts
 {
   std::optional<Objects> objects;
-  std::optional<int> dialnorm; //!< dB (0 to -31)
+  std::optional<Dialnorm> dialnorm;
   bool operator==(const Facts& other) const
   {
     return objects == other.objects && dialnorm == other.dialnorm;
@@ -640,7 +666,7 @@ private:
       at += frame.bytes;
     }
     if (dialnorm)
-      facts.dialnorm = dialnorm;
+      facts.dialnorm = Dialnorm{Dialnorm::Kind::LEVEL, *dialnorm};
     if (!look || !eac3)
       return;
     if (objects)
@@ -687,7 +713,9 @@ private:
       const std::optional<int> dialnorm = DETAIL::ReadDTSCore(data + at, size - at, &bytes);
       if (bytes == 0)
         continue;
-      facts.dialnorm = dialnorm;
+      facts.dialnorm.reset();
+      if (dialnorm)
+        facts.dialnorm = Dialnorm{Dialnorm::Kind::GAIN, *dialnorm};
       return; // the first core frame of the packet
     }
   }
diff --git a/xbmc/cores/AudioEngine/Utils/DialnormOverride.h b/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
index 41cffe6..62b1d01 100644
--- a/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
+++ b/xbmc/cores/AudioEngine/Utils/DialnormOverride.h
@@ -644,12 +644,22 @@ public:
     m_lastAttenuation.reset();
     m_frames = 0;
     m_rewritten = 0;
+    m_last = {};
   }
 
   //! The demuxer's profile says Atmos (E-AC-3 + Dolby Atmos)
   void SetAtmos(bool atmos) { m_atmos = atmos; }
   bool Atmos() const { return m_atmos; }
 
+  //! What the last frame was sent with in place of the stream's own, in its unit (AC-3/E-AC-3
+  //! dialogue level -31 dBFS, DTS gain 0 dB); nothing if it went as it came
+  std::optional<int> Sent() const
+  {
+    if (!m_last.changed)
+      return {};
+    return m_last.codec == Codec::DTS ? 0 : -31;
+  }
+
   //! A frame as the passthrough codec has it; returns a line for the log when there is something
   //! new to say
   std::optional<std::string> Apply(uint8_t* data, size_t size)
@@ -665,6 +675,7 @@ public:
       r = m_rewriter.Rewrite(data, size);
     if (r.changed)
       ++m_rewritten;
+    m_last = r;
     return Say(r);
   }
 
@@ -712,6 +723,7 @@ private:
   std::optional<int> m_lastAttenuation;
   unsigned int m_frames = 0;
   unsigned int m_rewritten = 0;
+  SResult m_last;
