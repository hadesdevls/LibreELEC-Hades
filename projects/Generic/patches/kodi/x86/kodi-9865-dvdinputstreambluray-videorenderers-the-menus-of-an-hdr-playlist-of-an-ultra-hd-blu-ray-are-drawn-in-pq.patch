+#pragma once
+
+#include "PlatformDefs.h"
+
+#include <cstdint>
+
+namespace KODI::BLURAYGRAPHICS
+{
+/*!
+ * \brief (Hades) The range the graphics of a Blu-ray disc are made in: its menus (the interactive
+ * graphics of HDMV) and what its BD-J application draws
+ *
+ * A disc's graphics are made for the video they go over. On an Ultra HD Blu-ray whose playlist
+ * plays HDR10 or Dolby Vision video, the graphics are made the same way as its subtitles (PGS,
+ * which Kodi already takes as PQ there): BT.2020 colours in the ST 2084 (PQ) signal, so that the
+ * player lays them over the video as they are. Taken as sRGB, as Kodi took them, their white
+ * (about 200 cd/m2 in PQ) came out as a grey well under the GUI's white over HDR, and the colours
+ * were made wider a second time; on an SDR display they came out dark. The range is the one of
+ * the video the playlist gives (its STN table, dynamic_range_type), and, before a playlist is
+ * known (what a BD-J disc draws while it starts), the one the disc declares for its start
+ * (index.bdmv, initial_dynamic_range_type). An SDR playlist, or a Blu-ray before Ultra HD (whose
+ * fields are 0), keeps everything as it was.
+ */
+enum class Range
+{
+  SDR,
+  PQ,
+};
+
+//! The range of graphics made for a video of this dynamic_range_type (bd_dynamic_range_type_e:
+//! 0 SDR, 1 HDR10, 2 Dolby Vision; other values are reserved and taken as SDR)
+constexpr Range RangeOfVideo(uint8_t dynamicRangeType)
+{
+  return dynamicRangeType == 1 || dynamicRangeType == 2 ? Range::PQ : Range::SDR;
+}
+
+//! The text of a range for kodi.log
+constexpr const char* RangeName(Range range)
+{
+  return range == Range::PQ ? "PQ (BT.2020, ST 2084)" : "SDR";
+}
+
+namespace DETAIL
+{
+constexpr uint8_t Clamp(double v)
+{
+  return v > 255.0 ? 255 : (v < 0.0 ? 0 : static_cast<uint8_t>(v + 0.5));
+}
+
+constexpr uint32_t Pack(uint8_t t, double r, double g, double b)
+{
+  return static_cast<uint32_t>(t) << PIXEL_ASHIFT | static_cast<uint32_t>(Clamp(r)) << PIXEL_RSHIFT |
+         static_cast<uint32_t>(Clamp(g)) << PIXEL_GSHIFT |
+         static_cast<uint32_t>(Clamp(b)) << PIXEL_BSHIFT;
+}
+} // namespace DETAIL
+
+/*!
+ * \brief The colour of an entry of a palette of a disc's graphics (Y, Cr, Cb and its alpha T, as
+ * BD_PG_PALETTE_ENTRY has them), packed as Kodi's overlays are (PIXEL_*SHIFT)
+ *
+ * SDR: as Kodi has always converted them (BT.601 coefficients), byte for byte. PQ: with the
+ * coefficients of ITU-R BT.2020 (non-constant luminance, Kr 0.2627, Kb 0.0593), limited range, as
+ * the subtitles of the same video (FFmpeg's PGS decoder, told the video's BT.2020 matrix).
+ */
+constexpr uint32_t PaletteEntryToRGBA(uint8_t y, uint8_t cr, uint8_t cb, uint8_t t, Range range)
+{
+  if (range == Range::SDR)
+    return DETAIL::Pack(t, 1.164 * (y - 16) + 1.596 * (cr - 128),
+                        1.164 * (y - 16) - 0.391 * (cb - 128) - 0.813 * (cr - 128),
+                        1.164 * (y - 16) + 2.018 * (cb - 128));
+
+  constexpr double kr = 0.2627;
+  constexpr double kb = 0.0593;
+  constexpr double kg = 1.0 - kr - kb;
+  const double luma = 255.0 / 219.0 * (y - 16);
+  const double pb = 255.0 / 224.0 * (cb - 128);
+  const double pr = 255.0 / 224.0 * (cr - 128);
+  return DETAIL::Pack(t, luma + 2.0 * (1.0 - kr) * pr,
+                      luma - 2.0 * kb * (1.0 - kb) / kg * pb - 2.0 * kr * (1.0 - kr) / kg * pr,
+                      luma + 2.0 * (1.0 - kb) * pb);
+}
+} // namespace KODI::BLURAYGRAPHICS
