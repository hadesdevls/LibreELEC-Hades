+uint32_t LimitedRangeStraight(uint32_t px)
+{
+  const uint32_t r = (px >> PIXEL_RSHIFT) & 0xff;
+  const uint32_t g = (px >> PIXEL_GSHIFT) & 0xff;
+  const uint32_t b = (px >> PIXEL_BSHIFT) & 0xff;
