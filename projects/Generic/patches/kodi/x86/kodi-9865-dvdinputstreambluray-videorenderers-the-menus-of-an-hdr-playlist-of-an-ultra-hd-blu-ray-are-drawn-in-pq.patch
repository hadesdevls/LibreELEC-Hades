+
+#pragma once
+
+#include "PlatformDefs.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace OVERLAY
+{
+/*!
+ * \brief The colour arithmetic of picture overlays (PGS palettes, the graphics of a disc), on
+ * PIXEL_A/R/G/BSHIFT-packed colours that are not premultiplied (PlatformDefs.h)
+ *
+ * Hades: Kodi's own functions of OverlayRendererUtil.cpp, unchanged, in a header that a test can
+ * build without the rest of Kodi.
+ */
+namespace COLOUR
+{
+//! the steps of the table of sRGB codes of ConvertPQPixelsToSRGB() (Hades)
+constexpr int COARSE = 16384;
+
+constexpr float ST2084_m1 = 2610.0f / (4096.0f * 4.0f);
+constexpr float ST2084_m2 = (2523.0f / 4096.0f) * 128.0f;
+constexpr float ST2084_c1 = 3424.0f / 4096.0f;
+constexpr float ST2084_c2 = (2413.0f / 4096.0f) * 32.0f;
+constexpr float ST2084_c3 = (2392.0f / 4096.0f) * 32.0f;
+
+// PQ code value (0-1) -> linear (1.0 == 10000 nits).
+inline float DecodePQ(float x)
+{
+  x = std::clamp(x, 0.0f, 1.0f);
+  const float p = std::pow(x, 1.0f / ST2084_m2);
+  const float num = std::max(p - ST2084_c1, 0.0f);
+  const float den = std::max(ST2084_c2 - ST2084_c3 * p, 1e-6f);
+  return std::pow(num / den, 1.0f / ST2084_m1);
+}
+
+// linear (1.0 == 10000 nits) -> PQ code value (0-1)
+inline float EncodePQ(float y)
+{
+  y = std::clamp(y, 0.0f, 1.0f);
+  const float p = std::pow(y, ST2084_m1);
+  return std::pow((ST2084_c1 + ST2084_c2 * p) / (1.0f + ST2084_c3 * p), ST2084_m2);
+}
+
+inline float LinearToSrgbComponent(float c)
+{
+  c = std::clamp(c, 0.0f, 1.0f);
+  return (c <= 0.0031308f) ? (12.92f * c) : (1.055f * std::pow(c, 1.0f / 2.4f) - 0.055f);
+}
+
+inline float SrgbToLinearComponent(float c)
+{
+  c = std::clamp(c, 0.0f, 1.0f);
+  return (c <= 0.04045f) ? (c / 12.92f) : std::pow((c + 0.055f) / 1.055f, 2.4f);
+}
+} // namespace COLOUR
+
+namespace COLOUR
+{
+// ConvertPQColourToSRGB() in three steps, which ConvertPQPixelsToSRGB() takes from tables (Hades)
+
+// the light of a PQ code of ConvertPQColourToSRGB(): linear BT.2020, reference white at 1
+inline float PQCodeToLight(uint32_t code)
+{
+  constexpr float whiteScale = 10000.0f / 203.0f; // ITU-R BT.2408 reference white
+  return DecodePQ(code / 255.0f) * whiteScale;
+}
+
+// linear BT.2020 to linear BT.709, a colour brighter than reference white scaled down to it
+inline void LightTo709(const float linearPQ[3], float linear709[3])
+{
+  // Linear BT.2020 -> linear BT.709/sRGB primaries, D65 both ends;
+  // numerically confirmed to map (1,1,1) to (1,1,1).
+  static constexpr float BT2020_TO_709[3][3] = {
+      {1.660491002f, -0.587641139f, -0.072849863f},
+      {-0.124550474f, 1.132899897f, -0.008349423f},
+      {-0.018150763f, -0.100578897f, 1.118729660f},
+  };
+
+  for (int i = 0; i < 3; i++)
+    linear709[i] =
+        std::max(BT2020_TO_709[i][0] * linearPQ[0] + BT2020_TO_709[i][1] * linearPQ[1] +
+                     BT2020_TO_709[i][2] * linearPQ[2],
+                 0.0f);
+
+  // A colour brighter than reference white is scaled down until its
+  // brightest channel is white, so its hue is kept.
+  const float maxChannel = std::max({linear709[0], linear709[1], linear709[2]});
+  if (maxChannel > 1.0f)
+    for (int i = 0; i < 3; i++)
+      linear709[i] /= maxChannel;
+}
+
+// the sRGB code of a linear light
+inline int SrgbCode(float linear)
+{
+  return static_cast<int>(LinearToSrgbComponent(linear) * 255.0f + 0.5f);
+}
+} // namespace COLOUR
+
+//! A colour from BT.2020 ST.2084 (PQ) to BT.709/sRGB, with reference white (203 nits, ITU-R
+//! BT.2408) mapped to sRGB white and brighter colours scaled down to it, hue kept. Alpha is
+//! untouched. (ConvertPQPaletteToSRGB() of OverlayRendererUtil.h, for one colour.)
+inline uint32_t ConvertPQColourToSRGB(uint32_t entry)
+{
+  using namespace COLOUR;
+  const int a = (entry >> PIXEL_ASHIFT) & 0xff;
+  const float linearPQ[3] = {
+      PQCodeToLight((entry >> PIXEL_RSHIFT) & 0xff),
+      PQCodeToLight((entry >> PIXEL_GSHIFT) & 0xff),
+      PQCodeToLight((entry >> PIXEL_BSHIFT) & 0xff),
+  };
+
+  float linear709[3];
+  LightTo709(linearPQ, linear709);
+
+  const int r = SrgbCode(linear709[0]);
+  const int g = SrgbCode(linear709[1]);
+  const int b = SrgbCode(linear709[2]);
+
+  return (a << PIXEL_ASHIFT) | (r << PIXEL_RSHIFT) | (g << PIXEL_GSHIFT) | (b << PIXEL_BSHIFT);
+}
+
+/*!
+ * \brief Hades: ConvertPQColourToSRGB() of each of count pixels, in place (a picture in PQ, as BD-J
+ * draws on an HDR playlist of an Ultra HD Blu-ray)
+ *
+ * The same steps from tables: the light of each of the 256 codes (PQCodeToLight(), the same
+ * values), and the sRGB code of a light from the least light of each of the 255 codes above 0
+ * (SrgbCode() is never lower for more light: a host test compares the two for each of the 16777216
+ * colours). A whole picture of 1920x1080 is converted in a few milliseconds rather than in a tenth
+ * of a second. A fully transparent pixel draws nothing and is left as it is.
+ */
+inline void ConvertPQPixelsToSRGB(uint32_t* pixels, size_t count)
+{
+  using namespace COLOUR;
+  struct Tables
+  {
+    float light[256];
+    float least[257]; // least[k]: the least light whose code is k or more (least[256]: none)
+    uint8_t guess[COARSE + 1]; // the code of the light at each step of 1/COARSE
+  };
+  static const Tables tables = []
+  {
+    Tables t{};
+    for (uint32_t code = 0; code < 256; code++)
+      t.light[code] = PQCodeToLight(code);
+    t.least[0] = 0.0f;
+    for (int k = 1; k <= 256; k++)
+    {
+      // the floats of 0 to 1 are in the order of their bits
+      uint32_t lo = 0;
+      uint32_t hi = 0x3f800000u; // 1.0f
+      if (k == 256 || SrgbCode(1.0f) < k)
+      {
+        t.least[k] = 2.0f;
+        continue;
+      }
+      while (lo < hi)
+      {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        float x;
+        std::memcpy(&x, &mid, sizeof(x));
+        if (SrgbCode(x) >= k)
+          hi = mid;
+        else
+          lo = mid + 1;
+      }
+      std::memcpy(&t.least[k], &lo, sizeof(float));
+    }
+    for (int i = 0; i <= COARSE; i++)
+    {
+      const float x = static_cast<float>(i) / COARSE;
+      int k = 0;
+      while (t.least[k + 1] <= x)
+        k++;
+      t.guess[i] = static_cast<uint8_t>(k);
+    }
+    return t;
+  }();
+  const auto code = [&](float v)
+  {
+    // (COARSE is a power of two: v * COARSE is exact and the step taken is at or below v, so the
+    // guess is the code of a light at or below v, never above the code of v)
+    int k = tables.guess[static_cast<int>(std::clamp(v, 0.0f, 1.0f) * COARSE)];
+    while (tables.least[k + 1] <= v)
+      k++;
+    return static_cast<uint32_t>(k);
+  };
+  uint32_t lastIn = 0;
+  uint32_t lastOut = 0;
+  bool last = false;
+  for (size_t i = 0; i < count; i++)
+  {
+    const uint32_t colour = pixels[i];
+    if (((colour >> PIXEL_ASHIFT) & 0xff) == 0)
+      continue;
+    if (!last || colour != lastIn)
+    {
+      const float linearPQ[3] = {tables.light[(colour >> PIXEL_RSHIFT) & 0xff],
+                                 tables.light[(colour >> PIXEL_GSHIFT) & 0xff],
+                                 tables.light[(colour >> PIXEL_BSHIFT) & 0xff]};
+      float linear709[3];
+      LightTo709(linearPQ, linear709);
+      lastIn = colour;
+      lastOut = (colour & (0xffu << PIXEL_ASHIFT)) | code(linear709[0]) << PIXEL_RSHIFT |
+                code(linear709[1]) << PIXEL_GSHIFT | code(linear709[2]) << PIXEL_BSHIFT;
+      last = true;
+    }
+    pixels[i] = lastOut;
+  }
+}
+
+//! Hades: scale the light of a colour by factor (0 to 1): decoded with the sRGB curve, or ST 2084
+//! (PQ) where pq, scaled, and encoded again. Alpha is untouched.
+inline uint32_t ScaleLight(uint32_t colour, float factor, bool pq)
+{
+  using namespace COLOUR;
+  const auto scale = [factor, pq](uint32_t code)
+  {
+    const float c{static_cast<float>(code) / 255.0f};
+    const float light{(pq ? DecodePQ(c) : SrgbToLinearComponent(c)) * factor};
+    const float out{pq ? EncodePQ(light) : LinearToSrgbComponent(light)};
+    return static_cast<uint32_t>(std::clamp(static_cast<int>(out * 255.0f + 0.5f), 0, 255));
+  };
+  return (colour & (0xffu << PIXEL_ASHIFT)) |
+         scale((colour >> PIXEL_RSHIFT) & 0xff) << PIXEL_RSHIFT |
+         scale((colour >> PIXEL_GSHIFT) & 0xff) << PIXEL_GSHIFT |
+         scale((colour >> PIXEL_BSHIFT) & 0xff) << PIXEL_BSHIFT;
+}
