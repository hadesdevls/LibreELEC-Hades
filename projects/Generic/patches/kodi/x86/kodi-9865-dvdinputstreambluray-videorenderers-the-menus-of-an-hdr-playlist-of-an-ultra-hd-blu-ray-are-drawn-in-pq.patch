+bool HDROverlayLimitedRange()
+{
+  bool limitedRange = CServiceBroker::GetWinSystem()->IsHdrComposite() &&
+                      CServiceBroker::GetWinSystem()->UseLimitedColor();
+#ifdef HAVE_DVBRIDGE
+  // native Dolby Vision output composes in full range (see SetGuiCompositing)
+  if (auto* dvWindow = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem());
+      dvWindow && dvWindow->DVBridgeCaptured())
+    limitedRange = false;
+#endif
+  return limitedRange;
+}
