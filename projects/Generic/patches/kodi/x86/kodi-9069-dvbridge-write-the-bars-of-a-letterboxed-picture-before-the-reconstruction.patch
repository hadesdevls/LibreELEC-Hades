+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -80,6 +80,7 @@ public:
 
 private:
   bool Fail(const char* stage);
+  void LogEarlyMask(bool packed);
   DVBRIDGE::DiagnosticFailures m_failures;
   bool m_reportedFrame{false};
   // All methods, including destruction, require the owning GL context/thread.
@@ -92,6 +93,8 @@ private:
   bool m_direct = false;
   bool m_directUsable = true;
   unsigned int m_directFailures = 0; //!< packed-path failures on frames the float path drew
+  //! the highest dvbridge_render_early_mask() seen, without and with packing, for the log
+  int m_earlyMask[2] = {0, 0};
   bool m_prepared = false;
   bool m_packed = false;
   PresentedDetail m_pendingDetail;
