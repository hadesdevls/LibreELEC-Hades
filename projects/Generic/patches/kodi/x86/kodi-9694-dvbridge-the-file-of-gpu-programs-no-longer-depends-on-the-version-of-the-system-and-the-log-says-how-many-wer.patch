+void CDVBridgeGLES::LogShaderPrograms()
+{
+  // At the end of native output, for the video that was drawn: a program that is compiled while a
+  // video plays is linked while a frame waits for it, and this says whether that happened. The
+  // ones made while the ways of drawing were made ready before the first frame cost nothing that
+  // can be seen.
+  const int start = m_programsAtStart;
+  const int afterWarm = m_programsAfterWarm;
+  m_programsAtStart = m_programsAfterWarm = -1;
+  if (!m_shaderCache || start < 0 || afterWarm < start)
+    return;
+  const int now = pl_cache_objects(m_shaderCache);
+  if (now < afterWarm)
+    return;
+  CLog::Log(LOGINFO,
+            "DVBridge: GPU programs compiled for this video: {} ({} while the ways of drawing were "
+            "made ready before its first frame, {} after it, each linked while a frame waited for "
+            "it)",
+            now - start, afterWarm - start, now - afterWarm);
+}
