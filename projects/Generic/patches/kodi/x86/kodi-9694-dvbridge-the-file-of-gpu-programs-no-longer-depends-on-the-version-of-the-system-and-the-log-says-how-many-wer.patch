+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace KODI
+{
+namespace DVBRIDGE
+{
+
+/*!
+ * \brief The key of the file of the GPU programs that are kept from one session to the next
+ *
+ * One file for each GPU, driver and libplacebo: the GL strings (with Mesa they carry its version
+ * and the kernel's, with the proprietary drivers their own) and libplacebo's version. The name
+ * and version of the system is not in the key: a system update that changes neither the driver
+ * nor libplacebo kept the programs of the file valid, and with the version in the key the first
+ * video after every update compiled them all again. What a driver does not take as its own
+ * (glProgramBinary() fails to link a binary of another build) is compiled from the text of the
+ * program, which libplacebo keeps with the binary.
+ */
+inline std::string ShaderCacheIdentity(const std::string& glVendor,
+                                       const std::string& glRenderer,
+                                       const std::string& glVersion,
+                                       const std::string& placeboVersion)
+{
+  return glVendor + '\n' + glRenderer + '\n' + glVersion + '\n' + placeboVersion;
+}
+
+//! FNV-1a of the identity, the name of the file
+inline uint64_t ShaderCacheKey(const std::string& text)
+{
+  uint64_t key = UINT64_C(14695981039346656037);
+  for (const char c : text)
+  {
+    key ^= static_cast<unsigned char>(c);
+    key *= UINT64_C(1099511628211);
+  }
+  return key;
+}
+
+} // namespace DVBRIDGE
+} // namespace KODI
