+        break;
+      }
+      // stamped with the last packet handed on, which is where the reading is (a little before
+      // it, by what the demuxer buffers: released early rather than late). Consecutive stamps at
+      // the same time collapse into the newest number.
+      const uint32_t seq = *static_cast<const uint32_t*>(pData);
+      const double stamp =
+          m_CurrentVideo.dts != DVD_NOPTS_VALUE ? m_CurrentVideo.dts : m_CurrentAudio.dts;
+      if (!m_bdjStamps.empty() && m_bdjStamps.back().pts == stamp)
+        m_bdjStamps.back().seq = seq;
+      else
+        m_bdjStamps.push_back({stamp, seq});
+      break;
+    }
     case BD_EVENT_PLAYLIST_STOP:
       m_dvd.state = DVDSTATE_NORMAL;
       m_dvd.iDVDStillTime = 0ms;
