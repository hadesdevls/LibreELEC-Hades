+void CDVDInputStreamBluray::StampBdjPending()
+{
+#if defined(BD_BDJ_PRESENTATION_TIMING)
+  if (!m_bdjTiming || !IsBdjTitle())
+    return;
+  uint32_t seq = bd_bdj_pending_seq(m_bd);
+  if (seq == 0)
+  {
+    m_bdjWaitSince = {};
+    return;
+  }
+  if (seq == m_bdjStampedSeq)
+    return;
+  m_bdjStampedSeq = seq;
+  // the player thread, inside the demuxer's read: the player stamps it with where it is
+  m_player->OnDiscNavResult(&seq, BD_EVENT_BDJ_PRESENTATION_STAMP);
+#endif
+}
+
+void CDVDInputStreamBluray::WaitForBdjPresentation()
+{
+#if defined(BD_BDJ_PRESENTATION_TIMING)
+  if (!m_bdjTiming || !IsBdjTitle() || bd_bdj_pending_seq(m_bd) == 0)
+  {
+    m_bdjWaitSince = {};
+    return;
+  }
+
+  // the player releases what its clock reached; paused or filling its buffers, it releases all
+  m_player->OnDiscNavResult(nullptr, BD_EVENT_BDJ_PRESENTATION_STAMP);
+  if (bd_bdj_pending_seq(m_bd) == 0)
+  {
+    m_bdjWaitSince = {};
+    return;
+  }
+
+  // Fail-safe: a picture that does not get there (a stalled decoder, a clock that does not run)
+  // must not keep this thread here. Past what any buffer holds, hand everything over, as
+  // without presentation timing.
+  constexpr auto BDJ_WAIT_LIMIT = 20s;
+  const auto now = std::chrono::steady_clock::now();
+  if (m_bdjWaitSince == std::chrono::steady_clock::time_point{})
+    m_bdjWaitSince = now;
+  else if (now - m_bdjWaitSince > BDJ_WAIT_LIMIT)
+  {
+    CLog::Log(LOGWARNING, "CDVDInputStreamBluray - the picture did not reach what the BD-J "
+                          "application waits for in {} s: handing everything over",
+              std::chrono::duration_cast<std::chrono::seconds>(BDJ_WAIT_LIMIT).count());
+    bd_bdj_release_all(m_bd);
+    m_bdjWaitSince = {};
+    return;
+  }
+  KODI::TIME::Sleep(5ms);
+#endif
+}
+
+void CDVDInputStreamBluray::ReleaseBdjEvents(uint32_t seq)
+{
+#if defined(BD_BDJ_PRESENTATION_TIMING)
+  if (m_bd && m_bdjTiming)
+    bd_bdj_release(m_bd, seq);
+#endif
+}
+
+void CDVDInputStreamBluray::ReleaseAllBdjEvents()
+{
+#if defined(BD_BDJ_PRESENTATION_TIMING)
+  if (m_bd && m_bdjTiming)
+    bd_bdj_release_all(m_bd);
+#endif
+}
