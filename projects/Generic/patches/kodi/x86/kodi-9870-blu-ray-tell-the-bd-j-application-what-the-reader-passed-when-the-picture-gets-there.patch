+void CVideoPlayer::ReleaseBdjPresented(bool waitingInRead)
+{
+#if defined(HAVE_LIBBLURAY)
+  if (m_bdjStamps.empty() && !waitingInRead)
+    return;
+  const auto bluray = std::dynamic_pointer_cast<CDVDInputStreamBluray>(m_pInputStream);
+  if (!bluray)
+  {
+    m_bdjStamps.clear();
+    return;
+  }
+
+  // paused or filling the buffers, the picture does not move: a read waiting for the BD-J
+  // application must not stay there, so it gets everything, as without presentation timing
+  if (waitingInRead && (m_playSpeed == DVD_PLAYSPEED_PAUSE || m_caching != CACHESTATE_DONE))
+  {
+    ReleaseAllBdjPresented();
+    return;
+  }
+
+  // due: no time stamped (applies at once, as before), the clock has got there, or a stamp
+  // further ahead than any buffer can hold (another timeline: a jump the player has not seen)
+  const double clock = m_clock.GetClock();
+  const double stale = DVD_SEC_TO_TIME(m_messageQueueTimeSize + 4.0);
+  uint32_t upto = 0;
+  bool any = false;
+  while (!m_bdjStamps.empty())
+  {
+    const SBdjStamp& stamp = m_bdjStamps.front();
+    if (stamp.pts != DVD_NOPTS_VALUE && stamp.pts > clock && stamp.pts - clock < stale)
+      break;
+    upto = stamp.seq;
+    any = true;
+    m_bdjStamps.pop_front();
+  }
+  if (any)
+    bluray->ReleaseBdjEvents(upto);
+#endif
+}
+
+void CVideoPlayer::ReleaseAllBdjPresented()
+{
+  m_bdjStamps.clear();
+#if defined(HAVE_LIBBLURAY)
+  if (const auto bluray = std::dynamic_pointer_cast<CDVDInputStreamBluray>(m_pInputStream))
+    bluray->ReleaseAllBdjEvents();
+#endif
+}
