From 7fb4620be14289de1fd4a91a50313f29f67845d9 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Mon, 5 Oct 2026 20:25:53 +0100
Subject: [PATCH] [Video][Database] Fix the announcement of versions and extras
 removed by a clean.

A clean announced each removed version or extra as a removed
"videoversion", a type JSON-RPC doesn't define, with the id of its
movie and once per asset. That included the default version of a movie
that was removed itself, while a movie that only lost an asset, or had
another version promoted, was never announced as changed.

Announce an update of each movie that is still in the library instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/VideoDatabase.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index deab2ed..2ac93cf 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -10994,8 +10994,14 @@ void CVideoDatabase::CleanDatabase(CGUIDialogProgressBarHandle* handle,
       for (const auto& i : musicVideoIDs)
         AnnounceRemove(MediaTypeMusicVideo, i, true);
 
-      for (const auto& i : videoVersionIDs)
-        AnnounceRemove(MediaTypeVideoVersion, i, true);
+      // videoVersionIDs holds the movies that lost a version or extra. Those still in the
+      // library have changed.
+      std::set<int> changedMovies(videoVersionIDs.begin(), videoVersionIDs.end());
+      for (const auto& i : movieIDs)
+        changedMovies.erase(i);
+
+      for (const auto& i : changedMovies)
+        AnnounceUpdate(MediaTypeMovie, i);
     }
   }
   catch (...)
-- 
2.53.0

