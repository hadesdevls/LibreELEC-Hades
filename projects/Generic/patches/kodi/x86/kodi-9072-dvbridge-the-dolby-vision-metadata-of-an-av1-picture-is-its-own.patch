From 5a07059f6fd6ad7b59e3b1858facba36e4001891 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 7 Oct 2026 15:19:38 +0000
Subject: [PATCH] dvbridge: the Dolby Vision metadata of an AV1 picture is its
 own

A picture that comes with the Dolby Vision metadata of an earlier one
(its access unit carried no RPU) counts as a picture without metadata:
twelve of them in a row, and the stream goes to the ordinary output
until its metadata is back. Such a picture is told by what it lacks:
FFmpeg attaches the RPU as coded (AV_FRAME_DATA_DOVI_RPU_BUFFER) only
to the picture whose access unit carried one.

That holds for FFmpeg's HEVC decoder, which is the only one that
attaches the parsed metadata of an earlier picture again, and the only
one that attaches the RPU as coded (hevc/hevcdec.c, the one place in
libavcodec 9.0.2 that makes that side data). Its AV1 decoders (av1dec.c
and libdav1d.c, through itut35.c) attach what they parsed from the
metadata OBU of the picture's own temporal unit, and nothing to a
picture that has none. So every picture of an AV1 stream with Dolby
Vision counted as one without its metadata: after twelve pictures the
stream left native output, and it did not come back, because the
pictures that would have said that the metadata is back are counted the
same way.

The rule is DVBRIDGE::RpuRepeated() now: only a picture of an HEVC
stream can come with the metadata of another one. An AV1 picture
without metadata still counts as what it is.

Read in the sources of FFmpeg and of Kodi; not run: there is no AV1
stream with Dolby Vision at hand, and the decoder is not built for the
host.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp    | 12 +++++++-----
 .../DVDCodecs/Video/DVPlaybackPolicy.h         | 18 ++++++++++++++++++
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 37910e6..bfc7f16 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -1650,13 +1650,15 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
       if (!pVideoPicture->doviMetadata.Assign(sd->data, sd->size))
         CLog::Log(LOGWARNING, "Unable to retain Dolby Vision picture metadata");
 #ifdef HAVE_DVBRIDGE
-      // FFmpeg attaches the last parsed RPU again to a picture whose access unit carried none;
-      // only the raw RPU buffer, attached with a parsed RPU, tells them apart. It is kept while
-      // an enhancement layer is decoded: the enhancement picture paired with this one may bring
-      // another RPU (UseLayerDVMetadata()).
+      // FFmpeg's HEVC decoder attaches the last parsed RPU again to a picture whose access unit
+      // carried none; only the raw RPU buffer, attached with a parsed RPU, tells them apart. It
+      // is kept while an enhancement layer is decoded: the enhancement picture paired with this
+      // one may bring another RPU (UseLayerDVMetadata()). An AV1 picture never comes with that
+      // buffer, and its metadata is always its own (DVBRIDGE::RpuRepeated()).
       const AVFrameSideData* coded =
           av_frame_get_side_data(m_pFrame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
-      pVideoPicture->doviRpuRepeated = !coded;
+      pVideoPicture->doviRpuRepeated = DVBRIDGE::RpuRepeated(
+          m_pCodecContext->codec_id == AV_CODEC_ID_HEVC, coded != nullptr);
       if (coded && m_dvFel && !m_dvSoftware)
         pVideoPicture->doviRpu.Assign(coded->data, coded->size);
 #endif
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 705dc93..80e890f 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -16,6 +16,24 @@ constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
          !softwareProbe && !interlaced && !stereo;
 }
 
+/*!
+ * \brief Hades: whether the Dolby Vision metadata that FFmpeg attached to a picture may be that
+ *        of an earlier picture, because the access unit of this one carried none
+ * \param hevc the stream is HEVC
+ * \param codedRpu the picture also came with its RPU as coded (AV_FRAME_DATA_DOVI_RPU_BUFFER)
+ *
+ * FFmpeg's HEVC decoder attaches the last RPU it parsed to every picture, and the RPU as coded
+ * only to the picture whose access unit carried one. Its AV1 decoders attach what they parsed
+ * from the metadata OBU of the picture's own temporal unit and nothing to a picture without
+ * one, and no decoder but the HEVC one attaches the RPU as coded: there the metadata of a
+ * picture is its own. (But for a payload of a kind that FFmpeg does not parse: either decoder
+ * then attaches what it has from before, the HEVC one with the RPU as coded.)
+ */
+constexpr bool RpuRepeated(bool hevc, bool codedRpu)
+{
+  return hevc && !codedRpu;
+}
+
 // Native Dolby Vision Standard output is sent as 3840x2160 progressive at a CTA rate from 23.976
 // to 60 Hz (VICs 93 to 97 and their 1000/1001 variants): Dolby Vision Standard over HDMI goes up
 // to 60 Hz, and the kernel backends accept only these timings.
