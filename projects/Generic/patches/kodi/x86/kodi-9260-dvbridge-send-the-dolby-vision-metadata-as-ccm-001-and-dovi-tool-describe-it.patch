-    unsigned offsets[4] = {0};
-    unsigned levels = 0;
-    for (int i = 0; i < m->num_ext_blocks; ++i) {
-        const AVDOVIDmData *e = av_dovi_get_ext(m, i);
-        if (e->level != 5)
-            continue;
-        if (++levels > 1) {
-            free(candidate);
-            return NULL;
-        }
-        offsets[0] = e->l5.left_offset;
-        offsets[1] = e->l5.right_offset;
-        offsets[2] = e->l5.top_offset;
-        offsets[3] = e->l5.bottom_offset;
-    }
-    if (!dvbridge_dv_area(&candidate->state, offsets[0], offsets[1], offsets[2], offsets[3],
-                         candidate->margins)) {
-        free(candidate);
-        return NULL;
-    }
     return candidate;
 }
 
@@ -103,7 +90,26 @@ bool dvbridge_active_area(const struct dvbridge_candidate *candidate, unsigned m
 {
     if (!candidate || !margins)
         return false;
-    memcpy(margins, candidate->margins, sizeof(candidate->margins));
+    memcpy(margins, candidate->state.margins, sizeof(candidate->state.margins));
+    return true;
+}
+
+bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
+                                struct dvbridge_reading *reading)
+{
+    if (!candidate || !reading)
+        return false;
+    const struct dvbridge_dv_reading *r = &candidate->state.reading;
+    *reading = (struct dvbridge_reading){0};
+    reading->l5_master = r->l5_master;
+    memcpy(reading->l5, r->l5, sizeof(reading->l5));
+    memcpy(reading->as_given, r->as_given, sizeof(reading->as_given));
+    memcpy(reading->margins, candidate->state.margins, sizeof(reading->margins));
+    reading->skipped = r->skipped;
+    reading->skipped_level = r->skipped_level;
+    reading->packets = candidate->state.count;
+    reading->scene_refresh = candidate->state.size > 1 && candidate->state.payload[1] == 1;
+    reading->metadata_id = candidate->state.id;
     return true;
 }
 
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
