+    /* Hades: a new stream starts (dvbridge_dv_restart()): its first frame refreshes the scene and
+     * takes the next metadata id, so that the id never goes back. */
+    bool restart;
+    /* Hades: the duration of a frame of the stream, in the units of the presentation times; 0 when
+     * not known (dvbridge_dv_gap_refresh()) */
+    double period;
+    /* ... and whether each of the last gaps between presented frames was longer than 1.5 of it
+     * (bit 0 the last one), and how many of those there are, up to 16 */
+    uint16_t gaps_over;
+    unsigned gaps_seen;
+    /* Hades: the blanking margins of the frame in the 3840x2160 raster (left, right, top, bottom):
+     * what the level 5 block sends, and what the renderer paints black */
+    unsigned margins[4];
+    struct dvbridge_dv_reading reading;
 };
 #define DV_REQUIRE(x) do { if (!(x)) return false; } while (0)
 /* Presentation times reach the serializer in AV_TIME_BASE units (microseconds), as Kodi passes
  * them; the reviewed mpv adapter passed seconds. */
 #define DVBRIDGE_PTS_PER_SECOND 1000000.0
-static inline bool dvbridge_dv_bounds(const AVDOVIMetadata *m, size_t bytes)
+/* Hades: the metadata can be read: its header, colour and mapping are where it says, and so are its
+ * extension blocks, when it has any. Whether it can be sent to a display natively is the
+ * serializer's question (dvbridge_dv_metadata(): it needs its display management blocks). An RPU
+ * without extension blocks is still a picture that can be reconstructed, for output as HDR10. */
+static inline bool dvbridge_dv_readable(const AVDOVIMetadata *m, size_t bytes)
 {
     DV_REQUIRE(m && bytes >= sizeof(*m));
 #define DV_REGION(field,type) \
@@ -38,9 +76,11 @@ static inline bool dvbridge_dv_bounds(const AVDOVIMetadata *m, size_t bytes)
     DV_REGION(header_offset, AVDOVIRpuDataHeader);
     DV_REGION(color_offset, AVDOVIColorMetadata);
     DV_REGION(mapping_offset, AVDOVIDataMapping);
+    DV_REQUIRE(m->num_ext_blocks >= 0 && m->num_ext_blocks <= AV_DOVI_MAX_EXT_BLOCKS);
+    if (!m->num_ext_blocks)
+        return true;
     DV_REGION(ext_block_offset, AVDOVIDmData);
 #undef DV_REGION
-    DV_REQUIRE(m->num_ext_blocks > 0 && m->num_ext_blocks <= AV_DOVI_MAX_EXT_BLOCKS);
     DV_REQUIRE(m->ext_block_size >= sizeof(AVDOVIDmData) &&
                m->ext_block_size % _Alignof(AVDOVIDmData) == 0);
     return (size_t)m->num_ext_blocks <= (bytes - m->ext_block_offset) / m->ext_block_size;
@@ -57,6 +97,8 @@ static inline bool dvbridge_dv_geometry(struct dvbridge_dv *d, int w, int h,
     d->source_w=w;d->source_h=h;d->dest_x=x;d->dest_y=y;d->dest_w=dw;d->dest_h=dh;
     return true;
 }
+/* The level 5 offsets as offsets of the decoded picture, in the 3840x2160 raster: false when they
+ * do not leave a picture. */
 static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned r,
                           unsigned t, unsigned b, unsigned v[4])
 {
@@ -69,6 +111,68 @@ static inline bool dvbridge_dv_area(struct dvbridge_dv *d, unsigned l, unsigned
     v[3]=2160-d->dest_y-dh+lround((double)b*dh/h);
     return v[0]+v[1]<3840 && v[2]+v[3]<2160;
 }
+/* Hades: the blanking margins of a frame from its level 5 offsets.
+ *
+ * The offsets describe the canvas that the RPU was made for. A picture of 3840x2160 is that canvas
+ * (taken as such, as before). A smaller one may be that canvas too (an HD stream with an RPU of its
+ * own), or a part of a 3840x2160 master: an encode that cropped the bars off, or scaled the master
+ * down, or both, and kept its RPU. Its offsets then count bars that the picture no longer has, in
+ * pixels of the master: read as offsets of the picture, they paint real rows black (a 3840x1600
+ * crop with top and bottom offsets of 280, placed at row 280, would lose 280 rows at each end).
+ * Nothing in the metadata says which canvas it is, so both readings are made:
+ *  - as offsets of the picture (dvbridge_dv_area());
+ *  - as offsets of a 3840x2160 master that the picture fills in width or in height, scaled by
+ *    s = min(3840 / w, 2160 / h), so that on the other axis 3840 - s*w (or 2160 - s*h) of the
+ *    master was cropped. Where it is not known on which side, each offset is lowered by all of
+ *    it: max(0, offset - removed), never by less than the bars were really cropped by. A crop of
+ *    exactly the bars (offsets adding up to the part removed) leaves no margin on that axis.
+ * Each side gets the smaller margin of the two readings: a wrong reading can only leave a part of
+ * the bars unpainted (they are black in the picture all the same, and the display is told of
+ * smaller bars), never paint the picture. For a 3840x2160 picture both readings are the same. When
+ * the offsets fit only the second reading (more bars than the picture has rows), that one is
+ * taken; when they fit neither, the frame is refused as before. Not covered: a picture cropped on
+ * both axes from the master; the first reading then holds as before. */
+static inline bool dvbridge_dv_margins(struct dvbridge_dv *d, unsigned l, unsigned r,
+                                       unsigned t, unsigned b, unsigned v[4])
+{
+    const int w = d->source_w ? d->source_w : 3840, h = d->source_h ? d->source_h : 2160;
+    const int dw = d->dest_w ? d->dest_w : 3840, dh = d->dest_h ? d->dest_h : 2160;
+    const unsigned offsets[4] = {l, r, t, b};
+    unsigned given[4] = {0};
+    const bool fits = dvbridge_dv_area(d, l, r, t, b, given);
+    if (!fits)
+        memset(given, 0, sizeof(given));
+    memcpy(d->reading.l5, offsets, sizeof(offsets));
+    memcpy(d->reading.as_given, given, sizeof(given));
+    d->reading.l5_master = false;
