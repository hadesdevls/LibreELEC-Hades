--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -12,10 +12,30 @@
 #include "mpv_dvbridge_cm4.h"
 #include <stdio.h>
 
+/* Hades: the display management payload may be up to 512 bytes (ETSI GS CCM 001 6.3.3.3). It goes
+ * in packets of 128 bytes, the first carrying 119 of it and every other one 121: five packets for
+ * 512 bytes. The transport shaders take the packets as 512 words of four bytes each, the first byte
+ * in the high bits (what fits in 128 uvec4 uniforms): room for 16. */
+#define DVBRIDGE_DV_MAX_PAYLOAD 512
+#define DVBRIDGE_DV_MAX_PACKETS 16
+#define DVBRIDGE_DV_PACKET_WORDS (DVBRIDGE_DV_MAX_PACKETS * 32)
+
+/* Hades: how the metadata of a frame was read, where that is not plainly what it says (for the log). */
+struct dvbridge_dv_reading {
+    /* The level 5 offsets were taken as those of a 3840x2160 master that the decoded picture was
+     * cropped or scaled from (dvbridge_dv_margins()): the margins are smaller than the offsets
+     * read in the units of the picture (as_given) would make them. */
+    bool l5_master;
+    unsigned l5[4];       /* the offsets of the level 5 block: left, right, top, bottom */
+    unsigned as_given[4]; /* the margins they make as offsets of the picture; 0 when they do not fit it */
+    /* Extension blocks of a level that CCM 001 reserves, which a display ignores: left out. */
+    unsigned skipped, skipped_level;
+};
+
 struct dvbridge_dv {
-    uint8_t payload[512], previous[512];
+    uint8_t payload[DVBRIDGE_DV_MAX_PAYLOAD], previous[DVBRIDGE_DV_MAX_PAYLOAD];
     unsigned size, previous_size, id;
-    uint32_t packets[512], count;
+    uint32_t packets[DVBRIDGE_DV_PACKET_WORDS], count;
     uint64_t frames, changes;
     double last_pts;
     int source_w, source_h, dest_x, dest_y, dest_w, dest_h;
@@ -24,12 +44,30 @@ struct dvbridge_dv {
     /* Hades: where the payload holds the count of its extension blocks, which follow it (0: no
      * payload yet). Read back by dvbridge_sent_blocks(), for the player information. */
