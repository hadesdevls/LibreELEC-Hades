@@ -19,7 +19,16 @@ struct dvbridge_geometry {
 
 struct dvbridge_context *dvbridge_create(void);
 void dvbridge_destroy(struct dvbridge_context *context);
+/* A new stream: the next frame refreshes the scene and takes the next metadata id (Hades: the id
+ * goes on, it does not start at 0 again). Not for a frame that failed or was not presented: such a
+ * frame never changed the state (dvbridge_commit()), and the next one carries on from the last
+ * presented one. */
 void dvbridge_reset(struct dvbridge_context *context);
+/* Hades: the duration of a frame of the stream, in the units of the presentation times
+ * (microseconds); 0 when not known. A gap of more than 1.5 of it between presented frames
+ * refreshes the scene (a frame that was not shown may have started one); without it, a gap of more
+ * than 0.1 s does. */
+void dvbridge_set_frame_period(struct dvbridge_context *context, double period);
 
 /* No state advances until presentation succeeds and commit is called. */
 struct dvbridge_candidate *dvbridge_prepare(
@@ -27,6 +36,10 @@ struct dvbridge_candidate *dvbridge_prepare(
     double pts, struct dvbridge_geometry geometry, bool fel_reconstructed);
 void dvbridge_candidate_destroy(struct dvbridge_candidate *candidate);
 bool dvbridge_commit(struct dvbridge_context *context, const struct dvbridge_candidate *candidate);
+/* The transport packets of the candidate: count packets of 128 bytes, as 32 words each, four bytes
+ * to a word with the first in the high bits (Hades; it was a byte to a word, which left room for 4
+ * packets in the same uniforms and not for the 512 bytes of payload that CCM 001 allows). Room for
+ * 16 packets: 512 words. */
 const uint32_t *dvbridge_packets(const struct dvbridge_candidate *candidate, unsigned *count);
 /* Left, right, top, bottom blanking margins in the final 3840x2160 raster. */
 bool dvbridge_active_area(const struct dvbridge_candidate *candidate, unsigned margins[4]);
@@ -38,6 +51,25 @@ bool dvbridge_active_area(const struct dvbridge_candidate *candidate, unsigned m
 int dvbridge_sent_blocks(const struct dvbridge_candidate *candidate, uint8_t *levels,
                          unsigned max, unsigned l5[4]);
 
+/* Hades: how the metadata of the candidate was read, for the log. */
+struct dvbridge_reading {
+    /* The level 5 offsets were read as those of a 3840x2160 master that the picture was cropped
+     * or scaled from: the margins are smaller than as_given, the offsets read in the units of the
+     * picture (see dvbridge_dv_margins() in dvbridge_metadata.h) */
+    bool l5_master;
+    unsigned l5[4];       /* left, right, top, bottom offsets of the level 5 block (0: none) */
+    unsigned as_given[4]; /* ... as offsets of the picture, in the raster; 0 when they do not fit */
+    unsigned margins[4];  /* the margins taken */
+    /* Extension blocks of reserved levels, left out (a display ignores them): how many, and the
+     * level of the first one */
+    unsigned skipped, skipped_level;
+    unsigned packets;     /* transport packets of the payload */
+    bool scene_refresh;   /* the frame refreshes the scene */
+    unsigned metadata_id;
+};
+bool dvbridge_candidate_reading(const struct dvbridge_candidate *candidate,
+                                struct dvbridge_reading *reading);
+
 #ifdef __cplusplus
 }
 #endif
