From 52865b7986ae86be7cceb2e44e0f53b2bd930cb6 Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Mon, 26 Oct 2026 12:32:57 -0700
Subject: [PATCH] [depends] Split compiler arguments in Meson cross files

Autoconf can append flags to CC and CXX. Serialize each command word as
an array element so Meson can find the compiler with or without ccache.
---
 tools/depends/configure.ac | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/tools/depends/configure.ac b/tools/depends/configure.ac
index 1b5a1d3..50aa0d0 100644
--- a/tools/depends/configure.ac
+++ b/tools/depends/configure.ac
@@ -835,14 +835,17 @@ AC_SUBST(app_rendersystem)
 AC_SUBST(ffmpeg_options)
 
 [
-if test "x$CCACHE" = "x"
-then
-  MESON_CC="'$CC'"
-  MESON_CXX="'$CXX'"
-else
-  MESON_CC="['$CCACHE', '$CC']"
-  MESON_CXX="['$CCACHE', '$CXX']"
-fi
+MESON_CC="${CCACHE:+'$CCACHE'}"
+for arg in $CC; do
+  MESON_CC="${MESON_CC:+${MESON_CC}, }'$arg'"
+done
+MESON_CC="[$MESON_CC]"
+
+MESON_CXX="${CCACHE:+'$CCACHE'}"
+for arg in $CXX; do
+  MESON_CXX="${MESON_CXX:+${MESON_CXX}, }'$arg'"
+done
+MESON_CXX="[$MESON_CXX]"
 
 # Parse and handle CFLAGS
 read -r CFLAGS_ARRAY << EOF
-- 
2.53.0

