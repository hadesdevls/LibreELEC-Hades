From 43d136e166efe8ff97d78307bef11221ce31ddfe Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sun, 11 Oct 2026 11:11:56 +0100
Subject: [PATCH] [VideoPlayer][CDVDDemuxClient] Keep parsed stream properties
 when a stream is opened again

CVideoPlayer opens a stream again when its properties no longer match the
hints it was opened with. For an input stream that demuxes for itself and
answers OpenStream with true, CDVDDemuxClient then rebuilt the stream from
what the input stream announces and dropped what ParsePacket had read from
the packets. The next packet differed from the announcement again, so the
stream was opened again for every packet.

The stream is now rebuilt only when the announcement has changed since the
stream was last built from it.

An inputstream add-on announcing AC-3 with 0 channels, 60 s of 2 channel
frames: 1886 channel changes and 3774 stream opens before, 1 and 4 after.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d833509187727ec3125b7e707f281c521c1d14a7)
---
 .../DVDDemuxers/DVDDemuxClient.cpp            |  11 ++
 .../DVDDemuxers/test/CMakeLists.txt           |   3 +-
 .../DVDDemuxers/test/TestDVDDemuxClient.cpp   | 165 ++++++++++++++++++
 3 files changed, 178 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/cores/VideoPlayer/DVDDemuxers/test/TestDVDDemuxClient.cpp

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
index 261adf5..ff3ab00 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxClient.cpp
@@ -10,6 +10,7 @@
 
 #include "DVDDemuxUtils.h"
 #include "DVDInputStreams/DVDInputStream.h"
+#include "DVDStreamInfo.h"
 #include "cores/FFmpeg.h"
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
 #include "utils/StreamUtils.h"
@@ -50,6 +51,8 @@ public:
   AVCodecParserContext *m_parser = nullptr;
   AVCodecContext *m_context = nullptr;
   bool m_parser_split = false;
+  //! What the input stream announced when the stream properties were last initialized from it
+  CDVDStreamInfo m_announced;
 };
 
 template <class T>
@@ -420,6 +423,11 @@ void CDVDDemuxClient::SetStreamProps(CDemuxStream *stream, std::map<int, std::sh
   std::shared_ptr<CDemuxStream> currentStream(GetStreamInternal(stream->uniqueId));
   std::shared_ptr<CDemuxStream> toStream;
 
+  // A stream announced as it was before keeps the properties ParsePacket corrected
+  const auto current = std::dynamic_pointer_cast<CDemuxStreamClientInternal>(currentStream);
+  if (forceInit && current && current->m_announced == *stream)
+    forceInit = false;
+
   if (stream->type == StreamType::AUDIO)
   {
     CDemuxStreamAudio *source = dynamic_cast<CDemuxStreamAudio*>(stream);
@@ -618,6 +626,9 @@ void CDVDDemuxClient::SetStreamProps(CDemuxStream *stream, std::map<int, std::sh
     toStream->level = stream->level;
   }
 
+  if (toStream != currentStream)
+    std::dynamic_pointer_cast<CDemuxStreamClientInternal>(toStream)->m_announced = *stream;
+
   toStream->uniqueId = stream->uniqueId;
   toStream->codec = stream->codec;
   toStream->codecName = stream->codecName;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/test/CMakeLists.txt b/xbmc/cores/VideoPlayer/DVDDemuxers/test/CMakeLists.txt
index dbdbff9..129d36c 100644
