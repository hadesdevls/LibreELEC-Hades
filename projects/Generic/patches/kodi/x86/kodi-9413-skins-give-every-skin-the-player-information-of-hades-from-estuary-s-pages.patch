diff --git a/tools/hades-playerinfo/make-playerinfo.py b/tools/hades-playerinfo/make-playerinfo.py
new file mode 100644
index 0000000..7184adc
--- /dev/null
+++ b/tools/hades-playerinfo/make-playerinfo.py
@@ -0,0 +1,356 @@
+#!/usr/bin/env python3
+#
+#  Copyright (C) 2026 Hades
+#  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+#
+#  SPDX-License-Identifier: GPL-2.0-or-later
+#  See LICENSES/README.md for more information.
+#
+# Makes the player information of Hades (the overview page and the Dolby Vision page that Estuary shows in its
+# DialogPlayerProcessInfo.xml) available to every skin, from Estuary's own files, so that there is one source:
+#
+#   system/hades/HadesIncludes.xml          the variables and maps that those pages use, and their row includes,
+#                                           loaded after the includes of every skin (CSkinInfo::LoadIncludes(): a
+#                                           skin's own definitions of the same names come first);
+#   system/hades/DialogHadesPlayerInfo.xml  the two pages as a dialog of their own (CGUIDialogHadesPlayerInfo),
+#                                           for a skin that has none: includes expanded, Estuary's control defaults
+#                                           written into each control, Estuary's strings as $ADDON[skin.estuary n],
+#                                           its colours as values and its textures from system/hades;
+#   system/hades/*.png                      those textures, copied from Estuary's media.
+#
+# Run from the root of the tree after a change to those pages: tools/hades-playerinfo/make-playerinfo.py
+# With --check it only says whether the files are those it would write (exit 1 if not).
+import copy
+import os
+import re
+import shutil
+import sys
+import xml.etree.ElementTree as ET
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+SKIN = os.path.join(ROOT, "addons", "skin.estuary")
+OUT = os.path.join(ROOT, "system", "hades")
+MEDIA_URL = "special://xbmc/system/hades/"
+PAGE_PROPERTY = ("PlayerInfoDialogFocus", "HadesPlayerInfoPage")
+# Estuary's own names that the pages use and that another skin may also have, for something else
+RENAMES = {
+    "VideoCodecVar": "HadesVideoCodecVar",
+    "AudioCodecVar": "HadesAudioCodecVar",
+    "SubtitleCodecVar": "HadesSubtitleCodecVar",
+    "VideoHWDecoder": "HadesVideoHWDecoderVar",
+    "DefaultCodecMap": "HadesCodecMap",
+    "DefaultAltAudioMap": "HadesAltAudioMap",
+    "DefaultHdrMap": "HadesHdrMap",
+}
+COLOUR_TAGS = {"textcolor", "shadowcolor", "focusedcolor", "disabledcolor", "selectedcolor", "invalidcolor",
+               "colordiffuse"}
+TEXTURE_TAGS = {"texture", "texturefocus", "texturenofocus", "alttexturefocus", "alttexturenofocus", "texturebg",
+                "lefttexture", "midtexture", "righttexture", "overlaytexture"}
+NUMERIC_TAGS = {"left", "right", "top", "bottom", "width", "height", "centerleft", "centerright", "centertop",
+                "centerbottom", "itemgap", "textoffsetx", "textoffsety", "depth"}
+
+
+def fail(message):
+    sys.exit("make-playerinfo: " + message)
+
+
+def parse(path):
+    return ET.parse(path).getroot()
+
+
+def estuary_strings():
+    ids = set()
+    with open(os.path.join(SKIN, "language", "resource.language.en_gb", "strings.po"), encoding="utf-8") as f:
+        for line in f:
+            m = re.match(r'msgctxt "#(\d+)"', line)
+            if m:
+                ids.add(int(m.group(1)))
+    return ids
+
+
+def estuary_colours():
+    colours = {}
+    for c in parse(os.path.join(SKIN, "colors", "defaults.xml")).iter("color"):
+        colours[c.get("name")] = c.text.strip()
+    return colours
+
+
+def constants():
+    values = {}
+    for c in parse(os.path.join(SKIN, "xml", "Constants_1080.xml")).iter("constant"):
+        values[c.get("name")] = (c.text or "").strip()
+    return values
+
+
+STRINGS = estuary_strings()
+COLOURS = estuary_colours()
+CONSTANTS = constants()
+TEXTURES = {}  # the skin's path of each texture used -> the file name in system/hades
+
+
+def colour(value):
+    v = value.strip()
+    if re.fullmatch(r"[0-9A-Fa-f]{8}", v) or v.startswith("$") or v == "":
+        return v
+    if v not in COLOURS:
+        fail("colour %r is not one of Estuary's" % v)
+    return COLOURS[v]
+
+
+def texture(value):
+    v = value.strip()
+    if not v or v.startswith("$") or v.startswith("special://") or "$INFO" in v or "$VAR" in v:
+        return v
+    src = os.path.join(SKIN, "media", v)
+    if not os.path.isfile(src):
+        fail("texture %r is not in Estuary's media" % v)
+    name = v.replace("/", "-")
+    TEXTURES[v] = name
+    return MEDIA_URL + name
+
+
+def text(value):
+    if value is None:
+        return None
+    v = value
+
+    def localize(m):
+        n = int(m.group(1))
+        return "$ADDON[skin.estuary %d]" % n if n in STRINGS else m.group(0)
+
+    v = re.sub(r"\$LOCALIZE\[(\d+)\]", localize, v)
+    v = re.sub(r"\[COLOR ([A-Za-z_]+)\]", lambda m: "[COLOR %s]" % colour(m.group(1)), v)
+    v = v.replace(PAGE_PROPERTY[0], PAGE_PROPERTY[1])
+    for old, new in RENAMES.items():
+        v = re.sub(r"(\$(?:ESC)?(?:VAR|MAP)\[\s*)%s\b" % re.escape(old), lambda m: m.group(1) + new, v)
+    return v
+
+
+def rewrite(e):
+    """Strings, colours, textures and names of an element and everything in it."""
+    for x in e.iter():
+        x.text = text(x.text)
+        x.tail = text(x.tail)
+        for k in list(x.attrib):
+            x.set(k, text(x.get(k)))
+        if x.tag in COLOUR_TAGS and x.text:
+            x.text = colour(x.text)
+        if "colordiffuse" in x.attrib:
+            x.set("colordiffuse", colour(x.get("colordiffuse")))
+        if x.tag in TEXTURE_TAGS and x.text:
+            x.text = texture(x.text)
+        if x.tag in NUMERIC_TAGS and x.text:
+            t = x.text.strip()
+            if t in CONSTANTS:
+                x.text = CONSTANTS[t]
+            elif not re.fullmatch(r"-?[0-9.]+%?|auto|-?[0-9.]+r?|\$PARAM\[\w+\]", t):
+                fail("<%s>%s</%s> is not a number" % (x.tag, t, x.tag))
+
+
+# ---- Estuary's definitions
+VARIABLES = {v.get("name"): v for v in parse(os.path.join(SKIN, "xml", "Variables.xml")).iter("variable")}
+MAPS = {m.get("name"): m for m in parse(os.path.join(SKIN, "xml", "Includes_Maps.xml")).iter("map")}
+INCLUDES = {i.get("name"): i for i in parse(os.path.join(SKIN, "xml", "Includes_HadesPlayerInfo.xml")).iter("include")
+            if i.get("name")}
+DEFAULTS = {d.get("type"): d for d in parse(os.path.join(SKIN, "xml", "Defaults.xml")).iter("default")}
+
+
+def params_of(include_call):
+    out = {}
+    for p in include_call.findall("param"):
+        out[p.get("name")] = p.get("value") if p.get("value") is not None else (p.text or "")
+    return out
+
+
+def expand(definition_name, given):
+    inc = INCLUDES.get(definition_name)
+    if inc is None:
+        fail("include %r is not one of Hades' (Includes_HadesPlayerInfo.xml)" % definition_name)
+    params = {p.get("name"): (p.text or "") for p in inc.findall("param")}
+    params.update(given)
+    body = copy.deepcopy(inc.find("definition"))
+
+    def sub(s):
+        if s is None:
+            return None
+        return re.sub(r"\$PARAM\[(\w+)\]", lambda m: params.get(m.group(1), ""), s)
+
+    for x in body.iter():
+        x.text = sub(x.text)
+        x.tail = sub(x.tail)
+        for k in list(x.attrib):
+            x.set(k, sub(x.get(k)))
+    return list(body)
+
+
+def expand_includes(e):
+    out = []
+    for c in list(e):
+        if c.tag == "include":
+            name = c.get("content") or (c.text or "").strip()
+            for x in expand(name, params_of(c)):
+                expand_includes(x)
+                out.append(x)
+        else:
+            expand_includes(c)
+            out.append(c)
+    tail = e[-1].tail if len(e) else None
+    for c in list(e):
+        e.remove(c)
+    for c in out:
+        e.append(c)
+    if len(e):
+        e[-1].tail = tail
+
+
+def apply_defaults(e):
+    """Estuary's <default> of each control's type, for what the control does not say (as CGUIIncludes does)."""
+    for c in e.iter("control"):
+        d = DEFAULTS.get(c.get("type"))
+        if d is None:
+            continue
+        for tag in d:
+            if c.find(tag.tag) is None:
+                c.append(copy.deepcopy(tag))
+
+
+# ---- the dialog
+dialog_src = parse(os.path.join(SKIN, "xml", "DialogPlayerProcessInfo.xml"))
+controls = dialog_src.find("controls")
+groups = controls.findall("control")
+overview = groups[0]
+kodi_pages = groups[1]
+if "5556" not in (overview.findtext("visible") or ""):
+    fail("the first group of DialogPlayerProcessInfo.xml is not the overview page any more")
+# of Kodi's pages: the background, the Dolby Vision page (5555) and its tab with the overview's
+pages = copy.deepcopy(kodi_pages)
+for c in list(pages):
+    vis = c.findtext("visible") or ""
+    keep = c.tag != "control" or (c.get("type") == "image") or "5555" in vis or c.get("id") == "5550"
+    if not keep:
+        pages.remove(c)
+tabs = [c for c in pages if c.get("id") == "5550"]
+if len(tabs) != 1:
+    fail("the tabs of DialogPlayerProcessInfo.xml are not where they were")
+for b in list(tabs[0]):
+    if b.tag == "control" and b.get("id") not in ("5556", "5555"):
+        tabs[0].remove(b)
+if [b.get("id") for b in tabs[0] if b.tag == "control"] != ["5556", "5555"]:
+    fail("the overview and Dolby Vision tabs are not where they were")
+# (the tab buttons go up and down to close the dialog, as in Estuary)
+
+window = ET.Element("window")
+ET.SubElement(window, "depth").text = CONSTANTS.get("DepthOSD", "0.40")
+dc = ET.SubElement(window, "defaultcontrol", {"always": "true"})
+dc.text = "5556"
+for a in dialog_src.findall("animation"):
+    window.append(copy.deepcopy(a))
+ET.SubElement(window, "onload").text = "SetProperty(%s,5556,Home)" % PAGE_PROPERTY[1]
+ET.SubElement(window, "onunload").text = "ClearProperty(%s,Home)" % PAGE_PROPERTY[1]
+out_controls = ET.SubElement(window, "controls")
+out_controls.append(copy.deepcopy(overview))
+out_controls.append(pages)
+expand_includes(out_controls)
+apply_defaults(out_controls)
+rewrite(window)
+
+# ---- what the dialog uses: variables and maps, transitively
+text_of = lambda e: " ".join(filter(None, [x.text for x in e.iter()] + [v for x in e.iter() for v in x.attrib.values()]))
+REVERSE = {v: k for k, v in RENAMES.items()}
+
+
+def names(pattern, s):
+    return set(m.strip() for m in re.findall(pattern, s))
+
+
+used_vars, used_maps = set(), set()
+pending = names(r"\$(?:ESC)?VAR\[\s*([A-Za-z0-9_]+)", text_of(window))
+while pending:
+    n = pending.pop()
+    if n in used_vars:
+        continue
+    src = REVERSE.get(n, n)
+    if src not in VARIABLES:
+        fail("variable %r is not one of Estuary's" % src)
+    used_vars.add(n)
+    body = text(ET.tostring(VARIABLES[src], encoding="unicode"))
+    pending |= names(r"\$(?:ESC)?VAR\[\s*([A-Za-z0-9_]+)", body)
+    used_maps |= names(r"\$(?:ESC)?MAP\[\s*([A-Za-z0-9_]+)", body)
+used_maps |= names(r"\$(?:ESC)?MAP\[\s*([A-Za-z0-9_]+)", text_of(window))
+maps_out = []
+pending = set(used_maps)
+done = set()
+while pending:
+    n = pending.pop()
+    if n in done:
+        continue
+    done.add(n)
+    src = REVERSE.get(n, n)
+    if src not in MAPS:
+        fail("map %r is not one of Estuary's" % src)
+    m = copy.deepcopy(MAPS[src])
+    m.set("name", n)
+    ref = m.get("ref")
+    if ref:
+        r = RENAMES.get(ref)
+        if r is None:
+            fail("map %r refers to %r, which has no name of Hades" % (src, ref))
+        m.set("ref", r)
+        pending.add(r)
+    maps_out.append(m)
+
+includes = ET.Element("includes")
+for n in sorted(used_vars):
+    v = copy.deepcopy(VARIABLES[REVERSE.get(n, n)])
+    v.set("name", n)
+    includes.append(v)
+for m in sorted(maps_out, key=lambda m: m.get("name")):
+    includes.append(m)
+for n in sorted(INCLUDES):
+    includes.append(copy.deepcopy(INCLUDES[n]))
+rewrite(includes)
+
+HEADER = ("\n  Generated by tools/hades-playerinfo/make-playerinfo.py from Estuary's DialogPlayerProcessInfo.xml,\n"
+          "  Variables.xml, Includes_Maps.xml, Includes_HadesPlayerInfo.xml and Defaults.xml: do not edit; change\n"
+          "  those and run it again. Copyright (C) 2026 Hades; SPDX-License-Identifier: GPL-2.0-or-later.\n  %s\n")
+
+
+def serialize(root, what):
+    ET.indent(root, space="\t")
+    body = ET.tostring(root, encoding="unicode")
+    return '<?xml version="1.0" encoding="UTF-8"?>\n<!--' + (HEADER % what) + "-->\n" + body + "\n"
+
+
+outputs = {
+    "HadesIncludes.xml": serialize(includes, "What every skin is given (CSkinInfo::LoadIncludes(), after the skin's own "
+                                             "includes): the variables, maps and row includes of the player "
+                                             "information of Hades."),
+    "DialogHadesPlayerInfo.xml": serialize(window, "The player information of Hades as a dialog of its own "
+                                                   "(CGUIDialogHadesPlayerInfo), for a skin that does not have one."),
+}
+for skin_path, name in TEXTURES.items():
+    with open(os.path.join(SKIN, "media", skin_path), "rb") as f:
+        outputs[name] = f.read()
+
+check = "--check" in sys.argv
+stale = []
+for name, data in outputs.items():
+    path = os.path.join(OUT, name)
+    mode = "rb" if isinstance(data, bytes) else "r"
+    old = None
+    if os.path.exists(path):
+        with open(path, mode, **({} if mode == "rb" else {"encoding": "utf-8"})) as f:
+            old = f.read()
+    if old != data:
+        stale.append(name)
+        if not check:
+            os.makedirs(OUT, exist_ok=True)
+            with open(path, "wb" if mode == "rb" else "w", **({} if mode == "rb" else {"encoding": "utf-8"})) as f:
+                f.write(data)
+extra = sorted(set(os.listdir(OUT)) - set(outputs)) if os.path.isdir(OUT) else []
+print("make-playerinfo: %d variables, %d maps, %d includes, %d textures; %s" % (
+    len(used_vars), len(maps_out), len(INCLUDES), len(TEXTURES),
+    ("stale: " + ", ".join(stale)) if stale else "up to date"))
+if extra:
+    print("make-playerinfo: not written by it: " + ", ".join(extra))
+sys.exit(1 if check and (stale or extra) else 0)
diff --git a/xbmc/addons/Skin.cpp b/xbmc/addons/Skin.cpp
index c9c893a..2fe5c6f 100644
--- a/xbmc/addons/Skin.cpp
+++ b/xbmc/addons/Skin.cpp
@@ -302,6 +302,13 @@ void CSkinInfo::LoadIncludes()
   CLog::Log(LOGINFO, "Loading skin includes from {}", includesPath);
   m_includes.Clear();
   m_includes.Load(includesPath);
+  // Hades: every skin is given the variables, maps and row includes of the player information of
+  // Hades (CGUIDialogHadesPlayerInfo), after its own: a definition of the skin's with the same name
+  // is the one that counts
+  const std::string hades =
+      CSpecialProtocol::TranslatePathConvertCase("special://xbmc/system/hades/HadesIncludes.xml");
+  if (CFileUtils::Exists(hades))
+    m_includes.Load(hades);
 }
 
 void CSkinInfo::LoadTimers()
