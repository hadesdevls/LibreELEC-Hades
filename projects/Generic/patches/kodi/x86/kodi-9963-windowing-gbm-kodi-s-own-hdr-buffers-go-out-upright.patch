From 3bd1490600bcfe6abd6c92a0b3370840dfb59599 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 5 Nov 2026 06:59:54 +0000
Subject: [PATCH] windowing/gbm: Kodi's own HDR buffers go out upright

OpenGL draws into a framebuffer object with the bottom row of the picture
first, and a plane scans a buffer out from its first row: HDR video drawn
into the 10-bit buffers that Kodi allocates itself (driver 580, whose EGL
offers no 10-bit window) went out upside down, menus and subtitles too.

The plane now reflects them from top to bottom (rotation, reflect-y), in the
commit of the first frame drawn into them and in their test commit. Once
that has been asked, every frame says the rotation of its plane, so the
window of EGL goes out upright after them. A plane without reflect-y never
takes them: the video then goes out upright at 8 bits, as before.
---
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp | 24 +++++++++++++++++--
 xbmc/windowing/gbm/drm/DRMAtomic.cpp          | 18 ++++++++++++--
 xbmc/windowing/gbm/drm/DRMObject.cpp          | 15 ++++++++++++
 xbmc/windowing/gbm/drm/DRMObject.h            |  2 ++
 xbmc/windowing/gbm/drm/DRMUtils.cpp           | 11 +++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h             | 17 +++++++++++++
 6 files changed, 83 insertions(+), 4 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
index 592a3fe..ffaa90f 100644
--- a/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp
@@ -828,6 +828,17 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
   CDRMPlane* plane = m_DRM->GetGuiPlane() ? m_DRM->GetGuiPlane() : m_DRM->GetVideoPlane();
   if (!plane || !m_DRM->GetCrtc())
     return false;
+  // OpenGL draws into a framebuffer object with the bottom row of the picture first, so a frame in
+  // these buffers is upside down for the display: the plane reflects it (CDRMUtils::SetReflectY()).
+  // A plane that cannot never takes them: the video then goes out upright, at 8 bits.
+  if (!CDRMUtils::CanReflectY(plane))
+  {
+    if (m_ownFailedKeys.insert("no-reflect").second)
+      CLog::LogF(LOGINFO, "HDR output: the plane cannot reflect a frame from top to bottom "
+                          "(rotation, reflect-y), which Kodi's own buffers need: video of more "
+                          "than 8 bits goes out at 8 bits");
+    return false;
+  }
 
   std::vector<const outputformat*> candidates;
   for (const auto& format : m_DRM->GetOutputFormats())
@@ -865,6 +876,8 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
     std::string failed;
     auto own = COwnScanout::Create(m_GBM->GetDevice().Get(), m_eglContext.GetEGLDisplay(), m_nWidth,
                                    m_nHeight, format->drm, format->modifiers, failed);
+    if (own)
+      m_DRM->SetReflectY(true);
     if (own && !m_DRM->TestFramebuffer(own->FirstBuffer()))
     {
       failed = "the driver refused, in a test, a commit of the plane with one of them";
@@ -872,6 +885,7 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
     }
     if (!own)
     {
+      m_DRM->SetReflectY(false);
       m_ownFailedKeys.insert(key);
       CLog::LogF(LOGWARNING,
                  "HDR output: buffers of {} that Kodi allocates itself cannot be used in {}x{} @ "
@@ -897,7 +911,10 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
     plane->SetModifier(own->Modifier());
     BindOwnBack();
     if (!OwnScanoutOn())
+    {
+      m_DRM->SetReflectY(false);
       return false;
+    }
     // (as for a half-float window: the next commit allows a modeset, which is an ordinary flip
     // when no mode changes; with the amdgpu quirk, the output is set active)
     if (m_DRM->HasQuirk(KODI::WINDOWING::GBM::QUIRK_NEEDSPRIMARY))
@@ -906,8 +923,9 @@ bool CWinSystemGbmEGLContext::OwnScanoutStart(int bitDepth)
       m_DRM->AllowModeset();
     CLog::LogF(LOGINFO,
                "HDR output: video of more than 8 bits goes out at {} bits through {} buffers of {} "
-               "(modifier {}) that Kodi allocates itself and draws into, {}x{}: {}; checked before "
-               "use (values of more than 8 bits written and read back, and a test commit)",
+               "(modifier {}) that Kodi allocates itself and draws into, {}x{}, reflected from top "
+               "to bottom by the plane: {}; checked before use (values of more than 8 bits written "
+               "and read back, and a test commit with the reflection)",
                own->OutputBits() == 16 ? "more than 10" : "10", COwnScanout::BUFFERS,
                DRMHELPERS::FourCCToString(own->Format()),
                DRMHELPERS::ModifierToString(own->Modifier()), m_nWidth, m_nHeight,
@@ -927,6 +945,8 @@ void CWinSystemGbmEGLContext::OwnScanoutStop(const std::string& why, bool failed
     return;
 #if defined(HAS_GLES)
   m_GBM->GetDevice().GetSurface().SetOwnBuffers(nullptr);
+  // (the next frame, of the window, goes out upright: CDRMUtils::SetReflectY())
+  m_DRM->SetReflectY(false);
   m_ownRetired.push_back(std::move(m_ownScanout));
   m_ownScanout.reset();
   m_ownRetiredFlips = 0;
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index a281743..7a8ee45 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -328,6 +328,9 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
     AddProperty(outputPlane, "SRC_H", m_height << 16);
     AddProperty(outputPlane, "CRTC_X", 0);
     AddProperty(outputPlane, "CRTC_Y", 0);
+    // Hades: upright for the display, as the buffer is (SetReflectY())
+    if (m_reflectSaid && outputPlane->SupportsProperty("rotation"))
+      AddProperty(outputPlane, "rotation", PlaneRotation());
     AddProperty(outputPlane, "CRTC_W", m_mode->hdisplay);
     // Frame packing scans out (vdisplay + vtotal) lines - the kernel doubles the
     // CRTC timing - and the framebuffer is sized to match, so cover all of it.
@@ -474,7 +477,12 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
 
     // update the old atomic request with the new fb id to avoid tearing
     if (rendered)
+    {
       AddProperty(outputPlane, "FB_ID", fb_id);
+      // Hades: with the rotation of that buffer (SetReflectY())
+      if (m_reflectSaid && outputPlane->SupportsProperty("rotation"))
+        AddProperty(outputPlane, "rotation", PlaneRotation());
+    }
     // Hades: ... and with the fences of the frame: those it names are of its own commit, its
     // in-fence closed since (FenceFallback())
     const bool fenced = rendered && m_inFenceFd != -1;
@@ -950,7 +958,9 @@ bool CDRMAtomic::TestFramebuffer(struct gbm_bo* bo)
       !request.AddProperty(plane, "SRC_H", static_cast<uint64_t>(m_height) << 16) ||
       !request.AddProperty(plane, "CRTC_X", 0) || !request.AddProperty(plane, "CRTC_Y", 0) ||
       !request.AddProperty(plane, "CRTC_W", m_mode->hdisplay) ||
-      !request.AddProperty(plane, "CRTC_H", ScanoutHeight()))
+      !request.AddProperty(plane, "CRTC_H", ScanoutHeight()) ||
+      (m_reflectSaid && plane->SupportsProperty("rotation") &&
+       !request.AddProperty(plane, "rotation", PlaneRotation())))
   {
     CLog::LogF(LOGWARNING, "the test request could not be made");
     return false;
@@ -1032,6 +1042,8 @@ bool CDRMAtomic::TestOutputMove(const OutputMove& move, struct gbm_bo* bo, std::
     add(move.crtc, "MODE_ID", mode.Get());
     add(move.crtc, "ACTIVE", 1);
     add(move.plane, "FB_ID", fb->fb_id);
+    if (m_reflectSaid && move.plane->SupportsProperty("rotation"))
+      add(move.plane, "rotation", PlaneRotation());
     add(move.plane, "CRTC_ID", move.crtc->GetCrtcId());
     add(move.plane, "SRC_X", 0);
     add(move.plane, "SRC_Y", 0);
@@ -1086,7 +1098,9 @@ bool CDRMAtomic::FlipPageAlone(struct gbm_bo* bo)
       !request.AddProperty(plane, "SRC_H", static_cast<uint64_t>(m_height) << 16) ||
       !request.AddProperty(plane, "CRTC_X", 0) || !request.AddProperty(plane, "CRTC_Y", 0) ||
       !request.AddProperty(plane, "CRTC_W", m_mode->hdisplay) ||
-      !request.AddProperty(plane, "CRTC_H", ScanoutHeight()))
+      !request.AddProperty(plane, "CRTC_H", ScanoutHeight()) ||
+      (m_reflectSaid && plane->SupportsProperty("rotation") &&
+       !request.AddProperty(plane, "rotation", PlaneRotation())))
     return false;
   if (drmModeAtomicCommit(m_fd, request.Get(), 0, nullptr) != 0)
   {
diff --git a/xbmc/windowing/gbm/drm/DRMObject.cpp b/xbmc/windowing/gbm/drm/DRMObject.cpp
index 3c3d87d..995f5f9 100644
--- a/xbmc/windowing/gbm/drm/DRMObject.cpp
+++ b/xbmc/windowing/gbm/drm/DRMObject.cpp
@@ -80,6 +80,21 @@ bool CDRMObject::GetProperties(uint32_t id, uint32_t type)
   return true;
 }
 
+bool CDRMObject::SupportsPropertyBit(std::string_view name, std::string_view bitName) const
+{
+  auto property = std::find_if(m_propsInfo.begin(), m_propsInfo.end(),
+                               [&name](const auto& prop) { return prop->name == name; });
+  if (property == m_propsInfo.end())
+    return false;
+  auto prop = property->get();
+  if (!static_cast<bool>(drm_property_type_is(prop, DRM_MODE_PROP_BITMASK)))
+    return false;
+  for (int j = 0; j < prop->count_enums; j++)
+    if (prop->enums[j].name == bitName)
+      return true;
+  return false;
+}
+
 std::optional<uint64_t> CDRMObject::GetPropertyEnumValue(std::string_view name,
                                                          std::string_view valueName) const
 {
diff --git a/xbmc/windowing/gbm/drm/DRMObject.h b/xbmc/windowing/gbm/drm/DRMObject.h
index d5b6be9..181b238 100644
--- a/xbmc/windowing/gbm/drm/DRMObject.h
+++ b/xbmc/windowing/gbm/drm/DRMObject.h
@@ -49,6 +49,8 @@ public:
 
   bool SetProperty(std::string_view name, uint64_t value);
   bool SupportsProperty(std::string_view name);
+  //! Hades: whether a bitmask property (such as "rotation") offers the bit of that name
+  bool SupportsPropertyBit(std::string_view name, std::string_view bitName) const;
   std::optional<uint64_t> GetPropertyValue(std::string_view name) const;
   bool CachePropertyValue(uint32_t propertyId, uint64_t value);
   std::optional<bool> IsPropertyImmutable(std::string_view name) const;
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 4093c62..edc3922 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1658,6 +1658,17 @@ void CDRMUtils::ReconsiderSoundOutputs()
   std::erase_if(m_soundDropped, [this](const std::string& node) { return node != m_node; });
 }
 
+bool CDRMUtils::CanReflectY(CDRMPlane* plane)
+{
+  return plane && plane->SupportsPropertyBit("rotation", "rotate-0") &&
+         plane->SupportsPropertyBit("rotation", "reflect-y");
+}
+
+uint64_t CDRMUtils::PlaneRotation() const
+{
+  return DRM_MODE_ROTATE_0 | (m_reflectY ? DRM_MODE_REFLECT_Y : 0);
+}
+
 bool CDRMUtils::TakeOwnSoundDropped()
 {
   return m_soundDropped.erase(m_node) != 0;
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 46cc1f7..298238b 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -72,6 +72,18 @@ public:
   //! \brief Whether the driver takes this buffer on the output plane, asked without showing it.
   //! An output that cannot ask says no.
   virtual bool TestFramebuffer(struct gbm_bo* bo) { return false; }
+  //! Hades: Kodi's own buffers of more than 8 bits (COwnScanout) hold a frame upside down for the
+  //! display, as OpenGL draws into a framebuffer object (its first row is the bottom one of the
+  //! picture): the plane that scans them out reflects them from top to bottom (rotation,
+  //! reflect-y). Once that has been asked, every frame says the rotation of its plane, so that the
+  //! window of EGL goes out upright after them.
+  void SetReflectY(bool on)
+  {
+    m_reflectY = on;
+    m_reflectSaid = m_reflectSaid || on;
+  }
+  //! Hades: whether a plane can reflect what it scans out from top to bottom (SetReflectY())
+  static bool CanReflectY(CDRMPlane* plane);
   //! \brief Whether the driver refused a commit of the ordinary output since this was last
   //! asked: it then showed the buffer with the state of the commit before, or nothing at all.
   //! Not told: a commit made while the output is meant to be off, which shows nothing, and the
@@ -296,6 +308,11 @@ public:
   }
 
 protected:
+  //! Hades: the rotation of the output plane, as SetReflectY() asks
+  uint64_t PlaneRotation() const;
+  bool m_reflectY{false}; //!< (Hades) SetReflectY()
+  bool m_reflectSaid{false}; //!< (Hades) the frames say the rotation of their plane
+
   //! \param atomic it is opened for atomic modesetting: of several graphics devices, one that
   //! does not have it is not the one that is used
   bool OpenDrm(bool needConnector, bool atomic = false);
-- 
