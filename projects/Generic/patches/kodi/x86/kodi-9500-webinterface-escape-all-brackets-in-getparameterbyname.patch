From 754667ef22b53db4b2ff5fbc657fa32e79c53a62 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sun, 25 Oct 2026 19:46:43 +0000
Subject: [PATCH] [webinterface] Escape all brackets in getParameterByName

CodeQL js/incomplete-sanitization: the bracket escaping only replaced
the first occurrence. All callers pass constant names, so this is not
exploitable, but the helper should escape every bracket.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 addons/webinterface.default/videoPlayer.html | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/addons/webinterface.default/videoPlayer.html b/addons/webinterface.default/videoPlayer.html
index 94a188f..8a55eba 100644
--- a/addons/webinterface.default/videoPlayer.html
+++ b/addons/webinterface.default/videoPlayer.html
@@ -14,7 +14,7 @@
 
         // Helpers.
         function getParameterByName(name) {
-            name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
+            name = name.replace(/[\[]/g, "\\[").replace(/[\]]/g, "\\]");
             var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
                     results = regex.exec(location.search);
             var res = results == null ? "" : results[1].replace(/\+/g, " ");
-- 
2.53.0

