+bool dvbridge_source_cover(struct dvbridge_source_packer *p, unsigned layer,
+                           const unsigned margins[4], unsigned *edges)
+{
+    if (!p || !layer || !margins || !edges || margins[0] + margins[1] >= 3840 ||
+        margins[2] + margins[3] >= 2160)
+        return false;
+    *edges = 0;
+    const int x0 = (int)margins[0], x1 = 3840 - (int)margins[1];
+    const int y0 = (int)margins[2], y1 = 2160 - (int)margins[3];
+    const int points = 3840 * y0 + 3840 * (2160 - y1) + (x0 + 3840 - x1) * (y1 - y0);
+    if (!points)
+        return true; /* no bars */
