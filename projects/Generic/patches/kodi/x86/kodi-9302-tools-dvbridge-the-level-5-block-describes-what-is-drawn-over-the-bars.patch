diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index 0a9ed7a..012c49b 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -12,6 +12,13 @@ struct dvbridge_candidate {
     struct dvbridge_dv state;
     const struct dvbridge_context *owner;
     uint64_t revision;
+    /* Hades: what dvbridge_candidate_cover() makes the payload again from: the state before it was
+     * made, a copy of the metadata and the arguments; and the edges it was made covered on */
+    struct dvbridge_dv before;
+    void *metadata;
+    double pts;
+    bool source;
+    unsigned cover;
 };
 
 struct dvbridge_context *dvbridge_create(void)
@@ -66,16 +73,40 @@ struct dvbridge_candidate *dvbridge_prepare_transport(
     /* (the serializer refuses more than one level 5 block, and sets the margins from the one
      * there is, or from none: dvbridge_dv_margins()) */
     if (!dvbridge_dv_geometry(&candidate->state, geometry.source_width, geometry.source_height,
-            geometry.x, geometry.y, geometry.width, geometry.height) ||
-        !dvbridge_dv_metadata(&candidate->state, m, pts, source)) {
+            geometry.x, geometry.y, geometry.width, geometry.height)) {
         free(candidate);
         return NULL;
     }
+    candidate->before = candidate->state;
+    candidate->metadata = malloc(bytes);
+    candidate->pts = pts;
+    candidate->source = source;
+    if (!candidate->metadata || !dvbridge_dv_metadata(&candidate->state, m, pts, source, 0)) {
+        dvbridge_candidate_destroy(candidate);
+        return NULL;
+    }
+    memcpy(candidate->metadata, metadata, bytes);
     return candidate;
 }
 
+bool dvbridge_candidate_cover(struct dvbridge_candidate *candidate, unsigned cover)
+{
+    if (!candidate || !candidate->metadata || cover > 15)
+        return false;
+    if (cover == candidate->cover)
+        return true;
+    struct dvbridge_dv state = candidate->before;
+    if (!dvbridge_dv_metadata(&state, candidate->metadata, candidate->pts, candidate->source, cover))
+        return false;
+    candidate->state = state;
+    candidate->cover = cover;
+    return true;
+}
+
 void dvbridge_candidate_destroy(struct dvbridge_candidate *candidate)
 {
+    if (candidate)
+        free(candidate->metadata);
     free(candidate);
 }
 
