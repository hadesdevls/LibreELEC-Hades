index eb85e20..41086af 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -19,6 +19,7 @@
 #include "dialogs/GUIDialogKaiToast.h"
 #include "drm/DRMAtomic.h"
 #include "drm/DRMDisplayWatch.h"
+#include "drm/DRMMonitorConfirm.h"
 #include "drm/DRMWake.h"
 #include "drm/DVBridgeLink.h"
 #ifdef HAVE_DVBRIDGE
@@ -293,8 +294,9 @@ bool CWinSystemGbm::InitWindowSystem()
   inUse.dolbyVision = inUse.type == "HDMI-A" && !inUse.nonDesktop && m_info &&
                       m_info->SupportsStandardDolbyVision();
   const bool nowhere = inUse.name.empty() && m_DRM->LookAtStart().Empty();
+  m_monitorSetting = settings->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR);
   m_displayWatch = std::make_unique<CDRMDisplayWatch>(
-      inUse, m_DRM->GetNode(), settings->GetString(CSettings::SETTING_VIDEOSCREEN_MONITOR),
+      inUse, m_DRM->GetNode(), m_monitorSetting,
       nowhere ? seenWithoutDisplay : m_DRM->LookAtStart());
 
   CLog::Log(LOGDEBUG, "CWinSystemGbm::{} - initialized DRM", __FUNCTION__);
@@ -2264,6 +2266,17 @@ CWinSystemBase::ScreenChange CWinSystemGbm::ChangeScreen(const std::string& scre
   // (what follows the displays that are connected later asks nothing of Kodi by itself)
   if (m_displayWatch)
     m_displayWatch->SetAsked(screen);
+  // (the value of before, which a start of Kodi for another graphics card notes down)
+  const std::string previous = std::exchange(m_monitorSetting, screen);
+
+  // Hades: a start that puts back a monitor that was not kept gives the setting its value: taken as
+  // it is (DRMMonitorConfirm.h)
+  if (MONITOR_CONFIRM::g_quiet)
+  {
+    CLog::Log(LOGINFO, "Monitor: the setting names \"{}\" again (a monitor that was not kept)",
+              screen);
+    return ScreenChange::DONE;
+  }
 
   const auto gui = CServiceBroker::GetGUI();
   const auto messenger = CServiceBroker::GetAppMessenger();
@@ -2318,8 +2331,9 @@ CWinSystemBase::ScreenChange CWinSystemGbm::ChangeScreen(const std::string& scre
   // Not taken: the setting keeps what it had, and the notification says why (playback, which
   // neither a move nor a start of Kodi is made under; or an output that carries more than the
   // interface for a moment yet)
-  const auto refuse = [&screen](bool whilePlaying)
+  const auto refuse = [this, &screen, &previous](bool whilePlaying)
   {
+    m_monitorSetting = previous;
     CLog::Log(LOGINFO, "Monitor: \"{}\" is not taken while {}: the setting keeps what it had",
               screen,
               whilePlaying ? "something plays" : "the output carries more than the interface");
@@ -2343,7 +2357,7 @@ CWinSystemBase::ScreenChange CWinSystemGbm::ChangeScreen(const std::string& scre
     CLog::Log(LOGINFO, "Monitor: \"{}\" takes Kodi to {}, of another graphics device: only a start "
                        "of Kodi takes it; the user is asked whether to start Kodi again now",
               screen, QualifiedOutputName(target));
-    AskRestart(label, 39854, 31725);
+    AskRestart(label, 39854, 31725, previous, screen);
     return ScreenChange::DONE;
   }
 
