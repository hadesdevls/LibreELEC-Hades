+// ---- Hades: a monitor that only a start of Kodi could take (DRMMonitorConfirm.h)
+
+namespace CONFIRM = MONITOR_CONFIRM;
+
+// How long the question waits for an answer, and how long a start waits for the interface to be
+// there to ask it (shown, no other dialog open) before the monitor counts as not kept
+constexpr unsigned int KEEP_SECONDS = 15;
+constexpr auto KEEP_WAIT_TIME = 90s;
+
+enum : int
+{
+  KEEP_NOT_PUT, //!< the interface cannot show the question now
+  KEEP_YES,
+  KEEP_NO, //!< anything but yes
+  KEEP_STOPPING,
+};
+
+// Where it is noted down: with the user's data, which outlasts Kodi and a start of the system (a
+// display that shows nothing may well be followed by turning the machine off and on)
+std::string MonitorFile()
+{
+  return CSpecialProtocol::TranslatePath("special://masterprofile/hades-monitor-confirm");
+}
+
+std::optional<CONFIRM::Pending> ReadMonitorPending(bool& present)
+{
+  std::ifstream file(MonitorFile());
+  present = file.is_open();
+  if (!present)
+    return std::nullopt;
+  std::string text((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  return CONFIRM::Parse(text);
+}
+
+// Written whole to the disk (synced), then put in place: a start finds the one before or this one
+bool WriteMonitorPending(const CONFIRM::Pending& pending)
+{
+  const std::string path = MonitorFile();
+  const std::string temp = path + ".new";
+  const std::string text = CONFIRM::Serialize(pending);
+  const int fd = open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0)
+    return false;
+  bool written = write(fd, text.data(), text.size()) == static_cast<ssize_t>(text.size());
+  written = fsync(fd) == 0 && written;
+  written = close(fd) == 0 && written;
+  if (!written || rename(temp.c_str(), path.c_str()) != 0)
+  {
+    unlink(temp.c_str());
+    return false;
+  }
+  const std::string folder = path.substr(0, path.find_last_of('/'));
+  if (const int dir = open(folder.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC); dir >= 0)
+  {
+    fsync(dir);
+    close(dir);
+  }
+  return true;
+}
+
+void RemoveMonitorPending()
+{
+  const std::string path = MonitorFile();
+  if (unlink(path.c_str()) != 0 && errno != ENOENT)
+    CLog::LogF(LOGWARNING, "Monitor: {} could not be removed: {}", path, strerror(errno));
+}
+
+// What the setting's value is shown as: Default in the language of the user
+std::string MonitorLabel(const std::string& value)
+{
+  return value == CONFIRM::DEFAULT
+             ? CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(571)
+             : value;
+}
+
+// The functions from here to the end of this namespace run on the application thread.
+
+int AskKeepMonitor(const std::string& shown, const std::string& otherwise)
+{
+  const int state = StateNow();
+  if (state & STATE_STOPPING)
+    return KEEP_STOPPING;
+  if (!(state & STATE_UP) || (state & (STATE_MODAL | STATE_DARK)))
+    return KEEP_NOT_PUT;
+
+  std::string text = otherwise == CONFIRM::DEFAULT ? CGUIUtils::GetHadesString(39861, 31732)
+                                                   : CGUIUtils::GetHadesString(39859, 31730);
+  StringUtils::Replace(text, "{0}", shown);
+  StringUtils::Replace(text, "{1}", MonitorLabel(otherwise));
+  namespace HELPERS = KODI::MESSAGING::HELPERS;
+  const std::string heading = CGUIUtils::GetHadesString(39858, 31729);
+  const HELPERS::DialogResponse answer = HELPERS::ShowYesNoDialogText(
+      CVariant{heading}, CVariant{text}, CVariant{}, CVariant{}, KEEP_SECONDS * 1000);
+  if (g_application.IsStopping())
+    return KEEP_STOPPING;
+  return answer == HELPERS::DialogResponse::CHOICE_YES ? KEEP_YES : KEEP_NO;
+}
+
+// The setting is given a value of a decision, taken as it is (no move, no question), and saved;
+// then what is noted down for the next start is written (or removed), and Kodi is started again
+// where that is decided. In this order: a start finds what is noted down only with the setting
+// that goes with it.
+int SetMonitor(const std::string& value,
+               const std::optional<CONFIRM::Pending>& next,
+               bool restart,
+               const std::string& notice)
+{
+  if (g_application.IsStopping())
+    return KEEP_STOPPING;
+  const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+  const auto settings = settingsComponent ? settingsComponent->GetSettings() : nullptr;
+  if (!settings)
+    return KEEP_NOT_PUT;
+
+  CONFIRM::g_quiet = true;
+  settings->SetString(CSettings::SETTING_VIDEOSCREEN_MONITOR, value);
+  CONFIRM::g_quiet = false;
+  settings->Save();
+  if (!next)
+    RemoveMonitorPending();
+  else if (!WriteMonitorPending(*next))
+    CLog::LogF(LOGWARNING, "Monitor: {} could not be written: {}", MonitorFile(), strerror(errno));
+  if (!notice.empty())
+    CGUIDialogKaiToast::QueueNotification(
+        CGUIDialogKaiToast::Info,
+        CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(246), notice, 10000);
+  if (restart)
+    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_RESTARTAPP);
+  return KEEP_YES;
+}
 } // namespace
 
+bool CDRMDisplayWatch::ArmMonitorConfirm(const std::string& previous, const std::string& chosen)
+{
+  if (previous.empty() || previous == chosen)
+    return false;
+  if (!WriteMonitorPending(CONFIRM::Arm(previous, chosen)))
+  {
+    CLog::LogF(LOGERROR, "Monitor: {} could not be written: {}", MonitorFile(), strerror(errno));
+    return false;
+  }
+  CLog::LogF(LOGINFO,
+             "Monitor: \"{}\" is noted down in place of \"{}\": the start that follows asks "
+             "whether to keep it",
+             chosen, previous);
+  return true;
+}
+
+void CDRMDisplayWatch::ConfirmMonitor()
+{
+  bool present = false;
+  const std::optional<CONFIRM::Pending> pending = ReadMonitorPending(present);
+  if (!pending)
+  {
+    if (present)
+    {
+      CLog::LogF(LOGWARNING, "Monitor: {} cannot be read: it is forgotten", MonitorFile());
+      RemoveMonitorPending();
+    }
+    return;
+  }
+
+  // What Kodi shows itself on, named as the looks name it, and whether that is the output that the
+  // setting names (Default: whatever the start chose)
+  const std::string setting = Asked();
+  const DRMOutput shown = m_seen.Empty() ? m_inUse : LabelInUse(m_seen, m_node, m_inUse);
+  const bool onNamed =
+      !shown.name.empty() && (setting == CONFIRM::DEFAULT || IsAskedOutput(shown, setting));
+  const std::string step = pending->step == CONFIRM::Step::CHOSEN ? "chosen" : "previous";
+  CLog::LogF(LOGINFO,
+             "Monitor: a start for \"{}\" (in place of \"{}\"), the {} one to be confirmed, "
+             "asked {} time(s) before; the setting names \"{}\", Kodi shows itself on {}",
+             pending->chosen, pending->previous, step, pending->tries, setting,
+             shown.name.empty() ? std::string("no output") : QualifiedOutputName(shown));
+
+  CONFIRM::Decision decision = CONFIRM::AtStart(pending, setting, onNamed);
+  if (decision.act == CONFIRM::Act::ASK)
+  {
+    // (counted before it is put: a start that ends while it is open does not keep the monitor)
+    if (!WriteMonitorPending(*decision.next))
+      CLog::LogF(LOGWARNING, "Monitor: {} could not be written: {}", MonitorFile(),
+                 strerror(errno));
+
+    const std::string label = OutputLabel(shown, false);
+    const std::string otherwise =
+        decision.next->step == CONFIRM::Step::CHOSEN ? decision.next->previous : CONFIRM::DEFAULT;
+    const auto giveUp = std::chrono::steady_clock::now() + KEEP_WAIT_TIME;
+    int answer = KEEP_NOT_PUT;
+    while (!m_bStop && answer == KEEP_NOT_PUT && std::chrono::steady_clock::now() < giveUp)
+    {
+      answer = CallApp([label, otherwise] { return AskKeepMonitor(label, otherwise); }, 30s);
+      if (answer < 0)
+        answer = KEEP_NOT_PUT;
+      if (answer == KEEP_NOT_PUT)
+        CThread::Sleep(1s);
+    }
+    if (m_bStop || answer == KEEP_STOPPING)
+    {
+      CLog::LogF(LOGINFO, "Monitor: Kodi stops before an answer: the next start asks again");
+      return;
+    }
+    if (answer == KEEP_YES)
+    {
+      CLog::LogF(LOGINFO, "Monitor: the user keeps {}", QualifiedOutputName(shown));
+      RemoveMonitorPending();
+      return;
+    }
+    CLog::LogF(LOGINFO, "Monitor: {} is not kept ({})", QualifiedOutputName(shown),
+               answer == KEEP_NO ? "no, back, or no answer in its time"
+                                 : "the question could not be shown in time");
+    decision = CONFIRM::AfterAnswer(*decision.next, false);
+  }
+
+  switch (decision.act)
+  {
+    case CONFIRM::Act::NOTHING:
+      return;
+    case CONFIRM::Act::DROP:
+      CLog::LogF(LOGINFO, "Monitor: nothing to ask: the setting was changed by other means since, "
+                          "or there is nothing to fall back to; it is forgotten");
+      RemoveMonitorPending();
+      return;
+    case CONFIRM::Act::ASK:
+      return;
+    case CONFIRM::Act::BACK:
+    case CONFIRM::Act::TO_DEFAULT:
+    case CONFIRM::Act::BACK_QUIETLY:
+    case CONFIRM::Act::TO_DEFAULT_QUIETLY:
+      break;
+  }
+
+  // The setting is given its value, what the next start asks about is written (or nothing is),
+  // and Kodi is started again where that is decided. Done by the application thread, however long
+  // it takes to get to it: what is decided is not left half done.
+  const bool restart =
+      decision.act == CONFIRM::Act::BACK || decision.act == CONFIRM::Act::TO_DEFAULT;
+  std::string notice;
+  if (restart)
+  {
+    CLog::LogF(LOGINFO, "Monitor: the setting names \"{}\" again, and Kodi is started again{}",
+               decision.setting,
+               decision.next ? ": that start asks whether to keep it" : ", for the last time");
+  }
+  else
+  {
+    CLog::LogF(LOGINFO,
+               "Monitor: the start did not take \"{}\" (Kodi shows itself on {}): the setting "
+               "names \"{}\" again, without a start",
+               setting, shown.name.empty() ? std::string("no output") : shown.name,
+               decision.setting);
+    notice = CGUIUtils::GetHadesString(39860, 31731);
+    StringUtils::Replace(notice, "{0}", MonitorLabel(setting));
+    StringUtils::Replace(notice, "{1}", MonitorLabel(decision.setting));
+  }
+  const std::string value = decision.setting;
+  const std::optional<CONFIRM::Pending> next = decision.next;
+  while (!m_bStop)
+  {
+    // (the notification is in the texts of the interface: once it is there)
+    if (!notice.empty())
+    {
+      const int state = CallApp([] { return StateNow(); }, 5s);
+      if (state < 0 || !(state & (STATE_UP | STATE_STOPPING)))
+      {
+        CThread::Sleep(1s);
+        continue;
+      }
+    }
+    if (CallApp([value, next, restart, notice] { return SetMonitor(value, next, restart, notice); },
+                30s) >= 0)
+      break;
+  }
+}
