+ */
+
+#pragma once
+
+#include <atomic>
+#include <optional>
+#include <sstream>
+#include <string>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+namespace MONITOR_CONFIRM
+{
+
+/*!
+ * \brief Whether a monitor that only a start of Kodi could take is kept
+ *
+ * A monitor of another graphics card, chosen in the settings, is taken by starting Kodi again
+ * (CWinSystemGbm::ChangeScreen()). Kodi's question to keep a change, with its countdown, cannot
+ * follow that change across the start, and a display that shows nothing would be found out only
+ * after it: the reason why LibreELEC hides the setting on GBM. So the change is noted down before
+ * Kodi starts again (Arm()), and the start that follows asks whether to keep the monitor, with a
+ * countdown. What is not answered yes (no, back, the time running out, a display that shows
+ * nothing) puts the monitor of before back, and Kodi starts again once more, on it; that one is
+ * asked about too, and where it is not kept either the setting goes to Default, as at a start
+ * where none is named. Two starts at most, then nothing is left noted down.
+ *
+ * Only a change made this way is asked about: what is noted down names the monitor it chose, and
+ * a setting that names another one by the start (changed by other means) asks nothing.
+ *
+ * Only what is decided is here, with nothing of Kodi in it, so that it can be tested by itself.
+ */
+
+inline constexpr const char* DEFAULT = "Default";
+//! How often the question of one step is put before that step counts as not answered yes: a
+//! start that ended while the question was open (Kodi stopped, or failed) does not keep a monitor
+inline constexpr unsigned int TRIES = 2;
+
+enum class Step
+{
+  CHOSEN, //!< the monitor that was chosen is to be kept or not
+  PREVIOUS, //!< it was not, and the one of before is to be kept or not
+};
+
+//! What is noted down between two starts of Kodi
+struct Pending
+{
+  Step step{Step::CHOSEN};
+  std::string previous; //!< the value of the setting before the change
+  std::string chosen; //!< ... and the one that the change gave it
+  unsigned int tries{0}; //!< the question of this step was put this often already
+
+  bool operator==(const Pending&) const = default;
+};
+
+//! What is noted down for a change from previous to chosen, made by starting Kodi again
+inline Pending Arm(const std::string& previous, const std::string& chosen)
+{
+  return {Step::CHOSEN, previous, chosen, 0};
+}
+
+//! As it is written down: one line each, the values last (they may hold spaces and parentheses)
+inline std::string Serialize(const Pending& pending)
+{
+  return std::string("hades-monitor-confirm 1\n") + "step " +
+         (pending.step == Step::CHOSEN ? "chosen" : "previous") + "\n" + "tries " +
+         std::to_string(pending.tries) + "\n" + "previous " + pending.previous + "\n" + "chosen " +
+         pending.chosen + "\n";
+}
+
+//! What was written down; nothing for anything else (an empty file, another format, a broken one)
+inline std::optional<Pending> Parse(const std::string& text)
+{
+  std::istringstream in(text);
+  std::string line;
+  const auto field = [&in, &line](const char* name, std::string& value)
+  {
+    const std::string key = std::string(name) + " ";
+    if (!std::getline(in, line) || line.compare(0, key.size(), key) != 0)
+      return false;
+    value = line.substr(key.size());
+    return true;
+  };
+
+  Pending pending;
+  std::string version, step, tries;
+  if (!std::getline(in, version) || version != "hades-monitor-confirm 1" || !field("step", step) ||
+      !field("tries", tries) || !field("previous", pending.previous) ||
+      !field("chosen", pending.chosen))
+    return std::nullopt;
+  if (step == "chosen")
+    pending.step = Step::CHOSEN;
+  else if (step == "previous")
+    pending.step = Step::PREVIOUS;
+  else
+    return std::nullopt;
+  if (tries.empty() || tries.size() > 3 || tries.find_first_not_of("0123456789") != std::string::npos)
+    return std::nullopt;
+  pending.tries = static_cast<unsigned int>(std::stoul(tries));
+  if (pending.previous.empty() || pending.chosen.empty() || pending.previous == pending.chosen)
+    return std::nullopt;
+  return pending;
+}
+
+//! What a start does with what was noted down
+enum class Act
+{
+  NOTHING, //!< nothing was noted down
+  DROP, //!< it is forgotten, and nothing else is done
+  ASK, //!< the question is put (what is noted down counts it first)
+  //! the setting names the monitor of before again, and Kodi starts again on it, which is asked
+  //! about next
+  BACK,
+  //! the setting goes to Default, and Kodi starts again with it: the last step
+  TO_DEFAULT,
+  //! the setting names the monitor of before again, without a start: Kodi did not show itself on
+  //! the one chosen (the start could not take it), and is on a display that the start chose
+  BACK_QUIETLY,
+  //! the setting goes to Default, without a start, for the same reason
+  TO_DEFAULT_QUIETLY,
+};
+
+struct Decision
+{
+  Act act{Act::NOTHING};
+  //! what is noted down from then on; nothing: nothing is
+  std::optional<Pending> next;
+  //! the value that the setting is given (BACK, TO_DEFAULT and their quiet forms)
+  std::string setting;
+};
+
+/*!
+ * \brief What a start of Kodi does with what was noted down
+ * \param pending what was noted down, if anything
+ * \param setting the value of the setting now
+ * \param shownOnNamed Kodi shows itself on the output that the setting names (with Default: on
+ *        the one that the start chose, which it always does)
+ */
+inline Decision AfterAnswer(const Pending& pending, bool kept);
+
+inline Decision AtStart(const std::optional<Pending>& pending,
+                        const std::string& setting,
+                        bool shownOnNamed)
+{
+  Decision decision;
+  if (!pending)
+    return decision;
+
+  decision.act = Act::DROP;
+  const Pending& p = *pending;
+  if (p.step == Step::CHOSEN)
+  {
+    // (the setting was changed since by other means: this is not that change)
+    if (setting != p.chosen)
+      return decision;
+    if (!shownOnNamed)
+    {
+      decision.act = Act::BACK_QUIETLY;
+      decision.setting = p.previous;
+      return decision;
+    }
+  }
+  else
+  {
+    // (... and the monitor of before is not one to fall back from: a start's own choice)
+    if (setting != p.previous || p.previous == DEFAULT)
+      return decision;
+    if (!shownOnNamed)
+    {
+      decision.act = Act::TO_DEFAULT_QUIETLY;
+      decision.setting = DEFAULT;
+      return decision;
+    }
+  }
+
+  // The question of this step was put often enough without an answer that was kept: not kept
+  if (p.tries >= TRIES)
+    return AfterAnswer(p, false);
+
+  decision.act = Act::ASK;
+  decision.next = p;
+  ++decision.next->tries;
+  return decision;
+}
+
+/*!
+ * \brief What is done with the answer to the question
+ * \param pending what is noted down (as AtStart() counted the question)
+ * \param kept the user answered yes; anything else (no, back, the time running out, a dialog that
+ *        something else closed) is not
+ */
+inline Decision AfterAnswer(const Pending& pending, bool kept)
+{
+  Decision decision;
+  if (kept)
+  {
+    decision.act = Act::DROP;
+    return decision;
+  }
+  if (pending.step == Step::CHOSEN && pending.previous != DEFAULT)
+  {
+    decision.act = Act::BACK;
+    decision.setting = pending.previous;
+    decision.next = Pending{Step::PREVIOUS, pending.previous, pending.chosen, 0};
+    return decision;
+  }
+  // (the monitor of before is Default, or was asked about and not kept either: Default, and
+  // nothing more is asked)
+  decision.act = Act::TO_DEFAULT;
+  decision.setting = DEFAULT;
+  return decision;
+}
+
+/*!
+ * \brief Set while Kodi gives the setting the value of a decision: the window system takes it as it
+ *        is then (no move, no question), Kodi is started again by this, or not at all
+ */
+inline std::atomic<bool> g_quiet{false};
+
+} // namespace MONITOR_CONFIRM
