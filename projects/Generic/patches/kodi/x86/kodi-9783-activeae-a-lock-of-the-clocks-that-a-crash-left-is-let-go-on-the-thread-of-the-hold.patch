+//! Whether a lock that a crash of Kodi left is marked (the marker file is there): the one check
+//! that runs at the start whatever the setting says, a read of a file that is normally not there
+inline bool StaleLockMarked(const std::string& marker)
+{
+  return DETAIL::ReadLine(marker).has_value();
+}
+
 /*!
- * \brief A lock that a crash of Kodi left (the marker file is there): let it go. Called once at the
- * start, whatever the setting says. Nothing is done when there is no marker.
+ * \brief A lock that a crash of Kodi left (the marker file is there): let it go. Done once at the
+ * start, whatever the setting says, on the thread of the hold (CAsyncHold::Recover()). Nothing is
+ * done when there is no marker.
  * \return what was said, or nothing
  */
 inline std::optional<std::string> RecoverStale(const std::string& marker, IClocks* clocks = nullptr)
@@ -543,6 +551,22 @@ public:
   //! wanted.
   void Set(const std::string& pci, bool wanted) { Request(pci, wanted, false); }
 
+  /*!
+   * \brief Let go a lock of the clocks that a crash of Kodi left (RecoverStale(): \a marker is
+   *        there), on the thread of the hold and before anything that is asked after this, with
+   *        the clocks that make gives for the card that the marker names. Returns at once: NVML is
+   *        not called on the thread that asks (the thread of the audio engine, at the start)
+   */
+  void Recover(const std::string& marker)
+  {
+    {
+      std::lock_guard<std::mutex> lock(m_state->mutex);
+      m_state->recover = marker;
+      StartLocked();
+    }
+    m_state->cv.notify_all();
+  }
+
 private:
   struct State
   {
@@ -551,12 +575,23 @@ private:
     std::mutex mutex;
     std::condition_variable cv;
     std::string pci; //!< the card that is wanted held
+    std::string recover; //!< the marker of a lock that a crash left (Recover()), "" for none
     bool wanted{false};
     bool stop{false};
     bool finished{false};
     bool running{false};
   };
 
+  //! The thread of the hold, if it is not running yet (m_state->mutex held)
+  void StartLocked()
+  {
+    if (!m_state->running)
+    {
+      m_state->running = true;
+      std::thread([state = m_state] { Work(state); }).detach();
+    }
+  }
+
   void Request(const std::string& pci, bool wanted, bool stop)
   {
     {
@@ -565,15 +600,24 @@ private:
         m_state->pci = pci;
       m_state->wanted = wanted && !stop;
       m_state->stop = stop;
-      if (!m_state->running)
-      {
-        m_state->running = true;
-        std::thread([state = m_state] { Work(state); }).detach();
-      }
+      StartLocked();
     }
     m_state->cv.notify_all();
   }
 
+  //! A lock that a crash left, let go with the clocks of its card (Recover())
+  static void LetGoStale(const State& state, const std::string& marker)
+  {
+    const auto stale = DETAIL::ReadLine(marker);
+    if (!stale)
+      return;
+    const std::unique_ptr<IClocks> staleClocks = state.make(*stale);
+    if (!staleClocks)
+      return;
+    if (const auto said = RecoverStale(marker, staleClocks.get()))
+      state.say(*said);
+  }
+
   static void Work(const std::shared_ptr<State>& state)
   {
     std::unique_ptr<IClocks> clocks;
@@ -583,14 +627,26 @@ private:
     std::unique_lock<std::mutex> lock(state->mutex);
     for (;;)
     {
+      // a lock that a crash left goes first: what is asked after it may lock the same card again
+      if (!state->recover.empty())
+      {
+        std::string marker;
+        marker.swap(state->recover);
+        lock.unlock();
+        LetGoStale(*state, marker);
+        lock.lock();
+        continue;
+      }
       // (another card, asked for while the hold is of one, wakes it too: the clocks of the first
       // are let go and those of the other held; the same "wanted" alone would leave the first held)
       state->cv.wait(lock,
                      [&]
                      {
-                       return state->stop || state->wanted != applied ||
+                       return state->stop || !state->recover.empty() || state->wanted != applied ||
                               (state->wanted && state->pci != pci);
                      });
+      if (!state->recover.empty())
+        continue;
       const bool stop = state->stop;
       const bool wanted = state->wanted && !stop;
       const std::string want = state->pci;
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
index 385fd1d..2ac84ee 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestGpuClockHold.cpp
@@ -388,3 +388,54 @@ TEST(TestGpuClockHold, AStaleLockIsLetGo)
   EXPECT_NE(std::string::npos, said->find("earlier run"));
   std::remove(marker.c_str());
 }
+
+TEST(TestGpuClockHold, AStaleLockIsLetGoOnTheThreadOfTheHoldFirst)
+{
+  char name[] = "/tmp/gpuholdrXXXXXX";
+  const int fd = mkstemp(name);
+  ASSERT_GE(fd, 0);
+  close(fd);
+  const std::string marker = name;
+  EXPECT_FALSE(StaleLockMarked(marker)); // an empty file is no marker
+  Touch(marker, "0000:01:00.0");
+  EXPECT_TRUE(StaleLockMarked(marker));
+
+  CEvents events;
+  std::atomic<int> told{0};
+  {
+    // a driver that takes its time to let go
+    CAsyncHold hold([&events](const std::string& pci)
+                    { return std::unique_ptr<IClocks>(new CCardClocks(pci, events, 300)); },
+                    [&told](const std::string& said)
+                    {
+                      if (said.find("earlier run") != std::string::npos)
+                        ++told;
+                    });
+    const auto start = std::chrono::steady_clock::now();
+    hold.Recover(marker); // the start of the audio engine
+    hold.Set("0000:01:00.0", true); // and HD audio right away, on the same card
+    EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::milliseconds(100));
+    EXPECT_TRUE(Eventually([&] { return events.Get().size() == 2; }));
+  }
+  // the stale lock went first: the new one is not let go by it
+  const std::vector<std::string> expected{"unlock 0000:01:00.0", "lock 0000:01:00.0",
+                                          "unlock 0000:01:00.0"};
+  EXPECT_EQ(expected, events.Get());
+  EXPECT_EQ(1, told);
+  std::remove(marker.c_str());
+}
+
+TEST(TestGpuClockHold, NoMarkerNoRecovery)
+{
+  CEvents events;
+  {
+    CAsyncHold hold([&events](const std::string& pci)
+                    { return std::unique_ptr<IClocks>(new CCardClocks(pci, events)); },
+                    [](const std::string&) {});
+    hold.Recover("/nonexistent/hades-gpu-clock-hold");
+    hold.Set("0000:01:00.0", true);
+    EXPECT_TRUE(Eventually([&] { return events.Get().size() == 1; }));
+  }
+  const std::vector<std::string> expected{"lock 0000:01:00.0", "unlock 0000:01:00.0"};
+  EXPECT_EQ(expected, events.Get());
+}
