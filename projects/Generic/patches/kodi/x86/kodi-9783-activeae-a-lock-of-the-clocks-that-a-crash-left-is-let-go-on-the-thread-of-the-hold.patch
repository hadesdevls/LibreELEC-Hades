--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -51,15 +51,26 @@ namespace
 constexpr const char* GPU_HOLD_MARKER = "/run/hades-gpu-clock-hold";
 } // namespace
 
+AE::GPUHOLD::CAsyncHold& CActiveAESink::GpuHold()
+{
+  if (!m_gpuHold)
+    m_gpuHold = std::make_unique<AE::GPUHOLD::CAsyncHold>(
+        [](const std::string& pci) -> std::unique_ptr<AE::GPUHOLD::IClocks>
+        { return std::make_unique<AE::GPUHOLD::CNvmlClocks>(pci, GPU_HOLD_MARKER); },
+        [](const std::string& said) { CLog::Log(LOGINFO, "GPU clock hold: {}", said); });
+  return *m_gpuHold;
+}
+
 void CActiveAESink::Start()
 {
   if (!IsRunning())
   {
-    // a lock of the clocks that a crash of Kodi left lets go here, whatever the setting says; with
-    // no
-    // marker (the usual case) this reads one file that is not there
-    if (const auto said = AE::GPUHOLD::RecoverStale(GPU_HOLD_MARKER))
-      CLog::Log(LOGINFO, "GPU clock hold: {}", *said);
+    // a lock of the clocks that a crash of Kodi left lets go, whatever the setting says, on the
+    // thread of the hold: this is the thread of the audio engine, whose start Kodi waits for, and
+    // NVML can take a while or not come back. With no marker (the usual case) this reads one file
+    // that is not there, and makes nothing
+    if (AE::GPUHOLD::StaleLockMarked(GPU_HOLD_MARKER))
+      GpuHold().Recover(GPU_HOLD_MARKER);
     Create();
     SetPriority(ThreadPriority::ABOVE_NORMAL);
   }
@@ -1391,11 +1402,8 @@ void CActiveAESink::UpdateGpuHold(bool passthrough)
   request.nvidiaGpu = gpu.has_value();
 
   const bool wanted = AE::GPUHOLD::Wants(request);
-  if (wanted && !m_gpuHold)
-    m_gpuHold = std::make_unique<AE::GPUHOLD::CAsyncHold>(
-        [](const std::string& pci) -> std::unique_ptr<AE::GPUHOLD::IClocks>
-        { return std::make_unique<AE::GPUHOLD::CNvmlClocks>(pci, GPU_HOLD_MARKER); },
-        [](const std::string& said) { CLog::Log(LOGINFO, "GPU clock hold: {}", said); });
+  if (wanted)
+    GpuHold();
   if (m_gpuHold)
     m_gpuHold->Set(gpu.value_or(std::string()), wanted);
 }
