 }
 
@@ -106,7 +116,17 @@ ssize_t CPosixFile::Read(void* lpBuf, size_t uiBufSize)
   if (uiBufSize > SSIZE_MAX)
     uiBufSize = SSIZE_MAX;
 
-  const ssize_t res = read(m_fd, lpBuf, uiBufSize);
+  // Hades: where the read starts, for a read that is tried again (SetReadRetry())
+  int64_t retryPos = -1;
+  if (m_retryReads)
+    retryPos = (m_filePos >= 0) ? m_filePos : static_cast<int64_t>(lseek(m_fd, 0, SEEK_CUR));
+
+  ssize_t res = read(m_fd, lpBuf, uiBufSize);
+  if (res < 0 && m_retryReads)
+  {
+    const int err = errno;
+    res = ReadFailed(lpBuf, uiBufSize, retryPos, err);
+  }
   if (res < 0)
   {
     Seek(0, SEEK_CUR); // force update file position
@@ -136,6 +156,187 @@ ssize_t CPosixFile::Read(void* lpBuf, size_t uiBufSize)
   return res;
 }
 
+bool CPosixFile::SetReadRetry(ReadRetry retry)
+{
+  m_retryReads = false;
+#if defined(TARGET_LINUX)
+  struct stat st;
+  if (m_fd < 0 || fstat(m_fd, &st) != 0)
+    return false;
+
+  const std::string device =
+      std::to_string(major(st.st_dev)) + ":" + std::to_string(minor(st.st_dev));
+  m_retryDevice = "/sys/dev/block/" + device;
+  if (major(st.st_dev) == 0 || access(m_retryDevice.c_str(), F_OK) != 0)
+  {
+    CLog::Log(LOGINFO,
+              "File: {} is not on a drive of this machine (its file system is on device {}): a "
+              "read of it that fails is not tried again",
+              retry.name, device);
+    return false;
+  }
+
+  m_retry = std::move(retry);
+  m_retryReads = true;
+  m_retryGaveUp = false;
+  m_retryToldOther = false;
+  return true;
+#else
+  return false;
+#endif
+}
+
+ssize_t CPosixFile::ReadFailed(void* lpBuf, size_t uiBufSize, int64_t pos, int err)
+{
+  using namespace std::chrono;
+  using namespace std::chrono_literals;
+
+  // a read was given up: the next ones fail at once, as they did before
+  if (m_retryGaveUp)
+    return -1;
+
+  if (err != EIO || pos < 0)
+  {
+    if (!m_retryToldOther)
+    {
+      m_retryToldOther = true;
+      CLog::Log(LOGINFO,
+                "File: reading {} failed at byte {} ({}, errno {}): not the error of a drive that "
+                "the kernel resets, so the read is not tried again",
+                m_retry.name, pos, std::strerror(err), err);
+    }
+    return -1;
+  }
+
+  std::string gone;
+  if (DriveGone(gone))
+  {
+    m_retryGaveUp = true;
+    CLog::Log(LOGINFO,
+              "File: reading {} failed at byte {} ({}), and {}: the read is not tried again",
+              m_retry.name, pos, std::strerror(err), gone);
+    return -1;
+  }
+
+  CLog::Log(LOGINFO,
+            "File: reading {} failed at byte {} ({}): the read is tried again at the same byte for "
+            "up to {} s, as a drive that the kernel has reset answers again",
+            m_retry.name, pos, std::strerror(err), duration_cast<seconds>(m_retry.window).count());
+
+  // 0.1 s, 0.25 s, 0.5 s, 1 s, and then every 2 s
+  static constexpr milliseconds WAITS[] = {100ms, 250ms, 500ms, 1000ms, 2000ms};
+  const auto first = steady_clock::now();
+  unsigned int tries = 0;
+  while (true)
+  {
+    const milliseconds wait = WAITS[std::min<size_t>(tries, std::size(WAITS) - 1)];
+    const auto since = duration_cast<milliseconds>(steady_clock::now() - first);
+    if (since + wait > m_retry.window)
+    {
+      m_retryGaveUp = true;
+      CLog::Log(LOGINFO,
+                "File: reading {} at byte {} still fails after {} ms and {} tries ({}): the read "
+                "is given up and fails, as it did before",
+                m_retry.name, pos, since.count(), tries, std::strerror(err));
+      return -1;
+    }
+    if (!WaitToRetry(wait))
+    {
+      CLog::Log(LOGINFO,
+                "File: reading {} at byte {} is not tried again: its reads are stopped (playback "
+                "stops), {} ms and {} tries after the first error",
+                m_retry.name, pos, duration_cast<milliseconds>(steady_clock::now() - first).count(),
+                tries);
+      return -1;
+    }
+
+    // the same byte: a read that fails does not move the offset of the file, and this makes sure
+    if (lseek(m_fd, static_cast<off_t>(pos), SEEK_SET) != static_cast<off_t>(pos))
+    {
+      err = errno;
+      m_retryGaveUp = true;
+      CLog::Log(LOGINFO, "File: {} cannot be read again at byte {} ({}): the read is given up",
+                m_retry.name, pos, std::strerror(err));
+      return -1;
+    }
+
+    ++tries;
+    const ssize_t res = read(m_fd, lpBuf, uiBufSize);
+    if (res >= 0)
+    {
+      m_filePos = pos;
+      CLog::Log(LOGINFO, "File: {} reads again at byte {}, {} ms after the first error, at try {}",
+                m_retry.name, pos, duration_cast<milliseconds>(steady_clock::now() - first).count(),
+                tries);
+      return res;
+    }
+
+    err = errno;
+    if (err != EIO || DriveGone(gone))
+    {
+      m_retryGaveUp = true;
+      CLog::Log(LOGINFO,
+                "File: reading {} at byte {} now fails with {}{}{}: the read is given up after {} "
+                "tries",
+                m_retry.name, pos, std::strerror(err), gone.empty() ? "" : ", and ", gone, tries);
+      return -1;
+    }
+  }
+}
+
+bool CPosixFile::WaitToRetry(std::chrono::milliseconds wait) const
+{
+  using namespace std::chrono;
+  using namespace std::chrono_literals;
+
+  const auto until = steady_clock::now() + wait;
+  while (true)
+  {
+    if (m_retry.abort && m_retry.abort->load())
+      return false;
+    const auto now = steady_clock::now();
+    if (now >= until)
+      return true;
+    std::this_thread::sleep_for(std::min<steady_clock::duration>(until - now, 20ms));
+  }
+}
+
+bool CPosixFile::DriveGone(std::string& why) const
+{
+  why.clear();
+  if (access(m_retryDevice.c_str(), F_OK) != 0)
+  {
+    why = "its drive is gone (" + m_retryDevice + " is no longer there)";
+    return true;
+  }
+
+  // the state of the SCSI device (a USB or SATA drive) or of the NVMe controller of the disk: of
+  // the block device itself, or of the disk of a partition
+  for (const char* state : {"/device/state", "/../device/state"})
+  {
+    const std::string path = m_retryDevice + state;
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+      continue;
+    char text[64];
+    const ssize_t n = read(fd, text, sizeof(text) - 1);
+    close(fd);
+    if (n <= 0)
+      return false;
+    std::string value(text, static_cast<size_t>(n));
+    while (!value.empty() && (value.back() == '\n' || value.back() == ' '))
+      value.pop_back();
+    if (value == "offline" || value == "transport-offline" || value == "cancel" ||
+        value == "deleted" || value == "dead" || value.rfind("deleting", 0) == 0)
+    {
+      why = "its drive is " + value + " (" + path + ")";
+      return true;
+    }
+    return false;
+  }
+  return false;
+}
+
 ssize_t CPosixFile::Write(const void* lpBuf, size_t uiBufSize)
 {
   if (m_fd < 0)
diff --git a/xbmc/platform/posix/filesystem/PosixFile.h b/xbmc/platform/posix/filesystem/PosixFile.h
index c202d23..5890e50 100644
--- a/xbmc/platform/posix/filesystem/PosixFile.h
+++ b/xbmc/platform/posix/filesystem/PosixFile.h
@@ -10,6 +10,10 @@
 
 #include "filesystem/IFile.h"
 
+#include <atomic>
+#include <chrono>
+#include <string>
+
 namespace XFILE
 {
 
@@ -37,11 +41,57 @@ namespace XFILE
     int Stat(const CURL& url, struct __stat64* buffer) override;
     int Stat(struct __stat64* buffer) override;
 
+    /*!
+     * \brief Hades: how long after its first error a read of a played file is tried again, at
+     *        most (SetReadRetry()). A read that its drive does not answer waits for the kernel's
+     *        command timeout (30 s for a SCSI disk, which a USB drive is) before the kernel resets
+     *        the drive and fails the reads that it had in flight. The reset itself takes a fraction
+     *        of a second (0.2 s for a USB SSD of issue #16), a hard disk that spins up again some
+     *        seconds. Half the command timeout covers both, and keeps what Kodi adds for a drive
+     *        that does not come back well short of what the kernel waited before.
+     */
+    static constexpr std::chrono::milliseconds READ_RETRY_WINDOW{15000};
+
+    /*!
+     * \brief Hades: what a player asks of the reads of a file that it plays (SetReadRetry()).
+     */
+    struct ReadRetry
+    {
+      //! true once the reads are to stop: the player closes the file. Another thread sets it.
+      const std::atomic<bool>* abort{nullptr};
+      //! the file, as the log names it
+      std::string name;
+      //! how long after the first error a read is tried again, at most
+      std::chrono::milliseconds window{READ_RETRY_WINDOW};
+    };
+
+    /*!
+     * \brief Hades: a read of this file that fails with EIO, which a drive that the kernel reset
+     *        gives for the reads that it had in flight, is tried again at the same byte for at most
+     *        retry.window, with short waits that retry.abort ends at once. Not when the drive of
+     *        the file is gone (its block device left /sys, or its SCSI device is offline), and not
+     *        for another error, which fails as before. Only for a file on a block device of this
+     *        machine: returns false otherwise, and the log says so. Called after Open(), by the
+     *        thread that reads the file; Close() ends it.
+     */
+    bool SetReadRetry(ReadRetry retry);
+
   protected:
+    ssize_t ReadFailed(void* lpBuf, size_t uiBufSize, int64_t pos, int err);
+    bool DriveGone(std::string& why) const;
+    bool WaitToRetry(std::chrono::milliseconds wait) const;
+
     int     m_fd = -1;
     int64_t m_filePos = -1;
     int64_t m_lastDropPos = -1;
     bool    m_allowWrite = false;
+
+    // Hades: SetReadRetry()
+    bool m_retryReads = false;
+    ReadRetry m_retry;
+    std::string m_retryDevice; //!< /sys/dev/block/<major>:<minor> of the file system of the file
+    bool m_retryGaveUp = false; //!< a read was given up: the next ones fail at once, as before
+    bool m_retryToldOther = false; //!< the log said once that another error is not tried again
   };
 
 }
