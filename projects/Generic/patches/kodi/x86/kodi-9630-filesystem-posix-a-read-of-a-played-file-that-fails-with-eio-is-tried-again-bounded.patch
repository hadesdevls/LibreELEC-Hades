+  m_aborted = false;
   m_pFile = new CFile();
   if (!m_pFile)
     return false;
@@ -68,6 +74,19 @@ bool CDVDInputStreamFile::Open()
     return false;
   }
 
+#if defined(TARGET_POSIX)
+  // Hades: a read of a file on a drive of this machine that fails with an I/O error is tried
+  // again for a bounded time, as a drive that the kernel has reset answers again (issue #16);
+  // CFileStreamBuffer would take the error for the end of the file
+  if (auto* posix = dynamic_cast<CPosixFile*>(m_pFile->GetImplementation()))
