From b5f0a127cbee8bbe0134bd0c4d07714c8dbedc96 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Tue, 27 Oct 2026 16:35:05 +0000
Subject: [PATCH] [Video] Refresh each disc of a source once.

A source refresh refreshes each movie from its default version. An
earlier movie merged into a later one as a version could become its
default, as new versions are by default. The later movie was then
refreshed from the earlier one's disc again, and its own disc, now a
version of it, was never read.

A movie whose default changed this way gets back the default it was
listed with before it is refreshed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp b/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
index 1e2f892..4292c01 100644
--- a/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
+++ b/xbmc/video/jobs/VideoLibraryRefreshingSourceJob.cpp
@@ -154,6 +154,19 @@ bool CVideoLibraryRefreshingSourceJob::Work(CVideoDatabase& db)
       found = db.GetMusicVideoInfo({}, tag, listed.m_iDbId);
     if (!found)
       continue;
+
+    // A playlist an earlier item merged into this movie may have become its default. Refreshing
+    // the movie from that would refresh the earlier item's disc again rather than this one's, so
+    // the movie gets back the default it was listed with.
+    if (listed.m_type == MediaTypeMovie && tag.m_iFileId != listed.m_iFileId &&
+        db.GetSingleValueInt(db.PrepareSQL(
+            "SELECT COUNT(1) FROM videoversion WHERE idFile = %i AND idMedia = %i AND "
+            "media_type = '%s' AND itemType = %i",
+            listed.m_iFileId, tag.m_iDbId, MediaTypeMovie,
+            static_cast<int>(VideoAssetType::VERSION))) > 0 &&
+        db.SetDefaultVideoVersion(VideoDbContentType::MOVIES, tag.m_iDbId, listed.m_iFileId) &&
+        !db.GetMovieInfo({}, tag, listed.m_iDbId))
+      continue;
     SetText(tag.GetTitle());
 
     // A refresh would remove an item whose media is missing, so it is left to library cleaning.
