From 31cf796e31480ded6a1da206e82626b708778134 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:46:34 +0000
Subject: [PATCH] network/TCPServer: do not spin while no descriptor is left
 for a connection

When accept() fails for want of a descriptor or of memory (EMFILE, ENFILE,
ENOBUFS, ENOMEM), the connection stays in the listen queue and the
listening socket stays readable, so the next select() returned at once and
the server thread went round as fast as it could, writing an error line to
the log on every turn: about 200,000 lines a second on the test host, for
as long as nothing was freed.

After such a failure the listening sockets are left out of the select for
250 ms, with the select woken every 50 ms meanwhile, so the connections
already open are served as before and the waiting one is accepted once a
descriptor is free. The error number is also read before the log line,
which may change it.
---
 xbmc/network/TCPServer.cpp | 35 +++++++++++++++++++++++++++++++----
 xbmc/network/TCPServer.h   |  5 +++++
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/xbmc/network/TCPServer.cpp b/xbmc/network/TCPServer.cpp
index 0a40efb..eff0e2e 100644
--- a/xbmc/network/TCPServer.cpp
+++ b/xbmc/network/TCPServer.cpp
@@ -119,6 +119,20 @@ bool Interrupted()
   return errno == EINTR;
 #endif
 }
+
+// accept() failed for want of a descriptor or of memory, which only time can bring back
+bool OutOfResources([[maybe_unused]] int error)
+{
+#if defined(TARGET_WINDOWS)
+  const int code = WSAGetLastError();
+  return code == WSAEMFILE || code == WSAENOBUFS;
+#else
+  return error == EMFILE || error == ENFILE || error == ENOBUFS || error == ENOMEM;
+#endif
+}
+
+// How long the listening sockets are left out after that
+constexpr auto acceptPause = std::chrono::milliseconds(250);
 } // namespace
 
 std::shared_ptr<CTCPServer> CTCPServer::ServerInstance;
@@ -186,6 +200,7 @@ void CTCPServer::Process()
     struct timeval  to     = {1, 0};
     bool backlogged = false;
     bool answering = false;
+    const bool acceptPaused = std::chrono::steady_clock::now() < m_acceptResume;
     FD_ZERO(&rfds);
 
     fd_set wfds;
@@ -200,6 +215,8 @@ void CTCPServer::Process()
 
       for (auto& it : m_servers)
       {
+        if (acceptPaused)
+          break;
         FD_SET(it, &rfds);
         if ((intptr_t)it > (intptr_t)max_fd)
           max_fd = it;
@@ -255,8 +272,8 @@ void CTCPServer::Process()
 
     // A held-back connection, or one waiting for its answers after its input ended, is not in
     // the set, so nothing wakes the select when its worker is done. Look again soon rather than
-    // after the idle timeout.
-    if (backlogged || answering)
+    // after the idle timeout. Likewise for the listening sockets while they are left out.
+    if (backlogged || answering || acceptPaused)
       to = {0, 50000};
 
     int res = select((intptr_t)max_fd + 1, &rfds, &wfds, NULL, &to);
@@ -339,13 +356,23 @@ void CTCPServer::Process()
 
           if (newconnection->m_socket == INVALID_SOCKET)
           {
-            CLog::Log(LOGERROR, "JSONRPC Server: Accept of new connection failed: {}", errno);
-            if (EBADF == errno)
+            // Read before the log line, which may change it
+            const int error = errno;
+            CLog::Log(LOGERROR, "JSONRPC Server: Accept of new connection failed: {}", error);
+            if (EBADF == error)
             {
               CThread::Sleep(1000ms);
               Initialize();
               break;
             }
+            if (OutOfResources(error))
+            {
+              // The connection stays queued, so the listening socket stays readable and the next
+              // select() would return at once, for as long as nothing is freed. The listening
+              // sockets are left out for a moment; the connections already open are served.
+              m_acceptResume = std::chrono::steady_clock::now() + acceptPause;
+              break;
+            }
           }
 #if !defined(TARGET_WINDOWS)
           else if (newconnection->m_socket >= FD_SETSIZE)
diff --git a/xbmc/network/TCPServer.h b/xbmc/network/TCPServer.h
index 879efa6..8609bbb 100644
--- a/xbmc/network/TCPServer.h
+++ b/xbmc/network/TCPServer.h
@@ -16,6 +16,7 @@
 #include "websocket/WebSocket.h"
 
 #include <atomic>
+#include <chrono>
 #include <condition_variable>
 #include <deque>
 #include <memory>
@@ -239,6 +240,10 @@ namespace JSONRPC
     std::condition_variable m_workersDone;
     unsigned int m_activeWorkers{0};
 
+    // Until when the listening sockets are left out of the select, after accept() found no
+    // descriptor or memory for a connection. The server thread's alone.
+    std::chrono::steady_clock::time_point m_acceptResume{};
+
     static std::shared_ptr<CTCPServer> ServerInstance;
   };
 }
-- 
