diff --git a/xbmc/windowing/gbm/drm/DRMOutputChoice.h b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
new file mode 100644
index 0000000..de4d896
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DRMOutputChoice.h
@@ -0,0 +1,212 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Which output Kodi shows itself on
+ *
+ * Kodi drives one output of one graphics device. Of the outputs of a device it used to take
+ * the one named in the settings, or else the first that is connected; and of several devices,
+ * the first that had any such output, without a look at the others. A PC with a display on
+ * each of two graphics cards, or a laptop whose own panel hangs from the integrated graphics
+ * and whose HDMI socket from the other card, then showed Kodi wherever the first device had
+ * a display: on the panel of the laptop, with the TV connected.
+ *
+ * The outputs are ranked here instead, those of every device alike, and the best one is
+ * used: the one named in the settings; then an HDMI output whose display takes Dolby Vision
+ * Standard (two cables to one TV, an input set up for games and another for films), then any
+ * HDMI output, where the TV normally is; then any other output; and last the panel of the
+ * machine itself and a head-mounted display. Of outputs that rank the same the first one is
+ * taken, in the order of the devices and, within a device, of its driver: with one device, or
+ * with one display, nothing changes.
+ *
+ * Only what is decided is here, with nothing of DRM in it, so that it can be tested by itself.
+ */
+struct DRMOutput
+{
+  std::string name; //!< as Kodi names it: "HDMI-A-1"
+  std::string type; //!< "HDMI-A", "DP", "eDP"...
+  //! what tells its device from the others: the driver ("i915", "amdgpu", "nvidia-drm"), with
+  //! the place of the device on its bus when two devices have the same driver
+  std::string device;
+  bool connected{false};
+  //! connected and driven already: Kodi takes over an output that is on (CDRMUtils::FindCrtc)
+  bool usable{false};
+  bool nonDesktop{false}; //!< a head-mounted display
+  bool dolbyVision{false}; //!< its display says that it takes Dolby Vision Standard
+};
+
+inline constexpr int OUTPUT_RANK_NONE = 0; //!< cannot be used
+inline constexpr int OUTPUT_RANK_OWN_PANEL = 1;
+inline constexpr int OUTPUT_RANK_OTHER = 2;
+inline constexpr int OUTPUT_RANK_HDMI = 3;
+inline constexpr int OUTPUT_RANK_HDMI_DOLBY_VISION = 4;
+inline constexpr int OUTPUT_RANK_ASKED = 5;
+
+/*!
+ * \brief The name of an output with its device: "HDMI-A-1 (nvidia-drm)"
+ *
+ * Two devices can each have an output of the same name.
+ */
+inline std::string QualifiedOutputName(const DRMOutput& output)
+{
+  return output.name + " (" + output.device + ")";
+}
+
+/*!
+ * \brief Whether an output is the one named in the settings, by its name or by its name with
+ * its device. "Default", which asks for none, is the name of no output.
+ */
+inline bool IsAskedOutput(const DRMOutput& output, const std::string& asked)
+{
+  return asked == output.name || (!output.device.empty() && asked == QualifiedOutputName(output));
+}
+
+inline int RankOutput(const DRMOutput& output, const std::string& asked)
+{
+  if (!output.usable)
+    return OUTPUT_RANK_NONE;
+  if (IsAskedOutput(output, asked))
+    return OUTPUT_RANK_ASKED;
+  if (output.nonDesktop || output.type == "eDP" || output.type == "LVDS" ||
+      output.type == "DSI" || output.type == "DPI")
+    return OUTPUT_RANK_OWN_PANEL;
+  if (output.type == "HDMI-A")
+    return output.dolbyVision ? OUTPUT_RANK_HDMI_DOLBY_VISION : OUTPUT_RANK_HDMI;
+  return OUTPUT_RANK_OTHER;
+}
+
+/*!
+ * \brief The output to use of those of one device: the first of those of the highest rank
+ * \return its index, or -1 when none of them can be used
+ */
+inline int BestOutput(const std::vector<DRMOutput>& outputs, const std::string& asked)
+{
+  int best = -1;
+  int bestRank = OUTPUT_RANK_NONE;
+  for (std::size_t i = 0; i < outputs.size(); ++i)
+  {
+    const int rank = RankOutput(outputs[i], asked);
+    if (rank > bestRank)
+    {
+      bestRank = rank;
+      best = static_cast<int>(i);
+    }
+  }
+  return best;
+}
+
+/*!
+ * \brief The device to use: the first of those whose best output ranks highest
+ * \param devices the outputs of each device, in the order of the devices; those of a device
+ * that Kodi cannot drive are left out by the caller
+ * \return its index, or -1 when no device has an output that can be used
+ */
+inline int BestDevice(const std::vector<std::vector<DRMOutput>>& devices, const std::string& asked)
+{
+  int best = -1;
+  int bestRank = OUTPUT_RANK_NONE;
+  for (std::size_t i = 0; i < devices.size(); ++i)
+  {
+    const int output = BestOutput(devices[i], asked);
+    const int rank = output < 0 ? OUTPUT_RANK_NONE : RankOutput(devices[i][output], asked);
+    if (rank > bestRank)
+    {
+      bestRank = rank;
+      best = static_cast<int>(i);
+    }
+  }
+  return best;
+}
+
+/*!
+ * \brief Whether a display is connected to an output that nothing drives
+ *
+ * The kernel's console drives the displays of one device only. Those of another are connected
+ * and off until that device is closed by its last user, which makes the kernel turn them on:
+ * the caller, who has just opened and closed every device to look at it, looks once more.
+ */
+inline bool AnyOutputOff(const std::vector<std::vector<DRMOutput>>& devices)
+{
+  for (const auto& outputs : devices)
+  {
+    for (const DRMOutput& output : outputs)
+    {
+      if (output.connected && !output.usable)
+        return true;
+    }
+  }
+  return false;
+}
+
+/*!
+ * \brief What tells each device from the others: its driver, and where two of them have the
+ * same driver, the driver and the place of the device (its address on the bus)
+ * \param drivers the driver of each device
+ * \param places the place of each device
+ */
+inline std::vector<std::string> DeviceNames(const std::vector<std::string>& drivers,
+                                            const std::vector<std::string>& places)
+{
+  std::vector<std::string> names;
+  for (std::size_t i = 0; i < drivers.size(); ++i)
+  {
+    bool shared = false;
+    for (std::size_t j = 0; j < drivers.size(); ++j)
+      shared = shared || (j != i && drivers[j] == drivers[i]);
+    names.emplace_back(shared && i < places.size() && !places[i].empty()
+                           ? drivers[i] + " " + places[i]
+                           : drivers[i]);
+  }
+  return names;
+}
+
+/*!
+ * \brief The names under which the connected outputs of all the devices are offered in the
+ * settings: the name of each and, where another device has a connected output of that name
+ * too, the name with its device
+ */
+inline std::vector<std::string> OfferedOutputNames(
+    const std::vector<std::vector<DRMOutput>>& devices)
+{
+  std::vector<std::string> names;
+  for (std::size_t i = 0; i < devices.size(); ++i)
+  {
+    for (const DRMOutput& output : devices[i])
+    {
+      if (!output.connected)
+        continue;
+      bool shared = false;
+      for (std::size_t j = 0; j < devices.size() && !shared; ++j)
+      {
+        if (j == i)
+          continue;
+        for (const DRMOutput& other : devices[j])
+          shared = shared || (other.connected && other.name == output.name);
+      }
+      names.emplace_back(shared ? QualifiedOutputName(output) : output.name);
+    }
+  }
+  return names;
+}
+
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index 3c45924..b4397a3 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -19,6 +19,8 @@
 
 #include "PlatformDefs.h"
 
+#include <stdexcept>
+
 using namespace KODI::WINDOWING::GBM;
 
 namespace
@@ -41,6 +43,204 @@ void DrmFbDestroyCallback(gbm_bo* bo, void* data)
 
   delete fb;
 }
+
+// The driver of a device: "i915", "amdgpu", "nvidia-drm"
+std::string DriverOf(int fd)
+{
+  std::string driver;
+  if (drmVersionPtr version = drmGetVersion(fd))
+  {
+    if (version->name)
+      driver = version->name;
+    drmFreeVersion(version);
+  }
+  return driver;
+}
+
+// An output as the choice among the outputs looks at it (DRMOutputChoice.h). display: its
+// display is looked at too (the EDID), which the name of the output does not take.
+DRMOutput Describe(CDRMConnector& connector, const std::string& device, bool display)
+{
+  DRMOutput output;
+  output.name = connector.GetName();
+  output.type = connector.GetType();
+  output.device = device;
+  output.connected = connector.IsConnected();
+  output.usable = output.connected && connector.GetEncoderId() > 0;
+  output.nonDesktop = connector.GetPropertyValue("non-desktop").value_or(0) != 0;
+  // (only where it can make a difference)
+  if (display && output.usable && output.type == "HDMI-A" && !output.nonDesktop)
+  {
+    const auto info = KODI::UTILS::CDisplayInfo::Create(connector.GetEDID());
+    output.dolbyVision = info && info->SupportsStandardDolbyVision();
+  }
+  return output;
+}
+
+// One graphics device, as it is found when the outputs of all of them are looked at
+struct SurveyedDevice
+{
+  drmDevicePtr device{nullptr};
+  std::string driver;
+  std::string place; // its address on the bus, or the name of its node
+  std::string name; // what tells it from the others: DeviceNames()
+  std::string unfit; // why Kodi cannot show itself with it; empty when it can
+  std::vector<DRMOutput> outputs;
+};
+
+std::string PlaceOf(drmDevicePtr device)
+{
+  if (device->bustype == DRM_BUS_PCI)
+  {
+    const drmPciBusInfoPtr pci = device->businfo.pci;
+    return fmt::format("{:04x}:{:02x}:{:02x}.{:x}", static_cast<unsigned int>(pci->domain),
+                       static_cast<unsigned int>(pci->bus), static_cast<unsigned int>(pci->dev),
+                       static_cast<unsigned int>(pci->func));
+  }
+
+  const std::string node = device->nodes[DRM_NODE_PRIMARY];
+  return node.substr(node.find_last_of('/') + 1);
+}
+
+// Looks at one device: it is opened for the question and closed again. What is wrong with a
+// device that cannot be asked is not in the way of the others: it has no outputs then.
+// Closing a device that nothing else has open makes the kernel put its console back on it,
+// which turns on the displays connected to it: Survey() relies on that.
+void Look(SurveyedDevice& found, bool atomic)
+{
+  found.outputs.clear();
+  found.unfit.clear();
+
+  const char* node = found.device->nodes[DRM_NODE_PRIMARY];
+  const int fd = open(node, O_RDWR | O_CLOEXEC);
+  if (fd < 0)
+  {
+    found.unfit = "it cannot be opened";
+    return;
+  }
+
+  found.driver = DriverOf(fd);
+
+  if (drmModeResPtr resources = drmModeGetResources(fd))
+  {
+    const std::vector<uint32_t> ids(resources->connectors,
+                                    resources->connectors + resources->count_connectors);
+    drmModeFreeResources(resources);
+
+    try
+    {
+      for (const uint32_t id : ids)
+      {
+        CDRMConnector connector(fd, id);
+        found.outputs.emplace_back(Describe(connector, "", true));
+      }
+    }
+    catch (const std::runtime_error& error)
+    {
+      CLog::LogF(LOGWARNING, "{}: {}", node, error.what());
+      found.outputs.clear();
+      found.unfit = "its outputs cannot be read";
+    }
+  }
+  else
+    found.unfit = "it has no outputs";
+
+  // Kodi draws with the device that it shows itself on: a device that only shows what
+  // another one draws (a USB display, the framebuffer that the firmware left) is not for it.
+  if (found.unfit.empty() && !(found.device->available_nodes & 1 << DRM_NODE_RENDER))
+    found.unfit = "it cannot draw";
+
+  if (found.unfit.empty() && atomic && drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) != 0)
+    found.unfit = "it has no atomic modesetting";
+
+  close(fd);
+}
+
+// The outputs of each device for the choice: those of a device that Kodi cannot show itself
+// with are left out
+std::vector<std::vector<DRMOutput>> FitOutputs(const std::vector<SurveyedDevice>& found)
+{
+  std::vector<std::vector<DRMOutput>> outputs;
+  for (const SurveyedDevice& device : found)
+    outputs.emplace_back(device.unfit.empty() ? device.outputs : std::vector<DRMOutput>());
+  return outputs;
+}
+
+// All the graphics devices and their outputs. Empty with fewer than two devices: there is
+// nothing to choose then, and nothing is opened for it.
+std::vector<SurveyedDevice> Survey(const std::vector<drmDevicePtr>& devices, bool atomic)
+{
+  std::vector<SurveyedDevice> found;
+  for (const auto device : devices)
+  {
+    if (!device || !(device->available_nodes & 1 << DRM_NODE_PRIMARY))
+      continue;
+
+    found.emplace_back();
+    found.back().device = device;
+    found.back().place = PlaceOf(device);
+  }
+
+  if (found.size() < 2)
+    return {};
+
+  const auto look = [&found, atomic]()
+  {
+    std::vector<std::string> drivers;
+    std::vector<std::string> places;
+    for (SurveyedDevice& device : found)
+    {
+      Look(device, atomic);
+      drivers.emplace_back(device.driver);
+      places.emplace_back(device.place);
+    }
+
+    const std::vector<std::string> names = DeviceNames(drivers, places);
+    for (std::size_t i = 0; i < found.size(); ++i)
+    {
+      found[i].name = names[i];
+      for (DRMOutput& output : found[i].outputs)
+        output.device = names[i];
+    }
+  };
+
+  look();
+
+  // The console of the kernel drives the displays of one device only: a display on another
+  // device is connected and off, and Kodi takes over an output that is on. Having been closed
+  // just now, each device has turned on what is connected to it (see Look()), so that a second
+  // look finds it on. Without it the first start after a boot would show Kodi on one display
+  // and every later one on another.
+  if (AnyOutputOff(FitOutputs(found)))
+    look();
+
+  return found;
+}
+
+// Told without debug logging too: with two devices, which display Kodi came up on, and why not
+// on the other, is the first thing that is asked.
+void Tell(const std::vector<SurveyedDevice>& found, int best)
+{
+  for (std::size_t i = 0; i < found.size(); ++i)
+  {
+    std::string displays;
+    for (const DRMOutput& output : found[i].outputs)
+    {
+      if (!output.connected)
+        continue;
+      if (!displays.empty())
+        displays += ", ";
+      displays += output.name;
+      displays += !output.usable ? " (connected, off)"
+                                 : output.dolbyVision ? " (on, Dolby Vision)" : " (on)";
+    }
+
+    CLog::LogF(LOGINFO, "{} ({}): {}{}{}", found[i].device->nodes[DRM_NODE_PRIMARY],
+               found[i].name, displays.empty() ? std::string("no display") : displays,
+               found[i].unfit.empty() ? std::string() : "; not for Kodi: " + found[i].unfit,
+               static_cast<int>(i) == best ? "; this is the device that is used" : "");
+  }
+}
 } // namespace
 
