From 620c098588255446cb0debbdbd271ad76fcc076f Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Wed, 28 Oct 2026 19:37:32 +0000
Subject: [PATCH] [cmake][addons] Package each Windows add-on in a folder of
 its own

On Windows an add-on is packaged under %TEMP% to keep its paths short,
so every add-on, platform and Kodi version built on the same machine
shared %TEMP%/_CPack_Packages/<system>/ZIP. Jenkins packages the x86_64,
ARM64 and 32-bit builds of an add-on at the same time, and can package
it for two Kodi versions at once, so one build would delete or rewrite
the folder while another was filling it, failing at random.

Each add-on, platform and Kodi version now gets its own folder under
%TEMP%, which is still short.
---
 cmake/scripts/common/AddonHelpers.cmake | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/cmake/scripts/common/AddonHelpers.cmake b/cmake/scripts/common/AddonHelpers.cmake
index a77a30a..8db6c98 100644
--- a/cmake/scripts/common/AddonHelpers.cmake
+++ b/cmake/scripts/common/AddonHelpers.cmake
@@ -308,13 +308,18 @@ macro (build_addon target prefix libs)
       if(NOT CPACK_PACKAGE_DIRECTORY)
         # determine the temporary path
         file(TO_CMAKE_PATH "$ENV{TEMP}" WIN32_TEMP_PATH)
+        # a folder of its own, as other add-ons, platforms and Kodi versions can be packaged at the same time
+        set(WIN32_PACKAGE_PATH "${WIN32_TEMP_PATH}/${target}-${PLATFORM_TAG}-${APP_VERSION_MAJOR}")
         string(LENGTH "${WIN32_TEMP_PATH}" WIN32_TEMP_PATH_LENGTH)
+        string(LENGTH "${WIN32_PACKAGE_PATH}" WIN32_PACKAGE_PATH_LENGTH)
         string(LENGTH "${PROJECT_BINARY_DIR}" PROJECT_BINARY_DIR_LENGTH)
 
         # check if the temporary path is shorter than the default packaging directory path
-        if(WIN32_TEMP_PATH_LENGTH GREATER 0 AND WIN32_TEMP_PATH_LENGTH LESS PROJECT_BINARY_DIR_LENGTH)
+        if(WIN32_TEMP_PATH_LENGTH GREATER 0 AND WIN32_PACKAGE_PATH_LENGTH LESS PROJECT_BINARY_DIR_LENGTH)
           # set the directory used by CPack for packaging to the temp directory
-          set(CPACK_PACKAGE_DIRECTORY ${WIN32_TEMP_PATH})
+          set(CPACK_PACKAGE_DIRECTORY ${WIN32_PACKAGE_PATH})
+        else()
+          set(CPACK_PACKAGE_DIRECTORY ${CMAKE_BINARY_DIR})
         endif()
       endif()
 
