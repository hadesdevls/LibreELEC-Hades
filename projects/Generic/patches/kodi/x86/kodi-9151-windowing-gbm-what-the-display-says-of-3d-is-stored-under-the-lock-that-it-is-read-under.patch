From 0e4d276564d21e486526504e5c8d24fc10f9dc87 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:58:33 +0000
Subject: [PATCH] windowing/gbm: what the display says of 3D is stored under
 the lock that it is read under

UpdateResolutions() stored the word of the display on 3D after it had
let go of the lock under which SetStereoEdid() stores it from a thread
of the player. A change of the Monitor setting in the instant in which a
video starts on a display whose EDID changed could have left the older
of the two.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 99933ba..342c180 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -368,8 +368,9 @@ void CWinSystemGbm::UpdateResolutions()
     std::unique_lock lock(m_infoLock);
     m_stereoModes = std::move(modes);
     stereoDisplay = STEREO::TakesStereo(m_stereoModes, m_stereoEdid);
+    // (under the lock, as SetStereoEdid() stores it from the thread of the player)
+    m_stereoDisplay = stereoDisplay;
   }
-  m_stereoDisplay = stereoDisplay;
   CLog::Log(LOGINFO, "3D output: the display {} that it takes stereoscopic 3D",
             stereoDisplay ? "says" : "does not say");
 }
