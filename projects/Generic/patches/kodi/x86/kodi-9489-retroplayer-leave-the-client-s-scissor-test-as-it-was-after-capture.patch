From b322a3eb0e35ea6537d75173748d13137dddde25 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 20 Oct 2026 07:58:16 +0100
Subject: [PATCH] [RetroPlayer] Leave the client's scissor test as it was after
 capture

The capture runs in the client's own context once a frame. Dolphin
switches the scissor test on only after its own clears, so with the
capture leaving it off, Wii Sports Resort's blur passes cover the whole
picture.

(cherry picked from commit f4e06248b9e76bc304c39c13e90b2b582a91f544)
---
 .../buffers/RenderBufferPoolFBO.cpp           |  3 +++
 .../test/TestHwRenderingContextOSX.mm         |  2 +-
 .../test/TestRenderBufferPoolFBO.cpp          | 23 +++++++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.cpp b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.cpp
index ce98d57..e950992 100644
--- a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.cpp
+++ b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.cpp
@@ -317,6 +317,7 @@ IRenderBuffer* CRenderBufferPoolFBO::CaptureClientFrame(IRenderBuffer* clientBuf
   GLint prevRead = 0, prevDraw = 0;
   glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+  const GLboolean scissorEnabled = glIsEnabled(GL_SCISSOR_TEST);
   glDisable(GL_SCISSOR_TEST);
   glBindFramebuffer(GL_READ_FRAMEBUFFER, client->GetCurrentFramebuffer());
   GLint prevReadBuffer = 0;
@@ -335,6 +336,8 @@ IRenderBuffer* CRenderBufferPoolFBO::CaptureClientFrame(IRenderBuffer* clientBuf
   glReadBuffer(prevReadBuffer);
   glBindFramebuffer(GL_READ_FRAMEBUFFER, prevRead);
   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, prevDraw);
+  if (scissorEnabled)
+    glEnable(GL_SCISSOR_TEST);
 
   if (!ready)
   {
diff --git a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
index ae976f1..4d13183 100644
--- a/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
+++ b/xbmc/cores/RetroPlayer/rendering/test/TestHwRenderingContextOSX.mm
@@ -832,7 +832,7 @@ TEST_F(TestRenderBufferPoolFBOOSX, CaptureNormalizesBothOriginsWithinLargerClien
       EXPECT_EQ(binding, framebuffer);
       glGetIntegerv(GL_READ_BUFFER, &binding);
       EXPECT_EQ(binding, GL_NONE);
-      EXPECT_FALSE(glIsEnabled(GL_SCISSOR_TEST));
+      EXPECT_TRUE(glIsEnabled(GL_SCISSOR_TEST));
       std::array<GLint, 4> viewport{};
       glGetIntegerv(GL_VIEWPORT, viewport.data());
       EXPECT_EQ(viewport, (std::array<GLint, 4>{1, 2, 3, 4}));
diff --git a/xbmc/cores/RetroPlayer/rendering/test/TestRenderBufferPoolFBO.cpp b/xbmc/cores/RetroPlayer/rendering/test/TestRenderBufferPoolFBO.cpp
index 7bdca53..865674e 100644
--- a/xbmc/cores/RetroPlayer/rendering/test/TestRenderBufferPoolFBO.cpp
+++ b/xbmc/cores/RetroPlayer/rendering/test/TestRenderBufferPoolFBO.cpp
@@ -449,6 +449,29 @@ TEST_P(TestRenderBufferPoolFBOWithContext, ClientFramebufferRemainsStableAcrossS
   client->Release();
 }
 
+TEST_P(TestRenderBufferPoolFBOWithContext, CaptureLeavesClientScissorTestAsItWas)
+{
+  auto* client = m_pool->GetBuffer(4, 4);
+  ASSERT_NE(client, nullptr);
+
+  // Clients such as Dolphin track what they have enabled and don't set it again
+  for (const bool scissor : {true, false})
+  {
+    if (scissor)
+      glEnable(GL_SCISSOR_TEST);
+    else
+      glDisable(GL_SCISSOR_TEST);
+
+    auto* captured = Capture(client);
+    ASSERT_NE(captured, nullptr);
+    EXPECT_EQ(glIsEnabled(GL_SCISSOR_TEST), scissor ? GL_TRUE : GL_FALSE);
+    captured->Release();
+  }
+
+  EXPECT_EQ(glGetError(), GL_NO_ERROR);
+  client->Release();
+}
+
 TEST_P(TestRenderBufferPoolFBOWithContext, RenderedCaptureCannotBeReusedBeforeGUIHandoff)
 {
   auto* client = m_pool->GetBuffer(4, 4);
-- 
2.53.0

