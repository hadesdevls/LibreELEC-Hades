From beb86affa81c2095d038f9247204b11684bf95fb Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:06:22 +0000
Subject: [PATCH] AEStreamParser: test the codec family a passthrough stream is
 parsed for

The previous commit has the parser look only for the family of codecs the demuxer named. Tests:
bytes that pass as an E-AC-3 header are taken for E-AC-3 by a parser that expects nothing, and not
by one that expects TrueHD or DTS-HD MA; AC-3 and E-AC-3 are one family; DTS frames are taken for
a DTS stream and not for TrueHD or E-AC-3.

Measured with TrueHD encoded by FFmpeg 9.0.2 (5.1 and 2.0, a major sync every 16 or every 128
access units) and fed to the parser from every access unit that is not a major sync, and from a
byte inside it, as after a seek: 4507 of 370500 start points were taken for E-AC-3 first (up to 3.1%
with a major sync every 128 access units), and none since.
---
 .../Utils/test/TestAEStreamParser.cpp         | 85 +++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
index 1ec9a08..523989f 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEStreamParser.cpp
@@ -103,6 +103,40 @@ std::vector<CAEStreamInfo::DataType> Parse(std::vector<uint8_t> stream,
   }
   return types;
 }
+
+//! An E-AC-3 frame of 512 bytes, 48 kHz, 6 blocks, 3/2 without LFE: what a few bytes of another
+//! stream can read as, as its header is not checked with a CRC.
+std::vector<uint8_t> Eac3Frame()
+{
+  std::vector<uint8_t> frame(512, 0x5A);
+  const uint8_t header[] = {0x0B, 0x77, 0x00, 0xFF, 0x3E, 0x80};
+  std::copy(std::begin(header), std::end(header), frame.begin());
+  return frame;
+}
+
+//! The types of the frames a parser that expects \p expected hands out
+std::vector<CAEStreamInfo::DataType> ParseExpecting(const std::vector<uint8_t>& stream,
+                                                    CAEStreamInfo::DataType expected)
+{
+  CAEStreamParser parser;
+  parser.SetExpectedType(expected);
+  std::vector<CAEStreamInfo::DataType> types;
+  size_t pos = 0;
+  while (pos < stream.size())
+  {
+    uint8_t* out = nullptr;
+    unsigned int outSize = 0;
+    const int used = parser.AddData(const_cast<uint8_t*>(stream.data()) + pos,
+                                    static_cast<unsigned int>(stream.size() - pos), &out, &outSize);
+    delete[] out;
+    if (outSize > 0)
+      types.push_back(parser.GetDataType());
+    if (used <= 0 && outSize == 0)
+      break;
+    pos += used;
+  }
+  return types;
+}
 } // namespace
 
 //! After a flush the first bytes can hold a core frame cut from its extension. Taking it as a
@@ -222,3 +256,54 @@ TEST(TestAEStreamParser, ADtsHdHraStreamIsStillHra)
   for (const CAEStreamInfo::DataType type : types)
     EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_DTSHD, type);
 }
+
+//! After a seek a TrueHD stream starts inside an access unit, and its bytes can pass as an E-AC-3
+//! header: a parser that expects TrueHD does not take them for E-AC-3, one that expects nothing does.
+TEST(TestAEStreamParser, BytesThatPassAsEac3AreNotTakenForItInTrueHD)
+{
+  std::vector<uint8_t> stream;
+  for (int i = 0; i < 4; ++i)
+    Append(stream, Eac3Frame());
+
+  const std::vector<CAEStreamInfo::DataType> any =
+      ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_NULL);
+  ASSERT_FALSE(any.empty());
+  for (const CAEStreamInfo::DataType type : any)
+    EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_EAC3, type);
+
+  EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_TRUEHD).empty());
+  EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_DTSHD_MA).empty());
+}
+
+//! The family of AC-3: a stream that the demuxer says is AC-3 or E-AC-3 is still found as E-AC-3
+TEST(TestAEStreamParser, TheAc3FamilyTakesEac3)
+{
+  std::vector<uint8_t> stream;
+  for (int i = 0; i < 4; ++i)
+    Append(stream, Eac3Frame());
+
+  for (const auto expected : {CAEStreamInfo::STREAM_TYPE_AC3, CAEStreamInfo::STREAM_TYPE_EAC3})
+  {
+    const std::vector<CAEStreamInfo::DataType> types = ParseExpecting(stream, expected);
+    ASSERT_FALSE(types.empty());
+    for (const CAEStreamInfo::DataType type : types)
+      EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_EAC3, type);
+  }
+}
+
+//! The family of DTS: DTS-HD MA expected, DTS-HD MA found; TrueHD or AC-3 expected, nothing
+TEST(TestAEStreamParser, TheDtsFamilyIsOnlyDts)
+{
+  std::vector<uint8_t> stream;
+  for (int i = 0; i < 4; ++i)
+    Append(stream, MaFrame());
+
+  const std::vector<CAEStreamInfo::DataType> types =
+      ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_DTSHD_MA);
+  ASSERT_FALSE(types.empty());
+  for (const CAEStreamInfo::DataType type : types)
+    EXPECT_EQ(CAEStreamInfo::STREAM_TYPE_DTSHD_MA, type);
+
+  EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_TRUEHD).empty());
+  EXPECT_TRUE(ParseExpecting(stream, CAEStreamInfo::STREAM_TYPE_EAC3).empty());
+}
