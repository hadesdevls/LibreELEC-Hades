 .../skin.estuary/language/resource.language.en_gb/strings.po  | 2 +-
 .../skin.estuary/language/resource.language.es_ar/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_es/strings.po  | 4 ++--
 .../skin.estuary/language/resource.language.es_mx/strings.po  | 4 ++--
 5 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 02b1a93..00d51fe 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25390,7 +25390,7 @@ msgstr ""
 #. Hades: help of setting "videoscreen.hadesdvhdr10curve"; translated in Estuary (#31785)
 #: system/settings/settings.xml
 msgctxt "#39845"
-msgid "BT.2390: the curve of ITU-R BT.2390, which keeps what is well below the display's peak nearly as it was mastered and compresses only the brightest part. Spline: libplacebo's own default, which also darkens the middle tones of a shot to keep its contrast, more the brighter the shot is than the display. With either, a shot brighter than the display can show is made a little darker as a whole, to keep room for its highlights."
+msgid "BT.2390: the curve of ITU-R BT.2390, which keeps what is well below the display's peak nearly as it was mastered and compresses only the brightest part. Spline: libplacebo's own default, which also darkens the middle tones and the shadows of a shot to keep its contrast, more the brighter the shot is than the display. With either, a shot brighter than the display can show is made a little darker as a whole, to keep room for its highlights."
 msgstr ""
 
