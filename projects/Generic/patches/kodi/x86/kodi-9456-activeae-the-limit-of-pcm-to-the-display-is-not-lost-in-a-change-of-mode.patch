+                m_settings.device, most,
+                kept ? "the audio data it had last: it has none at this moment, as during a "
+                       "change of display mode"
+                     : "its audio data",
+                AE::PCM::ChannelsOfLayout(limited),
                 CAEUtil::GetStdChLayoutName(static_cast<AEStdChLayout>(limited)),
