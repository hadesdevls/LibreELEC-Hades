   }
   m_settings.channels = limited;
 }
 
+AE::PCM::DisplayAudio CActiveAE::DisplayAudioOf(const std::string& device, bool* kept)
+{
+  if (kept)
+    *kept = false;
+  AE::PCM::DisplayAudio read;
+  bool displayThere = false;
+  if (!m_sink.GetDisplayAudio(device, read, displayThere))
+    return {};
+
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+  const AE::PCM::DisplayAudio used =
+      AE::PCM::KeepWhileAway(read, displayThere, m_keptDisplayAudio[dev.driver + ':' + dev.name]);
+  if (kept)
+    *kept = !displayThere && !(used == AE::PCM::DisplayAudio{});
+  return used;
+}
+
 std::string CActiveAE::ResolveOutput(const std::string& device,
                                      const std::string& followedBefore,
                                      bool passthrough,
