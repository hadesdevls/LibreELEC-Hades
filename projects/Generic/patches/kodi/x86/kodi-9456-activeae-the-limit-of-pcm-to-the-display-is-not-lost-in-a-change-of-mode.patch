 {
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  bool kept = false;
   const unsigned int most = !advanced || advanced->m_audioPcmChannelsFromEld
-                                ? m_sink.GetMaxPcmChannels(m_settings.device)
+                                ? DisplayAudioOf(m_settings.device, &kept).pcm
                                 : 0;
   const int limited = AE::PCM::LimitLayout(m_settings.channels, most);
   // in the log when it changes
   const std::string told = limited != m_settings.channels
                                ? m_settings.device + '|' + std::to_string(m_settings.channels) +
-                                     '|' + std::to_string(most)
+                                     '|' + std::to_string(most) + (kept ? "|kept" : "")
                                : std::string();
   if (told != m_channelsLimitTold)
   {
     m_channelsLimitTold = told;
     if (!told.empty())
       CLog::Log(LOGINFO,
-                "ActiveAE - the display of '{}' takes PCM in {} channels at most (its audio "
-                "data): PCM goes out in up to {} channels ({}), not {} (the setting is not "
-                "changed)",
-                m_settings.device, most, AE::PCM::ChannelsOfLayout(limited),
+                "ActiveAE - the display of '{}' takes PCM in {} channels at most ({}): PCM goes "
