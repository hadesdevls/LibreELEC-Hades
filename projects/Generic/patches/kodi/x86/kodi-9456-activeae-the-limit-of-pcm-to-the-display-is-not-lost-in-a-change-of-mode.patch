@@ -1053,6 +1059,12 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
         case CActiveAEControlProtocol::DEVICECHANGE:
         case CActiveAEControlProtocol::DEFAULTDEVICECHANGE:
         case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
+          // Hades: not acted on while suspended, as before, but not forgotten: a change of display
+          // mode takes the audio of an HDMI output away and brings it back (amdgpu tells the audio
