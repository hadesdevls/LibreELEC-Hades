+
+//! What the engine takes from the audio data of the display of an output
+struct DisplayAudio
+{
+  //! the most channels of linear PCM (MaxChannelsOfEld()); 0, not known
+  unsigned int pcm{0};
+
+  constexpr bool operator==(const DisplayAudio&) const = default;
+};
+
+/*!
+ * \brief The audio data that the engine takes for an output, at one listing of the outputs
+ *
+ * A change of display mode takes the audio of an HDMI output away and brings it back: amdgpu
+ * tells the HDA HDMI codec that the audio of the output is gone, and that it is back, in a commit
+ * that sets a mode (amdgpu_dm_commit_audio()), and in between the codec has no valid ELD. A
+ * listing of the outputs that falls there finds no audio data, and the channels of PCM were then
+ * not limited: a TV that takes PCM in 2 channels was sent 5.1 for the rest of a film (2026-10-21,
+ * a DTS track decoded to 5.1 PCM, an LG C5 on the HDMI output of the integrated graphics). While
+ * the display of an output is away, its audio data are the last ones read from a display of that
+ * output in this run.
+ *
+ * \param read what this listing read of the output
+ * \param displayThere the driver says that a display is there, with audio data (a valid ELD)
+ * \param kept what is kept of this output; updated to read where the display is there
+ * \return read where the display is there; else what is kept (nothing when no display of this
+ *         output had audio data in this run, as before)
+ */
+inline DisplayAudio KeepWhileAway(const DisplayAudio& read, bool displayThere, DisplayAudio& kept)
+{
+  if (displayThere)
+    kept = read;
+  return kept;
+}
 } // namespace AE::PCM
diff --git a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
index 5baf3d3..058f504 100644
--- a/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
+++ b/xbmc/cores/AudioEngine/Utils/test/TestAEPcmChannels.cpp
@@ -112,6 +112,56 @@ TEST(TestAEPcmChannels, AnEldThatDoesNotHoldItsDescriptors)
   EXPECT_EQ(0u, MaxOfEld(name, name.size()));
 }
 
+TEST(TestAEPcmChannels, TheAudioDataOfADisplayThatIsThere)
+{
+  DisplayAudio kept;
+  EXPECT_EQ(2u, KeepWhileAway({2}, true, kept).pcm);
+  EXPECT_EQ(2u, kept.pcm);
+  // a display that is there gives what it says, also more, less, or nothing known
+  EXPECT_EQ(8u, KeepWhileAway({8}, true, kept).pcm);
+  EXPECT_EQ(6u, KeepWhileAway({6}, true, kept).pcm);
+  EXPECT_EQ(0u, KeepWhileAway({0}, true, kept).pcm);
+  EXPECT_EQ(0u, kept.pcm);
+}
+
+TEST(TestAEPcmChannels, TheAudioDataKeptWhileTheDisplayIsAway)
+{
+  // A start of 2026-10-21 on the integrated graphics: the LG C5 declared PCM
+  // in 2 channels, "Number of channels" was 7.1, and a DTS track in 5.1 was decoded. The outputs
+  // were listed when Kodi started (the TV there), then in the change of mode to the video and
+  // after it stopped, both while the codec had no valid ELD of the TV (its output "none"), and
+  // never again. Before: no limit after the second listing, and the sink opened 6 channels for the
+  // rest of the film.
+  constexpr int L2_0 = 1, L7_1 = 10;
+  DisplayAudio kept;
+  const unsigned int started = KeepWhileAway({MaxChannelsOfEld(Eld("LG TV SSCR2", LG_2).data(),
+                                                                Eld("LG TV SSCR2", LG_2).size())},
+                                             true, kept)
+                                   .pcm;
+  EXPECT_EQ(L2_0, LimitLayout(L7_1, started));
+  // the change of mode (01:25:39) and the stop (01:26:49): the output has no audio data
+  const unsigned int inTheChange = KeepWhileAway({0}, false, kept).pcm;
+  EXPECT_EQ(2u, inTheChange);
+  EXPECT_EQ(L2_0, LimitLayout(L7_1, inTheChange));
+  const unsigned int afterTheStop = KeepWhileAway({0}, false, kept).pcm;
+  EXPECT_EQ(L2_0, LimitLayout(L7_1, afterTheStop));
+  // the TV back with its sound bar's audio data (8 channels): those
+  EXPECT_EQ(L7_1, LimitLayout(L7_1, KeepWhileAway({8}, true, kept).pcm));
+  // and away again: the 8 it had last, not the 2 of before
+  EXPECT_EQ(8u, KeepWhileAway({0}, false, kept).pcm);
+}
+
+TEST(TestAEPcmChannels, NothingKeptOfAnOutputThatNeverHadAudioData)
+{
+  // an output whose display never had audio data in this run (a monitor without audio, an output
+  // with nothing on it): nothing to keep, no limit, as before
+  DisplayAudio kept;
+  EXPECT_EQ(0u, KeepWhileAway({0}, false, kept).pcm);
+  EXPECT_EQ(0u, KeepWhileAway({0}, false, kept).pcm);
+  constexpr int L7_1 = 10;
+  EXPECT_EQ(L7_1, LimitLayout(L7_1, KeepWhileAway({0}, false, kept).pcm));
+}
+
 TEST(TestAEPcmChannels, ChannelsOfTheLayouts)
 {
   const unsigned int channels[] = {1, 2, 3, 3, 4, 4, 5, 5, 6, 7, 8};
