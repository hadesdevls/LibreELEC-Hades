From 5132781aa547e654eaa8c0704968e13aff7f7bca Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:22:32 +0000
Subject: [PATCH] windowing/gbm: the reason given for an amdgpu without the
 tunnel takes the name of the driver read when the device was opened

SupportsNativeDVOutput() is asked with each picture of a Dolby Vision
video: CLinuxRendererGLES::ConfigChanged(), which the render manager calls
for every picture, asks WantsDVBridge() and WantsDVConversion(). Where the
display takes Dolby Vision and the driver of its HDMI connector has no
tunnel (amdgpu on the DCE display cores of Polaris and Vega, nouveau),
the reason that it gives asked the kernel for the name of the driver
with drmGetVersion() each time, to tell amdgpu apart: two ioctls and
four allocations for each picture of a video that plays converted to
HDR10, on the thread of the video.

CDRMUtils keeps the name that it reads when it opens the device (where it
sets QUIRK_NEEDSPRIMARY for amdgpu already, with the same call), and
DriverName() gives it. The reason is the same. A check of the source (the
window system is not built on the host) fails without this and passes
with it.
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 19 +++++++------------
 xbmc/windowing/gbm/drm/DRMUtils.cpp |  4 ++++
 xbmc/windowing/gbm/drm/DRMUtils.h   |  5 +++++
 3 files changed, 16 insertions(+), 12 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 8704bb9..e14c74c 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -1443,18 +1443,13 @@ bool CWinSystemGbm::SupportsNativeDVOutput(bool anyMode, bool report) const
     // Hades: amdgpu offers the tunnel on its DCN display cores only; on DCE 11.2 to 12 (Polaris,
     // Vega) it is not offered unless the kernel is told so (amdgpu.dvbridge_dce=1): the one
     // display tried with it, on an RX 550, showed the Dolby Vision logo and black (the reason code
-    // stays "output", which the player information already names)
-    if (drmVersionPtr version = m_DRM ? drmGetVersion(m_DRM->GetFileDescriptor()) : nullptr)
-    {
-      if (version->name && std::string_view(version->name) == "amdgpu")
-      {
-        reason = "the amdgpu driver offers no Dolby Vision tunnel on this graphics chip: on the "
-                 "display cores of Polaris and Vega (DCE) it is not offered unless the kernel is "
-                 "told so (amdgpu.dvbridge_dce=1), because it has not been seen to show a picture "
-                 "there (the kernel log says so); Dolby Vision plays converted to HDR10";
-      }
-      drmFreeVersion(version);
-    }
+    // stays "output", which the player information already names). (The driver as it was read when
+    // the device was opened: this is asked with each picture of a Dolby Vision video.)
+    if (m_DRM && m_DRM->DriverName() == "amdgpu")
+      reason = "the amdgpu driver offers no Dolby Vision tunnel on this graphics chip: on the "
+               "display cores of Polaris and Vega (DCE) it is not offered unless the kernel is "
+               "told so (amdgpu.dvbridge_dce=1), because it has not been seen to show a picture "
+               "there (the kernel log says so); Dolby Vision plays converted to HDR10";
   }
   else if (lowLatency && !COutputHandover::SupportsLowLatency(*connector))
   {
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.cpp b/xbmc/windowing/gbm/drm/DRMUtils.cpp
index aedf52b..552c890 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -1015,8 +1015,12 @@ bool CDRMUtils::OpenDrm(bool needConnector, bool atomic)
     CLog::LogF(LOGDEBUG, "Opened device: {}", device->nodes[DRM_NODE_PRIMARY]);
 
     drmVersionPtr version = drmGetVersion(m_fd);
+    m_driverName.clear();
     if (version)
     {
+      // Hades: kept (DriverName())
+      if (version->name)
+        m_driverName = version->name;
       if (strcmp(version->name, "amdgpu") == 0)
         m_drm_quirks |= QUIRK_NEEDSPRIMARY;
       drmFreeVersion(version);
diff --git a/xbmc/windowing/gbm/drm/DRMUtils.h b/xbmc/windowing/gbm/drm/DRMUtils.h
index 050d963..7dce04e 100644
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -146,6 +146,10 @@ public:
   // means "video is over" states it here before revalidating the gui plane.
   void ReleaseVideoPlane() { m_video_plane = nullptr; }
   bool HasQuirk(int quirk) const { return m_drm_quirks & quirk; }
+  //! Hades: the name of the driver of the device ("amdgpu", "i915", "nvidia-drm"...), as it was read
+  //! when the device was opened; empty where it could not be read. For what is asked with each
+  //! picture, without a call to the kernel
+  const std::string& DriverName() const { return m_driverName; }
 
   //! \param now (Hades) the outputs of this device as they are now (OwnOutputs()), not as Kodi
   //!        read them last
@@ -453,6 +457,7 @@ private:
   const char* m_renderDevicePath{nullptr};
 
   int m_drm_quirks{0};
+  std::string m_driverName; //!< Hades: see DriverName()
   //! Hades: see SetStartChoice()
   static inline std::optional<std::string> s_startUse;
   static inline std::vector<std::string> s_startExclude;
-- 
2.53.0

