From c90f6178604390516ca71161f4c6a5c2a7e42311 Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sat, 17 Oct 2026 21:05:05 +0100
Subject: [PATCH] [dialogs] CGUIDialogExtendedProgressBar: Open dialog
 asynchronously

GetHandle() opened the dialog with CGUIDialog::Open(), which from a worker
thread does a synchronous SendMsg to the GUI thread. On system sleep the GUI
thread stops and joins the PVR EPG updater, which in turn joins its
CPVRGUIProgressHandler thread. If that thread is inside GetHandle() at this
point it waits for the GUI thread, which waits for it: Kodi hangs until
killed.

Post TMSG_GUI_DIALOG_OPEN instead. The handle is registered before the
message is posted, so the dialog has content when the GUI thread opens it,
and the modeless open path is unchanged. The window is addressed by id, so
no raw pointer sits in the message queue.

Fixes https://github.com/xbmc/xbmc/issues/29720

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 xbmc/dialogs/GUIDialogExtendedProgressBar.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xbmc/dialogs/GUIDialogExtendedProgressBar.cpp b/xbmc/dialogs/GUIDialogExtendedProgressBar.cpp
index f7e536f..01540c2 100644
--- a/xbmc/dialogs/GUIDialogExtendedProgressBar.cpp
+++ b/xbmc/dialogs/GUIDialogExtendedProgressBar.cpp
@@ -8,8 +8,10 @@
 
 #include "GUIDialogExtendedProgressBar.h"
 
+#include "ServiceBroker.h"
 #include "guilib/GUIMessage.h"
 #include "guilib/GUIProgressControl.h"
+#include "messaging/ApplicationMessenger.h"
 #include "utils/TimeUtils.h"
 
 #include <cmath>
@@ -63,7 +65,10 @@ CGUIDialogProgressBarHandle *CGUIDialogExtendedProgressBar::GetHandle(const std:
     m_handles.push_back(handle);
   }
 
-  Open();
+  // Open asynchronously. Callers mostly run on worker threads and must not block waiting for
+  // the GUI thread, which may itself be blocked joining the calling thread (e.g. when the PVR
+  // EPG updater is stopped on system sleep).
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_GUI_DIALOG_OPEN, GetID());
 
   return handle;
 }
