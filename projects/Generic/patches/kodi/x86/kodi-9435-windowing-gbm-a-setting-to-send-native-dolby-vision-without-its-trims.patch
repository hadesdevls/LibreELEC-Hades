+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -469,6 +469,8 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   dvbridge_render_set_ll_pattern(m_renderer, m_lowLatencyOn && m_llPattern);
   // Hades: and the display management version that UseDisplayManagement() was given
   dvbridge_render_set_display_management(m_renderer, m_displayManagement);
+  // ... and whether the display is sent the trims (SendTrims())
+  dvbridge_render_send_trims(m_renderer, m_trimsWanted);
   pl_opengl_wrap_params output{};
   output.width = 3840;
   output.height = 2160;
@@ -1137,6 +1139,12 @@ void CDVBridgeGLES::UseDisplayManagement(unsigned int version)
