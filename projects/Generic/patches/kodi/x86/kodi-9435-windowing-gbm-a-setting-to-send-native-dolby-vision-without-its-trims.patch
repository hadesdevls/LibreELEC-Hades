+  static constexpr auto SETTING_VIDEOSCREEN_HADESDVNOTRIMS = "videoscreen.hadesdvnotrims";
   //! Hades: Dolby Vision sent as HDR10 is mapped to the display (0: no, as mastered; 1: to the
