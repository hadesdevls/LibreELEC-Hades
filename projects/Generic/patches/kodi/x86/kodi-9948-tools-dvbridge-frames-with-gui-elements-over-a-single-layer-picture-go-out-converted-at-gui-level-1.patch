From cfd66bad414301ae90713437cbcb5ab75ca12e4c Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:11:48 +0000
Subject: [PATCH] tools/dvbridge: frames with GUI elements over a single-layer
 picture go out converted at GUI level 1

A frame with GUI elements over a picture that the source transport carries
in YCbCr without the residual of an enhancement layer (HDR10 and HDR10+ sent
as Dolby Vision, profile 8, profile 7 whose layer is not drawn) had no
remedy on a GPU where those frames do not keep up: the step-down ladder of
such a picture has no level below the faithful one, and the levels of the
conversion under the GUI were those of profile 5 only. In the source
transport those frames draw the picture that the GUI is composited over
(pass 3) and convert back what is drawn over it (pass 4); the converted
transport packs the picture that the GUI is composited into anyway.

Measured on Mesa's software OpenGL ES at 3840x2160 with Kodi's composite
under its scissor, a single layer: a band of GUI over 14 % of the raster
91.0 ms a frame in the source transport, 72.9 converted (zink: 107.7 and
88.5); a panel over half of it 124.6 and 82.5 (147.5 and 98.4). Without
GUI elements the source transport is the cheaper one (53.5 against 69.2),
so only frames with GUI elements change, and only at level 1 of the
conversion under the GUI (dvbridge_render_gui_level()), which the caller
asks for where those frames are measured not to keep up. What it changes,
on ten pictures of an HDR10+ stream against the decoded picture: the luma
of 99.95 % of the pixels the same, 0.045 % one code of 4095 apart, 0.0015 %
more (36 at most, colours that BT.2020 RGB clamps); the chroma of its sited
rows the same but in 49 of 41 million samples (3 codes at most).

Level 0, the default, and frames drawn directly are the same bytes as
before. The top of such a picture is 1 (dvbridge_render_gui_top()), a frame
sent so is drawn at 1 (dvbridge_render_gui_drawn()), its ladder stays that
of the source transport, dvbridge_render_gui_converts() tells the caller
which kind of level 1 it is, and the warm-up makes that way ready too.
---
 tools/dvbridge/dvbridge_render.c | 89 ++++++++++++++++++++++++++++++--
 tools/dvbridge/dvbridge_render.h |  9 +++-
 2 files changed, 92 insertions(+), 6 deletions(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 84cb838..d0e2955 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -176,6 +176,11 @@ struct dvbridge_renderer {
     /* Hades: the level of the conversion under the GUI that the last frame packed was drawn at
      * (dvbridge_render_gui_drawn()) */
     int gui_drawn;
+    /* Hades: the level of the conversion under the GUI asked for (dvbridge_render_gui_level()); the
+     * last picture prepared is one whose frames with GUI elements go out converted at level 1
+     * (gui_converts(): gui_convertible), and it went out so (gui_converted) */
+    int gui_level;
+    bool gui_convertible, gui_converted;
     /* the reference of a check of the bytes: the packer makes every chroma row and column, also
      * those that the transport does not read (dvbridge_render_reference()) */
     bool all_rows;
@@ -1127,6 +1132,38 @@ static bool source_possible(struct dvbridge_renderer *r, const struct pl_frame *
     return false;
 }
 
+/* Hades: a frame with GUI elements over a picture that the source transport carries in YCbCr
+ * (affine decoding: profiles 7 and 8, and HDR10 and HDR10+ sent as Dolby Vision), at its own size,
+ * without the residual of an enhancement layer drawn and not in the IPT tunnel, goes out converted
+ * at level 1 of the conversion under the GUI (dvbridge_render_gui_level()). Those frames cost more
+ * in the source transport than converted: the picture that the GUI is drawn over (pass 3), the
+ * composite into it and the conversion back of what is drawn over (pass 4), where the converted
+ * transport packs the picture that the GUI is composited into anyway. Measured on Mesa's software
+ * OpenGL ES (llvmpipe; zink on lavapipe) at 3840x2160 with Kodi's composite under its scissor: a
+ * single layer with a band of GUI over 14 % of the raster 91.0 ms a frame in the source transport,
+ * 72.9 converted (zink 107.7 and 88.5), with a panel over half of it 124.6 and 82.5 (147.5 and
+ * 98.4); without GUI elements 53.5 in the source transport and 69.2 converted, which is why only
+ * the frames with GUI elements go so. What it changes, on ten pictures of an HDR10+ stream against
+ * the decoded picture: the luma of 99.95 % of the pixels the same, 0.045 % one code of 4095 apart,
+ * 0.0015 % more (36 at most, colours that BT.2020 RGB clamps), and the chroma of the rows it is
+ * sited on the same but in 49 of 41 million samples (3 codes at most); the rows between them
+ * interpolated by libplacebo's upscaler instead of DVBRIDGE_SOURCE_LANCZOS. Level 0, the default,
+ * and frames drawn directly (no GUI elements) are as before. A picture with the residual of an
+ * enhancement layer steps the frames with GUI elements down the levels of its ladder instead
+ * (dvbridge_render_step_levels()), and a picture of profile 5 has the levels of its conversion
+ * (dvbridge_source_gui_level()). */
+static bool gui_converts(struct dvbridge_renderer *r, bool packed)
+{
+    r->gui_convertible = r->source_packer && !r->scaled_source && r->source_params.affine &&
+                         !r->residual_drawn && !r->ipt_wanted;
+    r->gui_converted = r->gui_convertible && !packed && r->gui_level >= 1;
+    if (r->gui_converted)
+        r->source_why = "a frame with GUI elements over a picture without an enhancement residual "
+                        "goes out converted at level 1 of the conversion under the GUI (those frames "
+                        "did not keep up)";
+    return r->gui_converted;
+}
+
 /* Hades: our textures for the composed planes, of the sizes of the picture's planes and in the
  * formats that libplacebo's composer picks (pl_render_params.dovi_ccm_planes). Hades: or, where
  * the GPU renders to them, in 16-bit normalized ones (R16, RG16: EXT_texture_norm16 on OpenGL ES),
@@ -1520,8 +1557,10 @@ static bool render(struct dvbridge_renderer *r, const struct pl_frame *source,
     r->geometry = geometry;
     r->source = false;
     r->scaled_source = false;
+    r->gui_convertible = false;
+    r->gui_converted = false;
     if (!r->low_latency && source_possible(r, source, metadata, bytes, geometry) &&
-        source_planes(r, source)) {
+        !gui_converts(r, packed) && source_planes(r, source)) {
         bool composed = false;
         if (render_source(r, source, metadata, bytes, pts, geometry, mapped, packed, flip, early,
                           &composed)) {
@@ -3066,6 +3105,11 @@ unsigned int dvbridge_render_step_levels(const struct dvbridge_renderer *r, bool
      * (whatever level it is drawn at, so that its ladder stays one) */
     if (r && r->scaled_source)
         return residual ? 0xfu : 0xbu;
+    /* Hades: a frame with GUI elements sent converted at level 1 of the conversion under the GUI
+     * (gui_converts()): the ladder of its picture, which the frames without GUI elements take in
+     * the source transport, so that the format keeps one */
+    if (r && r->gui_converted)
+        return 0x1u;
     /* Hades: the IPT tunnel (an expert choice), whose level 3 sends the composer's YCbCr instead
      * (no conversion of its pixels): the last of the levels, and no loss of fidelity. Measured in
      * delta E ITP over I, P and T of every pixel of profile 7 pictures, the composer's YCbCr is as
@@ -3424,6 +3468,31 @@ int dvbridge_render_warm(struct dvbridge_renderer *r, const struct pl_frame *sou
             }
         }
     }
+    /* Hades: a picture whose frames with GUI elements go out converted at level 1 of the conversion
+     * under the GUI (gui_converts()): that way too, composed and packed once, so that the first
+     * such frame does not make its programs (it comes when the frames are already late) */
+    if (transport_known && !residual && r->gui_convertible && r->gui_level < 1) {
+        ++done.asked;
+        if (now_ms() - start >= budget_ms)
+            ++done.left;
+        else {
+            const int level = r->gui_level;
+            r->gui_level = 1;
+            r->step = kept.step;
+            const bool ok =
+                dvbridge_render_rgb(r, source, metadata, bytes, pts, el_pts, geometry) &&
+                (!packer || dvbridge_render_pack(r, packer, framebuffer, 3840, 2160, true,
+                                                 DVBRIDGE_COVER_MEASURE));
+            r->gui_level = level;
+            glFinish();
+            done.made += ok;
+            done.failed += !ok;
+            if (!ok && !done.first_failed)
+                done.first_failed = r->refused ? r->refused : r->not_drawn;
+            take_warm_errors(r, &done);
+            pl_renderer_reset_errors(r->renderer, NULL);
+        }
+    }
     /* (what the packing of the composed picture left, after the last render) */
     take_warm_errors(r, &done);
     give_back_state(r, &kept);
@@ -3611,15 +3680,23 @@ bool dvbridge_render_source_planes(const struct dvbridge_renderer *r, unsigned t
 
 void dvbridge_render_gui_level(struct dvbridge_renderer *r, int level)
 {
-    if (r)
+    if (r) {
+        r->gui_level = level < 0 ? 0 : level > 2 ? 2 : level;
         dvbridge_source_gui_level(r->source_packer, level);
+    }
 }
 
 int dvbridge_render_gui_top(const struct dvbridge_renderer *r)
 {
-    return r && r->ready && r->source && !transport_params(r)->affine
-               ? dvbridge_source_gui_top(r->source_packer)
-               : 0;
+    if (r && r->ready && r->source && !transport_params(r)->affine)
+        return dvbridge_source_gui_top(r->source_packer);
+    /* Hades: a picture whose frames with GUI elements go out converted at level 1 (gui_converts()) */
+    return r && r->ready && r->gui_convertible ? 1 : 0;
+}
+
+bool dvbridge_render_gui_converts(const struct dvbridge_renderer *r)
+{
+    return r && r->ready && r->gui_convertible;
 }
 
 int dvbridge_render_gui_drawn(const struct dvbridge_renderer *r)
@@ -3702,6 +3779,8 @@ bool dvbridge_render_pack(struct dvbridge_renderer *r, struct dvbridge_gl_packer
         timer_begin(r, TIMER_PACK_CONVERTED);
         const bool packed = dvbridge_gl_pack(packer, rgb, framebuffer, width, height, packets, count, flip);
         timer_end(r, TIMER_PACK_CONVERTED);
+        /* Hades: a frame sent converted at level 1 of the conversion under the GUI */
+        r->gui_drawn = packed && r->gui_converted ? 1 : 0;
         return packed;
     }
     return width == 3840 && height == 2160 && source_pack(r, rgb, framebuffer, flip);
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 9ae618e..f2c3224 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -613,10 +613,17 @@ bool dvbridge_render_source_planes(const struct dvbridge_renderer *renderer, uns
  * close to a half, under what is drawn over only). top: the highest level the last picture
  * prepared can be drawn at (0 where it is not one of those, or nothing above 0 was made); drawn:
  * the level the last frame packed was drawn at (0 for a frame not packed in the source transport,
- * or not packed); release: the targets of levels 1 and 2 freed; targets: their texture names. */
+ * or not packed); release: the targets of levels 1 and 2 freed; targets: their texture names.
+ * Hades: a picture that the source transport carries in YCbCr at its own size without the residual
+ * of an enhancement layer drawn (not in the IPT tunnel) has level 1 only: a frame with GUI elements
+ * that is composed at it goes out converted (its top 1, its drawn 1; frames drawn directly as
+ * before); gui_converts: the last picture prepared is one of those. See gui_converts() in
+ * dvbridge_render.c for what it saves and changes. */
 #define DVBRIDGE_RENDER_GUI_LEVELS 1
+#define DVBRIDGE_RENDER_GUI_CONVERTS 1
 void dvbridge_render_gui_level(struct dvbridge_renderer *renderer, int level);
 int dvbridge_render_gui_top(const struct dvbridge_renderer *renderer);
+bool dvbridge_render_gui_converts(const struct dvbridge_renderer *renderer);
 int dvbridge_render_gui_drawn(const struct dvbridge_renderer *renderer);
 void dvbridge_render_gui_release(struct dvbridge_renderer *renderer);
 void dvbridge_render_gui_targets(const struct dvbridge_renderer *renderer, unsigned names[2]);
-- 
2.53.0

