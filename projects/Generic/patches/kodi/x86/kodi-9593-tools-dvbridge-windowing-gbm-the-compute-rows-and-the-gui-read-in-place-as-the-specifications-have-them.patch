From d8c296765b512121cfc02219dffa0539ff301ffc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:40:54 +0000
Subject: [PATCH] tools/dvbridge, windowing/gbm: the compute rows and the GUI
 read in place, as the specifications have them

What a review of the compute form of pass 2 (dvcomputerows) and of the
GUI read in place by the packer (dvguiinplace) found: nothing that
changes a byte on the drivers of today, six things that a driver which
follows the specifications to the letter could take otherwise.

- The barrier after the compute pass also orders a later write of the
  rows through a framebuffer (GL_FRAMEBUFFER_BARRIER_BIT): pass 3s of a
  scaled picture writes the same texture, and a frame whose rows the
  compute pass made may not be packed.
- memoryBarrierShared() before barrier(): the tile's writes made visible
  to the workgroup in the portable form.
- The rows of a scaled picture (pass 3s) are not told as the compute
  pass's (dvbridge_source_rows_computed()).
- A compute pass that fails after Initialize() said it is in use is told
  once in kodi.log (a warning: the frame was made again by the fragment
  pass, and so are the rest), and the line of Initialize() says that it
  would be.
- The GUI is sampled at level 0 (textureLod()): the even pixel's sample
  of an odd pixel is taken in control flow that is not uniform within a
  quad, where implicit derivatives are not defined. The GUI texture has
  no mipmaps, and Kodi's composite samples level 0 with the same filter.
- The packer composites the GUI only where Kodi's composite is the exact
  one (KODI_GUI_EXACT, which has u_pqPeak); one that converts with its
  tables (a GPU without highp in fragment shaders) draws other colours.
  kodi.log says it once.

Measured with Mesa's zink over lavapipe, with this bridge, in one pass:
pass 2 by fragments against the compute form, 28 of 28 transport files
the same (three pictures of a profile 7 FEL stream in YCbCr, in IPT, at
step-down level 3 and with a GUI over them, and a profile 5 chart), and
12 of 12 with the base layer's chroma centred horizontally (the
horizontal pass before the rows, never measured so before); the GUI
read in place, with the rows of the compute form, against Kodi's own
composite over the rows of the fragment pass: the same bytes in every
pixel at levels 0 and 3 with a GUI of 1920 and of 3840 texels over 55 %
of the raster, and not taken in IPT. Not run on a GPU.
---
 tools/dvbridge/dvbridge_source.c                  | 13 +++++++++++--
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.cpp   | 15 ++++++++++++++-
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h     |  3 +++
 xbmc/rendering/gles/GuiCompositeShaderGLES.h      |  2 ++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp    | 15 ++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h      |  2 ++
 6 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
index b349faf..752434f 100644
--- a/tools/dvbridge/dvbridge_source.c
+++ b/tools/dvbridge/dvbridge_source.c
@@ -402,6 +402,9 @@ static const char ROWS_COMPUTE[] =
     "        vec2 c = texelFetch(chroma_plane, ivec2(col, row), 0).rg;\n"
     "        tile[e] = ivec2(floor(c * chroma_read + 0.5));\n"
     "    }\n"
+    /* (the tile's writes made visible to the workgroup, then every invocation waits: the
+     * portable form) */
+    "    memoryBarrierShared();\n"
     "    barrier();\n"
     "    int lx = int(gl_LocalInvocationID.x);\n"
     "    for (int h = 0; h < 2; h++) {\n"
@@ -803,7 +806,9 @@ static const char PACK[] =
     /* the pixel as the composite leaves it in the picture of pass 3 (alpha 2: nothing drawn) */  \
     "vec4 composited(ivec2 p)\n"                                                                  \
     "{\n"                                                                                         \
-    "    vec4 g = texture(gui, vec2((float(p.x) + 0.5) / 3840.0, 1.0 - (float(p.y) + 0.5) / 2160.0));\n" \
+    /* (level 0, without implicit derivatives: this runs in control flow that is not uniform within  \
+     * a quad; the GUI texture has no mipmaps, and the composite samples level 0 with the same filter) */ \
+    "    vec4 g = textureLod(gui, vec2((float(p.x) + 0.5) / 3840.0, 1.0 - (float(p.y) + 0.5) / 2160.0), 0.0);\n" \
     "    if (g.a == 0.0)\n"                                                                       \
     "        return vec4(0.0, 0.0, 0.0, 2.0);\n"                                                  \
     "    vec3 colour = gui_pq((bt709_to_bt2020 * srgb_to_linear(clamp(g.rgb, 0.0, 1.0))) * gui_peak);\n" \
@@ -2353,7 +2358,10 @@ bool dvbridge_source_rows(struct dvbridge_source_packer *p,
         glBindImageTexture(0, p->chroma.texture, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RGBA16UI);
         glDispatchCompute((GLuint)((cw + ROWS_GROUP_W - 1) / ROWS_GROUP_W),
                           (GLuint)((half + ROWS_GROUP_H - 1) / ROWS_GROUP_H), 1);
-        glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT);
+        /* (and before a later write of the same texture through a framebuffer: pass 3s of a scaled
+         * picture makes these rows so) */
+        glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT | GL_SHADER_IMAGE_ACCESS_BARRIER_BIT |
+                        GL_FRAMEBUFFER_BARRIER_BIT);
         glBindImageTexture(0, 0, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RGBA16UI);
         if (glGetError() == GL_NO_ERROR)
             break;
@@ -2484,6 +2492,7 @@ bool dvbridge_source_scale(struct dvbridge_source_packer *p,
         return false;
     p->rows_made = false;
     p->rows_ipt = false;
+    p->rows_computed = false; /* (pass 3s makes these rows, never the compute form of pass 2) */
     const float v[4] = {view ? view[0] : 0.0f, view ? view[1] : 0.0f,
                         view ? view[2] : (float)sw, view ? view[3] : (float)sh};
     const int scw = (sw + 1) / 2, sch = (sh + 1) / 2;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index facd2d0..f3fa98d 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -544,8 +544,12 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
       CLog::Log(LOGINFO, "DVBridge: the rows of 4:2:2 chroma are made by the fragment pass: the "
                          "compute pass could not be made on this GPU (it takes OpenGL ES 3.1)");
     else
+    {
+      m_computeRowsSaid = true;
       CLog::Log(LOGINFO, "DVBridge: the rows of 4:2:2 chroma are made by a compute pass that "
-                         "fetches each row of 4:2:0 once for 8 of them (the same bytes; dvcomputerows)");
+                         "fetches each row of 4:2:0 once for 8 of them (the same bytes; dvcomputerows), "
+                         "unless it fails on this GPU, which the log then says");
+    }
   }
   UseComposerSetting();
   UseGamutSetting();
@@ -933,6 +937,15 @@ void CDVBridgeGLES::LogNotes()
 {
   // Hades: and the gamut mapping table of a picture that was mapped
   LogGamutTable();
+  // Hades: the compute pass of the rows of 4:2:2 chroma that Initialize() said is in use failed (a GL
+  // error): the frame was made again by the fragment pass, and so are the rest (dvcomputerows)
+  if (m_computeRowsSaid && m_renderer && !dvbridge_render_compute_rows_usable(m_renderer))
+  {
+    m_computeRowsSaid = false;
+    CLog::Log(LOGWARNING, "DVBridge: the compute pass of the rows of 4:2:2 chroma failed on this GPU "
+                          "(a GL error): the rows are made by the fragment pass from here on, the "
+                          "frame that it failed on included (the same bytes; dvcomputerows)");
+  }
   dvbridge_render_notes notes{};
   if (!m_renderer || !dvbridge_render_take_notes(m_renderer, &notes))
     return;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 884768c..f6328a3 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -563,6 +563,9 @@ private:
   //! Hades: the check of the GUI cache (advancedsettings.xml dvguicachecheck): frames, tiles copied,
   //! tiles packed into it and tiles copied that were not the bytes packed again, since the last line
   bool m_guiCacheCheck = false;
+  //! Hades: Initialize() said that the rows of 4:2:2 chroma are made by the compute pass
+  //! (dvcomputerows); LogNotes() says once if it fails afterwards
+  bool m_computeRowsSaid = false;
   unsigned m_guiCacheFrames = 0;
   unsigned long long m_guiCacheTiles[3] = {0, 0, 0};
   bool m_guiCacheDiffered = false;
diff --git a/xbmc/rendering/gles/GuiCompositeShaderGLES.h b/xbmc/rendering/gles/GuiCompositeShaderGLES.h
index 446792e..0fc0932 100644
--- a/xbmc/rendering/gles/GuiCompositeShaderGLES.h
+++ b/xbmc/rendering/gles/GuiCompositeShaderGLES.h
@@ -31,6 +31,8 @@ public:
   //! the GUI itself with the same arithmetic (dvbridge_render_set_gui_in_place())
   float GetPQPeak() const { return m_pqPeak; }
   bool IsPQ() const { return m_ootfGamma <= 0.0f; }
+  //! Hades: the shader converts exactly, in highp (KODI_GUI_EXACT: it has u_pqPeak), not with the LUTs
+  bool IsExact() const { return m_hPqPeak >= 0; }
 
   GLint GetPosLoc() { return m_hPos; }
   GLint GetTexLoc() { return m_hTex; }
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 10c4dcb..25c5b85 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -5121,12 +5121,25 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   // composite's read and write of it and the packer's read are not made (the same bytes wherever the
   // GUI covers nothing). Weak GPUs are those that present a frame ahead. advancedsettings.xml:
   // <video><dvguiinplace>false</dvguiinplace></video>
+  // (Hades: only where the composite converts exactly, KODI_GUI_EXACT: one with the LUTs of a GPU
+  // without highp in fragment shaders draws other colours, which the packer does not reproduce)
   float guiInPlace = 0.0f;
   if (!overlayFree && !captured && drawnTiles && m_guiFbo.IsValid() && m_compositeShader &&
       m_compositeShader->IsPQ() && !m_compositeLimited &&
       (!drawnSettings || drawnSettings->GetAdvancedSettings()->m_videoDVGuiInPlace) &&
       DVAheadWanted() && m_modeAnnounce.Pending() != CHeldModeAnnouncement::Step::BEFORE_NEXT)
-    guiInPlace = m_compositeShader->GetPQPeak();
+  {
+    if (m_compositeShader->IsExact())
+      guiInPlace = m_compositeShader->GetPQPeak();
+    else if (!m_dvGuiInPlaceNotExactSaid)
+    {
+      m_dvGuiInPlaceNotExactSaid = true;
+      CLog::Log(LOGINFO, "DVBridge: the GUI over the picture is composited by Kodi, not by the packer "
+                         "of the transport: the GUI composite of this GPU converts with its tables (no "
+                         "highp in fragment shaders), which the packer does not reproduce "
+                         "(video/dvguiinplace)");
+    }
+  }
   if (!overlayFree && !captured && drawnTiles && m_guiFbo.IsValid())
     m_dvBridge->SetDrawnOver(m_guiFbo.Texture(), m_guiFboWidth, m_guiFboHeight,
                              m_compositeShader ? m_compositeRevision : 0, guiInPlace);
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index b65a90f..fda3b24 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -420,6 +420,8 @@ private:
   bool m_compositeLimited{false};
   //! Hades: the packer composited the GUI itself (said once in the log)
   bool m_dvGuiInPlaceSaid{false};
+  //! Hades: ... or why it does not (the composite is not the exact one; said once)
+  bool m_dvGuiInPlaceNotExactSaid{false};
   //! The transfer function the composite LUTs were created for (SetGuiCompositing())
   int m_compositeTransfer{0};
   //! A GUI white setting whose LUTs could not be created: not tried again until the setting returns
-- 
2.53.0

