From 22d6c8ec62aca816e070c0bb645bb89a88d778d3 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 13 Oct 2026 08:00:12 +0100
Subject: [PATCH] RetroPlayer: Count shader frames at the speed the game
 rewinds

The game loop rewinds at a quarter of the speed shown, but the render
manager was given the speed shown, so animated shader presets ran four
times too fast while rewinding. Give it the game loop's own speed
while rewinding.
---
 xbmc/cores/RetroPlayer/RetroPlayer.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/xbmc/cores/RetroPlayer/RetroPlayer.cpp b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
index c93a068..1b1fd8f 100644
--- a/xbmc/cores/RetroPlayer/RetroPlayer.cpp
+++ b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
@@ -701,7 +701,13 @@ void CRetroPlayer::SetSpeedInternal(double speed)
   if (speed == 0.0)
     m_playback->PauseAsync();
   else
+  {
     m_playback->SetSpeed(speed);
+
+    // Rewinding runs the game loop slower than the speed shown
+    if (speed < 0.0 && m_gameClient && m_gameClient->RequiresGameLoop())
+      m_renderManager->SetSpeed(m_playback->GetSpeed());
+  }
 }
 
 void CRetroPlayer::OnSpeedChange(double newSpeed)
-- 
2.53.0

