From 8b4549a664e96fedcc94af24d36bbef168b6cbe7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:07:35 +0000
Subject: [PATCH] tools/dvbridge: the signal of a plain picture within [0, 1]
 before it is mapped

An HDR10 or HLG picture mapped to SDR by the bridge (dvbridge_render_plain())
came out, in a chart of saturated patches, up to 35 (PQ) and 49 (HLG) Delta E
ITP away from the same mapping computed exactly, at the edges between the
patches; the middle of every patch was within 0.6.

The cause: where the chroma of the picture is scaled up across an edge between
two saturated colours, the values in between, and the lobes of the upscaler,
give an R'G'B' signal outside [0, 1]: PQ beyond 10000 cd/m2, HLG beyond its
peak. The mapping took that signal as it came and made it light far outside the
gamut of the picture. The picture as it is (the output for HDR10) is clamped
there anyway, at its output, and so is a reconstructed one (clamp_picture()).
The signal of a plain picture is now held within [0, 1] at the RGB stage, before
it is linearized: the mapping maps that same signal.

It is not the chroma upscaler alone: scaled bilinearly (no lobes, no overshoot)
the edges were still 14 and 26 away. With the clamp they are 1.16 and 0.89, and
no pixel is more than 3 away (790 and 9545 pixels were).

Measured with the software bridge (zink on lavapipe): the charts as they are
(the output for HDR10), the same bytes; the 14 base layer pictures of a FEL test
stream mapped to SDR, the same bytes (no edge of theirs leaves the range). A
picture that is not plain is drawn with the same hooks as before.
---
 tools/dvbridge/dvbridge_render.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 5b70bb5..9436ea6 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -1192,6 +1192,22 @@ static bool hdr10_texture(struct dvbridge_renderer *r, pl_fmt fmt, pl_tex *tex,
  * the matrix of BT.2020 for non-constant luminance, PQ or HLG, and its HDR10 metadata, which must
  * hold: every value from 0 (not known) to 10000 cd/m2, and the mastering display darker at black
  * than at white. */
+/* Hades: the signal of a plain picture, R'G'B' once converted from YCbCr, within [0, 1], before it is
+ * linearized and mapped: where its chroma is scaled up across an edge of two saturated colours, the
+ * values between them (and the lobes of the upscaler) fall outside it, up to PQ beyond 10000 cd/m2.
+ * The picture as it is (the output for HDR10) is clamped there anyway, at its output; the mapping
+ * now maps that same signal. */
+static struct pl_hook_res clamp_signal(void *priv, const struct pl_hook_params *p)
+{
+    bool *called = priv;
+    const struct pl_custom_shader shader = {
+        .input = PL_SHADER_SIG_COLOR, .output = PL_SHADER_SIG_COLOR,
+        .body = "color.rgb = clamp(color.rgb, 0.0, 1.0);\n",
+        .description = "the signal of a plain picture within [0, 1]"};
+    *called = p->stage == PL_HOOK_RGB && pl_shader_custom(p->sh, &shader);
+    return (struct pl_hook_res){.failed = !*called, .output = PL_HOOK_SIG_NONE};
+}
+
 static bool plain_color(struct dvbridge_color *out, const struct dvbridge_plain *p)
 {
     const float lumas[] = {p->max_luma, p->min_luma, p->max_cll, p->max_fall};
@@ -1297,6 +1313,11 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
     const struct pl_hook *hooks[] = {&hook};
     params.hooks = hooks;
     params.num_hooks = 1;
+    /* Hades: a plain picture's signal held within [0, 1] first (clamp_signal()) */
+    bool signal_clamped = false;
+    const struct pl_hook signal_hook = {
+        .stages = PL_HOOK_RGB, .input = PL_HOOK_SIG_COLOR, .priv = &signal_clamped,
+        .hook = clamp_signal, .signature = 0x4456424844525347ULL};
     /* Hades: or mapped to the display, where that is asked for (dvbridge_render_hdr10_mapping()),
      * and then held within its peak (in an SDR signal the peak is 1.0, which the clamp to [0, 1]
      * holds it within) */
@@ -1316,12 +1337,18 @@ static bool render_hdr10(struct dvbridge_renderer *r, const struct pl_frame *sou
         to_display.peak = pl_hdr_rescale(PL_HDR_NITS, PL_HDR_PQ, r->hdr10_mapping.peak);
         params.hooks = display_hooks;
     }
+    /* (Hades: the hook of the output, either of them, and the one of a plain picture's signal) */
+    const struct pl_hook *plain_hooks[] = {params.hooks[0], &signal_hook};
+    if (plain) {
+        params.hooks = plain_hooks;
+        params.num_hooks = 2;
+    }
     /* from here on the texture drawn into may hold a part of this picture over an earlier one: the
      * one shown keeps its picture unless it is that texture */
     if (into == r->hdr10_shown)
         r->hdr10_whole = false;
     bool ok = pl_render_image(r->renderer, &image, &target, &params) &&
-              (peak_hook ? to_display.called : clamped);
+              (peak_hook ? to_display.called : clamped) && (!plain || signal_clamped);
     struct pl_render_errors errors = pl_renderer_get_errors(r->renderer);
     ok = ok && !(errors.errors & ~PL_RENDER_ERR_DOVI_COMPOSER) && !errors.num_disabled_hooks;
     if (ok) {
-- 
