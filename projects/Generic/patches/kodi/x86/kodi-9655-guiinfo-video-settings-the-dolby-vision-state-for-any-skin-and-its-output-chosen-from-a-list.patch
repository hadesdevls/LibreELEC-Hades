+std::string CWinSystemGbmGLESContext::OutputHDRType(bool nativeDV, bool convertedPlus) const
+{
+  if (nativeDV)
+    return "dolbyvision";
+  switch (GetEotf())
+  {
+    case KODI::UTILS::Eotf::PQ:
+      return HDR10PlusQueued() || convertedPlus ? "hdr10plus" : "hdr10";
+    case KODI::UTILS::Eotf::HLG:
+      return "hlg";
+    case KODI::UTILS::Eotf::TRADITIONAL_SDR:
+      return "sdr";
+    default:
+      return "";
+  }
+}
