+
+std::string CGUIDialogVideoSettings::DVOutputChoiceName()
+{
+  const auto list = DVOutputChoices();
+  if (list.size() < 2)
+    return {};
+  const int current = static_cast<int>(DVBRIDGE::GetOutputChoice());
+  for (const auto& option : list)
+  {
+    if (option.value == current)
+      return option.label;
+  }
+  return {};
+}
+
+void CGUIDialogVideoSettings::SelectDVOutput()
+{
+  const auto list = DVOutputChoices();
+  if (list.size() < 2)
+    return;
+  auto* gui = CServiceBroker::GetGUI();
+  auto* dialog = gui ? gui->GetWindowManager().GetWindow<CGUIDialogSelect>(WINDOW_DIALOG_SELECT)
+                     : nullptr;
+  if (!dialog)
+    return;
+  const int current = static_cast<int>(DVBRIDGE::GetOutputChoice());
+  dialog->Reset();
+  dialog->SetHeading(CVariant{CGUIUtils::GetHadesString(39820, 31762)});
+  int selected = -1;
+  for (size_t i = 0; i < list.size(); ++i)
+  {
+    dialog->Add(list[i].label);
+    if (list[i].value == current)
+      selected = static_cast<int>(i);
+  }
+  if (selected >= 0)
+    dialog->SetSelected(selected);
+  dialog->Open();
+  // Only what the user chose: a list closed another way (back, or by something else) changes
+  // nothing, and neither does the output that was chosen already
+  const int chosen = dialog->IsConfirmed() ? dialog->GetSelectedItem() : -1;
+  if (chosen < 0 || chosen >= static_cast<int>(list.size()) || list[chosen].value == current)
+    return;
+  ApplyDVOutput(list[chosen].value);
 }
 
