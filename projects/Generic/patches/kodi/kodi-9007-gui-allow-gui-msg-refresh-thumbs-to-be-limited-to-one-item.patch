From 2089f90f819cfe0fa55ef6388ab724a7ac8e0bc3 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 20:40:08 +0100
Subject: [PATCH] [GUI] Allow GUI_MSG_REFRESH_THUMBS to be limited to one item

A thumbs refresh made every media window free the layouts of all its
list items, so changing the art of one video loaded every poster of the
list again. The message can now carry the changed item, and a media
window then frees only the list items matching it. Other windows and
controls handle the message as before.

The video information dialog and the video art chooser send the changed
item along.
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 4 ++--
 xbmc/video/windows/GUIWindowVideoBase.cpp | 2 +-
 xbmc/windows/GUIMediaWindow.cpp           | 7 ++++++-
 3 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index a740fbc..db5ffcc 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -570,7 +570,7 @@ void CGUIDialogVideoInfo::Update()
   // are likely to have had this image in use so will need refreshing)
   if (m_hasUpdatedThumb)
   {
-    CGUIMessage reload(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS);
+    CGUIMessage reload(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS, 0, m_movieItem);
     CServiceBroker::GetGUI()->GetWindowManager().SendMessage(reload);
   }
 }
@@ -2040,7 +2040,7 @@ bool CGUIDialogVideoInfo::ManageVideoItemArtwork(const std::shared_ptr<CFileItem
   }
 
   CUtil::DeleteVideoDatabaseDirectoryCache();
-  CGUIMessage msg(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS);
+  CGUIMessage msg(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS, 0, item);
   CServiceBroker::GetGUI()->GetWindowManager().SendMessage(msg);
 
   return true;
diff --git a/xbmc/video/windows/GUIWindowVideoBase.cpp b/xbmc/video/windows/GUIWindowVideoBase.cpp
index efb5b89..5c7ca5c 100644
--- a/xbmc/video/windows/GUIWindowVideoBase.cpp
+++ b/xbmc/video/windows/GUIWindowVideoBase.cpp
@@ -502,7 +502,7 @@ CGUIWindowVideoBase::ShowInfoResult CGUIWindowVideoBase::ShowInfo(
   {
     // reload images
     //! @todo we need this to update images in video info dialog immediately after refresh, but why?
-    CGUIMessage reload(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS);
+    CGUIMessage reload(GUI_MSG_NOTIFY_ALL, 0, 0, GUI_MSG_REFRESH_THUMBS, 0, item);
     OnMessage(reload);
 
     if (!CVideoLibraryQueue::GetInstance().RefreshItemModal(item, needsRefresh,
diff --git a/xbmc/windows/GUIMediaWindow.cpp b/xbmc/windows/GUIMediaWindow.cpp
index e39dbdb..0a0a403 100644
--- a/xbmc/windows/GUIMediaWindow.cpp
+++ b/xbmc/windows/GUIMediaWindow.cpp
@@ -311,8 +311,13 @@ bool CGUIMediaWindow::OnMessage(CGUIMessage& message)
       }
       else if ( message.GetParam1() == GUI_MSG_REFRESH_THUMBS )
       {
+        // an item sent along limits the refresh to the list items showing it
+        const auto item{std::static_pointer_cast<CFileItem>(message.GetItem())};
         for (int i = 0; i < m_vecItems->Size(); i++)
-          m_vecItems->Get(i)->FreeMemory(true);
+        {
+          if (!item || m_vecItems->Get(i)->IsSamePath(item.get()))
+            m_vecItems->Get(i)->FreeMemory(true);
+        }
         break;  // the window will take care of any info images
       }
       else if (message.GetParam1() == GUI_MSG_REMOVED_MEDIA)
-- 
2.53.0

