From fe495214c00f1895bf663274210c4f4c29df6eb5 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 22:22:10 +0100
Subject: [PATCH] [Video] Keep the change flags when the information dialog
 reopens

The information dialog opens itself again when it moves on to another
item, or after a cancelled play. Opening resets the flags telling the
caller that art or the user rating was changed, so a change made before
was lost and the list was not refreshed. They are now kept across these
openings, as the updated items flag already is.
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index 88dd709..3dd11e2 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -240,9 +240,13 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
           if (m_movieItem->GetVideoInfoTag()->m_type == MediaTypeVideoCollection)
           {
             SetMovie(m_castList->Get(iItem).get());
+            const bool hasUpdatedThumb{m_hasUpdatedThumb};
+            const bool hasUpdatedUserrating{m_hasUpdatedUserrating};
             const bool hasUpdatedItems{m_hasUpdatedItems};
             Close();
             Open();
+            m_hasUpdatedThumb = m_hasUpdatedThumb || hasUpdatedThumb;
+            m_hasUpdatedUserrating = m_hasUpdatedUserrating || hasUpdatedUserrating;
             m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
           }
           else
@@ -739,9 +743,13 @@ void CGUIDialogVideoInfo::OnSearchItemFound(const CFileItem* pItem)
   *item.GetVideoInfoTag() = movieDetails;
   SetMovie(&item);
   // refresh our window entirely
+  const bool hasUpdatedThumb{m_hasUpdatedThumb};
+  const bool hasUpdatedUserrating{m_hasUpdatedUserrating};
   const bool hasUpdatedItems{m_hasUpdatedItems};
   Close();
   Open();
+  m_hasUpdatedThumb = m_hasUpdatedThumb || hasUpdatedThumb;
+  m_hasUpdatedUserrating = m_hasUpdatedUserrating || hasUpdatedUserrating;
   m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
 }
 
@@ -816,8 +824,12 @@ void CGUIDialogVideoInfo::Play(bool resume)
       {
         // The Resume dialog was closed without any choice
         SetMovie(m_movieItem.get()); // restore cast list, which was cleared on dialog close
+        const bool hasUpdatedThumb{m_hasUpdatedThumb};
+        const bool hasUpdatedUserrating{m_hasUpdatedUserrating};
         const bool hasUpdatedItems{m_hasUpdatedItems};
         Open();
+        m_hasUpdatedThumb = m_hasUpdatedThumb || hasUpdatedThumb;
+        m_hasUpdatedUserrating = m_hasUpdatedUserrating || hasUpdatedUserrating;
         m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
       }
     }
-- 
