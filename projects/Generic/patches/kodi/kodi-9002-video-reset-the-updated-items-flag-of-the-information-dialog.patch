From 25dc0cecd102aad81d79528fd44f74018a91eb61 Mon Sep 17 00:00:00 2001
From: olympia <olympia@xbmc.org>
Date: Sun, 25 Oct 2026 21:57:07 +0100
Subject: [PATCH] [Video] Reset the updated items flag of the information
 dialog

The flag telling the caller that versions or extras were changed was
never reset, so after managing them once every later information dialog
refreshed the whole list, even when nothing changed. It is now reset
when the dialog opens, and kept when the dialog opens itself again for
another item or after a cancelled play. Managing versions or extras a
second time without a change no longer clears it either.
---
 xbmc/video/dialogs/GUIDialogVideoInfo.cpp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
index eadf0ca..88dd709 100644
--- a/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoInfo.cpp
@@ -169,11 +169,13 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
       }
       else if (iControl == CONTROL_BTN_MANAGE_VIDEO_VERSIONS)
       {
-        m_hasUpdatedItems = OnManageVideoVersions();
+        if (OnManageVideoVersions())
+          m_hasUpdatedItems = true;
       }
       else if (iControl == CONTROL_BTN_MANAGE_VIDEO_EXTRAS)
       {
-        m_hasUpdatedItems = OnManageVideoExtras();
+        if (OnManageVideoExtras())
+          m_hasUpdatedItems = true;
       }
       else if (iControl == CONTROL_BTN_PLAY)
       {
@@ -238,8 +240,10 @@ bool CGUIDialogVideoInfo::OnMessage(CGUIMessage& message)
           if (m_movieItem->GetVideoInfoTag()->m_type == MediaTypeVideoCollection)
           {
             SetMovie(m_castList->Get(iItem).get());
+            const bool hasUpdatedItems{m_hasUpdatedItems};
             Close();
             Open();
+            m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
           }
           else
             OnSearch(strItem);
@@ -272,6 +276,7 @@ void CGUIDialogVideoInfo::OnInitWindow()
   m_bRefreshAll = true;
   m_hasUpdatedThumb = false;
   m_hasUpdatedUserrating = false;
+  m_hasUpdatedItems = false;
   m_bViewReview = true;
 
   const std::shared_ptr<CProfileManager> profileManager =
@@ -734,8 +739,10 @@ void CGUIDialogVideoInfo::OnSearchItemFound(const CFileItem* pItem)
   *item.GetVideoInfoTag() = movieDetails;
   SetMovie(&item);
   // refresh our window entirely
+  const bool hasUpdatedItems{m_hasUpdatedItems};
   Close();
   Open();
+  m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
 }
 
 void CGUIDialogVideoInfo::ClearCastList()
@@ -809,7 +816,9 @@ void CGUIDialogVideoInfo::Play(bool resume)
       {
         // The Resume dialog was closed without any choice
         SetMovie(m_movieItem.get()); // restore cast list, which was cleared on dialog close
+        const bool hasUpdatedItems{m_hasUpdatedItems};
         Open();
+        m_hasUpdatedItems = m_hasUpdatedItems || hasUpdatedItems;
       }
     }
   }
-- 
