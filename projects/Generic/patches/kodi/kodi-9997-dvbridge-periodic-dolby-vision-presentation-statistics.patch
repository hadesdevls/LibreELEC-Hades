From 30c08ade387b48a6d139c9afc3ed69fd56e356bf Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:03:57 +0000
Subject: [PATCH] dvbridge: periodic Dolby Vision presentation statistics

On real NVIDIA hardware, profile 8.1 played in Dolby Vision, but once the
player information overlay was open the log showed "OutputPicture -
timeout waiting for buffer" every few seconds and audio resynchronizing;
nothing said whether Dolby Vision frames were late, lost or just slower
with GUI elements composited on top.

Every ten seconds while native output runs, and once when it ends, log
the frames shown and not shown, how many were composed with GUI
elements, the average and maximum time to prepare a frame (reconstruction
and packing inputs) and to present it (pack, swap, transactional commit),
and the longest gap between two shown frames. Measurement only.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 54 +++++++++++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  | 17 ++++++
 2 files changed, 71 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index f5e34ce..ae09847 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -36,6 +36,7 @@ extern "C"
 #include "utils/log.h"
 #include "windowing/WindowSystemFactory.h"
 
+#include <algorithm>
 #include <chrono>
 #include <mutex>
 #include <cstdlib>
@@ -157,6 +158,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
   if (m_dvState.Captured())
   {
     const bool attempted = m_dvFrame && m_dvBridge;
+    const auto presentStart = std::chrono::steady_clock::now();
     bool presented = false;
     // EGL's window framebuffer has a bottom-left GL origin, while transport
     // metadata is indexed from the top-left of the HDMI raster.
@@ -170,6 +172,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
         {
           m_dvSignalling = true;
           CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output started");
+          m_dvStats = {};
+          m_dvStats.start = std::chrono::steady_clock::now();
         }
       }
     }
@@ -177,7 +181,28 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
       m_dvBridge->Presented(presented);
     m_dvFrame = false;
     if (attempted)
+    {
+      const auto now = std::chrono::steady_clock::now();
+      const double presentMs =
+          std::chrono::duration<double, std::milli>(now - presentStart).count();
+      m_dvStats.presentSumMs += presentMs;
+      m_dvStats.presentMaxMs = std::max(m_dvStats.presentMaxMs, presentMs);
+      if (presented)
+      {
+        if (m_dvStats.hasLastShown)
+          m_dvStats.gapMaxMs = std::max(
+              m_dvStats.gapMaxMs,
+              std::chrono::duration<double, std::milli>(now - m_dvStats.lastShown).count());
+        m_dvStats.lastShown = now;
+        m_dvStats.hasLastShown = true;
+        m_dvStats.shown++;
+      }
+      else
+        m_dvStats.notShown++;
+      if (m_dvSignalling && now - m_dvStats.start >= std::chrono::seconds(10))
+        LogDVStats("last 10 s");
       DVBridgeFrameShown(presented);
+    }
     return;
   }
 #endif
@@ -597,7 +622,15 @@ bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
   if (!BeginDVBridge())
     return false;
   const bool overlayFree = m_guiWillRender && GetGUIElementCount() == 0 && !m_dvOverlays;
+  const auto prepareStart = std::chrono::steady_clock::now();
   m_dvFrame = m_dvBridge->PrepareHardware(layer, enhancement, metadata, geometry, overlayFree);
+  const double prepareMs = std::chrono::duration<double, std::milli>(
+                              std::chrono::steady_clock::now() - prepareStart).count();
+  m_dvStats.prepared++;
+  m_dvStats.prepareSumMs += prepareMs;
+  m_dvStats.prepareMaxMs = std::max(m_dvStats.prepareMaxMs, prepareMs);
+  if (!overlayFree)
+    m_dvStats.withGui++;
   glBindFramebuffer(GL_FRAMEBUFFER, 0);
   return m_dvFrame;
 }
@@ -626,6 +659,7 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
   }
   if (m_dvSignalling)
   {
+    LogDVStats("until the end");
     m_dvSignalling = false;
     CLog::Log(LOGINFO, "DVBridge: native Dolby Vision output ended, normal output restored");
   }
@@ -636,6 +670,26 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
   return true;
 }
 
+void CWinSystemGbmGLESContext::LogDVStats(const char* period)
+{
+  const unsigned int attempts = m_dvStats.shown + m_dvStats.notShown;
+  CLog::Log(LOGINFO,
+            "DVBridge: {}: {} frames shown, {} not shown, {} composed with GUI elements; "
+            "prepare avg {:.1f} ms max {:.1f} ms; present avg {:.1f} ms max {:.1f} ms; "
+            "longest gap between shown frames {:.1f} ms",
+            period, m_dvStats.shown, m_dvStats.notShown, m_dvStats.withGui,
+            m_dvStats.prepared ? m_dvStats.prepareSumMs / m_dvStats.prepared : 0.0,
+            m_dvStats.prepareMaxMs, attempts ? m_dvStats.presentSumMs / attempts : 0.0,
+            m_dvStats.presentMaxMs, m_dvStats.gapMaxMs);
+  // Keep measuring the gap across the period boundary.
+  const auto lastShown = m_dvStats.lastShown;
+  const bool hasLastShown = m_dvStats.hasLastShown;
+  m_dvStats = {};
+  m_dvStats.start = std::chrono::steady_clock::now();
+  m_dvStats.lastShown = lastShown;
+  m_dvStats.hasLastShown = hasLastShown;
+}
+
 void CWinSystemGbmGLESContext::DVBridgeFrameShown(bool shown)
 {
   // Give up only on a sustained failure: 24 frames in a row that could not be shown, over at
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 3d1bde2..4ffb259 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -98,6 +98,23 @@ private:
   DVBRIDGE::DiagnosticFailures m_dvBeginFailures;
   unsigned int m_dvFailedFrames = 0;
   std::chrono::steady_clock::time_point m_dvFirstFailedFrame;
+  //! Presentation statistics of native Dolby Vision output, logged every 10 s and at the end.
+  struct DVStats
+  {
+    unsigned int shown = 0;
+    unsigned int notShown = 0;
+    unsigned int withGui = 0;
+    unsigned int prepared = 0;
+    double prepareSumMs = 0;
+    double prepareMaxMs = 0;
+    double presentSumMs = 0;
+    double presentMaxMs = 0;
+    double gapMaxMs = 0;
+    bool hasLastShown = false;
+    std::chrono::steady_clock::time_point start;
+    std::chrono::steady_clock::time_point lastShown;
+  } m_dvStats;
+  void LogDVStats(const char* period);
 #endif
 };
 
