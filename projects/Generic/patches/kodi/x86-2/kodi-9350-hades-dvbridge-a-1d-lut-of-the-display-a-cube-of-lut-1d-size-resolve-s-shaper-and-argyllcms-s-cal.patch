+/* Hades: the 3D table of a LUT that is a 1D LUT alone: the identity of 2 points a side (its corners), which the
+ * tetrahedral interpolation gives back */
+static struct dvbridge_lut *make_identity(enum dvbridge_lut_format format)
+{
+    struct dvbridge_lut *lut = make(2, format);
+    if (!lut)
+        return NULL;
+    for (int b = 0; b < 2; ++b)
+        for (int g = 0; g < 2; ++g)
+            for (int r = 0; r < 2; ++r) {
+                float *to = lut->data + ((size_t)(b * 2 + g) * 2 + r) * 3;
+                to[0] = (float)r;
+                to[1] = (float)g;
+                to[2] = (float)b;
+            }
+    lut->curve_only = true;
+    return lut;
+}
