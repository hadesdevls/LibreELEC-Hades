+/* ------------------------------------------------------------------------------------------------- .cal */
+
+/* the next word of a CGATS line (a "string" without its quotes); false at the end of the line */
+static bool word(struct text *t, struct text *w)
+{
+    skip_blanks(t);
+    if (t->at >= t->end)
+        return false;
+    if (*t->at == '"') {
+        const char *close = memchr(t->at + 1, '"', (size_t)(t->end - t->at - 1));
+        if (!close)
+            return false;
+        w->at = t->at + 1;
+        w->end = close;
+        t->at = close + 1;
+        return true;
+    }
+    w->at = t->at;
+    while (t->at < t->end && !blank(*t->at))
+        ++t->at;
+    w->end = t->at;
+    return true;
+}
+
+static bool is(const struct text *w, const char *s)
+{
+    const size_t n = strlen(s);
+    return (size_t)(w->end - w->at) == n && !memcmp(w->at, s, n);
+}
+
+/* the names of the fields of a CGATS table on a line, up to END_DATA_FORMAT (which ends *in_format); where RGB_I,
+ * RGB_R, RGB_G and RGB_B are among them; false past 64 fields */
+static bool field_names(struct text *t, bool *in_format, int *fields, int *at_i, int *at_r, int *at_g, int *at_b)
+{
+    struct text w;
+    while (word(t, &w)) {
+        if (is(&w, "END_DATA_FORMAT")) {
+            *in_format = false;
+            return true;
+        }
+        if (*fields >= 64)
+            return false;
+        *at_i = is(&w, "RGB_I") ? *fields : *at_i;
+        *at_r = is(&w, "RGB_R") ? *fields : *at_r;
+        *at_g = is(&w, "RGB_G") ? *fields : *at_g;
+        *at_b = is(&w, "RGB_B") ? *fields : *at_b;
+        ++*fields;
+    }
+    return true;
+}
+
+/*
+ * ArgyllCMS's .cal (doc/cal_format.html of ArgyllCMS): CGATS.5 text, its identifier CAL; the keywords DEVICE_CLASS
+ * (here "DISPLAY": the curves of a display's video card) and COLOR_REP ("RGB"); the table of NUMBER_OF_SETS sets,
+ * each on its line, of the fields BEGIN_DATA_FORMAT names (RGB_I, the input, and RGB_R, RGB_G, RGB_B, the output of
+ * each channel, all within 0 to 1). Other keywords are left out, as the format says; the first table is the
+ * calibration (others are of the device).
+ */
+static struct dvbridge_lut *parse_cal(const char *bytes, size_t size, char *why, size_t ws)
+{
+    struct text t = {bytes, bytes + size}, line, w;
+    int number_of_line = 0, sets = 0, fields = 0;
+    int at_i = -1, at_r = -1, at_g = -1, at_b = -1;
+    bool identified = false, display = false, rgb = false, in_format = false, in_data = false, tv = false;
+    size_t values = 0;
+    struct dvbridge_lut *lut = NULL;
+    while (next_line(&t, &line, &number_of_line)) {
+        if (line.at == line.end || *line.at == '#')
+            continue;
+        struct text rest = line;
+        if (!identified) {
+            if (!word(&rest, &w) || !is(&w, "CAL")) {
+                say(why, ws, "a .cal whose first line is not CAL (ArgyllCMS's calibration)");
+                goto fail;
+            }
+            identified = true;
+            continue;
+        }
+        if (in_format) {
+            /* the names of the fields, on one line or more */
+            if (!field_names(&rest, &in_format, &fields, &at_i, &at_r, &at_g, &at_b)) {
+                say(why, ws, "more than 64 fields in the .cal (line %d)", number_of_line);
+                goto fail;
+            }
+            continue;
+        }
+        if (in_data) {
+            if (word(&rest, &w) && is(&w, "END_DATA")) {
+                if ((int)values != sets) {
+                    say(why, ws, "%zu sets of values where NUMBER_OF_SETS says %d", values, sets);
+                    goto fail;
+                }
+                /* (the first table is the calibration; what follows is not read) */
+                break;
+            }
+            if ((int)values >= sets) {
+                say(why, ws, "more sets of values than NUMBER_OF_SETS %d says (line %d)", sets, number_of_line);
+                goto fail;
+            }
+            rest = line;
+            double v[64];
+            for (int k = 0; k < fields; ++k)
+                if (!number(&rest, &v[k])) {
+                    say(why, ws, "line %d is not the %d numbers of a set", number_of_line, fields);
+                    goto fail;
+                }
+            if (!at_end(&rest)) {
+                say(why, ws, "line %d is not the %d numbers of a set", number_of_line, fields);
+                goto fail;
+            }
+            /* the input on a uniform grid from 0 to 1 (within the six places a .cal writes, and a tenth of a step) */
+            const double grid = (double)values / (double)(sets - 1);
+            const double near = fmin(1e-5, 0.1 / (double)(sets - 1));
+            if (fabs(v[at_i] - grid) > near) {
+                say(why, ws, "RGB_I of line %d is %.9g where a uniform grid of %d points has %.9g: such a .cal is not "
+                    "read", number_of_line, v[at_i], sets, grid);
+                goto fail;
+            }
+            const int at[3] = {at_r, at_g, at_b};
+            for (int c = 0; c < 3; ++c) {
+                if (!(v[at[c]] >= 0.0 && v[at[c]] <= 1.0)) {
+                    say(why, ws, "a value outside [0, 1] (line %d)", number_of_line);
+                    goto fail;
+                }
+                lut->curve[values * 3 + (size_t)c] = (float)v[at[c]];
+            }
+            ++values;
+            continue;
+        }
+        if (!word(&rest, &w))
+            continue;
+        struct text value;
+        if (is(&w, "DEVICE_CLASS")) {
+            if (!word(&rest, &value) || !is(&value, "DISPLAY")) {
+                say(why, ws, "a .cal of another device than a display (DEVICE_CLASS, line %d)", number_of_line);
+                goto fail;
+            }
+            display = true;
+        } else if (is(&w, "COLOR_REP")) {
+            if (!word(&rest, &value) || !is(&value, "RGB")) {
+                say(why, ws, "a .cal of other colours than RGB (COLOR_REP, line %d)", number_of_line);
+                goto fail;
+            }
+            rgb = true;
+        } else if (is(&w, "TV_OUTPUT_ENCODING")) {
+            tv = word(&rest, &value) && is(&value, "YES");
+        } else if (is(&w, "NUMBER_OF_SETS")) {
+            long l;
+            if (sets || !integer(&rest, &l) || !at_end(&rest) || l < 2 || l > DVBRIDGE_LUT_MAX_CURVE) {
+                say(why, ws, "NUMBER_OF_SETS is not a number of points from 2 to %d (line %d)", DVBRIDGE_LUT_MAX_CURVE,
+                    number_of_line);
+                goto fail;
+            }
+            sets = (int)l;
+        } else if (is(&w, "BEGIN_DATA_FORMAT")) {
+            if (fields) {
+                say(why, ws, "BEGIN_DATA_FORMAT given twice (line %d)", number_of_line);
+                goto fail;
+            }
+            in_format = true;
+            /* (the names may follow on the same line) */
+            if (!field_names(&rest, &in_format, &fields, &at_i, &at_r, &at_g, &at_b)) {
+                say(why, ws, "more than 64 fields in the .cal (line %d)", number_of_line);
+                goto fail;
+            }
+        } else if (is(&w, "BEGIN_DATA")) {
+            if (!display || !rgb) {
+                say(why, ws, "a .cal that does not say it is of an RGB display (DEVICE_CLASS \"DISPLAY\", COLOR_REP "
+                    "\"RGB\")");
+                goto fail;
+            }
+            if (at_i < 0 || at_r < 0 || at_g < 0 || at_b < 0) {
+                say(why, ws, "a .cal without the fields RGB_I, RGB_R, RGB_G and RGB_B");
+                goto fail;
+            }
+            if (!sets) {
+                say(why, ws, "a .cal without NUMBER_OF_SETS");
+                goto fail;
+            }
+            lut = make_identity(DVBRIDGE_LUT_CAL);
+            if (lut)
+                lut->curve = malloc((size_t)sets * 3 * sizeof(float));
+            if (!lut || !lut->curve) {
+                say(why, ws, "no memory for a 1D LUT of %d points", sets);
+                goto fail;
+            }
+            lut->curve_size = sets;
+            in_data = true;
+        }
+        /* (any other keyword: left out, as the format says) */
+    }
+    if (!identified) {
+        say(why, ws, "an empty .cal");
+        goto fail;
+    }
+    if (!lut || (int)values != sets) {
+        say(why, ws, "a .cal without its table of values (BEGIN_DATA ... END_DATA)");
+        goto fail;
+    }
+    /* the values of the device in full range (never encoded in the file), as the video card takes them */
+    lut->range_declared = true;
+    lut->tv_encoding = tv;
+    lut->signal = DVBRIDGE_LUT_SIGNAL_UNKNOWN;
+    lut->gamut = DVBRIDGE_LUT_GAMUT_UNKNOWN;
+    finish(lut, bytes, size);
+    return lut;
+fail:
+    dvbridge_lut_free(&lut);
+    return NULL;
+}
+
 /* ---------------------------------------------------------------------------------------------- madVR */
 
 #define MADVR_HEADER 96
@@ -657,7 +918,9 @@ struct dvbridge_lut *dvbridge_lut_parse(const void *bytes, size_t size, const ch
         return parse_3dl(bytes, size, range, why, why_size);
     if (ends_with(name, ".cube"))
         return parse_cube(bytes, size, range, why, why_size);
-    say(why, why_size, "the name of the file ends in neither .cube, .3dl nor .3dlut");
+    if (ends_with(name, ".cal"))
+        return parse_cal(bytes, size, why, why_size);
+    say(why, why_size, "the name of the file ends in neither .cube, .3dl, .3dlut nor .cal");
     return NULL;
 }
 
@@ -667,6 +930,7 @@ const char *dvbridge_lut_format_name(enum dvbridge_lut_format format)
     case DVBRIDGE_LUT_CUBE: return ".cube";
     case DVBRIDGE_LUT_3DL: return ".3dl";
     case DVBRIDGE_LUT_MADVR: return "madVR 3DLUT";
+    case DVBRIDGE_LUT_CAL: return ".cal";
     default: return "none";
     }
 }
@@ -706,7 +970,74 @@ static bool full(struct dvbridge_lut_range r)
     return r.lo == 0.0f && r.hi == 255.0f;
 }
 
-bool dvbridge_lut_shader(pl_shader sh, const struct dvbridge_lut *lut, pl_shader_obj *state)
+void dvbridge_lut_state_destroy(pl_gpu gpu, struct dvbridge_lut_state *state)
+{
+    if (!state)
+        return;
+    pl_shader_obj_destroy(&state->table);
+    if (gpu)
+        pl_tex_destroy(gpu, &state->curve);
+    state->curve = NULL;
+    state->curve_signature = 0;
+}
+
+/* Hades: the texture of a LUT's 1D LUT (its points in rows of DVBRIDGE_LUT_CURVE_ROW, RGBA of 32-bit floats, read at
+ * the centres of its texels), made again only for another LUT */
+static bool curve_texture(pl_gpu gpu, const struct dvbridge_lut *lut, struct dvbridge_lut_state *state)
+{
+    if (state->curve && state->curve_signature == lut->pl.signature)
+        return true;
+    pl_tex_destroy(gpu, &state->curve);
+    state->curve_signature = 0;
+    const int n = lut->curve_size, w = n < DVBRIDGE_LUT_CURVE_ROW ? n : DVBRIDGE_LUT_CURVE_ROW;
+    const int h = (n + w - 1) / w;
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32, PL_FMT_CAP_SAMPLEABLE);
+    float *rgba = fmt ? calloc((size_t)w * (size_t)h * 4, sizeof(float)) : NULL;
+    if (!rgba)
+        return false;
+    for (int i = 0; i < n; ++i)
+        memcpy(rgba + (size_t)i * 4, lut->curve + (size_t)i * 3, 3 * sizeof(float));
+    state->curve = pl_tex_create(gpu, pl_tex_params(.w = w, .h = h, .format = fmt, .sampleable = true,
+                                                     .initial_data = rgba, .debug_tag = PL_DEBUG_TAG));
+    free(rgba);
+    if (!state->curve)
+        return false;
+    state->curve_signature = lut->pl.signature;
+    return true;
+}
+
+/* Hades: a LUT's 1D LUT on the signal at the input of its 3D table, each channel by its curve, linearly between its
+ * two points around it */
+static bool curve_shader(pl_gpu gpu, pl_shader sh, const struct dvbridge_lut *lut, struct dvbridge_lut_state *state)
+{
+    if (!gpu || !curve_texture(gpu, lut, state))
+        return false;
+    const int n = lut->curve_size, w = n < DVBRIDGE_LUT_CURVE_ROW ? n : DVBRIDGE_LUT_CURVE_ROW;
+    char body[1024];
+    snprintf(body, sizeof(body),
+             "{\n"
+             "    vec3 lut_p = clamp(color.rgb, 0.0, 1.0) * vec3(%d.0);\n"
+             "    ivec3 lut_i = ivec3(min(floor(lut_p), vec3(%d.0)));\n"
+             "    vec3 lut_f = lut_p - vec3(lut_i);\n"
+             "    ivec3 lut_j = lut_i + ivec3(1);\n"
+             "    color.r = mix(texelFetch(dvbridge_curve, ivec2(lut_i.r %% %d, lut_i.r / %d), 0).r,\n"
