+#pragma once
+
+#include "utils/DisplayIdentity.h"
+#include "utils/SoundOutputs.h"
+#include "windowing/gbm/drm/DRMSoundOutputs.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <string>
+#include <system_error>
+#include <vector>
+
+/*!
+ * Hades: whether the user keeps on, with hades-keep-outputs, the graphics output that carries the
+ * sound of an audio output.
+ *
+ * The windowing system keeps on the outputs that the file names (KEEP_OUTPUTS::CKeepOutputs,
+ * CDRMUtils::KeepsOutputOn()), whatever the expert setting "Keep the display of the audio output
+ * on" (audiooutput.hadeslightforsound) says. With that setting off, the audio engine sent the sound
+ * of such an output to the output of the display in use instead
+ * (ActiveAE::INTERNAL::OutputForDisplayInUse()), as if it were off. Issue #24 (2026-11-13): an AV
+ * receiver on the HDMI port of the board (an LSPCON, DP-1 of i915) named in the file, the TV on an
+ * RTX 3050 for the picture: DP-1 stayed lit "for its sound (hades-keep-outputs)", and the sound went
+ * to the TV. An output that the file keeps on now counts as one that the setting keeps on.
+ *
+ * The kernel has no link from a PCM to a connector: as the windowing system does
+ * (KEEP_OUTPUTS::OutputsForSound()), the sound card is matched to its graphics device by where both
+ * are on the PCI bus (KEEP_OUTPUTS::CardOfDevice()), and the display of the PCM (its ELD) to the
+ * display of a connector (its EDID: KODI::UTILS::SameDisplay()). The connectors are read from
+ * /sys/class/drm, whose names the file uses ("DP-1", "card0-HDMI-A-2"); the graphics devices that
+ * Kodi does not draw on are there too.
+ */
+namespace ActiveAE::KEPT
+{
+using KODI::WINDOWING::GBM::KEEP_OUTPUTS::CKeepOutputs;
+using KODI::WINDOWING::GBM::KEEP_OUTPUTS::GraphicsDevice;
+using KODI::WINDOWING::GBM::KEEP_OUTPUTS::GraphicsOutput;
+
+/*!
+ * \brief The outputs that the file keeps on and that have a display now, by their devices, as
+ *        /sys/class/drm (root) has them: of each device its node ("/dev/dri/card0") and PCI address,
+ *        of each output its name and its display (by its EDID: maker and product)
+ * \return nothing where the file keeps nothing (nothing is read then)
+ */
+inline std::vector<GraphicsDevice> KeptGraphicsOutputs(const CKeepOutputs& kept,
+                                                       const std::string& root)
+{
+  namespace fs = std::filesystem;
+  std::vector<GraphicsDevice> devices;
+  if (!kept.Any())
+    return devices;
+  std::error_code ec;
+  for (fs::directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec))
+  {
+    // "card<N>-<output>": the outputs, not the devices ("card0") nor the render nodes
+    const std::string entry = it->path().filename().string();
+    const auto dash = entry.find('-');
+    if (entry.rfind("card", 0) != 0 || dash == std::string::npos || dash == 4 ||
+        entry.find_first_not_of("0123456789", 4) != dash)
+      continue;
+    const std::string card = entry.substr(0, dash);
+    const std::string name = entry.substr(dash + 1);
+    const std::string node = "/dev/dri/" + card;
+    if (name.empty() || !kept.Keeps(node, name))
+      continue;
+
+    std::ifstream status(it->path() / "status");
+    std::string state;
+    if (!(status >> state) || state != "connected")
+      continue;
+    std::ifstream edidFile(it->path() / "edid", std::ios::binary);
+    const std::vector<uint8_t> edid((std::istreambuf_iterator<char>(edidFile)),
+                                    std::istreambuf_iterator<char>());
+
+    GraphicsOutput output;
+    output.name = name;
+    const auto typeEnd = name.rfind('-');
+    output.sound = typeEnd != std::string::npos &&
+                   KODI::WINDOWING::GBM::KEEP_OUTPUTS::CarriesSound(name.substr(0, typeEnd));
+    output.connected = true;
+    output.identity = KODI::UTILS::IdentityOfEdid(edid);
+    output.identity.output = name;
+
+    auto device = std::ranges::find_if(devices, [&node](const GraphicsDevice& d)
+                                       { return d.node == node; });
+    if (device == devices.end())
+    {
+      GraphicsDevice d;
+      d.node = node;
+      std::error_code pciError;
+      const fs::path pci = fs::canonical(fs::path(root) / card / "device", pciError);
+      if (!pciError)
+        d.pci = pci.filename().string();
+      devices.push_back(std::move(d));
+      device = devices.end() - 1;
+    }
+    device->outputs.push_back(std::move(output));
+  }
+  return devices;
+}
+
+//! An output that the file keeps on, with the display of an audio output
+struct KeptOutput
+{
+  std::string node;
+  std::string output;
+  KODI::UTILS::DisplayIdentity display;
+};
+
+/*!
+ * \brief Which of the outputs that the file keeps on carries the sound of an audio output: an
+ *        output that can carry sound, of the graphics device of its sound card, whose display is
+ *        the one its ELD names; none where its display or its card is not known
+ */
+inline std::optional<KeptOutput> KeptOutputOfSound(const KODI::UTILS::SoundOutput& sound,
+                                                   const std::vector<GraphicsDevice>& kept)
+{
+  if (!sound.identity.Known())
+    return std::nullopt;
+  for (const GraphicsDevice& device : kept)
+  {
+    if (!KODI::WINDOWING::GBM::KEEP_OUTPUTS::CardOfDevice(sound, device))
+      continue;
+    for (const GraphicsOutput& output : device.outputs)
+    {
+      if (output.sound && KODI::UTILS::SameDisplay(sound.identity, output.identity))
+        return KeptOutput{device.node, output.name, output.identity};
+    }
+  }
+  return std::nullopt;
+}
+} // namespace ActiveAE::KEPT
