+namespace
+{
+// Hades: the outputs that the user keeps on (hades-keep-outputs, in the userdata folder), read once,
+// as the windowing system reads them (CDRMUtils, KeptOutputs())
+const KODI::WINDOWING::GBM::KEEP_OUTPUTS::CKeepOutputs& UserKeptOutputs()
+{
+  static const KODI::WINDOWING::GBM::KEEP_OUTPUTS::CKeepOutputs kept = []
+  {
+    KODI::WINDOWING::GBM::KEEP_OUTPUTS::CKeepOutputs list;
+    std::ifstream in(CSpecialProtocol::TranslatePath("special://masterprofile/hades-keep-outputs"));
+    if (in)
+      list.Parse(in);
+    return list;
+  }();
+  return kept;
+}
+} // unnamed namespace
+
+bool CActiveAE::KeptOnByUser(const std::string& device,
+                             const KODI::UTILS::DisplayIdentity& remembered) const
+{
+  const auto& file = UserKeptOutputs();
+  const AESinkDevice dev = CAESinkFactory::ParseDevice(device);
+  if (!file.Any() || dev.driver.empty() || dev.name.empty())
+    return false;
+
+  // The sound output as PublishSoundOutputs() says it to the windowing system: where its card is,
+  // and its display (the one the setting was chosen with first, as OutputForDisplayInUse() takes
+  // it; else the one it has now; else the last one it had in this run)
+  KODI::UTILS::SoundOutput sound;
+  sound.device = dev.driver + ':' + dev.name;
+  const std::vector<std::pair<std::string, CAEDeviceInfo>> listed = m_sink.ListedOutputs();
+  const auto info =
+      std::ranges::find_if(listed, [&sound](const auto& l) { return l.first == sound.device; });
+  const auto seen = m_soundSeen.find(sound.device);
+  if (info != listed.end())
+  {
+    sound.card = info->second.m_cardDevice;
+    sound.cardSuppliers = info->second.m_cardSuppliers;
+    if (info->second.m_display == CAEDeviceInfo::Display::PRESENT)
+      sound.identity = info->second.m_displayIdentity;
+  }
+  if (remembered.Known())
+    sound.identity = remembered;
+  if (seen != m_soundSeen.end())
+  {
+    if (!sound.identity.Known())
+      sound.identity = seen->second.identity;
+    if (sound.card.empty())
+    {
+      sound.card = seen->second.card;
+      sound.cardSuppliers = seen->second.suppliers;
+    }
+  }
+
+  const std::optional<ActiveAE::KEPT::KeptOutput> kept = ActiveAE::KEPT::KeptOutputOfSound(
+      sound, ActiveAE::KEPT::KeptGraphicsOutputs(file, "/sys/class/drm"));
+
+  // in the log when it changes
+  const std::string told = kept ? kept->node + ' ' + kept->output : std::string("none");
+  std::unique_lock lock(m_keptByUserLock);
+  std::string& before = m_keptByUserTold[sound.device];
+  if (before != told)
+  {
+    before = told;
+    if (kept)
+      CLog::Log(LOGINFO,
+                "ActiveAE - hades-keep-outputs keeps {} {} on, which has the display of '{}' ({}): "
+                "its sound stays on that output, as with \"Keep the display of the audio output "
+                "on\"",
+                kept->node, kept->output, sound.device, sound.identity.Describe());
+    else
+      CLog::Log(LOGINFO,
+                "ActiveAE - hades-keep-outputs keeps outputs on ({}), and none of them is certain to "
+                "carry the sound of '{}' ({}; its sound card {}): its sound follows the display in "
+                "use, unless \"Keep the display of the audio output on\" is on",
+                file.Describe(), sound.device, sound.identity.Describe(),
+                sound.card.empty() ? std::string("not known") : sound.card);
+  }
+  return kept.has_value();
+}
