+#include "cores/AudioEngine/Engines/ActiveAE/ActiveAEKeptOutputs.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace ActiveAE::KEPT;
+using KODI::UTILS::DisplayIdentity;
+using KODI::UTILS::SoundOutput;
+namespace KEEP = KODI::WINDOWING::GBM::KEEP_OUTPUTS;
+
+namespace
+{
+// The makers of the displays of issue #24 by their PNP IDs: Pioneer ("PIO"), LG ("GSM")
+constexpr uint16_t PIO = (16 << 10) | (9 << 5) | 15;
+constexpr uint16_t GSM = (7 << 10) | (19 << 5) | 13;
+
+// A base block of an EDID that IdentityOfEdid() takes, of this maker and product
+std::vector<uint8_t> Edid(uint16_t maker, uint16_t product)
+{
+  std::vector<uint8_t> edid(128, 0);
+  const uint8_t header[8] = {0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00};
+  std::copy(std::begin(header), std::end(header), edid.begin());
+  edid[8] = static_cast<uint8_t>(maker >> 8);
+  edid[9] = static_cast<uint8_t>(maker & 0xFF);
+  edid[10] = static_cast<uint8_t>(product & 0xFF);
+  edid[11] = static_cast<uint8_t>(product >> 8);
+  unsigned int sum = 0;
+  for (size_t i = 0; i < 127; ++i)
+    sum += edid[i];
+  edid[127] = static_cast<uint8_t>((256 - sum % 256) % 256);
+  return edid;
+}
+
+DisplayIdentity Display(uint16_t maker, uint16_t product)
+{
+  DisplayIdentity id;
+  id.maker = maker;
+  id.product = product;
+  return id;
+}
+
+CKeepOutputs File(const char* text)
+{
+  std::istringstream in(text);
+  CKeepOutputs kept;
+  kept.Parse(in);
+  return kept;
+}
+
+// /sys/class/drm of the PC of issue #24 as its report gives it: i915 (00:02.0) with the AV
+// receiver on DP-1 (the HDMI port of the board, through an LSPCON) and nothing on HDMI-A-1; an RTX
+// 3050 (01:00.0) with the LG B7 on HDMI-A-3 and a monitor on DP-1 (the monitor is added here, to
+// tell an output name on any card from one on a card). The product code of the B7 is not in the
+// report: one is made up.
+class Sysfs : public ::testing::Test
+{
+protected:
+  void SetUp() override
+  {
+    namespace fs = std::filesystem;
+    std::random_device random;
+    m_root = fs::temp_directory_path() / ("hades-kept-" + std::to_string(random()));
+    fs::create_directories(m_root);
+    Device("card0", "0000:00:02.0");
+    Device("card1", "0000:01:00.0");
+    Output("card0-DP-1", true, Edid(PIO, 0x1097));
+    Output("card0-HDMI-A-1", false, {});
+    Output("card0-eDP-1", false, {});
+    Output("card1-HDMI-A-3", true, Edid(GSM, 0xC0A0));
+    Output("card1-DP-1", true, Edid(GSM, 0x5BBF));
+    fs::create_directories(m_root / "renderD128");
+    std::ofstream(m_root / "version") << "drm 1.1.0\n";
+  }
+  void TearDown() override
+  {
+    std::error_code ec;
+    std::filesystem::remove_all(m_root, ec);
+  }
+  void Device(const std::string& card, const std::string& pci)
+  {
+    namespace fs = std::filesystem;
+    fs::create_directories(m_root / "devices" / pci);
+    fs::create_directories(m_root / card);
+    fs::create_directory_symlink(m_root / "devices" / pci, m_root / card / "device");
+  }
+  void Output(const std::string& name, bool connected, const std::vector<uint8_t>& edid)
+  {
+    std::filesystem::create_directories(m_root / name);
+    std::ofstream(m_root / name / "status") << (connected ? "connected\n" : "disconnected\n");
+    std::ofstream(m_root / name / "edid", std::ios::binary)
+        .write(reinterpret_cast<const char*>(edid.data()), static_cast<std::streamsize>(edid.size()));
+  }
+  std::vector<GraphicsDevice> Kept(const char* file) const
+  {
+    return KeptGraphicsOutputs(File(file), m_root.string());
+  }
+  std::filesystem::path m_root;
+};
+
+// The sound of the receiver: the HD Audio controller of the chipset (00:1f.3), which the i915
+// audio component links to the graphics (00:02.0), with the ELD of the receiver
+SoundOutput Receiver()
+{
+  SoundOutput s;
+  s.device = "ALSA:hdmi:CARD=PCH,DEV=0";
+  s.kind = SoundOutput::Kind::DISPLAY;
+  s.identity = Display(PIO, 0x1097);
+  s.card = "0000:00:1f.3";
+  s.cardSuppliers = {"0000:00:02.0"};
+  return s;
+}
+
+// The sound of the TV: the HD Audio function of the RTX 3050
+SoundOutput Tv()
+{
+  SoundOutput s;
+  s.device = "ALSA:hdmi:CARD=NVidia,DEV=0";
+  s.kind = SoundOutput::Kind::DISPLAY;
+  s.identity = Display(GSM, 0xC0A0);
+  s.card = "0000:01:00.1";
+  return s;
+}
+} // namespace
+
+TEST_F(Sysfs, TheReceiverOfIssue24IsKeptByItsOutputName)
+{
+  const std::vector<GraphicsDevice> kept = Kept("DP-1\n");
+  // DP-1 of both cards (a name without a card is on any card), each with its display and the PCI
+  // address of its device
+  ASSERT_EQ(2u, kept.size());
+  for (const GraphicsDevice& device : kept)
+  {
+    ASSERT_EQ(1u, device.outputs.size());
+    EXPECT_EQ("DP-1", device.outputs[0].name);
+    EXPECT_TRUE(device.outputs[0].sound);
+    EXPECT_EQ(device.node == "/dev/dri/card0" ? "0000:00:02.0" : "0000:01:00.0", device.pci);
+  }
+  const auto match = KeptOutputOfSound(Receiver(), kept);
+  ASSERT_TRUE(match.has_value());
+  EXPECT_EQ("/dev/dri/card0", match->node);
+  EXPECT_EQ("DP-1", match->output);
+  // the TV is not on an output that the file keeps on
+  EXPECT_FALSE(KeptOutputOfSound(Tv(), kept).has_value());
+}
+
+TEST_F(Sysfs, AnOutputOfOneCard)
+{
+  EXPECT_TRUE(KeptOutputOfSound(Receiver(), Kept("card0-dp-1   # the receiver\n")).has_value());
+  // DP-1 of the other card has another display, on another card
+  EXPECT_FALSE(KeptOutputOfSound(Receiver(), Kept("card1-DP-1\n")).has_value());
+}
+
+TEST_F(Sysfs, EveryOutput)
+{
+  const std::vector<GraphicsDevice> kept = Kept("*\n");
+  EXPECT_TRUE(KeptOutputOfSound(Receiver(), kept).has_value());
+  const auto tv = KeptOutputOfSound(Tv(), kept);
+  ASSERT_TRUE(tv.has_value());
+  EXPECT_EQ("HDMI-A-3", tv->output);
+  // an output with nothing on it, and one that cannot carry sound, are not listed or not taken
+  for (const GraphicsDevice& device : kept)
+  {
+    for (const GraphicsOutput& output : device.outputs)
+      EXPECT_NE("HDMI-A-1", output.name);
+  }
+}
+
+TEST_F(Sysfs, NothingWithoutTheFile)
+{
+  EXPECT_TRUE(Kept("").empty());
+  EXPECT_TRUE(Kept("# nothing\n").empty());
+  EXPECT_FALSE(KeptOutputOfSound(Receiver(), Kept("")).has_value());
+  // a name that is not there
+  EXPECT_FALSE(KeptOutputOfSound(Receiver(), Kept("HDMI-A-9\n")).has_value());
+  // a root that is not there
+  EXPECT_TRUE(KeptGraphicsOutputs(File("*\n"), "/nonexistent-hades-kept").empty());
+}
+
+TEST_F(Sysfs, NotCertainIsNotKept)
+{
+  const std::vector<GraphicsDevice> kept = Kept("DP-1\n");
+  // its display not known, or its sound card not known: as before (the setting decides)
+  SoundOutput s = Receiver();
+  s.identity = DisplayIdentity{};
+  EXPECT_FALSE(KeptOutputOfSound(s, kept).has_value());
+  s = Receiver();
+  s.card.clear();
+  s.cardSuppliers.clear();
+  EXPECT_FALSE(KeptOutputOfSound(s, kept).has_value());
+  // the same display on the card of another device
+  s = Receiver();
+  s.card = "0000:03:00.1";
+  s.cardSuppliers.clear();
+  EXPECT_FALSE(KeptOutputOfSound(s, kept).has_value());
+}
+
+TEST(TestActiveAEKeptOutputs, TheWindowingSystemSaysWhatTheFileKeeps)
+{
+  // KEEP_OUTPUTS::OutputsForSound() with "Keep the display of the audio output on" off: the output
+  // of the receiver, which hades-keep-outputs keeps on, stays in the decision with the sound that
+  // goes to it; without the file, as before, nothing is kept and the log says it is not
+  KEEP::GraphicsDevice i915;
+  i915.node = "/dev/dri/card0";
+  i915.pci = "0000:00:02.0";
+  KEEP::GraphicsOutput dp;
+  dp.name = "DP-1";
+  dp.sound = true;
+  dp.connected = true;
+  dp.identity = Display(PIO, 0x1097);
+  i915.outputs.push_back(dp);
+  KEEP::GraphicsDevice nvidia;
+  nvidia.node = "/dev/dri/card1";
+  nvidia.pci = "0000:01:00.0";
+  KEEP::GraphicsOutput hdmi;
+  hdmi.name = "HDMI-A-3";
+  hdmi.sound = true;
+  hdmi.connected = true;
+  hdmi.identity = Display(GSM, 0xC0A0);
+  nvidia.outputs.push_back(hdmi);
+  const std::vector<KEEP::GraphicsDevice> devices{nvidia, i915};
+  const KEEP::OutputKey picture{"/dev/dri/card1", "HDMI-A-3"};
+
+  const CKeepOutputs file = File("DP-1\n");
+  const KEEP::SoundDecision withFile =
+      KEEP::OutputsForSound({Receiver()}, true, devices, picture, false, &file);
+  EXPECT_TRUE(withFile.Keeps("/dev/dri/card0", "DP-1"));
+  const auto saysNotKept = [](const KEEP::SoundDecision& d)
+  {
+    return std::ranges::any_of(d.notes, [](const std::string& note)
+                               { return note.find("/dev/dri/card0: DP-1 (") == 0 &&
+                                        note.find("is not kept on") != std::string::npos; });
+  };
+  EXPECT_FALSE(saysNotKept(withFile));
+
+  const KEEP::SoundDecision without =
+      KEEP::OutputsForSound({Receiver()}, true, devices, picture, false);
+  EXPECT_FALSE(without.Keeps("/dev/dri/card0", "DP-1"));
+  EXPECT_TRUE(saysNotKept(without));
+  const CKeepOutputs other = File("HDMI-A-1\n");
+  EXPECT_FALSE(KEEP::OutputsForSound({Receiver()}, true, devices, picture, false, &other)
+                   .Keeps("/dev/dri/card0", "DP-1"));
+  // the setting on: as before, with or without the file
+  EXPECT_TRUE(KEEP::OutputsForSound({Receiver()}, true, devices, picture, true)
+                  .Keeps("/dev/dri/card0", "DP-1"));
+}
