From b4d70da8df2e3ffd5de4d107d8fc7fb9cc836630 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:47:32 +0000
Subject: [PATCH] [Hades][GBM] HDMI VRR as the settings ask at the end of
 native Dolby Vision, and a change of them in the menus at once

An LG C5 (RTX 4080 SUPER, menus at 3840x2160 and 120 Hz over HDMI FRL)
stayed black at the end of a native Dolby Vision film,
with "Video at its own rate with VRR" at "Always". "Always" had been turned on
while the menus showed, and a change of NV_HDMI_VRR_OFF waits for a mode set:
the menus kept the mode they had, with HDMI VRR off. Native Dolby Vision found
that 1, gave it back with the mode set that ended it, and the
next frame's commit staged 0 for "Always": a second mode set over FRL, its link
trained again, 273 ms after the first, while the TV was still
setting itself up for the first. The kernel log says that both finished (the
raster runs, the four lanes locked over SCDC) and Kodi went on; the
picture did not come back. The same setup gave the first SDR video after
"Always" a change of mode to 23.976 Hz instead of VRR (the refusal
of VRR_VIDEO::RefusedForModeSetOnly()).

- CHdmiVrrOff::AtHandBack(): the end of native Dolby Vision puts back what the
  settings ask of Kodi's mode sets then, as an intent of
  CWinSystemGbm::HandBackIntents() (the colour range and format go the same
  way), so that the one mode set that ends it is the one the menus need.
- CHdmiVrrOff::ModesetForSetting(): a change of "HDMI variable refresh rate
  (VRR)" or "Video at its own rate with VRR" while the menus show goes out at
  once, in a mode set of its own (as a change of "Use limited colour range"
  does); not during a video, native Dolby Vision or a mode set on its way, which
  take it. The first frame only takes note of the settings.

kodi.log: "HDMI VRR: the settings of VRR changed while the menus show ...",
"... allowed again with this mode set, one of its own for the change of the
setting", and "DVBridge: the end of native output puts NV_HDMI_VRR_OFF back as
the settings of VRR ask for it now".
---
 xbmc/windowing/gbm/HdmiVrrOff.h     | 37 ++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp | 82 ++++++++++++++++++++++++-----
 xbmc/windowing/gbm/WinSystemGbm.h   |  9 +++-
 3 files changed, 114 insertions(+), 14 deletions(-)

diff --git a/xbmc/windowing/gbm/HdmiVrrOff.h b/xbmc/windowing/gbm/HdmiVrrOff.h
index 66404de..106cf82 100644
--- a/xbmc/windowing/gbm/HdmiVrrOff.h
+++ b/xbmc/windowing/gbm/HdmiVrrOff.h
@@ -56,7 +56,11 @@ namespace GBM
  * (COutputHandover: the property is captured, set to 1 with the transport and put back with its
  * end): the EMP of HDMI VRR would go out beside the Dolby InfoFrame in every mode of 50 Hz and up
  * on a display that declares HDMI VRR. While native Dolby Vision has the output, nothing here
- * stages it (Stage(): nativeDV).
+ * stages it (Stage(): nativeDV); its end puts back what the settings ask for then (AtHandBack()).
+ *
+ * A change of the settings while the menus show goes out at once, in a mode set of its own
+ * (ModesetForSetting()), as a change of the resolution does: the menus then have the mode that the
+ * next video counts on.
  */
 class CHdmiVrrOff
 {
@@ -153,6 +157,37 @@ public:
     return want;
   }
 
+  /*!
+   * \brief Whether a change of the settings (Allowed()) goes out at once, in a mode set of its own
+   *        (StageHdmiVrrOff()): the settings changed since the menus last saw them, no mode set is
+   *        on its way, native Dolby Vision does not have the output and no video plays (the mode
+   *        set at the end of a video, or of the next one, takes it). Before (1.1g), a change waited
+   *        for the next mode set, and the menus kept the mode they had: with "Always" turned on,
+   *        their mode had HDMI VRR off, the next video changed the mode instead of going with VRR
+   *        (VRR_VIDEO::RefusedForModeSetOnly()), and native Dolby Vision gave back the value it
+   *        found, so that its end made two changes of mode in a row (the LG C5, 2026-11-19 10:04:06
+   *        and 10:04:07, after which the TV stayed black).
+   */
+  static constexpr bool ModesetForSetting(bool settingsChanged,
+                                          bool modesetPending,
+                                          bool nativeDV,
+                                          bool videoPlaying)
+  {
+    return settingsChanged && !modesetPending && !nativeDV && !videoPlaying;
+  }
+
+  /*!
+   * \brief The value that the end of native Dolby Vision puts back (COutputHandover: what it found
+   *        when it started, unless Kodi says otherwise, CWinSystemGbm::HandBackIntents()): what
+   *        the settings ask of Kodi's mode sets now (Reason() without HDR10+, which only the mode
+   *        set of an HDR10+ video asks for), so that the mode set that ends it is the one that the
+   *        menus need, and no other follows it
+   */
+  static constexpr uint64_t AtHandBack(bool settingAllowsVrr)
+  {
+    return Reason(settingAllowsVrr, false) != Why::NONE ? 1 : 0;
+  }
+
   /*!
    * \brief A test of a request failed whose value is inRequest: the value to test it again with,
    *        0 (the request asked for VRR off only where the kernel had 0: Stage()), or nothing
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index dc67945..c075fe1 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -5198,6 +5198,7 @@ void CWinSystemGbm::StageHdmiVrrOff()
 {
   m_hdmiVrrOffStaged.reset();
   m_hdmiVrrOffBySetting = false;
+  m_hdmiVrrOffForSetting = false;
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
   if (!connector || !connector->SupportsProperty(CHdmiVrrOff::PROPERTY))
@@ -5205,8 +5206,31 @@ void CWinSystemGbm::StageHdmiVrrOff()
     m_hdmiVrrOffWanted = false;
     return;
   }
-  // (a change of it needs a mode set: without one there is nothing to stage, nor a setting to read)
-  if (!drm->ModesetPending())
+  // Hades: the two settings as they are now (off where they cannot be read): a change of them while
+  // the menus show goes out at once, in a mode set of its own (CHdmiVrrOff::ModesetForSetting());
+  // the first frame only takes note of them, as its mode set already had them
+  std::pair<bool, int> settingsNow{false, 0};
+  if (const auto component = CServiceBroker::GetSettingsComponent())
+    if (const auto settings = component->GetSettings())
+    {
+      if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR))
+        settingsNow.first = settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR);
+      if (settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEOMODE))
+        settingsNow.second = settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEOMODE);
+    }
+  if (!m_hdmiVrrSettingsSeen)
+    m_hdmiVrrSettingsSeen = settingsNow;
+  const bool settingsChanged = *m_hdmiVrrSettingsSeen != settingsNow;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  const bool forSetting =
+      CHdmiVrrOff::ModesetForSetting(settingsChanged, drm->ModesetPending(), NativeDVOutputInUse(),
+                                     player && player->IsPlayingVideo());
+  // (a mode set takes the settings as they are now, whichever asks for it)
+  if (drm->ModesetPending() || forSetting)
+    m_hdmiVrrSettingsSeen = settingsNow;
+  // (a change of it needs a mode set: without one, and without a change of the settings that asks
+  // for one, there is nothing to stage)
+  if (!drm->ModesetPending() && !forSetting)
     return;
   // the setting holds for every mode set that Kodi makes; HDR10+ for the commit of its video's mode
   const auto why = CHdmiVrrOff::Reason(HdmiVrrAllowedBySetting(), m_hdmiVrrOffWanted);
@@ -5217,6 +5241,18 @@ void CWinSystemGbm::StageHdmiVrrOff()
   {
     m_hdmiVrrOffStaged = value;
     m_hdmiVrrOffBySetting = why == CHdmiVrrOff::Why::SETTING;
+    if (forSetting)
+    {
+      m_hdmiVrrOffForSetting = true;
+      drm->AllowModeset();
+      CLog::Log(
+          LOGINFO,
+          "HDMI VRR: the settings of VRR changed while the menus show (\"HDMI variable refresh "
+          "rate (VRR)\" {}, \"Video at its own rate with VRR\" {}): {} {} goes to {} with a "
+          "mode set of its own, so that the next video finds the mode it counts on",
+          settingsNow.first ? "on" : "off", settingsNow.second, CHdmiVrrOff::PROPERTY, *value,
+          connector->GetName());
+    }
   }
 }
 
@@ -5259,16 +5295,20 @@ void CWinSystemGbm::HdmiVrrOffCommitted()
               CHdmiVrrOff::PROPERTY, refresh,
               wanted ? "the commit fell back" : "the request changed meanwhile");
   else if (kernel == 0u)
-    CLog::Log(LOGINFO,
-              "HDMI VRR: allowed again with this mode set ({} 0): the driver turns it on where the "
-              "display declares it, from 50 Hz up{}",
-              CHdmiVrrOff::PROPERTY,
-              VrrVideoMode() == VRR_VIDEO::Mode::ALWAYS
-                  ? " (\"Video at its own rate with VRR\" is \"Always\")"
-              : AutoVrrDisplay() ? " (the display has no mode of 23.976 Hz or twice it at any "
-                                   "resolution: a video of a rate it has no mode of goes at its "
-                                   "own rate with VRR)"
-                                 : "");
+    CLog::Log(
+        LOGINFO,
+        "HDMI VRR: allowed again with this mode set{} ({} 0): the driver turns it on where the "
+        "display declares it, from 50 Hz up{}",
+        std::exchange(m_hdmiVrrOffForSetting, false) ? ", one of its own for the change of the "
+                                                       "setting"
+                                                     : "",
+        CHdmiVrrOff::PROPERTY,
+        VrrVideoMode() == VRR_VIDEO::Mode::ALWAYS
+            ? " (\"Video at its own rate with VRR\" is \"Always\")"
+        : AutoVrrDisplay() ? " (the display has no mode of 23.976 Hz or twice it at any "
+                             "resolution: a video of a rate it has no mode of goes at its "
+                             "own rate with VRR)"
+                           : "");
 }
 
 void CWinSystemGbm::ReadRgbRangeOutput()
@@ -5361,6 +5401,24 @@ void CWinSystemGbm::HandBackIntents(COutputHandover& state)
                                                   m_formatRefusedKey == key))
         intents.emplace_back(m_formatProperty, *value);
     }
+    // HDMI VRR: what the settings ask of Kodi's mode sets now (CHdmiVrrOff::AtHandBack()), in place
+    // of what was found when the video started. Put back as found, the end of native output left
+    // HDMI VRR off where the settings had turned it on meanwhile, and the next frame's commit made
+    // a second change of mode to allow it (the LG C5 with "Always", 2026-11-19 10:04:06 and
+    // 10:04:07, two mode sets over FRL 273 ms apart, after which the TV stayed black). Now the
+    // mode set that ends native output is the one that the menus need.
+    if (const auto found = state.FoundValue(CHdmiVrrOff::PROPERTY))
+    {
+      const uint64_t want = CHdmiVrrOff::AtHandBack(HdmiVrrAllowedBySetting());
+      intents.emplace_back(CHdmiVrrOff::PROPERTY, want);
+      if (want != *found)
+        CLog::Log(
+            LOGINFO,
+            "DVBridge: the end of native output puts {} back as the settings of VRR ask for it "
+            "now ({}, it was {} when the video started): the change of mode that ends it is "
+            "the one that the menus need, and no other follows it",
+            CHdmiVrrOff::PROPERTY, want, *found);
+    }
   }
   state.SetHandBackIntents(intents);
 }
diff --git a/xbmc/windowing/gbm/WinSystemGbm.h b/xbmc/windowing/gbm/WinSystemGbm.h
index b2eb095..c2a57aa 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.h
+++ b/xbmc/windowing/gbm/WinSystemGbm.h
@@ -527,13 +527,20 @@ protected:
   //! ... and, in every mode set that Kodi makes, while "HDMI variable refresh rate (VRR)" is off
   //! (videoscreen.hadeshdmivrr): the staged value came from the setting (for the log)
   bool m_hdmiVrrOffBySetting = false;
+  //! ... the two settings of VRR as the menus last saw them ("HDMI variable refresh rate (VRR)" and
+  //! "Video at its own rate with VRR"): a change of them while the menus show goes out at once, with
+  //! a mode set of its own (CHdmiVrrOff::ModesetForSetting())
+  std::optional<std::pair<bool, int>> m_hdmiVrrSettingsSeen;
+  //! ... that mode set was asked for by such a change (for the log)
+  bool m_hdmiVrrOffForSetting = false;
   //! Hades: NV_HDMI_FRL_KEEP (FrlKeep.h): the modes of videos stay on HDMI FRL while the menus need
   //! it; staged in each commit with a mode set (StageFrlKeep()), what came of it said after the
   //! commit (FrlKeepCommitted()); not asked for while the menus go to a TMDS mode after a hang
   //! (m_frlKeepBlocked, set by CWinSystemGbmGLESContext::FallBackToTmdsMode())
   std::optional<uint64_t> m_frlKeepStaged;
   bool m_frlKeepModeset = false;
-  bool m_frlKeepBlocked = false;
+  //! (read on other threads as well)
+  std::atomic<bool> m_frlKeepBlocked{false};
   KODI::WINDOWING::GBM::FRL_KEEP::Why m_frlKeepWhy =
       KODI::WINDOWING::GBM::FRL_KEEP::Why::MENUS_FIT_TMDS;
   int64_t m_frlKeepMenusKHz = 0;
-- 
2.53.0

