 .../VideoPlayer/DVDSubtitles/SubtitlesStyle.h | 25 +++++++----
 .../VideoPlayer/VideoRenderers/CMakeLists.txt |  1 +
 .../VideoRenderers/OverlayRenderer.cpp        | 11 +++--
 .../VideoPlayer/VideoRenderers/OverlayShape.h | 44 +++++++++++++++++++
 5 files changed, 72 insertions(+), 15 deletions(-)
 create mode 100644 xbmc/cores/VideoPlayer/VideoRenderers/OverlayShape.h

diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
index 4e723e1..70e7d62 100644
--- a/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/DVDSubtitlesLibass.cpp
@@ -348,9 +348,9 @@ ASS_Image* CDVDSubtitlesLibass::RenderImage(double pts,
     m_appliedStyle = subStyle;
   }
 
-  // Hades: the pixel aspect ratio as Kodi has it, which libass takes as it is: turned around as
-  // 2 - ratio, the subtitles of a 3D output side by side went out twice as wide, and those of top
-  // and bottom stretched (LibassPixelAspect())
+  // Hades: libass's pixel aspect ratio is the inverse of Kodi's pixel ratio of the resolution:
+  // the subtitles of each eye of a 3D output side by side are drawn half as wide (twice as wide top
+  // and bottom), with the lines of the 2D picture, and shown in their shape (LibassPixelAspect())
   ass_set_pixel_aspect(m_renderer, LibassPixelAspect(opts.m_par));
 
   ass_set_frame_size(m_renderer, static_cast<int>(opts.frameWidth),
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
index a325681..1ad5872 100644
--- a/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/SubtitlesStyle.h
@@ -134,18 +134,25 @@ struct renderOpts
  * \brief Hades: the pixel aspect ratio that libass is given (ass_set_pixel_aspect()) for Kodi's
  *        pixel ratio of the resolution (renderOpts::m_par, RESOLUTION_INFO::fPixelRatio)
  *
- * Both are the width of a pixel over its height as it is shown: Kodi's is the aspect of the
- * display over that of its pixels (CResolutionInfo), more than 1 where they are shown wider than
- * tall; libass draws its glyphs that much narrower (1 square, 0 its own default). In a 3D output
- * the pixels of each eye are shown twice as wide (side by side: 2) or twice as tall (top and
- * bottom: 0.5), CGraphicContext::GetResInfo(). The ratio was turned around as 2 - ratio, which is
- * right for square pixels only: side by side it gave 0, libass's default, and the subtitles went
- * out twice as wide; top and bottom 1.5 for 2, subtitles stretched. A ratio that is not known (0
- * or less) is square.
+ * Kodi's pixel ratio is the width of a pixel of the frame over its height as it is shown (the
+ * aspect of the display over that of its pixels, CResolutionInfo): 2 for each eye of a 3D output
+ * side by side, whose half of the width the display stretches back, 0.5 top and bottom
+ * (CGraphicContext::GetResInfo()). libass's pixel aspect ratio is the other way round: that of the
+ * picture that a script was made for over the frame it renders into ((d_w / d_h) / (s_w / s_h),
+ * ass.h), and it draws the glyphs and lays out the lines that much wider (libass 0.17.5,
+ * ass_render.c: the outline transform multiplies x by par_scale_x, and a line wraps at the frame
+ * width over par_scale_x). So libass is given 1 / ratio: each eye gets its subtitles drawn half as
+ * wide side by side (twice as wide top and bottom), with the lines of the 2D picture, and the
+ * display shows them in their shape.
+ *
+ * Kodi gave libass 2 - ratio, which is 1 / ratio near 1 only: side by side 0, libass's default,
+ * which is square here (no storage size): glyphs twice as wide and half the words on a line. 1.2.2
+ * gave the ratio itself: four times as wide, a quarter of the words. A ratio that is not known (0 or
+ * less) is square.
  */
 constexpr double LibassPixelAspect(float pixelRatio)
 {
-  return pixelRatio > 0.0f ? static_cast<double>(pixelRatio) : 1.0;
+  return pixelRatio > 0.0f ? 1.0 / static_cast<double>(pixelRatio) : 1.0;
 }
 
 } // namespace STYLE
