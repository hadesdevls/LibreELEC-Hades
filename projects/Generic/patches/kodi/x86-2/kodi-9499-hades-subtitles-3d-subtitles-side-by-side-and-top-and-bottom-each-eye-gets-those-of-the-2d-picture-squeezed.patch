@@ -11,6 +11,7 @@
 
 #include "ActiveAreaZoom.h"
 #include "OverlayRendererUtil.h"
+#include "OverlayShape.h"
 #include "ServiceBroker.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
@@ -358,11 +359,15 @@ void CRenderer::GetRenderState(COverlay* o, SRenderState& state) const
       // Align to screen by keeping aspect ratio to fit into the screen area
       float source_width = o->m_source_width > 0 ? o->m_source_width : m_rs.Width();
       float source_height = o->m_source_height > 0 ? o->m_source_height : m_rs.Height();
-      float ratio = std::min<float>(m_rv.Width() / source_width, m_rv.Height() / source_height);
+      // Hades: ... as the screen is shown: the pixels of each eye of a 3D output are shown twice as
+      // wide side by side, twice as tall top and bottom (OverlayShape.h)
+      const ScreenArScale fit = FitShownScale(
+          m_rv.Width(), m_rv.Height(), source_width, source_height,
+          CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo().fPixelRatio);
       scale_x = m_rv.Width();
       scale_y = m_rv.Height();
-      scale_w = ratio;
-      scale_h = ratio;
+      scale_w = fit.width;
+      scale_h = fit.height;
     }
     else if (align == COverlay::ALIGN_VIDEO)
     {
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayShape.h b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayShape.h
new file mode 100644
index 0000000..cb96344
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayShape.h
@@ -0,0 +1,44 @@
+/*
+ *  Copyright (C) 2026-present Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+// Hades: a bitmap subtitle (PGS, DVB, VobSub) that is kept to its own shape on the screen (aligned to
+// the screen with its aspect ratio: COverlay::ALIGN_SCREEN_AR, a subtitle canvas of another shape than
+// the video), as it is shown. The pixels of the view are shown as wide as the pixel ratio of the
+// resolution says (RESOLUTION_INFO::fPixelRatio: the width of a pixel over its height as it is shown),
+// which is 2 for each eye of a 3D output side by side (each eye is drawn into half the width and the
+// display stretches it back) and 0.5 top and bottom. The canvas is fitted into the view as it is shown,
+// and drawn that much narrower or wider: in 2D on square pixels nothing changes. Fitted in the pixels of
+// the view, a canvas of 1920x1080 in an eye of 960x1080 side by side was drawn at half its size both
+// ways and shown at its width but half its height.
+
+#include <algorithm>
+
+namespace OVERLAY
+{
+//! The scale of the width and of the height of a canvas of sourceWidth x sourceHeight fitted into a view
+//! of viewWidth x viewHeight pixels whose pixels are shown pixelRatio times as wide as they are tall (a
+//! ratio that is not known, 0 or less, is square)
+struct ScreenArScale
+{
+  float width{1.0f};
+  float height{1.0f};
+};
+
+inline ScreenArScale FitShownScale(
+    float viewWidth, float viewHeight, float sourceWidth, float sourceHeight, float pixelRatio)
+{
+  const float ratio = pixelRatio > 0.0f ? pixelRatio : 1.0f;
+  if (!(sourceWidth > 0.0f) || !(sourceHeight > 0.0f))
+    return {};
+  // (fitted into the view as it is shown: its width in square pixels is viewWidth * ratio)
+  const float fit = std::min(viewWidth * ratio / sourceWidth, viewHeight / sourceHeight);
+  return {fit / ratio, fit};
+}
+} // namespace OVERLAY
