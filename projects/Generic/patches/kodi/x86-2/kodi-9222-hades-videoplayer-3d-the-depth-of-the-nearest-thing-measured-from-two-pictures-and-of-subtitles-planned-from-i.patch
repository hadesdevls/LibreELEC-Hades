+#include "StereoDepth.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <limits>
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+namespace
+{
+int ToPixel(float share, int size)
+{
+  const int pixel = static_cast<int>(std::lround(share * static_cast<float>(size)));
+  return std::clamp(pixel, 0, size);
+}
+} // namespace
+
+Measure MeasureNearest(const Plane& left,
+                       const Plane& right,
+                       const Area& area,
+                       const MatchParams& p)
+{
+  Measure result;
+  const int width = left.width;
+  const int height = left.height;
+  const int b = p.block;
+  if (!left.data || !right.data || right.width != width || right.height != height || b < 2 ||
+      p.step < 1 || width < b || height < b)
+    return result;
+
+  const int x0 = ToPixel(std::min(area.x1, area.x2), width);
+  const int x1 = ToPixel(std::max(area.x1, area.x2), width);
+  const int y0 = ToPixel(std::min(area.y1, area.y2), height);
+  const int y1 = ToPixel(std::max(area.y1, area.y2), height);
+  if (x1 - x0 < b || y1 - y0 < b)
+    return result;
+
+  // the sums of the rows of the right picture, to have the sum of any of its blocks in b additions
+  const int rows = y1 - y0;
+  std::vector<int> prefix(static_cast<size_t>(rows) * (width + 1));
+  for (int y = 0; y < rows; ++y)
+  {
+    const uint8_t* row = right.data + static_cast<size_t>(y0 + y) * right.stride;
+    int* sums = prefix.data() + static_cast<size_t>(y) * (width + 1);
+    sums[0] = 0;
+    for (int x = 0; x < width; ++x)
+      sums[x + 1] = sums[x] + row[x];
+  }
+
+  const int area2 = b * b;
+  // each difference below is scaled by the number of pixels of a block, so that the means
+  // taken off stay whole numbers
+  const int64_t residualMax = static_cast<int64_t>(p.residual) * area2 * area2;
+  const int textureMin = p.texture * b * (b - 1);
+
+  std::vector<int64_t> costs(static_cast<size_t>(p.nearest + p.farthest + 1));
+  std::vector<int> scaledLeft(static_cast<size_t>(area2));
+  std::vector<float> found;
+
+  for (int by = y0; by + b <= y1; by += p.step)
+  {
+    for (int bx = x0; bx + b <= x1; bx += p.step)
+    {
+      int texture = 0;
+      int sumLeft = 0;
+      for (int y = 0; y < b; ++y)
+      {
+        const uint8_t* row = left.data + static_cast<size_t>(by + y) * left.stride + bx;
+        for (int x = 0; x < b; ++x)
+        {
+          sumLeft += row[x];
+          if (x > 0)
+            texture += std::abs(row[x] - row[x - 1]);
+        }
+      }
+      if (texture < textureMin)
+        continue;
+      ++result.blocks;
+
+      for (int y = 0; y < b; ++y)
+      {
+        const uint8_t* row = left.data + static_cast<size_t>(by + y) * left.stride + bx;
+        for (int x = 0; x < b; ++x)
+          scaledLeft[static_cast<size_t>(y * b + x)] = row[x] * area2 - sumLeft;
+      }
+
+      // the right picture's block must stay in the picture
+      const int dMin = std::max(-p.nearest, -bx);
+      const int dMax = std::min(p.farthest, width - b - bx);
+      if (dMax - dMin < 2)
+        continue;
+
+      int bestD = dMin;
+      int64_t best = std::numeric_limits<int64_t>::max();
+      for (int d = dMin; d <= dMax; ++d)
+      {
+        int sumRight = 0;
+        for (int y = 0; y < b; ++y)
+        {
+          const int* sums = prefix.data() + static_cast<size_t>(by - y0 + y) * (width + 1);
+          sumRight += sums[bx + d + b] - sums[bx + d];
+        }
+        int64_t cost = 0;
+        for (int y = 0; y < b; ++y)
+        {
+          const uint8_t* row = right.data + static_cast<size_t>(by + y) * right.stride + bx + d;
+          const int* l = scaledLeft.data() + static_cast<size_t>(y * b);
+          for (int x = 0; x < b; ++x)
+            cost += std::abs(l[x] - (row[x] * area2 - sumRight));
+        }
+        costs[static_cast<size_t>(d + p.nearest)] = cost;
+        if (cost < best)
+        {
+          best = cost;
+          bestD = d;
+        }
+      }
+
+      int64_t second = std::numeric_limits<int64_t>::max();
+      for (int d = dMin; d <= dMax; ++d)
+        if (std::abs(d - bestD) >= 2)
+          second = std::min(second, costs[static_cast<size_t>(d + p.nearest)]);
+
+      // (strictly better: a texture that repeats matches as well, with no difference, a period
+      // further, and is no measure)
+      if (best > residualMax || second == std::numeric_limits<int64_t>::max() ||
+          !(static_cast<double>(best) < p.uniqueness * static_cast<double>(second)))
+        continue;
+
+      // a best match at the edge of the picture may be the edge of what could be looked at, not
+      // of the thing: left out. At the edge of the search it is a thing at least that near (or
+      // that far), which is kept as such.
+      if ((bestD == dMin && dMin != -p.nearest) || (bestD == dMax && dMax != p.farthest))
+        continue;
+
+      float d = static_cast<float>(bestD);
+      if (bestD > dMin && bestD < dMax)
+      {
+        const double before =
+            static_cast<double>(costs[static_cast<size_t>(bestD - 1 + p.nearest)]);
+        const double at = static_cast<double>(best);
+        const double after = static_cast<double>(costs[static_cast<size_t>(bestD + 1 + p.nearest)]);
+        const double curve = before - 2.0 * at + after;
+        if (curve > 0.0)
+          d += static_cast<float>(std::clamp((before - after) / (2.0 * curve), -0.5, 0.5));
+      }
+      found.push_back(d);
+    }
+  }
+
+  result.matched = static_cast<int>(found.size());
+  if (result.matched < p.support || result.matched == 0)
+    return result;
+
+  // nearest first: the most crossed disparity is the most negative
+  const int k =
+      std::min(result.matched,
+               std::max(p.support,
+                        static_cast<int>(std::ceil(p.share * static_cast<float>(result.matched)))));
+  std::nth_element(found.begin(), found.begin() + (k - 1), found.end());
+  result.nearest = -found[static_cast<size_t>(k - 1)] / static_cast<float>(width);
+  return result;
+}
+
+Signature SignatureOf(const Plane& picture)
+{
+  Signature s;
+  if (!picture.data || picture.width < 16 || picture.height < 9)
+    return s;
+  for (int cy = 0; cy < 9; ++cy)
+  {
+    const int ya = cy * picture.height / 9;
+    const int yb = (cy + 1) * picture.height / 9;
+    for (int cx = 0; cx < 16; ++cx)
+    {
+      const int xa = cx * picture.width / 16;
+      const int xb = (cx + 1) * picture.width / 16;
+      int64_t sum = 0;
+      for (int y = ya; y < yb; ++y)
+      {
+        const uint8_t* row = picture.data + static_cast<size_t>(y) * picture.stride;
+        for (int x = xa; x < xb; ++x)
+          sum += row[x];
+      }
+      const int64_t count = static_cast<int64_t>(yb - ya) * (xb - xa);
+      s.cells[cy * 16 + cx] = static_cast<uint8_t>(count ? sum / count : 0);
+    }
+  }
+  s.valid = true;
+  return s;
+}
+
+bool IsCut(const Signature& before, const Signature& now)
+{
+  if (!before.valid || !now.valid)
+    return false;
+  int sum = 0;
+  for (int i = 0; i < 16 * 9; ++i)
+    sum += std::abs(before.cells[i] - now.cells[i]);
+  return sum > 20 * 16 * 9;
+}
+
+void CPlanner::Reset()
+{
+  const PlannerParams params = m_params;
+  *this = CPlanner(params);
+}
+
+void CPlanner::AddMeasure(double t, std::optional<float> area, std::optional<float> whole, bool cut)
+{
+  m_entries.push_back({++m_seq, t, area, whole});
+  m_measured = true;
+
+  if (cut)
+  {
+    m_cutAt = t;
+    m_sinceCut = 1;
+  }
+  else if (m_cutAt)
+    ++m_sinceCut;
+
+  // the shot before a cut is forgotten once the new one was measured often enough
+  if (m_cutAt && m_sinceCut >= m_params.afterCut)
+  {
+    while (!m_entries.empty() && m_entries.front().t < *m_cutAt)
+      m_entries.pop_front();
+    m_cutAt.reset();
+  }
+
+  // what is older than the time remembered is not needed, but for the measures that confirm
+  while (m_entries.size() > static_cast<size_t>(std::max(m_params.confirm, 1)) &&
+         m_entries.front().t < t - m_params.hold - 1.0)
+    m_entries.pop_front();
+}
+
+std::optional<float> CPlanner::Recent(double t, bool whole) const
+{
+  const size_t confirm = static_cast<size_t>(std::max(m_params.confirm, 1));
+  std::optional<float> nearest;
+  for (size_t i = 0; i < m_entries.size(); ++i)
+  {
+    const Entry& e = m_entries[i];
+    if (e.t < t - m_params.hold || e.t > t)
+      continue;
+    if (i + 1 < confirm)
+      continue;
+    // the measure and those just before it, all of them: the least near of them
+    std::optional<float> agreed;
+    bool all = true;
+    for (size_t j = i + 1 - confirm; j <= i; ++j)
+    {
+      const std::optional<float>& v = whole ? m_entries[j].whole : m_entries[j].area;
+      if (!v)
+      {
+        all = false;
+        break;
+      }
+      agreed = agreed ? std::min(*agreed, *v) : *v;
+    }
+    if (all && agreed && (!nearest || *agreed > *nearest))
+      nearest = agreed;
+  }
+  return nearest;
+}
+
+std::optional<float> CPlanner::Latest() const
+{
+  const size_t confirm = static_cast<size_t>(std::max(m_params.confirm, 1));
+  if (m_entries.size() < confirm)
+    return std::nullopt;
+  std::optional<float> agreed;
+  for (size_t j = m_entries.size() - confirm; j < m_entries.size(); ++j)
+  {
+    if (!m_entries[j].area)
+      return std::nullopt;
+    agreed = agreed ? std::min(*agreed, *m_entries[j].area) : *m_entries[j].area;
+  }
+  return agreed;
+}
+
+float CPlanner::Clamp(float depth) const
+{
+  return std::min(std::max(depth, m_params.floor), m_params.comfort);
+}
+
+float CPlanner::Subtitles(double t, bool visible, uint64_t event)
+{
+  if (!visible)
+  {
+    if (m_inEvent)
+    {
+      m_inEvent = false;
+      m_endedAt = t;
+    }
+    return m_hasValue ? m_value : m_params.floor;
+  }
+
+  if (!m_inEvent || event != m_event)
+  {
+    // a new subtitle: it appears where it is to stay, so this is not a jump of it
+    const bool follows = m_inEvent || (m_endedAt && t - *m_endedAt <= m_params.bridge);
+    const std::optional<float> nearest = Recent(t, false);
+    float depth = Clamp(nearest ? *nearest + m_params.margin : m_params.floor);
+    if (follows && m_hasValue && std::abs(depth - m_value) <= m_params.hysteresis)
+      depth = m_value;
+    m_value = depth;
+    m_target = depth;
+    m_hasValue = true;
+    m_inEvent = true;
+    m_event = event;
+    m_lastT = t;
+    m_seenSeq = m_seq;
+    return m_value;
+  }
+
+  // the same subtitle: forward only, where measures in a row put something nearer, and smoothly
+  if (m_seq != m_seenSeq)
+  {
+    m_seenSeq = m_seq;
+    if (const std::optional<float> nearest = Latest(); nearest)
+      m_target = std::max(m_target, Clamp(*nearest + m_params.margin));
+  }
+  const double elapsed = std::max(0.0, t - m_lastT);
+  m_lastT = t;
+  if (m_value < m_target)
+    m_value = std::min(m_target, m_value + static_cast<float>(m_params.speed * elapsed));
+  return m_value;
+}
+
+float CPlanner::Gui(double t, bool shown, std::optional<float> subtitles)
+{
+  // closed: the depth it would open at now, which is the one of the frame it appears in (whether
+  // it is shown is known a frame late); open: kept, never behind the subtitles it is drawn over,
+  // and once forward, kept there
+  if (!shown)
+  {
+    const std::optional<float> nearest = Recent(t, true);
+    m_gui = Clamp(nearest ? *nearest + m_params.margin : m_params.floor);
+  }
+  if (subtitles)
+    m_gui = std::max(m_gui, Clamp(*subtitles));
+  return m_gui;
+}
+
+} // namespace STEREODEPTH
+} // namespace KODI
