+#pragma once
+
+//! Hades: the depth of subtitles and of the interface over a 3D video that carries no depth of its
+//! own (MV-HEVC, side by side, top and bottom, an MVC stream without plane offsets), measured from
+//! the two pictures.
+//!
+//! What is measured is the disparity of the nearest thing in a part of the picture: where a point
+//! of the left eye's picture is found in the right eye's. A thing in front of the screen is seen
+//! further left by the right eye (crossed disparity). Every depth here is a crossed disparity as a
+//! share of the width of the picture: 0 is the plane of the screen, more is nearer the viewer, less
+//! is behind the screen. A subtitle shifted right by s pixels for the left eye and left by s for
+//! the right (CRenderer::SubtitleDepth()) has a depth of 2 * s / width.
+//!
+//! Nothing here knows of Kodi: the pictures come in as rows of 8-bit luma (a small copy of each
+//! eye, made by the graphics: CStereoDepthCapture), and the times in seconds.
+
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <vector>
+
+namespace KODI
+{
+namespace STEREODEPTH
+{
+
+//! 8-bit luma, its first row the top one
+struct Plane
+{
+  const uint8_t* data{nullptr};
+  int width{0};
+  int height{0};
+  int stride{0};
+};
+
+//! A part of a picture, as shares of its width and height
+struct Area
+{
+  float x1{0.0f};
+  float y1{0.0f};
+  float x2{1.0f};
+  float y2{1.0f};
+};
+
+//! How the two pictures are matched. Distances are in pixels of the pictures given.
+struct MatchParams
+{
+  int block{8}; //!< side of the square blocks matched
+  int step{8}; //!< distance between two blocks, across and down
+  int nearest{32}; //!< the most crossed disparity looked for (in front of the screen)
+  int farthest{16}; //!< the most uncrossed disparity looked for (behind it)
+  int texture{3}; //!< the mean step between neighbouring pixels a block needs, in levels
+  double uniqueness{0.85}; //!< best cost over the best one 2 or more away, at most
+  int residual{14}; //!< the mean difference left by the best match, in levels, at most
+  float share{0.01f}; //!< the share of the matched blocks found at or nearer than the result
+  int support{4}; //!< ... and their least number: fewer than this, and nothing is found
+};
+
+struct Measure
+{
+  int blocks{0}; //!< blocks of the area with texture enough to be matched
+  int matched{0}; //!< of them, those matched without doubt
+  //! the depth of the nearest thing found (see above), or nothing where fewer than
+  //! MatchParams::support blocks were matched (a flat area, a black bar)
+  std::optional<float> nearest;
+};
+
+/*!
+ * \brief The nearest thing in an area of a stereo pair.
+ *
+ * Blocks of the left picture with texture are looked for along the same rows of the right one,
+ * by the sum of absolute differences of the blocks less their means (so a brighter eye does not
+ * move the match), to a fraction of a pixel (a parabola through the costs around the best). A
+ * block whose best match is not clearly better than any other is left out. The result is not the
+ * nearest block but the one with MatchParams::share of the matched blocks at or before it, and
+ * never fewer than MatchParams::support blocks: a block matched wrong, a bright pixel, noise do
+ * not move it, while a thing of a few blocks does.
+ */
+Measure MeasureNearest(const Plane& left,
+                       const Plane& right,
+                       const Area& area,
+                       const MatchParams& params = {});
+
+//! What is kept of a picture to tell a cut: the mean light of 16 x 9 cells
+struct Signature
+{
+  bool valid{false};
+  uint8_t cells[16 * 9]{};
+};
+
+Signature SignatureOf(const Plane& picture);
+
+//! Whether two pictures are of two shots: the mean difference of their cells is over 20 levels
+bool IsCut(const Signature& before, const Signature& now);
+
+//! How depths are chosen from the measures
+struct PlannerParams
+{
+  float margin{0.0025f}; //!< in front of the nearest thing by so much
+  float comfort{0.02f}; //!< never nearer than this: a subtitle can be read without strain
+  float floor{0.0f}; //!< never farther than this: the plane of the screen
+  double speed{0.04}; //!< the fastest change within one subtitle, per second
+  double hold{1.0}; //!< seconds a nearest thing measured is remembered
+  double bridge{0.5}; //!< a subtitle that follows another within so many seconds...
+  float hysteresis{0.0015f}; //!< ... keeps its depth where the new one is not further off than this
+  int confirm{2}; //!< measures in a row that must agree before a subtitle is brought forward
+  int afterCut{2}; //!< measures after a cut before what was measured before it is forgotten
+};
+
+/*!
+ * \brief The depth of the subtitles and of the interface, frame by frame.
+ *
+ * Measures come in as they are made (a few a second, a little after their pictures); the depth of
+ * each frame is asked for as it is drawn.
+ *
+ * Subtitles: a subtitle (an event: a line, a set of bitmaps) gets, as it appears, the depth that
+ * puts it in front of the nearest thing measured in its area in the last PlannerParams::hold
+ * seconds, by PlannerParams::margin, between floor and comfort. While it is shown it only ever
+ * comes forward, never back, and smoothly (PlannerParams::speed), and only where
+ * PlannerParams::confirm measures in a row put something nearer than itself: it never jumps. One
+ * that follows another closely keeps the depth of the other unless the new depth is more than
+ * PlannerParams::hysteresis away. A cut keeps what was measured before it until
+ * PlannerParams::afterCut measures of the new shot were made.
+ *
+ * Interface: as it opens over the video, it gets the depth in front of the nearest thing of the
+ * whole picture in the last PlannerParams::hold seconds (never behind the subtitles), and keeps it
+ * while it is open; it comes forward only to stay in front of the subtitles.
+ */
+class CPlanner
+{
+public:
