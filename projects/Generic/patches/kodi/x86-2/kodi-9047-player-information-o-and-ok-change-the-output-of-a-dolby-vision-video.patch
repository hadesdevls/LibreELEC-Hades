From 6ee9ecdb1c81d4bfb59eb54e79abcc5ebd80e49e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:15:55 +0000
Subject: [PATCH] player information: O and OK change the output of a Dolby
 Vision video

Changing the conversion of Dolby Vision while a video plays took the panel,
Down to its button (which did not work) and OK, or the video OSD. Other builds
of LibreELEC and CoreELEC have a short way to it, and users asked for one.

OK on the overview or the Dolby Vision tab now asks for the output of the video
that plays, as their button does (PlayerControl(HadesDVOutput), the same list
and the same code: nothing is duplicated). The panel opens on the overview tab,
so O and OK bring the list. It only does so where the button is shown, that is
where there is more than one output to choose (Player.Process(videodvoutputchoice)
is not empty); elsewhere OK on a tab does nothing, as before. The dialog of
system/hades for other skins is made again from Estuary's file.

As nothing shows on the screen where there is nothing to choose, each step now
says in kodi.log what it did: the list offered (how many outputs, which one is
in use), the list closed without a change, no other output to choose now, or no
list dialog in the skin. The choice itself was already logged ("the user chose
for this video: ...").
---
 .../xml/DialogPlayerProcessInfo.xml            |  4 ++++
 system/hades/DialogHadesPlayerInfo.xml         |  2 ++
 xbmc/video/dialogs/GUIDialogVideoSettings.cpp  | 18 ++++++++++++++++++
 3 files changed, 24 insertions(+)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 1e5f19f..8c1fc9e 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -2207,6 +2207,9 @@
 					<alttexturefocus border="21" colordiffuse="button_focus">buttons/button-fo.png</alttexturefocus>
 					<visible>Player.HasVideo</visible>
 					<onfocus>SetProperty(PlayerInfoDialogFocus,5556,Home)</onfocus>
+					<!-- Hades: OK on this tab, or on that of Dolby Vision, asks for the output of the video that
+					     plays, as their button does: O and OK change the conversion of Dolby Vision -->
+					<onclick condition="!String.IsEmpty(Player.Process(videodvoutputchoice))">PlayerControl(HadesDVOutput)</onclick>
 				</control>
 				<control type="button" id="5551">
 					<width>160</width>
@@ -2246,6 +2249,7 @@
 					<alttexturefocus border="21" colordiffuse="button_focus">buttons/button-fo.png</alttexturefocus>
 					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice)) | [String.IsEqual(VideoPlayer.HdrType,dolbyvision) + [!String.IsEmpty(Window(Home).Property(hades.dv.transport)) | String.IsEqual(Window(Home).Property(hades.dv.vsif),hdmi14b) | !String.IsEmpty(Window(Home).Property(hades.dv.display)) | String.IsEqual(Window(Home).Property(hades.dv.state),native) | String.IsEqual(Window(Home).Property(hades.dv.state),hdr10) | !String.IsEmpty(Window(Home).Property(hades.dv.passes))]]</visible>
 					<onfocus>SetProperty(PlayerInfoDialogFocus,5555,Home)</onfocus>
+					<onclick condition="!String.IsEmpty(Player.Process(videodvoutputchoice))">PlayerControl(HadesDVOutput)</onclick>
 				</control>
 				<control type="button" id="5558">
 					<width>160</width>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index efe2c6c..a551212 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -9525,6 +9525,7 @@
 					<alttexturefocus border="21" colordiffuse="FF12A0C7">special://xbmc/system/hades/buttons-button-fo.png</alttexturefocus>
 					<visible>Player.HasVideo</visible>
 					<onfocus>SetProperty(HadesPlayerInfoPage,5556,Home)</onfocus>
+					<onclick condition="!String.IsEmpty(Player.Process(videodvoutputchoice))">PlayerControl(HadesDVOutput)</onclick>
 					<texturefocus border="21" colordiffuse="FF12A0C7">special://xbmc/system/hades/buttons-button-fo.png</texturefocus>
 					<textcolor>FFF0F0F0</textcolor>
 					<disabledcolor>40FFFFFF</disabledcolor>
@@ -9563,6 +9564,7 @@
 					<alttexturefocus border="21" colordiffuse="FF12A0C7">special://xbmc/system/hades/buttons-button-fo.png</alttexturefocus>
 					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice)) | [String.IsEqual(VideoPlayer.HdrType,dolbyvision) + [!String.IsEmpty(Window(Home).Property(hades.dv.transport)) | String.IsEqual(Window(Home).Property(hades.dv.vsif),hdmi14b) | !String.IsEmpty(Window(Home).Property(hades.dv.display)) | String.IsEqual(Window(Home).Property(hades.dv.state),native) | String.IsEqual(Window(Home).Property(hades.dv.state),hdr10) | !String.IsEmpty(Window(Home).Property(hades.dv.passes))]]</visible>
 					<onfocus>SetProperty(HadesPlayerInfoPage,5555,Home)</onfocus>
+					<onclick condition="!String.IsEmpty(Player.Process(videodvoutputchoice))">PlayerControl(HadesDVOutput)</onclick>
 					<texturefocus border="21" colordiffuse="FF12A0C7">special://xbmc/system/hades/buttons-button-fo.png</texturefocus>
 					<textcolor>FFF0F0F0</textcolor>
 					<disabledcolor>40FFFFFF</disabledcolor>
diff --git a/xbmc/video/dialogs/GUIDialogVideoSettings.cpp b/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
index f209e7a..a3fbe49 100644
--- a/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
+++ b/xbmc/video/dialogs/GUIDialogVideoSettings.cpp
@@ -742,14 +742,26 @@ std::string CGUIDialogVideoSettings::DVOutputChoiceName()
 
 void CGUIDialogVideoSettings::SelectDVOutput()
 {
+  // (Hades: asked for by the button of the player information, OK on its overview or Dolby Vision
+  // tab, the video OSD or a key of a keymap: each step says in the log what it did, as nothing
+  // shows on the screen where there is nothing to choose)
   const auto list = DVOutputChoices();
   if (list.size() < 2)
+  {
+    CLog::Log(LOGINFO, "DVBridge: change of output for this video asked for: there is no other "
+                       "output to choose for it now ({} in the list)",
+              list.size());
     return;
+  }
   auto* gui = CServiceBroker::GetGUI();
   auto* dialog = gui ? gui->GetWindowManager().GetWindow<CGUIDialogSelect>(WINDOW_DIALOG_SELECT)
                      : nullptr;
   if (!dialog)
+  {
+    CLog::Log(LOGERROR, "DVBridge: change of output for this video asked for: the list dialog of "
+                        "the skin is not there");
     return;
+  }
   const int current = static_cast<int>(DVBRIDGE::ListedOutputChoice());
   dialog->Reset();
   dialog->SetHeading(CVariant{DVOutputHeading()});
@@ -762,12 +774,18 @@ void CGUIDialogVideoSettings::SelectDVOutput()
   }
   if (selected >= 0)
     dialog->SetSelected(selected);
+  CLog::Log(LOGINFO, "DVBridge: change of output for this video: a list of {} outputs, now {}",
+            list.size(), selected >= 0 ? list[selected].label : std::string("none of them"));
   dialog->Open();
   // Only what the user chose: a list closed another way (back, or by something else) changes
   // nothing, and neither does the output that was chosen already
   const int chosen = dialog->IsConfirmed() ? dialog->GetSelectedItem() : -1;
   if (chosen < 0 || chosen >= static_cast<int>(list.size()) || list[chosen].value == current)
+  {
+    CLog::Log(LOGINFO, "DVBridge: change of output for this video: the list was closed without a "
+                       "change");
     return;
+  }
   ApplyDVOutput(list[chosen].value);
 }
 
