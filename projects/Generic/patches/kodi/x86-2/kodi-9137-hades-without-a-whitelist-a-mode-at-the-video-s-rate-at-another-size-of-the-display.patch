+#pragma once
+
+#include "windowing/WholeMultiple.h"
+
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+namespace KODI::WINDOWING::EXACT_RATE
+{
+
+/*!
+ * \brief Hades: a mode at the frame rate of a video at another size than the video's or the menus',
+ *        where Kodi's default whitelist finds none (CResolutionUtils::FindResolutionFromWhitelist())
+ *
+ * Without a whitelist of the user, Kodi looks at the modes of the display that are at least the
+ * size of the mode it is in, and takes one at the frame rate of the video (or twice it, or 2.5
+ * times it) only at the size of the video or at the width of the menus. A TV whose menus are in a
+ * resolution that it has no mode of 23.976 Hz in (the LG C5 with the menus at 2560x1440, which a
+ * monitor left there: it has 23.976 Hz at 3840x2160 and at 1920x1080) then played a film of
+ * 1920x1080 at the 119.998 Hz of the menus, one picture held a refresh longer every 0.2 s. Kodi now
+ * looks further, after its own tiers of the exact rate and twice it, before 3:2 pulldown at the width
+ * of the menus: a mode at the frame rate, then at twice it, at any size of the display that is not
+ * smaller than the video, in this order:
+ *  - the size of the display's own preferred mode (Kodi's desktop resolution, the native one);
+ *  - the nearest size at or above that of the menus (the smallest of them);
+ *  - the largest size under that of the menus.
+ * Only without a whitelist of the user (with one, Kodi's choice is the user's, as it was), for an
+ * SDR video in 2D: Dolby Vision (native output keeps its transport and its cadence,
+ * FindDVTransportResolution()), HDR10, HDR10+ and HLG keep Kodi's choice as it was, and so does a
+ * video whose kind is not known. A video not known to be progressive takes no mode of 30 Hz or less
+ * but 24 Hz, as Kodi's default whitelist does not (it may show to be interlaced, and change again).
+ *
+ * Nothing of Kodi is here: a test runs it on the host (exact_rate_test.cpp).
+ */
+
+//! A mode of the display, as Kodi lists them
+struct Mode
+{
+  int width = 0;
+  int height = 0;
+  double refresh = 0.0;
+  //! progressive and 2D, as the mode of the menus is (Kodi's D3DPRESENTFLAG_MODEMASK of both)
+  bool sameKind = false;
+};
+
+//! What the choice is told
+struct Query
+{
+  bool userWhitelist = false; //!< videoscreen.whitelist is not empty
+  bool nativeDV = false;
+  bool is3D = false;
+  WholeMultipleVideo video = WholeMultipleVideo::UNKNOWN;
+  bool progressive = false; //!< CDVDStreamInfo::progressive
+  double fps = 0.0;
+  int videoWidth = 0;
+  int videoHeight = 0;
+  int menusWidth = 0;
+  int menusHeight = 0;
+  int preferredWidth = 0; //!< the display's preferred mode (RES_DESKTOP)
+  int preferredHeight = 0;
+};
+
+//! How a mode was found, for the log
+enum class Why
+{
+  NONE,
+  PREFERRED, //!< the size of the display's preferred mode
+  ABOVE_MENUS, //!< the nearest size at or above the menus'
+  UNDER_MENUS, //!< the largest size under the menus'
+};
+
+struct Choice
+{
+  int index = -1; //!< into the modes; -1: none
+  int multiple = 0; //!< 1: the frame rate, 2: twice it
+  Why why = Why::NONE;
+  //! why nothing is looked for (nullptr where it is): for the log
+  const char* notLooked = nullptr;
+};
+
+//! Kodi's tolerance for the refresh rate of a mode (MathUtils::FloatEquals(..., 0.01f))
+constexpr double TOLERANCE = 0.01;
+
+//! A mode is not smaller than the video, with the margins of Kodi's MatchesMode() (Resolution.cpp)
+constexpr bool NotSmaller(const Mode& m, int width, int height)
+{
+  return width <= m.width + 8 && height <= m.height + 32;
+}
+
+//! Kodi's default whitelist leaves out the modes of 30 Hz or less but 24 Hz for a video not known
+//! to be progressive (FindResolutionFromWhitelist())
+inline bool RateTaken(double refresh, bool progressive)
+{
+  return progressive || refresh > 30.0 || std::fabs(refresh - 24.0) < 0.1;
+}
+
+inline Choice Find(const Query& q, const std::vector<Mode>& modes)
+{
+  Choice c;
+  if (q.userWhitelist)
+    c.notLooked = "a whitelist of the user decides";
+  else if (q.nativeDV)
+    c.notLooked = "native Dolby Vision keeps its own way";
+  else if (q.is3D)
+    c.notLooked = "the video is 3D";
+  else if (q.video != WholeMultipleVideo::SDR)
+    c.notLooked = "only SDR video looks further (HDR, Dolby Vision and a video whose kind is not "
+                  "known keep Kodi's choice)";
+  else if (!(q.fps > 0.0) || !std::isfinite(q.fps))
+    c.notLooked = "the video has no frame rate";
+  if (c.notLooked)
+    return c;
+
+  for (const int k : {1, 2})
+  {
+    const double rate = k * q.fps;
+    int preferred = -1;
+    int above = -1;
+    int under = -1;
+    for (size_t i = 0; i < modes.size(); ++i)
+    {
+      const Mode& m = modes[i];
+      if (!m.sameKind || std::fabs(m.refresh - rate) > TOLERANCE ||
+          !NotSmaller(m, q.videoWidth, q.videoHeight) || !RateTaken(m.refresh, q.progressive))
+        continue;
+      const int index = static_cast<int>(i);
+      if (m.width == q.preferredWidth && m.height == q.preferredHeight && preferred < 0)
+        preferred = index;
+      const long long area = static_cast<long long>(m.width) * m.height;
+      if (m.width >= q.menusWidth && m.height >= q.menusHeight)
+      {
+        if (above < 0 || area < static_cast<long long>(modes[above].width) * modes[above].height)
+          above = index;
+      }
+      else if (under < 0 || area > static_cast<long long>(modes[under].width) * modes[under].height)
+        under = index;
+    }
+    if (preferred >= 0)
+      return {preferred, k, Why::PREFERRED, nullptr};
+    if (above >= 0)
+      return {above, k, Why::ABOVE_MENUS, nullptr};
+    if (under >= 0)
+      return {under, k, Why::UNDER_MENUS, nullptr};
+  }
+  return c;
+}
+
+//! For the log
+constexpr const char* WhyName(Why why)
+{
+  switch (why)
+  {
+    case Why::PREFERRED:
+      return "the size of the display's preferred mode";
+    case Why::ABOVE_MENUS:
+      return "the nearest size at or above that of the menus";
+    case Why::UNDER_MENUS:
+      return "the largest size under that of the menus, not under the video's";
+    case Why::NONE:
+      break;
+  }
+  return "none";
+}
+
+} // namespace KODI::WINDOWING::EXACT_RATE
