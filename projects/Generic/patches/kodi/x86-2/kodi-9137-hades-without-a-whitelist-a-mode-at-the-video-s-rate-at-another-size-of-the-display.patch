           SETTING_VIDEOSCREEN_WHITELIST_PULLDOWN))
   {
@@ -564,6 +571,71 @@ bool CResolutionUtils::KeepWholeMultiple(float fps,
   return v.keep;
 }
 
+bool CResolutionUtils::FindExactRateElsewhere(float fps,
+                                              int width,
+                                              int height,
+                                              bool is3D,
+                                              bool progressive,
+                                              bool nativeDV,
+                                              KODI::WINDOWING::WholeMultipleVideo video,
+                                              bool noWhiteList,
+                                              RESOLUTION& resolution)
+{
+  namespace EXACT = KODI::WINDOWING::EXACT_RATE;
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const RESOLUTION_INFO menus =
+      gfx.GetResInfo(CDisplaySettings::GetInstance().GetCurrentResolution());
+  const RESOLUTION_INFO preferred = gfx.GetResInfo(RES_DESKTOP);
+  EXACT::Query q;
+  q.userWhitelist = !noWhiteList;
+  q.nativeDV = nativeDV;
+  q.is3D = is3D;
+  q.video = video;
+  q.progressive = progressive;
+  q.fps = fps;
+  q.videoWidth = width;
+  q.videoHeight = height;
+  q.menusWidth = menus.iScreenWidth;
+  q.menusHeight = menus.iScreenHeight;
+  q.preferredWidth = preferred.iScreenWidth;
+  q.preferredHeight = preferred.iScreenHeight;
+
+  std::vector<RESOLUTION> candidates;
+  gfx.GetAllowedResolutions(candidates);
+  std::vector<EXACT::Mode> modes;
+  modes.reserve(candidates.size());
+  for (const RESOLUTION r : candidates)
+  {
+    const RESOLUTION_INFO info = gfx.GetResInfo(r);
+    modes.push_back(
+        {info.iScreenWidth, info.iScreenHeight, info.fRefreshRate,
+         (info.dwFlags & D3DPRESENTFLAG_MODEMASK) == (menus.dwFlags & D3DPRESENTFLAG_MODEMASK)});
+  }
+  const EXACT::Choice c = EXACT::Find(q, modes);
+  if (c.notLooked)
+  {
+    CLog::Log(LOGDEBUG, "[WHITELIST] Hades: no mode at another size is looked for: {}",
+              c.notLooked);
+    return false;
+  }
+  if (c.index < 0)
+  {
+    CLog::Log(LOGINFO,
+              "[WHITELIST] Hades: the display has no mode at {:.3f} Hz or twice it at any size "
+              "not smaller than the video ({}x{}): Kodi's choice goes on as it was",
+              fps, width, height);
+    return false;
+  }
+  const RESOLUTION chosen = candidates[static_cast<size_t>(c.index)];
+  CLog::Log(LOGINFO,
+            "[WHITELIST] Hades: no mode at {:.3f} fps {}at the size of the video ({}x{}) or the "
+            "width of the menus ({}); {} has it, at {}: chosen",
+            fps, c.multiple == 2 ? "or twice it " : "", width, height, menus.strMode,
+            gfx.GetResInfo(chosen).strMode, EXACT::WhyName(c.why));
+  resolution = chosen;
+  return true;
+}
+
 bool CResolutionUtils::FindResolutionFromOverride(float fps, int width, bool is3D, RESOLUTION &resolution, float& weight, bool fallback)
 {
   RESOLUTION_INFO curr = CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(resolution);
