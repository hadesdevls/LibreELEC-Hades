From 68b90dedf62bbdc0f308bc0c3297c1fd63fa4e20 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 05:01:42 +0000
Subject: [PATCH] [Hades][Network] Projector control: its thread sleeps while
 the control is off

The thread of the projector control woke four times a second whatever
the setting, also while the control is off, which it is by default:
four wake-ups a second for nothing on every system.

While the control is off the thread now waits until a setting of the
control changes or the test of the connection is asked, which wake it
already (OnSettingChanged(), OnSettingAction()); while it is on it waits
250 ms as before, since it follows the shape of the picture and the
signal (ControlWaitMs() in ProjectorPolicy.h).
---
 xbmc/network/ProjectorControl.cpp |  7 ++++++-
 xbmc/network/ProjectorPolicy.h    | 11 +++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/xbmc/network/ProjectorControl.cpp b/xbmc/network/ProjectorControl.cpp
index a6f4bff..e385fe4 100644
--- a/xbmc/network/ProjectorControl.cpp
+++ b/xbmc/network/ProjectorControl.cpp
@@ -201,7 +201,12 @@ void CProjectorControl::Process()
 {
   while (!m_bStop)
   {
-    m_wake.Wait(250ms);
+    // Hades: while the control is off, nothing until a setting of the control or the test wakes it
+    // (OnSettingChanged(), OnSettingAction()); while it is on, as often as the picture is followed
+    if (const int ms = ControlWaitMs(!m_configRead || m_config.brand != Brand::NONE); ms < 0)
+      m_wake.Wait();
+    else
+      m_wake.Wait(std::chrono::milliseconds(ms));
     if (m_bStop)
       break;
     Tick();
diff --git a/xbmc/network/ProjectorPolicy.h b/xbmc/network/ProjectorPolicy.h
index b60092b..61da2d6 100644
--- a/xbmc/network/ProjectorPolicy.h
+++ b/xbmc/network/ProjectorPolicy.h
@@ -282,6 +282,17 @@ private:
   double m_since = 0.0;
 };
 
+/*!
+ * \brief Hades: how long the thread of the control waits for something to do, in ms: while the control is on, POLL_MS
+ *        (the shape of the picture and the signal are followed); while it is off, until a setting of the control or
+ *        the test of the connection wakes it (-1), so that a control that is off (the default) costs no wake-ups
+ */
+constexpr int POLL_MS = 250;
+inline int ControlWaitMs(bool on)
+{
+  return on ? POLL_MS : -1;
+}
+
 /*!
  * \brief How long to wait before the next try where the projector did not answer, or was off: 5 s,
  *        then twice as long each time, up to 5 minutes
-- 
