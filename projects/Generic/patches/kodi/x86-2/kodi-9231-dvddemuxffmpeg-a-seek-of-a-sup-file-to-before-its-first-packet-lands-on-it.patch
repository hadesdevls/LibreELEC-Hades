From 43251789bfc5dbb2f77b460c0df6233172761739 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:00:35 +0000
Subject: [PATCH] DVDDemuxFFmpeg: a seek of a .sup file to before its first
 packet lands on it

The target of a seek in a .sup file gets no start time (SeekTime() adds
it to every other format), so a seek back to the start or to an early
chapter can lie before the first packet of the file. A backward seek
there fails: the file kept its place, and the subtitles between the
target and that place were not shown until playback got back to it.

A backward seek of a .sup file that fails with its target before the
start time of the file is now made again forward, which lands on the
first packet. Nothing else changes: another format, a forward seek, or a
target after the start time fails as before.

From matthane's change for CoreELEC (CoreELEC/xbmc commit b8dbf95318,
"DVDDemuxFFmpeg: fix .sup seeks to before the first packet"); here only
for a backward seek and a known start time.
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index f90da6e..a190e86 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -3251,6 +3251,14 @@ bool CDVDDemuxFFmpeg::SeekTime(double time, bool backwards, double* startpts)
     else
       ret = av_seek_frame(m_pFormatContext, m_seekStream, seek_pts,
                           backwards ? AVSEEK_FLAG_BACKWARD : 0);
+
+    // a .sup target gets no start time (above), so a seek back to the start or to an early
+    // chapter can lie before the first packet, where a backward seek fails: the file kept its
+    // place and the subtitles in between were not shown. The first packet after it is the place.
+    if (ret < 0 && backwards && m_bSup &&
+        m_pFormatContext->start_time != static_cast<int64_t>(AV_NOPTS_VALUE) &&
+        seek_pts < m_pFormatContext->start_time)
+      ret = av_seek_frame(m_pFormatContext, m_seekStream, seek_pts, 0);
 #ifdef HAVE_DVBRIDGE
     // what was read above, while the transport stream was not ready, is from before the seek
     m_dvMerge.Clear();
-- 
