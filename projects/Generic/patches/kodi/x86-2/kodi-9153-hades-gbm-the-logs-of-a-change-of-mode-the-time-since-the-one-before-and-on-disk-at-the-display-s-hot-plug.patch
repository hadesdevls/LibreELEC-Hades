From 9f196481f2be10eed0f6bd3921fe904bcd1379ef Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 15:47:32 +0000
Subject: [PATCH] [Hades][GBM] The logs of a change of mode: the time since the
 one before, and on disk at the display's hot-plug

An LG C5 stayed black twice after a change of mode
while Kodi and NVIDIA's driver went on: no flip stalled, so nothing wrote the
logs to the disk (FlipStalled() does), and the end of one kodi.log was lost
with the power. The second black screen came after two mode sets 273 ms apart,
which the log did not show as such.

- The line of each change of mode says how many ms after the one before it it
  went, where that was under 10 s.
- The display's hot-plug that follows a change of mode (the LG C5 sends one
  about 2.3 s after each) writes kodi.log and the journal to the disk
  (SyncLogsToDisk(), at most every 5 s), so that they are on the disk even if
  the PC is switched off right after.
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp |  8 ++++++++
 xbmc/windowing/gbm/drm/DRMAtomic.cpp           | 16 ++++++++++++++--
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 846d4f4..b74cf5d 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2108,6 +2108,14 @@ void CWinSystemGbmGLESContext::RelinkDecide(HOTPLUG_RELINK::Facts facts,
       CLog::Log(HOTPLUG_RELINK::AtInfo(verdict, before) ? LOGINFO : LOGDEBUG,
                 "Hot-plug: after the event, the output of {} is not turned off and on again: {}{}",
                 name, why, scdc.empty() ? std::string() : " (" + scdc + ")");
+    // Hades: the display's hot-plug that follows a change of mode (the LG C5 sends one about 2.3 s
+    // after each): kodi.log and the journal go to the disk now, so that they are there if the
+    // picture does not come back and the PC is switched off. On 2026-11-19 the TV stayed black
+    // twice while Kodi and the driver went on, no flip stalled (FlipStalled() syncs them then), and
+    // the end of one kodi.log was lost with the power.
+    if (const auto at = drm->LastModesetAt();
+        at && std::chrono::steady_clock::now() - *at < std::chrono::seconds(15))
+      SyncLogsToDisk("the display's hot-plug after a change of mode");
     return;
   }
   const drmModeModeInfo* mode = drm->GetSelectedMode();
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
index 4effad1..da0ec8f 100644
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -584,12 +584,24 @@ bool CDRMAtomic::DrmAtomicCommit(int fb_id, int flags, bool rendered, bool video
             ? m_mode->clock * 1000.0 / (static_cast<double>(m_mode->htotal) * m_mode->vtotal)
             : 0.0;
     const bool slow = CModesetReport::Slow(ms);
+    // Hades: ... and how soon after the change of mode before it, where that was less than 10 s
+    // ago: two in a row reach the display while it still sets itself up for the first (the LG C5
+    // sends its hot-plug about 2.3 s after each), as at the end of native Dolby Vision on
+    // 2026-11-19 10:04:06-07, after which the TV stayed black
+    std::string after;
+    if (m_lastModesetAt)
+    {
+      const auto since =
+          std::chrono::duration_cast<std::chrono::milliseconds>(commitStart - *m_lastModesetAt);
+      if (since < std::chrono::seconds(10))
+        after = StringUtils::Format("; {} ms after the change of mode before it", since.count());
+    }
     CLog::Log(slow ? LOGWARNING : LOGINFO,
               "Change of mode on {} to {}x{} @ {:.3f} Hz{}: the driver took its commit in {:.0f} "
-              "ms; the output went over {} and goes over {} now{}",
+              "ms; the output went over {} and goes over {} now{}{}",
               m_connector->GetName(), m_mode ? m_mode->hdisplay : 0, m_mode ? m_mode->vdisplay : 0,
               hz, m_active ? "" : " (output off)", ms, CModesetReport::LinkText(linkBefore),
-              CModesetReport::LinkText(linkAfter),
+              CModesetReport::LinkText(linkAfter), after,
               slow ? " (slow: nvidia-drm waits up to 3 s for the flip of a commit, and NVIDIA's "
                      "driver up to 3 s for the display engine to finish a mode set; the kernel "
                      "log says what they did, in its lines \"Hades: head\")"
