From be50cbfceb16d70eb5d501ab6523a14980a0bdbc Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:51:21 +0000
Subject: [PATCH] [Hades][VideoDatabase] A table of its own for the settings
 kept for films

The records of FilmMemory.h live in the video database, in a table of
their own, hadesfilmsettings, made with CREATE TABLE IF NOT EXISTS where
it is not there yet. The version of the database does not change: a Kodi
without this table (LibreELEC Hades 1.1 and earlier) opens the same
database and leaves the table alone, a version bump of Kodi's own tables
later copies it with the rest (SQLite's backup, MySQL's copy of every
table), and no number of Kodi's schema is taken from upstream.

Records are found by kind, season, number and any of the ids, the most
recently played first; at most 8 per film and 4000 in all are kept.
EraseAllVideoSettings() ("set as default for all media") forgets them
too.
---
 xbmc/video/VideoDatabase.cpp | 138 +++++++++++++++++++++++++++++++++++
 xbmc/video/VideoDatabase.h   |  37 +++++++++-
 2 files changed, 174 insertions(+), 1 deletion(-)

diff --git a/xbmc/video/VideoDatabase.cpp b/xbmc/video/VideoDatabase.cpp
index 6f0b56a..186dd34 100644
--- a/xbmc/video/VideoDatabase.cpp
+++ b/xbmc/video/VideoDatabase.cpp
@@ -22,6 +22,7 @@
 #include "XBDateTime.h"
 #include "addons/AddonManager.h"
 #include "cores/VideoPlayer/DVDFileInfo.h"
+#include "cores/VideoPlayer/FilmMemory.h"
 #include "dbwrappers/dataset.h"
 #include "dialogs/GUIDialogExtendedProgressBar.h"
 #include "dialogs/GUIDialogKaiToast.h"
@@ -91,6 +92,16 @@ using namespace std::chrono_literals;
 
 namespace
 {
+// Hades: the table of the settings kept for films and episodes (FilmMemory.h), made where it is
+// not there yet (CVideoDatabase::GetFilmSettings()); MySQL takes "integer primary key" as an
+// auto_increment one (MysqlDataset::exec())
+void FilmSettingsTable(Dataset& ds)
+{
+  ds.exec("CREATE TABLE IF NOT EXISTS hadesfilmsettings (idFilmSettings integer primary key, "
+          "kind text, imdb text, tmdb text, tvdb text, season integer, episode integer, "
+          "duration integer, used integer, settings text)");
+}
+
 // zip:// (native) and archive:// (vfs addon) paths refer to the same archive
 std::string GetArchiveAliasPath(const std::string& path)
 {
@@ -6914,11 +6925,138 @@ void CVideoDatabase::EraseAllVideoSettings()
 
     CLog::Log(LOGINFO, "Deleting all video settings");
     m_pDS->exec(sql);
+    // Hades: and those kept for films and episodes (FilmMemory.h)
+    FilmSettingsTable(*m_pDS);
+    m_pDS->exec("DELETE FROM hadesfilmsettings");
+  }
+  catch (...)
+  {
+    CLog::LogF(LOGERROR, "failed");
+  }
+}
+
+bool CVideoDatabase::GetFilmSettings(const KODI::FILMMEMORY::Identity& identity,
+                                     std::vector<KODI::FILMMEMORY::StoredRecord>& records)
+{
+  records.clear();
+  if (!m_pDB || !m_pDS)
+    return false;
+  // (one of its ids: they have the form of an id, IdentityOf())
+  std::string ids;
+  for (const auto& [column, value] : {std::pair{"imdb", &identity.imdb},
+                                      std::pair{"tmdb", &identity.tmdb},
+                                      std::pair{"tvdb", &identity.tvdb}})
+  {
+    if (value->empty())
+      continue;
+    ids += (ids.empty() ? "" : " OR ") + PrepareSQL("%s='%s'", column, value->c_str());
+  }
+  if (ids.empty())
+    return true;
+  try
+  {
+    FilmSettingsTable(*m_pDS);
+    m_pDS->query(PrepareSQL("SELECT idFilmSettings, imdb, tmdb, tvdb, settings FROM "
+                            "hadesfilmsettings WHERE kind='%s' AND season=%i AND episode=%i AND (",
+                            identity.KindText(), identity.season, identity.episode) +
+                 ids + ") ORDER BY used DESC, idFilmSettings DESC");
+    while (!m_pDS->eof())
+    {
+      KODI::FILMMEMORY::StoredRecord record;
+      record.id = m_pDS->fv(0).get_asInt();
+      record.identity.kind = identity.kind;
+      record.identity.season = identity.season;
+      record.identity.episode = identity.episode;
+      record.identity.imdb = m_pDS->fv(1).get_asString();
+      record.identity.tmdb = m_pDS->fv(2).get_asString();
+      record.identity.tvdb = m_pDS->fv(3).get_asString();
+      record.text = m_pDS->fv(4).get_asString();
+      records.push_back(std::move(record));
+      m_pDS->next();
+    }
+    m_pDS->close();
+    return true;
+  }
+  catch (...)
+  {
+    CLog::LogF(LOGERROR, "the settings kept for the {} could not be read", identity.Describe());
+  }
+  return false;
+}
+
+int CVideoDatabase::SetFilmSettings(int id,
+                                    const KODI::FILMMEMORY::Identity& identity,
+                                    int64_t durationMs,
+                                    const std::string& text)
+{
+  if (!m_pDB || !m_pDS)
+    return -1;
+  try
+  {
+    FilmSettingsTable(*m_pDS);
+    const int used = GetSingleValueInt("SELECT MAX(used) FROM hadesfilmsettings") + 1;
+    const int duration = static_cast<int>(std::clamp<int64_t>(durationMs, 0, INT32_MAX));
+    if (id >= 0)
+    {
+      m_pDS->exec(PrepareSQL("UPDATE hadesfilmsettings SET kind='%s', imdb='%s', tmdb='%s', "
+                             "tvdb='%s', season=%i, episode=%i, duration=%i, used=%i, "
+                             "settings='%s' WHERE idFilmSettings=%i",
+                             identity.KindText(), identity.imdb.c_str(), identity.tmdb.c_str(),
+                             identity.tvdb.c_str(), identity.season, identity.episode, duration,
+                             used, text.c_str(), id));
+      return id;
+    }
+    m_pDS->exec(PrepareSQL("INSERT INTO hadesfilmsettings (kind, imdb, tmdb, tvdb, season, "
+                           "episode, duration, used, settings) VALUES ('%s', '%s', '%s', '%s', "
+                           "%i, %i, %i, %i, '%s')",
+                           identity.KindText(), identity.imdb.c_str(), identity.tmdb.c_str(),
+                           identity.tvdb.c_str(), identity.season, identity.episode, duration,
+                           used, text.c_str()));
+    return static_cast<int>(m_pDS->lastinsertid());
+  }
+  catch (...)
+  {
+    CLog::LogF(LOGERROR, "the settings of the {} could not be kept", identity.Describe());
+  }
+  return -1;
+}
+
+void CVideoDatabase::DeleteFilmSettings(int id)
+{
+  if (!m_pDB || !m_pDS)
+    return;
+  try
+  {
+    FilmSettingsTable(*m_pDS);
+    m_pDS->exec(PrepareSQL("DELETE FROM hadesfilmsettings WHERE idFilmSettings=%i", id));
+  }
+  catch (...)
+  {
+    CLog::LogF(LOGERROR, "failed ({})", id);
+  }
+}
+
+int CVideoDatabase::TrimFilmSettings(int keep)
+{
+  if (!m_pDB || !m_pDS || keep < 0)
+    return 0;
+  try
+  {
+    FilmSettingsTable(*m_pDS);
+    const int total = GetSingleValueInt("SELECT COUNT(1) FROM hadesfilmsettings");
+    if (total <= keep)
+      return 0;
+    // the "used" of the first record past those kept, and every record not more recent
+    const int last = GetSingleValueInt(PrepareSQL(
+        "SELECT used FROM hadesfilmsettings ORDER BY used DESC LIMIT 1 OFFSET %i", keep));
+    m_pDS->exec(PrepareSQL("DELETE FROM hadesfilmsettings WHERE used<=%i", last));
+    return total - GetSingleValueInt("SELECT COUNT(1) FROM hadesfilmsettings");
   }
   catch (...)
   {
     CLog::LogF(LOGERROR, "failed");
   }
+  return 0;
 }
 
 void CVideoDatabase::EraseAllVideoSettings(const std::string& path)
