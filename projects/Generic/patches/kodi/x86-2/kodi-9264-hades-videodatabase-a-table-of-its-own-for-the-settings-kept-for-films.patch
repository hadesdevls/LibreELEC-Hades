    */
   void EraseAllVideoSettings();
 
+  /*!
+   * \brief Hades: the records of the settings kept for a film or an episode (FilmMemory.h): those
+   *        of its kind, season and number with one of its ids, the most recently played first
+   *        (whether all of their ids agree with it is for KODI::FILMMEMORY::SameVideo()). They are
+   *        kept in a table of their own, hadesfilmsettings, made where it is not there yet: the
+   *        version of the database does not change, so a Kodi without it (LibreELEC Hades 1.1 and
+   *        earlier, Kodi itself) opens the same database and leaves that table alone, and a later
+   *        version of Kodi's tables copies it with the rest.
+   * \return false where the database could not be read
+   */
+  bool GetFilmSettings(const KODI::FILMMEMORY::Identity& identity,
+                       std::vector<KODI::FILMMEMORY::StoredRecord>& records);
+  /*!
+   * \brief Hades: keeps a record of the settings of a film or an episode, as the most recently
+   *        played: in place of the record \p id, or as a new one where \p id is -1
+   * \return the id of the record, -1 where it could not be written
+   */
+  int SetFilmSettings(int id,
+                      const KODI::FILMMEMORY::Identity& identity,
+                      int64_t durationMs,
+                      const std::string& text);
+  //! Hades: forgets a record of the settings of a film or an episode
+  void DeleteFilmSettings(int id);
+  /*!
+   * \brief Hades: forgets the least recently played records past \p keep (all films together)
+   * \return how many were forgotten
+   */
+  int TrimFilmSettings(int keep);
+
   /**
    * Erases video settings for files starting with path
    * @param path pattern
