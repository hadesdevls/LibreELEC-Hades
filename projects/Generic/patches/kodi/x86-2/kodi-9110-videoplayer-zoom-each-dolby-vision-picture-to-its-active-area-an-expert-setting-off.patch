+bool CBaseRenderer::ZoomToActiveArea(unsigned int stereoMode, float inputFrameRatio)
+{
+  const ACTIVEAREA::Decision& zoom = m_activeArea;
+  const CRect view = m_viewRect;
+  // (not asked: the setting is off, or no picture was presented with it on; and nothing to place
+  // on before the view is known)
+  if ((!zoom.asked && !m_activeAreaOn) || view.Width() <= 0.0f || view.Height() <= 0.0f)
+  {
+    m_activeAreaOn = false;
+    return false;
+  }
+
+  // why it is not drawn now (a fixed text), else the place of the whole picture (and Kodi's own)
+  const char* off = nullptr;
+  CRect dest;
+  CRect whole;
+  const CDisplaySettings& display = CDisplaySettings::GetInstance();
+  if (!zoom.asked)
+    off = "the setting is off";
+  else if (!zoom.Zoom())
+    off = zoom.why ? zoom.why : "the active area is the whole picture";
+  else if (zoom.width != static_cast<int>(m_sourceWidth) ||
+           zoom.height != static_cast<int>(m_sourceHeight))
+    off = "the picture is not of the size its area was read for";
+  else if (stereoMode != 0 || m_renderOrientation != 0)
+    off = "the video is in 3D or rotated";
+  else if (m_videoSettings.m_ViewMode != ViewModeNormal || display.GetZoomAmount() != 1.0f ||
+           display.GetPixelRatio() != 1.0f || display.GetVerticalShift() != 0.0f ||
+           display.IsNonLinearStretched())
+    off = "the view mode is the user's";
+  else if (m_activeAreaMenu)
+    off = "a disc menu is shown";
+  else
+  {
+    // Kodi's places for the whole picture and for a picture of the area's shape, in the view
+    CRect fitted;
+    CalcDestRect(view.x1, view.y1, view.Width(), view.Height(), inputFrameRatio, 1.0f, 0.0f, whole);
+    const float areaRatio =
+        inputFrameRatio *
+        (static_cast<float>(zoom.area.Width()) / static_cast<float>(m_sourceWidth)) /
+        (static_cast<float>(zoom.area.Height()) / static_cast<float>(m_sourceHeight));
+    CalcDestRect(view.x1, view.y1, view.Width(), view.Height(), areaRatio, 1.0f, 0.0f, fitted);
+    if (!ACTIVEAREA::PlaceForArea(fitted, whole, static_cast<int>(m_sourceWidth),
+                                  static_cast<int>(m_sourceHeight), zoom.area, dest))
+      off = "the screen shows the active area no larger than the whole picture";
+  }
+
+  // the log: a line when it starts, changes or stops, or why it is not drawn when that changes
+  auto& said = m_activeAreaLogged;
+  const bool on = off == nullptr;
+  if (!said.said || said.on != on || (on && (!(said.area == zoom.area) || said.dest != dest)) ||
+      (!on && said.off != off))
+  {
+    if (on)
+    {
+      const ACTIVEAREA::Area& a = zoom.area;
+      CLog::Log(LOGINFO,
+                "Active area zoom: {}: the area {}x{} at {},{} of the {}x{} picture ({:.2f}:1), "
+                "taken {}, fits the screen {}x{} at {},{}: the whole picture is drawn {}x{} at "
+                "{},{}, {:.3f} times as wide as at Kodi's own place",
+                said.said && said.on ? "changed" : "on", a.Width(), a.Height(), a.x1, a.y1,
+                zoom.width, zoom.height,
+                static_cast<double>(inputFrameRatio) * a.Width() / zoom.width /
+                    (static_cast<double>(a.Height()) / zoom.height),
+                zoom.how ? zoom.how : "", view.Width(), view.Height(), view.x1, view.y1,
+                dest.Width(), dest.Height(), dest.x1, dest.y1,
+                static_cast<double>(dest.Width()) /
+                    static_cast<double>(std::max(1.0f, whole.Width())));
+    }
+    else if (said.said && said.on)
+      CLog::Log(LOGINFO, "Active area zoom: off: {}{}{}", off,
+                zoom.asked && zoom.how ? ", taken " : "",
+                zoom.asked && zoom.how ? zoom.how : "");
+    else
+      CLog::Log(LOGINFO, "Active area zoom: not used: {}", off);
+    said.said = true;
+    said.on = on;
+    said.area = zoom.area;
+    said.dest = dest;
+    said.off = off;
+  }
+
+  m_activeAreaOn = on;
+  if (!on)
+    return false;
+  m_destRect = dest;
+  ClipRenderRect(view.x1, view.y1, view.Width(), view.Height());
+  return true;
+}
+
