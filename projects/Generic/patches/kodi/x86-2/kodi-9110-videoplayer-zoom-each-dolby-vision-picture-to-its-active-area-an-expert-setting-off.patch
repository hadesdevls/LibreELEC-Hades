+TEST(ActiveAreaPlace, WindowboxedScopeOfAnImaxMasterFillsTheWidth)
+{
+  // a 2.39:1 scene inside a 1.43:1 picture pillarboxed in 16:9
+  const Area area{375, 434, 3465, 1726};
+  const CRect tv(0, 0, W, H);
+  const double frame = 16.0 / 9.0;
+  const double ratio = frame * (double(area.Width()) / W) / (double(area.Height()) / H);
+  const CRect fitted = Fit(tv, ratio);
+  CRect dest;
+  ASSERT_TRUE(PlaceForArea(fitted, Fit(tv, frame), W, H, area, dest));
+  // the area lands where Kodi would place a picture of its shape, to the pixel
+  const double sx = static_cast<double>(dest.Width()) / W;
+  const double sy = static_cast<double>(dest.Height()) / H;
+  EXPECT_NEAR(static_cast<double>(dest.x1) + area.x1 * sx, static_cast<double>(fitted.x1), 1.0);
+  EXPECT_NEAR(static_cast<double>(dest.x1) + area.x2 * sx, static_cast<double>(fitted.x2), 1.0);
+  EXPECT_NEAR(static_cast<double>(dest.y1) + area.y1 * sy, static_cast<double>(fitted.y1), 1.0);
+  EXPECT_NEAR(static_cast<double>(dest.y1) + area.y2 * sy, static_cast<double>(fitted.y2), 1.0);
+  EXPECT_LT(dest.x1, 0.0f);
+  EXPECT_GT(dest.x2, float(W));
+}
