diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/ActiveAreaZoom.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/ActiveAreaZoom.cpp
new file mode 100644
index 0000000..f8670d3
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/ActiveAreaZoom.cpp
@@ -0,0 +1,233 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "ActiveAreaZoom.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace ACTIVEAREA
+{
+
+namespace
+{
+// (fixed texts, for the log)
+constexpr const char* WHOLE = "the active area is the whole picture";
+constexpr const char* OUTSIDE = "the active area is not within the picture";
+constexpr const char* SMALL = "the active area is less than 40 % of the picture in width or height";
+constexpr const char* FIRST = "with the first picture after a start or a seek";
+constexpr const char* CUT = "at a new scene, which the RPU marks";
+constexpr const char* GROWN = "after two pictures of four with more of the picture active";
+constexpr const char* SHRUNK = "after a second with less of the picture active";
+
+Area Union(const Area& a, const Area& b)
+{
+  return {std::min(a.x1, b.x1), std::min(a.y1, b.y1), std::max(a.x2, b.x2), std::max(a.y2, b.y2)};
+}
+
+//! each edge within the tolerance
+bool Near(const Area& a, const Area& b, int tx, int ty)
+{
+  return std::abs(a.x1 - b.x1) <= tx && std::abs(a.x2 - b.x2) <= tx && std::abs(a.y1 - b.y1) <= ty &&
+         std::abs(a.y2 - b.y2) <= ty;
+}
+} // namespace
+
+void CAreaHysteresis::Take(const Area& area, const char* why, const char* how)
+{
+  const bool whole = area == Area{0, 0, m_width, m_height};
+  m_shown = area;
+  m_why = whole ? (why ? why : WHOLE) : nullptr;
+  m_how = how;
+  m_growing = false;
+  m_shrinking = false;
+}
+
+Decision CAreaHysteresis::Made() const
+{
+  Decision decision;
+  decision.asked = true;
+  decision.width = m_width;
+  decision.height = m_height;
+  decision.area = m_shown;
+  decision.how = m_how;
+  decision.why = m_why;
+  return decision;
+}
+
+Decision CAreaHysteresis::Next(const Picture& picture)
+{
+  if (picture.width <= 0 || picture.height <= 0)
+  {
+    Reset();
+    Decision none;
+    none.asked = true;
+    return none;
+  }
+  // (a picture of another size is another stream)
+  if (m_started && (picture.width != m_width || picture.height != m_height))
+    Reset();
+
+  const Area whole{0, 0, picture.width, picture.height};
+  Area candidate = whole;
+  const char* why = picture.noArea;
+  if (!why)
+  {
+    const Area& a = picture.area;
+    if (a.x1 < 0 || a.y1 < 0 || a.x2 > picture.width || a.y2 > picture.height || a.Width() <= 0 ||
+        a.Height() <= 0)
+      why = OUTSIDE;
+    else if (a.Width() < MIN_SHARE * picture.width || a.Height() < MIN_SHARE * picture.height)
+      why = SMALL;
+    else if (a == whole)
+      why = WHOLE;
+    else
+      candidate = a;
+  }
+
+  // a cut: the RPU marks it, and not as one of a run of marks closer than CUT_SPACING (an RPU that
+  // marks every picture, or every other one); a time that goes back is no spacing
+  bool cut = false;
+  if (picture.sceneCut)
+  {
+    if (!m_markSeen)
+      cut = true;
+    else if (picture.timed && m_markTimed)
+      cut = picture.seconds - m_markSeconds >= CUT_SPACING_SECONDS;
+    else
+      cut = m_pictures - m_markPicture >= CUT_SPACING_PICTURES;
+    m_markSeen = true;
+    m_markSeconds = picture.seconds;
+    m_markTimed = picture.timed;
+    m_markPicture = m_pictures;
+  }
+  m_pictures++;
+
+  if (!m_started)
+  {
+    m_started = true;
+    m_width = picture.width;
+    m_height = picture.height;
+    Take(candidate, why, FIRST);
+    return Made();
+  }
+
+  const int tx = std::max(2, picture.width / TOLERANCE_DIVISOR);
+  const int ty = std::max(2, picture.height / TOLERANCE_DIVISOR);
+  // more of the picture active: an edge of it beyond the area zoomed to (by any amount: what is
+  // active is not left out); less of it: an edge inside by more than the tolerance
+  const bool grows = candidate.x1 < m_shown.x1 || candidate.y1 < m_shown.y1 ||
+                     candidate.x2 > m_shown.x2 || candidate.y2 > m_shown.y2;
+  const bool shrinks = !grows && (candidate.x1 - m_shown.x1 > tx || candidate.y1 - m_shown.y1 > ty ||
+                                  m_shown.x2 - candidate.x2 > tx || m_shown.y2 - candidate.y2 > ty);
+  if (!grows && !shrinks)
+  {
+    // (less of the picture waited for ends: this picture is the area zoomed to; more of it waited
+    // for goes on, for the pictures of its window)
+    m_shrinking = false;
+    return Made();
+  }
+  if (cut)
+  {
+    Take(candidate, why, CUT);
+    return Made();
+  }
+
+  if (grows)
+  {
+    // more of the picture active: the union of what the pictures of a window bring, taken at the
+    // second of them; less of it waited for ends
+    m_shrinking = false;
+    if (m_growing && m_pictures - m_growLast <= GROW_WINDOW)
+    {
+      m_growArea = Union(m_growArea, candidate);
+      m_growCount++;
+      if (why)
+        m_growWhy = why;
+    }
+    else
+    {
+      m_growing = true;
+      m_growArea = candidate;
+      m_growCount = 1;
+      m_growWhy = why;
+    }
+    m_growLast = m_pictures;
+    if (m_growCount >= GROW_PICTURES)
+      Take(m_growArea, m_growWhy, GROWN);
+    return Made();
+  }
+
+  // less of it: the same area (within the tolerance) for SHRINK_SECONDS, or SHRINK_PICTURES
+  // pictures where their times are not known; a time that goes back starts the wait again
+  const bool timeBack =
+      m_shrinking && picture.timed && m_shrinkTimed && picture.seconds < m_shrinkSince;
+  if (!m_shrinking || timeBack || !Near(candidate, m_shrinkArea, tx, ty))
+  {
+    m_shrinking = true;
+    m_shrinkArea = candidate;
+    m_shrinkWhy = why;
+    m_shrinkCount = 1;
+    m_shrinkSince = picture.seconds;
+    m_shrinkTimed = picture.timed;
+  }
+  else
+  {
+    m_shrinkCount++;
+    m_shrinkArea = candidate;
+    m_shrinkWhy = why;
+  }
+  const bool held = m_shrinkTimed && picture.timed
+                        ? picture.seconds - m_shrinkSince >= SHRINK_SECONDS
+                        : m_shrinkCount >= SHRINK_PICTURES;
+  if (held)
+    Take(m_shrinkArea, m_shrinkWhy, SHRUNK);
+  return Made();
+}
+
+bool PlaceForArea(const CRect& areaDest,
+                  const CRect& wholeDest,
+                  int width,
+                  int height,
+                  const Area& area,
+                  CRect& dest)
+{
+  if (width <= 0 || height <= 0 || area.Width() <= 0 || area.Height() <= 0 ||
+      !(areaDest.Width() > 0.0f) || !(areaDest.Height() > 0.0f) || !(wholeDest.Width() > 0.0f) ||
+      !(wholeDest.Height() > 0.0f))
+    return false;
+  // pixels of the screen for a sample of the picture: with the area at its place, and with the
+  // whole picture at its own
+  const double aw = static_cast<double>(areaDest.Width());
+  const double ah = static_cast<double>(areaDest.Height());
+  const double sx = aw / area.Width();
+  const double sy = ah / area.Height();
+  const double wx = static_cast<double>(wholeDest.Width()) / width;
+  const double wy = static_cast<double>(wholeDest.Height()) / height;
+  if (!(aw - wx * area.Width() > 1.0 && ah - wy * area.Height() > 1.0))
+    return false;
+  const double x1 = std::round(static_cast<double>(areaDest.x1) - area.x1 * sx);
+  const double y1 = std::round(static_cast<double>(areaDest.y1) - area.y1 * sy);
+  dest.x1 = static_cast<float>(x1);
+  dest.y1 = static_cast<float>(y1);
+  dest.x2 = static_cast<float>(x1 + std::round(width * sx));
+  dest.y2 = static_cast<float>(y1 + std::round(height * sy));
+  return std::isfinite(dest.x1) && std::isfinite(dest.y1) && std::isfinite(dest.x2) &&
+         std::isfinite(dest.y2) && dest.x2 > dest.x1 && dest.y2 > dest.y1;
+}
+
+float KeptInViewOffset(float y1, float y2, float top, float bottom)
+{
+  const float down = top - y1; // (> 0: it starts above the screen)
+  const float up = bottom - y2; // (< 0: it ends below the screen)
+  if (down > up)
+    return 0.0f;
+  return std::clamp(0.0f, down, up);
+}
+
+} // namespace ACTIVEAREA
