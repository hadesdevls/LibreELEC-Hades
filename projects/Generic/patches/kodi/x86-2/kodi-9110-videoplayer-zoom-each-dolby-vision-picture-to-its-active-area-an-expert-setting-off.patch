+#pragma once
+
+// Hades: the zoom to the active area of a Dolby Vision video (videoplayer.hadesactiveareazoom, an
+// expert setting, off by default). For a screen of another shape than the coded picture (a 2.35:1
+// or 2.39:1 screen, constant image height) and for films whose scenes change shape (IMAX scenes
+// within a film, or a 2.39:1 scene windowboxed in a 1.43:1 master). With Kodi's view mode Normal,
+// the part of each picture that its metadata mark as active (level 5) is fitted to the screen in
+// place of the whole coded picture, where that shows it larger. The whole picture is drawn larger,
+// its bars beyond the screen, as Kodi's own zoom draws a picture: the source stays the whole
+// picture, so that every way of drawing it (Kodi's, native Dolby Vision through the part of the
+// picture shown, DVBRIDGE::ViewGeometry(), and its conversion to HDR10 or SDR) and the subtitles
+// take it as they take Kodi's zoom. The level 5 block sent with native output is then that of the
+// picture as drawn (dvbridge_dv_area() in dvbridge_metadata.h, through the view).
+//
+// The screen is Kodi's own: the view window (in full screen, the area set in Settings > System >
+// Display > Video calibration, which is where a 2.35:1 or 2.39:1 screen is told) and the pixel
+// ratio of the resolution (an anamorphic lens). The area is fitted as Kodi fits a picture: whole,
+// as large as the screen takes it. So nothing of the active picture is ever cut off: an area taller
+// than the screen (a 1.78:1 or 1.90:1 IMAX scene on a 2.39:1 screen) fills the height of the screen,
+// with bars at its sides (the height of the image stays constant).
+//
+// What is zoomed to goes by the pictures as they are queued, in their order (CAreaHysteresis, on
+// the player thread), and travels with each picture to the screen:
+//  - a change at a picture that its RPU marks as the first of a scene (scene_refresh_flag) is taken
+//    with that picture; marks that come closer than CUT_SPACING_SECONDS (an RPU that marks every
+//    picture) are not taken as cuts;
+//  - otherwise more of the picture active (an area that reaches beyond the one zoomed to) is taken
+//    once GROW_PICTURES pictures within GROW_WINDOW + 1 bring it (their union: a block that
+//    alternates is taken whole, and then holds), and less of it once it has held for
+//    SHRINK_SECONDS: a level 5 block that changes for one picture, or that comes and goes in a fade
+//    or a dark scene, moves nothing, and nothing active is left out for longer than that;
+//  - less of the picture by at most 1/TOLERANCE_DIVISOR of its width or height on each edge is no
+//    change.
+// Without an area that can be used, the whole picture is what is zoomed to (fail-closed): a picture
+// without Dolby Vision metadata of its own, metadata without a level 5 block or with more than one,
+// offsets that fit no reading of the picture (dvbridge_l5_area()), or an area of less than MIN_SHARE
+// of the picture in width or height.
+//
+// How it is drawn goes by the picture presented (CBaseRenderer::ManageRenderArea(), the render
+// thread): only in the view mode Normal as Kodi sets it (no zoom, pixel ratio, shift or stretch of
+// the user's: a view mode chosen by the user is the user's), not for a 3D or a rotated video, not
+// while a disc menu is shown (its graphics are placed on the whole picture), and only where it
+// draws the area larger than the whole picture is drawn (on a 16:9 TV a 2.39:1 film in a 16:9
+// picture is already as large as it can be: nothing changes, to the byte). A line in the log says
+// when it starts, changes and stops, with the area and why.
+
+#include "utils/Geometry.h"
+
+namespace ACTIVEAREA
+{
+
+//! A part of a picture, in its samples: left, top, right, bottom (right and bottom excluded)
+struct Area
+{
+  int x1 = 0;
+  int y1 = 0;
+  int x2 = 0;
+  int y2 = 0;
+  int Width() const { return x2 - x1; }
+  int Height() const { return y2 - y1; }
+  bool operator==(const Area& other) const = default;
+};
+
+//! What a picture brings
+struct Picture
+{
+  int width = 0;
+  int height = 0;
+  //! its active area (dvbridge_l5_area()), where noArea is nullptr
+  Area area;
+  //! why it has no active area (a fixed text), or nullptr
+  const char* noArea = nullptr;
+  //! its RPU marks it as the first picture of a scene (scene_refresh_flag)
+  bool sceneCut = false;
+  //! its presentation time in seconds, where timed
+  double seconds = 0.0;
+  bool timed = false;
+};
+
+//! What a picture is zoomed to
+struct Decision
+{
+  //! the setting is on: a picture queued with it off has a Decision{}, and nothing is changed
+  bool asked = false;
+  //! the size of the picture
+  int width = 0;
+  int height = 0;
+  //! the area zoomed to: the whole picture where there is no zoom
+  Area area;
+  //! how the area was taken (a fixed text, for the log)
+  const char* how = nullptr;
+  //! where the area is the whole picture, why (a fixed text, for the log)
+  const char* why = nullptr;
+  //! an area that is not the whole picture
+  bool Zoom() const
+  {
+    return asked && width > 0 && height > 0 && !(area == Area{0, 0, width, height});
+  }
+};
+
+//! The area zoomed to, picture by picture (see the top of this file). Not thread safe: the
+//! caller's lock.
+class CAreaHysteresis
+{
+public:
+  //! an area of less than this share of the picture in width or height is not used
+  static constexpr double MIN_SHARE = 0.4;
+  //! less of the picture by at most this part of its width or height (at least 2 samples) on each
+  //! edge is no change
+  static constexpr int TOLERANCE_DIVISOR = 256;
+  //! pictures that must bring more of the picture active before it is taken (their union) ...
+  static constexpr int GROW_PICTURES = 2;
+  //! ... each within this many pictures of the one before
+  static constexpr int GROW_WINDOW = 3;
+  //! how long less of the picture must stay active before it is taken
+  static constexpr double SHRINK_SECONDS = 1.0;
+  //! ... in pictures, where their times are not known
+  static constexpr int SHRINK_PICTURES = 24;
+  //! marks of a scene closer than this are not taken as cuts
+  static constexpr double CUT_SPACING_SECONDS = 0.5;
+  //! ... in pictures, where their times are not known
+  static constexpr int CUT_SPACING_PICTURES = 12;
+
+  //! a start, a seek, or the setting turned off: the next picture is taken as it comes
+  void Reset() { *this = CAreaHysteresis(); }
+  //! the next picture queued, in the order they are shown
+  Decision Next(const Picture& picture);
+
+private:
+  void Take(const Area& area, const char* why, const char* how);
+  Decision Made() const;
+
+  bool m_started = false;
+  int m_width = 0;
+  int m_height = 0;
+  Area m_shown;
+  const char* m_how = nullptr;
+  const char* m_why = nullptr;
+  //! more of the picture active waited for: the union of what came, how many pictures brought it
+  //! and the last of them
+  bool m_growing = false;
+  Area m_growArea;
+  const char* m_growWhy = nullptr;
+  int m_growCount = 0;
+  long m_growLast = 0;
+  //! less of it waited for: since when (and how many pictures) the same area comes
+  bool m_shrinking = false;
+  Area m_shrinkArea;
+  const char* m_shrinkWhy = nullptr;
+  int m_shrinkCount = 0;
+  double m_shrinkSince = 0.0;
+  bool m_shrinkTimed = false;
+  //! the last picture its RPU marked as the first of a scene
+  bool m_markSeen = false;
+  double m_markSeconds = 0.0;
+  bool m_markTimed = false;
+  long m_markPicture = 0;
+  long m_pictures = 0;
+};
+
+//! Where the whole picture of width x height samples is drawn so that its area lands at areaDest
+//! (Kodi's place for a picture of the area's shape, CBaseRenderer::CalcDestRect()), on whole
+//! pixels; false where that does not draw the area larger, by more than a pixel in width and in
+//! height, than it is drawn within wholeDest (Kodi's place for the whole picture).
+bool PlaceForArea(const CRect& areaDest,
+                  const CRect& wholeDest,
+                  int width,
+                  int height,
+                  const Area& area,
+                  CRect& dest);
+
+//! How far a line of a subtitle drawn from y1 to y2 is moved to be on a screen from top to bottom:
+//! no further than it takes, not at all where it is on it already or is taller than it
+//! (OVERLAY::CRenderer::RepositionBitmapSubtitles())
+float KeptInViewOffset(float y1, float y2, float top, float bottom);
+
+} // namespace ACTIVEAREA
