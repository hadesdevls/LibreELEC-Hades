+#ifdef ACTIVEAREA_TEST_L5
+// --- dvbridge_l5_area(): AVDOVIMetadata laid out as FFmpeg lays it out (av_dovi_metadata_alloc())
+namespace
+{
+struct Meta
+{
+  std::vector<uint8_t> bytes;
+  AVDOVIMetadata* m() { return reinterpret_cast<AVDOVIMetadata*>(bytes.data()); }
+};
+
+size_t Align(size_t n, size_t a)
+{
+  return (n + a - 1) / a * a;
+}
+
+Meta MakeMeta(const std::vector<std::array<int, 4>>& l5, bool cut = false, bool withOther = true)
+{
+  Meta out;
+  size_t at = Align(sizeof(AVDOVIMetadata), alignof(AVDOVIRpuDataHeader));
+  const size_t header = at;
+  at = Align(at + sizeof(AVDOVIRpuDataHeader), alignof(AVDOVIDataMapping));
+  const size_t mapping = at;
+  at = Align(at + sizeof(AVDOVIDataMapping), alignof(AVDOVIColorMetadata));
+  const size_t color = at;
+  at = Align(at + sizeof(AVDOVIColorMetadata), alignof(AVDOVIDmData));
+  const size_t ext = at;
+  const size_t n = l5.size() + (withOther ? 1 : 0);
+  out.bytes.assign(ext + n * sizeof(AVDOVIDmData) + 64, 0);
+  AVDOVIMetadata* m = out.m();
+  m->header_offset = header;
+  m->mapping_offset = mapping;
+  m->color_offset = color;
+  m->ext_block_offset = ext;
+  m->ext_block_size = sizeof(AVDOVIDmData);
+  m->num_ext_blocks = static_cast<int>(n);
+  av_dovi_get_color(m)->scene_refresh_flag = cut ? 1 : 0;
+  int i = 0;
+  if (withOther)
+    av_dovi_get_ext(m, i++)->level = 1;
+  for (const auto& o : l5)
+  {
+    AVDOVIDmData* e = av_dovi_get_ext(m, i++);
+    e->level = 5;
+    e->l5.left_offset = o[0];
+    e->l5.right_offset = o[1];
+    e->l5.top_offset = o[2];
+    e->l5.bottom_offset = o[3];
+  }
+  return out;
+}
+
+Area L5Area(Meta& meta,
+            int w,
+            int h,
+            const char** why = nullptr,
+            bool* cut = nullptr,
+            unsigned* offsets = nullptr)
+{
+  int a[4] = {-1, -1, -1, -1};
+  const char* r = dvbridge_l5_area(meta.bytes.data(), meta.bytes.size(), w, h, a, cut, offsets);
+  if (why)
+    *why = r;
+  return r ? Area{-1, -1, -1, -1} : Area{a[0], a[1], a[2], a[3]};
+}
+} // namespace
+
+TEST(ActiveAreaL5, UhdOffsetsAreThePicture)
+{
+  Meta meta = MakeMeta({{0, 0, 276, 277}});
+  unsigned offsets[4] = {9, 9, 9, 9};
+  EXPECT_EQ(L5Area(meta, W, H, nullptr, nullptr, offsets), (Area{0, 276, W, 1883}));
+  // (the offsets as the RPU gives them, which a measurement of native output may leave aside)
+  EXPECT_EQ(offsets[0], 0u);
+  EXPECT_EQ(offsets[1], 0u);
+  EXPECT_EQ(offsets[2], 276u);
+  EXPECT_EQ(offsets[3], 277u);
+}
+
+TEST(ActiveAreaL5, HdOfAUhdMasterIsReadAsTheMaster)
+{
+  // an HD encode that kept the RPU of its 3840x2160 master: the bars are half as many rows
+  Meta meta = MakeMeta({{0, 0, 276, 277}});
+  EXPECT_EQ(L5Area(meta, 1920, 1080), (Area{0, 138, 1920, 941}));
+}
+
+TEST(ActiveAreaL5, ACropOfTheBarsHasNoneLeft)
+{
+  // a 3840x1600 encode with the bars cropped off and the master's RPU: no bars in the picture
+  Meta meta = MakeMeta({{0, 0, 276, 277}});
+  EXPECT_EQ(L5Area(meta, 3840, 1600), (Area{0, 0, 3840, 1600}));
+}
+
+TEST(ActiveAreaL5, NoBlockTwoBlocksNoPicture)
+{
+  const char* why = nullptr;
+  Meta none = MakeMeta({});
+  L5Area(none, W, H, &why);
+  EXPECT_STREQ(why, "the metadata have no level 5 block");
+  Meta two = MakeMeta({{0, 0, 276, 277}, {0, 0, 276, 277}});
+  L5Area(two, W, H, &why);
+  EXPECT_STREQ(why, "the metadata have more than one level 5 block");
+  Meta all = MakeMeta({{0, 0, 1080, 1080}});
+  L5Area(all, W, H, &why);
+  EXPECT_STREQ(why, "the level 5 offsets leave no picture");
+  Meta torn = MakeMeta({{0, 0, 276, 277}});
+  int a[4];
+  EXPECT_STREQ(dvbridge_l5_area(torn.bytes.data(), sizeof(AVDOVIMetadata) - 1, W, H, a, nullptr, nullptr),
+               "the Dolby Vision metadata cannot be read");
+  torn.m()->num_ext_blocks = 1000;
+  EXPECT_STREQ(dvbridge_l5_area(torn.bytes.data(), torn.bytes.size(), W, H, a, nullptr, nullptr),
+               "the Dolby Vision metadata cannot be read");
+}
+
+TEST(ActiveAreaL5, TheSceneMark)
+{
+  bool cut = false;
+  Meta meta = MakeMeta({{0, 0, 276, 277}}, true);
+  L5Area(meta, W, H, nullptr, &cut);
+  EXPECT_TRUE(cut);
+  Meta plain = MakeMeta({{0, 0, 276, 277}}, false);
+  L5Area(plain, W, H, nullptr, &cut);
+  EXPECT_FALSE(cut);
+}
+
+TEST(ActiveAreaL5, ALargerPictureIsReadScaledToTheRaster)
+{
+  // a 4096x2160 picture: placed 3840x2025 in the raster, its margins brought back to its samples
+  Meta meta = MakeMeta({{128, 128, 0, 0}});
+  const Area a = L5Area(meta, 4096, 2160);
+  EXPECT_NEAR(a.x1, 128, 1);
+  EXPECT_NEAR(a.x2, 4096 - 128, 1);
+  EXPECT_EQ(a.y1, 0);
+  EXPECT_EQ(a.y2, 2160);
+}
+#endif
