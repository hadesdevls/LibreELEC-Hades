+TEST(ActiveAreaPlace, ScopeOnAScopeScreenIsTheWholePictureAtItsSize)
+{
+  // a 2.39:1 screen set in the video calibration of a 3840x2160 projector (rows 276 to 1883)
+  const CRect band(0, 276, W, 1883);
+  const double frame = 16.0 / 9.0;
+  const CRect whole = Fit(band, frame);
+  const double ratio = frame * (double(SCOPE.Width()) / W) / (double(SCOPE.Height()) / H);
+  const CRect fitted = Fit(band, ratio);
+  CRect dest;
+  ASSERT_TRUE(PlaceForArea(fitted, whole, W, H, SCOPE, dest));
+  EXPECT_EQ(dest, CRect(0, 0, W, H));
+}
