+
+// Hades: the zoom to the active area (ActiveAreaZoom.h): the area zoomed to picture by picture
+// (CAreaHysteresis), the place of the whole picture (PlaceForArea()), the subtitles kept on the
+// screen (KeptInViewOffset()) and, where the Dolby Vision bridge is built, its reading of the level 5
+// block (dvbridge_l5_area()).
+
+#include "cores/VideoPlayer/VideoRenderers/ActiveAreaZoom.h"
+
+#if defined(HAVE_DVBRIDGE) && __has_include("dvbridge_l5area.h")
+#define ACTIVEAREA_TEST_L5 1
+#include "dvbridge_l5area.h"
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+}
+#endif
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+using namespace ACTIVEAREA;
+
+namespace
+{
+constexpr int W = 3840;
+constexpr int H = 2160;
+const Area WHOLE{0, 0, W, H};
+const Area SCOPE{0, 276, W, 1883}; // 2.39:1 in 16:9 (L5 0/0/276/277)
+const Area FLAT{0, 56, W, 2104};   // 1.90:1 IMAX in 16:9
+
+Picture Pic(const Area* area, double t, bool cut = false, const char* noArea = nullptr)
+{
+  Picture p;
+  p.width = W;
+  p.height = H;
+  if (area)
+    p.area = *area;
+  else
+    p.noArea = noArea ? noArea : "the metadata have no level 5 block";
+  p.sceneCut = cut;
+  p.seconds = t;
+  p.timed = true;
+  return p;
+}
+
+constexpr double F = 1.0 / 24.0;
+} // namespace
+
+TEST(ActiveAreaHysteresis, FirstPictureIsTakenAtOnce)
+{
+  CAreaHysteresis h;
+  const Decision d = h.Next(Pic(&SCOPE, 0.0));
+  EXPECT_TRUE(d.Zoom());
+  EXPECT_EQ(d.area, SCOPE);
+  EXPECT_TRUE(d.asked);
+}
+
+TEST(ActiveAreaHysteresis, OnePictureWithMoreActiveMovesNothing)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&SCOPE, 0.0));
+  for (int i = 1; i < 30; ++i)
+    h.Next(Pic(&SCOPE, i * F));
+  // one picture whose level 5 says the whole picture, without a cut, then the area again
+  Decision d = h.Next(Pic(&WHOLE, 30 * F));
+  EXPECT_EQ(d.area, SCOPE);
+  for (int i = 31; i < 40; ++i)
+  {
+    d = h.Next(Pic(&SCOPE, i * F));
+    EXPECT_EQ(d.area, SCOPE) << i;
+  }
+  // ... and, later, one picture without a level 5 block
+  d = h.Next(Pic(nullptr, 40 * F));
+  EXPECT_EQ(d.area, SCOPE);
+  d = h.Next(Pic(&SCOPE, 41 * F));
+  EXPECT_EQ(d.area, SCOPE);
+}
+
+TEST(ActiveAreaHysteresis, MoreActiveForTwoPicturesIsTaken)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&SCOPE, 0.0));
+  Decision d = h.Next(Pic(&FLAT, F));
+  EXPECT_EQ(d.area, SCOPE);
+  d = h.Next(Pic(&FLAT, 2 * F));
+  EXPECT_EQ(d.area, FLAT);
+  EXPECT_STREQ(d.how, "after two pictures of four with more of the picture active");
+}
+
+TEST(ActiveAreaHysteresis, AlternatingMoreActiveIsTakenAndHolds)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&SCOPE, 0.0));
+  for (int i = 1; i < 30; ++i)
+    h.Next(Pic(&SCOPE, i * F));
+  // a block that alternates, picture by picture, with one that has more of the picture active:
+  // taken at its second picture, and then held (no zoom that pumps)
+  const Area wider{0, 200, W, 1960};
+  Decision d = h.Next(Pic(&wider, 30 * F));
+  EXPECT_EQ(d.area, SCOPE);
+  d = h.Next(Pic(&SCOPE, 31 * F));
+  EXPECT_EQ(d.area, SCOPE);
+  d = h.Next(Pic(&wider, 32 * F));
+  EXPECT_EQ(d.area, wider);
+  for (int i = 33; i < 200; ++i)
+  {
+    d = h.Next(Pic(i % 2 ? &SCOPE : &wider, i * F));
+    EXPECT_EQ(d.area, wider) << i;
+  }
+  // two pictures with more of it further apart than the window are two glitches
+  CAreaHysteresis g;
+  g.Next(Pic(&SCOPE, 0.0));
+  g.Next(Pic(&wider, F));
+  for (int i = 2; i < 5; ++i)
+    g.Next(Pic(&SCOPE, i * F));
+  d = g.Next(Pic(&wider, 5 * F));
+  EXPECT_EQ(d.area, SCOPE);
+}
+
+TEST(ActiveAreaHysteresis, MoreActiveTakesTheUnionOfWhatCame)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&SCOPE, 0.0));
+  const Area a{0, 200, W, 1900};
+  const Area b{0, 250, W, 2000};
+  h.Next(Pic(&a, F));
+  const Decision d = h.Next(Pic(&b, 2 * F));
+  EXPECT_EQ(d.area, (Area{0, 200, W, 2000}));
+}
+
+TEST(ActiveAreaHysteresis, LessActiveIsTakenAfterASecond)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&FLAT, 0.0));
+  Decision d;
+  int i = 1;
+  for (; i <= 24; ++i)
+  {
+    d = h.Next(Pic(&SCOPE, 10.0 + (i - 1) * F));
+    if (i < 24)
+    {
+      EXPECT_EQ(d.area, FLAT) << i;
+    }
+  }
+  // 24 pictures at 24 fps span 23/24 s: not yet; the 25th is a second after the first
+  EXPECT_EQ(d.area, FLAT);
+  d = h.Next(Pic(&SCOPE, 10.0 + 24 * F));
+  EXPECT_EQ(d.area, SCOPE);
+  EXPECT_STREQ(d.how, "after a second with less of the picture active");
+}
+
+TEST(ActiveAreaHysteresis, ACutMarkedByTheRpuIsTakenWithItsPicture)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&FLAT, 0.0));
+  for (int i = 1; i < 48; ++i)
+    h.Next(Pic(&FLAT, i * F));
+  Decision d = h.Next(Pic(&SCOPE, 48 * F, true));
+  EXPECT_EQ(d.area, SCOPE);
+  EXPECT_STREQ(d.how, "at a new scene, which the RPU marks");
+  for (int i = 49; i < 96; ++i)
+    h.Next(Pic(&SCOPE, i * F));
+  d = h.Next(Pic(&FLAT, 96 * F, true));
+  EXPECT_EQ(d.area, FLAT);
+}
+
+TEST(ActiveAreaHysteresis, MarksOnEveryPictureAreNoCuts)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&FLAT, 0.0, true));
+  // an RPU that marks every picture: alternating areas move nothing
+  for (int i = 1; i < 100; ++i)
+  {
+    const Decision d = h.Next(Pic(i % 2 ? &SCOPE : &FLAT, i * F, true));
+    EXPECT_EQ(d.area, FLAT) << i;
+  }
+}
+
+TEST(ActiveAreaHysteresis, SmallChangesAreNoChange)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&SCOPE, 0.0));
+  // less of the picture by up to 1/256 of its height on an edge: nothing, even held, even at a cut
+  const Area inside{0, 276 + H / 256, W, 1883 - H / 256};
+  Decision d;
+  for (int i = 1; i < 60; ++i)
+    d = h.Next(Pic(&inside, i * F, i == 30));
+  EXPECT_EQ(d.area, SCOPE);
+  // more of it by one row is not left out: taken after two pictures
+  const Area more{0, 275, W, 1883};
+  h.Next(Pic(&more, 60 * F));
+  d = h.Next(Pic(&more, 61 * F));
+  EXPECT_EQ(d.area, more);
+}
+
+TEST(ActiveAreaHysteresis, FluctuatingLessActiveIsNeverTaken)
+{
+  CAreaHysteresis h;
+  h.Next(Pic(&FLAT, 0.0));
+  // a dark scene whose level 5 wanders by more than the tolerance, inside the area zoomed to
+  for (int i = 1; i < 200; ++i)
+  {
+    const Area a{0, 276 + (i % 3) * 30, W, 1883 - (i % 3) * 30};
+    const Decision d = h.Next(Pic(&a, i * F));
+    EXPECT_EQ(d.area, FLAT) << i;
+  }
+}
+
+TEST(ActiveAreaHysteresis, WithoutAnAreaTheWholePicture)
+{
+  CAreaHysteresis h;
+  Decision d = h.Next(Pic(nullptr, 0.0, false, "the metadata have no level 5 block"));
+  EXPECT_FALSE(d.Zoom());
+  EXPECT_EQ(d.area, WHOLE);
+  EXPECT_STREQ(d.why, "the metadata have no level 5 block");
+  // an area of less than 40 % of the picture in height is not used
+  const Area thin{0, 700, W, 1500};
+  CAreaHysteresis h2;
+  d = h2.Next(Pic(&thin, 0.0));
+  EXPECT_FALSE(d.Zoom());
+  EXPECT_STREQ(d.why, "the active area is less than 40 % of the picture in width or height");
+  // nor one outside the picture
+  const Area outside{0, -10, W, 1883};
+  CAreaHysteresis h3;
+  d = h3.Next(Pic(&outside, 0.0));
+  EXPECT_FALSE(d.Zoom());
+  // the zoom stops (fail-closed) within two pictures when the block goes away
+  CAreaHysteresis h4;
+  h4.Next(Pic(&SCOPE, 0.0));
+  h4.Next(Pic(nullptr, F));
+  d = h4.Next(Pic(nullptr, 2 * F));
+  EXPECT_FALSE(d.Zoom());
+  EXPECT_STREQ(d.why, "the metadata have no level 5 block");
+}
+
+TEST(ActiveAreaHysteresis, WithoutTimesByPictures)
+{
+  CAreaHysteresis h;
+  Picture p = Pic(&FLAT, 0.0);
+  p.timed = false;
+  h.Next(p);
+  Decision d;
+  p.area = SCOPE;
+  for (int i = 1; i < CAreaHysteresis::SHRINK_PICTURES; ++i)
+  {
+    d = h.Next(p);
+    EXPECT_EQ(d.area, FLAT) << i;
+  }
+  d = h.Next(p);
+  EXPECT_EQ(d.area, SCOPE);
+}
