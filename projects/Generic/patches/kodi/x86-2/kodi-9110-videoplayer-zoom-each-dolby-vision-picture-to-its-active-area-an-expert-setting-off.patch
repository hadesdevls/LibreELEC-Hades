   void IgnoreL5(unsigned int picture, const unsigned int offsets[4], const char* why);
+  //! Hades: the level 5 offsets of the video (Layer::video, VideoPicture::doviVideo) as the RPU gives them are left
+  //! aside by the last decision of IgnoreL5() (a measurement found picture across the bars they make): for the zoom
+  //! to the active area (ActiveAreaZoom.h), which reads it on the player thread. Any thread.
+  static bool L5LeftAside(unsigned int video, const unsigned int offsets[4]);
   //! Hades: the fidelity step-down level of the frames prepared from now on (see
   //! dvbridge_render_set_step()). 0, the faithful picture, until it is set; Reset() keeps it
   void SetStepLevel(int level) { dvbridge_render_set_step(m_renderer, level); }
