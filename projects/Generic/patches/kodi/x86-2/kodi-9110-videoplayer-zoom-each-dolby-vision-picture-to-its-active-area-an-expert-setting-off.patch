diff --git a/xbmc/cores/VideoPlayer/test/TestActiveAreaZoom.cpp b/xbmc/cores/VideoPlayer/test/TestActiveAreaZoom.cpp
new file mode 100644
index 0000000..6002272
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/test/TestActiveAreaZoom.cpp
@@ -0,0 +1,537 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
