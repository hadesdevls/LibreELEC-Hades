+TEST(ActiveAreaPlace, TallerThanTheScreenKeepsItsHeight)
+{
+  // a 1.90:1 IMAX scene on a 2.39:1 screen: as high as the screen, bars at the sides, nothing cut
+  const CRect band(0, 276, W, 1883);
+  const double frame = 16.0 / 9.0;
+  const double ratio = frame * (double(FLAT.Width()) / W) / (double(FLAT.Height()) / H);
+  const CRect fitted = Fit(band, ratio);
+  EXPECT_FLOAT_EQ(fitted.Height(), band.Height());
+  EXPECT_LT(fitted.Width(), band.Width());
+  CRect dest;
+  ASSERT_TRUE(PlaceForArea(fitted, Fit(band, frame), W, H, FLAT, dest));
+  const double sy = static_cast<double>(dest.Height()) / H;
+  EXPECT_NEAR(static_cast<double>(dest.y1) + FLAT.y1 * sy, static_cast<double>(band.y1), 1.0);
+  EXPECT_NEAR(static_cast<double>(dest.y1) + FLAT.y2 * sy, static_cast<double>(band.y2), 1.0);
+}
