+// Kodi's place of a picture of the given shape in the view (CBaseRenderer::CalcDestRect() without
+// zoom, shift, pixel ratio or error allowed): as wide as fits, centred, on whole pixels
+static CRect Fit(const CRect& view, double ratio)
+{
+  const double vx = static_cast<double>(view.x1);
+  const double vy = static_cast<double>(view.y1);
+  const double vw = static_cast<double>(view.Width());
+  const double vh = static_cast<double>(view.Height());
+  double w = vw;
+  double h = w / ratio;
+  if (h > vh)
+  {
+    h = vh;
+    w = h * ratio;
+  }
+  const double x = std::round(vx + (vw - w) / 2);
+  const double y = std::round(vy + (vh - h) / 2);
+  return CRect(static_cast<float>(x), static_cast<float>(y), static_cast<float>(x + std::round(w)),
+               static_cast<float>(y + std::round(h)));
+}
