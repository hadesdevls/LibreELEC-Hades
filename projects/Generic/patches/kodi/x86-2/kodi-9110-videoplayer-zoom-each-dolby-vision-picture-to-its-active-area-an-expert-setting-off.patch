+ACTIVEAREA::Decision CRenderManager::ActiveAreaOf(const VideoPicture& picture)
+{
+#ifdef HAVE_DVBRIDGE
+  // Hades: the zoom to the active area of a Dolby Vision video (ActiveAreaZoom.h): nothing is read
+  // or changed with the setting off
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_HADESACTIVEAREAZOOM))
+  {
+    m_activeArea.Reset();
+    return {};
+  }
+  ACTIVEAREA::Picture p;
+  p.width = static_cast<int>(picture.iWidth);
+  p.height = static_cast<int>(picture.iHeight);
+  p.timed = picture.pts != DVD_NOPTS_VALUE;
+  p.seconds = p.timed ? picture.pts / DVD_TIME_BASE : 0.0;
+  // the metadata of the video's own, not those that Hades makes of HDR10 or HDR10+ (their level 5
+  // block is the picture's place, or what was measured of it)
+  if (picture.doviMeasured || picture.doviFromHdr10Plus || !picture.doviMetadata.Data())
+    p.noArea = "the video has no Dolby Vision metadata of its own";
+  else
+  {
+    int area[4] = {};
+    unsigned int offsets[4] = {};
+    bool cut = false;
+    p.noArea = dvbridge_l5_area(picture.doviMetadata.Data(), picture.doviMetadata.Size(), p.width,
+                                p.height, area, &cut, offsets);
+    p.sceneCut = cut;
+    p.area = {area[0], area[1], area[2], area[3]};
+    // (offsets that the measurement of native output found picture across, dvbridge_l5check.h: what
+    // they call bars is picture, and is not left out)
+    if (!p.noArea && CDVBridgeGLES::L5LeftAside(picture.doviVideo, offsets))
+      p.noArea = "a measurement found picture across the bars of the level 5 block";
+  }
+  return m_activeArea.Next(p);
+#else
+  return {};
+#endif
+}
