+namespace
+{
+// Hades: the last decision of IgnoreL5(), for L5LeftAside() (the player thread reads it)
+std::mutex g_l5AsideLock;
+bool g_l5Aside = false;
+unsigned int g_l5AsideVideo = 0;
+unsigned int g_l5AsideOffsets[4] = {};
+} // namespace
+
 void CDVBridgeGLES::IgnoreL5(unsigned int picture, const unsigned int offsets[4], const char* why)
 {
   m_l5Video = dvbridge_cm40_video_of(picture, g_cm40Video.load());
   std::copy(offsets, offsets + 4, m_l5Offsets);
   m_l5Why = why;
   dvbridge_render_ignore_l5(m_renderer, m_l5Video, m_l5Offsets, why);
+  // (Hades: for the zoom to the active area: left aside, or taken again where they are the ones)
+  std::lock_guard lock(g_l5AsideLock);
+  if (why)
+  {
+    g_l5Aside = true;
+    g_l5AsideVideo = picture;
+    std::copy(offsets, offsets + 4, g_l5AsideOffsets);
+  }
+  else if (g_l5Aside && g_l5AsideVideo == picture && std::equal(offsets, offsets + 4, g_l5AsideOffsets))
+    g_l5Aside = false;
+}
+
+bool CDVBridgeGLES::L5LeftAside(unsigned int video, const unsigned int offsets[4])
+{
+  std::lock_guard lock(g_l5AsideLock);
+  return g_l5Aside && g_l5AsideVideo == video && std::equal(offsets, offsets + 4, g_l5AsideOffsets);
 }
 
