From 340338e33880b23d0166626de6e31f9ea02a040a Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 22:54:29 +0000
Subject: [PATCH] DVDDemux: the counter of demuxer ids is atomic

Demuxers are made on the player's thread and, at the same time, on the
threads of the jobs of DVDFileInfo (thumbnails, stream details). The
counter that gives each its id was a plain static: two demuxers could
get the same id, and the streams looked up by demuxer id (the player's
and a subtitle file's) could be mixed up. It is a std::atomic now.

From matthane's change for CoreELEC (ce-canary/xbmc commit 9414798e63,
"DVDDemux: make the demuxer id counter atomic").
---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
index 04aa668..ef0607b 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
@@ -13,6 +13,7 @@
 #include "cores/VideoPlayer/FieldCadence.h"
 #include "utils/LanguageTag.h"
 
+#include <atomic>
 #include <chrono>
 #include <memory>
 #include <string>
@@ -463,7 +464,9 @@ protected:
 private:
   static int64_t NewGuid()
   {
-    static int64_t guid = 0;
+    // Hades: atomic, as demuxers are made on several threads at once (the player's, and the jobs
+    // of DVDFileInfo: thumbnails and stream details)
+    static std::atomic<int64_t> guid{0};
     return guid++;
   }
 
