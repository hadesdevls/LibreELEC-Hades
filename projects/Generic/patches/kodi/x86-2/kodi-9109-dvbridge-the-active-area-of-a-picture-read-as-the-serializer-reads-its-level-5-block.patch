diff --git a/tools/dvbridge/dvbridge_l5area.c b/tools/dvbridge/dvbridge_l5area.c
new file mode 100644
index 0000000..ddfc412
--- /dev/null
+++ b/tools/dvbridge/dvbridge_l5area.c
@@ -0,0 +1,71 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#include "dvbridge_l5area.h"
+
+#include "dvbridge_limits.h"
+#include "dvbridge_metadata.h"
+
+#include <math.h>
+#include <string.h>
+
+const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int height, int area[4],
+                             bool *scene, unsigned offsets[4])
+{
+    if (scene)
+        *scene = false;
+    const AVDOVIMetadata *m = metadata;
+    if (!m || !dvbridge_dv_readable(m, bytes))
+        return "the Dolby Vision metadata cannot be read";
+    if (scene)
+        *scene = av_dovi_get_color(m)->scene_refresh_flag != 0;
+    if (width < 2 || height < 2 || width > DVBRIDGE_SOURCE_MAX_WIDTH || height > DVBRIDGE_SOURCE_MAX_HEIGHT)
+        return "the picture is of a size the bridge does not take";
+    const AVDOVIDmData *l5 = NULL;
+    for (int i = 0; i < m->num_ext_blocks; i++) {
+        const AVDOVIDmData *e = av_dovi_get_ext(m, i);
+        if (e->level != 5)
+            continue;
+        if (l5)
+            return "the metadata have more than one level 5 block";
+        l5 = e;
+    }
+    if (!l5)
+        return "the metadata have no level 5 block";
+    if (offsets) {
+        offsets[0] = l5->l5.left_offset;
+        offsets[1] = l5->l5.right_offset;
+        offsets[2] = l5->l5.top_offset;
+        offsets[3] = l5->l5.bottom_offset;
+    }
+    /* The serializer's reading of the offsets, of the picture placed in the raster as native output places a
+     * picture drawn whole at its own shape: at its own size where it fits in 3840x2160, so that the margins are in
+     * its samples; a larger one (up to 4096x2304) scaled down to fit, its margins brought back to its samples. */
+    struct dvbridge_dv d;
+    memset(&d, 0, sizeof(d));
+    const double s = fmin(1.0, fmin(3840.0 / width, 2160.0 / height));
+    d.source_w = width;
+    d.source_h = height;
+    d.dest_w = s < 1.0 ? (int)fmin(3840.0, (double)lround(width * s)) : width;
+    d.dest_h = s < 1.0 ? (int)fmin(2160.0, (double)lround(height * s)) : height;
+    unsigned v[4];
+    if (!dvbridge_dv_margins(&d, l5->l5.left_offset, l5->l5.right_offset, l5->l5.top_offset,
+                             l5->l5.bottom_offset, v))
+        return d.refused ? d.refused : "the level 5 offsets fit no reading of the picture";
+    /* the margins less the place's own (the raster right of and below the place), in samples of the picture */
+    const double kx = (double)width / d.dest_w, ky = (double)height / d.dest_h;
+    const long left = lround(v[0] * kx), top = lround(v[2] * ky);
+    const long right = lround(((double)v[1] - (3840 - d.dest_w)) * kx);
+    const long bottom = lround(((double)v[3] - (2160 - d.dest_h)) * ky);
+    if (left < 0 || top < 0 || right < 0 || bottom < 0 || left + right >= width || top + bottom >= height)
+        return "the level 5 offsets leave no picture";
+    area[0] = (int)left;
+    area[1] = (int)top;
+    area[2] = width - (int)right;
+    area[3] = height - (int)bottom;
+    return NULL;
+}
diff --git a/tools/dvbridge/dvbridge_l5area.h b/tools/dvbridge/dvbridge_l5area.h
new file mode 100644
index 0000000..a373f0d
--- /dev/null
+++ b/tools/dvbridge/dvbridge_l5area.h
@@ -0,0 +1,38 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_L5AREA_H
+#define DVBRIDGE_L5AREA_H
+#include <stdbool.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Hades: the active area of a picture as its Dolby Vision metadata give it in their level 5 block, read as the
+ * serializer of native output reads that block (dvbridge_dv_margins() in dvbridge_metadata.h): as offsets of the
+ * picture, or as those of a 3840x2160 master that the picture was cropped or scaled from, each side taking the
+ * smaller of the two margins, so that a wrong reading can only leave a part of the bars in, never take picture out.
+ * For the zoom to the active area (Kodi: ActiveAreaZoom.h).
+ *
+ * metadata, bytes: the AVDOVIMetadata of the picture as FFmpeg gives it (checked by dvbridge_dv_readable() before
+ * anything is read); width, height: the picture's size in samples.
+ * Returns NULL, with area holding the active area (left, top, right, bottom, in samples of the picture, right and
+ * bottom excluded), or why there is none, a fixed text: the metadata cannot be read, the picture is of a size the
+ * bridge does not take, the metadata have no level 5 block or more than one (the serializer refuses such a frame),
+ * or the offsets fit no reading of the picture.
+ * scene (may be NULL): the RPU marks the picture as the first of a scene (scene_refresh_flag); false where the
+ * metadata cannot be read.
+ * offsets (may be NULL): the offsets of the level 5 block as the RPU gives them (left, right, top, bottom), where
+ * there is one block; else left as they are. */
+const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int height, int area[4],
+                             bool *scene, unsigned offsets[4]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
