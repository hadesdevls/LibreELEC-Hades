+//! Hades: asks where an address leads and what its server says it is (DetectDiscImage())
+class CTargetProbe : public IRunnable
+{
+public:
+  explicit CTargetProbe(std::string url) : m_url(std::move(url)) {}
+  void Run() override
+  {
+    XFILE::CCurlFile file;
+    m_ok = file.ProbeTarget(CURL(m_url), m_target, m_mimeType, m_fileName);
+  }
+
+  const std::string m_url;
+  bool m_ok{false};
+  std::string m_target;
+  std::string m_mimeType;
+  std::string m_fileName;
+};
+
+/*!
+ * \brief Hades: a disc image behind an address that does not say so.
+ *
+ * A streaming add-on gives Kodi the address of its resolver, often without the name of the file,
+ * which sends to the CDN of the service; and a CDN may give the file an address without an
+ * extension, telling what it is by its type (application/x-iso9660-image) or by the name in its
+ * Content-Disposition. Kodi takes a disc image by the extension of its address, everywhere: such an
+ * image was opened as a video file, which it is not, and did not play.
+ *
+ * An address of a web server whose extension says nothing of a video, sound or playlist, and whose
+ * type is not known (or is the generic one), is asked once where it leads and what it is (a HEAD,
+ * CCurlFile::ProbeTarget()). A disc image is played as a disc from the address it leads to (with
+ * the options of the add-on's address): the choices for a disc (its menu, the main title, the list
+ * of titles) then apply as for any other image. An address that leads to anything else is played as
+ * before; the stream factory takes what was asked here instead of asking again
+ * (CDVDFactoryInputStream).
+ */
+void DetectDiscImage(CFileItem& item)
+{
+  const std::string path{item.GetDynPath()};
+  if (!URIUtils::IsProtocol(path, "http") && !URIUtils::IsProtocol(path, "https"))
+    return;
+  if (item.IsDiscImage() || !item.ContentLookup() || item.IsPVR() || item.IsLiveTV() ||
+      MUSIC::IsAudio(item) || !item.GetProperty("inputstream").asString().empty())
+    return;
+  const auto& extensions = CServiceBroker::GetFileExtensionProvider();
+  if (URIUtils::HasExtension(path, extensions.GetVideoExtensions() + "|" +
+                                       extensions.GetMusicExtensions() +
+                                       "|.m3u8|.mpd|.ism|.strm|.m3u|.pls"))
+    return;
+  if (const std::string mime{item.GetMimeType()};
+      !mime.empty() && mime != "application/octet-stream" && mime != "binary/octet-stream" &&
+      !XFILE::CHttpSourceMemory::IsDiscImageMimeType(mime))
+    return;
+
+  const auto start = std::chrono::steady_clock::now();
+  CTargetProbe probe{path};
+  if (CServiceBroker::GetAppMessenger()->IsProcessThread())
+    CGUIDialogBusy::Wait(&probe, 100, false);
+  else
+    probe.Run();
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count();
+  if (!probe.m_ok)
+  {
+    CLog::Log(LOGINFO,
+              "CApplicationPlay: {} could not be asked where it leads ({} ms): the stream is "
+              "played as before",
+              XFILE::CHttpSourceMemory::ShortForLog(path), ms);
+    return;
+  }
+
+  const bool byAddress{URIUtils::HasExtension(probe.m_target, ".img|.iso|.nrg|.udf")};
+  const bool byType{XFILE::CHttpSourceMemory::IsDiscImageMimeType(probe.m_mimeType)};
+  const bool byName{!probe.m_fileName.empty() &&
+                    URIUtils::HasExtension(probe.m_fileName, ".img|.iso|.nrg|.udf")};
+  if (!byAddress && !byType && !byName)
+  {
+    CLog::Log(LOGINFO, "CApplicationPlay: {} leads to {} ({}; {} ms): not a disc image",
+              XFILE::CHttpSourceMemory::ShortForLog(path),
+              XFILE::CHttpSourceMemory::ShortForLog(probe.m_target),
+              probe.m_mimeType.empty() ? "no type" : probe.m_mimeType, ms);
+    return;
+  }
+
+  CURL target{probe.m_target};
+  target.SetProtocolOptions(CURL(path).GetProtocolOptions());
+  if (!byAddress)
+    XFILE::CHttpSourceMemory::RememberDiscImage(target.Get());
+  item.SetDynPath(target.Get());
+  if (!probe.m_mimeType.empty())
+    item.SetMimeType(probe.m_mimeType);
+  CLog::Log(
+      LOGINFO,
+      "CApplicationPlay: {} leads to a disc image, as {} says: {} ({} ms); it plays as a disc",
+      XFILE::CHttpSourceMemory::ShortForLog(path),
+      byAddress ? "the extension of the address it sends to"
+      : byType  ? fmt::format("the type its server gives it ({})", probe.m_mimeType)
+                : fmt::format("the name its server gives it ({})", probe.m_fileName),
+      XFILE::CHttpSourceMemory::ShortForLog(target.Get()), ms);
+}
