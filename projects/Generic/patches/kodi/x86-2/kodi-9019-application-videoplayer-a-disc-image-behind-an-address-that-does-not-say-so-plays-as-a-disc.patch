+bool CCurlFile::ProbeTarget(const CURL& url,
+                            std::string& target,
+                            std::string& mimeType,
+                            std::string& fileName)
+{
+  if (m_opened)
+    return false;
+
+  CURL url2(url);
+  ParseAndCorrectUrl(url2);
+  const std::string asked{m_url};
+
+  assert(m_state->m_easyHandle == NULL);
+  g_curlInterface.easy_acquire(url2.GetProtocol().c_str(), url2.GetHostName().c_str(),
+                               &m_state->m_easyHandle, NULL);
+
+  const long timeout =
+      CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_curlconnecttimeout;
+  SetCommonOptions(m_state);
+  SetRequestHeaders(m_state);
+  g_curlInterface.easy_setopt(m_state->m_easyHandle, CURLOPT_TIMEOUT, timeout);
+  g_curlInterface.easy_setopt(m_state->m_easyHandle, CURLOPT_NOBODY, 1);
+  CURLcode result = PerformWithTransientRetries(m_state->m_easyHandle, url, __FUNCTION__);
+
+  // A server that answers HEAD with nothing or an error (an address signed for GET only): a GET
+  // that stops at its first data, as Stat() does
+  if (result == CURLE_GOT_NOTHING || result == CURLE_HTTP_RETURNED_ERROR ||
+      result == CURLE_RECV_ERROR)
+  {
+    SetCommonOptions(m_state);
+    SetRequestHeaders(m_state);
+    g_curlInterface.easy_setopt(m_state->m_easyHandle, CURLOPT_TIMEOUT, timeout);
+    g_curlInterface.easy_setopt(m_state->m_easyHandle, CURLOPT_XFERINFOFUNCTION,
+                                transfer_abort_callback);
+    g_curlInterface.easy_setopt(m_state->m_easyHandle, CURLOPT_NOPROGRESS, 0);
+    result = PerformWithTransientRetries(m_state->m_easyHandle, url, __FUNCTION__);
+  }
+
+  const bool ok = result == CURLE_OK || result == CURLE_ABORTED_BY_CALLBACK;
+  if (ok)
+  {
+    target = GetInfoString(CURLINFO_EFFECTIVE_URL);
+    if (target.empty())
+      target = asked;
+    mimeType = m_state->m_httpheader.GetMimeType();
+    fileName = FileNameOfDisposition(m_state->m_httpheader.GetValue("content-disposition"));
+    if (CHttpSourceMemory::Key(target) != CHttpSourceMemory::Key(asked))
+      CHttpSourceMemory::RememberRedirect(asked, target, mimeType);
+  }
+  g_curlInterface.easy_release(&m_state->m_easyHandle, NULL);
+  return ok;
+}
+
+std::string CCurlFile::FileNameOfDisposition(const std::string& disposition)
+{
+  // attachment; filename="Name.iso"; filename*=UTF-8''Name%20.iso (RFC 6266: filename* first)
+  std::string lower{disposition};
+  StringUtils::ToLower(lower);
+  if (const size_t ext = lower.find("filename*="); ext != std::string::npos)
+  {
+    std::string value = disposition.substr(ext + 10);
+    if (const size_t end = value.find(';'); end != std::string::npos)
+      value.erase(end);
+    if (const size_t quotes = value.find("''"); quotes != std::string::npos)
+      value.erase(0, quotes + 2);
+    StringUtils::Trim(value);
+    return CURL::Decode(value);
+  }
+  if (const size_t plain = lower.find("filename="); plain != std::string::npos)
+  {
+    std::string value = disposition.substr(plain + 9);
+    if (!value.empty() && value[0] == '"')
+    {
+      const size_t end = value.find('"', 1);
+      return value.substr(1, end == std::string::npos ? std::string::npos : end - 1);
+    }
+    if (const size_t end = value.find(';'); end != std::string::npos)
+      value.erase(end);
+    StringUtils::Trim(value);
+    return value;
+  }
+  return {};
+}
