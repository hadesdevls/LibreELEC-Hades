+CEC_PICTURE::Verdict CPeripheralCecAdapter::JudgePicture(void)
+{
+  using namespace CEC_PICTURE;
+  m_pictureGeneration = KODI::UTILS::CDrivenOutput::Generation();
+  const KODI::UTILS::DrivenOutput picture = KODI::UTILS::CDrivenOutput::Get();
+  std::optional<AdapterConnector> adapter;
+  std::string adapterName;
+  std::string why;
+#if defined(TARGET_LINUX)
+  if (m_strComPort.starts_with("/dev/cec"))
+  {
+    const int fd = open(m_strComPort.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd >= 0)
+    {
+      struct cec_caps caps = {};
+      if (ioctl(fd, CEC_ADAP_G_CAPS, &caps) == 0)
+        adapterName.assign(caps.name, strnlen(caps.name, sizeof(caps.name)));
+      struct cec_connector_info info = {};
+      if (ioctl(fd, CEC_ADAP_G_CONNECTOR_INFO, &info) == 0 && info.type == CEC_CONNECTOR_TYPE_DRM)
+        adapter = AdapterConnector{info.drm.card_no, info.drm.connector_id};
+      else
+        why = "the kernel ties it to no connector of a graphics card";
+      close(fd);
+    }
+    else
+      why = "it could not be opened to ask";
+  }
+  else
+    why = "it is not a CEC adapter of the kernel";
+#else
+  why = "this system does not say which output a CEC adapter is on";
+#endif
+  if (why.empty() && !picture.Known())
+    why = "the output of Kodi's picture is not known yet";
+
+  const Verdict verdict = Decide(adapter, picture);
+  const std::string of =
+      adapter ? StringUtils::Format("connector {} of /dev/dri/card{}{}", adapter->connectorId,
+                                    adapter->card, adapterName.empty() ? "" : " (" + adapterName + ")")
+              : std::string();
+  const std::string pictureText =
+      picture.Known() ? StringUtils::Format("{} (connector {} of {})", picture.name,
+                                            picture.connectorId, picture.node)
+                      : std::string("not known");
+  std::string told;
+  if (verdict == Verdict::OTHER)
+    told = StringUtils::Format(
+        "CEC: the adapter {} is on {}, and Kodi's picture is on {}: through it, Kodi takes no input "
+        "of the TV (no <Active Source>, no <Image View On>, not at its start, at the start of a "
+        "video, or at a routing change to it), whatever \"Switch source to this device on startup\" "
+        "and \"Devices to power on during startup\" say; the remote and the rest are as before",
+        m_strComPort, of, pictureText);
+  else if (verdict == Verdict::PICTURE)
+    told = StringUtils::Format("CEC: the adapter {} is on the output with Kodi's picture ({}): as "
+                               "its settings say",
+                               m_strComPort, pictureText);
+  else
+    told = StringUtils::Format("CEC: whether the adapter {} is on the output with Kodi's picture is "
+                               "not known ({}): as its settings say",
+                               m_strComPort, why);
+  if (told != m_pictureTold)
+  {
+    m_pictureTold = told;
+    CLog::Log(LOGINFO, "{}", told);
+  }
+  return verdict;
+}
+
+void CPeripheralCecAdapter::ProcessPictureChange(void)
+{
+  if (KODI::UTILS::CDrivenOutput::Generation() == m_pictureGeneration)
+    return;
+  const CEC_PICTURE::Verdict before = m_picture;
+  // (judged again by SetConfigurationFromSettings(), only when it changes: the configuration that
+  // libCEC has is made again as for a change of the settings, OnSettingChanged())
+  if (JudgePicture() == before)
+    return;
+  SetConfigurationFromSettings();
+  if (m_queryThread && m_queryThread->IsRunning())
+    m_queryThread->UpdateConfiguration(&m_configuration);
 }
 
