--- /dev/null
+++ b/xbmc/peripherals/test/TestPeripheralCecPicture.cpp
@@ -0,0 +1,80 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "peripherals/devices/PeripheralCecPicture.h"
+
+#include <optional>
+
+#include <gtest/gtest.h>
+
+using namespace PERIPHERALS::CEC_PICTURE;
+using KODI::UTILS::DrivenOutput;
+
+namespace
+{
+// The PC of issue #24: the picture on HDMI-A-3 of the RTX 3050 (card1), the AV receiver on DP-1 of
+// i915 (card0), whose CEC the kernel tunnels over DP-AUX. The DRM ids are made up: the report does
+// not have them.
+const DrivenOutput PICTURE{"/dev/dri/card1", 120, "HDMI-A-3"};
+const AdapterConnector RECEIVER{0, 95};
+} // namespace
+
+TEST(TestPeripheralCecPicture, TheCardOfANode)
+{
+  EXPECT_TRUE(CardOfNode("/dev/dri/card0") == 0u);
+  EXPECT_TRUE(CardOfNode("/dev/dri/card12") == 12u);
+  EXPECT_FALSE(CardOfNode("/dev/dri/renderD128"));
+  EXPECT_FALSE(CardOfNode("/dev/dri/card"));
+  EXPECT_FALSE(CardOfNode("/dev/dri/card1x"));
+  EXPECT_FALSE(CardOfNode("card1"));
+  EXPECT_FALSE(CardOfNode(""));
+}
+
+TEST(TestPeripheralCecPicture, TheReceiverOfIssue24IsAnotherOutput)
+{
+  EXPECT_EQ(Verdict::OTHER, Decide(RECEIVER, PICTURE));
+  // the same connector id on another card is another connector
+  EXPECT_EQ(Verdict::OTHER, Decide(AdapterConnector{0, 120}, PICTURE));
+  // the same card, another connector
+  EXPECT_EQ(Verdict::OTHER, Decide(AdapterConnector{1, 95}, PICTURE));
+}
+
+TEST(TestPeripheralCecPicture, TheAdapterOfThePicture)
+{
+  EXPECT_EQ(Verdict::PICTURE, Decide(AdapterConnector{1, 120}, PICTURE));
+}
+
+TEST(TestPeripheralCecPicture, NotKnownIsAsBefore)
+{
+  // no connector from the kernel (a Pulse-Eight, CEC hardware tied to no DRM connector)
+  EXPECT_EQ(Verdict::UNKNOWN, Decide(std::nullopt, PICTURE));
+  // the picture not known yet, or a node that is no card
+  EXPECT_EQ(Verdict::UNKNOWN, Decide(RECEIVER, DrivenOutput{}));
+  EXPECT_EQ(Verdict::UNKNOWN, Decide(RECEIVER, DrivenOutput{"/dev/dri/card1", 0, "HDMI-A-3"}));
+  EXPECT_EQ(Verdict::UNKNOWN, Decide(RECEIVER, DrivenOutput{"/dev/dri/renderD128", 120, "x"}));
+}
+
+TEST(TestPeripheralCecPicture, WhatTheAdapterIsConfiguredWith)
+{
+  const TvInput user{true, true};
+  // another output: neither, whatever the settings say
+  const TvInput other = ConfiguredTvInput(Verdict::OTHER, user);
+  EXPECT_FALSE(other.activateSource);
+  EXPECT_FALSE(other.wakeTv);
+  // the picture's, or not known: the settings
+  for (const Verdict v : {Verdict::PICTURE, Verdict::UNKNOWN})
+  {
+    for (const TvInput settings : {TvInput{true, true}, TvInput{false, true}, TvInput{true, false},
+                                   TvInput{false, false}})
+    {
+      const TvInput configured = ConfiguredTvInput(v, settings);
+      EXPECT_EQ(settings.activateSource, configured.activateSource);
+      EXPECT_EQ(settings.wakeTv, configured.wakeTv);
+    }
+  }
+}
