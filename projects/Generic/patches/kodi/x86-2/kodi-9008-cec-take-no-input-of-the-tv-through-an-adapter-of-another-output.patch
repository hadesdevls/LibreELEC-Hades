+
+#pragma once
+
+#include "utils/DisplayIdentity.h"
+
+#include <charconv>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+/*!
+ * Hades: whether a CEC adapter of the kernel is on the output that carries Kodi's picture.
+ *
+ * An HDMI or DisplayPort output that carries only the sound (an AV receiver on the HDMI port of the
+ * board, through a DP to HDMI converter whose CEC the kernel tunnels over DP-AUX, while the picture
+ * goes to the TV from another graphics card) has a CEC adapter of its own. Through it Kodi made
+ * itself the active source (<Active Source>) and woke the TV (<Image View On>) at its start, at the
+ * start of each video and at a routing change to it: the receiver switched to the PC, and the TV
+ * switched to the receiver's input, away from Kodi's picture (issue #24). Through such an adapter
+ * Kodi takes no input of the TV now; the keys of the remote, the volume of an amplifier and the
+ * standby commands work as before. An adapter whose output is not known (a Pulse-Eight on USB,
+ * CEC hardware that the kernel ties to no DRM connector, a kernel that does not say, the output of
+ * the picture not known yet) is as before.
+ *
+ * The kernel says which DRM connector an adapter is of (CEC_ADAP_G_CONNECTOR_INFO: the number of
+ * the card, the DRM id of the connector; drm_dp_cec.c fills it for a DP-AUX adapter), and the
+ * windowing system which output has the picture (KODI::UTILS::CDrivenOutput: the node of its card
+ * and the id of its connector).
+ */
+namespace PERIPHERALS::CEC_PICTURE
+{
+//! The DRM connector of a CEC adapter of the kernel (struct cec_drm_connector_info)
+struct AdapterConnector
+{
+  uint32_t card{0}; //!< the number of its card, N of /dev/dri/cardN
+  uint32_t connectorId{0}; //!< the DRM id of its connector
+};
+
+enum class Verdict
+{
+  PICTURE, //!< on the output with Kodi's picture: as its settings say
+  OTHER, //!< on another output: Kodi takes no input of the TV through it
+  UNKNOWN, //!< not known: as its settings say
+};
+
+//! The number of a card node ("/dev/dri/card1": 1); none for any other name
+inline std::optional<uint32_t> CardOfNode(const std::string& node)
+{
+  static constexpr std::string_view prefix = "/dev/dri/card";
+  if (node.size() <= prefix.size() || node.compare(0, prefix.size(), prefix) != 0)
+    return std::nullopt;
+  uint32_t card = 0;
+  const char* first = node.data() + prefix.size();
+  const char* last = node.data() + node.size();
+  const auto [end, error] = std::from_chars(first, last, card);
+  if (error != std::errc() || end != last)
+    return std::nullopt;
+  return card;
+}
+
+/*!
+ * \brief Whether a CEC adapter is on the output with Kodi's picture
+ * \param adapter its DRM connector; none: not known (not an adapter of the kernel, or one that the
+ *        kernel ties to no DRM connector)
+ * \param picture the output with Kodi's picture (KODI::UTILS::CDrivenOutput)
+ */
+inline Verdict Decide(const std::optional<AdapterConnector>& adapter,
+                      const KODI::UTILS::DrivenOutput& picture)
+{
+  if (!adapter || !picture.Known())
+    return Verdict::UNKNOWN;
+  const std::optional<uint32_t> card = CardOfNode(picture.node);
+  if (!card)
+    return Verdict::UNKNOWN;
+  return adapter->card == *card && adapter->connectorId == picture.connectorId ? Verdict::PICTURE
+                                                                               : Verdict::OTHER;
+}
+
+//! What the adapter is configured with: through an adapter of another output, no activation of
+//! the source and no waking of the TV (libCEC sends <Image View On> to wake it, and libcec-9015 of
+//! Hades takes a TV that is not to be woken as one whose input is not taken on a routing change
+//! either); else what the user's settings say
+struct TvInput
+{
+  bool activateSource{false};
+  bool wakeTv{false};
+};
+inline TvInput ConfiguredTvInput(Verdict verdict, const TvInput& settings)
+{
+  return verdict == Verdict::OTHER ? TvInput{} : settings;
+}
+} // namespace PERIPHERALS::CEC_PICTURE
