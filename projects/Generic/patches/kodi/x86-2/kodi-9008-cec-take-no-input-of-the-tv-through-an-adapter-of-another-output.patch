+
+//! Hades: the output that Kodi shows its picture on: the node of its graphics device and the DRM id
+//! of its connector (CDrivenOutput)
+struct DrivenOutput
+{
+  std::string node; //!< "/dev/dri/card1"; empty: not known
+  uint32_t connectorId{0}; //!< 0: not known
+  std::string name; //!< "HDMI-A-3", for the log
+
+  bool Known() const { return !node.empty() && connectorId != 0; }
+  bool operator==(const DrivenOutput&) const = default;
+};
+
+/*!
+ * \brief Hades: the output that Kodi shows its picture on, as the windowing system last said it
+ *        (with CDrivenDisplay), for what needs to know whether a device of its own is on that
+ *        output: the CEC adapter of a connector (PERIPHERALS::CEC_PICTURE), on its own thread
+ */
+class CDrivenOutput
+{
+public:
+  static void Set(const DrivenOutput& output)
+  {
+    std::unique_lock lock(Lock());
+    if (Value().generation.load() != 0 && Value().output == output)
+      return;
+    Value().output = output;
+    Value().generation.fetch_add(1);
+  }
+
+  static DrivenOutput Get()
+  {
+    std::unique_lock lock(Lock());
+    return Value().output;
+  }
+
+  //! Goes up each time that the output changes; 0 while nothing was said (no lock is taken)
+  static uint64_t Generation() { return Value().generation.load(); }
+
+private:
+  struct State
+  {
+    std::atomic<uint64_t> generation{0};
+    DrivenOutput output;
+  };
+  static std::mutex& Lock()
+  {
+    static std::mutex lock;
+    return lock;
+  }
+  static State& Value()
+  {
+    static State value;
+    return value;
+  }
+};
