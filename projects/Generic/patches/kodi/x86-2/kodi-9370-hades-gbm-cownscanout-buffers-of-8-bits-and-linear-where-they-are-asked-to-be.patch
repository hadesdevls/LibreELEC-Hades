 xbmc/windowing/gbm/OwnScanout.cpp             | 108 ++++++++++++++----
 xbmc/windowing/gbm/OwnScanout.h               |  37 ++++--
 xbmc/windowing/gbm/WinSystemGbmEGLContext.cpp |   5 +-
 3 files changed, 112 insertions(+), 38 deletions(-)

diff --git a/xbmc/windowing/gbm/OwnScanout.cpp b/xbmc/windowing/gbm/OwnScanout.cpp
index f0072ed..a8e3ddf 100644
--- a/xbmc/windowing/gbm/OwnScanout.cpp
+++ b/xbmc/windowing/gbm/OwnScanout.cpp
@@ -56,6 +56,23 @@ constexpr float PROBE_FLOATS[4][3] = {{0.0009765625f, 0.5009765625f, 0.250244140
                                       {0.75048828125f, 0.99951171875f, 0.0009765625f},
                                       {0.25024414062f, 0.0009765625f, 0.99951171875f},
                                       {0.5009765625f, 0.75048828125f, 0.5009765625f}};
+// 8-bit codes, distinct per component, for the buffers of 8 bits of a frame-packed mode: each one
+// comes back as it was written, or the buffer is not one that Kodi can draw into and read
+constexpr unsigned int PROBE_BYTES[4][3] = {
+    {1, 2, 3}, {128, 129, 254}, {254, 1, 128}, {3, 254, 129}};
+
+// The clear colour of a probe pixel, in the depth of the buffer
+void ProbeColour(int pixel, int bits)
+{
+  if (bits == 16)
+    glClearColor(PROBE_FLOATS[pixel][0], PROBE_FLOATS[pixel][1], PROBE_FLOATS[pixel][2], 1.0f);
+  else if (bits == 8)
+    glClearColor(PROBE_BYTES[pixel][0] / 255.0f, PROBE_BYTES[pixel][1] / 255.0f,
+                 PROBE_BYTES[pixel][2] / 255.0f, 1.0f);
+  else
+    glClearColor(PROBE_CODES[pixel][0] / 1023.0f, PROBE_CODES[pixel][1] / 1023.0f,
+                 PROBE_CODES[pixel][2] / 1023.0f, 1.0f);
+}
 
 float HalfToFloat(uint16_t half)
 {
@@ -79,6 +96,12 @@ int COwnScanout::Bits(uint32_t format)
 {
   switch (format)
   {
+    // (Hades: the buffers of a frame-packed mode of nvidia-drm, of the format of the window)
+    case DRM_FORMAT_ARGB8888:
+    case DRM_FORMAT_XRGB8888:
+    case DRM_FORMAT_ABGR8888:
+    case DRM_FORMAT_XBGR8888:
+      return 8;
     case DRM_FORMAT_ABGR2101010:
     case DRM_FORMAT_XBGR2101010:
     case DRM_FORMAT_ARGB2101010:
@@ -226,13 +249,10 @@ void COwnScanout::FlipBlit(unsigned int source, unsigned int target, int width,
     glEnable(GL_SCISSOR_TEST);
 }
 
-bool COwnScanout::FlipProbe(unsigned int frame,
-                            unsigned int target,
-                            int width,
-                            int height,
-                            bool floating,
-                            std::string& failed)
+bool COwnScanout::FlipProbe(
+    unsigned int frame, unsigned int target, int width, int height, int bits, std::string& failed)
 {
+  const bool floating = bits == 16;
   GLint draw = 0, read = 0, box[4]{}, packAlignment = 4, packBuffer = 0;
   GLfloat clear[4]{};
   GLboolean mask[4]{};
@@ -263,11 +283,7 @@ bool COwnScanout::FlipProbe(unsigned int frame,
   for (int pixel = 0; pixel < 4; ++pixel)
   {
     glScissor(pixel, 0, 1, 1);
-    if (floating)
-      glClearColor(PROBE_FLOATS[pixel][0], PROBE_FLOATS[pixel][1], PROBE_FLOATS[pixel][2], 1.0f);
-    else
-      glClearColor(PROBE_CODES[pixel][0] / 1023.0f, PROBE_CODES[pixel][1] / 1023.0f,
-                   PROBE_CODES[pixel][2] / 1023.0f, 1.0f);
+    ProbeColour(pixel, bits);
     glClear(GL_COLOR_BUFFER_BIT);
   }
   glDisable(GL_SCISSOR_TEST);
@@ -322,6 +338,22 @@ bool COwnScanout::FlipProbe(unsigned int frame,
           expected[c] = pass == 0 ? static_cast<double>(PROBE_FLOATS[pixel][c]) : 0.0;
         }
       }
+      else if (bits == 8)
+      {
+        uint8_t bytes[4]{};
+        glReadPixels(pixel, row, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, bytes);
+        if (glGetError() != GL_NO_ERROR)
+        {
+          failed = "the buffer cannot be read back as 8-bit values";
+          same = false;
+          break;
+        }
+        for (int c = 0; c < 3; ++c)
+        {
+          value[c] = static_cast<double>(bytes[c]);
+          expected[c] = pass == 0 ? PROBE_BYTES[pixel][c] : 0.0;
+        }
+      }
       else
       {
         GLuint packed = 0;
@@ -369,8 +401,9 @@ bool COwnScanout::FlipProbe(unsigned int frame,
   return same;
 }
 
-bool COwnScanout::Probe(unsigned int framebuffer, bool floating, std::string& failed)
+bool COwnScanout::Probe(unsigned int framebuffer, int bits, std::string& failed)
 {
+  const bool floating = bits == 16;
   GLint draw = 0, read = 0, box[4]{}, packAlignment = 4, packBuffer = 0;
   GLfloat clear[4]{};
   GLboolean mask[4]{};
@@ -397,11 +430,7 @@ bool COwnScanout::Probe(unsigned int framebuffer, bool floating, std::string& fa
   for (int pixel = 0; pixel < 4; ++pixel)
   {
     glScissor(pixel, 0, 1, 1);
-    if (floating)
-      glClearColor(PROBE_FLOATS[pixel][0], PROBE_FLOATS[pixel][1], PROBE_FLOATS[pixel][2], 1.0f);
-    else
-      glClearColor(PROBE_CODES[pixel][0] / 1023.0f, PROBE_CODES[pixel][1] / 1023.0f,
-                   PROBE_CODES[pixel][2] / 1023.0f, 1.0f);
+    ProbeColour(pixel, bits);
     glClear(GL_COLOR_BUFFER_BIT);
   }
 
@@ -444,6 +473,29 @@ bool COwnScanout::Probe(unsigned int framebuffer, bool floating, std::string& fa
           break;
         }
   }
+  else if (bits == 8)
+  {
+    uint8_t bytes[16]{};
+    glReadPixels(0, 0, 4, 1, GL_RGBA, GL_UNSIGNED_BYTE, bytes);
+    if (glGetError() != GL_NO_ERROR)
+    {
+      failed = "the buffer cannot be read back";
+      same = false;
+    }
+    for (int pixel = 0; same && pixel < 4; ++pixel)
+      for (int c = 0; c < 3; ++c)
+        if (bytes[pixel * 4 + c] != PROBE_BYTES[pixel][c])
+        {
+          snprintf(text, sizeof(text),
+                   "an 8-bit value did not come back as it was written (%u for %u, pixel %d "
+                   "component %d; %d bits of red)",
+                   static_cast<unsigned int>(bytes[pixel * 4 + c]), PROBE_BYTES[pixel][c], pixel, c,
+                   redBits);
+          failed = text;
+          same = false;
+          break;
+        }
+  }
   else
   {
     unsigned int codes[4][3]{};
@@ -509,13 +561,15 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
                                                  uint32_t format,
                                                  const std::vector<uint64_t>& modifiers,
                                                  bool flipOnGpu,
+                                                 bool linear,
                                                  std::string& failed)
 {
   if (!Supported(format))
   {
-    failed = "the format " + FourCC(format) + " is not one of 10 bits or of half floats";
+    failed = "the format " + FourCC(format) + " is not one of 8 or 10 bits or of half floats";
     return nullptr;
   }
+  const int bits = Bits(format);
   std::shared_ptr<COwnScanout> own(new COwnScanout());
   own->m_display = display;
   own->m_width = width;
@@ -532,9 +586,12 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
                                                 static_cast<unsigned int>(modifiers.size()),
                                                 GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
 #endif
+    // (Hades: buffers whose lines have to lie one after another, a frame-packed mode of
+    // nvidia-drm, say so where they are made without modifiers)
     if (!buffer.bo)
       buffer.bo = gbm_bo_create(device, width, height, format,
-                                GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+                                GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING |
+                                    (linear ? static_cast<uint32_t>(GBM_BO_USE_LINEAR) : 0u));
     if (!buffer.bo)
     {
       failed = "GBM could not allocate a " + std::to_string(width) + "x" + std::to_string(height) +
@@ -586,14 +643,13 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
       return nullptr;
     if (!MakeTarget(buffer.image, buffer.renderbuffer, buffer.framebuffer, failed))
       return nullptr;
-    if (!Probe(buffer.framebuffer, IsFloat(format), failed))
+    if (!Probe(buffer.framebuffer, bits, failed))
       return nullptr;
   }
 
   if (flipOnGpu)
   {
-    // Where the frame is drawn, upright, in the format of the buffers (RGB10_A2 or RGBA16F)
-    const bool floating = IsFloat(format);
+    // Where the frame is drawn, upright, in the format of the buffers (RGBA8, RGB10_A2 or RGBA16F)
     GLint previousFramebuffer = 0, previousRenderbuffer = 0;
     glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previousFramebuffer);
     glGetIntegerv(GL_RENDERBUFFER_BINDING, &previousRenderbuffer);
@@ -603,7 +659,9 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
     GLuint rb = 0, fb = 0;
     glGenRenderbuffers(1, &rb);
     glBindRenderbuffer(GL_RENDERBUFFER, rb);
-    glRenderbufferStorage(GL_RENDERBUFFER, floating ? GL_RGBA16F : GL_RGB10_A2, width, height);
+    glRenderbufferStorage(GL_RENDERBUFFER,
+                          bits == 16 ? GL_RGBA16F : (bits == 8 ? GL_RGBA8 : GL_RGB10_A2), width,
+                          height);
     const GLenum storageError = glGetError();
     glGenFramebuffers(1, &fb);
     glBindFramebuffer(GL_FRAMEBUFFER, fb);
@@ -625,9 +683,9 @@ std::shared_ptr<COwnScanout> COwnScanout::Create(gbm_device* device,
     }
     own->m_frameRenderbuffer = rb;
     own->m_frameFramebuffer = fb;
-    if (!Probe(fb, floating, failed))
+    if (!Probe(fb, bits, failed))
       return nullptr;
-    if (!FlipProbe(fb, own->m_buffers.front().framebuffer, width, height, floating, failed))
+    if (!FlipProbe(fb, own->m_buffers.front().framebuffer, width, height, bits, failed))
       return nullptr;
   }
   return own;
diff --git a/xbmc/windowing/gbm/OwnScanout.h b/xbmc/windowing/gbm/OwnScanout.h
index 68b7488..f2f304e 100644
--- a/xbmc/windowing/gbm/OwnScanout.h
+++ b/xbmc/windowing/gbm/OwnScanout.h
@@ -171,6 +171,10 @@ struct OwnDmaBuf
  * into a framebuffer object of the same format that stands for the window, and the GPU flips it
  * into the buffer that goes to the screen when the frame is swapped (flipOnGpu: one blit of the
  * picture, which copies each value as it is).
+ *
+ * The same, of 8 bits, for an HDMI 3D frame-packed mode of nvidia-drm where the driver refuses the
+ * window's buffer (FramePackedOwn.h): buffers of the format of the window, with their lines one
+ * after another (linear), flipped by the GPU (the plane of such a mode takes no rotation).
  */
 class COwnScanout : public IOwnBuffers
 {
@@ -187,6 +191,9 @@ public:
    * \param modifiers those the plane takes for the format (none: linear, or the driver's choice)
    * \param flipOnGpu the frames are drawn upright into a framebuffer object of their own and
    * flipped into the buffers by the GPU (Swap()), checked before use with the rest (FlipProbe())
+   * \param linear (Hades) the lines of each buffer have to lie one after another: where GBM makes
+   * them without modifiers it is told so (GBM_BO_USE_LINEAR); modifiers then holds
+   * DRM_FORMAT_MOD_LINEAR alone
    * \param[out] failed which step failed, in plain words
    * \return nullptr when a step failed; nothing is left of what was made
    */
@@ -197,11 +204,12 @@ public:
                                              uint32_t format,
                                              const std::vector<uint64_t>& modifiers,
                                              bool flipOnGpu,
+                                             bool linear,
                                              std::string& failed);
 
-  //! The format is one these buffers can be made of (10-bit or half-float RGB)
+  //! The format is one these buffers can be made of (8-bit, 10-bit or half-float RGB)
   static bool Supported(uint32_t format);
-  //! Bits of each component of the format (10, or 16 for half floats; 0 when not Supported())
+  //! Bits of each component of the format (8, 10, or 16 for half floats; 0 when not Supported())
   static int Bits(uint32_t format);
   static bool IsFloat(uint32_t format);
 
@@ -211,20 +219,21 @@ public:
   //! \brief A renderbuffer of the image and a framebuffer object with it; complete, or nothing
   static bool MakeTarget(EGLImageKHR image, unsigned int& renderbuffer, unsigned int& framebuffer,
                          std::string& failed);
-  //! \brief Four pixels of the framebuffer cleared to values that 8 bits cannot hold, read back:
-  //! the same values, or the step that failed. The framebuffer is then cleared to black. The GL
-  //! state that it touches is put back.
-  static bool Probe(unsigned int framebuffer, bool floating, std::string& failed);
+  //! \brief Four pixels of the framebuffer cleared to values that 8 bits cannot hold (of a
+  //! buffer of \p bits 10 or 16; of 8 bits, to 8-bit values), read back: the same values, or the
+  //! step that failed. The framebuffer is then cleared to black. The GL state that it touches is
+  //! put back.
+  static bool Probe(unsigned int framebuffer, int bits, std::string& failed);
   //! \brief The flip of the GPU: four pixels of the bottom row of \p frame, cleared to values that
-  //! 8 bits cannot hold, are blitted flipped into \p target (both width x height, of the same
-  //! format) and read back from its top row, where they have to be the same values, with the
-  //! bottom row of \p target still black (a copy that did not flip fails). \p target is then
-  //! cleared to black. The GL state that it touches is put back.
+  //! 8 bits cannot hold (8-bit values in buffers of \p bits 8), are blitted flipped into \p target
+  //! (both width x height, of the same format) and read back from its top row, where they have
+  //! to be the same values, with the bottom row of \p target still black (a copy that did not
+  //! flip fails). \p target is then cleared to black. The GL state that it touches is put back.
   static bool FlipProbe(unsigned int frame,
                         unsigned int target,
                         int width,
                         int height,
-                        bool floating,
+                        int bits,
                         std::string& failed);
   //! \brief The whole of \p source blitted, flipped from top to bottom, into \p target (the
   //! scissor test is off for it, and put back)
@@ -249,6 +258,12 @@ public:
 
   //! The first buffer, for the driver's test before anything is shown through these
   gbm_bo* FirstBuffer() const { return m_buffers.empty() ? nullptr : m_buffers.front().bo; }
+  //! (Hades) each of the buffers, for the driver's test of each before anything is shown through
+  //! them; nullptr past the last
+  gbm_bo* BufferAt(unsigned int index) const
+  {
+    return index < m_buffers.size() ? m_buffers[index].bo : nullptr;
+  }
   uint32_t Format() const { return m_format; }
   uint64_t Modifier() const { return m_modifier; }
   int OutputBits() const { return Bits(m_format); }
