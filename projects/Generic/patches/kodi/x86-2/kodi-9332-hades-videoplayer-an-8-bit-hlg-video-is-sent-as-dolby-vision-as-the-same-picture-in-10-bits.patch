+      "picture{}. This changes the picture on purpose",
+      streamIdx, eightBits ? 8 : 10,
+      eightBits ? " (its 8-bit picture given to the conversion as the same picture in 10 bits, "
+                  "each code v as v << 2)"
+                : "");
   m_dvPromoted[streamIdx] = record;
