+#ifdef HAVE_DVBRIDGE
+// Hades: an 8-bit picture of HLG sent as Dolby Vision given to the bridge as the same picture in 10
+// bits (dvbridge_gl_widen.h), once a picture: by the measurement ahead of its drawing, or by its drawing
+bool CRendererVAAPIGLES::WidenForBridge(int idx, CDVBridgeGLES::Layer& layer)
+{
+  if (layer.layout != DVBRIDGE_NV12 ||
+      m_buffers[idx].doviBaseTransfer != DVBRIDGE::BASE_LAYER_HLG_TO_PQ)
+    return true;
+  dvbridge_gl_plane widened[3]{};
+  auto& kept = m_dvWidened[idx];
+  if (m_dvWidenedNow[idx])
+  {
+    // (the picture of this buffer was widened already: by the measurement, ahead of its drawing)
+    for (int p = 0; p < 2; ++p)
+      widened[p] = {kept.textures[p], kept.widths[p], kept.heights[p]};
+  }
+  else if (!dvbridge_gl_widen_nv12(&m_dvWiden, &kept, layer.width, layer.height, layer.planes,
+                                   widened))
+  {
+    if (!m_dvWidenTold)
+      CLog::Log(LOGWARNING,
+                "DVBridge: an 8-bit HLG picture could not be given to the bridge as the "
+                "same picture in 10 bits (the pass that widens it failed): it is not "
+                "drawn as Dolby Vision");
+    m_dvWidenTold = true;
+    return false;
+  }
+  if (!m_dvWidenTold)
+    CLog::Log(LOGINFO, "DVBridge: the 8-bit pictures of this HLG video are given to the bridge as "
+                       "the same pictures in 10 bits (each code v as v << 2): the conversion to PQ "
+                       "and the measurement are those of 10-bit HLG");
+  m_dvWidenTold = true;
+  m_dvWidenedNow[idx] = true;
+  layer.layout = DVBRIDGE_P010;
+  for (int p = 0; p < 3; ++p)
+    layer.planes[p] = widened[p];
+  return true;
+}
