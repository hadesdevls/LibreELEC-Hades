From 4cc3f32119cdfa09ce46881a79f2a4b8ada4faaa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20H=C3=A4rer?= <markus.haerer@gmx.net>
Date: Sat, 7 Nov 2026 02:09:33 +0100
Subject: [PATCH] [dialogs] Process the select dialog list when toggling an
 item

With smart redraw, toggling an item of a multi-select list didn't mark
anything dirty, so the item layouts only showed the new selection once
the cursor moved.

(cherry picked from commit b6988838eeb9409e78d41698ba5d9841027d0354)
(cherry picked from commit 407ddc3143b659caad0c228f285189766f9c3fae)
---
 xbmc/dialogs/GUIDialogSelect.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/xbmc/dialogs/GUIDialogSelect.cpp b/xbmc/dialogs/GUIDialogSelect.cpp
index 6fea1ed..e03d928 100644
--- a/xbmc/dialogs/GUIDialogSelect.cpp
+++ b/xbmc/dialogs/GUIDialogSelect.cpp
@@ -100,7 +100,12 @@ bool CGUIDialogSelect::OnMessage(CGUIMessage& message)
           {
             CFileItemPtr item(m_vecList->Get(iSelected));
             if (m_multiSelection)
+            {
               item->Select(!item->IsSelected());
+              // the item layouts only pick up the changed selection when processed
+              if (CGUIControl* list = GetControl(m_viewControl.GetCurrentControl()))
+                list->MarkDirtyRegion(DIRTY_STATE_CHILD);
+            }
             else
             {
               for (int i = 0 ; i < m_vecList->Size() ; i++)
-- 
