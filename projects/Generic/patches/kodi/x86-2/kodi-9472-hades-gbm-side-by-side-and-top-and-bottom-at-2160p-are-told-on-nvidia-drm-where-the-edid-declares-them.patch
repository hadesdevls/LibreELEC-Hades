From 6da919bdb29835c70f1fda32add940e2da32a096 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 05:20:42 +0000
Subject: [PATCH] [Hades][GBM] Side by side and top and bottom at 2160p are
 told on nvidia-drm where the EDID declares them

nvidia-drm lists no 3D modes: Kodi reads what the display's EDID says of
3D (its HDMI vendor block) and tells a half layout through the HDMI
vendor InfoFrame (NV_HDMI_VSIF_METADATA). It named the formats of a mode
only for 720p and 1080p (STEREO::VicOf()), so a display whose EDID
declares side by side or top and bottom at 3840x2160 was never told of
it at 2160p on a GeForce, and had to be switched to 3D by hand. The
EDID's 3D_Structure_ALL and 3D_MASK cover its first sixteen video
formats, whatever they are, and its 2D_VIC_order entries point at any of
them; the kernel makes 3D modes of a 2160p format named so as of any
other (drm_edid.c, add_3d_struct_modes()), which i915 and amdgpu list.

- VicOf() names 3840x2160 (formats 93 to 97) and 4096x2160 (98 to 102)
  at 24, 25, 30, 50 and 60 Hz, and at 1000/1001 of the video rates.
- On nvidia-drm a half layout is told at 2160p at 50 and 60 Hz where
  the EDID declares it there. Not at 24 to 30 Hz: HDMI has a format
  number of its own for those modes, which the driver sends in its own
  vendor InfoFrame with no CTA-861 number in the AVI InfoFrame, and a
  3D layout is told in its place only with the CTA-861 number in the
  AVI InfoFrame (the kernel's drm_mode_hdmi_vic()), which nvidia-drm
  takes from no one. The commit already left such modes untold
  (NextInfoFrameStep(): driverTells); now they are not offered either.
- kodi.log says what the EDID declares where the driver lists no 3D
  modes: "the half layouts are told by the HDMI vendor InfoFrame where
  the EDID declares them (not at 2160p at 24 to 30 Hz ...): it declares
  top-and-bottom at 1920x1080@60; side-by-side (half) at 1920x1080@60,
  3840x2160@60", or "none".
---
 xbmc/windowing/gbm/WinSystemGbm.cpp | 17 +++++-
 xbmc/windowing/gbm/drm/DRMStereo.h  | 87 ++++++++++++++++++++++++++---
 2 files changed, 93 insertions(+), 11 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 72484e7..b6f67b2 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -509,14 +509,18 @@ void CWinSystemGbm::MakeResolutions(const RESOLUTION_INFO* desktop)
   if (stereoDisplay)
   {
     std::string declared;
+    std::string edidDeclares;
     {
       std::unique_lock lock(m_infoLock);
       declared = STEREO::DeclaredLayouts(m_stereoModes);
+      edidDeclares = STEREO::EdidLayouts(m_stereoEdid);
     }
     CLog::Log(LOGINFO, "3D output: {}",
               declared.empty()
-                  ? std::string("the driver lists no mode with a 3D layout; the half layouts are "
-                                "told by the HDMI vendor InfoFrame where the EDID declares them")
+                  ? "the driver lists no mode with a 3D layout; the half layouts are told by the "
+                    "HDMI vendor InfoFrame where the EDID declares them (not at 2160p at 24 to 30 "
+                    "Hz, which the driver tells by a format number of HDMI's own): it declares " +
+                        (edidDeclares.empty() ? std::string("none") : edidDeclares)
                   : "the driver lists the 3D layouts of the display: " + declared);
   }
   // Hades: ... and where it does, on a DisplayPort output, what is behind it (DV_DUAL_MODE)
@@ -955,7 +959,14 @@ bool CWinSystemGbm::GetStereoOffers(std::vector<STEREO::Offer>& offers,
   {
     for (STEREO::Offer& offer : offers)
     {
-      const uint8_t vic = STEREO::VicOf(modes[offer.base]);
+      // (not in a mode that HDMI has a format number of its own for, 2160p at 24 to 30 Hz: the
+      // driver tells the display of it by that number in its own vendor InfoFrame, with no
+      // CTA-861 number in the AVI InfoFrame, and a 3D layout is told in its place only with the
+      // CTA-861 number in the AVI InfoFrame, as the kernel does for a mode with a 3D layout,
+      // drm_mode_hdmi_vic(): nvidia-drm takes no such number from its user. The commit leaves
+      // such a mode untold as well, NextInfoFrameStep(): driverTells.)
+      const uint8_t vic =
+          STEREO::HasHdmiVic(modes[offer.base]) ? uint8_t{0} : STEREO::VicOf(modes[offer.base]);
       offer.infoFrameTopAndBottom =
           offer.topAndBottom < 0 && STEREO::Supports(edid, vic, STEREO::Layout::TOP_AND_BOTTOM);
       offer.infoFrameSideBySide =
diff --git a/xbmc/windowing/gbm/drm/DRMStereo.h b/xbmc/windowing/gbm/drm/DRMStereo.h
index e2fc57f..3ee3308 100644
--- a/xbmc/windowing/gbm/drm/DRMStereo.h
+++ b/xbmc/windowing/gbm/drm/DRMStereo.h
@@ -526,10 +526,15 @@ constexpr int FramePackedBufferWidth(const Mode& mode, uint32_t bytesPerPixel, u
 }
 
 /*!
- * \brief The video format number of CTA-861 (VIC) of a 2D mode, of those HDMI has 3D for
- * \return the number of its 16:9 form, or 0 for any other mode
+ * \brief The video format number of CTA-861 (VIC) of a 2D mode, of those that an EDID names in 3D
+ * \return the number of its 16:9 form (of 3840x2160; 256:135 of 4096x2160), or 0 for any other
+ *         mode
  *
- * The EDID names the formats that a display takes in 3D by these numbers.
+ * The EDID names the formats that a display takes in 3D by these numbers: its 3D_Structure_ALL
+ * and 3D_MASK cover the first sixteen video formats that it lists, whatever they are, and its
+ * 2D_VIC_order entries point at any of them. A display that lists a 2160p format among them names
+ * it so (the kernel makes 3D modes of such entries as of any other: drm_edid.c,
+ * add_3d_struct_modes()).
  */
 inline uint8_t VicOf(const Mode& mode)
 {
@@ -543,12 +548,14 @@ inline uint8_t VicOf(const Mode& mode)
     uint8_t p720;
     uint8_t p1080;
     uint8_t i1080; //!< by its field rate
+    uint8_t p2160; //!< 3840x2160
+    uint8_t p2160dci; //!< 4096x2160
   };
-  constexpr std::array<Rate, 5> RATES = {{{24.0, true, 60, 32, 0},
-                                          {25.0, false, 61, 33, 0},
-                                          {30.0, true, 62, 34, 0},
-                                          {50.0, false, 19, 31, 20},
-                                          {60.0, true, 4, 16, 5}}};
+  constexpr std::array<Rate, 5> RATES = {{{24.0, true, 60, 32, 0, 93, 98},
+                                          {25.0, false, 61, 33, 0, 94, 99},
+                                          {30.0, true, 62, 34, 0, 95, 100},
+                                          {50.0, false, 19, 31, 20, 96, 101},
+                                          {60.0, true, 4, 16, 5, 97, 102}}};
 
   const double rate = RefreshRate(mode);
   const bool interlaced = (mode.flags & FLAG_INTERLACE) != 0;
@@ -562,10 +569,41 @@ inline uint8_t VicOf(const Mode& mode)
       return row.p720;
     if (mode.hdisplay == 1920 && mode.vdisplay == 1080)
       return interlaced ? row.i1080 : row.p1080;
+    if (mode.vdisplay == 2160 && !interlaced)
+    {
+      if (mode.hdisplay == 3840)
+        return row.p2160;
+      if (mode.hdisplay == 4096)
+        return row.p2160dci;
+    }
   }
   return 0;
 }
 
+/*!
+ * \brief Hades: the size and rate of a format that VicOf() gives, as kodi.log names it
+ *        ("3840x2160@60"); "VIC n" for any other
+ */
+inline std::string VicName(uint8_t vic)
+{
+  struct Named
+  {
+    uint8_t vic;
+    const char* name;
+  };
+  static constexpr std::array<Named, 22> NAMES = {
+      {{4, "1280x720@60"},    {5, "1920x1080i@60"}, {16, "1920x1080@60"}, {19, "1280x720@50"},
+       {20, "1920x1080i@50"}, {31, "1920x1080@50"}, {32, "1920x1080@24"}, {33, "1920x1080@25"},
+       {34, "1920x1080@30"},  {60, "1280x720@24"},  {61, "1280x720@25"},  {62, "1280x720@30"},
+       {93, "3840x2160@24"},  {94, "3840x2160@25"}, {95, "3840x2160@30"}, {96, "3840x2160@50"},
+       {97, "3840x2160@60"},  {98, "4096x2160@24"}, {99, "4096x2160@25"}, {100, "4096x2160@30"},
+       {101, "4096x2160@50"}, {102, "4096x2160@60"}}};
+  for (const Named& named : NAMES)
+    if (named.vic == vic)
+      return named.name;
+  return "VIC " + std::to_string(vic);
+}
+
 /*!
  * \brief Whether HDMI has a format number of its own (HDMI_VIC) for a 2D mode
  *
@@ -817,6 +855,39 @@ inline bool TakesStereo(std::span<const Mode> modes, const Edid3D& edid)
  *        listed at the size of Kodi's mode is not used at it (Choose()): where a display declares
  *        3D at 1080p only, side by side and top and bottom of a 2160p mode go out untold.
  */
+inline std::string DeclaredLayouts(std::span<const Mode> modes);
+
+/*!
+ * \brief Hades: what an EDID declares of 3D (Parse(), Supports()), for kodi.log: "frame packing at
+ *        1920x1080@24, 1280x720@60; top-and-bottom at ...; side-by-side (half) at 1920x1080@60,
+ *        3840x2160@60", or empty where it declares nothing. For a driver that lists no 3D modes
+ *        (nvidia-drm), the formats whose half layouts Kodi can tell by the HDMI vendor InfoFrame.
+ */
+inline std::string EdidLayouts(const Edid3D& edid)
+{
+  std::vector<uint8_t> vics = {4,  5,  16, 19, 20, 31, 32, 33, 34,  60,  61,
+                               62, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102};
+  for (const Edid3D::Format& format : edid.listed)
+    if (std::ranges::find(vics, format.vic) == vics.end())
+      vics.push_back(format.vic);
+  std::string text;
+  for (const Layout layout :
+       {Layout::FRAME_PACKING, Layout::TOP_AND_BOTTOM, Layout::SIDE_BY_SIDE_HALF})
+  {
+    std::string names;
+    for (const uint8_t vic : vics)
+      if (Supports(edid, vic, layout))
+        names += (names.empty() ? "" : ", ") + VicName(vic);
+    if (names.empty())
+      continue;
+    text += text.empty() ? "" : "; ";
+    text += LayoutName(layout);
+    text += " at ";
+    text += names;
+  }
+  return text;
+}
+
 inline std::string DeclaredLayouts(std::span<const Mode> modes)
 {
   std::string text;
