 tools/dvbridge/dvbridge_core.h                |  5 ++++
 tools/dvbridge/dvbridge_metadata.h            | 20 +++++++++++---
 tools/dvbridge/dvbridge_render.c              |  6 +++++
 tools/dvbridge/dvbridge_render.h              |  3 +++
 .../VideoRenderers/DVBridgeGLES.cpp           | 27 +++++++++++++++++++
 .../VideoPlayer/VideoRenderers/DVBridgeGLES.h |  4 +++
 xbmc/settings/AdvancedSettings.cpp            |  2 ++
 xbmc/settings/AdvancedSettings.h              |  6 +++++
 9 files changed, 75 insertions(+), 4 deletions(-)

diff --git a/tools/dvbridge/dvbridge_core.c b/tools/dvbridge/dvbridge_core.c
index ec68420..11da4b7 100644
--- a/tools/dvbridge/dvbridge_core.c
+++ b/tools/dvbridge/dvbridge_core.c
@@ -77,6 +77,12 @@ void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add)
         context->state.cm40_default = add;
 }
 
+void dvbridge_set_refresh_all(struct dvbridge_context *context, bool all)
+{
+    if (context)
+        context->state.refresh_all = all;
+}
+
 void dvbridge_set_cm40(struct dvbridge_context *context, int mode, unsigned display_peak_pq)
 {
     if (!context)
diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 4b87d1d..8d27768 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -81,6 +81,11 @@ void dvbridge_set_trims(struct dvbridge_context *context, bool send);
  * (dvbridge_dv::cm40_default in dvbridge_metadata.h); false until said otherwise. Set and kept as
  * dvbridge_set_trims(). */
 void dvbridge_set_cm40_default(struct dvbridge_context *context, bool add);
+/* Hades: whether every frame is sent as the first picture of a scene (scene_refresh_flag 1, whatever the RPU
+ * says: dvbridge_dv::refresh_all in dvbridge_metadata.h), a comparison on a display; false until said otherwise.
+ * Set and kept as dvbridge_set_trims(). */
+#define DVBRIDGE_REFRESH_ALL 1
+void dvbridge_set_refresh_all(struct dvbridge_context *context, bool all);
 /* Hades: the content mapping v4.0 setting (videoscreen.hadesdvcm40): as the RPU has it; the default v4.0 part
  * added to RPUs without one (cm40_default); added automatically, decided once a stream, where the RPU has none and
  * its mastering display is brighter than the display, whose peak is display_peak_pq (a 12-bit PQ level from its
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
index cbcc448..563b7be 100644
--- a/tools/dvbridge/dvbridge_metadata.h
+++ b/tools/dvbridge/dvbridge_metadata.h
@@ -135,6 +135,16 @@ struct dvbridge_dv {
      * (cm40_dropped); a frame whose payload has no room for it goes out without it. Kept from one stream
      * to the next (dvbridge_dv_restart()), as no_trims. */
     bool cm40_default;
+    /* Hades: refresh_all, every frame is sent as the first picture of a scene (scene_refresh_flag 1),
+     * whatever its RPU says (dvbridge_set_refresh_all(); advancedsettings.xml, video/dvscenerefreshall).
+     * A comparison on a display, off by default. ETSI GS CCM 001 V1.1.1 6.2.2 has the flag say that the
+     * picture "is the first picture of a scene": the display starts its mapping again from that frame's
+     * metadata, without the filtering over time that it applies between the frames of a scene. A
+     * licensed player passes the flag of the RPU, as the serializer does without this switch; with it, a
+     * display's mapping follows each frame on its own, and what a display shows then is only seen on it.
+     * A repeated frame keeps its flag (1 here as well). Kept from one stream to the next
+     * (dvbridge_dv_restart()), as no_trims. */
+    bool refresh_all;
     /* Hades: cm40_auto, cm40_default decided once a stream (videoscreen.hadesdvcm40 automatic,
      * dvbridge_set_cm40()): with the first frame that is made, on where its RPU has no v4.0 part and its
      * mastering display (source_max_pq) is brighter than the display (cm40_auto_peak_pq, its peak as a
@@ -507,7 +517,7 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
 {
     const unsigned id = d->id;
     const bool no_trims = d->no_trims, cm40_default = d->cm40_default, cm40_auto = d->cm40_auto,
-               cm40_auto_no_trims = d->cm40_auto_no_trims;
+               cm40_auto_no_trims = d->cm40_auto_no_trims, refresh_all = d->refresh_all;
     const unsigned cm40_auto_peak_pq = d->cm40_auto_peak_pq;
     /* (Hades: the decision of the automatic choice is of the video, not of the stream of native output) */
     const bool cm40_auto_decided = d->cm40_auto_decided, cm40_auto_on = d->cm40_auto_on,
@@ -537,6 +547,7 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     d->cm40_menus = cm40_menus;
     d->id = id;
     d->no_trims = no_trims;
+    d->refresh_all = refresh_all;
     d->cm40_default = cm40_default;
     d->cm40_auto = cm40_auto;
     d->cm40_auto_no_trims = cm40_auto_no_trims;
@@ -703,9 +714,10 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     /* 6.2.1 table 3: dm_metadata() */
     d->size = 0;
     d->payload[d->size++] = 0; /* reserved_0x00_8bits */
-    /* scene_refresh_flag (6.2.2): the last frame's for a repeat, 1 where the scene is refreshed,
-     * else the RPU's */
-    d->payload[d->size++] = (uint8_t)(repeat ? d->previous[1] : refresh ? 1 : c->scene_refresh_flag);
+    /* scene_refresh_flag (6.2.2): the last frame's for a repeat, 1 where the scene is refreshed
+     * (Hades: and in every frame with refresh_all), else the RPU's */
+    d->payload[d->size++] =
+        (uint8_t)(repeat ? d->previous[1] : refresh || d->refresh_all ? 1 : c->scene_refresh_flag);
     int matrix[] = {9574,0,13802,9574,-1540,-5348,9574,17610,0};
     int lms[] = {7222,8771,390,2654,12430,1300,0,422,15962};
     unsigned offsets[] = {16777216, 134217728, 134217728}, depth = 12, space = 0;
diff --git a/tools/dvbridge/dvbridge_render.c b/tools/dvbridge/dvbridge_render.c
index 1b1c80e..4e7de03 100644
--- a/tools/dvbridge/dvbridge_render.c
+++ b/tools/dvbridge/dvbridge_render.c
@@ -3806,6 +3806,12 @@ void dvbridge_render_add_cm40_default(struct dvbridge_renderer *r, bool add)
         dvbridge_set_cm40_default(r->context, add);
 }
 
+void dvbridge_render_refresh_all(struct dvbridge_renderer *r, bool all)
+{
+    if (r)
+        dvbridge_set_refresh_all(r->context, all);
+}
+
 void dvbridge_render_set_cm40(struct dvbridge_renderer *r, int mode, unsigned display_peak_pq)
 {
     if (r)
diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 457d00c..2df3f76 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -654,6 +654,9 @@ void dvbridge_render_send_trims(struct dvbridge_renderer *renderer, bool send);
 /* Hades: whether a frame whose RPU has no content mapping v4.0 part is sent with dovi_tool's default one
  * (dvbridge_set_cm40_default()); false by default */
 void dvbridge_render_add_cm40_default(struct dvbridge_renderer *renderer, bool add);
+/* Hades: whether every frame is sent as the first picture of a scene (dvbridge_set_refresh_all()); false by
+ * default */
+void dvbridge_render_refresh_all(struct dvbridge_renderer *renderer, bool all);
 /* Hades: the content mapping v4.0 setting (dvbridge_set_cm40(): DVBRIDGE_CM40_*), the peak of the display a 12-bit
  * PQ level (0 not known) */
 void dvbridge_render_set_cm40(struct dvbridge_renderer *renderer, int mode, unsigned display_peak_pq);
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
index b191610..acc7c31 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -650,6 +650,7 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware)
   UseGamutSetting();
   UseMmrTableSetting();
   UseCm40DefaultSetting();
+  UseSceneRefreshSetting();
   // Hades: the transport that UseSourceTransport() asked for, also for a renderer made after it
   dvbridge_render_use_source_transport(m_renderer, m_sourceWanted);
   dvbridge_render_use_ipt(m_renderer, m_iptWanted);
@@ -2286,6 +2287,32 @@ void CDVBridgeGLES::KeepCm40Decision()
     m_cm40Decision = decision;
 }
 
+// Hades: every frame of native output sent as the first picture of a scene (scene_refresh_flag 1, whatever
+// the RPU says), where advancedsettings.xml asks for it (<video><dvscenerefreshall>true</dvscenerefreshall>
+// </video>, dvbridge_render_refresh_all()). A comparison on a display: its mapping then follows each frame on
+// its own, without the filtering over time that it applies between the frames of a scene. Off by default: the
+// flag of the RPU, as a licensed player sends it. Said in the log when it changes.
+void CDVBridgeGLES::UseSceneRefreshSetting()
+{
+  if (!m_renderer)
+    return;
+  const auto settings = CServiceBroker::GetSettingsComponent();
+  const bool all = settings && settings->GetAdvancedSettings() &&
+                   settings->GetAdvancedSettings()->m_videoDVSceneRefreshAll;
+  dvbridge_render_refresh_all(m_renderer, all);
+  if (static_cast<int>(all) == m_refreshAllApplied)
+    return;
+  const bool said = m_refreshAllApplied >= 0;
+  m_refreshAllApplied = all;
+  if (all)
+    CLog::Log(LOGINFO,
+              "DVBridge: every frame is sent as the first picture of a scene (scene_refresh_flag "
+              "1, whatever its RPU says), as advancedsettings.xml asks (dvscenerefreshall): a "
+              "comparison; the display's mapping follows each frame on its own");
+  else if (said)
+    CLog::Log(LOGINFO, "DVBridge: frames are sent with the scene_refresh_flag of their RPU again");
+}
+
 void CDVBridgeGLES::UseCm40DefaultSetting()
 {
   if (!m_renderer)
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
index 4cb4d18..bd0314d 100644
