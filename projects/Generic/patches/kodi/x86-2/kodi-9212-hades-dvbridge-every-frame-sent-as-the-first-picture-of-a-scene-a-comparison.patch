+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -628,6 +628,9 @@ private:
   //! Hades: the default content mapping v4.0 part for RPUs without one, where advancedsettings.xml asks
   //! for it (dvcm40default; with a renderer of native output that has just been made)
   void UseCm40DefaultSetting();
+  //! Hades: every frame sent as the first picture of a scene, where advancedsettings.xml asks for it
+  //! (dvscenerefreshall; with a renderer of native output that has just been made)
+  void UseSceneRefreshSetting();
   static double PQToNitsLevel(unsigned int level);
   //! Hades: which gamut mapping table the last mapping took, when that is new (once for a table
   //! and its format)
@@ -736,6 +739,7 @@ private:
   int m_cm40Mode = 0; //!< see UseContentMapping(): as asked
   unsigned int m_cm40PeakPq = 0;
   int m_cm40Applied = -1; //!< ... and as given to the renderer (with the expert switch), for the log
+  int m_refreshAllApplied = -1; //!< Hades: UseSceneRefreshSetting(), as given, for the log
   bool m_cm40Revoked = false; //!< the automatic choice was taken back in the stream of now (told once)
   //! Hades: the decision of the automatic choice of the video of now, kept here for a renderer that is
   //! made again within the video (KeepCm40Decision(), Cm40Video())
