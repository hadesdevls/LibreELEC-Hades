+#pragma once
+
+#include "OutputState.h"
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace KODI
+{
+namespace WINDOWING
+{
+namespace GBM
+{
+
+/*!
+ * \brief Hades: a link that the kernel marks Bad (the connector property "link-status"), set up
+ *        again as the kernel asks of the program that drives the display
+ *
+ * What the kernel says (drm_connector.c, "link-status", and
+ * drm_connector_set_link_status_property()): the default value is Good. If something fails during
+ * or after a modeset, the driver may set it to Bad and send a hot-plug uevent; the display then
+ * receives no pixels. User space is expected to perform a new modeset with link-status set to
+ * Good, which re-enables the connector, picking a new mode only if the current one has disappeared.
+ * A commit on a connector that is Bad, without setting it Good, may still leave the display without
+ * pixels; one that sets it Good without DRM_MODE_ATOMIC_ALLOW_MODESET may fail, as a modeset is
+ * required. User space can only change it to Good: Bad is a no-op (drm_atomic_uapi.c,
+ * drm_atomic_connector_set_property()).
+ *
+ * Why a commit of link-status alone is the whole output as it is: an atomic commit duplicates the
+ * current state of every object it names (drm_atomic_get_connector_state():
+ * atomic_duplicate_state(), and the connector's CRTC with it), a value that differs between the old
+ * and the new state of the connector makes the CRTC's connectors_changed true, which is a full
+ * modeset (drm_atomic_helper_check_modeset()), and that modeset adds the connectors and planes of
+ * the CRTC, each duplicated too. So the mode, HDR_OUTPUT_METADATA, the Colorspace, the depth, the
+ * properties of the Dolby Vision transport and of its InfoFrame, the 3D layout of the mode, VRR,
+ * the colour processing of the CRTC and the plane, and the framebuffer on the plane go out as the
+ * kernel has them, which is what Kodi and native output set; nothing of Kodi's request in the
+ * making is part of it, and no mode is chosen here.
+ *
+ * Which drivers set Bad, in the kernel that Hades builds (Linux 7.4): i915 after a DisplayPort link
+ * training that failed or fell back to a lower rate or lane count, a 128b/132b payload that could
+ * not be written, an MST stream and a DisplayPort tunnel whose bandwidth was lost
+ * (intel_dp_queue_modeset_retry_for_link(); intel_connector.c sets Bad and sends the event), so a
+ * DisplayPort output, and an HDMI port that the board drives through a DisplayPort converter; and
+ * the cadence MHDP8546 bridge. amdgpu and nvidia-drm never set it (they attach the property, as
+ * every connector has it: __drm_connector_init()), nor does i915 on a native HDMI connector. On
+ * those, it reads Good, and nothing here does anything but that read after an event.
+ *
+ * What is done:
+ *  - The link is read only when a hot-plug event of the device came, a change of mode of Kodi's
+ *    went out AFTER_MODESET_MS before (a Bad that came with no event that Kodi heard), or a look
+ *    that this asked for is due (Due()): nothing at all for the frames in between.
+ *  - Bad on the output that Kodi drives, on: one commit of link-status Good alone, with a modeset
+ *    allowed (Changes()). Its result is told once: Bad again as soon as the link reads Bad (a
+ *    training that fails sets it right after the modeset, from a worker of the driver, with an
+ *    event), Good again where it still reads Good VERIFY_MS after the commit. Bad again: a commit
+ *    BACKOFF_MS[0] after the first, then BACKOFF_MS[1] after the second; ATTEMPTS in all, then it
+ *    stops (GIVE_UP) until a change of mode of Kodi's, which is a new link (KodiModeset()). A Bad
+ *    within CALM_MS of the last commit takes from the same budget: a link that keeps failing cannot
+ *    keep the output going through modesets.
+ *  - Not while the output is off or the connector is not on Kodi's CRTC (turning it on is a change
+ *    of mode of Kodi's), nor while a change of mode of Kodi's is pending: that commit sets it Good
+ *    itself (CarriesGood()).
+ *  - Never a commit where the link is Good or the connector has no such property, and none where
+ *    it cannot be read (the connector is gone).
+ */
+namespace LINK_STATUS
+{
+constexpr const char* PROPERTY = "link-status";
+//! commits for a link that stays Bad, the first one included
+constexpr unsigned int ATTEMPTS = 3;
+//! after a commit, before the next one, where the link is Bad again
+constexpr int64_t BACKOFF_MS[ATTEMPTS - 1] = {2000, 8000};
+//! after a commit, the link is read again
+constexpr int64_t VERIFY_MS = 1000;
+//! a Bad this long after the last commit starts with the whole budget again
+constexpr int64_t CALM_MS = 60000;
+//! after a change of mode of Kodi's, the link is read once (where no event is heard)
+constexpr int64_t AFTER_MODESET_MS = 1500;
+
+//! The values of Good and Bad, as the enum of the property names them (drm_connector.c:
+//! drm_link_status_enum_list, "Good" and "Bad")
+struct Values
+{
+  uint64_t good{0};
+  uint64_t bad{1};
+};
+
+//! The values, where the connector has the property and its enum names both (nothing otherwise:
+//! then nothing is ever read or written)
+inline std::optional<Values> ValuesOf(std::optional<uint64_t> good, std::optional<uint64_t> bad)
+{
+  if (!good || !bad || *good == *bad)
+    return std::nullopt;
+  return Values{*good, *bad};
+}
+
+//! ... from the definition of the property (OUTPUT_STATE::PropertyInfo)
+inline std::optional<Values> ValuesOf(const OUTPUT_STATE::PropertyInfo& property)
+{
+  if (property.name != PROPERTY)
+    return std::nullopt;
+  return ValuesOf(property.EnumValue("Good"), property.EnumValue("Bad"));
+}
+
+enum class Link
+{
+  ABSENT, //!< the connector has no such property (or not as documented)
+  GOOD,
+  BAD,
+  UNREADABLE, //!< the connector could not be read (gone)
+};
+
+//! What a value read means; value: what the kernel has now, nothing where it could not be read
+inline Link LinkOf(const std::optional<Values>& values, std::optional<uint64_t> value)
+{
+  if (!values)
+    return Link::ABSENT;
+  if (!value)
+    return Link::UNREADABLE;
+  return *value == values->bad ? Link::BAD : Link::GOOD;
+}
+
+//! Whether a change of mode of Kodi's carries link-status Good: only where the link is Bad now
+//! (CDRMAtomic::DrmAtomicCommit(), for an output that it turns on or keeps on)
+inline bool CarriesGood(const std::optional<Values>& values, std::optional<uint64_t> value)
+{
+  return LinkOf(values, value) == Link::BAD;
+}
+
+//! The commit that has the kernel train the link again: link-status Good on the connector, and
+//! nothing else (with a modeset allowed: OUTPUT_STATE::IKms::Commit())
+inline std::vector<OUTPUT_STATE::Change> Changes(uint32_t connector,
+                                                 uint32_t property,
+                                                 const Values& values)
+{
+  return {{OUTPUT_STATE::Role::CONNECTOR, connector, property, PROPERTY, values.good}};
+}
+
+//! What the output is, asked only where the link is Bad
+struct Output
+{
+  bool on{false}; //!< Kodi has it on and the kernel says that its CRTC is active
+  bool routed{false}; //!< the connector is on Kodi's CRTC (its CRTC_ID)
+  bool kodiModesetPending{false}; //!< Kodi's next commit is a change of mode (or one asked again)
+};
+
+enum class Verdict
+{
+  NOTHING, //!< Good
+  ABSENT, //!< no such property
+  GONE, //!< the connector could not be read
+  OFF, //!< Bad on an output that is off or not Kodi's: turning it on sets it Good
+  KODI_MODESET, //!< Bad, and a change of mode of Kodi's is pending, which sets it Good
+  COMMIT, //!< Bad: a commit of link-status Good is made now
+  WAIT, //!< Bad, and the next commit is not due yet
+  STILL_BAD, //!< Bad again after a commit: the next one waits (WAIT then)
+  GOOD_AGAIN, //!< Good after a commit
+  GIVE_UP, //!< Bad after ATTEMPTS commits: stopped until a change of mode of Kodi's
+  STOPPED, //!< Bad, and it was given up
+};
+
+/*!
+ * \brief The commits made for one output: when the link is read, and what is done
+ */
+class CRetrain
+{
+public:
+  //! Whether the link is read now: an event came (event), a change of mode of Kodi's went out
+  //! AFTER_MODESET_MS ago and was not looked after (afterModeset), or a look asked for is due
+  bool Due(int64_t nowMs, bool event, bool afterModeset) const
+  {
+    return event || afterModeset || (m_verifyAt >= 0 && nowMs >= m_verifyAt) ||
+           (m_retryAt >= 0 && nowMs >= m_retryAt);
+  }
+
+  //! What to do with what was read (output: asked only where the link is Bad)
+  Verdict Decide(Link link, const std::function<Output()>& output, int64_t nowMs)
+  {
+    const bool verifying = m_verifyAt >= 0 && nowMs >= m_verifyAt;
+    switch (link)
+    {
+      case Link::ABSENT:
+        Quiet();
+        return Verdict::ABSENT;
+      case Link::UNREADABLE:
+        Quiet();
+        return Verdict::GONE;
+      case Link::GOOD:
+        m_retryAt = -1;
+        if (m_lastAt >= 0 && nowMs - m_lastAt >= CALM_MS)
+          Forget();
+        if (verifying)
+        {
+          m_verifyAt = -1;
+          if (std::exchange(m_untold, false))
+            return Verdict::GOOD_AGAIN;
+        }
+        return Verdict::NOTHING;
+      default:
+        break;
+    }
+    const Output out = output ? output() : Output{};
+    if (!out.on || !out.routed)
+    {
+      Quiet();
+      return Verdict::OFF;
+    }
+    if (out.kodiModesetPending)
+    {
+      Quiet();
+      return Verdict::KODI_MODESET;
+    }
+    if (m_stopped)
+    {
+      Quiet();
+      return Verdict::STOPPED;
+    }
+    if (m_lastAt >= 0 && nowMs - m_lastAt >= CALM_MS)
+      Forget();
+    if (m_attempts >= ATTEMPTS)
+    {
+      m_stopped = true;
+      Quiet();
+      return Verdict::GIVE_UP;
+    }
+    if (m_attempts > 0)
+    {
+      const int64_t next = m_lastAt + BACKOFF_MS[m_attempts - 1];
+      if (nowMs < next)
+      {
+        m_verifyAt = -1;
+        m_retryAt = next;
+        // (the result of the commit before, told once)
+        return std::exchange(m_untold, false) ? Verdict::STILL_BAD : Verdict::WAIT;
+      }
+    }
+    return Verdict::COMMIT;
+  }
+
+  //! A commit that Decide() asked for was made: error 0 where the driver took it
+  void Committed(int64_t nowMs, int error)
+  {
+    ++m_attempts;
+    m_lastAt = nowMs;
+    // (a commit that the driver took has a result to tell; a refusal is told with the commit)
+    m_untold = error == 0;
+    if (error == 0)
+    {
+      m_verifyAt = nowMs + VERIFY_MS;
+      m_retryAt = -1;
+    }
+    else
+    {
+      m_verifyAt = -1;
+      m_retryAt = m_attempts < ATTEMPTS ? nowMs + BACKOFF_MS[m_attempts - 1] : nowMs;
+    }
+  }
+
+  //! A change of mode of Kodi's went out: a new link, and the whole budget again
+  void KodiModeset()
+  {
+    Forget();
+    Quiet();
+  }
+
+  unsigned int Attempts() const { return m_attempts; }
+  bool Stopped() const { return m_stopped; }
+  //! the wait before the next commit, after the one made last (0 where none is left)
+  int64_t NextWaitMs() const
+  {
+    return m_attempts > 0 && m_attempts < ATTEMPTS ? BACKOFF_MS[m_attempts - 1] : 0;
+  }
+
+private:
+  void Quiet()
+  {
+    m_verifyAt = -1;
+    m_retryAt = -1;
+    m_untold = false;
+  }
+  void Forget()
+  {
+    m_attempts = 0;
+    m_stopped = false;
+    m_lastAt = -1;
+  }
+
+  unsigned int m_attempts{0};
+  int64_t m_lastAt{-1}; //!< the last commit
+  int64_t m_verifyAt{-1};
+  int64_t m_retryAt{-1};
+  bool m_stopped{false};
+  bool m_untold{false}; //!< a commit that the driver took, whose result is not told yet
+};
+
+//! One look, as the window system makes it, and what it did
+struct Look
+{
+  Verdict verdict{Verdict::NOTHING};
+  int error{0}; //!< of the commit, where one was made
+  unsigned int attempt{0}; //!< the number of that commit (1 to ATTEMPTS)
+};
+
+/*!
+ * \brief Reads the link of the connector and does what Decide() says: a commit of link-status Good
+ *        alone where it says COMMIT (the caller has made sure that Due())
+ * \param kms the kernel (OUTPUT_STATE::CLibdrmKms: Values() reads, Commit() is a blocking commit
+ *        with a modeset allowed)
+ * \param output what the output is, asked only where the link is Bad
+ */
+inline Look LookAt(CRetrain& retrain,
+                   OUTPUT_STATE::IKms& kms,
+                   uint32_t connector,
+                   uint32_t property,
+                   const std::optional<Values>& values,
+                   const std::function<Output()>& output,
+                   int64_t nowMs)
+{
+  std::optional<uint64_t> value;
+  if (values && property)
+  {
+    if (const auto all = kms.Values(OUTPUT_STATE::Role::CONNECTOR, connector))
+    {
+      const auto it = all->find(property);
+      if (it != all->end())
+        value = it->second;
+    }
+  }
+  Look look;
+  look.verdict = retrain.Decide(property ? LinkOf(values, value) : Link::ABSENT, output, nowMs);
+  if (look.verdict != Verdict::COMMIT)
+    return look;
+  look.error = kms.Commit(Changes(connector, property, *values), false);
+  retrain.Committed(nowMs, look.error);
+  look.attempt = retrain.Attempts();
+  return look;
+}
+
+} // namespace LINK_STATUS
+} // namespace GBM
+} // namespace WINDOWING
+} // namespace KODI
