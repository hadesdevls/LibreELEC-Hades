index 1907af6..66304b1 100644
--- a/xbmc/windowing/gbm/drm/OutputState.h
+++ b/xbmc/windowing/gbm/drm/OutputState.h
@@ -223,7 +223,8 @@ inline const char* Exclusion(Role role, std::string_view name, const Policy& pol
       {Role::CONNECTOR, "DPMS",
        "legacy only: the atomic interface refuses it (the power is ACTIVE)"},
       {Role::CONNECTOR, "link-status",
-       "the kernel sets it (Good); asking for Bad is a request to retrain the link"},
+       "the kernel's: it marks the link Bad where its training failed, and a commit that sets it "
+       "Good has the link trained again (LinkStatus.h); asking for Bad does nothing"},
       {Role::CONNECTOR, "Content Protection", "a state machine of the kernel (HDCP)"},
       {Role::CONNECTOR, "HDCP Content Type", "part of the HDCP state machine of the kernel"},
       {Role::CONNECTOR, "HDR10PLUS_VSIF",
