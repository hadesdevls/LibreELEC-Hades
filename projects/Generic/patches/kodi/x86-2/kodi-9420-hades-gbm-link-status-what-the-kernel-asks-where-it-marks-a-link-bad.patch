 xbmc/windowing/gbm/drm/LinkStatus.h   | 354 ++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/OutputState.h  |   3 +-
 3 files changed, 357 insertions(+), 1 deletion(-)
 create mode 100644 xbmc/windowing/gbm/drm/LinkStatus.h

