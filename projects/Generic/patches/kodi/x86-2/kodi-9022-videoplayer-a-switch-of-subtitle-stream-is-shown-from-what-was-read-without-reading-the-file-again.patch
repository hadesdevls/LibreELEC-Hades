       }
     }
 
+    // Hades: the packets of every subtitle stream, for a switch to another (CSubtitleTrackMemory)
+    KeepSubtitlePacket(pStream, pPacket);
+
     // process the packet
     ProcessPacket(pStream, pPacket);
   }
 }
 
+bool CVideoPlayer::SubtitleTracksKept() const
+{
+  return m_pDemuxer && m_pInputStream && m_pInputStream->IsStreamType(DVDSTREAM_TYPE_FILE) &&
+         !m_pInputStream->IsRealtime() && m_offset_pts == 0.0;
+}
+
+namespace
+{
+//! Hades: the kind of a subtitle codec that CSubtitleTrackMemory keeps; false for the others
+bool KeptSubtitleKind(AVCodecID codec, CSubtitleTrackMemory::Kind& kind)
+{
+  switch (codec)
+  {
+    case AV_CODEC_ID_HDMV_PGS_SUBTITLE:
+      kind = CSubtitleTrackMemory::Kind::PGS;
+      return true;
+    case AV_CODEC_ID_SUBRIP:
+    case AV_CODEC_ID_TEXT:
+    case AV_CODEC_ID_MOV_TEXT:
+    case AV_CODEC_ID_ASS:
+    case AV_CODEC_ID_SSA:
+      kind = CSubtitleTrackMemory::Kind::TEXT;
+      return true;
+    default:
+      return false;
+  }
+}
+} // namespace
+
+void CVideoPlayer::KeepSubtitlePacket(const CDemuxStream* stream, const DemuxPacket* packet)
+{
+  if (!packet || !SubtitleTracksKept())
+    return;
+  CSubtitleTrackMemory::Kind kind;
+  if (!stream || stream->type != StreamType::SUBTITLE ||
+      STREAM_SOURCE_MASK(stream->source) != STREAM_SOURCE_DEMUX ||
+      !KeptSubtitleKind(stream->codec, kind))
+  {
+    m_subtitleTracks.NoteRead(packet->dts != DVD_NOPTS_VALUE ? packet->dts : packet->pts);
+    return;
+  }
+  m_subtitleTracks.Remember(stream->demuxerId, packet->iStreamId, kind, packet->pts, packet->dts,
+                            packet->duration, packet->pData,
+                            packet->iSize > 0 ? static_cast<size_t>(packet->iSize) : 0,
+                            m_clock.GetClock() - m_VideoPlayerVideo->GetSubtitleDelay());
+}
+
+bool CVideoPlayer::GiveBackSubtitles()
+{
+  if (!SubtitleTracksKept() || m_CurrentSubtitle.id < 0)
+    return false;
+#ifdef HAVE_DVBRIDGE
+  // the demuxer reads again for the video alone: its packets are being told apart from new ones
+  if (m_videoOnly.active)
+    return false;
+#endif
+  CDemuxStream* stream = m_pDemuxer->GetStream(m_CurrentSubtitle.demuxerId, m_CurrentSubtitle.id);
+  CSubtitleTrackMemory::Kind kind;
+  if (!stream || !KeptSubtitleKind(stream->codec, kind))
+    return false;
+
+  const double now = m_clock.GetClock() - m_VideoPlayerVideo->GetSubtitleDelay();
+  std::vector<CSubtitleTrackMemory::Packet> packets;
+  double from = DVD_NOPTS_VALUE;
+  std::string why;
+  if (!m_subtitleTracks.Recall(m_CurrentSubtitle.demuxerId, m_CurrentSubtitle.id, kind, now,
+                               packets, from, why))
+  {
+    CLog::Log(LOGINFO,
+              "CVideoPlayer: subtitle stream {} at {:.3f} s: not shown from what was read ({}): "
+              "it is read again from the file",
+              m_CurrentSubtitle.id, now / DVD_TIME_BASE, why);
+    return false;
+  }
+
+  for (const CSubtitleTrackMemory::Packet& p : packets)
+  {
+    DemuxPacket* pkt = CDVDDemuxUtils::AllocateDemuxPacket(static_cast<int>(p.data.size()));
+    if (!pkt)
+      break;
+    std::memcpy(pkt->pData, p.data.data(), p.data.size());
+    pkt->iSize = static_cast<int>(p.data.size());
+    pkt->pts = p.pts;
+    pkt->dts = p.dts;
+    pkt->duration = p.duration;
+    pkt->iStreamId = m_CurrentSubtitle.id;
+    pkt->demuxerId = m_CurrentSubtitle.demuxerId;
+    ProcessSubData(stream, pkt);
+  }
+  CLog::Log(LOGINFO,
+            "CVideoPlayer: subtitle stream {} ({}) at {:.3f} s shown from what was read: {} "
+            "packet(s) from {:.3f} s on, the file not read again ({} KiB kept for {} stream(s))",
+            m_CurrentSubtitle.id, kind == CSubtitleTrackMemory::Kind::PGS ? "PGS" : "text",
+            now / DVD_TIME_BASE, packets.size(), from / DVD_TIME_BASE,
+            m_subtitleTracks.Bytes() / 1024, m_subtitleTracks.Streams());
+  return true;
+}
