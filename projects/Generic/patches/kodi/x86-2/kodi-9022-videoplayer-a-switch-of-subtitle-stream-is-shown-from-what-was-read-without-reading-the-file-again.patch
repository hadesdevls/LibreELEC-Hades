+/*!
+ * \brief The subtitle packets of every subtitle stream of a file as the demuxer reads them, to give
+ *        the stream the user switches to what it needs without reading the file again.
+ *
+ * The demuxer reads every stream of the file and the player drops the packets of the streams it
+ * does not play. On a switch to another subtitle stream, those of its packets that are on screen
+ * now, and the ones read since (the demuxer is ahead of playback), were dropped: the player read
+ * them again by taking the demuxer back to the playback time (CVideoPlayer::RereadSubtitleData()),
+ * or by a seek. From a Debrid service that is a new request to the server for what was read
+ * already, and a seek where the server allows one connection to the file.
+ *
+ * This keeps the packets of every subtitle stream, as they were read, from the last discontinuity
+ * of the reading (a seek, a new file: Reset()) on, bounded in bytes and to KEEP_BEHIND before the
+ * playback time. Recall() gives a stream what its decoder needs to show what is on screen now and
+ * then go on with the demuxer's next packets, or nothing when the memory does not hold it:
+ *  - a PGS stream (Blu-ray graphics): from its last display set that starts an epoch or is an
+ *    acquisition point at or before now (its composition state is not "normal": everything it
+ *    shows is in it, and the decoder drops what came before), or, when it has none since the
+ *    memory began at least PGS_QUIET before now, from now on (nothing it showed can be on screen);
+ *  - a text stream: its lines that end after now, if the memory began at least TEXT_LEAD before
+ *    now (a line that began earlier and is still on screen would be missing).
+ * Every packet of the stream after those, up to the last one read, follows in order.
+ */
+class CSubtitleTrackMemory
+{
+public:
+  struct Packet
+  {
+    double pts{DVD_NOPTS_VALUE};
+    double dts{DVD_NOPTS_VALUE};
+    double duration{0.0};
+    std::vector<uint8_t> data;
+    bool anchor{false}; //!< PGS: a display set whose composition state is not "normal"
+
+    double Start() const { return pts != DVD_NOPTS_VALUE ? pts : dts; }
+    double End() const { return Start() + (duration > 0.0 ? duration : 0.0); }
+  };
+
+  enum class Kind
+  {
+    PGS,
+    TEXT,
+  };
+
+  static constexpr size_t MAX_BYTES_PER_STREAM = 4 * 1024 * 1024;
+  static constexpr size_t MAX_BYTES = 24 * 1024 * 1024;
+  static constexpr size_t PACKET_OVERHEAD = 64;
+  static constexpr double KEEP_BEHIND = 60.0 * DVD_TIME_BASE;
+  static constexpr double TEXT_LEAD = 10.0 * DVD_TIME_BASE;
+  static constexpr double PGS_QUIET = 10.0 * DVD_TIME_BASE;
+
+  //! Whether a PGS packet holds a presentation composition segment whose state is not "normal"
+  static bool IsPgsAnchor(const uint8_t* data, size_t size)
+  {
+    // segments: type (1 byte), length (2), payload; the PCS (0x16) has its composition state at 7
+    size_t pos = 0;
+    while (data && pos + 3 <= size)
+    {
+      const uint8_t type = data[pos];
+      const size_t length = (static_cast<size_t>(data[pos + 1]) << 8) | data[pos + 2];
+      if (type == 0x16 && length >= 8 && pos + 3 + length <= size)
+        return (data[pos + 3 + 7] & 0xC0) != 0;
+      pos += 3 + length;
+    }
+    return false;
+  }
+
+  /*!
+   * \brief A discontinuity of the reading (a seek, a new file): what is kept goes, and the memory
+   *        begins again at the next packet read
+   */
+  void Reset()
+  {
+    m_streams.clear();
+    m_bytes = 0;
+    m_since = DVD_NOPTS_VALUE;
+  }
+
+  //! A packet of any stream was read: the memory begins at the first one after Reset()
+  void NoteRead(double dts)
+  {
+    if (m_since == DVD_NOPTS_VALUE && dts != DVD_NOPTS_VALUE)
+      m_since = dts;
+  }
+
+  /*!
+   * \brief Keep a subtitle packet as it was read
+   * \param playback the playback time now (DVD_NOPTS_VALUE if not known), for KEEP_BEHIND
+   * \return false if it is not kept: no start, empty, too big, or kept already (read again)
+   */
+  bool Remember(int64_t demuxerId,
+                int streamId,
+                Kind kind,
+                double pts,
+                double dts,
+                double duration,
+                const uint8_t* data,
+                size_t size,
+                double playback)
+  {
+    const double start = pts != DVD_NOPTS_VALUE ? pts : dts;
+    NoteRead(start);
+    if (start == DVD_NOPTS_VALUE || !data || size == 0 ||
+        size + PACKET_OVERHEAD > MAX_BYTES_PER_STREAM)
+      return false;
+
+    Stream& s = m_streams[{demuxerId, streamId}];
+    s.kind = kind;
+    // read again (the demuxer went back for the video alone, or to read subtitles again): kept
+    auto at = std::upper_bound(s.packets.begin(), s.packets.end(), start,
+                               [](double t, const Packet& p) { return t < p.Start(); });
+    for (auto it = at; it != s.packets.begin();)
+    {
+      --it;
+      if (it->Start() != start)
+        break;
+      if (it->data.size() == size && std::memcmp(it->data.data(), data, size) == 0)
+        return false;
+    }
+    if (s.evictedUntil != DVD_NOPTS_VALUE && start < s.evictedUntil)
+      return false;
+
+    Packet p;
+    p.pts = pts;
+    p.dts = dts;
+    p.duration = duration == DVD_NOPTS_VALUE ? 0.0 : duration;
+    p.data.assign(data, data + size);
+    p.anchor = kind == Kind::PGS && IsPgsAnchor(data, size);
+    s.packets.insert(at, std::move(p));
+    s.bytes += size + PACKET_OVERHEAD;
+    m_bytes += size + PACKET_OVERHEAD;
+    Trim(s, playback);
+    while (m_bytes > MAX_BYTES)
+    {
+      auto largest =
+          std::max_element(m_streams.begin(), m_streams.end(), [](const auto& a, const auto& b)
+                           { return a.second.bytes < b.second.bytes; });
+      if (largest == m_streams.end() || largest->second.packets.empty())
+        break;
+      EvictFront(largest->second);
+    }
+    m_peakBytes = std::max(m_peakBytes, m_bytes);
+    return true;
+  }
+
+  /*!
+   * \brief What a stream's decoder needs to show what is on screen at now and go on from the
+   *        demuxer's next packet (see the class), in order
+   * \param[out] from the time the packets given back begin at (the display set of a PGS stream)
+   * \param[out] why why nothing is given back, for the log
+   * \return false if the memory does not hold it: the stream has to be read again from the file
+   */
+  bool Recall(int64_t demuxerId,
+              int streamId,
+              Kind kind,
+              double now,
+              std::vector<Packet>& out,
+              double& from,
+              std::string& why) const
+  {
+    out.clear();
+    from = DVD_NOPTS_VALUE;
+    if (now == DVD_NOPTS_VALUE)
+    {
+      why = "the playback time is not known";
+      return false;
+    }
+    if (m_since == DVD_NOPTS_VALUE)
+    {
+      why = "nothing has been read since the reading began again";
+      return false;
+    }
+    const auto it = m_streams.find({demuxerId, streamId});
+    const Stream* s = it != m_streams.end() ? &it->second : nullptr;
+    // (DVD_NOPTS_VALUE is a large positive number: compared only when it is not that)
+    double covered = m_since;
+    if (s && s->evictedUntil != DVD_NOPTS_VALUE)
+      covered = std::max(covered, s->evictedUntil);
+
+    if (kind == Kind::PGS)
+    {
+      // the last display set that holds all it shows, at or before now
+      std::ptrdiff_t anchor = -1;
+      if (s)
+      {
+        for (std::ptrdiff_t i = 0; i < static_cast<std::ptrdiff_t>(s->packets.size()); i++)
+        {
+          if (s->packets[i].Start() > now)
+            break;
+          if (s->packets[i].anchor)
+            anchor = i;
+        }
+      }
+      if (anchor >= 0)
+      {
+        from = s->packets[anchor].Start();
+        out.assign(s->packets.begin() + anchor, s->packets.end());
+        return true;
+      }
+      if (covered > now - PGS_QUIET)
+      {
+        why = "it may show a display set that began before what is kept";
+        return false;
+      }
+      from = now;
+      if (s)
+      {
+        for (const Packet& p : s->packets)
+        {
+          if (p.Start() > now)
+            out.push_back(p);
+        }
+      }
+      return true;
+    }
+
+    if (covered > now - TEXT_LEAD)
+    {
+      why = "a line on screen now may have begun before what is kept";
+      return false;
+    }
+    from = now;
+    if (s)
+    {
+      for (const Packet& p : s->packets)
+      {
+        if (p.End() > now || p.Start() > now)
+          out.push_back(p);
+      }
+    }
+    return true;
+  }
+
+  size_t Bytes() const { return m_bytes; }
+  size_t PeakBytes() const { return m_peakBytes; }
+  void ResetPeak() { m_peakBytes = 0; }
+  size_t Streams() const { return m_streams.size(); }
+  size_t Packets() const
+  {
+    size_t n = 0;
+    for (const auto& [key, s] : m_streams)
+      n += s.packets.size();
+    return n;
+  }
+  double Since() const { return m_since; }
+
+private:
+  struct Stream
+  {
+    Kind kind{Kind::TEXT};
+    std::vector<Packet> packets; //!< in order of start
+    size_t bytes{0};
+    double evictedUntil{DVD_NOPTS_VALUE}; //!< the start of the latest packet that went
+  };
+
+  void EvictFront(Stream& s)
+  {
+    const Packet& p = s.packets.front();
+    s.evictedUntil =
+        s.evictedUntil == DVD_NOPTS_VALUE ? p.Start() : std::max(s.evictedUntil, p.Start());
+    s.bytes -= p.data.size() + PACKET_OVERHEAD;
+    m_bytes -= p.data.size() + PACKET_OVERHEAD;
+    s.packets.erase(s.packets.begin());
+  }
+
+  void Trim(Stream& s, double playback)
+  {
+    while (!s.packets.empty() &&
+           ((playback != DVD_NOPTS_VALUE && s.packets.front().Start() < playback - KEEP_BEHIND) ||
+            s.bytes > MAX_BYTES_PER_STREAM))
+      EvictFront(s);
+  }
+
+  std::map<std::pair<int64_t, int>, Stream> m_streams;
+  size_t m_bytes{0};
+  size_t m_peakBytes{0};
+  double m_since{DVD_NOPTS_VALUE};
+};
+
 /*!
  * \brief The text subtitle packets decoded since the last flush, by their times and bytes: a line
  *        that a search after a seek found in the file (SubtitleSeekSearch.h) and that the demuxer
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
