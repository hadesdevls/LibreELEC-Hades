+    return;
+
   // For embedded subtitles the demuxer is ahead of playback (AV buffers
   // are full), so the subtitle packets for the current playback time have
   // already been read and discarded. Read them again, without interrupting
@@ -6364,6 +6483,10 @@ void CVideoPlayer::FlushBuffers(double pts, bool accurate, bool sync)
 #endif
   CLog::Log(LOGDEBUG, "CVideoPlayer::FlushBuffers - flushing buffers");
 
+  // Hades: the reading goes on from elsewhere: the subtitle packets kept for a switch of stream
+  // begin again at what is read next
+  m_subtitleTracks.Reset();
+
   // Hades: what was read and will not be shown: the BD-J application gets what was held for
   // it now (a seek, a jump), as without presentation timing
   ReleaseAllBdjPresented();
