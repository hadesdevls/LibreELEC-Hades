From 5aec04e74423f1eb4a54272de5c30b0d1cb5d68d Mon Sep 17 00:00:00 2001
From: sopparus <sopparus@users.noreply.github.com>
Date: Sun, 20 Sep 2026 10:08:22 +0200
Subject: [PATCH] [ActiveAE] Discard duplicate device change notifications

Since #28640 the Windows endpoint notifications arrive as DEVICECOUNTCHANGE
instead of DEVICECHANGE, and that path does not discard the duplicates that
are already queued. Endpoints report several state changes for one event, for
example the display audio endpoints during a display mode switch at the start
of playback, and each of those messages enumerates all sinks again.

Control messages are handled before data messages, so with a burst of a dozen
notifications NEWSTREAM from the player waited behind the whole queue and
MakeStream() gave up after its 10 s timeout: playback continued without an
audio renderer and video stalled on a still frame.

Discard the queued duplicates before handling one, as the DEVICECHANGE path
does. Information that would be lost with them is kept: a default device
change anywhere in the burst still counts as one, and a default device change
or a queued event from another driver widens the enumeration to all drivers.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
(cherry picked from commit f438d3e8a2a7b4bbba5cd647de97446c62f5e8e5)
---
 .../AudioEngine/Engines/ActiveAE/ActiveAE.cpp | 29 ++++++++++++++++---
 1 file changed, 25 insertions(+), 4 deletions(-)

diff --git a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
index 0893afb..813b483 100644
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAE.cpp
@@ -909,11 +909,31 @@ void CActiveAE::StateMachine(int signal, Protocol *port, Message *msg)
           return;
         }
         case CActiveAEControlProtocol::DEVICECOUNTCHANGE:
-          HandleDeviceCountChange(reinterpret_cast<const char*>(msg->data), false);
-          return;
         case CActiveAEControlProtocol::DEFAULTDEVICECHANGE:
-          HandleDeviceCountChange("", true);
+        {
+          // endpoints report several changes for one event, e.g. display audio during a
+          // display mode switch, and each of them would enumerate all sinks again
+          const bool defaultDeviceChanged =
+              m_controlPort.PurgeOut(CActiveAEControlProtocol::DEFAULTDEVICECHANGE) > 0 ||
+              signal == CActiveAEControlProtocol::DEFAULTDEVICECHANGE;
+
+          std::string driver;
+          if (signal == CActiveAEControlProtocol::DEVICECOUNTCHANGE)
+            driver = reinterpret_cast<const char*>(msg->data);
+
+          bool allDrivers = defaultDeviceChanged;
+          m_controlPort.PurgeOut(CActiveAEControlProtocol::DEVICECOUNTCHANGE,
+                                 [&driver, &allDrivers](const Message& purged)
+                                 {
+                                   if (driver != reinterpret_cast<const char*>(purged.data))
+                                     allDrivers = true;
+                                 });
+          if (allDrivers)
+            driver.clear();
+
+          HandleDeviceCountChange(driver, defaultDeviceChanged);
           return;
+        }
         case CActiveAEControlProtocol::PAUSESTREAM:
           CActiveAEStream *stream;
           stream = *(CActiveAEStream**)msg->data;
@@ -4593,7 +4613,8 @@ void CActiveAE::HandleDeviceCountChange(const std::string& driver, bool defaultD
   if (defaultDeviceChanged)
     CLog::LogF(LOGDEBUG, "default device change event");
   else
-    CLog::LogF(LOGDEBUG, "device count change event from driver: {}", driver);
+    CLog::LogF(LOGDEBUG, "device count change event from driver: {}",
+               driver.empty() ? "all drivers" : driver);
 
   const std::string currentDriver = m_openedDriver;
   const std::string currentDevice = m_openedDevice;
