               v.why ? v.why : "not chosen");
@@ -4803,7 +4835,39 @@ bool CWinSystemGbm::HdmiVrrAllowedBySetting() const
   const auto on = [&settings](const char* id)
   { return settings && settings->GetSetting(id) && settings->GetBool(id); };
   return CHdmiVrrOff::Allowed(on(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR),
-                              on(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO));
+                              on(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO), AutoVrrDisplay());
+}
+
+std::vector<double> CWinSystemGbm::MenusRefreshes(const RESOLUTION_INFO& menus) const
+{
+  std::vector<double> refreshes;
+  auto& displays = CDisplaySettings::GetInstance();
+  for (size_t i = RES_DESKTOP; i < displays.ResolutionInfoSize(); ++i)
+  {
+    const RESOLUTION_INFO info = displays.GetResolutionInfo(i);
+    if (info.iScreenWidth == menus.iScreenWidth && info.iScreenHeight == menus.iScreenHeight &&
+        !(info.dwFlags &
+          (D3DPRESENTFLAG_INTERLACED | D3DPRESENTFLAG_MODE3DSBS | D3DPRESENTFLAG_MODE3DTB)) &&
+        info.fRefreshRate > 0.0f)
+      refreshes.push_back(info.fRefreshRate);
+  }
+  return refreshes;
+}
+
+bool CWinSystemGbm::AutoVrrDisplay() const
+{
+  // (Hades: a display that declares VRR and has no mode of the rate of films at the resolution of
+  // the menus: "Video at its own rate" goes on its own there, VRR_VIDEO::AutoForDisplay(); NVKMS takes
+  // the VRR of an HDMI display from its HDMI Forum block)
+  const auto info = DisplayInfo();
+  if (!info)
+    return false;
+  const bool vrr = info->HdmiVrrMin() > 0 || info->FreeSyncMin() > 0;
+  RESOLUTION menus = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    menus = CDisplaySettings::GetInstance().GetCurrentResolution();
+  return VRR_VIDEO::AutoForDisplay(
+      vrr, MenusRefreshes(CDisplaySettings::GetInstance().GetResolutionInfo(menus)));
 }
 
