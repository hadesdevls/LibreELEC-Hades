   }
 
   /*!
diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index ac41e88..128d890 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -46,6 +46,11 @@ namespace KODI::WINDOWING::GBM::VRR_VIDEO
  * second of the video (CStartCheck): where the refreshes stay at the mode's rate, the mode changes to
  * the video's rate as Kodi would have chosen it without this setting.
  *
+ * Without the setting it is taken on its own where the display has no mode at the video's rate:
+ * Kodi's choice stays in the mode of the menus, whose refresh is no whole multiple of the frame rate
+ * (Automatic(); AutoForDisplay() leaves VRR to the driver in the mode sets of the menus of such a
+ * display). A display with modes at the video's rate keeps its change of mode.
+ *
  * Never for Dolby Vision (native output, or a video that says it is Dolby Vision), HDR10+, HLG, 3D,
  * a video not known to be progressive, or a video whose kind is not known: those change the mode as
  * before, and so does anything this cannot do exactly (Decide()). Nothing of Kodi is here: a test
@@ -127,10 +132,51 @@ inline bool WholeMultipleOf(double refresh, double fps)
   return k >= 1.0 && k <= 16.0 && std::fabs(refresh - k * fps) <= refresh * 200e-6;
 }
 
+//! The frame rate of films, which the modes of a display are looked at for (AutoForDisplay())
+constexpr double FILM_FPS = 24000.0 / 1001.0;
+
+/*!
+ * \brief "Video at its own rate with VRR" without the setting, where the display leaves no other
+ *        way to show the video evenly: Kodi's choice of a mode stays in the mode of the menus
+ *        (kodiStays: no mode at the video's rate that Kodi takes), whose refresh rate is no whole
+ *        multiple of the frame rate. The Samsung Odyssey G60SD of the test of 2026-11-18 has no
+ *        mode of 24, 48 or 72 Hz: 23.976 fps went at a fixed 359.999 Hz, a refresh more for one
+ *        picture every 2.8 s. Decide() then says whether VRR can do it, as with the setting, and
+ *        the first flips whether it came on (CStartCheck: where it did not, it is as before).
+ */
+inline bool Automatic(bool setting, bool kodiStays, double menusRefresh, double fps)
+{
+  return !setting && kodiStays && !WholeMultipleOf(menusRefresh, fps);
+}
+
+/*!
+ * \brief Whether the mode sets of the menus leave VRR to the driver for "Video at its own rate"
+ *        without the setting (CHdmiVrrOff::Allowed()): the display declares VRR, and no mode at the
+ *        resolution of the menus is a whole multiple of the frame rate of films. A TV with modes of
+ *        24 Hz (the LG C5) has them: nothing changes there. The refresh rates are those of the modes
+ *        of that resolution, progressive and 2D.
+ */
+template<typename Rates>
+bool AutoForDisplay(bool displayVrr, const Rates& refreshes)
+{
+  if (!displayVrr)
+    return false;
+  bool any = false;
+  for (const double refresh : refreshes)
+  {
+    if (WholeMultipleOf(refresh, FILM_FPS))
+      return false;
+    any = true;
+  }
+  // (no mode known: not taken as none at that rate)
+  return any;
+}
+
 //! What Decide() is told
 struct Query
 {
-  bool setting = false; //!< videoscreen.hadesvrrvideo
+  //! videoscreen.hadesvrrvideo, or Automatic() (no mode at the video's rate)
+  bool setting = false;
   float fps = 0.0f; //!< the frame rate that Kodi chooses the mode for
   bool progressive = false; //!< CDVDStreamInfo::progressive, as the render manager keeps it
   bool is3D = false;
