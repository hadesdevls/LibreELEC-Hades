 xbmc/windowing/WinSystem.h          |  5 +-
 xbmc/windowing/gbm/HdmiVrrOff.h     |  9 ++-
 xbmc/windowing/gbm/VrrVideo.h       | 48 +++++++++++++++-
 xbmc/windowing/gbm/WinSystemGbm.cpp | 88 +++++++++++++++++++++++++----
 xbmc/windowing/gbm/WinSystemGbm.h   |  7 ++-
 6 files changed, 160 insertions(+), 17 deletions(-)

