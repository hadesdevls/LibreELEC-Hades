@@ -91,7 +91,7 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
   {
     RESOLUTION gui = res;
     if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
-                                                           gui))
+                                                           gui, false))
     {
       CLog::Log(LOGINFO,
                 "Display resolution ADJUST : {} ({}) kept: the video goes at its own rate with VRR",
@@ -119,6 +119,24 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
         CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(res).fRefreshRate, true, res);
 #endif
 
+  // Hades: where Kodi's choice stays in the mode of the menus and that mode has no whole multiple of
+  // the video's rate (a display without a mode at that rate), the video at its own rate with VRR, on
+  // its own (windowing/gbm/VrrVideo.h, Automatic()); fail-closed: where VRR does not come on, the
+  // video plays in Kodi's choice
+  if (!nativeDV && !is3D)
+  {
+    RESOLUTION gui = res;
+    if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
+                                                           gui, true))
+    {
+      CLog::Log(LOGINFO,
+                "Display resolution ADJUST : {} ({}) kept: no mode at the video's rate, which goes "
+                "at its own rate with VRR",
+                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui);
+      return gui;
+    }
+  }
+
   CLog::Log(LOGINFO, "Display resolution ADJUST : {} ({}) (weight: {:.3f})",
             CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(res).strMode, res, weight);
   return res;
