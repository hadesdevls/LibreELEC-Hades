-        fps, menusInfo.strMode, v.multiple, v.rate, q.vrrMin, q.vrrMax, PacingName(v.pacing));
+        fps, menusInfo.strMode, by, v.multiple, v.rate, q.vrrMin, q.vrrMax, PacingName(v.pacing));
