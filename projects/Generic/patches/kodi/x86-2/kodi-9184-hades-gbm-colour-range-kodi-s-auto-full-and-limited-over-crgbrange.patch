diff --git a/xbmc/windowing/gbm/RgbRange.h b/xbmc/windowing/gbm/RgbRange.h
index c3449be..4e1c71f 100644
--- a/xbmc/windowing/gbm/RgbRange.h
+++ b/xbmc/windowing/gbm/RgbRange.h
@@ -19,8 +19,9 @@ namespace GBM
 {
 
 /*!
- * \brief Hades: Kodi's "Use limited colour range (16-235)" made by the driver where the connector
- *        has the "Broadcast RGB" property, so that the range is compressed once
+ * \brief Hades: Kodi's "Colour range" (Auto, Full, Limited; Kodi's "Use limited colour range
+ *        (16-235)" before) made by the driver where the connector has the "Broadcast RGB" property,
+ *        so that the range is compressed once
  *
  * Kodi makes limited range by drawing everything in 16-235 (its GUI shaders, the video's shaders,
  * the GUI composed over HDR, the DRM PRIME renderer: all of them ask UseLimitedColor()). The
@@ -70,6 +71,12 @@ namespace GBM
  * the AVI InfoFrame; never with the Dolby VSIF, whatever the property says); a driver without it:
  * Kodi makes the range there, as before.
  *
+ * The setting has three values since Kodi's b4fd1ce (videoscreen.colorrange): Limited is the "Use
+ * limited colour range" above; Auto is that setting off; Full asks the driver for its "Full" (full
+ * range, and an AVI InfoFrame that says so where the sink can be told), which Kodi takes back to
+ * "Automatic" with Auto as it does its "Limited 16:235", and gives up after REFUSALS refusals (Kodi
+ * draws full range all along). Kodi's boolean setting becomes Limited once (Migrated()).
+ *
  * Nothing of DRM is here: a test runs it on the host (TestRgbRange.cpp).
  */
 class CRgbRange
@@ -82,6 +89,33 @@ public:
   //! commits refused with a value in them before Kodi gives that value up on an output
   static constexpr unsigned int REFUSALS = 2;
 
+  //! The colour range that the user chose (videoscreen.colorrange, with the values of its setting)
+  enum class Choice
+  {
+    AUTO = 0, //!< as the driver chooses: only Kodi's own values are taken back to "Automatic"
+    FULL = 1, //!< "Full": full range, and said so where the sink can be told
+    LIMITED = 2, //!< limited range (16-235), made by the driver where it can, else by Kodi
+  };
+
+  //! The choice of a value of the setting (Auto for one that is not a choice)
+  static Choice ChoiceOf(int value)
+  {
+    if (value < static_cast<int>(Choice::AUTO) || value > static_cast<int>(Choice::LIMITED))
+      return Choice::AUTO;
+    return static_cast<Choice>(value);
+  }
+
+  /*!
+   * \brief Hades: what the colour range becomes at a start where Kodi's boolean "Use limited colour
+   *        range" (legacyLimited) may still be on: Limited where the colour range is still at its
+   *        default (choiceIsDefault), else as it is. The caller turns the boolean off either way, or
+   *        choosing Auto later would be undone by the next start.
+   */
+  static Choice Migrated(bool legacyLimited, bool choiceIsDefault, Choice current)
+  {
+    return legacyLimited && choiceIsDefault ? Choice::LIMITED : current;
+  }
+
   //! What the connector offers, and the value the kernel has (the last commit)
   struct Connector
   {
@@ -95,18 +129,18 @@ public:
   //! to the next
   struct Requests
   {
-    //! commits refused with "Limited 16:235" (the setting on), or with Kodi's own value taken back
-    //! to "Automatic" (the setting off)
+    //! commits refused with "Limited 16:235" (Limited), or with Kodi's own value taken back to
+    //! "Automatic" (Auto)
     unsigned int refused = 0;
-    //! commits refused with "Full", asked in place of "Limited 16:235"
+    //! commits refused with "Full" (Full, or Limited in place of "Limited 16:235")
     unsigned int fullRefused = 0;
-    //! the kernel has "Full" because Kodi asked for it in place of "Limited 16:235" (it is taken
-    //! back with the setting off, as Kodi's "Limited 16:235" is)
+    //! the kernel has "Full" because Kodi asked for it (Full, or Limited in place of "Limited
+    //! 16:235"): it is taken back with Auto, as Kodi's "Limited 16:235" is
     bool ownFull = false;
 
     bool GivenUp() const { return refused >= REFUSALS; }
     bool FullGivenUp() const { return fullRefused >= REFUSALS; }
-    //! the setting changed: what it asks for is asked again, whatever the other one met
+    //! the choice changed: what it asks for is asked again, whatever the other one met
     void NewSetting()
     {
       refused = 0;
@@ -120,28 +154,36 @@ public:
     return connector.limited && connector.kernel && *connector.kernel == *connector.limited;
   }
 
-  //! The kernel has "Full", and Kodi asked for it in place of "Limited 16:235"
+  //! The kernel has "Full", and Kodi asked for it
   static bool KernelHasOwnFull(const Connector& connector, const Requests& requests)
   {
     return requests.ownFull && connector.full && connector.kernel &&
            *connector.kernel == *connector.full;
   }
 
-  //! Kodi draws in 16-235 (UseLimitedColor()): its setting (as the kernel has it: Settled()) asks
-  //! for limited range, and the driver does not make it on this output
-  static bool KodiCompresses(bool setting, const Connector& connector)
+  //! Kodi draws in 16-235 (UseLimitedColor()): its choice (as the kernel has it: Settled()) is
+  //! Limited, and the driver does not make it on this output
+  static bool KodiCompresses(Choice choice, const Connector& connector)
   {
-    return setting && !KernelLimits(connector);
+    return choice == Choice::LIMITED && !KernelLimits(connector);
   }
 
   //! The value that the property should have (nothing: it is left as the kernel has it)
-  static std::optional<uint64_t> Wanted(bool setting,
+  static std::optional<uint64_t> Wanted(Choice choice,
                                         const Connector& connector,
                                         const Requests& requests)
   {
     if (!connector.kernel || !connector.limited || !connector.automatic)
       return std::nullopt;
-    if (setting)
+    if (choice == Choice::FULL)
+    {
+      // full range, said so; nothing where the driver refused it REFUSALS times or has no "Full"
+      // (Kodi draws full range all the same)
+      if (connector.full && !requests.FullGivenUp())
+        return *connector.full;
+      return std::nullopt;
+    }
+    if (choice == Choice::LIMITED)
     {
       if (!requests.GivenUp())
         return *connector.limited;
@@ -151,8 +193,8 @@ public:
         return *connector.full;
       return std::nullopt;
     }
-    // (with the setting off, only Kodi's own values are taken back: "Automatic" and a "Full" that
-    // Kodi did not ask for stay)
+    // (Auto: only Kodi's own values are taken back; "Automatic", and a "Full" that Kodi did not ask
+    // for, stay)
     if (requests.GivenUp())
       return std::nullopt;
     if (*connector.kernel == *connector.limited || KernelHasOwnFull(connector, requests))
@@ -161,27 +203,29 @@ public:
   }
 
   /*!
-   * \brief Hades: the kernel has what the setting asks for, or nothing more is asked of it (the
