+// The colour range of Kodi's b4fd1ce: "Full" asked of the driver, the range drawn and said full
+TEST(TestRgbRange, FullAsksTheDriverForFull)
+{
+  Output out;
+  out.Frames(FUL, 3);
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_EQ(out.modeSets, 1);
+  EXPECT_TRUE(out.requests.ownFull);
+  EXPECT_FALSE(out.KodiCompresses(FUL));
+  // i915 sends the picture as it is at "Full": never compressed
+  EXPECT_EQ(out.Compressions(FUL), 0);
+}
+
+TEST(TestRgbRange, FullRefusedKodiDrawsFullAndAsksNoMore)
+{
+  Output out;
+  out.refused = {FULL};
+  out.Frames(FUL, 10);
+  EXPECT_TRUE(out.requests.FullGivenUp());
+  EXPECT_EQ(out.modeSets, static_cast<int>(CRgbRange::REFUSALS));
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.KodiCompresses(FUL));
+  EXPECT_FALSE(
+      CRgbRange::Stage(FUL, out.connector, out.requests, false, false, false, false).value);
+}
+
+TEST(TestRgbRange, WithoutAFullValueFullAsksNothing)
+{
+  Output out;
+  out.connector.full.reset();
+  out.Frames(FUL, 3);
+  EXPECT_EQ(out.modeSets, 0);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.KodiCompresses(FUL));
+}
+
+TEST(TestRgbRange, AutoTakesKodisFullBack)
+{
+  Output out;
+  out.Frames(FUL, 2);
+  ASSERT_EQ(out.connector.kernel, FULL);
+  out.Frames(AUT, 2);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_FALSE(out.requests.ownFull);
+  EXPECT_EQ(out.modeSets, 2);
+}
+
+TEST(TestRgbRange, AFullKodiDidNotAskForStaysWithFullAndWithAuto)
+{
+  Output out;
+  out.connector.kernel = FULL;
+  out.Frames(FUL, 3);
+  EXPECT_EQ(out.modeSets, 0);
+  EXPECT_FALSE(out.requests.ownFull);
+  out.Frames(AUT, 3);
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_EQ(out.modeSets, 0);
+}
+
+TEST(TestRgbRange, FromLimitedToFullAndBack)
+{
+  Output out;
+  out.Frames(LIM, 2);
+  ASSERT_EQ(out.connector.kernel, LIMITED);
+  out.Frames(FUL, 2);
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_FALSE(out.KodiCompresses(FUL));
+  out.Frames(LIM, 2);
+  EXPECT_EQ(out.connector.kernel, LIMITED);
+  EXPECT_FALSE(out.KodiCompresses(LIM));
+  EXPECT_EQ(out.Compressions(LIM), 1);
+  EXPECT_EQ(out.modeSets, 3);
+}
+
+TEST(TestRgbRange, FullChosenDuringAVideoWaitsForItsEnd)
+{
+  Output out;
+  out.Frames(AUT, 2);
+  out.videoPlays = true;
+  out.Frames(FUL, 5);
+  EXPECT_EQ(out.connector.kernel, AUTOMATIC);
+  EXPECT_EQ(out.modeSets, 0);
+  out.videoPlays = false;
+  out.Frames(FUL, 2);
+  EXPECT_EQ(out.connector.kernel, FULL);
+  EXPECT_EQ(out.modeSets, 1);
+}
+
+TEST(TestRgbRange, TheEndOfDolbyVisionGivesFullWhereFullIsChosen)
+{
+  CRgbRange::Requests fresh;
+  CRgbRange::Requests fullRefused;
+  fullRefused.fullRefused = CRgbRange::REFUSALS;
+  const CRgbRange::Connector foundAutomatic{AUTOMATIC, FULL, LIMITED, AUTOMATIC};
+  const CRgbRange::Connector foundFull{AUTOMATIC, FULL, LIMITED, FULL};
+  const CRgbRange::Connector foundLimited{AUTOMATIC, FULL, LIMITED, LIMITED};
+  EXPECT_EQ(CRgbRange::AtHandBack(FUL, foundAutomatic, fresh), FULL);
+  EXPECT_EQ(CRgbRange::AtHandBack(FUL, foundLimited, fresh), FULL);
+  EXPECT_FALSE(CRgbRange::AtHandBack(FUL, foundFull, fresh));
+  EXPECT_FALSE(CRgbRange::AtHandBack(FUL, foundAutomatic, fullRefused));
+}
+
+// Native Dolby Vision has "Full" from its transport whatever the choice: no value of the colour
+// range goes to the driver while it has the output, also where the request has the property
+TEST(TestRgbRange, NativeDolbyVisionIsFullWhateverTheChoice)
+{
+  const CRgbRange::Connector transport{AUTOMATIC, FULL, LIMITED, FULL};
+  for (const Choice choice : {AUT, FUL, LIM})
+    for (const bool inRequest : {false, true})
+    {
+      CRgbRange::Requests requests;
+      EXPECT_FALSE(
+          CRgbRange::Stage(choice, transport, requests, true, inRequest, true, false).value);
+      // and who compresses: nobody, at "Full" (Kodi draws full range unless the choice is Limited
+      // and the kernel does not limit; the DV bridge draws its own bytes either way)
+      EXPECT_FALSE(CRgbRange::KernelLimits(transport));
+    }
+}
+
+// Kodi's boolean "Use limited colour range" becomes the colour range once (Kodi's b4fd1ce)
+TEST(TestRgbRange, TheBooleanSettingBecomesTheColourRange)
+{
+  EXPECT_EQ(CRgbRange::Migrated(true, true, AUT), LIM);
+  // a colour range chosen already wins
+  EXPECT_EQ(CRgbRange::Migrated(true, false, FUL), FUL);
+  EXPECT_EQ(CRgbRange::Migrated(true, false, AUT), AUT);
+  // the boolean off changes nothing
+  EXPECT_EQ(CRgbRange::Migrated(false, true, AUT), AUT);
+  EXPECT_EQ(CRgbRange::Migrated(false, false, LIM), LIM);
+}
+
+TEST(TestRgbRange, AValueThatIsNoChoiceIsAuto)
+{
+  EXPECT_EQ(CRgbRange::ChoiceOf(-1), AUT);
+  EXPECT_EQ(CRgbRange::ChoiceOf(0), AUT);
+  EXPECT_EQ(CRgbRange::ChoiceOf(1), FUL);
+  EXPECT_EQ(CRgbRange::ChoiceOf(2), LIM);
+  EXPECT_EQ(CRgbRange::ChoiceOf(3), AUT);
 }
