+void WriteVideoFrame(const KODI::RENDERING::CAPTURE::CaptureResult& result,
+                     const std::string& target)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+  if (!result.pixels)
+  {
+    VideoFrameNotSaved(result.videoWhyNot.empty() ? "the picture of the frame could not be read"
+                                                  : result.videoWhyNot,
