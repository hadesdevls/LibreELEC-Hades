diff --git a/xbmc/interfaces/builtins/GUIBuiltins.cpp b/xbmc/interfaces/builtins/GUIBuiltins.cpp
index 8f74ddd..0b4f591 100644
--- a/xbmc/interfaces/builtins/GUIBuiltins.cpp
+++ b/xbmc/interfaces/builtins/GUIBuiltins.cpp
@@ -388,16 +388,13 @@ static int Screenshot(const std::vector<std::string>& params)
   const auto content = video ? KODI::RENDERING::CAPTURE::CaptureContent::VIDEO
                              : KODI::RENDERING::CAPTURE::CaptureContent::COMPOSITE;
 
+  // Hades: the frame of the video alone at its own size, as videoNNNNN.png in the folder given or the
+  // screenshot folder, or into the file given; it says on the screen when no video is drawn
+  // (Shift+Print Screen)
   if (video)
   {
-    // a video-only capture has nothing to read when no video is rendering
-    const auto& components = CServiceBroker::GetAppComponents();
-    const auto appPlayer = components.GetComponent<CApplicationPlayer>();
-    if (!appPlayer->IsRenderingVideo())
-    {
-      CLog::Log(LOGWARNING, "TakeScreenshot(video) with no video rendering");
-      return 0;
-    }
+    CScreenShot::TakeVideoFrame(strSaveToPath);
+    return 0;
   }
 
   if (!strSaveToPath.empty())
@@ -656,7 +653,8 @@ static int ToggleDirty(const std::vector<std::string>&)
