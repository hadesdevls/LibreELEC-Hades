+
+void CScreenShot::TakeVideoFrame(const std::string& target)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+
+  const auto captureService = CServiceBroker::GetCaptureService();
+  if (!captureService)
+    return;
+  // (a capture of the video has nothing to read where none is drawn)
+  const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  if (!appPlayer || !appPlayer->IsRenderingVideo())
+  {
+    VideoFrameNotSaved("no video is drawn", 62863, 54863);
+    return;
+  }
+
+  // submitted before anything else, so that the frame on the screen now is the one taken: the
+  // folder, the name and the writing come in the callback, on the capture service's worker
+  CaptureSpec spec;
+  spec.content = CaptureContent::VIDEO;
+  spec.format = CaptureFormat::NATIVE;
+  spec.videoOwnSize = true;
+  auto handle = captureService->Submit(spec, [target](const CaptureResult& result)
+                                       { WriteVideoFrame(result, target); });
+  handle->Detach();
+}
