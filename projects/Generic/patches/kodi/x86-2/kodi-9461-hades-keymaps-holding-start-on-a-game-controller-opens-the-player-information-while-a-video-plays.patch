From aa744cfb58b558a4b0da536be049679144f7b47d Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 04:04:23 +0000
Subject: [PATCH] [Hades][Keymaps] Holding Start on a game controller opens the
 player information while a video plays

The player information opens with O on a keyboard, with the title and red
keys on a remote and with a long press of Menu. A game controller had no
button for it: an Xbox controller user had to add a keymap of his own.

In the FullscreenVideo and FullscreenInfo sections of the default
joystick keymap, holding Start (the Menu button of an Xbox controller,
which the default controller profile names start) for 500 ms opens it
with the same action (PlayerProcessInfo), as a long press of Menu does
on a remote. A short press of Start does what it did (Info in a video,
Close over its info). Neither section had a hold of Start, and no other
button changes.
---
 system/keymaps/joystick.xml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/system/keymaps/joystick.xml b/system/keymaps/joystick.xml
index 41a65db..d8ca992 100644
--- a/system/keymaps/joystick.xml
+++ b/system/keymaps/joystick.xml
@@ -112,6 +112,11 @@
       <x>OSD</x>
       <y>FullScreen</y>
       <start>Info</start>
+      <!-- Hades: holding Start opens the player information, as a long press of Menu does on a remote; a short
+           press is Info, as before. Start is the Menu button of an Xbox controller and Options of a PlayStation one
+           (DualShock 4, DualSense), over USB and over Bluetooth, by the button maps of peripheral.joystick; on any
+           other controller, the button mapped as Start in Settings > System > Input -->
+      <start holdtime="500">PlayerProcessInfo</start>
       <back>FullScreen</back>
       <guide>OSD</guide>
       <up>ChapterOrSceneOrBigStepForward</up>
@@ -234,6 +239,8 @@
       <b>Close</b>
       <x>OSD</x>
       <start>Close</start>
+      <!-- Hades: holding Start opens the player information, as in FullscreenVideo -->
+      <start holdtime="500">PlayerProcessInfo</start>
       <lefttrigger>AnalogRewind</lefttrigger>
       <righttrigger>AnalogFastForward</righttrigger>
       <leftbumper>AnalogRewind</leftbumper>
-- 
