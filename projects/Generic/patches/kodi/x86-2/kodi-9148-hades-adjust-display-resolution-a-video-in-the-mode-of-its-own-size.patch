--- a/xbmc/windowing/Resolution.cpp
+++ b/xbmc/windowing/Resolution.cpp
@@ -19,6 +19,7 @@
 #include "utils/Variant.h"
 #include "utils/log.h"
 #include "windowing/ExactRateElsewhere.h"
+#include "windowing/VideoSizeMode.h"
 #include "windowing/WinSystem.h"
 #include "windowing/gbm/VrrVideo.h" // (Hades: pure, no GBM of its own)
 #ifdef HAVE_DVBRIDGE
@@ -42,13 +43,60 @@ const char* SETTING_VIDEOSCREEN_WHITELIST_DOUBLEREFRESHRATE{
 // allow hardware decoder surface padding due to codec block alignment and GPU requirements
 // (height has greater tolerance due to 32/64px boundaries e.g. 1080→1088 or 2160→2176) and
 // encoder cropping of up to 2% e.g. 3840→3832
+// (Hades: the rule is in VideoSizeMode.h, which "Adjust display resolution" takes too)
 bool MatchesMode(int width, int height, const RESOLUTION_INFO& info)
 {
-  const auto withinTolerance = [](int v, int screen, int pad)
-  { return v <= screen + pad && v >= screen * 0.98; };
+  return KODI::WINDOWING::VIDEO_SIZE::OfVideoSize(width, height, info.iScreenWidth,
+                                                  info.iScreenHeight);
+}
+
+// Hades: "Adjust display resolution" (Player > Videos)
+const char* SETTING_VIDEOPLAYER_HADESADJUSTRESOLUTION{"videoplayer.hadesadjustresolution"};
 
-  return (withinTolerance(height, info.iScreenHeight, 32) && width <= info.iScreenWidth + 8) ||
-         (withinTolerance(width, info.iScreenWidth, 8) && height <= info.iScreenHeight + 32);
+// Hades: "Adjust display resolution" (VideoSizeMode.h): the mode of the video's size at the refresh
+// rate that Kodi chose for it (res), where the display has one
+void AdjustToVideoSize(int width, int height, bool nativeDV, RESOLUTION& res)
+{
+  namespace SIZE = KODI::WINDOWING::VIDEO_SIZE;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  const bool setting = settings->GetBool(SETTING_VIDEOPLAYER_HADESADJUSTRESOLUTION);
+  if (const char* notLooked =
+          SIZE::NotLooked(setting, CResolutionUtils::HasWhitelist(), nativeDV, width, height))
+  {
+    if (setting)
+      CLog::Log(LOGINFO, "Adjust display resolution: not for this video: {}", notLooked);
+    return;
+  }
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const RESOLUTION_INFO chosenInfo = gfx.GetResInfo(res);
+  const SIZE::Mode chosen{chosenInfo.iScreenWidth, chosenInfo.iScreenHeight,
+                          chosenInfo.fRefreshRate, chosenInfo.dwFlags & D3DPRESENTFLAG_MODEMASK};
+  std::vector<RESOLUTION> candidates;
+  gfx.GetAllowedResolutions(candidates);
+  std::vector<SIZE::Mode> modes;
+  modes.reserve(candidates.size());
+  for (const RESOLUTION r : candidates)
+  {
+    const RESOLUTION_INFO info = gfx.GetResInfo(r);
+    modes.push_back({info.iScreenWidth, info.iScreenHeight, info.fRefreshRate,
+                     info.dwFlags & D3DPRESENTFLAG_MODEMASK});
+  }
+  const int place = SIZE::Choose(modes, chosen, width, height);
+  if (place < 0)
+  {
+    CLog::Log(LOGINFO, "Adjust display resolution: {} stays for the video of {}x{}: {}",
+              chosenInfo.strMode, width, height,
+              SIZE::OfVideoSize(width, height, chosen.width, chosen.height)
+                  ? "it is of the video's size"
+                  : "the display has no mode of the video's size at its refresh rate");
+    return;
+  }
+  const RESOLUTION taken = candidates[static_cast<size_t>(place)];
+  CLog::Log(LOGINFO,
+            "Adjust display resolution: {} instead of {} for the video of {}x{}, at the same "
+            "refresh rate: the display scales it",
+            gfx.GetResInfo(taken).strMode, chosenInfo.strMode, width, height);
+  res = taken;
 }
 
 } // namespace
@@ -143,6 +191,10 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
     }
   }
 
+  // Hades: "Adjust display resolution": the mode of the video's size at the refresh rate chosen
+  // above, where the display has one (VideoSizeMode.h); never where VRR took the video (above)
+  AdjustToVideoSize(width, height, nativeDV, res);
+
   CLog::Log(LOGINFO, "Display resolution ADJUST : {} ({}) (weight: {:.3f})",
             CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(res).strMode, res, weight);
   return res;
