+/*!
+ * \brief Hades: "Adjust display resolution" (videoplayer.hadesadjustresolution, Player > Videos,
+ *        next to Kodi's "Adjust display refresh rate"): a video goes out in a mode of its own size
+ *        where the display has one at the refresh rate Kodi chose for it
+ *
+ * Kodi changes the resolution for a video only where a whitelist of the user lists the modes of
+ * other sizes (System > Display > Whitelist, Expert). Without one, its default whitelist holds the
+ * modes no smaller than the menus, so a TV with the menus at 3840x2160 plays a film of 1920x1080 at
+ * 3840x2160, scaled by the graphics card. With this setting on, Kodi chooses the refresh rate as it
+ * always does (the exact rate, twice it, 3:2, the whole multiples and the 25p and 30p rules of
+ * Hades, a mode at the rate at another size), and then the mode of the video's size at that refresh
+ * rate is taken where the display has one: 1920x1080 for a video of 1920x1080 (or 1920x800, a scope
+ * film), 1280x720 for 720p, 720x576 or 720x480 for a DVD. The TV scales the picture then; the
+ * upscalers of LibreELEC Hades (the Video page of the player information) and Kodi's scaling
+ * method only act where the graphics card scales.
+ *
+ * - "of the video's size" is Kodi's own rule for it (MatchesMode() of Resolution.cpp, which calls
+ *   OfVideoSize()): the height within 2 % under and 32 lines over the mode's and the width no
+ *   more than 8 over it, or the other way round (a decoder pads to its blocks, an encoder crops).
+ *   Of the modes that are, the nearest to the video; of those, the nearest to the refresh rate.
+ * - the refresh rate is the one Kodi chose, within 0.01 Hz (MathUtils::FloatEquals as Kodi's
+ *   whitelist compares rates), and the mode of the same kind (interlaced or not, the same 3D
+ *   layout): the cadence never changes.
+ * - a mode Kodi chose that is of the video's size already stays (a 4K film on a 4K TV).
+ * - with a whitelist of the user, nothing: the user chose the modes and their sizes there, and Kodi
+ *   takes those of the video's size already (a whitelist that lists 1920x1080 plays 1080p in it).
+ * - native Dolby Vision keeps its transport, 3840x2160: the mode of its refresh rate at 3840x2160,
+ *   as without the setting. The HDMI policy of the tunnel in the kernel takes CTA 1080p as well
+ *   (drm_dvbridge.h), but the engine of the bridge is made for a raster of 3840x2160 alone: the
+ *   index of the pixel that carries each bit of the metadata (3840 * row + column), its picture,
+ *   caches and composition of the interface, its tiles of 16 lines (1080 is not a multiple of 16:
+ *   the static assertions of dvbridge_source.c), the level 5 area on that raster and the check of
+ *   its bytes; and so are the window, the buffers, the capture and the viewport of native output
+ *   (DVPlaybackPolicy.h). Dolby Vision played as HDR10 or SDR, HDR10, HDR10+, HLG and 3D take the
+ *   mode of their size.
+ * - where VRR takes the video ("Video at its own rate with VRR"), Kodi's choice ends there, in the
+ *   mode of the menus: this is not asked.
+ *
+ * Only what is decided is here, with nothing of Kodi in it, so that a test runs it on the host
+ * (video_size_test.cpp).
+ */
+
+//! A mode of the display, as Kodi lists its resolutions
+struct Mode
+{
+  int width = 0; //!< iScreenWidth
+  int height = 0; //!< iScreenHeight
+  double refresh = 0.0; //!< fRefreshRate
+  unsigned int kind = 0; //!< its dwFlags & D3DPRESENTFLAG_MODEMASK (interlaced, 3D layouts)
+};
+
+//! Two rates are one within this (Kodi's whitelist: MathUtils::FloatEquals(a, b, 0.01f))
+inline constexpr double SAME_RATE = 0.01;
+
+//! Kodi's rule for a mode of the size of the video (MatchesMode() of Resolution.cpp): a decoder pads
+//! its pictures to its blocks (1080 to 1088) and an encoder crops up to 2 % (3840 to 3832)
+inline bool OfVideoSize(int videoWidth, int videoHeight, int screenWidth, int screenHeight)
+{
+  const auto withinTolerance = [](int v, int screen, int pad)
+  { return v <= screen + pad && v >= screen * 0.98; };
+
+  return (withinTolerance(videoHeight, screenHeight, 32) && videoWidth <= screenWidth + 8) ||
+         (withinTolerance(videoWidth, screenWidth, 8) && videoHeight <= screenHeight + 32);
+}
+
+//! Why the setting does not look for a mode, for the log; nullptr: it looks
+inline const char* NotLooked(bool setting, bool userWhitelist, bool nativeDV, int width, int height)
+{
+  if (!setting)
+    return "\"Adjust display resolution\" is off";
+  if (userWhitelist)
+    return "the whitelist of the user chooses the modes and their sizes";
+  if (nativeDV)
+    return "native Dolby Vision keeps its transport of 3840x2160";
+  if (width <= 0 || height <= 0)
+    return "the size of the video is not known";
+  return nullptr;
+}
+
+/*!
+ * \brief The mode of the video's size at the refresh rate of the mode Kodi chose
+ * \param modes the modes of the display (Kodi's allowed resolutions)
+ * \param chosen the mode Kodi chose for the video
+ * \return its place in modes; -1 where chosen stays: it is of the video's size already, or the
+ *         display has no mode of that size at its refresh rate, of its kind
+ */
+inline int Choose(const std::vector<Mode>& modes,
+                  const Mode& chosen,
+                  int videoWidth,
+                  int videoHeight)
+{
+  if (OfVideoSize(videoWidth, videoHeight, chosen.width, chosen.height))
+    return -1;
+  int place = -1;
+  int bestSize = 0;
+  double bestRate = 0.0;
+  for (std::size_t i = 0; i < modes.size(); ++i)
+  {
+    const Mode& m = modes[i];
+    const double rateOff = std::fabs(m.refresh - chosen.refresh);
+    if (m.kind != chosen.kind || !(rateOff < SAME_RATE) ||
+        !OfVideoSize(videoWidth, videoHeight, m.width, m.height))
+      continue;
+    const int sizeOff = std::abs(m.height - videoHeight) + std::abs(m.width - videoWidth);
+    if (place < 0 || sizeOff < bestSize || (sizeOff == bestSize && rateOff < bestRate))
+    {
+      place = static_cast<int>(i);
+      bestSize = sizeOff;
+      bestRate = rateOff;
+    }
+  }
+  return place;
+}
+
+} // namespace KODI::WINDOWING::VIDEO_SIZE
