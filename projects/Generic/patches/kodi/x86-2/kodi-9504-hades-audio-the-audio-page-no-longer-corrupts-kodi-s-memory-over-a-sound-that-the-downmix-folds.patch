From ec0e1fd433af52775388ed6cf8f8f5fb22d2ccbd Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:32:48 +0000
Subject: [PATCH] [Hades][Audio] The Audio page no longer corrupts Kodi's
 memory over a sound that the downmix folds

Opening the player information over a video whose sound Hades decodes
and folds into fewer channels (a 7.1 or a 12-channel PCM track to a
stereo output, in QEMU) crashed Kodi every time: SIGSEGV in HarfBuzz
shaping a label of the dialog, or in a std::map, with any skin of the
dialog. 1.2.2 brought it with the downmix row of the Audio page.

The row builds the matrix of the downmix with swr_build_matrix2() and
gave it a buffer of the input's channels times the output's (16 doubles
for 7.1 to stereo, with a stride of 8). libswresample (rematrix.c of
FFmpeg 9.1) normalises a matrix whose rows add up to more than maxval,
and applies rematrix_volume, over a whole block of SWR_CH_MAX x
SWR_CH_MAX (64) coefficients, matrix[stride * out + in] for out and in
up to 64, whatever the layouts: over 500 doubles past the buffer were
divided, and the heap was corrupted. The buffer is now that whole
block, read with a stride of 64 (SpeakerPlan.h, SWR_MATRIX_SIZE).

And a video without a stream of sound no longer shows speakers that get
sound: the sink stays open with the silence it is fed, and the plan lit
its two channels.
---
 xbmc/utils/SpeakerPlan.h                      | 15 ++++++++++
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 29 ++++++++++++-------
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  3 +-
 3 files changed, 36 insertions(+), 11 deletions(-)

diff --git a/xbmc/utils/SpeakerPlan.h b/xbmc/utils/SpeakerPlan.h
index 1e16525..0fc3fe8 100644
--- a/xbmc/utils/SpeakerPlan.h
+++ b/xbmc/utils/SpeakerPlan.h
@@ -646,6 +646,21 @@ inline Plan PlanOf(Path path,
   return plan;
 }
 
+/*!
+ * \brief The matrix that swr_build_matrix2() is given: the whole block of 64 x 64 coefficients that
+ *        libswresample writes, whatever the layouts
+ *
+ * libswresample (rematrix.c of FFmpeg 9.1) scales every coefficient of a block of SWR_CH_MAX x
+ * SWR_CH_MAX (64, internal to it) when it normalises a matrix whose rows add up to more than maxval
+ * and when it applies rematrix_volume: matrix[stride * out + in] for out and in up to 64, not up to
+ * the channels of the layouts. A matrix of the input's channels times the output's (16 doubles for
+ * 7.1 to stereo, with a stride of 8) was overrun by over 500 doubles: the heap of Kodi corrupted each
+ * time the Audio page opened over a sound that the downmix folds, and Kodi crashed then or later
+ * (in HarfBuzz shaping a label, in a std::map). Folded() reads it with this stride.
+ */
+inline constexpr std::size_t SWR_MATRIX_STRIDE = 64;
+inline constexpr std::size_t SWR_MATRIX_SIZE = SWR_MATRIX_STRIDE * SWR_MATRIX_STRIDE;
+
 /*!
  * \brief What a downmix folds into what: for each channel of the input that the output does not
  *        have, the output channels that it goes into, by a matrix as libswresample builds it
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 599af40..28214f5 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -2429,13 +2429,17 @@ std::vector<std::string> ChannelNamesOf(const std::string& list)
 void CWinSystemGbmGLESContext::SpeakerPlanInfo(std::map<std::string, std::string>& info,
                                                const std::string& streamLit,
                                                const std::string& streamChannels,
-                                               const std::string& codec) const
+                                               const std::string& codec,
+                                               bool sound) const
 {
   namespace SP = KODI::UTILS::SPEAKER_PLAN;
   const std::string& kind = info["hades.audio.path"];
-  const SP::Path path = kind == "bitstream" ? SP::Path::PASSTHROUGH
-                        : kind == "pcm"     ? SP::Path::DECODED
-                                            : SP::Path::NOT_KNOWN;
+  // (Hades: a video without a stream of sound sends none, though the sink stays open with the
+  // silence it is fed: no speaker of the plan gets sound then)
+  const SP::Path path = !sound               ? SP::Path::NOT_KNOWN
+                        : kind == "bitstream" ? SP::Path::PASSTHROUGH
+                        : kind == "pcm"       ? SP::Path::DECODED
+                                              : SP::Path::NOT_KNOWN;
   // what Hades sends, where it decodes: the layout that the sink was opened with
   std::vector<std::string> sentNames;
   AEAudioFormat sink;
@@ -2583,17 +2587,22 @@ void CWinSystemGbmGLESContext::SpeakerPlanInfo(std::map<std::string, std::string
   const auto settings = component ? component->GetSettings() : nullptr;
   const double lfe =
       settings ? settings->GetInt(CSettings::SETTING_AUDIOOUTPUT_MIXSUBLEVEL) / 100.0 : 0.0;
-  const std::size_t stride = static_cast<std::size_t>(inLayout.nb_channels);
-  std::vector<double> matrix(stride * static_cast<std::size_t>(outLayout.nb_channels));
+  // (the whole block that libswresample writes, 64 x 64, whatever the layouts: a matrix of their
+  // channels alone was overrun and the heap corrupted, SP::SWR_MATRIX_SIZE)
+  const std::size_t inChannels = static_cast<std::size_t>(inLayout.nb_channels);
+  std::vector<double> matrix(SP::SWR_MATRIX_SIZE);
   const int built =
       swr_build_matrix2(&inLayout, &outLayout, M_SQRT1_2, M_SQRT1_2, lfe, 1.0, 1.0, matrix.data(),
-                        static_cast<ptrdiff_t>(stride), AV_MATRIX_ENCODING_NONE, nullptr);
+                        static_cast<ptrdiff_t>(SP::SWR_MATRIX_STRIDE), AV_MATRIX_ENCODING_NONE,
+                        nullptr);
   av_channel_layout_uninit(&inLayout);
   av_channel_layout_uninit(&outLayout);
-  if (built < 0 || inOrdered.size() != stride || outOrdered.size() != out.size())
+  if (built < 0 || inOrdered.size() != inChannels || outOrdered.size() != out.size() ||
+      inChannels > SP::SWR_MATRIX_STRIDE || out.size() > SP::SWR_MATRIX_STRIDE)
     return;
   std::string dropped;
-  info["hades.audio.fold"] = SP::Folded(inOrdered, outOrdered, matrix, stride, dropped);
+  info["hades.audio.fold"] =
+      SP::Folded(inOrdered, outOrdered, matrix, SP::SWR_MATRIX_STRIDE, dropped);
   info["hades.audio.folddrop"] = dropped;
 }
 
@@ -13967,7 +13976,7 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     const SpeakersShown speakers = SpeakersOrUsual(channels, bed, audio.channels);
     // (Hades: ... with what Hades sends, what the display or receiver declares and the objects it
     // renders, and what a downmix folds: SpeakerPlan.h)
-    SpeakerPlanInfo(info, speakers.lit, channels, audio.codecName);
+    SpeakerPlanInfo(info, speakers.lit, channels, audio.codecName, player->GetAudioStream() >= 0);
     info["hades.audio.spkfrom"] = speakers.fromCount ? "count" : "";
     // ... and kodi.log says what the player said, once a video, where that named no speaker for 3 s
     // of the page open with a stream of sound playing
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index 519489e..b79804b 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -719,7 +719,8 @@ private:
   void SpeakerPlanInfo(std::map<std::string, std::string>& info,
                        const std::string& streamLit,
                        const std::string& streamChannels,
-                       const std::string& codec) const;
+                       const std::string& codec,
+                       bool sound) const;
   std::future<HOTPLUG_RELINK::ScdcRead> m_deepLockRead;
   HDR_MORE_BITS::Made m_hdrOnOutput{HDR_MORE_BITS::Made::NOTHING};
   bool m_hdrLockArmed{false};
-- 
2.53.0

