From fae1b6f39f3fa009b99d2f6caa9bb64c25c7bf64 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 23:32:11 +0000
Subject: [PATCH] [Hades][VideoPlayer] MV-HEVC: a picture of the card's decoder
 returned after it was given up is not shown

FFmpeg's decoder of both views with a second decoder for the base view
(base_layer_decoder=separate, the graphics card's VAAPI decoder) marks a
picture whose base view that decoder gave and that is returned after it
was given up: it says the error (lavc.hevc.base_layer_error) and is
marked corrupt. With frame threads such a picture can be the first one
of the card's decoder that Kodi sees: it was set up while the picture
whose comparison found the card wrong was still being decoded.
HybridSaw() took an error before any picture of the card for "given up
before use" and kept the picture; it now opens the stream again from
its last key frame, the processor decoding both views, as where the card
was given up after its pictures were used, and that picture is not
shown.
---
 xbmc/cores/VideoPlayer/MultiviewChoice.h | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index ceca094..5316e47 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -1312,7 +1312,11 @@ struct HybridState
  * next key frame, but a picture before that may not be (it is then marked corrupt, or not
  * decoded): the stream is opened again at once, the processor decoding both views, and the player
  * sends the packets since the last key frame again (as where NVDEC is given up). (FFmpeg marks a
- * picture corrupt for this only after it gave the card up, so the error says it first.)
+ * picture corrupt for this only after it gave the card up, so the error says it first.) A picture
+ * whose base view the card gave and that says the error was set up before the card's decoder was
+ * given up and returned after (FFmpeg marks it as it is returned): it may hold the card's wrong
+ * picture, so it is not shown either, and the stream is opened again, also where it is the first
+ * picture of the card that Kodi sees.
  */
 inline HybridStep HybridSaw(HybridState& state, std::string_view mode, std::string_view error)
 {
@@ -1321,7 +1325,7 @@ inline HybridStep HybridSaw(HybridState& state, std::string_view mode, std::stri
   if (!error.empty())
   {
     state.givenUp = true;
-    return state.separate ? HybridStep::REOPEN : HybridStep::GIVEN_UP;
+    return state.separate || mode == "separate" ? HybridStep::REOPEN : HybridStep::GIVEN_UP;
   }
   if (mode == "separate" && !state.separate)
   {
