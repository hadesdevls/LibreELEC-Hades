+
+// Hades: what the log says of a join whose streams differ, so that one log of any disc tells which
+// check stopped it: the list or the part of the clips, the stream (its number and PID), and each
+// value that differs, as the play item before has it -> as the next one has it. Text only: what is
+// compared, and so the verdict, is SameStream() and SameClipStream().
+namespace SAY
+{
+inline std::string Hex(unsigned value)
+{
+  char text[16];
+  std::snprintf(text, sizeof(text), "0x%x", value);
+  return text;
+}
+
+inline std::string Number(unsigned value)
+{
+  return std::to_string(value);
+}
+
+//! A language code of a stream: its letters, "none" for none; raw, its bytes (where two codes
+//! differ in bytes that their letters do not show)
+inline std::string Language(const void* code, size_t size, bool raw)
+{
+  const auto* bytes = static_cast<const unsigned char*>(code);
+  std::string text;
+  if (raw)
+  {
+    for (size_t i = 0; i < size; ++i)
+    {
+      char hex[4];
+      std::snprintf(hex, sizeof(hex), "%02x", bytes[i]);
+      text += hex;
+    }
+    return "0x" + text;
+  }
+  for (size_t i = 0; i < size && bytes[i]; ++i)
+    text += (bytes[i] >= 0x20 && bytes[i] < 0x7f) ? static_cast<char>(bytes[i]) : '?';
+  return text.empty() ? std::string("none") : text;
+}
+
+//! The values that differ between two streams: "name before -> after", joined by ", "
+class CDifferences
+{
+public:
+  void Value(const char* name, unsigned before, unsigned after, bool hex = true)
+  {
+    if (before != after)
+      Add(name, hex ? Hex(before) : Number(before), hex ? Hex(after) : Number(after));
+  }
+  void LanguageOf(const void* before, const void* after, size_t size)
+  {
+    if (std::memcmp(before, after, size) == 0)
+      return;
+    const bool raw = Language(before, size, false) == Language(after, size, false);
+    Add("language", Language(before, size, raw), Language(after, size, raw));
+  }
+  void Text(const std::string& text)
+  {
+    if (!m_text.empty())
+      m_text += ", ";
+    m_text += text;
+  }
+  const std::string& Said() const { return m_text; }
+
+private:
+  void Add(const char* name, const std::string& before, const std::string& after)
+  {
+    Text(std::string(name) + " " + before + " -> " + after);
+  }
+  std::string m_text;
+};
+
+//! What differs between two streams that the playlist presents (every value SameStream() compares)
+inline std::string Differences(const BLURAY_STREAM_INFO& a, const BLURAY_STREAM_INFO& b)
+{
+  CDifferences d;
+  d.Value("PID", a.pid, b.pid);
+  d.Value("coding", a.coding_type, b.coding_type);
+  d.Value("format", a.format, b.format);
+  d.Value("rate", a.rate, b.rate);
+  d.Value("character code", a.char_code, b.char_code);
+  d.LanguageOf(a.lang, b.lang, sizeof(a.lang));
+  d.Value("aspect", a.aspect, b.aspect);
+  d.Value("sub-path", a.subpath_id, b.subpath_id, false);
+  d.Value("dynamic range", a.dynamic_range_type, b.dynamic_range_type, false);
+  d.Value("colour space", a.color_space, b.color_space, false);
+  d.Value("CR flag", a.cr_flag, b.cr_flag, false);
+  d.Value("HDR10+ flag", a.hdr_plus_flag, b.hdr_plus_flag, false);
+  return d.Said();
+}
+
+//! What differs between two elementary streams of the clips (every value SameClipStream() compares)
+inline std::string Differences(const CLPI_PROG_STREAM& a, const CLPI_PROG_STREAM& b)
+{
+  CDifferences d;
+  d.Value("PID", a.pid, b.pid);
+  d.Value("coding", a.coding_type, b.coding_type);
+  d.Value("format", a.format, b.format);
+  d.Value("rate", a.rate, b.rate);
+  d.Value("aspect", a.aspect, b.aspect);
+  d.Value("OC flag", a.oc_flag, b.oc_flag, false);
+  d.Value("character code", a.char_code, b.char_code);
+  d.LanguageOf(a.lang, b.lang, sizeof(a.lang));
+  d.Value("CR flag", a.cr_flag, b.cr_flag, false);
+  d.Value("dynamic range", a.dynamic_range_type, b.dynamic_range_type, false);
+  d.Value("colour space", a.color_space, b.color_space, false);
+  d.Value("HDR10+ flag", a.hdr_plus_flag, b.hdr_plus_flag, false);
+  return d.Said();
+}
+
+//! What differs between the program maps of two clips: their PIDs, how many elementary streams they
+//! have, and the PIDs that only one of the two carries
+inline std::string ProgramMaps(const CLPI_PROG& a, const CLPI_PROG& b)
+{
+  CDifferences d;
+  d.Value("program map PID", a.program_map_pid, b.program_map_pid);
+  d.Value("elementary streams", a.num_streams, b.num_streams, false);
+  if ((a.num_streams && !a.streams) || (b.num_streams && !b.streams))
+  {
+    d.Text("elementary streams not readable");
+    return d.Said();
+  }
+  const auto only = [&d](const CLPI_PROG& one, const CLPI_PROG& other, const char* where)
+  {
+    for (unsigned i = 0; i < one.num_streams; ++i)
+    {
+      bool found = false;
+      for (unsigned j = 0; j < other.num_streams && !found; ++j)
+        found = other.streams[j].pid == one.streams[i].pid;
+      if (!found)
+        d.Text("PID " + Hex(one.streams[i].pid) + " with coding " +
+               Hex(one.streams[i].coding_type) + " only in the clip " + where);
+    }
+  };
+  only(a, b, "before");
+  only(b, a, "after");
+  return d.Said();
+}
+} // namespace SAY
+
+/*!
+ * \brief Whether two lists of the streams that the playlist presents are the same
+ * \param name the name of the list, for what
+ * \param what where they differ, for the log: the count, or the stream and what differs in it
+ */
 inline bool SameStreamList(unsigned countA,
                            const BLURAY_STREAM_INFO* a,
                            unsigned countB,
-                           const BLURAY_STREAM_INFO* b)
+                           const BLURAY_STREAM_INFO* b,
+                           const char* name = "the",
+                           std::string* what = nullptr)
 {
-  if (countA != countB)
+  const auto say = [name, what](const std::string& text)
+  {
+    if (what)
+      *what = name + text;
     return false;
+  };
+  if (countA != countB)
+    return say(" streams: " + SAY::Number(countA) + " -> " + SAY::Number(countB));
   if (countA && (!a || !b))
-    return false;
+    return say(" streams: not readable");
   for (unsigned i = 0; i < countA; ++i)
     if (!SameStream(a[i], b[i]))
-      return false;
+      return say(" stream " + SAY::Number(i + 1) + " of " + SAY::Number(countA) + ", PID " +
+                 SAY::Hex(a[i].pid) + ": " + SAY::Differences(a[i], b[i]));
   return true;
 }
 
@@ -149,28 +312,15 @@ inline bool SameStreams(const BLURAY_CLIP_INFO& a, const BLURAY_CLIP_INFO& b, st
       {"Dolby Vision", a.dv_stream_count, b.dv_stream_count, a.dv_streams, b.dv_streams},
   };
   for (const List& list : lists)
-    if (!SameStreamList(list.countA, list.a, list.countB, list.b))
-    {
-      if (what)
-        *what = std::string(list.name) + " streams";
