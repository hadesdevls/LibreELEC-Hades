From 0038d8cbbbd6c0d8ec6d4bd859af92ee35bfe83e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 07:06:06 +0000
Subject: [PATCH] [Hades][VideoPlayer] The decoder of both views runs with 24
 frame threads at most

FFmpeg's HEVC decoder now starts the next access unit of an MV-HEVC
stream once the second view's picture is started, before the base view's
slices are decoded (ffmpeg-9974), so that two views gain from frame
threads as one view does, and still gain past 16 threads: the threads
wait on the rows of their references rather than on the cores. Measured
on a Ryzen 9 7950X3D, two views of 3840x2160 at 23.976 with one slice a
picture and no WPP, 8 bits at 84 Mbit/s and 10 bits at 77 Mbit/s, in
pictures of two views a second: 8 threads 63.0 and 61.7, 16 threads 76.6
and 75.2, 24 threads 97.3 and 90.5; 24 threads on 8 of its cores with
their second threads, as an 8-core processor runs them, 99.1 and 94.3.

Kodi gives the decoder one and a half threads per processor; for two
views that is now 24 at most, where it was 8 (every other software
decoder keeps 16). The decoder's memory grows with its threads: 1.4 and
2.1 GiB with 24 against 1.1 and 1.6 GiB with 16 (the two streams above).
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp    |  2 +-
 xbmc/cores/VideoPlayer/MultiviewChoice.h       | 18 +++++++++++-------
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 2970dde..7bec0b4 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -728,7 +728,7 @@ bool CDVDVideoCodecFFmpeg::Open(CDVDStreamInfo &hints, CDVDCodecOptions &options
 
     // otherwise no hardware decoder gives the second view: both are decoded by the processor,
     // with threads
-    // (Hades: 8 at most, KODI::MULTIVIEW::MULTIVIEW_THREADS)
+    // (Hades: 24 at most, KODI::MULTIVIEW::MULTIVIEW_THREADS)
     int num_threads = CServiceBroker::GetCPUInfo()->GetCPUCount() * 3 / 2;
     num_threads = std::max(1, std::min(num_threads, KODI::MULTIVIEW::MULTIVIEW_THREADS));
     m_pCodecContext->thread_count = m_multiviewNvdec ? 1 : num_threads;
diff --git a/xbmc/cores/VideoPlayer/MultiviewChoice.h b/xbmc/cores/VideoPlayer/MultiviewChoice.h
index efca94c..3d746ba 100644
--- a/xbmc/cores/VideoPlayer/MultiviewChoice.h
+++ b/xbmc/cores/VideoPlayer/MultiviewChoice.h
@@ -1639,14 +1639,18 @@ inline bool Paced(Pace& pace, bool late, bool judged)
 /*!
  * \brief Hades: the frame threads of the decoder of both views that the processor runs, at most
  *
- * FFmpeg's HEVC decoder of two layers starts the next access unit only when the base layer of the
- * one before is decoded (hevcdec.c: ff_thread_finish_setup() at the first slice of the last
- * layer), so that more threads add little and cost memory and synchronisation. Measured with
- * FFmpeg 9.1 on a Ryzen 9 7950X3D, two views of 3840x2160 at 23.976: 8 threads 46.2 and 32.7
- * pictures of two views a second (streams of 87 and 160 Mbit/s), 16 threads 42.7 and 31.6, 24
- * threads 40.3 and 30.2. (Kodi gives any other software decoder 16 at most.)
+ * With ffmpeg-9974 FFmpeg's HEVC decoder starts the next access unit of two layers as soon as the
+ * second view's picture is started, before the base view's slices are decoded, so that two views
+ * gain from threads as one view does, and more than 16 still help: the threads wait on the rows of
+ * their references, not on the cores. Measured with FFmpeg 9.1 and that patch on a Ryzen 9
+ * 7950X3D, two views of 3840x2160 at 23.976 with one slice a picture and no WPP, 8 bits at
+ * 84 Mbit/s and 10 bits at 77 Mbit/s: 8 threads 63.0 and 61.7 pictures of two views a second,
+ * 16 threads 76.6 and 75.2, 24 threads 97.3 and 90.5 (and 99.1 and 94.3 with 24 threads on 8 of
+ * its cores with their second threads, as an 8-core processor runs them); the decoder's largest
+ * memory 1.1 and 1.6 GiB with 16 threads, 1.4 and 2.1 GiB with 24. (Kodi gives any other
+ * software decoder 16 at most.)
  */
-inline constexpr int MULTIVIEW_THREADS = 8;
+inline constexpr int MULTIVIEW_THREADS = 24;
 
 /*!
  * \brief Hades: the stream whose two views the processor did not decode in time (Worked(),
-- 
