 				<ondown condition="![String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5556) + Control.IsVisible(5561)] + ![String.IsEqual(Window(Home).Property(PlayerInfoDialogFocus),5555) + Control.IsVisible(5560)]">Close</ondown>
-				<control type="button" id="5556">
