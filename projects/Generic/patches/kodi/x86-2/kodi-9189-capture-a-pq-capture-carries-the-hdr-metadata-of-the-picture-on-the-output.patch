+
+// Hades: the HDR static metadata of the picture that a capture of the framebuffer of native Dolby
+// Vision reads (GetCaptureFramebuffer()), for a copy of it mapped to SDR: the picture composed as
+// the RPU says, within its source (mastering) display, with the L6 of the RPU as its light levels;
+// in Low-Latency, the picture mapped to the peak and black of the display (the mapping that Hades
+// took for it). From the thread that draws, as the capture taps are. Primaries are not given: the
+// picture is BT.2020, as the capture is tagged.
+bool CWinSystemGbmGLESContext::FillCaptureHdrMetadata(
+    KODI::RENDERING::CAPTURE::CaptureResult& result)
+{
+#if defined(HAVE_DVBRIDGE)
+  if (HasCaptureFramebuffer() && !m_outputHandover.HeldHdr10Tunnel())
+  {
+    if (!m_dvBridge || !m_dvBridge->GetPresentedDetail().valid)
+      return false;
+    const auto& d = m_dvBridge->GetPresentedDetail();
+    const auto rational = [](double nits)
+    { return AVRational{static_cast<int>(std::lround(nits * 10000.0)), 10000}; };
+    AVMasteringDisplayMetadata display{};
+    AVContentLightMetadata light{};
+    bool hasLight = false;
+    if (d.transport == 3)
+    {
+      if (!m_dvLowLatencyMappingSet || !(m_dvLowLatencyMapping.peak > 0.0f))
+        return false;
+      display.max_luminance = rational(m_dvLowLatencyMapping.peak);
+      display.min_luminance = rational(std::max(m_dvLowLatencyMapping.black, 0.0f));
+      light.MaxCLL = static_cast<unsigned int>(std::lround(m_dvLowLatencyMapping.peak));
+      hasLight = true;
+    }
+    else
+    {
+      if (d.source[1] <= 0)
+        return false;
+      display.max_luminance = rational(PQToNits(d.source[1]));
+      display.min_luminance = rational(PQToNits(std::max(d.source[0], 0)));
+      if (d.l6[0] > 0)
+      {
+        light.MaxCLL = static_cast<unsigned int>(d.l6[0]);
+        light.MaxFALL = static_cast<unsigned int>(std::max(d.l6[1], 0));
+        hasLight = true;
+      }
+    }
+    display.has_luminance = 1;
+    result.hasDisplayMetadata = true;
+    result.displayMetadata = display;
+    result.hasLightMetadata = hasLight;
+    result.lightMetadata = light;
+    return true;
+  }
+#endif
+  return CWinSystemGbm::FillCaptureHdrMetadata(result);
+}
