+      // from it (adapted to the display, Dolby Vision rebuilt as HDR10 or composed natively)
+      FillOutputHdrMetadata(*CServiceBroker::GetWinSystem(), result);
       result.content = CaptureContent::VIDEO; // this tap delivers video-only
