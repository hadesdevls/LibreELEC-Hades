diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index c94aaf6..a58087c 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -47,6 +47,7 @@
 #include "guilib/WindowIDs.h"
 #include "messaging/ApplicationMessenger.h"
 #include "messaging/helpers/DialogHelper.h"
+#include "rendering/capture/CaptureTypes.h"
 #include "resources/LocalizeStrings.h"
 #include "resources/ResourcesComponent.h"
 #include "settings/AdvancedSettings.h"
@@ -6155,6 +6156,8 @@ void CWinSystemGbm::NoteSourceColour(const VideoPicture* picture)
 
 bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
 {
+  // Hades: no HDR is signalled until this request says otherwise (FillCaptureHdrMetadata())
+  NoteOutputHdrMetadata(nullptr, false);
   VideoSeen();
   // Hades: what the video says of itself, for the player information
   NoteSourceColour(videoPicture);
@@ -6391,9 +6394,47 @@ bool CWinSystemGbm::SetHDR(const VideoPicture* videoPicture)
   QueuePictureLinkDepth(videoPicture, outcome.Sent(), signalledBefore,
                         m_queuedHdrMetadata.value_or(0) != 0);
 
+  // Hades: the metadata of the picture whose HDR this signals, for a capture mapped to SDR
+  NoteOutputHdrMetadata(videoPicture, outcome.Sent());
+
   return outcome.Sent();
 }
 
+void CWinSystemGbm::NoteOutputHdrMetadata(const VideoPicture* picture, bool sent)
+{
+  std::optional<OutputHdrMetadata> metadata;
+  if (picture && sent)
+  {
+    metadata.emplace();
+    if (const AVMasteringDisplayMetadata* display =
+            KODI::UTILS::GetMasteringDisplayMetadata(*picture))
+    {
+      metadata->hasDisplay = true;
+      metadata->display = *display;
+    }
+    if (const AVContentLightMetadata* light = KODI::UTILS::GetContentLightMetadata(*picture))
+    {
+      metadata->hasLight = true;
+      metadata->light = *light;
+    }
+  }
+  std::unique_lock lock(m_outputHdrLock);
+  m_outputHdr = metadata;
+}
+
+bool CWinSystemGbm::FillCaptureHdrMetadata(KODI::RENDERING::CAPTURE::CaptureResult& result)
+{
+  std::unique_lock lock(m_outputHdrLock);
+  // (a picture that says nothing of itself: whoever asks keeps what it knows, the video's own)
+  if (!m_outputHdr || (!m_outputHdr->hasDisplay && !m_outputHdr->hasLight))
+    return false;
+  result.hasDisplayMetadata = m_outputHdr->hasDisplay;
+  result.displayMetadata = m_outputHdr->display;
+  result.hasLightMetadata = m_outputHdr->hasLight;
+  result.lightMetadata = m_outputHdr->light;
+  return true;
+}
+
 void CWinSystemGbm::QueuePictureLinkDepth(const VideoPicture* picture,
                                           bool hdrSent,
                                           bool signalledBefore,
