--- a/xbmc/rendering/capture/CaptureMetadata.h
+++ b/xbmc/rendering/capture/CaptureMetadata.h
@@ -19,9 +19,18 @@ namespace RENDERING
 namespace CAPTURE
 {
 
+struct CaptureResult;
+
 //! \brief H.273 description of what the display output shows right now.
 ImageColorMetadata GetOutputColorMetadata(CWinSystemBase& winSystem);
 
+//! \brief Hades: the HDR static metadata of the picture on the output
+//! (CWinSystemBase::FillCaptureHdrMetadata()) into a PQ capture of it, as its tone mapping to SDR
+//! needs them; the result is left as it is where the capture is not PQ or the window system does
+//! not know them.
+//! \return whether they were written
+bool FillOutputHdrMetadata(CWinSystemBase& winSystem, CaptureResult& result);
+
 } // namespace CAPTURE
 } // namespace RENDERING
 } // namespace KODI
diff --git a/xbmc/rendering/capture/test/TestCaptureMetadata.cpp b/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
index 785f84e..9e99035 100644
--- a/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
+++ b/xbmc/rendering/capture/test/TestCaptureMetadata.cpp
@@ -7,6 +7,7 @@
  */
 
 #include "rendering/capture/CaptureMetadata.h"
+#include "rendering/capture/CaptureTypes.h"
 #include "utils/DisplayInfo.h"
 #include "windowing/WinSystem.h"
 
@@ -44,6 +45,19 @@ public:
   bool UseLimitedColor() override { return false; }
   KODI::UTILS::Eotf GetEotf() const override { return m_eotf; }
   bool HasCaptureFramebuffer() const override { return m_captureFramebuffer; }
+  // Hades: the metadata of the picture on the output, where the test gives them
+  bool FillCaptureHdrMetadata(CaptureResult& result) override
+  {
+    if (!m_peak)
+      return false;
+    result.hasDisplayMetadata = true;
+    result.displayMetadata = {};
+    result.displayMetadata.has_luminance = 1;
+    result.displayMetadata.max_luminance = AVRational{m_peak, 1};
+    result.hasLightMetadata = false;
+    return true;
+  }
+  int m_peak = 0;
 
 private:
   const KODI::UTILS::Eotf m_eotf;
@@ -82,3 +96,31 @@ TEST(TestCaptureMetadata, CaptureFramebufferOfHlgIsHlg)
   CTestWinSystem winSystem(KODI::UTILS::Eotf::HLG, true);
   EXPECT_EQ(GetOutputColorMetadata(winSystem).transfer, AVCOL_TRC_ARIB_STD_B67);
 }
+
+// Hades: the metadata of the picture on the output go into a PQ capture, where they are known
+TEST(TestCaptureMetadata, OutputHdrMetadataOfPq)
+{
+  CTestWinSystem winSystem(KODI::UTILS::Eotf::PQ);
+  CaptureResult result;
+  result.color = GetOutputColorMetadata(winSystem);
+  // not known: the capture is left as it is
+  EXPECT_FALSE(FillOutputHdrMetadata(winSystem, result));
+  EXPECT_FALSE(result.hasDisplayMetadata);
+  winSystem.m_peak = 600;
+  EXPECT_TRUE(FillOutputHdrMetadata(winSystem, result));
+  EXPECT_TRUE(result.hasDisplayMetadata);
+  EXPECT_EQ(result.displayMetadata.max_luminance.num, 600);
+}
+
+TEST(TestCaptureMetadata, NoOutputHdrMetadataOfHlgOrSdr)
+{
+  for (const auto eotf : {KODI::UTILS::Eotf::HLG, KODI::UTILS::Eotf::TRADITIONAL_SDR})
+  {
+    CTestWinSystem winSystem(eotf);
+    winSystem.m_peak = 600;
+    CaptureResult result;
+    result.color = GetOutputColorMetadata(winSystem);
+    EXPECT_FALSE(FillOutputHdrMetadata(winSystem, result));
+    EXPECT_FALSE(result.hasDisplayMetadata);
+  }
+}
