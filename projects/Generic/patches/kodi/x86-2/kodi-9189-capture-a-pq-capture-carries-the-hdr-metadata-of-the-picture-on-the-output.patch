@@ -65,6 +66,14 @@ ImageColorMetadata GetOutputColorMetadata(CWinSystemBase& winSystem)
   return color;
 }
 
+bool FillOutputHdrMetadata(CWinSystemBase& winSystem, CaptureResult& result)
+{
+  // (an HLG picture is relative to the display that shows it: no metadata gives its peak)
+  if (result.color.transfer != AVCOL_TRC_SMPTE2084)
+    return false;
+  return winSystem.FillCaptureHdrMetadata(result);
+}
+
 } // namespace CAPTURE
