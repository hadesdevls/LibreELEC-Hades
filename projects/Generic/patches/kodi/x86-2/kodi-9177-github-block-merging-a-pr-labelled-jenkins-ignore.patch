From 85f516de97e179e3cb1babeb38f9c3767dfab513 Mon Sep 17 00:00:00 2001
From: Malard <malard@gmail.com>
Date: Sun, 22 Nov 2026 20:34:01 +0000
Subject: [PATCH] [github] Block merging a PR labelled "Jenkins: Ignore"

The "No Jenkins" label was renamed "Jenkins: Ignore", alongside the new
Jenkins priority labels, so the Mergeable rule no longer matched it and
a PR that Jenkins never built could be merged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit e0f28d21d4461b0c20c5776fe8f5ffecf849d9c9)
(cherry picked from commit 8b2106bc1c1c8931c2531fa8f5ff82054d525e32)
---
 .github/mergeable.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/mergeable.yml b/.github/mergeable.yml
index 5a18bbe..d58a396 100644
--- a/.github/mergeable.yml
+++ b/.github/mergeable.yml
@@ -12,7 +12,7 @@ mergeable:
           regex: "^v|Infrastructure"
           message: "At least version label must be set"
         must_exclude:
-          regex: "^(Don't merge|On hold|No Jenkins|RFC|WIP)$"
+          regex: "^(Don't merge|On hold|Jenkins: Ignore|RFC|WIP)$"
       - do: title
         must_exclude:
           regex: '\[(RFC|WIP)\]'
-- 
2.53.0

