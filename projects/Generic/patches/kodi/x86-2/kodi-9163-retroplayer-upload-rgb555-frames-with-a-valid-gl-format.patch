From d60188813fa4bfff15908e2e1f9b1aabf4c0b3f9 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Tue, 10 Nov 2026 02:06:35 +0000
Subject: [PATCH] RetroPlayer: upload RGB555 frames with a valid GL format

Both GL buffer paths uploaded 0RGB1555 as GL_RGB with
GL_UNSIGNED_SHORT_5_5_5_1, which takes four components, so every
upload failed and cores using libretro's default pixel format (bnes,
for one) showed a black picture. Upload it as GL_BGRA with
GL_UNSIGNED_SHORT_1_5_5_5_REV, blue in the low bits, into an RGB
texture so the padding bit is not read as alpha.

(cherry picked from commit 9fce04082e92c104b5d789e77f9ca3d25ff751f2)
---
 xbmc/cores/RetroPlayer/buffers/RenderBufferDMAOpenGL.cpp  | 7 ++++---
 xbmc/cores/RetroPlayer/buffers/RenderBufferPoolOpenGL.cpp | 7 ++++---
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/buffers/RenderBufferDMAOpenGL.cpp b/xbmc/cores/RetroPlayer/buffers/RenderBufferDMAOpenGL.cpp
index 4fc8109..dfbe775 100644
--- a/xbmc/cores/RetroPlayer/buffers/RenderBufferDMAOpenGL.cpp
+++ b/xbmc/cores/RetroPlayer/buffers/RenderBufferDMAOpenGL.cpp
@@ -43,9 +43,10 @@ bool CRenderBufferDMAOpenGL::UploadFromMemory()
       bytesPerPixel = 4;
       break;
     case DRM_FORMAT_ARGB1555:
-      internalFormat = GL_RGB;
-      pixelFormat = GL_RGB;
-      pixelType = GL_UNSIGNED_SHORT_5_5_5_1;
+      // Blue in the low bits, and the top bit is padding, not alpha
+      internalFormat = GL_RGB5;
+      pixelFormat = GL_BGRA;
+      pixelType = GL_UNSIGNED_SHORT_1_5_5_5_REV;
       bytesPerPixel = 2;
       break;
     case DRM_FORMAT_RGB565:
diff --git a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolOpenGL.cpp b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolOpenGL.cpp
index 4ed2644..21ae510 100644
--- a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolOpenGL.cpp
+++ b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolOpenGL.cpp
@@ -41,9 +41,10 @@ bool CRenderBufferPoolOpenGL::ConfigureInternal()
     }
     case AV_PIX_FMT_RGB555:
     {
-      m_pixelType = GL_UNSIGNED_SHORT_5_5_5_1;
-      m_internalFormat = GL_RGB;
-      m_pixelFormat = GL_RGB;
+      // 0RGB1555: blue in the low bits, and the top bit is padding, not alpha
+      m_pixelType = GL_UNSIGNED_SHORT_1_5_5_5_REV;
+      m_internalFormat = GL_RGB5;
+      m_pixelFormat = GL_BGRA;
       m_bpp = sizeof(uint16_t);
       return true;
     }
-- 
