+
+std::string CLinuxRendererGLES::ChromaStepSaid() const
+{
+  using Measure = KODI::CHROMA::CStepDown::Measure;
+  if (m_chroma.Forced())
+    return ", as advancedsettings.xml asks (chromastep)";
+  switch (m_chroma.HowMeasured())
+  {
+    case Measure::GPU_TIME:
+      return m_chroma.Timing() ? ", a level down where the GPU time of its pictures says it does not keep up" : "";
+    case Measure::MISSED_REFRESHES:
+      return m_chroma.CountingRefreshes()
+                 ? StringUtils::Format(", a level down where its pictures miss refreshes of the display (their GPU "
+                                       "time cannot be measured: {})",
+                                       ChromaQueries().absent)
+                 : "";
+    case Measure::NONE:
+      break;
+  }
+  return StringUtils::Format("; its pictures can be neither timed ({}) nor their refreshes read (the flips of the "
+                             "display have no fence): no step-down",
+                             ChromaQueries().absent);
+}
+
+KODI::CHROMA::CStepDown::Measure CLinuxRendererGLES::ChromaMeasure() const
+{
+  using Measure = KODI::CHROMA::CStepDown::Measure;
+  // the GPU time where the GPU has a timer (the same levels and bytes as ever); else the refreshes that the commits
+  // of its pictures miss, where the window system reads the flips (CFlipChain)
+  if (ChromaQueries().Usable())
+    return Measure::GPU_TIME;
+#ifdef HAVE_DVBRIDGE
+  if (const auto* window = dynamic_cast<const KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
+          CServiceBroker::GetWinSystem());
+      window && window->KodiFlipsKnown())
+    return Measure::MISSED_REFRESHES;
+#endif
+  return Measure::NONE;
+}
+
+void CLinuxRendererGLES::ChromaFlipsCollect()
+{
+#ifdef HAVE_DVBRIDGE
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return;
+  const float fps = CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS();
+  const double periodMs = fps > 0 ? 1000.0 / static_cast<double>(fps) : 0;
+  for (const auto& outcome : window->KodiFlipsTake())
+  {
+    // (a picture drawn at the level before a change is not this level's)
+    if (!m_chroma.CountingRefreshes() || outcome.tag != static_cast<int>(m_chroma.Current()))
+      continue;
+    const KODI::CHROMA::Filter was = m_chroma.Current();
+    const unsigned int windows = m_chroma.Windows();
+    if (m_chroma.Presented(outcome.late, periodMs))
+    {
+      const auto& w = m_chroma.Last();
+      CLog::Log(LOGWARNING,
+                "Chroma: the chroma of this video is drawn with {} from now on, in place of {}: of {} pictures "
+                "presented, {} missed their refresh of {:.1f} ms, in two windows in a row (this GPU's time cannot "
+                "be measured: {})",
+                KODI::CHROMA::Name(m_chroma.Current()), KODI::CHROMA::Name(was), w.frames, w.lost, w.periodMs,
+                ChromaQueries().absent);
+      m_reloadShaders = true;
+      break;
+    }
+    if (windows == 0 && m_chroma.Windows() == 1)
+    {
+      const auto& w = m_chroma.Last();
+      CLog::Log(LOGINFO,
+                "Chroma: with {}, of the first {} pictures presented, {} missed their refresh of {:.1f} ms "
+                "(counted by the flips of the display: this GPU's time cannot be measured)",
+                KODI::CHROMA::Name(m_chroma.Current()), w.frames, w.lost, w.periodMs);
+    }
+  }
+#endif
 }
 
