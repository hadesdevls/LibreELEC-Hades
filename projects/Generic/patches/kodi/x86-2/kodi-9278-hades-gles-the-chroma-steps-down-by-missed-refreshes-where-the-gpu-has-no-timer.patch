 /*!
- * \brief The step-down of the chroma filter of a video, by the GPU time of its pictures
+ * \brief The step-down of the chroma filter of a video, by the GPU time of its pictures, or, where the GPU has no
+ *        timer, by the refreshes that its pictures miss
  *
  * The renderer times each picture that it draws itself with a filter of more than one sample
  * (LANCZOS3, SPLINE16) and gives the time here with the refresh period. The first SKIP timed
@@ -132,6 +135,16 @@ inline const char* LocationName(int location)
  * and each video starts again from LANCZOS3 (what was found for the last one may not hold for this
  * one: its size, its rate and the refresh rate are its own). A forced level (advancedsettings.xml)
  * never changes.
+ *
+ * Hades: a GPU without a usable timer (no GL_EXT_disjoint_timer_query, or one whose timestamps have no bits:
+ * GL_QUERY_COUNTER_BITS_EXT 0) cannot say how long its pictures take. Its pictures are then measured by the refreshes
+ * that they miss (MISSED_REFRESHES), as Dolby Vision rebuilt is (CDVConvertStep: the flip of each commit that carries
+ * one, by its out-fence, more than CFlipChain::LATE_PERIODS refresh periods after the one before; Presented()): a
+ * window of WINDOW presentations is behind when PART of them, MIN_OVER at least, missed their refresh, and two windows
+ * behind in a row take the filter one level down, as above. Without the GPU time the cause of a missed refresh is not
+ * known (a decoder, the processor), so one window never decides alone. A GPU with a timer is measured by its GPU time
+ * alone, as before: the same levels, the same bytes. Where neither can be read (no fence of the flips), nothing is
+ * measured (NONE), and the log says so.
  */
 class CStepDown
 {
@@ -142,11 +155,20 @@ public:
   static constexpr double PART = 0.05; //!< CDVStepDown::LOST_PART
   static constexpr unsigned int MIN_OVER = 3;
 
+  //! How the pictures of a video are measured
+  enum class Measure
+  {
+    GPU_TIME, //!< the GPU time of each picture (GL_EXT_disjoint_timer_query)
+    MISSED_REFRESHES, //!< the refreshes that the commits of its pictures miss (the GPU has no usable timer)
+    NONE, //!< neither can be read: no step-down
+  };
+
   //! What a window found, for the log
   struct Window
   {
     unsigned int frames = 0;
     unsigned int over = 0; //!< pictures over LOADED of the period
+    unsigned int lost = 0; //!< MISSED_REFRESHES: presentations that missed their refresh
     double averageMs = 0; //!< without the slowest picture
     double maxMs = 0;
     double periodMs = 0;
@@ -154,9 +176,10 @@ public:
   };
 
   //! A new video: from the most faithful level, or from the level that advancedsettings.xml forces
-  //! (0 to 3; any other value: none)
-  void Start(int forced = -1)
+  //! (0 to 3; any other value: none), measured as measure says
+  void Start(int forced = -1, Measure measure = Measure::GPU_TIME)
   {
+    m_measure = measure;
     m_forced = forced >= 0 && forced < FILTERS;
     m_filter = m_forced ? static_cast<Filter>(forced) : Filter::LANCZOS3;
     m_windows = 0;
@@ -166,11 +189,17 @@ public:
 
   Filter Current() const { return m_filter; }
   bool Forced() const { return m_forced; }
-  //! Whether the pictures are timed at this level: it can still go down
-  bool Timing() const
+  Measure HowMeasured() const { return m_measure; }
+  //! Whether the pictures are measured at this level, one way or the other: it can still go down
+  bool Measuring() const
   {
-    return !m_forced && (m_filter == Filter::LANCZOS3 || m_filter == Filter::SPLINE16);
+    return !m_forced && (m_filter == Filter::LANCZOS3 || m_filter == Filter::SPLINE16) &&
+           m_measure != Measure::NONE;
   }
+  //! Whether the pictures are timed at this level (by their GPU time): it can still go down
+  bool Timing() const { return Measuring() && m_measure == Measure::GPU_TIME; }
+  //! Whether the refreshes of the pictures are counted at this level (no timer): it can still go down
+  bool CountingRefreshes() const { return Measuring() && m_measure == Measure::MISSED_REFRESHES; }
   //! Windows measured since the start of the video
   unsigned int Windows() const { return m_windows; }
   const Window& Last() const { return m_last; }
@@ -227,6 +256,52 @@ public:
     return true;
   }
 
+  /*!
+   * \brief Hades: a picture presented, where the GPU has no timer (MISSED_REFRESHES): whether its commit missed its
+   *        refresh (CFlipChain)
+   * \param periodMs the refresh period of the display
+   * \return true when the level changed with it, as Timed()
+   */
+  bool Presented(bool late, double periodMs)
+  {
+    if (!CountingRefreshes() || !(periodMs > 0))
+      return false;
+    if (m_skip > 0)
+    {
+      --m_skip;
+      return false;
+    }
+    if (m_frames > 0 && periodMs != m_periodMs)
+      m_frames = 0; // (another refresh rate: a window of its own)
+    if (m_frames == 0)
+    {
+      m_periodMs = periodMs;
+      m_lost = 0;
+    }
+    ++m_frames;
+    m_lost += late ? 1 : 0;
+    if (m_frames < WINDOW)
+      return false;
+
+    Window w;
+    w.frames = m_frames;
+    w.lost = m_lost;
+    w.periodMs = m_periodMs;
+    const unsigned int part = static_cast<unsigned int>(PART * m_frames + 0.999);
+    w.behind = m_lost >= std::max(MIN_OVER, part);
+    m_last = w;
+    m_frames = 0;
+    ++m_windows;
+    // (the cause of a missed refresh is not known without the GPU time: never one window alone)
+    const bool down = w.behind && m_behindBefore;
+    m_behindBefore = w.behind;
+    if (!down)
+      return false;
+    m_filter = m_filter == Filter::LANCZOS3 ? Filter::SPLINE16 : Filter::SITED;
+    Restart();
+    return true;
+  }
+
 private:
   void Restart()
   {
@@ -236,7 +311,9 @@ private:
   }
 
   Filter m_filter = Filter::LANCZOS3;
+  Measure m_measure = Measure::GPU_TIME;
   bool m_forced = false;
+  unsigned int m_lost = 0;
   unsigned int m_skip = SKIP;
   unsigned int m_frames = 0;
   unsigned int m_over = 0;
@@ -248,5 +325,63 @@ private:
   Window m_last;
 };
 
+/*!
+ * \brief Hades: whether the pictures that Kodi's renderer drew came with their refresh, by the flips of the commits
+ *        that carried them (the measure of CStepDown where the GPU has no timer)
+ *
+ * The window system reads when the commit of a frame flipped from its out-fence, in the pass after it
+ * (CWinSystemGbmGLESContext::PresentRender()), as it does for Dolby Vision rebuilt (CDVConvertStep::Flipped()): a flip
+ * more than LATE_PERIODS refresh periods after the flip of the commit before missed a refresh. A commit that carries a
+ * picture is told with a tag (the level of its chroma, so that what comes back after a change of level is not taken
+ * for the new one); the flips are read while a commit carries one, or the one before did, and the chain of flips ends
+ * where the pictures end, so that the first picture after a pause is timed from a flip of its own run. Pure logic: a
+ * host test runs it (tools/regress of LibreELEC, kodi-host: chroma_step_test.cpp).
+ */
+class CFlipChain
+{
+public:
+  //! CDVConvertStep::LATE_PERIODS
+  static constexpr double LATE_PERIODS = 1.5;
+
+  //! A picture whose flip is known: its tag, and whether it missed its refresh (tag -1: nothing known of one)
+  struct Outcome
+  {
+    int tag = -1;
+    bool late = false;
+  };
+
+  //! Whether the flip of the commit before is wanted (carries: the commit of this pass has a picture)
+  bool WantsFlips(bool carries) const { return m_committed >= 0 || carries; }
+
+  //! The commit of this pass carries a picture of that tag (-1: none)
+  void Committed(int tag) { m_committed = tag; }
+
+  /*!
+   * \brief The flip of the commit before came at flipNs (steady clock; 0: not known)
+   * \param carries the commit of this pass has a picture (whose flip is then timed from this one)
+   */
+  Outcome Flipped(int64_t flipNs, double periodMs, bool carries)
+  {
+    const int tag = std::exchange(m_committed, -1);
+    Outcome outcome;
+    if (flipNs <= 0 || !(periodMs > 0))
+    {
+      m_lastFlipNs = 0;
+      return outcome;
+    }
+    if (tag >= 0 && m_lastFlipNs > 0)
+    {
+      outcome.tag = tag;
+      outcome.late = static_cast<double>(flipNs - m_lastFlipNs) > LATE_PERIODS * periodMs * 1e6;
+    }
+    m_lastFlipNs = carries ? flipNs : 0;
+    return outcome;
+  }
+
+private:
+  int m_committed = -1;
+  int64_t m_lastFlipNs = 0;
+};
+
 } // namespace CHROMA
 } // namespace KODI
