+bool CWinSystemGbmGLESContext::KodiFlipsKnown() const
+{
+#if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
+  // (the flip of each commit is read from its out-fence)
+  return m_eglFence != nullptr;
+#else
+  return false;
+#endif
+}
+
+void CWinSystemGbmGLESContext::KodiFlipTold(int64_t flipNs, bool carries)
+{
+  const KODI::CHROMA::CFlipChain::Outcome outcome = m_kodiFlips.Flipped(flipNs, DVRefreshPeriodMs(), carries);
+  if (outcome.tag < 0)
+    return;
+  // (taken by the renderer with its next picture; the oldest go where none takes them)
+  if (m_kodiFlipOutcomes.size() >= KODI_FLIPS_KEPT)
+    m_kodiFlipOutcomes.erase(m_kodiFlipOutcomes.begin());
+  m_kodiFlipOutcomes.push_back(outcome);
+}
+
+std::vector<KODI::CHROMA::CFlipChain::Outcome> CWinSystemGbmGLESContext::KodiFlipsTake()
+{
+  return std::exchange(m_kodiFlipOutcomes, {});
+}
+
+int CWinSystemGbmGLESContext::GpuTimestampBits()
+{
+  if (m_gpuTimestampBits >= 0)
+    return m_gpuTimestampBits;
+  m_gpuTimestampBits = 0;
+#if defined(GL_TIMESTAMP_EXT) && defined(GL_QUERY_COUNTER_BITS_EXT)
+  // (a GPU may give GL_EXT_disjoint_timer_query with timestamps of no bits: its queries then give no time)
+  if (IsExtSupported("GL_EXT_disjoint_timer_query"))
+  {
+    if (const auto getQueryiv =
+            reinterpret_cast<PFNGLGETQUERYIVEXTPROC>(eglGetProcAddress("glGetQueryivEXT")))
+    {
+      while (glGetError() != GL_NO_ERROR)
+        ;
+      GLint bits = 0;
+      getQueryiv(GL_TIMESTAMP_EXT, GL_QUERY_COUNTER_BITS_EXT, &bits);
+      m_gpuTimestampBits = glGetError() == GL_NO_ERROR ? std::max(0, static_cast<int>(bits)) : 0;
+    }
+  }
+#endif
+  CLog::Log(LOGINFO, "GPU timers: {}",
+            m_gpuTimestampBits > 0 ? StringUtils::Format("timestamps of {} bits", m_gpuTimestampBits)
+                                   : std::string("none: ") + GpuTimerAbsence());
+  return m_gpuTimestampBits;
+}
+
+std::string CWinSystemGbmGLESContext::GpuTimerAbsence()
+{
+  if (!IsExtSupported("GL_EXT_disjoint_timer_query"))
+    return "no GL_EXT_disjoint_timer_query";
+  if (GpuTimestampBits() == 0)
+    return "the GPU's timestamps have no bits (GL_QUERY_COUNTER_BITS_EXT 0)";
+  return "no picture timed";
+}
