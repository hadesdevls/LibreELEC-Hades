+/*!
+ * \brief The audio of an ELD (as ALSA gives it, the HDA ELD of the kernel: version 2 or 31 in the
+ *        top five bits of byte 0, the length of the monitor name in byte 4, the count of short
+ *        audio descriptors in the top four bits of byte 5, the speaker allocation in byte 7, the
+ *        name from byte 20 and the descriptors after it): its first byte of the allocation alone
+ */
+inline EdidAudio AudioOfEld(std::span<const uint8_t> eld)
+{
+  EdidAudio audio;
+  if (eld.size() < 20)
+    return audio;
+  const int version = (eld[0] & 0xF8) >> 3;
+  if (version != 2 && version != 31)
+    return audio;
+  audio.read = true;
+  audio.fromEld = true;
+  Allocation a;
+  a.bytes[0] = eld[7];
+  audio.allocation = a;
+  const std::size_t name = eld[4] & 0x1F;
+  const std::size_t count = eld[5] >> 4;
+  for (std::size_t s = 20 + name, n = 0; n < count && s + 3 <= eld.size(); ++n, s += 3)
+  {
+    const unsigned int format = (eld[s] >> 3) & 0xF;
+    if (format == 10)
+    {
+      audio.eac3 = true;
+      audio.eac3Joc |= (eld[s + 2] & 0x01) != 0;
+    }
+    else if (format == 12)
+    {
+      audio.mat = true;
+      audio.matObjects |= (eld[s + 2] & 0x01) != 0;
+    }
+  }
+  return audio;
+}
+
 inline bool Bit(const Allocation& a, int byte, int bit)
 {
   return (a.bytes[byte] >> bit) & 1;
@@ -214,6 +291,162 @@ inline bool IsTop(const std::string& place)
   return place.size() > 1 && place[0] == 'T';
 }
 
+/*!
+ * \brief The places of the plan that the speaker ids of a Speaker Location Data Block name (as
+ *        Declared() has them: BL/BR are the backs where sides are named, else the surrounds); the
+ *        ids the plan has no place for (FLw/FRw, the bottom ones) in off
+ */
+inline Places Located(const std::vector<uint8_t>& ids, std::vector<std::string>& off)
+{
+  Places p;
+  bool sides = false;
+  for (const uint8_t id : ids)
+    sides |= id == 0x0a || id == 0x0b || id == 0x1a || id == 0x1b;
+  for (const uint8_t id : ids)
+  {
+    switch (id)
+    {
+      case 0x00: p.insert("FL"); break;
+      case 0x01: p.insert("FR"); break;
+      case 0x02: p.insert("FC"); break;
+      case 0x03: case 0x09: p.insert("LFE"); break;
+      case 0x04: p.insert(sides ? "BL" : "SL"); break;
+      case 0x05: p.insert(sides ? "BR" : "SR"); break;
+      case 0x06: p.insert("FLOC"); break;
+      case 0x07: p.insert("FROC"); break;
+      case 0x08: p.insert("BC"); break;
+      case 0x0a: case 0x1a: p.insert("SL"); break;
+      case 0x0b: case 0x1b: p.insert("SR"); break;
+      case 0x0c: p.insert("TFL"); break;
+      case 0x0d: p.insert("TFR"); break;
+      case 0x0e: p.insert("TFC"); break;
+      case 0x0f: p.insert("TC"); break;
+      case 0x10: p.insert("TBL"); break;
+      case 0x11: p.insert("TBR"); break;
+      case 0x12: p.insert("TSL"); break;
+      case 0x13: p.insert("TSR"); break;
+      case 0x14: p.insert("TBC"); break;
+      case 0x15: off.emplace_back("BtFC"); break;
+      case 0x16: off.emplace_back("BtFL"); break;
+      case 0x17: off.emplace_back("BtFR"); break;
+      case 0x18: off.emplace_back("FLw"); break;
+      case 0x19: off.emplace_back("FRw"); break;
+      default: break;
+    }
+  }
+  return p;
+}
