+std::vector<uint8_t> CDRMUtils::EdidOfSoundDisplay(const KODI::UTILS::DisplayIdentity& identity) const
+{
+  if (!identity.Known())
+    return {};
+  for (const auto& connector : m_connectors)
+  {
+    if (!connector->IsConnected())
+      continue;
+    std::vector<uint8_t> edid = connector->GetEDID();
+    if (KODI::UTILS::SameDisplay(identity, IdentityOf(edid, connector->GetName())))
+      return edid;
+  }
+  for (const auto& survey : m_otherSurveys)
+  {
+    for (const auto& output : survey.outputs)
+    {
+      if (output.connected && !output.edid.empty() &&
+          KODI::UTILS::SameDisplay(identity, output.identity))
+        return output.edid;
+    }
+  }
+  return {};
+}
