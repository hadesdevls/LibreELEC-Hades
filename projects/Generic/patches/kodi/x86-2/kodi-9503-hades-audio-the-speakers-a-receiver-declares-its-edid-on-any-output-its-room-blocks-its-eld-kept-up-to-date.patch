+/*!
+ * \brief Every place that an EDID (or ELD) declares: its speaker allocation, its room configuration
+ *        and its speaker locations together; off, the speakers it declares that the plan has no
+ *        place for
+ */
+inline Places DeclaredPlaces(const EdidAudio& audio, std::vector<std::string>& off)
+{
+  off.clear();
+  Places p;
+  const auto add = [&p, &off](const Allocation& a)
+  {
+    for (const std::string& place : Declared(a))
+      p.insert(place);
+    for (const std::string& name : DeclaredOffPlan(a))
+      if (std::find(off.begin(), off.end(), name) == off.end())
+        off.push_back(name);
+  };
+  if (audio.allocation)
+    add(*audio.allocation);
+  if (audio.room)
+    add(*audio.room);
+  std::vector<std::string> locatedOff;
+  for (const std::string& place : Located(audio.located, locatedOff))
+    p.insert(place);
+  for (const std::string& name : locatedOff)
+    if (std::find(off.begin(), off.end(), name) == off.end())
+      off.push_back(name);
+  return p;
+}
