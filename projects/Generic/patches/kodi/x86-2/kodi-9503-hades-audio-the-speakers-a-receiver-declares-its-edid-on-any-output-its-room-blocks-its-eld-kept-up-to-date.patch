+//! What is known of the sound output that the sink plays to, for DeclaredBy()
+struct SinkFacts
+{
+  //! the audio engine said which output the sink plays to (the one it opened, or the one of the
+  //! path in use: the passthrough output or the audio output)
+  bool output = false;
+  enum class Kind
+  {
+    DISPLAY, //!< an HDMI or DisplayPort output
+    OTHER, //!< no graphics output carries it
+    UNKNOWN,
+  } kind = Kind::UNKNOWN;
+  bool identity = false; //!< its ELD names its display, now or earlier in this run
+  bool shown = false; //!< that display is the one Kodi shows on
+  //! the EDID of that display, read from the output of the graphics card it is on (empty: no
+  //! connected output has that display)
+  std::vector<uint8_t> edid;
+  std::vector<uint8_t> eld; //!< its ELD, where ALSA gave one
+};
+
+//! What the display or receiver declares, and from where
+struct SinkDeclared
+{
+  std::optional<Places> places; //!< the places declared, where any are
+  std::vector<std::string> off; //!< those declared that the plan has no place for
+  //! why there are none: "none" (it declares none), "other" (the sound goes to no display),
+  //! "otherdisplay" (to a display that no output has and whose ELD is not known), "notknown" (no
+  //! output is known yet, or its display is not)
+  std::string why;
+  //! where they come from: "edid" (the EDID of the display Kodi shows on), "edidother" (of another
+  //! output), "eld" (the ELD alone: no heights)
+  std::string from;
+  EdidAudio audio; //!< what was read, for the objects it declares
+};
+
+/*!
+ * \brief What the display or receiver that the sound goes to declares: its EDID where an output of
+ *        the graphics cards has its display, else its ELD, else why nothing is known. An EDID that
+ *        declares no speaker is that (the ELD then carries 0 as well: the kernel copies the first
+ *        byte of the block it does not have as 0).
+ */
+inline SinkDeclared DeclaredBy(const SinkFacts& facts)
+{
+  SinkDeclared d;
+  if (!facts.output || facts.kind == SinkFacts::Kind::UNKNOWN)
+  {
+    d.why = "notknown";
+    return d;
+  }
+  if (facts.kind == SinkFacts::Kind::OTHER)
+  {
+    d.why = "other";
+    return d;
+  }
+  if (!facts.edid.empty())
+  {
+    d.audio = AudioOfEdid(facts.edid);
+    if (d.audio.read)
+      d.from = facts.shown ? "edid" : "edidother";
+  }
+  if (d.from.empty() && !facts.eld.empty())
+  {
+    d.audio = AudioOfEld(facts.eld);
+    if (d.audio.read)
+      d.from = "eld";
+  }
+  if (d.from.empty())
+  {
+    d.audio = EdidAudio{};
+    d.why = facts.identity ? "otherdisplay" : "notknown";
+    return d;
+  }
+  const Places places = DeclaredPlaces(d.audio, d.off);
+  if (places.empty())
+    d.why = "none";
+  else
+    d.places = places;
+  return d;
+}
