From 4f0887e511df7ebb8c63008cc68a4af3dc44b890 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 21:35:22 +0000
Subject: [PATCH] windowing/gbm: the first publication of the player
 information is timed

kodi.log times the open of a window over a video up to the end of its
first frame (CGUIWindow). Right after that frame, on the same thread,
PublishPlayerInfo() publishes the values of the panel for the first
time: the properties of the connector as the last commit left them,
two properties that nvidia-drm reads when asked (NV_OUTPUT_LINK,
NV_OUTPUT_BPC), the HDR metadata blob, the memory and the summary. None
of it probes a display, but what it costs on a given driver was not
said anywhere.

That first publication is now timed, and said at INFO the first time
in a run and wherever it took 12 ms (a refresh at 83 Hz) or more:
"Player information: its values published in 0.2 ms of the thread that
presents the frames, as it opened" (0.2-0.6 ms in QEMU).
---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 43f091a..fa7b6c9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -11649,6 +11649,10 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     return;
   if (shown && m_playerInfoShown && now - m_playerInfoTime < std::chrono::milliseconds(500))
     return;
+  // Hades: the first publication after the page opened runs on the thread that presents the
+  // frames, right after the page's first frame (which kodi.log times on its own, CGUIWindow): it
+  // is timed too, and said at INFO the first time and wherever it took a refresh or more
+  const bool opening = shown && !m_playerInfoShown;
   m_playerInfoShown = shown;
   m_playerInfoTime = now;
   CGUIWindow* home = windows.GetWindow(WINDOW_HOME);
@@ -12308,4 +12312,15 @@ void CWinSystemGbmGLESContext::PublishPlayerInfo()
     m_infoFlash.Update(now, flash);
   else
     m_infoFlash.Clear(flash);
+  if (opening)
+  {
+    static bool said = false; // (the thread that presents the frames only)
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - now).count();
+    CLog::Log(!said || ms >= 12.0 ? LOGINFO : LOGDEBUG,
+              "Player information: its values published in {:.1f} ms of the thread that presents "
+              "the frames, as it opened{}",
+              ms, page ? "" : " (for \"Check this setup\")");
+    said = true;
+  }
 }
