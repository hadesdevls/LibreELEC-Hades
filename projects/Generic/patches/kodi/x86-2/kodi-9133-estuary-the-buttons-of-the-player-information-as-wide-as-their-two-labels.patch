From 5c023b0fb14bed6a7c4f475fff1bc3721823ba7e Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 19 Nov 2026 02:04:57 +0000
Subject: [PATCH] estuary: the buttons of the player information as wide as
 their two labels
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Kodi cuts the label and the label2 of a button where they meet
(CGUILabel::CheckAndCorrectOverlap()). Measured with Estuary's fonts, the
button for the output of this video had 552 px for its two texts and its
longest needed 629 ("Salida de este vídeo" with "Dolby Vision como HDR10
(4000 cd/m²)"; 592 in English); the button of the upscaler had 482 and
needed 630 ("Escalador (menos de 1080p)" with "Desactivado (escalado de
Kodi)"), and in Spanish it showed "Escalador (menos d..." on the screen.
Both are now 700 wide, their right edge where it was (1716): the button
of the upscaler goes just above the other one, under the columns of the
Video page, and the key OK and the bar of the machine move left to make
room (the items of the bar take 858 of its 890). Which buttons show on
which page, and how Down and Up go between them, are as before.
---
 .../skin.estuary/xml/DialogPlayerProcessInfo.xml | 16 ++++++++--------
 system/hades/DialogHadesPlayerInfo.xml           | 12 ++++++------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
index 10edf9c..c26f983 100644
--- a/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
+++ b/addons/skin.estuary/xml/DialogPlayerProcessInfo.xml
@@ -3352,7 +3352,7 @@
 			<control type="grouplist">
 				<left>44</left>
 				<top>750</top>
-				<width>980</width>
+				<width>890</width>
 				<height>60</height>
 				<orientation>horizontal</orientation>
 				<itemgap>22</itemgap>
@@ -3621,7 +3621,7 @@
 			</control>
 				<!-- the key that does it: OK, on the button or on the tab -->
 				<control type="group">
-					<left>1048</left>
+					<left>948</left>
 					<top>763</top>
 					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
 					<control type="image">
@@ -3644,9 +3644,9 @@
 					</control>
 				</control>
 				<control type="button" id="5561">
-					<left>1116</left>
+					<left>1016</left>
 					<top>750</top>
-					<width>600</width>
+					<width>700</width>
 					<height>56</height>
 					<font>font10</font>
 					<textoffsetx>24</textoffsetx>
@@ -3670,16 +3670,16 @@
 					<onup condition="String.IsEmpty(Window(Home).Property(PlayerInfoDialogFocus))">5550</onup>
 					<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
 				</control>
-				<!-- Hades: on the Video page, under its column of the video output and above the bar, the upscaler of the
-				     videos of this one's kind (hades.video.upscalerscope: 1080p and above, below 1080p, or animation where
+				<!-- Hades: on the Video page, under its columns and just above the button of the output of this video, as
+				     wide as it, the upscaler of the videos of this one's kind (hades.video.upscalerscope: 1080p and above, below 1080p, or animation where
 				     it has a setting of its own). It is the setting of Settings > Player > Videos, for all the videos of
 				     that kind, chosen from a list whose heading says so (PlayerControl(HadesUpscaler)); OK on the Video tab
 				     asks for it too. No column of the page reaches it (skin_check). The button of the output of this video
 				     stays in the bar, as on every page: up from that one comes here, down from here goes to it -->
 				<control type="button" id="5562">
-					<left>615</left>
+					<left>1016</left>
 					<top>664</top>
-					<width>530</width>
+					<width>700</width>
 					<height>56</height>
 					<font>font10</font>
 					<textoffsetx>24</textoffsetx>
diff --git a/system/hades/DialogHadesPlayerInfo.xml b/system/hades/DialogHadesPlayerInfo.xml
index aa3cf78..93976ec 100644
--- a/system/hades/DialogHadesPlayerInfo.xml
+++ b/system/hades/DialogHadesPlayerInfo.xml
@@ -12100,7 +12100,7 @@
 			<control type="grouplist">
 				<left>44</left>
 				<top>750</top>
-				<width>980</width>
+				<width>890</width>
 				<height>60</height>
 				<orientation>horizontal</orientation>
 				<itemgap>22</itemgap>
@@ -12470,7 +12470,7 @@
 				<align>left</align>
 			</control>
 			<control type="group">
-				<left>1048</left>
+				<left>948</left>
 				<top>763</top>
 				<visible>!String.IsEmpty(Player.Process(videodvoutputchoice))</visible>
 				<control type="image">
@@ -12498,9 +12498,9 @@
 				</control>
 			</control>
 			<control type="button" id="5561">
-				<left>1116</left>
+				<left>1016</left>
 				<top>750</top>
-				<width>600</width>
+				<width>700</width>
 				<height>56</height>
 				<font>font10</font>
 				<textoffsetx>24</textoffsetx>
@@ -12527,9 +12527,9 @@
 				<pulseonselect>no</pulseonselect>
 			</control>
 			<control type="button" id="5562">
-				<left>615</left>
+				<left>1016</left>
 				<top>664</top>
-				<width>530</width>
+				<width>700</width>
 				<height>56</height>
 				<font>font10</font>
 				<textoffsetx>24</textoffsetx>
-- 
2.53.0

