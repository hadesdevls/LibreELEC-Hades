From 600c82ee691aaa069f72778b6a13ebdbbf990275 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 19:08:19 +0000
Subject: [PATCH] [Hades][GBM] Level order of the Dolby Vision metadata: off
 where the setting is missing, and counted when on

videoscreen.hadesdvlevelorder is off by default (the blocks in the order of
the video, as Hades sent them in 1.1; on: in the order of their level, as
licensed set-top boxes send them). Two places took it the other way round:

- the engine settings read it as on where the setting is not there
  (BoolSetting() with true), unlike its default and the default of
  CDVEngineSettings::Read::levelOrder;
- the line of the player information that names the settings that change
  the picture from the film (PictureDefaults.h) counted it when off, its
  default, which ChangedFor() never reports, and so never when on.

Both now follow the setting's default: missing or off is the order of the
video, and "blocks reordered" is said when it is on.
---
 xbmc/settings/PictureDefaults.h                | 2 +-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/xbmc/settings/PictureDefaults.h b/xbmc/settings/PictureDefaults.h
index b05b02e..53f8b70 100644
--- a/xbmc/settings/PictureDefaults.h
+++ b/xbmc/settings/PictureDefaults.h
@@ -79,7 +79,7 @@ inline const std::vector<Entry>& Entries()
       {"videoscreen.hadesdvcm40", DV_NATIVE, 3, 54422, "v4.0 left out"},
       {"videoscreen.hadesdvcm40manual", DV_NATIVE, 1, 54423, "v4.0 peak by hand"},
       {"videoscreen.hadesdvl5form", DV_NATIVE, ANY_VALUE, 54424, "active area changed"},
-      {"videoscreen.hadesdvlevelorder", DV_NATIVE, 0, 54425, "blocks reordered"},
+      {"videoscreen.hadesdvlevelorder", DV_NATIVE, 1, 54425, "blocks reordered"},
       {"videoscreen.hadesdvl254zero", DV_NATIVE, 1, 54426, "level 254 changed"},
       {"videoscreen.hadesdvl3neutral", DV_NATIVE, 1, 54427, "level 3 added"},
       // how it is sent
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index c8bada9..11a4500 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -6617,7 +6617,7 @@ void CWinSystemGbmGLESContext::DVEngineRead()
   read.fineGamut = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVGAMUTFINE, false);
   // Hades: the form of the metadata sent (to compare with licensed players)
   read.l5Form = integer(CSettings::SETTING_VIDEOSCREEN_HADESDVL5FORM);
-  read.levelOrder = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVLEVELORDER, true);
+  read.levelOrder = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVLEVELORDER, false);
   read.l254Zero = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVL254ZERO, false);
   read.l3Neutral = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVL3NEUTRAL, false);
   read.aviBt2020 = BoolSetting(settings, CSettings::SETTING_VIDEOSCREEN_HADESDVAVIBT2020, false);
