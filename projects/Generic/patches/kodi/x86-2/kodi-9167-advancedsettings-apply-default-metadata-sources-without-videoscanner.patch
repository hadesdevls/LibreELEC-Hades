From a79255dd957948ab5aa16bb7f290b631d4cce9aa Mon Sep 17 00:00:00 2001
From: 78andyp <drandypowell@live.co.uk>
Date: Sat, 31 Oct 2026 15:22:20 +0000
Subject: [PATCH] [AdvancedSettings] Apply default metadata sources without
 <videoscanner>

The list of known filename identifier sources was only built while
parsing a <videoscanner> section. Without an advancedsettings.xml, or
without that section, the list stayed empty and identifiers such as
{tmdb=603} were stripped from the title but never used for the lookup.

Build the list after all settings files are parsed instead.

Fixes #30219

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d3564237755d9e7b3b5a80814bef74e9b844041e)
---
 xbmc/settings/AdvancedSettings.cpp          |  15 ++-
 xbmc/settings/test/CMakeLists.txt           |   3 +-
 xbmc/settings/test/TestAdvancedSettings.cpp | 104 ++++++++++++++++++++
 3 files changed, 117 insertions(+), 5 deletions(-)
 create mode 100644 xbmc/settings/test/TestAdvancedSettings.cpp

diff --git a/xbmc/settings/AdvancedSettings.cpp b/xbmc/settings/AdvancedSettings.cpp
index aaba005..a96c02c 100644
--- a/xbmc/settings/AdvancedSettings.cpp
+++ b/xbmc/settings/AdvancedSettings.cpp
@@ -593,6 +593,16 @@ bool CAdvancedSettings::Load(const CProfileManager &profileManager)
   if (!m_discStubExtensions.empty())
     m_videoExtensions += "|" + m_discStubExtensions;
 
+  // Built after parsing so the defaults apply without an advancedsettings.xml or a
+  // <videoscanner> section.
+  StringUtils::ToLower(m_metadataSourcesPriv);
+  m_videoScannerMetadataSources.clear();
+  for (auto& source : StringUtils::Split(m_metadataSourcesPriv, '|'))
+  {
+    if (!source.empty())
+      m_videoScannerMetadataSources.insert(std::move(source));
+  }
+
   return true;
 }
 
@@ -994,14 +1004,11 @@ void CAdvancedSettings::ParseSettingsFile(const std::string &file)
   {
     XMLUtils::GetBoolean(pElement, "ignoreerrors", m_bVideoScannerIgnoreErrors);
 
-    // Adjust the builtin list with the advanced setting then prepare for use.
+    // Adjust the builtin list with the advanced setting.
     if (const TiXmlElement* elem = pElement->FirstChildElement("metadatasources"); elem != nullptr)
       GetCustomExtensions(elem, m_metadataSourcesPriv);
 
     StringUtils::ToLower(m_metadataSourcesPriv);
-    const std::vector<std::string> split = StringUtils::Split(m_metadataSourcesPriv, '|');
-    m_videoScannerMetadataSources = std::unordered_set<std::string>(
-        std::make_move_iterator(split.begin()), std::make_move_iterator(split.end()));
   }
 
   // Backward-compatibility of ExternalPlayer config
diff --git a/xbmc/settings/test/CMakeLists.txt b/xbmc/settings/test/CMakeLists.txt
index 8e8e681..e358b01 100644
--- a/xbmc/settings/test/CMakeLists.txt
+++ b/xbmc/settings/test/CMakeLists.txt
@@ -1,3 +1,4 @@
-set(SOURCES TestMediaSourceSettings.cpp)
+set(SOURCES TestAdvancedSettings.cpp
+            TestMediaSourceSettings.cpp)
 
 core_add_test_library(settings_test)
diff --git a/xbmc/settings/test/TestAdvancedSettings.cpp b/xbmc/settings/test/TestAdvancedSettings.cpp
new file mode 100644
index 0000000..b0cde4ff
--- /dev/null
+++ b/xbmc/settings/test/TestAdvancedSettings.cpp
@@ -0,0 +1,104 @@
