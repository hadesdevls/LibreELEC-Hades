diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
index b6ce234..7726714 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.cpp
@@ -252,6 +252,14 @@ std::optional<int> COffsetMetadataStore::GetOffset(double pts, unsigned int sequ
   return std::nullopt;
 }
 
+bool COffsetMetadataStore::Carries(unsigned int sequence) const
+{
+  std::unique_lock lock(m_section);
+
+  return std::ranges::any_of(m_entries, [sequence](const SEntry& entry)
+                             { return sequence < entry.metadata.sequences; });
+}
+
 void COffsetMetadataStore::Flush()
 {
   std::unique_lock lock(m_section);
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
index 786635b..81c2b90 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/BlurayOffsetMetadata.h
@@ -102,6 +102,13 @@ public:
    */
   std::optional<int> GetOffset(double pts, unsigned int sequence) const;
 
+  /*!
+   * rief Hades: whether a block kept carries the sequence: the title places in depth what
+   *        follows it (CVideoPlayer::SubtitleDepthFromDisc()). A stream that follows a sequence
+   *        no block carries is placed by nothing the title says.
+   */
+  bool Carries(unsigned int sequence) const;
+
   void Flush();
 
 private:
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
index 1232ea1..856969c 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/test/TestBlurayOffsetMetadata.cpp
@@ -245,6 +245,25 @@ TEST(TestBlurayOffsetMetadata, StoreIgnoresAFrameFarBeforeTheNewestBlock)
   EXPECT_FALSE(store.GetOffset(20000.0, 0));
 }
 
+TEST(TestBlurayOffsetMetadata, StoreTellsTheSequencesItCarries)
+{
+  // Hades: a stream that follows a sequence the title carries is placed by the title; one that
+  // follows a sequence no block carries is not (CVideoPlayer::SubtitleDepthFromDisc())
+  OffsetMetadata metadata;
+  ASSERT_TRUE(Parse(AccessUnit({0x40}, 2, 1, {3, 5}), metadata));
+
+  COffsetMetadataStore store;
+  EXPECT_FALSE(store.Carries(0));
+  store.Add(0.0, FRAME, std::move(metadata));
+  EXPECT_TRUE(store.Carries(0));
+  EXPECT_TRUE(store.Carries(1));
+  EXPECT_FALSE(store.Carries(2));
+  EXPECT_FALSE(store.Carries(31));
+
+  store.Flush();
+  EXPECT_FALSE(store.Carries(0));
+}
+
 TEST(TestBlurayOffsetMetadata, StoreForgetsWhatItIsToldTo)
 {
   OffsetMetadata metadata;
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 15f08b6..ce72199 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1157,6 +1157,7 @@ bool CVideoPlayer::OpenInputStream()
 #endif
   }
   m_subtitleOffsetSequence = -1;
+  m_subtitleOffsetCarried = -1;
   m_subtitleOffsetLogStream = -1;
 
   m_clock.Reset();
@@ -1335,6 +1336,7 @@ void CVideoPlayer::CloseDemuxer()
     std::unique_lock lock(m_offsetMetadataSection);
     m_offsetMetadata.reset();
     m_subtitleOffsetSequence = -1;
+    m_subtitleOffsetCarried = -1;
     m_subtitleOffsetLogStream = -1;
   }
 
@@ -6362,6 +6364,8 @@ void CVideoPlayer::UpdateSubtitleOffsetSequence(const CDemuxStream* stream)
   // Hades: one line without debug logging each time the subtitle stream of a title that places
   // its subtitles in depth, or the sequence it follows, changes
   const int previous{m_subtitleOffsetSequence.exchange(sequence)};
+  if (sequence != previous)
+    m_subtitleOffsetCarried = -1;
   const int streamId{stream ? stream->uniqueId : -1};
   if (!why || (sequence == previous && streamId == m_subtitleOffsetLogStream))
     return;
@@ -6399,6 +6403,27 @@ std::optional<int> CVideoPlayer::GetSubtitlePlaneOffset(double pts)
   return m_offsetMetadata->GetOffset(pts + m_offset_pts, static_cast<unsigned int>(sequence));
 }
 
+bool CVideoPlayer::SubtitleDepthFromDisc()
+{
+  // Hades: a stream follows a sequence that the title carries: the disc places it. Seen once, it
+  // is kept while the stream follows that sequence, so that the moments the title says nothing
+  // about (after a seek, before the first group of pictures) are placed as they always were, by
+  // the setting, and the depth never goes from measured to the disc's and back. A sequence the
+  // title does not carry (a guess that is wrong, a remux whose offsets were lost) places nothing:
+  // the depth is then measured where it can be.
+  const int sequence{m_subtitleOffsetSequence};
+  if (sequence < 0)
+    return false;
+  if (m_subtitleOffsetCarried == sequence)
+    return true;
+
+  std::unique_lock lock(m_offsetMetadataSection);
+  if (!m_offsetMetadata || !m_offsetMetadata->Carries(static_cast<unsigned int>(sequence)))
+    return false;
+  m_subtitleOffsetCarried = sequence;
+  return true;
+}
+
 bool CVideoPlayer::OpenSubtitleStream(const CDVDStreamInfo& hint)
 {
   IDVDStreamPlayer* player = GetStreamPlayer(m_CurrentSubtitle.player);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index f01f095..b2448c4 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -435,6 +435,7 @@ protected:
   void UpdateGuiRender(bool gui) override;
   void UpdateVideoRender(bool video) override;
   std::optional<int> GetSubtitlePlaneOffset(double pts) override;
+  bool SubtitleDepthFromDisc() override;
 
   virtual void CreatePlayers();
   void DestroyPlayers();
@@ -893,6 +894,9 @@ protected:
   /*! Blu-ray 3D: the offset sequence the subtitle stream being shown follows, which is
       what places its plane in depth, or -1 when the title gives it none. */
   std::atomic<int> m_subtitleOffsetSequence{-1};
+  //! Hades: the sequence of m_subtitleOffsetSequence once the title was seen to carry it (until the
+  //! subtitle stream changes), or -1: SubtitleDepthFromDisc()
+  std::atomic<int> m_subtitleOffsetCarried{-1};
   //! Hades: the subtitle stream (uniqueId) whose depth kodi.log last told, or -1
   int m_subtitleOffsetLogStream{-1};
 
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
index 599ffdb..3463c51 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/RenderManager.h
@@ -75,6 +75,13 @@ protected:
    * nothing, which is what leaves the subtitles.stereoscopicdepth setting in charge.
    */
   virtual std::optional<int> GetSubtitlePlaneOffset(double pts) { return std::nullopt; }
+  /*!
+   * rief Hades: whether the subtitles being shown are placed in depth by the title (a Blu-ray 3D
+   *        that carries their offset sequence): then nothing else places them, also for a frame the
+   *        title says nothing about (GetSubtitlePlaneOffset()), and the depth measured from the
+   *        picture is not used for them.
+   */
+  virtual bool SubtitleDepthFromDisc() { return false; }
 };
 
 class CRenderManager
