 .../DVDDemuxers/BlurayOffsetMetadata.h        |  7 ++++++
 .../test/TestBlurayOffsetMetadata.cpp         | 19 ++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.cpp        | 25 +++++++++++++++++++
 xbmc/cores/VideoPlayer/VideoPlayer.h          |  4 +++
 .../VideoRenderers/RenderManager.h            |  7 ++++++
