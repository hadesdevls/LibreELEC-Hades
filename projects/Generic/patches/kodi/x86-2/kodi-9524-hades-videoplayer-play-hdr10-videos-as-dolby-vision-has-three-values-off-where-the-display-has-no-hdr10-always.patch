+/*!
+ * \brief Hades: "Play HDR10+ videos as Dolby Vision" (videoscreen.hadesdvfromhdr10plusmode)
+ *
+ * OFF (the default): an HDR10+ video goes out as HDR10+, or as HDR10 where the display has no HDR10+.
+ * NO_HDR10PLUS: as native Dolby Vision where the display takes it and not HDR10+, what "on" did up to
+ * 1.2.2 (the boolean videoscreen.hadesdvfromhdr10plus, taken over: Hdr10PlusModeFromOld()). ALWAYS: also
+ * where the display takes HDR10+ (many TVs take both), by the user's preference. There the video's own
+ * HDR10+ is the more faithful picture: the tone curve, the target display and the windows that the studio
+ * chose do not carry over to Dolby Vision, so the help of the setting recommends NO_HDR10PLUS, and the
+ * player information and kodi.log say what was done (Hdr10PlusAsDolbyVisionOver()).
+ */
+enum class Hdr10PlusMode
+{
+  OFF = 0,
+  NO_HDR10PLUS = 1,
+  ALWAYS = 2,
+};
+//! A value of the setting as a Hdr10PlusMode; any other value is OFF
+constexpr Hdr10PlusMode Hdr10PlusModeOf(int value)
+{
+  return value == static_cast<int>(Hdr10PlusMode::NO_HDR10PLUS) ? Hdr10PlusMode::NO_HDR10PLUS
+         : value == static_cast<int>(Hdr10PlusMode::ALWAYS)     ? Hdr10PlusMode::ALWAYS
+                                                                 : Hdr10PlusMode::OFF;
+}
+//! The boolean of earlier builds as the setting takes it over (settings/SettingTakeOver.h): on was
+//! "where the display has no HDR10+", and stays exactly that
+inline int Hdr10PlusModeFromOld(bool on)
+{
+  return static_cast<int>(on ? Hdr10PlusMode::NO_HDR10PLUS : Hdr10PlusMode::OFF);
+}
+//! ... and the boolean kept for them: on for either value that sends HDR10+ as Dolby Vision (an
+//! earlier build has no "always": it sends HDR10+ as Dolby Vision where the display has no HDR10+)
+inline bool Hdr10PlusModeToOld(int mode)
+{
+  return Hdr10PlusModeOf(mode) != Hdr10PlusMode::OFF;
+}
 //! Hades: whether an HDR10+ stream is sent as native Dolby Vision, with metadata made from its HDR10+
-//! metadata (videoscreen.hadesdvfromhdr10plus): the setting is on, the user chose no other output
-//! for the video, the display takes native Dolby Vision in a mode that carries it, and it is not sent
-//! HDR10+ (CHDRCapabilities::SupportsHDR10Plus()). Asked by the demuxer when a stream's packets bring
-//! HDR10+ metadata and no RPU (CDVHdr10Plus).
+//! metadata (videoscreen.hadesdvfromhdr10plusmode): the setting is not off, the user chose no other
+//! output for the video, the display takes native Dolby Vision in a mode that carries it, and, unless
+//! the setting is ALWAYS, the display is not sent HDR10+ (CHDRCapabilities::SupportsHDR10Plus()).
+//! Asked by the demuxer when a stream's packets bring HDR10+ metadata and no RPU (CDVHdr10Plus).
 bool Hdr10PlusAsDolbyVision();
-//! Hades: what Hdr10PlusAsDolbyVision() decides on what it reads: never for a display that is sent
-//! HDR10+ (it declares HDR10+ and its driver sends the metadata of each frame,
-//! CWinSystemGbm::GetDisplayHDRCapabilities()), which keeps the video's own dynamic metadata
-inline bool Hdr10PlusAsDolbyVisionFor(bool settingOn,
+//! Hades: what Hdr10PlusAsDolbyVision() decides on what it reads: with NO_HDR10PLUS never for a
+//! display that takes HDR10+ (it declares HDR10+ and its driver sends the metadata of each frame,
+//! CWinSystemGbm::GetDisplayHDRCapabilities()), which keeps the video's own dynamic metadata; with
+//! ALWAYS also there
+inline bool Hdr10PlusAsDolbyVisionFor(Hdr10PlusMode mode,
                                       bool nativeAllowed,
                                       bool nativeOutput,
-                                      bool displaySentHdr10Plus)
+                                      bool displayTakesHdr10Plus)
 {
-  return settingOn && nativeAllowed && nativeOutput && !displaySentHdr10Plus;
+  return mode != Hdr10PlusMode::OFF && nativeAllowed && nativeOutput &&
+         (mode == Hdr10PlusMode::ALWAYS || !displayTakesHdr10Plus);
 }
 /*!
  * \brief Hades: why Hdr10PlusAsDolbyVision() does not send an HDR10+ stream as native Dolby Vision, in the
  *        order it decides: "choice" (the user chose another output for the video than AUTOMATIC or
- *        DOLBY_VISION), "off" (videoscreen.hadesdvfromhdr10plus is off and the video has AUTOMATIC),
+ *        DOLBY_VISION), "off" (videoscreen.hadesdvfromhdr10plusmode is off and the video has AUTOMATIC),
  *        "nodv" (no native Dolby Vision on this output in a mode that carries it: the reason of the
- *        output is CWinSystemGbm::NativeDVOutputReason()), "hdr10plus" (the display is sent HDR10+, and
- *        gets the video's own; DOLBY_VISION for the video, "HDR output (this video)", sends it as
- *        Dolby Vision all the same); ""
+ *        output is CWinSystemGbm::NativeDVOutputReason()), "hdr10plus" (the setting is NO_HDR10PLUS and
+ *        the display takes HDR10+, and gets the video's own; ALWAYS in the setting, or DOLBY_VISION for
+ *        the video, "HDR output (this video)", sends it as Dolby Vision all the same); ""
  *        where it is sent so. The same verdict as Hdr10PlusAsDolbyVisionFor(), with its reason.
- * \param nativeOutput, displaySentHdr10Plus as for Hdr10PlusAsDolbyVisionFor() (asked only where
+ * \param nativeOutput, displayTakesHdr10Plus as for Hdr10PlusAsDolbyVisionFor() (asked only where
  *        the choice and the setting want it)
  */
-constexpr const char* Hdr10PlusAsDolbyVisionWhy(bool settingOn,
+constexpr const char* Hdr10PlusAsDolbyVisionWhy(Hdr10PlusMode mode,
                                                 OutputChoice choice,
                                                 bool nativeOutput,
-                                                bool displaySentHdr10Plus)
+                                                bool displayTakesHdr10Plus)
 {
   const bool chosen = choice == OutputChoice::DOLBY_VISION;
   if (!chosen && choice != OutputChoice::AUTOMATIC)
     return "choice";
-  if (!chosen && !settingOn)
+  if (!chosen && mode == Hdr10PlusMode::OFF)
     return "off";
   if (!nativeOutput)
     return "nodv";
-  if (!chosen && displaySentHdr10Plus)
+  if (!chosen && mode != Hdr10PlusMode::ALWAYS && displayTakesHdr10Plus)
     return "hdr10plus";
   return "";
 }
+/*!
+ * \brief Hades: what sent an HDR10+ stream as native Dolby Vision to a display that takes HDR10+, where the
+ *        video's own HDR10+ would be the more faithful picture: "always" (the setting is ALWAYS and the video
+ *        has AUTOMATIC: the user's preference, said by the player information and kodi.log), "choice"
+ *        (DOLBY_VISION chosen for the video: said by kodi.log), or "" (not sent as Dolby Vision, or the
+ *        display does not take HDR10+, where Dolby Vision is the only way to keep the dynamic metadata)
+ * \param mode, choice, nativeOutput, displayTakesHdr10Plus as for Hdr10PlusAsDolbyVisionWhy()
+ */
+constexpr const char* Hdr10PlusAsDolbyVisionOver(Hdr10PlusMode mode,
+                                                 OutputChoice choice,
+                                                 bool nativeOutput,
+                                                 bool displayTakesHdr10Plus)
+{
+  if (!displayTakesHdr10Plus ||
+      *Hdr10PlusAsDolbyVisionWhy(mode, choice, nativeOutput, displayTakesHdr10Plus) != '\0')
+    return "";
+  return choice == OutputChoice::DOLBY_VISION ? "choice" : "always";
+}
 //! Hades: Hdr10PlusAsDolbyVisionWhy() for the video that plays, as Hdr10PlusAsDolbyVision() last decided
 //! it (once its demuxer found HDR10+ metadata); "" where it was sent so or nothing was decided yet. For
 //! the player information; any thread.
 std::string Hdr10PlusAsDolbyVisionWhyNow();
+//! Hades: Hdr10PlusAsDolbyVisionOver() for the video that plays, as Hdr10PlusAsDolbyVision() last
+//! decided it; "" where nothing was decided yet. For the player information; any thread.
+std::string Hdr10PlusAsDolbyVisionOverNow();
 //! Hades: what the Dolby Vision of the video that plays is made from where it is not its own, as the
 //! player information names it (hades.dv.origin): "measured", "measuredauto", "measuredhlg",
