+/*!
+ * \brief Whether this flip of the window is paced as the video at its own rate
+ *        (CWinSystemGbm::PaceVrrVideo()): it is wanted (Decide()), the CRTC is known, the window shows
+ *        the full-screen video, the player has a video on its way to the screen
+ *        (CApplicationPlayer::IsRenderingVideo(): a renderer configured for it, paused or not) and the
+ *        output is not native Dolby Vision.
+ *
+ * How the renderer reaches the screen takes no part. 1.1 asked for the video layer
+ * (IsRenderingVideoLayer(), set from VideoBypassesFramebuffer()), which is true only for a renderer
+ * that gives the video a DRM plane of its own; Kodi's GLES renderer (CLinuxRendererGLES, what VAAPI
+ * on NVIDIA and AMD goes through) draws the video into the framebuffer of the window, and says false
+ * there: VRR was never turned on, and the video went at a fixed refresh in the mode of the menus
+ * (the RTX 4080 SUPER and LG C5 of the test of 2026-11-18, kodi.log: "goes at its own rate" with no
+ * "VRR video: on").
+ */
+inline bool Paced(bool wanted, bool crtc, bool fullScreenVideo, bool videoRendering, bool nativeDV)
+{
+  return wanted && crtc && fullScreenVideo && videoRendering && !nativeDV;
+}
+
+//! What became of VRR for a video at its own rate (CStartCheck), for kodi.log and the player
+//! information (hades.out.vrr)
+enum class Applied
+{
+  NONE = -1, //!< no video at its own rate
+  CHECKING = 0, //!< asked for; its first second is being measured
+  FOLLOWS, //!< the refreshes of the output follow the flips: VRR is on at the output
+  SAME_RATE, //!< the rate of the video is the refresh rate of the mode: a fixed refresh is the same
+  FIXED, //!< the refreshes stayed at the mode's rate: the mode changes to the video's as before
+  NOT_KEPT, //!< the driver read VRR_ENABLED back as 0: the mode changes to the video's as before
+  UNMEASURED, //!< no interval could be measured in UNMEASURED_NS: the mode changes as before
+};
+
+constexpr const char* AppliedName(Applied applied)
+{
+  switch (applied)
+  {
+    case Applied::CHECKING:
+      return "checking";
+    case Applied::FOLLOWS:
+      return "follows";
+    case Applied::SAME_RATE:
+      return "samerate";
+    case Applied::FIXED:
+    case Applied::NOT_KEPT:
+    case Applied::UNMEASURED:
+      return "fixed";
+    case Applied::NONE:
+      break;
+  }
+  return "";
+}
+
+/*!
+ * \brief Whether VRR is really on, from the first second of a video at its own rate.
+ *
+ * VRR_ENABLED, the EDID (vrr_capable) and the HDMI Forum block say what the source asks for and what
+ * the display says it can do, not what it does: the LG C5 declares HDMI VRR from 40 to 120 Hz with its
+ * own VRR setting off, and HDMI 2.1 gives the sink no register that says whether it applies VRR (its
+ * SCDC has none; VRR is the source's VTEM alone). What the source does is measured here, where it
+ * shows: the vblanks of the CRTC (drmCrtcGetSequence()).
+ *  - With VRR on, a refresh starts when a flip comes: one vblank for each flip, at the time asked.
+ *  - With a fixed refresh, a flip waits for the next vblank of the mode: at 47.952 Hz in a mode of
+ *    120 Hz, 2 or 3 vblanks between flips (the display's own refreshes: modeRefresh / rate - 1 = 1.5 a
+ *    flip on average), and intervals of 16.7 or 25 ms where 20.85 ms were asked for.
+ * Where the rate is the mode's refresh rate (within SAME_RATE_HZ) a fixed refresh shows the video
+ * just as VRR does: nothing to tell apart, and nothing to change.
+ *
+ * The first SKIP intervals are left out (the commit that turned VRR on, and the first one after it);
+ * from then on, once WINDOW_NS have passed with at least MIN_INTERVALS intervals:
+ *  - FIXED where the display made more than half the refreshes of its own that a fixed refresh makes
+ *    (where that is at least 0.1 a flip), or where more than MAX_OFF_SHARE of the intervals are off
+ *    those asked for by more than OFF_US;
+ *  - else FOLLOWS.
+ * NOT_KEPT at once where the kernel reads VRR_ENABLED back as anything but 1; UNMEASURED where no
+ * MIN_INTERVALS could be measured in UNMEASURED_NS. Whether the display shows
+ * each picture at the time it comes is not seen from here: that is the display's own setting.
+ *
+ * Pure: a test runs it on the host (vrr_video_test.cpp).
+ */
+class CStartCheck
+{
+public:
+  static constexpr int64_t WINDOW_NS = 1000000000;
+  //! with fewer than MIN_INTERVALS by then (vblanks that cannot be read): not measured, which is
+  //! not taken as VRR on
+  static constexpr int64_t UNMEASURED_NS = 5 * WINDOW_NS;
+  static constexpr uint64_t SKIP = 2;
+  static constexpr uint64_t MIN_INTERVALS = 12;
+  static constexpr double SAME_RATE_HZ = 0.05;
+  static constexpr int64_t OFF_NS = 1000000;
+  static constexpr double MAX_OFF_SHARE = 0.25;
+  static constexpr double MIN_FIXED_EXTRA = 0.1;
+
+  void Start(int64_t nowNs, double rate, double modeRefresh)
+  {
+    *this = CStartCheck();
+    m_startNs = nowNs;
+    m_rate = rate;
+    m_modeRefresh = modeRefresh;
+    m_started = true;
+  }
+  //! VRR_ENABLED as the kernel reads it back after the first commit that asked for it (nothing:
+  //! not read)
+  void KernelSays(std::optional<uint64_t> vrrEnabled) { m_readBack = vrrEnabled; }
+  //! An interval between two flips that each showed: the vblanks between them (1: none of the
+  //! display's own) and its time against the one asked for
+  void Interval(uint64_t vblanks, int64_t errorNs)
+  {
+    if (!m_started || vblanks == 0)
+      return;
+    if (m_seen++ < SKIP)
+      return;
+    ++m_count;
+    m_extra += vblanks - 1;
+    if (errorNs > OFF_NS || errorNs < -OFF_NS)
+      ++m_off;
+  }
+  Applied Check(int64_t nowNs) const
+  {
+    if (!m_started)
+      return Applied::NONE;
+    if (m_readBack && *m_readBack != 1)
+      return Applied::NOT_KEPT;
+    if (std::fabs(m_rate - m_modeRefresh) <= SAME_RATE_HZ)
+      return Applied::SAME_RATE;
+    if (m_count < MIN_INTERVALS && nowNs - m_startNs >= UNMEASURED_NS)
+      return Applied::UNMEASURED;
+    if (m_count < MIN_INTERVALS || nowNs - m_startNs < WINDOW_NS)
+      return Applied::CHECKING;
+    const double fixed = FixedExtra();
+    if ((fixed >= MIN_FIXED_EXTRA && ExtraPerInterval() > fixed / 2.0) || OffShare() > MAX_OFF_SHARE)
+      return Applied::FIXED;
+    return Applied::FOLLOWS;
+  }
+  uint64_t Intervals() const { return m_count; }
+  double ExtraPerInterval() const
+  {
+    return m_count ? static_cast<double>(m_extra) / static_cast<double>(m_count) : 0.0;
+  }
+  double OffShare() const
+  {
+    return m_count ? static_cast<double>(m_off) / static_cast<double>(m_count) : 0.0;
+  }
+  //! the display's own refreshes a flip that a fixed refresh at the mode's rate makes
+  double FixedExtra() const { return m_rate > 0.0 ? std::max(0.0, m_modeRefresh / m_rate - 1.0) : 0.0; }
+  std::optional<uint64_t> ReadBack() const { return m_readBack; }
+
+private:
+  bool m_started = false;
+  int64_t m_startNs = 0;
+  double m_rate = 0.0;
+  double m_modeRefresh = 0.0;
+  std::optional<uint64_t> m_readBack;
+  uint64_t m_seen = 0;
+  uint64_t m_count = 0;
+  uint64_t m_extra = 0;
+  uint64_t m_off = 0;
+};
+
 } // namespace KODI::WINDOWING::GBM::VRR_VIDEO
