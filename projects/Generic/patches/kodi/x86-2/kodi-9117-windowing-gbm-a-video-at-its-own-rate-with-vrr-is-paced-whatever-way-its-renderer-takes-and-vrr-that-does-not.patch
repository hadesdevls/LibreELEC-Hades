+void CWinSystemGbm::JudgeVrrStart(int64_t nowNs)
+{
+  using namespace VRR_VIDEO;
+  if (!m_vrrActive || m_vrrCheckDone)
+    return;
+  const Applied applied = m_vrrCheck.Check(nowNs);
+  if (applied == Applied::CHECKING || applied == Applied::NONE)
+    return;
+  m_vrrCheckDone = true;
+  const auto readBack = m_vrrCheck.ReadBack();
+  const std::string measured = StringUtils::Format(
+      "{} intervals measured in its first second: {:.2f} refreshes of the output's own between two "
+      "flips (a fixed refresh at the {:.3f} Hz of the mode makes {:.2f}), {:.0f} % of them off the "
+      "time asked for by over 1 ms; VRR_ENABLED read back {}",
+      m_vrrCheck.Intervals(), m_vrrCheck.ExtraPerInterval(), m_vrrNow.modeRefresh,
+      m_vrrCheck.FixedExtra(), 100.0 * m_vrrCheck.OffShare(),
+      readBack ? std::to_string(*readBack) : std::string("not known"));
+  switch (applied)
+  {
+    case Applied::FOLLOWS:
+      m_vrrApplied = static_cast<int>(applied);
+      CLog::Log(LOGINFO,
+                "VRR video: VRR is on at the output: its refreshes follow the flips ({}). Whether "
+                "the TV shows each picture at the time it comes is the TV's own VRR setting, which "
+                "it does not tell (it declares VRR in its EDID either way)",
+                measured);
+      return;
+    case Applied::SAME_RATE:
+      m_vrrApplied = static_cast<int>(applied);
+      CLog::Log(LOGINFO,
+                "VRR video: {:.3f} Hz is the refresh rate of the mode of the menus: a fixed "
+                "refresh shows the video as VRR does, and nothing is measured",
+                m_vrrNow.rate);
+      return;
+    default:
+      break;
+  }
+  const char* why = applied == Applied::NOT_KEPT
+                        ? "the driver reads VRR_ENABLED back as off"
+                    : applied == Applied::UNMEASURED
+                        ? "the vblanks of the output could not be read in 5 s, so it could not be "
+                          "measured"
+                        : "the refreshes of the output stayed at the refresh rate of the mode";
+  CLog::Log(LOGINFO,
+            "VRR video: VRR did not come on: {} ({}). The mode changes to the video's rate, as "
+            "without \"Video at its own rate with VRR\" (the next video tries VRR again). With "
+            "NVIDIA, \"HDMI variable refresh rate (VRR)\" and the mode of the menus must have VRR; "
+            "the TV's own VRR setting, which it does not tell, must be on too",
+            why, measured);
+  {
+    std::unique_lock lock(m_vrrLock);
+    m_vrrRefused = true;
+    m_vrrWanted = {};
+  }
+  StopVrrVideo("VRR did not come on");
+  m_vrrApplied = static_cast<int>(applied);
+  if (const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>())
+    player->TriggerUpdateResolution();
 }
 
