diff --git a/xbmc/windowing/gbm/HdmiVrrOff.h b/xbmc/windowing/gbm/HdmiVrrOff.h
index a25d1c1..d4e9b93 100644
--- a/xbmc/windowing/gbm/HdmiVrrOff.h
+++ b/xbmc/windowing/gbm/HdmiVrrOff.h
@@ -34,7 +34,11 @@ namespace GBM
  *
  * Kodi asks for it (Reason()):
  *  - in every mode set it makes while "HDMI variable refresh rate (VRR)" (System > Display,
- *    videoscreen.hadeshdmivrr) is off. On, the default, leaves it to the driver, as before;
+ *    videoscreen.hadeshdmivrr) is off, the default: Kodi has no use for VRR in the menus or for a
+ *    video at the fixed refresh of its mode, and some TVs go to their game mode while it is on.
+ *    On leaves it to the driver, as LibreELEC does, and so does "Video at its own rate with VRR"
+ *    (videoscreen.hadesvrrvideo) while it is on, which needs VRR in the mode of the menus: one
+ *    switch for it (Allowed());
  *  - in the mode set of an HDR10+ video (Wanted()): on Turing and Ampere the SOR of a head has one
  *    slot for an InfoFrame of a client next to the HDR one, the generic InfoFrame slot, where HDR10+
  *    goes (nvidia-open-kernel-modules-9020), and the EMP of HDMI VRR takes it. Ada sends HDR10+ in a
@@ -66,11 +70,22 @@ public:
     HDR10PLUS, //!< the video sends HDR10+ in the commit of its mode (Wanted())
   };
 
+  /*!
+   * \brief Whether the mode sets that Kodi makes leave HDMI VRR to the driver: "HDMI variable
+   *        refresh rate (VRR)" is on, or "Video at its own rate with VRR" is (it needs VRR in the
+   *        mode of the menus, VrrVideo.h). Both are off by default.
+   */
+  static constexpr bool Allowed(bool hdmiVrrSetting, bool vrrVideoSetting)
+  {
+    return hdmiVrrSetting || vrrVideoSetting;
+  }
+
   /*!
    * \brief Why the mode set of a commit asks for HDMI VRR off: the setting first (off, it holds for
-   *        every mode set that Kodi makes), then HDR10+ (Wanted() of that commit). With the setting
-   *        on, the default, the answer is the one Kodi gave before the setting: HDR10+ or nothing.
-   * \param settingAllowsVrr videoscreen.hadeshdmivrr (true where it cannot be read)
+   *        every mode set that Kodi makes), then HDR10+ (Wanted() of that commit). With the settings
+   *        allowing it, the answer is the one Kodi gave before the setting: HDR10+ or nothing.
+   * \param settingAllowsVrr Allowed() of the two settings (false, their default, where they
+   *        cannot be read)
    * \param hdr10PlusWanted Wanted() for this commit
    */
   static constexpr Why Reason(bool settingAllowsVrr, bool hdr10PlusWanted)
diff --git a/xbmc/windowing/gbm/VrrVideo.h b/xbmc/windowing/gbm/VrrVideo.h
index 3a1fc4f..4b765d2 100644
--- a/xbmc/windowing/gbm/VrrVideo.h
+++ b/xbmc/windowing/gbm/VrrVideo.h
@@ -118,7 +118,10 @@ struct Query
   bool vrrCapable = false; //!< the connector's vrr_capable is 1
   bool crtcVrrEnabled = false; //!< the CRTC has VRR_ENABLED
   bool nvidia = false; //!< nvidia-drm: the mode of the menus has VRR only by NVKMS's rule
-  bool hdmiVrrAllowed = true; //!< videoscreen.hadeshdmivrr (NVIDIA: VRR in the mode sets)
+  bool hdmiVrrAllowed = true; //!< CHdmiVrrOff::Allowed() (NVIDIA: VRR in the mode sets)
+  //! NV_HDMI_VRR_OFF is 1 in the mode of the menus: it was set while VRR was not allowed, and
+  //! keeps a fixed refresh whatever the flips ask for until the next mode set
+  bool hdmiVrrOffInMode = false;
   bool flipTime = false; //!< the CRTC has NV_FLIP_TIME_RAW_NS
   bool media = false; //!< the CRTC has NV_VRR_MEDIA_TARGET, and NV_VRR_MEDIA is 1 in its mode
   int vrrMin = 0; //!< the display's VRR range, in Hz (0: not known)
@@ -177,6 +180,9 @@ inline Verdict Decide(const Query& q)
     v.why = "the mode of the menus is interlaced or 3D, or has no refresh rate";
   else if (q.nvidia && !q.hdmiVrrAllowed)
     v.why = "\"HDMI variable refresh rate (VRR)\" is off in System > Display";
+  else if (q.nvidia && q.hdmiVrrOffInMode)
+    v.why = "the mode of the menus was set with HDMI VRR off (before \"Video at its own rate with "
+            "VRR\" was turned on): the next change of mode allows it";
   else if (q.nvidia && (q.guiLines < NVIDIA_VRR_MIN_LINES ||
                         static_cast<double>(q.guiRefresh) < NVIDIA_VRR_MIN_REFRESH ||
                         static_cast<double>(q.guiRefresh) < NVIDIA_VRR_MIN_FACTOR * q.vrrMin))
diff --git a/xbmc/windowing/gbm/WinSystemGbm.cpp b/xbmc/windowing/gbm/WinSystemGbm.cpp
index 7e04801..d8359d3 100644
--- a/xbmc/windowing/gbm/WinSystemGbm.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbm.cpp
@@ -4228,6 +4228,7 @@ bool CWinSystemGbm::TakeVideoAtOwnRate(float fps,
     q.flipTime = crtc->SupportsProperty(FLIP_TIME_RAW_NS);
     q.nvidia = q.flipTime || connector->SupportsProperty(CHdmiVrrOff::PROPERTY);
     q.media = crtc->SupportsProperty(MEDIA_TARGET) && crtc->GetPropertyValue(VRR_MEDIA) == 1u;
+    q.hdmiVrrOffInMode = connector->GetPropertyValue(CHdmiVrrOff::PROPERTY) == 1u;
   }
   q.hdmiVrrAllowed = HdmiVrrAllowedBySetting();
   if (const auto info = DisplayInfo())
@@ -4550,9 +4551,12 @@ bool CWinSystemGbm::HdmiVrrAllowedBySetting() const
 {
   const auto component = CServiceBroker::GetSettingsComponent();
   const auto settings = component ? component->GetSettings() : nullptr;
-  // (on, the default, where the setting cannot be read: the driver decides, as before)
-  return !settings || !settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR) ||
-         settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR);
+  // ("HDMI variable refresh rate (VRR)", or "Video at its own rate with VRR", which needs VRR in
+  // the mode of the menus; off, the default of both, where they cannot be read)
+  const auto on = [&settings](const char* id)
+  { return settings && settings->GetSetting(id) && settings->GetBool(id); };
+  return CHdmiVrrOff::Allowed(on(CSettings::SETTING_VIDEOSCREEN_HADESHDMIVRR),
+                              on(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEO));
 }
 
 void CWinSystemGbm::StageHdmiVrrOff()
@@ -5556,7 +5560,8 @@ void CWinSystemGbm::ReadOutputFormat(CDRMConnector& connector)
     CLog::Log(LOGINFO,
               "HDMI VRR: {} has {}: Kodi flips with VRR only for a video at its own rate; \"HDMI "
               "variable refresh rate (VRR)\" "
-              "(System > Display) is {}: {}; Dolby Vision always leaves it off",
+              "(System > Display, or \"Video at its own rate with VRR\") is {}: {}; Dolby Vision "
+              "always leaves it off",
               connector.GetName(), CHdmiVrrOff::PROPERTY, allowed ? "on" : "off",
               allowed ? "the driver turns it on where the display declares it, from 50 Hz up"
                       : "every mode set that Kodi makes leaves it off");
