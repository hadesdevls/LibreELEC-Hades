diff --git a/tools/dvbridge/dvbridge_gl_part.c b/tools/dvbridge/dvbridge_gl_part.c
new file mode 100644
index 0000000..c283107
--- /dev/null
+++ b/tools/dvbridge/dvbridge_gl_part.c
@@ -0,0 +1,142 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+/* Hades: one part of a picture copied into textures of its own size (dvbridge_gl_part.h). */
+#include "dvbridge_gl_part.h"
+#include <EGL/egl.h>
+#include <GLES3/gl3.h>
+#include <string.h>
+
+/* GL_EXT_texture_norm16, as dvbridge_gl_frame_import() names them */
+#define PART_R16 0x822A
+#define PART_RG16 0x822C
+
+typedef void(GL_APIENTRYP part_copy_fn)(GLuint, GLenum, GLint, GLint, GLint, GLint, GLuint, GLenum, GLint, GLint,
+                                        GLint, GLint, GLsizei, GLsizei, GLsizei);
+
+static void drain_errors(void)
+{
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; ++i)
+        ;
+}
+
+static bool has_extension(const char *name)
+{
+    const char *all = (const char *)glGetString(GL_EXTENSIONS);
+    const size_t length = strlen(name);
+    for (const char *at = all; at && (at = strstr(at, name)); at += length)
+        if ((at == all || at[-1] == ' ') && (at[length] == ' ' || at[length] == '\0'))
+            return true;
+    return false;
+}
+
+/* glCopyImageSubData() of OpenGL ES 3.2, or of either extension that has it */
+static part_copy_fn copy_function(void)
+{
+    GLint major = 0, minor = 0;
+    glGetIntegerv(GL_MAJOR_VERSION, &major);
+    glGetIntegerv(GL_MINOR_VERSION, &minor);
+    drain_errors();
+    if (major > 3 || (major == 3 && minor >= 2)) {
+        part_copy_fn f = (part_copy_fn)eglGetProcAddress("glCopyImageSubData");
+        if (f)
+            return f;
+    }
+    if (has_extension("GL_EXT_copy_image"))
+        return (part_copy_fn)eglGetProcAddress("glCopyImageSubDataEXT");
+    if (has_extension("GL_OES_copy_image"))
+        return (part_copy_fn)eglGetProcAddress("glCopyImageSubDataOES");
+    return NULL;
+}
+
+bool dvbridge_gl_part_available(void)
+{
+    return copy_function() != NULL;
+}
+
+void dvbridge_gl_part_free(struct dvbridge_gl_part *part)
+{
+    if (!part)
+        return;
+    for (int i = 0; i < 3; ++i)
+        if (part->textures[i])
+            glDeleteTextures(1, &part->textures[i]);
+    memset(part, 0, sizeof(*part));
+}
+
+bool dvbridge_gl_part_copy(struct dvbridge_gl_part *part, enum dvbridge_gl_layout layout, int width, int height,
+                           const struct dvbridge_gl_plane planes[3], int x, int y, int w, int h,
+                           struct dvbridge_gl_plane out[3])
+{
+    if (!part || !planes || !out || width <= 0 || height <= 0 || x < 0 || y < 0 || w <= 0 || h <= 0 ||
+        x + w > width || y + h > height)
+        return false;
+    memset(out, 0, 3 * sizeof(*out));
+    int count = 0;
+    bool subsampled = true;
+    unsigned luma = 0, chroma = 0;
+    switch (layout) {
+    case DVBRIDGE_NV12: count = 2; luma = GL_R8; chroma = GL_RG8; break;
+    case DVBRIDGE_P010:
+    case DVBRIDGE_P012:
+    case DVBRIDGE_P016: count = 2; luma = PART_R16; chroma = PART_RG16; break;
+    case DVBRIDGE_YUV420P10: count = 3; luma = chroma = PART_R16; break;
+    case DVBRIDGE_YUV444P10: count = 3; luma = chroma = PART_R16; subsampled = false; break;
+    default: return false;
+    }
+    /* (half a chroma sample is no part of a picture) */
+    if (subsampled && ((x | y | w | h) & 1))
+        return false;
+    const part_copy_fn copy = copy_function();
+    if (!copy)
+        return false;
+
+    GLint bound = 0;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+    drain_errors();
+    bool ok = true;
+    for (int i = 0; i < count && ok; ++i) {
+        const int div = i && subsampled ? 2 : 1;
+        const int pw = w / div, ph = h / div;
+        /* each plane of the picture as dvbridge_gl_frame_import() takes it, and the part within it */
+        const int fullW = i && subsampled ? (width + 1) / 2 : width;
+        const int fullH = i && subsampled ? (height + 1) / 2 : height;
+        if (!planes[i].texture || planes[i].width != fullW || planes[i].height != fullH) {
+            ok = false;
+            break;
+        }
+        const unsigned format = i ? chroma : luma;
+        if (!part->textures[i] || part->widths[i] != pw || part->heights[i] != ph || part->formats[i] != format) {
+            if (part->textures[i])
+                glDeleteTextures(1, &part->textures[i]);
+            part->textures[i] = 0;
+            glGenTextures(1, &part->textures[i]);
+            glBindTexture(GL_TEXTURE_2D, part->textures[i]);
+            glTexStorage2D(GL_TEXTURE_2D, 1, format, pw, ph);
+            part->widths[i] = pw;
+            part->heights[i] = ph;
+            part->formats[i] = format;
+            /* as Kodi's own planes are (libplacebo sets the sampling of each texture it reads itself: measured,
+             * a part whose texture says another filter is drawn the same) */
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        }
+        copy(planes[i].texture, GL_TEXTURE_2D, 0, x / div, y / div, 0, part->textures[i], GL_TEXTURE_2D, 0, 0, 0,
+             0, pw, ph, 1);
+        ok = glGetError() == GL_NO_ERROR;
+        out[i] = (struct dvbridge_gl_plane){part->textures[i], pw, ph};
+    }
+    glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+    if (!ok) {
+        memset(out, 0, 3 * sizeof(*out));
+        return false;
+    }
+    part->planes = count;
+    return true;
+}
diff --git a/tools/dvbridge/dvbridge_gl_part.h b/tools/dvbridge/dvbridge_gl_part.h
new file mode 100644
index 0000000..5db2736
--- /dev/null
+++ b/tools/dvbridge/dvbridge_gl_part.h
@@ -0,0 +1,48 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#ifndef DVBRIDGE_GL_PART_H
+#define DVBRIDGE_GL_PART_H
+/* Hades: one part of a picture, its planes copied into textures of the part's own size: one view of a 3D picture,
+ * whose two views lie side by side or one above the other in one picture (MV-HEVC and MVC as Kodi puts them side by
+ * side, a side-by-side or top-and-bottom file), drawn by the bridge as a picture of its own.
+ *
+ * The bridge draws a picture from textures of its own size and nothing else (dvbridge_gl_frame_import()): every pass
+ * that reads at an edge of a texture replicates the edge of the picture there, as the composer of ETSI GS CCM 001
+ * and libplacebo's scalers do at the edge of a 2D picture. A view drawn as a crop of the picture of two would read
+ * the other view's samples across the seam instead (and a picture of two 3840x2160 views is wider than the bridge
+ * takes in). Copied into textures of its own, a view is drawn exactly as the same picture in 2D is: the same
+ * samples, the same edges.
+ *
+ * The copy is glCopyImageSubData() (OpenGL ES 3.2; GL_EXT_copy_image and GL_OES_copy_image before it), which copies
+ * the samples as they are, of any format, without a pass of its own. Current GL context required. */
+#include "dvbridge_gl_frame.h"
+#include <stdbool.h>
+
+struct dvbridge_gl_part {
+    unsigned textures[3];
+    int widths[3], heights[3];
+    unsigned formats[3];
+    int planes;
+};
+
+/* Whether the context has the copy (glCopyImageSubData() or one of its extensions). */
+bool dvbridge_gl_part_available(void);
+
+/* The part (x, y, width w, height h) of a picture (layout, width x height, its planes as
+ * dvbridge_gl_frame_import() takes them) copied into the textures of *part (made again where the part's size or the
+ * layout changes; zero it before the first copy), and those textures in out[], for dvbridge_gl_frame_import() with
+ * w and h. The part lies within the picture; where the chroma is subsampled its corner and its size are even (a
+ * part of half a chroma sample is no picture). False, and nothing in out[], where any of that does not hold or the
+ * copy fails. */
+bool dvbridge_gl_part_copy(struct dvbridge_gl_part *part, enum dvbridge_gl_layout layout, int width, int height,
+                           const struct dvbridge_gl_plane planes[3], int x, int y, int w, int h,
+                           struct dvbridge_gl_plane out[3]);
+
+/* The textures of *part deleted (current GL context required), and *part zeroed. */
+void dvbridge_gl_part_free(struct dvbridge_gl_part *part);
+#endif
-- 
