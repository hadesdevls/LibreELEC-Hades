From 6616507853e27151d1c0eba322d012b9b2984ef7 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:05:17 +0000
Subject: [PATCH] DisplaySettings: no default refresh rate asked of an empty
 list of them

SettingOptionsRefreshRatesFiller() falls back to
CWinSystemBase::DefaultRefreshRate() when the refresh rate of the
setting is none of those the display has at that size, and that
function began with rates[0], with no look at the size of the list.
Where RefreshRates() gave none (the display no longer has a mode of the
size of the setting, after a change of its EDID or another display on
the output), it read past the end of the vector.

The filler now asks only of a list with something in it (the setting
keeps its value otherwise), and DefaultRefreshRate() returns an empty
rate (0 Hz, RES_INVALID) for an empty list, for any caller.

Found by SamuriHL (SamuriHL/coreelec-xbmc commit 5149f34498,
"DisplaySettings: do not ask for a default refresh rate from an empty
list"), from a review of avdvplus R10; the check in DefaultRefreshRate()
is Hades'.
---
 xbmc/settings/DisplaySettings.cpp | 4 +++-
 xbmc/windowing/WinSystem.cpp      | 4 ++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/xbmc/settings/DisplaySettings.cpp b/xbmc/settings/DisplaySettings.cpp
index 5315200..2ede287 100644
--- a/xbmc/settings/DisplaySettings.cpp
+++ b/xbmc/settings/DisplaySettings.cpp
@@ -888,7 +888,9 @@ void CDisplaySettings::SettingOptionsRefreshRatesFiller(const SettingConstPtr& s
     list.emplace_back(StringUtils::Format("{:.2f}", refreshrate.RefreshRate), screenmode);
   }
 
-  if (!match)
+  // Hades: not from an empty list (the display no longer has a mode of that size, after a change
+  // of its EDID): the setting keeps its value, and there is nothing to fall back to
+  if (!match && !refreshrates.empty())
     current = GetStringFromResolution(res, CServiceBroker::GetWinSystem()->DefaultRefreshRate(refreshrates).RefreshRate);
 }
 
diff --git a/xbmc/windowing/WinSystem.cpp b/xbmc/windowing/WinSystem.cpp
index 37453ea..74aac2c 100644
--- a/xbmc/windowing/WinSystem.cpp
+++ b/xbmc/windowing/WinSystem.cpp
@@ -232,6 +232,10 @@ std::vector<REFRESHRATE> CWinSystemBase::RefreshRates(int width, int height, uin
 
 REFRESHRATE CWinSystemBase::DefaultRefreshRate(const std::vector<REFRESHRATE>& rates)
 {
+  // Hades: none of an empty list (rates[0] read past its end)
+  if (rates.empty())
+    return REFRESHRATE{0.0f, RES_INVALID};
+
   REFRESHRATE bestmatch = rates[0];
   float bestfitness = -1.0f;
   float targetfps = CDisplaySettings::GetInstance().GetResolutionInfo(RES_DESKTOP).fRefreshRate;
-- 
