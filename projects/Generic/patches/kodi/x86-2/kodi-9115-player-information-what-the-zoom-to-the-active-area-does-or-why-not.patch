+  const ACTIVEAREA::Shown shown = ACTIVEAREA::GetShown();
+  if (!shown.asked)
+    return "";
+  const auto fill = [](std::string text, const std::string& first, const std::string& second)
+  {
+    StringUtils::Replace(text, "{0}", first);
+    StringUtils::Replace(text, "{1}", second);
+    return text;
+  };
+  if (shown.on)
+    return fill(EstuaryWord(54281, "On: {0}, enlarged {1} times"),
+                StringUtils::Format("{}x{} ({:.2f}:1)", shown.area.Width(), shown.area.Height(),
