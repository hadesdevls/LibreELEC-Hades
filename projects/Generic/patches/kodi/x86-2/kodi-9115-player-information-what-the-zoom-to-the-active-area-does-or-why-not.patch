diff --git a/tools/dvbridge/dvbridge_l5area.c b/tools/dvbridge/dvbridge_l5area.c
index a047572..0877fd1 100644
--- a/tools/dvbridge/dvbridge_l5area.c
+++ b/tools/dvbridge/dvbridge_l5area.c
@@ -13,6 +13,9 @@
 #include <math.h>
 #include <string.h>
 
+const char dvbridge_l5_no_block[] = "the metadata have no level 5 block";
+const char dvbridge_l5_unreadable[] = "the Dolby Vision metadata cannot be read";
+
 const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int height, bool of_picture,
                              int area[4], bool *scene, unsigned offsets[4])
 {
@@ -20,7 +23,7 @@ const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int
         *scene = false;
     const AVDOVIMetadata *m = metadata;
     if (!m || !dvbridge_dv_readable(m, bytes))
-        return "the Dolby Vision metadata cannot be read";
+        return dvbridge_l5_unreadable;
     if (scene)
         *scene = av_dovi_get_color(m)->scene_refresh_flag != 0;
     if (width < 2 || height < 2 || width > DVBRIDGE_SOURCE_MAX_WIDTH || height > DVBRIDGE_SOURCE_MAX_HEIGHT)
@@ -35,7 +38,7 @@ const char *dvbridge_l5_area(const void *metadata, size_t bytes, int width, int
         l5 = e;
     }
     if (!l5)
-        return "the metadata have no level 5 block";
+        return dvbridge_l5_no_block;
     const unsigned given[4] = {l5->l5.left_offset, l5->l5.right_offset, l5->l5.top_offset, l5->l5.bottom_offset};
     if (offsets)
         memcpy(offsets, given, sizeof(given));
