+    case Why::NONE:
+    case Why::SETTING:
+      return "";
+    case Why::NO_DATA:
+      return EstuaryWord(54282, "Not used: no level 5 data in this video");
+    case Why::MEASURED:
+      return EstuaryWord(54290, "Not used: a measurement found picture in the bars");
+    case Why::WHOLE:
+      return EstuaryWord(54284, "Not needed: the picture has no black bars");
+    case Why::SMALL:
+      return EstuaryWord(54289, "Not used: the active area is under 40 % of the picture");
