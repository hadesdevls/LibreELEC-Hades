From f2047c6335fa0fcf36d2e2b6ae90bc7f319aa162 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Thu, 26 Nov 2026 17:42:09 +0000
Subject: [PATCH] [Hades][VideoPlayer] What a source sends while the player
 buffers: counted by the cache, with its waits and seeks

1.2.2 measured what a network source sent while the player buffered
from where the input was and what the cache held ahead of it. A seek, a
resume, or a demuxer that reads far apart in the file turns that into
the length of the jump: an MV-HEVC film in an MP4 whose index is at its
end, played from a network share, gave "its source sent 50998.7 MB
meanwhile (101717.7 Mbit/s)" in 4 s, then 2221.5 MB, 11696.6 MB and
11685.5 MB, against the 24.2 and 39.6 Mbit/s measured where nothing
jumped: the log could not tell a slow source from something else.

The file cache now counts what it takes from its source, how long its
reads and seeks of the source take (the cache waiting for the source)
and how many seeks of the source it makes (XFILE::SCacheStatus, with
every field initialised). The player measures a buffering with them:
kodi.log says what the source sent, how long the cache waited for it
and at what rate it sent while it did, and the seeks of the source,
which a demuxer that reads the sound and the picture of a file far
apart makes on every pass. The source is said to be slower than the
video, and the user is told so, only where the cache waited for the
source most of that time (SOURCE_RATE::SourceLimited()); otherwise
kodi.log says that the source is not what the player waited for. A
cache that does not count (none in Kodi's tree) is measured as before.
---
 xbmc/cores/VideoPlayer/SourceRate.h    | 25 +++++++++++++---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 40 +++++++++++++++++++++-----
 xbmc/cores/VideoPlayer/VideoPlayer.h   |  7 ++++-
 xbmc/filesystem/FileCache.cpp          | 21 ++++++++++++++
 xbmc/filesystem/FileCache.h            |  5 ++++
 xbmc/filesystem/IFileTypes.h           | 19 ++++++++----
 6 files changed, 100 insertions(+), 17 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/SourceRate.h b/xbmc/cores/VideoPlayer/SourceRate.h
index 33bc09a..b18b923 100644
--- a/xbmc/cores/VideoPlayer/SourceRate.h
+++ b/xbmc/cores/VideoPlayer/SourceRate.h
@@ -25,10 +25,18 @@
  * played at a third of its speed: its source sent less than the film takes.
  *
  * So, while the player buffers, the level is how far it got to playing on (Progress()), and what
- * the source sends is measured from where the input is and what the cache holds ahead of it, from
- * the first pass of the buffering to its end: kodi.log says it once the buffering ends, and where
- * the source sent less than the video takes on average (its length over its duration) for
- * TELL_AFTER_MS, the user is told once a file that the source is slower than the video.
+ * the source sends is measured from the first pass of the buffering to its end: kodi.log says it
+ * once the buffering ends, and where the source sent less than the video takes on average (its
+ * length over its duration) for TELL_AFTER_MS, the user is told once a file that the source is
+ * slower than the video.
+ *
+ * What the source sent is what the cache took from it (XFILE::SCacheStatus::sourceBytes), with how
+ * long the cache waited for the source's reads and seeks meanwhile and how many seeks of the source
+ * there were. 1.2.2 measured it from where the input was and what the cache held ahead of it, which
+ * a seek or a demuxer that reads far apart in the file turns into the length of the jump: an MP4
+ * whose index is at its end gave 50998.7 MB in 4 s. The source is what the player waits for only
+ * where the cache waited for it most of the time (SourceLimited()); kodi.log says the seeks, which
+ * a demuxer that reads the sound and the picture of a file far apart makes on every pass.
  */
 namespace SOURCE_RATE
 {
@@ -55,6 +63,15 @@ constexpr double Progress(double level, double time, double queueSeconds)
 //! A buffering that lasts this long, with a source slower than the video, is told to the user
 constexpr int64_t TELL_AFTER_MS = 3000;
 
+/*!
+ * \brief Whether the source is what a buffering waited for: the cache waited for its reads and
+ *        seeks 80 % of the time or more (sourceWaitMs; < 0: not known, taken as yes)
+ */
+constexpr bool SourceLimited(int64_t elapsedMs, int64_t sourceWaitMs)
+{
+  return sourceWaitMs < 0 || sourceWaitMs * 10 >= elapsedMs * 8;
+}
+
 /*!
  * \brief The source sent less than the video takes, over a buffering long enough to tell it
  * \param elapsedMs since the first pass of the buffering
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 66e0830..76c39f8 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -3050,35 +3050,61 @@ void CVideoPlayer::WatchBuffering(bool ends)
     m_buffering.since.reset();
     return;
   }
-  const int64_t bytes = position + static_cast<int64_t>(status.forward);
+  // (what the cache took from the source, where it counts it; else where the input is and what the
+  // cache holds ahead of it, which a seek turns into the length of the jump: SourceRate.h)
+  const bool counted = status.sourceCounted;
+  const int64_t bytes = counted ? static_cast<int64_t>(status.sourceBytes)
+                                : position + static_cast<int64_t>(status.forward);
   const auto now = std::chrono::steady_clock::now();
-  if (!m_buffering.since)
+  if (!m_buffering.since || m_buffering.counted != counted)
   {
+    m_buffering.since.reset();
     if (!ends)
     {
       m_buffering.since = now;
       m_buffering.startBytes = bytes;
+      m_buffering.startWaitMs = static_cast<int64_t>(status.sourceWaitMs);
+      m_buffering.startSeeks = status.sourceSeeks;
+      m_buffering.counted = counted;
     }
     return;
   }
   const int64_t ms =
       std::chrono::duration_cast<std::chrono::milliseconds>(now - *m_buffering.since).count();
   const int64_t sent = bytes - m_buffering.startBytes;
+  const int64_t waited =
+      counted ? static_cast<int64_t>(status.sourceWaitMs) - m_buffering.startWaitMs : -1;
+  const uint32_t seeks = counted ? status.sourceSeeks - m_buffering.startSeeks : 0;
+  const bool limited = SOURCE_RATE::SourceLimited(ms, waited);
   const double needed = SOURCE_RATE::Mbits(status.maxrate, 1000);
   if (ends)
   {
     m_buffering.since.reset();
     m_buffering.startBytes = -1;
+    const double rate = SOURCE_RATE::Mbits(sent, ms);
     if (ms >= 1000 && sent >= 0)
       CLog::Log(LOGINFO,
                 "VideoPlayer: the player buffered for {} ms; its source sent {:.1f} MB meanwhile "
-                "({:.1f} Mbit/s), and this video takes {:.1f} Mbit/s on average{}",
-                ms, static_cast<double>(sent) / 1e6, SOURCE_RATE::Mbits(sent, ms), needed,
-                SOURCE_RATE::Mbits(sent, ms) < needed ? ": the source is slower than the video"
-                                                      : "");
+                "({:.1f} Mbit/s{}){}, and this video takes {:.1f} Mbit/s on average{}",
+                ms, static_cast<double>(sent) / 1e6, rate,
+                counted ? StringUtils::Format(
+                              "; the cache waited for the source {} ms of it, {:.1f} Mbit/s while it "
+                              "did",
+                              waited, SOURCE_RATE::Mbits(sent, waited))
+                        : std::string(),
+                seeks ? StringUtils::Format(
+                            "; the source was sought {} time(s), the demuxer reading other places of "
+                            "the file",
+                            seeks)
+                      : std::string(),
+                needed,
+                rate >= needed ? ""
+                : limited      ? ": the source is slower than the video"
+                               : ": the cache did not wait for the source most of that time, so the "
+                                 "source is not what the player waited for");
     return;
   }
-  if (m_buffering.told || !SOURCE_RATE::Slower(ms, sent, status.maxrate))
+  if (m_buffering.told || !limited || !SOURCE_RATE::Slower(ms, sent, status.maxrate))
     return;
   m_buffering.told = true;
   const double rate = SOURCE_RATE::Mbits(sent, ms);
diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.h b/xbmc/cores/VideoPlayer/VideoPlayer.h
index 051a071..6635225 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.h
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.h
@@ -860,7 +860,12 @@ protected:
   struct BufferingState
   {
     std::optional<std::chrono::steady_clock::time_point> since; // its first pass
-    int64_t startBytes{-1}; // where the input was, and what the cache held ahead of it, then
+    // what the cache had taken from its source then (or, for a cache that does not count it, where
+    // the input was and what the cache held ahead of it), how long it had waited for it, its seeks
+    int64_t startBytes{-1};
+    int64_t startWaitMs{0};
+    uint32_t startSeeks{0};
+    bool counted{false};
     bool told{false}; // the user was told that the source is slower than the video (once a file)
   } m_buffering;
   //! Hades: on each pass of a buffering (ends: false), and as it ends (true)
diff --git a/xbmc/filesystem/FileCache.cpp b/xbmc/filesystem/FileCache.cpp
index ae2998c..82da74e 100644
--- a/xbmc/filesystem/FileCache.cpp
+++ b/xbmc/filesystem/FileCache.cpp
@@ -358,7 +358,14 @@ void CFileCache::Process()
       bool sourceSeekFailed = false;
       if (!cacheReachEOF || !m_sourcePositionValid)
       {
+        // Hades: a seek of the source, and how long the cache waited for it (SCacheStatus)
+        const auto seekStart = std::chrono::steady_clock::now();
         const int64_t sourceSeekResult = m_source->Seek(cacheMaxPos, SEEK_SET);
+        m_sourceSeeks.fetch_add(1);
+        m_sourceWaitUs.fetch_add(static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - seekStart)
+                .count()));
         const DWORD sourceSeekError = GetLastError();
         // a seek that StopThread() ended is no error (OnExit() releases whoever waits for it)
         if (m_bStop)
@@ -467,7 +474,17 @@ void CFileCache::Process()
 
     ssize_t iRead = 0;
     if (maxSourceRead > 0)
+    {
+      // Hades: what the source sends, and how long the cache waits for it (SCacheStatus)
+      const auto readStart = std::chrono::steady_clock::now();
       iRead = m_source->Read(buffer.get(), maxSourceRead);
+      m_sourceWaitUs.fetch_add(static_cast<uint64_t>(
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              std::chrono::steady_clock::now() - readStart)
+              .count()));
+      if (iRead > 0)
+        m_sourceBytes.fetch_add(static_cast<uint64_t>(iRead));
+    }
     if (iRead <= 0)
     {
       // A read that StopThread() ended is no end of the file and no error of the source
@@ -1017,6 +1034,10 @@ int CFileCache::IoControl(IOControl request, void* param)
     status->currate = m_writeRateActual;
     status->lowrate = m_writeRateLowSpeed;
     m_writeRateLowSpeed = 0; // Reset low speed condition
+    status->sourceBytes = m_sourceBytes.load();
+    status->sourceWaitMs = m_sourceWaitUs.load() / 1000;
+    status->sourceSeeks = m_sourceSeeks.load();
+    status->sourceCounted = true;
     return 0;
   }
 
diff --git a/xbmc/filesystem/FileCache.h b/xbmc/filesystem/FileCache.h
index 3212561..6dd0868 100644
--- a/xbmc/filesystem/FileCache.h
+++ b/xbmc/filesystem/FileCache.h
@@ -143,6 +143,11 @@ public:
     //! the cache thread gave up on the source before the end of the file: a read that finds
     //! nothing more fails (an error), it is not the end of the file
     std::atomic<bool> m_sourceFailed{false};
+    //! Hades: what the cache thread took from the source, the microseconds that its reads and seeks
+    //! of it took, and its seeks of it, since the cache was opened (SCacheStatus::sourceBytes)
+    std::atomic<uint64_t> m_sourceBytes{0};
+    std::atomic<uint64_t> m_sourceWaitUs{0};
+    std::atomic<uint32_t> m_sourceSeeks{0};
     //! the cache thread's: when the source last gave data, and the lines of a stall
     std::chrono::steady_clock::time_point m_lastSourceData;
     std::chrono::steady_clock::time_point m_lastStallLog;
diff --git a/xbmc/filesystem/IFileTypes.h b/xbmc/filesystem/IFileTypes.h
index 01b4dee..e38a3f5 100644
--- a/xbmc/filesystem/IFileTypes.h
+++ b/xbmc/filesystem/IFileTypes.h
@@ -50,11 +50,20 @@ struct SNativeIoControl
 
 struct SCacheStatus
 {
-  uint64_t maxforward; /**< forward cache max capacity in bytes */
-  uint64_t forward; /**< number of bytes cached forward of current position */
-  uint32_t maxrate; /**< maximum allowed read(fill) rate (bytes/second) */
-  uint32_t currate; /**< average read rate (bytes/second) since last position change */
-  uint32_t lowrate; /**< low speed read rate (bytes/second) (if any, else 0) */
+  uint64_t maxforward{0}; /**< forward cache max capacity in bytes */
+  uint64_t forward{0}; /**< number of bytes cached forward of current position */
+  uint32_t maxrate{0}; /**< maximum allowed read(fill) rate (bytes/second) */
+  uint32_t currate{0}; /**< average read rate (bytes/second) since last position change */
+  uint32_t lowrate{0}; /**< low speed read rate (bytes/second) (if any, else 0) */
+  //! Hades: what the cache took from its source since it was opened: the bytes, the milliseconds
+  //! that its reads and seeks of the source took (the cache waiting for the source), and the seeks
+  //! of the source (a reader that went outside what the cache holds). sourceCounted: a cache that
+  //! counts them (CFileCache); the player measures what a source sends with them
+  //! (VideoPlayer/SourceRate.h)
+  uint64_t sourceBytes{0};
+  uint64_t sourceWaitMs{0};
+  uint32_t sourceSeeks{0};
+  bool sourceCounted{false};
 };
 
 enum class CacheBufferMode
