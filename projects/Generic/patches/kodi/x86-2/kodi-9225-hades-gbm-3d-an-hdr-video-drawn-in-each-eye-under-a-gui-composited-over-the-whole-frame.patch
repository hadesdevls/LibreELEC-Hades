+  // not where it goes into an output of its own (native Dolby Vision draws it into its frame once
+  // a frame)
+  virtual bool VideoLayerInEachEye() const { return true; }
 
   // True when GUI is rendered to an FBO that is then color-transformed
   // (sRGB -> PQ/HLG) and composited against HDR video in that non-linear
