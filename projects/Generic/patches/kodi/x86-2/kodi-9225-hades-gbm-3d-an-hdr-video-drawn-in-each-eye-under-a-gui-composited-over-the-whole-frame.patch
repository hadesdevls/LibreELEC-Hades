diff --git a/xbmc/rendering/StereoViews.h b/xbmc/rendering/StereoViews.h
new file mode 100644
index 0000000..3c9d3a2
--- /dev/null
+++ b/xbmc/rendering/StereoViews.h
@@ -0,0 +1,50 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "rendering/RenderSystemTypes.h"
+
+namespace KODI::RENDERING::STEREO_VIEWS
+{
+
+/*!
+ * \brief Hades: a pass of a frame drawn in each view of the stereo mode: once, with the view left
+ *        as it is, without 3D; in the left eye alone where a 3D video is shown in 2D (MONO); else in
+ *        the left eye and then the right one. The view is OFF again after the eyes.
+ *
+ * Kodi drew its GUI pass so (CApplication::Render()), and the renderer of the video takes its half
+ * of a 3D picture, and the place of its eye, from the view set (CBaseRenderer::ManageRenderArea(),
+ * CGraphicContext::SetStereoView()). The pass that draws the video after the GUI, under a GUI that
+ * the window system composites over it (HDR: CGUIWindowManager::RenderEx()), was drawn once with
+ * the view OFF: the whole 3D picture, both halves, into the place of the left eye, and nothing into
+ * the right one. Both passes are drawn here, with the one rule.
+ *
+ * \param mode the stereo mode of the output (CGraphicContext::GetStereoMode())
+ * \param setView sets a view: void(RenderStereoView)
+ * \param draw draws the pass in the view that is set: void()
+ */
+template<typename SetView, typename Draw>
+void ForEachView(RenderStereoMode mode, SetView&& setView, Draw&& draw)
+{
+  if (mode == RenderStereoMode::OFF)
+  {
+    draw();
+    return;
+  }
+  setView(RenderStereoView::LEFT);
+  draw();
+  if (mode != RenderStereoMode::MONO)
+  {
+    setView(RenderStereoView::RIGHT);
+    draw();
+  }
+  setView(RenderStereoView::OFF);
+}
+
+} // namespace KODI::RENDERING::STEREO_VIEWS
