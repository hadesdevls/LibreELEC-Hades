diff --git a/xbmc/windowing/gbm/WholeBuffer.h b/xbmc/windowing/gbm/WholeBuffer.h
new file mode 100644
index 0000000..4fdbabb
--- /dev/null
+++ b/xbmc/windowing/gbm/WholeBuffer.h
@@ -0,0 +1,69 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "system_gl.h"
+
+namespace KODI::WINDOWING::GBM
+{
+
+/*!
+ * \brief Hades: a clear or a draw over the whole of the buffer that is bound, width x height,
+ *        whatever viewport and scissor box are set; they are put back as they were when it ends
+ *
+ * The GUI of a 3D output is drawn eye by eye, and its passes end with
+ * CGraphicContext::SetStereoView(RenderStereoView::OFF), which sets the viewport and the scissor
+ * box of the screen of one eye (CGraphicContext::ResInfo(): half the frame, less the blanking) at
+ * the place of the left eye. What the window system clears or draws over the whole frame after the
+ * passes, where it composites the GUI over the video (HDR): the black under the video
+ * (CWinSystemGbmGLESContext::EndGuiComposite()) and the GUI from its FBO over the video
+ * (CWinSystemGbmGLESContext::CompositeGui()), went into that place only: the GUI of both eyes
+ * squeezed into the left eye, and the right eye left with what the buffer had. Without 3D they are
+ * the whole buffer already, and nothing is set or put back.
+ */
+class CWholeBuffer
+{
+public:
+  CWholeBuffer(GLint width, GLint height)
+  {
+    glGetIntegerv(GL_VIEWPORT, m_viewport);
+    glGetIntegerv(GL_SCISSOR_BOX, m_box);
+    m_viewportSet = !IsWhole(m_viewport, width, height);
+    m_boxSet = !IsWhole(m_box, width, height);
+    if (m_viewportSet)
+      glViewport(0, 0, width, height);
+    if (m_boxSet)
+      glScissor(0, 0, width, height);
+  }
+  ~CWholeBuffer()
+  {
+    if (m_viewportSet)
+      glViewport(m_viewport[0], m_viewport[1], m_viewport[2], m_viewport[3]);
+    if (m_boxSet)
+      glScissor(m_box[0], m_box[1], m_box[2], m_box[3]);
+  }
+  CWholeBuffer(const CWholeBuffer&) = delete;
+  CWholeBuffer& operator=(const CWholeBuffer&) = delete;
+
+  //! the viewport or the scissor box was not the whole buffer (a 3D output), and was set to it
+  bool Changed() const { return m_viewportSet || m_boxSet; }
+
+private:
+  static bool IsWhole(const GLint rect[4], GLint width, GLint height)
+  {
+    return rect[0] == 0 && rect[1] == 0 && rect[2] == width && rect[3] == height;
+  }
+
+  GLint m_viewport[4]{};
+  GLint m_box[4]{};
+  bool m_viewportSet{false};
+  bool m_boxSet{false};
+};
+
+} // namespace KODI::WINDOWING::GBM
