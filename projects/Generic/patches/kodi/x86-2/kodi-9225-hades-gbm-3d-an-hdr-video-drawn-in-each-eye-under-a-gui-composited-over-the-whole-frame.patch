   {
@@ -2686,6 +2688,10 @@ void CWinSystemGbmGLESContext::EndGuiComposite()
   // (Hades: in limited range, the black of that range on a single plane, for PQ, HLG and SDR of
   // BT.2020 alike: KODI::RENDERING::GLES::GuiCompositeClearBlack())
   const float black = KODI::RENDERING::GLES::GuiCompositeClearBlack(m_compositeLimited, isD2P);
+  // (Hades: the whole buffer: in a 3D output the passes of the eyes leave the viewport and the
+  // scissor box of the left eye's place, and the right eye kept what the buffer had where its video
+  // draws nothing, its black bars: CWholeBuffer)
+  const CWholeBuffer whole(m_nWidth, m_nHeight);
   glClearColor(black, black, black, 0.0f);
   glClear(GL_COLOR_BUFFER_BIT);
 }
@@ -2867,6 +2873,29 @@ void CWinSystemGbmGLESContext::CompositeGui()
   glEnableVertexAttribArray(posLoc);
   glEnableVertexAttribArray(texLoc);
 
+  // Hades: the GUI over the whole window's buffer, the eyes of a 3D output and what is between
+  // them: their passes leave the viewport and the scissor box of the left eye's place, into which
+  // the GUI of both eyes was squeezed (CWholeBuffer). Not the frame of native Dolby Vision, which
+  // has its own above.
+  std::optional<CWholeBuffer> whole;
+#ifdef HAVE_DVBRIDGE
+  if (!dvComposite)
+#endif
+  {
+    whole.emplace(m_guiFboWidth, m_guiFboHeight);
+    const RenderStereoMode stereo = GetGfxContext().GetStereoMode();
+    if (stereo != RenderStereoMode::OFF && !std::exchange(m_compositeEyesTold, true))
+      CLog::Log(LOGINFO,
+                "3D ({}): the video under the GUI composited into {} is drawn in the view of each "
+                "eye shown, its half or view of the picture in its place, and the GUI over the "
+                "whole {}x{} frame",
+                stereo == RenderStereoMode::SPLIT_HORIZONTAL ? "eyes top and bottom"
+                : stereo == RenderStereoMode::SPLIT_VERTICAL ? "eyes side by side"
+                : stereo == RenderStereoMode::MONO           ? "one eye, in 2D"
+                                                             : "eyes in one picture",
+                m_compositeSdrWide ? "SDR of BT.2020" : "HDR", m_guiFboWidth, m_guiFboHeight);
+  }
+
 #ifdef HAVE_DVBRIDGE
   // Hades: the same quad, drawn under glScissor for each rectangle of the tile mask of the GUI that
   // this frame composites (the GUI pass was left out, and the mask is that of its content): the
