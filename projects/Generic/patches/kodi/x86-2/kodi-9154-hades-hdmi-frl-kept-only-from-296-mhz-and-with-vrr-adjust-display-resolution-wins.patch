-  }
+  const std::vector<SIZE::Mode> modes = DisplayModes(candidates);
   const int place = SIZE::Choose(modes, chosen, width, height);
   if (place < 0)
   {
@@ -136,17 +195,30 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
   float weight = 0.0f;
   g_wholeMultipleKept = RES_INVALID;
 
+  // Hades: "Adjust display resolution" with "Video at its own rate with VRR": the size wins
+  // (VideoSizeMode.h, ChooseForVrr()): the video at its own rate in the mode of its size that the
+  // display has with VRR, one change of mode; where the display has modes of that size and none with
