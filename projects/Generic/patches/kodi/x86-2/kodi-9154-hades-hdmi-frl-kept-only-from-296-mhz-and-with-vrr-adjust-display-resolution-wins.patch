+  if (link.floorKHz > 0 && (m.clockKHz <= 0 || m.clockKHz < link.floorKHz))
+    return false;
+  if (link.ceilingKHz > 0 && (m.clockKHz <= 0 || m.clockKHz > link.ceilingKHz))
+    return false;
