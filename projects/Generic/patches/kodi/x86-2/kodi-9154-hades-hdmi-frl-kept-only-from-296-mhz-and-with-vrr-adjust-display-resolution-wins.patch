+/*!
+ * \brief The mode of the video's size that a video at its own rate with VRR goes in: of the modes
+ *        of that size (OfVideoSize()) that can carry it with VRR (VrrModeOk()), the nearest to the
+ *        video and then the one of the highest refresh rate, so that the display's VRR has the
+ *        widest range to show it in
+ */
+inline VrrChoice ChooseForVrr(const std::vector<Mode>& modes,
+                              const Mode& menus,
+                              int videoWidth,
+                              int videoHeight,
+                              const VrrLink& link)
+{
+  VrrChoice choice;
+  if (videoWidth <= 0 || videoHeight <= 0 ||
+      OfVideoSize(videoWidth, videoHeight, menus.width, menus.height) || link.vrrMin <= 0 ||
+      link.vrrMax < link.vrrMin)
+    return choice;
+  bool sizeThere = false;
+  int nearestOff = 0;
+  double highestRate = 0.0;
+  for (std::size_t i = 0; i < modes.size(); ++i)
+  {
+    const Mode& m = modes[i];
+    if (m.kind != 0 || !OfVideoSize(videoWidth, videoHeight, m.width, m.height))
+      continue;
+    sizeThere = true;
+    if (!VrrModeOk(m, link))
+      continue;
+    const int sizeOff = std::abs(m.height - videoHeight) + std::abs(m.width - videoWidth);
+    if (choice.index < 0 || sizeOff < nearestOff ||
+        (sizeOff == nearestOff && m.refresh > highestRate))
+    {
+      choice.index = static_cast<int>(i);
+      nearestOff = sizeOff;
+      highestRate = m.refresh;
+    }
+  }
+  choice.place = choice.index >= 0 ? VrrPlace::MODE : sizeThere ? VrrPlace::NONE : VrrPlace::MENUS;
+  return choice;
+}
