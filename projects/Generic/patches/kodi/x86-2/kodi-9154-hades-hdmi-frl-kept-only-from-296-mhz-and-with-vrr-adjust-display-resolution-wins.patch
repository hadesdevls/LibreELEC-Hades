+int64_t CWinSystemGbm::ResolutionClockKHz(RESOLUTION res) const
+{
+  // (the mode of a resolution is the one at the place its strId says among the connector's,
+  // CDRMUtils::GetConnectorModes(), as MenusClockKHz() reads it)
+  if (!m_DRM || res <= RES_INVALID)
+    return 0;
+  const RESOLUTION_INFO info = GetGfxContext().GetResInfo(res);
+  if (info.strId.empty())
+    return 0;
+  char* end = nullptr;
+  const long place = std::strtol(info.strId.c_str(), &end, 10);
+  if (!end || *end != '\0' || place < 0)
+    return 0;
+  const std::vector<drmModeModeInfo> modes = m_DRM->GetConnectorModes();
+  if (place >= static_cast<long>(modes.size()))
+    return 0;
+  const drmModeModeInfo& mode = modes[static_cast<size_t>(place)];
+  if (mode.hdisplay != info.iScreenWidth || mode.vdisplay != info.iScreenHeight)
+    return 0;
+  return mode.clock;
+}
