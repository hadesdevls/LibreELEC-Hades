+  RESOLUTION sized = RES_INVALID;
+  const auto sizedPlace = SizedForVrr(width, height, nativeDV, is3D, sized);
+  const bool vrrPossible = sizedPlace != KODI::WINDOWING::VIDEO_SIZE::VrrPlace::NONE;
+  if (!vrrPossible)
+    CServiceBroker::GetWinSystem()->ForgetVideoAtOwnRate();
+
   // Hades: "Video at its own rate with VRR" at "Always" (windowing/gbm/VrrVideo.h): the video at its
-  // own rate with VRR in the mode of the menus, before Kodi's choice; with any other value this says
-  // no at once (and forgets what an earlier video wanted), and Kodi's choice goes on as it was
+  // own rate with VRR in the mode of the menus (or of its size, above), before Kodi's choice; with
+  // any other value this says no at once (and forgets what an earlier video wanted), and Kodi's
+  // choice goes on as it was
+  if (vrrPossible)
   {
     RESOLUTION gui = res;
     if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
-                                                           gui, false))
+                                                           gui, false, sized))
     {
       CLog::Log(LOGINFO,
-                "Display resolution ADJUST : {} ({}) kept: the video goes at its own rate with VRR",
-                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui);
+                "Display resolution ADJUST : {} ({}) {}: the video goes at its own rate with VRR",
+                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui,
+                sized > RES_INVALID ? "taken, of the video's size" : "kept");
       return gui;
     }
   }
@@ -177,24 +249,47 @@ RESOLUTION CResolutionUtils::ChooseBestResolution(float fps,
   // fail-closed: where VRR does not come on, the video plays in Kodi's choice. A display with a mode
   // at the video's rate gets its change of mode, as always. Never native Dolby Vision, which keeps the
   // change of mode to its rate chosen above (VRR_VIDEO::AskedAfterKodi(), NativeDolbyVisionWhy())
-  if (KODI::WINDOWING::GBM::VRR_VIDEO::AskedAfterKodi(nativeDV, is3D))
+  if (vrrPossible && KODI::WINDOWING::GBM::VRR_VIDEO::AskedAfterKodi(nativeDV, is3D))
   {
     RESOLUTION gui = res;
     if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
-                                                           gui, true))
+                                                           gui, true, sized))
     {
       CLog::Log(LOGINFO,
-                "Display resolution ADJUST : {} ({}) kept: no mode at the video's rate, which goes "
+                "Display resolution ADJUST : {} ({}) {}: no mode at the video's rate, which goes "
                 "at its own rate with VRR",
-                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui);
+                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui,
+                sized > RES_INVALID ? "taken, of the video's size" : "kept");
       return gui;
     }
   }
 
   // Hades: "Adjust display resolution": the mode of the video's size at the refresh rate chosen
   // above, where the display has one (VideoSizeMode.h); never where VRR took the video (above)
+  const RESOLUTION kodis = res;
   AdjustToVideoSize(width, height, nativeDV, res);
 
+  // Hades: ... where the display has modes of the video's size, none with VRR, and none of them at
+  // the rate Kodi chose either: the video at its own rate with VRR in the mode of the menus, as
+  // before the size won (a display without modes at the rate of films has nothing better)
+  if (!vrrPossible &&
+      !MatchesMode(width, height, CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(res)))
+  {
+    RESOLUTION gui = kodis;
+    if (CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
+                                                           gui, false, RES_INVALID) ||
+        (KODI::WINDOWING::GBM::VRR_VIDEO::AskedAfterKodi(nativeDV, is3D) &&
+         CServiceBroker::GetWinSystem()->TakeVideoAtOwnRate(fps, is3D, nativeDV, progressive, video,
+                                                            gui, true, RES_INVALID)))
+    {
+      CLog::Log(LOGINFO,
+                "Display resolution ADJUST : {} ({}) kept: no mode of the video's size at its "
+                "rate, nor one with VRR: it goes at its own rate with VRR in the mode of the menus",
+                CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(gui).strMode, gui);
+      return gui;
+    }
+  }
+
   CLog::Log(LOGINFO, "Display resolution ADJUST : {} ({}) (weight: {:.3f})",
             CServiceBroker::GetWinSystem()->GetGfxContext().GetResInfo(res).strMode, res, weight);
   return res;
