+//! (a clock that is not known is not within either)
+inline bool VrrModeOk(const Mode& m, const VrrLink& link)
+{
+  if (m.kind != 0 || !(m.refresh > 0.0) || link.vrrMin <= 0 || link.vrrMax < link.vrrMin)
+    return false;
+  if (m.refresh < link.vrrMin || m.refresh > link.vrrMax + SAME_RATE)
+    return false;
