diff --git a/xbmc/windowing/Resolution.cpp b/xbmc/windowing/Resolution.cpp
index abbc615..eeb60d0 100644
--- a/xbmc/windowing/Resolution.cpp
+++ b/xbmc/windowing/Resolution.cpp
@@ -53,6 +53,73 @@ bool MatchesMode(int width, int height, const RESOLUTION_INFO& info)
 // Hades: "Adjust display resolution" (Player > Videos)
 const char* SETTING_VIDEOPLAYER_HADESADJUSTRESOLUTION{"videoplayer.hadesadjustresolution"};
 
+// Hades: the modes of the display as VideoSizeMode.h takes them, with the pixel clock of each where
+// the window system says it; candidates are the resolutions, in the same order
+std::vector<KODI::WINDOWING::VIDEO_SIZE::Mode> DisplayModes(std::vector<RESOLUTION>& candidates)
+{
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  candidates.clear();
+  gfx.GetAllowedResolutions(candidates);
+  std::vector<KODI::WINDOWING::VIDEO_SIZE::Mode> modes;
+  modes.reserve(candidates.size());
+  for (const RESOLUTION r : candidates)
+  {
+    const RESOLUTION_INFO info = gfx.GetResInfo(r);
+    modes.push_back({info.iScreenWidth, info.iScreenHeight, info.fRefreshRate,
+                     info.dwFlags & D3DPRESENTFLAG_MODEMASK,
+                     CServiceBroker::GetWinSystem()->ResolutionClockKHz(r)});
+  }
+  return modes;
+}
+
+// Hades: the mode of the menus (the resolution chosen in Settings, or the desktop's)
+RESOLUTION MenusResolution()
+{
+  RESOLUTION menus = RES_DESKTOP;
+  if (CDisplaySettings::GetInstance().GetCurrentResolution() > RES_DESKTOP)
+    menus = CDisplaySettings::GetInstance().GetCurrentResolution();
+  return menus;
+}
+
+// Hades: "Adjust display resolution" with "Video at its own rate with VRR" (VideoSizeMode.h,
+// ChooseForVrr()): where a video at its own rate goes; sized is the resolution of MODE
+KODI::WINDOWING::VIDEO_SIZE::VrrPlace SizedForVrr(
+    int width, int height, bool nativeDV, bool is3D, RESOLUTION& sized)
+{
+  namespace SIZE = KODI::WINDOWING::VIDEO_SIZE;
+  sized = RES_INVALID;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  // (only with "Video at its own rate with VRR" on: Off, its default, leaves every choice as it was)
+  const bool vrrVideo = settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEOMODE) &&
+                        settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESVRRVIDEOMODE) != 0;
+  if (!vrrVideo || is3D ||
+      SIZE::NotLooked(settings->GetBool(SETTING_VIDEOPLAYER_HADESADJUSTRESOLUTION),
+                      CResolutionUtils::HasWhitelist(), nativeDV, width, height))
+    return SIZE::VrrPlace::MENUS;
+  auto& gfx = CServiceBroker::GetWinSystem()->GetGfxContext();
+  const RESOLUTION_INFO menusInfo = gfx.GetResInfo(MenusResolution());
+  const SIZE::Mode menus{menusInfo.iScreenWidth, menusInfo.iScreenHeight, menusInfo.fRefreshRate,
+                         menusInfo.dwFlags & D3DPRESENTFLAG_MODEMASK};
+  std::vector<RESOLUTION> candidates;
+  const std::vector<SIZE::Mode> modes = DisplayModes(candidates);
+  const SIZE::VrrLink link = CServiceBroker::GetWinSystem()->VideoModeLink();
+  const SIZE::VrrChoice choice = SIZE::ChooseForVrr(modes, menus, width, height, link);
+  if (choice.place == SIZE::VrrPlace::MODE)
+    sized = candidates[static_cast<size_t>(choice.index)];
+  else if (choice.place == SIZE::VrrPlace::NONE)
+    CLog::Log(
+        LOGINFO,
+        "Adjust display resolution: the display has modes of the size of the video of {}x{}, "
+        "and none that carries it with VRR here (VRR {} to {} Hz{}{}): the video changes the "
+        "mode to the size and rate that Kodi chooses, as without VRR",
+        width, height, link.vrrMin, link.vrrMax,
+        link.floorKHz > 0 ? StringUtils::Format(", at least {} kHz over HDMI FRL", link.floorKHz)
+                          : std::string(),
+        link.ceilingKHz > 0 ? StringUtils::Format(", at most {} kHz over TMDS", link.ceilingKHz)
+                            : std::string());
+  return choice.place;
+}
+
 // Hades: "Adjust display resolution" (VideoSizeMode.h): the mode of the video's size at the refresh
