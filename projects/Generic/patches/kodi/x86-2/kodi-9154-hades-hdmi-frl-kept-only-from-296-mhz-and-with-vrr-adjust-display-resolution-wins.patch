+KODI::WINDOWING::VIDEO_SIZE::VrrLink CWinSystemGbm::VideoModeLink() const
+{
+  namespace SIZE = KODI::WINDOWING::VIDEO_SIZE;
+  SIZE::VrrLink link;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  CDRMConnector* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return link;
+  // (the VRR range as TakeVideoAtOwnRate() takes it: amdgpu from AMD's FreeSync block, NVKMS from
+  // the HDMI Forum block, with NVKMS's own rules for a mode with VRR)
+  const bool nvidia =
+      connector->SupportsProperty(CHdmiVrrOff::PROPERTY) ||
+      (drm->GetCrtc() && drm->GetCrtc()->SupportsProperty(VRR_VIDEO::FLIP_TIME_RAW_NS));
+  if (const auto info = DisplayInfo())
+  {
+    if (!nvidia && info->FreeSyncMin() > 0)
+    {
+      link.vrrMin = info->FreeSyncMin();
+      link.vrrMax = info->FreeSyncMax();
+    }
+    else
+    {
+      link.vrrMin = info->HdmiVrrMin();
+      link.vrrMax = info->HdmiVrrMax();
+    }
+  }
+  if (nvidia)
+  {
+    link.minRefresh = VRR_VIDEO::NVIDIA_VRR_MIN_REFRESH;
+    link.minLines = VRR_VIDEO::NVIDIA_VRR_MIN_LINES;
+    link.minFactor = VRR_VIDEO::NVIDIA_VRR_MIN_FACTOR;
+  }
+  // The link (nvidia-drm says it: NV_OUTPUT_LINK). Over FRL, where the menus need it, Kodi asks
+  // NVKMS to keep the modes of videos on FRL from FRL_KEEP::MIN_KEPT_KHZ (FrlKeep.h): a mode under it
+  // goes over TMDS, which a video at its own rate does not take, so that it changes no link. Over
+  // TMDS, no mode for a video that TMDS does not carry: the change of the link from TMDS to FRL is
+  // what hung the RTX 4080 SUPER of the tests (FrlModeChange.h).
+  if (!connector->SupportsProperty("NV_OUTPUT_LINK"))
+    return link;
+  const auto linkNow = HOTPLUG_RELINK::LinkOf(connector->ReadPropertyValue("NV_OUTPUT_LINK"));
+  if (linkNow == HOTPLUG_RELINK::Link::FRL &&
+      connector->SupportsProperty(KODI::WINDOWING::GBM::FRL_KEEP::PROPERTY) && !m_frlKeepBlocked)
+  {
+    std::string menus;
+    if (KODI::WINDOWING::GBM::FRL_KEEP::MenusNeedFrl(MenusClockKHz(menus)))
+      link.floorKHz = KODI::WINDOWING::GBM::FRL_KEEP::MIN_KEPT_KHZ;
+  }
+  else if (linkNow == HOTPLUG_RELINK::Link::TMDS || linkNow == HOTPLUG_RELINK::Link::TMDS_SCRAMBLED)
+    link.ceilingKHz = HOTPLUG_RELINK::TMDS_MAX_KHZ;
+  return link;
+}
