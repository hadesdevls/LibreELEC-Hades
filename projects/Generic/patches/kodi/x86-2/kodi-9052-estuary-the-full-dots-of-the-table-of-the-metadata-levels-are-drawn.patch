From dde49ff379ffc15ddeaff7f769e150df3511912b Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:04:33 +0000
Subject: [PATCH] estuary: the full dots of the table of the metadata levels
 are drawn

The full dot of a level that is there was shown where its cell said "+", with
String.IsEqual(...,+): a "+" in a condition is read as "and", so the condition
never held and only the hollow dots of the levels that are not there were
drawn (seen in a picture of the panel in QEMU; the checker of the texts does
not read conditions). A level is now shown there where its cell is neither
empty nor "-". The dialog of system/hades is made again.
---
 .../xml/Includes_HadesPlayerInfo.xml          |  4 +-
 system/hades/DialogHadesPlayerInfo.xml        | 72 +++++++++----------
 system/hades/HadesIncludes.xml                |  2 +-
 3 files changed, 40 insertions(+), 38 deletions(-)

diff --git a/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
index c9f5797..59fa8cf 100644
--- a/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
+++ b/addons/skin.estuary/xml/Includes_HadesPlayerInfo.xml
@@ -334,7 +334,9 @@
 					<width>27</width>
 					<height>27</height>
 					<texture colordiffuse="$PARAM[color]">buttons/roundbutton-fo.png</texture>
-					<visible>String.IsEqual(Window(Home).Property($PARAM[property]),+)</visible>
+					<!-- (a "+" would be read as "and" in a condition: a level is there where its cell is neither
+					     empty nor "-") -->
+					<visible>!String.IsEmpty(Window(Home).Property($PARAM[property])) + !String.IsEqual(Window(Home).Property($PARAM[property]),-)</visible>
 				</control>
 				<control type="group">
 					<visible>String.IsEqual(Window(Home).Property($PARAM[property]),-)</visible>
