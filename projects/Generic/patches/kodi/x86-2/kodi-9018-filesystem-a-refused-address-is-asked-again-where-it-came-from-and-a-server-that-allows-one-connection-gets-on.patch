+
+using namespace XFILE;
+
+namespace
+{
+std::mutex g_lock;
+std::deque<CHttpSourceMemory::Redirect> g_redirects; // newest last
+std::deque<std::string> g_discImages;
+std::deque<std::string> g_oneConnection;
+
+bool EqualsNoCase(std::string_view a, std::string_view b)
+{
+  return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(),
+                                            [](char x, char y)
+                                            {
+                                              return std::tolower(static_cast<unsigned char>(x)) ==
+                                                     std::tolower(static_cast<unsigned char>(y));
+                                            });
+}
+
+template<typename T>
+void Bound(std::deque<T>& list, std::size_t max)
+{
+  while (list.size() > max)
+    list.pop_front();
+}
+} // namespace
+
+std::string CHttpSourceMemory::Key(std::string_view url)
+{
+  const std::size_t bar = url.find('|');
+  return std::string(bar == std::string_view::npos ? url : url.substr(0, bar));
+}
+
+std::string CHttpSourceMemory::ShortForLog(std::string_view url)
+{
+  const std::string key = Key(url);
+  const std::size_t scheme = key.find("://");
+  if (scheme == std::string::npos)
+    return "(an address)";
+  const std::size_t hostStart = scheme + 3;
+  std::size_t hostEnd = key.find_first_of("/?#", hostStart);
+  std::string host =
+      key.substr(hostStart, hostEnd == std::string::npos ? std::string::npos : hostEnd - hostStart);
+  // user and password, if any, are not the host
+  if (const std::size_t at = host.rfind('@'); at != std::string::npos)
+    host = host.substr(at + 1);
+  std::string path = hostEnd == std::string::npos ? std::string{} : key.substr(hostEnd);
+  if (const std::size_t q = path.find_first_of("?#"); q != std::string::npos)
+    path = path.substr(0, q);
+  std::string name;
+  if (const std::size_t slash = path.rfind('/'); slash != std::string::npos)
+    name = path.substr(slash + 1);
+  // the last part of the path names the file; what is between may be a token
+  std::string out = key.substr(0, hostStart) + host;
+  if (!name.empty())
+    out += (path.find('/') != path.rfind('/') ? "/.../" : "/") + name;
+  return out;
+}
+
+void CHttpSourceMemory::RememberRedirect(const std::string& origin,
+                                         const std::string& target,
+                                         const std::string& mimeType)
+{
+  if (origin.empty() || target.empty())
+    return;
+  const std::string from = Key(origin);
+  const std::string to = Key(target);
+  if (from == to)
+    return;
+  std::lock_guard lock(g_lock);
+  std::erase_if(g_redirects, [&](const Redirect& r) { return r.origin == from && r.target == to; });
+  g_redirects.push_back({from, to, mimeType, std::chrono::steady_clock::now()});
+  Bound(g_redirects, MAX_REDIRECTS);
+}
+
+std::optional<CHttpSourceMemory::Redirect> CHttpSourceMemory::FindByTarget(
+    const std::string& target)
+{
+  const std::string key = Key(target);
+  std::lock_guard lock(g_lock);
+  for (auto it = g_redirects.rbegin(); it != g_redirects.rend(); ++it)
+  {
+    if (it->target == key)
+      return *it;
+  }
+  return std::nullopt;
+}
+
+std::optional<CHttpSourceMemory::Redirect> CHttpSourceMemory::FindByOrigin(
+    const std::string& origin, std::chrono::steady_clock::duration maxAge)
+{
+  const std::string key = Key(origin);
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard lock(g_lock);
+  for (auto it = g_redirects.rbegin(); it != g_redirects.rend(); ++it)
+  {
+    if (it->origin == key)
+    {
+      if (now - it->at > maxAge)
+        return std::nullopt;
+      return *it;
+    }
+  }
+  return std::nullopt;
+}
+
+void CHttpSourceMemory::RememberDiscImage(const std::string& url)
+{
+  const std::string key = Key(url);
+  if (key.empty())
+    return;
+  std::lock_guard lock(g_lock);
+  std::erase(g_discImages, key);
+  g_discImages.push_back(key);
+  Bound(g_discImages, MAX_DISC_IMAGES);
+}
+
+bool CHttpSourceMemory::IsKnownDiscImage(std::string_view url)
+{
+  // only an address of a web server can be one (the check is made for every path Kodi asks about)
+  if (url.size() < 7 || !(EqualsNoCase(url.substr(0, 7), "http://") ||
+                          (url.size() >= 8 && EqualsNoCase(url.substr(0, 8), "https://"))))
+    return false;
+  const std::string key = Key(url);
+  std::lock_guard lock(g_lock);
+  return std::ranges::find(g_discImages, key) != g_discImages.end();
+}
+
+void CHttpSourceMemory::RememberOneConnection(const std::string& host)
+{
+  if (host.empty())
+    return;
+  std::lock_guard lock(g_lock);
+  if (std::ranges::any_of(g_oneConnection,
+                          [&](const std::string& h) { return EqualsNoCase(h, host); }))
+    return;
+  g_oneConnection.push_back(host);
+  Bound(g_oneConnection, MAX_ONE_CONNECTION_HOSTS);
+}
+
+bool CHttpSourceMemory::AllowsOneConnection(const std::string& host)
+{
+  if (host.empty())
+    return false;
+  std::lock_guard lock(g_lock);
+  return std::ranges::any_of(g_oneConnection,
+                             [&](const std::string& h) { return EqualsNoCase(h, host); });
+}
+
+bool CHttpSourceMemory::AllowsOneConnectionFor(const std::string& url)
+{
+  const auto hostOf = [](const std::string& u)
+  {
+    const std::size_t scheme = u.find("://");
+    if (scheme == std::string::npos)
+      return std::string{};
+    std::string host = u.substr(scheme + 3, u.find_first_of("/?#|", scheme + 3) - (scheme + 3));
+    if (const std::size_t at = host.rfind('@'); at != std::string::npos)
+      host = host.substr(at + 1);
+    if (const std::size_t colon = host.rfind(':');
+        colon != std::string::npos && host.find(']') == std::string::npos)
+      host = host.substr(0, colon);
+    return host;
+  };
+  if (AllowsOneConnection(hostOf(url)))
+    return true;
+  const std::string key = Key(url);
+  std::string target;
+  {
+    std::lock_guard lock(g_lock);
+    for (auto it = g_redirects.rbegin(); it != g_redirects.rend(); ++it)
+    {
+      if (it->origin == key)
+      {
+        target = it->target;
+        break;
+      }
+    }
+  }
+  return !target.empty() && AllowsOneConnection(hostOf(target));
+}
+
+bool CHttpSourceMemory::IsDiscImageMimeType(std::string_view mimeType)
+{
+  // (the type alone, without its parameters)
+  const std::size_t semi = mimeType.find(';');
+  std::string_view type = mimeType.substr(0, semi);
+  while (!type.empty() && std::isspace(static_cast<unsigned char>(type.back())))
+    type.remove_suffix(1);
+  while (!type.empty() && std::isspace(static_cast<unsigned char>(type.front())))
+    type.remove_prefix(1);
+  for (std::string_view known :
+       {"application/x-iso9660-image", "application/x-cd-image", "application/x-iso-image",
+        "application/x-udf-image", "application/vnd.efi.iso"})
+  {
+    if (EqualsNoCase(type, known))
+      return true;
+  }
+  return false;
+}
+
+void CHttpSourceMemory::Clear()
+{
+  std::lock_guard lock(g_lock);
+  g_redirects.clear();
+  g_discImages.clear();
+  g_oneConnection.clear();
+}
