+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace XFILE
+{
+/*!
+ * \brief What Kodi learned of an HTTP source while it used it, for the next connection to it.
+ *
+ * A streaming add-on gives Kodi the address of its resolver, which sends to its CDN with a
+ * token in the address; the token runs out after a while, and the CDN may allow only one or two
+ * connections to a file. Each connection is a file of its own in Kodi (CCurlFile), and the player
+ * opens several: what one learns is kept here for the others.
+ *  - Where an address redirected to: a CDN that later refuses the address it sent to (its token
+ *    ran out) is asked again at the address it came from, which sends to a new one.
+ *  - That a file is a disc image, when only the type the server gave it says so (an address
+ *    without the extension of an image): Kodi takes an image by its extension everywhere.
+ *  - The servers that refused a second connection to a file while one was open: their files are
+ *    read over one connection from then on.
+ *
+ * Bounded (the latest of each), thread safe; an address is kept without the options Kodi adds after
+ * '|', and is never logged whole (its token is in it): see ShortForLog().
+ */
+class CHttpSourceMemory
+{
+public:
+  struct Redirect
+  {
+    std::string origin; //!< the address that was asked
+    std::string target; //!< where it sent to, in the end
+    std::string mimeType; //!< the type the server gave the file there, if any
+    std::chrono::steady_clock::time_point at;
+  };
+
+  static constexpr std::size_t MAX_REDIRECTS = 64;
+  static constexpr std::size_t MAX_DISC_IMAGES = 16;
+  static constexpr std::size_t MAX_ONE_CONNECTION_HOSTS = 32;
+
+  static void RememberRedirect(const std::string& origin,
+                               const std::string& target,
+                               const std::string& mimeType);
+  //! The latest redirect that ended at this address
+  static std::optional<Redirect> FindByTarget(const std::string& target);
+  //! The latest redirect of this address, if it is not older than maxAge
+  static std::optional<Redirect> FindByOrigin(const std::string& origin,
+                                              std::chrono::steady_clock::duration maxAge);
+
+  //! An address whose file is a disc image, though it has not the extension of one
+  static void RememberDiscImage(const std::string& url);
+  static bool IsKnownDiscImage(std::string_view url);
+
+  //! A server that refused a second connection to a file while one was open
+  static void RememberOneConnection(const std::string& host);
+  static bool AllowsOneConnection(const std::string& host);
+  //! The same for an address: its server's, or that of where it redirected to last
+  static bool AllowsOneConnectionFor(const std::string& url);
+
+  //! The MIME types servers give a disc image (ISO 9660 or UDF)
+  static bool IsDiscImageMimeType(std::string_view mimeType);
+
+  //! An address as it is kept: without the options Kodi adds after '|'
+  static std::string Key(std::string_view url);
+  //! An address for the log, without what may hold a token: "https://host/.../name"
+  static std::string ShortForLog(std::string_view url);
+
+  //! For the tests
+  static void Clear();
+};
+} // namespace XFILE
