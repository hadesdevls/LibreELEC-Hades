+long CCurlFile::Reconnect(int64_t position, int64_t knownSize)
+{
+  m_state->Disconnect();
+  m_state->m_fileSize = knownSize;
+  SetCommonOptions(m_state);
+  SetRequestHeaders(m_state);
+  m_state->m_filePos = position;
+  m_state->m_sendRange = true;
+  m_state->m_bRetry = m_allowRetry;
+  return m_state->Connect(m_bufferSize);
+}
+
+long CCurlFile::AfterRefusal(long response, int64_t position, int64_t knownSize)
+{
+  // Another connection of this file is open (the multiple sessions of Seek()): a server that allows
+  // one connection to a file refuses the second. The first one is closed and this one asked for
+  // again at once; the file is read over one connection from now on. A server known to allow one
+  // connection may refuse the new one while it still counts the one this file just closed (Seek()
+  // closes its connection before it makes the new one): the same.
+  bool oneConnection = false;
+  bool hadSecond = false;
+  bool askedOrigin = false;
+  if (RefusesAnotherConnection(response) &&
+      (m_oldState || CHttpSourceMemory::AllowsOneConnection(HostOf(m_url))))
+  {
+    oneConnection = true;
+    hadSecond = m_oldState != nullptr;
+    if (hadSecond)
+      CLog::Log(LOGINFO,
+                "CCurlFile::Seek - {} refused a second connection to the file (HTTP {}) at byte "
+                "{}: the first one is closed, and the file read over one connection",
+                CHttpSourceMemory::ShortForLog(m_url), response, position);
+    else
+      CLog::Log(LOGINFO,
+                "CCurlFile::Seek - {} refused the connection (HTTP {}) at byte {}, as a server "
+                "that allows one may while it still counts the one just closed: asked again",
+                CHttpSourceMemory::ShortForLog(m_url), response, position);
+    delete m_oldState;
+    m_oldState = nullptr;
+    m_multisession = false;
+    response = Reconnect(position, knownSize);
+    CLog::Log(LOGINFO, "CCurlFile::Seek - {} answered HTTP {} over the one connection",
+              CHttpSourceMemory::ShortForLog(m_url), response);
+
+    // a server that notices a closed connection only when it next writes to it counts it a moment
+    // longer: asked once more after a short wait, before the address is taken for refused
+    if (RefusesAnotherConnection(response) && !(m_readAbort && *m_readAbort))
+    {
+      KODI::TIME::Sleep(std::chrono::milliseconds(300));
+      response = Reconnect(position, knownSize);
+      CLog::Log(LOGINFO,
+                "CCurlFile::Seek - {} answered HTTP {} over the one connection after 0.3 s",
+                CHttpSourceMemory::ShortForLog(m_url), response);
+    }
+  }
+
+  // The address refused (a token in it that ran out): the address it came from, through a redirect
+  // (the add-on's resolver), is asked again, and sends to a new one
+  if (RefusesTheAddress(response))
+  {
+    std::string origin{m_origUrl};
+    if (origin.empty())
+    {
+      if (const auto from = CHttpSourceMemory::FindByTarget(m_url); from.has_value())
+        origin = from->origin;
+    }
+    if (!origin.empty() && CHttpSourceMemory::Key(origin) != CHttpSourceMemory::Key(m_url))
+    {
+      CLog::Log(LOGINFO,
+                "CCurlFile::Seek - {} refused the address at byte {} (HTTP {}): asked again at the "
+                "address it came from, {}",
+                CHttpSourceMemory::ShortForLog(m_url), position, response,
+                CHttpSourceMemory::ShortForLog(origin));
+      askedOrigin = true;
+      m_url = origin;
+      m_origUrl = origin;
+      response = Reconnect(position, knownSize);
+      if (const std::string efurl = GetInfoString(CURLINFO_EFFECTIVE_URL); !efurl.empty())
+        m_url = efurl;
+      if (response >= 200 && response < 300)
+      {
+        CHttpSourceMemory::RememberRedirect(origin, m_url, m_state->m_httpheader.GetMimeType());
+        CLog::Log(LOGINFO,
+                  "CCurlFile::Seek - {} sent to a new address, {}: the file goes on "
+                  "from byte {}",
+                  CHttpSourceMemory::ShortForLog(origin), CHttpSourceMemory::ShortForLog(m_url),
+                  position);
+      }
+      else
+        CLog::Log(LOGWARNING, "CCurlFile::Seek - {} answered HTTP {} too",
+                  CHttpSourceMemory::ShortForLog(origin), response);
+    }
+  }
+
+  // Still refused by a server that allows one connection: it notices a closed connection only when
+  // it next writes to it, so it may still count the one just closed. Asked again after half a
+  // second and after a second more.
+  for (int attempt = 1; oneConnection && attempt <= 2 && RefusesAnotherConnection(response);
+       attempt++)
+  {
+    if (m_readAbort && *m_readAbort)
+      break;
+    KODI::TIME::Sleep(std::chrono::milliseconds(500 * attempt));
+    response = Reconnect(position, knownSize);
+    CLog::Log(LOGINFO, "CCurlFile::Seek - {} answered HTTP {} over the one connection (try {})",
+              CHttpSourceMemory::ShortForLog(m_url), response, attempt + 1);
+  }
+
+  // The second connection was what the server refused (one connection took what two did not, at
+  // the same address): every file of the server is read over one connection from now on. A refusal
+  // that a new address answered was the address (its token), not the second connection.
+  if (hadSecond && !askedOrigin && response >= 200 && response < 300 &&
+      !CHttpSourceMemory::AllowsOneConnection(HostOf(m_url)))
+  {
+    CHttpSourceMemory::RememberOneConnection(HostOf(m_url));
+    CLog::Log(LOGINFO,
+              "CCurlFile::Seek - {} allows one connection to a file: the files of the server are "
+              "read over one connection from now on",
+              CHttpSourceMemory::ShortForLog(m_url));
+  }
+  return response;
+}
