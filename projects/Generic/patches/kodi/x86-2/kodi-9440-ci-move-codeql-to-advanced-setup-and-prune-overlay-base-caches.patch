From 3d7d9cf824d47b9187d2cdda9e854b58decb8bc1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20P=C3=A9ron?= <peron.clem@gmail.com>
Date: Sun, 1 Nov 2026 13:48:09 +0100
Subject: [PATCH] [ci] Move CodeQL to advanced setup and prune overlay-base
 caches

Default setup always caches Java dependencies, saving a new copy on
every run, and keeps an overlay-base database per language for every
analysis of master though only the newest is restored. Advanced setup
leaves dependency caching off; a prune job keeps the newest database.

Default setup must be disabled in the repository settings on merge.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit fe66a58b0cb512f250a0fe578d23d2a9c5dc4f86)
(cherry picked from commit cf719c653eda760f659090b4d1d69208241d0e3a)
---
 .github/workflows/codeql.yml | 58 ++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 .github/workflows/codeql.yml

diff --git a/.github/workflows/codeql.yml b/.github/workflows/codeql.yml
new file mode 100644
index 0000000..7ef1eda
--- /dev/null
+++ b/.github/workflows/codeql.yml
@@ -0,0 +1,58 @@
+name: CodeQL
+
+on:
+  push:
+    branches: [master, Piers]
+  pull_request:
+    branches: [master, Piers]
+  schedule:
+    - cron: '13 22 * * 5'
+
+concurrency:
+  group: codeql-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  analyze:
+    name: Analyze (${{ matrix.language }})
+    if: github.repository == 'xbmc/xbmc'
+    runs-on: ubuntu-latest
+    permissions:
+      actions: read
+      contents: read
+      security-events: write
+    strategy:
+      fail-fast: false
+      matrix:
+        language: [actions, c-cpp, csharp, java-kotlin, javascript-typescript, python]
+    steps:
+      - uses: actions/checkout@v7
+      - uses: github/codeql-action/init@v4
+        with:
+          languages: ${{ matrix.language }}
+          build-mode: none
+      - uses: github/codeql-action/analyze@v4
+        with:
+          category: /language:${{ matrix.language }}
+
+  # CodeQL saves an overlay-base database per language for every analysis of
+  # master but only restores the newest, and never deletes the others. Keys end
+  # in -<language>-<CodeQL version>-<commit>-<run id>-<attempt>; entries are
+  # grouped on everything up to the version.
+  prune:
+    needs: analyze
+    if: ${{ !cancelled() && github.repository == 'xbmc/xbmc' && github.ref == 'refs/heads/master' && github.event_name != 'pull_request' }}
+    runs-on: ubuntu-latest
+    permissions:
+      actions: write
+    steps:
+      - name: Delete all but the newest overlay-base database per language and CodeQL version
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+        run: |
+          gh cache list --ref refs/heads/master --key codeql-overlay-base-database- \
+              --sort created_at --limit 1000 --json id,key \
+              --jq '.[] | "\(.id) \(.key | split("-")[:-3] | join("-"))"' |
+          awk 'seen[$2]++ { print $1 }' | xargs -rn1 gh cache delete
-- 
