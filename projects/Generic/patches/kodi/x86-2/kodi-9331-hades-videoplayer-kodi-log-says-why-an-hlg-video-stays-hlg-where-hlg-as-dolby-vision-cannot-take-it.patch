From 9f70c02df5d7fb0c3e3d33dfa45c524110e8adb5 Mon Sep 17 00:00:00 2001
From: Hades <15710513+hadesdevls@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:01:00 +0000
Subject: [PATCH] [Hades][VideoPlayer] kodi.log says why an HLG video stays HLG
 where HLG as Dolby Vision cannot take it

"HLG as Dolby Vision" (videoscreen.hadeshlgasdv) sends an HLG video as
Dolby Vision only where its coding is the one the measurement and the
conversion are written for: 10-bit 4:2:0 in the BT.2020 matrix for
non-constant luminance, limited range and progressive
(DVBRIDGE::HlgDolbyVisionEligible()). Any other HLG video, an 8-bit one
from a camera or a 4:2:2 one, played as HLG without a word: where the
display cannot take HLG, that is SDR, and nothing said why.

Now, once a stream, where the setting would send it as Dolby Vision,
kodi.log says that the stream stays HLG and the first thing that keeps it
out (DVBRIDGE::HlgDolbyVisionIneligibility(): "it is coded in 8 bits",
"its chroma is 4:2:2", "it is in full range", ...). Nothing is said while
the pixel format is not known, and nothing changes in what is played.
---
 .../DVDCodecs/Video/DVPlaybackPolicy.h        | 27 +++++++++++++++++++
 .../DVDDemuxers/DVDDemuxFFmpeg.cpp            | 17 ++++++++++++
 .../VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h  |  2 ++
 .../VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp   | 15 +++++++++++
 .../VideoPlayer/DVDDemuxers/DVHdr10Plus.h     |  5 ++++
 5 files changed, 66 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
index 62681d0..b1dba38 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackPolicy.h
@@ -700,6 +700,33 @@ constexpr bool HlgDolbyVisionEligible(bool aribB67,
          progressive;
 }
 
+/*!
+ * \brief Hades: why an HLG stream (the ARIB STD-B67 transfer in BT.2020) is not one that
+ *        HlgDolbyVisionEligible() takes, for kodi.log: nullptr when it is one, and when its pixel
+ *        format is not known yet (bitDepth 0), so that nothing is said before it is
+ * \param bitDepth the depth of its luma samples, 0 while the pixel format is not known
+ * \param chromaW, chromaH log2 of the horizontal and vertical subsampling of its chroma
+ */
+constexpr const char* HlgDolbyVisionIneligibility(
+    bool bt2020Ncl, int bitDepth, int chromaW, int chromaH, bool fullRange, bool progressive)
+{
+  if (bitDepth == 0)
+    return nullptr;
+  if (bitDepth != 10)
+    return bitDepth == 8 ? "it is coded in 8 bits" : "its samples are not of 10 bits";
+  if (chromaW != 1 || chromaH != 1)
+    return chromaW == 1 && chromaH == 0   ? "its chroma is 4:2:2"
+           : chromaW == 0 && chromaH == 0 ? "its chroma is 4:4:4"
+                                          : "its chroma is not 4:2:0";
+  if (!bt2020Ncl)
+    return "its matrix is not BT.2020 for non-constant luminance";
+  if (fullRange)
+    return "it is in full range";
+  if (!progressive)
+    return "it is interlaced";
+  return nullptr;
+}
+
 /*!
  * \brief The setting of the conversion (videoscreen.hadesdvashdr10, videoscreen.hadesdvashdr10fel)
  *        and of the mapping to the display (videoscreen.hadesdvhdr10map), as one
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
index f9e13de..f9fc857 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.cpp
@@ -949,6 +949,7 @@ void CDVDDemuxFFmpeg::Dispose()
   m_dvHdrBefore.clear();
   m_dvMeasured.clear();
   m_dvMeasuredHlg.clear();
+  m_hlgIneligibleTold.clear();
   m_dvWithoutStatistics.clear(); // (Hades: as the other maps of ProbeHdr10Plus())
   m_dvNotJoined.clear();
 #endif
@@ -1827,6 +1828,22 @@ void CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
   if (m_dvMeasuredHlg.count(streamIdx) ||
       CDVHdr10Plus::Hlg(avStream->codecpar, unit.alternativeTransfer))
   {
+    // Hades: an HLG stream that "HLG as Dolby Vision" would send as Dolby Vision but whose coding
+    // the conversion is not written for stays HLG: kodi.log says why, once a stream
+    if (!m_dvMeasuredHlg.count(streamIdx) && !m_hlgIneligibleTold.count(streamIdx))
+    {
+      if (const char* why = CDVHdr10Plus::HlgIneligibility(avStream->codecpar))
+      {
+        m_hlgIneligibleTold[streamIdx] = true;
+        if (DVBRIDGE::HlgAsDolbyVision())
+          CLog::Log(LOGINFO,
+                    "CDVDDemuxFFmpeg: stream {} is HLG and stays HLG, not sent as Dolby Vision "
+                    "(videoscreen.hadeshlgasdv): {}; HLG is sent as Dolby Vision from 10-bit "
+                    "4:2:0 in the BT.2020 matrix for non-constant luminance, limited range and "
+                    "progressive only",
+                    streamIdx, why);
+      }
+    }
     ProbeHlg(stream, streamIdx, CDVHdr10Plus::HlgMeasurable(unit, avStream->codecpar),
              unit.dolbyVision);
     return;
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
index 5e807d0..04584e2 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemuxFFmpeg.h
@@ -396,6 +396,8 @@ protected:
   //! converted
   //! to PQ (ProbeHlg(), videoscreen.hadeshlgasdv): given back as HLG, not as HDR10
   std::map<int, bool> m_dvMeasuredHlg;
+  //! Hades: the HLG streams that kodi.log was told stay HLG (CDVHdr10Plus::HlgIneligibility())
+  std::map<int, bool> m_hlgIneligibleTold;
   void ProbeHlg(CDemuxStream* stream, int streamIdx, bool measurable, bool dolbyVision);
   //! Hades: the access units of a stream looked at whose HDR10+ metadata give no level 1 block, of
   //! one that is otherwise HDR10+ to be sent as Dolby Vision (CDVHdr10Plus::WithoutStatistics())
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
index bf91e90..5d11e33 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.cpp
@@ -171,6 +171,21 @@ bool CDVHdr10Plus::HlgMeasurable(const AccessUnit& unit, const AVCodecParameters
           parameters->field_order == AV_FIELD_UNKNOWN);
 }
 
+const char* CDVHdr10Plus::HlgIneligibility(const AVCodecParameters* parameters)
+{
+  const AVPixFmtDescriptor* desc =
+      parameters ? av_pix_fmt_desc_get(static_cast<AVPixelFormat>(parameters->format)) : nullptr;
+  if (!desc)
+    return nullptr;
+  if ((desc->flags & AV_PIX_FMT_FLAG_RGB) || desc->nb_components != 3)
+    return "its pictures are not YCbCr";
+  return DVBRIDGE::HlgDolbyVisionIneligibility(
+      parameters->color_space == AVCOL_SPC_BT2020_NCL, desc->comp[0].depth, desc->log2_chroma_w,
+      desc->log2_chroma_h, parameters->color_range == AVCOL_RANGE_JPEG,
+      parameters->field_order == AV_FIELD_PROGRESSIVE ||
+          parameters->field_order == AV_FIELD_UNKNOWN);
+}
+
 bool CDVHdr10Plus::HlgRecord(const AVCodecParameters* parameters,
                              AVRational rate,
                              AVDOVIDecoderConfigurationRecord& record)
diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
index 97af54e..2e8b3e0 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdr10Plus.h
@@ -101,6 +101,11 @@ public:
   //! over the next packets: one that has Dolby Vision gives the stream back as it was.
   static bool HlgMeasurable(const AccessUnit& unit, const AVCodecParameters* parameters);
 
+  //! Hades: why an HLG stream (Hlg()) is not one that HlgMeasurable() can take, by its coding
+  //! (DVBRIDGE::HlgDolbyVisionIneligibility()): nullptr when it is one, or while its pixel format is
+  //! not known
+  static const char* HlgIneligibility(const AVCodecParameters* parameters);
+
   //! The record of such a stream: profile 8.1 (its picture goes out in ST 2084), the level from its
   //! size and rate (CDVLayerMerge::Level())
   static bool HlgRecord(const AVCodecParameters* parameters,
-- 
