   const uint64_t current =
       drm->RequestValue(connector, "max bpc")
           .value_or(connector->GetPropertyValue("max bpc").value_or(m_linkDepth.maximum));
+  // Hades: a mode whose deep colour above 340 MHz the display did not lock onto in this session goes
+  // out at 8 bits (DeepColourLock.h)
+  const bool deepCapped = m_deepCapped.count(OutputModeKey()) > 0;
+  LinkDepthOutput linkDepth = m_linkDepth;
+  if (deepCapped && content != LinkContent::DV && linkDepth.maximum > 8)
+    linkDepth.maximum = 8;
   const LinkDepthStep step =
-      LinkDepthFor(m_linkDepth, content, hdrSetting, current, setsHead, firstCommit);
+      LinkDepthFor(linkDepth, content, hdrSetting, current, setsHead, firstCommit);
   const char* const what = content == LinkContent::HDR  ? "HDR"
                            : content == LinkContent::DV ? "native Dolby Vision"
                                                         : "SDR";
@@ -7536,6 +7542,28 @@ void CWinSystemGbm::QueueLinkDepth(LinkContent content,
           step.raises ? ", which makes this commit a modeset" : "");
   }
   m_linkHeldForHdr = content == LinkContent::HDR && hdrSetting == 8 && heldAt8;
+
+  // Hades: a link of deep colour above 340 MHz that goes out with a mode set: the display is looked
+  // at a moment later (DeepColourLock.h, CWinSystemGbmGLESContext::LookForDeepLock())
+  if (setsHead || step.raises)
+  {
+    const uint64_t bpc = step.maxBpc ? *step.maxBpc : current;
+    const drmModeModeInfo* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+    m_deepLockArmed = DEEP_LOCK::Wanted(m_linkDepth.managed && m_linkDepth.sdrAt8,
+                                        connector->SupportsProperty("NV_OUTPUT_BPC"), bpc,
+                                        mode ? static_cast<int>(mode->clock) : 0, deepCapped);
+    if (m_deepLockArmed)
+    {
+      m_deepLockAt = std::chrono::steady_clock::now();
+      m_deepLockKey = OutputModeKey();
+      m_deepLockBpc = bpc;
+    }
+    else if (deepCapped && content != LinkContent::DV && content != LinkContent::SDR)
+      CLog::Log(LOGINFO,
+                "Output depth: {} goes out at 8 bits on {} in {}: the display did not lock onto "
+                "deep colour above 340 MHz in this mode earlier in this session (DeepColourLock.h)",
+                what, connector->GetName(), OutputModeKey());
+  }
 }
 
