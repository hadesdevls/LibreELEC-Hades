+
+// Hades: the i2c adapter of the DDC of a connector of a DRM device, as the kernel names it in sysfs
+// (cardN-<connector>/ddc, drm_sysfs_connector_add() where the driver gives the connector its DDC:
+// i915, xe, amdgpu): its number, the N of /dev/i2c-N; -1 where there is none. Only names are read.
+int ConnectorDdcAdapter(int drmFd, const std::string& connectorName)
+{
+  struct stat st = {};
+  if (connectorName.empty() || fstat(drmFd, &st) != 0 || !S_ISCHR(st.st_mode))
+    return -1;
+  const std::string card =
+      StringUtils::Format("/sys/dev/char/{}:{}", major(st.st_rdev), minor(st.st_rdev));
+  char* real = realpath(card.c_str(), nullptr);
+  if (!real)
+    return -1;
+  const std::string cardPath = real;
+  free(real);
+  const std::string base = cardPath.substr(cardPath.rfind('/') + 1);
+  const std::string ddc = cardPath + "/" + base + "-" + connectorName + "/ddc";
+  char* target = realpath(ddc.c_str(), nullptr);
+  if (!target)
+    return -1;
+  const std::string adapterPath = target;
+  free(target);
+  int number = -1;
+  char tail = 0;
+  if (std::sscanf(adapterPath.substr(adapterPath.rfind('/') + 1).c_str(), "i2c-%d%c", &number,
+                  &tail) != 1 ||
+      number < 0)
+    return -1;
+  return number;
+}
+
